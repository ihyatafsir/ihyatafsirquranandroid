, "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 58, "text": "وَإِمَّا تَخَافَنَّ مِن قَوْمٍ خِيَانَةࣰ فَانۢبِذِ اِلَيْهِمْ عَلَيٰ سَوَآءٍۖ اِنَّ اَ۬للَّهَ لَا يُحِبُّ اُ۬لْخَآئِنِينَۖ", "words": [{"id": 1, "arabic": "وَإِمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَخَافَنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "خِيَانَةࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَانۢبِذِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِلَيْهِمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَوَآءٍۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "", "root": ""}, {"id": 13, "arabic": "يُحِبُّ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لْخَآئِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 59, "text": "وَلَا تَحْسِبَنَّ اَ۬لذِينَ كَفَرُواْ سَبَقُوٓاْۖ إِنَّهُمْ لَا يُعْجِزُونَۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَحْسِبَنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَبَقُوٓاْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يُعْجِزُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 60, "text": "۞وَأَعِدُّواْ لَهُم مَّا اَ۪سْتَطَعْتُم مِّن قُوَّةࣲ وَمِن رِّبَاطِ اِ۬لْخَيْلِۖ تُرْهِبُونَ بِهِۦ عَدُوَّ اَ۬للَّهِ وَعَدُوَّكُمْ وَءَاخَرِينَ مِن دُونِهِمْ لَا تَعْلَمُونَهُمُۖ اُ۬للَّهُ يَعْلَمُهُمْۖ وَمَا تُ