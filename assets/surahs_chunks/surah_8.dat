ic": "وَرَسُولَهُۥٓ", "translit": "", "root": ""}, {"id": 16, "arabic": "إِن", "translit": "", "root": ""}, {"id": 17, "arabic": "كُنتُم", "translit": "", "root": ""}, {"id": 18, "arabic": "مُّومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 2, "text": "إِنَّمَا اَ۬لْمُومِنُونَ اَ۬لذِينَ إِذَا ذُكِرَ اَ۬للَّهُ وَجِلَتْ قُلُوبُهُمْ وَإِذَا تُلِيَتْ عَلَيْهِمُۥٓ ءَايَٰتُهُۥ زَادَتْهُمُۥٓ إِيمَٰناࣰ وَعَلَيٰ رَبِّهِمْ يَتَوَكَّلُونَۖ", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمُومِنُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "ذُكِرَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَجِلَتْ", "translit": "", "root": ""}, {"id": 8, "arabic": "قُلُوبُهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تُلِيَتْ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَيْهِمُۥٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "ءَايَٰتُهُۥ", "translit": "", "root": ""}, {"id": 13, "arabic": "زَادَتْهُمُۥٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِيمَٰناࣰ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَعَلَيٰ", "translit": "", "root": ""}, {"id": 16, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 17, "arabic": "يَتَوَكَّلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 3, "text": "اَ۬لذِينَ يُقِيمُونَ اَ۬لصَّلَوٰةَ وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَ", "words": [{"id": 1, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُقِيمُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمِمَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "رَزَقْنَٰهُمْ", "translit