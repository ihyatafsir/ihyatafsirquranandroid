": 8, "ayah": 61, "text": "وَإِن جَنَحُواْ لِلسَّلْمِ فَاجْنَحْ لَهَا وَتَوَكَّلْ عَلَي اَ۬للَّهِۖ إِنَّهُۥ هُوَ اَ۬لسَّمِيعُ اُ۬لْعَلِيمُۖ", "words": [{"id": 1, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "جَنَحُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلسَّلْمِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاجْنَحْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَتَوَكَّلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لسَّمِيعُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 62, "text": "وَإِنْ يُّرِيدُوٓاْ أَنْ يَّخْدَعُوكَ فَإِنَّ حَسْبَكَ اَ۬للَّهُۖ هُوَ اَ۬لذِےٓ أَيَّدَكَ بِنَصْرِهِۦ وَبِالْمُومِنِينَ", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُّرِيدُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَّخْدَعُوكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "حَسْبَكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لذِےٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَيَّدَكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "بِنَصْرِهِۦ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَبِالْمُومِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 63, "text": "وَأَلَّفَ بَيْنَ قُلُوبِهِمْۖ لَوَ اَنفَقْتَ مَا فِے اِ۬لَارْضِ جَمِيعاࣰ مَّآ أَلَّفْتَ بَيْنَ قُل