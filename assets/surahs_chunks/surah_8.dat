arration": "warsh"}, {"surah": 8, "ayah": 37, "text": "لِيَمِيزَ اَ۬للَّهُ اُ۬لْخَبِيثَ مِنَ اَ۬لطَّيِّبِ وَيَجْعَلَ اَ۬لْخَبِيثَ بَعْضَهُۥ عَلَيٰ بَعْضࣲ فَيَرْكُمَهُۥ جَمِيعاࣰ فَيَجْعَلَهُۥ فِے جَهَنَّمَۖ أُوْلَٰٓئِكَ هُمُ اُ۬لْخَٰسِرُونَۖ", "words": [{"id": 1, "arabic": "لِيَمِيزَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْخَبِيثَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لطَّيِّبِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَجْعَلَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْخَبِيثَ", "translit": "", "root": ""}, {"id": 8, "arabic": "بَعْضَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "بَعْضࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَيَرْكُمَهُۥ", "translit": "", "root": ""}, {"id": 12, "arabic": "جَمِيعاࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَيَجْعَلَهُۥ", "translit": "", "root": ""}, {"id": 14, "arabic": "فِے", "translit": "", "root": ""}, {"id": 15, "arabic": "جَهَنَّمَۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 17, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 18, "arabic": "اُ۬لْخَٰسِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 38, "text": "قُل لِّلذِينَ كَفَرُوٓاْ إِنْ يَّنتَهُواْ يُغْفَرْ لَهُم مَّا قَدْ سَلَفَۖ وَإِنْ يَّعُودُواْ فَقَدْ مَضَتْ سُنَّتُ اُ۬لَاوَّلِينَۖ", "words": [{"id": 1, "arabic": "قُل", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّلذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَّنتَهُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُغْفَرْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُم", "translit": "",