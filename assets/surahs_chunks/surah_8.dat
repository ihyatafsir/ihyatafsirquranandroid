": "warsh"}, {"surah": 8, "ayah": 8, "text": "لِيُحِقَّ اَ۬لْحَقَّ وَيُبْطِلَ اَ۬لْبَٰطِلَ وَلَوْ كَرِهَ اَ۬لْمُجْرِمُونَۖ", "words": [{"id": 1, "arabic": "لِيُحِقَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْحَقَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيُبْطِلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْبَٰطِلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَرِهَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُجْرِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 9, "text": "إِذْ تَسْتَغِيثُونَ رَبَّكُمْ فَاسْتَجَابَ لَكُمُۥٓ أَنِّے مُمِدُّكُم بِأَلْفࣲ مِّنَ اَ۬لْمَلَٰٓئِكَةِ مُرْدَفِينَۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَسْتَغِيثُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبَّكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاسْتَجَابَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنِّے", "translit": "", "root": ""}, {"id": 7, "arabic": "مُمِدُّكُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بِأَلْفࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْمَلَٰٓئِكَةِ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُرْدَفِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 10, "text": "وَمَا جَعَلَهُ اُ۬للَّهُ إِلَّا بُشْر۪يٰ وَلِتَطْمَئِنَّ بِهِۦ قُلُوبُكُمْۖ وَمَا اَ۬لنَّصْرُ إِلَّا مِنْ عِندِ اِ۬للَّهِۖ إِنَّ اَ۬للَّهَ عَزِيزٌ حَكِيمٌۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلَهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "بُشْر۪يٰ", "translit": "", "root": ""}, {"id": 6,