h": 47, "text": "وَلَا تَكُونُواْ كَالذِينَ خَرَجُواْ مِن دِيٰ۪رِهِم بَطَراࣰ وَرِئَآءَ اَ۬لنَّاسِ وَيَصُدُّونَ عَن سَبِيلِ اِ۬للَّهِۖ وَاللَّهُ بِمَا يَعْمَلُونَ مُحِيطࣱۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَكُونُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَالذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَرَجُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "دِيٰ۪رِهِم", "translit": "", "root": ""}, {"id": 7, "arabic": "بَطَراࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَرِئَآءَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لنَّاسِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَيَصُدُّونَ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَن", "translit": "", "root": ""}, {"id": 12, "arabic": "سَبِيلِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 15, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 16, "arabic": "يَعْمَلُونَ", "translit": "", "root": ""}, {"id": 17, "arabic": "مُحِيطࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 8, "ayah": 48, "text": "۞وَإِذْ زَيَّنَ لَهُمُ اُ۬لشَّيْطَٰنُ أَعْمَٰلَهُمْ وَقَالَ لَا غَالِبَ لَكُمُ اُ۬لْيَوْمَ مِنَ اَ۬لنَّاسِ وَإِنِّے جَارࣱ لَّكُمْۖ فَلَمَّا تَرَآءَتِ اِ۬لْفِئَتَٰنِ نَكَصَ عَلَيٰ عَقِبَيْهِ وَقَالَ إِنِّے بَرِےٓءࣱ مِّنكُمُۥٓ إِنِّيَ أَر۪يٰ مَا لَا تَرَوْنَ إِنِّيَ أَخَافُ اُ۬للَّهَۖ وَاللَّهُ شَدِيدُ اُ۬لْعِقَابِۖ", "words": [{"id": 1, "arabic": "۞وَإِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "زَيَّنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لشَّيْطَٰنُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَعْمَٰلَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَقَالَ", "translit": "", "root": ""