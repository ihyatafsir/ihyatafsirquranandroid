{"surah": 91, "verses": [{"ayah": 1, "text": "وَٱلشَّمْسِ وَضُحَىٰهَا ", "translation": "By the sun and its brightness", "words": [{"id": 1, "arabic": "وَٱلشَّمْسِ", "translit": "ِsْmَّhslٱَw", "root": "شمس", "latinTranslit": "wal-shamsi"}, {"id": 2, "arabic": "وَضُحَىٰهَا", "translit": "āَhٰàَḥُḍَw", "root": "ضحو", "latinTranslit": "waḍuḥāhā"}], "hasIhya": true, "haleemTranslation": "By the sun in its morning brightness", "clearyTranslation": "By the sun in its morning brightness"}, {"ayah": 2, "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا ", "translation": "And [by] the moon when it follows it", "words": [{"id": 1, "arabic": "وَٱلْقَمَرِ", "translit": "ِrَmَqْlٱَw", "root": "قمر", "latinTranslit": "wal-qamari"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": "", "latinTranslit": "idhā"}, {"id": 3, "arabic": "تَلَىٰهَا", "translit": "āَhٰàَlَt", "root": "تلو", "latinTranslit": "talāhā"}], "hasIhya": false, "haleemTranslation": "and by the moon as it follows it", "clearyTranslation": "and by the moon as it follows it"}, {"ayah": 3, "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا ", "translation": "And [by] the day when it displays it[1]", "words": [{"id": 1, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر", "latinTranslit": "wal-nahāri"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": "", "latinTranslit": "idhā"}, {"id": 3, "arabic": "جَلَّىٰهَا", "translit": "āَhٰàَّlَjg", "root": "جلو", "latinTranslit": "jallāhā"}], "hasIhya": false, "haleemTranslation": "by the day as it displays the sun’s glory", "clearyTranslation": "by the day as it displays the sun’s glory"}, {"ayah": 4, "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا ", "translation": "And [by] the night when it covers [i.e., conceals] it", "words": [{"id": 1, "arabic": "وَٱلَّيْلِ", "translit": "ِlْyَّlٱَw", "root": "ليل", "latinTranslit": "wa-al-layli"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": "", "latinTranslit": "idhā"}, {"id": 3, "arabic": "يَغْشَىٰهَا", "translit": "āَhٰàَhsْغَy", "root": "غشو", "latinTranslit": "yaghshāhā"}], "hasIhya": false, "haleemTranslation": "and by the night as it conceals it", "clearyTranslation": "and by the night as it conceals it"}, {"ayah": 5, "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا ", "translation": "And [by] the sky and He who constructed it", "words": [{"id": 1, "arabic": "وَٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱَw", "root": "سمو", "latinTranslit": "wal-samāi"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": "", "latinTranslit": "wamā"}, {"id": 3, "arabic": "بَنَىٰهَا", "translit": "āَhٰàَnَb", "root": "بني", "latinTranslit": "banāhā"}], "hasIhya": false, "haleemTranslation": "by the sky and how He built it", "clearyTranslation": "by the sky and how He built it"}, {"ayah": 6, "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا ", "translation": "And [by] the earth and He who spread it", "words": [{"id": 1, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض", "latinTranslit": "wal-arḍi"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": "", "latinTranslit": "wamā"}, {"id": 3, "arabic": "طَحَىٰهَا", "translit": "āَhٰàَḥَṭ", "root": "طحو", "latinTranslit": "ṭaḥāhā"}], "hasIhya": false, "haleemTranslation": "and by the earth and how He spread it", "clearyTranslation": "and by the earth and how He spread it"}, {"ayah": 7, "text": "وَنَفْسٍ وَمَا سَوَّىٰهَا ", "translation": "And [by] the soul and He who proportioned it[1]", "words": [{"id": 1, "arabic": "وَنَفْسٍ", "translit": "ٍsْfَnَw", "root": "نفس", "latinTranslit": "wanafsin"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": "", "latinTranslit": "wamā"}, {"id": 3, "arabic": "سَوَّىٰهَا", "translit": "āَhٰàَّwَs", "root": "سوي", "latinTranslit": "sawwāhā"}], "hasIhya": false, "haleemTranslation": "by the soul and how He formed it", "clearyTranslation": "by the soul and how He formed it"}, {"ayah": 8, "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا ", "translation": "And inspired it [with discernment of] its wickedness and its righteousness,", "words": [{"id": 1, "arabic": "فَأَلْهَمَهَا", "translit": "āَhَmَhْlَaʾَf", "root": "لهم", "latinTranslit": "fa-alhamahā"}, {"id": 2, "arabic": "فُجُورَهَا", "translit": "āَhَrwُjgُf", "root": "فجر", "latinTranslit": "fujūrahā"}, {"id": 3, "arabic": "وَتَقْوَىٰهَا", "translit": "āَhٰàَwْqَtَw", "root": "وقي", "latinTranslit": "wataqwāhā"}], "hasIhya": false, "haleemTranslation": "and inspired it [to know] its own rebellion and piety", "clearyTranslation": "and inspired it [to know] its own rebellion and piety"}, {"ayah": 9, "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا ", "translation": "He has succeeded who purifies it,", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": "", "latinTranslit": "qad"}, {"id": 2, "arabic": "أَفْلَحَ", "translit": "َḥَlْfَaʾ", "root": "فلح", "latinTranslit": "aflaḥa"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": "", "latinTranslit": "man"}, {"id": 4, "arabic": "زَكَّىٰهَا", "translit": "āَhٰàَّkَz", "root": "زكو", "latinTranslit": "zakkāhā"}], "hasIhya": true, "haleemTranslation": "The one who purifies his soul succeeds", "clearyTranslation": "The one who purifies his soul succeeds"}, {"ayah": 10, "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا ", "translation": "And he has failed who instills it [with corruption].", "words": [{"id": 1, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": "", "latinTranslit": "waqad"}, {"id": 2, "arabic": "خَابَ", "translit": "َbāَhk", "root": "خيب", "latinTranslit": "khāba"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": "", "latinTranslit": "man"}, {"id": 4, "arabic": "دَسَّىٰهَا", "translit": "āَhٰàَّsَd", "root": "دسو", "latinTranslit": "dassāhā"}], "hasIhya": true, "haleemTranslation": "and the one who corrupts it fails", "clearyTranslation": "and the one who corrupts it fails"}, {"ayah": 11, "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ ", "translation": "Thamūd denied [their prophet] by reason of their transgression,", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "ْtَbَّhdَk", "root": "كذب", "latinTranslit": "kadhabat"}, {"id": 2, "arabic": "ثَمُودُ", "translit": "ُdwُmَht", "root": "", "latinTranslit": "thamūdu"}, {"id": 3, "arabic": "بِطَغْوَىٰهَآ", "translit": "ٓāَhٰàَwْغَṭِb", "root": "طغي", "latinTranslit": "biṭaghwāhā"}], "hasIhya": false, "haleemTranslation": "In their arrogant cruelty, the people of Thamud called [their messenger] a liar", "clearyTranslation": "In their arrogant cruelty, the people of Thamud called [their messenger] a liar"}, {"ayah": 12, "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا ", "translation": "When the most wretched of them was sent forth.[1]", "words": [{"id": 1, "arabic": "إِذِ", "translit": "ِhdِiʾ", "root": "", "latinTranslit": "idhi"}, {"id": 2, "arabic": "ٱنۢبَعَثَ", "translit": "َhtَعَbۢnٱ", "root": "بعث", "latinTranslit": "inbaʿatha"}, {"id": 3, "arabic": "أَشْقَىٰهَا", "translit": "āَhٰàَqْhsَaʾ", "root": "شقو", "latinTranslit": "ashqāhā"}], "hasIhya": false, "haleemTranslation": "when the most wicked man among them rose [against him]", "clearyTranslation": "when the most wicked man among them rose [against him]"}, {"ayah": 13, "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا ", "translation": "And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول", "latinTranslit": "faqāla"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": "", "latinTranslit": "lahum"}, {"id": 3, "arabic": "رَسُولُ", "translit": "ُlwُsَr", "root": "رسل", "latinTranslit": "rasūlu"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 5, "arabic": "نَاقَةَ", "translit": "َẗَqāَn", "root": "نوق", "latinTranslit": "nāqata"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 7, "arabic": "وَسُقْيَٰهَا", "translit": "āَhَٰyْqُsَw", "root": "سقي", "latinTranslit": "wasuq'yāhā"}], "hasIhya": false, "haleemTranslation": "The messenger of God said to them, ‘[Leave] God’s camel to drink,’", "clearyTranslation": "The messenger of God said to them, ‘[Leave] God’s camel to drink,’"}, {"ayah": 14, "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا ", "translation": "But they denied him and hamstrung[1] her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].", "words": [{"id": 1, "arabic": "فَكَذَّبُوهُ", "translit": "ُhwُbَّhdَkَf", "root": "كذب", "latinTranslit": "fakadhabūhu"}, {"id": 2, "arabic": "فَعَقَرُوهَا", "translit": "āَhwُrَqَعَf", "root": "عقر", "latinTranslit": "faʿaqarūhā"}, {"id": 3, "arabic": "فَدَمْدَمَ", "translit": "َmَdْmَdَf", "root": "دمدم", "latinTranslit": "fadamdama"}, {"id": 4, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَع", "root": "", "latinTranslit": "ʿalayhim"}, {"id": 5, "arabic": "رَبُّهُم", "translit": "mُhُّbَr", "root": "ربب", "latinTranslit": "rabbuhum"}, {"id": 6, "arabic": "بِذَنۢبِهِمْ", "translit": "ْmِhِbۢnَhdِb", "root": "ذنب", "latinTranslit": "bidhanbihim"}, {"id": 7, "arabic": "فَسَوَّىٰهَا", "translit": "āَhٰàَّwَsَf", "root": "سوي", "latinTranslit": "fasawwāhā"}], "hasIhya": false, "haleemTranslation": "but they called him a liar and hamstrung her. Their Lord destroyed them for their crime and levelled them", "clearyTranslation": "but they called him a liar and hamstrung her. Their Lord destroyed them for their crime and levelled them"}, {"ayah": 15, "text": "وَلَا يَخَافُ عُقْبَٰهَا ", "translation": "And He does not fear the consequence thereof.[1]", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": "", "latinTranslit": "walā"}, {"id": 2, "arabic": "يَخَافُ", "translit": "ُfāَhkَy", "root": "خوف", "latinTranslit": "yakhāfu"}, {"id": 3, "arabic": "عُقْبَٰهَا", "translit": "āَhَٰbْqُع", "root": "عقب", "latinTranslit": "ʿuq'bāhā"}], "hasIhya": false, "haleemTranslation": "He did not hesitate to punish them", "clearyTranslation": "He did not hesitate to punish them"}], "tafsir": {"1": [{"arabic": "ذات الحبك والسماء وما بناها وكقوله تعالى والشمس وضحاها والقمر إذا تلاها وكقوله تعالى فلا أقسم بالخنس الجوار الكنس وقوله تعالى والنجم إذا", "english": "I say — and of the heaven with its woven structure, and the heaven and what built it; and His saying, may He be exalted: {«And the sun and its morning brightness, and the moon when it follows it»} (Q 91:1-2); and His saying, may He be exalted: {«Nay, I swear by the slinking stars, the runners, the sinkers»} (Q 81:15-16); and His saying, may He be exalted: {«And the star when it falls — nay, I swear by the positions of the stars, and verily it is a mighty oath, if you but knew»} (Q 56:75-76). You have thus come to know that the wonders of the filthy drop of semen — the first and last generations have fallen short of comprehending them. So if God swore by such things, what is your assumption concerning that by which God, may He be exalted, swore, and upon which He made provisions dependent, and to which He annexed them, saying, may He be exalted: {«And in the heaven is your provision and that which you are promised»} (Q 51:22)? And He praised those who reflect upon it, saying: {«And they reflect upon the creation of the heavens and the earth»} (Q 3:191). And the Messenger of God, may God's peace and blessing be upon him, said: \"Woe to him who recites this verse and then wipes his moustache with it\" — that is, passes over it without reflection. And He censured those who turn away from it, saying: {«And We made the heaven a protected roof, yet from its signs they turn away»} (Q 21:32). So what comparison is there between all the seas and the earth, on the one hand, and the heaven, on the other — given that the former are subject to rapid changes, while the heavens are solid, mighty, and preserved from change until the Book reaches its appointed term? For this reason God, may He be exalted, called it \"protected,\" saying: {«And We made the heaven a protected roof»} (Q 21:32); and He said, glory be to Him: {«And We built above you seven mighty ones»} (Q 78:12); and He said: {«Are you stronger in creation or the heaven? He built it, He raised high its roof and fashioned it»} (Q 79:27-28).", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 1278", "section_title_en": "On Contemplating the Kingdom of the Heavens (التفكر في ملكوت السموات)", "section_index": 1278, "anchors": "- Root: م ل ك (malaka)\n  * Lisan / Ayn: الملك: القوة على التصرف، والملكوت: زيادة الميم للمبالغة كالرهبوت والرحموت\n  * Al-Raghib (Mufradat): الملكوت: عالم الغيب الذي لا تدركه الحواس، والملك: عالم الشهادة المحسوس\n  * Al-Zamakhshari (Asas): الملكوت مجاز عن باطن الملك وسرّه، لا عن ظاهره المحسوس\n- Root: س م و (sama)\n  * Lisan / Ayn: السماء: كل ما علاك فأظلك، وأصلها السمو بمعنى الارتفاع\n  * Al-Raghib (Mufradat): السماء: الجرم المقابل للأرض، وتستعمل بمعنى العلو والملكوت الأعلى\n  * Al-Zamakhshari (Asas): \"سقفا محفوظا\" حقيقة في الحفظ عن التغير والاضمحلال\n- Root: غ ي ب (ghayb)\n  * Al-Raghib (Mufradat): الغيب: ما استتر عن الحواس، ويقال للشيء غيب باعتباره بالناس لا بالله تعالى، فإنه لا يغيب عنه شيء\n  * Al-Zamakhshari (Asas): الغيب والملكوت مترادفان في اصطلاح القرآن لما غاب عن الأبصار\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره لمراعاة البلاغة والمقام", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Ihya Ulum al-Din'", "badge": "Commentary"}], "9": [{"arabic": "فجورها وتقواها قد أفلح من زكاها وقد خاب من دساها فمهما وقع العبد في ذنب فصار الذنب نقدا والتوبة نسيئة كان هذا من علامات الخذلان قال صلى الله عليه وسلم إن العبد ليعمل بعمل أهل الجنة سبعين سنة حتى يقول الناس إنه من أهلها ولا يبقى بينه وبين الجنة إلا شبر فيسبق عليه الكتاب فيعمل بعمل أهل النار فيدخلها (1) فإذن الخوف من الخاتمة قبل التوبة وكل نفس فهو خاتمة ما قبله إذ يمكن أن يكون الموت متصلا به فليراقب الأنفاس وإلا وقع في المحذور ودامت الحسرات حين لا", "english": "**The Third Rank:** That one repents and continues upon steadfastness for a period, then passions overcome him in some sins, and he commits them with sincerity and deliberate intent of passion, due to his inability to subdue the passion — except that, along with that, he is constant upon acts of obedience and abandons a number of sins despite ability and passion. Only this one passion, or two passions, have overcome him, and he wishes that God Almighty would empower him to suppress it and spare him its evil. This is his aspiration at the moment of fulfilling the passion. Upon finishing, he feels remorse and says: \"Would that I had not done it; I shall repent of it and strive against my soul in subduing it\" — but his soul wheedles him (tasawwalu) and he procrastinates his repentance, time after time and day after day. This soul is the one called \"the wheedling soul\" (al-nafs al-musawwilah), and its possessor is among those of whom God Almighty said: {«وآخرون اعترفوا بذنوبهم خلطوا عملا صالحا وآخر سيئا»} — \"And others acknowledged their sins: they mixed a righteous deed with another evil one.\" His affair, in respect of his constancy upon acts of obedience and his abhorrence of what he perpetrated, is hopeful — perhaps God will turn toward him. But his end is perilous, in respect of his procrastination and delay, for perhaps he will be snatched away before repentance, and his affair falls under [divine] will (mashī'ah). If God overtakes him with His bounty, mends his fracture, and bestows repentance upon him, he joins the foremost. But if his wretchedness overcomes him and his passion subdues him, it is feared that what was decreed for him in eternity past (al-azal) will be realized against him at the seal [of his life]. For whenever it proves difficult for the student of jurisprudence, for example, to guard against the distractions of learning, its difficulty indicates that it was decreed for him in eternity past that he would be among the ignorant — so hope weakens in his regard. And when the causes of constancy upon acquisition are made easy for him, that indicates that it was decreed for him in eternity past that he would be among the learned. Likewise is the interconnection of the felicities of the Hereafter and its degrees of misery with good deeds and evil deeds, by the decree of the Causer of causes (musabbib al-asbāb) — like the interconnection of illness and health with the consumption of foods and medicines, and like the interconnection of the attainment of the jurisprudence of the soul (fiqh al-nafs), by which one merits high stations in this world, with abandoning laziness and being constant in educating the soul. For just as none is fit for the station of leadership, judgeship, and precedence in knowledge except a soul that has become jurisprudent through long study, so none is fit for the kingdom of the Hereafter and its bliss, nor for nearness to the Lord of the worlds, except a sound heart that has become pure through long purification and cleansing. Thus it was decreed in eternity past by the governance of the Lord of lords. For this reason He said, Almighty: {«ونفس وما سواها فألهمها فجورها وتقواها قد أفلح من زكاها وقد خاب من دساها»} — \"And by the soul and Him who proportioned it, and inspired it with its wickedness and its piety — he has succeeded who purifies it, and he has failed who buries it [in corruption].\"", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 939", "section_title_en": "The Four Ranks of the Repentant — On the Degrees of Tawbah and the States of the Soul", "section_index": 939, "anchors": "- Root: توب (T-W-B)\n  * Lisan / Ayn: Return, turning back; the verbal noun denotes the act of reverting from a state.\n  * Al-Raghib (Mufradat): \"التوب: ترك الذنب على أجمل الوجوه\" — abandoning sin in the most beautiful manner; the most complete form of apology, comprising abandonment of the sin due to its ugliness, remorse for what passed, and resolve against return.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"تاب العبد إلى الله من ذنبه\" — the servant's turning to God from his sin. Metaphorical (Majaz): The mutual relation of divine acceptance (تاب الله على عبده) as a response to the servant's turning.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, spirit; that which animates and distinguishes.\n  * Al-Raghib (Mufradat): The soul (النفس) as the locus of divine address and self-reproach; its states (mutma'innah, lawwāmah, ammārah) are graded by its orientation toward God or toward passions.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity. Metaphorical: \"دفق نفسه\" (his blood/life) — the soul as the seat of life and moral agency.\n- Root: ذنب (Dh-N-B)\n  * Lisan / Ayn: The tail; that which follows behind.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin as the act of seizing the consequence; the trailing fault that follows the agent.\n  * Al-Zamakhshari (Asas): Literal: the tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as the trailing mark of the soul's deviation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the four ranks precisely, ensuring each category is mutually exclusive and exhaustive in its defining condition.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}, {"arabic": "وإنما مراد الطاعات وأعمال الجوارح كلها تصفية القلب وتزكيته وجلاؤه {قد أفلح من زكاها} ومراد تزكيته حصول أنوار الإيمان فيه أعني إشراق نور المعرفة وهو المراد بقوله تعالى فمن يرد الله أن يهديه يشرح صدره للإسلام أفمن شرح الله صدره للإسلام فهو على نور من ربه نعم هذا التجلي وهذا الإيمان له ثلاث مراتب المرتبة الأولى إيمان العوام وهو إيمان التقليد المحض والثانية إيمان المتكلمين وهو ممزوج بنوع استدلال ودرجته قريبة من درجة إيمان العوام والثالثة إيمان العارفين وهو المشاهد بنور اليقين ونبين", "english": "The sole purpose of acts of obedience and all the works of the bodily members is the purification of the heart, its cleansing, and its polishing: {«قَدْ أَفْلَحَ مَن زَكَّاهَا»} [\"He has succeeded who purifies it\"] (91:9). And the purpose of its purification is the attainment of the lights of faith within it — that is, the shining of the light of knowledge (maʿrifah). And this is the meaning of His saying, Most High: {«فَمَن يُرِدِ اللَّهُ أَن يَهْدِيَهُ يَشْرَحْ صَدْرَهُ لِلْإِسْلَامِ»} [\"Whomever God wishes to guide, He expands his breast for Islam\"] (6:125), and His saying: {«أَفَمَن شَرَحَ اللَّهُ صَدْرَهُ لِلْإِسْلَامِ فَهُوَ عَلَىٰ نُورٍ مِّن رَّبِّهِ»} [\"Is he whose breast God has expanded for Islam, so he is upon a light from his Lord...\"] (39:22).", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 585", "section_title_en": "Section 585", "section_index": 585, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, transform from one state to another; the heart as that which is constantly turning and fluctuating between states\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation; the spiritual heart (qalb) is that subtle divine reality (laṭīfah rabbāniyyah) which is the locus of perception and knowledge\n  * Al-Zamakhshari (Asas): Literal: turning a thing over; Metaphorical: \"قلب المعلم الصبيان\" — the teacher turns the boys toward their homes; thus the heart is that which turns toward the spiritual world (malakūt) when purified\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Possession, dominion, sovereignty; the kingdom\n  * Al-Raghib (Mufradat): الملك: possession and dominion; الملكوت: the spiritual dominion — the unseen world of divine sovereignty\n  * Al-Zamakhshari (Asas): الملك: that which is under one's dominion; الملكوت: intensive form indicating the absolute and perfect dominion of God over all things\n- Root: ايم (a-y-m)\n  * Al-Raghib (Al-Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها\" — one without a spouse; extended metaphorically\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"الحرب مأيمة ميتمة\" — war makes women widows and children orphans\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise scope of statements about what the heart perceives and the degrees of faith\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Ihya Ulum al-Din'", "badge": "Insight"}], "10": [{"arabic": "هو المراد بقوله تعالى قد أفلح من زكاها وإهمالها هو المراد بقوله وقد خاب من دساها ونحن نشير في هذا الكتاب إلى جمل من أمراض القلوب وكيفية القول في", "english": "Evil character traits are maladies of the hearts and sicknesses of the souls — except that it is a sickness that forfeits the life of eternity. Where is that sickness compared to the one that forfeits only the life of the body? Whenever the physicians' care is intense in regulating the laws of treatment for bodies — when in their sickness there is only the forfeiture of the passing life — then the care for regulating the laws of treatment for the maladies of the hearts — when in their sickness there is the forfeiture of an everlasting life — is more fitting and more worthy. This kind of medicine is obligatory to learn upon every possessor of intellect (dhī lubb), for no heart among hearts is free from sicknesses which, if neglected, would accumulate and compound, with ailments multiplying and overwhelming one another. Thus the servant stands in need of meticulous care in knowing their science and their causes, and then of exertion in their treatment and rectification. Treating them is what is meant by His saying, Exalted is He: {«قَدْ أَفْلَحَ مَنْ زَكَّاهَا»} — \"He has succeeded who purifies it\" — and neglecting them is what is meant by His saying: {«وَقَدْ خَابَ مَنْ دَسَّاهَا»} — \"and he has failed who corrupts it.\"", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 612", "section_title_en": "The Book of Training the Soul, Refining Character, and Treating the Maladies of the Heart — Being the Second Book of the Quarter of the Destroyers", "section_index": 612, "anchors": "- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning of measuring, proportioning, and fashioning; also the innate disposition and character (khuluq) that is the form of the soul.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — the original sense is sound estimation/proportioning; used for bringing something into being from nothing (ibdāʿ) and for the inward character that is the soul's stable form.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"خلق الخراز الأديم\" — the leather-worker measures the hide before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God created creation upon a measure necessitated by wisdom. Thus \"khuluq\" (character) is the soul's measured, stable form.\n- Root: مرض (mariḍa)\n  * Lisan / Ayn: Sickness, departure from the body's balanced temperament.\n  * Al-Raghib (Mufradat): \"المرض: الخروج عن الاعتدال الخاص بالإنسان\" — sickness is departure from the equilibrium specific to the human. Two kinds: bodily sickness, and \"عبارة عن الرذائل كالجهل، والجبن، والبخل، والنفاق\" — an expression for vices such as ignorance, cowardice, miserliness, and hypocrisy.\n  * Al-Zamakhshari (Asas): Literal: bodily illness. Metaphorical: \"مرض في الأمر: ضجع فيه\" — to be weak/lax in a matter; and \"تمارض\" — to feign illness. Thus heart-sickness is the soul's departure from its proper spiritual equilibrium.\n- Root: قلب (qalaba)\n  * Lisan / Ayn: To turn, overturn, transform from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning a thing and diverting it from one face to another. The heart (qalb) is so named for its constant turning and fluctuation between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — turned it from its face. Metaphorical: \"قلب التاجر السلعة\" — the merchant examined the merchandise, scrutinizing its conditions. Thus the heart is the seat of moral scrutiny and transformation.\n- Root: حسن (ḥasuna)\n  * Lisan / Ayn: Beauty, goodness, excellence.\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — goodness is an expression for everything delightful and desirable. Three kinds: good by reason, good by desire (passion), good by sense.\n  * Al-Zamakhshari (Asas): Literal: \"أنظر إلى محاسن وجهه\" — behold the beauties of his face. Metaphorical: \"فلان لا يحسن شيئا\" — so-and-so does not do anything well; \"وقيمة المرء ما يحسن\" — a man's value is what he does well. Thus ḥusn al-khuluq (good character) is the soul's excellence in its measured form.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a governing word and its governed prepositional phrase, as in \"كقبح رب فيها رجل\" — demonstrating that what may be separated in eloquent speech follows the pattern of what is grammatically sound and rhetorically effective.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Ihya Ulum al-Din'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 290, 1658], [2, 1658, 3930]], "91:1": [[1, 290, 1658], [2, 1658, 3930]], "2": [[1, 390, 1717], [2, 1717, 2672], [3, 2672, 4670]], "91:2": [[1, 390, 1717], [2, 1717, 2672], [3, 2672, 4670]], "3": [[1, 250, 2324], [2, 2324, 3307], [3, 3307, 5510]], "91:3": [[1, 250, 2324], [2, 2324, 3307], [3, 3307, 5510]], "4": [[1, 210, 1498], [2, 1498, 2405], [3, 2405, 4800]], "91:4": [[1, 210, 1498], [2, 1498, 2405], [3, 2405, 4800]], "5": [[1, 180, 3040], [2, 3040, 4160], [3, 4160, 6080]], "91:5": [[1, 180, 3040], [2, 3040, 4160], [3, 4160, 6080]], "6": [[1, 310, 1621], [2, 1621, 2732], [3, 2732, 4700]], "91:6": [[1, 310, 1621], [2, 1621, 2732], [3, 2732, 4700]], "7": [[1, 200, 1269], [2, 1269, 2455], [3, 2455, 5130]], "91:7": [[1, 200, 1269], [2, 1269, 2455], [3, 2455, 5130]], "8": [[1, 20, 1775], [2, 1775, 3590], [3, 3590, 6780]], "91:8": [[1, 20, 1775], [2, 1775, 3590], [3, 3590, 6780]], "9": [[1, 340, 967], [2, 967, 2046], [3, 2046, 2548], [4, 2548, 5360]], "91:9": [[1, 340, 967], [2, 967, 2046], [3, 2046, 2548], [4, 2548, 5360]], "10": [[1, 160, 1240], [2, 1240, 2309], [3, 2309, 2750], [4, 2750, 5260]], "91:10": [[1, 160, 1240], [2, 1240, 2309], [3, 2309, 2750], [4, 2750, 5260]], "11": [[1, 10, 972], [2, 972, 2046], [3, 2046, 5500]], "91:11": [[1, 10, 972], [2, 972, 2046], [3, 2046, 5500]], "12": [[1, 10, 606], [2, 606, 1824], [3, 1824, 4950]], "91:12": [[1, 10, 606], [2, 606, 1824], [3, 1824, 4950]], "13": [[1, 200, 1574], [2, 1574, 2249], [3, 2249, 3530], [4, 3530, 4462], [5, 4462, 5790], [6, 5790, 6722], [7, 6722, 9870]], "91:13": [[1, 200, 1574], [2, 1574, 2249], [3, 2249, 3530], [4, 3530, 4462], [5, 4462, 5790], [6, 5790, 6722], [7, 6722, 9870]], "14": [[1, 360, 2502], [2, 2502, 5223], [3, 5223, 6525], [4, 6525, 8022], [5, 8022, 9233], [6, 9233, 10796], [7, 10796, 14640]], "91:14": [[1, 360, 2502], [2, 2502, 5223], [3, 5223, 6525], [4, 6525, 8022], [5, 8022, 9233], [6, 9233, 10796], [7, 10796, 14640]], "15": [[1, 10, 1334], [2, 1334, 2908], [3, 2908, 5120]], "91:15": [[1, 10, 1334], [2, 1334, 2908], [3, 2908, 5120]]}, "abdulbasit": {"1": [[1, 400, 1360], [2, 1370, 2960]], "91:1": [[1, 400, 1360], [2, 1370, 2960]], "2": [[1, 700, 1660], [2, 1670, 2260], [3, 2270, 3690]], "91:2": [[1, 700, 1660], [2, 1670, 2260], [3, 2270, 3690]], "3": [[1, 650, 2360], [2, 2370, 3010], [3, 3020, 4530]], "91:3": [[1, 650, 2360], [2, 2370, 3010], [3, 3020, 4530]], "4": [[1, 750, 1760], [2, 1770, 2450], [3, 2460, 4090]], "91:4": [[1, 750, 1760], [2, 1770, 2450], [3, 2460, 4090]], "5": [[1, 650, 2800], [2, 2810, 3480], [3, 3490, 4690]], "91:5": [[1,