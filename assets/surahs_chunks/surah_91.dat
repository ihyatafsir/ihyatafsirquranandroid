}, {"id": 2, "arabic": "خَابَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَن", "translit": "", "root": ""}, {"id": 4, "arabic": "دَسَّيٰهَاۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 91, "ayah": 11, "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَيٰهَآ", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "", "root": ""}, {"id": 2, "arabic": "ثَمُودُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِطَغْوَيٰهَآ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 91, "ayah": 12, "text": "إِذِ اِ۪نۢبَعَثَ أَشْقَيٰهَا", "words": [{"id": 1, "arabic": "إِذِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪نۢبَعَثَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَشْقَيٰهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 91, "ayah": 13, "text": "فَقَالَ لَهُمْ رَسُولُ اُ۬للَّهِ نَاقَةَ اَ۬للَّهِ وَسُقْيَاهَا", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَسُولُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬للَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَاقَةَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَسُقْيَاهَا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 91, "ayah": 14, "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّيٰهَاۖ", "words": [{"id": 1, "arabic": "فَكَذَّبُوهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَعَقَرُوهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فَدَمْدَمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبُّهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِذَنۢبِهِمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَسَوَّيٰهَاۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 91, "ayah": 15, "text": "فَلَا يَخَافُ عُقْبَٰهَاۖ", "words": [{"id": 1, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَخَافُ", "translit": "", "root": ""}, {"id": 3, "arabic": "عُقْبَٰهَاۖ", "translit": "", "root": ""}], "narration": "warsh"}]}