{"surah": 91, "verses": [{"ayah": 1, "text": "وَٱلشَّمْسِ وَضُحَىٰهَا ", "translation": "By the sun and its brightness", "words": [{"id": 1, "arabic": "وَٱلشَّمْسِ", "translit": "ِsْmَّhslٱَw", "root": "شمس"}, {"id": 2, "arabic": "وَضُحَىٰهَا", "translit": "āَhٰàَḥُḍَw", "root": "ضحو"}], "hasIhya": true}, {"ayah": 2, "text": "وَٱلْقَمَرِ إِذَا تَلَىٰهَا ", "translation": "And [by] the moon when it follows it", "words": [{"id": 1, "arabic": "وَٱلْقَمَرِ", "translit": "ِrَmَqْlٱَw", "root": "قمر"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "تَلَىٰهَا", "translit": "āَhٰàَlَt", "root": "تلو"}], "hasIhya": false}, {"ayah": 3, "text": "وَٱلنَّهَارِ إِذَا جَلَّىٰهَا ", "translation": "And [by] the day when it displays it[1]", "words": [{"id": 1, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "جَلَّىٰهَا", "translit": "āَhٰàَّlَjg", "root": "جلو"}], "hasIhya": false}, {"ayah": 4, "text": "وَٱلَّيْلِ إِذَا يَغْشَىٰهَا ", "translation": "And [by] the night when it covers [i.e., conceals] it", "words": [{"id": 1, "arabic": "وَٱلَّيْلِ", "translit": "ِlْyَّlٱَw", "root": "ليل"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "يَغْشَىٰهَا", "translit": "āَhٰàَhsْغَy", "root": "غشو"}], "hasIhya": false}, {"ayah": 5, "text": "وَٱلسَّمَآءِ وَمَا بَنَىٰهَا ", "translation": "And [by] the sky and He who constructed it", "words": [{"id": 1, "arabic": "وَٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱَw", "root": "سمو"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 3, "arabic": "بَنَىٰهَا", "translit": "āَhٰàَnَb", "root": "بني"}], "hasIhya": false}, {"ayah": 6, "text": "وَٱلْأَرْضِ وَمَا طَحَىٰهَا ", "translation": "And [by] the earth and He who spread it", "words": [{"id": 1, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 3, "arabic": "طَحَىٰهَا", "translit": "āَhٰàَḥَṭ", "root": "طحو"}], "hasIhya": false}, {"ayah": 7, "text": "وَنَفْسٍ وَمَا سَوَّىٰهَا ", "translation": "And [by] the soul and He who proportioned it[1]", "words": [{"id": 1, "arabic": "وَنَفْسٍ", "translit": "ٍsْfَnَw", "root": "نفس"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 3, "arabic": "سَوَّىٰهَا", "translit": "āَhٰàَّwَs", "root": "سوي"}], "hasIhya": false}, {"ayah": 8, "text": "فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا ", "translation": "And inspired it [with discernment of] its wickedness and its righteousness,", "words": [{"id": 1, "arabic": "فَأَلْهَمَهَا", "translit": "āَhَmَhْlَaʾَf", "root": "لهم"}, {"id": 2, "arabic": "فُجُورَهَا", "translit": "āَhَrwُjgُf", "root": "فجر"}, {"id": 3, "arabic": "وَتَقْوَىٰهَا", "translit": "āَhٰàَwْqَtَw", "root": "وقي"}], "hasIhya": false}, {"ayah": 9, "text": "قَدْ أَفْلَحَ مَن زَكَّىٰهَا ", "translation": "He has succeeded who purifies it,", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "أَفْلَحَ", "translit": "َḥَlْfَaʾ", "root": "فلح"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "زَكَّىٰهَا", "translit": "āَhٰàَّkَz", "root": "زكو"}], "hasIhya": true}, {"ayah": 10, "text": "وَقَدْ خَابَ مَن دَسَّىٰهَا ", "translation": "And he has failed who instills it [with corruption].", "words": [{"id": 1, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 2, "arabic": "خَابَ", "translit": "َbāَhk", "root": "خيب"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "دَسَّىٰهَا", "translit": "āَhٰàَّsَd", "root": "دسو"}], "hasIhya": true}, {"ayah": 11, "text": "كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ ", "translation": "Thamūd denied [their prophet] by reason of their transgression,", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "ْtَbَّhdَk", "root": "كذب"}, {"id": 2, "arabic": "ثَمُودُ", "translit": "ُdwُmَht", "root": ""}, {"id": 3, "arabic": "بِطَغْوَىٰهَآ", "translit": "ٓāَhٰàَwْغَṭِb", "root": "طغي"}], "hasIhya": false}, {"ayah": 12, "text": "إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا ", "translation": "When the most wretched of them was sent forth.[1]", "words": [{"id": 1, "arabic": "إِذِ", "translit": "ِhdِiʾ", "root": ""}, {"id": 2, "arabic": "ٱنۢبَعَثَ", "translit": "َhtَʿعَbۢnٱ", "root": "بعث"}, {"id": 3, "arabic": "أَشْقَىٰهَا", "translit": "āَhٰàَqْhsَaʾ", "root": "شقو"}], "hasIhya": false}, {"ayah": 13, "text": "فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا ", "translation": "And the messenger of Allāh [i.e., Ṣāliḥ] said to them, \"[Do not harm] the she-camel of Allāh or [prevent her from] her drink.\"", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "رَسُولُ", "translit": "ُlwُsَr", "root": "رسل"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "نَاقَةَ", "translit": "َẗَqāَn", "root": "نوق"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَسُقْيَٰهَا", "translit": "āَhَٰyْqُsَw", "root": "سقي"}], "hasIhya": false}, {"ayah": 14, "text": "فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا ", "translation": "But they denied him and hamstrung[1] her. So their Lord brought down upon them destruction for their sin and made it equal [upon all of them].", "words": [{"id": 1, "arabic": "فَكَذَّبُوهُ", "translit": "ُhwُbَّhdَkَf", "root": "كذب"}, {"id": 2, "arabic": "فَعَقَرُوهَا", "translit": "āَhwُrَqَʿعَf", "root": "عقر"}, {"id": 3, "arabic": "فَدَمْدَمَ", "translit": "َmَdْmَdَf", "root": "دمدم"}, {"id": 4, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "رَبُّهُم", "translit": "mُhُّbَr", "root": "ربب"}, {"id": 6, "arabic": "بِذَنۢبِهِمْ", "translit": "ْmِhِbۢnَhdِb", "root": "ذنب"}, {"id": 7, "arabic": "فَسَوَّىٰهَا", "translit": "āَhٰàَّwَsَf", "root": "سوي"}], "hasIhya": false}, {"ayah": 15, "text": "وَلَا يَخَافُ عُقْبَٰهَا ", "translation": "And He does not fear the consequence thereof.[1]", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَخَافُ", "translit": "ُfāَhkَy", "root": "خوف"}, {"id": 3, "arabic": "عُقْبَٰهَا", "translit": "āَhَٰbْqُʿع", "root": "عقب"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "ذات الحبك والسماء وما بناها وكقوله تعالى والشمس وضحاها والقمر إذا تلاها وكقوله تعالى فلا أقسم بالخنس الجوار الكنس وقوله تعالى والنجم إذا هوى فلا أقسم بمواقع النجوم وإنه لقسم لو تعلمون عظيم فقد علمت أن عجائب النطفة القذرة عجز عن معرفتها الأولون والآخرون وما أقسم الله بها فما ظنك بما أقسم الله تعالى به وأحال الأرزاق عليه وأضافها إليه فقال تعالى وفي السماء رزقكم وما توعدون وأثنى على المفكرين فيه فقال ويتفكرون في خلق السموات والأرض وقال رسول الله صلى الله عليه وسلم ويل لمن قرأ هذه الآية ثم مسح بها سبلته (1) أى تجاوزها م", "english": "I say — and of the heaven with its woven structure, and the heaven and what built it; and His saying, may He be exalted: {«And the sun and its morning brightness, and the moon when it follows it»} (Q 91:1-2); and His saying, may He be exalted: {«Nay, I swear by the slinking stars, the runners, the sinkers»} (Q 81:15-16); and His saying, may He be exalted: {«And the star when it falls — nay, I swear by the positions of the stars, and verily it is a mighty oath, if you but knew»} (Q 56:75-76). You have thus come to know that the wonders of the filthy drop of semen — the first and last generations have fallen short of comprehending them. So if God swore by such things, what is your assumption concerning that by which God, may He be exalted, swore, and upon which He made provisions dependent, and to which He annexed them, saying, may He be exalted: {«And in the heaven is your provision and that which you are promised»} (Q 51:22)? And He praised those who reflect upon it, saying: {«And they reflect upon the creation of the heavens and the earth»} (Q 3:191). And the Messenger of God, may God's peace and blessing be upon him, said: \"Woe to him who recites this verse and then wipes his moustache with it\" — that is, passes over it without reflection. And He censured those who turn away from it, saying: {«And We made the heaven a protected roof, yet from its signs they turn away»} (Q 21:32). So what comparison is there between all the seas and the earth, on the one hand, and the heaven, on the other — given that the former are subject to rapid changes, while the heavens are solid, mighty, and preserved from change until the Book reaches its appointed term? For this reason God, may He be exalted, called it \"protected,\" saying: {«And We made the heaven a protected roof»} (Q 21:32); and He said, glory be to Him: {«And We built above you seven mighty ones»} (Q 78:12); and He said: {«Are you stronger in creation or the heaven? He built it, He raised high its roof and fashioned it»} (Q 79:27-28).", "book_title": "Contemplation", "section_title_ar": "Section 1278", "section_title_en": "On Contemplating the Kingdom of the Heavens (التفكر في ملكوت السموات)", "section_index": 1278, "anchors": "- Root: م ل ك (malaka)\n  * Lisan / Ayn: الملك: القوة على التصرف، والملكوت: زيادة الميم للمبالغة كالرهبوت والرحموت\n  * Al-Raghib (Mufradat): الملكوت: عالم الغيب الذي لا تدركه الحواس، والملك: عالم الشهادة المحسوس\n  * Al-Zamakhshari (Asas): الملكوت مجاز عن باطن الملك وسرّه، لا عن ظاهره المحسوس\n- Root: س م و (sama)\n  * Lisan / Ayn: السماء: كل ما علاك فأظلك، وأصلها السمو بمعنى الارتفاع\n  * Al-Raghib (Mufradat): السماء: الجرم المقابل للأرض، وتستعمل بمعنى العلو والملكوت الأعلى\n  * Al-Zamakhshari (Asas): \"سقفا محفوظا\" حقيقة في الحفظ عن التغير والاضمحلال\n- Root: غ ي ب (ghayb)\n  * Al-Raghib (Mufradat): الغيب: ما استتر عن الحواس، ويقال للشيء غيب باعتباره بالناس لا بالله تعالى، فإنه لا يغيب عنه شيء\n  * Al-Zamakhshari (Asas): الغيب والملكوت مترادفان في اصطلاح القرآن لما غاب عن الأبصار\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره لمراعاة البلاغة والمقام", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "9": [{"arabic": "فجورها وتقواها قد أفلح من زكاها وقد خاب من دساها فمهما وقع العبد في ذنب فصار الذنب نقدا والتوبة نسيئة كان هذا من علامات الخذلان قال صلى الله عليه وسلم إن العبد ليعمل بعمل أهل الجنة سبعين سنة حتى يقول الناس إنه من أهلها ولا يبقى بينه وبين الجنة إلا شبر فيسبق عليه الكتاب فيعمل بعمل أهل النار فيدخلها (1) فإذن الخوف من الخاتمة قبل التوبة وكل نفس فهو خاتمة ما قبله إذ يمكن أن يكون الموت متصلا به فليراقب الأنفاس وإلا وقع في المحذور ودامت الحسرات حين لا ينفع التحسر الطبقة الرابعة أن يتوب ويجري مدة على ا", "english": "**The First Rank:** That the disobedient one repents and remains steadfast upon repentance until the end of his life, so that he makes up for what he let slip of his affair, and does not prompt himself to return to his sins — except for the slips (zallāt) from which human beings are not free in their habitual ways, so long as one is not at the rank of prophethood. This is steadfastness upon repentance, and its possessor is the one who races forward in good deeds, exchanging his evil deeds for good ones. The name of this repentance is \"sincere repentance\" (al-tawbah al-naṣūḥ), and the name of this soul is the \"tranquil soul\" (al-nafs al-muṭma'innah) which returns to its Lord, well-pleased and well-pleasing. These are those to whom the Prophet, peace be upon him, pointed when he said: {«سبق المفردون المستهترون بذكر الله تعالى وضع الذكر عنهم أوزارهم فوردوا القيامة خفافا»} — \"The solitary ones have outstripped [all others] — those who are engrossed in the remembrance of God Almighty, for remembrance has lifted their burdens from them, and they arrive at the Resurrection light [of burden].\" For in this there is an indication that they were beneath burdens which remembrance lifted from them.", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 939", "section_title_en": "The Four Ranks of the Repentant — On the Degrees of Tawbah and the States of the Soul", "section_index": 939, "anchors": "- Root: توب (T-W-B)\n  * Lisan / Ayn: Return, turning back; the verbal noun denotes the act of reverting from a state.\n  * Al-Raghib (Mufradat): \"التوب: ترك الذنب على أجمل الوجوه\" — abandoning sin in the most beautiful manner; the most complete form of apology, comprising abandonment of the sin due to its ugliness, remorse for what passed, and resolve against return.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"تاب العبد إلى الله من ذنبه\" — the servant's turning to God from his sin. Metaphorical (Majaz): The mutual relation of divine acceptance (تاب الله على عبده) as a response to the servant's turning.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, spirit; that which animates and distinguishes.\n  * Al-Raghib (Mufradat): The soul (النفس) as the locus of divine address and self-reproach; its states (mutma'innah, lawwāmah, ammārah) are graded by its orientation toward God or toward passions.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity. Metaphorical: \"دفق نفسه\" (his blood/life) — the soul as the seat of life and moral agency.\n- Root: ذنب (Dh-N-B)\n  * Lisan / Ayn: The tail; that which follows behind.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin as the act of seizing the consequence; the trailing fault that follows the agent.\n  * Al-Zamakhshari (Asas): Literal: the tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as the trailing mark of the soul's deviation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the four ranks precisely, ensuring each category is mutually exclusive and exhaustive in its defining condition.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "وإنما مراد الطاعات وأعمال الجوارح كلها تصفية القلب وتزكيته وجلاؤه {قد أفلح من زكاها} ومراد تزكيته حصول أنوار الإيمان فيه أعني إشراق نور المعرفة وهو المراد بقوله تعالى فمن يرد الله أن يهديه يشرح صدره للإسلام أفمن شرح الله صدره للإسلام فهو على نور من ربه نعم هذا التجلي وهذا الإيمان له ثلاث مراتب المرتبة الأولى إيمان العوام وهو إيمان التقليد المحض والثانية إيمان المتكلمين وهو ممزوج بنوع استدلال ودرجته قريبة من درجة إيمان العوام والثالثة إيمان العارفين وهو المشاهد بنور اليقين ونبين لك هذه المراتب بمثال وهو أن تصديقك بكون زيد مثلا", "english": "The Prophet, may God bless him and grant him peace, said: \"Were it not that the devils hover about the hearts of the children of Adam, they would look upon the kingdom of the heavens.\" (1) [Hadith of Ibn ʿUmar: \"Where is God?\" — \"In the hearts of His believing servants.\" I have not found it in this wording. Al-Ṭabarānī narrated from Abū ʿUtbah al-Khawlānī, raised to the Prophet, may God bless him and grant him peace: \"God has vessels from among the people of the earth, and the vessels of your Lord are the hearts of His righteous servants.\" In it is Baqiyyah ibn al-Walīd, who is a mudallis (one who conceals), but he explicitly stated hearing (al-taḥdīth) in it.] (2) [Hadith: God said: \"My earth and My heavens do not contain Me, but the heart of My believing servant, the soft and tender one, contains Me.\" I have found no basis for it. In the hadith of Abū ʿUtbah before it, according to al-Ṭabarānī, after his saying \"and the vessels of your Lord are the hearts of His righteous servants\": \"and the most beloved of them to Him are the softest and most tender of them.\"]", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 585", "section_title_en": "Section 585", "section_index": 585, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, transform from one state to another; the heart as that which is constantly turning and fluctuating between states\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation; the spiritual heart (qalb) is that subtle divine reality (laṭīfah rabbāniyyah) which is the locus of perception and knowledge\n  * Al-Zamakhshari (Asas): Literal: turning a thing over; Metaphorical: \"قلب المعلم الصبيان\" — the teacher turns the boys toward their homes; thus the heart is that which turns toward the spiritual world (malakūt) when purified\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Possession, dominion, sovereignty; the kingdom\n  * Al-Raghib (Mufradat): الملك: possession and dominion; الملكوت: the spiritual dominion — the unseen world of divine sovereignty\n  * Al-Zamakhshari (Asas): الملك: that which is under one's dominion; الملكوت: intensive form indicating the absolute and perfect dominion of God over all things\n- Root: ايم (a-y-m)\n  * Al-Raghib (Al-Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها\" — one without a spouse; extended metaphorically\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"الحرب مأيمة ميتمة\" — war makes women widows and children orphans\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise scope of statements about what the heart perceives and the degrees of faith\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "10": [{"arabic": "هو المراد بقوله تعالى قد أفلح من زكاها وإهمالها هو المراد بقوله وقد خاب من دساها ونحن نشير في هذا الكتاب إلى جمل من أمراض القلوب وكيفية القول في معالجتها على الجملة من غير تفصيل لعلاج خصوص الأمراض فإن ذلك يأتي في بقية الكتب من هذا الربع وغرضنا الآن النظر الكلي في تهذيب الأخلاق وتمهيد منهاجها ونحن نذكر ذلك ونجعل علاج البدن مثالا له ليقرب من الأفهام دركه ويتضح ذلك ببيان فضيلة حسن الخلق ثم بيان حقيقة حسن الخلق ثم بيان قبول الأخلاق للتغير بالرياضة ثم بيان السبب الذي به ينال حسن الخلق ثم بيان الطرق التي بها يعرف تفصيل الطرق إلى", "english": "To proceed: Good character (al-khuluq al-ḥasan) is the attribute of the Master of the Messengers and the most excellent of the works of the Truthful Ones (al-ṣiddīqīn). It is, in truth, half of religion and the fruit of the striving (mujāhadah) of the God-fearing and the discipline (riyāḍah) of the devout worshippers. Evil character traits are the deadly poisons, the destructive ruinous things, the disgraceful shames, the manifest vices, and the foul impurities that distance one from the proximity of the Lord of the Worlds and that string their possessor into the ranks of the devils. They are the open doors leading to the Fire of God Almighty, the kindled one {«الَّتِي تَطَّلِعُ عَلَى الْأَفْئِدَةِ»} — \"which rises over the hearts\" — just as beautiful character traits are the open doors from the heart to the bliss of the Gardens and the proximity of the Most Merciful.", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 612", "section_title_en": "The Book of Training the Soul, Refining Character, and Treating the Maladies of the Heart — Being the Second Book of the Quarter of the Destroyers", "section_index": 612, "anchors": "- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning of measuring, proportioning, and fashioning; also the innate disposition and character (khuluq) that is the form of the soul.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — the original sense is sound estimation/proportioning; used for bringing something into being from nothing (ibdāʿ) and for the inward character that is the soul's stable form.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"خلق الخراز الأديم\" — the leather-worker measures the hide before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God created creation upon a measure necessitated by wisdom. Thus \"khuluq\" (character) is the soul's measured, stable form.\n- Root: مرض (mariḍa)\n  * Lisan / Ayn: Sickness, departure from the body's balanced temperament.\n  * Al-Raghib (Mufradat): \"المرض: الخروج عن الاعتدال الخاص بالإنسان\" — sickness is departure from the equilibrium specific to the human. Two kinds: bodily sickness, and \"عبارة عن الرذائل كالجهل، والجبن، والبخل، والنفاق\" — an expression for vices such as ignorance, cowardice, miserliness, and hypocrisy.\n  * Al-Zamakhshari (Asas): Literal: bodily illness. Metaphorical: \"مرض في الأمر: ضجع فيه\" — to be weak/lax in a matter; and \"تمارض\" — to feign illness. Thus heart-sickness is the soul's departure from its proper spiritual equilibrium.\n- Root: قلب (qalaba)\n  * Lisan / Ayn: To turn, overturn, transform from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning a thing and diverting it from one face to another. The heart (qalb) is so named for its constant turning and fluctuation between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — turned it from its face. Metaphorical: \"قلب التاجر السلعة\" — the merchant examined the merchandise, scrutinizing its conditions. Thus the heart is the seat of moral scrutiny and transformation.\n- Root: حسن (ḥasuna)\n  * Lisan / Ayn: Beauty, goodness, excellence.\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — goodness is an expression for everything delightful and desirable. Three kinds: good by reason, good by desire (passion), good by sense.\n  * Al-Zamakhshari (Asas): Literal: \"أنظر إلى محاسن وجهه\" — behold the beauties of his face. Metaphorical: \"فلان لا يحسن شيئا\" — so-and-so does not do anything well; \"وقيمة المرء ما يحسن\" — a man's value is what he does well. Thus ḥusn al-khuluq (good character) is the soul's excellence in its measured form.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a governing word and its governed prepositional phrase, as in \"كقبح رب فيها رجل\" — demonstrating that what may be separated in eloquent speech follows the pattern of what is grammatically sound and rhetorically effective.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 250, 1410], [2, 1410, 2868]], "2": [[1, 350, 1485], [2, 1485, 2223], [3, 2223, 3528]], "3": [[1, 350, 2080], [2, 2080, 2851], [3, 2851, 4364]], "4": [[1, 350, 1491], [2, 1491, 2227], [3, 2227, 3868]], "5": [[1, 350, 2431], [2, 2431, 3229], [3, 3229, 4573]], "6": [[1, 250, 1442], [2, 1442, 2218], [3, 2218, 3600]], "7": [[1, 350, 1416], [2, 1416, 2366], [3, 2366, 4364]], "8": [[1, 350, 1880], [2, 1880, 3289], [3, 3289, 5383]], "9": [[1, 350, 1004], [2, 1004, 2152], [3, 2152, 2686], [4, 2686, 4730]], "10": [[1, 350, 1340], [2, 1340, 2267], [3, 2267, 2768], [4, 2768, 4730]], "11": [[1, 350, 1212], [2, 1212, 2017], [3, 2017, 4181]], "12": [[1, 350, 852], [2, 852, 1856], [3, 1856, 3711]], "13": [[1, 350, 1343], [2, 1343, 1943], [3, 1943, 2895], [4, 2895, 3712], [5, 3712, 4664], [6, 4664, 5481], [7, 5481, 7342]], "14": [[1, 400, 2228], [2, 2228, 4324], [3, 4324, 5572], [4, 5572, 6969], [5, 6969, 8129], [6, 8129, 9626], [7, 9626, 12027]], "15": [[1, 350, 1266], [2, 1266, 2427], [3, 2427, 3946]]}, "minshawi": {"1": [[1, 290, 1658], [2, 1658, 3930]], "2": [[1, 390, 1717], [2, 1717, 2672], [3, 2672, 4670]], "3": [[1, 250, 2324], [2, 2324, 3307], [3, 3307, 5510]], "4": [[1, 210, 1498], [2, 1498, 2405], [3, 2405, 4800]], "5": [[1, 180, 3040], [2, 3040, 4160], [3, 4160, 6080]], "6": [[1, 310, 1621], [2, 1621, 2732], [3, 2732, 4700]], "7": [[1, 200, 1269], [2, 1269, 2455], [3, 2455, 5130]], "8": [[1, 20, 1775], [2, 1775, 3590], [3, 3590, 6780]], "9": [[1, 340, 967], [2, 967, 2046], [3, 2046, 2548], [4, 2548, 5360]], "10": [[1, 160, 1240], [2, 1240, 2309], [3, 2309, 2750], [4, 2750, 5260]], "11": [[1, 10, 972], [2, 972, 2046], [3, 2046, 5500]], "12": [[1, 10, 606], [2, 606, 1824], [3, 1824, 4950]], "13": [[1, 200, 1574], [2, 1574, 2249], [3, 2249, 3530], [4, 3530, 4462], [5, 4462, 5790], [6, 5790, 6722], [7, 6722, 9870]], "14": [[1, 360, 2502], [2, 2502, 5223], [3, 5223, 6525], [4, 6525, 8022], [5, 8022, 9233], [6, 9233, 10796], [7, 10796, 14640]], "15": [[1, 10, 1334], [2, 1334, 2908], [3, 2908, 5120]]}, "mah": {"1": [[1, 3035, 4057], [2, 4157, 6060]], "91:1": [[1, 3035, 4057], [2, 4157, 6060]], "2": [[1, 6140, 7061], [2, 7402, 7843], [3, 7863, 8904]], "91:2": [[1, 6140, 7061], [2, 7402, 7843], [3, 7863, 8904]], "3": [[1, 9024, 10567], [2, 10587, 11348], [3, 11368, 12890]], "91:3": [[1, 9024, 10567], [2, 10587, 11348], [3, 11368, 12890]], "4": [[1, 12990, 14072], [2, 14152, 14893], [3, 14913, 17036]], "91:4": [[1, 12990, 14072], [2, 14152, 14893], [3, 14913, 17036]], "5": [[1, 17116, 19600], [2, 19720, 20481], [3, 20502, 21723]], "91:5": [[1, 17116, 19600], [2, 19720, 20481], [3, 20502, 21723]], "6": [[1, 21803, 22885], [2, 22985, 23626], [3, 23826, 25549]], "91:6": [[1, 21803, 22885], [2, 22985, 23626], [3, 23826, 25549]], "7": [[1, 25529, 27111], [2, 27191, 27932], [3, 27952, 29433]], "91:7": [[1, 25529, 27111], [2, 27191, 27932], [3, 27952, 29433]], "8": [[1, 29573, 31035], [2, 31175, 32417], [3, 32517, 34839]], "91:8": [[1, 29573, 31035], [2, 31175, 32417], [3, 32517, 34839]], "9": [[1, 34939, 35220], [2, 35340, 36141], [3, 36261, 36962], [4, 37102, 39404]], "91:9": [[1, 34939, 35220], [2, 35340, 36141], [3, 36261, 36962], [4, 37102, 39404]], "10": [[1, 39424, 39905], [2, 40105, 40826], [3, 40846, 41647], [4, 41787, 43669]], "91:10": [[1, 39424, 39905], [2, 40105, 40826], [3, 40846, 41647], [4, 41787, 43669]], "11": [[1, 43789, 44590], [2, 44810, 45691], [3, 45771, 48094]], "91:11": [[1, 43789, 44590], [2, 44810, 45691], [3, 45771, 48094]], "12": [[1, 48074, 4951