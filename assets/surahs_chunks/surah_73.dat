فَاقْرَءُواْ مَا تَيَسَّرَ مِنَ اَ۬لْقُرْءَانِۖ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْض۪يٰ وَءَاخَرُونَ يَضْرِبُونَ فِے اِ۬لَارْضِ يَبْتَغُونَ مِن فَضْلِ اِ۬للَّهِ وَءَاخَرُونَ يُقَٰتِلُونَ فِے سَبِيلِ اِ۬للَّهِۖ فَاقْرَءُواْ مَا تَيَسَّرَ مِنْهُۖ وَأَقِيمُواْ اُ۬لصَّلَوٰةَ وَءَاتُواْ اُ۬لزَّكَوٰةَۖ وَأَقْرِضُواْ اُ۬للَّهَ قَرْضاً حَسَناࣰۖ وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنْ خَيْرࣲ تَجِدُوهُ عِندَ اَ۬للَّهِ هُوَ خَيْراࣰ وَأَعْظَمَ أَجْراࣰۖ وَاسْتَغْفِرُواْ اُ۬للَّهَۖ إِنَّ اَ۬للَّهَ غَفُورࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "۞اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقُومُ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَدْن۪يٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "ثُلُثَيِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬ليْلِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَنِصْفِهِۦ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَثُلُثِهِۦ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَطَآئِفَةࣱ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 15, "arabic": "مَعَكَۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 17, "arabic": "يُقَدِّرُ", "translit": "", "root": ""}, {"id": 18, "arabic": "اُ۬ليْلَ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَالنَّهَارَۖ", "translit": "", "root": ""}, {"id": 20, "arabic": "عَلِمَ", "translit": "", "root": ""}, {"id": 21, "arabic": "أَن", "translit": "", "root": ""}, {"id": 22, "arabic": "لَّن", "translit": "", "root": ""}, {"id": 23, "arabic": "تُحْصُوهُ", "translit": "", "root": ""}, {"id": 24, "arabic": "فَتَابَ", "translit": "", "root": ""}, {"