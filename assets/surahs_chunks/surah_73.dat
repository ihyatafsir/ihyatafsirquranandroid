 "وَتَبَتَّلِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلَيْهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَبْتِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 9, "text": "رَّبُّ اُ۬لْمَشْرِقِ وَالْمَغْرِبِۖ لَآ إِلَٰهَ إِلَّا هُوَۖ فَاتَّخِذْهُ وَكِيلاࣰۖ", "words": [{"id": 1, "arabic": "رَّبُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْمَشْرِقِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالْمَغْرِبِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "هُوَۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَاتَّخِذْهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَكِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 10, "text": "وَاصْبِرْ عَلَيٰ مَا يَقُولُونَۖ وَاهْجُرْهُمْ هَجْراࣰ جَمِيلاࣰۖ", "words": [{"id": 1, "arabic": "وَاصْبِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَقُولُونَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاهْجُرْهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هَجْراࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "جَمِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 11, "text": "وَذَرْنِے وَالْمُكَذِّبِينَ أُوْلِے اِ۬لنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلاًۖ", "words": [{"id": 1, "arabic": "وَذَرْنِے", "translit": "", "root": ""}, {"id": 2, "arabic": "وَالْمُكَذِّبِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُوْلِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لنَّعْمَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَهِّلْهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَلِيلاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 12, "text": "اِنَّ لَدَيْنَآ أَنكَالاࣰ وَجَحِيماࣰ‏", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَدَيْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنكَالاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَجَحِيماࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 13, "text": "وَطَعَاماࣰ ذَا غُصَّةࣲ وَعَذَاباً اَلِيماࣰ‏", "words": [{"id": 1, "arabic": "وَطَعَاماࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "غُصَّةࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَذَاباً", "translit": "", "root": ""}, {"id": 5, "arabic": "اَلِيماࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 14, "text": "يَوْمَ تَرْجُفُ اُ۬لَارْضُ وَالْجِبَالُ وَكَانَتِ اِ۬لْجِبَالُ كَثِيباࣰ مَّهِيلاًۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرْجُفُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لَارْضُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالْجِبَالُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَكَانَتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْجِبَالُ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَثِيباࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّهِيلاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 15, "text": "اِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولاࣰ شَٰهِداً عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَيٰ فِرْعَوْنَ رَسُولاࣰ‏", "words": [{"id": 1, "arabic": "اِنَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيْكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَسُولاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "شَٰهِداً", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَمَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَرْسَلْنَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 11, "arabic": "رَسُولاࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 16, "text": "فَعَص۪يٰ فِرْعَوْنُ اُ۬لرَّسُولَ فَأَخَذْنَٰهُ أَخْذاࣰ وَبِيلاࣰۖ", "words": [{"id": 1, "arabic": "فَعَص۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لرَّسُولَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأَخَذْنَٰهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَخْذاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَبِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 17, "text": "فَكَيْفَ تَتَّقُونَ إِن كَفَرْتُمْ يَوْماࣰ يَجْعَلُ اُ۬لْوِلْدَٰنَ شِيباًۖ", "words": [{"id": 1, "arabic": "فَكَيْفَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَتَّقُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِن", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرْتُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْماࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَجْعَلُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْوِلْدَٰنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "شِيباًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 18, "text": "اِ۬لسَّمَآءُ مُنفَطِرُۢ بِهِۦۖ كَانَ وَعْدُهُۥ مَفْعُولاًۖ", "words": [{"id": 1, "arabic": "اِ۬لسَّمَآءُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مُنفَطِرُۢ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعْدُهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَفْعُولاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 19, "text": "اِنَّ هَٰذِهِۦ تَذْكِرَةࣱۖ فَمَن شَآءَ اَ۪تَّخَذَ إِلَيٰ رَبِّهِۦ سَبِيلاًۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَذْكِرَةࣱۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 5, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۪تَّخَذَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَبِّهِۦ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَبِيلاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 20, "text": "۞اِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْن۪يٰ مِن ثُلُثَيِ اِ۬ليْلِ وَنِصْفِهِۦ وَثُلُثِهِۦ وَطَآئِفَةࣱ مِّنَ اَ۬لذِينَ مَعَكَۖ وَاللَّهُ يُقَدِّرُ اُ۬ليْلَ وَالنَّهَارَۖ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْۖ فَاقْرَءُواْ مَا تَيَسَّرَ مِنَ اَ۬لْقُرْءَانِۖ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْض۪يٰ وَءَاخَرُونَ يَضْرِبُونَ فِے اِ۬لَارْضِ يَبْتَغُونَ مِن فَضْلِ اِ۬للَّهِ وَءَاخَرُونَ يُقَٰتِلُونَ فِے سَبِيلِ اِ۬للَّهِۖ فَاقْرَءُواْ مَا تَيَسَّرَ مِنْهُۖ وَأَقِيمُواْ اُ۬لصَّلَوٰةَ وَءَاتُواْ اُ۬لزَّكَوٰةَۖ وَأَقْرِضُواْ اُ۬للَّهَ قَرْضاً حَسَناࣰۖ وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنْ خَيْرࣲ تَجِدُوهُ عِندَ اَ۬للَّهِ هُوَ خَيْراࣰ وَأَعْظَمَ أَجْراࣰۖ وَاسْتَغْفِرُواْ اُ۬للَّهَۖ إِنَّ اَ۬للَّهَ غَفُورࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "۞اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقُومُ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَدْن۪يٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "ثُلُثَيِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬ليْلِ", "translit": "", "root": ""}, {"id": 10, "arabi