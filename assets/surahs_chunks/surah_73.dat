{"surah": 73, "verses": [{"ayah": 1, "text": "يَٰٓأَيُّهَا ٱلْمُزَّمِّلُ ", "translation": "O you who wraps himself [in clothing],[1]", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلْمُزَّمِّلُ", "translit": "ُlِّmَّzُmْlٱ", "root": "زمل"}], "hasIhya": false}, {"ayah": 2, "text": "قُمِ ٱلَّيْلَ إِلَّا قَلِيلًا ", "translation": "Arise [to pray] the night, except for a little -", "words": [{"id": 1, "arabic": "قُمِ", "translit": "ِmُq", "root": "قوم"}, {"id": 2, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}], "hasIhya": false}, {"ayah": 3, "text": "نِّصْفَهُۥٓ أَوِ ٱنقُصْ مِنْهُ قَلِيلًا ", "translation": "Half of it - or subtract from it a little", "words": [{"id": 1, "arabic": "نِّصْفَهُۥٓ", "translit": "ٓۥُhَfْṣِّn", "root": "نصف"}, {"id": 2, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 3, "arabic": "ٱنقُصْ", "translit": "ْṣُqnٱ", "root": "نقص"}, {"id": 4, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 5, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}], "hasIhya": false}, {"ayah": 4, "text": "أَوْ زِدْ عَلَيْهِ وَرَتِّلِ ٱلْقُرْءَانَ تَرْتِيلًا ", "translation": "Or add to it, and recite the Qur’ān with measured recitation.", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "زِدْ", "translit": "ْdِz", "root": "زيد"}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "وَرَتِّلِ", "translit": "ِlِّtَrَw", "root": "رتل"}, {"id": 5, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 6, "arabic": "تَرْتِيلًا", "translit": "āًlyِtْrَt", "root": "رتل"}], "hasIhya": false}, {"ayah": 5, "text": "إِنَّا سَنُلْقِى عَلَيْكَ قَوْلًا ثَقِيلًا ", "translation": "Indeed, We will cast upon you a heavy word.[1]", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "سَنُلْقِى", "translit": "àِqْlُnَs", "root": "لقي"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 5, "arabic": "ثَقِيلًا", "translit": "āًlyِqَht", "root": "ثقل"}], "hasIhya": false}, {"ayah": 6, "text": "إِنَّ نَاشِئَةَ ٱلَّيْلِ هِىَ أَشَدُّ وَطْـًٔا وَأَقْوَمُ قِيلًا ", "translation": "Indeed, the hours of the night are more effective for concurrence [of heart and tongue][1] and more suitable for words.[2]", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "نَاشِئَةَ", "translit": "َẗَyʾِhsāَn", "root": "نشا"}, {"id": 3, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 4, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 5, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 6, "arabic": "وَطْـًٔا", "translit": "āًٔـْṭَw", "root": "وطا"}, {"id": 7, "arabic": "وَأَقْوَمُ", "translit": "ُmَwْqَaʾَw", "root": "قوم"}, {"id": 8, "arabic": "قِيلًا", "translit": "āًlyِq", "root": "قول"}], "hasIhya": true}, {"ayah": 7, "text": "إِنَّ لَكَ فِى ٱلنَّهَارِ سَبْحًا طَوِيلًا ", "translation": "Indeed, for you by day is prolonged occupation.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلنَّهَارِ", "translit": "ِrāَhَّnlٱ", "root": "نهر"}, {"id": 5, "arabic": "سَبْحًا", "translit": "āًḥْbَs", "root": "سبح"}, {"id": 6, "arabic": "طَوِيلًا", "translit": "āًlyِwَṭ", "root": "طول"}], "hasIhya": true}, {"ayah": 8, "text": "وَٱذْكُرِ ٱسْمَ رَبِّكَ وَتَبَتَّلْ إِلَيْهِ تَبْتِيلًا ", "translation": "And remember the name of your Lord and devote yourself to Him with [complete] devotion.", "words": [{"id": 1, "arabic": "وَٱذْكُرِ", "translit": "ِrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "ٱسْمَ", "translit": "َmْsٱ", "root": "سمو"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "وَتَبَتَّلْ", "translit": "ْlَّtَbَtَw", "root": "بتل"}, {"id": 5, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "تَبْتِيلًا", "translit": "āًlyِtْbَt", "root": "بتل"}], "hasIhya": false}, {"ayah": 9, "text": "رَّبُّ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ لَآ إِلَٰهَ إِلَّا هُوَ فَٱتَّخِذْهُ وَكِيلًا ", "translation": "[He is] the Lord of the East and the West; there is no deity except Him, so take Him as Disposer of [your] affairs.[1]", "words": [{"id": 1, "arabic": "رَّبُّ", "translit": "ُّbَّr", "root": "ربب"}, {"id": 2, "arabic": "ٱلْمَشْرِقِ", "translit": "ِqِrْhsَmْlٱ", "root": "شرق"}, {"id": 3, "arabic": "وَٱلْمَغْرِبِ", "translit": "ِbِrْغَmْlٱَw", "root": "غرب"}, {"id": 4, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "فَٱتَّخِذْهُ", "translit": "ُhْhdِhkَّtٱَf", "root": "اخذ"}, {"id": 9, "arabic": "وَكِيلًا", "translit": "āًlyِkَw", "root": "وكل"}], "hasIhya": false}, {"ayah": 10, "text": "وَٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَٱهْجُرْهُمْ هَجْرًا جَمِيلًا ", "translation": "And be patient over what they say and avoid them with gracious avoidance.", "words": [{"id": 1, "arabic": "وَٱصْبِرْ", "translit": "ْrِbْṣٱَw", "root": "صبر"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 5, "arabic": "وَٱهْجُرْهُمْ", "translit": "ْmُhْrُjgْhٱَw", "root": "هجر"}, {"id": 6, "arabic": "هَجْرًا", "translit": "āًrْjgَh", "root": "هجر"}, {"id": 7, "arabic": "جَمِيلًا", "translit": "āًlyِmَjg", "root": "جمل"}], "hasIhya": true}, {"ayah": 11, "text": "وَذَرْنِى وَٱلْمُكَذِّبِينَ أُو۟لِى ٱلنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلًا ", "translation": "And leave Me with [the matter of] the deniers, those of ease [in life], and allow them respite a little.", "words": [{"id": 1, "arabic": "وَذَرْنِى", "translit": "àِnْrَhdَw", "root": "وذر"}, {"id": 2, "arabic": "وَٱلْمُكَذِّبِينَ", "translit": "َnyِbِّhdَkُmْlٱَw", "root": "كذب"}, {"id": 3, "arabic": "أُو۟لِى", "translit": "àِl۟wُaʾ", "root": ""}, {"id": 4, "arabic": "ٱلنَّعْمَةِ", "translit": "ِẗَmْʿعَّnlٱ", "root": "نعم"}, {"id": 5, "arabic": "وَمَهِّلْهُمْ", "translit": "ْmُhْlِّhَmَw", "root": "مهل"}, {"id": 6, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}], "hasIhya": false}, {"ayah": 12, "text": "إِنَّ لَدَيْنَآ أَنكَالًا وَجَحِيمًا ", "translation": "Indeed, with Us [for them] are shackles and burning fire", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَدَيْنَآ", "translit": "ٓāَnْyَdَl", "root": ""}, {"id": 3, "arabic": "أَنكَالًا", "translit": "āًlāَknَaʾ", "root": "نكل"}, {"id": 4, "arabic": "وَجَحِيمًا", "translit": "āًmyِḥَjgَw", "root": "جحم"}], "hasIhya": true}, {"ayah": 13, "text": "وَطَعَامًا ذَا غُصَّةٍ وَعَذَابًا أَلِيمًا ", "translation": "And food that chokes and a painful punishment -", "words": [{"id": 1, "arabic": "وَطَعَامًا", "translit": "āًmāَʿعَṭَw", "root": "طعم"}, {"id": 2, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 3, "arabic": "غُصَّةٍ", "translit": "ٍẗَّṣُغ", "root": "غصص"}, {"id": 4, "arabic": "وَعَذَابًا", "translit": "āًbāَhdَʿعَw", "root": "عذب"}, {"id": 5, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 14, "text": "يَوْمَ تَرْجُفُ ٱلْأَرْضُ وَٱلْجِبَالُ وَكَانَتِ ٱلْجِبَالُ كَثِيبًا مَّهِيلًا ", "translation": "On the Day the earth and the mountains will convulse and the mountains will become a heap of sand pouring down.", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تَرْجُفُ", "translit": "ُfُjgْrَt", "root": "رجف"}, {"id": 3, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "وَٱلْجِبَالُ", "translit": "ُlāَbِjgْlٱَw", "root": "جبل"}, {"id": 5, "arabic": "وَكَانَتِ", "translit": "ِtَnāَkَw", "root": "كون"}, {"id": 6, "arabic": "ٱلْجِبَالُ", "translit": "ُlāَbِjgْlٱ", "root": "جبل"}, {"id": 7, "arabic": "كَثِيبًا", "translit": "āًbyِhtَk", "root": "كثب"}, {"id": 8, "arabic": "مَّهِيلًا", "translit": "āًlyِhَّm", "root": "هيل"}], "hasIhya": false}, {"ayah": 15, "text": "إِنَّآ أَرْسَلْنَآ إِلَيْكُمْ رَسُولًا شَٰهِدًا عَلَيْكُمْ كَمَآ أَرْسَلْنَآ إِلَىٰ فِرْعَوْنَ رَسُولًا ", "translation": "Indeed, We have sent to you a Messenger as a witness upon you just as We sent to Pharaoh a messenger.", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَآ", "translit": "ٓāَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 5, "arabic": "شَٰهِدًا", "translit": "āًdِhَٰhs", "root": "شهد"}, {"id": 6, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 7, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 8, "arabic": "أَرْسَلْنَآ", "translit": "ٓāَnْlَsْrَaʾ", "root": "رسل"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 11, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}], "hasIhya": false}, {"ayah": 16, "text": "فَعَصَىٰ فِرْعَوْنُ ٱلرَّسُولَ فَأَخَذْنَٰهُ أَخْذًا وَبِيلًا ", "translation": "But Pharaoh disobeyed the messenger, so We seized him with a ruinous seizure.", "words": [{"id": 1, "arabic": "فَعَصَىٰ", "translit": "ٰàَṣَʿعَf", "root": "عصي"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 4, "arabic": "فَأَخَذْنَٰهُ", "translit": "ُhَٰnْhdَhkَaʾَf", "root": "اخذ"}, {"id": 5, "arabic": "أَخْذًا", "translit": "āًhdْhkَaʾ", "root": "اخذ"}, {"id": 6, "arabic": "وَبِيلًا", "translit": "āًlyِbَw", "root": "وبل"}], "hasIhya": false}, {"ayah": 17, "text": "فَكَيْفَ تَتَّقُونَ إِن كَفَرْتُمْ يَوْمًا يَجْعَلُ ٱلْوِلْدَٰنَ شِيبًا ", "translation": "Then how can you fear, if you disbelieve, a Day that will make the children white-haired?[1]", "words": [{"id": 1, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 2, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "كَفَرْتُمْ", "translit": "ْmُtْrَfَk", "root": "كفر"}, {"id": 5, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 6, "arabic": "يَجْعَلُ", "translit": "ُlَʿعْjgَy", "root": "جعل"}, {"id": 7, "arabic": "ٱلْوِلْدَٰنَ", "translit": "َnَٰdْlِwْlٱ", "root": "ولد"}, {"id": 8, "arabic": "شِيبًا", "translit": "āًbyِhs", "root": "شيب"}], "hasIhya": false}, {"ayah": 18, "text": "ٱلسَّمَآءُ مُنفَطِرٌۢ بِهِۦۚ كَانَ وَعْدُهُۥ مَفْعُولًا ", "translation": "The heaven will break apart therefrom;[1] ever is His promise fulfilled.", "words": [{"id": 1, "arabic": "ٱلسَّمَآءُ", "translit": "ُءٓāَmَّslٱ", "root": "سمو"}, {"id": 2, "arabic": "مُنفَطِرٌۢ", "translit": "ٌۢrِṭَfnُm", "root": "فطر"}, {"id": 3, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 5, "arabic": "وَعْدُهُۥ", "translit": "ۥُhُdْʿعَw", "root": "وعد"}, {"id": 6, "arabic": "مَفْعُولًا", "translit": "āًlwُʿعْfَm", "root": "فعل"}], "hasIhya": false}, {"ayah": 19, "text": "إِنَّ هَٰذِهِۦ تَذْكِرَةٌۖ فَمَن شَآءَ ٱتَّخَذَ إِلَىٰ رَبِّهِۦ سَبِيلًا ", "translation": "Indeed, this is a reminder, so whoever wills may take to his Lord a way.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 3, "arabic": "تَذْكِرَةٌ", "translit": "ٌẗَrِkْhdَt", "root": "ذكر"}, {"id": 4, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 5, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 6, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 9, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 20, "text": "إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِن ثُلُثَىِ ٱلَّيْلِ وَنِصْفَهُۥ وَثُلُثَهُۥ وَطَآئِفَةٌ مِّنَ ٱلَّذِينَ مَعَكَۚ وَٱللَّهُ يُقَدِّرُ ٱلَّيْلَ وَٱلنَّهَارَۚ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنَ ٱلْقُرْءَانِۚ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْضَىٰۙ وَءَاخَرُونَ يَضْرِبُونَ فِى ٱلْأَرْضِ يَبْتَغُونَ مِن فَضْلِ ٱللَّهِۙ وَءَاخَرُونَ يُقَٰتِلُونَ فِى سَبِيلِ ٱللَّهِۖ فَٱقْرَءُوا۟ مَا تَيَسَّرَ مِنْهُۚ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَقْرِضُوا۟ ٱللَّهَ قَرْضًا حَسَنًاۚ وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ خَيْرٍ تَجِدُوهُ عِندَ ٱللَّهِ هُوَ خَيْرًا وَأَعْظَمَ أَجْرًاۚ وَٱسْتَغْفِرُوا۟ ٱللَّهَۖ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌۢ ", "translation": "Indeed, your Lord knows, [O Muḥammad], that you stand [in prayer] almost two thirds of the night or half of it or a third of it, and [so do] a group of those with you. And Allāh determines [the extent of] the night and the day. He has known that you [Muslims] will not be able to do it[1] and has turned to you in forgiveness, so recite what is easy [for you] of the Qur’ān. He has known that there will be among you those who are ill and others traveling throughout the land seeking [something] of the bounty of Allāh and others fighting for the cause of Allāh. So recite what is easy from it and establish prayer and give zakāh and loan Allāh a goodly loan.[2] And whatever good you put forward for yourselves - you will find it with Allāh. It is better and greater in reward. And seek forgiveness of Allāh. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 4, "arabic": "أَنَّكَ", "translit": "َkَّnَaʾ", "root": ""}, {"id": 5, "arabic": "تَقُومُ", "translit": "ُmwُqَt", "root": "قوم"}, {"id": 6, "arabic": "أَدْنَىٰ", "translit": "ٰàَnْdَaʾ", "root": "دنو"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "ثُلُثَىِ", "translit": "ِàَhtُlُht", "root": "ثلث"}, {"id": 9, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 10, "arabic": "وَنِصْفَهُۥ", "translit": "ۥُhَfْṣِnَw", "root": "نصف"}, {"id": 11, "arabic": "وَثُلُثَهُۥ", "translit": "ۥُhَhtُlُhtَw", "root": "ثلث"}, {"id": 12, "arabic": "وَطَآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَṭَw", "root": "طوف"}, {"id": 13, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 14, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "مَعَكَ", "translit": "َkَʿعَm", "root": ""}, {"id": 16, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 17, "arabic": "يُقَدِّرُ", "translit": "ُrِّdَqُy", "root": "قدر"}, {"id": 18, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 19, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 20, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 21, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 22, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 23, "arabic": "تُحْصُوهُ", "translit": "ُhwُṣْḥُt", "root": "حصي"}, {"id": 24, "arabic": "فَتَابَ", "translit": "َbāَtَf", "root": "توب"}, {"id": 25, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 26, "arabic": "فَٱقْرَءُوا۟", "translit": "۟āwُءَrْqٱَf", "root": "قرا"}, {"id": 27, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 28, "arabic": "تَيَسَّرَ", "translit": "َrَّsَyَt", "root": "يسر"}, {"id": 29, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 30, "arabic": "ٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱ", "root": "قرا"}, {"id": 31, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 32, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 33, "arabic": "سَيَكُونُ", "translit": "ُnwُkَyَs", "root": "كون"}, {"id": 34, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 35, "arabic": "مَّرْضَىٰ", "translit": "ٰàَḍْrَّm", "root": "مرض"}, {"id": 36, "arabic": "وَءَاخَرُونَ", "translit": "َnwُrَhkāَءَw", "root": "اخر"}, {"id": 37, "arabic": "يَضْرِبُونَ", "translit": "َnwُbِrْḍَy", "root": "ضرب"}, {"id": 38, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 39, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 40, "arabic": "يَبْتَغُونَ", "translit": "َnwُغَtْbَy", "root": "بغي"}, {"id": 41, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 42, "arabic": "فَضْلِ", "translit": "ِlْḍَf", "root": "فضل"}, {"id": 43, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 44, "arabic": "وَءَاخَرُونَ", "translit": "َnwُrَhkāَءَw", "root": "اخر"}, {"id": 45, "arabic": "يُقَٰتِلُونَ", "translit": "َnwُlِtَٰqُy", "root": "قتل"}, {"id": 46, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 47, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 48, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 49, "arabic": "فَٱقْرَءُوا۟", "translit": "۟āwُءَrْqٱَf", "root": "قرا"}, {"id": 50, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 51, "arabic": "تَيَسَّرَ", "translit": "َrَّsَyَt", "root": "يسر"}, {"id": 52, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 53, "arabic": "وَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَw", "root": "قوم"}, {"id": 54, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 55, "arabic": "وَءَاتُوا۟", "translit": "۟āwُtāَءَw", "root": "اتي"}, {"id": 56, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 57, "arabic": "وَأَقْرِضُوا۟", "translit": "۟āwُḍِrْqَaʾَw", "root": "قرض"}, {"id": 58, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 59, "arabic": "قَرْضًا", "translit": "āًḍْrَq", "root": "قرض"}, {"id": 60, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 61, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 62, "arabic": "تُقَدِّمُوا۟", "translit": "۟āwُmِّdَqُt", "root": "قدم"}, {"id": 63, "arabic": "لِأَنفُسِكُم", "translit": "mُkِsُfnَaʾِl", "root": "نفس"}, {"id": 64, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 65, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 66, "arabic": "تَجِدُوهُ", "translit": "ُhwُdِjgَt", "root": "وجد"}, {"id": 67, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 68, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 69, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 70, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 71, "arabic": "وَأَعْظَمَ", "translit": "َmَẓْʿعَaʾَw", "root": "عظم"}, {"id": 72, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 73, "arabic": "وَٱسْتَغْفِرُوا۟", "translit": "۟āwُrِfْغَtْsٱَw", "root": "غفر"}, {"id": 74, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 75, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 76, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 77, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 78, "arabic": "رَّحِيمٌۢ", "translit": "ٌۢmyِḥَّr", "root": "رحم"}], "hasIhya": true}], "tafsir": {"6": [{"arabic": "{إن ناشئة الليل هي أشد وطأ وأقوم قيلا} وقال تعالى {ومن آناء الليل فسبح وأطراف النهار لعلك ترضى} وقال عز وجل {وأقم الصلاة طرفي النهار وزلفا من الليل أن الحسنات يذهبن السيئات} ثم انظر كيف وصف الفائزين من عباده وبماذا وصفهم فقال تعالى {أم من هو قانت}", "english": "This is what has been unveiled to those who gaze with the light of inner vision. But if you are not among its people, then look to the address of God Most High to His Messenger and derive it by the light of faith. For God Most High said to the nearest of His servants to Him and the highest of them in rank before Him: {«Indeed, for you in the day is prolonged occupation and [in the night] long travail. And remember the name of your Lord and devote yourself to Him with [complete] devotion»} (73:7-8). And He said Most High: {«And remember the name of your Lord [in prayer] morning and evening. And from [part of] the night, prostrate to Him and exalt Him a long [part of the] night»} (76:25-26). And He said Most High: {«And exalt [Allah] with praise of your Lord before the rising of the sun and before its setting, and during periods of the night [exalt Him] and after the [performance of] prostrations»} (50:39-40). And He said, Glorified be He: {«And exalt [Allah] with praise of your Lord when you arise. And during part of the night exalt Him and after the stars»} (52:48-49). And He said Most High: {«Indeed, the rising by night is more potent for directing the soul and more suitable for the recitation [of the Qur'an]»} (73:6). And He said Most High: {«And from [part of] the night, exalt Him and after the setting of the stars»} (52:49). And He said Most High: {«And during parts of the night, exalt Him and at the ends of the day, that you may be satisfied»} (20:130). And He said, Mighty and Majestic: {«And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds»} (11:114).", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 257", "section_title_en": "The Virtue of the Liturgies of Remembrance (Awrād) and the Elucidation That Perseverance Upon Them Is the Path to God Most High", "section_index": 257, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: The root denotes arriving at water, approaching a watering-place; the awrād (pl. of wird) are the appointed portions of devotional recitation assigned to fixed times, as one approaches the fountain of divine mercy.\n  * Al-Raghib (Mufradat): The wird is the allocated share of worship apportioned to a specific hour; its theological nuance is the systematic distribution of remembrance (dhikr) and reflection (fikr) across the昼夜 cycle to combat the soul's innate restlessness.\n  * Al-Zamakhshari (Asas): Literal: the portion of water one drinks. Metaphorical: the fixed liturgical portion one \"drinks\" from the fountain of gnosis—the shift from physical quenching to spiritual saturation.\n- Root: لطف (l-ṭ-f)\n  * Lisan / Ayn: Gentleness, subtlety, graciousness; to treat with kindness and refinement.\n  * Al-Raghib (Mufradat): The divine subtlety (al-luṭf) by which God gently draws His servant; here, the soul's need for gentle management (talṭīf) through variety in worship, lest it weary.\n  * Al-Zamakhshari (Asas): Literal: physical gentleness of touch. Metaphorical: the strategic, compassionate variation of devotional acts to sustain the soul's momentum—a haqīqah of spiritual governance.\n- Root: سأم (s-'-m)\n  * Lisan / Ayn: Weariness, boredom, satiety that breeds aversion; the soul's constitutional fatigue with a single monotonous mode.\n  * Al-Raghib (Mufradat): The psychological impediment to perseverance; overcome only by the divine mercy of variety, as the Prophet said: «إن الله لا يمل حتى تملوا» — God does not weary, but He has ordained that you may.\n  * Al-Zamakhshari (Asas): Literal: the nausea of over-satiation. Metaphorical: the spiritual listlessness that overtakes the heart when devotion becomes mechanical—requiring the \"turn\" (tanqul) between genres of worship.\n- Sibawayh Rule: باب التنويع والتقسيم (The Chapter of Division and Distribution) — The periodic structure here distributes predicates across multiple conditional clauses (fa-in... fa-in...), each governing a distinct outcome, requiring the translator to preserve the balanced, correlative syntax of proportional reward.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}], "7": [{"arabic": "النهار سبحا طويلا واذكر اسم ربك وتبتل إليه تبتيلا} وقال تعالى {واذكر اسم ربك بكرة وأصيلا ومن الليل فاسجد له وسبحه ليلا طويلا} وقال تعالى {وسبح بحمد ربك قبل طلوع الشمس وقبل الغروب ومن الليل فسبحه وأدبار السجود} وقال سبحانه {وسبح بحمد ربك حين تقوم ومن الليل فسبحه وإدبار النجوم} وقال تعالى {إن ناشئة الليل هي أشد وطأ وأقوم قيلا} وقال تعالى {ومن آناء الليل فسبح وأطراف النهار لعلك ترضى} وقال عز وجل {وأقم الصلاة طرفي النهار وزلفا من الليل أن الحسنات يذهبن السيئات} ثم انظر كيف وصف الفائزين من عباده وبماذا وصفهم ف", "english": "This is what has been unveiled to those who gaze with the light of inner vision. But if you are not among its people, then look to the address of God Most High to His Messenger and derive it by the light of faith. For God Most High said to the nearest of His servants to Him and the highest of them in rank before Him: {«Indeed, for you in the day is prolonged occupation and [in the night] long travail. And remember the name of your Lord and devote yourself to Him with [complete] devotion»} (73:7-8). And He said Most High: {«And remember the name of your Lord [in prayer] morning and evening. And from [part of] the night, prostrate to Him and exalt Him a long [part of the] night»} (76:25-26). And He said Most High: {«And exalt [Allah] with praise of your Lord before the rising of the sun and before its setting, and during periods of the night [exalt Him] and after the [performance of] prostrations»} (50:39-40). And He said, Glorified be He: {«And exalt [Allah] with praise of your Lord when you arise. And during part of the night exalt Him and after the stars»} (52:48-49). And He said Most High: {«Indeed, the rising by night is more potent for directing the soul and more suitable for the recitation [of the Qur'an]»} (73:6). And He said Most High: {«And from [part of] the night, exalt Him and after the setting of the stars»} (52:49). And He said Most High: {«And during parts of the night, exalt Him and at the ends of the day, that you may be satisfied»} (20:130). And He said, Mighty and Majestic: {«And establish prayer at the two ends of the day and at the approach of the night. Indeed, good deeds do away with misdeeds»} (11:114).", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 257", "section_title_en": "The Virtue of the Liturgies of Remembrance (Awrād) and the Elucidation That Perseverance Upon Them Is the Path to God Most High", "section_index": 257, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: The root denotes arriving at water, approaching a watering-place; the awrād (pl. of wird) are the appointed portions of devotional recitation assigned to fixed times, as one approaches the fountain of divine mercy.\n  * Al-Raghib (Mufradat): The wird is the allocated share of worship apportioned to a specific hour; its theological nuance is the systematic distribution of remembrance (dhikr) and reflection (fikr) across the昼夜 cycle to combat the soul's innate restlessness.\n  * Al-Zamakhshari (Asas): Literal: the portion of water one drinks. Metaphorical: the fixed liturgical portion one \"drinks\" from the fountain of gnosis—the shift from physical quenching to spiritual saturation.\n- Root: لطف (l-ṭ-f)\n  * Lisan / Ayn: Gentleness, subtlety, graciousness; to treat with kindness and refinement.\n  * Al-Raghib (Mufradat): The divine subtlety (al-luṭf) by which God gently draws His servant; here, the soul's need for gentle management (talṭīf) through variety in worship, lest it weary.\n  * Al-Zamakhshari (Asas): Literal: physical gentleness of touch. Metaphorical: the strategic, compassionate variation of devotional acts to sustain the soul's momentum—a haqīqah of spiritual governance.\n- Root: سأم (s-'-m)\n  * Lisan / Ayn: Weariness, boredom, satiety that breeds aversion; the soul's constitutional fatigue with a single monotonous mode.\n  * Al-Raghib (Mufradat): The psychological impediment to perseverance; overcome only by the divine mercy of variety, as the Prophet said: «إن الله لا يمل حتى تملوا» — God does not weary, but He has ordained that you may.\n  * Al-Zamakhshari (Asas): Literal: the nausea of over-satiation. Metaphorical: the spiritual listlessness that overtakes the heart when devotion becomes mechanical—requiring the \"turn\" (tanqul) between genres of worship.\n- Sibawayh Rule: باب التنويع والتقسيم (The Chapter of Division and Distribution) — The periodic structure here distributes predicates across multiple conditional clauses (fa-in... fa-in...), each governing a distinct outcome, requiring the translator to preserve the balanced, correlative syntax of proportional reward.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'", "badge": "Insight"}], "10": [{"arabic": "{واصبر على ما يقولون واهجرهم هجرا جميلا} وقال تعالى {ولقد نعلم أنك يضيق صدرك بما يقولون فسبح بحمد ربك} الآية وقال تعالى {ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور} أي تصبروا عن المكافأة ولذلك مدح الله تعالى العافين عن حقوقهم في القصاص وغيره فقال تعالى {وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو} خير الصابرين {وقال} صلى الله عليه وسلم صل من قطعك وأعط من حرمك واعف عمن ظلمك // ورأيت في الإنجيل قال عيسى بن مريم عليه السل", "english": "And acts of disobedience are the requisite of the impulse of caprice (bāʿith al-hawā). And the most severe kind of patience is patience in abstaining from those acts of disobedience that have become familiar through habit — for habit is a fifth nature. When habit is joined to lustful desire, two battalions from the battalions of Satan array themselves in concert against the battalion of God (jund Allāh) — may He be exalted — and the impulse of religion (bāʿith al-dīn) has no strength to suppress them. Then, if that act be one whose commission has been rendered easy (tayassara), patience in abstaining from it is heavier upon the soul — such as patience in abstaining from the sins of the tongue: backbiting (ghībah), falsehood, contentious disputation (mirāʾ), self-praise whether by insinuation (taʿrīḍ) or by explicit statement (taṣrīḥ), the varieties of jesting that wound hearts, the kinds of words by which one intends belittlement and contempt, and the mention of the dead with aspersion cast upon them, upon their sciences, their conduct, and their stations. For such mention is in its outward aspect (fī ẓāhirihi) backbiting, and in its inward aspect (fī bāṭinihi) self-praise. In it the soul has two lusts: one is the negation of the other [person], and the other is the affirmation of oneself. And by these two together there is completed for it that lordship (rubūbiyyah) which is innate in its disposition — and which is the very opposite of what it has been commanded regarding servanthood (ʿubūdiyyah). And because of the conjunction of the two lusts, and the ease of moving the tongue, and the fact that this becomes habitual in everyday converse, patience in abstaining from it becomes difficult. And it is among the greatest of the destructive enormities (al-mūbiqāt) — so much so that its disapproval and ugliness have been effaced from hearts by dint of its frequent repetition and the universality of familiarity with it. Thus you see a man who would, for example, wear silk and deem it utterly remote [of permissibility], yet he unleashes his tongue the whole day long against the reputations (aʿrāḍ) of people and does not deem that objectionable — notwithstanding what has come down in the report that backbiting is more severe than adultery (zinā). And God — may He be exalted — said: {«ودع أذاهم وتوكل على الله»} \"And leave aside their harm and put thy trust in God\" (Q. 33:48). And He said — may He be exalted: {«واصبر على ما يقولون واهجرهم هجرا جميلا»} \"And be patient over what they say, and depart from them with a gracious departure\" (Q. 73:10). And He said — may He be exalted: {«ولقد نعلم أنك يضيق صدرك بما يقولون فسبح بحمد ربك»} \"And indeed We know that thy breast is straitened by what they say; so glorify with the praise of thy Lord\" (Q. 15:97–98) — to the end of the verse. And He said — may He be exalted: {«ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور»} \"And you shall surely hear from those who were given the Scripture before you and from those who associate [others with God] much harm. And if you are patient and God-fearing, indeed that is of the resolute affairs\" (Q. 3:186) — that is, that you be patient in refraining from requital (mukāfaʾah). And for this reason God — may He be exalted — praised those who pardon others their due rights in retaliation (qiṣāṣ) and otherwise, saying — may He be exalted: {«وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو خير الصابرين»} \"And if you punish, then punish with the like of that wherewith you were afflicted. And if you are patient, it is surely better for the patient\" (Q. 16:126). And he — upon him be peace — said: \"Maintain the bond with him who cuts you off, and give to him who withholds from you, and pardon him who wrongs you.\" And I have seen in the Gospel that ʿĪsā ibn Maryam — upon him be peace — said: \"It was said to you of old: an eye for an eye and a nose for a nose. But I say to you: do not resist evil. Rather, whoever strikes your right cheek, turn to him PageV04P071 the left cheek; and whoever takes your cloak, give him your garment; and whoever compels you to walk with him one mile, walk with him two miles.\" And all of that is a command to be patient under harm. So patience under the harm of people is among the highest stations of patience, because in it the impulse of religion and the impulse of lustful desire and anger are all arrayed together [against the soul].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 965", "section_title_en": "The Most Severe Forms of Patience: Abstaining from Habitual Sins and Enduring Harm", "section_index": 965, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; \"ṣabara al-dābbah\" = to hold back an animal without fodder; \"ṣabartu nafsī\" = I restrained my soul.\n  * Al-Raghib (Mufradat): \"الصبر: حبس النفس على ما يقتضيه العقل والشرع، أو عما يقتضيان حبسها عنه\" — Patience is the withholding of the soul upon what reason and Law require, or from what they require it to be withheld. When exercised against calamity it is called ṣabr alone (opposed to jazaʿ); in warfare, courage (shajāʿah); in vexing misfortune, forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — I bore patiently what I dislike, and I restrained myself from what I love. Metaphorical (majāz): \"هو أصبر على الضرب من الأرض\" — he is more enduring of beating than the earth.\n- Root: عادة (ʿ-w-d)\n  * Lisan / Ayn: Recurrence and return; habitual practice that becomes second nature through repetition.\n  * Al-Raghib (Mufradat): Habit (ʿādah) as reiterated action that imprints upon the soul, rendering the act facile and its abandonment burdensome.\n  * Al-Zamakhshari (Asas): Literal: return to a state or place. Metaphorical: the ingrained disposition that governs conduct.\n- Root: غيب (gh-y-b)\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين\" — that which is concealed from the senses; applied to what is absent from human perception, though nothing is absent from God.\n  * Al-Zamakhshari (Asas): Literal: \"تكلم بذلك عن ظهر الغيب\" — he spoke of that behind the veil of the unseen. Metaphorical: \"أتونا في غابة\" — they came in a dense host (like tangled thickets).\n- Sibawayh Rule: Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the periodic construction \"فإن ذلك في ظاهره غيبة وفي باطنه ثناء على النفس\" where the circumstantial qualifiers (ẓāhir/bāṭin) are interposed to contrast outward form with inward reality.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "12": [{"arabic": "وفي رواية أنه صلى الله عليه وسلم قرأ هذا الآية أو قرئ عنده {إن لدينا أنكالا وجحيما وطعاما ذا غصة وعذابا أليما} فصعق (4) وفي رواية أنه صلى الله عليه وسلم قرأ {إن تعذبهم فإنهم عبادك} فبكى (5) وكان صلى الله عليه وسلم إذا مر بآية رحمة دعا واستبشر (6) والاستبشار وجد وقد أثنى الله تعالى على أهل الوجد بالقرآن فقال تعالى {وإذا سمعوا ما أنزل إلى الرسول ترى أعينهم تفيض من الدمع مما عرفوا من الحق} وروي أن رسول الله صلى الله عليه وسلم كان يصلي ولصدره أزيز كأزيز المرجل (7) وأما ما نقل من الوجد بالقرآن عن الصحابة رضي الله عنهم والتابعين فكثير فمنهم من صعق ومنهم من بكى ومنهم", "english": "**QUAD_ANCHORS:**\n- Root: وجد (Wajd)\n  * Lisan / Ayn: The root وجد encompasses multiple senses: finding/attaining (إدراك), intense love (الحب الشديد), grief (الحزن), and wealth/sufficiency (الغنى). Al-Khalil notes the range: \"الوجد: الحب. والوجد: الحزن. والوجد: الغنى. والوجد: إدراك الشيء\"\n  * Al-Raghib (Mufradat): \"الوجد: إدراك الشيء على خلاف ما يطلب\" — and in the technical terminology of the Sufis: \"ما يصادف القلب من واردات الأحوال\" (what the heart encounters of the influxes of spiritual states)\n  * Al-Zamakhshari (Asas): Literal sense is finding/attaining; metaphorical extension (majāz) in devotional context: \"وجد فلان في العبادة وجدا: إذا أتى بها على وجهها مع حضور القلب\"\n- Root: طبع (Tabʿ)\n  * Lisan / Ayn: \"الطبع: السجية التي جبل عليها الإنسان\" — the innate disposition upon which one is created; also \"الختم\" (sealing)\n  * Al-Raghib (Mufradat): \"الطبع: السجية التي جبل عليها الإنسان\" — the original constitution\n  * Al-Zamakhshari (Asas): Distinguishes \"مطبوع\" (innate/natural) from \"متكلف\" (deliberately acquired) — \"فلان مطبوع على الكرم، ومتكلف له\"\n- Root: كلف (Kulfah/Takalluf)\n  * Lisan / Ayn: \"التكلف: تجشم ما لا يلزمك\" — undertaking what is not incumbent upon you with effort and hardship\n  * Al-Raghib (Mufradat): \"التكلف: تجشم ما ليس من شأنه\" — burdening oneself with what is not one's natural concern\n  * Al-Zamakhshari (Asas): \"تكلفت الأمر: تجشمته على مشقة\" — deliberate self-imposition of effort\n- Root: سمع (Samāʿ)\n  * Lisan / Ayn: Auditory perception; also what is heard — recitation, song, remembrance\n  * Al-Raghib (Mufradat): \"السماع عند الصوفية: ما يهيج الوجد من الأصوات الموزونة\" — that which stirs ecstatic finding from measured sounds\n  * Al-Zamakhshari (Asas): \"السماع عند القوم: حضور مجلس يهيج الأحوال الشريفة\" — attending an assembly that stirs noble spiritual states\n- Root: عشق (ʿIshq)\n  * Lisan / Ayn: \"العشق: فرط الحب\" — excessive love; from \"العشقة\" — a plant that twines around another\n  * Al-Raghib (Mufradat): \"العشق: فرط الحب، وأصله من عشقة النبات وهي ما التف منه على غيره\"\n  * Al-Zamakhshari (Asas): \"العشق مجاز في حق الله تعالى\" — metaphorical when applied to God\n- Root: بكى (Bukāʾ)\n  * Lisan / Ayn: Weeping, shedding tears\n  * Al-Raghib (Mufradat): \"البكاء: إجراء الدمع من عين لحزن أو غيره\"\n  * Al-Zamakhshari (Asas): \"تباكى: تكلف البكاء\" — deliberate self-induced weeping\n- Root: صعق (Ṣaʿq)\n  * Lisan / Ayn: \"الصعق: الغشي. والصعق: الموت\" — swooning/loss of consciousness; death\n  * Al-Raghib (Mufradat): \"الصعق: غشية تعرض من صوت شديد أو هول\"\n  * Al-Zamakhshari (Asas): \"صعق من هول الأمر: إذا غشي عليه من شدة الخوف\"\n- Root: خشع (Khushūʿ)\n  * Lisan / Ayn: \"الخشوع: الخضوع والتذلل\" — humility and submissiveness\n  * Al-Raghib (Mufradat): \"الخشوع: التذلل والخضوع، وقيل: الخشوع في الصوت والبصر، والخضوع في البدن\"\n  * Al-Zamakhshari (Asas): \"خشعت الأصوات: سكنت. وخشع البصر: انكسر\"\n- Root: أنس (Uns)\n  * Lisan / Ayn: \"الأنس: نقيض الوحشة\" — the opposite of loneliness/estrangement\n  * Al-Raghib (Mufradat): \"الأنس: حضور القلب مع المحبوب\" — the heart's presence with the Beloved\n  * Al-Zamakhshari (Asas): \"الأنس بالله: سكون القلب إليه\"\n- Root: وجل (Wajal)\n  * Lisan / Ayn: \"الوجل: الخوف مع اضطراب القلب\" — fear accompanied by cardiac agitation\n  * Al-Raghib (Mufradat): \"الوجل: الخوف مع اضطراب القلب\"\n  * Al-Zamakhshari (Asas): \"الوجل: أشد من الخوف، فإنه مع اضطراب\"\n- Root: طمأن (Ṭumaʾnīnah)\n  * Lisan / Ayn: \"الطمأنينة: السكون\" — tranquility\n  * Al-Raghib (Mufradat): \"الطمأنينة: سكون القلب بعد اضطراب\"\n  * Al-Zamakhshari (Asas): \"اطمأن القلب: سكن بعد اضطراب\"\n- Root: قشعر (Iqshirʿār)\n  * Lisan / Ayn: \"القشعريرة: تقبض الجلد من الخوف\" — contraction of the skin from fear\n  * Al-Raghib (Mufradat): \"الاقشعرار: انقباض الجلد وتقبضه من الخوف\"\n  * Al-Zamakhshari (Asas): \"اقشعر الجلد من الخوف: إذا تقبض\"\n- Root: لين (Līn)\n  * Lisan / Ayn: \"اللين: ضد الخشونة\" — softness, opposite of hardness\n  * Al-Raghib (Mufradat): \"اللين: نقيض الخشونة\"\n  * Al-Zamakhshari (Asas): \"لان قلبه: إذا سكن وخشع\"\n- Root: غشي (Ghashy)\n  * Lisan / Ayn: \"الغشي: الإغماء\" — loss of consciousness\n  * Al-Raghib (Mufradat): \"الغشية: ما يغشى القلب من شدة الوجد\"\n  * Al-Zamakhshari (Asas): \"غشي عليه: إذا أغمي عليه من شدة وجد أو خوف\"\n- Root: زعق (Zaʿq)\n  * Lisan / Ayn: \"الزعق: الصياح الشديد\" — violent screaming\n  * Al-Raghib (Al-Mufradat): \"الزعق: الصياح الشديد\"\n  * Al-Zamakhshari (Asas): \"زعق: صاح بأعلى صوته\"\n- Root: أزيز (Azīz)\n  * Lisan / Ayn: \"الأزيز: صوت النار والمرجل\" — the sound of fire and boiling pot\n  * Al-Raghib (Al-Mufradat): \"الأزيز: صوت النار والمرجل ونحوهما\"\n  * Al-Zamakhshari (Asas): \"أزيز الصدر: صوت يسمع من شدة البكاء والوجد\"\n- Root: شهق (Shahīq)\n  * Lisan / Ayn: \"الشهيق: رد النفس إلى الداخل بصوت\" — drawing breath inward with sound\n  * Al-Raghib (Al-Mufradat): \"الشهيق: رد النفس إلى الداخل بصوت\"\n  * Al-Zamakhshari (Asas): \"شهق الرجل: إذا خرجت نفسه بصوت من شدة الوجد\"\n- Root: حزن (Ḥuzn)\n  * Lisan / Ayn: \"الحزن: ضد السرور\" — grief, opposite of joy\n  * Al-Raghib (Al-Mufradat): \"الحزن: ألم النفس\"\n  * Al-Zamakhshari (Asas): \"الحزن: ألم النفس، وهو مجاز من حزن الأرض\" (metaphorical extension from rough ground)\n- Root: شيب (Shayb)\n  * Lisan / Ayn: \"الشيب: بياض الشعر\" — whitening of hair\n  * Al-Raghib (Al-Mufradat): \"الشيب: بياض الشعر\"\n  * Al-Zamakhshari (Asas): \"شيبتني هود: أي: كبرتني وأحزنتني حتى شاب شعري\"\n- Root: ذرف (Dharf)\n  * Lisan / Ayn: \"الذرف: سيلان الدمع\" — flowing of tears\n  * Al-Raghib (Al-Mufradat): \"ذرفت العين: سال دمعها\"\n  * Al-Zamakhshari (Asas): \"ذرفت عينه: إذا سال دمعها من حزن\"\n- Root: فيض (Fayḍ)\n  * Lisan / Ayn: \"الفيض: سيلان الماء\" — overflowing of water\n  * Al-Raghib (Al-Mufradat): \"الفيض: جريان الماء بكثرة\"\n  * Al-Zamakhshari (Asas): \"فاضت العين بالدمع: سالت. وفاض القلب: امتلأ\"\n- Root: نقر (Naqr)\n  * Lisan / Ayn: \"النقر: الضرب على الشيء حتى يصوت\" — striking something until it sounds\n  * Al-Raghib (Al-Mufradat): \"الناقور: الصور\" — the Trumpet\n  * Al-Zamakhshari (Asas): \"الناقور: الصور الذي ينفخ فيه إسرافيل\"\n- Root: رعش (Riʿshah)\n  * Lisan / Ayn: \"الرعدة: الاضطراب\" — trembling\n  * Al-Raghib (Al-Mufradat): \"الارتعداد: الاضطراب\"\n  * Al-Zamakhshari (Asas): \"ارتعدت فرائصه: اضطربت من شدة الخوف\"\n- Root: فرص (Farīṣah)\n  * Lisan / Ayn: \"الفريصة: لحمة بين الجنب والكتف ترعد عند الفزع\" — the flesh between the side and shoulder blade that trembles at fright\n  * Al-Raghib (Al-Mufradat): \"الفريصة: لحمة بين الجنب والكتف ترعد عند الفزع\"\n  * Al-Zamakhshari (Asas): \"ارتعدت فرائصه: من شدة الخوف\"\n- Root: عما (ʿAmā)\n  * Lisan / Ayn: \"العمى: ذهاب البصر. والعمى: ذهاب البصيرة\" — blindness of sight; blindness of insight\n  * Al-Raghib (Al-Mufradat): \"العمى: آفة في البصر، وقد يستعار لآفة البصيرة\"\n  * Al-Zamakhshari (Asas): \"عمي القلب: ذهبت بصيرته\"\n- Root: أبصر (Abṣara)\n  * Lisan / Ayn: \"البصر: حاسة الرؤية. والبصيرة: العلم\" — sight; insight\n  *Al-Raghib (Al-Mufradat): \"الإبصار: إدراك البصر، وقد يستعار للبصيرة\"\n  * Al-Zamakhshari (Asas): \"أبصر الحق: علمه. ومنه: البصيرة\"\n- Root: كأس (Ka's)\n  * Lisan / Ayn: \"الكأس: القدح إذا كان فيه شراب\" — the cup when it contains drink\n  * Al-Raghib (Al-Mufradat): \"الكأس: الإناء المعروف، وقد يقال لما فيه\"\n  * Al-Zamakhshari (Asas): \"الكأس: القدح إذا كان فيه شراب\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 511", "section_title_en": "Section 511", "section_index": 511, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "13": [{"arabic": "أنكالا وجحيما وطعاما ذا غصة وعذابا أليما} فصعق (4) وفي رواية أنه صلى الله عليه وسلم قرأ {إن تعذبهم فإنهم عبادك} فبكى (5) وكان صلى الله عليه وسلم إذا مر بآية رحمة دعا واستبشر (6) والاستبشار وجد وقد أثنى الله تعالى على أهل الوجد بالقرآن فقال تعالى {وإذا سمعوا ما أنزل إلى الرسول ترى أعينهم تفيض من الدمع مما عرفوا من الحق} وروي أن رسول الله صلى الله عليه وسلم كان يصلي ولصدره أزيز كأزيز المرجل (7) وأما ما نقل من الوجد بالقرآن عن الصحابة رضي الله عنهم والتابعين فكثير فمنهم من صعق ومنهم من بكى ومنهم من غ", "english": "**QUAD_ANCHORS:**\n- Root: وجد (Wajd)\n  * Lisan / Ayn: The root وجد encompasses multiple senses: finding/attaining (إدراك), intense love (الحب الشديد), grief (الحزن), and wealth/sufficiency (الغنى). Al-Khalil notes the range: \"الوجد: الحب. والوجد: الحزن. والوجد: الغنى. والوجد: إدراك الشيء\"\n  * Al-Raghib (Mufradat): \"الوجد: إدراك الشيء على خلاف ما يطلب\" — and in the technical terminology of the Sufis: \"ما يصادف القلب من واردات الأحوال\" (what the heart encounters of the influxes of spiritual states)\n  * Al-Zamakhshari (Asas): Literal sense is finding/attaining; metaphorical extension (majāz) in devotional context: \"وجد فلان في العبادة وجدا: إذا أتى بها على وجهها مع حضور القلب\"\n- Root: طبع (Tabʿ)\n  * Lisan / Ayn: \"الطبع: السجية التي جبل عليها الإنسان\" — the innate disposition upon which one is created; also \"الختم\" (sealing)\n  * Al-Raghib (Mufradat): \"الطبع: السجية التي جبل عليها الإنسان\" — the original constitution\n  * Al-Zamakhshari (Asas): Distinguishes \"مطبوع\" (innate/natural) from \"متكلف\" (deliberately acquired) — \"فلان مطبوع على الكرم، ومتكلف له\"\n- Root: كلف (Kulfah/Takalluf)\n  * Lisan / Ayn: \"التكلف: تجشم ما لا يلزمك\" — undertaking what is not incumbent upon you with effort and hardship\n  * Al-Raghib (Mufradat): \"التكلف: تجشم ما ليس من شأنه\" — burdening oneself with what is not one's natural concern\n  * Al-Zamakhshari (Asas): \"تكلفت الأمر: تجشمته على مشقة\" — deliberate self-imposition of effort\n- Root: سمع (Samāʿ)\n  * Lisan / Ayn: Auditory perception; also what is heard — recitation, song, remembrance\n  * Al-Raghib (Mufradat): \"السماع عند الصوفية: ما يهيج الوجد من الأصوات الموزونة\" — that which stirs ecstatic finding from measured sounds\n  * Al-Zamakhshari (Asas): \"السماع عند القوم: حضور مجلس يهيج الأحوال الشريفة\" — attending an assembly that stirs noble spiritual states\n- Root: عشق (ʿIshq)\n  * Lisan / Ayn: \"العشق: فرط الحب\" — excessive love; from \"العشقة\" — a plant that twines around another\n  * Al-Raghib (Mufradat): \"العشق: فرط الحب، وأصله من عشقة النبات وهي ما التف منه على غيره\"\n  * Al-Zamakhshari (Asas): \"العشق مجاز في حق الله تعالى\" — metaphorical when applied to God\n- Root: بكى (Bukāʾ)\n  * Lisan / Ayn: Weeping, shedding tears\n  * Al-Raghib (Mufradat): \"البكاء: إجراء الدمع من عين لحزن أو غيره\"\n  * Al-Zamakhshari (Asas): \"تباكى: تكلف البكاء\" — deliberate self-induced weeping\n- Root: صعق (Ṣaʿq)\n  * Lisan / Ayn: \"الصعق: الغشي. والصعق: الموت\" — swooning/loss of consciousness; death\n  * Al-Raghib (Mufradat): \"الصعق: غشية تعرض من صوت شديد أو هول\"\n  * Al-Zamakhshari (Asas): \"صعق من هول الأمر: إذا غشي عليه من شدة الخوف\"\n- Root: خشع (Khushūʿ)\n  * Lisan / Ayn: \"الخشوع: الخضوع والتذلل\" — humility and submissiveness\n  * Al-Raghib (Mufradat): \"الخشوع: التذلل والخضوع، وقيل: الخشوع في الصوت والبصر، والخضوع في البدن\"\n  * Al-Zamakhshari (Asas): \"خشعت الأصوات: سكنت. وخشع البصر: انكسر\"\n- Root: أنس (Uns)\n  * Lisan / Ayn: \"الأنس: نقيض الوحشة\" — the opposite of loneliness/estrangement\n  * Al-Raghib (Mufradat): \"الأنس: حضور القلب مع المحبوب\" — the heart's presence with the Beloved\n  * Al-Zamakhshari (Asas): \"الأنس بالله: سكون القلب إليه\"\n- Root: وجل (Wajal)\n  * Lisan / Ayn: \"الوجل: الخوف مع اضطراب القلب\" — fear accompanied by cardiac agitation\n  * Al-Raghib (Mufradat): \"الوجل: الخوف مع اضطراب القلب\"\n  * Al-Zamakhshari (Asas): \"الوجل: أشد من الخوف، فإنه مع اضطراب\"\n- Root: طمأن (Ṭumaʾnīnah)\n  * Lisan / Ayn: \"الطمأنينة: السكون\" — tranquility\n  * Al-Raghib (Mufradat): \"الطمأنينة: سكون القلب بعد اضطراب\"\n  * Al-Zamakhshari (Asas): \"اطمأن القلب: سكن بعد اضطراب\"\n- Root: قشعر (Iqshirʿār)\n  * Lisan / Ayn: \"القشعريرة: تقبض الجلد من الخوف\" — contraction of the skin from fear\n  * Al-Raghib (Mufradat): \"الاقشعرار: انقباض الجلد وتقبضه من الخوف\"\n  * Al-Zamakhshari (Asas): \"اقشعر الجلد من الخوف: إذا تقبض\"\n- Root: لين (Līn)\n  * Lisan / Ayn: \"اللين: ضد الخشونة\" — softness, opposite of hardness\n  * Al-Raghib (Mufradat): \"اللين: نقيض الخشونة\"\n  * Al-Zamakhshari (Asas): \"لان قلبه: إذا سكن وخشع\"\n- Root: غشي (Ghashy)\n  * Lisan / Ayn: \"الغشي: الإغماء\" — loss of consciousness\n  * Al-Raghib (Mufradat): \"الغشية: ما يغشى القلب من شدة الوجد\"\n  * Al-Zamakhshari (Asas): \"غشي عليه: إذا أغمي عليه من شدة وجد أو خوف\"\n- Root: زعق (Zaʿq)\n  * Lisan / Ayn: \"الزعق: الصياح الشديد\" — violent screaming\n  * Al-Raghib (Al-Mufradat): \"الزعق: الصياح الشديد\"\n  * Al-Zamakhshari (Asas): \"زعق: صاح بأعلى صوته\"\n- Root: أزيز (Azīz)\n  * Lisan / Ayn: \"الأزيز: صوت النار والمرجل\" — the sound of fire and boiling pot\n  * Al-Raghib (Al-Mufradat): \"الأزيز: صوت النار والمرجل ونحوهما\"\n  * Al-Zamakhshari (Asas): \"أزيز الصدر: صوت يسمع من شدة البكاء والوجد\"\n- Root: شهق (Shahīq)\n  * Lisan / Ayn: \"الشهيق: رد النفس إلى الداخل بصوت\" — drawing breath inward with sound\n  * Al-Raghib (Al-Mufradat): \"الشهيق: رد النفس إلى الداخل بصوت\"\n  * Al-Zamakhshari (Asas): \"شهق الرجل: إذا خرجت نفسه بصوت من شدة الوجد\"\n- Root: حزن (Ḥuzn)\n  * Lisan / Ayn: \"الحزن: ضد السرور\" — grief, opposite of joy\n  * Al-Raghib (Al-Mufradat): \"الحزن: ألم النفس\"\n  * Al-Zamakhshari (Asas): \"الحزن: ألم النفس، وهو مجاز من حزن الأرض\" (metaphorical extension from rough ground)\n- Root: شيب (Shayb)\n  * Lisan / Ayn: \"الشيب: بياض الشعر\" — whitening of hair\n  * Al-Raghib (Al-Mufradat): \"الشيب: بياض الشعر\"\n  * Al-Zamakhshari (Asas): \"شيبتني هود: أي: كبرتني وأحزنتني حتى شاب شعري\"\n- Root: ذرف (Dharf)\n  * Lisan / Ayn: \"الذرف: سيلان الدمع\" — flowing of tears\n  * Al-Raghib (Al-Mufradat): \"ذرفت العين: سال دمعها\"\n  * Al-Zamakhshari (Asas): \"ذرفت عينه: إذا سال دمعها من حزن\"\n- Root: فيض (Fayḍ)\n  * Lisan / Ayn: \"الفيض: سيلان الماء\" — overflowing of water\n  * Al-Raghib (Al-Mufradat): \"الفيض: جريان الماء بكثرة\"\n  * Al-Zamakhshari (Asas): \"فاضت العين بالدمع: سالت. وفاض القلب: امتلأ\"\n- Root: نقر (Naqr)\n  * Lisan / Ayn: \"النقر: الضرب على الشيء حتى يصوت\" — striking something until it sounds\n  * Al-Raghib (Al-Mufradat): \"الناقور: الصور\" — the Trumpet\n  * Al-Zamakhshari (Asas): \"الناقور: الصور الذي ينفخ فيه إسرافيل\"\n- Root: رعش (Riʿshah)\n  * Lisan / Ayn: \"الرعدة: الاضطراب\" — trembling\n  * Al-Raghib (Al-Mufradat): \"الارتعداد: الاضطراب\"\n  * Al-Zamakhshari (Asas): \"ارتعدت فرائصه: اضطربت من شدة الخوف\"\n- Root: فرص (Farīṣah)\n  * Lisan / Ayn: \"الفريصة: لحمة بين الجنب والكتف ترعد عند الفزع\" — the flesh between the side and shoulder blade that trembles at fright\n  * Al-Raghib (Al-Mufradat): \"الفريصة: لحمة بين الجنب والكتف ترعد عند الفزع\"\n  * Al-Zamakhshari (Asas): \"ارتعدت فرائصه: من شدة الخوف\"\n- Root: عما (ʿAmā)\n  * Lisan / Ayn: \"العمى: ذهاب البصر. والعمى: ذهاب البصيرة\" — blindness of sight; blindness of insight\n  * Al-Raghib (Al-Mufradat): \"العمى: آفة في البصر، وقد يستعار لآفة البصيرة\"\n  * Al-Zamakhshari (Asas): \"عمي القلب: ذهبت بصيرته\"\n- Root: أبصر (Abṣara)\n  * Lisan / Ayn: \"البصر: حاسة الرؤية. والبصيرة: العلم\" — sight; insight\n  *Al-Raghib (Al-Mufradat): \"الإبصار: إدراك البصر، وقد يستعار للبصيرة\"\n  * Al-Zamakhshari (Asas): \"أبصر الحق: علمه. ومنه: البصيرة\"\n- Root: كأس (Ka's)\n  * Lisan / Ayn: \"الكأس: القدح إذا كان فيه شراب\" — the cup when it contains drink\n  * Al-Raghib (Al-Mufradat): \"الكأس: الإناء المعروف، وقد يقال لما فيه\"\n  * Al-Zamakhshari (Asas): \"الكأس: القدح إذا كان فيه شراب\"", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 511", "section_title_en": "Section 511", "section_index": 511, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Audition and Ecstasy'", "badge": "Afterlife"}], "20": [{"arabic": "سورة المزمل إن ربك يعلم أنك تقوم أدنى من ثلثي الليل ونصفه وثلثه فأدنى من ثلثي الليل كأنه بصفه ونصف سدسه فإن كسر قوله ونصفه وثلثه كان نصف الثلثين فيقرب من الثلث والربع وإن نصب كان نصف الليل وقالت عائشة رضي الله عنها كان صلى الله عليه وسلم يقوم إذا سمع الصارخ (3) يعني الديك وهذا يكون السدس فما دونه وروى غير واحد أنه قال راعيت صلاة رسول الله صلى الله عليه وسلم في السفر ليلا فنام بعد العشاء زمانا ثم استيقظ فنظر في الأفق فقال ربنا ما خلقت هذا باطلا حتى بلغ إنك لا تخلف الميعاد ثم استل من فراشه سواكا فاستاك به وتوضأ", "english": "The third rank is to stand for a third of the night. In this case, one should sleep the first half and the last sixth. In general, sleep at the end of the night is beloved, because it removes drowsiness in the morning. They (the Salaf) used to dislike [being overcome by] that [drowsiness], as it diminishes the pallor of the face and the fame [of devotion]. For if one stood for most of the night and slept in the pre-dawn hours (saḥar), the pallor of his face would diminish and his drowsiness would lessen. ʿĀʾishah, may God be pleased with her, said: \"The Messenger of God, peace be upon him, when he performed the Witr prayer at the end of the night, if he had a need of his family, he would draw near to them; otherwise, he would lie down in his place of prayer until Bilāl came to him and called him to prayer.\" She also said, may God be pleased with her: \"I never found him after the pre-dawn hours except sleeping.\" Some of the Salaf even said that this lying down before the dawn prayer is a Sunnah—among them Abū Hurayrah, may God be pleased with him. And sleep at this time was a cause for unveiling (mukāshafah) and direct witnessing (mushāhadah) from behind the veils of the unseen—and that is for the masters of hearts. In it there is also a rest that aids one in the first litany (wird) of the litanies of the day. And standing for a third of the night from the latter half, with sleep in the last sixth, is the standing of David, peace be upon him.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 279", "section_title_en": "The Revival of the Night: Its Seven Ranks According to Duration", "section_index": 279, "anchors": "- Root: ليل (layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layāl and layālī.\n  * Al-Raghib (Mufradat): Night is the time of stillness and worship; God says {«And the night when it covers»} (Al-Layl 92:1), and {«We sent it down on the Night of Decree»} (Al-Qadr 97:1). It is the appointed time for intimate communion (munājāh) with the Divine.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the actual dark period; metaphorically (majāz), \"reviving the night\" (iḥyāʾ al-layl) means filling it with worship, not literal resurrection.\n- Root: سدس (suds)\n  * Lisan / Ayn: One-sixth; a fractional part.\n  * Al-Raghib (Mufradat): The sixth part of a whole; used in Quranic inheritance verses {«And to his mother a sixth»} (Al-Nisāʾ 4:11). Here, it denotes a portion of the night's duration.\n  * Al-Zamakhshari (Asas): Literal—a measured sixth of the night; metaphorical—the rank of one who prays a sixth of the night, as in the practice of Prophet David (peace be upon him).\n- Root: رتب (rutab)\n  * Lisan / Ayn: To be firm, established, or fixed in place.\n  * Al-Raghib (Mufradat): Station or degree; a fixed position of honor.\n  * Al-Zamakhshari (Asas): Literal—something stable and enduring; metaphorical (majāz)—\"rank\" (martabah) in the sight of a sovereign, i.e., a graded station of spiritual attainment. Here, the seven \"ranks\" (marātib) are graded levels of nightly devotion.\n- Root: ربع (rubʿ)\n  * Lisan / Ayn: A fourth part; also to dwell or remain in a place.\n  * Al-Raghib (Mufradat): One-fourth; God says {«And for them a fourth of what you leave»} (Al-Nisāʾ 4:12). Used here for a quarter of the night.\n  * Al-Zamakhshari (Asas): Literal—a quarter portion; metaphorical—\"to revive\" (arbaʿa) as in raising up or sustaining, though here strictly fractional.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd)—When the author enumerates ranks (marātib) with ordinal markers (al-ūlā, al-thāniyah...), each predicate is restricted to its subject, establishing a graded taxonomy without overlap. The conditional clauses (idhā... fa-) govern the practical application, as in \"if he wakes, he prays; if sleep overcomes him, he returns to sleep.\"", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "الصلاة التي هي أعلى الأعلام فقال تعالى {وأقيموا الصلاة وآتوا الزكاة} وقال صلى الله عليه وسلم بني الإسلام على خمس شهادة أن لا إله إلا الله وأن محمدا عبده ورسوله وإقام الصلاة وإيتاء الزكاة (2) وشدد الوعيد على المقصرين فيها فقال {والذين يكنزون الذهب والفضة ولا ينفقونها في سبيل الله فبشرهم بعذاب أليم} ومعنى الإنفاق في سبيل الله إخراج حق الزكاة قال الأحنف بن قيس كنت في نفر من قريش فمر أبو ذر فقال بشر الكانزين بكي في ظهورهم يخرج من جنوبهم وبكي في أقفائهم يخرج من جباههم وفي رواية أنه يوضع على حلمة ثدي أحده", "english": "To proceed: God Most High made alms (al-zakāh) one of the pillars of Islam, and joined its mention with prayer (al-ṣalāh), which is the loftiest of symbols. He said Most High: {«وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ»} — \"And establish prayer and give alms.\" And he, peace and blessings be upon him, said: \"Islam is built upon five: the testimony that there is no god but God and that Muhammad is His servant and Messenger, the establishment of prayer, and the giving of alms.\" And He intensified the threat against those who fall short in it, saying: {«وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ»} — \"And those who hoard gold and silver and do not spend them in the way of God — give them tidings of a painful chastisement.\" And the meaning of \"spending in the way of God\" is the payment of the due right of alms (zakāh).", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 167", "section_title_en": "The Book of the Secrets of Alms (Zakat) — Section 167", "section_index": 167, "anchors": "- Root: زكا (Z-K-Y)\n  * Lisan / Ayn: \"Zakā al-zar'u yazkū zakā'an: it increased and grew.\" Core meaning: growth, increase, purification.\n  * Al-Raghib (Mufradat): \"The origin of zakāh is the growth that occurs through the blessing of God Most High... and from it is zakāh: what a person pays of God's right to the poor, so named for the hope of blessing in it, or for the purification (tazkiyah) of the soul, i.e., its growth.\"\n  * Al-Zamakhshari (Asas): Literal (haqīqah): growth and increase. Metaphorical (majāz): the purification of wealth through payment of the obligatory due.\n- Root: نعم (N-'-M)\n  * Lisan / Ayn: \"Na'ima 'ayshuhu: his life was pleasant.\" Core meaning: bounty, well-being, grace.\n  * Al-Raghib (Mufradat): \"Al-Ni'mah: the good state... and al-Ni'mah (with kasrah) is used for the genus, said of both little and much.\"\n  * Al-Zamakhshari (Asas): Literal: \"Jallat ni'mat Allāh wa na'mā'uh\" — God's grace and bounty are immense. Metaphorical: \"Khāfat na'āmatuhum\" — their ostriches departed (i.e., they fled), showing the root's extended usage.\n- Root: ظهر (Z-H-R)\n  * Lisan / Ayn: \"Zahara: to become apparent, to be victorious.\" Core meaning: back, outward appearance, manifestation.\n  * Al-Raghib (Mufradat): \"Al-Zahr: the back (body part)... and it is used metaphorically for the surface of the earth.\"\n  * Al-Zamakhshari (Asas): Literal: \"Rajul muzhir: a man strong of back.\" Metaphorical: \"Qalabtu al-amra zahrān li-baṭn\" — I turned the matter over back and belly (examined it thoroughly).\n- Root: سرر (S-R-R)\n  * Lisan / Ayn: \"Sarra: to conceal, to keep secret.\" Core meaning: secret, inner self, joy.\n  * Al-Raghib (Mufradat): \"Al-Isrār: the opposite of al-i'lān (declaring)... and al-sirr is the speech concealed in the soul.\"\n  * Al-Zamakhshari (Asas): Literal: \"Asarra al-ḥadīth: he concealed the speech.\" Metaphorical: \"Aṭaytuka sirrah: I gave you its choicest part (the secret/core of something).\"\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening clause is complete in itself, as in \"fa'āfa 'alayhim min ni'matihi mā...\" where the prepositional phrase is completed after an intervening relative clause.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Zakat'", "badge": "Du'a"}, {"arabic": "أما من الآيات فقوله تعالى {إن ربك يعلم أنك تقوم أدنى من ثلثي الليل} الآية وقوله تعالى {إن ناشئة الليل هي أشد وطأ وأقوم قيلا} وقوله سبحانه وتعالى {تتجافى جنوبهم عن المضاجع} وقوله تعالى أمن هو قانت آناء الليل الآية وقوله عز وجل {والذين يبيتون لربهم سجدا وقياما} وقوله تعالى {واستعينوا بالصبر والصلاة} قيل هي قيام الليل يستعان بالصبر عليه على مجاهدة النفس ومن الأخبار قوله صلى الله عليه وسلم يعقد الشيطان على قافية رأس أحدكم إذا هو نام ثلاث عقد يضرب مكان كل عقدة عليك ليل طويل فارقد فإن استيقظ وذكر ال", "english": "As for the Qur'anic verses, there is the saying of Allah Most High: {«إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِن ثُلُثَيِ اللَّيْلِ»} — the verse (Al-Muzzammil: 20) — and His saying: {«إِنَّ نَاشِئَةَ اللَّيْلِ هِيَ أَشَدُّ وَطْئًا وَأَقْوَمُ قِيلًا»} (Al-Muzzammil: 6), and His saying, Glorified and Exalted: {«تَتَجَافَىٰ جُنُوبُهُمْ عَنِ الْمَضَاجِعِ»} (Al-Sajdah: 16), and His saying: {«أَمَّنْ هُوَ قَانِتٌ آنَاءَ اللَّيْلِ»} — the verse (Al-Zumar: 9), and His saying, Mighty and Majestic: {«وَالَّذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّدًا وَقِيَامًا»} (Al-Furqan: 64), and His saying: {«وَاسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ»} (Al-Baqarah: 45). It is said that this refers to night prayer — one seeks aid through patience upon it in the struggle against the soul (*mujāhadat al-nafs*).", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 272", "section_title_en": "The Virtue of Reviving the Time Between the Two Evening Prayers (Maghrib and ʿIshāʾ) — The Virtue of Night Prayer (Qiyām al-Layl)", "section_index": 272, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: The root denotes the night, from sunset to dawn; its plural forms include *layāl* and *layālī*. Al-Farahidi notes its archaic derivation from *laylāh*.\n  * Al-Raghib (Mufradat): The night is a divinely ordained sign and period of worship; Allah says {«وَسَخَّرَ لَكُمُ اللَّيْلَ وَالنَّهَارَ»} (Ibrahim: 33) and swears by it in {«وَاللَّيْلِ إِذَا يَغْشَىٰ»} (Al-Layl: 1). It is the chosen time for the *nāshiʾah* — the prayer that rises by night.\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): the night as a temporal span. Metaphorical (*majāz*): \"a night of hardship\" or the soul's \"night\" of heedlessness. Here, the night is the literal arena for supererogatory worship.\n- Root: وفي (Wafā)\n  * Lisan / Ayn: Completeness, fulfillment, and reaching full measure. A thing that is *wāfin* is complete and whole.\n  * Al-Raghib (Mufradat): *Al-Wāfī* is that which has reached completion. Allah says {«وَأَوْفُوا بِعَهْدِي أُوفِ بِعَهْدِكُمْ»} (Al-Baqarah: 40). The night prayer is described as {«أَقْوَمُ قِيلًا»} — more upright in speech and more complete in its effect upon the heart.\n  * Al-Zamakhshari (Asas): Literal: a full measure or complete thing. Metaphorical: \"he reached the hundred\" (*awfā ʿalā al-miʾah*), i.e., surpassed it. The night prayer \"fulfills\" the soul's potential for nearness to Allah.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and has life. Al-Farahidi connects it to *nafas* (breath) and *nufūs* (precious things).\n  * Al-Raghib (Mufradat): The *nafs* is the rational soul and the seat of moral struggle (*mujāhadah*). Allah says {«إِنَّ النَّفْسَ لَأَمَّارَةٌ بِالسُّوءِ»} (Yusuf: 53). The ḥadīth describes the one who prays at night as becoming \"good of soul\" (*ṭayyib al-nafs*), while the sluggard becomes \"evil of soul\" (*khabīth al-nafs*).\n  * Al-Zamakhshari (Asas): Literal: the self or person. Metaphorical: \"he poured out his soul\" (i.e., his blood). Here, the *nafs* is the battlefield between the worshipper and the devil's whisperings.\n- Root: خبر (Khabar)\n  * Lisan / Ayn: News, report, or information; also experience and knowledge of a thing's inner state.\n  * Al-Raghib (Mufradat): *Al-Khabar* is knowledge of things through report. The *akhbār* (plural) are the prophetic traditions cited as evidence alongside the Qur'anic verses.\n  * Al-Zamakhshari (Asas): Literal: to test or try a thing to know its state. Metaphorical: \"his mirror reports of his unknown\" — i.e., reveals what is hidden. The *akhbār* here are the authoritative reports from the Prophet (ﷺ).\n- Sibawayh Rule: The rule of *al-ʿaṭf ʿalā al-sabab* (coordination on a cause) — when multiple conditions are linked by *fa* (then), each is a consequence of the preceding, as in the ḥadīth of the three knots: \"If he wakes and remembers Allah, a knot is untied; if he performs ablution, a knot is untied; if he prays, a knot is untied\" — each act builds upon the previous, and the *fa* indicates sequential causation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'", "badge": "Insight"}, {"arabic": "وقال تعالى ليس عليكم جناح أن تبتغوا فضلا من ربكم وقال تعالى وآخرون يضربون في الأرض يبتغون من فضل الله وقال تعالى فانتشروا في الأرض وابتغوا من فضل الله وأما الأخبار فقد قال صلى الله عليه وسلم من الذنوب ذنوب لا يكفرها إلا الهم في طلب المعيشة (1) وقال صلى الله عليه وسلم التاجر الصدوق يحشر يوم القيامة مع الصديقين والشهداء (2) وقال صلى الله عليه وسلم من طلب الدنيا حلالا وتعففا عن المسئلة وسعيا على عياله وتعطفا على جاره لقي الله ووجهه كالقمر ليلة البدر (3) وكان صلى الله عليه وسلم جالسا مع أصحابه ذات يوم فنظروا إلى شاب ذي جلد وقوة وقد بكر يسعى فقال", "english": "As for what is [cited] from the Book [i.e., the Qur'an], there is His saying, the Exalted: «{وَجَعَلْنَا النَّهَارَ مَعَاشًا}» (\"And We have made the day a means of livelihood\" [al-Naba' 78:11]) — and He mentioned it in the context of bestowing favor (imtinān).", "book_title": "Etiquette of Earning", "section_title_ar": "Section 312", "section_title_en": "Section 312", "section_index": 312, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Etiquette of Earning'", "badge": "Afterlife"}]}, "wordTiming": {"minshawi": {"1": [[1, 250, 3924], [2, 3924, 5580]], "73:1": [[1, 250, 3924], [2, 3924, 5580]], "2": [[1, 10, 391], [2, 391, 1204], [3, 1204, 2182], [4, 2182, 3960]], "73:2": [[1, 10, 391], [2, 391, 1204], [3, 1204, 2182], [4, 2182, 3960]], "3": [[1, 200, 2176], [2, 2176, 3013], [3, 3013, 3896], [4, 3896, 4570], [5, 4570, 6960]], "73:3": [[1, 200, 2176], [2, 2176, 3013], [3, 3013, 3896], [4, 3896, 4570], [5, 4570, 6960]], "4": [[1, 20, 581], [2, 581, 1042], [3, 1042, 1994], [4, 1994, 3226], [5, 3226, 4839], [6, 4839, 7060]], "73:4": [[1, 20, 581], [2, 581, 1042], [3, 1042, 1994], [4, 1994, 3226], [5, 3226, 4839], [6, 4839, 7060]], "5": [[1, 10, 1292], [2, 1292, 2532], [3, 2532, 3551], [4, 3551, 4917], [5, 4917, 7100]], "73:5": [[1, 10, 1292], [2, 1292, 2532], [3, 2532, 3551], [4, 3551, 4917], [5, 4917, 7100]], "6": [[1, 10, 690], [2, 690, 2090], [3, 2090, 3030], [4, 3030, 3530], [5, 3530, 4360], [6, 4360, 5745], [7, 5745, 7456], [8, 7456, 9310]], "73:6": [[1, 10, 690], [2, 690, 2090], [3, 2090, 3030], [4, 3030, 3530], [5, 3530, 4360], [6, 4360, 5745], [7, 5745, 7456], [8, 7456, 9310]], "7": [[1, 10, 677], [2, 677, 1070], [3, 1070, 1580], [4, 1580, 3180], [5, 3180, 4397], [6, 4397, 6700]], "73:7": [[1, 10, 677], [2, 677, 1070], [3, 1070, 1580], [4, 1580, 3180], [5, 3180, 4397], [6, 4397, 6700]], "8": [[1, 200, 1329], [2, 1329, 1802], [3, 1802, 2526], [4, 2526, 3906], [5, 3906, 4813], [6, 4813, 7010]], "73:8": [[1, 200, 1329], [2, 1329, 1802], [3, 1802, 2526], [4, 2526, 3906], [5, 3906, 4813], [6, 4813, 7010]], "9": [[1, 200, 827], [2, 827, 1857], [3, 1857, 3272], [4, 3272, 4902], [5, 4902, 5601], [6, 5601, 6613], [7, 6613, 7204], [8, 7204, 8324], [9, 8324, 10380]], "73:9": [[1, 200, 827], [2, 827, 1857], [3, 1857, 3272], [4, 3272, 4902], [5, 4902, 5601], [6, 5601, 6613], [7, 6613, 7204], [8, 7204, 8324], [9, 8324, 10380]], "10": [[1, 200, 1229], [2, 1229, 2109], [3, 2109, 2743], [4, 2743, 4526], [5, 4526, 5820], [6, 5820, 6832], [7, 6832, 8560]], "73:10": [[1, 200, 1229], [2, 1229, 2109], [3, 2109, 2743], [4, 2743, 4526], [5, 4526, 5820], [6, 5820, 6832], [7, 6832, 8560]], "11": [[1, 20, 1353], [2, 1353, 3620], [3, 3620, 4784], [4, 4784, 6023],