"ayah": 10, "text": "وَاصْبِرْ عَلَيٰ مَا يَقُولُونَۖ وَاهْجُرْهُمْ هَجْراࣰ جَمِيلاࣰۖ", "words": [{"id": 1, "arabic": "وَاصْبِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَقُولُونَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاهْجُرْهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هَجْراࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "جَمِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 11, "text": "وَذَرْنِے وَالْمُكَذِّبِينَ أُوْلِے اِ۬لنَّعْمَةِ وَمَهِّلْهُمْ قَلِيلاًۖ", "words": [{"id": 1, "arabic": "وَذَرْنِے", "translit": "", "root": ""}, {"id": 2, "arabic": "وَالْمُكَذِّبِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُوْلِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لنَّعْمَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَهِّلْهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَلِيلاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 12, "text": "اِنَّ لَدَيْنَآ أَنكَالاࣰ وَجَحِيماࣰ‏", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَدَيْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنكَالاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَجَحِيماࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 13, "text": "وَطَعَاماࣰ ذَا غُصَّةࣲ وَعَذَاباً اَلِيماࣰ‏", "words": [{"id": 1, "arabic": "وَطَعَاماࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "غُصَّةࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَذَاباً", "translit": "", "root": ""}, {"id": 5, "arabic": "اَلِيماࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 14, "text": "يَوْمَ تَرْجُفُ اُ۬لَارْضُ وَالْجِبَالُ وَكَانَتِ اِ۬لْجِبَالُ كَثِيباࣰ مَّهِيلاًۖ", "words": [{"id": 1