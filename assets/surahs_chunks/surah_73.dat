t": "", "root": ""}, {"id": 7, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَبِّهِۦ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَبِيلاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 73, "ayah": 20, "text": "۞اِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْن۪يٰ مِن ثُلُثَيِ اِ۬ليْلِ وَنِصْفِهِۦ وَثُلُثِهِۦ وَطَآئِفَةࣱ مِّنَ اَ۬لذِينَ مَعَكَۖ وَاللَّهُ يُقَدِّرُ اُ۬ليْلَ وَالنَّهَارَۖ عَلِمَ أَن لَّن تُحْصُوهُ فَتَابَ عَلَيْكُمْۖ فَاقْرَءُواْ مَا تَيَسَّرَ مِنَ اَ۬لْقُرْءَانِۖ عَلِمَ أَن سَيَكُونُ مِنكُم مَّرْض۪يٰ وَءَاخَرُونَ يَضْرِبُونَ فِے اِ۬لَارْضِ يَبْتَغُونَ مِن فَضْلِ اِ۬للَّهِ وَءَاخَرُونَ يُقَٰتِلُونَ فِے سَبِيلِ اِ۬للَّهِۖ فَاقْرَءُواْ مَا تَيَسَّرَ مِنْهُۖ وَأَقِيمُواْ اُ۬لصَّلَوٰةَ وَءَاتُواْ اُ۬لزَّكَوٰةَۖ وَأَقْرِضُواْ اُ۬للَّهَ قَرْضاً حَسَناࣰۖ وَمَا تُقَدِّمُواْ لِأَنفُسِكُم مِّنْ خَيْرࣲ تَجِدُوهُ عِندَ اَ۬للَّهِ هُوَ خَيْراࣰ وَأَعْظَمَ أَجْراࣰۖ وَاسْتَغْفِرُواْ اُ۬للَّهَۖ إِنَّ اَ۬للَّهَ غَفُورࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "۞اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقُومُ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَدْن۪يٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "ثُلُثَيِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬ليْلِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَنِصْفِهِۦ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَثُلُثِهِۦ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَطَآئِفَةࣱ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 15, "arabic": "مَعَكَۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id":