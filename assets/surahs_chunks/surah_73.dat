,26788],[21,26788,27371],[22,27371,28099],[23,28099,29635],[24,29635,30854],[25,30854,32364],[26,32364,34404],[27,34404,35093],[28,35093,36530],[29,36530,37060],[30,37060,38888],[31,38888,39736],[32,39736,40319],[33,40319,41935],[34,41935,42995],[35,42995,44889],[36,44889,47141],[37,47141,49075],[38,49075,49737],[39,49737,51008],[40,51008,52955],[41,52955,53485],[42,53485,54359],[43,54359,55405],[44,55405,57657],[45,57657,59755],[46,59755,60417],[47,60417,61636],[48,61636,62682],[49,62682,64722],[50,64722,65411],[51,65411,66848],[52,66848,67616],[53,67616,70132],[54,70132,72192],[55,72192,74311],[56,74311,76231],[57,76231,78774],[58,78774,79820],[59,79820,81171],[60,81171,82442],[61,82442,83528],[62,83528,85660],[63,85660,87594],[64,87594,88508],[65,88508,89462],[66,89462,90892],[67,90892,91740],[68,91740,92786],[69,92786,93422],[70,93422,94799],[71,94799,96441],[72,96441,97779],[73,97779,100454],[74,100454,101500],[75,101500,102467],[76,102467,103513],[77,103513,104732],[78,104732,106146]]},"minshawi":{"1":[[1,250,3924],[2,3924,5580]],"2":[[1,10,391],[2,391,1204],[3,1204,2182],[4,2182,3960]],"3":[[1,200,2176],[2,2176,3013],[3,3013,3896],[4,3896,4570],[5,4570,6960]],"4":[[1,20,581],[2,581,1042],[3,1042,1994],[4,1994,3226],[5,3226,4839],[6,4839,7060]],"5":[[1,10,1292],[2,1292,2532],[3,2532,3551],[4,3551,4917],[5,4917,7100]],"6":[[1,10,690],[2,690,2090],[3,2090,3030],[4,3030,3530],[5,3530,4360],[6,4360,5745],[7,5745,7456],[8,7456,9310]],"7":[[1,10,677],[2,677,1070],[3,1070,1580],[4,1580,3180],[5,3180,4397],[6,4397,6700]],"8":[[1,200,1329],[2,1329,1802],[3,1802,2526],[4,2526,3906],[5,3906,4813],[6,4813,7010]],"9":[[1,200,827],[2,827,1857],[3,1857,3272],[4,3272,4902],[5,4902,5601],[6,5601,6613],[7,6613,7204],[8,7204,8324],[9,8324,10380]],"10":[[1,200,1229],[2,1229,2109],[3,2109,2743],[4,2743,4526],[5,4526,5820],[6,5820,6832],[7,6832,8560]],"11":[[1,20,1353],[2,1353,3620],[3,3620,4784],[4,4784,6023],[5,6023,7501],[6,7501,9430]],"12":[[1,430,1133],[2,1133,3761],[3,3761,57