{"surah":72,"verses":[{"ayah":1,"text":"قُلْ أُوحِىَ إِلَىَّ أَنَّهُ ٱسْتَمَعَ نَفَرٌ مِّنَ ٱلْجِنِّ فَقَالُوٓا۟ إِنَّا سَمِعْنَا قُرْءَانًا عَجَبًا ","translation":"Say, [O Muḥammad], \"It has been revealed to me that a group of the jinn listened and said, 'Indeed, we have heard an amazing Qur’ān [i.e., recitation].","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أُوحِىَ","translit":"َàِḥwُaʾ","root":"وحي"},{"id":3,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":4,"arabic":"أَنَّهُ","translit":"ُhَّnَaʾ","root":""},{"id":5,"arabic":"ٱسْتَمَعَ","translit":"َʿعَmَtْsٱ","root":"سمع"},{"id":6,"arabic":"نَفَرٌ","translit":"ٌrَfَn","root":"نفر"},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":9,"arabic":"فَقَالُوٓا۟","translit":"۟āٓwُlāَqَf","root":"قول"},{"id":10,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":11,"arabic":"سَمِعْنَا","translit":"āَnْʿعِmَs","root":"سمع"},{"id":12,"arabic":"قُرْءَانًا","translit":"āًnāَءْrُq","root":"قرا"},{"id":13,"arabic":"عَجَبًا","translit":"āًbَjgَʿع","root":"عجب"}],"hasIhya":true},{"ayah":2,"text":"يَهْدِىٓ إِلَى ٱلرُّشْدِ فَـَٔامَنَّا بِهِۦۖ وَلَن نُّشْرِكَ بِرَبِّنَآ أَحَدًا ","translation":"It guides to the right course, and we have believed in it. And we will never associate with our Lord anyone.","words":[{"id":1,"arabic":"يَهْدِىٓ","translit":"ٓàِdْhَy","root":"هدي"},{"id":2,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":3,"arabic":"ٱلرُّشْدِ","translit":"ِdْhsُّrlٱ","root":"رشد"},{"id":4,"arabic":"فَـَٔامَنَّا","translit":"āَّnَmāَٔـَf","root":"امن"},{"id":5,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":6,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":7,"arabic":"نُّشْرِكَ","translit":"َkِrْhsُّn","root":"شرك"},{"id":8,"arabic":"بِرَبِّنَآ","translit":"ٓāَnِّbَrِb","root":"ربب"},{"id":9,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":false},{"ayah":3,"text":"وَأَنَّهُۥ تَعَٰلَىٰ جَدُّ رَبِّنَا مَا ٱتَّخَذَ صَٰحِبَةً وَلَا وَلَدًا ","translation":"And [it teaches] that exalted is the nobleness of our Lord; He has not taken a wife or a son","words":[{"id":1,"arabic":"وَأَنَّهُۥ","translit":"ۥُhَّnَaʾَw","root":""},{"id":2,"arabic":"تَعَٰلَىٰ","translit":"ٰàَlَٰʿعَt","root":"علو"},{"id":3,"arabic":"جَدُّ","translit":"ُّdَjg","root":"جدد"},{"id":4,"arabic":"رَبِّنَا","translit":"āَnِّbَr","root":"ربب"},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"ٱتَّخَذَ","translit":"َhdَhkَّtٱ","root":"اخذ"},{"id":7,"arabic":"صَٰحِبَةً","translit":"ًẗَbِḥَٰṣ","root":"صحب"},{"id":8,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":9,"arabic":"وَلَدًا","translit":"āًdَlَw","root":"ولد"}],"hasIhya":false},{"ayah":4,"text":"وَأَنَّهُۥ كَانَ يَقُولُ سَفِيهُنَا عَلَى ٱللَّهِ شَطَطًا ","translation":"And that our foolish one [i.e., Iblees][1] has been saying about Allāh an excessive transgression.","words":[{"id":1,"arabic":"وَأَنَّهُۥ","translit":"ۥُhَّnَaʾَw","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"يَقُولُ","translit":"ُlwُqَy","root":"قول"},{"id":4,"arabic":"سَفِيهُنَا","translit":"āَnُhyِfَs","root":"سفه"},{"id":5,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"شَطَطًا","translit":"āًṭَṭَhs","root":"شطط"}],"hasIhya":false},{"ayah":5,"text":"وَأَنَّا ظَنَنَّآ أَن لَّن تَقُولَ ٱلْإِنسُ وَٱلْجِنُّ عَلَى ٱللَّهِ كَذِبًا ","translation":"And we had thought that mankind and the jinn would never speak about Allāh a lie.","words":[{"id":1,"arabic":"وَأَنَّا","translit":"āَّnَaʾَw","root":""},{"id":2,"arabic":"ظَنَنَّآ","translit":"ٓāَّnَnَẓ","root":"ظنن"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"لَّن","translit":"nَّl","root":""},{"id":5,"arabic":"تَقُولَ","translit":"َlwُqَt","root":"قول"},{"id":6,"arabic":"ٱلْإِنسُ","translit":"ُsnِiʾْlٱ","root":"انس"},{"id":7,"arabic":"وَٱلْجِنُّ","translit":"ُّnِjgْlٱَw","root":"جنن"},{"id":8,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"كَذِبًا","translit":"āًbِhdَk","root":"كذب"}],"hasIhya":false},{"ayah":6,"text":"وَأَنَّهُۥ كَانَ رِجَالٌ مِّنَ ٱلْإِنسِ يَعُوذُونَ بِرِجَالٍ مِّنَ ٱلْجِنِّ فَزَادُوهُمْ رَهَقًا ","translation":"And there were men from mankind who sought refuge in men from the jinn, so they [only] increased them in burden [i.e., sin].","words":[{"id":1,"arabic":"وَأَنَّهُۥ","translit":"ۥُhَّnَaʾَw","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"رِجَالٌ","translit":"ٌlāَjgِr","root":"رجل"},{"id":4,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":5,"arabic":"ٱلْإِنسِ","translit":"ِsnِiʾْlٱ","root":"انس"},{"id":6,"arabic":"يَعُوذُونَ","translit":"َnwُhdwُʿعَy","root":"عوذ"},{"id":7,"arabic":"بِرِجَالٍ","translit":"ٍlāَjgِrِb","root":"رجل"},{"id":8,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":9,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":10,"arabic":"فَزَادُوهُمْ","translit":"ْmُhwُdāَzَf","root":"زيد"},{"id":11,"arabic":"رَهَقًا","translit":"āًqَhَr","root":"رهق"}],"hasIhya":false},{"ayah":7,"text":"وَأَنَّهُمْ ظَنُّوا۟ كَمَا ظَنَنتُمْ أَن لَّن يَبْعَثَ ٱللَّهُ أَحَدًا ","translation":"And they had thought, as you thought, that Allāh would never send anyone [as a messenger].","words":[{"id":1,"arabic":"وَأَنَّهُمْ","translit":"ْmُhَّnَaʾَw","root":""},{"id":2,"arabic":"ظَنُّوا۟","translit":"۟āwُّnَẓ","root":"ظنن"},{"id":3,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":4,"arabic":"ظَنَنتُمْ","translit":"ْmُtnَnَẓ","root":"ظنن"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"لَّن","translit":"nَّl","root":""},{"id":7,"arabic":"يَبْعَثَ","translit":"َhtَʿعْbَy","root":"بعث"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":false},{"ayah":8,"text":"وَأَنَّا لَمَسْنَا ٱلسَّمَآءَ فَوَجَدْنَٰهَا مُلِئَتْ حَرَسًا شَدِيدًا وَشُهُبًا ","translation":"And we have sought [to reach] the heaven but found it filled with powerful guards and burning flames.","words":[{"id":1,"arabic":"وَأَنَّا","translit":"āَّnَaʾَw","root":""},{"id":2,"arabic":"لَمَسْنَا","translit":"āَnْsَmَl","root":"لمس"},{"id":3,"arabic":"ٱلسَّمَآءَ","translit":"َءٓāَmَّslٱ","root":"سمو"},{"id":4,"arabic":"فَوَجَدْنَٰهَا","translit":"āَhَٰnْdَjgَwَf","root":"وجد"},{"id":5,"arabic":"مُلِئَتْ","translit":"ْtَyʾِlُm","root":"ملا"},{"id":6,"arabic":"حَرَسًا","translit":"āًsَrَḥ","root":"حرس"},{"id":7,"arabic":"شَدِيدًا","translit":"āًdyِdَhs","root":"شدد"},{"id":8,"arabic":"وَشُهُبًا","translit":"āًbُhُhsَw","root":"شهب"}],"hasIhya":false},{"ayah":9,"text":"وَأَنَّا كُنَّا نَقْعُدُ مِنْهَا مَقَٰعِدَ لِلسَّمْعِۖ فَمَن يَسْتَمِعِ ٱلْءَانَ يَجِدْ لَهُۥ شِهَابًا رَّصَدًا ","translation":"And we used to sit therein in positions for hearing,[1] but whoever listens now will find a burning flame lying in wait for him.","words":[{"id":1,"arabic":"وَأَنَّا","translit":"āَّnَaʾَw","root":""},{"id":2,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":3,"arabic":"نَقْعُدُ","translit":"ُdُʿعْqَn","root":"قعد"},{"id":4,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":5,"arabic":"مَقَٰعِدَ","translit":"َdِʿعَٰqَm","root":"قعد"},{"id":6,"arabic":"لِلسَّمْعِ","translit":"ِʿعْmَّslِl","root":"سمع"},{"id":7,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":8,"arabic":"يَسْتَمِعِ","translit":"ِʿعِmَtْsَy","root":"سمع"},{"id":9,"arabic":"ٱلْءَانَ","translit":"َnāَءْlٱ","root":"اون"},{"id":10,"arabic":"يَجِدْ","translit":"ْdِjgَy","root":"وجد"},{"id":11,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":12,"arabic":"شِهَابًا","translit":"āًbāَhِhs","root":"شهب"},{"id":13,"arabic":"رَّصَدًا","translit":"āًdَṣَّr","root":"رصد"}],"hasIhya":false},{"ayah":10,"text":"وَأَنَّا لَا نَدْرِىٓ أَشَرٌّ أُرِيدَ بِمَن فِى ٱلْأَرْضِ أَمْ أَرَادَ بِهِمْ رَبُّهُمْ رَشَدًا ","translation":"And we do not know [therefore] whether evil is intended for those on earth or whether their Lord intends for them a right course.","words":[{"id":1,"arabic":"وَأَنَّا","translit":"āَّnَaʾَw","root":""},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"نَدْرِىٓ","translit":"ٓàِrْdَn","root":"دري"},{"id":4,"arabic":"أَشَرٌّ","translit":"ٌّrَhsَaʾ","root":"شرر"},{"id":5,"arabic":"أُرِيدَ","translit":"َdyِrُaʾ","root":"رود"},{"id":6,"arabic":"بِمَن","translit":"nَmِb","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":10,"arabic":"أَرَادَ","translit":"َdāَrَaʾ","root":"رود"},{"id":11,"arabic":"بِهِمْ","translit":"ْmِhِb","root":""},{"id":12,"arabic":"رَبُّهُمْ","translit":"ْmُhُّbَr","root":"ربب"},{"id":13,"arabic":"رَشَدًا","translit":"āًdَhsَr","root":"رشد"}],"hasIhya":false},{"ayah":11,"text":"وَأَنَّا مِنَّا ٱلصَّٰلِحُونَ وَمِنَّا دُونَ ذَٰلِكَۖ كُنَّا طَرَآئِقَ قِدَدًا ","translation":"And among us are the righteous, and among us are [others] not so; we were [of] divided ways.[1]","words":[{"id":1,"arabic":"وَأَنَّا","translit":"āَّnَaʾَw","root":""},{"id":2,"arabic":"مِنَّا","translit":"āَّnِm","root":""},{"id":3,"arabic":"ٱلصَّٰلِحُونَ","translit":"َnwُḥِlَّٰṣlٱ","root":"صلح"},{"id":4,"arabic":"وَمِنَّا","translit":"āَّnِmَw","root":""},{"id":5,"arabic":"دُونَ","translit":"َnwُd","root":"دون"},{"id":6,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":7,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":8,"arabic":"طَرَآئِقَ","translit":"َqِyʾٓāَrَṭ","root":"طرق"},{"id":9,"arabic":"قِدَدًا","translit":"āًdَdِq","root":"قدد"}],"hasIhya":false},{"ayah":12,"text":"وَأَنَّا ظَنَنَّآ أَن لَّن نُّعْجِزَ ٱللَّهَ فِى ٱلْأَرْضِ وَلَن نُّعْجِزَهُۥ هَرَبًا ","translation":"And we have become certain that we will never cause failure to Allāh upon earth, nor can we escape Him by flight.","words":[{"id":1,"arabic":"وَأَنَّا","translit":"āَّnَaʾَw","root":""},{"id":2,"arabic":"ظَنَنَّآ","translit":"ٓāَّnَnَẓ","root":"ظنن"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"لَّن","translit":"nَّl","root":""},{"id":5,"arabic":"نُّعْجِزَ","translit":"َzِjgْʿعُّn","root":"عجز"},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":10,"arabic":"نُّعْجِزَهُۥ","translit":"ۥُhَzِjgْʿعُّn","root":"عجز"},{"id":11,"arabic":"هَرَبًا","translit":"āًbَrَh","root":"هرب"}],"hasIhya":false},{"ayah":13,"text":"وَأَنَّا لَمَّا سَمِعْنَا ٱلْهُدَىٰٓ ءَامَنَّا بِهِۦۖ فَمَن يُؤْمِنۢ بِرَبِّهِۦ فَلَا يَخَافُ بَخْسًا وَلَا رَهَقًا ","translation":"And when we heard the guidance [i.e., the Qur’ān], we believed in it. And whoever believes in his Lord will not fear deprivation or burden.[1]","words":[{"id":1,"arabic":"وَأَنَّا","translit":"āَّnَaʾَw","root":""},{"id":2,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":3,"arabic":"سَمِعْنَا","translit":"āَnْʿعِmَs","root":"سمع"},{"id":4,"arabic":"ٱلْهُدَىٰٓ","translit":"ٰٓàَdُhْlٱ","root":"هدي"},{"id":5,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":6,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":7,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":8,"arabic":"يُؤْمِنۢ","translit":"ۢnِmْwʾُy","root":"امن"},{"id":9,"arabic":"بِرَبِّهِۦ","translit":"ۦِhِّbَrِb","root":"ربب"},{"id":10,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":11,"arabic":"يَخَافُ","translit":"ُfāَhkَy","root":"خوف"},{"id":12,"arabic":"بَخْسًا","translit":"āًsْhkَb","root":"بخس"},{"id":13,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":14,"arabic":"رَهَقًا","translit":"āًqَhَr","root":"رهق"}],"hasIhya":true},{"ayah":14,"text":"وَأَنَّا مِنَّا ٱلْمُسْلِمُونَ وَمِنَّا ٱلْقَٰسِطُونَۖ فَمَنْ أَسْلَمَ فَأُو۟لَٰٓئِكَ تَحَرَّوْا۟ رَشَدًا ","translation":"And among us are Muslims [in submission to Allāh], and among us are the unjust.[1] And whoever has become Muslim - those have sought out the right course.","words":[{"id":1,"arabic":"وَأَنَّا","translit":"āَّnَaʾَw","root":""},{"id":2,"arabic":"مِنَّا","translit":"āَّnِm","root":""},{"id":3,"arabic":"ٱلْمُسْلِمُونَ","translit":"َnwُmِlْsُmْlٱ","root":"سلم"},{"id":4,"arabic":"وَمِنَّا","translit":"āَّnِmَw","root":""},{"id":5,"arabic":"ٱلْقَٰسِطُونَ","translit":"َnwُṭِsَٰqْlٱ","root":"قسط"},{"id":6,"arabic":"فَمَنْ","translit":"ْnَmَf","root":""},{"id":7,"arabic":"أَسْلَمَ","translit":"َmَlْsَaʾ","root":"سلم"},{"id":8,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":9,"arabic":"تَحَرَّوْا۟","translit":"۟āْwَّrَḥَt","root":"حري"},{"id":10,"arabic":"رَشَدًا","translit":"āًdَhsَr","root":"رشد"}],"hasIhya":false},{"ayah":15,"text":"وَأَمَّا ٱلْقَٰسِطُونَ فَكَانُوا۟ لِجَهَنَّمَ حَطَبًا ","translation":"But as for the unjust, they will be, for Hell, firewood.'","words":[{"id":1,"arabic":"وَأَمَّا","translit":"āَّmَaʾَw","root":""},{"id":2,"arabic":"ٱلْقَٰسِطُونَ","translit":"َnwُṭِsَٰqْlٱ","root":"قسط"},{"id":3,"arabic":"فَكَانُوا۟","translit":"۟āwُnāَkَf","root":"كون"},{"id":4,"arabic":"لِجَهَنَّمَ","translit":"َmَّnَhَjgِl","root":""},{"id":5,"arabic":"حَطَبًا","translit":"āًbَṭَḥ","root":"حطب"}],"hasIhya":false},{"ayah":16,"text":"وَأَلَّوِ ٱسْتَقَٰمُوا۟ عَلَى ٱلطَّرِيقَةِ لَأَسْقَيْنَٰهُم مَّآءً غَدَقًا ","translation":"And [Allāh revealed] that if they had remained straight on the way, We would have given them abundant rain [i.e., provision]","words":[{"id":1,"arabic":"وَأَلَّوِ","translit":"ِwَّlَaʾَw","root":""},{"id":2,"arabic":"ٱسْتَقَٰمُوا۟","translit":"۟āwُmَٰqَtْsٱ","root":"قوم"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلطَّرِيقَةِ","translit":"ِẗَqyِrَّṭlٱ","root":"طرق"},{"id":5,"arabic":"لَأَسْقَيْنَٰهُم","translit":"mُhَٰnْyَqْsَaʾَl","root":"سقي"},{"id":6,"arabic":"مَّآءً","translit":"ًءٓāَّm","root":"موه"},{"id":7,"arabic":"غَدَقًا","translit":"āًqَdَغ","root":"غدق"}],"hasIhya":false},{"ayah":17,"text":"لِّنَفْتِنَهُمْ فِيهِۚ وَمَن يُعْرِضْ عَن ذِكْرِ رَبِّهِۦ يَسْلُكْهُ عَذَابًا صَعَدًا ","translation":"So We might test them therein. And whoever turns away from the remembrance of his Lord[1] He will put into arduous punishment.","words":[{"id":1,"arabic":"لِّنَفْتِنَهُمْ","translit":"ْmُhَnِtْfَnِّl","root":"فتن"},{"id":2,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":3,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":4,"arabic":"يُعْرِضْ","translit":"ْḍِrْʿعُy","root":"عرض"},{"id":5,"arabic":"عَن","translit":"nَʿع","root":""},{"id":6,"arabic":"ذِكْرِ","translit":"ِrْkِhd","root":"ذكر"},{"id":7,"arabic":"رَبِّهِۦ","translit":"ۦِhِّbَr","root":"ربب"},{"id":8,"arabic":"يَسْلُكْهُ","translit":"ُhْkُlْsَy","root":"سلك"},{"id":9,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":10,"arabic":"صَعَدًا","translit":"āًdَʿعَṣ","root":"صعد"}],"hasIhya":false},{"ayah":18,"text":"وَأَنَّ ٱلْمَسَٰجِدَ لِلَّهِ فَلَا تَدْعُوا۟ مَعَ ٱللَّهِ أَحَدًا ","translation":"And [He revealed] that the masjids[1] are for Allāh, so do not invoke[2] with Allāh anyone.","words":[{"id":1,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":2,"arabic":"ٱلْمَسَٰجِدَ","translit":"َdِjgَٰsَmْlٱ","root":"سجد"},{"id":3,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":4,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":5,"arabic":"تَدْعُوا۟","translit":"۟āwُʿعْdَt","root":"دعو"},{"id":6,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":false},{"ayah":19,"text":"وَأَنَّهُۥ لَمَّا قَامَ عَبْدُ ٱللَّهِ يَدْعُوهُ كَادُوا۟ يَكُونُونَ عَلَيْهِ لِبَدًا ","translation":"And that when the Servant [i.e., Prophet] of Allāh stood up supplicating Him, they almost became about him a compacted mass.\"[1]","words":[{"id":1,"arabic":"وَأَنَّهُۥ","translit":"ۥُhَّnَaʾَw","root":""},{"id":2,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":3,"arabic":"قَامَ","translit":"َmāَq","root":"قوم"},{"id":4,"arabic":"عَبْدُ","translit":"ُdْbَʿع","root":"عبد"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"يَدْعُوهُ","translit":"ُhwُʿعْdَy","root":"دعو"},{"id":7,"arabic":"كَادُوا۟","translit":"۟āwُdāَk","root":"كود"},{"id":8,"arabic":"يَكُونُونَ","translit":"َnwُnwُkَy","root":"كون"},{"id":9,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":10,"arabic":"لِبَدًا","translit":"āًdَbِl","root":"لبد"}],"hasIhya":false},{"ayah":20,"text":"قُلْ إِنَّمَآ أَدْعُوا۟ رَبِّى وَلَآ أُشْرِكُ بِهِۦٓ أَحَدًا ","translation":"Say, [O Muḥammad], \"I only invoke my Lord and do not associate with Him anyone.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنَّمَآ","translit":"ٓāَmَّnِiʾ","root":""},{"id":3,"arabic":"أَدْعُوا۟","translit":"۟āwُʿعْdَaʾ","root":"دعو"},{"id":4,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":5,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":6,"arabic":"أُشْرِكُ","translit":"ُkِrْhsُaʾ","root":"شرك"},{"id":7,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":8,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":false},{"ayah":21,"text":"قُلْ إِنِّى لَآ أَمْلِكُ لَكُمْ ضَرًّا وَلَا رَشَدًا ","translation":"Say, \"Indeed, I do not possess for you [the power of] harm or right direction.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":3,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":4,"arabic":"أَمْلِكُ","translit":"ُkِlْmَaʾ","root":"ملك"},{"id":5,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":6,"arabic":"ضَرًّا","translit":"āًّrَḍ","root":"ضرر"},{"id":7,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":8,"arabic":"رَشَدًا","translit":"āًdَhsَr","root":"رشد"}],"hasIhya":false},{"ayah":22,"text":"قُلْ إِنِّى لَن يُجِيرَنِى مِنَ ٱللَّهِ أَحَدٌ وَلَنْ أَجِدَ مِن دُونِهِۦ مُلْتَحَدًا ","translation":"Say, \"Indeed, there will never protect me from Allāh anyone [if I should disobey], nor will I find in other than Him a refuge.","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":3,"arabic":"لَن","translit":"nَl","root":""},{"id":4,"arabic":"يُجِيرَنِى","translit":"àِnَryِjgُy","root":"جور"},{"id":5,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"أَحَدٌ","translit":"ٌdَḥَaʾ","root":"احد"},{"id":8,"arabic":"وَلَنْ","translit":"ْnَlَw","root":""},{"id":9,"arabic":"أَجِدَ","translit":"َdِjgَaʾ","root":"وجد"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"دُونِهِۦ","translit":"ۦِhِnwُd","root":"دون"},{"id":12,"arabic":"مُلْتَحَدًا","translit":"āًdَḥَtْlُm","root":"لحد"}],"hasIhya":false},{"ayah":23,"text":"إِلَّا بَلَٰغًا مِّنَ ٱللَّهِ وَرِسَٰلَٰتِهِۦۚ وَمَن يَعْصِ ٱللَّهَ وَرَسُولَهُۥ فَإِنَّ لَهُۥ نَارَ جَهَنَّمَ خَٰلِدِينَ فِيهَآ أَبَدًا ","translation":"But [I have for you] only notification from Allāh, and His messages.\" And whoever disobeys Allāh and His Messenger - then indeed, for him is the fire of Hell; they will abide therein forever.","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"بَلَٰغًا","translit":"āًغَٰlَb","root":"بلغ"},{"id":3,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"وَرِسَٰلَٰتِهِۦ","translit":"ۦِhِtَٰlَٰsِrَw","root":"رسل"},{"id":6,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":7,"arabic":"يَعْصِ","translit":"ِṣْʿعَy","root":"عصي"},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":10,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":11,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":12,"arabic":"نَارَ","translit":"َrāَn","root":"نور"},{"id":13,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":14,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":15,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":16,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"}],"hasIhya":true},{"ayah":24,"text":"حَتَّىٰٓ إِذَا رَأَوْا۟ مَا يُوعَدُونَ فَسَيَعْلَمُونَ مَنْ أَضْعَفُ نَاصِرًا وَأَقَلُّ عَدَدًا ","translation":"[The disbelievers continue] until, when they see that which they are promised, then they will know who is weaker in helpers and less in number.","words":[{"id":1,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":2,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":3,"arabic":"رَأَوْا۟","translit":"۟āْwَaʾَr","root":"راي"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"يُوعَدُونَ","translit":"َnwُdَʿعwُy","root":"وعد"},{"id":6,"arabic":"فَسَيَعْلَمُونَ","translit":"َnwُmَlْʿعَyَsَf","root":"علم"},{"id":7,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":8,"arabic":"أَضْعَفُ","translit":"ُfَʿعْḍَaʾ","root":"ضعف"},{"id":9,"arabic":"نَاصِرًا","translit":"āًrِṣāَn","root":"نصر"},{"id":10,"arabic":"وَأَقَلُّ","translit":"ُّlَqَaʾَw","root":"قلل"},{"id":11,"arabic":"عَدَدًا","translit":"āًdَdَʿع","root":"عدد"}],"hasIhya":false},{"ayah":25,"text":"قُلْ إِنْ أَدْرِىٓ أَقَرِيبٌ مَّا تُوعَدُونَ أَمْ يَجْعَلُ لَهُۥ رَبِّىٓ أَمَدًا ","translation":"Say, \"I do not know if what you are promised is near or if my Lord will grant for it a [long] period.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":3,"arabic":"أَدْرِىٓ","translit":"ٓàِrْdَaʾ","root":"دري"},{"id":4,"arabic":"أَقَرِيبٌ","translit":"ٌbyِrَqَaʾ","root":"قرب"},{"id":5,"arabic":"مَّا","translit":"āَّm","root":""},{"id":6,"arabic":"تُوعَدُونَ","translit":"َnwُdَʿعwُt","root":"وعد"},{"id":7,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":8,"arabic":"يَجْعَلُ","translit":"ُlَʿعْjgَy","root":"جعل"},{"id":9,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":10,"arabic":"رَبِّىٓ","translit":"ٓàِّbَr","root":"ربب"},{"id":11,"arabic":"أَمَدًا","translit":"āًdَmَaʾ","root":"امد"}],"hasIhya":false},{"ayah":26,"text":"عَٰلِمُ ٱلْغَيْبِ فَلَا يُظْهِرُ عَلَىٰ غَيْبِهِۦٓ أَحَدًا ","translation":"[He is] Knower of the unseen, and He does not disclose His [knowledge of the] unseen to anyone","words":[{"id":1,"arabic":"عَٰلِمُ","translit":"ُmِlَٰʿع","root":"علم"},{"id":2,"arabic":"ٱلْغَيْبِ","translit":"ِbْyَغْlٱ","root":"غيب"},{"id":3,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":4,"arabic":"يُظْهِرُ","translit":"ُrِhْẓُy","root":"ظهر"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"غَيْبِهِۦٓ","translit":"ٓۦِhِbْyَغ","root":"غيب"},{"id":7,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":true},{"ayah":27,"text":"إِلَّا مَنِ ٱرْتَضَىٰ مِن رَّسُولٍ فَإِنَّهُۥ يَسْلُكُ مِنۢ بَيْنِ يَدَيْهِ وَمِنْ خَلْفِهِۦ رَصَدًا ","translation":"Except whom He has approved of messengers, and indeed, He sends before him [i.e., each messenger] and behind him observers[1]","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"مَنِ","translit":"ِnَm","root":""},{"id":3,"arabic":"ٱرْتَضَىٰ","translit":"ٰàَḍَtْrٱ","root":"رضو"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"رَّسُولٍ","translit":"ٍlwُsَّr","root":"رسل"},{"id":6,"arabic":"فَإِنَّهُۥ","translit":"ۥُhَّnِiʾَf","root":""},{"id":7,"arabic":"يَسْلُكُ","translit":"ُkُlْsَy","root":"سلك"},{"id":8,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":9,"arabic":"بَيْنِ","translit":"ِnْyَb","root":"بين"},{"id":10,"arabic":"يَدَيْهِ","translit":"ِhْyَdَy","root":"يدي"},{"id":11,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":12,"arabic":"خَلْفِهِۦ","translit":"ۦِhِfْlَhk","root":"خلف"},{"id":13,"arabic":"رَصَدًا","translit":"āًdَṣَr","root":"رصد"}],"hasIhya":false},{"ayah":28,"text":"لِّيَعْلَمَ أَن قَدْ أَبْلَغُوا۟ رِسَٰلَٰتِ رَبِّهِمْ وَأَحَاطَ بِمَا لَدَيْهِمْ وَأَحْصَىٰ كُلَّ شَىْءٍ عَدَدًۢا ","translation":"That he [i.e., Muḥammad (ﷺ)] may know[1] that they have conveyed the messages of their Lord; and He has encompassed whatever is with them and has enumerated all things in number.","words":[{"id":1,"arabic":"لِّيَعْلَمَ","translit":"َmَlْʿعَyِّl","root":"علم"},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":4,"arabic":"أَبْلَغُوا۟","translit":"۟āwُغَlْbَaʾ","root":"بلغ"},{"id":5,"arabic":"رِسَٰلَٰتِ","translit":"ِtَٰlَٰsِr","root":"رسل"},{"id":6,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":7,"arabic":"وَأَحَاطَ","translit":"َṭāَḥَaʾَw","root":"حوط"},{"id":8,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":9,"arabic":"لَدَيْهِمْ","translit":"ْmِhْyَdَl","root":""},{"id":10,"arabic":"وَأَحْصَىٰ","translit":"ٰàَṣْḥَaʾَw","root":"حصي"},{"id":11,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":12,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":13,"arabic":"عَدَدًۢا","translit":"āًۢdَdَʿع","root":"عدد"}],"hasIhya":true}],"tafsir":{"1":[{"arabic":"إلى قومهم منذرين {فقالوا إنا سمعنا قرآنا عجبا يهدي إلى الرشد فآمنا به ولن نشرك بربنا أحدا} فكل من آمن به فقد وفق ومن قال به فقد صدق ومن تمسك به فقد هدي ومن عمل به فقد فاز وقال تعالى {إنا نحن نزلنا الذكر وإنا له لحافظون} ومن أسباب حفظه في القلوب والمصاحف استدامة تلاوته والمواظبة على دراسته مع القيام بآدابه وشروطه والمحافظة على ما فيه من الأعمال الباطنة والآداب الظاهرة وذلك لا بد من بيانه وتفصيله وتنكشف مقاصده في أربعة أبواب الباب الأول في فضل القرآن وأهله الباب الثاني في آداب التلاوة في الظاهر الباب الثالث في الأعمال الباطنة عند التلاوة الباب ا","english":"Praise be to God, who has bestowed His favor upon His servants through His sent Messenger (peace be upon him) and His revealed Book — falsehood cannot approach it from before it or from behind it; it is a revelation (tanzīl) from the Wise, the Praiseworthy {«تَنْزِيلٌ مِنْ حَكِيمٍ حَمِيدٍ»}. Through it, the path of reflection (iʿtibār) has been widened for the people of understanding, by virtue of what it contains of narratives and reports; and through it, the way of the upright course and the straight path (al-ṣirāṭ al-mustaqīm) has been made clear, by virtue of what it details of rulings and distinguishes between the lawful (ḥalāl) and the unlawful (ḥarām). It is the illumination and the light; through it is deliverance from delusion; in it is healing for what is in the breasts. Whoever opposes it among the tyrants, God crushes him; and whoever seeks knowledge in other than it, God leads him astray. It is the firm rope of God (ḥabl Allāh al-matīn), His manifest light, the trustworthy handhold (al-ʿurwah al-wuthqā), and the most faithful refuge. It encompasses the little and the much, the small and the great. Its wonders do not come to an end, nor do its marvels reach a limit. No delimitation (taḥdīd) encompasses its benefits according to the people of knowledge, nor does the frequency of repetition wear it out according to the people of recitation. It is that which guided the first and the last. When the jinn heard it, they did not delay in turning to their people as warners, saying: {«فَقَالُوا إِنَّا سَمِعْنَا قُرْآنًا عَجَبًا * يَهْدِي إِلَى الرُّشْدِ فَآمَنَّا بِهِ وَلَنْ نُشْرِكَ بِرَبِّنَا أَحَدًا»} (\"Indeed, we have heard a wondrous Quran; it guides to right conduct, so we have believed in it, and we will never associate anyone with our Lord.\") So whoever believes in it has been granted success (tawfīq); whoever speaks by it has spoken truthfully; whoever clings to it has been guided; and whoever acts by it has attained felicity (fawz). And God, the Exalted, says: {«إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ»} (\"Indeed, We — it is We who have sent down the Remembrance, and indeed, We are its Preservers.\") Among the means of its preservation (ḥifẓ) in hearts and in codices (maṣāḥif) is the constancy of its recitation (tilāwah) and perseverance in its study, along with the fulfillment of its etiquettes (ādāb) and conditions, and the safeguarding of what it contains of inward works (aʿmāl bāṭinah) and outward etiquettes (ādāb ẓāhirah). This cannot be done without its exposition and detailing; its aims unfold in four chapters (abwāb):","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 220","section_title_en":"The Book of the Etiquettes of Quran Recitation — Section 220: The Excellence of the Quran and Its People","section_index":220,"anchors":"- Root: نزل (n-z-l)\n  * Lisan / Ayn: \"نزل: انحطاط من علو إلى سفل\" — descent from a height to a lower place; the setting down of a thing in a place.\n  * Al-Raghib (Mufradat): \"النزول في الأصل هو انحطاط من علو... وإنزال الله تعالى نعمه ونقمه على الخلق، وإعطاؤهم إياها\" — the descent of the Quran is a divine act of sending down (tanzīl) from the highest station, carrying with it the very mercy and address of God.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"نزل من علو إلى سفل\" — physical descent. Majaz (metaphorical): \"وأنزل الله الغيث، وأنزل الكتاب\" — the \"sending down\" of revelation is a metaphorical extension denoting divine bestowal and elevation of the recipient, not spatial movement.\n- Root: حفظ (ḥ-f-ẓ)\n  * Lisan / Ayn: \"الحفظ: الحِراسة والاستظهار\" — guarding, preserving, and keeping watch over a thing.\n  * Al-Raghib (Mufradat): \"الحفظ: ضبط الشيء عن أن يذهب أو يضيع\" — the securing of a thing against loss or corruption; divine preservation (ḥifẓ) is an act of sovereign care.\n  * Al-Zamakhshari (Asas): Haqiqah: guarding a physical object. Majaz: \"حفظ الله فلانًا\" — divine protection from spiritual harm and error.\n- Root: تلو (t-l-w)\n  * Lisan / Ayn: \"التلاوة: الاتباع، ثم سميت القراءة تلاوة لأنها تتبع الآيات حرفًا حرفًا\" — following in sequence; recitation is so named because the reader follows the verses letter by letter.\n  * Al-Raghib (Mufradat): \"التلاوة: الإتيان بالشيء متتابعًا\" — the bringing of a thing in succession; recitation of the Quran is the sequential utterance of its verses in devotion.\n  * Al-Zamakhshari (Asas): Haqiqah: following behind. Majaz: \"تلا الكتاب\" — reciting, as the tongue follows the written text.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its object by an intervening clause, as in «لا يأتيه الباطل من بين يديه ولا من خلفه», where the prepositional phrases are distributed across the sentence for rhetorical emphasis and comprehensiveness.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"}],"13":[{"arabic":"المعاصي لقوله عز وجل {فمن يؤمن بربه فلا يخاف بخسا ولا رهقا} ولقوله سبحانه وتعالى {والذين آمنوا بالله ورسله أولئك هم الصديقون} الآية ولقوله تعالى كلما ألقى فيها فوج سألهم خزنتها إلى قوله فكذبنا وقلنا ما نزل الله من شيء فقوله {كلما ألقى فيها فوج} عام فينبغي أن يكون من ألقي في النار مكذبا ولقوله تعالى {لا يصلاها إلا الأشقى الذي كذب وتولى} وهذا حصر وإثبات ونفي ولقوله تعالى {من جاء بالحسنة فله خير منها وهم من فزع يومئذ آمنون} فالإيمان رأس الحسنات ولقوله تعالى {والله يحب المحسنين} وقال تعالى {إنا لا نضيع أجر من أحسن عملا}","english":"He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.","book_title":"Foundations of Belief","section_title_ar":"Section 99","section_title_en":"The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments","section_index":99,"anchors":"- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'","badge":"Hadith"}],"23":[{"arabic":"بالمشيئة يدل على الانقسام وقوله تعالى {ومن يعص الله ورسوله فإن له نار جهنم خالدين فيها} وتخصيصه بالكفر تحكم وقوله تعالى {ألا إن الظالمين في عذاب مقيم} وقال تعالى {ومن جاء بالسيئة فكبت وجوههم في النار} فهذه العمومات في معارضة عموماتهم ولا بد من تسليط التخصص والتأويل على الجانبين لأن الأخبار مصرحة بأن العصاة يعذبون (1) بل قوله تعالى وإن منكم إلا واردها كالصريح في أن ذلك لا بد منه للكل إذ لا يخلو مؤمن عن ذنب يرتكبه وقوله تعالى لا يصلاها إلا الأشقى الذي كذب وتولى أراد به من جماعة مخصوصين أو أراد بالأشقى شخصا معينا أيضا وقوله تعال","english":"He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.","book_title":"Foundations of Belief","section_title_ar":"Section 99","section_title_en":"The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments","section_index":99,"anchors":"- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"}],"26":[{"arabic":"إلا بما شاء وهو عالم الغيب فلا يظهر على غيبه أحدا إلا من ارتضى من رسول فأجل أيها العاقل فكر فى الملكوت فعسى يفتح لك ابواب السماء فتجول بقلبك فى أقطارها إلى أن يقوم قلبك بين يدي عرش الرحمن فعند ذلك ربما يرجى لك أن تبلغ رتبة عمر بن الخطاب رضي الله عنه حيث قال رأى قلبى ربى وهذا لأن بلوغ الأقصى لا يكون إلا بعد مجاوزة الأدنى وأدنى شىء إليك نفسك ثم الأرض التى هى مقرك ثم الهواء المكتنف لك ثم النبات والحيوان وما على وجه الأرض ثم عجائب الجو وهو ما بين السماء والأرض ثم السموات السبع بكواكبها ثم الكرسى ثم العرش ثم الملائكة","english":"I say — and of the heaven with its woven structure, and the heaven and what built it; and His saying, may He be exalted: {«And the sun and its morning brightness, and the moon when it follows it»} (Q 91:1-2); and His saying, may He be exalted: {«Nay, I swear by the slinking stars, the runners, the sinkers»} (Q 81:15-16); and His saying, may He be exalted: {«And the star when it falls — nay, I swear by the positions of the stars, and verily it is a mighty oath, if you but knew»} (Q 56:75-76). You have thus come to know that the wonders of the filthy drop of semen — the first and last generations have fallen short of comprehending them. So if God swore by such things, what is your assumption concerning that by which God, may He be exalted, swore, and upon which He made provisions dependent, and to which He annexed them, saying, may He be exalted: {«And in the heaven is your provision and that which you are promised»} (Q 51:22)? And He praised those who reflect upon it, saying: {«And they reflect upon the creation of the heavens and the earth»} (Q 3:191). And the Messenger of God, may God's peace and blessing be upon him, said: \"Woe to him who recites this verse and then wipes his moustache with it\" — that is, passes over it without reflection. And He censured those who turn away from it, saying: {«And We made the heaven a protected roof, yet from its signs they turn away»} (Q 21:32). So what comparison is there between all the seas and the earth, on the one hand, and the heaven, on the other — given that the former are subject to rapid changes, while the heavens are solid, mighty, and preserved from change until the Book reaches its appointed term? For this reason God, may He be exalted, called it \"protected,\" saying: {«And We made the heaven a protected roof»} (Q 21:32); and He said, glory be to Him: {«And We built above you seven mighty ones»} (Q 78:12); and He said: {«Are you stronger in creation or the heaven? He built it, He raised high its roof and fashioned it»} (Q 79:27-28).","book_title":"Contemplation","section_title_ar":"Section 1278","section_title_en":"On Contemplating the Kingdom of the Heavens (التفكر في ملكوت السموات)","section_index":1278,"anchors":"- Root: م ل ك (malaka)\n  * Lisan / Ayn: الملك: القوة على التصرف، والملكوت: زيادة الميم للمبالغة كالرهبوت والرحموت\n  * Al-Raghib (Mufradat): الملكوت: عالم الغيب الذي لا تدركه الحواس، والملك: عالم الشهادة المحسوس\n  * Al-Zamakhshari (Asas): الملكوت مجاز عن باطن الملك وسرّه، لا عن ظاهره المحسوس\n- Root: س م و (sama)\n  * Lisan / Ayn: السماء: كل ما علاك فأظلك، وأصلها السمو بمعنى الارتفاع\n  * Al-Raghib (Mufradat): السماء: الجرم المقابل للأرض، وتستعمل بمعنى العلو والملكوت الأعلى\n  * Al-Zamakhshari (Asas): \"سقفا محفوظا\" حقيقة في الحفظ عن التغير والاضمحلال\n- Root: غ ي ب (ghayb)\n  * Al-Raghib (Mufradat): الغيب: ما استتر عن الحواس، ويقال للشيء غيب باعتباره بالناس لا بالله تعالى، فإنه لا يغيب عنه شيء\n  * Al-Zamakhshari (Asas): الغيب والملكوت مترادفان في اصطلاح القرآن لما غاب عن الأبصار\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره لمراعاة البلاغة والمقام","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"}],"27":[{"arabic":"وإلى حالك ويغبطونك فى حسنك وجمالك والملائكة يمشون بين يديك ومن خلفك وينادون على رءوس الأشهاد هذا فلان بن فلان رضى الله عنه وأرضاه وقد سعد سعادة لا يشقى بعدها أبدا أفترى أن هذا المنصب ليس بأعظم من المكانة التى تنالها فى قلوب الخلق فى الدنيا بريائك ومداهنتك وتصنعك وتزينك فإن كنت تعلم أنه خير منه بل لانسبة له إليه فتوسل إلى إدراك هذه الرتبة بالإخلاص الصافى والنية الصادقة فى معاملتك مع الله فلن تدرك ذلك إلا به وإن تكن الأخرى والعياذ بالله بأن خرج من صحيفتك جريمة كنت تحسبها هينة وهى عند الله عظيمة فمقتك لأجلها فقا","english":"Know that none is saved from the peril of the Scale except him who, in this world, called his own soul to account, and weighed therein — by the scale of the Sacred Law — his deeds, his words, his passing thoughts, and his glances, just as ʿUmar — may God be well pleased with him — said: \"Call yourselves to account before you are called to account, and weigh yourselves before you are weighed.\" Indeed, his calling himself to account consists in his repenting, before death, from every act of disobedience with a sincere repentance (tawbah naṣūḥ), and in his making up for what was neglected of his shortcomings regarding the obligatory commands of God — may He be exalted — and in his restoring rights to those he wronged, grain by grain, and in his seeking absolution from everyone whom he harmed by his tongue, his hand, or his evil suspicion harbored in his heart — and this by winning their hearts' contentment — until he dies with no outstanding wrong against him, nor any neglected obligation.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1343","section_title_en":"The Perils of the Scale and the Reckoning of Wrongs Against Others","section_index":1343,"anchors":"- Root: وزن (w-z-n)\n  * Lisan / Ayn: Core meaning is weighing, measuring, and balancing; al-mīzān (the Scale) is the instrument of equitable judgment.\n  * Al-Raghib (Mufradat): In theological context, al-mīzān is the divine instrument of justice on the Day of Resurrection, weighing deeds to manifest equitable recompense, not a corporeal balance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes physical weighing; metaphorical (majāz) usage extends to moral and spiritual accounting, as in \"weighing one's deeds by the scale of the Sacred Law.\"\n- Sibawayh Rule: Conditional and Exceptive Constructions (الشّرط والاستثناء) — governing the protasis-apodosis structure in \"whoever's scales are heavy... whoever's scales are light,\" and the exceptive force in \"none is saved... except he who reckons.\"","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"},{"arabic":"الكعبة فقلت ومن هم قال الأكثرون أموالا إلا من قال هكذا وهكذا من بين يديه ومن خلفه وعن يمينه وعن شماله وقليل ما هم ما من صاحب إبل ولا بقر ولا غنم لا يؤدي زكاتها إلا جاءت يوم القيامة أعظم ما كانت وأسمنه تنطحه بقرونها وتطؤه بأظلافها كلما نفدت أخراها عادت عليه أولاها حتى يقضى بين الناس (1) وإذا كان هذا التشديد مخرجا في الصحيحين فقد صار من مهمات الدين الكشف عن أسرار الزكاة وشروطها الجلية والخفية ومعانيها الظاهرة والباطنة مع الاقتصار على ما لا يستغنى عن معرفته مؤدي الزكاة وقابضها وينكشف ذلك في أربعة فصول الفصل الأول في أنواع الزكاة وأسباب","english":"To proceed: God Most High made alms (al-zakāh) one of the pillars of Islam, and joined its mention with prayer (al-ṣalāh), which is the loftiest of symbols. He said Most High: {«وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ»} — \"And establish prayer and give alms.\" And he, peace and blessings be upon him, said: \"Islam is built upon five: the testimony that there is no god but God and that Muhammad is His servant and Messenger, the establishment of prayer, and the giving of alms.\" And He intensified the threat against those who fall short in it, saying: {«وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ»} — \"And those who hoard gold and silver and do not spend them in the way of God — give them tidings of a painful chastisement.\" And the meaning of \"spending in the way of God\" is the payment of the due right of alms (zakāh).","book_title":"Mysteries of Zakat","section_title_ar":"Section 167","section_title_en":"The Book of the Secrets of Alms (Zakat) — Section 167","section_index":167,"anchors":"- Root: زكا (Z-K-Y)\n  * Lisan / Ayn: \"Zakā al-zar'u yazkū zakā'an: it increased and grew.\" Core meaning: growth, increase, purification.\n  * Al-Raghib (Mufradat): \"The origin of zakāh is the growth that occurs through the blessing of God Most High... and from it is zakāh: what a person pays of God's right to the poor, so named for the hope of blessing in it, or for the purification (tazkiyah) of the soul, i.e., its growth.\"\n  * Al-Zamakhshari (Asas): Literal (haqīqah): growth and increase. Metaphorical (majāz): the purification of wealth through payment of the obligatory due.\n- Root: نعم (N-'-M)\n  * Lisan / Ayn: \"Na'ima 'ayshuhu: his life was pleasant.\" Core meaning: bounty, well-being, grace.\n  * Al-Raghib (Mufradat): \"Al-Ni'mah: the good state... and al-Ni'mah (with kasrah) is used for the genus, said of both little and much.\"\n  * Al-Zamakhshari (Asas): Literal: \"Jallat ni'mat Allāh wa na'mā'uh\" — God's grace and bounty are immense. Metaphorical: \"Khāfat na'āmatuhum\" — their ostriches departed (i.e., they fled), showing the root's extended usage.\n- Root: ظهر (Z-H-R)\n  * Lisan / Ayn: \"Zahara: to become apparent, to be victorious.\" Core meaning: back, outward appearance, manifestation.\n  * Al-Raghib (Mufradat): \"Al-Zahr: the back (body part)... and it is used metaphorically for the surface of the earth.\"\n  * Al-Zamakhshari (Asas): Literal: \"Rajul muzhir: a man strong of back.\" Metaphorical: \"Qalabtu al-amra zahrān li-baṭn\" — I turned the matter over back and belly (examined it thoroughly).\n- Root: سرر (S-R-R)\n  * Lisan / Ayn: \"Sarra: to conceal, to keep secret.\" Core meaning: secret, inner self, joy.\n  * Al-Raghib (Mufradat): \"Al-Isrār: the opposite of al-i'lān (declaring)... and al-sirr is the speech concealed in the soul.\"\n  * Al-Zamakhshari (Asas): Literal: \"Asarra al-ḥadīth: he concealed the speech.\" Metaphorical: \"Aṭaytuka sirrah: I gave you its choicest part (the secret/core of something).\"\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening clause is complete in itself, as in \"fa'āfa 'alayhim min ni'matihi mā...\" where the prepositional phrase is completed after an intervening relative clause.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Zakat'","badge":"Du'a"},{"arabic":"عثراتي واحفظني من بين يدي ومن خلفي وعن يميني وعن شمالي ومن فوقي وأعوذ بك أن أغتال من تحتي (1) اللهم لا تؤمني مكرك ولا تولني غيرك ولا تنزع عني سترك ولا تنسني ذكرك ولا تجعلني من الغافلين (2) وقل اللهم أنت ربي لا إله إلا أنت خلقتني وأنا عبدك وأنا على عهدك ووعدك ما استطعت أعوذ بك من شر ما صنعت أبوء لك بنعمتك علي وأبوء بذنبي فاغفر لي فإنه لا يغفر الذنوب إلا أنت (3) ثلاث مرات وقل اللهم عافني في بدني وعافني في سمعي وعافني في بصري لا إله إلا أنت (4) ثلاث مرات وقل اللهم إني أسألك ال","english":"\"Glory be to my Lord, the Most High, the Most Exalted, the Bestower (al-Wahhāb). There is no god but God alone, with no partner. His is the sovereignty and His is the praise, and He is over all things powerful.\"","book_title":"On Invocations and Supplications","section_title_ar":"Section 251","section_title_en":"The Fourth Chapter on Supplications Narrated from the Prophet (Peace Be Upon Him) and His Companions (May God Be Pleased with Them)","section_index":251,"anchors":"- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām), from which ilhām (divine inspiration) derives—that which is cast into the heart\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — divine inspiration is the casting of something into the inner faculty of consciousness (rawʿ), specifically from God and the higher assembly (malā aʿlā)\n  * Al-Zamakhshari (Asas): Literal (haqīqah): \"ألهمه الله الخير: ألقاه في روعه\" (God inspired him with good: He cast it into his inner consciousness). Metaphorical (majāz): \"جيش لهام: يغتمر من يدخله\" (an overwhelming army that engulfs whoever enters it)\n- Root: غيب (gh-y-b)\n  * Lisan / Ayn: That which is hidden from sensory perception\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين\" — that which is concealed from the eye; applied to all that is absent from the senses and from human knowledge. Notably: \"ويقال للشيء: غيب وغائب باعتباره بالناس لا بالله تعالى، فإنه لا يغيب عنه شيء\" (it is called ghayb relative to people, not relative to God, for nothing is hidden from Him)\n  * Al-Zamakhshari (Asas): Literal: \"وتكلم بذلك عن ظهر الغيب\" (he spoke of that from behind the unseen). Metaphorical: \"أتونا في غابة أي في رماح كثيرة\" (they came to us in a thicket—i.e., amidst numerous spears like dense trees)\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; two types: apprehension of the essence of a thing, and judgment upon a thing regarding what exists for it or is negated from it\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" (I did not know of your news: I was not aware of it). \"وهو من أعلام العلم الخافقه\" (he is among the lofty banners of knowledge)\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the construction \"عالم الغيب والشهادة\" where the attributive relationship is maintained through the genitive construction (iḍāfah)","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"}],"28":[{"arabic":"أعلم أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما وأحصى كل شيء عددا اللهم إني أعوذ بك من شر نفسي ومن شر كل دابة أنت آخذ بناصيتها إن ربي على صراط مستقيم (1) دعاء الخليل إبراهيم عليه الصلاة والسلام كان يقول إذا أصبح اللهم إن هذا خلق جديد فافتحه علي بطاعتك واختمه لي بمغفرتك ورضوانك وارزقني فيه حسنة تقبلها مني وزكها وضعفها لي وما عملت فيه من سيئة فاغفرها لي إنك غفور رحيم ودود كريم قال ومن دعا بهذا الدعاء إذا أصبح فقد أدى شكر يومه دعاء عيسى عليه الصلاة والسلام كان يقول اللهم إني أصبحت لا أستطيع","english":"And it is related that the Messenger of Allah (peace be upon him) said to him: \"O Buraydah, shall I not teach you words which, if anyone desires good through them, he is taught them, and then he never forgets them ever?\" He said: \"I said, 'Yes, O Messenger of Allah.'\" He said: \"Say: 'O Allah, I am weak, so strengthen my weakness in Your pleasure, and take me by my forelock toward goodness, and make Islam the limit of my contentment. O Allah, I am weak, so strengthen me; and I am abased, so honor me; and I am poor, so enrich me, O Most Merciful of the merciful.'\" (2)","book_title":"On Invocations and Supplications","section_title_ar":"Section 248","section_title_en":"The Revival of the Religious Sciences — Section 248: Supplications of the Companions and Prophets (Peace Be Upon Them)","section_index":248,"anchors":"- Root: دعو (d-'-w)\n  * Lisan / Ayn: Core meaning of calling, invoking, summoning; du'a as the act of calling upon God with humble petition.\n  * Al-Raghib (Mufradat): Theological nuance of du'a as the essence of worship ('ibadah), the creature's acknowledgment of need (iftaqar) before the Creator.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — to call out; Metaphorical (majaz) — the soul's inward turning to God, transcending mere vocal utterance.\n- Root: وقي (w-q-y)\n  * Lisan / Ayn: To protect, guard, preserve from harm; the root of taqwa (God-consciousness) and ittiqa (self-preservation from divine displeasure).\n  * Al-Raghib (Mufradat): The theological state of being shielded by God's grace through the performance of obligations and abstention from prohibitions.\n  * Al-Zamakhshari (Asas): Literal — physical protection; Metaphorical — spiritual safeguarding of the heart from worldly attachment.\n- Root: حول (h-w-l)\n  * Lisan / Ayn: Power, might, capacity to change or transform; the ability to effect motion or cessation.\n  * Al-Raghib (Mufradat): In the formula \"لا حول ولا قوة إلا بالله\" (lā ḥawla wa lā quwwata illā billāh), it denotes the creature's absolute incapacity and total reliance on divine power (quwwah) for all acts of obedience and avoidance of sin.\n  * Al-Zamakhshari (Asas): Literal — physical strength; Metaphorical — the spiritual power granted by God to overcome one's lower self (nafs).\n- Root: فقر (f-q-r)\n  * Lisan / Ayn: Poverty, neediness, lack of possessions; the state of one who requires what he does not possess.\n  * Al-Raghib (Mufradat): The ontological poverty of all creatures before God — \"يا أيها الناس أنتم الفقراء إلى الله\" {O mankind, you are the poor in need of Allah} [Fatir: 15]. This is the existential need that defines creaturehood.\n  * Al-Zamakhshari (Asas): Literal — material poverty; Metaphorical — the soul's recognition of its utter dependence on God for guidance, sustenance, and salvation.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening phrase constitutes a complete and meaningful utterance, as seen in the extended invocations where multiple clauses are joined by conjunctions (wa) before the governing verb's object is completed.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,971],[2,971,2347],[3,2347,3599],[4,3599,4780],[5,4780,5974],[6,5974,6753],[7,6753,7649],[8,7649,8882],[9,8882,11556],[10,11556,12919],[11,12919,14451],[12,14451,16320],[13,16320,17565]],"2":[[1,400,2293],[2,2293,3253],[3,3253,4615],[4,4615,6677],[5,6677,7170],[6,7170,8078],[7,8078,9543],[8,9543,11854],[9,11854,13124]],"3":[[1,400,2030],[2,2030,3733],[3,3733,4474],[4,4474,5916],[5,5916,6617],[6,6617,7762],[7,7762,9104],[8,9104,10209],[9,10209,11583]],"4":[[1,400,1805],[2,1805,2641],[3,2641,3848],[4,3848,5497],[5,5497,6356],[6,6356,7273],[7,7273,8527]],"5":[[1,400,2261],[2,2261,4718],[3,4718,5325],[4,5325,6083],[5,6083,7379],[6,7379,8647],[7,8647,10370],[8,10370,11390],[9,11390,12479],[10,12479,13777]],"6":[[1,400,2104],[2,2104,3118],[3,3118,4413],[4,4413,5384],[5,5384,6679],[6,6679,8875],[7,8875,10452],[8,10452,11423],[9,11423,12760],[10,12760,15013],[11,15013,16337]],"7":[[1,400,2275],[2,2275,4097],[3,4097,5055],[4,5055,6465],[5,6465,7050],[6,7050,7781],[7,7781,9124],[8,9124,10175],[9,10175,11478]],"8":[[1,400,2046],[2,2046,3436],[3,3436,5675],[4,5675,7833],[5,7833,8881],[6,8881,10051],[7,10051,11587],[8,11587,13098]],"9":[[1,400,2190],[2,2190,3529],[3,3529,4775],[4,4775,5968],[5,5968,7326],[6,7326,8950],[7,8950,9746],[8,9746,11284],[9,11284,12530],[10,12530,13524],[11,13524,14028],[12,14028,15699],[13,15699,17199]],"10":[[1,400,2115],[2,2