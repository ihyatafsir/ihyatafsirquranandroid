ation": "warsh"}, {"surah": 72, "ayah": 9, "text": "وَإِنَّا كُنَّا نَقْعُدُ مِنْهَا مَقَٰعِدَ لِلسَّمْعِ فَمَنْ يَّسْتَمِعِ اِ۬لَانَ يَجِدْ لَهُۥ شِهَاباࣰ رَّصَداࣰۖ", "words": [{"id": 1, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "نَقْعُدُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مَقَٰعِدَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِلسَّمْعِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَمَنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَّسْتَمِعِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لَانَ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَجِدْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 12, "arabic": "شِهَاباࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "رَّصَداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 72, "ayah": 10, "text": "وَإِنَّا لَا نَدْرِےٓ أَشَرٌّ ا۟رِيدَ بِمَن فِے اِ۬لَارْضِ أَمَ اَرَادَ بِهِمْ رَبُّهُمْ رَشَداࣰۖ", "words": [{"id": 1, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نَدْرِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَشَرٌّ", "translit": "", "root": ""}, {"id": 5, "arabic": "ا۟رِيدَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِمَن", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَمَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَرَادَ", "translit": "", "root": ""}, {"id": 11, "arabic": "بِهِمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "رَبُّهُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "رَشَداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 72, "ayah": 11, "text": "وَإِنَّا مِنَ