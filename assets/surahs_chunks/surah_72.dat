"id": 3, "arabic": "رَأَوْاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يُوعَدُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَسَيَعْلَمُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَضْعَفُ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَاصِراࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَأَقَلُّ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَدَداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 72, "ayah": 25, "text": "قُلِ اِنَ اَدْرِےٓ أَقَرِيبࣱ مَّا تُوعَدُونَ أَمْ يَجْعَلُ لَهُۥ رَبِّيَ أَمَداًۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَدْرِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَقَرِيبࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "تُوعَدُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَجْعَلُ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "رَبِّيَ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَمَداًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 72, "ayah": 26, "text": "عَٰلِمُ اُ۬لْغَيْبِ فَلَا يُظْهِرُ عَلَيٰ غَيْبِهِۦٓ أَحَداً", "words": [{"id": 1, "arabic": "عَٰلِمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْغَيْبِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُظْهِرُ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "غَيْبِهِۦٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَحَداً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 72, "ayah": 27, "text": "اِلَّا مَنِ اِ