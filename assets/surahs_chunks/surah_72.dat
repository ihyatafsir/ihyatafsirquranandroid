ranslit": "", "root": ""}, {"id": 5, "arabic": "اُ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَدْعُوهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَادُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَكُونُونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 10, "arabic": "لِبَداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 72, "ayah": 20, "text": "قَالَ إِنَّمَآ أَدْعُواْ رَبِّے وَلَآ أُشْرِكُ بِهِۦٓ أَحَداࣰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَدْعُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُشْرِكُ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِۦٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَحَداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 72, "ayah": 21, "text": "قُلِ اِنِّے لَآ أَمْلِكُ لَكُمْ ضَرّاࣰ وَلَا رَشَداࣰۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَمْلِكُ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "ضَرّاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "رَشَداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 72, "ayah": 22, "text": "قُلِ اِنِّے لَنْ يُّجِيرَنِے مِنَ اَ۬للَّهِ أَحَدࣱ وَلَنَ اَجِدَ مِن دُونِهِۦ مُلْتَحَداً", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُّجِيرَنِے", "transli