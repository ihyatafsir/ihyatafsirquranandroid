"warsh"}, {"surah": 67, "ayah": 17, "text": "أَمَ اَمِنتُم مَّن فِے اِ۬لسَّمَآءِ اَ۬نْ يُّرْسِلَ عَلَيْكُمْ حَاصِباࣰۖ فَسَتَعْلَمُونَ كَيْفَ نَذِيرِۦۖ", "words": [{"id": 1, "arabic": "أَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَمِنتُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّن", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬نْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يُّرْسِلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "حَاصِباࣰۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَسَتَعْلَمُونَ", "translit": "", "root": ""}, {"id": 11, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 12, "arabic": "نَذِيرِۦۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 18, "text": "وَلَقَدْ كَذَّبَ اَ۬لذِينَ مِن قَبْلِهِمْۖ فَكَيْفَ كَانَ نَكِيرِۦٓۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَّبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلِهِمْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَكَيْفَ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 8, "arabic": "نَكِيرِۦٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 19, "text": "۞أَوَلَمْ يَرَوِاْ اِلَي اَ۬لطَّيْرِ فَوْقَهُمْ صَٰٓفَّٰتࣲ وَيَقْبِضْنَۖ مَا يُمْسِكُهُنَّ إِلَّا اَ۬لرَّحْمَٰنُۖ إِنَّهُۥ بِكُلِّ شَےْءِۢ بَصِيرٌۖ", "words": [{"id": 1, "arabic": "۞أَوَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرَوِاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِلَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لطَّيْرِ", "translit": "", "root": ""}, {"id": 