وَإِنَّمَآ أَنَا نَذِيرࣱ مُّبِينࣱۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنَّمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْعِلْمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَإِنَّمَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "نَذِيرࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 27, "text": "فَلَمَّا رَأَوْهُ زُلْفَةࣰ س۬يَٓٔتْ وُجُوهُ اُ۬لذِينَ كَفَرُواْ وَقِيلَ هَٰذَا اَ۬لذِے كُنتُم بِهِۦ تَدَّعُونَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَأَوْهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "زُلْفَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "س۬يَٓٔتْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وُجُوهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَقِيلَ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 11, "arabic": "كُنتُم", "translit": "", "root": ""}, {"id": 12, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 13, "arabic": "تَدَّعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 28, "text": "قُلَ اَرَٰٓيْتُمُۥٓ إِنَ اَهْلَكَنِيَ اَ۬للَّهُ وَمَن مَّعِيَ أَوْ رَحِمَنَا فَمَنْ يُّجِيرُ اُ۬لْكٰ۪فِرِينَ مِنْ عَذَابٍ اَلِيمࣲۖ", "words": [{"id": 1, "arabic": "قُلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرَٰٓيْتُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَهْلَكَنِيَ", "tr