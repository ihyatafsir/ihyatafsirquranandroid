 "18": [[1, 400, 1694], [2, 1694, 2720], [3, 2720, 4197], [4, 4197, 4720], [5, 4720, 6119], [6, 6119, 7296], [7, 7296, 8237], [8, 8237, 9415]], "19": [[1, 400, 1828], [2, 1828, 3529], [3, 3529, 4653], [4, 4653, 6499], [5, 6499, 8200], [6, 8200, 10382], [7, 10382, 12752], [8, 12752, 13542], [9, 13542, 15958], [10, 15958, 17340], [11, 17340, 19391], [12, 19391, 20773], [13, 20773, 21912], [14, 21912, 22975], [15, 22975, 24435]], "20": [[1, 400, 1778], [2, 1778, 3005], [3, 3005, 4383], [4, 4383, 5094], [5, 5094, 5983], [6, 5983, 7095], [7, 7095, 9111], [8, 9111, 10134], [9, 10134, 11171], [10, 11171, 13172], [11, 13172, 13824], [12, 13824, 16018], [13, 16018, 17367], [14, 17367, 18108], [15, 18108, 19472]], "21": [[1, 400, 1745], [2, 1745, 2942], [3, 2942, 4287], [4, 4287, 6225], [5, 6225, 6861], [6, 6861, 8105], [7, 8105, 9291], [8, 9291, 9869], [9, 9869, 11778], [10, 11778, 12501], [11, 12501, 13897], [12, 13897, 15632]], "22": [[1, 400, 1588], [2, 1588, 3058], [3, 3058, 4571], [4, 4571, 5872], [5, 5872, 7566], [6, 7566, 9545], [7, 9545, 10860], [8, 10860, 12330], [9, 12330, 14260], [10, 14260, 15561], [11, 15561, 16749], [12, 16749, 19080]], "23": [[1, 400, 983], [2, 983, 1619], [3, 1619, 3488], [4, 3488, 5238], [5, 5238, 6484], [6, 6484, 7279], [7, 7279, 8717], [8, 8717, 10926], [9, 10926, 12808], [10, 12808, 14478], [11, 14478, 15552], [12, 15552, 17330]], "24": [[1, 400, 910], [2, 910, 1466], [3, 1466, 2543], [4, 2543, 3770], [5, 3770, 4349], [6, 4349, 5461], [7, 5461, 6874], [8, 6874, 8448]], "25": [[1, 400, 2782], [2, 2782, 3921], [3, 3921, 4993], [4, 4993, 6288], [5, 6288, 6858], [6, 6858, 7894], [7, 7894, 9650]], "26": [[1, 400, 1029], [2, 1029, 2817], [3, 2817, 4104], [4, 4104, 5019], [5, 5019, 6149], [6, 6149, 9098], [7, 9098, 10185], [8, 10185, 11501], [9, 11501, 13202]], "27": [[1, 400, 2118], [2, 2118, 3425], [3, 3425, 4504], [4, 4504, 6293], [5, 6293, 7685], [6, 7685, 9290], [7, 9290, 11023], [8, 11023, 12500], [9, 12500, 13676], [10, 13676, 14997], [11