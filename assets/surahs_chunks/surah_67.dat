oot": ""}, {"id": 7, "arabic": "اَ۬لْمَصِيرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 7, "text": "إِذَآ أُلْقُواْ فِيهَا سَمِعُواْ لَهَا شَهِيقاࣰ وَهِيَ تَفُورُ", "words": [{"id": 1, "arabic": "إِذَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أُلْقُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "سَمِعُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "شَهِيقاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَهِيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "تَفُورُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 8, "text": "تَكَادُ تَمَيَّزُ مِنَ اَ۬لْغَيْظِۖ كُلَّمَآ أُلْقِيَ فِيهَا فَوْجࣱ سَأَلَهُمْ خَزَنَتُهَآ أَلَمْ يَاتِكُمْ نَذِيرࣱۖ", "words": [{"id": 1, "arabic": "تَكَادُ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَمَيَّزُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْغَيْظِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلَّمَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُلْقِيَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "فَوْجࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَأَلَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "خَزَنَتُهَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَاتِكُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "نَذِيرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 9, "text": "قَالُواْ بَل۪يٰ قَدْ جَآءَنَا نَذِيرࣱ فَكَذَّبْنَا وَقُلْنَا مَا نَزَّلَ اَ۬للَّهُ مِن شَےْءٍ اِنَ اَنتُمُۥٓ إِلَّا فِے ضَلَٰلࣲ كَبِيرࣲۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَل۪يٰ", "translit":