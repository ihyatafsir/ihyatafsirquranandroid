": ""}, {"id": 2, "arabic": "بِذَنۢبِهِمْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَسُحْقاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّأَصْحَٰبِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لسَّعِيرِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 12, "text": "إِنَّ اَ۬لذِينَ يَخْشَوْنَ رَبَّهُم بِالْغَيْبِ لَهُم مَّغْفِرَةࣱ وَأَجْرࣱ كَبِيرࣱۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَخْشَوْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبَّهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالْغَيْبِ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مَّغْفِرَةࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَأَجْرࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَبِيرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 13, "text": "وَأَسِرُّواْ قَوْلَكُمُۥٓ أَوِ اِ۪جْهَرُواْ بِهِۦٓۖ إِنَّهُۥ عَلِيمُۢ بِذَاتِ اِ۬لصُّدُورِۖ", "words": [{"id": 1, "arabic": "وَأَسِرُّواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَوْلَكُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَوِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۪جْهَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهِۦٓۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلِيمُۢ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِذَاتِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لصُّدُورِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 67, "ayah": 14, "text": "أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ اَ۬للَّطِيفُ اُ۬لْخَبِيرُۖ", "words": [{"id": 1, "arabic": "أَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَنْ", "translit":