{"surah": 67, "verses": [{"ayah": 1, "text": "تَبَٰرَكَ ٱلَّذِى بِيَدِهِ ٱلْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Blessed is He in whose hand is dominion, and He is over all things competent -", "words": [{"id": 1, "arabic": "تَبَٰرَكَ", "translit": "َkَrَٰbَt", "root": "برك"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "بِيَدِهِ", "translit": "ِhِdَyِb", "root": "يدي"}, {"id": 4, "arabic": "ٱلْمُلْكُ", "translit": "ُkْlُmْlٱ", "root": "ملك"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 2, "text": "ٱلَّذِى خَلَقَ ٱلْمَوْتَ وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًاۚ وَهُوَ ٱلْعَزِيزُ ٱلْغَفُورُ ", "translation": "[He] who created death and life to test you [as to] which of you is best in deed - and He is the Exalted in Might, the Forgiving -", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلْمَوْتَ", "translit": "َtْwَmْlٱ", "root": "موت"}, {"id": 4, "arabic": "وَٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱَw", "root": "حيي"}, {"id": 5, "arabic": "لِيَبْلُوَكُمْ", "translit": "ْmُkَwُlْbَyِl", "root": "بلو"}, {"id": 6, "arabic": "أَيُّكُمْ", "translit": "ْmُkُّyَaʾ", "root": "ايي"}, {"id": 7, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 8, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 11, "arabic": "ٱلْغَفُورُ", "translit": "ُrwُfَغْlٱ", "root": "غفر"}], "hasIhya": true}, {"ayah": 3, "text": "ٱلَّذِى خَلَقَ سَبْعَ سَمَٰوَٰتٍ طِبَاقًاۖ مَّا تَرَىٰ فِى خَلْقِ ٱلرَّحْمَٰنِ مِن تَفَٰوُتٍۖ فَٱرْجِعِ ٱلْبَصَرَ هَلْ تَرَىٰ مِن فُطُورٍ ", "translation": "[And] who created seven heavens in layers.[1] You do not see in the creation of the Most Merciful any inconsistency. So return [your] vision [to the sky]; do you see any breaks?", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "سَبْعَ", "translit": "َʿعْbَs", "root": "سبع"}, {"id": 4, "arabic": "سَمَٰوَٰتٍ", "translit": "ٍtَٰwَٰmَs", "root": "سمو"}, {"id": 5, "arabic": "طِبَاقًا", "translit": "āًqāَbِṭ", "root": "طبق"}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "تَرَىٰ", "translit": "ٰàَrَt", "root": "راي"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "خَلْقِ", "translit": "ِqْlَhk", "root": "خلق"}, {"id": 10, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "تَفَٰوُتٍ", "translit": "ٍtُwَٰfَt", "root": "فوت"}, {"id": 13, "arabic": "فَٱرْجِعِ", "translit": "ِʿعِjgْrٱَf", "root": "رجع"}, {"id": 14, "arabic": "ٱلْبَصَرَ", "translit": "َrَṣَbْlٱ", "root": "بصر"}, {"id": 15, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 16, "arabic": "تَرَىٰ", "translit": "ٰàَrَt", "root": "راي"}, {"id": 17, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 18, "arabic": "فُطُورٍ", "translit": "ٍrwُṭُf", "root": "فطر"}], "hasIhya": true}, {"ayah": 4, "text": "ثُمَّ ٱرْجِعِ ٱلْبَصَرَ كَرَّتَيْنِ يَنقَلِبْ إِلَيْكَ ٱلْبَصَرُ خَاسِئًا وَهُوَ حَسِيرٌ ", "translation": "Then return [your] vision twice again.[1] [Your] vision will return to you humbled while it is fatigued.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "ٱرْجِعِ", "translit": "ِʿعِjgْrٱ", "root": "رجع"}, {"id": 3, "arabic": "ٱلْبَصَرَ", "translit": "َrَṣَbْlٱ", "root": "بصر"}, {"id": 4, "arabic": "كَرَّتَيْنِ", "translit": "ِnْyَtَّrَk", "root": "كرر"}, {"id": 5, "arabic": "يَنقَلِبْ", "translit": "ْbِlَqnَy", "root": "قلب"}, {"id": 6, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلْبَصَرُ", "translit": "ُrَṣَbْlٱ", "root": "بصر"}, {"id": 8, "arabic": "خَاسِئًا", "translit": "āًyʾِsāَhk", "root": "خسا"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "حَسِيرٌ", "translit": "ٌryِsَḥ", "root": "حسر"}], "hasIhya": false}, {"ayah": 5, "text": "وَلَقَدْ زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَٰبِيحَ وَجَعَلْنَٰهَا رُجُومًا لِّلشَّيَٰطِينِۖ وَأَعْتَدْنَا لَهُمْ عَذَابَ ٱلسَّعِيرِ ", "translation": "And We have certainly beautified the nearest heaven with lamps [i.e., stars] and have made [from] them what is thrown at the devils[1] and have prepared for them the punishment of the Blaze.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "زَيَّنَّا", "translit": "āَّnَّyَz", "root": "زين"}, {"id": 3, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 5, "arabic": "بِمَصَٰبِيحَ", "translit": "َḥyِbَٰṣَmِb", "root": "صبح"}, {"id": 6, "arabic": "وَجَعَلْنَٰهَا", "translit": "āَhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 7, "arabic": "رُجُومًا", "translit": "āًmwُjgُr", "root": "رجم"}, {"id": 8, "arabic": "لِّلشَّيَٰطِينِ", "translit": "ِnyِṭَٰyَّhslِّl", "root": "شطن"}, {"id": 9, "arabic": "وَأَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾَw", "root": "عتد"}, {"id": 10, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 11, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": false}, {"ayah": 6, "text": "وَلِلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ عَذَابُ جَهَنَّمَۖ وَبِئْسَ ٱلْمَصِيرُ ", "translation": "And for those who disbelieved in their Lord is the punishment of Hell, and wretched is the destination.", "words": [{"id": 1, "arabic": "وَلِلَّذِينَ", "translit": "َnyِhdَّlِlَw", "root": ""}, {"id": 2, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 3, "arabic": "بِرَبِّهِمْ", "translit": "ْmِhِّbَrِb", "root": "ربب"}, {"id": 4, "arabic": "عَذَابُ", "translit": "ُbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 6, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 7, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": false}, {"ayah": 7, "text": "إِذَآ أُلْقُوا۟ فِيهَا سَمِعُوا۟ لَهَا شَهِيقًا وَهِىَ تَفُورُ ", "translation": "When they are thrown into it, they hear from it a [dreadful] inhaling while it boils up.", "words": [{"id": 1, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 2, "arabic": "أُلْقُوا۟", "translit": "۟āwُqْlُaʾ", "root": "لقي"}, {"id": 3, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 4, "arabic": "سَمِعُوا۟", "translit": "۟āwُʿعِmَs", "root": "سمع"}, {"id": 5, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 6, "arabic": "شَهِيقًا", "translit": "āًqyِhَhs", "root": "شهق"}, {"id": 7, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 8, "arabic": "تَفُورُ", "translit": "ُrwُfَt", "root": "فور"}], "hasIhya": false}, {"ayah": 8, "text": "تَكَادُ تَمَيَّزُ مِنَ ٱلْغَيْظِۖ كُلَّمَآ أُلْقِىَ فِيهَا فَوْجٌ سَأَلَهُمْ خَزَنَتُهَآ أَلَمْ يَأْتِكُمْ نَذِيرٌ ", "translation": "It almost bursts with rage. Every time a company is thrown into it, its keepers ask them, \"Did there not come to you a warner?\"", "words": [{"id": 1, "arabic": "تَكَادُ", "translit": "ُdāَkَt", "root": "كود"}, {"id": 2, "arabic": "تَمَيَّزُ", "translit": "ُzَّyَmَt", "root": "ميز"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْغَيْظِ", "translit": "ِẓْyَغْlٱ", "root": "غيظ"}, {"id": 5, "arabic": "كُلَّمَآ", "translit": "ٓāَmَّlُk", "root": "كلل"}, {"id": 6, "arabic": "أُلْقِىَ", "translit": "َàِqْlُaʾ", "root": "لقي"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "فَوْجٌ", "translit": "ٌjgْwَf", "root": "فوج"}, {"id": 9, "arabic": "سَأَلَهُمْ", "translit": "ْmُhَlَaʾَs", "root": "سال"}, {"id": 10, "arabic": "خَزَنَتُهَآ", "translit": "ٓāَhُtَnَzَhk", "root": "خزن"}, {"id": 11, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 12, "arabic": "يَأْتِكُمْ", "translit": "ْmُkِtْaʾَy", "root": "اتي"}, {"id": 13, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}], "hasIhya": true}, {"ayah": 9, "text": "قَالُوا۟ بَلَىٰ قَدْ جَآءَنَا نَذِيرٌ فَكَذَّبْنَا وَقُلْنَا مَا نَزَّلَ ٱللَّهُ مِن شَىْءٍ إِنْ أَنتُمْ إِلَّا فِى ضَلَٰلٍ كَبِيرٍ ", "translation": "They will say, \"Yes, a warner had come to us, but we denied and said, 'Allāh has not sent down anything. You are not but in great error.'\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "جَآءَنَا", "translit": "āَnَءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 6, "arabic": "فَكَذَّبْنَا", "translit": "āَnْbَّhdَkَf", "root": "كذب"}, {"id": 7, "arabic": "وَقُلْنَا", "translit": "āَnْlُqَw", "root": "قول"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 14, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 18, "arabic": "كَبِيرٍ", "translit": "ٍryِbَk", "root": "كبر"}], "hasIhya": true}, {"ayah": 10, "text": "وَقَالُوا۟ لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِىٓ أَصْحَٰبِ ٱلسَّعِيرِ ", "translation": "And they will say, \"If only we had been listening or reasoning, we would not be among the companions of the Blaze.\"", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 3, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 4, "arabic": "نَسْمَعُ", "translit": "ُʿعَmْsَn", "root": "سمع"}, {"id": 5, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 6, "arabic": "نَعْقِلُ", "translit": "ُlِqْʿعَn", "root": "عقل"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 9, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 10, "arabic": "أَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 11, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": true}, {"ayah": 11, "text": "فَٱعْتَرَفُوا۟ بِذَنۢبِهِمْ فَسُحْقًا لِّأَصْحَٰبِ ٱلسَّعِيرِ ", "translation": "And they will admit their sin, so [it is] alienation[1] for the companions of the Blaze.", "words": [{"id": 1, "arabic": "فَٱعْتَرَفُوا۟", "translit": "۟āwُfَrَtْʿعٱَf", "root": "عرف"}, {"id": 2, "arabic": "بِذَنۢبِهِمْ", "translit": "ْmِhِbۢnَhdِb", "root": "ذنب"}, {"id": 3, "arabic": "فَسُحْقًا", "translit": "āًqْḥُsَf", "root": "سحق"}, {"id": 4, "arabic": "لِّأَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾِّl", "root": "صحب"}, {"id": 5, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": false}, {"ayah": 12, "text": "إِنَّ ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم بِٱلْغَيْبِ لَهُم مَّغْفِرَةٌ وَأَجْرٌ كَبِيرٌ ", "translation": "Indeed, those who fear their Lord unseen will have forgiveness and great reward.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَخْشَوْنَ", "translit": "َnْwَhsْhkَy", "root": "خشي"}, {"id": 4, "arabic": "رَبَّهُم", "translit": "mُhَّbَr", "root": "ربب"}, {"id": 5, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 6, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 7, "arabic": "مَّغْفِرَةٌ", "translit": "ٌẗَrِfْغَّm", "root": "غفر"}, {"id": 8, "arabic": "وَأَجْرٌ", "translit": "ٌrْjgَaʾَw", "root": "اجر"}, {"id": 9, "arabic": "كَبِيرٌ", "translit": "ٌryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 13, "text": "وَأَسِرُّوا۟ قَوْلَكُمْ أَوِ ٱجْهَرُوا۟ بِهِۦٓۖ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ", "translation": "And conceal your speech or publicize it; indeed, He is Knowing of that within the breasts.", "words": [{"id": 1, "arabic": "وَأَسِرُّوا۟", "translit": "۟āwُّrِsَaʾَw", "root": "سرر"}, {"id": 2, "arabic": "قَوْلَكُمْ", "translit": "ْmُkَlْwَq", "root": "قول"}, {"id": 3, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 4, "arabic": "ٱجْهَرُوا۟", "translit": "۟āwُrَhْjgٱ", "root": "جهر"}, {"id": 5, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 6, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 7, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 8, "arabic": "بِذَاتِ", "translit": "ِtāَhdِb", "root": ""}, {"id": 9, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": true}, {"ayah": 14, "text": "أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ ٱللَّطِيفُ ٱلْخَبِيرُ ", "translation": "Does He who created not know,[1] while He is the Subtle, the Aware?", "words": [{"id": 1, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 4, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "ٱللَّطِيفُ", "translit": "ُfyِṭَّllٱ", "root": "لطف"}, {"id": 7, "arabic": "ٱلْخَبِيرُ", "translit": "ُryِbَhkْlٱ", "root": "خبر"}], "hasIhya": true}, {"ayah": 15, "text": "هُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ ذَلُولًا فَٱمْشُوا۟ فِى مَنَاكِبِهَا وَكُلُوا۟ مِن رِّزْقِهِۦۖ وَإِلَيْهِ ٱلنُّشُورُ ", "translation": "It is He who made the earth tame[1] for you - so walk among its slopes and eat of His provision - and to Him is the resurrection.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "ذَلُولًا", "translit": "āًlwُlَhd", "root": "ذلل"}, {"id": 7, "arabic": "فَٱمْشُوا۟", "translit": "۟āwُhsْmٱَf", "root": "مشي"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "مَنَاكِبِهَا", "translit": "āَhِbِkāَnَm", "root": "نكب"}, {"id": 10, "arabic": "وَكُلُوا۟", "translit": "۟āwُlُkَw", "root": "اكل"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "رِّزْقِهِۦ", "translit": "ۦِhِqْzِّr", "root": "رزق"}, {"id": 13, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 14, "arabic": "ٱلنُّشُورُ", "translit": "ُrwُhsُّnlٱ", "root": "نشر"}], "hasIhya": true}, {"ayah": 16, "text": "ءَأَمِنتُم مَّن فِى ٱلسَّمَآءِ أَن يَخْسِفَ بِكُمُ ٱلْأَرْضَ فَإِذَا هِىَ تَمُورُ ", "translation": "Do you feel secure that He who is above[1] would not cause the earth to swallow you and suddenly it would sway?[2]", "words": [{"id": 1, "arabic": "ءَأَمِنتُم", "translit": "mُtnِmَaʾَء", "root": "امن"}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يَخْسِفَ", "translit": "َfِsْhkَy", "root": "خسف"}, {"id": 7, "arabic": "بِكُمُ", "translit": "ُmُkِb", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 10, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 11, "arabic": "تَمُورُ", "translit": "ُrwُmَt", "root": "مور"}], "hasIhya": false}, {"ayah": 17, "text": "أَمْ أَمِنتُم مَّن فِى ٱلسَّمَآءِ أَن يُرْسِلَ عَلَيْكُمْ حَاصِبًاۖ فَسَتَعْلَمُونَ كَيْفَ نَذِيرِ ", "translation": "Or do you feel secure that He who is above would not send against you a storm of stones? Then you would know how [severe] was My warning.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "أَمِنتُم", "translit": "mُtnِmَaʾ", "root": "امن"}, {"id": 3, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "يُرْسِلَ", "translit": "َlِsْrُy", "root": "رسل"}, {"id": 8, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 9, "arabic": "حَاصِبًا", "translit": "āًbِṣāَḥ", "root": "حصب"}, {"id": 10, "arabic": "فَسَتَعْلَمُونَ", "translit": "َnwُmَlْʿعَtَsَf", "root": "علم"}, {"id": 11, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 12, "arabic": "نَذِيرِ", "translit": "ِryِhdَn", "root": "نذر"}], "hasIhya": false}, {"ayah": 18, "text": "وَلَقَدْ كَذَّبَ ٱلَّذِينَ مِن قَبْلِهِمْ فَكَيْفَ كَانَ نَكِيرِ ", "translation": "And already had those before them denied, and how [terrible] was My reproach.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "نَكِيرِ", "translit": "ِryِkَn", "root": "نكر"}], "hasIhya": false}, {"ayah": 19, "text": "أَوَلَمْ يَرَوْا۟ إِلَى ٱلطَّيْرِ فَوْقَهُمْ صَٰٓفَّٰتٍ وَيَقْبِضْنَۚ مَا يُمْسِكُهُنَّ إِلَّا ٱلرَّحْمَٰنُۚ إِنَّهُۥ بِكُلِّ شَىْءٍۭ بَصِيرٌ ", "translation": "Do they not see the birds above them with wings outspread and [sometimes] folded in? None holds them [aloft] except the Most Merciful. Indeed He is, of all things, Seeing.", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلطَّيْرِ", "translit": "ِrْyَّṭlٱ", "root": "طير"}, {"id": 5, "arabic": "فَوْقَهُمْ", "translit": "ْmُhَqْwَf", "root": "فوق"}, {"id": 6, "arabic": "صَٰٓفَّٰتٍ", "translit": "ٍtَّٰfَٰٓṣ", "root": "صفف"}, {"id": 7, "arabic": "وَيَقْبِضْنَ", "translit": "َnْḍِbْqَyَw", "root": "قبض"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "يُمْسِكُهُنَّ", "translit": "َّnُhُkِsْmُy", "root": "مسك"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 12, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 14, "arabic": "شَىْءٍۭ", "translit": "ٍۭءْàَhs", "root": "شيا"}, {"id": 15, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 20, "text": "أَمَّنْ هَٰذَا ٱلَّذِى هُوَ جُندٌ لَّكُمْ يَنصُرُكُم مِّن دُونِ ٱلرَّحْمَٰنِۚ إِنِ ٱلْكَٰفِرُونَ إِلَّا فِى غُرُورٍ ", "translation": "Or who is it that could be an army for you to aid you other than the Most Merciful? The disbelievers are not but in delusion.", "words": [{"id": 1, "arabic": "أَمَّنْ", "translit": "ْnَّmَaʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 5, "arabic": "جُندٌ", "translit": "ٌdnُjg", "root": "جند"}, {"id": 6, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 7, "arabic": "يَنصُرُكُم", "translit": "mُkُrُṣnَy", "root": "نصر"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 10, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 11, "arabic": "إِنِ", "translit": "ِnِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}, {"id": 13, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "غُرُورٍ", "translit": "ٍrwُrُغ", "root": "غرر"}], "hasIhya": false}, {"ayah": 21, "text": "أَمَّنْ هَٰذَا ٱلَّذِى يَرْزُقُكُمْ إِنْ أَمْسَكَ رِزْقَهُۥۚ بَل لَّجُّوا۟ فِى عُتُوٍّ وَنُفُورٍ ", "translation": "Or who is it that could provide for you if He withheld His provision? But they have persisted in insolence and aversion.", "words": [{"id": 1, "arabic": "أَمَّنْ", "translit": "ْnَّmَaʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَرْزُقُكُمْ", "translit": "ْmُkُqُzْrَy", "root": "رزق"}, {"id": 5, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 6, "arabic": "أَمْسَكَ", "translit": "َkَsْmَaʾ", "root": "مسك"}, {"id": 7, "arabic": "رِزْقَهُۥ", "translit": "ۥُhَqْzِr", "root": "رزق"}, {"id": 8, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 9, "arabic": "لَّجُّوا۟", "translit": "۟āwُّjgَّl", "root": "لجج"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "عُتُوٍّ", "translit": "ٍّwُtُʿع", "root": "عتو"}, {"id": 12, "arabic": "وَنُفُورٍ", "translit": "ٍrwُfُnَw", "root": "نفر"}], "hasIhya": false}, {"ayah": 22, "text": "أَفَمَن يَمْشِى مُكِبًّا عَلَىٰ وَجْهِهِۦٓ أَهْدَىٰٓ أَمَّن يَمْشِى سَوِيًّا عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "Then is one who walks fallen on his face better guided or one who walks erect on a straight path?", "words": [{"id": 1, "arabic": "أَفَمَن", "translit": "nَmَfَaʾ", "root": ""}, {"id": 2, "arabic": "يَمْشِى", "translit": "àِhsْmَy", "root": "مشي"}, {"id": 3, "arabic": "مُكِبًّا", "translit": "āًّbِkُm", "root": "كبب"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "وَجْهِهِۦٓ", "translit": "ٓۦِhِhْjgَw", "root": "وجه"}, {"id": 6, "arabic": "أَهْدَىٰٓ", "translit": "ٰٓàَdْhَaʾ", "root": "هدي"}, {"id": 7, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 8, "arabic": "يَمْشِى", "translit": "àِhsْmَy", "root": "مشي"}, {"id": 9, "arabic": "سَوِيًّا", "translit": "āًّyِwَs", "root": "سوي"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 12, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": true}, {"ayah": 23, "text": "قُلْ هُوَ ٱلَّذِىٓ أَنشَأَكُمْ وَجَعَلَ لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَٰرَ وَٱلْأَفْـِٔدَةَۖ قَلِيلًا مَّا تَشْكُرُونَ ", "translation": "Say, \"It is He who has produced you and made for you hearing and vision and hearts [i.e., intellect]; little are you grateful.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أَنشَأَكُمْ", "translit": "ْmُkَaʾَhsnَaʾ", "root": "نشا"}, {"id": 5, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 7, "arabic": "ٱلسَّمْعَ", "translit": "َʿعْmَّslٱ", "root": "سمع"}, {"id": 8, "arabic": "وَٱلْأَبْصَٰرَ", "translit": "َrَٰṣْbَaʾْlٱَw", "root": "بصر"}, {"id": 9, "arabic": "وَٱلْأَفْـِٔدَةَ", "translit": "َẗَdِٔـْfَaʾْlٱَw", "root": "فاد"}, {"id": 10, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 11, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 12, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 24, "text": "قُلْ هُوَ ٱلَّذِى ذَرَأَكُمْ فِى ٱلْأَرْضِ وَإِلَيْهِ تُحْشَرُونَ ", "translation": "Say, \"It is He who has multiplied you throughout the earth, and to Him you will be gathered.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ذَرَأَكُمْ", "translit": "ْmُkَaʾَrَhd", "root": "ذرا"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 8, "arabic": "تُحْشَرُونَ", "translit": "َnwُrَhsْḥُt", "root": "حشر"}], "hasIhya": false}, {"ayah": 25, "text": "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"When is this promise, if you should be truthful?\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْوَعْدُ", "translit": "ُdْʿعَwْlٱ", "root": "وعد"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 26, "text": "قُلْ إِنَّمَا ٱلْعِلْمُ عِندَ ٱللَّهِ وَإِنَّمَآ أَنَا۠ نَذِيرٌ مُّبِينٌ ", "translation": "Say, \"The knowledge is only with Allāh, and I am only a clear warner.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلْعِلْمُ", "translit": "ُmْlِʿعْlٱ", "root": "علم"}, {"id": 4, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَإِنَّمَآ", "translit": "ٓāَmَّnِiʾَw", "root": ""}, {"id": 7, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 8, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 9, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 27, "text": "فَلَمَّا رَأَوْهُ زُلْفَةً سِيٓـَٔتْ وُجُوهُ ٱلَّذِينَ كَفَرُوا۟ وَقِيلَ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَدَّعُونَ ", "translation": "But when they see it[1] approaching, the faces of those who disbelieve will be distressed, and it will be said, \"This is that for which you used to call.\"[2]", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "رَأَوْهُ", "translit": "ُhْwَaʾَr", "root": "راي"}, {"id": 3, "arabic": "زُلْفَةً", "translit": "ًẗَfْlُz", "root": "زلف"}, {"id": 4, "arabic": "سِيٓـَٔتْ", "translit": "ْtَٔـٓyِs", "root": "سوا"}, {"id": 5, "arabic": "وُجُوهُ", "translit": "ُhwُjgُw", "root": "وجه"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 8, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 9, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 10, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "تَدَّعُونَ", "translit": "َnwُʿعَّdَt", "root": "دعو"}], "hasIhya": false}, {"ayah": 28, "text": "قُلْ أَرَءَيْتُمْ إِنْ أَهْلَكَنِىَ ٱللَّهُ وَمَن مَّعِىَ أَوْ رَحِمَنَا فَمَن يُجِيرُ ٱلْكَٰفِرِينَ مِنْ عَذَابٍ أَلِيمٍ ", "translation": "Say, [O Muḥammad], \"Have you considered:[1] whether Allāh should cause my death and those with me or have mercy upon us, who can protect the disbelievers from a painful punishment?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 4, "arabic": "أَهْلَكَنِىَ", "translit": "َàِnَkَlْhَaʾ", "root": "هلك"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "مَّعِىَ", "translit": "َàِʿعَّm", "root": ""}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "رَحِمَنَا", "translit": "āَnَmِḥَr", "root": "رحم"}, {"id": 10, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 11, "arabic": "يُجِيرُ", "translit": "ُryِjgُy", "root": "جور"}, {"id": 12, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "عَذَابٍ", "translit": "ٍbāَhdَʿع", "root": "عذب"}, {"id": 15, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 29, "text": "قُلْ هُوَ ٱلرَّحْمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيْهِ تَوَكَّلْنَاۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَلَٰلٍ مُّبِينٍ ", "translation": "Say, \"He is the Most Merciful; we have believed in Him, and upon Him we have relied. And you will [come to] know who it is that is in clear error.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 4, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "وَعَلَيْهِ", "translit": "ِhْyَlَʿعَw", "root": ""}, {"id": 7, "arabic": "تَوَكَّلْنَا", "translit": "āَnْlَّkَwَt", "root": "وكل"}, {"id": 8, "arabic": "فَسَتَعْلَمُونَ", "translit": "َnwُmَlْʿعَtَsَf", "root": "علم"}, {"id": 9, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 13, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 30, "text": "قُلْ أَرَءَيْتُمْ إِنْ أَصْبَحَ مَآؤُكُمْ غَوْرًا فَمَن يَأْتِيكُم بِمَآءٍ مَّعِينٍۭ ", "translation": "Say, \"Have you considered: if your water was to become sunken [into the earth], then who could bring you flowing water?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 4, "arabic": "أَصْبَحَ", "translit": "َḥَbْṣَaʾ", "root": "صبح"}, {"id": 5, "arabic": "مَآؤُكُمْ", "translit": "ْmُkُwʾٓāَm", "root": "موه"}, {"id": 6, "arabic": "غَوْرًا", "translit": "āًrْwَغ", "root": "غور"}, {"id": 7, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 8, "arabic": "يَأْتِيكُم", "translit": "mُkyِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "بِمَآءٍ", "translit": "ٍءٓāَmِb", "root": "موه"}, {"id": 10, "arabic": "مَّعِينٍۭ", "translit": "ٍۭnyِʿعَّm", "root": "عين"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "وهو مع ذلك قريب من كل موجود وهو أقرب إلى العبد من حبل الوريد وهو على كل شيء شهيد إذ لا يماثل قربه قرب الأجسام كما لا تماثل ذاته ذات الأجسام وأنه لا يحل في شيء ولا يحل فيه شيء تعالى عن أن يحويه مكان كما تقدس عن أن يحده زمان بل كان قبل أن خلق الزمان والمكان وهو الآن على ما عليه كان وأنه بائن عن خلقه بصفاته ليس في ذاته سواه ولا في سواه ذاته وأنه مقدس عن التغير والانتقال لا تحله الحوادث ولا تعتريه العوارض بل لا يزال في نعوت جلاله منزها عن الزوال وفي صفات كماله مستغنيا عن زيادة الاستكمال وأنه في ذاته معلوم الوجود بالعقول مرئ", "english": "- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 72", "section_title_en": "Section 72", "section_index": 72, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "الأصل الأول العلم بأن صانع العالم قادر وأنه تعالى في قوله وهو على كل شيء قدير صادق لأن العالم محكم في صنعته مرتب في خلقته ومن رأى ثوبا من ديباج حسن النسج والتأليف متناسب التطريز والتطريف ثم توهم صدور نسجه عن ميت لا استطاعة له أو عن إنسان لا قدرة له كان منخلعا عن غريزة العقل ومنخرطا في سلك أهل الغباوة والجهل الأصل الثاني العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك", "english": "**The Eighth Principle: Knowledge that He, Exalted is He, is established upon His Throne (mustawin ʿalā ʿarshihi) in the sense that God, Exalted is He, intended by istiwāʾ — which is the sense that does not contradict the attribute of Majesty, nor does any mark of origination (ḥudūth) or passing away (fanāʾ) attach to it. And it is the sense intended by His saying — istiwāʾ toward the heaven — where He said in the Qur'an: {«ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ وَهِيَ دُخَانٌ»} (\"Then He directed Himself to the heaven, and it was smoke\") [Fussilat 41:11]. And that is only by way of subjugation (qahr) and dominion (istīlāʾ), as the poet said:", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 90", "section_title_en": "The Revival of the Religious Sciences — Section 90: The Ten Principles Concerning Knowledge of the Divine Attributes", "section_index": 90, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denoting the faculty of perception and comprehension; the mark or trace by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from awareness (shiʿr); here, it denotes certain, verified cognition of theological verities.\n- Root: س و ي (s-w-y)\n  * Lisan / Ayn: Root indicating straightness, equality, and levelness; from it derives istiwāʾ (establishing oneself upon, ascending to).\n  * Al-Raghib (Mufradat): Istiwāʾ upon the Throne (al-ʿArsh) is a divine act of sovereign dominion, not corporeal settlement.\n  * Al-Zamakhshari (Asas): Literal sense of physical sitting is impossible for God; metaphorical sense (majāz) of qahr (overpowering) and istīlāʾ (dominion) is necessitated by reason and consensus.\n- Root: ر أ ي (r-ʾ-y)\n  * Lisan / Ayn: Visual perception; also opinion and discernment.\n  * Al-Raghib (Mufradat): Ruʾyah (vision) of God in the Hereafter is a mode of disclosure (kashf) and knowledge (ʿilm), more complete than intellectual cognition, not conditioned by spatial direction.\n  * Al-Zamakhshari (Asas): Literal vision requires corporeality and direction; its application to God demands theological specification (takhṣīṣ) without nullifying the veracity of the scriptural promise.\n- Root: ق د ر (q-d-r)\n  * Lisan / Ayn: Power, measure, decree; the capacity to bring about an act.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is the negation of incapacity (ʿajz); absolute power belongs to God alone, while creatures possess limited capacity.\n  * Al-Zamakhshari (Asas): Literal power over an object; metaphorically, God's power encompasses all things without exertion or instrument.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, applied here to the parsing of \"إلى السماء\" in the verse on istiwāʾ, where the prepositional phrase is delayed to highlight the divine act of sovereign direction toward the heavens.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}], "2": [{"arabic": "للموت قبل نزوله وقال السدي الذي خلق الموت والحياة ليبلوكم أيكم احسن عملا أي أيكم أكثرللموت ذكرا وأحسن له استعدادا وأشد منه خوفا وحذرا وقال حذيفة ما من صباح ولا مساء إلا ومنادى ينادى أيها الناس الرحيل الرحيل وتصديق ذلك قوله تعالى إنها لإحدى الكبر نذيرا للبشر لمن شاء منكم أن يتقدم أو يتأخر في الموت وقال سحيم مولى بني تميم جلست إلى عامر بن عبد الله وهو يصلي فأوجز في صلاته ثم أقبل على فقال أرحني بحاجتك فإني أبادر قلت وما تبادر قال ملك الموت رحمك الله قال فقمت عنه وقام إلى صلاته ومر داود الطائي فسأله رجل عن حديث", "english": "I say: The hadith was transmitted by al-Tirmidhi and deemed sound (ḥasan) from the narration of Ubayy ibn Kaʿb (5): a hadith that when he (the Prophet, peace be upon him) sensed from his companions heedlessness or negligence, he would call out to them in a raised voice: \"Death has come upon you.\" This hadith was transmitted by Ibn Abi al-Dunya in *Qaṣr al-Amal* from the narration of Zayd al-Sulaymi as a mursal report (6). The hadith of Abu Hurayrah: \"I am the warner, death is the transformer, and the Hour is the appointed meeting\" — transmitted by Ibn Abi al-Dunya in *Qaṣr al-Amal* and by Abu al-Qasim al-Baghawi with an isnad containing some weakness (7). The hadith of Ibn ʿUmar: \"The Messenger of God, peace be upon him, went out while the sun was at the tips of the palm fronds and said: 'What remains of this world is but like what remains of this day of ours, relative to what has passed of it'\" — transmitted by Ibn Abi al-Dunya therein with a sound isnad, and al-Tirmidhi transmitted something similar from the narration of Abu Saʿid and deemed it sound (8). The hadith: \"The likeness of this world is like a garment torn from its beginning to its end\" — transmitted by Ibn Abi al-Dunya therein from the narration of Anas, but it is not authentic (9). Ibn Masʿud, may God be pleased with him, said: The Messenger of God, peace be upon him, recited: {فمن يرد الله أن يهديه يشرح صدره للإسلام} \"Whomsoever God wishes to guide, He expands his breast to Islam\" {فقال} \"Then he said: 'When the light enters the breast, it expands.' It was said: 'O Messenger of God, is there a sign of this that is recognized?' PageV04P459 {قال} He said: 'Yes: withdrawal from the abode of delusion, turning in repentance to the abode of permanence, and preparation for death before its descent.'\" Al-Suddi said concerning His saying: {الذي خلق الموت والحياة ليبلوكم أيكم أحسن عملا} \"He who created death and life to test you, which of you is best in deed\" — meaning: which of you is most mindful of death, best prepared for it, and most fearful and cautious of it. Hudhayfah said: \"There is no morning or evening except that a caller calls out: 'O people, the departure! The departure!'\" The confirmation of that is His saying, the Exalted: {إنها لإحدى الكبر * نذيرا للبشر * لمن شاء منكم أن يتقدم أو يتأخر} \"Indeed, it is one of the greatest calamities, a warning to mankind, for whoever among you wishes to advance or delay\" — regarding death. Suhaym, the freed slave of Banu Tamim, said: I sat with ʿAmir ibn ʿAbd Allah while he was praying, and he shortened his prayer, then turned to me and said: \"Relieve me of your need, for I am hastening.\" I said: \"What are you hastening for?\" He said: \"The angel of death, may God have mercy on you.\" He said: So I rose from him, and he returned to his prayer. Dawud al-Ta'i passed by, and a man asked him about a hadith, so he said: \"Leave me, for I am only hastening against the departure of my soul.\" ʿUmar, may God be pleased with him, said: \"Deliberation is good in everything except in deeds of goodness for the Hereafter.\" Al-Mundhir said: I heard Malik ibn Dinar saying to himself: \"Woe to you, hasten before the matter comes upon you. Woe to you, hasten before the matter comes upon you\" — repeating that sixty times, while I heard him and he did not see me. Al-Hasan used to say in his exhortation: \"Hasten, hasten! For it is but breaths — if they are held back, your deeds by which you draw near to God, the Mighty and Majestic, are cut off. May God have mercy on a man who looked to his own soul and wept over the number of his sins.\" Then he recited this verse: {إنما نعد لهم عدا} \"We only count for them a counting\" — meaning the breaths. The end of the counting is the departure of your soul; the end of the counting is the parting from your family; the end of the counting is your entry into your grave. Abu Musa al-Ashʿari strove with intense exertion before his death, and it was said to him: \"Would you not hold back, or show yourself some gentleness?\" He said: \"When horses are released and approach the end of their course, they bring out all that they have. What remains of my term is less than that.\" He said: He continued in that state until he died. And he used to say to his wife: \"Tighten your saddle, for there is no crossing over Hellfire.\" One of the caliphs said from his pulpit: \"O servants of God, fear God as much as you are able, and be a people who were called out to, so they awoke, and knew that this world is not for them a permanent abode, so they exchanged it, and prepared for death, for it has overshadowed you. And depart, for the journey has become urgent for you. Indeed, a goal that the moment diminishes and the hour demolishes is worthy of a short duration. Indeed, an absent one whom the two new ones — night and day — hasten is deserving of a swift return. Indeed, an arrival that resolves in triumph or misery is worthy of the best provision. So let him meet his Lord — whoever advises his own soul, presents his repentance, and overcomes his desire — for his term is concealed from him, his hope deceives him, and Satan is entrusted to him, promising him repentance to postpone it, and beautifying disobedience to him to commit it, until his death descends upon him when he is most heedless of it. Indeed, between each of you and Paradise or Hellfire is nothing but death, that it should alight upon him. So what a regret for one who is heedless, or whose life is a proof against him, and whose days lead him to misery. May God make us and you among those whom prosperity does not make insolent, whom disobedience does not hold back from obedience to God, and upon whom regret does not alight after death. Indeed, He is Hearing of supplication, and in His hand is goodness always, and He does what He wills.\" Some of the exegetes said concerning His saying, the Exalted: {فتنتم أنفسكم} \"You tried yourselves\" — meaning: with desires and pleasures; {وتربصتم} \"and you waited\" — meaning: for repentance; {وارتبتم} \"and you doubted\" — meaning: you were skeptical, until the command of God came — meaning: death; {وغركم بالله الغرور} \"and the deluder deluded you concerning God\" — meaning: Satan. Al-Hasan said: \"Be patient and be firm, for it is but a few days, and you are but a standing caravan — soon one of you will be called, and he will respond without turning back. So move on with the righteous deeds that are in your possession.\" Ibn Masʿud said: \"There is none of you who wakes up except that he is a guest, and what he has is a loan. The guest departs, and the loan is returned.\" Abu ʿUbaydah al-Baji said: We entered upon al-Hasan in his illness from which he died, and he said: \"Welcome to you, and greetings. May God greet you with peace, and settle us and you in the abode of permanence. This is a good outward sign if you are patient, truthful, and God-fearing. So let not your share of this report — may God have mercy on you — be merely that you hear it with this ear and let it out from this ear. For whoever has seen Muhammad, peace be upon him, has seen him going forth early.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1291", "section_title_en": "The Haste for Death and Readiness for the Hereafter — Section 1291", "section_index": 1291, "anchors": "- Root: موت (m-w-t)\n  * Lisan / Ayn: Core root denotes cessation of vital faculty; \"مات موتة\" as a singular event of death.\n  * Al-Raghib (Mufradat): Death as transition from worldly life to the reckoning; linked to \"أجل\" (appointed term) and divine decree.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) = biological death; Metaphorical (Majaz) = \"إماتة\" of the heart via heedlessness, and \"الموت المغير\" as the transformative destroyer of states.\n- Root: بدر (b-d-r)\n  * Lisan / Ayn: Core root denotes hastening, rushing to a task; \"بادر\" implies competing with time.\n  * Al-Raghib (Mufradat): In Quranic usage, \"المبادر\" is the soul's urgency toward obedience before the term expires.\n  * Al-Zamakhshari (Asas): Literal = physical speed; Metaphorical = spiritual vigilance against procrastination (تسويف).\n- Root: عرض (ʿ-r-ḍ)\n  * Lisan / Ayn: Core root denotes presenting, exposing; \"العارية\" (loan) as something transiently possessed.\n  * Al-Raghib (Mufradat): Worldly life as \"عارية\" (borrowed thing) from God, to be returned at death.\n  * Al-Zamakhshari (Asas): Literal = loaned object; Metaphorical = the body and lifespan as a trust (أمانة) from the Creator.\n- Sibawayh Rule: باب التوكيد بالتكرار (Emphatic Repetition) — Repetition of phrases like \"ويحك بادري\" and \"المبادرة المبادرة\" serves as syntactic emphasis (توكيد لفظي) to intensify the exhortation, a structure Sibawayh treats as permissible for rhetorical force without redundancy.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}, {"arabic": "تعالى نحن قدرنا بينكم الموت وفي قوله تعالى الذي خلق الموت والحياة ولا مناقضة بين قوله تعالى نحن قدرنا بينكم الموت وبين قوله وأنا أكره مساءته ولكن إيضاح الحق في هذا يستدعي تحقيق معنى الإرادة والمحبة والكراهة وبيان حقائقها فإن السابق إلى الإفهام منها أمور تناسب إرادة الخلق ومحبتهم وكراهتهم وهيهات فبين صفات الله تعالى وصفات الخلق من البعد ما بين ذاته العزيز وذاتهم وكما أن ذوات الخلق جوهر وعرض وذات الله مقدس عنه ولا يناسب ما ليس بجوهر وعرض الجوهر والعرض فكذا صفاته لا تناسب صفات الخلق وهذه الحقائق داخلة في علم المكاشفة ووراء", "english": "وقال صلى الله عليه وسلم: \"لا يلقى الله أحد بذنب أعظم من جهالة أهله.\"", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 296", "section_title_en": "Section 296", "section_index": 296, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Marriage'", "badge": "Insight"}], "3": [{"arabic": "وبقوله تعالى الذي خلق سبع سموات طباقا ما ترى في خلق الرحمن من تفاوت فارجع البصر هل ترى من فطور ثم ارجع البصر كرتين ينقلب إليك البصر خاسئا وهو حسير وهذا الطريق هو الأسهل على الأكثرين وهو الأوسع على السالكين وإليه أكثر دعوة القرآن عند الأمر بالتدبر والتفكر والاعتبار والنظر في آيات خارجة عن الحصر فإن قلت كلا الطريقين مشكل فأوضح لنا منهما ما يستعان به على تحصيل المعرفة والتوصل به إلى المحبة فاعلم أن الطريق الأعلى هو الاستشهاد بالحق سبحانه على سائر الخلق فهو غامض والكلام فيه خارج عن حد فهم أكثر الخلق فلا فائدة في إيراده في الكتب وأما الطريق الأسهل الأدنى فأكثره غير خارج عن حد الأفهام وإنما قصرت ال", "english": "Those who arrive at this rank divide into two groups: the strong, whose first knowledge is of God, exalted be He, and then through Him they come to know other than Him; and the weak, whose first knowledge is of [His] acts, and then they ascend from them to the Agent. To the first points His saying, exalted be He: {أو لم يكف بربك أنه على كل شيء شهيد} [Is it not sufficient concerning your Lord that He is over all things a Witness], and His saying, exalted be He: {«شهد الله أنه لا إله إلا هو»} [God bears witness that there is no god but He]. And of this kind is the saying of one of them, when it was said to him: \"By what have you known your Lord?\" He said: \"I have known my Lord — and were it not for my Lord, I would not have known my Lord.\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1165", "section_title_en": "The Two Paths to Knowledge and Love: The Higher Way of Witnessing the Truth and the Easier Way of Contemplating Creation", "section_index": 1165, "anchors": "- Root: طيب (ṭ-y-b)\n  * Lisan / Ayn: Pure, good, wholesome; free from defilement\n  * Al-Raghib (Mufradat): That which is pure and agreeable in both sensory and intellectual registers; the \"good word\" (al-kalim al-ṭayyib) is the declaration of divine unity\n  * Al-Zamakhshari (Asas): Literal for sensory purity; metaphorical for spiritual purity of heart and speech\n- Root: عرف (ʿ-r-f)\n  * Lisan / Ayn: To know by reflection and discernment of traces/effects\n  * Al-Raghib (Mufradat): Maʿrifah is knowledge of God attained through contemplation of His effects, not through direct apprehension of His essence; it is more specific than ʿilm\n  * Al-Zamakhshari (Asas): Literal: to recognize someone; metaphorical: knowledge of God through His signs\n- Root: شهد (sh-h-d)\n  * Lisan / Ayn: To witness, testify, be present\n  * Al-Raghib (Mufradat): Bearing witness to the truth of something based on direct presence or evidence\n  * Al-Zamakhshari (Asas): Literal: ocular presence; metaphorical: intellectual certitude\n- Root: نظر (n-ẓ-r)\n  * Lisan / Ayn: To look, gaze, contemplate\n  * Al-Raghib (Mufradat): Contemplative reflection (naẓar) directed toward creation to derive knowledge of the Creator\n  * Al-Zamakhshari (Asas): Literal: visual perception; metaphorical: intellectual consideration and inference\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to restrict the purpose of works to purification of the heart, and to restrict the ultimate end to knowledge of unveiling", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "8": [{"arabic": "تعالى كلما ألقى فيها فوج سألهم خزنتها إلى قوله فكذبنا وقلنا ما نزل الله من شيء فقوله {كلما ألقى فيها فوج} عام فينبغي أن يكون من ألقي في النار مكذبا ولقوله تعالى {لا يصلاها إلا الأشقى الذي كذب وتولى} وهذا حصر وإثبات ونفي ولقوله تعالى {من جاء بالحسنة فله خير منها وهم من فزع يومئذ آمنون} فالإيمان رأس الحسنات ولقوله تعالى {والله يحب المحسنين} وقال تعالى {إنا لا نضيع أجر من أحسن عملا} ولا حجة لهم في ذلك فإنه حيث ذكر الإيمان في هذه الآيات أريد به الإيمان مع العمل إذ بينا أن الإيمان قد يطلق ويراد به ا", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}, {"arabic": "للإنسان إلا ما سعى وأن سعيه سوف يرى كلما ألقى فيها فوج سألهم خزنتها ألم يأتكم نذير قالوا بلى قد جاءنا نذير أي ألم نسمعكم سنة الله في عباده وأنه", "english": "I say: God—exalted is He—loves the obedient and hates the disobedient. So just as He does not hate the obedient father because of His hatred for the disobedient son, likewise He does not love the disobedient son because of His love for the obedient father. And if love were to flow from the father to the son, then hatred would likewise be bound to flow. Rather, the truth is: {«ولا تزر وازرة وزر أخرى»} — \"And no bearer of burdens will bear the burden of another\" {Quran 6:164, 17:15, 35:18, 39:7, 53:38}. And whoever supposes that he will be saved by his father's piety is like one who supposes he will be satiated by his father's eating, quenched by his father's drinking, become a scholar by his father's learning, and reach the Ka'bah and see it by his father's walking.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 889", "section_title_en": "The Reality of Hope (Al-Rajā') and the Futility of Reliance on Another's Piety", "section_index": 889, "anchors": "- Root: و ل د (walada)\n  * Lisan / Ayn: Physical begetting and offspring; the father's generative act.\n  * Al-Raghib (Mufradat): \"الولد: المولود\" — offspring as a created entity; here used metaphorically for spiritual causation.\n  * Al-Zamakhshari (Asas): Literal: physical birth. Metaphorical: \"تولدت العصبية\" — something generated or produced from another; Ghazali exploits this to refute the notion that a father's obedience \"generates\" salvation for the son.\n- Root: ر ج و (rajā)\n  * Lisan / Ayn: Expectation, hope, longing for a favorable outcome.\n  * Al-Raghib (Mufradat): Hope tied to legitimate means; not mere wishful thinking (tamannī).\n  * Al-Zamakhshari (Asas): Literal: awaiting rain. Metaphorical: \"رجوت فلانا\" — to expect from someone; Ghazali contrasts true hope (with action) vs. delusion (ghurūr).\n- Root: غ ر ر (gharara)\n  * Lisan / Ayn: Deception, heedlessness, being lured by a false appearance.\n  * Al-Raghib (Mufradat): The state of one who is duped by Satan's plausible speech.\n  * Al-Zamakhshari (Asas): Literal: a risky venture. Metaphorical: \"اغتر بفلان\" — to be deceived by outward charm while the inner reality is corrupt.\n- Root: ك ي س (kays)\n  * Lisan / Ayn: Intelligence, shrewdness, prudence.\n  * Al-Raghib (Mufradat): The wise man who disciplines his soul and acts for the afterlife.\n  * Al-Zamakhshari (Asas): Literal: alertness. Metaphorical: \"الكيس من دان نفسه\" — the prudent one who holds his soul to account; antonym of \"الأحمق\" (the fool).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يوفى الصابرون أجرهم بغير حساب\" style; Ghazali uses \"إنما\" to restrict reward to personal action, and \"ليس للإنسان إلا ما سعى\" as a restrictive negative clause (nafy + illā) to deny any transfer of merit.", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Condemnation of Delusion'", "badge": "Commentary"}], "9": [{"arabic": "تعالى كلما ألقى فيها فوج سألهم خزنتها إلى قوله فكذبنا وقلنا ما نزل الله من شيء فقوله {كلما ألقى فيها فوج} عام فينبغي أن يكون من ألقي في النار مكذبا ولقوله تعالى {لا يصلاها إلا الأشقى الذي كذب وتولى} وهذا حصر وإثبات ونفي ولقوله تعالى {من جاء بالحسنة فله خير منها وهم من فزع يومئذ آمنون} فالإيمان رأس الحسنات ولقوله تعالى {والله يحب المحسنين} وقال تعالى {إنا لا نضيع أجر من أحسن عملا} ولا حجة لهم في ذلك فإنه حيث ذكر الإيمان في هذه الآيات أريد به الإيمان مع العمل إذ بينا أن الإيمان قد يطلق ويراد به الإسلام وهو الموافقة بالقلب والقول والعمل", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "10": [{"arabic": "تكون عبادته أما سمعتم قول الفجار في النار لو كنا نسمع أو نعقل ما كنا في أصحاب السعير (4) وعن عمر رضي الله عنه أنه قال لتميم الداري ما السودد فيكم قال العقل قال صدقت سألت رسول الله صلى الله عليه وسلم كما سألتك فقال كما قلت ثم قال سألت جبريل عليه السلام ما السودد فقال العقل (5) وعن البراء بن عازب رضي الله عنه قال كثرت المسائل يوما على رسول الله صلى الله عليه وسلم فقال يا أيها الناس إن لكل شيء مطية ومطية المرء العقل وأحسنكم دلالة ومعرفة بالحجة أفضلكم عقلا (6) وعن أبي هريرة رضي الله عنه قال لما رجع رسول الله صلى الله عليه وسلم من غزوة", "english": "It is narrated from Anas (may Allah be pleased with him) who said: A group of people praised a man before the Prophet (peace be upon him) until they exaggerated. The Prophet (peace be upon him) said: **\"How is the man's intellect?\"** They said: \"We inform you of his diligence in worship and his various kinds of goodness, yet you ask us about his intellect?\" The Prophet (peace be upon him) said: **\"Indeed, the foolish man attains through his ignorance more corruption than the wickedness of the wicked man attains through his wickedness. And indeed, the servants will be raised on the Day of Resurrection in the degrees of nearness (al-zulfā) to their Lord only according to the measure of their intellects.\"**", "book_title": "Book of Knowledge", "section_title_ar": "Section 66", "section_title_en": "Section 66", "section_index": 66, "anchors": "*(Anchors established)*", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}, {"arabic": "بعد أن سمعتم وعقلتم قالوا لو كنا نسمع أو نعقل ما كنا في أصحاب السعير فاعترفوا بذنبهم فسحقا لأصحاب السعير فإن قلت فأين مظنة الرجاء وموضعه المحمود فاعلم أنه محمود في موضعين أحدهما في حق العاصي المنهمك إذا خطرت له التوبة فقال له الشيطان وأنى تقبل توبتك فيقنطه من رحمة الله تعالى فيجب عند هذا أن يقمع القنوط بالرجاء ويتذكر أن الله يغفر الذنوب جميعا وأن الله كريم يقبل التوبة عن عباده وأن التوبة طاعة تكفر الذنوب قال الله تعالى قل يا عبادي الذين أسرفوا على أنفسهم لا تقنطوا من رحمة الله إن الله يغفر الذنوب جميعا إنه هو الغفور الرحيم وأنيبوا إلى ربكم أمرهم بالإنابة", "english": "Every soul shall taste what it has earned. And {«وَأَنَّ كُلَّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ»} — \"And that every soul is a pledge for what it has earned.\" So what has deluded you concerning God, after you have heard and comprehended? They will say: \"Had we but listened or reasoned, we would not be among the companions of the Blaze.\" Thus they will confess their sin. So away with the companions of the Blaze!", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 890", "section_title_en": "The Anatomy of Hope (Rajā') and Delusion (Ghurūr): A Kalamic Dissection of the Soul's Two States", "section_index": 890, "anchors": "- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which desires proximity and discourse; the locus of breath and life.\n  * Al-Raghib (Mufradat): Nafs denotes the rūḥ (spirit) and, in divine attribution, the very Dhāt (Essence) of God—as in {«وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ»}—entailing no real multiplicity despite grammatical annexation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the living, breathing self; metaphorical (Majaz) usage extends to \"blood\" (nafs sā'ilah) and the \"evil eye\" (nafs as 'ayn). Here, it signifies the moral agent bearing responsibility.\n- Root: توب (Tawb)\n  * Lisan / Ayn: Return, repentance; the act of turning back from error.\n  * Al-Raghib (Mufradat): Tawbah is abandoning the sin in the most excellent manner—the third and highest form of excuse (after denial and pretext). In Sacred Law: forsaking the sin due to its ugliness, remorse for the past, resolve against recurrence, and restitution of what can be restored.\n  * Al-Zamakhshari (Asas): Literal: \"The servant repents to God from his sin; God turns in mercy to the servant.\" The reciprocal dynamic—God's acceptance (tawbah) meeting the servant's return (inābah)—is operative in this text.\n- Root: ذنب (Dhanb)\n  * Lisan / Ayn: The tail of an animal; what trails behind; by extension, a fault or crime as the \"consequence\" one drags after oneself.\n  * Al-Raghib (Mufradat): In origin, \"taking hold of a thing's tail\"—i.e., seizing the outcome. Sin is that which trails the soul and binds it as a pledge (rahīnah).\n  * Al-Zamakhshari (Asas): Metaphorical: \"He is among the tails (adhnāb) of the people\"—the laggards. The sinner is one who follows his lower tail, and the verse {«كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ»} makes the soul a hostage to its own trailing deeds.\n- Root: غفر (Ghafr)\n  * Lisan / Ayn: To cover, shield, or protect; the Ghifār tribe's name; a helmet (mighfar) that shields the head.\n  * Al-Raghib (Mufradat): Ghufrān from God is His shielding the servant from the touch of chastisement—a protective covering, not mere erasure. It may also mean outward forbearance.\n  * Al-Zamakhshari (Asas): Literal: \"O God, forgive (ghufrānan)!\"—a covering over the stain. Metaphorical: Zuhayr's beasts \"did not forgive\" their negligence—i.e., did not shield the offspring from destruction. Hope of forgiveness without repentance is thus not ghufrān but ghurūr (delusion).\n- Sibawayh Rule: باب الفصل بين العامل والمعمول (Interposition between Operator and Operand) — The periodic structure of verses like {«إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا»} delays the predicate to heighten rhetorical impact; the conditional \"if you say... know that\" (fa-in qulta... fa-'lam) governs the entire dialectical sequence, requiring the apodosis to resolve the protasis with logical necessity.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "13": [{"arabic": "والله خلقكم وما تعملون وفي قوله تعالى وأسروا قولكم أو اجهروا به إنه عليم بذات الصدور ألا يعلم من خلق وهو اللطيف الخبير أمر العباد بالتحرز في أقوالهم وأفعالهم وإسرارهم وإضمارهم لعلمه بموارد أفعالهم واستدل على العلم بالخلق وكيف لا يكون خالقا لفعل العبد وقدرته تامة لا قصور فيها وهي متعلقة بحركة أبدان العباد والحركات متماثلة وتعلق القدرة بها لذاتها فما الذي يقصر تعلقها عن بعض الحركات دون البعض مع تماثلها أو كيف يكون الحيوان مستبدا بالاختراع ويصدر من العنكبوت والنحل وسائر الحيوانات من لطائف الصناعات ما يتحير فيه عقول ذوي الألباب فكيف انفردت هي باختراعها دون رب الأرب", "english": "Rather, the attribute of origination (ḥudūth) is established for bodies only by virtue of their being subject to change and the fluctuation of states. So how could their Creator share with them in the acceptance of change? And upon this is built [the doctrine] that His Speech (kalām) is eternal, subsisting in His Essence—only the sounds indicating it are originated. Just as one rationally apprehends the subsistence of a request for learning and the father's will for [his] child in the father's essence before the child is created—such that when the child is created, attains reason, and God creates for him a knowledge pertaining to what is in his father's heart of the request, the child becomes commanded by that very request which subsisted in his father's essence and whose existence endured until the time of his child's awareness of it—so let one rationally apprehend the subsistence of the command indicated by His words, Mighty and Majestic: {«اخلع نعليك»} \"Take off your sandals\" [Q 20:12], in God's Essence, and Moses—peace be upon him—becoming addressed by it after his existence, when God created for him a knowledge of that command and hearing of that eternal Speech.", "book_title": "Foundations of Belief", "section_title_ar": "Section 92", "section_title_en": "The Revival of the Religious Sciences — Section 92: On the Divine Attributes of Eternity, Knowledge, Will, and the Third Pillar Concerning God's Acts", "section_index": 92, "anchors": "- Root: قدم (q-d-m)\n  * Lisan / Ayn: Primordial precedence; that which has no temporal beginning; eternal past (azal) and eternal future (abad).\n  * Al-Raghib (Mufradat): Precedence either by time, by honor, or by ontological necessity—here, God's attributes are eternal in the sense that they are not subject to temporal origination.\n  * Al-Zamakhshari (Asas): Literal: \"to precede.\" Metaphorical: that which cannot be conceived as non-existent posterior to its existence—applied to God's essence and attributes.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Comprehension of a thing as it truly is; the indelible mark or trace by which one is guided.\n  * Al-Raghib (Mufradat): \"Knowledge is the apprehension of a thing in its reality\"—twofold: apprehension of the essence, and judgment concerning existence or non-existence. God's knowledge is eternal, encompassing all created things without renewal.\n  * Al-Zamakhshari (Asas): Literal: perception and awareness. Metaphorical: the \"signs\" (maʿālim) of God's power—His knowledge is identical with His creative act, for \"Does He who created not know?\" {«ألا يعلم من خلق»}.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring, proportioning, then bringing into existence upon a determined measure.\n  * Al-Raghib (Mufradat): Origination from nothing without prior model—\"He created the heavens and the earth\" {«خلق السماوات والأرض»}—and also bringing forth from something, as man from a drop. All acts of creatures are God's creation.\n  * Al-Zamakhshari (Asas): Literal: the tailor's measuring before cutting. Metaphorical: God's bringing forth existence upon a measure dictated by wisdom—He is the sole Creator (al-Khāliq) of all acts, including those of His servants.\n- Root: قتل (q-t-l)\n  * Lisan / Ayn: Removal of the spirit from the body; also, intense subjugation.\n  * Al-Raghib (Mufradat): The root meaning is the separation of soul from body, whether by an agent (qatl) or by natural death (mawt). Used here analogically: as \"killer,\" \"killed,\" and \"killing\" are mutually entailing, so are \"knower,\" \"known,\" and \"knowledge.\"\n  * Al-Zamakhshari (Asas): Literal: slaying. Metaphorical: mutual entailment—just as no killer exists without a killing and a killed one, so no knower exists without knowledge and a known object.\n- Sibawayh Rule: باب التلازم والتضايف (Mutual Entailment and Correlativity) — Terms like ʿālim/ʿilm/maʿlūm are correlatives (mutalāzimāt) that cannot be conceptually separated; the predicate necessitates the co-existence of its correlates in the intellect.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "14": [{"arabic": "شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك إلى الاستدلال بالخلق على العلم بأنك لا تستريب في دلالة الخلق اللطيف والصنع المزين بالترتيب ولو في الشيء الحقير الضعيف على علم الصانع بكيفية الترتيب والترصيف فما ذكره الله سبحانه هو المنتهى في الهداية والتعريف الأصل الثالث العلم بكونه عز وجل حيا فإن من ثبت علمه وقدرته ثبت بالضرورة حياته ولو تصور قادر وعالم فاعل مدبر دون أن يكون حيا لجاز أن يشك في حياة الحيوانات عند ترددها في الحركات والسكنات بل في حياة أرباب الحرف والصناعات وذلك", "english": "**The Eighth Principle: Knowledge that He, Exalted is He, is established upon His Throne (mustawin ʿalā ʿarshihi) in the sense that God, Exalted is He, intended by istiwāʾ — which is the sense that does not contradict the attribute of Majesty, nor does any mark of origination (ḥudūth) or passing away (fanāʾ) attach to it. And it is the sense intended by His saying — istiwāʾ toward the heaven — where He said in the Qur'an: {«ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ وَهِيَ دُخَانٌ»} (\"Then He directed Himself to the heaven, and it was smoke\") [Fussilat 41:11]. And that is only by way of subjugation (qahr) and dominion (istīlāʾ), as the poet said:", "book_title": "Foundations of Belief", "section_title_ar": "Section 90", "section_title_en": "The Revival of the Religious Sciences — Section 90: The Ten Principles Concerning Knowledge of the Divine Attributes", "section_index": 90, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denoting the faculty of perception and comprehension; the mark or trace by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from awareness (shiʿr); here, it denotes certain, verified cognition of theological verities.\n- Root: س و ي (s-w-y)\n  * Lisan / Ayn: Root indicating straightness, equality, and levelness; from it derives istiwāʾ (establishing oneself upon, ascending to).\n  * Al-Raghib (Mufradat): Istiwāʾ upon the Throne (al-ʿArsh) is a divine act of sovereign dominion, not corporeal settlement.\n  * Al-Zamakhshari (Asas): Literal sense of physical sitting is impossible for God; metaphorical sense (majāz) of qahr (overpowering) and istīlāʾ (dominion) is necessitated by reason and consensus.\n- Root: ر أ ي (r-ʾ-y)\n  * Lisan / Ayn: Visual perception; also opinion and discernment.\n  * Al-Raghib (Mufradat): Ruʾyah (vision) of God in the Hereafter is a mode of disclosure (kashf) and knowledge (ʿilm), more complete than intellectual cognition, not conditioned by spatial direction.\n  * Al-Zamakhshari (Asas): Literal vision requires corporeality and direction; its application to God demands theological specification (takhṣīṣ) without nullifying the veracity of the scriptural promise.\n- Root: ق د ر (q-d-r)\n  * Lisan / Ayn: Power, measure, decree; the capacity to bring about an act.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is the negation of incapacity (ʿajz); absolute power belongs to God alone, while creatures possess limited capacity.\n  * Al-Zamakhshari (Asas): Literal power over an object; metaphorically, God's power encompasses all things without exertion or instrument.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, applied here to the parsing of \"إلى السماء\" in the verse on istiwāʾ, where the prepositional phrase is delayed to highlight the divine act of sovereign direction toward the heavens.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}], "15": [{"arabic": "فرشناها فنعم الماهدون وقال تعالى هو الذى جعل لكم الأرض ذلولا فامشوا فى مناكبها وقال تعالى الذى جعل لكم الأرض فراشا وقد أكثر فى كتابه العزيز ممن ذكر الأرض ليتفكر في عجائبها فظهرها مقر للأحياء وبطنها مرقد للأموات قال تعالى ألم نجعل الأرض كفاتا أحياء وأمواتا فانظر إلى الأرض وهى ميتة فإذا أنزل عليها الماء اهتزت وربت واخضرت وأنبتت عجائب النبات وخرجت منها أصناف الحيوانات ثم انظر كيف أحكم جوانب الأرض بالجبال الراسيات الشوامخ الصم الصلاب وكيف أودع المياه تحتها ففجر العيون وأسال الأنهار تجري على وجهها وأخرج من الحجارة اليابسة ومن", "english": "For the beast has no power over that; but as for man, God created for him the power, then he disabled it and disbelieved in God's grace therein. So those are like cattle — nay, they are even further astray from the way {فَأُولَٰئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ سَبِيلًا}.", "book_title": "Contemplation", "section_title_ar": "Section 1273", "section_title_en": "On Contemplating the Earth, Its Rivers, Mountains, and Minerals — Section 1273", "section_index": 1273, "anchors": "- Root: فكر (f-k-r)\n  * Lisan / Ayn: التفكر: تأمل القلب وتدبر الشيء، والفكر: إعمال النظر في الشيء\n  * Al-Raghib (Mufradat): الفكر: قوة العلم التي بها يدرك الإنسان، وقيل: هو ترتيب أمور معلومة للتأدي إلى مجهول\n  * Al-Zamakhshari (Asas): الفكر: تصرف القلب في النظر — literal: إعمال الروية؛ metaphorical: التفكر في ملكوت الله\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: التي عليها الناس، وجمعها أرضون\n  * Al-Raghib (Mufradat): الأرض: الجرم المقابل للسماء، ويعبر بها عن أسفل الشيء\n  * Al-Zamakhshari (Asas): literal: الأرض المهاد والفراش؛ metaphorical: تذلل الأرض وسكونها\n- Root: دحا (d-ḥ-w) / مهد (m-h-d)\n  * Lisan / Ayn: مهد: وطأ المكان وهيأه، والمهاد: الفراش الموطأ\n  * Al-Raghib (Mufradat): المهد: الموضع المهيأ للصبي، والمهاد: الأرض الموطأة\n  * Al-Zamakhshari (Asas): literal: فرش الأرض وتمهيدها؛ metaphorical: جعلها قارة ساكنة لا تميد\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — the interposed clause \"فانظر\" after \"إلى الأرض\" maintains grammatical continuity while allowing rhetorical pause.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "22": [{"arabic": "الفريقين الإشارة بقوله تعالى {أفمن يمشي مكبا على وجهه أهدى أم من يمشي سويا على صراط مستقيم} فإن الكفار لم يغلطوا فيما غلطوا فيه إلا بمثل هذه الانعكاسات نسأل الله حسن التوفيق بكرمه ولطفه بيان أقسام الصبر بحسب اختلاف القوة والضعف اعلم إن باعث الدين بالإضافة إلى باعث الهوى له ثلاثة أحوال أحدها أن يقهر داعي الهوى فلا تبقى له قوة المنازعة ويتوصل إليه بدوام الصبر وعند هذا يقال من صبر ظفر والواصلون إلى هذه الرتبة هم الأقلون فلا جرم هم الصديقون المقربون {الذين قالوا ربنا الله ثم استقاموا} فهؤلاء لازموا الطريق المستقيم واستووا على الصراط", "english": "Thus most of the moral traits of faith (akhlāq al-īmān) are subsumed under patience. For this reason, when the Prophet — peace be upon him — was once asked about faith, he said: \"It is patience\" — because it is the most abundant and most precious of its works, just as he said: \"The Pilgrimage is ʿArafah.\" And God — exalted be He — has gathered together all of these divisions and called the whole of them \"patience,\" saying — exalted be He: {And the patient in adversity (al-ba'sā') — i.e., calamity — and in hardship (al-ḍarrā') — i.e., poverty — and at the time of peril (ḥīna al-ba's) — i.e., warfare — {those are the ones who have been truthful, and those are the ones who are God-fearing} «أولئك الذين صدقوا وأولئك هم المتقون». So these, then, are the divisions of patience according to the difference of its objects of relation (mutaʿallaqātihā).", "book_title": "Patience and Gratitude", "section_title_ar": "Section 960", "section_title_en": "The Names That Accrue to Patience (Ṣabr) in Relation to Its Object, and the Divisions of Patience According to Strength and Weakness", "section_index": 960, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core sense of \"holding back\" or \"restraining\" (al-imsāk), as in holding a beast without fodder or confining someone; endurance of hardship.\n  * Al-Raghib (Mufradat): \"Patience is the restraint of the self (ḥabs al-nafs) upon what reason and Law require, or from what they require it to abstain.\" It is a generic term (laẓf ʿāmm) whose specific names vary by context: in calamity it is \"patience\" (ṣabr) against \"panic\" (jazaʿ); in battle, \"courage\" (shajāʿah) against \"cowardice\" (jubn); in affliction, \"breadth of breast\" (saʿat al-ṣadr) against \"vexation\" (ḍajar).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"I bore patiently what I dislike, and I held back from what I love.\" Metaphorical (majāz): \"His hand does not endure the cold\" — i.e., is not patient against it; \"he is more patient of beating than the ground.\"\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self or soul; that which is breathed; also blood (nafs sā'ilah).\n  * Al-Raghib (Mufradat): \"Al-Nafs: the spirit (al-rūḥ)… and in God's saying {He warns you of Himself} (nafsihi) it denotes His very essence (dhāt).\"\n  * Al-Zamakhshari (Asas): Literal: \"a precious thing (nafīs)\"; Metaphorical: \"he poured out his nafs (i.e., his blood).\"\n- Root: ضرب (Ḍ-R-B)\n  * Al-Raghib (Mufradat): Used for striking and for coercion; also for \"types\" or \"kinds\" (ḍarb min kadhā) — as in the section heading \"two types\" (ḍarbān).\n  * Al-Zamakhshari (Asas): Literal: \"he struck him with the sword\"; Metaphorical: \"he struck his hand\" (i.e., prevented him from an affair); \"the vicissitudes of time struck them.\"\n- Sibawayh Rule: Interposition and Specification (Bāb al-Faṣl bayn al-Jār wa-al-Majrūr) — The syntactic structure \"bi-al-iḍāfah ilā mā ʿanhu al-ṣabr\" (in relation to that from which one exercises patience) shows how prepositional phrases govern semantic specification, distinguishing the act of patience from its object (al-mutaʿallaq).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "25": [{"arabic": "على الكافرين غير يسير} وقال تعالى {ويقولون متى هذا الوعد إن كنتم صادقين ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون ونفخ في الصور فإذا هم من الأجداث إلى ربهم ينسلون قالوا يا ويلنا من بعثنا من مرقدنا هذا ما وعد الرحمن وصدق المرسلون} فلو لم يكن بين يدي الموتى إلا هول تلك النفخة لكان ذلك جديرا بأن يتقى فإنها نفخة وصيحة يصعق بها من في السموات والأرض يعنى يموتون بها إلا من شاء الله وهو بعض الملائكة ولذلك قال رسول الله صلى الله عليه وسلم كيف أنعم وصاحب الصور قد التقم القرن وحنى الجبهة", "english": "The Prophet (peace and blessings be upon him) said: Allah the Exalted said: \"The son of Adam has reviled Me, and he had no right to revile Me; and he has denied Me, and he had no right to deny Me. As for his reviling of Me, it is his saying that I have a son. And as for his denial of Me, it is his saying: 'He will never bring me back as He created me at first.'\" {«شتمني ابن آدم وما ينبغي له أن يشتمني وكذبني وما ينبغي له أن يكذبني...»}", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1335", "section_title_en": "On the Terrors of the Trumpet-Blast and the Awakening for the Resurrection", "section_index": 1335, "anchors": "- Root: نفخ (N-F-Kh)\n  * Lisan / Ayn: To blow into a thing, to inflate; the breath of wind entering a vessel or body.\n  * Al-Raghib (Mufradat): The divine act of breathing spirit into creation {«ونفخت فيه من روحي»}; here, the eschatological blast that annihilates and then revives all beings.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage of blowing into the Trumpet (الصور); metaphorical extension to the \"blast of spring\" reviving the earth—here applied to the two cosmic blasts of death and resurrection.\n- Root: صور (S-W-R)\n  * Lisan / Ayn: Form, image, shape; also a horn or trumpet (the instrument of the blast).\n  * Al-Raghib (Mufradat): The perceptible form of bodies and the intelligible form of souls; here, the Trumpet (الصور) as the instrument of divine command that re-forms and re-shapes creation.\n  * Al-Zamakhshari (Asas): Literal: the horn (القرن) held by Israfil; metaphorical: the \"inclination\" (صورة) of hearts toward terror and anticipation.\n- Root: موت (M-W-T)\n  * Lisan / Ayn: Death as the cessation of life; the state of the corpse.\n  * Al-Raghib (Mufradat): Death as the separation of the soul from the body; the \"first death\" of the blast and the \"second death\" of the wicked.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: the \"death\" of the heart through heedlessness, and the reviving of dead lands by rain—here, the reviving of bodies by the second blast.\n- Root: قبر (Q-B-R)\n  * Lisan / Ayn: The grave as the abode of the dead; burial.\n  * Al-Raghib (Mufradat): The grave as the intermediate state (barzakh) before resurrection; {«حتى زرتم المقابر»} as a metaphor for death.\n  * Al-Zamakhshari (Asas): Literal: the grave and its inhabitants; metaphorical: the \"raising of the nose\" (قبراه) of the proud—contrasted here with the humility of the dead rising from their graves.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that true faith is not mere verbal assent but heartfelt conviction, as in \"إنما فتور البواطن... لقلة الفهم\" (The languor of the inner selves is only due to the lack of understanding).", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}]}, "wordTiming": {"minshawi": {"1": [[1, 450, 1433], [2, 1433, 2416], [3, 2416, 3502], [4, 3502, 4393], [5, 4393, 5561], [6, 5561, 6612], [7, 6612, 7175], [8, 7175, 7912], [9, 7912, 9060]], "67:1": [[1, 450, 1433], [2, 1433, 2416], [3, 2416, 3502], [4, 3502, 4393], [5, 4393, 5561], [6, 5561, 6612], [7, 6612, 7175], [8, 7175, 7912], [9, 7912, 9060]], "2": [[1, 620, 1426], [2, 1426, 1989], [3, 1989, 2821], [4, 2821, 4657], [5, 4657, 6354], [6, 6354, 7597], [7, 7597, 8336], [8, 8336, 9336], [9, 9336, 10294], [10, 10294, 11470], [11, 11470, 12630]], "67:2": [[1, 620, 1426], [2, 1426, 1989], [3, 1989, 2821], [4, 2821, 4657], [5, 4657, 6354], [6, 6354, 7597], [7, 7597, 8336], [8, 8336, 9336], [9, 9336, 10294], [10, 10294, 11470], [11, 11470, 12630]], "3": [[1, 700, 1749], [2, 1749, 2481], [3, 2481, 3278], [4, 3278, 4759], [5, 4759, 6692], [6, 6692, 7762], [7, 7762, 8828], [8, 8828, 9396], [9, 9396, 10128], [10, 10128, 11657], [11, 11657, 12094], [12, 12094, 13448], [13, 13448, 14453], [14, 14453, 15458], [15, 15458, 15873], [16, 15873, 16939], [17, 16939, 17376], [18, 17376, 18610]], "67:3": [[1, 700, 1749], [2, 1749, 2481], [3, 2481, 3278], [4, 3278, 4759], [5, 4759, 6692], [6, 6692, 7762], [7, 7762, 8828], [8, 8828, 9396], [9, 9396, 1012