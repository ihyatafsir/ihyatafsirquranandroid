{"surah": 67, "verses": [{"ayah": 1, "text": "تَبَٰرَكَ ٱلَّذِى بِيَدِهِ ٱلْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Blessed is He in whose hand is dominion, and He is over all things competent -", "words": [{"id": 1, "arabic": "تَبَٰرَكَ", "translit": "َkَrَٰbَt", "root": "برك"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "بِيَدِهِ", "translit": "ِhِdَyِb", "root": "يدي"}, {"id": 4, "arabic": "ٱلْمُلْكُ", "translit": "ُkْlُmْlٱ", "root": "ملك"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 2, "text": "ٱلَّذِى خَلَقَ ٱلْمَوْتَ وَٱلْحَيَوٰةَ لِيَبْلُوَكُمْ أَيُّكُمْ أَحْسَنُ عَمَلًاۚ وَهُوَ ٱلْعَزِيزُ ٱلْغَفُورُ ", "translation": "[He] who created death and life to test you [as to] which of you is best in deed - and He is the Exalted in Might, the Forgiving -", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلْمَوْتَ", "translit": "َtْwَmْlٱ", "root": "موت"}, {"id": 4, "arabic": "وَٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱَw", "root": "حيي"}, {"id": 5, "arabic": "لِيَبْلُوَكُمْ", "translit": "ْmُkَwُlْbَyِl", "root": "بلو"}, {"id": 6, "arabic": "أَيُّكُمْ", "translit": "ْmُkُّyَaʾ", "root": "ايي"}, {"id": 7, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 8, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 11, "arabic": "ٱلْغَفُورُ", "translit": "ُrwُfَغْlٱ", "root": "غفر"}], "hasIhya": true}, {"ayah": 3, "text": "ٱلَّذِى خَلَقَ سَبْعَ سَمَٰوَٰتٍ طِبَاقًاۖ مَّا تَرَىٰ فِى خَلْقِ ٱلرَّحْمَٰنِ مِن تَفَٰوُتٍۖ فَٱرْجِعِ ٱلْبَصَرَ هَلْ تَرَىٰ مِن فُطُورٍ ", "translation": "[And] who created seven heavens in layers.[1] You do not see in the creation of the Most Merciful any inconsistency. So return [your] vision [to the sky]; do you see any breaks?", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "سَبْعَ", "translit": "َʿعْbَs", "root": "سبع"}, {"id": 4, "arabic": "سَمَٰوَٰتٍ", "translit": "ٍtَٰwَٰmَs", "root": "سمو"}, {"id": 5, "arabic": "طِبَاقًا", "translit": "āًqāَbِṭ", "root": "طبق"}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "تَرَىٰ", "translit": "ٰàَrَt", "root": "راي"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "خَلْقِ", "translit": "ِqْlَhk", "root": "خلق"}, {"id": 10, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "تَفَٰوُتٍ", "translit": "ٍtُwَٰfَt", "root": "فوت"}, {"id": 13, "arabic": "فَٱرْجِعِ", "translit": "ِʿعِjgْrٱَf", "root": "رجع"}, {"id": 14, "arabic": "ٱلْبَصَرَ", "translit": "َrَṣَbْlٱ", "root": "بصر"}, {"id": 15, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 16, "arabic": "تَرَىٰ", "translit": "ٰàَrَt", "root": "راي"}, {"id": 17, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 18, "arabic": "فُطُورٍ", "translit": "ٍrwُṭُf", "root": "فطر"}], "hasIhya": true}, {"ayah": 4, "text": "ثُمَّ ٱرْجِعِ ٱلْبَصَرَ كَرَّتَيْنِ يَنقَلِبْ إِلَيْكَ ٱلْبَصَرُ خَاسِئًا وَهُوَ حَسِيرٌ ", "translation": "Then return [your] vision twice again.[1] [Your] vision will return to you humbled while it is fatigued.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "ٱرْجِعِ", "translit": "ِʿعِjgْrٱ", "root": "رجع"}, {"id": 3, "arabic": "ٱلْبَصَرَ", "translit": "َrَṣَbْlٱ", "root": "بصر"}, {"id": 4, "arabic": "كَرَّتَيْنِ", "translit": "ِnْyَtَّrَk", "root": "كرر"}, {"id": 5, "arabic": "يَنقَلِبْ", "translit": "ْbِlَqnَy", "root": "قلب"}, {"id": 6, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلْبَصَرُ", "translit": "ُrَṣَbْlٱ", "root": "بصر"}, {"id": 8, "arabic": "خَاسِئًا", "translit": "āًyʾِsāَhk", "root": "خسا"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "حَسِيرٌ", "translit": "ٌryِsَḥ", "root": "حسر"}], "hasIhya": false}, {"ayah": 5, "text": "وَلَقَدْ زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَٰبِيحَ وَجَعَلْنَٰهَا رُجُومًا لِّلشَّيَٰطِينِۖ وَأَعْتَدْنَا لَهُمْ عَذَابَ ٱلسَّعِيرِ ", "translation": "And We have certainly beautified the nearest heaven with lamps [i.e., stars] and have made [from] them what is thrown at the devils[1] and have prepared for them the punishment of the Blaze.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "زَيَّنَّا", "translit": "āَّnَّyَz", "root": "زين"}, {"id": 3, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 5, "arabic": "بِمَصَٰبِيحَ", "translit": "َḥyِbَٰṣَmِb", "root": "صبح"}, {"id": 6, "arabic": "وَجَعَلْنَٰهَا", "translit": "āَhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 7, "arabic": "رُجُومًا", "translit": "āًmwُjgُr", "root": "رجم"}, {"id": 8, "arabic": "لِّلشَّيَٰطِينِ", "translit": "ِnyِṭَٰyَّhslِّl", "root": "شطن"}, {"id": 9, "arabic": "وَأَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾَw", "root": "عتد"}, {"id": 10, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 11, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": false}, {"ayah": 6, "text": "وَلِلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ عَذَابُ جَهَنَّمَۖ وَبِئْسَ ٱلْمَصِيرُ ", "translation": "And for those who disbelieved in their Lord is the punishment of Hell, and wretched is the destination.", "words": [{"id": 1, "arabic": "وَلِلَّذِينَ", "translit": "َnyِhdَّlِlَw", "root": ""}, {"id": 2, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 3, "arabic": "بِرَبِّهِمْ", "translit": "ْmِhِّbَrِb", "root": "ربب"}, {"id": 4, "arabic": "عَذَابُ", "translit": "ُbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 6, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 7, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": false}, {"ayah": 7, "text": "إِذَآ أُلْقُوا۟ فِيهَا سَمِعُوا۟ لَهَا شَهِيقًا وَهِىَ تَفُورُ ", "translation": "When they are thrown into it, they hear from it a [dreadful] inhaling while it boils up.", "words": [{"id": 1, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 2, "arabic": "أُلْقُوا۟", "translit": "۟āwُqْlُaʾ", "root": "لقي"}, {"id": 3, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 4, "arabic": "سَمِعُوا۟", "translit": "۟āwُʿعِmَs", "root": "سمع"}, {"id": 5, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 6, "arabic": "شَهِيقًا", "translit": "āًqyِhَhs", "root": "شهق"}, {"id": 7, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 8, "arabic": "تَفُورُ", "translit": "ُrwُfَt", "root": "فور"}], "hasIhya": false}, {"ayah": 8, "text": "تَكَادُ تَمَيَّزُ مِنَ ٱلْغَيْظِۖ كُلَّمَآ أُلْقِىَ فِيهَا فَوْجٌ سَأَلَهُمْ خَزَنَتُهَآ أَلَمْ يَأْتِكُمْ نَذِيرٌ ", "translation": "It almost bursts with rage. Every time a company is thrown into it, its keepers ask them, \"Did there not come to you a warner?\"", "words": [{"id": 1, "arabic": "تَكَادُ", "translit": "ُdāَkَt", "root": "كود"}, {"id": 2, "arabic": "تَمَيَّزُ", "translit": "ُzَّyَmَt", "root": "ميز"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْغَيْظِ", "translit": "ِẓْyَغْlٱ", "root": "غيظ"}, {"id": 5, "arabic": "كُلَّمَآ", "translit": "ٓāَmَّlُk", "root": "كلل"}, {"id": 6, "arabic": "أُلْقِىَ", "translit": "َàِqْlُaʾ", "root": "لقي"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "فَوْجٌ", "translit": "ٌjgْwَf", "root": "فوج"}, {"id": 9, "arabic": "سَأَلَهُمْ", "translit": "ْmُhَlَaʾَs", "root": "سال"}, {"id": 10, "arabic": "خَزَنَتُهَآ", "translit": "ٓāَhُtَnَzَhk", "root": "خزن"}, {"id": 11, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 12, "arabic": "يَأْتِكُمْ", "translit": "ْmُkِtْaʾَy", "root": "اتي"}, {"id": 13, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}], "hasIhya": true}, {"ayah": 9, "text": "قَالُوا۟ بَلَىٰ قَدْ جَآءَنَا نَذِيرٌ فَكَذَّبْنَا وَقُلْنَا مَا نَزَّلَ ٱللَّهُ مِن شَىْءٍ إِنْ أَنتُمْ إِلَّا فِى ضَلَٰلٍ كَبِيرٍ ", "translation": "They will say, \"Yes, a warner had come to us, but we denied and said, 'Allāh has not sent down anything. You are not but in great error.'\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "جَآءَنَا", "translit": "āَnَءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 6, "arabic": "فَكَذَّبْنَا", "translit": "āَnْbَّhdَkَf", "root": "كذب"}, {"id": 7, "arabic": "وَقُلْنَا", "translit": "āَnْlُqَw", "root": "قول"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 14, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 18, "arabic": "كَبِيرٍ", "translit": "ٍryِbَk", "root": "كبر"}], "hasIhya": true}, {"ayah": 10, "text": "وَقَالُوا۟ لَوْ كُنَّا نَسْمَعُ أَوْ نَعْقِلُ مَا كُنَّا فِىٓ أَصْحَٰبِ ٱلسَّعِيرِ ", "translation": "And they will say, \"If only we had been listening or reasoning, we would not be among the companions of the Blaze.\"", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 3, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 4, "arabic": "نَسْمَعُ", "translit": "ُʿعَmْsَn", "root": "سمع"}, {"id": 5, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 6, "arabic": "نَعْقِلُ", "translit": "ُlِqْʿعَn", "root": "عقل"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 9, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 10, "arabic": "أَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 11, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": true}, {"ayah": 11, "text": "فَٱعْتَرَفُوا۟ بِذَنۢبِهِمْ فَسُحْقًا لِّأَصْحَٰبِ ٱلسَّعِيرِ ", "translation": "And they will admit their sin, so [it is] alienation[1] for the companions of the Blaze.", "words": [{"id": 1, "arabic": "فَٱعْتَرَفُوا۟", "translit": "۟āwُfَrَtْʿعٱَf", "root": "عرف"}, {"id": 2, "arabic": "بِذَنۢبِهِمْ", "translit": "ْmِhِbۢnَhdِb", "root": "ذنب"}, {"id": 3, "arabic": "فَسُحْقًا", "translit": "āًqْḥُsَf", "root": "سحق"}, {"id": 4, "arabic": "لِّأَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾِّl", "root": "صحب"}, {"id": 5, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": false}, {"ayah": 12, "text": "إِنَّ ٱلَّذِينَ يَخْشَوْنَ رَبَّهُم بِٱلْغَيْبِ لَهُم مَّغْفِرَةٌ وَأَجْرٌ كَبِيرٌ ", "translation": "Indeed, those who fear their Lord unseen will have forgiveness and great reward.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَخْشَوْنَ", "translit": "َnْwَhsْhkَy", "root": "خشي"}, {"id": 4, "arabic": "رَبَّهُم", "translit": "mُhَّbَr", "root": "ربب"}, {"id": 5, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 6, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 7, "arabic": "مَّغْفِرَةٌ", "translit": "ٌẗَrِfْغَّm", "root": "غفر"}, {"id": 8, "arabic": "وَأَجْرٌ", "translit": "ٌrْjgَaʾَw", "root": "اجر"}, {"id": 9, "arabic": "كَبِيرٌ", "translit": "ٌryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 13, "text": "وَأَسِرُّوا۟ قَوْلَكُمْ أَوِ ٱجْهَرُوا۟ بِهِۦٓۖ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ", "translation": "And conceal your speech or publicize it; indeed, He is Knowing of that within the breasts.", "words": [{"id": 1, "arabic": "وَأَسِرُّوا۟", "translit": "۟āwُّrِsَaʾَw", "root": "سرر"}, {"id": 2, "arabic": "قَوْلَكُمْ", "translit": "ْmُkَlْwَq", "root": "قول"}, {"id": 3, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 4, "arabic": "ٱجْهَرُوا۟", "translit": "۟āwُrَhْjgٱ", "root": "جهر"}, {"id": 5, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 6, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 7, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 8, "arabic": "بِذَاتِ", "translit": "ِtāَhdِb", "root": ""}, {"id": 9, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": true}, {"ayah": 14, "text": "أَلَا يَعْلَمُ مَنْ خَلَقَ وَهُوَ ٱللَّطِيفُ ٱلْخَبِيرُ ", "translation": "Does He who created not know,[1] while He is the Subtle, the Aware?", "words": [{"id": 1, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 4, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "ٱللَّطِيفُ", "translit": "ُfyِṭَّllٱ", "root": "لطف"}, {"id": 7, "arabic": "ٱلْخَبِيرُ", "translit": "ُryِbَhkْlٱ", "root": "خبر"}], "hasIhya": true}, {"ayah": 15, "text": "هُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ ذَلُولًا فَٱمْشُوا۟ فِى مَنَاكِبِهَا وَكُلُوا۟ مِن رِّزْقِهِۦۖ وَإِلَيْهِ ٱلنُّشُورُ ", "translation": "It is He who made the earth tame[1] for you - so walk among its slopes and eat of His provision - and to Him is the resurrection.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "ذَلُولًا", "translit": "āًlwُlَhd", "root": "ذلل"}, {"id": 7, "arabic": "فَٱمْشُوا۟", "translit": "۟āwُhsْmٱَf", "root": "مشي"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "مَنَاكِبِهَا", "translit": "āَhِbِkāَnَm", "root": "نكب"}, {"id": 10, "arabic": "وَكُلُوا۟", "translit": "۟āwُlُkَw", "root": "اكل"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "رِّزْقِهِۦ", "translit": "ۦِhِqْzِّr", "root": "رزق"}, {"id": 13, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 14, "arabic": "ٱلنُّشُورُ", "translit": "ُrwُhsُّnlٱ", "root": "نشر"}], "hasIhya": true}, {"ayah": 16, "text": "ءَأَمِنتُم مَّن فِى ٱلسَّمَآءِ أَن يَخْسِفَ بِكُمُ ٱلْأَرْضَ فَإِذَا هِىَ تَمُورُ ", "translation": "Do you feel secure that He who is above[1] would not cause the earth to swallow you and suddenly it would sway?[2]", "words": [{"id": 1, "arabic": "ءَأَمِنتُم", "translit": "mُtnِmَaʾَء", "root": "امن"}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يَخْسِفَ", "translit": "َfِsْhkَy", "root": "خسف"}, {"id": 7, "arabic": "بِكُمُ", "translit": "ُmُkِb", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 10, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 11, "arabic": "تَمُورُ", "translit": "ُrwُmَt", "root": "مور"}], "hasIhya": false}, {"ayah": 17, "text": "أَمْ أَمِنتُم مَّن فِى ٱلسَّمَآءِ أَن يُرْسِلَ عَلَيْكُمْ حَاصِبًاۖ فَسَتَعْلَمُونَ كَيْفَ نَذِيرِ ", "translation": "Or do you feel secure that He who is above would not send against you a storm of stones? Then you would know how [severe] was My warning.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "أَمِنتُم", "translit": "mُtnِmَaʾ", "root": "امن"}, {"id": 3, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "يُرْسِلَ", "translit": "َlِsْrُy", "root": "رسل"}, {"id": 8, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 9, "arabic": "حَاصِبًا", "translit": "āًbِṣāَḥ", "root": "حصب"}, {"id": 10, "arabic": "فَسَتَعْلَمُونَ", "translit": "َnwُmَlْʿعَtَsَf", "root": "علم"}, {"id": 11, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 12, "arabic": "نَذِيرِ", "translit": "ِryِhdَn", "root": "نذر"}], "hasIhya": false}, {"ayah": 18, "text": "وَلَقَدْ كَذَّبَ ٱلَّذِينَ مِن قَبْلِهِمْ فَكَيْفَ كَانَ نَكِيرِ ", "translation": "And already had those before them denied, and how [terrible] was My reproach.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "نَكِيرِ", "translit": "ِryِkَn", "root": "نكر"}], "hasIhya": false}, {"ayah": 19, "text": "أَوَلَمْ يَرَوْا۟ إِلَى ٱلطَّيْرِ فَوْقَهُمْ صَٰٓفَّٰتٍ وَيَقْبِضْنَۚ مَا يُمْسِكُهُنَّ إِلَّا ٱلرَّحْمَٰنُۚ إِنَّهُۥ بِكُلِّ شَىْءٍۭ بَصِيرٌ ", "translation": "Do they not see the birds above them with wings outspread and [sometimes] folded in? None holds them [aloft] except the Most Merciful. Indeed He is, of all things, Seeing.", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلطَّيْرِ", "translit": "ِrْyَّṭlٱ", "root": "طير"}, {"id": 5, "arabic": "فَوْقَهُمْ", "translit": "ْmُhَqْwَf", "root": "فوق"}, {"id": 6, "arabic": "صَٰٓفَّٰتٍ", "translit": "ٍtَّٰfَٰٓṣ", "root": "صفف"}, {"id": 7, "arabic": "وَيَقْبِضْنَ", "translit": "َnْḍِbْqَyَw", "root": "قبض"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "يُمْسِكُهُنَّ", "translit": "َّnُhُkِsْmُy", "root": "مسك"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 12, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 14, "arabic": "شَىْءٍۭ", "translit": "ٍۭءْàَhs", "root": "شيا"}, {"id": 15, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 20, "text": "أَمَّنْ هَٰذَا ٱلَّذِى هُوَ جُندٌ لَّكُمْ يَنصُرُكُم مِّن دُونِ ٱلرَّحْمَٰنِۚ إِنِ ٱلْكَٰفِرُونَ إِلَّا فِى غُرُورٍ ", "translation": "Or who is it that could be an army for you to aid you other than the Most Merciful? The disbelievers are not but in delusion.", "words": [{"id": 1, "arabic": "أَمَّنْ", "translit": "ْnَّmَaʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 5, "arabic": "جُندٌ", "translit": "ٌdnُjg", "root": "جند"}, {"id": 6, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 7, "arabic": "يَنصُرُكُم", "translit": "mُkُrُṣnَy", "root": "نصر"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 10, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 11, "arabic": "إِنِ", "translit": "ِnِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}, {"id": 13, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "غُرُورٍ", "translit": "ٍrwُrُغ", "root": "غرر"}], "hasIhya": false}, {"ayah": 21, "text": "أَمَّنْ هَٰذَا ٱلَّذِى يَرْزُقُكُمْ إِنْ أَمْسَكَ رِزْقَهُۥۚ بَل لَّجُّوا۟ فِى عُتُوٍّ وَنُفُورٍ ", "translation": "Or who is it that could provide for you if He withheld His provision? But they have persisted in insolence and aversion.", "words": [{"id": 1, "arabic": "أَمَّنْ", "translit": "ْnَّmَaʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَرْزُقُكُمْ", "translit": "ْmُkُqُzْrَy", "root": "رزق"}, {"id": 5, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 6, "arabic": "أَمْسَكَ", "translit": "َkَsْmَaʾ", "root": "مسك"}, {"id": 7, "arabic": "رِزْقَهُۥ", "translit": "ۥُhَqْzِr", "root": "رزق"}, {"id": 8, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 9, "arabic": "لَّجُّوا۟", "translit": "۟āwُّjgَّl", "root": "لجج"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "عُتُوٍّ", "translit": "ٍّwُtُʿع", "root": "عتو"}, {"id": 12, "arabic": "وَنُفُورٍ", "translit": "ٍrwُfُnَw", "root": "نفر"}], "hasIhya": false}, {"ayah": 22, "text": "أَفَمَن يَمْشِى مُكِبًّا عَلَىٰ وَجْهِهِۦٓ أَهْدَىٰٓ أَمَّن يَمْشِى سَوِيًّا عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "Then is one who walks fallen on his face better guided or one who walks erect on a straight path?", "words": [{"id": 1, "arabic": "أَفَمَن", "translit": "nَmَfَaʾ", "root": ""}, {"id": 2, "arabic": "يَمْشِى", "translit": "àِhsْmَy", "root": "مشي"}, {"id": 3, "arabic": "مُكِبًّا", "translit": "āًّbِkُm", "root": "كبب"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "وَجْهِهِۦٓ", "translit": "ٓۦِhِhْjgَw", "root": "وجه"}, {"id": 6, "arabic": "أَهْدَىٰٓ", "translit": "ٰٓàَdْhَaʾ", "root": "هدي"}, {"id": 7, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 8, "arabic": "يَمْشِى", "translit": "àِhsْmَy", "root": "مشي"}, {"id": 9, "arabic": "سَوِيًّا", "translit": "āًّyِwَs", "root": "سوي"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 12, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": true}, {"ayah": 23, "text": "قُلْ هُوَ ٱلَّذِىٓ أَنشَأَكُمْ وَجَعَلَ لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَٰرَ وَٱلْأَفْـِٔدَةَۖ قَلِيلًا مَّا تَشْكُرُونَ ", "translation": "Say, \"It is He who has produced you and made for you hearing and vision and hearts [i.e., intellect]; little are you grateful.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أَنشَأَكُمْ", "translit": "ْmُkَaʾَhsnَaʾ", "root": "نشا"}, {"id": 5, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 7, "arabic": "ٱلسَّمْعَ", "translit": "َʿعْmَّslٱ", "root": "سمع"}, {"id": 8, "arabic": "وَٱلْأَبْصَٰرَ", "translit": "َrَٰṣْbَaʾْlٱَw", "root": "بصر"}, {"id": 9, "arabic": "وَٱلْأَفْـِٔدَةَ", "translit": "َẗَdِٔـْfَaʾْlٱَw", "root": "فاد"}, {"id": 10, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 11, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 12, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 24, "text": "قُلْ هُوَ ٱلَّذِى ذَرَأَكُمْ فِى ٱلْأَرْضِ وَإِلَيْهِ تُحْشَرُونَ ", "translation": "Say, \"It is He who has multiplied you throughout the earth, and to Him you will be gathered.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ذَرَأَكُمْ", "translit": "ْmُkَaʾَrَhd", "root": "ذرا"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 8, "arabic": "تُحْشَرُونَ", "translit": "َnwُrَhsْḥُt", "root": "حشر"}], "hasIhya": false}, {"ayah": 25, "text": "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"When is this promise, if you should be truthful?\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْوَعْدُ", "translit": "ُdْʿعَwْlٱ", "root": "وعد"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 26, "text": "قُلْ إِنَّمَا ٱلْعِلْمُ عِندَ ٱللَّهِ وَإِنَّمَآ أَنَا۠ نَذِيرٌ مُّبِينٌ ", "translation": "Say, \"The knowledge is only with Allāh, and I am only a clear warner.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلْعِلْمُ", "translit": "ُmْlِʿعْlٱ", "root": "علم"}, {"id": 4, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَإِنَّمَآ", "translit": "ٓāَmَّnِiʾَw", "root": ""}, {"id": 7, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 8, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 9, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 27, "text": "فَلَمَّا رَأَوْهُ زُلْفَةً سِيٓـَٔتْ وُجُوهُ ٱلَّذِينَ كَفَرُوا۟ وَقِيلَ هَٰذَا ٱلَّذِى كُنتُم بِهِۦ تَدَّعُونَ ", "translation": "But when they see it[1] approaching, the faces of those who disbelieve will be distressed, and it will be said, \"This is that for which you used to call.\"[2]", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "رَأَوْهُ", "translit": "ُhْwَaʾَr", "root": "راي"}, {"id": 3, "arabic": "زُلْفَةً", "translit": "ًẗَfْlُz", "root": "زلف"}, {"id": 4, "arabic": "سِيٓـَٔتْ", "translit": "ْtَٔـٓyِs", "root": "سوا"}, {"id": 5, "arabic": "وُجُوهُ", "translit": "ُhwُjgُw", "root": "وجه"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 8, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 9, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 10, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "تَدَّعُونَ", "translit": "َnwُʿعَّdَt", "root": "دعو"}], "hasIhya": false}, {"ayah": 28, "text": "قُلْ أَرَءَيْتُمْ إِنْ أَهْلَكَنِىَ ٱللَّهُ وَمَن مَّعِىَ أَوْ رَحِمَنَا فَمَن يُجِيرُ ٱلْكَٰفِرِينَ مِنْ عَذَابٍ أَلِيمٍ ", "translation": "Say, [O Muḥammad], \"Have you considered:[1] whether Allāh should cause my death and those with me or have mercy upon us, who can protect the disbelievers from a painful punishment?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 4, "arabic": "أَهْلَكَنِىَ", "translit": "َàِnَkَlْhَaʾ", "root": "هلك"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "مَّعِىَ", "translit": "َàِʿعَّm", "root": ""}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "رَحِمَنَا", "translit": "āَnَmِḥَr", "root": "رحم"}, {"id": 10, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 11, "arabic": "يُجِيرُ", "translit": "ُryِjgُy", "root": "جور"}, {"id": 12, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "عَذَابٍ", "translit": "ٍbāَhdَʿع", "root": "عذب"}, {"id": 15, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 29, "text": "قُلْ هُوَ ٱلرَّحْمَٰنُ ءَامَنَّا بِهِۦ وَعَلَيْهِ تَوَكَّلْنَاۖ فَسَتَعْلَمُونَ مَنْ هُوَ فِى ضَلَٰلٍ مُّبِينٍ ", "translation": "Say, \"He is the Most Merciful; we have believed in Him, and upon Him we have relied. And you will [come to] know who it is that is in clear error.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 4, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "وَعَلَيْهِ", "translit": "ِhْyَlَʿعَw", "root": ""}, {"id": 7, "arabic": "تَوَكَّلْنَا", "translit": "āَnْlَّkَwَt", "root": "وكل"}, {"id": 8, "arabic": "فَسَتَعْلَمُونَ", "translit": "َnwُmَlْʿعَtَsَf", "root": "علم"}, {"id": 9, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 13, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 30, "text": "قُلْ أَرَءَيْتُمْ إِنْ أَصْبَحَ مَآؤُكُمْ غَوْرًا فَمَن يَأْتِيكُم بِمَآءٍ مَّعِينٍۭ ", "translation": "Say, \"Have you considered: if your water was to become sunken [into the earth], then who could bring you flowing water?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 4, "arabic": "أَصْبَحَ", "translit": "َḥَbْṣَaʾ", "root": "صبح"}, {"id": 5, "arabic": "مَآؤُكُمْ", "translit": "ْmُkُwʾٓāَm", "root": "موه"}, {"id": 6, "arabic": "غَوْرًا", "translit": "āًrْwَغ", "root": "غور"}, {"id": 7, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 8, "arabic": "يَأْتِيكُم", "translit": "mُkyِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "بِمَآءٍ", "translit": "ٍءٓāَmِb", "root": "موه"}, {"id": 10, "arabic": "مَّعِينٍۭ", "translit": "ٍۭnyِʿعَّm", "root": "عين"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "فإذا دخلت السوق فقل لا إله إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت وهو حي لا يموت بيده الخير وهو على كل شيء قدير", "english": "When you enter the market, say: There is no god but Allah alone, He has no partner, to Him belongs the dominion (al-Mulk) and to Him belongs the praise, He gives life and causes death, and He is living, does not die, in His hand is the good, and He is over all things capable (Qadir).", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter", "badge": "Afterlife"}, {"arabic": "[197] حديث القول عند دخول السوق لا إله إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت وهو حي لا يموت بيده الخير وهو على كل شيء قدير من حديث عمر وقال غريب والحاكم وقال صحيح على شرط الشيخين.", "english": "[197] The hadith of the saying when entering the market: 'There is no god but Allah alone, He has no partner, to Him belongs the Kingdom (al-Mulk) and to Him belongs the Praise, He gives life and causes death, and He is Living and does not die, in His Hand is the Good, and He is over all things Powerful (Qadir).' From the narration of Umar, and it was said: 'Rare (Gharib),' and Al-Hakim said: 'Authentic according to the conditions of the two Shaykhs.'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication", "badge": "Hadith"}, {"arabic": "يا من هو على كل شيء قدير", "english": "O You Who is over every thing powerful (Qadir).", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din", "badge": "General"}], "2": [{"arabic": "ولا مناقضة بين قوله تعالى (نحن قدرنا بينكم الموت) وبين قوله (وأنا أكره مساءته) ولكن إيضاح الحق في هذا يستدعي تحقيق معنى الإرادة والمحبة والكراهة وبيان حقائقها. فإن السابق إلى الأفهام منها أمور تناسب إرادة الخلق ومحبتهم وكراهتهم وهيهات فبين صفات الله تعالى وصفات الخلق من البعد ما بين ذاته العزيز وذاتهم وكما أن ذوات الخلق جوهر وعرض وذات الله مقدس عنه ولا يناسب ما ليس بجوهر وعرض الجوهر والعرض فكذا صفاته لا تناسب صفات الخلق وهذه الحقائق داخلة في علم المكاشفة ووراء سر القدر الذي منع من إفشائه فلنقصر ", "english": "And there is no contradiction between His saying, the Exalted, ('We have decreed death among you') and His saying ('And I dislike displeasing him'), but clarifying the truth in this requires verifying the meaning of Will (Irada), Love (Mahabba), and Dislike (Karaha) and explaining their realities. For what first comes to minds from them are matters that correspond to the will, love, and dislike of creation—far be it! For between the attributes of Allah, the Exalted, and the attributes of creation is a distance like that between His Mighty Essence (Dhat Al-Aziz) and their essence. And just as the essences of creation are substance and accident, and the Essence of Allah is sanctified from that and does not correspond to what is not substance and accident—substance and accident—so too His attributes do not correspond to the attributes of creation. And these realities are included in the knowledge of unveiling (Ilm Al-Mukashafa) and beyond the secret of divine decree (Sirr Al-Qadr) which is prohibited from divulging, so we will refrain from mentioning it and limit ourselves to what we have pointed out regarding the difference between proceeding to marriage and refraining from it.", "book_file": "vol2_j2-k02.doc.txt", "book_title": "Etiquette of Marriage", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Etiquette of Marriage'", "badge": "Afterlife"}, {"arabic": "وقال السدي ﴿ الذي خلق الموت والحياة ليبلوكم أيكم احسن عملا ﴾ {} أي أيكم أكثرللموت ذكرا وأحسن له استعدادا وأشد منه خوفا وحذرا.", "english": "And Al-Suddi said: \"The One Who created death and life to test you as to which of you is best in deed\" (Quran 67:2) meaning: which of you has more remembrance (Dhikr) of death, better preparation for it, and greater fear and caution from it.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}], "3": [{"arabic": "وبقوله تعالى: \" الذي خلق سبع سموات طباقاً ما ترى في خلق الرحمن من تفاوت فارجع البصر هل ترى من فطور ثم ارجع البصر كرتين ينقلب إليك البصر خاسئاً وهو حسير \" وهذا الطريق هو الأسهل على الأكثرين وهو الأوسع على السالكين، وإليه أكثر دعوة القرآن عند الأمر بالتدبر والتفكر والاعتبار والنظر في آيات خارجة عن الحصر.", "english": "And by His saying, the Exalted: \"The One Who created seven heavens in layers, you see no inconsistency in the creation of the Most Merciful (Ar-Rahman). So return the gaze; do you see any fissure? Then return the gaze twice; the gaze will return to you humbled and weary.\" And this path is the easiest for most people and the widest for the travelers (Salikun), and to it belongs most of the Quran's call when commanding contemplation (Tadabbur), reflection (Tafakkur), consideration (I'tibar), and looking at signs (Ayat) beyond enumeration.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "8": [{"arabic": "و جامع ولم ينزل! فهو معتوه فكذلك من رجا رحمة الله وهو لم يؤمن أو آمن لم يعمل صالحاً أو عمل ولم يترك المعاصي فهو مغرور. فكما أنه إذا نكح ووطئ وأنزل بقي متردداً في الولد يخاف ويرجو فضل الله في خلق الولد ودفع الآفات عن الرحم وعن الأم إلى أن يتم فهو كيس، فكذلك إذا آمن وعمل الصالحات وترك السيئات وبقي متردداً بين الخوف والرجاء يخاف أن لا يقبل منه وأن لا يدوم عليه وأن يختم له بالسوء، ويرجوا من الله تعالى أن يثبته بالقول الثابت ويحفظ دينه من صواعق سكرات الموت حتى يموت على التوحيد، ويحرس قلبه عن الميل إل", "english": "And he who has intercourse but does not ejaculate! He is foolish, and likewise is he who hopes for the mercy of Allah while he has not believed, or believed but did not do righteous deeds, or did but did not abandon sins—he is deluded. Just as when one marries and has intercourse and ejaculates, he remains hesitant about the child, fearing and hoping for Allah's favor in creating the child and warding off afflictions from the womb and from the mother until it is complete, he is wise; similarly, if he believes and does righteous deeds and abandons evil deeds and remains hesitant between fear and hope, fearing that it will not be accepted from him and that it will not last upon him and that he will be sealed with evil, and hopes from Allah the Exalted that He will establish him with the firm word and protect his religion from the lightning bolts of the agonies of death until he dies upon monotheism (Tawhid), and guards his heart (Qalb) from inclining toward desires for the remainder of his life so that he does not incline toward sins, he is wise. And besides these, they are the ones deluded by Allah: \"And they will know when they see the punishment who is most astray from the path—and you will know its news after a while.\" And at that time, they will say as Allah informed about them: \"Our Lord, we have seen and heard, so return us that we may do righteous deeds; indeed, we are certain.\" That is, we learned that just as a child is not born except by intercourse and marriage, and crops do not grow except by plowing and sowing seeds, so likewise reward and recompense are not attained in the Hereafter except by righteous deeds—so return us that we may do righteous deeds, for we have now learned the truth of Your saying: \"And that there is not for man except what he has striven for, and that his striving is going to be seen—every time a company is thrown into it, its keepers will ask them, 'Did there not come to you a warner?' They will say, 'Yes, a warner had come to us.'\" That is, did we not hear you about the way of Allah with His servants and that \"He will take account of every soul for what it earned\" and that \"Every soul, for what it has earned, is held in pledge\"? So what deluded you about Allah after you heard and understood? \"They will say, 'If only we had been listening or reasoning, we would not be among the companions of the Blaze.' So they will admit their sin, and [it is] alienation for the companions of the Blaze.\"", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Delusion'", "badge": "Insight"}, {"arabic": "فإن قلت: فما شبهة المعتزلة والمرجئة وما حجة بطلان قولهم. فأقول شبهتهم عمومات القرآن أما المرجئة فقالوا لا يدخل المؤمن النار وإن أتي بكل المعاصي لقوله عز وجل: ﴿ فمن يؤمن بربه فلا يخاف بخسا ولا رهقا ﴾ {} ولقوله سبحانه وتعالى: ﴿ والذين آمنوا بالله ورسله أولئك هم الصديقون ﴾ {} الآية ولقوله تعالى: ﴿ كلما ألقي فيها فوج سألهم خزنتها. ﴾ {} إلى قوله: ﴿ فكذبنا وقلنا ما نزل الله من شيء ﴾ {} فقوله كلما ألقي فيها فوج عام فينبغي أن يكون من ألقي في النار مكذبا ولقوله تعالى: ﴿ لا يصلاها إلا الأشقى الذي كذب وتول", "english": "If you say: What is the doubt of the Mu'tazila and the Murji'a and what is the proof of the invalidity of their statement? I say their doubt is from generalities of the Quran. As for the Murji'a, they said the believer does not enter the Fire even if he commits all sins, due to His saying, the Mighty and Majestic: 'So whoever believes in his Lord, he fears not loss nor oppression' and due to His saying, the Exalted: 'And those who believe in Allah and His messengers, those are the truthful ones' the verse, and due to His saying: 'Every time a group is cast into it, its keepers will ask them' to His saying: 'So we denied and said: Allah has not sent down anything.' So His saying 'Every time a group is cast into it' is general, so it should be that whoever is cast into the Fire is a denier, and due to His saying: 'None will burn in it except the most wretched, who denied and turned away' and this is restriction, affirmation, and negation, and due to His saying: 'Whoever comes with a good deed, for him is better than it, and they are from the terror of that Day secure' so Faith (Iman) is the head of good deeds, and due to His saying: 'And Allah loves the doers of good (Muhsinin)' and He said: 'Indeed, We do not waste the reward of one who does good work.' And they have no proof in that, for where Faith (Iman) is mentioned in these verses, it is intended as Faith (Iman) with action, since we have clarified that Faith (Iman) may be used and intended as Islam, which is agreement with the Heart (Qalb), speech, and action. The evidence for this interpretation is many reports about punishing the disobedient and the measures of punishment, and his saying ﷺ: 'He will be taken out of the Fire whoever has in his Heart (Qalb) an atom's weight of Faith (Iman)' so how can he be taken out if he did not enter? And from the Quran, His saying: 'Indeed, Allah does not forgive association with Him, but He forgives what is less than that for whom He wills' and the exception with will indicates division, and His saying: 'And whoever disobeys Allah and His Messenger, then indeed, for him is the Fire of Hell, abiding therein forever' and specifying it with disbelief is arbitrary, and His saying: 'Unquestionably, the wrongdoers are in enduring punishment'", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Foundations of Belief'", "badge": "Ethics"}, {"arabic": "وقوله تعالى: ﴿ كلما ألقي فيها فوج سألهم خزنتها ﴾ {} أي فوج من الكفار وتخصيص العمومات قريب ومن هذه الآية وقع للأشعري وطائفة من المتكلمين إنكار صيغ العموم وأن هذه الألفاظ يتوقف فيها إلى ظهور قرينة تدل على معناها.", "english": "And His saying, the Exalted: 'Whenever a group is thrown into it, its keepers will ask them' {} meaning a group from the disbelievers, and the specification of generalities is plausible. And from this verse, it occurred to Al-Ash'ari and a group of theologians to deny the forms of generality and that these expressions are suspended until the appearance of an indication that points to their meaning.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Foundations of Belief'", "badge": "General"}], "9": [{"arabic": "فإن قلت: فما شبهة المعتزلة والمرجئة وما حجة بطلان قولهم. فأقول شبهتهم عمومات القرآن أما المرجئة فقالوا لا يدخل المؤمن النار وإن أتي بكل المعاصي لقوله عز وجل: ﴿ فمن يؤمن بربه فلا يخاف بخسا ولا رهقا ﴾ {} ولقوله سبحانه وتعالى: ﴿ والذين آمنوا بالله ورسله أولئك هم الصديقون ﴾ {} الآية ولقوله تعالى: ﴿ كلما ألقي فيها فوج سألهم خزنتها. ﴾ {} إلى قوله: ﴿ فكذبنا وقلنا ما نزل الله من شيء ﴾ {} فقوله كلما ألقي فيها فوج عام فينبغي أن يكون من ألقي في النار مكذبا ولقوله تعالى: ﴿ لا يصلاها إلا الأشقى الذي كذب وتول", "english": "If you say: What is the doubt of the Mu'tazila and the Murji'a and what is the proof of the invalidity of their statement? I say: Their doubt is the generalities of the Quran. As for the Murji'a, they said: The believer does not enter the Fire even if he commits all sins, due to His saying, the Exalted: 'So whoever believes in his Lord, he fears no loss nor any injustice' and due to His saying, the Most High: 'And those who believe in Allah and His messengers - those are the truthful ones' the verse, and due to His saying: 'Every time a group is cast into it, its keepers will ask them' to His saying: 'So we denied and said: Allah has not sent down anything' so His saying 'Every time a group is cast into it' is general, so it should be that whoever is cast into the Fire is a denier, and due to His saying: 'None will burn in it except the most wretched one who denied and turned away' and this is restriction, affirmation, and negation, and due to His saying: 'Whoever comes with a good deed will have better than it, and they will be safe from terror that Day' so Faith (Iman) is the head of good deeds, and due to His saying: 'And Allah loves the doers of good' and He said: 'Indeed, We do not allow to be lost the reward of any who does good work' and they have no proof in that, for when Faith (Iman) is mentioned in these verses, it is intended to be Faith (Iman) with action, since we have clarified that Faith (Iman) may be used and intended to mean Islam, which is agreement with the Heart (Qalb), speech, and action. The evidence for this interpretation is many reports about punishing the disobedient and the measures of punishment, and his saying ﭬ: 'He will be brought out of the Fire who had in his Heart (Qalb) an atom's weight of Faith (Iman)' so how can he be brought out if he did not enter? And from the Quran, His saying: 'Indeed, Allah does not forgive association with Him, but He forgives what is less than that for whom He wills' and the exception with will indicates division, and His saying: 'And whoever disobeys Allah and His Messenger - then indeed, for him is the Fire of Hell, wherein they will abide eternally' and specifying it with disbelief is arbitrary, and His saying: 'Unquestionably, the wrongdoers are in an enduring punishment' and He said: 'And whoever comes with an evil deed - their faces will be overturned into the Fire' so these generalities in...", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Foundations of Belief'", "badge": "Ethics"}], "10": [{"arabic": "وأن \"كل نفس بما كسبت رهينة\" فما الذي غركم بالله بعد أن سمعتم وعقلتم؟ \"قالوا لو كنا نسمع أو نعقل ما كنا في أصحاب السعير فاعترفوا بذنبهم فسحقاً لأصحاب السعير\"", "english": "And that \"Every Soul (Nafs) is held in pledge for what it has earned\" so what deluded you about Allah after you heard and understood? \"They said: Had we but listened or had sense (Aql), we would not have been among the dwellers of the Blazing Fire (Sa'ir). So they acknowledged their sin; and far removed (from mercy) are the dwellers of the Blazing Fire (Sa'ir).\"", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Delusion'", "badge": "Insight"}, {"arabic": "وعن أبي سعيد الخدري رضي الله عنه قال: قال رسول الله صلى الله عليه وسلم : (( لكل شيء دعامة ودعامة المؤمن عقله فبقدر عقله تكون عبادته أما سمعتم قول الفجار في النار: (لو كنا نسمع أو نعقل ما كنا في أصحاب السعير( (الملك: 10) ))[205].", "english": "And from Abu Sa'id al-Khudri, may Allah be pleased with him, he said: The Messenger of Allah, peace and blessings be upon him, said: 'Everything has a pillar, and the pillar of the believer is his intellect (Aql). According to the measure of his intellect (Aql) will be his worship. Have you not heard the saying of the wicked in the Fire: \"If we had listened or used our intellect (Na'qil), we would not have been among the companions of the Blaze\" (Al-Mulk: 10)?'", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Knowledge'", "badge": "Afterlife"}], "13": [{"arabic": "الأصل الأول: العلم بأن كل حادث في العالم فهو فعله وخلقه واختراعه لا خالق له سواه ولا محدث له إلا إياه خلق الخلق وصنعهم وأوجد قدرتهم وحركتهم فجميع أفعال عباده مخلوقة له ومتعلقة بقدرته تصديقا له في قوله تعالى الله خالق كل شيء وفي قوله تعالى والله خلقكم وما تعملون وفي قوله تعالى وأسروا قولكم أو اجهروا به إنه عليم بذات الصدور ألا يعلم من خلق وهو اللطيف الخبير أمر العباد بالتحرز في أقوالهم وأفعالهم وإسرارهم وإضمارهم لعلمه بموارد أفعالهم واستدل على العلم بالخلق وكيف لا يكون خالقا لفعل العبد وقدرته تام", "english": "The First Principle: The knowledge that every occurrence in the world is His action, His creation, and His invention; there is no creator for it other than Him, and no originator for it except Him. He created the creation and fashioned them, and brought into existence their power and their movement. Thus, all the actions of His servants are created by Him and connected to His power, confirming Him in His saying, the Exalted: 'Allah is the Creator of everything' (Quran 39:62), and in His saying: 'And Allah created you and what you do' (Quran 37:96), and in His saying: 'And conceal your speech or proclaim it; indeed, He is Knowing of that within the chests (ذات الصدور)' (Quran 67:13). Does He not know what He created? And He is the Subtle, the Acquainted. He commanded the servants to be cautious in their statements and their actions, and in their secrets and their hidden thoughts, due to His knowledge of the sources of their actions. And He argued for knowledge through creation. And how could He not be the creator of the servant's action when His power is complete, with no deficiency in it, and it is connected to the movement of the bodies of the servants? And the movements are similar, and the connection of the power to them is for their own essence. So what is it that restricts its connection from some movements without others despite their similarity? Or how could the animal be independent in invention when there emanates from the spider, the bee, and all the animals from subtle crafts what bewilders the intellects of those of understanding? So how did they become isolated in their invention without the Lord of lords, while they are not knowing of the details of what emanates from them from acquisition? Far, far be it! The created beings are humbled, and He is singled out with the dominion and the sovereignty, the Compeller of the earth and the heavens.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Foundations of Belief'", "badge": "General"}], "14": [{"arabic": "الأصل الثاني: العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك إلى الاستدلال بالخلق على العلم بأنك لا تستريب في دلالة الخلق اللطيف والصنع المزين بالترتيب ولو في الشيء الحقير الضعيف على علم الصانع بكيفية الترتيب والترصيف فما ذكره الله سبحانه هو المنتهى في الهداية والتعريف.", "english": "The Second Foundation: The knowledge that He, the Exalted, is Knower of all existents and encompasses all created beings; not even an atom's weight in the earth or in the heavens escapes His knowledge, truthful in His saying 'and He is, of all things, Knowing.' And a guide to its truthfulness is His saying, the Exalted: 'Does He not know, He Who created? And He is the Subtle, the Aware.' He guides you to inferring from creation to knowledge, that you should not doubt in the indication of the subtle creation and the work adorned with arrangement, even in the insignificant, weak thing, regarding the knowledge of the Maker concerning the manner of arrangement and composition. So what Allah, glory be to Him, has mentioned is the ultimate in guidance and definition.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Foundations of Belief'", "badge": "Insight"}], "15": [{"arabic": "وإذا عرفت طريق الفكر فى نفسك فتفكر فى الأرض التى هى مقرك ثم فى أنهارها وجبالها ومعادتها ثم ارتفع منها إلى ملكوت السموات أما الأرض فمن آياته أن خلق الأرض فراشا ومهادا وسلك فيها سبلا فجاجا وجعلها ذلولا لتمشوا فى مناكبها وجعلها قارة لا تتحرك وأرسى فيها الجبال أوتادا لها تمنعها من أن تميد ثم وسع أكنافها حتى عجز الآدميون عن بلوغ جميع جوانبها وإن طالت إعمارهم وكثر تطوافهم فقال تعالى والسماء بنيناها بأيد وإنا لموسعون والأرض فرشناها فنعم الماهدون وقال تعالى هو الذى جعل لكم الأرض ذلولا فامشوا فى مناكبها ", "english": "And when you know the path of thought (Fikr) in your self (Nafs), then contemplate the earth which is your abode, then in its rivers and mountains and its plains, then ascend from it to the dominion (Malakut) of the heavens. As for the earth, from His signs is that He created the earth as a bed (Firash) and a resting place (Mahad), and made in it wide paths, and made it submissive (Dhulul) so that you may walk in its tracts, and made it stable so it does not move, and set in it mountains as pegs for it to prevent it from shaking, then expanded its expanses until the sons of Adam (Adam) were unable to reach all its sides even if their lifespans were long and their travels abundant. So He, the Exalted, said: 'And the heaven We constructed with strength, and indeed, We are [its] expander. And the earth We have spread out, and excellent is the preparer.' And He, the Exalted, said: 'He is the one who made for you the earth submissive (Dhulul), so walk in its tracts.' And He, the Exalted, said: 'The one who made for you the earth a bed (Firash).' And He has frequently mentioned the earth in His mighty book so that one may contemplate its wonders: its surface is an abode for the living and its interior is a resting place for the dead. He, the Exalted, said: 'Have We not made the earth a container, for the living and the dead?' So look at the earth when it is dead, then when water is sent down upon it, it quivers and swells and greens and produces wonders of plants, and from it emerge various kinds of animals.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "22": [{"arabic": "ومن يأخذ المعاني من الأسامي يظن أن هذه الأحوال مختلفة في ذواتها وحقائقها من حيث رأي الأسامي مختلفة والذي يسلك الطريق المستقيم وينظر بنور الله تعالى يلحظ المعاني أولا فيطلع على حقائقها ثم يلاحظ الأسامي فإنها وضعت دالة على المعاني فالمعاني هي الأصول والالفاظ هي التوابع ومن يطلب الأصول من التوابع لا بد وأن يزل وإلى الفريقين الإشارة بقوله تعالى: ﴿ أفمن يمشي مكبا على وجهه أهدى أمن يمشي سويا على صراط مستقيم ﴾ {} فإن الكفار لم يغلطوا فيما غلطوا فيه إلا بمثل هذه الانعكاسات، نسأل الله حسن التوفيق بكرمه و", "english": "And whoever takes the meanings from the names thinks that these states are different in their essences and realities because the names appear different. But the one who follows the straight path and looks with the light of Allah (God) observes the meanings first, then perceives their realities, then notices the names, for they were established as indicators of the meanings. Thus, the meanings are the foundations and the words are the followers. And whoever seeks the foundations from the followers must inevitably slip. To these two groups is the allusion in His saying, the Exalted: 'Is he who walks prone upon his face better guided, or he who walks upright on a straight path?' For the disbelievers did not err in what they erred in except by such reversals. We ask Allah for good success through His generosity and kindness.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "25": [{"arabic": "واختلاف تركيب أعضائه أعاجيب تزيد على الأعاجيب فى بعثه وإعادته فكيف ينكر ذلك من قدرة الله تعالى وحكمته من يشاهد ذلك فى صنعته وقدرته فإن كان فى إيمانك ضعف فقو الإيمان بالنظر فى النشأة الأولى فإن الثانية مثلها وأسهل منها وإن كنت قوى الإيمان بها فأشعر قلبك تلك المخاوف والأخطار وأكثر فيها التفكر والاعتبار لتسلب عن قلبك الراحة والقرار فتشتغل بالتشمر للعرض على الجبار وتفكر أولا فيما يقرع سمع سكان القبور من شدة نفخ الصور فإنها صيحة واحدة تنفرج بها القبور عن رءوس الموتي فيثورون دفعة واحدة فتوهم نفسك وقد ", "english": "And the variation in the composition of its limbs is wonders that increase upon wonders in its resurrection and restoration, so how can one deny that from the power (Qudrah) of Allah the Exalted and His wisdom who witnesses that in His creation and power? If there is weakness in your faith (Iman), then strengthen the faith (Iman) by looking at the first creation, for the second is like it and easier than it. And if you are strong in faith (Iman) in it, then make your heart (Qalb) feel those fears and dangers, and increase in it reflection (Tafakkur) and consideration (I'tibar) to strip from your heart (Qalb) comfort and settlement, so you become occupied with preparing for the presentation before the Compeller (Al-Jabbar). And reflect first on what strikes the hearing of the inhabitants of the graves from the intensity of the blowing of the Trumpet (As-Sur), for it is a single cry by which the graves split open from the heads of the dead, and they rise up all at once. So imagine yourself having sprung up with your face changed, your body dusty from the parting of your hair to your feet from the dust of your grave, bewildered from the intensity of the shock, with your eye fixed toward the call. And the creation has risen up in a single uprising from the graves in which their tribulation (Bala') has been prolonged, and they have been agitated by terror (Faza') and dread (Ru'b), added to what was with them of sorrows (Humum) and griefs (Ghumum) and intense waiting for the outcome of the matter, as Allah the Exalted said: 'And the Trumpet (As-Sur) will be blown, and all who are in the heavens and all who are on the earth will fall dead except whom Allah wills. Then it will be blown again, and at once they will be standing, looking on.' And Allah the Exalted said: 'And when the Trumpet (An-Naqur) is blown, that Day will be a difficult day for the disbelievers; not easy.' And Allah the Exalted said: 'And they say, \"When is this promise, if you should be truthful?\" They do not await except one blast which will seize them while they are disputing. And they will not be able to make a testament, nor to their people can they return. And the Trumpet (As-Sur) will be blown, and at once from the graves to their Lord they will hasten. They will say, \"O woe to us! Who has raised us from our sleeping place? This is what the Most Merciful had promised, and the messengers told the truth.\"' So if there were not before the dead except the terror of that blowing, it would be worthy of being feared, for it is a blowing and a cry by which those in the heavens and the earth are struck dead, meaning they die by it except whom Allah wills, and that is some of the angels. And therefore the Messenger of Allah (peace be upon him) said: 'How can I be at ease when the possessor of the Trumpet (As-Sur) has taken the horn in his mouth, lowered his forehead, and inclined his ear, waiting for when he will be commanded to blow?' Maqatil said: The Trumpet (As-Sur) is the horn, and that is because Israfil (upon him be peace) has placed his mouth on the horn like the form of a trumpet, and the circle of the head of the horn is like the expanse of the heavens and the earth, and he is fixing his gaze toward the Throne (Al-'Arsh), waiting for when he will be commanded to blow the first blowing. And when he blows, those in the heavens and the earth are struck dead, meaning every animal dies from the intensity of the terror except whom Allah wills, and that is Jibril, Mika'il, Israfil, and the Angel of Death (Malak al-Mawt). Then the Angel of Death (Malak al-Mawt) is commanded to take the soul (Ruh) of Jibril, then the soul (Ruh) of Mika'il, then the soul (Ruh) of Israfil, then the Angel of Death (Malak al-Mawt) is commanded and he dies. Then the creation remains after the first blowing in the Intermediate State (Al-Barzakh) for forty years, then Allah the Exalted revives Israfil and commands.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1599], [2, 1599, 2811], [3, 2811, 3958], [4, 3958, 5079], [5, 5079, 6095], [6, 6095, 7294], [7, 7294, 8011], [8, 8011, 8923], [9, 8923, 10146]], "2": [[1, 400, 1520], [2, 1520, 2315], [3, 2315, 3471], [4, 3471, 5542], [5, 5542, 7529], [6, 7529, 8932], [7, 8932, 9992], [8, 9992, 11148], [9, 11148, 12087], [10, 12087, 13532], [11, 13532, 14953]], "3": [[1, 400, 1812], [2, 1812, 2814], [3, 2814, 3892], [4, 3892, 5744], [5, 5744, 7778], [6, 7778, 9008], [7, 9008, 10344], [8, 10344, 11103], [9, 11103, 12105], [10, 12105, 14155], [11, 14155, 14762], [12, 14762, 16311], [13, 16311, 17677], [14, 17677, 19074], [15, 19074, 19651], [16, 19651, 20987], [17, 20987, 21594], [18, 21594, 23051]], "4": [[1, 400, 1313], [2, 1313, 2213], [3, 2213, 3396], [4, 3396, 5004], [5, 5004, 6535], [6, 6535, 7744], [7, 7744, 8927], [8, 8927, 10650], [9, 10650, 11653], [10, 11653, 12863]], "5": [[1, 400, 1634], [2, 1634, 3547], [3, 3547, 5836], [4, 5836, 7618], [5, 7618, 9532], [6, 9532, 11725], [7, 11725, 13245], [8, 13245, 15999], [9, 15999, 18180], [10, 18180, 18903], [11, 18903, 20124], [12, 20124, 21849]], "6": [[1, 400, 2604], [2, 2604, 4317], [3, 4317, 5903], [4, 5903, 7279], [5, 7279, 8781], [6, 8781, 10157], [7, 10157, 11870]], "7": [[1, 400, 2157], [2, 2157, 3925], [3, 3925, 5285], [4, 5285, 7025], [5, 7025, 7977], [6, 7977, 9717], [7, 9717, 10778], [8, 10778, 12001]], "8": [[1, 400, 1734], [