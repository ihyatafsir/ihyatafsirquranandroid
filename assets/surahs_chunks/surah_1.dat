], [4, 6570, 11410]], "6": [[1, 850, 1590], [2, 1600, 3550], [3, 3560, 9340]], "1:6": [[1, 850, 1590], [2, 1600, 3550], [3, 3560, 9340]], "7": [[1, 1550, 2990], [2, 3000, 4730], [3, 4740, 6640], [4, 6650, 8760], [5, 8770, 9800], [6, 9810, 12460], [7, 12470, 14560], [8, 14570, 15410], [9, 15420, 24980]], "1:7": [[1, 1550, 2990], [2, 3000, 4730], [3, 4740, 6640], [4, 6650, 8760], [5, 8770, 9800], [6, 9810, 12460], [7, 12470, 14560], [8, 14570, 15410], [9, 15420, 24980]]}, "abdulbasit_warsh": {"1": [[1, 756, 1302], [2, 1302, 2079], [3, 2079, 2583], [4, 2583, 5520]], "1:1": [[1, 756, 1302], [2, 1302, 2079], [3, 2079, 2583], [4, 2583, 5520]], "2": [[1, 777, 1659], [2, 1659, 4501]], "1:2": [[1, 777, 1659], [2, 1659, 4501]], "3": [[1, 798, 1218], [2, 1218, 1785], [3, 1785, 4449]], "1:3": [[1, 798, 1218], [2, 1218, 1785], [3, 1785, 4449]], "4": [[1, 1092, 1701], [2, 1701, 2478], [3, 2478, 3528], [4, 3528, 6643]], "1:4": [[1, 1092, 1701], [2, 1701, 2478], [3, 2478, 3528], [4, 3528, 6643]], "5": [[1, 483, 1071], [2, 1071, 1806], [3, 1806, 5259]], "1:5": [[1, 483, 1071], [2, 1071, 1806], [3, 1806, 5259]], "6": [[1, 1071, 1596], [2, 1596, 2478], [3, 2478, 3381], [4, 3381, 4135]], "1:6": [[1, 1071, 1596], [2, 1596, 2478], [3, 2478, 3381], [4, 3381, 4135]], "7": [[1, 126, 525], [2, 525, 1617], [3, 1617, 2625], [4, 2625, 3087], [5, 3087, 10039]], "1:7": [[1, 126, 525], [2, 525, 1617], [3, 1617, 2625], [4, 2625, 3087], [5, 3087, 10039]]}}, "letterTiming": {"minshawi": {"1": [{"wordIdx": 0, "charIdx": 0, "char": "ب", "grapheme": "ب", "start": 550, "end": 718, "duration": 168, "peakTime": 634}, {"wordIdx": 0, "charIdx": 1, "char": "س", "grapheme": "س", "start": 718, "end": 903, "duration": 185, "peakTime": 810}, {"wordIdx": 0, "charIdx": 2, "char": "م", "grapheme": "م", "start": 903, "end": 1071, "duration": 168, "peakTime": 987}, {"wordIdx": 1, "charIdx": 0, "char": "ٱ", "grapheme": "ٱ", "start": 1071, "end": 1186, "duration": 115, "peakTime": 1128}, {"wordIdx": 1, "charIdx": 1, "ch