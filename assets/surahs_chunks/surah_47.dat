17],[4,3017,4878],[5,4878,5406],[6,5406,7135],[7,7135,7735],[8,7735,8888],[9,8888,11932],[10,11932,13829]],"23":[[1,400,2451],[2,2451,3976],[3,3976,5352],[4,5352,6418],[5,6418,8536],[6,8536,10911],[7,10911,12915]],"24":[[1,400,1411],[2,1411,3253],[3,3253,4706],[4,4706,5169],[5,5169,6138],[6,6138,7128],[7,7128,9519]],"25":[[1,400,1294],[2,1294,2677],[3,2677,4428],[4,4428,5921],[5,5921,7623],[6,7623,8468],[7,8468,9251],[8,9251,9888],[9,9888,11265],[10,11265,11975],[11,11975,13126],[12,13126,15080],[13,15080,16237],[14,16237,16947],[15,16947,18685],[16,18685,19394]],"26":[[1,400,1290],[2,1290,2840],[3,2840,4473],[4,4473,5975],[5,5975,7395],[6,7395,8010],[7,8010,8897],[8,8897,9832],[9,9832,11749],[10,11749,12341],[11,12341,13169],[12,13169,14234],[13,14234,15523],[14,15523,16635],[15,16635,18479]],"27":[[1,400,1596],[2,1596,2633],[3,2633,4534],[4,4534,6661],[5,6661,8601],[6,8601,10409],[7,10409,12654]],"28":[[1,400,1292],[2,1292,2845],[3,2845,4588],[4,4588,5811],[5,5811,6925],[6,6925,7862],[7,7862,9640],[8,9640,11205],[9,11205,12533],[10,12533,14169]],"29":[[1,400,978],[2,978,1819],[3,1819,3303],[4,3303,3960],[5,3960,5694],[6,5694,6942],[7,6942,7520],[8,7520,8242],[9,8242,9450],[10,9450,10488],[11,10488,12367]],"30":[[1,400,1514],[2,1514,3509],[3,3509,6072],[4,6072,8329],[5,8329,10307],[6,10307,13386],[7,13386,14083],[8,14083,14947],[9,14947,16340],[10,16340,17858],[11,17858,19168],[12,19168,21118]],"31":[[1,400,3074],[2,3074,4274],[3,4274,5234],[4,5234,7131],[5,7131,8045],[6,8045,10545],[7,10545,12339],[8,12339,14143]],"32":[[1,400,1467],[2,1467,3119],[3,3119,4903],[4,4903,7140],[5,7140,7783],[6,7783,9128],[7,9128,10283],[8,10283,13809],[9,13809,15753],[10,15753,16338],[11,16338,17274],[12,17274,18034],[13,18034,19679],[14,19679,20527],[15,20527,22164],[16,22164,22749],[17,22749,24986],[18,24986,26141],[19,26141,27486],[20,27486,29679],[21,29679,31697]],"33":[[1,400,2481],[2,2481,3631],[3,3631,5646],[4,5646,7335],[5,7335,8139],[6,8139,10133],[7,10133,11486],[8,11486,12