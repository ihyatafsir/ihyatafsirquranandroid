}], "narration": "warsh"}, {"surah": 47, "ayah": 4, "text": "فَإِذَا لَقِيتُمُ اُ۬لذِينَ كَفَرُواْ فَضَرْبَ اَ۬لرِّقَابِۖ حَتَّيٰٓ إِذَآ أَثْخَنتُمُوهُمْ فَشُدُّواْ اُ۬لْوَثَاقَۖ فَإِمَّا مَنّاَۢ بَعْدُ وَإِمَّا فِدَآءً حَتَّيٰ تَضَعَ اَ۬لْحَرْبُ أَوْزَارَهَاۖ ذَٰلِكَ وَلَوْ يَشَآءُ اُ۬للَّهُ لَانتَصَرَ مِنْهُمْۖ وَلَٰكِن لِّيَبْلُوَاْ بَعْضَكُم بِبَعْضࣲۖ وَالذِينَ قَٰتَلُواْ فِے سَبِيلِ اِ۬للَّهِ فَلَنْ يُّضِلَّ أَعْمَٰلَهُمْۖ", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَقِيتُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَضَرْبَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لرِّقَابِۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَتَّيٰٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَثْخَنتُمُوهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَشُدُّواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْوَثَاقَۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَإِمَّا", "translit": "", "root": ""}, {"id": 13, "arabic": "مَنّاَۢ", "translit": "", "root": ""}, {"id": 14, "arabic": "بَعْدُ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَإِمَّا", "translit": "", "root": ""}, {"id": 16, "arabic": "فِدَآءً", "translit": "", "root": ""}, {"id": 17, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 18, "arabic": "تَضَعَ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬لْحَرْبُ", "translit": "", "root": ""}, {"id": 20, "arabic": "أَوْزَارَهَاۖ", "translit": "", "root": ""}, {"id": 21, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 22, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 23, "arabic": "يَشَآءُ", "translit": "", "root": ""}, {"id": 24, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 25, "arabic": "لَانتَصَرَ", "trans