 "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَنصُرْكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَيُثَبِّتَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَقْدَامَكُمْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 47, "ayah": 8, "text": "وَالذِينَ كَفَرُواْ فَتَعْساࣰ لَّهُمْ وَأَضَلَّ أَعْمَٰلَهُمْۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَتَعْساࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَضَلَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَعْمَٰلَهُمْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 47, "ayah": 9, "text": "ذَٰلِكَ بِأَنَّهُمْ كَرِهُواْ مَآ أَنزَلَ اَ۬للَّهُ فَأَحْبَطَ أَعْمَٰلَهُمُۥٓۖ", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَرِهُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَأَحْبَطَ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَعْمَٰلَهُمُۥٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 47, "ayah": 10, "text": "۞أَفَلَمْ يَسِيرُواْ فِے اِ۬لَارْضِ فَيَنظُرُواْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لذِينَ مِن قَبْلِهِمْ دَمَّرَ اَ۬للَّهُ عَلَيْهِمْۖ وَلِلْكٰ۪فِرِينَ أَمْثَٰلُهَاۖ", "words": [{"id": 1, "arabic": "۞أَفَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسِيرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَيَنظُرُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَيْفَ", "translit": "