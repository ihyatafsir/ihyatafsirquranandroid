": 27, "text": "فَكَيْفَ إِذَا تَوَفَّتْهُمُ اُ۬لْمَلَٰٓئِكَةُ يَضْرِبُونَ وُجُوهَهُمْ وَأَدْبَٰرَهُمْۖ", "words": [{"id": 1, "arabic": "فَكَيْفَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَوَفَّتْهُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْمَلَٰٓئِكَةُ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَضْرِبُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وُجُوهَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَدْبَٰرَهُمْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 47, "ayah": 28, "text": "ذَٰلِكَ بِأَنَّهُمُ اُ۪تَّبَعُواْ مَآ أَسْخَطَ اَ۬للَّهَ وَكَرِهُواْ رِضْوَٰنَهُۥ فَأَحْبَطَ أَعْمَٰلَهُمُۥٓۖ", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۪تَّبَعُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَسْخَطَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَكَرِهُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "رِضْوَٰنَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَأَحْبَطَ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَعْمَٰلَهُمُۥٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 47, "ayah": 29, "text": "أَمْ حَسِبَ اَ۬لذِينَ فِے قُلُوبِهِم مَّرَضٌ اَن لَّنْ يُّخْرِجَ اَ۬للَّهُ أَضْغَٰنَهُمْۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "حَسِبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "قُلُوبِهِم", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّرَضٌ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَن", "translit": "", "root": ""}, {"id": 8, "arabic": "لَّنْ"