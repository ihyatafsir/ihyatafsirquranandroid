{"surah":47,"verses":[{"ayah":1,"text":"ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ أَضَلَّ أَعْمَٰلَهُمْ ","translation":"Those who disbelieve and avert [people] from the way of Allāh - He will waste their deeds.[1]","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":3,"arabic":"وَصَدُّوا۟","translit":"۟āwُّdَṣَw","root":"صدد"},{"id":4,"arabic":"عَن","translit":"nَʿع","root":""},{"id":5,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"أَضَلَّ","translit":"َّlَḍَaʾ","root":"ضلل"},{"id":8,"arabic":"أَعْمَٰلَهُمْ","translit":"ْmُhَlَٰmْʿعَaʾ","root":"عمل"}],"hasIhya":false},{"ayah":2,"text":"وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَءَامَنُوا۟ بِمَا نُزِّلَ عَلَىٰ مُحَمَّدٍ وَهُوَ ٱلْحَقُّ مِن رَّبِّهِمْۙ كَفَّرَ عَنْهُمْ سَيِّـَٔاتِهِمْ وَأَصْلَحَ بَالَهُمْ ","translation":"And those who believe and do righteous deeds and believe in what has been sent down upon Muḥammad - and it is the truth from their Lord - He will remove from them their misdeeds and amend their condition.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":3,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":4,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":5,"arabic":"وَءَامَنُوا۟","translit":"۟āwُnَmāَءَw","root":"امن"},{"id":6,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":7,"arabic":"نُزِّلَ","translit":"َlِّzُn","root":"نزل"},{"id":8,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":9,"arabic":"مُحَمَّدٍ","translit":"ٍdَّmَḥُm","root":"حمد"},{"id":10,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":11,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"رَّبِّهِمْ","translit":"ْmِhِّbَّr","root":"ربب"},{"id":14,"arabic":"كَفَّرَ","translit":"َrَّfَk","root":"كفر"},{"id":15,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":16,"arabic":"سَيِّـَٔاتِهِمْ","translit":"ْmِhِtāَٔـِّyَs","root":"سوا"},{"id":17,"arabic":"وَأَصْلَحَ","translit":"َḥَlْṣَaʾَw","root":"صلح"},{"id":18,"arabic":"بَالَهُمْ","translit":"ْmُhَlāَb","root":"بول"}],"hasIhya":true},{"ayah":3,"text":"ذَٰلِكَ بِأَنَّ ٱلَّذِينَ كَفَرُوا۟ ٱتَّبَعُوا۟ ٱلْبَٰطِلَ وَأَنَّ ٱلَّذِينَ ءَامَنُوا۟ ٱتَّبَعُوا۟ ٱلْحَقَّ مِن رَّبِّهِمْۚ كَذَٰلِكَ يَضْرِبُ ٱللَّهُ لِلنَّاسِ أَمْثَٰلَهُمْ ","translation":"That is because those who disbelieve follow falsehood, and those who believe follow the truth from their Lord. Thus does Allāh present to the people their comparisons.[1]","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"بِأَنَّ","translit":"َّnَaʾِb","root":""},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":5,"arabic":"ٱتَّبَعُوا۟","translit":"۟āwُʿعَbَّtٱ","root":"تبع"},{"id":6,"arabic":"ٱلْبَٰطِلَ","translit":"َlِṭَٰbْlٱ","root":"بطل"},{"id":7,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":10,"arabic":"ٱتَّبَعُوا۟","translit":"۟āwُʿعَbَّtٱ","root":"تبع"},{"id":11,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"رَّبِّهِمْ","translit":"ْmِhِّbَّr","root":"ربب"},{"id":14,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":15,"arabic":"يَضْرِبُ","translit":"ُbِrْḍَy","root":"ضرب"},{"id":16,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":17,"arabic":"لِلنَّاسِ","translit":"ِsāَّnlِl","root":"انس"},{"id":18,"arabic":"أَمْثَٰلَهُمْ","translit":"ْmُhَlَٰhtْmَaʾ","root":"مثل"}],"hasIhya":true},{"ayah":4,"text":"فَإِذَا لَقِيتُمُ ٱلَّذِينَ كَفَرُوا۟ فَضَرْبَ ٱلرِّقَابِ حَتَّىٰٓ إِذَآ أَثْخَنتُمُوهُمْ فَشُدُّوا۟ ٱلْوَثَاقَ فَإِمَّا مَنًّۢا بَعْدُ وَإِمَّا فِدَآءً حَتَّىٰ تَضَعَ ٱلْحَرْبُ أَوْزَارَهَاۚ ذَٰلِكَ وَلَوْ يَشَآءُ ٱللَّهُ لَٱنتَصَرَ مِنْهُمْ وَلَٰكِن لِّيَبْلُوَا۟ بَعْضَكُم بِبَعْضٍۗ وَٱلَّذِينَ قُتِلُوا۟ فِى سَبِيلِ ٱللَّهِ فَلَن يُضِلَّ أَعْمَٰلَهُمْ ","translation":"So when you meet those who disbelieve [in battle], strike [their] necks until, when you have inflicted slaughter upon them, then secure [their] bonds,[1] and either [confer] favor[2] afterwards or ransom [them] until the war lays down its burdens.[3] That [is the command]. And if Allāh had willed, He could have taken vengeance upon them [Himself], but [He ordered armed struggle] to test some of you by means of others. And those who are killed in the cause of Allāh - never will He waste their deeds.","words":[{"id":1,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":2,"arabic":"لَقِيتُمُ","translit":"ُmُtyِqَl","root":"لقي"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":5,"arabic":"فَضَرْبَ","translit":"َbْrَḍَf","root":"ضرب"},{"id":6,"arabic":"ٱلرِّقَابِ","translit":"ِbāَqِّrlٱ","root":"رقب"},{"id":7,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":8,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":9,"arabic":"أَثْخَنتُمُوهُمْ","translit":"ْmُhwُmُtnَhkْhtَaʾ","root":"ثخن"},{"id":10,"arabic":"فَشُدُّوا۟","translit":"۟āwُّdُhsَf","root":"شدد"},{"id":11,"arabic":"ٱلْوَثَاقَ","translit":"َqāَhtَwْlٱ","root":"وثق"},{"id":12,"arabic":"فَإِمَّا","translit":"āَّmِiʾَf","root":""},{"id":13,"arabic":"مَنًّۢا","translit":"āًّۢnَm","root":"منن"},{"id":14,"arabic":"بَعْدُ","translit":"ُdْʿعَb","root":"بعد"},{"id":15,"arabic":"وَإِمَّا","translit":"āَّmِiʾَw","root":""},{"id":16,"arabic":"فِدَآءً","translit":"ًءٓāَdِf","root":"فدي"},{"id":17,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":18,"arabic":"تَضَعَ","translit":"َʿعَḍَt","root":"وضع"},{"id":19,"arabic":"ٱلْحَرْبُ","translit":"ُbْrَḥْlٱ","root":"حرب"},{"id":20,"arabic":"أَوْزَارَهَا","translit":"āَhَrāَzْwَaʾ","root":"وزر"},{"id":21,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":22,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":23,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":24,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":25,"arabic":"لَٱنتَصَرَ","translit":"َrَṣَtnٱَl","root":"نصر"},{"id":26,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":27,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":28,"arabic":"لِّيَبْلُوَا۟","translit":"۟āَwُlْbَyِّl","root":"بلو"},{"id":29,"arabic":"بَعْضَكُم","translit":"mُkَḍْʿعَb","root":"بعض"},{"id":30,"arabic":"بِبَعْضٍ","translit":"ٍḍْʿعَbِb","root":"بعض"},{"id":31,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":32,"arabic":"قُتِلُوا۟","translit":"۟āwُlِtُq","root":"قتل"},{"id":33,"arabic":"فِى","translit":"àِf","root":""},{"id":34,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":35,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":36,"arabic":"فَلَن","translit":"nَlَf","root":""},{"id":37,"arabic":"يُضِلَّ","translit":"َّlِḍُy","root":"ضلل"},{"id":38,"arabic":"أَعْمَٰلَهُمْ","translit":"ْmُhَlَٰmْʿعَaʾ","root":"عمل"}],"hasIhya":true},{"ayah":5,"text":"سَيَهْدِيهِمْ وَيُصْلِحُ بَالَهُمْ ","translation":"He will guide them and amend their condition","words":[{"id":1,"arabic":"سَيَهْدِيهِمْ","translit":"ْmِhyِdْhَyَs","root":"هدي"},{"id":2,"arabic":"وَيُصْلِحُ","translit":"ُḥِlْṣُyَw","root":"صلح"},{"id":3,"arabic":"بَالَهُمْ","translit":"ْmُhَlāَb","root":"بول"}],"hasIhya":false},{"ayah":6,"text":"وَيُدْخِلُهُمُ ٱلْجَنَّةَ عَرَّفَهَا لَهُمْ ","translation":"And admit them to Paradise, which He has made known to them.","words":[{"id":1,"arabic":"وَيُدْخِلُهُمُ","translit":"ُmُhُlِhkْdُyَw","root":"دخل"},{"id":2,"arabic":"ٱلْجَنَّةَ","translit":"َẗَّnَjgْlٱ","root":"جنن"},{"id":3,"arabic":"عَرَّفَهَا","translit":"āَhَfَّrَʿع","root":"عرف"},{"id":4,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""}],"hasIhya":false},{"ayah":7,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن تَنصُرُوا۟ ٱللَّهَ يَنصُرْكُمْ وَيُثَبِّتْ أَقْدَامَكُمْ ","translation":"O you who have believed, if you support Allāh, He will support you and plant firmly your feet.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":4,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":5,"arabic":"تَنصُرُوا۟","translit":"۟āwُrُṣnَt","root":"نصر"},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"يَنصُرْكُمْ","translit":"ْmُkْrُṣnَy","root":"نصر"},{"id":8,"arabic":"وَيُثَبِّتْ","translit":"ْtِّbَhtُyَw","root":"ثبت"},{"id":9,"arabic":"أَقْدَامَكُمْ","translit":"ْmُkَmāَdْqَaʾ","root":"قدم"}],"hasIhya":true},{"ayah":8,"text":"وَٱلَّذِينَ كَفَرُوا۟ فَتَعْسًا لَّهُمْ وَأَضَلَّ أَعْمَٰلَهُمْ ","translation":"But those who disbelieve - for them is misery, and He will waste their deeds.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":3,"arabic":"فَتَعْسًا","translit":"āًsْʿعَtَf","root":"تعس"},{"id":4,"arabic":"لَّهُمْ","translit":"ْmُhَّl","root":""},{"id":5,"arabic":"وَأَضَلَّ","translit":"َّlَḍَaʾَw","root":"ضلل"},{"id":6,"arabic":"أَعْمَٰلَهُمْ","translit":"ْmُhَlَٰmْʿعَaʾ","root":"عمل"}],"hasIhya":false},{"ayah":9,"text":"ذَٰلِكَ بِأَنَّهُمْ كَرِهُوا۟ مَآ أَنزَلَ ٱللَّهُ فَأَحْبَطَ أَعْمَٰلَهُمْ ","translation":"That is because they disliked what Allāh revealed, so He rendered worthless their deeds.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"بِأَنَّهُمْ","translit":"ْmُhَّnَaʾِb","root":""},{"id":3,"arabic":"كَرِهُوا۟","translit":"۟āwُhِrَk","root":"كره"},{"id":4,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":5,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"فَأَحْبَطَ","translit":"َṭَbْḥَaʾَf","root":"حبط"},{"id":8,"arabic":"أَعْمَٰلَهُمْ","translit":"ْmُhَlَٰmْʿعَaʾ","root":"عمل"}],"hasIhya":false},{"ayah":10,"text":"أَفَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْۚ دَمَّرَ ٱللَّهُ عَلَيْهِمْۖ وَلِلْكَٰفِرِينَ أَمْثَٰلُهَا ","translation":"Have they not traveled through the land and seen how was the end of those before them? Allāh destroyed [everything] over them,[1] and for the disbelievers is something comparable.","words":[{"id":1,"arabic":"أَفَلَمْ","translit":"ْmَlَfَaʾ","root":""},{"id":2,"arabic":"يَسِيرُوا۟","translit":"۟āwُryِsَy","root":"سير"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"فَيَنظُرُوا۟","translit":"۟āwُrُẓnَyَf","root":"نظر"},{"id":6,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":7,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":8,"arabic":"عَٰقِبَةُ","translit":"ُẗَbِqَٰʿع","root":"عقب"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"قَبْلِهِمْ","translit":"ْmِhِlْbَq","root":"قبل"},{"id":12,"arabic":"دَمَّرَ","translit":"َrَّmَd","root":"دمر"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":15,"arabic":"وَلِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِlَw","root":"كفر"},{"id":16,"arabic":"أَمْثَٰلُهَا","translit":"āَhُlَٰhtْmَaʾ","root":"مثل"}],"hasIhya":false},{"ayah":11,"text":"ذَٰلِكَ بِأَنَّ ٱللَّهَ مَوْلَى ٱلَّذِينَ ءَامَنُوا۟ وَأَنَّ ٱلْكَٰفِرِينَ لَا مَوْلَىٰ لَهُمْ ","translation":"That is because Allāh is the protector of those who have believed and because the disbelievers have no protector.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"بِأَنَّ","translit":"َّnَaʾِb","root":""},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"مَوْلَى","translit":"àَlْwَm","root":"ولي"},{"id":5,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":6,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":7,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":8,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"},{"id":9,"arabic":"لَا","translit":"āَl","root":""},{"id":10,"arabic":"مَوْلَىٰ","translit":"ٰàَlْwَm","root":"ولي"},{"id":11,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""}],"hasIhya":false},{"ayah":12,"text":"إِنَّ ٱللَّهَ يُدْخِلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۖ وَٱلَّذِينَ كَفَرُوا۟ يَتَمَتَّعُونَ وَيَأْكُلُونَ كَمَا تَأْكُلُ ٱلْأَنْعَٰمُ وَٱلنَّارُ مَثْوًى لَّهُمْ ","translation":"Indeed, Allāh will admit those who have believed and done righteous deeds to gardens beneath which rivers flow, but those who disbelieve enjoy themselves and eat as grazing livestock eat, and the Fire will be a residence for them.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"يُدْخِلُ","translit":"ُlِhkْdُy","root":"دخل"},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":6,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":7,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":8,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":9,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":12,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":13,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":14,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":15,"arabic":"يَتَمَتَّعُونَ","translit":"َnwُʿعَّtَmَtَy","root":"متع"},{"id":16,"arabic":"وَيَأْكُلُونَ","translit":"َnwُlُkْaʾَyَw","root":"اكل"},{"id":17,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":18,"arabic":"تَأْكُلُ","translit":"ُlُkْaʾَt","root":"اكل"},{"id":19,"arabic":"ٱلْأَنْعَٰمُ","translit":"ُmَٰʿعْnَaʾْlٱ","root":"نعم"},{"id":20,"arabic":"وَٱلنَّارُ","translit":"ُrāَّnlٱَw","root":"نور"},{"id":21,"arabic":"مَثْوًى","translit":"àًwْhtَm","root":"ثوي"},{"id":22,"arabic":"لَّهُمْ","translit":"ْmُhَّl","root":""}],"hasIhya":true},{"ayah":13,"text":"وَكَأَيِّن مِّن قَرْيَةٍ هِىَ أَشَدُّ قُوَّةً مِّن قَرْيَتِكَ ٱلَّتِىٓ أَخْرَجَتْكَ أَهْلَكْنَٰهُمْ فَلَا نَاصِرَ لَهُمْ ","translation":"And how many a city was stronger than your city [i.e., Makkah] which drove you out? We destroyed them; and there was no helper for them.","words":[{"id":1,"arabic":"وَكَأَيِّن","translit":"nِّyَaʾَkَw","root":""},{"id":2,"arabic":"مِّن","translit":"nِّm","root":""},{"id":3,"arabic":"قَرْيَةٍ","translit":"ٍẗَyْrَq","root":"قري"},{"id":4,"arabic":"هِىَ","translit":"َàِh","root":""},{"id":5,"arabic":"أَشَدُّ","translit":"ُّdَhsَaʾ","root":"شدد"},{"id":6,"arabic":"قُوَّةً","translit":"ًẗَّwُq","root":"قوي"},{"id":7,"arabic":"مِّن","translit":"nِّm","root":""},{"id":8,"arabic":"قَرْيَتِكَ","translit":"َkِtَyْrَq","root":"قري"},{"id":9,"arabic":"ٱلَّتِىٓ","translit":"ٓàِtَّlٱ","root":""},{"id":10,"arabic":"أَخْرَجَتْكَ","translit":"َkْtَjgَrْhkَaʾ","root":"خرج"},{"id":11,"arabic":"أَهْلَكْنَٰهُمْ","translit":"ْmُhَٰnْkَlْhَaʾ","root":"هلك"},{"id":12,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":13,"arabic":"نَاصِرَ","translit":"َrِṣāَn","root":"نصر"},{"id":14,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""}],"hasIhya":false},{"ayah":14,"text":"أَفَمَن كَانَ عَلَىٰ بَيِّنَةٍ مِّن رَّبِّهِۦ كَمَن زُيِّنَ لَهُۥ سُوٓءُ عَمَلِهِۦ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُم ","translation":"So is he who is on clear evidence from his Lord like him to whom the evil of his work has been made attractive and they follow their [own] desires?","words":[{"id":1,"arabic":"أَفَمَن","translit":"nَmَfَaʾ","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"بَيِّنَةٍ","translit":"ٍẗَnِّyَb","root":"بين"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"رَّبِّهِۦ","translit":"ۦِhِّbَّr","root":"ربب"},{"id":7,"arabic":"كَمَن","translit":"nَmَk","root":""},{"id":8,"arabic":"زُيِّنَ","translit":"َnِّyُz","root":"زين"},{"id":9,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":10,"arabic":"سُوٓءُ","translit":"ُءٓwُs","root":"سوا"},{"id":11,"arabic":"عَمَلِهِۦ","translit":"ۦِhِlَmَʿع","root":"عمل"},{"id":12,"arabic":"وَٱتَّبَعُوٓا۟","translit":"۟āٓwُʿعَbَّtٱَw","root":"تبع"},{"id":13,"arabic":"أَهْوَآءَهُم","translit":"mُhَءٓāَwْhَaʾ","root":"هوي"}],"hasIhya":true},{"ayah":15,"text":"مَّثَلُ ٱلْجَنَّةِ ٱلَّتِى وُعِدَ ٱلْمُتَّقُونَۖ فِيهَآ أَنْهَٰرٌ مِّن مَّآءٍ غَيْرِ ءَاسِنٍ وَأَنْهَٰرٌ مِّن لَّبَنٍ لَّمْ يَتَغَيَّرْ طَعْمُهُۥ وَأَنْهَٰرٌ مِّنْ خَمْرٍ لَّذَّةٍ لِّلشَّٰرِبِينَ وَأَنْهَٰرٌ مِّنْ عَسَلٍ مُّصَفًّىۖ وَلَهُمْ فِيهَا مِن كُلِّ ٱلثَّمَرَٰتِ وَمَغْفِرَةٌ مِّن رَّبِّهِمْۖ كَمَنْ هُوَ خَٰلِدٌ فِى ٱلنَّارِ وَسُقُوا۟ مَآءً حَمِيمًا فَقَطَّعَ أَمْعَآءَهُمْ ","translation":"Is the description of Paradise, which the righteous are promised, wherein are rivers of water unaltered,[1] rivers of milk the taste of which never changes, rivers of wine delicious to those who drink, and rivers of purified honey, in which they will have from all [kinds of] fruits and forgiveness from their Lord... [Are its inhabitants] like those who abide eternally in the Fire and are given to drink scalding water that will sever their intestines?","words":[{"id":1,"arabic":"مَّثَلُ","translit":"ُlَhtَّm","root":"مثل"},{"id":2,"arabic":"ٱلْجَنَّةِ","translit":"ِẗَّnَjgْlٱ","root":"جنن"},{"id":3,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":4,"arabic":"وُعِدَ","translit":"َdِʿعُw","root":"وعد"},{"id":5,"arabic":"ٱلْمُتَّقُونَ","translit":"َnwُqَّtُmْlٱ","root":"وقي"},{"id":6,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":7,"arabic":"أَنْهَٰرٌ","translit":"ٌrَٰhْnَaʾ","root":"نهر"},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"مَّآءٍ","translit":"ٍءٓāَّm","root":"موه"},{"id":10,"arabic":"غَيْرِ","translit":"ِrْyَغ","root":"غير"},{"id":11,"arabic":"ءَاسِنٍ","translit":"ٍnِsāَء","root":"اسن"},{"id":12,"arabic":"وَأَنْهَٰرٌ","translit":"ٌrَٰhْnَaʾَw","root":"نهر"},{"id":13,"arabic":"مِّن","translit":"nِّm","root":""},{"id":14,"arabic":"لَّبَنٍ","translit":"ٍnَbَّl","root":"لبن"},{"id":15,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":16,"arabic":"يَتَغَيَّرْ","translit":"ْrَّyَغَtَy","root":"غير"},{"id":17,"arabic":"طَعْمُهُۥ","translit":"ۥُhُmْʿعَṭ","root":"طعم"},{"id":18,"arabic":"وَأَنْهَٰرٌ","translit":"ٌrَٰhْnَaʾَw","root":"نهر"},{"id":19,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":20,"arabic":"خَمْرٍ","translit":"ٍrْmَhk","root":"خمر"},{"id":21,"arabic":"لَّذَّةٍ","translit":"ٍẗَّhdَّl","root":"لذذ"},{"id":22,"arabic":"لِّلشَّٰرِبِينَ","translit":"َnyِbِrَّٰhslِّl","root":"شرب"},{"id":23,"arabic":"وَأَنْهَٰرٌ","translit":"ٌrَٰhْnَaʾَw","root":"نهر"},{"id":24,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":25,"arabic":"عَسَلٍ","translit":"ٍlَsَʿع","root":"عسل"},{"id":26,"arabic":"مُّصَفًّى","translit":"àًّfَṣُّm","root":"صفو"},{"id":27,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":28,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":29,"arabic":"مِن","translit":"nِm","root":""},{"id":30,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":31,"arabic":"ٱلثَّمَرَٰتِ","translit":"ِtَٰrَmَّhtlٱ","root":"ثمر"},{"id":32,"arabic":"وَمَغْفِرَةٌ","translit":"ٌẗَrِfْغَmَw","root":"غفر"},{"id":33,"arabic":"مِّن","translit":"nِّm","root":""},{"id":34,"arabic":"رَّبِّهِمْ","translit":"ْmِhِّbَّr","root":"ربب"},{"id":35,"arabic":"كَمَنْ","translit":"ْnَmَk","root":""},{"id":36,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":37,"arabic":"خَٰلِدٌ","translit":"ٌdِlَٰhk","root":"خلد"},{"id":38,"arabic":"فِى","translit":"àِf","root":""},{"id":39,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":40,"arabic":"وَسُقُوا۟","translit":"۟āwُqُsَw","root":"سقي"},{"id":41,"arabic":"مَآءً","translit":"ًءٓāَm","root":"موه"},{"id":42,"arabic":"حَمِيمًا","translit":"āًmyِmَḥ","root":"حمم"},{"id":43,"arabic":"فَقَطَّعَ","translit":"َʿعَّṭَqَf","root":"قطع"},{"id":44,"arabic":"أَمْعَآءَهُمْ","translit":"ْmُhَءٓāَʿعْmَaʾ","root":"معي"}],"hasIhya":true},{"ayah":16,"text":"وَمِنْهُم مَّن يَسْتَمِعُ إِلَيْكَ حَتَّىٰٓ إِذَا خَرَجُوا۟ مِنْ عِندِكَ قَالُوا۟ لِلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ مَاذَا قَالَ ءَانِفًاۚ أُو۟لَٰٓئِكَ ٱلَّذِينَ طَبَعَ ٱللَّهُ عَلَىٰ قُلُوبِهِمْ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْ ","translation":"And among them, [O Muḥammad], are those who listen to you, until when they depart from you, they say to those who were given knowledge,[1] \"What has he said just now?\" Those are the ones of whom Allāh has sealed over their hearts and who have followed their [own] desires.","words":[{"id":1,"arabic":"وَمِنْهُم","translit":"mُhْnِmَw","root":""},{"id":2,"arabic":"مَّن","translit":"nَّm","root":""},{"id":3,"arabic":"يَسْتَمِعُ","translit":"ُʿعِmَtْsَy","root":"سمع"},{"id":4,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":5,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":6,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":7,"arabic":"خَرَجُوا۟","translit":"۟āwُjgَrَhk","root":"خرج"},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"عِندِكَ","translit":"َkِdnِʿع","root":"عند"},{"id":10,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":11,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":12,"arabic":"أُوتُوا۟","translit":"۟āwُtwُaʾ","root":"اتي"},{"id":13,"arabic":"ٱلْعِلْمَ","translit":"َmْlِʿعْlٱ","root":"علم"},{"id":14,"arabic":"مَاذَا","translit":"āَhdāَm","root":""},{"id":15,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":16,"arabic":"ءَانِفًا","translit":"āًfِnāَء","root":"انف"},{"id":17,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":18,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":19,"arabic":"طَبَعَ","translit":"َʿعَbَṭ","root":"طبع"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":22,"arabic":"قُلُوبِهِمْ","translit":"ْmِhِbwُlُq","root":"قلب"},{"id":23,"arabic":"وَٱتَّبَعُوٓا۟","translit":"۟āٓwُʿعَbَّtٱَw","root":"تبع"},{"id":24,"arabic":"أَهْوَآءَهُمْ","translit":"ْmُhَءٓāَwْhَaʾ","root":"هوي"}],"hasIhya":true},{"ayah":17,"text":"وَٱلَّذِينَ ٱهْتَدَوْا۟ زَادَهُمْ هُدًى وَءَاتَىٰهُمْ تَقْوَىٰهُمْ ","translation":"And those who are guided - He increases them in guidance and gives them their righteousness.[1]","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"ٱهْتَدَوْا۟","translit":"۟āْwَdَtْhٱ","root":"هدي"},{"id":3,"arabic":"زَادَهُمْ","translit":"ْmُhَdāَz","root":"زيد"},{"id":4,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"},{"id":5,"arabic":"وَءَاتَىٰهُمْ","translit":"ْmُhٰàَtāَءَw","root":"اتي"},{"id":6,"arabic":"تَقْوَىٰهُمْ","translit":"ْmُhٰàَwْqَt","root":"وقي"}],"hasIhya":true},{"ayah":18,"text":"فَهَلْ يَنظُرُونَ إِلَّا ٱلسَّاعَةَ أَن تَأْتِيَهُم بَغْتَةًۖ فَقَدْ جَآءَ أَشْرَاطُهَاۚ فَأَنَّىٰ لَهُمْ إِذَا جَآءَتْهُمْ ذِكْرَىٰهُمْ ","translation":"Then do they await except that the Hour should come upon them unexpectedly? But already there have come [some of] its indications. Then how [i.e., what good] to them, when it has come, will be their remembrance?","words":[{"id":1,"arabic":"فَهَلْ","translit":"ْlَhَf","root":""},{"id":2,"arabic":"يَنظُرُونَ","translit":"َnwُrُẓnَy","root":"نظر"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"ٱلسَّاعَةَ","translit":"َẗَʿعāَّslٱ","root":"سوع"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"تَأْتِيَهُم","translit":"mُhَyِtْaʾَt","root":"اتي"},{"id":7,"arabic":"بَغْتَةً","translit":"ًẗَtْغَb","root":"بغت"},{"id":8,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":9,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":10,"arabic":"أَشْرَاطُهَا","translit":"āَhُṭāَrْhsَaʾ","root":"شرط"},{"id":11,"arabic":"فَأَنَّىٰ","translit":"ٰàَّnَaʾَf","root":""},{"id":12,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":13,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":14,"arabic":"جَآءَتْهُمْ","translit":"ْmُhْtَءٓāَjg","root":"جيا"},{"id":15,"arabic":"ذِكْرَىٰهُمْ","translit":"ْmُhٰàَrْkِhd","root":"ذكر"}],"hasIhya":false},{"ayah":19,"text":"فَٱعْلَمْ أَنَّهُۥ لَآ إِلَٰهَ إِلَّا ٱللَّهُ وَٱسْتَغْفِرْ لِذَنۢبِكَ وَلِلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِۗ وَٱللَّهُ يَعْلَمُ مُتَقَلَّبَكُمْ وَمَثْوَىٰكُمْ ","translation":"So know, [O Muḥammad], that there is no deity except Allāh and ask forgiveness for your sin[1] and for the believing men and believing women. And Allāh knows of your movement and your resting place.","words":[{"id":1,"arabic":"فَٱعْلَمْ","translit":"ْmَlْʿعٱَf","root":"علم"},{"id":2,"arabic":"أَنَّهُۥ","translit":"ۥُhَّnَaʾ","root":""},{"id":3,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":4,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"وَٱسْتَغْفِرْ","translit":"ْrِfْغَtْsٱَw","root":"غفر"},{"id":8,"arabic":"لِذَنۢبِكَ","translit":"َkِbۢnَhdِl","root":"ذنب"},{"id":9,"arabic":"وَلِلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlِlَw","root":"امن"},{"id":10,"arabic":"وَٱلْمُؤْمِنَٰتِ","translit":"ِtَٰnِmْwʾُmْlٱَw","root":"امن"},{"id":11,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":12,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":13,"arabic":"مُتَقَلَّبَكُمْ","translit":"ْmُkَbَّlَqَtُm","root":"قلب"},{"id":14,"arabic":"وَمَثْوَىٰكُمْ","translit":"ْmُkٰàَwْhtَmَw","root":"ثوي"}],"hasIhya":true},{"ayah":20,"text":"وَيَقُولُ ٱلَّذِينَ ءَامَنُوا۟ لَوْلَا نُزِّلَتْ سُورَةٌۖ فَإِذَآ أُنزِلَتْ سُورَةٌ مُّحْكَمَةٌ وَذُكِرَ فِيهَا ٱلْقِتَالُۙ رَأَيْتَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ يَنظُرُونَ إِلَيْكَ نَظَرَ ٱلْمَغْشِىِّ عَلَيْهِ مِنَ ٱلْمَوْتِۖ فَأَوْلَىٰ لَهُمْ ","translation":"Those who believe say, \"Why has a sūrah[1] not been sent down?\" But when a precise sūrah is revealed and battle is mentioned therein, you see those in whose hearts is disease [i.e., hypocrisy] looking at you with a look of one overcome by death. And more appropriate for them[2] [would have been]","words":[{"id":1,"arabic":"وَيَقُولُ","translit":"ُlwُqَyَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَوْلَا","translit":"āَlْwَl","root":""},{"id":5,"arabic":"نُزِّلَتْ","translit":"ْtَlِّzُn","root":"نزل"},{"id":6,"arabic":"سُورَةٌ","translit":"ٌẗَrwُs","root":"سور"},{"id":7,"arabic":"فَإِذَآ","translit":"ٓāَhdِiʾَf","root":""},{"id":8,"arabic":"أُنزِلَتْ","translit":"ْtَlِznُaʾ","root":"نزل"},{"id":9,"arabic":"سُورَةٌ","translit":"ٌẗَrwُs","root":"سور"},{"id":10,"arabic":"مُّحْكَمَةٌ","translit":"ٌẗَmَkْḥُّm","root":"حكم"},{"id":11,"arabic":"وَذُكِرَ","translit":"َrِkُhdَw","root":"ذكر"},{"id":12,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":13,"arabic":"ٱلْقِتَالُ","translit":"ُlāَtِqْlٱ","root":"قتل"},{"id":14,"arabic":"رَأَيْتَ","translit":"َtْyَaʾَr","root":"راي"},{"id":15,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":16,"arabic":"فِى","translit":"àِf","root":""},{"id":17,"arabic":"قُلُوبِهِم","translit":"mِhِbwُlُq","root":"قلب"},{"id":18,"arabic":"مَّرَ