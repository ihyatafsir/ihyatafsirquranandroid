ic": "يَّسْـَٔلْكُمُوهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فَيُحْفِكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَبْخَلُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيُخْرِجَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَضْغَٰنَكُمْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 47, "ayah": 38, "text": "هَآنتُمْ هَٰٓؤُلَآءِ تُدْعَوْنَ لِتُنفِقُواْ فِے سَبِيلِ اِ۬للَّهِ فَمِنكُم مَّنْ يَّبْخَلُۖ وَمَنْ يَّبْخَلْ فَإِنَّمَا يَبْخَلُ عَن نَّفْسِهِۦۖ وَاللَّهُ اُ۬لْغَنِيُّۖ وَأَنتُمُ اُ۬لْفُقَرَآءُۖ وَإِن تَتَوَلَّوْاْ يَسْتَبْدِلْ قَوْماً غَيْرَكُمْ ثُمَّ لَا يَكُونُوٓاْ أَمْثَٰلَكُمُۥٓۖ", "words": [{"id": 1, "arabic": "هَآنتُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 3, "arabic": "تُدْعَوْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِتُنفِقُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَمِنكُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَّبْخَلُۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَّبْخَلْ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَإِنَّمَا", "translit": "", "root": ""}, {"id": 14, "arabic": "يَبْخَلُ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَن", "translit": "", "root": ""}, {"id": 16, "arabic": "نَّفْسِهِۦۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 18, "arabic": "اُ۬لْغَنِيُّۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَأَنتُمُ", "translit": "", "root": ""}, {"id": 20, "arabic": "اُ۬لْفُقَرَآءُۖ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَإِن", "translit": "", "root": ""}, {"id":