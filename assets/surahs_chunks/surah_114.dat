2982], [4, 2982, 3969], [5, 3969, 7348]], "5": [[1, 756, 1512], [2, 1512, 2583], [3, 2583, 2982], [4, 2982, 3969], [5, 3969, 7348]], "114:6": [[1, 357, 588], [2, 588, 2499], [3, 2499, 6721]], "6": [[1, 357, 588], [2, 588, 2499], [3, 2499, 6721]]}}, "letterTiming": {"abdulbasit": {"114:1": [{"wordIdx": 0, "charIdx": 0, "char": "ق", "grapheme": "قُ", "start": 350, "end": 641, "duration": 291, "peakTime": 496}, {"wordIdx": 0, "charIdx": 1, "char": "ل", "grapheme": "لْ", "start": 641, "end": 884, "duration": 243, "peakTime": 762}, {"wordIdx": 1, "charIdx": 0, "char": "أ", "grapheme": "أَ", "start": 884, "end": 1175, "duration": 291, "peakTime": 1030}, {"wordIdx": 1, "charIdx": 1, "char": "ع", "grapheme": "عُ", "start": 1175, "end": 1466, "duration": 291, "peakTime": 1320}, {"wordIdx": 1, "charIdx": 2, "char": "و", "grapheme": "و", "start": 1466, "end": 1830, "duration": 364, "peakTime": 1648}, {"wordIdx": 1, "charIdx": 3, "char": "ذ", "grapheme": "ذُ", "start": 1830, "end": 2098, "duration": 268, "peakTime": 1964}, {"wordIdx": 2, "charIdx": 0, "char": "ب", "grapheme": "بِ", "start": 2098, "end": 2341, "duration": 243, "peakTime": 2220}, {"wordIdx": 2, "charIdx": 1, "char": "ر", "grapheme": "رَ", "start": 2341, "end": 2584, "duration": 243, "peakTime": 2462}, {"wordIdx": 2, "charIdx": 2, "char": "ب", "grapheme": "بِّ", "start": 2584, "end": 3008, "duration": 424, "peakTime": 2796}, {"wordIdx": 3, "charIdx": 0, "char": "ٱ", "grapheme": "ٱ", "start": 3008, "end": 3081, "duration": 73, "peakTime": 3044}, {"wordIdx": 3, "charIdx": 1, "char": "ل", "grapheme": "ل", "start": 3081, "end": 3324, "duration": 243, "peakTime": 3202}, {"wordIdx": 3, "charIdx": 2, "char": "ن", "grapheme": "نَّ", "start": 3324, "end": 3918, "duration": 594, "peakTime": 3621}, {"wordIdx": 3, "charIdx": 3, "char": "ا", "grapheme": "ا", "start": 3918, "end": 4306, "duration": 388, "peakTime": 4112}, {"wordIdx": 3, "charIdx": 4, "char": "س", "grapheme": "سِ", "start": 4306, "end": 4573, "duration": 267, "p