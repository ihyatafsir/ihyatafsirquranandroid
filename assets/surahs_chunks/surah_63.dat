ُۥۖ وَاللَّهُ يَشْهَدُ إِنَّ اَ۬لْمُنَٰفِقِينَ لَكَٰذِبُونَۖ", "words": [{"id": 1, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْمُنَٰفِقُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَشْهَدُ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَرَسُولُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَرَسُولُهُۥۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 14, "arabic": "يَشْهَدُ", "translit": "", "root": ""}, {"id": 15, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لْمُنَٰفِقِينَ", "translit": "", "root": ""}, {"id": 17, "arabic": "لَكَٰذِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 63, "ayah": 2, "text": "اَ۪تَّخَذُوٓاْ أَيْمَٰنَهُمْ جُنَّةࣰ فَصَدُّواْ عَن سَبِيلِ اِ۬للَّهِۖ إِنَّهُمْ سَآءَ مَا كَانُواْ يَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "اَ۪تَّخَذُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَيْمَٰنَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "جُنَّةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَصَدُّواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَن", "translit": "", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَآءَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "", "root": ""}, {"id": 11, "arabic": "كَانُواْ", "translit": "", "r