{"surah": 45, "verses": [{"ayah": 1, "text": "حمٓ ", "translation": "Ḥā, Meem.[1]", "words": [{"id": 1, "arabic": "حمٓ", "translit": "ٓmḥ", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "تَنزِيلُ ٱلْكِتَٰبِ مِنَ ٱللَّهِ ٱلْعَزِيزِ ٱلْحَكِيمِ ", "translation": "The revelation of the Book is from Allāh, the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "تَنزِيلُ", "translit": "ُlyِznَt", "root": "نزل"}, {"id": 2, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 6, "arabic": "ٱلْحَكِيمِ", "translit": "ِmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 3, "text": "إِنَّ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ لَءَايَٰتٍ لِّلْمُؤْمِنِينَ ", "translation": "Indeed, within the heavens and earth are signs for the believers.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 6, "arabic": "لِّلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِّl", "root": "امن"}], "hasIhya": false}, {"ayah": 4, "text": "وَفِى خَلْقِكُمْ وَمَا يَبُثُّ مِن دَآبَّةٍ ءَايَٰتٌ لِّقَوْمٍ يُوقِنُونَ ", "translation": "And in the creation of yourselves and what He disperses of moving creatures are signs for people who are certain [in faith].", "words": [{"id": 1, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 2, "arabic": "خَلْقِكُمْ", "translit": "ْmُkِqْlَhk", "root": "خلق"}, {"id": 3, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 4, "arabic": "يَبُثُّ", "translit": "ُّhtُbَy", "root": "بثث"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 7, "arabic": "ءَايَٰتٌ", "translit": "ٌtَٰyāَء", "root": "ايي"}, {"id": 8, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 9, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 5, "text": "وَٱخْتِلَٰفِ ٱلَّيْلِ وَٱلنَّهَارِ وَمَآ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَآءِ مِن رِّزْقٍ فَأَحْيَا بِهِ ٱلْأَرْضَ بَعْدَ مَوْتِهَا وَتَصْرِيفِ ٱلرِّيَٰحِ ءَايَٰتٌ لِّقَوْمٍ يَعْقِلُونَ ", "translation": "And [in] the alternation of night and day and [in] what Allāh sends down from the sky of provision [i.e., rain] and gives life thereby to the earth after its lifelessness and [in His] directing of the winds are signs for a people who reason.", "words": [{"id": 1, "arabic": "وَٱخْتِلَٰفِ", "translit": "ِfَٰlِtْhkٱَw", "root": "خلف"}, {"id": 2, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 3, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 4, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "رِّزْقٍ", "translit": "ٍqْzِّr", "root": "رزق"}, {"id": 11, "arabic": "فَأَحْيَا", "translit": "āَyْḥَaʾَf", "root": "حيي"}, {"id": 12, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 13, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 14, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "مَوْتِهَا", "translit": "āَhِtْwَm", "root": "موت"}, {"id": 16, "arabic": "وَتَصْرِيفِ", "translit": "ِfyِrْṣَtَw", "root": "صرف"}, {"id": 17, "arabic": "ٱلرِّيَٰحِ", "translit": "ِḥَٰyِّrlٱ", "root": "روح"}, {"id": 18, "arabic": "ءَايَٰتٌ", "translit": "ٌtَٰyāَء", "root": "ايي"}, {"id": 19, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 20, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 6, "text": "تِلْكَ ءَايَٰتُ ٱللَّهِ نَتْلُوهَا عَلَيْكَ بِٱلْحَقِّۖ فَبِأَىِّ حَدِيثٍۭ بَعْدَ ٱللَّهِ وَءَايَٰتِهِۦ يُؤْمِنُونَ ", "translation": "These are the verses of Allāh which We recite to you in truth. Then in what statement after Allāh and His verses will they believe?", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "نَتْلُوهَا", "translit": "āَhwُlْtَn", "root": "تلو"}, {"id": 5, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 7, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 8, "arabic": "حَدِيثٍۭ", "translit": "ٍۭhtyِdَḥ", "root": "حدث"}, {"id": 9, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَءَw", "root": "ايي"}, {"id": 12, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 7, "text": "وَيْلٌ لِّكُلِّ أَفَّاكٍ أَثِيمٍ ", "translation": "Woe to every sinful liar", "words": [{"id": 1, "arabic": "وَيْلٌ", "translit": "ٌlْyَw", "root": ""}, {"id": 2, "arabic": "لِّكُلِّ", "translit": "ِّlُkِّl", "root": "كلل"}, {"id": 3, "arabic": "أَفَّاكٍ", "translit": "ٍkāَّfَaʾ", "root": "افك"}, {"id": 4, "arabic": "أَثِيمٍ", "translit": "ٍmyِhtَaʾ", "root": "اثم"}], "hasIhya": false}, {"ayah": 8, "text": "يَسْمَعُ ءَايَٰتِ ٱللَّهِ تُتْلَىٰ عَلَيْهِ ثُمَّ يُصِرُّ مُسْتَكْبِرًا كَأَن لَّمْ يَسْمَعْهَاۖ فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍ ", "translation": "Who hears the verses of Allāh recited to him, then persists arrogantly as if he had not heard them. So give him tidings of a painful punishment.", "words": [{"id": 1, "arabic": "يَسْمَعُ", "translit": "ُʿعَmْsَy", "root": "سمع"}, {"id": 2, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "يُصِرُّ", "translit": "ُّrِṣُy", "root": "صرر"}, {"id": 8, "arabic": "مُسْتَكْبِرًا", "translit": "āًrِbْkَtْsُm", "root": "كبر"}, {"id": 9, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 10, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 11, "arabic": "يَسْمَعْهَا", "translit": "āَhْʿعَmْsَy", "root": "سمع"}, {"id": 12, "arabic": "فَبَشِّرْهُ", "translit": "ُhْrِّhsَbَf", "root": "بشر"}, {"id": 13, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 14, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 9, "text": "وَإِذَا عَلِمَ مِنْ ءَايَٰتِنَا شَيْـًٔا ٱتَّخَذَهَا هُزُوًاۚ أُو۟لَٰٓئِكَ لَهُمْ عَذَابٌ مُّهِينٌ ", "translation": "And when he knows anything of Our verses, he takes them in ridicule. Those will have a humiliating punishment.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 6, "arabic": "ٱتَّخَذَهَا", "translit": "āَhَhdَhkَّtٱ", "root": "اخذ"}, {"id": 7, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 8, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 11, "arabic": "مُّهِينٌ", "translit": "ٌnyِhُّm", "root": "هون"}], "hasIhya": false}, {"ayah": 10, "text": "مِّن وَرَآئِهِمْ جَهَنَّمُۖ وَلَا يُغْنِى عَنْهُم مَّا كَسَبُوا۟ شَيْـًٔا وَلَا مَا ٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ أَوْلِيَآءَۖ وَلَهُمْ عَذَابٌ عَظِيمٌ ", "translation": "Before them[1] is Hell, and what they had earned will not avail them at all nor what they had taken besides Allāh as allies. And they will have a great punishment.", "words": [{"id": 1, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 2, "arabic": "وَرَآئِهِمْ", "translit": "ْmِhِyʾٓāَrَw", "root": "وري"}, {"id": 3, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "يُغْنِى", "translit": "àِnْغُy", "root": "غني"}, {"id": 6, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 9, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 17, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 18, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 19, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 11, "text": "هَٰذَا هُدًىۖ وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِ رَبِّهِمْ لَهُمْ عَذَابٌ مِّن رِّجْزٍ أَلِيمٌ ", "translation": "This [Qur’ān] is guidance. And those who have disbelieved in the verses of their Lord will have a painful punishment of foul nature.", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 3, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 6, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 7, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 8, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "رِّجْزٍ", "translit": "ٍzْjgِّr", "root": "رجز"}, {"id": 11, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 12, "text": "ٱللَّهُ ٱلَّذِى سَخَّرَ لَكُمُ ٱلْبَحْرَ لِتَجْرِىَ ٱلْفُلْكُ فِيهِ بِأَمْرِهِۦ وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَ ", "translation": "It is Allāh who subjected to you the sea so that ships may sail upon it by His command and that you may seek of His bounty; and perhaps you will be grateful.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "سَخَّرَ", "translit": "َrَّhkَs", "root": "سخر"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلْبَحْرَ", "translit": "َrْḥَbْlٱ", "root": "بحر"}, {"id": 6, "arabic": "لِتَجْرِىَ", "translit": "َàِrْjgَtِl", "root": "جري"}, {"id": 7, "arabic": "ٱلْفُلْكُ", "translit": "ُkْlُfْlٱ", "root": "فلك"}, {"id": 8, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 9, "arabic": "بِأَمْرِهِۦ", "translit": "ۦِhِrْmَaʾِb", "root": "امر"}, {"id": 10, "arabic": "وَلِتَبْتَغُوا۟", "translit": "۟āwُغَtْbَtِlَw", "root": "بغي"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 13, "arabic": "وَلَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَlَw", "root": ""}, {"id": 14, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 13, "text": "وَسَخَّرَ لَكُم مَّا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ جَمِيعًا مِّنْهُۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يَتَفَكَّرُونَ ", "translation": "And He has subjected to you whatever is in the heavens and whatever is on the earth - all from Him. Indeed in that are signs for a people who give thought.", "words": [{"id": 1, "arabic": "وَسَخَّرَ", "translit": "َrَّhkَsَw", "root": "سخر"}, {"id": 2, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 3, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 10, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 14, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 15, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 16, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": true}, {"ayah": 14, "text": "قُل لِّلَّذِينَ ءَامَنُوا۟ يَغْفِرُوا۟ لِلَّذِينَ لَا يَرْجُونَ أَيَّامَ ٱللَّهِ لِيَجْزِىَ قَوْمًۢا بِمَا كَانُوا۟ يَكْسِبُونَ ", "translation": "Say, [O Muḥammad], to those who have believed that they [should] forgive those who expect not the days of Allāh [i.e., of His retribution] so that He may recompense a people[1] for what they used to earn.", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "يَغْفِرُوا۟", "translit": "۟āwُrِfْغَy", "root": "غفر"}, {"id": 5, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 8, "arabic": "أَيَّامَ", "translit": "َmāَّyَaʾ", "root": "يوم"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لِيَجْزِىَ", "translit": "َàِzْjgَyِl", "root": "جزي"}, {"id": 11, "arabic": "قَوْمًۢا", "translit": "āًۢmْwَq", "root": "قوم"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": false}, {"ayah": 15, "text": "مَنْ عَمِلَ صَٰلِحًا فَلِنَفْسِهِۦۖ وَمَنْ أَسَآءَ فَعَلَيْهَاۖ ثُمَّ إِلَىٰ رَبِّكُمْ تُرْجَعُونَ ", "translation": "Whoever does a good deed - it is for himself; and whoever does evil - it is against it [i.e., the self or soul]. Then to your Lord you will be returned.", "words": [{"id": 1, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 2, "arabic": "عَمِلَ", "translit": "َlِmَʿع", "root": "عمل"}, {"id": 3, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 4, "arabic": "فَلِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِlَf", "root": "نفس"}, {"id": 5, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 6, "arabic": "أَسَآءَ", "translit": "َءٓāَsَaʾ", "root": "سوا"}, {"id": 7, "arabic": "فَعَلَيْهَا", "translit": "āَhْyَlَʿعَf", "root": ""}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "رَبِّكُمْ", "translit": "ْmُkِّbَr", "root": "ربب"}, {"id": 11, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": true}, {"ayah": 16, "text": "وَلَقَدْ ءَاتَيْنَا بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَٰبَ وَٱلْحُكْمَ وَٱلنُّبُوَّةَ وَرَزَقْنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ وَفَضَّلْنَٰهُمْ عَلَى ٱلْعَٰلَمِينَ ", "translation": "And We did certainly give the Children of Israel the Scripture and judgement[1] and prophethood, and We provided them with good things and preferred them over the worlds.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 4, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "وَٱلْحُكْمَ", "translit": "َmْkُḥْlٱَw", "root": "حكم"}, {"id": 7, "arabic": "وَٱلنُّبُوَّةَ", "translit": "َẗَّwُbُّnlٱَw", "root": "نبا"}, {"id": 8, "arabic": "وَرَزَقْنَٰهُم", "translit": "mُhَٰnْqَzَrَw", "root": "رزق"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلطَّيِّبَٰتِ", "translit": "ِtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 11, "arabic": "وَفَضَّلْنَٰهُمْ", "translit": "ْmُhَٰnْlَّḍَfَw", "root": "فضل"}, {"id": 12, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 17, "text": "وَءَاتَيْنَٰهُم بَيِّنَٰتٍ مِّنَ ٱلْأَمْرِۖ فَمَا ٱخْتَلَفُوٓا۟ إِلَّا مِنۢ بَعْدِ مَا جَآءَهُمُ ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْۚ إِنَّ رَبَّكَ يَقْضِى بَيْنَهُمْ يَوْمَ ٱلْقِيَٰمَةِ فِيمَا كَانُوا۟ فِيهِ يَخْتَلِفُونَ ", "translation": "And We gave them clear proofs of the matter [of religion]. And they did not differ except after knowledge had come to them - out of jealous animosity between themselves. Indeed, your Lord will judge between them on the Day of Resurrection concerning that over which they used to differ.", "words": [{"id": 1, "arabic": "وَءَاتَيْنَٰهُم", "translit": "mُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 2, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 5, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 6, "arabic": "ٱخْتَلَفُوٓا۟", "translit": "۟āٓwُfَlَtْhkٱ", "root": "خلف"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 9, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 12, "arabic": "ٱلْعِلْمُ", "translit": "ُmْlِʿعْlٱ", "root": "علم"}, {"id": 13, "arabic": "بَغْيًۢا", "translit": "āًۢyْغَb", "root": "بغي"}, {"id": 14, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 17, "arabic": "يَقْضِى", "translit": "àِḍْqَy", "root": "قضي"}, {"id": 18, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 19, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 20, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 21, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 22, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 23, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 24, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": true}, {"ayah": 18, "text": "ثُمَّ جَعَلْنَٰكَ عَلَىٰ شَرِيعَةٍ مِّنَ ٱلْأَمْرِ فَٱتَّبِعْهَا وَلَا تَتَّبِعْ أَهْوَآءَ ٱلَّذِينَ لَا يَعْلَمُونَ ", "translation": "Then We put you, [O Muḥammad], on an ordained way concerning the matter [of religion]; so follow it and do not follow the inclinations of those who do not know.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰكَ", "translit": "َkَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "شَرِيعَةٍ", "translit": "ٍẗَʿعyِrَhs", "root": "شرع"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 7, "arabic": "فَٱتَّبِعْهَا", "translit": "āَhْʿعِbَّtٱَf", "root": "تبع"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "تَتَّبِعْ", "translit": "ْʿعِbَّtَt", "root": "تبع"}, {"id": 10, "arabic": "أَهْوَآءَ", "translit": "َءٓāَwْhَaʾ", "root": "هوي"}, {"id": 11, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 19, "text": "إِنَّهُمْ لَن يُغْنُوا۟ عَنكَ مِنَ ٱللَّهِ شَيْـًٔاۚ وَإِنَّ ٱلظَّٰلِمِينَ بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۖ وَٱللَّهُ وَلِىُّ ٱلْمُتَّقِينَ ", "translation": "Indeed, they will never avail you against Allāh at all. And indeed, the wrongdoers are allies of one another; but Allāh is the protector of the righteous.", "words": [{"id": 1, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 3, "arabic": "يُغْنُوا۟", "translit": "۟āwُnْغُy", "root": "غني"}, {"id": 4, "arabic": "عَنكَ", "translit": "َknَʿع", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 8, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 9, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}, {"id": 10, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 11, "arabic": "أَوْلِيَآءُ", "translit": "ُءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 12, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 13, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 14, "arabic": "وَلِىُّ", "translit": "ُّàِlَw", "root": "ولي"}, {"id": 15, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": true}, {"ayah": 20, "text": "هَٰذَا بَصَٰٓئِرُ لِلنَّاسِ وَهُدًى وَرَحْمَةٌ لِّقَوْمٍ يُوقِنُونَ ", "translation": "This [Qur’ān] is enlightenment for mankind and guidance and mercy for a people who are certain [in faith].", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "بَصَٰٓئِرُ", "translit": "ُrِyʾَٰٓṣَb", "root": "بصر"}, {"id": 3, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 4, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 5, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 6, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 7, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": true}, {"ayah": 21, "text": "أَمْ حَسِبَ ٱلَّذِينَ ٱجْتَرَحُوا۟ ٱلسَّيِّـَٔاتِ أَن نَّجْعَلَهُمْ كَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَوَآءً مَّحْيَاهُمْ وَمَمَاتُهُمْۚ سَآءَ مَا يَحْكُمُونَ ", "translation": "Or do those who commit evils think We will make them like those who have believed and done righteous deeds - [make them] equal in their life and their death?[1] Evil is that which they judge [i.e., assume].", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "حَسِبَ", "translit": "َbِsَḥ", "root": "حسب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ٱجْتَرَحُوا۟", "translit": "۟āwُḥَrَtْjgٱ", "root": "جرح"}, {"id": 5, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "نَّجْعَلَهُمْ", "translit": "ْmُhَlَʿعْjgَّn", "root": "جعل"}, {"id": 8, "arabic": "كَٱلَّذِينَ", "translit": "َnyِhdَّlٱَk", "root": ""}, {"id": 9, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 10, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 11, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 12, "arabic": "سَوَآءً", "translit": "ًءٓāَwَs", "root": "سوي"}, {"id": 13, "arabic": "مَّحْيَاهُمْ", "translit": "ْmُhāَyْḥَّm", "root": "حيي"}, {"id": 14, "arabic": "وَمَمَاتُهُمْ", "translit": "ْmُhُtāَmَmَw", "root": "موت"}, {"id": 15, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "يَحْكُمُونَ", "translit": "َnwُmُkْḥَy", "root": "حكم"}], "hasIhya": true}, {"ayah": 22, "text": "وَخَلَقَ ٱللَّهُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَلِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ ", "translation": "And Allāh created the heavens and earth in truth and so that every soul may be recompensed for what it has earned, and they will not be wronged.", "words": [{"id": 1, "arabic": "وَخَلَقَ", "translit": "َqَlَhkَw", "root": "خلق"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "وَلِتُجْزَىٰ", "translit": "ٰàَzْjgُtِlَw", "root": "جزي"}, {"id": 7, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 8, "arabic": "نَفْسٍۭ", "translit": "ٍۭsْfَn", "root": "نفس"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 11, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 23, "text": "أَفَرَءَيْتَ مَنِ ٱتَّخَذَ إِلَٰهَهُۥ هَوَىٰهُ وَأَضَلَّهُ ٱللَّهُ عَلَىٰ عِلْمٍ وَخَتَمَ عَلَىٰ سَمْعِهِۦ وَقَلْبِهِۦ وَجَعَلَ عَلَىٰ بَصَرِهِۦ غِشَٰوَةً فَمَن يَهْدِيهِ مِنۢ بَعْدِ ٱللَّهِۚ أَفَلَا تَذَكَّرُونَ ", "translation": "Have you seen he who has taken as his god his [own] desire, and Allāh has sent him astray due to knowledge[1] and has set a seal upon his hearing and his heart and put over his vision a veil? So who will guide him after Allāh? Then will you not be reminded?", "words": [{"id": 1, "arabic": "أَفَرَءَيْتَ", "translit": "َtْyَءَrَfَaʾ", "root": "راي"}, {"id": 2, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 3, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 4, "arabic": "إِلَٰهَهُۥ", "translit": "ۥُhَhَٰlِiʾ", "root": "اله"}, {"id": 5, "arabic": "هَوَىٰهُ", "translit": "ُhٰàَwَh", "root": "هوي"}, {"id": 6, "arabic": "وَأَضَلَّهُ", "translit": "ُhَّlَḍَaʾَw", "root": "ضلل"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 10, "arabic": "وَخَتَمَ", "translit": "َmَtَhkَw", "root": "ختم"}, {"id": 11, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 12, "arabic": "سَمْعِهِۦ", "translit": "ۦِhِʿعْmَs", "root": "سمع"}, {"id": 13, "arabic": "وَقَلْبِهِۦ", "translit": "ۦِhِbْlَqَw", "root": "قلب"}, {"id": 14, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 15, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 16, "arabic": "بَصَرِهِۦ", "translit": "ۦِhِrَṣَb", "root": "بصر"}, {"id": 17, "arabic": "غِشَٰوَةً", "translit": "ًẗَwَٰhsِغ", "root": "غشو"}, {"id": 18, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 19, "arabic": "يَهْدِيهِ", "translit": "ِhyِdْhَy", "root": "هدي"}, {"id": 20, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 21, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 24, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": true}, {"ayah": 24, "text": "وَقَالُوا۟ مَا هِىَ إِلَّا حَيَاتُنَا ٱلدُّنْيَا نَمُوتُ وَنَحْيَا وَمَا يُهْلِكُنَآ إِلَّا ٱلدَّهْرُۚ وَمَا لَهُم بِذَٰلِكَ مِنْ عِلْمٍۖ إِنْ هُمْ إِلَّا يَظُنُّونَ ", "translation": "And they say, \"There is not but our worldly life; we die and live,[1] and nothing destroys us except time.\" And they have of that no knowledge; they are only assuming.", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "حَيَاتُنَا", "translit": "āَnُtāَyَḥ", "root": "حيي"}, {"id": 6, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 7, "arabic": "نَمُوتُ", "translit": "ُtwُmَn", "root": "موت"}, {"id": 8, "arabic": "وَنَحْيَا", "translit": "āَyْḥَnَw", "root": "حيي"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "يُهْلِكُنَآ", "translit": "ٓāَnُkِlْhُy", "root": "هلك"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلدَّهْرُ", "translit": "ُrْhَّdlٱ", "root": "دهر"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 15, "arabic": "بِذَٰلِكَ", "translit": "َkِlَٰhdِb", "root": ""}, {"id": 16, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 17, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 18, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 19, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "يَظُنُّونَ", "translit": "َnwُّnُẓَy", "root": "ظنن"}], "hasIhya": false}, {"ayah": 25, "text": "وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَٰتُنَا بَيِّنَٰتٍ مَّا كَانَ حُجَّتَهُمْ إِلَّآ أَن قَالُوا۟ ٱئْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And when Our verses are recited to them as clear evidences, their argument is only that they say, \"Bring [back] our forefathers, if you should be truthful.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ءَايَٰتُنَا", "translit": "āَnُtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "حُجَّتَهُمْ", "translit": "ْmُhَtَّjgُḥ", "root": "حجج"}, {"id": 9, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 12, "arabic": "ٱئْتُوا۟", "translit": "۟āwُtْyʾٱ", "root": "اتي"}, {"id": 13, "arabic": "بِـَٔابَآئِنَآ", "translit": "ٓāَnِyʾٓāَbāَٔـِb", "root": "ابو"}, {"id": 14, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 15, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 16, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 26, "text": "قُلِ ٱللَّهُ يُحْيِيكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يَجْمَعُكُمْ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ لَا رَيْبَ فِيهِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ", "translation": "Say, \"Allāh causes you to live, then causes you to die; then He will assemble you for the Day of Resurrection, about which there is no doubt, but most of the people do not know.\"", "words": [{"id": 1, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "يُحْيِيكُمْ", "translit": "ْmُkyِyْḥُy", "root": "حيي"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "يُمِيتُكُمْ", "translit": "ْmُkُtyِmُy", "root": "موت"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "يَجْمَعُكُمْ", "translit": "ْmُkُʿعَmْjgَy", "root": "جمع"}, {"id": 8, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 9, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 10, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 13, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 14, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 15, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 16, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 27, "text": "وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَيَوْمَ تَقُومُ ٱلسَّاعَةُ يَوْمَئِذٍ يَخْسَرُ ٱلْمُبْطِلُونَ ", "translation": "And to Allāh belongs the dominion of the heavens and the earth. And the Day the Hour appears - that Day the falsifiers will lose.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 6, "arabic": "تَقُومُ", "translit": "ُmwُqَt", "root": "قوم"}, {"id": 7, "arabic": "ٱلسَّاعَةُ", "translit": "ُẗَʿعāَّslٱ", "root": "سوع"}, {"id": 8, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 9, "arabic": "يَخْسَرُ", "translit": "ُrَsْhkَy", "root": "خسر"}, {"id": 10, "arabic": "ٱلْمُبْطِلُونَ", "translit": "َnwُlِṭْbُmْlٱ", "root": "بطل"}], "hasIhya": false}, {"ayah": 28, "text": "وَتَرَىٰ كُلَّ أُمَّةٍ جَاثِيَةًۚ كُلُّ أُمَّةٍ تُدْعَىٰٓ إِلَىٰ كِتَٰبِهَا ٱلْيَوْمَ تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ ", "translation": "And you will see every nation kneeling [from fear]. Every nation will be called to its record [and told], \"Today you will be recompensed for what you used to do.", "words": [{"id": 1, "arabic": "وَتَرَىٰ", "translit": "ٰàَrَtَw", "root": "راي"}, {"id": 2, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 3, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "جَاثِيَةً", "translit": "ًẗَyِhtāَjg", "root": "جثو"}, {"id": 5, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 6, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 7, "arabic": "تُدْعَىٰٓ", "translit": "ٰٓàَʿعْdُt", "root": "دعو"}, {"id": 8, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 9, "arabic": "كِتَٰبِهَا", "translit": "āَhِbَٰtِk", "root": "كتب"}, {"id": 10, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 11, "arabic": "تُجْزَوْنَ", "translit": "َnْwَzْjgُt", "root": "جزي"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 29, "text": "هَٰذَا كِتَٰبُنَا يَنطِقُ عَلَيْكُم بِٱلْحَقِّۚ إِنَّا كُنَّا نَسْتَنسِخُ مَا كُنتُمْ تَعْمَلُونَ ", "translation": "This, Our record, speaks about you in truth. Indeed, We were having transcribed[1] whatever you used to do.\"", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "كِتَٰبُنَا", "translit": "āَnُbَٰtِk", "root": "كتب"}, {"id": 3, "arabic": "يَنطِقُ", "translit": "ُqِṭnَy", "root": "نطق"}, {"id": 4, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 7, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 8, "arabic": "نَسْتَنسِخُ", "translit": "ُhkِsnَtْsَn", "root": "نسخ"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 30, "text": "فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَيُدْخِلُهُمْ رَبُّهُمْ فِى رَحْمَتِهِۦۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْمُبِينُ ", "translation": "So as for those who believed and did righteous deeds, their Lord will admit them into His mercy. That is what is the clear attainment.", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "فَيُدْخِلُهُمْ", "translit": "ْmُhُlِhkْdُyَf", "root": "دخل"}, {"id": 7, "arabic": "رَبُّهُمْ", "translit": "ْmُhُّbَr", "root": "ربب"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "رَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَr", "root": "رحم"}, {"id": 10, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 11, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 12, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 13, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 31, "text": "وَأَمَّا ٱلَّذِينَ كَفَرُوٓا۟ أَفَلَمْ تَكُنْ ءَايَٰتِى تُتْلَىٰ عَلَيْكُمْ فَٱسْتَكْبَرْتُمْ وَكُنتُمْ قَوْمًا مُّجْرِمِينَ ", "translation": "But as for those who disbelieved, [it will be said], \"Were not Our verses recited to you, but you were arrogant and became a criminal people?", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "أَفَلَمْ", "translit": "ْmَlَfَaʾ", "root": ""}, {"id": 5, "arabic": "تَكُنْ", "translit": "ْnُkَt", "root": "كون"}, {"id": 6, "arabic": "ءَايَٰتِى", "translit": "àِtَٰyāَء", "root": "ايي"}, {"id": 7, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 8, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 9, "arabic": "فَٱسْتَكْبَرْتُمْ", "translit": "ْmُtْrَbْkَtْsٱَf", "root": "كبر"}, {"id": 10, "arabic": "وَكُنتُمْ", "translit": "ْmُtnُkَw", "root": "كون"}, {"id": 11, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 12, "arabic": "مُّجْرِمِينَ", "translit": "َnyِmِrْjgُّm", "root": "جرم"}], "hasIhya": false}, {"ayah": 32, "text": "وَإِذَا قِيلَ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ وَٱلسَّاعَةُ لَا رَيْبَ فِيهَا قُلْتُم مَّا نَدْرِى مَا ٱلسَّاعَةُ إِن نَّظُنُّ إِلَّا ظَنًّا وَمَا نَحْنُ بِمُسْتَيْقِنِينَ ", "translation": "And when it was said, 'Indeed, the promise of Allāh is truth and the Hour [is coming] - no doubt about it,' you said, 'We know not what is the Hour. We assume only assumption, and we are not convinced.'\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "حَقٌّ", "translit": "ٌّqَḥ", "root": "حقق"}, {"id": 7, "arabic": "وَٱلسَّاعَةُ", "translit": "ُẗَʿعāَّslٱَw", "root": "سوع"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 11, "arabic": "قُلْتُم", "translit": "mُtْlُq", "root": "قول"}, {"id": 12, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 13, "arabic": "نَدْرِى", "translit": "àِrْdَn", "root": "دري"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "ٱلسَّاعَةُ", "translit": "ُẗَʿعāَّslٱ", "root": "سوع"}, {"id": 16, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 17, "arabic": "نَّظُنُّ", "translit": "ُّnُẓَّn", "root": "ظنن"}, {"id": 18, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 19, "arabic": "ظَنًّا", "translit": "āًّnَẓ", "root": "ظنن"}, {"id": 20, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 21, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 22, "arabic": "بِمُسْتَيْقِنِينَ", "translit": "َnyِnِqْyَtْsُmِb", "root": "يقن"}], "hasIhya": false}, {"ayah": 33, "text": "وَبَدَا لَهُمْ سَيِّـَٔاتُ مَا عَمِلُوا۟ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "And the evil consequences of what they did will appear to them, and they will be enveloped by what they used to ridicule.", "words": [{"id": 1, "arabic": "وَبَدَا", "translit": "āَdَbَw", "root": "بدو"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "سَيِّـَٔاتُ", "translit": "ُtāَٔـِّyَs", "root": "سوا"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 6, "arabic": "وَحَاقَ", "translit": "َqāَḥَw", "root": "حيق"}, {"id": 7, "arabic": "بِهِم", "translit": "mِhِb", "root": ""}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 34, "text": "وَقِيلَ ٱلْيَوْمَ نَنسَىٰكُمْ كَمَا نَسِيتُمْ لِقَآءَ يَوْمِكُمْ هَٰذَا وَمَأْوَىٰكُمُ ٱلنَّارُ وَمَا لَكُم مِّن نَّٰصِرِينَ ", "translation": "And it will be said, \"Today We will forget you as you forgot the meeting of this Day of yours, and your refuge is the Fire, and for you there are no helpers.", "words": [{"id": 1, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 3, "arabic": "نَنسَىٰكُمْ", "translit": "ْmُkٰàَsnَn", "root": "نسي"}, {"id": 4, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 5, "arabic": "نَسِيتُمْ", "translit": "ْmُtyِsَn", "root": "نسي"}, {"id": 6, "arabic": "لِقَآءَ", "translit": "َءٓāَqِl", "root": "لقي"}, {"id": 7, "arabic": "يَوْمِكُمْ", "translit": "ْmُkِmْwَy", "root": "يوم"}, {"id": 8, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 9, "arabic": "وَمَأْوَىٰكُمُ", "translit": "ُmُkٰàَwْaʾَmَw", "root": "اوي"}, {"id": 10, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "نَّٰصِرِينَ", "translit": "َnyِrِṣَّٰn", "root": "نصر"}], "hasIhya": false}, {"ayah": 35, "text": "ذَٰلِكُم بِأَنَّكُمُ ٱتَّخَذْتُمْ ءَايَٰتِ ٱللَّهِ هُزُوًا وَغَرَّتْكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَاۚ فَٱلْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ ", "translation": "That is because you took the verses of Allāh in ridicule, and worldly life deluded you.\" So that Day they will not be removed from it, nor will they be asked to appease [Allāh].", "words": [{"id": 1, "arabic": "ذَٰلِكُم", "translit": "mُkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّكُمُ", "translit": "ُmُkَّnَaʾِb", "root": ""}, {"id": 3, "arabic": "ٱتَّخَذْتُمْ", "translit": "ْmُtْhdَhkَّtٱ", "root": "اخذ"}, {"id": 4, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 7, "arabic": "وَغَرَّتْكُمُ", "translit": "ُmُkْtَّrَغَw", "root": "غرر"}, {"id": 8, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 9, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 10, "arabic": "فَٱلْيَوْمَ", "translit": "َmْwَyْlٱَf", "root": "يوم"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُخْرَجُونَ", "translit": "َnwُjgَrْhkُy", "root": "خرج"}, {"id": 13, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 16, "arabic": "يُسْتَعْتَبُونَ", "translit": "َnwُbَtْʿعَtْsُy", "root": "عتب"}], "hasIhya": false}, {"ayah": 36, "text": "فَلِلَّهِ ٱلْحَمْدُ رَبِّ ٱلسَّمَٰوَٰتِ وَرَبِّ ٱلْأَرْضِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "Then, to Allāh belongs [all] praise - Lord of the heavens and Lord of the earth, Lord of the worlds.", "words": [{"id": 1, "arabic": "فَلِلَّهِ", "translit": "ِhَّlِlَf", "root": "اله"}, {"id": 2, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 3, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَرَبِّ", "translit": "ِّbَrَw", "root": "ربب"}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 8, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 37, "text": "وَلَهُ ٱلْكِبْرِيَآءُ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "And to Him belongs [all] grandeur within the heavens and the earth, and He is the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "وَلَهُ", "translit": "ُhَlَw", "root": ""}, {"id": 2, "arabic": "ٱلْكِبْرِيَآءُ", "translit": "ُءٓāَyِrْbِkْlٱ", "root": "كبر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 8, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}], "tafsir": {"13": [{"arabic": "ز أولاده لم يبق لاستعمال السكين بغير إذنه حكم ونكاية في نفسه فكل ما راعاه الأنبياء والأولياء من الآداب وتسامحنا فيه في الفقه مع العوام فسببه هذه الضرورة وإلا فكل هذه المكاره عدول عن العدل وكفران للنعمة ونقصان عن الدرجة المبلغة للعبد إلى درجات القرب، بعضها يؤثر في العبد بنقصان القرب وانحطاط المنزلة وبعضها يخرج بالكلية عن حدود القرب إلى عالم البعد الذى هو مستقر الشياطين وكذلك من كسر غصنا من شجرة من غير حاجة ناجزة مهمة ومن غير حاجة غرض صحيح فقد كفر نعمة الله تعالى في خلق الأشجار وخلق اليد. أما اليد", "english": "And his children did not remain for using the knife without his permission, a ruling and harm to himself, so all that the Prophets and the Friends (Awliya) observed of etiquettes and we were lenient in it in jurisprudence with the common people, its cause is this necessity, otherwise all these dislikes are a deviation from justice (al-'Adl) and ingratitude for the blessing (Ni'mah) and a deficiency from the degree that brings the servant (al-'Abd) to the degrees of proximity (al-Qurb), some of it affects the servant (al-'Abd) by diminishing the proximity (al-Qurb) and lowering the station (al-Manazilah), and some of it completely exits the boundaries of proximity (al-Qurb) to the world of distance (al-Bu'd) which is the abode of the devils. And likewise, whoever breaks a branch from a tree without an urgent, important need and without a valid purpose has disbelieved in the blessing (Ni'mah) of Allah the Exalted in creating the trees and creating the hand. As for the hand, it was not created for futility but for obedience (al-Ta'ah) and works that assist in obedience (al-Ta'ah). And as for the tree, Allah the Exalted created it and created for it roots and directed water to it and created in it the power of nourishment and growth so that it reaches the peak of its maturity, then His servants (al-'Ibad) benefit from it, so breaking it before the peak of its maturity not in a manner that His servants (al-'Ibad) benefit from it is contrary to the purpose of wisdom (al-Hikmah) and a deviation from justice (al-'Adl). If he has a valid purpose, then he has that, for the tree and the animal were made as ransom for human purposes, for they are both perishable, vanishing, so the perishing of the lower in the survival of the nobler for a period is closer to justice (al-'Adl) than wasting them both, and to this is the allusion by His saying the Exalted: 'And He has subjected to you whatever is in the heavens and whatever is on the earth - all from Him.' {} Yes, if he breaks that from the property of another, he is also an oppressor even if he is needy, because each specific tree does not fulfill the needs of all the servants (al-'Ibad) of Allah but fulfills one need, and if one is specified with it without preference and specification, it would be injustice, so the one with specification is the one who obtained the seed and placed it in the earth and directed water to it and undertook the care, so he is more entitled to it than others, and his side returns with that. If that grew in barren land without human effort, it is specified by its planting place or by planting it, so there must be seeking another specification, which is precedence in taking it, for the precedent has the characteristic of precedence. So justice (al-'Adl) is that he be more entitled to it, and the poor expressed this preference as ownership, and it is purely metaphorical, for there is no ownership except for the King of Kings (Malik al-Muluk) who has what is in the heavens and the earth, and how can the servant (al-'Abd) be an owner when he himself does not own himself but is owned by another? Yes, the creation are the servants (al-'Ibad) of Allah and the earth is the table of Allah, and He has permitted them to eat from His table according to their need, like a king who sets a table for his servants (al-'Ibad), so whoever takes a morsel with his right hand and his knuckles contain it, then another servant (al-'Abd) comes and wants to snatch it from his hand, it cannot be taken from him, not because the morsel became his property by taking with the hand, for the hand and the owner of the hand are also owned, but if each specific morsel does not fulfill the need of all the servants (al-'Ibad), then justice (al-'Adl) in specification occurs upon obtaining a kind of...", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "15": [{"arabic": "وكما ان شراه الحطب والجبة مما يستغنى عنه خالقك ومولاك وإنما تشترينه لنفسك إذ خلقه سببا لاستراحتك فطاعاتك ومجاهداتك أيضا هو مستغن عنها وإنما هى طريقك إلى نجاتك فمن أحسن فلنفسه ومن أساء فعليها والله غنى عن العالمين ويحك يا نفس انزعى عن جهلك وقيسى آخرتك بدنياك فما خلقكم ولا بعثكم إلا كنفس واحدة و كما بدأنا أول خلق نعيده و كما بدأكم تعودون وسنة الله تعالى لا تجدين لها تبديلا ولا تحويلا", "english": "And just as the purchase of firewood and the cloak is something your Creator (Khaliq) and Master (Mawlā) is independent of, but you purchase it for your own self (Nafs) since He created it as a means for your comfort, so too your acts of obedience (Tā'āt) and spiritual struggles (Mujāhadāt) - He is also independent of them, but they are your path to your salvation. So whoever does good, it is for his own self (Nafs), and whoever does evil, it is against it, and Allah is independent of the worlds. Woe to you, O self (Nafs)! Cast off your ignorance and measure your Hereafter (Ākhirah) by your worldly life (Dunyā), for He did not create you nor resurrect you except as a single soul (Nafs). And as We began the first creation, We will repeat it, and as He began you, you will return, and the established way (Sunnah) of Allah you will find no change or alteration for it.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "17": [{"arabic": "الورد الخامس: السدس الأخير من الليل وهو وقت السحر فإن الله تعالى قال: ﴿ وبالأسحار هم يستغفرون ﴾ {} قيل يصلون لما فيها من الاستغفار وهو مقارب", "english": "The fifth portion (Wird): The last sixth of the night, which is the time of the pre-dawn (Sahar), for Allah the Exalted said: 'And in the hours before dawn they ask forgiveness' (Quran 51:18). It is said they pray because of the seeking forgiveness (Istighfar) in it, and it is approximate.", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Knowledge'", "badge": "Dhikr"}], "19": [{"arabic": "وأما قصدك المباهاة وتزكية النفس بزيادة الفضل بأن تقدح في غيرك فينبغي أن تعلم أنك بما ذكرته به أبطلت فضلك عند الله وأنت من اعتقاد الناس فضلك على خطر، وربما نقص اعتقادهم فيك إذا عرفوك بثلب الناس فتكون قد بعت ما عند الخالق يقيناً بما عند المخلوقين وهما، ولو حصل لك من المخلوقين اعتقاد الفضل لكانوا لا يغنون عنك من الله شيئاً.", "english": "And as for your intention of boasting and purifying the self (Nafs) by increasing virtue through criticizing others, you should know that by what you have mentioned, you have invalidated your virtue with Allah, and you are in danger regarding people's belief in your virtue. Perhaps their belief in you will decrease if they know you for slandering people, so you would have sold what is with the Creator with certainty for what is with the created ones in delusion. And even if you obtained from the created ones belief in virtue, they would not avail you against Allah anything.", "book_file": "vol3_Vol3-book4a.doc.txt", "book_title": "Condemnation of Anger and Hatred", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Anger and Hatred'", "badge": "Insight"}, {"arabic": "فرفع سعيد صوته وقال يا أيها المصلي إن كنت تريد الله عز وجل بصلاتك فاخفض صوتك وإن كنت تريد الناس فإنهم لن يغنوا عنك من الله شيئا فسكت عمر بن عبد العزيز وخفف ركعته فلما سلم أخذ نعليه وانصرف وهو يومئذ أمير المدينة", "english": "So Sa'id raised his voice and said: 'O you who are praying, if you intend Allah the Exalted with your prayer, then lower your voice, and if you intend people, then they will not avail you anything from Allah.' So 'Umar ibn 'Abd al-'Aziz fell silent and lightened his rak'ah (prayer unit), and when he gave the salutation (of peace ending the prayer), he took his sandals and departed while he was at that time the governor of Medina.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Etiquette of Quran Recitation'", "badge": "Du'a"}], "20": [{"arabic": "وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم. كذلك يضرب الله للناس أمثالهم واتبعوا أحسن ما أنزل إليكم من ربكم. هذا بصائر للناس وهدى ورحمة لقوم يوقنون. هذا بيان للناس وهدى وموعظة للمتقين ﴾ {} وإذا قصد بالخطاب جميع الناس فقد قصد الآحاد فهذا القارىء الواحد مقصود فما له ولسائر الناس فليقدر أنه المقصود", "english": "And We have sent down to you the Remembrance (Dhikr) to clarify to the people what was sent down to them. Thus Allah strikes for the people their examples, and follow the best of what has been sent down to you from your Lord. This is insights for the people and guidance and mercy for a people who are certain (Yūqinūn). This is clarification for the people and guidance and admonition for the God-fearing (Muttaqīn). And if the address is intended for all people, then the individuals are intended, so this single reader is intended, so what is for him and for the rest of the people, let him consider that he is the intended one.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Etiquette of Quran Recitation'", "badge": "Dhikr"}], "21": [{"arabic": "وقال مالك بن دينار رضي الله عنه بات يردد هذه الآية ليلة حتى أصبح ﴿أَمْ حَسِبَ الَّذِينَ اجْتَرَحُوا السَّيِّئَاتِ أَنْ نَجْعَلَهُمْ كَالَّذِينَ آمَنُوا وَعَمِلُوا الصَّالِحَاتِ سَوَاءً مَحْيَاهُمْ وَمَمَاتُهُمْ ۚ سَاءَ مَا يَحْكُمُونَ﴾ الآية.", "english": "And Malik bin Dinar (may Allah be pleased with him) spent the night repeating this verse until morning: 'Do those who commit evil deeds think that We will make them like those who have believed and done righteous deeds - equal in their life and their death? How wretched is that which they judge!' (the verse).", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Knowledge'", "badge": "Afterlife"}, {"arabic": "وقام تميم الداري ليلة بهذه الآية ﴿ أم حسب الذين اجترحوا السيئات ﴾ {} الآية.", "english": "And Tamim al-Dari stood for a night with this verse: 'Do those who commit evil deeds think that We will make them like those who believe and do righteous deeds, equal in their life and their death? How wretched is their judgment!' (Quran 45:21).", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Etiquette of Quran Recitation'", "badge": "Afterlife"}], "23": [{"arabic": "والثالث: وهو اللباب أن يرى الأمور كلها من الله تعالى رؤية تقطع التفاته عن الوسائط وأن يعبده عبادة يفرده بها فلا يعبد غيره ويخرج عن هذا التوحيد أتباع الهوى فكل متبع هواه فقد اتخذ هواه معبوده قال الله تعالى: (أفرأيت من اتخذ إلهه هواه( (الجاثية: 23). وقال صلى الله عليه وسلم: (أبغض إله عبد في الأرض عند الله تعالى هو الهوى)[92]. وعلى التحقيق من تأمل عرف أن عابد الصنم ليس يعبد الصنم وإنما يعبد هواه إذ نفسه مائلة إلى دين آبائه فيتبع ذلك الميل وميل النفس إلى المألوفات أحد المعاني التي يعبر عنها بالهوى و", "english": "The third: which is the core (Lubāb) is to see all matters as from Allah the Exalted with a vision (Ru'yah) that cuts off one's attention from intermediaries, and to worship Him with a worship (ʿIbādah) that singles Him out, so he does not worship other than Him. And those who follow their desires (Hawā) exit from this monotheism (Tawḥīd), for every follower of his desire has taken his desire as his god. Allah the Exalted said: 'Have you seen he who has taken his desire as his god?' (Al-Jāthiyah: 23). And the Prophet, peace be upon him, said: 'The most hated god worshipped on earth to Allah the Exalted is the desire.' And in truth, whoever contemplates knows that the idol-worshipper does not worship the idol but rather worships his desire, for his soul (Nafs) is inclined to the religion of his forefathers, so he follows that inclination, and the inclination of the soul to familiar things is one of the meanings expressed by 'desire' (Hawā). And from this monotheism exits discontent with creation and turning attention to them, for how can one who sees everything as from Allah the Mighty and Majestic be discontent with other than Him? Indeed, monotheism is an expression of this station (Maqām), which is the station of the truthful ones (Ṣiddīqīn). So look at what he has turned to and with which shell (Qishr) he has contented himself, and how they have taken this as a refuge in boasting and pride with what is named praiseworthy while being bankrupt of the meaning that deserves true praise. That is like the bankruptcy of one who rises in the morning and turns to the qiblah and says: 'I have turned my face to He who created the heavens and the earth, inclining to truth' (Al-Anʿām: 79). And it is the first lie he opens with to Allah every day if the face of his heart (Qalb) is not turned to Allah the Exalted in particular, for if he intends by 'face' the apparent face, then his face is only to the Kaaba, and he has only diverted it from other directions, and the Kaaba is not a direction for He who created the heavens and the earth, so that the one turning to it is turning to Him, exalted is He above being limited by directions and regions, and", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "ومن عدل عن هذه الطريقة كان كمن قال الله تعالى فيه أفرأيت من اتخذ إلهه هواه وأضله الله على علم وقال تعالى واتبع هواه فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث وقال عز وجل فيمن نهى النفس عن الهوى وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى وسيأتي كيفية مجاهدة هذه الجنود وتسليط بعضها على بعض في كتاب رياضة النفس إن شاء الله تعالى", "english": "And whoever deviates from this method is like the one about whom Allah the Exalted said: 'Have you seen the one who takes his desire (Hawa) as his god (Ilah), and Allah has led him astray despite knowledge, and sealed his hearing and his heart, and placed a covering over his sight? So who will guide him after Allah? Will you not then remember?' (Quran 45:23). And He said: 'And he followed his desire (Hawa), so his likeness is as the likeness of a dog: if you attack it, it pants, or if you leave it, it pants' (Quran 7:176). And He the Almighty said regarding the one who forbids the Soul (Nafs) from desire (Hawa): 'But as for he who feared the standing before his Lord and forbade the Soul (Nafs) from desire (Hawa), then indeed, Paradise will be [his] refuge' (Quran 79:40-41). And the method of struggling (Mujahadah) against these troops and setting some of them against others will come in the Book of Disciplining the Soul (Riyadat al-Nafs), if Allah the Exalted wills.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "وقال جابر بن عبيدة العدوي شكوت إلى العلاء بن زياد ما أجد في صدري من الوسوسة فقال إنما مثل ذلك مثل البيت الذي يمر به اللصوص فإن كان فيه شيء عالجوه وإلا مضوا وتركوه يعني أن القلب الخالي عن الهوى لا يدخله الشيطان ولذلك قال الله تعالى إن عبادي ليس لك عليهم سلطان فكل من اتبع الهوى فهو عبد الهوى لا عبد الله ولذلك سلط الله عليه الشيطان وقال تعالى أفرأيت من اتخذ إلهه هواه وهو إشارة إلى أن من الهوى إلهه ومعبوده فهو عبد الهوى لا عبد الله ولذلك قال عمرو ابن العاص للنبي صلى الله عليه وسلم يا رسول الله حال ا", "english": "And Jabir ibn 'Ubaydah al-'Adawi said: I complained to al-'Ala' ibn Ziyad about what I find in my chest (Sadrat) from the whispering (Waswasah), so he said: Indeed, the likeness of that is like a house that thieves pass by; if there is something in it, they treat it (i.e., attempt to steal), otherwise they pass and leave it. Meaning that the Heart (Qalb) empty from the Passion (Hawa) does not enter it the Satan (Shaytan). And for that reason, Allah the Exalted said: 'Indeed, My servants, you have no authority over them.' So everyone who follows the Passion (Hawa) is a servant of the Passion (Hawa), not a servant of Allah. And for that reason, Allah empowered over him the Satan (Shaytan). And He the Exalted said: 'Have you seen the one who takes his god his passion (Hawa)?' And it is an indication that whoever makes his passion (Hawa) his god and his worshipped one, he is a servant of the passion (Hawa), not a servant of Allah. And for that reason, 'Amr ibn al-'As said to the Prophet, peace and blessings be upon him: O Messenger of Allah, the Satan (Shaytan) comes between me and my prayer and my recitation. So he said: That is a Satan (Shaytan) called Khanzab; when you sense him, seek refuge in Allah from him and spit to your left three times. He said: So I did that, and Allah removed him from me. [44] And in the report: Indeed, for ablution (Wudu') there is a Satan (Shaytan) called al-Walhan, so seek refuge in Allah from him. [45] And it does not erase the whispering (Waswasah) of the Satan (Shaytan) from the Heart (Qalb) except the remembrance (Dhikr) of other than what he whispers with, because if there occurs in the Heart (Qalb) the remembrance (Dhikr) of something, what was in it before disappears from it. But everything other than Allah the Exalted and other than what is related to Him, it is also permissible to be a field for the Satan (Shaytan). And the remembrance (Dhikr) of Allah is that which secures his side and he knows that there is no field for the Satan (Shaytan) in it. And the thing is not treated except by its opposite, and the opposite of all the whisperings (Waswasah) of the Satan (Shaytan) is the remembrance (Dhikr) of Allah with seeking refuge and disavowal from power and strength, and it is the meaning of your saying: 'I seek refuge in Allah from the Satan (Shaytan), the accursed,' and 'There is no power and no strength except with Allah, the Most High, the Most Great.' And that is not capable of it except the God-fearing (Muttaqun) who are predominant over them the remembrance (Dhikr) of Allah the Exalted. And indeed, the Satan (Shaytan) circulates around them in times of slips (Falatat) on the way of stealth (Khalsah). Allah the Exalted said: 'Indeed, those who fear (Ittaqaw) when a touch from the Satan (Shaytan) touches them, they remember (Tadhakkara), then they are seeing (Mubsirun).'", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Disciplining the Soul'", "badge": "Ethics"}, {"arabic": "والمتحصن به لا معبود له سوى الله سبحانه فأما من اتخذ إلهه هواه فهو في ميدان الشيطان لا في حصن الله عز وجل واعلم أن من مكايده أن يشغلك في صلاتك بذكر الآخرة وتدبير فعل الخيرات ليمنعك عن فهم ما تقرأ فاعلم أن كل ما يشغلك عن فهم معاني قراءتك فهو وسواس فإن حركة اللسان غير مقصودة بل المقصود معانيها.", "english": "And the one who takes refuge in it has no object of worship except Allah (God) the Exalted. As for the one who takes his desire (Hawa) as his god (Ilah), he is in the arena of Satan (Shaytan), not in the fortress of Allah (God) the Exalted. And know that among his stratagems is to distract you in your prayer with remembrance (Dhikr) of the Hereafter and planning good deeds to prevent you from understanding what you recite. Know that everything that distracts you from understanding the meanings of your recitation is whispering (Waswas), for the movement of the tongue is not intended; rather, the intended is its meanings.", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Prayer'", "badge": "Du'a"}, {"arabic": "وأمره مخطر فى نفسه فإن عجزت عن ذلك كله فكن محبا لرسول الله ﭬ حريصا على تعظيم سننه ومتشوقا إلى مراعاة قلوب الصالحين من أمته ومتبركا بأدعيتهم فعساك أن تنال من شفاعته أو شفاعتهم فتنجو بالشفاعة إن كنت قليل البضاعة. (صفة الشفاعة) اعلم أن إذا حق دخول النار على طوائف من المؤمنين فإن الله تعالى بفضله يقبل فيهم شفاعة الأنبياء والصديقين بل شفاعة العلماء والصالحين وكل من له عند الله تعالى جاه وحسن معاملة فإن له شفاعة فى أهله وقرابته وأصدقائه ومعارفه فكن حريصا على أن تكتسب لنفسك عندهم رتبة الشفاعة وذلك بأن ", "english": "And his matter is precarious in his soul. If you are incapable of all that, then be a lover of the Messenger of Allah (peace be upon him), diligent in venerating his traditions (Sunnah), yearning to observe the hearts (Qulub) of the righteous (Salihin) from his community, and seeking blessings (Tabarruk) through their supplications. Perhaps you will attain from his intercession (Shafa'ah) or their intercession, and thus be saved by intercession if you are of little merchandise. (Description of Intercession) Know that when entry into the Fire becomes due for groups of the believers, then Allah the Exalted, by His grace, accepts among them the intercession of the Prophets and the Truthful Ones (Siddiqin), indeed the intercession of the scholars and the righteous, and everyone who has status (Jah) and good dealings with Allah the Exalted, then he has intercession for his family, relatives, friends, and acquaintances. So be diligent to acquire for yourself with them the rank of intercession, and that is by not despising any human being at all, for Allah the Exalted has concealed His friendship (Wilayah) in His servants, so perhaps the one whom your eye belittles is the friend (Wali) of Allah. And do not deem any sin small at all, for Allah the Exalted has concealed His anger in His prohibitions (Ma'asi), so perhaps the wrath (Maqt) of Allah is in it. And do not deem any obedience small at all, for Allah the Exalted has concealed His pleasure (Rida) in His obedience, so perhaps His pleasure is in it, even if it be a good word or a good intention or what runs its course. And the evidences for intercession in the Quran and reports are many: Allah the Exalted said: 'And your Lord will give you, and you will be satisfied' {93:5}. It was narrated by 'Amr ibn al-'As: (that the Messenger of Allah", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}], "28": [{"arabic": "فأخطر ببالك وأحضر فى قلبك حالة قلوب العباد وقد امتلأت فزعا ورعبا فتساقطوا جثيا على الركب وولوا مدبرين ﴿ يوم ترى كل أمة جاثية ﴾ {} وسقط بعضهم على الوجوه منكبين وينادى العصاة والظالمون بالويل والثبور وينادى الصديقون نفسى نفسى فبينما هم كذلك إذ زفرت الناس زفرتها الثانية فتضاعف خوفهم وتخاذلت قواهم وظنوا أنهم مأخوذون ثم زفرت الثالثة فتساقط الخلائق على وجوههم وشخصوا بأبصارهم ينظرون من طرف خفى خاشع وانهضمت عند ذلك قلوب الظالمين فبلغت الحناجر كاظمين وذهلت العقول من السعداء والأشقياء أجمعين", "english": "So imagine in your mind and bring to your heart (Qalb) the state of the hearts (Qulub) of the servants (Ibad) which have become filled with terror and dread, so they fell down kneeling on their knees and turned away fleeing. 'On the day you will see every community kneeling' (Quran 45:28). And some of them fell on their faces prostrate, and the sinners and wrongdoers call out with woe and destruction, and the truthful ones call out 'myself, myself'. While they are thus, the people let out their second gasp, so their fear multiplied and their strengths weakened and they thought they were being seized. Then they let out the third gasp, so the creatures fell on their faces and they stared with their eyes looking from a hidden, humble corner, and at that moment the hearts (Qulub) of the wrongdoers were crushed so they reached the throats suppressing, and the minds (Uqul) of the fortunate and the wretched altogether were bewildered.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}], "29": [{"arabic": "وقال موسى بن مسعود كنا إذا جلسنا إلى الثوري كأن النار قد أحاطت بنا لما نرى من خوفه وجزعه وقرأ مضر القارئ يوما ﴿ هذا كتابنا ينطق عليكم بالحق ﴾{} الآية فبكى عبد الواحد بن زيد حتى غشي عليه فلما أفاق قال وعزتك لأعصيتك جهدي أبدا فأعني بتوفيقك على طاعتك", "english": "And Musa ibn Mas'ud said: 'When we sat with al-Thawri, it was as if fire had surrounded us due to what we saw of his fear (khawf) and dread (jaz'). And one day, Mudar the reciter recited: \"This is Our Book that speaks the truth against you\" (Quran 45:29) - the verse. Then Abd al-Wahid ibn Zaid wept until he fainted. When he regained consciousness, he said: 'By Your might, I have disobeyed You with all my effort forever, so help me with Your success (tawfiq) in Your obedience (ta'ah).'", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Fear and Hope'", "badge": "Insight"}], "36": [{"arabic": "فإذا استيقظت من نومك عند الصباح فقل الحمد لله الذي أحيانا بعدما أماتنا وإليه النشور[230] أ", "english": "And if you wake up from your sleep in the morning, then say: 'Praise be to Allah who gave us life after He caused us to die, and to Him is the resurrection.'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter", "badge": "Afterlife"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 3972]], "2": [[1, 400, 1774], [2, 1774, 2998], [3, 2998, 3498], [4, 3498, 4485], [5, 4485, 5984], [6, 5984, 7456]], "3": [[1, 400, 1255], [2, 1255, 1841], [3, 1841, 3768], [4, 3768, 5244], [5, 5244, 6837], [6, 6837, 9075]], "4": [[1, 400, 1637], [2, 1637, 3275], [3, 3275, 4542], [4, 4542, 5910], [5, 5910, 6528], [6, 6528, 8911], [7, 8911, 10704], [8, 10704, 12389], [9, 12389, 14770]], "5": [[1, 400, 2461], [2, 2461, 3904], [3, 3904, 6678], [4, 6678, 8789], [5, 8789, 10121], [6, 10121, 11373], [7, 11373, 12007], [8, 12007, 14919], [9, 14919, 15553], [10, 15553, 16805], [11, 16805, 18834], [12, 18834, 19436], [13, 19436, 20958], [14, 20958, 21973], [15, 21973, 23875], [16, 23875, 26189], [17, 26189, 28266], [18, 28266, 30105], [19, 30105, 31833], [20, 31833, 34179]], "6": [[1, 400, 1241], [2, 1241, 2866], [3, 2866, 3973], [4, 3973, 5934], [5, 5934, 7251], [6, 7251, 8792], [7, 8792, 10424], [8, 10424, 11741], [9, 11741, 12638], [10, 12638, 13745], [11, 13745, 16043], [12, 16043, 18087]], "7": [[1, 350, 1412], [2, 1412, 2607], [3, 2607, 4081], [4, 4081, 5357]], "8": [[1, 400, 1643], [2, 1643, 3145], [3, 3145, 4168], [4, 4168, 5567], [5, 5567, 6759], [6, 6759, 7679], [7, 7679, 8858], [8, 8858, 10853], [9, 10853, 11682], [10, 11682, 12394], [11, 12394, 14285], [12, 14285, 15839], [13, 15839, 17367], [14, 17367, 18584]], "9": [[1, 400, 1803], [2, 1803, 2635], [3, 2635, 3155], [4, 3155, 5338], [5, 5338, 6533], [6, 6533, 8287], [7, 8287, 9586], [8, 9586, 11561], [9, 11561, 12315], [10, 12315, 13588], [11, 13588, 15109]], "10": [[1, 400, 1347], [2, 1347, 4054], [3, 4054, 5523], [4, 5523, 6649], [5, 6649, 8049], [6, 8049, 9175], [7, 9175, 10287], [8, 10287, 1