َٰهَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "هَو۪يٰهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَضَلَّهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "عِلْمࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَخَتَمَ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "سَمْعِهِۦ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَقَلْبِهِۦ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَجَعَلَ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 16, "arabic": "بَصَرِهِۦ", "translit": "", "root": ""}, {"id": 17, "arabic": "غِشَٰوَةࣰ", "translit": "", "root": ""}, {"id": 18, "arabic": "فَمَنْ", "translit": "", "root": ""}, {"id": 19, "arabic": "يَّهْدِيهِ", "translit": "", "root": ""}, {"id": 20, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 21, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 22, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 23, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 24, "arabic": "تَذَّكَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 45, "ayah": 24, "text": "وَقَالُواْ مَا هِيَ إِلَّا حَيَاتُنَا اَ۬لدُّنْي۪ا نَمُوتُ وَنَحْي۪ا وَمَا يُهْلِكُنَآ إِلَّا اَ۬لدَّهْرُۖ وَمَا لَهُم بِذَٰلِكَ مِنْ عِلْمٍۖ اِنْ هُمُۥٓ إِلَّا يَظُنُّونَۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "حَيَاتُنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 7, "arabic": "نَمُوتُ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَنَحْي۪ا", "translit": "", 