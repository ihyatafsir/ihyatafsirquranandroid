yah": 6, "text": "تِلْكَ ءَايَٰتُ اُ۬للَّهِ نَتْلُوهَا عَلَيْكَ بِالْحَقِّۖ فَبِأَيِّ حَدِيثِۢ بَعْدَ اَ۬للَّهِ وَءَايَٰتِهِۦ يُومِنُونَۖ", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَايَٰتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَتْلُوهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَبِأَيِّ", "translit": "", "root": ""}, {"id": 8, "arabic": "حَدِيثِۢ", "translit": "", "root": ""}, {"id": 9, "arabic": "بَعْدَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَءَايَٰتِهِۦ", "translit": "", "root": ""}, {"id": 12, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 45, "ayah": 7, "text": "وَيْلࣱ لِّكُلِّ أَفَّاكٍ اَثِيمࣲ‏", "words": [{"id": 1, "arabic": "وَيْلࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّكُلِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَفَّاكٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَثِيمࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 45, "ayah": 8, "text": "يَسْمَعُ ءَايَٰتِ اِ۬للَّهِ تُتْل۪يٰ عَلَيْهِ ثُمَّ يُصِرُّ مُسْتَكْبِراࣰ كَأَن لَّمْ يَسْمَعْهَاۖ فَبَشِّرْهُ بِعَذَابٍ اَلِيمࣲۖ", "words": [{"id": 1, "arabic": "يَسْمَعُ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَايَٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "تُتْل۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "يُصِرُّ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُسْتَكْبِراࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَأَن", "translit": "", "root": ""}, {"i