{"surah": 45, "verses": [{"ayah": 1, "text": "حمٓ ", "translation": "Ḥā, Meem.[1]", "words": [{"id": 1, "arabic": "حمٓ", "translit": "ٓmḥ", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "تَنزِيلُ ٱلْكِتَٰبِ مِنَ ٱللَّهِ ٱلْعَزِيزِ ٱلْحَكِيمِ ", "translation": "The revelation of the Book is from Allāh, the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "تَنزِيلُ", "translit": "ُlyِznَt", "root": "نزل"}, {"id": 2, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 6, "arabic": "ٱلْحَكِيمِ", "translit": "ِmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 3, "text": "إِنَّ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ لَءَايَٰتٍ لِّلْمُؤْمِنِينَ ", "translation": "Indeed, within the heavens and earth are signs for the believers.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 6, "arabic": "لِّلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِّl", "root": "امن"}], "hasIhya": false}, {"ayah": 4, "text": "وَفِى خَلْقِكُمْ وَمَا يَبُثُّ مِن دَآبَّةٍ ءَايَٰتٌ لِّقَوْمٍ يُوقِنُونَ ", "translation": "And in the creation of yourselves and what He disperses of moving creatures are signs for people who are certain [in faith].", "words": [{"id": 1, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 2, "arabic": "خَلْقِكُمْ", "translit": "ْmُkِqْlَhk", "root": "خلق"}, {"id": 3, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 4, "arabic": "يَبُثُّ", "translit": "ُّhtُbَy", "root": "بثث"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 7, "arabic": "ءَايَٰتٌ", "translit": "ٌtَٰyāَء", "root": "ايي"}, {"id": 8, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 9, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 5, "text": "وَٱخْتِلَٰفِ ٱلَّيْلِ وَٱلنَّهَارِ وَمَآ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَآءِ مِن رِّزْقٍ فَأَحْيَا بِهِ ٱلْأَرْضَ بَعْدَ مَوْتِهَا وَتَصْرِيفِ ٱلرِّيَٰحِ ءَايَٰتٌ لِّقَوْمٍ يَعْقِلُونَ ", "translation": "And [in] the alternation of night and day and [in] what Allāh sends down from the sky of provision [i.e., rain] and gives life thereby to the earth after its lifelessness and [in His] directing of the winds are signs for a people who reason.", "words": [{"id": 1, "arabic": "وَٱخْتِلَٰفِ", "translit": "ِfَٰlِtْhkٱَw", "root": "خلف"}, {"id": 2, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 3, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 4, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "رِّزْقٍ", "translit": "ٍqْzِّr", "root": "رزق"}, {"id": 11, "arabic": "فَأَحْيَا", "translit": "āَyْḥَaʾَf", "root": "حيي"}, {"id": 12, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 13, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 14, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "مَوْتِهَا", "translit": "āَhِtْwَm", "root": "موت"}, {"id": 16, "arabic": "وَتَصْرِيفِ", "translit": "ِfyِrْṣَtَw", "root": "صرف"}, {"id": 17, "arabic": "ٱلرِّيَٰحِ", "translit": "ِḥَٰyِّrlٱ", "root": "روح"}, {"id": 18, "arabic": "ءَايَٰتٌ", "translit": "ٌtَٰyāَء", "root": "ايي"}, {"id": 19, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 20, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 6, "text": "تِلْكَ ءَايَٰتُ ٱللَّهِ نَتْلُوهَا عَلَيْكَ بِٱلْحَقِّۖ فَبِأَىِّ حَدِيثٍۭ بَعْدَ ٱللَّهِ وَءَايَٰتِهِۦ يُؤْمِنُونَ ", "translation": "These are the verses of Allāh which We recite to you in truth. Then in what statement after Allāh and His verses will they believe?", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "نَتْلُوهَا", "translit": "āَhwُlْtَn", "root": "تلو"}, {"id": 5, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 7, "arabic": "فَبِأَىِّ", "translit": "ِّàَaʾِbَf", "root": "ايي"}, {"id": 8, "arabic": "حَدِيثٍۭ", "translit": "ٍۭhtyِdَḥ", "root": "حدث"}, {"id": 9, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَءَw", "root": "ايي"}, {"id": 12, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 7, "text": "وَيْلٌ لِّكُلِّ أَفَّاكٍ أَثِيمٍ ", "translation": "Woe to every sinful liar", "words": [{"id": 1, "arabic": "وَيْلٌ", "translit": "ٌlْyَw", "root": ""}, {"id": 2, "arabic": "لِّكُلِّ", "translit": "ِّlُkِّl", "root": "كلل"}, {"id": 3, "arabic": "أَفَّاكٍ", "translit": "ٍkāَّfَaʾ", "root": "افك"}, {"id": 4, "arabic": "أَثِيمٍ", "translit": "ٍmyِhtَaʾ", "root": "اثم"}], "hasIhya": false}, {"ayah": 8, "text": "يَسْمَعُ ءَايَٰتِ ٱللَّهِ تُتْلَىٰ عَلَيْهِ ثُمَّ يُصِرُّ مُسْتَكْبِرًا كَأَن لَّمْ يَسْمَعْهَاۖ فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍ ", "translation": "Who hears the verses of Allāh recited to him, then persists arrogantly as if he had not heard them. So give him tidings of a painful punishment.", "words": [{"id": 1, "arabic": "يَسْمَعُ", "translit": "ُʿعَmْsَy", "root": "سمع"}, {"id": 2, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "يُصِرُّ", "translit": "ُّrِṣُy", "root": "صرر"}, {"id": 8, "arabic": "مُسْتَكْبِرًا", "translit": "āًrِbْkَtْsُm", "root": "كبر"}, {"id": 9, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 10, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 11, "arabic": "يَسْمَعْهَا", "translit": "āَhْʿعَmْsَy", "root": "سمع"}, {"id": 12, "arabic": "فَبَشِّرْهُ", "translit": "ُhْrِّhsَbَf", "root": "بشر"}, {"id": 13, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 14, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 9, "text": "وَإِذَا عَلِمَ مِنْ ءَايَٰتِنَا شَيْـًٔا ٱتَّخَذَهَا هُزُوًاۚ أُو۟لَٰٓئِكَ لَهُمْ عَذَابٌ مُّهِينٌ ", "translation": "And when he knows anything of Our verses, he takes them in ridicule. Those will have a humiliating punishment.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 6, "arabic": "ٱتَّخَذَهَا", "translit": "āَhَhdَhkَّtٱ", "root": "اخذ"}, {"id": 7, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 8, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 11, "arabic": "مُّهِينٌ", "translit": "ٌnyِhُّm", "root": "هون"}], "hasIhya": false}, {"ayah": 10, "text": "مِّن وَرَآئِهِمْ جَهَنَّمُۖ وَلَا يُغْنِى عَنْهُم مَّا كَسَبُوا۟ شَيْـًٔا وَلَا مَا ٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ أَوْلِيَآءَۖ وَلَهُمْ عَذَابٌ عَظِيمٌ ", "translation": "Before them[1] is Hell, and what they had earned will not avail them at all nor what they had taken besides Allāh as allies. And they will have a great punishment.", "words": [{"id": 1, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 2, "arabic": "وَرَآئِهِمْ", "translit": "ْmِhِyʾٓāَrَw", "root": "وري"}, {"id": 3, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "يُغْنِى", "translit": "àِnْغُy", "root": "غني"}, {"id": 6, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 9, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 17, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 18, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 19, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 11, "text": "هَٰذَا هُدًىۖ وَٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِ رَبِّهِمْ لَهُمْ عَذَابٌ مِّن رِّجْزٍ أَلِيمٌ ", "translation": "This [Qur’ān] is guidance. And those who have disbelieved in the verses of their Lord will have a painful punishment of foul nature.", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 3, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 6, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 7, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 8, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "رِّجْزٍ", "translit": "ٍzْjgِّr", "root": "رجز"}, {"id": 11, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 12, "text": "ٱللَّهُ ٱلَّذِى سَخَّرَ لَكُمُ ٱلْبَحْرَ لِتَجْرِىَ ٱلْفُلْكُ فِيهِ بِأَمْرِهِۦ وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَ ", "translation": "It is Allāh who subjected to you the sea so that ships may sail upon it by His command and that you may seek of His bounty; and perhaps you will be grateful.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "سَخَّرَ", "translit": "َrَّhkَs", "root": "سخر"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلْبَحْرَ", "translit": "َrْḥَbْlٱ", "root": "بحر"}, {"id": 6, "arabic": "لِتَجْرِىَ", "translit": "َàِrْjgَtِl", "root": "جري"}, {"id": 7, "arabic": "ٱلْفُلْكُ", "translit": "ُkْlُfْlٱ", "root": "فلك"}, {"id": 8, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 9, "arabic": "بِأَمْرِهِۦ", "translit": "ۦِhِrْmَaʾِb", "root": "امر"}, {"id": 10, "arabic": "وَلِتَبْتَغُوا۟", "translit": "۟āwُغَtْbَtِlَw", "root": "بغي"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 13, "arabic": "وَلَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَlَw", "root": ""}, {"id": 14, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 13, "text": "وَسَخَّرَ لَكُم مَّا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ جَمِيعًا مِّنْهُۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يَتَفَكَّرُونَ ", "translation": "And He has subjected to you whatever is in the heavens and whatever is on the earth - all from Him. Indeed in that are signs for a people who give thought.", "words": [{"id": 1, "arabic": "وَسَخَّرَ", "translit": "َrَّhkَsَw", "root": "سخر"}, {"id": 2, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 3, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 10, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 14, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 15, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 16, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": true}, {"ayah": 14, "text": "قُل لِّلَّذِينَ ءَامَنُوا۟ يَغْفِرُوا۟ لِلَّذِينَ لَا يَرْجُونَ أَيَّامَ ٱللَّهِ لِيَجْزِىَ قَوْمًۢا بِمَا كَانُوا۟ يَكْسِبُونَ ", "translation": "Say, [O Muḥammad], to those who have believed that they [should] forgive those who expect not the days of Allāh [i.e., of His retribution] so that He may recompense a people[1] for what they used to earn.", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "يَغْفِرُوا۟", "translit": "۟āwُrِfْغَy", "root": "غفر"}, {"id": 5, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 8, "arabic": "أَيَّامَ", "translit": "َmāَّyَaʾ", "root": "يوم"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لِيَجْزِىَ", "translit": "َàِzْjgَyِl", "root": "جزي"}, {"id": 11, "arabic": "قَوْمًۢا", "translit": "āًۢmْwَq", "root": "قوم"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": false}, {"ayah": 15, "text": "مَنْ عَمِلَ صَٰلِحًا فَلِنَفْسِهِۦۖ وَمَنْ أَسَآءَ فَعَلَيْهَاۖ ثُمَّ إِلَىٰ رَبِّكُمْ تُرْجَعُونَ ", "translation": "Whoever does a good deed - it is for himself; and whoever does evil - it is against it [i.e., the self or soul]. Then to your Lord you will be returned.", "words": [{"id": 1, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 2, "arabic": "عَمِلَ", "translit": "َlِmَʿع", "root": "عمل"}, {"id": 3, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 4, "arabic": "فَلِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِlَf", "root": "نفس"}, {"id": 5, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 6, "arabic": "أَسَآءَ", "translit": "َءٓāَsَaʾ", "root": "سوا"}, {"id": 7, "arabic": "فَعَلَيْهَا", "translit": "āَhْyَlَʿعَf", "root": ""}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "رَبِّكُمْ", "translit": "ْmُkِّbَr", "root": "ربب"}, {"id": 11, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": true}, {"ayah": 16, "text": "وَلَقَدْ ءَاتَيْنَا بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَٰبَ وَٱلْحُكْمَ وَٱلنُّبُوَّةَ وَرَزَقْنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ وَفَضَّلْنَٰهُمْ عَلَى ٱلْعَٰلَمِينَ ", "translation": "And We did certainly give the Children of Israel the Scripture and judgement[1] and prophethood, and We provided them with good things and preferred them over the worlds.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 4, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "وَٱلْحُكْمَ", "translit": "َmْkُḥْlٱَw", "root": "حكم"}, {"id": 7, "arabic": "وَٱلنُّبُوَّةَ", "translit": "َẗَّwُbُّnlٱَw", "root": "نبا"}, {"id": 8, "arabic": "وَرَزَقْنَٰهُم", "translit": "mُhَٰnْqَzَrَw", "root": "رزق"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلطَّيِّبَٰتِ", "translit": "ِtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 11, "arabic": "وَفَضَّلْنَٰهُمْ", "translit": "ْmُhَٰnْlَّḍَfَw", "root": "فضل"}, {"id": 12, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 17, "text": "وَءَاتَيْنَٰهُم بَيِّنَٰتٍ مِّنَ ٱلْأَمْرِۖ فَمَا ٱخْتَلَفُوٓا۟ إِلَّا مِنۢ بَعْدِ مَا جَآءَهُمُ ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْۚ إِنَّ رَبَّكَ يَقْضِى بَيْنَهُمْ يَوْمَ ٱلْقِيَٰمَةِ فِيمَا كَانُوا۟ فِيهِ يَخْتَلِفُونَ ", "translation": "And We gave them clear proofs of the matter [of religion]. And they did not differ except after knowledge had come to them - out of jealous animosity between themselves. Indeed, your Lord will judge between them on the Day of Resurrection concerning that over which they used to differ.", "words": [{"id": 1, "arabic": "وَءَاتَيْنَٰهُم", "translit": "mُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 2, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 5, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 6, "arabic": "ٱخْتَلَفُوٓا۟", "translit": "۟āٓwُfَlَtْhkٱ", "root": "خلف"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 9, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 12, "arabic": "ٱلْعِلْمُ", "translit": "ُmْlِʿعْlٱ", "root": "علم"}, {"id": 13, "arabic": "بَغْيًۢا", "translit": "āًۢyْغَb", "root": "بغي"}, {"id": 14, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 17, "arabic": "يَقْضِى", "translit": "àِḍْqَy", "root": "قضي"}, {"id": 18, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 19, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 20, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 21, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 22, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 23, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 24, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": true}, {"ayah": 18, "text": "ثُمَّ جَعَلْنَٰكَ عَلَىٰ شَرِيعَةٍ مِّنَ ٱلْأَمْرِ فَٱتَّبِعْهَا وَلَا تَتَّبِعْ أَهْوَآءَ ٱلَّذِينَ لَا يَعْلَمُونَ ", "translation": "Then We put you, [O Muḥammad], on an ordained way concerning the matter [of religion]; so follow it and do not follow the inclinations of those who do not know.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰكَ", "translit": "َkَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "شَرِيعَةٍ", "translit": "ٍẗَʿعyِrَhs", "root": "شرع"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 7, "arabic": "فَٱتَّبِعْهَا", "translit": "āَhْʿعِbَّtٱَf", "root": "تبع"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "تَتَّبِعْ", "translit": "ْʿعِbَّtَt", "root": "تبع"}, {"id": 10, "arabic": "أَهْوَآءَ", "translit": "َءٓāَwْhَaʾ", "root": "هوي"}, {"id": 11, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 19, "text": "إِنَّهُمْ لَن يُغْنُوا۟ عَنكَ مِنَ ٱللَّهِ شَيْـًٔاۚ وَإِنَّ ٱلظَّٰلِمِينَ بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۖ وَٱللَّهُ وَلِىُّ ٱلْمُتَّقِينَ ", "translation": "Indeed, they will never avail you against Allāh at all. And indeed, the wrongdoers are allies of one another; but Allāh is the protector of the righteous.", "words": [{"id": 1, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 3, "arabic": "يُغْنُوا۟", "translit": "۟āwُnْغُy", "root": "غني"}, {"id": 4, "arabic": "عَنكَ", "translit": "َknَʿع", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 8, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 9, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}, {"id": 10, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 11, "arabic": "أَوْلِيَآءُ", "translit": "ُءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 12, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 13, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 14, "arabic": "وَلِىُّ", "translit": "ُّàِlَw", "root": "ولي"}, {"id": 15, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": true}, {"ayah": 20, "text": "هَٰذَا بَصَٰٓئِرُ لِلنَّاسِ وَهُدًى وَرَحْمَةٌ لِّقَوْمٍ يُوقِنُونَ ", "translation": "This [Qur’ān] is enlightenment for mankind and guidance and mercy for a people who are certain [in faith].", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "بَصَٰٓئِرُ", "translit": "ُrِyʾَٰٓṣَb", "root": "بصر"}, {"id": 3, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 4, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 5, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 6, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 7, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": true}, {"ayah": 21, "text": "أَمْ حَسِبَ ٱلَّذِينَ ٱجْتَرَحُوا۟ ٱلسَّيِّـَٔاتِ أَن نَّجْعَلَهُمْ كَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَوَآءً مَّحْيَاهُمْ وَمَمَاتُهُمْۚ سَآءَ مَا يَحْكُمُونَ ", "translation": "Or do those who commit evils think We will make them like those who have believed and done righteous deeds - [make them] equal in their life and their death?[1] Evil is that which they judge [i.e., assume].", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "حَسِبَ", "translit": "َbِsَḥ", "root": "حسب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ٱجْتَرَحُوا۟", "translit": "۟āwُḥَrَtْjgٱ", "root": "جرح"}, {"id": 5, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "نَّجْعَلَهُمْ", "translit": "ْmُhَlَʿعْjgَّn", "root": "جعل"}, {"id": 8, "arabic": "كَٱلَّذِينَ", "translit": "َnyِhdَّlٱَk", "root": ""}, {"id": 9, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 10, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 11, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 12, "arabic": "سَوَآءً", "translit": "ًءٓāَwَs", "root": "سوي"}, {"id": 13, "arabic": "مَّحْيَاهُمْ", "translit": "ْmُhāَyْḥَّm", "root": "حيي"}, {"id": 14, "arabic": "وَمَمَاتُهُمْ", "translit": "ْmُhُtāَmَmَw", "root": "موت"}, {"id": 15, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "يَحْكُمُونَ", "translit": "َnwُmُkْḥَy", "root": "حكم"}], "hasIhya": true}, {"ayah": 22, "text": "وَخَلَقَ ٱللَّهُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَلِتُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ ", "translation": "And Allāh created the heavens and earth in truth and so that every soul may be recompensed for what it has earned, and they will not be wronged.", "words": [{"id": 1, "arabic": "وَخَلَقَ", "translit": "َqَlَhkَw", "root": "خلق"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "وَلِتُجْزَىٰ", "translit": "ٰàَzْjgُtِlَw", "root": "جزي"}, {"id": 7, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 8, "arabic": "نَفْسٍۭ", "translit": "ٍۭsْfَn", "root": "نفس"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 11, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 23, "text": "أَفَرَءَيْتَ مَنِ ٱتَّخَذَ إِلَٰهَهُۥ هَوَىٰهُ وَأَضَلَّهُ ٱللَّهُ عَلَىٰ عِلْمٍ وَخَتَمَ عَلَىٰ سَمْعِهِۦ وَقَلْبِهِۦ وَجَعَلَ عَلَىٰ بَصَرِهِۦ غِشَٰوَةً فَمَن يَهْدِيهِ مِنۢ بَعْدِ ٱللَّهِۚ أَفَلَا تَذَكَّرُونَ ", "translation": "Have you seen he who has taken as his god his [own] desire, and Allāh has sent him astray due to knowledge[1] and has set a seal upon his hearing and his heart and put over his vision a veil? So who will guide him after Allāh? Then will you not be reminded?", "words": [{"id": 1, "arabic": "أَفَرَءَيْتَ", "translit": "َtْyَءَrَfَaʾ", "root": "راي"}, {"id": 2, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 3, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 4, "arabic": "إِلَٰهَهُۥ", "translit": "ۥُhَhَٰlِiʾ", "root": "اله"}, {"id": 5, "arabic": "هَوَىٰهُ", "translit": "ُhٰàَwَh", "root": "هوي"}, {"id": 6, "arabic": "وَأَضَلَّهُ", "translit": "ُhَّlَḍَaʾَw", "root": "ضلل"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 10, "arabic": "وَخَتَمَ", "translit": "َmَtَhkَw", "root": "ختم"}, {"id": 11, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 12, "arabic": "سَمْعِهِۦ", "translit": "ۦِhِʿعْmَs", "root": "سمع"}, {"id": 13, "arabic": "وَقَلْبِهِۦ", "translit": "ۦِhِbْlَqَw", "root": "قلب"}, {"id": 14, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 15, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 16, "arabic": "بَصَرِهِۦ", "translit": "ۦِhِrَṣَb", "root": "بصر"}, {"id": 17, "arabic": "غِشَٰوَةً", "translit": "ًẗَwَٰhsِغ", "root": "غشو"}, {"id": 18, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 19, "arabic": "يَهْدِيهِ", "translit": "ِhyِdْhَy", "root": "هدي"}, {"id": 20, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 21, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 24, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": true}, {"ayah": 24, "text": "وَقَالُوا۟ مَا هِىَ إِلَّا حَيَاتُنَا ٱلدُّنْيَا نَمُوتُ وَنَحْيَا وَمَا يُهْلِكُنَآ إِلَّا ٱلدَّهْرُۚ وَمَا لَهُم بِذَٰلِكَ مِنْ عِلْمٍۖ إِنْ هُمْ إِلَّا يَظُنُّونَ ", "translation": "And they say, \"There is not but our worldly life; we die and live,[1] and nothing destroys us except time.\" And they have of that no knowledge; they are only assuming.", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "حَيَاتُنَا", "translit": "āَnُtāَyَḥ", "root": "حيي"}, {"id": 6, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 7, "arabic": "نَمُوتُ", "translit": "ُtwُmَn", "root": "موت"}, {"id": 8, "arabic": "وَنَحْيَا", "translit": "āَyْḥَnَw", "root": "حيي"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "يُهْلِكُنَآ", "translit": "ٓāَnُkِlْhُy", "root": "هلك"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلدَّهْرُ", "translit": "ُrْhَّdlٱ", "root": "دهر"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 15, "arabic": "بِذَٰلِكَ", "translit": "َkِlَٰhdِb", "root": ""}, {"id": 16, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 17, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 18, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 19, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "يَظُنُّونَ", "translit": "َnwُّnُẓَy", "root": "ظنن"}], "hasIhya": false}, {"ayah": 25, "text": "وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَٰتُنَا بَيِّنَٰتٍ مَّا كَانَ حُجَّتَهُمْ إِلَّآ أَن قَالُوا۟ ٱئْتُوا۟ بِـَٔابَآئِنَآ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And when Our verses are recited to them as clear evidences, their argument is only that they say, \"Bring [back] our forefathers, if you should be truthful.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ءَايَٰتُنَا", "translit": "āَnُtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "حُجَّتَهُمْ", "translit": "ْmُhَtَّjgُḥ", "root": "حجج"}, {"id": 9, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 12, "arabic": "ٱئْتُوا۟", "translit": "۟āwُtْyʾٱ", "root": "اتي"}, {"id": 13, "arabic": "بِـَٔابَآئِنَآ", "translit": "ٓāَnِyʾٓāَbāَٔـِb", "root": "ابو"}, {"id": 14, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 15, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 16, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 26, "text": "قُلِ ٱللَّهُ يُحْيِيكُمْ ثُمَّ يُمِيتُكُمْ ثُمَّ يَجْمَعُكُمْ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ لَا رَيْبَ فِيهِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ", "translation": "Say, \"Allāh causes you to live, then causes you to die; then He will assemble you for the Day of Resurrection, about which there is no doubt, but most of the people do not know.\"", "words": [{"id": 1, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "يُحْيِيكُمْ", "translit": "ْmُkyِyْḥُy", "root": "حيي"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "يُمِيتُكُمْ", "translit": "ْmُkُtyِmُy", "root": "موت"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "يَجْمَعُكُمْ", "translit": "ْmُkُʿعَmْjgَy", "root": "جمع"}, {"id": 8, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 9, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 10, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 13, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 14, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 15, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 16, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 27, "text": "وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَيَوْمَ تَقُومُ ٱلسَّاعَةُ يَوْمَئِذٍ يَخْسَرُ ٱلْمُبْطِلُونَ ", "translation": "And to Allāh belongs the dominion of the heavens and the earth. And the Day the Hour appears - that Day the falsifiers will lose.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 6, "arabic": "تَقُومُ", "translit": "ُmwُqَt", "root": "قوم"}, {"id": 7, "arabic": "ٱلسَّاعَةُ", "translit": "ُẗَʿعāَّslٱ", "root": "سوع"}, {"id": 8, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 9, "arabic": "يَخْسَرُ", "translit": "ُrَsْhkَy", "root": "خسر"}, {"id": 10, "arabic": "ٱلْمُبْطِلُونَ", "translit": "َnwُlِṭْbُmْlٱ", "root": "بطل"}], "hasIhya": false}, {"ayah": 28, "text": "وَتَرَىٰ كُلَّ أُمَّةٍ جَاثِيَةًۚ كُلُّ أُمَّةٍ تُدْعَىٰٓ إِلَىٰ كِتَٰبِهَا ٱلْيَوْمَ تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ ", "translation": "And you will see every nation kneeling [from fear]. Every nation will be called to its record [and told], \"Today you will be recompensed for what you used to do.", "words": [{"id": 1, "arabic": "وَتَرَىٰ", "translit": "ٰàَrَtَw", "root": "راي"}, {"id": 2, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 3, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "جَاثِيَةً", "translit": "ًẗَyِhtāَjg", "root": "جثو"}, {"id": 5, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 6, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 7, "arabic": "تُدْعَىٰٓ", "translit": "ٰٓàَʿعْdُt", "root": "دعو"}, {"id": 8, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 9, "arabic": "كِتَٰبِهَا", "translit": "āَhِbَٰtِk", "root": "كتب"}, {"id": 10, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 11, "arabic": "تُجْزَوْنَ", "translit": "َnْwَzْjgُt", "root": "جزي"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 29, "text": "هَٰذَا كِتَٰبُنَا يَنطِقُ عَلَيْكُم بِٱلْحَقِّۚ إِنَّا كُنَّا نَسْتَنسِخُ مَا كُنتُمْ تَعْمَلُونَ ", "translation": "This, Our record, speaks about you in truth. Indeed, We were having transcribed[1] whatever you used to do.\"", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "كِتَٰبُنَا", "translit": "āَnُbَٰtِk", "root": "كتب"}, {"id": 3, "arabic": "يَنطِقُ", "translit": "ُqِṭnَy", "root": "نطق"}, {"id": 4, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 7, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 8, "arabic": "نَسْتَنسِخُ", "translit": "ُhkِsnَtْsَn", "root": "نسخ"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 30, "text": "فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَيُدْخِلُهُمْ رَبُّهُمْ فِى رَحْمَتِهِۦۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْمُبِينُ ", "translation": "So as for those who believed and did righteous deeds, their Lord will admit them into His mercy. That is what is the clear attainment.", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "فَيُدْخِلُهُمْ", "translit": "ْmُhُlِhkْdُyَf", "root": "دخل"}, {"id": 7, "arabic": "رَبُّهُمْ", "translit": "ْmُhُّbَr", "root": "ربب"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "رَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَr", "root": "رحم"}, {"id": 10, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 11, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 12, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 13, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 31, "text": "وَأَمَّا ٱلَّذِينَ كَفَرُوٓا۟ أَفَلَمْ تَكُنْ ءَايَٰتِى تُتْلَىٰ عَلَيْكُمْ فَٱسْتَكْبَرْتُمْ وَكُنتُمْ قَوْمًا مُّجْرِمِينَ ", "translation": "But as for those who disbelieved, [it will be said], \"Were not Our verses recited to you, but you were arrogant and became a criminal people?", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "أَفَلَمْ", "translit": "ْmَlَfَaʾ", "root": ""}, {"id": 5, "arabic": "تَكُنْ", "translit": "ْnُkَt", "root": "كون"}, {"id": 6, "arabic": "ءَايَٰتِى", "translit": "àِtَٰyāَء", "root": "ايي"}, {"id": 7, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 8, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 9, "arabic": "فَٱسْتَكْبَرْتُمْ", "translit": "ْmُtْrَbْkَtْsٱَf", "root": "كبر"}, {"id": 10, "arabic": "وَكُنتُمْ", "translit": "ْmُtnُkَw", "root": "كون"}, {"id": 11, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 12, "arabic": "مُّجْرِمِينَ", "translit": "َnyِmِrْjgُّm", "root": "جرم"}], "hasIhya": false}, {"ayah": 32, "text": "وَإِذَا قِيلَ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ وَٱلسَّاعَةُ لَا رَيْبَ فِيهَا قُلْتُم مَّا نَدْرِى مَا ٱلسَّاعَةُ إِن نَّظُنُّ إِلَّا ظَنًّا وَمَا نَحْنُ بِمُسْتَيْقِنِينَ ", "translation": "And when it was said, 'Indeed, the promise of Allāh is truth and the Hour [is coming] - no doubt about it,' you said, 'We know not what is the Hour. We assume only assumption, and we are not convinced.'\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "حَقٌّ", "translit": "ٌّqَḥ", "root": "حقق"}, {"id": 7, "arabic": "وَٱلسَّاعَةُ", "translit": "ُẗَʿعāَّslٱَw", "root": "سوع"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 11, "arabic": "قُلْتُم", "translit": "mُtْlُq", "root": "قول"}, {"id": 12, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 13, "arabic": "نَدْرِى", "translit": "àِrْdَn", "root": "دري"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "ٱلسَّاعَةُ", "translit": "ُẗَʿعāَّslٱ", "root": "سوع"}, {"id": 16, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 17, "arabic": "نَّظُنُّ", "translit": "ُّnُẓَّn", "root": "ظنن"}, {"id": 18, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 19, "arabic": "ظَنًّا", "translit": "āًّnَẓ", "root": "ظنن"}, {"id": 20, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 21, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 22, "arabic": "بِمُسْتَيْقِنِينَ", "translit": "َnyِnِqْyَtْsُmِb", "root": "يقن"}], "hasIhya": false}, {"ayah": 33, "text": "وَبَدَا لَهُمْ سَيِّـَٔاتُ مَا عَمِلُوا۟ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "And the evil consequences of what they did will appear to them, and they will be enveloped by what they used to ridicule.", "words": [{"id": 1, "arabic": "وَبَدَا", "translit": "āَdَbَw", "root": "بدو"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "سَيِّـَٔاتُ", "translit": "ُtāَٔـِّyَs", "root": "سوا"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 6, "arabic": "وَحَاقَ", "translit": "َqāَḥَw", "root": "حيق"}, {"id": 7, "arabic": "بِهِم", "translit": "mِhِb", "root": ""}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 34, "text": "وَقِيلَ ٱلْيَوْمَ نَنسَىٰكُمْ كَمَا نَسِيتُمْ لِقَآءَ يَوْمِكُمْ هَٰذَا وَمَأْوَىٰكُمُ ٱلنَّارُ وَمَا لَكُم مِّن نَّٰصِرِينَ ", "translation": "And it will be said, \"Today We will forget you as you forgot the meeting of this Day of yours, and your refuge is the Fire, and for you there are no helpers.", "words": [{"id": 1, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 3, "arabic": "نَنسَىٰكُمْ", "translit": "ْmُkٰàَsnَn", "root": "نسي"}, {"id": 4, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 5, "arabic": "نَسِيتُمْ", "translit": "ْmُtyِsَn", "root": "نسي"}, {"id": 6, "arabic": "لِقَآءَ", "translit": "َءٓāَqِl", "root": "لقي"}, {"id": 7, "arabic": "يَوْمِكُمْ", "translit": "ْmُkِmْwَy", "root": "يوم"}, {"id": 8, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 9, "arabic": "وَمَأْوَىٰكُمُ", "translit": "ُmُkٰàَwْaʾَmَw", "root": "اوي"}, {"id": 10, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "نَّٰصِرِينَ", "translit": "َnyِrِṣَّٰn", "root": "نصر"}], "hasIhya": false}, {"ayah": 35, "text": "ذَٰلِكُم بِأَنَّكُمُ ٱتَّخَذْتُمْ ءَايَٰتِ ٱللَّهِ هُزُوًا وَغَرَّتْكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَاۚ فَٱلْيَوْمَ لَا يُخْرَجُونَ مِنْهَا وَلَا هُمْ يُسْتَعْتَبُونَ ", "translation": "That is because you took the verses of Allāh in ridicule, and worldly life deluded you.\" So that Day they will not be removed from it, nor will they be asked to appease [Allāh].", "words": [{"id": 1, "arabic": "ذَٰلِكُم", "translit": "mُkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّكُمُ", "translit": "ُmُkَّnَaʾِb", "root": ""}, {"id": 3, "arabic": "ٱتَّخَذْتُمْ", "translit": "ْmُtْhdَhkَّtٱ", "root": "اخذ"}, {"id": 4, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 7, "arabic": "وَغَرَّتْكُمُ", "translit": "ُmُkْtَّrَغَw", "root": "غرر"}, {"id": 8, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 9, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 10, "arabic": "فَٱلْيَوْمَ", "translit": "َmْwَyْlٱَf", "root": "يوم"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُخْرَجُونَ", "translit": "َnwُjgَrْhkُy", "root": "خرج"}, {"id": 13, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 16, "arabic": "يُسْتَعْتَبُونَ", "translit": "َnwُbَtْʿعَtْsُy", "root": "عتب"}], "hasIhya": false}, {"ayah": 36, "text": "فَلِلَّهِ ٱلْحَمْدُ رَبِّ ٱلسَّمَٰوَٰتِ وَرَبِّ ٱلْأَرْضِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "Then, to Allāh belongs [all] praise - Lord of the heavens and Lord of the earth, Lord of the worlds.", "words": [{"id": 1, "arabic": "فَلِلَّهِ", "translit": "ِhَّlِlَf", "root": "اله"}, {"id": 2, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 3, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَرَبِّ", "translit": "ِّbَrَw", "root": "ربب"}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 8, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 37, "text": "وَلَهُ ٱلْكِبْرِيَآءُ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "And to Him belongs [all] grandeur within the heavens and the earth, and He is the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "وَلَهُ", "translit": "ُhَlَw", "root": ""}, {"id": 2, "arabic": "ٱلْكِبْرِيَآءُ", "translit": "ُءٓāَyِrْbِkْlٱ", "root": "كبر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 8, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}], "tafsir": {"13": [{"arabic": "وسخر لكم ما في السموات وما في الأرض جميعا منه نعم إذا كسر ذلك من ملك غيره فهو ظالم أيضا وإن كان محتاجا لأن كل شجرة بعينها لاتفى بحاجات عباد الله كلهم بل تفي بحاجة واحدة ولو خصص واحد بها من غير رجحان واختصاص كان ظلما فصاحب الاختصاص هو الذي حصل البذر ووضعه في الأرض وساق إليه الماء وقام بالتعهد فهو أولى به من غيره فيرجع جانبه بذلك فإن نبت ذلك في موات الأرض لا بسعي آدمي اختص بمغرسه أو بغرسه فلا بد من طلب اختصاص آخر وهو السبق إلى أخذه فللسابقخاصية السبق فالعدل هو أن يكون أولى به وعبر الفقراء عن هذا ا", "english": "...to your heart, so that your heart becomes bound by it, and thus your body becomes bound in that direction in a posture of stillness and solemnity when you worship your Lord. Likewise, your actions are divided into those that are noble — such as acts of obedience — and those that are base — such as relieving oneself or spitting. So when you spit toward the direction of the Qiblah, you have indeed wronged it (ẓalamtahā) and shown ingratitude for the blessing (niʿmah) of Allah Most High upon you, by virtue of His placing the Qiblah, through whose placement the perfection of your worship is achieved. Similarly, when you put on your leather sock (khuff) and begin with the left foot, you have wronged (ẓalamta), because the sock is a protection for the foot; the foot has a share in it, and in matters of shares and portions, one ought to begin with the nobler — that is justice (al-ʿadl) and fidelity to wisdom, while its opposite is injustice (ẓulm) and ingratitude for the blessing of the sock and the foot. And this, in the eyes of the knowers (al-ʿārifīn), is a grave offense (kabīrah), even if the jurist (al-faqīh) labels it merely \"disliked\" (makrūh) — to the extent that one of them (the righteous predecessors) had gathered many measures of wheat and was giving them in charity, and when asked about the reason, he said: \"I once put on a sandal and began with the left foot inadvertently, so I wish to expiate that (kufr) through charity.\" Yes, the jurist is unable to magnify the matter in these affairs, because he is constrained — rather, he is occupied with reforming the common folk (al-ʿawāmm), whose rank approaches the rank of the beasts (al-anʿām), and they are plunged into darknesses (ẓulumāt) far greater and more immense than that such minor darknesses should appear in comparison to them. For it would be ugly to say of one who drank wine and took the cup with his left hand that he transgressed in two respects — one being the drinking, and the other the taking with the left — and of one who sold wine at the time of the call to prayer on Friday, it would be ugly to say he betrayed in two respects — {one} the selling of wine, and the other the selling at the time of the call. And of one who relieved himself in the prayer niche (miḥrāb) of a mosque with his back to the Qiblah, it would be ugly to mention his abandonment of propriety in relieving himself, in that he did not place the Qiblah to his right. For all sins are darknesses, some piled atop others, such that one is eclipsed beside another. A master may punish his slave if he uses his knife without his permission — but if he killed his most beloved son with that very knife, the unauthorized use of the knife would retain no weight or sting in itself. Thus, all the etiquettes (ādāb) that the Prophets and the Saints (al-awliyāʾ) observed, and which we have treated leniently in jurisprudence (fiqh) concerning the common folk, have as their cause this very necessity. Otherwise, all these disliked acts are deviations from justice (al-ʿadl), ingratitude for blessing (kufrān al-niʿmah), and a deficiency in the rank that conveys the servant to the degrees of proximity (darajāt al-qurb) — some of them affect the servant by diminishing proximity and lowering station, while others expel him entirely from the bounds of proximity into the realm of distance (ʿālam al-buʿd), which is the abode of the devils. Likewise, whoever breaks a branch from a tree without an urgent pressing need, and without a sound purpose, has shown ingratitude for the blessing of Allah Most High in the creation of trees and the creation of the hand. As for the hand, it was not created for frivolity, but for obedience and for deeds that aid in obedience. As for the tree, Allah Most High created it, and created for it roots, and conveyed water to it, and placed within it the power of nourishment and growth, so that it might reach the culmination of its development (munthā nashwihi), and His servants might benefit from it. So breaking it before its culmination, not in a manner by which His servants benefit, is a violation of the purpose of wisdom and a deviation from justice. But if he has a sound purpose, then that is permissible for him — for trees and animals have been made a ransom (fidāʾ) for the purposes of human beings, since both are perishable and doomed. Thus, annihilating the baser (al-akhass) for the preservation of the nobler (al-ashraf) for a time is closer to justice than squandering both. And to this points His saying, Most High: {«وَسَخَّرَ لَكُم مَّا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ جَمِيعًا مِّنْهُ»} — \"And He subjected to you whatever is in the heavens and whatever is on the earth — all from Him\" [Al-Jāthiyah: 13]. Yes — if he breaks a tree belonging to someone else, he is also a wrongdoer (ẓālim), even if he is in need, because every specific tree does not suffice for the needs of all the servants of Allah; rather, it suffices for a single need. And if one single person were to be singled out for it without preponderance (tarjīḥ) and specification (ikhtiṣāṣ), that would be injustice. So the one entitled to specification is he who obtained the seed, placed it in the ground, conveyed water to it, and undertook its care — he is more worthy of it than others, and his side is thereby established. But if it grew in dead land (mawāt al-arḍ) without any human effort, then one must seek another specification — namely, precedence in taking it (sabq ilā akhdhihi). For the one who precedes has the special property of precedence (khāṣṣiyyat al-sabq). Justice, then, is that he be most worthy of it. And the poor (al-fuqarāʾ) have expressed this preponderance by the term \"ownership\" (al-milk) — but it is pure metaphor (majāz maḥḍ), for there is no owner except the King of Kings (Malik al-Mulūk), to Whom belongs what is in the heavens and the earth. And how could a servant be an owner, when he himself does not own his own self — rather, he is the property of Another? Yes — the creatures are the servants of Allah, and the earth is the table (māʾidah) of Allah, and He has permitted them to eat from His table to the measure of their need — like a king who sets a table for his slaves. So if one takes a morsel with his right hand, and his fingers close over it, and another slave comes and seeks to snatch it away...", "book_title": "Patience and Gratitude", "section_title_ar": "Section 986", "section_title_en": "The Etiquette of the Heart and the Hidden Dimensions of Violating Sacred Directions and Blessings", "section_index": 986, "anchors": "- Root: ظلم (ẓ-l-m)\n  * Lisan / Ayn: Core meaning is \"darkness\" (ẓulmah) — absence of light; also \"to place something in other than its proper place\" (waḍʿ al-shayʾ fī ghayr mawḍiʿihi).\n  * Al-Raghib (Mufradat): Ẓulm is expressed via \"darknesses\" (ẓulumāt) as ignorance, polytheism, and transgression — the opposite of nūr (light/justice).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"الظلم ظلمات يوم القيامة\" — injustice is darknesses on the Day of Judgment. Metaphorical (majāz): \"أرض مظلومة\" — land never dug, i.e., violated by first use; \"ظلم البعير\" — slaughtering an animal without cause (ʿabṭ).\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Niʿmah is a state of well-being; also \"softness\" and \"delicacy.\"\n  * Al-Raghib (Mufradat): Niʿmah is the good condition bestowed; its plural (niʿam) covers both little and much — \"وَإِن تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا\" {And if you count the blessings of Allah, you cannot enumerate them} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal: \"جلت نعمة الله\" — the blessing of Allah is immense. Metaphorical: \"خفت نعامتهم\" — their ostriches departed (i.e., they fled), showing how blessing can be \"kicked away\" (kufrān al-niʿmah).\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Ownership and dominion; the possessor (mālik) who disposes freely.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي\" — the king is one who commands and forbids; true ownership belongs only to Allah, \"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ\" {To Him belongs what is in the heavens and the earth}.\n  * Al-Zamakhshari (Asas): Literal: \"ملك يده\" — what one's hand owns. Metaphorical: \"ملكت فلانة أمرها\" — she controlled her own affair; here, human \"ownership\" (milk) is pure metaphor (majāz maḥḍ), since real dominion is Allah's alone.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governs how qualifying clauses (e.g., \"التي بوضعها كمال عبادتك\") attach to antecedents, preserving syntactic cohesion even when embedded phrases lengthen the sentence, ensuring no semantic break occurs between the act and its moral consequence.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Patience and Gratitude'", "badge": "Du'a"}], "15": [{"arabic": "ومجاهداتك أيضا هو مستغن عنها وإنما هى طريقك إلى نجاتك فمن أحسن فلنفسه ومن أساء فعليها والله غنى عن العالمين ويحك يا نفس انزعى عن جهلك وقيسى آخرتك بدنياك فما خلقكم ولا بعثكم إلا كنفس واحدة وكما بدأنا أول خلق نعيده وكما بدأكم تعودون وسنة الله تعالى لا تجدين لها تبديلا ولا تحويلا ويحك يا نفس ما أراك إلا ألفت الدنيا وأنست بها فعسر عليك مفارقتها وأنت مقبلة على مقاربتها وتؤكدين في نفسك مودتها فاحسن أنك غافلة عن عقاب الله وثوابه وعن أهوال القيامة وأحوالها فما أنت مؤمنة بالموت المفرق بينك وبين محابك أفترين أن من يدخل دار ملك ليخرج من الج", "english": "...from creation, but rather you attain your goal through every stratagem. And by this ignorance you deserve the title of foolishness from the Messenger of God, may God bless him and grant him peace, where he said: \"The shrewd one is he who holds his soul to account and works for what comes after death, and the foolish one is he who follows his soul's whims and harbors vain hopes upon God.\" {«الكيس من دان نفسه وعمل لما بعد الموت والأحمق من أتبع نفسه هواها وتمنى على الله الأماني»}", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1253", "section_title_en": "Section 1253 — The Soul's Self-Reproach and the Awakening from Negligence", "section_index": 1253, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates and is addressed as an independent moral agent.\n  * Al-Raghib (Mufradat): The soul as the locus of divine address and self-knowledge; its essence (dhāt) is the referent of God's \"self\" in revelation, yet here it is the reproaching subject.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) usage as the speaking, desiring self; metaphorical (majāz) extension to blame and counsel, as in \"self-accusation\" (lawwāmah).\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of life; the inevitable terminus of every soul.\n  * Al-Raghib (Mufradat): Death as separation (furqah) from worldly attachments and the transition to reckoning; linked to the soul's journey.\n  * Al-Zamakhshari (Asas): Literal death of the body; metaphorical \"death\" of the heart through heedlessness, contrasted here with physical death as the ultimate wake-up call.\n- Root: جهل (j-h-l)\n  * Lisan / Ayn: Ignorance as the absence of knowledge; folly and rashness.\n  * Al-Raghib (Mufradat): Ignorance as the soul's failure to perceive true realities, leading to misplaced desires and false hopes.\n  * Al-Zamakhshari (Asas): Literal ignorance of facts; metaphorical ignorance as moral stupidity, as when the soul follows whims despite clear signs.\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): Drawing near (dunūw) to God through obedience, contrasted with the soul's clinging to the near (dunyā) world.\n  * Al-Zamakhshari (Asas): Literal proximity; metaphorical use for the \"lower\" world (dunyā) as that which is nearer and inferior.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize exclusive causation, e.g., \"God's generosity is only in guiding you to the path,\" restricting divine favor to guidance, not exemption from effort.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'", "badge": "Afterlife"}], "17": [{"arabic": "عالم الغيب والشهادة أنت تحكم بين عبادك فيما كانوا فيه يختلفون اهدني لما اختلف فيه من الحق بإذنك إنك تهدي من تشاء إلى صراط مستقيما (7) ثم يفتتح الصلاة ويصلي ركعتين خفيفتين ثم يصلي مثنى مثنى ما تيسر له ويختم بالوتر إن لم يكن قد صلى الوتر ويستحب أن يفصل بين الصلاتين عند تسليمه بمائة تسبيحة ليستريح ويزيد نشاطه للصلاة وقد صح في صلاة رسول الله صلى الله عليه وسلم بالليل أنه صلى أولا ركعتين خفيفتين ثم ركعتين طويلتين ثم ركعتين دون اللتين قبلهما ثم لم يزل يقصر بالتدريج إلى ثلاث عشرة ركعة (1) وسئلت عائشة رضي الله", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}], "19": [{"arabic": "فاخفض صوتك وإن كنت تريد الناس فإنهم لن يغنوا عنك من الله شيئا فسكت عمر بن عبد العزيز وخفف ركعته فلما سلم أخذ نعليه وانصرف وهو يومئذ أمير المدينة ويدل على استحباب الجهر ما روي أن النبي صلى الله عليه وسلم سمع جماعة من أصحابه يجهرون في صلاة الليل فصوب ذلك (7) وقد قال صلى الله عليه وسلم", "english": "If he recites without ritual purity, reclining upon his bed, he also has merit, but it is below that [of the one who is pure and seated properly]. Allah Most High said: {الَّذِينَ يَذْكُرُونَ اللَّهَ قِيَامًا وَقُعُودًا وَعَلَىٰ جُنُوبِهِمْ وَيَتَفَكَّرُونَ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ} (\"Those who remember Allah standing, sitting, and upon their sides, and reflect upon the creation of the heavens and the earth\") — and He praised all of them, but He mentioned standing first, then sitting, then remembrance while reclining.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 223", "section_title_en": "The Book of the Etiquette of Qur'an Recitation — Section 223: On the Manners of the Reciter, the Measure of Recitation, Division into Portions, Orthography, Tartīl, Weeping, Rights of the Verses, Invocations, and Vocalization", "section_index": 223, "anchors": "- Root: قرا (Q-R-A)\n  * Lisan / Ayn: To read, recite, gather together; the core act of assembling letters into articulated speech.\n  * Al-Raghib (Mufradat): Recitation (tilāwah) is the following of the Qur'an in obedience and belief; qirā'ah is the articulation of the letters. The term carries both the physical act of vocalization and the spiritual act of devotion.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): to read from a written text or from memory. Metaphorical (majāz): \"qara'a al-rajul\" — to become religious, devoted, as the reciter is characterized by the state of worship.\n- Root: سجد (S-J-D)\n  * Lisan / Ayn: To bow, prostrate, lower oneself; the physical posture of placing the forehead on the ground.\n  * Al-Raghib (Mufradat): Prostration is of two kinds: voluntary (ikhtiyārī) — exclusive to humans, by which reward is deserved; and subjugated (taskhīrī) — universal to all creation, as in {وَلِلَّهِ يَسْجُدُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ}.\n  * Al-Zamakhshari (Asas): Literal: the physical act of prostration. Metaphorical: \"shajarah sājidah\" — a tree bending over; \"ʿayn sājidah\" — a languid, drooping eye. The prostration of recitation is the literal act performed in obedience to the command of the verse.\n- Root: تلو (T-L-W)\n  * Lisan / Ayn: To follow, to recite; the reciter \"follows\" the letters in sequence and \"follows\" the commands contained therein.\n  * Al-Raghib (Mufradat): Tilāwah is following the Qur'an in deed as well as in word; the true reciter is he whose recitation is a following of the divine command.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional and restrictive structures in the prophetic sayings (e.g., \"من قرأ القرآن في أقل من ثلاث لم يفقهه\") establish a causal link between the act and its consequence, requiring precise parsing of the conditional clause to extract the legal ruling.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Condemnation of Anger and Hatred'", "badge": "Dhikr"}], "20": [{"arabic": "الله للناس أمثالهم واتبعوا أحسن ما أنزل إليكم من ربكم هذا بصائر للناس وهدى ورحمة لقوم يوقنون هذا بيان للناس وهدى وموعظة للمتقين وإذا قصد بالخطاب جميع الناس فقد قصد الآحاد فهذا القارىء الواحد مقصود فما له ولسائر الناس فليقدر أنه المقصود قال الله تعالى وأوحي إلي هذا القرآن لأنذركم به ومن بلغ قال محمد بن كعب القرظي من بلغه القرآن فكأنما كلمه الله وإذا قدر ذلك لم يتخذ دراسة القرآن عمله بل يقرؤه كما يقرأ العبد كتاب مولاه الذي كتبه إليه ليتأمله ويعمل بمقتضاه ولذلك قال بعض العلماء هذا القرآن رسائل أتتنا من قبل ربنا عز وجل بعهوده نتدبرها في الصل", "english": "[Root: ذكر]\n  • Al-Raghib (Al-Mufradat): \"الذكر: حضور الشيء القلب أو القول، ويكون تارة بالقلب وتارة باللسان، والذكر باللسان تارة يكون حضور المعنى وبعده، وقد يقال: ذكرته إذا جرى على لسانه وإن لم يحضره قلبه، والذكر بالقلب هو حضور المعنى، قال تعالى: ولا تطع من أغفلنا قلبه عن ذكرنا [الكهف/ 28]\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"ذكرت الشيء: نطقت به أو استحضرته بقلبك. وذكرت فلانا بخير وشر. واذكروا الله ذكرا كثيرا. والذكر: الشرف والصيت، قال تعالى: وإنه لذكر لك ولقومك [الزخرف/ 44]\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الذكر: الكتاب الذي فيه تذكير الناس، قال تعالى: وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم [النحل/ 44]، والذكر: القرآن، قال تعالى: إنا نحن نزلنا الذكر وإنا له لحافظون [الحجر/ 9]\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 229", "section_title_en": "Section 229", "section_index": 229, "anchors": "*(Anchors established)*", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Quran Recitation'", "badge": "Du'a"}], "21": [{"arabic": "الآية ليلة حتى أصبح أم حسب الذين اجترحوا السيئات أن نجعلهم كالذين آمنوا وعملوا الصالحات الآية وقال المغيرة بن حبيب رمقت مالك بن دينار فتوضأ بعد العشاء ثم قام إلى مصلاه فقبض على لحيته فخنقته العبرة فجعل يقول حرم شيبة مالك على النار إلهي قد علمت ساكن الجنة من ساكن النار فأي الرجلين مالك وأي الدارين دار مالك فلم يزل ذلك قوله حتى طلع الفجر وقال مالك بن دينار شهوت ليلة عن وردي ونمت فإذا أنا في المنام بجارية كأحسن ما يكون وفي يدها رقعة فقالت لي أتحسن تقرأ فقلت نعم فدفعت إلي الرقعة فإذا فيها أألهتك اللذائذ والأماني .", "english": "Know — may God guide you — that the Messenger of God (peace and blessings be upon him) said: \"O Abū Hurayrah, if you desire the pleasure of your Lord, pray in the corners of your house, and the light of your house will be in the heaven like the light of the stars and the planets in the sight of the people of the earth.\" (7)", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 273", "section_title_en": "Section 273 — The Virtues of Night Prayer (Qiyām al-Layl) and the Narrations Concerning the Devotions of the Righteous", "section_index": 273, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include ليالٍ and ليائل\n  * Al-Raghib (Mufradat): Night is contrasted with day as a sign of divine order; \"قيام الليل\" (night vigil) is the specific act of standing in prayer during the night hours\n  * Al-Zamakhshari (Asas): Literal — the night-time period; Metaphorical — \"أصبح\" as awakening from heedlessness, used for spiritual awakening\n- Root: صبح (Ṣubḥ)\n  * Lisan / Ayn: Dawn, morning; the time when the horizon reddens with the sun's approach\n  * Al-Raghib (Mufradat): \"الصبح والصباح، أول النهار\" — the first part of the day; \"أسحرنا\" (has dawn approached?) is the question asked to determine the end of the night vigil\n  * Al-Zamakhshari (Asas): Literal — daybreak; Metaphorical — \"أصبح يا رجل: انتبه من غفلتك\" (awaken from your heedlessness), used for spiritual alertness\n- Root: حتي (Ḥattā)\n  * Al-Raghib (Mufradat): A preposition of termination — \"until\"; used to mark the endpoint of the night vigil at dawn\n  * Sibawayh Rule: When ḥattā governs the subjunctive, it means \"until such time as\"; when followed by the indicative, it denotes a resulting state or concurrent circumstance\n- Root: عله (ʿAlaha)\n  * Lisan al-Arab: To be occupied with something; to be diverted from one's appointed task — as in the one who sleeps past his nightly devotion (wird)", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Arrangement of Litanies'", "badge": "Afterlife"}, {"arabic": "ليلة بهذه الآية {أم حسب الذين اجترحوا السيئات} الآية وقام سعيد بن جبير ليلة يردد هذه الآية وامتازوا اليوم أيها المجرمون وقال بعضهم إني لأفتتح السورة فيوقفني بعض ما أشهد فيها عن الفراغ منها حتى يطلع الفجر وكان بعضهم يقول آية لا أتفهمها ولا يكون قلبي فيها لا أعد لها ثوابا وحكي عن أبي سليمان الداراني أنه قال إني لأتلو الآية فأقيم فيها أربع ليال أو خمس ليال ولولا أني أقطع الفكر فيها ما جاوزتها إلى غيرها وعن بعض السلف أنه بقي في سورة هود ستة أشهر يكررها ولا يفرغ من التدبر فيها وقال بعض العار", "english": "Ali, may God be pleased with him, said: \"There is no good in worship that lacks understanding (fiqh), nor in recitation that lacks reflection.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 227", "section_title_en": "The Third Book on the Inward Acts During Recitation — Ten in Number", "section_index": 227, "anchors": "- Root: دبر (d-b-r)\n  * Lisan / Ayn: The rear, the back part; what comes after; to turn one's back; the end or sequel of a thing.\n  * Al-Raghib (Mufradat): That which is opposite of \"front\" (qabal); used metaphorically for what follows or comes after; \"adbar al-nahar\" — the latter part of the day; \"adbar al-sujud\" — the concluding portions of prayers.\n  * Al-Zamakhshari (Asas): Literal: the back or hind part. Metaphorical: what comes at the end, the sequel, the consequence of an affair.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform; the heart as that which is constantly turning and fluctuating between states.\n  * Al-Raghib (Mufradat): The turning and directing of a thing from one face to another; al-taqallub — the constant changing and fluctuation; the heart (qalb) is so named for its perpetual turning about of resolutions and states.\n  * Al-Zamakhshari (Asas): Literal: to turn a thing over from its face. Metaphorical: to ponder, to examine thoroughly, to turn a matter over in the mind — \"qallaba al-amr\" — he examined the affair from all sides.\n- Root: ختم (kh-t-m)\n  * Lisan / Ayn: To seal, to stamp, to imprint; the seal or stamp itself.\n  * Al-Raghib (Mufradat): Sealing and stamping — used both for the act of impressing and the impression left; metaphorically employed for securing a thing and preventing access to it, as in {«ختم الله على قلوبهم»} (God sealed their hearts).\n  * Al-Zamakhshari (Asas): Literal: placing a seal upon something. Metaphorical: to conclude, to finish, to bring to an end — \"khatama al-Qur'an\" — he completed the recitation of the Quran.\n- Root: بقي (b-q-y)\n  * Lisan / Ayn: To remain, to endure, to persist; the lasting and continuing of a thing.\n  * Al-Raghib (Mufradat): The persistence of a thing upon its original state; that which remains (al-baqi) is of two kinds: that which remains by itself without limit — and that is the Creator, may He be exalted — and that which remains by another, which is everything other than Him.\n  * Al-Zamakhshari (Asas): Literal: to remain, to stay. Metaphorical: \"baqiya al-shay'\" — the enduring of a thing; \"ma baqiyat minhum baqiyah\" — not one of them remained.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the construction \"innama\" is employed, it restricts the predicate to the subject alone, excluding all else. This is pertinent here as the author delimits the inward acts of recitation to precisely ten, no more and no less.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "23": [{"arabic": "تعالى ولا معبود غيره ومن اتخذ إلهه هواه فهو بعيد من الصدق في توحيده وأمره مخطر في نفسه فإن عجزت عن ذلك كله فكن محبا لرسول الله صلى الله عليه وسلم حريصا على تعظيم سننه ومتشوقا إلى مراعاة قلوب الصالحين من أمته ومتبركا بأدعيتهم فعساك أن تنال من شفاعته أو شفاعتهم فتنجو بالشفاعة إن كنت قليل البضاعة", "english": "And on the authority of Ibn Masʿūd, may God be pleased with him, that the Prophet, peace and blessings be upon him, said: \"God will gather the first and the last for an appointed time on a known Day, standing for forty years, their eyes fixed heavenward, awaiting the verdict of judgment.\" And he mentioned the ḥadīth until he reached the time of the prostration of the believers. He said: \"Then He will say to the believers: 'Raise your heads.' So they raise their heads, and they are given their light according to their deeds. Among them is one who is given his light like a great mountain, racing before him; among them is one who is given his light smaller than that; among them is one who is given his light like a palm tree; among them is one who is given his light smaller than that—until the last of them is a man who is given his light upon the toe of his foot. It shines once and dims once. When it shines, he steps forward with his foot and walks; when it darkens, he stands still.\" Then he mentioned their crossing over the Bridge (al-Ṣirāṭ) according to their light: among them is one who crosses like the blink of an eye; among them is one who crosses like lightning; among them is one who crosses like a cloud; among them is one who crosses like the shooting of stars; among them is one who crosses like the gallop of a horse; among them is one who crosses like the running of a man—until the one who was given his light upon the toe of his foot crosses, crawling on his face, hands, and feet. One hand is dragged while another clings; one foot is caught while another is dragged, and the fire touches his sides. He said: \"He will not cease thus until he is delivered. When he is delivered, he stands over it (the fire), then says: 'Praise be to God! God has given me what He has not given anyone, for He saved me from it after I had seen it.' Then he is taken to a pool at the gate of Paradise and bathes therein.\" (2) And Anas ibn Mālik said: \"I heard the Messenger of God, peace and blessings be upon him, say: 'The Bridge is like the edge of a sword or like the edge of a hair. The angels save the believing men and the believing women, and Gabriel, peace be upon him, takes hold of my waist, and I say: \"O Lord, save, save!\" The slipers and slippers among men and women on that Day are many.'\" (3)", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1345", "section_title_en": "The Terrors of the Bridge (Ṣirāṭ) and the Reality of Fear", "section_index": 1345, "anchors": "- Root: نور (n-w-r)\n  * Lisan / Ayn: Core meaning of radiant light, illumination, and luminosity; the source of visibility.\n  * Al-Raghib (Mufradat): Light is of two kinds: sensory (perceived by the eye) and intellectual/spiritual (perceived by the inner eye of insight). The light granted to the believers on the Day of Resurrection is a spiritual light (nūr maʿnawī) apportioned by divine justice according to their deeds, manifesting their degree of faith and works.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to physical illumination; metaphorical (majāz) usage refers to clarity, guidance, and manifestation. Here, the \"light\" is a metaphorical extension of the believer's true faith and righteous action, made perceptible in the Hereafter.\n- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Fear, dread, apprehension of a harmful or painful event.\n  * Al-Raghib (Mufradat): Fear (khawf) is the anticipation of something disliked, based on a probable or certain sign. It is the opposite of security (amn). True fear is a cognitive and motivational state that drives one to avoid its object, not mere emotional softness.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is the emotion of fear; metaphorical (majāz) usage, as in \"a fearful road\" (ṭarīq khāʾif), denotes a place or state that causes fear. Al-Ghazali here critiques the metaphorical \"fear\" of the foolish—mere verbal utterance without behavioral consequence.\n- Root: قدم (q-d-m)\n  * Lisan / Ayn: Foot; also precedence and advancement.\n  * Al-Raghib (Mufradat): The foot (qadam) is the instrument of standing and walking; from it, concepts of precedence (taqaddum) and delay are derived. In the ḥadīth, the light placed on the toe (ibhām al-qadam) signifies the minimal degree of faith, barely sufficient for movement.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is the physical foot; metaphorical (majāz) usage, as in \"place it under your feet\" (i.e., forgive it), indicates subjugation or minimal standing. Here, the toe's light is literal in the eschatological scene but symbolically denotes the weakest degree of saving faith.\n- Root: حصن (ḥ-ṣ-n)\n  * Lisan / Ayn: A fortress, an impregnable stronghold; that which protects its interior from penetration.\n  * Al-Raghib (Mufradat): A fortress (ḥiṣn) is a place of refuge; metaphorically, it applies to anything that provides protection, such as armor or a chaste woman. True protection from the terrors of the Hereafter is not a physical fortress but the sincere utterance of \"lā ilāha illā Allāh.\"\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is a fortified structure; metaphorical (majāz) usage, as in \"he came carrying a fortress\" (i.e., weapons), denotes any means of defense. Al-Ghazali employs this metaphorically: the only fortress against the terrors of the Hereafter is sincere monotheism.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its object by an intervening clause, as in \"فأنى يغني عنه ذلك من السبع\" (So how can that avail him against the lion?), where the syntactic structure emphasizes the futility of the verbal refuge.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}, {"arabic": "قال الله تعالى {أفرأيت من اتخذ إلهه هواه} وقال صلى الله عليه وسلم أبغض إله عبد في الأرض", "english": "They have manipulated this term through specification (takhṣīṣ), not through transfer (naql) or conversion (taḥwīl), for they have restricted it to knowledge of obscure legal branches (furūʿ gharībah) in legal opinions (fatāwā), to grasping the subtleties of their underlying causes (ʿilal), to multiplying discourse concerning them, and to memorizing the doctrinal positions related to them. Whoever is more profound in this and more occupied with it is called \"the most learned in fiqh\" (al-afqah). Yet in the first era, the name fiqh was applied absolutely to knowledge of the path of the Hereafter, to knowing the subtleties of the maladies of the souls (āfāt al-nufūs), to the corrupters of deeds (mufsidāt al-aʿmāl), to the power of encompassing the pettiness of this world, to intense longing for the bliss of the Hereafter, and to the dominance of fear over the heart. What indicates this to you is His saying, Mighty and Majestic: {«ليتفقهوا في الدين ولينذروا قومهم إذا رجعوا إليهم»} [“That they may gain understanding in the religion and warn their people when they return to them”] (Q 9:122). What effects warning and intimidation is this very fiqh — not the subdivisions of divorce (ṭalāq), manumission (ʿitāq), imprecation (liʿān), salam contracts, and leases (ijārah). For that (latter) does not produce warning or intimidation; rather, total devotion to it perpetually hardens the heart and strips away godly fear (khashyah) from it, as we now observe in those wholly devoted to it.", "book_title": "Book of Knowledge", "section_title_ar": "Section 27", "section_title_en": "The Revival of the Religious Sciences — Section 27: The Corruption of the Praiseworthy Names (Taḥrīf al-Asāmī al-Maḥmūdah)", "section_index": 27, "anchors": "- Root: فقه (Fiqh)\n  * Lisan / Ayn: Core linguistic meaning of \"understanding\" (al-fahm) and \"comprehension\" (al-fahm ʿan al-shayʾ)\n  * Al-Raghib (Mufradat): \"Al-fiqh: attainment of knowledge of the unseen through a witnessed sign — it is more specific than ʿilm.\" Theological nuance: true fiqh is knowledge of the heart's maladies and the path to the Hereafter.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"afqih ʿannī mā aqūl\" — understand what I say. Metaphorical (majāz): technical restriction to legal rulings (furūʿ al-fatāwā) is a later convention, not the lexical or prophetic norm.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Perception of a thing as it truly is; knowledge of the essence of a thing.\n  * Al-Raghib (Mufradat): Two types: (1) perception of the essence of a thing; (2) judgment upon a thing affirming or negating something of it. The highest ʿilm is knowledge of God, His verses, and His acts.\n  * Al-Zamakhshari (Asas): Literal: \"He is from the banners (aʿlām) of knowledge.\" Metaphorical: restriction of the title \"scholar\" (al-ʿālim) to the dialectician (al-munāẓir) is a corrupt specification (takhṣīṣ fāsid).\n- Root: وحد (Waḥḥada)\n  * Lisan / Ayn: To make one; to affirm unity.\n  * Al-Raghib (Mufradat): Tawḥīd is affirming God's unity in essence, attributes, and acts — the highest degree being the vision that all things proceed from Him alone.\n  * Al-Zamakhshari (Asas): Literal: utterance of \"Lā ilāha illā Allāh.\" Metaphorical: the inner reality (al-lubāb) — seeing all affairs from God, cutting off attention from secondary causes.\n- Sibawayh Rule: باب التخصيص والتقييد (Restriction and Specification) — The corruption of names occurs through takhṣīṣ (semantic restriction), not naql (lexical transfer). The grammarians' principle: a general term (al-ism al-ʿāmm) retains its full semantic range unless a valid sharʿī or linguistic evidence restricts it; arbitrary restriction by custom (ʿādat al-istimāl) is a rhetorical device of the devils among men and jinn.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "أخلاقها ومن عدل عن هذه الطريقة كان كمن قال الله تعالى فيه أفرأيت من اتخذ إلهه هواه وأضله الله على علم وقال تعالى واتبع هواه فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث وقال عز وجل فيمن نهى النفس عن الهوى وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى وسيأتي كيفية مجاهدة هذه الجنود وتسليط بعضها على بعض في كتاب رياضة النفس إن شاء الله تعالى المثال الثاني اعلم أن البدن كالمدينة والعقل أعني المدرك من الإنسان كملك مدبر لها وقواه المدركة من الحواس الظاهرة والباطنة كجنوده وأعوانه وأعضاؤه كرعيته والنفس الأمارة بالسوء التي هي الشهوة والغضب", "english": "But whoever turns away from this path is like the one of whom Allah, the Exalted, said: {أفرأيت من اتخذ إلهه هواه وأضله الله على علم} — \"Have you seen the one who takes as his god his own desire, and Allah has led him astray out of knowledge?\" (Q 45:23). And He, the Exalted, said: {واتبع هواه فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث} — \"And he followed his desire, so his example is like the example of a dog: if you drive him away, he pants, or if you leave him, he pants\" (Q 7:176). And He, the Exalted and Glorious, said concerning the one who restrains the soul from passion: {وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى} — \"But as for he who feared the standing before his Lord and restrained the soul from passion, then indeed, Paradise will be the refuge\" (Q 79:40-41).", "book_title": "Disciplining the Soul", "section_title_ar": "Section 577", "section_title_en": "** The Body as Kingdom: The Governance of the Soul's Faculties — Section 577", "section_index": 577, "anchors": "**\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, breath; that which is breathed forth; the essence of a thing\n  * Al-Raghib (Mufradat): النفس: الروح — the soul as the immaterial spiritual reality; when attributed to Allah, denotes His very essence (al-dhāt), not a separate entity\n  * Al-Zamakhshari (Asas): Literal: the self/essence; Metaphorical: نفس سائلة — a \"flowing self\" (blood) as the criterion for ritual purity\n- Root: عقل (ʿ-q-l)\n  * Lisan / Ayn: Intellect, reason; that which restrains and binds\n  * Al-Raghib (Mufradat): العقل يقال للقوة المتهيئة لقبول العلم — the faculty prepared for receiving knowledge; and the knowledge acquired through that faculty\n  * Al-Zamakhshari (Asas): Literal: intellectual apprehension; Metaphorical: نخلة لا تعقل الإبار — a palm that does not \"accept\" pollination (i.e., does not receive)\n- Root: غضب (gh-d-b)\n  * Lisan / Ayn: Anger, wrath; the boiling of the blood of the heart desiring vengeance\n  * Al-Raghib (Mufradat): ثوران دم القلب إرادة الانتقام — when attributed to Allah, it means retribution alone, not an emotional state\n  * Al-Zamakhshari (Asas): Literal: anger toward the living (غضبت لفلان); Metaphorical: anger toward the dead (غضبت به) — the preposition shift marking the distinction\n- Root: نصح (n-s-ḥ)\n  * Lisan / Ayn: Sincere counsel; to be pure and unadulterated; to sew (as a tailor)\n  * Al-Raghib (Mufradat): تحري فعل أو قول فيه صلاح صاحبه — the earnest pursuit of action or speech containing the welfare of its recipient\n  * Al-Zamakhshari (Asas): Literal: sincere advice; Metaphorical: نصح الغيث البلاد — rain \"counseling\" the land (i.e., giving it its due generously)\n- Sibawayh Rule: باب التشبيه التمثيلي (The Chapter of Illustrative Simile) — extended analogical comparisons (tamthīl) where multiple relations are mapped across domains, governed by the syntactic pattern of predicate assignment (isnād) to establish parallel structures\n\n---\n\n**", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Disciplining the Soul'", "badge": "Ethics"}], "26": [{"arabic": "الله تعالى لم ينظر إليها وتقول يوم القيامة يا رب اجعلني لأدنى أوليائك اليوم نصيبا فيقول اسكتي يا لا شيء إني لم أرضك لهم في الدنيا أرضاك لهم اليوم (1) وروي في أخبار آدم عليه السلام أنه لما أكل من الشجرة تحركت معدته لخروج الثقل ولم يكن ذلك مجعولا في شيء من أطعمة الجنة إلا في هذه الشجرة فلذلك نهيا عن أكلها قال فجعل يدور في الجنة فأمر الله تعالى ملكا يخاطبه فقال له قل له أي شيء تريد قال آدم أريد أن أضع ما في بطني من الأذى فقيل للملك قل له في أي مكان تريد أن تضعه أعلى الفرش أم على السرر أم على ا", "english": "It has been related that the Messenger of God — may God's peace and blessings be upon him — passed by a dead sheep and said: \"Do you see this sheep as contemptible to its owners?\" They said: \"It was due to its contemptibleness that they cast it away.\" He said: \"By Him in whose hand is my soul, this world is more contemptible to God than this sheep is to its owners. And had this world weighed in God's sight the wing of a gnat, He would not have given a disbeliever from it a single drink of water.\" {«الدنيا سجن المؤمن وجنة الكافر»} (1)", "book_title": "Condemnation of the World", "section_title_ar": "Section 730", "section_title_en": "The Verses and Reports Concerning the Blame of This World (Dhamm al-Dunyā)", "section_index": 730, "anchors": "- Root: د ن ا (D-N-A)\n  * Lisan / Ayn: The near, the lower, that which is immediate and proximate; the worldly abode as that which is \"closest\" in contrast to the Hereafter which is \"farthest.\"\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by judgment; the dunyā is so named for its temporal nearness, its inferior rank, and its being the \"lesser\" (adnā) in contrast to the greater and abiding.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the nearest and lowest abode. Metaphorical (Majaz): the life of this world as a \"dung-hill\" (mazbalah) and a carcass — its worthlessness rendered sensibly perceptible.\n- Root: ر س ل (R-S-L)\n  * Lisan / Ayn: Sending forth with gentleness and ease; a messenger (rasūl) as one dispatched.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root is emission upon measured deliberation; the prophetic mission (risālah) as the sending of guidance to turn creation away from the dunyā toward the ākhirah.\n  * Al-Zamakhshari (Asas): Literal: dispatch of a messenger with a message. Metaphorical: \"أرسل الله عليهم العذاب\" — the sending of punishment; here, the prophets were sent with the sole purpose of diverting hearts from the world.\n- Root: ح د ث (H-D-TH)\n  * Lisan / Ayn: Origination after non-existence; that which is new and temporal.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — the world as muḥdath (originated/temporal), hence inherently perishable and contemptible before the Eternal.\n  * Al-Zamakhshari (Asas): Literal: new occurrence. Metaphorical: \"صاروا أحاديث\" — becoming mere tales; the dunyā's ornaments become \"rotten rags\" and \"withered bones.\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The prophetic reports employ restrictive constructions (e.g., \"The world is but a prison of the believer\") to confine the dunyā's essence to a single defining attribute, negating all else.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of the World'", "badge": "Insight"}], "28": [{"arabic": "مدبرين يوم ترى كل أمة جاثية وسقط بعضهم على الوجوه منكبين وينادى العصاة والظالمون بالويل والثبور وينادى الصديقون نفسى نفسى فبينما هم كذلك إذ زفرت الناس زفرتها الثانية فتضاعف خوفهم وتخاذلت قواهم وظنوا أنهم مأخوذون ثم زفرت الثالثة فتساقط الخلائق على وجوههم وشخصوا بأبصارهم ينظرون من طرف خفى خاشع وانهضمت عند ذلك قلوب الظالمين فبلغت الحناجر كاظمين وذهلت العقول من السعداء والأشقياء أجمعين وبعد ذلك اقبل الله تعالى على الرسل وقال ماذا أجبتم فإذا رأوا ما قد أقيم من السياسة على الأ", "english": "{«ماذا أجبتم قالوا لا علم لنا إنك أنت علام الغيوب»} — \"What did you answer?\" They will say: \"We have no knowledge; indeed, You alone are the Knower of the unseen.\" {Quran 5:109} So woe betide the severity of a Day in which the intellects of the prophets are stupefied and their knowledges are effaced by the sheer intensity of the awe, when it is said to them: \"What did you answer, when you were sent to the creatures?\" — though they had known — yet their intellects are bewildered, and they know not with what to reply. So they say, from the intensity of the awe: \"We have no knowledge; indeed, You alone are the Knower of the unseen.\" And they are, at that very moment, truthful, for the intellects have flown away from them and the knowledges have been effaced — until God Almighty strengthens them. Then Noah (peace be upon him) is summoned, and it is said to him: \"Did you convey the message?\" He says: \"Yes.\" Then it is said to his community: \"Did he convey to you?\" They say: \"No warner came to us.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1341", "section_title_en": "The Day of Reckoning: The Questioning of the Prophets and the Exposure of the Servant Before the Lord of the Worlds", "section_index": 1341, "anchors": "- Root: رسل (R-S-L)\n  * Lisan / Ayn: Core meaning of \"sending forth with ease and gentleness\"; a messenger (rasūl) is one dispatched with a message.\n  * Al-Raghib (Mufradat): \"الرسول\" denotes one sent with a commission; the root conveys both the act of dispatch and the message borne. In the eschatological context, the prophets (rusul) are asked \"ماذا أجبتم\" — what answer did they give to those to whom they were sent.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): \"أرسل الله في الأمم رسلا\" — God sent messengers among the nations. Metaphorical (majāz): \"أرسل الله عليهم العذاب\" — God loosed chastisement upon them. Here, the sending of prophets is literal, but the terror of the Day is such that even their knowledge is effaced.\n- Root: علم (ʿ-L-M)\n  * Lisan / Ayn: Knowledge, perception, certainty; the opposite of ignorance.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality. On the Day of Terror, the prophets' knowledge (ʿulūmuhum) is erased (tunmaḥū) by the sheer overwhelming majesty (haybah) of the Divine address, leaving them to answer: \"لا علم لنا\" — \"We have no knowledge.\"\n  * Al-Zamakhshari (Asas): Literal: \"علمت الشيء أعلمه\" — I knew the thing. Here, the effacement of knowledge is a literal event of the Hour, not metaphorical, for the prophets are truthful when they disavow knowledge in that state.\n- Root: يوم (Y-W-M)\n  * Lisan / Ayn: A day; a period of time, whether short or long.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day is the time from sunrise to sunset, but it may denote any span of time. The \"Day\" of Resurrection is a duration whose terrors are magnified beyond earthly measure.\n  * Al-Zamakhshari (Asas): Literal: \"ما رأيته اليوم\" — I did not see him today. Metaphorical: \"ذكر في أيام العرب كذا أي في وقائعها\" — \"days\" of the Arabs means their battles. The \"Day\" of Judgment is a real day, but its horrors are such that the prophets themselves are stupefied.\n- Root: الم (ʾ-L-M)\n  * Lisan / Ayn: Severe pain, anguish.\n  * Al-Raghib (Mufradat): \"الألم الوجع الشديد\" — pain is intense suffering. The \"عذاب أليم\" is a painful chastisement. In this passage, the terror of the Day is an \"أليم\" affliction upon the hearts of all creatures.\n  * Al-Zamakhshari (Asas): Literal: \"مسه بضرب أليم\" — he touched him with a painful blow. The anguish of the Day is literal and inescapable.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The construction \"إنك أنت علام الغيوب\" employs the emphatic pronoun \"أنت\" as a focused predication, restricting the attribute of absolute knowledge of the unseen to God alone, even as the prophets disavow all knowledge before Him.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "29": [{"arabic": "وقرأ مضر القارئ يوما هذا كتابنا ينطق عليكم بالحقالآية فبكى عبد الواحد بن زيد حتى غشي عليه فلما أفاق قال وعزتك لأعصيتك جهدي أبدا فأعني بتوفيقك على طاعتك وكان المسور بن مخرمة لا يقوى أن يسمع شيئا من القرآن لشدة خوفه ولقد كان يقرأ عنده الحرف والآية فيصيح الصحية فما يعقل أياما حتى أتى عليه رجل من خثعم فقرأ عليه {يوم نحشر المتقين إلى الرحمن وفدا ونسوق المجرمين إلى جهنم وردا} فقال أنا من المجرمين ولست من المتقين أعد على القول أيها القارئ فأعادها عليه فشهق شهقة فلحق بالآخرة وقرئ عند يحيى البكاء {ولو", "english": "One of them said: \"Would that my mother had never given birth to me.\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1061", "section_title_en": "The States of the Fearful — Accounts of the Companions and Early Saints (Section 1061)", "section_index": 1061, "anchors": "- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Core meaning of dread and apprehension; the heart's agitation before an anticipated harm.\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — fear is the expectation of misfortune based on a probable or certain sign; it is the opposite of security (amn) and pertains to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — to fear for something. Metaphorical (Majaz): \"تخوفه: تنقصه وأخذ من أطرافه\" — fear that consumes one gradually, as in the verse of Zuhayr where the journey \"wears away\" the camel's hump little by little, as if in dread of it.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A measure of time from sunrise to sunset, or any period whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the Day is a term for any span of time; when added to God (أيام الله), it signifies His mighty acts and visitations upon the nations.\n  * Al-Zamakhshari (Asas): Literal: a single day. Metaphorical: \"ذكر في أيام العرب كذا أي في وقائعها\" — \"days\" denotes battles and momentous events; \"أيام الله\" are His punitive calamities upon the disbelievers.\n- Root: حتي (ḥ-t-y)\n  * Al-Raghib (Mufradat): A particle of end-point (ghāyah), signifying the terminal limit of an action or state, as in {ليسجننه حتى حين} and {حتى مطلع الفجر}.\n  * Sibawayh Rule: Prepositional and particle interposition (الفصل بين الجار والمجرور) — the particle ḥattā governs what follows as the culminating limit of the preceding narrative, marking the climax of an emotional or physical state (e.g., \"until he fell unconscious,\" \"until he died\").\n- Root: بكى (b-k-y)\n  * Lisan / Ayn: Weeping with tears; the physical manifestation of inner anguish.\n  * Al-Raghib (Mufradat): Weeping is the outward expression of the heart's grief (ḥuzn); in the fearful, it is the release of the soul's dread before God's majesty.\n  * Al-Zamakhshari (Asas): Literal: shedding tears. Metaphorical: \"بكاء الثكلي\" — the weeping of a bereaved mother, intensified by burning loss, used here to describe the saints' weeping on the Day of Arafah.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Fear and Hope'", "badge": "Afterlife"}], "36": [{"arabic": "اللهم باسمك أحيا وأموت (13) اللهم رب السموات ورب الأرض ورب كل شيء ومليكه فالق الحب والنوى ومنزل التوراة والإنجيل والقرآن أعوذ بك من شر كل ذي شر ومن شر كل دابة أنت آخذ بناصيتها أنت الأول فليس قبلك شيء وأنت الآخر فليس بعدك شيء وأنت الظاهر فليس فوقك شيء وأنت الباطن فليس دونك شيء اقض عني الدين وأغنني من الفقر (1) اللهم إنك خلقت نفسي وأنت تتوفاها لك مماتها ومحياها اللهم إن أمتها فاغفر لها وإن أحييتها فاحفظها اللهم إني أسألك العافية في الدنيا والآخرة (2) باسمك ربي وضعت جنبي فاغفر لي ذنبي (3) اللهم", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}]}, "wordTiming": {"minshawi": {"1": [[1, 20, 3640]], "45:1": [[1, 20, 3640]], "2": [[1, 730, 1922], [2, 1922, 2881], [3, 2881, 3254], [4, 3254, 3999], [5, 3999, 5303], [6, 5303, 6580]], "45:2": [[1, 730, 1922], [2, 1922, 2881], [3, 2881, 3254], [4, 3254, 3999], [5, 3999, 5303], [6, 5303, 6580]], "3": [[1, 500, 1049], [2, 1049, 1469], [3, 1469, 2915], [4, 2915, 4078], [5, 4078, 5432], [6, 5432, 7120]], "45:3": [[1, 500, 1049], [2, 1049, 1469], [3, 1469, 2915], [4, 2915, 4078], [5, 4078, 5432], [6, 5432, 7120]], "4": [[1, 320, 1244], [2, 1244, 2233], [3, 2233, 3360], [4, 3360, 4344], [5, 4344, 4714], [6, 4714, 6867], [7, 6867, 8231], [8, 8231, 9257], [9, 9257, 11180]], "45:4": [[1, 320, 1244], [2, 1244, 2233], [3, 2233, 3360], [4, 3360, 4344], [5, 4344, 4714], [6, 4714, 6867], [7, 6867, 8231], [8, 8231, 9257], [9, 9257, 11180]], "5": [[1, 660, 2183], [2, 2183, 3112], [3, 3112, 5198], [4, 5198, 7472], [5, 7472, 8303], [6, 8303, 9094], [7, 9094, 9490], [8, 9490, 12095], [9, 12095, 12491], [10, 12491, 13272], [11, 13272, 14933], [12, 14933, 15309], [13, 15309, 16258], [14, 16258, 16901], [15, 16901, 18325], [16, 18325, 20115], [17, 20115, 21515], [18, 21515, 22974], [19, 22974, 24072], [20, 24072, 25900]], "45:5": [[1, 660, 2183], [2, 2183, 3112], [3, 3112, 5198], [4, 5198, 7472], [5, 7472, 8303], [6, 8303, 9094], [7, 9094, 9490], [8, 9490, 12095], [9, 12095, 12491], [10, 12491, 13272], [11, 13272, 14933], [12, 14933, 15309], [13, 15309, 16258], [14, 16258, 16901], [15, 16901, 18325], [16, 18325, 20115], [17, 20115, 21515], [18, 21515, 22974], [19, 22974, 24072], [20, 24072, 25900]], "6": [[1, 580, 1119], [2, 1119, 2446], [3, 2446, 3165], [4, 3165, 4783], [5, 4783, 5655], [6, 5655, 6653], [7, 6653, 7732], [8, 7732, 8739], [9, 8739, 9323], [10, 9323, 10042], [11, 10042, 11962], [12, 11962, 13600]], "45:6": [[1, 580, 1119], [2, 1119, 2446], [3, 2446, 3165], [4, 3165, 4783], [5, 4783, 5655], [6, 5655, 6653], [7, 6653, 773