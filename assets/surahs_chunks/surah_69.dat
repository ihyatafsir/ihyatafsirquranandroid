{"surah":69,"verses":[{"ayah":1,"text":"ٱلْحَآقَّةُ ","translation":"The Inevitable Reality -","words":[{"id":1,"arabic":"ٱلْحَآقَّةُ","translit":"ُẗَّqٓāَḥْlٱ","root":"حقق"}],"hasIhya":false},{"ayah":2,"text":"مَا ٱلْحَآقَّةُ ","translation":"What is the Inevitable Reality?","words":[{"id":1,"arabic":"مَا","translit":"āَm","root":""},{"id":2,"arabic":"ٱلْحَآقَّةُ","translit":"ُẗَّqٓāَḥْlٱ","root":"حقق"}],"hasIhya":false},{"ayah":3,"text":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ ","translation":"And what can make you know what is the Inevitable Reality?","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَدْرَىٰكَ","translit":"َkٰàَrْdَaʾ","root":"دري"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"ٱلْحَآقَّةُ","translit":"ُẗَّqٓāَḥْlٱ","root":"حقق"}],"hasIhya":false},{"ayah":4,"text":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ ","translation":"Thamūd and ʿAad denied the Striking Calamity [i.e., the Resurrection].","words":[{"id":1,"arabic":"كَذَّبَتْ","translit":"ْtَbَّhdَk","root":"كذب"},{"id":2,"arabic":"ثَمُودُ","translit":"ُdwُmَht","root":""},{"id":3,"arabic":"وَعَادٌۢ","translit":"ٌۢdāَʿعَw","root":"عود"},{"id":4,"arabic":"بِٱلْقَارِعَةِ","translit":"ِẗَʿعِrāَqْlٱِb","root":"قرع"}],"hasIhya":false},{"ayah":5,"text":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ ","translation":"So as for Thamūd, they were destroyed by the overpowering [blast].","words":[{"id":1,"arabic":"فَأَمَّا","translit":"āَّmَaʾَf","root":""},{"id":2,"arabic":"ثَمُودُ","translit":"ُdwُmَht","root":""},{"id":3,"arabic":"فَأُهْلِكُوا۟","translit":"۟āwُkِlْhُaʾَf","root":"هلك"},{"id":4,"arabic":"بِٱلطَّاغِيَةِ","translit":"ِẗَyِغāَّṭlٱِb","root":"طغي"}],"hasIhya":false},{"ayah":6,"text":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ ","translation":"And as for ʿAad, they were destroyed by a screaming,[1] violent wind","words":[{"id":1,"arabic":"وَأَمَّا","translit":"āَّmَaʾَw","root":""},{"id":2,"arabic":"عَادٌ","translit":"ٌ