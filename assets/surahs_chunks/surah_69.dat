ٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَسْلَفْتُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَايَّامِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْخَالِيَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 25, "text": "وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِے لَمُ ا۟وتَ كِتَٰبِيَهْۖ", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ا۟وتِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كِتَٰبَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِشِمَالِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَيَقُولُ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَٰلَيْتَنِے", "translit": "", "root": ""}, {"id": 8, "arabic": "لَمُ", "translit": "", "root": ""}, {"id": 9, "arabic": "ا۟وتَ", "translit": "", "root": ""}, {"id": 10, "arabic": "كِتَٰبِيَهْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 26, "text": "وَلَمَ اَدْرِ مَا حِسَابِيَهْۖ", "words": [{"id": 1, "arabic": "وَلَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَدْرِ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "حِسَابِيَهْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 27, "text": "يَٰلَيْتَهَا كَانَتِ اِ۬لْقَاضِيَةَ", "words": [{"id": 1, "arabic": "يَٰلَيْتَهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْقَاضِيَةَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 28, "text": "مَآ أَغْن۪يٰ عَنِّے مَالِيَهۖ", "words": [{"id": 1, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَغْن۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنِّے", "translit": "", "root": ""}, {"id": 4, "