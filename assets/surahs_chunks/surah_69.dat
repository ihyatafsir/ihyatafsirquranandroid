bic": "وَعَادُۢ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْقَارِعَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 5, "text": "فَأَمَّا ثَمُودُ فَأُهْلِكُواْ بِالطَّاغِيَةِۖ", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "ثَمُودُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَأُهْلِكُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالطَّاغِيَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 6, "text": "وَأَمَّا عَادࣱ فَأُهْلِكُواْ بِرِيحࣲ صَرْصَرٍ عَاتِيَةࣲ‏", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَادࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَأُهْلِكُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِرِيحࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "صَرْصَرٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَاتِيَةࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 7, "text": "سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالࣲ وَثَمَٰنِيَةَ أَيَّامٍ حُسُوماࣰۖ فَتَرَي اَ۬لْقَوْمَ فِيهَا صَرْع۪يٰ كَأَنَّهُمُۥٓ أَعْجَازُ نَخْلٍ خَاوِيَةࣲۖ", "words": [{"id": 1, "arabic": "سَخَّرَهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَبْعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَيَالࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَثَمَٰنِيَةَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَيَّامٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "حُسُوماࣰۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَتَرَي", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْقَوْمَ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "صَرْع۪يٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "كَأَنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَعْجَازُ", "translit": "", "root": ""}, {"id": 14, "arabic": "نَخْلٍ", "translit": "", "root": ""}, {"id": 15, "arabic": "خَاوِيَةࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 8, "text": "فَهَلْ تَر۪يٰ لَهُم مِّنۢ بَاقِيَةࣲۖ", "words": [{"id": 1, "arabic": "فَهَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَر۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَاقِيَةࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 9, "text": "وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَالْمُوتَفِكَٰتُ بِالْخَاطِئَةِ", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالْمُوتَفِكَٰتُ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالْخَاطِئَةِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 10, "text": "فَعَصَوْاْ رَسُولَ رَبِّهِمْ فَأَخَذَهُمُۥٓ أَخْذَةࣰ رَّابِيَةًۖ", "words": [{"id": 1, "arabic": "فَعَصَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَسُولَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأَخَذَهُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَخْذَةࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَّابِيَةًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 11, "text": "اِنَّا لَمَّا طَغَا اَ۬لْمَآءُ حَمَلْنَٰكُمْ فِے اِ۬لْجَارِيَةِ", "words": [{"id": 1, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَمَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "طَغَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَآءُ", "translit": "", "root": ""}, {"id": 5, "arabic": "حَمَلْنَٰكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْجَارِيَةِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 12, "text": "لِنَجْعَلَهَا لَكُمْ تَذْكِرَةࣰ وَتَعِيَهَآ أُذْنࣱ وَٰعِيَةࣱۖ", "words": [{"id": 1, "arabic": "لِنَجْعَلَهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَذْكِرَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَتَعِيَهَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أُذْنࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَٰعِيَةࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 13, "text": "فَإِذَا نُفِخَ فِے اِ۬لصُّورِ نَفْخَةࣱ وَٰحِدَةࣱ‏", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نُفِخَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لصُّورِ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَفْخَةࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَٰحِدَةࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 14, "text": "وَحُمِلَتِ اِ۬لَارْضُ وَالْجِبَالُ فَدُكَّتَا دَكَّةࣰ وَٰحِدَةࣰ‏", "words": [{"id": 1, "arabic": "وَحُمِلَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لَارْضُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالْجِبَالُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَدُكَّتَا", "translit": "", "root": ""}, {"id": 5, "arabic": "دَكَّةࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَٰحِدَةࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 15, "text": "فَيَوْمَئِذࣲ وَقَعَتِ اِ۬لْوَاقِعَةُ", "words": [{"id": 1, "arabic": "فَيَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَقَعَتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْوَاقِعَةُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 16, "text": "وَانشَقَّتِ اِ۬لسَّمَآءُ فَهِيَ يَوْمَئِذࣲ وَاهِيَةࣱ‏", "words": [{"id": 1, "arabic": "وَانشَقَّتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لسَّمَآءُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَهِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاهِيَةࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 17, "text": "وَالْمَلَكُ عَلَيٰٓ أَرْجَآئِهَاۖ وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذࣲ ثَمَٰنِيَةࣱ‏", "words": [{"id": 1, "arabic": "وَالْمَلَكُ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَرْجَآئِهَاۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَيَحْمِلُ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَرْشَ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَوْقَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "ثَمَٰنِيَةࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 18, "text": "يَوْمَئِذࣲ تُعْرَضُونَ لَا تَخْف۪يٰ مِنكُمْ خَافِيَةࣱۖ", "words": [{"id": 1, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 2, "arabic": "تُعْرَضُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَخْف۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "خَافِيَةࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 69, "ayah": 19, "text": "۞فَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ اُ۪قْرَءُواْ كِتَٰبِيَهْۖ", "words": [{"id": 1, "arabic": "۞فَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ا۟وتِيَ", "translit": "", "root": ""}, {"id": 4, "