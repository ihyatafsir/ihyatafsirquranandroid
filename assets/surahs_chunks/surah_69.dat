translit":"ُhwُّlَṣ","root":"صلي"}],"hasIhya":false},{"ayah":32,"text":"ثُمَّ فِى سِلْسِلَةٍ ذَرْعُهَا سَبْعُونَ ذِرَاعًا فَٱسْلُكُوهُ ","translation":"Then into a chain whose length is seventy cubits insert him.\"","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"فِى","translit":"àِf","root":""},{"id":3,"arabic":"سِلْسِلَةٍ","translit":"ٍẗَlِsْlِs","root":"سلسل"},{"id":4,"arabic":"ذَرْعُهَا","translit":"āَhُʿعْrَhd","root":"ذرع"},{"id":5,"arabic":"سَبْعُونَ","translit":"َnwُʿعْbَs","root":"سبع"},{"id":6,"arabic":"ذِرَاعًا","translit":"āًʿعāَrِhd","root":"ذرع"},{"id":7,"arabic":"فَٱسْلُكُوهُ","translit":"ُhwُkُlْsٱَf","root":"سلك"}],"hasIhya":false},{"ayah":33,"text":"إِنَّهُۥ كَانَ لَا يُؤْمِنُ بِٱللَّهِ ٱلْعَظِيمِ ","translation":"Indeed, he did not used to believe in Allāh, the Most Great,","words":[{"id":1,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يُؤْمِنُ","translit":"ُnِmْwʾُy","root":"امن"},{"id":5,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":6,"arabic":"ٱلْعَظِيمِ","translit":"ِmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":false},{"ayah":34,"text":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ ","translation":"Nor did he encourage the feeding of the poor.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"يَحُضُّ","translit":"ُّḍُḥَy","root":"حضض"},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"طَعَامِ","translit":"ِmāَʿعَṭ","root":"طعم"},{"id":5,"arabic":"ٱلْمِسْكِينِ","translit":"ِnyِkْsِmْlٱ","root":"سكن"}],"hasIhya":false},{"ayah":35,"text":"فَلَيْسَ لَهُ ٱلْيَوْمَ هَٰهُنَا حَمِيمٌ ","translation":"So there is not for him here this Day any devoted friend","words":[{"id":1,"arabic":"فَلَيْسَ","translit":"َsْyَlَf","root":"ليس"},{"id":2,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":3,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":4,"arabic":"هَٰهُنَا","translit":"āَnُhَٰh","root":""},{"id":5,"arabic":"حَمِيمٌ","translit":"ٌmyِmَḥ","root":"حمم"}],"hasIhya":false},{"ayah":36,"text":"وَلَا طَعَامٌ إِلَّا مِنْ غِسْلِينٍ ","translation":"Nor any food except from the discharge of wounds;","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"طَعَامٌ","translit":"ٌmāَʿعَṭ","root":"طعم"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":5,"arabic":"غِسْلِينٍ","translit":"ٍnyِlْsِغ","root":"غسل"}],"hasIhya":false},{"ayah":37,"text":"لَّا يَأْكُلُهُۥٓ إِلَّا ٱلْخَٰطِـُٔونَ ","translation":"None will eat it except the sinners.","words":[{"id":1,"arabic":"لَّا","translit":"āَّl","root":""},{"id":2,"arabic":"يَأْكُلُهُۥٓ","translit":"ٓۥُhُlُkْaʾَy","root":"اكل"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"ٱلْخَٰطِـُٔونَ","translit":"َnwُٔـِṭَٰhkْlٱ","root":"خطا"}],"hasIhya":false},{"ayah":38,"text":"فَلَآ أُقْسِمُ بِمَا تُبْصِرُونَ ","translation":"So I swear by what you see","words":[{"id":1,"arabic":"فَلَآ","translit":"ٓāَlَf","root":""},{"id":2,"arabic":"أُقْسِمُ","translit":"ُmِsْqُaʾ","root":"قسم"},{"id":3,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":4,"arabic":"تُبْصِرُونَ","translit":"َnwُrِṣْbُt","root":"بصر"}],"hasIhya":false},{"ayah":39,"text":"وَمَا لَا تُبْصِرُونَ ","translation":"And what you do not see","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"تُبْصِرُونَ","translit":"َnwُrِṣْbُt","root":"بصر"}],"hasIhya":false},{"ayah":40,"text":"إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ ","translation":"[That] indeed, it [i.e., the Qur’ān] is the word of a noble Messenger.","words":[{"id":1,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":2,"arabic":"لَقَوْلُ","translit":"ُlْwَqَl","root":"قول"},{"id":3,"arabic":"رَسُولٍ","translit":"ٍlwُsَr","root":"رسل"},{"id":4,"arabic":"كَرِيمٍ","translit":"ٍmyِrَk","root":"كرم"}],"hasIhya":false},{"ayah":41,"text":"وَمَا هُوَ بِقَوْلِ شَاعِرٍۚ قَلِيلًا مَّا تُؤْمِنُونَ ","translation":"And it is not the word of a poet; little do you believe.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":3,"arabic":"بِقَوْلِ","translit":"ِlْwَqِb","root":"قول"},{"id":4,"arabic":"شَاعِرٍ","translit":"ٍrِʿعāَhs","root":"شعر"},{"id":5,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":6,"arabic":"مَّا","translit":"āَّm","root":""},{"id":7,"arabic":"تُؤْمِنُونَ","translit":"َnwُnِmْwʾُt","root":"امن"}],"hasIhya":false},{"ayah":42,"text":"وَلَا بِقَوْلِ كَاهِنٍۚ قَلِيلًا مَّا تَذَكَّرُونَ ","translation":"Nor the word of a soothsayer; little do you remember.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"بِقَوْلِ","translit":"ِlْwَqِb","root":"قول"},{"id":3,"arabic":"كَاهِنٍ","translit":"ٍnِhāَk","root":"كهن"},{"id":4,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":5,"arabic":"مَّا","translit":"āَّm","root":""},{"id":6,"arabic":"تَذَكَّرُونَ","translit":"َnwُrَّkَhdَt","root":"ذكر"}],"hasIhya":false},{"ayah":43,"text":"تَنزِيلٌ مِّن رَّبِّ ٱلْعَٰلَمِينَ ","translation":"[It is] a revelation from the Lord of the worlds.","words":[{"id":1,"arabic":"تَنزِيلٌ","translit":"ٌlyِznَt","root":"نزل"},{"id":2,"arabic":"مِّن","translit":"nِّm","root":""},{"id":3,"arabic":"رَّبِّ","translit":"ِّbَّr","root":"ربب"},{"id":4,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":44,"text":"وَلَوْ تَقَوَّلَ عَلَيْنَا بَعْضَ ٱلْأَقَاوِيلِ ","translation":"And if he [i.e., Muḥammad] had made up about Us some [false] sayings,","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"تَقَوَّلَ","translit":"َlَّwَqَt","root":"قول"},{"id":3,"arabic":"عَلَيْنَا","translit":"āَnْyَlَʿع","root":""},{"id":4,"arabic":"بَعْضَ","translit":"َḍْʿعَb","root":"بعض"},{"id":5,"arabic":"ٱلْأَقَاوِيلِ","translit":"ِlyِwāَqَaʾْlٱ","root":"قول"}],"hasIhya":false},{"ayah":45,"text":"لَأَخَذْنَا مِنْهُ بِٱلْيَمِينِ ","translation":"We would have seized him by the right hand;[1]","words":[{"id":1,"arabic":"لَأَخَذْنَا","translit":"āَnْhdَhkَaʾَl","root":"اخذ"},{"id":2,"arabic":"مِنْهُ","translit":"ُhْnِm","root":""},{"id":3,"arabic":"بِٱلْيَمِينِ","translit":"ِnyِmَyْlٱِb","root":"يمن"}],"hasIhya":false},{"ayah":46,"text":"ثُمَّ لَقَطَعْنَا مِنْهُ ٱلْوَتِينَ ","translation":"Then We would have cut from him the aorta.[1]","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"لَقَطَعْنَا","translit":"āَnْʿعَṭَqَl","root":"قطع"},{"id":3,"arabic":"مِنْهُ","translit":"ُhْnِm","root":""},{"id":4,"arabic":"ٱلْوَتِينَ","translit":"َnyِtَwْlٱ","root":"وتن"}],"hasIhya":false},{"ayah":47,"text":"فَمَا مِنكُم مِّنْ أَحَدٍ عَنْهُ حَٰجِزِينَ ","translation":"And there is no one of you who could prevent [Us] from him.","words":[{"id":1,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":2,"arabic":"مِنكُم","translit":"mُknِm","root":""},{"id":3,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":4,"arabic":"أَحَدٍ","translit":"ٍdَḥَaʾ","root":"احد"},{"id":5,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":6,"arabic":"حَٰجِزِينَ","translit":"َnyِzِjgَٰḥ","root":"حجز"}],"hasIhya":false},{"ayah":48,"text":"وَإِنَّهُۥ لَتَذْكِرَةٌ لِّلْمُتَّقِينَ ","translation":"And indeed, it [i.e., the Qur’ān] is a reminder for the righteous.","words":[{"id":1,"arabic":"وَإِنَّهُۥ","translit":"ۥُhَّnِiʾَw","root":""},{"id":2,"arabic":"لَتَذْكِرَةٌ","translit":"ٌẗَrِkْhdَtَl","root":"ذكر"},{"id":3,"arabic":"لِّلْمُتَّقِينَ","translit":"َnyِqَّtُmْlِّl","root":"وقي"}],"hasIhya":false},{"ayah":49,"text":"وَإِنَّا لَنَعْلَمُ أَنَّ مِنكُم مُّكَذِّبِينَ ","translation":"And indeed, We know that among you are deniers.","words":[{"id":1,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":2,"arabic":"لَنَعْلَمُ","translit":"ُmَlْʿعَnَl","root":"علم"},{"id":3,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":4,"arabic":"مِنكُم","translit":"mُknِm","root":""},{"id":5,"arabic":"مُّكَذِّبِينَ","translit":"َnyِbِّhdَkُّm","root":"كذب"}],"hasIhya":false},{"ayah":50,"text":"وَإِنَّهُۥ لَحَسْرَةٌ عَلَى ٱلْكَٰفِرِينَ ","translation":"And indeed, it will be [a cause of] regret upon the disbelievers.","words":[{"id":1,"arabic":"وَإِنَّهُۥ","translit":"ۥُhَّnِiʾَw","root":""},{"id":2,"arabic":"لَحَسْرَةٌ","translit":"ٌẗَrْsَḥَl","root":"حسر"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"}],"hasIhya":false},{"ayah":51,"text":"وَإِنَّهُۥ لَحَقُّ ٱلْيَقِينِ ","translation":"And indeed, it is the truth of certainty.","words":[{"id":1,"arabic":"وَإِنَّهُۥ","translit":"ۥُhَّnِiʾَw","root":""},{"id":2,"arabic":"لَحَقُّ","translit":"ُّqَḥَl","root":"حقق"},{"id":3,"arabic":"ٱلْيَقِينِ","translit":"ِnyِqَyْlٱ","root":"يقن"}],"hasIhya":false},{"ayah":52,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ ","translation":"So exalt the name of your Lord, the Most Great.","words":[{"id":1,"arabic":"فَسَبِّحْ","translit":"ْḥِّbَsَf","root":"سبح"},{"id":2,"arabic":"بِٱسْمِ","translit":"ِmْsٱِb","root":"سمو"},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"ٱلْعَظِيمِ","translit":"ِmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":false}],"tafsir":{"14":[{"arabic":"يصدر الناس أشتاتا ليروا أعمالهم يوم تحمل الأرض والجبال فدكتا دكة واحدة فيومئذ وقعت الواقعة وانشقت السماء فهى يومئذ واهية والملك على أرجائها ويحمل عرش ربك فوقهم يومئذ ثمانية يومئذ تعرضون لا تخفى منكم خافية يوم تسير الجبال وترى الأرض بارزة يوم ترج الأرض فيه رجا وتبس الجبال بسا فكانت هباء منبثا يوم يكون الناس كالفراش المبثوث وتكون الجبال كالعهن المنفوش يوم تذهل فيه كل مرضعة عما أرضعت وتضع كل ذات حمل حملها وترى الناس سكارى وما هم بسكارى ولكن عذاب الله شديد يوم تبدل الأرض غير الأرض والسموات وبرزوا لله الواحد القهار يوم تنسف فيه الجبال نسفا فتترك قاعا صفصفا لا ترى فيها عوجا ولا أمتا يوم ترى الجبال تحسبها جامدة وهي تمر مر السحاب يوم تنشق فيه السماء فتكون وردة كالده","english":"So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1339","section_title_en":"The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent","section_index":1339,"anchors":"- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'","badge":"Afterlife"}],"24":[{"arabic":"تعالى {كلوا واشربوا هنيئا بما أسلفتم في الأيام الخالية} هي أيام الصيام إذ تركوا فيها الأكل والشرب وقد جمع رسول الله صلى الله عليه وسلم في رتبة المباهاة بين الزهد في الدنيا وبين الصوم فقال إن الله تعالى يباهي ملائكته بالشاب العابد فيقول أيها الشاب التارك شهوته لأجلي المبذل شبابه لي أنت عندي كبعض ملائكتي (9) وقال صلى الله عليه وسلم في الصائم يقول الله عز وجل انظروا يا ملائكتي إلى عبدي ترك شهوته ولذته وطعامه وشرابه من أجلي (10) وقيل في قوله تعالى {فلا تعلم نفس ما أخفي لهم من قرة أعين جزاء بما كانوا يعملون","english":"To proceed: Fasting is one quarter of faith, by virtue of his saying, peace and blessings be upon him: \"Fasting is half of patience\" — and by virtue of his saying, peace and blessings be upon him: \"Patience is half of faith\" {«الإيمان»}. Then it is distinguished by a particular characteristic of its attribution to Allah the Exalted, above all the other pillars — for Allah the Exalted said, in what His Prophet narrated from Him, peace and blessings be upon him: \"Every good deed is multiplied tenfold up to seven hundred times, except fasting, for it is Mine, and I shall reward it.\" And Allah the Exalted has said: {«Only the patient shall be paid their reward in full without reckoning»} (Q 39:10). And fasting is half of patience — so its reward has surpassed the law of measure and reckoning. And sufficient for you in knowing its excellence is his saying, peace and blessings be upon him: \"By Him in whose hand is my soul, the change in the breath of the mouth of the fasting person is more fragrant to Allah than the scent of musk. Allah the Exalted says: 'He only abandons his appetite, his food, and his drink for My sake — so fasting is for Me, and I shall reward it.'\" And he said, peace and blessings be upon him: \"Paradise has a gate called al-Rayyān, through which none shall enter except the fasting ones.\" And the fasting person is promised the meeting with Allah the Exalted as a portion of his fasting. And he said, peace and blessings be upon him: \"For the fasting person there are two joys: a joy when he breaks his fast, and a joy when he meets his Lord.\" And he said, peace and blessings be upon him: \"Everything has a gate, and the gate of worship is fasting.\" And he said, peace and blessings be upon him: \"The sleep of the fasting person is worship.\" And Abū Hurayrah, may Allah be pleased with him, narrated that he, peace and blessings be upon him, said: \"When the month of Ramaḍān enters, the gates of Paradise are opened, the gates of the Fire are closed, the devils are chained, and a caller calls out: 'O seeker of good, come forth! O seeker of evil, desist!'\" And Wakīʿ said concerning His saying, the Exalted: {«Eat and drink in satisfaction for what you sent forth in the days past»} (Q 69:24) — these are the days of fasting, for in them they abandoned eating and drinking. And the Messenger of Allah, peace and blessings be upon him, gathered in the rank of divine boasting (mubāhāh) between renunciation of the world and fasting, saying: \"Allah the Exalted boasts to His angels of the young worshiper, saying: 'O young man who abandons his appetite for My sake, who devotes his youth to Me — you are to Me as some of My angels.'\" And he said, peace and blessings be upon him, concerning the fasting person: \"Allah the Exalted says: 'Look, O My angels, at My servant — he has abandoned his appetite, his pleasure, his food, and his drink for My sake.'\" And it was said concerning His saying, the Exalted: {«No soul knows what comfort has been concealed for them, as a reward for what they used to do»} (Q 32:17) — it was said: their deed was fasting, because He said: {«Only the patient shall be paid their reward in full without reckoning»} — so the reward of the fasting person is poured out upon him without measure, and is dealt out to him in bulk, not falling under any imagination or estimation.","book_title":"Harms of the Tongue","section_title_ar":"Section 185","section_title_en":"The Book of the Secrets of Fasting — Section 185: On the Excellence of Fasting and Its Distinction Among the Acts of Worship","section_index":185,"anchors":"- Root: صوم (ṣ-w-m)\n  * Lisan / Ayn: Core linguistic root meaning — abstention from any act, whether eating, speaking, or walking; a horse that refrains from movement or fodder is called ṣā'im.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"الصوم في الأصل: الإمساك عن الفعل\" — fasting is fundamentally the restraint of the self from action; it is an inward act of the heart, invisible to creation.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — Haqiqah: the month of fasting, \"فمن شهد منكم الشهر فليصمه\" (Q 2:185); Majaz: \"صام الفرس على آريه\" — a horse standing still at its tether, refusing fodder, metaphorically \"fasting.\"\n- Root: عله (ʿ-l-h)\n  * Lisan / Ayn: Core linguistic root meaning — to feed or pasture; related to cultivation and nourishment.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — not directly attested in Mufradat for this root; the root pertains to the means by which the body is sustained, which is precisely what the fasting person abstains from.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — literal feeding and satiation; the fasting person's abstention from these becomes the very means of spiritual nourishment.\n- Root: الي (a-l-y)\n  * Lisan / Ayn: Core linguistic root meaning — to convey a message; the angel (malak) is so named because the message is \"chewed\" (yu'lak) in the mouth, as a horse chews its bit.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"المألكة: الرسالة\" — the angelic function is the conveyance of divine communication; the fasting person's hunger narrows the channels through which the devil (who runs like blood through the veins) reaches the heart.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — literal conveyance of a message versus the metaphorical \"message\" of the devil's insinuation (waswās) through the pathways of the body.\n- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core linguistic root meaning — to restrain, to hold back in constriction; \"صبرت الدابة: حبستها بلا علف\" — to hold an animal back without fodder.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"الصبر: الإمساك في ضيق\" — patience is restraint within constriction; it is the holding of the soul upon what reason and law require, or from what they require it to abstain. Its names vary by context: in battle it is courage, in calamity it is patience proper.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — Haqiqah: \"صبرت على ما أكره وصبرت عما أحب\" — patience upon the disliked and patience from the beloved; Majaz: \"صبرت يمينه\" — to bind one's oath severely, and \"هو أصبر على الضرب من الأرض\" — more enduring of striking than the earth.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts and confines the predicate exclusively to its subject, as in the divine saying {«إنما يوفى الصابرون أجرهم بغير حساب»} and {«إنما يذر شهوته وطعامه وشرابه لأجلي»}, where the restriction elevates the restricted matter to a rank beyond all quantitative measure.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Harms of the Tongue'","badge":"Insight"}],"28":[{"arabic":"ويقول {ما أغنى عني ماليه هلك عني سلطانيه} وفرش المأمون رمادا واضطجع عليه وكان يقول يا من لا يزول ملكه ارحم من قد زال ملكه وكان المعتصم يقول عند موته لو علمت ان عمري هكذا قصير ما فعلت وكان المنتصر يضطرب على نفسه عند موته فقيل له لا بأس عليك يا أمير المؤمنين فقال ليس إلا هذا لقد ذهبت الدنيا واقبلت الآخرة وقال عمرو بن العاص عند الوفاة وقد نظر إلى صناديق لبنيه من يأخذها بما فيها ليته كان بعرا وقال الحجاج عند موته اللهم أغفر لي فإن الناس يقولون إنك لا تغفر لي فكان عمر بن عبد العزيز تعجبه هذه ا","english":"...my hand had not been raised to my ear before I seized it. He said: \"O God, choose for ʿUmar [the best] in meeting You.\" And he did not remain but a few days until he died. And it was said: when death came upon him, he wept. So it was said to him: \"What makes you weep, O Commander of the Faithful? Rejoice, for God has revived through you the prophetic practices (sunan) and manifested through you justice.\" He wept, then said: \"Will I not be made to stand and be questioned concerning the affair of these creatures? By God, were I to have been perfectly just among them, I would still fear for myself that I could not establish its full proof before God — unless God Himself were to prompt me with that proof. So how [shall I fare] with much of what we have neglected?\" And his eyes overflowed, and he did not remain but a little while until he died. And when the time of his death drew near, he said: \"Seat me.\" So they seated him, and he said: \"I am the one whom You commanded, and I fell short; and You forbade me, and I disobeyed\" — three times — \"but there is no god but God.\" Then he raised his head and strained his gaze, and it was said to him concerning that, and he said: \"I see a verdure — they are neither humans nor jinn.\" Then he was taken [in death], may God have mercy on him.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1307","section_title_en":"Section 1307 — The Deathbed Reflections of the Caliphs and the Verdict of the Righteous","section_index":1307,"anchors":"- Root: عمر (ʿ-m-r)\n  * Lisan / Ayn: Prolonged sojourn, cultivation of life, the span of earthly existence.\n  * Al-Raghib (Mufradat): ʿUmr as the divinely allotted tenure of the soul in the body — its term (ajal) being the boundary set by God's decree.\n  * Al-Zamakhshari (Asas): Literal: the duration of life. Metaphorical: the flourishing of religion through a just ruler, as in \"أحيا الله بك سننا\" — where revival (iḥyāʾ) is the restoration of prophetic practice after its desuetude.\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Possession, dominion, sovereign authority.\n  * Al-Raghib (Mufradat): Mul'k as the earthly sovereignty that is inherently transient, contrasted with the eternal dominion (malakūt) of God — the latter alone being imperishable.\n  * Al-Zamakhshari (Asas): Literal: royal power. Metaphorical: the soul's governance over the body, which dissolves at death — hence al-Maʾmūn's plea: \"Have mercy on him whose sovereignty has departed.\"\n- Root: غني (gh-n-y)\n  * Lisan / Ayn: Self-sufficiency, freedom from need, wealth.\n  * Al-Raghib (Mufradat): Ghinā as the illusory self-sufficiency of the worldly man, unmasked at death when wealth yields no benefit — as in the Quranic verse cited by Hārūn al-Rashīd.\n  * Al-Zamakhshari (Asas): Literal: riches. Metaphorical: the utter destitution (faqr) of the soul before God when all worldly means are stripped away.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rhetorical pause between the prepositional phrase and its governing verb, as in \"يا من لا يزول ملكه ارحم من قد زال ملكه,\" where the interposed vocative clause heightens the contrast between divine permanence and human evanescence.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'","badge":"Afterlife"}]},"wordTiming":{"abdulbasit":{"1":[[1,350,4887]],"2":[[1,350,1356],[2,1356,5017]],"3":[[1,350,2191],[2,2191,4085],[3,4085,4804],[4,4804,7420]],"4":[[1,350,1611],[2,1611,2789],[3,2789,4146],[4,4146,6219]],"5":[[1,350,1808],[2,1808,2881],[3,2881,4794],[4,4794,7029]],"6":[[1,400,2358],[2,2358,3460],[3,3460,5839],[4,5839,7173],[5,7173,8507],[6,8507,10277]],"7":[[1,400,2081],[2,2081,3524],[3,3524,4439],[4,4439,5753],[5,5753,7685],[6,7685,9340],[7,9340,10963],[8,10963,12122],[9,12122,13410],[10,13410,14698],[11,14698,16218],[12,16218,17906],[13,17906,19452],[14,19452,20251],[15,20251,21927]],"8":[[1,350,1204],[2,1204,2500],[3,2500,3354],[4,3354,4370],[5,4370,6167]],"9":[[1,400,2339],[2,2339,3820],[3,3820,4730],[4,4730,5860],[5,5860,8381],[6,8381,10564]],"10":[[1,400,1994],[2,1994,3105],[3,3105,4228],[4,4228,5750],[5,5750,6764],[6,6764,8370]],"11":[[1,400,1715],[2,1715,2980],[3,2980,3982],[4,3982,5801],[5,5801,7480],[6,7480,8106],[7,8106,9911]],"12":[[1,400,2759],[2,2759,3649],[3,3649,5103],[4,5103,8148],[5,8148,9127],[6,9127,10878]],"13":[[1,350,1669],[2,1669,2504],[3,2504,3177],[4,3177,4813],[5,4813,5863],[6,5863,7290]],"14":[[1,40