{"surah": 66, "verses": [{"ayah": 1, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ لِمَ تُحَرِّمُ مَآ أَحَلَّ ٱللَّهُ لَكَۖ تَبْتَغِى مَرْضَاتَ أَزْوَٰجِكَۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "O Prophet, why do you prohibit [yourself from] what Allāh has made lawful for you, seeking the approval of your wives? And Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "لِمَ", "translit": "َmِl", "root": ""}, {"id": 4, "arabic": "تُحَرِّمُ", "translit": "ُmِّrَḥُt", "root": "حرم"}, {"id": 5, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 6, "arabic": "أَحَلَّ", "translit": "َّlَḥَaʾ", "root": "حلل"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 9, "arabic": "تَبْتَغِى", "translit": "àِغَtْbَt", "root": "بغي"}, {"id": 10, "arabic": "مَرْضَاتَ", "translit": "َtāَḍْrَm", "root": "رضو"}, {"id": 11, "arabic": "أَزْوَٰجِكَ", "translit": "َkِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 14, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 2, "text": "قَدْ فَرَضَ ٱللَّهُ لَكُمْ تَحِلَّةَ أَيْمَٰنِكُمْۚ وَٱللَّهُ مَوْلَىٰكُمْۖ وَهُوَ ٱلْعَلِيمُ ٱلْحَكِيمُ ", "translation": "Allāh has already ordained for you [Muslims] the dissolution of your oaths.[1] And Allāh is your protector, and He is the Knowing, the Wise.", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "فَرَضَ", "translit": "َḍَrَf", "root": "فرض"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 5, "arabic": "تَحِلَّةَ", "translit": "َẗَّlِḥَt", "root": "حلل"}, {"id": 6, "arabic": "أَيْمَٰنِكُمْ", "translit": "ْmُkِnَٰmْyَaʾ", "root": "يمن"}, {"id": 7, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 8, "arabic": "مَوْلَىٰكُمْ", "translit": "ْmُkٰàَlْwَm", "root": "ولي"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}, {"id": 11, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 3, "text": "وَإِذْ أَسَرَّ ٱلنَّبِىُّ إِلَىٰ بَعْضِ أَزْوَٰجِهِۦ حَدِيثًا فَلَمَّا نَبَّأَتْ بِهِۦ وَأَظْهَرَهُ ٱللَّهُ عَلَيْهِ عَرَّفَ بَعْضَهُۥ وَأَعْرَضَ عَنۢ بَعْضٍۖ فَلَمَّا نَبَّأَهَا بِهِۦ قَالَتْ مَنْ أَنۢبَأَكَ هَٰذَاۖ قَالَ نَبَّأَنِىَ ٱلْعَلِيمُ ٱلْخَبِيرُ ", "translation": "And [remember] when the Prophet confided to one of his wives a statement; and when she informed [another] of it and Allāh showed it to him, he made known part of it and ignored a part. And when he informed her about it, she said, \"Who told you this?\" He said, \"I was informed by the Knowing, the Aware.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَسَرَّ", "translit": "َّrَsَaʾ", "root": "سرر"}, {"id": 3, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "بَعْضِ", "translit": "ِḍْʿعَb", "root": "بعض"}, {"id": 6, "arabic": "أَزْوَٰجِهِۦ", "translit": "ۦِhِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 7, "arabic": "حَدِيثًا", "translit": "āًhtyِdَḥ", "root": "حدث"}, {"id": 8, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 9, "arabic": "نَبَّأَتْ", "translit": "ْtَaʾَّbَn", "root": "نبا"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "وَأَظْهَرَهُ", "translit": "ُhَrَhْẓَaʾَw", "root": "ظهر"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "عَرَّفَ", "translit": "َfَّrَʿع", "root": "عرف"}, {"id": 15, "arabic": "بَعْضَهُۥ", "translit": "ۥُhَḍْʿعَb", "root": "بعض"}, {"id": 16, "arabic": "وَأَعْرَضَ", "translit": "َḍَrْʿعَaʾَw", "root": "عرض"}, {"id": 17, "arabic": "عَنۢ", "translit": "ۢnَʿع", "root": ""}, {"id": 18, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 19, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 20, "arabic": "نَبَّأَهَا", "translit": "āَhَaʾَّbَn", "root": "نبا"}, {"id": 21, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 22, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 23, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 24, "arabic": "أَنۢبَأَكَ", "translit": "َkَaʾَbۢnَaʾ", "root": "نبا"}, {"id": 25, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 26, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 27, "arabic": "نَبَّأَنِىَ", "translit": "َàِnَaʾَّbَn", "root": "نبا"}, {"id": 28, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}, {"id": 29, "arabic": "ٱلْخَبِيرُ", "translit": "ُryِbَhkْlٱ", "root": "خبر"}], "hasIhya": true}, {"ayah": 4, "text": "إِن تَتُوبَآ إِلَى ٱللَّهِ فَقَدْ صَغَتْ قُلُوبُكُمَاۖ وَإِن تَظَٰهَرَا عَلَيْهِ فَإِنَّ ٱللَّهَ هُوَ مَوْلَىٰهُ وَجِبْرِيلُ وَصَٰلِحُ ٱلْمُؤْمِنِينَۖ وَٱلْمَلَٰٓئِكَةُ بَعْدَ ذَٰلِكَ ظَهِيرٌ ", "translation": "If you two [wives] repent to Allāh, [it is best], for your hearts have deviated. But if you cooperate against him - then indeed Allāh is his protector, and Gabriel and the righteous of the believers and the angels, moreover, are [his] assistants.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "تَتُوبَآ", "translit": "ٓāَbwُtَt", "root": "توب"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 6, "arabic": "صَغَتْ", "translit": "ْtَغَṣ", "root": "صغو"}, {"id": 7, "arabic": "قُلُوبُكُمَا", "translit": "āَmُkُbwُlُq", "root": "قلب"}, {"id": 8, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 9, "arabic": "تَظَٰهَرَا", "translit": "āَrَhَٰẓَt", "root": "ظهر"}, {"id": 10, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 14, "arabic": "مَوْلَىٰهُ", "translit": "ُhٰàَlْwَm", "root": "ولي"}, {"id": 15, "arabic": "وَجِبْرِيلُ", "translit": "ُlyِrْbِjgَw", "root": ""}, {"id": 16, "arabic": "وَصَٰلِحُ", "translit": "ُḥِlَٰṣَw", "root": "صلح"}, {"id": 17, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 18, "arabic": "وَٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱَw", "root": "ملك"}, {"id": 19, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 20, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 21, "arabic": "ظَهِيرٌ", "translit": "ٌryِhَẓ", "root": "ظهر"}], "hasIhya": true}, {"ayah": 5, "text": "عَسَىٰ رَبُّهُۥٓ إِن طَلَّقَكُنَّ أَن يُبْدِلَهُۥٓ أَزْوَٰجًا خَيْرًا مِّنكُنَّ مُسْلِمَٰتٍ مُّؤْمِنَٰتٍ قَٰنِتَٰتٍ تَٰٓئِبَٰتٍ عَٰبِدَٰتٍ سَٰٓئِحَٰتٍ ثَيِّبَٰتٍ وَأَبْكَارًا ", "translation": "Perhaps his Lord, if he divorced you [all], would substitute for him wives better than you - submitting [to Allāh], believing, devoutly obedient, repentant, worshipping, and traveling[1] - [ones] previously married and virgins.", "words": [{"id": 1, "arabic": "عَسَىٰ", "translit": "ٰàَsَʿع", "root": "عسي"}, {"id": 2, "arabic": "رَبُّهُۥٓ", "translit": "ٓۥُhُّbَr", "root": "ربب"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "طَلَّقَكُنَّ", "translit": "َّnُkَqَّlَṭ", "root": "طلق"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يُبْدِلَهُۥٓ", "translit": "ٓۥُhَlِdْbُy", "root": "بدل"}, {"id": 7, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 8, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 9, "arabic": "مِّنكُنَّ", "translit": "َّnُknِّm", "root": ""}, {"id": 10, "arabic": "مُسْلِمَٰتٍ", "translit": "ٍtَٰmِlْsُm", "root": "سلم"}, {"id": 11, "arabic": "مُّؤْمِنَٰتٍ", "translit": "ٍtَٰnِmْwʾُّm", "root": "امن"}, {"id": 12, "arabic": "قَٰنِتَٰتٍ", "translit": "ٍtَٰtِnَٰq", "root": "قنت"}, {"id": 13, "arabic": "تَٰٓئِبَٰتٍ", "translit": "ٍtَٰbِyʾَٰٓt", "root": "توب"}, {"id": 14, "arabic": "عَٰبِدَٰتٍ", "translit": "ٍtَٰdِbَٰʿع", "root": "عبد"}, {"id": 15, "arabic": "سَٰٓئِحَٰتٍ", "translit": "ٍtَٰḥِyʾَٰٓs", "root": "سيح"}, {"id": 16, "arabic": "ثَيِّبَٰتٍ", "translit": "ٍtَٰbِّyَht", "root": "ثيب"}, {"id": 17, "arabic": "وَأَبْكَارًا", "translit": "āًrāَkْbَaʾَw", "root": "بكر"}], "hasIhya": false}, {"ayah": 6, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ قُوٓا۟ أَنفُسَكُمْ وَأَهْلِيكُمْ نَارًا وَقُودُهَا ٱلنَّاسُ وَٱلْحِجَارَةُ عَلَيْهَا مَلَٰٓئِكَةٌ غِلَاظٌ شِدَادٌ لَّا يَعْصُونَ ٱللَّهَ مَآ أَمَرَهُمْ وَيَفْعَلُونَ مَا يُؤْمَرُونَ ", "translation": "O you who have believed, protect yourselves and your families from a Fire whose fuel is people and stones, over which are [appointed] angels, harsh and severe; they do not disobey Allāh in what He commands them but do what they are commanded.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "قُوٓا۟", "translit": "۟āٓwُq", "root": "وقي"}, {"id": 5, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "وَأَهْلِيكُمْ", "translit": "ْmُkyِlْhَaʾَw", "root": "اهل"}, {"id": 7, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 8, "arabic": "وَقُودُهَا", "translit": "āَhُdwُqَw", "root": "وقد"}, {"id": 9, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 10, "arabic": "وَٱلْحِجَارَةُ", "translit": "ُẗَrāَjgِḥْlٱَw", "root": "حجر"}, {"id": 11, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "مَلَٰٓئِكَةٌ", "translit": "ٌẗَkِyʾَٰٓlَm", "root": "ملك"}, {"id": 13, "arabic": "غِلَاظٌ", "translit": "ٌẓāَlِغ", "root": "غلظ"}, {"id": 14, "arabic": "شِدَادٌ", "translit": "ٌdāَdِhs", "root": "شدد"}, {"id": 15, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 16, "arabic": "يَعْصُونَ", "translit": "َnwُṣْʿعَy", "root": "عصي"}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 19, "arabic": "أَمَرَهُمْ", "translit": "ْmُhَrَmَaʾ", "root": "امر"}, {"id": 20, "arabic": "وَيَفْعَلُونَ", "translit": "َnwُlَʿعْfَyَw", "root": "فعل"}, {"id": 21, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 22, "arabic": "يُؤْمَرُونَ", "translit": "َnwُrَmْwʾُy", "root": "امر"}], "hasIhya": true}, {"ayah": 7, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ كَفَرُوا۟ لَا تَعْتَذِرُوا۟ ٱلْيَوْمَۖ إِنَّمَا تُجْزَوْنَ مَا كُنتُمْ تَعْمَلُونَ ", "translation": "O you who have disbelieved, make no excuses that Day. You will only be recompensed for what you used to do.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَعْتَذِرُوا۟", "translit": "۟āwُrِhdَtْʿعَt", "root": "عذر"}, {"id": 6, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 7, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 8, "arabic": "تُجْزَوْنَ", "translit": "َnْwَzْjgُt", "root": "جزي"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 8, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ تُوبُوٓا۟ إِلَى ٱللَّهِ تَوْبَةً نَّصُوحًا عَسَىٰ رَبُّكُمْ أَن يُكَفِّرَ عَنكُمْ سَيِّـَٔاتِكُمْ وَيُدْخِلَكُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ يَوْمَ لَا يُخْزِى ٱللَّهُ ٱلنَّبِىَّ وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥۖ نُورُهُمْ يَسْعَىٰ بَيْنَ أَيْدِيهِمْ وَبِأَيْمَٰنِهِمْ يَقُولُونَ رَبَّنَآ أَتْمِمْ لَنَا نُورَنَا وَٱغْفِرْ لَنَآۖ إِنَّكَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "O you who have believed, repent to Allāh with sincere repentance. Perhaps[1] your Lord will remove from you your misdeeds and admit you into gardens beneath which rivers flow [on] the Day when Allāh will not disgrace the Prophet and those who believed with him. Their light will proceed before them and on their right; they will say, \"Our Lord, perfect for us our light and forgive us. Indeed, You are over all things competent.\"", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "تُوبُوٓا۟", "translit": "۟āٓwُbwُt", "root": "توب"}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "تَوْبَةً", "translit": "ًẗَbْwَt", "root": "توب"}, {"id": 8, "arabic": "نَّصُوحًا", "translit": "āًḥwُṣَّn", "root": "نصح"}, {"id": 9, "arabic": "عَسَىٰ", "translit": "ٰàَsَʿع", "root": "عسي"}, {"id": 10, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يُكَفِّرَ", "translit": "َrِّfَkُy", "root": "كفر"}, {"id": 13, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 14, "arabic": "سَيِّـَٔاتِكُمْ", "translit": "ْmُkِtāَٔـِّyَs", "root": "سوا"}, {"id": 15, "arabic": "وَيُدْخِلَكُمْ", "translit": "ْmُkَlِhkْdُyَw", "root": "دخل"}, {"id": 16, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 17, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 20, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 21, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 22, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 23, "arabic": "يُخْزِى", "translit": "àِzْhkُy", "root": "خزي"}, {"id": 24, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "ٱلنَّبِىَّ", "translit": "َّàِbَّnlٱ", "root": "نبا"}, {"id": 26, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 27, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 28, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 29, "arabic": "نُورُهُمْ", "translit": "ْmُhُrwُn", "root": "نور"}, {"id": 30, "arabic": "يَسْعَىٰ", "translit": "ٰàَʿعْsَy", "root": "سعي"}, {"id": 31, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 32, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 33, "arabic": "وَبِأَيْمَٰنِهِمْ", "translit": "ْmِhِnَٰmْyَaʾِbَw", "root": "يمن"}, {"id": 34, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 35, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 36, "arabic": "أَتْمِمْ", "translit": "ْmِmْtَaʾ", "root": "تمم"}, {"id": 37, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 38, "arabic": "نُورَنَا", "translit": "āَnَrwُn", "root": "نور"}, {"id": 39, "arabic": "وَٱغْفِرْ", "translit": "ْrِfْغٱَw", "root": "غفر"}, {"id": 40, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 41, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 42, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 43, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 44, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 45, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 9, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ جَٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَٰفِقِينَ وَٱغْلُظْ عَلَيْهِمْۚ وَمَأْوَىٰهُمْ جَهَنَّمُۖ وَبِئْسَ ٱلْمَصِيرُ ", "translation": "O Prophet, strive against the disbelievers and the hypocrites and be harsh upon them. And their refuge is Hell, and wretched is the destination.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "جَٰهِدِ", "translit": "ِdِhَٰjg", "root": "جهد"}, {"id": 4, "arabic": "ٱلْكُفَّارَ", "translit": "َrāَّfُkْlٱ", "root": "كفر"}, {"id": 5, "arabic": "وَٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱَw", "root": "نفق"}, {"id": 6, "arabic": "وَٱغْلُظْ", "translit": "ْẓُlْغٱَw", "root": "غلظ"}, {"id": 7, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَمَأْوَىٰهُمْ", "translit": "ْmُhٰàَwْaʾَmَw", "root": "اوي"}, {"id": 9, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 10, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 11, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 10, "text": "ضَرَبَ ٱللَّهُ مَثَلًا لِّلَّذِينَ كَفَرُوا۟ ٱمْرَأَتَ نُوحٍ وَٱمْرَأَتَ لُوطٍۖ كَانَتَا تَحْتَ عَبْدَيْنِ مِنْ عِبَادِنَا صَٰلِحَيْنِ فَخَانَتَاهُمَا فَلَمْ يُغْنِيَا عَنْهُمَا مِنَ ٱللَّهِ شَيْـًٔا وَقِيلَ ٱدْخُلَا ٱلنَّارَ مَعَ ٱلدَّٰخِلِينَ ", "translation": "Allāh presents an example of those who disbelieved: the wife of Noah and the wife of Lot. They were under two of Our righteous servants but betrayed them,[1] so they [i.e., those prophets] did not avail them from Allāh at all, and it was said, \"Enter the Fire with those who enter.\"", "words": [{"id": 1, "arabic": "ضَرَبَ", "translit": "َbَrَḍ", "root": "ضرب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 5, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 6, "arabic": "ٱمْرَأَتَ", "translit": "َtَaʾَrْmٱ", "root": "مرا"}, {"id": 7, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 8, "arabic": "وَٱمْرَأَتَ", "translit": "َtَaʾَrْmٱَw", "root": "مرا"}, {"id": 9, "arabic": "لُوطٍ", "translit": "ٍṭwُl", "root": ""}, {"id": 10, "arabic": "كَانَتَا", "translit": "āَtَnāَk", "root": "كون"}, {"id": 11, "arabic": "تَحْتَ", "translit": "َtْḥَt", "root": "تحت"}, {"id": 12, "arabic": "عَبْدَيْنِ", "translit": "ِnْyَdْbَʿع", "root": "عبد"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "عِبَادِنَا", "translit": "āَnِdāَbِʿع", "root": "عبد"}, {"id": 15, "arabic": "صَٰلِحَيْنِ", "translit": "ِnْyَḥِlَٰṣ", "root": "صلح"}, {"id": 16, "arabic": "فَخَانَتَاهُمَا", "translit": "āَmُhāَtَnāَhkَf", "root": "خون"}, {"id": 17, "arabic": "فَلَمْ", "translit": "ْmَlَf", "root": ""}, {"id": 18, "arabic": "يُغْنِيَا", "translit": "āَyِnْغُy", "root": "غني"}, {"id": 19, "arabic": "عَنْهُمَا", "translit": "āَmُhْnَʿع", "root": ""}, {"id": 20, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 23, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 24, "arabic": "ٱدْخُلَا", "translit": "āَlُhkْdٱ", "root": "دخل"}, {"id": 25, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 26, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 27, "arabic": "ٱلدَّٰخِلِينَ", "translit": "َnyِlِhkَّٰdlٱ", "root": "دخل"}], "hasIhya": true}, {"ayah": 11, "text": "وَضَرَبَ ٱللَّهُ مَثَلًا لِّلَّذِينَ ءَامَنُوا۟ ٱمْرَأَتَ فِرْعَوْنَ إِذْ قَالَتْ رَبِّ ٱبْنِ لِى عِندَكَ بَيْتًا فِى ٱلْجَنَّةِ وَنَجِّنِى مِن فِرْعَوْنَ وَعَمَلِهِۦ وَنَجِّنِى مِنَ ٱلْقَوْمِ ٱلظَّٰلِمِينَ ", "translation": "And Allāh presents an example of those who believed: the wife of Pharaoh, when she said, \"My Lord, build for me near You a house in Paradise and save me from Pharaoh and his deeds and save me from the wrongdoing people.\"", "words": [{"id": 1, "arabic": "وَضَرَبَ", "translit": "َbَrَḍَw", "root": "ضرب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 5, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "ٱمْرَأَتَ", "translit": "َtَaʾَrْmٱ", "root": "مرا"}, {"id": 7, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 8, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 9, "arabic": "قَالَتْ", "translit": "ْtَlāَq", "root": "قول"}, {"id": 10, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 11, "arabic": "ٱبْنِ", "translit": "ِnْbٱ", "root": "بني"}, {"id": 12, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 13, "arabic": "عِندَكَ", "translit": "َkَdnِʿع", "root": "عند"}, {"id": 14, "arabic": "بَيْتًا", "translit": "āًtْyَb", "root": "بيت"}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 17, "arabic": "وَنَجِّنِى", "translit": "àِnِّjgَnَw", "root": "نجو"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 20, "arabic": "وَعَمَلِهِۦ", "translit": "ۦِhِlَmَʿعَw", "root": "عمل"}, {"id": 21, "arabic": "وَنَجِّنِى", "translit": "àِnِّjgَnَw", "root": "نجو"}, {"id": 22, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 23, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 24, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 12, "text": "وَمَرْيَمَ ٱبْنَتَ عِمْرَٰنَ ٱلَّتِىٓ أَحْصَنَتْ فَرْجَهَا فَنَفَخْنَا فِيهِ مِن رُّوحِنَا وَصَدَّقَتْ بِكَلِمَٰتِ رَبِّهَا وَكُتُبِهِۦ وَكَانَتْ مِنَ ٱلْقَٰنِتِينَ ", "translation": "And [the example of] Mary, the daughter of ʿImrān, who guarded her chastity, so We blew into [her garment] through Our angel [i.e., Gabriel], and she believed in the words of her Lord and His scriptures and was of the devoutly obedient.", "words": [{"id": 1, "arabic": "وَمَرْيَمَ", "translit": "َmَyْrَmَw", "root": ""}, {"id": 2, "arabic": "ٱبْنَتَ", "translit": "َtَnْbٱ", "root": "بني"}, {"id": 3, "arabic": "عِمْرَٰنَ", "translit": "َnَٰrْmِʿع", "root": ""}, {"id": 4, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 5, "arabic": "أَحْصَنَتْ", "translit": "ْtَnَṣْḥَaʾ", "root": "حصن"}, {"id": 6, "arabic": "فَرْجَهَا", "translit": "āَhَjgْrَf", "root": "فرج"}, {"id": 7, "arabic": "فَنَفَخْنَا", "translit": "āَnْhkَfَnَf", "root": "نفخ"}, {"id": 8, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "رُّوحِنَا", "translit": "āَnِḥwُّr", "root": "روح"}, {"id": 11, "arabic": "وَصَدَّقَتْ", "translit": "ْtَqَّdَṣَw", "root": "صدق"}, {"id": 12, "arabic": "بِكَلِمَٰتِ", "translit": "ِtَٰmِlَkِb", "root": "كلم"}, {"id": 13, "arabic": "رَبِّهَا", "translit": "āَhِّbَr", "root": "ربب"}, {"id": 14, "arabic": "وَكُتُبِهِۦ", "translit": "ۦِhِbُtُkَw", "root": "كتب"}, {"id": 15, "arabic": "وَكَانَتْ", "translit": "ْtَnāَkَw", "root": "كون"}, {"id": 16, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 17, "arabic": "ٱلْقَٰنِتِينَ", "translit": "َnyِtِnَٰqْlٱ", "root": "قنت"}], "hasIhya": false}], "tafsir": {"3": [{"arabic": "رأيتك قبل اليوم قال نبأني العليم الخبير وعرفت روحي روحك حين كلمت نفسي نفسك إن الأرواح لها أنفس كأنفس الأجساد وإن المؤمنين ليعرف بعضهم بعضا ويتحابون بروح الله وإن لم يلتقوا يتعارفون ويتكلمون وإن نأت بهم الدار وتفرقت بهم المنازل قال قلت حدثني رحمك الله عن رسول الله صلى الله عليه وسلم بحديث أسمعه منك قال إني لم أدرك رسول الله صلى الله عليه وسلم ولم تكن لي معه صحبة بأبي وأمي رسول الله ولكن رأيت رجالا قد صحبوه وبلغني من حديثه كما بلغك ولست أحب أن أفتح على نفسي هذا الباب أن أكون محدثا أو", "english": "And the gatherings of passion are five matters, which are what Allah, the Exalted, has gathered in His saying: {إنما الحياة الدنيا لعب ولهو وزينة وتفاخر بينكم وتكاثر في الأموال والأولاد} — \"The life of this world is but play and diversion and adornment and boasting among yourselves and increase in wealth and children\" (57:20). And the corporeal entities (al-aʿyān) from which these five are obtained are seven, gathered by His saying, the Exalted: {زين للناس حب الشهوات من النساء والبنين والقناطير المقنطرة من الذهب والفضة والخيل المسومة والأنعام والحرث ذلك متاع الحياة الدنيا} — \"Adorned for mankind is the love of desires — of women and sons and heaped-up treasures of gold and silver and branded horses and cattle and tillage. That is the enjoyment of the life of this world\" (3:14).", "book_title": "Condemnation of the World", "section_title_ar": "Section 744", "section_title_en": "The Discipline of the Soul and the Restraint of the Passions — The Life of Uways al-Qarani and the True Boundary of the Worldly Life", "section_index": 744, "anchors": "- Root: ن-ه-ي (N-H-Y)\n  * Lisan / Ayn: \"نهاه عنه نهياً: كفّه وردّه عنه. والنهي: خلاف الأمر.\"\n  * Al-Raghib (Mufradat): \"النهي: الزجر عن الشيء، ويستعمل في الكفّ عن الفعل. قال تعالى: {ونهى النفس عن الهوى} — أي: كفّها وزجرها عن متابعة الشهوات.\"\n  * Al-Zamakhshari (Asas): \"نهاه عن كذا: كفّه. ومنه: انتهى عن الأمر إذا كفّ نفسه. والتناهي: التوقف عند الحد.\"\n- Root: ه-و-ي (H-W-Y)\n  * Lisan / Ayn: \"الهوى: ميل النفس إلى الشهوة. وهويته: أحببته. والهوى: ما تهواه النفس وتنزع إليه من غير هدى.\"\n  * Al-Raghib (Mufradat): \"الهوى: ميل النفس إلى ما تشتهيه، ويذمّ إذا لم يكن بعقل وشرع. قال تعالى: {أفرأيت من اتخذ إلهه هواه}.\"\n  * Al-Zamakhshari (Asas): \"هويته: أحببته. وهوًى: سقط. والهوى: اسم لما تهواه النفس من غير رشد. وقد غلب في الشرع على الميل المذموم.\"\n- Root: د-ن-و (D-N-W)\n  * Lisan / Ayn: \"دنا يدنو دنواً: قرب. والدنيا: نقيض الآخرة، سميت بذلك لدنوّها وتقدّمها.\"\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات أو بالحكم. والدنيا: الحياة العاجلة، سميت دنيا لدنوّها من الإنسان أو لتأخر الآخرة عنها.\"\n  * Al-Zamakhshari (Asas): \"الدنيا: الحاضرة العاجلة. وتقول: هو من أهل الدنيا إذا كان مقبلاً على شهواتها.\"\n- Root: ن-ف-س (N-F-S)\n  * Lisan / Ayn: \"النفس: الروح، والذات. ونفس الشيء: عينه. والنفس: الدم. والنفيس: الثمين.\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتستعمل للذات. قال تعالى: {ويحذركم الله نفسه} أي: ذاته. وقد تكون النفس بمعنى الهوى والشهوة.\"\n  * Al-Zamakhshari (Asas): \"نفس الشيء: عينه وذاته. وأنفس الشيء: صار نفيساً. ومن المجاز: نفس عن كذا أي: فرّج عنه.\"\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — The periodic structure allows for extended parenthetical insertions between the subject and its predicate, as in the long narrative sequences here, where the subject (أويس) is introduced and its predicate follows after extensive descriptive clauses.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of the World'", "badge": "Insight"}, {"arabic": "قال الله تعلى عرف بعضه وأعرض عن بعض وقال الجاحظ ما بقي من اللذات إلا ثلاث دم البخلاء وأكل القديد وحك الجرب وقال بشر بن الحارث البخيل لا غيبة له قال النبي صلى الله عليه وسلم إنك إذا لبخيل ومدحت امرأة عند رسول الله صلى الله عليه وسلم فقالوا صوامة قوامة إلا أن فيها بخلا قال فما خيرها إذن // حديث مدحت امرأة عند النبي صلى الله عليه وسلم فقالوا صوامة قوامة إلا أن فيها بخلا الحديث تقدم في آفات اللسان وقال بشر النظر إلى البخيل يقسي القلب ولقاء البخلاء كرب على قلوب المؤمنين وقال يحيى بن م", "english": "God—exalted be He—has said: {«وَمَن يُوقَ شُحَّ نَفْسِهِ فَأُولَٰئِكَ هُمُ الْمُفْلِحُونَ»} — \"And whoever is saved from the miserliness of his own soul, it is those who are the successful\" [Al-Hashr 59:9]. And He has said: {«وَأَمَّا مَن بَخِلَ وَاسْتَغْنَىٰ * فَسَنُيَسِّرُهُ لِلْعُسْرَىٰ»} — \"And as for him who withholds and deems himself self-sufficient, We shall ease him toward hardship\" [Al-Layl 92:8-9]. And the Prophet (peace be upon him) said: \"Beware of miserliness, for it destroyed those before you. It commanded them to sever kinship ties, and they severed them; it commanded them to be miserly, and they were miserly; and it commanded them to commit wickedness, and they committed it.\"", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 774", "section_title_en": "Exposition of the Blameworthiness of Miserliness (Bayān Dhamm al-Bukhl)", "section_index": 774, "anchors": "- Root: بخل (B-Kh-L)\n  * Lisan / Ayn: Core meaning is withholding/restraining what one possesses from that which it is not lawful to withhold; al-Khalil notes the intensive form 'bakhīl' denotes one in whom miserliness is a dominant trait.\n  * Al-Raghib (Mufradat): \"البخل: إمساك المقتنيات عما لا يحق حبسها عنه\" — miserliness is the withholding of possessions from that which it is not right to withhold; it is of two kinds: withholding one's own goods, and withholding what belongs to others (commanding others to be miserly), the latter being the more blameworthy, as in {«الذين يبخلون ويأمرون الناس بالبخل»} [Al-Nisa 4:37].\n  * Al-Zamakhshari (Asas): Literal (haqīqah): \"فلان لم يبخل\" — he did not act miserly. Metaphorical (majāz): \"إذا السماء بخلت بالفطر\" — the sky withheld its rain, extending the root to non-human agency.\n- Root: قتل (Q-T-L) [as in 'qarama' — intense craving, related to being consumed by desire]\n  * Lisan / Ayn: The root denotes intense longing that overcomes restraint; used here to describe Marwan's overpowering desire for meat after prolonged abstinence.\n- Sibawayh Rule: Rule of Interposition (al-Faṣl bayna al-Jār wa al-Majrūr) — governing the permissible separation between a preposition and its object for rhetorical emphasis, as in the construction \"لقد صغر فلان في عيني\" where the prepositional phrase is fronted for focus.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Ethics"}], "4": [{"arabic": "قال الله تعالى حين أفشين سر رسول الله صلى الله عليه وسلم إن تتوبا إلى الله فقد صغت قلوبكما أي مالت وقال ذلك في خير أزواجه (4) وقال صلى الله عليه وسلم لا يفلح قوم تملكهم امرأة (5) حديث نهى رسول الله صلى الله عليه وسلم إن تتبع عورات النساء رواه الطبراني في الأوسط من حديث جابر نهى أن تتطلب عثرات النساء والحديث عند مسلم بلفظ نهى أن يطرق الرجل أهله ليلا يخونهم أو يطلب عثراتهم واقتصر البخاري منه على ذكر النهي عن الطروق ليلا وفي لفظ آخر أن تبغت النساء ولما قدم رسول الله صلى الله عليه وسلم من سفره قال قبل دخول المدينة لا تطرقوا ا", "english": "The first point of etiquette is the wedding feast (walīmah), and it is recommended (mustaḥabbah). Anas, may God be pleased with him, said: The Messenger of God, may God bless him and grant him peace, saw upon ʿAbd al-Raḥmān ibn ʿAwf, may God be pleased with him, a trace of yellow dye, so he said: {«What is this?»} He replied: \"I have married a woman for the weight of a date-stone in gold.\" He said: \"May God bless you. Hold a wedding feast, even if with a single sheep.\" {«...»} And the Messenger of God, may God bless him and grant him peace, held a wedding feast for Ṣafiyyah with dates and sawīq (barley porridge). {«...»} And he, may God bless him and grant him peace, said: \"The food of the first day is an obligation (ḥaqq), the food of the second day is a Sunnah, and the food of the third day is for show (sumʿah); and whoever seeks to be heard, God will make his deeds heard.\" {«...»} None raised this hadith except Ziyād ibn ʿAbd Allāh, and it is anomalous (gharīb). It is recommended to offer congratulations to him, and the one who enters upon the husband should say: \"May God bless you and shower blessings upon you, and may He bring you both together in goodness.\" {«...»} Abū Hurayrah, may God be pleased with him, reported that he, may God bless him and grant him peace, commanded this. It is also recommended to make the marriage public (iẓhār al-nikāḥ). He, may God bless him and grant him peace, said: \"The distinction between the lawful and the unlawful is the drum and the voice.\" {«...»} The Messenger of God, may God bless him and grant him peace, said: \"Announce this marriage, hold it in the mosques, and beat drums for it.\" {«...»} And on the authority of al-Rubayyiʿ bint Muʿawwidh, she said: The Messenger of God, may God bless him and grant him peace, came and entered on the morning of my wedding night, and he sat upon my bedding, and we had young girls with us who were beating their drums and lamenting those of my forefathers who had been killed—until one of them said: \"And among us is a Prophet who knows what will be tomorrow.\" He said to her: \"Stop this, and say what you were saying before.\" {«...»}", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 303", "section_title_en": "On What is Incumbent Upon the Husband and What is Incumbent Upon the Wife", "section_index": 303, "anchors": "- Root: و ل م (w-l-m)\n  * Lisan / Ayn: The core meaning pertains to the wedding feast (walīmah), derived from the concept of gathering and union.\n  * Al-Raghib (Mufradat): In theological usage, it signifies the communal meal marking the consummation of a marriage contract, a recommended act of public gratitude.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the specific feast; metaphorical (Majaz) extension applies to any act of publicizing a joyous occasion.\n- Root: ع ش ر (ʿ- sh-r)\n  * Lisan / Ayn: The root denotes association, companionship, and intimacy; the tenth (ʿasharah) of a thing is related, but the primary social sense is cohabitation and mutual dealing.\n  * Al-Raghib (Mufradat): In the Quranic context of {وَعَاشِرُوهُنَّ بِالْمَعْرُوفِ}, it signifies a sustained, equitable mode of social intercourse grounded in moral rectitude, not mere physical proximity.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the act of living together; metaphorical (Majaz) usage elevates it to a standard of ethical conduct (maʿrūf) that defines the marital bond.\n- Root: ق س م (q-s-m)\n  * Lisan / Ayn: The root indicates division, apportionment, and distribution; in the marital context, it refers to the equitable division of time among co-wives.\n  * Al-Raghib (Mufradat): Theologically, it is tied to justice (ʿadl) as a divine attribute; for the husband, it is a legal obligation to maintain fairness in material and temporal allotments.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the physical act of dividing; metaphorical (Majaz) usage applies to the moral duty of impartiality in affection and provision.\n- Root: غ ي ر (gh-y-r)\n  * Lisan / Ayn: The root conveys alteration and change, but in the moral register, it denotes protective jealousy (ghayrah), a state of aversion to the violation of honor.\n  * Al-Raghib (Mufradat): In Kalam, ghayrah is a praiseworthy emotion when aligned with divine law—jealousy for the sanctity of the family—and blameworthy when it stems from unjust suspicion (sūʾ al-ẓann).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is the emotional state; metaphorical (Majaz) usage is attributed to God (al-Ghayyār) as a figure for His prohibition of indecencies, distinguishing human passion from divine will.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to isolate specific obligations (e.g., \"the third is that he should increase...\") and to distinguish categories of jealousy and pride, ensuring precise legal and moral demarcation.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Marriage'", "badge": "Hadith"}], "6": [{"arabic": "حملة العرش ينتظرون منهم ما ينزل عليهم من الأمر من حضرة الربوبية كي لا يعصوا الله ما أمرهم ويفعلون ما يؤمرون وعبر عن هذه المشاهدات في القرآن وقيل {وفي السماء رزقكم وما توعدون} وعبر عن انتظار ملائكة السموات لما ينزل إليهم من القدر والأمر فقيل خلق سبع سموات ومن الأرض مثلهن يتنزل الأمر بينهن لتعلموا أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما وهذه أمور لا يعلم تأويلها إلا الله والراسخون في العلم وعبر ابن عباس رضي الله عنهما عن اختصاص الراسخين في العلم بعلوم لا تحتملها أفهام الخلق حيث قرأ قوله تعالى {يتنزل الأمر بينهن} فقال لو ذكرت ما أعرفه من مع", "english": "Thus was the beginning of this matter and its end. And do not understand it unless you are worthy of it. And if you are worthy of it, the eye is opened and you see, so you have no need of a leader to lead you. The blind man can indeed be led, but only to a limit. For when the path narrows and becomes sharper than a sword and finer than a hair, the bird is able to fly over it but is not able to drag a blind man behind it. And when the field becomes narrow and subtle — subtle as water, for example — and crossing is possible only by swimming, then the one skilled in the art of swimming may be able to cross by himself, and perhaps he is not able to drag another behind him. These matters bear the same relation to walking upon the way of the common masses of creatures as walking upon water bears to walking upon earth. Swimming can be learned; but as for walking upon water, it is not acquired by instruction, but rather is attained through the strength of certainty (yaqīn). For this reason it was said to the Prophet, peace be upon him, that Jesus, peace be upon him, was said to have walked upon water, and he, peace be upon him, said: \"Had his certainty increased, he would have walked upon the air.\" {«حديث قيل له يقال إن عيسى مشى على الماء قال لو ازداد يقينا لمشي على الهواء»} — This hadith is rejected (munkar) and is not known in this form. What is known is what Ibn Abi al-Dunya narrated in the Book of Certainty from the saying of Bakr ibn Abd Allah al-Muzani, who said: The disciples lost their Prophet, and it was said to them: \"He has headed toward the sea.\" So they set out seeking him, and when they reached the sea, behold, he was coming toward them walking upon the water. And he mentioned a hadith in which Jesus said: \"If the son of Adam had a hair's breadth of certainty, he would walk upon the water.\" And Abu Mansur al-Daylami narrated in the Musnad al-Firdaws with a weak chain from the hadith of Muadh ibn Jabal: \"If you knew God with true knowledge, you would walk upon the seas, and the mountains would be removed by your supplications.\" These are symbols and allusions to the meaning of aversion (karāhah) and love (maḥabbah), and good pleasure (riḍā) and wrath (ghaḍab), and gratitude (shukr) and ingratitude (kufrān) — more than this is not fitting for the science of practical conduct (ʿilm al-muʿāmalah). And God, exalted be He, struck an example of this to draw it near to the understanding of creatures, since He knew that He created the jinn and mankind only to worship Him, and their worship was the ultimate purpose of wisdom (ghāyat al-ḥikmah) with respect to them. Then He informed that He has two servants: one whom He loves, whose name is Gabriel — the Holy Spirit and the Trustworthy One — and he is with Him beloved, obeyed, trustworthy, and honored; and another whom He hates, whose name is Iblis — the accursed one, reprieved until the Day of Judgment. Then He delegated guidance (irshād) to Gabriel, saying, the Exalted: {«قل نزله روح القدس من ربك بالحق»} \"Say: The Holy Spirit has brought it down from your Lord with truth\" (16:102), and said, the Exalted: {«يلقي الروح من أمره على من يشاء من عباده»} \"He casts the Spirit of His command upon whom He wills of His servants\" (40:15). And He delegated misguidance (ighwāʾ) to Iblis, saying, the Exalted: {«ليضل عن سبيله»} \"That he may lead astray from His path\" (4:119). And ighwāʾ is the halting of servants short of attaining the ultimate purpose of wisdom. So observe how He attributed it to the servant with whom He was wrathful; and guidance (irshād) is the conduct of them toward the ultimate purpose — so observe how He attributed it to the servant whom He loves. And you have an example of this in custom: when a king is in need of one to give him drink and one to cup him and to clean the courtyard of his house of filth, and he has two servants, he does not appoint for cupping and cleaning except the ugliest and meanest of them, and he does not entrust the carrying of drink and perfume except to the best and most complete of them and the most beloved to him. And you should not say: \"This is my act, and his act was not without my act\" — for you have erred when you attributed that to yourself. Rather, He is the One who directed your motive (dāʿiyah) to the specification of the disliked act to the disliked person, and the beloved act to the beloved person, as a completion of justice (ʿadl). For His justice is sometimes completed through matters in which you have no entry, and sometimes it is completed in you — for you also are among His acts. So your motive, your power, your knowledge, your action, and all the other causes of your movements in expression — all of this is His act, which He arranged with justice in an arrangement from which moderate acts issue forth. Except that you see only yourself, and so you suppose that what appears through you in the world of witness (ʿālam al-shahādah) has no cause from the world of the unseen and the dominion (ʿālam al-ghayb wa al-malakūt). Therefore you attribute it to yourself. And you are only like the child who looks at night at the play of the juggler (mushʿabadh) who brings forth figures from behind a curtain that dance and scream and rise and sit, composed of rags that do not move by themselves — rather, they are moved by fine hair-like threads that do not appear in the darkness of night, their ends in the hand of the juggler, who is hidden from the eyes of the children. So they rejoice and marvel, supposing that those rags dance and play and rise and sit. As for the intelligent ones, they know that this is a moving (taḥrīk) and not a self-movement, but perhaps they do not know its detailed modality. And the one who knows some of its detail does not know it as the juggler knows it, to whom the command belongs and in whose hand is the pulling. Likewise, the children of the people of this world — and all creatures are children relative to the scholars — look at these persons (ashkhāṣ) and suppose that they are the movers, and so they attribute [action] to them. And the scholars know that they are moved, except that they do not know the modality of the moving — and they are the majority. Except the knowers (ʿārifūn), the scholars, and those firmly rooted in knowledge (al-rāsikhūn), for they have perceived, with the sharpness of their sight, fine spider-web threads — nay, much finer than these — suspended from heaven, their ends attached to the persons of the people of the earth. Those threads are not perceived, due to their fineness, by these outward eyes. Then they witnessed the heads of those threads in their suspension-points (manāṭāt) to which they are attached, and they witnessed for those suspension-points handles (maqābiḍ) that are in the hands of the angels who move the heavens. And they also witnessed the angels of the heavens directed toward the bearers of the Throne (ḥamalat al-ʿarsh), awaiting what descends upon them of the command from the presence of Lordship (ḥaḍrat al-rubūbiyyah) — \"they do not disobey God in what He commands them, and they do what they are commanded\" (66:6). And He expressed these witnessed realities in the Qur'an, and it was said: {«وفي السماء رزقكم وما توعدون»} \"And in the heaven is your provision and what you are promised\" (51:22). And He expressed the waiting of the angels of the heavens for what descends upon them of decree and command, and it was said: \"He created seven heavens and of the earth the like of them; {«يتنزل الأمر بينهن لتعلموا أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما»} 'the command descends between them, that you may know that God is powerful over all things and that God encompasses all things in knowledge'\" (65:12). These are matters whose interpretation (taʾwīl) none knows except God and those firmly rooted in knowledge (al-rāsikhūn fī al-ʿilm). And Ibn Abbas, may God be pleased with them both, expressed the exclusivity of those firmly rooted in knowledge to sciences that the understandings of creatures cannot bear, when he recited the saying of the Exalted: {«يتنزل الأمر بينهن»} \"The command descends between them,\" and said: \"Were I to mention what I know of the meaning of this verse, you would stone me\" — and in another wording: \"You would say he is an unbeliever.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 990", "section_title_en": "On the Degrees of Proximity to God and the Hierarchy of Those Who Perfect Divine Wisdom", "section_index": 990, "anchors": "- Root: سير (s-y-r)\n  * Lisan / Ayn: \"السير: الذهاب والسفر، وسار يسير سيرا ومسيرا، والسيارة: الرفقة المسافرة\"\n  * Al-Raghib (Mufradat): \"السير: الانتقال من مكان إلى مكان، ويستعار للسلوك في الدين والطريقة\"\n  * Al-Zamakhshari (Asas): [Literal] \"سار القوم: مشوا\" — [Metaphorical] \"سار فيه السير: مضى في الأمر، وسار ذكره: انتشر، ومنه: سيرة فلان: طريقته\"\n- Root: مشي (m-sh-y)\n  * Lisan / Ayn: \"المشي: تردد الأركان على الأرض، والماشية: الإبل والغنم لانتقالها في المرعى\"\n  * Al-Raghib (Mufradat): \"المشي: الانتقال من مكان إلى مكان بإرادة، ويكنى به عن النميمة، وعن شرب المسهل\"\n  * Al-Zamakhshari (Asas): [Literal] \"مشيت وتمشيت، وهي حسنة المشية\" — [Metaphorical] \"مشى بطنه، وأمشاه الدواء، واستمشيت بالدواء، ومنه: مشت المرأة: كثرت أولادها\"\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: \"الخلق: التقدير، والخلق: الناس، والخليقة: الطبيعة، والخلق: السجية\"\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\"\n  * Al-Zamakhshari (Asas): [Literal] \"خلق الخراز الأديم: قدره قبل القطع\" — [Metaphorical] \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\"\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: \"النفس: الروح، والذات، والشيء النفيس\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتطلق على الذات، قال تعالى: {ويحذركم الله نفسه} فنفسه: ذاته\"\n  * Al-Zamakhshari (Asas): [Literal] \"شيء نفيس ومنفس\" — [Metaphorical] \"دفق نفسه أي دمه، وأصابته نفس: عين\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish exclusive attribution of actions to God versus creatures, as in \"إنما أنت مثل الصبي\" (You are only like a child), restricting the simile to the creature while preserving divine agency.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Patience and Gratitude'", "badge": "Du'a"}, {"arabic": "هارب فقد قال تعالى {قوا أنفسكم وأهليكم نارا} أمرنا أن نقيهم النار كما نقي أنفسنا والإنسان قد يعجز عن القيام بحق نفسه وإذا تزوج تضاعف عليه الحق وانضافت إلى نفسه نفس أخرى والنفس أمارة بالسوء إن كثرت عليها الحقوق كثر الأمر بالسوء غالبا ولذلك اعتذر بعضهم من التزويج وقال أنا مبتلي بنفسي وكيف أضيف إليها نفسا أخرى كما قيل لن يسع الفأرة جحرها .", "english": "It is related that one who flees from his dependents (ʿiyāl) is in the station of the runaway slave (al-ʿabd al-ābiq) — no prayer of his is accepted, nor any fasting, until he returns to them. And one who falls short in fulfilling their rights (ḥuqūq) — even while remaining present among them — is in the station of the fugitive. For God Most High has said: {«قوا أنفسكم وأهليكم نارا»} \"Guard yourselves and your families from a Fire\" [Q. 66:6]. We are commanded to shield them from the Fire just as we shield ourselves. Yet a man may well be incapable of fulfilling the right due upon him toward his own self — and when he marries, the obligation upon him is doubled, and to his own self (nafs) is joined another self. Now the self is ever commanding toward evil (al-nafs ammāratun bi'l-sūʾ) [Q. 12:53] — when rights multiply upon it, the command toward evil multiplies in like measure, generally speaking. For this reason, some among them excused themselves from marriage, saying: \"I am already afflicted with my own self — how then shall I add to it another self?\" As was said:", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 297", "section_title_en": "The Third Impediment to Marriage: Occupation of Heart by Family and Children, and the Weighing of Benefits Against Harms", "section_index": 297, "anchors": "- Root: ع-ي-ل (ʿ-y-l)\n  * Lisan / Ayn: Core meaning of dependence, those whom one must support (family/dependents); \"عَالَ\" signifies to burden oneself with maintenance of others.\n  * Al-Raghib (Mufradat): In theological context, ʿiyāl denotes those entrusted to one's care, whose maintenance is a religious obligation (nafaqah), linking worldly provision to eschatological accountability.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to actual dependents requiring material support; metaphorical (majāz) extension applies to spiritual \"dependents\" — the soul's inclinations that require governance.\n- Root: ش-غ-ل (sh-gh-l)\n  * Lisan / Ayn: To occupy, engross, divert; core sense of something that fills attention and prevents other concerns.\n  * Al-Raghib (Mufradat): In Kalam, shughl (occupation) is contrasted with tafarrugh (being free/unoccupied) — the latter being prerequisite for contemplation (tafakkur) and preparation for the afterlife.\n  * Al-Zamakhshari (Asas): Literal: physical occupation with tasks; Metaphorical: the heart's engrossment (ishtighāl al-qalb) with worldly concerns, which is the true impediment to spiritual devotion.\n- Root: ز-و-ج (z-w-j)\n  * Al-Raghib (Mufradat): Each of a pair; in marriage, the coupling of two souls multiplies obligations — the husband's self (nafs) is joined by another self requiring rights (ḥuqūq).\n  * Al-Zamakhshari (Asas): Literal: the marital pair; Metaphorical: tazāwuj of concerns — how worldly cares \"pair\" and multiply upon the heart through marriage.\n- Root: و-ز-ن (w-z-n)\n  * Lisan / Ayn: To weigh, measure, balance; the act of determining preponderance.\n  * Al-Raghib (Mufradat): In ethical judgment, mīzān (balance) is the instrument of equitable assessment — weighing spiritual benefit (manfaʿah dīniyyah) against harm (mafsadah).\n  * Al-Zamakhshari (Asas): Literal: physical weighing; Metaphorical: al-mīzān al-qisṭ (the just balance) — the rational faculty's discernment in weighing competing religious considerations.\n- Sibawayh Rule: Bāb al-ʿaṭf ʿalā al-sabab (Coordination on Causal Grounds) — The construction \"فإن انتفت في حقه الآفات واجتمعت الفوائد\" employs conditional coordination where the protasis (condition) governs multiple apodoses, requiring precise parsing of the logical relationship between the conditions and their consequent judgments.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Marriage'", "badge": "Du'a"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "فإنهم مجبولون على الطاعة لا يستطيعون له خلافا بل لا يعصون الله ما أمرهم ويفعلون ما يؤمرون وإنما يفترقان في شيء وهو أن الملائكة عليهم السلام عالمة بطاعتها وامتثالها والأجفان تطيع القلب في الانفتاح والإنطباق على سبيل التسخير ولا خبر لها من نفسها ومن طاعتها للقلب وإنما افتقر القلب إلى هذه الجنود من حيث افتقاره إلى المركب والزاد لسفره الذي لأجله خلق وهو السفر إلى الله سبحانه وقطع المنازل إلى لقائه فلأجله خلقت القلوب قال الله تعالى وما خلقت الجن والإنس إلا ليعبدون وإنما مركبه البدن وزاده العلم وإنما الأسباب التي توصله إلى الزاد وتمكن", "english": "God — Exalted is He — said: {«وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ»} (Q 74:31) — \"And none knows the armies of your Lord except Him.\" Thus, for God — Glorified is He — within hearts, spirits, and other realms, there are marshaled armies (junūd mujannadah) whose true reality and detailed enumeration none knows except Him alone. And we now shall indicate some of the armies of the heart — for it is that which pertains to our purpose.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 575", "section_title_en": "Exposition of the Armies of the Heart", "section_index": 575, "anchors": "- Root: جند (j-n-d)\n  * Lisan / Ayn: \"جند: العسكر، والأرض الغليظة التي فيها حجارة\" — the core meaning denotes both a gathered military host and rough, stony ground, implying hardness, strength, and collective force.\n  * Al-Raghib (Mufradat): \"يقال للعسكر الجند اعتبارا بالغلظة، من الجند، أي: الأرض الغليظة التي فيها حجارة ثم يقال لكل مجتمع جند\" — the term extends from physical ruggedness to any gathered collective serving a purpose, including spiritual hosts.\n  * Al-Zamakhshari (Asas): \"الأرواح جنود مجندة، والريح من جنود الله تعالى\" — used both literally (military hosts) and metaphorically (spiritual forces, natural phenomena as divine armies).\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant turning, flipping, and oscillation between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart's essence is its capacity for transformation and redirection.\n  * Al-Zamakhshari (Asas - Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — metaphorically, the heart is the seat of deliberation, discernment, and spiritual governance.\n- Root: نزل (n-z-l)\n  * Al-Raghib (Mufradat): \"النزول في الأصل هو انحطاط من علو\" — descent from a height; used for divine sending down of revelation and spiritual realities.\n  * Al-Zamakhshari (Asas - Majaz): \"نزل به مكروه، وأصابته نازلة من نوازل الدهر\" — metaphorically, events \"descend\" upon one; the heart is a station where divine armies \"descend\" or are stationed.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the exclusive attribution of knowledge of the divine armies to God alone through the restrictive particle \"إلا\" (except), establishing that full comprehension of these hosts belongs solely to the Creator.\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "في حبهم الدائم وشوقهم اللازم الذي به يسبحون الليل والنهار لا يفترون ولا يعصون الله ما أمرهم ويفعلون ما يؤمرون لاستنكف من نفسه ومن إظهار حبه وعلم قطعا أنه من أخس المحبين في مملكته وأن حبه أنقص من حب كل محب لله قال بعض الكاشفين من المحبين عبدت الله تعالى ثلاثين سنة بأعمال القلوب والجوارح على بذل المجهود واستفراغ الطاقة حتى ظننت أن لي عند الله شيئا فذكر أشياء من مكاشفات آيات السموات في قصة طويلة قال في آخرها فبلغت صفا من الملائكة بعدد جميع ما خلق الله من شيء فقلت من أنتم فقالوا نحن المحبون لله عز وجل نعبده ههنا منذ ثلثمائة ألف سنة ما خطر على قلوبنا قط سواه", "english": "It is related that a man saw something from one of the madmen that made him deem him foolish, and he reported that to Maʿrūf al-Karkhī — may Allah have mercy on him. He smiled, then said: \"O my brother, he has lovers, both young and old, both rational and mad. So this one you saw is among their madmen.\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1183", "section_title_en": "On the Concealment of Love and Its True Signs — Section 1183", "section_index": 1183, "anchors": "- Root: خفي (khafā)\n  * Lisan / Ayn: To be hidden, concealed, imperceptible to the senses.\n  * Al-Raghib (Mufradat): Al-Khafī is that which is not perceived by the senses; its theological nuance relates to Allah's knowledge of the unseen (ghayb) and the inner conscience (sirr).\n  * Al-Zamakhshari (Asas): Literal (haqīqah) refers to physical concealment; metaphorical (majāz) applies to the heart's hidden states, as in \"the secret\" (al-sirr) which only Allah perceives.\n- Root: حب (ḥubb)\n  * Lisan / Ayn: Core meaning: to love, to be steadfast upon something; also a jar (ḥubb) that holds water — implying that love is a vessel containing the lover's entire being.\n  * Al-Raghib (Mufradat): Al-Maḥabbah is the will directed toward what is perceived as agreeable; in theological terms, love of Allah is the soul's inclination toward Him due to His perfection, not due to benefit or harm.\n  * Al-Zamakhshari (Asas): Literal: inclination of the heart. Metaphorical: the bodily movements and stillness that testify to an inward state, as the physician's diagnosis of the lover's urine.\n- Root: وجد (wajd)\n  * Lisan / Ayn: To find; also intense emotion, ecstasy, or passionate yearning that overwhelms the lover.\n  * Al-Raghib (Mufradat): Al-Wajd is the arrival of a spiritual state (ḥāl) that dominates the heart, often leading to loss of self-control (ghashyah).\n  * Al-Zamakhshari (Asas): Literal: finding something lost. Metaphorical: the overpowering of the heart by love, such that the lover falls unconscious — as related of al-Sarī.\n- Sibawayh Rule: Rule of Interposition (al-Faṣl bayna al-Jār wa al-Majrūr) — The syntactic principle that a clause may be interrupted by an explanatory parenthetical without breaking grammatical cohesion, as seen in the narrative digressions (e.g., the story of the madman and al-Karkhī) that serve as illustrative asides within the main argument.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "8": [{"arabic": "فاصرفني عنه واصرفه عني واقدر لي الخير أينما كان إنك على كل شيء قدير (6) رواه جابر بن عبد الله قال كان رسول الله صلى الله عليه وسلم يعلمنا الاستخارة في الأمور كلها كما يعلمنا السورة من القرآن وقال صلى الله عليه وسلم إذا هم أحدكم بأمر فليصل ركعتين ثم ليسم الأمر ويدعو بما ذكرناه وقال بعض الحكماء من أعطي أربعا لم يمنع أربعا من أعطي الشكر لم يمنع المزيد ومن أعطي التوبة لم يمنع القبول ومن أعطي الاستخارة لم يمنع الخيرة ومن أعطي المشورة لم يمنع الصواب الثامنة صلاة الحاجة (7) فمن ضاق عليه الأمر ومسته حاجة في صلاح دينه ودن", "english": "**QUAD_ANCHORS:**\n- Root: خسف (kha-sa-fa)\n  * Lisan / Ayn: [Core linguistic root meaning] To swallow up, to cause to sink into the earth; the darkening of the sun or moon (khusūf for the moon, kusūf for the sun, though both are used interchangeably)\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The eclipse as a divine sign (āyah) — not a natural phenomenon merely, but a portent summoning the servant to remembrance of God\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: the celestial bodies being veiled/obscured; Metaphorical: the veiling of hearts from divine remembrance\n- Root: سقى (sa-qa)\n  * Lisan / Ayn: [Core linguistic root meaning] To give to drink, to water; istisqā' — the act of seeking rain/water from God\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The prayer for rain as a communal acknowledgment of absolute dependence upon divine providence\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: requesting water; Metaphorical: seeking divine mercy and abundance\n- Root: جنز (ja-na-za)\n  * Lisan / Ayn: [Core linguistic root meaning] The bier/corpse; janāzah — the funeral\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The funeral prayer as a collective obligation (farḍ kifāyah) — the living standing as intercessors for the dead\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: the bier upon which the dead is carried; Metaphorical: the entire funeral rite as a reminder of one's own mortality\n- Root: حيي (ḥa-ya)\n  * Lisan / Ayn: [Core linguistic root meaning] To live; taḥiyyah — greeting, salutation; the \"greeting of the mosque\" (taḥiyyat al-masjid)\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The greeting of the mosque as an act of reverence for the sacred space — a spiritual courtesy toward the house of God\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: greeting a person; Metaphorical: greeting the mosque through prayer as one greets a host upon entering his abode\n- Root: خير (kha-ya-ra)\n  * Lisan / Ayn: [Core linguistic root meaning] To choose; istikhārah — seeking divine choice/guidance\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The prayer of seeking guidance as the servant's acknowledgment that only God knows the unseen consequences of affairs\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: asking someone to choose for you; Metaphorical: delegating one's affairs to divine providence while abandoning personal preference\n- Root: ركع (ra-ka-ʿa)\n  * Lisan / Ayn: [Core linguistic root meaning] To bow; rukūʿ — the bowing posture in prayer\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] Bowing as physical expression of humility and submission before divine majesty\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: the bodily posture of inclination; Metaphorical: the spiritual posture of humble submission — \"Sheikhs bowing with age\" and \"camels bowing with exhaustion\"\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional constructions (idhā... fa...) governing the temporal and circumstantial clauses for when these prayers become incumbent or recommended", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 164", "section_title_en": "Section 164", "section_index": 164, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Hajj'", "badge": "Insight"}, {"arabic": "المعرفة نور للعارفين بعد الموت يسعى نورهم بين أيديهم وبأيمانهم يقولون ربنا أتمم لنا نورنا أي تكون هذه المعرفة رأس مال يوصل إلى كشف ما لم ينكشف في الدنيا كما أن من معه سراج خفي فإنه يجوز أن يصير ذلك سببا لزيادة النور بسراج آخر يقتبس منه فيكمل النور الخفي على سبيل الاستتمام ومن ليس معه أصل السراج فلا مطمع له في ذلك فمن ليس معه أصل معرفة الله تعالى لم يكن له مطمع في هذا النور فيبقى كمن مثله في الظلمات ليس بخارج منها بل كظلمات في بحر لجى يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض فإذن لا سعادة إلا في معرفة الله تعالى وأما ما", "english": "All of these divisions are comprised within knowledge of God — of what is necessary for Him, what is impossible in His attributes, and what is permissible in His acts. Thus, knowledge of God — exalted be He — of His attributes, His acts, His wisdom in the dominion (malakūt) of the heavens and the earth, the ordering of this world and the Hereafter, and what pertains to that — this is the true perfection that draws near to God — exalted be He — the one who is described by it, and it remains a perfection for the soul after death. And this knowledge becomes a light for the knowers after death: {their light running before them and on their right hands, they saying: \"Our Lord, perfect for us our light\"} {«ربنا أتمم لنا نورنا»} — that is, this knowledge is the capital that leads to the disclosure of what was not disclosed in this world. Just as one who carries a hidden lamp — it is possible that this becomes the cause of increased light by another lamp from which he kindles, so that the hidden light is completed by way of supplementation — while one who has no lamp at all has no hope of that. So too, one who has no root of knowledge of God — exalted be He — has no hope in that light; he remains like one whose similitude is in darkness, not emerging from it — nay, {like darknesses in a vast deep sea, covered by wave above wave, above which is cloud: darknesses, one above another} {«كظلمات في بحر لجي يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض»}. Therefore, there is no happiness save in knowledge of God — exalted be He.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 799", "section_title_en": "The True Perfection of Knowledge and Its Degrees of Proximity to God", "section_index": 799, "anchors": "- Root: علم (ʿ-L-M)\n  * Lisan / Ayn: Core sense of \"knowing\" as the impression of a thing's reality upon the mind; the root also carries the sense of a \"mark\" or \"sign\" by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): Knowledge (ʿilm) is \"the apprehension of a thing by its true reality\" — divided into apprehension of the essence of a thing, and judgment upon a thing regarding what is or is not predicated of it. It is the broadest epistemic term, applicable to God and creatures alike.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage: \"He is a sign (ʿalam) of knowledge\" — knowledge is that which marks and distinguishes. The metaphorical (majāz) extension: \"I knew of your news\" = \"I perceived it\" — indicating that knowledge as proximity to God is not mere information but a transformative mark upon the soul.\n- Root: عرف (ʿ-R-F)\n  * Lisan / Ayn: Recognition through traces and effects; the root denotes \"coming to know by way of discernment of distinguishing features.\"\n  * Al-Raghib (Mufradat): Maʿrifah is \"apprehension of a thing through reflection and deliberation upon its effect\" — more specific than ʿilm. It is the term used for the creature's knowledge of God, since it proceeds from contemplating His works, not from grasping His essence.\n  * Al-Zamakhshari (Asas): Literal: \"I will make you recognize (la-ʾuʿarrifanna-ka) what you did\" = \"I will requite you for it.\" This underscores that maʿrifah is knowledge that returns upon the knower as a state of recompense or illumination.\n- Root: نور (N-W-R)\n  * Lisan / Ayn: Light as that which renders visible; the root also yields \"beacon\" (manār) — a landmark set upon a path for guidance.\n  * Al-Raghib (Mufradat): \"Light is the diffused radiance that aids vision\" — of two kinds: the sensory (perceived by the eye) and the intellectual (perceived by the inner eye of insight), the latter being \"the light of the intellect and the light of the Qur'an.\"\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"The matter became luminous (nāra)\" = \"it became clear.\" Light is thus the very clarity of knowledge that guides the knower through the darkness of ignorance.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the use of \"إنما\" (innamā) to restrict perfection exclusively to knowledge of God, and the conditional-connective structure (fa-innahu, fa-kullamā) that links degrees of knowledge to degrees of proximity.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "وقوله سبحانه وتعالى {نورهم يسعى بين أيديهم وبأيمانهم يقولون ربنا أتمم لنا نورنا} محتمل لهذا المعنى وهو أن ينعم عليه بإتمام النور مهما تزود من الدنيا أصل النور ويحتمل أن يكون المراد به إتمام النور في غير ما استنار في الدنيا استنارة محتاجة إلى مزيد الاستكمال والإشراق فيكون هو المراد بتمامه وقوله تعالى {انظرونا نقتبس من نوركم قيل ارجعوا وراءكم فالتمسوا نورا} يدل على أن الأنوار لابد وأن يتزود أصلها في الدنيا ثم يزداد في الآخرة إشراقا فأما أن يتجدد نور فلا والحكم في هذا برجم الظنون مخطر ولم ينكشف لنا فيه بعد ما يوثق به فنسأل الله ت", "english": "And His saying, Glorified and Exalted is He: {نُورُهُمْ يَسْعَىٰ بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا} [\"Their light will run before them and on their right hands; they will say, 'Our Lord, perfect for us our light'\"] (Q 66:8) — this is susceptible to the meaning that He bestows upon them the perfection of light whenever they had provisioned from the world the origin of light. And it is also susceptible that the intended meaning is the perfection of light in what was not illuminated in this world with an illumination that stands in need of further completion and radiance — so that this is what is meant by its perfection. And His saying, Exalted is He: {انْظُرُونَا نَقْتَبِسْ مِنْ نُورِكُمْ قِيلَ ارْجِعُوا وَرَاءَكُمْ فَالْتَمِسُوا نُورًا} [\"Look upon us so we may borrow from your light. It will be said, 'Return behind you and seek light'\"] (Q 57:13) — this indicates that the lights must have their origin provisioned in this world, then in the Hereafter they increase in radiance. But as for a light being newly generated [there without prior origin] — no. And the judgment in this matter is a venture of conjecture, perilous, and there has not been unveiled to us therein anything trustworthy. So we ask God, Exalted is He, to increase us in knowledge and right guidance, and to show us the truth as truth.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1171", "section_title_en": "On the Ever-Replenished Delights of the Hereafter and the Yearning (Shawq) for the Divine Vision", "section_index": 1171, "anchors": "- Root: لذذ (Ladhdhah — Pleasure/Delight)\n  * Lisan / Ayn: Core root denotes the sweetness of taste and the experience of sensory gratification; its verbal form (ladhdha) implies direct apprehension of what is agreeable.\n  * Al-Raghib (Mufradat): In theological usage, true pleasure (al-ladhdhah al-ʿuẓmā) is the soul's perception of what is conformable to its nature — the highest being the vision of God (ru'yat Allāh) and the bliss of proximity to Him.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for sensory delight; metaphorical (majāz) for intellectual and spiritual joys, where the \"taste\" is of gnosis (maʿrifah), not of the palate.\n\n- Root: شوق (Shawq — Yearning/Longing)\n  * Lisan / Ayn: The root signifies the soul's restless inclination toward a beloved; the \"spurring on\" of the heart toward reunion.\n  * Al-Raghib (Mufradat): Shawq is the movement of the heart toward its ultimate Beloved (al-maḥbūb al-aʿlā) — a yearning that persists even in bliss, for the unveiling (kashf) of ever-greater divine self-disclosure.\n  * Al-Zamakhshari (Asas): Literal for human longing; metaphorical for the divine \"yearning\" attributed to God (as in the sacred reports), which is an expression of His loving acceptance and bestowal of grace, not an emotional lack.\n\n- Root: نور (Nūr — Light)\n  * Lisan / Ayn: Core root denotes illumination, radiance, and that by which one sees and is seen.\n  * Al-Raghib (Mufradat): Twofold: sensory light (of the sun, stars) and intellectual/spiritual light (of reason, faith, and the Qur'an). The \"light of the believers\" on the Day of Resurrection is the latter — the radiance of their faith and works in the world.\n  * Al-Zamakhshari (Asas): Literal for physical luminosity; metaphorical (majāz) for guidance, clarity, and the illuminating power of divine truth in the heart.\n\n- Root: قلب (Qalb — Heart)\n  * Lisan / Ayn: Core root means to turn over, to flip, to transform — hence the heart is so-named for its constant fluctuation (taqallub) of states.\n  * Al-Raghib (Mufradat): The heart is the seat of perception and understanding (al-ʿaql wa al-fahm); it is the subtle divine reality (al-laṭīfah al-rabbāniyyah) that apprehends God, not the physical organ.\n  * Al-Zamakhshari (Asas): Literal for the physical organ; metaphorical for the spiritual faculty of cognition and volition that turns toward or away from God.\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the precise scope of statements like \"the pleasure of what is renewed is only a distraction from the ache of yearning,\" ensuring the predicate is confined to the subject without overextension.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "جهنم وهي حظ المؤمن من النار (2) وروي في تفسير قوله تعالى {يوم لا يخزي الله النبي والذين آمنوا معه} أن الله تعالى أوحى إلى نبيه صلى الله عليه وسلم إني أجعل حساب أمتك إليك قال لا يارب أنت أرحم بهم مني فقال إذن لا نخزيك فيهم (3) وروي عن أنس إن رسول الله صلى الله عليه وسلم سأل ربه في ذنوب أمته فقال يا رب اجعل حسابهم إلي لئلا يطلع على مساويهم غيري فأوحى الله تعالى إليه هم أمتك وهم عبادي وأنا أرحم بهم منك ولا أجعل حسابهم إلى غيري لئلا تنظر إلى مساويهم أنت ولا غيرك (4) وقال صلى الله عليه وسلم حياتي خير لكم وموتي خيرك لكم أما حياتي فأسن لكم السنن وأشرع لكم الشرائ", "english": "So it was said to him: \"And what is in it of hope?\" He said: \"This world, all of it, is little, and a man's provision from it is little, and his religion is little in comparison to his provision. So look at how God Most High sent down in it the longest verse, to guide His servant to the path of caution in preserving his wealth — so how could He not preserve his religion, which has no substitute for him?\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1033", "section_title_en": "The Book of Hope (Kitāb al-Rajā') — Section 1033: The Second Art — Surveying the Verses and Reports Concerning Hope", "section_index": 1033, "anchors": "- Root: وجود (w-j-d)\n  * Lisan / Ayn: Core meaning of \"finding\" and \"existence\"; here in the sense of what is present and available.\n  * Al-Raghib (Mufradat): Existence as that which is found and realized; in theological context, the given order of creation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense of \"being found\"; metaphorical (majāz) extension to the entirety of created things.\n- Root: رجا (r-j-w)\n  * Lisan / Ayn: To hope, to expect with desire; the opposite of despair (ya's).\n  * Al-Raghib (Mufradat): Hope as a theological virtue — the heart's expectation of divine mercy, balanced against fear (khawf).\n  * Al-Zamakhshari (Asas): Literal: expectation of a desired outcome; metaphorical: the soul's reliance on divine generosity.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: To cover, to shield, to pardon; the root implies veiling the fault.\n  * Al-Raghib (Mufradat): Divine forgiveness as the covering of sins and the effacing of their consequence.\n  * Al-Zamakhshari (Asas): Literal: covering; metaphorical: God's remission of punishment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to emphasize exclusive attributes of divine mercy and forgiveness.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Fear and Hope'", "badge": "Afterlife"}], "9": [{"arabic": "وقال لنبيه صلى الله عليه وسلم {جاهد الكفار والمنافقين واغلظ عليهم} الآية وإنما الغلظة والشدة من آثار قوة الحمية وهو الغضب وأما الإفراط فهو أن تغلب هذه الصفة حتى تخرج عن سياسة العقل والدين وطاعته ولا يبقى للمرء معها بصيرة ونظر وفكرة ولا اختيار بل يصير في صورة المضطر وسبب غلبته أمور غريزية وأمور اعتيادية فرب إنسان هو بالفطرة مستعد لسرعة الغضب حتى كأن صورته في الفطرة صورة غضبان ويعين على ذلك حرارة مزاج القلب لأن الغضب من النار (1) كما قال صلى الله عليه وسلم وإنما برودة المزاج تطفئه وتكسر سورته وأما الأسباب الاعتياد", "english": "As for deficiency: it is the loss of this power or its weakness. This is blameworthy, and it is of such a one that it is said: \"He has no protective zeal (ḥamiyyah).\" For this reason al-Shāfiʿī — may God have mercy on him — said: \"Whoever is provoked to anger and does not become angry is a donkey.\" Whoever loses the power of anger and protective zeal entirely is utterly deficient. God — exalted be He — described the Companions of the Prophet — peace be upon him — with severity and protective zeal, saying: {«أشداء على الكفار رحماء بينهم»} \"Severe against the disbelievers, merciful among themselves\" (Q 48:29). And He said to His Prophet — peace be upon him: {«جاهد الكفار والمنافقين واغلظ عليهم»} \"Strive against the disbelievers and the hypocrites and be harsh with them\" (Q 9:73) — the verse. Harshness and severity are but effects of the power of protective zeal, which is anger.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 703", "section_title_en": "The Reality of Anger (Ghaḍab) and Its Degrees — Book 21, Section 703", "section_index": 703, "anchors": "- Root: غضب (Ghaḍab)\n  * Lisan / Ayn: Core root denotes anger, rage, fury; the surge of blood in the heart seeking vengeance.\n  * Al-Raghib (Mufradat): \"الغضب: ثوران دم القلب إرادة الانتقام\" — when attributed to God, it means solely His retribution, not an emotional state.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"غضبت لفلان\" (anger for the living); Metaphorical (majāz): \"غضبت به\" (anger over the dead), and the poetic extension to inanimate objects like fire or reins.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: Self, soul, spirit; the vital principle.\n  * Al-Raghib (Mufradat): The soul as the seat of blameworthy traits when unrestrained; its purification is the goal of spiritual struggle.\n  * Al-Zamakhshari (Asas): Literal: the self; Metaphorical: \"دفق نفسه\" (spilled his blood/life).\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; to turn over, to flip.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant fluctuation and turning.\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of intellect and spiritual perception, which anger overturns and blinds.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — Used to distinguish the three degrees of anger (deficiency, excess, moderation) as mutually exclusive categories.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "10": [{"arabic": "وقال تعالى {حمالة الحطب} قيل إنها كانت نمامة حمالة للحديث وقال تعالى {فخانتاهما فلم يغنيا عنهما من الله شيئا} قيل كانت امرأة لوط تخبر بالضيفان وامرأة نوح تخبر أنه مجنون وقد قال صلى الله عليه وسلم لا يدخل الجنة نمام (1) وفي حديث آخر لا يدخل الجنة قتات والقتات هو النمام وقال أبو هريرة قال رسول الله صلى الله عليه وسلم أحبكم إلى الله أحاسنكم أخلاقا الموطئون أكنافا الذين يألفون ويؤلفون وإن أبغضكم إلى الله المشاءون بالنميمة المفرقون بين الإخوان الملتمسون للبرءاء العثرات (2) وقال صلى الله عليه وسلم إلا أخبركم بشراركم قالوا بلى قال المشاءون بالنميمة المف", "english": "Allah Most High has said: {«هَمَّازٍ مَشَّاءٍ بِنَمِيمٍ»} [“A slanderer, a walker with talebearing”] (Al-Qalam: 11). Then He said: {«عُتُلٍّ بَعْدَ ذَلِكَ زَنِيمٍ»} [“Cruel, moreover, and an intruder (zanīm)”] (Al-Qalam: 13). ʿAbd Allāh ibn al-Mubārak said: “Al-zanīm is the child of fornication (walad al-zinā) who does not conceal speech.” He indicated by this that whoever does not conceal speech and walks with talebearing is evidence that he is a child of fornication — this being deduced (istinbāṭan) from the saying of Allah, Mighty and Majestic: {«عُتُلٍّ بَعْدَ ذَلِكَ زَنِيمٍ»}. And al-zanīm is the intruder (al-daʿīy) [one falsely attached to a lineage].", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 691", "section_title_en": "The Sixteenth Affliction: Namīmah (Malicious Talebearing)", "section_index": 691, "anchors": "- Root: نمم (n-m-m)\n  * Lisan / Ayn: Core meaning of \"to spread a report,\" \"to carry tales,\" \"to divulge what should remain concealed.\" Al-Ayn notes the root's connection to intensification and penetration of heat, implying the corrosive, penetrating effect of talebearing.\n  * Al-Raghib (Mufradat): Theological nuance: The talebearer (namūm) is one who transmits speech with the intent to corrupt and sever bonds of brotherhood, aligning with the Quranic condemnation of the \"mushā' bi-namīm\" (walker with slander).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"He is a talebearer (namūm) between people, walking with slanders (namā'im).\" Metaphorical (Majaz): \"The scent spread over musk (namat 'alā al-misk rā'iḥatuhā)\" — indicating that namīmah is the \"spreading\" of that which harms, just as fragrance spreads beneficially; the metaphor underscores the talebearer's deliberate dissemination of destructive words.\n- Root: زنم (z-n-m)\n  * Lisan / Ayn: Core meaning: an extra, superfluous appendage, like the wattle (zanamatān) hanging from a goat's ear or throat — something attached but not truly part of the whole.\n  * Al-Raghib (Mufradat): \"Al-Zanīm and al-muzannam: the one who is superfluous to a people, not being of them, likened to the two wattles of a sheep... i.e., one who claims affiliation to a people while being detached from them.\" Applied to the bastard (walad zinā) who is \"attached\" to a lineage not his own.\n  * Al-Zamakhshari (Asas): Literal: \"He has a goat with wattles (muzannamah).\" Metaphorical: \"In so-and-so is a zanamah of good and a zanamah of evil: a mark/sign. And so-and-so is zanīm and muzannam: an intruder (da'īy) attached to those not of him.\"\n- Root: قتت (q-t-t)\n  * Lisan / Ayn: Core meaning: to seek out and gather information stealthily, to eavesdrop and then carry reports — the \"qattāt\" is one who listens to others' private speech and transmits it to cause harm.\n  * Al-Raghib (Mufradat): The qattāt is synonymous with the namūm in the prophetic hadith; both denote the one who carries destructive speech between parties.\n  * Al-Zamakhshari (Asas): Literal: The qattāt is the one who \"tracks\" (yaquttu) news, i.e., investigates and then spreads it. Metaphorical: The term extends to any medium of harmful disclosure — speech, writing, gesture, or sign.\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the definitional statement \"innamā yuṭlaqu...\": the restriction confines the common application of namīmah to a specific case while the subsequent expansion (wa-laysat al-namīmah mukhtaṣṣah bihi) negates restriction, establishing the full technical definition through contrastive predication.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Anger and Hatred'", "badge": "Ethics"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 3033], [2, 3033, 4932], [3, 4932, 5447], [4, 5447, 6696], [5, 6696, 8025], [6, 8025, 9068], [7, 9068, 10085], [8, 10085, 10600], [9, 10600, 12106], [10, 12106, 13625], [11, 13625, 15324], [12, 15324, 16727], [13, 16727, 17911], [14, 17911, 19289]], "2": [[1, 400, 1039], [2, 1039, 1900], [3, 1900, 2930], [4, 2930, 3712], [5, 3712, 4925], [6, 4925, 6829], [7, 6829, 8250], [8, 8250, 10310], [9, 10310, 11327], [10, 11327, 12892], [11, 12892, 14430]], "3": [[1, 400, 1470], [2, 1470, 2610], [3, 2610, 4686], [4, 4686, 5981], [5, 5981, 6966], [6, 6966, 8796], [7, 8796, 10570], [8, 10570, 12273], [9, 12273, 13667], [10, 13667, 14202], [11, 14202, 16116], [12, 16116, 17228], [13, 17228, 18523], [14, 18523, 19635], [15, 19635, 20874], [16, 20874, 22620], [17, 22620, 23239], [18, 23239, 24224], [19, 24224, 25927], [20, 25927, 27743], [21, 27743, 28278], [22, 28278, 29629], [23, 29629, 30192], [24, 30192, 31712], [25, 31712, 32878], [26, 32878, 33948], [27, 33948, 35764], [28, 35764, 37453], [29, 37453, 39116]], "4": [[1, 400, 1031], [2, 1031, 3516], [3, 3516, 4578], [4, 4578, 5711], [5, 5711, 6701], [6, 6701, 7677], [7, 7677, 10058], [8, 10058, 11120], [9, 11120, 13008], [10, 13008, 14328], [11, 14328, 15662], [12, 15662, 16795], [13, 16795, 17484], [14, 17484, 19435], [15, 19435, 21515], [16, 21515, 23145], [17, 23145, 25469], [18, 25469, 28195], [19, 28195, 29113], [20, 29113, 30192], [21, 30192, 31540]], "5": [[1, 400, 2230], [2, 2230, 4211], [3, 4211, 5067], [4, 5067, 8064], [5, 8064, 8920], [6, 8920, 11680], [7, 11680, 14483], [8, 14483, 16507], [9, 16507, 19193], [10, 19193, 21412], [11, 21412, 24273], [12, 24273, 26422], [13, 26422, 28952], [14, 28952, 31101], [15, 31101, 33795], [16, 33795, 36257], [17, 36257, 39821]], "6": [[1, 400, 3505], [2, 3505, 5221], [3, 5221, 7498], [4, 7498, 9532], [5, 9532, 11445], [6, 11445, 13904], [7, 13904, 15483], [8, 15483, 17821], [9, 17821, 19779], [10, 19779, 22299], [11, 22299, 24182], [12, 24182, 26216], [13, 26216, 27734], [14, 27734, 29191], [15, 29191, 30208], [16, 30208, 32182], [17, 32182, 33381], [18, 33381, 34948], [19, 34948, 36497], [20, 36497, 39139], [21, 39139, 39928], [22, 39928, 42146]], "7": [[1, 400, 3182], [2, 3182, 4719], [3, 4719, 6379], [4, 6379, 7086], [5, 7086, 9371], [6, 9371, 10813], [7, 10813, 12513], [8, 12513, 14077], [9, 14077, 14784], [10, 14784, 15872], [11, 15872, 17696]], "8": [[1, 400, 3753], [2, 3753, 5606], [3, 5606, 8065], [4, 8065, 11016], [5, 11016, 12229], [6, 12229, 13524], [7, 13524, 14934], [8, 14934, 17541], [9, 17541, 19082], [10, 19082, 20640], [11, 20640, 21361], [12, 21361, 23082], [13, 23082, 24459], [14, 24459, 27287], [15, 27287, 30025], [16, 30025, 31966], [17, 31966, 33524], [18, 33524, 34180], [19, 34180, 36016], [20, 36016, 37964], [21, 37964, 39276], [22, 39276, 40129], [23, 40129, 41801], [24, 41801, 43096], [25, 43096, 45514], [26, 45514, 47859], [27, 47859, 50318], [28, 50318, 51335], [29, 51335, 53106], [30, 53