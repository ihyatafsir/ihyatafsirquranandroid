, "narration": "warsh"}, {"surah": 25, "ayah": 70, "text": "اِلَّا مَن تَابَ وَءَامَنَ وَعَمِلَ عَمَلاࣰ صَٰلِحاࣰ فَأُوْلَٰٓئِكَ يُبَدِّلُ اُ۬للَّهُ سَيِّـَٔاتِهِمْ حَسَنَٰتࣲۖ وَكَانَ اَ۬للَّهُ غَفُوراࣰ رَّحِيماࣰۖ", "words": [{"id": 1, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "تَابَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَءَامَنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعَمِلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَمَلاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "صَٰلِحاࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُبَدِّلُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَيِّـَٔاتِهِمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "حَسَنَٰتࣲۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَكَانَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 15, "arabic": "غَفُوراࣰ", "translit": "", "root": ""}, {"id": 16, "arabic": "رَّحِيماࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 71, "text": "وَمَن تَابَ وَعَمِلَ صَٰلِحاࣰ فَإِنَّهُۥ يَتُوبُ إِلَي اَ۬للَّهِ مَتَاباࣰۖ", "words": [{"id": 1, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 2, "arabic": "تَابَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَعَمِلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "صَٰلِحاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَتُوبُ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَتَاباࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 72, "text": "وَالذِينَ لَا يَشْهَدُونَ ا