{"surah": 25, "ayah": 7, "text": "وَقَالُواْ مَالِ هَٰذَا اَ۬لرَّسُولِ يَاكُلُ اُ۬لطَّعَامَ وَيَمْشِے فِے اِ۬لَاسْوَاقِ لَوْلَآ أُنزِلَ إِلَيْهِ مَلَكࣱ فَيَكُونَ مَعَهُۥ نَذِيراً", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَالِ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لرَّسُولِ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَاكُلُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لطَّعَامَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَيَمْشِے", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لَاسْوَاقِ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَوْلَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أُنزِلَ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَلَكࣱ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَيَكُونَ", "translit": "", "root": ""}, {"id": 15, "arabic": "مَعَهُۥ", "translit": "", "root": ""}, {"id": 16, "arabic": "نَذِيراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 8, "text": "اَوْ يُلْق۪يٰٓ إِلَيْهِ كَنزٌ اَوْ تَكُونُ لَهُۥ جَنَّةࣱ يَاكُلُ مِنْهَاۖ وَقَالَ اَ۬لظَّٰلِمُونَ إِن تَتَّبِعُونَ إِلَّا رَجُلاࣰ مَّسْحُوراًۖ", "words": [{"id": 1, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُلْق۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَنزٌ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَكُونُ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "جَنَّةࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَاكُلُ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنْهَاۖ", "translit": "", "root": ""}, {"id": 