oot": ""}, {"id": 12, "arabic": "مِن", "translit": "", "root": ""}, {"id": 13, "arabic": "تَحْتِهَا", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لَانْهَٰرُ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَيَجْعَل", "translit": "", "root": ""}, {"id": 16, "arabic": "لَّكَ", "translit": "", "root": ""}, {"id": 17, "arabic": "قُصُوراَۢۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 11, "text": "بَلْ كَذَّبُواْ بِالسَّاعَةِۖ وَأَعْتَدْنَا لِمَن كَذَّبَ بِالسَّاعَةِ سَعِيراً", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَّبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالسَّاعَةِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَعْتَدْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لِمَن", "translit": "", "root": ""}, {"id": 6, "arabic": "كَذَّبَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالسَّاعَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "سَعِيراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 12, "text": "اِذَا رَأَتْهُم مِّن مَّكَانِۢ بَعِيدࣲ سَمِعُواْ لَهَا تَغَيُّظاࣰ وَزَفِيراࣰۖ", "words": [{"id": 1, "arabic": "اِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَأَتْهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّكَانِۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَعِيدࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "سَمِعُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَغَيُّظاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَزَفِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 13, "text": "وَإِذَآ أُلْقُواْ مِنْهَا مَكَاناࣰ ضَيِّقاࣰ مُّقَرَّنِينَ دَعَوْاْ هُنَالِكَ ثُبُوراࣰۖ", "words": [{"id": 1, "arabic": "وَإِذَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أُلْقُواْ", "translit": "