{"surah": 25, "verses": [{"ayah": 1, "text": "تَبَارَكَ ٱلَّذِى نَزَّلَ ٱلْفُرْقَانَ عَلَىٰ عَبْدِهِۦ لِيَكُونَ لِلْعَٰلَمِينَ نَذِيرًا ", "translation": "Blessed is He who sent down the Criterion upon His Servant that he may be to the worlds a warner -", "words": [{"id": 1, "arabic": "تَبَارَكَ", "translit": "َkَrāَbَt", "root": "برك"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 4, "arabic": "ٱلْفُرْقَانَ", "translit": "َnāَqْrُfْlٱ", "root": "فرق"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "عَبْدِهِۦ", "translit": "ۦِhِdْbَʿع", "root": "عبد"}, {"id": 7, "arabic": "لِيَكُونَ", "translit": "َnwُkَyِl", "root": "كون"}, {"id": 8, "arabic": "لِلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlِl", "root": "علم"}, {"id": 9, "arabic": "نَذِيرًا", "translit": "āًryِhdَn", "root": "نذر"}], "hasIhya": false}, {"ayah": 2, "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَلَمْ يَتَّخِذْ وَلَدًا وَلَمْ يَكُن لَّهُۥ شَرِيكٌ فِى ٱلْمُلْكِ وَخَلَقَ كُلَّ شَىْءٍ فَقَدَّرَهُۥ تَقْدِيرًا ", "translation": "He to whom belongs the dominion of the heavens and the earth and who has not taken a son and has not had a partner in dominion and has created each thing and determined it with [precise] determination.", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 7, "arabic": "يَتَّخِذْ", "translit": "ْhdِhkَّtَy", "root": "اخذ"}, {"id": 8, "arabic": "وَلَدًا", "translit": "āًdَlَw", "root": "ولد"}, {"id": 9, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 10, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 11, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 12, "arabic": "شَرِيكٌ", "translit": "ٌkyِrَhs", "root": "شرك"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ٱلْمُلْكِ", "translit": "ِkْlُmْlٱ", "root": "ملك"}, {"id": 15, "arabic": "وَخَلَقَ", "translit": "َqَlَhkَw", "root": "خلق"}, {"id": 16, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 17, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 18, "arabic": "فَقَدَّرَهُۥ", "translit": "ۥُhَrَّdَqَf", "root": "قدر"}, {"id": 19, "arabic": "تَقْدِيرًا", "translit": "āًryِdْqَt", "root": "قدر"}], "hasIhya": false}, {"ayah": 3, "text": "وَٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةً لَّا يَخْلُقُونَ شَيْـًٔا وَهُمْ يُخْلَقُونَ وَلَا يَمْلِكُونَ لِأَنفُسِهِمْ ضَرًّا وَلَا نَفْعًا وَلَا يَمْلِكُونَ مَوْتًا وَلَا حَيَوٰةً وَلَا نُشُورًا ", "translation": "But they have taken besides Him gods which create nothing, while they are created, and possess not for themselves any harm or benefit and possess not [power to cause] death or life or resurrection.", "words": [{"id": 1, "arabic": "وَٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱَw", "root": "اخذ"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 4, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 5, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 6, "arabic": "يَخْلُقُونَ", "translit": "َnwُqُlْhkَy", "root": "خلق"}, {"id": 7, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "يُخْلَقُونَ", "translit": "َnwُqَlْhkُy", "root": "خلق"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "يَمْلِكُونَ", "translit": "َnwُkِlْmَy", "root": "ملك"}, {"id": 12, "arabic": "لِأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾِl", "root": "نفس"}, {"id": 13, "arabic": "ضَرًّا", "translit": "āًّrَḍ", "root": "ضرر"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "نَفْعًا", "translit": "āًʿعْfَn", "root": "نفع"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "يَمْلِكُونَ", "translit": "َnwُkِlْmَy", "root": "ملك"}, {"id": 18, "arabic": "مَوْتًا", "translit": "āًtْwَm", "root": "موت"}, {"id": 19, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 20, "arabic": "حَيَوٰةً", "translit": "ًẗٰwَyَḥ", "root": "حيي"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "نُشُورًا", "translit": "āًrwُhsُn", "root": "نشر"}], "hasIhya": true}, {"ayah": 4, "text": "وَقَالَ ٱلَّذِينَ كَفَرُوٓا۟ إِنْ هَٰذَآ إِلَّآ إِفْكٌ ٱفْتَرَىٰهُ وَأَعَانَهُۥ عَلَيْهِ قَوْمٌ ءَاخَرُونَۖ فَقَدْ جَآءُو ظُلْمًا وَزُورًا ", "translation": "And those who disbelieve say, \"This [Qur’ān] is not except a falsehood he invented, and another people assisted him in it.\" But they have committed an injustice and a lie.", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 5, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 6, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 7, "arabic": "إِفْكٌ", "translit": "ٌkْfِiʾ", "root": "افك"}, {"id": 8, "arabic": "ٱفْتَرَىٰهُ", "translit": "ُhٰàَrَtْfٱ", "root": "فري"}, {"id": 9, "arabic": "وَأَعَانَهُۥ", "translit": "ۥُhَnāَʿعَaʾَw", "root": "عون"}, {"id": 10, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 12, "arabic": "ءَاخَرُونَ", "translit": "َnwُrَhkāَء", "root": "اخر"}, {"id": 13, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 14, "arabic": "جَآءُو", "translit": "wُءٓāَjg", "root": "جيا"}, {"id": 15, "arabic": "ظُلْمًا", "translit": "āًmْlُẓ", "root": "ظلم"}, {"id": 16, "arabic": "وَزُورًا", "translit": "āًrwُzَw", "root": "زور"}], "hasIhya": false}, {"ayah": 5, "text": "وَقَالُوٓا۟ أَسَٰطِيرُ ٱلْأَوَّلِينَ ٱكْتَتَبَهَا فَهِىَ تُمْلَىٰ عَلَيْهِ بُكْرَةً وَأَصِيلًا ", "translation": "And they say, \"Legends of the former peoples which he has written down, and they are dictated to him morning and afternoon.\"", "words": [{"id": 1, "arabic": "وَقَالُوٓا۟", "translit": "۟āٓwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "أَسَٰطِيرُ", "translit": "ُryِṭَٰsَaʾ", "root": "سطر"}, {"id": 3, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}, {"id": 4, "arabic": "ٱكْتَتَبَهَا", "translit": "āَhَbَtَtْkٱ", "root": "كتب"}, {"id": 5, "arabic": "فَهِىَ", "translit": "َàِhَf", "root": ""}, {"id": 6, "arabic": "تُمْلَىٰ", "translit": "ٰàَlْmُt", "root": "ملو"}, {"id": 7, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "بُكْرَةً", "translit": "ًẗَrْkُb", "root": "بكر"}, {"id": 9, "arabic": "وَأَصِيلًا", "translit": "āًlyِṣَaʾَw", "root": "اصل"}], "hasIhya": false}, {"ayah": 6, "text": "قُلْ أَنزَلَهُ ٱلَّذِى يَعْلَمُ ٱلسِّرَّ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ إِنَّهُۥ كَانَ غَفُورًا رَّحِيمًا ", "translation": "Say, [O Muḥammad], \"It has been revealed by He who knows [every] secret within the heavens and the earth. Indeed, He is ever Forgiving and Merciful.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَنزَلَهُ", "translit": "ُhَlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 5, "arabic": "ٱلسِّرَّ", "translit": "َّrِّslٱ", "root": "سرر"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 8, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 9, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 12, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 7, "text": "وَقَالُوا۟ مَالِ هَٰذَا ٱلرَّسُولِ يَأْكُلُ ٱلطَّعَامَ وَيَمْشِى فِى ٱلْأَسْوَاقِۙ لَوْلَآ أُنزِلَ إِلَيْهِ مَلَكٌ فَيَكُونَ مَعَهُۥ نَذِيرًا ", "translation": "And they say, \"What is this messenger that eats food and walks in the markets? Why was there not sent down to him an angel so he would be with him a warner?", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مَالِ", "translit": "ِlāَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 5, "arabic": "يَأْكُلُ", "translit": "ُlُkْaʾَy", "root": "اكل"}, {"id": 6, "arabic": "ٱلطَّعَامَ", "translit": "َmāَʿعَّṭlٱ", "root": "طعم"}, {"id": 7, "arabic": "وَيَمْشِى", "translit": "àِhsْmَyَw", "root": "مشي"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْأَسْوَاقِ", "translit": "ِqāَwْsَaʾْlٱ", "root": "سوق"}, {"id": 10, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 11, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 12, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 13, "arabic": "مَلَكٌ", "translit": "ٌkَlَm", "root": "ملك"}, {"id": 14, "arabic": "فَيَكُونَ", "translit": "َnwُkَyَf", "root": "كون"}, {"id": 15, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 16, "arabic": "نَذِيرًا", "translit": "āًryِhdَn", "root": "نذر"}], "hasIhya": false}, {"ayah": 8, "text": "أَوْ يُلْقَىٰٓ إِلَيْهِ كَنزٌ أَوْ تَكُونُ لَهُۥ جَنَّةٌ يَأْكُلُ مِنْهَاۚ وَقَالَ ٱلظَّٰلِمُونَ إِن تَتَّبِعُونَ إِلَّا رَجُلًا مَّسْحُورًا ", "translation": "Or [why is not] a treasure presented to him [from heaven], or does he [not] have a garden from which he eats?\" And the wrongdoers say, \"You follow not but a man affected by magic.\"", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "يُلْقَىٰٓ", "translit": "ٰٓàَqْlُy", "root": "لقي"}, {"id": 3, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "كَنزٌ", "translit": "ٌznَk", "root": "كنز"}, {"id": 5, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 6, "arabic": "تَكُونُ", "translit": "ُnwُkَt", "root": "كون"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "جَنَّةٌ", "translit": "ٌẗَّnَjg", "root": "جنن"}, {"id": 9, "arabic": "يَأْكُلُ", "translit": "ُlُkْaʾَy", "root": "اكل"}, {"id": 10, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 11, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 12, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "تَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَt", "root": "تبع"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "رَجُلًا", "translit": "āًlُjgَr", "root": "رجل"}, {"id": 17, "arabic": "مَّسْحُورًا", "translit": "āًrwُḥْsَّm", "root": "سحر"}], "hasIhya": false}, {"ayah": 9, "text": "ٱنظُرْ كَيْفَ ضَرَبُوا۟ لَكَ ٱلْأَمْثَٰلَ فَضَلُّوا۟ فَلَا يَسْتَطِيعُونَ سَبِيلًا ", "translation": "Look how they strike for you comparisons;[1] but they have strayed, so they cannot [find] a way.", "words": [{"id": 1, "arabic": "ٱنظُرْ", "translit": "ْrُẓnٱ", "root": "نظر"}, {"id": 2, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 3, "arabic": "ضَرَبُوا۟", "translit": "۟āwُbَrَḍ", "root": "ضرب"}, {"id": 4, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 5, "arabic": "ٱلْأَمْثَٰلَ", "translit": "َlَٰhtْmَaʾْlٱ", "root": "مثل"}, {"id": 6, "arabic": "فَضَلُّوا۟", "translit": "۟āwُّlَḍَf", "root": "ضلل"}, {"id": 7, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 8, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 9, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 10, "text": "تَبَارَكَ ٱلَّذِىٓ إِن شَآءَ جَعَلَ لَكَ خَيْرًا مِّن ذَٰلِكَ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ وَيَجْعَل لَّكَ قُصُورًۢا ", "translation": "Blessed is He who, if He willed, could have made for you [something] better than that - gardens beneath which rivers flow - and could make for you palaces.", "words": [{"id": 1, "arabic": "تَبَارَكَ", "translit": "َkَrāَbَt", "root": "برك"}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 5, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 6, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 7, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 10, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 11, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 14, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 15, "arabic": "وَيَجْعَل", "translit": "lَʿعْjgَyَw", "root": "جعل"}, {"id": 16, "arabic": "لَّكَ", "translit": "َkَّl", "root": ""}, {"id": 17, "arabic": "قُصُورًۢا", "translit": "āًۢrwُṣُq", "root": "قصر"}], "hasIhya": false}, {"ayah": 11, "text": "بَلْ كَذَّبُوا۟ بِٱلسَّاعَةِۖ وَأَعْتَدْنَا لِمَن كَذَّبَ بِٱلسَّاعَةِ سَعِيرًا ", "translation": "But they have denied the Hour, and We have prepared for those who deny the Hour a Blaze.", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "بِٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱِb", "root": "سوع"}, {"id": 4, "arabic": "وَأَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾَw", "root": "عتد"}, {"id": 5, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 6, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 7, "arabic": "بِٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱِb", "root": "سوع"}, {"id": 8, "arabic": "سَعِيرًا", "translit": "āًryِʿعَs", "root": "سعر"}], "hasIhya": false}, {"ayah": 12, "text": "إِذَا رَأَتْهُم مِّن مَّكَانٍۭ بَعِيدٍ سَمِعُوا۟ لَهَا تَغَيُّظًا وَزَفِيرًا ", "translation": "When it [i.e., the Hellfire] sees them from a distant place, they will hear its fury and roaring.", "words": [{"id": 1, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 2, "arabic": "رَأَتْهُم", "translit": "mُhْtَaʾَr", "root": "راي"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "مَّكَانٍۭ", "translit": "ٍۭnāَkَّm", "root": "كون"}, {"id": 5, "arabic": "بَعِيدٍ", "translit": "ٍdyِʿعَb", "root": "بعد"}, {"id": 6, "arabic": "سَمِعُوا۟", "translit": "۟āwُʿعِmَs", "root": "سمع"}, {"id": 7, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 8, "arabic": "تَغَيُّظًا", "translit": "āًẓُّyَغَt", "root": "غيظ"}, {"id": 9, "arabic": "وَزَفِيرًا", "translit": "āًryِfَzَw", "root": "زفر"}], "hasIhya": true}, {"ayah": 13, "text": "وَإِذَآ أُلْقُوا۟ مِنْهَا مَكَانًا ضَيِّقًا مُّقَرَّنِينَ دَعَوْا۟ هُنَالِكَ ثُبُورًا ", "translation": "And when they are thrown into a narrow place therein bound in chains, they will cry out thereupon for destruction.", "words": [{"id": 1, "arabic": "وَإِذَآ", "translit": "ٓāَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أُلْقُوا۟", "translit": "۟āwُqْlُaʾ", "root": "لقي"}, {"id": 3, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 4, "arabic": "مَكَانًا", "translit": "āًnāَkَm", "root": "كون"}, {"id": 5, "arabic": "ضَيِّقًا", "translit": "āًqِّyَḍ", "root": "ضيق"}, {"id": 6, "arabic": "مُّقَرَّنِينَ", "translit": "َnyِnَّrَqُّm", "root": "قرن"}, {"id": 7, "arabic": "دَعَوْا۟", "translit": "۟āْwَʿعَd", "root": "دعو"}, {"id": 8, "arabic": "هُنَالِكَ", "translit": "َkِlāَnُh", "root": ""}, {"id": 9, "arabic": "ثُبُورًا", "translit": "āًrwُbُht", "root": "ثبر"}], "hasIhya": false}, {"ayah": 14, "text": "لَّا تَدْعُوا۟ ٱلْيَوْمَ ثُبُورًا وَٰحِدًا وَٱدْعُوا۟ ثُبُورًا كَثِيرًا ", "translation": "[They will be told], \"Do not cry this Day for one destruction but cry for much destruction.\"", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "تَدْعُوا۟", "translit": "۟āwُʿعْdَt", "root": "دعو"}, {"id": 3, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 4, "arabic": "ثُبُورًا", "translit": "āًrwُbُht", "root": "ثبر"}, {"id": 5, "arabic": "وَٰحِدًا", "translit": "āًdِḥَٰw", "root": "وحد"}, {"id": 6, "arabic": "وَٱدْعُوا۟", "translit": "۟āwُʿعْdٱَw", "root": "دعو"}, {"id": 7, "arabic": "ثُبُورًا", "translit": "āًrwُbُht", "root": "ثبر"}, {"id": 8, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": false}, {"ayah": 15, "text": "قُلْ أَذَٰلِكَ خَيْرٌ أَمْ جَنَّةُ ٱلْخُلْدِ ٱلَّتِى وُعِدَ ٱلْمُتَّقُونَۚ كَانَتْ لَهُمْ جَزَآءً وَمَصِيرًا ", "translation": "Say, \"Is that better or the Garden of Eternity which is promised to the righteous? It will be for them a reward and destination.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَذَٰلِكَ", "translit": "َkِlَٰhdَaʾ", "root": ""}, {"id": 3, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 4, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 5, "arabic": "جَنَّةُ", "translit": "ُẗَّnَjg", "root": "جنن"}, {"id": 6, "arabic": "ٱلْخُلْدِ", "translit": "ِdْlُhkْlٱ", "root": "خلد"}, {"id": 7, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 8, "arabic": "وُعِدَ", "translit": "َdِʿعُw", "root": "وعد"}, {"id": 9, "arabic": "ٱلْمُتَّقُونَ", "translit": "َnwُqَّtُmْlٱ", "root": "وقي"}, {"id": 10, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 11, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 12, "arabic": "جَزَآءً", "translit": "ًءٓāَzَjg", "root": "جزي"}, {"id": 13, "arabic": "وَمَصِيرًا", "translit": "āًryِṣَmَw", "root": "صير"}], "hasIhya": false}, {"ayah": 16, "text": "لَّهُمْ فِيهَا مَا يَشَآءُونَ خَٰلِدِينَۚ كَانَ عَلَىٰ رَبِّكَ وَعْدًا مَّسْـُٔولًا ", "translation": "For them therein is whatever they wish, [while] abiding eternally. It is ever upon your Lord a promise [worthy to be] requested.[1]", "words": [{"id": 1, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَشَآءُونَ", "translit": "َnwُءٓāَhsَy", "root": "شيا"}, {"id": 5, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 6, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 9, "arabic": "وَعْدًا", "translit": "āًdْʿعَw", "root": "وعد"}, {"id": 10, "arabic": "مَّسْـُٔولًا", "translit": "āًlwُٔـْsَّm", "root": "سال"}], "hasIhya": false}, {"ayah": 17, "text": "وَيَوْمَ يَحْشُرُهُمْ وَمَا يَعْبُدُونَ مِن دُونِ ٱللَّهِ فَيَقُولُ ءَأَنتُمْ أَضْلَلْتُمْ عِبَادِى هَٰٓؤُلَآءِ أَمْ هُمْ ضَلُّوا۟ ٱلسَّبِيلَ ", "translation": "And [mention] the Day He will gather them and that which they worship besides Allāh and will say, \"Did you mislead these, My servants, or did they [themselves] stray from the way?\"", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يَحْشُرُهُمْ", "translit": "ْmُhُrُhsْḥَy", "root": "حشر"}, {"id": 3, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 4, "arabic": "يَعْبُدُونَ", "translit": "َnwُdُbْʿعَy", "root": "عبد"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "فَيَقُولُ", "translit": "ُlwُqَyَf", "root": "قول"}, {"id": 9, "arabic": "ءَأَنتُمْ", "translit": "ْmُtnَaʾَء", "root": ""}, {"id": 10, "arabic": "أَضْلَلْتُمْ", "translit": "ْmُtْlَlْḍَaʾ", "root": "ضلل"}, {"id": 11, "arabic": "عِبَادِى", "translit": "àِdāَbِʿع", "root": "عبد"}, {"id": 12, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 13, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 14, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 15, "arabic": "ضَلُّوا۟", "translit": "۟āwُّlَḍ", "root": "ضلل"}, {"id": 16, "arabic": "ٱلسَّبِيلَ", "translit": "َlyِbَّslٱ", "root": "سبل"}], "hasIhya": false}, {"ayah": 18, "text": "قَالُوا۟ سُبْحَٰنَكَ مَا كَانَ يَنۢبَغِى لَنَآ أَن نَّتَّخِذَ مِن دُونِكَ مِنْ أَوْلِيَآءَ وَلَٰكِن مَّتَّعْتَهُمْ وَءَابَآءَهُمْ حَتَّىٰ نَسُوا۟ ٱلذِّكْرَ وَكَانُوا۟ قَوْمًۢا بُورًا ", "translation": "They will say, \"Exalted are You! It was not for us to take besides You any allies [i.e., protectors]. But You provided comforts for them and their fathers until they forgot the message and became a people ruined.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "سُبْحَٰنَكَ", "translit": "َkَnَٰḥْbُs", "root": "سبح"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 5, "arabic": "يَنۢبَغِى", "translit": "àِغَbۢnَy", "root": "بغي"}, {"id": 6, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "نَّتَّخِذَ", "translit": "َhdِhkَّtَّn", "root": "اخذ"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دُونِكَ", "translit": "َkِnwُd", "root": "دون"}, {"id": 11, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 12, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 13, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 14, "arabic": "مَّتَّعْتَهُمْ", "translit": "ْmُhَtْʿعَّtَّm", "root": "متع"}, {"id": 15, "arabic": "وَءَابَآءَهُمْ", "translit": "ْmُhَءٓāَbāَءَw", "root": "ابو"}, {"id": 16, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 17, "arabic": "نَسُوا۟", "translit": "۟āwُsَn", "root": "نسي"}, {"id": 18, "arabic": "ٱلذِّكْرَ", "translit": "َrْkِّhdlٱ", "root": "ذكر"}, {"id": 19, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 20, "arabic": "قَوْمًۢا", "translit": "āًۢmْwَq", "root": "قوم"}, {"id": 21, "arabic": "بُورًا", "translit": "āًrwُb", "root": "بور"}], "hasIhya": false}, {"ayah": 19, "text": "فَقَدْ كَذَّبُوكُم بِمَا تَقُولُونَ فَمَا تَسْتَطِيعُونَ صَرْفًا وَلَا نَصْرًاۚ وَمَن يَظْلِم مِّنكُمْ نُذِقْهُ عَذَابًا كَبِيرًا ", "translation": "So they will deny you, [disbelievers], in what you say,[1] and you cannot avert [punishment] or [find] help. And whoever commits injustice[2] among you - We will make him taste a great punishment.", "words": [{"id": 1, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 2, "arabic": "كَذَّبُوكُم", "translit": "mُkwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "تَقُولُونَ", "translit": "َnwُlwُqَt", "root": "قول"}, {"id": 5, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 6, "arabic": "تَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَt", "root": "طوع"}, {"id": 7, "arabic": "صَرْفًا", "translit": "āًfْrَṣ", "root": "صرف"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "نَصْرًا", "translit": "āًrْṣَn", "root": "نصر"}, {"id": 10, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 11, "arabic": "يَظْلِم", "translit": "mِlْẓَy", "root": "ظلم"}, {"id": 12, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 13, "arabic": "نُذِقْهُ", "translit": "ُhْqِhdُn", "root": "ذوق"}, {"id": 14, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 15, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 20, "text": "وَمَآ أَرْسَلْنَا قَبْلَكَ مِنَ ٱلْمُرْسَلِينَ إِلَّآ إِنَّهُمْ لَيَأْكُلُونَ ٱلطَّعَامَ وَيَمْشُونَ فِى ٱلْأَسْوَاقِۗ وَجَعَلْنَا بَعْضَكُمْ لِبَعْضٍ فِتْنَةً أَتَصْبِرُونَۗ وَكَانَ رَبُّكَ بَصِيرًا ", "translation": "And We did not send before you, [O Muḥammad], any of the messengers except that they ate food and walked in the markets. And We have made some of you [people] as trial for others - will you have patience? And ever is your Lord, Seeing.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "قَبْلَكَ", "translit": "َkَlْbَq", "root": "قبل"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}, {"id": 6, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 7, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "لَيَأْكُلُونَ", "translit": "َnwُlُkْaʾَyَl", "root": "اكل"}, {"id": 9, "arabic": "ٱلطَّعَامَ", "translit": "َmāَʿعَّṭlٱ", "root": "طعم"}, {"id": 10, "arabic": "وَيَمْشُونَ", "translit": "َnwُhsْmَyَw", "root": "مشي"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْأَسْوَاقِ", "translit": "ِqāَwْsَaʾْlٱ", "root": "سوق"}, {"id": 13, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 14, "arabic": "بَعْضَكُمْ", "translit": "ْmُkَḍْʿعَb", "root": "بعض"}, {"id": 15, "arabic": "لِبَعْضٍ", "translit": "ٍḍْʿعَbِl", "root": "بعض"}, {"id": 16, "arabic": "فِتْنَةً", "translit": "ًẗَnْtِf", "root": "فتن"}, {"id": 17, "arabic": "أَتَصْبِرُونَ", "translit": "َnwُrِbْṣَtَaʾ", "root": "صبر"}, {"id": 18, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 19, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 20, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 21, "text": "وَقَالَ ٱلَّذِينَ لَا يَرْجُونَ لِقَآءَنَا لَوْلَآ أُنزِلَ عَلَيْنَا ٱلْمَلَٰٓئِكَةُ أَوْ نَرَىٰ رَبَّنَاۗ لَقَدِ ٱسْتَكْبَرُوا۟ فِىٓ أَنفُسِهِمْ وَعَتَوْ عُتُوًّا كَبِيرًا ", "translation": "And those who do not expect the meeting with Us say, \"Why were not angels sent down to us, or [why] do we [not] see our Lord?\" They have certainly become arrogant within themselves[1] and [become] insolent with great insolence.", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 5, "arabic": "لِقَآءَنَا", "translit": "āَnَءٓāَqِl", "root": "لقي"}, {"id": 6, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 7, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 8, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 9, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "نَرَىٰ", "translit": "ٰàَrَn", "root": "راي"}, {"id": 12, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 13, "arabic": "لَقَدِ", "translit": "ِdَqَl", "root": ""}, {"id": 14, "arabic": "ٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱ", "root": "كبر"}, {"id": 15, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 16, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 17, "arabic": "وَعَتَوْ", "translit": "ْwَtَʿعَw", "root": "عتو"}, {"id": 18, "arabic": "عُتُوًّا", "translit": "āًّwُtُʿع", "root": "عتو"}, {"id": 19, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}], "hasIhya": true}, {"ayah": 22, "text": "يَوْمَ يَرَوْنَ ٱلْمَلَٰٓئِكَةَ لَا بُشْرَىٰ يَوْمَئِذٍ لِّلْمُجْرِمِينَ وَيَقُولُونَ حِجْرًا مَّحْجُورًا ", "translation": "The day they see the angels[1] - no good tidings will there be that day for the criminals, and [the angels] will say, \"Prevented and inaccessible.\"[2]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَرَوْنَ", "translit": "َnْwَrَy", "root": "راي"}, {"id": 3, "arabic": "ٱلْمَلَٰٓئِكَةَ", "translit": "َẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "بُشْرَىٰ", "translit": "ٰàَrْhsُb", "root": "بشر"}, {"id": 6, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 7, "arabic": "لِّلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlِّl", "root": "جرم"}, {"id": 8, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 9, "arabic": "حِجْرًا", "translit": "āًrْjgِḥ", "root": "حجر"}, {"id": 10, "arabic": "مَّحْجُورًا", "translit": "āًrwُjgْḥَّm", "root": "حجر"}], "hasIhya": false}, {"ayah": 23, "text": "وَقَدِمْنَآ إِلَىٰ مَا عَمِلُوا۟ مِنْ عَمَلٍ فَجَعَلْنَٰهُ هَبَآءً مَّنثُورًا ", "translation": "And We will approach [i.e., regard][1] what they have done of deeds and make them as dust dispersed.", "words": [{"id": 1, "arabic": "وَقَدِمْنَآ", "translit": "ٓāَnْmِdَqَw", "root": "قدم"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "عَمَلٍ", "translit": "ٍlَmَʿع", "root": "عمل"}, {"id": 7, "arabic": "فَجَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjgَf", "root": "جعل"}, {"id": 8, "arabic": "هَبَآءً", "translit": "ًءٓāَbَh", "root": "هبو"}, {"id": 9, "arabic": "مَّنثُورًا", "translit": "āًrwُhtnَّm", "root": "نثر"}], "hasIhya": true}, {"ayah": 24, "text": "أَصْحَٰبُ ٱلْجَنَّةِ يَوْمَئِذٍ خَيْرٌ مُّسْتَقَرًّا وَأَحْسَنُ مَقِيلًا ", "translation": "The companions of Paradise, that Day, are [in] a better settlement and better resting place.", "words": [{"id": 1, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 2, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 3, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 4, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 5, "arabic": "مُّسْتَقَرًّا", "translit": "āًّrَqَtْsُّm", "root": "قرر"}, {"id": 6, "arabic": "وَأَحْسَنُ", "translit": "ُnَsْḥَaʾَw", "root": "حسن"}, {"id": 7, "arabic": "مَقِيلًا", "translit": "āًlyِqَm", "root": "قيل"}], "hasIhya": false}, {"ayah": 25, "text": "وَيَوْمَ تَشَقَّقُ ٱلسَّمَآءُ بِٱلْغَمَٰمِ وَنُزِّلَ ٱلْمَلَٰٓئِكَةُ تَنزِيلًا ", "translation": "And [mention] the Day when the heaven will split open with [emerging] clouds,[1] and the angels will be sent down in successive descent.", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "تَشَقَّقُ", "translit": "ُqَّqَhsَt", "root": "شقق"}, {"id": 3, "arabic": "ٱلسَّمَآءُ", "translit": "ُءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "بِٱلْغَمَٰمِ", "translit": "ِmَٰmَغْlٱِb", "root": "غمم"}, {"id": 5, "arabic": "وَنُزِّلَ", "translit": "َlِّzُnَw", "root": "نزل"}, {"id": 6, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 7, "arabic": "تَنزِيلًا", "translit": "āًlyِznَt", "root": "نزل"}], "hasIhya": false}, {"ayah": 26, "text": "ٱلْمُلْكُ يَوْمَئِذٍ ٱلْحَقُّ لِلرَّحْمَٰنِۚ وَكَانَ يَوْمًا عَلَى ٱلْكَٰفِرِينَ عَسِيرًا ", "translation": "True sovereignty, that Day, is for the Most Merciful. And it will be upon the disbelievers a difficult Day.", "words": [{"id": 1, "arabic": "ٱلْمُلْكُ", "translit": "ُkْlُmْlٱ", "root": "ملك"}, {"id": 2, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 3, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 4, "arabic": "لِلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlِl", "root": "رحم"}, {"id": 5, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 6, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 9, "arabic": "عَسِيرًا", "translit": "āًryِsَʿع", "root": "عسر"}], "hasIhya": true}, {"ayah": 27, "text": "وَيَوْمَ يَعَضُّ ٱلظَّالِمُ عَلَىٰ يَدَيْهِ يَقُولُ يَٰلَيْتَنِى ٱتَّخَذْتُ مَعَ ٱلرَّسُولِ سَبِيلًا ", "translation": "And the Day the wrongdoer will bite on his hands [in regret] he will say, \"Oh, I wish I had taken with the Messenger a way.[1]", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يَعَضُّ", "translit": "ُّḍَʿعَy", "root": "عضض"}, {"id": 3, "arabic": "ٱلظَّالِمُ", "translit": "ُmِlāَّẓlٱ", "root": "ظلم"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "يَدَيْهِ", "translit": "ِhْyَdَy", "root": "يدي"}, {"id": 6, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 7, "arabic": "يَٰلَيْتَنِى", "translit": "àِnَtْyَlَٰy", "root": ""}, {"id": 8, "arabic": "ٱتَّخَذْتُ", "translit": "ُtْhdَhkَّtٱ", "root": "اخذ"}, {"id": 9, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 10, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 11, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": true}, {"ayah": 28, "text": "يَٰوَيْلَتَىٰ لَيْتَنِى لَمْ أَتَّخِذْ فُلَانًا خَلِيلًا ", "translation": "Oh, woe to me! I wish I had not taken that one[1] as a friend.", "words": [{"id": 1, "arabic": "يَٰوَيْلَتَىٰ", "translit": "ٰàَtَlْyَwَٰy", "root": ""}, {"id": 2, "arabic": "لَيْتَنِى", "translit": "àِnَtْyَl", "root": ""}, {"id": 3, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 4, "arabic": "أَتَّخِذْ", "translit": "ْhdِhkَّtَaʾ", "root": "اخذ"}, {"id": 5, "arabic": "فُلَانًا", "translit": "āًnāَlُf", "root": "فلن"}, {"id": 6, "arabic": "خَلِيلًا", "translit": "āًlyِlَhk", "root": "خلل"}], "hasIhya": true}, {"ayah": 29, "text": "لَّقَدْ أَضَلَّنِى عَنِ ٱلذِّكْرِ بَعْدَ إِذْ جَآءَنِىۗ وَكَانَ ٱلشَّيْطَٰنُ لِلْإِنسَٰنِ خَذُولًا ", "translation": "He led me away from the remembrance[1] after it had come to me. And ever is Satan, to man, a deserter.\"[2]", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": ""}, {"id": 2, "arabic": "أَضَلَّنِى", "translit": "àِnَّlَḍَaʾ", "root": "ضلل"}, {"id": 3, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلذِّكْرِ", "translit": "ِrْkِّhdlٱ", "root": "ذكر"}, {"id": 5, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 7, "arabic": "جَآءَنِى", "translit": "àِnَءٓāَjg", "root": "جيا"}, {"id": 8, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 9, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 10, "arabic": "لِلْإِنسَٰنِ", "translit": "ِnَٰsnِiʾْlِl", "root": "انس"}, {"id": 11, "arabic": "خَذُولًا", "translit": "āًlwُhdَhk", "root": "خذل"}], "hasIhya": false}, {"ayah": 30, "text": "وَقَالَ ٱلرَّسُولُ يَٰرَبِّ إِنَّ قَوْمِى ٱتَّخَذُوا۟ هَٰذَا ٱلْقُرْءَانَ مَهْجُورًا ", "translation": "And the Messenger has said, \"O my Lord, indeed my people have taken this Qur’ān as [a thing] abandoned.\"[1]", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 3, "arabic": "يَٰرَبِّ", "translit": "ِّbَrَٰy", "root": "ربب"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "قَوْمِى", "translit": "àِmْwَq", "root": "قوم"}, {"id": 6, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 7, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 8, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 9, "arabic": "مَهْجُورًا", "translit": "āًrwُjgْhَm", "root": "هجر"}], "hasIhya": false}, {"ayah": 31, "text": "وَكَذَٰلِكَ جَعَلْنَا لِكُلِّ نَبِىٍّ عَدُوًّا مِّنَ ٱلْمُجْرِمِينَۗ وَكَفَىٰ بِرَبِّكَ هَادِيًا وَنَصِيرًا ", "translation": "And thus have We made for every prophet an enemy from among the criminals. But sufficient is your Lord as a guide and a helper.", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لِكُلِّ", "translit": "ِّlُkِl", "root": "كلل"}, {"id": 4, "arabic": "نَبِىٍّ", "translit": "ٍّàِbَn", "root": "نبا"}, {"id": 5, "arabic": "عَدُوًّا", "translit": "āًّwُdَʿع", "root": "عدو"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}, {"id": 8, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 9, "arabic": "بِرَبِّكَ", "translit": "َkِّbَrِb", "root": "ربب"}, {"id": 10, "arabic": "هَادِيًا", "translit": "āًyِdāَh", "root": "هدي"}, {"id": 11, "arabic": "وَنَصِيرًا", "translit": "āًryِṣَnَw", "root": "نصر"}], "hasIhya": false}, {"ayah": 32, "text": "وَقَالَ ٱلَّذِينَ كَفَرُوا۟ لَوْلَا نُزِّلَ عَلَيْهِ ٱلْقُرْءَانُ جُمْلَةً وَٰحِدَةًۚ كَذَٰلِكَ لِنُثَبِّتَ بِهِۦ فُؤَادَكَۖ وَرَتَّلْنَٰهُ تَرْتِيلًا ", "translation": "And those who disbelieve say, \"Why was the Qur’ān not revealed to him all at once?\" Thus [it is] that We may strengthen thereby your heart. And We have spaced it distinctly.[1]", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 5, "arabic": "نُزِّلَ", "translit": "َlِّzُn", "root": "نزل"}, {"id": 6, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلْقُرْءَانُ", "translit": "ُnāَءْrُqْlٱ", "root": "قرا"}, {"id": 8, "arabic": "جُمْلَةً", "translit": "ًẗَlْmُjg", "root": "جمل"}, {"id": 9, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 10, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 11, "arabic": "لِنُثَبِّتَ", "translit": "َtِّbَhtُnِl", "root": "ثبت"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "فُؤَادَكَ", "translit": "َkَdāَwʾُf", "root": "فاد"}, {"id": 14, "arabic": "وَرَتَّلْنَٰهُ", "translit": "ُhَٰnْlَّtَrَw", "root": "رتل"}, {"id": 15, "arabic": "تَرْتِيلًا", "translit": "āًlyِtْrَt", "root": "رتل"}], "hasIhya": false}, {"ayah": 33, "text": "وَلَا يَأْتُونَكَ بِمَثَلٍ إِلَّا جِئْنَٰكَ بِٱلْحَقِّ وَأَحْسَنَ تَفْسِيرًا ", "translation": "And they do not come to you with an example [i.e., argument] except that We bring you the truth and the best explanation.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَأْتُونَكَ", "translit": "َkَnwُtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "بِمَثَلٍ", "translit": "ٍlَhtَmِb", "root": "مثل"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "جِئْنَٰكَ", "translit": "َkَٰnْyʾِjg", "root": "جيا"}, {"id": 6, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 7, "arabic": "وَأَحْسَنَ", "translit": "َnَsْḥَaʾَw", "root": "حسن"}, {"id": 8, "arabic": "تَفْسِيرًا", "translit": "āًryِsْfَt", "root": "فسر"}], "hasIhya": false}, {"ayah": 34, "text": "ٱلَّذِينَ يُحْشَرُونَ عَلَىٰ وُجُوهِهِمْ إِلَىٰ جَهَنَّمَ أُو۟لَٰٓئِكَ شَرٌّ مَّكَانًا وَأَضَلُّ سَبِيلًا ", "translation": "The ones who are gathered on their faces to Hell - those are the worst in position and farthest astray in [their] way.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُحْشَرُونَ", "translit": "َnwُrَhsْḥُy", "root": "حشر"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "وُجُوهِهِمْ", "translit": "ْmِhِhwُjgُw", "root": "وجه"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 7, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 8, "arabic": "شَرٌّ", "translit": "ٌّrَhs", "root": "شرر"}, {"id": 9, "arabic": "مَّكَانًا", "translit": "āًnāَkَّm", "root": "كون"}, {"id": 10, "arabic": "وَأَضَلُّ", "translit": "ُّlَḍَaʾَw", "root": "ضلل"}, {"id": 11, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": true}, {"ayah": 35, "text": "وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ وَجَعَلْنَا مَعَهُۥٓ أَخَاهُ هَٰرُونَ وَزِيرًا ", "translation": "And We had certainly given Moses the Scripture and appointed with him his brother Aaron as an assistant.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "مَعَهُۥٓ", "translit": "ٓۥُhَʿعَm", "root": ""}, {"id": 7, "arabic": "أَخَاهُ", "translit": "ُhāَhkَaʾ", "root": "اخو"}, {"id": 8, "arabic": "هَٰرُونَ", "translit": "َnwُrَٰh", "root": ""}, {"id": 9, "arabic": "وَزِيرًا", "translit": "āًryِzَw", "root": "وزر"}], "hasIhya": false}, {"ayah": 36, "text": "فَقُلْنَا ٱذْهَبَآ إِلَى ٱلْقَوْمِ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا فَدَمَّرْنَٰهُمْ تَدْمِيرًا ", "translation": "And We said, \"Go both of you to the people who have denied Our signs.\" Then We destroyed them with [complete] destruction.", "words": [{"id": 1, "arabic": "فَقُلْنَا", "translit": "āَnْlُqَf", "root": "قول"}, {"id": 2, "arabic": "ٱذْهَبَآ", "translit": "ٓāَbَhْhdٱ", "root": "ذهب"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 7, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 8, "arabic": "فَدَمَّرْنَٰهُمْ", "translit": "ْmُhَٰnْrَّmَdَf", "root": "دمر"}, {"id": 9, "arabic": "تَدْمِيرًا", "translit": "āًryِmْdَt", "root": "دمر"}], "hasIhya": false}, {"ayah": 37, "text": "وَقَوْمَ نُوحٍ لَّمَّا كَذَّبُوا۟ ٱلرُّسُلَ أَغْرَقْنَٰهُمْ وَجَعَلْنَٰهُمْ لِلنَّاسِ ءَايَةًۖ وَأَعْتَدْنَا لِلظَّٰلِمِينَ عَذَابًا أَلِيمًا ", "translation": "And the people of Noah - when they denied the messengers,[1] We drowned them, and We made them for mankind a sign. And We have prepared for the wrongdoers a painful punishment.", "words": [{"id": 1, "arabic": "وَقَوْمَ", "translit": "َmْwَqَw", "root": "قوم"}, {"id": 2, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 3, "arabic": "لَّمَّا", "translit": "āَّmَّl", "root": ""}, {"id": 4, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 5, "arabic": "ٱلرُّسُلَ", "translit": "َlُsُّrlٱ", "root": "رسل"}, {"id": 6, "arabic": "أَغْرَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَrْغَaʾ", "root": "غرق"}, {"id": 7, "arabic": "وَجَعَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 9, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 10, "arabic": "وَأَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾَw", "root": "عتد"}, {"id": 11, "arabic": "لِلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlِl", "root": "ظلم"}, {"id": 12, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 13, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 38, "text": "وَعَادًا وَثَمُودَا۟ وَأَصْحَٰبَ ٱلرَّسِّ وَقُرُونًۢا بَيْنَ ذَٰلِكَ كَثِيرًا ", "translation": "And [We destroyed] ʿAad and Thamūd and the companions of the well[1] and many generations between them.", "words": [{"id": 1, "arabic": "وَعَادًا", "translit": "āًdāَʿعَw", "root": "عود"}, {"id": 2, "arabic": "وَثَمُودَا۟", "translit": "۟āَdwُmَhtَw", "root": ""}, {"id": 3, "arabic": "وَأَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾَw", "root": "صحب"}, {"id": 4, "arabic": "ٱلرَّسِّ", "translit": "ِّsَّrlٱ", "root": "رسس"}, {"id": 5, "arabic": "وَقُرُونًۢا", "translit": "āًۢnwُrُqَw", "root": "قرن"}, {"id": 6, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 7, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 8, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": true}, {"ayah": 39, "text": "وَكُلًّا ضَرَبْنَا لَهُ ٱلْأَمْثَٰلَۖ وَكُلًّا تَبَّرْنَا تَتْبِيرًا ", "translation": "And for each We presented examples [as warnings], and each We destroyed with [total] destruction.", "words": [{"id": 1, "arabic": "وَكُلًّا", "translit": "āًّlُkَw", "root": "كلل"}, {"id": 2, "arabic": "ضَرَبْنَا", "translit": "āَnْbَrَḍ", "root": "ضرب"}, {"id": 3, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 4, "arabic": "ٱلْأَمْثَٰلَ", "translit": "َlَٰhtْmَaʾْlٱ", "root": "مثل"}, {"id": 5, "arabic": "وَكُلًّا", "translit": "āًّlُkَw", "root": "كلل"}, {"id": 6, "arabic": "تَبَّرْنَا", "translit": "āَnْrَّbَt", "root": "تبر"}, {"id": 7, "arabic": "تَتْبِيرًا", "translit": "āًryِbْtَt", "root": "تبر"}], "hasIhya": false}, {"ayah": 40, "text": "وَلَقَدْ أَتَوْا۟ عَلَى ٱلْقَرْيَةِ ٱلَّتِىٓ أُمْطِرَتْ مَطَرَ ٱلسَّوْءِۚ أَفَلَمْ يَكُونُوا۟ يَرَوْنَهَاۚ بَلْ كَانُوا۟ لَا يَرْجُونَ نُشُورًا ", "translation": "And they have already come upon the town which was showered with a rain of evil [i.e., stones]. So have they not seen it? But they are not expecting resurrection.[1]", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَتَوْا۟", "translit": "۟āْwَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْقَرْيَةِ", "translit": "ِẗَyْrَqْlٱ", "root": "قري"}, {"id": 5, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 6, "arabic": "أُمْطِرَتْ", "translit": "ْtَrِṭْmُaʾ", "root": "مطر"}, {"id": 7, "arabic": "مَطَرَ", "translit": "َrَṭَm", "root": "مطر"}, {"id": 8, "arabic": "ٱلسَّوْءِ", "translit": "ِءْwَّslٱ", "root": "سوا"}, {"id": 9, "arabic": "أَفَلَمْ", "translit": "ْmَlَfَaʾ", "root": ""}, {"id": 10, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 11, "arabic": "يَرَوْنَهَا", "translit": "āَhَnْwَrَy", "root": "راي"}, {"id": 12, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 16, "arabic": "نُشُورًا", "translit": "āًrwُhsُn", "root": "نشر"}], "hasIhya": false}, {"ayah": 41, "text": "وَإِذَا رَأَوْكَ إِن يَتَّخِذُونَكَ إِلَّا هُزُوًا أَهَٰذَا ٱلَّذِى بَعَثَ ٱللَّهُ رَسُولًا ", "translation": "And when they see you, [O Muḥammad], they take you not except in ridicule, [saying], \"Is this the one whom Allāh has sent as a messenger?", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "رَأَوْكَ", "translit": "َkْwَaʾَr", "root": "راي"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "يَتَّخِذُونَكَ", "translit": "َkَnwُhdِhkَّtَy", "root": "اخذ"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 7, "arabic": "أَهَٰذَا", "translit": "āَhdَٰhَaʾ", "root": ""}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "بَعَثَ", "translit": "َhtَʿعَb", "root": "بعث"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}], "hasIhya": false}, {"ayah": 42, "text": "إِن كَادَ لَيُضِلُّنَا عَنْ ءَالِهَتِنَا لَوْلَآ أَن صَبَرْنَا عَلَيْهَاۚ وَسَوْفَ يَعْلَمُونَ حِينَ يَرَوْنَ ٱلْعَذَابَ مَنْ أَضَلُّ سَبِيلًا ", "translation": "He almost would have misled us from our gods had we not been steadfast in [worship of] them.\" But they are going to know, when they see the punishment, who is farthest astray in [his] way.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "كَادَ", "translit": "َdāَk", "root": "كود"}, {"id": 3, "arabic": "لَيُضِلُّنَا", "translit": "āَnُّlِḍُyَl", "root": "ضلل"}, {"id": 4, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 5, "arabic": "ءَالِهَتِنَا", "translit": "āَnِtَhِlāَء", "root": "اله"}, {"id": 6, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "صَبَرْنَا", "translit": "āَnْrَbَṣ", "root": "صبر"}, {"id": 9, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "وَسَوْفَ", "translit": "َfْwَsَw", "root": ""}, {"id": 11, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}, {"id": 12, "arabic": "حِينَ", "translit": "َnyِḥ", "root": "حين"}, {"id": 13, "arabic": "يَرَوْنَ", "translit": "َnْwَrَy", "root": "راي"}, {"id": 14, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 15, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 16, "arabic": "أَضَلُّ", "translit": "ُّlَḍَaʾ", "root": "ضلل"}, {"id": 17, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": true}, {"ayah": 43, "text": "أَرَءَيْتَ مَنِ ٱتَّخَذَ إِلَٰهَهُۥ هَوَىٰهُ أَفَأَنتَ تَكُونُ عَلَيْهِ وَكِيلًا ", "translation": "Have you seen the one who takes as his god his own desire? Then would you be responsible for him?", "words": [{"id": 1, "arabic": "أَرَءَيْتَ", "translit": "َtْyَءَrَaʾ", "root": "راي"}, {"id": 2, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 3, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 4, "arabic": "إِلَٰهَهُۥ", "translit": "ۥُhَhَٰlِiʾ", "root": "اله"}, {"id": 5, "arabic": "هَوَىٰهُ", "translit": "ُhٰàَwَh", "root": "هوي"}, {"id": 6, "arabic": "أَفَأَنتَ", "translit": "َtnَaʾَfَaʾ", "root": ""}, {"id": 7, "arabic": "تَكُونُ", "translit": "ُnwُkَt", "root": "كون"}, {"id": 8, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "وَكِيلًا", "translit": "āًlyِkَw", "root": "وكل"}], "hasIhya": true}, {"ayah": 44, "text": "أَمْ تَحْسَبُ أَنَّ أَكْثَرَهُمْ يَسْمَعُونَ أَوْ يَعْقِلُونَۚ إِنْ هُمْ إِلَّا كَٱلْأَنْعَٰمِۖ بَلْ هُمْ أَضَلُّ سَبِيلًا ", "translation": "Or do you think that most of them hear or reason? They are not except like livestock.[1] Rather, they are [even] more astray in [their] way.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "تَحْسَبُ", "translit": "ُbَsْḥَt", "root": "حسب"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 5, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}, {"id": 8, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 9, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "كَٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱَk", "root": "نعم"}, {"id": 12, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 13, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 14, "arabic": "أَضَلُّ", "translit": "ُّlَḍَaʾ", "root": "ضلل"}, {"id": 15, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": true}, {"ayah": 45, "text": "أَلَمْ تَرَ إِلَىٰ رَبِّكَ كَيْفَ مَدَّ ٱلظِّلَّ وَلَوْ شَآءَ لَجَعَلَهُۥ سَاكِنًا ثُمَّ جَعَلْنَا ٱلشَّمْسَ عَلَيْهِ دَلِيلًا ", "translation": "Have you not considered your Lord - how He extends the shadow, and if He willed, He could have made it stationary? Then We made the sun for it an indication.[1]", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 5, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 6, "arabic": "مَدَّ", "translit": "َّdَm", "root": "مدد"}, {"id": 7, "arabic": "ٱلظِّلَّ", "translit": "َّlِّẓlٱ", "root": "ظلل"}, {"id": 8, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 9, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 10, "arabic": "لَجَعَلَهُۥ", "translit": "ۥُhَlَʿعَjgَl", "root": "جعل"}, {"id": 11, "arabic": "سَاكِنًا", "translit": "āًnِkāَs", "root": "سكن"}, {"id": 12, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 13, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 14, "arabic": "ٱلشَّمْسَ", "translit": "َsْmَّhslٱ", "root": "شمس"}, {"id": 15, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 16, "arabic": "دَلِيلًا", "translit": "āًlyِlَd", "root": "دلل"}], "hasIhya": true}, {"ayah": 46, "text": "ثُمَّ قَبَضْنَٰهُ إِلَيْنَا قَبْضًا يَسِيرًا ", "translation": "Then We [retract and] hold it with Us for a brief grasp.[1]", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "قَبَضْنَٰهُ", "translit": "ُhَٰnْḍَbَq", "root": "قبض"}, {"id": 3, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "قَبْضًا", "translit": "āًḍْbَq", "root": "قبض"}, {"id": 5, "arabic": "يَسِيرًا", "translit": "āًryِsَy", "root": "يسر"}], "hasIhya": true}, {"ayah": 47, "text": "وَهُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِبَاسًا وَٱلنَّوْمَ سُبَاتًا وَجَعَلَ ٱلنَّهَارَ نُشُورًا ", "translation": "And it is He who has made the night for you as clothing[1] and sleep [a means for] rest and has made the day a resurrection.[2]", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 6, "arabic": "لِبَاسًا", "translit": "āًsāَbِl", "root": "لبس"}, {"id": 7, "arabic": "وَٱلنَّوْمَ", "translit": "َmْwَّnlٱَw", "root": "نوم"}, {"id": 8, "arabic": "سُبَاتًا", "translit": "āًtāَbُs", "root": "سبت"}, {"id": 9, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 10, "arabic": "ٱلنَّهَارَ", "translit": "َrāَhَّnlٱ", "root": "نهر"}, {"id": 11, "arabic": "نُشُورًا", "translit": "āًrwُhsُn", "root": "نشر"}], "hasIhya": true}, {"ayah": 48, "text": "وَهُوَ ٱلَّذِىٓ أَرْسَلَ ٱلرِّيَٰحَ بُشْرًۢا بَيْنَ يَدَىْ رَحْمَتِهِۦۚ وَأَنزَلْنَا مِنَ ٱلسَّمَآءِ مَآءً طَهُورًا ", "translation": "And it is He who sends the winds as good tidings before His mercy [i.e., rainfall], and We send down from the sky pure water", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَرْسَلَ", "translit": "َlَsْrَaʾ", "root": "رسل"}, {"id": 4, "arabic": "ٱلرِّيَٰحَ", "translit": "َḥَٰyِّrlٱ", "root": "روح"}, {"id": 5, "arabic": "بُشْرًۢا", "translit": "āًۢrْhsُb", "root": "بشر"}, {"id": 6, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 7, "arabic": "يَدَىْ", "translit": "ْàَdَy", "root": "يدي"}, {"id": 8, "arabic": "رَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَr", "root": "رحم"}, {"id": 9, "arabic": "وَأَنزَلْنَا", "translit": "āَnْlَznَaʾَw", "root": "نزل"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 12, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 13, "arabic": "طَهُورًا", "translit": "āًrwُhَṭ", "root": "طهر"}], "hasIhya": false}, {"ayah": 49, "text": "لِّنُحْۦِىَ بِهِۦ بَلْدَةً مَّيْتًا وَنُسْقِيَهُۥ مِمَّا خَلَقْنَآ أَنْعَٰمًا وَأَنَاسِىَّ كَثِيرًا ", "translation": "That We may bring to life thereby a dead land and give it as drink to those We created of numerous livestock and men.", "words": [{"id": 1, "arabic": "لِّنُحْۦِىَ", "translit": "َàِۦْḥُnِّl", "root": "حيي"}, {"id": 2, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 3, "arabic": "بَلْدَةً", "translit": "ًẗَdْlَb", "root": "بلد"}, {"id": 4, "arabic": "مَّيْتًا", "translit": "āًtْyَّm", "root": "موت"}, {"id": 5, "arabic": "وَنُسْقِيَهُۥ", "translit": "ۥُhَyِqْsُnَw", "root": "سقي"}, {"id": 6, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 7, "arabic": "خَلَقْنَآ", "translit": "ٓāَnْqَlَhk", "root": "خلق"}, {"id": 8, "arabic": "أَنْعَٰمًا", "translit": "āًmَٰʿعْnَaʾ", "root": "نعم"}, {"id": 9, "arabic": "وَأَنَاسِىَّ", "translit": "َّàِsāَnَaʾَw", "root": "انس"}, {"id": 10, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": false}, {"ayah": 50, "text": "وَلَقَدْ صَرَّفْنَٰهُ بَيْنَهُمْ لِيَذَّكَّرُوا۟ فَأَبَىٰٓ أَكْثَرُ ٱلنَّاسِ إِلَّا كُفُورًا ", "translation": "And We have certainly distributed it among them that they might be reminded,[1] but most of the people refuse except disbelief.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "صَرَّفْنَٰهُ", "translit": "ُhَٰnْfَّrَṣ", "root": "صرف"}, {"id": 3, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 4, "arabic": "لِيَذَّكَّرُوا۟", "translit": "۟āwُrَّkَّhdَyِl", "root": "ذكر"}, {"id": 5, "arabic": "فَأَبَىٰٓ", "translit": "ٰٓàَbَaʾَf", "root": "ابي"}, {"id": 6, "arabic": "أَكْثَرُ", "translit": "ُrَhtْkَaʾ", "root": "كثر"}, {"id": 7, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "كُفُورًا", "translit": "āًrwُfُk", "root": "كفر"}], "hasIhya": false}, {"ayah": 51, "text": "وَلَوْ شِئْنَا لَبَعَثْنَا فِى كُلِّ قَرْيَةٍ نَّذِيرًا ", "translation": "And if We had willed, We could have sent into every city a warner.[1]", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "شِئْنَا", "translit": "āَnْyʾِhs", "root": "شيا"}, {"id": 3, "arabic": "لَبَعَثْنَا", "translit": "āَnْhtَʿعَbَl", "root": "بعث"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 6, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 7, "arabic": "نَّذِيرًا", "translit": "āًryِhdَّn", "root": "نذر"}], "hasIhya": false}, {"ayah": 52, "text": "فَلَا تُطِعِ ٱلْكَٰفِرِينَ وَجَٰهِدْهُم بِهِۦ جِهَادًا كَبِيرًا ", "translation": "So do not obey the disbelievers, and strive against them with it [i.e., the Qur’ān] a great striving.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "تُطِعِ", "translit": "ِʿعِṭُt", "root": "طوع"}, {"id": 3, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 4, "arabic": "وَجَٰهِدْهُم", "translit": "mُhْdِhَٰjgَw", "root": "جهد"}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "جِهَادًا", "translit": "āًdāَhِjg", "root": "جهد"}, {"id": 7, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 53, "text": "وَهُوَ ٱلَّذِى مَرَجَ ٱلْبَحْرَيْنِ هَٰذَا عَذْبٌ فُرَاتٌ وَهَٰذَا مِلْحٌ أُجَاجٌ وَجَعَلَ بَيْنَهُمَا بَرْزَخًا وَحِجْرًا مَّحْجُورًا ", "translation": "And it is He who has released [simultaneously] the two seas [i.e., bodies of water], one fresh and sweet and one salty and bitter, and He placed between them a barrier and prohibiting partition.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "مَرَجَ", "translit": "َjgَrَm", "root": "مرج"}, {"id": 4, "arabic": "ٱلْبَحْرَيْنِ", "translit": "ِnْyَrْḥَbْlٱ", "root": "بحر"}, {"id": 5, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 6, "arabic": "عَذْبٌ", "translit": "ٌbْhdَʿع", "root": "عذب"}, {"id": 7, "arabic": "فُرَاتٌ", "translit": "ٌtāَrُf", "root": "فرت"}, {"id": 8, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 9, "arabic": "مِلْحٌ", "translit": "ٌḥْlِm", "root": "ملح"}, {"id": 10, "arabic": "أُجَاجٌ", "translit": "ٌjgāَjgُaʾ", "root": "اجج"}, {"id": 11, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 12, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 13, "arabic": "بَرْزَخًا", "translit": "āًhkَzْrَb", "root": "برزخ"}, {"id": 14, "arabic": "وَحِجْرًا", "translit": "āًrْjgِḥَw", "root": "حجر"}, {"id": 15, "arabic": "مَّحْجُورًا", "translit": "āًrwُjgْḥَّm", "root": "حجر"}], "hasIhya": false}, {"ayah": 54, "text": "وَهُوَ ٱلَّذِى خَلَقَ مِنَ ٱلْمَآءِ بَشَرًا فَجَعَلَهُۥ نَسَبًا وَصِهْرًاۗ وَكَانَ رَبُّكَ قَدِيرًا ", "translation": "And it is He who has created from water [i.e., semen] a human being and made him [a relative by] lineage and marriage. And ever is your Lord competent [concerning creation].", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْمَآءِ", "translit": "ِءٓāَmْlٱ", "root": "موه"}, {"id": 6, "arabic": "بَشَرًا", "translit": "āًrَhsَb", "root": "بشر"}, {"id": 7, "arabic": "فَجَعَلَهُۥ", "translit": "ۥُhَlَʿعَjgَf", "root": "جعل"}, {"id": 8, "arabic": "نَسَبًا", "translit": "āًbَsَn", "root": "نسب"}, {"id": 9, "arabic": "وَصِهْرًا", "translit": "āًrْhِṣَw", "root": "صهر"}, {"id": 10, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 11, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 12, "arabic": "قَدِيرًا", "translit": "āًryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 55, "text": "وَيَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُهُمْ وَلَا يَضُرُّهُمْۗ وَكَانَ ٱلْكَافِرُ عَلَىٰ رَبِّهِۦ ظَهِيرًا ", "translation": "But they worship rather than Allāh that which does not benefit them or harm them, and the disbeliever is ever, against his Lord, an assistant [to Satan].", "words": [{"id": 1, "arabic": "وَيَعْبُدُونَ", "translit": "َnwُdُbْʿعَyَw", "root": "عبد"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَنفَعُهُمْ", "translit": "ْmُhُʿعَfnَy", "root": "نفع"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "يَضُرُّهُمْ", "translit": "ْmُhُّrُḍَy", "root": "ضرر"}, {"id": 10, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 11, "arabic": "ٱلْكَافِرُ", "translit": "ُrِfāَkْlٱ", "root": "كفر"}, {"id": 12, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 13, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 14, "arabic": "ظَهِيرًا", "translit": "āًryِhَẓ", "root": "ظهر"}], "hasIhya": false}, {"ayah": 56, "text": "وَمَآ أَرْسَلْنَٰكَ إِلَّا مُبَشِّرًا وَنَذِيرًا ", "translation": "And We have not sent you, [O Muḥammad], except as a bringer of good tidings and a warner.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَٰكَ", "translit": "َkَٰnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "مُبَشِّرًا", "translit": "āًrِّhsَbُm", "root": "بشر"}, {"id": 5, "arabic": "وَنَذِيرًا", "translit": "āًryِhdَnَw", "root": "نذر"}], "hasIhya": false}, {"ayah": 57, "text": "قُلْ مَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ إِلَّا مَن شَآءَ أَن يَتَّخِذَ إِلَىٰ رَبِّهِۦ سَبِيلًا ", "translation": "Say, \"I do not ask of you for it any payment - only that whoever wills might take to his Lord a way.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أَسْـَٔلُكُمْ", "translit": "ْmُkُlَٔـْsَaʾ", "root": "سال"}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "أَجْرٍ", "translit": "ٍrْjgَaʾ", "root": "اجر"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 9, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "يَتَّخِذَ", "translit": "َhdِhkَّtَy", "root": "اخذ"}, {"id": 12, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 13, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 14, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 58, "text": "وَتَوَكَّلْ عَلَى ٱلْحَىِّ ٱلَّذِى لَا يَمُوتُ وَسَبِّحْ بِحَمْدِهِۦۚ وَكَفَىٰ بِهِۦ بِذُنُوبِ عِبَادِهِۦ خَبِيرًا ", "translation": "And rely upon the Ever-Living who does not die, and exalt [Allāh] with His praise. And sufficient is He to be, with the sins of His servants, [fully] Aware -", "words": [{"id": 1, "arabic": "وَتَوَكَّلْ", "translit": "ْlَّkَwَtَw", "root": "وكل"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْحَىِّ", "translit": "ِّàَḥْlٱ", "root": "حيي"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَمُوتُ", "translit": "ُtwُmَy", "root": "موت"}, {"id": 7, "arabic": "وَسَبِّحْ", "translit": "ْḥِّbَsَw", "root": "سبح"}, {"id": 8, "arabic": "بِحَمْدِهِۦ", "translit": "ۦِhِdْmَḥِb", "root": "حمد"}, {"id": 9, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "بِذُنُوبِ", "translit": "ِbwُnُhdِb", "root": "ذنب"}, {"id": 12, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 13, "arabic": "خَبِيرًا", "translit": "āًryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 59, "text": "ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِۚ ٱلرَّحْمَٰنُ فَسْـَٔلْ بِهِۦ خَبِيرًا ", "translation": "He who created the heavens and the earth and what is between them in six days and then established Himself above the Throne[1] - the Most Merciful, so ask about Him one well informed [i.e., the Prophet (ﷺ)].", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "سِتَّةِ", "translit": "ِẗَّtِs", "root": "ستت"}, {"id": 9, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "ٱسْتَوَىٰ", "translit": "ٰàَwَtْsٱ", "root": "سوي"}, {"id": 12, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 14, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 15, "arabic": "فَسْـَٔلْ", "translit": "ْlَٔـْsَf", "root": "سال"}, {"id": 16, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 17, "arabic": "خَبِيرًا", "translit": "āًryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 60, "text": "وَإِذَا قِيلَ لَهُمُ ٱسْجُدُوا۟ لِلرَّحْمَٰنِ قَالُوا۟ وَمَا ٱلرَّحْمَٰنُ أَنَسْجُدُ لِمَا تَأْمُرُنَا وَزَادَهُمْ نُفُورًا۩ ", "translation": "And when it is said to them, \"Prostrate to the Most Merciful,\" they say, \"And what is the Most Merciful? Should we prostrate to that which you order us?\" And it increases them in aversion.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 4, "arabic": "ٱسْجُدُوا۟", "translit": "۟āwُdُjgْsٱ", "root": "سجد"}, {"id": 5, "arabic": "لِلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlِl", "root": "رحم"}, {"id": 6, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 9, "arabic": "أَنَسْجُدُ", "translit": "ُdُjgْsَnَaʾ", "root": "سجد"}, {"id": 10, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 11, "arabic": "تَأْمُرُنَا", "translit": "āَnُrُmْaʾَt", "root": "امر"}, {"id": 12, "arabic": "وَزَادَهُمْ", "translit": "ْmُhَdāَzَw", "root": "زيد"}, {"id": 13, "arabic": "نُفُورًا", "translit": "āًrwُfُn", "root": "نفر"}], "hasIhya": true}, {"ayah": 61, "text": "تَبَارَكَ ٱلَّذِى جَعَلَ فِى ٱلسَّمَآءِ بُرُوجًا وَجَعَلَ فِيهَا سِرَٰجًا وَقَمَرًا مُّنِيرًا ", "translation": "Blessed is He who has placed in the sky great stars and placed therein a [burning] lamp and luminous moon.", "words": [{"id": 1, "arabic": "تَبَارَكَ", "translit": "َkَrāَbَt", "root": "برك"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "بُرُوجًا", "translit": "āًjgwُrُb", "root": "برج"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "سِرَٰجًا", "translit": "āًjgَٰrِs", "root": "سرج"}, {"id": 10, "arabic": "وَقَمَرًا", "translit": "āًrَmَqَw", "root": "قمر"}, {"id": 11, "arabic": "مُّنِيرًا", "translit": "āًryِnُّm", "root": "نور"}], "hasIhya": true}, {"ayah": 62, "text": "وَهُوَ ٱلَّذِى جَعَلَ ٱلَّيْلَ وَٱلنَّهَارَ خِلْفَةً لِّمَنْ أَرَادَ أَن يَذَّكَّرَ أَوْ أَرَادَ شُكُورًا ", "translation": "And it is He who has made the night and the day in succession for whoever desires to remember or desires gratitude.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 5, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 6, "arabic": "خِلْفَةً", "translit": "ًẗَfْlِhk", "root": "خلف"}, {"id": 7, "arabic": "لِّمَنْ", "translit": "ْnَmِّl", "root": ""}, {"id": 8, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يَذَّكَّرَ", "translit": "َrَّkَّhdَy", "root": "ذكر"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 13, "arabic": "شُكُورًا", "translit": "āًrwُkُhs", "root": "شكر"}], "hasIhya": true}, {"ayah": 63, "text": "وَعِبَادُ ٱلرَّحْمَٰنِ ٱلَّذِينَ يَمْشُونَ عَلَى ٱلْأَرْضِ هَوْنًا وَإِذَا خَاطَبَهُمُ ٱلْجَٰهِلُونَ قَالُوا۟ سَلَٰمًا ", "translation": "And the servants of the Most Merciful are those who walk upon the earth easily,[1] and when the ignorant address them [harshly], they say [words of] peace,[2]", "words": [{"id": 1, "arabic": "وَعِبَادُ", "translit": "ُdāَbِʿعَw", "root": "عبد"}, {"id": 2, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَمْشُونَ", "translit": "َnwُhsْmَy", "root": "مشي"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "هَوْنًا", "translit": "āًnْwَh", "root": "هون"}, {"id": 8, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 9, "arabic": "خَاطَبَهُمُ", "translit": "ُmُhَbَṭāَhk", "root": "خطب"}, {"id": 10, "arabic": "ٱلْجَٰهِلُونَ", "translit": "َnwُlِhَٰjgْlٱ", "root": "جهل"}, {"id": 11, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 12, "arabic": "سَلَٰمًا", "translit": "āًmَٰlَs", "root": "سلم"}], "hasIhya": true}, {"ayah": 64, "text": "وَٱلَّذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّدًا وَقِيَٰمًا ", "translation": "And those who spend [part of] the night to their Lord prostrating and standing [in prayer]", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يَبِيتُونَ", "translit": "َnwُtyِbَy", "root": "بيت"}, {"id": 3, "arabic": "لِرَبِّهِمْ", "translit": "ْmِhِّbَrِl", "root": "ربب"}, {"id": 4, "arabic": "سُجَّدًا", "translit": "āًdَّjgُs", "root": "سجد"}, {"id": 5, "arabic": "وَقِيَٰمًا", "translit": "āًmَٰyِqَw", "root": "قوم"}], "hasIhya": true}, {"ayah": 65, "text": "وَٱلَّذِينَ يَقُولُونَ رَبَّنَا ٱصْرِفْ عَنَّا عَذَابَ جَهَنَّمَۖ إِنَّ عَذَابَهَا كَانَ غَرَامًا ", "translation": "And those who say, \"Our Lord, avert from us the punishment of Hell. Indeed, its punishment is ever adhering;", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱصْرِفْ", "translit": "ْfِrْṣٱ", "root": "صرف"}, {"id": 5, "arabic": "عَنَّا", "translit": "āَّnَʿع", "root": ""}, {"id": 6, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 7, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 8, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 9, "arabic": "عَذَابَهَا", "translit": "āَhَbāَhdَʿع", "root": "عذب"}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "غَرَامًا", "translit": "āًmāَrَغ", "root": "غرم"}], "hasIhya": false}, {"ayah": 66, "text": "إِنَّهَا سَآءَتْ مُسْتَقَرًّا وَمُقَامًا ", "translation": "Indeed, it is evil as a settlement and residence.\"", "words": [{"id": 1, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "سَآءَتْ", "translit": "ْtَءٓāَs", "root": "سوا"}, {"id": 3, "arabic": "مُسْتَقَرًّا", "translit": "āًّrَqَtْsُm", "root": "قرر"}, {"id": 4, "arabic": "وَمُقَامًا", "translit": "āًmāَqُmَw", "root": "قوم"}], "hasIhya": false}, {"ayah": 67, "text": "وَٱلَّذِينَ إِذَآ أَنفَقُوا۟ لَمْ يُسْرِفُوا۟ وَلَمْ يَقْتُرُوا۟ وَكَانَ بَيْنَ ذَٰلِكَ قَوَامًا ", "translation": "And [they are] those who, when they spend, do so not excessively or sparingly but are ever, between that, [justly] moderate", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَنفَقُوا۟", "translit": "۟āwُqَfnَaʾ", "root": "نفق"}, {"id": 4, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 5, "arabic": "يُسْرِفُوا۟", "translit": "۟āwُfِrْsُy", "root": "سرف"}, {"id": 6, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 7, "arabic": "يَقْتُرُوا۟", "translit": "۟āwُrُtْqَy", "root": "قتر"}, {"id": 8, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 9, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 10, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 11, "arabic": "قَوَامًا", "translit": "āًmāَwَq", "root": "قوم"}], "hasIhya": true}, {"ayah": 68, "text": "وَٱلَّذِينَ لَا يَدْعُونَ مَعَ ٱللَّهِ إِلَٰهًا ءَاخَرَ وَلَا يَقْتُلُونَ ٱلنَّفْسَ ٱلَّتِى حَرَّمَ ٱللَّهُ إِلَّا بِٱلْحَقِّ وَلَا يَزْنُونَۚ وَمَن يَفْعَلْ ذَٰلِكَ يَلْقَ أَثَامًا ", "translation": "And those who do not invoke[1] with Allāh another deity or kill the soul which Allāh has forbidden [to be killed], except by right, and do not commit unlawful sexual intercourse. And whoever should do that will meet a penalty.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 4, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "إِلَٰهًا", "translit": "āًhَٰlِiʾ", "root": "اله"}, {"id": 7, "arabic": "ءَاخَرَ", "translit": "َrَhkāَء", "root": "اخر"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "يَقْتُلُونَ", "translit": "َnwُlُtْqَy", "root": "قتل"}, {"id": 10, "arabic": "ٱلنَّفْسَ", "translit": "َsْfَّnlٱ", "root": "نفس"}, {"id": 11, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 12, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "يَزْنُونَ", "translit": "َnwُnْzَy", "root": "زني"}, {"id": 18, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 19, "arabic": "يَفْعَلْ", "translit": "ْlَʿعْfَy", "root": "فعل"}, {"id": 20, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 21, "arabic": "يَلْقَ", "translit": "َqْlَy", "root": "لقي"}, {"id": 22, "arabic": "أَثَامًا", "translit": "āًmāَhtَaʾ", "root": "اثم"}], "hasIhya": true}, {"ayah": 69, "text": "يُضَٰعَفْ لَهُ ٱلْعَذَابُ يَوْمَ ٱلْقِيَٰمَةِ وَيَخْلُدْ فِيهِۦ مُهَانًا ", "translation": "Multiplied for him is the punishment on the Day of Resurrection, and he will abide therein humiliated -", "words": [{"id": 1, "arabic": "يُضَٰعَفْ", "translit": "ْfَʿعَٰḍُy", "root": "ضعف"}, {"id": 2, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 3, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 4, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 5, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 6, "arabic": "وَيَخْلُدْ", "translit": "ْdُlْhkَyَw", "root": "خلد"}, {"id": 7, "arabic": "فِيهِۦ", "translit": "ۦِhyِf", "root": ""}, {"id": 8, "arabic": "مُهَانًا", "translit": "āًnāَhُm", "root": "هون"}], "hasIhya": false}, {"ayah": 70, "text": "إِلَّا مَن تَابَ وَءَامَنَ وَعَمِلَ عَمَلًا صَٰلِحًا فَأُو۟لَٰٓئِكَ يُبَدِّلُ ٱللَّهُ سَيِّـَٔاتِهِمْ حَسَنَٰتٍۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ", "translation": "Except for those who repent, believe and do righteous work. For them Allāh will replace their evil deeds with good. And ever is Allāh Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 4, "arabic": "وَءَامَنَ", "translit": "َnَmāَءَw", "root": "امن"}, {"id": 5, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 6, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}, {"id": 7, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 8, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 9, "arabic": "يُبَدِّلُ", "translit": "ُlِّdَbُy", "root": "بدل"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "سَيِّـَٔاتِهِمْ", "translit": "ْmِhِtāَٔـِّyَs", "root": "سوا"}, {"id": 12, "arabic": "حَسَنَٰتٍ", "translit": "ٍtَٰnَsَḥ", "root": "حسن"}, {"id": 13, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 16, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 71, "text": "وَمَن تَابَ وَعَمِلَ صَٰلِحًا فَإِنَّهُۥ يَتُوبُ إِلَى ٱللَّهِ مَتَابًا ", "translation": "And he who repents and does righteousness does indeed turn to Allāh with [accepted] repentance.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 3, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 4, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 5, "arabic": "فَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَf", "root": ""}, {"id": 6, "arabic": "يَتُوبُ", "translit": "ُbwُtَy", "root": "توب"}, {"id": 7, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَتَابًا", "translit": "āًbāَtَm", "root": "توب"}], "hasIhya": false}, {"ayah": 72, "text": "وَٱلَّذِينَ لَا يَشْهَدُونَ ٱلزُّورَ وَإِذَا مَرُّوا۟ بِٱللَّغْوِ مَرُّوا۟ كِرَامًا ", "translation": "And [they are] those who do not testify to falsehood, and when they pass near ill speech, they pass by with dignity.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يَشْهَدُونَ", "translit": "َnwُdَhْhsَy", "root": "شهد"}, {"id": 4, "arabic": "ٱلزُّورَ", "translit": "َrwُّzlٱ", "root": "زور"}, {"id": 5, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 6, "arabic": "مَرُّوا۟", "translit": "۟āwُّrَm", "root": "مرر"}, {"id": 7, "arabic": "بِٱللَّغْوِ", "translit": "ِwْغَّllٱِb", "root": "لغو"}, {"id": 8, "arabic": "مَرُّوا۟", "translit": "۟āwُّrَm", "root": "مرر"}, {"id": 9, "arabic": "كِرَامًا", "translit": "āًmāَrِk", "root": "كرم"}], "hasIhya": true}, {"ayah": 73, "text": "وَٱلَّذِينَ إِذَا ذُكِّرُوا۟ بِـَٔايَٰتِ رَبِّهِمْ لَمْ يَخِرُّوا۟ عَلَيْهَا صُمًّا وَعُمْيَانًا ", "translation": "And those who, when reminded of the verses of their Lord, do not fall upon them deaf and blind.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "ذُكِّرُوا۟", "translit": "۟āwُrِّkُhd", "root": "ذكر"}, {"id": 4, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 6, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 7, "arabic": "يَخِرُّوا۟", "translit": "۟āwُّrِhkَy", "root": "خرر"}, {"id": 8, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "صُمًّا", "translit": "āًّmُṣ", "root": "صمم"}, {"id": 10, "arabic": "وَعُمْيَانًا", "translit": "āًnāَyْmُʿعَw", "root": "عمي"}], "hasIhya": false}, {"ayah": 74, "text": "وَٱلَّذِينَ يَقُولُونَ رَبَّنَا هَبْ لَنَا مِنْ أَزْوَٰجِنَا وَذُرِّيَّٰتِنَا قُرَّةَ أَعْيُنٍ وَٱجْعَلْنَا لِلْمُتَّقِينَ إِمَامًا ", "translation": "And those who say, \"Our Lord, grant us from among our wives and offspring comfort to our eyes[1] and make us a leader [i.e., example] for the righteous.\"", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 4, "arabic": "هَبْ", "translit": "ْbَh", "root": "وهب"}, {"id": 5, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "أَزْوَٰجِنَا", "translit": "āَnِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 8, "arabic": "وَذُرِّيَّٰتِنَا", "translit": "āَnِtَّٰyِّrُhdَw", "root": "ذرر"}, {"id": 9, "arabic": "قُرَّةَ", "translit": "َẗَّrُq", "root": "قرر"}, {"id": 10, "arabic": "أَعْيُنٍ", "translit": "ٍnُyْʿعَaʾ", "root": "عين"}, {"id": 11, "arabic": "وَٱجْعَلْنَا", "translit": "āَnْlَʿعْjgٱَw", "root": "جعل"}, {"id": 12, "arabic": "لِلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِl", "root": "وقي"}, {"id": 13, "arabic": "إِمَامًا", "translit": "āًmāَmِiʾ", "root": "امم"}], "hasIhya": true}, {"ayah": 75, "text": "أُو۟لَٰٓئِكَ يُجْزَوْنَ ٱلْغُرْفَةَ بِمَا صَبَرُوا۟ وَيُلَقَّوْنَ فِيهَا تَحِيَّةً وَسَلَٰمًا ", "translation": "Those will be awarded the Chamber[1] for what they patiently endured, and they will be received therein with greetings and [words of] peace,", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "يُجْزَوْنَ", "translit": "َnْwَzْjgُy", "root": "جزي"}, {"id": 3, "arabic": "ٱلْغُرْفَةَ", "translit": "َẗَfْrُغْlٱ", "root": "غرف"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 6, "arabic": "وَيُلَقَّوْنَ", "translit": "َnْwَّqَlُyَw", "root": "لقي"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "تَحِيَّةً", "translit": "ًẗَّyِḥَt", "root": "حيي"}, {"id": 9, "arabic": "وَسَلَٰمًا", "translit": "āًmَٰlَsَw", "root": "سلم"}], "hasIhya": false}, {"ayah": 76, "text": "خَٰلِدِينَ فِيهَاۚ حَسُنَتْ مُسْتَقَرًّا وَمُقَامًا ", "translation": "Abiding eternally therein. Good is the settlement and residence.", "words": [{"id": 1, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "حَسُنَتْ", "translit": "ْtَnُsَḥ", "root": "حسن"}, {"id": 4, "arabic": "مُسْتَقَرًّا", "translit": "āًّrَqَtْsُm", "root": "قرر"}, {"id": 5, "arabic": "وَمُقَامًا", "translit": "āًmāَqُmَw", "root": "قوم"}], "hasIhya": false}, {"ayah": 77, "text": "قُلْ مَا يَعْبَؤُا۟ بِكُمْ رَبِّى لَوْلَا دُعَآؤُكُمْۖ فَقَدْ كَذَّبْتُمْ فَسَوْفَ يَكُونُ لِزَامًۢا ", "translation": "Say, \"What would my Lord care for you if not for your supplication?\"[1] For you [disbelievers] have denied, so it [i.e., your denial] is going to be adherent.[2]", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "يَعْبَؤُا۟", "translit": "۟āُwʾَbْʿعَy", "root": "عبا"}, {"id": 4, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 5, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 6, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 7, "arabic": "دُعَآؤُكُمْ", "translit": "ْmُkُwʾٓāَʿعُd", "root": "دعو"}, {"id": 8, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 9, "arabic": "كَذَّبْتُمْ", "translit": "ْmُtْbَّhdَk", "root": "كذب"}, {"id": 10, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 11, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 12, "arabic": "لِزَامًۢا", "translit": "āًۢmāَzِl", "root": "لزم"}], "hasIhya": false}], "tafsir": {"3": [{"arabic": "عند الله فالعباد كلهم عجزة لا يملكون لأنفسهم ضرا ولا نفعا ولا يملكون موتا ولا حياتا ولا نشورا فإذا قرر في قلبه آفة هذه الأسباب وضررها فترت رغبته وأقبل على الله قلبه فإن العاقل لا يرغب فيما يكثر ضرره ويقل نفعه ويكفيه أن الناس لو علموا ما في باطنه من قصد الرياء وإظهار الإخلاص لمقتوه وسيكشف الله عن سره حتى يبغضه إلى الناس ويعرفهم أنه مراء وممقوت عند الله ولو أخلص لله لكشف الله لهم إخلاصه وحببه إليهم وسخرهم له وأطلق ألسنتهم بالمدح والثناء عليه مع أنه لا كمال في مدحهم ولا نقصان في ذمهم كما قال شاعر بني تميم إن مدحي زين وإن ذمي شين فقال له رسول الله ص", "english": "So when the harm and injury of these causes is firmly settled in his heart, his desire [for them] slackens, and his heart turns toward God. For the intelligent person does not covet that whose harm is abundant and whose benefit is scant. It suffices him that if people knew what is in his inner self—the intent of ostentation (riyā') and the display of sincerity—they would abhor him. And God will surely expose his secret until He makes him odious to the people and makes them know that he is a show-off, abhorrent to God. Had he been sincere to God, God would have unveiled his sincerity to them, made him beloved to them, subjected them to him, and loosened their tongues in praise and commendation of him—even though there is no perfection in their praise, nor deficiency in their blame. As the poet of Banī Tamīm said: \"My praise is an adornment, and my blame is a disgrace.\" The Messenger of God (peace and blessings be upon him) said to him: \"You have lied—that belongs to God, there is no deity but Him.\" // [Hadith: A poet of Banī Tamīm said, \"My praise is an adornment, and my blame is a disgrace.\" He (the Prophet) said: \"You have lied—that belongs to God.\" Ahmad narrated it from the hadith of al-Aqra' ibn Ḥābis—who was the speaker of that verse, excluding the phrase \"You have lied\"—and its narrators are trustworthy, except that I do not know of Abū Salamah ibn 'Abd al-Raḥmān having heard [directly] from al-Aqra'. Al-Tirmidhī narrated it from the hadith of al-Barā' and deemed it sound (ḥasan), with the wording: \"A man said, 'Indeed, my praise...'\"]", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 827", "section_title_en": "The Revival of the Religious Sciences — Section 827: The Second Station: Repelling the Accidental Promptings of Ostentation During Worship", "section_index": 827, "anchors": "- Root: كذب (kadhaba)\n  * Lisan / Ayn: Core meaning: falsehood, lying, saying what is contrary to reality; also used for \"to declare someone a liar.\"\n  * Al-Raghib (Mufradat): In theological context, kadhb is the antithesis of sidq (truthfulness); it is a moral and epistemic vice, often linked to hypocrisy (nifāq) and false claims.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): to report what did not occur. Metaphorical (majāz): attributing to God what is unworthy of Him, as in the Prophet's rebuke of the poet's self-praise.\n- Sibawayh Rule: Rule of Predicate Emphasis (Bāb al-Tawkīd) — The Prophet's reply \"كَذَبْتَ\" (You have lied) functions as an emphatic categorical refutation, structured as a nominal sentence with implied subject, establishing a permanent verdict rather than a transient rebuke.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "بعض أشخاص الإنس في بعض الأمور وهو مع ذلك لا يملك لنفسه موتا ولا حياة ولا نشورا ولا ضرا ولا نفعا بل لا يقدر على حفظ عينه من العمى ولسانه من الخرس وأذنه من الصمم وبدنه من المرض ولا يحتاج إلى عد ما يعجز عنه في نفسه وغيره مما هو على الجملة متعلق قدرته فضلا عما لا تتعلق به قدرته من ملكوت السموات وأفلاكها وكواكبها والأرض وجبالها وبحارها ورياحها وصواعقها ومعادنها ونباتها وحيواناتها وجميع أجزائها فلا قدرة له على ذرة منها وما هو قادر عليه من نفسه وغيره فليست قدرته من نفسه وبنفسه بل الله خالقه وخالق قدرته وخالق أسبابه والممكن له من", "english": "As for knowledge — where is the knowledge of the first and the last among all creation compared to the knowledge of Allah, the Exalted, which encompasses all things with an encompassing that transcends all limit, so that not even the weight of an atom escapes Him in the heavens or on the earth? He has addressed all of creation, saying, the Mighty and Majestic: {«وَمَا أُوتِيتُم مِّنَ الْعِلْمِ إِلَّا قَلِيلًا»} (And you have not been given of knowledge except a little) (Q 17:85). Nay, even if all the inhabitants of the earth and the heavens were to gather together to encompass His knowledge and His wisdom in the detailed formation of a single ant or gnat, they would not attain to one-tenth of a tenth of that — {«وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ»} (And they do not encompass anything of His knowledge except what He wills) (Q 2:255). And the paltry measure that all creatures have learned, they have learned only through His teaching, as He, the Exalted, said: {«خَلَقَ الْإِنسَانَ عَلَّمَهُ الْبَيَانَ»} (He created man; He taught him eloquence) (Q 55:3-4). If, therefore, the beauty and nobility of knowledge is something beloved, and it is in itself an adornment and perfection for the one described by it, then it is not fitting that anyone be loved for this reason except Allah, the Exalted alone.", "book_title": "Contemplation", "section_title_ar": "Section 1155", "section_title_en": "The Beauty of Divine Attributes and the Relative Nature of Human Perfection", "section_index": 1155, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning of perception, cognition, and certain apprehension of a thing's reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; it is twofold: apprehension of the essence, and judgment affirming or negating a predicate.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine cognition; metaphorical (majāz) usage extends to perception and awareness. Here, the comparative \"أعلم/أجهل\" (more knowing/ more ignorant) operates on a scale of relative apprehension.\n- Root: قدر (qadara)\n  * Lisan / Ayn: Root denotes measuring, determining, and the capacity to bring about an effect.\n  * Al-Raghib (Mufradat): \"القدرة إذا وصف بها الإنسان فاسم لهيئة له بها يتمكن من فعل شيء ما، وإذا وصف الله تعالى بها فهي نفي العجز عنه\" — power in man is a disposition enabling specific acts; power in God is absolute negation of incapacity, unrestricted and infinite.\n  * Al-Zamakhshari (Asas): Literal: \"هو قادر مقتدر ذو قدرة ومقدرة\" — the possessor of power. Metaphorical: extended to strength and dominion. The text contrasts finite human power (maqdūr) with divine power that encompasses all things without limit.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Self, soul, essence; the innermost reality of a thing.\n  * Al-Raghib (Mufradat): \"نفسه: ذاته\" — God's \"self\" is His very essence. For man, nafs denotes the composite self that requires discipline and reform (iṣlāḥ).\n  * Al-Zamakhshari (Asas): Literal: the self as the seat of attributes; metaphorical: \"دفق نفسه\" — blood/life. Here, \"سياسة نفسه\" (governance of one's self) is the literal, ethical sense.\n- Root: خلق (khalaqa)\n  * Lisan / Ayn: Root denotes measuring, smoothing, and fashioning; also moral character (khuluq).\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — origination by precise measure; used for creation ex nihilo and for formation from existing matter.\n  * Al-Zamakhshari (Asas): Literal: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom. The text uses \"الخبائث\" (vices) as the corruption of this created nature.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"فإنما غايته أن يقدر\" restricts human power to a finite limit, emphasizing that the utmost reach of creaturely capacity is merely partial and derivative, never absolute.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Contemplation'", "badge": "Afterlife"}], "12": [{"arabic": "وأنهم كلما أرادوا أن يخرجوا منها أعيدوا فيها وأنهم إذا رأوها من مكان بعيد سمعوا لها تغيظا وزفيرا وهلم جرا إلى جميع ما ورد في القرآن من شرحها وإذا أراد أن يستجلب حال الرجاء فلينظر إلى الجنة ونعيمها وأشجارها وأنهارها وحورها وولدانها ونعيمها المقيم وملكها الدائم", "english": "For example, if he observes in himself self-amazement (ʿujb) at his deeds, let him reflect and say: \"I performed this only with my body and my limbs, and by my power and my will — yet all of that is neither from me nor unto me. Rather, it is from God's creation and His bounty upon me. For He it is who created me, created my limbs, created my power and my will, and He it is who moves my organs by His power — and likewise my power and my will. So how can I marvel at my deed or at myself, when I do not sustain myself by myself?\"", "book_title": "Contemplation", "section_title_ar": "Section 1264", "section_title_en": "On the Paths of Reflection for Cultivating the Traits of Salvation (Section 1264)", "section_index": 1264, "anchors": "- Root: ع-ج-ب (ʿajiba)\n  * Lisan / Ayn: Self-amazement; the state of finding something wondrous, rooted in a perception of one's own act as extraordinary.\n  * Al-Raghib (Mufradat): ʿUjb (self-admiration) is a blameworthy trait that veils one from recognizing the divine origin of all power and action; it stems from ignorance (jahl) of God's sole agency.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) sense is wonder at something rare; metaphorical (majaz) usage here denotes moral corruption of the heart's intention (khabth al-dakhlah).\n- Root: ك-ب-ر (kabura)\n  * Lisan / Ayn: Bigness in stature or rank; arrogance (kibr) as a moral-spiritual inflation of the self against God's majesty.\n  * Al-Raghib (Mufradat): Kabir and saghir are relative terms; kibr (pride) is the soul's claim to greatness that belongs only to God, making it a root of ruin (muhlik).\n  * Al-Zamakhshari (Asas): Literal: physical or seniority-based greatness; metaphorical: the soul's false elevation, which is folly (hamaqah) since true greatness is measured by God's scale, unveiled only after death.\n- Root: ش-ه-و (shahiya)\n  * Lisan / Ayn: Appetitive desire; craving for food or copulation shared with beasts.\n  * Al-Raghib (Mufradat): Shahwah is a lower faculty; when dominant, it distances one from angelic attributes (knowledge, power) and aligns one with animal nature.\n  * Al-Zamakhshari (Asas): Literal: bodily craving; metaphorical: a sign of spiritual degradation, as perfection lies in divine attributes, not in bestial appetites.\n- Root: ر-ج-و (rajā)\n  * Lisan / Ayn: Hope; expectation of good.\n  * Al-Raghib (Mufradat): Rajāʾ is a salvific state (munjī) that balances fear (khawf), drawing the heart toward God's mercy and the promise of Paradise.\n  * Al-Zamakhshari (Asas): Literal: anticipation of a desired outcome; metaphorical: the soul's anchor against despair, cultivated by contemplating Paradise's eternal bliss.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction & Focused Predication): The particle innamā restricts the predicate to the subject alone, as in \"إنما عمل ببدني وجارحتي\" — affirming that the act's origin is solely through bodily instruments, not the self's independent power, thereby negating any ground for self-amazement.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "20": [{"arabic": "الحكم في موكبه فبهره ما رأى من حسن حاله وحسن هيئته فتلا قوله تعالى {وجعلنا بعضكم لبعض فتنة أتصبرون} ثم قال بلى أصبر وأرضى وكان فقيرا مقلا فالذي هو في بيته لا يبتلى بمثل هذه الفتن فإن من شاهد زينة الدنيا فأما أن يقوى دينه ويقينه فيصبر الى أن يتجرع مرارة الصبر وهو أمر من الصبر أو تنبعث رغبته فيحتال في طلب الدنيا فيهلك هلاكا مؤبدا أما في الدنيا فبالطمع الذي يخيب في أكثر الأوقات فليس كل من يطلب الدنيا تتيسر له وأما في الآخرة فإيثاره متاع الدنيا على ذكر الله تعالى والتقرب إليه ولذلك قال ابن الإعرابي إذا كان باب الذل من جانب الغنى .", "english": "As for the cutting off of people's hope in you, therein lie benefits. For the satisfaction of people is a goal that can never be attained; thus a man's occupation with reforming his own soul is more fitting. Among the easiest and lightest of obligations are attending funerals, visiting the sick, and attending banquets and wedding feasts — yet in these there is the squandering of hours and exposure to afflictions. Moreover, obstacles may hinder one from some of them, and excuses arise in facing them, yet one cannot disclose every excuse. So they say to him: \"You fulfilled so-and-so's right, but you fell short regarding our right\" — and this becomes a cause of enmity. For it has been said: Whoever does not visit the sick at the time of visiting — they wish for his death, fearing the shame he would bring upon them if he recovered, on account of his having fallen short.", "book_title": "Etiquette of Seclusion", "section_title_ar": "Section 455", "section_title_en": "The Revival of the Religious Sciences — Section 455: On the Fourth through Sixth Benefits of Seclusion", "section_index": 455, "anchors": "- Root: طمع (ṭamaʿ)\n  * Lisan / Ayn: Core lexical sense of craving, eager desire, and longing for something.\n  * Al-Raghib (Mufradat): \"الطمع: نزوع النفس إلى الشيء شهوة له\" — the soul's inclination toward a thing out of desire; often censured when it exceeds bounds, for \"الطمع طبع\" (greed is an innate disposition).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the soul's craving; metaphorical (majāz) usage extends to \"أطماع الجند\" (soldiers' rations) — that which is hoped for and expected. Here, the term oscillates between the blameworthy craving for worldly goods and the cutting off of such craving as a spiritual virtue.\n- Root: دنا (danā)\n  * Lisan / Ayn: Nearness in place, time, or rank; the world (al-dunyā) is so named because it is the nearer, lower abode.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by judgment; used of place, time, and station. The \"lower\" (adnā) is contrasted with the \"better\" (khayr) in {«أتستبدلون الذي هو أدنى بالذي هو خير»} [Al-Baqarah: 61].\n  * Al-Zamakhshari (Asas): Distinguishes dunuww (nearness) from danāʾah (baseness) — a crucial distinction, for the seclusion sought here is not base withdrawal but a drawing near to God through cutting worldly attachments.\n- Root: جنب (janb)\n  * Lisan / Ayn: The side or flank; extended metaphorically to mean \"beside,\" \"alongside,\" or \"avoiding.\"\n  * Al-Raghib (Mufradat): \"ثم يستعار من الناحية التي تليها\" — the side is used metaphorically for the region adjacent to it. From this root derives ijtināb (avoidance) — the act of keeping oneself to the side, away from harm.\n  * Al-Zamakhshari (Asas): Majāz: \"اتق الله الذي لا جنيبة له\" — fear God who has no equal; and \"فرطت في جنب الله\" — I fell short in God's side (i.e., His due). The root thus carries both the sense of physical separation and the higher spiritual connotation of keeping oneself apart for God's sake.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing permissible separation between a preposition and its object, allowing for rhetorical emphasis and periodic sentence structure. Applied here in the extended conditional and causal constructions (fa-inna... fa-fīhi fawāʾid) where the apodosis is deferred for effect.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Seclusion'", "badge": "Insight"}], "21": [{"arabic": "تعالى {إنه لا يحب المستكبرين} وقال تعالى {لقد استكبروا في أنفسهم وعتوا عتوا كبيرا} وقال تعالى {إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} وذم الكبر في القرآن كثير وقد قال رسول الله صلى الله عليه وسلم لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر ولا يدخل الجنة من كان في قلبه مثقال حبة من خردل من إيمان (1) حديث أبي هريرة يقول الله تعالى الكبرياء ردائي والعظمة إزاري فمن نازعني واحدا منهما ألقيته في جهنم أخرجه مسلم وأبو داود وابن ماجه واللفظ له وقال أبو داود قذفته في النار وقال مسلم عذبته وقال رداؤه وإزا", "english": "To proceed: The Messenger of God, may God bless him and grant him peace, said — God, exalted be He, said: \"Pride (al-kibriyāʾ) is My cloak, and greatness (al-ʿaẓamah) is My wrapper; whoever contends with Me over either of them, I crush him.\" {«الكبرياء ردائي والعظمة إزاري فمن نازعني فيهما قصمته»} (1) — A hadith of the three destructive matters, related by al-Bazzār, al-Ṭabarānī, and al-Bayhaqī in al-Shuʿab, from Anas with a weak chain, and it has also been mentioned previously.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 847", "section_title_en": "The Book of Condemnation of Pride and Self-Admiration — Being the Ninth Book of the Quarter of Destructive Matters from The Revival of the Religious Sciences", "section_index": 847, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"al-kibriyā'\" is the supreme majesty exclusive to God.\n  * Al-Raghib (Mufradat): \"al-kabīr wa al-ṣaghīr\" are relative terms; used for quantity, quality, and dignity. \"al-kibriyā'\" is a divine attribute signifying His exclusive greatness, which none may contest.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"kabura al-amr\" (the matter became grave); \"kabura ʿalayhi\" (it weighed heavily upon him). Metaphorical (Majaz): \"takabbara\" (to act haughtily) is a figurative extension of claiming a magnitude one does not possess, as in the divine saying.\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Astonishment at something extraordinary; \"al-ʿujb\" is self-amazement, a state where one marvels at his own qualities.\n  * Al-Raghib (Mufradat): Astonishment arises from ignorance of the true cause; self-admiration (ʿujb) blinds one to one's own defects and to the divine origin of all good.\n  * Al-Zamakhshari (Asas): Literal: \"ʿajiba minhu\" (he marveled at it). Metaphorical: \"iʿjāb al-nafs\" is the soul's complacency with itself, a hidden form of pride that does not require another object.\n- Root: هلك (h-l-k)\n  * Lisan / Ayn: Perishing, destruction, ruin; \"al-muhlikāt\" are the things that cause perdition.\n  * Al-Raghib (Mufradat): Destruction is of three kinds: loss, corruption, and death. Here it is spiritual perdition — the ruin of the soul's eternal felicity.\n  * Al-Zamakhshari (Asas): Literal: physical ruin. Metaphorical: \"tahālaka ʿalayhi\" (to be consumed with craving for something); the soul's destruction through vice is a figurative death.\n- Sibawayh Rule: Rule of Apposition and Parenthetical Clauses (al-badal wa al-iʿtirāḍ) — The opening doxology employs extended appositional chains (badal) and parenthetical invocations that delay the main clause, requiring the translator to preserve the periodic structure without collapsing the theological weight of each divine epithet.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'", "badge": "Hadith"}, {"arabic": "مثلكم إنكم إذا لخاسرون وقال الذين لا يرجون لقاءنا لولا أنزل علينا الملائكة أو نرى ربنا لقد استكبروا في أنفسهم وعتوا عتوا كبيرا وقالوا لولا أنزل عليه ملك وقال فرعون فيما أخبر الله عنه {أو جاء معه الملائكة مقترنين} وقال الله تعالى {واستكبر هو وجنوده في الأرض بغير الحق} فتكبر هو على الله وعلى رسله جميعا قال وهب قال له موسى عليه السلام آمن ولك ملكك قال حتى أشاور هامان فشاور هامان فقال هامان بينما أنت رب يعبد إذ صرت عبد تعبد فاسنكف عن عبودية الله وعن اتباع موسى عليه السلام وقالت قريش فيما أخبر الله تعالى عنهم {لولا نزل هذا القرآن على رجل من القريتين عظيم} قال قتاده عظيم", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "23": [{"arabic": "عمل كان بإرادة غير الله مشوبا مغمورا {وقدمنا إلى ما عملوا من عمل فجعلناه هباء منثورا} وليت شعري كيف يصحح نيته من لا يعرف حقيقة النية أو كيف يخلص من صحح النية إذا لم يعرف حقيقة الإخلاص أو كيف تطالب المخلص نفسه بالصدق إذا لم يتحقق معناه فالوظيفة الأولى على كل عبد أراد طاعة الله تعالى أن يتعلم النية أولا لتحصل المعرفة ثم يصححها بالعمل بعد فهم حقيقة الصدق والإخلاص اللذين هما وسيلتنا العبد إلى النجاة والخلاص ونحن نذكر معاني الصدق والإخلاص في ثلاثة أبواب الباب الأول في حقيقة النية ومعناها الباب الثاني في الإخلاص وحق", "english": "We praise God with the praise of the thankful, and we believe in Him with the faith of the certain, and we affirm His Oneness with the affirmation of the truthful. And we bear witness that there is no god but God, Lord of the worlds, Creator of the heavens and the earths, and the One Who charges the jinn, mankind, and the angels brought near with the duty to worship Him with the worship of the sincere. For He, exalted, said: {«وما أمروا إلا ليعبدوا الله مخلصين له الدين»} — \"And they were not commanded except to worship God, making their religion pure for Him\" {Quran 98:5}. For God has no need except for religion that is pure and firm, for He is the Richest of the rich, beyond any need for the partnership of those who associate others with Him. And blessings upon His Prophet Muhammad, the Master of the Messengers, and upon all the prophets, and upon his family and companions, the good and the pure.", "book_title": "Fear and Hope", "section_title_ar": "Section 1205", "section_title_en": "The Book of Intention, Sincerity, and Truthfulness — Book Seven of the Quarter of Deliverance from The Revival of the Religious Sciences", "section_index": 1205, "anchors": "- Root: نية (N-Y-Y)\n  * Lisan / Ayn: Core root denotes intent, purpose, resolve directed toward an aim; the heart's orientation toward an act.\n  * Al-Raghib (Mufradat): Theological nuance — niyyah is the soul's decisive inclination (qasd) toward an act for a specific end, distinguishing voluntary acts from mere motions.\n  * Al-Zamakhshari (Asas): Literal — resolved purpose; Metaphorical — the heart's turning toward an object of worship or obedience, making it the inner dimension of 'ibadah.\n- Root: خلص (Khl-S)\n  * Lisan / Ayn: Core root — purity after admixture; that which is sifted free of dross.\n  * Al-Raghib (Mufradat): ikhlas is the purification of an act from any motive other than God — the removal of shubah (adulteration) that was present.\n  * Al-Zamakhshari (Asas): Literal — refining gold or clarified butter; Metaphorical — \"akhlasa lillahi dinahu\" (he made his religion pure for God), i.e., exclusive devotion.\n- Root: صدق (Sd-Q)\n  * Lisan / Ayn: Core root — firmness, veracity in speech and resolve.\n  * Al-Raghib (Mufradat): sidq is primarily in speech (khabar), but secondarily in action and resolve — truthfulness of the heart's commitment.\n  * Al-Zamakhshari (Asas): Literal — truthful speech; Metaphorical — \"sadaqa al-hamlata\" (he was true in the charge), i.e., unwavering fulfillment of a covenant or act.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure here interposes qualifying clauses between the governing verb and its object to layer conditions (e.g., \"how can he purify... if he does not know...\"), requiring the translator to preserve the conditional cascade without collapsing the hierarchy of epistemic prerequisites.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "26": [{"arabic": "وكذلك سمع مرة قوله تعالى {الملك يومئذ الحق للرحمن} فاضطرب فسأله ابن سالم وكان من أصحابه فقال قد ضعفت فقيل له فإن كان هذا من مضعف فما قوة الحال فقال أن لا يرد عليه وارد إلا وهو يلتقيه بقوة حاله فلا تغيره الواردات وإن كانت قوية وسبب القدرة على ضبط الظاهر مع وجود الوجد استواء الأحوال بملازمة الشهود كما حكي عن سهل رحمه الله تعالى أنه قال حالتي قبل الصلاة وبعدها واحدة لأنه كان مراعيا للقلب حاضر الذكر مع الله تعالى في كل حال فكذلك يكون قبل السماع وبعده إذ يكون وجده دائما وعطشه متصلا وشربه مستمرا بح", "english": "And it is related that Moses — peace be upon him — was preaching among the Children of Israel, and one of them tore his garment or his shirt. So God — exalted be He — revealed to Moses — peace be upon him: \"Say to him: Tear for Me your heart, and do not tear your garment.\"", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 517", "section_title_en": "The Revival of the Religious Sciences — Section 517: On the Steadfastness of the Strong in the Face of Ecstatic Samaʿ, and the Degrees of Manifestation and Restraint", "section_index": 517, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform from one state to another; the heart as that which is perpetually fluctuating and being overturned between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's turning and overturning is its being diverted from one disposition to another. The heart (qalb) is so named for its constant fluctuation (taqallub) between states.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — to turn pupils back to their homes; and \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and manages them. Here, the heart's being \"split\" (inshaqqa) and its \"turning\" (taqallub) in the unseen realm (malakūt) are majaz for the soul's profound transformation.\n- Root: ظهر (ẓ-h-r)\n  * Lisan / Ayn: The back; the outward, visible surface as opposed to the hidden interior.\n  * Al-Raghib (Mufradat): \"الظهر الجارحة\" — the back as a bodily limb; used metaphorically for the outward aspect of the earth: \"ظهر الأرض وبطنها\" — its surface and its interior.\n  * Al-Zamakhshari (Asas): Literal: \"رجل مظهر: قوي الظهر\" — a man strong of back. Metaphorical: \"قلبت الأمر ظهرا لبطن\" — to turn the matter over, back and belly, i.e., to examine it thoroughly. In this section, the \"outward\" (zāhir) is the domain of the bodily members (jawāriḥ) which must be restrained, while the \"inward\" (bāṭin) is the domain of the heart's ecstasy (wajd).\n- Root: حول (ḥ-w-l)\n  * Lisan / Ayn: To change, to turn, to shift from one state to another; power and capacity to effect change.\n  * Al-Raghib (Mufradat): \"أصل الحول تغير الشيء وانفصاله عن غيره\" — the root meaning is the changing of a thing and its separation from another. \"حال بيني وبينك كذا\" — something intervened between me and you.\n  * Al-Zamakhshari (Asas): Literal: \"حال عليه الحول\" — a year passed over it. Metaphorical: \"لقحت الحرب عن حيال\" — war conceived after a period of barrenness. Here, \"ḥāl\" (state/condition) and \"taḥawwul\" (transformation) denote the changing spiritual conditions that assail the heart, and the power (ḥawl) to restrain the outward members.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; breath; that which is precious and valued.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the self is the spirit; \"نفسه: ذاته\" — His Self is His Essence. The soul is that which is breathed out and drawn in, and by extension, the living self.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — he poured out his self, i.e., his blood. In this text, \"nafsahu\" (his self/soul) departs at death when the heart is split by suppressed ecstasy.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — The periodic structure of al-Ghazali's conditional sentences (fa-in qulta... fa-'lam) follows the classical pattern of protasis and apodosis, where the apodosis is introduced by the particle fa- to mark the resumption of the main clause after a lengthy conditional protasis, preserving syntactic cohesion across extended theological arguments.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Audition and Ecstasy'", "badge": "Insight"}], "27": [{"arabic": "قدمت لحياتي يا ليتني اتخذت مع الرسول سبيلا يا ويلتا ليتني لم أتخذ فلانا خليلا يا ليتني كنت ترابا يا ليتني كنت نسيا منسيا يا ليت أمي لم تلدني وعند ذلك تختطفك النيران والعياذ بالله وينادي المنادي {اخسؤوا فيها ولا تكلمون} فلا يبقى سبيل إلا الصياح والأنين والتنفس والاستغاثة فكيف ترى الآن عقلك وهذه الأخطار بين يديك فإن كنت غير مؤمن بذلك فما أطول مقامك مع الكفار في دركات جهنم وإن كنت به مؤمنا وعنه غافلا وبالاستعداد له متهاونا فما أعظم خسرانك وطغيانك وماذا ينفعك إيمانك إذا لم يبعثك ع", "english": "Then, after these terrors, reflect upon the saying of God Most High: {«On the Day We shall gather the righteous to the All-Merciful as a delegation, and drive the criminals to Hell as a thirsty herd»} and upon His saying: {«Then lead them to the path of Hellfire, and stop them, for they shall be questioned»}. For after these terrors, mankind is driven to the Bridge — and it is a bridge stretched across the surface of the Fire, sharper than a sword and finer than a hair. Whoever was upright in this world upon the straight path (al-ṣirāṭ al-mustaqīm) will pass lightly over the Bridge of the Hereafter and be saved. But whoever deviated from uprightness in this world, weighed down his back with heavy burdens (awzār) of sin, and disobeyed — he will stumble at the very first step of the Bridge and plummet down.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1344", "section_title_en": "The Description of the Bridge (Ṣirāṭ) and the Redress of Grievances", "section_index": 1344, "anchors": "- Root: صرط (Ṣirāṭ)\n  * Lisan / Ayn: The root denotes the straight path, a road; lexically, al-ṣirāṭ is the clear, broad way.\n  * Al-Raghib (Mufradat): In Quranic usage, al-ṣirāṭ al-mustaqīm is the path of truth and obedience leading to God, contrasted with the paths of error and perdition.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for a physical bridge/road; metaphorical (majāz) for the moral and religious course of conduct in this world that determines one's passage in the hereafter.\n- Root: زلل (Zalala)\n  * Lisan / Ayn: To slip, stumble, or err; a foot slipping from its place.\n  * Al-Raghib (Mufradat): Used both physically (slipping on a path) and morally (falling into sin and error); the Hereafter's slipping is the consequence of worldly deviation.\n  * Al-Zamakhshari (Asas): Literal for the foot's slip on the Bridge; metaphorical for deviation from the straight path in deeds and belief.\n- Root: خطف (Khaṭafa)\n  * Lisan / Ayn: To snatch away swiftly and violently.\n  * Al-Raghib (Mufradat): The angels of punishment snatch souls and bodies with hooks; denotes sudden seizure by divine decree.\n  * Al-Zamakhshari (Asas): Literal for the physical snatching by iron hooks (kalālīb); metaphorical for the sudden ruin caused by one's own works.\n- Sibawayh Rule: Rule of Interposition and Parenthetical Clauses (al-iʿtirāḍ) — The frequent vocative cries (e.g., \"yā laytanī\") and exclamatory interruptions (e.g., \"fa-yā layta\") are syntactically embedded as parenthetical invocations within the periodic narrative, preserving the rhetorical flow of lament without breaking the grammatical dependency of the surrounding clauses.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "28": [{"arabic": "قدمت لحياتي يا ليتني اتخذت مع الرسول سبيلا يا ويلتا ليتني لم أتخذ فلانا خليلا يا ليتني كنت ترابا يا ليتني كنت نسيا منسيا يا ليت أمي لم تلدني وعند ذلك تختطفك النيران والعياذ بالله وينادي المنادي {اخسؤوا فيها ولا تكلمون} فلا يبقى سبيل إلا الصياح والأنين والتنفس والاستغاثة فكيف ترى الآن عقلك وهذه الأخطار بين يديك فإن كنت غير مؤمن بذلك فما أطول مقامك مع الكفار في دركات جهنم وإن كنت به مؤمنا وعنه غافلا وبالاستعداد له متهاونا فما أعظم خسرانك وطغيانك وماذا ينفعك إيمانك إذا لم يبعثك على السعي في طلب رضا الله تعالى بطاعت", "english": "Then, after these terrors, reflect upon the saying of God Most High: {«On the Day We shall gather the righteous to the All-Merciful as a delegation, and drive the criminals to Hell as a thirsty herd»} and upon His saying: {«Then lead them to the path of Hellfire, and stop them, for they shall be questioned»}. For after these terrors, mankind is driven to the Bridge — and it is a bridge stretched across the surface of the Fire, sharper than a sword and finer than a hair. Whoever was upright in this world upon the straight path (al-ṣirāṭ al-mustaqīm) will pass lightly over the Bridge of the Hereafter and be saved. But whoever deviated from uprightness in this world, weighed down his back with heavy burdens (awzār) of sin, and disobeyed — he will stumble at the very first step of the Bridge and plummet down.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1344", "section_title_en": "The Description of the Bridge (Ṣirāṭ) and the Redress of Grievances", "section_index": 1344, "anchors": "- Root: صرط (Ṣirāṭ)\n  * Lisan / Ayn: The root denotes the straight path, a road; lexically, al-ṣirāṭ is the clear, broad way.\n  * Al-Raghib (Mufradat): In Quranic usage, al-ṣirāṭ al-mustaqīm is the path of truth and obedience leading to God, contrasted with the paths of error and perdition.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for a physical bridge/road; metaphorical (majāz) for the moral and religious course of conduct in this world that determines one's passage in the hereafter.\n- Root: زلل (Zalala)\n  * Lisan / Ayn: To slip, stumble, or err; a foot slipping from its place.\n  * Al-Raghib (Mufradat): Used both physically (slipping on a path) and morally (falling into sin and error); the Hereafter's slipping is the consequence of worldly deviation.\n  * Al-Zamakhshari (Asas): Literal for the foot's slip on the Bridge; metaphorical for deviation from the straight path in deeds and belief.\n- Root: خطف (Khaṭafa)\n  * Lisan / Ayn: To snatch away swiftly and violently.\n  * Al-Raghib (Mufradat): The angels of punishment snatch souls and bodies with hooks; denotes sudden seizure by divine decree.\n  * Al-Zamakhshari (Asas): Literal for the physical snatching by iron hooks (kalālīb); metaphorical for the sudden ruin caused by one's own works.\n- Sibawayh Rule: Rule of Interposition and Parenthetical Clauses (al-iʿtirāḍ) — The frequent vocative cries (e.g., \"yā laytanī\") and exclamatory interruptions (e.g., \"fa-yā layta\") are syntactically embedded as parenthetical invocations within the periodic narrative, preserving the rhetorical flow of lament without breaking the grammatical dependency of the surrounding clauses.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "34": [{"arabic": "القيامة وقد تعلق الخصماء بهم والملائكة آخذون بنواصيهم يجرونهم على وجوههم إلى جهنم في مظالم العباد لتبرأ إلى الله منهم ولكان انتسابه إلى الكلب والخنزير أحب إليه من الانتساب إليهم فحق أولاد الظلمة إن عصمهم الله من ظلمهم أن يشكروا الله تعال على سلامة دينهم ويستغفروا لآبائهم إن كانوا مسلمين فأما العجب فجهل محض السادس العجب بكثرة العدد من الأولاد والخدم والغلمان والعشيرة والأقارب والأنصار والأتباع كما قال الكفار {نحن أكثر أموالا وأولادا} وكما قال المؤمنون يوم حنين لا نغلب اليوم من قلة وعلاجه ما ذكرناه في الكبر وهو أن ي", "english": "If you say: \"He, peace and blessings be upon him, said after his words to Fāṭimah and Ṣafiyyah: 'I cannot avail you against God in anything, except that you have a tie of kinship which I will moisten with its moisture'\" — a ḥadīth [reported as]: \"Do you hope for my intercession, while the Banū ʿAbd al-Muṭṭalib do not hope for it?\" — narrated by al-Ṭabarānī in al-Awsaṭ from the narration of ʿAbd Allāh ibn Jaʿfar, and in it is Uṣayrim ibn Ḥawshab from Isḥāq ibn Wāṣil, and both are extremely weak — so that indicates that he will single out his relatives for intercession.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 882", "section_title_en": "Section 882 — On the Limits of Intercession, the Vices of Pride in Lineage, Numbers, Wealth, and Opinion, and Their Treatment", "section_index": 882, "anchors": "- Root: شفع (Sh-F-')\n  * Lisan / Ayn: Core meaning is pairing or joining; intercession (shafā'ah) is the joining of one's plea to another's cause.\n  * Al-Raghib (Mufradat): Intercession is the seeking of benefit for another; its acceptance is contingent upon divine permission and good pleasure, as restricted by the Qur'anic qualifiers.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) is the act of making a number even (from watr, odd); metaphorical (majāz) is the mediator's plea before authority.\n- Root: عجب (ʿ-J-B)\n  * Lisan / Ayn: Astonishment arising from an unknown cause; self-admiration (ʿujb) is a blameworthy state of being pleased with oneself.\n  * Al-Raghib (Mufradat): \"العجب والتعجب: حالة تعرض للإنسان عند الجهل بسبب الشيء\" — a state that overtakes a person due to ignorance of the cause; hence, it is impossible regarding God.\n  * Al-Zamakhshari (Asas): Literal: a wondrous thing; metaphorical: the one who performs marvels (taʿjābah). Self-admiration is the root of every error and innovation.\n- Root: رأي (R-'-Y)\n  * Lisan / Ayn: Opinion, view, or judgment formed through reflection.\n  * Al-Raghib (Mufradat): Ra'y is the considered opinion that may err or hit the mark; it is blameworthy when it becomes an object of ʿujb (self-admiration).\n  * Al-Zamakhshari (Asas): Literal: sight/vision; metaphorical: intellectual insight. The ḥadīth \"إعجاب كل ذي رأي برأيه\" (the admiration of every man of opinion for his own view) is cited as a sign of the age's corruption.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Qualification) — The conditional clauses (in-sharṭ) governing intercession, e.g., {إلا لمن ارتضى} and {إلا بإذنه}, impose necessary restrictions that negate any absolute reliance on intercession.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'", "badge": "Hadith"}], "38": [{"arabic": "وكان الربيع بن خثيم أصابه فالج فقيل له لو تداويت فقال قد هممت ثم ذكرت عادا وثمود وأصحاب الرس وقرونا بين ذلك كثيرا وكان فيهم الأطباء فهلك المداوي والمداوى ولم تغن الرقي شيئا وكان أحمد بن حنبل يقول أحب لمن اعتقد التوكل وسلك هذا الطريق ترك التداوي من شرب الدواء وغيره وإن كان به علل فلا يخبر المتطبب بها أيضا إذا سأله وقيل لسهل متى يصح للعبد التوكل قال إذا دخل عليه الضرر في جسمه والنقص في ماله فلم يلتفت إليه شغلا بحاله وينظر إلى قيام الله تعالى عليه فإذا منهم من ترك التداوي وراءه ومنهم من كرهه ولا يتضح وجه الجمع بين فعل رسولالله صلى الله عليه وسلم وأفع", "english": "It has been related that Abū Bakr al-Ṣiddīq (may Allah be pleased with him) — when it was said to him, \"Shall we call a physician for you?\" — replied: \"The Physician has already looked upon me and said: {«إني فعال لما أريد»} — 'Indeed, I am the Doer of whatsoever I will' [Q. 11:107].\"", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1137", "section_title_en": "On the Reasons for Abandoning Medical Treatment Among the Righteous Predecessors", "section_index": 1137, "anchors": "- Root: دوي (d-w-y)\n  * Lisan / Ayn: Core root denotes treating illness, administering remedy (al-dawā'), and the act of seeking cure (al-tadāwī).\n  * Al-Raghib (Mufradat): Theological nuance: tadāwī pertains to corporeal ailments (amrāḍ jismāniyyah), distinct from spiritual maladies (amrāḍ qalbiyyah) which require the remedy of repentance and remembrance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"تداوى من مرضه\" — to seek medical treatment. Metaphorical (majāz): \"تداوى من الجهل\" — to cure ignorance through knowledge; here, the literal sense governs bodily medicine, while the metaphorical extends to spiritual healing.\n- Root: كل (k-l-l) [as in توكّل]\n  * Lisan / Ayn: Root k-w-l; tawakkul: to entrust one's affair wholly to another, to rely upon a guardian (wakīl).\n  * Al-Raghib (Mufradat): \"التوكل: أن تعتمد على غيرك وتجعله نائبا عنك\" — reliance upon God as the sole agent (wakīl) in all matters, including health and sustenance.\n  * Al-Zamakhshari (Asas): Literal: appointing a deputy. Metaphorical: \"توكل على الله ولا تتكل على غيره\" — the believer's utter dependence on God, which may override secondary causes like medicine.\n- Root: شغل (sh-gh-l)\n  * Lisan / Ayn: Occupation, preoccupation that diverts the mind (al-shughl: al-ʿāriḍ alladhī yudh-hilu al-insān).\n  * Al-Raghib (Mufradat): \"الشغل: العارض الذي يذهل الإنسان\" — a state that causes forgetfulness of other concerns; here, spiritual preoccupation (shughl bi-ḥālihi) with one's standing before God eclipses bodily pain.\n  * Al-Zamakhshari (Asas): Literal: being busy with affairs. Metaphorical: \"دار مشغولة: فيها سكان\" — a heart \"occupied\" by divine awe, leaving no room for attending to physical ailments.\n- Root: كشف (k-sh-f)\n  * Lisan / Ayn: Unveiling, disclosure; mukāshafah: the removal of the veil (kashf al-ghitā') granting direct perception of unseen realities.\n  * Al-Raghib (Mufradat): Theological: mukāshafah is the divine unveiling granted to saints (awliyā') whereby they perceive what is hidden from ordinary senses — here, knowledge of the appointed term (ajal).\n  * Al-Zamakhshari (Asas): Literal: removing a covering. Metaphorical: \"كشف الأمر\" — the revelation of a hidden truth; in Sufi terminology, a verified unveiling (kashf muḥaqqaq) of one's death-hour.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction & Focused Predication) — The particle innamā restricts the predicate exclusively to the subject, as in \"إنما هن أختاك\" (they are only your two sisters), used to correct ʿĀ'ishah's misapprehension regarding inheritance, and \"إنما أشتكي ذنوبي\" (I complain only of my sins), restricting Abū al-Dardā''s complaint to spiritual, not bodily, ailment.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "42": [{"arabic": "عدا هؤلاء فهم المغرورون بالله وسوف يعلمون حين يرون العذاب من أضل سبيلا ولتعلمن نبأه بعد حين وعند ذلك يقولون كما أخبر الله عنهم ربنا أبصرنا وسمعنا فارجعنا نعمل صالحا إنا موقنون أي علمنا أنه كما لا يولد إلا بوقاع ونكاح ولا ينبت زرع إلا بحراثة وبث بذر فكذلك لا يحصل في الآخرة ثواب وأجر إلا بعمل صالح فارجعنا نعمل صالحا فقد علمنا الآن صدقك في قولك وأن ليس للإنسان إلا ما سعى وأن سعيه سوف يرى كلما ألقى فيها فوج سألهم خزنتها ألم يأتكم نذير قالوا بلى قد جاءنا نذير أي ألم نسمعكم سنة الله في عباده وأنه", "english": "I say: God—exalted is He—loves the obedient and hates the disobedient. So just as He does not hate the obedient father because of His hatred for the disobedient son, likewise He does not love the disobedient son because of His love for the obedient father. And if love were to flow from the father to the son, then hatred would likewise be bound to flow. Rather, the truth is: {«ولا تزر وازرة وزر أخرى»} — \"And no bearer of burdens will bear the burden of another\" {Quran 6:164, 17:15, 35:18, 39:7, 53:38}. And whoever supposes that he will be saved by his father's piety is like one who supposes he will be satiated by his father's eating, quenched by his father's drinking, become a scholar by his father's learning, and reach the Ka'bah and see it by his father's walking.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 889", "section_title_en": "The Reality of Hope (Al-Rajā') and the Futility of Reliance on Another's Piety", "section_index": 889, "anchors": "- Root: و ل د (walada)\n  * Lisan / Ayn: Physical begetting and offspring; the father's generative act.\n  * Al-Raghib (Mufradat): \"الولد: المولود\" — offspring as a created entity; here used metaphorically for spiritual causation.\n  * Al-Zamakhshari (Asas): Literal: physical birth. Metaphorical: \"تولدت العصبية\" — something generated or produced from another; Ghazali exploits this to refute the notion that a father's obedience \"generates\" salvation for the son.\n- Root: ر ج و (rajā)\n  * Lisan / Ayn: Expectation, hope, longing for a favorable outcome.\n  * Al-Raghib (Mufradat): Hope tied to legitimate means; not mere wishful thinking (tamannī).\n  * Al-Zamakhshari (Asas): Literal: awaiting rain. Metaphorical: \"رجوت فلانا\" — to expect from someone; Ghazali contrasts true hope (with action) vs. delusion (ghurūr).\n- Root: غ ر ر (gharara)\n  * Lisan / Ayn: Deception, heedlessness, being lured by a false appearance.\n  * Al-Raghib (Mufradat): The state of one who is duped by Satan's plausible speech.\n  * Al-Zamakhshari (Asas): Literal: a risky venture. Metaphorical: \"اغتر بفلان\" — to be deceived by outward charm while the inner reality is corrupt.\n- Root: ك ي س (kays)\n  * Lisan / Ayn: Intelligence, shrewdness, prudence.\n  * Al-Raghib (Mufradat): The wise man who disciplines his soul and acts for the afterlife.\n  * Al-Zamakhshari (Asas): Literal: alertness. Metaphorical: \"الكيس من دان نفسه\" — the prudent one who holds his soul to account; antonym of \"الأحمق\" (the fool).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يوفى الصابرون أجرهم بغير حساب\" style; Ghazali uses \"إنما\" to restrict reward to personal action, and \"ليس للإنسان إلا ما سعى\" as a restrictive negative clause (nafy + illā) to deny any transfer of merit.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Delusion'", "badge": "Afterlife"}], "43": [{"arabic": "تعالى ولا معبود غيره ومن اتخذ إلهه هواه فهو بعيد من الصدق في توحيده وأمره مخطر في نفسه فإن عجزت عن ذلك كله فكن محبا لرسول الله صلى الله عليه وسلم حريصا على تعظيم سننه ومتشوقا إلى مراعاة قلوب الصالحين من أمته ومتبركا بأدعيتهم فعساك أن تنال من شفاعته أو شفاعتهم فتنجو بالشفاعة إن كنت قليل البضاعة", "english": "And on the authority of Ibn Masʿūd, may God be pleased with him, that the Prophet, peace and blessings be upon him, said: \"God will gather the first and the last for an appointed time on a known Day, standing for forty years, their eyes fixed heavenward, awaiting the verdict of judgment.\" And he mentioned the ḥadīth until he reached the time of the prostration of the believers. He said: \"Then He will say to the believers: 'Raise your heads.' So they raise their heads, and they are given their light according to their deeds. Among them is one who is given his light like a great mountain, racing before him; among them is one who is given his light smaller than that; among them is one who is given his light like a palm tree; among them is one who is given his light smaller than that—until the last of them is a man who is given his light upon the toe of his foot. It shines once and dims once. When it shines, he steps forward with his foot and walks; when it darkens, he stands still.\" Then he mentioned their crossing over the Bridge (al-Ṣirāṭ) according to their light: among them is one who crosses like the blink of an eye; among them is one who crosses like lightning; among them is one who crosses like a cloud; among them is one who crosses like the shooting of stars; among them is one who crosses like the gallop of a horse; among them is one who crosses like the running of a man—until the one who was given his light upon the toe of his foot crosses, crawling on his face, hands, and feet. One hand is dragged while another clings; one foot is caught while another is dragged, and the fire touches his sides. He said: \"He will not cease thus until he is delivered. When he is delivered, he stands over it (the fire), then says: 'Praise be to God! God has given me what He has not given anyone, for He saved me from it after I had seen it.' Then he is taken to a pool at the gate of Paradise and bathes therein.\" (2) And Anas ibn Mālik said: \"I heard the Messenger of God, peace and blessings be upon him, say: 'The Bridge is like the edge of a sword or like the edge of a hair. The angels save the believing men and the believing women, and Gabriel, peace be upon him, takes hold of my waist, and I say: \"O Lord, save, save!\" The slipers and slippers among men and women on that Day are many.'\" (3)", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1345", "section_title_en": "The Terrors of the Bridge (Ṣirāṭ) and the Reality of Fear", "section_index": 1345, "anchors": "- Root: نور (n-w-r)\n  * Lisan / Ayn: Core meaning of radiant light, illumination, and luminosity; the source of visibility.\n  * Al-Raghib (Mufradat): Light is of two kinds: sensory (perceived by the eye) and intellectual/spiritual (perceived by the inner eye of insight). The light granted to the believers on the Day of Resurrection is a spiritual light (nūr maʿnawī) apportioned by divine justice according to their deeds, manifesting their degree of faith and works.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to physical illumination; metaphorical (majāz) usage refers to clarity, guidance, and manifestation. Here, the \"light\" is a metaphorical extension of the believer's true faith and righteous action, made perceptible in the Hereafter.\n- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Fear, dread, apprehension of a harmful or painful event.\n  * Al-Raghib (Mufradat): Fear (khawf) is the anticipation of something disliked, based on a probable or certain sign. It is the opposite of security (amn). True fear is a cognitive and motivational state that drives one to avoid its object, not mere emotional softness.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is the emotion of fear; metaphorical (majāz) usage, as in \"a fearful road\" (ṭarīq khāʾif), denotes a place or state that causes fear. Al-Ghazali here critiques the metaphorical \"fear\" of the foolish—mere verbal utterance without behavioral consequence.\n- Root: قدم (q-d-m)\n  * Lisan / Ayn: Foot; also precedence and advancement.\n  * Al-Raghib (Mufradat): The foot (qadam) is the instrument of standing and walking; from it, concepts of precedence (taqaddum) and delay are derived. In the ḥadīth, the light placed on the toe (ibhām al-qadam) signifies the minimal degree of faith, barely sufficient for movement.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is the physical foot; metaphorical (majāz) usage, as in \"place it under your feet\" (i.e., forgive it), indicates subjugation or minimal standing. Here, the toe's light is literal in the eschatological scene but symbolically denotes the weakest degree of saving faith.\n- Root: حصن (ḥ-ṣ-n)\n  * Lisan / Ayn: A fortress, an impregnable stronghold; that which protects its interior from penetration.\n  * Al-Raghib (Mufradat): A fortress (ḥiṣn) is a place of refuge; metaphorically, it applies to anything that provides protection, such as armor or a chaste woman. True protection from the terrors of the Hereafter is not a physical fortress but the sincere utterance of \"lā ilāha illā Allāh.\"\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is a fortified structure; metaphorical (majāz) usage, as in \"he came carrying a fortress\" (i.e., weapons), denotes any means of defense. Al-Ghazali employs this metaphorically: the only fortress against the terrors of the Hereafter is sincere monotheism.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its object by an intervening clause, as in \"فأنى يغني عنه ذلك من السبع\" (So how can that avail him against the lion?), where the syntactic structure emphasizes the futility of the verbal refuge.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}, {"arabic": "قال الله تعالى {أفرأيت من اتخذ إلهه هواه} وقال صلى الله عليه وسلم أبغض إله عبد في الأرض", "english": "They have manipulated this term through specification (takhṣīṣ), not through transfer (naql) or conversion (taḥwīl), for they have restricted it to knowledge of obscure legal branches (furūʿ gharībah) in legal opinions (fatāwā), to grasping the subtleties of their underlying causes (ʿilal), to multiplying discourse concerning them, and to memorizing the doctrinal positions related to them. Whoever is more profound in this and more occupied with it is called \"the most learned in fiqh\" (al-afqah). Yet in the first era, the name fiqh was applied absolutely to knowledge of the path of the Hereafter, to knowing the subtleties of the maladies of the souls (āfāt al-nufūs), to the corrupters of deeds (mufsidāt al-aʿmāl), to the power of encompassing the pettiness of this world, to intense longing for the bliss of the Hereafter, and to the dominance of fear over the heart. What indicates this to you is His saying, Mighty and Majestic: {«ليتفقهوا في الدين ولينذروا قومهم إذا رجعوا إليهم»} [“That they may gain understanding in the religion and warn their people when they return to them”] (Q 9:122). What effects warning and intimidation is this very fiqh — not the subdivisions of divorce (ṭalāq), manumission (ʿitāq), imprecation (liʿān), salam contracts, and leases (ijārah). For that (latter) does not produce warning or intimidation; rather, total devotion to it perpetually hardens the heart and strips away godly fear (khashyah) from it, as we now observe in those wholly devoted to it.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 27", "section_title_en": "The Revival of the Religious Sciences — Section 27: The Corruption of the Praiseworthy Names (Taḥrīf al-Asāmī al-Maḥmūdah)", "section_index": 27, "anchors": "- Root: فقه (Fiqh)\n  * Lisan / Ayn: Core linguistic meaning of \"understanding\" (al-fahm) and \"comprehension\" (al-fahm ʿan al-shayʾ)\n  * Al-Raghib (Mufradat): \"Al-fiqh: attainment of knowledge of the unseen through a witnessed sign — it is more specific than ʿilm.\" Theological nuance: true fiqh is knowledge of the heart's maladies and the path to the Hereafter.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"afqih ʿannī mā aqūl\" — understand what I say. Metaphorical (majāz): technical restriction to legal rulings (furūʿ al-fatāwā) is a later convention, not the lexical or prophetic norm.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Perception of a thing as it truly is; knowledge of the essence of a thing.\n  * Al-Raghib (Mufradat): Two types: (1) perception of the essence of a thing; (2) judgment upon a thing affirming or negating something of it. The highest ʿilm is knowledge of God, His verses, and His acts.\n  * Al-Zamakhshari (Asas): Literal: \"He is from the banners (aʿlām) of knowledge.\" Metaphorical: restriction of the title \"scholar\" (al-ʿālim) to the dialectician (al-munāẓir) is a corrupt specification (takhṣīṣ fāsid).\n- Root: وحد (Waḥḥada)\n  * Lisan / Ayn: To make one; to affirm unity.\n  * Al-Raghib (Mufradat): Tawḥīd is affirming God's unity in essence, attributes, and acts — the highest degree being the vision that all things proceed from Him alone.\n  * Al-Zamakhshari (Asas): Literal: utterance of \"Lā ilāha illā Allāh.\" Metaphorical: the inner reality (al-lubāb) — seeing all affairs from God, cutting off attention from secondary causes.\n- Sibawayh Rule: باب التخصيص والتقييد (Restriction and Specification) — The corruption of names occurs through takhṣīṣ (semantic restriction), not naql (lexical transfer). The grammarians' principle: a general term (al-ism al-ʿāmm) retains its full semantic range unless a valid sharʿī or linguistic evidence restricts it; arbitrary restriction by custom (ʿādat al-istimāl) is a rhetorical device of the devils among men and jinn.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'", "badge": "Insight"}, {"arabic": "تعالى وقدره وإلى مثل هذا القلب الإشارة بقوله تعالى أرأيت من اتخذ إلهه هواه أفأنت تكون عليه وكيلا أم تحسب أن أكثرهم يسمعون أو يعقلون إن هم إلا كالأنعام بل هم أضل سبيلا وبقوله عز وجل لقد حق القول على أكثرهم فهم لا يؤمنون وبقوله سواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ورب قلب هذا حاله بالإضافة إلى بعض الشهوات كالذي يتورع عن بعض الأشياء ولكنه إذا رأى وجها حسنا لم يملك عينه وقلبه وطاش عقله وسقط مساك قلبه أو كالذي لا يملك نفسه فيما فيه الجاه والرياسة والكبر ولا يبقى معه مسكة للتثبت عند ظهور أسبابه أو كالذي لا يملك نفسه", "english": "Know that the heart, as we have mentioned, is surrounded by the attributes we have described, and the traces and states pour into it from the gateways we have set forth. It is as if it were a target perpetually struck from every side. When something afflicts it, it is affected by it; then it is struck from another side by that which opposes it, and so its state changes. If the devil descends upon it and calls it to passion (hawā), the angel descends upon it and turns it away from that. If one devil drags it toward evil, another devil drags it toward something else; and if one angel draws it toward good, another draws it toward something else. Thus at times it is contested between two angels, at times between two devils, and at times between an angel and a devil — it is never, ever left neglected. To this points the saying of the Exalted: {وَنُقَلِّبُ أَفْئِدَتَهُمْ وَأَبْصَارَهُمْ} (And We turn their hearts and their visions) {«الأنعام/110»}. And because the Messenger of Allah (peace and blessings be upon him) was privy to the wondrous handiwork of Allah the Exalted in the marvels of the heart and its overturning, he used to swear by it, saying: \"No, by the Turner of the hearts.\" (1)", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 610", "section_title_en": "The Wonders of the Heart: Its States of Stability, Inclination, and Fluctuation Between the Two Attracting Forces", "section_index": 610, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn a thing over, to revolve it, to divert it from one face to another; the heart is so named for its constant turning and fluctuation.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's perpetual overturning is its very essence; its states are never fixed, and its rectitude or corruption follows its turning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" — physical overturning. Metaphorical (Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; the heart's fluctuation between the two attractants is a real, continuous overturning.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the opening sentence, with its cascading circumstantial clauses, requires careful tracking of the governing verb and its dependent states to preserve the causal sequence of the heart's affliction and response.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "44": [{"arabic": "هواه أفأنت تكون عليه وكيلا أم تحسب أن أكثرهم يسمعون أو يعقلون إن هم إلا كالأنعام بل هم أضل سبيلا وبقوله عز وجل لقد حق القول على أكثرهم فهم لا يؤمنون وبقوله سواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ورب قلب هذا حاله بالإضافة إلى بعض الشهوات كالذي يتورع عن بعض الأشياء ولكنه إذا رأى وجها حسنا لم يملك عينه وقلبه وطاش عقله وسقط مساك قلبه أو كالذي لا يملك نفسه فيما فيه الجاه والرياسة والكبر ولا يبقى معه مسكة للتثبت عند ظهور أسبابه أو كالذي لا يملك نفسه عند الغضب مهما استحقر وذكر عيب من عيوبه أو كالذي لا يملك نفسه عند القدرة على أخذ درهم أو د", "english": "Know that the heart, as we have mentioned, is surrounded by the attributes we have described, and the traces and states pour into it from the gateways we have set forth. It is as if it were a target perpetually struck from every side. When something afflicts it, it is affected by it; then it is struck from another side by that which opposes it, and so its state changes. If the devil descends upon it and calls it to passion (hawā), the angel descends upon it and turns it away from that. If one devil drags it toward evil, another devil drags it toward something else; and if one angel draws it toward good, another draws it toward something else. Thus at times it is contested between two angels, at times between two devils, and at times between an angel and a devil — it is never, ever left neglected. To this points the saying of the Exalted: {وَنُقَلِّبُ أَفْئِدَتَهُمْ وَأَبْصَارَهُمْ} (And We turn their hearts and their visions) {«الأنعام/110»}. And because the Messenger of Allah (peace and blessings be upon him) was privy to the wondrous handiwork of Allah the Exalted in the marvels of the heart and its overturning, he used to swear by it, saying: \"No, by the Turner of the hearts.\" (1)", "book_title": "Contemplation", "section_title_ar": "Section 610", "section_title_en": "The Wonders of the Heart: Its States of Stability, Inclination, and Fluctuation Between the Two Attracting Forces", "section_index": 610, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn a thing over, to revolve it, to divert it from one face to another; the heart is so named for its constant turning and fluctuation.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's perpetual overturning is its very essence; its states are never fixed, and its rectitude or corruption follows its turning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" — physical overturning. Metaphorical (Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; the heart's fluctuation between the two attractants is a real, continuous overturning.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the opening sentence, with its cascading circumstantial clauses, requires careful tracking of the governing verb and its dependent states to preserve the causal sequence of the heart's affliction and response.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}, {"arabic": "كالأنعام بل هم أضل سبيلا وبقوله عز وجل لقد حق القول على أكثرهم فهم لا يؤمنون وبقوله سواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ورب قلب هذا حاله بالإضافة إلى بعض الشهوات كالذي يتورع عن بعض الأشياء ولكنه إذا رأى وجها حسنا لم يملك عينه وقلبه وطاش عقله وسقط مساك قلبه أو كالذي لا يملك نفسه فيما فيه الجاه والرياسة والكبر ولا يبقى معه مسكة للتثبت عند ظهور أسبابه أو كالذي لا يملك نفسه عند الغضب مهما استحقر وذكر عيب من عيوبه أو كالذي لا يملك نفسه عند القدرة على أخذ درهم أو دين", "english": "Know that the heart, as we have mentioned, is surrounded by the attributes we have described, and the traces and states pour into it from the gateways we have set forth. It is as if it were a target perpetually struck from every side. When something afflicts it, it is affected by it; then it is struck from another side by that which opposes it, and so its state changes. If the devil descends upon it and calls it to passion (hawā), the angel descends upon it and turns it away from that. If one devil drags it toward evil, another devil drags it toward something else; and if one angel draws it toward good, another draws it toward something else. Thus at times it is contested between two angels, at times between two devils, and at times between an angel and a devil — it is never, ever left neglected. To this points the saying of the Exalted: {وَنُقَلِّبُ أَفْئِدَتَهُمْ وَأَبْصَارَهُمْ} (And We turn their hearts and their visions) {«الأنعام/110»}. And because the Messenger of Allah (peace and blessings be upon him) was privy to the wondrous handiwork of Allah the Exalted in the marvels of the heart and its overturning, he used to swear by it, saying: \"No, by the Turner of the hearts.\" (1)", "book_title": "Patience and Gratitude", "section_title_ar": "Section 610", "section_title_en": "The Wonders of the Heart: Its States of Stability, Inclination, and Fluctuation Between the Two Attracting Forces", "section_index": 610, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn a thing over, to revolve it, to divert it from one face to another; the heart is so named for its constant turning and fluctuation.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's perpetual overturning is its very essence; its states are never fixed, and its rectitude or corruption follows its turning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" — physical overturning. Metaphorical (Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; the heart's fluctuation between the two attractants is a real, continuous overturning.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the opening sentence, with its cascading circumstantial clauses, requires careful tracking of the governing verb and its dependent states to preserve the causal sequence of the heart's affliction and response.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "45": [{"arabic": "وقال تعالى {ألم تر إلى ربك كيف مد الظل ولو شاء لجعله ساكنا ثم جعلنا الشمس عليه دليلا ثم قبضناه إلينا قبضا يسيرا} وقال تعالى {والقمر قدرناه منازل} وقال تعالى {وهو الذي جعل لكم النجوم لتهتدوا بها في ظلمات البر والبحر} فلا تظنن أن المقصود من سير الشمس والقمر بحسبان منظوم مرتب ومن خلق الظل والنور والنجوم أن يستعان بها على أمور الدنيا بل لتعرف بها مقادير الأوقات فتشتغل فيها بالطاعات والتجارة للدار الآخرة يدلك عليه قوله تعالى {وهو الذي جعل الليل والنهار خلفة لمن أراد أن يذكر أو أراد شكورا} أي يخلف أحدهما الآخر ليتدارك في أحدهما ما فات في الآخر وبين أن ذلك للذك", "english": "{«آناء الليل ساجدا وقائما يحذر الآخرة ويرجو رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون»} — \"During the hours of the night, prostrating and standing, fearing the Hereafter and hoping for the mercy of his Lord. Say: Are those who know equal to those who do not know?\" (Q. 39:9). And God Most High said: {«تتجافى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا»} — \"Their sides forsake their beds, calling upon their Lord in fear and hope\" (Q. 32:16). And God, Mighty and Majestic, said: {«والذين يبيتون لربهم سجدا وقياما»} — \"And those who pass the night prostrating and standing before their Lord\" (Q. 25:64). And God, Mighty and Majestic, said: {«كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون»} — \"They used to sleep but little of the night, and in the dawn-hours they would seek forgiveness\" (Q. 51:17-18). And God, Mighty and Majestic, said: {«فسبحان الله حين تمسون وحين تصبحون»} — \"So glory be to God when you enter the evening and when you enter the morning\" (Q. 30:17). And God Most High said: {«ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه»} — \"And do not drive away those who call upon their Lord morning and evening, desiring His Face\" (Q. 6:52). All of this makes clear to you that the path to God Most High is the watchfulness over the times (murāqabat al-awqāt) and the cultivation of them with the appointed devotions (al-awrād) in a perpetual manner.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 258", "section_title_en": "The Revival of the Religious Sciences — Section 258: The Virtues of the Watches (Awrād) and Their Ordering", "section_index": 258, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst at a watering place; al-Wird (pl. Awrād) denotes a set portion or appointed round of devotional recitation, by extension from the regular \"arrival\" at a source.\n  * Al-Raghib (Mufradat): Al-Wurūd is originally \"the intending of water,\" then used for other things. The theological nuance: the awrād are the appointed \"watering places\" of the soul — fixed times at which the servant presents himself before God to drink from the fountain of remembrance (dhikr).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"warda al-mā'a\" — to arrive at water. Metaphorical (Majāz): \"warada ʿalayhi amrun lam yuṭiqhu\" — an affair he could not bear arrived upon him; \"waradat-hu al-ḥummā\" — fever came upon him. Here, the awrād are the appointed times that \"come upon\" the servant, demanding their due of devotion.\n- Root: طلع (ṭ-l-ʿ)\n  * Lisan / Ayn: To rise, to appear above the horizon (of the sun); to ascend; to come upon suddenly.\n  * Al-Raghib (Mufradat): \"Ṭalaʿa al-shams ṭulūʿan wa-maṭlaʿan\" — the sun rose. From this is borrowed: \"ṭalaʿa ʿalaynā fulān\" — so-and-so came upon us. The maṭlaʿ is the place of rising.\n  * Al-Zamakhshari (Asas): Literal: \"ṭalaʿat al-shams\" — the sun rose. Metaphorical: \"ṭalaʿa ʿalaynā fulān\" — he descended upon us suddenly. The \"rising of the sun\" is the boundary-marker of the first watch.\n- Root: ليل (l-y-l)\n  * Lisan / Ayn: The night — from the time of sunset to sunrise; its root suggests \"enveloping\" and \"concealing.\"\n  * Al-Raghib (Mufradat): The night (al-layl) and the day (al-nahār) are two signs (āyatān) of God; the night is for stillness and the day for seeking provision.\n  * Al-Zamakhshari (Asas): Literal: the period of darkness. Metaphorical: \"layl al-hamm\" — the night of anxiety (a dark affair). The night is divided into watches for the one who stands in prayer.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating all else. Applied here: \"the purpose of the sun and moon's course is not for worldly matters, but only (innamā) for knowing the measures of the times.\"", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}], "46": [{"arabic": "الشمس عليه دليلا ثم قبضناه إلينا قبضا يسيرا} وقال تعالى {والقمر قدرناه منازل} وقال تعالى {وهو الذي جعل لكم النجوم لتهتدوا بها في ظلمات البر والبحر} فلا تظنن أن المقصود من سير الشمس والقمر بحسبان منظوم مرتب ومن خلق الظل والنور والنجوم أن يستعان بها على أمور الدنيا بل لتعرف بها مقادير الأوقات فتشتغل فيها بالطاعات والتجارة للدار الآخرة يدلك عليه قوله تعالى {وهو الذي جعل الليل والنهار خلفة لمن أراد أن يذكر أو أراد شكورا} أي يخلف أحدهما الآخر ليتدارك في أحدهما ما فات في الآخر وبين أن ذلك للذ", "english": "{«آناء الليل ساجدا وقائما يحذر الآخرة ويرجو رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون»} — \"During the hours of the night, prostrating and standing, fearing the Hereafter and hoping for the mercy of his Lord. Say: Are those who know equal to those who do not know?\" (Q. 39:9). And God Most High said: {«تتجافى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا»} — \"Their sides forsake their beds, calling upon their Lord in fear and hope\" (Q. 32:16). And God, Mighty and Majestic, said: {«والذين يبيتون لربهم سجدا وقياما»} — \"And those who pass the night prostrating and standing before their Lord\" (Q. 25:64). And God, Mighty and Majestic, said: {«كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون»} — \"They used to sleep but little of the night, and in the dawn-hours they would seek forgiveness\" (Q. 51:17-18). And God, Mighty and Majestic, said: {«فسبحان الله حين تمسون وحين تصبحون»} — \"So glory be to God when you enter the evening and when you enter the morning\" (Q. 30:17). And God Most High said: {«ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه»} — \"And do not drive away those who call upon their Lord morning and evening, desiring His Face\" (Q. 6:52). All of this makes clear to you that the path to God Most High is the watchfulness over the times (murāqabat al-awqāt) and the cultivation of them with the appointed devotions (al-awrād) in a perpetual manner.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 258", "section_title_en": "The Revival of the Religious Sciences — Section 258: The Virtues of the Watches (Awrād) and Their Ordering", "section_index": 258, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst at a watering place; al-Wird (pl. Awrād) denotes a set portion or appointed round of devotional recitation, by extension from the regular \"arrival\" at a source.\n  * Al-Raghib (Mufradat): Al-Wurūd is originally \"the intending of water,\" then used for other things. The theological nuance: the awrād are the appointed \"watering places\" of the soul — fixed times at which the servant presents himself before God to drink from the fountain of remembrance (dhikr).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"warda al-mā'a\" — to arrive at water. Metaphorical (Majāz): \"warada ʿalayhi amrun lam yuṭiqhu\" — an affair he could not bear arrived upon him; \"waradat-hu al-ḥummā\" — fever came upon him. Here, the awrād are the appointed times that \"come upon\" the servant, demanding their due of devotion.\n- Root: طلع (ṭ-l-ʿ)\n  * Lisan / Ayn: To rise, to appear above the horizon (of the sun); to ascend; to come upon suddenly.\n  * Al-Raghib (Mufradat): \"Ṭalaʿa al-shams ṭulūʿan wa-maṭlaʿan\" — the sun rose. From this is borrowed: \"ṭalaʿa ʿalaynā fulān\" — so-and-so came upon us. The maṭlaʿ is the place of rising.\n  * Al-Zamakhshari (Asas): Literal: \"ṭalaʿat al-shams\" — the sun rose. Metaphorical: \"ṭalaʿa ʿalaynā fulān\" — he descended upon us suddenly. The \"rising of the sun\" is the boundary-marker of the first watch.\n- Root: ليل (l-y-l)\n  * Lisan / Ayn: The night — from the time of sunset to sunrise; its root suggests \"enveloping\" and \"concealing.\"\n  * Al-Raghib (Mufradat): The night (al-layl) and the day (al-nahār) are two signs (āyatān) of God; the night is for stillness and the day for seeking provision.\n  * Al-Zamakhshari (Asas): Literal: the period of darkness. Metaphorical: \"layl al-hamm\" — the night of anxiety (a dark affair). The night is divided into watches for the one who stands in prayer.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating all else. Applied here: \"the purpose of the sun and moon's course is not for worldly matters, but only (innamā) for knowing the measures of the times.\"", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}], "47": [{"arabic": "يتميز وقت المعاش عن وقت الاستراحة فانظر كيف جعل الله تعالى الليل لباسا والنوم سباتا والنهار معاشا وانظر إلى إيلاجه الليل في النهار والنهار في الليل وإدخاله الزيادة والنقصان عليهما على ترتيب مخصوص وانظر إلى إمالته مسير الشمس عن وسط السماء حتى اختلف بسببه الصيف والشتاء والربيع والخريف فإذا انخفضت الشمس من وسط السماء فى مسيرها برد الهواء وظهر الشتاء وإذا استوت فى وسط السماء اشتد القيظ وإذا كانت فيما بينهما اعتدل الزمان وعجائب السموات لا مطمع في إحصاء عشر عشير جزء من أجزائها وإنما هذا تنبيه على طريق الفكر واعتقد على طريق الجملة أنه", "english": "By another course [of motion] its Creator has subjugated it [the sun] to His service. Were it not for its rising and its setting, the night and the day would not alternate, the appointed times would not be known, and darkness would envelop all perpetually, or light would prevail forever — such that the time of livelihood would not be distinguished from the time of rest. So behold how God, the Exalted, made the night a garment {«وَجَعَلْنَا اللَّيْلَ لِبَاسًا»}, and sleep a repose, and the day a means of livelihood {«وَجَعَلْنَا النَّهَارَ مَعَاشًا»}. And behold His insertion of the night into the day and the day into the night, and His bringing of increase and decrease upon them both according to a precise ordering.", "book_title": "Contemplation", "section_title_ar": "Section 1279", "section_title_en": "On Contemplating the Sun, the Heavens, and the Wisdom of Their Creator", "section_index": 1279, "anchors": "- Root: سير (s-y-r)\n  * Lisan / Ayn: Core meaning of movement, journeying, traversing a path.\n  * Al-Raghib (Mufradat): Used for the celestial bodies' appointed courses (musayyarāt), indicating divine ordainment of motion.\n  * Al-Zamakhshari (Asas): Literal for physical traversal; metaphorical for the subjugation of celestial bodies to their Maker's command.\n- Root: شمس (sh-m-s)\n  * Lisan / Ayn: The celestial orb itself; also that which is restless, never settling.\n  * Al-Raghib (Mufradat): Denotes both the solar disc and its diffused light; its rising and setting are signs of divine governance.\n  * Al-Zamakhshari (Asas): Literal for the sun's course; metaphorical (majāz) for manifest power and relentless motion.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring, estimating, fashioning with precise proportion.\n  * Al-Raghib (Mufradat): Origination from nothing (ījād min lā aṣl) and creation upon a measure determined by wisdom.\n  * Al-Zamakhshari (Asas): Literal for the artisan's sizing before cutting; metaphorical for God's bringing things into being upon an exact decree.\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Astonishment at something whose cause is hidden or whose magnitude exceeds the ordinary.\n  * Al-Raghib (Mufradat): The wondrous (ʿajab) is that which strikes the soul with amazement due to its surpassing of customary limits.\n  * Al-Zamakhshari (Asas): Literal for marvel; metaphorical for the overwhelming evidence of divine wisdom in creation.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the use of \"إنما\" and conditional-command structures (fa-inẓur...), where the imperative to \"look\" functions as a focused directive restricting attention to the object of contemplation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "54": [{"arabic": "وإذا قربت من الإنزال فقل في نفسك ولا تحرك شفتيك الحمد لله الذي خلق من الماء بشرا فجعله نسبا وصهرا وكان ربك قديرا وكان بعض أصحاب الحديث يكبر حتى يسمع أهل الدار صوته ثم ينحرف عن القبلة ولا يستقبل القبلة بالوقاع إكراما للقبلة وليغط نفسه وأهله بثوب كان رسول الله صلى الله عليه وسلم يغطي رأسه ويغض صوته ويقول للمرأة عليك بالسكينة (2) وفي الخبر إذا جامع أحدكم أهله فلا يتجردان تجرد العيرين (3) أي الحمارين وليقدم التلطف بالكلام والتقبيل قال صلى الله عليه وسلم لا يقعن أحدكم على امرأته كما تقع البهيمة وليكن بينهما رسول قيل وما الرسول يا رسول الله قال القبلة والكلام (4) و", "english": "I say: The Prophet, peace and blessings be upon him, has said: «من كان له امرأتان فمال إلى إحداهما دون الأخرى» — \"Whoever has two wives and inclines toward one of them to the exclusion of the other\" — and in another wording: «ولم يعدل بينهما جاء يوم القيامة وأحد شقيه مائل» — \"and does not act equitably between them, he shall come on the Day of Resurrection with one of his sides leaning.\"", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 305", "section_title_en": "The Revival of the Religious Sciences — Book on the Etiquette of Marriage: Section 305 (On Justice Between Co-Wives, Nushuz, and the Etiquette of Intercourse)", "section_index": 305, "anchors": "- Root: عدل (ʿadl)\n  * Lisan / Ayn: Core meaning is \"to be equal, to balance, to straighten\" — the root denotes equity and even-handedness in distribution.\n  * Al-Raghib (Mufradat): In theological usage, ʿadl is the mean of justice, opposed to jawr (tyranny) — it is the act of placing things in their proper stations.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage pertains to measurable distribution (ʿatāʾ, mabīt); metaphorical (Majāz) usage extends to that which is not under voluntary control, such as love (maḥabbah) and inclination of the heart.\n- Root: نشز (nushūz)\n  * Lisan / Ayn: The root denotes \"rising up\" or \"elevation\"; in marital context it signifies a rising of one spouse against the other in discord or recalcitrance.\n  * Al-Raghib (Mufradat): Nushūz is the rebellion of one spouse against the bond of obedience and harmony, a moral elevation against the other.\n  * Al-Zamakhshari (Asas): Literal usage is the physical rising from a place; metaphorical usage is the spiritual/moral rising in defiance.\n- Root: وقع (waqʿ)\n  * Lisan / Ayn: The root denotes \"falling\" or \"occurrence\"; in the marital context, it is a euphemism for sexual intercourse.\n  * Al-Raghib (Mufradat): The term is used in the Quran for the \"falling\" of an event; here it is a euphemistic transfer (naql) for coitus.\n  * Al-Zamakhshari (Asas): Literal usage is physical falling; metaphorical usage is the act of intercourse, as in the hadith \"لا يقعن أحدكم على امرأته\" (Let none of you fall upon his wife like a beast).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts the predicate to the subject alone, as in the hadith \"إنما عليه العدل في العطاء والمبيت\" (Upon him is only justice in expenditure and overnight stays), confining the obligation to what is within human capacity.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Marriage'", "badge": "Hadith"}, {"arabic": "ومن بدائع ألطافه أن خلق من الماء بشرا فجعله نسبا وصهرا وسلط على الخلق شهوة اضطرهم بها الحراثة جبرا واستبقى بهم نسلهم إقهارا وقسرا ثم عظم أمر الأنساب وجعل لها قدرا فحرم بسببها السفاح وبالغ في تقبيحه ردعا وزجرا وجعل اقتحامه جريمة فاحشة وأمر إمرا وندب إلى النكاح وحث عليه استحبابا وأمرا فسبحان من كتب الموت على عباده فأذلهم به هدما وكسرا ثم بث بذور النطف في أراضي الأرحام وأنشأ منها خلقا وجعله لكسر الموت جبرا تنبيها على أن بحار المقادير فياضة على العالمين نفعا وضرا وخيرا وشرا وعسرا ويسرا وطيا ونش", "english": "And he [the Prophet, peace be upon him] also said: \"I marvel at one who enters the bathhouse on an empty stomach and then delays eating after he comes out — how does he not die?\" And he said: \"I marvel at one who undergoes cupping (ḥijāmah) and then hastens to eat — how does he not die?\"", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 293", "section_title_en": "Section 293 — Prophetic Admonitions on Eating, Bodily Health, and the Virtues of Marriage (Opening of the Book on the Etiquette of Marriage)", "section_index": 293, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core meaning is \"to eat, to consume, to take nourishment\"; Al-Farahidi notes the extended sense of consumption by fire, and the derived forms indicating that which is eaten.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of nourishment; extended metaphorically to fire consuming wood, and to usury (ribā) devouring wealth. The theological nuance distinguishes physical sustenance from spiritual consumption.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) usage denotes actual ingestion of food; metaphorical (majāz) usage extends to \"eating\" wealth unjustly, or the sword \"eating\" flesh. Here, the prophetic saying on eating with fingers carries literal force but signals etiquette (adab) — the number of fingers indicates degrees of moderation versus gluttony.\n- Root: نوم (nawm)\n  * Lisan / Ayn: Sleep as a natural bodily state; Al-Farahidi connects it to stillness and the suspension of waking activity.\n  * Al-Raghib (Mufradat): \"النوم: فسر على أوجه كلها صحيح\" — sleep is interpreted variously: relaxation of the brain's nerves, or God's taking of the soul without death. \"النوم موت خفيف، والموت نوم ثقيل\" — sleep is a light death, death a heavy sleep. This theological framing underlies the prophetic classification of sleeping positions.\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: \"نامت السوق\" (the market slept = stagnated), \"نام الثوب\" (the garment slept = wore thin). The prophetic categorization of sleep postures is literal but carries spiritual significance — each posture reflects the sleeper's spiritual station.\n- Root: رغب (raghiba)\n  * Al-Raghib (Mufradat): \"أصل الرغبة: السعة في الشيء\" — the root denotes amplitude and expanse; رغب فيه implies desire and longing for something, while رغب عنه implies turning away and renouncing. The dual directionality is crucial for the chapter title: \"الترغيب في النكاح والترغيب عنه\" (encouragement toward marriage and discouragement from it).\n  * Al-Zamakhshari (Asas): Literal: desire/aversion. Metaphorical: \"واد رغيب\" (a wide valley that takes much water). The rhetorical force of targhīb (making desirable) and tarhīb (making fearsome) is central to Ghazali's homiletic method.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of Ghazali's opening doxology employs extended prepositional phrases and circumstantial clauses (ḥāl) that must be carefully parsed to preserve the theological rhythm of praise.\n\n---", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Marriage'", "badge": "Hadith"}], "58": [{"arabic": "تحصنت بالله العظيم واستغثت بالحي الذي لا يموت اللهم احرسنا بعينك التي لا تنام واكنفنا بركنك الذي لا يرام اللهم ارحمنا بقدرتك علينا فلا نهلك وأنت ثقتنا ورجاؤنا اللهم أعطف علينا قلوب عبادك وإمائك برأفة ورحمة إنك أنت أرحم الراحمين الثامنة مهما علا نشزا من الأرض في الطريق فيستحب أن يكبر ثلاثا ثم يقول اللهم لك الشرف على كل شرف ولك الحمد على كل حال ومهما هبط سبح ومهما خاف الوحشة في سفره قال سبحان الله الملك القدوس رب الملائكة والروح جللت السموات بالعزة والجبروت", "english": "He ought to seek out a righteous companion, one who loves goodness and assists in it: if he forgets, the companion reminds him; if he remembers, the companion aids him; if he fears, the companion emboldens him; if he weakens, the companion strengthens him; if his breast narrows, the companion enlarges his patience. He should bid farewell to his resident companions, his brothers, and his neighbors — taking leave of them and seeking their supplications, for God Most High places goodness in their prayers. The Sunnah of farewell is to say: «أستودع الله دينك وأمانتك وخواتيم عملك» — \"I entrust to God your religion, your trustworthiness, and the seal of your deeds.\" And he, peace and blessings be upon him, used to say to one intending travel: \"In God's protection and His care — may God provide you with piety, forgive your sin, and direct you toward goodness wherever you may be.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 199", "section_title_en": "The Book of the Etiquette of Travel — Section 199: On the Comprehensive Etiquette of the Journey (From Provisioning to Guarding)", "section_index": 199, "anchors": "- Root: س ف ر (S-F-R)\n  * Lisan / Ayn: \"السفر: كشف الغطاء\" — unveiling, uncovering; the traveler is one who uncovers the veils of distant lands.\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء، ويختص ذلك بالأعيان\" — the journey is a literal uncovering of horizons, yet the spiritual journey unveils the soul's veils.\n  * Al-Zamakhshari (Asas): Haqiqah: \"سافر سفرا بعيدا\" (to travel far); Majaz: \"وجه مسفر: مشرق سرورا\" — a face radiant with joy, as the traveler's face brightens with divine trust.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the supplications' structural pauses.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Remembrance of Death and Afterlife'", "badge": "Du'a"}, {"arabic": "وقرأ الخواص قوله تعالى {وتوكل على الحي الذي لا يموت} إلى آخر فقال ما ينبغي للعبد بعدد هذه الآية أن يلجأ إلى أحد غير الله تعالى وقيل لبعض العلماء في منامه من وثق بالله تعالى فقد أحرز قوته وقال بعض العلماء لا يشغلك المضمون لك من الرزق عن المفروض عليك من العمل فتضيع أمر آخرتك ولا تنال من الدنيا إلا ما قد كتب الله لك وقال يحيى بن معاذ في وجود العبد الرزق من غير طلب دلالة على أن الرزق مأمور بطلب العبد وقال إبراهيم بن أدهم سألت بعض الرهبان من أين تأكل فقال لي ليس هذا العلم عندي ولكن سل ربي من أين يطعمني", "english": "His protection and His sanctuary, and He is a Wise One who does not fall short in managing the affairs of one who entrusts His management to Him. And He, exalted is He, said: {إِنَّ الَّذِينَ تَدْعُونَ مِن دُونِ اللَّهِ عِبَادٌ أَمْثَالُكُمْ} — \"Indeed, those you call upon besides Allah are servants like yourselves\" — thereby making clear that everything other than Allah, exalted is He, is a subjugated servant, whose need is like your need; so how then can one rely upon him?", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1103", "section_title_en": "Section 1103 — On the First Part Concerning Divine Unity (Tawḥīd) and the Perfection of Trust in Allah", "section_index": 1103, "anchors": "- Root: وكل (W-K-L)\n  * Lisan / Ayn: Core meaning of delegating, entrusting, and appointing another as a deputy or guardian over one's affairs.\n  * Al-Raghib (Mufradat): \"التوكيل: أن تعتمد على غيرك وتجعله نائبا عنك\" — Trust (tawakkul) is to rely upon another and make him a deputy; the true Wakīl is Allah alone, as in {وَكَفَىٰ بِاللَّهِ وَكِيلًا}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"توكل على الله ولا تتكل على غيره\" — reliance on Allah. Metaphorical (majāz): \"وكل همه بكذا\" — one who delegates his care to a thing, implying abandonment by Allah of those who turn to other than Him.\n- Root: عبد (ʿ-B-D)\n  * Lisan / Ayn: Servitude, submission, and humble obedience; the created being as subjugated servant.\n  * Al-Raghib (Mufradat): \"العبودية: إظهار التذلل، والعبادة أبلغ منها\" — servitude is the display of humility; worship is its utmost degree, due only to Allah. All besides Allah are \"عباد أمثالكم\" — servants like yourselves, incapable of independent provision.\n  * Al-Zamakhshari (Asas): Literal: \"عبد بين العبودية\" — a slave bound in servitude. Metaphorical: \"استعبده الطمع\" — greed enslaves a man, just as reliance on creatures enslaves the heart.\n- Root: رسل (R-S-L)\n  * Lisan / Ayn: Sending forth with ease and gentleness; a messenger dispatched with a message.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root is gentle dispatch; the messenger is one sent, and the verse {وَأْمُرْ أَهْلَكَ بِالصَّلَاةِ} is a divine sending of command.\n  * Al-Zamakhshari (Asas): Literal: \"أرسل الله في الأمم رسلا\" — Allah sent messengers to nations. Metaphorical: \"أرسل الله عليهم العذاب\" — Allah loosed punishment upon them, showing His sole agency.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the preposition from its object for rhetorical emphasis, as in \"على ربهم يتوكلون\" where the preposition \"على\" is fronted before its governed noun \"ربهم\" to highlight exclusive reliance, a construction permissible when the clause is semantically complete and the fronting serves emphasis (takhrīṣ).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "60": [{"arabic": "لله ولا الملائكة المقربون الآية وقال تعالى وإذا قيل لهم اسجدوا للرحمن قالوا وما الرحمن أنسجد لما تأمرنا وزادهم نفورا القسم الثاني التكبر على الرسل من حيث تعزز النفس وترفعها على الانقياد لبشر مثل سائر الناس وذلك تارة يصرف عن الفكر والاستبصار فيبقى في ظلمة الجهل بكبره فيمتنع عن الانقياد وهو ظان أنه محق فيه وتارة يمتنع مع المعرفة ولكن لا تطاوعه نفسه للإنقياد للحق والتواضع للرسل كما حكى الله قولهم أنؤمن لبشرين مثلنا {وقولهم} إن أنتم إلا بشر مثلنا ولئن أطعتم بشرا مثلكم إنكم إذا لخاسرون وقال الذين لا يرجون لقاءنا لولا أنزل علينا الملائكة أو نرى ربنا لقد استكبروا في أنفسه", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "61": [{"arabic": "النار تبارك الذي جعل في السماء بروجا وجعل فيها سراجا وقمرا منيرا وإذا سمعت صوت الرعد فقل سبحان من يسبح الرعد بحمده والملائكة من خيفته (7) فإن رأيت الصواعق فقل اللهم لا تقتلنا بغضبك ولا تهلكنا بعذابك وعافنا قبل ذلك (8) قاله كعب فإذا أمطرت السماء فقل اللهم سقيا هنيئا وصيبا نافعا (9) اللهم اجعله صيب رحمة ولا تجعله صيب عذاب (10) فإذا غضبت فقل اللهم اغفر لي ذنبي وأذهب غيظ قلبي وأجرني من الشيطان الرجيم (1) فإذا خفت قوما فقل اللهم إنا نجعلك في نحورهم ونعوذ بك من شرورهم (2) فإذا غزوت فقل اللهم أنت عضدي ونصيري و", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "62": [{"arabic": "تعالى {وهو الذي جعل الليل والنهار خلفة لمن أراد أن يذكر أو أراد شكورا} أي يخلف أحدهما الآخر ليتدارك في أحدهما ما فات في الآخر وبين أن ذلك للذكر والشكر لا غير وقال تعالى {وجعلنا الليل والنهار آيتين فمحونا آية الليل وجعلنا آية النهار مبصرة لتبتغوا فضلا من ربكم ولتعلموا عدد السنين والحساب} وإنما الفضل المبتغى هو الثواب والمغفرة ونسأل الله حسن التوفيق لما يرضيه بيان أعداد الأوراد وترتيبها اعلم أن أوراد النهار سبعة فما بين طلوع الصبح إلى طلوع قرص الشمس ورد وما بين طلوع الشمس إلى الزوال وردان وما بين الزوال إ", "english": "{«آناء الليل ساجدا وقائما يحذر الآخرة ويرجو رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون»} — \"During the hours of the night, prostrating and standing, fearing the Hereafter and hoping for the mercy of his Lord. Say: Are those who know equal to those who do not know?\" (Q. 39:9). And God Most High said: {«تتجافى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا»} — \"Their sides forsake their beds, calling upon their Lord in fear and hope\" (Q. 32:16). And God, Mighty and Majestic, said: {«والذين يبيتون لربهم سجدا وقياما»} — \"And those who pass the night prostrating and standing before their Lord\" (Q. 25:64). And God, Mighty and Majestic, said: {«كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون»} — \"They used to sleep but little of the night, and in the dawn-hours they would seek forgiveness\" (Q. 51:17-18). And God, Mighty and Majestic, said: {«فسبحان الله حين تمسون وحين تصبحون»} — \"So glory be to God when you enter the evening and when you enter the morning\" (Q. 30:17). And God Most High said: {«ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه»} — \"And do not drive away those who call upon their Lord morning and evening, desiring His Face\" (Q. 6:52). All of this makes clear to you that the path to God Most High is the watchfulness over the times (murāqabat al-awqāt) and the cultivation of them with the appointed devotions (al-awrād) in a perpetual manner.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 258", "section_title_en": "The Revival of the Religious Sciences — Section 258: The Virtues of the Watches (Awrād) and Their Ordering", "section_index": 258, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst at a watering place; al-Wird (pl. Awrād) denotes a set portion or appointed round of devotional recitation, by extension from the regular \"arrival\" at a source.\n  * Al-Raghib (Mufradat): Al-Wurūd is originally \"the intending of water,\" then used for other things. The theological nuance: the awrād are the appointed \"watering places\" of the soul — fixed times at which the servant presents himself before God to drink from the fountain of remembrance (dhikr).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"warda al-mā'a\" — to arrive at water. Metaphorical (Majāz): \"warada ʿalayhi amrun lam yuṭiqhu\" — an affair he could not bear arrived upon him; \"waradat-hu al-ḥummā\" — fever came upon him. Here, the awrād are the appointed times that \"come upon\" the servant, demanding their due of devotion.\n- Root: طلع (ṭ-l-ʿ)\n  * Lisan / Ayn: To rise, to appear above the horizon (of the sun); to ascend; to come upon suddenly.\n  * Al-Raghib (Mufradat): \"Ṭalaʿa al-shams ṭulūʿan wa-maṭlaʿan\" — the sun rose. From this is borrowed: \"ṭalaʿa ʿalaynā fulān\" — so-and-so came upon us. The maṭlaʿ is the place of rising.\n  * Al-Zamakhshari (Asas): Literal: \"ṭalaʿat al-shams\" — the sun rose. Metaphorical: \"ṭalaʿa ʿalaynā fulān\" — he descended upon us suddenly. The \"rising of the sun\" is the boundary-marker of the first watch.\n- Root: ليل (l-y-l)\n  * Lisan / Ayn: The night — from the time of sunset to sunrise; its root suggests \"enveloping\" and \"concealing.\"\n  * Al-Raghib (Mufradat): The night (al-layl) and the day (al-nahār) are two signs (āyatān) of God; the night is for stillness and the day for seeking provision.\n  * Al-Zamakhshari (Asas): Literal: the period of darkness. Metaphorical: \"layl al-hamm\" — the night of anxiety (a dark affair). The night is divided into watches for the one who stands in prayer.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating all else. Applied here: \"the purpose of the sun and moon's course is not for worldly matters, but only (innamā) for knowing the measures of the times.\"", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}, {"arabic": "ولا نفورا ونشكره إذ جعل الليل والنهار خلفة لمن أراد أن يذكر أو أراد شكورا ونصلي على نبيه الذي بعثه بالحق بشيرا ونذيرا وعلى آله الطاهرين وصحبه الأكرمين الذين اجتهدوا في عبادة الله غدوة وعشيا وبكرة وأصيلا حتى أصبح كل واحد منهم نجما في الدين هاديا وسراجا منيرا أما بعد فإن الله تعالى جعل الأرض ذلولا لعباده إلا ليستقروا في مناكبها بل ليتخذوها منزلا فيتزودوا منها زادا يحملهم في سفرهم إلى أوطانهم ويكتنزون منها تحفا لنفوسهم عملا وفضلا محترزين من مصايدها ومعاطبها ويتحققون أن العمر يسير بهم سير السفينة براكبها فالناس في هذا", "english": "We praise Allah for His gracious favors with abundant praise, and we remember Him with a remembrance that leaves in the heart neither arrogance nor aversion. And we thank Him, for He has made the night and the day successive — {«خلفة لمن أراد أن يذكر أو أراد شكورا»} (a succession for whoever desires to remember or desires gratitude) [الفرقان/ 62]. And we send blessings upon His Prophet whom He sent forth with the truth as a bearer of glad tidings and a warner, and upon his pure Family and his most noble Companions — those who strove earnestly in the worship of Allah, morning and evening, at dawn and at dusk, until each one of them became a guiding star in the religion and a luminous lamp.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 256", "section_title_en": "The Book of the Arrangement of Liturgies (Awrād) and the Detailed Account of Reviving the Night — Being the Tenth Book of the Revival of the Religious Sciences, and by It the Quarter of Acts of Worship Is Concluded — May Allah Benefit the Muslims Thereby", "section_index": 256, "anchors": "- Root: سفر (s-f-r)\n  * Lisan / Ayn: \"Safar: a journey; uncovering, removing a covering; a group of travelers; the act of traveling.\"\n  * Al-Raghib (Mufradat): \"Al-Safar: the uncovering of a veil, and it is specified for corporeal things... and it is said: 'Asfara al-Subh' (the dawn shone forth). The journey is so named because it uncovers the character of men and reveals their true states.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'Sāfara safaran baʿīdan' (he journeyed a far journey). Metaphorical: 'Wajhun musfirun' (a face radiant with joy) — {«وجوه يومئذ مسفرة»} [عبس/ 38]; 'Safarat al-riḥu ʿan wajhi al-samā'' (the wind uncovered the face of the sky).\"\n- Root: ورد (w-r-d)\n  * Lisan / Ayn: \"Warada: to arrive at water; to seek water; to come to a place; a portion of the night assigned for prayer and invocation.\"\n  * Al-Raghib (Mufradat): \"Al-Wurūd: originally, the intending of water; then it is used for other things... and it is used of the Fire by way of horror: {«فأوردهم النار وبئس الورد المورود»} [هود/ 98].\"\n  * Al-Zamakhshari (Asas): \"Literal: 'Warada al-mā'' (he arrived at the water). Metaphorical: 'Warada ʿalayhi amrun lam yuṭiqhu' (an affair he could not bear came upon him); 'Waradat-hu al-ḥummā' (fever visited him). The wird (liturgy) is the appointed portion of worship, as if the servant arrives at the watering-place of divine grace at its appointed times.\"\n- Root: ليل (l-y-l)\n  * Lisan / Ayn: \"Al-Layl: the night, from the setting of the sun to its rising; its plural is layālin and layā'il.\"\n  * Al-Raghib (Mufradat): \"Layl and laylah... {«وسخر لكم الليل والنهار»} [إبراهيم/ 33]; {«والليل إذا يغشى»} [الليل/ 1]; {«إنا أنزلناه في ليلة القدر»} [القدر/ 1].\"\n  * Al-Zamakhshari (Asas): \"The night is that which veils (yulayyil) by its darkness; it is the time of seclusion for the worshippers and the beloved of those who stand in prayer.\"\n- Root: طرق (t-r-q)\n  * Lisan / Ayn: \"Taraqa: to strike, to knock; al-ṭāriq: the night-visitor who comes knocking; al-ṭarīq: the road that is beaten by feet.\"\n  * Al-Raghib (Mufradat): \"Al-Ṭarīq: the path that is struck (yuṭraqu) by feet... and from it is borrowed every path that a man traverses in his action, whether praiseworthy or blameworthy.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'Taraqa al-bāba' (he knocked at the door). Metaphorical: 'Ṭaraqanā fulānun ṭurūqan' (so-and-so came to us by night); 'Ṭaraqat masāmiʿī bi-khayr' (good news struck my ears). The night-visitor (ṭāriq) is he who comes by night — and the liturgies of the night are the knocking of the servant at the door of the King.\"\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — The separation between the preposition and its governed noun is permissible when the intervening element is semantically complete, as in the periodic structure of this opening, where the praise and blessing precede the main thesis, establishing the rhetorical frame before the doctrinal content.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'", "badge": "Insight"}], "63": [{"arabic": "تعالى {وعباد الرحمن الذين يمشون على الأرض هونا وإذا خاطبهم الجاهلون قالوا سلاما} إلى آخر السورة من أشكل عليه حاله فليعرض نفسه على هذه الآيات فوجود جميع هذه الصفات علامة حسن الخلق وفقد جميعها علامة سوء الخلق ووجود بعضها دون بعض يدل على البعض دون البعض فليشتغل بتحصيل ما فقده وحفظ ما وجده وقد وصف رسول الله صلى الله عليه وسلم المؤمن بصفات كثيرة وأشار بجميعها إلى محاسن الأخلاق فقال المؤمن يحب لأخيه ما يحب لنفسه (1) وقال عليه السلام من كان يؤمن بالله واليوم الآخر فليكرم ضيفه (2) وقال صلى الله عليه وس", "english": "The foundational principle in this matter is that each person should abandon that which brings him joy from among the causes of this world. So whoever delights in wealth, or in status, or in acceptance during preaching, or in honor through judgeship and governance, or in the abundance of followers in teaching and benefitting others—he should first abandon that which brings him joy. For if he is prevented from something of that sort, and it is said to him: \"Your reward is in the Hereafter,\" and his reward is not diminished by the prevention, yet he dislikes that and is pained by it—then he is among those who rejoice in the life of this world and are content with it, and that is destructive for him. Then, when he has abandoned the causes of joy, let him withdraw from people, let him seclude himself with his own soul, and let him watch over his heart so that it is occupied with nothing but the remembrance of Allah, the Exalted, and reflection upon Him. And let him lie in wait for whatever desire or whisper (shahwah wa waswās) appears in his soul, so that he may crush its substance whenever it emerges. For every whisper has a cause, and it does not vanish except by severing that cause and attachment. And let him persist in this for the remainder of his life, for striving has no end except death.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 630", "section_title_en": "The Revival of the Religious Sciences — Section 630: The Signs of Good Character and the Path of Spiritual Striving", "section_index": 630, "anchors": "- Root: جهد (j-h-d)\n  * Lisan / Ayn: Exertion of one's utmost capacity; enduring hardship in pursuit of a goal.\n  * Al-Raghib (Mufradat): Al-jihād is the soul's taking itself to the limit of its capacity while bearing difficulty; it is the means by which the lower self is subdued.\n  * Al-Zamakhshari (Asas): Literal: physical toil and strain. Metaphorical: the striving of the soul against its passions, as in \"ijtahada ra'yahu\" (he exerted his judgment).\n- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: Beauty, goodness, and excellence in form and conduct.\n  * Al-Raghib (Mufradat): That which is desirable and pleasing—whether by reason, inclination, or sense; ḥusn al-khuluq is the beauty of the soul's inward disposition.\n  * Al-Zamakhshari (Asas): Literal: physical beauty and adornment. Metaphorical: moral excellence, as in \"ḥasuna khuluquhu\" (his character became good).\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring, fashioning, and forming; also innate disposition and character.\n  * Al-Raghib (Mufradat): Origination upon a just measure; for character, it denotes the soul's settled form and inward constitution.\n  * Al-Zamakhshari (Asas): Literal: shaping and smoothing. Metaphorical: the created nature and moral temperament of a person.\n- Sibawayh Rule: Restriction and Specification (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle \"innamā\" restricts the predicate to the subject alone, as in the verse {«...»} \"Innamā al-muʾminūna...\" (The believers are only those...), which confines true faith to those possessing the enumerated attributes.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'", "badge": "Insight"}, {"arabic": "قال الله تعالى {وإذا خاطبهم الجاهلون قالوا سلاما} أي سلامة والألف بدل من الهاء ومعناه إنا سلمنا من إثمكم وأنتم سلمتم من شرنا فهذا ما أردنا أن نذكره من معاني الأخوة وشروطها وفوائدها فلنرجع في ذكر حقوقها ولوازمها وطرق القيام بحقها وأما الحريص على الدنيا فصحبته سم قاتل لأن الطباع مجبولة على التشبه والاقتداء بل الطبع يسرق من الطبع من حيث لا يدري صاحبه فمجالسة الحريص على الدنيا تحرك الحرص ومجالسة الزاهد تزهد في الدنيا فلذلك تكره صحبة طلاب الدنيا ويستحب صحبة الراغبين في الآخرة قال علي عليه السلام أحيو", "english": "I say: What we have mentioned regarding the observation of purposes and the observance of conditions with respect to them — that which is stipulated for companionship in the aims of this world is not what is stipulated for companionship in the Hereafter and brotherhood. For as Bishr said: \"Brothers are three: a brother for your Hereafter, a brother for your worldly life, and a brother for your enjoyment of his company.\" And rarely do these purposes unite in a single person; rather, they are dispersed among a group, and so the conditions are necessarily dispersed among them as well.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 416", "section_title_en": "The Revival of the Religious Sciences — Book on the Etiquette of Brotherhood: Section 416 — The Conditions of Brotherhood and Its Rights", "section_index": 416, "anchors": "- Root: دنا (d-n-w)\n  * Lisan / Ayn: Proximity in place, time, or rank; the near and the nearer.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by judgment; used of spatial, temporal, and station-based nearness.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) for physical nearness; metaphorical (Majaz) for nearness in rank, honor, or moral standing.\n- Root: صحب (ṣ-ḥ-b)\n  * Lisan / Ayn: The companion (al-ṣāḥib) is the one who accompanies another — whether a person, animal, place, or time; companionship by body is the origin and most frequent.\n  * Al-Raghib (Mufradat): \"الصاحب: الملازم إنسانا كان أو حيوانا، أو مكانا، أو زمانا\" — the companion is the constant attendant, whether by body or by care and concern.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) for physical accompaniment; metaphorical (Majaz) for ownership or mastery — \"هو صاحب مال وعلم\" (he is a possessor of wealth and knowledge) — and for divine guardianship: \"وصحبك الله تعالى\" (may Allah accompany you).\n- Root: ثمر (th-m-r)\n  * Lisan / Ayn: Fruit of trees; the produce that is eaten.\n  * Al-Raghib (Mufradat): \"الثمر اسم لكل ما يتطعم من أحمال الشجر\" — fruit is the name for all that is savored from the burdens of trees; used metaphorically for benefit and outcome.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) for botanical fruit; metaphorical (Majaz) for the knot at the tip of a whip — \"سوط عظيم الثمرة\" — and by extension, for any beneficial result or yield.\n- Root: قصد (q-ṣ-d)\n  * Lisan / Ayn: To intend, to aim, to head toward; the straight and middle path.\n  * Al-Raghib (Mufradat): \"القصد: استقامة الطريق\" — moderation is the straightness of the way; commendable mean between two blameworthy extremes (extravagance and stinginess, recklessness and cowardice).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) for physical direction and aiming; metaphorical (Majaz) for moral moderation — \"قصد في الأمر إذا لم يجاوز فيه الحد\" — and for the right path: \"على قصد السبيل\" (upon the straight way).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the text employs restrictive particles or contrastive structures (e.g., \"ليس ما يشترط... مشروطا\"), the predicate is confined to the subject alone, demanding precise scoping of conditions across distinct categories.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'", "badge": "Insight"}], "64": [{"arabic": "خوفا وطمعا} وقال عز وجل {والذين يبيتون لربهم سجدا وقياما} وقال عز وجل {كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون} وقال عز وجل {فسبحان الله حين تمسون وحين تصبحون} وقال تعالى {ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه} فهذا كله يبين لك أن الطريق إلى تعالى مراقبة الأوقات وعمارتها بالأوراد على سبيل الدوام ولذلك قال صلى الله عليه وسلم أحب عباد الله إلى الله الذين يراعون الشمس والقمر والأظلة لذكر الله تعالى (1) وقد قال تعالى {الشمس والقمر بحسبان} وقال تعالى {ألم تر إلى ربك كيف مد الظ", "english": "{«آناء الليل ساجدا وقائما يحذر الآخرة ويرجو رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون»} — \"During the hours of the night, prostrating and standing, fearing the Hereafter and hoping for the mercy of his Lord. Say: Are those who know equal to those who do not know?\" (Q. 39:9). And God Most High said: {«تتجافى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا»} — \"Their sides forsake their beds, calling upon their Lord in fear and hope\" (Q. 32:16). And God, Mighty and Majestic, said: {«والذين يبيتون لربهم سجدا وقياما»} — \"And those who pass the night prostrating and standing before their Lord\" (Q. 25:64). And God, Mighty and Majestic, said: {«كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون»} — \"They used to sleep but little of the night, and in the dawn-hours they would seek forgiveness\" (Q. 51:17-18). And God, Mighty and Majestic, said: {«فسبحان الله حين تمسون وحين تصبحون»} — \"So glory be to God when you enter the evening and when you enter the morning\" (Q. 30:17). And God Most High said: {«ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه»} — \"And do not drive away those who call upon their Lord morning and evening, desiring His Face\" (Q. 6:52). All of this makes clear to you that the path to God Most High is the watchfulness over the times (murāqabat al-awqāt) and the cultivation of them with the appointed devotions (al-awrād) in a perpetual manner.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 258", "section_title_en": "The Revival of the Religious Sciences — Section 258: The Virtues of the Watches (Awrād) and Their Ordering", "section_index": 258, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst at a watering place; al-Wird (pl. Awrād) denotes a set portion or appointed round of devotional recitation, by extension from the regular \"arrival\" at a source.\n  * Al-Raghib (Mufradat): Al-Wurūd is originally \"the intending of water,\" then used for other things. The theological nuance: the awrād are the appointed \"watering places\" of the soul — fixed times at which the servant presents himself before God to drink from the fountain of remembrance (dhikr).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"warda al-mā'a\" — to arrive at water. Metaphorical (Majāz): \"warada ʿalayhi amrun lam yuṭiqhu\" — an affair he could not bear arrived upon him; \"waradat-hu al-ḥummā\" — fever came upon him. Here, the awrād are the appointed times that \"come upon\" the servant, demanding their due of devotion.\n- Root: طلع (ṭ-l-ʿ)\n  * Lisan / Ayn: To rise, to appear above the horizon (of the sun); to ascend; to come upon suddenly.\n  * Al-Raghib (Mufradat): \"Ṭalaʿa al-shams ṭulūʿan wa-maṭlaʿan\" — the sun rose. From this is borrowed: \"ṭalaʿa ʿalaynā fulān\" — so-and-so came upon us. The maṭlaʿ is the place of rising.\n  * Al-Zamakhshari (Asas): Literal: \"ṭalaʿat al-shams\" — the sun rose. Metaphorical: \"ṭalaʿa ʿalaynā fulān\" — he descended upon us suddenly. The \"rising of the sun\" is the boundary-marker of the first watch.\n- Root: ليل (l-y-l)\n  * Lisan / Ayn: The night — from the time of sunset to sunrise; its root suggests \"enveloping\" and \"concealing.\"\n  * Al-Raghib (Mufradat): The night (al-layl) and the day (al-nahār) are two signs (āyatān) of God; the night is for stillness and the day for seeking provision.\n  * Al-Zamakhshari (Asas): Literal: the period of darkness. Metaphorical: \"layl al-hamm\" — the night of anxiety (a dark affair). The night is divided into watches for the one who stands in prayer.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating all else. Applied here: \"the purpose of the sun and moon's course is not for worldly matters, but only (innamā) for knowing the measures of the times.\"", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}], "67": [{"arabic": "وكذلك قال عز وجل والذين إذا أنفقوا لم يسرفوا ولم يقتروا فمن يسرف هذا الإسراف ينكر عليه ويجب على القاضي أن يحجر عليه إلا إذا كان الرجل وحده وكان له قوة في التوكل صادقة فله أن ينفق جميع ماله في أبواب البر ومن له عيال أو كان عاجزا عن التوكل فليس له أن يتصدق بجميع ماله وكذلك لو صرف جميع ماله إلى نقوش حيطانه وتزيين بنيانه فهو أيضا إسراف محرم وفعل ذلك ممن له مال كثير ليس بحرام لأن التزيين من الأغراض الصحيحة ولم تزل المساجد تزين وتنقش أبوابها وسقوفها مع أن نقش الباب والسقف لا", "english": "And excess varies according to circumstances. Thus we say: whoever possesses only one hundred dinars, for example, and has with him his dependents and children, and they have no means of livelihood other than it, and he spends all of it upon a banquet — he is an extravagant one who must be prevented. God, exalted be He, said: «ولا تبسطها كل البسط فتقعد ملوما محسورا» — \"And do not spread it forth with all spreading, lest you sit down blamed and exhausted\" — and this was revealed concerning a man in Medina who divided all his wealth and left nothing for his dependents; he was then demanded for maintenance and could not produce anything. And God, exalted be He, said: «ولا تبذر تبذيرا إن المبذرين كانوا إخوان الشياطين» — \"And do not squander with squandering; indeed, the squanderers are brothers of the devils.\" And likewise He, mighty and majestic, said: «والذين إذا أنفقوا لم يسرفوا ولم يقتروا» — \"And those who, when they spend, are neither extravagant nor niggardly.\" So whoever commits this extravagance is to be denounced, and it is obligatory upon the judge to place him under legal interdiction (ḥajr) — except if the man be alone [without dependents] and possess true strength in trust in God (tawakkul), then he may spend all his wealth upon the gates of righteousness. But whoever has dependents, or is incapable of [true] trust in God, it is not for him to give in charity all his wealth.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 549", "section_title_en": "Section 549 — On Sitting with a Sinner Without Necessity, and Related Rulings on Silk, Gold, Extravagance, and Permissible Merriment", "section_index": 549, "anchors": "- Root: زين (z-y-n)\n  * Lisan / Ayn: Core meaning of adornment, ornamentation, and beautification — that which renders something attractive or comely.\n  * Al-Raghib (Mufradat): True adornment (al-zīnah al-ḥaqīqiyyah) is that which never disgraces its bearer in any state, neither in this world nor the next; bodily and external adornments are only partial, being a disgrace in one respect while an ornament in another.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes physical beautification (e.g., adorning the earth with vegetation); metaphorical (majāz) usage extends to moral and spiritual adornment, as in faith being made beloved and adorned in the heart.\n- Root: سرف (s-r-f)\n  * Lisan / Ayn: Exceeding the proper limit in any act; the woodworm (surafah) that consumes timber utterly, leaving it hollow and ruined.\n  * Al-Raghib (Mufradat): Extravagance (isrāf) is transgressing the bound in every deed a person performs, whether in expenditure or otherwise; it is considered with regard to both quantity and quality — spending in disobedience to God is extravagance even if little.\n  * Al-Zamakhshari (Asas): Literal: a garment eaten by moths; Metaphorical: one whose intellect is consumed and corrupted, as the worm consumes wood — extravagance ruins wealth just as the insect ruins timber.\n- Root: كذب (k-dh-b)\n  * Lisan / Ayn: Falsehood in speech or deed; that which contradicts reality or intent.\n  * Al-Raghib (Mufradat): Falsehood is said of both utterance and action; the hypocrites' claim of faith was true in words but false in conviction — hence God declared them liars regarding their belief, not their speech.\n  * Al-Zamakhshari (Asas): Literal: to utter what is contrary to fact; Metaphorical: \"he carried then lied\" — meaning he attacked then retreated, making his charge false; likewise milk that fails to flow is called \"lying.\"\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed complement when the intervening clause is independently meaningful, just as conditional qualifications may be interposed without corrupting the syntactic bond.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Enjoining Good and Forbidding Evil'", "badge": "Hadith"}, {"arabic": "مغلولة إلى عنقك ولا تبسطها كل البسط وقال تعالى والذين إذا أنفقوا لم يسرفوا ولم يقتروا وكان بين ذلك قواما فالجود وسط بين الإسراف والإقتار وبين البسط والقبض وهو أن يقدر بذله وإمساكه بقدر الواجب ولا يكفي أن يفعل ذلك بجوارحه ما لم يكن قلبه طيبا به غير منازع له فيه فإن بذل في محل وجوب البذل ونفسه تنازعه وهو يصابرها فهو متسخ وليس بسخي بل ينبغي أن لا يكون لقلبه علاقة مع المال إلا من حيث يراد المال له وهو صرفه إلى ما يجب صرفه إليه", "english": "We say: Some have said that the definition of miserliness is \"the refusal of what is obligatory (wājib).\" Thus, whoever fulfills what is obligatory upon him is not a miser. But this is not sufficient — for a man who returns meat to the butcher, or bread to the baker, short by a grain or half a grain, is counted a miser by unanimous agreement. Likewise, one who hands over to his family the amount that the judge would apportion to them, but then tightens upon them regarding a morsel they have added beyond that, or a date they have eaten from his wealth, is counted a miser. And a man who has a loaf before him, and someone arrives whom he thinks will eat with him, and he hides it from him — he is counted a miser.", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 777", "section_title_en": "The Revival of the Religious Sciences — Book on the Affirmation of Generosity and Miserliness: Their Definitions and Realities", "section_index": 777, "anchors": "- Root: بخل (b-kh-l)\n  * Lisan / Ayn: Core meaning is withholding/restraining (imsāk) what one possesses from that which it is not right to withhold. Al-Khalil notes the intensive form \"bakhīl\" denotes one in whom miserliness is a dominant trait, as opposed to the simple agent noun \"bākhil.\"\n  * Al-Raghib (Mufradat): Miserliness (al-bukhl) is \"the withholding of possessions from that which it is not right to withhold them,\" and it is of two kinds: withholding one's own possessions, and withholding what belongs to others (i.e., commanding others to withhold) — the latter being the more blameworthy, as in {«Those who are miserly and command people to miserliness»} (al-Nisā' 4:37).\n  * Al-Zamakhshari (Asas): Literal (haqīqah): \"So-and-so did not show miserliness (lam yabkhal),\" and the noun \"bukhleh\" denotes a single act of miserliness. Metaphorical (majāz): The heavens \"withholding\" rain — {«When the sky withheld its rain»} — extending the root to natural phenomena.\n- Root: جود (j-w-d)\n  * Lisan / Ayn: Core meaning is the bountiful giving of what one possesses, whether wealth or knowledge. The intensive form \"jawād\" (pl. ajyād, ajāwīd) is applied to the generous man and the swift horse alike.\n  * Al-Raghib (Mufradat): Generosity (al-jūd) is \"the expending of possessions — whether wealth or knowledge — in the manner that is due.\" God is described as al-Jawād (the Generous). The term is also applied to abundant rain.\n  * Al-Zamakhshari (Asas): Literal: \"So-and-so was generous (jāda) with generosity (jūdan); the sky poured generously; the horse was swift (jādat).\" Metaphorical: \"I am yearning (jād) toward meeting you\" — derived from thirst (jūd), as a favorable omen, just as the desert wasteland is called \"mafāzah\" (place of salvation) though it is a place of perdition.\n- Root: سرف (s-r-f)\n  * Al-Raghib (Mufradat): Extravagance (al-isrāf) is \"exceeding the proper measure in expenditure,\" and it is the opposite of miserliness. It is blameworthy in all cases, as in {«And do not be extravagant; indeed, He does not love the extravagant»} (al-An'ām 6:141).\n- Root: قتر (q-t-r)\n  * Al-Raghib (Mufradat): Frugality/penuriousness (al-iqtār) is \"the tightening of expenditure below the proper measure,\" and it is the opposite of extravagance. The middle path between the two is praised in {«And those who, when they spend, are neither extravagant nor penurious, but hold a just balance between the two»} (al-Furqān 25:67).\n- Sibawayh Rule: Rule of Semantic Specification (Takhṣīṣ) — The definition of a term (ḥadd) must specify its referent (musammā) exhaustively and exclusively. A definition that fails to include all instances of the defined term (like \"withholding the obligatory\") or that includes what is not part of it (like \"finding giving difficult\") is defective. The true definition must capture the formal boundary (ḥadd) of the reality itself, not merely a concomitant or a partial description.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "68": [{"arabic": "الله ولقوله ولا تجعلوا مع الله إلها آخر فمن لم يره في كل شيء فقد رأى غيره وكل ما التفت إليه العبد سوى الله تعالى تضمن التفاته شيئا من الشرك الخفي بل التوحيد الخالص أن لا يرى في كل شيء إلا الله عز وجل العاشر التبري وأعني به أن يتبرأ من حوله وقوته والالتفات إلى نفسه بين الرضا والتزكية فإذا تلا بآيات الوعد والمدح للصالحين فلا يشهد نفسه عند ذلك بل يشهد الموقنين والصديقين فيها ويتشوف إلى أن يلحقه الله عز وجل بهم وإذا تلا آيات المقت وذم العصاة والمقصرين شهد على نفسه هناك وقدر أنه المخا", "english": "For this reason, Yūsuf ibn Asbāṭ said: \"I intend to recite the Qur'an, but when I recall what is in it, I fear abhorrence (al-maqt), so I turn instead to glorification (al-tasbīḥ) and seeking forgiveness (al-istighfār).\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 231", "section_title_en": "** The Revival of the Religious Sciences — Section 231: On the Inward Conditions of Qur'anic Recitation (Continued)", "section_index": 231, "anchors": "**\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the stirring of fear/apprehension within\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم}\" — the theological state of the heart's trembling upon remembrance of God\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل وجل، وقوم وجال، وقد وجل وجلا\" — the physical/emotional state of fear. Metaphorical (Majaz): The heart's trembling as the seat of spiritual perception\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning and transforming\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart as that which is constantly turning/transforming between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — physical turning. Metaphorical: \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the heart's turning toward or away from spiritual realities\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit — that which is breathed\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as the animating principle; also the self as the locus of blameworthy attributes\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — preciousness. Metaphorical: \"دفق نفسه أي دمه\" — the self as that which must be transcended in spiritual realization\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise delimitation of spiritual states (أحوال) and their hierarchical gradation (درجات)\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "74": [{"arabic": "ومدح أولياءه بسؤال ذلك في الدعاء فقال والذين يقولون ربنا هب لنا من أزواجنا وذرياتنا قرة أعين الآية ويقال أن الله تعالى لم يذكر في كتابه من الأنبياء إلا المتأهلين فقالوا إن يحيى صلى الله عليه وسلم قد تزوج ولم يجامع قيل إنما فعل ذلك لنيل الفضل وإقامة السنة وقيل لغض البصر وأما عيسى عليه السلام فإنه سينكح إذا نزل الأرض ويولد له وأما الأخبار فقوله صلى الله عليه وسلم النكاح سنتي فمن رغب عن سنتي فقد رغب عني وقال صلى الله عليه وسلم النكاح سنتي فمن أحب فطرتي فليستن بسنتي (1) وقال أيضا صلى الله عليه وسلم تناكحوا تكثروا فإني أباهي ب", "english": "As for the verses [of the Qur'an], God Most High has said: {وانكحوا الأيامى منكم} (\"And marry the unmarried among you\") — and this is a command. And He Most High said: {فلا تعضلوهن أن ينكحن أزواجهن} (\"Then do not prevent them from marrying their husbands\") — and this is a prohibition against prevention (al-ʿaḍl) and a forbiddance of it.", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 294", "section_title_en": "Section 294 — Encouragement of Marriage (الترغيب في النكاح)", "section_index": 294, "anchors": "- Root: رغب (raghiba)\n  * Lisan / Ayn: Core meaning denotes \"capacity/amplitude\" — a vessel or receptacle that is wide and receptive; by extension, the inclination of desire toward something with expansive longing.\n  * Al-Raghib (Mufradat): \"الرغبة والرغب والرغبى: السعة في الإرادة\" — the amplitude of the will. When said \"رغب فيه\" it necessitates eagerness for it; when said \"رغب عنه\" it implies the turning away of desire and renunciation (zuhd) of it.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"هو راغب فيه وراغب عنه\" — one is desirous of a thing or averse to it. Metaphorical (Majaz): \"واد رغيب: كثير الأخذ للماء\" — a valley that takes much water; thus the Prophet's \"من رغب عن سنتي\" is a metaphorical extension: one who turns his desire away from the Sunnah, refusing its amplitude.\n- Root: زوج (zawj)\n  * Lisan / Ayn: A pair; each of the two counterparts in a mating couple. Al-Raghib: \"يقال لكل واحد من القرينين من الذكر والأنثى في الحيوانات المتزاوجة زوج\" — each of the two paired ones, male and female, is called a zawj.\n  * Al-Raghib (Mufradat): \"ولكل ما يقترن بآخر مماثلا له أو مضاد زوج\" — everything that is coupled with another, whether similar or opposite, is a pair. \"وزوجة لغة رديئة\" — the form zawjah is a poor dialectal variant.\n  * Al-Zamakhshari (Asas): Literal: \"هو زوجها وهي زوجه وزوجته، وهما زوجان\" — he is her pair and she is his pair. Metaphorical: \"تزاوج الكلامان وازدوجا\" — two speeches are paired/coupled; thus marriage is the pairing of two complementary beings.\n- Root: منع (manaʿa)\n  * Lisan / Ayn: To withhold, prevent, or protect. Al-Raghib: \"المنع يقال في ضد العطية\" — said in opposition to giving; and \"يقال في الحماية\" — said of protection/defense.\n  * Al-Raghib (Mufradat): \"مكان منيع\" — an impregnable place; \"فلان ذو منعة\" — one who is mighty, protected against those who seek him.\n  * Al-Zamakhshari (Asas): Literal: \"منعه الشيء ومنعه منه وعنه\" — to prevent someone from a thing. Metaphorical: \"فلان يمنع الجار: يحميه من أن يضام\" — he protects the neighbor from being wronged. Thus \"عضل\" (prevention of marriage) is the withholding of a woman from her lawful marriage — a form of harmful prevention.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The Prophet's statements \"النكاح سنتي\" and \"من رغب عن سنتي فقد رغب عني\" employ restrictive predication: the Sunnah is defined by marriage, and aversion to it is equated with aversion to the Prophet himself — a rhetorical equation establishing identity between the act and its source.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Marriage'", "badge": "Du'a"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1385], [2, 1385, 2203], [3, 2203, 2862], [4, 2862, 4110], [5, 4110, 4919], [6, 4919, 5684], [7, 5684, 6739], [8, 6739, 8220], [9, 8220, 9310]], "2": [[1, 400, 1299], [2, 1299, 1666], [3, 1666, 2246], [4, 2246, 3836], [5, 3836, 5054], [6, 5054, 5731], [7, 5731, 6785], [8, 6785, 7771], [9, 7771, 8448], [10, 8448, 9125], [11, 9125, 9637], [12, 9637, 10546], [13, 10546, 11029], [14, 11029, 11860], [15, 11860, 12788], [16, 12788, 13320], [17, 13320, 13997], [18, 13997, 15128], [19, 15128, 16598]], "3": [[1, 400, 2280], [2, 2280, 2705], [3, 2705, 3946], [4, 3946, 5029], [5, 5029, 5741], [6, 5741, 7292], [7, 7292, 8269], [8, 8269, 8991], [9, 8991, 10542], [10, 10542, 11413], [11, 11413, 12900], [12, 12900, 14430], [13, 14430, 15418], [14, 15418, 16289], [15, 16289, 17309], [16, 17309, 18180], [17, 18180, 19667], [18, 19667, 20750], [19, 20750, 21621], [20, 21621, 22853], [21, 22853, 23724], [22, 23724, 25062]], "4": [[1, 400, 1548], [2, 1548, 2771], [3, 2771, 4612], [4, 4612, 5088], [5, 5088, 6539], [6, 6539, 8079], [7, 8079, 8772], [8, 8772, 10201], [9, 10201, 11803], [10, 11803, 12799], [11, 12799, 13600], [12, 13600, 15116], [13, 15116, 15863], [14, 15863, 17478], [15, 17478, 18539], [16, 18539, 19968]], "5": [[1, 400, 2327], [2, 2327, 3533], [3, 3533, 5072], [4, 5072, 6285], [5, 6285, 6892], [6, 6892, 7855], [7, 7855, 8676], [8, 8676, 9354], [9, 9354, 10799]], "6": [[1, 400, 834], [2, 834, 1841], [3, 1841, 2759], [4, 2759, 3687], [5, 3687, 4669], [6, 4669, 5163], [7, 5163, 6787], [8, 6787, 8031], [9, 8031, 8929], [10, 8929, 9640], [11, 9640, 10864], [12, 10864, 12236]], "7": [[1, 400, 1885], [2, 1885, 2522], [3, 2522, 3254], [4, 3254, 4430], [5, 4430, 5261], [6, 5261, 6565], [7, 6565, 7750], [8, 7750, 8192], [9, 8192, 9589], [10, 9589, 10944], [11, 10944, 11687], [12, 11687, 12500], [13, 12500, 13031], [14, 13031, 14092], [15, 14092, 14640], [16, 14640, 15736]], "8": [[1, 400, 1050], [2, 1050, 2879], [3, 2879, 3986], [4, 3986, 4708], [5, 4708, 5358], [6, 5358, 6441], [7, 6441, 6898], [8, 6898, 7921], [9, 7921, 9052], [10, 9052, 10135], [11, 10135, 11410], [12, 11410, 13681], [13, 13681, 14210], [14, 14210, 16003], [15, 16003, 17098], [16, 17098, 18205], [17, 18205, 20308]], "9": [[1, 400, 992], [2, 992, 1567], [3, 1567, 2619], [4, 2619, 2948], [5, 2948, 3977], [6, 3977, 5152], [7, 5152, 5744], [8, 5744, 7404], [9, 7404, 8422]], "10": [[1, 400, 1762], [2, 1762, 3477], [3, 3477, 4012], [4, 4012, 5510], [5, 5510, 6288], [6, 6288, 6774], [7, 6774, 8039], [8, 8039, 8878], [9, 8878, 9792], [10, 9792, 11232], [11, 11232, 12387], [12, 12387, 12873], [13, 12873, 14235], [14, 14235, 15680], [15, 15680, 17249], [16, 17249, 17918], [17, 17918, 19524]], "11": [[1, 400, 782], [2, 782, 2125], [3, 2125, 3621], [4, 3621, 5294], [5, 5294, 5867], [6, 5867, 6617], [7, 6617, 8113], [8, 8113, 9336]], "12": [[1, 400, 1254], [2, 1254