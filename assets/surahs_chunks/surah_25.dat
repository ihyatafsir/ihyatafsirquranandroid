": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 49, "text": "لِّنُحْـِۧيَ بِهِۦ بَلْدَةࣰ مَّيْتاࣰ وَنُسْقِيَهُۥ مِمَّا خَلَقْنَآ أَنْعَٰماࣰ وَأَنَاسِيَّ كَثِيراࣰۖ", "words": [{"id": 1, "arabic": "لِّنُحْـِۧيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَلْدَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّيْتاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنُسْقِيَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِمَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "خَلَقْنَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنْعَٰماࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَأَنَاسِيَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَثِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 50, "text": "وَلَقَدْ صَرَّفْنَٰهُ بَيْنَهُمْ لِيَذَّكَّرُواْ فَأَب۪يٰٓ أَكْثَرُ اُ۬لنَّاسِ إِلَّا كُفُوراࣰۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَرَّفْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَذَّكَّرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَب۪يٰٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَكْثَرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لنَّاسِ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "كُفُوراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 51, "text": "وَلَوْ شِئْنَا لَبَعَثْنَا فِے كُلِّ قَرْيَةࣲ نَّذِيراࣰۖ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "شِئْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَبَعَثْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَرْي