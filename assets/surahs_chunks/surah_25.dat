arsh"}, {"surah": 25, "ayah": 15, "text": "قُلَ اَذَٰلِكَ خَيْرٌ اَمْ جَنَّةُ اُ۬لْخُلْدِ اِ۬لتِے وُعِدَ اَ۬لْمُتَّقُونَۖ كَانَتْ لَهُمْ جَزَآءࣰ وَمَصِيراࣰۖ", "words": [{"id": 1, "arabic": "قُلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَذَٰلِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "خَيْرٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "جَنَّةُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْخُلْدِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لتِے", "translit": "", "root": ""}, {"id": 8, "arabic": "وُعِدَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْمُتَّقُونَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَانَتْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "جَزَآءࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَمَصِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 16, "text": "لَّهُمْ فِيهَا مَا يَشَآءُونَ خَٰلِدِينَۖ كَانَ عَلَيٰ رَبِّكَ وَعْداࣰ مَّسْـُٔولاࣰۖ", "words": [{"id": 1, "arabic": "لَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَشَآءُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "خَٰلِدِينَۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَعْداࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَّسْـُٔولاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 25, "ayah": 17, "text": "وَيَوْمَ نَحْشُرُهُمْ وَمَا يَعْبُدُونَ مِن دُونِ اِ۬للَّهِ فَيَقُولُ ءَآنتُمُۥٓ أَضْلَلْتُمْ عِبَادِے هَٰٓؤُلَآءِ اَ۬مْ هُمْ ضَلُّواْ اُ۬لسَّبِيلَۖ", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "",