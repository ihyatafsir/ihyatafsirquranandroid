{"surah": 85, "verses": [{"ayah": 1, "text": "وَٱلسَّمَآءِ ذَاتِ ٱلْبُرُوجِ ", "translation": "By the sky containing great stars", "words": [{"id": 1, "arabic": "وَٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱَw", "root": "سمو"}, {"id": 2, "arabic": "ذَاتِ", "translit": "ِtāَhd", "root": ""}, {"id": 3, "arabic": "ٱلْبُرُوجِ", "translit": "ِjgwُrُbْlٱ", "root": "برج"}], "hasIhya": false}, {"ayah": 2, "text": "وَٱلْيَوْمِ ٱلْمَوْعُودِ ", "translation": "And [by] the promised Day", "words": [{"id": 1, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 2, "arabic": "ٱلْمَوْعُودِ", "translit": "ِdwُʿعْwَmْlٱ", "root": "وعد"}], "hasIhya": false}, {"ayah": 3, "text": "وَشَاهِدٍ وَمَشْهُودٍ ", "translation": "And [by] the witness and what is witnessed,", "words": [{"id": 1, "arabic": "وَشَاهِدٍ", "translit": "ٍdِhāَhsَw", "root": "شهد"}, {"id": 2, "arabic": "وَمَشْهُودٍ", "translit": "ٍdwُhْhsَmَw", "root": "شهد"}], "hasIhya": false}, {"ayah": 4, "text": "قُتِلَ أَصْحَٰبُ ٱلْأُخْدُودِ ", "translation": "Destroyed [i.e., cursed] were the companions of the trench[1]", "words": [{"id": 1, "arabic": "قُتِلَ", "translit": "َlِtُq", "root": "قتل"}, {"id": 2, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 3, "arabic": "ٱلْأُخْدُودِ", "translit": "ِdwُdْhkُaʾْlٱ", "root": "خدد"}], "hasIhya": false}, {"ayah": 5, "text": "ٱلنَّارِ ذَاتِ ٱلْوَقُودِ ", "translation": "[Containing] the fire full of fuel,", "words": [{"id": 1, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 2, "arabic": "ذَاتِ", "translit": "ِtāَhd", "root": ""}, {"id": 3, "arabic": "ٱلْوَقُودِ", "translit": "ِdwُqَwْlٱ", "root": "وقد"}], "hasIhya": false}, {"ayah": 6, "text": "إِذْ هُمْ عَلَيْهَا قُعُودٌ ", "translation": "When they were sitting near it.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 3, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "قُعُودٌ", "translit": "ٌdwُʿعُq", "root": "قعد"}], "hasIhya": false}, {"ayah": 7, "text": "وَهُمْ عَلَىٰ مَا يَفْعَلُونَ بِٱلْمُؤْمِنِينَ شُهُودٌ ", "translation": "And they, to what they were doing against the believers, were witnesses. [1]", "words": [{"id": 1, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}, {"id": 5, "arabic": "بِٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱِb", "root": "امن"}, {"id": 6, "arabic": "شُهُودٌ", "translit": "ٌdwُhُhs", "root": "شهد"}], "hasIhya": false}, {"ayah": 8, "text": "وَمَا نَقَمُوا۟ مِنْهُمْ إِلَّآ أَن يُؤْمِنُوا۟ بِٱللَّهِ ٱلْعَزِيزِ ٱلْحَمِيدِ ", "translation": "And they resented them not except because they believed in Allāh, the Exalted in Might, the Praiseworthy,", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "نَقَمُوا۟", "translit": "۟āwُmَqَn", "root": "نقم"}, {"id": 3, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 4, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُy", "root": "امن"}, {"id": 7, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 8, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 9, "arabic": "ٱلْحَمِيدِ", "translit": "ِdyِmَḥْlٱ", "root": "حمد"}], "hasIhya": false}, {"ayah": 9, "text": "ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ ", "translation": "To whom belongs the dominion of the heavens and the earth. And Allāh, over all things, is Witness.[1]", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 9, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 10, "arabic": "شَهِيدٌ", "translit": "ٌdyِhَhs", "root": "شهد"}], "hasIhya": false}, {"ayah": 10, "text": "إِنَّ ٱلَّذِينَ فَتَنُوا۟ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ ثُمَّ لَمْ يَتُوبُوا۟ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ ٱلْحَرِيقِ ", "translation": "Indeed, those who have tortured[1] the believing men and believing women and then have not repented will have the punishment of Hell, and they will have the punishment of the Burning Fire.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فَتَنُوا۟", "translit": "۟āwُnَtَf", "root": "فتن"}, {"id": 4, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 5, "arabic": "وَٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 8, "arabic": "يَتُوبُوا۟", "translit": "۟āwُbwُtَy", "root": "توب"}, {"id": 9, "arabic": "فَلَهُمْ", "translit": "ْmُhَlَf", "root": ""}, {"id": 10, "arabic": "عَذَابُ", "translit": "ُbāَhdَʿع", "root": "عذب"}, {"id": 11, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 12, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 13, "arabic": "عَذَابُ", "translit": "ُbāَhdَʿع", "root": "عذب"}, {"id": 14, "arabic": "ٱلْحَرِيقِ", "translit": "ِqyِrَḥْlٱ", "root": "حرق"}], "hasIhya": false}, {"ayah": 11, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْكَبِيرُ ", "translation": "Indeed, those who have believed and done righteous deeds will have gardens beneath which rivers flow. That is the great attainment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "جَنَّٰتٌ", "translit": "ٌtَّٰnَjg", "root": "جنن"}, {"id": 8, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 11, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 14, "arabic": "ٱلْكَبِيرُ", "translit": "ُryِbَkْlٱ", "root": "كبر"}], "hasIhya": false}, {"ayah": 12, "text": "إِنَّ بَطْشَ رَبِّكَ لَشَدِيدٌ ", "translation": "Indeed, the assault [i.e., vengeance] of your Lord is severe.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "بَطْشَ", "translit": "َhsْṭَb", "root": "بطش"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "لَشَدِيدٌ", "translit": "ٌdyِdَhsَl", "root": "شدد"}], "hasIhya": false}, {"ayah": 13, "text": "إِنَّهُۥ هُوَ يُبْدِئُ وَيُعِيدُ ", "translation": "Indeed, it is He who originates [creation] and repeats.", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "يُبْدِئُ", "translit": "ُyʾِdْbُy", "root": "بدا"}, {"id": 4, "arabic": "وَيُعِيدُ", "translit": "ُdyِʿعُyَw", "root": "عود"}], "hasIhya": false}, {"ayah": 14, "text": "وَهُوَ ٱلْغَفُورُ ٱلْوَدُودُ ", "translation": "And He is the Forgiving, the Affectionate,", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلْغَفُورُ", "translit": "ُrwُfَغْlٱ", "root": "غفر"}, {"id": 3, "arabic": "ٱلْوَدُودُ", "translit": "ُdwُdَwْlٱ", "root": "ودد"}], "hasIhya": false}, {"ayah": 15, "text": "ذُو ٱلْعَرْشِ ٱلْمَجِيدُ ", "translation": "Honorable Owner of the Throne,", "words": [{"id": 1, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 2, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 3, "arabic": "ٱلْمَجِيدُ", "translit": "ُdyِjgَmْlٱ", "root": "مجد"}], "hasIhya": false}, {"ayah": 16, "text": "فَعَّالٌ لِّمَا يُرِيدُ ", "translation": "Effecter of what He intends.", "words": [{"id": 1, "arabic": "فَعَّالٌ", "translit": "ٌlāَّʿعَf", "root": "فعل"}, {"id": 2, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 3, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}], "hasIhya": false}, {"ayah": 17, "text": "هَلْ أَتَىٰكَ حَدِيثُ ٱلْجُنُودِ ", "translation": "Has there reached you the story of the soldiers -", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "أَتَىٰكَ", "translit": "َkٰàَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "حَدِيثُ", "translit": "ُhtyِdَḥ", "root": "حدث"}, {"id": 4, "arabic": "ٱلْجُنُودِ", "translit": "ِdwُnُjgْlٱ", "root": "جند"}], "hasIhya": false}, {"ayah": 18, "text": "فِرْعَوْنَ وَثَمُودَ ", "translation": "[Those of] Pharaoh and Thamūd?", "words": [{"id": 1, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 2, "arabic": "وَثَمُودَ", "translit": "َdwُmَhtَw", "root": ""}], "hasIhya": false}, {"ayah": 19, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى تَكْذِيبٍ ", "translation": "But they who disbelieve are in [persistent] denial,", "words": [{"id": 1, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "تَكْذِيبٍ", "translit": "ٍbyِhdْkَt", "root": "كذب"}], "hasIhya": false}, {"ayah": 20, "text": "وَٱللَّهُ مِن وَرَآئِهِم مُّحِيطٌۢ ", "translation": "While Allāh encompasses them from behind.[1]", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "وَرَآئِهِم", "translit": "mِhِyʾٓāَrَw", "root": "وري"}, {"id": 4, "arabic": "مُّحِيطٌۢ", "translit": "ٌۢṭyِḥُّm", "root": "حوط"}], "hasIhya": false}, {"ayah": 21, "text": "بَلْ هُوَ قُرْءَانٌ مَّجِيدٌ ", "translation": "But this is an honored Qur’ān", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "قُرْءَانٌ", "translit": "ٌnāَءْrُq", "root": "قرا"}, {"id": 4, "arabic": "مَّجِيدٌ", "translit": "ٌdyِjgَّm", "root": "مجد"}], "hasIhya": false}, {"ayah": 22, "text": "فِى لَوْحٍ مَّحْفُوظٍۭ ", "translation": "[Inscribed] in a Preserved Slate.", "words": [{"id": 1, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 2, "arabic": "لَوْحٍ", "translit": "ٍḥْwَl", "root": "لوح"}, {"id": 3, "arabic": "مَّحْفُوظٍۭ", "translit": "ٍۭẓwُfْḥَّm", "root": "حفظ"}], "hasIhya": false}], "tafsir": {}, "wordTiming": {"minshawi": {"1": [[1, 330, 3505], [2, 3505, 4484], [3, 4484, 5860]], "85:1": [[1, 330, 3505], [2, 3505, 4484], [3, 4484, 5860]], "2": [[1, 400, 2125], [2, 2125, 3820]], "85:2": [[1, 400, 2125], [2, 2125, 3820]], "3": [[1, 320, 2353], [2, 2353, 4560]], "85:3": [[1, 320, 2353], [2, 2353, 45