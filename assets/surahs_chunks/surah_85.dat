ic": "كُلِّ", "translit": "", "root": ""}, {"id": 9, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "شَهِيدٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 85, "ayah": 10, "text": "اِنَّ اَ۬لذِينَ فَتَنُواْ اُ۬لْمُومِنِينَ وَالْمُومِنَٰتِ ثُمَّ لَمْ يَتُوبُواْ فَلَهُمْ عَذَابُ جَهَنَّمَ وَلَهُمْ عَذَابُ اُ۬لْحَرِيقِۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَتَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْمُومِنِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالْمُومِنَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَتُوبُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَلَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَذَابُ", "translit": "", "root": ""}, {"id": 11, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَلَهُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَذَابُ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لْحَرِيقِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 85, "ayah": 11, "text": "إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمْ جَنَّٰتࣱ تَجْرِے مِن تَحْتِهَا اَ۬لَانْهَٰرُۖ ذَٰلِكَ اَ۬لْفَوْزُ اُ۬لْكَبِيرُۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "جَنَّٰتࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "تَجْرِے", "translit": "", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "", "ro