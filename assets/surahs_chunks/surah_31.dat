": 31, "ayah": 28, "text": "مَّا خَلْقُكُمْ وَلَا بَعْثُكُمُۥٓ إِلَّا كَنَفْسࣲ وَٰحِدَةٍۖ اِنَّ اَ۬للَّهَ سَمِيعُۢ بَصِيرٌۖ", "words": [{"id": 1, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلْقُكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْثُكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَنَفْسࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَٰحِدَةٍۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 10, "arabic": "سَمِيعُۢ", "translit": "", "root": ""}, {"id": 11, "arabic": "بَصِيرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 31, "ayah": 29, "text": "اَلَمْ تَرَ أَنَّ اَ۬للَّهَ يُولِجُ اُ۬ليْلَ فِے اِ۬لنَّه۪ارِ وَيُولِجُ اُ۬لنَّهَارَ فِے اِ۬ليْلِ وَسَخَّرَ اَ۬لشَّمْسَ وَالْقَمَرَ كُلࣱّ يَجْرِےٓ إِلَيٰٓ أَجَلࣲ مُّسَمّيࣰ وَأَنَّ اَ۬للَّهَ بِمَا تَعْمَلُونَ خَبِيرࣱۖ", "words": [{"id": 1, "arabic": "اَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُولِجُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬ليْلَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لنَّه۪ارِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَيُولِجُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لنَّهَارَ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِے", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬ليْلِ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَسَخَّرَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لشَّمْسَ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَالْقَمَرَ", "translit"