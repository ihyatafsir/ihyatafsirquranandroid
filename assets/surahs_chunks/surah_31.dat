ation": "warsh"}, {"surah": 31, "ayah": 29, "text": "اَلَمْ تَرَ أَنَّ اَ۬للَّهَ يُولِجُ اُ۬ليْلَ فِے اِ۬لنَّه۪ارِ وَيُولِجُ اُ۬لنَّهَارَ فِے اِ۬ليْلِ وَسَخَّرَ اَ۬لشَّمْسَ وَالْقَمَرَ كُلࣱّ يَجْرِےٓ إِلَيٰٓ أَجَلࣲ مُّسَمّيࣰ وَأَنَّ اَ۬للَّهَ بِمَا تَعْمَلُونَ خَبِيرࣱۖ", "words": [{"id": 1, "arabic": "اَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُولِجُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬ليْلَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لنَّه۪ارِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَيُولِجُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لنَّهَارَ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِے", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬ليْلِ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَسَخَّرَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لشَّمْسَ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَالْقَمَرَ", "translit": "", "root": ""}, {"id": 16, "arabic": "كُلࣱّ", "translit": "", "root": ""}, {"id": 17, "arabic": "يَجْرِےٓ", "translit": "", "root": ""}, {"id": 18, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 19, "arabic": "أَجَلࣲ", "translit": "", "root": ""}, {"id": 20, "arabic": "مُّسَمّيࣰ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَأَنَّ", "translit": "", "root": ""}, {"id": 22, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 23, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 24, "arabic": "تَعْمَلُونَ", "translit": "", "root": ""}, {"id": 25, "arabic": "خَبِيرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 31, "ayah": 30, "text": "ذَٰلِكَ بِأَنَّ اَ۬للَّهَ هُوَ اَ۬لْحَقُّ وَأَنَّ مَا تَدْعُونَ مِن دُونِهِ اِ۬لْبَٰطِلُ وَأَنَّ اَ۬للَّهَ هُوَ اَ۬