ot": ""}, {"id": 22, "arabic": "كَفُورࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 31, "ayah": 33, "text": "۞يَٰٓأَيُّهَا اَ۬لنَّاسُ اُ۪تَّقُواْ رَبَّكُمْ وَاخْشَوْاْ يَوْماࣰ لَّا يَجْزِے وَالِدٌ عَنْ وَّلَدِهِۦ وَلَا مَوْلُودٌ هُوَ جَازٍ عَنْ وَّالِدِهِۦ شَئْاًۖ اِنَّ وَعْدَ اَ۬للَّهِ حَقࣱّۖ فَلَا تَغُرَّنَّكُمُ اُ۬لْحَيَوٰةُ اُ۬لدُّنْي۪اۖ وَلَا يَغُرَّنَّكُم بِاللَّهِ اِ۬لْغَرُورُۖ", "words": [{"id": 1, "arabic": "۞يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۪تَّقُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبَّكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاخْشَوْاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَوْماࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَجْزِے", "translit": "", "root": ""}, {"id": 9, "arabic": "وَالِدٌ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَنْ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَّلَدِهِۦ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 13, "arabic": "مَوْلُودٌ", "translit": "", "root": ""}, {"id": 14, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 15, "arabic": "جَازٍ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَنْ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَّالِدِهِۦ", "translit": "", "root": ""}, {"id": 18, "arabic": "شَئْاًۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَعْدَ", "translit": "", "root": ""}, {"id": 21, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 22, "arabic": "حَقࣱّۖ", "translit": "", "root": ""}, {"id": 23, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 24, "arabic": "تَغُرَّنَّكُمُ", "translit": "", "root": ""}, {"id": 25, "arabic": "اُ۬لْحَيَوٰةُ", "translit": "", "root": ""}, {"id": 26, "arabic": "اُ۬لدُّنْي۪اۖ",