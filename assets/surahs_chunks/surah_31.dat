 سَبْعَةُ أَبْحُرٍ مَّا نَفِدَتْ كَلِمَٰتُ ٱللَّهِۗ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ ", "translation": "And if whatever trees upon the earth were pens and the sea [was ink], replenished thereafter by seven [more] seas, the words[1] of Allāh would not be exhausted. Indeed, Allāh is Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّمَا", "translit": "āَmَّnَaʾ", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "شَجَرَةٍ", "translit": "ٍẗَrَjgَhs", "root": "شجر"}, {"id": 7, "arabic": "أَقْلَٰمٌ", "translit": "ٌmَٰlْqَaʾ", "root": "قلم"}, {"id": 8, "arabic": "وَٱلْبَحْرُ", "translit": "ُrْḥَbْlٱَw", "root": "بحر"}, {"id": 9, "arabic": "يَمُدُّهُۥ", "translit": "ۥُhُّdُmَy", "root": "مدد"}, {"id": 10, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 11, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 12, "arabic": "سَبْعَةُ", "translit": "ُẗَʿعْbَs", "root": "سبع"}, {"id": 13, "arabic": "أَبْحُرٍ", "translit": "ٍrُḥْbَaʾ", "root": "بحر"}, {"id": 14, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 15, "arabic": "نَفِدَتْ", "translit": "ْtَdِfَn", "root": "نفد"}, {"id": 16, "arabic": "كَلِمَٰتُ", "translit": "ُtَٰmِlَk", "root": "كلم"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 21, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 28, "text": "مَّا خَلْقُكُمْ وَلَا بَعْثُكُمْ إِلَّا كَنَفْسٍ وَٰحِدَةٍۗ إِنَّ ٱللَّهَ سَمِيعٌۢ بَصِيرٌ ", "translation": "Your creation and your resurrection will not be but as that of a single soul.[1] Indeed, Allāh is Hearing and Seeing.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "خَلْقُكُمْ", "translit": "ْmُkُqْlَhk", "root": "خلق"}, {"id": 3, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 4, "arabic": "بَعْثُكُمْ", "translit": "ْmُkُhtْʿعَb", "root": "بعث"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "كَنَفْسٍ", "translit": "ٍsْfَnَk", "root": "نفس"}, {"id": 7, "arabic": "وَٰحِدَةٍ", "translit": "ٍẗَdِḥَٰw", "root": "وحد"}, {"id": 8, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "سَمِيعٌۢ", "translit": "ٌۢʿعyِmَs", "root": "سمع"}, {"id": 11, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 29, "text": "أَلَمْ تَرَ أَنَّ ٱللَّهَ يُولِجُ ٱلَّيْلَ فِى ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِى ٱلَّيْلِ وَسَخَّرَ ٱلشَّمْسَ وَٱلْقَمَرَ كُلٌّ يَجْرِىٓ إِلَىٰٓ أَجَلٍ مُّسَمًّى وَأَنَّ ٱللَّهَ بِمَا تَعْمَلُونَ خَبِيرٌ ", "translation": "Do you not see [i.e., know] that Allāh causes the night to enter the day and causes the day to enter the night and has subjected the sun and the moon, each running [its course] for a specified term, and that Allāh, of whatever you do, is Aware?", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "يُولِجُ", "translit": "ُjgِlwُy", "root": "ولج"}, {"id": 6, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلنَّهَارِ", "translit": "ِrāَhَّnlٱ", "root": "نهر"}, {"id": 9, "arabic": "وَيُولِجُ", "translit": "ُjgِlwُyَw", "root": "ولج"}, {"id": 10, "arabic": "ٱلنَّهَارَ", "translit": "َrāَhَّnlٱ", "root": "نهر"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 13, "arabic": "وَسَخَّرَ", "translit": "َrَّhkَsَw", "root": "سخر"}, {"id": 14, "arabic": "ٱلشَّمْسَ", "translit": "َsْmَّhslٱ", "root": "شمس"}, {"id": 15, "arabic": "وَٱلْقَمَرَ", "translit": "َrَmَqْlٱَw", "root": "قمر"}, {"id": 16, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 17, "arabic": "يَجْرِىٓ", "translit": "ٓàِrْjgَy", "root": "جري"}, {"id": 18, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 19, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 20, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 21, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 24, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 25, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 30, "text": "ذَٰلِكَ بِأَنَّ ٱللَّهَ هُوَ ٱلْحَقُّ وَأَنَّ مَا يَدْعُونَ مِن دُونِهِ ٱلْبَٰطِلُ وَأَنَّ ٱللَّهَ هُوَ ٱلْعَلِىُّ ٱلْكَبِيرُ ", "translation": "That is because Allāh is the True Reality, and that what they call upon[1] other than Him is falsehood, and because Allāh is the Most High, the Grand.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّ", "translit": "َّnَaʾِb", "root": ""}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 5, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 6, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دُونِهِ", "translit": "ِhِnwُd", "root": "دون"}, {"id": 11, "arabic": "ٱلْبَٰطِلُ", "translit": "ُlِṭَٰbْlٱ", "root": "بطل"}, {"id": 12, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "ٱلْعَلِىُّ", "translit": "ُّàِlَʿعْlٱ", "root": "علو"}, {"id": 16, "arabic": "ٱلْكَبِيرُ", "translit": "ُryِbَkْlٱ", "root": "كبر"}], "hasIhya": false}, {"ayah": 31, "text": "أَلَمْ تَرَ أَنَّ ٱلْفُلْكَ تَجْرِى فِى ٱلْبَحْرِ بِنِعْمَتِ ٱللَّهِ لِيُرِيَكُم مِّنْ ءَايَٰتِهِۦٓۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّكُلِّ صَبَّارٍ شَكُورٍ ", "translation": "Do you not see that ships sail through the sea by the favor of Allāh that He may show you of His signs? Indeed in that are signs for everyone patient and grateful.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱلْفُلْكَ", "translit": "َkْlُfْlٱ", "root": "فلك"}, {"id": 5, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 8, "arabic": "بِنِعْمَتِ", "translit": "ِtَmْʿعِnِb", "root": "نعم"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لِيُرِيَكُم", "translit": "mُkَyِrُyِl", "root": "راي"}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "ءَايَٰتِهِۦٓ", "translit": "ٓۦِhِtَٰyāَء", "root": "ايي"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 16, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 17, "arabic": "لِّكُلِّ", "translit": "ِّlُkِّl", "root": "كلل"}, {"id": 18, "arabic": "صَبَّارٍ", "translit": "ٍrāَّbَṣ", "root": "صبر"}, {"id": 19, "arabic": "شَكُورٍ", "translit": "ٍrwُkَhs", "root": "شكر"}], "hasIhya": false}, {"ayah": 32, "text": "وَإِذَا غَشِيَهُم مَّوْجٌ كَٱلظُّلَلِ دَعَوُا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ فَلَمَّا نَجَّىٰهُمْ إِلَى ٱلْبَرِّ فَمِنْهُم مُّقْتَصِدٌۚ وَمَا يَجْحَدُ بِـَٔايَٰتِنَآ إِلَّا كُلُّ خَتَّارٍ كَفُورٍ ", "translation": "And when waves come over them like canopies, they supplicate Allāh, sincere to Him in religion [i.e., faith]. But when He delivers them to the land, there are [some] of them who are moderate [in faith]. And none rejects Our signs except everyone treacherous and ungrateful.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "غَشِيَهُم", "translit": "mُhَyِhsَغ", "root": "غشو"}, {"id": 3, "arabic": "مَّوْجٌ", "translit": "ٌjgْwَّm", "root": "موج"}, {"id": 4, "arabic": "كَٱلظُّلَلِ", "translit": "ِlَlُّẓlٱَk", "root": "ظلل"}, {"id": 5, "arabic": "دَعَوُا۟", "translit": "۟āُwَʿعَd", "root": "دعو"}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مُخْلِصِينَ", "translit": "َnyِṣِlْhkُm", "root": "خلص"}, {"id": 8, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 9, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 10, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 11, "arabic": "نَجَّىٰهُمْ", "translit": "ْmُhٰàَّjgَn", "root": "نجو"}, {"id": 12, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 13, "arabic": "ٱلْبَرِّ", "translit": "ِّrَbْlٱ", "root": "برر"}, {"id": 14, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 15, "arabic": "مُّقْتَصِدٌ", "translit": "ٌdِṣَtْqُّm", "root": "قصد"}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "يَجْحَدُ", "translit": "ُdَḥْjgَy", "root": "جحد"}, {"id": 18, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 19, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 20, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 21, "arabic": "خَتَّارٍ", "translit": "ٍrāَّtَhk", "root": "ختر"}, {"id": 22, "arabic": "كَفُورٍ", "translit": "ٍrwُfَk", "root": "كفر"}], "hasIhya": false}, {"ayah": 33, "text": "يَٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمْ وَٱخْشَوْا۟ يَوْمًا لَّا يَجْزِى وَالِدٌ عَن وَلَدِهِۦ وَلَا مَوْلُودٌ هُوَ جَازٍ عَن وَالِدِهِۦ شَيْـًٔاۚ إِنَّ وَعْدَ ٱللَّهِ حَقٌّۖ فَلَا تَغُرَّنَّكُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا وَلَا يَغُرَّنَّكُم بِٱللَّهِ ٱلْغَرُورُ ", "translation": "O mankind, fear your Lord and fear a Day when no father will avail his son, nor will a son avail his father at all. Indeed, the promise of Allāh is truth, so let not the worldly life delude you and be not deceived about Allāh by the Deceiver [i.e., Satan].", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 4, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 5, "arabic": "وَٱخْشَوْا۟", "translit": "۟āْwَhsْhkٱَw", "root": "خشي"}, {"id": 6, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 7, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 8, "arabic": "يَجْزِى", "translit": "àِzْjgَy", "root": "جزي"}, {"id": 9, "arabic": "وَالِدٌ", "translit": "ٌdِlāَw", "root": "ولد"}, {"id": 10, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 11, "arabic": "وَلَدِهِۦ", "translit": "ۦِhِdَlَw", "root": "ولد"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "مَوْلُودٌ", "translit": "ٌdwُlْwَm", "root": "ولد"}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "جَازٍ", "translit": "ٍzāَjg", "root": "جزي"}, {"id": 16, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 17, "arabic": "وَالِدِهِۦ", "translit": "ۦِhِdِlāَw", "root": "ولد"}, {"id": 18, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 19, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 20, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "حَقٌّ", "translit": "ٌّqَḥ", "root": "حقق"}, {"id": 23, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 24, "arabic": "تَغُرَّنَّكُمُ", "translit": "ُmُkَّnَّrُغَt", "root": "غرر"}, {"id": 25, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 26, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 27, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 28, "arabic": "يَغُرَّنَّكُم", "translit": "mُkَّnَّrُغَy", "root": "غرر"}, {"id": 29, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 30, "arabic": "ٱلْغَرُورُ", "translit": "ُrwُrَغْlٱ", "root": "غرر"}], "hasIhya": true}, {"ayah": 34, "text": "إِنَّ ٱللَّهَ عِندَهُۥ عِلْمُ ٱلسَّاعَةِ وَيُنَزِّلُ ٱلْغَيْثَ وَيَعْلَمُ مَا فِى ٱلْأَرْحَامِۖ وَمَا تَدْرِى نَفْسٌ مَّاذَا تَكْسِبُ غَدًاۖ وَمَا تَدْرِى نَفْسٌۢ بِأَىِّ أَرْضٍ تَمُوتُۚ إِنَّ ٱللَّهَ عَلِيمٌ خَبِيرٌۢ ", "translation": "Indeed, Allāh [alone] has knowledge of the Hour and sends down the rain and knows what is in the wombs.[1] And no soul perceives what it will earn tomorrow, and no soul perceives in what land it will die. Indeed, Allāh is Knowing and Aware.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 4, "arabic": "عِلْمُ", "translit": "ُmْlِʿع", "root": "علم"}, {"id": 5, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 6, "arabic": "وَيُنَزِّلُ", "translit": "ُlِّzَnُyَw", "root": "نزل"}, {"id": 7, "arabic": "ٱلْغَيْثَ", "translit": "َhtْyَغْlٱ", "root": "غيث"}, {"id": 8, "arabic": "وَيَعْلَمُ", "translit": "ُmَlْʿعَyَw", "root": "علم"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْأَرْحَامِ", "translit": "ِmāَḥْrَaʾْlٱ", "root": "رحم"}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "تَدْرِى", "translit": "àِrْdَt", "root": "دري"}, {"id": 14, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 15, "arabic": "مَّاذَا", "translit": "āَhdāَّm", "root": ""}, {"id": 16, "arabic": "تَكْسِبُ", "translit": "ُbِsْkَt", "root": "كسب"}, {"id": 17, "arabic": "غَدًا", "translit": "āًdَغ", "root": "غدو"}, {"id": 18, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 19, "arabic": "تَدْرِى", "translit": "àِrْdَt", "root": "دري"}, {"id": 20, "arabic": "نَفْسٌۢ", "translit": "ٌۢsْfَn", "root": "نفس"}, {"id": 21, "arabic": "بِأَىِّ", "translit": "ِّàَaʾِb", "root": "ايي"}, {"id": 22, "arabic": "أَرْضٍ", "translit": "ٍḍْrَaʾ", "root": "ارض"}, {"id": 23, "arabic": "تَمُوتُ", "translit": "ُtwُmَt", "root": "موت"}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 27, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}], "hasIhya": false}], "tafsir": {"6": [{"arabic": "احتجوا بقوله تعالى ومن الناس من يشتري لهو الحديث قال ابن مسعود والحسن البصري والنخعي رضي الله عنهم أن لهو الحديث هو الغناء وروت عائشة رضي الله عنها أن النبي صلى الله عليه وسلم قال إن الله تعالى حرم القينة وبيعها وثمنها وتعليمها (1) فنقول أما القينة فالمراد بها الجارية التي تغني للرجال في مجلس الشرب وقد ذكرنا أن غناء الأجنبية للفساق ومن يخاف عليهم الفتنة حرام وهم لا يقصدون بالفتنة إلا ما هو محظور فأما غناء الجارية لمالكها فلا يفهم تحريمه من هذا الحديث بل لغير مالكها سماعها عند عدم الفتنة بدليل", "english": "Yūnus ibn ʿAbd al-Aʿlā said: I asked al-Shāfiʿī — may God have mercy on him — about the people of Medina permitting audition (samāʿ). Al-Shāfiʿī said: \"I know of no one among the scholars of the Ḥijāz who disapproved of audition, except what pertains to descriptive verses [of women]. As for the camel-driver's chant (ḥudāʾ), the mention of ruined abodes and resting places, and the beautifying of the voice with the melodies of poetry — this is permissible.\"", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 498", "section_title_en": "On the True Reality of His Essence — The Permissibility of Audition (Samāʿ) and Refutation of Its Prohibitors", "section_index": 498, "anchors": "- Root: لهو (lahw)\n  * Lisan / Ayn: Core meaning of diversion, play, and that which distracts from serious purpose\n  * Al-Raghib (Mufradat): That which occupies one without benefit; distinguished from mere idleness by its capacity to divert the heart\n  * Al-Zamakhshari (Asas): Literal sense of play/amusement; metaphorical extension to anything that turns one from weighty matters\n- Root: بطل (baṭal)\n  * Lisan / Ayn: Falsehood, nullity, that which has no reality or benefit\n  * Al-Raghib (Mufradat): The opposite of truth (ḥaqq); that which yields no fruit nor enduring consequence\n  * Al-Zamakhshari (Asas): Literal: falsehood; metaphorical: any act devoid of genuine utility\n- Root: كره (kariha)\n  * Lisan / Ayn: Dislike, aversion; al-karāhah as that which one finds repugnant\n  * Al-Raghib (Mufradat): Two types: what nature abhors, and what intellect or Law deems repugnant\n  * Al-Zamakhshari (Asas): Literal: dislike; metaphorical (karāhat al-tanzīh): disapprobation short of prohibition\n- Sibawayh Rule: Restriction and qualification (taqyīd) — how qualifiers like \"in the descriptions\" (fī al-awṣāf) narrow general rulings", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Audition and Ecstasy'", "badge": "Hadith"}], "15": [{"arabic": "قال {واتبع سبيل من أناب إلي} وفي مفهوم ذلك زجر عن الفاسق وأما المبتدع ففي صحبته خطر سراية البدعة وتعدي شؤمها إليه فالمبتدع مستحق للهجر والمقاطعة فكيف تؤثر صحبته وقد قال عمر رضي الله عنه في الحث على طلب التدين في الصديق فيما رواه سعيد بن المسيب قال عليك بإخوان الصدق تعش في أكنافهم فإنهم زينة في الرخاء وعدة في البلاء وضع أمر أخيك على أحسنه حتى يجيئك ما يغلبك منه واعتزل عدوك واحذر صديقك إلا الأمين من القوم ولا أمين إلا من خشي الله فلا تصحب الفاجر فتتعلم من فجوره ولا تطعه", "english": "I say: We have mentioned the one who desires nothing but the life of this world, and He — the Exalted — said: {«وَاتَّبِعْ سَبِيلَ مَنْ أَنَابَ إِلَيَّ»} (And follow the way of him who turns to Me in repentance) [Luqmān 31:15]. And in the very meaning of this [verse] there is a deterrent against [accompanying] the wicked (fāsiq).", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 415", "section_title_en": "The Revival of the Religious Sciences — On the Etiquette of Companionship: The Qualities of the True Friend and the Categories of Those Whose Company Must Be Avoided", "section_index": 415, "anchors": "- Root: صحب (Ṣ-Ḥ-B)\n  * Lisan / Ayn: The root denotes accompaniment, association, and enduring fellowship — whether with persons, animals, places, or times. Al-Farahidi notes the plural forms (ṣaḥb, ṣiḥāb, aṣḥāb) and that the companion (al-ṣāḥib) is one who is never separated from you in any state.\n  * Al-Raghib (Mufradat): \"Al-ṣāḥib is the one who accompanies — whether a human, an animal, a place, or a time. There is no difference between accompaniment being by the body — which is the original and most frequent — or by care and concern.\"\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical, enduring companionship. Metaphorical (majāz): \"He is a companion of wealth and knowledge and everything\" — i.e., the one who possesses it and is attached to it in concern. Also: \"May God accompany you\" (ṣaḥabaka Allāh) meaning His protection and preservation.\n- Root: صدق (Ṣ-D-Q)\n  * Lisan / Ayn: Truthfulness and veracity in speech and action; the truthful friend (ṣadūq) is one whose friendship is pure and unadulterated.\n  * Al-Raghib (Mufradat): \"Truth and falsehood have their origin in speech... but they may occur secondarily in other types of discourse.\" The ṣiddīq is one who attains the utmost degree of truthfulness.\n  * Al-Zamakhshari (Asas): Literal: truthfulness in speech. Metaphorical: \"a man truthful in attack (ṣādiq al-ḥamlah)\" — i.e., one whose courage is genuine and proven in battle.\n- Root: حسن (Ḥ-S-N)\n  * Lisan / Ayn: Beauty, goodness, and excellence — both in appearance and in moral character.\n  * Al-Raghib (Mufradat): \"Al-ḥasan is an expression for everything that delights and is desired — of three kinds: that deemed good by the intellect, that deemed good by passion, and that deemed good by the senses.\" Good character (ḥusn al-khuluq) is that which the intellect and revelation deem beautiful.\n  * Al-Zamakhshari (Asas): Literal: physical beauty. Metaphorical: \"Sit well (ijlis ḥasanan)\" and \"a man who does not do anything well\" — i.e., excellence in action and character.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a governing word and its governed prepositional phrase, demonstrating that Arabic syntax permits structural flexibility for rhetorical emphasis without altering the underlying grammatical relations.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}], "16": [{"arabic": "قال رسول الله صلى الله عليه وسلم لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر ولا يدخل الجنة من كان في قلبه مثقال حبة من خردل من إيمان (1) حديث أبي هريرة يقول الله تعالى الكبرياء ردائي والعظمة إزاري فمن نازعني واحدا منهما ألقيته في جهنم أخرجه مسلم وأبو داود وابن ماجه واللفظ له وقال أبو داود قذفته في النار وقال مسلم عذبته وقال رداؤه وإزاره بالغيبة وزاد مع أبي هريرة أبا سعيد أيضا وعن أبي سلمة بن عبد الرحمن قال التقى عبد الله بن عمرو وعبد الله بن عمر على الصفا فتواقفا فمضى ابن عمرو وأقام ابن عمر يبكي فقالوا ما يب", "english": "To proceed: The Messenger of God, may God bless him and grant him peace, said — God, exalted be He, said: \"Pride (al-kibriyāʾ) is My cloak, and greatness (al-ʿaẓamah) is My wrapper; whoever contends with Me over either of them, I crush him.\" {«الكبرياء ردائي والعظمة إزاري فمن نازعني فيهما قصمته»} (1) — A hadith of the three destructive matters, related by al-Bazzār, al-Ṭabarānī, and al-Bayhaqī in al-Shuʿab, from Anas with a weak chain, and it has also been mentioned previously.", "book_title": "Foundations of Belief", "section_title_ar": "Section 847", "section_title_en": "The Book of Condemnation of Pride and Self-Admiration — Being the Ninth Book of the Quarter of Destructive Matters from The Revival of the Religious Sciences", "section_index": 847, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"al-kibriyā'\" is the supreme majesty exclusive to God.\n  * Al-Raghib (Mufradat): \"al-kabīr wa al-ṣaghīr\" are relative terms; used for quantity, quality, and dignity. \"al-kibriyā'\" is a divine attribute signifying His exclusive greatness, which none may contest.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"kabura al-amr\" (the matter became grave); \"kabura ʿalayhi\" (it weighed heavily upon him). Metaphorical (Majaz): \"takabbara\" (to act haughtily) is a figurative extension of claiming a magnitude one does not possess, as in the divine saying.\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Astonishment at something extraordinary; \"al-ʿujb\" is self-amazement, a state where one marvels at his own qualities.\n  * Al-Raghib (Mufradat): Astonishment arises from ignorance of the true cause; self-admiration (ʿujb) blinds one to one's own defects and to the divine origin of all good.\n  * Al-Zamakhshari (Asas): Literal: \"ʿajiba minhu\" (he marveled at it). Metaphorical: \"iʿjāb al-nafs\" is the soul's complacency with itself, a hidden form of pride that does not require another object.\n- Root: هلك (h-l-k)\n  * Lisan / Ayn: Perishing, destruction, ruin; \"al-muhlikāt\" are the things that cause perdition.\n  * Al-Raghib (Mufradat): Destruction is of three kinds: loss, corruption, and death. Here it is spiritual perdition — the ruin of the soul's eternal felicity.\n  * Al-Zamakhshari (Asas): Literal: physical ruin. Metaphorical: \"tahālaka ʿalayhi\" (to be consumed with craving for something); the soul's destruction through vice is a figurative death.\n- Sibawayh Rule: Rule of Apposition and Parenthetical Clauses (al-badal wa al-iʿtirāḍ) — The opening doxology employs extended appositional chains (badal) and parenthetical invocations that delay the main clause, requiring the translator to preserve the periodic structure without collapsing the theological weight of each divine epithet.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}], "17": [{"arabic": "فقال يا أبا ثعلبة مر بالمعروف وأنه عن المنكر فإذا رأيت شحا مطاعا وهوى متبعا ودنيا مؤثرة وإعجاب كل ذي رأي برأيه فعليك بنفسك ودع عنك العوام إن من ورائكم فتنا كقطع الليل المظلم للمتمسك فيها بمثل الذي أنتم عليه أجر خمسين منكم قيل بل منهم يا رسول الله قال لا بل منكم لأنكم تجدون على الخير أعوانا ولا يجدون عليه أعوانا وسئل ابن مسعود رضي الله عنه عن تفسير هذه الآية فقال إن هذا ليس زمانها إنها اليوم مقبولة ولكن قد أوشك أن يأتي زمانها تأمرون بالمعروف فيصنع بكم كذا وكذا وتقولون فلا يقبل منكم فحينئذ عليكم أنف", "english": "Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 521", "section_title_en": "Section 521", "section_index": 521, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Enjoining Good and Forbidding Evil'", "badge": "Ethics"}, {"arabic": "الفحشاء والمنكر والبغي} وقوله {واصبر على ما أصابك إن ذلك من عزم الأمور} وقوله {ولمن صبر وغفر إن ذلك لمن عزم الأمور} وقوله {فاعف عنهم واصفح إن الله يحب المحسنين} وقوله {وليعفوا وليصفحوا ألا تحبون أن يغفر الله لكم} وقوله {ادفع بالتي هي أحسن فإذا الذي بينك وبينه عداوة كأنه ولي حميم} وقوله {والكاظمين الغيظ والعافين عن الناس والله يحب المحسنين} وقوله {اجتنبوا كثيرا من الظن إن بعض الظن إثم ولا تجسسوا ولا يغتب بعضكم بعضا} ولما كسرت رباعيته وشج يوم أحد فجعل الدم يسيل على وجهه وهو يمسح الدم ويقول كيف يفلح قوم خضبوا وجه", "english": "The Messenger of God, peace and blessings be upon him, was abundant in supplication and earnest entreaty, perpetually asking God Most High to adorn him with the beauties of refined conduct and the noble traits of character. Thus he would say in his supplication: \"O God, beautify my outward form and my inward character (khuluqī wa-khalqī)\" (1), and he would say: \"O God, protect me from the reprehensible traits of character\" (2). God Most High answered his supplication, fulfilling His word, Exalted is He: {«ادعوني أستجب لكم»} [\"Call upon Me, I will answer you\"] (Ghafir 40:60). So He sent down upon him the Qur'an and disciplined him through it, and his character became the Qur'an.", "book_title": "Etiquette of Living and Prophetic Character", "section_title_ar": "Section 559", "section_title_en": "The Prophet's Discipline Through the Qur'an and the Invitation to Noble Moral Traits", "section_index": 559, "anchors": "- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning of measuring, fashioning, and creating upon a precise estimation; also used for innate disposition and character.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — the root denotes straight/right estimation; used for bringing something into being from nothing (ibdāʿ) and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خلق الخراز الأديم\" — the leather-worker measures before cutting. Metaphorical (Majaz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom; and \"له خلق حسن\" — he has beautiful character.\n- Root: كرم (karuma)\n  * Lisan / Ayn: Generosity, nobility, honor; the root of karīm (noble/generous) and makārim (noble traits).\n  * Al-Raghib (Mufradat): \"الكرم إذا وصف الله تعالى به فهو اسم لإحسانه وإنعامه المتظاهر\" — when attributed to God, it denotes His manifest beneficence; when attributed to man, it denotes praiseworthy morals and deeds that appear from him.\n  * Al-Zamakhshari (Asas): Literal: \"كرم علينا فلان كرامة\" — he showed generosity. Metaphorical: \"قوم كرم\" — a noble people; \"كرم السحاب تكريما: جاد بمطره\" — the cloud was generous with its rain.\n- Root: أدب (adaba)\n  * Lisan / Ayn: Refinement, discipline, cultivation of character; calling to a gathering (ma'dabah) — the root implies assembling and summoning toward excellence.\n  * Al-Raghib (Mufradat): Discipline (ta'dīb) is the cultivation of the soul through praiseworthy traits and the restraint from blameworthy ones.\n  * Al-Zamakhshari (Asas): Literal: \"أدبته تأديبا\" — I disciplined him. Metaphorical: \"أدبه الله\" — God disciplined him, i.e., refined his character through divine instruction.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما أدبه القرآن\" restricts the means of the Prophet's discipline exclusively to the Qur'an, affirming that the Qur'an alone was the sufficient and complete instrument of his moral formation.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Living and Prophetic Character'", "badge": "Du'a"}, {"arabic": "فقال حاكيا عن لقمان يا بني أقم الصلاة وأمر بالمعروف وانه عن المنكر واصبر على ما أصابك ومن الآداب تقليل العلائق حتى لا يكثر خوفه وقطع الطمع عن الخلائق حتى تزول عنه المداهنة فقد روي عن بعض المشايخ أنه كان له سنور وكان يأخذ من قصاب في جواره كل يوم شيئا من الغدد لسنوره فرأى على القصاب منكرا فدخل الدار أولا وأخرج السنور ثم جاء واحتسب على القصاب فقال له القصاب لا أعطينك بعد هذا شيئا لسنورك فقال ما احتسبت عليك إلا بعد إخراج السنور وقطع الطمع منك وهو كما قال فمن لم يقطع الطمع من الخلق لم يقدر على الحسبة ومن طمع في أن", "english": "We do not mean by this that commanding right becomes prohibited by reason of one's sinfulness — rather, its effect upon hearts falls away by the manifestation of his sinfulness to the people. For it has been related from Anas, may God be pleased with him, who said: \"We said, 'O Messenger of God, shall we not command right until we have acted upon it entirely, and shall we not forbid wrong until we have shunned it entirely?' He said, may God's peace and blessings be upon him: 'Rather, command right even if you do not act upon it entirely, and forbid wrong even if you do not shun it entirely.'\"", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 543", "section_title_en": "On Gentleness in Commanding Right and Forbidding Wrong — The Etiquette of the Muḥtasib", "section_index": 543, "anchors": "- Root: عيب (ʿayb)\n  * Lisan / Ayn: Core root meaning — defect, blemish, reproach; to find fault with something.\n  * Al-Raghib (Mufradat): Theological nuance — the reproach of intellect (ʿaql) is the severest form of deficiency, for it touches the very faculty by which one is distinguished from beasts.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — here used metaphorically: the reproach falls upon his intellect, i.e., the deficiency of his discernment becomes manifest.\n- Sibawayh Rule: Rule of Restriction (Bāb al-Ḥaṣr) — \"فإنما يزرى على عقله\" restricts the object of reproach to the intellect alone, excluding the person's faith or status.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Anger and Hatred'", "badge": "Insight"}], "18": [{"arabic": "ومنها أن يتواضع لكل مسلم ولا يتكبر عليه فإن الله لا يحب كل مختال فخور قال رسول الله صلى الله عليه وسلم إن الله تعالى أوحى إلي أن تواضعوا حتى لا يفخر أحد على أحد (6) ثم إن تفاخر عليه غيره فليحتمل قال الله تعالى لنبيه صلى الله عليه وسلم {خذ العفو وأمر بالعرف وأعرض عن الجاهلين} وعن ابن أبي أوفى كان رسول الله صلى الله عليه وسلم يتواضع لكل مسلم ولا يأنف ولا يتكبر أن يمشي مع الأرملة والمسكين فيقضي حاجته (7) ومنها أن لا يسمع بلاغات الناس بعضهم على بعض ولا يبلغ بعضهم ما يسمع من بعض قال صلى الله عليه وسلم لا يدخل الجنة", "english": "**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 433", "section_title_en": "The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims", "section_index": 433, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Duties of Brotherhood'", "badge": "Ethics"}, {"arabic": "وسلم فقال نعم إن الله لا يحب المستكبرين فنزل وقعد معهم على الأرض وأكل ثم سلم عليهم وركب وقال قد أجبتكم فأجيبوني قالوا نعم فوعدهم وقتا معلوما فحضروا فقدم إليهم فاخر الطعام وجلس يأكل معهم وأما قول القائل إن من وضعت يدي في قصعته فقد ذلت له رقبتي فقد قال بعضهم هذا خلاف السنة وليس كذلك فإنه ذل إذا كان الداعي لا يفرح بالإجابة ولا يتقلد منة وكان يرى ذلك يدا له على المدعو ورسول الله صلى الله عليه وسلم كان يحضر لعلمه أن الداعي له يتقلد منة ويرى ذلك شرفا وذخرا لنفسه في الدنيا", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Anger and Hatred'", "badge": "Ethics"}], "19": [{"arabic": "وقول الله تعالى {إن أنكر الأصوات لصوت الحمير} يدل بمفهومه على مدح الصوت الحسن ولو جاز أن يقال إنما أبيح ذلك بشرط أن يكون في القرآن للزمه أن يحرم سماع صوت العندليب لأنه ليس من القرآن وإذا جاز سماع صوت غفل لا معنى له فلم لا يجوز سماع صوت يفهم منه الحكمة والمعاني الصحيحة وإن من الشعر لحكمة فهذا نظر في الصوت من حيث أنه طيب حسن الدرجة الثانية النظر في الصوت الطيب الموزون فإن الوزن وراء الحسن فكم من صوت حسن خارج عن الوزن وكم من صوت موزون غير مستطاب والأصوات الموزونه باعتبار مخارجها ثلاثة ف", "english": "As for the scriptural text (al-naṣṣ), it indicates the permissibility of hearing a beautiful voice as a grace (imtinān) from God Most High upon His servants, for He said: {«يَزِيدُ فِي الْخَلْقِ مَا يَشَاءُ»} (\"He increases in creation what He wills\" — Qurʾān 35:1). And it was said: \"It is the beautiful voice.\" And in the ḥadīth: \"God never sent a prophet but with a beautiful voice.\" And he (peace be upon him) said: \"God listens more intently to a man with a beautiful voice reciting the Qurʾān than does the master of a singing-girl to his singing-girl.\" And in the ḥadīth, in the mode of praising David (peace be upon him): he had a beautiful voice in his lamentation over himself and in his recitation of the Psalms, such that humans, jinn, wild beasts, and birds would gather to hear his voice, and four hundred funeral biers would be borne to his assembly, and none would approach it during those times. And he (peace be upon him) said in praise of Abū Mūsā al-Ashʿarī: \"He has indeed been given a flute from the flutes of the family of David.\" And the saying of God Most High: {«إِنَّ أَنكَرَ الْأَصْوَاتِ لَصَوْتُ الْحَمِيرِ»} (\"Indeed, the most disagreeable of sounds is the voice of donkeys\" — Qurʾān 31:19) indicates, by its implication (mafhūm), praise of the beautiful voice.", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 489", "section_title_en": "The Revival of the Religious Sciences — On the Hearing of Melodious Sounds and the Degrees of Their Permissibility", "section_index": 489, "anchors": "- Root: صوت (ṣ-w-t)\n  * Lisan / Ayn: Sound as the vibration of air produced by the percussion of two bodies; encompasses both the unarticulated cry of animals and the articulated speech of humans.\n  * Al-Raghib (Mufradat): Sound is compressed air from the striking of two bodies; it is either purely natural (as from inanimate objects or animals) or volitional (as from humans, whether by hand, like the lute, or by the mouth, whether articulate speech or not).\n  * Al-Zamakhshari (Asas): Literal usage (ḥaqīqah) denotes the audible sound itself; metaphorically (majāz), one says \"he has a voice (ṣawt) among the people\" meaning reputation and renown.\n- Root: حرم (ḥ-r-m)\n  * Lisan / Ayn: To forbid, prohibit, or render sacred; the protected precinct (ḥimā) surrounding a sanctuary.\n  * Al-Raghib (Mufradat): Prohibition (taḥrīm) is of two kinds: by divine decree (takhlīq) or by human law; the sacred law's prohibitions are protective barriers around what is unlawful.\n  * Al-Zamakhshari (Asas): Literal: what is unlawful to approach; Metaphorical (majāz): \"the sanctities of the night\" (maḥārim al-layl) — its terrors and perils that make travel unlawful (dangerous).\n- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: Beauty, goodness, excellence; that which pleases the eye or the intellect.\n  * Al-Raghib (Mufradat): The good (al-ḥasan) is that which is desirable and pleasing, whether by reason, by passion, or by sense perception.\n  * Al-Zamakhshari (Asas): Literal: physical beauty; Metaphorical: \"he does not do anything well\" (lā yuḥsinu shay'an) — i.e., he lacks skill or virtue.\n- Root: طيب (ṭ-y-b)\n  * Lisan / Ayn: That which is good, pure, pleasant, lawful.\n  * Al-Raghib (Mufradat): The root meaning is what the senses and the soul find pleasurable; in Sacred Law, \"lawful good things\" (ṭayyibāt) are those obtained from permissible sources in permissible ways.\n  * Al-Zamakhshari (Asas): Literal: pleasant to the senses; Metaphorical: \"it became good (ṭāba) for me\" meaning lawful, and \"good spoils\" (saby ṭayyib) meaning lawful, not obtained by treachery.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa-l-taqyīd bi-innamā) — The particle \"innamā\" restricts the predicate to the subject alone, a crucial tool for understanding the precise scope of legal prohibitions (e.g., \"forbidden is only the lute and the flute\").", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Audition and Ecstasy'", "badge": "Hadith"}], "25": [{"arabic": "ولذلك قال عز وجل ولئن سألتهم من خلق السموات والأرض ليقولن الله وقال تعالى فأقم وجهك للدين حنيفا فطرة الله التي", "english": "The First Principle: the knowledge of His existence, the Exalted. The first thing by which one is illuminated from among the lights, and the path of reflection (ṭarīq al-iʿtibār) by which one proceeds, is that to which the Qurʾān has guided. For after the explanation of God, glorified be He, there is no explanation. He, the Exalted, has said: {«أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا وَالْجِبَالَ أَوْتَادًا وَخَلَقْنَاكُمْ أَزْوَاجًا وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا وَجَعَلْنَا اللَّيْلَ لِبَاسًا وَجَعَلْنَا النَّهَارَ مَعَاشًا وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا وَجَعَلْنَا سِرَاجًا وَهَّاجًا وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا وَجَنَّاتٍ أَلْفَافًا»} — \"Have We not made the earth a resting place, and the mountains as pegs, and created you in pairs, and made your sleep a repose, and made the night a covering, and made the day for livelihood, and built above you seven strong heavens, and made a blazing lamp, and sent down from the rain-clouds pouring water, that We may bring forth thereby grain and vegetation, and gardens dense with foliage?\" (Q 78:6–16). And He, the Exalted, has said: {«إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ وَمَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ»} — \"Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the ships which sail through the sea with that which benefits people, and what God has sent down from the sky of water, thereby reviving the earth after its death, and dispersing therein every creature, and the directing of the winds, and the clouds subservient between the heaven and the earth — are signs for a people who reason\" (Q 2:164). And He, the Exalted, has said: {«أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا»} — \"Have you not seen how God created seven heavens in layers, and made the moon therein a light, and made the sun a lamp? And God caused you to grow from the earth a growth; then He returns you into it, and brings you forth a bringing forth\" (Q 71:15–18). And He, the Exalted, has said: {«أَفَرَأَيْتُم مَّا تُمْنُونَ أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ»} — \"Have you considered what you emit? Do you create it, or are We the Creator?\" — up to His saying: {«لِلْمُقْوِينَ»} — \"for the settlers\" (Q 56:58–73).", "book_title": "Foundations of Belief", "section_title_ar": "Section 87", "section_title_en": "The Pillars of Faith: Knowledge of God, His Attributes, His Acts, and the Audibles — Section 87", "section_index": 87, "anchors": "- Root: وجود (w-j-d)\n  * Lisan / Ayn: [Core linguistic root meaning: to find, to perceive, to be; existence as that which is found or discovered]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: al-wujūd as necessary existence (wujūb) versus contingent existence (imkān); the self-evident reality of the Creator's being]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: haqīqah — existence as affirmed reality; majāz — \"finding\" as in discovery, not applicable to God's necessary being]\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: [Core linguistic root meaning: measuring, proportioning, fashioning; origination of a thing upon a measure]\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination from nothing without prior model\n  * Al-Zamakhshari (Asas): [Literal: خلق الله الخلق: أوجده على تقدير أوجبته الحكمة — brought into existence upon a measure necessitated by wisdom; Majaz: not applicable to God's act as pure origination]\n- Root: فطر (f-t-r)\n  * Lisan / Ayn: [Core linguistic root meaning: to split, cleave, rend; to originate, to bring forth as a new creation]\n  * Al-Raghib (Mufradat): \"فطر الله الخلق\" — God's origination of creation as a primordial act; \"الفطرة\" as the innate disposition\n  * Al-Zamakhshari (Asas): [Literal: فطر الله الخلق، وهو فاطر السموات: مبتدعها — originator without precedent; Majaz: \"رأيه فطير\" — immature opinion, not applicable to divine]\n- Root: ارض (ar-d)\n  * Lisan / Ayn: [Core linguistic root meaning: the earth, the lower sphere; that which is beneath]\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء\" — the body opposite the heaven\n  * Al-Zamakhshari (Asas): [Literal: the earth as a resting place (مهادا); Majaz: not applicable in this context of divine creation]\n- Root: ركن (r-k-n)\n  * Lisan / Ayn: [Core linguistic root meaning: corner, pillar, support; that to which one leans for strength]\n  * Al-Raghib (Mufradat): \"ركن الشيء: جانبه الذي يسكن إليه\" — the side of a thing to which one repairs; used metaphorically for strength\n  * Al-Zamakhshari (Asas): [Literal: physical pillar/corner; Majaz: \"فلان يأوي من عز قومه إلى ركن شديد\" — one who repairs to a mighty support; here, the \"pillars\" (أركان) of faith as structural supports]\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure \"مداره على عشرة أصول\" (its circuit revolves upon ten principles) employs a prepositional phrase governing the verbal noun, establishing the necessary grammatical dependency that mirrors the ontological dependency of the created upon the Creator.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}, {"arabic": "ظاهرا من الحياة الدنيا وهم عن الآخرة هم غافلون الحمد لله بل أكثرهم لا يعلمون فالحب بهذا السبب أقوى من الحب بالإحسان لأن الإحسان يزيد وينقص ولذلك أوحى الله تعالى إلى داود عليه السلام إن أود الأوداء إلى من عبدني بغير نوال لكن ليعطي الربوبية حقها وفي الزبور من أظلم ممن عبدنى لجنة أونار لو لم أخلق جنة ولا نارا ألم أكن أهلا أن أطاع ومر عيسى عليه السلام على طائفة من العباد قد نحلوا فقالوا نخاف النار ونرجو الجنة فقال لهم مخلوقا خفتم ومخلوقا رجوتم ومر بقوم آخرين كذلك فقالوا نعبده حبا له وتعظيما لجلاله فقال أنتم أولياء الله حقا معكم أ", "english": "...power except through the enabling of his Master, just as He said concerning the greatest of the kings of the earth, Dhul-Qarnayn, when He said: {«إنا مكنا له في الأرض»} — \"Indeed, We established him firmly upon the earth\" (Q. 18:84). For all his kingship and sovereignty was nothing but the enabling of God Most High granted to him over a portion of the earth — and the entire earth is but a speck of dust in relation to the bodies of the world. And all the dominions that people attain from the earth are but a mote from that speck of dust. Then that mote, too, is from the bounty of God Most High and His enabling. It is therefore impossible that a servant should love one of God's servants for his power, his governance, his enablement, his dominion, and the completeness of his strength, yet not love God Most High for that very reason. And there is no might and no power except through God, the Exalted, the Magnificent. For He is the Compeller (al-Jabbār), the Subduer (al-Qāhir), the All-Knowing (al-'Alīm), the All-Powerful (al-Qādir). The heavens are folded in His right hand, and the earth with its kingdom and all that is upon it is in His grasp. The forelock of all creatures is in the grip of His power. If He destroyed them all, from the first to the last, not a single atom would diminish from His sovereignty and kingdom; and if He created their like a thousand times, He would not be wearied by their creation, nor would fatigue or languor touch Him in inventing them. So there is no power and no powerful one except that it is a trace of the traces of His power. To Him belongs beauty (al-jamāl), splendor (al-bahā'), majesty (al-'azamah), grandeur (al-kibriyā'), subjugation (al-qahr), and dominion (al-istīlā'). If, then, it is conceivable that a powerful one be loved for the completeness of his power, then none whatsoever deserves love for completeness of power save Him alone.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1156", "section_title_en": "The Fifth Cause of Love: Essential Beauty and Inner Affinity (Section 1156)", "section_index": 1156, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and enabling power; al-Farahidi notes its application to divine ordainment and human capacity.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is negation of incapacity ('ajz) in God; for humans, it is a contingent capacity granted by God's enabling (tamkīn), never absolute.\n  * Al-Zamakhshari (Asas): Literal: measured capacity and enablement; Metaphorical: \"far-reaching stride\" (ba'īd al-qadr) — here, all creaturely power is but a trace of divine power.\n- Root: قدس (q-d-s)\n  * Lisan / Ayn: Purity and sanctity; being set apart from defilement.\n  * Al-Raghib (Mufradat): Transcendence (taqdīs) as absolute purity from all deficiency — applicable in full only to God, the Holy (al-Quddūs).\n  * Al-Zamakhshari (Asas): Literal: physical cleansing; Metaphorical: moral and ontological transcendence from every imperfection.\n- Root: مثل (m-th-l)\n  * Lisan / Ayn: Likeness, similarity, and representation.\n  * Al-Raghib (Mufradat): Tamthīl (assimilation) and tashbīh (anthropomorphism) are impossible for God; munāsabah (affinity) is not likeness in form but in inner meaning.\n  * Al-Zamakhshari (Asas): Literal: visual resemblance; Metaphorical: spiritual congruence (munāsabah) between the servant and God through acquired divine attributes.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to confine absolute beauty, perfection, and lovability exclusively to God, e.g., \"the Beautiful absolutely is the One who has no equal.\"", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}], "26": [{"arabic": "وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدرك مدارك الملوك (4) وقد نبه بهذا على ثمراته في الدنيا ومعلوم أن الآخرة خير وأبقى وقال صلى الله عليه وسلم خصلتان لا يكونان في منافق حسن سمت وفقه في الدين (5) ولا تشكن في الحديث لنفاق بعض فقهاء الزمان فإنه ما أراد به الفقه الذي ظننته وسيأتي معنى الفقه وأدنى درجات الفقيه أن يعلم أن الآخرة خير من الدنيا", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Contemplation", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'", "badge": "Hadith"}], "28": [{"arabic": "الذي أنشأها أول مرة فاستدل بالابتداء على الإعادة وقال عز وجل ما خلقكم ولا بعثكم إلا كنفس واحدة والإعادة ابتداء ثان فهو ممكن كالابتداء الأول الأصل الثاني سؤال منكر ونكير (2) وقد وردت به الأخبار فيجب التصديق به لأنه ممكن إذ ليس يستدعي إلا إعادة الحياة إلى جزء من الأجزاء الذي به فهم الخطاب وذلك ممكن في نفسه ولا يدفع ذلك ما يشاهد من سكون أجزاء الميت وعدم سماعنا للسؤال له فإن النائم ساكن بظاهره ويدرك بباطنه من الآلام واللذات ما يحس بتأثيره عند التنبه وقد كان رسول الله صلى الله عليه وسلم يسمع كلام جبريل عليه السلام ويشاهده ومن حوله لا يسمعون", "english": "For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].", "book_title": "Foundations of Belief", "section_title_ar": "Section 96", "section_title_en": "The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles", "section_index": 96, "anchors": "- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Foundations of Belief'", "badge": "Dhikr"}], "33": [{"arabic": "القيامة وأنه يوم لا ينفع فيه مال ولا بنون ولا يجزي والد عن ولده ويشتغل الصديقون بأنفسهم فيقول كل واحد نفسي نفسي فضلا عن غيرهم فكانوا كزوار بيت الله إذا توجهوا إلى مكة فإنهم يستصحبون مع أنفسهم الذهب المغربي الخالص لعلمهم أن أرباب البوادي لا يروج عندهم الزائف والبهرج والحاجة تشتد في البادية ولا وطن يفزع إليه ولا حميم يتمسك به فلا ينجي إلى الخالص من النقد فكذا يشاهد أرباب القلوب يوم القيامة والزاد الذي يتزودونه له من التقوى فإذن شوائب الرياء الخفي كثيرة لا تنحصر ومهما أدرك من نفسه تفرقة بين أن يطلع على عبادته", "english": "And that they should be energetic in fulfilling his needs, and that they should be lenient with him in buying and selling, and that they should make room for him in the gathering place. For if anyone falls short in this, that weighs heavily upon his heart, and he finds in himself a sense of astonishment at it—as though he were demanding respect in return for the obedience which he had kept hidden, even though no one had been made aware of it. And had that act of obedience not preceded from him, he would not have deemed people's falling short in his regard to be something astonishing. And whenever the existence of his worship is not equivalent to its non-existence in all that pertains to creatures, then he has not been content with God's knowledge [alone], nor has he been free of a hidden taint of ostentation more concealed than the creeping of ants. {Hadith on ostentation: traces more concealed than the creeping of ants, narrated by Ahmad and al-Ṭabarānī from Abū Mūsā al-Ashʿarī: \"Beware of this shirk, for it is more concealed than the creeping of ants.\" Also narrated by Ibn Ḥibbān in al-Ḍuʿafāʾ from Abū Bakr al-Ṣiddīq, and he and al-Dāraquṭnī declared it weak.}", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 822", "section_title_en": "On the Hidden Traces of Ostentation (Riyāʾ) and the Striving of the Sincere (Mukhliṣūn) to Conceal Their Deeds", "section_index": 822, "anchors": "- Root: خلص (khalasa)\n  * Lisan / Ayn: Core meaning of purity after admixture—that which is sifted, refined, and cleared of alloy.\n  * Al-Raghib (Mufradat): \"الخالص كالصافي إلا أن الخالص هو ما زال عنه شوبه بعد أن كان فيه\" — the sincere (mukhliṣ) is one from whom the taint has been removed after it existed; pure gold (al-dhahab al-khāliṣ) as metaphor for accepted deeds.\n  * Al-Zamakhshari (Asas): Haqiqah: \"خلص الشيء خلوصا فهو خالص، وخلصته: صفيته.\" Majaz: \"أخلص لله دينه\" — sincerity as metaphorical purification of religion from all foreign admixture.\n- Root: راءى (rāʾā) / ريا (riyāʾ)\n  * Lisan / Ayn: Derived from رؤية (seeing); ostentation is performing acts to be seen by creatures rather than the Creator.\n  * Al-Raghib (Mufradat): Riyāʾ is the seeking of station (manzilah) in the hearts of men through displaying acts of obedience—a hidden shirk (associationism).\n  * Al-Zamakhshari (Asas): Majaz: \"راءى فلان الناس\" — to show off; the root implies visual perception transferred to the seeking of social regard.\n- Root: نفس (nafs)\n  * Lisan / Ayn: The self, the soul; here denoting the inner seat of intention and hidden motives.\n  * Al-Raghib (Mufradat): \"نفسه: ذاته\" — the self as the locus of divine knowledge; the sincere one is content with God's knowledge alone, not human witness.\n  * Al-Zamakhshari (Asas): Majaz: \"دفق نفسه أي دمه\" — the self as the whole person; here, the inner state of the heart that must be purified.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional structures (fa-in qaṣṣara... wa-law lam... wa-mahmā lam...) establish logical entailment: the absence of equanimity between public and private worship entails the persistence of hidden ostentation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "اعلم أن قوله تعالى {فلا تغرنكم الحياة الدنيا ولا يغرنكم بالله الغرور} وقوله تعالى {ولكنكم فتنتم أنفسكم وتربصتم وارتبتم وغرتكم الأماني} الآية كاف في ذم الغرور وقد قال رسول الله صلى الله عليه وسلم حبذا نوم الأكياس وفطرهم كيف يغبنون سهر الحمقى واجتهادهم ولمثقال ذرة من صاحب تقوى ويقين أفضل من ملء الأرض من المغترين (1) حديث الكيس من دان نفسه وعمل لما بعد الموت الحديث أخرجه الترمذي وابن ماجه من حديث شداد بن أوس وكل ما ورد في فضل العلم وذم الجهل فهو دليل على ذم الغرور لأن الغرور عبارة عن بعض أنواع الجهل إذ الجهل", "english": "Know that the saying of God Most High — {«fa-lā taghurrannakum al-ḥayātu al-dunyā wa-lā yaghurrannakum billāhi al-gharūr»} (So let not the life of this world deceive you, nor let the Deceiver deceive you concerning God) — and His saying — {«wa-lākinnakum fatantum anfusakum wa-tarabbastum wa-irtabtum wa-gharratkum al-amānī»} (But ye tempted your own souls, and ye waited, and ye doubted, and vain desires deceived you) — is sufficient for the blameworthiness of self-deception (al-ghurūr). And the Messenger of God, may God's peace and blessing be upon him, has said: \"How excellent is the sleep of the intelligent and their breaking of the fast! How they outwit the wakefulness of the foolish and their striving! And verily a mustard-seed's weight [of faith] from a possessor of piety and certainty is better than the earth filled with the self-deceived.\" And the ḥadīth: \"The intelligent man (al-kayyis) is he who takes account of his own soul and works for what is after death\" — this ḥadīth was transmitted by al-Tirmidhī and Ibn Mājah from the ḥadīth of Shaddād ibn Aws.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 884", "section_title_en": "Exposition of the Blameworthiness of Self-Deception (Al-Ghurūr), Its Reality, and Its Examples", "section_index": 884, "anchors": "- Root: غرر (Gh-R-R)\n  * Lisan / Ayn: The core meaning is \"an apparent trace or mark of a thing\" (al-athar al-ẓāhir), from which derives \"the blaze of a horse\" (ghurrat al-faras). To deceive (gharra) is to strike one's heedlessness (ghirrah) and attain one's sought desire from him, as if folding a garment upon its original crease (ṭawāhu ʿalā gharrihi).\n  * Al-Raghib (Mufradat): \"Ghurrah is heedlessness in wakefulness, and ghirār is heedlessness with drowsiness.\" Theologically, it is the soul's repose upon a false semblance (shubhah) that pleases the caprice (hawā), rendering one oblivious to the true state of affairs—as in {«mā gharraka bi-rabbika al-karīm»} (What deceived thee concerning thy Generous Lord?).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"A gazelle in a moonlit night is called agharr\" because it ventures out thinking it is day and is devoured by beasts—heedlessness in perception. Metaphorical (majāz): \"A day agharr muḥajjal\" (a white-browed, white-legged day) for intense heat, transferring the blaze of a horse to the day's visible intensity.\n- Root: جهل (J-H-L)\n  * Lisan / Ayn: \"Jahila bihi\" — to be ignorant of it; \"jāhala ʿalā qawmihi\" — to act foolishly/insolently against one's people. The pre-Islamic era is \"al-jāhiliyyah al-jahlā'\" (the utterly ignorant age).\n  * Al-Raghib (Mufradat): Ignorance (jahl) is of three kinds: (1) the soul's emptiness of knowledge (this is the root); (2) believing a thing contrary to what it is; (3) doing a thing contrary to what it ought to be, whether one's belief is sound or corrupt. Ghurūr is a species of the second kind—a false belief arising from a corrupt semblance.\n  * Al-Zamakhshari (Asas): Literal: \"Kafā bil-shakki jahlā\" (Sufficient is doubt as ignorance). Metaphorical: \"Istajhalat al-rīḥ al-ghuṣn\" (The wind made the branch sway violently) — transferred from mental foolishness to physical agitation.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not.\" \"Al-ḥadath: the novel event.\" \"Ḥaddatha: to speak/communicate.\"\n  * Al-Raghib (Mufradat): \"Ḥudūth is the existence of a thing after non-existence, whether accident or substance. Iḥdāth is bringing it into existence. The iḥdāth of substances belongs to God alone.\" The \"ḥadīth\" (report/speech) is so-called for its temporal novelty.\n  * Al-Zamakhshari (Asas): Literal: \"Nazalat bihi ḥawādith al-dahr\" (The vicissitudes of time befell him). Metaphorical: \"Kāna ʿUmar muḥaddathan\" (Umar was one inspired with true discernment) — as if he were spoken to (ḥudditha) by what he conjectured.\n- Root: دنا (D-N-W)\n  * Lisan / Ayn: \"Danā fa-huwa dānin\" — he drew near. \"Al-dunyā\" (the lower world) is so named because it is nearer (danat) and precedes the Hereafter.\n  * Al-Raghib (Mufradat): \"Al-dunūw: proximity by essence or by judgment, used of place, time, and station.\" The \"adnā\" (lower/nearer) is contrasted with the greater and with the better: {«a-tastabdilūna alladhī huwa adnā billadhī huwa khayr»} (Will ye take the lower in exchange for what is better?).\n  * Al-Zamakhshari (Asas): Literal: \"Huwa danī' min al-adniyā'\" (He is base, of the base ones) — but this is the homonym danu'a (baseness), distinct from danā (nearness). The dunyā's \"nearness\" is its temporal immediacy versus the Hereafter's deferral.\n- Sibawayh Rule: Bab al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The particle \"bi\" in {«wa-lā yaghurrannakum billāhi al-gharūr»} governs the deceiver (al-gharūr) as the agent of deception, while \"billāh\" (concerning God) is the object of the deception. The syntactic structure permits the deceiver to be named after the prepositional phrase, indicating that the deception is *about* God's attributes (His forbearance, His respite) — a grammatical subtlety showing the ghurūr deceives *by means of* false notions of God, not that God Himself deceives.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}, {"arabic": "في الدنيا فكيف في يوم لا يجزي والد عن ولده ولا مولود هو جاز عن والده شيئا بل تقول الأنبياء فيه نفسي نفسي فكيف يستبدل الجاهل عن ثواب الآخرة ونيل القرب عند الله ما يرتقبه بطمعه الكاذب في الدنيا من الناس فلا ينبغي أن نشك في أن المرائي بطاعة الله في سخط الله من حيث النقل والقياس جميعا هذا إذا لم يقصد الأجر فأما إذا قصد الأجر والحمد جميعا في صدقته أو صلاته فهو الشرك الذي يناقض الإخلاص وقد ذكرنا حكمه في كتاب الإخلاص ويدل على ما نقلناه من الآثار قول سعيد بن المسيب وعبادة بن الصامت إنه لا أجر له فيه أصلا بيان درجات الريا", "english": "The Messenger of God, may God's peace and blessings be upon him, named it the lesser shirk (al-shirk al-aṣghar). The hadith naming riya' as the lesser shirk was transmitted by Ahmad from the hadith of Mahmud ibn Labid, and it has already preceded. Al-Tabarani also narrated it from the transmission of Mahmud ibn Labid from Rafi' ibn Khadij, making it part of Rafi's musnad, and it has also preceded recently. Al-Hakim recorded it and authenticated its chain from the hadith of Shaddad ibn Aws: \"We used to count riya' on the day of the Messenger of God, may God's peace and blessings be upon him, as the lesser shirk.\"", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 817", "section_title_en": "The Degrees of Riya' (Show) — Section 817", "section_index": 817, "anchors": "- Root: راءى (rā'ā)\n  * Lisan / Ayn: Core meaning of visual display, showing oneself; from الرؤية (seeing), implying making oneself seen.\n  * Al-Raghib (Mufradat): Riya' is the seeking of station (manzilah) in hearts through acts of obedience — a subtle shirk because the actor's qasd (intention) is diverted from the Creator to creatures.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) = mutual seeing; metaphorical (majaz) = displaying deeds for the gaze of others, transferring the object of worship from God to His servants.\n- Root: قصد (qaṣada)\n  * Lisan / Ayn: To aim, intend, direct one's course toward a target; the straight path of intention.\n  * Al-Raghib (Mufradat): Qasd is the straightness of a road; iqtisad (moderation) is praiseworthy between two extremes — here, the qasd of the actor is the very substance of the act's moral weight.\n  * Al-Zamakhshari (Asas): Literal = aiming at a physical target; metaphorical = the soul's inclination toward a goal, whether divine reward or human praise.\n- Root: عظم (ʿaẓuma)\n  * Lisan / Ayn: To be great, to magnify; ʿazamah = grandeur, majesty.\n  * Al-Raghib (Mufradat): ʿIẓam (magnification) is the heart's ascription of greatness to an object; when transferred from God to creatures, it constitutes the hidden kernel of shirk.\n  * Al-Zamakhshari (Asas): Literal = physical largeness; metaphorical = the heart's veneration (taʿẓīm) of a being, which is the true object of worship.\n- Root: درج (daraja)\n  * Lisan / Ayn: To ascend step by step; degrees of a ladder.\n  * Al-Raghib (Mufradat): Darajah is a station considered by ascent; used for ranks of honor or degradation.\n  * Al-Zamakhshari (Asas): Literal = physical steps; metaphorical = graded levels of moral severity, as here: \"degrees of riya'.\"\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between subject and predicate) — The periodic structure \"اعلم أن بعض أبواب الرياء أشد وأغلظ من بعض\" employs an embedded clause (أنّ + nominal sentence) requiring careful tracking of the governed accusative and its predicate to preserve the logical hierarchy of the author's taxonomy.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "ويحك يا نفس لا ينبغى أن تغرك الحياة الدنيا ولا يغرنك بالله الغرور فانظرى لنفسك فما أمرك بمهم لغيرك ولا تضيعى أوقاتك فالأنفاس معدودة فإذا مضى منك نفس فقد ذهب بعضك فاغتنمى الصحة قبل السقم والفراغ قبل الشغل والغنى قبل الفقر والشباب قبل الهرم والحياة قبل الموت واستعدي للآخرة على قدر بقائك فيها يا نفس أما تستعدين للشتاء بقدر طول مدته فتجمعين له القوت والكسوة والحطب وجميع الأسباب ولا تتكلين في ذلك على فضل الله وكرمه حتى يدفع عنك البرد من غير جبة ولبد وحطب وغير ذلك فإنه قادر على ذلك أفتظنين أيتها النفس أن زمهرير جهنم", "english": "...from creation, but rather you attain your goal through every stratagem. And by this ignorance you deserve the title of foolishness from the Messenger of God, may God bless him and grant him peace, where he said: \"The shrewd one is he who holds his soul to account and works for what comes after death, and the foolish one is he who follows his soul's whims and harbors vain hopes upon God.\" {«الكيس من دان نفسه وعمل لما بعد الموت والأحمق من أتبع نفسه هواها وتمنى على الله الأماني»}", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1253", "section_title_en": "Section 1253 — The Soul's Self-Reproach and the Awakening from Negligence", "section_index": 1253, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates and is addressed as an independent moral agent.\n  * Al-Raghib (Mufradat): The soul as the locus of divine address and self-knowledge; its essence (dhāt) is the referent of God's \"self\" in revelation, yet here it is the reproaching subject.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) usage as the speaking, desiring self; metaphorical (majāz) extension to blame and counsel, as in \"self-accusation\" (lawwāmah).\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of life; the inevitable terminus of every soul.\n  * Al-Raghib (Mufradat): Death as separation (furqah) from worldly attachments and the transition to reckoning; linked to the soul's journey.\n  * Al-Zamakhshari (Asas): Literal death of the body; metaphorical \"death\" of the heart through heedlessness, contrasted here with physical death as the ultimate wake-up call.\n- Root: جهل (j-h-l)\n  * Lisan / Ayn: Ignorance as the absence of knowledge; folly and rashness.\n  * Al-Raghib (Mufradat): Ignorance as the soul's failure to perceive true realities, leading to misplaced desires and false hopes.\n  * Al-Zamakhshari (Asas): Literal ignorance of facts; metaphorical ignorance as moral stupidity, as when the soul follows whims despite clear signs.\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): Drawing near (dunūw) to God through obedience, contrasted with the soul's clinging to the near (dunyā) world.\n  * Al-Zamakhshari (Asas): Literal proximity; metaphorical use for the \"lower\" world (dunyā) as that which is nearer and inferior.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize exclusive causation, e.g., \"God's generosity is only in guiding you to the path,\" restricting divine favor to guidance, not exemption from effort.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'", "badge": "Afterlife"}, {"arabic": "وقال الحسن بعد أن تلا قوله تعالى {فلا تغرنكم الحياة الدنيا} من قال ذا قاله من خلقها ومن هو أعلم بها إياكم وما شغل من الدنيا فإن الدنيا كثيرة الأشغال لا يفتح رجل على نفسه باب شغل إلا أوشك ذلك الباب أن يفتح عليه عشرة أبواب وقال أيضا مسكين ابن أدم رضي بدار حلالها حساب وحرامها عذاب إن أخذه من حله حوسب به وإن أخذه من حرام عذب به ابن آدم يستقل ماله ولا يستقل عمله يفرح بمصيبته في دينه ويجزع من مصيبته في دنياه وكتب الحسن إلى عمر بن عبد العزيز سلام عليك أما بعد فكأنك بآخر من كتب عليه الموت قد مات فأجابه عمر سلا", "english": "Al-Hasan said: \"By Allah, I have known people for whom the world was more insignificant than the dust upon which you walk. They cared not whether the world rose or set, whether it went to this one or to that one.\"", "book_title": "Condemnation of the World", "section_title_ar": "Section 735", "section_title_en": "Section 735", "section_index": 735, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of the World'", "badge": "Afterlife"}]}, "wordTiming": {"minshawi": {"1": [[1, 470, 7450]], "