َتِّعُهُمْ قَلِيلاࣰ ثُمَّ نَضْطَرُّهُمُۥٓ إِلَيٰ عَذَابٍ غَلِيظࣲۖ", "words": [{"id": 1, "arabic": "نُمَتِّعُهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَلِيلاࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَضْطَرُّهُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَذَابٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "غَلِيظࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 31, "ayah": 25, "text": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ لَيَقُولُنَّ اَ۬للَّهُۖ قُلِ اِ۬لْحَمْدُ لِلهِۖ بَلَ اَكْثَرُهُمْ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "", "root": ""}, {"id": 2, "arabic": "سَأَلْتَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَيَقُولُنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْحَمْدُ", "translit": "", "root": ""}, {"id": 11, "arabic": "لِلهِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَكْثَرُهُمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "لَا", "translit": "", "root": ""}, {"id": 15, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 31, "ayah": 26, "text": "لِلهِ مَا فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِۖ إِنَّ اَ۬للَّهَ هُوَ اَ۬لْغَنِيُّ اُ۬لْحَمِيدُۖ", "words": [{"id": 1, "arabic": "لِلهِ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4