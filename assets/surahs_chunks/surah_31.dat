{"surah": 31, "verses": [{"ayah": 1, "text": "الٓمٓ ", "translation": "Alif, Lām, Meem.[1]", "words": [{"id": 1, "arabic": "الٓمٓ", "translit": "ٓmٓlā", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْحَكِيمِ ", "translation": "These are verses of the wise[1] Book,", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "ٱلْحَكِيمِ", "translit": "ِmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 3, "text": "هُدًى وَرَحْمَةً لِّلْمُحْسِنِينَ ", "translation": "As guidance and mercy for the doers of good", "words": [{"id": 1, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 2, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 3, "arabic": "لِّلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlِّl", "root": "حسن"}], "hasIhya": false}, {"ayah": 4, "text": "ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلْءَاخِرَةِ هُمْ يُوقِنُونَ ", "translation": "Who establish prayer and give zakāh, and they, of the Hereafter, are certain [in faith].", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُقِيمُونَ", "translit": "َnwُmyِqُy", "root": "قوم"}, {"id": 3, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 4, "arabic": "وَيُؤْتُونَ", "translit": "َnwُtْwʾُyَw", "root": "اتي"}, {"id": 5, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 6, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 7, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 8, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 9, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 5, "text": "أُو۟لَٰٓئِكَ عَلَىٰ هُدًى مِّن رَّبِّهِمْۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ", "translation": "Those are on [right] guidance from their Lord, and it is those who are the successful.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 7, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 8, "arabic": "ٱلْمُفْلِحُونَ", "translit": "َnwُḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": false}, {"ayah": 6, "text": "وَمِنَ ٱلنَّاسِ مَن يَشْتَرِى لَهْوَ ٱلْحَدِيثِ لِيُضِلَّ عَن سَبِيلِ ٱللَّهِ بِغَيْرِ عِلْمٍ وَيَتَّخِذَهَا هُزُوًاۚ أُو۟لَٰٓئِكَ لَهُمْ عَذَابٌ مُّهِينٌ ", "translation": "And of the people is he who buys the amusement of speech[1] to mislead [others] from the way of Allāh without knowledge and who takes it [i.e., His way] in ridicule. Those will have a humiliating punishment.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَشْتَرِى", "translit": "àِrَtْhsَy", "root": "شري"}, {"id": 5, "arabic": "لَهْوَ", "translit": "َwْhَl", "root": "لهو"}, {"id": 6, "arabic": "ٱلْحَدِيثِ", "translit": "ِhtyِdَḥْlٱ", "root": "حدث"}, {"id": 7, "arabic": "لِيُضِلَّ", "translit": "َّlِḍُyِl", "root": "ضلل"}, {"id": 8, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 9, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 12, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 13, "arabic": "وَيَتَّخِذَهَا", "translit": "āَhَhdِhkَّtَyَw", "root": "اخذ"}, {"id": 14, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 15, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 16, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 17, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 18, "arabic": "مُّهِينٌ", "translit": "ٌnyِhُّm", "root": "هون"}], "hasIhya": true}, {"ayah": 7, "text": "وَإِذَا تُتْلَىٰ عَلَيْهِ ءَايَٰتُنَا وَلَّىٰ مُسْتَكْبِرًا كَأَن لَّمْ يَسْمَعْهَا كَأَنَّ فِىٓ أُذُنَيْهِ وَقْرًاۖ فَبَشِّرْهُ بِعَذَابٍ أَلِيمٍ ", "translation": "And when Our verses are recited to him, he turns away arrogantly as if he had not heard them, as if there was in his ears deafness. So give him tidings of a painful punishment.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ءَايَٰتُنَا", "translit": "āَnُtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "وَلَّىٰ", "translit": "ٰàَّlَw", "root": "ولي"}, {"id": 6, "arabic": "مُسْتَكْبِرًا", "translit": "āًrِbْkَtْsُm", "root": "كبر"}, {"id": 7, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 8, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 9, "arabic": "يَسْمَعْهَا", "translit": "āَhْʿعَmْsَy", "root": "سمع"}, {"id": 10, "arabic": "كَأَنَّ", "translit": "َّnَaʾَk", "root": ""}, {"id": 11, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 12, "arabic": "أُذُنَيْهِ", "translit": "ِhْyَnُhdُaʾ", "root": "اذن"}, {"id": 13, "arabic": "وَقْرًا", "translit": "āًrْqَw", "root": "وقر"}, {"id": 14, "arabic": "فَبَشِّرْهُ", "translit": "ُhْrِّhsَbَf", "root": "بشر"}, {"id": 15, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 16, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 8, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ جَنَّٰتُ ٱلنَّعِيمِ ", "translation": "Indeed, those who believe and do righteous deeds - for them are the Gardens of Pleasure,", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "جَنَّٰتُ", "translit": "ُtَّٰnَjg", "root": "جنن"}, {"id": 8, "arabic": "ٱلنَّعِيمِ", "translit": "ِmyِʿعَّnlٱ", "root": "نعم"}], "hasIhya": false}, {"ayah": 9, "text": "خَٰلِدِينَ فِيهَاۖ وَعْدَ ٱللَّهِ حَقًّاۚ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "Wherein they abide eternally; [it is] the promise of Allāh [which is] truth. And He is the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 8, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 10, "text": "خَلَقَ ٱلسَّمَٰوَٰتِ بِغَيْرِ عَمَدٍ تَرَوْنَهَاۖ وَأَلْقَىٰ فِى ٱلْأَرْضِ رَوَٰسِىَ أَن تَمِيدَ بِكُمْ وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٍۚ وَأَنزَلْنَا مِنَ ٱلسَّمَآءِ مَآءً فَأَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ ", "translation": "He created the heavens without pillars that you see and has cast into the earth firmly set mountains, lest it should shift with you, and dispersed therein from every creature. And We sent down rain from the sky and made grow therein [plants] of every noble kind.", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 2, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 4, "arabic": "عَمَدٍ", "translit": "ٍdَmَʿع", "root": "عمد"}, {"id": 5, "arabic": "تَرَوْنَهَا", "translit": "āَhَnْwَrَt", "root": "راي"}, {"id": 6, "arabic": "وَأَلْقَىٰ", "translit": "ٰàَqْlَaʾَw", "root": "لقي"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "رَوَٰسِىَ", "translit": "َàِsَٰwَr", "root": "رسو"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "تَمِيدَ", "translit": "َdyِmَt", "root": "ميد"}, {"id": 12, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 13, "arabic": "وَبَثَّ", "translit": "َّhtَbَw", "root": "بثث"}, {"id": 14, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 15, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 16, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 17, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 18, "arabic": "وَأَنزَلْنَا", "translit": "āَnْlَznَaʾَw", "root": "نزل"}, {"id": 19, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 20, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 21, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 22, "arabic": "فَأَنۢبَتْنَا", "translit": "āَnْtَbۢnَaʾَf", "root": "نبت"}, {"id": 23, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 24, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 25, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 26, "arabic": "زَوْجٍ", "translit": "ٍjgْwَz", "root": "زوج"}, {"id": 27, "arabic": "كَرِيمٍ", "translit": "ٍmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 11, "text": "هَٰذَا خَلْقُ ٱللَّهِ فَأَرُونِى مَاذَا خَلَقَ ٱلَّذِينَ مِن دُونِهِۦۚ بَلِ ٱلظَّٰلِمُونَ فِى ضَلَٰلٍ مُّبِينٍ ", "translation": "This is the creation of Allāh. So show Me what those other than Him have created. Rather, the wrongdoers are in clear error.", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "خَلْقُ", "translit": "ُqْlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "فَأَرُونِى", "translit": "àِnwُrَaʾَf", "root": "راي"}, {"id": 5, "arabic": "مَاذَا", "translit": "āَhdāَm", "root": ""}, {"id": 6, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 10, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 11, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 14, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 12, "text": "وَلَقَدْ ءَاتَيْنَا لُقْمَٰنَ ٱلْحِكْمَةَ أَنِ ٱشْكُرْ لِلَّهِۚ وَمَن يَشْكُرْ فَإِنَّمَا يَشْكُرُ لِنَفْسِهِۦۖ وَمَن كَفَرَ فَإِنَّ ٱللَّهَ غَنِىٌّ حَمِيدٌ ", "translation": "And We had certainly given Luqmān wisdom [and said], \"Be grateful to Allāh.\" And whoever is grateful is grateful for [the benefit of] himself. And whoever denies [His favor] - then indeed, Allāh is Free of need and Praiseworthy.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "لُقْمَٰنَ", "translit": "َnَٰmْqُl", "root": ""}, {"id": 4, "arabic": "ٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱ", "root": "حكم"}, {"id": 5, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 6, "arabic": "ٱشْكُرْ", "translit": "ْrُkْhsٱ", "root": "شكر"}, {"id": 7, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 8, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 9, "arabic": "يَشْكُرْ", "translit": "ْrُkْhsَy", "root": "شكر"}, {"id": 10, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 11, "arabic": "يَشْكُرُ", "translit": "ُrُkْhsَy", "root": "شكر"}, {"id": 12, "arabic": "لِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِl", "root": "نفس"}, {"id": 13, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 14, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 15, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "غَنِىٌّ", "translit": "ٌّàِnَغ", "root": "غني"}, {"id": 18, "arabic": "حَمِيدٌ", "translit": "ٌdyِmَḥ", "root": "حمد"}], "hasIhya": false}, {"ayah": 13, "text": "وَإِذْ قَالَ لُقْمَٰنُ لِٱبْنِهِۦ وَهُوَ يَعِظُهُۥ يَٰبُنَىَّ لَا تُشْرِكْ بِٱللَّهِۖ إِنَّ ٱلشِّرْكَ لَظُلْمٌ عَظِيمٌ ", "translation": "And [mention, O Muḥammad], when Luqmān said to his son while he was instructing him, \"O my son, do not associate [anything] with Allāh. Indeed, association [with Him] is great injustice.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "لُقْمَٰنُ", "translit": "ُnَٰmْqُl", "root": ""}, {"id": 4, "arabic": "لِٱبْنِهِۦ", "translit": "ۦِhِnْbٱِl", "root": "بني"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "يَعِظُهُۥ", "translit": "ۥُhُẓِʿعَy", "root": "وعظ"}, {"id": 7, "arabic": "يَٰبُنَىَّ", "translit": "َّàَnُbَٰy", "root": "بني"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "تُشْرِكْ", "translit": "ْkِrْhsُt", "root": "شرك"}, {"id": 10, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلشِّرْكَ", "translit": "َkْrِّhslٱ", "root": "شرك"}, {"id": 13, "arabic": "لَظُلْمٌ", "translit": "ٌmْlُẓَl", "root": "ظلم"}, {"id": 14, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 14, "text": "وَوَصَّيْنَا ٱلْإِنسَٰنَ بِوَٰلِدَيْهِ حَمَلَتْهُ أُمُّهُۥ وَهْنًا عَلَىٰ وَهْنٍ وَفِصَٰلُهُۥ فِى عَامَيْنِ أَنِ ٱشْكُرْ لِى وَلِوَٰلِدَيْكَ إِلَىَّ ٱلْمَصِيرُ ", "translation": "And We have enjoined upon man [care] for his parents. His mother carried him, [increasing her] in weakness upon weakness, and his weaning is in two years. Be grateful to Me and to your parents; to Me is the [final] destination.", "words": [{"id": 1, "arabic": "وَوَصَّيْنَا", "translit": "āَnْyَّṣَwَw", "root": "وصي"}, {"id": 2, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "بِوَٰلِدَيْهِ", "translit": "ِhْyَdِlَٰwِb", "root": "ولد"}, {"id": 4, "arabic": "حَمَلَتْهُ", "translit": "ُhْtَlَmَḥ", "root": "حمل"}, {"id": 5, "arabic": "أُمُّهُۥ", "translit": "ۥُhُّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "وَهْنًا", "translit": "āًnْhَw", "root": "وهن"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "وَهْنٍ", "translit": "ٍnْhَw", "root": "وهن"}, {"id": 9, "arabic": "وَفِصَٰلُهُۥ", "translit": "ۥُhُlَٰṣِfَw", "root": "فصل"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "عَامَيْنِ", "translit": "ِnْyَmāَʿع", "root": "عوم"}, {"id": 12, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 13, "arabic": "ٱشْكُرْ", "translit": "ْrُkْhsٱ", "root": "شكر"}, {"id": 14, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 15, "arabic": "وَلِوَٰلِدَيْكَ", "translit": "َkْyَdِlَٰwِlَw", "root": "ولد"}, {"id": 16, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": false}, {"ayah": 15, "text": "وَإِن جَٰهَدَاكَ عَلَىٰٓ أَن تُشْرِكَ بِى مَا لَيْسَ لَكَ بِهِۦ عِلْمٌ فَلَا تُطِعْهُمَاۖ وَصَاحِبْهُمَا فِى ٱلدُّنْيَا مَعْرُوفًاۖ وَٱتَّبِعْ سَبِيلَ مَنْ أَنَابَ إِلَىَّۚ ثُمَّ إِلَىَّ مَرْجِعُكُمْ فَأُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "But if they endeavor to make you associate with Me that of which you have no knowledge,[1] do not obey them but accompany them in [this] world with appropriate kindness and follow the way of those who turn back to Me [in repentance]. Then to Me will be your return, and I will inform you about what you used to do.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "جَٰهَدَاكَ", "translit": "َkāَdَhَٰjg", "root": "جهد"}, {"id": 3, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تُشْرِكَ", "translit": "َkِrْhsُt", "root": "شرك"}, {"id": 6, "arabic": "بِى", "translit": "àِb", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 9, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "عِلْمٌ", "translit": "ٌmْlِʿع", "root": "علم"}, {"id": 12, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 13, "arabic": "تُطِعْهُمَا", "translit": "āَmُhْʿعِṭُt", "root": "طوع"}, {"id": 14, "arabic": "وَصَاحِبْهُمَا", "translit": "āَmُhْbِḥāَṣَw", "root": "صحب"}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 17, "arabic": "مَعْرُوفًا", "translit": "āًfwُrْʿعَm", "root": "عرف"}, {"id": 18, "arabic": "وَٱتَّبِعْ", "translit": "ْʿعِbَّtٱَw", "root": "تبع"}, {"id": 19, "arabic": "سَبِيلَ", "translit": "َlyِbَs", "root": "سبل"}, {"id": 20, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 21, "arabic": "أَنَابَ", "translit": "َbāَnَaʾ", "root": "نوب"}, {"id": 22, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 23, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 24, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 25, "arabic": "مَرْجِعُكُمْ", "translit": "ْmُkُʿعِjgْrَm", "root": "رجع"}, {"id": 26, "arabic": "فَأُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُaʾَf", "root": "نبا"}, {"id": 27, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 28, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 29, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 16, "text": "يَٰبُنَىَّ إِنَّهَآ إِن تَكُ مِثْقَالَ حَبَّةٍ مِّنْ خَرْدَلٍ فَتَكُن فِى صَخْرَةٍ أَوْ فِى ٱلسَّمَٰوَٰتِ أَوْ فِى ٱلْأَرْضِ يَأْتِ بِهَا ٱللَّهُۚ إِنَّ ٱللَّهَ لَطِيفٌ خَبِيرٌ ", "translation": "[And Luqmān said], \"O my son, indeed if it [i.e., a wrong] should be the weight of a mustard seed and should be within a rock or [anywhere] in the heavens or in the earth, Allāh will bring it forth. Indeed, Allāh is Subtle[1] and Aware.", "words": [{"id": 1, "arabic": "يَٰبُنَىَّ", "translit": "َّàَnُbَٰy", "root": "بني"}, {"id": 2, "arabic": "إِنَّهَآ", "translit": "ٓāَhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "تَكُ", "translit": "ُkَt", "root": "كون"}, {"id": 5, "arabic": "مِثْقَالَ", "translit": "َlāَqْhtِm", "root": "ثقل"}, {"id": 6, "arabic": "حَبَّةٍ", "translit": "ٍẗَّbَḥ", "root": "حبب"}, {"id": 7, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 8, "arabic": "خَرْدَلٍ", "translit": "ٍlَdْrَhk", "root": "خردل"}, {"id": 9, "arabic": "فَتَكُن", "translit": "nُkَtَf", "root": "كون"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "صَخْرَةٍ", "translit": "ٍẗَrْhkَṣ", "root": "صخر"}, {"id": 12, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 15, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 18, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 19, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "لَطِيفٌ", "translit": "ٌfyِṭَl", "root": "لطف"}, {"id": 24, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 17, "text": "يَٰبُنَىَّ أَقِمِ ٱلصَّلَوٰةَ وَأْمُرْ بِٱلْمَعْرُوفِ وَٱنْهَ عَنِ ٱلْمُنكَرِ وَٱصْبِرْ عَلَىٰ مَآ أَصَابَكَۖ إِنَّ ذَٰلِكَ مِنْ عَزْمِ ٱلْأُمُورِ ", "translation": "O my son, establish prayer, enjoin what is right, forbid what is wrong, and be patient over what befalls you. Indeed, [all] that is of the matters [requiring] resolve.[1]", "words": [{"id": 1, "arabic": "يَٰبُنَىَّ", "translit": "َّàَnُbَٰy", "root": "بني"}, {"id": 2, "arabic": "أَقِمِ", "translit": "ِmِqَaʾ", "root": "قوم"}, {"id": 3, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 4, "arabic": "وَأْمُرْ", "translit": "ْrُmْaʾَw", "root": "امر"}, {"id": 5, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 6, "arabic": "وَٱنْهَ", "translit": "َhْnٱَw", "root": "نهي"}, {"id": 7, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 8, "arabic": "ٱلْمُنكَرِ", "translit": "ِrَknُmْlٱ", "root": "نكر"}, {"id": 9, "arabic": "وَٱصْبِرْ", "translit": "ْrِbْṣٱَw", "root": "صبر"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 12, "arabic": "أَصَابَكَ", "translit": "َkَbāَṣَaʾ", "root": "صوب"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "عَزْمِ", "translit": "ِmْzَʿع", "root": "عزم"}, {"id": 17, "arabic": "ٱلْأُمُورِ", "translit": "ِrwُmُaʾْlٱ", "root": "امر"}], "hasIhya": true}, {"ayah": 18, "text": "وَلَا تُصَعِّرْ خَدَّكَ لِلنَّاسِ وَلَا تَمْشِ فِى ٱلْأَرْضِ مَرَحًاۖ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ ", "translation": "And do not turn your cheek [in contempt] toward people[1] and do not walk through the earth exultantly. Indeed, Allāh does not like everyone self-deluded and boastful.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تُصَعِّرْ", "translit": "ْrِّʿعَṣُt", "root": "صعر"}, {"id": 3, "arabic": "خَدَّكَ", "translit": "َkَّdَhk", "root": "خدد"}, {"id": 4, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تَمْشِ", "translit": "ِhsْmَt", "root": "مشي"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "مَرَحًا", "translit": "āًḥَrَm", "root": "مرح"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 14, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 15, "arabic": "مُخْتَالٍ", "translit": "ٍlāَtْhkُm", "root": "خيل"}, {"id": 16, "arabic": "فَخُورٍ", "translit": "ٍrwُhkَf", "root": "فخر"}], "hasIhya": true}, {"ayah": 19, "text": "وَٱقْصِدْ فِى مَشْيِكَ وَٱغْضُضْ مِن صَوْتِكَۚ إِنَّ أَنكَرَ ٱلْأَصْوَٰتِ لَصَوْتُ ٱلْحَمِيرِ ", "translation": "And be moderate in your pace and lower your voice; indeed, the most disagreeable of sounds is the voice of donkeys.\"", "words": [{"id": 1, "arabic": "وَٱقْصِدْ", "translit": "ْdِṣْqٱَw", "root": "قصد"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "مَشْيِكَ", "translit": "َkِyْhsَm", "root": "مشي"}, {"id": 4, "arabic": "وَٱغْضُضْ", "translit": "ْḍُḍْغٱَw", "root": "غضض"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "صَوْتِكَ", "translit": "َkِtْwَṣ", "root": "صوت"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "أَنكَرَ", "translit": "َrَknَaʾ", "root": "نكر"}, {"id": 9, "arabic": "ٱلْأَصْوَٰتِ", "translit": "ِtَٰwْṣَaʾْlٱ", "root": "صوت"}, {"id": 10, "arabic": "لَصَوْتُ", "translit": "ُtْwَṣَl", "root": "صوت"}, {"id": 11, "arabic": "ٱلْحَمِيرِ", "translit": "ِryِmَḥْlٱ", "root": "حمر"}], "hasIhya": true}, {"ayah": 20, "text": "أَلَمْ تَرَوْا۟ أَنَّ ٱللَّهَ سَخَّرَ لَكُم مَّا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَأَسْبَغَ عَلَيْكُمْ نِعَمَهُۥ ظَٰهِرَةً وَبَاطِنَةًۗ وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِى ٱللَّهِ بِغَيْرِ عِلْمٍ وَلَا هُدًى وَلَا كِتَٰبٍ مُّنِيرٍ ", "translation": "Do you not see that Allāh has made subject to you whatever is in the heavens and whatever is in the earth and amply bestowed upon you His favors, [both] apparent and unapparent? But of the people is he who disputes about Allāh without knowledge or guidance or an enlightening Book [from Him].", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَوْا۟", "translit": "۟āْwَrَt", "root": "راي"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "سَخَّرَ", "translit": "َrَّhkَs", "root": "سخر"}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 13, "arabic": "وَأَسْبَغَ", "translit": "َغَbْsَaʾَw", "root": "سبغ"}, {"id": 14, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 15, "arabic": "نِعَمَهُۥ", "translit": "ۥُhَmَʿعِn", "root": "نعم"}, {"id": 16, "arabic": "ظَٰهِرَةً", "translit": "ًẗَrِhَٰẓ", "root": "ظهر"}, {"id": 17, "arabic": "وَبَاطِنَةً", "translit": "ًẗَnِṭāَbَw", "root": "بطن"}, {"id": 18, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 19, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 20, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 21, "arabic": "يُجَٰدِلُ", "translit": "ُlِdَٰjgُy", "root": "جدل"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 25, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 26, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 27, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 28, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 29, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 30, "arabic": "مُّنِيرٍ", "translit": "ٍryِnُّm", "root": "نور"}], "hasIhya": false}, {"ayah": 21, "text": "وَإِذَا قِيلَ لَهُمُ ٱتَّبِعُوا۟ مَآ أَنزَلَ ٱللَّهُ قَالُوا۟ بَلْ نَتَّبِعُ مَا وَجَدْنَا عَلَيْهِ ءَابَآءَنَآۚ أَوَلَوْ كَانَ ٱلشَّيْطَٰنُ يَدْعُوهُمْ إِلَىٰ عَذَابِ ٱلسَّعِيرِ ", "translation": "And when it is said to them, \"Follow what Allāh has revealed,\" they say, \"Rather, we will follow that upon which we found our fathers.\" Even if Satan was inviting them to the punishment of the Blaze?", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 4, "arabic": "ٱتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtٱ", "root": "تبع"}, {"id": 5, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 6, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 9, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 10, "arabic": "نَتَّبِعُ", "translit": "ُʿعِbَّtَn", "root": "تبع"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "وَجَدْنَا", "translit": "āَnْdَjgَw", "root": "وجد"}, {"id": 13, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "ءَابَآءَنَآ", "translit": "ٓāَnَءٓāَbāَء", "root": "ابو"}, {"id": 15, "arabic": "أَوَلَوْ", "translit": "ْwَlَwَaʾ", "root": ""}, {"id": 16, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 17, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 18, "arabic": "يَدْعُوهُمْ", "translit": "ْmُhwُʿعْdَy", "root": "دعو"}, {"id": 19, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 20, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 21, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": false}, {"ayah": 22, "text": "وَمَن يُسْلِمْ وَجْهَهُۥٓ إِلَى ٱللَّهِ وَهُوَ مُحْسِنٌ فَقَدِ ٱسْتَمْسَكَ بِٱلْعُرْوَةِ ٱلْوُثْقَىٰۗ وَإِلَى ٱللَّهِ عَٰقِبَةُ ٱلْأُمُورِ ", "translation": "And whoever submits his face [i.e., self] to Allāh while he is a doer of good - then he has grasped the most trustworthy handhold. And to Allāh will be the outcome of [all] matters.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يُسْلِمْ", "translit": "ْmِlْsُy", "root": "سلم"}, {"id": 3, "arabic": "وَجْهَهُۥٓ", "translit": "ٓۥُhَhْjgَw", "root": "وجه"}, {"id": 4, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "مُحْسِنٌ", "translit": "ٌnِsْḥُm", "root": "حسن"}, {"id": 8, "arabic": "فَقَدِ", "translit": "ِdَqَf", "root": ""}, {"id": 9, "arabic": "ٱسْتَمْسَكَ", "translit": "َkَsْmَtْsٱ", "root": "مسك"}, {"id": 10, "arabic": "بِٱلْعُرْوَةِ", "translit": "ِẗَwْrُʿعْlٱِb", "root": "عرو"}, {"id": 11, "arabic": "ٱلْوُثْقَىٰ", "translit": "ٰàَqْhtُwْlٱ", "root": "وثق"}, {"id": 12, "arabic": "وَإِلَى", "translit": "àَlِiʾَw", "root": ""}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 15, "arabic": "ٱلْأُمُورِ", "translit": "ِrwُmُaʾْlٱ", "root": "امر"}], "hasIhya": true}, {"ayah": 23, "text": "وَمَن كَفَرَ فَلَا يَحْزُنكَ كُفْرُهُۥٓۚ إِلَيْنَا مَرْجِعُهُمْ فَنُنَبِّئُهُم بِمَا عَمِلُوٓا۟ۚ إِنَّ ٱللَّهَ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ", "translation": "And whoever has disbelieved - let not his disbelief grieve you. To Us is their return, and We will inform them of what they did. Indeed, Allāh is Knowing of that within the breasts.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 3, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 4, "arabic": "يَحْزُنكَ", "translit": "َknُzْḥَy", "root": "حزن"}, {"id": 5, "arabic": "كُفْرُهُۥٓ", "translit": "ٓۥُhُrْfُk", "root": "كفر"}, {"id": 6, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "مَرْجِعُهُمْ", "translit": "ْmُhُʿعِjgْrَm", "root": "رجع"}, {"id": 8, "arabic": "فَنُنَبِّئُهُم", "translit": "mُhُyʾِّbَnُnَf", "root": "نبا"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "عَمِلُوٓا۟", "translit": "۟āٓwُlِmَʿع", "root": "عمل"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 14, "arabic": "بِذَاتِ", "translit": "ِtāَhdِb", "root": ""}, {"id": 15, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": false}, {"ayah": 24, "text": "نُمَتِّعُهُمْ قَلِيلًا ثُمَّ نَضْطَرُّهُمْ إِلَىٰ عَذَابٍ غَلِيظٍ ", "translation": "We grant them enjoyment for a little; then We will force them to a massive punishment.", "words": [{"id": 1, "arabic": "نُمَتِّعُهُمْ", "translit": "ْmُhُʿعِّtَmُn", "root": "متع"}, {"id": 2, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 3, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 4, "arabic": "نَضْطَرُّهُمْ", "translit": "ْmُhُّrَṭْḍَn", "root": "ضرر"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "عَذَابٍ", "translit": "ٍbāَhdَʿع", "root": "عذب"}, {"id": 7, "arabic": "غَلِيظٍ", "translit": "ٍẓyِlَغ", "root": "غلظ"}], "hasIhya": false}, {"ayah": 25, "text": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ ٱللَّهُۚ قُلِ ٱلْحَمْدُ لِلَّهِۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ", "translation": "And if you asked them, \"Who created the heavens and earth?\" they would surely say, \"Allāh.\" Say, \"[All] praise is [due] to Allāh\"; but most of them do not know.", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 2, "arabic": "سَأَلْتَهُم", "translit": "mُhَtْlَaʾَs", "root": "سال"}, {"id": 3, "arabic": "مَّنْ", "