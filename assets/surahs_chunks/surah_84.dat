", "root": ""}, {"id": 3, "arabic": "ا۟وتِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كِتَٰبَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِيَمِينِهِۦ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 8, "text": "فَسَوْفَ يُحَاسَبُ حِسَاباࣰ يَسِيراࣰ‏", "words": [{"id": 1, "arabic": "فَسَوْفَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُحَاسَبُ", "translit": "", "root": ""}, {"id": 3, "arabic": "حِسَاباࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسِيراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 9, "text": "وَيَنقَلِبُ إِلَيٰٓ أَهْلِهِۦ مَسْرُوراࣰۖ", "words": [{"id": 1, "arabic": "وَيَنقَلِبُ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَهْلِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَسْرُوراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 10, "text": "وَأَمَّا مَنُ ا۟وتِيَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ا۟وتِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "كِتَٰبَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَرَآءَ", "translit": "", "root": ""}, {"id": 6, "arabic": "ظَهْرِهِۦ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 11, "text": "فَسَوْفَ يَدْعُواْ ثُبُوراࣰ‏", "words": [{"id": 1, "arabic": "فَسَوْفَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَدْعُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "ثُبُوراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 12, "text": "وَيُصَلَّيٰ سَعِيراًۖ", "words": [{"id": 1, "arabic": "وَيُصَلَّيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "سَعِيراًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 13, "text": "اِنَّهُۥ كَانَ فِےٓ أَه