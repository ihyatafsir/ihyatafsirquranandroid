{"surah": 84, "verses": [{"ayah": 1, "text": "إِذَا ٱلسَّمَآءُ ٱنشَقَّتْ ", "translation": "When the sky has split [open]", "words": [{"id": 1, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلسَّمَآءُ", "translit": "ُءٓāَmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "ٱنشَقَّتْ", "translit": "ْtَّqَhsnٱ", "root": "شقق"}], "hasIhya": false}, {"ayah": 2, "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ ", "translation": "And has listened [i.e., responded][1] to its Lord and was obligated [to do so]", "words": [{"id": 1, "arabic": "وَأَذِنَتْ", "translit": "ْtَnِhdَaʾَw", "root": "اذن"}, {"id": 2, "arabic": "لِرَبِّهَا", "translit": "āَhِّbَrِl", "root": "ربب"}, {"id": 3, "arabic": "وَحُقَّتْ", "translit": "ْtَّqُḥَw", "root": "حقق"}], "hasIhya": false}, {"ayah": 3, "text": "وَإِذَا ٱلْأَرْضُ مُدَّتْ ", "translation": "And when the earth has been extended[1]", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 3, "arabic": "مُدَّتْ", "translit": "ْtَّdُm", "root": "مدد"}], "hasIhya": false}, {"ayah": 4, "text": "وَأَلْقَتْ مَا فِيهَا وَتَخَلَّتْ ", "translation": "And has cast out that within it[1] and relinquished [it]", "words": [{"id": 1, "arabic": "وَأَلْقَتْ", "translit": "ْtَqْlَaʾَw", "root": "لقي"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 4, "arabic": "وَتَخَلَّتْ", "translit": "ْtَّlَhkَtَw", "root": "خلو"}], "hasIhya": true}, {"ayah": 5, "text": "وَأَذِنَتْ لِرَبِّهَا وَحُقَّتْ ", "translation": "And has listened [i.e., responded] to its Lord and was obligated [to do so] –", "words": [{"id": 1, "arabic": "وَأَذِنَتْ", "translit": "ْtَnِhdَaʾَw", "root": "اذن"}, {"id": 2, "arabic": "لِرَبِّهَا", "translit": "āَhِّbَrِl", "root": "ربب"}, {"id": 3, "arabic": "وَحُقَّتْ", "translit": "ْtَّqُḥَw", "root": "حقق"}], "hasIhya": false}, {"ayah": 6, "text": "يَٰٓأَيُّهَا ٱلْإِنسَٰنُ إِنَّكَ كَادِحٌ إِلَىٰ رَبِّكَ كَدْحًا فَمُلَٰقِيهِ ", "translation": "O mankind, indeed you are laboring toward your Lord with [great] exertion[1] and will meet it.[2]", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 4, "arabic": "كَادِحٌ", "translit": "ٌḥِdāَk", "root": "كدح"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 7, "arabic": "كَدْحًا", "translit": "āًḥْdَk", "root": "كدح"}, {"id": 8, "arabic": "فَمُلَٰقِيهِ", "translit": "ِhyِqَٰlُmَf", "root": "لقي"}], "hasIhya": true}, {"ayah": 7, "text": "فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ ", "translation": "Then as for he who is given his record in his right hand,", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 4, "arabic": "كِتَٰبَهُۥ", "translit": "ۥُhَbَٰtِk", "root": "كتب"}, {"id": 5, "arabic": "بِيَمِينِهِۦ", "translit": "ۦِhِnyِmَyِb", "root": "يمن"}], "hasIhya": false}, {"ayah": 8, "text": "فَسَوْفَ يُحَاسَبُ حِسَابًا يَسِيرًا ", "translation": "He will be judged with an easy account", "words": [{"id": 1, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 2, "arabic": "يُحَاسَبُ", "translit": "ُbَsāَḥُy", "root": "حسب"}, {"id": 3, "arabic": "حِسَابًا", "translit": "āًbāَsِḥ", "root": "حسب"}, {"id": 4, "arabic": "يَسِيرًا", "translit": "āًryِsَy", "root": "يسر"}], "hasIhya": true}, {"ayah": 9, "text": "وَيَنقَلِبُ إِلَىٰٓ أَهْلِهِۦ مَسْرُورًا ", "translation": "And return to his people in happiness.", "words": [{"id": 1, "arabic": "وَيَنقَلِبُ", "translit": "ُbِlَqnَyَw", "root": "قلب"}, {"id": 2, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 3, "arabic": "أَهْلِهِۦ", "translit": "ۦِhِlْhَaʾ", "root": "اهل"}, {"id": 4, "arabic": "مَسْرُورًا", "translit": "āًrwُrْsَm", "root": "سرر"}], "hasIhya": false}, {"ayah": 10, "text": "وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ وَرَآءَ ظَهْرِهِۦ ", "translation": "But as for he who is given his record behind his back,", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 4, "arabic": "كِتَٰبَهُۥ", "translit": "ۥُhَbَٰtِk", "root": "كتب"}, {"id": 5, "arabic": "وَرَآءَ", "translit": "َءٓāَrَw", "root": "وري"}, {"id": 6, "arabic": "ظَهْرِهِۦ", "translit": "ۦِhِrْhَẓ", "root": "ظهر"}], "hasIhya": false}, {"ayah": 11, "text": "فَسَوْفَ يَدْعُوا۟ ثُبُورًا ", "translation": "He will cry out for destruction", "words": [{"id": 1, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 2, "arabic": "يَدْعُوا۟", "translit": "۟āwُʿعْdَy", "root": "دعو"}, {"id": 3, "arabic": "ثُبُورًا", "translit": "āًrwُbُht", "root": "ثبر"}], "hasIhya": false}, {"ayah": 12, "text": "وَيَصْلَىٰ سَعِيرًا ", "translation": "And [enter to] burn in a Blaze.", "words": [{"id": 1, "arabic": "وَيَصْلَىٰ", "translit": "ٰàَlْṣَyَw", "root": "صلي"}, {"id": 2, "arabic": "سَعِيرًا", "translit": "āًryِʿعَs", "root": "سعر"}], "hasIhya": false}, {"ayah": 13, "text": "إِنَّهُۥ كَانَ فِىٓ أَهْلِهِۦ مَسْرُورًا ", "translation": "Indeed, he had [once] been among his people in happiness;", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "أَهْلِهِۦ", "translit": "ۦِhِlْhَaʾ", "root": "اهل"}, {"id": 5, "arabic": "مَسْرُورًا", "translit": "āًrwُrْsَm", "root": "سرر"}], "hasIhya": false}, {"ayah": 14, "text": "إِنَّهُۥ ظَنَّ أَن لَّن يَحُورَ ", "translation": "Indeed, he had thought he would never return [to Allāh].", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ظَنَّ", "translit": "َّnَẓ", "root": "ظنن"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 5, "arabic": "يَحُورَ", "translit": "َrwُḥَy", "root": "حور"}], "hasIhya": false}, {"ayah": 15, "text": "بَلَىٰٓ إِنَّ رَبَّهُۥ كَانَ بِهِۦ بَصِيرًا ", "translation": "But yes! Indeed, his Lord was ever, of him, Seeing.", "words": [{"id": 1, "arabic": "بَلَىٰٓ", "translit": "ٰٓàَlَb", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "رَبَّهُۥ", "translit": "ۥُhَّbَr", "root": "ربب"}, {"id": 4, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 16, "text": "فَلَآ أُقْسِمُ بِٱلشَّفَقِ ", "translation": "So I swear by the twilight glow", "words": [{"id": 1, "arabic": "فَلَآ", "translit": "ٓāَlَf", "root": ""}, {"id": 2, "arabic": "أُقْسِمُ", "translit": "ُmِsْqُaʾ", "root": "قسم"}, {"id": 3, "arabic": "بِٱلشَّفَقِ", "translit": "ِqَfَّhslٱِb", "root": "شفق"}], "hasIhya": false}, {"ayah": 17, "text": "وَٱلَّيْلِ وَمَا وَسَقَ ", "translation": "And [by] the night and what it envelops", "words": [{"id": 1, "arabic": "وَٱلَّيْلِ", "translit": "ِlْyَّlٱَw", "root": "ليل"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 3, "arabic": "وَسَقَ", "translit": "َqَsَw", "root": "وسق"}], "hasIhya": false}, {"ayah": 18, "text": "وَٱلْقَمَرِ إِذَا ٱتَّسَقَ ", "translation": "And [by] the moon when it becomes full", "words": [{"id": 1, "arabic": "وَٱلْقَمَرِ", "translit": "ِrَmَqْlٱَw", "root": "قمر"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "ٱتَّسَقَ", "translit": "َqَsَّtٱ", "root": "وسق"}], "hasIhya": false}, {"ayah": 19, "text": "لَتَرْكَبُنَّ طَبَقًا عَن طَبَقٍ ", "translation": "[That] you will surely embark upon [i.e., experience] state after state.[1]", "words": [{"id": 1, "arabic": "لَتَرْكَبُنَّ", "translit": "َّnُbَkْrَtَl", "root": "ركب"}, {"id": 2, "arabic": "طَبَقًا", "translit": "āًqَbَṭ", "root": "طبق"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "طَبَقٍ", "translit": "ٍqَbَṭ", "root": "طبق"}], "hasIhya": false}, {"ayah": 20, "text": "فَمَا لَهُمْ لَا يُؤْمِنُونَ ", "translation": "So what is [the matter] with them [that] they do not believe,", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 21, "text": "وَإِذَا قُرِئَ عَلَيْهِمُ ٱلْقُرْءَانُ لَا يَسْجُدُونَ۩ ", "translation": "And when the Qur’ān is recited to them, they do not prostrate [to Allāh]?", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قُرِئَ", "translit": "َyʾِrُq", "root": "قرا"}, {"id": 3, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْقُرْءَانُ", "translit": "ُnāَءْrُqْlٱ", "root": "قرا"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَسْجُدُونَ", "translit": "َnwُdُjgْsَy", "root": "سجد"}], "hasIhya": false}, {"ayah": 22, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ يُكَذِّبُونَ ", "translation": "But those who have disbelieved deny,", "words": [{"id": 1, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "يُكَذِّبُونَ", "translit": "َnwُbِّhdَkُy", "root": "كذب"}], "hasIhya": false}, {"ayah": 23, "text": "وَٱللَّهُ أَعْلَمُ بِمَا يُوعُونَ ", "translation": "And Allāh is most knowing of what they keep within themselves.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "يُوعُونَ", "translit": "َnwُʿعwُy", "root": "وعي"}], "hasIhya": false}, {"ayah": 24, "text": "فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ ", "translation": "So give them tidings of a painful punishment,", "words": [{"id": 1, "arabic": "فَبَشِّرْهُم", "translit": "mُhْrِّhsَbَf", "root": "بشر"}, {"id": 2, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 3, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 25, "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍۭ ", "translation": "Except for those who believe and do righteous deeds. For them is a reward uninterrupted.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 8, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 9, "arabic": "مَمْنُونٍۭ", "translit": "ٍۭnwُnْmَm", "root": "منن"}], "hasIhya": false}], "tafsir": {"4": [{"arabic": "فإذا فارقت الروح الجسد فقد حملت الأرض فمدت حتى ألقت ما فيها وتخلت ولست أطول بجميع موازنة الأحوال والأهوال ولكني أقول بمجرد الموت تقوم عليك هذه القيامة الصغرى ولا يفوتك من القيامة الكبرى شيء مما يخصك بل ما يخص غيرك", "english": "When the Spirit (Ruh) separates from the body, then the earth has been burdened and stretched until it cast forth what was within it and became empty. I will not elaborate on all the balancing of states and terrors, but I say: upon death alone, this minor resurrection (Qiyamah) stands against you, and nothing of the major resurrection (Qiyamah) that pertains to you will escape you, but rather what pertains to others.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Patience and Gratitude'", "badge": "Afterlife"}], "6": [{"arabic": "وقال ﭬ للذي أوصاه: (وإذا صليت فصل صلاة مودع[39]) أي مودع لنفسه مودع لهواه مودع لعمره سائر إلى مولاه كما قال عز وجل: ﴿ أيها الإنسان إنك كادح إلى ربك كدحا فملاقيه ﴾ {الانشقاق: 6}", "english": "And he (peace be upon him) said to the one he advised: 'When you pray, pray the prayer of one departing (Muwaddi').' That is, departing from his Soul (Nafs), departing from his desire (Hawa), departing from his lifespan, journeying to his Master (Mawla) as the Exalted said: 'O human being, indeed you are laboring (Kadih) toward your Lord (Rabb) with labor (Kadhan), then you will meet Him.'", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Prayer'", "badge": "Insight"}], "8": [{"arabic": "وللشيخين من حديث عائشة من نوقش الحساب عذب قالت قلت يقول الله تعالى فسوف يحاسب حسابا يسيرا قال ذلك العرض", "english": "And from the two Sheikhs (Al-Bukhari and Muslim) from the hadith of Aisha: 'Whoever is questioned in the accounting (hisab) is punished.' She said: 'I said: Allah the Exalted says: \"Then he will be accounted with an easy accounting (hisaban yasiran).\"' He said: 'That is the presentation (al-'ard).'", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Foundations of Belief'", "badge": "Hadith"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 1313], [2, 1313, 3582], [3, 3582, 4965]], "2": [[1, 350, 1491], [2, 1491, 2721], [3, 2721, 3842]], "3": [[1, 250, 1263], [2, 1263, 2164], [3, 2164, 2868]], "4": [[1, 350, 1512], [2, 1512, 2024], [3, 2024, 3009], [4, 3009, 4260]], "5": [[1, 350, 1465], [2, 1465, 2667], [3, 2667, 3763]], "6": [[1, 400, 3029], [2, 3029, 4639], [3, 4639, 5835], [4, 5835, 7043], [5, 7043, 8226], [6, 8226, 9190], [7, 9190, 10463], [8, 10463, 12314]], "7": [[1, 350, 1990], [2, 1990, 2515], [3, 2515, 3880], [4, 3880, 5061], [5, 5061, 6872]], "8": [[1, 350, 1245], [2, 1245, 2470], [3, 2470, 3715], [4, 3715, 5017]], "9": [[1, 350, 2198], [2, 2198, 3763], [3, 3763, 4789], [4, 4789, 6637]], "10": [[1, 400, 1975], [2, 1975, 2442], [3, 2442, 3655], [4, 3655, 4705], [5, 4705, 6446], [6, 6446, 7403]], "11": [[1, 250, 1026], [2, 1026, 2215], [3, 2215, 3260]], "12": [[1, 250, 1665], [2, 1665, 2842]], "13": [[1, 350, 1490], [2, 1490, 2392], [3, 2392, 3620], [4, 3620, 4623], [5, 4623, 6428]], "14": [[1, 350, 1870], [2, 1870, 3123], [3, 3123, 3858], [4, 3858, 4777], [5, 4777, 6480]], "15": [[1, 350, 1895], [2, 1895, 2851], [3, 2851, 3807], [4, 3807, 4750], [5, 4750, 5248], [6, 5248, 6924]], "16": [[1, 350, 1694], [2, 1694, 2741], [3, 2741, 4181]], "17": [[1, 250, 1340], [2, 1340, 2079], [3, 2079, 2764]], "18": [[1, 250, 1352], [2, 1352, 2069], [3, 2069, 2868]], "19": [[1, 350, 2415], [2, 2415, 3829], [3, 3829, 4439], [4, 4439, 5409]], "20": [[1, 350, 1042], [2, 1042, 1599], [3, 1599, 2099], [4, 2099, 3502]], "21": [[1, 350, 1387], [2, 1387, 2059], [3, 2059, 3135], [4, 3135, 4460], [5, 4460, 4959], [6, 4959, 6323]], "22": [[1, 350, 716], [2, 716, 1749], [3, 1749, 2864], [4, 2864, 4312]], "23": [[1, 350, 1478], [2, 1478, 2389], [3, 2389, 3134], 