 3, "arabic": "اَ۪تَّسَقَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 19, "text": "لَتَرْكَبُنَّ طَبَقاً عَن طَبَقࣲۖ", "words": [{"id": 1, "arabic": "لَتَرْكَبُنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "طَبَقاً", "translit": "", "root": ""}, {"id": 3, "arabic": "عَن", "translit": "", "root": ""}, {"id": 4, "arabic": "طَبَقࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 20, "text": "فَمَا لَهُمْ لَا يُومِنُونَ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُومِنُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 21, "text": "وَإِذَا قُرِۓَ عَلَيْهِمُ اُ۬لْقُرْءَانُ لَا يَسْجُدُونَ۩ۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "قُرِۓَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْقُرْءَانُ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَسْجُدُونَ۩ۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 22, "text": "بَلِ اِ۬لذِينَ كَفَرُواْ يُكَذِّبُونَ", "words": [{"id": 1, "arabic": "بَلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُكَذِّبُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 23, "text": "وَاللَّهُ أَعْلَمُ بِمَا يُوعُونَۖ", "words": [{"id": 1, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَعْلَمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يُوعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 24, "text": "فَبَشِّرْهُم بِعَذَابٍ اَلِيمٍۖ", "words": [{"id": 1, "arabic": "فَبَشِّرْهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "بِعَذَابٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَلِيمٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 84, "ayah": 25, "text": "اِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونࣲۖ", "words": [{"id": 1, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَجْرٌ", "translit": "", "root": ""}, {"id": 8, "arabic": "غَيْرُ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَمْنُونࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}]}