": 9, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 10, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "قَدِيرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 57, "ayah": 3, "text": "هُوَ اَ۬لَاوَّلُ وَالَاخِرُ وَالظَّٰهِرُ وَالْبَاطِنُۖ وَهُوَ بِكُلِّ شَےْءٍ عَلِيمٌۖ", "words": [{"id": 1, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَاوَّلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالَاخِرُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالظَّٰهِرُ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالْبَاطِنُۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِكُلِّ", "translit": "", "root": ""}, {"id": 8, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 57, "ayah": 4, "text": "هُوَ اَ۬لذِے خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ فِے سِتَّةِ أَيَّامࣲ ثُمَّ اَ۪سْتَو۪يٰ عَلَي اَ۬لْعَرْشِۖ يَعْلَمُ مَا يَلِجُ فِے اِ۬لَارْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنزِلُ مِنَ اَ۬لسَّمَآءِ وَمَا يَعْرُجُ فِيهَاۖ وَهُوَ مَعَكُمُۥٓ أَيْنَ مَا كُنتُمْۖ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرࣱۖ", "words": [{"id": 1, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "سِتَّةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَيَّامࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۪سْتَو۪يٰ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لْعَرْشِۖ", "translit": "", "root": ""}, {"id": 13, "ara