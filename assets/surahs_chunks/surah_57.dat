": ""}, {"id": 25, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 26, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 27, "arabic": "قَوِيٌّ", "translit": "", "root": ""}, {"id": 28, "arabic": "عَزِيزࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 57, "ayah": 26, "text": "وَلَقَدَ اَرْسَلْنَا نُوحاࣰ وَإِبْرَٰهِيمَ وَجَعَلْنَا فِے ذُرِّيَّتِهِمَا اَ۬لنُّبُوٓءَةَ وَالْكِتَٰبَۖ فَمِنْهُم مُّهْتَدࣲۖ وَكَثِيرࣱ مِّنْهُمْ فَٰسِقُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَإِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "ذُرِّيَّتِهِمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لنُّبُوٓءَةَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَالْكِتَٰبَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَمِنْهُم", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّهْتَدࣲۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَكَثِيرࣱ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّنْهُمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَٰسِقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 57, "ayah": 27, "text": "ثُمَّ قَفَّيْنَا عَلَيٰٓ ءَاثٰ۪رِهِم بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَي اَ۪بْنِ مَرْيَمَ وَءَاتَيْنَٰهُ اُ۬لِانجِيلَۖ وَجَعَلْنَا فِے قُلُوبِ اِ۬لذِينَ اَ۪تَّبَعُوهُ رَأْفَةࣰ وَرَحْمَةࣰ وَرَهْبَانِيَّةً اِ۪بْتَدَعُوهَا مَا كَتَبْنَٰهَا عَلَيْهِمُۥٓ إِلَّا اَ۪بْتِغَآءَ رِضْوَٰنِ اِ۬للَّهِۖ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَاۖ فَـَٔاتَيْنَا اَ۬لذِينَ ءَامَنُواْ مِنْهُمُۥٓ أَجْرَهُمْۖ وَكَثِيرࣱ مِّنْهُمْ فَٰسِقُونَۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَفَّيْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَاثٰ۪رِهِم", "translit": "", "root": ""}, {"id": 5, "arabic": "بِرُسُلِنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَقَفَّيْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بِعِيسَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۪بْنِ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَرْيَمَ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَءَاتَيْنَٰهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لِانجِيلَۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 13, "arabic": "فِے", "translit": "", "root": ""}, {"id": 14, "arabic": "قُلُوبِ", "translit": "", "root": ""}, {"id": 15, "arabic": "اِ۬لذِينَ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۪تَّبَعُوهُ", "translit": "", "root": ""}, {"id": 17, "arabic": "رَأْفَةࣰ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَرَحْمَةࣰ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَرَهْبَانِيَّةً", "translit": "", "root": ""}, {"id": 20, "arabic": "اِ۪بْتَدَعُوهَا", "translit": "", "root": ""}, {"id": 21, "arabic": "مَا", "translit": "", "root": ""}, {"id": 22, "arabic": "كَتَبْنَٰهَا", "translit": "", "root": ""}, {"id": 23, "arabic": "عَلَيْهِمُۥٓ", "translit": "", "root": ""}, {"id": 24, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 25, "arabic": "اَ۪بْتِغَآءَ", "translit": "", "root": ""}, {"id": 26, "arabic": "رِضْوَٰنِ", "translit": "", "root": ""}, {"id": 27, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 28, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 29, "arabic": "رَعَوْهَا", "translit": "", "root": ""}, {"id": 30, "arabic": "حَقَّ", "translit": "", "root": ""}, {"id": 31, "arabic": "رِعَايَتِهَاۖ", "translit": "", "root": ""}, {"id": 32, "arabic": "فَـَٔاتَيْنَا", "translit": "", "root": ""}, {"id": 33, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 34, "arabic": "ءَامَنُواْ", "transl