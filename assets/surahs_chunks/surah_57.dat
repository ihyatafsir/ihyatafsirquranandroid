: 9, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "نَّبْرَأَهَآ", "translit": "ٓāَhَaʾَrْbَّn", "root": "برا"}, {"id": 17, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 18, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 19, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 20, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "يَسِيرٌ", "translit": "ٌryِsَy", "root": "يسر"}], "hasIhya": false}, {"ayah": 23, "text": "لِّكَيْلَا تَأْسَوْا۟ عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُوا۟ بِمَآ ءَاتَىٰكُمْۗ وَٱللَّهُ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ ", "translation": "In order that you not despair over what has eluded you and not exult [in pride] over what He has given you. And Allāh does not like everyone self-deluded and boastful -", "words": [{"id": 1, "arabic": "لِّكَيْلَا", "translit": "āَlْyَkِّl", "root": ""}, {"id": 2, "arabic": "تَأْسَوْا۟", "translit": "۟āْwَsْaʾَt", "root": "اسو"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "فَاتَكُمْ", "translit": "ْmُkَtāَf", "root": "فوت"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَفْرَحُوا۟", "translit": "۟āwُḥَrْfَt", "root": "فرح"}, {"id": 8, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 9, "arabic": "ءَاتَىٰكُمْ", "translit": "ْmُkٰàَtāَء", "root": "اتي"}, {"id": 10, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 13, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 14, "arabic": "مُخْتَالٍ", "translit": "ٍlāَtْhkُm", "root": "خيل"}, {"id": 15, "arabic": "فَخُورٍ", "translit": "ٍrwُhkَf", "root": "فخر"}], "hasIhya": true}, {"ayah": 24, "text": "ٱلَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِۗ وَمَن يَتَوَلَّ فَإِنَّ ٱللَّهَ هُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ ", "translation": "[Those] who are stingy and enjoin upon people stinginess. And whoever turns away[1] - then indeed, Allāh is the Free of need, the Praiseworthy.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَبْخَلُونَ", "translit": "َnwُlَhkْbَy", "root": "بخل"}, {"id": 3, "arabic": "وَيَأْمُرُونَ", "translit": "َnwُrُmْaʾَyَw", "root": "امر"}, {"id": 4, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "بِٱلْبُخْلِ", "translit": "ِlْhkُbْlٱِb", "root": "بخل"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "يَتَوَلَّ", "translit": "َّlَwَtَy", "root": "ولي"}, {"id": 8, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "ٱلْغَنِىُّ", "translit": "ُّàِnَغْlٱ", "root": "غني"}, {"id": 12, "arabic": "ٱلْحَمِيدُ", "translit": "ُdyِmَḥْlٱ", "root": "حمد"}], "hasIhya": false}, {"ayah": 25, "text": "لَقَدْ أَرْسَلْنَا رُسُلَنَا بِٱلْبَيِّنَٰتِ وَأَنزَلْنَا مَعَهُمُ ٱلْكِتَٰبَ وَٱلْمِيزَانَ لِيَقُومَ ٱلنَّاسُ بِٱلْقِسْطِۖ وَأَنزَلْنَا ٱلْحَدِيدَ فِيهِ بَأْسٌ شَدِيدٌ وَمَنَٰفِعُ لِلنَّاسِ وَلِيَعْلَمَ ٱللَّهُ مَن يَنصُرُهُۥ وَرُسُلَهُۥ بِٱلْغَيْبِۚ إِنَّ ٱللَّهَ قَوِىٌّ عَزِيزٌ ", "translation": "We have already sent Our messengers with clear evidences and sent down with them the Scripture and the balance that the people may maintain [their affairs] in justice. And We sent down iron, wherein is great military might and benefits for the people, and so that Allāh may make evident those who support Him and His messengers unseen. Indeed, Allāh is Powerful and Exalted in Might.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "رُسُلَنَا", "translit": "āَnَlُsُr", "root": "رسل"}, {"id": 4, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 5, "arabic": "وَأَنزَلْنَا", "translit": "āَnْlَznَaʾَw", "root": "نزل"}, {"id": 6, "arabic": "مَعَهُمُ", "translit": "ُmُhَʿعَm", "root": ""}, {"id": 7, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 8, "arabic": "وَٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱَw", "root": "وزن"}, {"id": 9, "arabic": "لِيَقُومَ", "translit": "َmwُqَyِl", "root": "قوم"}, {"id": 10, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 11, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 12, "arabic": "وَأَنزَلْنَا", "translit": "āَnْlَznَaʾَw", "root": "نزل"}, {"id": 13, "arabic": "ٱلْحَدِيدَ", "translit": "َdyِdَḥْlٱ", "root": "حدد"}, {"id": 14, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 15, "arabic": "بَأْسٌ", "translit": "ٌsْaʾَb", "root": "باس"}, {"id": 16, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}, {"id": 17, "arabic": "وَمَنَٰفِعُ", "translit": "ُʿعِfَٰnَmَw", "root": "نفع"}, {"id": 18, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 19, "arabic": "وَلِيَعْلَمَ", "translit": "َmَlْʿعَyِlَw", "root": "علم"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 22, "arabic": "يَنصُرُهُۥ", "translit": "ۥُhُrُṣnَy", "root": "نصر"}, {"id": 23, "arabic": "وَرُسُلَهُۥ", "translit": "ۥُhَlُsُrَw", "root": "رسل"}, {"id": 24, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 25, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 26, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "قَوِىٌّ", "translit": "ٌّàِwَq", "root": "قوي"}, {"id": 28, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}], "hasIhya": false}, {"ayah": 26, "text": "وَلَقَدْ أَرْسَلْنَا نُوحًا وَإِبْرَٰهِيمَ وَجَعَلْنَا فِى ذُرِّيَّتِهِمَا ٱلنُّبُوَّةَ وَٱلْكِتَٰبَۖ فَمِنْهُم مُّهْتَدٍۖ وَكَثِيرٌ مِّنْهُمْ فَٰسِقُونَ ", "translation": "And We have already sent Noah and Abraham and placed in their descendants prophethood and scripture; and among them is he who is guided, but many of them are defiantly disobedient.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "نُوحًا", "translit": "āًḥwُn", "root": ""}, {"id": 4, "arabic": "وَإِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾَw", "root": ""}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ذُرِّيَّتِهِمَا", "translit": "āَmِhِtَّyِّrُhd", "root": "ذرر"}, {"id": 8, "arabic": "ٱلنُّبُوَّةَ", "translit": "َẗَّwُbُّnlٱ", "root": "نبا"}, {"id": 9, "arabic": "وَٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱَw", "root": "كتب"}, {"id": 10, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 11, "arabic": "مُّهْتَدٍ", "translit": "ٍdَtْhُّm", "root": "هدي"}, {"id": 12, "arabic": "وَكَثِيرٌ", "translit": "ٌryِhtَkَw", "root": "كثر"}, {"id": 13, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 14, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 27, "text": "ثُمَّ قَفَّيْنَا عَلَىٰٓ ءَاثَٰرِهِم بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى ٱبْنِ مَرْيَمَ وَءَاتَيْنَٰهُ ٱلْإِنجِيلَ وَجَعَلْنَا فِى قُلُوبِ ٱلَّذِينَ ٱتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً ٱبْتَدَعُوهَا مَا كَتَبْنَٰهَا عَلَيْهِمْ إِلَّا ٱبْتِغَآءَ رِضْوَٰنِ ٱللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَاۖ فَـَٔاتَيْنَا ٱلَّذِينَ ءَامَنُوا۟ مِنْهُمْ أَجْرَهُمْۖ وَكَثِيرٌ مِّنْهُمْ فَٰسِقُونَ ", "translation": "Then We sent following their footsteps [i.e., traditions] Our messengers and followed [them] with Jesus, the son of Mary, and gave him the Gospel. And We placed in the hearts of those who followed him compassion and mercy and monasticism, which they innovated; We did not prescribe it for them except [that they did so] seeking the approval of Allāh. But they did not observe it with due observance. So We gave the ones who believed among them their reward, but many of them are defiantly disobedient.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "قَفَّيْنَا", "translit": "āَnْyَّfَq", "root": "قفو"}, {"id": 3, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 4, "arabic": "ءَاثَٰرِهِم", "translit": "mِhِrَٰhtāَء", "root": "اثر"}, {"id": 5, "arabic": "بِرُسُلِنَا", "translit": "āَnِlُsُrِb", "root": "رسل"}, {"id": 6, "arabic": "وَقَفَّيْنَا", "translit": "āَnْyَّfَqَw", "root": "قفو"}, {"id": 7, "arabic": "بِعِيسَى", "translit": "àَsyِʿعِb", "root": ""}, {"id": 8, "arabic": "ٱبْنِ", "translit": "ِnْbٱ", "root": "بني"}, {"id": 9, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 10, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 11, "arabic": "ٱلْإِنجِيلَ", "translit": "َlyِjgnِiʾْlٱ", "root": ""}, {"id": 12, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "قُلُوبِ", "translit": "ِbwُlُq", "root": "قلب"}, {"id": 15, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "ٱتَّبَعُوهُ", "translit": "ُhwُʿعَbَّtٱ", "root": "تبع"}, {"id": 17, "arabic": "رَأْفَةً", "translit": "ًẗَfْaʾَr", "root": "راف"}, {"id": 18, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 19, "arabic": "وَرَهْبَانِيَّةً", "translit": "ًẗَّyِnāَbْhَrَw", "root": "رهب"}, {"id": 20, "arabic": "ٱبْتَدَعُوهَا", "translit": "āَhwُʿعَdَtْbٱ", "root": "بدع"}, {"id": 21, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 22, "arabic": "كَتَبْنَٰهَا", "translit": "āَhَٰnْbَtَk", "root": "كتب"}, {"id": 23, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 24, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 25, "arabic": "ٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱ", "root": "بغي"}, {"id": 26, "arabic": "رِضْوَٰنِ", "translit": "ِnَٰwْḍِr", "root": "رضو"}, {"id": 27, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 29, "arabic": "رَعَوْهَا", "translit": "āَhْwَʿعَr", "root": "رعي"}, {"id": 30, "arabic": "حَقَّ", "translit": "َّqَḥ", "root": "حقق"}, {"id": 31, "arabic": "رِعَايَتِهَا", "translit": "āَhِtَyāَʿعِr", "root": "رعي"}, {"id": 32, "arabic": "فَـَٔاتَيْنَا", "translit": "āَnْyَtāَٔـَf", "root": "اتي"}, {"id": 33, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 34, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 35, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 36, "arabic": "أَجْرَهُمْ", "translit": "ْmُhَrْjgَaʾ", "root": "اجر"}, {"id": 37, "arabic": "وَكَثِيرٌ", "translit": "ٌryِhtَkَw", "root": "كثر"}, {"id": 38, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 39, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 28, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَءَامِنُوا۟ بِرَسُولِهِۦ يُؤْتِكُمْ كِفْلَيْنِ مِن رَّحْمَتِهِۦ وَيَجْعَل لَّكُمْ نُورًا تَمْشُونَ بِهِۦ وَيَغْفِرْ لَكُمْۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "O you who have believed, fear Allāh and believe in His Messenger; He will [then] give you a double portion of His mercy and make for you a light by which you will walk and forgive you; and Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَءَامِنُوا۟", "translit": "۟āwُnِmāَءَw", "root": "امن"}, {"id": 7, "arabic": "بِرَسُولِهِۦ", "translit": "ۦِhِlwُsَrِb", "root": "رسل"}, {"id": 8, "arabic": "يُؤْتِكُمْ", "translit": "ْmُkِtْwʾُy", "root": "اتي"}, {"id": 9, "arabic": "كِفْلَيْنِ", "translit": "ِnْyَlْfِk", "root": "كفل"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "رَّحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَّr", "root": "رحم"}, {"id": 12, "arabic": "وَيَجْعَل", "translit": "lَʿعْjgَyَw", "root": "جعل"}, {"id": 13, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 14, "arabic": "نُورًا", "translit": "āًrwُn", "root": "نور"}, {"id": 15, "arabic": "تَمْشُونَ", "translit": "َnwُhsْmَt", "root": "مشي"}, {"id": 16, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 17, "arabic": "وَيَغْفِرْ", "translit": "ْrِfْغَyَw", "root": "غفر"}, {"id": 18, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 19, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 20, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 21, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 29, "text": "لِّئَلَّا يَعْلَمَ أَهْلُ ٱلْكِتَٰبِ أَلَّا يَقْدِرُونَ عَلَىٰ شَىْءٍ مِّن فَضْلِ ٱللَّهِۙ وَأَنَّ ٱلْفَضْلَ بِيَدِ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ ", "translation": "[This is] so that the People of the Scripture may know that they are not able [to obtain] anything from the bounty of Allāh[1] and that [all] bounty is in the hand[2] of Allāh; He gives it to whom He wills. And Allāh is the possessor of great bounty.", "words": [{"id": 1, "arabic": "لِّئَلَّا", "translit": "āَّlَyʾِّl", "root": ""}, {"id": 2, "arabic": "يَعْلَمَ", "translit": "َmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "أَهْلُ", "translit": "ُlْhَaʾ", "root": "اهل"}, {"id": 4, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 6, "arabic": "يَقْدِرُونَ", "translit": "َnwُrِdْqَy", "root": "قدر"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "فَضْلِ", "translit": "ِlْḍَf", "root": "فضل"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 13, "arabic": "ٱلْفَضْلَ", "translit": "َlْḍَfْlٱ", "root": "فضل"}, {"id": 14, "arabic": "بِيَدِ", "translit": "ِdَyِb", "root": "يدي"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "يُؤْتِيهِ", "translit": "ِhyِtْwʾُy", "root": "اتي"}, {"id": 17, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 18, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 19, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 20, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 21, "arabic": "ٱلْفَضْلِ", "translit": "ِlْḍَfْlٱ", "root": "فضل"}, {"id": 22, "arabic": "ٱلْعَظِيمِ", "translit": "ِmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدرك مدارك الملوك (4) وقد نبه بهذا على ثمراته في الدنيا ومعلوم أن الآخرة خير وأبقى وقال صلى الله عليه وسلم خصلتان لا يكونان في منافق حسن سمت وفقه في الدين (5) ولا تشكن في الحديث لنفاق بعض فقهاء الزمان فإنه ما أراد به الفقه الذي ظننته وسيأتي معنى الفقه وأدنى درجات الفقيه أن يعلم أن الآخرة خير من الدنيا", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Contemplation", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'", "badge": "Hadith"}], "2": [{"arabic": "وهو مع ذلك قريب من كل موجود وهو أقرب إلى العبد من حبل الوريد وهو على كل شيء شهيد إذ لا يماثل قربه قرب الأجسام كما لا تماثل ذاته ذات الأجسام وأنه لا يحل في شيء ولا يحل فيه شيء تعالى عن أن يحويه مكان كما تقدس عن أن يحده زمان بل كان قبل أن خلق الزمان والمكان وهو الآن على ما عليه كان وأنه بائن عن خلقه بصفاته ليس في ذاته سواه ولا في سواه ذاته وأنه مقدس عن التغير والانتقال لا تحله الحوادث ولا تعتريه العوارض بل لا يزال في نعوت جلاله منزها عن الزوال وفي صفات كماله مستغنيا عن زيادة الاستكمال وأنه في ذاته معلوم الوجود بالعقول مرئ", "english": "- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 72", "section_title_en": "Section 72", "section_index": 72, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "الأصل الأول العلم بأن صانع العالم قادر وأنه تعالى في قوله وهو على كل شيء قدير صادق لأن العالم محكم في صنعته مرتب في خلقته ومن رأى ثوبا من ديباج حسن النسج والتأليف متناسب التطريز والتطريف ثم توهم صدور نسجه عن ميت لا استطاعة له أو عن إنسان لا قدرة له كان منخلعا عن غريزة العقل ومنخرطا في سلك أهل الغباوة والجهل الأصل الثاني العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك", "english": "**The Eighth Principle: Knowledge that He, Exalted is He, is established upon His Throne (mustawin ʿalā ʿarshihi) in the sense that God, Exalted is He, intended by istiwāʾ — which is the sense that does not contradict the attribute of Majesty, nor does any mark of origination (ḥudūth) or passing away (fanāʾ) attach to it. And it is the sense intended by His saying — istiwāʾ toward the heaven — where He said in the Qur'an: {«ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ وَهِيَ دُخَانٌ»} (\"Then He directed Himself to the heaven, and it was smoke\") [Fussilat 41:11]. And that is only by way of subjugation (qahr) and dominion (istīlāʾ), as the poet said:", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 90", "section_title_en": "The Revival of the Religious Sciences — Section 90: The Ten Principles Concerning Knowledge of the Divine Attributes", "section_index": 90, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denoting the faculty of perception and comprehension; the mark or trace by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from awareness (shiʿr); here, it denotes certain, verified cognition of theological verities.\n- Root: س و ي (s-w-y)\n  * Lisan / Ayn: Root indicating straightness, equality, and levelness; from it derives istiwāʾ (establishing oneself upon, ascending to).\n  * Al-Raghib (Mufradat): Istiwāʾ upon the Throne (al-ʿArsh) is a divine act of sovereign dominion, not corporeal settlement.\n  * Al-Zamakhshari (Asas): Literal sense of physical sitting is impossible for God; metaphorical sense (majāz) of qahr (overpowering) and istīlāʾ (dominion) is necessitated by reason and consensus.\n- Root: ر أ ي (r-ʾ-y)\n  * Lisan / Ayn: Visual perception; also opinion and discernment.\n  * Al-Raghib (Mufradat): Ruʾyah (vision) of God in the Hereafter is a mode of disclosure (kashf) and knowledge (ʿilm), more complete than intellectual cognition, not conditioned by spatial direction.\n  * Al-Zamakhshari (Asas): Literal vision requires corporeality and direction; its application to God demands theological specification (takhṣīṣ) without nullifying the veracity of the scriptural promise.\n- Root: ق د ر (q-d-r)\n  * Lisan / Ayn: Power, measure, decree; the capacity to bring about an act.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is the negation of incapacity (ʿajz); absolute power belongs to God alone, while creatures possess limited capacity.\n  * Al-Zamakhshari (Asas): Literal power over an object; metaphorically, God's power encompasses all things without exertion or instrument.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, applied here to the parsing of \"إلى السماء\" in the verse on istiwāʾ, where the prepositional phrase is delayed to highlight the divine act of sovereign direction toward the heavens.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}, {"arabic": "قال في سوق من الأسواق لا إله إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت وهو على كل شيء قدير كتب الله له ألف ألف حسنة ومحا عنه ألف الف سيئة وبنى له بيتا في الجنة ويروى إن العبد إذا قال لا إله إلا الله أتت إلى صحيفته فلا تمر على خطيئة إلى محتها حتى تجد حسنة مثلها فتجلس إلى جنبها (3) وفي الصحيح عن أيوب عن النبي صلى الله عليه وسلم أنه قال من قال لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير عشر مرات كان كمن أعتق أربعة أنفس من ولد إسماعيل صلى الله عليه وسلم (4) وفي الصحيح أيضا عن عبادة بن الصامت عن النبي صلى الل", "english": "The Prophet, peace be upon him, said: \"The most excellent words that I and the prophets before me have uttered are: There is no god but Allah alone, with no partner.\" (1)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 237", "section_title_en": "The Virtue of the Declaration of Divine Oneness (Fāḍīlat al-Tahlīl)", "section_index": 237, "anchors": "- Root: اله (ʾ-l-h)\n  * Lisan / Ayn: Core root denoting worship, servitude, and the act of deifying; the name \"Allah\" is the specific designation of the True Deity, distinguished from all false objects of worship.\n  * Al-Raghib (Mufradat): \"الله: قيل: أصله إله فحذفت همزته، وأدخل عليها الألف واللام، فخص بالباري تعالى\" — The name is exclusively reserved for the Creator, and \"ilāh\" is that which is worshipped; the declaration \"lā ilāha illā Allāh\" negates all false objects of worship and affirms sole divinity for God.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes true worship and servitude; metaphorical (majāz) usage applies to anything taken as an object of devotion. The tahlīl is the verbal embodiment of sincere worship.\n- Root: شرك (sh-r-k)\n  * Lisan / Ayn: Partnership, sharing, or association; in theological context, the ascription of partners or associates to God in His divinity or worship.\n  * Al-Raghib (Mufradat): \"الشركة والمشاركة: خلط الملكين\" — The mixing of two ownerships; in Kalam, shirk is the association of another with God in that which is exclusively His, namely divinity and worship.\n  * Al-Zamakhshari (Asas): Literal usage denotes partnership in ownership; metaphorical usage in the phrase \"lā sharīka lahu\" (no partner has He) affirms God's exclusive and unshared sovereignty, kingdom, and praise.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness, uniqueness, singularity; the state of being one without peer or equal.\n  * Al-Raghib (Mufradat): Oneness in essence, attributes, and acts; the tahlīl affirms tawḥīd — the absolute unity of God in His divinity, His sole possession of the kingdom, and His exclusive receipt of praise.\n  * Al-Zamakhshari (Asas): Literal usage denotes numerical oneness; theological usage denotes the affirmation of God's unique and incomparable nature, negating all plurality in His essence and attributes.\n- Sibawayh Rule: Rule of Conjunction and Disjunction (al-ʿAṭf wa al-Faṣl) — The phrase \"lā ilāha illā Allāh\" employs the grammatical structure of negation (lā) followed by exception (illā), establishing a complete disjunction between all false deities and the One True God, followed by the conjunction of His exclusive attributes: \"waḥdahu lā sharīka lahu, lahu al-mulku wa lahu al-ḥamdu.\"", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}], "3": [{"arabic": "إلا مسخرون تحت قهره وقدرته مرددون في قبضته وهو الأول والآخر والظاهر والباطن فلما ذكر ذلك في عالم الشهادة استبعد منه ذلك وقيل له كيف يكون هو الأول والاخر وهما وصفان متناقضان وكيف يكون هو الظاهر والباطن فالأول ليس بآخر والظاهر ليس بباطن فقال هو الأول بالإضافة إلى الموجودات إذ صدر منه الكل على ترتيبه واحدا بعد واحد وهو الآخر بالإضافة إلى سير السائرين إليه فإنهم لا يزالون مترقين من منزل إلى منزل إلى أن يقع الانتهاء إلى تلك الحضرة فيكون ذلك آخر السفر فهو آخر في المشاهدة أول في الوجود وهو باطن بالإضافة إلى العاكفين في عالم ال", "english": "...its mover is Power (al-qudrah) without any doubt. So the seeker (al-sālik) journeyed on to the world of Power, and there he beheld wonders before which all that had preceded seemed contemptible. He asked Power concerning the movement of the right hand, and it said: \"I am but an attribute (innamā anā ṣifah) — ask the Powerful One (al-Qādir), for the reliance is upon the described substances (al-mawṣūfāt), not upon the attributes.\" At that point he almost deviated and unleashed the tongue of questioning with audacity, but he was steadied by the firm word (al-qawl al-thābit), and a caller cried out from behind the veils of the pavilions of the Divine Presence: \"He is not asked about what He does, but they shall be asked\" {«لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ»}. Then the awe of the Presence overwhelmed him, and he fell down stricken, convulsing in his swoon. When he regained consciousness, he said: \"Glory be to You — how magnificent is Your majesty! I repent unto You, and I place my trust in You, and I believe that You are the Sovereign, the Compeller, the One, the Subduer. I fear none but You, I hope for none other than You, and I seek refuge only in Your pardon from Your punishment, and in Your good pleasure from Your wrath. I have nothing but to ask of You and to supplicate before You, and to plead humbly in Your presence, saying: 'Expand my breast that I may know You, and loosen the knot from my tongue that I may praise You.'\"", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1111", "section_title_en": "The Unification of the Acts — The Journey of the Seekers to the Oneness of the Agent", "section_index": 1111, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Qadir as the One whose power is absolute and unbounded.\n  * Al-Raghib (Mufradat): Power (qudrah) when ascribed to God is the negation of incapacity ('ajz); when ascribed to man it is a contingent capacity limited by divine ordainment.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — \"He is Qadir, Muqtadir, possessor of power\"; metaphorical (majaz) — \"a far-reaching steed\" (ba'id al-qadr), indicating extension of effect.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness and singularity; al-Wahid as that which has no part whatsoever.\n  * Al-Raghib (Mufradat): True unity (wahdah) is absolute indivisibility; applied to God exclusively in the sense of unique sovereignty.\n  * Al-Zamakhshari (Asas): \"He is one (wahid), and they are singular (wuhdan)\"; literal unity versus numerical oneness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as perception of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): Knowledge ('ilm) is the apprehension of a thing in its true reality — either grasping the essence or judging its attributes.\n  * Al-Zamakhshari (Asas): Literal — \"I knew not of your news\" (ma 'alimtu bi-khabarika); the knower as one marked by discernment.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā anā ṣifah\" (I am but an attribute) restricts the speaker's essence to being a mere accident, redirecting inquiry to the substantive subject (al-mawṣūf).", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Monotheism and Reliance'", "badge": "Dhikr"}, {"arabic": "لا يقضى عليه بالانقضاء والانفصال بتصرم الآباد وانقراض الآجال بن هو الأول والآخر والظاهر والباطن وهو بكل شيء عليم التنزيه وأنه ليس بجسم مصور ولا جوهر محدود مقدر وأنه لا يماثل والأجسام ولا في التقدير ولا في قبول الانقسام وأنه ليس بجوهر ولا تحله الجواهر ولا بعرض ولا تحله الأعراض بل لا يماثل موجودا ولا يماثله موجود ليس كمثله شيء ولا هو مثل شيء وأنه لا يحده المقدار ولا تحويه الأقطار ولا تحيط به الجهات ولا تكتنفه الأرضون ولا السموات وأنه مستو على العرش على الوجه الذي قاله وبالمعنى الذي أراده استواء منزها عن المماسة والاستقرار والتمكن والحلول والانتقال لا يحمله العرش ب", "english": "- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.", "book_title": "Foundations of Belief", "section_title_ar": "Section 72", "section_title_en": "Section 72", "section_index": 72, "anchors": "*(Anchors established)*", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Foundations of Belief'", "badge": "Commentary"}, {"arabic": "الأول والآخر والظاهر والباطن وهو بكل شيء عليم التنزيه وأنه ليس بجسم مصور ولا جوهر محدود مقدر وأنه لا يماثل والأجسام ولا في التقدير ولا في قبول الانقسام وأنه ليس بجوهر ولا تحله الجواهر ولا بعرض ولا تحله الأعراض بل لا يماثل موجودا ولا يماثله موجود ليس كمثله شيء ولا هو مثل شيء وأنه لا يحده المقدار ولا تحويه الأقطار ولا تحيط به الجهات ولا تكتنفه الأرضون ولا السموات وأنه مستو على العرش على الوجه الذي قاله وبالمعنى الذي أراده استواء منزها عن المماسة والاستقرار والتمكن والحلول وال", "english": "- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.", "book_title": "Foundations of Belief", "section_title_ar": "Section 72", "section_title_en": "Section 72", "section_index": 72, "anchors": "*(Anchors established)*", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Foundations of Belief'", "badge": "Commentary"}], "4": [{"arabic": "الأرض وما يخرج منها وما ينزل من السماء وما يعرج فيها ومن فتن الليل والنهار ومن طوارق الليل والنهار إلا طارقا يطرق بخير يا رحمن فقال ذلك فطفئت شعلته وخر على وجهه (1) وقال الحسن نبئت أن جبرائيل عليه السلام أتى النبي صلى الله عليه وسلم فقال إن عفريتا من الجن يكيدك فإذا أويت إلى فراشك فاقرأ آية الكرسي // حديث الحسن نبئت أن جبريل أتى النبي صلى الله عليه وسلم فقال إن عفريتا من الجن يكيدك الحديث أخرجه ابن أبي الدنيا في مكايد الشيطان هكذا مرسلا وقال صلى الله عليه وسلم أتاني الشيطان فنازعني ثم نازع", "english": "If you say: \"What then is the remedy for repelling Satan, and is the remembrance of God—exalted is He—and one's saying 'There is no might and no power except through God' (lā ḥawla wa lā quwwata illā billāh) sufficient for that?\" — Know that the remedy of the heart in this matter is to seal these entry points by purifying the heart of these blameworthy traits. And that is something whose full exposition would be lengthy; our purpose in this quarter of the book is to explain the remedy for the destructive traits (al-ṣifāt al-muhlikāt), and each trait requires a separate book, as will be explained later. Yes — when the roots of these traits are severed from the heart, Satan may still make incursions (ijtiyāzāt) and pass through it with fleeting thoughts (khaṭarāt), but he has no stability therein. And what prevents him from passing through is the remembrance of God—exalted is He—because the reality of dhikr cannot take firm hold of the heart except after the heart is built up with God-consciousness (taqwā) and purified of blameworthy traits. Otherwise, the dhikr is but the whisper of the self (ḥadīth nafs), having no authority over the heart, and so it does not repel the dominion of Satan. For this reason, God—exalted is He—said: {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ} \"Indeed, those who fear God — when an impulse touches them from Satan, they remember [Him], and at once they are insightful\" (Q 7:201). He specified thereby the God-fearing (muttaqī).", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 603", "section_title_en": "The Revival of the Religious Sciences — Section 603: On the Remedy for Evil Presumption and the Repelling of Satan", "section_index": 603, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or being consumed by fire; also used for one who is destroyed or whose blood is shed in vain.\n  * Al-Raghib (Mufradat): الشيطان (Satan) — the one who is far removed from divine mercy, derived from the root indicating his being burned or destroyed.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط اللحم\" — meat that is burnt or spoiled by fire. Metaphorical (Majaz): \"شاط دمه\" — his blood was shed in vain (i.e., destroyed); \"أشاط السلطان دمه\" — the ruler declared his blood lawful to shed. Thus, Satan is so named for his being \"burned\" or \"destroyed\" by divine curse, and for his causing others to be destroyed.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; also the act of turning, overturning, or revolving a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning and directing of a thing from one aspect to another. The heart (qalb) is so named for its constant fluctuation and turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems. The heart's \"suwaydāʾ\" (core/blackness) is its innermost center where Satan seeks to establish his seat.\n- Root: ذكر (Dhikr)\n  * Lisan / Ayn: Remembrance, mention, recollection; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): الذكر is the presence of a thing in the mind, whether by utterance or by heart; true dhikr is that which takes root in the heart, not mere speech of the tongue.\n  * Al-Zamakhshari (Asas): Literal: uttering with the tongue. Metaphorical: the heart's presence with God, which alone has authority over the soul and repels Satan's incursions.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The verse {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا} restricts the efficacy of dhikr in repelling Satan to the God-fearing (muttaqūn), whose hearts are emptied of passions, thereby specifying the condition for its effectiveness.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}, {"arabic": "أعوذ بكلمات الله التامات التي لا يجاوزهن بر ولا فاجر من شر ما يلج في الأرض وما يخرج منها وما ينزل من السماء وما يعرج فيها ومن فتن الليل والنهار ومن طوارق الليل والنهار إلا طارقا يطرق بخير يا رحمن فقال ذلك فطفئت شعلته وخر على وجهه (1) وقال الحسن نبئت أن جبرائيل عليه السلام أتى النبي صلى الله عليه وسلم فقال إن عفريتا من الجن يكيدك فإذا أويت إلى فراشك فاقرأ آية الكرسي // حديث الحسن نبئت أن جبريل أتى النبي صلى الله عليه وسلم فقال إن عفريتا من الجن يكيدك الحديث أخرجه ابن أبي الدنيا في مكايد الشيطان هكذا مرسلا وقال صلى الله عليه وسلم أتاني الشيطان فنازعني ثم نازعني فأخذت", "english": "If you say: \"What then is the remedy for repelling Satan, and is the remembrance of God—exalted is He—and one's saying 'There is no might and no power except through God' (lā ḥawla wa lā quwwata illā billāh) sufficient for that?\" — Know that the remedy of the heart in this matter is to seal these entry points by purifying the heart of these blameworthy traits. And that is something whose full exposition would be lengthy; our purpose in this quarter of the book is to explain the remedy for the destructive traits (al-ṣifāt al-muhlikāt), and each trait requires a separate book, as will be explained later. Yes — when the roots of these traits are severed from the heart, Satan may still make incursions (ijtiyāzāt) and pass through it with fleeting thoughts (khaṭarāt), but he has no stability therein. And what prevents him from passing through is the remembrance of God—exalted is He—because the reality of dhikr cannot take firm hold of the heart except after the heart is built up with God-consciousness (taqwā) and purified of blameworthy traits. Otherwise, the dhikr is but the whisper of the self (ḥadīth nafs), having no authority over the heart, and so it does not repel the dominion of Satan. For this reason, God—exalted is He—said: {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ} \"Indeed, those who fear God — when an impulse touches them from Satan, they remember [Him], and at once they are insightful\" (Q 7:201). He specified thereby the God-fearing (muttaqī).", "book_title": "Disciplining the Soul", "section_title_ar": "Section 603", "section_title_en": "The Revival of the Religious Sciences — Section 603: On the Remedy for Evil Presumption and the Repelling of Satan", "section_index": 603, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or being consumed by fire; also used for one who is destroyed or whose blood is shed in vain.\n  * Al-Raghib (Mufradat): الشيطان (Satan) — the one who is far removed from divine mercy, derived from the root indicating his being burned or destroyed.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط اللحم\" — meat that is burnt or spoiled by fire. Metaphorical (Majaz): \"شاط دمه\" — his blood was shed in vain (i.e., destroyed); \"أشاط السلطان دمه\" — the ruler declared his blood lawful to shed. Thus, Satan is so named for his being \"burned\" or \"destroyed\" by divine curse, and for his causing others to be destroyed.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; also the act of turning, overturning, or revolving a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning and directing of a thing from one aspect to another. The heart (qalb) is so named for its constant fluctuation and turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems. The heart's \"suwaydāʾ\" (core/blackness) is its innermost center where Satan seeks to establish his seat.\n- Root: ذكر (Dhikr)\n  * Lisan / Ayn: Remembrance, mention, recollection; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): الذكر is the presence of a thing in the mind, whether by utterance or by heart; true dhikr is that which takes root in the heart, not mere speech of the tongue.\n  * Al-Zamakhshari (Asas): Literal: uttering with the tongue. Metaphorical: the heart's presence with God, which alone has authority over the soul and repels Satan's incursions.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The verse {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا} restricts the efficacy of dhikr in repelling Satan to the God-fearing (muttaqūn), whose hearts are emptied of passions, thereby specifying the condition for its effectiveness.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Disciplining the Soul'", "badge": "Hadith"}], "9": [{"arabic": "{يخرجهم من الظلمات إلى النور} وقال صلى الله عليه وسلم يا أيها الناس اعقلوا عن ربكم وتواصوا بالعقل تعرفوا ما أمرتم به وما نهيتم عنه واعلموا أنه ينجدكم عند ربكم واعلموا أن العاقل من أطاع الله وإن كان دميم المنظر حقير الخطر دنيء المنزلة رث الهيئة وأن الجاهل من عصى الله تعالى وإن كان جميل المنظر عظيم الخطر شريف المنزلة حسن الهيئة فصيحا نطوقا فالقردة والخنازير أعقل عند الله تعالى ممن عصاه ولا تغتر بتعظيم أهل الدنيا إياهم فإنهم من الخاسرين (2) وقال صلى الله عليه وسلم أول ما خل", "english": "The Book of Seclusion ('Uzlah) — its explanation, God Most High willing. For this reason, Yūsuf ibn Asbāṭ wrote to Ḥudhayfah al-Marʿashī: \"What is your opinion of one who remains, finding no one with whom to remember God Most High except that he is either sinful, or his remembrance in company is itself an act of disobedience — and that because he finds no one of his own kind?\" And indeed he spoke truly, for mixing with people is never free from backbiting (ghībah), or listening to backbiting, or remaining silent upon wrongdoing (munkar). And the best of his states is that he either imparts knowledge or acquires it. Yet were this poor wretch to reflect, and to know that his imparting of knowledge is never free from the taints of ostentation (riyā'), the seeking of followers, and the desire for leadership (ri'āsah), he would know that the one who acquires knowledge from him only seeks to make it an instrument for pursuing the world and a means toward evil — so that the teacher becomes his helper therein, his support and his backer, preparing its causes for him, like one who sells a sword to a highway robber. For knowledge is like the sword: its soundness for good is like the soundness of the sword for warfare. And for this reason, it is not permitted to sell it to one whom one knows, by the indications of his circumstances, intends to use it to aid in cutting off the road.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 65", "section_title_en": "The Book of Seclusion ('Uzlah) — Section 65, and The Seventh Book: On the Intellect, Its Nobility, Its Reality, and Its Divisions", "section_index": 65, "anchors": "- Root: عقل (ʿaql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back; the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — The intellect is said of the faculty prepared for the reception of knowledge, and it is also said of the knowledge which man acquires by means of that faculty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): intellectual apprehension and understanding. Metaphorical (Majaz): \"نخلة لا تعقل الإبار\" — a palm tree that does not accept pollination, i.e., does not grasp or take in.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge as the mark or sign by which a thing is known; the trace or landmark that guides.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — Knowledge is the apprehension of a thing in its true reality; it is of two kinds: apprehension of the essence of a thing, and judgment upon a thing regarding what exists for it or is negated of it.\n  * Al-Zamakhshari (Asas): Literal: certain awareness. Metaphorical: \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge; knowledge as a guiding landmark (maʿlam).\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; the first to set up beacons (manār) on his path in his campaigns to guide his return.\n  * Al-Raghib (Mufradat): \"النور: الضوء المنتشر الذي يعين على الإبصار\" — Light is the diffused radiance that aids vision; it is of two kinds: that perceived by the eye of inner insight (baṣīrah) — such as the light of the intellect and the light of the Qur'an — and that perceived by the eye of the head, such as the celestial bodies.\n  * Al-Zamakhshari (Asas): Literal: illumination. Metaphorical: \"نور الأمر: بينه\" — he illuminated the matter: he made it clear; \"وهذا أنور من ذاك: أبين\" — this is more luminous than that: more evident.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the exclusive attribution of a predicate to a subject, as in the author's restriction of the scholar's condition to one of two men, and the exclusion of the third.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Condemnation of Delusion'", "badge": "Dhikr"}], "10": [{"arabic": "منكم والذين أوتوا العلم درجات وقال تعالى لا يستوي منكم من أنفق من قبل الفتح وقاتل الآية وقد قال تعالى هم درجات عند الله وقال صلى الله عليه وسلم الإيمان عريان ولباسه التقوى (1) الحديث وقال صلى الله عليه وسلم الإيمان بضع وسبعون بابا أدناها إماطة الأذى عن الطريق فهذا ما يدل على ارتباط كمال الإيمان بالأعمال وأما ارتباطه بالبراءة عن النفاق والشرك الخفي فقوله صلى الله عليه وسلم أربع من كن فيه فهو منافق خالص وإن صام وصلى وزعم أنه مؤمن من إذا حدث كذب وإذا وعد أخلف وإذا اؤتمن خان وإذا خاصم فجر (2) وفي بعض الروايات وإذا عاهد غدر وفي حدي", "english": "...doubt concerning this truthfulness. Likewise, God Most High said: {«But righteousness is he who believes in God and the Last Day and the angels and the Book and the prophets»} (2:177) — thus He conditioned twenty attributes, such as faithfulness to covenant and patience under hardship. Then He said Most High: {«Those are the truthful ones»} (2:177). And God Most High said: {«God will raise those who have believed among you and those who have been given knowledge, by degrees»} (58:11). And He said Most High: {«Not equal among you are those who spent before the conquest and fought»} (57:10). And He said Most High: {«They are degrees before God»} (3:163). And the Prophet, peace be upon him, said: \"Faith is naked, and its garment is God-consciousness (al-taqwā).\" And the Prophet, peace be upon him, said: \"Faith has seventy-some branches; the lowest of them is removing harm from the path.\" All this indicates the interconnection of the perfection of faith with works.", "book_title": "Foundations of Belief", "section_title_ar": "Section 104", "section_title_en": "The Revival of the Religious Sciences — Book of the Secrets of Zakāh, Section 104: On the Degrees of Faith and Its Connection to Works, and the Hidden Hypocrisy (al-Nifāq al-Khafī) That Contradicts the Perfection of Faith", "section_index": 104, "anchors": "- Root: ن ف ق (N-F-Q)\n  * Lisan / Ayn: Root denotes passing away, depletion, and expenditure; also the underground burrow of the jerboa (nāfiqāʾ) with a concealed exit — the etymological basis for hypocrisy as a hidden exit from faith.\n  * Al-Raghib (Mufradat): \"نفق الشيء: مضى ونفد\" — theological nuance: hypocrisy (nifāq) is that which causes faith to expire and pass away, whether by sale (worldly gain) or by death (spiritual ruin).\n  * Al-Zamakhshari (Asas): Literal: \"نفقت الدراهم\" (coins ran out). Metaphorical: \"نفق روحه: خرج\" (his soul expired and went forth) — hence the hypocrite's faith is one whose spirit has already departed.\n- Root: أ ي م (A-Y-M)\n  * Lisan / Ayn: A woman without a husband; a man long unmarried. Al-Raghib: \"الحرب مأيمة\" — war makes women widows.\n  * Al-Zamakhshari (Asas): Literal: \"تركوا النساء أيامى\" (they left women widowed). Metaphorical application: the one who feels secure from hypocrisy is like one who claims immunity from widowhood — a false security.\n- Root: و ف ي (W-F-Y)\n  * Lisan / Ayn: Fullness, completion, fulfillment of a measure or covenant.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — the one who has reached completion. \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — to fulfill the covenant without breach.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" (a full-weight dirham). Metaphorical: \"أوفى على المائة\" (he surpassed a hundred) — faith's perfection (wafāʾ) is only attained by surpassing mere profession to include works and inward sincerity.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the grammatical force of \"إنما\" constructions and conditional clauses (من كان...), where the predicate is restricted to the condition stated, as in the hadith \"أربع من كن فيه فهو منافق خالص\" — the four traits are exhaustive of the ruling.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}, {"arabic": "من أعوان الشهوات فهو من الذين أوتوا العلم وكلا وعد الله الحسنى والذي يقتضي الإيمان بهذا الأمر في القرآن والسنة وأقاويل العلماء أكثر من أن يحصر قال الله تعالى ونهى النفس عن الهوى فإن الجنة هي المأوى وقال تعالى أولئك الذين امتحن الله قلوبهم للتقوى قيل نزع منها محبة الشهوات وقال صلى الله عليه وسلم المؤمن بين خمس شدائد مؤمن يحسده ومنافق يبغضه وكافر يقاتله وشيطان يضله ونفس تنازعه (1) فبين أن النفس عدو منازع يجب عليه مجاهدتها ويروى أن الله تعالى أوحى إلى داود عليه السلام يا داود حذر وأنذر أصحابك أكل الشهوات فإن ال", "english": "But if you are incapable of that, then it behooves you not to let slip the affirmation of truth (taṣdīq) and faith (īmān) by way of receptive acceptance (talqqī) and emulation (taqlīd) of one who deserves to be emulated. For faith has a degree, just as knowledge has a degree; and knowledge is attained after faith, and it lies beyond it. God, the Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, by degrees.\" So whoever affirms as true that opposing the desires (mukhālafat al-shahawāt) is the road to God, the Mighty and Majestic, yet has not been apprised of its cause and its secret — he is among those who believe. And when he is apprised of what we have mentioned concerning the helpers of the desires, he is among those who have been given knowledge. And to both has God promised the goodly reward.", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 627", "section_title_en": "Section 627 — The Path of Opposition to the Desires: On the Consensus of the Scholars that There Is No Road to the Happiness of the Hereafter Save through Restraining the Soul from Caprice", "section_index": 627, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit; that which breathes; the animating principle; also blood, and the \"evil eye\" (nafs sā'ilah)\n  * Al-Raghib (Mufradat): النفس: الروح — the soul as the spiritual reality; in the verse {«ويحذركم الله نفسه»} it denotes the very Essence (al-dhāt); the soul is that which must be disciplined and opposed in its caprice (hawā)\n  * Al-Zamakhshari (Asas): Literal: the self that desires and inclines; Metaphorical: \"دفق نفسه\" — he poured out his blood/life; the soul as the internal adversary that must be fought (jihād al-nafs)\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; to turn over, to transform, to fluctuate; the heart as that which is constantly turning between states\n  * Al-Raghib (Mufradat): قلب الشيء: تصريفه وصرفه عن وجه إلى وجه — the heart is so named because of its constant turning and fluctuation between conditions; the seat of spiritual perception and disease\n  * Al-Zamakhshari (Asas): Literal: to turn something over; Metaphorical: the heart as the organ of spiritual understanding that can be veiled (maḥjūbah) from God by attachment to desires\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: To be near, proximity; the world (al-dunyā) as that which is nearer/lower\n  * Al-Raghib (Mufradat): الدنو: القرب بالذات أو بالحكم — proximity by essence or by judgment; the world as the nearer realm that veils from the distant (al-ākhirah)\n  * Al-Zamakhshari (Asas): Literal: closeness; Metaphorical: the lower world as that which is \"near\" and thus preoccupies the heart from what is higher\n- Root: أكل (a-k-l)\n  * Lisan / Ayn: To eat, consume; also to possess and enjoy\n  * Al-Raghib (Mufradat): Eating as the most fundamental desire; the restriction of food (qillat al-ṭa'ām) as the first pillar of spiritual discipline (riyāḍah)\n  * Al-Zamakhshari (Asas): Literal: consumption of food; Metaphorical: \"أكل الشهوات\" — the devouring of desires as that which veils the intellect from God\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic sentence structure in which the author interposes explanatory clauses between the subject and its predicate, as in \"فإنه لو تمتع بشيء منه أنس به وألفه\" where the conditional clause governs the entire following apodosis, requiring careful tracking of the protasis-apodosis relationship through extended digressions.\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "11": [{"arabic": "بعبادة القرض فقال من ذا الذي يقرض الله قرضا حسنا فإن قلت قولك إن بقاء النسل والنفس محبوب يوهم أن فناءها مكروه عند الله وهو فرق بين الموت والحياة بالإضافة إلى إرادة الله تعالى ومعلوم أن الكل بمشيئة الله وأن الله غني عن العالمين فمن أين يتميز عنده موتهم عن حياتهم أو بقاؤهم عن فنائهم فأعلم أن هذه الكلمة حق أريد بها باطل فإن ما ذكرناه لا ينافي إضافة الكائنات كلها إلى إرادة الله خيرها وشرها ونفعها وضرها ولكن المحبة والكراهية يتضادان وكلاهما لا يضادان الإرادة فرب مراد مكروه ورب مراد محبوب فالمعاصي مكروهة و", "english": "وقال صلى الله عليه وسلم: \"لا يلقى الله أحد بذنب أعظم من جهالة أهله.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 296", "section_title_en": "Section 296", "section_index": 296, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "12": [{"arabic": "إلى لقاء الله تعالى إلا بأنوارهم قال الله تعالى يسعى نورهم بين أيديهم وبأيمانهم وقد روي في الخبر أن بعضهم يعطى نورا مثل الجبل وبعضهم أصغر حتى يكون آخرهم رجلا يعطى نورا على إبهام قدميه فيضيء مرة وينطفيء أخرى فإذا أضاء قدم قدميه فمشى وإذا طفيء قام ومرورهم على الصراط على قدر نورهم فمنهم من يمر كطرف العين ومنهم من يمر كالبرق ومنهم من يمر كالسحاب ومنه من يمر كانقضاض الكواكب ومنهم من يمر كالفرس إذا اشتد في ميدانه والذي أعطي نورا على إبهام قدمه يحبوحبوا على وجهه ويديه ورجليه يجر يدا ويعلق أخرى ويصيب جوانبه النار فلا يزال كذلك حتى ي", "english": "The hadith — and in it he said: \"And what are the mufarridūn (المفردون)?\" He said: \"Those who remember God much, both men and women.\" Al-Hakim narrated it with the wording: \"He said: 'Those who are engrossed in the remembrance of God.'\" And he declared it sound upon the condition of the two Shaykhs (al-Shaykhayn). Al-Bayhaqi added in al-Shuʿab: \"Remembrance lifts their burdens from them, and they come on the Day of Resurrection light.\" Al-Tabarani narrated it thus in al-Muʿjam al-Kabīr from the hadith of Abu al-Darda', without the addition that the author mentioned at its end — and both are weak in their chain of transmission.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 592", "section_title_en": "The Clarification of the Difference Between the Two Stations by a Perceptible Example", "section_index": 592, "anchors": "- Root: وحد (wḥd)\n  * Lisan / Ayn: Core meaning of singularity, solitude, and being alone; al-mufrad (المفرد) is the one who is isolated or unique.\n  * Al-Raghib (Mufradat): In theological usage, refers to the state of devotional solitude or the unique devotion of the heart to God, often through remembrance (dhikr).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) sense is \"one who is alone\"; metaphorical (Majaz) sense in this prophetic context denotes those who are \"absorbed\" or \"engrossed\" in the remembrance of God, to the exclusion of all else.\n- Root: جلى (jly)\n  * Lisan / Ayn: To polish, burnish, or make manifest; to clear away rust or impurity from a surface.\n  * Al-Raghib (Mufradat): The act of purification of the heart (tajliyat al-qalb) as a spiritual operation that unveils the divine realities (jaliyyat al-ḥaqq).\n  * Al-Zamakhshari (Asas): Literal sense is the physical polishing of a mirror or blade; metaphorical sense is the purification of the inner self to receive divine illumination.\n- Root: نور (nwr)\n  * Lisan / Ayn: Light, radiance, illumination; that by which things become visible.\n  * Al-Raghib (Mufradat): In Kalam, light (nūr) is the metaphysical illumination of knowledge and faith (maʿrifah and īmān) by which the believer perceives the unseen and is guided on the Path (ṣirāṭ).\n  * Al-Zamakhshari (Asas): Literal light is physical luminosity; metaphorical light is the spiritual illumination granted to the believers, varying in intensity according to their degrees of knowledge and faith.\n- Sibawayh Rule: Rule of Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — The separation between the prepositional phrase and its governed noun is permissible when the intervening clause is complete and independently meaningful, as in the structure \"فإذا بجانبهم يتلألأ\" where the sudden discovery clause (fājā'ah) interrupts the expected sequence for rhetorical emphasis.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}], "13": [{"arabic": "بتمامه وقوله تعالى {انظرونا نقتبس من نوركم قيل ارجعوا وراءكم فالتمسوا نورا} يدل على أن الأنوار لابد وأن يتزود أصلها في الدنيا ثم يزداد في الآخرة إشراقا فأما أن يتجدد نور فلا والحكم في هذا برجم الظنون مخطر ولم ينكشف لنا فيه بعد ما يوثق به فنسأل الله تعالى أن يزيدنا علما ورشدا ويرينا الحق حقا فهذا القدر من أنوار البصائر كاشف لحقائق الشوق ومعانيه وأما شواهد الأخبار والآثار فأكثر من أن تحصى فمما اشتهر من دعاء رسول الله صلى الله عليه وسلم أنه كان يقول اللهم إني أسألك الرضا بعد القضاء وبرد العيش بعد الموت ولذة النظر إلى وجهك الك", "english": "And His saying, Glorified and Exalted is He: {نُورُهُمْ يَسْعَىٰ بَيْنَ أَيْدِيهِمْ وَبِأَيْمَانِهِمْ يَقُولُونَ رَبَّنَا أَتْمِمْ لَنَا نُورَنَا} [\"Their light will run before them and on their right hands; they will say, 'Our Lord, perfect for us our light'\"] (Q 66:8) — this is susceptible to the meaning that He bestows upon them the perfection of light whenever they had provisioned from the world the origin of light. And it is also susceptible that the intended meaning is the perfection of light in what was not illuminated in this world with an illumination that stands in need of further completion and radiance — so that this is what is meant by its perfection. And His saying, Exalted is He: {انْظُرُونَا نَقْتَبِسْ مِنْ نُورِكُمْ قِيلَ ارْجِعُوا وَرَاءَكُمْ فَالْتَمِسُوا نُورًا} [\"Look upon us so we may borrow from your light. It will be said, 'Return behind you and seek light'\"] (Q 57:13) — this indicates that the lights must have their origin provisioned in this world, then in the Hereafter they increase in radiance. But as for a light being newly generated [there without prior origin] — no. And the judgment in this matter is a venture of conjecture, perilous, and there has not been unveiled to us therein anything trustworthy. So we ask God, Exalted is He, to increase us in knowledge and right guidance, and to show us the truth as truth.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1171", "section_title_en": "On the Ever-Replenished Delights of the Hereafter and the Yearning (Shawq) for the Divine Vision", "section_index": 1171, "anchors": "- Root: لذذ (Ladhdhah — Pleasure/Delight)\n  * Lisan / Ayn: Core root denotes the sweetness of taste and the experience of sensory gratification; its verbal form (ladhdha) implies direct apprehension of what is agreeable.\n  * Al-Raghib (Mufradat): In theological usage, true pleasure (al-ladhdhah al-ʿuẓmā) is the soul's perception of what is conformable to its nature — the highest being the vision of God (ru'yat Allāh) and the bliss of proximity to Him.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for sensory delight; metaphorical (majāz) for intellectual and spiritual joys, where the \"taste\" is of gnosis (maʿrifah), not of the palate.\n\n- Root: شوق (Shawq — Yearning/Longing)\n  * Lisan / Ayn: The root signifies the soul's restless inclination toward a beloved; the \"spurring on\" of the heart toward reunion.\n  * Al-Raghib (Mufradat): Shawq is the movement of the heart toward its ultimate Beloved (al-maḥbūb al-aʿlā) — a yearning that persists even in bliss, for the unveiling (kashf) of ever-greater divine self-disclosure.\n  * Al-Zamakhshari (Asas): Literal for human longing; metaphorical for the divine \"yearning\" attributed to God (as in the sacred reports), which is an expression of His loving acceptance and bestowal of grace, not an emotional lack.\n\n- Root: نور (Nūr — Light)\n  * Lisan / Ayn: Core root denotes illumination, radiance, and that by which one sees and is seen.\n  * Al-Raghib (Mufradat): Twofold: sensory light (of the sun, stars) and intellectual/spiritual light (of reason, faith, and the Qur'an). The \"light of the believers\" on the Day of Resurrection is the latter — the radiance of their faith and works in the world.\n  * Al-Zamakhshari (Asas): Literal for physical luminosity; metaphorical (majāz) for guidance, clarity, and the illuminating power of divine truth in the heart.\n\n- Root: قلب (Qalb — Heart)\n  * Lisan / Ayn: Core root means to turn over, to flip, to transform — hence the heart is so-named for its constant fluctuation (taqallub) of states.\n  * Al-Raghib (Mufradat): The heart is the seat of perception and understanding (al-ʿaql wa al-fahm); it is the subtle divine reality (al-laṭīfah al-rabbāniyyah) that apprehends God, not the physical organ.\n  * Al-Zamakhshari (Asas): Literal for the physical organ; metaphorical for the spiritual faculty of cognition and volition that turns toward or away from God.\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the precise scope of statements like \"the pleasure of what is renewed is only a distraction from the ache of yearning,\" ensuring the predicate is confined to the subject without overextension.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Love, Longing, Intimacy and Contentment'", "badge": "Du'a"}], "14": [{"arabic": "وتربصتم قال بالتوبة وارتبتم قال شككتم حتى جاء أمر الله قال الموت وغركم بالله الغرور قال الشيطان وقال الحسن تصبروا وتشددوا فإنما هي أيام قلائل وإنما أنتم ركب وقوف يوشك أن يدعى الرجل منكم فيجيب ولا يلتفت فانتقلوا بصالح ما بحضرتكم وقال ابن مسعود ما منكم من أحد أصبح إلا وهو ضيف وما له عارية والضيف مرتحل والعارية مؤداة وقال أبو عبيدة الباجي دخلنا على الحسن في مرضه الذي مات فيه فقال مرحبا بكم وأهلا حياكم الله بالسلام وأحلنا وإياكم دار المقام هذه علانية حسنة إن صبرتم وصدقتم واتقيتم فلا يكن حظكم من هذا ال", "english": "I say: The hadith was transmitted by al-Tirmidhi and deemed sound (ḥasan) from the narration of Ubayy ibn Kaʿb (5): a hadith that when he (the Prophet, peace be upon him) sensed from his companions heedlessness or negligence, he would call out to them in a raised voice: \"Death has come upon you.\" This hadith was transmitted by Ibn Abi al-Dunya in *Qaṣr al-Amal* from the narration of Zayd al-Sulaymi as a mursal report (6). The hadith of Abu Hurayrah: \"I am the warner, death is the transformer, and the Hour is the appointed meeting\" — transmitted by Ibn Abi al-Dunya in *Qaṣr al-Amal* and by Abu al-Qasim al-Baghawi with an isnad containing some weakness (7). The hadith of Ibn ʿUmar: \"The Messenger of God, peace be upon him, went out while the sun was at the tips of the palm fronds and said: 'What remains of this world is but like what remains of this day of ours, relative to what has passed of it'\" — transmitted by Ibn Abi al-Dunya therein with a sound isnad, and al-Tirmidhi transmitted something similar from the narration of Abu Saʿid and deemed it sound (8). The hadith: \"The likeness of this world is like a garment torn from its beginning to its end\" — transmitted by Ibn Abi al-Dunya therein from the narration of Anas, but it is not authentic (9). Ibn Masʿud, may God be pleased with him, said: The Messenger of God, peace be upon him, recited: {فمن يرد الله أن يهديه يشرح صدره للإسلام} \"Whomsoever God wishes to guide, He expands his breast to Islam\" {فقال} \"Then he said: 'When the light enters the breast, it expands.' It was said: 'O Messenger of God, is there a sign of this that is recognized?' PageV04P459 {قال} He said: 'Yes: withdrawal from the abode of delusion, turning in repentance to the abode of permanence, and preparation for death before its descent.'\" Al-Suddi said concerning His saying: {الذي خلق الموت والحياة ليبلوكم أيكم أحسن عملا} \"He who created death and life to test you, which of you is best in deed\" — meaning: which of you is most mindful of death, best prepared for it, and most fearful and cautious of it. Hudhayfah said: \"There is no morning or evening except that a caller calls out: 'O people, the departure! The departure!'\" The confirmation of that is His saying, the Exalted: {إنها لإحدى الكبر * نذيرا للبشر * لمن شاء منكم أن يتقدم أو يتأخر} \"Indeed, it is one of the greatest calamities, a warning to mankind, for whoever among you wishes to advance or delay\" — regarding death. Suhaym, the freed slave of Banu Tamim, said: I sat with ʿAmir ibn ʿAbd Allah while he was praying, and he shortened his prayer, then turned to me and said: \"Relieve me of your need, for I am hastening.\" I said: \"What are you hastening for?\" He said: \"The angel of death, may God have mercy on you.\" He said: So I rose from him, and he returned to his prayer. Dawud al-Ta'i passed by, and a man asked him about a hadith, so he said: \"Leave me, for I am only hastening against the departure of my soul.\" ʿUmar, may God be pleased with him, said: \"Deliberation is good in everything except in deeds of goodness for the Hereafter.\" Al-Mundhir said: I heard Malik ibn Dinar saying to himself: \"Woe to you, hasten before the matter comes upon you. Woe to you, hasten before the matter comes upon you\" — repeating that sixty times, while I heard him and he did not see me. Al-Hasan used to say in his exhortation: \"Hasten, hasten! For it is but breaths — if they are held back, your deeds by which you draw near to God, the Mighty and Majestic, are cut off. May God have mercy on a man who looked to his own soul and wept over the number of his sins.\" Then he recited this verse: {إنما نعد لهم عدا} \"We only count for them a counting\" — meaning the breaths. The end of the counting is the departure of your soul; the end of the counting is the parting from your family; the end of the counting is your entry into your grave. Abu Musa al-Ashʿari strove with intense exertion before his death, and it was said to him: \"Would you not hold back, or show yourself some gentleness?\" He said: \"When horses are released and approach the end of their course, they bring out all that they have. What remains of my term is less than that.\" He said: He continued in that state until he died. And he used to say to his wife: \"Tighten your saddle, for there is no crossing over Hellfire.\" One of the caliphs said from his pulpit: \"O servants of God, fear God as much as you are able, and be a people who were called out to, so they awoke, and knew that this world is not for them a permanent abode, so they exchanged it, and prepared for death, for it has overshadowed you. And depart, for the journey has become urgent for you. Indeed, a goal that the moment diminishes and the hour demolishes is worthy of a short duration. Indeed, an absent one whom the two new ones — night and day — hasten is deserving of a swift return. Indeed, an arrival that resolves in triumph or misery is worthy of the best provision. So let him meet his Lord — whoever advises his own soul, presents his repentance, and overcomes his desire — for his term is concealed from him, his hope deceives him, and Satan is entrusted to him, promising him repentance to postpone it, and beautifying disobedience to him to commit it, until his death descends upon him when he is most heedless of it. Indeed, between each of you and Paradise or Hellfire is nothing but death, that it should alight upon him. So what a regret for one who is heedless, or whose life is a proof against him, and whose days lead him to misery. May God make us and you among those whom prosperity does not make insolent, whom disobedience does not hold back from obedience to God, and upon whom regret does not alight after death. Indeed, He is Hearing of supplication, and in His hand is goodness always, and He does what He wills.\" Some of the exegetes said concerning His saying, the Exalted: {فتنتم أنفسكم} \"You tried yourselves\" — meaning: with desires and pleasures; {وتربصتم} \"and you waited\" — meaning: for repentance; {وارتبتم} \"and you doubted\" — meaning: you were skeptical, until the command of God came — meaning: death; {وغركم بالله الغرور} \"and the deluder deluded you concerning God\" — meaning: Satan. Al-Hasan said: \"Be patient and be firm, for it is but a few days, and you are but a standing caravan — soon one of you will be called, and he will respond without turning back. So move on with the righteous deeds that are in your possession.\" Ibn Masʿud said: \"There is none of you who wakes up except that he is a guest, and what he has is a loan. The guest departs, and the loan is returned.\" Abu ʿUbaydah al-Baji said: We entered upon al-Hasan in his illness from which he died, and he said: \"Welcome to you, and greetings. May God greet you with peace, and settle us and you in the abode of permanence. This is a good outward sign if you are patient, truthful, and God-fearing. So let not your share of this report — may God have mercy on you — be merely that you hear it with this ear and let it out from this ear. For whoever has seen Muhammad, peace be upon him, has seen him going forth early.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1291", "section_title_en": "The Haste for Death and Readiness for the Hereafter — Section 1291", "section_index": 1291, "anchors": "- Root: موت (m-w-t)\n  * Lisan / Ayn: Core root denotes cessation of vital faculty; \"مات موتة\" as a singular event of death.\n  * Al-Raghib (Mufradat): Death as transition from worldly life to the reckoning; linked to \"أجل\" (appointed term) and divine decree.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) = biological death; Metaphorical (Majaz) = \"إماتة\" of the heart via heedlessness, and \"الموت المغير\" as the transformative destroyer of states.\n- Root: بدر (b-d-r)\n  * Lisan / Ayn: Core root denotes hastening, rushing to a task; \"بادر\" implies competing with time.\n  * Al-Raghib (Mufradat): In Quranic usage, \"المبادر\" is the soul's urgency toward obedience before the term expires.\n  * Al-Zamakhshari (Asas): Literal = physical speed; Metaphorical = spiritual vigilance against procrastination (تسويف).\n- Root: عرض (ʿ-r-ḍ)\n  * Lisan / Ayn: Core root denotes presenting, exposing; \"العارية\" (loan) as something transiently possessed.\n  * Al-Raghib (Mufradat): Worldly life as \"عارية\" (borrowed thing) from God, to be returned at death.\n  * Al-Zamakhshari (Asas): Literal = loaned object; Metaphorical = the body and lifespan as a trust (أمانة) from the Creator.\n- Sibawayh Rule: باب التوكيد بالتكرار (Emphatic Repetition) — Repetition of phrases like \"ويحك بادري\" and \"المبادرة المبادرة\" serves as syntactic emphasis (توكيد لفظي) to intensify the exhortation, a structure Sibawayh treats as permissible for rhetorical force without redundancy.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "15": [{"arabic": "قرأ رجل بين يديه {فاليوم لا يؤخذ منكم فدية} الآية فرأيته قد ارتعد وكاد يسقط فلما عاد إلى حاله سألته عن ذلك فقال نعم يا حبيبي قد ضعفنا وكذلك سمع مرة قوله تعالى {الملك يومئذ الحق للرحمن} فاضطرب فسأله ابن سالم وكان من أصحابه فقال قد ضعفت فقيل له فإن كان هذا من مضعف فما قوة الحال فقال أن لا يرد عليه وارد إلا وهو يلتقيه بقوة حاله فلا تغيره الواردات وإن كانت قوية وسبب القدرة على ضبط الظاهر مع وجود الوجد استواء الأحوال بملازمة الشهود كما حكي عن سهل رحمه الله تعالى أنه قال حالتي قبل الصلاة وبعده", "english": "And it is related that Moses — peace be upon him — was preaching among the Children of Israel, and one of them tore his garment or his shirt. So God — exalted be He — revealed to Moses — peace be upon him: \"Say to him: Tear for Me your heart, and do not tear your garment.\"", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 517", "section_title_en": "The Revival of the Religious Sciences — Section 517: On the Steadfastness of the Strong in the Face of Ecstatic Samaʿ, and the Degrees of Manifestation and Restraint", "section_index": 517, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform from one state to another; the heart as that which is perpetually fluctuating and being overturned between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's turning and overturning is its being diverted from one disposition to another. The heart (qalb) is so named for its constant fluctuation (taqallub) between states.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — to turn pupils back to their homes; and \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and manages them. Here, the heart's being \"split\" (inshaqqa) and its \"turning\" (taqallub) in the unseen realm (malakūt) are majaz for the soul's profound transformation.\n- Root: ظهر (ẓ-h-r)\n  * Lisan / Ayn: The back; the outward, visible surface as opposed to the hidden interior.\n  * Al-Raghib (Mufradat): \"الظهر الجارحة\" — the back as a bodily limb; used metaphorically for the outward aspect of the earth: \"ظهر الأرض وبطنها\" — its surface and its interior.\n  * Al-Zamakhshari (Asas): Literal: \"رجل مظهر: قوي الظهر\" — a man strong of back. Metaphorical: \"قلبت الأمر ظهرا لبطن\" — to turn the matter over, back and belly, i.e., to examine it thoroughly. In this section, the \"outward\" (zāhir) is the domain of the bodily members (jawāriḥ) which must be restrained, while the \"inward\" (bāṭin) is the domain of the heart's ecstasy (wajd).\n- Root: حول (ḥ-w-l)\n  * Lisan / Ayn: To change, to turn, to shift from one state to another; power and capacity to effect change.\n  * Al-Raghib (Mufradat): \"أصل الحول تغير الشيء وانفصاله عن غيره\" — the root meaning is the changing of a thing and its separation from another. \"حال بيني وبينك كذا\" — something intervened between me and you.\n  * Al-Zamakhshari (Asas): Literal: \"حال عليه الحول\" — a year passed over it. Metaphorical: \"لقحت الحرب عن حيال\" — war conceived after a period of barrenness. Here, \"ḥāl\" (state/condition) and \"taḥawwul\" (transformation) denote the changing spiritual conditions that assail the heart, and the power (ḥawl) to restrain the outward members.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; breath; that which is precious and valued.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the self is the spirit; \"نفسه: ذاته\" — His Self is His Essence. The soul is that which is breathed out and drawn in, and by extension, the living self.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — he poured out his self, i.e., his blood. In this text, \"nafsahu\" (his self/soul) departs at death when the heart is split by suppressed ecstasy.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — The periodic structure of al-Ghazali's conditional sentences (fa-in qulta... fa-'lam) follows the classical pattern of protasis and apodosis, where the apodosis is introduced by the particle fa- to mark the resumption of the main clause after a lengthy conditional protasis, preserving syntactic cohesion across extended theological arguments.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Audition and Ecstasy'", "badge": "Insight"}], "19": [{"arabic": "سبحانه وتعالى {والذين آمنوا بالله ورسله أولئك هم الصديقون} الآية ولقوله تعالى كلما ألقى فيها فوج سألهم خزنتها إلى قوله فكذبنا وقلنا ما نزل الله من شيء فقوله {كلما ألقى فيها فوج} عام فينبغي أن يكون من ألقي في النار مكذبا ولقوله تعالى {لا يصلاها إلا الأشقى الذي كذب وتولى} وهذا حصر وإثبات ونفي ولقوله تعالى {من جاء بالحسنة فله خير منها وهم من فزع يومئذ آمنون} فالإيمان رأس الحسنات ولقوله تعالى {والله يحب المحسنين} وقال تعالى {إنا لا نضيع أجر من أحسن عملا} ولا حجة لهم في ذلك فإنه حيث ذكر الإيمان في هذه الآيات أريد به ال", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}], "20": [{"arabic": "الآخرة إلا متاع} وقال تعالى {اعلموا أنما الحياة الدنيا لعب ولهو وزينة وتفاخر بينكم وتكاثر في الأموال والأولاد} الآية وكل ذلك ذم لها فنسأل الله السلامة فأولو الحزم من أرباب القلوب جربوا قلوبهم في حال الفرح بمؤاتاة الدنيا فوجدوها قاسية نفرة بعيدة التأثر عن ذكر الله واليوم الآخر وجربوها في حالة الحزن فوجدوها لينة رقيقة صافية قابلة لأثر الذكر فعلموا أن النجاة في الحزن الدائم والتباعد من أسباب الفرح والبطر ففطموها عن ملاذها وعودوها الصبر عن شهواتها حلالها وحرامها وعلموا أن حلالها حساب وحرامها عقاب ومتشابهها عتاب وهو نوع عذاب فمن نوقش الحساب في عرصات القيام", "english": "And beyond it lie afflictions greater than this—namely, that the soul rejoices in comfort within this world, leans toward it, and becomes tranquil in it with insolence (asharan) and pride (baṭaran), until it becomes intoxicated like a drunkard who does not awaken from his intoxication. And that joy in this world is a deadly poison that courses through the veins, expelling from the heart the fear (khawf) of God, sorrow (ḥuzn), the remembrance of death, and the terrors of the Day of Resurrection. This is the death of the heart. God, Exalted is He, said: {وَرَضُوا بِالْحَيَاةِ الدُّنْيَا وَاطْمَأَنُّوا بِهَا} (\"And they were pleased with the life of this world and felt secure in it\") (Q 10:7). And He, Exalted is He, said: {وَمَا الْحَيَاةُ الدُّنْيَا فِي الْآخِرَةِ إِلَّا مَتَاعٌ} (\"And the life of this world, compared to the Hereafter, is but a [passing] enjoyment\") (Q 13:26). And He, Exalted is He, said: {اعْلَمُوا أَنَّمَا الْحَيَاةُ الدُّنْيَا لَعِبٌ وَلَهْوٌ وَزِينَةٌ وَتَفَاخُرٌ بَيْنَكُمْ وَتَكَاثُرٌ فِي الْأَمْوَالِ وَالْأَوْلَادِ} (\"Know that the life of this world is but amusement and diversion and adornment and boasting among you and competition in increase of wealth and children\") (Q 57:20)—to the end of the verse. All of this is censure of it. So we ask God for safety (salāmah).", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 629", "section_title_en": "On the Afflictions of Permissible Things and the Discipline of the Soul", "section_index": 629, "anchors": "- Root: س ك ت (s-k-t)\n  * Lisan / Ayn: Core root meaning: silence, stillness, cessation of speech.\n  * Al-Raghib (Mufradat): Theological nuance: silence (sukūt) as a positive act of worship when it restrains the tongue from falsehood and excess, aligning with the Quranic command to guard one's speech.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: Literal silence (ḥaqīqah) is the absence of audible speech; metaphorical (majāz) silence is the restraint of the heart from vain desires and the tongue from all but the remembrance of God.\n- Root: ش ه و (sh-h-w)\n  * Lisan / Ayn: Core root meaning: desire, longing, appetite; the inclination of the soul toward what pleases it.\n  * Al-Raghib (Mufradat): Theological nuance: shahwah (appetite/desire) is a neutral faculty; its blameworthiness lies in its direction toward the forbidden (ḥarām) or in its excess beyond the measure of necessity (ḍarūrah), which enslaves the heart.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: Literal desire is the physical craving for food, drink, or sensual pleasure; metaphorical desire is the soul's craving for status, comfort, and the fleeting adornments of this world (dunyā), which is the root of spiritual ruin.\n- Root: ف ط م (f-ṭ-m)\n  * Lisan / Ayn: Core root meaning: to wean, to cut off from suckling; to abstain from a habit.\n  * Al-Raghib (Mufradat): Theological nuance: fiṭām (weaning) is used analogically for the discipline of the soul—cutting it off from worldly pleasures (shahawāt) to accustom it to the remembrance of God, just as a child is weaned from the breast.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: Literal weaning is the physical act of separating an infant from milk; metaphorical weaning is the soul's training (riyāḍah) to abandon the \"milk\" of worldly comfort for the \"food\" of spiritual devotion.\n- Root: أ ن س ('-n-s)\n  * Lisan / Ayn: Core root meaning: to be sociable, familiar, at ease; to find comfort in company.\n  * Al-Raghib (Mufradat): Theological nuance: uns (intimacy/familiarity) with God is the highest station of the heart, achieved only after severing intimacy with the world; it is the soul's true home, contrasted with the alienation (waḥshah) of worldly attachment.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: Literal intimacy is human companionship; metaphorical intimacy is the heart's tranquil repose (ṭuma'nīnah) in the remembrance of God, as cited in the Quranic verse {أَلَا بِذِكْرِ اللَّهِ تَطْمَئِنُّ الْقُلُوبُ}.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its object for rhetorical emphasis, as in the periodic structure of the author's conditional clauses (e.g., \"فمن أراد... فحقه أن يلزمه\"), where the protasis is extended to clarify the subject's intent before the apodosis delivers the ruling.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "الله خير} وقوله {والآخرة خير وأبقى} وقوله {وما الحياة الدنيا إلا متاع الغرور} وقوله {فلا تغرنكم الحياة الدنيا} وقد أخبر رسول الله صلى الله عليه وسلم بذلك طوائف من الكفار فقلدوه وصدقوه وآمنوا به ولم يطالبوه بالبرهان (1) حديث قول من قال له نشدتك الله أبعثك رسولا فيقول {نعم} فيصدق متفق عليه من حديث أنس في قصة ضمام ابن ثعلبة وقوله للنبي صلى الله عليه وسلم أرسلك للناس كلهم فقال اللهم نعم وفي آخره فقال الرجل آمنت بما جئت به وللطبراني من حديث ابن عباس في ضمام قال نشدتك به أهو أرسلك بما أتتنا كتبك وأتتنا رسلك أن نشهد أن لا إله إلا ا", "english": "Know that the saying of God Most High — {«fa-lā taghurrannakum al-ḥayātu al-dunyā wa-lā yaghurrannakum billāhi al-gharūr»} (So let not the life of this world deceive you, nor let the Deceiver deceive you concerning God) — and His saying — {«wa-lākinnakum fatantum anfusakum wa-tarabbastum wa-irtabtum wa-gharratkum al-amānī»} (But ye tempted your own souls, and ye waited, and ye doubted, and vain desires deceived you) — is sufficient for the blameworthiness of self-deception (al-ghurūr). And the Messenger of God, may God's peace and blessing be upon him, has said: \"How excellent is the sleep of the intelligent and their breaking of the fast! How they outwit the wakefulness of the foolish and their striving! And verily a mustard-seed's weight [of faith] from a possessor of piety and certainty is better than the earth filled with the self-deceived.\" And the ḥadīth: \"The intelligent man (al-kayyis) is he who takes account of his own soul and works for what is after death\" — this ḥadīth was transmitted by al-Tirmidhī and Ibn Mājah from the ḥadīth of Shaddād ibn Aws.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 884", "section_title_en": "Exposition of the Blameworthiness of Self-Deception (Al-Ghurūr), Its Reality, and Its Examples", "section_index": 884, "anchors": "- Root: غرر (Gh-R-R)\n  * Lisan / Ayn: The core meaning is \"an apparent trace or mark of a thing\" (al-athar al-ẓāhir), from which derives \"the blaze of a horse\" (ghurrat al-faras). To deceive (gharra) is to strike one's heedlessness (ghirrah) and attain one's sought desire from him, as if folding a garment upon its original crease (ṭawāhu ʿalā gharrihi).\n  * Al-Raghib (Mufradat): \"Ghurrah is heedlessness in wakefulness, and ghirār is heedlessness with drowsiness.\" Theologically, it is the soul's repose upon a false semblance (shubhah) that pleases the caprice (hawā), rendering one oblivious to the true state of affairs—as in {«mā gharraka bi-rabbika al-karīm»} (What deceived thee concerning thy Generous Lord?).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"A gazelle in a moonlit night is called agharr\" because it ventures out thinking it is day and is devoured by beasts—heedlessness in perception. Metaphorical (majāz): \"A day agharr muḥajjal\" (a white-browed, white-legged day) for intense heat, transferring the blaze of a horse to the day's visible intensity.\n- Root: جهل (J-H-L)\n  * Lisan / Ayn: \"Jahila bihi\" — to be ignorant of it; \"jāhala ʿalā qawmihi\" — to act foolishly/insolently against one's people. The pre-Islamic era is \"al-jāhiliyyah al-jahlā'\" (the utterly ignorant age).\n  * Al-Raghib (Mufradat): Ignorance (jahl) is of three kinds: (1) the soul's emptiness of knowledge (this is the root); (2) believing a thing contrary to what it is; (3) doing a thing contrary to what it ought to be, whether one's belief is sound or corrupt. Ghurūr is a species of the second kind—a false belief arising from a corrupt semblance.\n  * Al-Zamakhshari (Asas): Literal: \"Kafā bil-shakki jahlā\" (Sufficient is doubt as ignorance). Metaphorical: \"Istajhalat al-rīḥ al-ghuṣn\" (The wind made the branch sway violently) — transferred from mental foolishness to physical agitation.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not.\" \"Al-ḥadath: the novel event.\" \"Ḥaddatha: to speak/communicate.\"\n  * Al-Raghib (Mufradat): \"Ḥudūth is the existence of a thing after non-existence, whether accident or substance. Iḥdāth is bringing it into existence. The iḥdāth of substances belongs to God alone.\" The \"ḥadīth\" (report/speech) is so-called for its temporal novelty.\n  * Al-Zamakhshari (Asas): Literal: \"Nazalat bihi ḥawādith al-dahr\" (The vicissitudes of time befell him). Metaphorical: \"Kāna ʿUmar muḥaddathan\" (Umar was one inspired with true discernment) — as if he were spoken to (ḥudditha) by what he conjectured.\n- Root: دنا (D-N-W)\n  * Lisan / Ayn: \"Danā fa-huwa dānin\" — he drew near. \"Al-dunyā\" (the lower world) is so named because it is nearer (danat) and precedes the Hereafter.\n  * Al-Raghib (Mufradat): \"Al-dunūw: proximity by essence or by judgment, used of place, time, and station.\" The \"adnā\" (lower/nearer) is contrasted with the greater and with the better: {«a-tastabdilūna alladhī huwa adnā billadhī huwa khayr»} (Will ye take the lower in exchange for what is better?).\n  * Al-Zamakhshari (Asas): Literal: \"Huwa danī' min al-adniyā'\" (He is base, of the base ones) — but this is the homonym danu'a (baseness), distinct from danā (nearness). The dunyā's \"nearness\" is its temporal immediacy versus the Hereafter's deferral.\n- Sibawayh Rule: Bab al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The particle \"bi\" in {«wa-lā yaghurrannakum billāhi al-gharūr»} governs the deceiver (al-gharūr) as the agent of deception, while \"billāh\" (concerning God) is the object of the deception. The syntactic structure permits the deceiver to be named after the prepositional phrase, indicating that the deception is *about* God's attributes (His forbearance, His respite) — a grammatical subtlety showing the ghurūr deceives *by means of* false notions of God, not that God Himself deceives.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Delusion'", "badge": "Afterlife"}, {"arabic": "الأموال والأولاد ثم رده تعالى في موضع آخر إلى اثنين فقال تعالى وإنما الحياة الدنيا لعب ولهو ثم رد الكل إلى واحد في موضع آخر فقال ونهى النفس عن الهوى فإن الجنة هي المأوى فالهوى لفظ يجمع جميع حظوظ النفس في الدنيا فينبغي أن يكون الزهد فيه وإذا فهمت طريق الإجمال والتفصيل عرفت أن البعض من هذه لا يخالف البعض وإنما يفارقه في الشرح مرة والإجمال أخرى فالحاصل أن الزهد عبارة عن الرغبة عن حظوظ النفس كلها ومهما رغب عن حظوظ النفس رغب عن البقاء في الدنيا فقصر أمله لا محالة لأنه إنما يريد البقاء ليتمتع ويريد التمتع الدائم بإرادة البقاء فإن من أراد شيئا", "english": "The third degree — and it is the highest — is that one renounce willingly, and renounce his very renunciation, so that he does not see his asceticism, since he does not see that he has abandoned anything, having come to know that the world is nothing. {PageV04P225} He is thus like one who casts away a potsherd and takes up a jewel — he does not regard that as an exchange, nor does he see himself as having abandoned anything. And the world, in comparison to God Most High and the bliss of the Hereafter, is baser than a potsherd in comparison to a jewel. This then is perfection in asceticism.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1092", "section_title_en": "The Degrees of Asceticism (Zuhd) and Its Divisions", "section_index": 1092, "anchors": "- Root: زهد (Z-H-D)\n  * Lisan / Ayn: Core meaning: scarcity, paucity; al-Zuhd as abstemiousness; zāhada fīhi: to turn away from something, deeming it insignificant.\n  * Al-Raghib (Mufradat): \"الزاهد في الشيء: الراغب عنه والراضي منه بالزهيد، أي: القليل\" — the ascetic is one who turns away from a thing, content with little of it; theological sense: renunciation of the world as a deliberate act of valuation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"زهد في الشيء: رغب عنه\" — turning away. Metaphorical (Majaz): \"رجل زهيد: قليل الخير\" — one of little good; \"اد زهيد: قليل الأخذ للماء\" — a valley taking little water. Here, al-Ghazali employs the literal sense of deliberate aversion, extended metaphorically to the soul's turning from all worldly appetites.\n- Root: دنا (D-N-W)\n  * Lisan / Ayn: Proximity, nearness; al-dunyā (the lower world) named for its nearness to us or its lowness.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — nearness by essence or by judgment; al-dunyā contrasted with al-ākhirah as the inferior and nearer realm.\n  * Al-Zamakhshari (Asas): Literal: proximity in place or rank. Metaphorical: the world as \"lower\" (adnā) in value — the sense operative in al-Ghazali's comparison of the world to a potsherd.\n- Root: درج (D-R-J)\n  * Lisan / Ayn: To walk step by step; to pass away (daraja: died, passed on); degree/stair.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a station considered as ascent; used for ranks of honor.\n  * Al-Zamakhshari (Asas): Literal: \"درج قرن بعد قرن\" — generations passed away; \"رقي في الدرجة\" — ascended in rank. Metaphorical: \"لفلان درجة رفيعة\" — one has a lofty degree. Al-Ghazali uses darajāt as ascending ranks of spiritual attainment.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — the repeated use of \"إنما\" (only/but) in the Quranic citations (e.g., {إنما الحياة الدنيا لعب ولهو}) functions as restrictive predication (qasr), confining the reality of the world to play and diversion — a syntactic key to al-Ghazali's argument that all worldly goods reduce ultimately to one thing: caprice (hawā).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "21": [{"arabic": "وإن اشتركوا في مصيبة الحرمان من حقيقة الأمر فالحقيقة فضل الله يؤتيه من يشاء والله ذو الفضل العظيم وحكمته يختص بها من يشاء ومن يؤت الحكمة فقد أوتي خيرا كثيرا ولنعد إلى الغرض فقد أرخينا الطول وطولنا النفس في أمر هو أعلاى من علوم المعاملات التي نقصدها في هذا الكتاب فقد ظهر أن رتبة الهلاك ليس إلا للجهال المكذبين وشهادة ذلك من كتاب الله وسنة رسوله صلى الله عليه وسلم لا تدخل تحت الحصر فلذلك لم نوردها الرتبة الثانية رتبة المعذبين وهذه رتبة من تحلى بأصل الإيمان ولكن قصر في الوفاء بمقتضاه فإن رأس الإيمان هو التوحيد وهو أن لا يعبد", "english": "The fire of Hell is the coldest of fires [in comparison to the fire of separation]. And you should not deny this in the world of the Hereafter, for it has a witnessed parallel in the world of this world. Indeed, one has been seen who was overcome by ecstasy (wajd) and walked upon fire and upon the roots of cane, his feet being cut, yet he did not feel it, due to the extreme dominance of what was in his heart. And you see the angry man, when anger overcomes him in battle, receiving wounds and not feeling them at that moment, because anger is a fire in the heart. The Messenger of God, peace and blessings be upon him, said: {«الغضب قطعة من النار»} \"Anger is a piece of fire.\" The burning of the heart (iḥtirāq al-fu'ād) is more severe than the burning of bodies, and the more severe annuls the sensation of the weaker, as you observe. For destruction from fire and the sword is only inasmuch as they separate between two parts that are linked one to the other by the bond of composition (ta'līf) possible in bodies. So that which separates between the heart and its Beloved, to which it is linked by a bond of composition far more firm than the composition of bodies, is more intensely painful—if you are among the people of insight (abṣār) and the people of hearts. And it is not far-fetched that he who has no heart should not perceive the severity of this pain and should deem it trivial in comparison to bodily pain. For a boy, if he were given the choice between the pain of being deprived of a ball and a polo-stick, and the pain of being deprived of the rank of a Sultan, he would not feel the pain of deprivation from the Sultan's rank at all, nor would he count that as a pain. And the enemy in the field with the polo-stick is more beloved to him than a thousand thrones of the Sultan with sitting upon them. Nay, even one overcome by the lust of the belly, if given the choice between porridge (harīsah) and sweets (ḥalwā) and between a beautiful deed by which he conquers enemies and delights friends, he would prefer the porridge and sweets. All of this is due to the absence of the meaning (maʿnā) by whose existence rank becomes beloved, and the presence of the meaning by whose existence food becomes delicious. This is for one whom the attributes of beasts and predators have enslaved, and in whom the attributes of the angels have not appeared—those attributes which are not suited by, nor delight in, anything but proximity to the Lord of the Worlds, and which are pained only by distance and the veil (ḥijāb). And just as taste is only in the tongue and hearing only in the ears, so this attribute is only in the heart. So he who has no heart has no such sense, like he who has no hearing or sight has no pleasure in melodies or the beauty of forms and colors. And not every human has a heart; were it so, the saying of God, Most High, would not be sound: {«إن في ذلك لذكرى لمن كان له قلب»} \"Indeed in that is a reminder for whoever has a heart\" (Q. 50:37). Thus He made the one who does not heed the Quran devoid of a heart. And by \"heart\" I do not mean this [organ] which the ribs of the chest encompass. Rather, I mean the secret (sirr) which is of the world of the Command (ʿālam al-amr). The flesh which is of the world of Creation (ʿālam al-khalq) is its Throne (ʿarsh), the chest is its Footstool (kursī), and the rest of the limbs are its domain and kingdom. And to God belongs the Creation and the Command altogether. But that secret, concerning which God, Most High, said: {«قل الروح من أمر ربي»} \"Say: The Spirit is of the Command of my Lord\" (Q. 17:85), is the commander and the king, because between the world of the Command and the world of Creation there is an ordering, and the world of the Command is commander over the world of Creation. It is the subtle divine reality (al-laṭīfah) which, when it is sound, the rest of the body is sound for its sake. Whoever knows it has known his own self, and whoever knows his own self has known his Lord. At that point, the servant smells the beginnings of the fragrance of the meaning folded under his saying, peace and blessings be upon him: {«إن الله خلق آدم على صورته»} \"God created Adam upon His image.\" He looks with the eye of mercy upon those who adhere to its literal wording and upon those who are obstinate in the path of its interpretation (ta'wīl). And even though His mercy for those adhering to the letter is greater than His mercy for the obstinate interpreters, because mercy is proportional to the affliction, and the affliction of those [literalists] is greater—even if they share in the affliction of being deprived of the reality of the matter—for the Reality (al-ḥaqīqah) is the bounty of God which He gives to whom He wills, and God is the Possessor of Great Bounty. And His Wisdom is singled out for whom He wills: {«ومن يؤت الحكمة فقد أوتي خيرا كثيرا»} \"And whoever is given wisdom has been given much good\" (Q. 2:269). Let us return to the purpose, for we have drawn out the length and lengthened the breath in a matter that is higher than the sciences of transactions (muʿāmalāt) which we intend in this book. It has become clear that the rank of destruction is only for the ignorant deniers. And the testimony of that from the Book of God and the Sunnah of His Messenger, peace and blessings be upon him, is beyond enumeration, so we have not cited it.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 930", "section_title_en": "The Ranks of the Hereafter: On the Distribution of Degrees and the States of the Saved, the Punished, and the Victorious", "section_index": 930, "anchors": "- Root: ح ر ق (ḥ-r-q)\n  * Lisan / Ayn: Core meaning of burning, scorching, and the fire's consumption of its fuel.\n  * Al-Raghib (Mufradat): The fire of the Hereafter (Nār) is a created reality, but its perception is tied to the spiritual state of the perceiver.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) for physical burning; metaphorical (Majaz) for the burning of the heart (iḥtirāq al-fu'ād) by overwhelming love or anger.\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): The heart (Qalb) is the seat of perception and understanding, distinct from the physical organ.\n  * Al-Zamakhshari (Asas): Literal for the physical heart; metaphorical for the spiritual subtlety (Laṭīfah) that is the locus of divine knowledge and love.\n- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: To know, to perceive a thing by its true nature.\n  * Al-Raghib (Mufradat): Knowledge (ʿIlm) is the apprehension of a thing's reality, which is the basis for distinguishing the ranks of the believers.\n  * Al-Zamakhshari (Asas): Literal for acquired knowledge; metaphorical for the \"unveiling\" (Kashf) knowledge granted to the knowers (ʿĀrifūn).\n- Sibawayh Rule: Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific referents of terms like \"heart\" (Qalb) and \"faith\" (Īmān), ensuring the precise meaning is not conflated with common usage.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "فقال صلى الله عليه وسلم ذلك فضل الله يؤتيه من يشاء (1) وقد استشهد ابن عطاء أيضا لما سئل عن ذلك فقال الغني أفضل لأنه وصف الحق أما دليله الأول ففيه نظر لأن الخبر قد ورد مفصلا تفصيلا يدل على خلاف ذلك وهو أن ثواب الفقير في التسبيح يزيد على ثواب الغني وأن فوزهم بذلك الثواب فضل الله يؤتيه من يشاء فقد روى زيد بن أسلم عن أنس بن مالك رضي الله عنه قال بعث الفقراء رسولا إلا رسول الله صلى الله عليه وسلم فقال إني رسول الفقراء إليك فقال {مرحبا} بك وبمن جئت من عندهم قوم أحبهم قال قالوا يا رسول الله إن", "english": "Evidence for this may be found in what is related in the report (khabar) that the poor complained to the Messenger of God, peace and blessings be upon him, that the rich had preceded them in good deeds, alms, pilgrimage (ḥajj), and holy struggle (jihād). So he taught them words of glorification (tasbīḥ) and told them that by these they would attain what surpassed what the rich had attained. Then the rich learned these words and began to say them, so the poor returned to the Messenger of God, peace and blessings be upon him, and informed him [of this]. He said, peace and blessings be upon him: {«ذلك فضل الله يؤتيه من يشاء»} — \"That is the bounty of God; He gives it to whom He wills.\" (1)", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1074", "section_title_en": "On the Relative Excellence of Poverty and Wealth — A Detailed Exposition", "section_index": 1074, "anchors": "- Root: فقر (fa-qā-rā)\n  * Lisan / Ayn: Core meaning of neediness, destitution; the state of one lacking provision or means.\n  * Al-Raghib (Mufradat): Fourfold division — (1) essential need before God (universal to all creatures), (2) lack of acquired possessions, (3) contentment of the soul, (4) metaphorical usage. Here, the operative sense is the second: absence of worldly goods.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) — absence of wealth; Metaphorical (Majaz) — \"فقرة الكلام\" (a rhetorical gem/point), showing the root's capacity for extension. The discussion here remains in the literal register of material need.\n- Root: غني (ghayn-nūn-yā)\n  * Lisan / Ayn: Core meaning of sufficiency, independence, freedom from need.\n  * Al-Raghib (Mufradat): Threefold division — (1) absolute freedom from all needs (God alone), (2) fewness of needs (the praised \"wealth of the soul\"), (3) abundance of possessions. The debate here pivots between senses (2) and (3).\n  * Al-Zamakhshari (Asas): Literal — \"أغنى عنه\" (to be independent of); Metaphorical — \"تغنته القيود\" (fetters \"enriched\" him, i.e., clung to him), showing that attachment, not mere possession, is the real issue.\n- Root: صبر (ṣād-bā-rā)\n  * Al-Raghib (Mufradat): Restraint of the soul in the face of hardship; steadfastness in obedience and abstinence from sin. The \"patient poor\" (فقير صابر) is the one who holds fast without anxious striving.\n  * Al-Zamakhshari (Asas): Literal — endurance of affliction; the compound \"صابر محتسب\" (patient and reckoning on God's reward) is the technical Quranic-Hadith register.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Prophet's saying {«ليس الغنى عن كثرة العرض إنما الغنى غنى النفس»} uses \"إنما\" to restrict true wealth to soul-contentment, negating the apparent sense of abundance. This syntactic restriction governs the entire argument: the \"wealth\" that matters is a state of the heart, not of the purse.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Poverty and Abstinence'", "badge": "Dhikr"}, {"arabic": "تعالى {وفي ذلك فليتنافس المتنافسون} وقال تعالى {سابقوا إلى مغفرة من ربكم} وإنما المسابقة عند خوف الفوت وهو كالعبدين ينسابقان إلى خدمة مولاهما إذ يجزع كل واحد أن يسبقه صاحبه فيحظى عند مولاه بمنزلة لا يحظى هو بها فكيف وقد صرح رسول الله صلى الله عليه وسلم بذلك فقال لا حسد إلا في اثنتين رجل أتاه الله مالا فسلطه على هلكته في الحق ورجل آتاه الله تعالى علما فهو يعمل به ويعلمه الناس (1) حديث أبي كبشة مثل هذه الأمة مثل أربعة رجل أتاه الله مالا الحديث رواه ابن ماجه والترمذي وقال حسن صحيح (2) حديث ثلاث لا ين", "english": "The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 720", "section_title_en": "On the Reality of Envy (Ḥasad) and Its Degrees — Section 720", "section_index": 720, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "23": [{"arabic": "بموجود ولا يحزن على مفقود كما قال تعالى لكيلا تأسوا على ما فاتكم ولا تفرحوا بما آتاكم بل ينبغي أن يكون بالضد من ذلك وهو أن يحزن بوجود المال ويفرح بفقده العلامة الثانية أن يستوي عنده ذامه ومادحه فالأول علامة الزهد في المال والثاني علامة الزهد في الجاه العلامة الثالثة أن يكون أنسه بالله تعالى والغالب على قلبه حلاوة الطاعة إذ لا يخلو القلب عن حلاوة المحبة إما محبة الدنيا وإما محبة الله وهما في القلب كالماء والهواء في القدح فالماء إذا دخل خرج الهواء ولا يجتمعان وكل من أنس بالله اشتغل به ولم يشتغل بغيره ولذلك قيل لبعضهم إلى ماذا أفضى", "english": "When it was unveiled to the friends of God (awliyā') — exalted is He — that the servant destroys his own soul by his deeds and his following of his soul's caprice, even as the silkworm destroys itself, they rejected this world (al-dunyā) entirely. Thus al-Hasan said: \"I saw seventy of the Badr veterans who were more ascetic (azhad) among what God made lawful for them than you are among what God made unlawful for you.\" In another wording: \"They were more joyful in affliction than you are in comfort and ease. Had you seen them, you would have said: 'They are mad.' And had they seen your righteous ones, they would have said: 'These have no share of goodness.' And had they seen your wicked ones, they would have said: 'These do not believe in the Day of Reckoning.'\"", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1100", "section_title_en": "The Exposition of the Signs of Asceticism (Zuhd)", "section_index": 1100, "anchors": "- Root: زهد (Z-H-D)\n  * Lisan / Ayn: Core root meaning: scarcity, paucity, and abstention; al-zuhd is also \"estimation\" (al-hazr), as in estimating a palm-crop.\n  * Al-Raghib (Mufradat): \"الزهيد: الشيء القليل\" — the ascetic (al-zāhid) is one who turns away from a thing, content with the little (al-qalīl) of it. Theological nuance: zuhd is not mere abandonment but a reorientation of desire away from the worldly toward the divine.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"زهد في الشيء: رغب عنه\" — to turn one's desire away from a thing. Majaz (metaphorical): \"رجل زهيد: قليل الخير\" — a man of little good; \"اد زهيد\" — a valley that takes little water. Thus, zuhd as a spiritual state is a metaphorical extension of scarcity applied to the heart's attachment.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: The heart (al-qalb); also \"turning/transforming a thing from one face to another\" (taṣrīf al-shay').\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant turning and fluctuation between states; theological nuance: the heart is the seat of volitional orientation, capable of being turned toward or away from God.\n  * Al-Zamakhshari (Asas): Haqiqah: physical overturning. Majaz: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and manages them; thus \"corruption of the heart\" (fasād al-qalb) is a metaphorical overturning of its proper orientation.\n- Root: أنس (A-N-S)\n  * Lisan / Ayn: Sociability, familiarity, intimacy; al-uns is the opposite of loneliness (al-wahshah).\n  * Al-Raghib (Mufradat): The soul's tranquility and familiarity with something; theological nuance: al-uns bi-Allāh is the heart's intimate repose in God, exclusive of all else.\n  * Al-Zamakhshari (Asas): Haqiqah: human companionship. Majaz: intimacy with God as the heart's true companionship, displacing worldly attachment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"إنما مسرة أحدهم معرفة الناس حاله\" restricts delight solely to public recognition, isolating the motive that invalidates claimed zuhd.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "ومنها أن يتواضع لكل مسلم ولا يتكبر عليه فإن الله لا يحب كل مختال فخور قال رسول الله صلى الله عليه وسلم إن الله تعالى أوحى إلي أن تواضعوا حتى لا يفخر أحد على أحد (6) ثم إن تفاخر عليه غيره فليحتمل قال الله تعالى لنبيه صلى الله عليه وسلم {خذ العفو وأمر بالعرف وأعرض عن الجاهلين} وعن ابن أبي أوفى كان رسول الله صلى الله عليه وسلم يتواضع لكل مسلم ولا يأنف ولا يتكبر أن يمشي مع الأرملة والمسكين فيقضي حاجته (7) ومنها أن لا يسمع بلاغات الناس بعضهم على بعض ولا يبلغ بعضهم ما يسمع من بعض قال صلى الله عليه وسلم لا يدخل الجنة", "english": "**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 433", "section_title_en": "The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims", "section_index": 433, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Duties of Brotherhood'", "badge": "Ethics"}, {"arabic": "فأما المذموم فكالحزن على ما فات قال الله تعالى لكيلا تأسوا على ما فاتكم والحزن على الأموات من هذا القبيل فإنه تسخط لقضاء الله تعالى وتأسف على ما لا تدارك له فهذا الحزن لما كان مذموما كان تحريكه بالنياحة مذموما فلذلك ورد النهي الصريح عن النياحة (1) وأما الحزن المحمود فهو حزن الإنسان على تقصيره في أمر دينه وبكاؤه على خطاياه والبكاء والتباكي والحزن والتحازن على ذلك محمود وعليه بكاء آدم عليه السلام وتحريك هذا الحزن وتقويته محمود لأنه يبعث على التشمير للتدارك ولذلك كانت نياحة داود عليه السلام محمودة إذ كان ذلك مع", "english": "As for the blameworthy, it is like grieving over what has passed away. God — exalted — says: {«...lest you grieve over what has escaped you»} (Q. 57:23). Grieving over the dead belongs to this kind, for it is discontent with God's decree and regret over what cannot be retrieved. Since this grief is blameworthy, stirring it up through wailing is likewise blameworthy. For this reason, the explicit prohibition of wailing (al-niyāḥah) has been transmitted.", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 493", "section_title_en": "On the Permissible and Forbidden Uses of Melodies, Rhythms, and Mourning Songs — Section 493 of the Book of the Revival of the Religious Sciences", "section_index": 493, "anchors": "- Root: خدع (kh-d-ʿ)\n  * Lisan / Ayn: To deceive, delude, or trick; the act of concealing a corrupt intent beneath a fair exterior.\n  * Al-Raghib (Mufradat): The deception of the lower self (al-ṭabʿ) is its presentation of the forbidden as permissible and the harmful as beneficial, thereby veiling the intellect from the true end.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) refers to actual trickery; metaphorical (majāz) applies to the soul's inclination that \"deceives\" one into error, as here.\n- Root: رجز (r-j-z)\n  * Lisan / Ayn: Rhymed, rhythmic verse (rajaz); a metrical form used in battle to spur courage.\n  * Al-Raghib (Mufradat): Rhythmic utterance intended to stir resolve; its permissibility follows the permissibility of the act it motivates.\n  * Al-Zamakhshari (Asas): Literal: the rajaz meter of poetry. Metaphorical: any rhythmic chant (like war-cries) that agitates the soul toward action.\n- Root: حزن (ḥ-z-n)\n  * Lisan / Ayn: Roughness of the ground; figuratively, the soul's contraction and distress (ghummah).\n  * Al-Raghib (Mufradat): Grief is a \"roughness\" of the soul; it is blameworthy when directed at what has passed (i.e., God's decree) and praiseworthy when directed at one's own shortcomings.\n  * Al-Zamakhshari (Asas): Literal: physical roughness. Metaphorical: a \"grieving\" voice (ṣawt ḥazīn) is one that is soft and plaintive (rakhīm), which softens the heart.\n- Root: ناح (n-w-ḥ)\n  * Lisan / Ayn: To wail or lament (niyāḥah), specifically for the dead.\n  * Al-Raghib (Mufradat): The vocalization of grief; its ruling follows the ruling of the grief it expresses or incites.\n  * Al-Zamakhshari (Asas): Literal: the act of wailing. Metaphorical: any sound that \"mourns\" or evokes sorrow.\n- Root: طرب (ṭ-r-b)\n  * Lisan / Ayn: Intense joy or agitation of the soul, often accompanied by melody.\n  * Al-Raghib (Mufradat): A movement of the soul toward expansion (in joy) or contraction (in sorrow); here, it is the pleasurable agitation excited by song.\n  * Al-Zamakhshari (Asas): Literal: the state of being moved. Metaphorical: the \"transport\" of delight that melodies produce.\n- Sibawayh Rule: Rule of Causal Consequence (Ḥukm al-Dalālah ʿalā al-Sabab)\n  * The ruling on the means (wasīlah) follows the ruling on the end (maqṣad). Thus, what leads to the forbidden is forbidden, and what leads to the obligatory or commendable is likewise ruled by its consequence. This governs the entire taxonomy of sounds and melodies in this section.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Audition and Ecstasy'", "badge": "Dhikr"}], "28": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 900, 1547], [2, 1547, 2144], [3, 2144, 2750], [4, 2750, 3176], [5, 3176, 4642], [6, 4642, 5821], [7, 5821, 6754], [8, 6754, 7900], [9, 7900, 9020]], "57:1": [[1, 900, 1547], [2, 1547, 2144], [3, 2144, 2750], [4, 2750, 3176], [5, 3176, 4642], [6, 4642, 5821], [7, 5821, 6754], [8, 6754, 7900], [9, 7900, 9020]], "2": [[1, 290, 657], [2, 657, 1236], [3, 1236, 2964], [4, 2964, 4354], [5, 4354, 5338], [6, 5338, 7114], [7, 7114, 8214], [8, 8214, 9204], [9, 9204, 9735], [10, 9735, 10430], [11, 10430, 11510]], "57:2": [[1, 290, 657], [2, 657, 1236], [3, 1236, 2964], [4, 2964, 