{"surah": 57, "verses": [{"ayah": 1, "text": "سَبَّحَ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "Whatever is in the heavens and earth exalts Allāh,[1] and He is the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "سَبَّحَ", "translit": "َḥَّbَs", "root": "سبح"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 8, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 9, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": true}, {"ayah": 2, "text": "لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ يُحْىِۦ وَيُمِيتُۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "His is the dominion of the heavens and earth. He gives life and causes death, and He is over all things competent.", "words": [{"id": 1, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 2, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "يُحْىِۦ", "translit": "ۦِàْḥُy", "root": "حيي"}, {"id": 6, "arabic": "وَيُمِيتُ", "translit": "ُtyِmُyَw", "root": "موت"}, {"id": 7, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 10, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 11, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 3, "text": "هُوَ ٱلْأَوَّلُ وَٱلْءَاخِرُ وَٱلظَّٰهِرُ وَٱلْبَاطِنُۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "He is the First[1] and the Last,[2] the Ascendant[3] and the Intimate,[4] and He is, of all things, Knowing.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلْأَوَّلُ", "translit": "ُlَّwَaʾْlٱ", "root": "اول"}, {"id": 3, "arabic": "وَٱلْءَاخِرُ", "translit": "ُrِhkāَءْlٱَw", "root": "اخر"}, {"id": 4, "arabic": "وَٱلظَّٰهِرُ", "translit": "ُrِhَّٰẓlٱَw", "root": "ظهر"}, {"id": 5, "arabic": "وَٱلْبَاطِنُ", "translit": "ُnِṭāَbْlٱَw", "root": "بطن"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 4, "text": "هُوَ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِۚ يَعْلَمُ مَا يَلِجُ فِى ٱلْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنزِلُ مِنَ ٱلسَّمَآءِ وَمَا يَعْرُجُ فِيهَاۖ وَهُوَ مَعَكُمْ أَيْنَ مَا كُنتُمْۚ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "It is He who created the heavens and earth in six days and then established Himself above the Throne.[1] He knows what penetrates into the earth and what emerges from it and what descends from the heaven and what ascends therein; and He is with you[2] wherever you are. And Allāh, of what you do, is Seeing.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "سِتَّةِ", "translit": "ِẗَّtِs", "root": "ستت"}, {"id": 8, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 9, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 10, "arabic": "ٱسْتَوَىٰ", "translit": "ٰàَwَtْsٱ", "root": "سوي"}, {"id": 11, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 12, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 13, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "يَلِجُ", "translit": "ُjgِlَy", "root": "ولج"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 18, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 19, "arabic": "يَخْرُجُ", "translit": "ُjgُrْhkَy", "root": "خرج"}, {"id": 20, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 21, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 22, "arabic": "يَنزِلُ", "translit": "ُlِznَy", "root": "نزل"}, {"id": 23, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 24, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 25, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 26, "arabic": "يَعْرُجُ", "translit": "ُjgُrْʿعَy", "root": "عرج"}, {"id": 27, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 28, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 29, "arabic": "مَعَكُمْ", "translit": "ْmُkَʿعَm", "root": ""}, {"id": 30, "arabic": "أَيْنَ", "translit": "َnْyَaʾ", "root": ""}, {"id": 31, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 32, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 33, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 34, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 35, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 36, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 5, "text": "لَّهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَإِلَى ٱللَّهِ تُرْجَعُ ٱلْأُمُورُ ", "translation": "His is the dominion of the heavens and earth. And to Allāh are returned [all] matters.", "words": [{"id": 1, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 2, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَإِلَى", "translit": "àَlِiʾَw", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "تُرْجَعُ", "translit": "ُʿعَjgْrُt", "root": "رجع"}, {"id": 8, "arabic": "ٱلْأُمُورُ", "translit": "ُrwُmُaʾْlٱ", "root": "امر"}], "hasIhya": false}, {"ayah": 6, "text": "يُولِجُ ٱلَّيْلَ فِى ٱلنَّهَارِ وَيُولِجُ ٱلنَّهَارَ فِى ٱلَّيْلِۚ وَهُوَ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ", "translation": "He causes the night to enter the day and causes the day to enter the night, and He is Knowing of that within the breasts.", "words": [{"id": 1, "arabic": "يُولِجُ", "translit": "ُjgِlwُy", "root": "ولج"}, {"id": 2, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلنَّهَارِ", "translit": "ِrāَhَّnlٱ", "root": "نهر"}, {"id": 5, "arabic": "وَيُولِجُ", "translit": "ُjgِlwُyَw", "root": "ولج"}, {"id": 6, "arabic": "ٱلنَّهَارَ", "translit": "َrāَhَّnlٱ", "root": "نهر"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 11, "arabic": "بِذَاتِ", "translit": "ِtāَhdِb", "root": ""}, {"id": 12, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": false}, {"ayah": 7, "text": "ءَامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَأَنفِقُوا۟ مِمَّا جَعَلَكُم مُّسْتَخْلَفِينَ فِيهِۖ فَٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَأَنفَقُوا۟ لَهُمْ أَجْرٌ كَبِيرٌ ", "translation": "Believe in Allāh and His Messenger and spend out of that in which He has made you successive inheritors. For those who have believed among you and spent,[1] there will be a great reward.", "words": [{"id": 1, "arabic": "ءَامِنُوا۟", "translit": "۟āwُnِmāَء", "root": "امن"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 4, "arabic": "وَأَنفِقُوا۟", "translit": "۟āwُqِfnَaʾَw", "root": "نفق"}, {"id": 5, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 6, "arabic": "جَعَلَكُم", "translit": "mُkَlَʿعَjg", "root": "جعل"}, {"id": 7, "arabic": "مُّسْتَخْلَفِينَ", "translit": "َnyِfَlْhkَtْsُّm", "root": "خلف"}, {"id": 8, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 9, "arabic": "فَٱلَّذِينَ", "translit": "َnyِhdَّlٱَf", "root": ""}, {"id": 10, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 11, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 12, "arabic": "وَأَنفَقُوا۟", "translit": "۟āwُqَfnَaʾَw", "root": "نفق"}, {"id": 13, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 14, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 15, "arabic": "كَبِيرٌ", "translit": "ٌryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 8, "text": "وَمَا لَكُمْ لَا تُؤْمِنُونَ بِٱللَّهِۙ وَٱلرَّسُولُ يَدْعُوكُمْ لِتُؤْمِنُوا۟ بِرَبِّكُمْ وَقَدْ أَخَذَ مِيثَٰقَكُمْ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "And why do you not believe in Allāh while the Messenger invites you to believe in your Lord and He has taken your covenant, if you should [truly] be believers?", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "تُؤْمِنُونَ", "translit": "َnwُnِmْwʾُt", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَٱلرَّسُولُ", "translit": "ُlwُsَّrlٱَw", "root": "رسل"}, {"id": 7, "arabic": "يَدْعُوكُمْ", "translit": "ْmُkwُʿعْdَy", "root": "دعو"}, {"id": 8, "arabic": "لِتُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُtِl", "root": "امن"}, {"id": 9, "arabic": "بِرَبِّكُمْ", "translit": "ْmُkِّbَrِb", "root": "ربب"}, {"id": 10, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 11, "arabic": "أَخَذَ", "translit": "َhdَhkَaʾ", "root": "اخذ"}, {"id": 12, "arabic": "مِيثَٰقَكُمْ", "translit": "ْmُkَqَٰhtyِm", "root": "وثق"}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 15, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": false}, {"ayah": 9, "text": "هُوَ ٱلَّذِى يُنَزِّلُ عَلَىٰ عَبْدِهِۦٓ ءَايَٰتٍۭ بَيِّنَٰتٍ لِّيُخْرِجَكُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۚ وَإِنَّ ٱللَّهَ بِكُمْ لَرَءُوفٌ رَّحِيمٌ ", "translation": "It is He who sends down upon His Servant [Muḥammad (ﷺ)] verses of clear evidence that He may bring you out from darknesses into the light. And indeed, Allāh is to you Kind and Merciful.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُنَزِّلُ", "translit": "ُlِّzَnُy", "root": "نزل"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "عَبْدِهِۦٓ", "translit": "ٓۦِhِdْbَʿع", "root": "عبد"}, {"id": 6, "arabic": "ءَايَٰتٍۭ", "translit": "ٍۭtَٰyāَء", "root": "ايي"}, {"id": 7, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 8, "arabic": "لِّيُخْرِجَكُم", "translit": "mُkَjgِrْhkُyِّl", "root": "خرج"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلظُّلُمَٰتِ", "translit": "ِtَٰmُlُّẓlٱ", "root": "ظلم"}, {"id": 11, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلنُّورِ", "translit": "ِrwُّnlٱ", "root": "نور"}, {"id": 13, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 16, "arabic": "لَرَءُوفٌ", "translit": "ٌfwُءَrَl", "root": "راف"}, {"id": 17, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 10, "text": "وَمَا لَكُمْ أَلَّا تُنفِقُوا۟ فِى سَبِيلِ ٱللَّهِ وَلِلَّهِ مِيرَٰثُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ لَا يَسْتَوِى مِنكُم مَّنْ أَنفَقَ مِن قَبْلِ ٱلْفَتْحِ وَقَٰتَلَۚ أُو۟لَٰٓئِكَ أَعْظَمُ دَرَجَةً مِّنَ ٱلَّذِينَ أَنفَقُوا۟ مِنۢ بَعْدُ وَقَٰتَلُوا۟ۚ وَكُلًّا وَعَدَ ٱللَّهُ ٱلْحُسْنَىٰۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ ", "translation": "And why do you not spend in the cause of Allāh while to Allāh belongs the heritage of the heavens and the earth? Not equal among you are those who spent before the conquest [of Makkah] and fought [and those who did so after it]. Those are greater in degree than they who spent afterwards and fought. But to all Allāh has promised the best [reward]. And Allāh, of what you do, is Aware.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 4, "arabic": "تُنفِقُوا۟", "translit": "۟āwُqِfnُt", "root": "نفق"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 9, "arabic": "مِيرَٰثُ", "translit": "ُhtَٰryِm", "root": "ورث"}, {"id": 10, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 11, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يَسْتَوِى", "translit": "àِwَtْsَy", "root": "سوي"}, {"id": 14, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 15, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 16, "arabic": "أَنفَقَ", "translit": "َqَfnَaʾ", "root": "نفق"}, {"id": 17, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 18, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 19, "arabic": "ٱلْفَتْحِ", "translit": "ِḥْtَfْlٱ", "root": "فتح"}, {"id": 20, "arabic": "وَقَٰتَلَ", "translit": "َlَtَٰqَw", "root": "قتل"}, {"id": 21, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 22, "arabic": "أَعْظَمُ", "translit": "ُmَẓْʿعَaʾ", "root": "عظم"}, {"id": 23, "arabic": "دَرَجَةً", "translit": "ًẗَjgَrَd", "root": "درج"}, {"id": 24, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 25, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 26, "arabic": "أَنفَقُوا۟", "translit": "۟āwُqَfnَaʾ", "root": "نفق"}, {"id": 27, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 28, "arabic": "بَعْدُ", "translit": "ُdْʿعَb", "root": "بعد"}, {"id": 29, "arabic": "وَقَٰتَلُوا۟", "translit": "۟āwُlَtَٰqَw", "root": "قتل"}, {"id": 30, "arabic": "وَكُلًّا", "translit": "āًّlُkَw", "root": "كلل"}, {"id": 31, "arabic": "وَعَدَ", "translit": "َdَʿعَw", "root": "وعد"}, {"id": 32, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 33, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 34, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 35, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 36, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 37, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 11, "text": "مَّن ذَا ٱلَّذِى يُقْرِضُ ٱللَّهَ قَرْضًا حَسَنًا فَيُضَٰعِفَهُۥ لَهُۥ وَلَهُۥٓ أَجْرٌ كَرِيمٌ ", "translation": "Who is it that would loan Allāh a goodly loan so He will multiply it for him and he will have a noble reward?", "words": [{"id": 1, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 2, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يُقْرِضُ", "translit": "ُḍِrْqُy", "root": "قرض"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "قَرْضًا", "translit": "āًḍْrَq", "root": "قرض"}, {"id": 7, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 8, "arabic": "فَيُضَٰعِفَهُۥ", "translit": "ۥُhَfِʿعَٰḍُyَf", "root": "ضعف"}, {"id": 9, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 10, "arabic": "وَلَهُۥٓ", "translit": "ٓۥُhَlَw", "root": ""}, {"id": 11, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 12, "arabic": "كَرِيمٌ", "translit": "ٌmyِrَk", "root": "كرم"}], "hasIhya": true}, {"ayah": 12, "text": "يَوْمَ تَرَى ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ يَسْعَىٰ نُورُهُم بَيْنَ أَيْدِيهِمْ وَبِأَيْمَٰنِهِم بُشْرَىٰكُمُ ٱلْيَوْمَ جَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ", "translation": "On the Day you see the believing men and believing women, their light proceeding before them and on their right, [it will be said], \"Your good tidings today are [of] gardens beneath which rivers flow, wherein you will abide eternally.\" That is what is the great attainment.", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تَرَى", "translit": "àَrَt", "root": "راي"}, {"id": 3, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 4, "arabic": "وَٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 5, "arabic": "يَسْعَىٰ", "translit": "ٰàَʿعْsَy", "root": "سعي"}, {"id": 6, "arabic": "نُورُهُم", "translit": "mُhُrwُn", "root": "نور"}, {"id": 7, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 8, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 9, "arabic": "وَبِأَيْمَٰنِهِم", "translit": "mِhِnَٰmْyَaʾِbَw", "root": "يمن"}, {"id": 10, "arabic": "بُشْرَىٰكُمُ", "translit": "ُmُkٰàَrْhsُb", "root": "بشر"}, {"id": 11, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 12, "arabic": "جَنَّٰتٌ", "translit": "ٌtَّٰnَjg", "root": "جنن"}, {"id": 13, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 16, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 17, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 18, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 19, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 20, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 21, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 22, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": true}, {"ayah": 13, "text": "يَوْمَ يَقُولُ ٱلْمُنَٰفِقُونَ وَٱلْمُنَٰفِقَٰتُ لِلَّذِينَ ءَامَنُوا۟ ٱنظُرُونَا نَقْتَبِسْ مِن نُّورِكُمْ قِيلَ ٱرْجِعُوا۟ وَرَآءَكُمْ فَٱلْتَمِسُوا۟ نُورًا فَضُرِبَ بَيْنَهُم بِسُورٍ لَّهُۥ بَابٌۢ بَاطِنُهُۥ فِيهِ ٱلرَّحْمَةُ وَظَٰهِرُهُۥ مِن قِبَلِهِ ٱلْعَذَابُ ", "translation": "On the [same] Day the hypocrite men and hypocrite women will say to those who believed, \"Wait for us that we may acquire some of your light.\" It will be said, \"Go back behind you[1] and seek light.\" And a wall will be placed between them with a door, its interior containing mercy, but on the outside of it is torment.", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "ٱلْمُنَٰفِقُونَ", "translit": "َnwُqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 4, "arabic": "وَٱلْمُنَٰفِقَٰتُ", "translit": "ُtَٰqِfَٰnُmْlٱَw", "root": "نفق"}, {"id": 5, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 6, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 7, "arabic": "ٱنظُرُونَا", "translit": "āَnwُrُẓnٱ", "root": "نظر"}, {"id": 8, "arabic": "نَقْتَبِسْ", "translit": "ْsِbَtْqَn", "root": "قبس"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "نُّورِكُمْ", "translit": "ْmُkِrwُّn", "root": "نور"}, {"id": 11, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 12, "arabic": "ٱرْجِعُوا۟", "translit": "۟āwُʿعِjgْrٱ", "root": "رجع"}, {"id": 13, "arabic": "وَرَآءَكُمْ", "translit": "ْmُkَءٓāَrَw", "root": "وري"}, {"id": 14, "arabic": "فَٱلْتَمِسُوا۟", "translit": "۟āwُsِmَtْlٱَf", "root": "لمس"}, {"id": 15, "arabic": "نُورًا", "translit": "āًrwُn", "root": "نور"}, {"id": 16, "arabic": "فَضُرِبَ", "translit": "َbِrُḍَf", "root": "ضرب"}, {"id": 17, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 18, "arabic": "بِسُورٍ", "translit": "ٍrwُsِb", "root": "سور"}, {"id": 19, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 20, "arabic": "بَابٌۢ", "translit": "ٌۢbāَb", "root": "بوب"}, {"id": 21, "arabic": "بَاطِنُهُۥ", "translit": "ۥُhُnِṭāَb", "root": "بطن"}, {"id": 22, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 23, "arabic": "ٱلرَّحْمَةُ", "translit": "ُẗَmْḥَّrlٱ", "root": "رحم"}, {"id": 24, "arabic": "وَظَٰهِرُهُۥ", "translit": "ۥُhُrِhَٰẓَw", "root": "ظهر"}, {"id": 25, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 26, "arabic": "قِبَلِهِ", "translit": "ِhِlَbِq", "root": "قبل"}, {"id": 27, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}], "hasIhya": true}, {"ayah": 14, "text": "يُنَادُونَهُمْ أَلَمْ نَكُن مَّعَكُمْۖ قَالُوا۟ بَلَىٰ وَلَٰكِنَّكُمْ فَتَنتُمْ أَنفُسَكُمْ وَتَرَبَّصْتُمْ وَٱرْتَبْتُمْ وَغَرَّتْكُمُ ٱلْأَمَانِىُّ حَتَّىٰ جَآءَ أَمْرُ ٱللَّهِ وَغَرَّكُم بِٱللَّهِ ٱلْغَرُورُ ", "translation": "They [i.e., the hypocrites] will call to them [i.e., the believers], \"Were we not with you?\" They will say, \"Yes, but you afflicted yourselves[1] and awaited [misfortune for us] and doubted, and wishful thinking deluded you until there came the command of Allāh. And the Deceiver [i.e., Satan] deceived you concerning Allāh.", "words": [{"id": 1, "arabic": "يُنَادُونَهُمْ", "translit": "ْmُhَnwُdāَnُy", "root": "ندي"}, {"id": 2, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 3, "arabic": "نَكُن", "translit": "nُkَn", "root": "كون"}, {"id": 4, "arabic": "مَّعَكُمْ", "translit": "ْmُkَʿعَّm", "root": ""}, {"id": 5, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 6, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 7, "arabic": "وَلَٰكِنَّكُمْ", "translit": "ْmُkَّnِkَٰlَw", "root": ""}, {"id": 8, "arabic": "فَتَنتُمْ", "translit": "ْmُtnَtَf", "root": "فتن"}, {"id": 9, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 10, "arabic": "وَتَرَبَّصْتُمْ", "translit": "ْmُtْṣَّbَrَtَw", "root": "ربص"}, {"id": 11, "arabic": "وَٱرْتَبْتُمْ", "translit": "ْmُtْbَtْrٱَw", "root": "ريب"}, {"id": 12, "arabic": "وَغَرَّتْكُمُ", "translit": "ُmُkْtَّrَغَw", "root": "غرر"}, {"id": 13, "arabic": "ٱلْأَمَانِىُّ", "translit": "ُّàِnāَmَaʾْlٱ", "root": "مني"}, {"id": 14, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 15, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 16, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَغَرَّكُم", "translit": "mُkَّrَغَw", "root": "غرر"}, {"id": 19, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 20, "arabic": "ٱلْغَرُورُ", "translit": "ُrwُrَغْlٱ", "root": "غرر"}], "hasIhya": true}, {"ayah": 15, "text": "فَٱلْيَوْمَ لَا يُؤْخَذُ مِنكُمْ فِدْيَةٌ وَلَا مِنَ ٱلَّذِينَ كَفَرُوا۟ۚ مَأْوَىٰكُمُ ٱلنَّارُۖ هِىَ مَوْلَىٰكُمْۖ وَبِئْسَ ٱلْمَصِيرُ ", "translation": "So today no ransom will be taken from you or from those who disbelieved. Your refuge is the Fire. It is most worthy of you, and wretched is the destination.\"", "words": [{"id": 1, "arabic": "فَٱلْيَوْمَ", "translit": "َmْwَyْlٱَf", "root": "يوم"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يُؤْخَذُ", "translit": "ُhdَhkْwʾُy", "root": "اخذ"}, {"id": 4, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 5, "arabic": "فِدْيَةٌ", "translit": "ٌẗَyْdِf", "root": "فدي"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "مَأْوَىٰكُمُ", "translit": "ُmُkٰàَwْaʾَm", "root": "اوي"}, {"id": 11, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 12, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 13, "arabic": "مَوْلَىٰكُمْ", "translit": "ْmُkٰàَlْwَm", "root": "ولي"}, {"id": 14, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 15, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 16, "text": "أَلَمْ يَأْنِ لِلَّذِينَ ءَامَنُوٓا۟ أَن تَخْشَعَ قُلُوبُهُمْ لِذِكْرِ ٱللَّهِ وَمَا نَزَلَ مِنَ ٱلْحَقِّ وَلَا يَكُونُوا۟ كَٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ مِن قَبْلُ فَطَالَ عَلَيْهِمُ ٱلْأَمَدُ فَقَسَتْ قُلُوبُهُمْۖ وَكَثِيرٌ مِّنْهُمْ فَٰسِقُونَ ", "translation": "Has the time not come for those who have believed that their hearts should become humbly submissive at the remembrance of Allāh and what has come down of the truth? And let them not be like those who were given the Scripture before, and a long period passed over them, so their hearts hardened; and many of them are defiantly disobedient.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَأْنِ", "translit": "ِnْaʾَy", "root": "اني"}, {"id": 3, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 4, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَخْشَعَ", "translit": "َʿعَhsْhkَt", "root": "خشع"}, {"id": 7, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 8, "arabic": "لِذِكْرِ", "translit": "ِrْkِhdِl", "root": "ذكر"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "نَزَلَ", "translit": "َlَzَn", "root": "نزل"}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 16, "arabic": "كَٱلَّذِينَ", "translit": "َnyِhdَّlٱَk", "root": ""}, {"id": 17, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 18, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 19, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 20, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 21, "arabic": "فَطَالَ", "translit": "َlāَṭَf", "root": "طول"}, {"id": 22, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 23, "arabic": "ٱلْأَمَدُ", "translit": "ُdَmَaʾْlٱ", "root": "امد"}, {"id": 24, "arabic": "فَقَسَتْ", "translit": "ْtَsَqَf", "root": "قسو"}, {"id": 25, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 26, "arabic": "وَكَثِيرٌ", "translit": "ٌryِhtَkَw", "root": "كثر"}, {"id": 27, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 28, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 17, "text": "ٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ يُحْىِ ٱلْأَرْضَ بَعْدَ مَوْتِهَاۚ قَدْ بَيَّنَّا لَكُمُ ٱلْءَايَٰتِ لَعَلَّكُمْ تَعْقِلُونَ ", "translation": "Know that Allāh gives life to the earth after its lifelessness. We have made clear to you the signs; perhaps you will understand.[1]", "words": [{"id": 1, "arabic": "ٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱ", "root": "علم"}, {"id": 2, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "يُحْىِ", "translit": "ِàْḥُy", "root": "حيي"}, {"id": 5, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مَوْتِهَا", "translit": "āَhِtْwَm", "root": "موت"}, {"id": 8, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 9, "arabic": "بَيَّنَّا", "translit": "āَّnَّyَb", "root": "بين"}, {"id": 10, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 11, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 12, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 13, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": false}, {"ayah": 18, "text": "إِنَّ ٱلْمُصَّدِّقِينَ وَٱلْمُصَّدِّقَٰتِ وَأَقْرَضُوا۟ ٱللَّهَ قَرْضًا حَسَنًا يُضَٰعَفُ لَهُمْ وَلَهُمْ أَجْرٌ كَرِيمٌ ", "translation": "Indeed, the men who practice charity and the women who practice charity and [they who] have loaned Allāh a goodly loan - it will be multiplied for them, and they will have a noble reward.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْمُصَّدِّقِينَ", "translit": "َnyِqِّdَّṣُmْlٱ", "root": "صدق"}, {"id": 3, "arabic": "وَٱلْمُصَّدِّقَٰتِ", "translit": "ِtَٰqِّdَّṣُmْlٱَw", "root": "صدق"}, {"id": 4, "arabic": "وَأَقْرَضُوا۟", "translit": "۟āwُḍَrْqَaʾَw", "root": "قرض"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "قَرْضًا", "translit": "āًḍْrَq", "root": "قرض"}, {"id": 7, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 8, "arabic": "يُضَٰعَفُ", "translit": "ُfَʿعَٰḍُy", "root": "ضعف"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 11, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 12, "arabic": "كَرِيمٌ", "translit": "ٌmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 19, "text": "وَٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦٓ أُو۟لَٰٓئِكَ هُمُ ٱلصِّدِّيقُونَۖ وَٱلشُّهَدَآءُ عِندَ رَبِّهِمْ لَهُمْ أَجْرُهُمْ وَنُورُهُمْۖ وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَٰتِنَآ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْجَحِيمِ ", "translation": "And those who have believed in Allāh and His messengers - those are [in the ranks of] the supporters of truth and the martyrs, with their Lord. For them is their reward and their light.[1] But those who have disbelieved and denied Our verses - those are the companions of Hellfire.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "وَرُسُلِهِۦٓ", "translit": "ٓۦِhِlُsُrَw", "root": "رسل"}, {"id": 5, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 7, "arabic": "ٱلصِّدِّيقُونَ", "translit": "َnwُqyِّdِّṣlٱ", "root": "صدق"}, {"id": 8, "arabic": "وَٱلشُّهَدَآءُ", "translit": "ُءٓāَdَhُّhslٱَw", "root": "شهد"}, {"id": 9, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 10, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 11, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 12, "arabic": "أَجْرُهُمْ", "translit": "ْmُhُrْjgَaʾ", "root": "اجر"}, {"id": 13, "arabic": "وَنُورُهُمْ", "translit": "ْmُhُrwُnَw", "root": "نور"}, {"id": 14, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 15, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 16, "arabic": "وَكَذَّبُوا۟", "translit": "۟āwُbَّhdَkَw", "root": "كذب"}, {"id": 17, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 18, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 19, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 20, "arabic": "ٱلْجَحِيمِ", "translit": "ِmyِḥَjgْlٱ", "root": "جحم"}], "hasIhya": true}, {"ayah": 20, "text": "ٱعْلَمُوٓا۟ أَنَّمَا ٱلْحَيَوٰةُ ٱلدُّنْيَا لَعِبٌ وَلَهْوٌ وَزِينَةٌ وَتَفَاخُرٌۢ بَيْنَكُمْ وَتَكَاثُرٌ فِى ٱلْأَمْوَٰلِ وَٱلْأَوْلَٰدِۖ كَمَثَلِ غَيْثٍ أَعْجَبَ ٱلْكُفَّارَ نَبَاتُهُۥ ثُمَّ يَهِيجُ فَتَرَىٰهُ مُصْفَرًّا ثُمَّ يَكُونُ حُطَٰمًاۖ وَفِى ٱلْءَاخِرَةِ عَذَابٌ شَدِيدٌ وَمَغْفِرَةٌ مِّنَ ٱللَّهِ وَرِضْوَٰنٌۚ وَمَا ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا مَتَٰعُ ٱلْغُرُورِ ", "translation": "Know that the life of this world is but amusement and diversion and adornment and boasting to one another and competition in increase of wealth and children - like the example of a rain whose [resulting] plant growth pleases the tillers; then it dries and you see it turned yellow; then it becomes [scattered] debris. And in the Hereafter is severe punishment and forgiveness from Allāh and approval. And what is the worldly life except the enjoyment of delusion.", "words": [{"id": 1, "arabic": "ٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱ", "root": "علم"}, {"id": 2, "arabic": "أَنَّمَا", "translit": "āَmَّnَaʾ", "root": ""}, {"id": 3, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 4, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 5, "arabic": "لَعِبٌ", "translit": "ٌbِʿعَl", "root": "لعب"}, {"id": 6, "arabic": "وَلَهْوٌ", "translit": "ٌwْhَlَw", "root": "لهو"}, {"id": 7, "arabic": "وَزِينَةٌ", "translit": "ٌẗَnyِzَw", "root": "زين"}, {"id": 8, "arabic": "وَتَفَاخُرٌۢ", "translit": "ٌۢrُhkāَfَtَw", "root": "فخر"}, {"id": 9, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 10, "arabic": "وَتَكَاثُرٌ", "translit": "ٌrُhtāَkَtَw", "root": "كثر"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْأَمْوَٰلِ", "translit": "ِlَٰwْmَaʾْlٱ", "root": "مول"}, {"id": 13, "arabic": "وَٱلْأَوْلَٰدِ", "translit": "ِdَٰlْwَaʾْlٱَw", "root": "ولد"}, {"id": 14, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 15, "arabic": "غَيْثٍ", "translit": "ٍhtْyَغ", "root": "غيث"}, {"id": 16, "arabic": "أَعْجَبَ", "translit": "َbَjgْʿعَaʾ", "root": "عجب"}, {"id": 17, "arabic": "ٱلْكُفَّارَ", "translit": "َrāَّfُkْlٱ", "root": "كفر"}, {"id": 18, "arabic": "نَبَاتُهُۥ", "translit": "ۥُhُtāَbَn", "root": "نبت"}, {"id": 19, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 20, "arabic": "يَهِيجُ", "translit": "ُjgyِhَy", "root": "هيج"}, {"id": 21, "arabic": "فَتَرَىٰهُ", "translit": "ُhٰàَrَtَf", "root": "راي"}, {"id": 22, "arabic": "مُصْفَرًّا", "translit": "āًّrَfْṣُm", "root": "صفر"}, {"id": 23, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 24, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 25, "arabic": "حُطَٰمًا", "translit": "āًmَٰṭُḥ", "root": "حطم"}, {"id": 26, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 27, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 28, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 29, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}, {"id": 30, "arabic": "وَمَغْفِرَةٌ", "translit": "ٌẗَrِfْغَmَw", "root": "غفر"}, {"id": 31, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 32, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 33, "arabic": "وَرِضْوَٰنٌ", "translit": "ٌnَٰwْḍِrَw", "root": "رضو"}, {"id": 34, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 35, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 36, "arabic": "ٱلدُّنْيَآ", "translit": "ٓāَyْnُّdlٱ", "root": "دنو"}, {"id": 37, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 38, "arabic": "مَتَٰعُ", "translit": "ُʿعَٰtَm", "root": "متع"}, {"id": 39, "arabic": "ٱلْغُرُورِ", "translit": "ِrwُrُغْlٱ", "root": "غرر"}], "hasIhya": true}, {"ayah": 21, "text": "سَابِقُوٓا۟ إِلَىٰ مَغْفِرَةٍ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا كَعَرْضِ ٱلسَّمَآءِ وَٱلْأَرْضِ أُعِدَّتْ لِلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦۚ ذَٰلِكَ فَضْلُ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ ", "translation": "Race [i.e., compete] toward forgiveness from your Lord and a Garden whose width is like the width of the heavens and earth, prepared for those who believed in Allāh and His messengers. That is the bounty of Allāh which He gives to whom He wills, and Allāh is the possessor of great bounty.", "words": [{"id": 1, "arabic": "سَابِقُوٓا۟", "translit": "۟āٓwُqِbāَs", "root": "سبق"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "مَغْفِرَةٍ", "translit": "ٍẗَrِfْغَm", "root": "غفر"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "وَجَنَّةٍ", "translit": "ٍẗَّnَjgَw", "root": "جنن"}, {"id": 7, "arabic": "عَرْضُهَا", "translit": "āَhُḍْrَʿع", "root": "عرض"}, {"id": 8, "arabic": "كَعَرْضِ", "translit": "ِḍْrَʿعَk", "root": "عرض"}, {"id": 9, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 10, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, 