: 9, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "نَّبْرَأَهَآ", "translit": "ٓāَhَaʾَrْbَّn", "root": "برا"}, {"id": 17, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 18, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 19, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 20, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "يَسِيرٌ", "translit": "ٌryِsَy", "root": "يسر"}], "hasIhya": false}, {"ayah": 23, "text": "لِّكَيْلَا تَأْسَوْا۟ عَلَىٰ مَا فَاتَكُمْ وَلَا تَفْرَحُوا۟ بِمَآ ءَاتَىٰكُمْۗ وَٱللَّهُ لَا يُحِبُّ كُلَّ مُخْتَالٍ فَخُورٍ ", "translation": "In order that you not despair over what has eluded you and not exult [in pride] over what He has given you. And Allāh does not like everyone self-deluded and boastful -", "words": [{"id": 1, "arabic": "لِّكَيْلَا", "translit": "āَlْyَkِّl", "root": ""}, {"id": 2, "arabic": "تَأْسَوْا۟", "translit": "۟āْwَsْaʾَt", "root": "اسو"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "فَاتَكُمْ", "translit": "ْmُkَtāَf", "root": "فوت"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَفْرَحُوا۟", "translit": "۟āwُḥَrْfَt", "root": "فرح"}, {"id": 8, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 9, "arabic": "ءَاتَىٰكُمْ", "translit": "ْmُkٰàَtāَء", "root": "اتي"}, {"id": 10, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 13, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 14, "arabic": "مُخْتَالٍ", "translit": "ٍlāَtْhkُm", "root": "خيل"}, {"id": 15, "arabic": "فَخُورٍ", "translit": "ٍrwُhkَf", "root": "فخر"}], "hasIhya": true}, {"ayah": 24, "text": "ٱلَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِۗ وَمَن يَتَوَلَّ فَإِنَّ ٱللَّهَ هُوَ ٱلْغَنِىُّ ٱلْحَمِيدُ ", "translation": "[Those] who are stingy and enjoin upon people stinginess. And whoever turns away[1] - then indeed, Allāh is the Free of need, the Praiseworthy.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَبْخَلُونَ", "translit": "َnwُlَhkْbَy", "root": "بخل"}, {"id": 3, "arabic": "وَيَأْمُرُونَ", "translit": "َnwُrُmْaʾَyَw", "root": "امر"}, {"id": 4, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "بِٱلْبُخْلِ", "translit": "ِlْhkُbْlٱِb", "root": "بخل"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "يَتَوَلَّ", "translit": "َّlَwَtَy", "root": "ولي"}, {"id": 8, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "ٱلْغَنِىُّ", "translit": "ُّàِnَغْlٱ", "root": "غني"}, {"id": 12, "arabic": "ٱلْحَمِيدُ", "translit": "ُdyِmَḥْlٱ", "root": "حمد"}], "hasIhya": false}, {"ayah": 25, "text": "لَقَدْ أَرْسَلْنَا رُسُلَنَا بِٱلْبَيِّنَٰتِ وَأَنزَلْنَا مَعَهُمُ ٱلْكِتَٰبَ وَٱلْمِيزَانَ لِيَقُومَ ٱلنَّاسُ بِٱلْقِسْطِۖ وَأَنزَلْنَا ٱلْحَدِيدَ فِيهِ بَأْسٌ شَدِيدٌ وَمَنَٰفِعُ لِلنَّاسِ وَلِيَعْلَمَ ٱللَّهُ مَن يَنصُرُهُۥ وَرُسُلَهُۥ بِٱلْغَيْبِۚ إِنَّ ٱللَّهَ قَوِىٌّ عَزِيزٌ ", "translation": "We have already sent Our messengers with clear evidences and sent down with them the Scripture and the balance that the people may maintain [their affairs] in justice. And We sent down iron, wherein is great military might and benefits for the people, and so that Allāh may make evident those who support Him and His messengers unseen. Indeed, Allāh is Powerful and Exalted in Might.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "رُسُلَنَا", "translit": "āَnَlُsُr", "root": "رسل"}, {"id": 4, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 5, "arabic": "وَأَنزَلْنَا", "translit": "āَnْlَznَaʾَw", "root": "نزل"}, {"id": 6, "arabic": "مَعَهُمُ", "translit": "ُmُhَʿعَm", "root": ""}, {"id": 7, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 8, "arabic": "وَٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱَw", "root": "وزن"}, {"id": 9, "arabic": "لِيَقُومَ", "translit": "َmwُqَyِl", "root": "قوم"}, {"id": 10, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 11, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 12, "arabic": "وَأَنزَلْنَا", "translit": "āَnْlَznَaʾَw", "root": "نزل"}, {"id": 13, "arabic": "ٱلْحَدِيدَ", "translit": "َdyِdَḥْlٱ", "root": "حدد"}, {"id": 14, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 15, "arabic": "بَأْسٌ", "translit": "ٌsْaʾَb", "root": "باس"}, {"id": 16, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}, {"id": 17, "arabic": "وَمَنَٰفِعُ", "translit": "ُʿعِfَٰnَmَw", "root": "نفع"}, {"id": 18, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 19, "arabic": "وَلِيَعْلَمَ", "translit": "َmَlْʿعَyِlَw", "root": "علم"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 22, "arabic": "يَنصُرُهُۥ", "translit": "ۥُhُrُṣnَy", "root": "نصر"}, {"id": 23, "arabic": "وَرُسُلَهُۥ", "translit": "ۥُhَlُsُrَw", "root": "رسل"}, {"id": 24, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 25, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 26, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "قَوِىٌّ", "translit": "ٌّàِwَq", "root": "قوي"}, {"id": 28, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}], "hasIhya": false}, {"ayah": 26, "text": "وَلَقَدْ أَرْسَلْنَا نُوحًا وَإِبْرَٰهِيمَ وَجَعَلْنَا فِى ذُرِّيَّتِهِمَا ٱلنُّبُوَّةَ وَٱلْكِتَٰبَۖ فَمِنْهُم مُّهْتَدٍۖ وَكَثِيرٌ مِّنْهُمْ فَٰسِقُونَ ", "translation": "And We have already sent Noah and Abraham and placed in their descendants prophethood and scripture; and among them is he who is guided, but many of them are defiantly disobedient.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "نُوحًا", "translit": "āًḥwُn", "root": ""}, {"id": 4, "arabic": "وَإِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾَw", "root": ""}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ذُرِّيَّتِهِمَا", "translit": "āَmِhِtَّyِّrُhd", "root": "ذرر"}, {"id": 8, "arabic": "ٱلنُّبُوَّةَ", "translit": "َẗَّwُbُّnlٱ", "root": "نبا"}, {"id": 9, "arabic": "وَٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱَw", "root": "كتب"}, {"id": 10, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 11, "arabic": "مُّهْتَدٍ", "translit": "ٍdَtْhُّm", "root": "هدي"}, {"id": 12, "arabic": "وَكَثِيرٌ", "translit": "ٌryِhtَkَw", "root": "كثر"}, {"id": 13, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 14, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 27, "text": "ثُمَّ قَفَّيْنَا عَلَىٰٓ ءَاثَٰرِهِم بِرُسُلِنَا وَقَفَّيْنَا بِعِيسَى ٱبْنِ مَرْيَمَ وَءَاتَيْنَٰهُ ٱلْإِنجِيلَ وَجَعَلْنَا فِى قُلُوبِ ٱلَّذِينَ ٱتَّبَعُوهُ رَأْفَةً وَرَحْمَةً وَرَهْبَانِيَّةً ٱبْتَدَعُوهَا مَا كَتَبْنَٰهَا عَلَيْهِمْ إِلَّا ٱبْتِغَآءَ رِضْوَٰنِ ٱللَّهِ فَمَا رَعَوْهَا حَقَّ رِعَايَتِهَاۖ فَـَٔاتَيْنَا ٱلَّذِينَ ءَامَنُوا۟ مِنْهُمْ أَجْرَهُمْۖ وَكَثِيرٌ مِّنْهُمْ فَٰسِقُونَ ", "translation": "Then We sent following their footsteps [i.e., traditions] Our messengers and followed [them] with Jesus, the son of Mary, and gave him the Gospel. And We placed in the hearts of those who followed him compassion and mercy and monasticism, which they innovated; We did not prescribe it for them except [that they did so] seeking the approval of Allāh. But they did not observe it with due observance. So We gave the ones who believed among them their reward, but many of them are defiantly disobedient.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "قَفَّيْنَا", "translit": "āَnْyَّfَq", "root": "قفو"}, {"id": 3, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 4, "arabic": "ءَاثَٰرِهِم", "translit": "mِhِrَٰhtāَء", "root": "اثر"}, {"id": 5, "arabic": "بِرُسُلِنَا", "translit": "āَnِlُsُrِb", "root": "رسل"}, {"id": 6, "arabic": "وَقَفَّيْنَا", "translit": "āَnْyَّfَqَw", "root": "قفو"}, {"id": 7, "arabic": "بِعِيسَى", "translit": "àَsyِʿعِb", "root": ""}, {"id": 8, "arabic": "ٱبْنِ", "translit": "ِnْbٱ", "root": "بني"}, {"id": 9, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 10, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 11, "arabic": "ٱلْإِنجِيلَ", "translit": "َlyِjgnِiʾْlٱ", "root": ""}, {"id": 12, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "قُلُوبِ", "translit": "ِbwُlُq", "root": "قلب"}, {"id": 15, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "ٱتَّبَعُوهُ", "translit": "ُhwُʿعَbَّtٱ", "root": "تبع"}, {"id": 17, "arabic": "رَأْفَةً", "translit": "ًẗَfْaʾَr", "root": "راف"}, {"id": 18, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 19, "arabic": "وَرَهْبَانِيَّةً", "translit": "ًẗَّyِnāَbْhَrَw", "root": "رهب"}, {"id": 20, "arabic": "ٱبْتَدَعُوهَا", "translit": "āَhwُʿعَdَtْbٱ", "root": "بدع"}, {"id": 21, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 22, "arabic": "كَتَبْنَٰهَا", "translit": "āَhَٰnْbَtَk", "root": "كتب"}, {"id": 23, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 24, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 25, "arabic": "ٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱ", "root": "بغي"}, {"id": 26, "arabic": "رِضْوَٰنِ", "translit": "ِnَٰwْḍِr", "root": "رضو"}, {"id": 27, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 29, "arabic": "رَعَوْهَا", "translit": "āَhْwَʿعَr", "root": "رعي"}, {"id": 30, "arabic": "حَقَّ", "translit": "َّqَḥ", "root": "حقق"}, {"id": 31, "arabic": "رِعَايَتِهَا", "translit": "āَhِtَyāَʿعِr", "root": "رعي"}, {"id": 32, "arabic": "فَـَٔاتَيْنَا", "translit": "āَnْyَtāَٔـَf", "root": "اتي"}, {"id": 33, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 34, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 35, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 36, "arabic": "أَجْرَهُمْ", "translit": "ْmُhَrْjgَaʾ", "root": "اجر"}, {"id": 37, "arabic": "وَكَثِيرٌ", "translit": "ٌryِhtَkَw", "root": "كثر"}, {"id": 38, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 39, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 28, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَءَامِنُوا۟ بِرَسُولِهِۦ يُؤْتِكُمْ كِفْلَيْنِ مِن رَّحْمَتِهِۦ وَيَجْعَل لَّكُمْ نُورًا تَمْشُونَ بِهِۦ وَيَغْفِرْ لَكُمْۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "O you who have believed, fear Allāh and believe in His Messenger; He will [then] give you a double portion of His mercy and make for you a light by which you will walk and forgive you; and Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَءَامِنُوا۟", "translit": "۟āwُnِmāَءَw", "root": "امن"}, {"id": 7, "arabic": "بِرَسُولِهِۦ", "translit": "ۦِhِlwُsَrِb", "root": "رسل"}, {"id": 8, "arabic": "يُؤْتِكُمْ", "translit": "ْmُkِtْwʾُy", "root": "اتي"}, {"id": 9, "arabic": "كِفْلَيْنِ", "translit": "ِnْyَlْfِk", "root": "كفل"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "رَّحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَّr", "root": "رحم"}, {"id": 12, "arabic": "وَيَجْعَل", "translit": "lَʿعْjgَyَw", "root": "جعل"}, {"id": 13, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 14, "arabic": "نُورًا", "translit": "āًrwُn", "root": "نور"}, {"id": 15, "arabic": "تَمْشُونَ", "translit": "َnwُhsْmَt", "root": "مشي"}, {"id": 16, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 17, "arabic": "وَيَغْفِرْ", "translit": "ْrِfْغَyَw", "root": "غفر"}, {"id": 18, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 19, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 20, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 21, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 29, "text": "لِّئَلَّا يَعْلَمَ أَهْلُ ٱلْكِتَٰبِ أَلَّا يَقْدِرُونَ عَلَىٰ شَىْءٍ مِّن فَضْلِ ٱللَّهِۙ وَأَنَّ ٱلْفَضْلَ بِيَدِ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ ", "translation": "[This is] so that the People of the Scripture may know that they are not able [to obtain] anything from the bounty of Allāh[1] and that [all] bounty is in the hand[2] of Allāh; He gives it to whom He wills. And Allāh is the possessor of great bounty.", "words": [{"id": 1, "arabic": "لِّئَلَّا", "translit": "āَّlَyʾِّl", "root": ""}, {"id": 2, "arabic": "يَعْلَمَ", "translit": "َmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "أَهْلُ", "translit": "ُlْhَaʾ", "root": "اهل"}, {"id": 4, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 6, "arabic": "يَقْدِرُونَ", "translit": "َnwُrِdْqَy", "root": "قدر"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "فَضْلِ", "translit": "ِlْḍَf", "root": "فضل"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 13, "arabic": "ٱلْفَضْلَ", "translit": "َlْḍَfْlٱ", "root": "فضل"}, {"id": 14, "arabic": "بِيَدِ", "translit": "ِdَyِb", "root": "يدي"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "يُؤْتِيهِ", "translit": "ِhyِtْwʾُy", "root": "اتي"}, {"id": 17, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 18, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 19, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 20, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 21, "arabic": "ٱلْفَضْلِ", "translit": "ِlْḍَfْlٱ", "root": "فضل"}, {"id": 22, "arabic": "ٱلْعَظِيمِ", "translit": "ِmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "أنه فيماذا يتفكر لم يقدر عليه لأن مجارى الفكر غير محصورة وثمراته غير متناهية نعم نحن نجتهد في ضبط مجاريه بالإضافة إلى مهمات العلوم الدينية وبالإضافة إلى الأحوال التى هى مقامات السالكين ويكون ذلك ضبطا جمليا فإن تفصيل ذلك يستدعى شرح العلوم كلها وجملة هذه الكتب كالشرح لبعضها فإنها مشتملة على علوم تلك العلوم تستفاد من أفكار مخصوصة فلنشر إلى ضبط الجامع فيها ليحصل الوقوف على مجارى الفكر. بيان مجارى الفكر أعلم أن الفكر قد يجرى في أمر يتعلق بالدين وقد يجرى فيما يتعلق بغير الدين وإنما غرضنا ما يتعلق بالد", "english": "That in what he thinks about, he cannot encompass it because the channels of thought are not limited and its fruits are endless. Yes, we strive to control its channels in addition to the important matters of religious sciences and in addition to the states (Ahwal) which are the stations (Maqamat) of the travelers (Salikin), and that will be a general control, for detailing that requires explaining all the sciences, and the entirety of these books is like an explanation of some of them, for they contain sciences of those sciences derived from specific thoughts. So let us proceed to controlling the comprehensive in them to achieve understanding of the channels of thought. Explanation of the channels of thought: Know that thought may run in a matter related to religion and may run in what is related to non-religion, and our aim is what is related to religion, so we leave the other division and concern ourselves with religion as the transaction (Mu'amalah) that is between the servant (Abd) and the Lord (Rabb) Almighty. So all the thoughts of the servant are either related to the servant and his attributes and his states (Ahwal), or related to the Worshipped One (Ma'bud) and His attributes and His actions; it is not possible to go beyond these two divisions. And what is related to the servant is either a view in what is beloved (Mahbub) to the Lord Almighty or in what is disliked (Makruh), and there is no need for thought in other than these two divisions. And what is related to the Lord Almighty is either a view in His Essence (Dhat) and His attributes and His Beautiful Names (Asma' al-Husna), or in His actions and His dominion (Mulk) and His sovereignty (Malakut) and all that is in the heavens and the earth and what is between them. And it becomes clear to you the confinement of thought in these divisions with an example, which is that the state of those who walk to Allah Almighty and yearn for His meeting relates to His Beloved (Ma'shuq) or relates to himself. So if he thinks about His Beloved, then either he thinks about His beauty and the goodness of His image in His Essence to enjoy thinking about Him and witnessing Him, or he thinks about His gentle, good actions indicating His morals and attributes to make that a multiplier of pleasure and a strengthener of his love (Mahabbah). And if he thinks about himself, then his thought is in his attributes that drop him from the eye of his Beloved so that he abstains from them, or in the attributes that bring him near to Him and make him beloved to Him so that he becomes characterized by them. So if he thinks about something outside of these divisions, then that is outside the limit of love (Ishq) and is a deficiency in it, because the complete, perfect love (Ishq) is what overwhelms the lover (Ashiq) and fills the heart (Qalb) so that it leaves no room for other than it. So the lover (Muhibb) of Allah Almighty should be like that, so his view and thought do not go beyond his Beloved. And as long as his thought is confined in these four divisions, it is not outside the requirement of love (Mahabbah) at all. So let us begin with the first division, which is his thinking about the attributes of himself and the actions of himself to distinguish the beloved from them from the disliked, for this thought is what relates to the science of transaction (Ilm al-Mu'amalah) which is the intended purpose of this book. And as for the other division, it relates to the science of unveiling (Ilm al-Mukashafah), then every.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "2": [{"arabic": "فإذا دخلت السوق فقل لا إله إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت وهو حي لا يموت بيده الخير وهو على كل شيء قدير", "english": "When you enter the market, say: There is no god but Allah alone, He has no partner, to Him belongs the dominion (al-Mulk) and to Him belongs the praise, He gives life (Yuhyi) and causes death (Yumit), and He is living (Hayy) who does not die, in His hand is the good, and He is over all things capable (Qadir).", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter", "badge": "Afterlife"}, {"arabic": "حديث القول عند دخول السوق لا إله إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت وهو حي لا يموت بيده الخير وهو على كل شيء قدير من حديث عمر وقال غريب والحاكم وقال صحيح على شرط الشيخين.", "english": "The hadith of the saying upon entering the market: 'There is no god but Allah alone, with no partner to Him, to Him belongs the Kingdom (Mulk) and to Him belongs the Praise, He gives life (Yuhyi) and He causes death (Yumit), and He is Living (Hayy) and does not die, in His hand is the good, and He is over every thing All-Powerful (Qadir).' From the hadith of Umar, and he said: 'It is rare (Gharib),' and Al-Hakim said: 'It is authentic according to the conditions of the two Shaykhs.'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication", "badge": "Hadith"}, {"arabic": "يا من هو على كل شيء قدير", "english": "O You Who is over every thing powerful (Qadir).", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din", "badge": "General"}], "3": [{"arabic": "الأصل الثالث: العلم بأنه تعالى مع كونه أزليا أبديا ليس لوجوده آخر فهو الأول والآخر والظاهر والباطن لأن ما ثبت قدمه استحال عدمه وبرهانه أنه لو انعدم لكان لا يخلو إما أن ينعدم بنفسه أو بمعدم يضاده ولو جاز أن ينعدم شيء يتصور دوامه لجاز أن يوجد شيء يتصور عدمه بنفسه فكما يحتاج طريان الوجود إلى سبب فكذلك يحتاج طريان العدم إلى سبب وباطل أن ينعدم بمعدم يضاده لأن ذلك المعدم لو كان قديما لما تصور الوجود معه وقد ظهر بالأصلين السابقين وجوده وقدمه فكيف كان وجوده في القدم ومعه ضده فإن كان الضد المعدم حادثا كا", "english": "The Third Foundation: The knowledge that He, exalted is He, while being eternal (Azali) everlasting (Abadi), has no end to His existence, so He is the First (Al-Awwal) and the Last (Al-Akhir) and the Manifest (Al-Zahir) and the Hidden (Al-Batin) because what has been established as eternal (Qidm) is impossible to be non-existent. Its proof is that if He were to become non-existent, it would not be free from either becoming non-existent by Himself or by a nullifier that opposes Him. And if it were permissible for something whose continuity is conceivable to become non-existent, then it would be permissible for something whose non-existence is conceivable to exist by itself. Just as the coming into being (Turyan) of existence needs a cause, similarly the coming into being of non-existence needs a cause. And it is false that He becomes non-existent by a nullifier that opposes Him because that nullifier, if it were eternal (Qadim), existence with it would not be conceivable. And it has become clear through the two previous foundations His existence and His eternity (Qidm), so how could His existence be in eternity (Qidm) while with Him is His opposite? If the opposing nullifier is originated (Hadith), it is impossible, for the originated (Hadith) is not in opposing the eternal (Qadim) so as to cut off His existence more deserving than the eternal (Qadim) in opposing the originated (Hadith) so as to repel its existence. Rather, repelling is easier than cutting off, and the eternal (Qadim) is stronger and more deserving than the originated (Hadith).", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Foundations of Belief'", "badge": "Insight"}, {"arabic": "فلما ذكر ذلك عالم الشهادة استبعد منه ذلك وقيل له: كيف يكون هو الأول والاخر وهما وصفان متناقضان، وكيف يكون هو الظاهر والباطن؛ فالأول ليس بآخر، والظاهر ليس بباطن؛ فقال: هو الأول بالإضافة إلى الموجودات، إذ صدر منه الكل على ترتيبه واحداً بعد واحد، وهو الآخر بالإضافة إلى سير السائرين إليه فإنهم لا يزالون مترقين من منزل إلى منزل إلى أن يقع الانتهاء إلى تلك الحضرة، فيكون ذلك آخر السفر، فهو آخر في المشاهدة أول في الوجود، وهو باطن بالإضافة إلى العاكفين في عالم الشهادة الطالبين لإدراكه بالحواس الخمس، ظاهر", "english": "When the witness of the visible world mentioned that, it was rejected from him and it was said to him: How can He be the First (Al-Awwal) and the Last (Al-Akhir) when they are two contradictory attributes, and how can He be the Manifest (Al-Zahir) and the Hidden (Al-Batin); for the First is not the Last, and the Manifest is not the Hidden. He said: He is the First in relation to the existents, since the whole issued from Him in its order one after another, and He is the Last in relation to the journey of the travelers (Al-Sa'irin) to Him, for they do not cease ascending from one station (Manzil) to another until the termination occurs to that presence (Hadhra), so that becomes the end of the journey. Thus, He is the Last in witnessing (Mushahada) and the First in existence (Wujud). And He is Hidden in relation to those who dwell in the world of the visible (Alam Al-Shahada) seeking to perceive Him with the five senses, Manifest in relation to those who seek Him in the lamp that has ignited in his heart (Qalb) with the inner insight (Al-Basira Al-Batina) penetrating into the world of the dominion (Alam Al-Malakut). This was the unification (Tawhid) of the travelers (Al-Salikin) on the path of unification in action: I mean those to whom it was revealed that the Doer (Al-Fa'il) is one.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}, {"arabic": "الأصل الثاني: العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك إلى الاستدلال بالخلق على العلم بأنك لا تستريب في دلالة الخلق اللطيف والصنع المزين بالترتيب ولو في الشيء الحقير الضعيف على علم الصانع بكيفية الترتيب والترصيف فما ذكره الله سبحانه هو المنتهى في الهداية والتعريف.", "english": "The Second Foundation: The knowledge that He, exalted is He, is Knower (ʿĀlim) of all existents and encompasses every created thing; not even an atom's weight in the earth or in the heavens escapes His knowledge, truthful in His saying: 'And He is, of all things, Knowing (ʿAlīm).' And a guide to its truthfulness is His saying, exalted is He: 'Does He not know, He Who created? And He is the Subtle (Al-Laṭīf), the Aware (Al-Khabīr).' He guides you to the deduction from creation to the knowledge that you do not doubt in the indication of the subtle creation and the work adorned with arrangement, even in the insignificant, weak thing, regarding the knowledge of the Maker concerning the manner of arrangement and composition. So what God, glorified is He, has mentioned is the ultimate in guidance and definition.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Foundations of Belief'", "badge": "Dhikr"}, {"arabic": "وأنه واحد قديم لا أول له أزلي لا بداية له مستمر الوجود لا آخر له أبدي لا نهاية له قيوم لا انقطاع له دائم لا انصرام له لم يزل ولا يزال موصوفا بنعوت الجلال لا يقضي عليه بالانقضاء والانفصال بتصرم الآباد وانقراض الآجال بل \"هُوَ الْأَوَّلُ وَالْآخِرُ وَالظَّاهِرُ وَالْبَاطِنُ ۖ وَهُوَ بِكُلِّ شَيْءٍ عَلِيمٌ\". التنزيه: وأنه ليس بجسم مصور ولا جوهر محدود مقدر وأنه لا يماثل والأجسام ولا في التقدير ولا في قبول الانقسام وأنه ليس بجوهر ولا تحله الجواهر ولا بعرض ولا تحله الأعراض بل لا يماثل موجوداً ولا يماثل", "english": "And He is One, Ancient (Qadim) without beginning, Eternal (Azali) without commencement, continuous in existence without end, Everlasting (Abadi) without termination, Self-Subsisting (Qayyum) without interruption, perpetual without cessation. He has not ceased and will not cease being described with attributes of majesty; He is not subject to extinction or separation by the passing of ages and the extinction of terms. Rather, \"He is the First and the Last, the Manifest and the Hidden, and He is, of all things, Knowing.\" The Transcendence (Tanzih): And He is not a formed body nor a limited, measured substance, and He does not resemble bodies, neither in measurement nor in accepting division. And He is not a substance nor do substances inhere in Him, nor an accident nor do accidents inhere in Him. Rather, He does not resemble any existent, nor does any existent resemble Him. \"There is nothing like unto Him,\" nor is He like anything.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Foundations of Belief'", "badge": "General"}], "9": [{"arabic": "فالأكياس وأرباب البصائر قلوبهم \"كمشكاة فيها مصباح المصباح في زجاجة الزجاجة كأنها كوكب دري يوقد من شجرة مباركة زيتونة لا شرقية ولا غربية يكاد زيتها يضيء ولو لم تمسسه نار نور على نور\" والمغترون قلوبهم \"كظلمات في بحر لجي يغشاه موج من فوقه سحاب ظلمات بعضها فوق بعض إذا أخرج يده لم يكد يراها ومن لم يجعل الله له نوراً فما له من نور\" فالأكياس هم الذين أراد الله أن يهديهم فشرح صدورهم للإسلام والهدى، والمغترون هم الذين أراد الله أن يضلهم فجعل صدرهم ضيقاً حرجاً كأنما يصعد في السماء. والمغرور هو الذي لم تنف", "english": "The wise and possessors of insight (Basa'ir), their hearts (Qulub) are \"like a niche containing a lamp, the lamp in a glass, the glass as if it were a brilliant star, lit from a blessed olive tree, neither of the east nor of the west, whose oil would almost glow even if untouched by fire. Light upon light.\" And the deluded, their hearts (Qulub) are \"like layers of darkness in a deep sea covered by waves, upon which are waves, above which are clouds; layers of darkness, one above another. When one puts out his hand, he can hardly see it. And he for whom Allah has not appointed light, for him there is no light.\" So the wise are those whom Allah intended to guide, so He expanded their chests (Sudur) for Islam and guidance (Huda). And the deluded are those whom Allah intended to lead astray, so He made their chests (Sudur) tight and constricted, as if they were climbing into the sky. And the deluded one is he whose insight (Basirah) has not opened to be sufficient for the guidance (Hidayah) of his self (Nafs) and", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Condemnation of Delusion'", "badge": "Dhikr"}], "10": [{"arabic": "والذي يقتضي الإيمان بهذا الأمر في القرآن والسنة وأقاويل العلماء أكثر من أن يحصر. قال الله تعالى \"ونهى النفس عن الهوى فإن الجنة هي المأوى\" وقال تعالى \"أولئك الذين امتحن الله قلوبهم للتقوى\" قيل نزع منها محبة الشهوات. وقال ﭬ \"المؤمن بين خمس شدائد: مؤمن يحسده ومنافق يبغضه وكافر يقاتله وشيطان يضله ونفس تنازعه\"[43] فبين أن النفس عدو منازع يجب عليه مجاهدته. ويروى أن الله تعالى أوحى إلى داود عليه السلام يا داود حذر وأنذر أصحابك أكل الشهوات فإن القلوب المتعلقة بشهوات الدنيا عقولها عني محجوبة. وقال عيسى ع", "english": "And that which necessitates faith in this matter from the Quran, the Sunnah, and the sayings of the scholars is more than can be enumerated. Allah the Exalted said: 'And he who restrains the Soul (Nafs) from desire (Hawa), indeed Paradise will be his refuge.' And He the Exalted said: 'Those are the ones whose hearts Allah has tested for piety (Taqwa).' It is said: He removed from them the love of desires. And he (the Prophet, peace be upon him) said: 'The believer is between five hardships: a believer who envies him, a hypocrite who hates him, a disbeliever who fights him, a devil who misguides him, and a Soul (Nafs) that contends with him.' [43] Thus, he clarified that the Soul (Nafs) is a contentious enemy that must be struggled against. And it is narrated that Allah the Exalted revealed to David, peace be upon him: 'O David, warn and admonish your companions against consuming desires, for the hearts attached to the desires of the world have their intellects veiled from Me.' And Jesus, peace be upon him, said: 'Blessed is he who leaves a present desire for a promised unseen that he has not seen.' And our Prophet (peace be upon him) said to a people who returned from military struggle (Jihad): 'Welcome, you have come from the lesser struggle (Jihad) to the greater struggle (Jihad).' It was said: 'O Messenger of Allah, and what is the greater struggle?' He said: 'The struggle against the Soul (Nafs).' [44] And he (peace be upon him) said: 'The struggler (Mujahid) is he who struggles against his Soul (Nafs) in obedience to Allah the Exalted.' [45] And he (peace be upon him) said: 'Restrain your harm from your Soul (Nafs) and do not follow its desire (Hawa) in disobedience to Allah the Exalted, lest it dispute with you on a day when some of you will help others, except that Allah the Exalted forgives and covers.' [46] And Sufyan al-Thawri said: 'I have not treated anything more difficult for me than my Soul (Nafs); sometimes it is for me and sometimes against me.' And Abu al-Abbas al-Mu...", "book_file": "vol3_Vol3-book2a.doc.txt", "book_title": "Breaking the Two Desires", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Breaking the Two Desires'", "badge": "Insight"}, {"arabic": "وقد قال تعالى: ﴿ لا يستوي منكم من أنفق من قبل الفتح وقاتل ﴾ {} الآية.", "english": "And Allah the Exalted has said: 'Not equal among you are those who spent before the Conquest and fought' {} the verse.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Foundations of Belief'", "badge": "General"}], "11": [{"arabic": "وقد انخدع بمثل هذا الخيال طائفة وسلكوا طريق الإباحة وقالوا إن الله تعالى غنى عن عبادتنا وعن أن يستقرض منا فأي معنى لقوله: ﴿ من ذا الذي يقرض الله قرضا حسنا ﴾ {} ولو شاء الله إطعام المساكين لأطعمهم فلا حاجة بنا إلى صرف أموالنا إليهم كما قال تعالى حكاية عن الكفار: ﴿ وإذا قيل لهم أنفقوا مما رزقكم الله قال الذين كفروا للذين آمنوا أنطعم من لو يشاء الله أطعمه ﴾ {} وقالوا أيضا ﴿ لو شاء الله ما أشركنا ولا آباؤنا ﴾ {} فانظر كيف كانوا صادقين في كلامهم وكيف هلكوا بصدقهم فسبحان من إذا شاء أهلك بالصدق وإذا شا", "english": "And a group has been deceived by such imagination and took the path of permissiveness and said: 'Indeed Allah the Exalted is independent of our worship and of borrowing from us, so what meaning is there to His saying: \"Who is it that would loan Allah a goodly loan so He may multiply it for him and he will have a noble reward?\" (Quran 57:11) And if Allah willed to feed the poor, He would feed them, so there is no need for us to spend our wealth on them, as Allah the Exalted said narrating from the disbelievers: \"And when it is said to them, 'Spend from that which Allah has provided for you,' those who disbelieve say to those who believe, 'Should we feed one whom, if Allah had willed, He would have fed?\" (Quran 36:47) And they also said: \"If Allah had willed, we would not have associated [anything with Him] nor would our fathers.\" (Quran 6:148) So look how they were truthful in their speech and how they perished by their truthfulness. Glory be to the One who, when He wills, destroys with truthfulness and when He wills, makes happy with ignorance; He misleads many thereby and guides many thereby. So these, when they thought that they were employed for the sake of the poor and the needy, exalted is Allah, then said: 'There is no share for us in the poor, and there is no share for Allah in us and in our wealth, whether we spend or withhold,' they perished just as the boy perished when he thought that the father's intention was to employ him for the sake of the slaves, and he did not realize that the intended purpose was the establishment of the attribute of knowledge in his self (Nafs) and its confirmation in his heart (Qalb) so that it would be the cause of his happiness in this world. And that was from the father only as gentleness with him in drawing him to what contains his happiness. So this example clarifies for you the misguidance of those who went astray from this path.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "ولأجل محبة الله تعالى لبقاء النفوس أمر بالإطعام وحث عليه وعبر عنه بعبادة القرض فقال من ذا الذي يقرض الله قرضا حسنا فإن قلت قولك إن بقاء النسل والنفس محبوب يوهم أن فناءها مكروه عند الله وهو فرق بين الموت والحياة بالإضافة إلى إرادة الله تعالى ومعلوم أن الكل بمشيئة الله وإن الله غني عن العالمين فمن أين يتميز عنده موتهم عن حياتهم أو بقاؤهم عن فنائهم فاعلم أن هذه الكلمة حق أريد بها باطل فإن ما ذكرناه لا ينافي إضافة الكائنات كلها إلى إرادة الله خيرها وشرها ونفعها وضرها ولكن المحبة والكراهية يتضادان وك", "english": "And due to the Love (Mahabbah) of Allah, the Exalted, for the preservation of the Souls (Nafs), He commanded feeding and urged upon it, and expressed it through the worship (Ibadah) of the Loan (Qard), saying: 'Who is it that will lend Allah a goodly loan?' (Quran 57:11). If you say: your statement that the preservation of progeny and the Soul (Nafs) is beloved implies that its annihilation is hated before Allah, and this is a distinction between death and life in relation to the Will (Iradah) of Allah, the Exalted. And it is known that everything is by the Decree (Mashiyyah) of Allah, and indeed Allah is Free of need from the worlds. So from where is distinguished before Him their death from their life, or their preservation from their annihilation? Know that this statement is truth intended by it falsehood, for what we have mentioned does not contradict attributing all existents entirely to the Will (Iradah) of Allah—their good and evil, their benefit and harm. But Love (Mahabbah) and Hatred (Karāhiyyah) are opposites, and both do not oppose the Will (Iradah). For sometimes a thing willed is hated, and sometimes a thing willed is beloved. Sins (Ma'asi) are hated, and they, with the hatred, are willed. Obediences (Ta'at) are willed, and it is intended that they be willed, beloved, and pleasing. As for disbelief (Kufr) and evil, we do not say it is pleasing and beloved, but it is willed.", "book_file": "vol2_j2-k02.doc.txt", "book_title": "Etiquette of Marriage", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Etiquette of Marriage'", "badge": "Insight"}, {"arabic": "فإن قلت: فقد حث الشرع على الأعمال وبالغ في ذكر فضلها حتى طلب الصدقات بقوله: ﴿ من ذا الذي يقرض الله قرضا حسنا ﴾ {} وقال تعالى: ﴿ ويأخذ الصدقات ﴾ {} فكيف لا يكون الفعل والإنفاق هو الأفضل. فاعلم أن الطبيب إذا أثنى على الدواء لم يدل على أن الدواء مراد لعينه أو على أنه أفضل من الصحة والشفاء الحاصل به ولكن الأعمال علاج لمرض القلوب ومرض القلوب مما لا يشعر به غالبا فهو كبرص على وجه من لا مرآة معه فإنه لا يشعر به ولو ذكر له لا يصدق به والسبيل معه المبالغة في الثناء على غسل الوجه بماء الورد مثلا إن كان ما", "english": "If you say: Indeed, the Sacred Law (Sharia) has urged upon works (A'mal) and exaggerated in mentioning their virtue until it sought alms (Sadaqat) by His saying: \"Who is it that would loan Allah a goodly loan (Qardan Hasan) so He may multiply it for him and he will have a noble reward?\" (Quran 57:11) and He the Exalted said: \"And He takes the alms (Sadaqat)\" (Quran 9:104), so how can the action (Fi'l) and spending (Infaq) not be the best? Then know that when the physician praises the medicine, it does not indicate that the medicine is desired for itself or that it is better than the health (Sihha) and healing (Shifa) attained through it. Rather, works (A'mal) are a treatment (Ilaj) for the disease (Marad) of the hearts (Qulub), and the disease of the hearts is something that most do not perceive. It is like leprosy (Baras) on the face of one who has no mirror with him, for he does not perceive it, and even if it is mentioned to him, he does not believe it. The way with him is to exaggerate in praising washing the face with rosewater (Ma' al-Ward), for example, if rosewater removes the leprosy, until excessive praise spurs him to persist in it, and his disease is removed. For if it were mentioned to him that the intended purpose is the removal of leprosy from your face, perhaps he would abandon the treatment and claim that his face has no defect. And let us give an example closer than this: We say: He has a son whom he taught knowledge (Ilm) and the Quran, and he wanted to establish that in his memory (Hifz) so that it would not depart from him. And he knew that if he ordered him to repeat (Takrir) and study (Dirasa) so that it would remain preserved for him, he would say, \"It is preserved, and I have no need for repetition and study,\" because he thinks that what he memorizes at present remains so forever. And he had slaves, so he ordered the boy to teach the slaves and promised him for that with goodness, so that his motivation (Da'iya) would be abundant for much repetition through teaching. Perhaps the wretched boy thinks that the intended purpose is teaching the slaves the Quran and that he has...", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "12": [{"arabic": "فإذا لم يكن في معرفة الله تعالى إثبات صورة وجهه فلا يكون في استكمال تلك المعرفة بعينها وترقيها في الوضوح إلى غاية الكشف أيضاً جهة وصورة لأنها هي بعينها لا تفترق منها إلا في زيادة الكشف، كما أن الصورة المرئية هي المتخيلة بعينها إلا في زيادة الكشف، وإليه الإشارة بقوله تعالى: \" يسعى نورهم بين أيديهم وبأيمانهم يقولون ربنا أتمم لنا نورنا \" إذ تمام النور لا يؤثر إلا في زيادة التكشف، ولهذا لا يفوز بدرجة النظر والرؤية إلا العارفون في الدنيا، لأن المعرفة هي البذر الذي ينقلب في الآخرة مشاهدة كما تنقلب الن", "english": "If there is no affirmation of the image of His Face in the knowledge of Allah the Exalted, then there is also no direction or image in the completion of that very knowledge and its elevation in clarity to the utmost unveiling, because it is the very same, not differing from it except in increase of unveiling, just as the visible image is the very same as the imagined one except in increase of unveiling. And to this is the allusion in His saying the Exalted: \"Their light runs before them and on their right hands; they say: Our Lord! Perfect our light for us\" since the perfection of the light does not affect except in increase of unveiling. And for this reason, none attains the degree of seeing and vision except the knowers in this world, because the knowledge is the seed that transforms in the Hereafter into witnessing, just as the kernel transforms into a tree and the seed into a crop. And he who has no kernel in his land, how can he obtain a palm tree? And he who does not sow the seed, how can he harvest the crop? Likewise, he who does not know Allah the Exalted in this world, how can he see Him in the Hereafter? And since the knowledge is on varying degrees, the manifestation was also on varying degrees, so the difference of the manifestation in relation to the difference of the knowledges is like the difference of the plant in relation to the difference of the seed, differing inevitably in their abundance and scarcity, goodness and strength, and weakness. And for this reason, the Prophet, peace and blessings be upon him, said: \"Indeed, Allah manifests to people in general and to Abu Bakr in particular.\" So it should not be thought that other than Abu Bakr, from those who are below him, finds from the pleasure of seeing and witnessing what Abu Bakr finds, but he finds only a tenth of his tenth if his knowledge in this world is a tenth of his tenth. And when He favored among people with a secret settled in his chest, He favored inevitably with a manifestation that he alone possessed. And just as you see in this world one who prefers the pleasure of leadership over food and marriage, and you see one who prefers the pleasure of knowledge and the unveiling of the problems of the kingdom of the heavens.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "فالعلم بالله تعالى وصفاته وأفعاله وحكمته في ملكوت السموات والأرض وترتيب الدنيا والآخرة ومايتعلق به هو الكمال الحقيقي الذي يقرب من يتصف به من الله تعالى، ويبقى كمالاً للنفس بعد الموت، وتكون هذه المعرفة نور للعارفين بعد الموت \"يسعى نورهم بين أيديهم وبأيمانهم يقولون ربنا أتمم لنا نورنا\" أي تكون هذه المعرفة رأس مال يوصل إلى كشف ما لم ينكشف في الدنيا، كما أنه معه سراج خفي فإنه يجوز أن يصير ذلك سبباً لزيادة النور بسراج آخر يقتبس منه، فيكمل النور الخفي على سبيل الاستتمام، ومن ليس معه أصل السراج فلا مطم", "english": "The knowledge of Allah the Exalted and His attributes and His actions and His wisdom in the dominion of the heavens and the earth and the arrangement of this world and the hereafter and what pertains to it is the true perfection that brings closer to Allah the Exalted whoever is characterized by it, and it remains a perfection for the Soul (Nafs) after death, and this knowledge becomes a light for the knowers after death: 'Their light runs before them and on their right hands; they say: Our Lord! Perfect our light for us' meaning this knowledge becomes capital that leads to the unveiling of what was not unveiled in this world, just as with it is a hidden lamp, for it is permissible that this becomes a cause for increasing the light with another lamp that is kindled from it, thus completing the hidden light by way of completion, and whoever does not have the original lamp has no hope in that, so whoever does not have the original knowledge of Allah the Exalted has no hope in this light, thus he remains like one whose likeness is in darknesses not exiting from them but 'like darknesses in a deep sea covered by a wave, above which is a wave, above which are clouds; darknesses, one above another.' Therefore, there is no happiness except in the knowledge of Allah the Exalted.", "book_file": "vol3_Vol3-book-8a.doc.txt", "book_title": "Condemnation of Status and Ostentation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "فالمعارف أنوار ولا يسعى المؤمنون إلى لقاء الله تعالى إلا بأنوارهم قال الله تعالى يسعى نورهم بين أيديهم وبأيمانهم وقد روي في الخبر إن بعضهم يعطي نورا مثل الجبل وبعضهم أصغر حتى يكون آخرهم رجلا يعطي نورا على إبهام قدميه فيضيء مرة وينطفيء أخرى فإذا أضاء قدم قدميه فمشى وإذا طفيء قام ومرورهم على الصراط على قدر نورهم فمنهم من يمر كطرف العين ومنهم من يمر كالبرق ومنهم من يمر كالسحاب ومنه من يمر كانقضاض الكواكب ومنهم من يمر كالفرس إذا اشتد في ميدانه والذي أعطى نورا على إبهام قدمه يحبوحبوا على وجهه ويديه و", "english": "The Knowledges (Ma'arif) are lights, and the believers do not hasten to meet Allah the Exalted except with their lights. Allah the Exalted said: 'Their light runs before them and on their right hands.' And it has been narrated in the report that some of them are given a light like a mountain, and some smaller, until the last of them is a man given a light on the tip of his toe; it lights up once and extinguishes another. So when it lights up his foot, he walks, and when it extinguishes, he stands. And their crossing on the Path (Sirat) is according to the measure of their light: among them is one who passes like the blink of an eye, among them is one who passes like lightning, among them is one who passes like clouds, among them is one who passes like the falling of stars, and among them is one who passes like a horse when it speeds in its arena. And the one given a light on the tip of his toe crawls on his face, hands, and legs, dragging one hand and hanging another, and his sides are struck by the Fire, and he does not cease thus until he is saved.", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Disciplining the Soul'", "badge": "Hadith"}], "13": [{"arabic": "وقوله تعالى: \" انظرونا نقتبس من نوركم - قيل ارجعوا وراءكم فالتمسوا نوراً\" يدل على أن الأنوار لا بد وأن يتزود أصلها في الدنيا ثم يزداد في الآخرة إشراقاً. فأما أن يتجدد نور فلا، والحكم في هذا برجم الظنون مخطر، ولم ينكشف لنا فيه بعد ما يوثق به، فنسأل الله تعالى أن يزيدنا علماً ورشداً ويرينا الحق حقاً. فهذا القدر من أنوار البصائر كاشف لحقائق الشوق ومعانيه.", "english": "And His saying, the Exalted: \"Look at us, let us borrow from your light - it is said: Go back behind you and seek light\" indicates that the lights (Anwar) must have their foundation (Asl) acquired in this world (Dunya), then they increase in radiance (Ishraq) in the Hereafter (Akhira). As for a light (Nur) being newly created, no, and judgment in this matter by conjecturing assumptions is dangerous, and nothing reliable has been revealed to us about it yet, so we ask Allah, the Exalted, to increase us in knowledge (Ilm) and guidance (Rushd) and show us the truth as truth. This amount from the lights of insights (Anwar al-Basa'ir) is revealing of the realities (Haqa'iq) of longing (Shawq) and its meanings.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Love, Longing, Intimacy and Contentment'", "badge": "Ethics"}], "14": [{"arabic": "اعلم أن قوله تعالى \"فلا تغرنكم الحياة الدنيا ولا يغرنكم بالله الغرور\" وقوله تعالى \"ولكنكم فتنتم أنفسكم وتربضتم وارتبتم وغرتكم الأماني\" الآية. كاف في ذم الغرور، وقد قال رسول الله ﭬ \"حبذا نوم الأكياس وفطرهم كيف يغبنون سهر الحمقى واجتهادهم ولمثقال ذرة من صاحب تقوى ويقين أفضل من ملئ الأرض من المغترين\"[1] وقال ﭬ \"الكيس من دان نفسه وعمل لما بعد الموت، والأحمق من اتبع نفسه هواها وتمنى على الله\"[2] وكل ما ورد في فضل العلم وذم الجهل فهو دليل على ذم الغرور، لأن الغرور عبارة عن بعض أنواع الجهل، إذ الجهل هو", "english": "Know that the saying of the Exalted \"So let not the worldly life deceive you, nor let the Deceiver (Al-Ghuroor) deceive you concerning Allah\" and His saying \"But you tempted your own selves (Anfusakum) and you waited and doubted and the hopes (Al-Amani) deceived you until the command of Allah came and the Deceiver (Al-Ghuroor) deceived you concerning Allah\" the verse. It is sufficient in censuring deception (Al-Ghuroor), and the Messenger of Allah ﷺ said \"How excellent is the sleep of the intelligent and their breaking of fast, how they surpass the staying awake of the foolish and their striving, and a speck's weight of one with piety (Taqwa) and certainty (Yaqeen) is better than the earth filled with the deceived ones\"[1] and he ﷺ said \"The intelligent is he who holds his self (Nafs) accountable and works for what is after death, and the foolish is he who follows his self (Nafs) its desire (Hawa) and hopes upon Allah\"[2] and all that has come regarding the virtue of knowledge and the censure of ignorance is evidence for censuring deception (Al-Ghuroor), because deception (Al-Ghuroor) is an expression for some types of ignorance, since ignorance is to believe a thing and see it contrary to what it is, and deception (Al-Ghuroor) is ignorance except that there is ignorance that is not deception (Al-Ghuroor), rather it necessitates deception (Al-Ghuroor): a deceived one in it specified and a deceived one by it which is that which deceives him. So whenever the striving one believes something that agrees with desire (Hawa) and the cause necessitating ignorance is a false doubt and imagination that he thinks is evidence and it is not evidence, the ignorance occurring by it is called deception (Al-Ghuroor). So deception (Al-Ghuroor) is the settling of the self (Nafs) to what agrees with desire (Hawa), and inclines to it the natural disposition from a doubt and trick of Satan, so whoever believes that he is upon good either in the immediate or in the ultimate from a false doubt, then he is deceived, and most people think of themselves good and they are mistaken in it, so most people therefore are deceived even if the types of their deception differ and their degrees differ, until the deception of some of them is more apparent and more", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Delusion'", "badge": "Ethics"}, {"arabic": "وقال بعض المفسرين في قوله تعالى: ﴿ فتنتم أنفسكم ﴾ {} قال بالشهوات واللذات ﴿ وتربصتم ﴾ {} قال بالتوبة ﴿ وارتبتم ﴾ {} قال شككتم ﴿ حتى جاء أمر الله ﴾ {} قال الموت ﴿ وغركم بالله الغرور ﴾ {} قال الشيطان.", "english": "And some interpreters said regarding His saying, the Exalted: 'You tempted yourselves (Nafs)' {} He said: with desires and pleasures 'And you awaited' {} He said: with repentance 'And you doubted' {} He said: you doubted 'Until came the command of Allah' {} He said: death 'And deceived you regarding Allah the deceiver' {} He said: Satan.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}], "15": [{"arabic": "فلما كان في آخر عمره قرأ رجل بين يديه فاليوم لا يؤخذ منكم فدية الآية فرأيته قد ارتعد وكاد يسقط فلما عاد إلى حاله سألته عن ذلك فقال نعم يا حبيبي قد ضعفنا وكذلك سمع مرة قوله تعالى الملك يومئذ الحق للرحمن فاضطرب فسأله ابن سالم وكان من أصحابه فقال قد ضعفت فقيل له فإن كان هذا من مضعف فما قوة الحال فقال أن لا يرد عليه وارد إلا وهو يلتقيه بقوة حاله فلا تغيره الواردات وإن كانت قوية", "english": "When he was at the end of his life, a man recited before him 'So today no ransom will be taken from you' the verse, and I saw him tremble and almost fall. When he returned to his state, I asked him about that, and he said: 'Yes, my beloved, we have weakened.' And similarly, he once heard His saying, the Exalted: 'The Sovereignty that Day is the true (sovereignty), belonging to the Most Merciful' and he became agitated. Ibn Salim, who was from his companions, asked him, and he said: 'I have weakened.' So it was said to him: 'If this is from weakness, then what is the strength of the state (Hāl)?' He said: 'That no incoming spiritual state (Wārid) comes upon him except that he meets it with the strength of his state (Hāl), so the incoming states (Wāridāt) do not change him, even if they are strong.'", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Audition and Ecstasy'", "badge": "Insight"}], "19": [{"arabic": "وقد قال أبو بكر الوراق (الصدق ثلاثة صدق التوحيد وصدق الطاعة وصدق المعرفة فصدق التوحيد لعامة المؤمنين قال الله تعالى والذين آمنوا بالله ورسله أولئك هم الصديقون وصدق الطاعة لأهل العلم والورع وصدق المعرفة لأهل الولاية الذين هم أوتاد الأرض) وكل هذا يدور على ما ذكرناه في الصدق السادس ولكنه ذكر أقسام ما فيه الصدق وهو أيضا غير محيط بجميع الأقسام.", "english": "And Abu Bakr al-Warraq said: 'Truthfulness (Sidq) is three: truthfulness in Oneness (Tawhid), truthfulness in obedience (Taa'ah), and truthfulness in knowledge (Ma'rifah). Truthfulness in Oneness is for the general believers. Allah the Exalted said: 'And those who believe in Allah and His messengers - those are the truthful ones (al-Siddiqun).' And truthfulness in obedience is for the people of knowledge and piety, and truthfulness in knowledge is for the people of sainthood (Wilayah) who are the pegs of the earth.' And all of this revolves around what we mentioned in the sixth truthfulness, but he mentioned the divisions of what contains truthfulness, and it is also not encompassing all the divisions.", "book_file": "vol4_j4-k07-old.doc.txt", "book_title": "Intention, Sincerity and Truthfulness", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Intention, Sincerity and Truthfulness'", "badge": "Insight"}, {"arabic": "فإن قلت: فما شبهة المعتزلة والمرجئة وما حجة بطلان قولهم. فأقول شبهتهم عمومات القرآن أما المرجئة فقالوا لا يدخل المؤمن النار وإن أتي بكل المعاصي لقوله عز وجل: ﴿ فمن يؤمن بربه فلا يخاف بخسا ولا رهقا ﴾ {} ولقوله سبحانه وتعالى: ﴿ والذين آمنوا بالله ورسله أولئك هم الصديقون ﴾ {} الآية ولقوله تعالى: ﴿ كلما ألقي فيها فوج سألهم خزنتها. ﴾ {} إلى قوله: ﴿ فكذبنا وقلنا ما نزل الله من شيء ﴾ {} فقوله كلما ألقي فيها فوج عام فينبغي أن يكون من ألقي في النار مكذبا ولقوله تعالى: ﴿ لا يصلاها إلا الأشقى الذي كذب وتول", "english": "If you say: Then what is the doubt of the Mu'tazila and the Murji'a and what is the proof of the falsity of their statement? I say: Their doubt is the generalities of the Quran. As for the Murji'a, they said: The believer does not enter the Fire even if he commits all sins, due to His saying, the Mighty and Majestic: 'So whoever believes in his Lord, he fears neither loss nor tyranny' and due to His saying, the Exalted: 'And those who believe in Allah and His messengers - those are the Truthful Ones (al-Siddiqun)' the verse, and due to His saying: 'Whenever a group is thrown into it, its keepers will ask them...' until His saying: 'So we denied and said: Allah has not sent down anything.' So His saying 'Whenever a group is thrown into it' is general, so it should be that whoever is thrown into the Fire is a denier, and due to His saying: 'None will burn in it except the most wretched, who denied and turned away' and this is restriction, affirmation, and negation, and due to His saying: 'Whoever comes with a good deed will have better than it, and they, from the terror of that Day, will be secure' so Faith (Iman) is the head of good deeds, and due to His saying: 'And Allah loves the Doers of Good (al-Muhsinin)' and He said: 'Indeed, We do not allow to be lost the reward of any who does good in deed.' And they have no proof in that, for when Faith (Iman) is mentioned in these verses, what is intended by it is Faith (Iman) with action, since we have clarified that Faith (Iman) may be used and what is intended by it is Islam, which is agreement with the Heart (Qalb), speech, and action. The evidence for this interpretation is many reports about punishing the disobedient and the measures of punishment, and his saying (peace be upon him): 'He will be brought out of the Fire whoever had in his heart an atom's weight of Faith (Iman)' so how can he be brought out if he did not enter? And from the Quran, His saying: 'Indeed, Allah does not forgive association with Him, but He forgives what is less than that for whom He wills' and the exception with will indicates division, and His saying: 'And whoever disobeys Allah and His Messenger - then indeed, for him is the Fire of Hell, abiding eternally therein' and specifying it with disbelief is arbitrary.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Foundations of Belief'", "badge": "Ethics"}], "20": [{"arabic": "وقد ذكر الله تعالى في آية واحدة سبعة منها فقال: \" زين للناس حب الشهوات من النساء والبنين والقناطير المقنطرة من الذهب والفضة والخيل المسومة والأنعام والحرث ذلك متاع الحياة والدنيا \" ثم رده في آية أخرى إلى خمسة فقال عز وجل: \" اعلموا أنما الحياة الدنيا لعب ولهو وزينة وتفاخر بينكم وتكاثر في الأموال والأولاد \" ثم رده تعالى في موضع آخر إلى اثنين فقال تعالى: \" وإنما الحياة الدنيا لعب ولهو \" ثم رد الكل إلى واحد في موضع آخر فقال: \" ونهى النفس عن الهوى فإن الجنة هي المأوى \" فالهوى لفظ يجمع جميع حظوظ النفس", "english": "And Allah the Exalted mentioned in one verse seven of them, saying: 'Adorned for people is the love of desires from women and sons and heaped-up measures of gold and silver and branded horses and cattle and tilled land. That is the enjoyment of the life of the world.' Then He reduced it in another verse to five, saying the Mighty and Majestic: 'Know that the life of the world is play and amusement and adornment and boasting among you and competition in increase of wealth and children.' Then He reduced it the Exalted in another place to two, saying the Exalted: 'And the life of the world is not but play and amusement.' Then He reduced the whole to one in another place, saying: 'And restrain the Soul (Nafs) from the passion (Hawa), for indeed Paradise is the abode.' So passion (Hawa) is a term that gathers all the shares of the Soul (Nafs) in the world, so it is necessary that asceticism (Zuhd) be in it.", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "ثم رده في آية أخرى إلى خمسة فقال عز وجل: \"اعلموا أنما الحياة الدنيا لعب ولهو وزينة وتفاخر بينكم وتكاثر في الأموال والأولاد\" ثم رده تعالى في موضع آخر إلى اثنين فقال تعالى: \"وإنما الحياة الدنيا لعب ولهو\" ثم رد الكل إلى واحد في موضع آخر فقال: \"ونهى النفس عن الهوى فإن الجنة هي المأوى\" فالهوى لفظ يجمع جميع حظوظ النفس في الدنيا، فينبغي أن يكون الزهد فيه.", "english": "Then He reduced it in another verse to five, saying, the Almighty: \"Know that the life of the world is play and amusement and adornment and boasting among you and competition in wealth and children.\" Then He reduced it, the Exalted, in another place to two, saying, the Exalted: \"And the life of the world is nothing but play and amusement.\" Then He reduced the whole to one in another place, saying: \"And restrain the Soul (Nafs) from desire (Hawa), for Paradise is the abode.\" For desire (Hawa) is a term that gathers all the shares of the Soul (Nafs) in the world, so asceticism (Zuhd) should be in it.", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "21": [{"arabic": "فهذا يدل على أن قوله: \" ذلك فضل الله يؤتيه من يشاء \" أي مزيد ثواب الفقراء على ذكرهم. وأما قوله: إن الغني وصف الحق، فقد أجابه بعض الشيوخ فقال: أترى أن الله تعالى غني بالأسباب والأعراض، فانقطع ولم ينطق، وأجاب آخرون فقالوا: إن التكبر من صفات الحق فينبغي أن يكون أفضل من التواضع، ثم قالوا: بل هذا يدل على أن الفقر أفضل لأن صفات العبودية فضل للعبد كالخوف والرجاء، وصفات الربوبية لا ينبغي أن ينازع فيها، ولذلك قال تعالى فيما روى عنه نبينا صلى الله عليه وسلم: \" الكبرياء ردائي والعظمة إزاري، فمن نازعني واحد", "english": "This indicates that His saying: \"That is the Grace (Fadl) of Allah, He bestows it upon whom He wills\" means the increased reward of the poor over their remembrance (Dhikr). As for the statement that richness is an attribute of the Truth (Al-Haqq), some shaykhs responded to it by saying: Do you see that Allah the Exalted is rich (Ghani) through causes and accidents? He fell silent and did not speak. Others answered by saying: Indeed, arrogance (Takabbur) is from the attributes of the Truth, so it should be better than humility (Tawadu'). Then they said: Rather, this indicates that poverty is better because the attributes of servitude (Ubudiyyah) are a grace (Fadl) for the servant (Abd) like fear (Khawf) and hope (Raja'), and the attributes of lordship (Rububiyyah) should not be contended over. Therefore, Allah the Exalted said in what was narrated from our Prophet, peace be upon him: \"Pride (Kibriya') is My cloak and majesty (Izzah) is My garment, so whoever contends with Me in one of them, I will break him.\" And Sahl said: Love of honor (Izz) and permanence (Baqa') is polytheism (Shirk) in lordship and contention in it because they are from the attributes of the Lord, the Exalted. From this category, they spoke about preferring the rich and the poor, and the essence of that is attachment to generalities that accept interpretations and deficient words whose contradiction is not far, for just as the statement of one who prefers richness because it is an attribute of the Truth through arrogance is contradicted, likewise the statement of one who censures richness because it is a description of the servant with knowledge (Ilm) and recognition (Ma'rifah) is contradicted, for it is a description of the Lord, the Exalted, and ignorance (Jahl) and heedlessness (Ghaflah) are descriptions of the servant, and no one should prefer heedlessness over knowledge. The unveiling of the veil from this is what we mentioned in the Book of Patience (Kitab al-Sabr): which is that what is not intended for itself but is intended for something else then", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Poverty and Abstinence'", "badge": "Ethics"}, {"arabic": "ن قرأ الأخبار  والآثار  في  تفضيل\nالفقر، ولا بد فيه من تفصيل فنقول إنما يتصور  الشك  في  مقامين:  أحدهما  فقير\nصابر ليس بحريص على الطلب، بل هو قانع أو راض بالإضافة إلى غني  منفق  ماله  في\nالخيرات ليس حريصاً على إمساك المال.\n\nوالثاني فقير حريص مع غني حريص، إذ لا يخفى أن الفقير  القانع  أفضل  من  الغني\nالحريص الممسك، وأن الغني المنفق ماله في الخيرات أفضل من الفقير الحريص.\n\nالمقام الأول فقير صابر ليس بحريص على الطلب أما  الأول  فربما  يظن  أن  الغني\nأفضل من الفقير، لأنهما تساويا في ضعف الحرص على ال", "english": "[44] Hadith: The poor complained to the Messenger of Allah (peace be upon him) that the rich have preceded them in good deeds and charity. The hadith and at the end he said: \"That is the bounty of Allah which He gives to whom He wills.\" Agreed upon from the hadith of Abu Hurairah, similar.", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "وقد استشهد ابن عطاء أيضاً لما سئل عن ذلك فقال: الغني أفضل لأنه وصف الحق، أما دليله الأول ففيه نظر، لأن الخبر قد ورد مفصلاً تفصيلاً يدل على خلاف ذلك: وهو أن ثواب الفقير في التسبيح يزيد على ثواب الغني، وأن فوزهم بذلك الثواب فضل الله يؤتيه من يشاء، فقد روى يزيد بن أسلم عن أنس بن مالك رضي الله عنه قال: بعثني الفقراء رسولاً إلى رسول الله صلى الله عليه وسلم فقال: إني رسول الفقراء إليك؛ فقال: \" مرحباً بك وبمن جئت من عندهم قوم أحبهم \" قال: قالوا يا رسول الله إن الأغنياء ذهبوا بالخير يحجون ولا نقدر عليه،", "english": "And Ibn 'Ata' also cited as evidence when he was asked about that, saying: The rich person is better because he is described by the Truth (Al-Haqq, referring to Allah), but his first proof is questionable, because the report has come detailed in a way that indicates the opposite of that: which is that the reward of the poor person in glorification (Tasbih) increases over the reward of the rich person, and that their attainment of that reward is the bounty (Fadl) of Allah which He gives to whom He wills, for Yazid bin Aslam narrated from Anas bin Malik, may Allah be pleased with him, who said: The poor sent me as a messenger to the Messenger of Allah, peace and blessings be upon him, and I said: I am the messenger of the poor to you; he said: \"Welcome to you and to those you have come from, a people I love.\" He said: They said, O Messenger of Allah, the rich have taken away the good deeds: they perform Hajj and we cannot afford it, and they perform 'Umrah and we cannot afford it, and when they fall ill, they send ahead with the surplus of their wealth as a provision for them; so the Prophet, peace and blessings be upon him, said: \"Convey from me to the poor that for those among you who are patient and seek reward, there are three characteristics not for the rich: As for one characteristic: Indeed in Paradise there are chambers that the inhabitants of Paradise look at as the inhabitants of the earth look at the stars of the sky, none enters them except a poor prophet, or a poor martyr, or a poor believer, and the second: The poor enter Paradise before the rich by half a day, which is five hundred years, and the third: Glory be to Allah (Subhan Allah) and praise be to Allah (Al-Hamdulillah) and there is no god but Allah (La ilaha illa Allah) and Allah is the Greatest (Allahu Akbar), and the poor person said similarly", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Poverty and Abstinence'", "badge": "Dhikr"}], "23": [{"arabic": "وينبغي أن يعول في باطنه على ثلاث علامات: العلامة الأولى: أن لا يفرح بموجود ولا يحزن على مفقود، كما قال تعالى: \" لكيلا تأسوا على ما فاتكم ولا تفرحوا بما آتاكم \" بل ينبغي أن يكون بالضد من ذلك: وهو أن يحزن بوجود المال ويفرح بفقده.", "english": "And it is necessary to rely in his inner self (Batin) on three signs: The first sign: That he does not rejoice in what is present nor grieve over what is lost, as Allah the Exalted said: \"So that you may not grieve over what has escaped you nor rejoice over what He has given you.\" Rather, it is necessary to be the opposite of that: Which is that he grieves at the presence of wealth and rejoices at its loss.", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "28": [{"arabic": "وقال كعب الأحبار ما في القرآن من يا أيها الذين آمنوا فهو في التوراة يا أيها المساكين", "english": "And Ka'b al-Ahbar said: 'Whatever is in the Quran of \"O you who have believed\" is in the Torah \"O you poor ones (al-Masakin)\".'", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Duties of Brotherhood'", "badge": "General"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1182], [2, 1182, 1905], [3, 1905, 2420], [4, 2420, 2915], [5, 2915, 4543], [6, 4543, 5790], [7, 5790, 6562], [8, 6562, 7750], [9, 7750, 8918]], "2": [[1, 400, 851], [2, 851, 1562], [3, 1562, 3512], [4, 3512, 5006], [5, 5006, 5978], [6, 5978, 7519], [7, 7519, 8444], [8, 8444, 9535], [9, 9535, 10187], [10, 10187, 11017], [11, 11017, 12131]], "3": [[1, 400, 895], [2, 895, 2160], [3, 2160, 3667], [4, 3667, 5389], [5, 5389, 6979], [6, 6979, 7784], [7, 7784, 8558], [8, 8558, 9281], [9, 9281, 10251]], "4": [[1, 400, 966], [2, 966, 2063], [3, 2063, 2842], [4, 2842, 4783], [5, 4783, 6270], [6, 6270, 6860], [7, 6860, 7721], [8, 7721, 9237], [9, 9237, 10075], [10, 10075, 11562], [11, 11562, 12435], [12, 12435, 13544], [13, 13544, 14653], [14, 14653, 15267], [15, 15267, 16093], [16, 16093, 16683], [17, 16683, 17816]