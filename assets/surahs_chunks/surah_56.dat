 in the great violation,[1]","words":[{"id":1,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":2,"arabic":"يُصِرُّونَ","translit":"َnwُّrِṣُy","root":"صرر"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلْحِنثِ","translit":"ِhtnِḥْlٱ","root":"حنث"},{"id":5,"arabic":"ٱلْعَظِيمِ","translit":"ِmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":false},{"ayah":47,"text":"وَكَانُوا۟ يَقُولُونَ أَئِذَا مِتْنَا وَكُنَّا تُرَابًا وَعِظَٰمًا أَءِنَّا لَمَبْعُوثُونَ ","translation":"And they used to say, \"When we die and become dust and bones, are we indeed to be resurrected?","words":[{"id":1,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":2,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":3,"arabic":"أَئِذَا","translit":"āَhdِyʾَaʾ","root":""},{"id":4,"arabic":"مِتْنَا","translit":"āَnْtِm","root":"موت"},{"id":5,"arabic":"وَكُنَّا","translit":"āَّnُkَw","root":"كون"},{"id":6,"arabic":"تُرَابًا","translit":"āًbāَrُt","root":"ترب"},{"id":7,"arabic":"وَعِظَٰمًا","translit":"āًmَٰẓِʿعَw","root":"عظم"},{"id":8,"arabic":"أَءِنَّا","translit":"āَّnِءَaʾ","root":""},{"id":9,"arabic":"لَمَبْعُوثُونَ","translit":"َnwُhtwُʿعْbَmَl","root":"بعث"}],"hasIhya":false},{"ayah":48,"text":"أَوَءَابَآؤُنَا ٱلْأَوَّلُونَ ","translation":"And our forefathers [as well]?\"","words":[{"id":1,"arabic":"أَوَءَابَآؤُنَا","translit":"āَnُwʾٓāَbāَءَwَaʾ","root":"ابو"},{"id":2,"arabic":"ٱلْأَوَّلُونَ","translit":"َnwُlَّwَaʾْlٱ","root":"اول"}],"hasIhya":false},{"ayah":49,"text":"قُلْ إِنَّ ٱلْأَوَّلِينَ وَٱلْءَاخِرِينَ ","translation":"Say, [O Muḥammad], \"Indeed, the former and later peoples","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":3,"arabic":"ٱلْأَوَّلِينَ","translit":"َnyِlَّwَaʾْlٱ","root":"اول"},{"id":4,"arabic":"وَٱلْءَاخِرِينَ","translit":"َnyِrِhkāَءْlٱَw","root":"اخر"}],"hasIhya":false},{"ayah":50,"text":"لَمَجْمُوعُونَ إِلَىٰ مِيقَٰتِ يَوْمٍ