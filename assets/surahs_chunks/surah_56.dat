": ""}, {"id": 2, "arabic": "أُقْسِمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِمَوَٰقِعِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لنُّجُومِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 76, "text": "وَإِنَّهُۥ لَقَسَمࣱ لَّوْ تَعْلَمُونَ عَظِيمٌ", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَقَسَمࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّوْ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَعْلَمُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَظِيمٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 77, "text": "اِنَّهُۥ لَقُرْءَانࣱ كَرِيمࣱ‏", "words": [{"id": 1, "arabic": "اِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَقُرْءَانࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَرِيمࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 78, "text": "فِے كِتَٰبࣲ مَّكْنُونࣲ‏", "words": [{"id": 1, "arabic": "فِے", "translit": "", "root": ""}, {"id": 2, "arabic": "كِتَٰبࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّكْنُونࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 79, "text": "لَّا يَمَسُّهُۥٓ إِلَّا اَ۬لْمُطَهَّرُونَۖ", "words": [{"id": 1, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَمَسُّهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُطَهَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 80, "text": "تَنزِيلࣱ مِّن رَّبِّ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "تَنزِيلࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّبِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 81, "text": "أَفَبِهَٰذَا اَ۬لْحَدِيثِ أَنتُ