": 1, "arabic": "فَلَوْلَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "", "root": ""}, {"id": 3, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَدِينِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 87, "text": "تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَۖ", "words": [{"id": 1, "arabic": "تَرْجِعُونَهَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "", "root": ""}, {"id": 3, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "صَٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 88, "text": "فَأَمَّآ إِن كَانَ مِنَ اَ۬لْمُقَرَّبِينَ", "words": [{"id": 1, "arabic": "فَأَمَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُقَرَّبِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 89, "text": "فَرَوْحࣱ وَرَيْحَانࣱ وَجَنَّتُ نَعِيمࣲۖ", "words": [{"id": 1, "arabic": "فَرَوْحࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَرَيْحَانࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَجَنَّتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَعِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 90, "text": "وَأَمَّآ إِن كَانَ مِنَ اَصْحَٰبِ اِ۬لْيَمِينِ", "words": [{"id": 1, "arabic": "وَأَمَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَصْحَٰبِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْيَمِينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 56, "ayah": 91, "text": "فَسَلَٰمࣱ لَّكَ مِن