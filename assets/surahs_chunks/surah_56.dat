:4,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":81,"text":"أَفَبِهَٰذَا ٱلْحَدِيثِ أَنتُم مُّدْهِنُونَ ","translation":"Then is it to this statement that you are indifferent","words":[{"id":1,"arabic":"أَفَبِهَٰذَا","translit":"āَhdَٰhِbَfَaʾ","root":""},{"id":2,"arabic":"ٱلْحَدِيثِ","translit":"ِhtyِdَḥْlٱ","root":"حدث"},{"id":3,"arabic":"أَنتُم","translit":"mُtnَaʾ","root":""},{"id":4,"arabic":"مُّدْهِنُونَ","translit":"َnwُnِhْdُّm","root":"دهن"}],"hasIhya":false},{"ayah":82,"text":"وَتَجْعَلُونَ رِزْقَكُمْ أَنَّكُمْ تُكَذِّبُونَ ","translation":"And make [the thanks for] your provision that you deny [the Provider]?","words":[{"id":1,"arabic":"وَتَجْعَلُونَ","translit":"َnwُlَʿعْjgَtَw","root":"جعل"},{"id":2,"arabic":"رِزْقَكُمْ","translit":"ْmُkَqْzِr","root":"رزق"},{"id":3,"arabic":"أَنَّكُمْ","translit":"ْmُkَّnَaʾ","root":""},{"id":4,"arabic":"تُكَذِّبُونَ","translit":"َnwُbِّhdَkُt","root":"كذب"}],"hasIhya":true},{"ayah":83,"text":"فَلَوْلَآ إِذَا بَلَغَتِ ٱلْحُلْقُومَ ","translation":"Then why, when it [i.e., the soul at death] reaches the throat","words":[{"id":1,"arabic":"فَلَوْلَآ","translit":"ٓāَlْwَlَf","root":""},{"id":2,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":3,"arabic":"بَلَغَتِ","translit":"ِtَغَlَb","root":"بلغ"},{"id":4,"arabic":"ٱلْحُلْقُومَ","translit":"َmwُqْlُḥْlٱ","root":"حلق"}],"hasIhya":false},{"ayah":84,"text":"وَأَنتُمْ حِينَئِذٍ تَنظُرُونَ ","translation":"And you are at that time looking on -","words":[{"id":1,"arabic":"وَأَنتُمْ","translit":"ْmُtnَaʾَw","root":""},{"id":2,"arabic":"حِينَئِذٍ","translit":"ٍhdِyʾَnyِḥ","root":"حين"},{"id":3,"arabic":"تَنظُرُونَ","translit":"َnwُrُẓnَt","root":"نظر"}],"hasIhya":false},{"ayah":85,"text":"وَنَحْنُ أَقْرَبُ إِلَيْهِ مِنكُمْ وَلَٰكِن لَّا تُبْصِرُونَ ","translation":"And We [i.e., Our angels] are nearer to him than you, but you do not see -","words":[{"id":1,"arabic":"وَنَحْنُ","translit":"ُnْḥَnَw","root":""},{"id":2,"arabic":"أَقْرَبُ","translit":"ُbَrْqَaʾ","root":"قرب"},{"id":3,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":4,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":5,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":6,"arabic":"لَّا","translit":"āَّl","root":""},{"id":7,"arabic":"تُبْصِرُونَ","translit":"َnwُrِṣْbُt","root":"بصر"}],"hasIhya":false},{"ayah":86,"text":"فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ ","translation":"Then why do you not, if you are not to be recompensed,","words":[{"id":1,"arabic":"فَلَوْلَآ","translit":"ٓāَlْwَlَf","root":""},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":4,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":5,"arabic":"مَدِينِينَ","translit":"َnyِnyِdَm","root":"دين"}],"hasIhya":false},{"ayah":87,"text":"تَرْجِعُونَهَآ إِن كُنتُمْ صَٰدِقِينَ ","translation":"Bring it back,[1] if you should be truthful?","words":[{"id":1,"arabic":"تَرْجِعُونَهَآ","translit":"ٓāَhَnwُʿعِjgْrَt","root":"رجع"},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":4,"arabic":"صَٰدِقِينَ","translit":"َnyِqِdَٰṣ","root":"صدق"}],"hasIhya":false},{"ayah":88,"text":"فَأَمَّآ إِن كَانَ مِنَ ٱلْمُقَرَّبِينَ ","translation":"And if he [i.e., the deceased] was of those brought near [to Allāh],","words":[{"id":1,"arabic":"فَأَمَّآ","translit":"ٓāَّmَaʾَf","root":""},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":4,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":5,"arabic":"ٱلْمُقَرَّبِينَ","translit":"َnyِbَّrَqُmْlٱ","root":"قرب"}],"hasIhya":true},{"ayah":89,"text":"فَرَوْحٌ وَرَيْحَانٌ وَجَنَّتُ نَعِيمٍ ","translation":"Then [for him is] rest and bounty and a garden of pleasure.","words":[{"id":1,"arabic":"فَرَوْحٌ","translit":"ٌḥْwَrَf","root":"روح"},{"id":2,"arabic":"وَرَيْحَانٌ","translit":"ٌnāَḥْyَrَw","root":"روح"},{"id":3,"arabic":"وَجَنَّتُ","translit":"ُtَّnَjgَw","root":"جنن"},{"id":4,"arabic":"نَعِيمٍ","translit":"ٍmyِʿعَn","root":"نعم"}],"hasIhya":false},{"ayah":90,"text":"وَأَمَّآ إِن كَانَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ ","translation":"And if he was of the companions of the right,","words":[{"id":1,"arabic":"وَأَمَّآ","translit":"ٓāَّmَaʾَw","root":""},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":4,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":5,"arabic":"أَصْحَٰبِ","translit":"ِbَٰḥْṣَaʾ","root":"صحب"},{"id":6,"arabic":"ٱلْيَمِينِ","translit":"ِnyِmَyْlٱ","root":"يمن"}],"hasIhya":false},{"ayah":91,"text":"فَسَلَٰمٌ لَّكَ مِنْ أَصْحَٰبِ ٱلْيَمِينِ ","translation":"Then [the angels will say], \"Peace for you; [you are] from the companions of the right.\"","words":[{"id":1,"arabic":"فَسَلَٰمٌ","translit":"ٌmَٰlَsَf","root":"سلم"},{"id":2,"arabic":"لَّكَ","translit":"َkَّl","root":""},{"id":3,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":4,"arabic":"أَصْحَٰبِ","translit":"ِbَٰḥْṣَaʾ","root":"صحب"},{"id":5,"arabic":"ٱلْيَمِينِ","translit":"ِnyِmَyْlٱ","root":"يمن"}],"hasIhya":false},{"ayah":92,"text":"وَأَمَّآ إِن كَانَ مِنَ ٱلْمُكَذِّبِينَ ٱلضَّآلِّينَ ","translation":"But if he was of the deniers [who were] astray,","words":[{"id":1,"arabic":"وَأَمَّآ","translit":"ٓāَّmَaʾَw","root":""},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":4,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":5,"arabic":"ٱلْمُكَذِّبِينَ","translit":"َnyِbِّhdَkُmْlٱ","root":"كذب"},{"id":6,"arabic":"ٱلضَّآلِّينَ","translit":"َnyِّlٓāَّḍlٱ","root":"ضلل"}],"hasIhya":false},{"ayah":93,"text":"فَنُزُلٌ مِّنْ حَمِيمٍ ","translation":"Then [for him is] accommodation of scalding water","words":[{"id":1,"arabic":"فَنُزُلٌ","translit":"ٌlُzُnَf","root":"نزل"},{"id":2,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":3,"arabic":"حَمِيمٍ","translit":"ٍmyِmَḥ","root":"حمم"}],"hasIhya":false},{"ayah":94,"text":"وَتَصْلِيَةُ جَحِيمٍ ","translation":"And burning in Hellfire.","words":[{"id":1,"arabic":"وَتَصْلِيَةُ","translit":"ُẗَyِlْṣَtَw","root":"صلي"},{"id":2,"arabic":"جَحِيمٍ","translit":"ٍmyِḥَjg","root":"جحم"}],"hasIhya":false},{"ayah":95,"text":"إِنَّ هَٰذَا لَهُوَ حَقُّ ٱلْيَقِينِ ","translation":"Indeed, this is the true certainty,","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":3,"arabic":"لَهُوَ","translit":"َwُhَl","root":""},{"id":4,"arabic":"حَقُّ","translit":"ُّqَḥ","root":"حقق"},{"id":5,"arabic":"ٱلْيَقِينِ","translit":"ِnyِqَyْlٱ","root":"يقن"}],"hasIhya":true},{"ayah":96,"text":"فَسَبِّحْ بِٱسْمِ رَبِّكَ ٱلْعَظِيمِ ","translation":"So exalt the name of your Lord, the Most Great.","words":[{"id":1,"arabic":"فَسَبِّحْ","translit":"ْḥِّbَsَf","root":"سبح"},{"id":2,"arabic":"بِٱسْمِ","translit":"ِmْsٱِb","root":"سمو"},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"ٱلْعَظِيمِ","translit":"ِmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":false}],"tafsir":{"15":[{"arabic":"لما ذكر في سورة الواقعة المقربين السابقين تعرض لسرير الملك فقال {على سرر موضونة متكئين عليها متقابلين} ولما انتهى إلى أصحاب اليمين ما زاد في ذكر الماء والظل والفواكه والأشجار والحور العين وكل ذلك من لذات المنظور والمشروب والمأكول والمنكوح ويتصور ذلك للبهائم على الدوام وأين لذات البهائم من لذة الملك والنزول في أعلى عليين في جوار رب العالمين ولو كان لهذه اللذات قدر لما وسعت على البهائم ولما رفعت عليها درجة الملائكة أفترى أن أحوال البهائم وهي مسيبة في الرياض متنعمة بالماء والأشجار وأصناف المأكولات متمتعة بالنزوان والسفاد أعلى وألذ وأشرف وأجدر بأن","english":"If you say: \"Does there remain with the servant any management (tadbir) or attachment to causes (asbab) in these states?\" — Know that the third station negates management entirely (rafʿan li-l-tadbir), so long as the state persists; rather, its possessor becomes like one stupefied (mabhut). The second station negates every management except that which pertains to fleeing unto Allah through supplication (duʿa) and earnest entreaty (ibtihal) — like the management of an infant in clinging to its mother alone. The first station does not negate the root of management and choice (ikhtiyar), but negates certain managements — like one who relies on his deputy (wakil) in a lawsuit: he abandons his own management with respect to what is not the deputy's concern, but he does not abandon the management which his deputy has indicated to him, nor the management which he knows from the deputy's custom and established practice (sunnah), apart from his explicit indication.","book_title":"Monotheism and Reliance","section_title_ar":"Section 1119","section_title_en":"The Reality of Reliance (Haqiqat al-Tawakkul) — Degrees of Trust and the Station of Witnessing","section_index":1119,"anchors":"- Root: دبر (d-b-r)\n  * Lisan / Ayn: \"دبر الشيء: خلاف القبل\" — the rear, the back; by extension, the management of affairs as one turns away from one thing toward another (tadbir: to manage, to deliberate over outcomes).\n  * Al-Raghib (Mufradat): \"دبر الشيء: خلاف القبل، وكني بهما عن العضوين المخصوصين\" — used literally for spatial orientation; metaphorically for the ordering of one's own affairs (tadbir al-amr), which is the very faculty that tawakkul suspends or redirects.\n  * Al-Zamakhshari (Asas): Literal: \"أدبر النهار ودبر دبورا\" (the day passed away). Metaphorical: \"ما يعرف قبيلا من دبير\" — one who cannot distinguish front from back, i.e., total loss of self-direction; relevant to the state of the \"bewildered\" (mabhut) one.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — applies to the phrase \"لا حول ولا قوة إلا بالله\" where the restriction (hasr) confines all power (hawl) and strength (quwwah) exclusively to Allah, negating any independent creaturely agency.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'","badge":"Insight"}],"18":[{"arabic":"الياقوت بنيت وسط روضات الجنان قاصرات الطرف عين ثم يطاف عليهم وعليهن بأكواب وأباريق وكأس من معين بيضاء لذة للشاربين ويطوف عليهم خدام وولدان كأمثال اللؤلؤ المكنون جزاء بما كانوا يعملون في مقام أمين في جنات وعيون في جنات ونهر في مقعد صدق عند مليك مقتدر ينظرون فيها إلى وجه الملك الكريم وقد أشرقت في وجوههم نضرة النعيم لا يرهقهم فتر ولا ذلة بل عباد مكرمون وبأنواع التحف من ربهم يتعاهدون فهم فيما اشتهيت أنفسهم خالدون لا يخافون فيها ولا يحزنون وهم من ريب المنون آمنون فهم فيها يتنعمون ويأكلون من أطعمتها ويشربون من أنهارها لبنا وخمرا وعسلا في أن","english":"For God Most High has said: {«إن الأبرار لفي نعيم وإن الفجار لفي جحيم»} — \"Indeed the righteous are in bliss, and indeed the wicked are in Hellfire.\" So present yourself before these two verses, and you will have known your resting-place between the two abodes. And God knows best.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1351","section_title_en":"Section 1351 — On the Description of Paradise and the Varieties of Its Bliss","section_index":1351,"anchors":"- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root denotes softness, ease, and pleasant living; al-Ayn notes it among names of the leopard and tiger, while Lisan records \"Nuʿm\" as a proper name.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — niʿmah is the excellent state/condition one inhabits; niʿīm is the experience of delight. The verse {«إن الأبرار لفي نعيم»} designates the abiding state of bliss as a settled condition, not a transient act.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"في النعمة والنعيم\" — dwelling in bounty and bliss. Metaphorical (Majaz): \"خفت نعامتهم: ذهبوا\" — ostriches departing; here the root's literal sense of softness is transfigured into the theological state of perpetual ease, free from all harshness.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Core root: face, front, direction; al-Ayn cites \"وجه الصواب\" — the face/course of correctness.\n  * Al-Raghib (Mufradat): The face is the noblest part of the outward body, hence used for the essence (al-dhāt) of a thing; in {«ويبقى وجه ربك ذو الجلال والإكرام»} it signifies the Divine Essence. Here \"وجه الملك الكريم\" — the Face of the Generous King — denotes the Beatific Vision of God's Essence, not a corporeal organ.\n  * Al-Zamakhshari (Asas): Literal: physical face. Metaphorical: \"وجه القوم، وهؤلاء وجوه البلد\" — the foremost, noblest of a people; thus the \"face\" of the King is His most august presence.\n- Root: مرج (m-r-j)\n  * Lisan / Ayn: Core root: mixing, confusion, letting loose; al-Ayn: \"المرج: الشهد\" — also pure honey; Lisan: \"مرج أمرهم: اختلط\" — their affair became disordered.\n  * Al-Raghib (Mufradat): \"أصل المرج: الخلط\" — mixing; \"أمر مريج\" — a confused affair (Q. 50:5). In this text, the rivers of Paradise \"مطردة\" (flowing) are not \"ممرجة\" (mixed/confused) — rather they run pure and distinct, each in its channel.\n  * Al-Zamakhshari (Asas): Literal: \"مرج الدواب: أرسلها في المرج\" — releasing beasts into pasture. Metaphorical: \"مرج الله البحرين\" — God let the two seas flow freely; \"مرجت عهودهم\" — covenants became disordered. The contrast sharpens the purity of Paradise's rivers.\n- Root: امن (a-m-n)\n  * Lisan / Ayn: Core root: safety, freedom from fear; al-Ayn treats it under the hamzah chapter as the state of security.\n  * Al-Raghib (Mufradat): \"أصل الأمن: طمأنينة النفس وزوال الخوف\" — tranquility of the soul and removal of fear. In the Hereafter, \"آمنون\" is not mere absence of threat but the positive, settled peace of the soul in the Divine presence.\n  * Al-Zamakhshari (Asas): Literal: \"أمنته وآمننيه\" — to grant safety. Metaphorical: \"فرس أمين القوى\" — a horse whose strength is trustworthy; here the blessed are \"آمنون من ريب المنون\" — secure from the vicissitudes of fate, a security that is trustworthy and unbreachable.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule permits separation between a preposition and its object by an element upon which speech may properly pause, as in \"إن به لضرًا\" — here \"فهم فيما اشتهت أنفسهم خالدون\" (in what their souls desire, abiding eternally) interposes the clause of desire between the prepositional phrase and its predicate, heightening rhetorical emphasis on the soul's fulfillment.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}],"21":[{"arabic":"وفي القرآن تنبيه على تقديم الفاكهة في قوله تعالى وفاكهة مما يتخيرون {ثم قال} ولحم طير مما يشتهون ثم أفضل ما يقدم بعد الفاكهة اللحم والثريد فقد قال صلى الله عليه وسلم فضل عائشة على النساء كفضل الثريد على سائر الطعام فإن جمع إليه حلاوة بعده فقد جمع الطيبات ودل على حصول الإكرام باللحم قوله تعالى في ضيف إبراهيم إذ أحضر العجل الحنيذ أي المحنوذ وهو الذي أجيد نضجه وهو أحد معنى الإكرام أعني تقديم اللحم وقال تعالى في وصف الطيبات وأنزلنا عليكم المن والسلوى المن العسل والسلوى اللحم سمي سلوى لأنه يتسلى به عن جميع الإدام ولا يقوم غيره مق","english":"The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"","book_title":"Manners of Eating","section_title_ar":"Section 290","section_title_en":"The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences","section_index":290,"anchors":"- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Manners of Eating'","badge":"Hadith"}],"23":[{"arabic":"بأكواب وأباريق وكأس من معين بيضاء لذة للشاربين ويطوف عليهم خدام وولدان كأمثال اللؤلؤ المكنون جزاء بما كانوا يعملون في مقام أمين في جنات وعيون في جنات ونهر في مقعد صدق عند مليك مقتدر ينظرون فيها إلى وجه الملك الكريم وقد أشرقت في وجوههم نضرة النعيم لا يرهقهم فتر ولا ذلة بل عباد مكرمون وبأنواع التحف من ربهم يتعاهدون فهم فيما اشتهيت أنفسهم خالدون لا يخافون فيها ولا يحزنون وهم من ريب المنون آمنون فهم فيها يتنعمون ويأكلون من أطعمتها ويشربون من أنهارها لبنا وخمرا وعسلا في أنهار أراضيها من فضة وحصباؤها مرجان وعلى أرض ترابها مسك أذفر ونباتها زعفران ويمطرون من سحا","english":"For God Most High has said: {«إن الأبرار لفي نعيم وإن الفجار لفي جحيم»} — \"Indeed the righteous are in bliss, and indeed the wicked are in Hellfire.\" So present yourself before these two verses, and you will have known your resting-place between the two abodes. And God knows best.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1351","section_title_en":"Section 1351 — On the Description of Paradise and the Varieties of Its Bliss","section_index":1351,"anchors":"- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root denotes softness, ease, and pleasant living; al-Ayn notes it among names of the leopard and tiger, while Lisan records \"Nuʿm\" as a proper name.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — niʿmah is the excellent state/condition one inhabits; niʿīm is the experience of delight. The verse {«إن الأبرار لفي نعيم»} designates the abiding state of bliss as a settled condition, not a transient act.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"في النعمة والنعيم\" — dwelling in bounty and bliss. Metaphorical (Majaz): \"خفت نعامتهم: ذهبوا\" — ostriches departing; here the root's literal sense of softness is transfigured into the theological state of perpetual ease, free from all harshness.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Core root: face, front, direction; al-Ayn cites \"وجه الصواب\" — the face/course of correctness.\n  * Al-Raghib (Mufradat): The face is the noblest part of the outward body, hence used for the essence (al-dhāt) of a thing; in {«ويبقى وجه ربك ذو الجلال والإكرام»} it signifies the Divine Essence. Here \"وجه الملك الكريم\" — the Face of the Generous King — denotes the Beatific Vision of God's Essence, not a corporeal organ.\n  * Al-Zamakhshari (Asas): Literal: physical face. Metaphorical: \"وجه القوم، وهؤلاء وجوه البلد\" — the foremost, noblest of a people; thus the \"face\" of the King is His most august presence.\n- Root: مرج (m-r-j)\n  * Lisan / Ayn: Core root: mixing, confusion, letting loose; al-Ayn: \"المرج: الشهد\" — also pure honey; Lisan: \"مرج أمرهم: اختلط\" — their affair became disordered.\n  * Al-Raghib (Mufradat): \"أصل المرج: الخلط\" — mixing; \"أمر مريج\" — a confused affair (Q. 50:5). In this text, the rivers of Paradise \"مطردة\" (flowing) are not \"ممرجة\" (mixed/confused) — rather they run pure and distinct, each in its channel.\n  * Al-Zamakhshari (Asas): Literal: \"مرج الدواب: أرسلها في المرج\" — releasing beasts into pasture. Metaphorical: \"مرج الله البحرين\" — God let the two seas flow freely; \"مرجت عهودهم\" — covenants became disordered. The contrast sharpens the purity of Paradise's rivers.\n- Root: امن (a-m-n)\n  * Lisan / Ayn: Core root: safety, freedom from fear; al-Ayn treats it under the hamzah chapter as the state of security.\n  * Al-Raghib (Mufradat): \"أصل الأمن: طمأنينة النفس وزوال الخوف\" — tranquility of the soul and removal of fear. In the Hereafter, \"آمنون\" is not mere absence of threat but the positive, settled peace of the soul in the Divine presence.\n  * Al-Zamakhshari (Asas): Literal: \"أمنته وآمننيه\" — to grant safety. Metaphorical: \"فرس أمين القوى\" — a horse whose strength is trustworthy; here the blessed are \"آمنون من ريب المنون\" — secure from the vicissitudes of fate, a security that is trustworthy and unbreachable.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule permits separation between a preposition and its object by an element upon which speech may properly pause, as in \"إن به لضرًا\" — here \"فهم فيما اشتهت أنفسهم خالدون\" (in what their souls desire, abiding eternally) interposes the clause of desire between the prepositional phrase and its predicate, heightening rhetorical emphasis on the soul's fulfillment.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}],"24":[{"arabic":"وقيل في قوله تعالى {فلا تعلم نفس ما أخفي لهم من قرة أعين جزاء بما كانوا يعملون} قيل كان عملهم الصيام لأنه قال {إنما يوفى الصابرون أجرهم بغير حساب} فيفرغ للصائم جزاؤه إفراغا ويجازف جزافا فلا يدخل تحت وهم وتقدير وجدير بأن يكون كذلك لأن الصوم إنما كان له ومشرفا بالنسبة إليه وإن كانت العبادات كلها له كما شرف البيت بالنسبة إلى نفسه والأرض كلها له لمعنيين أحدهما أن الصوم كف وترك وهو في نفسه سر ليس فيه عمل يشاهد وجميع أعمال الطاعات بمشهد من الخلق ومرأى والصوم لا يراه إلا الله عز وجل فإنه عمل في الباطن بالصبر المجرد والثاني أنه","english":"To proceed: Fasting is one quarter of faith, by virtue of his saying, peace and blessings be upon him: \"Fasting is half of patience\" — and by virtue of his saying, peace and blessings be upon him: \"Patience is half of faith\" {«الإيمان»}. Then it is distinguished by a particular characteristic of its attribution to Allah the Exalted, above all the other pillars — for Allah the Exalted said, in what His Prophet narrated from Him, peace and blessings be upon him: \"Every good deed is multiplied tenfold up to seven hundred times, except fasting, for it is Mine, and I shall reward it.\" And Allah the Exalted has said: {«Only the patient shall be paid their reward in full without reckoning»} (Q 39:10). And fasting is half of patience — so its reward has surpassed the law of measure and reckoning. And sufficient for you in knowing its excellence is his saying, peace and blessings be upon him: \"By Him in whose hand is my soul, the change in the breath of the mouth of the fasting person is more fragrant to Allah than the scent of musk. Allah the Exalted says: 'He only abandons his appetite, his food, and his drink for My sake — so fasting is for Me, and I shall reward it.'\" And he said, peace and blessings be upon him: \"Paradise has a gate called al-Rayyān, through which none shall enter except the fasting ones.\" And the fasting person is promised the meeting with Allah the Exalted as a portion of his fasting. And he said, peace and blessings be upon him: \"For the fasting person there are two joys: a joy when he breaks his fast, and a joy when he meets his Lord.\" And he said, peace and blessings be upon him: \"Everything has a gate, and the gate of worship is fasting.\" And he said, peace and blessings be upon him: \"The sleep of the fasting person is worship.\" And Abū Hurayrah, may Allah be pleased with him, narrated that he, peace and blessings be upon him, said: \"When the month of Ramaḍān enters, the gates of Paradise are opened, the gates of the Fire are closed, the devils are chained, and a caller calls out: 'O seeker of good, come forth! O seeker of evil, desist!'\" And Wakīʿ said concerning His saying, the Exalted: {«Eat and drink in satisfaction for what you sent forth in the days past»} (Q 69:24) — these are the days of fasting, for in them they abandoned eating and drinking. And the Messenger of Allah, peace and blessings be upon him, gathered in the rank of divine boasting (mubāhāh) between renunciation of the world and fasting, saying: \"Allah the Exalted boasts to His angels of the young worshiper, saying: 'O young man who abandons his appetite for My sake, who devotes his youth to Me — you are to Me as some of My angels.'\" And he said, peace and blessings be upon him, concerning the fasting person: \"Allah the Exalted says: 'Look, O My angels, at My servant — he has abandoned his appetite, his pleasure, his food, and his drink for My sake.'\" And it was said concerning His saying, the Exalted: {«No soul knows what comfort has been concealed for them, as a reward for what they used to do»} (Q 32:17) — it was said: their deed was fasting, because He said: {«Only the patient shall be paid their reward in full without reckoning»} — so the reward of the fasting person is poured out upon him without measure, and is dealt out to him in bulk, not falling under any imagination or estimation.","book_title":"Condemnation of Delusion","section_title_ar":"Section 185","section_title_en":"The Book of the Secrets of Fasting — Section 185: On the Excellence of Fasting and Its Distinction Among the Acts of Worship","section_index":185,"anchors":"- Root: صوم (ṣ-w-m)\n  * Lisan / Ayn: Core linguistic root meaning — abstention from any act, whether eating, speaking, or walking; a horse that refrains from movement or fodder is called ṣā'im.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"الصوم في الأصل: الإمساك عن الفعل\" — fasting is fundamentally the restraint of the self from action; it is an inward act of the heart, invisible to creation.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — Haqiqah: the month of fasting, \"فمن شهد منكم الشهر فليصمه\" (Q 2:185); Majaz: \"صام الفرس على آريه\" — a horse standing still at its tether, refusing fodder, metaphorically \"fasting.\"\n- Root: عله (ʿ-l-h)\n  * Lisan / Ayn: Core linguistic root meaning — to feed or pasture; related to cultivation and nourishment.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — not directly attested in Mufradat for this root; the root pertains to the means by which the body is sustained, which is precisely what the fasting person abstains from.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — literal feeding and satiation; the fasting person's abstention from these becomes the very means of spiritual nourishment.\n- Root: الي (a-l-y)\n  * Lisan / Ayn: Core linguistic root meaning — to convey a message; the angel (malak) is so named because the message is \"chewed\" (yu'lak) in the mouth, as a horse chews its bit.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"المألكة: الرسالة\" — the angelic function is the conveyance of divine communication; the fasting person's hunger narrows the channels through which the devil (who runs like blood through the veins) reaches the heart.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — literal conveyance of a message versus the metaphorical \"message\" of the devil's insinuation (waswās) through the pathways of the body.\n- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core linguistic root meaning — to restrain, to hold back in constriction; \"صبرت الدابة: حبستها بلا علف\" — to hold an animal back without fodder.\n  * Al-Raghib (Mufradat): Theological/Kalam semantic nuance — \"الصبر: الإمساك في ضيق\" — patience is restraint within constriction; it is the holding of the soul upon what reason and law require, or from what they require it to abstain. Its names vary by context: in battle it is courage, in calamity it is patience proper.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical distinction — Haqiqah: \"صبرت على ما أكره وصبرت عما أحب\" — patience upon the disliked and patience from the beloved; Majaz: \"صبرت يمينه\" — to bind one's oath severely, and \"هو أصبر على الضرب من الأرض\" — more enduring of striking than the earth.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts and confines the predicate exclusively to its subject, as in the divine saying {«إنما يوفى الصابرون أجرهم بغير حساب»} and {«إنما يذر شهوته وطعامه وشرابه لأجلي»}, where the restriction elevates the restricted matter to a rank beyond all quantitative measure.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'","badge":"Insight"}],"33":[{"arabic":"لنا من هذه الفاكهة المقطوعة الممنوعة لعلنا نذهب إلى الفاكهة التي لا مقطوعة ولا ممنوعة فلما اشتراها وأتى بها إليه قال لنفسه قد خدعتيني حتى نظرت واشتهيت وغلبتيني حتى اشتريت والله لأذقتيه فبعث بها إلى يتامى من الفقراء وعن موسى الأشج أنه قال نفسي تشتهي ملحا جريشا منذ عشرين سنة وعن أحمد بن خليفة قال نفسي تشتهي منذ عشرين سنة ما طلبت مني إلا الماء حتى تروى فما أرويتها وروي أن عتبة الغلام اشتهى لحما سبع سنين فلما كان بعد ذلك قال استحييت من نفسي أن أدافعها منذ سبع سنين سنة بعد سنة فاشتريت قطعة لحم على خبز وشويتها","english":"Indeed, the sustenance (qūt) of a group of the Companions was a ṣāʿ of wheat every Friday. When they ate dates, they took as their sustenance a ṣāʿ and a half of them. The ṣāʿ of wheat is four mudds, so each day would be nearly half a mudd — which is what we mentioned as the measure of one-third of the stomach. An increase was needed for dates because of the pits that are discarded from them. Abū Dharr, may Allah be pleased with him, used to say: \"My food every Friday is a ṣāʿ of barley, on the covenant of the Messenger of Allah, peace and blessings be upon him. By Allah, I will not increase upon it anything until I meet him, for I heard him say: 'The nearest of you to me in seating on the Day of Resurrection, and the most beloved of you to me, is the one who dies upon what he is upon today.'\" He used to say, disapproving of some of the Companions: \"You have changed — barley is sifted for you, though it was not sifted; you bake thin bread; you combine two condiments; foods of various colors are set before you; one of you goes out in one garment and returns in another. They were not like this in the era of the Messenger of Allah, peace and blessings be upon him.\"","book_title":"Harms of the Tongue","section_title_ar":"Section 645","section_title_en":"The Revival of the Religious Sciences — Section 645: On Hunger and the Discipline of Eating","section_index":645,"anchors":"- Root: جوع (j-w-ʿ)\n  * Lisan / Ayn: Core meaning of emptiness of the belly, hunger as opposed to fullness (shabaʿ)\n  * Al-Raghib (Mufradat): Hunger as a spiritual discipline (riyāḍah) that purifies the heart and weakens the sway of sensual appetite\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — bodily hunger; Metaphorical (majāz) — the soul's longing and deprivation as spiritual training\n- Root: قوت (q-w-t)\n  * Lisan / Ayn: Sustenance, nourishment that maintains life; measure of food sufficient for survival\n  * Al-Raghib (Mufradat): Provision (rizq) in its minimal necessary form; the qūt is that which sustains the body's constitution without excess\n  * Al-Zamakhshari (Asas): Literal — food that sustains; Metaphorical — the spiritual sustenance of the heart through remembrance\n- Root: أدم (ʾ-d-m)\n  * Lisan / Ayn: That which is eaten with bread to make it palatable; condiment or relish\n  * Al-Raghib (Mufradat): The adornment of food; in spiritual discourse, the craving for variety and relish beyond bare necessity\n  * Al-Zamakhshari (Asas): Literal — condiment; Metaphorical — the soul's attachment to luxuries and embellishments of worldly life\n- Root: سرف (s-r-f)\n  * Lisan / Ayn: Excess, extravagance, going beyond the proper limit\n  * Al-Raghib (Mufradat): Transgression of the mean (iʿtidāl) in expenditure or consumption; blameworthy in all affairs\n  * Al-Zamakhshari (Asas): Literal — exceeding the measure; Metaphorical — spiritual extravagance in indulging desires\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The conditional and restrictive constructions (inna-mā, law, idhā) governing the precise boundaries of permissible and blameworthy eating","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Harms of the Tongue'","badge":"Afterlife"}],"51":[{"arabic":"ثم انظر إلى طعامهم وهو الزقوم كما قال الله تعالى {ثم إنكم أيها الضالون المكذبون لآكلون من شجر من زقوم فمالئون منها البطون فشاربون عليه من الحميم فشاربون شرب الهيم} وقال تعالى {إنها شجرة تخرج في أصل الجحيم طلعها كأنه رؤوس الشياطين فإنهم لآكلون منها فمالئون منها البطون ثم إن لهم عليها لشوبا من حميم ثم إن مرجعهم لإلى الجحيم} وقال تعالى {تصلى نارا حامية تسقى من عين آنية} وقال تعالى {إن لدينا أنكالا وجحيما وطعاما ذا غصة وعذابا أليما} وقال ابن عباس قال رسول الله صلى الله عليه وسلم لو أن قطرة من الزقوم قطرت في بحار الدنيا أفسدت على أهل الدنيا معايشهم (2) فكيف من يكون طعامه ذلك وقال أنس قال رسول الله صلى الله عليه وسلم","english":"And ʿAlī, may God honor his face, said: The Messenger of God, may God bless him and grant him peace, said: \"Seek refuge in God from the Pit of Sorrow, or the Valley of Sorrow.\" It was said: \"O Messenger of God, what is the Valley or Pit of Sorrow?\" He said: \"A valley in Hell from which Hell itself seeks refuge with God seventy times each day. God, the Exalted, has prepared it for the reciters who show off.\" (2)","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1349","section_title_en":"The Vastness of Hellfire, Its Depths, and the Torments of Its Inhabitants","section_index":1349,"anchors":"- Root: و د ي (w-d-y)\n  * Lisan / Ayn: A valley; a place where torrents flow. In the lexicon, it denotes a lowland or watercourse between mountains.\n  * Al-Raghib (Mufradat): Used for the valleys of Hell as places of confinement and passage, each containing further branching ravines (شُعَب), indicating graded descent.\n  * Al-Zamakhshari (Asas): Literal for earthly valleys; here transferred (majāz) to the topographical reality of Hell, affirming its corporeal vastness.\n- Root: ع م ق (ʿ-m-q)\n  * Lisan / Ayn: Depth; the far bottom of a well or pit. Al-Farahidi: \"العمق: قعر البئر ونحوها.\"\n  * Al-Raghib (Mufradat): Depth as a measure of descent; in the Hereafter, it is unbounded, paralleling the unbounded depth of worldly desire.\n  * Al-Zamakhshari (Asas): Literal for physical depth; here extended to show the infinite regress of punishment corresponding to infinite craving.\n- Root: غ س ق (gh-s-q)\n  * Lisan / Ayn: Stinking, foul pus or ichor that flows from the skin of the damned; also intense darkness.\n  * Al-Raghib (Mufradat): Al-Ghassāq is the putrid effusion of Hell, a punishment for the senses, specifically for drinking when the damned cry out in thirst.\n  * Al-Zamakhshari (Asas): Literal for what is loathsome and fetid; in the Quranic context, it is the designated drink of the inhabitants.\n- Root: ز ق م (z-q-m)\n  * Lisan / Ayn: To swallow with difficulty; the tree of Zaqqūm, which grows in the depths of Hell.\n  * Al-Raghib (Mufradat): A specific tree in Hell whose fruit is like the heads of devils, eaten by the damned to fill their bellies, causing choking and agony.\n  * Al-Zamakhshari (Asas): Literal for a real tree; its description is sensory, not metaphorical, affirming the physical reality of punishment.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of \"في جهنم سبعين ألف واد\" allows the prepositional phrase to precede the subject for emphasis, establishing the spatial setting before detailing its contents.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Remembrance of Death and Afterlife'","badge":"Ethics"}],"58":[{"arabic":"من الأرض نباتا ثم يعيدكم فيها ويخرجكم إخراجا وقال تعالى أفرأيتم ما تمنون أأنتم تخلقونه أم نحن الخالقون إلى قوله للمقوين فليس يخفي على من معه أدنى مسكة من عقل إذا تأمل بأدنى فكرة مضمون هذه الآيات وأدار نظره على عجائب خلق الله في الأرض والسموات وبدائع فطرة الحيوان والنبات أن هذا الأمر العجيب والترتيب المحكم لا يستغني عن صانع يدبره وفاعل يحكمه ويقدره بل تكاد فطرة النفوس تشهد بكونها مقهورة تحت تسخيره ومصرفة بمقتضى تدبيره ولذلك قال الله تعالى أفي الله شك فاطر السموات والأرض ولهذا بعث الأنبياء صلوات الله عليهم لدعوة الخلق إلى التوحيد ليقولوا لا إله إلا","english":"The First Principle: the knowledge of His existence, the Exalted. The first thing by which one is illuminated from among the lights, and the path of reflection (ṭarīq al-iʿtibār) by which one proceeds, is that to which the Qurʾān has guided. For after the explanation of God, glorified be He, there is no explanation. He, the Exalted, has said: {«أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا وَالْجِبَالَ أَوْتَادًا وَخَلَقْنَاكُمْ أَزْوَاجًا وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا وَجَعَلْنَا اللَّيْلَ لِبَاسًا وَجَعَلْنَا النَّهَارَ مَعَاشًا وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا وَجَعَلْنَا سِرَاجًا وَهَّاجًا وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا وَجَنَّاتٍ أَلْفَافًا»} — \"Have We not made the earth a resting place, and the mountains as pegs, and created you in pairs, and made your sleep a repose, and made the night a covering, and made the day for livelihood, and built above you seven strong heavens, and made a blazing lamp, and sent down from the rain-clouds pouring water, that We may bring forth thereby grain and vegetation, and gardens dense with foliage?\" (Q 78:6–16). And He, the Exalted, has said: {«إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ وَمَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ»} — \"Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the ships which sail through the sea with that which benefits people, and what God has sent down from the sky of water, thereby reviving the earth after its death, and dispersing therein every creature, and the directing of the winds, and the clouds subservient between the heaven and the earth — are signs for a people who reason\" (Q 2:164). And He, the Exalted, has said: {«أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا»} — \"Have you not seen how God created seven heavens in layers, and made the moon therein a light, and made the sun a lamp? And God caused you to grow from the earth a growth; then He returns you into it, and brings you forth a bringing forth\" (Q 71:15–18). And He, the Exalted, has said: {«أَفَرَأَيْتُم مَّا تُمْنُونَ أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ»} — \"Have you considered what you emit? Do you create it, or are We the Creator?\" — up to His saying: {«لِلْمُقْوِينَ»} — \"for the settlers\" (Q 56:58–73).","book_title":"Foundations of Belief","section_title_ar":"Section 87","section_title_en":"The Pillars of Faith: Knowledge of God, His Attributes, His Acts, and the Audibles — Section 87","section_index":87,"anchors":"- Root: وجود (w-j-d)\n  * Lisan / Ayn: [Core linguistic root meaning: to find, to perceive, to be; existence as that which is found or discovered]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: al-wujūd as necessary existence (wujūb) versus contingent existence (imkān); the self-evident reality of the Creator's being]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: haqīqah — existence as affirmed reality; majāz — \"finding\" as in discovery, not applicable to God's necessary being]\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: [Core linguistic root meaning: measuring, proportioning, fashioning; origination of a thing upon a measure]\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination from nothing without prior model\n  * Al-Zamakhshari (Asas): [Literal: خلق الله الخلق: أوجده على تقدير أوجبته الحكمة — brought into existence upon a measure necessitated by wisdom; Majaz: not applicable to God's act as pure origination]\n- Root: فطر (f-t-r)\n  * Lisan / Ayn: [Core linguistic root meaning: to split, cleave, rend; to originate, to bring forth as a new creation]\n  * Al-Raghib (Mufradat): \"فطر الله الخلق\" — God's origination of creation as a primordial act; \"الفطرة\" as the innate disposition\n  * Al-Zamakhshari (Asas): [Literal: فطر الله الخلق، وهو فاطر السموات: مبتدعها — originator without precedent; Majaz: \"رأيه فطير\" — immature opinion, not applicable to divine]\n- Root: ارض (ar-d)\n  * Lisan / Ayn: [Core linguistic root meaning: the earth, the lower sphere; that which is beneath]\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء\" — the body opposite the heaven\n  * Al-Zamakhshari (Asas): [Literal: the earth as a resting place (مهادا); Majaz: not applicable in this context of divine creation]\n- Root: ركن (r-k-n)\n  * Lisan / Ayn: [Core linguistic root meaning: corner, pillar, support; that to which one leans for strength]\n  * Al-Raghib (Mufradat): \"ركن الشيء: جانبه الذي يسكن إليه\" — the side of a thing to which one repairs; used metaphorically for strength\n  * Al-Zamakhshari (Asas): [Literal: physical pillar/corner; Majaz: \"فلان يأوي من عز قومه إلى ركن شديد\" — one who repairs to a mighty support; here, the \"pillars\" (أركان) of faith as structural supports]\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure \"مداره على عشرة أصول\" (its circuit revolves upon ten principles) employs a prepositional phrase governing the verbal noun, establishing the necessary grammatical dependency that mirrors the ontological dependency of the created upon the Creator.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"}],"60":[{"arabic":"تعالى نحن قدرنا بينكم الموت وفي قوله تعالى الذي خلق الموت والحياة ولا مناقضة بين قوله تعالى نحن قدرنا بينكم الموت وبين قوله وأنا أكره مساءته ولكن إيضاح الحق في هذا يستدعي تحقيق معنى الإرادة والمحبة والكراهة وبيان حقائقها فإن السابق إلى الإفهام منها أمور تناسب إرادة الخلق ومحبتهم وكراهتهم وهيهات فبين صفات الله تعالى وصفات الخلق من البعد ما بين ذاته العزيز وذاتهم وكما أن ذوات الخلق جوهر وعرض وذات الله مقدس عنه ولا يناسب ما ليس بجوهر وعرض الجوهر والعرض فكذا صفاته لا تناسب صفات الخلق وه","english":"وقال صلى الله عليه وسلم: \"لا يلقى الله أحد بذنب أعظم من جهالة أهله.\"","book_title":"Etiquette of Marriage","section_title_ar":"Section 296","section_title_en":"Section 296","section_index":296,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Marriage'","badge":"Insight"}],"68":[{"arabic":"أفرأيتم ما تمنون أفرأيتم الماء الذي تشربون أفرأيتم النار التي تورون فلا يقصر نظره على الماء والنار والحرث والمني بل يتأمل في المني وهو نطفة متشابهة الأجزاء ثم ينظر في كيفية انقسامها إلى اللحم والعظم والعروق والعصب وكيفية تشكل أعضائها بالأشكال المختلفة من الرأس واليد والرجل والكبد والقلب وغيرها ثم إلى ما ظهر فيها من الصفات الشريفة من السمع والبصر والعقل وغيرها ثم إلى ما ظهر فيها من الصفات المذمومة من الغضب والشهوة والكبر والجهل والتكذيب والمجادلة كما قال تعالى أولم ير الإنسان أنا خلقناه م","english":"I say: These meanings are buried treasures that are not unveiled except to the divinely aided ones. To this 'Ali — may God be pleased with him — alluded by his saying: \"The Messenger of God — may God's peace and blessings be upon him — did not confide to me anything that he concealed from the people, except that God — mighty and majestic — grants to a servant understanding (fahm) of His Book. So let one be eager in seeking that understanding.\" (1) And Ibn Mas'ud — may God be pleased with him — said: \"Whoever desires the knowledge of the first and the last, let him stir up the Qur'an.\" And the greatest of the sciences of the Qur'an lie beneath the names of God — mighty and majestic — and His attributes, for most of creation have grasped from them only matters befitting their understandings and have not stumbled upon their depths.","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 228","section_title_en":"The Revival of the Religious Sciences — Section 228: On the Inner Meanings of the Qur'an and the Removal of Obstacles to Understanding","section_index":228,"anchors":"- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, discernment, the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one verifies the realities of what is perceived; distinct from mere hearing or transmission\n  * Al-Zamakhshari (Asas): Literal: swift apprehension; Metaphorical: the divine gift of insight into hidden meanings, as in the verse {ففهمناها سليمان}\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transformation from one state to another\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as that which is perpetually turned and overturned between states\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of understanding that is veiled or illuminated, rusted or polished\n- Root: سمع (s-m-')\n  * Lisan / Ayn: Hearing, the auditory faculty\n  * Al-Raghib (Mufradat): \"السمع: قوة في الأذن به يدرك الأصوات\" — extends metaphorically to comprehension and obedience; \"أو ألقى السمع وهو شهيد\" — one who casts his hearing while present\n  * Al-Zamakhshari (Asas): Literal: auditory perception; Metaphorical: attentive obedience and receptive understanding\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise delimitation of predicates such as \"إنما يتذكر أولوا الألباب\" where restriction confines the action to its proper subject","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Etiquette of Quran Recitation'","badge":"Ethics"}],"71":[{"arabic":"أفرأيتم ما تمنون أفرأيتم الماء الذي تشربون أفرأيتم النار التي تورون فلا يقصر نظره على الماء والنار والحرث والمني بل يتأمل في المني وهو نطفة متشابهة الأجزاء ثم ينظر في كيفية انقسامها إلى اللحم والعظم والعروق والعصب وكيفية تشكل أعضائها بالأشكال المختلفة من الرأس واليد والرجل والكبد والقلب وغيرها ثم إلى ما ظهر فيها من الصفات الشريفة من السمع والبصر والعقل وغيرها ثم إلى ما ظهر فيها من الصفات المذمومة من الغضب والشهوة والكبر والجهل والتكذيب والمجادلة كما قال تعالى أولم ير الإنسان أنا خلقناه من نطفة فإذا هو خصيم مبين ف","english":"I say: These meanings are buried treasures that are not unveiled except to the divinely aided ones. To this 'Ali — may God be pleased with him — alluded by his saying: \"The Messenger of God — may God's peace and blessings be upon him — did not confide to me anything that he concealed from the people, except that God — mighty and majestic — grants to a servant understanding (fahm) of His Book. So let one be eager in seeking that understanding.\" (1) And Ibn Mas'ud — may God be pleased with him — said: \"Whoever desires the knowledge of the first and the last, let him stir up the Qur'an.\" And the greatest of the sciences of the Qur'an lie beneath the names of God — mighty and majestic — and His attributes, for most of creation have grasped from them only matters befitting their understandings and have not stumbled upon their depths.","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 228","section_title_en":"The Revival of the Religious Sciences — Section 228: On the Inner Meanings of the Qur'an and the Removal of Obstacles to Understanding","section_index":228,"anchors":"- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, discernment, the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one verifies the realities of what is perceived; distinct from mere hearing or transmission\n  * Al-Zamakhshari (Asas): Literal: swift apprehension; Metaphorical: the divine gift of insight into hidden meanings, as in the verse {ففهمناها سليمان}\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transformation from one state to another\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as that which is perpetually turned and overturned between states\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of understanding that is veiled or illuminated, rusted or polished\n- Root: سمع (s-m-')\n  * Lisan / Ayn: Hearing, the auditory faculty\n  * Al-Raghib (Mufradat): \"السمع: قوة في الأذن به يدرك الأصوات\" — extends metaphorically to comprehension and obedience; \"أو ألقى السمع وهو شهيد\" — one who casts his hearing while present\n  * Al-Zamakhshari (Asas): Literal: auditory perception; Metaphorical: attentive obedience and receptive understanding\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise delimitation of predicates such as \"إنما يتذكر أولوا الألباب\" where restriction confines the action to its proper subject","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Etiquette of Quran Recitation'","badge":"Ethics"}],"75":[{"arabic":"هوى فلا أقسم بمواقع النجوم وإنه لقسم لو تعلمون عظيم فقد علمت أن عجائب النطفة القذرة عجز عن معرفتها الأولون والآخرون وما أقسم الله بها فما ظنك بما أقسم الله تعالى به وأحال الأرزاق عليه وأضافها إليه فقال تعالى وفي السماء رزقكم وما توعدون وأثنى على المفكرين فيه فقال ويتفكرون في خلق السموات والأرض وقال رسول الله صلى الله عليه وسلم ويل لمن قرأ هذه الآية ثم مسح بها سبلته (1) أى تجاوزها من غير فكر وذم المعرضين عنها فقال وجعلنا السماء سقفا محفوظا وهم عن آياتها معرضون فأى نسبة لجميع البحار والأرض إلى السماء","english":"I say — and of the heaven with its woven structure, and the heaven and what built it; and His saying, may He be exalted: {«And the sun and its morning brightness, and the moon when it follows it»} (Q 91:1-2); and His saying, may He be exalted: {«Nay, I swear by the slinking stars, the runners, the sinkers»} (Q 81:15-16); and His saying, may He be exalted: {«And the star when it falls — nay, I swear by the positions of the stars, and verily it is a mighty oath, if you but knew»} (Q 56:75-76). You have thus come to know that the wonders of the filthy drop of semen — the first and last generations have fallen short of comprehending them. So if God swore by such things, what is your assumption concerning that by which God, may He be exalted, swore, and upon which He made provisions dependent, and to which He annexed them, saying, may He be exalted: {«And in the heaven is your provision and that which you are promised»} (Q 51:22)? And He praised those who reflect upon it, saying: {«And they reflect upon the creation of the heavens and the earth»} (Q 3:191). And the Messenger of God, may God's peace and blessing be upon him, said: \"Woe to him who recites this verse and then wipes his moustache with it\" — that is, passes over it without reflection. And He censured those who turn away from it, saying: {«And We made the heaven a protected roof, yet from its signs they turn away»} (Q 21:32). So what comparison is there between all the seas and the earth, on the one hand, and the heaven, on the other — given that the former are subject to rapid changes, while the heavens are solid, mighty, and preserved from change until the Book reaches its appointed term? For this reason God, may He be exalted, called it \"protected,\" saying: {«And We made the heaven a protected roof»} (Q 21:32); and He said, glory be to Him: {«And We built above you seven mighty ones»} (Q 78:12); and He said: {«Are you stronger in creation or the heaven? He built it, He raised high its roof and fashioned it»} (Q 79:27-28).","book_title":"Contemplation","section_title_ar":"Section 1278","section_title_en":"On Contemplating the Kingdom of the Heavens (التفكر في ملكوت السموات)","section_index":1278,"anchors":"- Root: م ل ك (malaka)\n  * Lisan / Ayn: الملك: القوة على التصرف، والملكوت: زيادة الميم للمبالغة كالرهبوت والرحموت\n  * Al-Raghib (Mufradat): الملكوت: عالم الغيب الذي لا تدركه الحواس، والملك: عالم الشهادة المحسوس\n  * Al-Zamakhshari (Asas): الملكوت مجاز عن باطن الملك وسرّه، لا عن ظاهره المحسوس\n- Root: س م و (sama)\n  * Lisan / Ayn: السماء: كل ما علاك فأظلك، وأصلها السمو بمعنى الارتفاع\n  * Al-Raghib (Mufradat): السماء: الجرم المقابل للأرض، وتستعمل بمعنى العلو والملكوت الأعلى\n  * Al-Zamakhshari (Asas): \"سقفا محفوظا\" حقيقة في الحفظ عن التغير والاضمحلال\n- Root: غ ي ب (ghayb)\n  * Al-Raghib (Mufradat): الغيب: ما استتر عن الحواس، ويقال للشيء غيب باعتباره بالناس لا بالله تعالى، فإنه لا يغيب عنه شيء\n  * Al-Zamakhshari (Asas): الغيب والملكوت مترادفان في اصطلاح القرآن لما غاب عن الأبصار\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره لمراعاة البلاغة والمقام","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"}],"79":[{"arabic":"كلام الله عز وجل غاية الخطر فإنه تعالى قال {لا يمسه إلا المطهرون} وكما أن ظاهر جلد المصحف وورقه محروس عن ظاهر بشرة اللامس إلا إذا كان متطهرا فباطن معناه أيضا بحكم عزه وجلاله محجوب عن باطن القلب إلا إذا كان متطهرا عن كل رجس ومستنيرا بنور التعظيم والتوقير وكما لا يصلح لمس جلد المصحف كل يد فلا يصلح لتلاوة حروفه كل لسان ولا لنيل معانيه كل قلب ولمثل هذا التعظيم كان عكرمة بن أبي جهل إذا نشر المصحف غشى عليه ويقول هو كلام ربي هو كلام ربي فتعظيم الكلام تعظيم المتكلم ولن تحضره عظمة المتكلم ما لم يتفكر في صفاته وجلاله و","english":"And one of the sages shone brilliantly in expressing the aspect of gentleness in conveying the meanings of speech — despite the exaltedness of its rank — to human understanding, and establishing it firmly despite the limitation of humanity's station. He struck for it a parable that fell short of nothing. That was when a certain sage was summoned by one of the kings to the law of the prophets — peace be upon them. The king asked him about matters, and he answered with what his understanding could not bear. The king said: \"What do you say of what the prophets bring when they claim that it is not the speech of men, but that it is the speech of Allah — mighty and majestic is He? How then can people bear to carry it?\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 226","section_title_en":"The Ten Principles of Qur'anic Recitation — The Inward Realities of Recitation (Section 226)","section_index":226,"anchors":"- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, understanding; the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one ascertains meanings; divine favor in bestowing understanding\n  * Al-Zamakhshari (Asas): \"من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — distinguishes passive reception from active divine instruction\n- Root: عظم (ʿ-ẓ-m)\n  * Lisan / Ayn: Bigness of bone; then metaphorically extended to all magnitude, sensory or intelligible\n  * Al-Raghib (Mufradat): \"عظم الشيء أصله: كبر عظمه، ثم استعير لكل كبير\" — literal bone-magnitude extended metaphorically to majesty and grandeur\n  * Al-Zamakhshari (Asas): \"لا يتعاظمني أي لا يعظم في عيني\" — what is too great for one's capacity to bear\n- Root: حكم (ḥ-k-m)\n  * Al-Raghib (Mufradat): \"حكم أصله: منع منعا لإصلاح\" — restraint for the sake of rectification; hence the rein (ḥikmah) of the beast\n  * Al-Zamakhshari (Asas): \"أحكم الشيء فاستحكم\" — to make firm so that it becomes firm; the penetrating authority of wisdom\n- Sibawayh Rule: Interposition of the prepositional phrase (الفصل بين الجار والمجرور) — governing the periodic suspension between the divine attribute and its creaturely vehicle, as in \"من كلام الله\" where the genitive chain marks ontological descent without essential change","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"}],"82":[{"arabic":"وقوله تعالى وتجعلون رزقكم أنكم تكذبون أي شكر رزقكم وقوله عز وجل وآتنا ما وعدتنا على رسلك أي على ألسنة رسلك فحذف ألسنة وقوله تعالى إنا أنزلناه في ليلة القدر أراد القرآن وما سبق له ذكر وقال عز وجل حتى توارت الحجاب أراد الشمس وما سبق لها ذكر وقوله تعالى والذين اتخذوا من دونه أولياء ما نعبدهم إلا ليقربونا إلى الله زلفى أي يقولون ما نعبدهم وقوله عز وجل فمال هؤلاء القوم لا يكادون يفقهون حديثا ما أصابك من حسنة فمن الله وما أصابك من سيئة فمن نفسك معناه لا يفقهون حديثا يقولون ما أصابك من","english":"I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 233","section_title_en":"The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation","section_index":233,"anchors":"- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"}],"88":[{"arabic":"دون ذروة الكمال فلهم النجاة والسلامة كما قال الله عز وجل {فأما إن كان من المقربين فروح وريحان وجنة نعيم وأما إن كان من أصحاب اليمين فسلام لك من أصحاب اليمين} وكل من لم يتوجه إلى المقصد ولم ينتهض له أو انتهض إلى جهته لا على قصد الامتثال والعبودية بل لغرض عاجل فهو من أصحاب الشمال ومن الضالين فله نزل من حميم وتصلية جحيم واعلم أن هذا هو حق اليقين عند العلماء الراسخين أعني أنهم أدركوه بمشاهدة من الباطن هي أقوى وأجلى من مشاهدة الأبصار وترقوا فيه عن حد التقليد لمجرد السماع وحالهم حال من أخبر فصدق ثم شاهد فحقق وحال غيرهم حال من قبل بحسن التصديق والإيمان ولم يحظ بالمشاهدة والعيان فالسعادة وراء علم المكاشفة وعلم المكا","english":"As for the attainment of happiness, none reaches it except the knowers of Allah the Exalted — and they are the brought-near (al-muqarrabūn), the blessed ones in the vicinity of Allah the Exalted, with repose and fragrance and the Garden of Delight. As for those who are barred below the summit of perfection, for them is deliverance and safety, as Allah, Mighty and Majestic, said: {«فأما إن كان من المقربين فروح وريحان وجنة نعيم وأما إن كان من أصحاب اليمين فسلام لك من أصحاب اليمين»} (So if he is of those brought near, then repose and fragrance and a Garden of Delight. And if he is of the companions of the right, then peace to you from the companions of the right). And whoever does not set out toward the objective, nor rouses himself for it — or rouses himself toward it not with the intention of compliance and servitude, but rather for some immediate purpose — he is of the companions of the left and of the astray; for him is an entertainment of boiling water and a roasting in Hellfire.","book_title":"Book of Knowledge","section_title_ar":"Section 44","section_title_en":"The Science of the Path: On the Threefold Division of Knowledge and the Journey to God","section_index":44,"anchors":"- Root: سلك (s-l-k)\n  * Lisan / Ayn: To traverse, to pass through, to thread (as a needle through cloth); the path one takes through a terrain.\n  * Al-Raghib (Mufradat): \"السلوك: النفاذ في الطريق\" — the penetrating passage through a road; used both literally (traversing a physical path) and metaphorically (the soul's passage through spiritual wayfaring).\n  * Al-Zamakhshari (Asas): Literal: \"طريق مسلوك\" (a trodden path); Metaphorical: \"ذهب في مسلك خفي، وخذ في مسالك الحق\" — going in a hidden course, taking the paths of truth. The term thus spans both physical travel and the interior journey of the soul.\n- Root: قرب (q-r-b)\n  * Lisan / Ayn: Nearness in place, time, or rank; kinship and proximity.\n  * Al-Raghib (Mufradat): \"القرب والبعد يتقابلان... ويستعمل ذلك في المكان، وفي الزمان، وفي النسبة، وفي الحظوة، والرعاية، والقدرة\" — nearness and distance are opposites, used in place, time, relation, favor, care, and power. The theological sense here is nearness to God as station (ḥaẓwah) and favor.\n  * Al-Zamakhshari (Asas): Literal: \"قرب منه وإليه\" (he drew near to him); Metaphorical: \"لقد قربت أمرا ما أدري ما هو\" (you have brought near a matter I know not what it is) — indicating that proximity can be by rank and honor, not merely spatial.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge, perception, cognition; the root from which ʿālim (knower) and ʿilm (knowledge) derive.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; two kinds: apprehension of the essence of a thing, and judgment upon a thing affirming or denying something of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" (I did not know of your news: I was unaware of it); the term spans sensory awareness and intellectual certitude.\n- Root: الي (a-l-y) [as in ألى/إلى]\n  * Lisan / Ayn: The root of \"إلى\" (toward, unto) and \"أولى\" (more worthy); also related to \"آل\" (family, those who return to a head).\n  * Al-Raghib (Mufradat): The root carries the sense of direction and destination — the \"unto\" of a journey's end.\n  * Al-Zamakhshari (Asas): The prepositional force of \"إلى\" marks the terminus of motion, whether physical or spiritual.\n- Sibawayh Rule: باب التشبيه والتقسيم الثلاثي (The Chapter of Analogy and Tripartite Division) — The author employs a structured analogy (tamthīl) dividing knowledge into three categories, each mapped to a stage of the pilgrimage journey (preparation, traversing the wilderness, and the rites themselves). The syntax moves from the concrete (physical journey) to the abstract (spiritual wayfaring), with each division governed by a parallel construction (qism... qism... qism).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"95":[{"arabic":"واعلم أن هذا هو حق اليقين عند العلماء الراسخين أعني أنهم أدركوه بمشاهدة من الباطن هي أقوى وأجلى من مشاهدة الأبصار وترقوا فيه عن حد التقليد لمجرد السماع وحالهم حال من أخبر فصدق ثم شاهد فحقق وحال غيرهم حال من قبل بحسن التصديق والإيمان ولم يحظ بالمشاهدة والعيان فالسعادة وراء علم المكاشفة وعلم المكاشفة وراء علم المعاملة التي هي سلوك طريق الآخرة وقطع عقبات الصفات وسلوك طريق محو الصفات المذمومة وراء علم الصفات وعلم طريق المعالجة وكيفية السلوك في ذلك وراء علم سلامة البدن ومسا","english":"As for the attainment of happiness, none reaches it except the knowers of Allah the Exalted — and they are the brought-near (al-muqarrabūn), the blessed ones in the vicinity of Allah the Exalted, with repose and fragrance and the Garden of Delight. As for those who are barred below the summit of perfection, for them is deliverance and safety, as Allah, Mighty and Majestic, said: {«فأما إن كان من المقربين فروح وريحان وجنة نعيم وأما إن كان من أصحاب اليمين فسلام لك من أصحاب اليمين»} (So if he is of those brought near, then repose and fragrance and a Garden of Delight. And if he is of the companions of the right, then peace to you from the companions of the right). And whoever does not set out toward the objective, nor rouses himself for it — or rouses himself toward it not with the intention of compliance and servitude, but rather for some immediate purpose — he is of the companions of the left and of the astray; for him is an entertainment of boiling water and a roasting in Hellfire.","book_title":"Book of Knowledge","section_title_ar":"Section 44","section_title_en":"The Science of the Path: On the Threefold Division of Knowledge and the Journey to God","section_index":44,"anchors":"- Root: سلك (s-l-k)\n  * Lisan / Ayn: To traverse, to pass through, to thread (as a needle through cloth); the path one takes through a terrain.\n  * Al-Raghib (Mufradat): \"السلوك: النفاذ في الطريق\" — the penetrating passage through a road; used both literally (traversing a physical path) and metaphorically (the soul's passage through spiritual wayfaring).\n  * Al-Zamakhshari (Asas): Literal: \"طريق مسلوك\" (a trodden path); Metaphorical: \"ذهب في مسلك خفي، وخذ في مسالك الحق\" — going in a hidden course, taking the paths of truth. The term thus spans both physical travel and the interior journey of the soul.\n- Root: قرب (q-r-b)\n  * Lisan / Ayn: Nearness in place, time, or rank; kinship and proximity.\n  * Al-Raghib (Mufradat): \"القرب والبعد يتقابلان... ويستعمل ذلك في المكان، وفي الزمان، وفي النسبة، وفي الحظوة، والرعاية، والقدرة\" — nearness and distance are opposites, used in place, time, relation, favor, care, and power. The theological sense here is nearness to God as station (ḥaẓwah) and favor.\n  * Al-Zamakhshari (Asas): Literal: \"قرب منه وإليه\" (he drew near to him); Metaphorical: \"لقد قربت أمرا ما أدري ما هو\" (you have brought near a matter I know not what it is) — indicating that proximity can be by rank and honor, not merely spatial.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge, perception, cognition; the root from which ʿālim (knower) and ʿilm (knowledge) derive.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; two kinds: apprehension of the essence of a thing, and judgment upon a thing affirming or denying something of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" (I did not know of your news: I was unaware of it); the term spans sensory awareness and intellectual certitude.\n- Root: الي (a-l-y) [as in ألى/إلى]\n  * Lisan / Ayn: The root of \"إلى\" (toward, unto) and \"أولى\" (more worthy); also related to \"آل\" (family, those who return to a head).\n  * Al-Raghib (Mufradat): The root carries the sense of direction and destination — the \"unto\" of a journey's end.\n  * Al-Zamakhshari (Asas): The prepositional force of \"إلى\" marks the terminus of motion, whether physical or spiritual.\n- Sibawayh Rule: باب التشبيه والتقسيم الثلاثي (The Chapter of Analogy and Tripartite Division) — The author employs a structured analogy (tamthīl) dividing knowledge into three categories, each mapped to a stage of the pilgrimage journey (preparation, traversing the wilderness, and the rites themselves). The syntax moves from the concrete (physical journey) to the abstract (spiritual wayfaring), with each division governed by a parallel construction (qism... qism... qism).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,250,1053],[2,1053,2062],[3,2062,3626]],"2":[[1,350,1051],[2,1051,2745],[3,2745,3816]],"3":[[1,250,1687],[2,1687,3260]],"4":[[1,350,1221],[2,1221,2059],[3,2059,3131],[4,3131,4103]],"5":[[1,350,1581],[2,1581,2920],[3,2920,3946]],"6":[[1,400,2312],[2,2312,4654],[3,4654,7377]],"7":[[1,350,1792],[2,1792,3680],[3,3680,4887]],"8":[[1,350,1749],[2,1749,3224],[3,3224,4377],[4,4377,5553],[5,5553,7029]],"9":[[1,350,1959],[2,1959,3292],[3,3292,4521],[4,4521,5773],[5,5773,7107]],"10":[[1,350,2243],[2,2243,3868]],"11":[[1,350,2362],[2,2362,4678]],"12":[[1,350,916],[2,916,2257],[3,2257,3946]],"13":[[1,350,1288],[2,1288,2174],[3,2174,4390]],"14":[[1,350,1745],[2,1745,2521],[3,2521,4390]],"15":[[1,350,1301],[2,1301,1942],[3,1942,3711]],"16":[[1,350,2056],[2,2056,3378],[3,3378,5174]],"17":[[1,350,1604],[2,1604,2929],[3,2929,4136],[4,4136,6219]],"18":[[1,400,2115],[2,2115,4229],[3,4229,5357],[4,5357,6167],[5,6167,7612]],"19":[[1,350,1115],[2,1115,3000],[3,3000,4074],[4,4074,5011],[5,5011,6611]],"20":[[1,350,1854],[2,1854,3540],[3,3540,6062]],"21":[[1,350,1402],[2,1402,2271]