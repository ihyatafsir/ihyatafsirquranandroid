": "", "root": ""}, {"id": 2, "arabic": "يَكُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَيْتࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "زُخْرُفٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 8, "arabic": "تَرْق۪يٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَلَن", "translit": "", "root": ""}, {"id": 12, "arabic": "نُّومِنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "لِرُقِيِّكَ", "translit": "", "root": ""}, {"id": 14, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 15, "arabic": "تُنَزِّلَ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 17, "arabic": "كِتَٰباࣰ", "translit": "", "root": ""}, {"id": 18, "arabic": "نَّقْرَؤُهُۥۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 20, "arabic": "سُبْحَٰنَ", "translit": "", "root": ""}, {"id": 21, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 22, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 23, "arabic": "كُنتُ", "translit": "", "root": ""}, {"id": 24, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 25, "arabic": "بَشَراࣰ", "translit": "", "root": ""}, {"id": 26, "arabic": "رَّسُولاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 17, "ayah": 94, "text": "وَمَا مَنَعَ اَ۬لنَّاسَ أَنْ يُّومِنُوٓاْ إِذْ جَآءَهُمُ اُ۬لْهُد۪يٰٓ إِلَّآ أَن قَالُوٓاْ أَبَعَثَ اَ۬للَّهُ بَشَراࣰ رَّسُولاࣰۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنَعَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لنَّاسَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُّومِنُوٓاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 7, "arabic": "جَآءَهُمُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْهُد۪يٰٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَن", "translit": "", "root": ""}, {"id": 11, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَبَعَثَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 14, "arabic": "بَشَراࣰ", "translit": "", "root": ""}, {"id": 15, "arabic": "رَّسُولاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 17, "ayah": 95, "text": "قُل لَّوْ كَانَ فِے اِ۬لَارْضِ مَلَٰٓئِكَةࣱ يَمْشُونَ مُطْمَئِنِّينَ لَنَزَّلْنَا عَلَيْهِم مِّنَ اَ۬لسَّمَآءِ مَلَكاࣰ رَّسُولاࣰۖ", "words": [{"id": 1, "arabic": "قُل", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّوْ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَلَٰٓئِكَةࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَمْشُونَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُطْمَئِنِّينَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَنَزَّلْنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَلَكاࣰ", "translit": "", "root": ""}, {"id": 14, "arabic": "رَّسُولاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 17, "ayah": 96, "text": "قُلْ كَف۪يٰ بِاللَّهِ شَهِيداَۢ بَيْنِے وَبَيْنَكُمُۥٓۖ إِنَّهُۥ كَانَ بِعِبَادِهِۦ خَبِيراَۢ بَصِيراࣰۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَف۪ي