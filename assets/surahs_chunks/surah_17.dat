, "arabic": "وَكُلَّ", "translit": "", "root": ""}, {"id": 21, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 22, "arabic": "فَصَّلْنَٰهُ", "translit": "", "root": ""}, {"id": 23, "arabic": "تَفْصِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 17, "ayah": 13, "text": "وَكُلَّ إِنسَٰنٍ اَلْزَمْنَٰهُ طَٰٓئِرَهُۥ فِے عُنُقِهِۦ وَنُخْرِجُ لَهُۥ يَوْمَ اَ۬لْقِيَٰمَةِ كِتَٰباࣰ يَلْق۪يٰهُ مَنشُوراًۖ", "words": [{"id": 1, "arabic": "وَكُلَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنسَٰنٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَلْزَمْنَٰهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "طَٰٓئِرَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "عُنُقِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَنُخْرِجُ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْقِيَٰمَةِ", "translit": "", "root": ""}, {"id": 11, "arabic": "كِتَٰباࣰ", "translit": "", "root": ""}, {"id": 12, "arabic": "يَلْق۪يٰهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَنشُوراًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 17, "ayah": 14, "text": "اِ۪قْرَأْ كِتَٰبَكَ كَف۪يٰ بِنَفْسِكَ اَ۬لْيَوْمَ عَلَيْكَ حَسِيباࣰۖ", "words": [{"id": 1, "arabic": "اِ۪قْرَأْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كِتَٰبَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَف۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِنَفْسِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْيَوْمَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَسِيباࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 17, "ayah": 15, "text": "مَّنِ اِ۪هْتَد۪يٰ فَإِنَّمَا يَهْتَدِے لِنَفْسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَاۖ وَلَا تَزِرُ وَازِ