": ""}, {"id": 7, "arabic": "فَتَقْعُدَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَذْمُوماࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّخْذُولاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 17, "ayah": 23, "text": "۞وَقَض۪يٰ رَبُّكَ أَلَّا تَعْبُدُوٓاْ إِلَّآ إِيَّاهُۖ وَبِالْوَٰلِدَيْنِ إِحْسَٰناًۖ اِمَّا يَبْلُغَنَّ عِندَكَ اَ۬لْكِبَرَ أَحَدُهُمَآ أَوْ كِلَاهُمَا فَلَا تَقُل لَّهُمَآ أُفࣲّ وَلَا تَنْهَرْهُمَاۖ وَقُل لَّهُمَا قَوْلاࣰ كَرِيماࣰۖ", "words": [{"id": 1, "arabic": "۞وَقَض۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَعْبُدُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِيَّاهُۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَبِالْوَٰلِدَيْنِ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِحْسَٰناًۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِمَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَبْلُغَنَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "عِندَكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لْكِبَرَ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَحَدُهُمَآ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 15, "arabic": "كِلَاهُمَا", "translit": "", "root": ""}, {"id": 16, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 17, "arabic": "تَقُل", "translit": "", "root": ""}, {"id": 18, "arabic": "لَّهُمَآ", "translit": "", "root": ""}, {"id": 19, "arabic": "أُفࣲّ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 21, "arabic": "تَنْهَرْهُمَاۖ", "translit": "", "root": ""}, {"id": 22, "arabic": "وَقُل", "translit": "", "root": ""}, {"id": 23, "arabic": "لَّهُمَا", "translit": "", "root": ""}, {"id": 24, "arabic": "قَوْلاࣰ", "translit": "", "r