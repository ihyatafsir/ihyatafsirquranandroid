ic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۪تَّخَذُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "قُرْبَاناً", "translit": "", "root": ""}, {"id": 9, "arabic": "اٰلِهَةَۢۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 11, "arabic": "ضَلُّواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَنْهُمْۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَذَٰلِكَ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِفْكُهُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 16, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 17, "arabic": "يَفْتَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 46, "ayah": 29, "text": "وَإِذْ صَرَفْنَآ إِلَيْكَ نَفَراࣰ مِّنَ اَ۬لْجِنِّ يَسْتَمِعُونَ اَ۬لْقُرْءَانَ فَلَمَّا حَضَرُوهُ قَالُوٓاْ أَنصِتُواْۖ فَلَمَّا قُضِيَ وَلَّوِاْ اِلَيٰ قَوْمِهِم مُّنذِرِينَۖ", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَرَفْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَفَراࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْجِنِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَسْتَمِعُونَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْقُرْءَانَ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "حَضَرُوهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَنصِتُواْۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 14, "arabic": 