 لِيَفْجُرَ أَمَامَهُۥۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُرِيدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لِانسَٰنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَفْجُرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمَامَهُۥۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 6, "text": "يَسْـَٔلُ أَيَّانَ يَوْمُ اُ۬لْقِيَٰمَةِۖ", "words": [{"id": 1, "arabic": "يَسْـَٔلُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَيَّانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْقِيَٰمَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 7, "text": "فَإِذَا بَرَقَ اَ۬لْبَصَرُ", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بَرَقَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْبَصَرُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 8, "text": "وَخَسَفَ اَ۬لْقَمَرُ", "words": [{"id": 1, "arabic": "وَخَسَفَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْقَمَرُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 9, "text": "وَجُمِعَ اَ۬لشَّمْسُ وَالْقَمَرُ", "words": [{"id": 1, "arabic": "وَجُمِعَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لشَّمْسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالْقَمَرُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 10, "text": "يَقُولُ اُ۬لِانسَٰنُ يَوْمَئِذٍ اَيْنَ اَ۬لْمَفَرُّۖ", "words": [{"id": 1, "arabic": "يَقُولُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لِانسَٰنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَئِذٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَيْنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمَفَرُّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 11, "text": "ك