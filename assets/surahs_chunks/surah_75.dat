ic": "يَقُولُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لِانسَٰنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَئِذٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَيْنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمَفَرُّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 11, "text": "كَلَّا لَا وَزَرَۖ", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَزَرَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 12, "text": "إِلَيٰ رَبِّكَ يَوْمَئِذٍ اِ۬لْمُسْتَقَرُّۖ", "words": [{"id": 1, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَئِذٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْمُسْتَقَرُّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 13, "text": "يُنَبَّؤُاْ اُ۬لِانسَٰنُ يَوْمَئِذِۢ بِمَا قَدَّمَ وَأَخَّرَۖ", "words": [{"id": 1, "arabic": "يُنَبَّؤُاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لِانسَٰنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَئِذِۢ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "قَدَّمَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَخَّرَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 14, "text": "بَلِ اِ۬لِانسَٰنُ عَلَيٰ نَفْسِهِۦ بَصِيرَةࣱ‏", "words": [{"id": 1, "arabic": "بَلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لِانسَٰنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَفْسِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَصِيرَةࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 75, "ayah": 15, "text": "وَلَوَ اَلْق۪يٰ مَعَاذِيرَهُۥۖ", "words": [{"id": 1, "arabic": "وَلَوَ