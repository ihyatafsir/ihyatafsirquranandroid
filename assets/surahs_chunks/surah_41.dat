{"surah":41,"verses":[{"ayah":1,"text":"حمٓ ","translation":"Ḥā, Meem.[1]","words":[{"id":1,"arabic":"حمٓ","translit":"ٓmḥ","root":""}],"hasIhya":false},{"ayah":2,"text":"تَنزِيلٌ مِّنَ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ","translation":"[This is] a revelation from the Entirely Merciful, the Especially Merciful -","words":[{"id":1,"arabic":"تَنزِيلٌ","translit":"ٌlyِznَt","root":"نزل"},{"id":2,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":3,"arabic":"ٱلرَّحْمَٰنِ","translit":"ِnَٰmْḥَّrlٱ","root":"رحم"},{"id":4,"arabic":"ٱلرَّحِيمِ","translit":"ِmyِḥَّrlٱ","root":"رحم"}],"hasIhya":false},{"ayah":3,"text":"كِتَٰبٌ فُصِّلَتْ ءَايَٰتُهُۥ قُرْءَانًا عَرَبِيًّا لِّقَوْمٍ يَعْلَمُونَ ","translation":"A Book whose verses have been detailed, an Arabic Qur’ān[1] for a people who know,","words":[{"id":1,"arabic":"كِتَٰبٌ","translit":"ٌbَٰtِk","root":"كتب"},{"id":2,"arabic":"فُصِّلَتْ","translit":"ْtَlِّṣُf","root":"فصل"},{"id":3,"arabic":"ءَايَٰتُهُۥ","translit":"ۥُhُtَٰyāَء","root":"ايي"},{"id":4,"arabic":"قُرْءَانًا","translit":"āًnāَءْrُq","root":"قرا"},{"id":5,"arabic":"عَرَبِيًّا","translit":"āًّyِbَrَʿع","root":"عرب"},{"id":6,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":7,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":4,"text":"بَشِيرًا وَنَذِيرًا فَأَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَعُونَ ","translation":"As a giver of good tidings and a warner; but most of them turn away, so they do not hear.","words":[{"id":1,"arabic":"بَشِيرًا","translit":"āًryِhsَb","root":"بشر"},{"id":2,"arabic":"وَنَذِيرًا","translit":"āًryِhdَnَw","root":"نذر"},{"id":3,"arabic":"فَأَعْرَضَ","translit":"َḍَrْʿعَaʾَf","root":"عرض"},{"id":4,"arabic":"أَكْثَرُهُمْ","translit":"ْmُhُrَhtْkَaʾ","root":"كثر"},{"id":5,"arabic":"فَهُمْ","translit":"ْmُhَf","root":""},{"id":6,"arabic":"لَا","translit":"āَl","root":""},{"id":7,"arabic":"يَسْمَعُونَ","translit":"َnwُʿعَmْsَy","root":"سمع"}],"hasIhya":false},{"ayah":5,"text":"وَقَالُوا۟ قُلُوبُنَا فِىٓ أَكِنَّةٍ مِّمَّا تَدْعُونَآ إِلَيْهِ وَفِىٓ ءَاذَانِنَا وَقْرٌ وَمِنۢ بَيْنِنَا وَبَيْنِكَ حِجَابٌ فَٱعْمَلْ إِنَّنَا عَٰمِلُونَ ","translation":"And they say, \"Our hearts are within coverings [i.e., screened] from that to which you invite us, and in our ears is deafness, and between us and you is a partition, so work;[1] indeed, we are working.\"","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"قُلُوبُنَا","translit":"āَnُbwُlُq","root":"قلب"},{"id":3,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":4,"arabic":"أَكِنَّةٍ","translit":"ٍẗَّnِkَaʾ","root":"كنن"},{"id":5,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":6,"arabic":"تَدْعُونَآ","translit":"ٓāَnwُʿعْdَt","root":"دعو"},{"id":7,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":8,"arabic":"وَفِىٓ","translit":"ٓàِfَw","root":""},{"id":9,"arabic":"ءَاذَانِنَا","translit":"āَnِnāَhdāَء","root":"اذن"},{"id":10,"arabic":"وَقْرٌ","translit":"ٌrْqَw","root":"وقر"},{"id":11,"arabic":"وَمِنۢ","translit":"ۢnِmَw","root":""},{"id":12,"arabic":"بَيْنِنَا","translit":"āَnِnْyَb","root":"بين"},{"id":13,"arabic":"وَبَيْنِكَ","translit":"َkِnْyَbَw","root":"بين"},{"id":14,"arabic":"حِجَابٌ","translit":"ٌbāَjgِḥ","root":"حجب"},{"id":15,"arabic":"فَٱعْمَلْ","translit":"ْlَmْʿعٱَf","root":"عمل"},{"id":16,"arabic":"إِنَّنَا","translit":"āَnَّnِiʾ","root":""},{"id":17,"arabic":"عَٰمِلُونَ","translit":"َnwُlِmَٰʿع","root":"عمل"}],"hasIhya":false},{"ayah":6,"text":"قُلْ إِنَّمَآ أَنَا۠ بَشَرٌ مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ أَنَّمَآ إِلَٰهُكُمْ إِلَٰهٌ وَٰحِدٌ فَٱسْتَقِيمُوٓا۟ إِلَيْهِ وَٱسْتَغْفِرُوهُۗ وَوَيْلٌ لِّلْمُشْرِكِينَ ","translation":"Say, [O Muḥammad], \"I am only a man like you to whom it has been revealed that your god is but one God; so take a straight course to Him and seek His forgiveness.\" And woe to those who associate others with Allāh –","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنَّمَآ","translit":"ٓāَmَّnِiʾ","root":""},{"id":3,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":4,"arabic":"بَشَرٌ","translit":"ٌrَhsَb","root":"بشر"},{"id":5,"arabic":"مِّثْلُكُمْ","translit":"ْmُkُlْhtِّm","root":"مثل"},{"id":6,"arabic":"يُوحَىٰٓ","translit":"ٰٓàَḥwُy","root":"وحي"},{"id":7,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":8,"arabic":"أَنَّمَآ","translit":"ٓāَmَّnَaʾ","root":""},{"id":9,"arabic":"إِلَٰهُكُمْ","translit":"ْmُkُhَٰlِiʾ","root":"اله"},{"id":10,"arabic":"إِلَٰهٌ","translit":"ٌhَٰlِiʾ","root":"اله"},{"id":11,"arabic":"وَٰحِدٌ","translit":"ٌdِḥَٰw","root":"وحد"},{"id":12,"arabic":"فَٱسْتَقِيمُوٓا۟","translit":"۟āٓwُmyِqَtْsٱَf","root":"قوم"},{"id":13,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":14,"arabic":"وَٱسْتَغْفِرُوهُ","translit":"ُhwُrِfْغَtْsٱَw","root":"غفر"},{"id":15,"arabic":"وَوَيْلٌ","translit":"ٌlْyَwَw","root":""},{"id":16,"arabic":"لِّلْمُشْرِكِينَ","translit":"َnyِkِrْhsُmْlِّl","root":"شرك"}],"hasIhya":false},{"ayah":7,"text":"ٱلَّذِينَ لَا يُؤْتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلْءَاخِرَةِ هُمْ كَٰفِرُونَ ","translation":"Those who do not give zakāh, and in the Hereafter they are disbelievers.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"يُؤْتُونَ","translit":"َnwُtْwʾُy","root":"اتي"},{"id":4,"arabic":"ٱلزَّكَوٰةَ","translit":"َẗٰwَkَّzlٱ","root":"زكو"},{"id":5,"arabic":"وَهُم","translit":"mُhَw","root":""},{"id":6,"arabic":"بِٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱِb","root":"اخر"},{"id":7,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":8,"arabic":"كَٰفِرُونَ","translit":"َnwُrِfَٰk","root":"كفر"}],"hasIhya":false},{"ayah":8,"text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ ","translation":"Indeed, those who believe and do righteous deeds - for them is a reward uninterrupted.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":5,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":6,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":7,"arabic":"أَجْرٌ","translit":"ٌrْjgَaʾ","root":"اجر"},{"id":8,"arabic":"غَيْرُ","translit":"ُrْyَغ","root":"غير"},{"id":9,"arabic":"مَمْنُونٍ","translit":"ٍnwُnْmَm","root":"منن"}],"hasIhya":false},{"ayah":9,"text":"قُلْ أَئِنَّكُمْ لَتَكْفُرُونَ بِٱلَّذِى خَلَقَ ٱلْأَرْضَ فِى يَوْمَيْنِ وَتَجْعَلُونَ لَهُۥٓ أَندَادًاۚ ذَٰلِكَ رَبُّ ٱلْعَٰلَمِينَ ","translation":"Say, \"Do you indeed disbelieve in He who created the earth in two days and attribute to Him equals? That is the Lord of the worlds.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أَئِنَّكُمْ","translit":"ْmُkَّnِyʾَaʾ","root":""},{"id":3,"arabic":"لَتَكْفُرُونَ","translit":"َnwُrُfْkَtَl","root":"كفر"},{"id":4,"arabic":"بِٱلَّذِى","translit":"àِhdَّlٱِb","root":""},{"id":5,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":6,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"يَوْمَيْنِ","translit":"ِnْyَmْwَy","root":"يوم"},{"id":9,"arabic":"وَتَجْعَلُونَ","translit":"َnwُlَʿعْjgَtَw","root":"جعل"},{"id":10,"arabic":"لَهُۥٓ","translit":"ٓۥُhَl","root":""},{"id":11,"arabic":"أَندَادًا","translit":"āًdāَdnَaʾ","root":"ندد"},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"رَبُّ","translit":"ُّbَr","root":"ربب"},{"id":14,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":10,"text":"وَجَعَلَ فِيهَا رَوَٰسِىَ مِن فَوْقِهَا وَبَٰرَكَ فِيهَا وَقَدَّرَ فِيهَآ أَقْوَٰتَهَا فِىٓ أَرْبَعَةِ أَيَّامٍ سَوَآءً لِّلسَّآئِلِينَ ","translation":"And He placed on it [i.e., the earth] firmly set mountains over its surface, and He blessed it and determined therein its [creatures'] sustenance in four days without distinction[1] - for [the information of] those who ask.","words":[{"id":1,"arabic":"وَجَعَلَ","translit":"َlَʿعَjgَw","root":"جعل"},{"id":2,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":3,"arabic":"رَوَٰسِىَ","translit":"َàِsَٰwَr","root":"رسو"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"فَوْقِهَا","translit":"āَhِqْwَf","root":"فوق"},{"id":6,"arabic":"وَبَٰرَكَ","translit":"َkَrَٰbَw","root":"برك"},{"id":7,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":8,"arabic":"وَقَدَّرَ","translit":"َrَّdَqَw","root":"قدر"},{"id":9,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":10,"arabic":"أَقْوَٰتَهَا","translit":"āَhَtَٰwْqَaʾ","root":"قوت"},{"id":11,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":12,"arabic":"أَرْبَعَةِ","translit":"ِẗَʿعَbْrَaʾ","root":"ربع"},{"id":13,"arabic":"أَيَّامٍ","translit":"ٍmāَّyَaʾ","root":"يوم"},{"id":14,"arabic":"سَوَآءً","translit":"ًءٓāَwَs","root":"سوي"},{"id":15,"arabic":"لِّلسَّآئِلِينَ","translit":"َnyِlِyʾٓāَّslِّl","root":"سال"}],"hasIhya":false},{"ayah":11,"text":"ثُمَّ ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ وَهِىَ دُخَانٌ فَقَالَ لَهَا وَلِلْأَرْضِ ٱئْتِيَا طَوْعًا أَوْ كَرْهًا قَالَتَآ أَتَيْنَا طَآئِعِينَ ","translation":"Then He directed Himself[1] to the heaven while it was smoke and said to it and to the earth, \"Come [into being],[2] willingly or by compulsion.\" They said, \"We have come willingly.\"","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"ٱسْتَوَىٰٓ","translit":"ٰٓàَwَtْsٱ","root":"سوي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَهِىَ","translit":"َàِhَw","root":""},{"id":6,"arabic":"دُخَانٌ","translit":"ٌnāَhkُd","root":"دخن"},{"id":7,"arabic":"فَقَالَ","translit":"َlāَqَf","root":"قول"},{"id":8,"arabic":"لَهَا","translit":"āَhَl","root":""},{"id":9,"arabic":"وَلِلْأَرْضِ","translit":"ِḍْrَaʾْlِlَw","root":"ارض"},{"id":10,"arabic":"ٱئْتِيَا","translit":"āَyِtْyʾٱ","root":"اتي"},{"id":11,"arabic":"طَوْعًا","translit":"āًʿعْwَṭ","root":"طوع"},{"id":12,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":13,"arabic":"كَرْهًا","translit":"āًhْrَk","root":"كره"},{"id":14,"arabic":"قَالَتَآ","translit":"ٓāَtَlāَq","root":"قول"},{"id":15,"arabic":"أَتَيْنَا","translit":"āَnْyَtَaʾ","root":"اتي"},{"id":16,"arabic":"طَآئِعِينَ","translit":"َnyِʿعِyʾٓāَṭ","root":"طوع"}],"hasIhya":true},{"ayah":12,"text":"فَقَضَىٰهُنَّ سَبْعَ سَمَٰوَاتٍ فِى يَوْمَيْنِ وَأَوْحَىٰ فِى كُلِّ سَمَآءٍ أَمْرَهَاۚ وَزَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَٰبِيحَ وَحِفْظًاۚ ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ ","translation":"And He completed them as seven heavens within two days and inspired [i.e., made known] in each heaven its command. And We adorned the nearest heaven with lamps [i.e., stars, for beauty] and as protection.[1] That is the determination of the Exalted in Might, the Knowing.","words":[{"id":1,"arabic":"فَقَضَىٰهُنَّ","translit":"َّnُhٰàَḍَqَf","root":"قضي"},{"id":2,"arabic":"سَبْعَ","translit":"َʿعْbَs","root":"سبع"},{"id":3,"arabic":"سَمَٰوَاتٍ","translit":"ٍtāَwَٰmَs","root":"سمو"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"يَوْمَيْنِ","translit":"ِnْyَmْwَy","root":"يوم"},{"id":6,"arabic":"وَأَوْحَىٰ","translit":"ٰàَḥْwَaʾَw","root":"وحي"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":9,"arabic":"سَمَآءٍ","translit":"ٍءٓāَmَs","root":"سمو"},{"id":10,"arabic":"أَمْرَهَا","translit":"āَhَrْmَaʾ","root":"امر"},{"id":11,"arabic":"وَزَيَّنَّا","translit":"āَّnَّyَzَw","root":"زين"},{"id":12,"arabic":"ٱلسَّمَآءَ","translit":"َءٓāَmَّslٱ","root":"سمو"},{"id":13,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":14,"arabic":"بِمَصَٰبِيحَ","translit":"َḥyِbَٰṣَmِb","root":"صبح"},{"id":15,"arabic":"وَحِفْظًا","translit":"āًẓْfِḥَw","root":"حفظ"},{"id":16,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":17,"arabic":"تَقْدِيرُ","translit":"ُryِdْqَt","root":"قدر"},{"id":18,"arabic":"ٱلْعَزِيزِ","translit":"ِzyِzَʿعْlٱ","root":"عزز"},{"id":19,"arabic":"ٱلْعَلِيمِ","translit":"ِmyِlَʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":13,"text":"فَإِنْ أَعْرَضُوا۟ فَقُلْ أَنذَرْتُكُمْ صَٰعِقَةً مِّثْلَ صَٰعِقَةِ عَادٍ وَثَمُودَ ","translation":"But if they turn away, then say, \"I have warned you of a thunderbolt like the thunderbolt [that struck] ʿAad and Thamūd.","words":[{"id":1,"arabic":"فَإِنْ","translit":"ْnِiʾَf","root":""},{"id":2,"arabic":"أَعْرَضُوا۟","translit":"۟āwُḍَrْʿعَaʾ","root":"عرض"},{"id":3,"arabic":"فَقُلْ","translit":"ْlُqَf","root":"قول"},{"id":4,"arabic":"أَنذَرْتُكُمْ","translit":"ْmُkُtْrَhdnَaʾ","root":"نذر"},{"id":5,"arabic":"صَٰعِقَةً","translit":"ًẗَqِʿعَٰṣ","root":"صعق"},{"id":6,"arabic":"مِّثْلَ","translit":"َlْhtِّm","root":"مثل"},{"id":7,"arabic":"صَٰعِقَةِ","translit":"ِẗَqِʿعَٰṣ","root":"صعق"},{"id":8,"arabic":"عَادٍ","translit":"ٍdāَʿع","root":"عود"},{"id":9,"arabic":"وَثَمُودَ","translit":"َdwُmَhtَw","root":""}],"hasIhya":false},{"ayah":14,"text":"إِذْ جَآءَتْهُمُ ٱلرُّسُلُ مِنۢ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ أَلَّا تَعْبُدُوٓا۟ إِلَّا ٱللَّهَۖ قَالُوا۟ لَوْ شَآءَ رَبُّنَا لَأَنزَلَ مَلَٰٓئِكَةً فَإِنَّا بِمَآ أُرْسِلْتُم بِهِۦ كَٰفِرُونَ ","translation":"[That occurred] when the messengers had come to them before them and after them, [saying], \"Worship not except Allāh.\" They said, \"If our Lord had willed,[1] He would have sent down the angels, so indeed we, in that with which you have been sent, are disbelievers.\"","words":[{"id":1,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":2,"arabic":"جَآءَتْهُمُ","translit":"ُmُhْtَءٓāَjg","root":"جيا"},{"id":3,"arabic":"ٱلرُّسُلُ","translit":"ُlُsُّrlٱ","root":"رسل"},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَيْنِ","translit":"ِnْyَb","