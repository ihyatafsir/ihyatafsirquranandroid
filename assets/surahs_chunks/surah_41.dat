 {"surah": 41, "ayah": 21, "text": "وَقَالُواْ لِجُلُودِهِمْ لِمَ شَهِدتُّمْ عَلَيْنَاۖ قَالُوٓاْ أَنطَقَنَا اَ۬للَّهُ اُ۬لذِےٓ أَنطَقَ كُلَّ شَےْءࣲۖ وَهُوَ خَلَقَكُمُۥٓ أَوَّلَ مَرَّةࣲ وَإِلَيْهِ تُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِجُلُودِهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "شَهِدتُّمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْنَاۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنطَقَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لذِےٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَنطَقَ", "translit": "", "root": ""}, {"id": 11, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "شَےْءࣲۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 14, "arabic": "خَلَقَكُمُۥٓ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَوَّلَ", "translit": "", "root": ""}, {"id": 16, "arabic": "مَرَّةࣲ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَإِلَيْهِ", "translit": "", "root": ""}, {"id": 18, "arabic": "تُرْجَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 22, "text": "وَمَا كُنتُمْ تَسْتَتِرُونَ أَنْ يَّشْهَدَ عَلَيْكُمْ سَمْعُكُمْ وَلَآ أَبْصَٰرُكُمْ وَلَا جُلُودُكُمْۖ وَلَٰكِن ظَنَنتُمُۥٓ أَنَّ اَ۬للَّهَ لَا يَعْلَمُ كَثِيراࣰ مِّمَّا تَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَسْتَتِرُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَّشْهَدَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "سَمْ