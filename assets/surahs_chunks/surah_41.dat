": 42, "text": "لَّا يَاتِيهِ اِ۬لْبَٰطِلُ مِنۢ بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِۦۖ تَنزِيلࣱ مِّنْ حَكِيمٍ حَمِيدࣲۖ", "words": [{"id": 1, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَاتِيهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْبَٰطِلُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنِ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَدَيْهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "خَلْفِهِۦۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "تَنزِيلࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 12, "arabic": "حَكِيمٍ", "translit": "", "root": ""}, {"id": 13, "arabic": "حَمِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 43, "text": "مَّا يُقَالُ لَكَ إِلَّا مَا قَدْ قِيلَ لِلرُّسُلِ مِن قَبْلِكَۖ إِنَّ رَبَّكَ لَذُو مَغْفِرَةࣲ وَذُو عِقَابٍ اَلِيمࣲۖ", "words": [{"id": 1, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُقَالُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِلرُّسُلِ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "", "root": ""}, {"id": 10, "arabic": "قَبْلِكَۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَذُو", "translit": "", "root": ""}, {"id": 14, "arabic": "مَغْفِرَةࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَذُو", "translit": "", "root": ""}, {"id":