it": "", "root": ""}, {"id": 4, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُسَبِّحُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِاليْلِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَالنَّه۪ارِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "", "root": ""}, {"id": 12, "arabic": "يَسْـَٔمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 39, "text": "وَمِنَ اٰيَٰتِهِۦٓ أَنَّكَ تَرَي اَ۬لَارْضَ خَٰشِعَةࣰ فَإِذَآ أَنزَلْنَا عَلَيْهَا اَ۬لْمَآءَ اَ۪هْتَزَّتْ وَرَبَتِۖ اِنَّ اَ۬لذِےٓ أَحْي۪اهَا لَمُحْيِ اِ۬لْمَوْت۪يٰٓۖ إِنَّهُۥ عَلَيٰ كُلِّ شَےْءࣲ قَدِيرٌۖ", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اٰيَٰتِهِۦٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَرَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لَارْضَ", "translit": "", "root": ""}, {"id": 6, "arabic": "خَٰشِعَةࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَإِذَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنزَلْنَا", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيْهَا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْمَآءَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۪هْتَزَّتْ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَرَبَتِۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لذِےٓ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَحْي۪اهَا", "translit": "", "root": ""}, {"id": 16, "arabic": "لَمُحْيِ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِ۬لْمَوْت۪يٰٓۖ", "translit": "", "root": ""}, {"id": 18, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 19, "ar