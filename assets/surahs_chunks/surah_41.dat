:"ارض"},{"id":6,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":7,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":8,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":9,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":10,"arabic":"أَشَدُّ","translit":"ُّdَhsَaʾ","root":"شدد"},{"id":11,"arabic":"مِنَّا","translit":"āَّnِm","root":""},{"id":12,"arabic":"قُوَّةً","translit":"ًẗَّwُq","root":"قوي"},{"id":13,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":14,"arabic":"يَرَوْا۟","translit":"۟āْwَrَy","root":"راي"},{"id":15,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":16,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":17,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":18,"arabic":"خَلَقَهُمْ","translit":"ْmُhَqَlَhk","root":"خلق"},{"id":19,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":20,"arabic":"أَشَدُّ","translit":"ُّdَhsَaʾ","root":"شدد"},{"id":21,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":22,"arabic":"قُوَّةً","translit":"ًẗَّwُq","root":"قوي"},{"id":23,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":24,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":25,"arabic":"يَجْحَدُونَ","translit":"َnwُdَḥْjgَy","root":"جحد"}],"hasIhya":true},{"ayah":16,"text":"فَأَرْسَلْنَا عَلَيْهِمْ رِيحًا صَرْصَرًا فِىٓ أَيَّامٍ نَّحِسَاتٍ لِّنُذِيقَهُمْ عَذَابَ ٱلْخِزْىِ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَخْزَىٰۖ وَهُمْ لَا يُنصَرُونَ ","translation":"So We sent upon them a screaming wind during days of misfortune to make them taste the punishment of disgrace in the worldly life; but the punishment of the Hereafter is more disgracing, and they will not be helped.","words":[{"id":1,"arabic":"فَأَرْسَلْنَا","translit":"āَnْlَsْrَaʾَf","root":"رسل"},{"id":2,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":3,"arabic":"رِيحًا","translit":"āًḥyِr","root":"روح"},{"id":4,"arabic":"صَرْصَرًا","translit":"āًrَṣْrَṣ","root":"صرصر"},{"id":5,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":6,"arabic":"أَيَّامٍ","translit":"ٍmāَّyَaʾ","root":"يوم"},{"id":7,"arabic":"نَّحِسَاتٍ","translit":"ٍtāَsِḥَّn","root":"نحس"},{"id":8,"arabic":"لِّنُذِيقَهُمْ","translit":"ْmُhَqyِhdُnِّl","root":"ذوق"},{"id":9,"arabic":"عَذَابَ","translit":"َbāَhdَʿع","root":"عذب"},{"id":10,"arabic":"ٱلْخِزْىِ","translit":"ِàْzِhkْlٱ","root":"خزي"},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":13,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":14,"arabic":"وَلَعَذَابُ","translit":"ُbāَhdَʿعَlَw","root":"عذب"},{"id":15,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":16,"arabic":"أَخْزَىٰ","translit":"ٰàَzْhkَaʾ","root":"خزي"},{"id":17,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":18,"arabic":"لَا","translit":"āَl","root":""},{"id":19,"arabic":"يُنصَرُونَ","translit":"َnwُrَṣnُy","root":"نصر"}],"hasIhya":false},{"ayah":17,"text":"وَأَمَّا ثَمُودُ فَهَدَيْنَٰهُمْ فَٱسْتَحَبُّوا۟ ٱلْعَمَىٰ عَلَى ٱلْهُدَىٰ فَأَخَذَتْهُمْ صَٰعِقَةُ ٱلْعَذَابِ ٱلْهُونِ بِمَا كَانُوا۟ يَكْسِبُونَ ","translation":"And as for Thamūd, We guided them, but they preferred blindness over guidance, so the thunderbolt of humiliating punishment seized them for what they used to earn.","words":[{"id":1,"arabic":"وَأَمَّا","translit":"āَّmَaʾَw","root":""},{"id":2,"arabic":"ثَمُودُ","translit":"ُdwُmَht","root":""},{"id":3,"arabic":"فَهَدَيْنَٰهُمْ","translit":"ْmُhَٰnْyَdَhَf","root":"هدي"},{"id":4,"arabic":"فَٱسْتَحَبُّوا۟","translit":"۟āwُّbَḥَtْsٱَf","root":"حبب"},{"id":5,"arabic":"ٱلْعَمَىٰ","translit":"ٰàَmَʿعْlٱ","root":"عمي"},{"id":6,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":7,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":8,"arabic":"فَأَخَذَتْهُمْ","translit":"ْmُhْtَhdَhkَaʾَf","root":"اخذ"},{"id":9,"arabic":"صَٰعِقَةُ","translit":"ُẗَqِʿعَٰṣ","root":"صعق"},{"id":10,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":11,"arabic":"ٱلْهُونِ","translit":"ِnwُhْlٱ","root":"هون"},{"id":12,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":13,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":14,"arabic":"يَكْسِبُونَ","translit":"َnwُbِsْkَy","root":"كسب"}],"hasIhya":true},{"ayah":18,"text":"وَنَجَّيْنَا ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟ يَتَّقُونَ ","translation":"And We saved those who believed and used to fear Allāh.","words":[{"id":1,"arabic":"وَنَجَّيْنَا","translit":"āَnْyَّjgَnَw","root":"نجو"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":5,"arabic":"يَتَّقُونَ","translit":"َnwُqَّtَy","root":"وقي"}],"hasIhya":false},{"ayah":19,"text":"وَيَوْمَ يُحْشَرُ أَعْدَآءُ ٱللَّهِ إِلَى ٱلنَّارِ فَهُمْ يُوزَعُونَ ","translation":"And [mention, O Muḥammad], the Day when the enemies of Allāh will be gathered to the Fire while they are [driven], assembled in rows,","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"يُحْشَرُ","translit":"ُrَhsْḥُy","root":"حشر"},{"id":3,"arabic":"أَعْدَآءُ","translit":"ُءٓāَdْʿعَaʾ","root":"عدو"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":6,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":7,"arabic":"فَهُمْ","translit":"ْmُhَf","root":""},{"id":8,"arabic":"يُوزَعُونَ","translit":"َnwُʿعَzwُy","root":"وزع"}],"hasIhya":false},{"ayah":20,"text":"حَتَّىٰٓ إِذَا مَا جَآءُوهَا شَهِدَ عَلَيْهِمْ سَمْعُهُمْ وَأَبْصَٰرُهُمْ وَجُلُودُهُم بِمَا كَانُوا۟ يَعْمَلُونَ ","translation":"Until, when they reach it, their hearing and their eyes and their skins will testify against them of what they used to do.","words":[{"id":1,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":2,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"جَآءُوهَا","translit":"āَhwُءٓāَjg","root":"جيا"},{"id":5,"arabic":"شَهِدَ","translit":"َdِhَhs","root":"شهد"},{"id":6,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":7,"arabic":"سَمْعُهُمْ","translit":"ْmُhُʿعْmَs","root":"سمع"},{"id":8,"arabic":"وَأَبْصَٰرُهُمْ","translit":"ْmُhُrَٰṣْbَaʾَw","root":"بصر"},{"id":9,"arabic":"وَجُلُودُهُم","translit":"mُhُdwُlُjgَw","root":"جلد"},{"id":10,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":11,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":12,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":21,"text":"وَقَالُوا۟ لِجُلُودِهِمْ لِمَ شَهِدتُّمْ عَلَيْنَاۖ قَالُوٓا۟ أَنطَقَنَا ٱللَّهُ ٱلَّذِىٓ أَنطَقَ كُلَّ شَىْءٍ وَهُوَ خَلَقَكُمْ أَوَّلَ مَرَّةٍ وَإِلَيْهِ تُرْجَعُونَ ","translation":"And they will say to their skins, \"Why have you testified against us?\" They will say, \"We were made to speak by Allāh, who has made everything speak; and He created you the first time, and to Him you are returned.","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"لِجُلُودِهِمْ","translit":"ْmِhِdwُlُjgِl","root":"جلد"},{"id":3,"arabic":"لِمَ","translit":"َmِl","root":""},{"id":4,"arabic":"شَهِدتُّمْ","translit":"ْmُّtdِhَhs","root":"شهد"},{"id":5,"arabic":"عَلَيْنَا","translit":"āَnْyَlَʿع","root":""},{"id":6,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":7,"arabic":"أَنطَقَنَا","translit":"āَnَqَṭnَaʾ","root":"نطق"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":10,"arabic":"أَنطَقَ","translit":"َqَṭnَaʾ","root":"نطق"},{"id":11,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":12,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":13,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":14,"arabic":"خَلَقَكُمْ","translit":"ْmُkَqَlَhk","root":"خلق"},{"id":15,"arabic":"أَوَّلَ","translit":"َlَّwَaʾ","root":"اول"},{"id":16,"arabic":"مَرَّةٍ","translit":"ٍẗَّrَm","root":"مرر"},{"id":17,"arabic":"وَإِلَيْهِ","translit":"ِhْyَlِiʾَw","root":""},{"id":18,"arabic":"تُرْجَعُونَ","translit":"َnwُʿعَjgْrُt","root":"رجع"}],"hasIhya":true},{"ayah":22,"text":"وَمَا كُنتُمْ تَسْتَتِرُونَ أَن يَشْهَدَ عَلَيْكُمْ سَمْعُكُمْ وَلَآ أَبْصَٰرُكُمْ وَلَا جُلُودُكُمْ وَلَٰكِن ظَنَنتُمْ أَنَّ ٱللَّهَ لَا يَعْلَمُ كَثِيرًا مِّمَّا تَعْمَلُونَ ","translation":"And you were not covering [i.e., protecting] yourselves,[1] lest your hearing testify against you or your sight or your skins, but you assumed that Allāh does not know much of what you do.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":3,"arabic":"تَسْتَتِرُونَ","translit":"َnwُrِtَtْsَt","root":"ستر"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَشْهَدَ","translit":"َdَhْhsَy","root":"شهد"},{"id":6,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":7,"arabic":"سَمْعُكُمْ","translit":"ْmُkُʿعْmَs","root":"سمع"},{"id":8,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":9,"arabic":"أَبْصَٰرُكُمْ","translit":"ْmُkُrَٰṣْbَaʾ","root":"بصر"},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"جُلُودُكُمْ","translit":"ْmُkُdwُlُjg","root":"جلد"},{"id":12,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":13,"arabic":"ظَنَنتُمْ","translit":"ْmُtnَnَẓ","root":"ظنن"},{"id":14,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":15,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":16,"arabic":"لَا","translit":"āَl","root":""},{"id":17,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":18,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":19,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":20,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":false},{"ayah":23,"text":"وَذَٰلِكُمْ ظَنُّكُمُ ٱلَّذِى ظَنَنتُم بِرَبِّكُمْ أَرْدَىٰكُمْ فَأَصْبَحْتُم مِّنَ ٱلْخَٰسِرِينَ ","translation":"And that was your assumption which you assumed about your Lord. It has brought you to ruin, and you have become among the losers.\"","words":[{"id":1,"arabic":"وَذَٰلِكُمْ","translit":"ْmُkِlَٰhdَw","root":""},{"id":2,"arabic":"ظَنُّكُمُ","translit":"ُmُkُّnَẓ","root":"ظنن"},{"id":3,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":4,"arabic":"ظَنَنتُم","translit":"mُtnَnَẓ","root":"ظنن"},{"id":5,"arabic":"بِرَبِّكُمْ","translit":"ْmُkِّbَrِb","root":"ربب"},{"id":6,"arabic":"أَرْدَىٰكُمْ","translit":"ْmُkٰàَdْrَaʾ","root":"ردي"},{"id":7,"arabic":"فَأَصْبَحْتُم","translit":"mُtْḥَbْṣَaʾَf","root":"صبح"},{"id":8,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":9,"arabic":"ٱلْخَٰسِرِينَ","translit":"َnyِrِsَٰhkْlٱ","root":"خسر"}],"hasIhya":true},{"ayah":24,"text":"فَإِن يَصْبِرُوا۟ فَٱلنَّارُ مَثْوًى لَّهُمْۖ وَإِن يَسْتَعْتِبُوا۟ فَمَا هُم مِّنَ ٱلْمُعْتَبِينَ ","translation":"So [even] if they are patient, the Fire is a residence for them; and if they ask to appease [Allāh], they will not be of those who are allowed to appease.","words":[{"id":1,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":2,"arabic":"يَصْبِرُوا۟","translit":"۟āwُrِbْṣَy","root":"صبر"},{"id":3,"arabic":"فَٱلنَّارُ","translit":"ُrāَّnlٱَf","root":"نور"},{"id":4,"arabic":"مَثْوًى","translit":"àًwْhtَm","root":"ثوي"},{"id":5,"arabic":"لَّهُمْ","translit":"ْmُhَّl","root":""},{"id":6,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":7,"arabic":"يَسْتَعْتِبُوا۟","translit":"۟āwُbِtْʿعَtْsَy","root":"عتب"},{"id":8,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":9,"arabic":"هُم","translit":"mُh","root":""},{"id":10,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":11,"arabic":"ٱلْمُعْتَبِينَ","translit":"َnyِbَtْʿعُmْlٱ","root":"عتب"}],"hasIhya":false},{"ayah":25,"text":"وَقَيَّضْنَا لَهُمْ قُرَنَآءَ فَزَيَّنُوا۟ لَهُم مَّا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَحَقَّ عَلَيْهِمُ ٱلْقَوْلُ فِىٓ أُمَمٍ قَدْ خَلَتْ مِن قَبْلِهِم مِّنَ ٱلْجِنِّ وَٱلْإِنسِۖ إِنَّهُمْ كَانُوا۟ خَٰسِرِينَ ","translation":"And We appointed for them companions[1] who made attractive to them what was before them and what was behind them [of sin], and the word [i.e., decree] has come into effect upon them among nations which had passed on before them of jinn and men. Indeed, they [all] were losers.","words":[{"id":1,"arabic":"وَقَيَّضْنَا","translit":"āَnْḍَّyَqَw","root":"قيض"},{"id":2,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":3,"arabic":"قُرَنَآءَ","translit":"َءٓāَnَrُq","root":"قرن"},{"id":4,"arabic":"فَزَيَّنُوا۟","translit":"۟āwُnَّyَzَf","root":"زين"},{"id":5,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":6,"arabic":"مَّا","translit":"āَّm","root":""},{"id":7,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":8,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":9,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":10,"arabic":"خَلْفَهُمْ","translit":"ْmُhَfْlَhk","root":"خلف"},{"id":11,"arabic":"وَحَقَّ","translit":"َّqَḥَw","root":"حقق"},{"id":12,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":13,"arabic":"ٱلْقَوْلُ","translit":"ُlْwَqْlٱ","root":"قول"},{"id":14,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":15,"arabic":"أُمَمٍ","translit":"ٍmَmُaʾ","root":"امم"},{"id":16,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":17,"arabic":"خَلَتْ","translit":"ْtَlَhk","root":"خلو"},{"id":18,"arabic":"مِن","translit":"nِm","root":""},{"id":19,"arabic":"قَبْلِهِم","translit":"mِhِlْbَq","root":"قبل"},{"id":20,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":21,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":22,"arabic":"وَٱلْإِنسِ","translit":"ِsnِiʾْlٱَw","root":"انس"},{"id":23,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":24,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":25,"arabic":"خَٰسِرِينَ","translit":"َnyِrِsَٰhk","root":"خسر"}],"hasIhya":false},{"ayah":26,"text":"وَقَالَ ٱلَّذِينَ كَفَرُوا۟ لَا تَسْمَعُوا۟ لِهَٰذَا ٱلْقُرْءَانِ وَٱلْغَوْا۟ فِيهِ لَعَلَّكُمْ تَغْلِبُونَ ","translation":"And those who disbelieve say, \"Do not listen to this Qur’ān and speak noisily[1] during [the recitation of] it that perhaps you will overcome.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَسْمَعُوا۟","translit":"۟āwُʿعَmْsَt","root":"سمع"},{"id":6,"arabic":"لِهَٰذَا","translit":"āَhdَٰhِl","root":""},{"id":7,"arabic":"ٱلْقُرْءَانِ","translit":"ِnāَءْrُqْlٱ","root":"قرا"},{"id":8,"arabic":"وَٱلْغَوْا۟","translit":"۟āْwَغْlٱَw","root":"لغو"},{"id":9,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":10,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":11,"arabic":"تَغْلِبُونَ","translit":"َnwُbِlْغَt","root":"غلب"}],"hasIhya":true},{"ayah":27,"text":"فَلَنُذِيقَنَّ ٱلَّذِينَ كَفَرُوا۟ عَذَابًا شَدِيدًا وَلَنَجْزِيَنَّهُمْ أَسْوَأَ ٱلَّذِى كَانُوا۟ يَعْمَلُونَ ","translation":"But We will surely cause those who disbelieve to taste a severe punishment, and We will surely recompense them for the worst of what they had been doing.","words":[{"id":1,"arabic":"فَلَنُذِيقَنَّ","translit":"َّnَqyِhdُnَlَf","root":"ذوق"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":5,"arabic":"شَدِيدًا","translit":"āًdyِdَhs","root":"شدد"},{"id":6,"arabic":"وَلَنَجْزِيَنَّهُمْ","translit":"ْmُhَّnَyِzْjgَnَlَw","root":"جزي"},{"id":7,"arabic":"أَسْوَأَ","translit":"َaʾَwْsَaʾ","root":"سوا"},{"id":8,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":9,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":10,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":28,"text":"ذَٰلِكَ جَزَآءُ أَعْدَآءِ ٱللَّهِ ٱلنَّارُۖ لَهُمْ فِيهَا دَارُ ٱلْخُلْدِۖ جَزَآءًۢ بِمَا كَانُوا۟ بِـَٔايَٰتِنَا يَجْحَدُونَ ","translation":"That is the recompense of the enemies of Allāh - the Fire. For them therein is the home of eternity as recompense for what they, of Our verses, were rejecting.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"جَزَآءُ","translit":"ُءٓāَzَjg","root":"جزي"},{"id":3,"arabic":"أَعْدَآءِ","translit":"ِءٓāَdْʿعَaʾ","root":"عدو"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"ٱلنَّارُ","translit":"ُrāَّnlٱ","root":"نور"},{"id":6,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":7,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":8,"arabic":"دَارُ","translit":"ُrāَd","root":"دور"},{"id":9,"arabic":"ٱلْخُلْدِ","translit":"ِdْlُhkْlٱ","root":"خلد"},{"id":10,"arabic":"جَزَآءًۢ","translit":"ًۢءٓāَzَjg","root":"جزي"},{"id":11,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":12,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":13,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":14,"arabic":"يَجْحَدُونَ","translit":"َnwُdَḥْjgَy","root":"جحد"}],"hasIhya":false},{"ayah":29,"text":"وَقَالَ ٱلَّذِينَ كَفَرُوا۟ رَبَّنَآ أَرِنَا ٱلَّذَيْنِ أَضَلَّانَا مِنَ ٱلْجِنِّ وَٱلْإِنسِ نَجْعَلْهُمَا تَحْتَ أَقْدَامِنَا لِيَكُونَا مِنَ ٱلْأَسْفَلِينَ ","translation":"And those who disbelieved will [then] say, \"Our Lord, show us those who misled us of the jinn and men [so] we may put them under our feet[1] that they will be among the lowest.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"رَبَّنَآ","translit":"ٓāَnَّbَr","root":"ربب"},{"id":5,"arabic":"أَرِنَا","translit":"āَnِrَaʾ","root":"راي"},{"id":6,"arabic":"ٱلَّذَيْنِ","translit":"ِnْyَhdَّlٱ","root":""},{"id":7,"arabic":"أَضَلَّانَا","translit":"āَnāَّlَḍَaʾ","root":"ضلل"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":10,"arabic":"وَٱلْإِنسِ","translit":"ِsnِiʾْlٱَw","root":"انس"},{"id":11,"arabic":"نَجْعَلْهُمَا","translit":"āَmُhْlَʿعْjgَn","root":"جعل"},{"id":12,"arabic":"تَحْتَ","translit":"َtْḥَt","root":"تحت"},{"id":13,"arabic":"أَقْدَامِنَا","translit":"āَnِmāَdْqَaʾ","root":"قدم"},{"id":14,"arabic":"لِيَكُونَا","translit":"āَnwُkَyِl","root":"كون"},{"id":15,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":16,"arabic":"ٱلْأَسْفَلِينَ","translit":"َnyِlَfْsَaʾْlٱ","root":"سفل"}],"hasIhya":false},{"ayah":30,"text":"إِنَّ ٱلَّذِينَ قَالُوا۟ رَبُّنَا ٱللَّهُ ثُمَّ ٱسْتَقَٰمُوا۟ تَتَنَزَّلُ عَلَيْهِمُ ٱلْمَلَٰٓئِكَةُ أَلَّا تَخَافُوا۟ وَلَا تَحْزَنُوا۟ وَأَبْشِرُوا۟ بِٱلْجَنَّةِ ٱلَّتِى كُنتُمْ تُوعَدُونَ ","translation":"Indeed, those who have said, \"Our Lord is Allāh\" and then remained on a right course - the angels will descend upon them, [saying], \"Do not fear and do not grieve but receive good tidings of Paradise, which you were promised.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":4,"arabic":"رَبُّنَا","translit":"āَnُّbَr","root":"ربب"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"ٱسْتَقَٰمُوا۟","translit":"۟āwُmَٰqَtْsٱ","root":"قوم"},{"id":8,"arabic":"تَتَنَزَّلُ","translit":"ُlَّzَnَtَt","root":"نزل"},{"id":9,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":10,"arabic":"ٱلْمَلَٰٓئِكَةُ","translit":"ُẗَkِyʾَٰٓlَmْlٱ","root":"ملك"},{"id":11,"arabic":"أَلَّا","translit":"āَّlَaʾ","root":""},{"id":12,"arabic":"تَخَافُوا۟","translit":"۟āwُfāَhkَt","root":"خوف"},{"id":13,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":14,"arabic":"تَحْزَنُوا۟","translit":"۟āwُnَzْḥَt","root":"حزن"},{"id":15,"arabic":"وَأَبْشِرُوا۟","translit":"۟āwُrِhsْbَaʾَw","root":"بشر"},{"id":16,"arabic":"بِٱلْجَنَّةِ","translit":"ِẗَّnَjgْlٱِb","root":"جنن"},{"id":17,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":18,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":19,"arabic":"تُوعَدُونَ","translit":"َnwُdَʿعwُt","root":"وعد"}],"hasIhya":true},{"ayah":31,"text":"نَحْنُ أَوْلِيَآؤُكُمْ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَفِى ٱلْءَاخِرَةِۖ وَلَكُمْ فِيهَا مَا تَشْتَهِىٓ أَنفُسُكُمْ وَلَكُمْ فِيهَا مَا تَدَّعُونَ ","translation":"We [angels] were your allies in worldly life and [are so] in the Hereafter. And you will have therein whatever your souls desire, and you will have therein whatever you request [or wish]","words":[{"id":1,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":2,"arabic":"أَوْلِيَآؤُكُمْ","translit":"ْmُkُwʾٓāَyِlْwَaʾ","root":"ولي"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":5,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":6,"arabic":"وَفِى","translit":"àِfَw","root":""},{"id":7,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":8,"arabic":"وَلَكُمْ","translit":"ْmُkَlَw","root":""},{"id":9,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"تَشْتَهِىٓ","translit":"ٓàِhَtْhsَt","root":"شهو"},{"id":12,"arabic":"أَنفُسُكُمْ","translit":"ْmُkُsُfnَaʾ","root":"نفس"},{"id":13,"arabic":"وَلَكُمْ","translit":"ْmُkَlَw","root":""},{"id":14,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":15,"arabic":"مَا","translit":"āَm","root":""},{"id":16,"arabic":"تَدَّعُونَ","translit":"َnwُʿعَّdَt","root":"دعو"}],"hasIhya":false},{"ayah":32,"text":"نُزُلًا مِّنْ غَفُورٍ رَّحِيمٍ ","translation":"As accommodation from a [Lord who is] Forgiving and Merciful.\"","words":[{"id":1,"arabic":"نُزُلًا","translit":"āًlُzُn","root":"نزل"},{"id":2,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":3,"arabic":"غَفُورٍ","translit":"ٍrwُfَغ","root":"غفر"},{"id":4,"arabic":"رَّحِيمٍ","translit":"ٍmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":33,"text":"وَمَنْ أَحْسَنُ قَوْلًا مِّمَّن دَعَآ إِلَى ٱللَّهِ وَعَمِلَ صَٰلِحًا وَقَالَ إِنَّنِى مِنَ ٱلْمُسْلِمِينَ ","translation":"And who is better in speech than one who invites to Allāh and does righteousness and says, \"Indeed, I am of the Muslims.\"","words":[{"id":1,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":2,"arabic":"أَحْسَنُ","translit":"ُnَsْḥَaʾ","root":"حسن"},{"id":3,"arabic":"قَوْلًا","translit":"āًlْwَq","root":"قول"},{"id":4,"arabic":"مِّمَّن","translit":"nَّmِّm","root":""},{"id":5,"arabic":"دَعَآ","translit":"ٓāَʿعَd","root":"دعو"},{"id":6,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"وَعَمِلَ","translit":"َlِmَʿعَw","root":"عمل"},{"id":9,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":10,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":11,"arabic":"إِنَّنِى","translit":"àِnَّnِiʾ","root":""},{"id":12,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":13,"arabic":"ٱلْمُسْلِمِينَ","translit":"َnyِmِlْsُmْlٱ","root":"سلم"}],"hasIhya":true},{"ayah":34,"text":"وَلَا تَسْتَوِى ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُۚ ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ فَإِذَا ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ عَدَٰوَةٌ كَأَنَّهُۥ وَلِىٌّ حَمِيمٌ ","translation":"And not equal are the good deed and the bad. Repel [evil] by that [deed] which is better; and thereupon, the one whom between you and him is enmity [will become] as though he was a devoted friend.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَسْتَوِى","translit":"àِwَtْsَt","root":"سوي"},{"id":3,"arabic":"ٱلْحَسَنَةُ","translit":"ُẗَnَsَḥْlٱ","root":"حسن"},{"id":4,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":5,"arabic":"ٱلسَّيِّئَةُ","translit":"ُẗَyʾِّyَّslٱ","root":"سوا"},{"id":6,"arabic":"ٱدْفَعْ","translit":"ْʿعَfْdٱ","root":"دفع"},{"id":7,"arabic":"بِٱلَّتِى","translit":"àِtَّlٱِb","root":""},{"id":8,"arabic":"هِىَ","translit":"َàِh","root":""},{"id":9,"arabic":"أَحْسَنُ","translit":"ُnَsْḥَaʾ","root":"حسن"},{"id":10,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":11,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":12,"arabic":"بَيْنَكَ","translit":"َkَnْyَb","root":"بين"},{"id":13,"arabic":"وَبَيْنَهُۥ","translit":"ۥُhَnْyَbَw","root":"بين"},{"id":14,"arabic":"عَدَٰوَةٌ","translit":"ٌẗَwَٰdَʿع","root":"عدو"},{"id":15,"arabic":"كَأَنَّهُۥ","translit":"ۥُhَّnَaʾَk","root":""},{"id":16,"arabic":"وَلِىٌّ","translit":"ٌّàِlَw","root":"ولي"},{"id":17,"arabic":"حَمِيمٌ","translit":"ٌmyِmَḥ","root":"حمم"}],"hasIhya":true},{"ayah":35,"text":"وَمَا يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ صَبَرُوا۟ وَمَا يُلَقَّىٰهَآ إِلَّا ذُو حَظٍّ عَظِيمٍ ","translation":"But none is granted it except those who are patient, and none is granted it except one having a great portion [of good].","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"يُلَقَّىٰهَآ","translit":"ٓāَhٰàَّqَlُy","root":"لقي"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"صَبَرُوا۟","translit":"۟āwُrَbَṣ","root":"صبر"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"يُلَقَّىٰهَآ","translit":"ٓāَhٰàَّqَlُy","root":"لقي"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"ذُو","translit":"wُhd","root":""},{"id":10,"arabic":"حَظٍّ","translit":"ٍّẓَḥ","root":"حظظ"},{"id":11,"arabic":"عَظِيمٍ","translit":"ٍmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":36,"text":"وَإِمَّا يَنزَغَنَّكَ مِنَ ٱلشَّيْطَٰنِ نَزْغٌ فَٱسْتَعِذْ بِٱللَّهِۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ","translation":"And if there comes to you from Satan an evil suggestion, then seek refuge in Allāh. Indeed, He is the Hearing, the Knowing.","words":[{"id":1,"arabic":"وَإِمَّا","translit":"āَّmِiʾَw","root":""},{"id":2,"arabic":"يَنزَغَنَّكَ","translit":"َkَّnَغَznَy","root":"نزغ"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":5,"arabic":"نَزْغٌ","translit":"ٌغْzَn","root":"نزغ"},{"id":6,"arabic":"فَٱسْتَعِذْ","translit":"ْhdِʿعَtْsٱَf","root":"عوذ"},{"id":7,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":8,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":9,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":10,"arabic":"ٱلسَّمِيعُ","translit":"ُʿعyِmَّslٱ","root":"سمع"},{"id":11,"arabic":"ٱلْعَلِيمُ","translit":"ُmyِlَʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":37,"text":"وَمِنْ ءَايَٰتِهِ ٱلَّيْلُ وَٱلنَّهَارُ وَٱلشَّمْسُ وَٱلْقَمَرُۚ لَا تَسْجُدُوا۟ لِلشَّمْسِ وَلَا لِلْقَمَرِ وَٱسْجُدُوا۟ لِلَّهِ ٱلَّذِى خَلَقَهُنَّ إِن كُنتُمْ إِيَّاهُ تَعْبُدُونَ ","translation":"And of His signs are the night and day and the sun and moon. Do not prostrate to the sun or to the moon, but prostrate to Allāh, who created them, if it should be Him that you worship.[1]","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِ","translit":"ِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"ٱلَّيْلُ","translit":"ُlْyَّlٱ","root":"ليل"},{"id":4,"arabic":"وَٱلنَّهَارُ","translit":"ُrāَhَّnlٱَw","root":"نهر"},{"id":5,"arabic":"وَٱلشَّمْسُ","translit":"ُsْmَّhslٱَw","root":"شمس"},{"id":6,"arabic":"وَٱلْقَمَرُ","translit":"ُrَmَqْlٱَw","root":"قمر"},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"تَسْجُدُوا۟","translit":"۟āwُdُjgْsَt","root":"سجد"},{"id":9,"arabic":"لِلشَّمْسِ","translit":"ِsْmَّhslِl","root":"شمس"},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"لِلْقَمَرِ","translit":"ِrَmَqْlِl","root":"قمر"},{"id":12,"arabic":"وَٱسْجُدُوا۟","translit":"۟āwُdُjgْsٱَw","root":"سجد"},{"id":13,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":14,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":15,"arabic":"خَلَقَهُنَّ","translit":"َّnُhَqَlَhk","root":"خلق"},{"id":16,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":17,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":18,"arabic":"إِيَّاهُ","translit":"ُhāَّyِiʾ","root":""},{"id":19,"arabic":"تَعْبُدُونَ","translit":"َnwُdُbْʿعَt","root":"عبد"}],"hasIhya":false},{"ayah":38,"text":"فَإِنِ ٱسْتَكْبَرُوا۟ فَٱلَّذِينَ عِندَ رَبِّكَ يُسَبِّحُونَ لَهُۥ بِٱلَّيْلِ وَٱلنَّهَارِ وَهُمْ لَا يَسْـَٔمُونَ۩ ","translation":"But if they are arrogant - then those who are near your Lord [i.e., the angels] exalt Him by night and by day, and they do not become weary.","words":[{"id":1,"arabic":"فَإِنِ","translit":"ِnِiʾَf","root":""},{"id":2,"arabic":"ٱسْتَكْبَرُوا۟","translit":"۟āwُrَbْkَtْsٱ","root":"كبر"},{"id":3,"arabic":"فَٱلَّذِينَ","translit":"َnyِhdَّlٱَf","root":""},{"id":4,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":5,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":6,"arabic":"يُسَبِّحُونَ","translit":"َnwُḥِّbَsُy","root":"سبح"},{"id":7,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":8,"arabic":"بِٱلَّيْلِ","translit":"ِlْyَّlٱِb","root":"ليل"},{"id":9,"arabic":"وَٱلنَّهَارِ","translit":"ِrāَhَّnlٱَw","root":"نهر"},{"id":10,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":11,"arabic":"لَا","translit":"āَl","root":""},{"id":12,"arabic":"يَسْـَٔمُونَ","translit":"َnwُmَٔـْsَy","root":"سام"}],"hasIhya":false},{"ayah":39,"text":"وَمِنْ ءَايَٰتِهِۦٓ أَنَّكَ تَرَى ٱلْأَرْضَ خَٰشِعَةً فَإِذَآ أَنزَلْنَا عَلَيْهَا ٱلْمَآءَ ٱهْتَزَّتْ وَرَبَتْۚ إِنَّ ٱلَّذِىٓ أَحْيَاهَا لَمُحْىِ ٱلْمَوْتَىٰٓۚ إِنَّهُۥ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ","translation":"And of His signs is that you see the earth stilled, but when We send down upon it rain, it quivers and grows. Indeed, He who has given it life is the Giver of Life to the dead. Indeed, He is over all things competent.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦٓ","translit":"ٓۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"أَنَّكَ","translit":"َkَّnَaʾ","root":""},{"id":4,"arabic":"تَرَى","translit":"àَrَt","root":"راي"},{"id":5,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"خَٰشِعَةً","translit":"ًẗَʿعِhsَٰhk","root":"خشع"},{"id":7,"arabic":"فَإِذَآ","translit":"ٓāَhdِiʾَf","root":""},{"id":8,"arabic":"أَنزَلْنَا","translit":"āَnْlَznَaʾ","root":"نزل"},{"id":9,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":10,"arabic":"ٱلْمَآءَ","translit":"َءٓāَmْlٱ","root":"موه"},{"id":11,"arabic":"ٱهْتَزَّتْ","translit":"ْtَّzَtْhٱ","root":"هزز"},{"id":12,"arabic":"وَرَبَتْ","translit":"ْtَbَrَw","root":"ربو"},{"id":13,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":14,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":15,"arabic":"أَحْيَاهَا","translit":"āَhāَyْḥَaʾ","root":"حيي"},{"id":16,"arabic":"لَمُحْىِ","translit":"ِàْḥُmَl","root":"حيي"},{"id":17,"arabic":"ٱلْمَوْتَىٰٓ","translit":"ٰٓàَtْwَmْlٱ","root":"موت"},{"id":18,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":19,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":20,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":21,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":22,"arabic":"قَدِيرٌ","translit":"ٌryِdَq","root":"قدر"}],"hasIhya":true},{"ayah":40,"text":"إِنَّ ٱلَّذِينَ يُلْحِدُونَ فِىٓ ءَايَٰتِنَا لَا يَخْفَوْنَ عَلَيْنَآۗ أَفَمَن يُلْقَىٰ فِى ٱلنَّارِ خَيْرٌ أَم مَّن يَأْتِىٓ ءَامِنًا يَوْمَ ٱلْقِيَٰمَةِۚ ٱعْمَلُوا۟ مَا شِئْتُمْۖ إِنَّهُۥ بِمَا تَعْمَلُونَ بَصِيرٌ ","translation":"Indeed, those who inject deviation into Our verses[1] are not concealed from Us. So, is he who is cast into the Fire better or he who comes secure on the Day of Resurrection? Do whatever you will; indeed, He is Seeing of what you do.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يُلْحِدُونَ","translit":"َnwُdِḥْlُy","root":"لحد"},{"id":4,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":5,"arabic":"ءَايَٰتِنَا","translit":"āَnِtَٰyāَء","root":"ايي"},{"id":6,"arabic":"لَا","translit":"āَl","root":""},{"id":7,"arabic":"يَخْفَوْنَ","translit":"َnْwَfْhkَy","root":"خفي"},{"id":8,"arabic":"عَلَيْنَآ","translit":"ٓāَnْyَlَʿع","root":""},{"id":9,"arabic":"أَفَمَن","translit":"nَmَfَaʾ","root":""},{"id":10,"arabic":"يُلْقَىٰ","translit":"ٰàَqْlُy","root":"لقي"},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":13,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":14,"arabic":"أَم","translit":"mَaʾ","root":""},{"id":15,"arabic":"مَّن","translit":"nَّm","root":""},{"id":16,"arabic":"يَأْتِىٓ","translit":"ٓàِtْaʾَy","root":"اتي"},{"id":17,"arabic":"ءَامِنًا","translit":"āًnِmāَء","root":"امن"},{"id":18,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":19,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":20,"arabic":"ٱعْمَلُوا۟","translit":"۟āwُlَmْʿعٱ","root":"عمل"},{"id":21,"arabic":"مَا","translit":"āَm","root":""},{"id":22,"arabic":"شِئْتُمْ","translit":"ْmُtْyʾِhs","root":"شيا"},{"id":23,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":24,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":25,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":26,"arabic":"بَصِيرٌ","translit":"ٌryِṣَb","root":"بصر"}],"hasIhya":false},{"ayah":41,"text":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ بِٱلذِّكْرِ لَمَّا جَآءَهُمْۖ وَإِنَّهُۥ لَكِتَٰبٌ عَزِيزٌ ","translation":"Indeed, those who disbelieve in the message [i.e., the Qur’ān][1] after it has come to them...[2] And indeed, it is a mighty[3] Book.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"بِٱلذِّكْرِ","translit":"ِrْkِّhdlٱِb","root":"ذكر"},{"id":5,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":6,"arabic":"جَآءَهُمْ","translit":"ْmُhَءٓāَjg","root":"جيا"},{"id":7,"arabic":"وَإِنَّهُۥ","translit":"ۥُhَّnِiʾَw","root":""},{"id":8,"arabic":"لَكِتَٰبٌ","translit":"ٌbَٰtِkَl","root":"كتب"},{"id":9,"arabic":"عَزِيزٌ","translit":"ٌzyِzَʿع","root":"عزز"}],"hasIhya":false},{"ayah":42,"text":"لَّا يَأْتِيهِ ٱلْبَٰطِلُ مِنۢ بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِۦۖ تَنزِيلٌ مِّنْ حَكِيمٍ حَمِيدٍ ","translation":"Falsehood cannot approach it from before it or from behind it; [it is] a revelation from a [Lord who is] Wise and Praiseworthy.","words":[{"id":1,"arabic":"لَّا","translit":"āَّl","root":""},{"id":2,"arabic":"يَأْتِيهِ","translit":"ِhyِtْaʾَy","root":"اتي"},{"id":3,"arabic":"ٱلْبَٰطِلُ","translit":"ُlِṭَٰbْlٱ","root":"بطل"},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَيْنِ","translit":"ِnْyَb","root":"بين"},{"id":6,"arabic":"يَدَيْهِ","translit":"ِhْyَdَy","root":"يدي"},{"id":7,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"خَلْفِهِۦ","translit":"ۦِhِfْlَhk","root":"خلف"},{"id":10,"arabic":"تَنزِيلٌ","translit":"ٌlyِznَt","root":"نزل"},{"id":11,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":12,"arabic":"حَكِيمٍ","translit":"ٍmyِkَḥ","root":"حكم"},{"id":13,"arabic":"حَمِيدٍ","translit":"ٍdyِmَḥ","root":"حمد"}],"hasIhya":true},{"ayah":43,"text":"مَّا يُقَالُ لَكَ إِلَّا مَا قَدْ قِيلَ لِلرُّسُلِ مِن قَبْلِكَۚ إِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ وَذُو عِقَابٍ أَلِيمٍ ","translation":"Nothing is said to you, [O Muḥammad], except what was already said to the messengers before you. Indeed, your Lord is a possessor of forgiveness and a possessor of painful penalty.","words":[{"id":1,"arabic":"مَّا","translit":"āَّm","root":""},{"id":2,"arabic":"يُقَالُ","translit":"ُlāَqُy","root":"قول"},{"id":3,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":7,"arabic":"قِيلَ","translit":"َlyِq","root":"قول"},{"id":8,"arabic":"لِلرُّسُلِ","translit":"ِlُsُّrlِl","root":"رسل"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":11,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":12,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":13,"arabic":"لَذُو","translit":"wُhdَl","root":""},{"id":14,"arabic":"مَغْفِرَةٍ","translit":"ٍẗَrِfْغَm","root":"غفر"},{"id":15,"arabic":"وَذُو","translit":"wُhdَw","root":""},{"id":16,"arabic":"عِقَابٍ","translit":"ٍbāَqِʿع","root":"عقب"},{"id":17,"arabic":"أَلِيمٍ","translit":"ٍmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":44,"text":"وَلَوْ جَعَلْنَٰهُ قُرْءَانًا أَعْجَمِيًّا لَّقَالُوا۟ لَوْلَا فُصِّلَتْ ءَايَٰتُهُۥٓۖ ءَا۬عْجَمِىٌّ وَعَرَبِىٌّۗ قُلْ هُوَ لِلَّذِينَ ءَامَنُوا۟ هُدًى وَشِفَآءٌۖ وَٱلَّذِينَ لَا يُؤْمِنُونَ فِىٓ ءَاذَانِهِمْ وَقْرٌ وَهُوَ عَلَيْهِمْ عَمًىۚ أُو۟لَٰٓئِكَ يُنَادَوْنَ مِن مَّكَانٍۭ بَعِيدٍ ","translation":"And if We had made it a foreign [i.e., non-Arabic] Qur’ān, they would have said, \"Why are its verses not explained in detail [in our language]? Is it a foreign [recitation] and an Arab [messenger]?\" Say, \"It is, for those who believe, a guidance and cure.\" And those who do not believe - in their ears is deafness, and it is upon them blindness. Those are being called from a distant place.[1]","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"جَعَلْنَٰهُ","translit":"ُhَٰnْlَʿعَjg","root":"جعل"},{"id":3,"arabic":"قُرْءَانًا","translit":"āًnāَءْrُq","root":"قرا"},{"id":4,"arabic":"أَعْجَمِيًّا","translit":"āًّyِmَjgْʿعَaʾ","root":"عجم"},{"id":5,"arabic":"لَّقَالُوا۟","translit":"۟āwُlāَqَّl","root":"قول"},{"id":6,"arabic":"لَوْلَا","translit":"āَlْwَl","root":""},{"id":7,"arabic":"فُصِّلَتْ","translit":"ْtَlِّṣُf","root":"فصل"},{"id":8,"arabic":"ءَايَٰتُهُۥٓ","translit":"ٓۥُhُtَٰyāَء","root":"ايي"},{"id":9,"arabic":"ءَا۬عْجَمِىٌّ","translit":"ٌّàِmَjgْʿع۬āَء","root":"عجم"},{"id":10,"arabic":"وَعَرَبِىٌّ","translit":"ٌّàِbَrَʿعَw","root":"عرب"},{"id":11,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":12,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":13,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":14,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":15,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"},{"id":16,"arabic":"وَشِفَآءٌ","translit":"ٌءٓāَfِhsَw","root":"شفي"},{"id":17,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":18,"arabic":"لَا","translit":"āَl","root":""},{"id":19,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":20,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":21,"arabic":"ءَاذَانِهِمْ","translit":"ْmِhِnāَhdāَء","root":"اذن"},{"id":22,"arabic":"وَقْرٌ","translit":"ٌrْqَw","root":"وقر"},{"id":23,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":24,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":25,"arabic":"عَمًى","translit":"àًmَʿع","root":"عمي"},{"id":26,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":27,"arabic":"يُنَادَوْنَ","translit":"َnْwَdāَnُy","root":"ندي"},{"id":28,"arabic":"مِن","translit":"nِm","root":""},{"id":29,"arabic":"مَّكَانٍۭ","translit":"ٍۭnāَkَّm","root":"كون"},{"id":30,"arabic":"بَعِيدٍ","translit":"ٍdyِʿعَb","root":"بعد"}],"hasIhya":false},{"ayah":45,"text":"وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ فَٱخْتُلِفَ فِيهِۗ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِن رَّبِّكَ لَقُضِىَ بَيْنَهُمْۚ وَإِنَّهُمْ لَفِى شَكٍّ مِّنْهُ مُرِيبٍ ","translation":"And We had already given Moses the Scripture, but it came under disagreement.[1] And if not for a word [i.e., decree][2] that preceded from your Lord, it would have been concluded between them. And indeed they are, concerning it [i.e., the Qur’ān], in disquieting doubt.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"ءَاتَيْنَا","translit":"āَnْyَtāَء","root":"اتي"},{"id":3,"arabic":"مُوسَى","translit":"àَswُm","root":""},{"id":4,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"فَٱخْتُلِفَ","translit":"َfِlُtْhkٱَf","root":"خلف"},{"id":6,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":7,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":8,"arabic":"كَلِمَةٌ","translit":"ٌẗَmِlَk","root":"كلم"},{"id":9,"arabic":"سَبَقَتْ","translit":"ْtَqَbَs","root":"سبق"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":12,"arabic":"لَقُضِىَ","translit":"َàِḍُqَl","root":"قضي"},{"id":13,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":14,"arabic":"وَإِنَّهُمْ","translit":"ْmُhَّnِiʾَw","root":""},{"id":15,"arabic":"لَفِى","translit":"àِfَl","root":""},{"id":16,"arabic":"شَكٍّ","translit":"ٍّkَhs","root":"شكك"},{"id":17,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":18,"arabic":"مُرِيبٍ","translit":"ٍbyِrُm","root":"ريب"}],"hasIhya":false},{"ayah":46,"text":"مَّنْ عَمِلَ صَٰلِحًا فَلِنَفْسِهِۦۖ وَمَنْ أَسَآءَ فَعَلَيْهَاۗ وَمَا رَبُّكَ بِظَلَّٰمٍ لِّلْعَبِيدِ ","translation":"Whoever does righteousness - it is for his [own] soul; and whoever does evil [does so] against it. And your Lord is not ever unjust to [His] servants.","words":[{"id":1,"arabic":"مَّنْ","translit":"ْnَّm","root":""},{"id":2,"arabic":"عَمِلَ","translit":"َlِmَʿع","root":"عمل"},{"id":3,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":4,"arabic":"فَلِنَفْسِهِۦ","translit":"ۦِhِsْfَnِlَf","root":"نفس"},{"id":5,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":6,"arabic":"أَسَآءَ","translit":"َءٓāَsَaʾ","root":"سوا"},{"id":7,"arabic":"فَعَلَيْهَا","translit":"āَhْyَlَʿعَf","root":""},{"id":8,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":9,"arabic":"رَبُّكَ","translit":"َkُّbَr","root":"ربب"},{"id":10,"arabic":"بِظَلَّٰمٍ","translit":"ٍmَّٰlَẓِb","root":"ظلم"},{"id":11,"arabic":"لِّلْعَبِيدِ","translit":"ِdyِbَʿعْlِّl","root":"عبد"}],"hasIhya":true},{"ayah":47,"text":"إِلَيْهِ يُرَدُّ عِلْمُ ٱلسَّاعَةِۚ وَمَا تَخْرُجُ مِن ثَمَرَٰتٍ مِّنْ أَكْمَامِهَا وَمَا تَحْمِلُ مِنْ أُنثَىٰ وَلَا تَضَعُ إِلَّا بِعِلْمِهِۦۚ وَيَوْمَ يُنَادِيهِمْ أَيْنَ شُرَكَآءِى قَالُوٓا۟ ءَاذَنَّٰكَ مَا مِنَّا مِن شَهِيدٍ ","translation":"To Him [alone] is attributed knowledge of the Hour. And fruits emerge not from their coverings nor does a female conceive or give birth except with His knowledge. And the Day He will call to them, \"Where are My 'partners'?\" they will say, \"We announce to You that there is [no longer] among us any witness [to that].\"","words":[{"id":1,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":2,"arabic":"يُرَدُّ","translit":"ُّdَrُy","root":"ردد"},{"id":3,"arabic":"عِلْمُ","translit":"ُmْlِʿع","root":"علم"},{"id":4,"arabic":"ٱلسَّاعَةِ","translit":"ِẗَʿعāَّslٱ","root":"سوع"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"تَخْرُجُ","translit":"ُjgُrْhkَt","root":"خرج"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"ثَمَرَٰتٍ","translit":"ٍtَٰrَmَht","root":"ثمر"},{"id":9,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":10,"arabic":"أَكْمَامِهَا","translit":"āَhِmāَmْkَaʾ","root":"كمم"},{"id":11,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":12,"arabic":"تَحْمِلُ","translit":"ُlِmْḥَt","root":"حمل"},{"id":13,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":14,"arabic":"أُنثَىٰ","translit":"ٰàَhtnُaʾ","root":"انث"},{"id":15,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":16,"arabic":"تَضَعُ","translit":"ُʿعَḍَt","root":"وضع"},{"id":17,"arabic":"إِلَّا","translit":"āَّ