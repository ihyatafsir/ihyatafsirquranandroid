اِ۬لرَّحِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 3, "text": "كِتَٰبࣱ فُصِّلَتَ اٰيَٰتُهُۥ قُرْءَاناً عَرَبِيّاࣰ لِّقَوْمࣲ يَعْلَمُونَ", "words": [{"id": 1, "arabic": "كِتَٰبࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "فُصِّلَتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَٰتُهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "قُرْءَاناً", "translit": "", "root": ""}, {"id": 5, "arabic": "عَرَبِيّاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِّقَوْمࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَعْلَمُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 4, "text": "بَشِيراࣰ وَنَذِيراࣰۖ فَأَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَعُونَۖ", "words": [{"id": 1, "arabic": "بَشِيراࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَنَذِيراࣰۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَأَعْرَضَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَكْثَرُهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَسْمَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 5, "text": "وَقَالُواْ قُلُوبُنَا فِےٓ أَكِنَّةࣲ مِّمَّا تَدْعُونَآ إِلَيْهِ وَفِےٓ ءَاذَانِنَا وَقْرࣱ وَمِنۢ بَيْنِنَا وَبَيْنِكَ حِجَابࣱ فَاعْمَلِ اِنَّنَا عَٰمِلُونَۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قُلُوبُنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَكِنَّةࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّمَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَدْعُونَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَفِےٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "ءَاذَانِنَا", "translit": "", "root": ""}, {"id": 10, "ar