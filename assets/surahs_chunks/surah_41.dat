41, "ayah": 5, "text": "وَقَالُواْ قُلُوبُنَا فِےٓ أَكِنَّةࣲ مِّمَّا تَدْعُونَآ إِلَيْهِ وَفِےٓ ءَاذَانِنَا وَقْرࣱ وَمِنۢ بَيْنِنَا وَبَيْنِكَ حِجَابࣱ فَاعْمَلِ اِنَّنَا عَٰمِلُونَۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قُلُوبُنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَكِنَّةࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّمَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَدْعُونَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَفِےٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "ءَاذَانِنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "وَقْرࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَمِنۢ", "translit": "", "root": ""}, {"id": 12, "arabic": "بَيْنِنَا", "translit": "", "root": ""}, {"id": 13, "arabic": "وَبَيْنِكَ", "translit": "", "root": ""}, {"id": 14, "arabic": "حِجَابࣱ", "translit": "", "root": ""}, {"id": 15, "arabic": "فَاعْمَلِ", "translit": "", "root": ""}, {"id": 16, "arabic": "اِنَّنَا", "translit": "", "root": ""}, {"id": 17, "arabic": "عَٰمِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 6, "text": "قُلِ اِنَّمَآ أَنَا بَشَرࣱ مِّثْلُكُمْ يُوح۪يٰٓ إِلَيَّ أَنَّمَآ إِلَٰهُكُمُۥٓ إِلَٰهࣱ وَٰحِدࣱ فَاسْتَقِيمُوٓاْ إِلَيْهِ وَاسْتَغْفِرُوهُۖ وَوَيْلࣱ لِّلْمُشْرِكِينَ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنَّمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بَشَرࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّثْلُكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنَّمَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "