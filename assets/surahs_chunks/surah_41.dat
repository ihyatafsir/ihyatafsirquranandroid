{"surah": 41, "verses": [{"ayah": 1, "text": "حمٓ ", "translation": "Ḥā, Meem.[1]", "words": [{"id": 1, "arabic": "حمٓ", "translit": "ٓmḥ", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "تَنزِيلٌ مِّنَ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ", "translation": "[This is] a revelation from the Entirely Merciful, the Especially Merciful -", "words": [{"id": 1, "arabic": "تَنزِيلٌ", "translit": "ٌlyِznَt", "root": "نزل"}, {"id": 2, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 3, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 4, "arabic": "ٱلرَّحِيمِ", "translit": "ِmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 3, "text": "كِتَٰبٌ فُصِّلَتْ ءَايَٰتُهُۥ قُرْءَانًا عَرَبِيًّا لِّقَوْمٍ يَعْلَمُونَ ", "translation": "A Book whose verses have been detailed, an Arabic Qur’ān[1] for a people who know,", "words": [{"id": 1, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 2, "arabic": "فُصِّلَتْ", "translit": "ْtَlِّṣُf", "root": "فصل"}, {"id": 3, "arabic": "ءَايَٰتُهُۥ", "translit": "ۥُhُtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "قُرْءَانًا", "translit": "āًnāَءْrُq", "root": "قرا"}, {"id": 5, "arabic": "عَرَبِيًّا", "translit": "āًّyِbَrَʿع", "root": "عرب"}, {"id": 6, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 7, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 4, "text": "بَشِيرًا وَنَذِيرًا فَأَعْرَضَ أَكْثَرُهُمْ فَهُمْ لَا يَسْمَعُونَ ", "translation": "As a giver of good tidings and a warner; but most of them turn away, so they do not hear.", "words": [{"id": 1, "arabic": "بَشِيرًا", "translit": "āًryِhsَb", "root": "بشر"}, {"id": 2, "arabic": "وَنَذِيرًا", "translit": "āًryِhdَnَw", "root": "نذر"}, {"id": 3, "arabic": "فَأَعْرَضَ", "translit": "َḍَrْʿعَaʾَf", "root": "عرض"}, {"id": 4, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 5, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}], "hasIhya": false}, {"ayah": 5, "text": "وَقَالُوا۟ قُلُوبُنَا فِىٓ أَكِنَّةٍ مِّمَّا تَدْعُونَآ إِلَيْهِ وَفِىٓ ءَاذَانِنَا وَقْرٌ وَمِنۢ بَيْنِنَا وَبَيْنِكَ حِجَابٌ فَٱعْمَلْ إِنَّنَا عَٰمِلُونَ ", "translation": "And they say, \"Our hearts are within coverings [i.e., screened] from that to which you invite us, and in our ears is deafness, and between us and you is a partition, so work;[1] indeed, we are working.\"", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "قُلُوبُنَا", "translit": "āَnُbwُlُq", "root": "قلب"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "أَكِنَّةٍ", "translit": "ٍẗَّnِkَaʾ", "root": "كنن"}, {"id": 5, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 6, "arabic": "تَدْعُونَآ", "translit": "ٓāَnwُʿعْdَt", "root": "دعو"}, {"id": 7, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "وَفِىٓ", "translit": "ٓàِfَw", "root": ""}, {"id": 9, "arabic": "ءَاذَانِنَا", "translit": "āَnِnāَhdāَء", "root": "اذن"}, {"id": 10, "arabic": "وَقْرٌ", "translit": "ٌrْqَw", "root": "وقر"}, {"id": 11, "arabic": "وَمِنۢ", "translit": "ۢnِmَw", "root": ""}, {"id": 12, "arabic": "بَيْنِنَا", "translit": "āَnِnْyَb", "root": "بين"}, {"id": 13, "arabic": "وَبَيْنِكَ", "translit": "َkِnْyَbَw", "root": "بين"}, {"id": 14, "arabic": "حِجَابٌ", "translit": "ٌbāَjgِḥ", "root": "حجب"}, {"id": 15, "arabic": "فَٱعْمَلْ", "translit": "ْlَmْʿعٱَf", "root": "عمل"}, {"id": 16, "arabic": "إِنَّنَا", "translit": "āَnَّnِiʾ", "root": ""}, {"id": 17, "arabic": "عَٰمِلُونَ", "translit": "َnwُlِmَٰʿع", "root": "عمل"}], "hasIhya": false}, {"ayah": 6, "text": "قُلْ إِنَّمَآ أَنَا۠ بَشَرٌ مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ أَنَّمَآ إِلَٰهُكُمْ إِلَٰهٌ وَٰحِدٌ فَٱسْتَقِيمُوٓا۟ إِلَيْهِ وَٱسْتَغْفِرُوهُۗ وَوَيْلٌ لِّلْمُشْرِكِينَ ", "translation": "Say, [O Muḥammad], \"I am only a man like you to whom it has been revealed that your god is but one God; so take a straight course to Him and seek His forgiveness.\" And woe to those who associate others with Allāh –", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 4, "arabic": "بَشَرٌ", "translit": "ٌrَhsَb", "root": "بشر"}, {"id": 5, "arabic": "مِّثْلُكُمْ", "translit": "ْmُkُlْhtِّm", "root": "مثل"}, {"id": 6, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 7, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 8, "arabic": "أَنَّمَآ", "translit": "ٓāَmَّnَaʾ", "root": ""}, {"id": 9, "arabic": "إِلَٰهُكُمْ", "translit": "ْmُkُhَٰlِiʾ", "root": "اله"}, {"id": 10, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 11, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 12, "arabic": "فَٱسْتَقِيمُوٓا۟", "translit": "۟āٓwُmyِqَtْsٱَf", "root": "قوم"}, {"id": 13, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 14, "arabic": "وَٱسْتَغْفِرُوهُ", "translit": "ُhwُrِfْغَtْsٱَw", "root": "غفر"}, {"id": 15, "arabic": "وَوَيْلٌ", "translit": "ٌlْyَwَw", "root": ""}, {"id": 16, "arabic": "لِّلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlِّl", "root": "شرك"}], "hasIhya": false}, {"ayah": 7, "text": "ٱلَّذِينَ لَا يُؤْتُونَ ٱلزَّكَوٰةَ وَهُم بِٱلْءَاخِرَةِ هُمْ كَٰفِرُونَ ", "translation": "Those who do not give zakāh, and in the Hereafter they are disbelievers.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يُؤْتُونَ", "translit": "َnwُtْwʾُy", "root": "اتي"}, {"id": 4, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 5, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 6, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 7, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 8, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 8, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ لَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ ", "translation": "Indeed, those who believe and do righteous deeds - for them is a reward uninterrupted.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 8, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 9, "arabic": "مَمْنُونٍ", "translit": "ٍnwُnْmَm", "root": "منن"}], "hasIhya": false}, {"ayah": 9, "text": "قُلْ أَئِنَّكُمْ لَتَكْفُرُونَ بِٱلَّذِى خَلَقَ ٱلْأَرْضَ فِى يَوْمَيْنِ وَتَجْعَلُونَ لَهُۥٓ أَندَادًاۚ ذَٰلِكَ رَبُّ ٱلْعَٰلَمِينَ ", "translation": "Say, \"Do you indeed disbelieve in He who created the earth in two days and attribute to Him equals? That is the Lord of the worlds.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَئِنَّكُمْ", "translit": "ْmُkَّnِyʾَaʾ", "root": ""}, {"id": 3, "arabic": "لَتَكْفُرُونَ", "translit": "َnwُrُfْkَtَl", "root": "كفر"}, {"id": 4, "arabic": "بِٱلَّذِى", "translit": "àِhdَّlٱِb", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "يَوْمَيْنِ", "translit": "ِnْyَmْwَy", "root": "يوم"}, {"id": 9, "arabic": "وَتَجْعَلُونَ", "translit": "َnwُlَʿعْjgَtَw", "root": "جعل"}, {"id": 10, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 11, "arabic": "أَندَادًا", "translit": "āًdāَdnَaʾ", "root": "ندد"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 14, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 10, "text": "وَجَعَلَ فِيهَا رَوَٰسِىَ مِن فَوْقِهَا وَبَٰرَكَ فِيهَا وَقَدَّرَ فِيهَآ أَقْوَٰتَهَا فِىٓ أَرْبَعَةِ أَيَّامٍ سَوَآءً لِّلسَّآئِلِينَ ", "translation": "And He placed on it [i.e., the earth] firmly set mountains over its surface, and He blessed it and determined therein its [creatures'] sustenance in four days without distinction[1] - for [the information of] those who ask.", "words": [{"id": 1, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "رَوَٰسِىَ", "translit": "َàِsَٰwَr", "root": "رسو"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "فَوْقِهَا", "translit": "āَhِqْwَf", "root": "فوق"}, {"id": 6, "arabic": "وَبَٰرَكَ", "translit": "َkَrَٰbَw", "root": "برك"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "وَقَدَّرَ", "translit": "َrَّdَqَw", "root": "قدر"}, {"id": 9, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 10, "arabic": "أَقْوَٰتَهَا", "translit": "āَhَtَٰwْqَaʾ", "root": "قوت"}, {"id": 11, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 12, "arabic": "أَرْبَعَةِ", "translit": "ِẗَʿعَbْrَaʾ", "root": "ربع"}, {"id": 13, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 14, "arabic": "سَوَآءً", "translit": "ًءٓāَwَs", "root": "سوي"}, {"id": 15, "arabic": "لِّلسَّآئِلِينَ", "translit": "َnyِlِyʾٓāَّslِّl", "root": "سال"}], "hasIhya": false}, {"ayah": 11, "text": "ثُمَّ ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ وَهِىَ دُخَانٌ فَقَالَ لَهَا وَلِلْأَرْضِ ٱئْتِيَا طَوْعًا أَوْ كَرْهًا قَالَتَآ أَتَيْنَا طَآئِعِينَ ", "translation": "Then He directed Himself[1] to the heaven while it was smoke and said to it and to the earth, \"Come [into being],[2] willingly or by compulsion.\" They said, \"We have come willingly.\"", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "ٱسْتَوَىٰٓ", "translit": "ٰٓàَwَtْsٱ", "root": "سوي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 6, "arabic": "دُخَانٌ", "translit": "ٌnāَhkُd", "root": "دخن"}, {"id": 7, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 8, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 9, "arabic": "وَلِلْأَرْضِ", "translit": "ِḍْrَaʾْlِlَw", "root": "ارض"}, {"id": 10, "arabic": "ٱئْتِيَا", "translit": "āَyِtْyʾٱ", "root": "اتي"}, {"id": 11, "arabic": "طَوْعًا", "translit": "āًʿعْwَṭ", "root": "طوع"}, {"id": 12, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 13, "arabic": "كَرْهًا", "translit": "āًhْrَk", "root": "كره"}, {"id": 14, "arabic": "قَالَتَآ", "translit": "ٓāَtَlāَq", "root": "قول"}, {"id": 15, "arabic": "أَتَيْنَا", "translit": "āَnْyَtَaʾ", "root": "اتي"}, {"id": 16, "arabic": "طَآئِعِينَ", "translit": "َnyِʿعِyʾٓāَṭ", "root": "طوع"}], "hasIhya": true}, {"ayah": 12, "text": "فَقَضَىٰهُنَّ سَبْعَ سَمَٰوَاتٍ فِى يَوْمَيْنِ وَأَوْحَىٰ فِى كُلِّ سَمَآءٍ أَمْرَهَاۚ وَزَيَّنَّا ٱلسَّمَآءَ ٱلدُّنْيَا بِمَصَٰبِيحَ وَحِفْظًاۚ ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ ", "translation": "And He completed them as seven heavens within two days and inspired [i.e., made known] in each heaven its command. And We adorned the nearest heaven with lamps [i.e., stars, for beauty] and as protection.[1] That is the determination of the Exalted in Might, the Knowing.", "words": [{"id": 1, "arabic": "فَقَضَىٰهُنَّ", "translit": "َّnُhٰàَḍَqَf", "root": "قضي"}, {"id": 2, "arabic": "سَبْعَ", "translit": "َʿعْbَs", "root": "سبع"}, {"id": 3, "arabic": "سَمَٰوَاتٍ", "translit": "ٍtāَwَٰmَs", "root": "سمو"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "يَوْمَيْنِ", "translit": "ِnْyَmْwَy", "root": "يوم"}, {"id": 6, "arabic": "وَأَوْحَىٰ", "translit": "ٰàَḥْwَaʾَw", "root": "وحي"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 9, "arabic": "سَمَآءٍ", "translit": "ٍءٓāَmَs", "root": "سمو"}, {"id": 10, "arabic": "أَمْرَهَا", "translit": "āَhَrْmَaʾ", "root": "امر"}, {"id": 11, "arabic": "وَزَيَّنَّا", "translit": "āَّnَّyَzَw", "root": "زين"}, {"id": 12, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 13, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 14, "arabic": "بِمَصَٰبِيحَ", "translit": "َḥyِbَٰṣَmِb", "root": "صبح"}, {"id": 15, "arabic": "وَحِفْظًا", "translit": "āًẓْfِḥَw", "root": "حفظ"}, {"id": 16, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 17, "arabic": "تَقْدِيرُ", "translit": "ُryِdْqَt", "root": "قدر"}, {"id": 18, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 19, "arabic": "ٱلْعَلِيمِ", "translit": "ِmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 13, "text": "فَإِنْ أَعْرَضُوا۟ فَقُلْ أَنذَرْتُكُمْ صَٰعِقَةً مِّثْلَ صَٰعِقَةِ عَادٍ وَثَمُودَ ", "translation": "But if they turn away, then say, \"I have warned you of a thunderbolt like the thunderbolt [that struck] ʿAad and Thamūd.", "words": [{"id": 1, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 2, "arabic": "أَعْرَضُوا۟", "translit": "۟āwُḍَrْʿعَaʾ", "root": "عرض"}, {"id": 3, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 4, "arabic": "أَنذَرْتُكُمْ", "translit": "ْmُkُtْrَhdnَaʾ", "root": "نذر"}, {"id": 5, "arabic": "صَٰعِقَةً", "translit": "ًẗَqِʿعَٰṣ", "root": "صعق"}, {"id": 6, "arabic": "مِّثْلَ", "translit": "َlْhtِّm", "root": "مثل"}, {"id": 7, "arabic": "صَٰعِقَةِ", "translit": "ِẗَqِʿعَٰṣ", "root": "صعق"}, {"id": 8, "arabic": "عَادٍ", "translit": "ٍdāَʿع", "root": "عود"}, {"id": 9, "arabic": "وَثَمُودَ", "translit": "َdwُmَhtَw", "root": ""}], "hasIhya": false}, {"ayah": 14, "text": "إِذْ جَآءَتْهُمُ ٱلرُّسُلُ مِنۢ بَيْنِ أَيْدِيهِمْ وَمِنْ خَلْفِهِمْ أَلَّا تَعْبُدُوٓا۟ إِلَّا ٱللَّهَۖ قَالُوا۟ لَوْ شَآءَ رَبُّنَا لَأَنزَلَ مَلَٰٓئِكَةً فَإِنَّا بِمَآ أُرْسِلْتُم بِهِۦ كَٰفِرُونَ ", "translation": "[That occurred] when the messengers had come to them before them and after them, [saying], \"Worship not except Allāh.\" They said, \"If our Lord had willed,[1] He would have sent down the angels, so indeed we, in that with which you have been sent, are disbelievers.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "جَآءَتْهُمُ", "translit": "ُmُhْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ٱلرُّسُلُ", "translit": "ُlُsُّrlٱ", "root": "رسل"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَيْنِ", "translit": "ِnْyَb", "root": "بين"}, {"id": 6, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 7, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 8, "arabic": "خَلْفِهِمْ", "translit": "ْmِhِfْlَhk", "root": "خلف"}, {"id": 9, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 10, "arabic": "تَعْبُدُوٓا۟", "translit": "۟āٓwُdُbْʿعَt", "root": "عبد"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 14, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 15, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 16, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 17, "arabic": "لَأَنزَلَ", "translit": "َlَznَaʾَl", "root": "نزل"}, {"id": 18, "arabic": "مَلَٰٓئِكَةً", "translit": "ًẗَkِyʾَٰٓlَm", "root": "ملك"}, {"id": 19, "arabic": "فَإِنَّا", "translit": "āَّnِiʾَf", "root": ""}, {"id": 20, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 21, "arabic": "أُرْسِلْتُم", "translit": "mُtْlِsْrُaʾ", "root": "رسل"}, {"id": 22, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 23, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 15, "text": "فَأَمَّا عَادٌ فَٱسْتَكْبَرُوا۟ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ وَقَالُوا۟ مَنْ أَشَدُّ مِنَّا قُوَّةًۖ أَوَلَمْ يَرَوْا۟ أَنَّ ٱللَّهَ ٱلَّذِى خَلَقَهُمْ هُوَ أَشَدُّ مِنْهُمْ قُوَّةًۖ وَكَانُوا۟ بِـَٔايَٰتِنَا يَجْحَدُونَ ", "translation": "As for ʿAad, they were arrogant upon the earth without right and said, \"Who is greater than us in strength?\" Did they not consider that Allāh who created them was greater than them in strength? But they were rejecting Our signs.", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "عَادٌ", "translit": "ٌdāَʿع", "root": "عود"}, {"id": 3, "arabic": "فَٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱَf", "root": "كبر"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 7, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 8, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 9, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 10, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 11, "arabic": "مِنَّا", "translit": "āَّnِm", "root": ""}, {"id": 12, "arabic": "قُوَّةً", "translit": "ًẗَّwُq", "root": "قوي"}, {"id": 13, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 14, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 15, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 18, "arabic": "خَلَقَهُمْ", "translit": "ْmُhَqَlَhk", "root": "خلق"}, {"id": 19, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 20, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 21, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 22, "arabic": "قُوَّةً", "translit": "ًẗَّwُq", "root": "قوي"}, {"id": 23, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 24, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 25, "arabic": "يَجْحَدُونَ", "translit": "َnwُdَḥْjgَy", "root": "جحد"}], "hasIhya": true}, {"ayah": 16, "text": "فَأَرْسَلْنَا عَلَيْهِمْ رِيحًا صَرْصَرًا فِىٓ أَيَّامٍ نَّحِسَاتٍ لِّنُذِيقَهُمْ عَذَابَ ٱلْخِزْىِ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَلَعَذَابُ ٱلْءَاخِرَةِ أَخْزَىٰۖ وَهُمْ لَا يُنصَرُونَ ", "translation": "So We sent upon them a screaming wind during days of misfortune to make them taste the punishment of disgrace in the worldly life; but the punishment of the Hereafter is more disgracing, and they will not be helped.", "words": [{"id": 1, "arabic": "فَأَرْسَلْنَا", "translit": "āَnْlَsْrَaʾَf", "root": "رسل"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "رِيحًا", "translit": "āًḥyِr", "root": "روح"}, {"id": 4, "arabic": "صَرْصَرًا", "translit": "āًrَṣْrَṣ", "root": "صرصر"}, {"id": 5, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 6, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 7, "arabic": "نَّحِسَاتٍ", "translit": "ٍtāَsِḥَّn", "root": "نحس"}, {"id": 8, "arabic": "لِّنُذِيقَهُمْ", "translit": "ْmُhَqyِhdُnِّl", "root": "ذوق"}, {"id": 9, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 10, "arabic": "ٱلْخِزْىِ", "translit": "ِàْzِhkْlٱ", "root": "خزي"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 13, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 14, "arabic": "وَلَعَذَابُ", "translit": "ُbāَhdَʿعَlَw", "root": "عذب"}, {"id": 15, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 16, "arabic": "أَخْزَىٰ", "translit": "ٰàَzْhkَaʾ", "root": "خزي"}, {"id": 17, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يُنصَرُونَ", "translit": "َnwُrَṣnُy", "root": "نصر"}], "hasIhya": false}, {"ayah": 17, "text": "وَأَمَّا ثَمُودُ فَهَدَيْنَٰهُمْ فَٱسْتَحَبُّوا۟ ٱلْعَمَىٰ عَلَى ٱلْهُدَىٰ فَأَخَذَتْهُمْ صَٰعِقَةُ ٱلْعَذَابِ ٱلْهُونِ بِمَا كَانُوا۟ يَكْسِبُونَ ", "translation": "And as for Thamūd, We guided them, but they preferred blindness over guidance, so the thunderbolt of humiliating punishment seized them for what they used to earn.", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "ثَمُودُ", "translit": "ُdwُmَht", "root": ""}, {"id": 3, "arabic": "فَهَدَيْنَٰهُمْ", "translit": "ْmُhَٰnْyَdَhَf", "root": "هدي"}, {"id": 4, "arabic": "فَٱسْتَحَبُّوا۟", "translit": "۟āwُّbَḥَtْsٱَf", "root": "حبب"}, {"id": 5, "arabic": "ٱلْعَمَىٰ", "translit": "ٰàَmَʿعْlٱ", "root": "عمي"}, {"id": 6, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 8, "arabic": "فَأَخَذَتْهُمْ", "translit": "ْmُhْtَhdَhkَaʾَf", "root": "اخذ"}, {"id": 9, "arabic": "صَٰعِقَةُ", "translit": "ُẗَqِʿعَٰṣ", "root": "صعق"}, {"id": 10, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 11, "arabic": "ٱلْهُونِ", "translit": "ِnwُhْlٱ", "root": "هون"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": true}, {"ayah": 18, "text": "وَنَجَّيْنَا ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟ يَتَّقُونَ ", "translation": "And We saved those who believed and used to fear Allāh.", "words": [{"id": 1, "arabic": "وَنَجَّيْنَا", "translit": "āَnْyَّjgَnَw", "root": "نجو"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 5, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}], "hasIhya": false}, {"ayah": 19, "text": "وَيَوْمَ يُحْشَرُ أَعْدَآءُ ٱللَّهِ إِلَى ٱلنَّارِ فَهُمْ يُوزَعُونَ ", "translation": "And [mention, O Muḥammad], the Day when the enemies of Allāh will be gathered to the Fire while they are [driven], assembled in rows,", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يُحْشَرُ", "translit": "ُrَhsْḥُy", "root": "حشر"}, {"id": 3, "arabic": "أَعْدَآءُ", "translit": "ُءٓāَdْʿعَaʾ", "root": "عدو"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 7, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 8, "arabic": "يُوزَعُونَ", "translit": "َnwُʿعَzwُy", "root": "وزع"}], "hasIhya": false}, {"ayah": 20, "text": "حَتَّىٰٓ إِذَا مَا جَآءُوهَا شَهِدَ عَلَيْهِمْ سَمْعُهُمْ وَأَبْصَٰرُهُمْ وَجُلُودُهُم بِمَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Until, when they reach it, their hearing and their eyes and their skins will testify against them of what they used to do.", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "جَآءُوهَا", "translit": "āَhwُءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "شَهِدَ", "translit": "َdِhَhs", "root": "شهد"}, {"id": 6, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "سَمْعُهُمْ", "translit": "ْmُhُʿعْmَs", "root": "سمع"}, {"id": 8, "arabic": "وَأَبْصَٰرُهُمْ", "translit": "ْmُhُrَٰṣْbَaʾَw", "root": "بصر"}, {"id": 9, "arabic": "وَجُلُودُهُم", "translit": "mُhُdwُlُjgَw", "root": "جلد"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 21, "text": "وَقَالُوا۟ لِجُلُودِهِمْ لِمَ شَهِدتُّمْ عَلَيْنَاۖ قَالُوٓا۟ أَنطَقَنَا ٱللَّهُ ٱلَّذِىٓ أَنطَقَ كُلَّ شَىْءٍ وَهُوَ خَلَقَكُمْ أَوَّلَ مَرَّةٍ وَإِلَيْهِ تُرْجَعُونَ ", "translation": "And they will say to their skins, \"Why have you testified against us?\" They will say, \"We were made to speak by Allāh, who has made everything speak; and He created you the first time, and to Him you are returned.", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لِجُلُودِهِمْ", "translit": "ْmِhِdwُlُjgِl", "root": "جلد"}, {"id": 3, "arabic": "لِمَ", "translit": "َmِl", "root": ""}, {"id": 4, "arabic": "شَهِدتُّمْ", "translit": "ْmُّtdِhَhs", "root": "شهد"}, {"id": 5, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 6, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 7, "arabic": "أَنطَقَنَا", "translit": "āَnَqَṭnَaʾ", "root": "نطق"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "أَنطَقَ", "translit": "َqَṭnَaʾ", "root": "نطق"}, {"id": 11, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 14, "arabic": "خَلَقَكُمْ", "translit": "ْmُkَqَlَhk", "root": "خلق"}, {"id": 15, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 16, "arabic": "مَرَّةٍ", "translit": "ٍẗَّrَm", "root": "مرر"}, {"id": 17, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 18, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": true}, {"ayah": 22, "text": "وَمَا كُنتُمْ تَسْتَتِرُونَ أَن يَشْهَدَ عَلَيْكُمْ سَمْعُكُمْ وَلَآ أَبْصَٰرُكُمْ وَلَا جُلُودُكُمْ وَلَٰكِن ظَنَنتُمْ أَنَّ ٱللَّهَ لَا يَعْلَمُ كَثِيرًا مِّمَّا تَعْمَلُونَ ", "translation": "And you were not covering [i.e., protecting] yourselves,[1] lest your hearing testify against you or your sight or your skins, but you assumed that Allāh does not know much of what you do.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 3, "arabic": "تَسْتَتِرُونَ", "translit": "َnwُrِtَtْsَt", "root": "ستر"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَشْهَدَ", "translit": "َdَhْhsَy", "root": "شهد"}, {"id": 6, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 7, "arabic": "سَمْعُكُمْ", "translit": "ْmُkُʿعْmَs", "root": "سمع"}, {"id": 8, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 9, "arabic": "أَبْصَٰرُكُمْ", "translit": "ْmُkُrَٰṣْbَaʾ", "root": "بصر"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "جُلُودُكُمْ", "translit": "ْmُkُdwُlُjg", "root": "جلد"}, {"id": 12, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 13, "arabic": "ظَنَنتُمْ", "translit": "ْmُtnَnَẓ", "root": "ظنن"}, {"id": 14, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 18, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 19, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 20, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 23, "text": "وَذَٰلِكُمْ ظَنُّكُمُ ٱلَّذِى ظَنَنتُم بِرَبِّكُمْ أَرْدَىٰكُمْ فَأَصْبَحْتُم مِّنَ ٱلْخَٰسِرِينَ ", "translation": "And that was your assumption which you assumed about your Lord. It has brought you to ruin, and you have become among the losers.\"", "words": [{"id": 1, "arabic": "وَذَٰلِكُمْ", "translit": "ْmُkِlَٰhdَw", "root": ""}, {"id": 2, "arabic": "ظَنُّكُمُ", "translit": "ُmُkُّnَẓ", "root": "ظنن"}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ظَنَنتُم", "translit": "mُtnَnَẓ", "root": "ظنن"}, {"id": 5, "arabic": "بِرَبِّكُمْ", "translit": "ْmُkِّbَrِb", "root": "ربب"}, {"id": 6, "arabic": "أَرْدَىٰكُمْ", "translit": "ْmُkٰàَdْrَaʾ", "root": "ردي"}, {"id": 7, "arabic": "فَأَصْبَحْتُم", "translit": "mُtْḥَbْṣَaʾَf", "root": "صبح"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": true}, {"ayah": 24, "text": "فَإِن يَصْبِرُوا۟ فَٱلنَّارُ مَثْوًى لَّهُمْۖ وَإِن يَسْتَعْتِبُوا۟ فَمَا هُم مِّنَ ٱلْمُعْتَبِينَ ", "translation": "So [even] if they are patient, the Fire is a residence for them; and if they ask to appease [Allāh], they will not be of those who are allowed to appease.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "يَصْبِرُوا۟", "translit": "۟āwُrِbْṣَy", "root": "صبر"}, {"id": 3, "arabic": "فَٱلنَّارُ", "translit": "ُrāَّnlٱَf", "root": "نور"}, {"id": 4, "arabic": "مَثْوًى", "translit": "àًwْhtَm", "root": "ثوي"}, {"id": 5, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 6, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 7, "arabic": "يَسْتَعْتِبُوا۟", "translit": "۟āwُbِtْʿعَtْsَy", "root": "عتب"}, {"id": 8, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 9, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱلْمُعْتَبِينَ", "translit": "َnyِbَtْʿعُmْlٱ", "root": "عتب"}], "hasIhya": false}, {"ayah": 25, "text": "وَقَيَّضْنَا لَهُمْ قُرَنَآءَ فَزَيَّنُوا۟ لَهُم مَّا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَحَقَّ عَلَيْهِمُ ٱلْقَوْلُ فِىٓ أُمَمٍ قَدْ خَلَتْ مِن قَبْلِهِم مِّنَ ٱلْجِنِّ وَٱلْإِنسِۖ إِنَّهُمْ كَانُوا۟ خَٰسِرِينَ ", "translation": "And We appointed for them companions[1] who made attractive to them what was before them and what was behind them [of sin], and the word [i.e., decree] has come into effect upon them among nations which had passed on before them of jinn and men. Indeed, they [all] were losers.", "words": [{"id": 1, "arabic": "وَقَيَّضْنَا", "translit": "āَnْḍَّyَqَw", "root": "قيض"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "قُرَنَآءَ", "translit": "َءٓāَnَrُq", "root": "قرن"}, {"id": 4, "arabic": "فَزَيَّنُوا۟", "translit": "۟āwُnَّyَzَf", "root": "زين"}, {"id": 5, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 8, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "خَلْفَهُمْ", "translit": "ْmُhَfْlَhk", "root": "خلف"}, {"id": 11, "arabic": "وَحَقَّ", "translit": "َّqَḥَw", "root": "حقق"}, {"id": 12, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 14, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 15, "arabic": "أُمَمٍ", "translit": "ٍmَmُaʾ", "root": "امم"}, {"id": 16, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 17, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "قَبْلِهِم", "translit": "mِhِlْbَq", "root": "قبل"}, {"id": 20, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 21, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 22, "arabic": "وَٱلْإِنسِ", "translit": "ِsnِiʾْlٱَw", "root": "انس"}, {"id": 23, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 24, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 25, "arabic": "خَٰسِرِينَ", "translit": "َnyِrِsَٰhk", "root": "خسر"}], "hasIhya": false}, {"ayah": 26, "text": "وَقَالَ ٱلَّذِينَ كَفَرُوا۟ لَا تَسْمَعُوا۟ لِهَٰذَا ٱلْقُرْءَانِ وَٱلْغَوْا۟ فِيهِ لَعَلَّكُمْ تَغْلِبُونَ ", "translation": "And those who disbelieve say, \"Do not listen to this Qur’ān and speak noisily[1] during [the recitation of] it that perhaps you will overcome.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَسْمَعُوا۟", "translit": "۟āwُʿعَmْsَt", "root": "سمع"}, {"id": 6, "arabic": "لِهَٰذَا", "translit": "āَhdَٰhِl", "root": ""}, {"id": 7, "arabic": "ٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱ", "root": "قرا"}, {"id": 8, "arabic": "وَٱلْغَوْا۟", "translit": "۟āْwَغْlٱَw", "root": "لغو"}, {"id": 9, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 10, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 11, "arabic": "تَغْلِبُونَ", "translit": "َnwُbِlْغَt", "root": "غلب"}], "hasIhya": true}, {"ayah": 27, "text": "فَلَنُذِيقَنَّ ٱلَّذِينَ كَفَرُوا۟ عَذَابًا شَدِيدًا وَلَنَجْزِيَنَّهُمْ أَسْوَأَ ٱلَّذِى كَانُوا۟ يَعْمَلُونَ ", "translation": "But We will surely cause those who disbelieve to taste a severe punishment, and We will surely recompense them for the worst of what they had been doing.", "words": [{"id": 1, "arabic": "فَلَنُذِيقَنَّ", "translit": "َّnَqyِhdُnَlَf", "root": "ذوق"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "شَدِيدًا", "translit": "āًdyِdَhs", "root": "شدد"}, {"id": 6, "arabic": "وَلَنَجْزِيَنَّهُمْ", "translit": "ْmُhَّnَyِzْjgَnَlَw", "root": "جزي"}, {"id": 7, "arabic": "أَسْوَأَ", "translit": "َaʾَwْsَaʾ", "root": "سوا"}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 28, "text": "ذَٰلِكَ جَزَآءُ أَعْدَآءِ ٱللَّهِ ٱلنَّارُۖ لَهُمْ فِيهَا دَارُ ٱلْخُلْدِۖ جَزَآءًۢ بِمَا كَانُوا۟ بِـَٔايَٰتِنَا يَجْحَدُونَ ", "translation": "That is the recompense of the enemies of Allāh - the Fire. For them therein is the home of eternity as recompense for what they, of Our verses, were rejecting.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "جَزَآءُ", "translit": "ُءٓāَzَjg", "root": "جزي"}, {"id": 3, "arabic": "أَعْدَآءِ", "translit": "ِءٓāَdْʿعَaʾ", "root": "عدو"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "دَارُ", "translit": "ُrāَd", "root": "دور"}, {"id": 9, "arabic": "ٱلْخُلْدِ", "translit": "ِdْlُhkْlٱ", "root": "خلد"}, {"id": 10, "arabic": "جَزَآءًۢ", "translit": "ًۢءٓāَzَjg", "root": "جزي"}, {"id": 11, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 14, "arabic": "يَجْحَدُونَ", "translit": "َnwُdَḥْjgَy", "root": "جحد"}], "hasIhya": false}, {"ayah": 29, "text": "وَقَالَ ٱلَّذِينَ كَفَرُوا۟ رَبَّنَآ أَرِنَا ٱلَّذَيْنِ أَضَلَّانَا مِنَ ٱلْجِنِّ وَٱلْإِنسِ نَجْعَلْهُمَا تَحْتَ أَقْدَامِنَا لِيَكُونَا مِنَ ٱلْأَسْفَلِينَ ", "translation": "And those who disbelieved will [then] say, \"Our Lord, show us those who misled us of the jinn and men [so] we may put them under our feet[1] that they will be among the lowest.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 5, "arabic": "أَرِنَا", "translit": "āَnِrَaʾ", "root": "راي"}, {"id": 6, "arabic": "ٱلَّذَيْنِ", "translit": "ِnْyَhdَّlٱ", "root": ""}, {"id": 7, "arabic": "أَضَلَّانَا", "translit": "āَnāَّlَḍَaʾ", "root": "ضلل"}, {"id": 8, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 9, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 10, "arabic": "وَٱلْإِنسِ", "translit": "ِsnِiʾْlٱَw", "root": "انس"}, {"id": 11, "arabic": "نَجْعَلْهُمَا", "translit": "āَmُhْlَʿعْjgَn", "root": "جعل"}, {"id": 12, "arabic": "تَحْتَ", "translit": "َtْḥَt", "root": "تحت"}, {"id": 13, "arabic": "أَقْدَامِنَا", "translit": "āَnِmāَdْqَaʾ", "root": "قدم"}, {"id": 14, "arabic": "لِيَكُونَا", "translit": "āَnwُkَyِl", "root": "كون"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْأَسْفَلِينَ", "translit": "َnyِlَfْsَaʾْlٱ", "root": "سفل"}], "hasIhya": false}, {"ayah": 30, "text": "إِنَّ ٱلَّذِينَ قَالُوا۟ رَبُّنَا ٱللَّهُ ثُمَّ ٱسْتَقَٰمُوا۟ تَتَنَزَّلُ عَلَيْهِمُ ٱلْمَلَٰٓئِكَةُ أَلَّا تَخَافُوا۟ وَلَا تَحْزَنُوا۟ وَأَبْشِرُوا۟ بِٱلْجَنَّةِ ٱلَّتِى كُنتُمْ تُوعَدُونَ ", "translation": "Indeed, those who have said, \"Our Lord is Allāh\" and then remained on a right course - the angels will descend upon them, [saying], \"Do not fear and do not grieve but receive good tidings of Paradise, which you were promised.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 4, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "ٱسْتَقَٰمُوا۟", "translit": "۟āwُmَٰqَtْsٱ", "root": "قوم"}, {"id": 8, "arabic": "تَتَنَزَّلُ", "translit": "ُlَّzَnَtَt", "root": "نزل"}, {"id": 9, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 11, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 12, "arabic": "تَخَافُوا۟", "translit": "۟āwُfāَhkَt", "root": "خوف"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "تَحْزَنُوا۟", "translit": "۟āwُnَzْḥَt", "root": "حزن"}, {"id": 15, "arabic": "وَأَبْشِرُوا۟", "translit": "۟āwُrِhsْbَaʾَw", "root": "بشر"}, {"id": 16, "arabic": "بِٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱِb", "root": "جنن"}, {"id": 17, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 18, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 19, "arabic": "تُوعَدُونَ", "translit": "َnwُdَʿعwُt", "root": "وعد"}], "hasIhya": true}, {"ayah": 31, "text": "نَحْنُ أَوْلِيَآؤُكُمْ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَفِى ٱلْءَاخِرَةِۖ وَلَكُمْ فِيهَا مَا تَشْتَهِىٓ أَنفُسُكُمْ وَلَكُمْ فِيهَا مَا تَدَّعُونَ ", "translation": "We [angels] were your allies in worldly life and [are so] in the Hereafter. And you will have therein whatever your souls desire, and you will have therein whatever you request [or wish]", "words": [{"id": 1, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 2, "arabic": "أَوْلِيَآؤُكُمْ", "translit": "ْmُkُwʾٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 7, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "تَشْتَهِىٓ", "translit": "ٓàِhَtْhsَt", "root": "شهو"}, {"id": 12, "arabic": "أَنفُسُكُمْ", "translit": "ْmُkُsُfnَaʾ", "root": "نفس"}, {"id": 13, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 14, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "تَدَّعُونَ", "translit": "َnwُʿعَّdَt", "root": "دعو"}], "hasIhya": false}, {"ayah": 32, "text": "نُزُلًا مِّنْ غَفُورٍ رَّحِيمٍ ", "translation": "As accommodation from a [Lord who is] Forgiving and Merciful.\"", "words": [{"id": 1, "arabic": "نُزُلًا", "translit": "āًlُzُn", "root": "نزل"}, {"id": 2, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 3, "arabic": "غَفُورٍ", "translit": "ٍrwُfَغ", "root": "غفر"}, {"id": 4, "arabic": "رَّحِيمٍ", "translit": "ٍmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 33, "text": "وَمَنْ أَحْسَنُ قَوْلًا مِّمَّن دَعَآ إِلَى ٱللَّهِ وَعَمِلَ صَٰلِحًا وَقَالَ إِنَّنِى مِنَ ٱلْمُسْلِمِينَ ", "translation": "And who is better in speech than one who invites to Allāh and does righteousness and says, \"Indeed, I am of the Muslims.\"", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 3, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 4, "arabic": "مِّمَّن", "translit": "nَّmِّm", "root": ""}, {"id": 5, "arabic": "دَعَآ", "translit": "ٓāَʿعَd", "root": "دعو"}, {"id": 6, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 9, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 10, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 11, "arabic": "إِنَّنِى", "translit": "àِnَّnِiʾ", "root": ""}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlٱ", "root": "سلم"}], "hasIhya": true}, {"ayah": 34, "text": "وَلَا تَسْتَوِى ٱلْحَسَنَةُ وَلَا ٱلسَّيِّئَةُۚ ٱدْفَعْ بِٱلَّتِى هِىَ أَحْسَنُ فَإِذَا ٱلَّذِى بَيْنَكَ وَبَيْنَهُۥ عَدَٰوَةٌ كَأَنَّهُۥ وَلِىٌّ حَمِيمٌ ", "translation": "And not equal are the good deed and the bad. Repel [evil] by that [deed] which is better; and thereupon, the one whom between you and him is enmity [will become] as though he was a devoted friend.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَسْتَوِى", "translit": "àِwَtْsَt", "root": "سوي"}, {"id": 3, "arabic": "ٱلْحَسَنَةُ", "translit": "ُẗَnَsَḥْlٱ", "root": "حسن"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "ٱلسَّيِّئَةُ", "translit": "ُẗَyʾِّyَّslٱ", "root": "سوا"}, {"id": 6, "arabic": "ٱدْفَعْ", "translit": "ْʿعَfْdٱ", "root": "دفع"}, {"id": 7, "arabic": "بِٱلَّتِى", "translit": "àِtَّlٱِb", "root": ""}, {"id": 8, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 9, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 10, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 11, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "بَيْنَكَ", "translit": "َkَnْyَb", "root": "بين"}, {"id": 13, "arabic": "وَبَيْنَهُۥ", "translit": "ۥُhَnْyَbَw", "root": "بين"}, {"id": 14, "arabic": "عَدَٰوَةٌ", "translit": "ٌẗَwَٰdَʿع", "root": "عدو"}, {"id": 15, "arabic": "كَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَk", "root": ""}, {"id": 16, "arabic": "وَلِىٌّ", "translit": "ٌّàِlَw", "root": "ولي"}, {"id": 17, "arabic": "حَمِيمٌ", "translit": "ٌmyِmَḥ", "root": "حمم"}], "hasIhya": true}, {"ayah": 35, "text": "وَمَا يُلَقَّىٰهَآ إِلَّا ٱلَّذِينَ صَبَرُوا۟ وَمَا يُلَقَّىٰهَآ إِلَّا ذُو حَظٍّ عَظِيمٍ ", "translation": "But none is granted it except those who are patient, and none is granted it except one having a great portion [of good].", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يُلَقَّىٰهَآ", "translit": "ٓāَhٰàَّqَlُy", "root": "لقي"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "يُلَقَّىٰهَآ", "translit": "ٓāَhٰàَّqَlُy", "root": "لقي"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 10, "arabic": "حَظٍّ", "translit": "ٍّẓَḥ", "root": "حظظ"}, {"id": 11, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 36, "text": "وَإِمَّا يَنزَغَنَّكَ مِنَ ٱلشَّيْطَٰنِ نَزْغٌ فَٱسْتَعِذْ بِٱللَّهِۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ", "translation": "And if there comes to you from Satan an evil suggestion, then seek refuge in Allāh. Indeed, He is the Hearing, the Knowing.", "words": [{"id": 1, "arabic": "وَإِمَّا", "translit": "āَّmِiʾَw", "root": ""}, {"id": 2, "arabic": "يَنزَغَنَّكَ", "translit": "َkَّnَغَznَy", "root": "نزغ"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 5, "arabic": "نَزْغٌ", "translit": "ٌغْzَn", "root": "نزغ"}, {"id": 6, "arabic": "فَٱسْتَعِذْ", "translit": "ْhdِʿعَtْsٱَf", "root": "عوذ"}, {"id": 7, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 8, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 9, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 10, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 11, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 37, "text": "وَمِنْ ءَايَٰتِهِ ٱلَّيْلُ وَٱلنَّهَارُ وَٱلشَّمْسُ وَٱلْقَمَرُۚ لَا تَسْجُدُوا۟ لِلشَّمْسِ وَلَا لِلْقَمَرِ وَٱسْجُدُوا۟ لِلَّهِ ٱلَّذِى خَلَقَهُنَّ إِن كُنتُمْ إِيَّاهُ تَعْبُدُونَ ", "translation": "And of His signs are the night and day and the sun and moon. Do not prostrate to the sun or to the moon, but prostrate to Allāh, who created them, if it should be Him that you worship.[1]", "words": [{"id": 1, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 2, "arabic": "ءَايَٰتِهِ", "translit": "ِhِtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱلَّيْلُ", "translit": "ُlْyَّlٱ", "root": "ليل"}, {"id": 4, "arabic": "وَٱلنَّهَارُ", "translit": "ُrāَhَّnlٱَw", "root": "نهر"}, {"id": 5, "arabic": "وَٱلشَّمْسُ", "translit": "ُsْmَّhslٱَw", "root": "شمس"}, {"id": 6, "arabic": "وَٱلْقَمَرُ", "translit": "ُrَmَqْlٱَw", "root": "قمر"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "تَسْجُدُوا۟", "translit": "۟āwُdُjgْsَt", "root": "سجد"}, {"id": 9, "arabic": "لِلشَّمْسِ", "translit": "ِsْmَّhslِl", "root": "شمس"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "لِلْقَمَرِ", "translit": "ِrَmَqْlِl", "root": "قمر"}, {"id": 12, "arabic": "وَٱسْجُدُوا۟", "translit": "۟āwُdُjgْsٱَw", "root": "سجد"}, {"id": 13, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 14, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "خَلَقَهُنَّ", "translit": "َّnُhَqَlَhk", "root": "خلق"}, {"id": 16, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 17, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 18, "arabic": "إِيَّاهُ", "translit": "ُhāَّyِiʾ", "root": ""}, {"id": 19, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}], "hasIhya": false}, {"ayah": 38, "text": "فَإِنِ ٱسْتَكْبَرُوا۟ فَٱلَّذِينَ عِندَ رَبِّكَ يُسَبِّحُونَ لَهُۥ بِٱلَّيْلِ وَٱلنَّهَارِ وَهُمْ لَا يَسْـَٔمُونَ۩ ", "translation": "But if they are arrogant - then those who are near your Lord [i.e., the angels] exalt Him by night and by day, and they do not become weary.", "words": [{"id": 1, "arabic": "فَإِنِ", "translit": "ِnِiʾَf", "root": ""}, {"id": 2, "arabic": "ٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱ", "root": "كبر"}, {"id": 3, "arabic": "فَٱلَّذِينَ", "translit": "َnyِhdَّlٱَf", "root": ""}, {"id": 4, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 5, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 6, "arabic": "يُسَبِّحُونَ", "translit": "َnwُḥِّbَsُy", "root": "سبح"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "بِٱلَّيْلِ", "translit": "ِlْyَّlٱِb", "root": "ليل"}, {"id": 9, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 10, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يَسْـَٔمُونَ", "translit": "َnwُmَٔـْsَy", "root": "سام"}], "hasIhya": false}, {"ayah": 39, "text": "وَمِنْ ءَايَٰتِهِۦٓ أَنَّكَ تَرَى ٱلْأَرْضَ خَٰشِعَةً فَإِذَآ أَنزَلْنَا عَلَيْهَا ٱلْمَآءَ ٱهْتَزَّتْ وَرَبَتْۚ إِنَّ ٱلَّذِىٓ أَحْيَاهَا لَمُحْىِ ٱلْمَوْتَىٰٓۚ إِنَّهُۥ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "And of His signs is that you see the earth stilled, but when We send down upon it rain, it quivers and grows. Indeed, He who has given it life is the Giver of Life to the dead. Indeed, He is over all things competent.", "words": [{"id": 1, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 2, "arabic": "ءَايَٰتِهِۦٓ", "translit": "ٓۦِhِtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "أَنَّكَ", "translit": "َkَّnَaʾ", "root": ""}, {"id": 4, "arabic": "تَرَى", "translit": "àَrَt", "root": "راي"}, {"id": 5, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "خَٰشِعَةً", "translit": "ًẗَʿعِhsَٰhk", "root": "خشع"}, {"id": 7, "arabic": "فَإِذَآ", "translit": "ٓāَhdِiʾَf", "root": ""}, {"id": 8, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 9, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "ٱلْمَآءَ", "translit": "َءٓāَmْlٱ", "root": "موه"}, {"id": 11, "arabic": "ٱهْتَزَّتْ", "translit": "ْtَّzَtْhٱ", "root": "هزز"}, {"id": 12, "arabic": "وَرَبَتْ", "translit": "ْtَbَrَw", "root": "ربو"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "أَحْيَاهَا", "translit": "āَhāَyْḥَaʾ", "root": "حيي"}, {"id": 16, "arabic": "لَمُحْىِ", "translit": "ِàْḥُmَl", "root": "حيي"}, {"id": 17, "arabic": "ٱلْمَوْتَىٰٓ", "translit": "ٰٓàَtْwَmْlٱ", "root": "موت"}, {"id": 18, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 19, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 20, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 21, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 22, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 40, "text": "إِنَّ ٱلَّذِينَ يُلْحِدُونَ فِىٓ ءَايَٰتِنَا لَا يَخْفَوْنَ عَلَيْنَآۗ أَفَمَن يُلْقَىٰ فِى ٱلنَّارِ خَيْرٌ أَم مَّن يَأْتِىٓ ءَامِنًا يَوْمَ ٱلْقِيَٰمَةِۚ ٱعْمَلُوا۟ مَا شِئْتُمْۖ إِنَّهُۥ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "Indeed, those who inject deviation into Our verses[1] are not concealed from Us. So, is he who is cast into the Fire better or he who comes secure on the Day of Resurrection? Do whatever you will; indeed, He is Seeing of what you do.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُلْحِدُونَ", "translit": "َnwُdِḥْlُy", "root": "لحد"}, {"id": 4, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 5, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَخْفَوْنَ", "translit": "َnْwَfْhkَy", "root": "خفي"}, {"id": 8, "arabic": "عَلَيْنَآ", "translit": "ٓāَnْyَlَʿع", "root": ""}, {"id": 9, "arabic": "أَفَمَن", "translit": "nَmَfَaʾ", "root": ""}, {"id": 10, "arabic": "يُلْقَىٰ", "translit": "ٰàَqْlُy", "root": "لقي"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 13, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 14, "arabic": "أَم", "translit": "mَaʾ", "root": ""}, {"id": 15, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 16, "arabic": "يَأْتِىٓ", "translit": "ٓàِtْaʾَy", "root": "اتي"}, {"id": 17, "arabic": "ءَامِنًا", "translit": "āًnِmāَء", "root": "امن"}, {"id": 18, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 19, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 20, "arabic": "ٱعْمَلُوا۟", "translit": "۟āwُlَmْʿعٱ", "root": "عمل"}, {"id": 21, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 22, "arabic": "شِئْتُمْ", "translit": "ْmُtْyʾِhs", "root": "شيا"}, {"id": 23, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 24, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 25, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 26, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 41, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ بِٱلذِّكْرِ لَمَّا جَآءَهُمْۖ وَإِنَّهُۥ لَكِتَٰبٌ عَزِيزٌ ", "translation": "Indeed, those who disbelieve in the message [i.e., the Qur’ān][1] after it has come to them...[2] And indeed, it is a mighty[3] Book.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "بِٱلذِّكْرِ", "translit": "ِrْkِّhdlٱِb", "root": "ذكر"}, {"id": 5, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 6, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 7, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 8, "arabic": "لَكِتَٰبٌ", "translit": "ٌbَٰtِkَl", "root": "كتب"}, {"id": 9, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}], "hasIhya": false}, {"ayah": 42, "text": "لَّا يَأْتِيهِ ٱلْبَٰطِلُ مِنۢ بَيْنِ يَدَيْهِ وَلَا مِنْ خَلْفِهِۦۖ تَنزِيلٌ مِّنْ حَكِيمٍ حَمِيدٍ ", "translation": "Falsehood cannot approach it from before it or from behind it; [it is] a revelation from a [Lord who is] Wise and Praiseworthy.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "يَأْتِيهِ", "translit": "ِhyِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "ٱلْبَٰطِلُ", "translit": "ُlِṭَٰbْlٱ", "root": "بطل"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَيْنِ", "translit": "ِnْyَb", "root": "بين"}, {"id": 6, "arabic": "يَدَيْهِ", "translit": "ِhْyَdَy", "root": "يدي"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "خَلْفِهِۦ", "translit": "ۦِhِfْlَhk", "root": "خلف"}, {"id": 10, "arabic": "تَنزِيلٌ", "translit": "ٌlyِznَt", "root": "نزل"}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "حَكِيمٍ", "translit": "ٍmyِkَḥ", "root": "حكم"}, {"id": 13, "arabic": "حَمِيدٍ", "translit": "ٍdyِmَḥ", "root": "حمد"}], "hasIhya": true}, {"ayah": 43, "text": "مَّا يُقَالُ لَكَ إِلَّا مَا قَدْ قِيلَ لِلرُّسُلِ مِن قَبْلِكَۚ إِنَّ رَبَّكَ لَذُو مَغْفِرَةٍ وَذُو عِقَابٍ أَلِيمٍ ", "translation": "Nothing is said to you, [O Muḥammad], except what was already said to the messengers before you. Indeed, your Lord is a possessor of forgiveness and a possessor of painful penalty.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "يُقَالُ", "translit": "ُlāَqُy", "root": "قول"}, {"id": 3, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 7, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 8, "arabic": "لِلرُّسُلِ", "translit": "ِlُsُّrlِl", "root": "رسل"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 13, "arabic": "لَذُو", "translit": "wُhdَl", "root": ""}, {"id": 14, "arabic": "مَغْفِرَةٍ", "translit": "ٍẗَrِfْغَm", "root": "غفر"}, {"id": 15, "arabic": "وَذُو", "translit": "wُhdَw", "root": ""}, {"id": 16, "arabic": "عِقَابٍ", "translit": "ٍbāَqِʿع", "root": "عقب"}, {"id": 17, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 44, "text": "وَلَوْ جَعَلْنَٰهُ قُرْءَانًا أَعْجَمِيًّا لَّقَالُوا۟ لَوْلَا فُصِّلَتْ ءَايَٰتُهُۥٓۖ ءَا۬عْجَمِىٌّ وَعَرَبِىٌّۗ قُلْ هُوَ لِلَّذِينَ ءَامَنُوا۟ هُدًى وَشِفَآءٌۖ وَٱلَّذِينَ لَا يُؤْمِنُونَ فِىٓ ءَاذَانِهِمْ وَقْرٌ وَهُوَ عَلَيْهِمْ عَمًىۚ أُو۟لَٰٓئِكَ يُنَادَوْنَ مِن مَّكَانٍۭ بَعِيدٍ ", "translation": "And if We had made it a foreign [i.e., non-Arabic] Qur’ān, they would have said, \"Why are its verses not explained in detail [in our language]? Is it a foreign [recitation] and an Arab [messenger]?\" Say, \"It is, for those who believe, a guidance and cure.\" And those who do not believe - in their ears is deafness, and it is upon them blindness. Those are being called from a distant place.[1]", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "قُرْءَانًا", "translit": "āًnāَءْrُq", "root": "قرا"}, {"id": 4, "arabic": "أَعْجَمِيًّا", "translit": "āًّyِmَjgْʿعَaʾ", "root": "عجم"}, {"id": 5, "arabic": "لَّقَالُوا۟", "translit": "۟āwُlāَqَّl", "root": "قول"}, {"id": 6, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 7, "arabic": "فُصِّلَتْ", "translit": "ْtَlِّṣُf", "root": "فصل"}, {"id": 8, "arabic": "ءَايَٰتُهُۥٓ", "translit": "ٓۥُhُtَٰyāَء", "root": "ايي"}, {"id": 9, "arabic": "ءَا۬عْجَمِىٌّ", "translit": "ٌّàِmَjgْʿع۬āَء", "root": "عجم"}, {"id": 10, "arabic": "وَعَرَبِىٌّ", "translit": "ٌّàِbَrَʿعَw", "root": "عرب"}, {"id": 11, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 12, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 13, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 14, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 15, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 16, "arabic": "وَشِفَآءٌ", "translit": "ٌءٓāَfِhsَw", "root": "شفي"}, {"id": 17, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 20, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 21, "arabic": "ءَاذَانِهِمْ", "translit": "ْmِhِnāَhdāَء", "root": "اذن"}, {"id": 22, "arabic": "وَقْرٌ", "translit": "ٌrْqَw", "root": "وقر"}, {"id": 23, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 24, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 25, "arabic": "عَمًى", "translit": "àًmَʿع", "root": "عمي"}, {"id": 26, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 27, "arabic": "يُنَادَوْنَ", "translit": "َnْwَdāَnُy", "root": "ندي"}, {"id": 28, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 29, "arabic": "مَّكَانٍۭ", "translit": "ٍۭnāَkَّm", "root": "كون"}, {"id": 30, "arabic": "بَعِيدٍ", "translit": "ٍdyِʿعَb", "root": "بعد"}], "hasIhya": false}, {"ayah": 45, "text": "وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ فَٱخْتُلِفَ فِيهِۗ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِن رَّبِّكَ لَقُضِىَ بَيْنَهُمْۚ وَإِنَّهُمْ لَفِى شَكٍّ مِّنْهُ مُرِيبٍ ", "translation": "And We had already given Moses the Scripture, but it came under disagreement.[1] And if not for a word [i.e., decree][2] that preceded from your Lord, it would have been concluded between them. And indeed they are, concerning it [i.e., the Qur’ān], in disquieting doubt.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "فَٱخْتُلِفَ", "translit": "َfِlُtْhkٱَf", "root": "خلف"}, {"id": 6, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 7, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 8, "arabic": "كَلِمَةٌ", "translit": "ٌẗَmِlَk", "root": "كلم"}, {"id": 9, "arabic": "سَبَقَتْ", "translit": "ْtَqَbَs", "root": "سبق"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 12, "arabic": "لَقُضِىَ", "translit": "َàِḍُqَl", "root": "قضي"}, {"id": 13, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 14, "arabic": "وَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَw", "root": ""}, {"id": 15, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 16, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 17, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 18, "arabic": "مُرِيبٍ", "translit": "ٍbyِrُm", "root": "ريب"}], "hasIhya": false}, {"ayah": 46, "text": "مَّنْ عَمِلَ صَٰلِحًا فَلِنَفْسِهِۦۖ وَمَنْ أَسَآءَ فَعَلَيْهَاۗ وَمَا رَبُّكَ بِظَلَّٰمٍ لِّلْعَبِيدِ ", "translation": "Whoever does righteousness - it is for his [own] soul; and whoever does evil [does so] against it. And your Lord is not ever unjust to [His] servants.", "words": [{"id": 1, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 2, "arabic": "عَمِلَ", "translit": "َlِmَʿع", "root": "عمل"}, {"id": 3, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 4, "arabic": "فَلِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِlَf", "root": "نفس"}, {"id": 5, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 6, "arabic": "أَسَآءَ", "translit": "َءٓāَsَaʾ", "root": "سوا"}, {"id": 7, "arabic": "فَعَلَيْهَا", "translit": "āَhْyَlَʿعَf", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 10, "arabic": "بِظَلَّٰمٍ", "translit": "ٍmَّٰlَẓِb", "root": "ظلم"}, {"id": 11, "arabic": "لِّلْعَبِيدِ", "translit": "ِdyِbَʿعْlِّl", "root": "عبد"}], "hasIhya": true}, {"ayah": 47, "text": "إِلَيْهِ يُرَدُّ عِلْمُ ٱلسَّاعَةِۚ وَمَا تَخْرُجُ مِن ثَمَرَٰتٍ مِّنْ أَكْمَامِهَا وَمَا تَحْمِلُ مِنْ أُنثَىٰ وَلَا تَضَعُ إِلَّا بِعِلْمِهِۦۚ وَيَوْمَ يُنَادِيهِمْ أَيْنَ شُرَكَآءِى قَالُوٓا۟ ءَاذَنَّٰكَ مَا مِنَّا مِن شَهِيدٍ ", "translation": "To Him [alone] is attributed knowledge of the Hour. And fruits emerge not from their coverings nor does a female conceive or give birth except with His knowledge. And the Day He will call to them, \"Where are My 'partners'?\" they will say, \"We announce to You that there is [no longer] among us any witness [to that].\"", "words": [{"id": 1, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 2, "arabic": "يُرَدُّ", "translit": "ُّdَrُy", "root": "ردد"}, {"id": 3, "arabic": "عِلْمُ", "translit": "ُmْlِʿع", "root": "علم"}, {"id": 4, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "تَخْرُجُ", "translit": "ُjgُrْhkَt", "root": "خرج"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "ثَمَرَٰتٍ", "translit": "ٍtَٰrَmَht", "root": "ثمر"}, {"id": 9, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 10, "arabic": "أَكْمَامِهَا", "translit": "āَhِmāَmْkَaʾ", "root": "كمم"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "تَحْمِلُ", "translit": "ُlِmْḥَt", "root": "حمل"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "أُنثَىٰ", "translit": "ٰàَhtnُaʾ", "root": "انث"}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "تَضَعُ", "translit": "ُʿعَḍَt", "root": "وضع"}, {"id": 17, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 18, "arabic": "بِعِلْمِهِۦ", "translit": "ۦِhِmْlِʿعِb", "root": "علم"}, {"id": 19, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 20, "arabic": "يُنَادِيهِمْ", "translit": "ْmِhyِdāَnُy", "root": "ندي"}, {"id": 21, "arabic": "أَيْنَ", "translit": "َnْyَaʾ", "root": ""}, {"id": 22, "arabic": "شُرَكَآءِى", "translit": "àِءٓāَkَrُhs", "root": "شرك"}, {"id": 23, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 24, "arabic": "ءَاذَنَّٰكَ", "translit": "َkَّٰnَhdāَء", "root": "اذن"}, {"id": 25, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 26, "arabic": "مِنَّا", "translit": "āَّnِm", "root": ""}, {"id": 27, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 28, "arabic": "شَهِيدٍ", "translit": "ٍdyِhَhs", "root": "شهد"}], "hasIhya": false}, {"ayah": 48, "text": "وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَدْعُونَ مِن قَبْلُۖ وَظَنُّوا۟ مَا لَهُم مِّن مَّحِيصٍ ", "translation": "And lost from them will be those they were invoking before, and they will be certain that they have no place of escape.", "words": [{"id": 1, "arabic": "وَضَلَّ", "translit": "َّlَḍَw", "root": "ضلل"}, {"id": 2, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 3, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 4, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 5, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 8, "arabic": "وَظَنُّوا۟", "translit": "۟āwُّnَẓَw", "root": "ظنن"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "مَّحِيصٍ", "translit": "ٍṣyِḥَّm", "root": "حيص"}], "hasIhya": false}, {"ayah": 49, "text": "لَّا يَسْـَٔمُ ٱلْإِنسَٰنُ مِن دُعَآءِ ٱلْخَيْرِ وَإِن مَّسَّهُ ٱلشَّرُّ فَيَـُٔوسٌ قَنُوطٌ ", "translation": "Man is not weary of supplication for good [things], but if evil touches him, he is hopeless and despairing.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "يَسْـَٔمُ", "translit": "ُmَٔـْsَy", "root": "سام"}, {"id": 3, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "دُعَآءِ", "translit": "ِءٓāَʿعُd", "root": "دعو"}, {"id": 6, "arabic": "ٱلْخَيْرِ", "translit": "ِrْyَhkْlٱ", "root": "خير"}, {"id": 7, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 8, "arabic": "مَّسَّهُ", "translit": "ُhَّsَّm", "root": "مسس"}, {"id": 9, "arabic": "ٱلشَّرُّ", "translit": "ُّrَّhslٱ", "root": "شرر"}, {"id": 10, "arabic": "فَيَـُٔوسٌ", "translit": "ٌswُٔـَyَf", "root": "ياس"}, {"id": 11, "arabic": "قَنُوطٌ", "translit": "ٌṭwُnَq", "root": "قنط"}], "hasIhya": false}, {"ayah": 50, "text": "وَلَئِنْ أَذَقْنَٰهُ رَحْمَةً مِّنَّا مِنۢ بَعْدِ ضَرَّآءَ مَسَّتْهُ لَيَقُولَنَّ هَٰذَا لِى وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةً وَلَئِن رُّجِعْتُ إِلَىٰ رَبِّىٓ إِنَّ لِى عِندَهُۥ لَلْحُسْنَىٰۚ فَلَنُنَبِّئَنَّ ٱلَّذِينَ كَفَرُوا۟ بِمَا عَمِلُوا۟ وَلَنُذِيقَنَّهُم مِّنْ عَذَابٍ غَلِيظٍ ", "translation": "And if We let him taste mercy from Us after an adversity which has touched him, he will surely say, \"This is [due] to me,[1] and I do not think the Hour will occur; and [even] if I should be returned to my Lord, indeed, for me there will be with Him the best.\" But We will surely inform those who disbelieved about what they did, and We will surely make them taste a massive punishment.", "words": [{"id": 1, "arabic": "وَلَئِنْ", "translit": "ْnِyʾَlَw", "root": ""}, {"id": 2, "arabic": "أَذَقْنَٰهُ", "translit": "ُhَٰnْqَhdَaʾ", "root": "ذوق"}, {"id": 3, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 4, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "ضَرَّآءَ", "translit": "َءٓāَّrَḍ", "root": "ضرر"}, {"id": 8, "arabic": "مَسَّتْهُ", "translit": "ُhْtَّsَm", "root": "مسس"}, {"id": 9, "arabic": "لَيَقُولَنَّ", "translit": "َّnَlwُqَyَl", "root": "قول"}, {"id": 10, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 11, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 12, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 13, "arabic": "أَظُنُّ", "translit": "ُّnُẓَaʾ", "root": "ظنن"}, {"id": 14, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 15, "arabic": "قَآئِمَةً", "translit": "ًẗَmِyʾٓāَq", "root": "قوم"}, {"id": 16, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 17, "arabic": "رُّجِعْتُ", "translit": "ُtْʿعِjgُّr", "root": "رجع"}, {"id": 18, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 19, "arabic": "رَبِّىٓ", "translit": "ٓàِّbَr", "root": "ربب"}, {"id": 20, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 21, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 22, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 23, "arabic": "لَلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlَl", "root": "حسن"}, {"id": 24, "arabic": "فَلَنُنَبِّئَنَّ", "translit": "َّnَyʾِّbَnُnَlَf", "root": "نبا"}, {"id": 25, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 26, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 27, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 28, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 29, "arabic": "وَلَنُذِيقَنَّهُم", "translit": "mُhَّnَqyِhdُnَlَw", "root": "ذوق"}, {"id": 30, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 31, "arabic": "عَذَابٍ", "translit": "ٍbāَhdَʿع", "root": "عذب"}, {"id": 32, "arabic": "غَلِيظٍ", "translit": "ٍẓyِlَغ", "root": "غلظ"}], "hasIhya": true}, {"ayah": 51, "text": "وَإِذَآ أَنْعَمْنَا عَلَى ٱلْإِنسَٰنِ أَعْرَضَ وَنَـَٔا بِجَانِبِهِۦ وَإِذَا مَسَّهُ ٱلشَّرُّ فَذُو دُعَآءٍ عَرِيضٍ ", "translation": "And when We bestow favor upon man, he turns away and distances himself; but when evil touches him, then he is full of extensive supplication.", "words": [{"id": 1, "arabic": "وَإِذَآ", "translit": "ٓāَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَنْعَمْنَا", "translit": "āَnْmَʿعْnَaʾ", "root": "نعم"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْإِنسَٰنِ", "translit": "ِnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 5, "arabic": "أَعْرَضَ", "translit": "َḍَrْʿعَaʾ", "root": "عرض"}, {"id": 6, "arabic": "وَنَـَٔا", "translit": "āَٔـَnَw", "root": "ناي"}, {"id": 7, "arabic": "بِجَانِبِهِۦ", "translit": "ۦِhِbِnāَjgِb", "root": "جنب"}, {"id": 8, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 9, "arabic": "مَسَّهُ", "translit": "ُhَّsَm", "root": "مسس"}, {"id": 10, "arabic": "ٱلشَّرُّ", "translit": "ُّrَّhslٱ", "root": "شرر"}, {"id": 11, "arabic": "فَذُو", "translit": "wُhdَf", "root": ""}, {"id": 12, "arabic": "دُعَآءٍ", "translit": "ٍءٓāَʿعُd", "root": "دعو"}, {"id": 13, "arabic": "عَرِيضٍ", "translit": "ٍḍyِrَʿع", "root": "عرض"}], "hasIhya": true}, {"ayah": 52, "text": "قُلْ أَرَءَيْتُمْ إِن كَانَ مِنْ عِندِ ٱللَّهِ ثُمَّ كَفَرْتُم بِهِۦ مَنْ أَضَلُّ مِمَّنْ هُوَ فِى شِقَاقٍۭ بَعِيدٍ ", "translation": "Say, \"Have you considered: if it [i.e., the Qur’ān] is from Allāh and you disbelieved in it, who would be more astray than one who is in extreme dissension?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "كَفَرْتُم", "translit": "mُtْrَfَk", "root": "كفر"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 12, "arabic": "أَضَلُّ", "translit": "ُّlَḍَaʾ", "root": "ضلل"}, {"id": 13, "arabic": "مِمَّنْ", "translit": "ْnَّmِm", "root": ""}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "شِقَاقٍۭ", "translit": "ٍۭqāَqِhs", "root": "شقق"}, {"id": 17, "arabic": "بَعِيدٍ", "translit": "ٍdyِʿعَb", "root": "بعد"}], "hasIhya": false}, {"ayah": 53, "text": "سَنُرِيهِمْ ءَايَٰتِنَا فِى ٱلْءَافَاقِ وَفِىٓ أَنفُسِهِمْ حَتَّىٰ يَتَبَيَّنَ لَهُمْ أَنَّهُ ٱلْحَقُّۗ أَوَلَمْ يَكْفِ بِرَبِّكَ أَنَّهُۥ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ ", "translation": "We will show them Our signs in the horizons and within themselves until it becomes clear to them that it is the truth.[1] But is it not sufficient concerning your Lord that He is, over all things, a Witness?[2]", "words": [{"id": 1, "arabic": "سَنُرِيهِمْ", "translit": "ْmِhyِrُnَs", "root": "راي"}, {"id": 2, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْءَافَاقِ", "translit": "ِqāَfāَءْlٱ", "root": "افق"}, {"id": 5, "arabic": "وَفِىٓ", "translit": "ٓàِfَw", "root": ""}, {"id": 6, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 7, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 8, "arabic": "يَتَبَيَّنَ", "translit": "َnَّyَbَtَy", "root": "بين"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "أَنَّهُ", "translit": "ُhَّnَaʾ", "root": ""}, {"id": 11, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 12, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 13, "arabic": "يَكْفِ", "translit": "ِfْkَy", "root": "كفي"}, {"id": 14, "arabic": "بِرَبِّكَ", "translit": "َkِّbَrِb", "root": "ربب"}, {"id": 15, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "شَهِيدٌ", "translit": "ٌdyِhَhs", "root": "شهد"}], "hasIhya": true}, {"ayah": 54, "text": "أَلَآ إِنَّهُمْ فِى مِرْيَةٍ مِّن لِّقَآءِ رَبِّهِمْۗ أَلَآ إِنَّهُۥ بِكُلِّ شَىْءٍ مُّحِيطٌۢ ", "translation": "Unquestionably, they are in doubt about the meeting with their Lord. Unquestionably He is, of all things, encompassing.", "words": [{"id": 1, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 2, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "مِرْيَةٍ", "translit": "ٍẗَyْrِm", "root": "مري"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "لِّقَآءِ", "translit": "ِءٓāَqِّl", "root": "لقي"}, {"id": 7, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 8, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 9, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 10, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 11, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 12, "arabic": "مُّحِيطٌۢ", "translit": "ٌۢṭyِḥُّm", "root": "حوط"}], "hasIhya": false}], "tafsir": {"11": [{"arabic": "تعبير عن لسان الحال بلسان المقال ومن هذا قوله تعالى ثم استوى إلى السماء وهي دخان فقال لها وللأرض ائتيا طوعا أو كرها قالتا أتينا طائعين فالبليد يفتقر في فهمه إلى أن يقدر لهما حياة وعقلا وفهما للخطاب وخطابا هو صوت وحرف تسمعه السماء والأرض فتجيبان بحرف وصوت وتقولان أتينا طائعين والبصير يعلم أن ذلك لسان الحال وأنه إنباء عن كونهما مسخرتين بالضرورة ومضطرتين إلى التسخير ومن هذا قوله تعالى وإن من شيء إلا يسبح بحمده فالبليد يفتقر فيه إلى أن يقدر للجمادات حياة وعقلا ونطقا بصوت وحرف حتى يقول سبحان الله ليتحقق تسبيحه والبصير يعلم أنه ما أريد به نطق اللسان بل كونه مسبحا بوجوده ومقدسا بذاته وشاهدا", "english": "The fifth [division] is that one expresses by the tongue of explicit statement (lisān al-maqāl) what belongs to the tongue of state (lisān al-ḥāl). The one of deficient understanding stops at the outward and believes it to be literal speech, while the one with insight into realities perceives the secret within it. This is like the saying of one who said: \"The wall said to the peg: 'Why have you split me?' It replied: 'Ask the one who strikes me — he did not leave me behind the stone that is behind me.'\" This is an expression of the tongue of state by the tongue of explicit statement.", "book_title": "Foundations of Belief", "section_title_ar": "Section 85", "section_title_en": "The Fourth Division — Comprehension by Encounter and Taste (Al-Dhawq), and the Fifth Division — The Tongue of State (Lisān al-Ḥāl)", "section_index": 85, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core root denotes the faculty of knowing, perceiving a thing's reality; encompasses both direct apprehension and judgment about existence.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence itself and judgment concerning it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (maʿrifah) from awareness (shuʿūr); here, the distinction between superficial knowledge (ẓāhir) and realized knowledge (bāṭin) is rhetorical-metaphorical, not contradictory.\n- Root: ظهر (ẓahara)\n  * Lisan / Ayn: Core root denotes outwardness, visibility, strength of back; the ẓāhir is what is manifest and apparent.\n  * Al-Raghib (Mufradat): The ẓāhir is used metaphorically for the outward aspect of a thing, as opposed to its inner reality (bāṭin); the back (ẓahr) carries what is loaded upon it.\n  * Al-Zamakhshari (Asas - Majaz): \"قلبت الأمر ظهرا لبطن\" — turning a matter over, examining its outward and inward aspects; the ẓāhir is the shell (qishr) that contains and is completed by the inner kernel (lubb).\n- Root: وقع (waqaʿa)\n  * Lisan / Ayn: Core root denotes falling, occurring, befalling; a thing's occurrence and realization.\n  * Al-Raghib (Mufradat): \"الوقوع: ثبوت الشيء وسقوطه\" — occurrence is the establishment and falling of a thing; in Quranic usage, often associated with calamities and inevitable events.\n  * Al-Zamakhshari (Asas - Majaz): \"وقع الأمر حصل ووجد\" — the matter occurred, i.e., it became realized and existent; here, the \"occurrence\" of a state (ḥāl) is its actual realization in the soul, as opposed to mere intellectual assent before its descent.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure allows for separation between the operative word and its object to achieve rhetorical emphasis, mirroring the semantic distinction between outward apprehension and inward realization.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Foundations of Belief'", "badge": "Du'a"}], "15": [{"arabic": "{من أشد منا قوة} وكما اتكل عوج على قوته وأعجب بها فاقتلع جبلا ليطبقه على عسكر موسى عليه السلام فثقب الله تعالى تلك القطعة من الجبل بنقر هدهد ضعيف المنقار حتى صارت في عنقه وقد يتكل المؤمن أيضا على قوته كما روي عن سليمان عليه السلام أنه قال لأطوفن الليلة على مائة امرأة ولم يقل إن شاء الله تعالى فحرم ما أراد من الولد // حديث قال سليمان لأطوفن الليلة بمائة امرأة", "english": "PageV03P373\n...and they forgot the favor of God—Exalted is He—upon them, and said: {«لَا نَغْلِبَ الْيَوْمَ مِنْ قِلَّةٍ»} [\"We shall not be overcome today by scarcity\"] (Q 26:54 — from the story of Pharaoh's host). The hadith: \"There is not one of you whom his deed will save\" — the hadith is agreed upon (Muttafaq ʿalayh) from the narration of Abu Hurayrah.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 880", "section_title_en": "The Remedy that Uproots the Source of Self-Admiration from the Heart, and the Exposition of the Categories of What One Admires in Himself with the Detailed Cure for Each", "section_index": 880, "anchors": "- Root: نسي (N-S-Y)\n  * Lisan / Ayn: To forget, to abandon; the core sense is the mind's lapse from retaining something previously known.\n  * Al-Raghib (Mufradat): Forgetfulness (Nisyān) is the soul's neglect of what it has grasped; contrasted with Dhikr (remembrance), it is a moral failing when it concerns divine favors.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"نسي الشيء\" — he forgot it. Metaphorical (Majaz): \"نسي نفسه\" — he neglected his own soul's welfare, as in the Quranic usage.\n- Root: عجب (ʿ-J-B)\n  * Lisan / Ayn: Astonishment; a state where the cause of a thing is hidden from the perceiver.\n  * Al-Raghib (Mufradat): \"العجب: حالة تعرض للإنسان عند الجهل بسبب الشيء\" — self-admiration (ʿUjb) is a state that overtakes a man due to ignorance of the true cause of his state or action; hence it is impossible for God, the Knower of all.\n  * Al-Zamakhshari (Asas): Literal: \"قصة عجب\" — an astonishing matter. Metaphorical: \"أبو العجب: الشعوذي\" — the \"father of wonders\" is the trickster who produces marvels; here, the admirer is deceived by his own act.\n- Root: قمع (Q-M-ʿ)\n  * Lisan / Ayn: To beat down, to suppress, to subdue; to strike something on its head to force it down.\n  * Al-Raghib (Mufradat): Suppression of a passion or vice at its root, so that it does not sprout again.\n  * Al-Zamakhshari (Asas): Literal: \"قمعت الشيء\" — I beat it down. Metaphorical: \"قمع الشهوة\" — he crushed the desire, i.e., extinguished its material cause.\n- Root: سلب (S-L-B)\n  * Lisan / Ayn: To strip away, to divest; to take away a garment or an attribute from someone.\n  * Al-Raghib (Mufradat): Deprivation of a blessing (Niʿmah) as a divine act of justice or trial; the removal of what was previously granted.\n  * Al-Zamakhshari (Asas): Literal: \"سلبته ثوبه\" — I stripped him of his garment. Metaphorical: \"سلب نعمة الله\" — God divested him of His favor, i.e., withdrew His grace.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governed noun, as in \"فإذن هذا هو العلاج القامع لمادة العجب من القلب\" where the prepositional phrase \"من القلب\" is postponed for emphasis and rhetorical closure, clarifying the locus of the disease and its cure.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'", "badge": "Hadith"}], "17": [{"arabic": "تعالى به على كافة عباده بعضه بالعقل وبعضه على لسان الرسل ولذلك قال تعالى {وأما ثمود فهديناهم فاستحبوا العمى على الهدى} فأسباب الهدى هي الكتاب والرسل وبصائر العقول وهي مبذولة ولا يمنع منها إلا الحسد والكبر وحب الدنيا والأسباب التي تعمي القلوب وإن كانت لا تعمى الأبصار قال تعالى {فإنها لا تعمى الأبصار ولكن تعمى القلوب التي في الصدور} ومن جملة المعميات الإلف والعادة وحب استصحابهما وعنه العبارة بقوله تعالى {إنا وجدنا آباءنا على أمة} الآية وعن الكبر والحسد العبارة بقوله تعالى {وقالوا لولا نزل هذا القرآن على رجل من القريتين عظيم} وقوله تعالى {أبشرا منا واحدا نتبعه}", "english": "PageV04P107\nBut if one does not know what constitutes the welfare of his hereafter—so that he even supposes corruption to be welfare—then from where would mere volition benefit him? There is no benefit in volition, power, and causes except after guidance (hidāyah). For this reason, God—exalted is He—said: {«ربنا الذي أعطى كل شيء خلقه ثم هدى»} \"Our Lord who gave everything its creation, then guided.\" And He said—exalted is He—: {«ولولا فضل الله عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء»} \"And were it not for God's bounty upon you and His mercy, not one of you would ever be purified; but God purifies whom He wills.\" And the Prophet—peace be upon him—said: \"No one enters Paradise except by the mercy of God—exalted is He—,\" that is, by His guidance. So it was said: \"Not even you, O Messenger of God?\" He said: \"Not even I\" (1). And guidance (hidāyah) has three stations (manāzil):", "book_title": "Patience and Gratitude", "section_title_ar": "Section 999", "section_title_en": "The Degrees of Divine Guidance (Hidāyah), Righteous Discernment (Rushd), Straightening (Tasdīd), and Divine Support (Ta'yīd)", "section_index": 999, "anchors": "- Root: هدي (H-D-Y)\n  * Lisan / Ayn: Core meaning of gentle, gracious direction (dalālah bi-luṭf); the root also yields \"gift\" (hadiyyah) and the leading beasts of prey (hawādī) that guide the herd.\n  * Al-Raghib (Mufradat): Guidance is \"directional indication with gentleness\" (dalālah bi-luṭf), distinct from mere intellectual proof; it is a divine act that may be general (to all) or specific (to the elect), and its withholding is a form of abandonment.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He guided him to the path\" (hadāhu lil-sabīl). Metaphorical (majāz): \"He guided him\" meaning \"he preceded him\" (taqaddamahu), as a leader precedes the caravan; hence guidance is not merely pointing but active leading.\n- Root: رشد (R-SH-D)\n  * Lisan / Ayn: The state of being rightly directed in one's affairs; integrity of judgment; names Rāshid, Rushayd derive from it.\n  * Al-Raghib (Mufradat): Rushd is the opposite of ghayy (error/ruin); it is used like hidāyah but with a nuance of practical, executive discernment—knowing the good AND being moved to pursue it. Al-Raghib explicitly distinguishes the rushd of Abraham (given before, as a special gift) from the mere legal competence (rushd) of an orphan.\n  * Al-Zamakhshari (Asas): Literal: \"A man is rāshid or rashīd\" (possessing rightness in conduct). Metaphorical: \"He is of sound lineage\" (huwa li-rushdah), i.e., legitimate—showing the root's extension to ontological soundness.\n- Root: سدد (S-D-D)\n  * Lisan / Ayn: To aim correctly, to hit the mark; the arrow that flies straight (sadīd); the opposite of deviation (ighrāḍ).\n  * Al-Raghib (Mufradat): (Not in the retrieved scholia, but by extension from the root's usage in the Qur'an, e.g., {wa-saddidū}, \"and be straight/aim rightly\")—it denotes the divine facilitation of the creature's movements so they align with the intended good.\n  * Al-Zamakhshari (Asas): Literal: \"He aimed the arrow and it went straight.\" Metaphorical: \"He was granted success in speech and action\" (sudda li-l-ṣawāb).\n- Root: أيد (A-Y-D)\n  * Lisan / Ayn: Strength, support, reinforcement; the \"aid\" (ayd) of God is His empowering of His servant.\n  * Al-Raghib (Mufradat): (By extension from {إذ أيدتك بروح القدس})—divine reinforcement through a holy spirit, i.e., an immaterial power that fortifies both inner perception (baṣīrah) and outer action.\n  * Al-Zamakhshari (Asas): Literal: \"He strengthened him\" (ayyadahu). Metaphorical: Used for the conferral of spiritual power that makes the servant invincible against error.\n- Sibawayh Rule: Rule of Gradation and Specification (Tartīb wa-Takhṣīṣ) — The author structures a sequence of terms (hidāyah → rushd → tasdīd → ta'yīd) where each subsequent term is syntactically and semantically superordinate, building a hierarchy of divine acts. The particle \"wa-ammā\" (وأما) marks a new topic with contrastive focus, and the anaphoric references (هو، وهي) bind the exposition into a single periodic argument.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}], "21": [{"arabic": "وتكلمنا أيديهم وتشهد أرجلهم وقوله تعالى وقالوا لجلودهم لم شهدتم علينا قالوا أنطقنا الله الذي أنطق كل شيء وكذلك المخاطبات التي تجري من منكر ونكير وفي الميزان والصراط والحساب ومناظرات أهل النار وأهل الجنة في قولهم أفيضوا علينا من الماء أو مما رزقكم الله زعموا أن ذلك كله بلسان الحال وغلا آخرون في حسم الباب منهم أحمد بن حنبل رضي الله عنه حتى منع تأويل قوله كن فيكون وزعموا أن ذلك خطاب بحرف وصوت يوجد من الله تعالى في كل لحظة بعدد كون مكون حتى سمعت بعض أصحابه يقول إنه حسم باب التأويل إلا لثلاثة ألفاظ قوله", "english": "The fifth [division] is that one expresses by the tongue of explicit statement (lisān al-maqāl) what belongs to the tongue of state (lisān al-ḥāl). The one of deficient understanding stops at the outward and believes it to be literal speech, while the one with insight into realities perceives the secret within it. This is like the saying of one who said: \"The wall said to the peg: 'Why have you split me?' It replied: 'Ask the one who strikes me — he did not leave me behind the stone that is behind me.'\" This is an expression of the tongue of state by the tongue of explicit statement.", "book_title": "Foundations of Belief", "section_title_ar": "Section 85", "section_title_en": "The Fourth Division — Comprehension by Encounter and Taste (Al-Dhawq), and the Fifth Division — The Tongue of State (Lisān al-Ḥāl)", "section_index": 85, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core root denotes the faculty of knowing, perceiving a thing's reality; encompasses both direct apprehension and judgment about existence.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence itself and judgment concerning it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (maʿrifah) from awareness (shuʿūr); here, the distinction between superficial knowledge (ẓāhir) and realized knowledge (bāṭin) is rhetorical-metaphorical, not contradictory.\n- Root: ظهر (ẓahara)\n  * Lisan / Ayn: Core root denotes outwardness, visibility, strength of back; the ẓāhir is what is manifest and apparent.\n  * Al-Raghib (Mufradat): The ẓāhir is used metaphorically for the outward aspect of a thing, as opposed to its inner reality (bāṭin); the back (ẓahr) carries what is loaded upon it.\n  * Al-Zamakhshari (Asas - Majaz): \"قلبت الأمر ظهرا لبطن\" — turning a matter over, examining its outward and inward aspects; the ẓāhir is the shell (qishr) that contains and is completed by the inner kernel (lubb).\n- Root: وقع (waqaʿa)\n  * Lisan / Ayn: Core root denotes falling, occurring, befalling; a thing's occurrence and realization.\n  * Al-Raghib (Mufradat): \"الوقوع: ثبوت الشيء وسقوطه\" — occurrence is the establishment and falling of a thing; in Quranic usage, often associated with calamities and inevitable events.\n  * Al-Zamakhshari (Asas - Majaz): \"وقع الأمر حصل ووجد\" — the matter occurred, i.e., it became realized and existent; here, the \"occurrence\" of a state (ḥāl) is its actual realization in the soul, as opposed to mere intellectual assent before its descent.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure allows for separation between the operative word and its object to achieve rhetorical emphasis, mirroring the semantic distinction between outward apprehension and inward realization.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}], "23": [{"arabic": "الله له ذنبه قال لأن الله عز وجل عير قوما فقال وذلكم ظنكم الذي ظننتم بربكم أرداكم وقال تعالى وظننتم ظن السوء وكنتم قوما بورا وقال صلى الله عليه وسلم إن الله تعالى يقول للعبد يوم القيامة ما منعك إذ رأيت المنكر أن تنكره فإن لقنه الله حجته قال يا رب رجوتك وخفت الناس قال فيقول الله تعالى قد غفرته لك (4) وفي الخبر الصحيح أن رجلا كان يداين الناس فيسامح الغني ويتجاوز عن المعسر فلقي الله ولم يعمل خيرا قط فقال الله عز وجل من أحق بذلك منا (5) فعفا عنه لحسن ظنه ورجائه أن يعفو عنه مع إفلاسه عن الطاعات وقال تعالى إن الذين يتلون كتاب الل", "english": "The Prophet, peace be upon him, said: \"Let not one of you die except while he holds a good opinion of God, the Exalted.\" (1) And he, peace be upon him, said: \"God, the Mighty and Majestic, says: I am as My servant thinks of Me, so let him think of Me whatever he wishes.\" (2)", "book_title": "Fear and Hope", "section_title_ar": "Section 1031", "section_title_en": "On the Excellence of Good Opinion of God and the Virtue of Hope (Section 1031)", "section_index": 1031, "anchors": "- Root: ظن (Ẓann)\n  * Lisan / Ayn: Core meaning oscillates between certainty and doubt; in theological usage, predominates as \"belief/opinion\" regarding God's attributes and acts.\n  * Al-Raghib (Mufradat): Al-ẓann denotes a preponderant belief (iʿtiqād rājiḥ) that admits of contrary possibility; when coupled with God (ḥusn al-ẓann billāh), it signifies the servant's confident trust in divine mercy and forgiveness, not mere conjecture.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — doubt mixed with certainty; Metaphorical (majāz) — in the ḥadīth \"I am as My servant thinks of Me,\" it is transferred to the heart's settled reliance on God's beneficence, for God's actual response is entailed by His own decree, not by the servant's thought.\n- Root: رجو (Rajā')\n  * Lisan / Ayn: Expectation of something desirable with attendant effort; opposite of yaʾs (despair).\n  * Al-Raghib (Mufradat): Rajā' is the heart's aspiration toward a good whose attainment is possible; it is praiseworthy only when accompanied by fear (khawf) and action, for pure hope without works is delusion (ghurūr).\n  * Al-Zamakhshari (Asas): Literal — awaiting rain (rajāʾ al-ghayth); Metaphorical — the soul's yearning for divine pardon, as in the verse {يَرْجُونَ تِجَارَةً لَنْ تَبُورَ} (they hope for a commerce that will never perish).\n- Root: قنط (Qanaṭa)\n  * Lisan / Ayn: Despair of good; severance of hope.\n  * Al-Raghib (Mufradat): Qunūṭ is the cessation of expectation of divine mercy, which is blameworthy and tantamount to disbelief in God's power to forgive.\n  * Al-Zamakhshari (Asas): Literal — drought-stricken land yielding no vegetation; Metaphorical — the soul barren of hope, as in {وَكُنْتُمْ قَوْمًا بُورًا} (you were a ruined people).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The ḥadīth \"أنا عند ظن عبدي بي\" employs the prepositional phrase \"بي\" as a complement to \"ظن,\" governing the servant's cognitive stance toward God; the interposition of \"عبدي\" between the noun and its complement emphasizes the possessive intimacy of the servant's relation to his Lord.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Fear and Hope'", "badge": "Hadith"}], "26": [{"arabic": "التلبيس وذلك من أخلاق الكافرين والمنافقين إذ وصفهم الله تعالى فقال {وقال الذين كفروا لا تسمعوا لهذا القرآن والغوا فيه لعلكم تغلبون} فكل من يناظر للغلبة والإفحام لا ليغتنم الحق إذا ظفر به فقد شاركهم في هذا الخلق وكذلك يحمل ذلك على الأنفة من قبول الوعظ كما قال تعالى {وإذا قيل له اتق الله أخذته العزة بالإثم} وروي عن عمر رضي الله عنه أنه قرأها فقال {إنا لله وإنا إليه راجعون} قام رجل يأمر بالمعروف فقتل فقام آخر فقال يقتلون الذين يأمرون بالقسط من الناس فقتل المتكبر الذي خالفه والذي أمره كبرا وقال ابن مسعود كفى بالرجل إثما إذا قيل له اتق الله قال عليك نفسك وقال صلى الله عليه وسلم لر", "english": "The second aspect by which the vice of pride is magnified is that it calls to opposing Allah the Exalted in His commands. For the arrogant man, when he hears the truth from a servant among the servants of Allah, disdains to accept it and girds himself for its denial. For this reason you see the disputants in matters of religion claiming that they are investigating the secrets of the religion, yet they engage in mutual denial—the denial of the arrogant. Whenever the truth becomes clear upon the tongue of one of them, the other refuses to accept it out of pride, girds himself for its denial, and resorts to every stratagem to repel it by whatever obfuscation he can muster. This is among the moral traits of the disbelievers and the hypocrites, for Allah the Exalted described them, saying: {«وَقَالَ الَّذِينَ كَفَرُوا لَا تَسْمَعُوا لِهَذَا الْقُرْآنِ وَالْغَوْا فِيهِ لَعَلَّكُمْ تَغْلِبُونَ»} (And those who disbelieve said: \"Do not listen to this Quran and make noise therein, perhaps you may prevail.\") So whoever disputes for the sake of victory and silencing the opponent—not to seize the truth when it appears to him—has shared with them in this moral trait. Likewise, this pride drives one to refuse admonition, as Allah the Exalted said: {«وَإِذَا قِيلَ لَهُ اتَّقِ اللَّهَ أَخَذَتْهُ الْعِزَّةُ بِالْإِثْمِ»} (And when it is said to him, \"Fear Allah,\" pride in sin seizes him.) It is narrated that ʿUmar, may Allah be pleased with him, recited this verse and then said: {«إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ»} (Indeed, we belong to Allah and to Him we return.) A man rose to enjoin good and was killed; then another rose and said: \"They kill those who enjoin justice among the people\"—and the arrogant one who opposed him and the one who commanded him was killed out of pride.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 857", "section_title_en": "The Second Aspect by Which the Vice of Pride (Kibr) Is Magnified: That It Leads to Opposing Allah in His Commands", "section_index": 857, "anchors": "- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core meaning of bigness, magnitude, and seniority; al-kibr is the internal disposition of self-magnification.\n  * Al-Raghib (Mufradat): Al-Kabīr and al-Ṣaghīr are relative terms (mutadāyifān); kibr as a moral vice is the soul's claim to a station above its due, entailing disdain for others.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage concerns physical or quantitative magnitude; metaphorical (majāz) usage here denotes arrogance and haughtiness—\"كبر عليه\" (he disdained it).\n- Root: علم (ʿ-L-M)\n  * Lisan / Ayn: Knowing a thing's reality; the root also carries the sense of a mark/trace (ʿalam) by which one is guided.\n  * Al-Raghib (Mufradat): True knowledge (ʿilm) is apprehension of a thing's essence or judgment about it; the highest form is knowledge of Allah, the self, and the Final End—this engenders fear (khashyah).\n  * Al-Zamakhshari (Asas): Literal: perception and awareness; metaphorical: the \"marks\" (maʿālim) of religion—the distinguishing signs of guidance.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, or spirit; that which is valued and precious.\n  * Al-Raghib (Mufradat): Al-Nafs denotes the soul or self; in theological usage it may refer to the essence (dhāt) of a thing.\n  * Al-Zamakhshari (Asas): Literal: the soul; metaphorical: self-worth and self-regard—the arrogant man \"magnifies his own soul\" (istaʿẓama nafsahu).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The verse {إِنَّمَا يَخْشَى اللَّهَ مِنْ عِبَادِهِ الْعُلَمَاءُ} restricts true fear of Allah exclusively to the learned, delimiting the predicate to the subject.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "30": [{"arabic": "في بالكلية غير الله ومعنى قوله تعالى الذين قالوا ربنا الله ثم استقاموا ولما كان الصراط المستقيم الذي لا يكمل التوحيد إلا بالاستقامة عليه أدق من الشعر وأخذ من السيف مثل الصراط الموصوف في الآخرة فلا ينفك بشر عن ميل عن الاستقامة ولو في أمر يسير إذ لا يخلو عن اتباع الهوى ولو في فعل قليل وذلك قادح في كمال التوحيد بقدر ميله عن الصراط المستقيم فذلك يقتضي لا محالة نقصانا في درجات القرب ومع كل نقصان ناران نار الفراق لذلك الكمال الفائت بالنقصان ونار جهنم كما وصفها القرآن فيكون كل مائل عن الصراط المستقيم معذبا مرتين من وجهين", "english": "The fire of Hell is the coldest of fires [in comparison to the fire of separation]. And you should not deny this in the world of the Hereafter, for it has a witnessed parallel in the world of this world. Indeed, one has been seen who was overcome by ecstasy (wajd) and walked upon fire and upon the roots of cane, his feet being cut, yet he did not feel it, due to the extreme dominance of what was in his heart. And you see the angry man, when anger overcomes him in battle, receiving wounds and not feeling them at that moment, because anger is a fire in the heart. The Messenger of God, peace and blessings be upon him, said: {«الغضب قطعة من النار»} \"Anger is a piece of fire.\" The burning of the heart (iḥtirāq al-fu'ād) is more severe than the burning of bodies, and the more severe annuls the sensation of the weaker, as you observe. For destruction from fire and the sword is only inasmuch as they separate between two parts that are linked one to the other by the bond of composition (ta'līf) possible in bodies. So that which separates between the heart and its Beloved, to which it is linked by a bond of composition far more firm than the composition of bodies, is more intensely painful—if you are among the people of insight (abṣār) and the people of hearts. And it is not far-fetched that he who has no heart should not perceive the severity of this pain and should deem it trivial in comparison to bodily pain. For a boy, if he were given the choice between the pain of being deprived of a ball and a polo-stick, and the pain of being deprived of the rank of a Sultan, he would not feel the pain of deprivation from the Sultan's rank at all, nor would he count that as a pain. And the enemy in the field with the polo-stick is more beloved to him than a thousand thrones of the Sultan with sitting upon them. Nay, even one overcome by the lust of the belly, if given the choice between porridge (harīsah) and sweets (ḥalwā) and between a beautiful deed by which he conquers enemies and delights friends, he would prefer the porridge and sweets. All of this is due to the absence of the meaning (maʿnā) by whose existence rank becomes beloved, and the presence of the meaning by whose existence food becomes delicious. This is for one whom the attributes of beasts and predators have enslaved, and in whom the attributes of the angels have not appeared—those attributes which are not suited by, nor delight in, anything but proximity to the Lord of the Worlds, and which are pained only by distance and the veil (ḥijāb). And just as taste is only in the tongue and hearing only in the ears, so this attribute is only in the heart. So he who has no heart has no such sense, like he who has no hearing or sight has no pleasure in melodies or the beauty of forms and colors. And not every human has a heart; were it so, the saying of God, Most High, would not be sound: {«إن في ذلك لذكرى لمن كان له قلب»} \"Indeed in that is a reminder for whoever has a heart\" (Q. 50:37). Thus He made the one who does not heed the Quran devoid of a heart. And by \"heart\" I do not mean this [organ] which the ribs of the chest encompass. Rather, I mean the secret (sirr) which is of the world of the Command (ʿālam al-amr). The flesh which is of the world of Creation (ʿālam al-khalq) is its Throne (ʿarsh), the chest is its Footstool (kursī), and the rest of the limbs are its domain and kingdom. And to God belongs the Creation and the Command altogether. But that secret, concerning which God, Most High, said: {«قل الروح من أمر ربي»} \"Say: The Spirit is of the Command of my Lord\" (Q. 17:85), is the commander and the king, because between the world of the Command and the world of Creation there is an ordering, and the world of the Command is commander over the world of Creation. It is the subtle divine reality (al-laṭīfah) which, when it is sound, the rest of the body is sound for its sake. Whoever knows it has known his own self, and whoever knows his own self has known his Lord. At that point, the servant smells the beginnings of the fragrance of the meaning folded under his saying, peace and blessings be upon him: {«إن الله خلق آدم على صورته»} \"God created Adam upon His image.\" He looks with the eye of mercy upon those who adhere to its literal wording and upon those who are obstinate in the path of its interpretation (ta'wīl). And even though His mercy for those adhering to the letter is greater than His mercy for the obstinate interpreters, because mercy is proportional to the affliction, and the affliction of those [literalists] is greater—even if they share in the affliction of being deprived of the reality of the matter—for the Reality (al-ḥaqīqah) is the bounty of God which He gives to whom He wills, and God is the Possessor of Great Bounty. And His Wisdom is singled out for whom He wills: {«ومن يؤت الحكمة فقد أوتي خيرا كثيرا»} \"And whoever is given wisdom has been given much good\" (Q. 2:269). Let us return to the purpose, for we have drawn out the length and lengthened the breath in a matter that is higher than the sciences of transactions (muʿāmalāt) which we intend in this book. It has become clear that the rank of destruction is only for the ignorant deniers. And the testimony of that from the Book of God and the Sunnah of His Messenger, peace and blessings be upon him, is beyond enumeration, so we have not cited it.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 930", "section_title_en": "The Ranks of the Hereafter: On the Distribution of Degrees and the States of the Saved, the Punished, and the Victorious", "section_index": 930, "anchors": "- Root: ح ر ق (ḥ-r-q)\n  * Lisan / Ayn: Core meaning of burning, scorching, and the fire's consumption of its fuel.\n  * Al-Raghib (Mufradat): The fire of the Hereafter (Nār) is a created reality, but its perception is tied to the spiritual state of the perceiver.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) for physical burning; metaphorical (Majaz) for the burning of the heart (iḥtirāq al-fu'ād) by overwhelming love or anger.\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): The heart (Qalb) is the seat of perception and understanding, distinct from the physical organ.\n  * Al-Zamakhshari (Asas): Literal for the physical heart; metaphorical for the spiritual subtlety (Laṭīfah) that is the locus of divine knowledge and love.\n- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: To know, to perceive a thing by its true nature.\n  * Al-Raghib (Mufradat): Knowledge (ʿIlm) is the apprehension of a thing's reality, which is the basis for distinguishing the ranks of the believers.\n  * Al-Zamakhshari (Asas): Literal for acquired knowledge; metaphorical for the \"unveiling\" (Kashf) knowledge granted to the knowers (ʿĀrifūn).\n- Sibawayh Rule: Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific referents of terms like \"heart\" (Qalb) and \"faith\" (Īmān), ensuring the precise meaning is not conflated with common usage.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وبقوله تعالى إن الذين قالوا ربنا الله ثم استقاموا بل هو معنى قولك لا إله إلا الله أى لا معبود ولا محبوب سواه فكل محبوب فإنه معبود فإن العبد هو المقيد والمعبود هو المقيد به وكل محب فهو مقيد بما يحبه ولذلك قال الله تعالى أرأيت من اتخذ إلهه هواه وقال صلى الله عليه وسلم أبغض إله عبد في الأرض الهوى ولذلك قال عليه السلام من قال لا إله إلا الله مخلصا دخل الجنة ومعنى الإخلاص أن يخلص قلبه لله فلا يبقى فيه شرك لغير الله فيكون الله محبوب قلبه ومعبود قلبه ومقصود قلبه فقط ومن هذا حاله فالدنيا سجنه لأنها مانع", "english": "The first: severing the attachments of this world and expelling love of other-than-God from the heart. For the heart is like a vessel: it cannot accommodate vinegar, for example, unless the water is first poured out of it. {God has not made for any man two hearts in his breast} [Al-Ahzab/4]. The perfection of love consists in loving God — mighty and majestic — with one's entire heart. As long as he turns toward other than Him, a corner of his heart is occupied with other than Him. To the extent that he is occupied with other than God, love of God diminishes from it; and to the extent that water remains in the vessel, the vinegar poured into it is diminished.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1164", "section_title_en": "The Two Pillars of Love for God: Purification of the Heart and Strength of Knowledge", "section_index": 1164, "anchors": "- Root: ح ب ب (ḥ-b-b)\n  * Lisan / Ayn: Core root denotes steadfastness and permanence; the heart's fixed attachment to its object.\n  * Al-Raghib (Mufradat): Love (maḥabbah) is the soul's inclination toward what pleases it; its perfection is exclusive devotion, as in the verse {يحبهم ويحبونه} [Al-Ma'idah/54].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the heart's clinging; metaphorical (majāz) usage extends to acts of obedience and yearning, culminating in 'ishq (intense passionate love) when it overwhelms the lover.\n- Root: خ ل ص (kh-l-ṣ)\n  * Lisan / Ayn: Purity from admixture; the essence of a thing freed from foreign elements.\n  * Al-Raghib (Mufradat): Ikhlāṣ is the purification of intention so that no share of creation remains in it; it is the condition for the validity of the shahādah.\n  * Al-Zamakhshari (Asas): Literal: clear, unmixed honey or water; metaphorical: the heart emptied of all rivals so that God alone occupies it.\n- Root: ز ه د (z-h-d)\n  * Lisan / Ayn: Abstention from what is not essential; renunciation of the superfluous.\n  * Al-Raghib (Mufradat): Asceticism (zuhd) is the heart's detachment from worldly goods, not merely the abandonment of possessions; it is a preparatory station (maqām) for love.\n  * Al-Zamakhshari (Asas): Literal: disinterest in a thing; metaphorical: the soul's indifference to the ephemeral in favor of the eternal.\n- Sibawayh Rule: Rule of Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"إنما يكتسب العبد حب الله\" — affirming love's acquisition solely through specified means, negating all others.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "33": [{"arabic": "أن يبينوه للناس ولا يكتموه (6) وقال تعالى {ومن أحسن قولا ممن دعا إلى الله وعمل صالحا} وقال تعالى {ادع إلى سبيل ربك بالحكمة والموعظة الحسنة} وقال تعالى {ويعلمهم الكتاب والحكمة} وأما الأخبار فقوله صلى الله عليه وسلم لما بعث معاذا رضي الله عنه إلى اليمن لأن يهدي الله بك رجلا واحدا خير لك من الدنيا وما فيها // حديث قال لمعاذ حين بعثه إلى اليمن لأن يهدي الله بك رجلا واحدا خير لك الحديث أخرجه أحمد من حديث معاذ وفي الصحيحين من حديث سهل ابن سعد أنه قال ذلك لعلي وقال صلى الله عليه وسلم من تعلم بابا من العلم ليعلم الناس", "english": "As for the Qur'anic verses: His saying, Mighty and Majestic is He: {وَلِيُنذِرُوا قَوْمَهُمْ إِذَا رَجَعُوا إِلَيْهِمْ لَعَلَّهُمْ يَحْذَرُونَ} \"That they may warn their people when they return to them, that perhaps they may be cautious\" {«ولينذروا قومهم إذا رجعوا إليهم لعلهم يحذرون»} — and the intended meaning is teaching and guidance (al-taʿlīm wa-al-irshād).", "book_title": "Book of Knowledge", "section_title_ar": "Section 8", "section_title_en": "The Excellence of Teaching (Faḍīlat al-Taʿlīm)", "section_index": 8, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning is \"to know, to perceive a thing by its reality\"; the root also carries the sense of \"marker, sign, banner\" — that by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing by its true reality, divided into apprehension of the essence of a thing and judgment upon it. This is the attribute by which the scholar (ʿālim) is distinguished and by which he becomes a \"sign\" (ʿalam) pointing to truth.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — the scholar is among the lofty banners of knowledge. The teaching act makes the scholar a living signpost; the root's literal sense of \"marking\" or \"branding\" a thing carries into the metaphorical (majāz) register of \"imprinting\" knowledge upon hearts.\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: Core meaning is \"to be new, to occur after not having been\"; al-ḥadīth is speech that is new and conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence. The prophetic traditions (aḥādīth) cited here are \"newly conveyed\" reports that carry authority.\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"صاروا أحاديث\" — they became subjects of discourse. The transmission of knowledge is an \"event\" (ḥadath) that occurs in the listener, renewing his state.\n- Root: عهد (ʿahida)\n  * Lisan / Ayn: Core meaning is \"covenant, pact, charge\"; al-ʿahd is a binding commission that one is obligated to fulfill.\n  * Al-Raghib (Mufradat): The covenant (mīthāq) taken from the People of the Book and from the scholars is a divine charge (taklīf) that makes teaching an obligation, not a supererogatory act.\n  * Al-Zamakhshari (Asas): Literal: the covenant is a \"charge entrusted\" (waṣiyyah) that binds the one who receives knowledge to its dissemination.\n- Root: كتم (katama)\n  * Lisan / Ayn: Core meaning is \"to conceal, to hide\"; al-kitmān is the deliberate suppression of what ought to be revealed.\n  * Al-Raghib (Mufradat): Concealment of knowledge is paired with concealment of testimony (shahādah) in the Qur'an — both are sins of the heart (ithm al-qalb) because they withhold what God has commanded to be made manifest.\n  * Al-Zamakhshari (Asas): Literal vs. metaphorical: the \"bridle of fire\" (lijām min nār) on the Day of Judgment is a metaphorical (majāz) embodiment of the inner restraint of truth — the concealed knowledge becomes a physical restraint in the afterlife.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The verse {وإن فريقا منهم ليكتمون الحق وهم يعلمون} employs the restrictive particle \"inna\" with the continuous verb form (yaktimūn) to specify an ongoing, willful concealment, distinguishing it from mere ignorance. The conditional structures in the ḥadīth \"man taʿallama... man ʿallama... man katama\" (whoever learns... whoever teaches... whoever conceals) follow the canonical pattern of protasis-apodosis (sharṭ/jazāʾ) that establishes a universal causal linkage between the act and its recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "34": [{"arabic": "وقوله {ادفع بالتي هي أحسن فإذا الذي بينك وبينه عداوة كأنه ولي حميم} وقوله {والكاظمين الغيظ والعافين عن الناس والله يحب المحسنين} وقوله {اجتنبوا كثيرا من الظن إن بعض الظن إثم ولا تجسسوا ولا يغتب بعضكم بعضا} ولما كسرت رباعيته وشج يوم أحد فجعل الدم يسيل على وجهه وهو يمسح الدم ويقول كيف يفلح قوم خضبوا وجه نبيهم بالدم وهو يدعوهم إلى ربهم (4) فأنزل الله تعالى {ليس لك من الأمر شيء} تأديبا له على ذلك وأمثال هذه التأديبات في القرآن لا تحصر وهو صلى الله عليه وسلم المقصود الأول بالتأديب والتهذيب ثم منه يشرق النور ع", "english": "The Messenger of God, peace and blessings be upon him, was abundant in supplication and earnest entreaty, perpetually asking God Most High to adorn him with the beauties of refined conduct and the noble traits of character. Thus he would say in his supplication: \"O God, beautify my outward form and my inward character (khuluqī wa-khalqī)\" (1), and he would say: \"O God, protect me from the reprehensible traits of character\" (2). God Most High answered his supplication, fulfilling His word, Exalted is He: {«ادعوني أستجب لكم»} [\"Call upon Me, I will answer you\"] (Ghafir 40:60). So He sent down upon him the Qur'an and disciplined him through it, and his character became the Qur'an.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 559", "section_title_en": "The Prophet's Discipline Through the Qur'an and the Invitation to Noble Moral Traits", "section_index": 559, "anchors": "- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning of measuring, fashioning, and creating upon a precise estimation; also used for innate disposition and character.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — the root denotes straight/right estimation; used for bringing something into being from nothing (ibdāʿ) and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خلق الخراز الأديم\" — the leather-worker measures before cutting. Metaphorical (Majaz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom; and \"له خلق حسن\" — he has beautiful character.\n- Root: كرم (karuma)\n  * Lisan / Ayn: Generosity, nobility, honor; the root of karīm (noble/generous) and makārim (noble traits).\n  * Al-Raghib (Mufradat): \"الكرم إذا وصف الله تعالى به فهو اسم لإحسانه وإنعامه المتظاهر\" — when attributed to God, it denotes His manifest beneficence; when attributed to man, it denotes praiseworthy morals and deeds that appear from him.\n  * Al-Zamakhshari (Asas): Literal: \"كرم علينا فلان كرامة\" — he showed generosity. Metaphorical: \"قوم كرم\" — a noble people; \"كرم السحاب تكريما: جاد بمطره\" — the cloud was generous with its rain.\n- Root: أدب (adaba)\n  * Lisan / Ayn: Refinement, discipline, cultivation of character; calling to a gathering (ma'dabah) — the root implies assembling and summoning toward excellence.\n  * Al-Raghib (Mufradat): Discipline (ta'dīb) is the cultivation of the soul through praiseworthy traits and the restraint from blameworthy ones.\n  * Al-Zamakhshari (Asas): Literal: \"أدبته تأديبا\" — I disciplined him. Metaphorical: \"أدبه الله\" — God disciplined him, i.e., refined his character through divine instruction.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما أدبه القرآن\" restricts the means of the Prophet's discipline exclusively to the Qur'an, affirming that the Qur'an alone was the sufficient and complete instrument of his moral formation.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Envy'", "badge": "Du'a"}, {"arabic": "الله يحب المحسنين} وقوله {وليعفوا وليصفحوا ألا تحبون أن يغفر الله لكم} وقوله {ادفع بالتي هي أحسن فإذا الذي بينك وبينه عداوة كأنه ولي حميم} وقوله {والكاظمين الغيظ والعافين عن الناس والله يحب المحسنين} وقوله {اجتنبوا كثيرا من الظن إن بعض الظن إثم ولا تجسسوا ولا يغتب بعضكم بعضا} ولما كسرت رباعيته وشج يوم أحد فجعل الدم يسيل على وجهه وهو يمسح الدم ويقول كيف يفلح قوم خضبوا وجه نبيهم بالدم وهو يدعوهم إلى ربهم (4) فأنزل الله تعالى {ليس لك من الأمر شيء} تأديبا له على ذلك وأمثال هذه التأديبات في القرآن لا تحصر وهو صلى الله عليه وسلم المقصود الأول بالتأديب والتهذيب ثم منه يشرق النور", "english": "The Messenger of God, peace and blessings be upon him, was abundant in supplication and earnest entreaty, perpetually asking God Most High to adorn him with the beauties of refined conduct and the noble traits of character. Thus he would say in his supplication: \"O God, beautify my outward form and my inward character (khuluqī wa-khalqī)\" (1), and he would say: \"O God, protect me from the reprehensible traits of character\" (2). God Most High answered his supplication, fulfilling His word, Exalted is He: {«ادعوني أستجب لكم»} [\"Call upon Me, I will answer you\"] (Ghafir 40:60). So He sent down upon him the Qur'an and disciplined him through it, and his character became the Qur'an.", "book_title": "Etiquette of Living and Prophetic Character", "section_title_ar": "Section 559", "section_title_en": "The Prophet's Discipline Through the Qur'an and the Invitation to Noble Moral Traits", "section_index": 559, "anchors": "- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning of measuring, fashioning, and creating upon a precise estimation; also used for innate disposition and character.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — the root denotes straight/right estimation; used for bringing something into being from nothing (ibdāʿ) and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خلق الخراز الأديم\" — the leather-worker measures before cutting. Metaphorical (Majaz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom; and \"له خلق حسن\" — he has beautiful character.\n- Root: كرم (karuma)\n  * Lisan / Ayn: Generosity, nobility, honor; the root of karīm (noble/generous) and makārim (noble traits).\n  * Al-Raghib (Mufradat): \"الكرم إذا وصف الله تعالى به فهو اسم لإحسانه وإنعامه المتظاهر\" — when attributed to God, it denotes His manifest beneficence; when attributed to man, it denotes praiseworthy morals and deeds that appear from him.\n  * Al-Zamakhshari (Asas): Literal: \"كرم علينا فلان كرامة\" — he showed generosity. Metaphorical: \"قوم كرم\" — a noble people; \"كرم السحاب تكريما: جاد بمطره\" — the cloud was generous with its rain.\n- Root: أدب (adaba)\n  * Lisan / Ayn: Refinement, discipline, cultivation of character; calling to a gathering (ma'dabah) — the root implies assembling and summoning toward excellence.\n  * Al-Raghib (Mufradat): Discipline (ta'dīb) is the cultivation of the soul through praiseworthy traits and the restraint from blameworthy ones.\n  * Al-Zamakhshari (Asas): Literal: \"أدبته تأديبا\" — I disciplined him. Metaphorical: \"أدبه الله\" — God disciplined him, i.e., refined his character through divine instruction.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما أدبه القرآن\" restricts the means of the Prophet's discipline exclusively to the Qur'an, affirming that the Qur'an alone was the sufficient and complete instrument of his moral formation.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Living and Prophetic Character'", "badge": "Du'a"}], "39": [{"arabic": "فانظر إلى الأرض وهى ميتة فإذا أنزل عليها الماء اهتزت وربت واخضرت وأنبتت عجائب النبات وخرجت منها أصناف الحيوانات ثم انظر كيف أحكم جوانب الأرض بالجبال الراسيات الشوامخ الصم الصلاب وكيف أودع المياه تحتها ففجر العيون وأسال الأنهار تجري على وجهها وأخرج من الحجارة اليابسة ومن التراب الكدر ماء رقيقا عذبا صافيا زلالا وجعل به كل شيء حي فأخرج به فنون الأشجار والنبات من حب وعنب وقضب وزيتون ونخل ورمان وفواكه كثيرة لا تحصى مختلفة الأشكال والألوان والطعوم والصفات والأرابيح يفضل بعضها على بعض في الأكل تسقى بماء واحد وت", "english": "For the beast has no power over that; but as for man, God created for him the power, then he disabled it and disbelieved in God's grace therein. So those are like cattle — nay, they are even further astray from the way {فَأُولَٰئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ سَبِيلًا}.", "book_title": "Contemplation", "section_title_ar": "Section 1273", "section_title_en": "On Contemplating the Earth, Its Rivers, Mountains, and Minerals — Section 1273", "section_index": 1273, "anchors": "- Root: فكر (f-k-r)\n  * Lisan / Ayn: التفكر: تأمل القلب وتدبر الشيء، والفكر: إعمال النظر في الشيء\n  * Al-Raghib (Mufradat): الفكر: قوة العلم التي بها يدرك الإنسان، وقيل: هو ترتيب أمور معلومة للتأدي إلى مجهول\n  * Al-Zamakhshari (Asas): الفكر: تصرف القلب في النظر — literal: إعمال الروية؛ metaphorical: التفكر في ملكوت الله\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: التي عليها الناس، وجمعها أرضون\n  * Al-Raghib (Mufradat): الأرض: الجرم المقابل للسماء، ويعبر بها عن أسفل الشيء\n  * Al-Zamakhshari (Asas): literal: الأرض المهاد والفراش؛ metaphorical: تذلل الأرض وسكونها\n- Root: دحا (d-ḥ-w) / مهد (m-h-d)\n  * Lisan / Ayn: مهد: وطأ المكان وهيأه، والمهاد: الفراش الموطأ\n  * Al-Raghib (Mufradat): المهد: الموضع المهيأ للصبي، والمهاد: الأرض الموطأة\n  * Al-Zamakhshari (Asas): literal: فرش الأرض وتمهيدها؛ metaphorical: جعلها قارة ساكنة لا تميد\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — the interposed clause \"فانظر\" after \"إلى الأرض\" maintains grammatical continuity while allowing rhetorical pause.", "content_type": "fiqh", "topic": "Al-Ghazali on the inner and outer dimensions of worship, from 'Contemplation'", "badge": "Worship"}], "42": [{"arabic": "المنزل الذي لا يأتيه الباطل من بين يديه ولا من خلفه تنزيل من حكيم حميد حتى اتسع على أهل الأفكار طريق الاعتبار بما فيه من القصص والأخبار واتضح به سلوك المنهج القويم والصراط المستقيم بما فصل فيه من الأحكام وفرق بين الحلال والحرام فهو الضياء والنور وبه النجاة من الغرور وفيه شفاء لما في الصدور ومن خالفه من الجبابرة قصمه الله ومن ابتغى العلم في غيره أضله الله هو حبل الله المتين ونوره المبين والعروة الوثقى والمعتصم الأوفى وهو المحيط بالقليل والكثير والصغير والكبير لا تنقضي عجائبه ولا تتناهى غرائبه لا يحيط بفوائده ع", "english": "Praise be to God, who has bestowed His favor upon His servants through His sent Messenger (peace be upon him) and His revealed Book — falsehood cannot approach it from before it or from behind it; it is a revelation (tanzīl) from the Wise, the Praiseworthy {«تَنْزِيلٌ مِنْ حَكِيمٍ حَمِيدٍ»}. Through it, the path of reflection (iʿtibār) has been widened for the people of understanding, by virtue of what it contains of narratives and reports; and through it, the way of the upright course and the straight path (al-ṣirāṭ al-mustaqīm) has been made clear, by virtue of what it details of rulings and distinguishes between the lawful (ḥalāl) and the unlawful (ḥarām). It is the illumination and the light; through it is deliverance from delusion; in it is healing for what is in the breasts. Whoever opposes it among the tyrants, God crushes him; and whoever seeks knowledge in other than it, God leads him astray. It is the firm rope of God (ḥabl Allāh al-matīn), His manifest light, the trustworthy handhold (al-ʿurwah al-wuthqā), and the most faithful refuge. It encompasses the little and the much, the small and the great. Its wonders do not come to an end, nor do its marvels reach a limit. No delimitation (taḥdīd) encompasses its benefits according to the people of knowledge, nor does the frequency of repetition wear it out according to the people of recitation. It is that which guided the first and the last. When the jinn heard it, they did not delay in turning to their people as warners, saying: {«فَقَالُوا إِنَّا سَمِعْنَا قُرْآنًا عَجَبًا * يَهْدِي إِلَى الرُّشْدِ فَآمَنَّا بِهِ وَلَنْ نُشْرِكَ بِرَبِّنَا أَحَدًا»} (\"Indeed, we have heard a wondrous Quran; it guides to right conduct, so we have believed in it, and we will never associate anyone with our Lord.\") So whoever believes in it has been granted success (tawfīq); whoever speaks by it has spoken truthfully; whoever clings to it has been guided; and whoever acts by it has attained felicity (fawz). And God, the Exalted, says: {«إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ»} (\"Indeed, We — it is We who have sent down the Remembrance, and indeed, We are its Preservers.\") Among the means of its preservation (ḥifẓ) in hearts and in codices (maṣāḥif) is the constancy of its recitation (tilāwah) and perseverance in its study, along with the fulfillment of its etiquettes (ādāb) and conditions, and the safeguarding of what it contains of inward works (aʿmāl bāṭinah) and outward etiquettes (ādāb ẓāhirah). This cannot be done without its exposition and detailing; its aims unfold in four chapters (abwāb):", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 220", "section_title_en": "The Book of the Etiquettes of Quran Recitation — Section 220: The Excellence of the Quran and Its People", "section_index": 220, "anchors": "- Root: نزل (n-z-l)\n  * Lisan / Ayn: \"نزل: انحطاط من علو إلى سفل\" — descent from a height to a lower place; the setting down of a thing in a place.\n  * Al-Raghib (Mufradat): \"النزول في الأصل هو انحطاط من علو... وإنزال الله تعالى نعمه ونقمه على الخلق، وإعطاؤهم إياها\" — the descent of the Quran is a divine act of sending down (tanzīl) from the highest station, carrying with it the very mercy and address of God.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"نزل من علو إلى سفل\" — physical descent. Majaz (metaphorical): \"وأنزل الله الغيث، وأنزل الكتاب\" — the \"sending down\" of revelation is a metaphorical extension denoting divine bestowal and elevation of the recipient, not spatial movement.\n- Root: حفظ (ḥ-f-ẓ)\n  * Lisan / Ayn: \"الحفظ: الحِراسة والاستظهار\" — guarding, preserving, and keeping watch over a thing.\n  * Al-Raghib (Mufradat): \"الحفظ: ضبط الشيء عن أن يذهب أو يضيع\" — the securing of a thing against loss or corruption; divine preservation (ḥifẓ) is an act of sovereign care.\n  * Al-Zamakhshari (Asas): Haqiqah: guarding a physical object. Majaz: \"حفظ الله فلانًا\" — divine protection from spiritual harm and error.\n- Root: تلو (t-l-w)\n  * Lisan / Ayn: \"التلاوة: الاتباع، ثم سميت القراءة تلاوة لأنها تتبع الآيات حرفًا حرفًا\" — following in sequence; recitation is so named because the reader follows the verses letter by letter.\n  * Al-Raghib (Mufradat): \"التلاوة: الإتيان بالشيء متتابعًا\" — the bringing of a thing in succession; recitation of the Quran is the sequential utterance of its verses in devotion.\n  * Al-Zamakhshari (Asas): Haqiqah: following behind. Majaz: \"تلا الكتاب\" — reciting, as the tongue follows the written text.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its object by an intervening clause, as in «لا يأتيه الباطل من بين يديه ولا من خلفه», where the prepositional phrases are distributed across the sentence for rhetorical emphasis and comprehensiveness.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "46": [{"arabic": "ومجاهداتك أيضا هو مستغن عنها وإنما هى طريقك إلى نجاتك فمن أحسن فلنفسه ومن أساء فعليها والله غنى عن العالمين ويحك يا نفس انزعى عن جهلك وقيسى آخرتك بدنياك فما خلقكم ولا بعثكم إلا كنفس واحدة وكما بدأنا أول خلق نعيده وكما بدأكم تعودون وسنة الله تعالى لا تجدين لها تبديلا ولا تحويلا ويحك يا نفس ما أراك إلا ألفت الدنيا وأنست بها فعسر عليك مفارقتها وأنت مقبلة على مقاربتها وتؤكدين في نفسك مودتها فاحسن أنك غافلة عن عقاب الله وثوابه وعن أهوال القيامة وأحوالها فما أنت مؤمنة بالموت المفرق بينك وبين محابك أفترين أن من يدخل دار ملك ليخرج من الج", "english": "...from creation, but rather you attain your goal through every stratagem. And by this ignorance you deserve the title of foolishness from the Messenger of God, may God bless him and grant him peace, where he said: \"The shrewd one is he who holds his soul to account and works for what comes after death, and the foolish one is he who follows his soul's whims and harbors vain hopes upon God.\" {«الكيس من دان نفسه وعمل لما بعد الموت والأحمق من أتبع نفسه هواها وتمنى على الله الأماني»}", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1253", "section_title_en": "Section 1253 — The Soul's Self-Reproach and the Awakening from Negligence", "section_index": 1253, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates and is addressed as an independent moral agent.\n  * Al-Raghib (Mufradat): The soul as the locus of divine address and self-knowledge; its essence (dhāt) is the referent of God's \"self\" in revelation, yet here it is the reproaching subject.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) usage as the speaking, desiring self; metaphorical (majāz) extension to blame and counsel, as in \"self-accusation\" (lawwāmah).\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of life; the inevitable terminus of every soul.\n  * Al-Raghib (Mufradat): Death as separation (furqah) from worldly attachments and the transition to reckoning; linked to the soul's journey.\n  * Al-Zamakhshari (Asas): Literal death of the body; metaphorical \"death\" of the heart through heedlessness, contrasted here with physical death as the ultimate wake-up call.\n- Root: جهل (j-h-l)\n  * Lisan / Ayn: Ignorance as the absence of knowledge; folly and rashness.\n  * Al-Raghib (Mufradat): Ignorance as the soul's failure to perceive true realities, leading to misplaced desires and false hopes.\n  * Al-Zamakhshari (Asas): Literal ignorance of facts; metaphorical ignorance as moral stupidity, as when the soul follows whims despite clear signs.\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): Drawing near (dunūw) to God through obedience, contrasted with the soul's clinging to the near (dunyā) world.\n  * Al-Zamakhshari (Asas): Literal proximity; metaphorical use for the \"lower\" world (dunyā) as that which is nearer and inferior.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize exclusive causation, e.g., \"God's generosity is only in guiding you to the path,\" restricting divine favor to guidance, not exemption from effort.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'", "badge": "Afterlife"}], "51": [{"arabic": "حاجة وإرهاق ملمة فإن الإنسان إذا مسه الشر فذو دعاء عريض فالحاجة تحوج إلى الدعاء والدعاء يرد القلب إلى الله عز وجل بالتضرع والاستكانة فيحصل به الذكر الذي هو أشرف العبادات ولذلك صار البلاء موكلا بالأنبياء عليهم السلام ثم الأولياء ثم الأمثل فالأمثل لأنه يرد القلب بالافتقار والتضرع إلى الله عز وجل ويمنع من نسيانه وأما الغنى فسبب للبطر في غالب الأمور فإن الإنسان ليطغى أن رآه استغنى فهذا ما أردنا أن نورده من جملة الأذكار والدعوات والله الموفق للخير وأما بقية الدعوات في الأكل والسفر وعيادة المريض وغيره", "english": "\"O God, whatever blessing has come to me this morning, or to any of Your creatures, it is from You alone, with no partner to You; to You is praise and to You is thanksgiving.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 255", "section_title_en": "Section 255", "section_index": 255, "anchors": "*(Anchors established)*", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'On Invocations and Supplications'", "badge": "Dhikr"}], "53": [{"arabic": "وإليه دعا الله سبحانه بقوله {سنريهم آياتنا في الآفاق وفي أنفسهم} وبقوله تعالى {وفي الأرض آيات للموقنين وفي أنفسكم أفلا تبصرون} وعلى القعود عن هذا السفر وقع الإنكار بقوله تعالى {وإنكم لتمرون عليهم مصبحين وبالليل أفلا تعقلون} وبقوله سبحانه {وكأين} {من آية في السماوات والأرض يمرون عليها وهم عنها معرضون} فمن يسر له هذا السفر لم يزل في سيره متنزها في جنة عرضها السماوات والأرض وهو ساكن بالبدن مستقر في الوطن وهو السفر الذي لا تضيق فيه المناهل والموارد ولا يضر فيه التزاحم والتوارد بل تزيد بكثرة المسافرين غنائ", "english": "And to this journey God — exalted be He — has summoned [us] by His saying: {«سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ»} [We shall show them Our signs in the horizons and in their own selves — Fussilat 41:53], and by His saying — exalted be He: {«وَفِي الْأَرْضِ آيَاتٌ لِلْمُوقِنِينَ * وَفِي أَنْفُسِكُمْ أَفَلَا تُبْصِرُونَ»} [And in the earth are signs for those who are certain; and in your own selves — do you not then see? — Dhāriyāt 51:20-21]. And upon sitting back from this journey, censure fell by His saying — exalted be He: {«وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِمْ مُصْبِحِينَ * وَبِاللَّيْلِ أَفَلَا تَعْقِلُونَ»} [And indeed you pass by them in the morning, and by night — do you not then comprehend? — Ṣāffāt 37:137-138], and by His saying — exalted be He: {«وَكَأَيِّنْ مِنْ آيَةٍ فِي السَّمَاوَاتِ وَالْأَرْضِ يَمُرُّونَ عَلَيْهَا وَهُمْ عَنْهَا مُعْرِضُونَ»} [And how many a sign in the heavens and the earth do they pass by, while they are from it turning away — Yūsuf 12:105]. So whoever is facilitated this journey, he never ceases in his traveling to take pleasure in a Garden whose breadth is the heavens and the earth — while he is still with his body at rest, settled in his homeland.", "book_title": "Etiquette of Travel", "section_title_ar": "Section 464", "section_title_en": "The Book of the Etiquettes of Travel — Being the Seventh Book of the Quarter of Customs from The Revival of the Religious Sciences", "section_index": 464, "anchors": "- Root: سفر (s-f-r)\n  * Lisan / Ayn: Core meaning is \"unveiling/disclosure\" (kashf al-ghitā'); also denotes journeying across land, and a group of travelers (safar/qawm musāfirūn).\n  * Al-Raghib (Mufradat): Al-safar: \"the removal of a covering,\" specialized to physical unveiling (e.g., removing a turban from the head). Its theological extension: the journey as a means of unveiling hidden realities — both outward horizons (āfāq) and inward selves (anfus).\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical travel with the body, provisions for a journey (sufrah). Metaphorical (majāz): \"a face radiant with joy\" (wajh musfir); \"the morning brightening\" (asfara al-ṣubḥ) — the inner journey as illumination of the heart's countenance.\n- Root: وفي (w-f-y)\n  * Lisan / Ayn: Fullness, completion, fulfillment of a measure or covenant.\n  * Al-Raghib (Mufradat): Al-wāfī: \"that which has reached completion/perfection.\" Awfā bi-ʿahdihi: to fulfill one's covenant completely without breach. Theologically: the complete fulfillment of the servant's journey — arriving at the full measure of human perfection.\n  * Al-Zamakhshari (Asas): Literal: a full-weight dirham, complete measure. Metaphorical: \"to reach completion of years\" (māta wa-ant bi-wafā'); \"to come upon/arrive at\" (awfā ʿalā) — the journey's end as arrival at full term.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit; that which is precious and valued.\n  * Al-Raghib (Mufradat): Al-nafs: the spirit (rūḥ); in God's speech \"He knows what is in your selves\" — the inner dimension of the human being, the seat of the divine secret.\n  * Al-Zamakhshari (Asas): Literal: a precious thing (shay' nafīs). Metaphorical: \"the soul's blood\" (nafsuhu = damuhu); the inner landscape (āfāq al-anfus) as the terrain of the inward journey.\n- Sibawayh Rule: Prepositional Interposition (al-faṣl bayna al-jār wa-al-majrūr) — governing the periodic suspension of meaning across clauses, as in the verse {سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ}, where the dual prepositional phrases (fī al-āfāq / fī anfusihim) are syntactically parallel yet semantically interposed, requiring the translator to preserve the balanced suspension of the two terrains of divine signs.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Travel'", "badge": "Insight"}, {"arabic": "لما عرفت ربي وإلى الثاني الاشارة بقوله تعالى {سنريهم آياتنا في الآفاق وفي أنفسهم حتى يتبين لهم أنه الحق} الآية وبقوله عز وجل أولم ينظروا في ملكوت السموات والأرض وبقوله تعالى قل انظروا ماذا في السموات والأرض وبقوله تعالى الذي خلق سبع سموات طباقا ما ترى في خلق الرحمن من تفاوت فارجع البصر هل ترى من فطور ثم ارجع البصر كرتين ينقلب إليك البصر خاسئا وهو حسير وهذا الطريق هو الأسهل على الأكثرين وهو الأوسع على السالكين وإليه أكثر دعوة القرآن عند الأمر بالتدبر والتفكر والاعتبار والنظر في آيات خارجة عن الحصر فإن قلت كلا الطريقين مشكل فأوضح لنا منهما ما يس", "english": "Those who arrive at this rank divide into two groups: the strong, whose first knowledge is of God, exalted be He, and then through Him they come to know other than Him; and the weak, whose first knowledge is of [His] acts, and then they ascend from them to the Agent. To the first points His saying, exalted be He: {أو لم يكف بربك أنه على كل شيء شهيد} [Is it not sufficient concerning your Lord that He is over all things a Witness], and His saying, exalted be He: {«شهد الله أنه لا إله إلا هو»} [God bears witness that there is no god but He]. And of this kind is the saying of one of them, when it was said to him: \"By what have you known your Lord?\" He said: \"I have known my Lord — and were it not for my Lord, I would not have known my Lord.\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1165", "section_title_en": "The Two Paths to Knowledge and Love: The Higher Way of Witnessing the Truth and the Easier Way of Contemplating Creation", "section_index": 1165, "anchors": "- Root: طيب (ṭ-y-b)\n  * Lisan / Ayn: Pure, good, wholesome; free from defilement\n  * Al-Raghib (Mufradat): That which is pure and agreeable in both sensory and intellectual registers; the \"good word\" (al-kalim al-ṭayyib) is the declaration of divine unity\n  * Al-Zamakhshari (Asas): Literal for sensory purity; metaphorical for spiritual purity of heart and speech\n- Root: عرف (ʿ-r-f)\n  * Lisan / Ayn: To know by reflection and discernment of traces/effects\n  * Al-Raghib (Mufradat): Maʿrifah is knowledge of God attained through contemplation of His effects, not through direct apprehension of His essence; it is more specific than ʿilm\n  * Al-Zamakhshari (Asas): Literal: to recognize someone; metaphorical: knowledge of God through His signs\n- Root: شهد (sh-h-d)\n  * Lisan / Ayn: To witness, testify, be present\n  * Al-Raghib (Mufradat): Bearing witness to the truth of something based on direct presence or evidence\n  * Al-Zamakhshari (Asas): Literal: ocular presence; metaphorical: intellectual certitude\n- Root: نظر (n-ẓ-r)\n  * Lisan / Ayn: To look, gaze, contemplate\n  * Al-Raghib (Mufradat): Contemplative reflection (naẓar) directed toward creation to derive knowledge of the Creator\n  * Al-Zamakhshari (Asas): Literal: visual perception; metaphorical: intellectual consideration and inference\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to restrict the purpose of works to purification of the heart, and to restrict the ultimate end to knowledge of unveiling", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "الأرض والسموات ثم قال أو لم يكف بربك أنه على كل شيء شهيد {وقال} شهد الله أنه لا إله إلا هو فبين أنه الدليل على نفسه وذلك ليس متناقضا بل طرق الاستدلال مختلفة فكم من طالب عرف الله تعالى بالنظر إلى الموجودات وكم من طالب عرف كل الموجودات بالله تعالى كما قال بعضهم عرفت ربي بربي ولولا ربي لما عرفت ربي وهو معنى قوله تعالى أو لم يكف بربك أنه على كل شيء شهيد وقد وصف الله تعالى نفسه بأنه المحيي والمميت ثم فوض الموت والحياة إلى ملكين ففي الخبر أن ملكي الموت والحياة تناظرا فقال ملك الموت أنا أميت الأحياء وق", "english": "...the killing — rather, He stated explicitly, and He, exalted, said: {فَلَمْ تَقْتُلُوهُمْ وَلَٰكِنَّ اللَّهَ قَتَلَهُمْ} (\"You did not kill them, but God killed them\") and He, exalted, said: {وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَٰكِنَّ اللَّهَ رَمَىٰ} (\"You did not throw when you threw, but God threw\"). This is a combination of negation and affirmation in appearance, but its meaning is: \"You did not throw\" in the sense by which the Lord is a thrower, \"when you threw\" in the sense by which the servant is a thrower — for the two are two distinct meanings.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1115", "section_title_en": "On the Unification of Divine Agency and the Foundation of Trust (Tawḥīd as the Root of Tawakkul)", "section_index": 1115, "anchors": "- Root: ق-ت-ل (Q-T-L)\n  * Lisan / Ayn: Core meaning: \"to kill, to slay\" — the act of causing death by direct agency.\n  * Al-Raghib (Mufradat): In the Qur'anic context {فَلَمْ تَقْتُلُوهُمْ وَلَٰكِنَّ اللَّهَ قَتَلَهُمْ} (8:17), the verb is negated for the creature and affirmed for the Creator, indicating that true creative agency (ījād) belongs to God alone, while the creature's act is merely instrumental and attributive.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage assigns the verb to the true originator; metaphorical (majāz) usage assigns it to the proximate instrument, as in \"the king killed\" when the executioner strikes.\n- Root: ر-م-ي (R-M-Y)\n  * Lisan / Ayn: \"To throw, to cast\" — physical projection of an object.\n  * Al-Raghib (Mufradat): In {وَمَا رَمَيْتَ إِذْ رَمَيْتَ وَلَٰكِنَّ اللَّهَ رَمَىٰ} (8:17), the dual affirmation and negation show two distinct meanings of \"throwing\": the human act (kasb) versus the divine act (khalq).\n  * Al-Zamakhshari (Asas): The literal sense belongs to the agent who originates the act ex nihilo; the metaphorical sense belongs to the one through whom the act occurs as a vessel.\n- Root: ع-ل-م (ʿ-L-M)\n  * Lisan / Ayn: \"Knowledge, perception, cognition\" — the apprehension of a thing as it truly is.\n  * Al-Raghib (Mufradat): Knowledge is of two kinds: (1) apprehension of the essence of a thing, and (2) judgment about a thing's existence or non-existence of attributes. Divine knowledge (ʿilm) is the source of all teaching, as in {عَلَّمَ بِالْقَلَمِ} (96:4).\n  * Al-Zamakhshari (Asas): Literal: \"to know\" as direct cognition; also \"to teach\" (ʿallama) as the transmission of that cognition.\n- Root: و-ك-ل (W-K-L)\n  * Lisan / Ayn: \"To entrust, to delegate, to rely upon\" — the act of appointing another as deputy and placing one's affair in their hands.\n  * Al-Raghib (Mufradat): Tawakkul is to rely upon another and make them one's agent. The Wakīl (Trustee) is He who undertakes the affair of His servant, as in {وَكَفَىٰ بِاللَّهِ وَكِيلًا} (4:81).\n  * Al-Zamakhshari (Asas): Literal: \"to entrust an affair to someone.\" Metaphorical: \"to rely upon\" in the sense of inner confidence and tranquility of heart.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" restricts the predicate to the subject alone, excluding all others. Also applicable: the rule of negation and affirmation (nafy wa-ithbāt) in a single sentence, where the negation applies to one sense and the affirmation to another, requiring semantic disambiguation (taṣrīf al-maʿnā).", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}]}, "wordTiming": {"minshawi": {"1": [[1, 530, 4020]], "41:1": [[1, 530, 4020]], "2": [[1, 460, 1793], [2, 1793, 2459], [3, 2459, 3917], [4, 3917, 5500]], "41:2": [[1, 460, 1793], [2, 1793, 2459], [3, 2459, 3917], [4, 3917, 5500]], "3": [[1, 40, 744], [2, 744, 1704], [3, 1704, 3237], [4, 3237, 4977], [5, 4977, 6856], [6, 6856, 7884], [7, 7884, 9560]], "41:3": [[1, 40, 744], [2, 744, 1704], [3, 1704, 3237], [4, 3237, 4977], [5, 4977, 6856], [6, 6856, 7884], [7, 7884, 9560]], "4": [[1, 300, 1634], [2, 1634, 3337], [3, 3337, 4253], [4, 4253, 5249], [5, 5249, 5715], [6, 5715, 6310], [7, 6310, 7780]], "41:4": [[1, 300, 1634], [2, 1634, 3337], [3, 3337, 4253], [4, 4253, 5249], [5, 5249, 5715], [6, 5715, 6310], [7, 6310, 7780]], "5": [[1, 250, 2306], [2, 2306, 3848], [3, 3848, 5207], [4, 5207, 6069], [5, 6069, 7246], [6, 7246, 9741], [7, 9741, 10520], [8, 10520, 12277], [9, 12277, 14267], [10, 14267, 15089], [11, 15089, 15818], [12, 15818, 17028], [13, 17028, 18189], [14, 18189, 19151], [15, 19151, 19914], [16, 19914, 21091], [17, 21091, 22360]], "41:5": [[1, 250, 2306], [2, 2306, 3848], [3, 3848, 5207], [4, 5207, 6069], [5, 6069, 7246], [6, 7246, 9741], [7, 9741, 10520], [8, 10520, 12277], [9, 12277, 14267], [10, 14267, 15089], [11, 15089, 15818], [12, 15818, 17028], [13, 17028, 18189], [14, 18189, 19151], [15, 19151, 19914], [16, 19914, 21091], [17, 21091, 22360]], "6": [[1, 1710, 2184], [2, 2184, 4875], [3, 4875, 5930], [4, 5930, 6619], [5, 6619, 7975], [6, 7975, 10795], [7, 10795, 11871], [8, 11871, 14562], [9, 14562, 15832], [10, 15832, 16671], [11, 16671, 17743], [12, 17743, 21607], [13, 21607, 22619], [14, 22619, 25051], [15, 25051, 26644], [16, 26644, 28870]], "41:6": [[1, 1710, 2184], [2, 2184, 4875], [3, 4875, 5930], [4, 5930, 6619], [5, 6619, 7975], [6, 7975, 10795], [7, 10795, 11871], [8, 11871, 14562], [9, 14562, 15832], [10, 15832, 16671], [11, 16671, 17743], [12, 17743, 21607], [13, 21607, 22619], [14, 22619, 25051], [15, 25