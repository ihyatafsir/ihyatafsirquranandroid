ion": "warsh"}, {"surah": 41, "ayah": 45, "text": "وَلَقَدَ اٰتَيْنَا مُوسَي اَ۬لْكِتَٰبَ فَاخْتُلِفَ فِيهِۖ وَلَوْلَا كَلِمَةࣱ سَبَقَتْ مِن رَّبِّكَ لَقُضِيَ بَيْنَهُمْۖ وَإِنَّهُمْ لَفِے شَكࣲّ مِّنْهُ مُرِيبࣲۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اٰتَيْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مُوسَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكِتَٰبَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَاخْتُلِفَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِيهِۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَوْلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "كَلِمَةࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَبَقَتْ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "", "root": ""}, {"id": 11, "arabic": "رَّبِّكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَقُضِيَ", "translit": "", "root": ""}, {"id": 13, "arabic": "بَيْنَهُمْۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَإِنَّهُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "لَفِے", "translit": "", "root": ""}, {"id": 16, "arabic": "شَكࣲّ", "translit": "", "root": ""}, {"id": 17, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 18, "arabic": "مُرِيبࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 46, "text": "مَّنْ عَمِلَ صَٰلِحاࣰ فَلِنَفْسِهِۦۖ وَمَنَ اَسَآءَ فَعَلَيْهَاۖ وَمَا رَبُّكَ بِظَلَّٰمࣲ لِّلْعَبِيدِۖ", "words": [{"id": 1, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَمِلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "صَٰلِحاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلِنَفْسِهِۦۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَسَآءَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَعَلَيْهَاۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِظَلَّٰمࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "لِّلْعَبِيدِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 41, "ayah": 47, "text": "۞إِلَيْهِ يُرَدُّ عِلْمُ اُ۬لسَّاعَةِۖ وَمَا تَخْرُجُ مِن ثَمَرَٰتࣲ مِّنَ اَكْمَامِهَا وَمَا تَحْمِلُ مِنُ ا۟نث۪يٰ وَلَا تَضَعُ إِلَّا بِعِلْمِهِۦۖ وَيَوْمَ يُنَادِيهِمُۥٓ أَيْنَ شُرَكَآءِے قَالُوٓاْ ءَاذَنَّٰكَ مَا مِنَّا مِن شَهِيدࣲۖ", "words": [{"id": 1, "arabic": "۞إِلَيْهِ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُرَدُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِلْمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لسَّاعَةِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَخْرُجُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "ثَمَرَٰتࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَكْمَامِهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 12, "arabic": "تَحْمِلُ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِنُ", "translit": "", "root": ""}, {"id": 14, "arabic": "ا۟نث۪يٰ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 16, "arabic": "تَضَعُ", "translit": "", "root": ""}, {"id": 17, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 18, "arabic": "بِعِلْمِهِۦۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَيَوْمَ", "translit": "", "root": ""}, {"id": 20, "arabic": "يُنَادِيهِمُۥٓ", "translit": "", "root": ""}, {"id": 21, "arabic": "أَيْنَ", "translit": "", "root": ""}, {"id": 22, "arabic": "شُرَكَآءِے", "translit": "", "root": ""}, {"id": 23, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 24, "arabic": "ءَاذَنَّٰكَ", "translit": "", "root": ""}, {"id": 25, "arabic": "م