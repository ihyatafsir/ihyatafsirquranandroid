"text": "فَجَعَلَهُۥ غُثَآءً اَحْو۪يٰۖ", "words": [{"id": 1, "arabic": "فَجَعَلَهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "غُثَآءً", "translit": "", "root": ""}, {"id": 3, "arabic": "اَحْو۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 6, "text": "سَنُقْرِئُكَ فَلَا تَنس۪يٰٓ", "words": [{"id": 1, "arabic": "سَنُقْرِئُكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَنس۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 7, "text": "إِلَّا مَا شَآءَ اَ۬للَّهُۖ إِنَّهُۥ يَعْلَمُ اُ۬لْجَهْرَ وَمَا يَخْف۪يٰۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْجَهْرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَخْف۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 8, "text": "وَنُيَسِّرُكَ لِلْيُسْر۪يٰۖ", "words": [{"id": 1, "arabic": "وَنُيَسِّرُكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلْيُسْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 9, "text": "فَذَكِّرِ اِن نَّفَعَتِ اِ۬لذِّكْر۪يٰۖ", "words": [{"id": 1, "arabic": "فَذَكِّرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِن", "translit": "", "root": ""}, {"id": 3, "arabic": "نَّفَعَتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لذِّكْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 10, "text": "سَيَذَّكَّرُ مَنْ يَّخْش۪يٰ", "words": [{"id": 1, "arabic": "سَيَذَّكَّرُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَّخْش۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 11, "text": "وَيَتَجَنَّبُهَا اَ۬لَاشْقَي", "words": [{"id": 1, "arabic": "وَيَتَجَنَّبُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَاشْقَي", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 12, "text": "اَ۬لذِے يَصْلَي اَ۬لنَّارَ اَ۬لْكُبْر۪يٰ", "words": [{"id": 1, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصْلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لنَّارَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكُبْر۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 13, "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْي۪يٰۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَمُوتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَحْي۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 14, "text": "قَدَ اَفْلَحَ مَن تَزَكّ۪يٰ", "words": [{"id": 1, "arabic": "قَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَفْلَحَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَن", "translit": "", "root": ""}, {"id": 4, "arabic": "تَزَكّ۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 15, "text": "وَذَكَرَ اَ۪سْمَ رَبِّهِۦ فَصَلّ۪يٰۖ", "words": [{"id": 1, "arabic": "وَذَكَرَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪سْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَصَلّ۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 16, "text": "بَلْ تُوثِرُونَ اَ۬لْحَيَوٰةَ اَ۬لدُّنْي۪ا", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تُوثِرُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْحَيَوٰةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لدُّنْي۪ا", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 17, "text": "وَالَاخِرَةُ خَيْرࣱ وَأَبْق۪يٰٓۖ", "words": [{"id": 1, "arabic": "وَالَاخِرَةُ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَبْق۪يٰٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 18, "text": "إِنَّ هَٰذَا لَفِے اِ۬لصُّحُفِ اِ۬لُاول۪يٰ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَفِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لصُّحُفِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لُاول۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 19, "text": "صُحُفِ إِبْرَٰهِيمَ وَمُوس۪يٰۖ", "words": [{"id": 1, "arabic": "صُحُفِ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَمُوس۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}]}