 "root": ""}, {"id": 3, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْجَهْرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَخْف۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 8, "text": "وَنُيَسِّرُكَ لِلْيُسْر۪يٰۖ", "words": [{"id": 1, "arabic": "وَنُيَسِّرُكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلْيُسْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 9, "text": "فَذَكِّرِ اِن نَّفَعَتِ اِ۬لذِّكْر۪يٰۖ", "words": [{"id": 1, "arabic": "فَذَكِّرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِن", "translit": "", "root": ""}, {"id": 3, "arabic": "نَّفَعَتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لذِّكْر۪يٰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 10, "text": "سَيَذَّكَّرُ مَنْ يَّخْش۪يٰ", "words": [{"id": 1, "arabic": "سَيَذَّكَّرُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَّخْش۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 11, "text": "وَيَتَجَنَّبُهَا اَ۬لَاشْقَي", "words": [{"id": 1, "arabic": "وَيَتَجَنَّبُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَاشْقَي", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 12, "text": "اَ۬لذِے يَصْلَي اَ۬لنَّارَ اَ۬لْكُبْر۪يٰ", "words": [{"id": 1, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصْلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لنَّارَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكُبْر۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 87, "ayah": 13, "text": "ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحْ