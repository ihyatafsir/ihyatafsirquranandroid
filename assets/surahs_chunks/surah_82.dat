َحِيمࣲ‏", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْفُجَّارَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَفِے", "translit": "", "root": ""}, {"id": 4, "arabic": "جَحِيمࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 82, "ayah": 15, "text": "يَصْلَوْنَهَا يَوْمَ اَ۬لدِّينِ", "words": [{"id": 1, "arabic": "يَصْلَوْنَهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لدِّينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 82, "ayah": 16, "text": "وَمَا هُمْ عَنْهَا بِغَآئِبِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بِغَآئِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 82, "ayah": 17, "text": "وَمَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَدْر۪يٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لدِّينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 82, "ayah": 18, "text": "ثُمَّ مَآ أَدْر۪يٰكَ مَا يَوْمُ اُ۬لدِّينِۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَدْر۪يٰكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لدِّينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 82, "ayah": 19, "text": "يَوْمَ لَا تَمْلِكُ نَفْسࣱ لِّنَفْسࣲ شَئْاࣰۖ وَالَامْرُ يَوْمَئِذࣲ لِّلهِۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""},