{"surah": 96, "verses": [{"ayah": 1, "text": "ٱقْرَأْ بِٱسْمِ رَبِّكَ ٱلَّذِى خَلَقَ ", "translation": "Recite in the name of your Lord who created –", "words": [{"id": 1, "arabic": "ٱقْرَأْ", "translit": "ْaʾَrْqٱ", "root": "قرا"}, {"id": 2, "arabic": "بِٱسْمِ", "translit": "ِmْsٱِb", "root": "سمو"}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}], "hasIhya": false}, {"ayah": 2, "text": "خَلَقَ ٱلْإِنسَٰنَ مِنْ عَلَقٍ ", "translation": "Created man from a clinging substance.", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 2, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "عَلَقٍ", "translit": "ٍqَlَʿع", "root": "علق"}], "hasIhya": false}, {"ayah": 3, "text": "ٱقْرَأْ وَرَبُّكَ ٱلْأَكْرَمُ ", "translation": "Recite, and your Lord is the most Generous -", "words": [{"id": 1, "arabic": "ٱقْرَأْ", "translit": "ْaʾَrْqٱ", "root": "قرا"}, {"id": 2, "arabic": "وَرَبُّكَ", "translit": "َkُّbَrَw", "root": "ربب"}, {"id": 3, "arabic": "ٱلْأَكْرَمُ", "translit": "ُmَrْkَaʾْlٱ", "root": "كرم"}], "hasIhya": true}, {"ayah": 4, "text": "ٱلَّذِى عَلَّمَ بِٱلْقَلَمِ ", "translation": "Who taught by the pen –", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "عَلَّمَ", "translit": "َmَّlَʿع", "root": "علم"}, {"id": 3, "arabic": "بِٱلْقَلَمِ", "translit": "ِmَlَqْlٱِb", "root": "قلم"}], "hasIhya": true}, {"ayah": 5, "text": "عَلَّمَ ٱلْإِنسَٰنَ مَا لَمْ يَعْلَمْ ", "translation": "Taught man that which he knew not.", "words": [{"id": 1, "arabic": "عَلَّمَ", "translit": "َmَّlَʿع", "root": "علم"}, {"id": 2, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 5, "arabic": "يَعْلَمْ", "translit": "ْmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 6, "text": "كَلَّآ إِنَّ ٱلْإِنسَٰنَ لَيَطْغَىٰٓ ", "translation": "No! [But] indeed, man transgresses", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "لَيَطْغَىٰٓ", "translit": "ٰٓàَغْṭَyَl", "root": "طغي"}], "hasIhya": true}, {"ayah": 7, "text": "أَن رَّءَاهُ ٱسْتَغْنَىٰٓ ", "translation": "Because he sees himself self-sufficient.", "words": [{"id": 1, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 2, "arabic": "رَّءَاهُ", "translit": "ُhāَءَّr", "root": "راي"}, {"id": 3, "arabic": "ٱسْتَغْنَىٰٓ", "translit": "ٰٓàَnْغَtْsٱ", "root": "غني"}], "hasIhya": false}, {"ayah": 8, "text": "إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجْعَىٰٓ ", "translation": "Indeed, to your Lord is the return.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱلرُّجْعَىٰٓ", "translit": "ٰٓàَʿعْjgُّrlٱ", "root": "رجع"}], "hasIhya": false}, {"ayah": 9, "text": "أَرَءَيْتَ ٱلَّذِى يَنْهَىٰ ", "translation": "Have you seen the one who forbids", "words": [{"id": 1, "arabic": "أَرَءَيْتَ", "translit": "َtْyَءَrَaʾ", "root": "راي"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَنْهَىٰ", "translit": "ٰàَhْnَy", "root": "نهي"}], "hasIhya": false}, {"ayah": 10, "text": "عَبْدًا إِذَا صَلَّىٰٓ ", "translation": "A servant when he prays?", "words": [{"id": 1, "arabic": "عَبْدًا", "translit": "āًdْbَʿع", "root": "عبد"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "صَلَّىٰٓ", "translit": "ٰٓàَّlَṣ", "root": "صلو"}], "hasIhya": false}, {"ayah": 11, "text": "أَرَءَيْتَ إِن كَانَ عَلَى ٱلْهُدَىٰٓ ", "translation": "Have you seen if he is upon guidance", "words": [{"id": 1, "arabic": "أَرَءَيْتَ", "translit": "َtْyَءَrَaʾ", "root": "راي"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْهُدَىٰٓ", "translit": "ٰٓàَdُhْlٱ", "root": "هدي"}], "hasIhya": false}, {"ayah": 12, "text": "أَوْ أَمَرَ بِٱلتَّقْوَىٰٓ ", "translation": "Or enjoins righteousness?", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "أَمَرَ", "translit": "َrَmَaʾ", "root": "امر"}, {"id": 3, "arabic": "بِٱلتَّقْوَىٰٓ", "translit": "ٰٓàَwْqَّtlٱِb", "root": "وقي"}], "hasIhya": false}, {"ayah": 13, "text": "أَرَءَيْتَ إِن كَذَّبَ وَتَوَلَّىٰٓ ", "translation": "Have you seen if he denies and turns away -", "words": [{"id": 1, "arabic": "أَرَءَيْتَ", "translit": "َtْyَءَrَaʾ", "root": "راي"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 4, "arabic": "وَتَوَلَّىٰٓ", "translit": "ٰٓàَّlَwَtَw", "root": "ولي"}], "hasIhya": false}, {"ayah": 14, "text": "أَلَمْ يَعْلَم بِأَنَّ ٱللَّهَ يَرَىٰ ", "translation": "Does he not know that Allāh sees?", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَعْلَم", "translit": "mَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "بِأَنَّ", "translit": "َّnَaʾِb", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "يَرَىٰ", "translit": "ٰàَrَy", "root": "راي"}], "hasIhya": true}, {"ayah": 15, "text": "كَلَّا لَئِن لَّمْ يَنتَهِ لَنَسْفَعًۢا بِٱلنَّاصِيَةِ ", "translation": "No! If he does not desist, We will surely drag him by the forelock[1] –", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "āَّlَk", "root": ""}, {"id": 2, "arabic": "لَئِن", "translit": "nِyʾَl", "root": ""}, {"id": 3, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 4, "arabic": "يَنتَهِ", "translit": "ِhَtnَy", "root": "نهي"}, {"id": 5, "arabic": "لَنَسْفَعًۢا", "translit": "āًۢʿعَfْsَnَl", "root": "سفع"}, {"id": 6, "arabic": "بِٱلنَّاصِيَةِ", "translit": "ِẗَyِṣāَّnlٱِb", "root": "نصي"}], "hasIhya": false}, {"ayah": 16, "text": "نَاصِيَةٍ كَٰذِبَةٍ خَاطِئَةٍ ", "translation": "A lying, sinning forelock.", "words": [{"id": 1, "arabic": "نَاصِيَةٍ", "translit": "ٍẗَyِṣāَn", "root": "نصي"}, {"id": 2, "arabic": "كَٰذِبَةٍ", "translit": "ٍẗَbِhdَٰk", "root": "كذب"}, {"id": 3, "arabic": "خَاطِئَةٍ", "translit": "ٍẗَyʾِṭāَhk", "root": "خطا"}], "hasIhya": false}, {"ayah": 17, "text": "فَلْيَدْعُ نَادِيَهُۥ ", "translation": "Then let him call his associates;", "words": [{"id": 1, "arabic": "فَلْيَدْعُ", "translit": "ُʿعْdَyْlَf", "root": "دعو"}, {"id": 2, "arabic": "نَادِيَهُۥ", "translit": "ۥُhَyِdāَn", "root": "ندي"}], "hasIhya": false}, {"ayah": 18, "text": "سَنَدْعُ ٱلزَّبَانِيَةَ ", "translation": "We will call the angels of Hell.[1]", "words": [{"id": 1, "arabic": "سَنَدْعُ", "translit": "ُʿعْdَnَs", "root": "دعو"}, {"id": 2, "arabic": "ٱلزَّبَانِيَةَ", "translit": "َẗَyِnāَbَّzlٱ", "root": "زبن"}], "hasIhya": false}, {"ayah": 19, "text": "كَلَّا لَا تُطِعْهُ وَٱسْجُدْ وَٱقْتَرِب۩ ", "translation": "No! Do not obey him. But prostrate and draw near [to Allāh].", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "āَّlَk", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تُطِعْهُ", "translit": "ُhْʿعِṭُt", "root": "طوع"}, {"id": 4, "arabic": "وَٱسْجُدْ", "translit": "ْdُjgْsٱَw", "root": "سجد"}, {"id": 5, "arabic": "وَٱقْتَرِب", "translit": "bِrَtْqٱَw", "root": "قرب"}], "hasIhya": false}], "tafsir": {"4": [{"arabic": "لحصول نقش العلوم في قلوب البشر قال الله تعالى {الذي علم بالقلم علم الإنسان ما لم يعلم} وقلم الله تعالى لا يشبه قلم خلقه كما لا يشبه وصفه وصف خلقه فليس قلمه من قصب ولا خشب كما أنه تعالى ليس من جوهر ولا عرض فالموازنة بين البصيرة الباطنة والبصر الظاهر صحيحة من هذه الوجوه إلا أنه لا مناسبة بينهما في الشرف فإن البصيرة الباطنة هي عين النفس التي هي اللطيفة المدركة وهي كالفارس والبدن كالفرس وعمى الفارس أضر على الفارس من عمى الفرس بل لا نسبة لأحد الضررين إلى الآخر ولموازنة البصيرة الباطنة للبصر الظاهر سماه الله تعالى باسمه فقال {ما كذب", "english": "And the washing of the eye is forbidden. The first [meaning of intellect] is what is intended by his saying — peace and blessings be upon him — to ʿAlī: \"God created no creature more noble before Him than the intellect.\" The second is what is intended by his saying — peace and blessings be upon him — to ʿAlī, may God be well pleased with him: \"When people draw near to God — exalted be He — through various kinds of righteousness, draw near you through your intellect.\" For it is not possible to draw near through innate instinct (al-gharīzah al-fiṭriyyah) nor through necessary sciences (al-ʿulūm al-ḍarūriyyah), but rather through acquired sciences (al-muktasabah). Yet the likes of ʿAlī — may God be well pleased with him — is one who is able to draw near through the use of the intellect in hunting out the sciences by which nearness to the Lord of the Worlds is attained.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 587", "section_title_en": "The Washing of the Eye is Forbidden — The Rational and Religious Sciences Compared", "section_index": 587, "anchors": "- Root: عقل (ʿaql)\n  * Lisan / Ayn: Core meaning of binding, restraining, and holding back — the intellect as that which restrains the soul from base desires and grasps realities.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — the intellect is the power prepared for receiving knowledge, and the knowledge acquired through that power is also called ʿaql.\n  * Al-Zamakhshari (Asas): Literal sense of binding and holding; metaphorical extension to the rational faculty that restrains and perceives consequences (al-ʿawāqib).\n- Root: بصر (baṣar)\n  * Lisan / Ayn: Sight, vision; the faculty of the eye.\n  * Al-Raghib (Mufradat): \"البصر يقال للجارحة الناظرة... ويقال لقوة القلب المدركة: بصيرة وبصر\" — baṣar applies to the seeing organ and to the heart's perceiving power (baṣīrah).\n  * Al-Zamakhshari (Asas): Literal — \"أبصر الشيء\" to see something; Metaphorical — \"هذه آية مبصرة\" a clarifying sign; \"أعمى القلب\" blindness of the heart as spiritual blindness.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; that which turns and fluctuates.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as the seat of understanding that turns between states.\n  * Al-Zamakhshari (Asas): Literal — the physical organ; Metaphorical — \"قلب المعلم الصبيان\" the teacher turns the boys [to their homes], i.e., directs them; the heart as the center of rational perception.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge, perception of a thing as it truly is.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; two types: apprehension of the essence, and judgment upon a thing.\n  * Al-Zamakhshari (Asas): \"ما علمت بخبرك: ما شعرت به\" — to know is to perceive; \"معالم الطريق\" — the landmarks by which the path is known.\n- Sibawayh Rule: باب التشبيه والتمثيل (The Chapter of Similitude and Analogy) — the balanced comparison (al-muwāzanah) between two domains using parallel grammatical structures (ka-... ka-...) to establish proportional equivalence while preserving distinction.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Disciplining the Soul'", "badge": "Hadith"}], "5": [{"arabic": "لحصول نقش العلوم في قلوب البشر قال الله تعالى {الذي علم بالقلم علم الإنسان ما لم يعلم} وقلم الله تعالى لا يشبه قلم خلقه كما لا يشبه وصفه وصف خلقه فليس قلمه من قصب ولا خشب كما أنه تعالى ليس من جوهر ولا عرض فالموازنة بين البصيرة الباطنة والبصر الظاهر صحيحة من هذه الوجوه إلا أنه لا مناسبة بينهما في الشرف فإن البصيرة الباطنة هي عين النفس التي هي اللطيفة المدركة وهي كالفارس والبدن كالفرس وعمى الفارس أضر على الفارس من عمى الفرس بل لا نسبة لأحد الضررين إلى الآخر ولموازنة البصيرة الباطنة للبصر الظاهر سماه الله تعالى باسمه فقال {ما كذب", "english": "And the washing of the eye is forbidden. The first [meaning of intellect] is what is intended by his saying — peace and blessings be upon him — to ʿAlī: \"God created no creature more noble before Him than the intellect.\" The second is what is intended by his saying — peace and blessings be upon him — to ʿAlī, may God be well pleased with him: \"When people draw near to God — exalted be He — through various kinds of righteousness, draw near you through your intellect.\" For it is not possible to draw near through innate instinct (al-gharīzah al-fiṭriyyah) nor through necessary sciences (al-ʿulūm al-ḍarūriyyah), but rather through acquired sciences (al-muktasabah). Yet the likes of ʿAlī — may God be well pleased with him — is one who is able to draw near through the use of the intellect in hunting out the sciences by which nearness to the Lord of the Worlds is attained.", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 587", "section_title_en": "The Washing of the Eye is Forbidden — The Rational and Religious Sciences Compared", "section_index": 587, "anchors": "- Root: عقل (ʿaql)\n  * Lisan / Ayn: Core meaning of binding, restraining, and holding back — the intellect as that which restrains the soul from base desires and grasps realities.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — the intellect is the power prepared for receiving knowledge, and the knowledge acquired through that power is also called ʿaql.\n  * Al-Zamakhshari (Asas): Literal sense of binding and holding; metaphorical extension to the rational faculty that restrains and perceives consequences (al-ʿawāqib).\n- Root: بصر (baṣar)\n  * Lisan / Ayn: Sight, vision; the faculty of the eye.\n  * Al-Raghib (Mufradat): \"البصر يقال للجارحة الناظرة... ويقال لقوة القلب المدركة: بصيرة وبصر\" — baṣar applies to the seeing organ and to the heart's perceiving power (baṣīrah).\n  * Al-Zamakhshari (Asas): Literal — \"أبصر الشيء\" to see something; Metaphorical — \"هذه آية مبصرة\" a clarifying sign; \"أعمى القلب\" blindness of the heart as spiritual blindness.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; that which turns and fluctuates.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as the seat of understanding that turns between states.\n  * Al-Zamakhshari (Asas): Literal — the physical organ; Metaphorical — \"قلب المعلم الصبيان\" the teacher turns the boys [to their homes], i.e., directs them; the heart as the center of rational perception.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge, perception of a thing as it truly is.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; two types: apprehension of the essence, and judgment upon a thing.\n  * Al-Zamakhshari (Asas): \"ما علمت بخبرك: ما شعرت به\" — to know is to perceive; \"معالم الطريق\" — the landmarks by which the path is known.\n- Sibawayh Rule: باب التشبيه والتمثيل (The Chapter of Similitude and Analogy) — the balanced comparison (al-muwāzanah) between two domains using parallel grammatical structures (ka-... ka-...) to establish proportional equivalence while preserving distinction.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Monotheism and Reliance'", "badge": "Hadith"}], "6": [{"arabic": "كلا إن الإنسان ليطغى أن رآه استغنى وقال صلى الله عليه وسلم إن الله ليحمي عبده المؤمن من الدنيا وهو يحبه كما يحمي أحدكم مريضه (1) وكذلك الزوجة والولد والقريب وكل ما ذكرناه في الأقسام الستة عشر من النعم سوى الإيمان وحسن الخلق فإنها يتصور أن تكون بلاء في حق بعض الناس فتكون أضدادها إذن نعما في حقهم إذ سبق أن المعرفة كمال ونعمة فإنها صفة من صفات الله تعالى ولكن قد تكون على العبد في بعض الأمور بلاء ويكون فقدها نعمة مثاله جهل الإنسان بأجله فإنه نعمة عليه إذ لو عرفه ربما تنغص عليه العيش و", "english": "You might say: \"What you have mentioned concerning graces (niʿam) indicates that for God most high there is in every existing thing a grace — and this suggests that trial (balā') has no existence at all. So what then is the meaning of patience (ṣabr)? And if trial does exist, then what is the meaning of gratitude (shukr) for trial? For some claimants have asserted that we give thanks for trial, let alone for grace. So how is gratitude for trial conceivable? And how does one give thanks for that which one endures with patience? For patience in trial demands pain, while gratitude demands joy, and the two are mutually opposed. And what is the meaning of what you have mentioned — that for God most high there is in everything He has brought into existence a grace upon His servants?\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 1018", "section_title_en": "On the Reconciliation of Patience and Gratitude in the Face of Trial — Section 1018", "section_index": 1018, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core sense of softness, ease, and well-being; al-Farahidi notes it as a name for the leopard and tiger, indicating inherent vigor in the state of grace.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — the goodly state; divided into absolute (mutlaqah) and restricted (muqayyadah), the former being felicity in the Hereafter (nearness to God) and faith in this world.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the actual state of well-being; metaphorical (Majaz) extension applies to any beneficial circumstance, even apparent hardship, when considered relative to the recipient's ultimate good.\n- Root: بلي (b-l-w)\n  * Lisan / Ayn: Testing, affliction, and wear of the body; the root implies a state of being tried or proven.\n  * Al-Raghib (Mufradat): Trial (balā') is that which tests one's state; its existence is affirmed alongside grace (niʿmah) as its contrary, for the absence of grace is a trial and the absence of trial is a grace.\n  * Al-Zamakhshari (Asas): Literal sense is calamity or hardship; metaphorical sense applies to any condition that, while painful in one respect, may be a vehicle for divine benefit in another.\n- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Restraint and forbearance; al-Farahidi ties it to holding back the self from complaint.\n  * Al-Raghib (Mufradat): Patience is the withholding of the soul from agitation and complaint; it is only commanded where the trial cannot be repelled by the servant's own effort.\n  * Al-Zamakhshari (Asas): Literal usage is enduring pain; metaphorical usage extends to steadfastness in obedience and abstention from sin, which are acts of patience toward the soul's base inclinations.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: Gratitude as acknowledgment of benefit; al-Farahidi links it to fullness, as a full udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — gratitude is the conception of the grace and its manifestation; it is threefold: of the heart (perceiving the grace), of the tongue (praising the Benefactor), and of the limbs (rewarding the grace through obedience).\n  * Al-Zamakhshari (Asas): Literal sense is verbal and inward acknowledgment; metaphorical sense is the \"grateful beast\" (dābbah shakūr) that thrives on little fodder — so the servant thrives on little trial, seeing in it abundant divine favor.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the scope of patience and gratitude: patience is restricted to unavoidable pain, while gratitude is focused on the relative good within that pain, preventing the logical contradiction of their simultaneous application.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "إلى الله عز وجل ويمنع من نسيانه وأما الغنى فسبب للبطر في غالب الأمور فإن الإنسان ليطغى أن رآه استغنى فهذا ما أردنا أن نورده من جملة الأذكار والدعوات والله الموفق للخير وأما بقية الدعوات في الأكل والسفر وعيادة المريض وغيرها فستأتي في مواضعها إن شاء الله تعالى وعلى الله التكلان نجز كتاب الأذكار والدعوات بكماله يتلوه إن شاء الله تعالى كتاب الأوراد والحمد لله رب العالمين وصلى الله على سيدنا محمد وعلى آله وصحبه وسلم", "english": "\"O God, whatever blessing has come to me this morning, or to any of Your creatures, it is from You alone, with no partner to You; to You is praise and to You is thanksgiving.\"", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 255", "section_title_en": "Section 255", "section_index": 255, "anchors": "*(Anchors established)*", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Monotheism and Reliance'", "badge": "Dhikr"}], "14": [{"arabic": "يراك (2) وقد قال تعالى أفمن هو قائم على كل نفس بما كسبت وقال تعالى ألم يعلم بأن الله يرى وقال الله تعالى إن الله كان عليكم رقيبا وقال تعالى والذين هم لأماناتهم وعهدهم راعون والذين هم بشهاداتهم قائمون وقال ابن المبارك لرجل راقب الله تعالى فسأله عن تفسيره فقال كن أبدا كأنك ترى الله عز وجل وقال عبد الواحد بن زيد إذا كان سيدي رقيبا على فلا أبالى بغيره وقال أبو عثمان المغربي أفضل ما يلزم الإنسان نفسه في هذه الطريقة المحاسبة والمراقبة وسياسة عمله بالعلم وقال ابن عطاء أفضل الطاعات مراقبة الحق على دوام الأوقات وقال الجريري أمرنا", "english": "As for its excellence: Gabriel, peace be upon him, asked about iḥsān (perfection of worship), and he, peace be upon him, replied: \"That you worship Allah as though you see Him.\" {«أن تعبد الله كأنك تراه»} And he, peace be upon him, also said: \"Worship Allah as though you see Him; for if you do not see Him, verily He sees you.\" {«اعبد الله كأنك تراه فإن لم تكن تراه فإنه يراك»} And Allah, Exalted is He, has said: {«أفمن هو قائم على كل نفس بما كسبت»} — \"Is He who stands over every soul with what it has earned [like any other]?\" And He said: {«ألم يعلم بأن الله يرى»} — \"Does he not know that Allah sees?\" And Allah, Exalted is He, said: {«إن الله كان عليكم رقيبا»} — \"Verily, Allah is ever a Watcher (raqīb) over you.\" And He said: {«والذين هم لأماناتهم وعهدهم راعون والذين هم بشهاداتهم قائمون»} — \"And those who are keepers of their trusts and their covenant, and those who stand firm in their testimonies.\"", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1233", "section_title_en": "The Second Station of Vigilance: Murāqabah (Spiritual Watchfulness)", "section_index": 1233, "anchors": "- Root: رقب (R-Q-B)\n  * Lisan / Ayn: To watch, guard, observe attentively; the neck (as that which turns to observe); a lookout post.\n  * Al-Raghib (Mufradat): Murāqabah entails the heart's persistent awareness of divine proximity; it is the theological state wherein the servant knows Allah is witness over his secret and public acts.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): physical watching/awaiting. Majaz (metaphorical): \"This matter is upon your necks\" (في رقابكم) — i.e., an inescapable obligation; likewise, murāqabah of Allah is the soul's standing under the watchful eye of the King, a transferred sense denoting reverent vigilance.\n- Sibawayh Rule: Restriction & Focused Predication (باب الحصر والتقييد) — governing the conditional structures \"إذا... فلا يبقى إلا...\" and \"إنها إن تركت طغت وفسدت,\" where the apodosis is restricted to a single remaining duty.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 260, 1375], [2, 1375, 2311], [3, 2311, 3328], [4, 3328, 4630], [5, 4630, 5540]], "96:1": [[1, 260, 1375], [2, 1375, 2311], [3, 2311, 3328], [4, 3328, 4630], [5, 4630, 5540]], "2": [[1, 190, 1267], [2, 1267, 3367], [3, 3367, 4010], [4, 4010, 5120]], "96:2": [[1, 190, 1267], [2, 1267, 3367], [3, 3367, 4010], [4, 4010, 5120]], "3": [[1, 200, 1333], [2, 1333, 3029], [3, 3029, 4560]], "96:3": [[1, 200, 1333], [2, 1333, 3029], [3, 3029, 4560]], "4": [[1, 270, 1648], [2, 1648, 2796], [3, 2796, 4390]], "96:4": [[1, 270, 1648], [2, 1648, 2796], [3, 2796, 4390]], "5": [[1, 120, 1266], [2, 1266, 3137], [3, 3137, 4197], [4, 4197, 4770], [5, 4770, 6390]], "96:5": [[1, 120, 1266], [2, 1266, 3137], [3, 3137, 4197], [4, 4197, 4770], [5, 4770, 6390]], "6": [[1, 310, 2947], [2, 2947, 3773], [3, 3773, 5360], [4, 5360, 8610]], "96:6": [[1, 310, 2947], [2, 2947, 3773], [3, 3773, 5360], [4, 5360, 8610]], "7": [[1, 30, 438], [2, 438, 1579], [3, 1579, 3770]], "96:7": [[1, 30, 438], [2, 438, 1579], [3, 1579, 3770]], "8": [[1, 10, 790], [2, 790, 1955], [3, 1955, 2815], [4, 2815, 5760]], "96:8": [[1, 10, 790], [2, 790, 1955], [3, 1955, 2815], [4, 2815, 5760]], "9": [[1, 10, 1343], [2, 1343, 2486], [3, 2486, 4500]], "96:9": [[1, 10, 1343], [2, 1343, 2486], [3, 2486, 4500]], "10": [[1, 20, 1194], [2, 1194, 2133], [3, 2133, 4050]], "96:10": [[1, 20, 1194], [2, 1194, 2133], [3, 2133, 4050]], "11": [[1, 20, 1242], [2, 1242, 1722], [3, 1722, 2748], [4, 2748, 3588], [5, 3588, 5870]], "96:11": [[1, 20, 1242], [2, 1242, 1722], [3, 1722, 2748], [4, 2748, 3588], [5, 3588, 5870]], "12": [[1, 10, 522], [2, 522, 1108], [3, 1108, 3900]], "96:12": [[1, 10, 522], [2, 522, 1108], [3, 1108, 3900]], "13": [[1, 200, 1480], [2, 1480, 1983], [3, 1983, 2880], [4, 2880, 6250]], "96:13": [[1, 200, 1480], [2, 1480, 1983], [3, 1983, 2880], [4, 2880, 6250]], "14": [[1, 30, 890], [2, 890, 2409], [3, 2409, 3592], [4, 3592, 4667], [5, 4667, 6700]], "96:14": [[1, 30, 890], [2, 890, 2409], [3, 2409, 3592], [4, 3592, 4667], [5, 4667, 6700]], "15": [[1, 10, 1559]