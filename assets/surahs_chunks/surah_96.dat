xt": "عَلَّمَ اَ۬لِانسَٰنَ مَا لَمْ يَعْلَمْۖ", "words": [{"id": 1, "arabic": "عَلَّمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لِانسَٰنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَعْلَمْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 96, "ayah": 6, "text": "كَلَّآ إِنَّ اَ۬لِانسَٰنَ لَيَطْغ۪يٰٓ", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لِانسَٰنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَيَطْغ۪يٰٓ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 96, "ayah": 7, "text": "أَن رّ۪ء۪اهُ اُ۪سْتَغْن۪يٰٓۖ", "words": [{"id": 1, "arabic": "أَن", "translit": "", "root": ""}, {"id": 2, "arabic": "رّ۪ء۪اهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۪سْتَغْن۪يٰٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 96, "ayah": 8, "text": "إِنَّ إِلَيٰ رَبِّكَ اَ۬لرُّجْع۪يٰٓۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لرُّجْع۪يٰٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 96, "ayah": 9, "text": "أَرَٰٓيْتَ اَ۬لذِے يَنْه۪يٰ", "words": [{"id": 1, "arabic": "أَرَٰٓيْتَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "يَنْه۪يٰ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 96, "ayah": 10, "text": "عَبْداً اِذَا صَلّ۪يٰٓۖ", "words": [{"id": 1, "arabic": "عَبْداً", "translit": "", "root": ""}, {"id": 2, "arabic": "اِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "صَلّ۪يٰٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 96, "ayah": 11, "text": "أَرَٰٓيْتَ إِن كَانَ ع