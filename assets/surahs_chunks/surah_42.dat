{"surah":42,"verses":[{"ayah":1,"text":"حمٓ ","translation":"Ḥā, Meem.","words":[{"id":1,"arabic":"حمٓ","translit":"ٓmḥ","root":""}],"hasIhya":false},{"ayah":2,"text":"عٓسٓقٓ ","translation":"ʿAyn, Seen, Qāf.[1]","words":[{"id":1,"arabic":"عٓسٓقٓ","translit":"ٓqٓsٓʿع","root":""}],"hasIhya":false},{"ayah":3,"text":"كَذَٰلِكَ يُوحِىٓ إِلَيْكَ وَإِلَى ٱلَّذِينَ مِن قَبْلِكَ ٱللَّهُ ٱلْعَزِيزُ ٱلْحَكِيمُ ","translation":"Thus has He revealed to you, [O Muḥammad], and to those before you - Allāh, the Exalted in Might, the Wise.","words":[{"id":1,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":2,"arabic":"يُوحِىٓ","translit":"ٓàِḥwُy","root":"وحي"},{"id":3,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":4,"arabic":"وَإِلَى","translit":"àَlِiʾَw","root":""},{"id":5,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":10,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"}],"hasIhya":false},{"ayah":4,"text":"لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۖ وَهُوَ ٱلْعَلِىُّ ٱلْعَظِيمُ ","translation":"To Him belongs whatever is in the heavens and whatever is in the earth, and He is the Most High, the Most Great.[1]","words":[{"id":1,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":8,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":9,"arabic":"ٱلْعَلِىُّ","translit":"ُّàِlَʿعْlٱ","root":"علو"},{"id":10,"arabic":"ٱلْعَظِيمُ","translit":"ُmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":false},{"ayah":5,"text":"تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرْنَ مِن فَوْقِهِنَّۚ وَٱلْمَلَٰٓئِكَةُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيَسْتَغْفِرُونَ لِمَن فِى ٱلْأَرْضِۗ أَلَآ إِنَّ ٱللَّهَ هُوَ ٱلْغَفُورُ ٱلرَّحِيمُ ","translation":"The heavens almost break from above them,[1] and the angels exalt [Allāh] with praise of their Lord and ask forgiveness for those on earth. Unquestionably, it is Allāh who is the Forgiving, the Merciful.","words":[{"id":1,"arabic":"تَكَادُ","translit":"ُdāَkَt","root":"كود"},{"id":2,"arabic":"ٱلسَّمَٰوَٰتُ","translit":"ُtَٰwَٰmَّslٱ","root":"سمو"},{"id":3,"arabic":"يَتَفَطَّرْنَ","translit":"َnْrَّṭَfَtَy","root":"فطر"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"فَوْقِهِنَّ","translit":"َّnِhِqْwَf","root":"فوق"},{"id":6,"arabic":"وَٱلْمَلَٰٓئِكَةُ","translit":"ُẗَkِyʾَٰٓlَmْlٱَw","root":"ملك"},{"id":7,"arabic":"يُسَبِّحُونَ","translit":"َnwُḥِّbَsُy","root":"سبح"},{"id":8,"arabic":"بِحَمْدِ","translit":"ِdْmَḥِb","root":"حمد"},{"id":9,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":10,"arabic":"وَيَسْتَغْفِرُونَ","translit":"َnwُrِfْغَtْsَyَw","root":"غفر"},{"id":11,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":14,"arabic":"أَلَآ","translit":"ٓāَlَaʾ","root":""},{"id":15,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":16,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":17,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":18,"arabic":"ٱلْغَفُورُ","translit":"ُrwُfَغْlٱ","root":"غفر"},{"id":19,"arabic":"ٱلرَّحِيمُ","translit":"ُmyِḥَّrlٱ","root":"رحم"}],"hasIhya":true},{"ayah":6,"text":"وَٱلَّذِينَ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَ ٱللَّهُ حَفِيظٌ عَلَيْهِمْ وَمَآ أَنتَ عَلَيْهِم بِوَكِيلٍ ","translation":"And those who take as allies other than Him - Allāh is [yet] Guardian over them; and you, [O Muḥammad], are not over them a manager -","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"ٱتَّخَذُوا۟","translit":"۟āwُhdَhkَّtٱ","root":"اخذ"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"دُونِهِۦٓ","translit":"ٓۦِhِnwُd","root":"دون"},{"id":5,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"حَفِيظٌ","translit":"ٌẓyِfَḥ","root":"حفظ"},{"id":8,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":9,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":10,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":11,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":12,"arabic":"بِوَكِيلٍ","translit":"ٍlyِkَwِb","root":"وكل"}],"hasIhya":false},{"ayah":7,"text":"وَكَذَٰلِكَ أَوْحَيْنَآ إِلَيْكَ قُرْءَانًا عَرَبِيًّا لِّتُنذِرَ أُمَّ ٱلْقُرَىٰ وَمَنْ حَوْلَهَا وَتُنذِرَ يَوْمَ ٱلْجَمْعِ لَا رَيْبَ فِيهِۚ فَرِيقٌ فِى ٱلْجَنَّةِ وَفَرِيقٌ فِى ٱلسَّعِيرِ ","translation":"And thus We have revealed to you an Arabic Qur’ān that you may warn the Mother of Cities [i.e., Makkah] and those around it[1] and warn of the Day of Assembly, about which there is no doubt. A party will be in Paradise and a party in the Blaze.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"أَوْحَيْنَآ","translit":"ٓāَnْyَḥْwَaʾ","root":"وحي"},{"id":3,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":4,"arabic":"قُرْءَانًا","translit":"āًnāَءْrُq","root":"قرا"},{"id":5,"arabic":"عَرَبِيًّا","translit":"āًّyِbَrَʿع","root":"عرب"},{"id":6,"arabic":"لِّتُنذِرَ","translit":"َrِhdnُtِّl","root":"نذر"},{"id":7,"arabic":"أُمَّ","translit":"َّmُaʾ","root":"امم"},{"id":8,"arabic":"ٱلْقُرَىٰ","translit":"ٰàَrُqْlٱ","root":"قري"},{"id":9,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":10,"arabic":"حَوْلَهَا","translit":"āَhَlْwَḥ","root":"حول"},{"id":11,"arabic":"وَتُنذِرَ","translit":"َrِhdnُtَw","root":"نذر"},{"id":12,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":13,"arabic":"ٱلْجَمْعِ","translit":"ِʿعْmَjgْlٱ","root":"جمع"},{"id":14,"arabic":"لَا","translit":"āَl","root":""},{"id":15,"arabic":"رَيْبَ","translit":"َbْyَr","root":"ريب"},{"id":16,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":17,"arabic":"فَرِيقٌ","translit":"ٌqyِrَf","root":"فرق"},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ٱلْجَنَّةِ","translit":"ِẗَّnَjgْlٱ","root":"جنن"},{"id":20,"arabic":"وَفَرِيقٌ","translit":"ٌqyِrَfَw","root":"فرق"},{"id":21,"arabic":"فِى","translit":"àِf","root":""},{"id":22,"arabic":"ٱلسَّعِيرِ","translit":"ِryِʿعَّslٱ","root":"سعر"}],"hasIhya":false},{"ayah":8,"text":"وَلَوْ شَآءَ ٱللَّهُ لَجَعَلَهُمْ أُمَّةً وَٰحِدَةً وَلَٰكِن يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦۚ وَٱلظَّٰلِمُونَ مَا لَهُم مِّن وَلِىٍّ وَلَا نَصِيرٍ ","translation":"And if Allāh willed, He could have made them [of] one religion, but He admits whom He wills[1] into His mercy. And the wrongdoers have not any protector or helper.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"لَجَعَلَهُمْ","translit":"ْmُhَlَʿعَjgَl","root":"جعل"},{"id":5,"arabic":"أُمَّةً","translit":"ًẗَّmُaʾ","root":"امم"},{"id":6,"arabic":"وَٰحِدَةً","translit":"ًẗَdِḥَٰw","root":"وحد"},{"id":7,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":8,"arabic":"يُدْخِلُ","translit":"ُlِhkْdُy","root":"دخل"},{"id":9,"arabic":"مَن","translit":"nَm","root":""},{"id":10,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"رَحْمَتِهِۦ","translit":"ۦِhِtَmْḥَr","root":"رحم"},{"id":13,"arabic":"وَٱلظَّٰلِمُونَ","translit":"َnwُmِlَّٰẓlٱَw","root":"ظلم"},{"id":14,"arabic":"مَا","translit":"āَm","root":""},{"id":15,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":16,"arabic":"مِّن","translit":"nِّm","root":""},{"id":17,"arabic":"وَلِىٍّ","translit":"ٍّàِlَw","root":"ولي"},{"id":18,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":19,"arabic":"نَصِيرٍ","translit":"ٍryِṣَn","root":"نصر"}],"hasIhya":false},{"ayah":9,"text":"أَمِ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَۖ فَٱللَّهُ هُوَ ٱلْوَلِىُّ وَهُوَ يُحْىِ ٱلْمَوْتَىٰ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ","translation":"Or have they taken protectors [or allies] besides Him? But Allāh - He is the Protector, and He gives life to the dead, and He is over all things competent.","words":[{"id":1,"arabic":"أَمِ","translit":"ِmَaʾ","root":""},{"id":2,"arabic":"ٱتَّخَذُوا۟","translit":"۟āwُhdَhkَّtٱ","root":"اخذ"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"دُونِهِۦٓ","translit":"ٓۦِhِnwُd","root":"دون"},{"id":5,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":6,"arabic":"فَٱللَّهُ","translit":"ُhَّllٱَf","root":"اله"},{"id":7,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":8,"arabic":"ٱلْوَلِىُّ","translit":"ُّàِlَwْlٱ","root":"ولي"},{"id":9,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":10,"arabic":"يُحْىِ","translit":"ِàْḥُy","root":"حيي"},{"id":11,"arabic":"ٱلْمَوْتَىٰ","translit":"ٰàَtْwَmْlٱ","root":"موت"},{"id":12,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":13,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":14,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":15,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":16,"arabic":"قَدِيرٌ","translit":"ٌryِdَq","root":"قدر"}],"hasIhya":true},{"ayah":10,"text":"وَمَا ٱخْتَلَفْتُمْ فِيهِ مِن شَىْءٍ فَحُكْمُهُۥٓ إِلَى ٱللَّهِۚ ذَٰلِكُمُ ٱللَّهُ رَبِّى عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ ","translation":"And in anything over which you disagree - its ruling is [to be referred] to Allāh. [Say], \"That is Allāh, my Lord; upon Him I have relied, and to Him I turn back.\"[1]","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"ٱخْتَلَفْتُمْ","translit":"ْmُtْfَlَtْhkٱ","root":"خلف"},{"id":3,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":6,"arabic":"فَحُكْمُهُۥٓ","translit":"ٓۥُhُmْkُḥَf","root":"حكم"},{"id":7,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"ذَٰلِكُمُ","translit":"ُmُkِlَٰhd","root":""},{"id":10,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":11,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":12,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":13,"arabic":"تَوَكَّلْتُ","translit":"ُtْlَّkَwَt","root":"وكل"},{"id":14,"arabic":"وَإِلَيْهِ","translit":"ِhْyَlِiʾَw","root":""},{"id":15,"arabic":"أُنِيبُ","translit":"ُbyِnُaʾ","root":"نوب"}],"hasIhya":false},{"ayah":11,"text":"فَاطِرُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ جَعَلَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا وَمِنَ ٱلْأَنْعَٰمِ أَزْوَٰجًاۖ يَذْرَؤُكُمْ فِيهِۚ لَيْسَ كَمِثْلِهِۦ شَىْءٌۖ وَهُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ ","translation":"[He is] Creator of the heavens and the earth. He has made for you from yourselves, mates, and among the cattle, mates; He multiplies you thereby. There is nothing like unto Him,[1] and He is the Hearing, the Seeing.[2]","words":[{"id":1,"arabic":"فَاطِرُ","translit":"ُrِṭāَf","root":"فطر"},{"id":2,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":3,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":4,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":5,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":6,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":7,"arabic":"أَنفُسِكُمْ","translit":"ْmُkِsُfnَaʾ","root":"نفس"},{"id":8,"arabic":"أَزْوَٰجًا","translit":"āًjgَٰwْzَaʾ","root":"زوج"},{"id":9,"arabic":"وَمِنَ","translit":"َnِmَw","root":""},{"id":10,"arabic":"ٱلْأَنْعَٰمِ","translit":"ِmَٰʿعْnَaʾْ