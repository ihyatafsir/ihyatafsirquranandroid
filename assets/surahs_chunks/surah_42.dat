ourse as you are commanded and do not follow their inclinations but say, \"I have believed in what Allāh has revealed of scripture [i.e., the Qur’ān], and I have been commanded to do justice among you. Allāh is our Lord and your Lord. For us are our deeds, and for you your deeds.[2] There is no [need for] argument between us and you.[3] Allāh will bring us together, and to Him is the [final] destination.\"","words":[{"id":1,"arabic":"فَلِذَٰلِكَ","translit":"َkِlَٰhdِlَf","root":""},{"id":2,"arabic":"فَٱدْعُ","translit":"ُʿعْdٱَf","root":"دعو"},{"id":3,"arabic":"وَٱسْتَقِمْ","translit":"ْmِqَtْsٱَw","root":"قوم"},{"id":4,"arabic":"كَمَآ","translit":"ٓāَmَk","root":""},{"id":5,"arabic":"أُمِرْتَ","translit":"َtْrِmُaʾ","root":"امر"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"تَتَّبِعْ","translit":"ْʿعِbَّtَt","root":"تبع"},{"id":8,"arabic":"أَهْوَآءَهُمْ","translit":"ْmُhَءٓāَwْhَaʾ","root":"هوي"},{"id":9,"arabic":"وَقُلْ","translit":"ْlُqَw","root":"قول"},{"id":10,"arabic":"ءَامَنتُ","translit":"ُtnَmāَء","root":"امن"},{"id":11,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":12,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"مِن","translit":"nِm","root":""},{"id":15,"arabic":"كِتَٰبٍ","translit":"ٍbَٰtِk","root":"كتب"},{"id":16,"arabic":"وَأُمِرْتُ","translit":"ُtْrِmُaʾَw","root":"امر"},{"id":17,"arabic":"لِأَعْدِلَ","translit":"َlِdْʿعَaʾِl","root":"عدل"},{"id":18,"arabic":"بَيْنَكُمُ","translit":"ُmُkَnْyَb","root":"بين"},{"id":19,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":20,"arabic":"رَبُّنَا","translit":"āَnُّbَr","root":"ربب"},{"id":21,"arabic":"وَرَبُّكُمْ","translit":"ْmُkُّbَrَw","root":"ربب"},{"id":22,"arabic":"لَنَآ","translit":"ٓāَnَl","root":""},{"id":23,"arabic":"أَعْمَٰلُنَا","translit":"āَnُlَٰmْʿعَaʾ","root":"عمل"},{"id":24,"arabic":"وَلَكُمْ","translit":"ْmُkَlَw","root":""},{"id":25,"arabic":"أَعْمَٰلُكُمْ","translit":"ْmُkُlَٰmْʿعَaʾ","root":"عمل"},{"id":26,"arabic":"لَا","translit":"āَl","root":""},{"id":27,"arabic":"حُجَّةَ","translit":"َẗَّjgُḥ","root":"حجج"},{"id":28,"arabic":"بَيْنَنَا","translit":"āَnَnْyَb","root":"بين"},{"id":29,"arabic":"وَبَيْنَكُمُ","translit":"ُmُkَnْyَbَw","root":"بين"},{"id":30,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":31,"arabic":"يَجْمَعُ","translit":"ُʿعَmْjgَy","root":"جمع"},{"id":32,"arabic":"بَيْنَنَا","translit":"āَnَnْyَb","root":"بين"},{"id":33,"arabic":"وَإِلَيْهِ","translit":"ِhْyَlِiʾَw","root":""},{"id":34,"arabic":"ٱلْمَصِيرُ","translit":"ُryِṣَmْlٱ","root":"صير"}],"hasIhya":false},{"ayah":16,"text":"وَٱلَّذِينَ يُحَآجُّونَ فِى ٱللَّهِ مِنۢ بَعْدِ مَا ٱسْتُجِيبَ لَهُۥ حُجَّتُهُمْ دَاحِضَةٌ عِندَ رَبِّهِمْ وَعَلَيْهِمْ غَضَبٌ وَلَهُمْ عَذَابٌ شَدِيدٌ ","translation":"And those who argue concerning Allāh after He has been responded to[1] - their argument is invalid with their Lord, and upon them is [His] wrath, and for them is a severe punishment.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"يُحَآجُّونَ","translit":"َnwُّjgٓāَḥُy","root":"حجج"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":6,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"ٱسْتُجِيبَ","translit":"َbyِjgُtْsٱ","root":"جوب"},{"id":9,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":10,"arabic":"حُجَّتُهُمْ","translit":"ْmُhُtَّjgُḥ","root":"حجج"},{"id":11,"arabic":"دَاحِضَةٌ","translit":"ٌẗَḍِḥāَd","root":"دحض"},{"id":12,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":13,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":14,"arabic":"وَعَلَيْهِمْ","translit":"ْmِhْyَlَʿعَw","root":""},{"id":15,"arabic":"غَضَبٌ","translit":"ٌbَḍَغ","root":"غضب"},{"id":16,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":17,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":18,"arabic":"شَدِيدٌ","translit":"ٌdyِdَhs","root":"شدد"}],"hasIhya":false},{"ayah":17,"text":"ٱللَّهُ ٱلَّذِىٓ أَنزَلَ ٱلْكِتَٰبَ بِٱلْحَقِّ وَٱلْمِيزَانَۗ وَمَا يُدْرِيكَ لَعَلَّ ٱلسَّاعَةَ قَرِيبٌ ","translation":"It is Allāh who has sent down the Book in truth and [also] the balance [i.e., justice]. And what will make you perceive? Perhaps the Hour is near.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":3,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":4,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":6,"arabic":"وَٱلْمِيزَانَ","translit":"َnāَzyِmْlٱَw","root":"وزن"},{"id":7,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":8,"arabic":"يُدْرِيكَ","translit":"َkyِrْdُy","root":"دري"},{"id":9,"arabic":"لَعَلَّ","translit":"َّlَʿعَl","root":""},{"id":10,"arabic":"ٱلسَّاعَةَ","translit":"َẗَʿعāَّslٱ","root":"سوع"},{"id":11,"arabic":"قَرِيبٌ","translit":"ٌbyِrَq","root":"قرب"}],"hasIhya":false},{"ayah":18,"text":"يَسْتَعْجِلُ بِهَا ٱلَّذِينَ لَا يُؤْمِنُونَ بِهَاۖ وَٱلَّذِينَ ءَامَنُوا۟ مُشْفِقُونَ مِنْهَا وَيَعْلَمُونَ أَنَّهَا ٱلْحَقُّۗ أَلَآ إِنَّ ٱلَّذِينَ يُمَارُونَ فِى ٱلسَّاعَةِ لَفِى ضَلَٰلٍۭ بَعِيدٍ ","translation":"Those who do not believe in it are impatient for it,[1] but those who believe are fearful of it and know that it is the truth. Unquestionably, those who dispute concerning the Hour are in extreme error.","words":[{"id":1,"arabic":"يَسْتَعْجِلُ","translit":"ُlِjgْʿعَtْsَy","root":"عجل"},{"id":2,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":6,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":7,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":8,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":9,"arabic":"مُشْفِقُونَ","translit":"َnwُqِfْhsُm","root":"شفق"},{"id":10,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":11,"arabic":"وَيَعْلَمُونَ","translit":"َnwُmَlْʿعَyَw","root":"علم"},{"id":12,"arabic":"أَنَّهَا","translit":"āَhَّnَaʾ","root":""},{"id":13,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":14,"arabic":"أَلَآ","translit":"ٓāَlَaʾ","root":""},{"id":15,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":16,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":17,"arabic":"يُمَارُونَ","translit":"َnwُrāَmُy","root":"مري"},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ٱلسَّاعَةِ","translit":"ِẗَʿعāَّslٱ","root":"سوع"},{"id":20,"arabic":"لَفِى","translit":"àِfَl","root":""},{"id":21,"arabic":"ضَلَٰلٍۭ","translit":"ٍۭlَٰlَḍ","root":"ضلل"},{"id":22,"arabic":"بَعِيدٍ","translit":"ٍdyِʿعَb","root":"بعد"}],"hasIhya":false},{"ayah":19,"text":"ٱللَّهُ لَطِيفٌۢ بِعِبَادِهِۦ يَرْزُقُ مَن يَشَآءُۖ وَهُوَ ٱلْقَوِىُّ ٱلْعَزِيزُ ","translation":"Allāh is Subtle[1] with His servants; He gives provision to whom He wills. And He is the Powerful, the Exalted in Might.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"لَطِيفٌۢ","translit":"ٌۢfyِṭَl","root":"لطف"},{"id":3,"arabic":"بِعِبَادِهِۦ","translit":"ۦِhِdāَbِʿعِb","root":"عبد"},{"id":4,"arabic":"يَرْزُقُ","translit":"ُqُzْrَy","root":"رزق"},{"id":5,"arabic":"مَن","translit":"nَm","root":""},{"id":6,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":7,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":8,"arabic":"ٱلْقَوِىُّ","translit":"ُّàِwَqْlٱ","root":"قوي"},{"id":9,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"}],"hasIhya":false},{"ayah":20,"text":"مَن كَانَ يُرِيدُ حَرْثَ ٱلْءَاخِرَةِ نَزِدْ لَهُۥ فِى حَرْثِهِۦۖ وَمَن كَانَ يُرِيدُ حَرْثَ ٱلدُّنْيَا نُؤْتِهِۦ مِنْهَا وَمَا لَهُۥ فِى ٱلْءَاخِرَةِ مِن نَّصِيبٍ ","translation":"Whoever desires the harvest of the Hereafter - We increase for him in his harvest [i.e., reward]. And whoever desires the harvest [i.e., benefits] of this world - We give him thereof, but there is not for him in the Hereafter any share.","words":[{"id":1,"arabic":"مَن","translit":"nَm","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":4,"arabic":"حَرْثَ","translit":"َhtْrَḥ","root":"حرث"},{"id":5,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":6,"arabic":"نَزِدْ","translit":"ْdِzَn","root":"زيد"},{"id":7,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"حَرْثِهِۦ","translit":"ۦِhِhtْrَḥ","root":"حرث"},{"id":10,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":11,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":12,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":13,"arabic":"حَرْثَ","translit":"َhtْrَḥ","root":"حرث"},{"id":14,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":15,"arabic":"نُؤْتِهِۦ","translit":"ۦِhِtْwʾُn","root":"اتي"},{"id":16,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":17,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":18,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":19,"arabic":"فِى","translit":"àِf","root":""},{"id":20,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":21,"arabic":"مِن","translit":"nِm","root":""},{"id":22,"arabic":"نَّصِيبٍ","translit":"ٍbyِṣَّn","root":"نصب"}],"hasIhya":true},{"ayah":21,"text":"أَمْ لَهُمْ شُرَكَٰٓؤُا۟ شَرَعُوا۟ لَهُم مِّنَ ٱلدِّينِ مَا لَمْ يَأْذَنۢ بِهِ ٱللَّهُۚ وَلَوْلَا كَلِمَةُ ٱلْفَصْلِ لَقُضِىَ بَيْنَهُمْۗ وَإِنَّ ٱلظَّٰلِمِينَ لَهُمْ عَذَابٌ أَلِيمٌ ","translation":"Or have they partners [i.e., other deities] who have ordained for them a religion to which Allāh has not consented? But if not for the decisive word,[1] it would have been concluded between them. And indeed, the wrongdoers will have a painful punishment.","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":3,"arabic":"شُرَكَٰٓؤُا۟","translit":"۟āُwʾَٰٓkَrُhs","root":"شرك"},{"id":4,"arabic":"شَرَعُوا۟","translit":"۟āwُʿعَrَhs","root":"شرع"},{"id":5,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":6,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":7,"arabic":"ٱلدِّينِ","translit":"ِnyِّdlٱ","root":"دين"},{"id":8,"arabic":"مَا","translit":"āَm","root":""},{"id":9,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":10,"arabic":"يَأْذَنۢ","translit":"ۢnَhdْaʾَy","root":"اذن"},{"id":11,"arabic":"بِهِ","translit":"ِhِb","root":""},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":14,"arabic":"كَلِمَةُ","translit":"ُẗَmِlَk","root":"كلم"},{"id":15,"arabic":"ٱلْفَصْلِ","translit":"ِlْṣَfْlٱ","root":"فصل"},{"id":16,"arabic":"لَقُضِىَ","translit":"َàِḍُqَl","root":"قضي"},{"id":17,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":18,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":19,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":20,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":21,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":22,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":22,"text":"تَرَى ٱلظَّٰلِمِينَ مُشْفِقِينَ مِمَّا كَسَبُوا۟ وَهُوَ وَاقِعٌۢ بِهِمْۗ وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فِى رَوْضَاتِ ٱلْجَنَّاتِۖ لَهُم مَّا يَشَآءُونَ عِندَ رَبِّهِمْۚ ذَٰلِكَ هُوَ ٱلْفَضْلُ ٱلْكَبِيرُ ","translation":"You will see the wrongdoers fearful of what they have earned, and it will [certainly] befall them. And those who have believed and done righteous deeds will be in lush regions of the gardens [in Paradise] having whatever they will in the presence of their Lord. That is what is the great bounty.","words":[{"id":1,"arabic":"تَرَى","translit":"àَrَt","root":"راي"},{"id":2,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":3,"arabic":"مُشْفِقِينَ","translit":"َnyِqِfْhsُm","root":"شفق"},{"id":4,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":5,"arabic":"كَسَبُوا۟","translit":"۟āwُbَsَk","root":"كسب"},{"id":6,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":7,"arabic":"وَاقِعٌۢ","translit":"ٌۢʿعِqāَw","root":"وقع"},{"id":8,"arabic":"بِهِمْ","translit":"ْmِhِb","root":""},{"id":9,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":10,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":11,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":12,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"رَوْضَاتِ","translit":"ِtāَḍْwَr","root":"روض"},{"id":15,"arabic":"ٱلْجَنَّاتِ","translit":"ِtāَّnَjgْlٱ","root":"جنن"},{"id":16,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":17,"arabic":"مَّا","translit":"āَّm","root":""},{"id":18,"arabic":"يَشَآءُونَ","translit":"َnwُءٓāَhsَy","root":"شيا"},{"id":19,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":20,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":21,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":22,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":23,"arabic":"ٱلْفَضْلُ","translit":"ُlْḍَfْlٱ","root":"فضل"},{"id":24,"arabic":"ٱلْكَبِيرُ","translit":"ُryِbَkْlٱ","root":"كبر"}],"hasIhya":true},{"ayah":23,"text":"ذَٰلِكَ ٱلَّذِى يُبَشِّرُ ٱللَّهُ عِبَادَهُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِۗ قُل لَّآ أَسْـَٔلُكُمْ عَلَيْهِ أَجْرًا إِلَّا ٱلْمَوَدَّةَ فِى ٱلْقُرْبَىٰۗ وَمَن يَقْتَرِفْ حَسَنَةً نَّزِدْ لَهُۥ فِيهَا حُسْنًاۚ إِنَّ ٱللَّهَ غَفُورٌ شَكُورٌ ","translation":"It is that of which Allāh gives good tidings to His servants who believe and do righteous deeds. Say, [O Muḥammad], \"I do not ask you for it [i.e., this message] any payment [but] only good will through [i.e., due to] kinship.\" And whoever commits a good deed - We will increase for him good therein. Indeed, Allāh is Forgiving and Appreciative.[1]","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يُبَشِّرُ","translit":"ُrِّhsَbُy","root":"بشر"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"عِبَادَهُ","translit":"ُhَdāَbِʿع","root":"عبد"},{"id":6,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":7,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":8,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":9,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":10,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":11,"arabic":"لَّآ","translit":"ٓāَّl","root":""},{"id":12,"arabic":"أَسْـَٔلُكُمْ","translit":"ْmُkُlَٔـْsَaʾ","root":"سال"},{"id":13,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":14,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":15,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":16,"arabic":"ٱلْمَوَدَّةَ","translit":"َẗَّdَwَmْlٱ","root":"ودد"},{"id":17,"arabic":"فِى","translit":"àِf","root":""},{"id":18,"arabic":"ٱلْقُرْبَىٰ","translit":"ٰàَbْrُqْlٱ","root":"قرب"},{"id":19,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":20,"arabic":"يَقْتَرِفْ","translit":"ْfِrَtْqَy","root":"قرف"},{"id":21,"arabic":"حَسَنَةً","translit":"ًẗَnَsَḥ","root":"حسن"},{"id":22,"arabic":"نَّزِدْ","translit":"ْdِzَّn","root":"زيد"},{"id":23,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":24,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":25,"arabic":"حُسْنًا","translit":"āًnْsُḥ","root":"حسن"},{"id":26,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":27,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":28,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":29,"arabic":"شَكُورٌ","translit":"ٌrwُkَhs","root":"شكر"}],"hasIhya":false},{"ayah":24,"text":"أَمْ يَقُولُونَ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًاۖ فَإِن يَشَإِ ٱللَّهُ يَخْتِمْ عَلَىٰ قَلْبِكَۗ وَيَمْحُ ٱللَّهُ ٱلْبَٰطِلَ وَيُحِقُّ ٱلْحَقَّ بِكَلِمَٰتِهِۦٓۚ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ","translation":"Or do they say, \"He has invented about Allāh a lie\"? But if Allāh willed, He could seal over your heart.[1] And Allāh eliminates falsehood and establishes the truth by His words. Indeed, He is Knowing of that within the breasts.","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":3,"arabic":"ٱفْتَرَىٰ","translit":"ٰàَrَtْfٱ","root":"فري"},{"id":4,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"كَذِبًا","translit":"āًbِhdَk","root":"كذب"},{"id":7,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":8,"arabic":"يَشَإِ","translit":"ِiʾَhsَy","root":"شيا"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"يَخْتِمْ","translit":"ْmِtْhkَy","root":"ختم"},{"id":11,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":12,"arabic":"قَلْبِكَ","translit":"َkِbْlَq","root":"قلب"},{"id":13,"arabic":"وَيَمْحُ","translit":"ُḥْmَyَw","root":"محو"},{"id":14,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":15,"arabic":"ٱلْبَٰطِلَ","translit":"َlِṭَٰbْlٱ","root":"بطل"},{"id":16,"arabic":"وَيُحِقُّ","translit":"ُّqِḥُyَw","root":"حقق"},{"id":17,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":18,"arabic":"بِكَلِمَٰتِهِۦٓ","translit":"ٓۦِhِtَٰmِlَkِb","root":"كلم"},{"id":19,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":20,"arabic":"عَلِيمٌۢ","translit":"ٌۢmyِlَʿع","root":"علم"},{"id":21,"arabic":"بِذَاتِ","translit":"ِtāَhdِb","root":""},{"id":22,"arabic":"ٱلصُّدُورِ","translit":"ِrwُdُّṣlٱ","root":"صدر"}],"hasIhya":true},{"ayah":25,"text":"وَهُوَ ٱلَّذِى يَقْبَلُ ٱلتَّوْبَةَ عَنْ عِبَادِهِۦ وَيَعْفُوا۟ عَنِ ٱلسَّيِّـَٔاتِ وَيَعْلَمُ مَا تَفْعَلُونَ ","translation":"And it is He who accepts repentance from His servants and pardons misdeeds, and He knows what you do.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يَقْبَلُ","translit":"ُlَbْqَy","root":"قبل"},{"id":4,"arabic":"ٱلتَّوْبَةَ","translit":"َẗَbْwَّtlٱ","root":"توب"},{"id":5,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":6,"arabic":"عِبَادِهِۦ","translit":"ۦِhِdāَbِʿع","root":"عبد"},{"id":7,"arabic":"وَيَعْفُوا۟","translit":"۟āwُfْʿعَyَw","root":"عفو"},{"id":8,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":9,"arabic":"ٱلسَّيِّـَٔاتِ","translit":"ِtāَٔـِّyَّslٱ","root":"سوا"},{"id":10,"arabic":"وَيَعْلَمُ","translit":"ُmَlْʿعَyَw","root":"علم"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"تَفْعَلُونَ","translit":"َnwُlَʿعْfَt","root":"فعل"}],"hasIhya":true},{"ayah":26,"text":"وَيَسْتَجِيبُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَيَزِيدُهُم مِّن فَضْلِهِۦۚ وَٱلْكَٰفِرُونَ لَهُمْ عَذَابٌ شَدِيدٌ ","translation":"And He answers [the supplication of] those who have believed and done righteous deeds and increases [for] them from His bounty. But the disbelievers will have a severe punishment.","words":[{"id":1,"arabic":"وَيَسْتَجِيبُ","translit":"ُbyِjgَtْsَyَw","root":"جوب"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":5,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":6,"arabic":"وَيَزِيدُهُم","translit":"mُhُdyِzَyَw","root":"زيد"},{"id":7,"arabic":"مِّن","translit":"nِّm","root":""},{"id":8,"arabic":"فَضْلِهِۦ","translit":"ۦِhِlْḍَf","root":"فضل"},{"id":9,"arabic":"وَٱلْكَٰفِرُونَ","translit":"َnwُrِfَٰkْlٱَw","root":"كفر"},{"id":10,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":11,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":12,"arabic":"شَدِيدٌ","translit":"ٌdyِdَhs","root":"شدد"}],"hasIhya":true},{"ayah":27,"text":"وَلَوْ بَسَطَ ٱللَّهُ ٱلرِّزْقَ لِعِبَادِهِۦ لَبَغَوْا۟ فِى ٱلْأَرْضِ وَلَٰكِن يُنَزِّلُ بِقَدَرٍ مَّا يَشَآءُۚ إِنَّهُۥ بِعِبَادِهِۦ خَبِيرٌۢ بَصِيرٌ ","translation":"And if Allāh had extended [excessively] provision for His servants, they would have committed tyranny throughout the earth. But He sends [it] down in an amount which He wills. Indeed He is, of His servants, Aware and Seeing.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"بَسَطَ","translit":"َṭَsَb","root":"بسط"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"ٱلرِّزْقَ","translit":"َqْzِّrlٱ","root":"رزق"},{"id":5,"arabic":"لِعِبَادِهِۦ","translit":"ۦِhِdāَbِʿعِl","root":"عبد"},{"id":6,"arabic":"لَبَغَوْا۟","translit":"۟āْwَغَbَl","root":"بغي"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":10,"arabic":"يُنَزِّلُ","translit":"ُlِّzَnُy","root":"نزل"},{"id":11,"arabic":"بِقَدَرٍ","translit":"ٍrَdَqِb","root":"قدر"},{"id":12,"arabic":"مَّا","translit":"āَّm","root":""},{"id":13,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":14,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":15,"arabic":"بِعِبَادِهِۦ","translit":"ۦِhِdāَbِʿعِb","root":"عبد"},{"id":16,"arabic":"خَبِيرٌۢ","translit":"ٌۢryِbَhk","root":"خبر"},{"id":17,"arabic":"بَصِيرٌ","translit":"ٌryِṣَb","root":"بصر"}],"hasIhya":true},{"ayah":28,"text":"وَهُوَ ٱلَّذِى يُنَزِّلُ ٱلْغَيْثَ مِنۢ بَعْدِ مَا قَنَطُوا۟ وَيَنشُرُ رَحْمَتَهُۥۚ وَهُوَ ٱلْوَلِىُّ ٱلْحَمِيدُ ","translation":"And it is He who sends down the rain after they had despaired and spreads His mercy. And He is the Protector, the Praiseworthy.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يُنَزِّلُ","translit":"ُlِّzَnُy","root":"نزل"},{"id":4,"arabic":"ٱلْغَيْثَ","translit":"َhtْyَغْlٱ","root":"غيث"},{"id":5,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":6,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"قَنَطُوا۟","translit":"۟āwُṭَnَq","root":"قنط"},{"id":9,"arabic":"وَيَنشُرُ","translit":"ُrُhsnَyَw","root":"نشر"},{"id":10,"arabic":"رَحْمَتَهُۥ","translit":"ۥُhَtَmْḥَr","root":"رحم"},{"id":11,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":12,"arabic":"ٱلْوَلِىُّ","translit":"ُّàِlَwْlٱ","root":"ولي"},{"id":13,"arabic":"ٱلْحَمِيدُ","translit":"ُdyِmَḥْlٱ","root":"حمد"}],"hasIhya":false},{"ayah":29,"text":"وَمِنْ ءَايَٰتِهِۦ خَلْقُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَثَّ فِيهِمَا مِن دَآبَّةٍۚ وَهُوَ عَلَىٰ جَمْعِهِمْ إِذَا يَشَآءُ قَدِيرٌ ","translation":"And of His signs is the creation of the heavens and earth and what He has dispersed throughout them of creatures. And He, for gathering them when He wills, is competent.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"خَلْقُ","translit":"ُqْlَhk","root":"خلق"},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"بَثَّ","translit":"َّhtَb","root":"بثث"},{"id":8,"arabic":"فِيهِمَا","translit":"āَmِhyِf","root":""},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"دَآبَّةٍ","translit":"ٍẗَّbٓāَd","root":"دبب"},{"id":11,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":12,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":13,"arabic":"جَمْعِهِمْ","translit":"ْmِhِʿعْmَjg","root":"جمع"},{"id":14,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":15,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":16,"arabic":"قَدِيرٌ","translit":"ٌryِdَq","root":"قدر"}],"hasIhya":false},{"ayah":30,"text":"وَمَآ أَصَٰبَكُم مِّن مُّصِيبَةٍ فَبِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُوا۟ عَن كَثِيرٍ ","translation":"And whatever strikes you of disaster - it is for what your hands have earned; but He pardons much.","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَصَٰبَكُم","translit":"mُkَbَٰṣَaʾ","root":"صوب"},{"id":3,"arabic":"مِّن","translit":"nِّm","root":""},{"id":4,"arabic":"مُّصِيبَةٍ","translit":"ٍẗَbyِṣُّm","root":"صوب"},{"id":5,"arabic":"فَبِمَا","translit":"āَmِbَf","root":""},{"id":6,"arabic":"كَسَبَتْ","translit":"ْtَbَsَk","root":"كسب"},{"id":7,"arabic":"أَيْدِيكُمْ","translit":"ْmُkyِdْyَaʾ","root":"يدي"},{"id":8,"arabic":"وَيَعْفُوا۟","translit":"۟āwُfْʿعَyَw","root":"عفو"},{"id":9,"arabic":"عَن","translit":"nَʿع","root":""},{"id":10,"arabic":"كَثِيرٍ","translit":"ٍryِhtَk","root":"كثر"}],"hasIhya":true},{"ayah":31,"text":"وَمَآ أَنتُم بِمُعْجِزِينَ فِى ٱلْأَرْضِۖ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِىٍّ وَلَا نَصِيرٍ ","translation":"And you will not cause failure [to Allāh][1] upon the earth. And you have not besides Allāh any protector or helper.","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَنتُم","translit":"mُtnَaʾ","root":""},{"id":3,"arabic":"بِمُعْجِزِينَ","translit":"َnyِzِjgْʿعُmِb","root":"عجز"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"دُونِ","translit":