"translit":"ِّlُkِّl","root":"كلل"},{"id":14,"arabic":"صَبَّارٍ","translit":"ٍrāَّbَṣ","root":"صبر"},{"id":15,"arabic":"شَكُورٍ","translit":"ٍrwُkَhs","root":"شكر"}],"hasIhya":false},{"ayah":34,"text":"أَوْ يُوبِقْهُنَّ بِمَا كَسَبُوا۟ وَيَعْفُ عَن كَثِيرٍ ","translation":"Or He could destroy them[1] for what they earned; but He pardons much.","words":[{"id":1,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":2,"arabic":"يُوبِقْهُنَّ","translit":"َّnُhْqِbwُy","root":"وبق"},{"id":3,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":4,"arabic":"كَسَبُوا۟","translit":"۟āwُbَsَk","root":"كسب"},{"id":5,"arabic":"وَيَعْفُ","translit":"ُfْʿعَyَw","root":"عفو"},{"id":6,"arabic":"عَن","translit":"nَʿع","root":""},{"id":7,"arabic":"كَثِيرٍ","translit":"ٍryِhtَk","root":"كثر"}],"hasIhya":false},{"ayah":35,"text":"وَيَعْلَمَ ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِنَا مَا لَهُم مِّن مَّحِيصٍ ","translation":"And [that is so] those who dispute concerning Our signs may know that for them there is no place of escape.","words":[{"id":1,"arabic":"وَيَعْلَمَ","translit":"َmَlْʿعَyَw","root":"علم"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يُجَٰدِلُونَ","translit":"َnwُlِdَٰjgُy","root":"جدل"},{"id":4,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":5,"arabic":"ءَايَٰتِنَا","translit":"āَnِtَٰyāَء","root":"ايي"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"مَّحِيصٍ","translit":"ٍṣyِḥَّm","root":"حيص"}],"hasIhya":false},{"ayah":36,"text":"فَمَآ أُوتِيتُم مِّن شَىْءٍ فَمَتَٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَمَا عِندَ ٱللَّهِ خَيْرٌ وَأَبْقَىٰ لِلَّذِينَ ءَامَنُوا۟ وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ ","translation":"So whatever thing you have been given - it is but [for] enjoyment of the worldly life. But what is with Allāh is better and more lasting for those who have believed and upon their Lord rely","words":[{"id":1,"arabic":"فَمَآ","translit":"ٓāَmَf","root":""},{"id":2,"arabic":"أُوتِيتُم","translit":"mُtyِtwُaʾ","root":"اتي"},{"id":3,"arabic":"مِّن","translit":"nِّm","root":""},{"id":4,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":5,"arabic":"فَمَتَٰعُ","translit":"ُʿعَٰtَmَf","root":"متع"},{"id":6,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":7,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":8,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":9,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":12,"arabic":"وَأَبْقَىٰ","translit":"ٰàَqْbَaʾَw","root":"بقي"},{"id":13,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":14,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":15,"arabic":"وَعَلَىٰ","translit":"ٰàَlَʿعَw","root":""},{"id":16,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":17,"arabic":"يَتَوَكَّلُونَ","translit":"َnwُlَّkَwَtَy","root":"وكل"}],"hasIhya":true},{"ayah":37,"text":"وَٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ وَإِذَا مَا غَضِبُوا۟ هُمْ يَغْفِرُونَ ","translation":"And those who avoid the major sins and immoralities, and when they are angry, they forgive,","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"يَجْتَنِبُونَ","translit":"َnwُbِnَtْjgَy","root":"جنب"},{"id":3,"arabic":"كَبَٰٓئِرَ","translit":"َrِyʾَٰٓbَk","root":"كبر"},{"id":4,"arabic":"ٱلْإِثْمِ","translit":"ِmْhtِiʾْlٱ","root":"اثم"},{"id":5,"arabic":"وَٱلْفَوَٰحِشَ","translit":"َhsِḥَٰwَfْlٱَw","root":"فحش"},{"id":6,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"غَضِبُوا۟","translit":"۟āwُbِḍَغ","root":"غضب"},{"id":9,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":10,"arabic":"يَغْفِرُونَ","translit":"َnwُrِfْغَy","root":"غفر"}],"hasIhya":false},{"ayah":38,"text":"وَٱلَّذِينَ ٱسْتَجَابُوا۟ لِرَبِّهِمْ وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَأَمْرُهُمْ شُورَىٰ بَيْنَهُمْ وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَ ","translation":"And those who have responded to their Lord and established prayer and whose affair is [determined by] consultation among themselves, and from what We have provided them, they spend,","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"ٱسْتَجَابُوا۟","translit":"۟āwُbāَjgَtْsٱ","root":"جوب"},{"id":3,"arabic":"لِرَبِّهِمْ","translit":"ْmِhِّbَrِl","root":"ربب"},{"id":4,"arabic":"وَأَقَامُوا۟","translit":"۟āwُmāَqَaʾَw","root":"قوم"},{"id":5,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":6,"arabic":"وَأَمْرُهُمْ","translit":"ْmُhُrْmَaʾَw","root":"امر"},{"id":7,"arabic":"شُورَىٰ","translit":"ٰàَrwُhs","root":"شور"},{"id":8,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":9,"arabic":"وَمِمَّا","translit":"āَّmِmَw","root":""},{"id":10,"arabic":"رَزَقْنَٰهُمْ","translit":"ْmُhَٰnْqَzَr","root":"رزق"},{"id":11,"arabic":"يُنفِقُونَ","translit":"َnwُqِfnُy","root":"نفق"}],"hasIhya":true},{"ayah":39,"text":"وَٱلَّذِينَ إِذَآ أَصَابَهُمُ ٱلْبَغْىُ هُمْ يَنتَصِرُونَ ","translation":"And those who, when tyranny strikes them, they retaliate [in a just manner].[1]","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":3,"arabic":"أَصَابَهُمُ","translit":"ُmُhَbāَṣَaʾ","root":"صوب"},{"id":4,"arabic":"ٱلْبَغْىُ","translit":"ُàْغَbْlٱ","root":"بغي"},{"id":5,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":6,"arabic":"يَنتَصِرُونَ","translit":"َnwُrِṣَtnَy","root":"نصر"}],"hasIhya":false},{"ayah":40,"text":"وَجَزَٰٓؤُا۟ سَيِّئَةٍ سَيِّئَةٌ مِّثْلُهَاۖ فَمَنْ عَفَا وَأَصْلَحَ فَأَجْرُهُۥ عَلَى ٱللَّهِۚ إِنَّهُۥ لَا يُحِبُّ ٱلظَّٰلِمِينَ ","translation":"And the retribution for an evil act is an evil one like it, but whoever pardons and makes reconciliation - his reward is [due] from Allāh. Indeed, He does not like wrongdoers.","words":[{"id":1,"arabic":"وَجَزَٰٓؤُا۟","translit":"۟āُwʾَٰٓzَjgَw","root":"جزي"},{"id":2,"arabic":"سَيِّئَةٍ","translit":"ٍẗَyʾِّyَs","root":"سوا"},{"id":3,"arabic":"سَيِّئَةٌ","translit":"ٌẗَyʾِّyَs","root":"سوا"},{"id":4,"arabic":"مِّثْلُهَا","translit":"āَhُlْhtِّm","root":"مثل"},{"id":5,"arabic":"فَمَنْ","translit":"ْnَmَf","root":""},{"id":6,"arabic":"عَفَا","translit":"āَfَʿع","root":"عفو"},{"id":7,"arabic":"وَأَصْلَحَ","translit":"َḥَlْṣَaʾَw","root":"صلح"},{"id":8,"arabic":"فَأَجْرُهُۥ","translit":"ۥُhُrْjgَaʾَf","root":"اجر"},{"id":9,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":12,"arabic":"لَا","translit":"āَl","root":""},{"id":13,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":14,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":false},{"ayah":41,"text":"وَلَمَنِ ٱنتَصَرَ بَعْدَ ظُلْمِهِۦ فَأُو۟لَٰٓئِكَ مَا عَلَيْهِم مِّن سَبِيلٍ ","translation":"And whoever retaliates after having been wronged - those have not upon them any cause [for blame].","words":[{"id":1,"arabic":"وَلَمَنِ","translit":"ِnَmَlَw","root":""},{"id":2,"arabic":"ٱنتَصَرَ","translit":"َrَṣَtnٱ","root":"نصر"},{"id":3,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":4,"arabic":"ظُلْمِهِۦ","translit":"ۦِhِmْlُẓ","root":"ظلم"},{"id":5,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"سَبِيلٍ","translit":"ٍlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":42,"text":"إِنَّمَا ٱلسَّبِيلُ عَلَى ٱلَّذِينَ يَظْلِمُونَ ٱلنَّاسَ وَيَبْغُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّۚ أُو۟لَٰٓئِكَ لَهُمْ عَذَابٌ أَلِيمٌ ","translation":"The cause is only against the ones who wrong the people and tyrannize upon the earth without right. Those will have a painful punishment.","words":[{"id":1,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":2,"arabic":"ٱلسَّبِيلُ","translit":"ُlyِbَّslٱ","root":"سبل"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"يَظْلِمُونَ","translit":"َnwُmِlْẓَy","root":"ظلم"},{"id":6,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":7,"arabic":"وَيَبْغُونَ","translit":"َnwُغْbَyَw","root":"بغي"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":10,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":11,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":12,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":13,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":14,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":15,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":true},{"ayah":43,"text":"وَلَمَن صَبَرَ وَغَفَرَ إِنَّ ذَٰلِكَ لَمِنْ عَزْمِ ٱلْأُمُورِ ","translation":"And whoever is patient and forgives - indeed, that is of the matters [worthy] of resolve.[1]","words":[{"id":1,"arabic":"وَلَمَن","translit":"nَmَlَw","root":""},{"id":2,"arabic":"صَبَرَ","translit":"َrَbَṣ","root":"صبر"},{"id":3,"arabic":"وَغَفَرَ","translit":"َrَfَغَw","root":"غفر"},{"id":4,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":5,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":6,"arabic":"لَمِنْ","translit":"ْnِmَl","root":""},{"id":7,"arabic":"عَزْمِ","translit":"ِmْzَʿع","root":"عزم"},{"id":8,"arabic":"ٱلْأُمُورِ","translit":"ِrwُmُaʾْlٱ","root":"امر"}],"hasIhya":true},{"ayah":44,"text":"وَمَن يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِن وَلِىٍّ مِّنۢ بَعْدِهِۦۗ وَتَرَى ٱلظَّٰلِمِينَ لَمَّا رَأَوُا۟ ٱلْعَذَابَ يَقُولُونَ هَلْ إِلَىٰ مَرَدٍّ مِّن سَبِيلٍ ","translation":"And he whom Allāh sends astray - for him there is no protector beyond Him. And you will see the wrongdoers, when they see the punishment, saying, \"Is there for return [to the former world] any way?\"","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يُضْلِلِ","translit":"ِlِlْḍُy","root":"ضلل"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":5,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"وَلِىٍّ","translit":"ٍّàِlَw","root":"ولي"},{"id":8,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":9,"arabic":"بَعْدِهِۦ","translit":"ۦِhِdْʿعَb","root":"بعد"},{"id":10,"arabic":"وَتَرَى","translit":"àَrَtَw","root":"راي"},{"id":11,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":12,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":13,"arabic":"رَأَوُا۟","translit":"۟āُwَaʾَr","root":"راي"},{"id":14,"arabic":"ٱلْعَذَابَ","translit":"َbāَhdَʿعْlٱ","root":"عذب"},{"id":15,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":16,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":17,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":18,"arabic":"مَرَدٍّ","translit":"ٍّdَrَm","root":"ردد"},{"id":19,"arabic":"مِّن","translit":"nِّm","root":""},{"id":20,"arabic":"سَبِيلٍ","translit":"ٍlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":45,"text":"وَتَرَىٰهُمْ يُعْرَضُونَ عَلَيْهَا خَٰشِعِينَ مِنَ ٱلذُّلِّ يَنظُرُونَ مِن طَرْفٍ خَفِىٍّۗ وَقَالَ ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ ٱلْخَٰسِرِينَ ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ وَأَهْلِيهِمْ يَوْمَ ٱلْقِيَٰمَةِۗ أَلَآ إِنَّ ٱلظَّٰلِمِينَ فِى عَذَابٍ مُّقِيمٍ ","translation":"And you will see them being exposed to it [i.e., the Fire], humbled from humiliation, looking from [behind] a covert glance. And those who had believed will say, \"Indeed, the [true] losers are the ones who lost themselves and their families on the Day of Resurrection. Unquestionably, the wrongdoers are in an enduring punishment.\"","words":[{"id":1,"arabic":"وَتَرَىٰهُمْ","translit":"ْmُhٰàَrَtَw","root":"راي"},{"id":2,"arabic":"يُعْرَضُونَ","translit":"َnwُḍَrْʿعُy","root":"عرض"},{"id":3,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":4,"arabic":"خَٰشِعِينَ","translit":"َnyِʿعِhsَٰhk","root":"خشع"},{"id":5,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":6,"arabic":"ٱلذُّلِّ","translit":"ِّlُّhdlٱ","root":"ذلل"},{"id":7,"arabic":"يَنظُرُونَ","translit":"َnwُrُẓnَy","root":"نظر"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"طَرْفٍ","translit":"ٍfْrَṭ","root":"طرف"},{"id":10,"arabic":"خَفِىٍّ","translit":"ٍّàِfَhk","root":"خفي"},{"id":11,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":12,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":13,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":14,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":15,"arabic":"ٱلْخَٰسِرِينَ","translit":"َnyِrِsَٰhkْlٱ","root":"خسر"},{"id":16,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":17,"arabic":"خَسِرُوٓا۟","translit":"۟āٓwُrِsَhk","root":"خسر"},{"id":18,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":19,"arabic":"وَأَهْلِيهِمْ","translit":"ْmِhyِlْhَaʾَw","root":"اهل"},{"id":20,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":21,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":22,"arabic":"أَلَآ","translit":"ٓāَlَaʾ","root":""},{"id":23,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":24,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":25,"arabic":"فِى","translit":"àِf","root":""},{"id":26,"arabic":"عَذَابٍ","translit":"ٍbāَhdَʿع","root":"عذب"},{"id":27,"arabic":"مُّقِيمٍ","translit":"ٍmyِqُّm","root":"قوم"}],"hasIhya":true},{"ayah":46,"text":"وَمَا كَانَ لَهُم مِّنْ أَوْلِيَآءَ يَنصُرُونَهُم مِّن دُونِ ٱللَّهِۗ وَمَن يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِن سَبِيلٍ ","translation":"And there will not be for them any allies to aid them other than Allāh. And whoever Allāh sends astray - for him there is no way.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":4,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":5,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":6,"arabic":"يَنصُرُونَهُم","translit":"mُhَnwُrُṣnَy","root":"نصر"},{"id":7,"arabic":"مِّن","translit":"nِّm","root":""},{"id":8,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":11,"arabic":"يُضْلِلِ","translit":"ِlِlْḍُy","root":"ضلل"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":14,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":15,"arabic":"مِن","translit":"nِm","root":""},{"id":16,"arabic":"سَبِيلٍ","translit":"ٍlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":47,"text":"ٱسْتَجِيبُوا۟ لِرَبِّكُم مِّن قَبْلِ أَن يَأْتِىَ يَوْمٌ لَّا مَرَدَّ لَهُۥ مِنَ ٱللَّهِۚ مَا لَكُم مِّن مَّلْجَإٍ يَوْمَئِذٍ وَمَا لَكُم مِّن نَّكِيرٍ ","translation":"Respond to your Lord before a Day comes from Allāh of which there is no repelling. No refuge will you have that Day, nor for you will there be any denial.[1]","words":[{"id":1,"arabic":"ٱسْتَجِيبُوا۟","translit":"۟āwُbyِjgَtْsٱ","root":"جوب"},{"id":2,"arabic":"لِرَبِّكُم","translit":"mُkِّbَrِl","root":"ربب"},{"id":3,"arabic":"مِّن","translit":"nِّm","root":""},{"id":4,"arabic":"قَبْلِ","translit":"ِlْbَq","root":"قبل"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"يَأْتِىَ","translit":"َàِtْaʾَy","root":"اتي"},{"id":7,"arabic":"يَوْمٌ","translit":"ٌmْwَy","root":"يوم"},{"id":8,"arabic":"لَّا","translit":"āَّl","root":""},{"id":9,"arabic":"مَرَدَّ","translit":"َّdَrَm","root":"ردد"},{"id":10,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":11,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"مَا","translit":"āَm","root":""},{"id":14,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":15,"arabic":"مِّن","translit":"nِّm","root":""},{"id":16,"arabic":"مَّلْجَإٍ","translit":"ٍiʾَjgْlَّm","root":"لجا"},{"id":17,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":18,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":19,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":20,"arabic":"مِّن","translit":"nِّm","root":""},{"id":21,"arabic":"نَّكِيرٍ","translit":"ٍryِkَّn","root":"نكر"}],"hasIhya":true},{"ayah":48,"text":"فَإِنْ أَعْرَضُوا۟ فَمَآ أَرْسَلْنَٰكَ عَلَيْهِمْ حَفِيظًاۖ إِنْ عَلَيْكَ إِلَّا ٱلْبَلَٰغُۗ وَإِنَّآ إِذَآ أَذَقْنَا ٱلْإِنسَٰنَ مِنَّا رَحْمَةً فَرِحَ بِهَاۖ وَإِن تُصِبْهُمْ سَيِّئَةٌۢ بِمَا قَدَّمَتْ أَيْدِيهِمْ فَإِنَّ ٱلْإِنسَٰنَ كَفُورٌ ","translation":"But if they turn away - then We have not sent you, [O Muḥammad], over them as a guardian; upon you is only [the duty of] notification. And indeed, when We let man taste mercy from Us, he rejoices in it; but if evil afflicts him for what his hands have put forth, then indeed, man is ungrateful.","words":[{"id":1,"arabic":"فَإِنْ","translit":"ْnِiʾَf","root":""},{"id":2,"arabic":"أَعْرَضُوا۟","translit":"۟āwُḍَrْʿعَaʾ","root":"عرض"},{"id":3,"arabic":"فَمَآ","translit":"ٓāَmَf","root":""},{"id":4,"arabic":"أَرْسَلْنَٰكَ","translit":"َkَٰnْlَsْrَaʾ","root":"رسل"},{"id":5,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":6,"arabic":"حَفِيظًا","translit":"āًẓyِfَḥ","root":"حفظ"},{"id":7,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":8,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"ٱلْبَلَٰغُ","translit":"ُغَٰlَbْlٱ","root":"بلغ"},{"id":11,"arabic":"وَإِنَّآ","translit":"ٓāَّnِiʾَw","root":""},{"id":12,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":13,"arabic":"أَذَقْنَا","translit":"āَnْqَhdَaʾ","root":"ذوق"},{"id":14,"arabic":"ٱلْإِنسَٰنَ","translit":"َnَٰsnِiʾْlٱ","root":"انس"},{"id":15,"arabic":"مِنَّا","translit":"āَّnِm","root":""},{"id":16,"arabic":"رَحْمَةً","translit":"ًẗَmْḥَr","root":"رحم"},{"id":17,"arabic":"فَرِحَ","translit":"َḥِrَf","root":"فرح"},{"id":18,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":19,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":20,"arabic":"تُصِبْهُمْ","translit":"ْmُhْbِṣُt","root":"صوب"},{"id":21,"arabic":"سَيِّئَةٌۢ","translit":"ٌۢẗَyʾِّyَs","root":"سوا"},{"id":22,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":23,"arabic":"قَدَّمَتْ","translit":"ْtَmَّdَq","root":"قدم"},{"id":24,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":25,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":26,"arabic":"ٱلْإِنسَٰنَ","translit":"َnَٰsnِiʾْlٱ","root":"انس"},{"id":27,"arabic":"كَفُورٌ","translit":"ٌrwُfَk","root":"كفر"}],"hasIhya":false},{"ayah":49,"text":"لِّلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ يَخْلُقُ مَا يَشَآءُۚ يَهَبُ لِمَن يَشَآءُ إِنَٰثًا وَيَهَبُ لِمَن يَشَآءُ ٱلذُّكُورَ ","translation":"To Allāh belongs the dominion of the heavens and the earth; He creates what He wills. He gives to whom He wills female [children], and He gives to whom He wills males.","words":[{"id":1,"arabic":"لِّلَّهِ","translit":"ِhَّlِّl","root":"اله"},{"id":2,"arabic":"مُلْكُ","translit":"ُkْlُm","root":"ملك"},{"id":3,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":4,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":5,"arabic":"يَخْلُقُ","translit":"ُqُlْhkَy","root":"خلق"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":8,"arabic":"يَهَبُ","translit":"ُbَhَy","root":"وهب"},{"id":9,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":10,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":11,"arabic":"إِنَٰثًا","translit":"āًhtَٰnِiʾ","root":"انث"},{"id":12,"arabic":"وَيَهَبُ","translit":"ُbَhَyَw","root":"وهب"},{"id":13,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":14,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":15,"arabic":"ٱلذُّكُورَ","translit":"َrwُkُّhdlٱ","root":"ذكر"}],"hasIhya":false},{"ayah":50,"text":"أَوْ يُزَوِّجُهُمْ ذُكْرَانًا وَإِنَٰثًاۖ وَيَجْعَلُ مَن يَشَآءُ عَقِيمًاۚ إِنَّهُۥ عَلِيمٌ قَدِيرٌ ","translation":"Or He makes them [both] males and females, and He renders whom He wills barren. Indeed, He is Knowing and Competent.","words":[{"id":1,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":2,"arabic":"يُزَوِّجُهُمْ","translit":"ْmُhُjgِّwَzُy","root":"زوج"},{"id":3,"arabic":"ذُكْرَانًا","translit":"āًnāَrْkُhd","root":"ذكر"},{"id":4,"arabic":"وَإِنَٰثًا","translit":"āًhtَٰnِiʾَw","root":"انث"},{"id":5,"arabic":"وَيَجْعَلُ","translit":"ُlَʿعْjgَyَw","root":"جعل"},{"id":6,"arabic":"مَن","translit":"nَm","root":""},{"id":7,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":8,"arabic":"عَقِيمًا","translit":"āًmyِqَʿع","root":"عقم"},{"id":9,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":10,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"},{"id":11,"arabic":"قَدِيرٌ","translit":"ٌryِdَq","root":"قدر"}],"hasIhya":false},{"ayah":51,"text":"وَمَا كَانَ لِبَشَرٍ أَن يُكَلِّمَهُ ٱللَّهُ إِلَّا وَحْيًا أَوْ مِن وَرَآئِ حِجَابٍ أَوْ يُرْسِلَ رَسُولًا فَيُوحِىَ بِإِذْنِهِۦ مَا يَشَآءُۚ إِنَّهُۥ عَلِىٌّ حَكِيمٌ ","translation":"And it is not for any human being that Allāh should speak to him except by revelation or from behind a partition or that He sends a messenger [i.e., angel] to reveal, by His permission, what He wills. Indeed, He is Most High and Wise.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"لِبَشَرٍ","translit":"ٍrَhsَbِl","root":"بشر"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يُكَلِّمَهُ","translit":"ُhَmِّlَkُy","root":"كلم"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"وَحْيًا","translit":"āًyْḥَw","root":"وحي"},{"id":9,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"وَرَآئِ","translit":"ِyʾٓāَrَw","root":"وري"},{"id":12,"arabic":"حِجَابٍ","translit":"ٍbāَjgِḥ","root":"حجب"},{"id":13,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":14,"arabic":"يُرْسِلَ","translit":"َlِsْrُy","root":"رسل"},{"id":15,"arabic":"رَسُولًا","translit":"āًlwُsَr","root":"رسل"},{"id":16,"arabic":"فَيُوحِىَ","translit":"َàِḥwُyَf","root":"وحي"},{"id":17,"arabic":"بِإِذْنِهِۦ","translit":"ۦِhِnْhdِiʾِb","root":"اذن"},{"id":18,"arabic":"مَا","translit":"āَm","root":""},{"id":19,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":20,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":21,"arabic":"عَلِىٌّ","translit":"ٌّàِlَʿع","root":"علو"},{"id":22,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"}],"hasIhya":true},{"ayah":52,"text":"وَكَذَٰلِكَ أَوْحَيْنَآ إِلَيْكَ رُوحًا مِّنْ أَمْرِنَاۚ مَا كُنتَ تَدْرِى مَا ٱلْكِتَٰبُ وَلَا ٱلْإِيمَٰنُ وَلَٰكِن جَعَلْنَٰهُ نُورًا نَّهْدِى بِهِۦ مَن نَّشَآءُ مِنْ عِبَادِنَاۚ وَإِنَّكَ لَتَهْدِىٓ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ","translation":"And thus We have revealed to you an inspiration of Our command [i.e., the Qur’ān]. You did not know what is the Book or [what is] faith, but We have made it a light by which We guide whom We will of Our servants. And indeed, [O Muḥammad], you guide to a straight path -","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"أَوْحَيْنَآ","translit":"ٓāَnْyَḥْwَaʾ","root":"وحي"},{"id":3,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":4,"arabic":"رُوحًا","translit":"āًḥwُr","root":"روح"},{"id":5,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":6,"arabic":"أَمْرِنَا","translit":"āَnِrْmَaʾ","root":"امر"},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"كُنتَ","translit":"َtnُk","root":"كون"},{"id":9,"arabic":"تَدْرِى","translit":"àِrْdَt","root":"دري"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"ٱلْكِتَٰبُ","translit":"ُbَٰtِkْlٱ","root":"كتب"},{"id":12,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":13,"arabic":"ٱلْإِيمَٰنُ","translit":"ُnَٰmyِiʾْlٱ","root":"امن"},{"id":14,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":15,"arabic":"جَعَلْنَٰهُ","translit":"ُhَٰnْlَʿعَjg","root":"جعل"},{"id":16,"arabic":"نُورًا","translit":"āًrwُn","root":"نور"},{"id":17,"arabic":"نَّهْدِى","translit":"àِdْhَّn","root":"هدي"},{"id":18,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":19,"arabic":"مَن","translit":"nَm","root":""},{"id":20,"arabic":"نَّشَآءُ","translit":"ُءٓāَhsَّn","root":"شيا"},{"id":21,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":22,"arabic":"عِبَادِنَا","translit":"āَnِdāَbِʿع","root":"عبد"},{"id":23,"arabic":"وَإِنَّكَ","translit":"َkَّnِiʾَw","root":""},{"id":24,"arabic":"لَتَهْدِىٓ","translit":"ٓàِdْhَtَl","root":"هدي"},{"id":25,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":26,"arabic":"صِرَٰطٍ","translit":"ٍṭَٰrِṣ","root":"صرط"},{"id":27,"arabic":"مُّسْتَقِيمٍ","translit":"ٍmyِqَtْsُّm","root":"قوم"}],"hasIhya":true},{"ayah":53,"text":"صِرَٰطِ ٱللَّهِ ٱلَّذِى لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۗ أَلَآ إِلَى ٱللَّهِ تَصِيرُ ٱلْأُمُورُ ","translation":"The path of Allāh, to whom belongs whatever is in the heavens and whatever is on the earth. Unquestionably, to Allāh do [all] matters evolve [i.e., return].","words":[{"id":1,"arabic":"صِرَٰطِ","translit":"ِṭَٰrِṣ","root":"صرط"},{"id":2,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":3,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":4,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":8,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":11,"arabic":"أَلَآ","translit":"ٓāَlَaʾ","root":""},{"id":12,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":13,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":14,"arabic":"تَصِيرُ","translit":"ُryِṣَt","root":"صير"},{"id":15,"arabic":"ٱلْأُمُورُ","translit":"ُrwُmُaʾْlٱ","root":"امر"}],"hasIhya":true}],"tafsir":{"5":[{"arabic":"تعالى والملائكة يسبحون بحمد ربهم ويستغفرون لمن في الأرض وأخبر تعالى أن النار أعدها لأعدائه وإنما خوف بها أولياءه فقال لهم من فوقهم ظلل من النار ومن تحتهم ظلل ذلك يخوف الله به عباده وقال تعالى واتقوا النار التي أعدت للكافرين وقال تعالى فأنذرتكم نارا تلظى لا يصلاها إلا الأشقى الذي كذب وتولى وقال عز وجل وإن ربك لذوا مغفرة للناس على ظلمهم ويقال أن النبي صلى الله عليه وسلم لم يزل يسأل في أمته حتى قيل له أما ترضى وقد أنزلت عليك هذه الآية وإن ربك لذو مغفرة للناس ظلمهم (2) وفي تفسير قوله تعالى {ولسوف يعطيك ربك فترضى} قال","english":"So it was said to him: \"And what is in it of hope?\" He said: \"This world, all of it, is little, and a man's provision from it is little, and his religion is little in comparison to his provision. So look at how God Most High sent down in it the longest verse, to guide His servant to the path of caution in preserving his wealth — so how could He not preserve his religion, which has no substitute for him?\"","book_title":"Fear and Hope","section_title_ar":"Section 1033","section_title_en":"The Book of Hope (Kitāb al-Rajā') — Section 1033: The Second Art — Surveying the Verses and Reports Concerning Hope","section_index":1033,"anchors":"- Root: وجود (w-j-d)\n  * Lisan / Ayn: Core meaning of \"finding\" and \"existence\"; here in the sense of what is present and available.\n  * Al-Raghib (Mufradat): Existence as that which is found and realized; in theological context, the given order of creation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense of \"being found\"; metaphorical (majāz) extension to the entirety of created things.\n- Root: رجا (r-j-w)\n  * Lisan / Ayn: To hope, to expect with desire; the opposite of despair (ya's).\n  * Al-Raghib (Mufradat): Hope as a theological virtue — the heart's expectation of divine mercy, balanced against fear (khawf).\n  * Al-Zamakhshari (Asas): Literal: expectation of a desired outcome; metaphorical: the soul's reliance on divine generosity.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: To cover, to shield, to pardon; the root implies veiling the fault.\n  * Al-Raghib (Mufradat): Divine forgiveness as the covering of sins and the effacing of their consequence.\n  * Al-Zamakhshari (Asas): Literal: covering; metaphorical: God's remission of punishment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to emphasize exclusive attributes of divine mercy and forgiveness.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'","badge":"Insight"}],"9":[{"arabic":"وهو مع ذلك قريب من كل موجود وهو أقرب إلى العبد من حبل الوريد وهو على كل شيء شهيد إذ لا يماثل قربه قرب الأجسام كما لا تماثل ذاته ذات الأجسام وأنه لا يحل في شيء ولا يحل فيه شيء تعالى عن أن يحويه مكان كما تقدس عن أن يحده زمان بل كان قبل أن خلق الزمان والمكان وهو الآن على ما عليه كان وأنه بائن عن خلقه بصفاته ليس في ذاته سواه ولا في سواه ذاته وأنه مقدس عن التغير والانتقال لا تحله الحوادث ولا تعتريه العوارض بل لا يزال في نعوت جلاله منزها عن الزوال وفي صفات كماله مستغنيا عن زيادة الاستكمال وأنه في ذاته معلوم الوجود بالعقول مرئ","english":"- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.","book_title":"On Invocations and Supplications","section_title_ar":"Section 72","section_title_en":"Section 72","section_index":72,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'","badge":"Insight"},{"arabic":"الأصل الأول العلم بأن صانع العالم قادر وأنه تعالى في قوله وهو على كل شيء قدير صادق لأن العالم محكم في صنعته مرتب في خلقته ومن رأى ثوبا من ديباج حسن النسج والتأليف متناسب التطريز والتطريف ثم توهم صدور نسجه عن ميت لا استطاعة له أو عن إنسان لا قدرة له كان منخلعا عن غريزة العقل ومنخرطا في سلك أهل الغباوة والجهل الأصل الثاني العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك","english":"**The Eighth Principle: Knowledge that He, Exalted is He, is established upon His Throne (mustawin ʿalā ʿarshihi) in the sense that God, Exalted is He, intended by istiwāʾ — which is the sense that does not contradict the attribute of Majesty, nor does any mark of origination (ḥudūth) or passing away (fanāʾ) attach to it. And it is the sense intended by His saying — istiwāʾ toward the heaven — where He said in the Qur'an: {«ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ وَهِيَ دُخَانٌ»} (\"Then He directed Himself to the heaven, and it was smoke\") [Fussilat 41:11]. And that is only by way of subjugation (qahr) and dominion (istīlāʾ), as the poet said:","book_title":"On Invocations and Supplications","section_title_ar":"Section 90","section_title_en":"The Revival of the Religious Sciences — Section 90: The Ten Principles Concerning Knowledge of the Divine Attributes","section_index":90,"anchors":"- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denoting the faculty of perception and comprehension; the mark or trace by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from awareness (shiʿr); here, it denotes certain, verified cognition of theological verities.\n- Root: س و ي (s-w-y)\n  * Lisan / Ayn: Root indicating straightness, equality, and levelness; from it derives istiwāʾ (establishing oneself upon, ascending to).\n  * Al-Raghib (Mufradat): Istiwāʾ upon the Throne (al-ʿArsh) is a divine act of sovereign dominion, not corporeal settlement.\n  * Al-Zamakhshari (Asas): Literal sense of physical sitting is impossible for God; metaphorical sense (majāz) of qahr (overpowering) and istīlāʾ (dominion) is necessitated by reason and consensus.\n- Root: ر أ ي (r-ʾ-y)\n  * Lisan / Ayn: Visual perception; also opinion and discernment.\n  * Al-Raghib (Mufradat): Ruʾyah (vision) of God in the Hereafter is a mode of disclosure (kashf) and knowledge (ʿilm), more complete than intellectual cognition, not conditioned by spatial direction.\n  * Al-Zamakhshari (Asas): Literal vision requires corporeality and direction; its application to God demands theological specification (takhṣīṣ) without nullifying the veracity of the scriptural promise.\n- Root: ق د ر (q-d-r)\n  * Lisan / Ayn: Power, measure, decree; the capacity to bring about an act.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is the negation of incapacity (ʿajz); absolute power belongs to God alone, while creatures possess limited capacity.\n  * Al-Zamakhshari (Asas): Literal power over an object; metaphorically, God's power encompasses all things without exertion or instrument.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, applied here to the parsing of \"إلى السماء\" in the verse on istiwāʾ, where the prepositional phrase is delayed to highlight the divine act of sovereign direction toward the heavens.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"}],"11":[{"arabic":"أما صفات الله عز وجل فكقوله تعالى ليس كمثله شيء وهو السميع البصير وكقوله تعالى الملك القدوس السلام المؤمن المهيمن العزيز الجبار المتكبر فليتأمل معاني هذه الأسماء والصفات لينكشف له أسرارها فتحتها معان","english":"Ali, may God be pleased with him, said: \"There is no good in worship that lacks understanding (fiqh), nor in recitation that lacks reflection.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 227","section_title_en":"The Third Book on the Inward Acts During Recitation — Ten in Number","section_index":227,"anchors":"- Root: دبر (d-b-r)\n  * Lisan / Ayn: The rear, the back part; what comes after; to turn one's back; the end or sequel of a thing.\n  * Al-Raghib (Mufradat): That which is opposite of \"front\" (qabal); used metaphorically for what follows or comes after; \"adbar al-nahar\" — the latter part of the day; \"adbar al-sujud\" — the concluding portions of prayers.\n  * Al-Zamakhshari (Asas): Literal: the back or hind part. Metaphorical: what comes at the end, the sequel, the consequence of an affair.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform; the heart as that which is constantly turning and fluctuating between states.\n  * Al-Raghib (Mufradat): The turning and directing of a thing from one face to another; al-taqallub — the constant changing and fluctuation; the heart (qalb) is so named for its perpetual turning about of resolutions and states.\n  * Al-Zamakhshari (Asas): Literal: to turn a thing over from its face. Metaphorical: to ponder, to examine thoroughly, to turn a matter over in the mind — \"qallaba al-amr\" — he examined the affair from all sides.\n- Root: ختم (kh-t-m)\n  * Lisan / Ayn: To seal, to stamp, to imprint; the seal or stamp itself.\n  * Al-Raghib (Mufradat): Sealing and stamping — used both for the act of impressing and the impression left; metaphorically employed for securing a thing and preventing access to it, as in {«ختم الله على قلوبهم»} (God sealed their hearts).\n  * Al-Zamakhshari (Asas): Literal: placing a seal upon something. Metaphorical: to conclude, to finish, to bring to an end — \"khatama al-Qur'an\" — he completed the recitation of the Quran.\n- Root: بقي (b-q-y)\n  * Lisan / Ayn: To remain, to endure, to persist; the lasting and continuing of a thing.\n  * Al-Raghib (Mufradat): The persistence of a thing upon its original state; that which remains (al-baqi) is of two kinds: that which remains by itself without limit — and that is the Creator, may He be exalted — and that which remains by another, which is everything other than Him.\n  * Al-Zamakhshari (Asas): Literal: to remain, to stay. Metaphorical: \"baqiya al-shay'\" — the enduring of a thing; \"ma baqiyat minhum baqiyah\" — not one of them remained.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the construction \"innama\" is employed, it restricts the predicate to the subject alone, excluding all else. This is pertinent here as the author delimits the inward acts of recitation to precisely ten, no more and no less.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"}],"14":[{"arabic":"بينهم} قيل في التفسير حسدا وقال تعالى {وما تفرقوا إلا من بعد ما جاءهم العلم بغيا بينهم} فأنزل الله العلم ليجمعهم ويؤلف بينهم على طاعته وأمرهم أن يتألفوا بالعلم فتحاسدوا واختلفوا إذ أراد كل واحد منهم أن ينفرد بالرياسة وقبول القول فرد بعضهم على بعض قال ابن عباس كانت اليهود قبل أن يبعث النبي صلى الله عليه وسلم إذا قاتلوا قوما قالوا نسألك بالنبي الذي وعدتنا أن ترسله وبالكتاب الذي تنزله إلا ما نصرتنا (1) فكانوا ينصرون فلما جاء النبي صلى الله عليه وسلم من ولد إسماعيل عليه السلام عرفوه وكفروا به بعد معرفتهم إياه فقال تعالى {وكانوا من قبل ي","english":"The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"","book_title":"Condemnation of Envy","section_title_ar":"Section 720","section_title_en":"On the Reality of Envy (Ḥasad) and Its Degrees — Section 720","section_index":720,"anchors":"- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Envy'","badge":"Hadith"}],"20":[{"arabic":"أزهد فيها فوصف الزهد بأنه من أحسن الأعمال وقال تعالى من كان يريد حرث الآخرة نزد له في حرثه ومن كان يريد حرث الدنيا نؤته منها وما له في الآخرة من نصيب وقال تعالى ولا تمدن عينيك إلى ما متعنا به أزواجا منهم زهرة الحياة الدنيا لنفتنهم فيه ورزق ربك خير وأبقى وقال تعالى الذين يستحبون الحياة الدنيا على الآخرة فوصف الكفار بذلك فمفهومه أن المؤمن هو الذي يتصف بنقيضه وهو أن يستحب الآخرة على الحياة الدنيا وأما الأخبار فما ورد منها في ذم الدنيا كثير وقد أوردنا بعضها في كتاب ذم الدنيا مع ربع المهلكات إذ حب الدنيا من المهلكات ونحن الآن نقتصر على فضيلة بغض الدنيا فإنه من المنجيات وهو المعني بالزهد وقد قال","english":"Allah the Exalted said: {فخرج على قومه في زينته} [He went out to his people in his adornment] up to His saying, the Exalted: {وقال الذين أوتوا العلم ويلكم ثواب الله خير لمن آمن} [And those who had been given knowledge said, \"Woe to you! The reward of Allah is better for he who believes.\"] Thus He attributed renunciation (al-zuhd) to the learned, and described its people as possessing knowledge—and this is the ultimate praise. And He said, the Exalted: {أولئك يؤتون أجرهم مرتين بما صبروا} [Those will be given their reward twice for what they patiently endured], and it came in the exegesis (al-tafsīr) that this refers to renunciation of the world. And He said, Mighty and Majestic: {إنا جعلنا ما على الأرض زينة لها لنبلوهم أيهم أحسن عملا} [Indeed We have made that which is on the earth adornment for it that We may test them as to which of them is best in deed]. It was said its meaning is: which of them is most renunciant (azhad) in it. So He described renunciation as being among the most excellent of deeds. And He said, the Exalted: {من كان يريد حرث الآخرة نزد له في حرثه ومن كان يريد حرث الدنيا نؤته منها وما له في الآخرة من نصيب} [Whoever desires the harvest of the Hereafter—We increase for him in his harvest. And whoever desires the harvest of this world—We give him from it, but he has no share in the Hereafter]. And He said, the Exalted: {ولا تمدن عينيك إلى ما متعنا به أزواجا منهم زهرة الحياة الدنيا لنفتنهم فيه ورزق ربك خير وأبقى} [And do not extend your eyes to that which We have given enjoyment to categories of them—the splendor of the life of this world—that We may test them thereby. And the provision of your Lord is better and more enduring]. And He said, the Exalted: {الذين يستحبون الحياة الدنيا على الآخرة} [Those who prefer the life of this world over the Hereafter]—thus He described the disbelievers with that. So its understood implication (mafhūmuhu) is that the believer is the one characterized by its opposite, namely, that he prefers the Hereafter over the life of this world. [PageV04P219]","book_title":"Poverty and Abstinence","section_title_ar":"Section 1090","section_title_en":"The Book of Renunciation (Kitāb al-Zuhd) — Section on the Virtue of Despising the World","section_index":1090,"anchors":"- Root: زهد (z-h-d)\n  * Lisan / Ayn: Core meaning of abstaining, forsaking, and turning away from something, deeming it insignificant and paltry.\n  * Al-Raghib (Mufradat): Theological nuance: الزهد is the voluntary turning of the heart away from the world (al-dunyā) as a deliberate act of spiritual preference for the Hereafter, not mere physical poverty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes abstention from a thing due to its worthlessness; Metaphorical (Majaz) usage in the religious context signifies the heart's detachment from worldly allurements while the body may still function within it.\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness, proximity; the world (al-dunyā) is so named for its closeness and lower station relative to the Hereafter.\n  * Al-Raghib (Mufradat): الدنو: القرب بالذات أو بالحكم; al-dunyā is the lower, nearer abode, contrasted with the ultimate and enduring one.\n  * Al-Zamakhshari (Asas): Literal: spatial or temporal nearness; Metaphorical: the world as the inferior, immediate realm that precedes the eternal one.\n- Root: عقل (ʿ-q-l) — implied in \"مفهومه\" (its understood implication)\n  * Lisan / Ayn: Understanding, intellect, that which binds and restrains.\n  * Al-Raghib (Mufradat): The intellect perceives the conceptual implication (mafhūm) of a statement, deriving the necessary opposite or corollary.\n  * Al-Zamakhshari (Asas): Literal: the articulated text; Metaphorical: the understood converse (mafhūm al-mukhālafah) which the author here employs to establish the believer's trait.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the author's argumentation, where the governing verb (e.g., \"قال تعالى\") is separated from its quoted object by lengthy parenthetical citations, mirrors the classical allowance for interposition to maintain rhetorical flow and emphasis.","content_type":"dhikr","topic":"Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Poverty and Abstinence'","badge":"Dhikr"}],"21":[{"arabic":"ولكن حق الداخل إذا لم يتربص وأتفق أن صادفهم على طعام أن لا يأكل ما لم يؤذن له فإذا قيل له كل نظر فإن علم أنهم يقولونه على محبة لمساعدته فليساعد وإن كانوا يقولونه حياء منه فلا ينبغي أن يأكل بل ينبغي أن يتعلل أما إذا كان جائعا فقصد بعض إخوانه ليطعمه ولم يتربص به وقت أكله فلا بأس به قصد رسول الله صلى الله عليه وسلم وأبو بكر وعمر رضي الله عنهما منزل أبي الهيثم بن التيهان وأبي أيوب الأنصاري لأجل طعام يأكلونه وكانوا جياعا (1) والدخول على مثل هذه الحالة إعانة لذلك المسلم على حيازة ثواب الإطعام وهي عادة الس","english":"Jaʿfar ibn Muḥammad (may God be pleased with him and his father) said: \"When you sit with your brothers at the table, prolong the sitting — for that hour is not reckoned against you from your lifespans.\"","book_title":"Manners of Eating","section_title_ar":"Section 288","section_title_en":"On Presenting Food to Brothers — Its Excellence and Etiquettes","section_index":288,"anchors":"- Root: ق-د-م (q-d-m)\n  * Lisan / Ayn: \"To present, offer, bring forward; to advance. Taqdīm (تقديم) is the act of setting something before another, whether physically or in rank.\"\n  * Al-Raghib (Mufradat): \"Al-Qudum (القدوم) is arrival; taqdīm is causing something to arrive before another. In the context of hospitality, it signifies the voluntary offering of provision (rizq) to a guest as an act of drawing near (taqarrub) to God.\"\n  * Al-Zamakhshari (Asas): \"Literal (haqīqah): placing food before a person. Metaphorical (majāz): preferring or advancing someone in honor — as in 'qaddamahu' meaning he honored him.\"\n- Root: أ-ك-ل (a-k-l)\n  * Lisan / Ayn: \"To eat, to consume. Al-Akl (الأكل) is the taking of nourishment. Al-Aklah (الأكلة) is a single morsel or bite.\"\n  * Al-Raghib (Mufradat): \"Al-Akl: partaking of food. By way of metaphor, it is said 'the fire ate the wood.' The root carries the sense of receiving what sustains — and in the Hereafter, the reckoning (hisāb) is lifted from what one eats with brothers, for it partakes of the character of worship.\"\n  * Al-Zamakhshari (Asas): \"Literal: consuming food. Metaphorical: 'he ate my wealth' meaning he spent it among people. Here, the eating with brothers is elevated beyond mere consumption to an act of spiritual communion.\"\n- Root: ك-ل-ف (k-l-f)\n  * Lisan / Ayn: \"Takalluf (تكلف) is burdening oneself with what is beyond one's capacity or custom — affectation, straining to exceed the ordinary.\"\n  * Al-Raghib (Mufradat): \"Al-Kulfah (الكلفة) is the hardship one undertakes. Takalluf is assuming a burden unnecessarily — and in hospitality, it is condemned because it introduces pretense (riyā') and disrupts the naturalness of brotherly love.\"\n  * Al-Zamakhshari (Asas): \"Literal: imposing upon oneself. Metaphorical: the affectation that severs the bonds of friendship, for when a man strains for his guest, the guest feels the weight and ceases to return.\"\n- Root: ض-ي-ف (d-y-f)\n  * Lisan / Ayn: \"Al-Dayf (الضيف) is the guest; the root conveys inclination and leaning toward — the guest leans upon the host's generosity.\"\n  * Al-Raghib (Mufradat): \"Iḍāfah (الإضافة) is inclining toward another for refuge. The guest (dayf) is so named because he inclines toward the host's table. True hospitality (diyāfah) is rendering honor without ostentation.\"\n  * Al-Zamakhshari (Asas): \"Literal: the one who arrives seeking shelter. Metaphorical: the soul's inclination toward what is offered — and the host's soul should incline toward the guest with sincerity, not show.\"\n- Sibawayh Rule: Bāb al-Ḥaṣr wa-l-Taqyīd bi-Innamā (Restriction & Focused Predication) — The conditional and restrictive constructions in the ḥadīth reports (e.g., \"lā yuḥāsabu al-ʿabdu ʿalā mā ya'kulu maʿa ikhwānihi\") employ the negative restriction to single out the act of brotherly eating from the general reckoning, requiring the translator to preserve the exclusivity of the predicate.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Manners of Eating'","badge":"Insight"}],"22":[{"arabic":"دونه وادعى الإجماع فيه واستدل بأدلة تشعر بنقيض غرضه كقوله تعالى {الذين آمنوا وعملوا الصالحات} إذ هذا يدل على أن العمل وراء الإيمان لا من نفس الإيمان وإلا فيكون العمل في حكم المعاد والعجب أنه ادعى الإجماع في هذا وهو مع ذلك ينقل قوله صلى الله عليه وسلم لا يكفر أحد إلا بعد جحوده لما أقر به (1) وينكر على المعتزلة قولهم بالتخليد في النار بسبب الكبائر والقائل بهذا قائل بنفس مذهب المعتزلة إذ يقال له من صدق بقلبه وشهد بلسانه ومات في الحال فهل هو في الجنة فلا بد أن يقول نعم وفيه حكم بوجود الإيمان دون العمل فنزيد ونقول لو بقي حيا حتى دخل عليه وقت","english":"He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.","book_title":"Foundations of Belief","section_title_ar":"Section 99","section_title_en":"The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments","section_index":99,"anchors":"- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'","badge":"Insight"}],"24":[{"arabic":"الله تعالى بين من افترى على الله كذبا وبين من كذب بالحق فقال تعالى ومن أظلم ممن افترى على الله كذبا أو كذب بالحق لما جاءه وقال تعالى فمن أظلم ممن كذب على الله وكذب بالصدق إذ جاءه ومنها الرياء وملاحظة الخلق والجهد في استمالة قلوبهم وصرف وجوههم والرياء هو الداء العضال الذي يدعو إلى أكبر الكبائر كما سيأتي في كتاب الرياء والمناظر لا يقصد إلا الظهور عند الخلق وانطلاق ألسنتهم بالثناء عليه فهذه عشر خصال من أمهات الفواحش الباطنة سوى ما يتفق لغير المتماسكين منهم من الخصام المؤدي إلى الضرب","english":"**QUAD_ANCHORS:**\n- Root: نظر (naẓara)\n  * Lisan / Ayn: Core meaning: to look, to examine, to consider; al-munāẓarah is mutual examination/argumentation between two parties.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as intellectual contemplation (taʾammul bi-l-baṣīrah); munāẓarah as dialectical exchange.\n  * Al-Zamakhshari (Asas): Literal: sitting face-to-face in debate; Metaphorical: disputation for victory.\n- Root: غلب (ghalaba)\n  * Lisan / Ayn: Core meaning: to overcome, to conquer, to prevail.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghalabah as seeking to dominate another in argument.\n  * Al-Zamakhshari (Asas): Literal: victory in combat; Metaphorical: intellectual supremacy.\n- Root: حسد (ḥasada)\n  * Lisan / Ayn: Core meaning: to envy, to wish removal of blessings from another.\n  * Al-Raghib (Mufradat): Theological nuance: envy as wishing deprivation of blessings from the deserving — among the basest traits.\n  * Al-Zamakhshari (Asas): Literal: envy of another's blessing; Metaphorical: consuming fire of the soul.\n- Root: كبر (kabura)\n  * Lisan / Ayn: Core meaning: to be great, to be haughty.\n  * Al-Raghib (Mufradat): Theological nuance: al-kibr as self-elevation above others; condemned by God.\n  * Al-Zamakhshari (Asas): Literal: greatness; Metaphorical: arrogance and pride.\n- Root: غيب (ghāba)\n  * Lisan / Ayn: Core meaning: to be absent, to be hidden.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghībah as mentioning another with what he dislikes in his absence — likened to eating carrion.\n  * Al-Zamakhshari (Asas): Literal: backbiting; Metaphorical: consuming the flesh of one's brother.\n- Root: راءى (rāʾā)\n  * Lisan / Ayn: Core meaning: to show off, to display.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as performing acts for the sake of being seen — hidden shirk.\n  * Al-Zamakhshari (Asas): Literal: showing good deeds; Metaphorical: seeking reputation.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Core meaning: self, soul, spirit.\n  * Al-Raghib (Mufradat): Theological nuance: tazkiyat al-nafs as self-praise and self-purification — forbidden by God.\n  * Al-Zamakhshari (Asas): Literal: self; Metaphorical: self-commendation.\n- Root: حقd (ḥaqida)\n  * Lisan / Ayn: Core meaning: to bear malice, to harbor resentment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ḥiqd as nursing enmity in the heart — negated from the believer.\n  * Al-Zamakhshari (Asas): Literal: bearing grudge; Metaphorical: hidden rancor.\n- Root: نفاق (nifāq)\n  * Lisan / Ayn: Core meaning: hypocrisy, showing contrary to what one conceals.\n  * Al-Raghib (Mufradat): Theological nuance: hypocrisy in deeds — outward display contrary to inward state.\n  * Al-Zamakhshari (Asas): Literal: hypocrisy in faith; Metaphorical: hypocrisy in character.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning: to know, to perceive.\n  * Al-Raghib (Mufradat): Theological nuance: knowledge as apprehension of reality — its pursuit for other than God is destructive.\n  * Al-Zamakhshari (Asas): Literal: knowledge; Metaphorical: the dangerous burden of the scholar.\n- Root: جدل (jadala)\n  * Lisan / Ayn: Core meaning: to argue, to dispute.\n  * Al-Raghib (Mufradat): Theological nuance: al-jidāl as contention; al-mirāʾ as disputation with falsehood — condemned.\n  * Al-Zamakhshari (Asas): Literal: argumentation; Metaphorical: obstinate disputation.\n- Root: شرك (sharaka)\n  * Lisan / Ayn: Core meaning: to associate, to share.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as hidden shirk — associating others with God in intention.\n  * Al-Zamakhshari (Asas): Literal: polytheism; Metaphorical: hidden association in deeds.\n- Root: موت (māta)\n  * Lisan / Ayn: Core meaning: to die.\n  * Al-Raghib (Mufradat): Theological nuance: death as separation of soul from body; spiritual death as ruin of the soul.\n  * Al-Zamakhshari (Asas): Literal: physical death; Metaphorical: spiritual destruction.\n- Root: حيى (ḥayiya)\n  * Lisan / Ayn: Core meaning: to live.\n  * Al-Raghib (Mufradat): Theological nuance: life as the power of perception; eternal life as the reward of the righteous.\n  * Al-Zamakhshari (Asas): Literal: physical life; Metaphorical: spiritual vitality.\n- Root: هلك (halaka)\n  * Lisan / Ayn: Core meaning: to perish, to be destroyed.\n  * Al-Raghib (Mufradat): Theological nuance: al-halāk as ruin; eternal destruction as everlasting punishment.\n  * Al-Zamakhshari (Asas): Literal: destruction; Metaphorical: eternal ruin.\n- Root: رياء (riyāʾ)\n  * Lisan / Ayn: Core meaning: showing off, ostentation.\n  * Al-Raghib (Mufradat): Theological nuance: riyāʾ as the incurable disease calling to the greatest sins.\n  * Al-Zamakhshari (Asas): Literal: ostentation; Metaphorical: spiritual disease.\n- Root: جاه (jāh)\n  * Lisan / Ayn: Core meaning: rank, status, prestige.\n  * Al-Raghib (Mufradat): Theological nuance: love of status (ḥubb al-jāh) among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: position; Metaphorical: seeking prestige.\n- Root: مباهاة (mubāhāh)\n  * Lisan / Ayn: Core meaning: mutual boasting, vying in splendor.\n  * Al-Raghib (Mufradat): Theological nuance: mubāhāh as each seeking to display superiority over the other.\n  * Al-Zamakhshari (Asas): Literal: mutual boasting; Metaphorical: rivalry in honor.\n- Root: مماراة (mumārāh)\n  * Lisan / Ayn: Core meaning: disputation, wrangling.\n  * Al-Raghib (Mufradat): Theological nuance: al-mirāʾ as contentious argument — condemned by the Prophet.\n  * Al-Zamakhshari (Asas): Literal: disputation; Metaphorical: obstinate wrangling.\n- Root: فخر (fakhara)\n  * Lisan / Ayn: Core meaning: to boast, to pride oneself.\n  * Al-Raghib (Mufradat): Theological nuance: al-fakhr as self-glorification — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: boasting; Metaphorical: vainglory.\n- Root: عجب (ʿajiba)\n  * Lisan / Ayn: Core meaning: to wonder, to be amazed.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿujb as self-admiration — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: wonder; Metaphorical: self-conceit.\n- Root: بغض (baghiḍa)\n  * Lisan / Ayn: Core meaning: to hate, to detest.\n  * Al-Raghib (Mufradat): Theological nuance: al-baghdāʾ as mutual hatred — contrary to brotherhood.\n  * Al-Zamakhshari (Asas): Literal: hatred; Metaphorical: mutual enmity.\n- Root: غضب (ghaḍiba)\n  * Lisan / Ayn: Core meaning: to be angry.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaḍab as anger — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: anger; Metaphorical: rage.\n- Root: طمع (ṭamiʿa)\n  * Lisan / Ayn: Core meaning: to covet, to desire.\n  * Al-Raghib (Mufradat): Theological nuance: al-ṭamaʿ as covetousness — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: desire; Metaphorical: greed.\n- Root: أشر (ashira)\n  * Lisan / Ayn: Core meaning: to be exultant, to be insolent.\n  * Al-Raghib (Mufradat): Theological nuance: al-ashar as excessive joy and insolence — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: exultation; Metaphorical: insolence.\n- Root: بطر (baṭira)\n  * Lisan / Ayn: Core meaning: to be arrogant, to be ungrateful.\n  * Al-Raghib (Mufradat): Theological nuance: al-baṭar as arrogance in prosperity — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: arrogance; Metaphorical: ingratitude for blessings.\n- Root: خيلاء (khuyalāʾ)\n  * Lisan / Ayn: Core meaning: pride, haughtiness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khuyalāʾ as pride and conceit — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: pride; Metaphorical: haughty bearing.\n- Root: خشية (khashyah)\n  * Lisan / Ayn: Core meaning: fear, awe.\n  * Al-Raghib (Mufradat): Theological nuance: al-khashyah as reverential fear — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: fear; Metaphorical: reverential awe.\n- Root: رحمة (raḥmah)\n  * Lisan / Ayn: Core meaning: mercy, compassion.\n  * Al-Raghib (Mufradat): Theological nuance: al-raḥmah as tenderness of heart — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: mercy; Metaphorical: compassion.\n- Root: غفلة (ghaflah)\n  * Lisan / Ayn: Core meaning: heedlessness, inattention.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaflah as heedlessness — contrary to vigilance.\n  * Al-Zamakhshari (Asas): Literal: inattention; Metaphorical: spiritual heedlessness.\n- Root: خشوع (khushūʿ)\n  * Lisan / Ayn: Core meaning: humility, submissiveness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khushūʿ as humility — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: humility; Metaphorical: devotional submission.\n- Root: تذكير (tadhkīr)\n  * Lisan / Ayn: Core meaning: reminding, admonishing.\n  * Al-Raghib (Mufradat): Theological nuance: al-tadhkīr as reminding of God — a righteous act.\n  * Al-Zamakhshari (Asas): Literal: reminding; Metaphorical: preaching.\n- Root: وعظ (waʿaẓa)\n  * Lisan / Ayn: Core meaning: to admonish, to exhort.\n  * Al-Raghib (Mufradat): Theological nuance: al-waʿẓ as exhortation to obedience and warning against disobedience.\n  * Al-Zamakhshari (Asas): Literal: admonition; Metaphorical: sermonizing.\n- Root: فتوى (fatwā)\n  * Lisan / Ayn: Core meaning: legal ruling, formal opinion.\n  * Al-Raghib (Mufradat): Theological nuance: al-fatwā as clarification of legal rulings.\n  * Al-Zamakhshari (Asas): Literal: legal opinion; Metaphorical: religious authority.\n- Root: قضاء (qaḍāʾ)\n  * Lisan / Ayn: Core meaning: judgment, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-qaḍāʾ as judgment between people.\n  * Al-Zamakhshari (Asas): Literal: judgment; Metaphorical: judicial authority.\n- Root: وقف (waqafa)\n  * Lisan / Ayn: Core meaning: to stop, to stand.\n  * Al-Raghib (Mufradat): Theological nuance: al-waqf as endowment of property for charitable purposes.\n  * Al-Zamakhshari (Asas): Literal: standing; Metaphorical: religious endowment.\n- Root: ثواب (thawāb)\n  * Lisan / Ayn: Core meaning: reward, recompense.\n  * Al-Raghib (Mufradat): Theological nuance: al-thawāb as divine recompense for righteous deeds.\n  * Al-Zamakhshari (Asas): Literal: reward; Metaphorical: divine recompense.\n- Root: عذاب (ʿadhāb)\n  * Lisan / Ayn: Core meaning: punishment, torment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿadhāb as divine punishment for the disobedient.\n  * Al-Zamakhshari (Asas): Literal: punishment; Metaphorical: divine chastisement.\n- Root: ملك (malaka)\n  * Lisan / Ayn: Core meaning: to possess, to rule.\n  * Al-Raghib (Mufradat): Theological nuance: al-mulk as sovereignty; al-mulk al-muʾabbad as eternal sovereignty in Paradise.\n  * Al-Zamakhshari (Asas): Literal: dominion; Metaphorical: eternal kingdom.\n- Root: نعيم (naʿīm)\n  * Lisan / Ayn: Core meaning: bliss, delight.\n  * Al-Raghib (Mufradat): Theological nuance: al-naʿīm as bliss; al-naʿīm al-sarmad as everlasting bliss.\n  * Al-Zamakhshari (Asas): Literal: delight; Metaphorical: eternal bliss.\n- Root: رخصة (rukhaṣah)\n  * Lisan / Ayn: Core meaning: concession, dispensation.\n  * Al-Raghib (Mufradat): Theological nuance: al-rukhaṣah as legal concession.\n  * Al-Zamakhshari (Asas): Literal: concession; Metaphorical: legal dispensation.\n- Root: رياسة (riyāsah)\n  * Lisan / Ayn: Core meaning: leadership, headship.\n  * Al-Raghib (Mufradat): Theological nuance: love of leadership among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: leadership; Metaphorical: seeking authority.\n- Root: اندراس (indirās)\n  * Lisan / Ayn: Core meaning: effacement, obliteration.\n  * Al-Raghib (Mufradat): Theological nuance: indirās al-ʿulūm as the obliteration of the sciences.\n  * Al-Zamakhshari (Asas): Literal: effacement; Metaphorical: extinction of knowledge.\n- Root: صبيان (ṣibyān)\n  * Lisan / Ayn: Core meaning: boys, children.\n  * Al-Raghib (Mufradat): Theological nuance: children's motivation for learning through play.\n  * Al-Zamakhshari (Asas): Literal: boys; Metaphorical: pupils.\n- Root: مكتب (maktab)\n  * Lisan / Ayn- Root: مكتب (maktab)\n  * Lisan / Ayn: Core meaning: place of instruction, school for boys.\n  * Al-Raghib (Mufradat): Theological nuance: the elementary school where children are taught.\n  * Al-Zamakhshari (Asas): Literal: school; Metaphorical: place of elementary learning.\n- Root: خلاق (khilāq)\n  * Lisan / Ayn: Core meaning: portion, share, lot.\n  * Al-Raghib (Mufradat): Theological nuance: \"no portion\" (lā khilāq) in the Hereafter — utter deprivation of divine reward.\n  * Al-Zamakhshari (Asas): Literal: share; Metaphorical: spiritual allotment in the afterlife.\n- Root: فاجر (fājir)\n  * Lisan / Ayn: Core meaning: wicked, immoral, profligate.\n  * Al-Raghib (Mufradat): Theological nuance: the dissolute one who commits sins openly.\n  * Al-Zamakhshari (Asas): Literal: sinner; Metaphorical: one through whom God nonetheless supports religion.\n- Root: شمع (shamʿ)\n  * Lisan / Ayn: Core meaning: candle, wax taper.\n  * Al-Raghib (Mufradat): Theological nuance: the candle as parable — consuming itself while giving light to others.\n  * Al-Zamakhshari (Asas): Literal: candle; Metaphorical: one who destroys himself but benefits others.\n- Root: نار (nār)\n  * Lisan / Ayn: Core meaning: fire.\n  * Al-Raghib (Mufradat): Theological nuance: fire as parable — consuming itself and all around it.\n  * Al-Zamakhshari (Asas): Literal: fire; Metaphorical: one who destroys himself and others.\n- Root: سعد (saʿida)\n  * Lisan / Ayn: Core meaning: to be fortunate, to prosper.\n  * Al-Raghib (Mufradat): Theological nuance: saʿādah as felicity — success in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: good fortune; Metaphorical: eternal felicity.\n- Root: شقي (shaqiya)\n  * Lisan / Ayn: Core meaning: to be wretched, to be miserable.\n  * Al-Raghib (Mufradat): Theological nuance: shaqāwah as wretchedness — ruin in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: misery; Metaphorical: eternal ruin.\n- Root: أخلص (akhlaṣa)\n  * Lisan / Ayn: Core meaning: to purify, to be sincere.\n  * Al-Raghib (Mufradat): Theological nuance: ikhlāṣ as purifying intention for God alone — the condition of acceptance.\n  * Al-Zamakhshari (Asas): Literal: sincerity; Metaphorical: pure devotion.\n- Root: ريب (rāba)\n  * Lisan / Ayn: Core meaning: to doubt, to suspect.\n  * Al-Raghib (Mufradat): Theological nuance: al-rayb as doubt and uncertainty — to be dispelled by evidence.\n  * Al-Zamakhshari (Asas): Literal: doubt; Metaphorical: skepticism.","book_title":"Book of Knowledge","section_title_ar":"Section 39","section_title_en":"Section 39","section_index":39,"anchors":"*(Anchors established)*","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Book of Knowledge'","badge":"Ethics"}],"25":[{"arabic":"والله يعلم ما في أنفسكم فاحذروه فاستغفرت الله في سري فناداني وقال {وهو الذي يقبل التوبة عن عباده} ثم غاب عني ولم أره وقال زكريا بن داود دخل أبو العباس بن مسروق على أبي الفضل الهاشمي وهو عليل وكان ذا عيال ولم يعرف له سبب يعيش به قال فلما قمت قلت في نفسي من أين يأكل هذا الرجل قال فصاح بي يا أبا العباس رد هذه الهمة الدنية فإن لله تعالى ألطافا خفية وقال أحمد النقيب دخلت على الشبلي فقال مفتونا يا أحمد فقلت ما الخبر قال كنت جالسا فجرى بخاطري أنك بخيل فقلت ما أنا بخيل فعاد مني خاطري وقال بل أنت بخيل فقلت ما فتح اليوم علي بشيء إلا دفعته","english":"As for the evidences of the Sacred Law, there is His saying (Exalted is He): {«وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا»} (\"And those who strive in Us, We shall surely guide them to Our paths\") (Q. 29:69). So every wisdom that appears from the heart through persevering devotion to worship, without learning, is by way of unveiling and inspiration. And he (peace and blessings be upon him) said: \"Whoever acts upon what he knows, God bequeaths to him knowledge of what he does not know, and grants him success in what he does\" — until he becomes deserving of Paradise. And whoever does not act upon what he knows wanders astray in what he knows and is not granted success in what he does, until he becomes deserving of the Fire. [The hadith \"Whoever acts upon what he knows\" has preceded in the Book of Knowledge, without his saying \"and grants him success in what he does\" — I have not found it with that addition.] And God (Exalted is He) said: {«وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا»} (\"And whoever fears God, He makes for him a way out\") (Q. 65:2) — from perplexities and doubts — {«وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ»} (\"and provides for him from whence he does not reckon\") (Q. 65:3) — teaching him knowledge without learning and granting him discernment without experience. And God (Exalted is He) said: {«يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا»} (\"O you who believe, if you fear God, He will make for you a criterion\") (Q. 8:29) — it is said: a light by which one distinguishes between truth and falsehood and by which one emerges from doubts. For this reason, he (peace and blessings be upon him) was abundant in his supplication in asking for light, saying (peace and blessings be upon him): \"O God, grant me light, and increase me in light, and make for me light in my heart, and light in my grave, and light in my hearing, and light in my sight\" — until he said: \"and light in my hair, and in my skin, and in my flesh, and in my blood, and in my bones.\" [Agreed upon (by al-Bukhari and Muslim).] [The hadith concerning his being asked about His saying {«أَفَمَنْ شَرَحَ اللَّهُ صَدْرَهُ لِلْإِسْلَامِ»} (\"Is he whose breast God has expanded for Islam\") (Q. 39:22) — and in al-Mustadrak from the hadith of Ibn Masʿūd — has preceded in the Book of Knowledge.] And he (peace and blessings be upon him) said concerning Ibn ʿAbbās: \"O God, grant him understanding in religion and teach him the interpretation (taʾwīl).\" [The hadith of ʿAlī: \"We have nothing with us that the Messenger of God (peace and blessings be upon him) confided to us except that God grants a servant understanding in His Book\" — has preceded in the Etiquettes of Qurʾanic Recitation.] And it is said in the interpretation of His saying (Exalted is He): {«يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ»} (\"He grants wisdom to whom He wills\") (Q. 2:269) that it is understanding in the Book of God. And He (Exalted is He) said: {«فَفَهَّمْنَاهَا سُلَيْمَانَ»} (\"And We made Solomon understand it\") (Q. 21:79) — singling out what was unveiled with the name of understanding (fahm). And Abū al-Dardāʾ used to say: \"The believer is one who sees by the light of God from behind a thin veil. By God, it is the truth that God casts into their hearts and causes to flow upon their tongues.\" And some of the Salaf said: \"The believer's conjecture is like soothsaying.\"","book_title":"Condemnation of Delusion","section_title_ar":"Section 594","section_title_en":"The Unveiling of Knowledge Through Divine Inspiration and the Evidences of the Unseen","section_index":594,"anchors":"- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning encompasses both perception of a thing's essence and judgment upon it—knowledge as direct apprehension or discursive ruling.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence (transitive to one object) and judgment upon existence or non-existence (transitive to two objects).\n  * Al-Zamakhshari (Asas): Literal usage denotes certainty and awareness (\"ما علمت بخبرك: ما شعرت به\"); metaphorical extension applies to marks, signs, and beacons of guidance (معالم الطريق) — here, the inspired knowledge is a \"mark\" of the path.\n- Root: كشف (kashafa)\n  * Lisan / Ayn: To remove a covering, unveil, disclose what was hidden.\n  * Al-Raghib (Mufradat): Unveiling (kashf) in theological terms is the removal of the veil (ghishāwah) from the heart such that the realities of things become directly witnessed, not merely inferred.\n  * Al-Zamakhshari (Asas): Literal: to lift a covering from a thing; metaphorical: the disclosure of inward states and hidden matters — the heart's eye perceives what the outward senses cannot.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, devour; farāsah — the lion's pouncing upon its prey.\n  * Al-Raghib (Mufradat): Discernment (farāsah) is a spiritual perception by which the believer penetrates into the inner states of others, a light cast by God into the heart.\n  * Al-Zamakhshari (Asas): Literal: the beast of prey seizing its quarry; metaphorical: the believer's insight seizing the truth of a matter or the hidden state of a person — \"اتقوا فراسة المؤمن فإنه ينظر بنور الله.\"\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: To be new, originate after non-existence; muḥaddath — one who is spoken to, inspired with true speech from the unseen.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence; the muḥaddath is one to whom divine inspiration comes as a new, immediate occurrence without acquired means.\n  * Al-Zamakhshari (Asas): Literal: newness of a thing; metaphorical: \"كان عمر رضي الله عنه محدثا أي صادق الحدس، كأنما حدث بما ظن\" — one whose intuition is so true it is as if he were directly spoken to.\n- Sibawayh Rule: Restriction and specification (الحصر والتقييد) — the particle \"إنما\" and conditional clauses (إن/إذا) restrict predicates to their subjects, as in \"إنما العالم الذي يأخذ علمه من ربه\" — the true scholar is exclusively the one who takes knowledge from his Lord.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'","badge":"Insight"}],"26":[{"arabic":"وروي في غريب التفسير في قوله تعالى {ويستجيب الذين آمنوا وعملوا الصالحات ويزيدهم من فضله} قال يشفعهم في إخوانهم فيدخلهم الجنة معهم ويقال إذا غفر الله للعبد شفع في إخوانه ولذلك حث جماعة من السلف على الصحبة والألفة والمخالطة وكرهوا العزلة والانفراد فهذه فوائد تستدعي كل فائدة شروطا لا تحصل إلا بها ونحن نفصلها أما على الجملة فينبغي أن يكون فيمن تؤثر صحبته خمس خصال أن يكون عاقلا حسن الخلق غير فاسق ولا مبتدع ولا حريص على الدنيا أما العقل فهو رأس المال وهو الأصل فلا خير في صحبة الأحمق فإلى الوحشة والقطيعة ترجع عاقبتها وإن طالت قال علي رضي ا","english":"Know that not every person is fit for companionship. The Prophet (peace and blessings be upon him) said: {«A man follows the religion of his intimate friend; so let each of you consider whom he takes as an intimate friend»}. One must therefore be distinguished by traits and qualities on account of which his companionship is desired, and those qualities are stipulated according to the benefits sought from companionship — for the meaning of a condition (sharṭ) is that without which the attainment of the intended object is impossible. Thus, in relation to the intended object, the conditions become manifest.","book_title":"Duties of Brotherhood","section_title_ar":"Section 414","section_title_en":"Exposition of the Qualities Required in One Whose Companionship Is Chosen","section_index":414,"anchors":"- Root: صحب (ṣ-ḥ-b)\n  * Lisan / Ayn: Companionship, association, intimacy of attachment — whether by body, place, or time; the companion is the one who is constantly attendant upon another.\n  * Al-Raghib (Mufradat): Companionship (ṣuḥbah) may be physical — which is the original and most common sense — or by care and concern; the term extends to every thing that is attached to another as its possessor or associate.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): bodily association and fellowship. Metaphorical (majāz): \"companion of wealth or knowledge\" — i.e., one who is attached to it in concern; \"companion of the sword and spear\" for the warrior.\n- Root: عقل (ʿ-q-l)\n  * Lisan / Ayn: Intellect; that which restrains and binds one from error; the faculty of understanding and discernment.\n  * Al-Raghib (Mufradat): ʿAql is said of the faculty disposed to receive knowledge, and also of the knowledge acquired by that faculty; it is the instrument by which one apprehends things as they are.\n  * Al-Zamakhshari (Asas): Literal: understanding and discernment after ignorance. Metaphorical: \"a palm tree that does not accept pollination\" — i.e., does not take in what would benefit it.\n- Root: غرض (gh-r-ḍ)\n  * Lisan / Ayn: Target, aim, purpose; that at which one shoots; then applied to every goal one seeks to attain.\n  * Al-Raghib (Mufradat): The object aimed at; divided into deficient aims (those pursued for the sake of something beyond them) and complete aims (those sought for their own sake, like Paradise).\n  * Al-Zamakhshari (Asas): Literal: the target of archery. Metaphorical: any sought-after end or purpose.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, transform a thing from one state to another; the heart — so named for its constant fluctuation and turning.\n  * Al-Raghib (Mufradat): Taqlīb: the turning of a thing from one face to another; the heart is so named because of its perpetual turning between states.\n  * Al-Zamakhshari (Asas): Literal: to turn a thing over. Metaphorical: \"to turn matters over\" — i.e., to examine and deliberate; the heart's turning between states.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The conditional structure \"لا بد أن يتميز\" (it is necessary that he be distinguished) governs the subsequent specification of qualities, where the conditions (shurūṭ) are semantically dependent upon the ends (aghrāḍ) sought, requiring careful parsing of the periodic sentence to preserve the logical priority of purpose over condition.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'","badge":"Hadith"}],"27":[{"arabic":"وبغى قال الله تعالى ولو بسط الله الرزق لعباده لبغوا في الأرض وقال تعالى كلا إن الإنسان ليطغى أن رآه استغنى وقال صلى الله عليه وسلم إن الله ليحمي عبده المؤمن من الدنيا وهو يحبه كما يحمي أحدكم مريضه (1) وكذلك الزوجة والولد والقريب وكل ما ذكرناه في الأقسام الستة عشر من النعم سوى الإيمان وحسن الخلق فإنها يتصور أن تكون بلاء في حق بعض الناس فتكون أضدادها إذن نعما في حقهم إذ سبق أن المعرفة كمال ونعمة فإنها صفة من صفات الله تعالى ولكن قد تكون على العبد في بعض الأمور بلاء ويكون فقدها نعمة مثاله جهل الإنسان بأجله فإ","english":"You might say: \"What you have mentioned concerning graces (niʿam) indicates that for God most high there is in every existing thing a grace — and this suggests that trial (balā') has no existence at all. So what then is the meaning of patience (ṣabr)? And if trial does exist, then what is the meaning of gratitude (shukr) for trial? For some claimants have asserted that we give thanks for trial, let alone for grace. So how is gratitude for trial conceivable? And how does one give thanks for that which one endures with patience? For patience in trial demands pain, while gratitude demands joy, and the two are mutually opposed. And what is the meaning of what you have mentioned — that for God most high there is in everything He has brought into existence a grace upon His servants?\"","book_title":"Patience and Gratitude","section_title_ar":"Section 1018","section_title_en":"On the Reconciliation of Patience and Gratitude in the Face of Trial — Section 1018","section_index":1018,"anchors":"- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core sense of softness, ease, and well-being; al-Farahidi notes it as a name for the leopard and tiger, indicating inherent vigor in the state of grace.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — the goodly state; divided into absolute (mutlaqah) and restricted (muqayyadah), the former being felicity in the Hereafter (nearness to God) and faith in this world.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the actual state of well-being; metaphorical (Majaz) extension applies to any beneficial circumstance, even apparent hardship, when considered relative to the recipient's ultimate good.\n- Root: بلي (b-l-w)\n  * Lisan / Ayn: Testing, affliction, and wear of the body; the root implies a state of being tried or proven.\n  * Al-Raghib (Mufradat): Trial (balā') is that which tests one's state; its existence is affirmed alongside grace (niʿmah) as its contrary, for the absence of grace is a trial and the absence of trial is a grace.\n  * Al-Zamakhshari (Asas): Literal sense is calamity or hardship; metaphorical sense applies to any condition that, while painful in one respect, may be a vehicle for divine benefit in another.\n- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Restraint and forbearance; al-Farahidi ties it to holding back the self from complaint.\n  * Al-Raghib (Mufradat): Patience is the withholding of the soul from agitation and complaint; it is only commanded where the trial cannot be repelled by the servant's own effort.\n  * Al-Zamakhshari (Asas): Literal usage is enduring pain; metaphorical usage extends to steadfastness in obedience and abstention from sin, which are acts of patience toward the soul's base inclinations.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: Gratitude as acknowledgment of benefit; al-Farahidi links it to fullness, as a full udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — gratitude is the conception of the grace and its manifestation; it is threefold: of the heart (perceiving the grace), of the tongue (praising the Benefactor), and of the limbs (rewarding the grace through obedience).\n  * Al-Zamakhshari (Asas): Literal sense is verbal and inward acknowledgment; metaphorical sense is the \"grateful beast\" (dābbah shakūr) that thrives on little fodder — so the servant thrives on little trial, seeing in it abundant divine favor.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the scope of patience and gratitude: patience is restricted to unavoidable pain, while gratitude is focused on the relative good within that pain, preventing the logical contradiction of their simultaneous application.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"30":[{"arabic":"عليهم {وما أصابكم من مصيبة فبما كسبت أيديكم ويعفو عن كثير} فالمصائب في الدنيا بكسب الأوزار فإذا عاقبه الله في الدنيا فالله أكرم من أن يعذبه ثانيا وإن عفا عنه في الدنيا فالله أكرم من أن يعذبه يوم القيامة وعن أنس رضي الله تعالى منه عن النبي صلى الله عليه وسلم قال ما تجرع عبد قط جرعتين أحب إلى الله من جرعة غيظ ردها بحلم وجرعة مصيبة يصبر الرجل لها ولا قطرت قطرة أحب إلى الله من قطرة دم أهريقت في سبيل الله أو قطرة دمع في سواد الليل وهو ساجد ولا يراه إلا الله وما خطا عبد خطوتين أحب إلى الله تعالى","english":"And it is related from al-Hasan al-Basri (may God have mercy on him) that a man among the Companions (may God be pleased with them) saw a woman he had known in the pre-Islamic period of ignorance. He spoke to her, then left her, but kept turning his gaze back toward her as he walked, until a wall struck him and left a mark on his face. He came to the Prophet (peace and blessings be upon him) and informed him of this. The Prophet (peace and blessings be upon him) said: \"When God desires good for a servant, He hastens the punishment of his sin for him in this world.\"","book_title":"Patience and Gratitude","section_title_ar":"Section 1021","section_title_en":"On the Divine Wisdom of Trials and the Patience of the Prophets and Righteous","section_index":1021,"anchors":"- Root: فتح (f-t-ḥ)\n  * Lisan / Ayn: To open, to unlock, to grant access; also victory and judgment.\n  * Al-Raghib (Mufradat): In Quranic usage, opening \"the doors of all things\" signifies God’s granting expansive worldly means as a test, not necessarily as honor.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical opening; metaphorical (majāz) here for divine facilitation of blessings that lead to heedlessness.\n- Sibawayh Rule: Interposition of circumstantial clauses (ḥāl) — the parenthetical \"يعني\" (meaning) functions as an explanatory aside, permissible between subject and predicate for clarity.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'","badge":"Ethics"}],"36":[{"arabic":"الليل يتلذذ به في رجاء إنعامه والرجاء في حق الله تعالى أصدق وما عند الله خير وأبقى وأنفع مما عند غيره فكيف لا يتلذذ بعرض الحاجات عليه في الخلوات وأما النقل فيشهد له أحوال قوام الليل في تلذذهم بقيام الليل واستقصارهم له كما يستقصر المحب ليلة وصال الحبيب حتى قيل لبعضهم كيف أنت والليل قال ما راعيته قط يريني وجهه ثم ينصرف وما تأملته بعد وقال آخر أنا والليل فرسا رهان مرة يسبقني إلى الفجر ومرة يقطعني عن الفكر وقيل لبعضهم كيف الليل عليك فقال ساعة أنا فيها بين حالتين أفرح بظلمته إذا جاء وأغتم بفجره إذا طلع ما تم فرحي به قط وقال علي بن ب","english":"That if the beautiful Beloved were behind a veil or in a dark house, the lover would still take delight in mere proximity to Him, without vision and without coveting any other matter besides Him — and he would find joy in displaying his love before Him and in mentioning Him with his tongue within His hearing, even though that too were already known to Him. For if you say: \"He awaits His response\" — then let him delight in hearing His response; yet he does not hear the speech of God, exalted be He. Know then that if he knows that He will not answer him and will remain silent toward him, there still remains for him a delight in presenting his states before Him and in raising his innermost secret to Him. How [could it be otherwise], when the one who is certain (al-mūqin) hears from God, exalted be He, everything that occurs to his mind during the course of his whispered communion (munājāh), and thus takes delight in it? Likewise, one who secludes himself with a king and presents his needs to him in the depths of the night takes delight in it through hope of his beneficence — and hope with respect to God, exalted be He, is more truthful, and what is with God is better, more enduring, and more beneficial than what is with anyone else. So how would he not delight in presenting his needs before Him in private seclusions (khalawāt)?","book_title":"Arrangement of Litanies","section_title_ar":"Section 277","section_title_en":"On the Delight of Night Vigil and Whispered Communion — Section 277","section_index":277,"anchors":"- Root: ليل (layl)\n  * Lisan / Ayn: Night; the period of darkness following sunset until dawn; its diminutive is 'luyaylah' and its plural is 'layālin' — indicating a temporal span marked by stillness and concealment.\n  * Al-Raghib (Mufradat): Night (al-layl) is that which veils (yughashshī) and covers, as in {«وَاللَّيْلِ إِذَا يَغْشَى»} — a time when sensory distractions recede and the heart turns toward intimate communion (munājāh) with the Divine.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): the astronomical night. Metaphorical (majāz): the night of the heart — a state of spiritual wakefulness wherein the lover finds delight in solitude with the Beloved, as expressed in the sayings of the pious transmitted herein.\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; illumination that renders things visible; also the fire-kindling and the beacon (manār) guiding travelers.\n  * Al-Raghib (Mufradat): Light is of two kinds: sensory light perceived by the eye, and intellectual/spiritual light (nūr al-ʿaql, nūr al-Qurʾān) perceived by the inner eye of insight (baṣīrah). The Divine light cast into the hearts of the vigilant is of this latter kind — an immaterial radiance (laṭīfah nūrāniyyah) that transforms the inner state.\n  * Al-Zamakhshari (Asas): Literal: physical illumination. Metaphorical: 'nawwara al-amr' — to clarify and illuminate a matter; here, the spreading of spiritual lights (anwār) from wakeful hearts to heedless ones is a metaphorical extension of this root, signifying the transmission of divine grace.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning and revolving of a thing from one state to another (taqlīb).\n  * Al-Raghib (Mufradat): The heart is so named for its constant fluctuation (taqallub) between states; it is the seat of perception and understanding, the locus of divine address and the receptacle of spiritual lights.\n  * Al-Zamakhshari (Asas): Literal: the physical organ. Metaphorical: 'qallaba al-amr' — to examine and turn over a matter; here, the hearts of the vigilant are 'turned over' by divine light, and from them 'spread' (tantašir) blessings to others — a metaphorical extension of physical turning to spiritual transformation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle 'innamā' restricts and confines the predicate to the subject alone, as in the transmitted saying: \"The delight of whispered communion is not of this world; it is only (innamā) of Paradise\" — a focused predication that negates any worldly share of this pleasure and affirms its exclusive otherworldly origin.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'","badge":"Insight"}],"38":[{"arabic":"{وأمرهم شورى بينهم ومما رزقناهم ينفقون} أي كانوا خلطاء في الأموال لا يميز بعضهم رحله عن بعض وكان منهم من لا يصحب من قال نعلي لأنه أضافه إلى نفسه وجاء فتح الموصلي إلى منزل لأخ له وكان غائبا فأمر أهله فأخرجت صندوقه ففتحه وأخذ حاجته فأخبرت الجارية مولاها فقال إن صدقت فأنت حرة لوجه الله سرورا بما فعل وجاء رجل إلى أبي هريرة رضي الله عنه وقال إني أريد أن أواخيك في الله فقال أتدري ما حق الإخاء قال عرفني قال أن لا تكون أحق بدينارك ودرهمك مني قال لم أبلغ هذه المنزلة بعد قال فاذهب عني وقال علي بن ا","english":"The Messenger of God, may God bless him and grant him peace, said: \"The likeness of two brothers is like the likeness of two hands — one washes the other.\" {«مثل الأخوين مثل اليدين تغسل إحداهما الأخرى»}","book_title":"Duties of Brotherhood","section_title_ar":"Section 417","section_title_en":"Section 417","section_index":417,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'","badge":"Insight"}],"42":[{"arabic":"يسعون في قطع ما أمر الله به أن يوصل ويفسدون في الأرض وقال تعالى {إنما السبيل على الذين يظلمون الناس ويبغون في الأرض بغير الحق} والنمام منهم وقال صلى الله عليه وسلم إن من شرار الناس","english":"And whoever is the recipient of tale-bearing — it being said to him: \"So-and-so said such-and-such about you,\" or \"He did such-and-such against you,\" or \"He is scheming to corrupt your affair,\" or \"He is conspiring with your enemy,\" or \"He is disparaging your condition,\" or whatever runs in that course — then six matters are incumbent upon him:","book_title":"Condemnation of Anger and Hatred","section_title_ar":"Section 692","section_title_en":"Section 692 — On the Duties of the One to Whom Tale-Bearing (Namīmah) Is Conveyed","section_index":692,"anchors":"- Root: ن-م-م (N-M-M)\n  * Lisan / Ayn: Core meaning — to stir up, incite, or carry tales; the one who transmits speech to cause discord.\n  * Al-Raghib (Mufradat): Theological nuance — namīmah is a species of corrupt speech that severs what God has commanded to be joined; it is aligned with fāsiq (transgressor) status, rendering the bearer's testimony rejected.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literally, the act of carrying and dropping seeds (naml) to cause sprouting; metaphorically, the dropping of speech into hearts to sow enmity.\n- Root: غ-ي-ب (Gh-Y-B)\n  * Lisan / Ayn: Core meaning — that which is concealed from the senses.\n  * Al-Raghib (Mufradat): Theological nuance — ghaybah (backbiting) is the mention of a person in his absence with what he dislikes; it is a violation of the unseen honor of the brother.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal absence from sight; metaphorical — the absence of the subject from the gathering while his reputation is being torn.\n- Root: ف-س-ق (F-S-Q)\n  * Lisan / Ayn: Core meaning — to depart, to deviate from the straight path.\n  * Al-Raghib (Mufradat): Theological nuance — fisq is the breaking of the command of God; the fāsiq's report is not to be trusted without verification, per {إِن جَاءَكُمْ فَاسِقٌ بِنَبَإٍ فَتَبَيَّنُوا}.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal: the date that peels from its husk; metaphorical: the soul that peels from obedience.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction & Focused Predication) — The verse {إِنَّمَا السَّبِيلُ عَلَى الَّذِينَ يَظْلِمُونَ النَّاسَ} restricts the path of blame exclusively to the oppressors, thereby excluding the tale-bearer's victim from any culpability and affirming the tale-bearer's full liability.","content_type":"general","topic":"Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Condemnation of Anger and Hatred'","badge":"Commentary"}],"43":[{"arabic":"الفحشاء والمنكر والبغي} وقوله {واصبر على ما أصابك إن ذلك من عزم الأمور} وقوله {ولمن صبر وغفر إن ذلك لمن عزم الأمور} وقوله {فاعف عنهم واصفح إن الله يحب المحسنين} وقوله {وليعفوا وليصفحوا ألا تحبون أن يغفر الله لكم} وقوله {ادفع بالتي هي أحسن فإذا الذي بينك وبينه عداوة كأنه ولي حميم} وقوله {والكاظمين الغيظ والعافين عن الناس والله يحب المحسنين} وقوله {اجتنبوا كثيرا من الظن إن بعض الظن إثم ولا تجسسوا ولا يغتب بعضكم بعضا} ولما كسرت رباعيته وشج يوم أحد فجعل الدم يسيل على وجهه وهو يمسح الدم ويقول كيف يفلح قوم خضبوا وجه نبيهم بالدم وهو يدعوهم إلى ربهم (4) فأنزل الل","english":"The Messenger of God, peace and blessings be upon him, was abundant in supplication and earnest entreaty, perpetually asking God Most High to adorn him with the beauties of refined conduct and the noble traits of character. Thus he would say in his supplication: \"O God, beautify my outward form and my inward character (khuluqī wa-khalqī)\" (1), and he would say: \"O God, protect me from the reprehensible traits of character\" (2). God Most High answered his supplication, fulfilling His word, Exalted is He: {«ادعوني أستجب لكم»} [\"Call upon Me, I will answer you\"] (Ghafir 40:60). So He sent down upon him the Qur'an and disciplined him through it, and his character became the Qur'an.","book_title":"Etiquette of Living and Prophetic Character","section_title_ar":"Section 559","section_title_en":"The Prophet's Discipline Through the Qur'an and the Invitation to Noble Moral Traits","section_index":559,"anchors":"- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning of measuring, fashioning, and creating upon a precise estimation; also used for innate disposition and character.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — the root denotes straight/right estimation; used for bringing something into being from nothing (ibdāʿ) and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خلق الخراز الأديم\" — the leather-worker measures before cutting. Metaphorical (Majaz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom; and \"له خلق حسن\" — he has beautiful character.\n- Root: كرم (karuma)\n  * Lisan / Ayn: Generosity, nobility, honor; the root of karīm (noble/generous) and makārim (noble traits).\n  * Al-Raghib (Mufradat): \"الكرم إذا وصف الله تعالى به فهو اسم لإحسانه وإنعامه المتظاهر\" — when attributed to God, it denotes His manifest beneficence; when attributed to man, it denotes praiseworthy morals and deeds that appear from him.\n  * Al-Zamakhshari (Asas): Literal: \"كرم علينا فلان كرامة\" — he showed generosity. Metaphorical: \"قوم كرم\" — a noble people; \"كرم السحاب تكريما: جاد بمطره\" — the cloud was generous with its rain.\n- Root: أدب (adaba)\n  * Lisan / Ayn: Refinement, discipline, cultivation of character; calling to a gathering (ma'dabah) — the root implies assembling and summoning toward excellence.\n  * Al-Raghib (Mufradat): Discipline (ta'dīb) is the cultivation of the soul through praiseworthy traits and the restraint from blameworthy ones.\n  * Al-Zamakhshari (Asas): Literal: \"أدبته تأديبا\" — I disciplined him. Metaphorical: \"أدبه الله\" — God disciplined him, i.e., refined his character through divine instruction.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما أدبه القرآن\" restricts the means of the Prophet's discipline exclusively to the Qur'an, affirming that the Qur'an alone was the sufficient and complete instrument of his moral formation.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Living and Prophetic Character'","badge":"Du'a"}],"45":[{"arabic":"ثم زفرت الثالثة فتساقط الخلائق على وجوههم وشخصوا بأبصارهم ينظرون من طرف خفى خاشع وانهضمت عند ذلك قلوب الظالمين فبلغت الحناجر كاظمين وذهلت العقول من السعداء والأشقياء أجمعين وبعد ذلك اقبل الله تعالى على الرسل وقال ماذا أجبتم فإذا رأوا ما قد أقيم من السياسة على الأنبياء اشتد الفزع على العصاة ففر الوالد من ولده والأخ من أخيه والزوج من زوجته وبقى كل واحد منتظرا لأمره ثم يؤخذ واحد واحد فيسأله الله تعالى شفاها عن قليل عمله وكثيره وعن سره وعلانيته وعن جميع جوارحه وأعضائه قال أبو هريرة قالوا يا رسول الله هل نرى ربنا يوم القيامة","english":"{«ماذا أجبتم قالوا لا علم لنا إنك أنت علام الغيوب»} — \"What did you answer?\" They will say: \"We have no knowledge; indeed, You alone are the Knower of the unseen.\" {Quran 5:109} So woe betide the severity of a Day in which the intellects of the prophets are stupefied and their knowledges are effaced by the sheer intensity of the awe, when it is said to them: \"What did you answer, when you were sent to the creatures?\" — though they had known — yet their intellects are bewildered, and they know not with what to reply. So they say, from the intensity of the awe: \"We have no knowledge; indeed, You alone are the Knower of the unseen.\" And they are, at that very moment, truthful, for the intellects have flown away from them and the knowledges have been effaced — until God Almighty strengthens them. Then Noah (peace be upon him) is summoned, and it is said to him: \"Did you convey the message?\" He says: \"Yes.\" Then it is said to his community: \"Did he convey to you?\" They say: \"No warner came to us.\"","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1341","section_title_en":"The Day of Reckoning: The Questioning of the Prophets and the Exposure of the Servant Before the Lord of the Worlds","section_index":1341,"anchors":"- Root: رسل (R-S-L)\n  * Lisan / Ayn: Core meaning of \"sending forth with ease and gentleness\"; a messenger (rasūl) is one dispatched with a message.\n  * Al-Raghib (Mufradat): \"الرسول\" denotes one sent with a commission; the root conveys both the act of dispatch and the message borne. In the eschatological context, the prophets (rusul) are asked \"ماذا أجبتم\" — what answer did they give to those to whom they were sent.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): \"أرسل الله في الأمم رسلا\" — God sent messengers among the nations. Metaphorical (majāz): \"أرسل الله عليهم العذاب\" — God loosed chastisement upon them. Here, the sending of prophets is literal, but the terror of the Day is such that even their knowledge is effaced.\n- Root: علم (ʿ-L-M)\n  * Lisan / Ayn: Knowledge, perception, certainty; the opposite of ignorance.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality. On the Day of Terror, the prophets' knowledge (ʿulūmuhum) is erased (tunmaḥū) by the sheer overwhelming majesty (haybah) of the Divine address, leaving them to answer: \"لا علم لنا\" — \"We have no knowledge.\"\n  * Al-Zamakhshari (Asas): Literal: \"علمت الشيء أعلمه\" — I knew the thing. Here, the effacement of knowledge is a literal event of the Hour, not metaphorical, for the prophets are truthful when they disavow knowledge in that state.\n- Root: يوم (Y-W-M)\n  * Lisan / Ayn: A day; a period of time, whether short or long.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day is the time from sunrise to sunset, but it may denote any span of time. The \"Day\" of Resurrection is a duration whose terrors are magnified beyond earthly measure.\n  * Al-Zamakhshari (Asas): Literal: \"ما رأيته اليوم\" — I did not see him today. Metaphorical: \"ذكر في أيام العرب كذا أي في وقائعها\" — \"days\" of the Arabs means their battles. The \"Day\" of Judgment is a real day, but its horrors are such that the prophets themselves are stupefied.\n- Root: الم (ʾ-L-M)\n  * Lisan / Ayn: Severe pain, anguish.\n  * Al-Raghib (Mufradat): \"الألم الوجع الشديد\" — pain is intense suffering. The \"عذاب أليم\" is a painful chastisement. In this passage, the terror of the Day is an \"أليم\" affliction upon the hearts of all creatures.\n  * Al-Zamakhshari (Asas): Literal: \"مسه بضرب أليم\" — he touched him with a painful blow. The anguish of the Day is literal and inescapable.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The construction \"إنك أنت علام الغيوب\" employs the emphatic pronoun \"أنت\" as a focused predication, restricting the attribute of absolute knowledge of the unseen to God alone, even as the prophets disavow all knowledge before Him.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Remembrance of Death and Afterlife'","badge":"Du'a"},{"arabic":"جهنم خالدين فيها} وتخصيصه بالكفر تحكم وقوله تعالى {ألا إن الظالمين في عذاب مقيم} وقال تعالى {ومن جاء بالسيئة فكبت وجوههم في النار} فهذه العمومات في معارضة عموماتهم ولا بد من تسليط التخصص والتأويل على الجانبين لأن الأخبار مصرحة بأن العصاة يعذبون (1) بل قوله تعالى وإن منكم إلا واردها كالصريح في أن ذلك لا بد منه للكل إذ لا يخلو مؤمن عن ذنب يرتكبه وقوله تعالى لا يصلاها إلا الأشقى الذي كذب وتولى أراد به من جماعة مخصوصين أو أراد بالأشقى شخصا معينا أيضا وقوله تعالى كلما ألقى فيها فوج سألهم خزنتها أي فوج من الكفار وتخصيص العمومات","english":"He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.","book_title":"Foundations of Belief","section_title_ar":"Section 99","section_title_en":"The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments","section_index":99,"anchors":"- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"}],"47":[{"arabic":"ينطقون ولا يؤذن لهم فيعتذرون يوم لا مرد له من الله يوم هم بارزون ويوم هم على النار يفتنون يوم لا ينفع مال ولا بنون يوم لا ينفع الظالمين معذرتهم ولهم اللعنة ولهم سوء الدار يوم ترد فيه المعاذير وتبلى السرائر وتظهر الضمائر وتكشف الأستار يوم تخشع فيه الأبصار وتسكن الأصوات ويقل فيه الالتفات وتبرز الخفيات وتظهر الخطيئات يوم يساق العباد ومعهم الأشهاد ويشيب الصغير ويسكر الكبير فيومئذ وضعت الموازين ونشرت الدواوين وبرزت الجحيم وأغلى الحميم وزفرت النار ويئس الكفار وسعرت النيران وتغيرت الألوان وخرس اللسان","english":"So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1339","section_title_en":"The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent","section_index":1339,"anchors":"- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"},{"arabic":"وسلم قال من كانت لأخيه عنده مظلمة في عرض أو مال فليستحللها منه من قبل أن يأتي يوم ليس هناك دينار ولا درهم إنما يؤخذ من حسناته فإن لم يكن له حسنات أخذ من سيئات صاحبه فزيدت على سيئاته (1) وقالت عائشة رضي الله عنها لامرأة قالت لأخرى أنها طويلة الذيل قد اغتبتيها فاستحليها فإذن لا بد من الاستحلال إن قدر عليه فإن كان غائبا أو ميتا فينبغي أن يكثر له الاستغفار والدعاء ويكثر من الحسنات فإن قلت فالتحليل هل يجب فأقول لا لأنه تبرع والتبرع فضل وليس بواجب ولكنه مستحسن وسبيل المعتذر أن يبالغ في الثناء عليه والتودد إليه","english":"- Root: غيب (gh-y-b)\n  * Lisan / Ayn: \"To be absent, hidden, concealed from sight; ghayb = that which is unseen/absent from perception\"\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين — used of everything absent from the senses and from human knowledge; applied to things as ghayb/ghā'ib relative to people, not relative to God, for nothing is absent from Him\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"تكلم بذلك عن ظهر الغيب\" (speaking of the unseen); Majaz: \"أتونا في غابة\" (metaphorical extension to dense/thick things)\n- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: \"Beauty, goodness, excellence; to be fair, comely, good\"\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه — three kinds: good by reason, good by desire, good by sense; ḥasanah = everything that delights one, whether in self, body, or circumstances\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"أنظر إلى محاسن وجهه\" (physical beauty); Majaz: \"فلان لا يحسن شيئًا\" (to do well/excel — transferred to action)\n- Root: حرم (ḥ-r-m)\n  * Lisan / Ayn: \"To forbid, prohibit, make unlawful; ḥarām = that which is forbidden\"\n  * Al-Raghib (Mufradat): \"الحرام: الممنوع منه إما بتسخير إلهي وإما بشري — prohibition by divine decree, by human law, by coercive prevention, by reason, or by revelation\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"هتك رحمته\" (violating sanctity); Majaz: \"جلد محرم: لم يدبغ\" (raw hide — metaphorical extension to \"untreated/unlawful\")\n- Root: ظلم (ẓ-l-m)\n  * Lisan / Ayn: \"Wrongdoing, injustice, oppression; to place something in other than its proper place\"\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور — darkness is absence of light; used metaphorically for ignorance, polytheism, and sin, just as light is used for their opposites\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"فلان يظلم فيظلم\" (to wrong and be wronged); Majaz: \"أرض مظلومة\" (land never dug — metaphorical: \"wronged\" land)\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يؤخذ من حسناته\" restricts the taking exclusively to good deeds, excluding any monetary compensation on that Day.","book_title":"Condemnation of Anger and Hatred","section_title_ar":"Section 690","section_title_en":"Section 690","section_index":690,"anchors":"*(Anchors established)*","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'","badge":"Hadith"},{"arabic":"الأماني فأخذته الحسرة والندامة وبدا له من الله ما لم يكن يحتسب فما ذكرناه بيان لبعض آفات الغفلة عن التفكر وهذا القدر في التوبة كاف وإذا كان الصبر ركنا من أركان دوام التوبة فلا بد من بيان الصبر فنذكره في كتاب مفرد إن شاء الله تعالى كتاب الصبر والشكر وهو الكتاب الثاني من ربع المنجيات من كتاب إحياء علوم الدين بسم الله الرحمن الرحيم الحمد لله أهل الحمد والثناء المنفرد برداء الكبرياء المتوحد بصفات المجد والعلاء المؤيد صفوة الأولياء بقوة الصبر على السراء والضراء والشكر على البلاء والنعماء والصلاة على","english":"It has been related in a lengthy hadith that ʿAmmār ibn Yāsir stood up and said to ʿAlī ibn Abī Ṭālib—may God honor his face—\"O Commander of the Believers, inform us: upon what is unbelief (kufr) founded?\" ʿAlī—may God be pleased with him—replied: \"It is founded upon four pillars: harshness (jafāʾ), blindness (ʿamā), heedlessness (ghaflah), and doubt (shakk). Whoever is harsh holds truth in contempt, proclaims falsehood openly, and detests the scholars. Whoever is blind forgets the remembrance (dhikr). Whoever is heedless veers away from right guidance (rushd). And whoever doubts is deceived by vain hopes (amānī), so remorse (ḥasrah) and regret (nadāmah) seize him, and there appears to him from God that which he had never reckoned with.\"","book_title":"Fear and Hope","section_title_ar":"Section 953","section_title_en":"The Book of Patience and Gratitude — Being the Second Book of the Quarter of Deliverance from The Revival of the Religious Sciences","section_index":953,"anchors":"- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning of restraint and withholding; \"ṣabara al-dābbah\" = to hold back an animal from fodder; \"ṣabara fulānan\" = to confine someone with no exit.\n  * Al-Raghib (Mufradat): \"Patience is the withholding of the soul in constriction... it is a general term whose names vary by context: if withholding the soul over a calamity, it is called ṣabr (patience), opposed by jazʿ (panic); if in battle, it is called shajāʿah (courage), opposed by jubn (cowardice).\"\n  * Al-Zamakhshari (Asas): Literal (Ḥaqīqah): \"I bore patiently what I dislike, and I refrained patiently from what I love.\" Metaphorical (Majāz): \"His right hand was made to swear earnestly (ṣubirat yamīnuhu)\" — i.e., bound by an oath; \"This tree is patient against cold\" — i.e., resistant.\n- Root: شكر (Sh-K-R)\n  * Lisan / Ayn: Root denotes fullness and manifestation; \"shakirat al-ḥalūbah\" = the milch camel's udder became full.\n  * Al-Raghib (Mufradat): \"Gratitude is the perception of the blessing and its manifestation... it is the inverse of kufr (ingratitude), which is forgetting and concealing the blessing. It has three kinds: gratitude of the heart (perceiving the blessing), of the tongue (praising the Bestower), and of the limbs (rewarding the blessing with obedience).\"\n  * Al-Zamakhshari (Asas): Literal: \"I thanked God for His blessing.\" Metaphorical: \"A grateful beast (dābbah shakūr)\" — one satisfied with little fodder yet thriving on it.\n- Root: وصف (W-Ṣ-F)\n  * Al-Raghib (Mufradat): \"Description is the mention of a thing by its attribute and quality; the attribute (ṣifah) is the state upon which the thing is found.\"\n  * Al-Zamakhshari (Asas): Literal: \"I described him with a description.\" Metaphorical: \"Her face describes beauty\" — i.e., it manifests it visibly.\n- Sibawayh Rule: Rule of Interposition between the Preposition and its Object (باب الفصل بين الجار والمجرور) — governing the periodic suspension of grammatical dependency to allow parenthetical theological qualifications, as in \"فإن الإيمان نصفان\" where the predicate is deferred for rhetorical emphasis.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'","badge":"Insight"}],"51":[{"arabic":"إلا بواسطة الملائكة وما كان لبشر أن يكلمه الله إلا وحيا أو من وراء حجاب أو يرسل رسولا فيوحي بإذنه ما يشاء وهكذا ما يرسل من رحمة العلوم إلى القلوب إنما تتولاها الملائكة الموكلون بها وهم المقدسون المطهرون المبرءون عن الصفات المذمومات فلا يلاحظون إلا طيبا ولا يعمرون بما عندهم من خزائن رحمة الله إلا طيبا طاهرا ولست أقول المراد بلفظ البيت هو القلب وبالكلب هو الغضب والصفات المذمومة ولكني أقول هو تنبيه عليه وفرق بين تعبير الظواهر إلى البواطن وبين التنبيه للبواطن من ذكر الظواهر مع تقرير الظواهر ففارق الباطنية بهذه الدقيقة فإن هذه طريق الاعتبار وهو مسلك","english":"The Prophet, peace be upon him, said: \"Religion is built upon cleanliness\" — and it is so, both inwardly and outwardly. God, exalted, has said: {«إِنَّمَا الْمُشْرِكُونَ نَجَسٌ»} (Indeed, the polytheists are impure) — as an alert to the intellects that purity and impurity are not confined to the outward things perceived by the senses. For the polytheist may have a clean garment and a washed body, yet he is impure in his essence (jawhar) — that is, his inner being is stained with filths.","book_title":"Book of Knowledge","section_title_ar":"Section 40","section_title_en":"The Book of the Revival of the Religious Sciences — Section 40: Exposition of the Harms of Disputation and the Destructive Traits of Character Generated Therefrom; Chapter Five: On the Etiquettes of the Learner and the Teacher","section_index":40,"anchors":"- Root: طهر (ṭahara)\n  * Lisan / Ayn: Core meaning of cleanliness, purity, and freedom from filth — both physical and spiritual.\n  * Al-Raghib (Mufradat): Theological nuance: purification (taṭhīr) is the prerequisite for any act of worship (ʿibādah); inner purification from blameworthy traits parallels outer purification from ritual impurities (aḥdāth) for the validity of prayer.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) refers to physical cleanliness; metaphorical (majāz) extends to purity of the soul and heart from moral vices.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart as the physical organ and center of the self.\n  * Al-Raghib (Mufradat): The heart is that which is turned about (taqlīb) — its states fluctuate; it is the seat of understanding and the locus of divine knowledge.\n  * Al-Zamakhshari (Asas): Literal: the physical heart; Metaphorical: the inner spiritual reality (laṭīfah rabbāniyyah) that perceives and knows, the \"house\" of the angels.\n- Root: نجس (najasa)\n  * Lisan / Ayn: Ritual impurity, filth, that which is avoided and shunned.\n  * Al-Raghib (Mufradat): Impurity is not restricted to the sensory/physical; the polytheist (mushrik) is impure in essence (jawhar) — i.e., his inner being — even if his body is clean.\n  * Al-Zamakhshari (Asas): Literal: physical uncleanliness; Metaphorical: moral and spiritual defilement that bars the angels and divine illumination from the heart.\n- Root: عبر (ʿabara)\n  * Lisan / Ayn: To cross over, to traverse from one side to another; to interpret.\n  * Al-Raghib (Mufradat): Iʿtibār (reflection/consideration) is the crossing from the sensory/visible (shāhid) to the unseen/absent (ghāʾib) — drawing lessons from the apparent to the hidden.\n  * Al-Zamakhshari (Asas): Literal: crossing a river or valley; Metaphorical: the intellectual passage from outward forms (ẓawāhir) to inner meanings (bawāṭin), distinguishing true allegorical interpretation from the invalid taʾwīl of the Bāṭiniyyah.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the exclusive predication in the Prophet's statement \"Prayer is built upon cleanliness\" and the restriction of impurity to the polytheists, requiring precise parsing of what is affirmed and negated.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"52":[{"arabic":"نوره كمشكاة وسمى العلم المستفاد منه روحا ووحيا وحياة فقال تعالى {وكذلك أوحينا إليك روحا من أمرنا} وقال سبحانه أومن كان ميتا فأحييناه وجعلنا له نورا يمشي به في الناس وحيث ذكر النور والظلمة أراد به العلم والجهل كقوله {يخرجهم من الظلمات إلى النور} وقال صلى الله عليه وسلم يا أيها الناس اعقلوا عن ربكم وتواصوا بالعقل تعرفوا ما أمرتم به وما نهيتم عنه واعلموا أنه ينجدكم عند ربكم واعلموا أن العاقل من أطاع الله وإن كان دميم المنظر حقير الخطر دنيء المنزلة رث الهيئة وأن الجاهل من عصى الله تعالى وإن كان جميل المنظر عظيم الخطر شريف المنزلة حسن الهيئة فص","english":"The Book of Seclusion ('Uzlah) — its explanation, God Most High willing. For this reason, Yūsuf ibn Asbāṭ wrote to Ḥudhayfah al-Marʿashī: \"What is your opinion of one who remains, finding no one with whom to remember God Most High except that he is either sinful, or his remembrance in company is itself an act of disobedience — and that because he finds no one of his own kind?\" And indeed he spoke truly, for mixing with people is never free from backbiting (ghībah), or listening to backbiting, or remaining silent upon wrongdoing (munkar). And the best of his states is that he either imparts knowledge or acquires it. Yet were this poor wretch to reflect, and to know that his imparting of knowledge is never free from the taints of ostentation (riyā'), the seeking of followers, and the desire for leadership (ri'āsah), he would know that the one who acquires knowledge from him only seeks to make it an instrument for pursuing the world and a means toward evil — so that the teacher becomes his helper therein, his support and his backer, preparing its causes for him, like one who sells a sword to a highway robber. For knowledge is like the sword: its soundness for good is like the soundness of the sword for warfare. And for this reason, it is not permitted to sell it to one whom one knows, by the indications of his circumstances, intends to use it to aid in cutting off the road.","book_title":"Book of Knowledge","section_title_ar":"Section 65","section_title_en":"The Book of Seclusion ('Uzlah) — Section 65, and The Seventh Book: On the Intellect, Its Nobility, Its Reality, and Its Divisions","section_index":65,"anchors":"- Root: عقل (ʿaql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back; the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — The intellect is said of the faculty prepared for the reception of knowledge, and it is also said of the knowledge which man acquires by means of that faculty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): intellectual apprehension and understanding. Metaphorical (Majaz): \"نخلة لا تعقل الإبار\" — a palm tree that does not accept pollination, i.e., does not grasp or take in.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge as the mark or sign by which a thing is known; the trace or landmark that guides.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — Knowledge is the apprehension of a thing in its true reality; it is of two kinds: apprehension of the essence of a thing, and judgment upon a thing regarding what exists for it or is negated of it.\n  * Al-Zamakhshari (Asas): Literal: certain awareness. Metaphorical: \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge; knowledge as a guiding landmark (maʿlam).\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; the first to set up beacons (manār) on his path in his campaigns to guide his return.\n  * Al-Raghib (Mufradat): \"النور: الضوء المنتشر الذي يعين على الإبصار\" — Light is the diffused radiance that aids vision; it is of two kinds: that perceived by the eye of inner insight (baṣīrah) — such as the light of the intellect and the light of the Qur'an — and that perceived by the eye of the head, such as the celestial bodies.\n  * Al-Zamakhshari (Asas): Literal: illumination. Metaphorical: \"نور الأمر: بينه\" — he illuminated the matter: he made it clear; \"وهذا أنور من ذاك: أبين\" — this is more luminous than that: more evident.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the exclusive attribution of a predicate to a subject, as in the author's restriction of the scholar's condition to one of two men, and the exclusion of the third.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'","badge":"Insight"}],"53":[{"arabic":"عن هذا الترجيح بالملك وهو مجاز محض إذ لا ملك إلا لملك الملوك الذي له ما في السموات والأرض وكيف يكون العبد مالكا وهو في نفسه ليس يملك نفسه بل هو ملك غيره نعم الخلق عباد الله والأرض مائدة الله وقد أذن لهم في الأكل من مائدته بقدر حاجتهم كالملك ينصب مائدة لعبيده فمن أخذ لقمة بيمينه واحتوت عليها براجمه فجاء عبد آخر وأراد انتزاعها","english":"...to your heart, so that your heart becomes bound by it, and thus your body becomes bound in that direction in a posture of stillness and solemnity when you worship your Lord. Likewise, your actions are divided into those that are noble — such as acts of obedience — and those that are base — such as relieving oneself or spitting. So when you spit toward the direction of the Qiblah, you have indeed wronged it (ẓalamtahā) and shown ingratitude for the blessing (niʿmah) of Allah Most High upon you, by virtue of His placing the Qiblah, through whose placement the perfection of your worship is achieved. Similarly, when you put on your leather sock (khuff) and begin with the left foot, you have wronged (ẓalamta), because the sock is a protection for the foot; the foot has a share in it, and in matters of shares and portions, one ought to begin with the nobler — that is justice (al-ʿadl) and fidelity to wisdom, while its opposite is injustice (ẓulm) and ingratitude for the blessing of the sock and the foot. And this, in the eyes of the knowers (al-ʿārifīn), is a grave offense (kabīrah), even if the jurist (al-faqīh) labels it merely \"disliked\" (makrūh) — to the extent that one of them (the righteous predecessors) had gathered many measures of wheat and was giving them in charity, and when asked about the reason, he said: \"I once put on a sandal and began with the left foot inadvertently, so I wish to expiate that (kufr) through charity.\" Yes, the jurist is unable to magnify the matter in these affairs, because he is constrained — rather, he is occupied with reforming the common folk (al-ʿawāmm), whose rank approaches the rank of the beasts (al-anʿām), and they are plunged into darknesses (ẓulumāt) far greater and more immense than that such minor darknesses should appear in comparison to them. For it would be ugly to say of one who drank wine and took the cup with his left hand that he transgressed in two respects — one being the drinking, and the other the taking with the left — and of one who sold wine at the time of the call to prayer on Friday, it would be ugly to say he betrayed in two respects — {one} the selling of wine, and the other the selling at the time of the call. And of one who relieved himself in the prayer niche (miḥrāb) of a mosque with his back to the Qiblah, it would be ugly to mention his abandonment of propriety in relieving himself, in that he did not place the Qiblah to his right. For all sins are darknesses, some piled atop others, such that one is eclipsed beside another. A master may punish his slave if he uses his knife without his permission — but if he killed his most beloved son with that very knife, the unauthorized use of the knife would retain no weight or sting in itself. Thus, all the etiquettes (ādāb) that the Prophets and the Saints (al-awliyāʾ) observed, and which we have treated leniently in jurisprudence (fiqh) concerning the common folk, have as their cause this very necessity. Otherwise, all these disliked acts are deviations from justice (al-ʿadl), ingratitude for blessing (kufrān al-niʿmah), and a deficiency in the rank that conveys the servant to the degrees of proximity (darajāt al-qurb) — some of them affect the servant by diminishing proximity and lowering station, while others expel him entirely from the bounds of proximity into the realm of distance (ʿālam al-buʿd), which is the abode of the devils. Likewise, whoever breaks a branch from a tree without an urgent pressing need, and without a sound purpose, has shown ingratitude for the blessing of Allah Most High in the creation of trees and the creation of the hand. As for the hand, it was not created for frivolity, but for obedience and for deeds that aid in obedience. As for the tree, Allah Most High created it, and created for it roots, and conveyed water to it, and placed within it the power of nourishment and growth, so that it might reach the culmination of its development (munthā nashwihi), and His servants might benefit from it. So breaking it before its culmination, not in a manner by which His servants benefit, is a violation of the purpose of wisdom and a deviation from justice. But if he has a sound purpose, then that is permissible for him — for trees and animals have been made a ransom (fidāʾ) for the purposes of human beings, since both are perishable and doomed. Thus, annihilating the baser (al-akhass) for the preservation of the nobler (al-ashraf) for a time is closer to justice than squandering both. And to this points His saying, Most High: {«وَسَخَّرَ لَكُم مَّا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ جَمِيعًا مِّنْهُ»} — \"And He subjected to you whatever is in the heavens and whatever is on the earth — all from Him\" [Al-Jāthiyah: 13]. Yes — if he breaks a tree belonging to someone else, he is also a wrongdoer (ẓālim), even if he is in need, because every specific tree does not suffice for the needs of all the servants of Allah; rather, it suffices for a single need. And if one single person were to be singled out for it without preponderance (tarjīḥ) and specification (ikhtiṣāṣ), that would be injustice. So the one entitled to specification is he who obtained the seed, placed it in the ground, conveyed water to it, and undertook its care — he is more worthy of it than others, and his side is thereby established. But if it grew in dead land (mawāt al-arḍ) without any human effort, then one must seek another specification — namely, precedence in taking it (sabq ilā akhdhihi). For the one who precedes has the special property of precedence (khāṣṣiyyat al-sabq). Justice, then, is that he be most worthy of it. And the poor (al-fuqarāʾ) have expressed this preponderance by the term \"ownership\" (al-milk) — but it is pure metaphor (majāz maḥḍ), for there is no owner except the King of Kings (Malik al-Mulūk), to Whom belongs what is in the heavens and the earth. And how could a servant be an owner, when he himself does not own his own self — rather, he is the property of Another? Yes — the creatures are the servants of Allah, and the earth is the table (māʾidah) of Allah, and He has permitted them to eat from His table to the measure of their need — like a king who sets a table for his slaves. So if one takes a morsel with his right hand, and his fingers close over it, and another slave comes and seeks to snatch it away...","book_title":"Patience and Gratitude","section_title_ar":"Section 986","section_title_en":"The Etiquette of the Heart and the Hidden Dimensions of Violating Sacred Directions and Blessings","section_index":986,"anchors":"- Root: ظلم (ẓ-l-m)\n  * Lisan / Ayn: Core meaning is \"darkness\" (ẓulmah) — absence of light; also \"to place something in other than its proper place\" (waḍʿ al-shayʾ fī ghayr mawḍiʿihi).\n  * Al-Raghib (Mufradat): Ẓulm is expressed via \"darknesses\" (ẓulumāt) as ignorance, polytheism, and transgression — the opposite of nūr (light/justice).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"الظلم ظلمات يوم القيامة\" — injustice is darknesses on the Day of Judgment. Metaphorical (majāz): \"أرض مظلومة\" — land never dug, i.e., violated by first use; \"ظلم البعير\" — slaughtering an animal without cause (ʿabṭ).\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Niʿmah is a state of well-being; also \"softness\" and \"delicacy.\"\n  * Al-Raghib (Mufradat): Niʿmah is the good condition bestowed; its plural (niʿam) covers both little and much — \"وَإِن تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا\" {And if you count the blessings of Allah, you cannot enumerate them} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal: \"جلت نعمة الله\" — the blessing of Allah is immense. Metaphorical: \"خفت نعامتهم\" — their ostriches departed (i.e., they fled), showing how blessing can be \"kicked away\" (kufrān al-niʿmah).\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Ownership and dominion; the possessor (mālik) who disposes freely.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي\" — the king is one who commands and forbids; true ownership belongs only to Allah, \"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ\" {To Him belongs what is in the heavens and the earth}.\n  * Al-Zamakhshari (Asas): Literal: \"ملك يده\" — what one's hand owns. Metaphorical: \"ملكت فلانة أمرها\" — she controlled her own affair; here, human \"ownership\" (milk) is pure metaphor (majāz maḥḍ), since real dominion is Allah's alone.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governs how qualifying clauses (e.g., \"التي بوضعها كمال عبادتك\") attach to antecedents, preserving syntactic cohesion even when embedded phrases lengthen the sentence, ensuring no semantic break occurs between the act and its moral consequence.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"},{"arabic":"طويل والعمر قصير وإلى الله تصير الأمور وخطب عمر بن عبد العزيز رحمه الله عليه فقال يا أيها الناس إنكم خلقتم لأمر إن كنتم تصدقون به فإنكم حمقى وإن كنتم تكذبون به فإنكم هلكى إنما خلقتم للأبد ولكنكم من دار إلى دار تنقلون عباد الله إنكم في دار لكم فيها من طعامكم غصص ومن شرابكم شرق لا تصفو لكم نعمة تسرون بها إلا بفراق أخرى تكرهون فراقها فاعملوا لما أنتم صائرون إليه وخالدون فيه ثم غلبه البكاء ونزل قال علي كرم الله وجهه في خطبته أوصيكم بتقوى الله والترك للدنيا التاركة لكم وإن كنتم لا تحبون","english":"And indeed there has come the narration from him, from his Lord, Mighty and Glorious, that He said to Moses, peace be upon him: \"When you see the rich man approaching, say: 'A sin whose punishment has been hastened.' And when you see the poor man approaching, say: 'Welcome to the badge of the righteous.'\" And if you wish, you may follow the possessor of the Spirit and the Word, Jesus son of Mary, peace be upon him — for he used to say: \"My condiment is hunger, my badge is fear, my garment is wool, my warmth in winter is the rising places of the sun, my lamp is the moon, my mount is my two feet, and my food and my fruit is what the earth brings forth. I pass the night and I possess nothing, and I rise in the morning and I possess nothing — and there is no one upon the earth richer than I.\"","book_title":"Condemnation of the World","section_title_ar":"Section 737","section_title_en":"The Revival of the Religious Sciences — Section 737: On the Censure of This World and the Description of Its Perils","section_index":737,"anchors":"- Root: دنو (danuww)\n  * Lisan / Ayn: \"دنا فهو دانٍ\" — proximity, nearness; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by decree; used of place, time, and station. The \"nearer\" (al-adnā) is contrasted with the greater and the better.\n  * Al-Zamakhshari (Asas): Literal: physical nearness. Metaphorical: the lower, contemptible station — \"أهل الدناءة هم أهل الشناءة\" (the people of baseness are the people of abhorrence).\n- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم\" — a day; also any period of time.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day is the time from sunrise to sunset, or any duration whatsoever. \"وذكرهم بأيام الله\" — the days of God are His mighty deeds and calamities upon the disbelievers.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"أيام العرب\" — their battles and vicissitudes; \"أيام الله\" — His punitive visitations.\n- Root: وقد (waqada)\n  * Lisan / Ayn: \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is the fuel.\n  * Al-Raghib (Mufradat): \"وقودها الناس والحجارة\" — the fuel of the Fire is men and stones; the one who kindles it for himself (istawqada) is he who seeks its light.\n  * Al-Zamakhshari (Asas): Literal: kindling a fire. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقد الحصى\" — the pebbles became scorching hot (i.e., the intensity of the sun's heat).\n- Root: ألك (alaka)\n  * Lisan / Ayn: \"المألكة: الرسالة، لأنها تؤلك في الفم\" — the message (risālah) is called ma'lakah because it is chewed/worked in the mouth.\n  * Al-Raghib (Mufradat): \"الملائكة تقع على الواحد والجمع\" — angels (malā'ikah) are so named as bearers of messages; \"الله يصطفي من الملائكة رسلا\" {«الله يصطفي من الملائكة رسلا»} — God chooses messengers from the angels.\n  * Al-Zamakhshari (Asas): Literal: chewing (as a horse chews its bit). Metaphorical: delivering a message — the angel is the one who delivers the divine communication.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate to the subject alone, negating it of all else. Applied in the sermon: \"إنما يتزين لي أوليائي بالذل والخوف\" — My friends adorn themselves for Me ONLY with humility, fear, and submission — restricting their adornment to these alone, excluding all worldly ornament.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of the World'","badge":"Ethics"}]},"wordTiming":{"abdulbasit":{"1":[[1,250,3574]],"2":[[1,400,11060]],"3":[[1,400,1604],[2,1604,3628],[3,3628,4817],[4,4817,6132],[5,6132,7561],[6,7561,8067],[7,8067,9193],[8,9193,10192],[9,10192,11710],[10,11710,13202]],"4":[[1,400,828],[2,828,1413],[3,1413,1976],[4,1976,3827],[5,3827,4750],[6,4750,5313],[7,5313,6393],[8,6393,7271],[9,7271,8650],[10,8650,10068]],"5":[[1,400,1685],[2,1685,3983],[3,3983,6155],[4,6155,6714],[5,6714,8684],[6,8684,11338],[7,11338,13559],[8,13559,14704],[9,14704,16003],[10,16003,18992],[11,18992,19830],[12,19830,20528],[13,20528,21869],[14,21869,23646],[15,23646,24666],[16,24666,25770],[17,25770,26441],[18,26441,28089],[19,28089,29947]],"6":[[1,400,2385],[2,2385,4426],[3,4426,4981],[4,4981,6602],[5,6602,9423],[6,9423,10520],[7,10520,11880],[8,11880,13435],[9,13435,15284],[10,15284,16172],[11,16172,17727],[12,17727,19394]],"7":[[1,400,2450],[2,2450,5876],[3,5876,7415],[4,7415,9773],[5,9773,12205],[6,12205,14121],[7,14121,15317],[8,15317,17249],[9,17249,18395],[10,18395,20393],[11,20393,22227],[12,22227,23537],[13,23537,25011],[14,25011,25863],[15,25863,27009],[16,27009,28123],[17,28123,29662],[18,29662,30481],[19,30481,32299],[20,32299,34330],[21,34330,35149],[22,35149,37418]],"8":[[1,400,1613],[2,1613,3481],[3,3481,4679],[4,4679,6529],[5,6529,7878],[6,7878,9485],[7,9485,11031],[8,11031,12502],[9,12502,13108],[10,13108,15431],[11,15431,16189],[12,16189,17705],[13,17705,21022],[14,21022,21810],[15,21810,22689],[16,22689,23735],[17,23735,25289],[18,25289,26532],[19,26532,27988]],"9":[[1,400,1014],[2,1014,3064],[3,3064,3622],[4,3622,5251],[5,5251,8084],[6,8084,9464],[7,9464,10133],[8,10133,11925],[9,11925,13013],[10,13013,14156],[11,14156,16164],[12,16164,17252],[13,17252,18535],[14,18535,19302],[15,19302,20278],[16,20278,21588]],"10":[[1,400,1589],[2,1589,3445],[3,3445,4431],[4,4431,5011],[5,5011,6026],[6,6026,7894],[7,7894,8967],[8,8967,10113],[9,10113,11494],[10,11494,12640],[11,12640,13873],[12,13873,15207],[13,15207,17020],[14,17020,18789],[15,18789,20151]],"11":[[1,400,1774],[2,1774,4081],[3,4081,5848],[4,5848,6745],[5,6745,7586],[6,7586,8554],[7,8554,10321],[8,10321,12340],[9,12340,13322],[10,13322,15123],[11,15123,17142],[12,17142,19077],[13,19077,20031],[14,20031,21041],[15,21041,22443],[16,22443,23425],[17,23425,24519],[18,24519,26461],[19,26461,28171]],"12":[[1,400,935],[2,935,2992],[3,2992,5309],[4,5309,7084],[5,7084,8535],[6,8535,10014],[7,10014,10859],[8,10859,13017],[9,13017,14848],[10,14848,16130],[11,16130,17187],[12,17187,18173],[13,18173,19498]],"13":[[1,400,1404],[2,1404,2290],[3,2290,3308],[4,3308,4946],[5,4946,5713],[6,5713,7536],[7,7536,8097],[8,8097,9632],[9,9632,12156],[10,12156,15243],[11,15243,16630],[12,16630,17840],[13,17840,20164],[14,20164,21150],[15,21150,23349],[16,23349,25563],[17,25563,28279],[18,28279,28928],[19,28928,31289],[20,31289,32927],[21,32927,34137],[22,34137,36808],[23,36808,37812],[24,37812,38698],[25,38698,39790],[26,39790,42151],[27,42151,42918],[28,42918,44940],[29,44940,46298],[30,46298,47464],[31,47464,50017],[32,50017,51375],[33,51375,51965],[34,51965,54226],[35,54226,56824],[36,56824,58182],[37,58182,58772],[38,58772,60249]],"14":[[1,400,1585],[2,1585,4605],[3,4605,5920],[4,5920,6498],[5,6498,7423],[6,7423,8174],[7,8174,10445],[8,10445,11745],[9,11745,13248],[10,13248,14808],[11,14808,16715],[12,16715,17813],[13,17813,19056],[14,19056,19634],[15,19634,20934],[16,20934,22697],[17,22697,23622],[18,23622,25789],[19,25789,27451],[20,27451,29011],[21,29011,30499],[22,30499,32132],[23,32132,34415],[24,34415,35831],[25,35831,36409],[26,36409,3