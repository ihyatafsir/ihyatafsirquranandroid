{"surah": 42, "verses": [{"ayah": 1, "text": "حمٓ ", "translation": "Ḥā, Meem.", "words": [{"id": 1, "arabic": "حمٓ", "translit": "ٓmḥ", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "عٓسٓقٓ ", "translation": "ʿAyn, Seen, Qāf.[1]", "words": [{"id": 1, "arabic": "عٓسٓقٓ", "translit": "ٓqٓsٓʿع", "root": ""}], "hasIhya": false}, {"ayah": 3, "text": "كَذَٰلِكَ يُوحِىٓ إِلَيْكَ وَإِلَى ٱلَّذِينَ مِن قَبْلِكَ ٱللَّهُ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "Thus has He revealed to you, [O Muḥammad], and to those before you - Allāh, the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 2, "arabic": "يُوحِىٓ", "translit": "ٓàِḥwُy", "root": "وحي"}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "وَإِلَى", "translit": "àَlِiʾَw", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 10, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 4, "text": "لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۖ وَهُوَ ٱلْعَلِىُّ ٱلْعَظِيمُ ", "translation": "To Him belongs whatever is in the heavens and whatever is in the earth, and He is the Most High, the Most Great.[1]", "words": [{"id": 1, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 9, "arabic": "ٱلْعَلِىُّ", "translit": "ُّàِlَʿعْlٱ", "root": "علو"}, {"id": 10, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 5, "text": "تَكَادُ ٱلسَّمَٰوَٰتُ يَتَفَطَّرْنَ مِن فَوْقِهِنَّۚ وَٱلْمَلَٰٓئِكَةُ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيَسْتَغْفِرُونَ لِمَن فِى ٱلْأَرْضِۗ أَلَآ إِنَّ ٱللَّهَ هُوَ ٱلْغَفُورُ ٱلرَّحِيمُ ", "translation": "The heavens almost break from above them,[1] and the angels exalt [Allāh] with praise of their Lord and ask forgiveness for those on earth. Unquestionably, it is Allāh who is the Forgiving, the Merciful.", "words": [{"id": 1, "arabic": "تَكَادُ", "translit": "ُdāَkَt", "root": "كود"}, {"id": 2, "arabic": "ٱلسَّمَٰوَٰتُ", "translit": "ُtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "يَتَفَطَّرْنَ", "translit": "َnْrَّṭَfَtَy", "root": "فطر"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "فَوْقِهِنَّ", "translit": "َّnِhِqْwَf", "root": "فوق"}, {"id": 6, "arabic": "وَٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱَw", "root": "ملك"}, {"id": 7, "arabic": "يُسَبِّحُونَ", "translit": "َnwُḥِّbَsُy", "root": "سبح"}, {"id": 8, "arabic": "بِحَمْدِ", "translit": "ِdْmَḥِb", "root": "حمد"}, {"id": 9, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 10, "arabic": "وَيَسْتَغْفِرُونَ", "translit": "َnwُrِfْغَtْsَyَw", "root": "غفر"}, {"id": 11, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 14, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 18, "arabic": "ٱلْغَفُورُ", "translit": "ُrwُfَغْlٱ", "root": "غفر"}, {"id": 19, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": true}, {"ayah": 6, "text": "وَٱلَّذِينَ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَ ٱللَّهُ حَفِيظٌ عَلَيْهِمْ وَمَآ أَنتَ عَلَيْهِم بِوَكِيلٍ ", "translation": "And those who take as allies other than Him - Allāh is [yet] Guardian over them; and you, [O Muḥammad], are not over them a manager -", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 5, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "حَفِيظٌ", "translit": "ٌẓyِfَḥ", "root": "حفظ"}, {"id": 8, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 10, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 11, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "بِوَكِيلٍ", "translit": "ٍlyِkَwِb", "root": "وكل"}], "hasIhya": false}, {"ayah": 7, "text": "وَكَذَٰلِكَ أَوْحَيْنَآ إِلَيْكَ قُرْءَانًا عَرَبِيًّا لِّتُنذِرَ أُمَّ ٱلْقُرَىٰ وَمَنْ حَوْلَهَا وَتُنذِرَ يَوْمَ ٱلْجَمْعِ لَا رَيْبَ فِيهِۚ فَرِيقٌ فِى ٱلْجَنَّةِ وَفَرِيقٌ فِى ٱلسَّعِيرِ ", "translation": "And thus We have revealed to you an Arabic Qur’ān that you may warn the Mother of Cities [i.e., Makkah] and those around it[1] and warn of the Day of Assembly, about which there is no doubt. A party will be in Paradise and a party in the Blaze.", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "أَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾ", "root": "وحي"}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "قُرْءَانًا", "translit": "āًnāَءْrُq", "root": "قرا"}, {"id": 5, "arabic": "عَرَبِيًّا", "translit": "āًّyِbَrَʿع", "root": "عرب"}, {"id": 6, "arabic": "لِّتُنذِرَ", "translit": "َrِhdnُtِّl", "root": "نذر"}, {"id": 7, "arabic": "أُمَّ", "translit": "َّmُaʾ", "root": "امم"}, {"id": 8, "arabic": "ٱلْقُرَىٰ", "translit": "ٰàَrُqْlٱ", "root": "قري"}, {"id": 9, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 10, "arabic": "حَوْلَهَا", "translit": "āَhَlْwَḥ", "root": "حول"}, {"id": 11, "arabic": "وَتُنذِرَ", "translit": "َrِhdnُtَw", "root": "نذر"}, {"id": 12, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 13, "arabic": "ٱلْجَمْعِ", "translit": "ِʿعْmَjgْlٱ", "root": "جمع"}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 16, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 17, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 20, "arabic": "وَفَرِيقٌ", "translit": "ٌqyِrَfَw", "root": "فرق"}, {"id": 21, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 22, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": false}, {"ayah": 8, "text": "وَلَوْ شَآءَ ٱللَّهُ لَجَعَلَهُمْ أُمَّةً وَٰحِدَةً وَلَٰكِن يُدْخِلُ مَن يَشَآءُ فِى رَحْمَتِهِۦۚ وَٱلظَّٰلِمُونَ مَا لَهُم مِّن وَلِىٍّ وَلَا نَصِيرٍ ", "translation": "And if Allāh willed, He could have made them [of] one religion, but He admits whom He wills[1] into His mercy. And the wrongdoers have not any protector or helper.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لَجَعَلَهُمْ", "translit": "ْmُhَlَʿعَjgَl", "root": "جعل"}, {"id": 5, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 8, "arabic": "يُدْخِلُ", "translit": "ُlِhkْdُy", "root": "دخل"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "رَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَr", "root": "رحم"}, {"id": 13, "arabic": "وَٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱَw", "root": "ظلم"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 16, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 17, "arabic": "وَلِىٍّ", "translit": "ٍّàِlَw", "root": "ولي"}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "نَصِيرٍ", "translit": "ٍryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 9, "text": "أَمِ ٱتَّخَذُوا۟ مِن دُونِهِۦٓ أَوْلِيَآءَۖ فَٱللَّهُ هُوَ ٱلْوَلِىُّ وَهُوَ يُحْىِ ٱلْمَوْتَىٰ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Or have they taken protectors [or allies] besides Him? But Allāh - He is the Protector, and He gives life to the dead, and He is over all things competent.", "words": [{"id": 1, "arabic": "أَمِ", "translit": "ِmَaʾ", "root": ""}, {"id": 2, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 5, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 6, "arabic": "فَٱللَّهُ", "translit": "ُhَّllٱَf", "root": "اله"}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "ٱلْوَلِىُّ", "translit": "ُّàِlَwْlٱ", "root": "ولي"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "يُحْىِ", "translit": "ِàْḥُy", "root": "حيي"}, {"id": 11, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 12, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 15, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 16, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 10, "text": "وَمَا ٱخْتَلَفْتُمْ فِيهِ مِن شَىْءٍ فَحُكْمُهُۥٓ إِلَى ٱللَّهِۚ ذَٰلِكُمُ ٱللَّهُ رَبِّى عَلَيْهِ تَوَكَّلْتُ وَإِلَيْهِ أُنِيبُ ", "translation": "And in anything over which you disagree - its ruling is [to be referred] to Allāh. [Say], \"That is Allāh, my Lord; upon Him I have relied, and to Him I turn back.\"[1]", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "ٱخْتَلَفْتُمْ", "translit": "ْmُtْfَlَtْhkٱ", "root": "خلف"}, {"id": 3, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 6, "arabic": "فَحُكْمُهُۥٓ", "translit": "ٓۥُhُmْkُḥَf", "root": "حكم"}, {"id": 7, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "ذَٰلِكُمُ", "translit": "ُmُkِlَٰhd", "root": ""}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 12, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "تَوَكَّلْتُ", "translit": "ُtْlَّkَwَt", "root": "وكل"}, {"id": 14, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 15, "arabic": "أُنِيبُ", "translit": "ُbyِnُaʾ", "root": "نوب"}], "hasIhya": false}, {"ayah": 11, "text": "فَاطِرُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ جَعَلَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا وَمِنَ ٱلْأَنْعَٰمِ أَزْوَٰجًاۖ يَذْرَؤُكُمْ فِيهِۚ لَيْسَ كَمِثْلِهِۦ شَىْءٌۖ وَهُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ ", "translation": "[He is] Creator of the heavens and the earth. He has made for you from yourselves, mates, and among the cattle, mates; He multiplies you thereby. There is nothing like unto Him,[1] and He is the Hearing, the Seeing.[2]", "words": [{"id": 1, "arabic": "فَاطِرُ", "translit": "ُrِṭāَf", "root": "فطر"}, {"id": 2, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 4, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 5, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 6, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 7, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 8, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 9, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 10, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 11, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 12, "arabic": "يَذْرَؤُكُمْ", "translit": "ْmُkُwʾَrْhdَy", "root": "ذرا"}, {"id": 13, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 14, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 15, "arabic": "كَمِثْلِهِۦ", "translit": "ۦِhِlْhtِmَk", "root": "مثل"}, {"id": 16, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 17, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 18, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 19, "arabic": "ٱلْبَصِيرُ", "translit": "ُryِṣَbْlٱ", "root": "بصر"}], "hasIhya": true}, {"ayah": 12, "text": "لَهُۥ مَقَالِيدُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ يَبْسُطُ ٱلرِّزْقَ لِمَن يَشَآءُ وَيَقْدِرُۚ إِنَّهُۥ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "To Him belong the keys of the heavens and the earth. He extends provision for whom He wills and restricts [it]. Indeed He is, of all things, Knowing.", "words": [{"id": 1, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 2, "arabic": "مَقَالِيدُ", "translit": "ُdyِlāَqَm", "root": "قلد"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "يَبْسُطُ", "translit": "ُṭُsْbَy", "root": "بسط"}, {"id": 6, "arabic": "ٱلرِّزْقَ", "translit": "َqْzِّrlٱ", "root": "رزق"}, {"id": 7, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 8, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 9, "arabic": "وَيَقْدِرُ", "translit": "ُrِdْqَyَw", "root": "قدر"}, {"id": 10, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 13, "text": "شَرَعَ لَكُم مِّنَ ٱلدِّينِ مَا وَصَّىٰ بِهِۦ نُوحًا وَٱلَّذِىٓ أَوْحَيْنَآ إِلَيْكَ وَمَا وَصَّيْنَا بِهِۦٓ إِبْرَٰهِيمَ وَمُوسَىٰ وَعِيسَىٰٓۖ أَنْ أَقِيمُوا۟ ٱلدِّينَ وَلَا تَتَفَرَّقُوا۟ فِيهِۚ كَبُرَ عَلَى ٱلْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِۚ ٱللَّهُ يَجْتَبِىٓ إِلَيْهِ مَن يَشَآءُ وَيَهْدِىٓ إِلَيْهِ مَن يُنِيبُ ", "translation": "He has ordained for you of religion what He enjoined upon Noah and that which We have revealed to you, [O Muḥammad], and what We enjoined upon Abraham and Moses and Jesus - to establish the religion and not be divided therein. Difficult for those who associate others with Allāh is that to which you invite them. Allāh chooses for Himself whom He wills and guides to Himself whoever turns back [to Him].", "words": [{"id": 1, "arabic": "شَرَعَ", "translit": "َʿعَrَhs", "root": "شرع"}, {"id": 2, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "وَصَّىٰ", "translit": "ٰàَّṣَw", "root": "وصي"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "نُوحًا", "translit": "āًḥwُn", "root": ""}, {"id": 9, "arabic": "وَٱلَّذِىٓ", "translit": "ٓàِhdَّlٱَw", "root": ""}, {"id": 10, "arabic": "أَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾ", "root": "وحي"}, {"id": 11, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "وَصَّيْنَا", "translit": "āَnْyَّṣَw", "root": "وصي"}, {"id": 14, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 15, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 16, "arabic": "وَمُوسَىٰ", "translit": "ٰàَswُmَw", "root": ""}, {"id": 17, "arabic": "وَعِيسَىٰٓ", "translit": "ٰٓàَsyِʿعَw", "root": ""}, {"id": 18, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 19, "arabic": "أَقِيمُوا۟", "translit": "۟āwُmyِqَaʾ", "root": "قوم"}, {"id": 20, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "تَتَفَرَّقُوا۟", "translit": "۟āwُqَّrَfَtَt", "root": "فرق"}, {"id": 23, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 24, "arabic": "كَبُرَ", "translit": "َrُbَk", "root": "كبر"}, {"id": 25, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 26, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}, {"id": 27, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 28, "arabic": "تَدْعُوهُمْ", "translit": "ْmُhwُʿعْdَt", "root": "دعو"}, {"id": 29, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 30, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 31, "arabic": "يَجْتَبِىٓ", "translit": "ٓàِbَtْjgَy", "root": "جبي"}, {"id": 32, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 33, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 34, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 35, "arabic": "وَيَهْدِىٓ", "translit": "ٓàِdْhَyَw", "root": "هدي"}, {"id": 36, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 37, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 38, "arabic": "يُنِيبُ", "translit": "ُbyِnُy", "root": "نوب"}], "hasIhya": false}, {"ayah": 14, "text": "وَمَا تَفَرَّقُوٓا۟ إِلَّا مِنۢ بَعْدِ مَا جَآءَهُمُ ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْۚ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِن رَّبِّكَ إِلَىٰٓ أَجَلٍ مُّسَمًّى لَّقُضِىَ بَيْنَهُمْۚ وَإِنَّ ٱلَّذِينَ أُورِثُوا۟ ٱلْكِتَٰبَ مِنۢ بَعْدِهِمْ لَفِى شَكٍّ مِّنْهُ مُرِيبٍ ", "translation": "And they did not become divided until after knowledge had come to them - out of jealous animosity between themselves. And if not for a word[1] that preceded from your Lord [postponing the penalty] until a specified time, it would have been concluded between them. And indeed, those who were granted inheritance of the Scripture after them are, concerning it, in disquieting doubt.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تَفَرَّقُوٓا۟", "translit": "۟āٓwُqَّrَfَt", "root": "فرق"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 8, "arabic": "ٱلْعِلْمُ", "translit": "ُmْlِʿعْlٱ", "root": "علم"}, {"id": 9, "arabic": "بَغْيًۢا", "translit": "āًۢyْغَb", "root": "بغي"}, {"id": 10, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 11, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 12, "arabic": "كَلِمَةٌ", "translit": "ٌẗَmِlَk", "root": "كلم"}, {"id": 13, "arabic": "سَبَقَتْ", "translit": "ْtَqَbَs", "root": "سبق"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 16, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 17, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 18, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 19, "arabic": "لَّقُضِىَ", "translit": "َàِḍُqَّl", "root": "قضي"}, {"id": 20, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 21, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 22, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 23, "arabic": "أُورِثُوا۟", "translit": "۟āwُhtِrwُaʾ", "root": "ورث"}, {"id": 24, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 25, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 26, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 27, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 28, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 29, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 30, "arabic": "مُرِيبٍ", "translit": "ٍbyِrُm", "root": "ريب"}], "hasIhya": true}, {"ayah": 15, "text": "فَلِذَٰلِكَ فَٱدْعُۖ وَٱسْتَقِمْ كَمَآ أُمِرْتَۖ وَلَا تَتَّبِعْ أَهْوَآءَهُمْۖ وَقُلْ ءَامَنتُ بِمَآ أَنزَلَ ٱللَّهُ مِن كِتَٰبٍۖ وَأُمِرْتُ لِأَعْدِلَ بَيْنَكُمُۖ ٱللَّهُ رَبُّنَا وَرَبُّكُمْۖ لَنَآ أَعْمَٰلُنَا وَلَكُمْ أَعْمَٰلُكُمْۖ لَا حُجَّةَ بَيْنَنَا وَبَيْنَكُمُۖ ٱللَّهُ يَجْمَعُ بَيْنَنَاۖ وَإِلَيْهِ ٱلْمَصِيرُ ", "translation": "So to that [religion of Allāh] invite, [O Muḥammad],[1] and remain on a right course as you are commanded and do not follow their inclinations but say, \"I have believed in what Allāh has revealed of scripture [i.e., the Qur’ān], and I have been commanded to do justice among you. Allāh is our Lord and your Lord. For us are our deeds, and for you your deeds.[2] There is no [need for] argument between us and you.[3] Allāh will bring us together, and to Him is the [final] destination.\"", "words": [{"id": 1, "arabic": "فَلِذَٰلِكَ", "translit": "َkِlَٰhdِlَf", "root": ""}, {"id": 2, "arabic": "فَٱدْعُ", "translit": "ُʿعْdٱَf", "root": "دعو"}, {"id": 3, "arabic": "وَٱسْتَقِمْ", "translit": "ْmِqَtْsٱَw", "root": "قوم"}, {"id": 4, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 5, "arabic": "أُمِرْتَ", "translit": "َtْrِmُaʾ", "root": "امر"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَتَّبِعْ", "translit": "ْʿعِbَّtَt", "root": "تبع"}, {"id": 8, "arabic": "أَهْوَآءَهُمْ", "translit": "ْmُhَءٓāَwْhَaʾ", "root": "هوي"}, {"id": 9, "arabic": "وَقُلْ", "translit": "ْlُqَw", "root": "قول"}, {"id": 10, "arabic": "ءَامَنتُ", "translit": "ُtnَmāَء", "root": "امن"}, {"id": 11, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 12, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 16, "arabic": "وَأُمِرْتُ", "translit": "ُtْrِmُaʾَw", "root": "امر"}, {"id": 17, "arabic": "لِأَعْدِلَ", "translit": "َlِdْʿعَaʾِl", "root": "عدل"}, {"id": 18, "arabic": "بَيْنَكُمُ", "translit": "ُmُkَnْyَb", "root": "بين"}, {"id": 19, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 21, "arabic": "وَرَبُّكُمْ", "translit": "ْmُkُّbَrَw", "root": "ربب"}, {"id": 22, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 23, "arabic": "أَعْمَٰلُنَا", "translit": "āَnُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 24, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 25, "arabic": "أَعْمَٰلُكُمْ", "translit": "ْmُkُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 26, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 27, "arabic": "حُجَّةَ", "translit": "َẗَّjgُḥ", "root": "حجج"}, {"id": 28, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 29, "arabic": "وَبَيْنَكُمُ", "translit": "ُmُkَnْyَbَw", "root": "بين"}, {"id": 30, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 31, "arabic": "يَجْمَعُ", "translit": "ُʿعَmْjgَy", "root": "جمع"}, {"id": 32, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 33, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 34, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": false}, {"ayah": 16, "text": "وَٱلَّذِينَ يُحَآجُّونَ فِى ٱللَّهِ مِنۢ بَعْدِ مَا ٱسْتُجِيبَ لَهُۥ حُجَّتُهُمْ دَاحِضَةٌ عِندَ رَبِّهِمْ وَعَلَيْهِمْ غَضَبٌ وَلَهُمْ عَذَابٌ شَدِيدٌ ", "translation": "And those who argue concerning Allāh after He has been responded to[1] - their argument is invalid with their Lord, and upon them is [His] wrath, and for them is a severe punishment.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُحَآجُّونَ", "translit": "َnwُّjgٓāَḥُy", "root": "حجج"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "ٱسْتُجِيبَ", "translit": "َbyِjgُtْsٱ", "root": "جوب"}, {"id": 9, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 10, "arabic": "حُجَّتُهُمْ", "translit": "ْmُhُtَّjgُḥ", "root": "حجج"}, {"id": 11, "arabic": "دَاحِضَةٌ", "translit": "ٌẗَḍِḥāَd", "root": "دحض"}, {"id": 12, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 13, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 14, "arabic": "وَعَلَيْهِمْ", "translit": "ْmِhْyَlَʿعَw", "root": ""}, {"id": 15, "arabic": "غَضَبٌ", "translit": "ٌbَḍَغ", "root": "غضب"}, {"id": 16, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 17, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 18, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}], "hasIhya": false}, {"ayah": 17, "text": "ٱللَّهُ ٱلَّذِىٓ أَنزَلَ ٱلْكِتَٰبَ بِٱلْحَقِّ وَٱلْمِيزَانَۗ وَمَا يُدْرِيكَ لَعَلَّ ٱلسَّاعَةَ قَرِيبٌ ", "translation": "It is Allāh who has sent down the Book in truth and [also] the balance [i.e., justice]. And what will make you perceive? Perhaps the Hour is near.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "وَٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱَw", "root": "وزن"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "يُدْرِيكَ", "translit": "َkyِrْdُy", "root": "دري"}, {"id": 9, "arabic": "لَعَلَّ", "translit": "َّlَʿعَl", "root": ""}, {"id": 10, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 11, "arabic": "قَرِيبٌ", "translit": "ٌbyِrَq", "root": "قرب"}], "hasIhya": false}, {"ayah": 18, "text": "يَسْتَعْجِلُ بِهَا ٱلَّذِينَ لَا يُؤْمِنُونَ بِهَاۖ وَٱلَّذِينَ ءَامَنُوا۟ مُشْفِقُونَ مِنْهَا وَيَعْلَمُونَ أَنَّهَا ٱلْحَقُّۗ أَلَآ إِنَّ ٱلَّذِينَ يُمَارُونَ فِى ٱلسَّاعَةِ لَفِى ضَلَٰلٍۭ بَعِيدٍ ", "translation": "Those who do not believe in it are impatient for it,[1] but those who believe are fearful of it and know that it is the truth. Unquestionably, those who dispute concerning the Hour are in extreme error.", "words": [{"id": 1, "arabic": "يَسْتَعْجِلُ", "translit": "ُlِjgْʿعَtْsَy", "root": "عجل"}, {"id": 2, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 6, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 7, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 8, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 9, "arabic": "مُشْفِقُونَ", "translit": "َnwُqِfْhsُm", "root": "شفق"}, {"id": 10, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 11, "arabic": "وَيَعْلَمُونَ", "translit": "َnwُmَlْʿعَyَw", "root": "علم"}, {"id": 12, "arabic": "أَنَّهَا", "translit": "āَhَّnَaʾ", "root": ""}, {"id": 13, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 14, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "يُمَارُونَ", "translit": "َnwُrāَmُy", "root": "مري"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 20, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 21, "arabic": "ضَلَٰلٍۭ", "translit": "ٍۭlَٰlَḍ", "root": "ضلل"}, {"id": 22, "arabic": "بَعِيدٍ", "translit": "ٍdyِʿعَb", "root": "بعد"}], "hasIhya": false}, {"ayah": 19, "text": "ٱللَّهُ لَطِيفٌۢ بِعِبَادِهِۦ يَرْزُقُ مَن يَشَآءُۖ وَهُوَ ٱلْقَوِىُّ ٱلْعَزِيزُ ", "translation": "Allāh is Subtle[1] with His servants; He gives provision to whom He wills. And He is the Powerful, the Exalted in Might.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "لَطِيفٌۢ", "translit": "ٌۢfyِṭَl", "root": "لطف"}, {"id": 3, "arabic": "بِعِبَادِهِۦ", "translit": "ۦِhِdāَbِʿعِb", "root": "عبد"}, {"id": 4, "arabic": "يَرْزُقُ", "translit": "ُqُzْrَy", "root": "رزق"}, {"id": 5, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 6, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 7, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 8, "arabic": "ٱلْقَوِىُّ", "translit": "ُّàِwَqْlٱ", "root": "قوي"}, {"id": 9, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}], "hasIhya": false}, {"ayah": 20, "text": "مَن كَانَ يُرِيدُ حَرْثَ ٱلْءَاخِرَةِ نَزِدْ لَهُۥ فِى حَرْثِهِۦۖ وَمَن كَانَ يُرِيدُ حَرْثَ ٱلدُّنْيَا نُؤْتِهِۦ مِنْهَا وَمَا لَهُۥ فِى ٱلْءَاخِرَةِ مِن نَّصِيبٍ ", "translation": "Whoever desires the harvest of the Hereafter - We increase for him in his harvest [i.e., reward]. And whoever desires the harvest [i.e., benefits] of this world - We give him thereof, but there is not for him in the Hereafter any share.", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 4, "arabic": "حَرْثَ", "translit": "َhtْrَḥ", "root": "حرث"}, {"id": 5, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 6, "arabic": "نَزِدْ", "translit": "ْdِzَn", "root": "زيد"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "حَرْثِهِۦ", "translit": "ۦِhِhtْrَḥ", "root": "حرث"}, {"id": 10, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 11, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 12, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 13, "arabic": "حَرْثَ", "translit": "َhtْrَḥ", "root": "حرث"}, {"id": 14, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 15, "arabic": "نُؤْتِهِۦ", "translit": "ۦِhِtْwʾُn", "root": "اتي"}, {"id": 16, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 17, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 18, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 19, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 20, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 21, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 22, "arabic": "نَّصِيبٍ", "translit": "ٍbyِṣَّn", "root": "نصب"}], "hasIhya": true}, {"ayah": 21, "text": "أَمْ لَهُمْ شُرَكَٰٓؤُا۟ شَرَعُوا۟ لَهُم مِّنَ ٱلدِّينِ مَا لَمْ يَأْذَنۢ بِهِ ٱللَّهُۚ وَلَوْلَا كَلِمَةُ ٱلْفَصْلِ لَقُضِىَ بَيْنَهُمْۗ وَإِنَّ ٱلظَّٰلِمِينَ لَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "Or have they partners [i.e., other deities] who have ordained for them a religion to which Allāh has not consented? But if not for the decisive word,[1] it would have been concluded between them. And indeed, the wrongdoers will have a painful punishment.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "شُرَكَٰٓؤُا۟", "translit": "۟āُwʾَٰٓkَrُhs", "root": "شرك"}, {"id": 4, "arabic": "شَرَعُوا۟", "translit": "۟āwُʿعَrَhs", "root": "شرع"}, {"id": 5, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 10, "arabic": "يَأْذَنۢ", "translit": "ۢnَhdْaʾَy", "root": "اذن"}, {"id": 11, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 14, "arabic": "كَلِمَةُ", "translit": "ُẗَmِlَk", "root": "كلم"}, {"id": 15, "arabic": "ٱلْفَصْلِ", "translit": "ِlْṣَfْlٱ", "root": "فصل"}, {"id": 16, "arabic": "لَقُضِىَ", "translit": "َàِḍُqَl", "root": "قضي"}, {"id": 17, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 18, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 19, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}, {"id": 20, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 21, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 22, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 22, "text": "تَرَى ٱلظَّٰلِمِينَ مُشْفِقِينَ مِمَّا كَسَبُوا۟ وَهُوَ وَاقِعٌۢ بِهِمْۗ وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فِى رَوْضَاتِ ٱلْجَنَّاتِۖ لَهُم مَّا يَشَآءُونَ عِندَ رَبِّهِمْۚ ذَٰلِكَ هُوَ ٱلْفَضْلُ ٱلْكَبِيرُ ", "translation": "You will see the wrongdoers fearful of what they have earned, and it will [certainly] befall them. And those who have believed and done righteous deeds will be in lush regions of the gardens [in Paradise] having whatever they will in the presence of their Lord. That is what is the great bounty.", "words": [{"id": 1, "arabic": "تَرَى", "translit": "àَrَt", "root": "راي"}, {"id": 2, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}, {"id": 3, "arabic": "مُشْفِقِينَ", "translit": "َnyِqِfْhsُm", "root": "شفق"}, {"id": 4, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 5, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "وَاقِعٌۢ", "translit": "ٌۢʿعِqāَw", "root": "وقع"}, {"id": 8, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 9, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 10, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 11, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 12, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "رَوْضَاتِ", "translit": "ِtāَḍْwَr", "root": "روض"}, {"id": 15, "arabic": "ٱلْجَنَّاتِ", "translit": "ِtāَّnَjgْlٱ", "root": "جنن"}, {"id": 16, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 17, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 18, "arabic": "يَشَآءُونَ", "translit": "َnwُءٓāَhsَy", "root": "شيا"}, {"id": 19, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 20, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 21, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 22, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 23, "arabic": "ٱلْفَضْلُ", "translit": "ُlْḍَfْlٱ", "root": "فضل"}, {"id": 24, "arabic": "ٱلْكَبِيرُ", "translit": "ُryِbَkْlٱ", "root": "كبر"}], "hasIhya": true}, {"ayah": 23, "text": "ذَٰلِكَ ٱلَّذِى يُبَشِّرُ ٱللَّهُ عِبَادَهُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِۗ قُل لَّآ أَسْـَٔلُكُمْ عَلَيْهِ أَجْرًا إِلَّا ٱلْمَوَدَّةَ فِى ٱلْقُرْبَىٰۗ وَمَن يَقْتَرِفْ حَسَنَةً نَّزِدْ لَهُۥ فِيهَا حُسْنًاۚ إِنَّ ٱللَّهَ غَفُورٌ شَكُورٌ ", "translation": "It is that of which Allāh gives good tidings to His servants who believe and do righteous deeds. Say, [O Muḥammad], \"I do not ask you for it [i.e., this message] any payment [but] only good will through [i.e., due to] kinship.\" And whoever commits a good deed - We will increase for him good therein. Indeed, Allāh is Forgiving and Appreciative.[1]", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُبَشِّرُ", "translit": "ُrِّhsَbُy", "root": "بشر"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "عِبَادَهُ", "translit": "ُhَdāَbِʿع", "root": "عبد"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 9, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 10, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 11, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 12, "arabic": "أَسْـَٔلُكُمْ", "translit": "ْmُkُlَٔـْsَaʾ", "root": "سال"}, {"id": 13, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "ٱلْمَوَدَّةَ", "translit": "َẗَّdَwَmْlٱ", "root": "ودد"}, {"id": 17, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 18, "arabic": "ٱلْقُرْبَىٰ", "translit": "ٰàَbْrُqْlٱ", "root": "قرب"}, {"id": 19, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 20, "arabic": "يَقْتَرِفْ", "translit": "ْfِrَtْqَy", "root": "قرف"}, {"id": 21, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 22, "arabic": "نَّزِدْ", "translit": "ْdِzَّn", "root": "زيد"}, {"id": 23, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 24, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 25, "arabic": "حُسْنًا", "translit": "āًnْsُḥ", "root": "حسن"}, {"id": 26, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 27, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 29, "arabic": "شَكُورٌ", "translit": "ٌrwُkَhs", "root": "شكر"}], "hasIhya": false}, {"ayah": 24, "text": "أَمْ يَقُولُونَ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًاۖ فَإِن يَشَإِ ٱللَّهُ يَخْتِمْ عَلَىٰ قَلْبِكَۗ وَيَمْحُ ٱللَّهُ ٱلْبَٰطِلَ وَيُحِقُّ ٱلْحَقَّ بِكَلِمَٰتِهِۦٓۚ إِنَّهُۥ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ", "translation": "Or do they say, \"He has invented about Allāh a lie\"? But if Allāh willed, He could seal over your heart.[1] And Allāh eliminates falsehood and establishes the truth by His words. Indeed, He is Knowing of that within the breasts.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "ٱفْتَرَىٰ", "translit": "ٰàَrَtْfٱ", "root": "فري"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}, {"id": 7, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 8, "arabic": "يَشَإِ", "translit": "ِiʾَhsَy", "root": "شيا"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "يَخْتِمْ", "translit": "ْmِtْhkَy", "root": "ختم"}, {"id": 11, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 12, "arabic": "قَلْبِكَ", "translit": "َkِbْlَq", "root": "قلب"}, {"id": 13, "arabic": "وَيَمْحُ", "translit": "ُḥْmَyَw", "root": "محو"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "ٱلْبَٰطِلَ", "translit": "َlِṭَٰbْlٱ", "root": "بطل"}, {"id": 16, "arabic": "وَيُحِقُّ", "translit": "ُّqِḥُyَw", "root": "حقق"}, {"id": 17, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 18, "arabic": "بِكَلِمَٰتِهِۦٓ", "translit": "ٓۦِhِtَٰmِlَkِb", "root": "كلم"}, {"id": 19, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 20, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 21, "arabic": "بِذَاتِ", "translit": "ِtāَhdِb", "root": ""}, {"id": 22, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": true}, {"ayah": 25, "text": "وَهُوَ ٱلَّذِى يَقْبَلُ ٱلتَّوْبَةَ عَنْ عِبَادِهِۦ وَيَعْفُوا۟ عَنِ ٱلسَّيِّـَٔاتِ وَيَعْلَمُ مَا تَفْعَلُونَ ", "translation": "And it is He who accepts repentance from His servants and pardons misdeeds, and He knows what you do.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَقْبَلُ", "translit": "ُlَbْqَy", "root": "قبل"}, {"id": 4, "arabic": "ٱلتَّوْبَةَ", "translit": "َẗَbْwَّtlٱ", "root": "توب"}, {"id": 5, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 6, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 7, "arabic": "وَيَعْفُوا۟", "translit": "۟āwُfْʿعَyَw", "root": "عفو"}, {"id": 8, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 9, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 10, "arabic": "وَيَعْلَمُ", "translit": "ُmَlْʿعَyَw", "root": "علم"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "تَفْعَلُونَ", "translit": "َnwُlَʿعْfَt", "root": "فعل"}], "hasIhya": true}, {"ayah": 26, "text": "وَيَسْتَجِيبُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَيَزِيدُهُم مِّن فَضْلِهِۦۚ وَٱلْكَٰفِرُونَ لَهُمْ عَذَابٌ شَدِيدٌ ", "translation": "And He answers [the supplication of] those who have believed and done righteous deeds and increases [for] them from His bounty. But the disbelievers will have a severe punishment.", "words": [{"id": 1, "arabic": "وَيَسْتَجِيبُ", "translit": "ُbyِjgَtْsَyَw", "root": "جوب"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "وَيَزِيدُهُم", "translit": "mُhُdyِzَyَw", "root": "زيد"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 9, "arabic": "وَٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱَw", "root": "كفر"}, {"id": 10, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}], "hasIhya": true}, {"ayah": 27, "text": "وَلَوْ بَسَطَ ٱللَّهُ ٱلرِّزْقَ لِعِبَادِهِۦ لَبَغَوْا۟ فِى ٱلْأَرْضِ وَلَٰكِن يُنَزِّلُ بِقَدَرٍ مَّا يَشَآءُۚ إِنَّهُۥ بِعِبَادِهِۦ خَبِيرٌۢ بَصِيرٌ ", "translation": "And if Allāh had extended [excessively] provision for His servants, they would have committed tyranny throughout the earth. But He sends [it] down in an amount which He wills. Indeed He is, of His servants, Aware and Seeing.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "بَسَطَ", "translit": "َṭَsَb", "root": "بسط"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلرِّزْقَ", "translit": "َqْzِّrlٱ", "root": "رزق"}, {"id": 5, "arabic": "لِعِبَادِهِۦ", "translit": "ۦِhِdāَbِʿعِl", "root": "عبد"}, {"id": 6, "arabic": "لَبَغَوْا۟", "translit": "۟āْwَغَbَl", "root": "بغي"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 10, "arabic": "يُنَزِّلُ", "translit": "ُlِّzَnُy", "root": "نزل"}, {"id": 11, "arabic": "بِقَدَرٍ", "translit": "ٍrَdَqِb", "root": "قدر"}, {"id": 12, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 13, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 14, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 15, "arabic": "بِعِبَادِهِۦ", "translit": "ۦِhِdāَbِʿعِb", "root": "عبد"}, {"id": 16, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 17, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 28, "text": "وَهُوَ ٱلَّذِى يُنَزِّلُ ٱلْغَيْثَ مِنۢ بَعْدِ مَا قَنَطُوا۟ وَيَنشُرُ رَحْمَتَهُۥۚ وَهُوَ ٱلْوَلِىُّ ٱلْحَمِيدُ ", "translation": "And it is He who sends down the rain after they had despaired and spreads His mercy. And He is the Protector, the Praiseworthy.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُنَزِّلُ", "translit": "ُlِّzَnُy", "root": "نزل"}, {"id": 4, "arabic": "ٱلْغَيْثَ", "translit": "َhtْyَغْlٱ", "root": "غيث"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "قَنَطُوا۟", "translit": "۟āwُṭَnَq", "root": "قنط"}, {"id": 9, "arabic": "وَيَنشُرُ", "translit": "ُrُhsnَyَw", "root": "نشر"}, {"id": 10, "arabic": "رَحْمَتَهُۥ", "translit": "ۥُhَtَmْḥَr", "root": "رحم"}, {"id": 11, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 12, "arabic": "ٱلْوَلِىُّ", "translit": "ُّàِlَwْlٱ", "root": "ولي"}, {"id": 13, "arabic": "ٱلْحَمِيدُ", "translit": "ُdyِmَḥْlٱ", "root": "حمد"}], "hasIhya": false}, {"ayah": 29, "text": "وَمِنْ ءَايَٰتِهِۦ خَلْقُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَثَّ فِيهِمَا مِن دَآبَّةٍۚ وَهُوَ عَلَىٰ جَمْعِهِمْ إِذَا يَشَآءُ قَدِيرٌ ", "translation": "And of His signs is the creation of the heavens and earth and what He has dispersed throughout them of creatures. And He, for gathering them when He wills, is competent.", "words": [{"id": 1, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 2, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "خَلْقُ", "translit": "ُqْlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "بَثَّ", "translit": "َّhtَb", "root": "بثث"}, {"id": 8, "arabic": "فِيهِمَا", "translit": "āَmِhyِf", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 11, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 12, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 13, "arabic": "جَمْعِهِمْ", "translit": "ْmِhِʿعْmَjg", "root": "جمع"}, {"id": 14, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 15, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 16, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 30, "text": "وَمَآ أَصَٰبَكُم مِّن مُّصِيبَةٍ فَبِمَا كَسَبَتْ أَيْدِيكُمْ وَيَعْفُوا۟ عَن كَثِيرٍ ", "translation": "And whatever strikes you of disaster - it is for what your hands have earned; but He pardons much.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَصَٰبَكُم", "translit": "mُkَbَٰṣَaʾ", "root": "صوب"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "مُّصِيبَةٍ", "translit": "ٍẗَbyِṣُّm", "root": "صوب"}, {"id": 5, "arabic": "فَبِمَا", "translit": "āَmِbَf", "root": ""}, {"id": 6, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 7, "arabic": "أَيْدِيكُمْ", "translit": "ْmُkyِdْyَaʾ", "root": "يدي"}, {"id": 8, "arabic": "وَيَعْفُوا۟", "translit": "۟āwُfْʿعَyَw", "root": "عفو"}, {"id": 9, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 10, "arabic": "كَثِيرٍ", "translit": "ٍryِhtَk", "root": "كثر"}], "hasIhya": true}, {"ayah": 31, "text": "وَمَآ أَنتُم بِمُعْجِزِينَ فِى ٱلْأَرْضِۖ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِىٍّ وَلَا نَصِيرٍ ", "translation": "And you will not cause failure [to Allāh][1] upon the earth. And you have not besides Allāh any protector or helper.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 3, "arabic": "بِمُعْجِزِينَ", "translit": "َnyِzِjgْʿعُmِb", "root": "عجز"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "وَلِىٍّ", "translit": "ٍّàِlَw", "root": "ولي"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "نَصِيرٍ", "translit": "ٍryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 32, "text": "وَمِنْ ءَايَٰتِهِ ٱلْجَوَارِ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ ", "translation": "And of His signs are the ships in the sea, like mountains.", "words": [{"id": 1, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 2, "arabic": "ءَايَٰتِهِ", "translit": "ِhِtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱلْجَوَارِ", "translit": "ِrāَwَjgْlٱ", "root": "جري"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 6, "arabic": "كَٱلْأَعْلَٰمِ", "translit": "ِmَٰlْʿعَaʾْlٱَk", "root": "علم"}], "hasIhya": false}, {"ayah": 33, "text": "إِن يَشَأْ يُسْكِنِ ٱلرِّيحَ فَيَظْلَلْنَ رَوَاكِدَ عَلَىٰ ظَهْرِهِۦٓۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّكُلِّ صَبَّارٍ شَكُورٍ ", "translation": "If He willed, He could still the wind, and they would remain motionless on its surface. Indeed in that are signs for everyone patient and grateful.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "يَشَأْ", "translit": "ْaʾَhsَy", "root": "شيا"}, {"id": 3, "arabic": "يُسْكِنِ", "translit": "ِnِkْsُy", "root": "سكن"}, {"id": 4, "arabic": "ٱلرِّيحَ", "translit": "َḥyِّrlٱ", "root": "روح"}, {"id": 5, "arabic": "فَيَظْلَلْنَ", "translit": "َnْlَlْẓَyَf", "root": "ظلل"}, {"id": 6, "arabic": "رَوَاكِدَ", "translit": "َdِkāَwَr", "root": "ركد"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "ظَهْرِهِۦٓ", "translit": "ٓۦِhِrْhَẓ", "root": "ظهر"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 12, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 13, "arabic": "لِّكُلِّ", "translit": "ِّlُkِّl", "root": "كلل"}, {"id": 14, "arabic": "صَبَّارٍ", "translit": "ٍrāَّbَṣ", "root": "صبر"}, {"id": 15, "arabic": "شَكُورٍ", "translit": "ٍrwُkَhs", "root": "شكر"}], "hasIhya": false}, {"ayah": 34, "text": "أَوْ يُوبِقْهُنَّ بِمَا كَسَبُوا۟ وَيَعْفُ عَن كَثِيرٍ ", "translation": "Or He could destroy them[1] for what they earned; but He pardons much.", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "يُوبِقْهُنَّ", "translit": "َّnُhْqِbwُy", "root": "وبق"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 5, "arabic": "وَيَعْفُ", "translit": "ُfْʿعَyَw", "root": "عفو"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "كَثِيرٍ", "translit": "ٍryِhtَk", "root": "كثر"}], "hasIhya": false}, {"ayah": 35, "text": "وَيَعْلَمَ ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِنَا مَا لَهُم مِّن مَّحِيصٍ ", "translation": "And [that is so] those who dispute concerning Our signs may know that for them there is no place of escape.", "words": [{"id": 1, "arabic": "وَيَعْلَمَ", "translit": "َmَlْʿعَyَw", "root": "علم"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُجَٰدِلُونَ", "translit": "َnwُlِdَٰjgُy", "root": "جدل"}, {"id": 4, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 5, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "مَّحِيصٍ", "translit": "ٍṣyِḥَّm", "root": "حيص"}], "hasIhya": false}, {"ayah": 36, "text": "فَمَآ أُوتِيتُم مِّن شَىْءٍ فَمَتَٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَمَا عِندَ ٱللَّهِ خَيْرٌ وَأَبْقَىٰ لِلَّذِينَ ءَامَنُوا۟ وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ ", "translation": "So whatever thing you have been given - it is but [for] enjoyment of the worldly life. But what is with Allāh is better and more lasting for those who have believed and upon their Lord rely", "words": [{"id": 1, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 2, "arabic": "أُوتِيتُم", "translit": "mُtyِtwُaʾ", "root": "اتي"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 5, "arabic": "فَمَتَٰعُ", "translit": "ُʿعَٰtَmَf", "root": "متع"}, {"id": 6, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 7, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 12, "arabic": "وَأَبْقَىٰ", "translit": "ٰàَqْbَaʾَw", "root": "بقي"}, {"id": 13, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 14, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 15, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 16, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 17, "arabic": "يَتَوَكَّلُونَ", "translit": "َnwُlَّkَwَtَy", "root": "وكل"}], "hasIhya": true}, {"ayah": 37, "text": "وَٱلَّذِينَ يَجْتَنِبُونَ كَبَٰٓئِرَ ٱلْإِثْمِ وَٱلْفَوَٰحِشَ وَإِذَا مَا غَضِبُوا۟ هُمْ يَغْفِرُونَ ", "translation": "And those who avoid the major sins and immoralities, and when they are angry, they forgive,", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يَجْتَنِبُونَ", "translit": "َnwُbِnَtْjgَy", "root": "جنب"}, {"id": 3, "arabic": "كَبَٰٓئِرَ", "translit": "َrِyʾَٰٓbَk", "root": "كبر"}, {"id": 4, "arabic": "ٱلْإِثْمِ", "translit": "ِmْhtِiʾْlٱ", "root": "اثم"}, {"id": 5, "arabic": "وَٱلْفَوَٰحِشَ", "translit": "َhsِḥَٰwَfْlٱَw", "root": "فحش"}, {"id": 6, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "غَضِبُوا۟", "translit": "۟āwُbِḍَغ", "root": "غضب"}, {"id": 9, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 10, "arabic": "يَغْفِرُونَ", "translit": "َnwُrِfْغَy", "root": "غفر"}], "hasIhya": false}, {"ayah": 38, "text": "وَٱلَّذِينَ ٱسْتَجَابُوا۟ لِرَبِّهِمْ وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَأَمْرُهُمْ شُورَىٰ بَيْنَهُمْ وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَ ", "translation": "And those who have responded to their Lord and established prayer and whose affair is [determined by] consultation among themselves, and from what We have provided them, they spend,", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "ٱسْتَجَابُوا۟", "translit": "۟āwُbāَjgَtْsٱ", "root": "جوب"}, {"id": 3, "arabic": "لِرَبِّهِمْ", "translit": "ْmِhِّbَrِl", "root": "ربب"}, {"id": 4, "arabic": "وَأَقَامُوا۟", "translit": "۟āwُmāَqَaʾَw", "root": "قوم"}, {"id": 5, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 6, "arabic": "وَأَمْرُهُمْ", "translit": "ْmُhُrْmَaʾَw", "root": "امر"}, {"id": 7, "arabic": "شُورَىٰ", "translit": "ٰàَrwُhs", "root": "شور"}, {"id": 8, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 9, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 10, "arabic": "رَزَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَzَr", "root": "رزق"}, {"id": 11, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}], "hasIhya": true}, {"ayah": 39, "text": "وَٱلَّذِينَ إِذَآ أَصَابَهُمُ ٱلْبَغْىُ هُمْ يَنتَصِرُونَ ", "translation": "And those who, when tyranny strikes them, they retaliate [in a just manner].[1]", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَصَابَهُمُ", "translit": "ُmُhَbāَṣَaʾ", "root": "صوب"}, {"id": 4, "arabic": "ٱلْبَغْىُ", "translit": "ُàْغَbْlٱ", "root": "بغي"}, {"id": 5, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 6, "arabic": "يَنتَصِرُونَ", "translit": "َnwُrِṣَtnَy", "root": "نصر"}], "hasIhya": false}, {"ayah": 40, "text": "وَجَزَٰٓؤُا۟ سَيِّئَةٍ سَيِّئَةٌ مِّثْلُهَاۖ فَمَنْ عَفَا وَأَصْلَحَ فَأَجْرُهُۥ عَلَى ٱللَّهِۚ إِنَّهُۥ لَا يُحِبُّ ٱلظَّٰلِمِينَ ", "translation": "And the retribution for an evil act is an evil one like it, but whoever pardons and makes reconciliation - his reward is [due] from Allāh. Indeed, He does not like wrongdoers.", "words": [{"id": 1, "arabic": "وَجَزَٰٓؤُا۟", "translit": "۟āُwʾَٰٓzَjgَw", "root": "جزي"}, {"id": 2, "arabic": "سَيِّئَةٍ", "translit": "ٍẗَyʾِّyَs", "root": "سوا"}, {"id": 3, "arabic": "سَيِّئَةٌ", "translit": "ٌẗَyʾِّyَs", "root": "سوا"}, {"id": 4, "arabic": "مِّثْلُهَا", "translit": "āَhُlْhtِّm", "root": "مثل"}, {"id": 5, "arabic": "فَمَنْ", "translit": "ْnَmَf", "root": ""}, {"id": 6, "arabic": "عَفَا", "translit": "āَfَʿع", "root": "عفو"}, {"id": 7, "arabic": "وَأَصْلَحَ", "translit": "َḥَlْṣَaʾَw", "root": "صلح"}, {"id": 8, "arabic": "فَأَجْرُهُۥ", "translit": "ۥُhُrْjgَaʾَf", "root": "اجر"}, {"id": 9, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 14, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 41, "text": "وَلَمَنِ ٱنتَصَرَ بَعْدَ ظُلْمِهِۦ فَأُو۟لَٰٓئِكَ مَا عَلَيْهِم مِّن سَبِيلٍ ", "translation": "And whoever retaliates after having been wronged - those have not upon them any cause [for blame].", "words": [{"id": 1, "arabic": "وَلَمَنِ", "translit": "ِnَmَlَw", "root": ""}, {"id": 2, "arabic": "ٱنتَصَرَ", "translit": "َrَṣَtnٱ", "root": "نصر"}, {"id": 3, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 4, "arabic": "ظُلْمِهِۦ", "translit": "ۦِhِmْlُẓ", "root": "ظلم"}, {"id": 5, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "سَبِيلٍ", "translit": "ٍlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 42, "text": "إِنَّمَا ٱلسَّبِيلُ عَلَى ٱلَّذِينَ يَظْلِمُونَ ٱلنَّاسَ وَيَبْغُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّۚ أُو۟لَٰٓئِكَ لَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "The cause is only against the ones who wrong the people and tyrannize upon the earth without right. Those will have a painful punishment.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلسَّبِيلُ", "translit": "ُlyِbَّslٱ", "root": "سبل"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}, {"id": 6, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "وَيَبْغُونَ", "translit": "َnwُغْbَyَw", "root": "بغي"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 11, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 12, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 13, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 14, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 15, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 43, "text": "وَلَمَن صَبَرَ وَغَفَرَ إِنَّ ذَٰلِكَ لَمِنْ عَزْمِ ٱلْأُمُورِ ", "translation": "And whoever is patient and forgives - indeed, that is of the matters [worthy] of resolve.[1]", "words": [{"id": 1, "arabic": "وَلَمَن", "translit": "nَmَlَw", "root": ""}, {"id": 2, "arabic": "صَبَرَ", "translit": "َrَbَṣ", "root": "صبر"}, {"id": 3, "arabic": "وَغَفَرَ", "translit": "َrَfَغَw", "root": "غفر"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 6, "arabic": "لَمِنْ", "translit": "ْnِmَl", "root": ""}, {"id": 7, "arabic": "عَزْمِ", "translit": "ِmْzَʿع", "root": "عزم"}, {"id": 8, "arabic": "ٱلْأُمُورِ", "translit": "ِrwُmُaʾْlٱ", "root": "امر"}], "hasIhya": true}, {"ayah": 44, "text": "وَمَن يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِن وَلِىٍّ مِّنۢ بَعْدِهِۦۗ وَتَرَى ٱلظَّٰلِمِينَ لَمَّا رَأَوُا۟ ٱلْعَذَابَ يَقُولُونَ هَلْ إِلَىٰ مَرَدٍّ مِّن سَبِيلٍ ", "translation": "And he whom Allāh sends astray - for him there is no protector beyond Him. And you will see the wrongdoers, when they see the punishment, saying, \"Is there for return [to the former world] any way?\"", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يُضْلِلِ", "t