تَفَرَّقُوا۟ فِيهِۚ كَبُرَ عَلَى ٱلْمُشْرِكِينَ مَا تَدْعُوهُمْ إِلَيْهِۚ ٱللَّهُ يَجْتَبِىٓ إِلَيْهِ مَن يَشَآءُ وَيَهْدِىٓ إِلَيْهِ مَن يُنِيبُ ","translation":"He has ordained for you of religion what He enjoined upon Noah and that which We have revealed to you, [O Muḥammad], and what We enjoined upon Abraham and Moses and Jesus - to establish the religion and not be divided therein. Difficult for those who associate others with Allāh is that to which you invite them. Allāh chooses for Himself whom He wills and guides to Himself whoever turns back [to Him].","words":[{"id":1,"arabic":"شَرَعَ","translit":"َʿعَrَhs","root":"شرع"},{"id":2,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":3,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":4,"arabic":"ٱلدِّينِ","translit":"ِnyِّdlٱ","root":"دين"},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"وَصَّىٰ","translit":"ٰàَّṣَw","root":"وصي"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"نُوحًا","translit":"āًḥwُn","root":""},{"id":9,"arabic":"وَٱلَّذِىٓ","translit":"ٓàِhdَّlٱَw","root":""},{"id":10,"arabic":"أَوْحَيْنَآ","translit":"ٓāَnْyَḥْwَaʾ","root":"وحي"},{"id":11,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":12,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":13,"arabic":"وَصَّيْنَا","translit":"āَnْyَّṣَw","root":"وصي"},{"id":14,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":15,"arabic":"إِبْرَٰهِيمَ","translit":"َmyِhَٰrْbِiʾ","root":""},{"id":16,"arabic":"وَمُوسَىٰ","translit":"ٰàَswُmَw","root":""},{"id":17,"arabic":"وَعِيسَىٰٓ","translit":"ٰٓàَsyِʿعَw","root":""},{"id":18,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":19,"arabic":"أَقِيمُوا۟","translit":"۟āwُmyِqَaʾ","root":"قوم"},{"id":20,"arabic":"ٱلدِّينَ","translit":"َnyِّdlٱ","root":"دين"},{"id":21,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":22,"arabic":"تَتَفَرَّقُوا۟","translit":"۟āwُqَّrَfَtَt","root":"فرق"},{"id":23,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":24,"arabic":"كَبُرَ","translit":"َrُbَk","root":"كبر"},{"id":25,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":26,"arabic":"ٱلْمُشْرِكِينَ","translit":"َnyِkِrْhsُmْlٱ","root":"شرك"},{"id":27,"arabic":"مَا","translit":"āَm","root":""},{"id":28,"arabic":"تَدْعُوهُمْ","translit":"ْmُhwُʿعْdَt","root":"دعو"},{"id":29,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":30,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":31,"arabic":"يَجْتَبِىٓ","translit":"ٓàِbَtْjgَy","root":"جبي"},{"id":32,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":33,"arabic":"مَن","translit":"nَm","root":""},{"id":34,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":35,"arabic":"وَيَهْدِىٓ","translit":"ٓàِdْhَyَw","root":"هدي"},{"id":36,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":37,"arabic":"مَن","translit":"nَm","root":""},{"id":38,"arabic":"يُنِيبُ","translit":"ُbyِnُy","root":"نوب"}],"hasIhya":false},{"ayah":14,"text":"وَمَا تَفَرَّقُوٓا۟ إِلَّا مِنۢ بَعْدِ مَا جَآءَهُمُ ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْۚ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِن رَّبِّكَ إِلَىٰٓ أَجَلٍ مُّسَمًّى لَّقُضِىَ بَيْنَهُمْۚ وَإِنَّ ٱلَّذِينَ أُورِثُوا۟ ٱلْكِتَٰبَ مِنۢ بَعْدِهِمْ لَفِى شَكٍّ مِّنْهُ مُرِيبٍ ","translation":"And they did not become divided until after knowledge had come to them - out of jealous animosity between themselves. And if not for a word[1] that preceded from your Lord [postponing the penalty] until a specified time, it would have been concluded between them. And indeed, those who were granted inheritance of the Scripture after them are, concerning it, in disquieting doubt.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"تَفَرَّقُوٓا۟","translit":"۟āٓwُqَّrَfَt","root":"فرق"},{"id":3,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":6,"arabic":"مَا","translit":"āَm","root":