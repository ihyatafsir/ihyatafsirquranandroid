": "warsh"}, {"surah": 58, "ayah": 4, "text": "فَمَن لَّمْ يَجِدْ فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ مِن قَبْلِ أَنْ يَّتَمَآسَّاۖ فَمَن لَّمْ يَسْتَطِعْ فَإِطْعَامُ سِتِّينَ مِسْكِيناࣰۖ ذَٰلِكَ لِتُومِنُواْ بِاللَّهِ وَرَسُولِهِۦۖ وَتِلْكَ حُدُودُ اُ۬للَّهِۖ وَلِلْكٰ۪فِرِينَ عَذَابٌ اَلِيمٌۖ", "words": [{"id": 1, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَجِدْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَصِيَامُ", "translit": "", "root": ""}, {"id": 5, "arabic": "شَهْرَيْنِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُتَتَابِعَيْنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "قَبْلِ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَّتَمَآسَّاۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَمَن", "translit": "", "root": ""}, {"id": 12, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَسْتَطِعْ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَإِطْعَامُ", "translit": "", "root": ""}, {"id": 15, "arabic": "سِتِّينَ", "translit": "", "root": ""}, {"id": 16, "arabic": "مِسْكِيناࣰۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 18, "arabic": "لِتُومِنُواْ", "translit": "", "root": ""}, {"id": 19, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَرَسُولِهِۦۖ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَتِلْكَ", "translit": "", "root": ""}, {"id": 22, "arabic": "حُدُودُ", "translit": "", "root": ""}, {"id": 23, "arabic": "اُ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 24, "arabic": "وَلِلْكٰ۪فِرِينَ", "translit": "", "root": ""}, {"id": 25, "arabic": "عَذَابٌ", "translit": "", "root": ""}, {"id": 26, "arabic": "اَلِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 58, "ayah": 5, "text": "اِنَّ اَ۬ل