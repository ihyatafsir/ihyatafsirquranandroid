{"surah": 58, "verses": [{"ayah": 1, "text": "قَدْ سَمِعَ ٱللَّهُ قَوْلَ ٱلَّتِى تُجَٰدِلُكَ فِى زَوْجِهَا وَتَشْتَكِىٓ إِلَى ٱللَّهِ وَٱللَّهُ يَسْمَعُ تَحَاوُرَكُمَآۚ إِنَّ ٱللَّهَ سَمِيعٌۢ بَصِيرٌ ", "translation": "Certainly has Allāh heard the speech of the one who argues [i.e., pleads] with you, [O Muḥammad], concerning her husband and directs her complaint to Allāh. And Allāh hears your dialogue; indeed, Allāh is Hearing and Seeing.", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "سَمِعَ", "translit": "َʿعِmَs", "root": "سمع"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "قَوْلَ", "translit": "َlْwَq", "root": "قول"}, {"id": 5, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 6, "arabic": "تُجَٰدِلُكَ", "translit": "َkُlِdَٰjgُt", "root": "جدل"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "زَوْجِهَا", "translit": "āَhِjgْwَz", "root": "زوج"}, {"id": 9, "arabic": "وَتَشْتَكِىٓ", "translit": "ٓàِkَtْhsَtَw", "root": "شكو"}, {"id": 10, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "يَسْمَعُ", "translit": "ُʿعَmْsَy", "root": "سمع"}, {"id": 14, "arabic": "تَحَاوُرَكُمَآ", "translit": "ٓāَmُkَrُwāَḥَt", "root": "حور"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "سَمِيعٌۢ", "translit": "ٌۢʿعyِmَs", "root": "سمع"}, {"id": 18, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 2, "text": "ٱلَّذِينَ يُظَٰهِرُونَ مِنكُم مِّن نِّسَآئِهِم مَّا هُنَّ أُمَّهَٰتِهِمْۖ إِنْ أُمَّهَٰتُهُمْ إِلَّا ٱلَّٰٓـِٔى وَلَدْنَهُمْۚ وَإِنَّهُمْ لَيَقُولُونَ مُنكَرًا مِّنَ ٱلْقَوْلِ وَزُورًاۚ وَإِنَّ ٱللَّهَ لَعَفُوٌّ غَفُورٌ ", "translation": "Those who pronounce ẓihār[1] among you [to separate] from their wives - they are not [consequently] their mothers. Their mothers are none but those who gave birth to them. And indeed, they are saying an objectionable statement and a falsehood. But indeed, Allāh is Pardoning and Forgiving.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُظَٰهِرُونَ", "translit": "َnwُrِhَٰẓُy", "root": "ظهر"}, {"id": 3, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "نِّسَآئِهِم", "translit": "mِhِyʾٓāَsِّn", "root": "نسو"}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "هُنَّ", "translit": "َّnُh", "root": ""}, {"id": 8, "arabic": "أُمَّهَٰتِهِمْ", "translit": "ْmِhِtَٰhَّmُaʾ", "root": "امم"}, {"id": 9, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 10, "arabic": "أُمَّهَٰتُهُمْ", "translit": "ْmُhُtَٰhَّmُaʾ", "root": "امم"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلَّٰٓـِٔى", "translit": "àِٔـَّٰٓlٱ", "root": ""}, {"id": 13, "arabic": "وَلَدْنَهُمْ", "translit": "ْmُhَnْdَlَw", "root": "ولد"}, {"id": 14, "arabic": "وَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَw", "root": ""}, {"id": 15, "arabic": "لَيَقُولُونَ", "translit": "َnwُlwُqَyَl", "root": "قول"}, {"id": 16, "arabic": "مُنكَرًا", "translit": "āًrَknُm", "root": "نكر"}, {"id": 17, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 18, "arabic": "ٱلْقَوْلِ", "translit": "ِlْwَqْlٱ", "root": "قول"}, {"id": 19, "arabic": "وَزُورًا", "translit": "āًrwُzَw", "root": "زور"}, {"id": 20, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 21, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "لَعَفُوٌّ", "translit": "ٌّwُfَʿعَl", "root": "عفو"}, {"id": 23, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}], "hasIhya": false}, {"ayah": 3, "text": "وَٱلَّذِينَ يُظَٰهِرُونَ مِن نِّسَآئِهِمْ ثُمَّ يَعُودُونَ لِمَا قَالُوا۟ فَتَحْرِيرُ رَقَبَةٍ مِّن قَبْلِ أَن يَتَمَآسَّاۚ ذَٰلِكُمْ تُوعَظُونَ بِهِۦۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ ", "translation": "And those who pronounce ẓihār from their wives and then [wish to] go back on what they said - then [there must be] the freeing of a slave before they touch one another. That is what you are admonished thereby; and Allāh is Aware of what you do.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُظَٰهِرُونَ", "translit": "َnwُrِhَٰẓُy", "root": "ظهر"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "نِّسَآئِهِمْ", "translit": "ْmِhِyʾٓāَsِّn", "root": "نسو"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "يَعُودُونَ", "translit": "َnwُdwُʿعَy", "root": "عود"}, {"id": 7, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 8, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 9, "arabic": "فَتَحْرِيرُ", "translit": "ُryِrْḥَtَf", "root": "حرر"}, {"id": 10, "arabic": "رَقَبَةٍ", "translit": "ٍẗَbَqَr", "root": "رقب"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "يَتَمَآسَّا", "translit": "āَّsٓāَmَtَy", "root": "مسس"}, {"id": 15, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 16, "arabic": "تُوعَظُونَ", "translit": "َnwُẓَʿعwُt", "root": "وعظ"}, {"id": 17, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 18, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 20, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 21, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 4, "text": "فَمَن لَّمْ يَجِدْ فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ مِن قَبْلِ أَن يَتَمَآسَّاۖ فَمَن لَّمْ يَسْتَطِعْ فَإِطْعَامُ سِتِّينَ مِسْكِينًاۚ ذَٰلِكَ لِتُؤْمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦۚ وَتِلْكَ حُدُودُ ٱللَّهِۗ وَلِلْكَٰفِرِينَ عَذَابٌ أَلِيمٌ ", "translation": "And he who does not find [a slave] - then a fast for two months consecutively[1] before they touch one another; and he who is unable - then the feeding of sixty poor persons. That is for you to believe [completely] in Allāh and His Messenger; and those are the limits [set by] Allāh. And for the disbelievers is a painful punishment.", "words": [{"id": 1, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 3, "arabic": "يَجِدْ", "translit": "ْdِjgَy", "root": "وجد"}, {"id": 4, "arabic": "فَصِيَامُ", "translit": "ُmāَyِṣَf", "root": "صوم"}, {"id": 5, "arabic": "شَهْرَيْنِ", "translit": "ِnْyَrْhَhs", "root": "شهر"}, {"id": 6, "arabic": "مُتَتَابِعَيْنِ", "translit": "ِnْyَʿعِbāَtَtُm", "root": "تبع"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يَتَمَآسَّا", "translit": "āَّsٓāَmَtَy", "root": "مسس"}, {"id": 11, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 12, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 13, "arabic": "يَسْتَطِعْ", "translit": "ْʿعِṭَtْsَy", "root": "طوع"}, {"id": 14, "arabic": "فَإِطْعَامُ", "translit": "ُmāَʿعْṭِiʾَf", "root": "طعم"}, {"id": 15, "arabic": "سِتِّينَ", "translit": "َnyِّtِs", "root": "ستت"}, {"id": 16, "arabic": "مِسْكِينًا", "translit": "āًnyِkْsِm", "root": "سكن"}, {"id": 17, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 18, "arabic": "لِتُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُtِl", "root": "امن"}, {"id": 19, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 20, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 21, "arabic": "وَتِلْكَ", "translit": "َkْlِtَw", "root": ""}, {"id": 22, "arabic": "حُدُودُ", "translit": "ُdwُdُḥ", "root": "حدد"}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "وَلِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِlَw", "root": "كفر"}, {"id": 25, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 26, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 5, "text": "إِنَّ ٱلَّذِينَ يُحَآدُّونَ ٱللَّهَ وَرَسُولَهُۥ كُبِتُوا۟ كَمَا كُبِتَ ٱلَّذِينَ مِن قَبْلِهِمْۚ وَقَدْ أَنزَلْنَآ ءَايَٰتٍۭ بَيِّنَٰتٍۚ وَلِلْكَٰفِرِينَ عَذَابٌ مُّهِينٌ ", "translation": "Indeed, those who oppose Allāh and His Messenger are abased as those before them were abased. And We have certainly sent down verses of clear evidence. And for the disbelievers is a humiliating punishment", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُحَآدُّونَ", "translit": "َnwُّdٓāَḥُy", "root": "حدد"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 6, "arabic": "كُبِتُوا۟", "translit": "۟āwُtِbُk", "root": "كبت"}, {"id": 7, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 8, "arabic": "كُبِتَ", "translit": "َtِbُk", "root": "كبت"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 12, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 13, "arabic": "أَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾ", "root": "نزل"}, {"id": 14, "arabic": "ءَايَٰتٍۭ", "translit": "ٍۭtَٰyāَء", "root": "ايي"}, {"id": 15, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 16, "arabic": "وَلِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِlَw", "root": "كفر"}, {"id": 17, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 18, "arabic": "مُّهِينٌ", "translit": "ٌnyِhُّm", "root": "هون"}], "hasIhya": false}, {"ayah": 6, "text": "يَوْمَ يَبْعَثُهُمُ ٱللَّهُ جَمِيعًا فَيُنَبِّئُهُم بِمَا عَمِلُوٓا۟ۚ أَحْصَىٰهُ ٱللَّهُ وَنَسُوهُۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ ", "translation": "On the Day when Allāh will resurrect them all and inform them of what they did. Allāh had enumerated it, while they forgot it; and Allāh is, over all things, Witness.[1]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَبْعَثُهُمُ", "translit": "ُmُhُhtَʿعْbَy", "root": "بعث"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 5, "arabic": "فَيُنَبِّئُهُم", "translit": "mُhُyʾِّbَnُyَf", "root": "نبا"}, {"id": 6, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 7, "arabic": "عَمِلُوٓا۟", "translit": "۟āٓwُlِmَʿع", "root": "عمل"}, {"id": 8, "arabic": "أَحْصَىٰهُ", "translit": "ُhٰàَṣْḥَaʾ", "root": "حصي"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَنَسُوهُ", "translit": "ُhwُsَnَw", "root": "نسي"}, {"id": 11, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 12, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 13, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 14, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 15, "arabic": "شَهِيدٌ", "translit": "ٌdyِhَhs", "root": "شهد"}], "hasIhya": true}, {"ayah": 7, "text": "أَلَمْ تَرَ أَنَّ ٱللَّهَ يَعْلَمُ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۖ مَا يَكُونُ مِن نَّجْوَىٰ ثَلَٰثَةٍ إِلَّا هُوَ رَابِعُهُمْ وَلَا خَمْسَةٍ إِلَّا هُوَ سَادِسُهُمْ وَلَآ أَدْنَىٰ مِن ذَٰلِكَ وَلَآ أَكْثَرَ إِلَّا هُوَ مَعَهُمْ أَيْنَ مَا كَانُوا۟ۖ ثُمَّ يُنَبِّئُهُم بِمَا عَمِلُوا۟ يَوْمَ ٱلْقِيَٰمَةِۚ إِنَّ ٱللَّهَ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "Have you not considered that Allāh knows what is in the heavens and what is on the earth? There are not three in a private conversation but that He is the fourth of them,[1] nor are there five but that He is the sixth of them - and no less than that and no more except that He is with them [in knowledge] wherever they are. Then He will inform them of what they did on the Day of Resurrection. Indeed Allāh is, of all things, Knowing.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "نَّجْوَىٰ", "translit": "ٰàَwْjgَّn", "root": "نجو"}, {"id": 16, "arabic": "ثَلَٰثَةٍ", "translit": "ٍẗَhtَٰlَht", "root": "ثلث"}, {"id": 17, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 18, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 19, "arabic": "رَابِعُهُمْ", "translit": "ْmُhُʿعِbāَr", "root": "ربع"}, {"id": 20, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"i