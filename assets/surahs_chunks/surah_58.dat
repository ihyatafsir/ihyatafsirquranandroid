عَنْهُ وَيَتَنَٰجَوْنَ بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ ٱلرَّسُولِ وَإِذَا جَآءُوكَ حَيَّوْكَ بِمَا لَمْ يُحَيِّكَ بِهِ ٱللَّهُ وَيَقُولُونَ فِىٓ أَنفُسِهِمْ لَوْلَا يُعَذِّبُنَا ٱللَّهُ بِمَا نَقُولُۚ حَسْبُهُمْ جَهَنَّمُ يَصْلَوْنَهَاۖ فَبِئْسَ ٱلْمَصِيرُ ", "translation": "Have you not considered those who were forbidden from private conversation [i.e., ridicule and conspiracy] and then return to that which they were forbidden and converse among themselves about sin and aggression and disobedience to the Messenger? And when they come to you, they greet you with that [word] by which Allāh does not greet you[1] and say among themselves, \"Why does Allāh not punish us for what we say?\" Sufficient for them is Hell, which they will [enter to] burn, and wretched is the destination.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "نُهُوا۟", "translit": "۟āwُhُn", "root": "نهي"}, {"id": 6, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 7, "arabic": "ٱلنَّجْوَىٰ", "translit": "ٰàَwْjgَّnlٱ", "root": "نجو"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "يَعُودُونَ", "translit": "َnwُdwُʿعَy", "root": "عود"}, {"id": 10, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 11, "arabic": "نُهُوا۟", "translit": "۟āwُhُn", "root": "نهي"}, {"id": 12, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 13, "arabic": "وَيَتَنَٰجَوْنَ", "translit": "َnْwَjgَٰnَtَyَw", "root": "نجو"}, {"id": 14, "arabic": "بِٱلْإِثْمِ", "translit": "ِmْhtِiʾْlٱِb", "root": "اثم"}, {"id": 15, "arabic": "وَٱلْعُدْوَٰنِ", "translit": "ِnَٰwْdُʿعْlٱَw", "root": "عدو"}, {"id": 16, "arabic": "وَمَعْصِيَتِ", "translit": "ِtَyِṣْʿعَmَw", "root": "عصي"}, {"id": 17, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 18, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 19, "arabic": "جَآءُوكَ", "translit": "َkwُءٓāَjg", "root": "جيا"}, {"id": 20, "arabic": "حَيَّوْكَ", "translit": "َkْwَّyَḥ", "root": "حيي"}, {"id": 21, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 22, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 23, "arabic": "يُحَيِّكَ", "translit": "َkِّyَḥُy", "root": "حيي"}, {"id": 24, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 25, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 27, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 28, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 29, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 30, "arabic": "يُعَذِّبُنَا", "translit": "āَnُbِّhdَʿعُy", "root": "عذب"}, {"id": 31, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 33, "arabic": "نَقُولُ", "translit": "ُlwُqَn", "root": "قول"}, {"id": 34, "arabic": "حَسْبُهُمْ", "translit": "ْmُhُbْsَḥ", "root": "حسب"}, {"id": 35, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 36, "arabic": "يَصْلَوْنَهَا", "translit": "āَhَnْwَlْṣَy", "root": "صلي"}, {"id": 37, "arabic": "فَبِئْسَ", "translit": "َsْyʾِbَf", "root": "باس"}, {"id": 38, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 9, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا تَنَٰجَيْتُمْ فَلَا تَتَنَٰجَوْا۟ بِٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَمَعْصِيَتِ ٱلرَّسُولِ وَتَنَٰجَوْا۟ بِٱلْبِرِّ وَٱلتَّقْوَىٰۖ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ تُحْشَرُونَ ", "translation": "O you who have believed, when you converse privately, do not converse about sin and aggression and disobedience to the Messenger but converse about righteousness and piety. And fear Allāh, to whom you will be gathered.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "تَنَٰجَيْتُمْ", "translit": "ْmُtْyَjgَٰnَt", "root": "نجو"}, {"id": 6, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 7, "arabic": "تَتَنَٰجَوْا۟", "translit": "۟āْwَjgَٰnَtَt", "root": "نجو"}, {"id": 8, "arabic": "بِٱلْإِثْمِ", "translit": "ِmْhtِiʾْlٱِb", "root": "اثم"}, {"id": 9, "arabic": "وَٱلْعُدْوَٰنِ", "translit": "ِnَٰwْdُʿعْlٱَw", "root": "عدو"}, {"id": 10, "arabic": "وَمَعْصِيَتِ", "translit": "ِtَyِṣْʿعَmَw", "root": "عصي"}, {"id": 11, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 12, "arabic": "وَتَنَٰجَوْا۟", "translit": "۟āْwَjgَٰnَtَw", "root": "نجو"}, {"id": 13, "arabic": "بِٱلْبِرِّ", "translit": "ِّrِbْlٱِb", "root": "برر"}, {"id": 14, "arabic": "وَٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱَw", "root": "وقي"}, {"id": 15, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 18, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 19, "arabic": "تُحْشَرُونَ", "translit": "َnwُrَhsْḥُt", "root": "حشر"}], "hasIhya": true}, {"ayah": 10, "text": "إِنَّمَا ٱلنَّجْوَىٰ مِنَ ٱلشَّيْطَٰنِ لِيَحْزُنَ ٱلَّذِينَ ءَامَنُوا۟ وَلَيْسَ بِضَآرِّهِمْ شَيْـًٔا إِلَّا بِإِذْنِ ٱللَّهِۚ وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ ٱلْمُؤْمِنُونَ ", "translation": "Private conversation is only from Satan that he may grieve those who have believed,[1] but he will not harm them at all except by permission of Allāh. And upon Allāh let the believers rely.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلنَّجْوَىٰ", "translit": "ٰàَwْjgَّnlٱ", "root": "نجو"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 5, "arabic": "لِيَحْزُنَ", "translit": "َnُzْḥَyِl", "root": "حزن"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "وَلَيْسَ", "translit": "َsْyَlَw", "root": "ليس"}, {"id": 9, "arabic": "بِضَآرِّهِمْ", "translit": "ْmِhِّrٓāَḍِb", "root": "ضرر"}, {"id": 10, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "فَلْيَتَوَكَّلِ", "translit": "ِlَّkَwَtَyْlَf", "root": "وكل"}, {"id": 17, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 11, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا قِيلَ لَكُمْ تَفَسَّحُوا۟ فِى ٱلْمَجَٰلِسِ فَٱفْسَحُوا۟ يَفْسَحِ ٱللَّهُ لَكُمْۖ وَإِذَا قِيلَ ٱنشُزُوا۟ فَٱنشُزُوا۟ يَرْفَعِ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ مِنكُمْ وَٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ دَرَجَٰتٍۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ ", "translation": "O you who have believed, when you are told, \"Space yourselves\" in assemblies, then make space; Allāh will make space for you.[1] And when you are told, \"Arise,\"[2] then arise; Allāh will raise those who have believed among you and those who were given knowledge, by degrees. And Allāh is Aware of what you do.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 6, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 7, "arabic": "تَفَسَّحُوا۟", "translit": "۟āwُḥَّsَfَt", "root": "فسح"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْمَجَٰلِسِ", "translit": "ِsِlَٰjgَmْlٱ", "root": "جلس"}, {"id": 10, "arabic": "فَٱفْسَحُوا۟", "translit": "۟āwُḥَsْfٱَf", "root": "فسح"}, {"id": 11, "arabic": "يَفْسَحِ", "translit": "ِḥَsْfَy", "root": "فسح"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 14, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 15, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 16, "arabic": "ٱنشُزُوا۟", "translit": "۟āwُzُhsnٱ", "root": "نشز"}, {"id": 17, "arabic": "فَٱنشُزُوا۟", "translit": "۟āwُzُhsnٱَf", "root": "نشز"}, {"id": 18, "arabic": "يَرْفَعِ", "translit": "ِʿعَfْrَy", "root": "رفع"}, {"id": 19, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 21, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 22, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 23, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 24, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 25, "arabic": "ٱلْعِلْمَ", "translit": "َmْlِʿعْlٱ", "root": "علم"}, {"id": 26, "arabic": "دَرَجَٰتٍ", "translit": "ٍtَٰjgَrَd", "root": "درج"}, {"id": 27, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 28, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 29, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 30, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 12, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا نَٰجَيْتُمُ ٱلرَّسُولَ فَقَدِّمُوا۟ بَيْنَ يَدَىْ نَجْوَىٰكُمْ صَدَقَةًۚ ذَٰلِكَ خَيْرٌ لَّكُمْ وَأَطْهَرُۚ فَإِن لَّمْ تَجِدُوا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "O you who have believed, when you [wish to] privately consult the Messenger, present before your consultation a charity. That is better for you and purer. But if you find not [the means] - then indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "نَٰجَيْتُمُ", "translit": "ُmُtْyَjgَٰn", "root": "نجو"}, {"id": 6, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 7, "arabic": "فَقَدِّمُوا۟", "translit": "۟āwُmِّdَqَf", "root": "قدم"}, {"id": 8, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 9, "arabic": "يَدَىْ", "translit": "ْàَdَy", "root": "يدي"}, {"id": 10, "arabic": "نَجْوَىٰكُمْ", "translit": "ْmُkٰàَwْjgَn", "root": "نجو"}, {"id": 11, "arabic": "صَدَقَةً", "translit": "ًẗَqَdَṣ", "root": "صدق"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 14, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 15, "arabic": "وَأَطْهَرُ", "translit": "ُrَhْṭَaʾَw", "root": "طهر"}, {"id": 16, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 17, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 18, "arabic": "تَجِدُوا۟", "translit": "۟āwُdِjgَt", "root": "وجد"}, {"id": 19, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 22, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 13, "text": "ءَأَشْفَقْتُمْ أَن تُقَدِّمُوا۟ بَيْنَ يَدَىْ نَجْوَىٰكُمْ صَدَقَٰتٍۚ فَإِذْ لَمْ تَفْعَلُوا۟ وَتَابَ ٱللَّهُ عَلَيْكُمْ فَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَطِيعُوا۟ ٱللَّهَ وَرَسُولَهُۥۚ وَٱللَّهُ خَبِيرٌۢ بِمَا تَعْمَلُونَ ", "translation": "Have you feared to present before your consultation charities? Then when you do not and Allāh has forgiven you, then [at least] establish prayer and give zakāh and obey Allāh and His Messenger. And Allāh is Aware of what you do.", "words": [{"id": 1, "arabic": "ءَأَشْفَقْتُمْ", "translit": "ْmُtْqَfْhsَaʾَء", "root": "شفق"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "تُقَدِّمُوا۟", "translit": "۟āwُmِّdَqُt", "root": "قدم"}, {"id": 4, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 5, "arabic": "يَدَىْ", "translit": "ْàَdَy", "root": "يدي"}, {"id": 6, "arabic": "نَجْوَىٰكُمْ", "translit": "ْmُkٰàَwْjgَn", "root": "نجو"}, {"id": 7, "arabic": "صَدَقَٰتٍ", "translit": "ٍtَٰqَdَṣ", "root": "صدق"}, {"id": 8, "arabic": "فَإِذْ", "translit": "ْhdِiʾَf", "root": ""}, {"id": 9, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 10, "arabic": "تَفْعَلُوا۟", "translit": "۟āwُlَʿعْfَt", "root": "فعل"}, {"id": 11, "arabic": "وَتَابَ", "translit": "َbāَtَw", "root": "توب"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 14, "arabic": "فَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَf", "root": "قوم"}, {"id": 15, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 16, "arabic": "وَءَاتُوا۟", "translit": "۟āwُtāَءَw", "root": "اتي"}, {"id": 17, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 18, "arabic": "وَأَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾَw", "root": "طوع"}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 23, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 24, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 14, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ تَوَلَّوْا۟ قَوْمًا غَضِبَ ٱللَّهُ عَلَيْهِم مَّا هُم مِّنكُمْ وَلَا مِنْهُمْ وَيَحْلِفُونَ عَلَى ٱلْكَذِبِ وَهُمْ يَعْلَمُونَ ", "translation": "Have you not considered those who make allies of a people with whom Allāh has become angry? They are neither of you nor of them, and they swear to untruth while they know [they are lying].", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 6, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 7, "arabic": "غَضِبَ", "translit": "َbِḍَغ", "root": "غضب"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 11, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 12, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 15, "arabic": "وَيَحْلِفُونَ", "translit": "َnwُfِlْḥَyَw", "root": "حلف"}, {"id": 16, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 17, "arabic": "ٱلْكَذِبِ", "translit": "ِbِhdَkْlٱ", "root": "كذب"}, {"id": 18, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 19, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 15, "text": "أَعَدَّ ٱللَّهُ لَهُمْ عَذَابًا شَدِيدًاۖ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Allāh has prepared for them a severe punishment. Indeed, it was evil that they were doing.", "words": [{"id": 1, "arabic": "أَعَدَّ", "translit": "َّdَʿعَaʾ", "root": "عدد"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "شَدِيدًا", "translit": "āًdyِdَhs", "root": "شدد"}, {"id": 6, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 7, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 16, "text": "ٱتَّخَذُوٓا۟ أَيْمَٰنَهُمْ جُنَّةً فَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ فَلَهُمْ عَذَابٌ مُّهِينٌ ", "translation": "They took their [false] oaths as a cover, so they averted [people] from the way of Allāh, and for them is a humiliating punishment.", "words": [{"id": 1, "arabic": "ٱتَّخَذُوٓا۟", "translit": "۟āٓwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 2, "arabic": "أَيْمَٰنَهُمْ", "translit": "ْmُhَnَٰmْyَaʾ", "root": "يمن"}, {"id": 3, "arabic": "جُنَّةً", "translit": "ًẗَّnُjg", "root": "جنن"}, {"id": 4, "arabic": "فَصَدُّوا۟", "translit": "۟āwُّdَṣَf", "root": "صدد"}, {"id": 5, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "فَلَهُمْ", "translit": "ْmُhَlَf", "root": ""}, {"id": 9, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 10, "arabic": "مُّهِينٌ", "translit": "ٌnyِhُّm", "root": "هون"}], "hasIhya": false}, {"ayah": 17, "text": "لَّن تُغْنِىَ عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ أَوْلَٰدُهُم مِّنَ ٱللَّهِ شَيْـًٔاۚ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "Never will their wealth or their children avail them against Allāh at all. Those are the companions of the Fire; they will abide therein eternally", "words": [{"id": 1, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 2, "arabic": "تُغْنِىَ", "translit": "َàِnْغُt", "root": "غني"}, {"id": 3, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 4, "arabic": "أَمْوَٰلُهُمْ", "translit": "ْmُhُlَٰwْmَaʾ", "root": "مول"}, {"id": 5, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 6, "arabic": "أَوْلَٰدُهُم", "translit": "mُhُdَٰlْwَaʾ", "root": "ولد"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 10, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 11, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 12, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 13, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 14, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 15, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 18, "text": "يَوْمَ يَبْعَثُهُمُ ٱللَّهُ جَمِيعًا فَيَحْلِفُونَ لَهُۥ كَمَا يَحْلِفُونَ لَكُمْۖ وَيَحْسَبُونَ أَنَّهُمْ عَلَىٰ شَىْءٍۚ أَلَآ إِنَّهُمْ هُمُ ٱلْكَٰذِبُونَ ", "translation": "On the Day Allāh will resurrect them all, and they will swear to Him as they swear to you and think that they are [standing] on something.[1] Unquestionably, it is they who are the liars.", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَبْعَثُهُمُ", "translit": "ُmُhُhtَʿعْbَy", "root": "بعث"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 5, "arabic": "فَيَحْلِفُونَ", "translit": "َnwُfِlْḥَyَf", "root": "حلف"}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 8, "arabic": "يَحْلِفُونَ", "translit": "َnwُfِlْḥَy", "root": "حلف"}, {"id": 9, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 10, "arabic": "وَيَحْسَبُونَ", "translit": "َnwُbَsْḥَyَw", "root": "حسب"}, {"id": 11, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 12, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 13, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 14, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 15, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 16, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 17, "arabic": "ٱلْكَٰذِبُونَ", "translit": "َnwُbِhdَٰkْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 19, "text": "ٱسْتَحْوَذَ عَلَيْهِمُ ٱلشَّيْطَٰنُ فَأَنسَىٰهُمْ ذِكْرَ ٱللَّهِۚ أُو۟لَٰٓئِكَ حِزْبُ ٱلشَّيْطَٰنِۚ أَلَآ إِنَّ حِزْبَ ٱلشَّيْطَٰنِ هُمُ ٱلْخَٰسِرُونَ ", "translation": "Satan has overcome them and made them forget the remembrance of Allāh. Those are the party of Satan. Unquestionably, the party of Satan - they will be the losers.", "words": [{"id": 1, "arabic": "ٱسْتَحْوَذَ", "translit": "َhdَwْḥَtْsٱ", "root": "حوذ"}, {"id": 2, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 4, "arabic": "فَأَنسَىٰهُمْ", "translit": "ْmُhٰàَsnَaʾَf", "root": "نسي"}, {"id": 5, "arabic": "ذِكْرَ", "translit": "َrْkِhd", "root": "ذكر"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 8, "arabic": "حِزْبُ", "translit": "ُbْzِḥ", "root": "حزب"}, {"id": 9, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 10, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "حِزْبَ", "translit": "َbْzِḥ", "root": "حزب"}, {"id": 13, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 14, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 15, "arabic": "ٱلْخَٰسِرُونَ", "translit": "َnwُrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": true}, {"ayah": 20, "text": "إِنَّ ٱلَّذِينَ يُحَآدُّونَ ٱللَّهَ وَرَسُولَهُۥٓ أُو۟لَٰٓئِكَ فِى ٱلْأَذَلِّينَ ", "translation": "Indeed, the ones who oppose Allāh and His Messenger - those will be among the most humbled.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُحَآدُّونَ", "translit": "َnwُّdٓāَḥُy", "root": "حدد"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَرَسُولَهُۥٓ", "translit": "ٓۥُhَlwُsَrَw", "root": "رسل"}, {"id": 6, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَذَلِّينَ", "translit": "َnyِّlَhdَaʾْlٱ", "root": "ذلل"}], "hasIhya": false}, {"ayah": 21, "text": "كَتَبَ ٱللَّهُ لَأَغْلِبَنَّ أَنَا۠ وَرُسُلِىٓۚ إِنَّ ٱللَّهَ قَوِىٌّ عَزِيزٌ ", "translation": "Allāh has written [i.e., decreed], \"I will surely overcome, I and My messengers.\" Indeed, Allāh is Powerful and Exalted in Might.", "words": [{"id": 1, "arabic": "كَتَبَ", "translit": "َbَtَk", "root": "كتب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَأَغْلِبَنَّ", "translit": "َّnَbِlْغَaʾَl", "root": "غلب"}, {"id": 4, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 5, "arabic": "وَرُسُلِىٓ", "translit": "ٓàِlُsُrَw", "root": "رسل"}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "قَوِىٌّ", "translit": "ٌّàِwَq", "root": "قوي"}, {"id": 9, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}], "hasIhya": true}, {"ayah": 22, "text": "لَّا تَجِدُ قَوْمًا يُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ يُوَآدُّونَ مَنْ حَآدَّ ٱللَّهَ وَرَسُولَهُۥ وَلَوْ كَانُوٓا۟ ءَابَآءَهُمْ أَوْ أَبْنَآءَهُمْ أَوْ إِخْوَٰنَهُمْ أَوْ عَشِيرَتَهُمْۚ أُو۟لَٰٓئِكَ كَتَبَ فِى قُلُوبِهِمُ ٱلْإِيمَٰنَ وَأَيَّدَهُم بِرُوحٍ مِّنْهُۖ وَيُدْخِلُهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ رَضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُۚ أُو۟لَٰٓئِكَ حِزْبُ ٱللَّهِۚ أَلَآ إِنَّ حِزْبَ ٱللَّهِ هُمُ ٱلْمُفْلِحُونَ ", "translation": "You will not find a people who believe in Allāh and the Last Day having affection for those who oppose Allāh and His Messenger, even if they were their fathers or their sons or their brothers or their kindred. Those - He has decreed within their hearts faith and supported them with spirit[1] from Him. And We will admit them to gardens beneath which rivers flow, wherein they abide eternally. Allāh is pleased with them, and they are pleased with Him - those are the party of Allāh. Unquestionably, the party of Allāh - they are the successful.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "تَجِدُ", "translit": "ُdِjgَt", "root": "وجد"}, {"id": 3, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 7, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "يُوَآدُّونَ", "translit": "َnwُّdٓāَwُy", "root": "ودد"}, {"id": 9, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 10, "arabic": "حَآدَّ", "translit": "َّdٓāَḥ", "root": "حدد"}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 13, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 14, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 15, "arabic": "ءَابَآءَهُمْ", "translit": "ْmُhَءٓāَbāَء", "root": "ابو"}, {"id": 16, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 17, "arabic": "أَبْنَآءَهُمْ", "translit": "ْmُhَءٓāَnْbَaʾ", "root": "بني"}, {"id": 18, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 19, "arabic": "إِخْوَٰنَهُمْ", "translit": "ْmُhَnَٰwْhkِiʾ", "root": "اخو"}, {"id": 20, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 21, "arabic": "عَشِيرَتَهُمْ", "translit": "ْmُhَtَryِhsَʿع", "root": "عشر"}, {"id": 22, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 23, "arabic": "كَتَبَ", "translit": "َbَtَk", "root": "كتب"}, {"id": 24, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 25, "arabic": "قُلُوبِهِمُ", "translit": "ُmِhِbwُlُq", "root": "قلب"}, {"id": 26, "arabic": "ٱلْإِيمَٰنَ", "translit": "َnَٰmyِiʾْlٱ", "root": "امن"}, {"id": 27, "arabic": "وَأَيَّدَهُم", "translit": "mُhَdَّyَaʾَw", "root": "ايد"}, {"id": 28, "arabic": "بِرُوحٍ", "translit": "ٍḥwُrِb", "root": "روح"}, {"id": 29, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 30, "arabic": "وَيُدْخِلُهُمْ", "translit": "ْmُhُlِhkْdُyَw", "root": "دخل"}, {"id": 31, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 32, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 33, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 34, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 35, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 36, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 37, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 38, "arabic": "رَضِىَ", "translit": "َàِḍَr", "root": "رضو"}, {"id": 39, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 40, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 41, "arabic": "وَرَضُوا۟", "translit": "۟āwُḍَrَw", "root": "رضو"}, {"id": 42, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 43, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 44, "arabic": "حِزْبُ", "translit": "ُbْzِḥ", "root": "حزب"}, {"id": 45, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 46, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 47, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 48, "arabic": "حِزْبَ", "translit": "َbْzِḥ", "root": "حزب"}, {"id": 49, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 50, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 51, "arabic": "ٱلْمُفْلِحُونَ", "translit": "َnwُḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": true}], "tafsir": {"6": [{"arabic": "وقال تعالى يوم يبعثهم الله جميعا فينبئهم بما عملوا أحصاه الله ونسوه والله على كل شىء شهيد وقال تعالى يومئذ يصدر الناس أشتاتا ليروا أعمالهم فمن يعمل مثقال ذرة خيرا يره ومن يعمل مثقال ذرة شرا يره وقال تعالى ثم توفى كل نفس ما كسبت وهم لا يظلمون وقال تعالى يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو أن بينها وبينه أمدا بعيدا ويحذركم الله نفسه وقال تعالى واعلموا أن الله يعلم ما في أنفسكم فاحذروه فعرف أرباب البصائر من جملة العباد أن الله تعالى لهم بالمرصاد وأنهم سيناقشون في الحساب ويطال", "english": "And He, the Exalted, said: 'On the Day when Allah will resurrect them all and inform them of what they did. Allah has recorded it, while they forgot it; and Allah is Witness over all things.' And He, the Exalted, said: 'On that Day, the people will proceed in separate groups to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it.' And He, the Exalted, said: 'Then every soul will be fully compensated for what it earned, and they will not be wronged.' And He, the Exalted, said: 'On the Day when every soul will find what it did of good present [before it] and what it did of evil, it will wish that between itself and that [evil] was a great distance. And Allah warns you of Himself.' And He, the Exalted, said: 'And know that Allah knows what is in your souls (Anfus), so beware of Him.' So the possessors of insight (Arbab al-Basa'ir) from among the servants recognized that Allah, the Exalted, is lying in wait for them and that they will be scrutinized in the account and demanded with the weight of an atom from the passing thoughts (Khatarat) and glances (Lahazat). And they realized that nothing will save them from these dangers except adherence to self-accounting (Muhasaba) and sincerity in self-observation (Muraqaba), and demanding from the Soul (Nafs) in breaths and movements, and accounting it for passing thoughts and glances.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "8": [{"arabic": "وسببه قياس من أقيسة إبليس نعوذ بالله منه، وذلك أنهم ينظرون مرة إلى نعم الله عليهم في الدنيا فيقيسون عليهم نعمة الآخرة، وينظرون مرة إلى تأخير العذاب عنهم فيقيسون عليه عذاب الآخرة كما قال تعالى \"ويقولون في أنفسهم لولا يعذبنا الله بما نقول\" فقال تعالى جواباً لقولهم \"حسبهم جهنم يصلونها فبئس المصير\"", "english": "And its cause is a syllogism from the syllogisms of Iblis (Satan) - we seek refuge in Allah from him - and that is that they look sometimes at Allah's blessings upon them in this world and analogize from them the blessing of the Hereafter, and they look sometimes at the delay of punishment from them and analogize from it the punishment of the Hereafter as Allah the Exalted said: \"And they say within themselves: 'Why does Allah not punish us for what we say?'\" So Allah the Exalted said in response to their saying: \"Sufficient for them is Hell, which they will [enter to] burn, and wretched is the destination.\"", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Condemnation of Delusion'", "badge": "Afterlife"}], "9": [{"arabic": "وقال كعب الأحبار ما في القرآن من يا أيها الذين آمنوا فهو في التوراة يا أيها المساكين", "english": "And Ka'b al-Ahbar said: 'What is in the Quran of \"O you who have believed\" is in the Torah \"O you poor ones (al-Masakin)\".'", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Duties of Brotherhood'", "badge": "General"}], "11": [{"arabic": "اعلم أن ما ذكرناه إن تأملته بعين الاعتبار انفتحت بصيرتك وانكشف لك علل القلوب وأمراضها وأدويتها بنور العلم واليقين، فإن عجزت عن ذلك فلا ينبغي أن يفوتك التصديق والإيمان على سبيل التلقي والتقليد لمن يستحق التقليد، فإن للإيمان درجة كما أن للعلم درجة، والعلم يحصل بعد الإيمان وهو وراءه قال الله تعالى \"يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات\" فمن صدق بأن مخالفة الشهوات هي الطريق إلى الله عز وجل ولم يطلع على سببه وسره فهو من الذين آمنوا، وإذا اطلع على ما ذكرناه من أعوان الشهوات فهو من الذين ", "english": "Know that if you contemplate what we have mentioned with the eye of consideration, your insight (Basarah) will open and the ailments of the Hearts (Qulub) and their diseases and their remedies will be unveiled to you by the light of knowledge and certainty. If you are incapable of that, then it is not fitting for you to miss out on belief and faith by way of reception and imitation of one who deserves imitation, for faith has a degree just as knowledge has a degree, and knowledge is attained after faith and is beyond it. Allah the Exalted said: \"Allah will raise those who have believed among you and those who were given knowledge by degrees.\" So whoever affirms that opposing the desires is the path to Allah, the Mighty and Majestic, and has not become aware of its cause and secret, he is from those who have believed. And if he becomes aware of what we have mentioned regarding the helpers of the desires, he is from those who were given knowledge, and both are promised the best by Allah.", "book_file": "vol3_Vol3-book2a.doc.txt", "book_title": "Breaking the Two Desires", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Breaking the Two Desires'", "badge": "Insight"}, {"arabic": "وقد قال تعالى وأنتم الأعلون إن كنتم مؤمنين تفضيلا للمؤمنين على المسلمين والمراد به المؤمن العارف دون المقلد وقال عز وجل يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات فأراد ههنا بالذين آمنوا الذين صدقوا من غير علم وميزهم عن الذين أوتوا العلم ويدل ذلك على أن اسم المؤمن يقع على المقلد وإن لم يكن تصديقه عن بصيرة وكشف وفسر ابن عباس رضي الله عنهما قوله تعالى والذين أوتوا العلم درجات فقال يرفع الله العالم فوق المؤمن بسبعمائة درجة بين كل درجتين كما بين السماء والأرض", "english": "And Allah the Exalted has said: 'And you are the superior ones if you are believers' (Quran 3:139), as a preference for the believers over the Muslims, and the intended meaning here is the believer who is a knower (al-ʿĀrif) not the imitator (al-Muqallid). And He the Almighty said: 'Allah will raise those who have believed among you and those who were given knowledge by degrees' (Quran 58:11). So He intended here by 'those who have believed' those who affirmed truth without knowledge, and distinguished them from 'those who were given knowledge'. And this indicates that the name 'believer' applies to the imitator even if his affirmation is not based on insight (baṣīrah) and unveiling (kashf). And Ibn ʿAbbās, may Allah be pleased with them both, interpreted His saying the Exalted: 'and those who were given knowledge by degrees', saying: 'Allah raises the knower (al-ʿĀlim) above the believer by seven hundred degrees, between every two degrees is like the distance between the heaven and the earth.'", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "فالمتكفلون بالعلوم كالمتكفلين بالثغور والمرابطين بها والغزاة المجاهدين في سبيل الله فمنهم المقاتل ومنهم الردء ومنهم الذي يسقيهم الماء ومنهم الذي يحفظ دوابهم ويتعهدهم ولا ينفك أحد منهم عن أجر إذا كان قصده إعلاء كلمة الله تعالى دون حيازة الغنائم فكذلك العلماء قال الله تعالى يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات وقال تعالى هم درجات عند الله والفضيلة نسبية واستحقارنا للصيارفة عند قياسهم بالملوك لا يدل على حقارتهم إذا قيسوا بالكناسين فلا تظن أن ما نزل عن الرتبة القصوى ساقط القدر بل الرت", "english": "Those who undertake the sciences are like those who undertake the frontiers and those who garrison them and the warriors who strive (Mujahidun) in the path of Allah. Among them is the fighter, among them is the supporter, among them is the one who gives them water to drink, and among them is the one who guards their mounts and tends to them. Not one of them is deprived of reward if his intention is to exalt the word of Allah the Exalted, without seizing spoils. Likewise are the scholars. Allah the Exalted said: 'Allah will raise those who have believed among you and those who were given knowledge, by degrees.' And He the Exalted said: 'They are degrees with Allah.' And virtue is relative. Our belittling of the money-changers when comparing them to kings does not indicate their lowliness when they are compared to the sweepers. So do not think that what falls below the highest rank is of fallen worth. Rather, the highest rank is for the prophets, then the friends (Awliya'), then the scholars firmly grounded in knowledge, then for the righteous according to the disparity of their degrees. And in summary, whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it. And whoever intends Allah the Exalted with knowledge, whatever knowledge it may be, his benefit and elevation are inevitable.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Book of Knowledge'", "badge": "Ethics"}, {"arabic": "شواهدها من القرآن قوله عز وجل: ﴿شهد الله أنه لا إله إلا هو والملائكة وأولو العلم قائما بالقسط﴾ (آل عمران 3: 18) فانظر كيف بدأ سبحانه وتعالى بنفسه وثنى بالملائكة وثلث بأهل العلم وناهيك بهذا شرفا وفضلا وجلاء ونبلا وقال الله تعالى: ﴿يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات﴾ (المجادلة: 11) قال ابن عباس رضي الله عنهما: للعلماء درجات فوق المؤمنين بسبعمائة درجة ما بين الدرجتين مسيرة خمسمائة عام.", "english": "Its evidences from the Quran are His saying, the Mighty and Majestic: 'Allah bears witness that there is no deity except Him, and [so do] the angels and those of knowledge (أولو العلم), [that He is] maintaining [creation] in justice' (Al Imran 3:18). So observe how He, the Exalted and Most High, began with Himself, then mentioned the angels second, and third with the people of knowledge (أهل العلم) - and what an honor, virtue, clarity, and nobility this is! And Allah, the Exalted, said: 'Allah will raise those who have believed among you and those who were given knowledge (أوتوا العلم) by degrees' (Al-Mujadilah: 11). Ibn Abbas, may Allah be pleased with them both, said: 'For the scholars (العلماء) there are degrees above the believers by seven hundred degrees; between each two degrees is a distance of five hundred years' journey.'", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Book of Knowledge'", "badge": "Du'a"}, {"arabic": "ولكنا نشرح لك إن أردت أن ترتقي من درجة الإيمان إلى درجة العلم قال الله تعالى \"يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات\" فنقول: في الجوع عشر فوائد.", "english": "But we explain to you if you wish to ascend from the level of Faith (Iman) to the level of Knowledge (Ilm), Allah the Exalted said: \"Allah will raise those who have believed among you and those who were given knowledge by degrees.\" So we say: In hunger there are ten benefits.", "book_file": "vol3_Vol3-book3a.doc.txt", "book_title": "Harms of the Tongue", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Harms of the Tongue'", "badge": "General"}], "12": [{"arabic": "وقال كعب الأحبار ما في القرآن من يا أيها الذين آمنوا فهو في التوراة يا أيها المساكين", "english": "And Ka'b al-Ahbar said: Whatever is in the Quran of 'O you who have believed' is in the Torah 'O you poor ones'.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Duties of Brotherhood'", "badge": "General"}], "19": [{"arabic": "والتطارد بين ذكر الله تعالى ووسوسة الشيطان كالتطارد بين النور والظلام وبين الليل والنهار ولتضادهما قال الله تعالى استحوذ عليهم الشيطان فأنساهم ذكر الله وقال أنس قال رسول الله صلى الله عليه وسلم إن الشيطان واضع خرطومه على قلب ابن آدم فإن هو ذكر الله تعالى خنس وإن نسي الله تعالى التقم قلبه", "english": "And the chasing between the Remembrance (Dhikr) of Allah the Exalted and the whispering of the Satan is like the chasing between the light and the darkness and between the night and the day. And due to their opposition, Allah the Exalted said: 'The Satan has gained mastery over them, so he has made them forget the Remembrance (Dhikr) of Allah. Those are the party of the Satan. Unquestionably, indeed the party of the Satan - they will be the losers.' And He said: 'He made them forget.' The Messenger of Allah, peace and blessings be upon him, said: 'Indeed the Satan places his snout upon the heart of the son of Adam. So if he remembers Allah the Exalted, he withdraws; and if he forgets Allah the Exalted, he swallows his heart.'", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}], "21": [{"arabic": "فإن قصده عدو أو سبع في ليل أو نهار فليقرأ آية الكرسي وشهد الله والإخلاص والمعوذتين وليقل بسم الله ما شاء الله لا قوة إلا بالله حسبي الله توكلت على الله ما شاء الله لا يأتي بالخير إلا الله ما شاء الله لا يصرف السوء إلا الله حسبي الله وكفى سمع الله لمن دعا ليس وراء الله منتهى ولا دون الله ملجأ ~ ﴿كتب الله لأغلبن أنا ورسلي إن الله قوي عزيز﴾ ~ تحصنت بالله العظيم واستغثت بالحي الذي لا يموت اللهم احرسنا بعينك التي لا تنام واكنفنا بركنك الذي لا يرام اللهم ارحمنا بقدرتك علينا فلا نهلك وأنت ثقتنا ورجاؤنا", "english": "If an enemy or beast approaches him by night or day, let him recite the Throne Verse (Ayat al-Kursi), 'Allah bears witness...' (Surah al-Ikhlas), and the two Surahs of Refuge (al-Mu'awwidhatayn), and let him say: In the name of Allah, what Allah wills, there is no power except with Allah, Allah is sufficient for me, I have placed my trust in Allah, what Allah wills, none brings good except Allah, what Allah wills, none repels evil except Allah, Allah is sufficient for me and enough, Allah hears whoever calls, there is no limit beyond Allah and no refuge below Allah ~ 'Allah has decreed: \"I will surely prevail, I and My messengers. Indeed, Allah is Powerful, Mighty.\"' ~ I have fortified myself with Allah the Great and sought help from the Living (al-Hayy) who does not die. O Allah, guard us with Your eye that does not sleep and shelter us with Your stronghold that cannot be breached. O Allah, have mercy on us by Your power over us so we do not perish, and You are our trust and hope. O Allah, incline towards us the hearts (Qulub) of Your male servants and female servants with compassion and mercy, indeed You are the Most Merciful of the merciful.", "book_file": "vol1_Vol1-book-7.doc.txt", "book_title": "Mysteries of Hajj", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Hajj'", "badge": "Du'a"}, {"arabic": "فإذا نام واحد حرس آخر حديث تناوب الرفقاء في الحراسة تقدم في الحج في الباب الثاني فهذه السنة ومهما قصده عدو أو سبع في ليل أو نهار فليقرأ آية الكرسي وشهد الله وسور الإخلاص والمعوذتين وليقل بسم الله ما شاء الله لا قوة إلا بالله حسبي الله توكلت على الله ما شاء الله لا يأتي بالخيرات إلا الله ما شاء الله لا يصرف السوء إلا الله حسبي الله وكفى سمع الله لمن دعا ليس وراء الله منتهى ولا دون الله ملجأ كتب الله لأغلبن أنا ورسلي إن الله قوي عزيز تحصنت بالله العظيم واستعنت بالحي القيوم الذي لا يموت اللهم احرسن", "english": "If one sleeps, another guards. The hadith about companions taking turns in guarding has been mentioned previously in Hajj in the second chapter. This is the Sunnah. And whenever an enemy or predator intends him in night or day, let him recite the Throne Verse (Ayat al-Kursi) and 'Allah bears witness' and the chapters of Sincerity (al-Ikhlas) and the two seeking refuge (al-Mu'awwidhatayn), and let him say: In the name of Allah, what Allah wills, there is no power except with Allah, Allah is sufficient for me, I rely upon Allah, what Allah wills, none brings the good things except Allah, what Allah wills, none repels the evil except Allah, Allah is sufficient for me and enough, Allah hears whoever calls, there is no limit beyond Allah, and there is no refuge below Allah. Allah has written: 'I will surely overcome, I and My messengers. Indeed, Allah is Powerful, Mighty.' I have fortified myself with Allah the Great, and I have sought help from the Ever-Living, the Sustainer of existence (al-Qayyum) who does not die. O Allah, guard us with Your eye that does not sleep, and shelter us with Your stronghold that cannot be reached. O Allah, have mercy on us with Your power over us, so do not destroy us while You are our trust and our hope. O Allah, turn towards us the hearts (Qulub) of Your male servants and female servants with compassion and mercy, indeed You are the Most Merciful of the merciful.", "book_file": "vol2_j2-k07.doc.txt", "book_title": "Etiquette of Travel", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Etiquette of Travel'", "badge": "Du'a"}], "22": [{"arabic": "هم أطيب الناس خيراً وألينهم عريكة وأسخاهم نفساً، علامتهم السخاء وسجيتهم البشاشة صفتهم السلامة، ليسوا اليوم في خشية وغداً في غفلة ولكن مدامين على حالهم الظاهر وهم فيما بينهم وبين ربهم لا تدركهم الرياح العواصف ولا الخيل المجراة، قلوبهم تصعد ارتياحاً إلى الله واشتياقاً إليه وقدماً في استباق الخيرات \"أولئك حزب الله ألا إن حزب الله هم المفلحون\" قال الراوي: فقلت: يا أبا الدرداء ما سمعت بصفة أشد علي من تلك الصفة وكيف لي أن أبلغها؟ فقال: ما بينك وبين أن تكون في أوسعها إلا أن تكون تبغض الدنيا، فإنك إذا أ", "english": "They are the best of people in goodness and the softest in disposition and the most generous in soul (Nafs). Their sign is generosity and their nature is cheerfulness and their attribute is safety. They are not today in fear and tomorrow in heedlessness, but they are constant in their apparent state and between them and their Lord, the stormy winds and the galloping horses do not reach them. Their hearts ascend with delight (Irtiyāḥ) to Allah and longing for Him and with precedence in racing to good deeds: \"Those are the party of Allah. Indeed, the party of Allah are the successful ones.\" The narrator said: I said: O Abu Darda, I have not heard of a description more difficult for me than that description, and how can I attain it? He said: Between you and being in its widest expanse is only that you hate the worldly life (Dunyā), for if you hate the worldly life, you turn to the love of the Hereafter (Ākhirah), and according to the measure of your love for the Hereafter, you abstain from the worldly life, and according to that measure, you see what benefits you. And when Allah knows from a servant (ʿAbd) good seeking, He pours upon him correctness and surrounds him with protection. And know, O my nephew, that this is in the Book of Allah, the Revealed: \"Indeed, Allah is with those who fear Him and those who are doers of good.\"", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}, {"arabic": "أما من الآيات فقوله تعالى: \" رضي الله عنهم ورضوا عنه \"، وقد قال تعالى: \" هل جزاء الإحسان إلا الإحسان \" ومنتهى الإحسان رضا الله عن عبده وهو ثواب رضا العبد عن الله تعالى. وقال تعالى: \" ومساكن طيبة في جنات عدن ورضوان من الله أكبر \" فقد رفع الله الرضا فوق جنات عدن كما رفع ذكره الصلاة حيث قال: \" إن الصلاة تنهي عن الفحشاء والمنكر ولذكر الله أكبر \" فكما أن مشاهدة المذكور في الصلاة أكبر من الصلاة فرضوان رب الجنة أعلى من الجنة بل هو غاية مطلب سكان الجنان.", "english": "As for from the verses, His saying, the Exalted: \"Allah is pleased with them and they are pleased with Him\" (Quran 58:22), and He, the Exalted, has said: \"Is the reward for good [anything] but good?\" (Quran 55:60) and the ultimate good is Allah's pleasure (Rida) with His servant, and it is the reward for the servant's pleasure (Rida) with Allah, the Exalted. And He, the Exalted, said: \"And pleasant dwellings in gardens of perpetual residence; but approval from Allah is greater\" (Quran 9:72). Indeed, Allah has elevated pleasure (Rida) above the gardens of Eden, just as He elevated the mention (Dhikr) of prayer when He said: \"Indeed, prayer prohibits immorality and wrongdoing, and the remembrance (Dhikr) of Allah is greater\" (Quran 29:45). So just as witnessing the Remembered One (Al-Madhkur) in prayer is greater than the prayer, the pleasure (Ridwan) of the Lord of the Garden is higher than the Garden; rather, it is the ultimate goal of the inhabitants of the Gardens.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "وأما الانبساط معه والاسترسال إليه كما يسترسل إلى الأصدقاء فهو مكروه كراهة شديدة يكاد ينتهي ما يقوى منها إلى حد التحريم قال تعالى لا تجد قوما يؤمنون بالله واليوم الآخر يوادون من حاد الله ورسوله ولو كانوا آباءهم أو أبناءهم الآية وقال صلى الله عليه وسلم المسلم والمشرك لا تتراءى ناراهما حديث المؤمن والمشرك لا تتراءى ناراهما رواه أبو داود والترمذي من حديث جرير أنا بريء من كل مسلم يقيم بين أظهر المشركين قالوا يا رسول الله ولم قال لا تراءى ناراهما رواه النسائي مرسلا وقال البخاري الصحيح أنه مرسل وقال عز", "english": "And as for being open with him and relaxing with him as one relaxes with friends, it is disliked with a strong dislike that almost reaches the limit of prohibition. Allah the Exalted said: 'You will not find a people who believe in Allah and the Last Day loving those who oppose Allah and His Messenger, even if they were their fathers or their sons...' the verse. And the Prophet (peace be upon him) said: 'The Muslim and the polytheist - their fires should not be visible to each other' - the hadith: 'The believer and the polytheist - their fires should not be visible to each other' - narrated by Abu Dawud and al-Tirmidhi from the narration of Jarir: 'I am free from every Muslim who resides among the polytheists.' They said: 'O Messenger of Allah, why?' He said: 'Their fires should not be visible to each other' - narrated by al-Nasa'i as mursal, and al-Bukhari said the correct is that it is mursal. And the Mighty and Majestic said: 'O you who have believed, do not take My enemies and your enemies as allies...' the verse.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Duties of Brotherhood'", "badge": "Hadith"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 961], [2, 961, 1717], [3, 1717, 2621], [4, 2621, 3468], [5, 3468, 4510], [6, 4510, 5792], [7, 5792, 6364], [8, 6364, 7738], [9, 7738, 9936], [10, 9936, 10783], [11, 10783, 11687], [12, 11687, 12935], [13, 12935, 14034], [14, 14034, 16864], [15, 16864, 17700], [16, 17700, 18604], [17, 18604, 19703], [18, 19703, 20804]], "2": [[1, 400, 1999], [2, 1999, 4258], [3, 4258, 5390], [4, 5390, 6366], [5, 6366, 9454], [6, 9454, 10600], [7, 10600, 11548], [8, 11548, 13809], [9, 13809, 14432], [10, 14432, 16693], [11, 16693, 17981], [12, 17981, 19863], [13, 19863, 21745], [14, 21745, 23740], [15, 23740, 26202], [16, 26202, 27787], [17, 27787, 28763], [18, 28763, 30178], [19, 30178, 32046], [20, 32046, 33504], [21, 33504, 34622], [22, 34622, 36271], [23, 36271, 37575]], "3": [[1, 400, 2216], [2, 2216, 4243], [3, 4243, 4751], [4, 4751, 7522], [5, 7522, 8424], [6, 8424, 10380], [7, 10380, 11294], [8, 11294, 13047], [9, 13047, 14724], [10, 14724, 15740], [11, 15740, 16616], [12, 16616, 17492], [13, 17492, 18051], [14, 18051, 20892], [15, 20892, 22101], [16, 22101, 24006], [17, 24006, 24489], [18, 24489, 25873], [19, 25873, 26787], [20, 26787, 28489], [21, 28489, 29660]], "4": [[1, 400, 1168], [2, 1168, 1872], [3, 1872, 2832], [4, 2832, 4470], [5, 4470, 5903], [6, 5903, 8283], [7, 8283, 8795], [8, 8795, 9678], [9, 9678, 10241], [10, 10241, 13103], [11, 13103, 13871], [12, 13871, 14575], [13, 14575, 16136], [14, 16136, 1808