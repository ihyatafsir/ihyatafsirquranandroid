ْهَرُۚ فَإِن لَّمْ تَجِدُوا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ","translation":"O you who have believed, when you [wish to] privately consult the Messenger, present before your consultation a charity. That is better for you and purer. But if you find not [the means] - then indeed, Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":4,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":5,"arabic":"نَٰجَيْتُمُ","translit":"ُmُtْyَjgَٰn","root":"نجو"},{"id":6,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":7,"arabic":"فَقَدِّمُوا۟","translit":"۟āwُmِّdَqَf","root":"قدم"},{"id":8,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":9,"arabic":"يَدَىْ","translit":"ْàَdَy","root":"يدي"},{"id":10,"arabic":"نَجْوَىٰكُمْ","translit":"ْmُkٰàَwْjgَn","root":"نجو"},{"id":11,"arabic":"صَدَقَةً","translit":"ًẗَqَdَṣ","root":"صدق"},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":14,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":15,"arabic":"وَأَطْهَرُ","translit":"ُrَhْṭَaʾَw","root":"طهر"},{"id":16,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":17,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":18,"arabic":"تَجِدُوا۟","translit":"۟āwُdِjgَt","root":"وجد"},{"id":19,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":20,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":21,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":22,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":13,"text":"ءَأَشْفَقْتُمْ أَن تُقَدِّمُوا۟ بَيْنَ يَدَىْ نَجْوَىٰكُمْ صَدَقَٰتٍۚ فَإِذْ لَمْ تَفْعَلُوا۟ وَتَابَ ٱللَّهُ عَلَيْكُمْ فَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَأَطِيعُوا۟ ٱللَّهَ وَرَسُولَهُۥۚ وَٱللَّهُ خَبِيرٌۢ بِمَا تَعْمَلُونَ ","translation":"Have you feared to present before your consultation charities? Then when you do not and Allāh has forgiven you, then [at least] establish prayer and give zakāh and obey Allāh and His Messenger. And Allāh is Aware of what you do.","words":[{"id":1,"arabic":"ءَأَشْفَقْتُمْ","translit":"ْmُtْqَfْhsَaʾَء","root":"شفق"},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"تُقَدِّمُوا۟","translit":"۟āwُmِّdَqُt","root":"قدم"},{"id":4,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":5,"arabic":"يَدَىْ","translit":"ْàَdَy","root":"يدي"},{"id":6,"arabic":"نَجْوَىٰكُمْ","translit":"ْmُkٰàَwْjgَn","root":"نجو"},{"id":7,"arabic":"صَدَقَٰتٍ","translit":"ٍtَٰqَdَṣ","root":"صدق"},{"id":8,"arabic":"فَإِذْ","translit":"ْhdِiʾَf","root":""},{"id":9,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":10,"arabic":"تَفْعَلُوا۟","translit":"۟āwُlَʿعْfَt","root":"فعل"},{"id":11,"arabic":"وَتَابَ","translit":"َbāَtَw","root":"توب"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":14,"arabic":"فَأَقِيمُوا۟","translit":"۟āwُmyِqَaʾَf","root":"قوم"},{"id":15,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":16,"arabic":"وَءَاتُوا۟","translit":"۟āwُtāَءَw","root":"اتي"},{"id":17,"arabic":"ٱلزَّكَوٰةَ","translit":"َẗٰwَkَّzlٱ","root":"زكو"},{"id":18,"arabic":"وَأَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾَw","root":"طوع"},{"id":19,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":20,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":21,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":22,"arabic":"خَبِيرٌۢ","translit":"ٌۢryِbَhk","root":"خبر"},{"id":23,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":24,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":false},{"ayah":14,"text":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ تَوَلَّوْا۟ قَوْمًا غَضِبَ ٱللَّهُ عَلَيْهِم مَّا هُم مِّنكُمْ وَلَا مِنْهُمْ وَيَحْلِفُونَ عَلَى ٱلْكَذِبِ وَهُمْ يَعْلَمُونَ ","translation":"Have you not considered those who make allies of a people with whom Allāh has become angry? They are neither of you nor of them, and they swear to untruth while they know [they are lying].","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"تَوَلَّوْا۟","translit":"۟āْwَّlَwَt","root":"ولي"},{"id":6,"arabic":"قَوْمًا","translit":"āًmْwَq","root":"قوم"},{"id":7,"arabic":"غَضِبَ","translit":"َbِḍَغ","root":"غضب"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":10,"arabic":"مَّا","translit":"āَّm","root":""},{"id":11,"arabic":"هُم","translit":"mُh","root":""},{"id":12,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":13,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":14,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":15,"arabic":"وَيَحْلِفُونَ","translit":"َnwُfِlْḥَyَw","root":"حلف"},{"id":16,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":17,"arabic":"ٱلْكَذِبِ","translit":"ِbِhdَkْlٱ","root":"كذب"},{"id":18,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":19,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":15,"text":"أَعَدَّ ٱللَّهُ لَهُمْ عَذَابًا شَدِيدًاۖ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ ","translation":"Allāh has prepared for them a severe punishment. Indeed, it was evil that they were doing.","words":[{"id":1,"arabic":"أَعَدَّ","translit":"َّdَʿعَaʾ","root":"عدد"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":4,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":5,"arabic":"شَدِيدًا","translit":"āًdyِdَhs","root":"شدد"},{"id":6,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":7,"arabic":"سَآءَ","translit":"َءٓāَs","root":"سوا"},{"id":8,"arabic":"مَا","translit":"āَm","root":""},{"id":9,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":10,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":16,"text":"ٱتَّخَذُوٓا۟ أَيْمَٰنَهُمْ جُنَّةً فَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ فَلَهُمْ عَذَابٌ مُّهِينٌ ","translation":"They took their [false] oaths as a cover, so they averted [people] from the way of Allāh, and for them is a humiliating punishment.","words":[{"id":1,"arabic":"ٱتَّخَذُوٓا۟","translit":"۟āٓwُhdَhkَّtٱ","root":"اخذ"},{"id":2,"arabic":"أَيْمَٰنَهُمْ","translit":"ْmُhَnَٰmْyَaʾ","root":"يمن"},{"id":3,"arabic":"جُنَّةً","translit":"ًẗَّnُjg","root":"جنن"},{"id":4,"arabic":"فَصَدُّوا۟","translit":"۟āwُّdَṣَf","root":"صدد"},{"id":5,"arabic":"عَن","translit":"nَʿع","root":""},{"id":6,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"فَلَهُمْ","translit":"ْmُhَlَf","root":""},{"id":9,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":10,"arabic":"مُّهِينٌ","translit":"ٌnyِhُّm","root":"هون"}],"hasIhya":false},{"ayah":17,"text":"لَّن تُغْنِىَ عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ أَوْلَٰدُهُم مِّنَ ٱللَّهِ شَيْـًٔاۚ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِۖ هُمْ فِيهَا خَٰلِدُونَ ","translation":"Never will their wealth or their children avail them against Allāh at all. Those are the companions of the Fire; they will abide therein eternally","words":[{"id":1,"arabic":"لَّن","translit":"nَّl","root":""},{"id":2,"arabic":"تُغْنِىَ","translit":"َàِnْغُt","root":"غني"},{"id":3,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":4,"arabic":"أَمْوَٰلُهُمْ","translit":"ْmُhُlَٰwْmَaʾ","root":"مول"},{"id":5,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":6,"arabic":"أَوْلَٰدُهُم","translit":"mُhُdَٰlْwَaʾ","root":"ولد"},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":10,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":11,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":12,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":13,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":14,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":15,"arabic":"خَٰلِدُونَ","translit":"َnwُdِlَٰhk","root":"خلد"}],"hasIhya":false},{"ayah":18,"text":"يَوْمَ يَبْعَثُهُمُ ٱللَّهُ جَمِيعًا فَيَحْلِفُونَ لَهُۥ كَمَا يَحْلِفُونَ لَكُمْۖ وَيَحْسَبُونَ أَنَّهُمْ عَلَىٰ شَىْءٍۚ أَلَآ إِنَّهُمْ هُمُ ٱلْكَٰذِبُونَ ","translation":"On the Day Allāh will resurrect them all, and they will swear to Him as they swear to you and think that they are [standing] on something.[1] Unquestionably, it is they who are the liars.","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"يَبْعَثُهُمُ","translit":"ُmُhُhtَʿعْbَy","root":"بعث"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":5,"arabic":"فَيَحْلِفُونَ","translit":"َnwُfِlْḥَyَf","root":"حلف"},{"id":6,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":7,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":8,"arabic":"يَحْلِفُونَ","translit":"َnwُfِlْḥَy","root":"حلف"},{"id":9,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":10,"arabic":"وَيَحْسَبُونَ","translit":"َnwُbَsْḥَyَw","root":"حسب"},{"id":11,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":12,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":13,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":14,"arabic":"أَلَآ","translit":"ٓāَlَaʾ","root":""},{"id":15,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":16,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":17,"arabic":"ٱلْكَٰذِبُونَ","translit":"َnwُbِhdَٰkْlٱ","root":"كذب"}],"hasIhya":false},{"ayah":19,"text":"ٱسْتَحْوَذَ عَلَيْهِمُ ٱلشَّيْطَٰنُ فَأَنسَىٰهُمْ ذِكْرَ ٱللَّهِۚ أُو۟لَٰٓئِكَ حِزْبُ ٱلشَّيْطَٰنِۚ أَلَآ إِنَّ حِزْبَ ٱلشَّيْطَٰنِ هُمُ ٱلْخَٰسِرُونَ ","translation":"Satan has overcome them and made them forget the remembrance of Allāh. Those are the party of Satan. Unquestionably, the party of Satan - they will be the losers.","words":[{"id":1,"arabic":"ٱسْتَحْوَذَ","translit":"َhdَwْḥَtْsٱ","root":"حوذ"},{"id":2,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":3,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":4,"arabic":"فَأَنسَىٰهُمْ","translit":"ْmُhٰàَsnَaʾَf","root":"نسي"},{"id":5,"arabic":"ذِكْرَ","translit":"َrْkِhd","root":"ذكر"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":8,"arabic":"حِزْبُ","translit":"ُbْzِḥ","root":"حزب"},{"id":9,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":10,"arabic":"أَلَآ","translit":"ٓāَlَaʾ","root":""},{"id":11,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":12,"arabic":"حِزْبَ","translit":"َbْzِḥ","root":"حزب"},{"id":13,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":14,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":15,"arabic":"ٱلْخَٰسِرُونَ","translit":"َnwُrِsَٰhkْlٱ","root":"خسر"}],"hasIhya":true},{"ayah":20,"text":"إِنَّ ٱلَّذِينَ يُحَآدُّونَ ٱللَّهَ وَرَسُولَهُۥٓ أُو۟لَٰٓئِكَ فِى ٱلْأَذَلِّينَ ","translation":"Indeed, the ones who oppose Allāh and His Messenger - those will be among the most humbled.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يُحَآدُّونَ","translit":"َnwُّdٓāَḥُy","root":"حدد"},{"id":4,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":5,"arabic":"وَرَسُولَهُۥٓ","translit":"ٓۥُhَlwُsَrَw","root":"رسل"},{"id":6,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَذَلِّينَ","translit":"َnyِّlَhdَaʾْlٱ","root":"ذلل"}],"hasIhya":false},{"ayah":21,"text":"كَتَبَ ٱللَّهُ لَأَغْلِبَنَّ أَنَا۠ وَرُسُلِىٓۚ إِنَّ ٱللَّهَ قَوِىٌّ عَزِيزٌ ","translation":"Allāh has written [i.e., decreed], \"I will surely overcome, I and My messengers.\" Indeed, Allāh is Powerful and Exalted in Might.","words":[{"id":1,"arabic":"كَتَبَ","translit":"َbَtَk","root":"كتب"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"لَأَغْلِبَنَّ","translit":"َّnَbِlْغَaʾَl","root":"غلب"},{"id":4,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":5,"arabic":"وَرُسُلِىٓ","translit":"ٓàِlُsُrَw","root":"رسل"},{"id":6,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":7,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":8,"arabic":"قَوِىٌّ","translit":"ٌّàِwَq","root":"قوي"},{"id":9,"arabic":"عَزِيزٌ","translit":"ٌzyِzَʿع","root":"عزز"}],"hasIhya":true},{"ayah":22,"text":"لَّا تَجِدُ قَوْمًا يُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ يُوَآدُّونَ مَنْ حَآدَّ ٱللَّهَ وَرَسُولَهُۥ وَلَوْ كَانُوٓا۟ ءَابَآءَهُمْ أَوْ أَبْنَآءَهُمْ أَوْ إِخْوَٰنَهُمْ أَوْ عَشِيرَتَهُمْۚ أُو۟لَٰٓئِكَ كَتَبَ فِى قُلُوبِهِمُ ٱلْإِيمَٰنَ وَأَيَّدَهُم بِرُوحٍ مِّنْهُۖ وَيُدْخِلُهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ رَضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُۚ أُو۟لَٰٓئِكَ حِزْبُ ٱللَّهِۚ أَلَآ إِنَّ حِزْبَ ٱللَّهِ هُمُ ٱلْمُفْلِحُونَ ","translation":"You will not find a people who believe in Allāh and the Last Day having affection for those who oppose Allāh and His Messenger, even if they were their fathers or their sons or their brothers or their kindred. Those - He has decreed within their hearts faith and supported them with spirit[1] from Him. And We will admit them to gardens beneath which rivers flow, wherein they abide eternally. Allāh is pleased with them, and they are pleased with Him - those are the party of Allāh. Unquestionably, the party of Allāh - they are the successful.","words":[{"id":1,"arabic":"لَّا","translit":"āَّl","root":""},{"id":2,"arabic":"تَجِدُ","translit":"ُdِjgَt","root":"وجد"},{"id":3,"arabic":"قَوْمًا","translit":"āًmْwَq","root":"قوم"},{"id":4,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":5,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":6,"arabic":"وَٱلْيَوْمِ","translit":"ِmْwَyْlٱَw","root":"يوم"},{"id":7,"arabic":"ٱلْءَاخِرِ","translit":"ِrِhkāَءْlٱ","root":"اخر"},{"id":8,"arabic":"يُوَآدُّونَ","translit":"َnwُّdٓāَwُy","root":"ودد"},{"id":9,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":10,"arabic":"حَآدَّ","translit":"َّdٓāَḥ","root":"حدد"},{"id":11,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":12,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":13,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":14,"arabic":"كَانُوٓا۟","translit":"۟āٓwُnāَk","root":"كون"},{"id":15,"arabic":"ءَابَآءَهُمْ","translit":"ْmُhَءٓāَbāَء","root":"ابو"},{"id":16,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":17,"arabic":"أَبْنَآءَهُمْ","translit":"ْmُhَءٓāَnْbَaʾ","root":"بني"},{"id":18,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":19,"arabic":"إِخْوَٰنَهُمْ","translit":"ْmُhَnَٰwْhkِiʾ","root":"اخو"},{"id":20,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":21,"arabic":"عَشِيرَتَهُمْ","translit":"ْmُhَtَryِhsَʿع","root":"عشر"},{"id":22,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":23,"arabic":"كَتَبَ","translit":"َbَtَk","root":"كتب"},{"id":24,"arabic":"فِى","translit":"àِf","root":""},{"id":25,"arabic":"قُلُوبِهِمُ","translit":"ُmِhِbwُlُq","root":"قلب"},{"id":26,"arabic":"ٱلْإِيمَٰنَ","translit":"َnَٰmyِiʾْlٱ","root":"امن"},{"id":27,"arabic":"وَأَيَّدَهُم","translit":"mُhَdَّyَaʾَw","root":"ايد"},{"id":28,"arabic":"بِرُوحٍ","translit":"ٍḥwُrِb","root":"روح"},{"id":29,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":30,"arabic":"وَيُدْخِلُهُمْ","translit":"ْmُhُlِhkْdُyَw","root":"دخل"},{"id":31,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":32,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":33,"arabic":"مِن","translit":"nِm","root":""},{"id":34,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":35,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":36,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":37,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":38,"arabic":"رَضِىَ","translit":"َàِḍَr","root":"رضو"},{"id":39,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":40,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":41,"arabic":"وَرَضُوا۟","translit":"۟āwُḍَrَw","root":"رضو"},{"id":42,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":43,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":44,"arabic":"حِزْبُ","translit":"ُbْzِḥ","root":"حزب"},{"id":45,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":46,"arabic":"أَلَآ","translit":"ٓāَlَaʾ","root":""},{"id":47,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":48,"arabic":"حِزْبَ","translit":"َbْzِḥ","root":"حزب"},{"id":49,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":50,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":51,"arabic":"ٱلْمُفْلِحُونَ","translit":"َnwُḥِlْfُmْlٱ","root":"فلح"}],"hasIhya":true}],"tafsir":{"6":[{"arabic":"يظلم ربك أحدا} وقال تعالى {يوم يبعثهم الله جميعا فينبئهم بما عملوا أحصاه الله ونسوه والله على كل شيء شهيد} وقال تعالى {يومئذ يصدر الناس أشتاتا ليروا أعمالهم فمن يعمل مثقال ذرة خيرا يره ومن يعمل مثقال ذرة شرا يره} وقال تعالى {ثم توفى كل نفس ما كسبت وهم لا يظلمون} وقال تعالى {يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو أن بينها وبينه أمدا بعيدا ويحذركم الله نفسه} وقال تعالى {واعلموا أن الله يعلم ما في أنفسكم فاحذروه} فعرف أرباب البصائر من جملة العباد أن الله تعالى لهم بالمرصاد وأنهم سيناقشون في الحساب ويطالبون بمثاقيل الذر م","english":"To proceed: God Most High has said: {And We shall set up the scales of justice for the Day of Resurrection, so no soul shall be wronged in anything; and if it be the weight of a grain of mustard seed, We shall bring it forth, and sufficient are We as Reckoners} (21:47). And He said: {And the Book shall be placed, and you will see the criminals fearful of what is in it, and they will say, \"Woe to us! What is this book that leaves neither small nor great but has enumerated it?\" And they will find what they did present, and your Lord wrongs no one} (18:49). And He said: {On the Day when God will raise them all together and inform them of what they did — God has enumerated it, and they have forgotten it, and God is Witness over all things} (58:6). And He said: {On that Day, people will issue forth in scattered groups to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it} (99:6-8). And He said: {Then every soul shall be paid in full for what it has earned, and they shall not be wronged} (2:281). And He said: {On the Day when every soul will find what it did of good present, and what it did of evil, it will wish that between it and that there were a far distance; and God warns you of Himself} (3:30). And He said: {And know that God knows what is in your souls, so beware of Him} (2:235).","book_title":"Monitoring and Accounting","section_title_ar":"Section 1230","section_title_en":"Exposition of the Reality of Truthfulness (Al-Sidq), Its Meaning, and Its Grades — Book of Vigilance and Self-Reckoning, Being the Eighth Book of the Quarter of Deliverance from the Revival of the Religious Sciences","section_index":1230,"anchors":"- Root: رقب (Raqaba)\n  * Lisan / Ayn: To watch, guard, observe; a watcher (raqīb) is one who stands vigilant over something, awaiting its occurrence.\n  * Al-Raghib (Mufradat): Raqaba denotes protective watchfulness; al-raqīb is a divine attribute signifying His perpetual oversight of all that transpires, with no moment of neglect.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical watching/awaiting. Metaphorical (majāz): \"This matter is upon your necks (fī riqābikum)\" — i.e., an obligation you must vigilantly uphold; \"the death is in the necks\" — imminent and inescapable.\n- Root: حسب (Hasaba)\n  * Lisan / Ayn: To count, reckon, compute; al-ḥisāb is the act of enumeration and settlement of accounts.\n  * Al-Raghib (Mufradat): Al-ḥisāb is the employment of number; divine reckoning (ḥisāb) on the Day of Resurrection is the exacting appraisal of deeds, even to the atom's weight.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"they reckon news (yaḥtasibūna al-akhbār)\" — they investigate and ascertain, as one places knowledge in place of conjecture.\n- Root: قلب (Qalaba)\n  * Lisan / Ayn: To turn, overturn, transform; the heart (qalb) is so named for its constant fluctuation and turning of states.\n  * Al-Raghib (Mufradat): Qalaba is the turning of a thing from one state to another; the heart's inner thoughts (khaṭarāt) are its successive movements, which God surveys.\n  * Al-Zamakhshari (Asas): Literal: turning a garment or object. Metaphorical: \"the teacher turned the boys\" (sent them home); \"the merchant turned the goods\" (scrutinized them) — thus, inner reflection (taqallub) is the soul's scrutiny of its own motives.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"إنما يحاسبهم لتعلم كل نفس\" — the sole purpose of reckoning is specified, excluding all other ends.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'","badge":"Afterlife"}],"8":[{"arabic":"بالله كما قال تعالى ويقولون في أنفسهم لولا يعذبنا الله بما نقول حسبهم جهنم يصلونها فبئس المصير ومنها أن يأتي الذنب ويظهره بأن يذكره بعد إتيانه أو يأتيه في مشهد غيره فإن ذلك جناية منه على ستر الله الذي سدله عليه وتحريك لرغبة الشر فيمن أسمعه ذنبه أو أشهده فعله فهما جنايتان انضمتا إلى جنايته فغلظت به فإن انضاف إلى ذلك الترغيب للغير فيه والحمل عليه وتهيئة الأسباب له صارت جناية رابعه وتفاحش الأمر وفي الخبر كل الناس معافى إلا المجاهرين يبيت أحدهم على ذنب قد ستره الله عليه فيصبح فيكشف ستر الله ويتحدث بذنبه (1) وهذا لأن","english":"Know that the minor sin (al-ṣaghīrah) is magnified by several causes. Among them is persistence (al-iṣrār) and continuous adherence (al-muwāẓabah). For this reason it was said: \"No sin remains minor with persistence, and no sin remains major with seeking forgiveness.\" For a single major sin that comes to an end and is not followed by another like it—if such a thing could be conceived—forgiveness for it would be more hopeful than for a minor sin upon which the servant persistently continues. The example of this is drops of water falling upon a stone in succession: they effect an impression upon it, whereas that same quantity of water, if poured upon it all at once, would have no effect. For this reason the Messenger of Allah, may Allah bless him and grant him peace, said: \"The best of deeds are the most constant of them, even if few.\" {«خير الأعمال أدومها وإن قل»} And things are made distinct by their opposites. For even though the beneficial among deeds is the constant one, even if little, yet the abundant that is cut short is of little benefit in illuminating the heart and purifying it. Likewise, the little among evil deeds, when it persists, its effect in darkening the heart becomes immense—except that a major sin is rarely conceived as being rushed upon suddenly without prior antecedents. Even if it were exempted from the class of minor sins, the fornicator rarely fornicates suddenly without prior solicitation and preliminaries, and the murderer rarely kills suddenly without a preceding rancor and enmity. Thus every major sin is encompassed by minor sins preceding and following it. But were a major sin conceived entirely alone, suddenly, with no recurrence attending it, perhaps forgiveness in its case would be more hopeful than in the case of a minor sin upon which a man persists his entire lifetime.","book_title":"Condemnation of Delusion","section_title_ar":"Section 932","section_title_en":"On the Causes by Which Minor Sins Are Magnified","section_index":932,"anchors":"- Root: صغر (ṣ-gh-r)\n  * Lisan / Ayn: Smallness in magnitude, quantity, or station; the state of being lesser in measure or rank.\n  * Al-Raghib (Mufradat): Smallness and greatness are relative correlatives (mutadāyifān)—a thing is small only in relation to another thing deemed great; applied to bodies, quantities, and moral weight.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical diminutiveness; metaphorical (majāz) for moral degradation and abasement (ṣaghār) before God's majesty.\n- Root: كبر (k-b-r)\n  * Lisan / Ayn: Greatness in size, age, or dignity; also grievousness and gravity of a matter.\n  * Al-Raghib (Mufradat): Bigness as a relative term—what is great in one respect may be small in another; in moral theology, magnitude of sin is measured against the majesty of the One disobeyed.\n  * Al-Zamakhshari (Asas): Literal for physical magnitude; metaphorical for what weighs heavily upon the heart and is grievous to bear.\n- Root: ذنب (dh-n-b)\n  * Lisan / Ayn: The tail of an animal; by extension, what follows behind, the rear, the last part.\n  * Al-Raghib (Mufradat): \"The sin (al-dhanb) in its origin is the taking hold of a thing by its tail (akhdh bi-dhanab al-shay')\"—i.e., pursuing a consequence; used metaphorically for a fault that trails after the soul and seizes it from behind.\n  * Al-Zamakhshari (Asas): Literal for the tail of a beast; metaphorical (majāz) for sin as that which follows a person and clings to him—\"he is among the tails (adhānāb) of the people,\" i.e., the followers.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification)—the particle \"إنما\" confines predication to a single subject, as in \"لا صغيرة مع إصرار\" where the negation plus exception structure (lā + istithnā' implied) restricts absoluteness of the judgment.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'","badge":"Insight"}],"9":[{"arabic":"وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال","english":"The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.","book_title":"Duties of Brotherhood","section_title_ar":"Section 175","section_title_en":"The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)","section_index":175,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'","badge":"Insight"}],"11":[{"arabic":"وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال","english":"The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.","book_title":"Duties of Brotherhood","section_title_ar":"Section 175","section_title_en":"The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)","section_index":175,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'","badge":"Insight"},{"arabic":"شرفا وفضلا وجلاء ونبلا وقال الله تعالى {يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات} قال ابن عباس رضي الله عنهما للعلماء درجات فوق المؤمنين بسبعمائة درجة ما بين الدرجتين مسيرة خمسمائة عام وقال عز وجل {قل هل يستوي الذين يعلمون والذين لا يعلمون} وقال تعالى {إنما يخشى الله من عباده العلماء} وقال تعالى {قل كفى بالله شهيدا بيني وبينكم ومن عنده علم الكتاب} وقال تعالى {قال الذي عنده علم من الكتاب أنا آتيك به} تنبيها على أنه اقتدر بقوة العلم وقال عز وجل {وقال الذين أوتوا العلم ويلكم ثواب الله خير لمن آمن وعمل صالحا} بين أن عظم قدر الآخرة","english":"How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.","book_title":"Foundations of Belief","section_title_ar":"Section 4","section_title_en":"The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars","section_index":4,"anchors":"- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"},{"arabic":"والذين أوتوا العلم درجات} قال ابن عباس رضي الله عنهما للعلماء درجات فوق المؤمنين بسبعمائة درجة ما بين الدرجتين مسيرة خمسمائة عام وقال عز وجل {قل هل يستوي الذين يعلمون والذين لا يعلمون} وقال تعالى {إنما يخشى الله من عباده العلماء} وقال تعالى {قل كفى بالله شهيدا بيني وبينكم ومن عنده علم الكتاب} وقال تعالى {قال الذي عنده علم من الكتاب أنا آتيك به} تنبيها على أنه اقتدر بقوة العلم وقال عز وجل {وقال الذين أوتوا العلم ويلكم ثواب الله خير لمن آمن وعمل صالحا} بين أن عظم قدر الآخرة","english":"How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.","book_title":"Disciplining the Soul","section_title_ar":"Section 4","section_title_en":"The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars","section_index":4,"anchors":"- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Disciplining the Soul'","badge":"Afterlife"}],"12":[{"arabic":"وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال","english":"The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.","book_title":"Duties of Brotherhood","section_title_ar":"Section 175","section_title_en":"The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)","section_index":175,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'","badge":"Insight"}],"21":[{"arabic":"الله منتهى ولا دون الله ملجأ كتب الله لأغلبن أنا ورسلي إن الله قوي عزيز تحصنت بالله العظيم واستغثت بالحي الذي لا يموت اللهم احرسنا بعينك التي لا تنام واكنفنا بركنك الذي لا يرام اللهم ارحمنا بقدرتك علينا فلا نهلك وأنت ثقتنا ورجاؤنا اللهم أعطف علينا قلوب عبادك وإمائك برأفة ورحمة إنك أنت أرحم الراحمين الثامنة مهما علا نشزا من الأرض في الطريق فيستحب أن يكبر ثلاثا ثم يقول اللهم لك الشرف على كل شرف ولك الحمد على كل حال ومهما هبط سبح ومهما خاف الوحشة في سفره قال سبحان الله الملك القدوس رب الملائكة والروح جللت السموات بالعزة و","english":"He ought to seek out a righteous companion, one who loves goodness and assists in it: if he forgets, the companion reminds him; if he remembers, the companion aids him; if he fears, the companion emboldens him; if he weakens, the companion strengthens him; if his breast narrows, the companion enlarges his patience. He should bid farewell to his resident companions, his brothers, and his neighbors — taking leave of them and seeking their supplications, for God Most High places goodness in their prayers. The Sunnah of farewell is to say: «أستودع الله دينك وأمانتك وخواتيم عملك» — \"I entrust to God your religion, your trustworthiness, and the seal of your deeds.\" And he, peace and blessings be upon him, used to say to one intending travel: \"In God's protection and His care — may God provide you with piety, forgive your sin, and direct you toward goodness wherever you may be.\"","book_title":"Mysteries of Hajj","section_title_ar":"Section 199","section_title_en":"The Book of the Etiquette of Travel — Section 199: On the Comprehensive Etiquette of the Journey (From Provisioning to Guarding)","section_index":199,"anchors":"- Root: س ف ر (S-F-R)\n  * Lisan / Ayn: \"السفر: كشف الغطاء\" — unveiling, uncovering; the traveler is one who uncovers the veils of distant lands.\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء، ويختص ذلك بالأعيان\" — the journey is a literal uncovering of horizons, yet the spiritual journey unveils the soul's veils.\n  * Al-Zamakhshari (Asas): Haqiqah: \"سافر سفرا بعيدا\" (to travel far); Majaz: \"وجه مسفر: مشرق سرورا\" — a face radiant with joy, as the traveler's face brightens with divine trust.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the supplications' structural pauses.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Hajj'","badge":"Du'a"}],"22":[{"arabic":"وقال عز وجل {رضي الله عنهم ورضوا عنه ذلك لمن خشي ربه} وكل ما دل على فضيلة العلم دل على فضيلة الخوف لأن الخوف ثمرة العلم ولذلك جاء في خبر موسى عليه أفضل الصلاة والسلام وأما الخائفون","english":"As for the path of derivation (iqtibās) from the verses and reports, what has been transmitted concerning the virtue of fear is beyond enumeration. And sufficient as an indication of its virtue is that God—may He be exalted—has gathered together for the fearful (khāʾifūn) guidance (hudā), mercy (raḥmah), knowledge (ʿilm), and good pleasure (riḍwān)—and these are the sum total of the stations of the people of Paradise. God—may He be exalted—said: {وهدى ورحمة للذين هم لربهم يرهبون} \"And guidance and mercy for those who of their Lord are fearful\" [Al-Aʿrāf: 154]. And He—exalted is He—said: {إنما يخشى الله من عباده العلماء} \"Only those of His servants who possess knowledge fear God\" [Fāṭir: 28]—describing them with knowledge on account of their fear [of Him].","book_title":"Love, Longing, Intimacy and Contentment","section_title_ar":"Section 1041","section_title_en":"Exposition of the Virtue of Fear (Khawf) and Encouragement Thereof","section_index":1041,"anchors":"- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being overtaken by dread of a feared outcome.\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — the anticipation of something detestable based on a probable or certain indication; it is the direct opposite of amn (security) and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — fearing for something. Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as fear consumes the soul piecemeal.\n- Root: فضل (Fadl)\n  * Lisan / Ayn: Excess, superiority, or merit beyond the baseline of sufficiency.\n  * Al-Raghib (Mufradat): \"الفضل: الزيادة عن الاقتصاد\" — increase beyond moderation; the praiseworthy type is like the surplus of knowledge and forbearance, and it is measured by its end (ghāyah).\n  * Al-Zamakhshari (Asas): Literal: \"مال فلان فاضل: كثير يفضل عن القوت\" — surplus wealth exceeding necessity. The virtue of a thing is gauged by its instrumental efficacy toward a noble goal.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Certain cognition and apprehension of a thing as it truly is.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing's reality; it is the root from which khawf branches as its fruit.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to have cognizance. The scholars (ʿulamāʾ) are so named for their knowledge, which necessarily engenders fear of God.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد) — governing the exclusive attribution in {إنما يخشى الله من عباده العلماء}, where the predicate restricts fear to the knowledgeable, and the syntactic fronting of \"whom they fear\" (لربهم يرهبون) emphasizes the object of reverential dread.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'","badge":"Afterlife"},{"arabic":"منها إلى حد التحريم قال تعالى {لا تجد قوما يؤمنون بالله واليوم الآخر يوادون من حاد الله ورسوله ولو كانوا آباءهم أو أبناءهم} الآية وقال صلى الله عليه وسلم المسلم والمشرك لا تتراءى ناراهما (1) وقال عز وجل {يا أيها الذين آمنوا لا تتخذوا عدوي وعدوكم أولياء} الآية الثاني المبتدع الذي يدعو إلى بدعته فإن كانت البدعة بحيث يكفر بها فأمره أشد من الذمي لأنه لا يقر بجزية ولا يسامح بعقد ذمة وإن كان ممن لا يكفر به فأمره بينه وبين الله أخف من أمر الكافر لا محالة ولكن الأمر في الإنكار عليه أشد منه على الكافر لأن شر الكافر غير متعد فإن المسلمين اعتقدوا كفره فلا يلتفتون إلى قوله إذ ل","english":"If you say: \"The manifestation of hatred and enmity by deed, even if not obligatory, is undoubtedly commendable (mandūb); yet the disobedient and the flagrant sinners are of varying ranks — so how is excellence attained by dealing with them, and is a single course pursued with all of them or not?\" — Know that the one who opposes the command of God, may He be exalted, is either one who opposes in his creed (ʿaqd) or in his deed (ʿamal). The one who opposes in creed is either an innovator (mubtadiʿ) or a disbeliever (kāfir). The innovator is either one who calls to his innovation (dāʿī) or one who remains silent — and the silent one is either so by incapacity or by choice. The divisions of corruption in belief are thus three:","book_title":"Duties of Brotherhood","section_title_ar":"Section 412","section_title_en":"Exposition of the Ranks of Those Who Are Hated for God's Sake and the Manner of Dealing with Them","section_index":412,"anchors":"- Root: ب غ ض (b-gh-d)\n  * Lisan / Ayn: Core meaning of hatred and aversion, the opposite of love (al-ḥubb); al-baghḍāʾ is intense hatred.\n  * Al-Raghib (Mufradat): Theological nuance — hatred for God's sake (al-bughḍ fī Allāh) is a spiritual act of the heart (laṭīfah rabbāniyyah) distinguishing sincere faith from hypocrisy.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — aversion of the heart; metaphorical (majāz) — manifesting aversion through outward acts of avoidance and censure.\n- Root: ع ص و (ʿ-ṣ-w)\n  * Lisan / Ayn: ʿiṣyān — disobedience and rebellion against a command; the ʿāṣī is one who transgresses the bound.\n  * Al-Raghib (Mufradat): Theological nuance — fisq (flagrant sin) is the departure from the straight path (khurūj ʿan al-ṭarīqah al-mustaqīmah) through willful transgression.\n  * Al-Zamakhshari (Asas): Literal — breaking a command; metaphorical — persistence in sin without repentance.\n- Root: ب د ع (b-d-ʿ)\n  * Lisan / Ayn: bidʿah — an innovation, a newly invented matter in religion without precedent.\n  * Al-Raghib (Mufradat): Theological nuance — al-ibdāʿ is creation without model; for God it is bringing into being without instrument, matter, time, or place. For man, bidʿah is introducing into religion what is not from it.\n  * Al-Zamakhshari (Asas): Literal — inventing something new; metaphorical — a weak argument (abdaʿat ḥujjatuka) or failing expectation.\n- Root: ك ف ر (k-f-r)\n  * Lisan / Ayn: kufr — covering, concealing; the night is called kāfir for covering persons; the farmer (kāfir) covers the seed.\n  * Al-Raghib (Mufradat): Theological nuance — kufr is disbelief, the covering of truth; the kāfir is one who veils the truth of God's unity.\n  * Al-Zamakhshari (Asas): Literal — covering (satar); metaphorical — ingratitude and rejection of divine blessings.\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: qalb — the heart; taqallub — turning and changing from one state to another.\n  * Al-Raghib (Mufradat): Theological nuance — the heart's fluctuation (taqallub al-qulūb) between states of faith and heedlessness; the hearts of the common folk are quick to turn.\n  * Al-Zamakhshari (Asas): Literal — turning a thing over; metaphorical — the instability of opinion and disposition.\n- Sibawayh Rule: Rule of Conditional Partitioning (Taqsīm al-Sharṭ) — the division of a genus into exhaustive species governed by conditional clauses (in kāna... fa-), each branch receiving its own ruling without conflation.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'","badge":"Insight"},{"arabic":"إلى الله واشتياقا إليه وقدما في استباق الخيرات أولئك حزب الله ألا إن حزب الله هم المفلحون قال الراوي فقلت يا أبا الدرداء ما سمعت بصفة أشد علي من تلك الصفة وكيف لي أن أبلغها فقال ما بينك وبين أن تكون في أوسعها إلا أن تكون تبغض الدنيا فإنك إذا بغضت الدنيا أقبلت على حب الآخرة وبقدر حبك للآخرة تزهد في الدنيا وبقدر ذلك تبصر ما ينفعك وإذا علم الله من عبد حسن الطلب أفرغ عليه السداد واكتنفه بالعصمة واعلم يا ابن أخي أن ذلك في كتاب الله تعالى المنزل إن الله مع الذين اتقوا والذين هم محسنون قال يحيى بن كثير فنظرنا","english":"Among these manifestations is pride in loving that people stand up for him, or rise before him. ʿAlī — may God honor his face — said: \"Whoever wishes to look upon a man of the Fire, let him look at a man seated while people stand before him.\"","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 862","section_title_en":"The Book of Pride and Self-Conceit — Section 862: Manifestations of Pride (Takabbur) in Bearing, Speech, and Conduct, and the Prophetic Model of Humility (Tawāḍuʿ)","section_index":862,"anchors":"- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core meaning of greatness, magnitude, and elevation in rank or stature; takabbur (تَكَبُّر) is the assumption of greatness over others, the comportment of one who deems himself above his fellow creatures.\n  * Al-Raghib (Mufradat): Al-istikbār is the soul's refusal of truth out of disdain for its bearer, and its haughty rejection of what is right; it is the root of every blameworthy trait, for Iblis's fall was his refusal to prostrate out of pride.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical height and elevation. Metaphorical (majāz): the heart's self-elevation above others, manifesting in bodily postures — the \"ṣaʿar\" (turning the cheek away) being its visible sign.\n- Root: وضع (w-ḍ-ʿ)\n  * Lisan / Ayn: To place down low, to lower, to set something down; tawāḍuʿ (تَوَاضُع) is the lowering of oneself, the opposite of elevation and haughtiness.\n  * Al-Raghib (Mufradat): Al-tawāḍuʿ is humility before God and His creatures — the soul's recognition of its true station and its refusal to claim what it does not deserve; it is the root of every praiseworthy trait.\n  * Al-Zamakhshari (Asas): Literal: physical lowering. Metaphorical: the soul's self-abasement in conduct — sitting where one is bid, serving oneself, and accepting invitation from the poor.\n- Root: شمل (sh-m-l)\n  * Lisan / Ayn: To encompass, to include all parts; shamāʾil (شَمَائِل) are the innate dispositions and outward traits that encompass a man's character.\n  * Al-Raghib (Mufradat): The outward marks and habitual bearing through which inner moral states become visible to observers.\n  * Al-Zamakhshari (Asas): Used here in its literal sense of comprehensive outward features — the face, gait, voice, and gestures that betray the inner state.\n- Root: بذذ (b-dh-dh)\n  * Lisan / Ayn: Al-badhādha (البَذَاذَة) is the roughness and plainness of dress and appearance, the state of one who does not adorn himself.\n  * Al-Raghib (Mufradat): In the prophetic tradition {البَذَاذَةُ مِنَ الإِيمَانِ}, it signifies the believer's indifference to worldly finery — a mean and unadorned appearance that reflects the heart's detachment.\n  * Al-Zamakhshari (Asas): Literal: shabbiness of garment. Metaphorical: the soul's refusal to seek honor through dress, distinguishing genuine humility from affected squalor.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — governing the author's use of \"إنما\" and restrictive clauses to delimit the precise scope of pride's manifestations and humility's counter-examples, ensuring each trait is specified without overgeneralization.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'","badge":"Ethics"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,961],[2,961,1717],[3,1717,2621],[4,2621,3468],[5,3468,4510],[6,4510,5792],[7,5792,6364],[8,6364,7738],[9,7738,9936],[10,9936,10783],[11,10783,11687],[12,11687,12935],[13,12935,14034],[14,14034,16864],[15,16864,17700],[16,17700,18604],[17,18604,19703],[18,19703,20804]],"2":[[1,400,1999],[2,1999,4258],[3,4258,5390],[4,5390,6366],[5,6366,9454],[6,9454,10600],[7,10600,11548],[8,11548,13809],[9,13809,14432],[10,14432,16693],[11,16693,17981],[12,17981,19863],[13,19863,21745],[14,21745,23740],[15,23740,26202],[16,26202,27787],[17,27787,28763],[18,28763,30178],[19,30178,32046],[20,32046,33504],[21,33504,34622],[22,34622,36271],[23,36271,37575]],"3":[[1,400,2216],[2,2216,4243],[3,4243,4751],[4,4751,7522],[5,7522,8424],[6,8424,10380],[7,10380,11294],[8,11294,13047],[9,13047,14724],[10,14724,15740],[11,15740,16616],[12,16616,17492],[13,17492,18051],[14,18051,20892],[15,20892,22101],[16,22101,24006],[17,24006,24489],[18,24489,25873],[19,25873,26787],[20,26787,28489],[21,28489,29660]],"4":[[1,400,1168],[2,1168,1872],[3,1872,2832],[4,2832,4470],[5,4470,5903],[6,5903,8283],[7,8283,8795],[8,8795,9678],[9,9678,10241],[10,10241,13103],[11,13103,13871],[12,13871,14575],[13,14575,16136],[14,16136,18087],[15,18087,19456],[16,19456,21299],[17,21299,22261],[18,22261,24411],[19,24411,25678],[20,25678,27469],