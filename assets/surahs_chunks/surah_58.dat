": 19, "text": "اَ۪سْتَحْوَذَ عَلَيْهِمُ اُ۬لشَّيْطَٰنُ فَأَنس۪يٰهُمْ ذِكْرَ اَ۬للَّهِۖ أُوْلَٰٓئِكَ حِزْبُ اُ۬لشَّيْطَٰنِۖ أَلَآ إِنَّ حِزْبَ اَ۬لشَّيْطَٰنِ هُمُ اُ۬لْخَٰسِرُونَۖ", "words": [{"id": 1, "arabic": "اَ۪سْتَحْوَذَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لشَّيْطَٰنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأَنس۪يٰهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذِكْرَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "حِزْبُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لشَّيْطَٰنِۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَلَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "حِزْبَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لشَّيْطَٰنِ", "translit": "", "root": ""}, {"id": 14, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 15, "arabic": "اُ۬لْخَٰسِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 58, "ayah": 20, "text": "إِنَّ اَ۬لذِينَ يُحَآدُّونَ اَ۬للَّهَ وَرَسُولَهُۥٓ أُوْلَٰٓئِكَ فِے اِ۬لَاذَلِّينَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُحَآدُّونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَرَسُولَهُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لَاذَلِّينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 58, "ayah": 21, "text": "كَتَبَ اَ۬للَّهُ لَأَغْلِبَنَّ أَنَا وَرُسُلِيَۖ إِنَّ اَ۬للَّهَ قَوِيٌّ عَزِيزࣱۖ", "words": [{"id": 1, "arabic": "كَتَبَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَأَغْلِبَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "وَرُسُلِيَۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَوِيٌّ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَزِيزࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 58, "ayah": 22, "text": "لَّا تَجِدُ قَوْماࣰ يُومِنُونَ بِاللَّهِ وَالْيَوْمِ اِ۬لَاخِرِ يُوَآدُّونَ مَنْ حَآدَّ اَ۬للَّهَ وَرَسُولَهُۥ وَلَوْ كَانُوٓاْ ءَابَآءَهُمُۥٓ أَوَ اَبْنَآءَهُمُۥٓ أَوِ اِخْوَٰنَهُمُۥٓ أَوْ عَشِيرَتَهُمُۥٓۖ أُوْلَٰٓئِكَ كَتَبَ فِے قُلُوبِهِمُ اُ۬لِايمَٰنَ وَأَيَّدَهُم بِرُوحࣲ مِّنْهُ وَيُدْخِلُهُمْ جَنَّٰتࣲ تَجْرِے مِن تَحْتِهَا اَ۬لَانْهَٰرُ خَٰلِدِينَ فِيهَاۖ رَضِيَ اَ۬للَّهُ عَنْهُمْ وَرَضُواْ عَنْهُۖ أُوْلَٰٓئِكَ حِزْبُ اُ۬للَّهِۖ أَلَآ إِنَّ حِزْبَ اَ۬للَّهِ هُمُ اُ۬لْمُفْلِحُونَۖ", "words": [{"id": 1, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَجِدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُومِنُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالْيَوْمِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَاخِرِ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُوَآدُّونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 10, "arabic": "حَآدَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَرَسُولَهُۥ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 14, "arabic": "كَانُوٓاْ", "translit": "", "root": ""}, {"id": 15, "arabic": "ءَابَآءَه