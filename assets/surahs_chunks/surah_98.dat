{"surah": 98, "verses": [{"ayah": 1, "text": "لَمْ يَكُنِ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ وَٱلْمُشْرِكِينَ مُنفَكِّينَ حَتَّىٰ تَأْتِيَهُمُ ٱلْبَيِّنَةُ ", "translation": "Those who disbelieved among the People of the Scripture and the polytheists were not to be parted [from misbelief][1] until there came to them clear evidence –", "words": [{"id": 1, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 2, "arabic": "يَكُنِ", "translit": "ِnُkَy", "root": "كون"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 7, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 8, "arabic": "وَٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱَw", "root": "شرك"}, {"id": 9, "arabic": "مُنفَكِّينَ", "translit": "َnyِّkَfnُm", "root": "فكك"}, {"id": 10, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 11, "arabic": "تَأْتِيَهُمُ", "translit": "ُmُhَyِtْaʾَt", "root": "اتي"}, {"id": 12, "arabic": "ٱلْبَيِّنَةُ", "translit": "ُẗَnِّyَbْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 2, "text": "رَسُولٌ مِّنَ ٱللَّهِ يَتْلُوا۟ صُحُفًا مُّطَهَّرَةً ", "translation": "A Messenger from Allāh, reciting purified[1] scriptures", "words": [{"id": 1, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 2, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "يَتْلُوا۟", "translit": "۟āwُlْtَy", "root": "تلو"}, {"id": 5, "arabic": "صُحُفًا", "translit": "āًfُḥُṣ", "root": "صحف"}, {"id": 6, "arabic": "مُّطَهَّرَةً", "translit": "ًẗَrَّhَṭُّm", "root": "طهر"}], "hasIhya": false}, {"ayah": 3, "text": "فِيهَا كُتُبٌ قَيِّمَةٌ ", "translation": "Within which are correct writings [i.e., rulings and laws].", "words": [{"id": 1, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 2, "arabic": "كُتُبٌ", "translit": "ٌbُtُk", "root": "كتب"}, {"id": 3, "arabic": "قَيِّمَةٌ", "translit": "ٌẗَmِّyَq", "root": "قوم"}], "hasIhya": false}, {"ayah": 4, "text": "وَمَا تَفَرَّقَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَةُ ", "translation": "Nor did those who were given the Scripture become divided[1] until after there had come to them clear evidence.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تَفَرَّقَ", "translit": "َqَّrَfَt", "root": "فرق"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 5, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 8, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "جَآءَتْهُمُ", "translit": "ُmُhْtَءٓāَjg", "root": "جيا"}, {"id": 11, "arabic": "ٱلْبَيِّنَةُ", "translit": "ُẗَnِّyَbْlٱ", "root": "بين"}], "hasIhya": true}, {"ayah": 5, "text": "وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ حُنَفَآءَ وَيُقِيمُوا۟ ٱلصَّلَوٰةَ وَيُؤْتُوا۟ ٱلزَّكَوٰةَۚ وَذَٰلِكَ دِينُ ٱلْقَيِّمَةِ ", "translation": "And they were not commanded except to worship Allāh, [being] sincere to Him in religion, inclining to truth, and to establish prayer and to give zakāh. And that is the correct religion.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أُمِرُوٓا۟", "translit": "۟āٓwُrِmُaʾ", "root": "امر"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "لِيَعْبُدُوا۟", "translit": "۟āwُdُbْʿعَyِl", "root": "عبد"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "مُخْلِصِينَ", "translit": "َnyِṣِlْhkُm", "root": "خلص"}, {"id": 7, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 8, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 9, "arabic": "حُنَفَآءَ", "translit": "َءٓāَfَnُḥ", "root": "حنف"}, {"id": 10, "arabic": "وَيُقِيمُوا۟", "translit": "۟āwُmyِqُyَw", "root": "قوم"}, {"id": 11, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 12, "arabic": "وَيُؤْتُوا۟", "translit": "۟āwُtْwʾُyَw", "root": "اتي"}, {"id": 13, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 14, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 15, "arabic": "دِينُ", "translit": "ُnyِd", "root": "دين"}, {"id": 16, "arabic": "ٱلْقَيِّمَةِ", "translit": "ِẗَmِّyَqْlٱ", "root": "قوم"}], "hasIhya": true}, {"ayah": 6, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ وَٱلْمُشْرِكِينَ فِى نَارِ جَهَنَّمَ خَٰلِدِينَ فِيهَآۚ أُو۟لَٰٓئِكَ هُمْ شَرُّ ٱلْبَرِيَّةِ ", "translation": "Indeed, they who disbelieved among the People of the Scripture and the polytheists will be in the fire of Hell, abiding eternally therein. Those are the worst of creatures.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 6, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 7, "arabic": "وَٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱَw", "root": "شرك"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "نَارِ", "translit": "ِrāَn", "root": "نور"}, {"id": 10, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 11, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 12, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 13, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 14, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 15, "arabic": "شَرُّ", "translit": "ُّrَhs", "root": "شرر"}, {"id": 16, "arabic": "ٱلْبَرِيَّةِ", "translit": "ِẗَّyِrَbْlٱ", "root": "برا"}], "hasIhya": false}, {"ayah": 7, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ أُو۟لَٰٓئِكَ هُمْ خَيْرُ ٱلْبَرِيَّةِ ", "translation": "Indeed, they who have believed and done righteous deeds - those are the best of creatures.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 8, "arabic": "خَيْرُ", "translit": "ُrْyَhk", "root": "خير"}, {"id": 9, "arabic": "ٱلْبَرِيَّةِ", "translit": "ِẗَّyِrَbْlٱ", "root": "برا"}], "hasIhya": false}, {"ayah": 8, "text": "جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًاۖ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُۚ ذَٰلِكَ لِمَنْ خَشِىَ رَبَّهُۥ ", "translation": "Their reward with their Lord will be gardens of perpetual residence beneath which rivers flow, wherein they will abide forever, Allāh being pleased with them and they with Him. That is for whoever has feared his Lord.", "words": [{"id": 1, "arabic": "جَزَآؤُهُمْ", "translit": "ْmُhُwʾٓāَzَjg", "root": "جزي"}, {"id": 2, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 3, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 4, "arabic": "جَنَّٰتُ", "translit": "ُtَّٰnَjg", "root": "جنن"}, {"id": 5, "arabic": "عَدْنٍ", "translit": "ٍnْdَʿع", "root": ""}, {"id": 6, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 9, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 10, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 11, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 12, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 13, "arabic": "رَّضِىَ", "translit": "َàِḍَّr", "root": "رضو"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 16, "arabic": "وَرَضُوا۟", "translit": "۟āwُḍَrَw", "root": "رضو"}, {"id": 17, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 18, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 19, "arabic": "لِمَنْ", "translit": "ْnَmِl", "root": ""}, {"id": 20, "arabic": "خَشِىَ", "translit": "َàِhsَhk", "root": "خشي"}, {"id": 21, "arabic": "رَبَّهُۥ", "translit": "ۥُhَّbَr", "root": "ربب"}], "hasIhya": true}], "tafsir": {"4": [{"arabic": "وهو أحد والآصال التي ذكرها الله تعالى إذ قال ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال وإذا سجد لله عز وجل الجمادات فكيف يجوز أن يغفل العبد العاقل عن أنواع العبادات الورد السادس إذا دخل وقت العصر دخل وقت الورد السادس وهو الذي أقسم الله تعالى به فقال تعالى {والعصر} هذا أحد معنيي الآية وهو المراد بالآصال في أحد التفسيرين وهو العشي المذكور في قوله {وعشيا} وفي قوله {بالعشي والإشراق} وليس في هذا الورد صلاة إلا أربع ركعات بين الأذان والإقامة كما سبق في الظهر ثم يصلي الفرض ويشتغل بالأقسام الأربعة المذكورة", "english": "I say: And just as knowledge and remembrance are the nourishment of the heart, which can never be cut off from it, so too the measure of moderation is this; and deficiency from it may lead to the disturbance of the body — except for one who accustoms himself to wakefulness gradually, for he may train himself upon it without disturbance. And this litany (wird) is among the longest of the litanies and the most delightful for the worshippers, and it is one of the \"evenings and mornings\" (al-āṣāl) which God Most High mentioned when He said: {«ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال»} \"And to God prostrates whoever is in the heavens and the earth, willingly or unwillingly, and their shadows, in the mornings and the evenings\" (Q. 13:15). And when inanimate objects prostrate to God, Mighty and Majestic, how then can the intelligent servant be heedless of the varieties of worship?", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 261", "section_title_en": "The Seventh Daily Litany (Al-Wird al-Sābiʿ): The Time of Sunset — The Completion of the Day's Litanies and Self-Accounting", "section_index": 261, "anchors": "- Root: ورد (warada)\n  * Lisan / Ayn: The root denotes arriving at water, seeking it, and drinking from it; also the portion or share of water allotted for drinking at a specific time.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — the core meaning is the intentional approach to water; the litany (wird) is the appointed portion of devotional recitation, likened to the daily share of water that a person must take to sustain life.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the act of arriving at water. Metaphorical (Majaz): \"ورد علي كتاب سرني مورده\" — a book arrived upon me whose arrival pleased me; likewise, the wird is the arrival of the appointed time for worship, and the soul's approach to the fountain of divine remembrance.\n- Root: عصر (ʿaṣr)\n  * Lisan / Ayn: The root denotes pressing, squeezing, and extracting; also the time of afternoon, so called because it is the pressing of the day's end.\n  * Al-Raghib (Mufradat): The ʿaṣr is the latter part of the day; God swore by it in {«والعصر»} (Q. 103:1), indicating its great merit.\n  * Al-Zamakhshari (Asas): Literal: the afternoon time. Metaphorical: the pressing of one's life — as the day is pressed at its end, so the life of man is pressed at its term.\n- Root: غرب (gharaba)\n  * Lisan / Ayn: The root denotes disappearance, absence, and setting; the sun's setting (ghurūb) is its concealment from the eye.\n  * Al-Raghib (Mufradat): The setting of the sun marks the boundary between the day's works and the night's; it is the terminus of the visible world's diurnal cycle.\n  * Al-Zamakhshari (Asas): Literal: the sun's descent below the horizon. Metaphorical: the setting of the sun of life — the death of man, after which there is no rising.\n- Root: حاسب (ḥāsaba)\n  * Lisan / Ayn: The root denotes reckoning, counting, and taking account; muḥāsabah is the mutual reckoning between two parties.\n  * Al-Raghib (Mufradat): Self-accounting (muḥāsabat al-nafs) is the soul's reckoning with itself over its deeds before the Day of Reckoning, for \"one who reckons himself before he is reckoned\" is among the wise.\n  * Al-Zamakhshari (Asas): Literal: the arithmetic counting of sums. Metaphorical: the soul's audit of its own works, weighing the day's deeds against the standard of the Sacred Law.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governing verb, as in the construction \"فسبحان الله حين تمسون\" where the adverbial clause is interposed to emphasize the temporal specification of the act of glorification.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Remembrance of Death and Afterlife'", "badge": "Dhikr"}], "5": [{"arabic": "الله عليه وسلم إنما الأعمال بالنيات وإنما لكل امرىء ما نوى // وقال تعالى وما أمروا إلا ليعبدوا الله مخلصين له الدين ولهذا قدم الله تعالى الصبر على العمل فقال تعالى إلا الذين صبروا وعملوا الصالحات الحالة الثانية حالة العمل كي لا يغفل عن الله في أثناء عمله ولا يتكاسل عن تحقيق آدابه وسننه ويدوم على شرط الأدب إلى آخر العمل الأخير فيلازم الصبر عن دواعي الفتور إلى الفراغ وهذا أيضا من شدائد الصبر ولعله المراد بقوله تعالى نعم أجر العاملين الذين صبروا أي صبروا إلى تمام العمل الحالة الثالثة بعد الفراغ من العمل إذ يحتاج إلى الصبر عن إفشائه والتظاهر به للسمعة والرياء و", "english": "The first kind is obedience. The servant stands in need of patience in performing it, for patience in obedience is severe. This is because the soul (al-nafs) is by its very nature (bi-ṭabʿihā) averse to servitude (al-ʿubūdiyyah) and covets lordship (al-rubūbiyyah). For this reason, one of the knowers of God (al-ʿārifīn) said: \"There is no soul but that it conceals within itself what Pharaoh displayed when he said, 'I am your lord most high' {أنا ربكم الأعلى} — but Pharaoh found for it a scope and an acceptance, so he manifested it when he vilified his people and they obeyed him. And there is no one but that he claims this [very thing] with respect to his slave, his servant, his followers, and every one who is under his subjugation and obedience — even if he refrains from manifesting it. For his fury and rage at their shortcomings in serving him, and his enslaving them [in that rage], issues only from an inner concealment of pride (al-kibr) and a contesting of lordship (munāzaʿat al-rubūbiyyah) within the mantle of majesty (ridāʾ al-kibriyāʾ).\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 964", "section_title_en": "On Patience in Obedience and Abstinence from Disobedience — The Two Categories of Volitional Acts", "section_index": 964, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and retention under constraint; al-Farahidi notes its application to holding back.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — restraint within hardship; the soul's confinement to what reason and Law require, or its abstention from what they require it to abstain from. It is a generic term whose specific names vary by context: in tribulation it is patience (ṣabr) against despair (jazaʿ); in battle it is courage (shajāʿah) against cowardice.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره\" (I bore patiently what I dislike) and \"صبرت عما أحب\" (I held back from what I love). Metaphorical (majāz): \"صبرت يمينه\" (I bound him by a stringent oath) — extended to any firm constraining.\n- Root: ع م ل (ʿ-m-l)\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد\" — every purposeful act of a living being; more specific than mere \"act\" (fiʿl), and applies to both righteous and wicked deeds.\n- Root: ن ف س (n-f-s)\n  * Al-Raghib (Mufradat): The soul (nafs) as the seat of volition and desire; its innate inclination (ṭabʿ) is central to Ghazali's argument here.\n  * Al-Zamakhshari (Asas): Literal: \"نفس\" as the self; metaphorical: \"دفق نفسه\" (he poured out his blood/life).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with innamā) — governing the Prophet's dictum «إنما الأعمال بالنيات» where the predicate is restricted exclusively to intention.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "8": [{"arabic": "وقال عز وجل {رضي الله عنهم ورضوا عنه ذلك لمن خشي ربه} وكل ما دل على فضيلة العلم دل على فضيلة الخوف لأن الخوف ثمرة العلم ولذلك جاء في خبر موسى عليه أفضل الصلاة والسلام وأما الخائفون", "english": "As for the path of derivation (iqtibās) from the verses and reports, what has been transmitted concerning the virtue of fear is beyond enumeration. And sufficient as an indication of its virtue is that God—may He be exalted—has gathered together for the fearful (khāʾifūn) guidance (hudā), mercy (raḥmah), knowledge (ʿilm), and good pleasure (riḍwān)—and these are the sum total of the stations of the people of Paradise. God—may He be exalted—said: {وهدى ورحمة للذين هم لربهم يرهبون} \"And guidance and mercy for those who of their Lord are fearful\" [Al-Aʿrāf: 154]. And He—exalted is He—said: {إنما يخشى الله من عباده العلماء} \"Only those of His servants who possess knowledge fear God\" [Fāṭir: 28]—describing them with knowledge on account of their fear [of Him].", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1041", "section_title_en": "Exposition of the Virtue of Fear (Khawf) and Encouragement Thereof", "section_index": 1041, "anchors": "- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being overtaken by dread of a feared outcome.\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — the anticipation of something detestable based on a probable or certain indication; it is the direct opposite of amn (security) and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — fearing for something. Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as fear consumes the soul piecemeal.\n- Root: فضل (Fadl)\n  * Lisan / Ayn: Excess, superiority, or merit beyond the baseline of sufficiency.\n  * Al-Raghib (Mufradat): \"الفضل: الزيادة عن الاقتصاد\" — increase beyond moderation; the praiseworthy type is like the surplus of knowledge and forbearance, and it is measured by its end (ghāyah).\n  * Al-Zamakhshari (Asas): Literal: \"مال فلان فاضل: كثير يفضل عن القوت\" — surplus wealth exceeding necessity. The virtue of a thing is gauged by its instrumental efficacy toward a noble goal.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Certain cognition and apprehension of a thing as it truly is.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing's reality; it is the root from which khawf branches as its fruit.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to have cognizance. The scholars (ʿulamāʾ) are so named for their knowledge, which necessarily engenders fear of God.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد) — governing the exclusive attribution in {إنما يخشى الله من عباده العلماء}, where the predicate restricts fear to the knowledgeable, and the syntactic fronting of \"whom they fear\" (لربهم يرهبون) emphasizes the object of reverential dread.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'", "badge": "Afterlife"}, {"arabic": "آلاف درهم لا أفعل ذلك أبدا رضي الله عنه", "english": "The Messiah, peace be upon him, said: \"With difficulty shall the rich man enter Paradise.\"", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1071", "section_title_en": "The Virtue of Poverty and the Condemnation of Wealth — Section 1071", "section_index": 1071, "anchors": "- Root: دخل (dakhala)\n  * Lisan / Ayn: Core meaning of entering, penetrating, or intruding into a space or state.\n  * Al-Raghib (Mufradat): Often used for entering into a condition or abode, including the afterlife states of Paradise and Hell.\n  * Al-Zamakhshari (Asas): Literal for physical entry; metaphorical for entering into a spiritual state or reckoning.\n- Root: فقر (faqara)\n  * Lisan / Ayn: To hollow out, pierce, or be in a state of neediness; the poor one is \"hollowed\" of worldly goods.\n  * Al-Raghib (Mufradat): Denotes the state of one lacking sufficient means; in the Kalam context, it signifies a spiritual station of utter dependence upon God, not merely material lack.\n  * Al-Zamakhshari (Asas): Literal for material destitution; metaphorical for the soul's essential neediness before its Lord.\n- Root: غني (ghaniya)\n  * Lisan / Ayn: To be rich, self-sufficient, or free from need.\n  * Al-Raghib (Mufradat): In theological terms, absolute Ghina (Self-Sufficiency) belongs to God alone; human wealth is a relative accident (ʿaraḍ) that often breeds heedlessness.\n  * Al-Zamakhshari (Asas): Literal for possessing abundance; metaphorical for the false sense of independence that veils one from God.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic flow of conditional and circumstantial clauses, ensuring the periodic structure of the narrative remains unbroken across multiple embedded quotations.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Poverty and Abstinence'", "badge": "Afterlife"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 821], [2, 821, 1558], [3, 1558, 2747], [4, 2747, 4031], [5, 4031, 4452], [6, 4452, 5104], [7, 5104, 6135], [8, 6135, 8134], [9, 8134, 9660], [10, 9660, 10765], [11, 10765, 12154], [12, 12154, 13568]], "2": [[1, 350, 1369], [2, 1369, 2134], [3, 2134, 3009], [4, 3009, 4472], [5, 4472, 5580], [6, 5580, 7159]], "3": [[1, 350, 1602], [2, 1602, 2353], [3, 2353, 3763]], "4": [[1, 400, 1269], [2, 1269, 2319], [3, 2319, 3517], [4, 3517, 4959], [5, 4959, 5998], [6, 5998, 6963], [7, 6963, 7387], [8, 7387, 8066], [9, 8066, 8617], [10, 8617, 10496], [11, 10496, 11922]], "5": [[1, 400, 1729], [2, 1729, 3465], [3, 3465, 4373], [4, 4373, 6129], [5, 6129, 6917], [6, 6917, 8294], [7, 8294, 8673], [8, 8673, 9780], [9, 9780, 11388], [10, 11388, 13343], [11, 13343, 14894], [12, 14894, 16570], [13, 16570, 18016], [14, 18016, 19065], [15, 19065, 19763], [16, 19763, 21144]], "6": [[1, 400, 1245], [2, 1245, 2553], [3, 2553, 3965], [4, 3965, 4428], [5, 4428, 5146], [6, 5146, 6280], [7, 6280, 8479], [8, 8479, 9058], [9, 9058, 9891], [10, 9891, 11129], [11, 11129, 12578], [12, 12578, 14328], [13, 14328, 16087], [14, 16087, 16527], [15, 16527, 17210], [16, 17210, 18767]], "7": [[1, 400, 1109], [2, 1109, 2207], [3, 2207, 3664], [4, 3664, 5179], [5, 5179, 6869], [6, 6869, 8346], [7, 8346, 8715], [8, 8715, 9414], [9, 9414, 10721]], "8": [[1, 400, 2872], [2, 2872, 3717], [3, 3717, 4945], [4, 4945, 6509], [5, 6509, 7420], [6, 7420, 8675], [7, 8675, 9203], [8, 9203, 10682], [9, 10682, 12251], [10, 12251, 13904], [11, 13904, 15901], [12, 15901, 17169], [13, 17169, 18371], [14, 18371, 19414], [15, 19414, 20497], [16, 20497, 22319], [17, 22319, 23138], [18, 23138, 24131], [19, 24131, 24923], [20, 24923, 25927], [21, 25927, 26891]]}, "minshawi": {"1": [[1, 200, 614], [2, 614, 1525], [3, 1525, 2891], [4, 2891, 4567], [5, 4567, 4981], [6, 4981, 5623], [7, 5623, 6689], [8, 6689, 9038], [9, 9038, 10725], [10, 10725, 11911], [11, 11911, 13463], [12, 13463, 15190]], "2": [[1, 200, 1603], [2, 1603, 2420], [3, 2420, 3441], [4, 3441, 5865], [5, 5865, 7409], [6, 7409, 9150]], "3": [[1, 200, 2186], [2, 2186, 3037], [3, 3037, 5080]], "4": [[1, 630, 1946], [2, 1946, 3014], [3, 3014, 4437], [4, 4437, 6529], [5, 6529, 7640], [6, 7640, 8859], [7, 8859, 9290], [8, 9290, 9991], [9, 9991, 10789], [10, 10789, 13550], [11, 13550, 15350]], "5": [[1, 690, 3121], [2, 3121, 5890], [3, 5890, 7084], [4, 7084, 9568], [5, 9568, 10414], [6, 10414, 12063], [7, 12063, 12465], [8, 12465, 13839], [9, 13839, 16376], [10, 16376, 19441], [11, 19441, 21178], [12, 21178, 23757], [13, 23757, 25402], [14, 25402, 26751], [15, 26751, 27681], [16, 27681, 29490]], "6": [[1, 300, 1094], [2, 1094, 2635], [3, 2635, 4526], [4, 4526, 4993], [5, 4993, 5717], [6, 5717, 6919], [7, 6919, 9569], [8, 9569, 10176], [9, 10176, 11273], [10, 11273, 12464], [11, 12464, 14208], [12, 14208, 17103], [13, 17103, 19531], [14, 19531, 19975], [15, 19975, 20664], [16, 20664, 22610]], "7": [[1, 650, 1338], [2, 1338, 2674], [3, 2674, 4820], [4, 4820, 6996], [5, 6996, 8872], [6, 8872, 10977], [7, 10977, 11362], [8, 11362, 12121], [9, 12121, 13810]], "8": [[1, 590, 4666], [2, 4666, 5662], [3, 5662, 7087], [4, 7087, 8914], [5, 8914, 10002], [6, 10002, 11504], [7, 11504, 12117], [8, 12117, 14170], [9, 14170, 16061], [10, 16061, 18350], [11, 18350, 22150], [12, 22150, 23958],