: "تَاتِيَهُمُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْبَيِّنَةُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 2, "text": "رَسُولࣱ مِّنَ اَ۬للَّهِ يَتْلُواْ صُحُفاࣰ مُّطَهَّرَةࣰ‏", "words": [{"id": 1, "arabic": "رَسُولࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَتْلُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "صُحُفاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّطَهَّرَةࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 3, "text": "فِيهَا كُتُبࣱ قَيِّمَةࣱۖ", "words": [{"id": 1, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كُتُبࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَيِّمَةࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 4, "text": "وَمَا تَفَرَّقَ اَ۬لذِينَ أُوتُواْ اُ۬لْكِتَٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ اُ۬لْبَيِّنَةُۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَفَرَّقَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أُوتُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْكِتَٰبَ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 8, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "جَآءَتْهُمُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْبَيِّنَةُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 5, "text": "وَمَآ أُمِرُوٓاْ إِلَّا لِيَعْبُدُواْ اُ۬للَّهَ مُخْلِصِينَ لَهُ اُ۬لدِّينَ حُنَفَآءَ وَيُقِيمُواْ اُ۬لصَّلَوٰةَ وَيُوتُواْ اُ۬لزَّكَوٰةَۖ وَذَٰلِكَ دِينُ اُ۬لْقَيِّمَةِۖ", "words": [{"id": 1, "arabic": "و