: ""}, {"id": 16, "arabic": "اُ۬لْبَرِيَٓٔةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 7, "text": "إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ أُوْلَٰٓئِكَ هُمْ خَيْرُ اُ۬لْبَرِيَٓٔةِۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "خَيْرُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لْبَرِيَٓٔةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 8, "text": "جَزَآؤُهُمْ عِندَ رَبِّهِمْ جَنَّٰتُ عَدْنࣲ تَجْرِے مِن تَحْتِهَا اَ۬لَانْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَداࣰۖ رَّضِيَ اَ۬للَّهُ عَنْهُمْ وَرَضُواْ عَنْهُۖ ذَٰلِكَ لِمَنْ خَشِيَ رَبَّهُۥٓۖ", "words": [{"id": 1, "arabic": "جَزَآؤُهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّٰتُ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَدْنࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَجْرِے", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "تَحْتِهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لَانْهَٰرُ", "translit": "", "root": ""}, {"id": 10, "arabic": "خَٰلِدِينَ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِيهَآ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَبَداࣰۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "رَّضِيَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"