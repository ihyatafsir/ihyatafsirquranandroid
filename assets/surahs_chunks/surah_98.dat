, "arabic": "كُتُبࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَيِّمَةࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 4, "text": "وَمَا تَفَرَّقَ اَ۬لذِينَ أُوتُواْ اُ۬لْكِتَٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَتْهُمُ اُ۬لْبَيِّنَةُۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَفَرَّقَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أُوتُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْكِتَٰبَ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 8, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "جَآءَتْهُمُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْبَيِّنَةُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 5, "text": "وَمَآ أُمِرُوٓاْ إِلَّا لِيَعْبُدُواْ اُ۬للَّهَ مُخْلِصِينَ لَهُ اُ۬لدِّينَ حُنَفَآءَ وَيُقِيمُواْ اُ۬لصَّلَوٰةَ وَيُوتُواْ اُ۬لزَّكَوٰةَۖ وَذَٰلِكَ دِينُ اُ۬لْقَيِّمَةِۖ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أُمِرُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَعْبُدُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُخْلِصِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لدِّينَ", "translit": "", "root": ""}, {"id": 9, "arabic": "حُنَفَآءَ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَيُقِيمُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَيُوتُواْ", "translit": "", "root": ""}, {"id": 13, "arabic": "اُ۬لزَّكَوٰةَۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَذَٰلِكَ", "translit": "", "root": ""}, {"id": 15, "arabic": "دِينُ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لْقَيِّمَةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 6, "text": "إِنَّ اَ۬لذِينَ كَفَرُواْ مِنَ اَهْلِ اِ۬لْكِتَٰبِ وَالْمُشْرِكِينَ فِے ن۪ارِ جَهَنَّمَ خَٰلِدِينَ فِيهَآۖ أُوْلَٰٓئِكَ هُمْ شَرُّ اُ۬لْبَرِيَٓٔةِۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَهْلِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْكِتَٰبِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالْمُشْرِكِينَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "ن۪ارِ", "translit": "", "root": ""}, {"id": 10, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 11, "arabic": "خَٰلِدِينَ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِيهَآۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 14, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "شَرُّ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لْبَرِيَٓٔةِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 98, "ayah": 7, "text": "إِنَّ اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ أُوْلَٰٓئِكَ هُمْ خَيْرُ اُ۬لْبَرِيَٓٔةِۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 7, "ar