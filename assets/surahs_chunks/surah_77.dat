s.","words":[{"id":1,"arabic":"وَيْلٌ","translit":"ٌlْyَw","root":""},{"id":2,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":3,"arabic":"لِّلْمُكَذِّبِينَ","translit":"َnyِbِّhdَkُmْlِّl","root":"كذب"}],"hasIhya":false},{"ayah":35,"text":"هَٰذَا يَوْمُ لَا يَنطِقُونَ ","translation":"This is a Day they will not speak,","words":[{"id":1,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":2,"arabic":"يَوْمُ","translit":"ُmْwَy","root":"يوم"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يَنطِقُونَ","translit":"َnwُqِṭnَy","root":"نطق"}],"hasIhya":true},{"ayah":36,"text":"وَلَا يُؤْذَنُ لَهُمْ فَيَعْتَذِرُونَ ","translation":"Nor will it be permitted for them to make an excuse.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"يُؤْذَنُ","translit":"ُnَhdْwʾُy","root":"اذن"},{"id":3,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":4,"arabic":"فَيَعْتَذِرُونَ","translit":"َnwُrِhdَtْʿعَyَf","root":"عذر"}],"hasIhya":false},{"ayah":37,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ ","translation":"Woe, that Day, to the deniers.","words":[{"id":1,"arabic":"وَيْلٌ","translit":"ٌlْyَw","root":""},{"id":2,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":3,"arabic":"لِّلْمُكَذِّبِينَ","translit":"َnyِbِّhdَkُmْlِّl","root":"كذب"}],"hasIhya":false},{"ayah":38,"text":"هَٰذَا يَوْمُ ٱلْفَصْلِۖ جَمَعْنَٰكُمْ وَٱلْأَوَّلِينَ ","translation":"This is the Day of Judgement; We will have assembled you and the former peoples.","words":[{"id":1,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":2,"arabic":"يَوْمُ","translit":"ُmْwَy","root":"يوم"},{"id":3,"arabic":"ٱلْفَصْلِ","translit":"ِlْṣَfْlٱ","root":"فصل"},{"id":4,"arabic":"جَمَعْنَٰكُمْ","translit":"ْmُkَٰnْʿعَmَjg","root":"جمع"},{"id":5,"arabic":"وَٱلْأَوَّلِينَ","translit":"َnyِlَّwَaʾْlٱَw","root":"اول"}],"hasIhya":false},{"ayah":39,"text":"فَإِن كَانَ لَكُمْ كَيْدٌ فَكِيدُونِ ","translation":"So if you have a plan, then plan against Me.","words":[{"id":1,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":4,"arabic":"كَيْدٌ","translit":"ٌdْyَk","root":"كيد"},{"id":5,"arabic":"فَكِيدُونِ","translit":"ِnwُdyِkَf","root":"كيد"}],"hasIhya":false},{"ayah":40,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ ","translation":"Woe, that Day, to the deniers.","words":[{"id":1,"arabic":"وَيْلٌ","translit":"ٌlْyَw","root":""},{"id":2,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":3,"arabic":"لِّلْمُكَذِّبِينَ","translit":"َnyِbِّhdَkُmْlِّl","root":"كذب"}],"hasIhya":false},{"ayah":41,"text":"إِنَّ ٱلْمُتَّقِينَ فِى ظِلَٰلٍ وَعُيُونٍ ","translation":"Indeed, the righteous will be among shades and springs","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلْمُتَّقِينَ","translit":"َnyِqَّtُmْlٱ","root":"وقي"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ظِلَٰلٍ","translit":"ٍlَٰlِẓ","root":"ظلل"},{"id":5,"arabic":"وَعُيُونٍ","translit":"ٍnwُyُʿعَw","root":"عين"}],"hasIhya":false},{"ayah":42,"text":"وَفَوَٰكِهَ مِمَّا يَشْتَهُونَ ","translation":"And fruits from whatever they desire,","words":[{"id":1,"arabic":"وَفَوَٰكِهَ","translit":"َhِkَٰwَfَw","root":"فكه"},{"id":2,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":3,"arabic":"يَشْتَهُونَ","translit":"َnwُhَtْhsَy","root":"شهو"}],"hasIhya":false},{"ayah":43,"text":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَا كُنتُمْ تَعْمَلُونَ ","translation":"[Being told], \"Eat and drink in satisfaction for what you used to do.\"","words":[{"id":1,"arabic":"كُلُوا۟","translit":"۟āwُlُk","root":"اكل"},{"id":2,"arabic":"وَٱشْرَبُوا۟","translit":"۟āwُbَrْhsٱَw","root":"شرب"},{"id":3,"arabic":"هَنِيٓـًٔۢا","translit":"āًۢٔـٓyِnَh","root":"هنا"},{"id":4,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":5,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":6,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":false},{"ayah":44,"text":"إِنَّا كَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ","translation":"Indeed, We thus reward the doers of good.","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":3,"arabic":"نَجْزِى","translit":"àِzْjgَn","root":"جزي"},{"id":4,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":false},{"ayah":45,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ ","translation":"Woe, that Day, to the deniers.","words":[{"id":1,"arabic":"وَيْلٌ","translit":"ٌlْyَw","root":""},{"id":2,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":3,"arabic":"لِّلْمُكَذِّبِينَ","translit":"َnyِbِّhdَkُmْlِّl","root":"كذب"}],"hasIhya":false},{"ayah":46,"text":"كُلُوا۟ وَتَمَتَّعُوا۟ قَلِيلًا إِنَّكُم مُّجْرِمُونَ ","translation":"[O disbelievers], eat and enjoy yourselves a little; indeed, you are criminals.","words":[{"id":1,"arabic":"كُلُوا۟","translit":"۟āwُlُk","root":"اكل"},{"id":2,"arabic":"وَتَمَتَّعُوا۟","translit":"۟āwُʿعَّtَmَtَw","root":"متع"},{"id":3,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":4,"arabic":"إِنَّكُم","translit":"mُkَّnِiʾ","root":""},{"id":5,"arabic":"مُّجْرِمُونَ","translit":"َnwُmِrْjgُّm","root":"جرم"}],"hasIhya":false},{"ayah":47,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ ","translation":"Woe, that Day, to the deniers.","words":[{"id":1,"arabic":"وَيْلٌ","translit":"ٌlْyَw","root":""},{"id":2,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":3,"arabic":"لِّلْمُكَذِّبِينَ","translit":"َnyِbِّhdَkُmْlِّl","root":"كذب"}],"hasIhya":false},{"ayah":48,"text":"وَإِذَا قِيلَ لَهُمُ ٱرْكَعُوا۟ لَا يَرْكَعُونَ ","translation":"And when it is said to them, \"Bow [in prayer],\" they do not bow.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"قِيلَ","translit":"َlyِq","root":"قول"},{"id":3,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":4,"arabic":"ٱرْكَعُوا۟","translit":"۟āwُʿعَkْrٱ","root":"ركع"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"يَرْكَعُونَ","translit":"َnwُʿعَkْrَy","root":"ركع"}],"hasIhya":false},{"ayah":49,"text":"وَيْلٌ يَوْمَئِذٍ لِّلْمُكَذِّبِينَ ","translation":"Woe, that Day, to the deniers.","words":[{"id":1,"arabic":"وَيْلٌ","translit":"ٌlْyَw","root":""},{"id":2,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":3,"arabic":"لِّلْمُكَذِّبِينَ","translit":"َnyِbِّhdَkُmْlِّl","root":"كذب"}],"hasIhya":false},{"ayah":50,"text":"فَبِأَىِّ حَدِيثٍۭ بَعْدَهُۥ يُؤْمِنُونَ ","translation":"Then in what statement after it [i.e., the Qur’ān] will they believe?","words":[{"id":1,"arabic":"فَبِأَىِّ","translit":"ِّàَaʾِbَf","root":"ايي"},{"id":2,"arabic":"حَدِيثٍۭ","translit":"ٍۭhtyِdَḥ","root":"حدث"},{"id":3,"arabic":"بَعْدَهُۥ","translit":"ۥُhَdْʿعَb","root":"بعد"},{"id":4,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":false}],"tafsir":{"20":[{"arabic":"ألم يك نطفة من مني يمنى ثم كان علقة فخلق فسوى وقال تعالى ألم نخلقكم من ماء مهين فجعلناه في قرار مكين إلى قدر معلوم {وقال} أولم ير الإنسان أنا خلقناه من نطفة فإذا هو خصيم مبين {وقال} إنا خلقنا الإنسان من نطفة أمشاج ثم ذكر كيف جعل النطفة علقة والعلقة مضغة والمضغة عظاما فقال تعالى ولقد خلقنا الإنسان من سلالة من طين ثم جعلناه نطفة في قرار مكين ثم خلقنا النطفة علقة الآية فتكرير ذكر النطفة في الكتاب العزيز ليس ليسمع لفظه ويترك التفكر في معناه فانظر الآن إلى النطفة وهي قطرة من الماء قذرة لو تركت ساعة ليضربها الهواء فسدت وأنتنت كيف أخرجها رب الأرباب من الصلب والترائب و","english":"I say: The Exalted said: {أَلَمْ يَكُ نُطْفَةً مِنْ مَنِيٍّ يُمْنَىٰ ثُمَّ كَانَ عَلَقَةً فَخَلَقَ فَسَوَّىٰ} [Was he not a sperm-drop from semen emitted? Then he was a clinging clot, and He created and proportioned him] (Al-Qiyamah: 37-38). And the Exalted said: {أَلَمْ نَخْلُقْكُمْ مِنْ مَاءٍ مَهِينٍ فَجَعَلْنَاهُ فِي قَرَارٍ مَكِينٍ إِلَىٰ قَدَرٍ مَعْلُومٍ} [Did We not create you from a despicable fluid, then We placed it in a firm resting-place for a known term?] (Al-Mursalat: 20-22). And He said: {أَوَلَمْ يَرَ الْإِنْسَانُ أَنَّا خَلَقْنَاهُ مِنْ نُطْفَةٍ فَإِذَا هُوَ خَصِيمٌ مُبِينٌ} [Does man not see that We created him from a sperm-drop, yet behold, he is a manifest adversary?] (Ya-Sin: 77). And He said: {إِنَّا خَلَقْنَا الْإِنْسَانَ مِنْ نُطْفَةٍ أَمْشَاجٍ} [Indeed, We created man from a mixed sperm-drop] (Al-Insan: 2). Then He mentioned how He made the sperm-drop a clinging clot, the clot a chewed lump, and the lump bones, saying: {وَلَقَدْ خَلَقْنَا الْإِنْسَانَ مِنْ سُلَالَةٍ مِنْ طِينٍ ثُمَّ جَعَلْنَاهُ نُطْفَةً فِي قَرَارٍ مَكِينٍ ثُمَّ خَلَقْنَا النُّطْفَةَ عَلَقَةً} [And indeed We created man from an extract of clay, then We made him a sperm-drop in a firm resting-place, then We created the sperm-drop into a clinging clot] (Al-Mu'minun: 12-14), to the end of the verse.","book_title":"Contemplation","section_title_ar":"Section 1269","section_title_en":"The Wonders of Human Creation from a Sperm-Drop — Section 1269","section_index":1269,"anchors":"- Root: نطف (n-ṭ-f)\n  * Lisan / Ayn: Pure, clear water; a drop of fluid; the seminal fluid; also pearl.\n  * Al-Raghib (Mufradat): \"النطفة: الماء الصافي\" — the sperm-drop as pure water, used Quranically for the seminal fluid; a technical term for the initial stage of human embryological creation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"الماء الصافي قل أو كثر\" — clear water, little or much. Metaphorical (Majaz): \"ليلة نطوف: مطرت حتى الصباح\" — a night of continuous rain, extending the root's sense of flowing/pouring.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring, estimating, fashioning precisely; creating from nothing or from a prior substance.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — origination upon a straight measure; used for both creation ex nihilo (إبداع) and formation from an existing thing (إيجاد من الشيء).\n  * Al-Zamakhshari (Asas): Literal: \"قدره قبل القطع\" — measuring before cutting (craftsman's act). Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation as bringing into existence upon a measure necessitated by wisdom.\n- Root: كيف (kayf)\n  * Lisan / Ayn: An interrogative particle asking about state or condition; also used for manner.\n  * Al-Raghib (Mufradat): \"كيف: لفظ يسأل به عما يصح أن يقال فيه: شبيه وغير شبيه\" — a word asking about what admits of likeness or unlikeness (qualities); not applicable to God's essence, but used here to provoke reflection on creaturely processes.\n  * Al-Zamakhshari (Asas): Interrogative of modality; in this context, a rhetorical summons to contemplate the \"how\" of divine craftsmanship.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure here repeatedly employs \"ثم كيف\" (then how) as a coordinating interrogative chain, linking successive clauses without ellipsis, preserving the full syntactic weight of each stage of creation.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"}],"21":[{"arabic":"فهو في الرحم في قرار مكين إلى قدر معلوم وله في سلوكه إلى الكمال منازل وأطوار من نطفة وعلقة ومضغة وغيرها إلى أن يخرج من مضيق الرحم إلى فضاء العالم فنسبة عموم القيامة الكبرى إلى خصوص القيامة الصغرى كنسبة سعة فضاء العالم إلى سعة فضاء الرحم ونسبة سعة العالم الذي يقدم عليه العبد بالموت إلى سعة فضاء الدنيا كنسبة فضاء الدنيا أيضا إلى الرحم بل أوسع وأعظم فقس الآخرة بالأولى فما خلقكم ولا بعثكم إلا كنفس واحدة وما النشأة الثانية إلا على قياس النشأة الأولى بل أعداد النشآت ليست محصورة في اثنتين وإلي","english":"How immense is your heedlessness, O wretched one—and all of us are that wretched one—while before you are these terrors! If you do not believe in the greater resurrection out of ignorance and error, does not the evidence of the lesser resurrection suffice you? Have you not heard the saying of the Master of the Prophets, peace be upon him: \"Sufficient is death as a warner\" (kafā bil-mawti wāʿiẓan)? Have you not heard of his weeping, peace be upon him, at death, until he said, may God's peace and blessing be upon him: \"O God, ease for Muhammad the agonies of death\" (allāhumma hawwin ʿalā Muḥammadin sakarāti al-mawt)? Are you not ashamed of your slowness in anticipating the onslaught of death, following the rabble of the heedless—those who look only for a single cry that seizes them while they are disputing, so they can neither make a bequest nor return to their families? Then illness comes to them as a warner of death, and they are not deterred; and gray hair comes to them as a messenger from it, and they do not take heed. {«يَا حَسْرَةً عَلَى الْعِبَادِ مَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ»} (O regret upon the servants! There comes not to them a messenger but they mock him) [Ya-Sin: 30]. Do they think that they are in this world immortal? {«أَوَلَمْ يَرَوْا كَمْ أَهْلَكْنَا قَبْلَهُمْ مِنَ الْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ»} (Have they not seen how many generations We destroyed before them—that they will not return to them?) [Ya-Sin: 31]. Or do they reckon that the dead have merely traveled away from them, and so they are annihilated? Nay! {«وَإِنْ كُلٌّ لَمَّا جَمِيعٌ لَدَيْنَا مُحْضَرُونَ»} (And indeed, all of them, without exception, will be brought before Us) [Ya-Sin: 32]. {«وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ»} (And there comes not to them a sign from the signs of their Lord but they turn away from it) [Ya-Sin: 46]. And that is because {«إِنَّا جَعَلْنَا مِنْ بَيْنِ أَيْدِيهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا فَأَغْشَيْنَاهُمْ فَهُمْ لَا يُبْصِرُونَ»} (We have placed before them a barrier and behind them a barrier, and We have covered them, so they do not see) [Ya-Sin: 9]. {«وَسَوَاءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُونَ»} (And it is alike to them whether you warn them or warn them not—they will not believe) [Ya-Sin: 10].","book_title":"Patience and Gratitude","section_title_ar":"Section 958","section_title_en":"On the Lesser Resurrection as Proof of the Greater, and the Station of the Guardian over the Child","section_index":958,"anchors":"- Root: صغر (ṣaghara)\n  * Lisan / Ayn: Smallness in magnitude, rank, or time; the lesser as opposed to the greater (al-kabīr), each term relative to the other.\n  * Al-Raghib (Mufradat): Ṣighar and kibar are relative opposites, applied variously to age, body, or station; here, the \"lesser resurrection\" (al-qiyāmah al-ṣughrā) is death, measured against the \"greater\" (al-kubrā), the final rising.\n  * Al-Zamakhshari (Asas): Literal: diminution in size or status. Metaphorical: the lesser as a type or foreshadow of the greater—death as the microcosmic analogue of the macrocosmic resurrection.\n- Root: موت (mawt)\n  * Lisan / Ayn: Death as the cessation of animal life; the root also yields \"amāta\" (to cause death) and \"mayyit\" (the dead).\n  * Al-Raghib (Mufradat): Death is the departure of the soul from the body, a transition between two abodes; it is the \"lesser resurrection\" in that it separates the spirit from the corporeal frame, prefiguring the greater separation and recompense.\n  * Al-Zamakhshari (Asas): Literal: biological death. Metaphorical: \"the dead land\" revived by rain, and here, death as a \"warner\" (nadhīr) and \"messenger\" (rasūl)—personified agencies of admonition.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge as perception or cognition of a thing; \"ʿallama\" (to teach) and \"ʿālim\" (the knowing one).\n  * Al-Raghib (Mufradat): ʿIlm is apprehension of a thing's reality—either its essence or a judgment about it. Here, the \"knowledge\" of the two resurrections distinguishes the believer (muʾmin) from the ignorant (jāhil), who sees with a \"blind eye\" (al-ʿayn al-ʿawrāʾ).\n  * Al-Zamakhshari (Asas): Literal: certain cognition. Metaphorical: \"I knew not of your news\" (mā ʿalimtu bi-khabarika) meaning \"I perceived not\"—thus ignorance is a failure of perception, not mere absence of data.\n- Root: ولي (waliya)\n  * Lisan / Ayn: Nearness, guardianship, or patronage; the walī is one who assumes charge of another's affairs, whether kin or protector.\n  * Al-Raghib (Mufradat): Wilāyah denotes proximity and authority; the walī of a child acts as God's deputy in discipline, mirroring the angels' custodianship of the moral ledger.\n  * Al-Zamakhshari (Asas): Literal: physical adjacency. Metaphorical: the guardian's \"inheriting the character of the angels\" (waritha akhlāq al-malāʾikah)—a moral, not genealogical, inheritance.\n- Sibawayh Rule: Interposition of the conditional and its apodosis (al-faṣl bayna al-sharṭ wa al-jawāb)—the periodic structure in \"fa-in kunta lā tuʾminu... afalā takfīka\" (if you believe not... does not suffice you?) allows the protasis to govern the rhetorical question, binding the lesser sign to the greater inference.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Patience and Gratitude'","badge":"Afterlife"}],"25":[{"arabic":"تعالى ألم نجعل الأرض كفاتا أحياء وأمواتا فانظر إلى الأرض وهى ميتة فإذا أنزل عليها الماء اهتزت وربت واخضرت وأنبتت عجائب النبات وخرجت منها أصناف الحيوانات ثم انظر كيف أحكم جوانب الأرض بالجبال الراسيات الشوامخ الصم الصلاب وكيف أودع المياه تحتها ففجر العيون وأسال الأنهار تجري على وجهها وأخرج من الحجارة اليابسة ومن التراب الكدر ماء رقيقا عذبا صافيا زلالا وجعل به كل شيء حي فأخرج به فنون الأشجار والنبات من حب وعنب وقضب وزيتون ونخل ورمان وفواكه كثيرة لا تحصى مختلفة الأشكال والألوان والطعوم والصفا","english":"For the beast has no power over that; but as for man, God created for him the power, then he disabled it and disbelieved in God's grace therein. So those are like cattle — nay, they are even further astray from the way {فَأُولَٰئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ سَبِيلًا}.","book_title":"Contemplation","section_title_ar":"Section 1273","section_title_en":"On Contemplating the Earth, Its Rivers, Mountains, and Minerals — Section 1273","section_index":1273,"anchors":"- Root: فكر (f-k-r)\n  * Lisan / Ayn: التفكر: تأمل القلب وتدبر الشيء، والفكر: إعمال النظر في الشيء\n  * Al-Raghib (Mufradat): الفكر: قوة العلم التي بها يدرك الإنسان، وقيل: هو ترتيب أمور معلومة للتأدي إلى مجهول\n  * Al-Zamakhshari (Asas): الفكر: تصرف القلب في النظر — literal: إعمال الروية؛ metaphorical: التفكر في ملكوت الله\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: التي عليها الناس، وجمعها أرضون\n  * Al-Raghib (Mufradat): الأرض: الجرم المقابل للسماء، ويعبر بها عن أسفل الشيء\n  * Al-Zamakhshari (Asas): literal: الأرض المهاد والفراش؛ metaphorical: تذلل الأرض وسكونها\n- Root: دحا (d-ḥ-w) / مهد (m-h-d)\n  * Lisan / Ayn: مهد: وطأ المكان وهيأه، والمهاد: الفراش الموطأ\n  * Al-Raghib (Mufradat): المهد: الموضع المهيأ للصبي، والمهاد: الأرض الموطأة\n  * Al-Zamakhshari (Asas): literal: فرش الأرض وتمهيدها؛ metaphorical: جعلها قارة ساكنة لا تميد\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — the interposed clause \"فانظر\" after \"إلى الأرض\" maintains grammatical continuity while allowing rhetorical pause.","content_type":"fiqh","topic":"Al-Ghazali on the inner and outer dimensions of worship, from 'Contemplation'","badge":"Worship"}],"31":[{"arabic":"فكذلك سماع وصف الطاعات دون العمل بها لا يغني من الله شيئا فكل وعظ لم يغير منك صفة تغييرا يغير أفعالك حتى تقبل على الله إقبالا قويا أو ضعيفا وتعرض عن الدنيا فذلك الوعظ زيادة حجة عليك فإذا رأيته وسيلة لك كنت مغرورا فإن قلت فما ذكرته من مداخل الغرور أمر لا يتخلص منه أحد ولا يمكن الاحتراز منه وهذا يوجب اليأس إذ لا يقوى أحد من البشر على الحذر من خفايا هذه الآفات فأقول الإنسان إذا افترقت همته في شيء أظهر اليأس منه واستعظم الأمر واستوعر الطريق وإذا صح منه الهوى اهتدى إلى الحيل واستنبط بدقيق النظر خفايا ا","english":"...weeping over them, yet possessing no resolve. And perhaps he hears a terrifying discourse, yet does no more than clap his hands and say, \"O Peace, grant peace!\" or \"We seek refuge in God!\" or \"Glory be to God!\" — supposing that he has thereby brought forth all good, while he is utterly deluded (maghrūr).","book_title":"Condemnation of Delusion","section_title_ar":"Section 910","section_title_en":"The Revival of the Religious Sciences — Section 910: On the Delusions of the Self-Conceited Listener and the Threefold Means of Deliverance from Deception","section_index":910,"anchors":"- Root: غرر (gh-r-r)\n  * Lisan / Ayn: The manifest trace or mark of a thing; heedlessness (ghirrah) in wakefulness; the edge of a sword.\n  * Al-Raghib (Mufradat): To strike one's gharrah (forelock/vulnerable spot) — i.e., to take him unawares and attain one's aim from him; the root denotes an apparent effect, hence \"delusion\" (ghurūr) as being deceived by a surface appearance.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): heedlessness and being overtaken unawares. Metaphorical (majāz): \"a day white (agharru) with blazing heat\" — the deception of the self-deluded man is that he sees his mere listening as the very act of worship.\n- Root: عقل (ʿ-q-l)\n  * Lisan / Ayn: The intellect as a faculty prepared for receiving knowledge; also the knowledge acquired thereby; restraint and binding (as the camel is hobbled — ʿiqāl).\n  * Al-Raghib (Mufradat): \"Al-ʿaql is said of the power disposed to accept knowledge, and is said of the knowledge which a man acquires by that power.\" It is the innate, God-given light.\n  * Al-Zamakhshari (Asas): Literal: \"I have not done such-and-such since I attained reason (ʿaqaltu).\" Metaphorical: \"a palm-tree that does not accept pollination (lā taʿqil al-ibār)\" — i.e., does not receive it. The intellect is that which receives and accepts guidance.\n- Root: فطر (f-ṭ-r)\n  * Lisan / Ayn: To split lengthwise; to originate and create a thing anew (faṭara Allāhu al-khalqa).\n  * Al-Raghib (Al-Mufradat): \"The origin of fatr is splitting lengthwise... Faṭara Allāh al-khalq: He originated them.\" The innate disposition (fiṭrah) is the original constitution upon which a thing is brought forth.\n  * Al-Zamakhshari (Asas): Literal: \"Every newborn is born upon the fiṭrah\" — i.e., upon the natural constitution receptive to the religion of truth. Metaphorical: \"No good in a half-baked opinion (al-ra'y al-fatīr)\" — that which has not been matured and perfected.\n- Root: انس (a-n-s)\n  * Lisan / Ayn: Sociability, familiarity, and the human being (insān) as a social creature.\n  * Al-Raghib (Al-Mufradat): The jinn and mankind as creatures; the human being is distinguished by that which perceives realities.\n  * Al-Zamakhshari (Asas): Literal: \"I found comfort in him (anastu bihi).\" Metaphorical: \"He is the intimate companion (ibn urns) of so-and-so\" — his special confidant. The soul's turning toward God is its true intimacy (uns).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication — Innamā)\n  * The particle innamā restricts the predicate to the subject alone, negating all else. In the author's statement \"he is delivered from it only by three things: action, knowledge, and gnosis,\" the restriction (ḥaṣr) establishes that these three are the exclusive and exhaustive means of salvation from delusion — nothing else avails.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Delusion'","badge":"Ethics"}],"35":[{"arabic":"ويوم لا يجزى والد عن ولده ويوم يفر المرء من أخيه وأمه وأبيه ويوم لا ينطقون ولا يؤذن لهم فيعتذرون يوم لا مرد له من الله يوم هم بارزون ويوم هم على النار يفتنون يوم لا ينفع مال ولا بنون يوم لا ينفع الظالمين معذرتهم ولهم اللعنة ولهم سوء الدار يوم ترد فيه المعاذير وتبلى السرائر وتظهر الضمائر وتكشف الأستار يوم تخشع فيه الأبصار وتسكن الأصوات ويقل فيه الالتفات وتبرز الخفيات وتظهر الخطيئات يوم يساق العباد ومعهم الأشهاد ويشيب الصغير ويسكر الكبير فيومئذ وضعت الموازين ونشرت الدواوين وبرزت الجحيم وأغلى الحميم وزفرت النار ويئس الكفار وسعرت النيران وتغي","english":"So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1339","section_title_en":"The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent","section_index":1339,"anchors":"- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"},{"arabic":"تلميذ الصالح المري فافتتح يقرأ وكان حسن الصوت فقرأ هذه الآية عليه {هذا يوم لا ينطقون ولا يؤذن لهم فيعتذرون} فرأيت الشافعي رحمه الله وقد تغير لونه واقشعر جلده واضطرب اضطرابا شديدا وخر مغشيا عليه فلما أفاق جعل يقول أعوذ بك من مقام الكاذبين وإعراض الغافلين اللهم لك خضعت قلوب العارفين وذلت لك رقاب المشتاقين إلهي هب لي جودك وجللني بسترك واعف عن تقصيري بكرم وجهك قال ثم مشى وانصرفنا فلما دخلت بغداد وكان هو بالعراق فقعدت على الشط أتوضأ للصلاة إذ مر بي رجل فقال لي يا غلام أحسن وضوءك أحسن الله إليك في الدنيا والآخرة فالتفت فإذا أنا برجل يتبعه جماعة فأسرعت في وضوئي وجع","english":"Al-Shāfiʿī, may God be pleased with him, was asked a question and remained silent. It was said to him: \"Will you not answer, may God have mercy on you?\" He said: \"Not until I know whether the excellence lies in my silence or in my answering.\" Consider then his watchfulness over his tongue — despite its being the member most imperious over the jurists and the most rebellious against restraint and subjugation — and by this it becomes evident that he neither spoke nor remained silent for the sake of attaining excellence or seeking reward.","book_title":"Book of Knowledge","section_title_ar":"Section 20","section_title_en":"The Revival of the Religious Sciences — Section 20: On the Reverence, Asceticism, and God-Consciousness of Imam al-Shāfiʿī","section_index":20,"anchors":"- Root: حرم (ḥ-r-m)\n  * Lisan / Ayn: Sacred inviolability; that which is protected and sanctified\n  * Al-Raghib (Mufradat): Reverence owed to that which possesses sacredness (ḥurmah)—here, the sanctity of knowledge and its bearer\n  * Al-Zamakhshari (Asas): Literal: physical sanctuary; Metaphorical: the inward sanctity of the scholar's station before God\n- Root: زهد (z-h-d)\n  * Lisan / Ayn: Abstemiousness; to regard something as little (ḥazr)\n  * Al-Raghib (Mufradat): \"الزاهد في الشيء: الراغب عنه والراضي منه بالزهيد، أي: القليل\" — the ascetic is one who turns away from a thing and is content with little of it\n  * Al-Zamakhshari (Asas): Literal: \"زهد في الشيء: رغب عنه\" (turning away from a thing); Metaphorical: \"رجل زهيد: قليل الخير\" and \"اد زهيد: قليل الأخذ للماء\" — a valley that takes little water, i.e., the soul that takes little from the world\n- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Fear, dread, apprehension of harm\n  * Al-Raghib (Mufradat): God-conscious fear (khashyah) — that fear which arises specifically from knowledge of God's majesty, as in {«إنما يخشى الله من عباده العلماء»}\n  * Al-Zamakhshari (Asas): Literal: fear of a known threat; Metaphorical: the awe that seizes the heart upon realization of divine grandeur\n- Root: سفه (s-f-h)\n  * Lisan / Ayn: Foolishness, levity, indecency of speech\n  * Al-Raghib (Mufradat): Moral and intellectual lightness; the opposite of ḥilm (forbearance)\n  * Al-Zamakhshari (Asas): Literal: foolish conduct; Metaphorical: the one who pours filth from his vessel into the vessels of others — the slanderer who seeks to empty his own corruption into pure hearts\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used in the ḥadīth {«إنما يخشى الله من عباده العلماء»} to restrict true khashyah to the learned, and in al-Shāfiʿī's dictum restricting the claim of loving both world and Creator to falsehood","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Book of Knowledge'","badge":"Du'a"}]},"wordTiming":{"abdulbasit":{"1":[[1,250,2174],[2,2174,3260]],"2":[[1,250,2227],[2,2227,3469]],"3":[[1,350,2640],[2,2640,3685]],"4":[[1,250,2310],[2,2310,3574]],"5":[[1,250,2357],[2,2357,3469]],"6":[[1,250,1324],[2,1324,1916],[3,1916,2947]],"7":[[1,350,1704],[2,1704,3264],[3,3264,4521]],"8":[[1,350,1360],[2,1360,2855],[3,2855,3763]],"9":[[1,350,1402],[2,1402,3192],[3,3192,3972]],"10":[[1,250,1296],[2,1296,2439],[3,2439,3234]],"11":[[1,250,1231],[2,1231,2167],[3,2167,3130]],"12":[[1,250,1387],[2,1387,2329],[3,2329,3495]],"13":[[1,250,1192],[2,1192,2059]],"14":[[1,350,1622],[2,1622,2930],[3,2930,3427],[4,3427,4191],[5,4191,5069]],"15":[[1,350,1303],[2,1303,2828],[3,2828,5252]],"16":[[1,350,1018],[2,1018,1832],[3,1832,3633]],"17":[[1,350,1201],[2,1201,2663],[3,2663,4651]],"18":[[1,350,1377],[2,1377,2283],[3,2283,4234]],"19":[[1,350,1339],[2,1339,2921],[3,2921,5435]],"20":[[1,400,1231],[2,1231,3140],[3,3140,4036],[4,4036,5961],[5,5961,7482]],"21":[[1,350,1917],[2,1917,2502],[3,2502,3625],[4,3625,5017]],"22":[[1,350,1505],[2,1505,2308],[3,2308,4103]],"23":[[1,350,1770],[2,1770,2647],[3,2647,4260]],"2