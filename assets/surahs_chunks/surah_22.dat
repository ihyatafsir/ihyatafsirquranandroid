: 22, "ayah": 63, "text": "أَلَمْ تَرَ أَنَّ اَ۬للَّهَ أَنزَلَ مِنَ اَ۬لسَّمَآءِ مَآءࣰ فَتُصْبِحُ اُ۬لَارْضُ مُخْضَرَّةًۖ اِنَّ اَ۬للَّهَ لَطِيفٌ خَبِيرࣱۖ", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَآءࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَتُصْبِحُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لَارْضُ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُخْضَرَّةًۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 14, "arabic": "لَطِيفٌ", "translit": "", "root": ""}, {"id": 15, "arabic": "خَبِيرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 64, "text": "لَّهُۥ مَا فِے اِ۬لسَّمَٰوَٰتِ وَمَا فِے اِ۬لَارْضِۖ وَإِنَّ اَ۬للَّهَ لَهُوَ اَ۬لْغَنِيُّ اُ۬لْحَمِيدُۖ", "words": [{"id": 1, "arabic": "لَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَارْضِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَهُوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْغَنِيُّ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْحَمِيدُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 65, "text": "أَلَمْ تَرَ أَنَّ اَ۬للَّهَ سَخَّرَ لَكُم مَّا فِے اِ۬لَارْضِ وَالْفُلْكَ تَجْرِے فِے اِ۬لْبَحْرِ بِأَمْرِهِۖۦ وَيُمْسِكُ اُ۬لسَّمَآءَ ان تَقَعَ عَلَي اَ۬لَارْضِ إِلَّا بِإِذْنِهِۦٓۖ إِنَّ اَ۬للَّهَ بِالنَّاسِ لَرَءُوفࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَخَّرَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَالْفُلْكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "تَجْرِے", "translit": "", "root": ""}, {"id": 12, "arabic": "فِے", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لْبَحْرِ", "translit": "", "root": ""}, {"id": 14, "arabic": "بِأَمْرِهِۖۦ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَيُمْسِكُ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لسَّمَآءَ", "translit": "", "root": ""}, {"id": 17, "arabic": "ان", "translit": "", "root": ""}, {"id": 18, "arabic": "تَقَعَ", "translit": "", "root": ""}, {"id": 19, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لَارْضِ", "translit": "", "root": ""}, {"id": 21, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 22, "arabic": "بِإِذْنِهِۦٓۖ", "translit": "", "root": ""}, {"id": 23, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 24, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 25, "arabic": "بِالنَّاسِ", "translit": "", "root": ""}, {"id": 26, "arabic": "لَرَءُوفࣱ", "translit": "", "root": ""}, {"id": 27, "arabic": "رَّحِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah"