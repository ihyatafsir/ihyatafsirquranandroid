nslit": "", "root": ""}, {"id": 6, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَذِيرࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 50, "text": "فَالذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ لَهُم مَّغْفِرَةࣱ وَرِزْقࣱ كَرِيمࣱۖ", "words": [{"id": 1, "arabic": "فَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّغْفِرَةࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَرِزْقࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَرِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 51, "text": "وَالذِينَ سَعَوْاْ فِےٓ ءَايَٰتِنَا مُعَٰجِزِينَ أُوْلَٰٓئِكَ أَصْحَٰبُ اُ۬لْجَحِيمِۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "سَعَوْاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَايَٰتِنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مُعَٰجِزِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَصْحَٰبُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْجَحِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 52, "text": "وَمَآ أَرْسَلْنَا مِن قَبْلِكَ مِن رَّسُولࣲ وَلَا نَبِےٓءٍ اِلَّآ إِذَا تَمَنّ۪يٰٓ أَلْقَي اَ۬لشَّيْطَٰنُ فِےٓ أُمْنِيَّتِهِۦ فَيَنسَخُ اُ۬للَّهُ مَا يُلْقِے اِ۬لشَّيْطَٰنُ ثُمَّ يُحْكِمُ اُ۬للَّهُ ءَايَٰتِهِۦ وَاللَّهُ عَلِيمٌ حَكِيمࣱ‏", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "transl