t": ""}, {"id": 12, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 13, "arabic": "فَجٍّ", "translit": "ٍّjgَf", "root": "فجج"}, {"id": 14, "arabic": "عَمِيقٍ", "translit": "ٍqyِmَʿع", "root": "عمق"}], "hasIhya": true}, {"ayah": 28, "text": "لِّيَشْهَدُوا۟ مَنَٰفِعَ لَهُمْ وَيَذْكُرُوا۟ ٱسْمَ ٱللَّهِ فِىٓ أَيَّامٍ مَّعْلُومَٰتٍ عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلْأَنْعَٰمِۖ فَكُلُوا۟ مِنْهَا وَأَطْعِمُوا۟ ٱلْبَآئِسَ ٱلْفَقِيرَ ", "translation": "That they may witness [i.e., attend] benefits for themselves and mention the name of Allāh on known [i.e., specific] days over what He has provided for them of [sacrificial] animals.[1] So eat of them and feed the miserable and poor.", "words": [{"id": 1, "arabic": "لِّيَشْهَدُوا۟", "translit": "۟āwُdَhْhsَyِّl", "root": "شهد"}, {"id": 2, "arabic": "مَنَٰفِعَ", "translit": "َʿعِfَٰnَm", "root": "نفع"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "وَيَذْكُرُوا۟", "translit": "۟āwُrُkْhdَyَw", "root": "ذكر"}, {"id": 5, "arabic": "ٱسْمَ", "translit": "َmْsٱ", "root": "سمو"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 8, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 9, "arabic": "مَّعْلُومَٰتٍ", "translit": "ٍtَٰmwُlْʿعَّm", "root": "علم"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "رَزَقَهُم", "translit": "mُhَqَzَr", "root": "رزق"}, {"id": 13, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 14, "arabic": "بَهِيمَةِ", "translit": "ِẗَmyِhَb", "root": "بهم"}, {"id": 15, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 16, "arabic": "فَكُلُوا۟", "translit": "۟āwُlُkَf", "root": "اكل"}, {"id": 17, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 18, "arabic": "وَأَطْعِمُوا۟", "translit": "۟āwُmِʿعْṭَaʾَw", "root": "طعم"}, {"id": 19, "arabic": "ٱلْبَآئِسَ", "translit": "َsِyʾٓāَbْlٱ", "root": "باس"}, {"id": 20, "arabic": "ٱلْفَقِيرَ", "translit": "َryِqَfْlٱ", "root": "فقر"}], "hasIhya": false}, {"ayah": 29, "text": "ثُمَّ لْيَقْضُوا۟ تَفَثَهُمْ وَلْيُوفُوا۟ نُذُورَهُمْ وَلْيَطَّوَّفُوا۟ بِٱلْبَيْتِ ٱلْعَتِيقِ ", "translation": "Then let them end their untidiness and fulfill their vows and perform ṭawāf around the ancient House.\"", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "لْيَقْضُوا۟", "translit": "۟āwُḍْqَyْl", "root": "قضي"}, {"id": 3, "arabic": "تَفَثَهُمْ", "translit": "ْmُhَhtَfَt", "root": "تفث"}, {"id": 4, "arabic": "وَلْيُوفُوا۟", "translit": "۟āwُfwُyْlَw", "root": "وفي"}, {"id": 5, "arabic": "نُذُورَهُمْ", "translit": "ْmُhَrwُhdُn", "root": "نذر"}, {"id": 6, "arabic": "وَلْيَطَّوَّفُوا۟", "translit": "۟āwُfَّwَّṭَyْlَw", "root": "طوف"}, {"id": 7, "arabic": "بِٱلْبَيْتِ", "translit": "ِtْyَbْlٱِb", "root": "بيت"}, {"id": 8, "arabic": "ٱلْعَتِيقِ", "translit": "ِqyِtَʿعْlٱ", "root": "عتق"}], "hasIhya": false}, {"ayah": 30, "text": "ذَٰلِكَ وَمَن يُعَظِّمْ حُرُمَٰتِ ٱللَّهِ فَهُوَ خَيْرٌ لَّهُۥ عِندَ رَبِّهِۦۗ وَأُحِلَّتْ لَكُمُ ٱلْأَنْعَٰمُ إِلَّا مَا يُتْلَىٰ عَلَيْكُمْۖ فَٱجْتَنِبُوا۟ ٱلرِّجْسَ مِنَ ٱلْأَوْثَٰنِ وَٱجْتَنِبُوا۟ قَوْلَ ٱلزُّورِ ", "translation": "That [has been commanded], and whoever honors the sacred ordinances of Allāh - it is best for him in the sight of his Lord. And permitted to you are the grazing livestock, except what is recited to you.[1] So avoid the uncleanliness of idols and avoid false statement,", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 3, "arabic": "يُعَظِّمْ", "translit": "ْmِّẓَʿعُy", "root": "عظم"}, {"id": 4, "arabic": "حُرُمَٰتِ", "translit": "ِtَٰmُrُḥ", "root": "حرم"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 7, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 8, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 9, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 10, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 11, "arabic": "وَأُحِلَّتْ", "translit": "ْtَّlِḥُaʾَw", "root": "حلل"}, {"id": 12, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 13, "arabic": "ٱلْأَنْعَٰمُ", "translit": "ُmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "يُتْلَىٰ", "translit": "ٰàَlْtُy", "root": "تلو"}, {"id": 17, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 18, "arabic": "فَٱجْتَنِبُوا۟", "translit": "۟āwُbِnَtْjgٱَf", "root": "جنب"}, {"id": 19, "arabic": "ٱلرِّجْسَ", "translit": "َsْjgِّrlٱ", "root": "رجس"}, {"id": 20, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 21, "arabic": "ٱلْأَوْثَٰنِ", "translit": "ِnَٰhtْwَaʾْlٱ", "root": "وثن"}, {"id": 22, "arabic": "وَٱجْتَنِبُوا۟", "translit": "۟āwُbِnَtْjgٱَw", "root": "جنب"}, {"id": 23, "arabic": "قَوْلَ", "translit": "َlْwَq", "root": "قول"}, {"id": 24, "arabic": "ٱلزُّورِ", "translit": "ِrwُّzlٱ", "root": "زور"}], "hasIhya": false}, {"ayah": 31, "text": "حُنَفَآءَ لِلَّهِ غَيْرَ مُشْرِكِينَ بِهِۦۚ وَمَن يُشْرِكْ بِٱللَّهِ فَكَأَنَّمَا خَرَّ مِنَ ٱلسَّمَآءِ فَتَخْطَفُهُ ٱلطَّيْرُ أَوْ تَهْوِى بِهِ ٱلرِّيحُ فِى مَكَانٍ سَحِيقٍ ", "translation": "Inclining [only] to Allāh, not associating [anything] with Him. And he who associates with Allāh - it is as though he had fallen from the sky and was snatched by the birds or the wind carried him down into a remote place.", "words": [{"id": 1, "arabic": "حُنَفَآءَ", "translit": "َءٓāَfَnُḥ", "root": "حنف"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 4, "arabic": "مُشْرِكِينَ", "translit": "َnyِkِrْhsُm", "root": "شرك"}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "يُشْرِكْ", "translit": "ْkِrْhsُy", "root": "شرك"}, {"id": 8, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 9, "arabic": "فَكَأَنَّمَا", "translit": "āَmَّnَaʾَkَf", "root": ""}, {"id": 10, "arabic": "خَرَّ", "translit": "َّrَhk", "root": "خرر"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 13, "arabic": "فَتَخْطَفُهُ", "translit": "ُhُfَṭْhkَtَf", "root": "خطف"}, {"id": 14, "arabic": "ٱلطَّيْرُ", "translit": "ُrْyَّṭlٱ", "root": "طير"}, {"id": 15, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 16, "arabic": "تَهْوِى", "translit": "àِwْhَt", "root": "هوي"}, {"id": 17, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 18, "arabic": "ٱلرِّيحُ", "translit": "ُḥyِّrlٱ", "root": "روح"}, {"id": 19, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 20, "arabic": "مَكَانٍ", "translit": "ٍnāَkَm", "root": "كون"}, {"id": 21, "arabic": "سَحِيقٍ", "translit": "ٍqyِḥَs", "root": "سحق"}], "hasIhya": true}, {"ayah": 32, "text": "ذَٰلِكَ وَمَن يُعَظِّمْ شَعَٰٓئِرَ ٱللَّهِ فَإِنَّهَا مِن تَقْوَى ٱلْقُلُوبِ ", "translation": "That [is so]. And whoever honors the symbols [i.e., rites] of Allāh - indeed, it is from the piety of hearts.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 3, "arabic": "يُعَظِّمْ", "translit": "ْmِّẓَʿعُy", "root": "عظم"}, {"id": 4, "arabic": "شَعَٰٓئِرَ", "translit": "َrِyʾَٰٓʿعَhs", "root": "شعر"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "فَإِنَّهَا", "translit": "āَhَّnِiʾَf", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "تَقْوَى", "translit": "àَwْqَt", "root": "وقي"}, {"id": 9, "arabic": "ٱلْقُلُوبِ", "translit": "ِbwُlُqْlٱ", "root": "قلب"}], "hasIhya": true}, {"ayah": 33, "text": "لَكُمْ فِيهَا مَنَٰفِعُ إِلَىٰٓ أَجَلٍ مُّسَمًّى ثُمَّ مَحِلُّهَآ إِلَى ٱلْبَيْتِ ٱلْعَتِيقِ ", "translation": "For you therein [i.e., the animals marked for sacrifice] are benefits for a specified term;[1] then their place of sacrifice is at the ancient House.[2]", "words": [{"id": 1, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "مَنَٰفِعُ", "translit": "ُʿعِfَٰnَm", "root": "نفع"}, {"id": 4, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 5, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 6, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "مَحِلُّهَآ", "translit": "ٓāَhُّlِḥَm", "root": "حلل"}, {"id": 9, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱلْبَيْتِ", "translit": "ِtْyَbْlٱ", "root": "بيت"}, {"id": 11, "arabic": "ٱلْعَتِيقِ", "translit": "ِqyِtَʿعْlٱ", "root": "عتق"}], "hasIhya": false}, {"ayah": 34, "text": "وَلِكُلِّ أُمَّةٍ جَعَلْنَا مَنسَكًا لِّيَذْكُرُوا۟ ٱسْمَ ٱللَّهِ عَلَىٰ مَا رَزَقَهُم مِّنۢ بَهِيمَةِ ٱلْأَنْعَٰمِۗ فَإِلَٰهُكُمْ إِلَٰهٌ وَٰحِدٌ فَلَهُۥٓ أَسْلِمُوا۟ۗ وَبَشِّرِ ٱلْمُخْبِتِينَ ", "translation": "And for every [religious] community We have appointed a rite [of sacrifice][1] that they may mention the name of Allāh over what He has provided for them of [sacrificial] animals. For your god is one God, so to Him submit. And, [O Muḥammad], give good tidings to the humble [before their Lord]", "words": [{"id": 1, "arabic": "وَلِكُلِّ", "translit": "ِّlُkِlَw", "root": "كلل"}, {"id": 2, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 3, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "مَنسَكًا", "translit": "āًkَsnَm", "root": "نسك"}, {"id": 5, "arabic": "لِّيَذْكُرُوا۟", "translit": "۟āwُrُkْhdَyِّl", "root": "ذكر"}, {"id": 6, "arabic": "ٱسْمَ", "translit": "َmْsٱ", "root": "سمو"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "رَزَقَهُم", "translit": "mُhَqَzَr", "root": "رزق"}, {"id": 11, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 12, "arabic": "بَهِيمَةِ", "translit": "ِẗَmyِhَb", "root": "بهم"}, {"id": 13, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 14, "arabic": "فَإِلَٰهُكُمْ", "translit": "ْmُkُhَٰlِiʾَf", "root": "اله"}, {"id": 15, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 16, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 17, "arabic": "فَلَهُۥٓ", "translit": "ٓۥُhَlَf", "root": ""}, {"id": 18, "arabic": "أَسْلِمُوا۟", "translit": "۟āwُmِlْsَaʾ", "root": "سلم"}, {"id": 19, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 20, "arabic": "ٱلْمُخْبِتِينَ", "translit": "َnyِtِbْhkُmْlٱ", "root": "خبت"}], "hasIhya": false}, {"ayah": 35, "text": "ٱلَّذِينَ إِذَا ذُكِرَ ٱللَّهُ وَجِلَتْ قُلُوبُهُمْ وَٱلصَّٰبِرِينَ عَلَىٰ مَآ أَصَابَهُمْ وَٱلْمُقِيمِى ٱلصَّلَوٰةِ وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَ ", "translation": "Who, when Allāh is mentioned, their hearts are fearful, and [to] the patient over what has afflicted them, and the establishers of prayer and those who spend from what We have provided them.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "ذُكِرَ", "translit": "َrِkُhd", "root": "ذكر"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَجِلَتْ", "translit": "ْtَlِjgَw", "root": "وجل"}, {"id": 6, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 7, "arabic": "وَٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱَw", "root": "صبر"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 10, "arabic": "أَصَابَهُمْ", "translit": "ْmُhَbāَṣَaʾ", "root": "صوب"}, {"id": 11, "arabic": "وَٱلْمُقِيمِى", "translit": "àِmyِqُmْlٱَw", "root": "قوم"}, {"id": 12, "arabic": "ٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 13, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 14, "arabic": "رَزَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَzَr", "root": "رزق"}, {"id": 15, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}], "hasIhya": false}, {"ayah": 36, "text": "وَٱلْبُدْنَ جَعَلْنَٰهَا لَكُم مِّن شَعَٰٓئِرِ ٱللَّهِ لَكُمْ فِيهَا خَيْرٌۖ فَٱذْكُرُوا۟ ٱسْمَ ٱللَّهِ عَلَيْهَا صَوَآفَّۖ فَإِذَا وَجَبَتْ جُنُوبُهَا فَكُلُوا۟ مِنْهَا وَأَطْعِمُوا۟ ٱلْقَانِعَ وَٱلْمُعْتَرَّۚ كَذَٰلِكَ سَخَّرْنَٰهَا لَكُمْ لَعَلَّكُمْ تَشْكُرُونَ ", "translation": "And the camels and cattle We have appointed for you as among the symbols [i.e., rites] of Allāh; for you therein is good. So mention the name of Allāh upon them when lined up [for sacrifice]; and when they are [lifeless] on their sides, then eat from them and feed the needy [who does not seek aid] and the beggar. Thus have We subjected them to you that you may be grateful.", "words": [{"id": 1, "arabic": "وَٱلْبُدْنَ", "translit": "َnْdُbْlٱَw", "root": "بدن"}, {"id": 2, "arabic": "جَعَلْنَٰهَا", "translit": "āَhَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "شَعَٰٓئِرِ", "translit": "ِrِyʾَٰٓʿعَhs", "root": "شعر"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 10, "arabic": "فَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَf", "root": "ذكر"}, {"id": 11, "arabic": "ٱسْمَ", "translit": "َmْsٱ", "root": "سمو"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "صَوَآفَّ", "translit": "َّfٓāَwَṣ", "root": "صفف"}, {"id": 15, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 16, "arabic": "وَجَبَتْ", "translit": "ْtَbَjgَw", "root": "وجب"}, {"id": 17, "arabic": "جُنُوبُهَا", "translit": "āَhُbwُnُjg", "root": "جنب"}, {"id": 18, "arabic": "فَكُلُوا۟", "translit": "۟āwُlُkَf", "root": "اكل"}, {"id": 19, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 20, "arabic": "وَأَطْعِمُوا۟", "translit": "۟āwُmِʿعْṭَaʾَw", "root": "طعم"}, {"id": 21, "arabic": "ٱلْقَانِعَ", "translit": "َʿعِnāَqْlٱ", "root": "قنع"}, {"id": 22, "arabic": "وَٱلْمُعْتَرَّ", "translit": "َّrَtْʿعُmْlٱَw", "root": "عرر"}, {"id": 23, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 24, "arabic": "سَخَّرْنَٰهَا", "translit": "āَhَٰnْrَّhkَs", "root": "سخر"}, {"id": 25, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 26, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 27, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 37, "text": "لَن يَنَالَ ٱللَّهَ لُحُومُهَا وَلَا دِمَآؤُهَا وَلَٰكِن يَنَالُهُ ٱلتَّقْوَىٰ مِنكُمْۚ كَذَٰلِكَ سَخَّرَهَا لَكُمْ لِتُكَبِّرُوا۟ ٱللَّهَ عَلَىٰ مَا هَدَىٰكُمْۗ وَبَشِّرِ ٱلْمُحْسِنِينَ ", "translation": "Their meat will not reach Allāh, nor will their blood, but what reaches Him is piety from you. Thus have We subjected them to you that you may glorify Allāh for that [to] which He has guided you; and give good tidings to the doers of good.", "words": [{"id": 1, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 2, "arabic": "يَنَالَ", "translit": "َlāَnَy", "root": "نيل"}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لُحُومُهَا", "translit": "āَhُmwُḥُl", "root": "لحم"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "دِمَآؤُهَا", "translit": "āَhُwʾٓāَmِd", "root": "دمو"}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 8, "arabic": "يَنَالُهُ", "translit": "ُhُlāَnَy", "root": "نيل"}, {"id": 9, "arabic": "ٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱ", "root": "وقي"}, {"id": 10, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 11, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 12, "arabic": "سَخَّرَهَا", "translit": "āَhَrَّhkَs", "root": "سخر"}, {"id": 13, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 14, "arabic": "لِتُكَبِّرُوا۟", "translit": "۟āwُrِّbَkُtِl", "root": "كبر"}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 18, "arabic": "هَدَىٰكُمْ", "translit": "ْmُkٰàَdَh", "root": "هدي"}, {"id": 19, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 20, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": true}, {"ayah": 38, "text": "إِنَّ ٱللَّهَ يُدَٰفِعُ عَنِ ٱلَّذِينَ ءَامَنُوٓا۟ۗ إِنَّ ٱللَّهَ لَا يُحِبُّ كُلَّ خَوَّانٍ كَفُورٍ ", "translation": "Indeed, Allāh defends those who have believed. Indeed, Allāh does not like everyone treacherous and ungrateful.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "يُدَٰفِعُ", "translit": "ُʿعِfَٰdُy", "root": "دفع"}, {"id": 4, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 11, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 12, "arabic": "خَوَّانٍ", "translit": "ٍnāَّwَhk", "root": "خون"}, {"id": 13, "arabic": "كَفُورٍ", "translit": "ٍrwُfَk", "root": "كفر"}], "hasIhya": true}, {"ayah": 39, "text": "أُذِنَ لِلَّذِينَ يُقَٰتَلُونَ بِأَنَّهُمْ ظُلِمُوا۟ۚ وَإِنَّ ٱللَّهَ عَلَىٰ نَصْرِهِمْ لَقَدِيرٌ ", "translation": "Permission [to fight] has been given to those who are being fought,[1] because they were wronged. And indeed, Allāh is competent to give them victory.", "words": [{"id": 1, "arabic": "أُذِنَ", "translit": "َnِhdُaʾ", "root": "اذن"}, {"id": 2, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 3, "arabic": "يُقَٰتَلُونَ", "translit": "َnwُlَtَٰqُy", "root": "قتل"}, {"id": 4, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 5, "arabic": "ظُلِمُوا۟", "translit": "۟āwُmِlُẓ", "root": "ظلم"}, {"id": 6, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "نَصْرِهِمْ", "translit": "ْmِhِrْṣَn", "root": "نصر"}, {"id": 10, "arabic": "لَقَدِيرٌ", "translit": "ٌryِdَqَl", "root": "قدر"}], "hasIhya": false}, {"ayah": 40, "text": "ٱلَّذِينَ أُخْرِجُوا۟ مِن دِيَٰرِهِم بِغَيْرِ حَقٍّ إِلَّآ أَن يَقُولُوا۟ رَبُّنَا ٱللَّهُۗ وَلَوْلَا دَفْعُ ٱللَّهِ ٱلنَّاسَ بَعْضَهُم بِبَعْضٍ لَّهُدِّمَتْ صَوَٰمِعُ وَبِيَعٌ وَصَلَوَٰتٌ وَمَسَٰجِدُ يُذْكَرُ فِيهَا ٱسْمُ ٱللَّهِ كَثِيرًاۗ وَلَيَنصُرَنَّ ٱللَّهُ مَن يَنصُرُهُۥٓۗ إِنَّ ٱللَّهَ لَقَوِىٌّ عَزِيزٌ ", "translation": "[They are] those who have been evicted from their homes without right - only because they say, \"Our Lord is Allāh.\" And were it not that Allāh checks the people, some by means of others, there would have been demolished monasteries, churches, synagogues, and mosques in which the name of Allāh is much mentioned [i.e., praised]. And Allāh will surely support those who support Him [i.e., His cause]. Indeed, Allāh is Powerful and Exalted in Might.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "أُخْرِجُوا۟", "translit": "۟āwُjgِrْhkُaʾ", "root": "خرج"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دِيَٰرِهِم", "translit": "mِhِrَٰyِd", "root": "دور"}, {"id": 5, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 6, "arabic": "حَقٍّ", "translit": "ٍّqَḥ", "root": "حقق"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يَقُولُوا۟", "translit": "۟āwُlwُqَy", "root": "قول"}, {"id": 10, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 13, "arabic": "دَفْعُ", "translit": "ُʿعْfَd", "root": "دفع"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 16, "arabic": "بَعْضَهُم", "translit": "mُhَḍْʿعَb", "root": "بعض"}, {"id": 17, "arabic": "بِبَعْضٍ", "translit": "ٍḍْʿعَbِb", "root": "بعض"}, {"id": 18, "arabic": "لَّهُدِّمَتْ", "translit": "ْtَmِّdُhَّl", "root": "هدم"}, {"id": 19, "arabic": "صَوَٰمِعُ", "translit": "ُʿعِmَٰwَṣ", "root": "صمع"}, {"id": 20, "arabic": "وَبِيَعٌ", "translit": "ٌʿعَyِbَw", "root": "بيع"}, {"id": 21, "arabic": "وَصَلَوَٰتٌ", "translit": "ٌtَٰwَlَṣَw", "root": "صلو"}, {"id": 22, "arabic": "وَمَسَٰجِدُ", "translit": "ُdِjgَٰsَmَw", "root": "سجد"}, {"id": 23, "arabic": "يُذْكَرُ", "translit": "ُrَkْhdُy", "root": "ذكر"}, {"id": 24, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 25, "arabic": "ٱسْمُ", "translit": "ُmْsٱ", "root": "سمو"}, {"id": 26, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 28, "arabic": "وَلَيَنصُرَنَّ", "translit": "َّnَrُṣnَyَlَw", "root": "نصر"}, {"id": 29, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 31, "arabic": "يَنصُرُهُۥٓ", "translit": "ٓۥُhُrُṣnَy", "root": "نصر"}, {"id": 32, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 33, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 34, "arabic": "لَقَوِىٌّ", "translit": "ٌّàِwَqَl", "root": "قوي"}, {"id": 35, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}], "hasIhya": true}, {"ayah": 41, "text": "ٱلَّذِينَ إِن مَّكَّنَّٰهُمْ فِى ٱلْأَرْضِ أَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟ ٱلزَّكَوٰةَ وَأَمَرُوا۟ بِٱلْمَعْرُوفِ وَنَهَوْا۟ عَنِ ٱلْمُنكَرِۗ وَلِلَّهِ عَٰقِبَةُ ٱلْأُمُورِ ", "translation": "[And they are] those who, if We give them authority in the land, establish prayer and give zakāh and enjoin what is right and forbid what is wrong. And to Allāh belongs the outcome of [all] matters.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "مَّكَّنَّٰهُمْ", "translit": "ْmُhَّٰnَّkَّm", "root": "مكن"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "أَقَامُوا۟", "translit": "۟āwُmāَqَaʾ", "root": "قوم"}, 