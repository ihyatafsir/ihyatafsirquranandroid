 {"surah": 22, "ayah": 17, "text": "إِنَّ اَ۬لذِينَ ءَامَنُواْ وَالذِينَ هَادُواْ وَالصَّٰبِينَ وَالنَّصَٰر۪يٰ وَالْمَجُوسَ وَالذِينَ أَشْرَكُوٓاْ إِنَّ اَ۬للَّهَ يَفْصِلُ بَيْنَهُمْ يَوْمَ اَ۬لْقِيَٰمَةِۖ إِنَّ اَ۬للَّهَ عَلَيٰ كُلِّ شَےْءࣲ شَهِيدٌۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "هَادُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالصَّٰبِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالنَّصَٰر۪يٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَالْمَجُوسَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَشْرَكُوٓاْ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَفْصِلُ", "translit": "", "root": ""}, {"id": 14, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لْقِيَٰمَةِۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 19, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 20, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 21, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 22, "arabic": "شَهِيدٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 18, "text": "اَلَمْ تَرَ أَنَّ اَ۬للَّهَ يَسْجُدُ لَهُۥ مَن فِے اِ۬لسَّمَٰوَٰتِ وَمَن فِے اِ۬لَارْضِ وَالشَّمْسُ وَالْقَمَرُ وَالنُّجُومُ وَالْجِبَالُ وَالشَّجَرُ وَالدَّوَآبُّ وَكَثِيرࣱ مِّنَ اَ۬لنَّاسِۖ وَكَثِيرٌ حَقَّ عَلَيْهِ اِ۬لْعَذَابُۖ وَمَنْ يُّهِنِ اِ۬للَّهُ فَمَا لَهُۥ مِن مُّكْرِمٍۖ اِنَّ اَ۬للَّ