{"surah": 22, "verses": [{"ayah": 1, "text": "يَٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمْۚ إِنَّ زَلْزَلَةَ ٱلسَّاعَةِ شَىْءٌ عَظِيمٌ ", "translation": "O mankind, fear your Lord. Indeed, the convulsion of the [final] Hour is a terrible thing.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 4, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "زَلْزَلَةَ", "translit": "َẗَlَzْlَz", "root": "زلزل"}, {"id": 7, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 8, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 2, "text": "يَوْمَ تَرَوْنَهَا تَذْهَلُ كُلُّ مُرْضِعَةٍ عَمَّآ أَرْضَعَتْ وَتَضَعُ كُلُّ ذَاتِ حَمْلٍ حَمْلَهَا وَتَرَى ٱلنَّاسَ سُكَٰرَىٰ وَمَا هُم بِسُكَٰرَىٰ وَلَٰكِنَّ عَذَابَ ٱللَّهِ شَدِيدٌ ", "translation": "On the Day you see it every nursing mother will be distracted from that [child] she was nursing, and every pregnant woman will abort her pregnancy, and you will see the people [appearing] intoxicated while they are not intoxicated; but the punishment of Allāh is severe.", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تَرَوْنَهَا", "translit": "āَhَnْwَrَt", "root": "راي"}, {"id": 3, "arabic": "تَذْهَلُ", "translit": "ُlَhْhdَt", "root": "ذهل"}, {"id": 4, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 5, "arabic": "مُرْضِعَةٍ", "translit": "ٍẗَʿعِḍْrُm", "root": "رضع"}, {"id": 6, "arabic": "عَمَّآ", "translit": "ٓāَّmَʿع", "root": ""}, {"id": 7, "arabic": "أَرْضَعَتْ", "translit": "ْtَʿعَḍْrَaʾ", "root": "رضع"}, {"id": 8, "arabic": "وَتَضَعُ", "translit": "ُʿعَḍَtَw", "root": "وضع"}, {"id": 9, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 10, "arabic": "ذَاتِ", "translit": "ِtāَhd", "root": ""}, {"id": 11, "arabic": "حَمْلٍ", "translit": "ٍlْmَḥ", "root": "حمل"}, {"id": 12, "arabic": "حَمْلَهَا", "translit": "āَhَlْmَḥ", "root": "حمل"}, {"id": 13, "arabic": "وَتَرَى", "translit": "àَrَtَw", "root": "راي"}, {"id": 14, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 15, "arabic": "سُكَٰرَىٰ", "translit": "ٰàَrَٰkُs", "root": "سكر"}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 18, "arabic": "بِسُكَٰرَىٰ", "translit": "ٰàَrَٰkُsِb", "root": "سكر"}, {"id": 19, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 20, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}], "hasIhya": true}, {"ayah": 3, "text": "وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِى ٱللَّهِ بِغَيْرِ عِلْمٍ وَيَتَّبِعُ كُلَّ شَيْطَٰنٍ مَّرِيدٍ ", "translation": "And of the people is he who disputes about Allāh without knowledge and follows every rebellious devil.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يُجَٰدِلُ", "translit": "ُlِdَٰjgُy", "root": "جدل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 8, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 9, "arabic": "وَيَتَّبِعُ", "translit": "ُʿعِbَّtَyَw", "root": "تبع"}, {"id": 10, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 11, "arabic": "شَيْطَٰنٍ", "translit": "ٍnَٰṭْyَhs", "root": "شطن"}, {"id": 12, "arabic": "مَّرِيدٍ", "translit": "ٍdyِrَّm", "root": "مرد"}], "hasIhya": false}, {"ayah": 4, "text": "كُتِبَ عَلَيْهِ أَنَّهُۥ مَن تَوَلَّاهُ فَأَنَّهُۥ يُضِلُّهُۥ وَيَهْدِيهِ إِلَىٰ عَذَابِ ٱلسَّعِيرِ ", "translation": "It has been decreed for him [i.e., every devil] that whoever turns to him - he will misguide him and will lead him to the punishment of the Blaze.", "words": [{"id": 1, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 2, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 5, "arabic": "تَوَلَّاهُ", "translit": "ُhāَّlَwَt", "root": "ولي"}, {"id": 6, "arabic": "فَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَf", "root": ""}, {"id": 7, "arabic": "يُضِلُّهُۥ", "translit": "ۥُhُّlِḍُy", "root": "ضلل"}, {"id": 8, "arabic": "وَيَهْدِيهِ", "translit": "ِhyِdْhَyَw", "root": "هدي"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 11, "arabic": "ٱلسَّعِيرِ", "translit": "ِryِʿعَّslٱ", "root": "سعر"}], "hasIhya": true}, {"ayah": 5, "text": "يَٰٓأَيُّهَا ٱلنَّاسُ إِن كُنتُمْ فِى رَيْبٍ مِّنَ ٱلْبَعْثِ فَإِنَّا خَلَقْنَٰكُم مِّن تُرَابٍ ثُمَّ مِن نُّطْفَةٍ ثُمَّ مِنْ عَلَقَةٍ ثُمَّ مِن مُّضْغَةٍ مُّخَلَّقَةٍ وَغَيْرِ مُخَلَّقَةٍ لِّنُبَيِّنَ لَكُمْۚ وَنُقِرُّ فِى ٱلْأَرْحَامِ مَا نَشَآءُ إِلَىٰٓ أَجَلٍ مُّسَمًّى ثُمَّ نُخْرِجُكُمْ طِفْلًا ثُمَّ لِتَبْلُغُوٓا۟ أَشُدَّكُمْۖ وَمِنكُم مَّن يُتَوَفَّىٰ وَمِنكُم مَّن يُرَدُّ إِلَىٰٓ أَرْذَلِ ٱلْعُمُرِ لِكَيْلَا يَعْلَمَ مِنۢ بَعْدِ عِلْمٍ شَيْـًٔاۚ وَتَرَى ٱلْأَرْضَ هَامِدَةً فَإِذَآ أَنزَلْنَا عَلَيْهَا ٱلْمَآءَ ٱهْتَزَّتْ وَرَبَتْ وَأَنۢبَتَتْ مِن كُلِّ زَوْجٍۭ بَهِيجٍ ", "translation": "O people, if you should be in doubt about the Resurrection, then [consider that] indeed, We created you from dust, then from a sperm-drop, then from a clinging clot, and then from a lump of flesh, formed and unformed[1] - that We may show you.[2] And We settle in the wombs whom We will for a specified term, then We bring you out as a child, and then [We develop you] that you may reach your [time of] maturity. And among you is he who is taken in [early] death, and among you is he who is returned to the most decrepit [old] age so that he knows, after [once having] knowledge, nothing. And you see the earth barren, but when We send down upon it rain, it quivers and swells and grows [something] of every beautiful kind.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "رَيْبٍ", "translit": "ٍbْyَr", "root": "ريب"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْبَعْثِ", "translit": "ِhtْʿعَbْlٱ", "root": "بعث"}, {"id": 9, "arabic": "فَإِنَّا", "translit": "āَّnِiʾَf", "root": ""}, {"id": 10, "arabic": "خَلَقْنَٰكُم", "translit": "mُkَٰnْqَlَhk", "root": "خلق"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "تُرَابٍ", "translit": "ٍbāَrُt", "root": "ترب"}, {"id": 13, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "نُّطْفَةٍ", "translit": "ٍẗَfْṭُّn", "root": "نطف"}, {"id": 16, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 17, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 18, "arabic": "عَلَقَةٍ", "translit": "ٍẗَqَlَʿع", "root": "علق"}, {"id": 19, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 21, "arabic": "مُّضْغَةٍ", "translit": "ٍẗَغْḍُّm", "root": "مضغ"}, {"id": 22, "arabic": "مُّخَلَّقَةٍ", "translit": "ٍẗَqَّlَhkُّm", "root": "خلق"}, {"id": 23, "arabic": "وَغَيْرِ", "translit": "ِrْyَغَw", "root": "غير"}, {"id": 24, "arabic": "مُخَلَّقَةٍ", "translit": "ٍẗَqَّlَhkُm", "root": "خلق"}, {"id": 25, "arabic": "لِّنُبَيِّنَ", "translit": "َnِّyَbُnِّl", "root": "بين"}, {"id": 26, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 27, "arabic": "وَنُقِرُّ", "translit": "ُّrِqُnَw", "root": "قرر"}, {"id": 28, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 29, "arabic": "ٱلْأَرْحَامِ", "translit": "ِmāَḥْrَaʾْlٱ", "root": "رحم"}, {"id": 30, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 31, "arabic": "نَشَآءُ", "translit": "ُءٓāَhsَn", "root": "شيا"}, {"id": 32, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 33, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 34, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 35, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 36, "arabic": "نُخْرِجُكُمْ", "translit": "ْmُkُjgِrْhkُn", "root": "خرج"}, {"id": 37, "arabic": "طِفْلًا", "translit": "āًlْfِṭ", "root": "طفل"}, {"id": 38, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 39, "arabic": "لِتَبْلُغُوٓا۟", "translit": "۟āٓwُغُlْbَtِl", "root": "بلغ"}, {"id": 40, "arabic": "أَشُدَّكُمْ", "translit": "ْmُkَّdُhsَaʾ", "root": "شدد"}, {"id": 41, "arabic": "وَمِنكُم", "translit": "mُknِmَw", "root": ""}, {"id": 42, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 43, "arabic": "يُتَوَفَّىٰ", "translit": "ٰàَّfَwَtُy", "root": "وفي"}, {"id": 44, "arabic": "وَمِنكُم", "translit": "mُknِmَw", "root": ""}, {"id": 45, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 46, "arabic": "يُرَدُّ", "translit": "ُّdَrُy", "root": "ردد"}, {"id": 47, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 48, "arabic": "أَرْذَلِ", "translit": "ِlَhdْrَaʾ", "root": "رذل"}, {"id": 49, "arabic": "ٱلْعُمُرِ", "translit": "ِrُmُʿعْlٱ", "root": "عمر"}, {"id": 50, "arabic": "لِكَيْلَا", "translit": "āَlْyَkِl", "root": ""}, {"id": 51, "arabic": "يَعْلَمَ", "translit": "َmَlْʿعَy", "root": "علم"}, {"id": 52, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 53, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 54, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 55, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 56, "arabic": "وَتَرَى", "translit": "àَrَtَw", "root": "راي"}, {"id": 57, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 58, "arabic": "هَامِدَةً", "translit": "ًẗَdِmāَh", "root": "همد"}, {"id": 59, "arabic": "فَإِذَآ", "translit": "ٓāَhdِiʾَf", "root": ""}, {"id": 60, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 61, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 62, "arabic": "ٱلْمَآءَ", "translit": "َءٓāَmْlٱ", "root": "موه"}, {"id": 63, "arabic": "ٱهْتَزَّتْ", "translit": "ْtَّzَtْhٱ", "root": "هزز"}, {"id": 64, "arabic": "وَرَبَتْ", "translit": "ْtَbَrَw", "root": "ربو"}, {"id": 65, "arabic": "وَأَنۢبَتَتْ", "translit": "ْtَtَbۢnَaʾَw", "root": "نبت"}, {"id": 66, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 67, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 68, "arabic": "زَوْجٍۭ", "translit": "ٍۭjgْwَz", "root": "زوج"}, {"id": 69, "arabic": "بَهِيجٍ", "translit": "ٍjgyِhَb", "root": "بهج"}], "hasIhya": true}, {"ayah": 6, "text": "ذَٰلِكَ بِأَنَّ ٱللَّهَ هُوَ ٱلْحَقُّ وَأَنَّهُۥ يُحْىِ ٱلْمَوْتَىٰ وَأَنَّهُۥ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "That is because Allāh is the True Reality and because He gives life to the dead and because He is over all things competent", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّ", "translit": "َّnَaʾِb", "root": ""}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 5, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 6, "arabic": "وَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَw", "root": ""}, {"id": 7, "arabic": "يُحْىِ", "translit": "ِàْḥُy", "root": "حيي"}, {"id": 8, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 9, "arabic": "وَأَنَّهُۥ", "translit": "ۥُhَّnَaʾَw", "root": ""}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 7, "text": "وَأَنَّ ٱلسَّاعَةَ ءَاتِيَةٌ لَّا رَيْبَ فِيهَا وَأَنَّ ٱللَّهَ يَبْعَثُ مَن فِى ٱلْقُبُورِ ", "translation": "And [that they may know] that the Hour is coming - no doubt about it - and that Allāh will resurrect those in the graves.", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 3, "arabic": "ءَاتِيَةٌ", "translit": "ٌẗَyِtāَء", "root": "اتي"}, {"id": 4, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 5, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 6, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 7, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "يَبْعَثُ", "translit": "ُhtَʿعْbَy", "root": "بعث"}, {"id": 10, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْقُبُورِ", "translit": "ِrwُbُqْlٱ", "root": "قبر"}], "hasIhya": true}, {"ayah": 8, "text": "وَمِنَ ٱلنَّاسِ مَن يُجَٰدِلُ فِى ٱللَّهِ بِغَيْرِ عِلْمٍ وَلَا هُدًى وَلَا كِتَٰبٍ مُّنِيرٍ ", "translation": "And of the people is he who disputes about Allāh without knowledge or guidance or an enlightening book [from Him],", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يُجَٰدِلُ", "translit": "ُlِdَٰjgُy", "root": "جدل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 8, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 13, "arabic": "مُّنِيرٍ", "translit": "ٍryِnُّm", "root": "نور"}], "hasIhya": false}, {"ayah": 9, "text": "ثَانِىَ عِطْفِهِۦ لِيُضِلَّ عَن سَبِيلِ ٱللَّهِۖ لَهُۥ فِى ٱلدُّنْيَا خِزْىٌۖ وَنُذِيقُهُۥ يَوْمَ ٱلْقِيَٰمَةِ عَذَابَ ٱلْحَرِيقِ ", "translation": "Twisting his neck [in arrogance] to mislead [people] from the way of Allāh. For him in the world is disgrace, and We will make him taste on the Day of Resurrection the punishment of the Burning Fire [while it is said],", "words": [{"id": 1, "arabic": "ثَانِىَ", "translit": "َàِnāَht", "root": "ثني"}, {"id": 2, "arabic": "عِطْفِهِۦ", "translit": "ۦِhِfْṭِʿع", "root": "عطف"}, {"id": 3, "arabic": "لِيُضِلَّ", "translit": "َّlِḍُyِl", "root": "ضلل"}, {"id": 4, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 5, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 10, "arabic": "خِزْىٌ", "translit": "ٌàْzِhk", "root": "خزي"}, {"id": 11, "arabic": "وَنُذِيقُهُۥ", "translit": "ۥُhُqyِhdُnَw", "root": "ذوق"}, {"id": 12, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 13, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 14, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 15, "arabic": "ٱلْحَرِيقِ", "translit": "ِqyِrَḥْlٱ", "root": "حرق"}], "hasIhya": false}, {"ayah": 10, "text": "ذَٰلِكَ بِمَا قَدَّمَتْ يَدَاكَ وَأَنَّ ٱللَّهَ لَيْسَ بِظَلَّٰمٍ لِّلْعَبِيدِ ", "translation": "\"That is for what your hands have put forth and because Allāh is not ever unjust to [His] servants.\"", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 3, "arabic": "قَدَّمَتْ", "translit": "ْtَmَّdَq", "root": "قدم"}, {"id": 4, "arabic": "يَدَاكَ", "translit": "َkāَdَy", "root": "يدي"}, {"id": 5, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 8, "arabic": "بِظَلَّٰمٍ", "translit": "ٍmَّٰlَẓِb", "root": "ظلم"}, {"id": 9, "arabic": "لِّلْعَبِيدِ", "translit": "ِdyِbَʿعْlِّl", "root": "عبد"}], "hasIhya": false}, {"ayah": 11, "text": "وَمِنَ ٱلنَّاسِ مَن يَعْبُدُ ٱللَّهَ عَلَىٰ حَرْفٍۖ فَإِنْ أَصَابَهُۥ خَيْرٌ ٱطْمَأَنَّ بِهِۦۖ وَإِنْ أَصَابَتْهُ فِتْنَةٌ ٱنقَلَبَ عَلَىٰ وَجْهِهِۦ خَسِرَ ٱلدُّنْيَا وَٱلْءَاخِرَةَۚ ذَٰلِكَ هُوَ ٱلْخُسْرَانُ ٱلْمُبِينُ ", "translation": "And of the people is he who worships Allāh on an edge.[1] If he is touched by good, he is reassured by it; but if he is struck by trial, he turns on his face [to unbelief]. He has lost [this] world and the Hereafter. That is what is the manifest loss.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَعْبُدُ", "translit": "ُdُbْʿعَy", "root": "عبد"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "حَرْفٍ", "translit": "ٍfْrَḥ", "root": "حرف"}, {"id": 8, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 9, "arabic": "أَصَابَهُۥ", "translit": "ۥُhَbāَṣَaʾ", "root": "صوب"}, {"id": 10, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 11, "arabic": "ٱطْمَأَنَّ", "translit": "َّnَaʾَmْṭٱ", "root": "طمان"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 14, "arabic": "أَصَابَتْهُ", "translit": "ُhْtَbāَṣَaʾ", "root": "صوب"}, {"id": 15, "arabic": "فِتْنَةٌ", "translit": "ٌẗَnْtِf", "root": "فتن"}, {"id": 16, "arabic": "ٱنقَلَبَ", "translit": "َbَlَqnٱ", "root": "قلب"}, {"id": 17, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 18, "arabic": "وَجْهِهِۦ", "translit": "ۦِhِhْjgَw", "root": "وجه"}, {"id": 19, "arabic": "خَسِرَ", "translit": "َrِsَhk", "root": "خسر"}, {"id": 20, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 21, "arabic": "وَٱلْءَاخِرَةَ", "translit": "َẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 22, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 23, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 24, "arabic": "ٱلْخُسْرَانُ", "translit": "ُnāَrْsُhkْlٱ", "root": "خسر"}, {"id": 25, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": true}, {"ayah": 12, "text": "يَدْعُوا۟ مِن دُونِ ٱللَّهِ مَا لَا يَضُرُّهُۥ وَمَا لَا يَنفَعُهُۥۚ ذَٰلِكَ هُوَ ٱلضَّلَٰلُ ٱلْبَعِيدُ ", "translation": "He invokes instead of Allāh that which neither harms him nor benefits him. That is what is the extreme error.", "words": [{"id": 1, "arabic": "يَدْعُوا۟", "translit": "۟āwُʿعْdَy", "root": "دعو"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَضُرُّهُۥ", "translit": "ۥُhُّrُḍَy", "root": "ضرر"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَنفَعُهُۥ", "translit": "ۥُhُʿعَfnَy", "root": "نفع"}, {"id": 11, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 12, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 13, "arabic": "ٱلضَّلَٰلُ", "translit": "ُlَٰlَّḍlٱ", "root": "ضلل"}, {"id": 14, "arabic": "ٱلْبَعِيدُ", "translit": "ُdyِʿعَbْlٱ", "root": "بعد"}], "hasIhya": false}, {"ayah": 13, "text": "يَدْعُوا۟ لَمَن ضَرُّهُۥٓ أَقْرَبُ مِن نَّفْعِهِۦۚ لَبِئْسَ ٱلْمَوْلَىٰ وَلَبِئْسَ ٱلْعَشِيرُ ", "translation": "He invokes one whose harm is closer than his benefit - how wretched the protector and how wretched the associate.", "words": [{"id": 1, "arabic": "يَدْعُوا۟", "translit": "۟āwُʿعْdَy", "root": "دعو"}, {"id": 2, "arabic": "لَمَن", "translit": "nَmَl", "root": ""}, {"id": 3, "arabic": "ضَرُّهُۥٓ", "translit": "ٓۥُhُّrَḍ", "root": "ضرر"}, {"id": 4, "arabic": "أَقْرَبُ", "translit": "ُbَrْqَaʾ", "root": "قرب"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "نَّفْعِهِۦ", "translit": "ۦِhِʿعْfَّn", "root": "نفع"}, {"id": 7, "arabic": "لَبِئْسَ", "translit": "َsْyʾِbَl", "root": "باس"}, {"id": 8, "arabic": "ٱلْمَوْلَىٰ", "translit": "ٰàَlْwَmْlٱ", "root": "ولي"}, {"id": 9, "arabic": "وَلَبِئْسَ", "translit": "َsْyʾِbَlَw", "root": "باس"}, {"id": 10, "arabic": "ٱلْعَشِيرُ", "translit": "ُryِhsَʿعْlٱ", "root": "عشر"}], "hasIhya": true}, {"ayah": 14, "text": "إِنَّ ٱللَّهَ يُدْخِلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۚ إِنَّ ٱللَّهَ يَفْعَلُ مَا يُرِيدُ ", "translation": "Indeed, Allāh will admit those who believe and do righteous deeds to gardens beneath which rivers flow. Indeed, Allāh does what He intends.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "يُدْخِلُ", "translit": "ُlِhkْdُy", "root": "دخل"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 7, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 8, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 9, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 12, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "يَفْعَلُ", "translit": "ُlَʿعْfَy", "root": "فعل"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}], "hasIhya": false}, {"ayah": 15, "text": "مَن كَانَ يَظُنُّ أَن لَّن يَنصُرَهُ ٱللَّهُ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِ فَلْيَمْدُدْ بِسَبَبٍ إِلَى ٱلسَّمَآءِ ثُمَّ لْيَقْطَعْ فَلْيَنظُرْ هَلْ يُذْهِبَنَّ كَيْدُهُۥ مَا يَغِيظُ ", "translation": "Whoever should think that Allāh will not support him [i.e., Prophet Muḥammad (ﷺ)] in this world and the Hereafter - let him extend a rope to the ceiling, then cut off [his breath],[1] and let him see: will his effort remove that which enrages [him]?", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "يَظُنُّ", "translit": "ُّnُẓَy", "root": "ظنن"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 6, "arabic": "يَنصُرَهُ", "translit": "ُhَrُṣnَy", "root": "نصر"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 10, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 11, "arabic": "فَلْيَمْدُدْ", "translit": "ْdُdْmَyْlَf", "root": "مدد"}, {"id": 12, "arabic": "بِسَبَبٍ", "translit": "ٍbَbَsِb", "root": "سبب"}, {"id": 13, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 14, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 15, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 16, "arabic": "لْيَقْطَعْ", "translit": "ْʿعَṭْqَyْl", "root": "قطع"}, {"id": 17, "arabic": "فَلْيَنظُرْ", "translit": "ْrُẓnَyْlَf", "root": "نظر"}, {"id": 18, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 19, "arabic": "يُذْهِبَنَّ", "translit": "َّnَbِhْhdُy", "root": "ذهب"}, {"id": 20, "arabic": "كَيْدُهُۥ", "translit": "ۥُhُdْyَk", "root": "كيد"}, {"id": 21, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 22, "arabic": "يَغِيظُ", "translit": "ُẓyِغَy", "root": "غيظ"}], "hasIhya": true}, {"ayah": 16, "text": "وَكَذَٰلِكَ أَنزَلْنَٰهُ ءَايَٰتٍۭ بَيِّنَٰتٍ وَأَنَّ ٱللَّهَ يَهْدِى مَن يُرِيدُ ", "translation": "And thus have We sent it [i.e., the Qur’ān] down as verses of clear evidence and because Allāh guides whom He intends.", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَٰهُ", "translit": "ُhَٰnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "ءَايَٰتٍۭ", "translit": "ٍۭtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 5, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 8, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 9, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}], "hasIhya": false}, {"ayah": 17, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ هَادُوا۟ وَٱلصَّٰبِـِٔينَ وَٱلنَّصَٰرَىٰ وَٱلْمَجُوسَ وَٱلَّذِينَ أَشْرَكُوٓا۟ إِنَّ ٱللَّهَ يَفْصِلُ بَيْنَهُمْ يَوْمَ ٱلْقِيَٰمَةِۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ ", "translation": "Indeed, those who have believed and those who were Jews and the Sabeans and the Christians and the Magians and those who associated with Allāh - Allāh will judge between them on the Day of Resurrection. Indeed Allāh is, over all things, Witness.[1]", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 6, "arabic": "وَٱلصَّٰبِـِٔينَ", "translit": "َnyِٔـِbَّٰṣlٱَw", "root": "صبا"}, {"id": 7, "arabic": "وَٱلنَّصَٰرَىٰ", "translit": "ٰàَrَٰṣَّnlٱَw", "root": "نصر"}, {"id": 8, "arabic": "وَٱلْمَجُوسَ", "translit": "َswُjgَmْlٱَw", "root": "مجس"}, {"id": 9, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 10, "arabic": "أَشْرَكُوٓا۟", "translit": "۟āٓwُkَrْhsَaʾ", "root": "شرك"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "يَفْصِلُ", "translit": "ُlِṣْfَy", "root": "فصل"}, {"id": 14, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 15, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 16, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 17, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 18, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 20, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 21, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 22, "arabic": "شَهِيدٌ", "translit": "ٌdyِhَhs", "root": "شهد"}], "hasIhya": false}, {"ayah": 18, "text": "أَلَمْ تَرَ أَنَّ ٱللَّهَ يَسْجُدُ لَهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَمَن فِى ٱلْأَرْضِ وَٱلشَّمْسُ وَٱلْقَمَرُ وَٱلنُّجُومُ وَٱلْجِبَالُ وَٱلشَّجَرُ وَٱلدَّوَآبُّ وَكَثِيرٌ مِّنَ ٱلنَّاسِۖ وَكَثِيرٌ حَقَّ عَلَيْهِ ٱلْعَذَابُۗ وَمَن يُهِنِ ٱللَّهُ فَمَا لَهُۥ مِن مُّكْرِمٍۚ إِنَّ ٱللَّهَ يَفْعَلُ مَا يَشَآءُ۩ ", "translation": "Do you not see [i.e., know] that to Allāh prostrates whoever is in the heavens and whoever is on the earth and the sun, the moon, the stars, the mountains, the trees, the moving creatures and many of the people? But upon many the punishment has been justified.[1] And he whom Allāh humiliates - for him there is no bestower of honor. Indeed, Allāh does what He wills.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "يَسْجُدُ", "translit": "ُdُjgْsَy", "root": "سجد"}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 10, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 13, "arabic": "وَٱلشَّمْسُ", "translit": "ُsْmَّhslٱَw", "root": "شمس"}, {"id": 14, "arabic": "وَٱلْقَمَرُ", "translit": "ُrَmَqْlٱَw", "root": "قمر"}, {"id": 15, "arabic": "وَٱلنُّجُومُ", "translit": "ُmwُjgُّnlٱَw", "root": "نجم"}, {"id": 16, "arabic": "وَٱلْجِبَالُ", "translit": "ُlāَbِjgْlٱَw", "root": "جبل"}, {"id": 17, "arabic": "وَٱلشَّجَرُ", "translit": "ُrَjgَّhslٱَw", "root": "شجر"}, {"id": 18, "arabic": "وَٱلدَّوَآبُّ", "translit": "ُّbٓāَwَّdlٱَw", "root": "دبب"}, {"id": 19, "arabic": "وَكَثِيرٌ", "translit": "ٌryِhtَkَw", "root": "كثر"}, {"id": 20, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 21, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 22, "arabic": "وَكَثِيرٌ", "translit": "ٌryِhtَkَw", "root": "كثر"}, {"id": 23, "arabic": "حَقَّ", "translit": "َّqَḥ", "root": "حقق"}, {"id": 24, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 25, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 26, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 27, "arabic": "يُهِنِ", "translit": "ِnِhُy", "root": "هون"}, {"id": 28, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 30, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 31, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 32, "arabic": "مُّكْرِمٍ", "translit": "ٍmِrْkُّm", "root": "كرم"}, {"id": 33, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 34, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 35, "arabic": "يَفْعَلُ", "translit": "ُlَʿعْfَy", "root": "فعل"}, {"id": 36, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 37, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}], "hasIhya": true}, {"ayah": 19, "text": "هَٰذَانِ خَصْمَانِ ٱخْتَصَمُوا۟ فِى رَبِّهِمْۖ فَٱلَّذِينَ كَفَرُوا۟ قُطِّعَتْ لَهُمْ ثِيَابٌ مِّن نَّارٍ يُصَبُّ مِن فَوْقِ رُءُوسِهِمُ ٱلْحَمِيمُ ", "translation": "These[1] are two adversaries who have disputed over their Lord. But those who disbelieved will have cut out for them garments of fire. Poured upon their heads will be scalding water", "words": [{"id": 1, "arabic": "هَٰذَانِ", "translit": "ِnāَhdَٰh", "root": ""}, {"id": 2, "arabic": "خَصْمَانِ", "translit": "ِnāَmْṣَhk", "root": "خصم"}, {"id": 3, "arabic": "ٱخْتَصَمُوا۟", "translit": "۟āwُmَṣَtْhkٱ", "root": "خصم"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 6, "arabic": "فَٱلَّذِينَ", "translit": "َnyِhdَّlٱَf", "root": ""}, {"id": 7, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 8, "arabic": "قُطِّعَتْ", "translit": "ْtَʿعِّṭُq", "root": "قطع"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "ثِيَابٌ", "translit": "ٌbāَyِht", "root": "ثوب"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "نَّارٍ", "translit": "ٍrāَّn", "root": "نور"}, {"id": 13, "arabic": "يُصَبُّ", "translit": "ُّbَṣُy", "root": "صبب"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "فَوْقِ", "translit": "ِqْwَf", "root": "فوق"}, {"id": 16, "arabic": "رُءُوسِهِمُ", "translit": "ُmِhِswُءُr", "root": "راس"}, {"id": 17, "arabic": "ٱلْحَمِيمُ", "translit": "ُmyِmَḥْlٱ", "root": "حمم"}], "hasIhya": true}, {"ayah": 20, "text": "يُصْهَرُ بِهِۦ مَا فِى بُطُونِهِمْ وَٱلْجُلُودُ ", "translation": "By which is melted that within their bellies and [their] skins.", "words": [{"id": 1, "arabic": "يُصْهَرُ", "translit": "ُrَhْṣُy", "root": "صهر"}, {"id": 2, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "بُطُونِهِمْ", "translit": "ْmِhِnwُṭُb", "root": "بطن"}, {"id": 6, "arabic": "وَٱلْجُلُودُ", "translit": "ُdwُlُjgْlٱَw", "root": "جلد"}], "hasIhya": false}, {"ayah": 21, "text": "وَلَهُم مَّقَٰمِعُ مِنْ حَدِيدٍ ", "translation": "And for [striking] them are maces of iron.", "words": [{"id": 1, "arabic": "وَلَهُم", "translit": "mُhَlَw", "root": ""}, {"id": 2, "arabic": "مَّقَٰمِعُ", "translit": "ُʿعِmَٰqَّm", "root": "قمع"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "حَدِيدٍ", "translit": "ٍdyِdَḥ", "root": "حدد"}], "hasIhya": false}, {"ayah": 22, "text": "كُلَّمَآ أَرَادُوٓا۟ أَن يَخْرُجُوا۟ مِنْهَا مِنْ غَمٍّ أُعِيدُوا۟ فِيهَا وَذُوقُوا۟ عَذَابَ ٱلْحَرِيقِ ", "translation": "Every time they want to get out of it [i.e., Hellfire] from anguish, they will be returned to it, and [it will be said], \"Taste the punishment of the Burning Fire!\"", "words": [{"id": 1, "arabic": "كُلَّمَآ", "translit": "ٓāَmَّlُk", "root": "كلل"}, {"id": 2, "arabic": "أَرَادُوٓا۟", "translit": "۟āٓwُdāَrَaʾ", "root": "رود"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يَخْرُجُوا۟", "translit": "۟āwُjgُrْhkَy", "root": "خرج"}, {"id": 5, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "غَمٍّ", "translit": "ٍّmَغ", "root": "غمم"}, {"id": 8, "arabic": "أُعِيدُوا۟", "translit": "۟āwُdyِʿعُaʾ", "root": "عود"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "وَذُوقُوا۟", "translit": "۟āwُqwُhdَw", "root": "ذوق"}, {"id": 11, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "ٱلْحَرِيقِ", "translit": "ِqyِrَḥْlٱ", "root": "حرق"}], "hasIhya": false}, {"ayah": 23, "text": "إِنَّ ٱللَّهَ يُدْخِلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِن ذَهَبٍ وَلُؤْلُؤًاۖ وَلِبَاسُهُمْ فِيهَا حَرِيرٌ ", "translation": "Indeed, Allāh will admit those who believe and do righteous deeds to gardens beneath which rivers flow. They will be adorned therein with bracelets of gold and pearl, and their garments therein will be silk.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "يُدْخِلُ", "translit": "ُlِhkْdُy", "root": "دخل"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 7, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 8, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 9, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 12, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 13, "arabic": "يُحَلَّوْنَ", "translit": "َnْwَّlَḥُy", "root": "حلي"}, {"id": 14, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "أَسَاوِرَ", "translit": "َrِwāَsَaʾ", "root": "سور"}, {"id": 17, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 18, "arabic": "ذَهَبٍ", "translit": "ٍbَhَhd", "root": "ذهب"}, {"id": 19, "arabic": "وَلُؤْلُؤًا", "translit": "āًwʾُlْwʾُlَw", "root": "لؤلؤ"}, {"id": 20, "arabic": "وَلِبَاسُهُمْ", "translit": "ْmُhُsāَbِlَw", "root": "لبس"}, {"id": 21, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 22, "arabic": "حَرِيرٌ", "translit": "ٌryِrَḥ", "root": "حرر"}], "hasIhya": true}, {"ayah": 24, "text": "وَهُدُوٓا۟ إِلَى ٱلطَّيِّبِ مِنَ ٱلْقَوْلِ وَهُدُوٓا۟ إِلَىٰ صِرَٰطِ ٱلْحَمِيدِ ", "translation": "And they had been guided [in worldly life] to good speech, and they were guided to the path of the Praiseworthy.", "words": [{"id": 1, "arabic": "وَهُدُوٓا۟", "translit": "۟āٓwُdُhَw", "root": "هدي"}, {"id": 2, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلطَّيِّبِ", "translit": "ِbِّyَّṭlٱ", "root": "طيب"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْقَوْلِ", "translit": "ِlْwَqْlٱ", "root": "قول"}, {"id": 6, "arabic": "وَهُدُوٓا۟", "translit": "۟āٓwُdُhَw", "root": "هدي"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "صِرَٰطِ", "translit": "ِṭَٰrِṣ", "root": "صرط"}, {"id": 9, "arabic": "ٱلْحَمِيدِ", "translit": "ِdyِmَḥْlٱ", "root": "حمد"}], "hasIhya": false}, {"ayah": 25, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِ وَٱلْمَسْجِدِ ٱلْحَرَامِ ٱلَّذِى جَعَلْنَٰهُ لِلنَّاسِ سَوَآءً ٱلْعَٰكِفُ فِيهِ وَٱلْبَادِۚ وَمَن يُرِدْ فِيهِ بِإِلْحَادٍۭ بِظُلْمٍ نُّذِقْهُ مِنْ عَذَابٍ أَلِيمٍ ", "translation": "Indeed, those who have disbelieved and avert [people] from the way of Allāh and [from] al-Masjid al-Ḥarām, which We made for the people - equal are the resident therein and one from outside - and [also] whoever intends [a deed] therein[1] of deviation [in religion] by wrongdoing - We will make him taste of a painful punishment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "وَيَصُدُّونَ", "translit": "َnwُّdُṣَyَw", "root": "صدد"}, {"id": 5, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱَw", "root": "سجد"}, {"id": 9, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 10, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "جَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjg", "root": "جعل"}, {"id": 12, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 13, "arabic": "سَوَآءً", "translit": "ًءٓāَwَs", "root": "سوي"}, {"id": 14, "arabic": "ٱلْعَٰكِفُ", "translit": "ُfِkَٰʿعْlٱ", "root": "عكف"}, {"id": 15, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 16, "arabic": "وَٱلْبَادِ", "translit": "ِdāَbْlٱَw", "root": "بدو"}, {"id": 17, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 18, "arabic": "يُرِدْ", "translit": "ْdِrُy", "root": "رود"}, {"id": 19, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 20, "arabic": "بِإِلْحَادٍۭ", "translit": "ٍۭdāَḥْlِiʾِb", "root": "لحد"}, {"id": 21, "arabic": "بِظُلْمٍ", "translit": "ٍmْlُẓِb", "root": "ظلم"}, {"id": 22, "arabic": "نُّذِقْهُ", "translit": "ُhْqِhdُّn", "root": "ذوق"}, {"id": 23, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 24, "arabic": "عَذَابٍ", "translit": "ٍbāَhdَʿع", "root": "عذب"}, {"id": 25, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 26, "text": "وَإِذْ بَوَّأْنَا لِإِبْرَٰهِيمَ مَكَانَ ٱلْبَيْتِ أَن لَّا تُشْرِكْ بِى شَيْـًٔا وَطَهِّرْ بَيْتِىَ لِلطَّآئِفِينَ وَٱلْقَآئِمِينَ وَٱلرُّكَّعِ ٱلسُّجُودِ ", "translation": "And [mention, O Muḥammad], when We designated for Abraham the site of the House, [saying], \"Do not associate anything with Me and purify My House for those who perform ṭawāf[1] and those who stand [in prayer] and those who bow and prostrate.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "بَوَّأْنَا", "translit": "āَnْaʾَّwَb", "root": "بوا"}, {"id": 3, "arabic": "لِإِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾِl", "root": ""}, {"id": 4, "arabic": "مَكَانَ", "translit": "َnā