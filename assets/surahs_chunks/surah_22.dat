: "warsh"}, {"surah": 22, "ayah": 74, "text": "مَا قَدَرُواْ اُ۬للَّهَ حَقَّ قَدْرِهِۦٓۖ إِنَّ اَ۬للَّهَ لَقَوِيٌّ عَزِيزٌۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "قَدَرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَقَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَدْرِهِۦٓۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَقَوِيٌّ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَزِيزٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 75, "text": "اِ۬للَّهُ يَصْطَفِے مِنَ اَ۬لْمَلَٰٓئِكَةِ رُسُلاࣰ وَمِنَ اَ۬لنَّاسِۖ إِنَّ اَ۬للَّهَ سَمِيعُۢ بَصِيرࣱۖ", "words": [{"id": 1, "arabic": "اِ۬للَّهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصْطَفِے", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَلَٰٓئِكَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "رُسُلاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لنَّاسِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 10, "arabic": "سَمِيعُۢ", "translit": "", "root": ""}, {"id": 11, "arabic": "بَصِيرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 76, "text": "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْۖ وَإِلَي اَ۬للَّهِ تُرْجَعُ اُ۬لُامُورُۖ", "words": [{"id": 1, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بَيْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَيْدِيهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "خَلْفَهُمْۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَإِلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "تُرْجَعُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لُامُورُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 77, "text": "يَٰٓأَيُّهَا اَ۬لذِينَ ءَامَنُواْ اُ۪رْكَعُواْ وَاسْجُدُواْ وَاعْبُدُواْ رَبَّكُمْ وَافْعَلُواْ اُ۬لْخَيْرَ لَعَلَّكُمْ تُفْلِحُونَۖ", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۪رْكَعُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاسْجُدُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَاعْبُدُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَبَّكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَافْعَلُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لْخَيْرَ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَعَلَّكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "تُفْلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 78, "text": "وَجَٰهِدُواْ فِے اِ۬للَّهِ حَقَّ جِهَادِهِۦۖ هُوَ اَ۪جْتَب۪يٰكُمْۖ وَمَا جَعَلَ عَلَيْكُمْ فِے اِ۬لدِّينِ مِنْ حَرَجࣲۖ مِّلَّةَ أَبِيكُمُۥٓ إِبْرَٰهِيمَۖ هُوَ سَمّ۪يٰكُمُ اُ۬لْمُسْلِمِينَ مِن قَبْلُ وَفِے هَٰذَا لِيَكُونَ اَ۬لرَّسُولُ شَهِيداً عَلَيْكُمْ وَتَكُونُواْ شُهَدَآءَ عَلَي اَ۬لنَّاسِۖ فَأَقِيمُواْ اُ۬لصَّلَوٰةَ وَءَاتُواْ اُ۬لزَّكَوٰةَۖ وَاعْتَصِمُواْ بِاللَّهِۖ هُوَ مَوْل۪يٰكُمْۖ فَنِعْمَ اَ۬لْمَوْل۪يٰۖ وَنِعْمَ اَ۬لنَّصِيرُۖ", "words": [{"id": 1, "arabic": "وَجَٰهِدُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَقَّ", "translit": "", "root": ""}, {"id": 5, "ara