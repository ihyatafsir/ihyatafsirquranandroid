n": "warsh"}, {"surah": 22, "ayah": 44, "text": "وَأَصْحَٰبُ مَدْيَنَۖ وَكُذِّبَ مُوس۪يٰۖ فَأَمْلَيْتُ لِلْكٰ۪فِرِينَ ثُمَّ أَخَذتُّهُمْۖ فَكَيْفَ كَانَ نَكِيرِۦۖ", "words": [{"id": 1, "arabic": "وَأَصْحَٰبُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَدْيَنَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَكُذِّبَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُوس۪يٰۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَمْلَيْتُ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِلْكٰ۪فِرِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَخَذتُّهُمْۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَكَيْفَ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 11, "arabic": "نَكِيرِۦۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 45, "text": "فَكَأَيِّن مِّن قَرْيَةٍ اَهْلَكْنَٰهَا وَهِيَ ظَالِمَةࣱ فَهِيَ خَاوِيَةٌ عَلَيٰ عُرُوشِهَا وَبِيرࣲ مُّعَطَّلَةࣲ وَقَصْرࣲ مَّشِيدٍۖ", "words": [{"id": 1, "arabic": "فَكَأَيِّن", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "قَرْيَةٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَهْلَكْنَٰهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "وَهِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "ظَالِمَةࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَهِيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "خَاوِيَةٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "عُرُوشِهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "وَبِيرࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "مُّعَطَّلَةࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَقَصْرࣲ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَّشِيدٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 22, "ayah": 46, "text": "اَ