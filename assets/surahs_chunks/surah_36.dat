ّاࣰ كَثِيراًۖ اَفَلَمْ تَكُونُواْ تَعْقِلُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَضَلَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "جِبِلّاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَثِيراًۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَفَلَمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَكُونُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "تَعْقِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 63, "text": "هَٰذِهِۦ جَهَنَّمُ اُ۬لتِے كُنتُمْ تُوعَدُونَ", "words": [{"id": 1, "arabic": "هَٰذِهِۦ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَهَنَّمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لتِے", "translit": "", "root": ""}, {"id": 4, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "تُوعَدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 64, "text": "اَ۪صْلَوْهَا اَ۬لْيَوْمَ بِمَا كُنتُمْ تَكْفُرُونَۖ", "words": [{"id": 1, "arabic": "اَ۪صْلَوْهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْيَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَكْفُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 65, "text": "اَ۬لْيَوْمَ نَخْتِمُ عَلَيٰٓ أَفْوَٰهِهِمْ وَتُكَلِّمُنَآ أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُهُم بِمَا كَانُواْ يَكْسِبُونَۖ", "words": [{"id": 1, "arabic": "اَ۬لْيَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَخْتِمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَفْوَٰهِهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَتُكَلِّمُنَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَيْدِيهِمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَتَشْهَدُ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَرْجُلُهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَكْسِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 66, "text": "وَلَوْ نَشَآءُ لَطَمَسْنَا عَلَيٰٓ أَعْيُنِهِمْ فَاسْتَبَقُواْ اُ۬لصِّرَٰطَ فَأَنّ۪يٰ يُبْصِرُونَۖ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَشَآءُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَطَمَسْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَعْيُنِهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَاسْتَبَقُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لصِّرَٰطَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَأَنّ۪يٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 67, "text": "وَلَوْ نَشَآءُ لَمَسَخْنَٰهُمْ عَلَيٰ مَكَانَتِهِمْ فَمَا اَ۪سْتَطَٰعُواْ مُضِيّاࣰ وَلَا يَرْجِعُونَۖ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَشَآءُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَمَسَخْنَٰهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَكَانَتِهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۪سْتَطَٰعُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُضِيّاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَرْجِعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 68, "text": "وَمَن نُّعَمِّرْهُ نَنكُسْهُ فِے اِ۬لْخَلْقِۖ أَفَلَا تَعْقِلُونَۖ", "words": [{"id": 1, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 2, "arabic": "نُّعَمِّرْهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَنكُسْهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْخَلْقِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تَعْقِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 69, "text": "وَمَا عَلَّمْنَٰهُ اُ۬لشِّعْرَ وَمَا يَنۢبَغِے لَهُۥٓۖ إِنْ هُوَ إِلَّا ذِكْرࣱ وَقُرْءَانࣱ مُّبِينࣱ‏", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَّمْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لشِّعْرَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَنۢبَغِے", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُۥٓۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "ذِكْرࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَقُرْءَانࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "مُّبِينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 70, "text": "لِّتُنذِرَ مَن كَانَ حَيّاࣰ وَيَحِقَّ اَ۬لْقَوْلُ عَلَي اَ۬لْكٰ۪فِرِينَۖ", "words": [{"id": 1, "arabic": "لِّتُنذِرَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَيّاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَحِقَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْقَوْلُ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْكٰ۪فِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 71, "text": "أَوَلَمْ يَرَوَاْ اَنَّا خَلَقْنَا لَهُم مِّمَّا عَمِلَتَ اَيْدِينَآ أَنْعَٰماࣰ فَهُمْ لَهَا مَٰلِكُونَۖ", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّمَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "عَمِلَتَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَيْدِينَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَنْعَٰماࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 12, "arabic": "مَٰلِكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 72, "text": "وَذَلَّلْنَٰهَا لَهُمْ فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا يَاكُلُونَۖ", "words": [{"id": 1, "arabic": "وَذَلَّلْنَٰهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَمِنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "رَكُوبُهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَاكُلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 73, "text": "وَلَهُمْ فِيهَا مَنَٰفِعُ وَمَشَارِبُۖ أَفَلَا يَشْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَلَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَنَٰفِعُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَشَارِبُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَشْكُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 74, "text": "وَاتَّخَذُواْ مِن دُونِ اِ۬للَّهِ ءَالِهَةࣰ لَّعَلَ