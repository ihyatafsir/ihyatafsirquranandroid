{"surah": 36, "verses": [{"ayah": 1, "text": "يسٓ ", "translation": "Yā, Seen.[1]", "words": [{"id": 1, "arabic": "يسٓ", "translit": "ٓsy", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "وَٱلْقُرْءَانِ ٱلْحَكِيمِ ", "translation": "By the wise[1] Qur’ān,", "words": [{"id": 1, "arabic": "وَٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱَw", "root": "قرا"}, {"id": 2, "arabic": "ٱلْحَكِيمِ", "translit": "ِmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 3, "text": "إِنَّكَ لَمِنَ ٱلْمُرْسَلِينَ ", "translation": "Indeed you, [O Muḥammad], are from among the messengers,", "words": [{"id": 1, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 3, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 4, "text": "عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "On a straight path.", "words": [{"id": 1, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 2, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 3, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 5, "text": "تَنزِيلَ ٱلْعَزِيزِ ٱلرَّحِيمِ ", "translation": "[This is] a revelation of the Exalted in Might, the Merciful,", "words": [{"id": 1, "arabic": "تَنزِيلَ", "translit": "َlyِznَt", "root": "نزل"}, {"id": 2, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 3, "arabic": "ٱلرَّحِيمِ", "translit": "ِmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 6, "text": "لِتُنذِرَ قَوْمًا مَّآ أُنذِرَ ءَابَآؤُهُمْ فَهُمْ غَٰفِلُونَ ", "translation": "That you may warn a people whose forefathers were not warned, so they are unaware.", "words": [{"id": 1, "arabic": "لِتُنذِرَ", "translit": "َrِhdnُtِl", "root": "نذر"}, {"id": 2, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 3, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 4, "arabic": "أُنذِرَ", "translit": "َrِhdnُaʾ", "root": "نذر"}, {"id": 5, "arabic": "ءَابَآؤُهُمْ", "translit": "ْmُhُwʾٓāَbāَء", "root": "ابو"}, {"id": 6, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 7, "arabic": "غَٰفِلُونَ", "translit": "َnwُlِfَٰغ", "root": "غفل"}], "hasIhya": false}, {"ayah": 7, "text": "لَقَدْ حَقَّ ٱلْقَوْلُ عَلَىٰٓ أَكْثَرِهِمْ فَهُمْ لَا يُؤْمِنُونَ ", "translation": "Already the word [i.e., decree] has come into effect upon most of them, so they do not believe.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "حَقَّ", "translit": "َّqَḥ", "root": "حقق"}, {"id": 3, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 4, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 5, "arabic": "أَكْثَرِهِمْ", "translit": "ْmِhِrَhtْkَaʾ", "root": "كثر"}, {"id": 6, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": true}, {"ayah": 8, "text": "إِنَّا جَعَلْنَا فِىٓ أَعْنَٰقِهِمْ أَغْلَٰلًا فَهِىَ إِلَى ٱلْأَذْقَانِ فَهُم مُّقْمَحُونَ ", "translation": "Indeed, We have put shackles on their necks, and they are to their chins, so they are with heads [kept] aloft.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "أَعْنَٰقِهِمْ", "translit": "ْmِhِqَٰnْʿعَaʾ", "root": "عنق"}, {"id": 5, "arabic": "أَغْلَٰلًا", "translit": "āًlَٰlْغَaʾ", "root": "غلل"}, {"id": 6, "arabic": "فَهِىَ", "translit": "َàِhَf", "root": ""}, {"id": 7, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلْأَذْقَانِ", "translit": "ِnāَqْhdَaʾْlٱ", "root": "ذقن"}, {"id": 9, "arabic": "فَهُم", "translit": "mُhَf", "root": ""}, {"id": 10, "arabic": "مُّقْمَحُونَ", "translit": "َnwُḥَmْqُّm", "root": "قمح"}], "hasIhya": true}, {"ayah": 9, "text": "وَجَعَلْنَا مِنۢ بَيْنِ أَيْدِيهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا فَأَغْشَيْنَٰهُمْ فَهُمْ لَا يُبْصِرُونَ ", "translation": "And We have put before them a barrier and behind them a barrier and covered them, so they do not see.", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 3, "arabic": "بَيْنِ", "translit": "ِnْyَb", "root": "بين"}, {"id": 4, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 5, "arabic": "سَدًّا", "translit": "āًّdَs", "root": "سدد"}, {"id": 6, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 7, "arabic": "خَلْفِهِمْ", "translit": "ْmِhِfْlَhk", "root": "خلف"}, {"id": 8, "arabic": "سَدًّا", "translit": "āًّdَs", "root": "سدد"}, {"id": 9, "arabic": "فَأَغْشَيْنَٰهُمْ", "translit": "ْmُhَٰnْyَhsْغَaʾَf", "root": "غشو"}, {"id": 10, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}], "hasIhya": true}, {"ayah": 10, "text": "وَسَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ ", "translation": "And it is all the same for them whether you warn them or do not warn them - they will not believe.", "words": [{"id": 1, "arabic": "وَسَوَآءٌ", "translit": "ٌءٓāَwَsَw", "root": "سوي"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ءَأَنذَرْتَهُمْ", "translit": "ْmُhَtْrَhdnَaʾَء", "root": "نذر"}, {"id": 4, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 5, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 6, "arabic": "تُنذِرْهُمْ", "translit": "ْmُhْrِhdnُt", "root": "نذر"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": true}, {"ayah": 11, "text": "إِنَّمَا تُنذِرُ مَنِ ٱتَّبَعَ ٱلذِّكْرَ وَخَشِىَ ٱلرَّحْمَٰنَ بِٱلْغَيْبِۖ فَبَشِّرْهُ بِمَغْفِرَةٍ وَأَجْرٍ كَرِيمٍ ", "translation": "You can only warn one who follows the message and fears the Most Merciful unseen. So give him good tidings of forgiveness and noble reward.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "تُنذِرُ", "translit": "ُrِhdnُt", "root": "نذر"}, {"id": 3, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 4, "arabic": "ٱتَّبَعَ", "translit": "َʿعَbَّtٱ", "root": "تبع"}, {"id": 5, "arabic": "ٱلذِّكْرَ", "translit": "َrْkِّhdlٱ", "root": "ذكر"}, {"id": 6, "arabic": "وَخَشِىَ", "translit": "َàِhsَhkَw", "root": "خشي"}, {"id": 7, "arabic": "ٱلرَّحْمَٰنَ", "translit": "َnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 8, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 9, "arabic": "فَبَشِّرْهُ", "translit": "ُhْrِّhsَbَf", "root": "بشر"}, {"id": 10, "arabic": "بِمَغْفِرَةٍ", "translit": "ٍẗَrِfْغَmِb", "root": "غفر"}, {"id": 11, "arabic": "وَأَجْرٍ", "translit": "ٍrْjgَaʾَw", "root": "اجر"}, {"id": 12, "arabic": "كَرِيمٍ", "translit": "ٍmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 12, "text": "إِنَّا نَحْنُ نُحْىِ ٱلْمَوْتَىٰ وَنَكْتُبُ مَا قَدَّمُوا۟ وَءَاثَٰرَهُمْۚ وَكُلَّ شَىْءٍ أَحْصَيْنَٰهُ فِىٓ إِمَامٍ مُّبِينٍ ", "translation": "Indeed, it is We who bring the dead to life and record what they have put forth and what they left behind, and all things We have enumerated in a clear register.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 3, "arabic": "نُحْىِ", "translit": "ِàْḥُn", "root": "حيي"}, {"id": 4, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَنَكْتُبُ", "translit": "ُbُtْkَnَw", "root": "كتب"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "قَدَّمُوا۟", "translit": "۟āwُmَّdَq", "root": "قدم"}, {"id": 8, "arabic": "وَءَاثَٰرَهُمْ", "translit": "ْmُhَrَٰhtāَءَw", "root": "اثر"}, {"id": 9, "arabic": "وَكُلَّ", "translit": "َّlُkَw", "root": "كلل"}, {"id": 10, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 11, "arabic": "أَحْصَيْنَٰهُ", "translit": "ُhَٰnْyَṣْḥَaʾ", "root": "حصي"}, {"id": 12, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 13, "arabic": "إِمَامٍ", "translit": "ٍmāَmِiʾ", "root": "امم"}, {"id": 14, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 13, "text": "وَٱضْرِبْ لَهُم مَّثَلًا أَصْحَٰبَ ٱلْقَرْيَةِ إِذْ جَآءَهَا ٱلْمُرْسَلُونَ ", "translation": "And present to them an example: the people of the city, when the messengers came to it -", "words": [{"id": 1, "arabic": "وَٱضْرِبْ", "translit": "ْbِrْḍٱَw", "root": "ضرب"}, {"id": 2, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 3, "arabic": "مَّثَلًا", "translit": "āًlَhtَّm", "root": "مثل"}, {"id": 4, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 5, "arabic": "ٱلْقَرْيَةِ", "translit": "ِẗَyْrَqْlٱ", "root": "قري"}, {"id": 6, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 7, "arabic": "جَآءَهَا", "translit": "āَhَءٓāَjg", "root": "جيا"}, {"id": 8, "arabic": "ٱلْمُرْسَلُونَ", "translit": "َnwُlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 14, "text": "إِذْ أَرْسَلْنَآ إِلَيْهِمُ ٱثْنَيْنِ فَكَذَّبُوهُمَا فَعَزَّزْنَا بِثَالِثٍ فَقَالُوٓا۟ إِنَّآ إِلَيْكُم مُّرْسَلُونَ ", "translation": "When We sent to them two but they denied them, so We strengthened [them] with a third, and they said, \"Indeed, we are messengers to you.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَآ", "translit": "ٓāَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "إِلَيْهِمُ", "translit": "ُmِhْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱثْنَيْنِ", "translit": "ِnْyَnْhtٱ", "root": "ثني"}, {"id": 5, "arabic": "فَكَذَّبُوهُمَا", "translit": "āَmُhwُbَّhdَkَf", "root": "كذب"}, {"id": 6, "arabic": "فَعَزَّزْنَا", "translit": "āَnْzَّzَʿعَf", "root": "عزز"}, {"id": 7, "arabic": "بِثَالِثٍ", "translit": "ٍhtِlāَhtِb", "root": "ثلث"}, {"id": 8, "arabic": "فَقَالُوٓا۟", "translit": "۟āٓwُlāَqَf", "root": "قول"}, {"id": 9, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 10, "arabic": "إِلَيْكُم", "translit": "mُkْyَlِiʾ", "root": ""}, {"id": 11, "arabic": "مُّرْسَلُونَ", "translit": "َnwُlَsْrُّm", "root": "رسل"}], "hasIhya": false}, {"ayah": 15, "text": "قَالُوا۟ مَآ أَنتُمْ إِلَّا بَشَرٌ مِّثْلُنَا وَمَآ أَنزَلَ ٱلرَّحْمَٰنُ مِن شَىْءٍ إِنْ أَنتُمْ إِلَّا تَكْذِبُونَ ", "translation": "They said, \"You are not but human beings like us, and the Most Merciful has not revealed a thing. You are only telling lies.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "بَشَرٌ", "translit": "ٌrَhsَb", "root": "بشر"}, {"id": 6, "arabic": "مِّثْلُنَا", "translit": "āَnُlْhtِّm", "root": "مثل"}, {"id": 7, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 8, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 9, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 12, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 13, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "تَكْذِبُونَ", "translit": "َnwُbِhdْkَt", "root": "كذب"}], "hasIhya": true}, {"ayah": 16, "text": "قَالُوا۟ رَبُّنَا يَعْلَمُ إِنَّآ إِلَيْكُمْ لَمُرْسَلُونَ ", "translation": "They said, \"Our Lord knows that we are messengers to you,", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 4, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 5, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "لَمُرْسَلُونَ", "translit": "َnwُlَsْrُmَl", "root": "رسل"}], "hasIhya": false}, {"ayah": 17, "text": "وَمَا عَلَيْنَآ إِلَّا ٱلْبَلَٰغُ ٱلْمُبِينُ ", "translation": "And we are not responsible except for clear notification.\"", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "عَلَيْنَآ", "translit": "ٓāَnْyَlَʿع", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 5, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 18, "text": "قَالُوٓا۟ إِنَّا تَطَيَّرْنَا بِكُمْۖ لَئِن لَّمْ تَنتَهُوا۟ لَنَرْجُمَنَّكُمْ وَلَيَمَسَّنَّكُم مِّنَّا عَذَابٌ أَلِيمٌ ", "translation": "They said, \"Indeed, we consider you a bad omen. If you do not desist, we will surely stone you, and there will surely touch you, from us, a painful punishment.\"", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 3, "arabic": "تَطَيَّرْنَا", "translit": "āَnْrَّyَṭَt", "root": "طير"}, {"id": 4, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 5, "arabic": "لَئِن", "translit": "nِyʾَl", "root": ""}, {"id": 6, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 7, "arabic": "تَنتَهُوا۟", "translit": "۟āwُhَtnَt", "root": "نهي"}, {"id": 8, "arabic": "لَنَرْجُمَنَّكُمْ", "translit": "ْmُkَّnَmُjgْrَnَl", "root": "رجم"}, {"id": 9, "arabic": "وَلَيَمَسَّنَّكُم", "translit": "mُkَّnَّsَmَyَlَw", "root": "مسس"}, {"id": 10, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 19, "text": "قَالُوا۟ طَٰٓئِرُكُم مَّعَكُمْۚ أَئِن ذُكِّرْتُمۚ بَلْ أَنتُمْ قَوْمٌ مُّسْرِفُونَ ", "translation": "They said, \"Your omen [i.e., fate] is with yourselves. Is it[1] because you were reminded? Rather, you are a transgressing people.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "طَٰٓئِرُكُم", "translit": "mُkُrِyʾَٰٓṭ", "root": "طير"}, {"id": 3, "arabic": "مَّعَكُمْ", "translit": "ْmُkَʿعَّm", "root": ""}, {"id": 4, "arabic": "أَئِن", "translit": "nِyʾَaʾ", "root": ""}, {"id": 5, "arabic": "ذُكِّرْتُم", "translit": "mُtْrِّkُhd", "root": "ذكر"}, {"id": 6, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 7, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 8, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 9, "arabic": "مُّسْرِفُونَ", "translit": "َnwُfِrْsُّm", "root": "سرف"}], "hasIhya": false}, {"ayah": 20, "text": "وَجَآءَ مِنْ أَقْصَا ٱلْمَدِينَةِ رَجُلٌ يَسْعَىٰ قَالَ يَٰقَوْمِ ٱتَّبِعُوا۟ ٱلْمُرْسَلِينَ ", "translation": "And there came from the farthest end of the city a man, running. He said, \"O my people, follow the messengers.", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "َءٓāَjgَw", "root": "جيا"}, {"id": 2, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 3, "arabic": "أَقْصَا", "translit": "āَṣْqَaʾ", "root": "قصو"}, {"id": 4, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 5, "arabic": "رَجُلٌ", "translit": "ٌlُjgَr", "root": "رجل"}, {"id": 6, "arabic": "يَسْعَىٰ", "translit": "ٰàَʿعْsَy", "root": "سعي"}, {"id": 7, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 8, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 9, "arabic": "ٱتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtٱ", "root": "تبع"}, {"id": 10, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 21, "text": "ٱتَّبِعُوا۟ مَن لَّا يَسْـَٔلُكُمْ أَجْرًا وَهُم مُّهْتَدُونَ ", "translation": "Follow those who do not ask of you [any] payment, and they are [rightly] guided.", "words": [{"id": 1, "arabic": "ٱتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtٱ", "root": "تبع"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 4, "arabic": "يَسْـَٔلُكُمْ", "translit": "ْmُkُlَٔـْsَy", "root": "سال"}, {"id": 5, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 6, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 7, "arabic": "مُّهْتَدُونَ", "translit": "َnwُdَtْhُّm", "root": "هدي"}], "hasIhya": false}, {"ayah": 22, "text": "وَمَا لِىَ لَآ أَعْبُدُ ٱلَّذِى فَطَرَنِى وَإِلَيْهِ تُرْجَعُونَ ", "translation": "And why should I not worship He who created me and to whom you will be returned?", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "لِىَ", "translit": "َàِl", "root": ""}, {"id": 3, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 4, "arabic": "أَعْبُدُ", "translit": "ُdُbْʿعَaʾ", "root": "عبد"}, {"id": 5, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "فَطَرَنِى", "translit": "àِnَrَṭَf", "root": "فطر"}, {"id": 7, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 8, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": false}, {"ayah": 23, "text": "ءَأَتَّخِذُ مِن دُونِهِۦٓ ءَالِهَةً إِن يُرِدْنِ ٱلرَّحْمَٰنُ بِضُرٍّ لَّا تُغْنِ عَنِّى شَفَٰعَتُهُمْ شَيْـًٔا وَلَا يُنقِذُونِ ", "translation": "Should I take other than Him [false] deities [while], if the Most Merciful intends for me some adversity, their intercession will not avail me at all, nor can they save me?", "words": [{"id": 1, "arabic": "ءَأَتَّخِذُ", "translit": "ُhdِhkَّtَaʾَء", "root": "اخذ"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 4, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "يُرِدْنِ", "translit": "ِnْdِrُy", "root": "رود"}, {"id": 7, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 8, "arabic": "بِضُرٍّ", "translit": "ٍّrُḍِb", "root": "ضرر"}, {"id": 9, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 10, "arabic": "تُغْنِ", "translit": "ِnْغُt", "root": "غني"}, {"id": 11, "arabic": "عَنِّى", "translit": "àِّnَʿع", "root": ""}, {"id": 12, "arabic": "شَفَٰعَتُهُمْ", "translit": "ْmُhُtَʿعَٰfَhs", "root": "شفع"}, {"id": 13, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "يُنقِذُونِ", "translit": "ِnwُhdِqnُy", "root": "نقذ"}], "hasIhya": false}, {"ayah": 24, "text": "إِنِّىٓ إِذًا لَّفِى ضَلَٰلٍ مُّبِينٍ ", "translation": "Indeed, I would then be in manifest error.", "words": [{"id": 1, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 2, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 3, "arabic": "لَّفِى", "translit": "àِfَّl", "root": ""}, {"id": 4, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 5, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 25, "text": "إِنِّىٓ ءَامَنتُ بِرَبِّكُمْ فَٱسْمَعُونِ ", "translation": "Indeed, I have believed in your Lord, so listen to me.\"", "words": [{"id": 1, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 2, "arabic": "ءَامَنتُ", "translit": "ُtnَmāَء", "root": "امن"}, {"id": 3, "arabic": "بِرَبِّكُمْ", "translit": "ْmُkِّbَrِb", "root": "ربب"}, {"id": 4, "arabic": "فَٱسْمَعُونِ", "translit": "ِnwُʿعَmْsٱَf", "root": "سمع"}], "hasIhya": false}, {"ayah": 26, "text": "قِيلَ ٱدْخُلِ ٱلْجَنَّةَۖ قَالَ يَٰلَيْتَ قَوْمِى يَعْلَمُونَ ", "translation": "It was said, \"Enter Paradise.\"[1] He said, \"I wish my people could know", "words": [{"id": 1, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 2, "arabic": "ٱدْخُلِ", "translit": "ِlُhkْdٱ", "root": "دخل"}, {"id": 3, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "يَٰلَيْتَ", "translit": "َtْyَlَٰy", "root": ""}, {"id": 6, "arabic": "قَوْمِى", "translit": "àِmْwَq", "root": "قوم"}, {"id": 7, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 27, "text": "بِمَا غَفَرَ لِى رَبِّى وَجَعَلَنِى مِنَ ٱلْمُكْرَمِينَ ", "translation": "Of how my Lord has forgiven me and placed me among the honored.\"", "words": [{"id": 1, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 2, "arabic": "غَفَرَ", "translit": "َrَfَغ", "root": "غفر"}, {"id": 3, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 4, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 5, "arabic": "وَجَعَلَنِى", "translit": "àِnَlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْمُكْرَمِينَ", "translit": "َnyِmَrْkُmْlٱ", "root": "كرم"}], "hasIhya": false}, {"ayah": 28, "text": "وَمَآ أَنزَلْنَا عَلَىٰ قَوْمِهِۦ مِنۢ بَعْدِهِۦ مِن جُندٍ مِّنَ ٱلسَّمَآءِ وَمَا كُنَّا مُنزِلِينَ ", "translation": "And We did not send down upon his people after him any soldiers from the heaven, nor would We have done so.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "جُندٍ", "translit": "ٍdnُjg", "root": "جند"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 13, "arabic": "مُنزِلِينَ", "translit": "َnyِlِznُm", "root": "نزل"}], "hasIhya": false}, {"ayah": 29, "text": "إِن كَانَتْ إِلَّا صَيْحَةً وَٰحِدَةً فَإِذَا هُمْ خَٰمِدُونَ ", "translation": "It was not but one shout,[1] and immediately they were extinguished.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "صَيْحَةً", "translit": "ًẗَḥْyَṣ", "root": "صيح"}, {"id": 5, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 6, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 8, "arabic": "خَٰمِدُونَ", "translit": "َnwُdِmَٰhk", "root": "خمد"}], "hasIhya": false}, {"ayah": 30, "text": "يَٰحَسْرَةً عَلَى ٱلْعِبَادِۚ مَا يَأْتِيهِم مِّن رَّسُولٍ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "How regretful for the servants. There did not come to them any messenger except that they used to ridicule him.", "words": [{"id": 1, "arabic": "يَٰحَسْرَةً", "translit": "ًẗَrْsَḥَٰy", "root": "حسر"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْعِبَادِ", "translit": "ِdāَbِʿعْlٱ", "root": "عبد"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "يَأْتِيهِم", "translit": "mِhyِtْaʾَy", "root": "اتي"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "رَّسُولٍ", "translit": "ٍlwُsَّr", "root": "رسل"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": true}, {"ayah": 31, "text": "أَلَمْ يَرَوْا۟ كَمْ أَهْلَكْنَا قَبْلَهُم مِّنَ ٱلْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ ", "translation": "Have they not considered how many generations We destroyed before them - that they to them[1] will not return?", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "كَمْ", "translit": "ْmَk", "root": ""}, {"id": 4, "arabic": "أَهْلَكْنَا", "translit": "āَnْkَlْhَaʾ", "root": "هلك"}, {"id": 5, "arabic": "قَبْلَهُم", "translit": "mُhَlْbَq", "root": "قبل"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلْقُرُونِ", "translit": "ِnwُrُqْlٱ", "root": "قرن"}, {"id": 8, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 9, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": true}, {"ayah": 32, "text": "وَإِن كُلٌّ لَّمَّا جَمِيعٌ لَّدَيْنَا مُحْضَرُونَ ", "translation": "And indeed, all of them will yet be brought present before Us.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 3, "arabic": "لَّمَّا", "translit": "āَّmَّl", "root": ""}, {"id": 4, "arabic": "جَمِيعٌ", "translit": "ٌʿعyِmَjg", "root": "جمع"}, {"id": 5, "arabic": "لَّدَيْنَا", "translit": "āَnْyَdَّl", "root": ""}, {"id": 6, "arabic": "مُحْضَرُونَ", "translit": "َnwُrَḍْḥُm", "root": "حضر"}], "hasIhya": true}, {"ayah": 33, "text": "وَءَايَةٌ لَّهُمُ ٱلْأَرْضُ ٱلْمَيْتَةُ أَحْيَيْنَٰهَا وَأَخْرَجْنَا مِنْهَا حَبًّا فَمِنْهُ يَأْكُلُونَ ", "translation": "And a sign for them is the dead earth. We have brought it to life and brought forth from it grain, and from it they eat.", "words": [{"id": 1, "arabic": "وَءَايَةٌ", "translit": "ٌẗَyāَءَw", "root": "ايي"}, {"id": 2, "arabic": "لَّهُمُ", "translit": "ُmُhَّl", "root": ""}, {"id": 3, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "ٱلْمَيْتَةُ", "translit": "ُẗَtْyَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "أَحْيَيْنَٰهَا", "translit": "āَhَٰnْyَyْḥَaʾ", "root": "حيي"}, {"id": 6, "arabic": "وَأَخْرَجْنَا", "translit": "āَnْjgَrْhkَaʾَw", "root": "خرج"}, {"id": 7, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 8, "arabic": "حَبًّا", "translit": "āًّbَḥ", "root": "حبب"}, {"id": 9, "arabic": "فَمِنْهُ", "translit": "ُhْnِmَf", "root": ""}, {"id": 10, "arabic": "يَأْكُلُونَ", "translit": "َnwُlُkْaʾَy", "root": "اكل"}], "hasIhya": false}, {"ayah": 34, "text": "وَجَعَلْنَا فِيهَا جَنَّٰتٍ مِّن نَّخِيلٍ وَأَعْنَٰبٍ وَفَجَّرْنَا فِيهَا مِنَ ٱلْعُيُونِ ", "translation": "And We placed therein gardens of palm trees and grapevines and caused to burst forth therefrom some springs -", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "نَّخِيلٍ", "translit": "ٍlyِhkَّn", "root": "نخل"}, {"id": 6, "arabic": "وَأَعْنَٰبٍ", "translit": "ٍbَٰnْʿعَaʾَw", "root": "عنب"}, {"id": 7, "arabic": "وَفَجَّرْنَا", "translit": "āَnْrَّjgَfَw", "root": "فجر"}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلْعُيُونِ", "translit": "ِnwُyُʿعْlٱ", "root": "عين"}], "hasIhya": false}, {"ayah": 35, "text": "لِيَأْكُلُوا۟ مِن ثَمَرِهِۦ وَمَا عَمِلَتْهُ أَيْدِيهِمْۖ أَفَلَا يَشْكُرُونَ ", "translation": "That they may eat of His fruit.[1] And their hands have not produced it,[2] so will they not be grateful?", "words": [{"id": 1, "arabic": "لِيَأْكُلُوا۟", "translit": "۟āwُlُkْaʾَyِl", "root": "اكل"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "ثَمَرِهِۦ", "translit": "ۦِhِrَmَht", "root": "ثمر"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "عَمِلَتْهُ", "translit": "ُhْtَlِmَʿع", "root": "عمل"}, {"id": 6, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 7, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 8, "arabic": "يَشْكُرُونَ", "translit": "َnwُrُkْhsَy", "root": "شكر"}], "hasIhya": false}, {"ayah": 36, "text": "سُبْحَٰنَ ٱلَّذِى خَلَقَ ٱلْأَزْوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ ٱلْأَرْضُ وَمِنْ أَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ ", "translation": "Exalted is He who created all pairs[1] - from what the earth grows and from themselves and from that which they do not know.", "words": [{"id": 1, "arabic": "سُبْحَٰنَ", "translit": "َnَٰḥْbُs", "root": "سبح"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلْأَزْوَٰجَ", "translit": "َjgَٰwْzَaʾْlٱ", "root": "زوج"}, {"id": 5, "arabic": "كُلَّهَا", "translit": "āَhَّlُk", "root": "كلل"}, {"id": 6, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 7, "arabic": "تُنۢبِتُ", "translit": "ُtِbۢnُt", "root": "نبت"}, {"id": 8, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 10, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 11, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 37, "text": "وَءَايَةٌ لَّهُمُ ٱلَّيْلُ نَسْلَخُ مِنْهُ ٱلنَّهَارَ فَإِذَا هُم مُّظْلِمُونَ ", "translation": "And a sign for them is the night. We remove[1] from it the [light of] day, so they are [left] in darkness.", "words": [{"id": 1, "arabic": "وَءَايَةٌ", "translit": "ٌẗَyāَءَw", "root": "ايي"}, {"id": 2, "arabic": "لَّهُمُ", "translit": "ُmُhَّl", "root": ""}, {"id": 3, "arabic": "ٱلَّيْلُ", "translit": "ُlْyَّlٱ", "root": "ليل"}, {"id": 4, "arabic": "نَسْلَخُ", "translit": "ُhkَlْsَn", "root": "سلخ"}, {"id": 5, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 6, "arabic": "ٱلنَّهَارَ", "translit": "َrāَhَّnlٱ", "root": "نهر"}, {"id": 7, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 8, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 9, "arabic": "مُّظْلِمُونَ", "translit": "َnwُmِlْẓُّm", "root": "ظلم"}], "hasIhya": false}, {"ayah": 38, "text": "وَٱلشَّمْسُ تَجْرِى لِمُسْتَقَرٍّ لَّهَاۚ ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ ", "translation": "And the sun runs [on course] toward its stopping point. That is the determination of the Exalted in Might, the Knowing.", "words": [{"id": 1, "arabic": "وَٱلشَّمْسُ", "translit": "ُsْmَّhslٱَw", "root": "شمس"}, {"id": 2, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 3, "arabic": "لِمُسْتَقَرٍّ", "translit": "ٍّrَqَtْsُmِl", "root": "قرر"}, {"id": 4, "arabic": "لَّهَا", "translit": "āَhَّl", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 6, "arabic": "تَقْدِيرُ", "translit": "ُryِdْqَt", "root": "قدر"}, {"id": 7, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 8, "arabic": "ٱلْعَلِيمِ", "translit": "ِmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 39, "text": "وَٱلْقَمَرَ قَدَّرْنَٰهُ مَنَازِلَ حَتَّىٰ عَادَ كَٱلْعُرْجُونِ ٱلْقَدِيمِ ", "translation": "And the moon - We have determined for it phases, until it returns [appearing] like the old date stalk.", "words": [{"id": 1, "arabic": "وَٱلْقَمَرَ", "translit": "َrَmَqْlٱَw", "root": "قمر"}, {"id": 2, "arabic": "قَدَّرْنَٰهُ", "translit": "ُhَٰnْrَّdَq", "root": "قدر"}, {"id": 3, "arabic": "مَنَازِلَ", "translit": "َlِzāَnَm", "root": "نزل"}, {"id": 4, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 5, "arabic": "عَادَ", "translit": "َdāَʿع", "root": "عود"}, {"id": 6, "arabic": "كَٱلْعُرْجُونِ", "translit": "ِnwُjgْrُʿعْlٱَk", "root": "عرجن"}, {"id": 7, "arabic": "ٱلْقَدِيمِ", "translit": "ِmyِdَqْlٱ", "root": "قدم"}], "hasIhya": true}, {"ayah": 40, "text": "لَا ٱلشَّمْسُ يَنۢبَغِى لَهَآ أَن تُدْرِكَ ٱلْقَمَرَ وَلَا ٱلَّيْلُ سَابِقُ ٱلنَّهَارِۚ وَكُلٌّ فِى فَلَكٍ يَسْبَحُونَ ", "translation": "It is not allowable [i.e., possible] for the sun to reach the moon, nor does the night overtake the day, but each, in an orbit, is swimming.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "ٱلشَّمْسُ", "translit": "ُsْmَّhslٱ", "root": "شمس"}, {"id": 3, "arabic": "يَنۢبَغِى", "translit": "àِغَbۢnَy", "root": "بغي"}, {"id": 4, "arabic": "لَهَآ", "translit": "ٓāَhَl", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تُدْرِكَ", "translit": "َkِrْdُt", "root": "درك"}, {"id": 7, "arabic": "ٱلْقَمَرَ", "translit": "َrَmَqْlٱ", "root": "قمر"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "ٱلَّيْلُ", "translit": "ُlْyَّlٱ", "root": "ليل"}, {"id": 10, "arabic": "سَابِقُ", "translit": "ُqِbāَs", "root": "سبق"}, {"id": 11, "arabic": "ٱلنَّهَارِ", "translit": "ِrāَhَّnlٱ", "root": "نهر"}, {"id": 12, "arabic": "وَكُلٌّ", "translit": "ٌّlُkَw", "root": "كلل"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "فَلَكٍ", "translit": "ٍkَlَf", "root": "فلك"}, {"id": 15, "arabic": "يَسْبَحُونَ", "translit": "َnwُḥَbْsَy", "root": "سبح"}], "hasIhya": false}, {"ayah": 41, "text": "وَءَايَةٌ لَّهُمْ أَنَّا حَمَلْنَا ذُرِّيَّتَهُمْ فِى ٱلْفُلْكِ ٱلْمَشْحُونِ ", "translation": "And a sign for them is that We carried their forefathers[1] in a laden ship.", "words": [{"id": 1, "arabic": "وَءَايَةٌ", "translit": "ٌẗَyāَءَw", "root": "ايي"}, {"id": 2, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 3, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 4, "arabic": "حَمَلْنَا", "translit": "āَnْlَmَḥ", "root": "حمل"}, {"id": 5, "arabic": "ذُرِّيَّتَهُمْ", "translit": "ْmُhَtَّyِّrُhd", "root": "ذرر"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْفُلْكِ", "translit": "ِkْlُfْlٱ", "root": "فلك"}, {"id": 8, "arabic": "ٱلْمَشْحُونِ", "translit": "ِnwُḥْhsَmْlٱ", "root": "شحن"}], "hasIhya": false}, {"ayah": 42, "text": "وَخَلَقْنَا لَهُم مِّن مِّثْلِهِۦ مَا يَرْكَبُونَ ", "translation": "And We created for them from the likes of it that which they ride.", "words": [{"id": 1, "arabic": "وَخَلَقْنَا", "translit": "āَnْqَlَhkَw", "root": "خلق"}, {"id": 2, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "مِّثْلِهِۦ", "translit": "ۦِhِlْhtِّm", "root": "مثل"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "يَرْكَبُونَ", "translit": "َnwُbَkْrَy", "root": "ركب"}], "hasIhya": false}, {"ayah": 43, "text": "وَإِن نَّشَأْ نُغْرِقْهُمْ فَلَا صَرِيخَ لَهُمْ وَلَا هُمْ يُنقَذُونَ ", "translation": "And if We should will, We could drown them; then no one responding to a cry would there be for them, nor would they be saved", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "نَّشَأْ", "translit": "ْaʾَhsَّn", "root": "شيا"}, {"id": 3, "arabic": "نُغْرِقْهُمْ", "translit": "ْmُhْqِrْغُn", "root": "غرق"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "صَرِيخَ", "translit": "َhkyِrَṣ", "root": "صرخ"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 9, "arabic": "يُنقَذُونَ", "translit": "َnwُhdَqnُy", "root": "نقذ"}], "hasIhya": false}, {"ayah": 44, "text": "إِلَّا رَحْمَةً مِّنَّا وَمَتَٰعًا إِلَىٰ حِينٍ ", "translation": "Except as a mercy from Us and provision for a time.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 3, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 4, "arabic": "وَمَتَٰعًا", "translit": "āًʿعَٰtَmَw", "root": "متع"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "حِينٍ", "translit": "ٍnyِḥ", "root": "حين"}], "hasIhya": false}, {"ayah": 45, "text": "وَإِذَا قِيلَ لَهُمُ ٱتَّقُوا۟ مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَمُونَ ", "translation": "But when it is said to them, \"Beware of what is before you and what is behind you;[1] perhaps you will receive mercy...\"[2]", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 4, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 7, "arabic": "أَيْدِيكُمْ", "translit": "ْmُkyِdْyَaʾ", "root": "يدي"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "خَلْفَكُمْ", "translit": "ْmُkَfْlَhk", "root": "خلف"}, {"id": 10, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 11, "arabic": "تُرْحَمُونَ", "translit": "َnwُmَḥْrُt", "root": "رحم"}], "hasIhya": false}, {"ayah": 46, "text": "وَمَا تَأْتِيهِم مِّنْ ءَايَةٍ مِّنْ ءَايَٰتِ رَبِّهِمْ إِلَّا كَانُوا۟ عَنْهَا مُعْرِضِينَ ", "translation": "And no sign comes to them from the signs of their Lord except that they are from it turning away.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تَأْتِيهِم", "translit": "mِhyِtْaʾَt", "root": "اتي"}, {"id": 3, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 4, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 5, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 6, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 7, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 11, "arabic": "مُعْرِضِينَ", "translit": "َnyِḍِrْʿعُm", "root": "عرض"}], "hasIhya": true}, {"ayah": 47, "text": "وَإِذَا قِيلَ لَهُمْ أَنفِقُوا۟ مِمَّا رَزَقَكُمُ ٱللَّهُ قَالَ ٱلَّذِينَ كَفَرُوا۟ لِلَّذِينَ ءَامَنُوٓا۟ أَنُطْعِمُ مَن لَّوْ يَشَآءُ ٱللَّهُ أَطْعَمَهُۥٓ إِنْ أَنتُمْ إِلَّا فِى ضَلَٰلٍ مُّبِينٍ ", "translation": "And when it is said to them, \"Spend from that which Allāh has provided for you,\" those who disbelieve say to those who believe, \"Should we feed one whom, if Allāh had willed, He would have fed? You are not but in clear error.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "أَنفِقُوا۟", "translit": "۟āwُqِfnَaʾ", "root": "نفق"}, {"id": 5, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 6, "arabic": "رَزَقَكُمُ", "translit": "ُmُkَqَzَr", "root": "رزق"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 11, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 12, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 13, "arabic": "أَنُطْعِمُ", "translit": "ُmِʿعْṭُnَaʾ", "root": "طعم"}, {"id": 14, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 15, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 16, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "أَطْعَمَهُۥٓ", "translit": "ٓۥُhَmَʿعْṭَaʾ", "root": "طعم"}, {"id": 19, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 20, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 21, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 24, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 48, "text": "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"When is this promise, if you should be truthful?\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْوَعْدُ", "translit": "ُdْʿعَwْlٱ", "root": "وعد"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 49, "text": "مَا يَنظُرُونَ إِلَّا صَيْحَةً وَٰحِدَةً تَأْخُذُهُمْ وَهُمْ يَخِصِّمُونَ ", "translation": "They do not await except one blast[1] which will seize them while they are disputing.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "صَيْحَةً", "translit": "ًẗَḥْyَṣ", "root": "صيح"}, {"id": 5, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 6, "arabic": "تَأْخُذُهُمْ", "translit": "ْmُhُhdُhkْaʾَt", "root": "اخذ"}, {"id": 7, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 8, "arabic": "يَخِصِّمُونَ", "translit": "َnwُmِّṣِhkَy", "root": "خصم"}], "hasIhya": true}, {"ayah": 50, "text": "فَلَا يَسْتَطِيعُونَ تَوْصِيَةً وَلَآ إِلَىٰٓ أَهْلِهِمْ يَرْجِعُونَ ", "translation": "And they will not be able [to give] any instruction, nor to their people can they return.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 3, "arabic": "تَوْصِيَةً", "translit": "ًẗَyِṣْwَt", "root": "وصي"}, {"id": 4, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 5, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 6, "arabic": "أَهْلِهِمْ", "translit": "ْmِhِlْhَaʾ", "root": "اهل"}, {"id": 7, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 51, "text": "وَنُفِخَ فِى ٱلصُّورِ فَإِذَا هُم مِّنَ ٱلْأَجْدَاثِ إِلَىٰ رَبِّهِمْ يَنسِلُونَ ", "translation": "And the Horn will be blown;[1] and at once from the graves to their Lord they will hasten.", "words": [{"id": 1, "arabic": "وَنُفِخَ", "translit": "َhkِfُnَw", "root": "نفخ"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلصُّورِ", "translit": "ِrwُّṣlٱ", "root": "صور"}, {"id": 4, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 5, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلْأَجْدَاثِ", "translit": "ِhtāَdْjgَaʾْlٱ", "root": "جدث"}, {"id": 8, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 9, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 10, "arabic": "يَنسِلُونَ", "translit": "َnwُlِsnَy", "root": "نسل"}], "hasIhya": false}, {"ayah": 52, "text": "قَالُوا۟ يَٰوَيْلَنَا مَنۢ بَعَثَنَا مِن مَّرْقَدِنَاۗۜ هَٰذَا مَا وَعَدَ ٱلرَّحْمَٰنُ وَصَدَقَ ٱلْمُرْسَلُونَ ", "translation": "They will say, \"O woe to us! Who has raised us up from our sleeping place?\" [The reply will be], \"This is what the Most Merciful had promised, and the messengers told the truth.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰوَيْلَنَا", "translit": "āَnَlْyَwَٰy", "root": ""}, {"id": 3, "arabic": "مَنۢ", "translit": "ۢnَm", "root": ""}, {"id": 4, "arabic": "بَعَثَنَا", "translit": "āَnَhtَʿعَb", "root": "بعث"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "مَّرْقَدِنَا", "translit": "āَnِdَqْrَّm", "root": "رقد"}, {"id": 7, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "وَعَدَ", "translit": "َdَʿعَw", "root": "وعد"}, {"id": 10, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 11, "arabic": "وَصَدَقَ", "translit": "َqَdَṣَw", "root": "صدق"}, {"id": 12, "arabic": "ٱلْمُرْسَلُونَ", "translit": "َnwُlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 53, "text": "إِن كَانَتْ إِلَّا صَيْحَةً وَٰحِدَةً فَإِذَا هُمْ جَمِيعٌ لَّدَيْنَا مُحْضَرُونَ ", "translation": "It will not be but one blast, and at once they are all brought present before Us.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "صَيْحَةً", "translit": "ًẗَḥْyَṣ", "root": "صيح"}, {"id": 5, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 6, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 8, "arabic": "جَمِيعٌ", "translit": "ٌʿعyِmَjg", "root": "جمع"}, {"id": 9, "arabic": "لَّدَيْنَا", "translit": "āَnْyَdَّl", "root": ""}, {"id": 10, "arabic": "مُحْضَرُونَ", "translit": "َnwُrَḍْḥُm", "root": "حضر"}], "hasIhya": false}, {"ayah": 54, "text": "فَٱلْيَوْمَ لَا تُظْلَمُ نَفْسٌ شَيْـًٔا وَلَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ ", "translation": "So today [i.e., the Day of Judgement] no soul will be wronged at all, and you will not be recompensed except for what you used to do.", "words": [{"id": 1, "arabic": "فَٱلْيَوْمَ", "translit": "َmْwَyْlٱَf", "root": "يوم"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تُظْلَمُ", "translit": "ُmَlْẓُt", "root": "ظلم"}, {"id": 4, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 5, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تُجْزَوْنَ", "translit": "َnْwَzْjgُt", "root": "جزي"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 55, "text": "إِنَّ أَصْحَٰبَ ٱلْجَنَّةِ ٱلْيَوْمَ فِى شُغُلٍ فَٰكِهُونَ ", "translation": "Indeed the companions of Paradise, that Day, will be amused in [joyful] occupation -", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 3, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 4, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "شُغُلٍ", "translit": "ٍlُغُhs", "root": "شغل"}, {"id": 7, "arabic": "فَٰكِهُونَ", "translit": "َnwُhِkَٰf", "root": "فكه"}], "hasIhya": false}, {"ayah": 56, "text": "هُمْ وَأَزْوَٰجُهُمْ فِى ظِلَٰلٍ عَلَى ٱلْأَرَآئِكِ مُتَّكِـُٔونَ ", "translation": "They and their spouses - in shade, reclining on adorned couches.", "words": [{"id": 1, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 2, "arabic": "وَأَزْوَٰجُهُمْ", "translit": "ْmُhُjgَٰwْzَaʾَw", "root": "زوج"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ظِلَٰلٍ", "translit": "ٍlَٰlِẓ", "root": "ظلل"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْأَرَآئِكِ", "translit": "ِkِyʾٓāَrَaʾْlٱ", "root": "ارك"}, {"id": 7, "arabic": "مُتَّكِـُٔونَ", "translit": "َnwُٔـِkَّtُm", "root": "وكا"}], "hasIhya": false}, {"ayah": 57, "text": "لَهُمْ فِيهَا فَٰكِهَةٌ وَلَهُم مَّا يَدَّعُونَ ", "translation": "For them therein is fruit, and for them is whatever they request [or wish]", "words": [{"id": 1, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "فَٰكِهَةٌ", "translit": "ٌẗَhِkَٰf", "root": "فكه"}, {"id": 4, "arabic": "وَلَهُم", "translit": "mُhَlَw", "root": ""}, {"id": 5, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 6, "arabic": "يَدَّعُونَ", "translit": "َnwُʿعَّdَy", "root": "دعو"}], "hasIhya": false}, {"ayah": 58, "text": "سَلَٰمٌ قَوْلًا مِّن رَّبٍّ رَّحِيمٍ ", "translation": "[And] \"Peace,\" a word from a Merciful Lord.", "words": [{"id": 1, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 2, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "رَّبٍّ", "translit": "ٍّbَّr", "root": "ربب"}, {"id": 5, "arabic": "رَّحِيمٍ", "translit": "ٍmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 59, "text": "وَٱمْتَٰزُوا۟ ٱلْيَوْمَ أَيُّهَا ٱلْمُجْرِمُونَ ", "translation": "[Then He will say], \"But stand apart today, you criminals.[1]", "words": [{"id": 1, "arabic": "وَٱمْتَٰزُوا۟", "translit": "۟āwُzَٰtْmٱَw", "root": "ميز"}, {"id": 2, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 3, "arabic": "أَيُّهَا", "translit": "āَhُّyَaʾ", "root": "ايي"}, {"id": 4, "arabic": "ٱلْمُجْرِمُونَ", "translit": "َnwُmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": true}, {"ayah": 60, "text": "أَلَمْ أَعْهَدْ إِلَيْكُمْ يَٰبَنِىٓ ءَادَمَ أَن لَّا تَعْبُدُوا۟ ٱلشَّيْطَٰنَۖ إِنَّهُۥ لَكُمْ عَدُوٌّ مُّبِينٌ ", "translation": "Did I not enjoin upon you, O children of Adam, that you not worship Satan - [for] indeed, he is to you a clear enemy -", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "أَعْهَدْ", "translit": "ْdَhْʿعَaʾ", "root": "عهد"}, {"id": 3, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 5, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 8, "arabic": "تَعْبُدُوا۟", "translit": "۟āwُdُbْʿعَt", "root": "عبد"}, {"id": 9, "arabic": "ٱلشَّيْطَٰنَ", "translit": "َnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 10, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 12, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 13, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 61, "text": "وَأَنِ ٱعْبُدُونِىۚ هَٰذَا صِرَٰطٌ مُّسْتَقِيمٌ ", "translation": "And that you worship [only] Me? This is a straight path.", "words": [{"id": 1, "arabic": "وَأَنِ", "translit": "ِnَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱعْبُدُونِى", "translit": "àِnwُdُbْʿعٱ", "root": "عبد"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "صِرَٰطٌ", "translit": "ٌṭَٰrِṣ", "root": "صرط"}, {"id": 5, "arabic": "مُّسْتَقِيمٌ", "translit": "ٌmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 62, "text": "وَلَقَدْ أَضَلَّ مِنكُمْ جِبِلًّا كَثِيرًاۖ أَفَلَمْ تَكُونُوا۟ تَعْقِلُونَ ", "translation": "And he had already led astray from among you much of creation, so did you not use reason?", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَضَلَّ", "translit": "َّlَḍَaʾ", "root": "ضلل"}, {"id": 3, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 4, "arabic": "جِبِلًّا", "translit": "āًّlِbِjg", "root": "جبل"}, {"id": 5, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 6, "arabic": "أَفَلَمْ", "translit": "ْmَlَfَaʾ", "root": ""}, {"id": 7, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 8, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": false}, {"ayah": 63, "text": "هَٰذِهِۦ جَهَنَّمُ ٱلَّتِى كُنتُمْ تُوعَدُونَ ", "translation": "This is the Hellfire which you were promised.", "words": [{"id": 1, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 2, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 3, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 4, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 5, "arabic": "تُوعَدُونَ", "translit": "َnwُdَʿعwُt", "root": "وعد"}], "hasIhya": false}, {"ayah": 64, "text": "ٱصْلَوْهَا ٱلْيَوْمَ بِمَا كُنتُمْ تَكْفُرُونَ ", "translation": "[Enter to] burn therein today for what you used to deny.\"[1]", "words": [{"id": 1, "arabic": "ٱصْلَوْهَا", "translit": "āَhْwَlْṣٱ", "root": "صلي"}, {"id": 2, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 5, "arabic": "تَكْفُرُونَ", "translit": "َnwُrُfْkَt", "root": "كفر"}], "hasIhya": false}, {"ayah": 65, "text": "ٱلْيَوْمَ نَخْتِمُ عَلَىٰٓ أَفْوَٰهِهِمْ وَتُكَلِّمُنَآ أَيْدِيهِمْ وَتَشْهَدُ أَرْجُلُهُم بِمَا كَانُوا۟ يَكْسِبُونَ ", "translation": "That Day, We will seal over their mouths, and their hands will speak to Us, and their feet will testify about what they used to earn.", "words": [{"id": 1, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 2, "arabic": "نَخْتِمُ", "translit": "ُmِtْhkَn", "root": "ختم"}, {"id": 3, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 4, "arabic": "أَفْوَٰهِهِمْ", "translit": "ْmِhِhَٰwْfَaʾ", "root": "فوه"}, {"id": 5, "arabic": "وَتُكَلِّمُنَآ", "translit": "ٓāَnُmِّlَkُtَw", "root": "كلم"}, {"id": 6, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 7, "arabic": "وَتَشْهَدُ", "translit": "ُdَhْhsَtَw", "root": "شهد"}, {"id": 8, "arabic": "أَرْجُلُهُم", "translit": "mُhُlُjgْrَaʾ", "root": "رجل"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 11, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": true}, {"ayah": 66, "text": "وَلَوْ نَشَآءُ لَطَمَسْنَا عَلَىٰٓ أَعْيُنِهِمْ فَٱسْتَبَقُوا۟ ٱلصِّرَٰطَ فَأَنَّىٰ يُبْصِرُونَ ", "translation": "And if We willed, We could have obliterated their eyes, and they would race to [find] the path, and how could they see?[1]", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "نَشَآءُ", "translit": "ُءٓāَhsَn", "root": "شيا"}, {"id": 3, "arabic": "لَطَمَسْنَا", "translit": "āَnْsَmَṭَl", "root": "طمس"}, {"id": 4, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 5, "arabic": "أَعْيُنِهِمْ", "translit": "ْmِhِnُyْʿعَaʾ", "root": "عين"}, {"id": 6, "arabic": "فَٱسْتَبَقُوا۟", "translit": "۟āwُqَbَtْsٱَf", "root": "سبق"}, {"id": 7, "arabic": "ٱلصِّرَٰطَ", "translit": "َṭَٰrِّṣlٱ", "root": "صرط"}, {"id": 8, "arabic": "فَأَنَّىٰ", "translit": "ٰàَّnَaʾَf", "root": ""}, {"id": 9, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}], "hasIhya": false}, {"ayah": 67, "text": "وَلَوْ نَشَآءُ لَمَسَخْنَٰهُمْ عَلَىٰ مَكَانَتِهِمْ فَمَا ٱسْتَطَٰعُوا۟ مُضِيًّا وَلَا يَرْجِعُونَ ", "translation": "And if We willed, We could have deformed them, [paralyzing them] in their places so they would not be able to proceed, nor could they return.[1]", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "نَشَآءُ", "translit": "ُءٓāَhsَn", "root": "شيا"}, {"id": 3, "arabic": "لَمَسَخْنَٰهُمْ", "translit": "ْmُhَٰnْhkَsَmَl", "root": "مسخ"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "مَكَانَتِهِمْ", "translit": "ْmِhِtَnāَkَm", "root": "كون"}, {"id": 6, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 7, "arabic": "ٱسْتَطَٰعُوا۟", "translit": "۟āwُʿعَٰṭَtْsٱ", "root": "طوع"}, {"id": 8, "arabic": "مُضِيًّا", "translit": "āًّyِḍُm", "root": "مضي"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 68, "text": "وَمَن نُّعَمِّرْهُ نُنَكِّسْهُ فِى ٱلْخَلْقِۖ أَفَلَا يَعْقِلُونَ ", "translation": "And he to whom We grant long life We reverse in creation;[1] so will they not understand?", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "نُّعَمِّرْهُ", "translit": "ُhْrِّmَʿعُّn", "root": "عمر"}, {"id": 3, "arabic": "نُنَكِّسْهُ", "translit": "ُhْsِّkَnُn", "root": "نكس"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْخَلْقِ", "translit": "ِqْlَhkْlٱ", "root": "خلق"}, {"id": 6, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 7, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 69, "text": "وَمَا عَلَّمْنَٰهُ ٱلشِّعْرَ وَمَا يَنۢبَغِى لَهُۥٓۚ إِنْ هُوَ إِلَّا ذِكْرٌ وَقُرْءَانٌ مُّبِينٌ ", "translation": "And We did not give him [i.e., Prophet Muḥammad (ﷺ)] knowledge of poetry, nor is it befitting for him. It is not but a message and a clear Qur’ān", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "عَلَّمْنَٰهُ", "translit": "ُhَٰnْmَّlَʿع", "root": "علم"}, {"id": 3, "arabic": "ٱلشِّعْرَ", "translit": "َrْʿعِّhslٱ", "root": "شعر"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "يَنۢبَغِى", "translit": "àِغَbۢnَy", "root": "بغي"}, {"id": 6, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 7, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "ذِكْرٌ", "translit": "ٌrْkِhd", "root": "ذكر"}, {"id": 11, "arabic": "وَقُرْءَانٌ", "translit": "ٌnāَءْrُqَw", "root": "قرا"}, {"id": 12, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 70, "text": "لِّيُنذِرَ مَن كَانَ حَيًّا وَيَحِقَّ ٱلْقَوْلُ عَلَى ٱلْكَٰفِرِينَ ", "translation": "To warn whoever is alive[1] and justify the word [i.e., decree] against the disbelievers.", "words": [{"id": 1, "arabic": "لِّيُنذِرَ", "translit": "َrِhdnُyِّl", "root": "نذر"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "حَيًّا", "translit": "āًّyَḥ", "root": "حيي"}, {"id": 5, "arabic": "وَيَحِقَّ", "translit": "َّqِḥَyَw", "root": "حقق"}, {"id": 6, "arabic": "ٱلْقَوْلُ", "translit": "ُlْwَqْlٱ", "root": "قول"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 71, "text": "أَوَلَمْ يَرَوْا۟ أَنَّا خَلَقْنَا لَهُم مِّمَّا عَمِلَتْ أَيْدِينَآ أَنْعَٰمًا فَهُمْ لَهَا مَٰلِكُونَ ", "translation": "Do they not see that We have created for them from what Our hands[1] have made, grazing livestock, and [then] they are their owners?", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 4, "arabic": "خَلَقْنَا", "translit": "āَnْqَlَhk", "root": "خلق"}, {"id": 5, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 6, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 7, "arabic": "عَمِلَتْ", "translit": "ْtَlِmَʿع", "root": "عمل"}, {"id": 8, "arabic": "أَيْدِينَآ", "translit": "ٓāَnyِdْyَaʾ", "root": "يدي"}, {"id": 9, "arabic": "أَنْعَٰمًا", "translit": "āًmَٰʿعْnَaʾ", "root": "نعم"}, {"id": 10, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 11, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 12, "arabic": "مَٰلِكُونَ", "translit": "َnwُkِlَٰm", "root": "ملك"}], "hasIhya": false}, {"ayah": 72, "text": "وَذَلَّلْنَٰهَا لَهُمْ فَمِنْهَا رَكُوبُهُمْ وَمِنْهَا يَأْكُلُونَ ", "translation": "And We have tamed them for them, so some of them they ride, and some of them they eat.", "words": [{"id": 1, "arabic": "وَذَلَّلْنَٰهَا", "translit": "āَhَٰnْlَّlَhdَw", "root": "ذلل"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "فَمِنْهَا", "translit": "āَhْnِmَf", "root": ""}, {"id": 4, "arabic": "رَكُوبُهُمْ", "translit": "ْmُhُbwُkَr", "root": "ركب"}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "āَhْnِmَw", "root": ""}, {"id": 6, "arabic": "يَأْكُلُونَ", "translit": "َnwُlُkْaʾَy", "root": "اكل"}], "hasIhya": false}, {"ayah": 73, "text": "وَلَهُمْ فِيهَا مَنَٰفِعُ وَمَشَارِبُۖ أَفَلَا يَشْكُرُونَ ", "translation": "And for them therein are [other] benefits and drinks, so will they not be grateful?", "words": [{"id": 1, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "مَنَٰفِعُ", "translit": "ُʿعِfَٰnَm", "root": "نفع"}, {"id": 4, "arabic": "وَمَشَارِبُ", "translit": "ُbِrāَhsَmَw", "root": "شرب"}, {"id": 5, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 6, "arabic": "يَشْكُرُونَ", "translit": "َnwُrُkْhsَy", "root": "شكر"}], "hasIhya": false}, {"ayah": 74, "text": "وَٱتَّخَذُوا۟ مِن دُونِ ٱللَّهِ ءَالِهَةً لَّعَلَّهُمْ يُنصَرُونَ ", "translation": "But they have taken besides Allāh [false] deities that perhaps they would be helped.", "words": [{"id": 1, "arabic": "وَٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱَw", "root": "اخذ"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 6, "arabic": "لَّعَلَّهُمْ", "translit": "ْmُhَّlَʿعَّl", "root": ""}, {"id": 7, "arabic": "يُنصَرُونَ", "translit": "َnwُrَṣnُy", "root": "نصر"}], "hasIhya": false}, {"ayah": 75, "text": "لَا يَسْتَطِيعُونَ نَصْرَهُمْ وَهُمْ لَهُمْ جُندٌ مُّحْضَرُونَ ", "translation": "They are not able to help them, and they [themselves] are for them soldiers in attendance.[1]", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 3, "arabic": "نَصْرَهُمْ", "translit": "ْmُhَrْṣَn", "root": "نصر"}, {"id": 4, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 5, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 6, "arabic": "جُندٌ", "translit": "ٌdnُjg", "root": "جند"}, {"id": 7, "arabic": "مُّحْضَرُونَ", "translit": "َnwُrَḍْḥُّm", "root": "حضر"}], "hasIhya": false}, {"ayah": 76, "text": "فَلَا يَحْزُنكَ قَوْلُهُمْۘ إِنَّا نَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَ ", "translation": "So let not their speech grieve you. Indeed, We know what they conceal and what they declare.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "يَحْزُنكَ", "translit": "َknُzْḥَy", "root": "حزن"}, {"id": 3, "arabic": "قَوْلُهُمْ", "translit": "ْmُhُlْwَq", "root": "قول"}, {"id": 4, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 5, "arabic": "نَعْلَمُ", "translit": "ُmَlْʿعَn", "root": "علم"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "يُسِرُّونَ", "translit": "َnwُّrِsُy", "root": "سرر"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "يُعْلِنُونَ", "translit": "َnwُnِlْʿعُy", "root": "علن"}], "hasIhya": false}, {"ayah": 77, "text": "أَوَلَمْ يَرَ ٱلْإِنسَٰنُ أَنَّا خَلَقْنَٰهُ مِن نُّطْفَةٍ فَإِذَا هُوَ خَصِيمٌ مُّبِينٌ ", "translation": "Does man not consider that We created him from a [mere] sperm-drop - then at once[1] he is a clear adversary?", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَ", "translit": "َrَy", "root": "راي"}, {"id": 3, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 5, "arabic": "خَلَقْنَٰهُ", "translit": "ُhَٰnْqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "نُّطْفَةٍ", "translit": "ٍẗَfْṭُّn", "root": "نطف"}, {"id": 8, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 9, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 10, "arabic": "خَصِيمٌ", "translit": "ٌmyِṣَhk", "root": "خصم"}, {"id": 11, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 78, "text": "وَضَرَبَ لَنَا مَثَلًا وَنَسِىَ خَلْقَهُۥۖ قَالَ مَن يُحْىِ ٱلْعِظَٰمَ وَهِىَ رَمِيمٌ ", "translation": "And he presents for Us an example[1] and forgets his [own] creation. He says, \"Who will give life to bones while they are disintegrated?\"", "words": [{"id": 1, "arabic": "وَضَرَبَ", "translit": "َbَrَḍَw", "root": "ضرب"}, {"id": 2, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "وَنَسِىَ", "translit": "َàِsَnَw", "root": "نسي"}, {"id": 5, "arabic": "خَلْقَهُۥ", "translit": "ۥُhَqْlَhk", "root": "خلق"}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "يُحْىِ", "translit": "ِàْḥُy", "root": "حيي"}, {"id": 9, "arabic": "ٱلْعِظَٰمَ", "translit": "َmَٰẓِʿعْlٱ", "root": "عظم"}, {"id": 10, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 11, "arabic": "رَمِيمٌ", "translit": "ٌmyِmَr", "root": "رمم"}], "hasIhya": true}, {"ayah": 79, "text": "قُلْ يُحْيِيهَا ٱلَّذِىٓ أَنشَأَهَآ أَوَّلَ مَرَّةٍۖ وَهُوَ بِكُلِّ خَلْقٍ عَلِيمٌ ", "translation": "Say, \"He will give them life who produced them the first time; and He is, of all creation, Knowing.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يُحْيِيهَا", "translit": "āَhyِyْḥُy", "root": "حيي"}, {"id": 3, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أَنشَأَهَآ", "translit": "ٓāَhَaʾَhsnَaʾ", "root": "نشا"}, {"id": 5, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 6, "arabic": "مَرَّةٍ", "translit": "ٍẗَّrَm", "root": "مرر"}, {"id": 7, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 8, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 9, "arabic": "خَلْقٍ", "translit": "ٍqْlَhk", "root": "خلق"}, {"id": 10, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 80, "text": "ٱلَّذِى جَعَلَ لَكُم مِّنَ ٱلشَّجَرِ ٱلْأَخْضَرِ نَارًا فَإِذَآ أَنتُم مِّنْهُ تُوقِدُونَ ", "translation": "[It is] He who made for you from the green tree, fire, and then from it you ignite.", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 5, "arabic": "ٱلشَّجَرِ", "translit": "ِrَjgَّhslٱ", "root": "شجر"}, {"id": 6, "arabic": "ٱلْأَخْضَرِ", "translit": "ِrَḍْhkَaʾْlٱ", "root": "خضر"}, {"id": 7, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 8, "arabic": "فَإِذَآ", "translit": "ٓāَhdِiʾَf", "root": ""}, {"id": 9, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 10, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 11, "arabic": "تُوقِدُونَ", "translit": "َnwُdِqwُt", "root": "وقد"}], "hasIhya": false}, {"ayah": 81, "text": "أَوَلَيْسَ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ بِقَٰدِرٍ عَلَىٰٓ أَن يَخْلُقَ مِثْلَهُمۚ بَلَىٰ وَهُوَ ٱلْخَلَّٰقُ ٱلْعَلِيمُ ", "translation": "Is not He who created the heavens and the earth Able to create the likes of them? Yes, [it is so]; and He is the Knowing Creator.", "words": [{"id": 1, "arabic": "أَوَلَيْسَ", "translit": "َsْyَlَwَaʾ", "root": "ليس"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "بِقَٰدِرٍ", "translit": "ٍrِdَٰqِb", "root": "قدر"}, {"id": 7, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يَخْلُقَ", "translit": "َqُlْhkَy", "root": "خلق"}, {"id": 10, "arabic": "مِثْلَهُم", "translit": "mُhَlْhtِm", "root": "مثل"}, {"id": 11, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 12, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 13, "arabic": "ٱلْخَلَّٰقُ", "translit": "ُqَّٰlَhkْlٱ", "root": "خلق"}, {"id": 14, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 82, "text": "إِنَّمَآ أَمْرُهُۥٓ إِذَآ أَرَادَ شَيْـًٔا أَن يَقُولَ لَهُۥ كُن فَيَكُونُ ", "translation": "His command is only when He intends a thing that He says to it, \"Be,\" and it is.", "words": [{"id": 1, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَمْرُهُۥٓ", "translit": "ٓۥُhُrْmَaʾ", "root": "امر"}, {"id": 3, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 4, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 5, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "يَقُولَ", "translit": "َlwُqَy", "root": "قول"}, {"id": 8, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 9, "arabic": "كُن", "translit": "nُk", "root": "كون"}, {"id": 10, "arabic": "فَيَكُونُ", "translit": "ُnwُkَyَf", "root": "كون"}], "hasIhya": false}, {"ayah": 83, "text": "فَسُبْحَٰنَ ٱلَّذِى بِيَدِهِۦ مَلَكُوتُ كُلِّ شَىْءٍ وَإِلَيْهِ تُرْجَعُونَ ", "translation": "So exalted is He in whose hand is the realm of all things, and to Him you will be returned.", "words": [{"id": 1, "arabic": "فَسُبْحَٰنَ", "translit": "َnَٰḥْbُsَf", "root": "سبح"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "بِيَدِهِۦ", "translit": "ۦِhِdَyِb", "root": "يدي"}, {"id": 4, "arabic": "مَلَكُوتُ", "translit": "ُtwُkَlَm", "root": "ملك"}, {"id": 5, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 6, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 7, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 8, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": false}], "tafsir": {"7": [{"arabic": "كالأنعام بل هم أضل سبيلا وبقوله عز وجل لقد حق القول على أكثرهم فهم لا يؤمنون وبقوله سواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ورب قلب هذا حاله بالإضافة إلى بعض الشهوات كالذي يتورع عن بعض الأشياء ولكنه إذا رأى وجها حسنا لم يملك عينه وقلبه وطاش عقله وسقط مساك قلبه أو كالذي لا يملك نفسه فيما فيه الجاه والرياسة والكبر ولا يبقى معه مسكة للتثبت عند ظهور أسبابه أو كالذي لا يملك نفسه عند الغضب مهما استحقر وذكر عيب من عيوبه أو كالذي لا يملك نفسه عند القدرة على أخذ درهم أو دينار بل يتهالك عليه تهالك الواله المستهتر فينسى فيه ال", "english": "Know that the heart, as we have mentioned, is surrounded by the attributes we have described, and the traces and states pour into it from the gateways we have set forth. It is as if it were a target perpetually struck from every side. When something afflicts it, it is affected by it; then it is struck from another side by that which opposes it, and so its state changes. If the devil descends upon it and calls it to passion (hawā), the angel descends upon it and turns it away from that. If one devil drags it toward evil, another devil drags it toward something else; and if one angel draws it toward good, another draws it toward something else. Thus at times it is contested between two angels, at times between two devils, and at times between an angel and a devil — it is never, ever left neglected. To this points the saying of the Exalted: {وَنُقَلِّبُ أَفْئِدَتَهُمْ وَأَبْصَارَهُمْ} (And We turn their hearts and their visions) {«الأنعام/110»}. And because the Messenger of Allah (peace and blessings be upon him) was privy to the wondrous handiwork of Allah the Exalted in the marvels of the heart and its overturning, he used to swear by it, saying: \"No, by the Turner of the hearts.\" (1)", "book_title": "Disciplining the Soul", "section_title_ar": "Section 610", "section_title_en": "The Wonders of the Heart: Its States of Stability, Inclination, and Fluctuation Between the Two Attracting Forces", "section_index": 610, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn a thing over, to revolve it, to divert it from one face to another; the heart is so named for its constant turning and fluctuation.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's perpetual overturning is its very essence; its states are never fixed, and its rectitude or corruption follows its turning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" — physical overturning. Metaphorical (Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; the heart's fluctuation between the two attractants is a real, continuous overturning.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the opening sentence, with its cascading circumstantial clauses, requires careful tracking of the governing verb and its dependent states to preserve the causal sequence of the heart's affliction and response.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "8": [{"arabic": "وقال الضحاك في قوله تعالى إنا جعلنا في أعناقهم أغلالا قال البخل أمسك الله تعالى أيديهم عن النفقة في سبيل الله فهم لا يبصرون الهدى وقال كعب ما من صباح إلا وقد وكل به ملكان يناديان اللهم عجل لممسك تلفا", "english": "God the Exalted said: {«And whoever is saved from the covetousness of his own soul — those are the successful»} (al-Hashr 59:9). And He said the Exalted: {«And let not those who withhold stingily what God has given them of His bounty suppose that it is good for them. Rather, it is evil for them. They shall be collared with what they withheld on the Day of Resurrection»} (Al 'Imran 3:180). And He said the Exalted: {«Those who are stingy and command people to stinginess, and conceal what God has given them of His bounty»} (al-Nisa' 4:37).", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 773", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 773: On the Condemnation of Stinginess (Al-Bukhl) and Covetousness (Al-Shuhh)", "section_index": 773, "anchors": "- Root: بخل (B-Kh-L)\n  * Lisan / Ayn: Core meaning is withholding or restraining that which one possesses from what does not rightfully permit its detention. Al-Khalil notes: \"بَخِلَ بَخَلاً وبُخْلاً فهو بَخِيلٌ بَخَّالٌ مُبَخِّلٌ. والبَخْلَةُ: بُخْلُ مَرَّةٍ وَاحِدَةٍ.\"\n  * Al-Raghib (Mufradat): \"البخل: إمساك المقتنيات عما لا يحق حبسها عنه، ويقابله الجود... والبخل ضربان: بخل بقنيات نفسه، وبخل بقنيات غيره، وهو أكثرها ذما.\" — Stinginess is of two kinds: withholding one's own possessions, and withholding what belongs to others (i.e., covetousness, shuhh), the latter being more blameworthy.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"فلان لم يبخل ولم يبخل، وما كانت منه بخلة قط.\" Metaphorical (Majaz): \"إذا السماء بخلت بالفطر\" — the sky \"withholding\" rain is a metaphorical extension of the root.\n- Root: شح (Sh-H-H)\n  * Lisan / Ayn: The root denotes intense covetousness combined with avarice — a grasping desire for what others possess alongside a tight-fisted withholding of one's own.\n  * Al-Raghib (Mufradat): The distinction between shuhh and bukhl: shuhh is the more severe — it is the inner disposition of craving that drives one to seize what is in others' hands and to cling to what is in one's own; bukhl is its outward manifestation in withholding.\n  * Al-Zamakhshari (Asas): The rhetorical usage in the hadith \"اتقوا الشح\" employs the term in its comprehensive sense, encompassing both the inward vice and its outward acts.\n- Root: ظلم (Z-L-M)\n  * Lisan / Ayn: The root signifies placing something in other than its proper position; darkness (zulmah) is its sensory correlate.\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور... ويعبر بها عن الجهل والشرك والفسق\" — darkness is used metaphorically for ignorance, polytheism, and transgression.\n  * Al-Zamakhshari (Asas): Literal: \"الظلم ظلمات يوم القيامة\" — injustice is darknesses on the Day of Resurrection. Metaphorical: \"أرض مظلومة: حفر فيها بئر\" — a land \"wronged\" by being dug into for the first time.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase, as in the hadith \"إياكم والشح فإنه أهلك من كان قبلكم,\" where the warning construction (إياكم) governs the subsequent clause with rhetorical emphasis.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Du'a"}], "9": [{"arabic": "مقمحون وجعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون وسواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون} ولا يغرنك لفظ الإيمان فنقول المراد بالآية الكافر إذ بين لك أن الإيمان بضع وسبعون بابا وأن الزاني لا يزني حين يزني وهو مؤمن فالمحجوب عن الإيمان الذي هو شعب وفروع سيحجب في الخاتمة عن الإيمان الذي هو أصل كما أن الشخص الفاقد لجميع الأطراف التي هي حروف وفروع سيساق إلى الموت المعدم للروح التي هي أصل فلا بقاء للأصل دون الفرع بيان أن وجوب التوبة على الفور ولا وجود للفرع دون الأصل ولا فرق بين الأصل والفرع إلا في شيء واحد وهو أن وجود الفرع و", "english": "So haste, haste (al-bidār al-bidār) to repentance, before the poisons of sins work upon the spirit of faith a work that surpasses the physicians' art and their choice, after which no abstention (iḥtimāʾ) avails. After that, the counsel of counselors and the exhortation of exhorters will not succeed. And the Word will be fulfilled against him, that he is among the perished, and he falls under the general import of His saying — exalted be He: {«إنا جعلنا في أعناقهم أغلالا فهي إلى الأذقان فهم مقمحون وجعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون وسواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون»} (Ya-Sin: 8–10). And let not the mere utterance of faith (īmān) deceive you, such that we say: The verse refers only to the disbeliever — for it has been made clear to you that faith has seventy-some branches, and that the fornicator does not fornicate at the moment of fornication while he is a believer. Thus, the one veiled from faith — which is its branches and offshoots — will be veiled at the final seal from faith — which is its root. Just as a person who has lost all his limbs — which are, as it were, letters and branches — will inevitably be driven to death, which annihilates the spirit — which is the root. For the root has no endurance without the branch.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 920", "section_title_en": "The Obligation of Immediate Repentance — The Poison of Sins and the Severing of the Artery of the Knowers", "section_index": 920, "anchors": "- Root: نياط (nīāṭ)\n  * Lisan / Ayn: The aorta or vital artery; that which, if severed, causes death.\n  * Al-Raghib (Mufradat): The vital thread connecting soul to body; metaphorically, the spiritual lifeline.\n  * Al-Zamakhshari (Asas): Literal: the jugular vein. Metaphorical: the point of no return; \"انقطع نياطه\" = his life-thread was cut.\n- Root: ختم (khatama)\n  * Lisan / Ayn: To seal, stamp, or impress a mark.\n  * Al-Raghib (Mufradat): Sealing of the heart as divine restriction and veiling from guidance.\n  * Al-Zamakhshari (Asas): Literal: affixing a seal. Metaphorical: final sealing of one's fate at death (khatimat al-ʿamal).\n- Root: أصل (aṣl) / فرع (farʿ)\n  * Lisan / Ayn: Root/base vs. branch/twig.\n  * Al-Raghib (Mufradat): The root is the foundation; the branch is that which grows from it. Quranic: {أصلها ثابت وفرعها في السماء} (Ibrahim: 24).\n  * Al-Zamakhshari (Asas): Literal: tree root and branch. Metaphorical: the root (aṣl) of faith vs. its branches (furūʿ); the root of life (spirit) vs. its branches (limbs).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that the obligation of repentance is immediate and unrestricted, as in \"فالبدار البدار\" (haste, haste!) — an emphatic accusative of exhortation (ikhtiṣāṣ).", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Patience and Gratitude'", "badge": "Afterlife"}, {"arabic": "الطريق قال الله تعالى {وجعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون} والسد بين المريد وبين الحق أربعة المال والجاه والتقليد والمعصية وإنما يرفع حجاب المال بخروجه عن ملكه حتى لا يبقى له إلا قدر الضرورة فما دام يبقى له درهم يلتفت إليه فهو مقيد به محجوب عن الله عز وجل وإنما يرتفع حجاب الجاه بالبعد عن موضع الجاه بالتواضع وإيثار الخمول والهرب من أسباب الذكر وتعاطي أعمال تنفر قلوب الخلق عنه وإنما يرتفع حجاب التقليد بأن يترك التعصب للمذاهب وأن يصدق بمعنى قوله لا إله إلا الله محمد رسول الله تصديق إيمان ويحرض في تحقيق صدقه بأن ير", "english": "As for the conditions that must be set forth in the resolve: they are the lifting of the barrier and the veil that lies between him and the Truth. For the deprivation of creation from the Truth is caused by the accumulation of veils and the placing of a barrier upon the road. God Most High said: {«وجعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون»} (\"And We have placed before them a barrier and behind them a barrier, and We have covered them, so they do not see\").", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 635", "section_title_en": "On the Sale of the Pearl to the Jewel — The Conditions of the Seeker's Beginning", "section_index": 635, "anchors": "- Root: سلك (salaka)\n  * Lisan / Ayn: To penetrate, pass through, traverse a path; threading a thread through a needle.\n  * Al-Raghib (Mufradat): \"السلوك: النفاذ في الطريق\" — spiritual-moral passage through the path; used of one's course of action, whether praiseworthy or blameworthy.\n  * Al-Zamakhshari (Asas): Literal: \"طريق مسلوك\" (a trodden path). Metaphorical: \"كلام دقيق السلك: خفي المسلك\" — subtle speech whose passage is hidden; here, the path to God is a spiritual traversal requiring a guide.\n- Root: صدق (ṣadaqa)\n  * Lisan / Ayn: Truthfulness in speech and resolve; sincerity of intention.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood are rooted in utterance, but true faith (taṣdīq) is the heart's verification, not mere verbal assent.\n  * Al-Zamakhshari (Asas): Literal: \"صدقته الحديث\" (I affirmed his speech). Metaphorical: \"رجل صادق الحملة\" — one truthful in his charge/assault; here, the one who \"affirms\" the pearl but knows only its name lacks true verification.\n- Root: طرق (ṭaraqa)\n  * Lisan / Ayn: Striking, beating; a path beaten by feet.\n  * Al-Raghib (Mufradat): \"الطريق: السبيل الذي يطرق بالأرجل\" — the way is that which is trodden; metaphorically extended to every course one pursues in action.\n  * Al-Zamakhshari (Asas): Literal: \"طرق الباب: قرعه\" (to knock at a door). Metaphorical: \"طرقني الخيال\" (the phantom visited me by night); \"طرقه الزمان بنوائبه\" (time struck him with calamities) — here, the \"blockers of the road\" (قطاع الطريق) are spiritual bandits.\n- Sibawayh Rule: Restriction and qualification (الحصر والتقييد) — the conditional clauses (إذا/فإن) structure the periodic sentence, linking protasis (condition) to apodosis (result) to establish causal necessity in the spiritual path.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Breaking the Two Desires'", "badge": "Du'a"}, {"arabic": "المراد بقوله تعالى وجعلنا من بين أيديهم سدا ومن خلفهم سدا الآية ولذلك قال رضي الله تعالى عنه إن الإيمان ليبدو في القلب نكتة بيضاء كلما ازداد الإيمان ازداد ذلك البياض فإذا استكمل العبد الإيمان أبيض القلب كله وإن النفاق ليبدو في القلب نكتة سوداء كلما ازداد النفاق ازداد ذلك السواد فإذا استكمل النفاق أسود القلب كله فإذا عرفت أن الأخلاق الحسنة تارة تكون بالطبع والفطرة وتارة تكون باعتياد الأفعال الجميلة وتارة بمشاهدة أرباب الفعال الجميلة ومصاحبتهم وهم قرناء الخير وإخوان الصلاح إذ الطبع يسرق من الطبع الشر والخير جميعا فمن", "english": "For this reason, may God be well pleased with him, said: \"Faith indeed appears in the heart as a white spot; whenever faith increases, that whiteness increases, until when the servant perfects faith, the whole heart becomes white. And hypocrisy indeed appears in the heart as a black spot; whenever hypocrisy increases, that blackness increases, until when hypocrisy is perfected, the whole heart becomes black.\"", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 621", "section_title_en": "The Gradual Acquisition of Moral Character and the Detailed Exposition of the Path to Refining Ethics", "section_index": 621, "anchors": "- Root: فقه (Fiqh)\n  * Lisan / Ayn: Comprehension and understanding of a matter's inward reality; deep penetration into meaning.\n  * Al-Raghib (Mufradat): \"الفقه: هو التوصل إلى علم غائب بعلم شاهد\" — Fiqh is attaining knowledge of the unseen through the witnessed; it is more specific than mere knowledge ('ilm), denoting a settled, abiding comprehension.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"افقه عني ما أقول لك\" — grasp what I say to you. The term denotes active, engaged understanding, not passive reception.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, the soul; that which desires proximity and discourse; the principle of life and animation.\n  * Al-Raghib (Mufradat): The soul as the seat of both blameworthy and praiseworthy traits; its purification (tazkiyah) is the goal of moral discipline.\n  * Al-Zamakhshari (Asas): Literal vs. Metaphorical: \"نفس\" as blood (the life-fluid) versus the immaterial self; here, \"فقيه النفس\" denotes one whose very soul has become imbued with the habit of deep understanding — a settled disposition, not a transient state.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; that which turns and is turned (taqlib), the organ of fluctuating states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant turning and overturning between states; it is the seat of both faith and hypocrisy, whiteness and blackness.\n  * Al-Zamakhshari (Asas): Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — to turn something about, to manage and dispose; the heart is that which is turned by habits until it becomes fixed in one direction.\n- Root: جمل (Jaml)\n  * Lisan / Ayn: Beauty and comeliness; the sum total of a thing; that which is gathered and collected.\n  * Al-Raghib (Mufradat): \"الجمال: الحسن الكثير\" — beauty in abundance; both inward (character) and outward (action).\n  * Al-Zamakhshari (Asas): Literal: \"فلان يعامل الناس بالجميل\" — dealing with people beautifully; here, \"الأفعال الجميلة\" are the beautiful, virtuous actions whose repetition forms character.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The construction \"لا طريق له إلا أن\" (there is no path for him except that) effects complete restriction (hasr), confining the means of moral transformation to a single, specified avenue: the repetition of acts until they become nature.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "10": [{"arabic": "يؤمنون وبقوله سواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ورب قلب هذا حاله بالإضافة إلى بعض الشهوات كالذي يتورع عن بعض الأشياء ولكنه إذا رأى وجها حسنا لم يملك عينه وقلبه وطاش عقله وسقط مساك قلبه أو كالذي لا يملك نفسه فيما فيه الجاه والرياسة والكبر ولا يبقى معه مسكة للتثبت عند ظهور أسبابه أو كالذي لا يملك نفسه عند الغضب مهما استحقر وذكر عيب من عيوبه أو كالذي لا يملك نفسه عند القدرة على أخذ درهم أو دينار بل يتهالك عليه تهالك الواله المستهتر فينسى فيه المروءة والتقوى فكل ذلك لتصاعد دخان الهوى إلى القل", "english": "Know that the heart, as we have mentioned, is surrounded by the attributes we have described, and the traces and states pour into it from the gateways we have set forth. It is as if it were a target perpetually struck from every side. When something afflicts it, it is affected by it; then it is struck from another side by that which opposes it, and so its state changes. If the devil descends upon it and calls it to passion (hawā), the angel descends upon it and turns it away from that. If one devil drags it toward evil, another devil drags it toward something else; and if one angel draws it toward good, another draws it toward something else. Thus at times it is contested between two angels, at times between two devils, and at times between an angel and a devil — it is never, ever left neglected. To this points the saying of the Exalted: {وَنُقَلِّبُ أَفْئِدَتَهُمْ وَأَبْصَارَهُمْ} (And We turn their hearts and their visions) {«الأنعام/110»}. And because the Messenger of Allah (peace and blessings be upon him) was privy to the wondrous handiwork of Allah the Exalted in the marvels of the heart and its overturning, he used to swear by it, saying: \"No, by the Turner of the hearts.\" (1)", "book_title": "Disciplining the Soul", "section_title_ar": "Section 610", "section_title_en": "The Wonders of the Heart: Its States of Stability, Inclination, and Fluctuation Between the Two Attracting Forces", "section_index": 610, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn a thing over, to revolve it, to divert it from one face to another; the heart is so named for its constant turning and fluctuation.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's perpetual overturning is its very essence; its states are never fixed, and its rectitude or corruption follows its turning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" — physical overturning. Metaphorical (Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; the heart's fluctuation between the two attractants is a real, continuous overturning.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of the opening sentence, with its cascading circumstantial clauses, requires careful tracking of the governing verb and its dependent states to preserve the causal sequence of the heart's affliction and response.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "12": [{"arabic": "ويسئل عنها إلى آخر انقراضها وقال تعالى {ونكتب ما قدموا وآثارهم} أي نكتب أيضا ما أخروه من آثار أعمالهم كما نكتب ما قدموه وفي مثله قوله تعالى {ينبأ الإنسان يومئذ بما قدم وأخر} وإنما أخر آثار أعماله من سنة سيئة عمل بها غيره وليعلم أن في الزيف خمسة أمور الأول أنه إذا رد عليه شيء منه فينبغي أن يطرحه في بئر بحيث لا تمتد إليه اليد وإياه أن يروجه في بيع آخر وإن أفسده بحيث لا يمكن التعامل به جاز الثاني أنه يجب على التاجر تعلم النقد لا ليستقصي لنفسه ولكن لئلا يسلم إلى مسلم زيفا وهو لا يدري فيكون آثما بتقصيره في تعل", "english": "Know that the circulation of counterfeit coinage (*al-zuyūf*) during the course of payment is an injustice (*ẓulm*), for the one who transacts with it is harmed thereby — if he does not recognize it [as counterfeit], he is injured; and if he does recognize it, he will circulate it to another. And so likewise with the third and the fourth [recipient]. It continues to pass from hand to hand, the harm becomes general, the corruption spreads widely, and the burden (*wizr*) of all of it and its evil consequence reverts upon him [the originator] — for he it is who opened this door. The Messenger of God, peace and blessings be upon him, said: {«مَنْ سَنَّ سُنَّةً سَيِّئَةً فَعُمِلَ بِهَا مِنْ بَعْدِهِ كَانَ عَلَيْهِ وِزْرُهَا وَمِثْلُ وِزْرِ مَنْ عَمِلَ بِهَا لَا يَنْقُصُ مِنْ أَوْزَارِهِمْ شَيْئًا»} (\"Whoever institutes an evil practice and it is acted upon after him, upon him is its burden and the like of the burden of those who act upon it, without diminishing anything from their burdens.\")", "book_title": "Etiquette of Earning", "section_title_ar": "Section 324", "section_title_en": "Section 324 — On the Circulation of Counterfeit Coinage and Its Grave Consequences", "section_index": 324, "anchors": "- **Root: زيف (z-y-f)**\n  * *Lisan / Ayn*: Core meaning of falsification, adulteration, and counterfeiting — that which is false in its substance, not merely in its claim.\n  * *Al-Raghib (Mufradat)*: The theological dimension concerns the *spreading of corruption* (ifsād) through deceptive transactions — a form of *ẓulm* (injustice) that multiplies as the counterfeit passes from hand to hand.\n  * *Al-Zamakhshari (Asas)*: Literal (*ḥaqīqah*): false coinage. Metaphorical (*majāz*): the *sunnah sayyiʾah* (evil precedent) — the one who originates it bears its burden and the burden of those who follow it.\n\n- **Root: وزر (w-z-r)**\n  * *Lisan / Ayn*: The heavy burden (*al-wizr*), the load one carries; also the mountain refuge. The *wāzir* is the bearer of the burden.\n  * *Al-Raghib (Mufradat)*: Used for sin (*ithm*) as a heavy burden upon the soul. The one who originates an evil practice carries his own burden and the burdens of those who follow him — as in {«وَلَيَحْمِلُنَّ أَثْقَالَهُمْ وَأَثْقَالًا مَّعَ أَثْقَالِهِمْ»} (Al-ʿAnkabūt: 13).\n  * *Al-Zamakhshari (Asas)*: Literal: carrying a physical load. Metaphorical: bearing the weight of sin — \"he is *mawzūr*, not *maʾjūr*\" (burdened with sin, not rewarded).\n\n- **Root: سنن (s-n-n)**\n  * *Lisan / Ayn*: The path or way (*al-ṭarīqah*); to institute a practice or precedent.\n  * *Al-Raghib (Mufradat)*: *Sunnah* as the established pattern — whether good or evil. The Prophet ﷺ said: \"Whoever institutes a good sunnah...\" and \"Whoever institutes an evil sunnah...\"\n  * *Al-Zamakhshari (Asas)*: Literal: the beaten path. Metaphorical: the moral precedent that others follow — its originator is accountable for all who walk it after him.\n\n- **Sibawayh Rule**: *Bāb al-ḥaṣr wa al-taqyīd bi-innamā* (Restriction and Focused Predication) — used in the phrase \"إنما يتخلص من إثم الضرر الذي يخص معامله فقط\" to restrict the scope of absolution to the specific harm done to one's immediate transactor, not the general harm propagated through subsequent circulation.\n\n---\n\n##", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Earning'", "badge": "Hadith"}], "15": [{"arabic": "السبب الرابع التعجب كما أخبر الله تعالى عن الأمم السالفة إذ قالوا ما أنتم إلا بشر مثلنا وقالوا أنؤمن لبشرين مثلنا ولئن أطعتم بشرا مثلكم إنكم إذا لخاسرون فتعجبوا من أن يفوز برتبة الرسالة والوحي والقرب من الله تعالى بشر مثلهم فحسدوهم وأحبوا زوال النبوة عنهم جزعا أن يفضل عليهم من هو مثلهم في الخلقة لا عن قصد تكبر وطلب رياسة وتقدم عداوة أو سبب آخر من سائر الأسباب وقالوا متعجبين أبعث الله بشرا رسولا {وقالوا} لولا أنزل علينا الملائكة وقال تعالى أو عجبتم أن جاءكم ذكر من ربكم على رجل منكم الآية السبب الخامس الخوف من فوت المقاصد وذلك يختص بم", "english": "I say: God is Knower of what is in the breasts. {«إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ»} — \"If good touches you, it grieves them\" {«وَدُّوا مَا عَنِتُّمْ قَدْ بَدَتِ الْبَغْضَاءُ مِنْ أَفْوَاهِهِمْ وَمَا تُخْفِي صُدُورُهُمْ أَكْبَرُ»} — \"They wish for your hardship; hatred has already appeared from their mouths, and what their breasts conceal is greater.\" And envy (ḥasad), arising from hatred, may lead to contention, mutual fighting, and the spending of one's entire life in removing another's blessing through stratagems, slander, the tearing of veils, and whatever runs in that course.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 722", "section_title_en": "The Revival of the Religious Sciences — Book on the Rebuke of the Self: The Seven Causes of Envy (Section 722)", "section_index": 722, "anchors": "- Root: سبب (sabab)\n  * Lisan / Ayn: The rope by which one climbs; every means by which one reaches a thing.\n  * Al-Raghib (Mufradat): \"Every means by which one arrives at something is called a sabab\" — thus the causes enumerated here are the psychological \"ropes\" by which envy ascends in the soul.\n  * Al-Zamakhshari (Asas): Literal: a physical cord. Metaphorical: any linkage or occasion — here, the inward occasions (asbāb) that give rise to ḥasad.\n- Root: بغض (bughḍ)\n  * Lisan / Ayn: Hatred, aversion of the heart.\n  * Al-Raghib (Mufradat): The opposite of love (maḥabbah); a disposition of the heart toward another's harm.\n  * Al-Zamakhshari (Asas): Literal: inner aversion. Metaphorical: its \"appearance from the mouths\" (Quranic) as outward speech betraying the concealed hatred.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Greatness; pride; disdain.\n  * Al-Raghib (Mufradat): \"Al-kabīr and al-ṣaghīr are relative terms\" — pride is the claim to greatness relative to another, deeming oneself above him.\n  * Al-Zamakhshari (Asas): Literal: bigness in stature or age. Metaphorical: \"takabbara 'alayhi\" — to deem oneself greater than another and refuse submission to him.\n- Root: قصد (qaṣd)\n  * Lisan / Ayn: Straightness of path; intending a goal.\n  * Al-Raghib (Mufradat): \"Al-qaṣd: istiqāmat al-ṭarīq\" — the straight road; also moderation between extremes.\n  * Al-Zamakhshari (Asas): Literal: to head toward a place. Metaphorical: \"maqāṣid\" — the aims and objectives toward which one directs oneself; here, the worldly goals whose pursuit breeds rivalry and envy.\n- Root: نزل (nazal)\n  * Lisan / Ayn: To descend from a height; to alight.\n  * Al-Raghib (Mufradat): \"Al-nuzūl fī al-aṣl huwa inḥiṭāṭ min 'uluww\" — descent from above; the sending down of revelation.\n  * Al-Zamakhshari (Asas): Literal: descending from a high place. Metaphorical: \"anzala Allāhu al-kitāb\" — God's sending down of the Quran; and \"mā unzila\" — what was revealed, as in the Quranic citation regarding the Qurashites' objection to revelation upon a mere human.\n- Sibawayh Rule: Rule of Causal Coordination (al-'aṭf al-sababī) — The enumeration of the seven causes proceeds by coordinated clauses (fa-... thumma ...), each introduced as an independent proposition linked by causation (sabab), requiring the translator to preserve the logical sequence of psychological motivations without collapsing them into one another.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "30": [{"arabic": "رسولا منه فما يعتبرون فيا حسرة على العباد ما يأتيهم من رسول إلا كانوا به يستهزئون أفيظنون أنهم في الدنيا خالدون أو لم يروا كم أهلكنا قبلهم من القرون أنهم إليهم لا يرجعون أم يحسبون أن الموتى سافروا من عندهم فهم معدمون كلا وإن كل لما جميع لدينا محضرون {ولكن} ما تأتيهم من آية من آيات ربهم إلا كانوا عنها معرضين وذلك لأنا جعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون وسواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ولنرجع إلى الغرض فإن هذه تلويحات تشير إلى أمور هي أعلى من علوم المعاملة فنقول ظهر أن الصبر عبارة عن ثبات", "english": "How immense is your heedlessness, O wretched one—and all of us are that wretched one—while before you are these terrors! If you do not believe in the greater resurrection out of ignorance and error, does not the evidence of the lesser resurrection suffice you? Have you not heard the saying of the Master of the Prophets, peace be upon him: \"Sufficient is death as a warner\" (kafā bil-mawti wāʿiẓan)? Have you not heard of his weeping, peace be upon him, at death, until he said, may God's peace and blessing be upon him: \"O God, ease for Muhammad the agonies of death\" (allāhumma hawwin ʿalā Muḥammadin sakarāti al-mawt)? Are you not ashamed of your slowness in anticipating the onslaught of death, following the rabble of the heedless—those who look only for a single cry that seizes them while they are disputing, so they can neither make a bequest nor return to their families? Then illness comes to them as a warner of death, and they are not deterred; and gray hair comes to them as a messenger from it, and they do not take heed. {«يَا حَسْرَةً عَلَى الْعِبَادِ مَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ»} (O regret upon the servants! There comes not to them a messenger but they mock him) [Ya-Sin: 30]. Do they think that they are in this world immortal? {«أَوَلَمْ يَرَوْا كَمْ أَهْلَكْنَا قَبْلَهُمْ مِنَ الْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ»} (Have they not seen how many generations We destroyed before them—that they will not return to them?) [Ya-Sin: 31]. Or do they reckon that the dead have merely traveled away from them, and so they are annihilated? Nay! {«وَإِنْ كُلٌّ لَمَّا جَمِيعٌ لَدَيْنَا مُحْضَرُونَ»} (And indeed, all of them, without exception, will be brought before Us) [Ya-Sin: 32]. {«وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ»} (And there comes not to them a sign from the signs of their Lord but they turn away from it) [Ya-Sin: 46]. And that is because {«إِنَّا جَعَلْنَا مِنْ بَيْنِ أَيْدِيهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا فَأَغْشَيْنَاهُمْ فَهُمْ لَا يُبْصِرُونَ»} (We have placed before them a barrier and behind them a barrier, and We have covered them, so they do not see) [Ya-Sin: 9]. {«وَسَوَاءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُونَ»} (And it is alike to them whether you warn them or warn them not—they will not believe) [Ya-Sin: 10].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 958", "section_title_en": "On the Lesser Resurrection as Proof of the Greater, and the Station of the Guardian over the Child", "section_index": 958, "anchors": "- Root: صغر (ṣaghara)\n  * Lisan / Ayn: Smallness in magnitude, rank, or time; the lesser as opposed to the greater (al-kabīr), each term relative to the other.\n  * Al-Raghib (Mufradat): Ṣighar and kibar are relative opposites, applied variously to age, body, or station; here, the \"lesser resurrection\" (al-qiyāmah al-ṣughrā) is death, measured against the \"greater\" (al-kubrā), the final rising.\n  * Al-Zamakhshari (Asas): Literal: diminution in size or status. Metaphorical: the lesser as a type or foreshadow of the greater—death as the microcosmic analogue of the macrocosmic resurrection.\n- Root: موت (mawt)\n  * Lisan / Ayn: Death as the cessation of animal life; the root also yields \"amāta\" (to cause death) and \"mayyit\" (the dead).\n  * Al-Raghib (Mufradat): Death is the departure of the soul from the body, a transition between two abodes; it is the \"lesser resurrection\" in that it separates the spirit from the corporeal frame, prefiguring the greater separation and recompense.\n  * Al-Zamakhshari (Asas): Literal: biological death. Metaphorical: \"the dead land\" revived by rain, and here, death as a \"warner\" (nadhīr) and \"messenger\" (rasūl)—personified agencies of admonition.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge as perception or cognition of a thing; \"ʿallama\" (to teach) and \"ʿālim\" (the knowing one).\n  * Al-Raghib (Mufradat): ʿIlm is apprehension of a thing's reality—either its essence or a judgment about it. Here, the \"knowledge\" of the two resurrections distinguishes the believer (muʾmin) from the ignorant (jāhil), who sees with a \"blind eye\" (al-ʿayn al-ʿawrāʾ).\n  * Al-Zamakhshari (Asas): Literal: certain cognition. Metaphorical: \"I knew not of your news\" (mā ʿalimtu bi-khabarika) meaning \"I perceived not\"—thus ignorance is a failure of perception, not mere absence of data.\n- Root: ولي (waliya)\n  * Lisan / Ayn: Nearness, guardianship, or patronage; the walī is one who assumes charge of another's affairs, whether kin or protector.\n  * Al-Raghib (Mufradat): Wilāyah denotes proximity and authority; the walī of a child acts as God's deputy in discipline, mirroring the angels' custodianship of the moral ledger.\n  * Al-Zamakhshari (Asas): Literal: physical adjacency. Metaphorical: the guardian's \"inheriting the character of the angels\" (waritha akhlāq al-malāʾikah)—a moral, not genealogical, inheritance.\n- Sibawayh Rule: Interposition of the conditional and its apodosis (al-faṣl bayna al-sharṭ wa al-jawāb)—the periodic structure in \"fa-in kunta lā tuʾminu... afalā takfīka\" (if you believe not... does not suffice you?) allows the protasis to govern the rhetorical question, binding the lesser sign to the greater inference.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Patience and Gratitude'", "badge": "Afterlife"}], "31": [{"arabic": "يستهزئون أفيظنون أنهم في الدنيا خالدون أو لم يروا كم أهلكنا قبلهم من القرون أنهم إليهم لا يرجعون أم يحسبون أن الموتى سافروا من عندهم فهم معدمون كلا وإن كل لما جميع لدينا محضرون {ولكن} ما تأتيهم من آية من آيات ربهم إلا كانوا عنها معرضين وذلك لأنا جعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون وسواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ولنرجع إلى الغرض فإن هذه تلويحات تشير إلى أمور هي أعلى من علوم المعاملة فنقول ظهر أن الصبر عبارة عن ثبات باعث الدين في مقاومة باعث الهوى وهذه المقاومة من خاصة الآدميين لما وكل بهم من الكرام الكاتبي", "english": "How immense is your heedlessness, O wretched one—and all of us are that wretched one—while before you are these terrors! If you do not believe in the greater resurrection out of ignorance and error, does not the evidence of the lesser resurrection suffice you? Have you not heard the saying of the Master of the Prophets, peace be upon him: \"Sufficient is death as a warner\" (kafā bil-mawti wāʿiẓan)? Have you not heard of his weeping, peace be upon him, at death, until he said, may God's peace and blessing be upon him: \"O God, ease for Muhammad the agonies of death\" (allāhumma hawwin ʿalā Muḥammadin sakarāti al-mawt)? Are you not ashamed of your slowness in anticipating the onslaught of death, following the rabble of the heedless—those who look only for a single cry that seizes them while they are disputing, so they can neither make a bequest nor return to their families? Then illness comes to them as a warner of death, and they are not deterred; and gray hair comes to them as a messenger from it, and they do not take heed. {«يَا حَسْرَةً عَلَى الْعِبَادِ مَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ»} (O regret upon the servants! There comes not to them a messenger but they mock him) [Ya-Sin: 30]. Do they think that they are in this world immortal? {«أَوَلَمْ يَرَوْا كَمْ أَهْلَكْنَا قَبْلَهُمْ مِنَ الْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ»} (Have they not seen how many generations We destroyed before them—that they will not return to them?) [Ya-Sin: 31]. Or do they reckon that the dead have merely traveled away from them, and so they are annihilated? Nay! {«وَإِنْ كُلٌّ لَمَّا جَمِيعٌ لَدَيْنَا مُحْضَرُونَ»} (And indeed, all of them, without exception, will be brought before Us) [Ya-Sin: 32]. {«وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ»} (And there comes not to them a sign from the signs of their Lord but they turn away from it) [Ya-Sin: 46]. And that is because {«إِنَّا جَعَلْنَا مِنْ بَيْنِ أَيْدِيهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا فَأَغْشَيْنَاهُمْ فَهُمْ لَا يُبْصِرُونَ»} (We have placed before them a barrier and behind them a barrier, and We have covered them, so they do not see) [Ya-Sin: 9]. {«وَسَوَاءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُونَ»} (And it is alike to them whether you warn them or warn them not—they will not believe) [Ya-Sin: 10].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 958", "section_title_en": "On the Lesser Resurrection as Proof of the Greater, and the Station of the Guardian over the Child", "section_index": 958, "anchors": "- Root: صغر (ṣaghara)\n  * Lisan / Ayn: Smallness in magnitude, rank, or time; the lesser as opposed to the greater (al-kabīr), each term relative to the other.\n  * Al-Raghib (Mufradat): Ṣighar and kibar are relative opposites, applied variously to age, body, or station; here, the \"lesser resurrection\" (al-qiyāmah al-ṣughrā) is death, measured against the \"greater\" (al-kubrā), the final rising.\n  * Al-Zamakhshari (Asas): Literal: diminution in size or status. Metaphorical: the lesser as a type or foreshadow of the greater—death as the microcosmic analogue of the macrocosmic resurrection.\n- Root: موت (mawt)\n  * Lisan / Ayn: Death as the cessation of animal life; the root also yields \"amāta\" (to cause death) and \"mayyit\" (the dead).\n  * Al-Raghib (Mufradat): Death is the departure of the soul from the body, a transition between two abodes; it is the \"lesser resurrection\" in that it separates the spirit from the corporeal frame, prefiguring the greater separation and recompense.\n  * Al-Zamakhshari (Asas): Literal: biological death. Metaphorical: \"the dead land\" revived by rain, and here, death as a \"warner\" (nadhīr) and \"messenger\" (rasūl)—personified agencies of admonition.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge as perception or cognition of a thing; \"ʿallama\" (to teach) and \"ʿālim\" (the knowing one).\n  * Al-Raghib (Mufradat): ʿIlm is apprehension of a thing's reality—either its essence or a judgment about it. Here, the \"knowledge\" of the two resurrections distinguishes the believer (muʾmin) from the ignorant (jāhil), who sees with a \"blind eye\" (al-ʿayn al-ʿawrāʾ).\n  * Al-Zamakhshari (Asas): Literal: certain cognition. Metaphorical: \"I knew not of your news\" (mā ʿalimtu bi-khabarika) meaning \"I perceived not\"—thus ignorance is a failure of perception, not mere absence of data.\n- Root: ولي (waliya)\n  * Lisan / Ayn: Nearness, guardianship, or patronage; the walī is one who assumes charge of another's affairs, whether kin or protector.\n  * Al-Raghib (Mufradat): Wilāyah denotes proximity and authority; the walī of a child acts as God's deputy in discipline, mirroring the angels' custodianship of the moral ledger.\n  * Al-Zamakhshari (Asas): Literal: physical adjacency. Metaphorical: the guardian's \"inheriting the character of the angels\" (waritha akhlāq al-malāʾikah)—a moral, not genealogical, inheritance.\n- Sibawayh Rule: Interposition of the conditional and its apodosis (al-faṣl bayna al-sharṭ wa al-jawāb)—the periodic structure in \"fa-in kunta lā tuʾminu... afalā takfīka\" (if you believe not... does not suffice you?) allows the protasis to govern the rhetorical question, binding the lesser sign to the greater inference.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Patience and Gratitude'", "badge": "Afterlife"}], "32": [{"arabic": "معدمون كلا وإن كل لما جميع لدينا محضرون {ولكن} ما تأتيهم من آية من آيات ربهم إلا كانوا عنها معرضين وذلك لأنا جعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون وسواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ولنرجع إلى الغرض فإن هذه تلويحات تشير إلى أمور هي أعلى من علوم المعاملة فنقول ظهر أن الصبر عبارة عن ثبات باعث الدين في مقاومة باعث الهوى وهذه المقاومة من خاصة الآدميين لما وكل بهم من الكرام الكاتبين ولا يكتبان شيئا عن الصبيان والمجانين إذ قد ذكرنا أن الحسنة في الإقبال على الا", "english": "How immense is your heedlessness, O wretched one—and all of us are that wretched one—while before you are these terrors! If you do not believe in the greater resurrection out of ignorance and error, does not the evidence of the lesser resurrection suffice you? Have you not heard the saying of the Master of the Prophets, peace be upon him: \"Sufficient is death as a warner\" (kafā bil-mawti wāʿiẓan)? Have you not heard of his weeping, peace be upon him, at death, until he said, may God's peace and blessing be upon him: \"O God, ease for Muhammad the agonies of death\" (allāhumma hawwin ʿalā Muḥammadin sakarāti al-mawt)? Are you not ashamed of your slowness in anticipating the onslaught of death, following the rabble of the heedless—those who look only for a single cry that seizes them while they are disputing, so they can neither make a bequest nor return to their families? Then illness comes to them as a warner of death, and they are not deterred; and gray hair comes to them as a messenger from it, and they do not take heed. {«يَا حَسْرَةً عَلَى الْعِبَادِ مَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ»} (O regret upon the servants! There comes not to them a messenger but they mock him) [Ya-Sin: 30]. Do they think that they are in this world immortal? {«أَوَلَمْ يَرَوْا كَمْ أَهْلَكْنَا قَبْلَهُمْ مِنَ الْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ»} (Have they not seen how many generations We destroyed before them—that they will not return to them?) [Ya-Sin: 31]. Or do they reckon that the dead have merely traveled away from them, and so they are annihilated? Nay! {«وَإِنْ كُلٌّ لَمَّا جَمِيعٌ لَدَيْنَا مُحْضَرُونَ»} (And indeed, all of them, without exception, will be brought before Us) [Ya-Sin: 32]. {«وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ»} (And there comes not to them a sign from the signs of their Lord but they turn away from it) [Ya-Sin: 46]. And that is because {«إِنَّا جَعَلْنَا مِنْ بَيْنِ أَيْدِيهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا فَأَغْشَيْنَاهُمْ فَهُمْ لَا يُبْصِرُونَ»} (We have placed before them a barrier and behind them a barrier, and We have covered them, so they do not see) [Ya-Sin: 9]. {«وَسَوَاءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُونَ»} (And it is alike to them whether you warn them or warn them not—they will not believe) [Ya-Sin: 10].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 958", "section_title_en": "On the Lesser Resurrection as Proof of the Greater, and the Station of the Guardian over the Child", "section_index": 958, "anchors": "- Root: صغر (ṣaghara)\n  * Lisan / Ayn: Smallness in magnitude, rank, or time; the lesser as opposed to the greater (al-kabīr), each term relative to the other.\n  * Al-Raghib (Mufradat): Ṣighar and kibar are relative opposites, applied variously to age, body, or station; here, the \"lesser resurrection\" (al-qiyāmah al-ṣughrā) is death, measured against the \"greater\" (al-kubrā), the final rising.\n  * Al-Zamakhshari (Asas): Literal: diminution in size or status. Metaphorical: the lesser as a type or foreshadow of the greater—death as the microcosmic analogue of the macrocosmic resurrection.\n- Root: موت (mawt)\n  * Lisan / Ayn: Death as the cessation of animal life; the root also yields \"amāta\" (to cause death) and \"mayyit\" (the dead).\n  * Al-Raghib (Mufradat): Death is the departure of the soul from the body, a transition between two abodes; it is the \"lesser resurrection\" in that it separates the spirit from the corporeal frame, prefiguring the greater separation and recompense.\n  * Al-Zamakhshari (Asas): Literal: biological death. Metaphorical: \"the dead land\" revived by rain, and here, death as a \"warner\" (nadhīr) and \"messenger\" (rasūl)—personified agencies of admonition.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge as perception or cognition of a thing; \"ʿallama\" (to teach) and \"ʿālim\" (the knowing one).\n  * Al-Raghib (Mufradat): ʿIlm is apprehension of a thing's reality—either its essence or a judgment about it. Here, the \"knowledge\" of the two resurrections distinguishes the believer (muʾmin) from the ignorant (jāhil), who sees with a \"blind eye\" (al-ʿayn al-ʿawrāʾ).\n  * Al-Zamakhshari (Asas): Literal: certain cognition. Metaphorical: \"I knew not of your news\" (mā ʿalimtu bi-khabarika) meaning \"I perceived not\"—thus ignorance is a failure of perception, not mere absence of data.\n- Root: ولي (waliya)\n  * Lisan / Ayn: Nearness, guardianship, or patronage; the walī is one who assumes charge of another's affairs, whether kin or protector.\n  * Al-Raghib (Mufradat): Wilāyah denotes proximity and authority; the walī of a child acts as God's deputy in discipline, mirroring the angels' custodianship of the moral ledger.\n  * Al-Zamakhshari (Asas): Literal: physical adjacency. Metaphorical: the guardian's \"inheriting the character of the angels\" (waritha akhlāq al-malāʾikah)—a moral, not genealogical, inheritance.\n- Sibawayh Rule: Interposition of the conditional and its apodosis (al-faṣl bayna al-sharṭ wa al-jawāb)—the periodic structure in \"fa-in kunta lā tuʾminu... afalā takfīka\" (if you believe not... does not suffice you?) allows the protasis to govern the rhetorical question, binding the lesser sign to the greater inference.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}], "36": [{"arabic": "تعلمون سبحان الذي خلق الأزواج كلها مما تنبت الأرض ومن أنفسهم ومما لا يعلمون {وقال} وننشئكم فيما لا تعلمون {وإلى} ما يعرف أصلها وجملتها ولا يعرف تفصيلها فيمكننا أن نتفكر في تفصيلها وهي منقسمة إلى ما أدركناه بحس البصر وإلى ما لا ندركه بالبصر أما الذي لا ندركه بالبصر فكالملائكة والجن والشياطين والعرش والكرسي وغير ذلك ومجال الفكر في هذه الأشياء مما يضيق ويغمض فلنعدل إلى الأقرب إلى الأفهام وهي المدركات بحس البصر وذلك هو السموات السبع والأرض وما بينهما فالسموات مشاهدة بكواكبها وشمسها وقمرها وحركتها ودورانها في طلوعها وغ", "english": "We say: Created existents are divided into that whose origin is unknown to us, such that we cannot contemplate it—and how many are the existents we do not know! As God Most High said: {«وَيَخْلُقُ مَا لَا تَعْلَمُونَ»} (And He creates what you do not know — Q. 16:8), and {«سُبْحَانَ الَّذِي خَلَقَ الْأَزْوَاجَ كُلَّهَا مِمَّا تُنبِتُ الْأَرْضُ وَمِنْ أَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ»} (Glory be to Him who created all pairs, of what the earth grows, and of themselves, and of what they do not know — Q. 36:36), and He said: {«وَنُنشِئُكُمْ فِيمَا لَا تَعْلَمُونَ»} (And We raise you up in what you do not know — Q. 56:61). And [it is divided] into that whose origin and general nature are known, but whose detailed particulars are not known—so we are able to contemplate its details.", "book_title": "Contemplation", "section_title_ar": "Section 1268", "section_title_en": "Exposition of the Method of Contemplation upon the Creation of God Most High", "section_index": 1268, "anchors": "- Root: فكر (f-k-r)\n  * Lisan / Ayn: Core meaning is reflection, deliberation, and the movement of the mind over a matter to arrive at its reality.\n  * Al-Raghib (Mufradat): In theological usage, *tafakkur* is the soul's journey through created things (al-makhlūqāt) to derive knowledge of the Creator—it is the bridge from the sensory to the intelligible.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is mental consideration; metaphorical (majāz) extension applies it to the heart's \"seeing\" of divine wisdom latent in creation.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Root meaning is measuring, proportioning, and fashioning a thing with precise estimation.\n  * Al-Raghib (Mufradat): *Khalq* denotes origination from nothing (ibdāʿ) or creation of one thing from another, always upon a measure necessitated by wisdom.\n  * Al-Zamakhshari (Asas): Literal: the artisan's sizing of material before cutting; Metaphorical: God's bringing things into existence upon a measure that wisdom dictates—He is Rabb al-khalīqah.\n- Root: بصر (b-ṣ-r)\n  * Lisan / Ayn: Core meaning is sight, both ocular and perceptive.\n  * Al-Raghib (Mufradat): *Baṣar* applies to the eye's organ and its power, and to the heart's perceptive faculty (*baṣīrah*), as in {«فَكَشَفْنَا عَنكَ غِطَاءَكَ فَبَصَرُكَ الْيَوْمَ حَدِيدٌ»} (Q. 50:22).\n  * Al-Zamakhshari (Asas): Literal: physical sight; Metaphorical: *ibṣār* as intellectual discernment—\"هذه آية مبصرة\" (this is an illuminating sign).\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: Core meaning is the self, the soul, the vital principle.\n  * Al-Raghib (Mufradat): *Nafs* denotes the rational soul (al-rūḥ) and also the very essence (al-dhāt); in {«وَفِي أَنفُسِكُمْ أَفَلَا تُبْصِرُونَ»} (Q. 51:21) it refers to the human self as a microcosmic sign.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity; Metaphorical: the inner dimension of man as a locus of divine signs.\n- Sibawayh Rule: Rule of Specification and Restriction (Bāb al-Takhṣīṣ) — When a general term (like \"everything in existence\") is followed by a restrictive clause (\"save God\"), the syntax governs the scope of predication, ensuring the exception is precise and the universal claim is bounded.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "39": [{"arabic": "محسوب إذ قال عز وجل {الشمس والقمر بحسبان} وقال عز وجل {والقمر قدرناه منازل حتى عاد كالعرجون القديم} والثاني الأحكام وحاصله يرجع إلى الاستدلال على الحوادث بالأسباب وهو يضاهي استدلال الطبيب بالنبض على ما سيحدث من المرض وهو معرفة لمجاري سنة الله تعالى وعادته في خلقه ولكن قد ذمه الشرع قال صلى الله عليه وسلم إذا ذكر القدر فأمسكوا وإذا ذكرت النجوم فأمسكوا وإذا ذكر أصحابي فأمسكوا (2) وقال صلى الله عليه وسلم أخاف على أمتي بعدي ثلاثا حيف الأئمة والإيمان بالنجوم والتكذيب بالقدر (3) وقال عمر بن الخطاب رضي الله عنه تعلموا من النجوم ما تهتدون به في البر والبح", "english": "You may say: \"Knowledge is the apprehension of a thing as it is, and it is among the attributes of God, exalted be He. How then can a thing be knowledge, and while being knowledge, be blameworthy?\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 25", "section_title_en": "Section 25 — On the Exposition of the Manner in Which Some Sciences May Be Blameworthy, and the Exposition of the Alteration of the Names of the Sciences — Namely Jurisprudence (Fiqh), Knowledge (ʿIlm), Divine Unity (Tawḥīd), Reminder (Tadhkīr), and Wisdom (Ḥikmah) — and the Exposition of the Praiseworthy Measure of the Religious Sciences and the Blameworthy Measure Thereof", "section_index": 25, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denotes the trace or mark by which a thing is known; ʿilm is the apprehension of a thing as it is (idrāk al-shayʾ ʿalā mā huwa bihi), encompassing both the perception of the thing's essence and the judgment of its attributes.\n  * Al-Raghib (Mufradat): ʿIlm is \"the apprehension of a thing by its reality\" (إدراك الشيء بحقيقته), divided into the apprehension of the thing's essence and the judgment upon it. As a divine attribute, it is not blameworthy in itself; blame attaches only to its relation to human subjects.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from the metaphorical extension whereby a \"learned\" man may be called ignorant when his knowledge harms him — the term ʿilm is transferred (manqūl) in blame contexts to denote what is not truly beneficial knowledge.\n- Root: س ب ب (s-b-b)\n  * Lisan / Ayn: The rope by which one climbs to the palm-tree; extended to any means by which one reaches a thing.\n  * Al-Raghib (Mufradat): \"Every means by which one arrives at a thing is called a sabab\" — thus the science of the properties of substances and stellar computations is a \"cause\" (sabab) that may lead to harm, and the means to evil is evil.\n  * Al-Zamakhshari (Asas): Literal usage denotes a physical cord or tie; metaphorical usage (majāz) extends to any instrumental cause, whether beneficial or harmful.\n- Root: ع ق ل (ʿ-q-l)\n  * Lisan / Ayn: The intellect as that which binds and restrains; its root sense is of a fetter or halter that prevents the soul from straying.\n  * Al-Raghib (Mufradat): The intellect is that by which one apprehends realities; its proper function is to lead one to the truth of prophecy, after which it must be restrained from independent speculation in matters beyond its scope.\n  * Al-Zamakhshari (Asas): Literal usage denotes the binding of the camel; metaphorical usage denotes the restraint of the soul from error.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد بإنما) — When the author states \"knowledge is not blamed for its essence but only in relation to servants for one of three causes,\" the restriction (ḥaṣr) via \"innamā\" confines blame to the relational aspect, not the essence, requiring the translator to preserve this precise logical scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "46": [{"arabic": "معدمون كلا وإن كل لما جميع لدينا محضرون {ولكن} ما تأتيهم من آية من آيات ربهم إلا كانوا عنها معرضين وذلك لأنا جعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون وسواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ولنرجع إلى الغرض فإن هذه تلويحات تشير إلى أمور هي أعلى من علوم المعاملة فنقول ظهر أن الصبر عبارة عن ثبات باعث الدين في مقاومة باعث الهوى وهذه المقاومة من خاصة الآدميين لما وكل بهم من الكرام الكاتبين ولا يكتبان شيئا عن الصبيان والمجانين إذ قد ذكرنا أن الحسنة في الإقبال على الاستفادة منهما والسيئة في الإعراض عنهما وما للصبيان والمج", "english": "How immense is your heedlessness, O wretched one—and all of us are that wretched one—while before you are these terrors! If you do not believe in the greater resurrection out of ignorance and error, does not the evidence of the lesser resurrection suffice you? Have you not heard the saying of the Master of the Prophets, peace be upon him: \"Sufficient is death as a warner\" (kafā bil-mawti wāʿiẓan)? Have you not heard of his weeping, peace be upon him, at death, until he said, may God's peace and blessing be upon him: \"O God, ease for Muhammad the agonies of death\" (allāhumma hawwin ʿalā Muḥammadin sakarāti al-mawt)? Are you not ashamed of your slowness in anticipating the onslaught of death, following the rabble of the heedless—those who look only for a single cry that seizes them while they are disputing, so they can neither make a bequest nor return to their families? Then illness comes to them as a warner of death, and they are not deterred; and gray hair comes to them as a messenger from it, and they do not take heed. {«يَا حَسْرَةً عَلَى الْعِبَادِ مَا يَأْتِيهِمْ مِنْ رَسُولٍ إِلَّا كَانُوا بِهِ يَسْتَهْزِئُونَ»} (O regret upon the servants! There comes not to them a messenger but they mock him) [Ya-Sin: 30]. Do they think that they are in this world immortal? {«أَوَلَمْ يَرَوْا كَمْ أَهْلَكْنَا قَبْلَهُمْ مِنَ الْقُرُونِ أَنَّهُمْ إِلَيْهِمْ لَا يَرْجِعُونَ»} (Have they not seen how many generations We destroyed before them—that they will not return to them?) [Ya-Sin: 31]. Or do they reckon that the dead have merely traveled away from them, and so they are annihilated? Nay! {«وَإِنْ كُلٌّ لَمَّا جَمِيعٌ لَدَيْنَا مُحْضَرُونَ»} (And indeed, all of them, without exception, will be brought before Us) [Ya-Sin: 32]. {«وَمَا تَأْتِيهِمْ مِنْ آيَةٍ مِنْ آيَاتِ رَبِّهِمْ إِلَّا كَانُوا عَنْهَا مُعْرِضِينَ»} (And there comes not to them a sign from the signs of their Lord but they turn away from it) [Ya-Sin: 46]. And that is because {«إِنَّا جَعَلْنَا مِنْ بَيْنِ أَيْدِيهِمْ سَدًّا وَمِنْ خَلْفِهِمْ سَدًّا فَأَغْشَيْنَاهُمْ فَهُمْ لَا يُبْصِرُونَ»} (We have placed before them a barrier and behind them a barrier, and We have covered them, so they do not see) [Ya-Sin: 9]. {«وَسَوَاءٌ عَلَيْهِمْ أَأَنْذَرْتَهُمْ أَمْ لَمْ تُنْذِرْهُمْ لَا يُؤْمِنُونَ»} (And it is alike to them whether you warn them or warn them not—they will not believe) [Ya-Sin: 10].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 958", "section_title_en": "On the Lesser Resurrection as Proof of the Greater, and the Station of the Guardian over the Child", "section_index": 958, "anchors": "- Root: صغر (ṣaghara)\n  * Lisan / Ayn: Smallness in magnitude, rank, or time; the lesser as opposed to the greater (al-kabīr), each term relative to the other.\n  * Al-Raghib (Mufradat): Ṣighar and kibar are relative opposites, applied variously to age, body, or station; here, the \"lesser resurrection\" (al-qiyāmah al-ṣughrā) is death, measured against the \"greater\" (al-kubrā), the final rising.\n  * Al-Zamakhshari (Asas): Literal: diminution in size or status. Metaphorical: the lesser as a type or foreshadow of the greater—death as the microcosmic analogue of the macrocosmic resurrection.\n- Root: موت (mawt)\n  * Lisan / Ayn: Death as the cessation of animal life; the root also yields \"amāta\" (to cause death) and \"mayyit\" (the dead).\n  * Al-Raghib (Mufradat): Death is the departure of the soul from the body, a transition between two abodes; it is the \"lesser resurrection\" in that it separates the spirit from the corporeal frame, prefiguring the greater separation and recompense.\n  * Al-Zamakhshari (Asas): Literal: biological death. Metaphorical: \"the dead land\" revived by rain, and here, death as a \"warner\" (nadhīr) and \"messenger\" (rasūl)—personified agencies of admonition.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge as perception or cognition of a thing; \"ʿallama\" (to teach) and \"ʿālim\" (the knowing one).\n  * Al-Raghib (Mufradat): ʿIlm is apprehension of a thing's reality—either its essence or a judgment about it. Here, the \"knowledge\" of the two resurrections distinguishes the believer (muʾmin) from the ignorant (jāhil), who sees with a \"blind eye\" (al-ʿayn al-ʿawrāʾ).\n  * Al-Zamakhshari (Asas): Literal: certain cognition. Metaphorical: \"I knew not of your news\" (mā ʿalimtu bi-khabarika) meaning \"I perceived not\"—thus ignorance is a failure of perception, not mere absence of data.\n- Root: ولي (waliya)\n  * Lisan / Ayn: Nearness, guardianship, or patronage; the walī is one who assumes charge of another's affairs, whether kin or protector.\n  * Al-Raghib (Mufradat): Wilāyah denotes proximity and authority; the walī of a child acts as God's deputy in discipline, mirroring the angels' custodianship of the moral ledger.\n  * Al-Zamakhshari (Asas): Literal: physical adjacency. Metaphorical: the guardian's \"inheriting the character of the angels\" (waritha akhlāq al-malāʾikah)—a moral, not genealogical, inheritance.\n- Sibawayh Rule: Interposition of the conditional and its apodosis (al-faṣl bayna al-sharṭ wa al-jawāb)—the periodic structure in \"fa-in kunta lā tuʾminu... afalā takfīka\" (if you believe not... does not suffice you?) allows the protasis to govern the rhetorical question, binding the lesser sign to the greater inference.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}], "47": [{"arabic": "إليهم كما قال تعالى حكاية عن الكفار {وإذا قيل لهم أنفقوا من ما رزقكم الله قال الذين كفروا للذين آمنوا أنطعم من لو يشاء الله أطعمه} وقالوا أيضا {لو شاء الله ما أشركنا ولا آباؤنا} فانظر كيف كانوا صادقين في كلامهم وكيف هلكوا بصدقهم فسبحان من إذا شاء أهلك بالصدق وإذا شاء أسعد بالجهل {يضل به كثيرا ويهدي به كثيرا} فهؤلاء لما ظنوا أنهم استخدموا لأجل المساكين والفقراء أو جل الله تعالى ثم قالوا لا حظ لنا في المساكين ولا حظ لله فينا وفي أموالنا سواء أنفقنا أو أمسكنا هلكوا كما هلك الصبي لما ظن أن مقصود الوالد استخدامه لأجل", "english": "Likewise, if it were said: \"Is oxymel (sikanjabīn) better, or the drink of the water-lily (sharāb al-līnūfar)?\" — no unqualified answer could be correct at all. Indeed, if it were said to us: \"Is oxymel better, or the absence of yellow bile?\" — we would say: the absence of yellow bile, for oxymel is sought for the sake of something else, and that which is sought for its own sake is necessarily better than that which is sought for the sake of another.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 1025", "section_title_en": "The Superiority of Knowledge Over Action — The Parable of the Physician and the Child", "section_index": 1025, "anchors": "- Root: فضل (faḍl)\n  * Lisan / Ayn: Excess or increase beyond what is required; superiority in degree.\n  * Al-Raghib (Mufradat): \"الفضل: الزيادة عن الاقتصاد\" — excess beyond moderation, divided into praiseworthy (like excess of knowledge) and blameworthy; comparative superiority of one thing over another by genus, species, or merit.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"فاضلني فلان ففضلته\" — to surpass in excellence. Here used comparatively: one act or state exceeds another in rank.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing's true reality, whether by direct perception of its essence or by judgment concerning it.\n  * Al-Zamakhshari (Asas): Literal: \"هو من أعلام العلم الخافقه\" — knowledge as a lofty, manifest sign; distinguished from mere action which is its instrument.\n- Root: صدق (ṣidq)\n  * Al-Raghib (Mufradat): Truthfulness primarily in speech — correspondence of report with reality; may become blameworthy when it leads to ruin, as with the disbelievers who spoke truly about God's independence yet drew false conclusions.\n  * Al-Zamakhshari (Asas): Literal: \"صدقته الحديث\" — truthful in statement. Metaphorical (Majaz): \"رجل صادق الحملة\" — truthful in resolve. Here: the disbelievers were literally truthful in their words yet destroyed by that very truthfulness.\n- Root: هلك (halak)\n  * Al-Raghib (Mufradat): Destruction on three levels: loss of something from one's possession, corruption and dissolution, and death. Used here for spiritual ruin through misapplied reasoning.\n  * Al-Zamakhshari (Asas): Literal: \"وقعوا في المهلكة\" — falling into destruction. Metaphorical: \"تهالك على الشيء\" — intense craving. Here: literal perdition of the soul through false inference.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The conditional structure \"فإن قلت... فاعلم\" (if you say... then know) governs the entire periodic sentence, requiring the apodosis to resolve the protasis with logical necessity, as in the physician analogy where praise of the medicine does not entail its intrinsic superiority.", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Patience and Gratitude'", "badge": "Commentary"}], "48": [{"arabic": "على الكافرين غير يسير} وقال تعالى {ويقولون متى هذا الوعد إن كنتم صادقين ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون ونفخ في الصور فإذا هم من الأجداث إلى ربهم ينسلون قالوا يا ويلنا من بعثنا من مرقدنا هذا ما وعد الرحمن وصدق المرسلون} فلو لم يكن بين يدي الموتى إلا هول تلك النفخة لكان ذلك جديرا بأن يتقى فإنها نفخة وصيحة يصعق بها من في السموات والأرض يعنى يموتون بها إلا من شاء الله وهو بعض الملائكة ولذلك قال رسول الله صلى الله عليه وسلم كيف أنعم وصاحب الصور قد التقم القرن وحنى الجبهة وأصغى بالأذن متى يؤمر فينفخ (1) قال مقاتل الصور هو القرن وذلك أن إسرافيل عليه السلام واضع فاه على القرن كهيئة البوق ودائرة رأس القرن كعرض السموات والأرض وهو شاخص بصره نحو العرش ينتظر متى يؤمر فينفخ النفخة الأولى فإذا ن", "english": "The Prophet (peace and blessings be upon him) said: Allah the Exalted said: \"The son of Adam has reviled Me, and he had no right to revile Me; and he has denied Me, and he had no right to deny Me. As for his reviling of Me, it is his saying that I have a son. And as for his denial of Me, it is his saying: 'He will never bring me back as He created me at first.'\" {«شتمني ابن آدم وما ينبغي له أن يشتمني وكذبني وما ينبغي له أن يكذبني...»}", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1335", "section_title_en": "On the Terrors of the Trumpet-Blast and the Awakening for the Resurrection", "section_index": 1335, "anchors": "- Root: نفخ (N-F-Kh)\n  * Lisan / Ayn: To blow into a thing, to inflate; the breath of wind entering a vessel or body.\n  * Al-Raghib (Mufradat): The divine act of breathing spirit into creation {«ونفخت فيه من روحي»}; here, the eschatological blast that annihilates and then revives all beings.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage of blowing into the Trumpet (الصور); metaphorical extension to the \"blast of spring\" reviving the earth—here applied to the two cosmic blasts of death and resurrection.\n- Root: صور (S-W-R)\n  * Lisan / Ayn: Form, image, shape; also a horn or trumpet (the instrument of the blast).\n  * Al-Raghib (Mufradat): The perceptible form of bodies and the intelligible form of souls; here, the Trumpet (الصور) as the instrument of divine command that re-forms and re-shapes creation.\n  * Al-Zamakhshari (Asas): Literal: the horn (القرن) held by Israfil; metaphorical: the \"inclination\" (صورة) of hearts toward terror and anticipation.\n- Root: موت (M-W-T)\n  * Lisan / Ayn: Death as the cessation of life; the state of the corpse.\n  * Al-Raghib (Mufradat): Death as the separation of the soul from the body; the \"first death\" of the blast and the \"second death\" of the wicked.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: the \"death\" of the heart through heedlessness, and the reviving of dead lands by rain—here, the reviving of bodies by the second blast.\n- Root: قبر (Q-B-R)\n  * Lisan / Ayn: The grave as the abode of the dead; burial.\n  * Al-Raghib (Mufradat): The grave as the intermediate state (barzakh) before resurrection; {«حتى زرتم المقابر»} as a metaphor for death.\n  * Al-Zamakhshari (Asas): Literal: the grave and its inhabitants; metaphorical: the \"raising of the nose\" (قبراه) of the proud—contrasted here with the humility of the dead rising from their graves.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that true faith is not mere verbal assent but heartfelt conviction, as in \"إنما فتور البواطن... لقلة الفهم\" (The languor of the inner selves is only due to the lack of understanding).", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "49": [{"arabic": "{ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون} والصلاة والسلام على محمد رسوله الذي يسير تحت لوائه النبيون وعلى آله وأصحابه الأئمة المهديين والسادة المرضيين صلاة يوازي عددها عدد ما كان من خلق الله وما سيكون ويحظى ببركتها الأولون والآخرون وسلم تسليما كثيرا أما بعد فإن الغضب شعلة نار اقتبست من نار الله الموقدة التي تطلع على الأفئدة وإنها لمستكنة في طي الفؤاد استكنان الجمر تحت الرماد ويستخرجه الكبر الدفين في قلب كل جبار عنيد كاستخراج الحجر النار من الحديد وقد انكشف للناظرين بنور اليقين أن ا", "english": "In the name of God, the Most Merciful, the Most Compassionate. Praise be to God, upon whose pardon and mercy none rely except the hopeful, and from whose evil wrath and assault none fear except the fearful — He who gradually seizes His servants from whence they know not, and who has given dominion over them to their lusts, commanding them to abandon what they desire, and who has tried them with anger while charging them to swallow their rage in what provokes them. Then He surrounded them with hardships and pleasures, and granted them respite to see how they would act. He tested their love through them, to make known the truth of what they claim. He made known to them that nothing is hidden from Him of what they conceal or proclaim, and warned them lest He seize them suddenly while they are unaware. For He said: {«They await but a single blast which will seize them while they are disputing; so they will not be able to make a bequest, nor to their families will they return»} (Q. 36:49-50). And prayers and peace be upon Muhammad, His Messenger, beneath whose banner the prophets walk, and upon his family and companions — the rightly-guided imams and the pleasing masters — prayers whose number equals the number of what has been of God's creation and what will be, and by whose blessing the first and the last are favored — and abundant peace.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 700", "section_title_en": "The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences", "section_index": 700, "anchors": "- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}, {"arabic": "عليه شيء مما يسرون وما يعلنون وحذرهم أن يأخذهم بغتة وهم لا يشعرون فقال {ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون} والصلاة والسلام على محمد رسوله الذي يسير تحت لوائه النبيون وعلى آله وأصحابه الأئمة المهديين والسادة المرضيين صلاة يوازي عددها عدد ما كان من خلق الله وما سيكون ويحظى ببركتها الأولون والآخرون وسلم تسليما كثيرا أما بعد فإن الغضب شعلة نار اقتبست من نار الله الموقدة التي تطلع على الأفئدة وإنها لمستكنة في طي الفؤاد استكنان الجمر تحت الرماد ويستخرجه الكبر الدفين في قلب كل جبار عنيد كاستخراج الحجر النار من الحديد وقد انكشف للناظرين بنور اليقين أن الإنسان", "english": "In the name of God, the Most Merciful, the Most Compassionate. Praise be to God, upon whose pardon and mercy none rely except the hopeful, and from whose evil wrath and assault none fear except the fearful — He who gradually seizes His servants from whence they know not, and who has given dominion over them to their lusts, commanding them to abandon what they desire, and who has tried them with anger while charging them to swallow their rage in what provokes them. Then He surrounded them with hardships and pleasures, and granted them respite to see how they would act. He tested their love through them, to make known the truth of what they claim. He made known to them that nothing is hidden from Him of what they conceal or proclaim, and warned them lest He seize them suddenly while they are unaware. For He said: {«They await but a single blast which will seize them while they are disputing; so they will not be able to make a bequest, nor to their families will they return»} (Q. 36:49-50). And prayers and peace be upon Muhammad, His Messenger, beneath whose banner the prophets walk, and upon his family and companions — the rightly-guided imams and the pleasing masters — prayers whose number equals the number of what has been of God's creation and what will be, and by whose blessing the first and the last are favored — and abundant peace.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 700", "section_title_en": "The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences", "section_index": 700, "anchors": "- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "58": [{"arabic": "تعالى {سلام قولا من رب رحيم} والثالثة يقول الله تعالى إني عنكم راض فيكون ذلك أفضل من الهدية والتسليم فذلك قوله تعالى {ورضوان من الله أكبر} أي من النعيم الذي هم فيه فهذا فضل رضا الله تعالى وهو ثمرة رضا العبد وأما من الأخبار فقد روي أن النبي صلى الله عليه وسلم سأل طائفة من أصحابه ما أنتم فقالوا مؤمنون فقال ما علامة إيمانكم فقالوا نصبر على البلاء ونشكر عند الرخاء ونرضى بمواقع القضاء فقال مؤمنون ورب الكعبة (2) وفي خبر آخر أنه قال حكماء علماء كادوا من فقههم أن يكونوا أنبي", "english": "I say: As for the verses [indicating the supremacy of divine pleasure], there is the saying of the Exalted: {رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ} [Allah is well-pleased with them and they are well-pleased with Him] {«God is well-pleased with them and they are well-pleased with Him»}. And the Exalted has said: {هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ} [Is the reward of goodness aught but goodness?] {«Is the reward of goodness aught but goodness?»}. The ultimate end of goodness is God's pleasure with His servant, and that is the reward for the servant's pleasure in God the Exalted.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1189", "section_title_en": "The Reality of Divine Pleasure (Riḍā) and the Servant's Contentment with the Decree — Section 1189", "section_index": 1189, "anchors": "- Root: رضي (raḍiya)\n  * Lisan / Ayn: Core meaning is \"to be content, to approve, to be pleased.\" Al-Farahidi notes its usage in mutual accord and satisfaction, with the form *tarāḍin* indicating reciprocal consent.\n  * Al-Raghib (Mufradat): In theological usage, *riḍā* denotes the will's acquiescence to the divine decree without resistance. It is the apex of the servant's station, being the fruit of *maḥabbah* (love) and the key to perpetual vision (*nazar*).\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*) sense is \"satisfaction of the heart.\" Metaphorical (*majāz*) extension applies to God, where *riḍwān* is not an emotional state but a volitional attribute signifying the bestowal of grace and the removal of the veil.\n- Root: نظر (naẓara)\n  * Lisan / Ayn: \"To look, to behold, to consider.\" In the lexicon, *naẓar* implies directed vision with the eye or the intellect.\n  * Al-Raghib (Mufradat): Elevated to the highest beatific vision (*ru'yat Allāh*) in the afterlife, the ultimate reward and the supreme object of the inhabitants of Paradise.\n  * Al-Zamakhshari (Asas): Literal: physical sight. Metaphorical: intellectual contemplation or the unveiled witnessing of the Divine in the Hereafter.\n- Sibawayh Rule: باب التفضيل والتشبيه (The Chapter of Preference and Comparison) — Governing the syntactic structures of *afʿala* (elative) forms like *akbar* (\"greater\") to establish hierarchical supremacy between two entities, as in the verse {وَرِضْوَانٌ مِنَ اللَّهِ أَكْبَرُ}.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "59": [{"arabic": "وقام سعيد بن جبير ليلة يردد هذه الآية وامتازوا اليوم أيها المجرمون وقال بعضهم إني لأفتتح السورة فيوقفني بعض ما أشهد فيها عن الفراغ منها حتى يطلع الفجر وكان بعضهم يقول آية لا أتفهمها ولا يكون قلبي فيها لا أعد لها ثوابا وحكي عن أبي سليمان الداراني أنه قال إني لأتلو الآية فأقيم فيها أربع ليال أو خمس ليال ولولا أني أقطع الفكر فيها ما جاوزتها إلى غيرها وعن بعض السلف أنه بقي في سورة هود ستة أشهر يكررها ولا يفرغ من التدبر فيها وقال بعض العارفين لي في كل جمعة ختمة وفي كل شهر ختمة وفي كل سنة ختمة ولي ختمه منذ ثلاث", "english": "Ali, may God be pleased with him, said: \"There is no good in worship that lacks understanding (fiqh), nor in recitation that lacks reflection.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 227", "section_title_en": "The Third Book on the Inward Acts During Recitation — Ten in Number", "section_index": 227, "anchors": "- Root: دبر (d-b-r)\n  * Lisan / Ayn: The rear, the back part; what comes after; to turn one's back; the end or sequel of a thing.\n  * Al-Raghib (Mufradat): That which is opposite of \"front\" (qabal); used metaphorically for what follows or comes after; \"adbar al-nahar\" — the latter part of the day; \"adbar al-sujud\" — the concluding portions of prayers.\n  * Al-Zamakhshari (Asas): Literal: the back or hind part. Metaphorical: what comes at the end, the sequel, the consequence of an affair.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to transform; the heart as that which is constantly turning and fluctuating between states.\n  * Al-Raghib (Mufradat): The turning and directing of a thing from one face to another; al-taqallub — the constant changing and fluctuation; the heart (qalb) is so named for its perpetual turning about of resolutions and states.\n  * Al-Zamakhshari (Asas): Literal: to turn a thing over from its face. Metaphorical: to ponder, to examine thoroughly, to turn a matter over in the mind — \"qallaba al-amr\" — he examined the affair from all sides.\n- Root: ختم (kh-t-m)\n  * Lisan / Ayn: To seal, to stamp, to imprint; the seal or stamp itself.\n  * Al-Raghib (Mufradat): Sealing and stamping — used both for the act of impressing and the impression left; metaphorically employed for securing a thing and preventing access to it, as in {«ختم الله على قلوبهم»} (God sealed their hearts).\n  * Al-Zamakhshari (Asas): Literal: placing a seal upon something. Metaphorical: to conclude, to finish, to bring to an end — \"khatama al-Qur'an\" — he completed the recitation of the Quran.\n- Root: بقي (b-q-y)\n  * Lisan / Ayn: To remain, to endure, to persist; the lasting and continuing of a thing.\n  * Al-Raghib (Mufradat): The persistence of a thing upon its original state; that which remains (al-baqi) is of two kinds: that which remains by itself without limit — and that is the Creator, may He be exalted — and that which remains by another, which is everything other than Him.\n  * Al-Zamakhshari (Asas): Literal: to remain, to stay. Metaphorical: \"baqiya al-shay'\" — the enduring of a thing; \"ma baqiyat minhum baqiyah\" — not one of them remained.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the construction \"innama\" is employed, it restricts the predicate to the subject alone, excluding all else. This is pertinent here as the author delimits the inward acts of recitation to precisely ten, no more and no less.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "60": [{"arabic": "تعالى ألم أعهد إليكم يا بني آدم أن لا تعبدوا الشيطان إنه لكم عدو مبين فينبغي للعبد أن يشتغل بدفع العدو عن نفسه لا بالسؤال عن أصله ونسبه ومسكنه نعم ينبغي أن يسأل عن سلاحه ليدفعه عن نفسه وسلاح الشيطان الهوى والشهوات وذلك كاف للعالمين فأما معرفة ذاته وصفاته وحقيقته نعوذ بالله منه وحقيقة الملائكة فذلك ميدان العارفين المتغلغلين في علوم المكاشفات فلا يحتاج في علم المعاملة إلى معرفته نعم ينبغي أن يعلم أن الخواطر تنقسم إلى ما يعلم قطعا أنه داع إلى الشر فلا يخفى كونه وسوسة وإلى ما يعلم أنه داع إلى الخير فلا يشك في كونه إلها", "english": "He said — and by my father, a face that will not prosper (1) — the hadith that Satan runs through the son of Adam like the running of blood has already been mentioned. That is because hunger breaks the appetite, and the course of Satan is through the appetites. And because the appetites surround the heart from all its sides, God—exalted is He—said, informing of Iblis: {«I will surely sit in wait for them on Your straight path. Then I will come to them from before them and from behind them and from their right and from their left»} (7:16-17). And he—peace and blessings be upon him—said: \"Verily, Satan sat in wait for the son of Adam on his paths. He sat for him on the path of Islam and said: 'Will you submit and abandon your religion and the religion of your forefathers?' But he disobeyed him and submitted. Then he sat for him on the path of emigration (hijrah) and said: 'Will you emigrate and abandon your land and your sky?' But he disobeyed him and emigrated. Then he sat for him on the path of jihad and said: 'Will you strive? For it is the destruction of the soul and wealth — you will fight and be killed, your women will be married and your wealth divided.' But he disobeyed him and strove.\" (2) The hadith \"There is no one among you except that he has a companion from the jinn\" has already been mentioned.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 598", "section_title_en": "The Revival of the Religious Sciences — Section 598: On the Whisperings of Satan, the Divine Subtleties, and the Means of Defense", "section_index": 598, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or being consumed by fire; also one who is destroyed or perishes.\n  * Al-Raghib (Mufradat): الشيطان refers to the rebellious one among jinn and mankind who leads astray; the term denotes one distanced from divine mercy.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): burning or scorching of meat. Metaphorical (Majaz): \"شاط دمه\" — his blood was spilled in vain; \"أشاط السلطان دمه\" — the ruler declared his blood forfeit. Thus Satan is so named for his being consumed by divine wrath and for his causing others to perish.\n- Root: لهم (Lahm)\n  * Lisan / Ayn: Swallowing or devouring greedily; the larynx or throat (al-lahāt).\n  * Al-Raghib (Mufradat): الإلهام is the casting of something into the heart (al-rawʿ), specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is akin to the \"touch\" (lamah) of the angel or the \"breathing\" (nafth) into the heart.\n  * Al-Zamakhshari (Asas): Literal: to swallow or gulp down. Metaphorical: a horse that \"swallows the ground\" (i.e., devours distance with speed); a generous man who \"swallows\" the needs of others. Thus ilhām is the soul's swift reception of divine inspiration, like swallowing.\n- Root: علم (ʿAlima)\n  * Lisan / Ayn: Knowledge as the mark or trace by which something is known; a signpost (ʿalam).\n  * Al-Raghib (Mufradat): العلم is the apprehension of a thing in its true reality (idrāk al-shayʾ bi-ḥaqīqatihi), divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Literal: knowledge as direct cognition. Metaphorical: \"أعلام الدين\" — the towering landmarks of the religion; \"معالم الطريق\" — the traces by which the road is recognized. Thus knowledge is the signpost illuminating the path of salvation.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The particle \"إنما\" restricts the predicate to the subject alone, excluding all else. This is crucial for understanding statements like \"إنما يدعو حزبه\" — Satan calls only his party, restricting his influence to those who follow him.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "65": [{"arabic": "انتهى إلى تغيير جميع الظواهر والبراهين أو أكثرها حتى حملوا قوله تعالى وتكلمنا أيديهم وتشهد أرجلهم وقوله تعالى وقالوا لجلودهم لم شهدتم علينا قالوا أنطقنا الله الذي أنطق كل شيء وكذلك المخاطبات التي تجري من منكر ونكير وفي الميزان والصراط والحساب ومناظرات أهل النار وأهل الجنة في قولهم أفيضوا علينا من الماء أو مما رزقكم الله زعموا أن ذلك كله بلسان الحال وغلا آخرون في حسم الباب منهم أحمد بن حنبل رضي الله عنه حتى منع تأويل قوله كن فيكون وزعموا أن ذلك خطاب بحرف وصوت يوجد من الله تعالى في كل لحظة بعدد كون مكون حتى سمعت بعض أصحابه يقول إنه حسم باب ال", "english": "The fifth [division] is that one expresses by the tongue of explicit statement (lisān al-maqāl) what belongs to the tongue of state (lisān al-ḥāl). The one of deficient understanding stops at the outward and believes it to be literal speech, while the one with insight into realities perceives the secret within it. This is like the saying of one who said: \"The wall said to the peg: 'Why have you split me?' It replied: 'Ask the one who strikes me — he did not leave me behind the stone that is behind me.'\" This is an expression of the tongue of state by the tongue of explicit statement.", "book_title": "Foundations of Belief", "section_title_ar": "Section 85", "section_title_en": "The Fourth Division — Comprehension by Encounter and Taste (Al-Dhawq), and the Fifth Division — The Tongue of State (Lisān al-Ḥāl)", "section_index": 85, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core root denotes the faculty of knowing, perceiving a thing's reality; encompasses both direct apprehension and judgment about existence.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence itself and judgment concerning it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (maʿrifah) from awareness (shuʿūr); here, the distinction between superficial knowledge (ẓāhir) and realized knowledge (bāṭin) is rhetorical-metaphorical, not contradictory.\n- Root: ظهر (ẓahara)\n  * Lisan / Ayn: Core root denotes outwardness, visibility, strength of back; the ẓāhir is what is manifest and apparent.\n  * Al-Raghib (Mufradat): The ẓāhir is used metaphorically for the outward aspect of a thing, as opposed to its inner reality (bāṭin); the back (ẓahr) carries what is loaded upon it.\n  * Al-Zamakhshari (Asas - Majaz): \"قلبت الأمر ظهرا لبطن\" — turning a matter over, examining its outward and inward aspects; the ẓāhir is the shell (qishr) that contains and is completed by the inner kernel (lubb).\n- Root: وقع (waqaʿa)\n  * Lisan / Ayn: Core root denotes falling, occurring, befalling; a thing's occurrence and realization.\n  * Al-Raghib (Mufradat): \"الوقوع: ثبوت الشيء وسقوطه\" — occurrence is the establishment and falling of a thing; in Quranic usage, often associated with calamities and inevitable events.\n  * Al-Zamakhshari (Asas - Majaz): \"وقع الأمر حصل ووجد\" — the matter occurred, i.e., it became realized and existent; here, the \"occurrence\" of a state (ḥāl) is its actual realization in the soul, as opposed to mere intellectual assent before its descent.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure allows for separation between the operative word and its object to achieve rhetorical emphasis, mirroring the semantic distinction between outward apprehension and inward realization.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}], "69": [{"arabic": "وقال تعالى {وما علمناه الشعر وما ينبغي له} وأكثر ما اعتاده الوعاظ من الأشعار ما يتعلق بالتواصف في العشق وجمال المعشوق وروح الوصال وألم الفراق والمجلس لا يحوي إلا أجلاف العوام وبواطنهم مشحونة بالشهوات وقلوبهم غير منفكة عن الالتفات إلى الصور المليحة فلا تحرك الأشعار من قلوبهم إلا ما هو مستكن فيها فتشتعل فيها نيران الشهوات فيزعقون ويتواجدون وأكثر ذلك أو كله يرجع إلى نوع فساد فلا ينبغي أن يستعمل من الشعر إلا ما فيه موعظة أو حكمة على سبيل استشهاد واستئناس وقد قال صلى الله عليه", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "70": [{"arabic": "مرض} إشارة إلى مرض العقول وقوله عز وجل {لينذر من كان حيا} إشارة إلى من لم يحى حياة باطنة وكل حي بالبدن ميت بالقلب فهو عند الله من الموتى وإن كان عند الجهال من الأحياء ولذلك كان الشهداء أحياء عند ربهم يرزقون فرحين وإن كانوا موتى بالأبدان الثانية لذة يشارك الإنسان فيها بعض الحيوانات كلذة الرياسة والغلبة والاستيلاء وذلك موجود في الأسد والنمر وبعض الحيوانات الثالثة ما يشارك فيها سائر الحيوانات كلذة البطن والفرج وهذه أكثرها وجودا وهي أخسها ولذلك اشترك فيها كل ودرج حتى الديدان والحشرات ومن جاوز هذه الرتبة ت", "english": "The second type is the restricted one — he who has gathered some of these attributes but not others. For there may be a benefit that is painful, like the cutting off of a gangrenous finger or a tumor protruding from the body. And there may be a benefit that is ugly, like foolishness — for in relation to certain circumstances it is beneficial, as it has been said: \"He who has no intellect is at rest,\" for he is not accused of foresight, so he rests in the present moment until the time of his destruction arrives. And there may be that which is beneficial in one respect and harmful in another, like casting wealth into the sea when fearing drowning — for it is harmful to the wealth, beneficial to the soul in its deliverance.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 993", "section_title_en": "The Divisions of Benefit and the Hierarchy of Pleasures — Section 993", "section_index": 993, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core sense of magnitude, greatness, and by extension pride/arrogance (istikbār) as a moral ailment.\n  * Al-Raghib (Mufradat): Al-kibr is the state of self-amplification that blinds one to truth and disparages others — here coupled with the humiliation (dhull) of learning, forming a psychological contradiction.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) = physical largeness; metaphorical (majāz) = spiritual arrogance that prevents receptivity.\n- Root: نفع (n-f-ʿ)\n  * Lisan / Ayn: Benefit, utility, that which yields good outcome.\n  * Al-Raghib (Mufradat): \"النفع: ما يستعان به في الوصول إلى الخيرات\" — benefit is that by which one reaches goods; its opposite is ḍarar (harm). Benefit divides into the necessary (ḍarūrī) and the replaceable.\n  * Al-Zamakhshari (Asas): \"فيه نفع ومنفعة ومنافع\" — literal usage for tangible utility; extended to spiritual advantage.\n- Root: لذ (l-dh-dh)\n  * Lisan / Ayn: Pleasure, sweetness of perception; root denotes finding something agreeable to one's nature.\n  * Al-Raghib (Mufradat): Pleasure (ladhdhah) is the perception of what suits one's constitution; its ranks follow the nobility of the perceiving faculty.\n  * Al-Zamakhshari (Asas): Distinguishes bodily pleasure shared with beasts from intellectual pleasure unique to the heart.\n- Sibawayh Rule: باب التقسيم والترتيب (Division and Ordination) — periodic sentences structured by fa- (sequential) and ammā...fa- (as for...then) to mark categorical hierarchies.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "77": [{"arabic": "والشهوة والكبر والجهل والتكذيب والمجادلة كما قال تعالى أولم ير الإنسان أنا خلقناه من نطفة فإذا هو خصيم مبين فليتأمل هذه العجائب ليترقى منها إلى عجب العجائب وهو الصفة التي منها صدرت هذه الأعاجيب فلا يزال ينظر إلى الصنعة فيرى الصانع وأما أحوال الأنبياء عليهم السلام فإذا سمع منها كيف كذبوا وضربوا وقتل بعضهم فليفهم منه صفة الاستغناء لله عز وجل عن الرسل والمرسل إليهم وأنه لو أهلك جميعهم لم يؤثر في ملكه شيئا وإذا سمع نصرتهم في آخر الأمر فليفهم قدرة الله عز وجل وإرادته لنصرة الحق وأما أحوال المكذبين كعاد وثمود وما جرى عليهم فليكن فهمه منه استشعار الخوف من سطوت", "english": "I say: These meanings are buried treasures that are not unveiled except to the divinely aided ones. To this 'Ali — may God be pleased with him — alluded by his saying: \"The Messenger of God — may God's peace and blessings be upon him — did not confide to me anything that he concealed from the people, except that God — mighty and majestic — grants to a servant understanding (fahm) of His Book. So let one be eager in seeking that understanding.\" (1) And Ibn Mas'ud — may God be pleased with him — said: \"Whoever desires the knowledge of the first and the last, let him stir up the Qur'an.\" And the greatest of the sciences of the Qur'an lie beneath the names of God — mighty and majestic — and His attributes, for most of creation have grasped from them only matters befitting their understandings and have not stumbled upon their depths.", "book_title": "Contemplation", "section_title_ar": "Section 228", "section_title_en": "The Revival of the Religious Sciences — Section 228: On the Inner Meanings of the Qur'an and the Removal of Obstacles to Understanding", "section_index": 228, "anchors": "- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, discernment, the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one verifies the realities of what is perceived; distinct from mere hearing or transmission\n  * Al-Zamakhshari (Asas): Literal: swift apprehension; Metaphorical: the divine gift of insight into hidden meanings, as in the verse {ففهمناها سليمان}\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transformation from one state to another\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as that which is perpetually turned and overturned between states\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of understanding that is veiled or illuminated, rusted or polished\n- Root: سمع (s-m-')\n  * Lisan / Ayn: Hearing, the auditory faculty\n  * Al-Raghib (Mufradat): \"السمع: قوة في الأذن به يدرك الأصوات\" — extends metaphorically to comprehension and obedience; \"أو ألقى السمع وهو شهيد\" — one who casts his hearing while present\n  * Al-Zamakhshari (Asas): Literal: auditory perception; Metaphorical: attentive obedience and receptive understanding\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise delimitation of predicates such as \"إنما يتذكر أولوا الألباب\" where restriction confines the action to its proper subject", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Contemplation'", "badge": "Ethics"}], "78": [{"arabic": "كابتداء الإنشاء قال الله تعالى قال من يحيي العظام وهي رميم قل يحييها الذي أنشأها أول مرة فاستدل بالابتداء على الإعادة وقال عز وجل ما خلقكم ولا بعثكم إلا كنفس واحدة والإعادة ابتداء ثان فهو ممكن كالابتداء الأول الأصل الثاني سؤال منكر ونكير (2) وقد وردت به الأخبار فيجب التصديق به لأنه ممكن إذ ليس يستدعي إلا إعادة الحياة إلى جزء من الأجزاء الذي به فهم الخطاب وذلك ممكن في نفسه ولا يدفع ذلك ما يشاهد من سكون أجزاء الميت وعدم سماعنا للسؤال له فإن النائم ساكن بظاهره ويدرك بباطنه من الآلام واللذات ما يحس بتأثيره عند التنبه وقد كان رسول الله", "english": "For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].", "book_title": "Foundations of Belief", "section_title_ar": "Section 96", "section_title_en": "The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles", "section_index": 96, "anchors": "- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Foundations of Belief'", "badge": "Dhikr"}], "79": [{"arabic": "من مثله} وفي البعث {قل يحييها الذي أنشأها أول مرة} إلى غير ذلك من الآيات والأدلة ولم تزل الرسل صلوات الله عليهم يحاجون المنكرين ويجادلونهم قال تعالى {وجادلهم بالتي هي أحسن} فالصحابة رضي الله عنهم أيضا كانوا يحاجون المنكرين ويجادلون ولكن عند الحاجة وكانت الحاجة إليه قليلة في زمانهم وأول من سن دعوة المبتدعة بالمجادلة إلى الحق علي ابن أبي طالب رضي الله عنه إذ بعث ابن عباس رضي الله عنهما إلى الخوارج فكلمهم فقال ما تنقمون على إمامكم قالوا قاتل ولم يسب ولم يغنم فقال ذلك في قتال الكفار أرأيتم لو سبب", "english": "The mention of the proof (ḥujjah), the demand for it, and the search after it — how could these be prohibited, when God — may He be exalted — has said: {«قُلْ هَاتُوا بُرْهَانَكُمْ»} (Say: Bring forth your proof — Qur'an 2:111), and He — mighty and majestic — has said: {«لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَا مَنْ حَيَّ عَنْ بَيِّنَةٍ»} (So that he who perishes may perish upon clear evidence, and he who lives may live upon clear evidence — Qur'an 8:42), and He — may He be exalted — has said: {«هَلْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا»} (Have you any authority for this? — Qur'an 10:68), meaning a proof and demonstration, and He — may He be exalted — has said: {«قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ»} (Say: To God belongs the conclusive proof — Qur'an 6:149), and He — may He be exalted — has said: {«أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ»} (Have you not considered him who disputed with Abraham concerning his Lord? — Qur'an 2:258) up to His words: {«فَبُهِتَ الَّذِي كَفَرَ»} (So the one who disbelieved was confounded — Qur'an 2:258).", "book_title": "Foundations of Belief", "section_title_ar": "Section 77", "section_title_en": "The Revival of the Religious Sciences — Section 77: On the Permissibility of Theological Discourse (Kalām) and Its Early Practice", "section_index": 77, "anchors": "- Root: ح-د-ث (ḥ-d-th)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not; al-ḥadath: the novel event; al-ḥīdāth: origination.\"\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: a thing's becoming after it was not, whether accident or substance; iḥdāth: bringing it into existence. The origination of substances belongs to God alone.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'He is a recent event among events.' Metaphorical: 'They became topics of conversation (aḥādīth).'\"\n- Root: ح-ا-ج (ḥ-ā-j)\n  * Lisan / Ayn: \"Al-ḥājah: need of a thing, with desire for it; its plural: ḥājāt and ḥawā'ij.\"\n  * Al-Raghib (Mufradat): \"Al-ḥājah ilā al-shay': poverty toward it with love of it. God said: {«إِلَّا حَاجَةً فِي نَفْسِ يَعْقُوبَ»} (except a need in Jacob's soul — Qur'an 12:68).\"\n  * Al-Zamakhshari (Asas): \"Literal: need and want. The 'ḥājah' is that which one seeks to obtain.\"\n- Root: ك-و-ن (k-w-n)\n  * Lisan / Ayn: \"Kāna: to be, to exist; takwīn: bringing into being from non-existence.\"\n  * Al-Raghib (Mufradat): \"Al-kawn: existence after non-existence; the muḥdath (originated thing) is that brought forth after it was not.\"\n  * Al-Zamakhshari (Asas): \"Literal: being and becoming. Metaphorical: the continuous states of affairs.\"\n- Sibawayh Rule: Al-Faṣl bayna al-Jār wa-al-Majrūr (Prepositional Interposition) — The permissibility of separating a preposition from its object when the intervening clause is complete in meaning, as in the verse's structure of argumentation where the proof (ḥujjah) stands independently before its conclusion.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}], "82": [{"arabic": "الرابع أن لا يحوج رفيقه إلى أن يقول له كل قال بعض الأدباء أحسن الآكلين أكلا من لا يحوج صاحبه إلى أن يتفقده في الأكل وحمل عن أخيه مؤنة القول ولا ينبغي أن يدع شيئا مما يشتهيه لأجل نظر الغير إليه فإن ذلك تصنع بل يجري على المعتاد ولا ينقص من عادته شيئا في الوحدة ولكن يعود نفسه حسن الأدب في الوحدة حتى لا يحتاج إلى التصنع عند الاجتماع نعم لو قلل من أكله إيثارا لإخوانه ونظرا لهم عند الحاجة إلى ذلك فهو حسن وإن زاد في الأكل على نية المساعدة وتحريك نشاط القوم في الأكل فلا بأس به بل هو حسن وكا", "english": "If his companion eats little, he should energize him, make eating desirable to him, and say to him: \"Eat!\" — but he should not exceed three repetitions of the word \"Eat!\", for that is importunity (ilḥāḥ) and excess. The Messenger of God, may God bless him and grant him peace, when addressed concerning a matter three times, did not return to it after the third. {«كان إذا خوطب في شيء ثلاثا لم يراجع بعد ثلاث»} — narrated by Aḥmad from the ḥadīth of Jābir in a long report, and also from the ḥadīth of Abū Ḥadrad; their chains are sound. {«كان يكرر الكلمة ثلاثا»} — narrated by al-Bukhārī from the ḥadīth of Anas: \"He would repeat the word three times.\" Thus, exceeding this is not of the etiquette (al-adab).", "book_title": "Manners of Eating", "section_title_ar": "Section 286", "section_title_en": "The Revival of the Religious Sciences — Section 286: On the Etiquette of Eating in Company", "section_index": 286, "anchors": "- Root: أكل (akl)\n  * Lisan / Ayn: Core meaning is \"to eat, to consume food\"; Al-Farahidi notes the verbal noun for the act of eating, distinct from the morsel (uklah) and the meal (aklah).\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of nourishment; metaphorically extended to fire consuming wood. In company, the act carries social and ethical weight, not mere physical intake.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes physical consumption; metaphorical (Majaz) usage appears in phrases like \"فلان أكل غنمي\" (he consumed my sheep) meaning he fed others at my expense — relevant to the prohibition on taking more than one's share.\n- Root: حدث (ḥadath)\n  * Lisan / Ayn: New occurrence, event, or speech; Al-Farahidi links it to bringing forth something new.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence; for speech, it denotes fresh, edifying discourse.\n  * Al-Zamakhshari (Asas): Literal: recent events or sayings; Metaphorical: \"صاروا أحاديث\" (they became topics of talk). Here, \"يتحدثون\" (they converse) is literal — engaging in wholesome narrative.\n- Root: حسن (ḥusn)\n  * Lisan / Ayn: Beauty, goodness, excellence in form and conduct.\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which pleases and is desired, whether by intellect, inclination, or sense. In etiquette, it is the morally and rationally commendable.\n  * Al-Zamakhshari (Asas): Literal: physical beauty; Metaphorical: \"فلان لا يحسن شيئا\" (he does not do anything well) — skill and propriety in action, as in \"حسن الأدب\" (good manners).\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The conditional structures (إن كان، إذا كان) and prohibitions (لا يبتدئ، لا يسكتوا) function as restrictive predicates, delimiting permissible conduct from blameworthy action with precise syntactic boundaries.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Manners of Eating'", "badge": "Hadith"}]}, "wordTiming": {"minshawi": {"1": [[1, 340, 3390]], "36:1": [[1, 340, 3390]], "2": [[1, 380, 2114], [2, 2114, 3250]], "36:2": [[1, 380, 2114], [2, 2114, 3250]], "3": [[1, 400, 1377], [2, 1377, 2043], [3, 2043, 4010]], "36:3": [[1, 400, 1377], [2, 1377, 2043], [3, 2043, 4010]], "4": [[1, 20, 1156], [2, 1156, 2108], [3, 2108, 4080]], "36:4": [[1, 20, 1156], [2, 1156, 2108], [3, 2108, 4080]], "5": [[1, 370, 1592], [2, 1592, 2929], [3, 2929, 4380]], "36:5": [[1, 370, 1592], [2, 1592, 2929], [3, 2929, 4380]], "6": [[1, 20, 1044], [2, 1044, 2348], [3, 2348, 4415], [4, 4415, 5278], [5, 5278, 8449], [6, 8449, 9031], [7, 9031, 10530]], "36:6": [[1, 20, 1044], [2, 1044, 2348], [3, 2348, 4415], [4, 4415, 5278], [5, 5278, 8449], [6, 8449, 9031], [7, 9031, 10530]], "7": [[1, 400, 1038], [2, 1038, 1621], [3, 1621, 2559], [4, 2559, 4281], [5, 4281, 5410], [6, 5410, 5938], [7, 5938, 6612], [8, 6612, 8270]], "36:7": [[1, 400, 1038], [2, 1038, 1621], [3, 1621, 2559], [4, 2559, 4281], [5, 4281, 5410], [6, 5410, 5938], [7, 5938, 6612], [8, 6612, 8270]], "8": [[1, 720, 1889], [2, 1889, 3221], [3, 3221, 4792], [4, 4792, 6200], [5, 6200, 7704], [6, 7704, 8375], [7, 8375, 9103], [8, 9103, 10741], [9, 10741, 11297], [10, 11297, 13070]], "36:8": [[1, 720, 1889], [2, 1889, 3221], [3, 3221, 4792], [4, 4792, 6200], [5, 6200, 7704], [6, 7704, 8375], [7, 8375, 9103], [8, 9103, 10741], [9, 10741, 11297], [10, 11297, 13070]], "9": [[1, 590, 2375], [2, 2375, 2757], [3, 2757, 3444], [4, 3444, 4990], [5, 4990, 6050], [6, 6050, 6890], [7, 6890, 7854], [8, 7854, 8914], [9, 8914, 10795], [10, 10795, 11349], [11, 11349, 12055], [12, 12055, 13840]], "36:9": [[1, 590, 2375], [2, 2375, 2757], [3, 2757, 3444], [4, 3444, 4990], [5, 4990, 6050], [6, 6050, 6890], [7, 6890, 7854], [8, 7854, 8914], [9, 8914, 10795], [10, 10795, 11349], [11, 11349, 12055], [12, 12055, 13840]], "10": [[1, 740, 3769], [2, 3769, 4946], [3, 4946, 6583], [4, 6583, 7033], [5, 7033, 7442], [6, 7442, 8670], [7, 8670, 9427], [8, 9427, 11290]], "36:10": [[1, 740, 3769], [2, 3769, 4946], [3, 4946, 6583], [4, 6583, 7033], [5, 7033, 7442], [6, 7442, 8670], [7, 8670, 9427], [8, 9427, 11290]], "11": [[1, 220, 1889], [2, 1889, 2853], [3, 2853, 3323], [4, 3323, 4345], [5, 4345, 5585], [6, 5585, 7077], [7, 7077, 8722], [8, 8722, 10156], [9, 10156, 11566], [10, 11566, 12964], [11, 12964, 14351], [12, 14351, 15620]], "36:11": [[1, 220, 1889], [2, 1889, 2853], [3, 2853, 3323], [4, 3323, 4345], [5, 4345, 5585], [6, 5585, 7077], [7, 7077, 8722], [8, 8722, 10156], [9, 10156, 11566], [10, 11566, 12964], [11, 12964, 14351], [12, 14351, 15620]], "12": [[1, 590, 1711], [2, 1711, 2281], [3, 2281, 2961], [4, 2961, 4400], [5, 4400, 5576], [6, 5576, 6256], [7, 6256, 7919], [8, 7919, 9900], [9, 9900, 10846], [10, 10846, 11507], [11, 11507, 12949], [12, 12949, 14456], [13, 14456, 15540], [14, 15540, 16750]], "36:12": [[1, 590, 1711], [2, 1711, 2281], [3, 2281, 2961], [4, 2961, 4400], [5, 4400, 5576], [6, 5576, 6256], [7, 6256, 7919], [8, 7919, 9900], [9, 9900, 10846]