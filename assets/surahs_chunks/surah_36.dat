, {"id": 11, "arabic": "تَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 55, "text": "إِنَّ أَصْحَٰبَ اَ۬لْجَنَّةِ اِ۬لْيَوْمَ فِے شُغْلࣲ فَٰكِهُونَ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَصْحَٰبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْجَنَّةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْيَوْمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "شُغْلࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَٰكِهُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 56, "text": "هُمْ وَأَزْوَٰجُهُمْ فِے ظِلَٰلٍ عَلَي اَ۬لَارَآئِكِ مُتَّكِـُٔونَۖ", "words": [{"id": 1, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَأَزْوَٰجُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "ظِلَٰلٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لَارَآئِكِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُتَّكِـُٔونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 57, "text": "لَهُمْ فِيهَا فَٰكِهَةࣱۖ وَلَهُم مَّا يَدَّعُونَ", "words": [{"id": 1, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فَٰكِهَةࣱۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَدَّعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 58, "text": "سَلَٰمࣱۖ قَوْلاࣰ مِّن رَّبࣲّ رَّحِيمࣲۖ", "words": [{"id": 1, "arabic": "سَلَٰمࣱۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَوْلاࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "