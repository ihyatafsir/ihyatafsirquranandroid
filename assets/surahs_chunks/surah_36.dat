: 5, "char": "نَۖ", "start": 3887, "end": 4000, "duration": 113, "peakTime": 3938, "confidence": 0.99}]}}, "warshVerses": [{"surah": 36, "ayah": 1, "text": "يَسِٓۖ", "words": [{"id": 1, "arabic": "يَسِٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 2, "text": "وَالْقُرْءَانِ اِ۬لْحَكِيمِ", "words": [{"id": 1, "arabic": "وَالْقُرْءَانِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْحَكِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 3, "text": "إِنَّكَ لَمِنَ اَ۬لْمُرْسَلِينَ", "words": [{"id": 1, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَمِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْمُرْسَلِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 4, "text": "عَلَيٰ صِرَٰطࣲ مُّسْتَقِيمࣲۖ", "words": [{"id": 1, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "صِرَٰطࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّسْتَقِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 5, "text": "تَنزِيلُ اُ۬لْعَزِيزِ اِ۬لرَّحِيمِ", "words": [{"id": 1, "arabic": "تَنزِيلُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْعَزِيزِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لرَّحِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 6, "text": "لِتُنذِرَ قَوْماࣰ مَّآ أُنذِرَ ءَابَآؤُهُمْ فَهُمْ غَٰفِلُونَۖ", "words": [{"id": 1, "arabic": "لِتُنذِرَ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أُنذِرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَابَآؤُهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "غَٰفِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 7, "text": "۞لَقَدْ حَقَّ اَ۬لْقَوْلُ عَلَيٰٓ أَكْثَرِهِمْ فَهُمْ لَا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "۞لَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "حَقَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْقَوْلُ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَكْثَرِهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 8, "text": "إِنَّا جَعَلْنَا فِےٓ أَعْنَٰقِهِمُۥٓ أَغْلَٰلاࣰ فَهِيَ إِلَي اَ۬لَاذْقَانِ فَهُم مُّقْمَحُونَۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَعْنَٰقِهِمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَغْلَٰلاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَهِيَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لَاذْقَانِ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَهُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مُّقْمَحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 9, "text": "وَجَعَلْنَا مِنۢ بَيْنِ أَيْدِيهِمْ سُدّاࣰ وَمِنْ خَلْفِهِمْ سُدّاࣰ فَأَغْشَيْنَٰهُمْ فَهُمْ لَا يُبْصِرُونَۖ", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَيْنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَيْدِيهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "سُدّاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمِنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَلْفِهِمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "سُدّاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَأَغْشَيْنَٰهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "", "root": ""}, {"id": 12, "arabic": "يُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 10, "text": "وَسَوَآءٌ عَلَيْهِمُۥٓ ءَآنذَرْتَهُمُۥٓ أَمْ لَمْ تُنذِرْهُمْ لَا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "وَسَوَآءٌ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَآنذَرْتَهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تُنذِرْهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 11, "text": "إِنَّمَا تُنذِرُ مَنِ اِ۪تَّبَعَ اَ۬لذِّكْرَ وَخَشِيَ اَ۬لرَّحْمَٰنَ بِالْغَيْبِ فَبَشِّرْهُ بِمَغْفِرَةࣲ وَأَجْرࣲ كَرِيمٍۖ", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تُنذِرُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۪تَّبَعَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لذِّكْرَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَخَشِيَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لرَّحْمَٰنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِالْغَيْبِ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَبَشِّرْهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِمَغْفِرَةࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَأَجْرࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "كَرِيمٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 12, "text": "اِنَّا نَحْنُ نُحْيِ اِ۬لْمَوْت۪يٰ وَنَكْتُبُ مَا قَدَّمُواْ وَءَاثَٰرَهُمْۖ وَكُلَّ شَےْءٍ اَحْصَيْنَٰهُ فِےٓ إِمَامࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُحْيِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْمَوْت۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنَكْتُبُ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "قَدَّمُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَءَاثَٰرَهُمْۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَكُلَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَحْصَيْنَٰهُ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِمَامࣲ", "translit": "", "root": ""}, {"id": 14, "arabic": "مُّبِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 13, "text": "وَاضْرِبْ لَهُم مَّثَلاً اَصْحَٰبَ اَ۬لْقَرْيَةِ إِذْ جَآءَهَا اَ۬لْمُرْسَلُونَ", "words": [{"id": 1, "arabic": "وَاضْرِبْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّثَلاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اَصْحَٰبَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْقَرْيَةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 7, "arabic": "جَآءَهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْمُرْسَلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 14, "text": "إِذَ اَرْسَلْنَآ إِلَيْهِمُ اُ۪ثْنَيْنِ فَكَذَّبُوهُمَا فَعَزَّزْنَا بِثَالِثࣲ فَقَالُوٓاْ إِنَّآ إِلَيْكُم مُّرْسَلُونَۖ", "words": [{"id": 1, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيْهِمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۪ثْنَيْنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَكَذَّبُوهُمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فَعَزَّزْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بِثَالِثࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِلَيْكُم", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّرْسَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 15, "text": "قَالُواْ مَآ أَنتُمُۥٓ إِلَّا بَشَرࣱ مِّثْلُنَا وَمَآ أَنزَلَ اَ۬لرَّحْمَٰنُ مِن شَےْءٍ اِنَ اَنتُمُۥٓ إِلَّا تَكْذِبُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنتُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَشَرࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّثْلُنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "", "root": ""}, {"id": 11, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَنتُمُۥٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "تَكْذِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 16, "text": "قَالُواْ رَبُّنَا يَعْلَمُ إِنَّآ إِلَيْكُمْ لَمُرْسَلُونَ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبُّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيْكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَمُرْسَلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 17, "text": "وَمَا عَلَيْنَآ إِلَّا اَ۬لْبَلَٰغُ اُ۬لْمُبِينُۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْبَلَٰغُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْمُبِينُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 18, "text": "قَالُوٓاْ إِنَّا تَطَيَّرْنَا بِكُمْ لَئِن لَّمْ تَنتَهُواْ لَنَرْجُمَنَّكُمْ وَلَيَمَسَّنَّكُم مِّنَّا عَذَابٌ اَلِيمࣱۖ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَطَيَّرْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بِكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَئِن", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَنتَهُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَنَرْجُمَنَّكُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَيَمَسَّنَّكُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّنَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَلِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 19, "text": "قَالُواْ طَٰٓئِرُكُم مَّعَكُمُۥٓ أَئِن ذُكِّرْتُمۖ بَلَ اَنتُمْ قَوْمࣱ مُّسْرِفُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "طَٰٓئِرُكُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّعَكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَئِن", "translit": "", "root": ""}, {"id": 5, "arabic": "ذُكِّرْتُمۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّسْرِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 20, "text": "وَجَآءَ مِنَ اَقْصَا اَ۬لْمَدِينَةِ رَجُلࣱ يَسْع۪يٰۖ قَالَ يَٰقَوْمِ اِ۪تَّبِعُواْ اُ۬لْمُرْسَلِينَ", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَقْصَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَدِينَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَجُلࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَسْع۪يٰۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۪تَّبِعُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْمُرْسَلِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 21, "text": "اَ۪تَّبِعُواْ مَن لَّا يَسْـَٔلُكُمُۥٓ أَجْراࣰ وَهُم مُّهْتَدُونَۖ", "words": [{"id": 1, "arabic": "اَ۪تَّبِعُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْـَٔلُكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَجْراࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّهْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 22, "text": "وَمَا لِيَ لَآ أَعْبُدُ اُ۬لذِے فَطَرَنِے وَإِلَيْهِ تُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَعْبُدُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 6, "arabic": "فَطَ