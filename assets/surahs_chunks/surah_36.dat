warsh"}, {"surah": 36, "ayah": 20, "text": "وَجَآءَ مِنَ اَقْصَا اَ۬لْمَدِينَةِ رَجُلࣱ يَسْع۪يٰۖ قَالَ يَٰقَوْمِ اِ۪تَّبِعُواْ اُ۬لْمُرْسَلِينَ", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَقْصَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَدِينَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَجُلࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَسْع۪يٰۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۪تَّبِعُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْمُرْسَلِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 21, "text": "اَ۪تَّبِعُواْ مَن لَّا يَسْـَٔلُكُمُۥٓ أَجْراࣰ وَهُم مُّهْتَدُونَۖ", "words": [{"id": 1, "arabic": "اَ۪تَّبِعُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْـَٔلُكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَجْراࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّهْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 22, "text": "وَمَا لِيَ لَآ أَعْبُدُ اُ۬لذِے فَطَرَنِے وَإِلَيْهِ تُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَعْبُدُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 6, "arabic": "فَطَرَنِے", "translit": "", "root": ""}, {"id": 7, "arabic": "وَإِلَيْهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "تُرْجَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 23, "text": "ءَآتَّخِذُ مِن دُونِهِۦٓ ءَالِهَةً اِنْ يُّرِدْنِ اِ۬لرَّحْمَٰنُ بِضُرࣲّ لَّا تُغْنِ عَنِّے شَفَٰعَتُهُمْ شَئْاࣰ وَلَا يُنقِذُونِۦٓۖ", "words": [{"id": 1, "arabic": "ءَآتَّخِذُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "دُونِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَالِهَةً", "translit": "", "root": ""}, {"id": 5, "arabic": "اِنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُّرِدْنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِضُرࣲّ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "تُغْنِ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَنِّے", "translit": "", "root": ""}, {"id": 12, "arabic": "شَفَٰعَتُهُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "شَئْاࣰ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 15, "arabic": "يُنقِذُونِۦٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 24, "text": "إِنِّيَ إِذاࣰ لَّفِے ضَلَٰلࣲ مُّبِينٍۖ", "words": [{"id": 1, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّفِے", "translit": "", "root": ""}, {"id": 4, "arabic": "ضَلَٰلࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّبِينٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 25, "text": "اِنِّيَ ءَامَنتُ بِرَبِّكُمْ فَاسْمَعُونِۖ", "words": [{"id": 1, "arabic": "اِنِّيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِرَبِّكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاسْمَعُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 26, "text": "قِيلَ اَ۟دْخُلِ اِ۬لْجَنَّةَۖ قَالَ يَٰلَيْتَ قَوْمِے يَعْلَمُونَ", "words": [{"id": 1, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۟دْخُلِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْجَنَّةَۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰلَيْتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَوْمِے", "translit": "", "root": ""}, {"id": 7, "arabic": "يَعْلَمُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 27, "text": "بِمَا غَفَرَ لِے رَبِّے وَجَعَلَنِے مِنَ اَ۬لْمُكْرَمِينَۖ", "words": [{"id": 1, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "غَفَرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِے", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 5, "arabic": "وَجَعَلَنِے", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُكْرَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 28, "text": "۞وَمَآ أَنزَلْنَا عَلَيٰ قَوْمِهِۦ مِنۢ بَعْدِهِۦ مِن جُندࣲ مِّنَ اَ۬لسَّمَآءِ وَمَا كُنَّا مُنزِلِينَۖ", "words": [{"id": 1, "arabic": "۞وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَعْدِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "جُندࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 12, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 13, "arabic": "مُنزِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 29, "text": "إِن كَانَتِ اِلَّا صَيْحَةࣰ وَٰحِدَةࣰ فَإِذَا هُمْ خَٰمِدُونَۖ", "words": [{"id": 1, "arabic": "إِن", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "صَيْحَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَٰحِدَةࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "خَٰمِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 30, "text": "يَٰحَسْرَةً عَلَي اَ۬لْعِبَادِۖ مَا يَاتِيهِم مِّن رَّسُولٍ اِلَّا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ", "words": [{"id": 1, "arabic": "يَٰحَسْرَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْعِبَادِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَاتِيهِم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 7, "arabic": "رَّسُولٍ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَسْتَهْزِءُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 31, "text": "أَلَمْ يَرَوْاْ كَمَ اَهْلَكْنَا قَبْلَهُم مِّنَ اَ۬لْقُرُونِ أَنَّهُمُۥٓ إِلَيْهِمْ لَا يَرْجِعُونَۖ", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرَوْاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَهْلَكْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلَهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقُرُونِ", "