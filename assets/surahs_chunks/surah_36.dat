arsh"}, {"surah": 36, "ayah": 11, "text": "إِنَّمَا تُنذِرُ مَنِ اِ۪تَّبَعَ اَ۬لذِّكْرَ وَخَشِيَ اَ۬لرَّحْمَٰنَ بِالْغَيْبِ فَبَشِّرْهُ بِمَغْفِرَةࣲ وَأَجْرࣲ كَرِيمٍۖ", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تُنذِرُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۪تَّبَعَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لذِّكْرَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَخَشِيَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لرَّحْمَٰنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِالْغَيْبِ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَبَشِّرْهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِمَغْفِرَةࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَأَجْرࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "كَرِيمٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 12, "text": "اِنَّا نَحْنُ نُحْيِ اِ۬لْمَوْت۪يٰ وَنَكْتُبُ مَا قَدَّمُواْ وَءَاثَٰرَهُمْۖ وَكُلَّ شَےْءٍ اَحْصَيْنَٰهُ فِےٓ إِمَامࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُحْيِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْمَوْت۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنَكْتُبُ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "قَدَّمُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَءَاثَٰرَهُمْۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَكُلَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَحْصَيْنَٰهُ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِمَامࣲ", "translit": "", "root": ""}, {"id": 14, "arabic": "مُّبِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 13, "text": "وَاضْرِبْ لَهُم مَّثَلاً اَصْحَٰبَ اَ۬لْقَرْيَةِ إِذْ جَآءَهَا اَ۬لْمُرْسَلُونَ", "words": [{"id": 1, "arabic": "وَاضْرِبْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّثَلاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اَصْحَٰبَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْقَرْيَةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 7, "arabic": "جَآءَهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْمُرْسَلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 14, "text": "إِذَ اَرْسَلْنَآ إِلَيْهِمُ اُ۪ثْنَيْنِ فَكَذَّبُوهُمَا فَعَزَّزْنَا بِثَالِثࣲ فَقَالُوٓاْ إِنَّآ إِلَيْكُم مُّرْسَلُونَۖ", "words": [{"id": 1, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيْهِمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۪ثْنَيْنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَكَذَّبُوهُمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فَعَزَّزْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بِثَالِثࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِلَيْكُم", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّرْسَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 15, "text": "قَالُواْ مَآ أَنتُمُۥٓ إِلَّا بَشَرࣱ مِّثْلُنَا وَمَآ أَنزَلَ اَ۬لرَّحْمَٰنُ مِن شَےْءٍ اِنَ اَنتُمُۥٓ إِلَّا تَكْذِبُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنتُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَشَرࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّثْلُنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "", "root": ""}, {"id": 11, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَنتُمُۥٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "تَكْذِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 16, "text": "قَالُواْ رَبُّنَا يَعْلَمُ إِنَّآ إِلَيْكُمْ لَمُرْسَلُونَ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبُّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيْكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَمُرْسَلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 17, "text": "وَمَا عَلَيْنَآ إِلَّا اَ۬لْبَلَٰغُ اُ۬لْمُبِينُۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْبَلَٰغُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْمُبِينُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 18, "text": "قَالُوٓاْ إِنَّا تَطَيَّرْنَا بِكُمْ لَئِن لَّمْ تَنتَهُواْ لَنَرْجُمَنَّكُمْ وَلَيَمَسَّنَّكُم مِّنَّا عَذَابٌ اَلِيمࣱۖ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَطَيَّرْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "بِكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَئِن", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَنتَهُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَنَرْجُمَنَّكُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَيَمَسَّنَّكُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّنَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَلِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 19, "text": "قَالُواْ طَٰٓئِرُكُم مَّعَكُمُۥٓ أَئِن ذُكِّرْتُمۖ بَلَ اَنتُمْ قَوْمࣱ مُّسْرِفُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "طَٰٓئِرُكُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّعَكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَئِن", "translit": "", "root": ""}, {"id": 5, "arabic": "ذُكِّرْتُمۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّسْرِفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 20, "text": "وَجَآءَ مِنَ اَقْصَا اَ۬لْمَدِينَةِ رَجُلࣱ يَسْع۪يٰۖ قَالَ يَٰقَوْمِ اِ۪تَّبِعُواْ اُ۬لْمُرْسَلِينَ", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَقْصَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَدِينَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَجُلࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَسْع۪يٰۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۪تَّبِعُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْمُرْسَلِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 21, "text": "اَ۪تَّبِعُواْ مَن لَّا يَسْـَٔلُكُمُۥٓ أَجْراࣰ وَهُم مُّهْتَدُونَۖ", "words": [{"id": 1, "arabic": "اَ۪تَّبِعُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْـَٔلُكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَجْراࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّهْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 22, "text": "وَمَا لِيَ لَآ أَعْبُدُ اُ۬لذِے فَطَرَنِے وَإِلَيْهِ تُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَعْبُدُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 6, "arabic": "فَطَرَنِے", "translit": "", "root": ""}, {"id": 7, "arabic": "وَإِلَيْهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "تُرْجَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 23, "text": "ءَآتَّخِذُ مِن دُونِهِۦٓ ءَالِهَةً اِنْ يُّرِدْنِ اِ۬لرَّحْمَٰنُ بِضُرࣲّ لَّا تُغْنِ عَنِّے شَفَٰعَتُهُمْ شَئْاࣰ وَلَا يُنقِذُونِۦٓۖ", "words": [{"id": 1, "arabic": "ءَآتَّخِذُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "دُونِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَالِهَةً", "translit": "", "root": ""}, {"id": 5, "arabic": "اِنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُّرِدْنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِضُرࣲّ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "تُغْنِ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَنِّے", "translit": "", "root": ""}, {"id": 12, "arabic": "شَفَٰعَتُهُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "شَئْاࣰ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 15, "arabic": "يُنقِذُونِۦٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 24, "text": "إِنِّيَ إِذاࣰ لَّفِے ضَلَٰلࣲ مُّبِينٍۖ", "words": [{"id": 1, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّفِے", "translit": "", "root": ""}, {"id": 4, "arabic": "ضَلَٰلࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّبِينٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 25, "text": "اِنِّيَ ءَامَنتُ بِرَبِّكُمْ فَاسْمَعُونِۖ", "words": [{"id": 1, "arabic": "اِنِّيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِرَبِّكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاسْمَعُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 26, "text": "قِيلَ اَ۟دْخُلِ اِ۬لْجَنَّةَۖ قَالَ يَٰلَيْتَ قَوْمِے يَعْلَمُونَ", "words": [{"id": 1, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۟دْخُلِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْجَنَّةَۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰلَيْتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَوْمِے", "translit": "", "root": ""}, {"id": 7, "arabic": "يَعْلَمُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 27, "text": "بِمَا غَفَرَ لِے رَبِّے وَجَعَلَنِے مِنَ اَ۬لْمُكْرَمِينَۖ", "words": [{"id": 1, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "غَفَرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِے", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 5, "arabic": "وَجَعَلَنِے", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُكْرَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 28, "text": "۞وَمَآ أَنزَلْنَا عَلَيٰ قَوْمِهِۦ مِنۢ بَعْدِهِۦ مِن جُندࣲ مِّنَ اَ۬لسَّمَآءِ وَمَا كُنَّا مُنزِلِينَۖ", "words": [{"id": 1, "arabic": "۞وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَعْدِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "جُندࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 12, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 13, "arabic": "مُنزِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 29, "text": "إِن كَانَتِ اِلَّا صَيْحَةࣰ وَٰحِدَةࣰ فَإِذَا هُمْ خَٰمِدُونَۖ", "words": [{"id": 1, "arabic": "إِن", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "صَيْحَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَٰحِدَةࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "خَٰمِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 30, "text": "يَٰحَسْرَةً عَلَي اَ۬لْعِبَادِۖ مَا يَاتِيهِم مِّن رَّسُولٍ اِلَّا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ", "words": [{"id": 1, "arabic": "يَٰحَسْرَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْعِبَادِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَاتِيهِم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 7, "arabic": "رَّسُولٍ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَسْتَهْزِءُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 31, "text": "أَلَمْ يَرَوْاْ كَمَ اَهْلَكْنَا قَبْلَهُم مِّنَ اَ۬لْقُرُونِ أَنَّهُمُۥٓ إِلَيْهِمْ لَا يَرْجِعُونَۖ", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرَوْاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَهْلَكْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلَهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقُرُونِ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَيْهِمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يَرْجِعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 32, "text": "وَإِن كُلࣱّ لَّمَا جَمِيعࣱ لَّدَيْنَا مُحْضَرُونَۖ", "words": [{"id": 1, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "كُلࣱّ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "جَمِيعࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّدَيْنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مُحْضَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 33, "text": "وَءَايَةࣱ لَّهُمُ اُ۬لَارْضُ اُ۬لْمَيِّتَةُ أَحْيَيْنَٰهَا وَأَخْرَجْنَا مِنْهَا حَبّاࣰ فَمِنْهُ يَاكُلُونَۖ", "words": [{"id": 1, "arabic": "وَءَايَةࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لَارْضُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْمَيِّتَةُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَحْيَيْنَٰهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَخْرَجْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 8, "arabic": "حَبّاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَمِنْهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَاكُلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 34, "text": "وَجَعَلْنَا فِيهَا جَنَّٰتࣲ مِّن نَّخِيلࣲ وَأَعْنَٰبࣲ وَفَجَّرْنَا فِيهَا مِنَ اَ۬لْعُيُونِ", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "نَّخِيلࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَعْنَٰبࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَفَجَّرْنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْعُيُونِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 35, "text": "لِيَاكُلُواْ مِن ثَمَرِهِۦ وَمَا عَمِلَتْهُ أَيْدِيهِمُۥٓۖ أَفَلَا يَشْكُرُونَۖ", "words": [{"id": 1, "arabic": "لِيَاكُلُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "ثَمَرِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "عَمِلَتْهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَيْدِيهِمُۥٓۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَشْكُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 36, "text": "سُبْحَٰنَ اَ۬لذِے خَلَقَ اَ۬لَازْوَٰجَ كُلَّهَا مِمَّا تُنۢبِتُ اُ۬لَارْضُ وَمِنَ اَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "سُبْحَٰنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَازْوَٰجَ", "translit": "", "root": ""}, {"id": 5, "arabic": "كُلَّهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مِمَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "تُنۢبِتُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لَارْضُ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَنفُسِهِمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَمِمَّا", "translit": "", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "", "root": ""}, {"id": 13, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 37, "text": "وَءَايَةࣱ لَّهُمُ اُ۬ليْلُ نَسْلَخُ مِنْهُ اُ۬لنَّهَارَ فَإِذَا هُم مُّظْلِمُونَۖ", "words": [{"id": 1, "arabic": "وَءَايَةࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬ليْلُ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَسْلَخُ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لنَّهَارَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 8, "arabic": "هُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّظْلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 38, "text": "وَالشَّمْسُ تَجْرِے لِمُسْتَقَرࣲّ لَّهَاۖ ذَٰلِكَ تَقْدِيرُ اُ۬لْعَزِيزِ اِ۬لْعَلِيمِۖ", "words": [{"id": 1, "arabic": "وَالشَّمْسُ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَجْرِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لِمُسْتَقَرࣲّ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّهَاۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَقْدِيرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْعَزِيزِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْعَلِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 39, "text": "وَالْقَمَرُ قَدَّرْنَٰهُ مَنَازِلَ حَتَّيٰ عَادَ كَالْعُرْجُونِ اِ۬لْقَدِيمِۖ", "words": [{"id": 1, "arabic": "وَالْقَمَرُ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَدَّرْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَنَازِلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَادَ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَالْعُرْجُونِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْقَدِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 40, "text": "لَا اَ۬لشَّمْسُ يَنۢبَغِے لَهَآ أَن تُدْرِكَ اَ۬لْقَمَرَ وَلَا اَ۬ليْلُ سَابِقُ اُ۬لنَّه۪ارِۖ وَكُلࣱّ فِے فَلَكࣲ يَسْبَحُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لشَّمْسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَنۢبَغِے", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تُدْرِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقَمَرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬ليْلُ", "translit": "", "root": ""}, {"id": 10, "arabic": "سَابِقُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لنَّه۪ارِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَكُلࣱّ", "translit": "", "root": ""}, {"id": 13, "arabic": "فِے", "translit": "", "root": ""}, {"id": 14, "arabic": "فَلَكࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَسْبَحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 41, "text": "وَءَايَةࣱ لَّهُمُۥٓ أَنَّا حَمَلْنَا ذُرِّيَّٰتِهِمْ فِے اِ۬لْفُلْكِ اِ۬لْمَشْحُونِ", "words": [{"id": 1, "arabic": "وَءَايَةࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "حَمَلْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "ذُرِّيَّٰتِهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْفُلْكِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْمَشْحُونِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 42, "text": "وَخَلَقْنَا لَهُم مِّن مِّثْلِهِۦ مَا يَرْكَبُونَۖ", "words": [{"id": 1, "arabic": "وَخَلَقْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّثْلِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَرْكَبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 43, "text": "وَإِن نَّشَأْ نُغْرِقْهُمْ فَلَا صَرِيخَ لَهُمْ وَلَا هُمْ يُنقَذُونَ", "words": [{"id": 1, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "نَّشَأْ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُغْرِقْهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "صَرِيخَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُمْ", "translit": "", "root": ""}, {