, "narration": "warsh"}, {"surah": 36, "ayah": 37, "text": "وَءَايَةࣱ لَّهُمُ اُ۬ليْلُ نَسْلَخُ مِنْهُ اُ۬لنَّهَارَ فَإِذَا هُم مُّظْلِمُونَۖ", "words": [{"id": 1, "arabic": "وَءَايَةࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬ليْلُ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَسْلَخُ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لنَّهَارَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 8, "arabic": "هُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّظْلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 38, "text": "وَالشَّمْسُ تَجْرِے لِمُسْتَقَرࣲّ لَّهَاۖ ذَٰلِكَ تَقْدِيرُ اُ۬لْعَزِيزِ اِ۬لْعَلِيمِۖ", "words": [{"id": 1, "arabic": "وَالشَّمْسُ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَجْرِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لِمُسْتَقَرࣲّ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّهَاۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَقْدِيرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْعَزِيزِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْعَلِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 39, "text": "وَالْقَمَرُ قَدَّرْنَٰهُ مَنَازِلَ حَتَّيٰ عَادَ كَالْعُرْجُونِ اِ۬لْقَدِيمِۖ", "words": [{"id": 1, "arabic": "وَالْقَمَرُ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَدَّرْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَنَازِلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَادَ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَالْعُرْجُونِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْقَدِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 40, "text": "لَا اَ۬لشَّمْسُ يَنۢبَغِے لَهَآ أَن تُدْرِكَ اَ۬لْقَمَرَ وَلَا اَ۬ليْلُ سَابِقُ اُ۬لنَّه۪ارِۖ وَكُلࣱّ فِے فَلَكࣲ يَسْبَحُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لشَّمْسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَنۢبَغِے", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تُدْرِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقَمَرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬ليْلُ", "translit": "", "root": ""}, {"id": 10, "arabic": "سَابِقُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لنَّه۪ارِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَكُلࣱّ", "translit": "", "root": ""}, {"id": 13, "arabic": "فِے", "translit": "", "root": ""}, {"id": 14, "arabic": "فَلَكࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَسْبَحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 41, "text": "وَءَايَةࣱ لَّهُمُۥٓ أَنَّا حَمَلْنَا ذُرِّيَّٰتِهِمْ فِے اِ۬لْفُلْكِ اِ۬لْمَشْحُونِ", "words": [{"id": 1, "arabic": "وَءَايَةࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "حَمَلْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "ذُرِّيَّٰتِهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْفُلْكِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْمَشْحُونِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 42, "text": "وَخَلَقْنَا لَهُم مِّن مِّثْلِهِۦ مَا يَرْكَبُونَۖ", "words": [{"id": 1, "arabic": "وَخَلَقْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّثْلِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يَرْكَبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 43, "text": "وَإِن نَّشَأْ نُغْرِقْهُمْ فَلَا صَرِيخَ لَهُمْ وَلَا هُمْ يُنقَذُونَ", "words": [{"id": 1, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "نَّشَأْ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُغْرِقْهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "صَرِيخَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 8, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُنقَذُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 44, "text": "إِلَّا رَحْمَةࣰ مِّنَّا وَمَتَٰعاً اِلَيٰ حِينࣲۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَحْمَةࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَتَٰعاً", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "حِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 45, "text": "وَإِذَا قِيلَ لَهُمُ اُ۪تَّقُواْ مَا بَيْنَ أَيْدِيكُمْ وَمَا خَلْفَكُمْ لَعَلَّكُمْ تُرْحَمُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۪تَّقُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَيْدِيكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "خَلْفَكُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَعَلَّكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "تُرْحَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 46, "text": "۞وَمَا تَاتِيهِم مِّنَ اٰيَةࣲ مِّنَ اٰيَٰتِ رَبِّهِمُۥٓ إِلَّا كَانُواْ عَنْهَا مُعْرِضِينَۖ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَاتِيهِم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اٰيَةࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰيَٰتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَبِّهِمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "مُعْرِضِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 47, "text": "وَإِذَا قِيلَ لَهُمُۥٓ أَنفِقُواْ مِمَّا رَزَقَكُمُ اُ۬للَّهُ قَالَ اَ۬لذِينَ كَفَرُواْ لِلذِينَ ءَامَنُوٓاْ أَنُطْعِمُ مَن لَّوْ يَشَآءُ اُ۬للَّهُ أَطْعَمَهُۥٓ إِنَ اَنتُمُۥٓ إِلَّا فِے ضَلَٰلࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنفِقُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِمَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "رَزَقَكُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لِلذِينَ", "translit": "", 