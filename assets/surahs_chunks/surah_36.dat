anslit": "", "root": ""}, {"id": 7, "arabic": "رَبِّهِمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "مُعْرِضِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 47, "text": "وَإِذَا قِيلَ لَهُمُۥٓ أَنفِقُواْ مِمَّا رَزَقَكُمُ اُ۬للَّهُ قَالَ اَ۬لذِينَ كَفَرُواْ لِلذِينَ ءَامَنُوٓاْ أَنُطْعِمُ مَن لَّوْ يَشَآءُ اُ۬للَّهُ أَطْعَمَهُۥٓ إِنَ اَنتُمُۥٓ إِلَّا فِے ضَلَٰلࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنفِقُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِمَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "رَزَقَكُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لِلذِينَ", "translit": "", "root": ""}, {"id": 12, "arabic": "ءَامَنُوٓاْ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَنُطْعِمُ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَن", "translit": "", "root": ""}, {"id": 15, "arabic": "لَّوْ", "translit": "", "root": ""}, {"id": 16, "arabic": "يَشَآءُ", "translit": "", "root": ""}, {"id": 17, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 18, "arabic": "أَطْعَمَهُۥٓ", "translit": "", "root": ""}, {"id": 19, "arabic": "إِنَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَنتُمُۥٓ", "translit": "", "root": ""}, {"id": 21, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 22, "arabic": "فِے", "translit": "", "root": ""}, {"id": 23, "arabic": "ضَلَٰل