", "root": ""}, {"id": 6, "arabic": "كَالْعُرْجُونِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْقَدِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 40, "text": "لَا اَ۬لشَّمْسُ يَنۢبَغِے لَهَآ أَن تُدْرِكَ اَ۬لْقَمَرَ وَلَا اَ۬ليْلُ سَابِقُ اُ۬لنَّه۪ارِۖ وَكُلࣱّ فِے فَلَكࣲ يَسْبَحُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لشَّمْسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَنۢبَغِے", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تُدْرِكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقَمَرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬ليْلُ", "translit": "", "root": ""}, {"id": 10, "arabic": "سَابِقُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لنَّه۪ارِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَكُلࣱّ", "translit": "", "root": ""}, {"id": 13, "arabic": "فِے", "translit": "", "root": ""}, {"id": 14, "arabic": "فَلَكࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَسْبَحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 41, "text": "وَءَايَةࣱ لَّهُمُۥٓ أَنَّا حَمَلْنَا ذُرِّيَّٰتِهِمْ فِے اِ۬لْفُلْكِ اِ۬لْمَشْحُونِ", "words": [{"id": 1, "arabic": "وَءَايَةࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "حَمَلْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "ذُرِّيَّٰتِهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْفُلْكِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لْمَشْحُونِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 42, "text": "وَخَلَقْنَا لَهُم مِّن