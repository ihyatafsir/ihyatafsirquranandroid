 "translit": "", "root": ""}, {"id": 9, "arabic": "خَلْقٍ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 80, "text": "۞اِ۬لذِے جَعَلَ لَكُم مِّنَ اَ۬لشَّجَرِ اِ۬لَاخْضَرِ نَاراࣰ فَإِذَآ أَنتُم مِّنْهُ تُوقِدُونَۖ", "words": [{"id": 1, "arabic": "۞اِ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لشَّجَرِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لَاخْضَرِ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَاراࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَإِذَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَنتُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "تُوقِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 36, "ayah": 81, "text": "أَوَلَيْسَ اَ۬لذِے خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ بِقَٰدِرٍ عَلَيٰٓ أَنْ يَّخْلُقَ مِثْلَهُمۖ بَل۪يٰ وَهُوَ اَ۬لْخَلَّٰقُ اُ۬لْعَلِيمُۖ", "words": [{"id": 1, "arabic": "أَوَلَيْسَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِقَٰدِرٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَّخْلُقَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِثْلَهُمۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "بَل۪يٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لْخَلَّٰقُ", "translit": "", "r