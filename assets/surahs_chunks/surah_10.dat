4, "text": "۞قُلْ يَٰٓأَيُّهَا اَ۬لنَّاسُ إِن كُنتُمْ فِے شَكࣲّ مِّن دِينِے فَلَآ أَعْبُدُ اُ۬لذِينَ تَعْبُدُونَ مِن دُونِ اِ۬للَّهِۖ وَلَٰكِنَ اَعْبُدُ اُ۬للَّهَ اَ۬لذِے يَتَوَفّ۪يٰكُمْۖ وَأُمِرْتُ أَنَ اَكُونَ مِنَ اَ۬لْمُومِنِينَ", "words": [{"id": 1, "arabic": "۞قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "شَكࣲّ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 9, "arabic": "دِينِے", "translit": "", "root": ""}, {"id": 10, "arabic": "فَلَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَعْبُدُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 13, "arabic": "تَعْبُدُونَ", "translit": "", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "", "root": ""}, {"id": 15, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 16, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَلَٰكِنَ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَعْبُدُ", "translit": "", "root": ""}, {"id": 19, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 21, "arabic": "يَتَوَفّ۪يٰكُمْۖ", "translit": "", "root": ""}, {"id": 22, "arabic": "وَأُمِرْتُ", "translit": "", "root": ""}, {"id": 23, "arabic": "أَنَ", "translit": "", "root": ""}, {"id": 24, "arabic": "اَكُونَ", "translit": "", "root": ""}, {"id": 25, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 26, "arabic": "اَ۬لْمُومِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 105, "text": "وَأَنَ اَقِمْ وَجْهَكَ لِلدِّينِ حَنِيفاࣰۖ وَلَا تَكُونَنَّ مِنَ اَ۬لْمُشْرِكِينَۖ", "words"