, {"surah": 10, "ayah": 3, "text": "۞اِنَّ رَبَّكُمُ اُ۬للَّهُ اُ۬لذِے خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ فِے سِتَّةِ أَيَّامࣲ ثُمَّ اَ۪سْتَو۪يٰ عَلَي اَ۬لْعَرْشِۖ يُدَبِّرُ اُ۬لَامْرَۖ مَا مِن شَفِيعٍ اِلَّا مِنۢ بَعْدِ إِذْنِهِۦۖ ذَٰلِكُمُ اُ۬للَّهُ رَبُّكُمْۖ فَاعْبُدُوهُۖ أَفَلَا تَذَّكَّرُونَۖ", "words": [{"id": 1, "arabic": "۞اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "سِتَّةِ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَيَّامࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۪سْتَو۪يٰ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لْعَرْشِۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "يُدَبِّرُ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لَامْرَۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "مَا", "translit": "", "root": ""}, {"id": 18, "arabic": "مِن", "translit": "", "root": ""}, {"id": 19, "arabic": "شَفِيعٍ", "translit": "", "root": ""}, {"id": 20, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 21, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 22, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 23, "arabic": "إِذْنِهِۦۖ", "translit": "", "root": ""}, {"id": 24, "arabic": "ذَٰلِكُمُ", "translit": "", "root": ""}, {"id": 25, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 26, "arabic": "رَبُّكُمْۖ", "translit": "", "root": ""}, {"id": 27, "arabic": "فَاعْبُدُوهُۖ", "translit": "", "root": ""}, {"id": 28, "arabic": "