َلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 42, "text": "وَمِنْهُم مَّنْ يَّسْتَمِعُونَ إِلَيْكَۖ أَفَأَنتَ تُسْمِعُ اُ۬لصُّمَّ وَلَوْ كَانُواْ لَا يَعْقِلُونَۖ", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَّسْتَمِعُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيْكَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَفَأَنتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تُسْمِعُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لصُّمَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يَعْقِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 43, "text": "وَمِنْهُم مَّنْ يَّنظُرُ إِلَيْكَۖ أَفَأَنتَ تَهْدِے اِ۬لْعُمْيَ وَلَوْ كَانُواْ لَا يُبْصِرُونَۖ", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَّنظُرُ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيْكَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَفَأَنتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَهْدِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْعُمْيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 44, "text": "إِنَّ اَ۬للَّهَ لَا يَظْلِمُ اُ۬لنَّاسَ شَئْاࣰۖ وَلَٰكِنَّ اَ۬لنَّاسَ أَنفُسَهُمْ يَظْلِمُونَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَ