, "arabic": "اَكُونَ", "translit": "", "root": ""}, {"id": 25, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 26, "arabic": "اَ۬لْمُومِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 105, "text": "وَأَنَ اَقِمْ وَجْهَكَ لِلدِّينِ حَنِيفاࣰۖ وَلَا تَكُونَنَّ مِنَ اَ۬لْمُشْرِكِينَۖ", "words": [{"id": 1, "arabic": "وَأَنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَقِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَجْهَكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلدِّينِ", "translit": "", "root": ""}, {"id": 5, "arabic": "حَنِيفاࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تَكُونَنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْمُشْرِكِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 106, "text": "وَلَا تَدْعُ مِن دُونِ اِ۬للَّهِ مَا لَا يَنفَعُكَ وَلَا يَضُرُّكَۖ فَإِن فَعَلْتَ فَإِنَّكَ إِذاࣰ مِّنَ اَ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَدْعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يَنفَعُكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَضُرُّكَۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَإِن", "translit": "", "root": ""}, {"id": 12, "arabic": "فَعَلْتَ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَإِنَّكَ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 15, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 107, "text": "وَإِنْ يَّمْسَسْكَ اَ۬للَّهُ بِضُرࣲّ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَۖ وَإِنْ يُّرِدْكَ بِخَيْرࣲ فَلَا رَآدَّ لِفَضْلِهِۦۖ يُصِيبُ بِهِۦ مَنْ يَّشَآءُ مِنْ عِبَادِهِۦۖ وَهُوَ اَ۬لْغَفُورُ اُ۬لرَّحِيمُۖ", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّمْسَسْكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِضُرࣲّ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَاشِفَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "هُوَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يُّرِدْكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "بِخَيْرࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 14, "arabic": "رَآدَّ", "translit": "", "root": ""}, {"id": 15, "arabic": "لِفَضْلِهِۦۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "يُصِيبُ", "translit": "", "root": ""}, {"id": 17, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 18, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 19, "arabic": "يَّشَآءُ", "translit": "", "root": ""}, {"id": 20, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 21, "arabic": "عِبَادِهِۦۖ", "translit": "", "root": ""}, {"id": 22, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 23, "arabic": "اَ۬لْغَفُورُ", "translit": "", "root": ""}, {"id": 24, "arabic": "اُ۬لرَّحِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 108, "text": "قُلْ يَٰٓأَيُّهَا اَ۬لنَّاسُ قَدْ جَآءَكُمُ اُ۬لْحَقُّ مِن رَّبِّكُمْۖ فَمَنِ اِ۪هْتَد۪يٰ فَإِنَّمَا يَهْتَدِے لِنَفْسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَاۖ وَمَآ أَنَا عَلَيْكُم بِوَكِيلࣲۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 5, "arabic": "جَآءَكُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْحَقُّ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "رَّبِّكُمْۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَمَنِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۪هْتَد۪يٰ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَإِنَّمَا", "translit": "", "root": ""}, {"id": 12, "arabic": "يَهْتَدِے", "translit": "", "root": ""}, {"id": 13, "arabic": "لِنَفْسِهِۦۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 15, "arabic": "ضَلَّ", "translit": "", "root": ""}, {"id": 16, "arabic": "فَإِنَّمَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يَضِلُّ", "translit": "", "root": ""}, {"id": 18, "arabic": "عَلَيْهَاۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 20, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 21, "arabic": "عَلَيْكُم", "translit": "", "root": ""}, {"id": 22, "arabic": "بِوَكِيلࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 109, "text": "وَاتَّبِعْ مَا يُوح۪يٰٓ إِلَيْكَ وَاصْبِرْ حَتَّيٰ يَحْكُمَ اَ۬للَّهُۖ وَهُوَ خَيْرُ اُ۬لْحَٰكِمِينَۖ", "words": [{"id": 1, "arabic": "وَاتَّبِعْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاصْبِرْ", "translit": "", "root": ""}, {"id": 6, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَحْ