ot": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَبَوَّءَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لِقَوْمِكُمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "بِمِصْرَ", "translit": "", "root": ""}, {"id": 9, "arabic": "بُيُوتاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَاجْعَلُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "بُيُوتَكُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "قِبْلَةࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَأَقِيمُواْ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لصَّلَوٰةَۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَبَشِّرِ", "translit": "", "root": ""}, {"id": 16, "arabic": "اِ۬لْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 10, "ayah": 88, "text": "وَقَالَ مُوس۪يٰ رَبَّنَآ إِنَّكَ ءَاتَيْتَ فِرْعَوْنَ وَمَلَأَهُۥ زِينَةࣰ وَأَمْوَٰلاࣰ فِے اِ۬لْحَيَوٰةِ اِ۬لدُّنْي۪اۖ رَبَّنَا لِيَضِلُّواْ عَن سَبِيلِكَۖ رَبَّنَا اَ۪طْمِسْ عَلَيٰٓ أَمْوَٰلِهِمْ وَاشْدُدْ عَلَيٰ قُلُوبِهِمْ فَلَا يُومِنُواْ حَتَّيٰ يَرَوُاْ اُ۬لْعَذَابَ اَ۬لَالِيمَۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبَّنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَاتَيْتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَلَأَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "زِينَةࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَأَمْوَٰلاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِے", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬لْحَيَوٰةِ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬لدُّنْي۪اۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "رَبَّنَا", "translit": "", "root": ""}, {"id": 14, "arabic": "لِيَضِلُّواْ", "translit"