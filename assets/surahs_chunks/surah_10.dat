{"surah": 10, "verses": [{"ayah": 1, "text": "الٓرۚ تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْحَكِيمِ ", "translation": "Alif, Lām, Rā.[1] These are the verses of the wise[2] Book.", "words": [{"id": 1, "arabic": "الٓر", "translit": "rٓlā", "root": ""}, {"id": 2, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 3, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 4, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "ٱلْحَكِيمِ", "translit": "ِmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 2, "text": "أَكَانَ لِلنَّاسِ عَجَبًا أَنْ أَوْحَيْنَآ إِلَىٰ رَجُلٍ مِّنْهُمْ أَنْ أَنذِرِ ٱلنَّاسَ وَبَشِّرِ ٱلَّذِينَ ءَامَنُوٓا۟ أَنَّ لَهُمْ قَدَمَ صِدْقٍ عِندَ رَبِّهِمْۗ قَالَ ٱلْكَٰفِرُونَ إِنَّ هَٰذَا لَسَٰحِرٌ مُّبِينٌ ", "translation": "Have the people been amazed that We revealed [revelation] to a man from among them, [saying], \"Warn mankind and give good tidings to those who believe that they will have a [firm] precedence of honor[1] with their Lord\"? [But] the disbelievers say, \"Indeed, this is an obvious magician.\"", "words": [{"id": 1, "arabic": "أَكَانَ", "translit": "َnāَkَaʾ", "root": "كون"}, {"id": 2, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 3, "arabic": "عَجَبًا", "translit": "āًbَjgَʿع", "root": "عجب"}, {"id": 4, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 5, "arabic": "أَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾ", "root": "وحي"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "رَجُلٍ", "translit": "ٍlُjgَr", "root": "رجل"}, {"id": 8, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 9, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 10, "arabic": "أَنذِرِ", "translit": "ِrِhdnَaʾ", "root": "نذر"}, {"id": 11, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 12, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 15, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 16, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 17, "arabic": "قَدَمَ", "translit": "َmَdَq", "root": "قدم"}, {"id": 18, "arabic": "صِدْقٍ", "translit": "ٍqْdِṣ", "root": "صدق"}, {"id": 19, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 20, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 21, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 22, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}, {"id": 23, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 24, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 25, "arabic": "لَسَٰحِرٌ", "translit": "ٌrِḥَٰsَl", "root": "سحر"}, {"id": 26, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 3, "text": "إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِۖ يُدَبِّرُ ٱلْأَمْرَۖ مَا مِن شَفِيعٍ إِلَّا مِنۢ بَعْدِ إِذْنِهِۦۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ فَٱعْبُدُوهُۚ أَفَلَا تَذَكَّرُونَ ", "translation": "Indeed, your Lord is Allāh, who created the heavens and the earth in six days and then established Himself above the Throne,[1] arranging the matter [of His creation]. There is no intercessor except after His permission. That is Allāh, your Lord, so worship Him. Then will you not remember?", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "رَبَّكُمُ", "translit": "ُmُkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "سِتَّةِ", "translit": "ِẗَّtِs", "root": "ستت"}, {"id": 10, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "ٱسْتَوَىٰ", "translit": "ٰàَwَtْsٱ", "root": "سوي"}, {"id": 13, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 14, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 15, "arabic": "يُدَبِّرُ", "translit": "ُrِّbَdُy", "root": "دبر"}, {"id": 16, "arabic": "ٱلْأَمْرَ", "translit": "َrْmَaʾْlٱ", "root": "امر"}, {"id": 17, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "شَفِيعٍ", "translit": "ٍʿعyِfَhs", "root": "شفع"}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 22, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 23, "arabic": "إِذْنِهِۦ", "translit": "ۦِhِnْhdِiʾ", "root": "اذن"}, {"id": 24, "arabic": "ذَٰلِكُمُ", "translit": "ُmُkِlَٰhd", "root": ""}, {"id": 25, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 27, "arabic": "فَٱعْبُدُوهُ", "translit": "ُhwُdُbْʿعٱَf", "root": "عبد"}, {"id": 28, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 29, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": true}, {"ayah": 4, "text": "إِلَيْهِ مَرْجِعُكُمْ جَمِيعًاۖ وَعْدَ ٱللَّهِ حَقًّاۚ إِنَّهُۥ يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥ لِيَجْزِىَ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ بِٱلْقِسْطِۚ وَٱلَّذِينَ كَفَرُوا۟ لَهُمْ شَرَابٌ مِّنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌۢ بِمَا كَانُوا۟ يَكْفُرُونَ ", "translation": "To Him is your return all together. [It is] the promise of Allāh [which is] truth. Indeed, He begins the [process of] creation and then repeats it that He may reward those who have believed and done righteous deeds, in justice. But those who disbelieved will have a drink of scalding water and a painful punishment for what they used to deny.", "words": [{"id": 1, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 2, "arabic": "مَرْجِعُكُمْ", "translit": "ْmُkُʿعِjgْrَm", "root": "رجع"}, {"id": 3, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 4, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 7, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "يَبْدَؤُا۟", "translit": "۟āُwʾَdْbَy", "root": "بدا"}, {"id": 9, "arabic": "ٱلْخَلْقَ", "translit": "َqْlَhkْlٱ", "root": "خلق"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "يُعِيدُهُۥ", "translit": "ۥُhُdyِʿعُy", "root": "عود"}, {"id": 12, "arabic": "لِيَجْزِىَ", "translit": "َàِzْjgَyِl", "root": "جزي"}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 15, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 16, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 17, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 18, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 19, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 20, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 21, "arabic": "شَرَابٌ", "translit": "ٌbāَrَhs", "root": "شرب"}, {"id": 22, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 23, "arabic": "حَمِيمٍ", "translit": "ٍmyِmَḥ", "root": "حمم"}, {"id": 24, "arabic": "وَعَذَابٌ", "translit": "ٌbāَhdَʿعَw", "root": "عذب"}, {"id": 25, "arabic": "أَلِيمٌۢ", "translit": "ٌۢmyِlَaʾ", "root": "الم"}, {"id": 26, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 27, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 28, "arabic": "يَكْفُرُونَ", "translit": "َnwُrُfْkَy", "root": "كفر"}], "hasIhya": false}, {"ayah": 5, "text": "هُوَ ٱلَّذِى جَعَلَ ٱلشَّمْسَ ضِيَآءً وَٱلْقَمَرَ نُورًا وَقَدَّرَهُۥ مَنَازِلَ لِتَعْلَمُوا۟ عَدَدَ ٱلسِّنِينَ وَٱلْحِسَابَۚ مَا خَلَقَ ٱللَّهُ ذَٰلِكَ إِلَّا بِٱلْحَقِّۚ يُفَصِّلُ ٱلْءَايَٰتِ لِقَوْمٍ يَعْلَمُونَ ", "translation": "It is He who made the sun a shining light and the moon a derived light and determined for it phases - that you may know the number of years and account [of time]. Allāh has not created this except in truth. He details the signs for a people who know.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "ٱلشَّمْسَ", "translit": "َsْmَّhslٱ", "root": "شمس"}, {"id": 5, "arabic": "ضِيَآءً", "translit": "ًءٓāَyِḍ", "root": "ضوا"}, {"id": 6, "arabic": "وَٱلْقَمَرَ", "translit": "َrَmَqْlٱَw", "root": "قمر"}, {"id": 7, "arabic": "نُورًا", "translit": "āًrwُn", "root": "نور"}, {"id": 8, "arabic": "وَقَدَّرَهُۥ", "translit": "ۥُhَrَّdَqَw", "root": "قدر"}, {"id": 9, "arabic": "مَنَازِلَ", "translit": "َlِzāَnَm", "root": "نزل"}, {"id": 10, "arabic": "لِتَعْلَمُوا۟", "translit": "۟āwُmَlْʿعَtِl", "root": "علم"}, {"id": 11, "arabic": "عَدَدَ", "translit": "َdَdَʿع", "root": "عدد"}, {"id": 12, "arabic": "ٱلسِّنِينَ", "translit": "َnyِnِّslٱ", "root": "سنو"}, {"id": 13, "arabic": "وَٱلْحِسَابَ", "translit": "َbāَsِḥْlٱَw", "root": "حسب"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 18, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 19, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 20, "arabic": "يُفَصِّلُ", "translit": "ُlِّṣَfُy", "root": "فصل"}, {"id": 21, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 22, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 23, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 6, "text": "إِنَّ فِى ٱخْتِلَٰفِ ٱلَّيْلِ وَٱلنَّهَارِ وَمَا خَلَقَ ٱللَّهُ فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ لَءَايَٰتٍ لِّقَوْمٍ يَتَّقُونَ ", "translation": "Indeed, in the alternation of the night and the day and [in] what Allāh has created in the heavens and the earth are signs for a people who fear Allāh.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱخْتِلَٰفِ", "translit": "ِfَٰlِtْhkٱ", "root": "خلف"}, {"id": 4, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 5, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 11, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 12, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 13, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 14, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}], "hasIhya": true}, {"ayah": 7, "text": "إِنَّ ٱلَّذِينَ لَا يَرْجُونَ لِقَآءَنَا وَرَضُوا۟ بِٱلْحَيَوٰةِ ٱلدُّنْيَا وَٱطْمَأَنُّوا۟ بِهَا وَٱلَّذِينَ هُمْ عَنْ ءَايَٰتِنَا غَٰفِلُونَ ", "translation": "Indeed, those who do not expect the meeting with Us and are satisfied with the life of this world and feel secure therein and those who are heedless of Our signs -", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 5, "arabic": "لِقَآءَنَا", "translit": "āَnَءٓāَqِl", "root": "لقي"}, {"id": 6, "arabic": "وَرَضُوا۟", "translit": "۟āwُḍَrَw", "root": "رضو"}, {"id": 7, "arabic": "بِٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱِb", "root": "حيي"}, {"id": 8, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 9, "arabic": "وَٱطْمَأَنُّوا۟", "translit": "۟āwُّnَaʾَmْṭٱَw", "root": "طمان"}, {"id": 10, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 11, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 12, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 13, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 14, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 15, "arabic": "غَٰفِلُونَ", "translit": "َnwُlِfَٰغ", "root": "غفل"}], "hasIhya": true}, {"ayah": 8, "text": "أُو۟لَٰٓئِكَ مَأْوَىٰهُمُ ٱلنَّارُ بِمَا كَانُوا۟ يَكْسِبُونَ ", "translation": "For those their refuge will be the Fire because of what they used to earn.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "مَأْوَىٰهُمُ", "translit": "ُmُhٰàَwْaʾَm", "root": "اوي"}, {"id": 3, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 6, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": false}, {"ayah": 9, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ يَهْدِيهِمْ رَبُّهُم بِإِيمَٰنِهِمْۖ تَجْرِى مِن تَحْتِهِمُ ٱلْأَنْهَٰرُ فِى جَنَّٰتِ ٱلنَّعِيمِ ", "translation": "Indeed, those who have believed and done righteous deeds - their Lord will guide them because of their faith. Beneath them rivers will flow in the Gardens of Pleasure.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "يَهْدِيهِمْ", "translit": "ْmِhyِdْhَy", "root": "هدي"}, {"id": 7, "arabic": "رَبُّهُم", "translit": "mُhُّbَr", "root": "ربب"}, {"id": 8, "arabic": "بِإِيمَٰنِهِمْ", "translit": "ْmِhِnَٰmyِiʾِb", "root": "امن"}, {"id": 9, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "تَحْتِهِمُ", "translit": "ُmِhِtْḥَt", "root": "تحت"}, {"id": 12, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "جَنَّٰتِ", "translit": "ِtَّٰnَjg", "root": "جنن"}, {"id": 15, "arabic": "ٱلنَّعِيمِ", "translit": "ِmyِʿعَّnlٱ", "root": "نعم"}], "hasIhya": false}, {"ayah": 10, "text": "دَعْوَىٰهُمْ فِيهَا سُبْحَٰنَكَ ٱللَّهُمَّ وَتَحِيَّتُهُمْ فِيهَا سَلَٰمٌۚ وَءَاخِرُ دَعْوَىٰهُمْ أَنِ ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "Their call therein will be, \"Exalted are You, O Allāh,\" and their greeting therein will be, \"Peace.\" And the last of their call will be, \"Praise to Allāh, Lord of the worlds!\"", "words": [{"id": 1, "arabic": "دَعْوَىٰهُمْ", "translit": "ْmُhٰàَwْʿعَd", "root": "دعو"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "سُبْحَٰنَكَ", "translit": "َkَnَٰḥْbُs", "root": "سبح"}, {"id": 4, "arabic": "ٱللَّهُمَّ", "translit": "َّmُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَتَحِيَّتُهُمْ", "translit": "ْmُhُtَّyِḥَtَw", "root": "حيي"}, {"id": 6, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 7, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 8, "arabic": "وَءَاخِرُ", "translit": "ُrِhkāَءَw", "root": "اخر"}, {"id": 9, "arabic": "دَعْوَىٰهُمْ", "translit": "ْmُhٰàَwْʿعَd", "root": "دعو"}, {"id": 10, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 11, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 12, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 13, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 14, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 11, "text": "وَلَوْ يُعَجِّلُ ٱللَّهُ لِلنَّاسِ ٱلشَّرَّ ٱسْتِعْجَالَهُم بِٱلْخَيْرِ لَقُضِىَ إِلَيْهِمْ أَجَلُهُمْۖ فَنَذَرُ ٱلَّذِينَ لَا يَرْجُونَ لِقَآءَنَا فِى طُغْيَٰنِهِمْ يَعْمَهُونَ ", "translation": "And if Allāh was to hasten for the people the evil [they invoke][1] as He hastens for them the good, their term would have been ended for them.[2] But We leave the ones who do not expect the meeting with Us, in their transgression, wandering blindly.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "يُعَجِّلُ", "translit": "ُlِّjgَʿعُy", "root": "عجل"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 5, "arabic": "ٱلشَّرَّ", "translit": "َّrَّhslٱ", "root": "شرر"}, {"id": 6, "arabic": "ٱسْتِعْجَالَهُم", "translit": "mُhَlāَjgْʿعِtْsٱ", "root": "عجل"}, {"id": 7, "arabic": "بِٱلْخَيْرِ", "translit": "ِrْyَhkْlٱِb", "root": "خير"}, {"id": 8, "arabic": "لَقُضِىَ", "translit": "َàِḍُqَl", "root": "قضي"}, {"id": 9, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "أَجَلُهُمْ", "translit": "ْmُhُlَjgَaʾ", "root": "اجل"}, {"id": 11, "arabic": "فَنَذَرُ", "translit": "ُrَhdَnَf", "root": "وذر"}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 15, "arabic": "لِقَآءَنَا", "translit": "āَnَءٓāَqِl", "root": "لقي"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "طُغْيَٰنِهِمْ", "translit": "ْmِhِnَٰyْغُṭ", "root": "طغي"}, {"id": 18, "arabic": "يَعْمَهُونَ", "translit": "َnwُhَmْʿعَy", "root": "عمه"}], "hasIhya": false}, {"ayah": 12, "text": "وَإِذَا مَسَّ ٱلْإِنسَٰنَ ٱلضُّرُّ دَعَانَا لِجَنۢبِهِۦٓ أَوْ قَاعِدًا أَوْ قَآئِمًا فَلَمَّا كَشَفْنَا عَنْهُ ضُرَّهُۥ مَرَّ كَأَن لَّمْ يَدْعُنَآ إِلَىٰ ضُرٍّ مَّسَّهُۥۚ كَذَٰلِكَ زُيِّنَ لِلْمُسْرِفِينَ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "And when affliction touches man, he calls upon Us, whether lying on his side or sitting or standing; but when We remove from him his affliction, he continues [in disobedience] as if he had never called upon Us to [remove] an affliction that touched him. Thus is made pleasing to the transgressors that which they have been doing.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "مَسَّ", "translit": "َّsَm", "root": "مسس"}, {"id": 3, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "ٱلضُّرُّ", "translit": "ُّrُّḍlٱ", "root": "ضرر"}, {"id": 5, "arabic": "دَعَانَا", "translit": "āَnāَʿعَd", "root": "دعو"}, {"id": 6, "arabic": "لِجَنۢبِهِۦٓ", "translit": "ٓۦِhِbۢnَjgِl", "root": "جنب"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "قَاعِدًا", "translit": "āًdِʿعāَq", "root": "قعد"}, {"id": 9, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 10, "arabic": "قَآئِمًا", "translit": "āًmِyʾٓāَq", "root": "قوم"}, {"id": 11, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 12, "arabic": "كَشَفْنَا", "translit": "āَnْfَhsَk", "root": "كشف"}, {"id": 13, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 14, "arabic": "ضُرَّهُۥ", "translit": "ۥُhَّrُḍ", "root": "ضرر"}, {"id": 15, "arabic": "مَرَّ", "translit": "َّrَm", "root": "مرر"}, {"id": 16, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 17, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 18, "arabic": "يَدْعُنَآ", "translit": "ٓāَnُʿعْdَy", "root": "دعو"}, {"id": 19, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 20, "arabic": "ضُرٍّ", "translit": "ٍّrُḍ", "root": "ضرر"}, {"id": 21, "arabic": "مَّسَّهُۥ", "translit": "ۥُhَّsَّm", "root": "مسس"}, {"id": 22, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 23, "arabic": "زُيِّنَ", "translit": "َnِّyُz", "root": "زين"}, {"id": 24, "arabic": "لِلْمُسْرِفِينَ", "translit": "َnyِfِrْsُmْlِl", "root": "سرف"}, {"id": 25, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 26, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 27, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 13, "text": "وَلَقَدْ أَهْلَكْنَا ٱلْقُرُونَ مِن قَبْلِكُمْ لَمَّا ظَلَمُوا۟ۙ وَجَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ وَمَا كَانُوا۟ لِيُؤْمِنُوا۟ۚ كَذَٰلِكَ نَجْزِى ٱلْقَوْمَ ٱلْمُجْرِمِينَ ", "translation": "And We had already destroyed generations before you when they wronged, and their messengers had come to them with clear proofs, but they were not to believe. Thus do We recompense the criminal people.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَهْلَكْنَا", "translit": "āَnْkَlْhَaʾ", "root": "هلك"}, {"id": 3, "arabic": "ٱلْقُرُونَ", "translit": "َnwُrُqْlٱ", "root": "قرن"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 7, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 8, "arabic": "وَجَآءَتْهُمْ", "translit": "ْmُhْtَءٓāَjgَw", "root": "جيا"}, {"id": 9, "arabic": "رُسُلُهُم", "translit": "mُhُlُsُr", "root": "رسل"}, {"id": 10, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "لِيُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُyِl", "root": "امن"}, {"id": 14, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 15, "arabic": "نَجْزِى", "translit": "àِzْjgَn", "root": "جزي"}, {"id": 16, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 17, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 14, "text": "ثُمَّ جَعَلْنَٰكُمْ خَلَٰٓئِفَ فِى ٱلْأَرْضِ مِنۢ بَعْدِهِمْ لِنَنظُرَ كَيْفَ تَعْمَلُونَ ", "translation": "Then We made you successors in the land after them so that We may observe how you will do.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰكُمْ", "translit": "ْmُkَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "خَلَٰٓئِفَ", "translit": "َfِyʾَٰٓlَhk", "root": "خلف"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "لِنَنظُرَ", "translit": "َrُẓnَnِl", "root": "نظر"}, {"id": 9, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 10, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 15, "text": "وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَاتُنَا بَيِّنَٰتٍۙ قَالَ ٱلَّذِينَ لَا يَرْجُونَ لِقَآءَنَا ٱئْتِ بِقُرْءَانٍ غَيْرِ هَٰذَآ أَوْ بَدِّلْهُۚ قُلْ مَا يَكُونُ لِىٓ أَنْ أُبَدِّلَهُۥ مِن تِلْقَآئِ نَفْسِىٓۖ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَىٰٓ إِلَىَّۖ إِنِّىٓ أَخَافُ إِنْ عَصَيْتُ رَبِّى عَذَابَ يَوْمٍ عَظِيمٍ ", "translation": "And when Our verses are recited to them as clear evidences, those who do not expect the meeting with Us say, \"Bring us a Qur’ān other than this or change it.\" Say, [O Muḥammad], \"It is not for me to change it on my own accord. I only follow what is revealed to me. Indeed I fear, if I should disobey my Lord, the punishment of a tremendous Day.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "تُتْلَىٰ", "translit": "ٰàَlْtُt", "root": "تلو"}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ءَايَاتُنَا", "translit": "āَnُtāَyāَء", "root": "ايي"}, {"id": 5, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 10, "arabic": "لِقَآءَنَا", "translit": "āَnَءٓāَqِl", "root": "لقي"}, {"id": 11, "arabic": "ٱئْتِ", "translit": "ِtْyʾٱ", "root": "اتي"}, {"id": 12, "arabic": "بِقُرْءَانٍ", "translit": "ٍnāَءْrُqِb", "root": "قرا"}, {"id": 13, "arabic": "غَيْرِ", "translit": "ِrْyَغ", "root": "غير"}, {"id": 14, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 15, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 16, "arabic": "بَدِّلْهُ", "translit": "ُhْlِّdَb", "root": "بدل"}, {"id": 17, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 20, "arabic": "لِىٓ", "translit": "ٓàِl", "root": ""}, {"id": 21, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 22, "arabic": "أُبَدِّلَهُۥ", "translit": "ۥُhَlِّdَbُaʾ", "root": "بدل"}, {"id": 23, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 24, "arabic": "تِلْقَآئِ", "translit": "ِyʾٓāَqْlِt", "root": "لقي"}, {"id": 25, "arabic": "نَفْسِىٓ", "translit": "ٓàِsْfَn", "root": "نفس"}, {"id": 26, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 27, "arabic": "أَتَّبِعُ", "translit": "ُʿعِbَّtَaʾ", "root": "تبع"}, {"id": 28, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 29, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 30, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 31, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 32, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 33, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 34, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 35, "arabic": "عَصَيْتُ", "translit": "ُtْyَṣَʿع", "root": "عصي"}, {"id": 36, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 37, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 38, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 39, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 16, "text": "قُل لَّوْ شَآءَ ٱللَّهُ مَا تَلَوْتُهُۥ عَلَيْكُمْ وَلَآ أَدْرَىٰكُم بِهِۦۖ فَقَدْ لَبِثْتُ فِيكُمْ عُمُرًا مِّن قَبْلِهِۦٓۚ أَفَلَا تَعْقِلُونَ ", "translation": "Say, \"If Allāh had willed, I would not have recited it to you, nor would He have made it known to you, for I had remained among you a lifetime before it.[1] Then will you not reason?\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 3, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "تَلَوْتُهُۥ", "translit": "ۥُhُtْwَlَt", "root": "تلو"}, {"id": 7, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 9, "arabic": "أَدْرَىٰكُم", "translit": "mُkٰàَrْdَaʾ", "root": "دري"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 12, "arabic": "لَبِثْتُ", "translit": "ُtْhtِbَl", "root": "لبث"}, {"id": 13, "arabic": "فِيكُمْ", "translit": "ْmُkyِf", "root": ""}, {"id": 14, "arabic": "عُمُرًا", "translit": "āًrُmُʿع", "root": "عمر"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "قَبْلِهِۦٓ", "translit": "ٓۦِhِlْbَq", "root": "قبل"}, {"id": 17, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 18, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": false}, {"ayah": 17, "text": "فَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوْ كَذَّبَ بِـَٔايَٰتِهِۦٓۚ إِنَّهُۥ لَا يُفْلِحُ ٱلْمُجْرِمُونَ ", "translation": "So who is more unjust than he who invents a lie about Allāh or denies His signs? Indeed, the criminals will not succeed.", "words": [{"id": 1, "arabic": "فَمَنْ", "translit": "ْnَmَf", "root": ""}, {"id": 2, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 3, "arabic": "مِمَّنِ", "translit": "ِnَّmِm", "root": ""}, {"id": 4, "arabic": "ٱفْتَرَىٰ", "translit": "ٰàَrَtْfٱ", "root": "فري"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 10, "arabic": "بِـَٔايَٰتِهِۦٓ", "translit": "ٓۦِhِtَٰyāَٔـِb", "root": "ايي"}, {"id": 11, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُفْلِحُ", "translit": "ُḥِlْfُy", "root": "فلح"}, {"id": 14, "arabic": "ٱلْمُجْرِمُونَ", "translit": "َnwُmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": true}, {"ayah": 18, "text": "وَيَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَضُرُّهُمْ وَلَا يَنفَعُهُمْ وَيَقُولُونَ هَٰٓؤُلَآءِ شُفَعَٰٓؤُنَا عِندَ ٱللَّهِۚ قُلْ أَتُنَبِّـُٔونَ ٱللَّهَ بِمَا لَا يَعْلَمُ فِى ٱلسَّمَٰوَٰتِ وَلَا فِى ٱلْأَرْضِۚ سُبْحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشْرِكُونَ ", "translation": "And they worship other than Allāh that which neither harms them nor benefits them, and they say, \"These are our intercessors with Allāh.\" Say, \"Do you inform Allāh of something He does not know in the heavens or on the earth?\" Exalted is He and high above what they associate with Him.", "words": [{"id": 1, "arabic": "وَيَعْبُدُونَ", "translit": "َnwُdُbْʿعَyَw", "root": "عبد"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَضُرُّهُمْ", "translit": "ْmُhُّrُḍَy", "root": "ضرر"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "يَنفَعُهُمْ", "translit": "ْmُhُʿعَfnَy", "root": "نفع"}, {"id": 10, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 11, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 12, "arabic": "شُفَعَٰٓؤُنَا", "translit": "āَnُwʾَٰٓʿعَfُhs", "root": "شفع"}, {"id": 13, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 16, "arabic": "أَتُنَبِّـُٔونَ", "translit": "َnwُٔـِّbَnُtَaʾ", "root": "نبا"}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 21, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 22, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 23, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 24, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 25, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 26, "arabic": "سُبْحَٰنَهُۥ", "translit": "ۥُhَnَٰḥْbُs", "root": "سبح"}, {"id": 27, "arabic": "وَتَعَٰلَىٰ", "translit": "ٰàَlَٰʿعَtَw", "root": "علو"}, {"id": 28, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 29, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 19, "text": "وَمَا كَانَ ٱلنَّاسُ إِلَّآ أُمَّةً وَٰحِدَةً فَٱخْتَلَفُوا۟ۚ وَلَوْلَا كَلِمَةٌ سَبَقَتْ مِن رَّبِّكَ لَقُضِىَ بَيْنَهُمْ فِيمَا فِيهِ يَخْتَلِفُونَ ", "translation": "And mankind was not but one community [united in religion], but [then] they differed. And if not for a word[1] that preceded from your Lord, it would have been judged between them [immediately] concerning that over which they differ.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 5, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 7, "arabic": "فَٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱَf", "root": "خلف"}, {"id": 8, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 9, "arabic": "كَلِمَةٌ", "translit": "ٌẗَmِlَk", "root": "كلم"}, {"id": 10, "arabic": "سَبَقَتْ", "translit": "ْtَqَbَs", "root": "سبق"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 13, "arabic": "لَقُضِىَ", "translit": "َàِḍُqَl", "root": "قضي"}, {"id": 14, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 15, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 16, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 17, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": false}, {"ayah": 20, "text": "وَيَقُولُونَ لَوْلَآ أُنزِلَ عَلَيْهِ ءَايَةٌ مِّن رَّبِّهِۦۖ فَقُلْ إِنَّمَا ٱلْغَيْبُ لِلَّهِ فَٱنتَظِرُوٓا۟ إِنِّى مَعَكُم مِّنَ ٱلْمُنتَظِرِينَ ", "translation": "And they say, \"Why is a sign not sent down to him from his Lord?\" So say, \"The unseen is only for Allāh [to administer], so wait; indeed, I am with you among those who wait.\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 3, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "ءَايَةٌ", "translit": "ٌẗَyāَء", "root": "ايي"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "رَّبِّهِۦ", "translit": "ۦِhِّbَّr", "root": "ربب"}, {"id": 8, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 9, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱلْغَيْبُ", "translit": "ُbْyَغْlٱ", "root": "غيب"}, {"id": 11, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 12, "arabic": "فَٱنتَظِرُوٓا۟", "translit": "۟āٓwُrِẓَtnٱَf", "root": "نظر"}, {"id": 13, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 14, "arabic": "مَعَكُم", "translit": "mُkَʿعَm", "root": ""}, {"id": 15, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 16, "arabic": "ٱلْمُنتَظِرِينَ", "translit": "َnyِrِẓَtnُmْlٱ", "root": "نظر"}], "hasIhya": false}, {"ayah": 21, "text": "وَإِذَآ أَذَقْنَا ٱلنَّاسَ رَحْمَةً مِّنۢ بَعْدِ ضَرَّآءَ مَسَّتْهُمْ إِذَا لَهُم مَّكْرٌ فِىٓ ءَايَاتِنَاۚ قُلِ ٱللَّهُ أَسْرَعُ مَكْرًاۚ إِنَّ رُسُلَنَا يَكْتُبُونَ مَا تَمْكُرُونَ ", "translation": "And when We give the people a taste of mercy after adversity has touched them, at once they conspire against Our verses. Say, \"Allāh is swifter in strategy.\" Indeed, Our messengers [i.e., angels] record that which you conspire.", "words": [{"id": 1, "arabic": "وَإِذَآ", "translit": "ٓāَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَذَقْنَا", "translit": "āَnْqَhdَaʾ", "root": "ذوق"}, {"id": 3, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 5, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "ضَرَّآءَ", "translit": "َءٓāَّrَḍ", "root": "ضرر"}, {"id": 8, "arabic": "مَسَّتْهُمْ", "translit": "ْmُhْtَّsَm", "root": "مسس"}, {"id": 9, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 10, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 11, "arabic": "مَّكْرٌ", "translit": "ٌrْkَّm", "root": "مكر"}, {"id": 12, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 13, "arabic": "ءَايَاتِنَا", "translit": "āَnِtāَyāَء", "root": "ايي"}, {"id": 14, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "أَسْرَعُ", "translit": "ُʿعَrْsَaʾ", "root": "سرع"}, {"id": 17, "arabic": "مَكْرًا", "translit": "āًrْkَm", "root": "مكر"}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "رُسُلَنَا", "translit": "āَnَlُsُr", "root": "رسل"}, {"id": 20, "arabic": "يَكْتُبُونَ", "translit": "َnwُbُtْkَy", "root": "كتب"}, {"id": 21, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 22, "arabic": "تَمْكُرُونَ", "translit": "َnwُrُkْmَt", "root": "مكر"}], "hasIhya": false}, {"ayah": 22, "text": "هُوَ ٱلَّذِى يُسَيِّرُكُمْ فِى ٱلْبَرِّ وَٱلْبَحْرِۖ حَتَّىٰٓ إِذَا كُنتُمْ فِى ٱلْفُلْكِ وَجَرَيْنَ بِهِم بِرِيحٍ طَيِّبَةٍ وَفَرِحُوا۟ بِهَا جَآءَتْهَا رِيحٌ عَاصِفٌ وَجَآءَهُمُ ٱلْمَوْجُ مِن كُلِّ مَكَانٍ وَظَنُّوٓا۟ أَنَّهُمْ أُحِيطَ بِهِمْۙ دَعَوُا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ لَئِنْ أَنجَيْتَنَا مِنْ هَٰذِهِۦ لَنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ ", "translation": "It is He who enables you to travel on land and sea until, when you are in ships and they sail with them[1] by a good wind and they rejoice therein, there comes a storm wind and the waves come upon them from every place and they expect to be engulfed, they supplicate Allāh, sincere to Him in religion, \"If You should save us from this, we will surely be among the thankful.\"", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُسَيِّرُكُمْ", "translit": "ْmُkُrِّyَsُy", "root": "سير"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْبَرِّ", "translit": "ِّrَbْlٱ", "root": "برر"}, {"id": 6, "arabic": "وَٱلْبَحْرِ", "translit": "ِrْḥَbْlٱَw", "root": "بحر"}, {"id": 7, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 8, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 9, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْفُلْكِ", "translit": "ِkْlُfْlٱ", "root": "فلك"}, {"id": 12, "arabic": "وَجَرَيْنَ", "translit": "َnْyَrَjgَw", "root": "جري"}, {"id": 13, "arabic": "بِهِم", "translit": "mِhِb", "root": ""}, {"id": 14, "arabic": "بِرِيحٍ", "translit": "ٍḥyِrِb", "root": "روح"}, {"id": 15, "arabic": "طَيِّبَةٍ", "translit": "ٍẗَbِّyَṭ", "root": "طيب"}, {"id": 16, "arabic": "وَفَرِحُوا۟", "translit": "۟āwُḥِrَfَw", "root": "فرح"}, {"id": 17, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 18, "arabic": "جَآءَتْهَا", "translit": "āَhْtَءٓāَjg", "root": "جيا"}, {"id": 19, "arabic": "رِيحٌ", "translit": "ٌḥyِr", "root": "روح"}, {"id": 20, "arabic": "عَاصِفٌ", "translit": "ٌfِṣāَʿع", "root": "عصف"}, {"id": 21, "arabic": "وَجَآءَهُمُ", "translit": "ُmُhَءٓāَjgَw", "root": "جيا"}, {"id": 22, "arabic": "ٱلْمَوْجُ", "translit": "ُjgْwَmْlٱ", "root": "موج"}, {"id": 23, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 24, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 25, "arabic": "مَكَانٍ", "translit": "ٍnāَkَm", "root": "كون"}, {"id": 26, "arabic": "وَظَنُّوٓا۟", "translit": "۟āٓwُّnَẓَw", "root": "ظنن"}, {"id": 27, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 28, "arabic": "أُحِيطَ", "translit": "َṭyِḥُaʾ", "root": "حوط"}, {"id": 29, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 30, "arabic": "دَعَوُا۟", "translit": "۟āُwَʿعَd", "root": "دعو"}, {"id": 31, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "مُخْلِصِينَ", "translit": "َnyِṣِlْhkُm", "root": "خلص"}, {"id": 33, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 34, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 35, "arabic": "لَئِنْ", "translit": "ْnِyʾَl", "root": ""}, {"id": 36, "arabic": "أَنجَيْتَنَا", "translit": "āَnَtْyَjgnَaʾ", "root": "نجو"}, {"id": 37, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 38, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 39, "arabic": "لَنَكُونَنَّ", "translit": "َّnَnwُkَnَl", "root": "كون"}, {"id": 40, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 41, "arabic": "ٱلشَّٰكِرِينَ", "translit": "َnyِrِkَّٰhslٱ", "root": "شكر"}], "hasIhya": false}, {"ayah": 23, "text": "فَلَمَّآ أَنجَىٰهُمْ إِذَا هُمْ يَبْغُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّۗ يَٰٓأَيُّهَا ٱلنَّاسُ إِنَّمَا بَغْيُكُمْ عَلَىٰٓ أَنفُسِكُمۖ مَّتَٰعَ ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ ثُمَّ إِلَيْنَا مَرْجِعُكُمْ فَنُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "But when He saves them, at once they commit injustice[1] upon the earth without right. O mankind, your injustice is only against yourselves, [being merely] the enjoyment of worldly life. Then to Us is your return, and We will inform you of what you used to do.", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 2, "arabic": "أَنجَىٰهُمْ", "translit": "ْmُhٰàَjgnَaʾ", "root": "نجو"}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 5, "arabic": "يَبْغُونَ", "translit": "َnwُغْbَy", "root": "بغي"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 9, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 10, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 11, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 12, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 13, "arabic": "بَغْيُكُمْ", "translit": "ْmُkُyْغَb", "root": "بغي"}, {"id": 14, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 15, "arabic": "أَنفُسِكُم", "translit": "mُkِsُfnَaʾ", "root": "نفس"}, {"id": 16, "arabic": "مَّتَٰعَ", "translit": "َʿعَٰtَّm", "root": "متع"}, {"id": 17, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 18, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 19, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 20, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 21, "arabic": "مَرْجِعُكُمْ", "translit": "ْmُkُʿعِjgْrَm", "root": "رجع"}, {"id": 22, "arabic": "فَنُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُnَf", "root": "نبا"}, {"id": 23, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 24, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 25, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 24, "text": "إِنَّمَا مَثَلُ ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَآءٍ أَنزَلْنَٰهُ مِنَ ٱلسَّمَآءِ فَٱخْتَلَطَ بِهِۦ نَبَاتُ ٱلْأَرْضِ مِمَّا يَأْكُلُ ٱلنَّاسُ وَٱلْأَنْعَٰمُ حَتَّىٰٓ إِذَآ أَخَذَتِ ٱلْأَرْضُ زُخْرُفَهَا وَٱزَّيَّنَتْ وَظَنَّ أَهْلُهَآ أَنَّهُمْ قَٰدِرُونَ عَلَيْهَآ أَتَىٰهَآ أَمْرُنَا لَيْلًا أَوْ نَهَارًا فَجَعَلْنَٰهَا حَصِيدًا كَأَن لَّمْ تَغْنَ بِٱلْأَمْسِۚ كَذَٰلِكَ نُفَصِّلُ ٱلْءَايَٰتِ لِقَوْمٍ يَتَفَكَّرُونَ ", "translation": "The example of [this] worldly life is but like rain which We have sent down from the sky that the plants of the earth absorb - [those] from which men and livestock eat - until, when the earth has taken on its adornment and is beautified and its people suppose that they have capability over it, there comes to it Our command by night or by day, and We make it as a harvest,[1] as if it had not flourished yesterday. Thus do We explain in detail the signs for a people who give thought.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "مَثَلُ", "translit": "ُlَhtَm", "root": "مثل"}, {"id": 3, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 4, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 5, "arabic": "كَمَآءٍ", "translit": "ٍءٓāَmَk", "root": "موه"}, {"id": 6, "arabic": "أَنزَلْنَٰهُ", "translit": "ُhَٰnْlَznَaʾ", "root": "نزل"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "فَٱخْتَلَطَ", "translit": "َṭَlَtْhkٱَf", "root": "خلط"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "نَبَاتُ", "translit": "ُtāَbَn", "root": "نبت"}, {"id": 12, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 13, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 14, "arabic": "يَأْكُلُ", "translit": "ُlُkْaʾَy", "root": "اكل"}, {"id": 15, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 16, "arabic": "وَٱلْأَنْعَٰمُ", "translit": "ُmَٰʿعْnَaʾْlٱَw", "root": "نعم"}, {"id": 17, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 18, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 19, "arabic": "أَخَذَتِ", "translit": "ِtَhdَhkَaʾ", "root": "اخذ"}, {"id": 20, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 21, "arabic": "زُخْرُفَهَا", "translit": "āَhَfُrْhkُz", "root": "زخرف"}, {"id": 22, "arabic": "وَٱزَّيَّنَتْ", "translit": "ْtَnَّyَّzٱَw", "root": "زين"}, {"id": 23, "arabic": "وَظَنَّ", "translit": "َّnَẓَw", "root": "ظنن"}, {"id": 24, "arabic": "أَهْلُهَآ", "translit": "ٓāَhُlْhَaʾ", "root": "اهل"}, {"id": 25, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 26, "arabic": "قَٰدِرُونَ", "translit": "َnwُrِdَٰq", "root": "قدر"}, {"id": 27, "arabic": "عَلَيْهَآ", "translit": "ٓāَhْyَlَʿع", "root": ""}, {"id": 28, "arabic": "أَتَىٰهَآ", "translit": "ٓāَhٰàَtَaʾ", "root": "اتي"}, {"id": 29, "arabic": "أَمْرُنَا", "translit": "āَnُrْmَaʾ", "root": "امر"}, {"id": 30, "arabic": "لَيْلًا", "translit": "āًlْyَl", "root": "ليل"}, {"id": 31, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 32, "arabic": "نَهَارًا", "translit": "āًrāَhَn", "root": "نهر"}, {"id": 33, "arabic": "فَجَعَلْنَٰهَا", "translit": "āَhَٰnْlَʿعَjgَf", "root": "جعل"}, {"id": 34, "arabic": "حَصِيدًا", "translit": "āًdyِṣَḥ", "root": "حصد"}, {"id": 35, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 36, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 37, "arabic": "تَغْنَ", "translit": "َnْغَt", "root": "غني"}, {"id": 38, "arabic": "بِٱلْأَمْسِ", "translit": "ِsْmَaʾْlٱِb", "root": ""}, {"id": 39, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 40, "arabic": "نُفَصِّلُ", "translit": "ُlِّṣَfُn", "root": "فصل"}, {"id": 41, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 42, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 43, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": true}, {"ayah": 25, "text": "وَٱللَّهُ يَدْعُوٓا۟ إِلَىٰ دَارِ ٱلسَّلَٰمِ وَيَهْدِى مَن يَشَآءُ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "And Allāh invites to the Home of Peace [i.e., Paradise] and guides whom He wills to a straight path.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "يَدْعُوٓا۟", "translit": "۟āٓwُʿعْdَy", "root": "دعو"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "دَارِ", "translit": "ِrāَd", "root": "دور"}, {"id": 5, "arabic": "ٱلسَّلَٰمِ", "translit": "ِmَٰlَّslٱ", "root": "سلم"}, {"id": 6, "arabic": "وَيَهْدِى", "translit": "àِdْhَyَw", "root": "هدي"}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 11, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 26, "text": "لِّلَّذِينَ أَحْسَنُوا۟ ٱلْحُسْنَىٰ وَزِيَادَةٌۖ وَلَا يَرْهَقُ وُجُوهَهُمْ قَتَرٌ وَلَا ذِلَّةٌۚ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْجَنَّةِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "For them who have done good is the best [reward] - and extra.[1] No darkness will cover their faces, nor humiliation. Those are companions of Paradise; they will abide therein eternally.", "words": [{"id": 1, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 2, "arabic": "أَحْسَنُوا۟", "translit": "۟āwُnَsْḥَaʾ", "root": "حسن"}, {"id": 3, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 4, "arabic": "وَزِيَادَةٌ", "translit": "ٌẗَdāَyِzَw", "root": "زيد"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "يَرْهَقُ", "translit": "ُqَhْrَy", "root": "رهق"}, {"id": 7, "arabic": "وُجُوهَهُمْ", "translit": "ْmُhَhwُjgُw", "root": "وجه"}, {"id": 8, "arabic": "قَتَرٌ", "translit": "ٌrَtَq", "root": "قتر"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "ذِلَّةٌ", "translit": "ٌẗَّlِhd", "root": "ذلل"}, {"id": 11, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 12, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 13, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 14, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 15, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 16, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": true}, {"ayah": 27, "text": "وَٱلَّذِينَ كَسَبُوا۟ ٱلسَّيِّـَٔاتِ جَزَآءُ سَيِّئَةٍۭ بِمِثْلِهَا وَتَرْهَقُهُمْ ذِلَّةٌۖ مَّا لَهُم مِّنَ ٱللَّهِ مِنْ عَاصِمٍۖ كَأَنَّمَآ أُغْشِيَتْ وُجُوهُهُمْ قِطَعًا مِّنَ ٱلَّيْلِ مُظْلِمًاۚ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "But they who have earned [blame for] evil doings - the recompense of an evil deed is its equivalent, and humiliation will cover them. They will have from Allāh no protector. It will be as if their faces are covered with pieces of the night - so dark [are they]. Those are the companions of the Fire; they will abide therein eternally.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 3, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 4, "arabic": "جَزَآءُ", "translit": "ُءٓāَzَjg", "root": "جزي"}, {"id": 5, "arabic": "سَيِّئَةٍۭ", "translit": "ٍۭẗَyʾِّyَs", "root": "سوا"}, {"id": 6, "arabic": "بِمِثْلِهَا", "translit": "āَhِlْhtِmِb", "root": "مثل"}, {"id": 7, "arabic": "وَتَرْهَقُهُمْ", "translit": "ْmُhُqَhْrَtَw", "root": "رهق"}, {"id": 8, "arabic": "ذِلَّةٌ", "translit": "ٌẗَّlِhd", "root": "ذلل"}, {"id": 9, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 10, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 11, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "عَاصِمٍ", "translit": "ٍmِṣāَʿع", "root": "عصم"}, {"id": 15, "arabic": "كَأَنَّمَآ", "translit": "ٓāَmَّnَaʾَk", "root": ""}, {"id": 16, "arabic": "أُغْشِيَتْ", "translit": "ْtَyِhsْغُaʾ", "root": "غشو"}, {"id": 17, "arabic": "وُجُوهُهُمْ", "translit": "ْmُhُhwُjgُw", "root": "وجه"}, {"id": 18, "arabic": "قِطَعًا", "translit": "āًʿعَṭِq", "root": "قطع"}, {"id": 19, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 20, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 21, "arabic": "مُظْلِمًا", "translit": "āًmِlْẓُm", "root": "ظلم"}, {"id": 22, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 23, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 24, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 25, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 26, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 27, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 28, "text": "وَيَوْمَ نَحْشُرُهُمْ جَمِيعًا ثُمَّ نَقُولُ لِلَّذِينَ أَشْرَكُوا۟ مَكَانَكُمْ أَنتُمْ وَشُرَكَآؤُكُمْۚ فَزَيَّلْنَا بَيْنَهُمْۖ وَقَالَ شُرَكَآؤُهُم مَّا كُنتُمْ إِيَّانَا تَعْبُدُونَ ", "translation": "And [mention, O Muḥammad], the Day We will gather them all together - then We will say to those who associated others with Allāh, \"[Remain in] your place, you and your 'partners.'\"[1] Then We will separate them,[2] and their \"partners\" will say, \"You did not used to worship us,[3]", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "نَحْشُرُهُمْ", "translit": "ْmُhُrُhsْḥَn", "root": "حشر"}, {"id": 3, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "نَقُولُ", "translit": "ُlwُqَn", "root": "قول"}, {"id": 6, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 7, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 8, "arabic": "مَكَانَكُمْ", "translit": "ْmُkَnāَkَm", "root": "كون"}, {"id": 9, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 10, "arabic": "وَشُرَكَآؤُكُمْ", "translit": "ْmُkُwʾٓāَkَrُhsَw", "root": "شرك"}, {"id": 11, "arabic": "فَزَيَّلْنَا", "translit": "āَnْlَّyَzَf", "root": "زيل"}, {"id": 12, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 13, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 14, "arabic": "شُرَكَآؤُهُم", "translit": "mُhُwʾٓāَkَrُhs", "root": "شرك"}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 17, "arabic": "إِيَّانَا", "translit": "āَnāَّyِiʾ", "root": ""}, {"id": 18, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}], "hasIhya": false}, {"ayah": 29, "text": "فَكَفَىٰ بِٱللَّهِ شَهِيدًۢا بَيْنَنَا وَبَيْنَكُمْ إِن كُنَّا عَنْ عِبَادَتِكُمْ لَغَٰفِلِينَ ", "translation": "And sufficient is Allāh as a witness between us and you that we were of your worship unaware.\"", "words": [{"id": 1, "arabic": "فَكَفَىٰ", "translit": "ٰàَfَkَf", "root": "كفي"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "شَهِيدًۢا", "translit": "āًۢdyِhَhs", "root": "شهد"}, {"id": 4, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 5, "arabic": "وَبَيْنَكُمْ", "translit": "ْmُkَnْyَbَw", "root": "بين"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 8, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 9, "arabic": "عِبَادَتِكُمْ", "translit": "ْmُkِtَdāَbِʿع", "root": "عبد"}, {"id": 10, "arabic": "لَغَٰفِلِينَ", "translit": "َnyِlِfَٰغَl", "root": "غفل"}], "hasIhya": false}, {"ayah": 30, "text": "هُنَالِكَ تَبْلُوا۟ كُلُّ نَفْسٍ مَّآ أَسْلَفَتْۚ وَرُدُّوٓا۟ إِلَى ٱللَّهِ مَوْلَىٰهُمُ ٱلْحَقِّۖ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ", "translation": "There, [on that Day], every soul will be put to trial for what it did previously, and they will be returned to Allāh, their master, the Truth, and lost from them is whatever they used to invent.", "words": [{"id": 1, "arabic": "هُنَالِكَ", "translit": "َkِlāَnُh", "root": ""}, {"id": 2, "arabic": "تَبْلُوا۟", "translit": "۟āwُlْbَt", "root": "بلو"}, {"id": 3, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 4, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 5, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 6, "arabic": "أَسْلَفَتْ", "translit": "ْtَfَlْsَaʾ", "root": "سلف"}, {"id": 7, "arabic": "وَرُدُّوٓا۟", "translit": "۟āٓwُّdُrَw", "root": "ردد"}, {"id": 8, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "مَوْلَىٰهُمُ", "translit": "ُmُhٰàَlْwَm", "root": "ولي"}, {"id": 11, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 12, "arabic": "وَضَلَّ", "translit": "َّlَḍَw", "root": "ضلل"}, {"id": 13, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 14, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 15, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 16, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}], "hasIhya": false}, {"ayah": 31, "text": "قُلْ مَن يَرْزُقُكُم مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِ أَمَّن يَمْلِكُ ٱلسَّمْعَ وَٱلْأَبْصَٰرَ وَمَن يُخْرِجُ ٱلْحَىَّ مِنَ ٱلْمَيِّتِ وَيُخْرِجُ ٱلْمَيِّتَ مِنَ ٱلْحَىِّ وَمَن يُدَبِّرُ ٱلْأَمْرَۚ فَسَيَقُولُونَ ٱللَّهُۚ فَقُلْ أَفَلَا تَتَّقُونَ ", "translation": "Say, \"Who provides for you from the heaven and the earth? Or who controls hearing and sight and who brings the living out of the dead and brings the dead out of the living and who arranges [every] matter?\" They will say, \"Allāh,\" so say, \"Then will you not fear Him?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "يَرْزُقُكُم", "translit": "mُkُqُzْrَy", "root": "رزق"}, {"id": 4, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 8, "arabic": "يَمْلِكُ", "translit": "ُkِlْmَy", "root": "ملك"}, {"id": 9, "arabic": "ٱلسَّمْعَ", "translit": "َʿعْmَّslٱ", "root": "سمع"}, {"id": 10, "arabic": "وَٱلْأَبْصَٰرَ", "translit": "َrَٰṣْbَaʾْlٱَw", "root": "بصر"}, {"id": 11, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 12, "arabic": "يُخْرِجُ", "translit": "ُjgِrْhkُy", "root": "خرج"}, {"id": 13, "arabic": "ٱلْحَىَّ", "translit": "َّàَḥْlٱ", "root": "حيي"}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلْمَيِّتِ", "translit": "ِtِّyَmْlٱ", "root": "موت"}, {"id": 16, "arabic": "وَيُخْرِجُ", "translit": "ُjgِrْhkُyَw", "root": "خرج"}, {"id": 17, "arabic": "ٱلْمَيِّتَ", "translit": "َtِّyَmْlٱ", "root": "موت"}, {"id": 18, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 19, "arabic": "ٱلْحَىِّ", "translit": "ِّàَḥْlٱ", "root": "حيي"}, {"id": 20, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 21, "arabic": "يُدَبِّرُ", "translit": "ُrِّbَdُy", "root": "دبر"}, {"id": 22, "arabic": "ٱلْأَمْرَ", "translit": "َrْmَaʾْlٱ", "root": "امر"}, {"id": 23, "arabic": "فَسَيَقُولُونَ", "translit": "َnwُlwُqَyَsَf", "root": "قول"}, {"id": 24, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 26, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 27, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": false}, {"ayah": 32, "text": "فَذَٰلِكُمُ ٱللَّهُ رَبُّكُمُ ٱلْحَقُّۖ فَمَاذَا بَعْدَ ٱلْحَقِّ إِلَّا ٱلضَّلَٰلُۖ فَأَنَّىٰ تُصْرَفُونَ ", "translation": "For that is Allāh, your Lord, the Truth. And what can be beyond truth except error? So how are you averted?", "words": [{"id": 1, "arabic": "فَذَٰلِكُمُ", "translit": "ُmُkِlَٰhdَf", "root": ""}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "رَبُّكُمُ", "translit": "ُmُkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 5, "arabic": "فَمَاذَا", "translit": "āَhdāَmَf", "root": ""}, {"id": 6, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلضَّلَٰلُ", "translit": "ُlَٰlَّḍlٱ", "root": "ضلل"}, {"id": 10, "arabic": "فَأَنَّىٰ", "translit": "ٰàَّnَaʾَf", "root": ""}, {"id": 11, "arabic": "تُصْرَفُونَ", "translit": "َnwُfَrْṣُt", "root": "صرف"}], "hasIhya": false}, {"ayah": 33, "text": "كَذَٰلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى ٱلَّذِينَ فَسَقُوٓا۟ أَنَّهُمْ لَا يُؤْمِنُونَ ", "translation": "Thus the word [i.e., decree] of your Lord has come into effect upon those who defiantly disobeyed - that they will not believe.", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 2, "arabic": "حَقَّتْ", "translit": "ْtَّqَḥ", "root": "حقق"}, {"id": 3, "arabic": "كَلِمَتُ", "translit": "ُtَmِlَk", "root": "كلم"}, {"id": 4, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "فَسَقُوٓا۟", "translit": "۟āٓwُqَsَf", "root": "فسق"}, {"id": 8, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 34, "text": "قُلْ هَلْ مِن شُرَكَآئِكُم مَّن يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥۚ قُلِ ٱللَّهُ يَبْدَؤُا۟ ٱلْخَلْقَ ثُمَّ يُعِيدُهُۥۖ فَأَنَّىٰ تُؤْفَكُونَ ", "translation": "Say, \"Are there of your 'partners' any who begins creation and then repeats it?\" Say, \"Allāh begins creation and then repeats it, so how are you deluded?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "شُرَكَآئِكُم", "translit": "mُkِyʾٓāَkَrُhs", "root": "شرك"}, {"id": 5, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 6, "arabic": "يَبْدَؤُا۟", "translit": "۟āُwʾَdْbَy", "root": "بدا"}, {"id": 7, "arabic": "ٱلْخَلْقَ", "translit": "َqْlَhkْlٱ", "root": "خلق"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "يُعِيدُهُۥ", "translit": "ۥُhُdyِʿعُy", "root": "عود"}, {"id": 10, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "يَبْدَؤُا۟", "translit": "۟āُwʾَdْbَy", "root": "بدا"}, {"id": 13, "arabic": "ٱلْخَلْقَ", "translit": "َqْlَhkْlٱ", "root": "خلق"}, {"id": 14, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 15, "arabic": "يُعِيدُهُۥ", "translit": "ۥُhُdyِʿعُy", "root": "عود"}, {"id": 16, "arabic": "فَأَنَّىٰ", "translit": "ٰàَّnَaʾَf", "root": ""}, {"id": 17, "arabic": "تُؤْفَكُونَ", "translit": "َnwُkَfْwʾُt", "root": "افك"}], "hasIhya": false}, {"ayah": 35, "text": "قُلْ هَلْ مِن شُرَكَآئِكُم مَّن يَهْدِىٓ إِلَى ٱلْحَقِّۚ قُلِ ٱللَّهُ يَهْدِى لِلْحَقِّۗ أَفَمَن يَهْدِىٓ إِلَى ٱلْحَقِّ أَحَقُّ أَن يُتَّبَعَ أَمَّن لَّا يَهِدِّىٓ إِلَّآ أَن يُهْدَىٰۖ فَمَا لَكُمْ كَيْفَ تَحْكُمُونَ ", "translation": "Say, \"Are there of your 'partners' any who guides to the truth?\" Say, \"Allāh guides to the truth. So is He who guides to the truth more worthy to be followed or he who guides not unless he is guided? Then what is [wrong] with you - how do you judge?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "شُرَكَآئِكُم", "translit": "mُkِyʾٓāَkَrُhs", "root": "شرك"}, {"id": 5, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 6, "arabic": "يَهْدِىٓ", "translit": "ٓàِdْhَy", "root": "هدي"}, {"id": 7, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 9, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 12, "arabic": "لِلْحَقِّ", "translit": "ِّqَḥْlِl", "root": "حقق"}, {"id": 13, "arabic": "أَفَمَن", "translit": "nَmَfَaʾ", "root": ""}, {"id": 14, "arabic": "يَهْدِىٓ", "translit": "ٓàِdْhَy", "root": "هدي"}, {"id": 15, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 16, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 17, "arabic": "أَحَقُّ", "translit": "ُّqَḥَaʾ", "root": "حقق"}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "يُتَّبَعَ", "translit": "َʿعَbَّtُy", "root": "تبع"}, {"id": 20, "arabic": "أَمَّن", "translit": "nَّmَaʾ", "root": ""}, {"id": 21, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 22, "arabic": "يَهِدِّىٓ", "translit": "ٓàِّdِhَy", "root": "هدي"}, {"id": 23, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 24, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 25, "arabic": "يُهْدَىٰ", "translit": "ٰàَdْhُy", "root": "هدي"}, {"id": 26, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 27, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 28, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 29, "arabic": "تَحْكُمُونَ", "translit": "َnwُmُkْḥَt", "root": "حكم"}], "hasIhya": false}, {"ayah": 36, "text": "وَمَا يَتَّبِعُ أَكْثَرُهُمْ إِلَّا ظَنًّاۚ إِنَّ ٱلظَّنَّ لَا يُغْنِى مِنَ ٱلْحَقِّ شَيْـًٔاۚ إِنَّ ٱللَّهَ عَلِيمٌۢ بِمَا يَفْعَلُونَ ", "translation": "And most of them follow not except assumption. Indeed, assumption avails not against the truth at all. Indeed, Allāh is Knowing of what they do.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يَتَّبِعُ", "translit": "ُʿعِbَّtَy", "root": "تبع"}, {"id": 3, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "ظَنًّا", "translit": "āًّnَẓ", "root": "ظنن"}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلظَّنَّ", "translit": "َّnَّẓlٱ", "root": "ظنن"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يُغْنِى", "translit": "àِnْغُy", "root": "غني"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 12, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 16, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 17, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}, {"ayah": 37, "text": "وَمَا كَانَ هَٰذَا ٱلْقُرْءَانُ أَن يُفْتَرَىٰ مِن دُونِ ٱللَّهِ وَلَٰكِن تَصْدِيقَ ٱلَّذِى بَيْنَ يَدَيْهِ وَتَفْصِيلَ ٱلْكِتَٰبِ لَا رَيْبَ فِيهِ مِن رَّبِّ ٱلْعَٰلَمِينَ ", "translation": "And it was not [possible] for this Qur’ān to be produced by other than Allāh, but [it is] a confirmation of what was before it and a detailed explanation of the [former] Scripture, about which there is no doubt,[1] from the Lord of the worlds.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْقُرْءَانُ", "translit": "ُnāَءْrُqْlٱ", "root": "قرا"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يُفْتَرَىٰ", "translit": "ٰàَrَtْfُy", "root": "فري"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 11, "arabic": "تَصْدِيقَ", "translit": "َqyِdْṣَt", "root": "صدق"}, {"id": 12, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 14, "arabic": "يَدَيْهِ", "translit": "ِhْyَdَy", "root": "يدي"}, {"id": 15, "arabic": "وَتَفْصِيلَ", "translit": "َlyِṣْfَtَw", "root": "فصل"}, {"id": 16, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 19, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 21, "arabic": "رَّبِّ", "translit": "ِّbَّr", "root": "ربب"}, {"id": 22, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 38, "text": "أَمْ يَقُولُونَ ٱفْتَرَىٰهُۖ قُلْ فَأْتُوا۟ بِسُورَةٍ مِّثْلِهِۦ وَٱدْعُوا۟ مَنِ ٱسْتَطَعْتُم مِّن دُونِ ٱللَّهِ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "Or do they say [about the Prophet (ﷺ)], \"He invented it?\" Say, \"Then bring forth a sūrah like it and call upon [for assistance] whomever you can besides Allāh, if you should be truthful.\"", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "ٱفْتَرَىٰهُ", "translit": "ُhٰàَrَtْfٱ", "root": "فري"}, {"id": 4, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 5, "arabic": "فَأْتُوا۟", "translit": "۟āwُtْaʾَf", "root": "اتي"}, {"id": 6, "arabic": "بِسُورَةٍ", "translit": "ٍẗَrwُsِb", "root": "سور"}, {"id": 7, "arabic": "مِّثْلِهِۦ", "translit": "ۦِhِlْhtِّm", "root": "مثل"}, {"id": 8, "arabic": "وَٱدْعُوا۟", "translit": "۟āwُʿعْdٱَw", "root": "دعو"}, {"id": 9, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 10, "arabic": "ٱسْتَطَعْتُم", "translit": "mُtْʿعَṭَtْsٱ", "root": "طوع"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 15, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 16, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 39, "text": "بَلْ كَذَّبُوا۟ بِمَا لَمْ يُحِيطُوا۟ بِعِلْمِهِۦ وَلَمَّا يَأْتِهِمْ تَأْوِيلُهُۥۚ كَذَٰلِكَ كَذَّبَ ٱلَّذِينَ مِن قَبْلِهِمْۖ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلظَّٰلِمِينَ ", "translation": "Rather, they have denied that which they encompass not in knowledge and whose interpretation has not yet come to them. Thus did those before them deny. Then observe how was the end of the wrongdoers.", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 5, "arabic": "يُحِيطُوا۟", "translit": "۟āwُṭyِḥُy", "root": "حوط"}, {"id": 6, "arabic": "بِعِلْمِهِۦ", "translit": "ۦِhِmْlِʿعِb", "root": "علم"}, {"id": 7, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 8, "arabic": "يَأْتِهِمْ", "translit": "ْmِhِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "تَأْوِيلُهُۥ", "translit": "ۥُhُlyِwْaʾَt", "root": "اول"}, {"id": 10, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 11, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 15, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 16, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 17, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 18, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 19, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 40, "text": "وَمِنْهُم مَّن يُؤْمِنُ بِهِۦ وَمِنْهُم مَّن لَّا يُؤْمِنُ بِهِۦۚ وَرَبُّكَ أَعْلَمُ بِٱلْمُفْسِدِينَ ", "translation": "And of them are those who believe in it, and of them are those who do not believe in it. And your Lord is most knowing of the corrupters.", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 4, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 5, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 6, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 7, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 8, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "وَرَبُّكَ", "translit": "َkُّbَrَw", "root": "ربب"}, {"id": 11, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 12, "arabic": "بِٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱِb", "root": "فسد"}], "hasIhya": false}, {"ayah": 41, "text": "وَإِن كَذَّبُوكَ فَقُل لِّى عَمَلِى وَلَكُمْ عَمَلُكُمْۖ أَنتُم بَرِيٓـُٔونَ مِمَّآ أَعْمَلُ وَأَنَا۠ بَرِىٓءٌ مِّمَّا تَعْمَلُونَ ", "translation": "And if they deny you, [O Muḥammad], then say, \"For me are my deeds, and for you are your deeds. You are disassociated from what I do, and I am disassociated from what you do.\"", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "كَذَّبُوكَ", "translit": "َkwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "فَقُل", "translit": "lُqَf", "root": "قول"}, {"id": 4, "arabic": "لِّى", "translit": "àِّl", "root": ""}, {"id": 5, "arabic": "عَمَلِى", "translit": "àِlَmَʿع", "root": "عمل"}, {"id": 6, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 7, "arabic": "عَمَلُكُمْ", "translit": "ْmُkُlَmَʿع", "root": "عمل"}, {"id": 8, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 9, "arabic": "بَرِيٓـُٔونَ", "translit": "َnwُٔـٓyِrَb", "root": "برا"}, {"id": 10, "arabic": "مِمَّآ", "translit": "ٓāَّmِm", "root": ""}, {"id": 11, "arabic": "أَعْمَلُ", "translit": "ُlَmْʿعَaʾ", "root": "عمل"}, {"id": 12, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 13, "arabic": "بَرِىٓءٌ", "translit": "ٌءٓàِrَb", "root": "برا"}, {"id": 14, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 15, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 42, "text": "وَمِنْهُم مَّن يَسْتَمِعُونَ إِلَيْكَۚ أَفَأَنتَ تُسْمِعُ ٱلصُّمَّ وَلَوْ كَانُوا۟ لَا يَعْقِلُونَ ", "translation": "And among them are those who listen to you. But can you cause the deaf to hear [i.e., benefit from this hearing], although they will not use reason?", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "يَسْتَمِعُونَ", "translit": "َnwُʿعِmَtْsَy", "root": "سمع"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "أَفَأَنتَ", "translit": "َtnَaʾَfَaʾ", "root": ""}, {"id": 6, "arabic": "تُسْمِعُ", "translit": "ُʿعِmْsُt", "root": "سمع"}, {"id": 7, "arabic": "ٱلصُّمَّ", "translit": "َّmُّṣlٱ", "root": "صمم"}, {"id": 8, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 43, "text": "وَمِنْهُم مَّن يَنظُرُ إِلَيْكَۚ أَفَأَنتَ تَهْدِى ٱلْعُمْىَ وَلَوْ كَانُوا۟ لَا يُبْصِرُونَ ", "translation": "And among them are those who look at you. But can you guide the blind although they will not [attempt to] see?", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "يَنظُرُ", "translit": "ُrُẓnَy", "root": "نظر"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "أَفَأَنتَ", "translit": "َtnَaʾَfَaʾ", "root": ""}, {"id": 6, "arabic": "تَهْدِى", "translit": "àِdْhَt", "root": "هدي"}, {"id": 7, "arabic": "ٱلْعُمْىَ", "translit": "َàْmُʿعْlٱ", "root": "عمي"}, {"id": 8, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}], "hasIhya": false}, {"ayah": 44, "text": "إِنَّ ٱللَّهَ لَا يَظْلِمُ ٱلنَّاسَ شَيْـًٔا وَلَٰكِنَّ ٱلنَّاسَ أَنفُسَهُمْ يَظْلِمُونَ ", "translation": "Indeed, Allāh does not wrong the people at all, but it is the people who are wronging themselves.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَظْلِمُ", "translit": "ُmِlْẓَy", "root": "ظلم"}, {"id": 5, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 6, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 7, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 8, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 9, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 10, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 45, "text": "وَيَوْمَ يَحْشُرُهُمْ كَأَن لَّمْ يَلْبَثُوٓا۟ إِلَّا سَاعَةً مِّنَ ٱلنَّهَارِ يَتَعَارَفُونَ بَيْنَهُمْۚ قَدْ خَسِرَ ٱلَّذِينَ كَذَّبُوا۟ بِلِقَآءِ ٱللَّهِ وَمَا كَانُوا۟ مُهْتَدِينَ ", "translation": "And on the Day when He will gather them, [it will be] as if they had not remained [in the world] but an hour of the day, [and] they will know each other. Those will have lost who denied the meeting with Allāh and were not guided.", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يَحْشُرُهُمْ", "translit": "ْmُhُrُhsْḥَy", "root": "حشر"}, {"id": 3, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 4, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 5, "arabic": "يَلْبَثُوٓا۟", "translit": "۟āٓwُhtَbْlَy", "root": "لبث"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "سَاعَةً", "translit": "ًẗَʿعāَs", "root": "سوع"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلنَّهَارِ", "translit": "ِrāَhَّnlٱ", "root": "نهر"}, {"id": 10, "arabic": "يَتَعَارَفُونَ", "translit": "َnwُfَrāَʿعَtَy", "root": "عرف"}, {"id": 11, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 12, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 13, "arabic": "خَسِرَ", "translit": "َrِsَhk", "root": "خسر"}, {"id": 14, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 16, "arabic": "بِلِقَآءِ", "translit": "ِءٓāَqِlِb", "root": "لقي"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 19, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 20, "arabic": "مُهْتَدِينَ", "translit": "َnyِdَtْhُm", "root": "هدي"}], "hasIhya": false}, {"ayah": 46, "text": "وَإِمَّا نُرِيَنَّكَ بَعْضَ ٱلَّذِى نَعِدُهُمْ أَوْ نَتَوَفَّيَنَّكَ فَإِلَيْنَا مَرْجِعُهُمْ ثُمَّ ٱللَّهُ شَهِيدٌ عَلَىٰ مَا يَفْعَلُونَ ", "translation": "And whether We show you some of what We promise them, [O Muḥammad], or We take you in death, to Us is their return; then, [either way], Allāh is a witness concerning what they are doing.", "words": [{"id": 1, "arabic": "وَإِمَّا", "translit": "āَّmِiʾَw", "root": ""}, {"id": 2, "arabic": "نُرِيَنَّكَ", "translit": "َkَّnَyِrُn", "root": "راي"}, {"id": 3, "arabic": "بَعْضَ", "translit": "َḍْʿعَb", "root": "بعض"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "نَعِدُهُمْ", "translit": "ْmُhُdِʿعَn", "root": "وعد"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "نَتَوَفَّيَنَّكَ", "translit": "َkَّnَyَّfَwَtَn", "root": "وفي"}, {"id": 8, "arabic": "فَإِلَيْنَا", "translit": "āَnْyَlِiʾَf", "root": ""}, {"id": 9, "arabic": "مَرْجِعُهُمْ", "translit": "ْmُhُʿعِjgْrَm", "root": "رجع"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "شَهِيدٌ", "translit": "ٌdyِhَhs", "root": "شهد"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}, {"ayah": 47, "text": "وَلِكُلِّ أُمَّةٍ رَّسُولٌۖ فَإِذَا جَآءَ رَسُولُهُمْ قُضِىَ بَيْنَهُم بِٱلْقِسْطِ وَهُمْ لَا يُظْلَمُونَ ", "translation": "And for every nation is a messenger. So when their messenger comes,[1] it will be judged between them in justice, and they will not be wronged.", "words": [{"id": 1, "arabic": "وَلِكُلِّ", "translit": "ِّlُkِlَw", "root": "كلل"}, {"id": 2, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 3, "arabic": "رَّسُولٌ", "translit": "ٌlwُsَّr", "root": "رسل"}, {"id": 4, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 5, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 6, "arabic": "رَسُولُهُمْ", "translit": "ْmُhُlwُsَr", "root": "رسل"}, {"id": 7, "arabic": "قُضِىَ", "translit": "َàِḍُq", "root": "قضي"}, {"id": 8, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 9, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 10, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 48, "text": "وَيَقُولُونَ مَتَىٰ هَٰذَا ٱلْوَعْدُ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"When is [the fulfillment of] this promise, if you should be truthful?\"", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْوَعْدُ", "translit": "ُdْʿعَwْlٱ", "root": "وعد"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 49, "text": "قُل لَّآ أَمْلِكُ لِنَفْسِى ضَرًّا وَلَا نَفْعًا إِلَّا مَا شَآءَ ٱللَّهُۗ لِكُلِّ أُمَّةٍ أَجَلٌۚ إِذَا جَآءَ أَجَلُهُمْ فَلَا يَسْتَـْٔخِرُونَ سَاعَةًۖ وَلَا يَسْتَقْدِمُونَ ", "translation": "Say, \"I possess not for myself any harm or benefit except what Allāh should will. For every nation is a [specified] term. When their time has come, then they will not remain behind an hour, nor will they precede [it].\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 3, "arabic": "أَمْلِكُ", "translit": "ُkِlْmَaʾ", "root": "ملك"}, {"id": 4, "arabic": "لِنَفْسِى", "translit": "àِsْfَnِl", "root": "نفس"}, {"id": 5, "arabic": "ضَرًّا", "translit": "āًّrَḍ", "root": "ضرر"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "نَفْعًا", "translit": "āًʿعْfَn", "root": "نفع"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "لِكُلِّ", "translit": "ِّlُkِl", "root": "كلل"}, {"id": 13, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 14, "arabic": "أَجَلٌ", "translit": "ٌlَjgَaʾ", "root": "اجل"}, {"id": 15, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 16, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 17, "arabic": "أَجَلُهُمْ", "translit": "ْmُhُlَjgَaʾ", "root": "اجل"}, {"id": 18, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 19, "arabic": "يَسْتَـْٔخِرُونَ", "translit": "َnwُrِhkْٔـَtْsَy", "root": "اخر"}, {"id": 20, "arabic": "سَاعَةً", "translit": "ًẗَʿعāَs", "root": "سوع"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "يَسْتَقْدِمُونَ", "translit": "َnwُmِdْqَtْsَy", "root": "قدم"}], "hasIhya": true}, {"ayah": 50, "text": "قُلْ أَرَءَيْتُمْ إِنْ أَتَىٰكُمْ عَذَابُهُۥ بَيَٰتًا أَوْ نَهَارًا مَّاذَا يَسْتَعْجِلُ مِنْهُ ٱلْمُجْرِمُونَ ", "translation": "Say, \"Have you considered: if His punishment should come to you by night or by day - for which [aspect] of it would the criminals be impatient?\"[1]", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُمْ", "translit": "ْmُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 4, "arabic": "أَتَىٰكُمْ", "translit": "ْmُkٰàَtَaʾ", "root": "اتي"}, {"id": 5, "arabic": "عَذَابُهُۥ", "translit": "ۥُhُbāَhdَʿع", "root": "عذب"}, {"id": 6, "arabic": "بَيَٰتًا", "translit": "āًtَٰyَb", "root": "بيت"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "نَهَارًا", "translit": "āًrāَhَn", "root": "نهر"}, {"id": 9, "arabic": "مَّاذَا", "translit": "āَhdāَّm", "root": ""}, {"id": 10, "arabic": "يَسْتَعْجِلُ", "translit": "ُlِjgْʿعَtْsَy", "root": "عجل"}, {"id": 11, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 12, "arabic": "ٱلْمُجْرِمُونَ", "translit": "َnwُmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 51, "text": "أَثُمَّ إِذَا مَا وَقَعَ ءَامَنتُم بِهِۦٓۚ ءَآلْـَٰٔنَ وَقَدْ كُنتُم بِهِۦ تَسْتَعْجِلُونَ ", "translation": "Then is it that when it has [actually] occurred you will believe in it? Now?[1] And you were [once] for it impatient.[2]", "words": [{"id": 1, "arabic": "أَثُمَّ", "translit": "َّmُhtَaʾ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "وَقَعَ", "translit": "َʿعَqَw", "root": "وقع"}, {"id": 5, "arabic": "ءَامَنتُم", "translit": "mُtnَmāَء", "root": "امن"}, {"id": 6, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 7, "arabic": "ءَآلْـَٰٔنَ", "translit": "َnَٰٔـْlٓāَء", "root": "اون"}, {"id": 8, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 9, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "تَسْتَعْجِلُونَ", "translit": "َnwُlِjgْʿعَtْsَt", "root": "عجل"}], "hasIhya": false}, {"ayah": 52, "text": "ثُمَّ قِيلَ لِلَّذِينَ ظَلَمُوا۟ ذُوقُوا۟ عَذَابَ ٱلْخُلْدِ هَلْ تُجْزَوْنَ إِلَّا بِمَا كُنتُمْ تَكْسِبُونَ ", "translation": "Then it will be said to those who had wronged, \"Taste the punishment of eternity; are you being recompensed except for what you used to earn?\"", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 4, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 5, "arabic": "ذُوقُوا۟", "translit": "۟āwُqwُhd", "root": "ذوق"}, {"id": 6, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 7, "arabic": "ٱلْخُلْدِ", "translit": "ِdْlُhkْlٱ", "root": "خلد"}, {"id": 8, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 9, "arabic": "تُجْزَوْنَ", "translit": "َnْwَzْjgُt", "root": "جزي"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "تَكْسِبُونَ", "translit": "َnwُbِsْkَt", "root": "كسب"}], "hasIhya": false}, {"ayah": 53, "text": "وَيَسْتَنۢبِـُٔونَكَ أَحَقٌّ هُوَۖ قُلْ إِى وَرَبِّىٓ إِنَّهُۥ لَحَقٌّۖ وَمَآ أَنتُم بِمُعْجِزِينَ ", "translation": "And they ask information of you, [O Muḥammad], \"Is it true?\" Say, \"Yes, by my Lord. Indeed, it is truth; and you will not cause failure [to Allāh].\"", "words": [{"id": 1, "arabic": "وَيَسْتَنۢبِـُٔونَكَ", "translit": "َkَnwُٔـِbۢnَtْsَyَw", "root": "نبا"}, {"id": 2, "arabic": "أَحَقٌّ", "translit": "ٌّqَḥَaʾ", "root": "حقق"}, {"id": 3, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 4, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 5, "arabic": "إِى", "translit": "àِiʾ", "root": ""}, {"id": 6, "arabic": "وَرَبِّىٓ", "translit": "ٓàِّbَrَw", "root": "ربب"}, {"id": 7, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "لَحَقٌّ", "translit": "ٌّqَḥَl", "root": "حقق"}, {"id": 9, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 10, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 11, "arabic": "بِمُعْجِزِينَ", "translit": "َnyِzِjgْʿعُmِb", "root": "عجز"}], "hasIhya": false}, {"ayah": 54, "text": "وَلَوْ أَنَّ لِكُلِّ نَفْسٍ ظَلَمَتْ مَا فِى ٱلْأَرْضِ لَٱفْتَدَتْ بِهِۦۗ وَأَسَرُّوا۟ ٱلنَّدَامَةَ لَمَّا رَأَوُا۟ ٱلْعَذَابَۖ وَقُضِىَ بَيْنَهُم بِٱلْقِسْطِۚ وَهُمْ لَا يُظْلَمُونَ ", "translation": "And if each soul that wronged had everything on earth, it would offer it in ransom. And they will confide regret when they see the punishment; and they will be judged in justice, and they will not be wronged.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 3, "arabic": "لِكُلِّ", "translit": "ِّlُkِl", "root": "كلل"}, {"id": 4, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 5, "arabic": "ظَلَمَتْ", "translit": "ْtَmَlَẓ", "root": "ظلم"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "لَٱفْتَدَتْ", "translit": "ْtَdَtْfٱَl", "root": "فدي"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "وَأَسَرُّوا۟", "translit": "۟āwُّrَsَaʾَw", "root": "سرر"}, {"id": 12, "arabic": "ٱلنَّدَامَةَ", "translit": "َẗَmāَdَّnlٱ", "root": "ندم"}, {"id": 13, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 14, "arabic": "رَأَوُا۟", "translit": "۟āُwَaʾَr", "root": "راي"}, {"id": 15, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 16, "arabic": "وَقُضِىَ", "translit": "َàِḍُqَw", "root": "قضي"}, {"id": 17, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 18, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 19, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 55, "text": "أَلَآ إِنَّ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۗ أَلَآ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ ", "translation": "Unquestionably, to Allāh belongs whatever is in the heavens and the earth. Unquestionably, the promise of Allāh is truth, but most of them do not know.", "words": [{"id": 1, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 8, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "حَقٌّ", "translit": "ٌّqَḥ", "root": "حقق"}, {"id": 13, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 14, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 56, "text": "هُوَ يُحْىِۦ وَيُمِيتُ وَإِلَيْهِ تُرْجَعُونَ ", "translation": "He gives life and causes death, and to Him you will be returned.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "يُحْىِۦ", "translit": "ۦِàْḥُy", "root": "حيي"}, {"id": 3, "arabic": "وَيُمِيتُ", "translit": "ُtyِmُyَw", "root": "موت"}, {"id": 4, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 5, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": false}, {"ayah": 57, "text": "يَٰٓأَيُّهَا ٱلنَّاسُ قَدْ جَآءَتْكُم مَّوْعِظَةٌ مِّن رَّبِّكُمْ وَشِفَآءٌ لِّمَا فِى ٱلصُّدُورِ وَهُدًى وَرَحْمَةٌ لِّلْمُؤْمِنِينَ ", "translation": "O mankind, there has come to you instruction from your Lord and healing for what is in the breasts and guidance and mercy for the believers.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "جَآءَتْكُم", "translit": "mُkْtَءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "مَّوْعِظَةٌ", "translit": "ٌẗَẓِʿعْwَّm", "root": "وعظ"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 8, "arabic": "وَشِفَآءٌ", "translit": "ٌءٓāَfِhsَw", "root": "شفي"}, {"id": 9, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}, {"id": 12, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 13, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 14, "arabic": "لِّلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِّl", "root": "امن"}], "hasIhya": true}, {"ayah": 58, "text": "قُلْ بِفَضْلِ ٱللَّهِ وَبِرَحْمَتِهِۦ فَبِذَٰلِكَ فَلْيَفْرَحُوا۟ هُوَ خَيْرٌ مِّمَّا يَجْمَعُونَ ", "translation": "Say, \"In the bounty of Allāh and in His mercy - in that let them rejoice; it is better than what they accumulate.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "بِفَضْلِ", "translit": "ِlْḍَfِb", "root": "فضل"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَبِرَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَrِbَw", "root": "رحم"}, {"id": 5, "arabic": "فَبِذَٰلِكَ", "translit": "َkِlَٰhdِbَf", "root": ""}, {"id": 6, "arabic": "فَلْيَفْرَحُوا۟", "translit": "۟āwُḥَrْfَyْlَf", "root": "فرح"}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 9, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 10, "arabic": "يَجْمَعُونَ", "translit": "َnwُʿعَmْjgَy", "root": "جمع"}], "hasIhya": true}, {"ayah": 59, "text": "قُلْ أَرَءَيْتُم مَّآ أَنزَلَ ٱللَّهُ لَكُم مِّن رِّزْقٍ فَجَعَلْتُم مِّنْهُ حَرَامًا وَحَلَٰلًا قُلْ ءَآللَّهُ أَذِنَ لَكُمْۖ أَمْ عَلَى ٱللَّهِ تَفْتَرُونَ ", "translation": "Say, \"Have you seen what Allāh has sent down to you of provision of which you have made [some] lawful and [some] unlawful?\" Say, \"Has Allāh permitted you [to do so], or do you invent [something] about Allāh?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتُم", "translit": "mُtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 4, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "رِّزْقٍ", "translit": "ٍqْzِّr", "root": "رزق"}, {"id": 9, "arabic": "فَجَعَلْتُم", "translit": "mُtْlَʿعَjgَf", "root": "جعل"}, {"id": 10, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 11, "arabic": "حَرَامًا", "translit": "āًmāَrَḥ", "root": "حرم"}, {"id": 12, "arabic": "وَحَلَٰلًا", "translit": "āًlَٰlَḥَw", "root": "حلل"}, {"id": 13, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 14, "arabic": "ءَآللَّهُ", "translit": "ُhَّllٓāَء", "root": "اله"}, {"id": 15, "arabic": "أَذِنَ", "translit": "َnِhdَaʾ", "root": "اذن"}, {"id": 16, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 17, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 18, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "تَفْتَرُونَ", "translit": "َnwُrَtْfَt", "root": "فري"}], "hasIhya": false}, {"ayah": 60, "text": "وَمَا ظَنُّ ٱلَّذِينَ يَفْتَرُونَ عَلَى ٱللَّهِ ٱلْكَذِبَ يَوْمَ ٱلْقِيَٰمَةِۗ إِنَّ ٱللَّهَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَشْكُرُونَ ", "translation": "And what will be the supposition of those who invent falsehood about Allāh on the Day of Resurrection?[1] Indeed, Allāh is the possessor of bounty for the people, but most of them are not grateful.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "ظَنُّ", "translit": "ُّnَẓ", "root": "ظنن"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 8, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 9, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "لَذُو", "translit": "wُhdَl", "root": ""}, {"id": 13, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 14, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 15, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 16, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 17, "arabic": "أَكْثَرَهُمْ", "translit": "ْmُhَrَhtْkَaʾ", "root": "كثر"}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يَشْكُرُونَ", "translit": "َnwُrُkْhsَy", "root": "شكر"}], "hasIhya": false}, {"ayah": 61, "text": "وَمَا تَكُونُ فِى شَأْنٍ وَمَا تَتْلُوا۟ مِنْهُ مِن قُرْءَانٍ وَلَا تَعْمَلُونَ مِنْ عَمَلٍ إِلَّا كُنَّا عَلَيْكُمْ شُهُودًا إِذْ تُفِيضُونَ فِيهِۚ وَمَا يَعْزُبُ عَن رَّبِّكَ مِن مِّثْقَالِ ذَرَّةٍ فِى ٱلْأَرْضِ وَلَا فِى ٱلسَّمَآءِ وَلَآ أَصْغَرَ مِن ذَٰلِكَ وَلَآ أَكْبَرَ إِلَّا فِى كِتَٰبٍ مُّبِينٍ ", "translation": "And, [O Muḥammad], you are not [engaged] in any matter and do not recite any of the Qur’ān and you [people] do not do any deed except that We are witness over you when you are involved in it. And not absent from your Lord is any [part] of an atom's weight[1] within the earth or within the heaven or [anything] smaller than that or greater but that it is in a clear register.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تَكُونُ", "translit": "ُnwُkَt", "root": "كون"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "شَأْنٍ", "translit": "ٍnْaʾَhs", "root": "شان"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "تَتْلُوا۟", "translit": "۟āwُlْtَt", "root": "تلو"}, {"id": 7, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قُرْءَانٍ", "translit": "ٍnāَءْrُq", "root": "قرا"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 12, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 13, "arabic": "عَمَلٍ", "translit": "ٍlَmَʿع", "root": "عمل"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 16, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 17, "arabic": "شُهُودًا", "translit": "āًdwُhُhs", "root": "شهد"}, {"id": 18, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 19, "arabic": "تُفِيضُونَ", "translit": "َnwُḍyِfُt", "root": "فيض"}, {"id": 20, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 21, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 22, "arabic": "يَعْزُبُ", "translit": "ُbُzْʿعَy", "root": "عزب"}, {"id": 23, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 24, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 25, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 26, "arabic": "مِّثْقَالِ", "translit": "ِlāَqْhtِّm", "root": "ثقل"}, {"id": 27, "arabic": "ذَرَّةٍ", "translit": "ٍẗَّrَhd", "root": "ذرر"}, {"id": 28, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 29, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 30, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 31, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 32, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 33, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 34, "arabic": "أَصْغَرَ", "translit": "َrَغْṣَaʾ", "root": "صغر"}, {"id": 35, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 36, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 37, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 38, "arabic": "أَكْبَرَ", "translit": "َrَbْkَaʾ", "root": "كبر"}, {"id": 39, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 40, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 41, "arabic": "كِتَٰبٍ", "translit": "ٍbَٰtِk", "root": "كتب"}, {"id": 42, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 62, "text": "أَلَآ إِنَّ أَوْلِيَآءَ ٱللَّهِ لَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "Unquestionably, [for] the allies of Allāh there will be no fear concerning them, nor will they grieve -", "words": [{"id": 1, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 7, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 10, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": false}, {"ayah": 63, "text": "ٱلَّذِينَ ءَامَنُوا۟ وَكَانُوا۟ يَتَّقُونَ ", "translation": "Those who believed and were fearing Allāh.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 4, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}], "hasIhya": false}, {"ayah": 64, "text": "لَهُمُ ٱلْبُشْرَىٰ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَفِى ٱلْءَاخِرَةِۚ لَا تَبْدِيلَ لِكَلِمَٰتِ ٱللَّهِۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ", "translation": "For them are good tidings in the worldly life and in the Hereafter. No change is there in the words [i.e., decrees] of Allāh. That is what is the great attainment.", "words": [{"id": 1, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 2, "arabic": "ٱلْبُشْرَىٰ", "translit": "ٰàَrْhsُbْlٱ", "root": "بشر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 7, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "تَبْدِيلَ", "translit": "َlyِdْbَt", "root": "بدل"}, {"id": 10, "arabic": "لِكَلِمَٰتِ", "translit": "ِtَٰmِlَkِl", "root": "كلم"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 14, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 15, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 65, "text": "وَلَا يَحْزُنكَ قَوْلُهُمْۘ إِنَّ ٱلْعِزَّةَ لِلَّهِ جَمِيعًاۚ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ", "translation": "And let not their speech grieve you. Indeed, honor [due to power] belongs to Allāh entirely. He is the Hearing, the Knowing.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَحْزُنكَ", "translit": "َknُzْḥَy", "root": "حزن"}, {"id": 3, "arabic": "قَوْلُهُمْ", "translit": "ْmُhُlْwَq", "root": "قول"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلْعِزَّةَ", "translit": "َẗَّzِʿعْlٱ", "root": "عزز"}, {"id": 6, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 7, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 10, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 66, "text": "أَلَآ إِنَّ لِلَّهِ مَن فِى ٱلسَّمَٰوَٰتِ وَمَن فِى ٱلْأَرْضِۗ وَمَا يَتَّبِعُ ٱلَّذِينَ يَدْعُونَ مِن دُونِ ٱللَّهِ شُرَكَآءَۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ ", "translation": "Unquestionably, to Allāh belongs whoever is in the heavens and whoever is on the earth. And those who invoke other than Allāh do not [actually] follow [His] \"partners.\" They follow not except assumption, and they are not but misjudging.", "words": [{"id": 1, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "يَتَّبِعُ", "translit": "ُʿعِbَّtَy", "root": "تبع"}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "شُرَكَآءَ", "translit": "َءٓāَkَrُhs", "root": "شرك"}, {"id": 18, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 19, "arabic": "يَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَy", "root": "تبع"}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "ٱلظَّنَّ", "translit": "َّnَّẓlٱ", "root": "ظنن"}, {"id": 22, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 23, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 24, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 25, "arabic": "يَخْرُصُونَ", "translit": "َnwُṣُrْhkَy", "root": "خرص"}], "hasIhya": true}, {"ayah": 67, "text": "هُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًاۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يَسْمَعُونَ ", "translation": "It is He who made for you the night to rest therein and the day, giving sight.[1] Indeed in that are signs for a people who listen.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 6, "arabic": "لِتَسْكُنُوا۟", "translit": "۟āwُnُkْsَtِl", "root": "سكن"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 9, "arabic": "مُبْصِرًا", "translit": "āًrِṣْbُm", "root": "بصر"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 14, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 15, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}], "hasIhya": false}, {"ayah": 68, "text": "قَالُوا۟ ٱتَّخَذَ ٱللَّهُ وَلَدًاۗ سُبْحَٰنَهُۥۖ هُوَ ٱلْغَنِىُّۖ لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۚ إِنْ عِندَكُم مِّن سُلْطَٰنٍۭ بِهَٰذَآۚ أَتَقُولُونَ عَلَى ٱللَّهِ مَا لَا تَعْلَمُونَ ", "translation": "They[1] have said, \"Allāh has taken a son.\" Exalted is He; He is the [one] Free of need. To Him belongs whatever is in the heavens and whatever is in the earth. You have no authority[2] for this [claim]. Do you say about Allāh that which you do not know?", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَلَدًا", "translit": "āًdَlَw", "root": "ولد"}, {"id": 5, "arabic": "سُبْحَٰنَهُۥ", "translit": "ۥُhَnَٰḥْbُs", "root": "سبح"}, {"id": 6, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 7, "arabic": "ٱلْغَنِىُّ", "translit": "ُّàِnَغْlٱ", "root": "غني"}, {"id": 8, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 15, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 16, "arabic": "عِندَكُم", "translit": "mُkَdnِʿع", "root": "عند"}, {"id": 17, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 18, "arabic": "سُلْطَٰنٍۭ", "translit": "ٍۭnَٰṭْlُs", "root": "سلط"}, {"id": 19, "arabic": "بِهَٰذَآ", "translit": "ٓāَhdَٰhِb", "root": ""}, {"id": 20, "arabic": "أَتَقُولُونَ", "translit": "َnwُlwُqَtَaʾ", "root": "قول"}, {"id": 21, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 69, "text": "قُلْ إِنَّ ٱلَّذِينَ يَفْتَرُونَ عَلَى ٱللَّهِ ٱلْكَذِبَ لَا يُفْلِحُونَ ", "translation": "Say, \"Indeed, those who invent falsehood about Allāh will not succeed.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يُفْلِحُونَ", "translit": "َnwُḥِlْfُy", "root": "فلح"}], "hasIhya": false}, {"ayah": 70, "text": "مَتَٰعٌ فِى ٱلدُّنْيَا ثُمَّ إِلَيْنَا مَرْجِعُهُمْ ثُمَّ نُذِيقُهُمُ ٱلْعَذَابَ ٱلشَّدِيدَ بِمَا كَانُوا۟ يَكْفُرُونَ ", "translation": "[For them is brief] enjoyment in this world; then to Us is their return; then We will make them taste the severe punishment because they used to disbelieve.", "words": [{"id": 1, "arabic": "مَتَٰعٌ", "translit": "ٌʿعَٰtَm", "root": "متع"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "مَرْجِعُهُمْ", "translit": "ْmُhُʿعِjgْrَm", "root": "رجع"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "نُذِيقُهُمُ", "translit": "ُmُhُqyِhdُn", "root": "ذوق"}, {"id": 9, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 10, "arabic": "ٱلشَّدِيدَ", "translit": "َdyِdَّhslٱ", "root": "شدد"}, {"id": 11, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يَكْفُرُونَ", "translit": "َnwُrُfْkَy", "root": "كفر"}], "hasIhya": false}, {"ayah": 71, "text": "وَٱتْلُ عَلَيْهِمْ نَبَأَ نُوحٍ إِذْ قَالَ لِقَوْمِهِۦ يَٰقَوْمِ إِن كَانَ كَبُرَ عَلَيْكُم مَّقَامِى وَتَذْكِيرِى بِـَٔايَٰتِ ٱللَّهِ فَعَلَى ٱللَّهِ تَوَكَّلْتُ فَأَجْمِعُوٓا۟ أَمْرَكُمْ وَشُرَكَآءَكُمْ ثُمَّ لَا يَكُنْ أَمْرُكُمْ عَلَيْكُمْ غُمَّةً ثُمَّ ٱقْضُوٓا۟ إِلَىَّ وَلَا تُنظِرُونِ ", "translation": "And recite to them the news of Noah, when he said to his people, \"O my people, if my residence and my reminding of the signs of Allāh has become burdensome upon you - then I have relied upon Allāh. So resolve upon your plan and [call upon] your associates. Then let not your plan be obscure to you.[1] Then carry it out upon me and do not give me respite.", "words": [{"id": 1, "arabic": "وَٱتْلُ", "translit": "ُlْtٱَw", "root": "تلو"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "نَبَأَ", "translit": "َaʾَbَn", "root": "نبا"}, {"id": 4, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 5, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "لِقَوْمِهِۦ", "translit": "ۦِhِmْwَqِl", "root": "قوم"}, {"id": 8, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 9, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "كَبُرَ", "translit": "َrُbَk", "root": "كبر"}, {"id": 12, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 13, "arabic": "مَّقَامِى", "translit": "àِmāَqَّm", "root": "قوم"}, {"id": 14, "arabic": "وَتَذْكِيرِى", "translit": "àِryِkْhdَtَw", "root": "ذكر"}, {"id": 15, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "فَعَلَى", "translit": "àَlَʿعَf", "root": ""}, {"id": 18, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "تَوَكَّلْتُ", "translit": "ُtْlَّkَwَt", "root": "وكل"}, {"id": 20, "arabic": "فَأَجْمِعُوٓا۟", "translit": "۟āٓwُʿعِmْjgَaʾَf", "root": "جمع"}, {"id": 21, "arabic": "أَمْرَكُمْ", "translit": "ْmُkَrْmَaʾ", "root": "امر"}, {"id": 22, "arabic": "وَشُرَكَآءَكُمْ", "translit": "ْmُkَءٓāَkَrُhsَw", "root": "شرك"}, {"id": 23, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "يَكُنْ", "translit": "ْnُkَy", "root": "كون"}, {"id": 26, "arabic": "أَمْرُكُمْ", "translit": "ْmُkُrْmَaʾ", "root": "امر"}, {"id": 27, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 28, "arabic": "غُمَّةً", "translit": "ًẗَّmُغ", "root": "غمم"}, {"id": 29, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 30, "arabic": "ٱقْضُوٓا۟", "translit": "۟āٓwُḍْqٱ", "root": "قضي"}, {"id": 31, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 32, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 33, "arabic": "تُنظِرُونِ", "translit": "ِnwُrِẓnُt", "root": "نظر"}], "hasIhya": false}, {"ayah": 72, "text": "فَإِن تَوَلَّيْتُمْ فَمَا سَأَلْتُكُم مِّنْ أَجْرٍۖ إِنْ أَجْرِىَ إِلَّا عَلَى ٱللَّهِۖ وَأُمِرْتُ أَنْ أَكُونَ مِنَ ٱلْمُسْلِمِينَ ", "translation": "And if you turn away [from my advice] - then no payment have I asked of you. My reward is only from Allāh, and I have been commanded to be of the Muslims [i.e., those who submit to Allāh].\"", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "تَوَلَّيْتُمْ", "translit": "ْmُtْyَّlَwَt", "root": "ولي"}, {"id": 3, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 4, "arabic": "سَأَلْتُكُم", "translit": "mُkُtْlَaʾَs", "root": "سال"}, {"id": 5, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 6, "arabic": "أَجْرٍ", "translit": "ٍrْjgَaʾ", "root": "اجر"}, {"id": 7, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 8, "arabic": "أَجْرِىَ", "translit": "َàِrْjgَaʾ", "root": "اجر"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَأُمِرْتُ", "translit": "ُtْrِmُaʾَw", "root": "امر"}, {"id": 13, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 14, "arabic": "أَكُونَ", "translit": "َnwُkَaʾ", "root": "كون"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlٱ", "root": "سلم"}], "hasIhya": false}, {"ayah": 73, "text": "فَكَذَّبُوهُ فَنَجَّيْنَٰهُ وَمَن مَّعَهُۥ فِى ٱلْفُلْكِ وَجَعَلْنَٰهُمْ خَلَٰٓئِفَ وَأَغْرَقْنَا ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَاۖ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُنذَرِينَ ", "translation": "And they denied him, so We saved him and those with him in the ship and made them successors, and We drowned those who denied Our signs. Then see how was the end of those who were warned.", "words": [{"id": 1, "arabic": "فَكَذَّبُوهُ", "translit": "ُhwُbَّhdَkَf", "root": "كذب"}, {"id": 2, "arabic": "فَنَجَّيْنَٰهُ", "translit": "ُhَٰnْyَّjgَnَf", "root": "نجو"}, {"id": 3, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 4, "arabic": "مَّعَهُۥ", "translit": "ۥُhَʿعَّm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْفُلْكِ", "translit": "ِkْlُfْlٱ", "root": "فلك"}, {"id": 7, "arabic": "وَجَعَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "خَلَٰٓئِفَ", "translit": "َfِyʾَٰٓlَhk", "root": "خلف"}, {"id": 9, "arabic": "وَأَغْرَقْنَا", "translit": "āَnْqَrْغَaʾَw", "root": "غرق"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 12, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 13, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 14, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 15, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 16, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 17, "arabic": "ٱلْمُنذَرِينَ", "translit": "َnyِrَhdnُmْlٱ", "root": "نذر"}], "hasIhya": false}, {"ayah": 74, "text": "ثُمَّ بَعَثْنَا مِنۢ بَعْدِهِۦ رُسُلًا إِلَىٰ قَوْمِهِمْ فَجَآءُوهُم بِٱلْبَيِّنَٰتِ فَمَا كَانُوا۟ لِيُؤْمِنُوا۟ بِمَا كَذَّبُوا۟ بِهِۦ مِن قَبْلُۚ كَذَٰلِكَ نَطْبَعُ عَلَىٰ قُلُوبِ ٱلْمُعْتَدِينَ ", "translation": "Then We sent after him messengers to their peoples, and they came to them with clear proofs. But they were not to believe in that which they had denied before.[1] Thus We seal over the hearts of the transgressors.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "بَعَثْنَا", "translit": "āَnْhtَʿعَb", "root": "بعث"}, {"id": 3, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 4, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "رُسُلًا", "translit": "āًlُsُr", "root": "رسل"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "قَوْمِهِمْ", "translit": "ْmِhِmْwَq", "root": "قوم"}, {"id": 8, "arabic": "فَجَآءُوهُم", "translit": "mُhwُءٓāَjgَf", "root": "جيا"}, {"id": 9, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 10, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "لِيُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُyِl", "root": "امن"}, {"id": 13, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 14, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 15, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 18, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 19, "arabic": "نَطْبَعُ", "translit": "ُʿعَbْṭَn", "root": "طبع"}, {"id": 20, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 21, "arabic": "قُلُوبِ", "translit": "ِbwُlُq", "root": "قلب"}, {"id": 22, "arabic": "ٱلْمُعْتَدِينَ", "translit": "َnyِdَtْʿعُmْlٱ", "root": "عدو"}], "hasIhya": false}, {"ayah": 75, "text": "ثُمَّ بَعَثْنَا مِنۢ بَعْدِهِم مُّوسَىٰ وَهَٰرُونَ إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ بِـَٔايَٰتِنَا فَٱسْتَكْبَرُوا۟ وَكَانُوا۟ قَوْمًا مُّجْرِمِينَ ", "translation": "Then We sent after them Moses and Aaron to Pharaoh and his establishment with Our signs, but they behaved arrogantly and were a criminal people.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "بَعَثْنَا", "translit": "āَnْhtَʿعَb", "root": "بعث"}, {"id": 3, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 4, "arabic": "بَعْدِهِم", "translit": "mِhِdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "مُّوسَىٰ", "translit": "ٰàَswُّm", "root": ""}, {"id": 6, "arabic": "وَهَٰرُونَ", "translit": "َnwُrَٰhَw", "root": ""}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 9, "arabic": "وَمَلَإِي۟هِۦ", "translit": "ۦِh۟yِiʾَlَmَw", "root": "ملا"}, {"id": 10, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 11, "arabic": "فَٱسْتَكْبَرُوا۟", "translit": "۟āwُrَbْkَtْsٱَf", "root": "كبر"}, {"id": 12, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 13, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 14, "arabic": "مُّجْرِمِينَ", "translit": "َnyِmِrْjgُّm", "root": "جرم"}], "hasIhya": false}, {"ayah": 76, "text": "فَلَمَّا جَآءَهُمُ ٱلْحَقُّ مِنْ عِندِنَا قَالُوٓا۟ إِنَّ هَٰذَا لَسِحْرٌ مُّبِينٌ ", "translation": "So when there came to them the truth from Us, they said, \"Indeed, this is obvious magic.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "عِندِنَا", "translit": "āَnِdnِʿع", "root": "عند"}, {"id": 6, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 9, "arabic": "لَسِحْرٌ", "translit": "ٌrْḥِsَl", "root": "سحر"}, {"id": 10, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 77, "text": "قَالَ مُوسَىٰٓ أَتَقُولُونَ لِلْحَقِّ لَمَّا جَآءَكُمْۖ أَسِحْرٌ هَٰذَا وَلَا يُفْلِحُ ٱلسَّٰحِرُونَ ", "translation": "Moses said, \"Do you say [thus] about the truth when it has come to you? Is this magic? But magicians will not succeed.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 3, "arabic": "أَتَقُولُونَ", "translit": "َnwُlwُqَtَaʾ", "root": "قول"}, {"id": 4, "arabic": "لِلْحَقِّ", "translit": "ِّqَḥْlِl", "root": "حقق"}, {"id": 5, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 6, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 7, "arabic": "أَسِحْرٌ", "translit": "ٌrْḥِsَaʾ", "root": "سحر"}, {"id": 8, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يُفْلِحُ", "translit": "ُḥِlْfُy", "root": "فلح"}, {"id": 11, "arabic": "ٱلسَّٰحِرُونَ", "translit": "َnwُrِḥَّٰslٱ", "root": "سحر"}], "hasIhya": false}, {"ayah": 78, "text": "قَالُوٓا۟ أَجِئْتَنَا لِتَلْفِتَنَا عَمَّا وَجَدْنَا عَلَيْهِ ءَابَآءَنَا وَتَكُونَ لَكُمَا ٱلْكِبْرِيَآءُ فِى ٱلْأَرْضِ وَمَا نَحْنُ لَكُمَا بِمُؤْمِنِينَ ", "translation": "They said, \"Have you come to us to turn us away from that upon which we found our fathers and so that you two may have grandeur in the land? And we are not believers in you.\"", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "أَجِئْتَنَا", "translit": "āَnَtْyʾِjgَaʾ", "root": "جيا"}, {"id": 3, "arabic": "لِتَلْفِتَنَا", "translit": "āَnَtِfْlَtِl", "root": "لفت"}, {"id": 4, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 5, "arabic": "وَجَدْنَا", "translit": "āَnْdَjgَw", "root": "وجد"}, {"id": 6, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "ءَابَآءَنَا", "translit": "āَnَءٓāَbāَء", "root": "ابو"}, {"id": 8, "arabic": "وَتَكُونَ", "translit": "َnwُkَtَw", "root": "كون"}, {"id": 9, "arabic": "لَكُمَا", "translit": "āَmُkَl", "root": ""}, {"id": 10, "arabic": "ٱلْكِبْرِيَآءُ", "translit": "ُءٓāَyِrْbِkْlٱ", "root": "كبر"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 15, "arabic": "لَكُمَا", "translit": "āَmُkَl", "root": ""}, {"id": 16, "arabic": "بِمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmِb", "root": "امن"}], "hasIhya": false}, {"ayah": 79, "text": "وَقَالَ فِرْعَوْنُ ٱئْتُونِى بِكُلِّ سَٰحِرٍ عَلِيمٍ ", "translation": "And Pharaoh said, \"Bring to me every learned magician.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "ٱئْتُونِى", "translit": "àِnwُtْyʾٱ", "root": "اتي"}, {"id": 4, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 5, "arabic": "سَٰحِرٍ", "translit": "ٍrِḥَٰs", "root": "سحر"}, {"id": 6, "arabic": "عَلِيمٍ", "translit": "ٍmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 80, "text": "فَلَمَّا جَآءَ ٱلسَّحَرَةُ قَالَ لَهُم مُّوسَىٰٓ أَلْقُوا۟ مَآ أَنتُم مُّلْقُونَ ", "translation": "So when the magicians came, Moses said to them, \"Throw down whatever you will throw.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ٱلسَّحَرَةُ", "translit": "ُẗَrَḥَّslٱ", "root": "سحر"}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 6, "arabic": "مُّوسَىٰٓ", "translit": "ٰٓàَswُّm", "root": ""}, {"id": 7, "arabic": "أَلْقُوا۟", "translit": "۟āwُqْlَaʾ", "root": "لقي"}, {"id": 8, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 9, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 10, "arabic": "مُّلْقُونَ", "translit": "َnwُqْlُّm", "root": "لقي"}], "hasIhya": false}, {"ayah": 81, "text": "فَلَمَّآ أَلْقَوْا۟ قَالَ مُوسَىٰ مَا جِئْتُم بِهِ ٱلسِّحْرُۖ إِنَّ ٱللَّهَ سَيُبْطِلُهُۥٓۖ إِنَّ ٱللَّهَ لَا يُصْلِحُ عَمَلَ ٱلْمُفْسِدِينَ ", "translation": "And when they had thrown, Moses said, \"What you have brought is [only] magic. Indeed, Allāh will expose its worthlessness. Indeed, Allāh does not amend the work of corrupters.", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 2, "arabic": "أَلْقَوْا۟", "translit": "۟āْwَqْlَaʾ", "root": "لقي"}, {"id": 3, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 4, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "جِئْتُم", "translit": "mُtْyʾِjg", "root": "جيا"}, {"id": 7, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 8, "arabic": "ٱلسِّحْرُ", "translit": "ُrْḥِّslٱ", "root": "سحر"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "سَيُبْطِلُهُۥٓ", "translit": "ٓۥُhُlِṭْbُyَs", "root": "بطل"}, {"id": 12, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "يُصْلِحُ", "translit": "ُḥِlْṣُy", "root": "صلح"}, {"id": 16, "arabic": "عَمَلَ", "translit": "َlَmَʿع", "root": "عمل"}, {"id": 17, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 82, "text": "وَيُحِقُّ ٱللَّهُ ٱلْحَقَّ بِكَلِمَٰتِهِۦ وَلَوْ كَرِهَ ٱلْمُجْرِمُونَ ", "translation": "And Allāh will establish the truth by His words, even if the criminals dislike it.\"", "words": [{"id": 1, "arabic": "وَيُحِقُّ", "translit": "ُّqِḥُyَw", "root": "حقق"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 4, "arabic": "بِكَلِمَٰتِهِۦ", "translit": "ۦِhِtَٰmِlَkِb", "root": "كلم"}, {"id": 5, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 6, "arabic": "كَرِهَ", "translit": "َhِrَk", "root": "كره"}, {"id": 7, "arabic": "ٱلْمُجْرِمُونَ", "translit": "َnwُmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 83, "text": "فَمَآ ءَامَنَ لِمُوسَىٰٓ إِلَّا ذُرِّيَّةٌ مِّن قَوْمِهِۦ عَلَىٰ خَوْفٍ مِّن فِرْعَوْنَ وَمَلَإِي۟هِمْ أَن يَفْتِنَهُمْۚ وَإِنَّ فِرْعَوْنَ لَعَالٍ فِى ٱلْأَرْضِ وَإِنَّهُۥ لَمِنَ ٱلْمُسْرِفِينَ ", "translation": "But no one believed Moses, except [some] offspring [i.e., youths] among his people, for fear of Pharaoh and his establishment that they would persecute them. And indeed, Pharaoh was haughty within the land, and indeed, he was of the transgressors.", "words": [{"id": 1, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 2, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 3, "arabic": "لِمُوسَىٰٓ", "translit": "ٰٓàَswُmِl", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "ذُرِّيَّةٌ", "translit": "ٌẗَّyِّrُhd", "root": "ذرر"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "خَوْفٍ", "translit": "ٍfْwَhk", "root": "خوف"}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 12, "arabic": "وَمَلَإِي۟هِمْ", "translit": "ْmِh۟yِiʾَlَmَw", "root": "ملا"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "يَفْتِنَهُمْ", "translit": "ْmُhَnِtْfَy", "root": "فتن"}, {"id": 15, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 16, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 17, "arabic": "لَعَالٍ", "translit": "ٍlāَʿعَl", "root": "علو"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 20, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 21, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 22, "arabic": "ٱلْمُسْرِفِينَ", "translit": "َnyِfِrْsُmْlٱ", "root": "سرف"}], "hasIhya": false}, {"ayah": 84, "text": "وَقَالَ مُوسَىٰ يَٰقَوْمِ إِن كُنتُمْ ءَامَنتُم بِٱللَّهِ فَعَلَيْهِ تَوَكَّلُوٓا۟ إِن كُنتُم مُّسْلِمِينَ ", "translation": "And Moses said, \"O my people, if you have believed in Allāh, then rely upon Him, if you should be Muslims [i.e., submitting to Him].\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 3, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 4, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 5, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 6, "arabic": "ءَامَنتُم", "translit": "mُtnَmāَء", "root": "امن"}, {"id": 7, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 8, "arabic": "فَعَلَيْهِ", "translit": "ِhْyَlَʿعَf", "root": ""}, {"id": 9, "arabic": "تَوَكَّلُوٓا۟", "translit": "۟āٓwُlَّkَwَt", "root": "وكل"}, {"id": 10, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 11, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 12, "arabic": "مُّسْلِمِينَ", "translit": "َnyِmِlْsُّm", "root": "سلم"}], "hasIhya": true}, {"ayah": 85, "text": "فَقَالُوا۟ عَلَى ٱللَّهِ تَوَكَّلْنَا رَبَّنَا لَا تَجْعَلْنَا فِتْنَةً لِّلْقَوْمِ ٱلظَّٰلِمِينَ ", "translation": "So they said, \"Upon Allāh do we rely. Our Lord, make us not [objects of] trial for the wrongdoing people", "words": [{"id": 1, "arabic": "فَقَالُوا۟", "translit": "۟āwُlāَqَf", "root": "قول"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "تَوَكَّلْنَا", "translit": "āَnْlَّkَwَt", "root": "وكل"}, {"id": 5, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "تَجْعَلْنَا", "translit": "āَnْlَʿعْjgَt", "root": "جعل"}, {"id": 8, "arabic": "فِتْنَةً", "translit": "ًẗَnْtِf", "root": "فتن"}, {"id": 9, "arabic": "لِّلْقَوْمِ", "translit": "ِmْwَqْlِّl", "root": "قوم"}, {"id": 10, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 86, "text": "وَنَجِّنَا بِرَحْمَتِكَ مِنَ ٱلْقَوْمِ ٱلْكَٰفِرِينَ ", "translation": "And save us by Your mercy from the disbelieving people.\"", "words": [{"id": 1, "arabic": "وَنَجِّنَا", "translit": "āَnِّjgَnَw", "root": "نجو"}, {"id": 2, "arabic": "بِرَحْمَتِكَ", "translit": "َkِtَmْḥَrِb", "root": "رحم"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 5, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 87, "text": "وَأَوْحَيْنَآ إِلَىٰ مُوسَىٰ وَأَخِيهِ أَن تَبَوَّءَا لِقَوْمِكُمَا بِمِصْرَ بُيُوتًا وَٱجْعَلُوا۟ بُيُوتَكُمْ قِبْلَةً وَأَقِيمُوا۟ ٱلصَّلَوٰةَۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ ", "translation": "And We inspired to Moses and his brother, \"Settle your people in Egypt in houses and make your houses [facing the] qiblah[1] and establish prayer and give good tidings to the believers.\"", "words": [{"id": 1, "arabic": "وَأَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾَw", "root": "وحي"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "وَأَخِيهِ", "translit": "ِhyِhkَaʾَw", "root": "اخو"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَبَوَّءَا", "translit": "āَءَّwَbَt", "root": "بوا"}, {"id": 7, "arabic": "لِقَوْمِكُمَا", "translit": "āَmُkِmْwَqِl", "root": "قوم"}, {"id": 8, "arabic": "بِمِصْرَ", "translit": "َrْṣِmِb", "root": "مصر"}, {"id": 9, "arabic": "بُيُوتًا", "translit": "āًtwُyُb", "root": "بيت"}, {"id": 10, "arabic": "وَٱجْعَلُوا۟", "translit": "۟āwُlَʿعْjgٱَw", "root": "جعل"}, {"id": 11, "arabic": "بُيُوتَكُمْ", "translit": "ْmُkَtwُyُb", "root": "بيت"}, {"id": 12, "arabic": "قِبْلَةً", "translit": "ًẗَlْbِq", "root": "قبل"}, {"id": 13, "arabic": "وَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَw", "root": "قوم"}, {"id": 14, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 15, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 16, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 88, "text": "وَقَالَ مُوسَىٰ رَبَّنَآ إِنَّكَ ءَاتَيْتَ فِرْعَوْنَ وَمَلَأَهُۥ زِينَةً وَأَمْوَٰلًا فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا رَبَّنَا لِيُضِلُّوا۟ عَن سَبِيلِكَۖ رَبَّنَا ٱطْمِسْ عَلَىٰٓ أَمْوَٰلِهِمْ وَٱشْدُدْ عَلَىٰ قُلُوبِهِمْ فَلَا يُؤْمِنُوا۟ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ ", "translation": "And Moses said, \"Our Lord, indeed You have given Pharaoh and his establishment splendor and wealth in the worldly life, our Lord, that they may lead [men] astray from Your way. Our Lord, obliterate their wealth and harden their hearts so that they will not believe until they see the painful punishment.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 3, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 4, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 5, "arabic": "ءَاتَيْتَ", "translit": "َtْyَtāَء", "root": "اتي"}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 7, "arabic": "وَمَلَأَهُۥ", "translit": "ۥُhَaʾَlَmَw", "root": "ملا"}, {"id": 8, "arabic": "زِينَةً", "translit": "ًẗَnyِz", "root": "زين"}, {"id": 9, "arabic": "وَأَمْوَٰلًا", "translit": "āًlَٰwْmَaʾَw", "root": "مول"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 12, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 13, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 14, "arabic": "لِيُضِلُّوا۟", "translit": "۟āwُّlِḍُyِl", "root": "ضلل"}, {"id": 15, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 16, "arabic": "سَبِيلِكَ", "translit": "َkِlyِbَs", "root": "سبل"}, {"id": 17, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 18, "arabic": "ٱطْمِسْ", "translit": "ْsِmْṭٱ", "root": "طمس"}, {"id": 19, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 20, "arabic": "أَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾ", "root": "مول"}, {"id": 21, "arabic": "وَٱشْدُدْ", "translit": "ْdُdْhsٱَw", "root": "شدد"}, {"id": 22, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 23, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 24, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 25, "arabic": "يُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُy", "root": "امن"}, {"id": 26, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 27, "arabic": "يَرَوُا۟", "translit": "۟āُwَrَy", "root": "راي"}, {"id": 28, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 29, "arabic": "ٱلْأَلِيمَ", "translit": "َmyِlَaʾْlٱ", "root": "الم"}], "hasIhya": false}, {"ayah": 89, "text": "قَالَ قَدْ أُجِيبَت دَّعْوَتُكُمَا فَٱسْتَقِيمَا وَلَا تَتَّبِعَآنِّ سَبِيلَ ٱلَّذِينَ لَا يَعْلَمُونَ ", "translation": "[Allāh] said, \"Your supplication has been answered.\"[1] So remain on a right course and follow not the way of those who do not know.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 3, "arabic": "أُجِيبَت", "translit": "tَbyِjgُaʾ", "root": "جوب"}, {"id": 4, "arabic": "دَّعْوَتُكُمَا", "translit": "āَmُkُtَwْʿعَّd", "root": "دعو"}, {"id": 5, "arabic": "فَٱسْتَقِيمَا", "translit": "āَmyِqَtْsٱَf", "root": "قوم"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَتَّبِعَآنِّ", "translit": "ِّnٓāَʿعِbَّtَt", "root": "تبع"}, {"id": 8, "arabic": "سَبِيلَ", "translit": "َlyِbَs", "root": "سبل"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 90, "text": "وَجَٰوَزْنَا بِبَنِىٓ إِسْرَٰٓءِيلَ ٱلْبَحْرَ فَأَتْبَعَهُمْ فِرْعَوْنُ وَجُنُودُهُۥ بَغْيًا وَعَدْوًاۖ حَتَّىٰٓ إِذَآ أَدْرَكَهُ ٱلْغَرَقُ قَالَ ءَامَنتُ أَنَّهُۥ لَآ إِلَٰهَ إِلَّا ٱلَّذِىٓ ءَامَنَتْ بِهِۦ بَنُوٓا۟ إِسْرَٰٓءِيلَ وَأَنَا۠ مِنَ ٱلْمُسْلِمِينَ ", "translation": "And We took the Children of Israel across the sea, and Pharaoh and his soldiers pursued them in tyranny and enmity until, when drowning overtook him, he said, \"I believe that there is no deity except that in whom the Children of Israel believe, and I am of the Muslims.\"", "words": [{"id": 1, "arabic": "وَجَٰوَزْنَا", "translit": "āَnْzَwَٰjgَw", "root": "جوز"}, {"id": 2, "arabic": "بِبَنِىٓ", "translit": "ٓàِnَbِb", "root": "بني"}, {"id": 3, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْبَحْرَ", "translit": "َrْḥَbْlٱ", "root": "بحر"}, {"id": 5, "arabic": "فَأَتْبَعَهُمْ", "translit": "ْmُhَʿعَbْtَaʾَf", "root": "تبع"}, {"id": 6, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 7, "arabic": "وَجُنُودُهُۥ", "translit": "ۥُhُdwُnُjgَw", "root": "جند"}, {"id": 8, "arabic": "بَغْيًا", "translit": "āًyْغَb", "root": "بغي"}, {"id": 9, "arabic": "وَعَدْوًا", "translit": "āًwْdَʿعَw", "root": "عدو"}, {"id": 10, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 11, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 12, "arabic": "أَدْرَكَهُ", "translit": "ُhَkَrْdَaʾ", "root": "درك"}, {"id": 13, "arabic": "ٱلْغَرَقُ", "translit": "ُqَrَغْlٱ", "root": "غرق"}, {"id": 14, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 15, "arabic": "ءَامَنتُ", "translit": "ُtnَmāَء", "root": "امن"}, {"id": 16, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 17, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 18, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 19, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 20, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 21, "arabic": "ءَامَنَتْ", "translit": "ْtَnَmāَء", "root": "امن"}, {"id": 22, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 23, "arabic": "بَنُوٓا۟", "translit": "۟āٓwُnَb", "root": "بني"}, {"id": 24, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 25, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 26, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 27, "arabic": "ٱلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlٱ", "root": "سلم"}], "hasIhya": false}, {"ayah": 91, "text": "ءَآلْـَٰٔنَ وَقَدْ عَصَيْتَ قَبْلُ وَكُنتَ مِنَ ٱلْمُفْسِدِينَ ", "translation": "Now? And you had disobeyed [Him] before and were of the corrupters?", "words": [{"id": 1, "arabic": "ءَآلْـَٰٔنَ", "translit": "َnَٰٔـْlٓāَء", "root": "اون"}, {"id": 2, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 3, "arabic": "عَصَيْتَ", "translit": "َtْyَṣَʿع", "root": "عصي"}, {"id": 4, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 5, "arabic": "وَكُنتَ", "translit": "َtnُkَw", "root": "كون"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 92, "text": "فَٱلْيَوْمَ نُنَجِّيكَ بِبَدَنِكَ لِتَكُونَ لِمَنْ خَلْفَكَ ءَايَةًۚ وَإِنَّ كَثِيرًا مِّنَ ٱلنَّاسِ عَنْ ءَايَٰتِنَا لَغَٰفِلُونَ ", "translation": "So today We will save you in body[1] that you may be to those who succeed you a sign. And indeed, many among the people, of Our signs, are heedless.", "words": [{"id": 1, "arabic": "فَٱلْيَوْمَ", "translit": "َmْwَyْlٱَf", "root": "يوم"}, {"id": 2, "arabic": "نُنَجِّيكَ", "translit": "َkyِّjgَnُn", "root": "نجو"}, {"id": 3, "arabic": "بِبَدَنِكَ", "translit": "َkِnَdَbِb", "root": "بدن"}, {"id": 4, "arabic": "لِتَكُونَ", "translit": "َnwُkَtِl", "root": "كون"}, {"id": 5, "arabic": "لِمَنْ", "translit": "ْnَmِl", "root": ""}, {"id": 6, "arabic": "خَلْفَكَ", "translit": "َkَfْlَhk", "root": "خلف"}, {"id": 7, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 8, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 9, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 12, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 13, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 14, "arabic": "لَغَٰفِلُونَ", "translit": "َnwُlِfَٰغَl", "root": "غفل"}], "hasIhya": false}, {"ayah": 93, "text": "وَلَقَدْ بَوَّأْنَا بَنِىٓ إِسْرَٰٓءِيلَ مُبَوَّأَ صِدْقٍ وَرَزَقْنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ فَمَا ٱخْتَلَفُوا۟ حَتَّىٰ جَآءَهُمُ ٱلْعِلْمُۚ إِنَّ رَبَّكَ يَقْضِى بَيْنَهُمْ يَوْمَ ٱلْقِيَٰمَةِ فِيمَا كَانُوا۟ فِيهِ يَخْتَلِفُونَ ", "translation": "And We had certainly settled the Children of Israel in an agreeable settlement and provided them with good things. And they did not differ until [after] knowledge had come to them. Indeed, your Lord will judge between them on the Day of Resurrection concerning that over which they used to differ.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "بَوَّأْنَا", "translit": "āَnْaʾَّwَb", "root": "بوا"}, {"id": 3, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 4, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 5, "arabic": "مُبَوَّأَ", "translit": "َaʾَّwَbُm", "root": "بوا"}, {"id": 6, "arabic": "صِدْقٍ", "translit": "ٍqْdِṣ", "root": "صدق"}, {"id": 7, "arabic": "وَرَزَقْنَٰهُم", "translit": "mُhَٰnْqَzَrَw", "root": "رزق"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلطَّيِّبَٰتِ", "translit": "ِtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 10, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 11, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 12, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 13, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 14, "arabic": "ٱلْعِلْمُ", "translit": "ُmْlِʿعْlٱ", "root": "علم"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 17, "arabic": "يَقْضِى", "translit": "àِḍْqَy", "root": "قضي"}, {"id": 18, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 19, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 20, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 21, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 22, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 23, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 24, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": false}, {"ayah": 94, "text": "فَإِن كُنتَ فِى شَكٍّ مِّمَّآ أَنزَلْنَآ إِلَيْكَ فَسْـَٔلِ ٱلَّذِينَ يَقْرَءُونَ ٱلْكِتَٰبَ مِن قَبْلِكَۚ لَقَدْ جَآءَكَ ٱلْحَقُّ مِن رَّبِّكَ فَلَا تَكُونَنَّ مِنَ ٱلْمُمْتَرِينَ ", "translation": "So if you are in doubt, [O Muḥammad], about that which We have revealed to you, then ask those who have been reading the Scripture before you. The truth has certainly come to you from your Lord, so never be among the doubters.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 5, "arabic": "مِّمَّآ", "translit": "ٓāَّmِّm", "root": ""}, {"id": 6, "arabic": "أَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾ", "root": "نزل"}, {"id": 7, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "فَسْـَٔلِ", "translit": "ِlَٔـْsَf", "root": "سال"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "يَقْرَءُونَ", "translit": "َnwُءَrْqَy", "root": "قرا"}, {"id": 11, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 14, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 15, "arabic": "جَآءَكَ", "translit": "َkَءٓāَjg", "root": "جيا"}, {"id": 16, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 17, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 18, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 19, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 20, "arabic": "تَكُونَنَّ", "translit": "َّnَnwُkَt", "root": "كون"}, {"id": 21, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 22, "arabic": "ٱلْمُمْتَرِينَ", "translit": "َnyِrَtْmُmْlٱ", "root": "مري"}], "hasIhya": true}, {"ayah": 95, "text": "وَلَا تَكُونَنَّ مِنَ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِ ٱللَّهِ فَتَكُونَ مِنَ ٱلْخَٰسِرِينَ ", "translation": "And never be of those who deny the signs of Allāh and [thus] be among the losers.[1]", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَكُونَنَّ", "translit": "َّnَnwُkَt", "root": "كون"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 6, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "فَتَكُونَ", "translit": "َnwُkَtَf", "root": "كون"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 96, "text": "إِنَّ ٱلَّذِينَ حَقَّتْ عَلَيْهِمْ كَلِمَتُ رَبِّكَ لَا يُؤْمِنُونَ ", "translation": "Indeed, those upon whom the word [i.e., decree] of your Lord has come into effect will not believe,", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "حَقَّتْ", "translit": "ْtَّqَḥ", "root": "حقق"}, {"id": 4, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "كَلِمَتُ", "translit": "ُtَmِlَk", "root": "كلم"}, {"id": 6, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 97, "text": "وَلَوْ جَآءَتْهُمْ كُلُّ ءَايَةٍ حَتَّىٰ يَرَوُا۟ ٱلْعَذَابَ ٱلْأَلِيمَ ", "translation": "Even if every sign should come to them, until they see the painful punishment.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَتْهُمْ", "translit": "ْmُhْtَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 4, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 5, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 6, "arabic": "يَرَوُا۟", "translit": "۟āُwَrَy", "root": "راي"}, {"id": 7, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 8, "arabic": "ٱلْأَلِيمَ", "translit": "َmyِlَaʾْlٱ", "root": "الم"}], "hasIhya": false}, {"ayah": 98, "text": "فَلَوْلَا كَانَتْ قَرْيَةٌ ءَامَنَتْ فَنَفَعَهَآ إِيمَٰنُهَآ إِلَّا قَوْمَ يُونُسَ لَمَّآ ءَامَنُوا۟ كَشَفْنَا عَنْهُمْ عَذَابَ ٱلْخِزْىِ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَمَتَّعْنَٰهُمْ إِلَىٰ حِينٍ ", "translation": "Then has there not been a [single] city that believed so its faith benefited it except the people of Jonah? When they believed, We removed from them the punishment of disgrace in worldly life and gave them enjoyment [i.e., provision] for a time.", "words": [{"id": 1, "arabic": "فَلَوْلَا", "translit": "āَlْwَlَf", "root": ""}, {"id": 2, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 3, "arabic": "قَرْيَةٌ", "translit": "ٌẗَyْrَq", "root": "قري"}, {"id": 4, "arabic": "ءَامَنَتْ", "translit": "ْtَnَmāَء", "root": "امن"}, {"id": 5, "arabic": "فَنَفَعَهَآ", "translit": "ٓāَhَʿعَfَnَf", "root": "نفع"}, {"id": 6, "arabic": "إِيمَٰنُهَآ", "translit": "ٓāَhُnَٰmyِiʾ", "root": "امن"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "قَوْمَ", "translit": "َmْwَq", "root": "قوم"}, {"id": 9, "arabic": "يُونُسَ", "translit": "َsُnwُy", "root": ""}, {"id": 10, "arabic": "لَمَّآ", "translit": "ٓāَّmَl", "root": ""}, {"id": 11, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 12, "arabic": "كَشَفْنَا", "translit": "āَnْfَhsَk", "root": "كشف"}, {"id": 13, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 14, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 15, "arabic": "ٱلْخِزْىِ", "translit": "ِàْzِhkْlٱ", "root": "خزي"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 18, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 19, "arabic": "وَمَتَّعْنَٰهُمْ", "translit": "ْmُhَٰnْʿعَّtَmَw", "root": "متع"}, {"id": 20, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 21, "arabic": "حِينٍ", "translit": "ٍnyِḥ", "root": "حين"}], "hasIhya": false}, {"ayah": 99, "text": "وَلَوْ شَآءَ رَبُّكَ لَءَامَنَ مَن فِى ٱلْأَرْضِ كُلُّهُمْ جَمِيعًاۚ أَفَأَنتَ تُكْرِهُ ٱلنَّاسَ حَتَّىٰ يَكُونُوا۟ مُؤْمِنِينَ ", "translation": "And had your Lord willed, those on earth would have believed - all of them entirely. Then, [O Muḥammad], would you compel the people in order that they become believers?", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "لَءَامَنَ", "translit": "َnَmāَءَl", "root": "امن"}, {"id": 5, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "كُلُّهُمْ", "translit": "ْmُhُّlُk", "root": "كلل"}, {"id": 9, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 10, "arabic": "أَفَأَنتَ", "translit": "َtnَaʾَfَaʾ", "root": ""}, {"id": 11, "arabic": "تُكْرِهُ", "translit": "ُhِrْkُt", "root": "كره"}, {"id": 12, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 13, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 14, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 15, "arabic": "مُؤْمِنِينَ", "translit": "َnyِnِmْwʾُm", "root": "امن"}], "hasIhya": false}, {"ayah": 100, "text": "وَمَا كَانَ لِنَفْسٍ أَن تُؤْمِنَ إِلَّا بِإِذْنِ ٱللَّهِۚ وَيَجْعَلُ ٱلرِّجْسَ عَلَى ٱلَّذِينَ لَا يَعْقِلُونَ ", "translation": "And it is not for a soul [i.e., anyone] to believe except by permission of Allāh, and He will place defilement[1] upon those who will not use reason.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِنَفْسٍ", "translit": "ٍsْfَnِl", "root": "نفس"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تُؤْمِنَ", "translit": "َnِmْwʾُt", "root": "امن"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَيَجْعَلُ", "translit": "ُlَʿعْjgَyَw", "root": "جعل"}, {"id": 10, "arabic": "ٱلرِّجْسَ", "translit": "َsْjgِّrlٱ", "root": "رجس"}, {"id": 11, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 101, "text": "قُلِ ٱنظُرُوا۟ مَاذَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَمَا تُغْنِى ٱلْءَايَٰتُ وَٱلنُّذُرُ عَن قَوْمٍ لَّا يُؤْمِنُونَ ", "translation": "Say, \"Observe what is in the heavens and the earth.\" But of no avail will be signs or warners to a people who do not believe.", "words": [{"id": 1, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 2, "arabic": "ٱنظُرُوا۟", "translit": "۟āwُrُẓnٱ", "root": "نظر"}, {"id": 3, "arabic": "مَاذَا", "translit": "āَhdāَm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "تُغْنِى", "translit": "àِnْغُt", "root": "غني"}, {"id": 9, "arabic": "ٱلْءَايَٰتُ", "translit": "ُtَٰyāَءْlٱ", "root": "ايي"}, {"id": 10, "arabic": "وَٱلنُّذُرُ", "translit": "ُrُhdُّnlٱَw", "root": "نذر"}, {"id": 11, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 12, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 13, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 14, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": true}, {"ayah": 102, "text": "فَهَلْ يَنتَظِرُونَ إِلَّا مِثْلَ أَيَّامِ ٱلَّذِينَ خَلَوْا۟ مِن قَبْلِهِمْۚ قُلْ فَٱنتَظِرُوٓا۟ إِنِّى مَعَكُم مِّنَ ٱلْمُنتَظِرِينَ ", "translation": "So do they wait except for like [what occurred in] the days of those who passed on before them? Say, \"Then wait; indeed, I am with you among those who wait.\"", "words": [{"id": 1, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 2, "arabic": "يَنتَظِرُونَ", "translit": "َnwُrِẓَtnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "مِثْلَ", "translit": "َlْhtِm", "root": "مثل"}, {"id": 5, "arabic": "أَيَّامِ", "translit": "ِmāَّyَaʾ", "root": "يوم"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "خَلَوْا۟", "translit": "۟āْwَlَhk", "root": "خلو"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 10, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 11, "arabic": "فَٱنتَظِرُوٓا۟", "translit": "۟āٓwُrِẓَtnٱَf", "root": "نظر"}, {"id": 12, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 13, "arabic": "مَعَكُم", "translit": "mُkَʿعَm", "root": ""}, {"id": 14, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 15, "arabic": "ٱلْمُنتَظِرِينَ", "translit": "َnyِrِẓَtnُmْlٱ", "root": "نظر"}], "hasIhya": false}, {"ayah": 103, "text": "ثُمَّ نُنَجِّى رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ۚ كَذَٰلِكَ حَقًّا عَلَيْنَا نُنجِ ٱلْمُؤْمِنِينَ ", "translation": "Then We will save Our messengers and those who have believed. Thus, it is an obligation upon Us that We save the believers.[1]", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "نُنَجِّى", "translit": "àِّjgَnُn", "root": "نجو"}, {"id": 3, "arabic": "رُسُلَنَا", "translit": "āَnَlُsُr", "root": "رسل"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 7, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 8, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 9, "arabic": "نُنجِ", "translit": "ِjgnُn", "root": "نجو"}, {"id": 10, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 104, "text": "قُلْ يَٰٓأَيُّهَا ٱلنَّاسُ إِن كُنتُمْ فِى شَكٍّ مِّن دِينِى فَلَآ أَعْبُدُ ٱلَّذِينَ تَعْبُدُونَ مِن دُونِ ٱللَّهِ وَلَٰكِنْ أَعْبُدُ ٱللَّهَ ٱلَّذِى يَتَوَفَّىٰكُمْۖ وَأُمِرْتُ أَنْ أَكُونَ مِنَ ٱلْمُؤْمِنِينَ ", "translation": "Say, [O Muḥammad], \"O people, if you are in doubt as to my religion - then I do not worship those which you worship besides Allāh; but I worship Allāh, who causes your death. And I have been commanded to be of the believers", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 5, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "دِينِى", "translit": "àِnyِd", "root": "دين"}, {"id": 10, "arabic": "فَلَآ", "translit": "ٓāَlَf", "root": ""}, {"id": 11, "arabic": "أَعْبُدُ", "translit": "ُdُbْʿعَaʾ", "root": "عبد"}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَلَٰكِنْ", "translit": "ْnِkَٰlَw", "root": ""}, {"id": 18, "arabic": "أَعْبُدُ", "translit": "ُdُbْʿعَaʾ", "root": "عبد"}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 21, "arabic": "يَتَوَفَّىٰكُمْ", "translit": "ْmُkٰàَّfَwَtَy", "root": "وفي"}, {"id": 22, "arabic": "وَأُمِرْتُ", "translit": "ُtْrِmُaʾَw", "root": "امر"}, {"id": 23, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 24, "arabic": "أَكُونَ", "translit": "َnwُkَaʾ", "root": "كون"}, {"id": 25, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 26, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 105, "text": "وَأَنْ أَقِمْ وَجْهَكَ لِلدِّينِ حَنِيفًا وَلَا تَكُونَنَّ مِنَ ٱلْمُشْرِكِينَ ", "translation": "And [commanded], 'Direct your face [i.e., self] toward the religion, inclining to truth, and never be of those who associate others with Allāh;", "words": [{"id": 1, "arabic": "وَأَنْ", "translit": "ْnَaʾَw", "root": ""}, {"id": 2, "arabic": "أَقِمْ", "translit": "ْmِqَaʾ", "root": "قوم"}, {"id": 3, "arabic": "وَجْهَكَ", "translit": "َkَhْjgَw", "root": "وجه"}, {"id": 4, "arabic": "لِلدِّينِ", "translit": "ِnyِّdlِl", "root": "دين"}, {"id": 5, "arabic": "حَنِيفًا", "translit": "āًfyِnَḥ", "root": "حنف"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَكُونَنَّ", "translit": "َّnَnwُkَt", "root": "كون"}, {"id": 8, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 9, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": false}, {"ayah": 106, "text": "وَلَا تَدْعُ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُكَ وَلَا يَضُرُّكَۖ فَإِن فَعَلْتَ فَإِنَّكَ إِذًا مِّنَ ٱلظَّٰلِمِينَ ", "translation": "And do not invoke[1] besides Allāh that which neither benefits you nor harms you, for if you did, then indeed you would be of the wrongdoers.'\"[2]", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَدْعُ", "translit": "ُʿعْdَt", "root": "دعو"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَنفَعُكَ", "translit": "َkُʿعَfnَy", "root": "نفع"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يَضُرُّكَ", "translit": "َkُّrُḍَy", "root": "ضرر"}, {"id": 11, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 12, "arabic": "فَعَلْتَ", "translit": "َtْlَʿعَf", "root": "فعل"}, {"id": 13, "arabic": "فَإِنَّكَ", "translit": "َkَّnِiʾَf", "root": ""}, {"id": 14, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 15, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 16, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 107, "text": "وَإِن يَمْسَسْكَ ٱللَّهُ بِضُرٍّ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَۖ وَإِن يُرِدْكَ بِخَيْرٍ فَلَا رَآدَّ لِفَضْلِهِۦۚ يُصِيبُ بِهِۦ مَن يَشَآءُ مِنْ عِبَادِهِۦۚ وَهُوَ ٱلْغَفُورُ ٱلرَّحِيمُ ", "translation": "And if Allāh should touch you with adversity, there is no remover of it except Him; and if He intends for you good, then there is no repeller of His bounty. He causes it to reach whom He wills of His servants. And He is the Forgiving, the Merciful.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "يَمْسَسْكَ", "translit": "َkْsَsْmَy", "root": "مسس"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "بِضُرٍّ", "translit": "ٍّrُḍِb", "root": "ضرر"}, {"id": 5, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 6, "arabic": "كَاشِفَ", "translit": "َfِhsāَk", "root": "كشف"}, {"id": 7, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 10, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 11, "arabic": "يُرِدْكَ", "translit": "َkْdِrُy", "root": "رود"}, {"id": 12, "arabic": "بِخَيْرٍ", "translit": "ٍrْyَhkِb", "root": "خير"}, {"id": 13, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 14, "arabic": "رَآدَّ", "translit": "َّdٓāَr", "root": "ردد"}, {"id": 15, "arabic": "لِفَضْلِهِۦ", "translit": "ۦِhِlْḍَfِl", "root": "فضل"}, {"id": 16, "arabic": "يُصِيبُ", "translit": "ُbyِṣُy", "root": "صوب"}, {"id": 17, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 18, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 19, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 20, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 21, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 22, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 23, "arabic": "ٱلْغَفُورُ", "translit": "ُrwُfَغْlٱ", "root": "غفر"}, {"id": 24, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 108, "text": "قُلْ يَٰٓأَيُّهَا ٱلنَّاسُ قَدْ جَآءَكُمُ ٱلْحَقُّ مِن رَّبِّكُمْۖ فَمَنِ ٱهْتَدَىٰ فَإِنَّمَا يَهْتَدِى لِنَفْسِهِۦۖ وَمَن ضَلَّ فَإِنَّمَا يَضِلُّ عَلَيْهَاۖ وَمَآ أَنَا۠ عَلَيْكُم بِوَكِيلٍ ", "translation": "Say, \"O mankind, the truth has come to you from your Lord, so whoever is guided is only guided for [the benefit of] his soul, and whoever goes astray only goes astray [in violation] against it. And I am not over you a manager.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 5, "arabic": "جَآءَكُمُ", "translit": "ُmُkَءٓāَjg", "root": "جيا"}, {"id": 6, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 9, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 10, "arabic": "ٱهْتَدَىٰ", "translit": "ٰàَdَtْhٱ", "root": "هدي"}, {"id": 11, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 12, "arabic": "يَهْتَدِى", "translit": "àِdَtْhَy", "root": "هدي"}, {"id": 13, "arabic": "لِنَفْسِهِۦ", "translit": "ۦِhِsْfَnِl", "root": "نفس"}, {"id": 14, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 15, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 16, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 17, "arabic": "يَضِلُّ", "translit": "ُّlِḍَy", "root": "ضلل"}, {"id": 18, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 19, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 20, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 21, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 22, "arabic": "بِوَكِيلٍ", "translit": "ٍlyِkَwِb", "root": "وكل"}], "hasIhya": false}, {"ayah": 109, "text": "وَٱتَّبِعْ مَا يُوحَىٰٓ إِلَيْكَ وَٱصْبِرْ حَتَّىٰ يَحْكُمَ ٱللَّهُۚ وَهُوَ خَيْرُ ٱلْحَٰكِمِينَ ", "translation": "And follow what is revealed to you, [O Muḥammad], and be patient until Allāh will judge. And He is the best of judges.", "words": [{"id": 1, "arabic": "وَٱتَّبِعْ", "translit": "ْʿعِbَّtٱَw", "root": "تبع"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "وَٱصْبِرْ", "translit": "ْrِbْṣٱَw", "root": "صبر"}, {"id": 6, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 7, "arabic": "يَحْكُمَ", "translit": "َmُkْḥَy", "root": "حكم"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "خَيْرُ", "translit": "ُrْyَhk", "root": "خير"}, {"id": 11, "arabic": "ٱلْحَٰكِمِينَ", "translit": "َnyِmِkَٰḥْlٱ", "root": "حكم"}], "hasIhya": false}], "tafsir": {"3": [{"arabic": "عليه القرآن فلم ينسه ويقرأ من سورة الأعراف هذه الآية إن ربكم الله الذي خلق السموات والأرض في ستة أيام إلى قوله قريب من المحسنين وآخر بني آسرائيل قل ادعوا الله الآيتين فإنه يدخل في شعاره ملك يوكل بحفظه فيستغفر له ويقرأ المعوذتين وينفث بهن في يديه ويمسح بهما وجهه وسائر جسده كذلك روي من فعل رسول الله صلى الله عليه وسلم (1) وليقرأ عشرا من أول الكهف وعشرا من آخرها وهذه الآي للاستيقاظ لقيام الليل وكان علي كرم الله وجهه يقول ما أرى أن رجلا مستكملا عقله ينام قبل أن يقرأ الآيتين من آخر سورة البقرة وليقل خمسا وعشرين مرة سبحان الله والحم", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "لا يفقهون وقال عز وجل يدبر الأمر ما من شفيع إلا من بعد إذنه وكل ما ذكر في القرآن من التوحيد فهو تنبيه على قطع الملاحظة عن الأغيار والتوكل على الواحد القهار وأما الأخبار فقد قال صلى الله عليه وسلم فيما رواه ابن مسعود أريت الأمم في الموسم فرأيت أمتي قد ملأوا السهل والجبل فأعجبتني كثرتهم وهيأتهم فقيل لي أرضيت قلت نعم قيل ومع هؤلاء سبعون ألفا يدخلون الجنة بغير حساب قيل من هم يا رسول الله قال الذين لا يكتوون ولا يتطيرون ولا يسترقون وعلى ربهم يتوكلون فقام عكاشة وقال يا رسول الله ادع الله أن يجعلني منهم فقال رسول", "english": "His protection and His sanctuary, and He is a Wise One who does not fall short in managing the affairs of one who entrusts His management to Him. And He, exalted is He, said: {إِنَّ الَّذِينَ تَدْعُونَ مِن دُونِ اللَّهِ عِبَادٌ أَمْثَالُكُمْ} — \"Indeed, those you call upon besides Allah are servants like yourselves\" — thereby making clear that everything other than Allah, exalted is He, is a subjugated servant, whose need is like your need; so how then can one rely upon him?", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1103", "section_title_en": "Section 1103 — On the First Part Concerning Divine Unity (Tawḥīd) and the Perfection of Trust in Allah", "section_index": 1103, "anchors": "- Root: وكل (W-K-L)\n  * Lisan / Ayn: Core meaning of delegating, entrusting, and appointing another as a deputy or guardian over one's affairs.\n  * Al-Raghib (Mufradat): \"التوكيل: أن تعتمد على غيرك وتجعله نائبا عنك\" — Trust (tawakkul) is to rely upon another and make him a deputy; the true Wakīl is Allah alone, as in {وَكَفَىٰ بِاللَّهِ وَكِيلًا}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"توكل على الله ولا تتكل على غيره\" — reliance on Allah. Metaphorical (majāz): \"وكل همه بكذا\" — one who delegates his care to a thing, implying abandonment by Allah of those who turn to other than Him.\n- Root: عبد (ʿ-B-D)\n  * Lisan / Ayn: Servitude, submission, and humble obedience; the created being as subjugated servant.\n  * Al-Raghib (Mufradat): \"العبودية: إظهار التذلل، والعبادة أبلغ منها\" — servitude is the display of humility; worship is its utmost degree, due only to Allah. All besides Allah are \"عباد أمثالكم\" — servants like yourselves, incapable of independent provision.\n  * Al-Zamakhshari (Asas): Literal: \"عبد بين العبودية\" — a slave bound in servitude. Metaphorical: \"استعبده الطمع\" — greed enslaves a man, just as reliance on creatures enslaves the heart.\n- Root: رسل (R-S-L)\n  * Lisan / Ayn: Sending forth with ease and gentleness; a messenger dispatched with a message.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root is gentle dispatch; the messenger is one sent, and the verse {وَأْمُرْ أَهْلَكَ بِالصَّلَاةِ} is a divine sending of command.\n  * Al-Zamakhshari (Asas): Literal: \"أرسل الله في الأمم رسلا\" — Allah sent messengers to nations. Metaphorical: \"أرسل الله عليهم العذاب\" — Allah loosed punishment upon them, showing His sole agency.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the preposition from its object for rhetorical emphasis, as in \"على ربهم يتوكلون\" where the preposition \"على\" is fronted before its governed noun \"ربهم\" to highlight exclusive reliance, a construction permissible when the clause is semantically complete and the fronting serves emphasis (takhrīṣ).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "6": [{"arabic": "والقرآن مصرح بأن التقوى مفتاح الهداية والكشف وذلك علم من غير تعلم وقال الله تعالى وما خلق الله في السموات والأرض لآيات لقوم يتقون خصصها بهم وقال تعالى {هذا بيان للناس وهدى وموعظة للمتقين} وكان أبو يزيد وغيره يقول ليس العالم الذي يحفظ من كتاب فإذا نسي ما حفظه صار جاهلا إنما العالم الذي يأخذ علمه من ربه أي وقت شاء بلا حفظ ولا درس وهذا هو العلم الرباني وإليه الإشارة بقوله تعالى {وعلمناه من لدنا علما} مع أن كل علم من لدنه ولكن بعضها بوسائط تعليم الخلق فلا يسمى ذلك علما لدنيا بل اللدني الذي ينفتح في سر القلب من غير سبب مألوف من خارج فهذه شواهد النقل ولو جمع كل ما و", "english": "As for the evidences of the Sacred Law, there is His saying (Exalted is He): {«وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا»} (\"And those who strive in Us, We shall surely guide them to Our paths\") (Q. 29:69). So every wisdom that appears from the heart through persevering devotion to worship, without learning, is by way of unveiling and inspiration. And he (peace and blessings be upon him) said: \"Whoever acts upon what he knows, God bequeaths to him knowledge of what he does not know, and grants him success in what he does\" — until he becomes deserving of Paradise. And whoever does not act upon what he knows wanders astray in what he knows and is not granted success in what he does, until he becomes deserving of the Fire. [The hadith \"Whoever acts upon what he knows\" has preceded in the Book of Knowledge, without his saying \"and grants him success in what he does\" — I have not found it with that addition.] And God (Exalted is He) said: {«وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا»} (\"And whoever fears God, He makes for him a way out\") (Q. 65:2) — from perplexities and doubts — {«وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ»} (\"and provides for him from whence he does not reckon\") (Q. 65:3) — teaching him knowledge without learning and granting him discernment without experience. And God (Exalted is He) said: {«يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا»} (\"O you who believe, if you fear God, He will make for you a criterion\") (Q. 8:29) — it is said: a light by which one distinguishes between truth and falsehood and by which one emerges from doubts. For this reason, he (peace and blessings be upon him) was abundant in his supplication in asking for light, saying (peace and blessings be upon him): \"O God, grant me light, and increase me in light, and make for me light in my heart, and light in my grave, and light in my hearing, and light in my sight\" — until he said: \"and light in my hair, and in my skin, and in my flesh, and in my blood, and in my bones.\" [Agreed upon (by al-Bukhari and Muslim).] [The hadith concerning his being asked about His saying {«أَفَمَنْ شَرَحَ اللَّهُ صَدْرَهُ لِلْإِسْلَامِ»} (\"Is he whose breast God has expanded for Islam\") (Q. 39:22) — and in al-Mustadrak from the hadith of Ibn Masʿūd — has preceded in the Book of Knowledge.] And he (peace and blessings be upon him) said concerning Ibn ʿAbbās: \"O God, grant him understanding in religion and teach him the interpretation (taʾwīl).\" [The hadith of ʿAlī: \"We have nothing with us that the Messenger of God (peace and blessings be upon him) confided to us except that God grants a servant understanding in His Book\" — has preceded in the Etiquettes of Qurʾanic Recitation.] And it is said in the interpretation of His saying (Exalted is He): {«يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ»} (\"He grants wisdom to whom He wills\") (Q. 2:269) that it is understanding in the Book of God. And He (Exalted is He) said: {«فَفَهَّمْنَاهَا سُلَيْمَانَ»} (\"And We made Solomon understand it\") (Q. 21:79) — singling out what was unveiled with the name of understanding (fahm). And Abū al-Dardāʾ used to say: \"The believer is one who sees by the light of God from behind a thin veil. By God, it is the truth that God casts into their hearts and causes to flow upon their tongues.\" And some of the Salaf said: \"The believer's conjecture is like soothsaying.\"", "book_title": "Disciplining the Soul", "section_title_ar": "Section 594", "section_title_en": "The Unveiling of Knowledge Through Divine Inspiration and the Evidences of the Unseen", "section_index": 594, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning encompasses both perception of a thing's essence and judgment upon it—knowledge as direct apprehension or discursive ruling.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence (transitive to one object) and judgment upon existence or non-existence (transitive to two objects).\n  * Al-Zamakhshari (Asas): Literal usage denotes certainty and awareness (\"ما علمت بخبرك: ما شعرت به\"); metaphorical extension applies to marks, signs, and beacons of guidance (معالم الطريق) — here, the inspired knowledge is a \"mark\" of the path.\n- Root: كشف (kashafa)\n  * Lisan / Ayn: To remove a covering, unveil, disclose what was hidden.\n  * Al-Raghib (Mufradat): Unveiling (kashf) in theological terms is the removal of the veil (ghishāwah) from the heart such that the realities of things become directly witnessed, not merely inferred.\n  * Al-Zamakhshari (Asas): Literal: to lift a covering from a thing; metaphorical: the disclosure of inward states and hidden matters — the heart's eye perceives what the outward senses cannot.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, devour; farāsah — the lion's pouncing upon its prey.\n  * Al-Raghib (Mufradat): Discernment (farāsah) is a spiritual perception by which the believer penetrates into the inner states of others, a light cast by God into the heart.\n  * Al-Zamakhshari (Asas): Literal: the beast of prey seizing its quarry; metaphorical: the believer's insight seizing the truth of a matter or the hidden state of a person — \"اتقوا فراسة المؤمن فإنه ينظر بنور الله.\"\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: To be new, originate after non-existence; muḥaddath — one who is spoken to, inspired with true speech from the unseen.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence; the muḥaddath is one to whom divine inspiration comes as a new, immediate occurrence without acquired means.\n  * Al-Zamakhshari (Asas): Literal: newness of a thing; metaphorical: \"كان عمر رضي الله عنه محدثا أي صادق الحدس، كأنما حدث بما ظن\" — one whose intuition is so true it is as if he were directly spoken to.\n- Sibawayh Rule: Restriction and specification (الحصر والتقييد) — the particle \"إنما\" and conditional clauses (إن/إذا) restrict predicates to their subjects, as in \"إنما العالم الذي يأخذ علمه من ربه\" — the true scholar is exclusively the one who takes knowledge from his Lord.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "7": [{"arabic": "فقد أخبر الله عنهم إذ قال تعالى ورضوا بالحياة الدنيا واطمأنوا بها والذين هم عن آياتنا غافلون وقال عز وجل ولا تطع من أغفلنا قلبه عن ذكرنا واتبع هواه وكان أمره فرطا وقال تعالى فأعرض عمن تولى عن ذكرنا ولم يرد إلا الحياة الدنيا ذلك مبلغهم من العلم فأحال ذلك كله على الغفلة وعدم العلم ولذلك قال رجل لعيسى عليه السلام احملني معك في سياحتك فقال أخرج مالك والحقني فقال لا أستطيع فقال عيسى عليه السلام بعجب يدخل الغني الجنة أو قال بشدة وقال بعضهم ما من يوم ذر شارقه إلا وأربعة أملاك ينادون في الآفاق بأربعة أصوات ملكان بالمشرق وملكان بالمغرب يقول أحدهم ب", "english": "When it was unveiled to the friends of God (awliyā') — exalted is He — that the servant destroys his own soul by his deeds and his following of his soul's caprice, even as the silkworm destroys itself, they rejected this world (al-dunyā) entirely. Thus al-Hasan said: \"I saw seventy of the Badr veterans who were more ascetic (azhad) among what God made lawful for them than you are among what God made unlawful for you.\" In another wording: \"They were more joyful in affliction than you are in comfort and ease. Had you seen them, you would have said: 'They are mad.' And had they seen your righteous ones, they would have said: 'These have no share of goodness.' And had they seen your wicked ones, they would have said: 'These do not believe in the Day of Reckoning.'\"", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1100", "section_title_en": "The Exposition of the Signs of Asceticism (Zuhd)", "section_index": 1100, "anchors": "- Root: زهد (Z-H-D)\n  * Lisan / Ayn: Core root meaning: scarcity, paucity, and abstention; al-zuhd is also \"estimation\" (al-hazr), as in estimating a palm-crop.\n  * Al-Raghib (Mufradat): \"الزهيد: الشيء القليل\" — the ascetic (al-zāhid) is one who turns away from a thing, content with the little (al-qalīl) of it. Theological nuance: zuhd is not mere abandonment but a reorientation of desire away from the worldly toward the divine.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"زهد في الشيء: رغب عنه\" — to turn one's desire away from a thing. Majaz (metaphorical): \"رجل زهيد: قليل الخير\" — a man of little good; \"اد زهيد\" — a valley that takes little water. Thus, zuhd as a spiritual state is a metaphorical extension of scarcity applied to the heart's attachment.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: The heart (al-qalb); also \"turning/transforming a thing from one face to another\" (taṣrīf al-shay').\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant turning and fluctuation between states; theological nuance: the heart is the seat of volitional orientation, capable of being turned toward or away from God.\n  * Al-Zamakhshari (Asas): Haqiqah: physical overturning. Majaz: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and manages them; thus \"corruption of the heart\" (fasād al-qalb) is a metaphorical overturning of its proper orientation.\n- Root: أنس (A-N-S)\n  * Lisan / Ayn: Sociability, familiarity, intimacy; al-uns is the opposite of loneliness (al-wahshah).\n  * Al-Raghib (Mufradat): The soul's tranquility and familiarity with something; theological nuance: al-uns bi-Allāh is the heart's intimate repose in God, exclusive of all else.\n  * Al-Zamakhshari (Asas): Haqiqah: human companionship. Majaz: intimacy with God as the heart's true companionship, displacing worldly attachment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"إنما مسرة أحدهم معرفة الناس حاله\" restricts delight solely to public recognition, isolating the motive that invalidates claimed zuhd.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "قال تعالى {إن الذين لا يرجون لقاءنا ورضوا بالحياة الدنيا واطمأنوا بها} الآية وقال تعالى {يعلمون ظاهرا من الحياة الدنيا وهم عن الآخرة هم غافلون} وقال عز وجل فأعرض عمن تولى عن ذكرنا ولم يرد إلا الحياة الدنيا ذلك مبلغهم من العلم فالجمع بين كمال الاستبصار في مصالح الدنيا والدين لا يكاد يتيسر إلا لمن رسخه الله لتدبير عباده في معاشهم ومعادهم وهم الأنبياء المؤيدون بروح القدس المستمدون من القوة الإلهية التي تتسع لجميع الأمور ولا تضيق عنها فأما قلوب سائر الخلق فإنها إذا استقلت بأمر الدنيا انصرفت عن الآخرة وقصرت عن الاستك", "english": "They left [the vessels] upon the road — why do you not return them to their places? So they said to him: \"Those vessels are in their places; rather, it is you who cannot find the way, due to your blindness. The wonder of you is that you do not attribute your stumbling to your blindness, but rather attribute it to the shortcoming of another.\" Such is the relation of the religious sciences to the rational sciences.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 588", "section_title_en": "The Heart's Relation to the Divisions of the Rational, Religious, Worldly, and Otherworldly Sciences", "section_index": 588, "anchors": "- Root: عقل (ʿaql)\n  * Lisan / Ayn: The faculty prepared for the reception of knowledge; also the knowledge acquired by that faculty.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — the intellect is the power prepared to receive knowledge, and the knowledge one acquires by that power is also called ʿaql.\n  * Al-Zamakhshari (Asas): Literal: \"ما لفلان مقول، ولا معقول\" — one who has neither speech nor understanding. Metaphorical: \"نخلة لا تعقل الإبار\" — a palm that does not accept pollination, i.e., does not take it in.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; that which is ever-turning and fluctuating.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning of a thing from one state to another; the heart is so named for its constant turning of resolutions and states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems.\n- Root: دنا (danā)\n  * Lisan / Ayn: Nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — nearness by essence or by judgment; the worldly life (al-dunyā) is so named for its nearness and precedence.\n  * Al-Zamakhshari (Asas): Literal: \"هو دنيء من الأدنياء\" — base and contemptible; the dunyā is that which is lower and nearer.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to restrict the predicate exclusively to the subject, as in the Prophetic statement restricting the majority of Paradise's inhabitants to the \"bullah\" (those seemingly foolish in worldly matters).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "10": [{"arabic": "الجنة فقال تعالى وقالوا الحمد لله الذي صدقناه وعده {وقال} وآخر دعواهم أن الحمد لله رب العالمين", "english": "So then, what we have mentioned concerning the treatment of patience (ṣabr) regarding whispered insinuation (waswās), regarding lust (shahwah), and regarding status (jāh) — annex this to what we have already set down concerning the canons of the paths of spiritual striving (mujāhadah) in the Book of the Discipline of the Soul (Kitāb Riyāḍat al-Nafs) from the Quarter of the Destroyers (rubʿ al-muhlikāt). Adopt it as your manual (dastūr) by which you may come to know the treatment of patience in all the categories which we have previously detailed; for the detailing of individual cases is prolix. Whoever observes gradual progression (tadrīj), patience will elevate him to a state wherein patience without it becomes as arduous as it once was with it — so his affairs become inverted, and what was once beloved to him becomes loathed, and what was once detested to him becomes a sweet, wholesome draught from which he cannot bear to be patient [in abstaining]. This is known only through experience (tajribah) and tasting (dhawq). It has an analogue in customary habits: for a boy is compelled to learning in the beginning by force, and so patience with play and patience with knowledge are both arduous for him — until, when his inner sight is opened and he finds intimacy with knowledge, the matter is inverted, and it becomes arduous for him to be patient in abstaining from knowledge, and to endure play. To this points what is narrated of one of the knowers (ʿārifīn) that he asked al-Shiblī: \"Patience — which of its kinds is the most severe?\" He said: \"Patience in God (fī Allāh).\" He said: \"No.\" He said: \"Patience for God (li-Allāh).\" He said: \"No.\" He said: \"Patience with God (maʿa Allāh).\" He said: \"No.\" He said: \"Then what?\" He said: \"Patience from God (ʿan Allāh).\" At that al-Shiblī cried out a cry by which his soul nearly perished. And it has been said concerning the meaning of His saying, the Exalted: {«اصبروا وصابروا ورابطوا»} \"Be patient, and vie in patience, and be steadfast\" (Q. 3:200): \"Be patient in God, vie in patience by God, and be steadfast with God.\" And it was said: \"Patience for God is sufficiency (ghināʾ); patience by God is endurance (baqāʾ); patience with God is fidelity (wafāʾ); and patience from God is abandonment (jafāʾ).\" And it was said concerning its meaning:", "book_title": "Patience and Gratitude", "section_title_ar": "Section 972", "section_title_en": "The Revival of the Religious Sciences — Section 972: On Patience (al-Sabr) and the Commencement of Gratitude (al-Shukr)", "section_index": 972, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; al-Khalil notes its application to holding back an animal from fodder, and to enduring constraint.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — the withholding of the self in constriction; it is a general term whose specific names (shajāʿah, ḥilm, etc.) vary by context, and its opposite is al-jazaʿ (panic/vexation).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — enduring what is disliked and restraining from what is loved. Metaphorical (majāz): \"صبرت يمينه\" — binding an oath strenuously; \"أصبر على الضرب من الأرض\" — more enduring than the earth.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: The root denotes manifestation and fullness; al-Ayn links it to an overflowing udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — the perception of a blessing and its display; it is the opposite of kufr (covering/denial). It has three degrees: of the heart (perception), of the tongue (praise), and of the limbs (requital).\n  * Al-Zamakhshari (Asas): Literal: \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical: \"دابة شكور\" — a beast that thrives on little fodder, displaying its owner's care through its fatness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; al-Ayn treats it under the entry of umm (source/origin), indicating that knowledge is the root to which all else is annexed.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing by its true reality, either by grasping its essence or by affirming/denying a predicate of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to be aware/perceive. It is also used for the landmarks (maʿālim) of the road, i.e., traces by which one is guided.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: The kindling and blazing of fire; al-Ayn records it under the entry of w-q-d with the sense of fuel and flame.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is both the fuel and the resulting flame, as in {«وقودها الناس والحجارة»} (Q. 2:24).\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed fiercely. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقدة الصيف\" — the blazing heat of summer.\n- Sibawayh Rule: Interposition between the operative word and its object (al-faṣl bayna al-ʿāmil wa al-maʿmūl fīhi) — governing the placement of circumstantial qualifiers (ḥāl) and prepositional phrases to preserve the intended semantic restriction, as in the verse \"اصبروا وصابروا ورابطوا\" where each imperative carries a distinct operative scope.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Patience and Gratitude'", "badge": "Du'a"}], "15": [{"arabic": "كلامه فإذا قال إني أخاف إن عصيت ربي عذاب يوم عظيم ولم يكن خائفا كان حاكيا وإذا قال عليك توكلنا وإليك أنبنا وإليك المصير ولم يكن حاله التوكل والإنابة كان حاكيا وإذا قال ولنصبرن على ما آذيتمونا فليكن حاله الصبر أو العزيمة عليه حتى يجد حلاوة التلاوة فإن لم يكن بهذه الصفات ولم يتردد قلبه بين هذه الحالات كان حظه من التلاوة حركة اللسان مع صريح اللعن على نفسه في قوله تعالى إلا لعنة الله على الظالمين وفي قوله تعالى كبر مقتا عند الله أن تقولوا ما لا تفعلون وفي قوله عز وجل وهم في غفلة معرضون وفي قوله فأعر", "english": "And at the mention of God, His attributes, and His names, he bows low in humility before His majesty and in apprehension of His greatness. And at the mention of the disbelievers' sayings — those things impossible for God, Mighty and Majestic, such as their attributing to Him a son or a consort — he lowers his voice and inwardly recoils in shame at the ugliness of their speech. And at the description of Paradise, his innermost being surges forth with longing for it. And at the description of the Fire, his limbs tremble in fear of it. For when the Messenger of God, peace be upon him, said to Ibn Mas'ud, \"Recite to me,\" he said: \"I began reciting Surah al-Nisa'. When I reached {فكيف إذا جئنا من كل أمة بشهيد وجئنا بك على هؤلاء شهيدا} [How then shall it be when We bring from every nation a witness, and We bring you as a witness against these?] (4:41), I saw his two eyes overflowing with tears. He then said to me: 'That is enough for you now.'\" And this was because the witnessing of that very state had wholly overwhelmed his heart.", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 230", "section_title_en": "The States of the Heart During Qur'anic Recitation — The Condition of the True Recieter", "section_index": 230, "anchors": "- Root: وجل (w-j-l)\n  * Lisan / Ayn: Core root meaning of trembling fear, trepidation of the heart\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the inward apprehension of fear; cited in {إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم}\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل وجل، وقوم وجال\" — a man fearful, a people fearful; the state of the heart's trembling before divine majesty\n- Root: وصف (w-ṣ-f)\n  * Lisan / Ayn: Describing a thing by its attributes and qualities\n  * Al-Raghib (Mufradat): \"الوصف: ذكر الشيء بحليته ونعته\" — description is the mention of a thing by its adornment and attribute; may be true or false\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: \"وجهها يصف الحسن\" — metaphorical usage where the face itself \"describes\" beauty; likewise, the tongue may \"describe\" falsehood, as in {ولا تقولوا لما تصف ألسنتكم الكذب}\n- Root: وفي (w-f-y)\n  * Lisan / Ayn: Completeness, fulfillment, reaching full measure\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — that which attains completion; \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — fulfilled the covenant without breach\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" — a full-weight dirham; Metaphorical: \"أوفى على المائة إذا زاد عليها\" — surpassed the hundred\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The separation between the governing preposition and its object by intervening clauses, as in \"فلما بلغت {فكيف إذا جئنا...}\" where the temporal clause governs the narrative sequence", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "17": [{"arabic": "الله تعالى بين من افترى على الله كذبا وبين من كذب بالحق فقال تعالى ومن أظلم ممن افترى على الله كذبا أو كذب بالحق لما جاءه وقال تعالى فمن أظلم ممن كذب على الله وكذب بالصدق إذ جاءه ومنها الرياء وملاحظة الخلق والجهد في استمالة قلوبهم وصرف وجوههم والرياء هو الداء العضال الذي يدعو إلى أكبر الكبائر كما سيأتي في كتاب الرياء والمناظر لا يقصد إلا الظهور عند الخلق وانطلاق ألسنتهم بالثناء عليه فهذه عشر خصال من أمهات الفواحش الباطنة سوى ما يتفق لغير المتماسكين منهم من الخصام المؤدي إلى الضرب", "english": "**QUAD_ANCHORS:**\n- Root: نظر (naẓara)\n  * Lisan / Ayn: Core meaning: to look, to examine, to consider; al-munāẓarah is mutual examination/argumentation between two parties.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as intellectual contemplation (taʾammul bi-l-baṣīrah); munāẓarah as dialectical exchange.\n  * Al-Zamakhshari (Asas): Literal: sitting face-to-face in debate; Metaphorical: disputation for victory.\n- Root: غلب (ghalaba)\n  * Lisan / Ayn: Core meaning: to overcome, to conquer, to prevail.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghalabah as seeking to dominate another in argument.\n  * Al-Zamakhshari (Asas): Literal: victory in combat; Metaphorical: intellectual supremacy.\n- Root: حسد (ḥasada)\n  * Lisan / Ayn: Core meaning: to envy, to wish removal of blessings from another.\n  * Al-Raghib (Mufradat): Theological nuance: envy as wishing deprivation of blessings from the deserving — among the basest traits.\n  * Al-Zamakhshari (Asas): Literal: envy of another's blessing; Metaphorical: consuming fire of the soul.\n- Root: كبر (kabura)\n  * Lisan / Ayn: Core meaning: to be great, to be haughty.\n  * Al-Raghib (Mufradat): Theological nuance: al-kibr as self-elevation above others; condemned by God.\n  * Al-Zamakhshari (Asas): Literal: greatness; Metaphorical: arrogance and pride.\n- Root: غيب (ghāba)\n  * Lisan / Ayn: Core meaning: to be absent, to be hidden.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghībah as mentioning another with what he dislikes in his absence — likened to eating carrion.\n  * Al-Zamakhshari (Asas): Literal: backbiting; Metaphorical: consuming the flesh of one's brother.\n- Root: راءى (rāʾā)\n  * Lisan / Ayn: Core meaning: to show off, to display.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as performing acts for the sake of being seen — hidden shirk.\n  * Al-Zamakhshari (Asas): Literal: showing good deeds; Metaphorical: seeking reputation.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Core meaning: self, soul, spirit.\n  * Al-Raghib (Mufradat): Theological nuance: tazkiyat al-nafs as self-praise and self-purification — forbidden by God.\n  * Al-Zamakhshari (Asas): Literal: self; Metaphorical: self-commendation.\n- Root: حقd (ḥaqida)\n  * Lisan / Ayn: Core meaning: to bear malice, to harbor resentment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ḥiqd as nursing enmity in the heart — negated from the believer.\n  * Al-Zamakhshari (Asas): Literal: bearing grudge; Metaphorical: hidden rancor.\n- Root: نفاق (nifāq)\n  * Lisan / Ayn: Core meaning: hypocrisy, showing contrary to what one conceals.\n  * Al-Raghib (Mufradat): Theological nuance: hypocrisy in deeds — outward display contrary to inward state.\n  * Al-Zamakhshari (Asas): Literal: hypocrisy in faith; Metaphorical: hypocrisy in character.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning: to know, to perceive.\n  * Al-Raghib (Mufradat): Theological nuance: knowledge as apprehension of reality — its pursuit for other than God is destructive.\n  * Al-Zamakhshari (Asas): Literal: knowledge; Metaphorical: the dangerous burden of the scholar.\n- Root: جدل (jadala)\n  * Lisan / Ayn: Core meaning: to argue, to dispute.\n  * Al-Raghib (Mufradat): Theological nuance: al-jidāl as contention; al-mirāʾ as disputation with falsehood — condemned.\n  * Al-Zamakhshari (Asas): Literal: argumentation; Metaphorical: obstinate disputation.\n- Root: شرك (sharaka)\n  * Lisan / Ayn: Core meaning: to associate, to share.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as hidden shirk — associating others with God in intention.\n  * Al-Zamakhshari (Asas): Literal: polytheism; Metaphorical: hidden association in deeds.\n- Root: موت (māta)\n  * Lisan / Ayn: Core meaning: to die.\n  * Al-Raghib (Mufradat): Theological nuance: death as separation of soul from body; spiritual death as ruin of the soul.\n  * Al-Zamakhshari (Asas): Literal: physical death; Metaphorical: spiritual destruction.\n- Root: حيى (ḥayiya)\n  * Lisan / Ayn: Core meaning: to live.\n  * Al-Raghib (Mufradat): Theological nuance: life as the power of perception; eternal life as the reward of the righteous.\n  * Al-Zamakhshari (Asas): Literal: physical life; Metaphorical: spiritual vitality.\n- Root: هلك (halaka)\n  * Lisan / Ayn: Core meaning: to perish, to be destroyed.\n  * Al-Raghib (Mufradat): Theological nuance: al-halāk as ruin; eternal destruction as everlasting punishment.\n  * Al-Zamakhshari (Asas): Literal: destruction; Metaphorical: eternal ruin.\n- Root: رياء (riyāʾ)\n  * Lisan / Ayn: Core meaning: showing off, ostentation.\n  * Al-Raghib (Mufradat): Theological nuance: riyāʾ as the incurable disease calling to the greatest sins.\n  * Al-Zamakhshari (Asas): Literal: ostentation; Metaphorical: spiritual disease.\n- Root: جاه (jāh)\n  * Lisan / Ayn: Core meaning: rank, status, prestige.\n  * Al-Raghib (Mufradat): Theological nuance: love of status (ḥubb al-jāh) among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: position; Metaphorical: seeking prestige.\n- Root: مباهاة (mubāhāh)\n  * Lisan / Ayn: Core meaning: mutual boasting, vying in splendor.\n  * Al-Raghib (Mufradat): Theological nuance: mubāhāh as each seeking to display superiority over the other.\n  * Al-Zamakhshari (Asas): Literal: mutual boasting; Metaphorical: rivalry in honor.\n- Root: مماراة (mumārāh)\n  * Lisan / Ayn: Core meaning: disputation, wrangling.\n  * Al-Raghib (Mufradat): Theological nuance: al-mirāʾ as contentious argument — condemned by the Prophet.\n  * Al-Zamakhshari (Asas): Literal: disputation; Metaphorical: obstinate wrangling.\n- Root: فخر (fakhara)\n  * Lisan / Ayn: Core meaning: to boast, to pride oneself.\n  * Al-Raghib (Mufradat): Theological nuance: al-fakhr as self-glorification — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: boasting; Metaphorical: vainglory.\n- Root: عجب (ʿajiba)\n  * Lisan / Ayn: Core meaning: to wonder, to be amazed.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿujb as self-admiration — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: wonder; Metaphorical: self-conceit.\n- Root: بغض (baghiḍa)\n  * Lisan / Ayn: Core meaning: to hate, to detest.\n  * Al-Raghib (Mufradat): Theological nuance: al-baghdāʾ as mutual hatred — contrary to brotherhood.\n  * Al-Zamakhshari (Asas): Literal: hatred; Metaphorical: mutual enmity.\n- Root: غضب (ghaḍiba)\n  * Lisan / Ayn: Core meaning: to be angry.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaḍab as anger — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: anger; Metaphorical: rage.\n- Root: طمع (ṭamiʿa)\n  * Lisan / Ayn: Core meaning: to covet, to desire.\n  * Al-Raghib (Mufradat): Theological nuance: al-ṭamaʿ as covetousness — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: desire; Metaphorical: greed.\n- Root: أشر (ashira)\n  * Lisan / Ayn: Core meaning: to be exultant, to be insolent.\n  * Al-Raghib (Mufradat): Theological nuance: al-ashar as excessive joy and insolence — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: exultation; Metaphorical: insolence.\n- Root: بطر (baṭira)\n  * Lisan / Ayn: Core meaning: to be arrogant, to be ungrateful.\n  * Al-Raghib (Mufradat): Theological nuance: al-baṭar as arrogance in prosperity — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: arrogance; Metaphorical: ingratitude for blessings.\n- Root: خيلاء (khuyalāʾ)\n  * Lisan / Ayn: Core meaning: pride, haughtiness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khuyalāʾ as pride and conceit — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: pride; Metaphorical: haughty bearing.\n- Root: خشية (khashyah)\n  * Lisan / Ayn: Core meaning: fear, awe.\n  * Al-Raghib (Mufradat): Theological nuance: al-khashyah as reverential fear — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: fear; Metaphorical: reverential awe.\n- Root: رحمة (raḥmah)\n  * Lisan / Ayn: Core meaning: mercy, compassion.\n  * Al-Raghib (Mufradat): Theological nuance: al-raḥmah as tenderness of heart — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: mercy; Metaphorical: compassion.\n- Root: غفلة (ghaflah)\n  * Lisan / Ayn: Core meaning: heedlessness, inattention.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaflah as heedlessness — contrary to vigilance.\n  * Al-Zamakhshari (Asas): Literal: inattention; Metaphorical: spiritual heedlessness.\n- Root: خشوع (khushūʿ)\n  * Lisan / Ayn: Core meaning: humility, submissiveness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khushūʿ as humility — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: humility; Metaphorical: devotional submission.\n- Root: تذكير (tadhkīr)\n  * Lisan / Ayn: Core meaning: reminding, admonishing.\n  * Al-Raghib (Mufradat): Theological nuance: al-tadhkīr as reminding of God — a righteous act.\n  * Al-Zamakhshari (Asas): Literal: reminding; Metaphorical: preaching.\n- Root: وعظ (waʿaẓa)\n  * Lisan / Ayn: Core meaning: to admonish, to exhort.\n  * Al-Raghib (Mufradat): Theological nuance: al-waʿẓ as exhortation to obedience and warning against disobedience.\n  * Al-Zamakhshari (Asas): Literal: admonition; Metaphorical: sermonizing.\n- Root: فتوى (fatwā)\n  * Lisan / Ayn: Core meaning: legal ruling, formal opinion.\n  * Al-Raghib (Mufradat): Theological nuance: al-fatwā as clarification of legal rulings.\n  * Al-Zamakhshari (Asas): Literal: legal opinion; Metaphorical: religious authority.\n- Root: قضاء (qaḍāʾ)\n  * Lisan / Ayn: Core meaning: judgment, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-qaḍāʾ as judgment between people.\n  * Al-Zamakhshari (Asas): Literal: judgment; Metaphorical: judicial authority.\n- Root: وقف (waqafa)\n  * Lisan / Ayn: Core meaning: to stop, to stand.\n  * Al-Raghib (Mufradat): Theological nuance: al-waqf as endowment of property for charitable purposes.\n  * Al-Zamakhshari (Asas): Literal: standing; Metaphorical: religious endowment.\n- Root: ثواب (thawāb)\n  * Lisan / Ayn: Core meaning: reward, recompense.\n  * Al-Raghib (Mufradat): Theological nuance: al-thawāb as divine recompense for righteous deeds.\n  * Al-Zamakhshari (Asas): Literal: reward; Metaphorical: divine recompense.\n- Root: عذاب (ʿadhāb)\n  * Lisan / Ayn: Core meaning: punishment, torment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿadhāb as divine punishment for the disobedient.\n  * Al-Zamakhshari (Asas): Literal: punishment; Metaphorical: divine chastisement.\n- Root: ملك (malaka)\n  * Lisan / Ayn: Core meaning: to possess, to rule.\n  * Al-Raghib (Mufradat): Theological nuance: al-mulk as sovereignty; al-mulk al-muʾabbad as eternal sovereignty in Paradise.\n  * Al-Zamakhshari (Asas): Literal: dominion; Metaphorical: eternal kingdom.\n- Root: نعيم (naʿīm)\n  * Lisan / Ayn: Core meaning: bliss, delight.\n  * Al-Raghib (Mufradat): Theological nuance: al-naʿīm as bliss; al-naʿīm al-sarmad as everlasting bliss.\n  * Al-Zamakhshari (Asas): Literal: delight; Metaphorical: eternal bliss.\n- Root: رخصة (rukhaṣah)\n  * Lisan / Ayn: Core meaning: concession, dispensation.\n  * Al-Raghib (Mufradat): Theological nuance: al-rukhaṣah as legal concession.\n  * Al-Zamakhshari (Asas): Literal: concession; Metaphorical: legal dispensation.\n- Root: رياسة (riyāsah)\n  * Lisan / Ayn: Core meaning: leadership, headship.\n  * Al-Raghib (Mufradat): Theological nuance: love of leadership among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: leadership; Metaphorical: seeking authority.\n- Root: اندراس (indirās)\n  * Lisan / Ayn: Core meaning: effacement, obliteration.\n  * Al-Raghib (Mufradat): Theological nuance: indirās al-ʿulūm as the obliteration of the sciences.\n  * Al-Zamakhshari (Asas): Literal: effacement; Metaphorical: extinction of knowledge.\n- Root: صبيان (ṣibyān)\n  * Lisan / Ayn: Core meaning: boys, children.\n  * Al-Raghib (Mufradat): Theological nuance: children's motivation for learning through play.\n  * Al-Zamakhshari (Asas): Literal: boys; Metaphorical: pupils.\n- Root: مكتب (maktab)\n  * Lisan / Ayn- Root: مكتب (maktab)\n  * Lisan / Ayn: Core meaning: place of instruction, school for boys.\n  * Al-Raghib (Mufradat): Theological nuance: the elementary school where children are taught.\n  * Al-Zamakhshari (Asas): Literal: school; Metaphorical: place of elementary learning.\n- Root: خلاق (khilāq)\n  * Lisan / Ayn: Core meaning: portion, share, lot.\n  * Al-Raghib (Mufradat): Theological nuance: \"no portion\" (lā khilāq) in the Hereafter — utter deprivation of divine reward.\n  * Al-Zamakhshari (Asas): Literal: share; Metaphorical: spiritual allotment in the afterlife.\n- Root: فاجر (fājir)\n  * Lisan / Ayn: Core meaning: wicked, immoral, profligate.\n  * Al-Raghib (Mufradat): Theological nuance: the dissolute one who commits sins openly.\n  * Al-Zamakhshari (Asas): Literal: sinner; Metaphorical: one through whom God nonetheless supports religion.\n- Root: شمع (shamʿ)\n  * Lisan / Ayn: Core meaning: candle, wax taper.\n  * Al-Raghib (Mufradat): Theological nuance: the candle as parable — consuming itself while giving light to others.\n  * Al-Zamakhshari (Asas): Literal: candle; Metaphorical: one who destroys himself but benefits others.\n- Root: نار (nār)\n  * Lisan / Ayn: Core meaning: fire.\n  * Al-Raghib (Mufradat): Theological nuance: fire as parable — consuming itself and all around it.\n  * Al-Zamakhshari (Asas): Literal: fire; Metaphorical: one who destroys himself and others.\n- Root: سعد (saʿida)\n  * Lisan / Ayn: Core meaning: to be fortunate, to prosper.\n  * Al-Raghib (Mufradat): Theological nuance: saʿādah as felicity — success in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: good fortune; Metaphorical: eternal felicity.\n- Root: شقي (shaqiya)\n  * Lisan / Ayn: Core meaning: to be wretched, to be miserable.\n  * Al-Raghib (Mufradat): Theological nuance: shaqāwah as wretchedness — ruin in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: misery; Metaphorical: eternal ruin.\n- Root: أخلص (akhlaṣa)\n  * Lisan / Ayn: Core meaning: to purify, to be sincere.\n  * Al-Raghib (Mufradat): Theological nuance: ikhlāṣ as purifying intention for God alone — the condition of acceptance.\n  * Al-Zamakhshari (Asas): Literal: sincerity; Metaphorical: pure devotion.\n- Root: ريب (rāba)\n  * Lisan / Ayn: Core meaning: to doubt, to suspect.\n  * Al-Raghib (Mufradat): Theological nuance: al-rayb as doubt and uncertainty — to be dispelled by evidence.\n  * Al-Zamakhshari (Asas): Literal: doubt; Metaphorical: skepticism.", "book_title": "Book of Knowledge", "section_title_ar": "Section 39", "section_title_en": "Section 39", "section_index": 39, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Book of Knowledge'", "badge": "Ethics"}], "24": [{"arabic": "في أكفانهم تحت الصعيد إن ملكت واحدا منهم جميع ما طلعت عليه الشمس جعلته حصيدا كأن لم يغن بالأمس تمنى أصحابها سرورا وتعدهم غرورا حتى يأملون كثيرا ويبنون قصورا فتصبح قصورهم قبورا وجمعهم بورا وسعيهم هباء منثورا ودعاؤهم ثبورا هذه صفتها وكان أمر الله قدرا مقدورا والصلاة والسلام على محمد عبده ورسوله المرسل إلى العالمين بشيرا ونذيرا وسراجا منيرا وعلى من كان من أهله وأصحابه له في الدين ظهيرا وعلى الظالمين نصيرا وسلم تسليما كثيرا أما بعد فإن الدنيا عدوة لله وعدوة لأولياء الله وعدوة لأعداء الله أما عداوتها لله فإنها قطعت الطريق على عباد الله ولذلك", "english": "Praise be to God, who made His friends acquainted with the calamitous snares of this world and its afflictions, and uncovered for them its defects and its shameful parts, until they gazed upon its evidences and its signs, and weighed its evil deeds against its good deeds. Thus they came to know that its objectionable aspects exceed its commendable ones, that what is hoped from it does not fulfill what is feared from it, and that its rising is not safe from its eclipse. Yet it is in the likeness of a comely woman who draws people to herself by her beauty — while within her are hidden secrets of evil, ugly things that destroy those who yearn for union with her. Then she is a fleer from her seekers, niggardly in her turning toward them; and when she does turn, one is not secure from her evil and her pestilence. If she does good for an hour, she does evil for a year; and if she does evil once, she makes it her perpetual habit. So the cycles of her turning are ever more tightly drawn, and the commerce of her sons is losing and ruined, and her afflictions in succession strike the breasts of her seekers, and the courses of her states proclaim the humiliation of those who pursue her. Thus every one deluded by her is destined to abasement, and every one who waxes proud through her proceeds to regret. Her very nature is to flee from her seeker and to be sought by the one who flees from her. Whoever serves her, she eludes; whoever turns away from her, she comes to. Her clarity is never free of the admixture of turbidity, nor is her joy ever disentangled from what embitters it. Her soundness bequeaths sickness, her youth drives on to decrepitude, and her bliss bears no fruit but remorse and regret. She is deceitful, guileful, fleeting, evasive. She never ceases adorning herself for her seekers until, when they have become her lovers, she bares her fangs at them, disorders the ordered strands of their affairs, and uncovers for them the hidden store of her wonders — then she makes them taste the lethal poisons and strikes them with the piercing shafts of her arrows. While her companions are in joy and bounty from her, suddenly she turns away from them as though she were but scattered dreams; then she rushes upon them with her calamities, grinds them as grain is ground, and shrouds them in their winding-sheets beneath the dust. If she has possessed one of them with all that the sun has risen upon, she makes him as reaped harvest, as though he had not dwelt in plenty the day before. Her companions desire joy from her, and she promises them delusion — until they hope for much and build palaces, and then their palaces become graves, their gatherings become ruin, their striving becomes scattered dust, and their cry becomes \"Woe and destruction!\" Such is her description — and the command of God is a decree determined. And the prayer and peace be upon Muhammad, His servant and His Messenger, sent to the worlds as a bringer of glad tidings and a warner, and as an illuminating lamp; and upon those of his family and companions who were for him supporters in the religion, and against the wrongdoers helpers; and abundant peace.", "book_title": "Condemnation of the World", "section_title_ar": "Section 729", "section_title_en": "The Book of Condemnation of This World — Being the Sixth Book of the Quarter of the Destructive Things from The Revival of the Religious Sciences", "section_index": 729, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core root meaning of swallowing, devouring, or ingesting wholly\n  * Al-Raghib (Mufradat): الإلهام: casting something into the heart (al-rawʿ), specifically from God or the higher assembly; the root denotes the soul's complete reception, as one who swallows entirely\n  * Al-Zamakhshari (Asas): Literal: ألهمه الله الخير — God cast good into his heart. Metaphorical: جيش لهم — an army that engulfs and swallows whomever enters it\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter\n  * Al-Raghib (Mufradat): الدنو: proximity by essence or by judgment, used of place, time, and station; al-dunyā is the nearer, lower life\n  * Al-Zamakhshari (Asas): Literal: هو دانٍ — he is near. Metaphorical: الأدنى — the inferior, the baser, contrasted with what is better\n- Root: حسر (ḥ-s-r)\n  * Lisan / Ayn: Uncovering, stripping away a covering; exhaustion from exposure of one's strength\n  * Al-Raghib (Mufradat): الحسر: uncovering what veils; al-ḥasīr: one whose strength is laid bare and spent; al-ḥāsir: the weary whose powers are uncovered as exhausted\n  * Al-Zamakhshari (Asas): Literal: حسر عن ذراعيه — he bared his forearms. Metaphorical: فلان كريم المحسر — so-and-so is noble when tested/examined (his hidden quality is uncovered)\n- Root: سرر (s-r-r)\n  * Lisan / Ayn: Concealment, the secret kept hidden in the breast; the innermost\n  * Al-Raghib (Mufradat): الإسرار: opposite of declaration; al-sirr: the speech concealed in the soul\n  * Al-Zamakhshari (Asas): Literal: أسر الحديث — he concealed the speech. Metaphorical: أعطيتك سره — I gave you its choicest essence; هو في سر النسب — he is in the pure core of lineage\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase when the interposed element is complete in itself, as in the rhetorical suspensions of this oration", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of the World'", "badge": "Ethics"}, {"arabic": "حصيدا كأن لم يغن بالأمس تمنى أصحابها سرورا وتعدهم غرورا حتى يأملون كثيرا ويبنون قصورا فتصبح قصورهم قبورا وجمعهم بورا وسعيهم هباء منثورا ودعاؤهم ثبورا هذه صفتها وكان أمر الله قدرا مقدورا والصلاة والسلام على محمد عبده ورسوله المرسل إلى العالمين بشيرا ونذيرا وسراجا منيرا وعلى من كان من أهله وأصحابه له في الدين ظهيرا وعلى الظالمين نصيرا وسلم تسليما كثيرا أما بعد فإن الدنيا عدوة لله وعدوة لأولياء الله وعدوة لأعداء الله أما عداوتها لله فإنها قطعت الطريق على عباد الله ولذل", "english": "Praise be to God, who made His friends acquainted with the calamitous snares of this world and its afflictions, and uncovered for them its defects and its shameful parts, until they gazed upon its evidences and its signs, and weighed its evil deeds against its good deeds. Thus they came to know that its objectionable aspects exceed its commendable ones, that what is hoped from it does not fulfill what is feared from it, and that its rising is not safe from its eclipse. Yet it is in the likeness of a comely woman who draws people to herself by her beauty — while within her are hidden secrets of evil, ugly things that destroy those who yearn for union with her. Then she is a fleer from her seekers, niggardly in her turning toward them; and when she does turn, one is not secure from her evil and her pestilence. If she does good for an hour, she does evil for a year; and if she does evil once, she makes it her perpetual habit. So the cycles of her turning are ever more tightly drawn, and the commerce of her sons is losing and ruined, and her afflictions in succession strike the breasts of her seekers, and the courses of her states proclaim the humiliation of those who pursue her. Thus every one deluded by her is destined to abasement, and every one who waxes proud through her proceeds to regret. Her very nature is to flee from her seeker and to be sought by the one who flees from her. Whoever serves her, she eludes; whoever turns away from her, she comes to. Her clarity is never free of the admixture of turbidity, nor is her joy ever disentangled from what embitters it. Her soundness bequeaths sickness, her youth drives on to decrepitude, and her bliss bears no fruit but remorse and regret. She is deceitful, guileful, fleeting, evasive. She never ceases adorning herself for her seekers until, when they have become her lovers, she bares her fangs at them, disorders the ordered strands of their affairs, and uncovers for them the hidden store of her wonders — then she makes them taste the lethal poisons and strikes them with the piercing shafts of her arrows. While her companions are in joy and bounty from her, suddenly she turns away from them as though she were but scattered dreams; then she rushes upon them with her calamities, grinds them as grain is ground, and shrouds them in their winding-sheets beneath the dust. If she has possessed one of them with all that the sun has risen upon, she makes him as reaped harvest, as though he had not dwelt in plenty the day before. Her companions desire joy from her, and she promises them delusion — until they hope for much and build palaces, and then their palaces become graves, their gatherings become ruin, their striving becomes scattered dust, and their cry becomes \"Woe and destruction!\" Such is her description — and the command of God is a decree determined. And the prayer and peace be upon Muhammad, His servant and His Messenger, sent to the worlds as a bringer of glad tidings and a warner, and as an illuminating lamp; and upon those of his family and companions who were for him supporters in the religion, and against the wrongdoers helpers; and abundant peace.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 729", "section_title_en": "The Book of Condemnation of This World — Being the Sixth Book of the Quarter of the Destructive Things from The Revival of the Religious Sciences", "section_index": 729, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core root meaning of swallowing, devouring, or ingesting wholly\n  * Al-Raghib (Mufradat): الإلهام: casting something into the heart (al-rawʿ), specifically from God or the higher assembly; the root denotes the soul's complete reception, as one who swallows entirely\n  * Al-Zamakhshari (Asas): Literal: ألهمه الله الخير — God cast good into his heart. Metaphorical: جيش لهم — an army that engulfs and swallows whomever enters it\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter\n  * Al-Raghib (Mufradat): الدنو: proximity by essence or by judgment, used of place, time, and station; al-dunyā is the nearer, lower life\n  * Al-Zamakhshari (Asas): Literal: هو دانٍ — he is near. Metaphorical: الأدنى — the inferior, the baser, contrasted with what is better\n- Root: حسر (ḥ-s-r)\n  * Lisan / Ayn: Uncovering, stripping away a covering; exhaustion from exposure of one's strength\n  * Al-Raghib (Mufradat): الحسر: uncovering what veils; al-ḥasīr: one whose strength is laid bare and spent; al-ḥāsir: the weary whose powers are uncovered as exhausted\n  * Al-Zamakhshari (Asas): Literal: حسر عن ذراعيه — he bared his forearms. Metaphorical: فلان كريم المحسر — so-and-so is noble when tested/examined (his hidden quality is uncovered)\n- Root: سرر (s-r-r)\n  * Lisan / Ayn: Concealment, the secret kept hidden in the breast; the innermost\n  * Al-Raghib (Mufradat): الإسرار: opposite of declaration; al-sirr: the speech concealed in the soul\n  * Al-Zamakhshari (Asas): Literal: أسر الحديث — he concealed the speech. Metaphorical: أعطيتك سره — I gave you its choicest essence; هو في سر النسب — he is in the pure core of lineage\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase when the interposed element is complete in itself, as in the rhetorical suspensions of this oration", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "ينقضي العمر حتى إذا أخذت الأرض زخرفها وازينت وظن أهلها أنهم قادرون عليها أتاها أمرنا ليلا أو نهارا فجعلناها حصيدا كأن لم تغن بالأمس فضرب الله تعالى لها مثلا فقال تعالى واضرب لهم مثل الحياة الدنيا كماء أنزلناه من السماء فاختلط به نبات الأرض فأصبح هشيما تذروه الرياح والزهد في الدنيا لما أن كان ملكا حاضرا حسده الشيطان عليه فصده عنه ومعنى الزهد أن يملك العبد شهوته وغضبه فينقادان لباعث الدين وإشارة الإيمان وهذا ملك بالاستحقاق إذ به يصير صاحبه حرا وباستيلاء الشهوة عليه يصير عبدا لفرجه وبطنه وسائر أغراضه فيكون مسخرا مثل البهيمة مملوكا يستجره زمام الشهوة آخذا بمختنقه إلى حيث يريد ويهوى ف", "english": "...anxieties in [worldly] administrations, and likewise all the other means to rank. Then, whenever the means are secured and completed, the lifespan expires — until, when the earth has taken on its ornament and is adorned, and its people suppose that they are able to master it, there comes to it Our command by night or by day, and We make it a harvested stubble as if it had not flourished the day before. Thus God — exalted be He — struck for it a parable, saying — exalted be He: {And strike for them the parable of the life of this world: like water which We send down from the sky, and the vegetation of the earth mingles with it, and then it becomes dry chaff which the winds scatter} {«وَاضْرِبْ لَهُمْ مَثَلَ الْحَيَاةِ الدُّنْيَا كَمَاءٍ أَنْزَلْنَاهُ مِنَ السَّمَاءِ فَاخْتَلَطَ بِهِ نَبَاتُ الْأَرْضِ فَأَصْبَحَ هَشِيمًا تَذْرُوهُ الرِّيَاحُ»} [Al-Kahf: 45]. And asceticism (al-zuhd) in this world — because it was a present sovereignty — Satan envied him for it and barred him from it.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 971", "section_title_en": "On Renouncing Status and the True Meaning of Sovereignty — The Cure for the Love of Prestige", "section_index": 971, "anchors": "- Root: ملك (malaka)\n  * Lisan / Ayn: Core root denotes possession, dominion, and the power to command and forbid; al-Farahidi notes its application to kingship and ownership alike.\n  * Al-Raghib (Mufradat): Distinguishes two modes: (1) actual possession/sovereignty (al-tamalluk wa al-tawallī) and (2) the capacity/power to exercise it (al-quwwah ʿalā dhālika), whether or not one actually rules. True sovereignty belongs to him who governs his own soul.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): ownership of property and dominion over subjects. Metaphorical (majāz): \"he mastered his anger\" (malaka nafsahu ʿinda al-ghadab) — self-mastery as the paradigmatic figurative extension of kingship.\n- Root: عقد (ʿabada)\n  * Lisan / Ayn: Servitude and worship; the slave (ʿabd) is one who is owned and subjugated.\n  * Al-Raghib (Mufradat): ʿUbūdiyyah is the state of being subjugated to another's command; true slavery to passion is the degradation of the rational soul.\n  * Al-Zamakhshari (Asas): Literal: chattel slavery. Metaphorical: he who is led by his lusts is a slave in reality, even if free in legal form.\n- Root: سخر (sakhkhara)\n  * Lisan / Ayn: To subjugate, compel, and employ against one's will; used of beasts and forces pressed into service.\n  * Al-Raghib (Mufradat): Taskhīr is the compelled employment of a thing for another's purpose — the opposite of free, rational agency.\n  * Al-Zamakhshari (Asas): Literal: subjugation of animals. Metaphorical: the man ruled by appetite is musakhkhar — driven like a beast by its halter.\n- Root: دنا (dānā)\n  * Lisan / Ayn: Nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): Al-dunyā (the lower world) is so named for its nearness and lowness relative to the Hereafter; it is the realm of delusion when pursued for its own sake.\n  * Al-Zamakhshari (Asas): Literal: proximity. Metaphorical: the \"nearer\" life as the inferior, contemptible portion.\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The periodic sentence structure here interposes lengthy causal and conditional clauses between the governing verb and its complements, requiring the translator to preserve the logical sequence of protasis and apodosis without collapsing the rhetorical tension of the original.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}, {"arabic": "على القرب وهو كما مثله الله تعالى حيث قال إنما مثل الحياة الدنيا كماء أنزلناه من السماء فاختلط به نبات الأرض الآية وقال تعالى واضرب لهم مثل الحياة الدنيا كماء أنزلناه من السماء إلى قوله فأصبح هشيما تذروه الرياح وكل ما تذروه رياح الموت فهو زهرة الحياة الدنيا وكل ما لا يقطعه الموت فهو الباقيات الصالحات فقد عرفت بهذا أن كمال القدرة بالمال والجاه كمال ظني لا أصل له وأن من قصر الوقت على طلبه وظنه مقصودا فهو جاهل وإليه أشار أبو الطيب بقوله ومن ينفق الساعات في جمع ماله .", "english": "Therefore, the perfections are three, if we count non-change through appetites and non-submission to them as a perfection—like the perfection of knowledge and the perfection of freedom. By \"freedom\" I mean non-enslavement to appetites and to willing worldly causes. The perfection of power for the servant is a path to acquiring the perfection of knowledge and the perfection of freedom, but he has no path to acquiring the perfection of power that endures after his death. For his power over the very substances of wealth and over subjugating hearts and bodies is cut off by death, whereas his knowledge and his freedom are not annihilated by death; rather, they both endure as perfection within him and as a means to nearness to God—may He be exalted.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 800", "section_title_en": "On True Perfection: Knowledge and Freedom Over Power, Wealth, and Status", "section_index": 800, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and enabling; power as capacity to bring about an effect.\n  * Al-Raghib (Mufradat): True power (qudrah) belongs absolutely to God alone; for humans, it is a relative capacity, never absolute, and is a means, not an end.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) power is God's; metaphorical (majaz) attribution of \"power\" to creatures is restricted and conditional, tied to specific acts.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as apprehension of a thing's reality; also traces and signs by which one is guided.\n  * Al-Raghib (Mufradat): Knowledge (ʿilm) is the apprehension of a thing's true nature or the judgment of existence or non-existence regarding it; it is the enduring perfection of the soul.\n  * Al-Zamakhshari (Asas): Literal: \"he knew\" as direct awareness; metaphorical: \"he knew\" as perception or discernment of signs (maʿālim) leading to truth.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of vital functions; also the state of being inanimate or lifeless.\n  * Al-Raghib (Mufradat): Death is the opposite of life; in theological context, it marks the termination of worldly capacities but not of the soul's acquired knowledge or freedom.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: \"death\" of the heart through ignorance or enslavement to passion, and \"revival\" of the land through rain as a similitude for the fleeting world.\n- Sibawayh Rule: Restriction and Focused Predication (الحصر والتقييد بإنما) — Used to confine true perfection exclusively to knowledge and freedom, negating it for power, wealth, and status.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}], "26": [{"arabic": "الله وفي الآخرة الجنة وكذا قوله تعالى {للذين أحسنوا الحسنى وزيادة} وروى البراء بن عازب أنه صلى الله عليه وسلم قال من قال لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير عشر مرات كانت له عدل رقبة أو قال نسمة (1) وروى عمرو بن شعيب عن أبيه عن جده أنه قال قال رسول الله صلى الله عليه وسلم من قال في يوم مائتي مرة لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير لم يسبقه أحد كان قبله ولا يدركه أحد بعده إلا من عمل بأفضل من عمله (2) وقال صلى الله عليه وسلم من قال في س", "english": "The Prophet, peace be upon him, said: \"The most excellent words that I and the prophets before me have uttered are: There is no god but Allah alone, with no partner.\" (1)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 237", "section_title_en": "The Virtue of the Declaration of Divine Oneness (Fāḍīlat al-Tahlīl)", "section_index": 237, "anchors": "- Root: اله (ʾ-l-h)\n  * Lisan / Ayn: Core root denoting worship, servitude, and the act of deifying; the name \"Allah\" is the specific designation of the True Deity, distinguished from all false objects of worship.\n  * Al-Raghib (Mufradat): \"الله: قيل: أصله إله فحذفت همزته، وأدخل عليها الألف واللام، فخص بالباري تعالى\" — The name is exclusively reserved for the Creator, and \"ilāh\" is that which is worshipped; the declaration \"lā ilāha illā Allāh\" negates all false objects of worship and affirms sole divinity for God.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes true worship and servitude; metaphorical (majāz) usage applies to anything taken as an object of devotion. The tahlīl is the verbal embodiment of sincere worship.\n- Root: شرك (sh-r-k)\n  * Lisan / Ayn: Partnership, sharing, or association; in theological context, the ascription of partners or associates to God in His divinity or worship.\n  * Al-Raghib (Mufradat): \"الشركة والمشاركة: خلط الملكين\" — The mixing of two ownerships; in Kalam, shirk is the association of another with God in that which is exclusively His, namely divinity and worship.\n  * Al-Zamakhshari (Asas): Literal usage denotes partnership in ownership; metaphorical usage in the phrase \"lā sharīka lahu\" (no partner has He) affirms God's exclusive and unshared sovereignty, kingdom, and praise.\n- Root: وحد (w-ḥ-d)\n  * Lisan / Ayn: Oneness, uniqueness, singularity; the state of being one without peer or equal.\n  * Al-Raghib (Mufradat): Oneness in essence, attributes, and acts; the tahlīl affirms tawḥīd — the absolute unity of God in His divinity, His sole possession of the kingdom, and His exclusive receipt of praise.\n  * Al-Zamakhshari (Asas): Literal usage denotes numerical oneness; theological usage denotes the affirmation of God's unique and incomparable nature, negating all plurality in His essence and attributes.\n- Sibawayh Rule: Rule of Conjunction and Disjunction (al-ʿAṭf wa al-Faṣl) — The phrase \"lā ilāha illā Allāh\" employs the grammatical structure of negation (lā) followed by exception (illā), establishing a complete disjunction between all false deities and the One True God, followed by the conjunction of His exclusive attributes: \"waḥdahu lā sharīka lahu, lahu al-mulku wa lahu al-ḥamdu.\"", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}], "41": [{"arabic": "أغني عنكم من الله شيئا إن لي عملي ولكم عملكم (3) وقد قال عمر بن الخطاب رضي الله عنه لا يقيم أمر الناس إلا حصيف العقل أريب العقد لا يطلع منه على عورة ولا يخاف منه على حرة ولا تأخذه في الله لومة لائم وقال الأمراء أربعة فأمير قوي ظلف نفسه وعماله فذلك كالمجاهد في سبيل الله يد الله باسطة عليه بالرحمة وأمير فيه ضعف ظلف نفسه وأرتع عماله لضعفه فهو على شفا هلاك إلا أن يرحمه الله وأمير ظلف عماله وأرتع نفسه فذلك الحطمة الذي قال فيه رسول الله صلى الله عليه وسلم شر الرعاة الحطمة فهو الهالك وحده (", "english": "He turned to al-Shaʿbī and said: \"O Abā ʿAmr! I am the trustee of the Commander of the Faithful over Iraq and his governor over it, and a man commanded to obedience. I have been tried with the subjects, and their right has become incumbent upon me. So I love to preserve them and to attend to what sets them right, along with sincere counsel (naṣīḥah) to them. And reports may reach me about a band of people from the regions concerning a matter, and I find myself severe against them therein, so I withhold a portion of their stipends and place it in the treasury (bayt al-māl), with the intention in myself that I shall return it to them. Then it reaches the Commander of the Faithful that I have withheld it in that manner, so he writes to me that I must not return it. I cannot then countermand his order, nor can I execute his letter [against my better judgment]. I am but a man commanded to obedience. Is there any liability upon me in this, and in similar matters, where the intention is as I have described?\"", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 553", "section_title_en": "The Upright Scholars Before the Tyrannical Rulers — Counsel and Fearless Truth-Telling", "section_index": 553, "anchors": "- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning is sincerity, faithfulness, and pure counsel free from deceit; the root denotes the act of seeking the welfare of another with complete integrity.\n  * Al-Raghib (Mufradat): In theological context, naṣīḥah is the obligation of the sincere advisor to guide the ruler toward divine truth, even at personal peril, as it is a form of worship (ʿibādah) and a trust (amānah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes pure honey (ʿasal naṣīḥ) free from admixture; metaphorical (majāz) usage applies to counsel that is untainted by flattery or self-interest.\n- Root: سلط (sulṭ)\n  * Lisan / Ayn: Denotes authority, power, and dominion; the ruler (sulṭān) is one who has been given sway over affairs.\n  * Al-Raghib (Mufradat): In Kalam, sulṭān is a trial (ibtilāʾ) and a trust (amānah) from God, whose exercise demands justice (ʿadl) and whose neglect invites divine wrath.\n  * Al-Zamakhshari (Asas): Literal usage refers to physical power or a governing authority; metaphorical usage extends to the authority of proof (sulṭān al-burhān) that compels assent.\n- Root: عظ (waʿaẓa)\n  * Lisan / Ayn: Root denotes admonition, exhortation, and reminding of consequences; it implies softening the heart through remembrance of God and the Hereafter.\n  * Al-Raghib (Mufradat): In theological terms, ʿiẓah is the act of turning the soul away from transgression through a blend of fear (tarhīb) and hope (targhīb), grounded in revealed truth.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal admonition; metaphorical usage is the admonition of circumstance (ʿiẓah al-ḥāl) when events themselves teach a lesson.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (bāb al-ḥaṣr wa al-taqyīd bi-innamā) — Governing the emphasis of exclusive predication in statements of counsel, such as \"No obedience to a creature in disobedience of the Creator,\" where the restriction (ḥaṣr) is achieved through negation and exception (nafy wa istithnāʾ).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}], "48": [{"arabic": "على الكافرين غير يسير} وقال تعالى {ويقولون متى هذا الوعد إن كنتم صادقين ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون ونفخ في الصور فإذا هم من الأجداث إلى ربهم ينسلون قالوا يا ويلنا من بعثنا من مرقدنا هذا ما وعد الرحمن وصدق المرسلون} فلو لم يكن بين يدي الموتى إلا هول تلك النفخة لكان ذلك جديرا بأن يتقى فإنها نفخة وصيحة يصعق بها من في السموات والأرض يعنى يموتون بها إلا من شاء الله وهو بعض الملائكة ولذلك قال رسول الله صلى الله عليه وسلم كيف أنعم وصاحب الصور قد التقم القرن وحنى الجبهة", "english": "The Prophet (peace and blessings be upon him) said: Allah the Exalted said: \"The son of Adam has reviled Me, and he had no right to revile Me; and he has denied Me, and he had no right to deny Me. As for his reviling of Me, it is his saying that I have a son. And as for his denial of Me, it is his saying: 'He will never bring me back as He created me at first.'\" {«شتمني ابن آدم وما ينبغي له أن يشتمني وكذبني وما ينبغي له أن يكذبني...»}", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1335", "section_title_en": "On the Terrors of the Trumpet-Blast and the Awakening for the Resurrection", "section_index": 1335, "anchors": "- Root: نفخ (N-F-Kh)\n  * Lisan / Ayn: To blow into a thing, to inflate; the breath of wind entering a vessel or body.\n  * Al-Raghib (Mufradat): The divine act of breathing spirit into creation {«ونفخت فيه من روحي»}; here, the eschatological blast that annihilates and then revives all beings.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage of blowing into the Trumpet (الصور); metaphorical extension to the \"blast of spring\" reviving the earth—here applied to the two cosmic blasts of death and resurrection.\n- Root: صور (S-W-R)\n  * Lisan / Ayn: Form, image, shape; also a horn or trumpet (the instrument of the blast).\n  * Al-Raghib (Mufradat): The perceptible form of bodies and the intelligible form of souls; here, the Trumpet (الصور) as the instrument of divine command that re-forms and re-shapes creation.\n  * Al-Zamakhshari (Asas): Literal: the horn (القرن) held by Israfil; metaphorical: the \"inclination\" (صورة) of hearts toward terror and anticipation.\n- Root: موت (M-W-T)\n  * Lisan / Ayn: Death as the cessation of life; the state of the corpse.\n  * Al-Raghib (Mufradat): Death as the separation of the soul from the body; the \"first death\" of the blast and the \"second death\" of the wicked.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: the \"death\" of the heart through heedlessness, and the reviving of dead lands by rain—here, the reviving of bodies by the second blast.\n- Root: قبر (Q-B-R)\n  * Lisan / Ayn: The grave as the abode of the dead; burial.\n  * Al-Raghib (Mufradat): The grave as the intermediate state (barzakh) before resurrection; {«حتى زرتم المقابر»} as a metaphor for death.\n  * Al-Zamakhshari (Asas): Literal: the grave and its inhabitants; metaphorical: the \"raising of the nose\" (قبراه) of the proud—contrasted here with the humility of the dead rising from their graves.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that true faith is not mere verbal assent but heartfelt conviction, as in \"إنما فتور البواطن... لقلة الفهم\" (The languor of the inner selves is only due to the lack of understanding).", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "49": [{"arabic": "علامات المرض وبهذا يعرف أن القلوب كلها مريضة إلا ما شاء الله إلا أن من الأمراض ما لا يعرفها صاحبها ومرض القلب مما لا يعرفه صاحبه فلذلك يغفل عنه وإن عرفه صعب عليه الصبر على مرارة دوائه فإن دواءه مخالفة الشهوات وهو نزع الروح فإن وجد من نفسه قوة الصبر عليه لم يجد طبيبا حاذقا يعالجه فإن الأطباء هم العلماء وقد استولى عليهم المرض فالطبيب المريض قلما يلتفت إلى علاجه فلهذا صار الداء عضالا والمرض مزمنا واندرس هذا العلم وأنكر بالكلية طب القلوب وأنكر مرضها وأقبل الخلق على حب الدنيا وعلى أعمال ظاهرها عبادات وباطنها", "english": "I say: The soul (nafs) that belongs to the human being — that by which he is distinguished from the beasts — for he is not distinguished from them by the power of eating, copulation, sight, or any other such thing. Rather, he is distinguished by the knowledge of things as they truly are. And the Origin of all things, their Existentiator and their Inventor, is God, Mighty and Majestic — He who made them things. So if one knew everything but did not know God, Mighty and Majestic, it would be as though he knew nothing at all. And the sign of knowledge is love: whoever knows God Most High loves Him. And the sign of love is that one does not prefer over Him this world nor any other beloved thing. As God Most High said: {«Say: If your fathers, your sons, your brothers, your spouses, your clans — the wealth you have acquired, commerce whose decline you fear, and dwellings you find pleasing — are more beloved to you than God and His Messenger and striving in His cause, then wait until God brings about His command»} [Q 9:24]. So whoever possesses something more beloved to him than God — his heart is sick. Just as any stomach to which clay has become more beloved than bread and water, or whose appetite for bread and water has fallen away — it is sick. These are the signs of sickness. And by this it is known that all hearts are sick — except what God wills. Yet among sicknesses there are those the sufferer does not recognize; and the sickness of the heart is among those the sufferer does not recognize. For this reason he is heedless of it. And even if he recognized it, patience upon the bitterness of its medicine would be difficult for him — for its medicine is opposing the appetites, and that is the tearing out of the spirit (nafs). And if he found in himself the strength of patience upon it, he would not find a skillful physician to treat him — for the physicians are the scholars, and sickness has overcome them. So the sick physician rarely attends to his own cure. For this reason the malady has become chronic and the sickness chronic. This science has become effaced, and the medicine of hearts is denied entirely, and the sickness of the heart is denied. And creation has turned to the love of this world and to deeds whose outward form is acts of worship but whose inward reality is habit and ostentation. These are the signs of the roots of sicknesses.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 624", "section_title_en": "The Soul's Distinction, the Sickness of the Heart, and the Path of Moderation", "section_index": 624, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that by which a thing is distinguished in its essential reality\n  * Al-Raghib (Mufradat): The soul (nafs) as the principle of rational discrimination and knowledge, distinguishing humans from beasts\n  * Al-Zamakhshari (Asas): Literal: the self or person; Metaphorical: the rational soul as the seat of knowledge and moral responsibility\n- Root: مرض (m-r-d)\n  * Lisan / Ayn: Departure from the state of health and equilibrium\n  * Al-Raghib (Mufradat): Sickness of the heart as a metaphor for moral and spiritual vices — ignorance, cowardice, avarice, hypocrisy\n  * Al-Zamakhshari (Asas): Literal: bodily illness; Metaphorical: spiritual malady whereby the heart inclines toward what is harmful and away from what is beneficial\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; that which is ever-turning and fluctuating between states\n  * Al-Raghib (Mufradat): The heart as the seat of understanding and moral perception; its \"turning\" (taqlīb) signifies its instability between soundness and sickness\n  * Al-Zamakhshari (Asas): Literal: the physical organ; Metaphorical: the spiritual faculty of cognition and moral discernment\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measured, proportioned disposition; character and temperament\n  * Al-Raghib (Mufradat): Moral character as the inward form (ṣūrah bāṭinah) corresponding to the outward physical form\n  * Al-Zamakhshari (Asas): Literal: measuring and proportioning; Metaphorical: the ingrained disposition that governs action\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The use of restrictive constructions to isolate the defining characteristic of the human soul as knowledge of God, not animal appetites", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "55": [{"arabic": "وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدرك مدارك الملوك (4) وقد نبه بهذا على ثمراته في الدنيا ومعلوم أن الآخرة خير وأبقى وقال صلى الله عليه وسلم خصلتان لا يكونان في منافق حسن سمت وفقه في الدين (5) ولا تشكن في الحديث لنفاق بعض فقهاء الزمان فإنه ما أراد به الفقه الذي ظننته وسيأتي معنى الفقه وأدنى درجات الفقيه أن يعلم أن الآخرة خير من الدنيا", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Contemplation", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'", "badge": "Hadith"}], "57": [{"arabic": "الحلال والحرام فهو الضياء والنور وبه النجاة من الغرور وفيه شفاء لما في الصدور ومن خالفه من الجبابرة قصمه الله ومن ابتغى العلم في غيره أضله الله هو حبل الله المتين ونوره المبين والعروة الوثقى والمعتصم الأوفى وهو المحيط بالقليل والكثير والصغير والكبير لا تنقضي عجائبه ولا تتناهى غرائبه لا يحيط بفوائده عند أهل العلم تحديد ولا يخلقه عند أهل التلاوة كثرة الترديد هو الذي أرشد الأولين والآخرين ولما سمعه الجن لم يلبثوا أن ولوا إلى قومهم منذرين {فقالوا إنا سمعنا قرآنا عجبا يهدي إلى الرشد فآمنا به ولن نشرك بربنا أحدا} فكل من آمن به", "english": "Praise be to God, who has bestowed His favor upon His servants through His sent Messenger (peace be upon him) and His revealed Book — falsehood cannot approach it from before it or from behind it; it is a revelation (tanzīl) from the Wise, the Praiseworthy {«تَنْزِيلٌ مِنْ حَكِيمٍ حَمِيدٍ»}. Through it, the path of reflection (iʿtibār) has been widened for the people of understanding, by virtue of what it contains of narratives and reports; and through it, the way of the upright course and the straight path (al-ṣirāṭ al-mustaqīm) has been made clear, by virtue of what it details of rulings and distinguishes between the lawful (ḥalāl) and the unlawful (ḥarām). It is the illumination and the light; through it is deliverance from delusion; in it is healing for what is in the breasts. Whoever opposes it among the tyrants, God crushes him; and whoever seeks knowledge in other than it, God leads him astray. It is the firm rope of God (ḥabl Allāh al-matīn), His manifest light, the trustworthy handhold (al-ʿurwah al-wuthqā), and the most faithful refuge. It encompasses the little and the much, the small and the great. Its wonders do not come to an end, nor do its marvels reach a limit. No delimitation (taḥdīd) encompasses its benefits according to the people of knowledge, nor does the frequency of repetition wear it out according to the people of recitation. It is that which guided the first and the last. When the jinn heard it, they did not delay in turning to their people as warners, saying: {«فَقَالُوا إِنَّا سَمِعْنَا قُرْآنًا عَجَبًا * يَهْدِي إِلَى الرُّشْدِ فَآمَنَّا بِهِ وَلَنْ نُشْرِكَ بِرَبِّنَا أَحَدًا»} (\"Indeed, we have heard a wondrous Quran; it guides to right conduct, so we have believed in it, and we will never associate anyone with our Lord.\") So whoever believes in it has been granted success (tawfīq); whoever speaks by it has spoken truthfully; whoever clings to it has been guided; and whoever acts by it has attained felicity (fawz). And God, the Exalted, says: {«إِنَّا نَحْنُ نَزَّلْنَا الذِّكْرَ وَإِنَّا لَهُ لَحَافِظُونَ»} (\"Indeed, We — it is We who have sent down the Remembrance, and indeed, We are its Preservers.\") Among the means of its preservation (ḥifẓ) in hearts and in codices (maṣāḥif) is the constancy of its recitation (tilāwah) and perseverance in its study, along with the fulfillment of its etiquettes (ādāb) and conditions, and the safeguarding of what it contains of inward works (aʿmāl bāṭinah) and outward etiquettes (ādāb ẓāhirah). This cannot be done without its exposition and detailing; its aims unfold in four chapters (abwāb):", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 220", "section_title_en": "The Book of the Etiquettes of Quran Recitation — Section 220: The Excellence of the Quran and Its People", "section_index": 220, "anchors": "- Root: نزل (n-z-l)\n  * Lisan / Ayn: \"نزل: انحطاط من علو إلى سفل\" — descent from a height to a lower place; the setting down of a thing in a place.\n  * Al-Raghib (Mufradat): \"النزول في الأصل هو انحطاط من علو... وإنزال الله تعالى نعمه ونقمه على الخلق، وإعطاؤهم إياها\" — the descent of the Quran is a divine act of sending down (tanzīl) from the highest station, carrying with it the very mercy and address of God.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"نزل من علو إلى سفل\" — physical descent. Majaz (metaphorical): \"وأنزل الله الغيث، وأنزل الكتاب\" — the \"sending down\" of revelation is a metaphorical extension denoting divine bestowal and elevation of the recipient, not spatial movement.\n- Root: حفظ (ḥ-f-ẓ)\n  * Lisan / Ayn: \"الحفظ: الحِراسة والاستظهار\" — guarding, preserving, and keeping watch over a thing.\n  * Al-Raghib (Mufradat): \"الحفظ: ضبط الشيء عن أن يذهب أو يضيع\" — the securing of a thing against loss or corruption; divine preservation (ḥifẓ) is an act of sovereign care.\n  * Al-Zamakhshari (Asas): Haqiqah: guarding a physical object. Majaz: \"حفظ الله فلانًا\" — divine protection from spiritual harm and error.\n- Root: تلو (t-l-w)\n  * Lisan / Ayn: \"التلاوة: الاتباع، ثم سميت القراءة تلاوة لأنها تتبع الآيات حرفًا حرفًا\" — following in sequence; recitation is so named because the reader follows the verses letter by letter.\n  * Al-Raghib (Mufradat): \"التلاوة: الإتيان بالشيء متتابعًا\" — the bringing of a thing in succession; recitation of the Quran is the sequential utterance of its verses in devotion.\n  * Al-Zamakhshari (Asas): Haqiqah: following behind. Majaz: \"تلا الكتاب\" — reciting, as the tongue follows the written text.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its object by an intervening clause, as in «لا يأتيه الباطل من بين يديه ولا من خلفه», where the prepositional phrases are distributed across the sentence for rhetorical emphasis and comprehensiveness.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Etiquette of Quran Recitation'", "badge": "Ethics"}], "58": [{"arabic": "تعالى {قل بفضل الله وبرحمته فبذلك فليفرحوا} فكأنه ظهر له أنه عند الله مقبول ففرح به الثاني أن يستدل بإظهار الله الجميل وستره القبيح عليه في الدنيا أنه كذلك يفعل في الآخرة إذ قال رسول الله صلى الله عليه وسلم ما ستر الله على عبد ذنبا في الدنيا إلا ستره عليه في الآخرة (1) حديث قال لرجل قال صمت الدهر قال ما صمت ولا أفطرت أخرجه مسلم من حديث أبي قتادة قال عمر يا رسول الله كيف بمن يصوم الدهر قال لا صام ولا أفطر وللطبراني من حديث أسماء بنت يزيد في أثناء حديث فيه فقال رجل إني صائم قال بعض القوم إ", "english": "I say: The knowledgeable servant knows that God has made them aware and has manifested the beautiful aspects of their states, so that they may infer thereby the excellence of God's crafting of them, His regard for them, and His gracious kindness (luṭf) toward them — for He conceals both obedience and disobedience, then God conceals the disobedience and manifests the obedience. And there is no grace greater than concealing the ugly and manifesting the beautiful. Thus their joy is in the beauty of God's regard for them, not in the praise of people nor in the standing it procures in their hearts. God Most High has said: {Say: \"In the bounty of God and His mercy — in that let them rejoice\"} (Yūnus 10:58). It is as though it has become manifest to them that they are accepted before God, so they rejoice in that.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 823", "section_title_en": "On the Sudden Intrusion of Ostentation (Riya') After the Intention of Worship — Its Rulings Before and After Completion", "section_index": 823, "anchors": "- Root: ستر (s-t-r)\n  * Lisan / Ayn: To cover, conceal, screen; the act of veiling something from perception.\n  * Al-Raghib (Mufradat): Divine covering (satr) as an act of divine grace (luṭf) — concealing sin and manifesting obedience is a form of divine favor that draws the servant toward gratitude, not toward pride.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical covering. Metaphorical (majāz): God's veiling of faults in this world and the next, as in the prophetic tradition cited.\n- Root: حبط (ḥ-b-ṭ)\n  * Lisan / Ayn: To become void, nullified, fruitless — said of deeds whose reward is rendered null.\n  * Al-Raghib (Mufradat): Iḥbāṭ in the Quran denotes the nullification of a deed's reward due to a corrupting intention or action, particularly kufr or riyā'.\n  * Al-Zamakhshari (Asas): Literal: a beast dying from overeating (inflating and perishing). Metaphorical: a deed perishing internally despite its outward form.\n- Root: خطر (kh-ṭ-r)\n  * Lisan / Ayn: To cross the mind; a passing thought (khaṭarah).\n  * Al-Raghib (Mufradat): The sudden occurrence of an idea in the heart without deliberate acquisition — distinguished from firm resolve ('azm).\n  * Al-Zamakhshari (Asas): Literal: something that comes and goes. Metaphorical: the fleeting incursion of ostentation into worship.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the scope of riyā' rulings: e.g., \"إنما قال ذلك لأنه أظهره\" restricts the Prophet's rebuke to the case of publicized fasting, not the act itself.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Status and Ostentation'", "badge": "Hadith"}], "61": [{"arabic": "السموات وأنه عالم لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء بل يعلم دبيب النملة السوداء على الصخرة الصماء في الليلة الظلماء ويدرك حركة الذر في جو الهواء ويعلم السر وأخفى ويطلع على هواجس الضمائر وحركات الخواطر وخفيات السرائر بعلم قديم أزلي لم يزل موصوفا به في أزل الآزال لا بعلم متجدد حاصل في ذاته بالحلول والانتقال الإرادة وأنه تعالى مريد للكائنات مدبر للحادثات فلا يجري في الملك والملكوت قليل أو كثير صغير أو كبير خير أو شر نفع أو ضر إيمان أو كفر عرفان أو نكر فوز أو خسران زيادة أو نقصان طاعة أو عصيان إلا بقضا", "english": "- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.", "book_title": "Foundations of Belief", "section_title_ar": "Section 72", "section_title_en": "Section 72", "section_index": 72, "anchors": "*(Anchors established)*", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Foundations of Belief'", "badge": "Commentary"}], "66": [{"arabic": "سلام على إدراسين ومنها المكرر القاطع لوصل الكلام في الظاهر كقوله عز وجل وما يتبع الذين يدعون من دون الله شركاء إن يتبعون إلا الظن وقوله عز وجل قال الملأ الذين استكبروا من قومه للذين استضعفوا لمن آمن منهم معناه الذين استكبروا لمن آمن من الذين استضعفوا ومنها المقدم والمؤخر وهو مظنة الغلط كقوله عز وجل ولولا كلمة سبقت من ربك لكان لزاما وأجل مسمى معناه لولا الكلمة وأجل مسمى لكان لزاما ولولاه لكان نصبا كاللزام وقوله تعالى يسألونك كأنك حفي عنها أي يسألونك عنها كأنك حفي بها وقوله عز وجل لهم مغفرة ورزق كريم كما أخرجك ربك من بيتك بالحق فهذا الكلام غير متصل وإنما هو عائد إلى قوله ا", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Etiquette of Quran Recitation'", "badge": "Ethics"}], "68": [{"arabic": "هل عندكم من سلطان بهذا أي حجة وبرهان وقال تعالى قل فلله الحجة البالغة وقال تعالى ألم تر إلى الذي حاج إبراهيم في ربه إلى قوله فبهت الذي كفر إذ ذكر سبحانه احتجاج إبراهيم ومجادلته وإفحامه خصمه في معرض الثناء عليه وقال عز وجل وتلك حجتنا آتيناها إبراهيم على قومه وقال تعالى قالوا يا نوح قد جادلتنا فأكثرت جدالنا وقال تعالى في قصة فرعون وما رب العالمين إلى قوله أولوا جئتك بشيء مبين وعلى الجملة فالقرآن من أوله إلى آخره محاجة مع الكفار فعمدة أدلة المتكلمين في التوحيد قوله تعالى {", "english": "The mention of the proof (ḥujjah), the demand for it, and the search after it — how could these be prohibited, when God — may He be exalted — has said: {«قُلْ هَاتُوا بُرْهَانَكُمْ»} (Say: Bring forth your proof — Qur'an 2:111), and He — mighty and majestic — has said: {«لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَا مَنْ حَيَّ عَنْ بَيِّنَةٍ»} (So that he who perishes may perish upon clear evidence, and he who lives may live upon clear evidence — Qur'an 8:42), and He — may He be exalted — has said: {«هَلْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا»} (Have you any authority for this? — Qur'an 10:68), meaning a proof and demonstration, and He — may He be exalted — has said: {«قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ»} (Say: To God belongs the conclusive proof — Qur'an 6:149), and He — may He be exalted — has said: {«أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ»} (Have you not considered him who disputed with Abraham concerning his Lord? — Qur'an 2:258) up to His words: {«فَبُهِتَ الَّذِي كَفَرَ»} (So the one who disbelieved was confounded — Qur'an 2:258).", "book_title": "Foundations of Belief", "section_title_ar": "Section 77", "section_title_en": "The Revival of the Religious Sciences — Section 77: On the Permissibility of Theological Discourse (Kalām) and Its Early Practice", "section_index": 77, "anchors": "- Root: ح-د-ث (ḥ-d-th)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not; al-ḥadath: the novel event; al-ḥīdāth: origination.\"\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: a thing's becoming after it was not, whether accident or substance; iḥdāth: bringing it into existence. The origination of substances belongs to God alone.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'He is a recent event among events.' Metaphorical: 'They became topics of conversation (aḥādīth).'\"\n- Root: ح-ا-ج (ḥ-ā-j)\n  * Lisan / Ayn: \"Al-ḥājah: need of a thing, with desire for it; its plural: ḥājāt and ḥawā'ij.\"\n  * Al-Raghib (Mufradat): \"Al-ḥājah ilā al-shay': poverty toward it with love of it. God said: {«إِلَّا حَاجَةً فِي نَفْسِ يَعْقُوبَ»} (except a need in Jacob's soul — Qur'an 12:68).\"\n  * Al-Zamakhshari (Asas): \"Literal: need and want. The 'ḥājah' is that which one seeks to obtain.\"\n- Root: ك-و-ن (k-w-n)\n  * Lisan / Ayn: \"Kāna: to be, to exist; takwīn: bringing into being from non-existence.\"\n  * Al-Raghib (Mufradat): \"Al-kawn: existence after non-existence; the muḥdath (originated thing) is that brought forth after it was not.\"\n  * Al-Zamakhshari (Asas): \"Literal: being and becoming. Metaphorical: the continuous states of affairs.\"\n- Sibawayh Rule: Al-Faṣl bayna al-Jār wa-al-Majrūr (Prepositional Interposition) — The permissibility of separating a preposition from its object when the intervening clause is complete in meaning, as in the verse's structure of argumentation where the proof (ḥujjah) stands independently before its conclusion.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "84": [{"arabic": "بيت من المسلمين ولم يكن بالاتفاق إلا بيت واحد وقال تعالى يا قوم إن كنتم آمنتم بالله فعليه توكلوا إن كنتم مسلمين وقال صلى الله عليه وسلم بني الإسلام على خمس (1) وسئل رسول الله صلى الله عليه وسلم مرة عن الإيمان فأجاب بهذه الخمس (2) وأما الاختلاف فقوله تعالى {قالت الأعراب آمنا قل لم تؤمنوا ولكن قولوا أسلمنا} ومعناه استسلمنا في الظاهر فأراد بالإيمان ههنا التصديق بالقلب فقط وبالإسلام الاستسلام ظاهرا باللسان والجوارح وفي حديث جبرائيل عليه السلام لما سأله عن الإيمان فقال أن تؤمن بالله وملائكته وكتبه ورسله واليوم الآخر وبالبعث بعد الموت وبالحساب وبالقدر خيره وشره ف", "english": "The truth in this matter is that faith (iman) is an expression for assent (tasdiq). God, exalted be He, has said: {وَمَا أَنتَ بِمُؤْمِنٍ لِّنَا} [And you are not one to believe us] (Quran 12:17) — that is, not one to assent to us. And Islam is an expression for surrender (taslim) and self-abandonment (istislam) through acquiescence (idhan) and compliance (inqiyad), and the abandonment of recalcitrance, refusal, obstinacy, and stubbornness.", "book_title": "Foundations of Belief", "section_title_ar": "Section 98", "section_title_en": "On Whether Islam and Faith (Iman) Are Identical or Distinct", "section_index": 98, "anchors": "- Root: أمن (amana)\n  * Lisan / Ayn: Core root denotes safety, security, and freedom from fear; the isti'man form yields 'belief' as an act of granting credence and trust.\n  * Al-Raghib (Mufradat): \"الإيمان هو التصديق\" — Faith (iman) is fundamentally assent (tasdiq), a conviction of the heart, not a mere verbal profession.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage ties iman to tasdiq (verification/assent); metaphorical extension applies it to outward compliance only in a derived sense.\n- Root: سلم (salima)\n  * Lisan / Ayn: Core root denotes soundness, safety, and freedom from defect; the istislam form yields 'submission' as an act of yielding and surrendering.\n  * Al-Raghib (Mufradat): \"الإسلام عبارة عن التسليم والاستسلام\" — Islam is surrender (taslim) and self-abandonment (istislam) through compliance and obedience.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage encompasses outward acts of the limbs; metaphorical (Majaz) usage can extend to inward assent, but the primary domain is the external.\n- Root: صدق (sadaqa)\n  * Lisan / Ayn: Core root denotes truthfulness and veracity in speech and report.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — Truth and falsehood originate in speech; tasdiq is the act of affirming a report as true.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is in verbal confirmation; metaphorical extension applies to 'true in resolve' or 'true in attack,' i.e., confirming through action.\n- Sibawayh Rule: Rule of Interposition (باب الفصل بين الجار والمجرور) — Governing the permissible separation between a governing word and its governed prepositional phrase, relevant here for parsing the conditional and contrastive structures in the theological arguments.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}], "85": [{"arabic": "حسنة وفي الآخرة إنا هدنا إليك ربنا عليك توكلنا وإليك أنبنا وإليك المصير ربنا لا تجعلنا فتنة للقوم الظالمين ربنا لا تجعلنا فتنة للذين كفروا واغفر لنا ربنا إنك أنت العزيز الحكيم ربنا اغفر لنا ذنوبنا وإسرافنا في أمرنا وثبت أقدامنا وانصرنا على القوم الكافرين ربنا اغفر لنا ولإخواننا الذين سبقونا بالإيمان ولا تجعل في قلوبنا غلا للذين آمنوا ربنا إنك رؤوف رحيم ربنا آتنا من لدنك رحمة وهيئ لنا من أمرنا رشدا ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ربنا إننا سمعنا مناديا ينادي للإيمان إلى قوله عز وجل إنك لا تخلف الميعاد ربنا لا تؤاخذنا إن نس", "english": "And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 252", "section_title_en": "Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)", "section_index": 252, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'On Invocations and Supplications'", "badge": "Afterlife"}], "93": [{"arabic": "عالم الغيب والشهادة أنت تحكم بين عبادك فيما كانوا فيه يختلفون اهدني لما اختلف فيه من الحق بإذنك إنك تهدي من تشاء إلى صراط مستقيما (7) ثم يفتتح الصلاة ويصلي ركعتين خفيفتين ثم يصلي مثنى مثنى ما تيسر له ويختم بالوتر إن لم يكن قد صلى الوتر ويستحب أن يفصل بين الصلاتين عند تسليمه بمائة تسبيحة ليستريح ويزيد نشاطه للصلاة وقد صح في صلاة رسول الله صلى الله عليه وسلم بالليل أنه صلى أولا ركعتين خفيفتين ثم ركعتين طويلتين ثم ركعتين دون اللتين قبلهما ثم لم يزل يقصر بالتدريج إلى ثلاث عشرة ركعة (1) وسئلت عائشة رضي الله", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}], "94": [{"arabic": "بما يعرف به الإيمان البالغ فيكم فإن كنتم في شك مما جاء به محمد صلى الله عليه وسلم فائتونا لنبين لكم ولنريكم من النور ما تطمئن إليه قلوبكم والله ما أنتم بالمنقوصة عقولكم فنعذركم إنكم تستبينون صواب الرأي في دنياكم وتأخذون بالحزم في أموركم ما لكم تفرحون باليسير من الدنيا تصيبونه وتحزنون على اليسير منها يفوتكم حتى يتبين ذلك في وجوهكم ويظهر على ألسنتكم وتسمونها المصائب وتقيمون فيها المآتم وعامتكم قد تركوا كثيرا من دينهم ثم لا يتبين ذلك في وجوهكم ولا يتغير حالكم إني لأرى الله قد تبرأ منكم يلقى بعضكم", "english": "And lightning appeared one day, and he began seeking something to which he might take refuge. His eye fell upon a tent from afar, so he approached it — and behold, there was a woman within it. So he turned aside from her, and then there was a cave in a mountain. He came to it — and behold, there was a lion within it. So he placed his hand upon it and said: \"My God, Thou hast made for every thing a refuge, and Thou hast made for me no refuge.\" Then God — exalted be He — revealed to him: \"Thy refuge is in the resting place of My mercy. I shall surely wed thee on the Day of Resurrection to a hundred houris whom I created with My own hand, and I shall surely feed thee at thy wedding-feast for four thousand years — each day of which is like the age of this world — and I shall surely command a herald to proclaim: 'Where are the ascetics of the world? Come visit the wedding-feast of the ascetic of the world, Jesus son of Mary.'\"", "book_title": "Condemnation of the World", "section_title_ar": "Section 732", "section_title_en": "The Revival of the Religious Sciences — Book on the Remembrance of Death: On the Merit of Renouncing the World (Section 732)", "section_index": 732, "anchors": "- Root: برق (b-r-q)\n  * Lisan / Ayn: Core meaning of shining, flashing, and appearing suddenly — from which \"al-barq\" (lightning) derives; also used for that which startles and alarms.\n  * Al-Raghib (Mufradat): Used for sudden manifestation; here, the lightning serves as a natural sign prompting reflection on transience.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) for lightning; metaphorical (majaz) for the fleeting illumination of worldly life that vanishes instantly.\n- Root: زهد (z-h-d)\n  * Lisan / Ayn: To abstain from, to disdain, to regard as little; al-zuhd is the renunciation of something while it remains within one's power.\n  * Al-Raghib (Mufradat): The theological virtue of renouncing the world (al-zuhd fi al-dunya) — not the mere abandonment of wealth, but the emptying of the heart from attachment to it.\n  * Al-Zamakhshari (Asas): Literal: to turn away from a thing with aversion; metaphorical: the soul's disengagement from worldly allurements while the body remains present.\n- Root: عرس (ʿ-r-s)\n  * Lisan / Ayn: Wedding feast; the celebration of union; also used for the bridal chamber.\n  * Al-Raghib (Mufradat): In the eschatological context, the \"wedding\" of the ascetic (al-zāhid) is a divine metaphor for the honor bestowed upon the renunciant in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: a human marriage celebration; metaphorical: the spiritual recompense of intimacy with the Divine.\n- Root: سخط (s-kh-t)\n  * Lisan / Ayn: Displeasure, wrath, indignation; the opposite of ridā (satisfaction).\n  * Al-Raghib (Mufradat): Divine displeasure (sakhat) as the cause of destruction; death by \"wrath\" (sakhtah) signifies a punishment visited upon a people for their disobedience.\n  * Al-Zamakhshari (Asas): Literal: anger; metaphorical: the withdrawal of divine mercy and the sending of chastisement.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of separating a prepositional phrase from its governed noun when the intervening element is semantically complete, as in the narrative transitions between reported speech and action.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of the World'", "badge": "Afterlife"}], "101": [{"arabic": "ملكوت السموات والأرض وبقوله تعالى قل انظروا ماذا في السموات والأرض وبقوله تعالى الذي خلق سبع سموات طباقا ما ترى في خلق الرحمن من تفاوت فارجع البصر هل ترى من فطور ثم ارجع البصر كرتين ينقلب إليك البصر خاسئا وهو حسير وهذا الطريق هو الأسهل على الأكثرين وهو الأوسع على السالكين وإليه أكثر دعوة القرآن عند الأمر بالتدبر والتفكر والاعتبار والنظر في آيات خارجة عن الحصر فإن قلت كلا الطريقين مشكل فأوضح لنا منهما ما يستعان به على تحصيل المعرفة والتوصل به إلى المحبة فاعلم أن الطريق الأعلى هو الاستشهاد بالحق سبحانه على س", "english": "Those who arrive at this rank divide into two groups: the strong, whose first knowledge is of God, exalted be He, and then through Him they come to know other than Him; and the weak, whose first knowledge is of [His] acts, and then they ascend from them to the Agent. To the first points His saying, exalted be He: {أو لم يكف بربك أنه على كل شيء شهيد} [Is it not sufficient concerning your Lord that He is over all things a Witness], and His saying, exalted be He: {«شهد الله أنه لا إله إلا هو»} [God bears witness that there is no god but He]. And of this kind is the saying of one of them, when it was said to him: \"By what have you known your Lord?\" He said: \"I have known my Lord — and were it not for my Lord, I would not have known my Lord.\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1165", "section_title_en": "The Two Paths to Knowledge and Love: The Higher Way of Witnessing the Truth and the Easier Way of Contemplating Creation", "section_index": 1165, "anchors": "- Root: طيب (ṭ-y-b)\n  * Lisan / Ayn: Pure, good, wholesome; free from defilement\n  * Al-Raghib (Mufradat): That which is pure and agreeable in both sensory and intellectual registers; the \"good word\" (al-kalim al-ṭayyib) is the declaration of divine unity\n  * Al-Zamakhshari (Asas): Literal for sensory purity; metaphorical for spiritual purity of heart and speech\n- Root: عرف (ʿ-r-f)\n  * Lisan / Ayn: To know by reflection and discernment of traces/effects\n  * Al-Raghib (Mufradat): Maʿrifah is knowledge of God attained through contemplation of His effects, not through direct apprehension of His essence; it is more specific than ʿilm\n  * Al-Zamakhshari (Asas): Literal: to recognize someone; metaphorical: knowledge of God through His signs\n- Root: شهد (sh-h-d)\n  * Lisan / Ayn: To witness, testify, be present\n  * Al-Raghib (Mufradat): Bearing witness to the truth of something based on direct presence or evidence\n  * Al-Zamakhshari (Asas): Literal: ocular presence; metaphorical: intellectual certitude\n- Root: نظر (n-ẓ-r)\n  * Lisan / Ayn: To look, gaze, contemplate\n  * Al-Raghib (Mufradat): Contemplative reflection (naẓar) directed toward creation to derive knowledge of the Creator\n  * Al-Zamakhshari (Asas): Literal: visual perception; metaphorical: intellectual consideration and inference\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to restrict the purpose of works to purification of the heart, and to restrict the ultimate end to knowledge of unveiling", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 520, 3027], [2, 3027, 3944], [3, 3944, 6200], [4, 6200, 7775], [5, 7775, 9870]], "10:1": [[1, 520, 3027], [2, 3027, 3944], [3, 3944, 6200], [4, 6200, 7775], [5, 7775, 9870]], "2": [[1, 370, 1748], [2, 1748, 3617], [3, 3617, 5007], [4, 5007, 5521], [5, 5521, 8931], [6, 8931, 10118], [7, 10118, 10819], [8, 10819, 12010], [9, 12010, 12524], [10, 12524, 13528], [11, 13528, 15245], [12, 15245, 16763], [13, 16763, 18305], [14, 18305, 21902], [15, 21902, 22696], [16, 22696, 23373], [17, 23373, 24120], [18, 24120, 24996], [19, 24996, 25755], [20, 25755, 26841], [21, 26841, 27985], [22, 27985, 29982], [23, 29982, 30776], [24, 30776, 32042], [25, 32042, 33229], [26, 33229, 34770]], "10:2": [[1, 370, 1748], [2, 1748, 3617], [3, 3617, 5007], [4, 5007, 5521], [5, 5521, 8931], [6, 8931, 10118], [7, 10118, 10819], [8, 10819, 12010], [9, 12010, 12524], [10, 12524, 13528], [11, 13528, 15245], [12, 15245, 16763], [13, 16763, 18305], [14, 18305, 21902], [15, 21902, 22696], [16, 22696, 23373], [17, 23373, 24120], [18, 24120, 24996], [19, 24996, 25755], [20, 25755, 26841], [21, 26841, 27985], [22, 27985, 29982], [23, 29982, 30776], [24, 30776, 32042], [25, 32042, 33229], [26, 33229, 34770]], "3": [[1, 650, 1409], [2, 1409, 2470], [3, 2470, 3363], [4, 3363, 4435], [5, 4435, 5183], [6, 5183, 7182], [7, 7182, 8790], [8, 8790, 9371], [9, 9371, 10186], [10, 10186, 12218], [11, 12218, 12955], [12, 12955, 14681], [13, 14681, 15541], [14, 15541, 16613], [15, 16613, 17986], [16, 17986, 19002], [17, 19002, 19828], [18, 19828, 20275], [19, 20275, 21581], [20, 21581, 22843], [21, 22843, 23290], [22, 23290, 24016], [23, 24016, 24954], [24, 24954, 26066], [25, 26066, 26959], [26, 26959, 28020], [27, 28020, 29784], [28, 29784, 31101], [29, 31101, 32940]], "10:3": [[1, 650, 1409], [2, 1409, 2470], [3, 2470, 3363], [4, 3363, 4435], [5, 4435, 5183], [6, 5183, 7182], [7, 7182, 8790], [8, 8790, 9371], [9, 9371, 10186], [10, 10186, 12218], [11, 12218, 12955], [12, 12955, 14681], [13, 14681, 15541], [14, 15541, 16613], [15, 16613, 17986], [16, 17986, 19002], [17, 19002, 19828], [18, 19828, 20275], [19, 20275, 21581], [20, 21581, 22843], [21, 22843, 23290], [22, 23290, 24016], [23, 24016, 24954], [24, 24954, 26066], [25, 26066, 26959], [26, 26959, 28020], [27, 28020, 29784], [28, 29784, 31101], [29, 31101, 32940]], "4": [[1, 530, 1415], [2, 1415, 2591], [3, 2591, 4163], [4, 4163, 5038], [5, 5038, 5791], [6, 5791, 6901], [7, 6901, 7710], [8, 7710, 9347], [9, 9347, 10232], [10, 10232, 10853], [11, 10853, 12349], [12, 12349, 13723], [13, 13723, 14965], [14, 14965, 16960], [15, 16960, 18983], [16, 18983, 20727], [17, 20727, 21837], [18, 21837, 23531], [19, 23531, 25055], [20, 25055, 25601], [21, 25601, 26711], [22, 26711, 27313], [23, 27313, 28348], [24, 28348, 29938], [25, 29938, 30992], [26, 30992, 31877], [27, 31877, 33721], [28, 33721, 35380]], "10:4": [[1, 530, 1415], [2, 1415, 2591], [3, 2591, 4163], [4, 4163, 5038], [5, 5038, 5791], [6, 5791, 6901], [7, 6901, 7710], [8, 7710, 9347], [9, 9347, 10232], [10, 10232, 10853], [11, 10853, 12349], [12, 12349, 13723], [13, 13723, 14965], [14, 14965, 16960], [15, 16960, 18983], [16, 18983, 20727], [17, 20727, 21837], [18, 21837, 23531], [19, 23531, 25055], [20, 25055, 25601], [21, 25601, 26711], [22, 26711, 27313], [23, 27313, 28348], [24, 28348, 29938], [25, 29938, 30992], [26, 30992, 31877], [2