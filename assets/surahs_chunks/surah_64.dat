": "", "root": ""}, {"id": 13, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 14, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 15, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 16, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 17, "arabic": "قَدِيرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 64, "ayah": 2, "text": "هُوَ اَ۬لذِے خَلَقَكُمْ فَمِنكُمْ كَافِرࣱ وَمِنكُم مُّومِنࣱۖ وَاللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌۖ", "words": [{"id": 1, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "خَلَقَكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَمِنكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَافِرࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمِنكُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّومِنࣱۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تَعْمَلُونَ", "translit": "", "root": ""}, {"id": 11, "arabic": "بَصِيرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 64, "ayah": 3, "text": "خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ بِالْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْۖ وَإِلَيْهِ اِ۬لْمَصِيرُۖ", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَصَوَّرَكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَأَحْسَنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "صُوَرَكُمْۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَإِلَيْهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لْمَصِيرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 64, "ayah": 4, "text": "يَعْلَمُ مَا فِے اِ۬لسَّم