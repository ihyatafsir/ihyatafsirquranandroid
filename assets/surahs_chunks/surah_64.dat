 "arabic": "رَّحِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 64, "ayah": 15, "text": "اِنَّمَآ أَمْوَٰلُكُمْ وَأَوْلَٰدُكُمْ فِتْنَةࣱۖ وَاللَّهُ عِندَهُۥٓ أَجْرٌ عَظِيمࣱۖ", "words": [{"id": 1, "arabic": "اِنَّمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَمْوَٰلُكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَوْلَٰدُكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِتْنَةࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "عِندَهُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَجْرٌ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَظِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 64, "ayah": 16, "text": "فَاتَّقُواْ اُ۬للَّهَ مَا اَ۪سْتَطَعْتُمْ وَاسْمَعُواْ وَأَطِيعُواْ وَأَنفِقُواْ خَيْراࣰ لِّأَنفُسِكُمْۖ وَمَنْ يُّوقَ شُحَّ نَفْسِهِۦ فَأُوْلَٰٓئِكَ هُمُ اُ۬لْمُفْلِحُونَۖ", "words": [{"id": 1, "arabic": "فَاتَّقُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۪سْتَطَعْتُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاسْمَعُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَطِيعُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأَنفِقُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "خَيْراࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "لِّأَنفُسِكُمْۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يُّوقَ", "translit": "", "root": ""}, {"id": 12, "arabic": "شُحَّ", "translit": "", "root": ""}, {"id": 13, "arabic": "نَفْسِهِۦ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 15, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لْمُفْلِحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 64, "ayah": 17, "text": "إِن تُقْرِضُواْ اُ۬للَّهَ قَرْضاً حَسَناࣰ يُضَٰعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْۖ وَاللَّهُ شَكُورٌ حَلِيمٌۖ", "words": [{"id": 1, "arabic": "إِن", "translit": "", "root": ""}, {"id": 2, "arabic": "تُقْرِضُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَرْضاً", "translit": "", "root": ""}, {"id": 5, "arabic": "حَسَناࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُضَٰعِفْهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَيَغْفِرْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَكُمْۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "شَكُورٌ", "translit": "", "root": ""}, {"id": 12, "arabic": "حَلِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 64, "ayah": 18, "text": "عَٰلِمُ اُ۬لْغَيْبِ وَالشَّهَٰدَةِۖ اِ۬لْعَزِيزُ اُ۬لْحَكِيمُۖ", "words": [{"id": 1, "arabic": "عَٰلِمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْغَيْبِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالشَّهَٰدَةِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْحَكِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}]}