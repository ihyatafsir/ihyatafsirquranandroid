{"surah":64,"verses":[{"ayah":1,"text":"يُسَبِّحُ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۖ لَهُ ٱلْمُلْكُ وَلَهُ ٱلْحَمْدُۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ","translation":"Whatever is in the heavens and whatever is on the earth is exalting Allāh.[1] To Him belongs dominion, and to Him belongs [all] praise, and He is over all things competent.","words":[{"id":1,"arabic":"يُسَبِّحُ","translit":"ُḥِّbَsُy","root":"سبح"},{"id":2,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":10,"arabic":"ٱلْمُلْكُ","translit":"ُkْlُmْlٱ","root":"ملك"},{"id":11,"arabic":"وَلَهُ","translit":"ُhَlَw","root":""},{"id":12,"arabic":"ٱلْحَمْدُ","translit":"ُdْmَḥْlٱ","root":"حمد"},{"id":13,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":14,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":15,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":16,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":17,"arabic":"قَدِيرٌ","translit":"ٌryِdَq","root":"قدر"}],"hasIhya":true},{"ayah":2,"text":"هُوَ ٱلَّذِى خَلَقَكُمْ فَمِنكُمْ كَافِرٌ وَمِنكُم مُّؤْمِنٌۚ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ ","translation":"It is He who created you, and among you is the disbeliever, and among you is the believer. And Allāh, of what you do, is Seeing.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"خَلَقَكُمْ","translit":"ْmُkَqَlَhk","root":"خلق"},{"id":4,"arabic":"فَمِنكُمْ","translit":"ْmُknِmَf","root":""},{"id":5,"arabic":"كَافِرٌ","translit":"ٌrِfāَk","root":"كفر"},{"id":6,"arabic":"وَمِنكُم","translit":"mُknِmَw","root":""},{"id":7,"arabic":"مُّؤْمِنٌ","translit":"ٌnِmْwʾُّm","root":"امن"},{"id":8,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":9,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":10,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":11,"arabic":"بَصِيرٌ","translit":"ٌryِṣَb","root":"بصر"}],"hasIhya":false},{"ayah":3,"text":"خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّ وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْۖ وَإِلَيْهِ ٱلْمَصِيرُ ","translation":"He created the heavens and earth in truth and formed you and perfected your forms; and to Him is the [final] destination.","words":[{"id":1,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":2,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":3,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":4,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":5,"arabic":"وَصَوَّرَكُمْ","translit":"ْmُkَrَّwَṣَw","root":"صور"},{"id":6,"arabic":"فَأَحْسَنَ","translit":"َnَsْḥَaʾَf","root":"حسن"},{"id":7,"arabic":"صُوَرَكُمْ","translit":"ْmُkَrَwُṣ","root":"صور"},{"id":8,"arabic":"وَإِلَيْهِ","translit":"ِhْyَlِiʾَw","root":""},{"id":9,"arabic":"ٱلْمَصِيرُ","translit":"ُryِṣَmْlٱ","root":"صير"}],"hasIhya":false},{"ayah":4,"text":"يَعْلَمُ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَيَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَۚ وَٱللَّهُ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ","translation":"He knows what is within the heavens and earth and knows what you conceal and what you declare. And Allāh is Knowing of that within the breasts.","words":[{"id":1,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":6,"arabic":"وَيَعْلَمُ","translit":"ُmَlْʿعَyَw","root":"علم"},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"تُسِرُّونَ","translit":"َnwُّrِsُt","root":"سرر"},{"id":9,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":10,"arabic":"تُعْلِنُونَ","translit":"َnwُnِlْʿعُt","root":"علن"},{"id":11,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":12,"arabic":"عَلِيمٌۢ","translit":"ٌۢmyِlَʿع","root":"علم"},{"id":13,"arabic":"بِذَاتِ","translit":"ِtāَhdِb","root":""},{"id":14,"arabic":"ٱلصُّدُورِ","translit":"ِrwُdُّṣlٱ","root":"صدر"}],"hasIhya":true},{"ayah":5,"text":"أَلَمْ يَأْتِكُمْ نَبَؤُا۟ ٱلَّذِينَ كَفَرُوا۟ مِن قَبْلُ فَذَاقُوا۟ وَبَالَ أَمْرِهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ ","translation":"Has there not come to you the news of those who disbelieved before? So they tasted the bad consequence of their affair, and they will have a painful punishment.","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"يَأْتِكُمْ","translit":"ْmُkِtْaʾَy","root":"اتي"},{"id":3,"arabic":"نَبَؤُا۟","translit":"۟āُwʾَbَn","root":"نبا"},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":8,"arabic":"فَذَاقُوا۟","translit":"۟āwُqāَhdَf","root":"ذوق"},{"id":9,"arabic":"وَبَالَ","translit":"َlāَbَw","root":"وبل"},{"id":10,"arabic":"أَمْرِهِمْ","translit":"ْmِhِrْmَaʾ","root":"امر"},{"id":11,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":12,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":13,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":6,"text":"ذَٰلِكَ بِأَنَّهُۥ كَانَت تَّأْتِيهِمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ فَقَالُوٓا۟ أَبَشَرٌ يَهْدُونَنَا فَكَفَرُوا۟ وَتَوَلَّوا۟ۚ وَّٱسْتَغْنَى ٱللَّهُۚ وَٱللَّهُ غَنِىٌّ حَمِيدٌ ","translation":"That is because their messengers used to come to them with clear evidences, but they said, \"Shall human beings guide us?\" and disbelieved and turned away. And Allāh dispensed [with them]; and Allāh is Free of need and Praiseworthy.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"بِأَنَّهُۥ","translit":"ۥُhَّnَaʾِb","root":""},{"id":3,"arabic":"كَانَت","translit":"tَnāَk","root":"كون"},{"id":4,"arabic":"تَّأْتِيهِمْ","translit":"ْmِhyِtْaʾَّt","root":"اتي"},{"id":5,"arabic":"رُسُلُهُم","translit":"mُhُlُsُr","root":"رسل"},{"id":6,"arabic":"بِٱلْبَيِّنَٰتِ","translit":"ِtَٰnِّyَbْlٱِb","root":"بين"},{"id":7,"arabic":"فَقَالُوٓا۟","translit":"۟āٓwُlāَqَf","root":"قول"},{"id":8,"arabic":"أَبَشَرٌ","translit":"ٌrَhsَbَaʾ","root":"بشر"},{"id":9,"arabic":"يَهْدُونَنَا","translit":"āَnَnwُdْhَy","root":"هدي"},{"id":10,"arabic":"فَكَفَرُوا۟","translit":"۟āwُrَfَkَf","root":"كفر"},{"id":11,"arabic":"وَتَوَلَّوا۟","translit":"۟āwَّlَwَtَw","root":"ولي"},{"id":12,"arabic":"وَّٱسْتَغْنَى","translit":"àَnْغَtْsٱَّw","root":"غني"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":15,"arabic":"غَنِىٌّ","translit":"ٌّàِnَغ","root":"غني"},{"id":16,"arabic":"حَمِيدٌ","translit":"ٌdyِmَḥ","root":"حمد"}],"hasIhya":false},{"ayah":7,"text":"زَعَمَ ٱلَّذِينَ كَفَرُوٓا۟ أَن لَّن يُبْعَثُوا۟ۚ قُلْ بَلَىٰ وَرَبِّى لَتُبْعَثُنَّ ثُمَّ لَتُنَبَّؤُنَّ بِمَا عَمِلْتُمْۚ وَذَٰلِكَ عَلَى ٱللَّهِ يَسِيرٌ ","translation":"Those who disbelieve have claimed that they will never be resurrected. Say, \"Yes, by my Lord, you will surely be resurrected; then you will surely be informed of what you did. And that, for Allāh, is easy.\"","words":[{"id":1,"arabic":"زَعَمَ","translit":"َmَʿعَz","root":"زعم"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوٓا۟","translit":"۟āٓwُrَfَk","root":"كفر"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"لَّن","translit":"nَّl","root":""},{"id":6,"arabic":"يُبْعَثُوا۟","translit":"۟āwُhtَʿعْbُy","root":"بعث"},{"id":7,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":8,"arabic":"بَلَىٰ","translit":"ٰàَlَb","root":""},{"id":9,"arabic":"وَرَبِّى","translit":"àِّbَrَw","root":"ربب"},{"id":10,"arabic":"لَتُبْعَثُنَّ","translit":"َّnُhtَʿعْbُtَl","root":"بعث"},{"id":11,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":12,"arabic":"لَتُنَبَّؤُنَّ","translit":"َّnُwʾَّbَnُtَl","root":"نبا"},{"id":13,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":14,"arabic":"عَمِلْتُمْ","translit":"ْmُtْlِmَʿع","root":"عمل"},{"id":15,"arabic":"وَذَٰلِكَ","translit":"َkِlَٰhdَw","root":""},{"id":16,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"يَسِيرٌ","translit":"ٌryِsَy","root":"يسر"}],"hasIhya":false},{"ayah":8,"text":"فَـَٔامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَٱلنُّورِ ٱلَّذِىٓ أَنزَلْنَاۚ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ ","translation":"So believe in Allāh and His Messenger and the light [i.e., the Qur’ān] which We have sent down. And Allāh is Aware of what you do.","words":[{"id":1,"arabic":"فَـَٔامِنُوا۟","translit":"۟āwُnِmāَٔـَf","root":"امن"},{"id":2,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":3,"arabic":"وَرَسُولِهِۦ","translit":"ۦِhِlwُsَrَw","root":"رسل"},{"id":4,"arabic":"وَٱلنُّورِ","translit":"ِrwُّnlٱَw","root":"نور"},{"id":5,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":6,"arabic":"أَنزَلْنَا","translit":"āَnْlَznَaʾ","root":"نزل"},{"id":7,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":8,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":9,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":10,"arabic":"خَبِيرٌ","translit":"ٌryِbَhk","root":"خبر"}],"hasIhya":false},{"ayah":9,"text":"يَوْمَ يَجْمَعُكُمْ لِيَوْمِ ٱلْجَمْعِۖ ذَٰلِكَ يَوْمُ ٱلتَّغَابُنِۗ وَمَن يُؤْمِنۢ بِٱللَّهِ وَيَعْمَلْ صَٰلِحًا يُكَفِّرْ عَنْهُ سَيِّـَٔاتِهِۦ وَيُدْخِلْهُ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًاۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ ","translation":"The Day He will assemble you for the Day of Assembly - that is the Day of Deprivation.[1] And whoever believes in Allāh and does righteousness - He will remove from him his misdeeds and admit him to gardens beneath which rivers flow, wherein they will abide forever. That is the great attainment.","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"يَجْمَعُكُمْ","translit":"ْmُkُʿعَmْjgَy","root":"جمع"},{"id":3,"arabic":"لِيَوْمِ","translit":"ِmْwَyِl","root":"يوم"},{"id":4,"arabic":"ٱلْجَمْعِ","translit":"ِʿعْmَjgْlٱ","root":"جمع"},{"id":5,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":6,"arabic":"يَوْمُ","translit":"ُmْwَy","root":"يوم"},{"id":7,"arabic":"ٱلتَّغَابُنِ","translit":"ِnُbāَغَّtlٱ","root":"غبن"},{"id":8,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":9,"arabic":"يُؤْمِنۢ","translit":"ۢnِmْwʾُy","root":"امن"},{"id":10,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":11,"arabic":"وَيَعْمَلْ","translit":"ْlَmْʿعَyَw","root":"عمل"},{"id":12,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":13,"arabic":"يُكَفِّرْ","translit":"ْrِّfَkُy","root":"كفر"},{"id":14,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":15,"arabic":"سَيِّـَٔاتِهِۦ","translit":"ۦِhِtāَٔـِّyَs","root":"سوا"},{"id":16,"arabic":"وَيُدْخِلْهُ","translit":"ُhْlِhkْdُyَw","root":"دخل"},{"id":17,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":18,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":19,"arabic":"مِن","translit":"nِm","root":""},{"id":20,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":21,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":22,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":23,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":24,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":25,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":26,"arabic":"ٱلْفَوْزُ","translit":"ُzْwَfْlٱ","root":"فوز"},{"id":27,"arabic":"ٱلْعَظِيمُ","translit":"ُmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":true},{"ayah":10,"text":"وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَٰتِنَآ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِ خَٰلِدِينَ فِيهَاۖ وَبِئْسَ ٱلْمَصِيرُ ","translation":"But the ones who disbelieved and denied Our verses - those are the companions of the Fire, abiding eternally therein; and wretched is the destination.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":3,"arabic":"وَكَذَّبُوا۟","translit":"۟āwُbَّhdَkَw","root":"كذب"},{"id":4,"arabic":"بِـَٔايَٰتِنَآ","translit":"ٓāَnِtَٰyāَٔـِb","root":"ايي"},{"id":5,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":6,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":7,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":8,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":9,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":10,"arabic":"وَبِئْسَ","translit":"َsْyʾِbَw","root":"باس"},{"id":11,"arabic":"ٱلْمَصِيرُ","translit":"ُryِṣَmْlٱ","root":"صير"}],"hasIhya":false},{"ayah":11,"text":"مَآ أَصَابَ مِن مُّصِيبَةٍ إِلَّا بِإِذْنِ ٱللَّهِۗ وَمَن يُؤْمِنۢ بِٱللَّهِ يَهْدِ قَلْبَهُۥۚ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ ","translation":"No disaster strikes except by permission of Allāh. And whoever believes in Allāh - He will guide his heart. And Allāh is Knowing of all things.","words":[{"id":1,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":2,"arabic":"أَصَابَ","translit":"َbāَṣَaʾ","root":"صوب"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"مُّصِيبَةٍ","translit":"ٍẗَbyِṣُّm","root":"صوب"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"بِإِذْنِ","translit":"ِnْhdِiʾِb","root":"اذن"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"و