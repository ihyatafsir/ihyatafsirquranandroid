"ayah": 6, "text": "ذَٰلِكَ بِأَنَّهُۥ كَانَت تَّاتِيهِمْ رُسُلُهُم بِالْبَيِّنَٰتِ فَقَالُوٓاْ أَبَشَرࣱ يَهْدُونَنَاۖ فَكَفَرُواْ وَتَوَلَّواْ وَّاسْتَغْنَي اَ۬للَّهُۖ وَاللَّهُ غَنِيٌّ حَمِيدࣱۖ", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَت", "translit": "", "root": ""}, {"id": 4, "arabic": "تَّاتِيهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "رُسُلُهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالْبَيِّنَٰتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَبَشَرࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَهْدُونَنَاۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَكَفَرُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَتَوَلَّواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَّاسْتَغْنَي", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 15, "arabic": "غَنِيٌّ", "translit": "", "root": ""}, {"id": 16, "arabic": "حَمِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 64, "ayah": 7, "text": "۞زَعَمَ اَ۬لذِينَ كَفَرُوٓاْ أَن لَّنْ يُّبْعَثُواْۖ قُلْ بَل۪يٰ وَرَبِّے لَتُبْعَثُنَّ ثُمَّ لَتُنَبَّؤُنَّ بِمَا عَمِلْتُمْۖ وَذَٰلِكَ عَلَي اَ۬للَّهِ يَسِيرࣱۖ", "words": [{"id": 1, "arabic": "۞زَعَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُّبْعَثُواْۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 8, "arabic": "بَل۪يٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَرَبِّے", "translit": "", "root": "