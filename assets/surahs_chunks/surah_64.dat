"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":6,"arabic":"وَعَلَى","translit":"àَlَʿعَw","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"فَلْيَتَوَكَّلِ","translit":"ِlَّkَwَtَyْlَf","root":"وكل"},{"id":9,"arabic":"ٱلْمُؤْمِنُونَ","translit":"َnwُnِmْwʾُmْlٱ","root":"امن"}],"hasIhya":false},{"ayah":14,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ مِنْ أَزْوَٰجِكُمْ وَأَوْلَٰدِكُمْ عَدُوًّا لَّكُمْ فَٱحْذَرُوهُمْۚ وَإِن تَعْفُوا۟ وَتَصْفَحُوا۟ وَتَغْفِرُوا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ","translation":"O you who have believed, indeed, among your spouses and your children are enemies to you, so beware of them. But if you pardon and overlook and forgive - then indeed, Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":4,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":5,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":6,"arabic":"أَزْوَٰجِكُمْ","translit":"ْmُkِjgَٰwْzَaʾ","root":"زوج"},{"id":7,"arabic":"وَأَوْلَٰدِكُمْ","translit":"ْmُkِdَٰlْwَaʾَw","root":"ولد"},{"id":8,"arabic":"عَدُوًّا","translit":"āًّwُdَʿع","root":"عدو"},{"id":9,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":10,"arabic":"فَٱحْذَرُوهُمْ","translit":"ْmُhwُrَhdْḥٱَf","root":"حذر"},{"id":11,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":12,"arabic":"تَعْفُوا۟","translit":"۟āwُfْʿعَt","root":"عفو"},{"id":13,"arabic":"وَتَصْفَحُوا۟","translit":"۟āwُḥَfْṣَtَw","root":"صفح"},{"id":14,"arabic":"وَتَغْفِرُوا۟","translit":"۟āwُrِfْغَtَw","root":"غفر"},{"id":15,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":16,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":17,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":18,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":15,"text":"إِنَّمَآ أَمْوَٰلُكُمْ وَأَوْلَٰدُكُمْ فِتْنَةٌۚ وَٱللَّهُ عِندَهُۥٓ أَجْرٌ عَظِيمٌ ","translation":"Your wealth and your children are but a trial, and Allāh has with Him a great reward.","words":[{"id":1,"arabic":"إِنَّمَآ","translit":"ٓāَmَّnِiʾ","root":""},{"id":2,"arabic":"أَمْوَٰلُكُمْ","translit":"ْmُkُlَٰwْmَaʾ","root":"مول"},{"id":3,"arabic":"وَأَوْلَٰدُكُمْ","translit":"ْmُkُdَٰlْwَaʾَw","root":"ولد"},{"id":4,"arabic":"فِتْنَةٌ","translit":"ٌẗَnْtِf","root":"فتن"},{"id":5,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":6,"arabic":"عِندَهُۥٓ","translit":"ٓۥُhَdnِʿع","root":"عند"},{"id":7,"arabic":"أَجْرٌ","translit":"ٌrْjgَaʾ","root":"اجر"},{"id":8,"arabic":"عَظِيمٌ","translit":"ٌmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":16,"text":"فَٱتَّقُوا۟ ٱللَّهَ مَا ٱسْتَطَعْتُمْ وَٱسْمَعُوا۟ وَأَطِيعُوا۟ وَأَنفِقُوا۟ خَيْرًا لِّأَنفُسِكُمْۗ وَمَن يُوقَ شُحَّ نَفْسِهِۦ فَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ","translation":"So fear Allāh as much as you are able and listen and obey and spend [in the way of Allāh]; it is better for your selves. And whoever is protected from the stinginess of his soul - it is those who will be the successful.","words":[{"id":1,"arabic":"فَٱتَّقُوا۟","translit":"۟āwُqَّtٱَf","root":"وقي"},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"ٱسْتَطَعْتُمْ","translit":"ْmُtْʿعَṭَtْsٱ","root":"طوع"},{"id":5,"arabic":"وَٱسْمَعُوا۟","translit":"۟āwُʿعَmْsٱَw","root":"سمع"},{"id":6,"arabic":"وَأَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾَw","root":"طوع"},{"id":7,"arabic":"وَأَنفِقُوا۟","translit":"۟āwُqِfnَaʾَw","root":"نفق"},{"id":8,"arabic":"خَيْرًا","translit":"āًrْyَhk","root":"خير"},{"id":9,"arabic":"لِّأَنفُسِكُمْ","translit":"ْmُkِsُfnَaʾِّl","root":"نفس"},{"id":10,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":11,"arabic":"يُوقَ","translit":"َqwُy","root":"وقي"},{"id":12,"arabic":"شُحَّ","translit":"َّḥُhs","root":"شحح"},{"id":13,"arabic":"نَفْسِهِۦ","translit":"ۦِhِsْfَn","root":"نفس"},{"id":14,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":15,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":16,"arabic":"ٱلْمُفْلِحُونَ","translit":"َnwُḥِlْfُmْlٱ","root":"فلح"}],"hasIhya":true},{"ayah":17,"text":"إِن تُقْرِضُوا۟ ٱللَّهَ قَرْضًا حَسَنًا يُضَٰعِفْهُ لَكُمْ وَيَغْفِرْ لَكُمْۚ وَٱللَّهُ شَكُورٌ حَلِيمٌ ","translation":"If you loan Allāh a goodly loan, He will multiply it for you and forgive you. And Allāh is [most] Appreciative[1] and Forbearing,[2]","words":[{"id":1,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":2,"arabic":"تُقْرِضُوا۟","translit":"۟āwُḍِrْqُt","root":"قرض"},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"قَرْضًا","translit":"āًḍْrَq","root":"قرض"},{"id":5,"arabic":"حَسَنًا","translit":"āًnَsَḥ","root":"حسن"},{"id":6,"arabic":"يُضَٰعِفْهُ","translit":"ُhْfِʿعَٰḍُy","root":"ضعف"},{"id":7,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":8,"arabic":"وَيَغْفِرْ","translit":"ْrِfْغَyَw","root":"غفر"},{"id":9,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":10,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":11,"arabic":"شَكُورٌ","translit":"ٌrwُkَhs","root":"شكر"},{"id":12,"arabic":"حَلِيمٌ","translit":"ٌmyِlَḥ","root":"حلم"}],"hasIhya":false},{"ayah":18,"text":"عَٰلِمُ ٱلْغَيْبِ وَٱلشَّهَٰدَةِ ٱلْعَزِيزُ ٱلْحَكِيمُ ","translation":"Knower of the unseen and the witnessed, the Exalted in Might, the Wise.","words":[{"id":1,"arabic":"عَٰلِمُ","translit":"ُmِlَٰʿع","root":"علم"},{"id":2,"arabic":"ٱلْغَيْبِ","translit":"ِbْyَغْlٱ","root":"غيب"},{"id":3,"arabic":"وَٱلشَّهَٰدَةِ","translit":"ِẗَdَٰhَّhslٱَw","root":"شهد"},{"id":4,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":5,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"}],"hasIhya":false}],"tafsir":{"1":[{"arabic":"إلا الله وحده لا شريك له له الملك وله الحمد يحيي ويميت بيده الخير وهو على كل شيء قدير لا إله إلا الله وحده صدق وعده ونصر عبده وأعز جنده وهزم الأحزاب وحده لا إله إلا الله مخلصين له الدين ولو كره الكافرون لا إله إلا الله مخلصين له الدين الحمد لله رب العالمين فسبحان الله حين تمسون وحين تصبحون وله الحمد في السموات والأرض وعشيا وحين تظهرون يخرج الحي من الميت ويخرج الميت من الحي ويحيي الأرض بعد موتها وكذلك تخرجون ومن آياته أن خلقكم من تراب ثم إذا أنتم بشر تنتشرون اللهم إني أسألك إيمانا دائما","english":"Upon ascending al-Ṣafā, he should face the House (al-Bayt) and say: \"God is Greater, God is Greater. Praise be to God for what He has guided us to. Praise be to God with all His praises, for all His graces, all of them. There is no god but God alone, with no partner. His is the dominion, and His is the praise. He gives life and causes death; in His hand is all good, and He is over all things competent. There is no god but God alone; He fulfilled His promise, aided His servant, and honored His soldiers; He alone defeated the confederates. There is no god but God, devoting religion sincerely to Him, even if the disbelievers detest it. There is no god but God, devoting religion sincerely to Him. Praise be to God, Lord of the worlds. So exalted is God when you reach the evening and when you reach the morning. And His is the praise in the heavens and the earth, and at nightfall and when you are at noon. He brings forth the living from the dead and brings forth the dead from the living, and He revives the earth after its death, and thus shall you be brought forth. And of His signs is that He created you from dust; then, behold, you are humans spreading out. O God, I ask You for enduring faith, sincere certainty, beneficial knowledge, a humble heart, and a tongue that remembers You. And I ask You for pardon, well-being, and perpetual immunity in this world and the Hereafter.\" Then he sends blessings upon Muḥammad, may God bless him and grant him peace, and supplicates God, Mighty and Majestic, with whatever need he wishes, following this supplication.","book_title":"On Invocations and Supplications","section_title_ar":"Section 204","section_title_en":"The Yemeni Corner and the Stone — The Beginning of the Saʿy and Its Rites","section_index":204,"anchors":"- Root: سعي (Saʿy)\n  * Lisan / Ayn: The root denotes striving, running, or rapid walking; it is the exertion of effort in a matter, whether good or evil.\n  * Al-Raghib (Mufradat): \"السعي: المشي السريع، وهو دون العدو، ويستعمل للجد في الأمر\" — Saʿy is swift walking, less than running, and is used for earnest exertion in a matter. In the sacred rite, it signifies the ritual traversing between al-Ṣafā and al-Marwah, an act of devotional striving.\n  * Al-Zamakhshari (Asas): Literal (Ḥaqīqah): \"سعى إلى المسجد\" — physical exertion toward a goal. Metaphorical (Majāz): \"هو يسعى على عياله\" — he strives to provide for his family. In the ritual context, the physical traversing is the literal embodiment of devotional striving.\n- Root: حمد (Ḥamd)\n  * Lisan / Ayn: The root denotes praise, commendation, and the acknowledgment of beneficence; it is the opposite of blame (dhamm).\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with reverence and love, and it is due to God alone in His absolute perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — praising God with all His praises. Metaphorical: \"أحمدت صنيعه\" — I approved of his deed. In the supplications of the saʿy, the pilgrim's praise is both literal acknowledgment and the metaphorical \"approval\" of God's decree.\n- Root: رمل (Raml)\n  * Lisan / Ayn: The root denotes rapid walking with a slight trotting motion, a form of hastening in movement.\n  * Al-Raghib (Mufradat): Not a primary theological term, but in ritual context it signifies the prescribed hastening between the two green markers, emulating the Prophet's action.\n  * Al-Zamakhshari (Asas): Literal: physical hastening. Metaphorical: The rapid pace is a visible emblem of spiritual earnestness and the rejection of the polytheists' claim that the Muslims were weakened by fever.\n- Sibawayh Rule: Rule of Restriction and Specification (al-Ḥaṣr wa al-Taqyīd) — The phrase \"وإنما ذلك شرط في طواف الركن\" employs restriction to delimit a condition exclusively to the circumambulation of the pillar (ṭawāf al-rukn), thereby negating its applicability to the saʿy.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"},{"arabic":"ويقول لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير آيبون تائبون عابدون ساجدون لربنا حامدون صدق الله وعده ونصر عبده وهزم الأحزاب وحده (3) وفي بعض الروايات وكل شيء هالك إلا وجهه له الحكم وإليه ترجعون فينبغي أن يستعمل هذه السنة في رجوعه وإذا أشرف على مدينته يحرك الدابة ويقول اللهم اجعل لنا بها قرارا ورزقا حسنا ثم ليرسل إلى أهله من يخبرهم بقدومه كي لا يقدم عليهم بغتة فذلك هو السنة (4) ولا ينبغي أن يطرق أهله ليلا فإذا دخل البلد فليقصد المسجد أولا وليصل ركعتين فهو السنة (5) كذلك كان يفعل رسول الل","english":"The Messenger of God, may God bless him and grant him peace, when he returned from a military expedition, or from the Pilgrimage (ḥajj), or the Lesser Pilgrimage (ʿumrah), would proclaim the greatness of God (takbīr) upon every elevated point of the land, three magnifications, and would say: \"There is no god but God alone, with no partner; His is the sovereignty, and His is the praise, and He is powerful over all things. Returning, repentant, worshipping, prostrating, to our Lord giving praise. God fulfilled His promise, and aided His servant, and defeated the confederates alone.\" {«لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير آيبون تائبون عابدون ساجدون لربنا حامدون صدق الله وعده ونصر عبده وهزم الأحزاب وحده»} And in some narrations: \"And everything is perishing except His Face; His is the judgment, and to Him you shall be returned.\" {«وكل شيء هالك إلا وجهه له الحكم وإليه ترجعون»} It is therefore fitting that one should practice this sunnah upon his return.","book_title":"On Invocations and Supplications","section_title_ar":"Section 212","section_title_en":"Section 212 — On the Sunnas of Returning from Travel","section_index":212,"anchors":"- Root: قفل (qafala)\n  * Lisan / Ayn: To return from a journey; the root denotes turning back from a course of travel.\n  * Al-Raghib (Mufradat): Return to a point of origin, whether spatial or temporal; here, the homeward journey after pilgrimage or expedition.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage — the physical act of coming back from travel.\n- Root: حمد (ḥamida)\n  * Lisan / Ayn: To praise; core sense of commendation for beneficence.\n  * Al-Raghib (Mufradat): Praise directed to God as the sole recipient of ultimate gratitude; distinct from mere flattery.\n  * Al-Zamakhshari (Asas): Literal — \"ḥāmidūn\" (those who praise); metaphorical (majāz) extension to all acts of grateful acknowledgment.\n- Root: سجد (sajada)\n  * Lisan / Ayn: To prostrate; physical lowering in submission.\n  * Al-Raghib (Mufradat): Prostration as the bodily expression of self-abasement before God; here, the voluntary prostration of the believer in worship.\n  * Al-Zamakhshari (Asas): Literal — the ritual act; metaphorical — any posture of humble obedience.\n- Sibawayh Rule: Prepositional Interposition (الفصل بين الجار والمجرور) — The phrase \"لربنا\" (to our Lord) is fronted for emphasis, governing the sequence of praise and worship, maintaining syntactic cohesion across the supplicatory formula.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"},{"arabic":"وهو مع ذلك قريب من كل موجود وهو أقرب إلى العبد من حبل الوريد وهو على كل شيء شهيد إذ لا يماثل قربه قرب الأجسام كما لا تماثل ذاته ذات الأجسام وأنه لا يحل في شيء ولا يحل فيه شيء تعالى عن أن يحويه مكان كما تقدس عن أن يحده زمان بل كان قبل أن خلق الزمان والمكان وهو الآن على ما عليه كان وأنه بائن عن خلقه بصفاته ليس في ذاته سواه ولا في سواه ذاته وأنه مقدس عن التغير والانتقال لا تحله الحوادث ولا تعتريه العوارض بل لا يزال في نعوت جلاله منزها عن الزوال وفي صفات كماله مستغنيا عن زيادة الاستكمال وأنه في ذاته معلوم الوجود بالعقول مرئ","english":"- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.","book_title":"On Invocations and Supplications","section_title_ar":"Section 72","section_title_en":"Section 72","section_index":72,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'","badge":"Insight"},{"arabic":"الأصل الأول العلم بأن صانع العالم قادر وأنه تعالى في قوله وهو على كل شيء قدير صادق لأن العالم محكم في صنعته مرتب في خلقته ومن رأى ثوبا من ديباج حسن النسج والتأليف متناسب التطريز والتطريف ثم توهم صدور نسجه عن ميت لا استطاعة له أو عن إنسان لا قدرة له كان منخلعا عن غريزة العقل ومنخرطا في سلك أهل الغباوة والجهل الأصل الثاني العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك","english":"**The Eighth Principle: Knowledge that He, Exalted is He, is established upon His Throne (mustawin ʿalā ʿarshihi) in the sense that God, Exalted is He, intended by istiwāʾ — which is the sense that does not contradict the attribute of Majesty, nor does any mark of origination (ḥudūth) or passing away (fanāʾ) attach to it. And it is the sense intended by His saying — istiwāʾ toward the heaven — where He said in the Qur'an: {«ثُمَّ اسْتَوَىٰ إِلَى السَّمَاءِ وَهِيَ دُخَانٌ»} (\"Then He directed Himself to the heaven, and it was smoke\") [Fussilat 41:11]. And that is only by way of subjugation (qahr) and dominion (istīlāʾ), as the poet said:","book_title":"On Invocations and Supplications","section_title_ar":"Section 90","section_title_en":"The Revival of the Religious Sciences — Section 90: The Ten Principles Concerning Knowledge of the Divine Attributes","section_index":90,"anchors":"- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denoting the faculty of perception and comprehension; the mark or trace by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from awareness (shiʿr); here, it denotes certain, verified cognition of theological verities.\n- Root: س و ي (s-w-y)\n  * Lisan / Ayn: Root indicating straightness, equality, and levelness; from it derives istiwāʾ (establishing oneself upon, ascending to).\n  * Al-Raghib (Mufradat): Istiwāʾ upon the Throne (al-ʿArsh) is a divine act of sovereign dominion, not corporeal settlement.\n  * Al-Zamakhshari (Asas): Literal sense of physical sitting is impossible for God; metaphorical sense (majāz) of qahr (overpowering) and istīlāʾ (dominion) is necessitated by reason and consensus.\n- Root: ر أ ي (r-ʾ-y)\n  * Lisan / Ayn: Visual perception; also opinion and discernment.\n  * Al-Raghib (Mufradat): Ruʾyah (vision) of God in the Hereafter is a mode of disclosure (kashf) and knowledge (ʿilm), more complete than intellectual cognition, not conditioned by spatial direction.\n  * Al-Zamakhshari (Asas): Literal vision requires corporeality and direction; its application to God demands theological specification (takhṣīṣ) without nullifying the veracity of the scriptural promise.\n- Root: ق د ر (q-d-r)\n  * Lisan / Ayn: Power, measure, decree; the capacity to bring about an act.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is the negation of incapacity (ʿajz); absolute power belongs to God alone, while creatures possess limited capacity.\n  * Al-Zamakhshari (Asas): Literal power over an object; metaphorically, God's power encompasses all things without exertion or instrument.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, applied here to the parsing of \"إلى السماء\" in the verse on istiwāʾ, where the prepositional phrase is delayed to highlight the divine act of sovereign direction toward the heavens.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"}],"4":[{"arabic":"وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدرك مدارك الملوك (4) وقد نبه بهذا على ثمراته في الدنيا ومعلوم أن الآخرة خير وأبقى وقال صلى الله عليه وسلم خصلتان لا يكونان في منافق حسن سمت وفقه في الدين (5) ولا تشكن في الحديث لنفاق بعض فقهاء الزمان فإنه ما أراد به الفقه الذي ظننته وسيأتي معنى الفقه وأدنى درجات الفقيه أن يعلم أن الآخرة خير من الدنيا","english":"How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.","book_title":"Contemplation","section_title_ar":"Section 4","section_title_en":"The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars","section_index":4,"anchors":"- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'","badge":"Hadith"}],"9":[{"arabic":"به إلى الغبن والحسرة وقال الله تعالى {يوم يجمعكم ليوم الجمع ذلك يوم التغابن} فهذه وصيته لنفسه في أوقاته ثم ليستأنف لها وصية في أعضائه السبعة وهي العين والأذن واللسان والبطن والفرج واليد والرجل وتسليمها إليها فإنها رعايا خادمة لنفسه في هذه التجارة وبها تتم أعمال هذه التجارة وإن لجهنم سبعة أبواب لكل باب منهم جزء مقسوم وإنما تتعين تلك الأبواب لمن عصى الله تعالى بهذه الأعضاء فيوصيها بحفظها عن معاصيها أما العين فيحفظها عن النظر إلى وجه من ليس له بمحرم أو إلى عورة مسلم أو النظر إلى مسلم بعين الاحتقار بل عن كل فضول مستغنى عنه فإن ا","english":"And some have said: \"Grant that the wrongdoer has been pardoned—has he not still missed the reward of the righteous?\"—pointing thereby to the loss and regret. And God Most High says: {«يَوْمَ يَجْمَعُكُمْ لِيَوْمِ الْجَمْعِ ذَٰلِكَ يَوْمُ التَّغَابُنِ»} (\"The Day He will gather you for the Day of Gathering—that is the Day of Mutual Loss\") (Al-Taghābun 64:9). So this is his counsel to his soul concerning his hours.","book_title":"Monitoring and Accounting","section_title_ar":"Section 1232","section_title_en":"The Revival of the Religious Sciences — Section 1232: The Soul's Covenant with Itself and Reckoning Before Deeds","section_index":1232,"anchors":"- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and animates; the essence of a thing.\n  * Al-Raghib (Mufradat): Al-nafs denotes the rūḥ (spirit) and, in theological contexts, the very dhāt (essence/self) of a being—as in {«وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ»} (Āl ʿImrān 3:28), where \"His self\" means His essence, not a separate entity.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the soul as the seat of desire and action. Metaphorical (majāz): \"دفق نفسه\" (he poured out his self = his blood); the soul as a recalcitrant entity requiring discipline.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day, from sunrise to sunset; also any span of time, especially the Day of Reckoning.\n  * Al-Raghib (Mufradat): Yawm signifies the period of the sun's course, but metaphorically extends to any era—most critically \"the Day of Gathering\" (yawm al-jamʿ) and \"the Day of Mutual Loss\" (yawm al-taghābun), where God's attribution of the day to Himself signals its supreme gravity.\n  * Al-Zamakhshari (Asas): Literal: a 24-hour cycle. Metaphorical: \"أيام الله\" (the days of God) = His punitive acts against the disbelievers, as in {«وَذَكِّرْهُمْ بِأَيَّامِ اللَّهِ»} (Ibrāhīm 14:5).\n- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: To count, reckon, or compute; also to suffice.\n  * Al-Raghib (Mufradat): Ḥisāb is the employment of number; the Day of Judgment is the day of reckoning where deeds are weighed. The \"ḥusbān\" (computation) of the sun and moon (Al-Anʿām 6:96) marks time for human accountability.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"احتسبت ما عند فلان\" (I probed what so-and-so possesses) = testing and examining, as the soul must examine its own intentions and acts before God's scrutiny.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The text uses conditional and imperative constructions (e.g., \"فإياك ثم إياك\" and \"ليشترط على نفسه\") to impose binding covenants, where the predicate restricts the soul's scope of action, demanding a precise, self-imposed legal obligation.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'","badge":"Insight"}],"14":[{"arabic":"لا تلهكم أموالكم ولا أولادكم عن ذكر الله} وقال عز وجل {إن من أزواجكم وأولادكم عدوا لكم فاحذروهم} وقال صلى الله عليه وسلم الولد مبخلة مجبنة محزنة ولما نظر عليه السلام إلى ولده الحسن رضي الله عنه يتعثر في قميصه نزل عن المنبر واحتضنه ثم قال {صدق الله} إنما أموالكم وأولادكم فتنة إني لما رأيت ابني يتعثر لم أملك نفسي أن أخذته ففي ذلك عبرة لأولي الأبصار فالرجل كل الرجل من يصبر على العافية ومعنى الصبر عليها أن لا يركن إليها ويعلم أن كل ذلك مستودع عنده وعسى أن يسترجع على القرب وأن لا يرسل نفسه في الفرح بها ولا ينهمك في التنعم واللذة واللهو واللعب وأن","english":"The first kind is that which accords with caprice (al-hawā) — namely, sound health and well-being, wealth and status, the abundance of kinsfolk, the expanse of means, the multitude of followers and helpers, and all the pleasures of this world. How greatly the servant stands in need of patience over these very things! For if he does not restrain his soul (nafsahu) from letting loose toward them, from reposing in them, and from plunging into their permissible pleasures, that drives him to insolence (al-baṭar) and transgression (al-ṭughyān) — for indeed {verily man doth transgress when he sees himself self-sufficient} {«إن الإنسان ليطغى أن رآه استغنى»}. Hence one of the knowers of God (al-ʿārifīn) said: \"Affliction — the believer can bear it; but well-being — none bears it save the veracious (al-ṣiddīq).\" And Sahl said: \"Patience over well-being is more severe than patience over affliction.\" When the doors of this world were opened upon the Companions — may God be well pleased with them — they said: \"We were tried with the trial of adversity (fitnat al-ḍarrāʾ) and we bore it patiently; and we were tried with the trial of prosperity (fitnat al-sarrāʾ) and we did not bear it patiently.\" For this reason God — mighty and majestic — warned His servants against the trial of wealth, spouse, and child, saying — exalted is He: {O you who believe! Let not your wealth nor your children divert you from the remembrance of God} {«يا أيها الذين آمنوا لا تلهكم أموالكم ولا أولادكم عن ذكر الله»}. And He said — mighty and majestic: {Indeed, among your spouses and your children there is an enemy unto you, so beware of them} {«إن من أزواجكم وأولادكم عدوا لكم فاحذروهم»}. And the Prophet — peace be upon him — said: \"The child is a cause of miserliness (mubakhkhilah), a cause of cowardice (mujabinah), a cause of grief (muḥzinah).\" When he — peace be upon him — looked upon his son al-Ḥasan — may God be well pleased with him — stumbling in his shirt, he descended from the pulpit and embraced him, then said: {God has spoken truly} {«صدق الله»} — {Indeed, your wealth and your children are a trial} {«إنما أموالكم وأولادكم فتنة»} — \"When I saw my son stumbling, I could not control myself (lam amlik nafsī) from taking him up.\" In that is a lesson for those of insight. So the man — the complete man — is he who bears patience over well-being. And the meaning of patience over it is that he does not repose in it, and knows that all of it is but a trust (mustawdaʿ) deposited with him, that it may well be reclaimed at any near moment; and that he does not release his soul to rejoice in it, nor plunge into comfort, pleasure, play, and amusement; and that he observes the rights of God in his wealth by spending, in his body by expending aid to creation, in his tongue by expending truthfulness (al-ṣidq) — and likewise in all the rest of what God has bestowed upon him.","book_title":"Patience and Gratitude","section_title_ar":"Section 963","section_title_en":"On Patience in Prosperity and Adversity — Section 963","section_index":963,"anchors":"- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and holding back; al-Farahidi notes \"صبر على قليه\" (endurance upon hardship).\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق... حبس النفس على ما يقتضيه العقل والشرع، أو عما يقتضيان حبسها عنه\" — Patience is the soul's restraint upon what reason and Law require, or from what they require restraining it; its names vary by context (shajāʿah in battle, etc.).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — patience over the disliked and patience away from the beloved. Metaphorical (majāz): \"هو أصبر على الضرب من الأرض\" — extreme endurance likened to earth's impassivity.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which one guards and restrains.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" and in divine attribution, \"نفسه: ذاته\" — the self as the locus of volition and desire.\n  * Al-Zamakhshari (Asas): Literal: \"نفس\" as the animate self; metaphorical: \"دفق نفسه أي دمه\" — extended to blood/life.\n- Root: ولد (w-l-d)\n  * Lisan / Ayn: Offspring, child; al-Farahidi notes singular/plural usage.\n  * Al-Raghib (Mufradat): \"الولد: المولود. يقال للواحد والجمع والصغير والكبير\" — child, born one, applied to one or many, young or old.\n  * Al-Zamakhshari (Asas): Literal: biological progeny; metaphorical (majāz): \"ولدوا حديثا وكلاما: استحدثوه\" — newly invented speech; here, children as a trial.\n- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness; al-Farahidi links it to earnestness in word and deed.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood originate in speech, but extend to action and intention.\n  * Al-Zamakhshari (Asas): Literal: truthful speech; metaphorical: \"رجل صادق الحملة\" — one whose charge in battle is true/earnest.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate exclusively to the subject, as in the prophetic citation {إنما أموالكم وأولادكم فتنة}, affirming trial as the sole designated function of wealth and children.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"},{"arabic":"وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال","english":"The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.","book_title":"Duties of Brotherhood","section_title_ar":"Section 175","section_title_en":"The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)","section_index":175,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'","badge":"Insight"}],"15":[{"arabic":"الله ومن يفعل ذلك فأولئك هم الخاسرون وقال تعالى إنما أموالكم وأولادكم فتنة والله عنده أجر عظيم فمن اختار ماله وولده على ما عند الله فقد خسر وغبن خسرانا عظيما وقال عز وجل من كان يريد الحياة الدنيا وزينتها الآية وقال تعالى إن الإنسان ليطغى أن رآه استغنى فلا حول ولا قوة إلا بالله العلي العظيم وقال تعالى ألهاكم التكاثر وقال رسول الله صلى الله عليه وسلم حب المال والشرف ينبتان النفاق في القلب كما ينبت الماء البقل (1) وقال صلى الله عليه وسلم ما ذئبان ضاريان أرسلا في زريبة غنم بأكثر إفسادا فيها من حب الشرف والمال والجاه في دين الرجل المسلم (2) وقال ص","english":"Allah Most High said: {«يا أيها الذين آمنوا لا تلهكم أموالكم ولا أولادكم عن ذكر الله ومن يفعل ذلك فأولئك هم الخاسرون»} — \"O you who believe, let not your wealth and your children divert you from the remembrance of Allah. And whoever does that — then it is they who are the losers.\" And He said Most High: {«إنما أموالكم وأولادكم فتنة والله عنده أجر عظيم»} — \"Your wealth and your children are only a trial, and Allah — with Him is a mighty reward.\" So whoever chooses his wealth and his child over what is with Allah has indeed lost and been defrauded a tremendous loss. And He said, Mighty and Majestic: {«من كان يريد الحياة الدنيا وزينتها»} — \"Whoever desires the life of this world and its adornment...\" — to the end of the verse. And He said Most High: {«إن الإنسان ليطغى أن رآه استغنى»} — \"Indeed, man does transgress when he sees himself self-sufficient.\" There is no might and no power except through Allah, the Exalted, the Magnificent. And He said Most High: {«ألهاكم التكاثر»} — \"Vying in increase diverts you.\"","book_title":"Condemnation of Miserliness and Love of Wealth","section_title_ar":"Section 753","section_title_en":"The Revival of the Religious Sciences — Book on Poverty and Abstinence: The Blame of Wealth and Its Perils","section_index":753,"anchors":"- Root: لهو (l-h-w)\n  * Lisan / Ayn: To divert, distract, or occupy oneself away from a matter of greater import; amusement that turns one from serious concern.\n  * Al-Raghib (Mufradat): Theologically, *lahw* denotes that which diverts the heart from Allah — the root cause of spiritual ruin, as wealth and children are here designated as distracting agents.\n  * Al-Zamakhshari (Asas): Literal: play/amusement. Metaphorical: any engrossing worldly pursuit that veils one from the Hereafter.\n- Root: كثر (k-th-r)\n  * Lisan / Ayn: Abundance, multitude, increase in number or quantity.\n  * Al-Raghib (Mufradat): *Takāthur* (vying in increase) is censured as the competitive accumulation of worldly goods for pride, not need.\n  * Al-Zamakhshari (Asas): Literal: seeking more. Metaphorical: the obsessive race toward worldly accumulation that hardens the heart.\n- Root: غبن (gh-b-n)\n  * Lisan / Ayn: To cheat, defraud, or suffer loss in a transaction; to be outwitted.\n  * Al-Raghib (Mufradat): In the Hereafter, *ghubn* is the ultimate loss — exchanging eternal bliss for fleeting worldly gain.\n  * Al-Zamakhshari (Asas): Literal: commercial deception. Metaphorical: the soul's self-deception in preferring the ephemeral over the everlasting.\n- Root: فتن (f-t-n)\n  * Lisan / Ayn: Trial, tribulation, test; that which sifts the sincere from the insincere.\n  * Al-Raghib (Mufradat): *Fitnah* is a divine test through which the heart's attachment to worldly goods is exposed.\n  * Al-Zamakhshari (Asas): Literal: burning in fire (as gold is refined). Metaphorical: wealth as a crucible for faith.\n- Sibawayh Rule: Restriction and Focused Predication (*Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā*) — The particle *innamā* in {«إنما أموالكم وأولادكم فتنة»} restricts the predicate, affirming that wealth and children are solely a trial, not an end in themselves.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Miserliness and Love of Wealth'","badge":"Ethics"},{"arabic":"وتعثر الحسن والنبي صلى الله عليه وسلم على منبره فنزل فحمله وقرأ قوله {إنما أموالكم وأولادكم فتنة} (3) وقال عبد الله بن شداد بينما رسول الله صلى الله عليه وسلم يصلي بالناس إذ جاءه الحسين فركب عنقه وهو ساجد فأطال السجود بالناس حتى ظنوا أنه قد حدث أمر فلما قضى صلاته قالوا قد أطلت السجود يا رسول الله حتى ظننا أنه قد حدث أمر فقال إن ابني قد ارتحلني فكرهت أن أعجله حتى يقضي حاجته (4) وفي ذلك فوائد إحداها القرب من الله تعالى فإن العبد أقرب ما يكون من الله تعالى إذا كان ساجدا وفيه الرفق بالولد والبر وتعليم لأمته وقال صلى الله عليه وسلم ريح الو","english":"The Prophet, peace be upon him, said: \"A child will never repay his father until he finds him a slave, buys him, and sets him free.\"","book_title":"Patience and Gratitude","section_title_ar":"Section 439","section_title_en":"The Book of the Revival of the Religious Sciences — Section 439: On the Rights of Parents and Children","section_index":439,"anchors":"- Root: ولد (w-l-d)\n  * Lisan / Ayn: To give birth, beget, produce; offspring, child, progeny.\n  * Al-Raghib (Mufradat): Al-walad denotes the begotten, singular or plural, young or old; also used for an adopted child. The root signifies the direct causal link of generation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical birth and kinship. Metaphorical (majāz) for \"newly invented speech\" (kalām muwallad) — but here, strictly literal.\n- Root: بر (b-r-r)\n  * Lisan / Ayn: Piety, dutifulness, kindness, gentleness; antonym of ʿuqūq (disobedience, severance).\n  * Al-Raghib (Mufradat): Birr is expansive goodness that connects the servant to God and creation; its opposite is ʿuqūq, the cutting of what God has commanded to be joined.\n  * Al-Zamakhshari (Asas): Literal for filial piety and charitable excellence.\n- Root: رحم (r-ḥ-m)\n  * Lisan / Ayn: The womb; kinship, blood-tie; mercy, compassion.\n  * Al-Raghib (Mufradat): Raḥim is the organ of gestation, and raḥmah is the mercy that God apportions; the kin-tie (raḥim) is so named because it demands mutual mercy.\n  * Al-Zamakhshari (Asas): Literal for the womb and blood-relations; metaphorical for mercy as its spiritual fruit.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — governing the exclusive force of statements like {«إنما أموالكم وأولادكم فتنة»}, where the predicate is restricted to the subject alone.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'","badge":"Hadith"}],"16":[{"arabic":"وسلم ثلاث مهلكات شح مطاع وهوى متبع وإعجاب المرء بنفسه (2) وقال تعالى ومن يوق شح نفسه فأولئك هم المفلحون وسيأتي في ربع المهلكات وجه كونه مهلكا وكيفية التقصي منه وإنما تزول صفة البخل بأن تتعود بذل المال فحب الشيء لا ينقطع إلا بقهر النفس على مفارقته حتى يصير ذلك اعتيادا فالزكاة بهذا المعنى طهرة أي تطهر صاحبها عن خبث البخل المهلك وإنما طهارته بقدر بذله وبقدر فرحه بإخراجه واستبشاره بصرفه إلى الله تعالى المعنى الثالث شكر النعمة فإن لله عز وجل على عبده نعمة في نفسه وفي ماله فالعبادات البدنية شكر لنعمة البدن والمالية شكر لنعمة المال وما أخس من ينظر إلى الفقير","english":"A group of the Followers (tābiʿūn) held that there are rights in wealth beyond the zakat — among them al-Nakhaʿī, al-Shaʿbī, ʿAṭāʾ, and Mujāhid. Al-Shaʿbī said, after being asked, \"Is there a right in wealth beyond the zakat?\": \"Yes. Have you not heard His saying — mighty and majestic is He: {«وَآتَى الْمَالَ عَلَىٰ حُبِّهِ ذَوِي الْقُرْبَىٰ»} 'And gives wealth, despite his love for it, to relatives' (2:177)?\" They also adduced His saying — mighty and majestic is He: {«وَمِمَّا رَزَقْنَاهُمْ يُنفِقُونَ»} 'And from what We have provided them, they spend' (2:3), and His saying — exalted is He: {«وَأَنفِقُوا مِن مَّا رَزَقْنَاكُم»} 'And spend from what We have provided you' (2:254). They claimed that this is not abrogated by the verse of zakat; rather, it falls within the right of a Muslim upon a Muslim. Its meaning is that it is incumbent upon the affluent one, whenever he finds a needy person, to remove his need — over and above the zakat wealth.","book_title":"Mysteries of Zakat","section_title_ar":"Section 173","section_title_en":"The Second Division: Those Who Guard Their Wealth Awaiting Seasons of Need — On the Inner Meanings of Zakat (Section 173)","section_index":173,"anchors":"- Root: ف-ق-ر (f-q-r)\n  * Lisan / Ayn: Core meaning of neediness, poverty; the hollow of the spine (faqār) — that which is structurally weak and dependent.\n  * Al-Raghib (Mufradat): Poverty (faqr) has four senses: (1) essential neediness before Allah, universal to all creatures; (2) lack of possessions; (3) [the third and fourth senses as elaborated in the full lexicon entry].\n  * Al-Zamakhshari (Asas): Literal (haqīqah): one who lacks wealth. Metaphorical (majāz): \"the poverty of speech\" (fuqar al-kalām) — its subtle points, likened to ornaments shaped like vertebrae.\n- Root: ص-د-ق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness in speech; giving (ṣadaqah) as the outward verification of inward faith.\n  * Al-Raghib (Mufradat): Ṣidq (truth) and kidhb (falsehood) are originally in speech — statement of what is, or what will be. By extension, ṣadaqah is that which verifies the truthfulness of one's claim to faith through expenditure.\n  * Al-Zamakhshari (Asas): Literal: truthful speech. Metaphorical: \"a horse with true running\" (dhū miṣdaq fī al-jary) — that which verifies its excellence through action. Thus charity verifies the giver's sincerity.\n- Root: م-ن-ن (m-n-n)\n  * Lisan / Ayn: The bestowal of a favor; reproaching another by reminding them of one's gift (al-mann).\n  * Al-Raghib (Mufradat): [As elaborated in the full lexicon entry on the heart's self-perception of superiority over the recipient.]\n  * Al-Zamakhshari (Asas): Literal: a heavy weight; a favor. Metaphorical: the act of counting one's favors over another — a corrosion of the gift's value.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise scope of obligation (farḍ kifāyah) versus supererogatory merit (faḍl), and the restriction of \"rights in wealth\" (ḥuqūq fī al-māl) beyond the obligatory zakat.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Mysteries of Zakat'","badge":"Ethics"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,1708],[2,1708,2584],[3,2584,3208],[4,3208,3808],[5,3808,5782],[6,5782,6766],[7,6766,7366],[8,7366,8518],[9,8518,8974],[10,8974,10006],[11,10006,10822],[12,10822,11878],[13,11878,12814],[14,12814,13918],[15,13918,14578],[16,14578,15418],[17,15418,16546]],"2":[[1,400,1056],[2,1056,2326],[3,2326,3774],[4,3774,5140],[5,5140,6397],[6,6397,7899],[7,7899,9470],[8,9470,10959],[9,10959,11942],[10,11942,13772],[11,13772,15083]],"3":[[1,400,1152],[2,1152,3026],[3,3026,4462],[4,4462,5715],[5,5715,7635],[6,7635,8865],[7,8865,10187],[8,10187,11577],[9,11577,12967]],"4":[[1,400,1499],[2,1499,2