":"َlāَq","root":"قول"},{"id":17,"arabic":"رَبُّكُمْ","translit":"ْmُkُّbَr","root":"ربب"},{"id":18,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":19,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":20,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":21,"arabic":"ٱلْعَلِىُّ","translit":"ُّàِlَʿعْlٱ","root":"علو"},{"id":22,"arabic":"ٱلْكَبِيرُ","translit":"ُryِbَkْlٱ","root":"كبر"}],"hasIhya":true},{"ayah":24,"text":"قُلْ مَن يَرْزُقُكُم مِّنَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ قُلِ ٱللَّهُۖ وَإِنَّآ أَوْ إِيَّاكُمْ لَعَلَىٰ هُدًى أَوْ فِى ضَلَٰلٍ مُّبِينٍ ","translation":"Say, \"Who provides for you from the heavens and the earth?\" Say, \"Allāh. And indeed, we or you are either upon guidance or in clear error.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"مَن","translit":"nَm","root":""},{"id":3,"arabic":"يَرْزُقُكُم","translit":"mُkُqُzْrَy","root":"رزق"},{"id":4,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":5,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":6,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":7,"arabic":"قُلِ","translit":"ِlُq","root":"قول"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"وَإِنَّآ","translit":"ٓāَّnِiʾَw","root":""},{"id":10,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":11,"arabic":"إِيَّاكُمْ","translit":"ْmُkāَّyِiʾ","root":""},{"id":12,"arabic":"لَعَلَىٰ","translit":"ٰàَlَʿعَl","root":""},{"id":13,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"},{"id":14,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":15,"arabic":"فِى","translit":"àِf","root":""},{"id":16,"arabic":"ضَلَٰلٍ","translit":"ٍlَٰlَḍ","root":"ضلل"},{"id":17,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":25,"text":"قُل لَّا تُسْـَٔلُونَ عَمَّآ أَجْرَمْنَا وَلَا نُسْـَٔلُ عَمَّا تَعْمَلُونَ ","translation":"Say, \"You will not be asked about what we committed, and we will not be asked about what you do.\"","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لَّا","translit":"āَّl","root":""},{"id":3,"arabic":"تُسْـَٔلُونَ","translit":"َnwُlَٔـْsُt","root":"سال"},{"id":4,"arabic":"عَمَّآ","translit":"ٓāَّmَʿع","root":""},{"id":5,"arabic":"أَجْرَمْنَا","translit":"āَnْmَrْjgَaʾ","root":"جرم"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"نُسْـَٔلُ","translit":"ُlَٔـْsُn","root":"سال"},{"id":8,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":9,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":false},{"ayah":26,"text":"قُلْ يَجْمَعُ بَيْنَنَا رَبُّنَا ثُمَّ يَفْتَحُ بَيْنَنَا بِٱلْحَقِّ وَهُوَ ٱلْفَتَّاحُ ٱلْعَلِيمُ ","translation":"Say, \"Our Lord will bring us together; then He will judge between us in truth. And He is the Knowing Judge.\"[1]","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"يَجْمَعُ","translit":"ُʿعَmْjgَy","root":"جمع"},{"id":3,"arabic":"بَيْنَنَا","translit":"āَnَnْyَb","root":"بين"},{"id":4,"arabic":"رَبُّنَا","translit":"āَnُّbَr","root":"ربب"},{"id":5,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":6,"arabic":"يَفْتَحُ","translit":"ُḥَtْfَy","root":"فتح"},{"id":7,"arabic":"بَيْنَنَا","translit":"āَnَnْyَb","root":"بين"},{"id":8,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":9,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":10,"arabic":"ٱلْفَتَّاحُ","translit":"ُḥāَّtَfْlٱ","root":"فتح"},{"id":11,"arabic":"ٱلْعَلِيمُ","translit":"ُmyِlَʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":27,"text":"قُلْ أَرُونِىَ ٱلَّذِينَ أَلْحَقْتُم بِهِۦ شُرَكَآءَۖ كَلَّاۚ بَلْ هُوَ ٱللَّهُ ٱلْعَزِيزُ ٱلْحَكِيمُ ","translation":"Say, \"Show me those whom you have attached to Him as partners. No! Rather, He [alone] is Allāh, the Exalted in Might, the Wise.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أَرُونِىَ","translit":"َàِnwُrَaʾ","root":"راي"