c":"مَتَىٰ","translit":"ٰàَtَm","root":""},{"id":3,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":4,"arabic":"ٱلْوَعْدُ","translit":"ُdْʿعَwْlٱ","root":"وعد"},{"id":5,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":6,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":7,"arabic":"صَٰدِقِينَ","translit":"َnyِqِdَٰṣ","root":"صدق"}],"hasIhya":true},{"ayah":30,"text":"قُل لَّكُم مِّيعَادُ يَوْمٍ لَّا تَسْتَـْٔخِرُونَ عَنْهُ سَاعَةً وَلَا تَسْتَقْدِمُونَ ","translation":"Say, \"For you is the appointment of a Day [when] you will not remain thereafter an hour, nor will you precede [it].\"","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لَّكُم","translit":"mُkَّl","root":""},{"id":3,"arabic":"مِّيعَادُ","translit":"ُdāَʿعyِّm","root":"وعد"},{"id":4,"arabic":"يَوْمٍ","translit":"ٍmْwَy","root":"يوم"},{"id":5,"arabic":"لَّا","translit":"āَّl","root":""},{"id":6,"arabic":"تَسْتَـْٔخِرُونَ","translit":"َnwُrِhkْٔـَtْsَt","root":"اخر"},{"id":7,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":8,"arabic":"سَاعَةً","translit":"ًẗَʿعāَs","root":"سوع"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"تَسْتَقْدِمُونَ","translit":"َnwُmِdْqَtْsَt","root":"قدم"}],"hasIhya":false},{"ayah":31,"text":"وَقَالَ ٱلَّذِينَ كَفَرُوا۟ لَن نُّؤْمِنَ بِهَٰذَا ٱلْقُرْءَانِ وَلَا بِٱلَّذِى بَيْنَ يَدَيْهِۗ وَلَوْ تَرَىٰٓ إِذِ ٱلظَّٰلِمُونَ مَوْقُوفُونَ عِندَ رَبِّهِمْ يَرْجِعُ بَعْضُهُمْ إِلَىٰ بَعْضٍ ٱلْقَوْلَ يَقُولُ ٱلَّذِينَ ٱسْتُضْعِفُوا۟ لِلَّذِينَ ٱسْتَكْبَرُوا۟ لَوْلَآ أَنتُمْ لَكُنَّا مُؤْمِنِينَ ","translation":"And those who disbelieve say, \"We will never believe in this Qur’ān nor in that before it.\" But if you could see when the wrongdoers are made to stand before their Lord, refuting each others' words...[1] Those who were oppressed will say to those who were arrogant, \"If not for you, we would have been believers.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"