": 20, "arabic": "لَّكُم", "translit": "", "root": ""}, {"id": 21, "arabic": "بَيْنَ", "translit": "", "root": ""}, {"id": 22, "arabic": "يَدَےْ", "translit": "", "root": ""}, {"id": 23, "arabic": "عَذَابࣲ", "translit": "", "root": ""}, {"id": 24, "arabic": "شَدِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 47, "text": "قُلْ مَا سَأَلْتُكُم مِّنَ اَجْرࣲ فَهُوَ لَكُمُۥٓۖ إِنَ اَجْرِيَ إِلَّا عَلَي اَ۬للَّهِۖ وَهُوَ عَلَيٰ كُلِّ شَےْءࣲ شَهِيدࣱۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "سَأَلْتُكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَجْرࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَهُوَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكُمُۥٓۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَجْرِيَ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 14, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 15, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 16, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 17, "arabic": "شَهِيدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 48, "text": "قُلِ اِنَّ رَبِّے يَقْذِفُ بِالْحَقِّۖ عَلَّٰمُ اُ۬لْغُيُوبِۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "يَقْذِفُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَّٰمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْغُيُوبِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 49, "text": "قُلْ جَآءَ اَ۬لْحَقُّ وَمَا يُبْدِۓُ اُ۬لْبَٰطِلُ وَمَا يُعِيدُۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْحَقُّ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يُبْدِۓُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْبَٰطِلُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يُعِيدُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 50, "text": "قُلِ اِن ضَلَلْتُ فَإِنَّمَآ أَضِلُّ عَلَيٰ نَفْسِے وَإِنِ اِ۪هْتَدَيْتُ فَبِمَا يُوحِےٓ إِلَيَّ رَبِّيَۖ إِنَّهُۥ سَمِيعࣱ قَرِيبࣱۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِن", "translit": "", "root": ""}, {"id": 3, "arabic": "ضَلَلْتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَإِنَّمَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَضِلُّ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَفْسِے", "translit": "", "root": ""}, {"id": 8, "arabic": "وَإِنِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۪هْتَدَيْتُ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَبِمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يُوحِےٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِلَيَّ", "translit": "", "root": ""}, {"id": 13, "arabic": "رَبِّيَۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 15, "arabic": "سَمِيعࣱ", "translit": "", "root": ""}, {"id": 16, "arabic": "قَرِيبࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 51, "text": "وَلَوْ تَر۪يٰٓ إِذْ فَزِعُواْ فَلَا فَوْتَ وَأُخِذُواْ مِن مَّكَانࣲ قَرِيبࣲۖ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَر۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَزِعُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فَوْتَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَأُخِذُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّكَانࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "قَرِيبࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 52, "text": "وَقَالُوٓاْ ءَامَنَّا بِهِۦۖ وَأَنّ۪يٰ لَهُمُ اُ۬لتَّنَاوُشُ مِن مَّكَانِۢ بَعِيدࣲ‏", "words": [{"id": 1, "arabic": "وَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَنّ۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لتَّنَاوُشُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّكَانِۢ", "translit": "", "root": ""}, {"id": 9, "arabic": "بَعِيدࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 53, "text": "وَقَدْ كَفَرُواْ بِهِۦ مِن قَبْلُۖ وَيَقْذِفُونَ بِالْغَيْبِ مِن مَّكَانِۢ بَعِيدࣲۖ", "words": [{"id": 1, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلُۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَقْذِفُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالْغَيْبِ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّكَانِۢ", "translit": "", "root": ""}, {"id": 10, "arabic": "بَعِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 54, "text": "وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِهِم مِّن قَبْلُ إِنَّهُمْ كَانُواْ فِے شَكࣲّ مُّرِيبٍۖ", "words": [{"id": 1, "arabic": "وَحِيلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَبَيْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَشْتَهُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فُعِلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِأَشْيَاعِهِم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 10, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 13, "arabic": "فِے", "translit": "", "root": ""}, {"id": 14, "arabic": "شَكࣲّ", "translit": "", "root": ""}, {"id": 15, "arabic": "مُّرِيبٍۖ", "translit": "", "root": ""}], "narration": "warsh"}]}