من"}],"hasIhya":true},{"ayah":32,"text":"قَالَ ٱلَّذِينَ ٱسْتَكْبَرُوا۟ لِلَّذِينَ ٱسْتُضْعِفُوٓا۟ أَنَحْنُ صَدَدْنَٰكُمْ عَنِ ٱلْهُدَىٰ بَعْدَ إِذْ جَآءَكُمۖ بَلْ كُنتُم مُّجْرِمِينَ ","translation":"Those who were arrogant will say to those who were oppressed, \"Did we avert you from guidance after it had come to you? Rather, you were criminals.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ٱسْتَكْبَرُوا۟","translit":"۟āwُrَbْkَtْsٱ","root":"كبر"},{"id":4,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":5,"arabic":"ٱسْتُضْعِفُوٓا۟","translit":"۟āٓwُfِʿعْḍُtْsٱ","root":"ضعف"},{"id":6,"arabic":"أَنَحْنُ","translit":"ُnْḥَnَaʾ","root":""},{"id":7,"arabic":"صَدَدْنَٰكُمْ","translit":"ْmُkَٰnْdَdَṣ","root":"صدد"},{"id":8,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":9,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":10,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":11,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":12,"arabic":"جَآءَكُم","translit":"mُkَءٓāَjg","root":"جيا"},{"id":13,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":14,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":15,"arabic":"مُّجْرِمِينَ","translit":"َnyِmِrْjgُّm","root":"جرم"}],"hasIhya":false},{"ayah":33,"text":"وَقَالَ ٱلَّذِينَ ٱسْتُضْعِفُوا۟ لِلَّذِينَ ٱسْتَكْبَرُوا۟ بَلْ مَكْرُ ٱلَّيْلِ وَٱلنَّهَارِ إِذْ تَأْمُرُونَنَآ أَن نَّكْفُرَ بِٱللَّهِ وَنَجْعَلَ لَهُۥٓ أَندَادًاۚ وَأَسَرُّوا۟ ٱلنَّدَامَةَ لَمَّا رَأَوُا۟ ٱلْعَذَابَ وَجَعَلْنَا ٱلْأَغْلَٰلَ فِىٓ أَعْنَاقِ ٱلَّذِينَ كَفَرُوا۟ۚ هَلْ يُجْزَوْنَ إِلَّا مَا كَانُوا۟ يَعْمَلُونَ ","translation":"Those who were oppressed will say to those who were arrogant, \"Rather, [it was your] conspiracy of night and day when you were ordering us to disbelieve in Allāh and attribute to Him equals.\" But they will [all] confide regret when they see the punishment; and We will put shackles on the necks of those who disbelieved. Will they be recompensed except for what they used to do?","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ٱسْتُضْعِفُوا۟","translit":"۟āwُfِʿعْḍُtْsٱ","root":"ضعف"},{"id":4,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":5,"arabic":"ٱسْتَكْبَرُوا۟","translit":"۟āwُrَbْkَtْsٱ","root":"كبر"},{"id":6,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":7,"arabic":"مَكْرُ","translit":"ُrْkَm","root":"مكر"},{"id":8,"arabic":"ٱلَّيْلِ","translit":"ِlْyَّlٱ","root":"ليل"},{"id":9,"arabic":"وَٱلنَّهَارِ","translit":"ِrāَhَّnlٱَw","root":"نهر"},{"id":10,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":11,"arabic":"تَأْمُرُونَنَآ","translit":"ٓāَnَnwُrُmْaʾَt","root":"امر"},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"نَّكْفُرَ","translit":"َrُfْkَّn","root":"كفر"},{"id":14,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":15,"arabic":"وَنَجْعَلَ","translit":"َlَʿعْjgَnَw","root":"جعل"},{"id":16,"arabic":"لَهُۥٓ","translit":"ٓۥُhَl","root":""},{"id":17,"arabic":"أَندَادًا","translit":"āًdāَdnَaʾ","root":"ندد"},{"id":18,"arabic":"وَأَسَرُّوا۟","translit":"۟āwُّrَsَaʾَw","root":"سرر"},{"id":19,"arabic":"ٱلنَّدَامَةَ","translit":"َẗَmāَdَّnlٱ","root":"ندم"},{"id":20,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":21,"arabic":"رَأَوُا۟","translit":"۟āُwَaʾَr","root":"راي"},{"id":22,"arabic":"ٱلْعَذَابَ","translit":"َbāَhdَʿعْlٱ","root":"عذب"},{"id":23,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":24,"arabic":"ٱلْأَغْلَٰلَ","translit":"َlَٰlْغَaʾْlٱ","root":"غلل"},{"id":25,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":26,"arabic":"أَعْنَاقِ","translit":"ِqāَnْʿعَaʾ","root":"عنق"},{"id":27,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":28,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":29,"arabic":"هَلْ","trans