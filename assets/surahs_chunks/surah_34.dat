, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْوَعْدُ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِن", "translit": "", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "صَٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 30, "text": "قُل لَّكُم مِّيعَادُ يَوْمࣲ لَّا تَسْتَٰخِرُونَ عَنْهُ سَاعَةࣰ وَلَا تَسْتَقْدِمُونَۖ", "words": [{"id": 1, "arabic": "قُل", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّكُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّيعَادُ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَسْتَٰخِرُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "سَاعَةࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تَسْتَقْدِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 31, "text": "وَقَالَ اَ۬لذِينَ كَفَرُواْ لَن نُّومِنَ بِهَٰذَا اَ۬لْقُرْءَانِ وَلَا بِالذِے بَيْنَ يَدَيْهِۖ وَلَوْ تَر۪يٰٓ إِذِ اِ۬لظَّٰلِمُونَ مَوْقُوفُونَ عِندَ رَبِّهِمْ يَرْجِعُ بَعْضُهُمُۥٓ إِلَيٰ بَعْضٍ اِ۬لْقَوْلَۖ يَقُولُ اُ۬لذِينَ اَ۟سْتُضْعِفُواْ لِلذِينَ اَ۪سْتَكْبَرُواْ لَوْلَآ أَنتُمْ لَكُنَّا مُومِنِينَۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَن", "translit": "", "root": ""}, {"id": 5, "arabic": "نُّومِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِهَٰذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْقُرْءَانِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 9, "arabic": "بِالذِے", "translit": "", "root": ""}, {"id": 10,