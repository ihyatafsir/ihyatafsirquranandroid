text": "وَقَالُوٓاْ ءَامَنَّا بِهِۦۖ وَأَنّ۪يٰ لَهُمُ اُ۬لتَّنَاوُشُ مِن مَّكَانِۢ بَعِيدࣲ‏", "words": [{"id": 1, "arabic": "وَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَنّ۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لتَّنَاوُشُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّكَانِۢ", "translit": "", "root": ""}, {"id": 9, "arabic": "بَعِيدࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 53, "text": "وَقَدْ كَفَرُواْ بِهِۦ مِن قَبْلُۖ وَيَقْذِفُونَ بِالْغَيْبِ مِن مَّكَانِۢ بَعِيدࣲۖ", "words": [{"id": 1, "arabic": "وَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلُۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَقْذِفُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالْغَيْبِ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "مَّكَانِۢ", "translit": "", "root": ""}, {"id": 10, "arabic": "بَعِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 54, "text": "وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِهِم مِّن قَبْلُ إِنَّهُمْ كَانُواْ فِے شَكࣲّ مُّرِيبٍۖ", "words": [{"id": 1, "arabic": "وَحِيلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَيْنَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَبَيْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَشْتَهُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فُع