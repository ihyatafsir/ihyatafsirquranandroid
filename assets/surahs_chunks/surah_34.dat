"arabic": "ظَهِيرࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 23, "text": "وَلَا تَنفَعُ اُ۬لشَفَٰعَةُ عِندَهُۥٓ إِلَّا لِمَنَ اَذِنَ لَهُۥۖ حَتَّيٰٓ إِذَا فُزِّعَ عَن قُلُوبِهِمْ قَالُواْ مَاذَا قَالَ رَبُّكُمْ قَالُواْ اُ۬لْحَقَّۖ وَهُوَ اَ۬لْعَلِيُّ اُ۬لْكَبِيرُۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَنفَعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لشَفَٰعَةُ", "translit": "", "root": ""}, {"id": 4, "arabic": "عِندَهُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "لِمَنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَذِنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَهُۥۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "حَتَّيٰٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 11, "arabic": "فُزِّعَ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَن", "translit": "", "root": ""}, {"id": 13, "arabic": "قُلُوبِهِمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 15, "arabic": "مَاذَا", "translit": "", "root": ""}, {"id": 16, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 17, "arabic": "رَبُّكُمْ", "translit": "", "root": ""}, {"id": 18, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 19, "arabic": "اُ۬لْحَقَّۖ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 21, "arabic": "اَ۬لْعَلِيُّ", "translit": "", "root": ""}, {"id": 22, "arabic": "اُ۬لْكَبِيرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 34, "ayah": 24, "text": "۞قُلْ مَنْ يَّرْزُقُكُم مِّنَ اَ۬لسَّمَٰوَٰتِ وَالَارْضِ قُلِ اِ۬للَّهُۖ وَإِنَّآ أَوِ اِيَّاكُمْ لَعَلَيٰ هُديً اَوْ فِے ضَلَٰلࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "۞قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "", "root": ""}, {"id