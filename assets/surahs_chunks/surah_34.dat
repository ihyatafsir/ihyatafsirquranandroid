ic":"مُعَٰجِزِينَ","translit":"َnyِzِjgَٰʿعُm","root":"عجز"},{"id":6,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":9,"arabic":"مُحْضَرُونَ","translit":"َnwُrَḍْḥُm","root":"حضر"}],"hasIhya":false},{"ayah":39,"text":"قُلْ إِنَّ رَبِّى يَبْسُطُ ٱلرِّزْقَ لِمَن يَشَآءُ مِنْ عِبَادِهِۦ وَيَقْدِرُ لَهُۥۚ وَمَآ أَنفَقْتُم مِّن شَىْءٍ فَهُوَ يُخْلِفُهُۥۖ وَهُوَ خَيْرُ ٱلرَّٰزِقِينَ ","translation":"Say, \"Indeed, my Lord extends provision for whom He wills of His servants and restricts [it] for him. But whatever thing you spend [in His cause] - He will compensate it; and He is the best of providers.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":3,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":4,"arabic":"يَبْسُطُ","translit":"ُṭُsْbَy","root":"بسط"},{"id":5,"arabic":"ٱلرِّزْقَ","translit":"َqْzِّrlٱ","root":"رزق"},{"id":6,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":7,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"عِبَادِهِۦ","translit":"ۦِhِdāَbِʿع","root":"عبد"},{"id":10,"arabic":"وَيَقْدِرُ","translit":"ُrِdْqَyَw","root":"قدر"},{"id":11,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":12,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":13,"arabic":"أَنفَقْتُم","translit":"mُtْqَfnَaʾ","root":"نفق"},{"id":14,"arabic":"مِّن","translit":"nِّm","root":""},{"id":15,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":16,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":17,"arabic":"يُخْلِفُهُۥ","translit":"ۥُhُfِlْhkُy","root":"خلف"},{"id":18,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":19,"arabic":"خَيْرُ","translit":"ُrْyَhk","root":"خير"},{"id":20,"arabic":"ٱلرَّٰزِقِينَ","translit":"َnyِqِzَّٰrlٱ","root":"رزق"}],"hasIhya":false},{"ayah":40,"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا ثُمَّ يَقُولُ لِلْمَلَٰٓئِكَةِ أَهَٰٓؤُلَآءِ إِيَّاكُمْ كَانُوا۟ يَعْبُدُونَ ","translation":"And [mention] the Day when He will gather them all and then say to the angels, \"Did these [people] used to worship you?\"","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"يَحْشُرُهُمْ","translit":"ْmُhُrُhsْḥَy","root":"حشر"},{"id":3,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":4,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":5,"arabic":"يَقُولُ","translit":"ُlwُqَy","root":"قول"},{"id":6,"arabic":"لِلْمَلَٰٓئِكَةِ","translit":"ِẗَkِyʾَٰٓlَmْlِl","root":"ملك"},{"id":7,"arabic":"أَهَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓhَaʾ","root":""},{"id":8,"arabic":"إِيَّاكُمْ","translit":"ْmُkāَّyِiʾ","root":""},{"id":9,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":10,"arabic":"يَعْبُدُونَ","translit":"َnwُdُbْʿعَy","root":"عبد"}],"hasIhya":false},{"ayah":41,"text":"قَالُوا۟ سُبْحَٰنَكَ أَنتَ وَلِيُّنَا مِن دُونِهِمۖ بَلْ كَانُوا۟ يَعْبُدُونَ ٱلْجِنَّۖ أَكْثَرُهُم بِهِم مُّؤْمِنُونَ ","translation":"They will say, \"Exalted are You! You, [O Allāh], are our benefactor excluding [i.e., not] them. Rather, they used to worship the jinn; most of them were believers in them.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"سُبْحَٰنَكَ","translit":"َkَnَٰḥْbُs","root":"سبح"},{"id":3,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":4,"arabic":"وَلِيُّنَا","translit":"āَnُّyِlَw","root":"ولي"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"دُونِهِم","translit":"mِhِnwُd","root":"دون"},{"id":7,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":8,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":9,"arabic":"يَعْبُدُونَ","translit":"َnwُdُbْʿعَy","root":"عبد"},{"id":10,"arabic":"ٱلْجِنَّ","translit":"َّnِjgْlٱ","root":"جنن"},{"id":11,"arabic":"أَكْثَرُهُم","translit":"mُhُrَhtْkَaʾ","root":"كثر"},{"id":12,"arabic":"بِهِم","translit":"mِhِb","root":""},{"id":13,"arabic":"مُّؤْمِنُونَ","translit":"َnwُnِmْwʾُّm","root":"امن"}],"hasIhya":false},{"ayah":42,"text":"فَٱلْيَوْمَ لَا يَمْلِكُ بَعْضُكُمْ لِبَعْضٍ نَّفْعًا وَلَا ضَرًّا وَنَقُولُ لِلَّذِينَ ظَلَمُوا۟ ذُوقُوا۟ عَذَابَ ٱلنَّارِ ٱلَّتِى كُنتُم بِهَا تُكَذِّبُونَ ","translation":"But today [i.e., the Day of Judgement] you do not hold for one another [the power of] benefit or harm, and We will say to those who wronged, \"Taste the punishment of the Fire, which you used to deny.\"","words":[{"id":1,"arabic":"فَٱلْيَوْمَ","translit":"َmْwَyْlٱَf","root":"يوم"},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"يَمْلِكُ","translit":"ُkِlْmَy","root":"ملك"},{"id":4,"arabic":"بَعْضُكُمْ","translit":"ْmُkُḍْʿعَb","root":"بعض"},{"id":5,"arabic":"لِبَعْضٍ","translit":"ٍḍْʿعَbِl","root":"بعض"},{"id":6,"arabic":"نَّفْعًا","translit":"āًʿعْfَّn","root":"نفع"},{"id":7,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":8,"arabic":"ضَرًّا","translit":"āًّrَḍ","root":"ضرر"},{"id":9,"arabic":"وَنَقُولُ","translit":"ُlwُqَnَw","root":"قول"},{"id":10,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":11,"arabic":"ظَلَمُوا۟","translit":"۟āwُmَlَẓ","root":"ظلم"},{"id":12,"arabic":"ذُوقُوا۟","translit":"۟āwُqwُhd","root":"ذوق"},{"id":13,"arabic":"عَذَابَ","translit":"َbāَhdَʿع","root":"عذب"},{"id":14,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":15,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":16,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":17,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":18,"arabic":"تُكَذِّبُونَ","translit":"َnwُbِّhdَkُt","root":"كذب"}],"hasIhya":false},{"ayah":43,"text":"وَإِذَا تُتْلَىٰ عَلَيْهِمْ ءَايَٰتُنَا بَيِّنَٰتٍ قَالُوا۟ مَا هَٰذَآ إِلَّا رَجُلٌ يُرِيدُ أَن يَصُدَّكُمْ عَمَّا كَانَ يَعْبُدُ ءَابَآؤُكُمْ وَقَالُوا۟ مَا هَٰذَآ إِلَّآ إِفْكٌ مُّفْتَرًىۚ وَقَالَ ٱلَّذِينَ كَفَرُوا۟ لِلْحَقِّ لَمَّا جَآءَهُمْ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ ","translation":"And when Our verses are recited to them as clear evidences, they say, \"This is not but a man who wishes to avert you from that which your fathers were worshipping.\" And they say, \"This is not except a lie invented.\" And those who disbelieve say of the truth when it has come to them, \"This is not but obvious magic.\"","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"تُتْلَىٰ","translit":"ٰàَlْtُt","root":"تلو"},{"id":3,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":4,"arabic":"ءَايَٰتُنَا","translit":"āَnُtَٰyāَء","root":"ايي"},{"id":5,"arabic":"بَيِّنَٰتٍ","translit":"ٍtَٰnِّyَb","root":"بين"},{"id":6,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":7,"arabic":"مَا","translit":"āَm","root":""},{"id":8,"arabic":"هَٰذَآ","translit":"ٓāَhdَٰh","root":""},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"رَجُلٌ","translit":"ٌlُjgَr","root":"رجل"},{"id":11,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"يَصُدَّكُمْ","translit":"ْmُkَّdُṣَy","root":"صدد"},{"id":14,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":15,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":16,"arabic":"يَعْبُدُ","translit":"ُdُbْʿعَy","root":"عبد"},{"id":17,"arabic":"ءَابَآؤُكُمْ","translit":"ْmُkُwʾٓāَbāَء","root":"ابو"},{"id":18,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":19,"arabic":"مَا","translit":"āَm","root":""},{"id":20,"arabic":"هَٰذَآ","translit":"ٓāَhdَٰh","root":""},{"id":21,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":22,"arabic":"إِفْكٌ","translit":"ٌkْfِiʾ","root":"افك"},{"id":23,"arabic":"مُّفْتَرًى","translit":"àًrَtْfُّm","root":"فري"},{"id":24,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":25,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":26,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":27,"arabic":"لِلْحَقِّ","translit":"ِّqَḥْlِl","root":"حقق"},{"id":28,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":29,"arabic":"جَآءَهُمْ","translit":"ْmُhَءٓāَjg","root":"جيا"},{"id":30,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":31,"arabic":"هَٰذَآ","translit":"ٓāَhdَٰh","root":""},{"id":32,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":33,"arabic":"سِحْرٌ","translit":"ٌrْḥِs","root":"سحر"},{"id":34,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":44,"text":"وَمَآ ءَاتَيْنَٰهُم مِّن كُتُبٍ يَدْرُسُونَهَاۖ وَمَآ أَرْسَلْنَآ إِلَيْهِمْ قَبْلَكَ مِن نَّذِيرٍ ","translation":"And We had not given them any scriptures which they could study, and We had not sent to them before you, [O Muḥammad], any warner.","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"ءَاتَيْنَٰهُم","translit":"mُhَٰnْyَtāَء","root":"اتي"},{"id":3,"arabic":"مِّن","translit":"nِّm","root":""},{"id":4,"arabic":"كُتُبٍ","translit":"ٍbُtُk","root":"كتب"},{"id":5,"arabic":"يَدْرُسُونَهَا","translit":"āَhَnwُsُrْdَy","root":"درس"},{"id":6,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":7,"arabic":"أَرْسَلْنَآ","translit":"ٓāَnْlَsْrَaʾ","root":"رسل"},{"id":8,"arabic":"إِلَيْهِمْ","translit":"ْmِhْyَlِiʾ","root":""},{"id":9,"arabic":"قَبْلَكَ","translit":"َkَlْbَq","root":"قبل"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"نَّذِيرٍ","translit":"ٍryِhdَّn","root":"نذر"}],"hasIhya":false},{"ayah":45,"text":"وَكَذَّبَ ٱلَّذِينَ مِن قَبْلِهِمْ وَمَا بَلَغُوا۟ مِعْشَارَ مَآ ءَاتَيْنَٰهُمْ فَكَذَّبُوا۟ رُسُلِىۖ فَكَيْفَ كَانَ نَكِيرِ ","translation":"And those before them denied, and they [i.e., the people of Makkah] have not attained a tenth of what We had given them. But they [i.e., the former peoples] denied My messengers, so how [terrible] was My reproach.","words":[{"id":1,"arabic":"وَكَذَّبَ","translit":"َbَّhdَkَw","root":"كذب"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَبْلِهِمْ","translit":"ْmِhِlْbَq","root":"قبل"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"بَلَغُوا۟","translit":"۟āwُغَlَb","root":"بلغ"},{"id":7,"arabic":"مِعْشَارَ","translit":"َrāَhsْʿعِm","root":"عشر"},{"id":8,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":9,"arabic":"ءَاتَيْنَٰهُمْ","translit":"ْmُhَٰnْyَtāَء","root":"اتي"},{"id":10,"arabic":"فَكَذَّبُوا۟","translit":"۟āwُbَّhdَkَf","root":"كذب"},{"id":11,"arabic":"رُسُلِى","translit":"àِlُsُr","root":"رسل"},{"id":12,"arabic":"فَكَيْفَ","translit":"َfْyَkَf","root":"كيف"},{"id":13,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":14,"arabic":"نَكِيرِ","translit":"ِryِkَn","root":"نكر"}],"hasIhya":false},{"ayah":46,"text":"قُلْ إِنَّمَآ أَعِظُكُم بِوَٰحِدَةٍۖ أَن تَقُومُوا۟ لِلَّهِ مَثْنَىٰ وَفُرَٰدَىٰ ثُمَّ تَتَفَكَّرُوا۟ۚ مَا بِصَاحِبِكُم مِّن جِنَّةٍۚ إِنْ هُوَ إِلَّا نَذِيرٌ لَّكُم بَيْنَ يَدَىْ عَذَابٍ شَدِيدٍ ","translation":"Say, \"I only advise you of one [thing] - that you stand for Allāh, [seeking truth] in pairs and individually, and then give thought.\" There is not in your companion any madness. He is only a warner to you before a severe punishment.","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنَّمَآ","translit":"ٓāَmَّnِiʾ","root":""},{"id":3,"arabic":"أَعِظُكُم","translit":"mُkُẓِʿعَaʾ","root":"وعظ"},{"id":4,"arabic":"بِوَٰحِدَةٍ","translit":"ٍẗَdِḥَٰwِb","root":"وحد"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"تَقُومُوا۟","translit":"۟āwُmwُqَt","root":"قوم"},{"id":7,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":8,"arabic":"مَثْنَىٰ","translit":"ٰàَnْhtَm","root":"ثني"},{"id":9,"arabic":"وَفُرَٰدَىٰ","translit":"ٰàَdَٰrُfَw","root":"فرد"},{"id":10,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":11,"arabic":"تَتَفَكَّرُوا۟","translit":"۟āwُrَّkَfَtَt","root":"فكر"},{"id":12,"arabic":"مَا","translit":"āَm","root":""},{"id":13,"arabic":"بِصَاحِبِكُم","translit":"mُkِbِḥāَṣِb","root":"صحب"},{"id":14,"arabic":"مِّن","translit":"nِّm","root":""},{"id":15,"arabic":"جِنَّةٍ","translit":"ٍẗَّnِjg","root":"جنن"},{"id":16,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":17,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":18,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":19,"arabic":"نَذِيرٌ","translit":"ٌryِhdَn","root":"نذر"},{"id":20,"arabic":"لَّكُم","translit":"mُkَّl","root":""},{"id":21,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":22,"arabic":"يَدَىْ","translit":"ْàَdَy","root":"يدي"},{"id":23,"arabic":"عَذَابٍ","translit":"ٍbāَhdَʿع","root":"عذب"},{"id":24,"arabic":"شَدِيدٍ","translit":"ٍdyِdَhs","root":"شدد"}],"hasIhya":false},{"ayah":47,"text":"قُلْ مَا سَأَلْتُكُم مِّنْ أَجْرٍ فَهُوَ لَكُمْۖ إِنْ أَجْرِىَ إِلَّا عَلَى ٱللَّهِۖ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ شَهِيدٌ ","translation":"Say, \"Whatever payment I might have asked of you - it is yours. My payment is only from Allāh, and He is, over all things, Witness.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"سَأَلْتُكُم","translit":"mُkُtْlَaʾَs","root":"سال"},{"id":4,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":5,"arabic":"أَجْرٍ","translit":"ٍrْjgَaʾ","root":"اجر"},{"id":6,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":7,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":8,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":9,"arabic":"أَجْرِىَ","translit":"َàِrْjgَaʾ","root":"اجر"},{"id":10,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":11,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":14,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":15,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":16,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":17,"arabic":"شَهِيدٌ","translit":"ٌdyِhَhs","root":"شهد"}],"hasIhya":false},{"ayah":48,"text":"قُلْ إِنَّ رَبِّى يَقْذِفُ بِٱلْحَقِّ عَلَّٰمُ ٱلْغُيُوبِ ","translation":"Say, \"Indeed, my Lord projects the truth, Knower of the unseen.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":3,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":4,"arabic":"يَقْذِفُ","translit":"ُfِhdْqَy","root":"قذف"},{"id":5,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":6,"arabic":"عَلَّٰمُ","translit":"ُmَّٰlَʿع","root":"علم"},{"id":7,"arabic":"ٱلْغُيُوبِ","translit":"ِbwُyُغْlٱ","root":"غيب"}],"hasIhya":false},{"ayah":49,"text":"قُلْ جَآءَ ٱلْحَقُّ وَمَا يُبْدِئُ ٱلْبَٰطِلُ وَمَا يُعِيدُ ","translation":"Say, \"The truth has come, and falsehood can neither begin [anything] nor repeat [it].\"[1]","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":3,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":4,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":5,"arabic":"يُبْدِئُ","translit":"ُyʾِdْbُy","root":"بدا"},{"id":6,"arabic":"ٱلْبَٰطِلُ","translit":"ُlِṭَٰbْlٱ","root":"بطل"},{"id":7,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":8,"arabic":"يُعِيدُ","translit":"ُdyِʿعُy","root":"عود"}],"hasIhya":false},{"ayah":50,"text":"قُلْ إِن ضَلَلْتُ فَإِنَّمَآ أَضِلُّ عَلَىٰ نَفْسِىۖ وَإِنِ ٱهْتَدَيْتُ فَبِمَا يُوحِىٓ إِلَىَّ رَبِّىٓۚ إِنَّهُۥ سَمِيعٌ قَرِيبٌ ","translation":"Say, \"If I should err, I would only err against myself. But if I am guided, it is by what my Lord reveals to me. Indeed, He is Hearing and near.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"ضَلَلْتُ","translit":"ُtْlَlَḍ","root":"ضلل"},{"id":4,"arabic":"فَإِنَّمَآ","translit":"ٓāَmَّnِiʾَf","root":""},{"id":5,"arabic":"أَضِلُّ","translit":"ُّlِḍَaʾ","root":"ضلل"},{"id":6,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":7,"arabic":"نَفْسِى","translit":"àِsْfَn","root":"نفس"},{"id":8,"arabic":"وَإِنِ","translit":"ِnِiʾَw","root":""},{"id":9,"arabic":"ٱهْتَدَيْتُ","translit":"ُtْyَdَtْhٱ","root":"هدي"},{"id":10,"arabic":"فَبِمَا","translit":"āَmِbَf","root":""},{"id":11,"arabic":"يُوحِىٓ","translit":"ٓàِḥwُy","root":"وحي"},{"id":12,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":13,"arabic":"رَبِّىٓ","translit":"ٓàِّbَr","root":"ربب"},{"id":14,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":15,"arabic":"سَمِيعٌ","translit":"ٌʿعyِmَs","root":"سمع"},{"id":16,"arabic":"قَرِيبٌ","translit":"ٌbyِrَq","root":"قرب"}],"hasIhya":false},{"ayah":51,"text":"وَلَوْ تَرَىٰٓ إِذْ فَزِعُوا۟ فَلَا فَوْتَ وَأُخِذُوا۟ مِن مَّكَانٍ قَرِيبٍ ","translation":"And if you could see[1] when they are terrified but there is no escape, and they will be seized from a place nearby.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"تَرَىٰٓ","translit":"ٰٓàَrَt","root":"راي"},{"id":3,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":4,"arabic":"فَزِعُوا۟","translit":"۟āwُʿعِzَf","root":"فزع"},{"id":5,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":6,"arabic":"فَوْتَ","translit":"َtْwَf","root":"فوت"},{"id":7,"arabic":"وَأُخِذُوا۟","translit":"۟āwُhdِhkُaʾَw","root":"اخذ"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"مَّكَانٍ","translit":"ٍnāَkَّm","root":"كون"},{"id":10,"arabic":"قَرِيبٍ","translit":"ٍbyِrَq","root":"قرب"}],"hasIhya":false},{"ayah":52,"text":"وَقَالُوٓا۟ ءَامَنَّا بِهِۦ وَأَنَّىٰ لَهُمُ ٱلتَّنَاوُشُ مِن مَّكَانٍۭ بَعِيدٍ ","translation":"And they will [then] say, \"We believe in it!\" But how for them will be the taking[1] [of faith] from a place far away?[2]","words":[{"id":1,"arabic":"وَقَالُوٓا۟","translit":"۟āٓwُlāَqَw","root":"قول"},{"id":2,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":3,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":4,"arabic":"وَأَنَّىٰ","translit":"ٰàَّnَaʾَw","root":""},{"id":5,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":6,"arabic":"ٱلتَّنَاوُشُ","translit":"ُhsُwāَnَّtlٱ","root":"نوش"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"مَّكَانٍۭ","translit":"ٍۭnāَkَّm","root":"كون"},{"id":9,"arabic":"بَعِيدٍ","translit":"ٍdyِʿعَb","root":"بعد"}],"hasIhya":false},{"ayah":53,"text":"وَقَدْ كَفَرُوا۟ بِهِۦ مِن قَبْلُۖ وَيَقْذِفُونَ بِٱلْغَيْبِ مِن مَّكَانٍۭ بَعِيدٍ ","translation":"And they had already disbelieved in it before and would assault[1] the unseen from a place far away.[2]","words":[{"id":1,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":2,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":3,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":6,"arabic":"وَيَقْذِفُونَ","translit":"َnwُfِhdْqَyَw","root":"قذف"},{"id":7,"arabic":"بِٱلْغَيْبِ","translit":"ِbْyَغْlٱِb","root":"غيب"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"مَّكَانٍۭ","translit":"ٍۭnāَkَّm","root":"كون"},{"id":10,"arabic":"بَعِيدٍ","translit":"ٍdyِʿعَb","root":"بعد"}],"hasIhya":false},{"ayah":54,"text":"وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ كَمَا فُعِلَ بِأَشْيَاعِهِم مِّن قَبْلُۚ إِنَّهُمْ كَانُوا۟ فِى شَكٍّ مُّرِيبٍۭ ","translation":"And prevention will be placed between them and what they desire,[1] as was done with their kind before. Indeed, they were in disquieting doubt [i.e., denial].","words":[{"id":1,"arabic":"وَحِيلَ","translit":"َlyِḥَw","root":"حول"},{"id":2,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":3,"arabic":"وَبَيْنَ","translit":"َnْyَbَw","root":"بين"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"يَشْتَهُونَ","translit":"َnwُhَtْhsَy","root":"شهو"},{"id":6,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":7,"arabic":"فُعِلَ","translit":"َlِʿعُf","root":"فعل"},{"id":8,"arabic":"بِأَشْيَاعِهِم","translit":"mِhِʿعāَyْhsَaʾِb","root":"شيع"},{"id":9,"arabic":"مِّن","translit":"nِّm","root":""},{"id":10,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":11,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":12,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"شَكٍّ","translit":"ٍّkَhs","root":"شكك"},{"id":15,"arabic":"مُّرِيبٍۭ","translit":"ٍۭbyِrُّm","root":"ريب"}],"hasIhya":true}],"tafsir":{"1":[{"arabic":"عن هذا الترجيح بالملك وهو مجاز محض إذ لا ملك إلا لملك الملوك الذي له ما في السموات والأرض وكيف يكون العبد مالكا وهو في نفسه ليس يملك نفسه بل هو ملك غيره نعم الخلق عباد الله والأرض مائدة الله وقد أذن لهم في الأكل من مائدته بقدر حاجتهم كالملك ينصب مائدة لعبيده فمن أخذ لقمة بيمينه واحتوت عليها براجمه فجاء عبد آخر وأراد انتزاعها","english":"...to your heart, so that your heart becomes bound by it, and thus your body becomes bound in that direction in a posture of stillness and solemnity when you worship your Lord. Likewise, your actions are divided into those that are noble — such as acts of obedience — and those that are base — such as relieving oneself or spitting. So when you spit toward the direction of the Qiblah, you have indeed wronged it (ẓalamtahā) and shown ingratitude for the blessing (niʿmah) of Allah Most High upon you, by virtue of His placing the Qiblah, through whose placement the perfection of your worship is achieved. Similarly, when you put on your leather sock (khuff) and begin with the left foot, you have wronged (ẓalamta), because the sock is a protection for the foot; the foot has a share in it, and in matters of shares and portions, one ought to begin with the nobler — that is justice (al-ʿadl) and fidelity to wisdom, while its opposite is injustice (ẓulm) and ingratitude for the blessing of the sock and the foot. And this, in the eyes of the knowers (al-ʿārifīn), is a grave offense (kabīrah), even if the jurist (al-faqīh) labels it merely \"disliked\" (makrūh) — to the extent that one of them (the righteous predecessors) had gathered many measures of wheat and was giving them in charity, and when asked about the reason, he said: \"I once put on a sandal and began with the left foot inadvertently, so I wish to expiate that (kufr) through charity.\" Yes, the jurist is unable to magnify the matter in these affairs, because he is constrained — rather, he is occupied with reforming the common folk (al-ʿawāmm), whose rank approaches the rank of the beasts (al-anʿām), and they are plunged into darknesses (ẓulumāt) far greater and more immense than that such minor darknesses should appear in comparison to them. For it would be ugly to say of one who drank wine and took the cup with his left hand that he transgressed in two respects — one being the drinking, and the other the taking with the left — and of one who sold wine at the time of the call to prayer on Friday, it would be ugly to say he betrayed in two respects — {one} the selling of wine, and the other the selling at the time of the call. And of one who relieved himself in the prayer niche (miḥrāb) of a mosque with his back to the Qiblah, it would be ugly to mention his abandonment of propriety in relieving himself, in that he did not place the Qiblah to his right. For all sins are darknesses, some piled atop others, such that one is eclipsed beside another. A master may punish his slave if he uses his knife without his permission — but if he killed his most beloved son with that very knife, the unauthorized use of the knife would retain no weight or sting in itself. Thus, all the etiquettes (ādāb) that the Prophets and the Saints (al-awliyāʾ) observed, and which we have treated leniently in jurisprudence (fiqh) concerning the common folk, have as their cause this very necessity. Otherwise, all these disliked acts are deviations from justice (al-ʿadl), ingratitude for blessing (kufrān al-niʿmah), and a deficiency in the rank that conveys the servant to the degrees of proximity (darajāt al-qurb) — some of them affect the servant by diminishing proximity and lowering station, while others expel him entirely from the bounds of proximity into the realm of distance (ʿālam al-buʿd), which is the abode of the devils. Likewise, whoever breaks a branch from a tree without an urgent pressing need, and without a sound purpose, has shown ingratitude for the blessing of Allah Most High in the creation of trees and the creation of the hand. As for the hand, it was not created for frivolity, but for obedience and for deeds that aid in obedience. As for the tree, Allah Most High created it, and created for it roots, and conveyed water to it, and placed within it the power of nourishment and growth, so that it might reach the culmination of its development (munthā nashwihi), and His servants might benefit from it. So breaking it before its culmination, not in a manner by which His servants benefit, is a violation of the purpose of wisdom and a deviation from justice. But if he has a sound purpose, then that is permissible for him — for trees and animals have been made a ransom (fidāʾ) for the purposes of human beings, since both are perishable and doomed. Thus, annihilating the baser (al-akhass) for the preservation of the nobler (al-ashraf) for a time is closer to justice than squandering both. And to this points His saying, Most High: {«وَسَخَّرَ لَكُم مَّا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ جَمِيعًا مِّنْهُ»} — \"And He subjected to you whatever is in the heavens and whatever is on the earth — all from Him\" [Al-Jāthiyah: 13]. Yes — if he breaks a tree belonging to someone else, he is also a wrongdoer (ẓālim), even if he is in need, because every specific tree does not suffice for the needs of all the servants of Allah; rather, it suffices for a single need. And if one single person were to be singled out for it without preponderance (tarjīḥ) and specification (ikhtiṣāṣ), that would be injustice. So the one entitled to specification is he who obtained the seed, placed it in the ground, conveyed water to it, and undertook its care — he is more worthy of it than others, and his side is thereby established. But if it grew in dead land (mawāt al-arḍ) without any human effort, then one must seek another specification — namely, precedence in taking it (sabq ilā akhdhihi). For the one who precedes has the special property of precedence (khāṣṣiyyat al-sabq). Justice, then, is that he be most worthy of it. And the poor (al-fuqarāʾ) have expressed this preponderance by the term \"ownership\" (al-milk) — but it is pure metaphor (majāz maḥḍ), for there is no owner except the King of Kings (Malik al-Mulūk), to Whom belongs what is in the heavens and the earth. And how could a servant be an owner, when he himself does not own his own self — rather, he is the property of Another? Yes — the creatures are the servants of Allah, and the earth is the table (māʾidah) of Allah, and He has permitted them to eat from His table to the measure of their need — like a king who sets a table for his slaves. So if one takes a morsel with his right hand, and his fingers close over it, and another slave comes and seeks to snatch it away...","book_title":"Patience and Gratitude","section_title_ar":"Section 986","section_title_en":"The Etiquette of the Heart and the Hidden Dimensions of Violating Sacred Directions and Blessings","section_index":986,"anchors":"- Root: ظلم (ẓ-l-m)\n  * Lisan / Ayn: Core meaning is \"darkness\" (ẓulmah) — absence of light; also \"to place something in other than its proper place\" (waḍʿ al-shayʾ fī ghayr mawḍiʿihi).\n  * Al-Raghib (Mufradat): Ẓulm is expressed via \"darknesses\" (ẓulumāt) as ignorance, polytheism, and transgression — the opposite of nūr (light/justice).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"الظلم ظلمات يوم القيامة\" — injustice is darknesses on the Day of Judgment. Metaphorical (majāz): \"أرض مظلومة\" — land never dug, i.e., violated by first use; \"ظلم البعير\" — slaughtering an animal without cause (ʿabṭ).\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Niʿmah is a state of well-being; also \"softness\" and \"delicacy.\"\n  * Al-Raghib (Mufradat): Niʿmah is the good condition bestowed; its plural (niʿam) covers both little and much — \"وَإِن تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا\" {And if you count the blessings of Allah, you cannot enumerate them} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal: \"جلت نعمة الله\" — the blessing of Allah is immense. Metaphorical: \"خفت نعامتهم\" — their ostriches departed (i.e., they fled), showing how blessing can be \"kicked away\" (kufrān al-niʿmah).\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Ownership and dominion; the possessor (mālik) who disposes freely.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي\" — the king is one who commands and forbids; true ownership belongs only to Allah, \"لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ\" {To Him belongs what is in the heavens and the earth}.\n  * Al-Zamakhshari (Asas): Literal: \"ملك يده\" — what one's hand owns. Metaphorical: \"ملكت فلانة أمرها\" — she controlled her own affair; here, human \"ownership\" (milk) is pure metaphor (majāz maḥḍ), since real dominion is Allah's alone.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governs how qualifying clauses (e.g., \"التي بوضعها كمال عبادتك\") attach to antecedents, preserving syntactic cohesion even when embedded phrases lengthen the sentence, ensuring no semantic break occurs between the act and its moral consequence.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"2":[{"arabic":"الأرض وما يخرج منها وما ينزل من السماء وما يعرج فيها ومن فتن الليل والنهار ومن طوارق الليل والنهار إلا طارقا يطرق بخير يا رحمن فقال ذلك فطفئت شعلته وخر على وجهه (1) وقال الحسن نبئت أن جبرائيل عليه السلام أتى النبي صلى الله عليه وسلم فقال إن عفريتا من الجن يكيدك فإذا أويت إلى فراشك فاقرأ آية الكرسي // حديث الحسن نبئت أن جبريل أتى النبي صلى الله عليه وسلم فقال إن عفريتا من الجن يكيدك الحديث أخرجه ابن أبي الدنيا في مكايد الشيطان هكذا مرسلا وقال صلى الله عليه وسلم أتاني الشيطان فنازعني ثم نازع","english":"If you say: \"What then is the remedy for repelling Satan, and is the remembrance of God—exalted is He—and one's saying 'There is no might and no power except through God' (lā ḥawla wa lā quwwata illā billāh) sufficient for that?\" — Know that the remedy of the heart in this matter is to seal these entry points by purifying the heart of these blameworthy traits. And that is something whose full exposition would be lengthy; our purpose in this quarter of the book is to explain the remedy for the destructive traits (al-ṣifāt al-muhlikāt), and each trait requires a separate book, as will be explained later. Yes — when the roots of these traits are severed from the heart, Satan may still make incursions (ijtiyāzāt) and pass through it with fleeting thoughts (khaṭarāt), but he has no stability therein. And what prevents him from passing through is the remembrance of God—exalted is He—because the reality of dhikr cannot take firm hold of the heart except after the heart is built up with God-consciousness (taqwā) and purified of blameworthy traits. Otherwise, the dhikr is but the whisper of the self (ḥadīth nafs), having no authority over the heart, and so it does not repel the dominion of Satan. For this reason, God—exalted is He—said: {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ} \"Indeed, those who fear God — when an impulse touches them from Satan, they remember [Him], and at once they are insightful\" (Q 7:201). He specified thereby the God-fearing (muttaqī).","book_title":"On Invocations and Supplications","section_title_ar":"Section 603","section_title_en":"The Revival of the Religious Sciences — Section 603: On the Remedy for Evil Presumption and the Repelling of Satan","section_index":603,"anchors":"- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or being consumed by fire; also used for one who is destroyed or whose blood is shed in vain.\n  * Al-Raghib (Mufradat): الشيطان (Satan) — the one who is far removed from divine mercy, derived from the root indicating his being burned or destroyed.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط اللحم\" — meat that is burnt or spoiled by fire. Metaphorical (Majaz): \"شاط دمه\" — his blood was shed in vain (i.e., destroyed); \"أشاط السلطان دمه\" — the ruler declared his blood lawful to shed. Thus, Satan is so named for his being \"burned\" or \"destroyed\" by divine curse, and for his causing others to be destroyed.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; also the act of turning, overturning, or revolving a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning and directing of a thing from one aspect to another. The heart (qalb) is so named for its constant fluctuation and turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems. The heart's \"suwaydāʾ\" (core/blackness) is its innermost center where Satan seeks to establish his seat.\n- Root: ذكر (Dhikr)\n  * Lisan / Ayn: Remembrance, mention, recollection; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): الذكر is the presence of a thing in the mind, whether by utterance or by heart; true dhikr is that which takes root in the heart, not mere speech of the tongue.\n  * Al-Zamakhshari (Asas): Literal: uttering with the tongue. Metaphorical: the heart's presence with God, which alone has authority over the soul and repels Satan's incursions.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The verse {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا} restricts the efficacy of dhikr in repelling Satan to the God-fearing (muttaqūn), whose hearts are emptied of passions, thereby specifying the condition for its effectiveness.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"},{"arabic":"أعوذ بكلمات الله التامات التي لا يجاوزهن بر ولا فاجر من شر ما يلج في الأرض وما يخرج منها وما ينزل من السماء وما يعرج فيها ومن فتن الليل والنهار ومن طوارق الليل والنهار إلا طارقا يطرق بخير يا رحمن فقال ذلك فطفئت شعلته وخر على وجهه (1) وقال الحسن نبئت أن جبرائيل عليه السلام أتى النبي صلى الله عليه وسلم فقال إن عفريتا من الجن يكيدك فإذا أويت إلى فراشك فاقرأ آية الكرسي // حديث الحسن نبئت أن جبريل أتى النبي صلى الله عليه وسلم فقال إن عفريتا من الجن يكيدك الحديث أخرجه ابن أبي الدنيا في مكايد الشيطان هكذا مرسلا وقال صلى الله عليه وسلم أتاني الشيطان فنازعني ثم نازعني فأخذت","english":"If you say: \"What then is the remedy for repelling Satan, and is the remembrance of God—exalted is He—and one's saying 'There is no might and no power except through God' (lā ḥawla wa lā quwwata illā billāh) sufficient for that?\" — Know that the remedy of the heart in this matter is to seal these entry points by purifying the heart of these blameworthy traits. And that is something whose full exposition would be lengthy; our purpose in this quarter of the book is to explain the remedy for the destructive traits (al-ṣifāt al-muhlikāt), and each trait requires a separate book, as will be explained later. Yes — when the roots of these traits are severed from the heart, Satan may still make incursions (ijtiyāzāt) and pass through it with fleeting thoughts (khaṭarāt), but he has no stability therein. And what prevents him from passing through is the remembrance of God—exalted is He—because the reality of dhikr cannot take firm hold of the heart except after the heart is built up with God-consciousness (taqwā) and purified of blameworthy traits. Otherwise, the dhikr is but the whisper of the self (ḥadīth nafs), having no authority over the heart, and so it does not repel the dominion of Satan. For this reason, God—exalted is He—said: {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ} \"Indeed, those who fear God — when an impulse touches them from Satan, they remember [Him], and at once they are insightful\" (Q 7:201). He specified thereby the God-fearing (muttaqī).","book_title":"Disciplining the Soul","section_title_ar":"Section 603","section_title_en":"The Revival of the Religious Sciences — Section 603: On the Remedy for Evil Presumption and the Repelling of Satan","section_index":603,"anchors":"- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or being consumed by fire; also used for one who is destroyed or whose blood is shed in vain.\n  * Al-Raghib (Mufradat): الشيطان (Satan) — the one who is far removed from divine mercy, derived from the root indicating his being burned or destroyed.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط اللحم\" — meat that is burnt or spoiled by fire. Metaphorical (Majaz): \"شاط دمه\" — his blood was shed in vain (i.e., destroyed); \"أشاط السلطان دمه\" — the ruler declared his blood lawful to shed. Thus, Satan is so named for his being \"burned\" or \"destroyed\" by divine curse, and for his causing others to be destroyed.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; also the act of turning, overturning, or revolving a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning and directing of a thing from one aspect to another. The heart (qalb) is so named for its constant fluctuation and turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems. The heart's \"suwaydāʾ\" (core/blackness) is its innermost center where Satan seeks to establish his seat.\n- Root: ذكر (Dhikr)\n  * Lisan / Ayn: Remembrance, mention, recollection; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): الذكر is the presence of a thing in the mind, whether by utterance or by heart; true dhikr is that which takes root in the heart, not mere speech of the tongue.\n  * Al-Zamakhshari (Asas): Literal: uttering with the tongue. Metaphorical: the heart's presence with God, which alone has authority over the soul and repels Satan's incursions.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The verse {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا} restricts the efficacy of dhikr in repelling Satan to the God-fearing (muttaqūn), whose hearts are emptied of passions, thereby specifying the condition for its effectiveness.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Disciplining the Soul'","badge":"Hadith"}],"3":[{"arabic":"إحاطة خارجة عن النهاية حتى لا يعزب عنه مثقال ذرة في السموات ولا في الأرض وقد خاطب الخلق كلهم فقال عز وجل وما أوتيتم من العلم إلا قليلا بل لو اجتمع أهل الأرض والسماء على أن يحيطوا بعلمه وحكمته في تفصيل خلق نملة أو بعوضة لم يطلعوا على عشر عشير ذلك ولا يحيطون بشيء من علمه إلا بما شاء والقدر اليسير الذي علمه الخلائق كلهم فبتعليمه علموه كما قال تعالى خلق الإنسان علمه البيان فإن كان جمال العلم وشرفه أمرا محبوبا وكان هو في نفسه زينة وكمالا للموصوف به فلا ينبغي أن يحب بهذا السبب إلا الله تعالى فعلوم العلماء جهل","english":"As for knowledge — where is the knowledge of the first and the last among all creation compared to the knowledge of Allah, the Exalted, which encompasses all things with an encompassing that transcends all limit, so that not even the weight of an atom escapes Him in the heavens or on the earth? He has addressed all of creation, saying, the Mighty and Majestic: {«وَمَا أُوتِيتُم مِّنَ الْعِلْمِ إِلَّا قَلِيلًا»} (And you have not been given of knowledge except a little) (Q 17:85). Nay, even if all the inhabitants of the earth and the heavens were to gather together to encompass His knowledge and His wisdom in the detailed formation of a single ant or gnat, they would not attain to one-tenth of a tenth of that — {«وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ»} (And they do not encompass anything of His knowledge except what He wills) (Q 2:255). And the paltry measure that all creatures have learned, they have learned only through His teaching, as He, the Exalted, said: {«خَلَقَ الْإِنسَانَ عَلَّمَهُ الْبَيَانَ»} (He created man; He taught him eloquence) (Q 55:3-4). If, therefore, the beauty and nobility of knowledge is something beloved, and it is in itself an adornment and perfection for the one described by it, then it is not fitting that anyone be loved for this reason except Allah, the Exalted alone.","book_title":"Monitoring and Accounting","section_title_ar":"Section 1155","section_title_en":"The Beauty of Divine Attributes and the Relative Nature of Human Perfection","section_index":1155,"anchors":"- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning of perception, cognition, and certain apprehension of a thing's reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; it is twofold: apprehension of the essence, and judgment affirming or negating a predicate.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine cognition; metaphorical (majāz) usage extends to perception and awareness. Here, the comparative \"أعلم/أجهل\" (more knowing/ more ignorant) operates on a scale of relative apprehension.\n- Root: قدر (qadara)\n  * Lisan / Ayn: Root denotes measuring, determining, and the capacity to bring about an effect.\n  * Al-Raghib (Mufradat): \"القدرة إذا وصف بها الإنسان فاسم لهيئة له بها يتمكن من فعل شيء ما، وإذا وصف الله تعالى بها فهي نفي العجز عنه\" — power in man is a disposition enabling specific acts; power in God is absolute negation of incapacity, unrestricted and infinite.\n  * Al-Zamakhshari (Asas): Literal: \"هو قادر مقتدر ذو قدرة ومقدرة\" — the possessor of power. Metaphorical: extended to strength and dominion. The text contrasts finite human power (maqdūr) with divine power that encompasses all things without limit.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Self, soul, essence; the innermost reality of a thing.\n  * Al-Raghib (Mufradat): \"نفسه: ذاته\" — God's \"self\" is His very essence. For man, nafs denotes the composite self that requires discipline and reform (iṣlāḥ).\n  * Al-Zamakhshari (Asas): Literal: the self as the seat of attributes; metaphorical: \"دفق نفسه\" — blood/life. Here, \"سياسة نفسه\" (governance of one's self) is the literal, ethical sense.\n- Root: خلق (khalaqa)\n  * Lisan / Ayn: Root denotes measuring, smoothing, and fashioning; also moral character (khuluq).\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — origination by precise measure; used for creation ex nihilo and for formation from existing matter.\n  * Al-Zamakhshari (Asas): Literal: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom. The text uses \"الخبائث\" (vices) as the corruption of this created nature.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"فإنما غايته أن يقدر\" restricts human power to a finite limit, emphasizing that the utmost reach of creaturely capacity is merely partial and derivative, never absolute.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'","badge":"Insight"}],"4":[{"arabic":"كأنك حفي عنها أي يسألونك عنها كأنك حفي بها وقوله عز وجل لهم مغفرة ورزق كريم كما أخرجك ربك من بيتك بالحق فهذا الكلام غير متصل وإنما هو عائد إلى قوله السابق قل الأنفال لله والرسول كما أخرجك ربك من بيتك بالحق أي فصارت أنفال الغنائم لك إذ أنت راض بخروجك وهم كارهون فاعترض بين الكلام الأمر بالتقوى وغيره ومن هذا النوع قوله عز وجل حتى تؤمنوا بالله وحده إلا قول إبراهيم لأبيه الآية ومنها المبهم وهو اللفظ المشترك بين معن من كلمة أو حرف أما الكلمة فكالشيء والقرين والأمة والروح ونظائرها قال الله تعالى ضرب الله مثلا عبدا مملوكا لا ي","english":"I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 233","section_title_en":"The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation","section_index":233,"anchors":"- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"}],"8":[{"arabic":"الله تعالى بين من افترى على الله كذبا وبين من كذب بالحق فقال تعالى ومن أظلم ممن افترى على الله كذبا أو كذب بالحق لما جاءه وقال تعالى فمن أظلم ممن كذب على الله وكذب بالصدق إذ جاءه ومنها الرياء وملاحظة الخلق والجهد في استمالة قلوبهم وصرف وجوههم والرياء هو الداء العضال الذي يدعو إلى أكبر الكبائر كما سيأتي في كتاب الرياء والمناظر لا يقصد إلا الظهور عند الخلق وانطلاق ألسنتهم بالثناء عليه فهذه عشر خصال من أمهات الفواحش الباطنة سوى ما يتفق لغير المتماسكين منهم من الخصام المؤدي إلى الضرب","english":"**QUAD_ANCHORS:**\n- Root: نظر (naẓara)\n  * Lisan / Ayn: Core meaning: to look, to examine, to consider; al-munāẓarah is mutual examination/argumentation between two parties.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as intellectual contemplation (taʾammul bi-l-baṣīrah); munāẓarah as dialectical exchange.\n  * Al-Zamakhshari (Asas): Literal: sitting face-to-face in debate; Metaphorical: disputation for victory.\n- Root: غلب (ghalaba)\n  * Lisan / Ayn: Core meaning: to overcome, to conquer, to prevail.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghalabah as seeking to dominate another in argument.\n  * Al-Zamakhshari (Asas): Literal: victory in combat; Metaphorical: intellectual supremacy.\n- Root: حسد (ḥasada)\n  * Lisan / Ayn: Core meaning: to envy, to wish removal of blessings from another.\n  * Al-Raghib (Mufradat): Theological nuance: envy as wishing deprivation of blessings from the deserving — among the basest traits.\n  * Al-Zamakhshari (Asas): Literal: envy of another's blessing; Metaphorical: consuming fire of the soul.\n- Root: كبر (kabura)\n  * Lisan / Ayn: Core meaning: to be great, to be haughty.\n  * Al-Raghib (Mufradat): Theological nuance: al-kibr as self-elevation above others; condemned by God.\n  * Al-Zamakhshari (Asas): Literal: greatness; Metaphorical: arrogance and pride.\n- Root: غيب (ghāba)\n  * Lisan / Ayn: Core meaning: to be absent, to be hidden.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghībah as mentioning another with what he dislikes in his absence — likened to eating carrion.\n  * Al-Zamakhshari (Asas): Literal: backbiting; Metaphorical: consuming the flesh of one's brother.\n- Root: راءى (rāʾā)\n  * Lisan / Ayn: Core meaning: to show off, to display.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as performing acts for the sake of being seen — hidden shirk.\n  * Al-Zamakhshari (Asas): Literal: showing good deeds; Metaphorical: seeking reputation.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Core meaning: self, soul, spirit.\n  * Al-Raghib (Mufradat): Theological nuance: tazkiyat al-nafs as self-praise and self-purification — forbidden by God.\n  * Al-Zamakhshari (Asas): Literal: self; Metaphorical: self-commendation.\n- Root: حقd (ḥaqida)\n  * Lisan / Ayn: Core meaning: to bear malice, to harbor resentment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ḥiqd as nursing enmity in the heart — negated from the believer.\n  * Al-Zamakhshari (Asas): Literal: bearing grudge; Metaphorical: hidden rancor.\n- Root: نفاق (nifāq)\n  * Lisan / Ayn: Core meaning: hypocrisy, showing contrary to what one conceals.\n  * Al-Raghib (Mufradat): Theological nuance: hypocrisy in deeds — outward display contrary to inward state.\n  * Al-Zamakhshari (Asas): Literal: hypocrisy in faith; Metaphorical: hypocrisy in character.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning: to know, to perceive.\n  * Al-Raghib (Mufradat): Theological nuance: knowledge as apprehension of reality — its pursuit for other than God is destructive.\n  * Al-Zamakhshari (Asas): Literal: knowledge; Metaphorical: the dangerous burden of the scholar.\n- Root: جدل (jadala)\n  * Lisan / Ayn: Core meaning: to argue, to dispute.\n  * Al-Raghib (Mufradat): Theological nuance: al-jidāl as contention; al-mirāʾ as disputation with falsehood — condemned.\n  * Al-Zamakhshari (Asas): Literal: argumentation; Metaphorical: obstinate disputation.\n- Root: شرك (sharaka)\n  * Lisan / Ayn: Core meaning: to associate, to share.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as hidden shirk — associating others with God in intention.\n  * Al-Zamakhshari (Asas): Literal: polytheism; Metaphorical: hidden association in deeds.\n- Root: موت (māta)\n  * Lisan / Ayn: Core meaning: to die.\n  * Al-Raghib (Mufradat): Theological nuance: death as separation of soul from body; spiritual death as ruin of the soul.\n  * Al-Zamakhshari (Asas): Literal: physical death; Metaphorical: spiritual destruction.\n- Root: حيى (ḥayiya)\n  * Lisan / Ayn: Core meaning: to live.\n  * Al-Raghib (Mufradat): Theological nuance: life as the power of perception; eternal life as the reward of the righteous.\n  * Al-Zamakhshari (Asas): Literal: physical life; Metaphorical: spiritual vitality.\n- Root: هلك (halaka)\n  * Lisan / Ayn: Core meaning: to perish, to be destroyed.\n  * Al-Raghib (Mufradat): Theological nuance: al-halāk as ruin; eternal destruction as everlasting punishment.\n  * Al-Zamakhshari (Asas): Literal: destruction; Metaphorical: eternal ruin.\n- Root: رياء (riyāʾ)\n  * Lisan / Ayn: Core meaning: showing off, ostentation.\n  * Al-Raghib (Mufradat): Theological nuance: riyāʾ as the incurable disease calling to the greatest sins.\n  * Al-Zamakhshari (Asas): Literal: ostentation; Metaphorical: spiritual disease.\n- Root: جاه (jāh)\n  * Lisan / Ayn: Core meaning: rank, status, prestige.\n  * Al-Raghib (Mufradat): Theological nuance: love of status (ḥubb al-jāh) among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: position; Metaphorical: seeking prestige.\n- Root: مباهاة (mubāhāh)\n  * Lisan / Ayn: Core meaning: mutual boasting, vying in splendor.\n  * Al-Raghib (Mufradat): Theological nuance: mubāhāh as each seeking to display superiority over the other.\n  * Al-Zamakhshari (Asas): Literal: mutual boasting; Metaphorical: rivalry in honor.\n- Root: مماراة (mumārāh)\n  * Lisan / Ayn: Core meaning: disputation, wrangling.\n  * Al-Raghib (Mufradat): Theological nuance: al-mirāʾ as contentious argument — condemned by the Prophet.\n  * Al-Zamakhshari (Asas): Literal: disputation; Metaphorical: obstinate wrangling.\n- Root: فخر (fakhara)\n  * Lisan / Ayn: Core meaning: to boast, to pride oneself.\n  * Al-Raghib (Mufradat): Theological nuance: al-fakhr as self-glorification — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: boasting; Metaphorical: vainglory.\n- Root: عجب (ʿajiba)\n  * Lisan / Ayn: Core meaning: to wonder, to be amazed.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿujb as self-admiration — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: wonder; Metaphorical: self-conceit.\n- Root: بغض (baghiḍa)\n  * Lisan / Ayn: Core meaning: to hate, to detest.\n  * Al-Raghib (Mufradat): Theological nuance: al-baghdāʾ as mutual hatred — contrary to brotherhood.\n  * Al-Zamakhshari (Asas): Literal: hatred; Metaphorical: mutual enmity.\n- Root: غضب (ghaḍiba)\n  * Lisan / Ayn: Core meaning: to be angry.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaḍab as anger — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: anger; Metaphorical: rage.\n- Root: طمع (ṭamiʿa)\n  * Lisan / Ayn: Core meaning: to covet, to desire.\n  * Al-Raghib (Mufradat): Theological nuance: al-ṭamaʿ as covetousness — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: desire; Metaphorical: greed.\n- Root: أشر (ashira)\n  * Lisan / Ayn: Core meaning: to be exultant, to be insolent.\n  * Al-Raghib (Mufradat): Theological nuance: al-ashar as excessive joy and insolence — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: exultation; Metaphorical: insolence.\n- Root: بطر (baṭira)\n  * Lisan / Ayn: Core meaning: to be arrogant, to be ungrateful.\n  * Al-Raghib (Mufradat): Theological nuance: al-baṭar as arrogance in prosperity — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: arrogance; Metaphorical: ingratitude for blessings.\n- Root: خيلاء (khuyalāʾ)\n  * Lisan / Ayn: Core meaning: pride, haughtiness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khuyalāʾ as pride and conceit — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: pride; Metaphorical: haughty bearing.\n- Root: خشية (khashyah)\n  * Lisan / Ayn: Core meaning: fear, awe.\n  * Al-Raghib (Mufradat): Theological nuance: al-khashyah as reverential fear — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: fear; Metaphorical: reverential awe.\n- Root: رحمة (raḥmah)\n  * Lisan / Ayn: Core meaning: mercy, compassion.\n  * Al-Raghib (Mufradat): Theological nuance: al-raḥmah as tenderness of heart — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: mercy; Metaphorical: compassion.\n- Root: غفلة (ghaflah)\n  * Lisan / Ayn: Core meaning: heedlessness, inattention.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaflah as heedlessness — contrary to vigilance.\n  * Al-Zamakhshari (Asas): Literal: inattention; Metaphorical: spiritual heedlessness.\n- Root: خشوع (khushūʿ)\n  * Lisan / Ayn: Core meaning: humility, submissiveness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khushūʿ as humility — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: humility; Metaphorical: devotional submission.\n- Root: تذكير (tadhkīr)\n  * Lisan / Ayn: Core meaning: reminding, admonishing.\n  * Al-Raghib (Mufradat): Theological nuance: al-tadhkīr as reminding of God — a righteous act.\n  * Al-Zamakhshari (Asas): Literal: reminding; Metaphorical: preaching.\n- Root: وعظ (waʿaẓa)\n  * Lisan / Ayn: Core meaning: to admonish, to exhort.\n  * Al-Raghib (Mufradat): Theological nuance: al-waʿẓ as exhortation to obedience and warning against disobedience.\n  * Al-Zamakhshari (Asas): Literal: admonition; Metaphorical: sermonizing.\n- Root: فتوى (fatwā)\n  * Lisan / Ayn: Core meaning: legal ruling, formal opinion.\n  * Al-Raghib (Mufradat): Theological nuance: al-fatwā as clarification of legal rulings.\n  * Al-Zamakhshari (Asas): Literal: legal opinion; Metaphorical: religious authority.\n- Root: قضاء (qaḍāʾ)\n  * Lisan / Ayn: Core meaning: judgment, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-qaḍāʾ as judgment between people.\n  * Al-Zamakhshari (Asas): Literal: judgment; Metaphorical: judicial authority.\n- Root: وقف (waqafa)\n  * Lisan / Ayn: Core meaning: to stop, to stand.\n  * Al-Raghib (Mufradat): Theological nuance: al-waqf as endowment of property for charitable purposes.\n  * Al-Zamakhshari (Asas): Literal: standing; Metaphorical: religious endowment.\n- Root: ثواب (thawāb)\n  * Lisan / Ayn: Core meaning: reward, recompense.\n  * Al-Raghib (Mufradat): Theological nuance: al-thawāb as divine recompense for righteous deeds.\n  * Al-Zamakhshari (Asas): Literal: reward; Metaphorical: divine recompense.\n- Root: عذاب (ʿadhāb)\n  * Lisan / Ayn: Core meaning: punishment, torment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿadhāb as divine punishment for the disobedient.\n  * Al-Zamakhshari (Asas): Literal: punishment; Metaphorical: divine chastisement.\n- Root: ملك (malaka)\n  * Lisan / Ayn: Core meaning: to possess, to rule.\n  * Al-Raghib (Mufradat): Theological nuance: al-mulk as sovereignty; al-mulk al-muʾabbad as eternal sovereignty in Paradise.\n  * Al-Zamakhshari (Asas): Literal: dominion; Metaphorical: eternal kingdom.\n- Root: نعيم (naʿīm)\n  * Lisan / Ayn: Core meaning: bliss, delight.\n  * Al-Raghib (Mufradat): Theological nuance: al-naʿīm as bliss; al-naʿīm al-sarmad as everlasting bliss.\n  * Al-Zamakhshari (Asas): Literal: delight; Metaphorical: eternal bliss.\n- Root: رخصة (rukhaṣah)\n  * Lisan / Ayn: Core meaning: concession, dispensation.\n  * Al-Raghib (Mufradat): Theological nuance: al-rukhaṣah as legal concession.\n  * Al-Zamakhshari (Asas): Literal: concession; Metaphorical: legal dispensation.\n- Root: رياسة (riyāsah)\n  * Lisan / Ayn: Core meaning: leadership, headship.\n  * Al-Raghib (Mufradat): Theological nuance: love of leadership among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: leadership; Metaphorical: seeking authority.\n- Root: اندراس (indirās)\n  * Lisan / Ayn: Core meaning: effacement, obliteration.\n  * Al-Raghib (Mufradat): Theological nuance: indirās al-ʿulūm as the obliteration of the sciences.\n  * Al-Zamakhshari (Asas): Literal: effacement; Metaphorical: extinction of knowledge.\n- Root: صبيان (ṣibyān)\n  * Lisan / Ayn: Core meaning: boys, children.\n  * Al-Raghib (Mufradat): Theological nuance: children's motivation for learning through play.\n  * Al-Zamakhshari (Asas): Literal: boys; Metaphorical: pupils.\n- Root: مكتب (maktab)\n  * Lisan / Ayn- Root: مكتب (maktab)\n  * Lisan / Ayn: Core meaning: place of instruction, school for boys.\n  * Al-Raghib (Mufradat): Theological nuance: the elementary school where children are taught.\n  * Al-Zamakhshari (Asas): Literal: school; Metaphorical: place of elementary learning.\n- Root: خلاق (khilāq)\n  * Lisan / Ayn: Core meaning: portion, share, lot.\n  * Al-Raghib (Mufradat): Theological nuance: \"no portion\" (lā khilāq) in the Hereafter — utter deprivation of divine reward.\n  * Al-Zamakhshari (Asas): Literal: share; Metaphorical: spiritual allotment in the afterlife.\n- Root: فاجر (fājir)\n  * Lisan / Ayn: Core meaning: wicked, immoral, profligate.\n  * Al-Raghib (Mufradat): Theological nuance: the dissolute one who commits sins openly.\n  * Al-Zamakhshari (Asas): Literal: sinner; Metaphorical: one through whom God nonetheless supports religion.\n- Root: شمع (shamʿ)\n  * Lisan / Ayn: Core meaning: candle, wax taper.\n  * Al-Raghib (Mufradat): Theological nuance: the candle as parable — consuming itself while giving light to others.\n  * Al-Zamakhshari (Asas): Literal: candle; Metaphorical: one who destroys himself but benefits others.\n- Root: نار (nār)\n  * Lisan / Ayn: Core meaning: fire.\n  * Al-Raghib (Mufradat): Theological nuance: fire as parable — consuming itself and all around it.\n  * Al-Zamakhshari (Asas): Literal: fire; Metaphorical: one who destroys himself and others.\n- Root: سعد (saʿida)\n  * Lisan / Ayn: Core meaning: to be fortunate, to prosper.\n  * Al-Raghib (Mufradat): Theological nuance: saʿādah as felicity — success in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: good fortune; Metaphorical: eternal felicity.\n- Root: شقي (shaqiya)\n  * Lisan / Ayn: Core meaning: to be wretched, to be miserable.\n  * Al-Raghib (Mufradat): Theological nuance: shaqāwah as wretchedness — ruin in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: misery; Metaphorical: eternal ruin.\n- Root: أخلص (akhlaṣa)\n  * Lisan / Ayn: Core meaning: to purify, to be sincere.\n  * Al-Raghib (Mufradat): Theological nuance: ikhlāṣ as purifying intention for God alone — the condition of acceptance.\n  * Al-Zamakhshari (Asas): Literal: sincerity; Metaphorical: pure devotion.\n- Root: ريب (rāba)\n  * Lisan / Ayn: Core meaning: to doubt, to suspect.\n  * Al-Raghib (Mufradat): Theological nuance: al-rayb as doubt and uncertainty — to be dispelled by evidence.\n  * Al-Zamakhshari (Asas): Literal: doubt; Metaphorical: skepticism.","book_title":"Book of Knowledge","section_title_ar":"Section 39","section_title_en":"Section 39","section_index":39,"anchors":"*(Anchors established)*","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Book of Knowledge'","badge":"Ethics"}],"10":[{"arabic":"وكان فضل الله عليك عظيما وقال تعالى ولقد آتينا داود منا فضلا يعني العلم فتعلم العلم في هذا اليوم وتعليمه من أفضل القربات والصلاة أفضل من مجالس القصاص إذ كانوا يرونه بدعة ويخرجون القصاص من الجامع بكر ابن عمر رضي الله عنهما إلى مجلسه في المسجد الجامع فإذا قاص في موضعه فقال قم عن مجلسي فقال لا أقوم وقد جلست وسبقتك إليه فأرسل ابن عمر إلى صاحب الشرطة فأقامه، فلو كان ذلك من السنة لما جازت إقامته فقد قال صلى الله عليه وسلم لا يقيمن أحدكم أخاه من مجلسه ثم يجلس فيه ولكن تفسحوا وتوسعوا (4) وكان ابن عمر إذا قام الرج","english":"Know that the one who attends the Friday prayer should remain in the mosque until he prays the afternoon prayer (al-ʿaṣr); and if he remains until the sunset prayer (al-maghrib), that is even more excellent. It is said: \"Whoever prays the afternoon prayer in the congregational mosque (al-jāmiʿ) shall have the reward of the Pilgrimage (ḥajj); and whoever prays the sunset prayer therein shall have the reward of a Pilgrimage and an ʿUmra.\" However, if he does not feel secure from ostentation (al-taṣabbuʿ) and from harm befalling him through the gaze of people upon his seclusion (iʿtikāf), or he fears plunging into what does not concern him, then it is more excellent that he return to his house, remembering Allah (mighty and majestic), reflecting upon His graces (ālāʾihi), thanking Allah the Exalted for His granting of success (tawfīq), fearing his own shortcoming, and watching over his heart and his tongue until the setting of the sun — so that the noble hour (al-sāʿa al-sharīfa) does not pass him by. Nor should he speak in the congregational mosque or in other mosques about the affairs of this world. The Messenger of Allah (peace and blessings be upon him) said: {«يَأْتِي عَلَى النَّاسِ زَمَانٌ يَكُونُ حَدِيثُهُمْ فِي مَسَاجِدِهِمْ أَمْرَ دُنْيَاهُمْ لَيْسَ لِلَّهِ تَعَالَى فِيهِمْ حَاجَةٌ فَلَا تُجَالِسُوهُمْ»} — \"A time will come upon people when their conversation in their mosques will be about their worldly affairs; Allah the Exalted has no need of them, so do not sit with them.\" (1)","book_title":"Mysteries of Prayer","section_title_ar":"Section 150","section_title_en":"Section 150","section_index":150,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'","badge":"Insight"}],"12":[{"arabic":"الله عليك بأبي أنت وأمي يا رسول الله لئن كان سليمان بن داود أعطاه الله الريح غدوها شهر ورواحها شهر فماذا بأعجب من البراق حين سريت عليه إلى السماء السابعة ثم صليت الصبح من ليلتك بالأبطح صلى الله عليك بأبي أنت وأمي يا رسول الله لئن كان عيسى بن مريم أعطاه الله إحياء الموتى فماذا بأعجب من الشاة المسمومة حين كلمتك وهي مشوية فقالت لك الذراع لا تأكلني فإني مسمومة بأبي أنت وأمي يا رسول الله لقد دعا نوح على قومه فقال رب لا تذر على الأرض من الكافرين ديارا ولو دعوت علينا بمثلها لهلكنا فلقد وطىء ظهرك وأدمي وجهك وكسرت رباعيتك فأبيت أن تقول إلا خيرا","english":"God Most High has said: {«Indeed, God and His angels send blessings upon the Prophet. O you who have believed, send blessings upon him and greet him with a greeting of peace»} (Q. 33:56). And it is related that he, peace be upon him, came one day with the signs of glad tidings visible upon his face, and he, peace be upon him, said: \"Gabriel came to me, peace be upon him, and said: 'Are you not pleased, O Muhammad, that no one from your community sends a single blessing upon you except that I send ten blessings upon him, and no one from your community greets you with peace except that I greet him with peace ten times?'\" (1) And he, peace be upon him, said: \"Whoever sends blessings upon me, the angels send blessings upon him as long as he continues to send blessings upon me — so let him reduce or increase at that.\" (2) And he, peace be upon him, said: \"The people most deserving of me are those who send the most blessings upon me.\" (3) And he, peace be upon him, said: \"It suffices a believer for miserliness that I am mentioned in his presence and he does not send blessings upon me.\" (4) And he, peace be upon him, said: \"Multiply your sending of blessings upon me on the day of Friday.\" (5) And he, peace be upon him, said: \"Whoever sends blessings upon me from my community, ten good deeds are written for him and ten evil deeds are erased from him.\" (6) And he, peace be upon him, said: \"Whoever says upon hearing the call to prayer and the iqāmah: 'O God, Lord of this perfect call and the established prayer, send blessings upon Muhammad, Your servant and Your Messenger, and grant him the means (al-wasīlah) and the excellence (al-faḍīlah) and the lofty rank (al-darajah al-rafīʿah) and the intercession (al-shafāʿah) on the Day of Resurrection' — my intercession becomes permissible for him.\" (7) And the Messenger of God, peace be upon him, said: \"Whoever sends blessings upon me in a book, the angels continue to seek forgiveness for him as long as my name remains in that book.\" (8) And he, peace be upon him, said: \"Indeed, upon the earth there are traveling angels who convey to me the greetings of peace from my community.\" (9) And he, peace be upon him, said: \"No one greets me with peace except that God returns my soul to me until I respond to his greeting.\" (1) And it was said to him: \"O Messenger of God, how do we send blessings upon you?\" He said: \"Say: 'O God, send blessings upon Muhammad, Your servant, and upon his family, his wives, and his descendants, as You sent blessings upon Abraham and the family of Abraham; and bless Muhammad, his wives, and his descendants, as You blessed Abraham and the family of Abraham. Indeed, You are Praiseworthy, Glorious.'\" (2)","book_title":"On Invocations and Supplications","section_title_ar":"Section 244","section_title_en":"Section 244 — On the Virtues of Invoking Blessings upon the Prophet (Ṣalawāt) and the Excellence of His Rank","section_index":244,"anchors":"- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: Core root denotes prayer, blessing, supplication; al-ṣalāh from God is mercy (raḥmah), from angels is seeking forgiveness (istighfār), from believers is supplication (duʿā').\n  * Al-Raghib (Mufradat): Al-ṣalāh from God is pure mercy and beneficence; from angels it is their petition for forgiveness; from humans it is humble supplication. The divine ṣalāh upon the Prophet is an elevation of his mention and an increase in his honor.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): supplication and bending in worship. Metaphorical (majāz): God's ṣalāh upon the Prophet is His mercy and His exaltation of him before the angels; the believers' ṣalāh is their invocation and reverence.\n- Root: سلم (S-L-M)\n  * Lisan / Ayn: Root denotes safety, peace, deliverance; taslīm is the greeting of peace and submission.\n  * Al-Raghib (Mufradat): Salām from God is His safeguarding; the greeting of salām upon the Prophet is an acknowledgment of his prophetic rank and a prayer for his perfect safety.\n  * Al-Zamakhshari (Asas): Literal: greeting of peace. Metaphorical: the angels' conveyance of the believers' salām to the Prophet even after his death, indicating the enduring bond.\n- Root: حمد (Ḥ-M-D)\n  * Lisan / Ayn: Core root denotes praise, commendation; maḥmūd is the one praised.\n  * Al-Raghib (Mufradat): Ḥamd is praise for voluntary beneficence; al-ḥamd li-Llāh encompasses all praise due to God's perfect attributes.\n  * Al-Zamakhshari (Asas): Literal: to praise for good. Metaphorical: to find praiseworthy (aḥmadtu al-arḍ: I found the land agreeable).\n- Sibawayh Rule: Rule of Interposition (al-faṣl bayna al-jār wa al-majrūr) — The periodic structure of the ḥadīth reports here follows the canonical pattern of embedding quoted speech within narrative frames, maintaining syntactic cohesion across multiple levels of reported discourse.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'On Invocations and Supplications'","badge":"Afterlife"}],"13":[{"arabic":"رتبة الشكر طعن اللعين في الخلق فقال ولا تجد اكثرم شاكرين وقال تعالى وقليل من عبادي الشكور وقد قطع الله تعالى بالمزيد مع الشكر ولم يستثن فقال تعالى لئن شكرتم لأزيدنكم واستثنى في خمسة أشياء في الإغناء والإجابة والرزق والمغفرة والتوبة فقال تعالى فسوف يغنيكم الله من فضله إن شاء {وقال} فيكشف ما تدعون إليه إن شاء {وقال} يرزق من يشاء بغير حساب {وقال} ويغفر ما دون ذلك لمن يشاء {وقال} ويتوب الله على من يشاء وهو خلق من أخلاق الربوبية إذ قال تعالى والله شكور حليم وقد جعل الله الشكر مفتاح كلام أهل الجنة فقال تعالى وقالوا الحمد لله الذي صدقناه","english":"So then, what we have mentioned concerning the treatment of patience (ṣabr) regarding whispered insinuation (waswās), regarding lust (shahwah), and regarding status (jāh) — annex this to what we have already set down concerning the canons of the paths of spiritual striving (mujāhadah) in the Book of the Discipline of the Soul (Kitāb Riyāḍat al-Nafs) from the Quarter of the Destroyers (rubʿ al-muhlikāt). Adopt it as your manual (dastūr) by which you may come to know the treatment of patience in all the categories which we have previously detailed; for the detailing of individual cases is prolix. Whoever observes gradual progression (tadrīj), patience will elevate him to a state wherein patience without it becomes as arduous as it once was with it — so his affairs become inverted, and what was once beloved to him becomes loathed, and what was once detested to him becomes a sweet, wholesome draught from which he cannot bear to be patient [in abstaining]. This is known only through experience (tajribah) and tasting (dhawq). It has an analogue in customary habits: for a boy is compelled to learning in the beginning by force, and so patience with play and patience with knowledge are both arduous for him — until, when his inner sight is opened and he finds intimacy with knowledge, the matter is inverted, and it becomes arduous for him to be patient in abstaining from knowledge, and to endure play. To this points what is narrated of one of the knowers (ʿārifīn) that he asked al-Shiblī: \"Patience — which of its kinds is the most severe?\" He said: \"Patience in God (fī Allāh).\" He said: \"No.\" He said: \"Patience for God (li-Allāh).\" He said: \"No.\" He said: \"Patience with God (maʿa Allāh).\" He said: \"No.\" He said: \"Then what?\" He said: \"Patience from God (ʿan Allāh).\" At that al-Shiblī cried out a cry by which his soul nearly perished. And it has been said concerning the meaning of His saying, the Exalted: {«اصبروا وصابروا ورابطوا»} \"Be patient, and vie in patience, and be steadfast\" (Q. 3:200): \"Be patient in God, vie in patience by God, and be steadfast with God.\" And it was said: \"Patience for God is sufficiency (ghināʾ); patience by God is endurance (baqāʾ); patience with God is fidelity (wafāʾ); and patience from God is abandonment (jafāʾ).\" And it was said concerning its meaning:","book_title":"Patience and Gratitude","section_title_ar":"Section 972","section_title_en":"The Revival of the Religious Sciences — Section 972: On Patience (al-Sabr) and the Commencement of Gratitude (al-Shukr)","section_index":972,"anchors":"- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; al-Khalil notes its application to holding back an animal from fodder, and to enduring constraint.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — the withholding of the self in constriction; it is a general term whose specific names (shajāʿah, ḥilm, etc.) vary by context, and its opposite is al-jazaʿ (panic/vexation).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — enduring what is disliked and restraining from what is loved. Metaphorical (majāz): \"صبرت يمينه\" — binding an oath strenuously; \"أصبر على الضرب من الأرض\" — more enduring than the earth.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: The root denotes manifestation and fullness; al-Ayn links it to an overflowing udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — the perception of a blessing and its display; it is the opposite of kufr (covering/denial). It has three degrees: of the heart (perception), of the tongue (praise), and of the limbs (requital).\n  * Al-Zamakhshari (Asas): Literal: \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical: \"دابة شكور\" — a beast that thrives on little fodder, displaying its owner's care through its fatness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; al-Ayn treats it under the entry of umm (source/origin), indicating that knowledge is the root to which all else is annexed.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing by its true reality, either by grasping its essence or by affirming/denying a predicate of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to be aware/perceive. It is also used for the landmarks (maʿālim) of the road, i.e., traces by which one is guided.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: The kindling and blazing of fire; al-Ayn records it under the entry of w-q-d with the sense of fuel and flame.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is both the fuel and the resulting flame, as in {«وقودها الناس والحجارة»} (Q. 2:24).\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed fiercely. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقدة الصيف\" — the blazing heat of summer.\n- Sibawayh Rule: Interposition between the operative word and its object (al-faṣl bayna al-ʿāmil wa al-maʿmūl fīhi) — governing the placement of circumstantial qualifiers (ḥāl) and prepositional phrases to preserve the intended semantic restriction, as in the verse \"اصبروا وصابروا ورابطوا\" where each imperative carries a distinct operative scope.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"22":[{"arabic":"إحاطة خارجة عن النهاية حتى لا يعزب عنه مثقال ذرة في السموات ولا في الأرض وقد خاطب الخلق كلهم فقال عز وجل وما أوتيتم من العلم إلا قليلا بل لو اجتمع أهل الأرض والسماء على أن يحيطوا بعلمه وحكمته في تفصيل خلق نملة أو بعوضة لم يطلعوا على عشر عشير ذلك ولا يحيطون بشيء من علمه إلا بما شاء والقدر اليسير الذي علمه الخلائق كلهم فبتعليمه علموه كما قال تعالى خلق الإنسان علمه البيان فإن كان جمال العلم وشرفه أمرا محبوبا وكان هو في نفسه زينة وكمالا للموصوف به فلا ينبغي أن يحب بهذا السبب إلا الله تعالى فعلوم العلماء جهل","english":"As for knowledge — where is the knowledge of the first and the last among all creation compared to the knowledge of Allah, the Exalted, which encompasses all things with an encompassing that transcends all limit, so that not even the weight of an atom escapes Him in the heavens or on the earth? He has addressed all of creation, saying, the Mighty and Majestic: {«وَمَا أُوتِيتُم مِّنَ الْعِلْمِ إِلَّا قَلِيلًا»} (And you have not been given of knowledge except a little) (Q 17:85). Nay, even if all the inhabitants of the earth and the heavens were to gather together to encompass His knowledge and His wisdom in the detailed formation of a single ant or gnat, they would not attain to one-tenth of a tenth of that — {«وَلَا يُحِيطُونَ بِشَيْءٍ مِّنْ عِلْمِهِ إِلَّا بِمَا شَاءَ»} (And they do not encompass anything of His knowledge except what He wills) (Q 2:255). And the paltry measure that all creatures have learned, they have learned only through His teaching, as He, the Exalted, said: {«خَلَقَ الْإِنسَانَ عَلَّمَهُ الْبَيَانَ»} (He created man; He taught him eloquence) (Q 55:3-4). If, therefore, the beauty and nobility of knowledge is something beloved, and it is in itself an adornment and perfection for the one described by it, then it is not fitting that anyone be loved for this reason except Allah, the Exalted alone.","book_title":"Monitoring and Accounting","section_title_ar":"Section 1155","section_title_en":"The Beauty of Divine Attributes and the Relative Nature of Human Perfection","section_index":1155,"anchors":"- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning of perception, cognition, and certain apprehension of a thing's reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; it is twofold: apprehension of the essence, and judgment affirming or negating a predicate.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine cognition; metaphorical (majāz) usage extends to perception and awareness. Here, the comparative \"أعلم/أجهل\" (more knowing/ more ignorant) operates on a scale of relative apprehension.\n- Root: قدر (qadara)\n  * Lisan / Ayn: Root denotes measuring, determining, and the capacity to bring about an effect.\n  * Al-Raghib (Mufradat): \"القدرة إذا وصف بها الإنسان فاسم لهيئة له بها يتمكن من فعل شيء ما، وإذا وصف الله تعالى بها فهي نفي العجز عنه\" — power in man is a disposition enabling specific acts; power in God is absolute negation of incapacity, unrestricted and infinite.\n  * Al-Zamakhshari (Asas): Literal: \"هو قادر مقتدر ذو قدرة ومقدرة\" — the possessor of power. Metaphorical: extended to strength and dominion. The text contrasts finite human power (maqdūr) with divine power that encompasses all things without limit.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Self, soul, essence; the innermost reality of a thing.\n  * Al-Raghib (Mufradat): \"نفسه: ذاته\" — God's \"self\" is His very essence. For man, nafs denotes the composite self that requires discipline and reform (iṣlāḥ).\n  * Al-Zamakhshari (Asas): Literal: the self as the seat of attributes; metaphorical: \"دفق نفسه\" — blood/life. Here, \"سياسة نفسه\" (governance of one's self) is the literal, ethical sense.\n- Root: خلق (khalaqa)\n  * Lisan / Ayn: Root denotes measuring, smoothing, and fashioning; also moral character (khuluq).\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — origination by precise measure; used for creation ex nihilo and for formation from existing matter.\n  * Al-Zamakhshari (Asas): Literal: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom. The text uses \"الخبائث\" (vices) as the corruption of this created nature.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"فإنما غايته أن يقدر\" restricts human power to a finite limit, emphasizing that the utmost reach of creaturely capacity is merely partial and derivative, never absolute.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'","badge":"Insight"}],"23":[{"arabic":"يشفع عنده إلا بإذنه} وبقوله {ولا تنفع الشفاعة عنده إلا لمن أذن له} وبقوله {فما تنفعهم شفاعة الشافعين} وإذا انقسمت الذنوب إلا ما يشفع فيه وإلا ما لا يشفع فيه وجب الخوف والإشفاق لا محالة ولو كان ذنب تقبل فيه الشفاعة لما أمر قريشا بالطاعة ولما نهى رسول الله صلى الله عليه وسلم فاطمة رضي الله عنها عن المعصية ولكان يأذن لها في اتباع الشهوات لتكمل لذاتها في الدنيا ثم يشفع لها في الآخرة لتكمل لذاتها في الآخرة فالانهماك في الذنوب وترك التقوى اتكالا على رجاء الشفاعة يضاهي انهماك المريض في شهواته اعتمادا على طبيب حاذق قريب م","english":"If you say: \"He, peace and blessings be upon him, said after his words to Fāṭimah and Ṣafiyyah: 'I cannot avail you against God in anything, except that you have a tie of kinship which I will moisten with its moisture'\" — a ḥadīth [reported as]: \"Do you hope for my intercession, while the Banū ʿAbd al-Muṭṭalib do not hope for it?\" — narrated by al-Ṭabarānī in al-Awsaṭ from the narration of ʿAbd Allāh ibn Jaʿfar, and in it is Uṣayrim ibn Ḥawshab from Isḥāq ibn Wāṣil, and both are extremely weak — so that indicates that he will single out his relatives for intercession.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 882","section_title_en":"Section 882 — On the Limits of Intercession, the Vices of Pride in Lineage, Numbers, Wealth, and Opinion, and Their Treatment","section_index":882,"anchors":"- Root: شفع (Sh-F-')\n  * Lisan / Ayn: Core meaning is pairing or joining; intercession (shafā'ah) is the joining of one's plea to another's cause.\n  * Al-Raghib (Mufradat): Intercession is the seeking of benefit for another; its acceptance is contingent upon divine permission and good pleasure, as restricted by the Qur'anic qualifiers.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) is the act of making a number even (from watr, odd); metaphorical (majāz) is the mediator's plea before authority.\n- Root: عجب (ʿ-J-B)\n  * Lisan / Ayn: Astonishment arising from an unknown cause; self-admiration (ʿujb) is a blameworthy state of being pleased with oneself.\n  * Al-Raghib (Mufradat): \"العجب والتعجب: حالة تعرض للإنسان عند الجهل بسبب الشيء\" — a state that overtakes a person due to ignorance of the cause; hence, it is impossible regarding God.\n  * Al-Zamakhshari (Asas): Literal: a wondrous thing; metaphorical: the one who performs marvels (taʿjābah). Self-admiration is the root of every error and innovation.\n- Root: رأي (R-'-Y)\n  * Lisan / Ayn: Opinion, view, or judgment formed through reflection.\n  * Al-Raghib (Mufradat): Ra'y is the considered opinion that may err or hit the mark; it is blameworthy when it becomes an object of ʿujb (self-admiration).\n  * Al-Zamakhshari (Asas): Literal: sight/vision; metaphorical: intellectual insight. The ḥadīth \"إعجاب كل ذي رأي برأيه\" (the admiration of every man of opinion for his own view) is cited as a sign of the age's corruption.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Qualification) — The conditional clauses (in-sharṭ) governing intercession, e.g., {إلا لمن ارتضى} and {إلا بإذنه}, impose necessary restrictions that negate any absolute reliance on intercession.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'","badge":"Insight"}],"29":[{"arabic":"على الكافرين غير يسير} وقال تعالى {ويقولون متى هذا الوعد إن كنتم صادقين ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون ونفخ في الصور فإذا هم من الأجداث إلى ربهم ينسلون قالوا يا ويلنا من بعثنا من مرقدنا هذا ما وعد الرحمن وصدق المرسلون} فلو لم يكن بين يدي الموتى إلا هول تلك النفخة لكان ذلك جديرا بأن يتقى فإنها نفخة وصيحة يصعق بها من في السموات والأرض يعنى يموتون بها إلا من شاء الله وهو بعض الملائكة ولذلك قال رسول الله صلى الله عليه وسلم كيف أنعم وصاحب الصور قد التقم القرن وحنى الجبهة","english":"The Prophet (peace and blessings be upon him) said: Allah the Exalted said: \"The son of Adam has reviled Me, and he had no right to revile Me; and he has denied Me, and he had no right to deny Me. As for his reviling of Me, it is his saying that I have a son. And as for his denial of Me, it is his saying: 'He will never bring me back as He created me at first.'\" {«شتمني ابن آدم وما ينبغي له أن يشتمني وكذبني وما ينبغي له أن يكذبني...»}","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1335","section_title_en":"On the Terrors of the Trumpet-Blast and the Awakening for the Resurrection","section_index":1335,"anchors":"- Root: نفخ (N-F-Kh)\n  * Lisan / Ayn: To blow into a thing, to inflate; the breath of wind entering a vessel or body.\n  * Al-Raghib (Mufradat): The divine act of breathing spirit into creation {«ونفخت فيه من روحي»}; here, the eschatological blast that annihilates and then revives all beings.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage of blowing into the Trumpet (الصور); metaphorical extension to the \"blast of spring\" reviving the earth—here applied to the two cosmic blasts of death and resurrection.\n- Root: صور (S-W-R)\n  * Lisan / Ayn: Form, image, shape; also a horn or trumpet (the instrument of the blast).\n  * Al-Raghib (Mufradat): The perceptible form of bodies and the intelligible form of souls; here, the Trumpet (الصور) as the instrument of divine command that re-forms and re-shapes creation.\n  * Al-Zamakhshari (Asas): Literal: the horn (القرن) held by Israfil; metaphorical: the \"inclination\" (صورة) of hearts toward terror and anticipation.\n- Root: موت (M-W-T)\n  * Lisan / Ayn: Death as the cessation of life; the state of the corpse.\n  * Al-Raghib (Mufradat): Death as the separation of the soul from the body; the \"first death\" of the blast and the \"second death\" of the wicked.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: the \"death\" of the heart through heedlessness, and the reviving of dead lands by rain—here, the reviving of bodies by the second blast.\n- Root: قبر (Q-B-R)\n  * Lisan / Ayn: The grave as the abode of the dead; burial.\n  * Al-Raghib (Mufradat): The grave as the intermediate state (barzakh) before resurrection; {«حتى زرتم المقابر»} as a metaphor for death.\n  * Al-Zamakhshari (Asas): Literal: the grave and its inhabitants; metaphorical: the \"raising of the nose\" (قبراه) of the proud—contrasted here with the humility of the dead rising from their graves.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that true faith is not mere verbal assent but heartfelt conviction, as in \"إنما فتور البواطن... لقلة الفهم\" (The languor of the inner selves is only due to the lack of understanding).","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'","badge":"Hadith"}],"31":[{"arabic":"وجل يقول الذين استضعفوا للذين استكبروا لولا أنتم لكنا مؤمنين وقال تعالى إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين وقال تعالى سأصرف عن آياتي الذين يتكبرون في الأرض بغير الحق قيل في التفسير سأرفع فهم القرآن عن قلوبهم وفي بعض التفاسير سأحجب قلوبهم عن الملكوت وقال ابن جريج سأصرفهم عن أن يتفكروا فيها ويعتبروا بها ولذلك قال المسيح عليه السلام إن الزرع ينبت في السهل ولا ينبت على الصفا كذلك الحكمة تعمل في قلب المتواضع ولا تعمل في قلب المتكبر ألا ترون أن من شمخ برأسه إلى السقف شجه ومن طأطأ أظله وأكنه فهذا مثل ضربه","english":"When this [pride] appears upon the bodily limbs, it is called \"behaving arrogantly\" (takabbur); and when it does not appear [outwardly], it is said that in his soul there is pride (kibr). The root [of the matter] is the moral trait (khuluq) that resides in the soul — namely, the soul's taking comfort and repose in seeing itself as above the one over whom it acts proudly. For pride necessarily requires an object over whom one is proud and a quality by virtue of which one is proud; and by this [requirement], pride is distinguished from self-conceit ('ujb), as will come later. For self-conceit does not require an object other than the self-conceited one. Indeed, were a human being created alone, it is conceivable that he would be self-conceited, but it is not conceivable that he would be proud except when there is another alongside him, and he sees himself as above that other in the attributes of perfection. Only at that point does he become proud. Nor is it sufficient that he deem himself great in order to be proud — for a man may deem himself great yet see another as greater than himself or equal to himself, and so he does not act proudly toward him. Nor is it sufficient that he hold another in contempt — for even so, if he saw himself as more contemptible [than that other], he would not be proud; and if he saw the other as his equal, he would not be proud. Rather, he must assign to himself a rank and to the other a rank, then see his own rank as above the other's rank. Upon these three beliefs, the trait of pride comes to be in him. It is not that this perception alone negates pride; rather, this perception and this conviction blow into him [a wind of vanity], and there arises in his heart self-complacency, a thrill, joy, and repose in what he has come to believe, and a sense of vainglory in himself on account of that. That vainglory, that thrill, and that repose in the belief — that is the trait of pride. For this reason, the Prophet — God's peace and blessings be upon him — said: \"I seek refuge in You from the puff of pride (nafkhat al-kibriyā').\" And the hadith has preceded: \"None shall enter Paradise who has in his heart the weight of a mustard seed of pride.\"","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 854","section_title_en":"The Reality of Pride (Kibr) and Its Manifestation in the Soul and Limbs","section_index":854,"anchors":"- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core meaning of bigness, greatness, and seniority in age or rank; al-Farahidi notes its use for physical growth and maturity.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — great and small are relative terms, applied by comparison; in Kalam, pride (kibr) is a state of the soul that esteems itself above another in perfection.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"كبر الأمر، وخطب كبير\" — to be great in magnitude. Metaphorical (Majaz): \"كبر عليه\" — to find something burdensome or grievous; the moral-spiritual sense of kibr is a metaphorical extension of physical magnitude to the soul's self-assessment.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates and is the seat of inner states.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul; also the very essence (al-dhat), as in \"ويحذركم الله نفسه\" {آل عمران/ 30}, where His \"self\" is His essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — precious thing. Metaphorical: \"دفق نفسه أي دمه\" — \"his self\" for \"his blood\"; here, the soul's inner disposition (khuluq) is the locus where pride takes root before it appears on the limbs.\n- Root: وفي (W-F-Y)\n  * Lisan / Ayn: Completeness, fulfillment, and reaching full measure.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — that which attains completion; \"أوفى بعهده\" — to fulfill one's covenant fully.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" — a full-weight dirham. Metaphorical: \"أوفى على المائة\" — to exceed a hundred; in this text, the \"full measure of a mustard seed\" (مثقال ذرة) of pride is the complete, realized quantity that bars one from Paradise.\n- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: Measuring, shaping, and fashioning; also innate disposition and moral character.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — its root is right measure and estimation; used for God's origination of things and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal: \"خلق الخراز الأديم\" — the leatherworker measures the hide before cutting. Metaphorical: \"خلق الله الخلق\" — God originated creation upon a measure dictated by wisdom; hence khuluq is the soul's fixed moral form.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — used to delimit the precise definition of kibr as a specific soul-state distinct from 'ujb (self-conceit), and to restrict the cause of exclusion from Paradise to the presence of pride in the heart.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'","badge":"Insight"}],"35":[{"arabic":"والأنصار والأتباع كما قال الكفار {نحن أكثر أموالا وأولادا} وكما قال المؤمنون يوم حنين لا نغلب اليوم من قلة وعلاجه ما ذكرناه في الكبر وهو أن يتفكر في ضعفه وضعفهم وأن كلهم عبيد عجزة لا يملكون لأنفسهم ضرا ولا نفعا {كم من فئة قليلة غلبت فئة كثيرة بإذن الله} ثم كيف يعجب بهم وأنهم سيفترقون عنه إذا مات فيدفن في قبره ذليلا مهينا وحده لا يرافقه أهل ولا ولد ولا قريب ولا حميم ولا عشير فيسلمونه إلى البلى والحيات والعقارب والديدان ولا يغنون عنه شيئا وفي أحوج أوقاته إليهم وكذلك يهربون منه يوم القيامة {يوم يفر المرء من أخي","english":"If you say: \"He, peace and blessings be upon him, said after his words to Fāṭimah and Ṣafiyyah: 'I cannot avail you against God in anything, except that you have a tie of kinship which I will moisten with its moisture'\" — a ḥadīth [reported as]: \"Do you hope for my intercession, while the Banū ʿAbd al-Muṭṭalib do not hope for it?\" — narrated by al-Ṭabarānī in al-Awsaṭ from the narration of ʿAbd Allāh ibn Jaʿfar, and in it is Uṣayrim ibn Ḥawshab from Isḥāq ibn Wāṣil, and both are extremely weak — so that indicates that he will single out his relatives for intercession.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 882","section_title_en":"Section 882 — On the Limits of Intercession, the Vices of Pride in Lineage, Numbers, Wealth, and Opinion, and Their Treatment","section_index":882,"anchors":"- Root: شفع (Sh-F-')\n  * Lisan / Ayn: Core meaning is pairing or joining; intercession (shafā'ah) is the joining of one's plea to another's cause.\n  * Al-Raghib (Mufradat): Intercession is the seeking of benefit for another; its acceptance is contingent upon divine permission and good pleasure, as restricted by the Qur'anic qualifiers.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) is the act of making a number even (from watr, odd); metaphorical (majāz) is the mediator's plea before authority.\n- Root: عجب (ʿ-J-B)\n  * Lisan / Ayn: Astonishment arising from an unknown cause; self-admiration (ʿujb) is a blameworthy state of being pleased with oneself.\n  * Al-Raghib (Mufradat): \"العجب والتعجب: حالة تعرض للإنسان عند الجهل بسبب الشيء\" — a state that overtakes a person due to ignorance of the cause; hence, it is impossible regarding God.\n  * Al-Zamakhshari (Asas): Literal: a wondrous thing; metaphorical: the one who performs marvels (taʿjābah). Self-admiration is the root of every error and innovation.\n- Root: رأي (R-'-Y)\n  * Lisan / Ayn: Opinion, view, or judgment formed through reflection.\n  * Al-Raghib (Mufradat): Ra'y is the considered opinion that may err or hit the mark; it is blameworthy when it becomes an object of ʿujb (self-admiration).\n  * Al-Zamakhshari (Asas): Literal: sight/vision; metaphorical: intellectual insight. The ḥadīth \"إعجاب كل ذي رأي برأيه\" (the admiration of every man of opinion for his own view) is cited as a sign of the age's corruption.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Qualification) — The conditional clauses (in-sharṭ) governing intercession, e.g., {إلا لمن ارتضى} and {إلا بإذنه}, impose necessary restrictions that negate any absolute reliance on intercession.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'","badge":"Insight"}],"47":[{"arabic":"وهو مع ذلك قريب من كل موجود وهو أقرب إلى العبد من حبل الوريد وهو على كل شيء شهيد إذ لا يماثل قربه قرب الأجسام كما لا تماثل ذاته ذات الأجسام وأنه لا يحل في شيء ولا يحل فيه شيء تعالى عن أن يحويه مكان كما تقدس عن أن يحده زمان بل كان قبل أن خلق الزمان والمكان وهو الآن على ما عليه كان وأنه بائن عن خلقه بصفاته ليس في ذاته سواه ولا في سواه ذاته وأنه مقدس عن التغير والانتقال لا تحله الحوادث ولا تعتريه العوارض بل لا يزال في نعوت جلاله منزها عن الزوال وفي صفات كماله مستغنيا عن زيادة الاستكمال وأنه في ذاته معلوم الوجود بالعقول مرئ","english":"- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.","book_title":"On Invocations and Supplications","section_title_ar":"Section 72","section_title_en":"Section 72","section_index":72,"anchors":"*(Anchors established)*","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'","badge":"Insight"}],"54":[{"arabic":"معاني قوله تعالى {وحيل بينهم وبين ما يشتهون} وإليه الإشارة بقوله تعالى من قبل أن يأتي أحدكم الموت فيقول رب لولا أخرتني إلى أجل قريب فأصدق وأكن من الصالحين ولن يؤخر الله نفسا إذا جاء أجلها فقيل الأجل القريب الذي يطلبه معناه أنه يقول عند كشف الغطاء للعبد يا ملك الموت أخرني يوما أعتذر فيه إلى ربي وأتوب وأتزود صالحا لنفسي فيقول فنيت الأيام فلا يوم فيقول فأخرني ساعة فيقول فنيت الساعات فلا ساعة فيغلق عليه باب التوبة فيتغرغر بروحه وتتردد أنفاسه في شراسفه ويتجرع غصة اليأس عن التدارك وحسرة الندامة على تضييع","english":"I say: Every human being is never free from disobedience of the bodily members (jawāriḥ), for even the prophets were not free from it — as has come down in the Qurʾān and the reports concerning the sins of the prophets, their repentance, and their weeping over their misdeeds. And if one is free, in some states, from disobedience of the members, he is not free from the heart's inclination (hamm) toward sins. And if he is free, in some states, from the inclination, he is not free from the whispering of Satan (waswās al-shayṭān) by way of importing scattered thoughts that divert from the remembrance of God. And if he is free from that, he is not free from heedlessness (ghaflah) and deficiency in knowledge of God, His attributes, and His acts. All of that is deficiency (nuqṣān), and it has causes; and abandoning its causes by occupying oneself with their opposites is a reversion from one path to its contrary. The meaning of \"repentance\" (tawbah) is \"returning\" (rujūʿ), and it is inconceivable that a human being should be entirely free of this deficiency — rather, people differ only in degrees. As for the principle itself, it is unavoidable. For this reason, he (peace be upon him) said: \"Truly, a veil is cast over my heart, so that I seek forgiveness from God seventy times a day and night\" (1) — the hadith. And for this reason, God (exalted be He) honored him by saying: {«لِيَغْفِرَ لَكَ اللَّهُ مَا تَقَدَّمَ مِنْ ذَنْبِكَ وَمَا تَأَخَّرَ»} [That God may forgive you what has passed of your sin and what remains]. And if this was his state, how then is the state of anyone else?","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 922","section_title_en":"On the Universality of Repentance (Tawbah) and Its Obligation in Every Breath","section_index":922,"anchors":"- Root: توب (T-W-B)\n  * Lisan / Ayn: Core meaning of \"returning\" (rujūʿ) — turning back from a path to its opposite; the root denotes the act of revisiting and reversing a prior state.\n  * Al-Raghib (Mufradat): Tawbah is \"abandoning the sin in the most excellent manner\" — the most complete form of excuse; in sacred law (sharʿ), it is abandoning the sin due to its ugliness, regretting what has passed, resolving not to return, and rectifying what can be rectified of past deeds through renewed acts.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He repented to God from his sin\" (tāba al-ʿabdu ilā Allāhi min dhanbihi). Metaphorical (majāz): The extension of \"repentance\" to inner purification of the heart from accumulated rust (rayn), as the root's sense of \"returning\" is applied to the soul's reversion from negligence to vigilance.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: The heart as the organ of turning and overturning (taqlīb) — its state fluctuates between illumination and darkness, purity and rust.\n  * Al-Raghib (Mufradat): \"Turning a thing\" is directing it from one face to another; the heart (qalb) is so named for its constant overturning between states — a key metaphysical anchor for Ghazali's doctrine of the heart's susceptibility to stains (akdār) and polish (ṣaqal).\n  * Al-Zamakhshari (Asas): Literal: \"He turned the thing over\" (qalaba al-shayʾ). Metaphorical: \"The heart is rusted\" (qalb wajīb) — the inner organ's receptivity to impressions, whether dark (from sins) or luminous (from obedience).\n- Root: وجب (W-J-B)\n  * Lisan / Ayn: Obligation as fixed establishment (thubūt); what is due and settled upon a person.\n  * Al-Raghib (Mufradat): Wājib has two senses: (1) that whose non-existence entails a contradiction (metaphysical necessity), and (2) that whose neglect merits blame — subdivided into what reason deems obligatory (e.g., knowing divine unity) and what the Law deems obligatory (e.g., acts of worship). Ghazali here exploits this dual sense to distinguish legal obligation (fatwā) from the higher obligation of the path (ṭarīq).\n  * Al-Zamakhshari (Asas): Literal: \"It became incumbent upon him\" (wajaba ʿalayhi). Metaphorical: The extension to \"the heart's palpitation\" (wajīb) — the inner agitation of one who realizes the urgency of repentance before death.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Quranic citations {«إِنَّمَا التَّوْبَةُ عَلَى اللَّهِ»} and {«وَلَيْسَتِ التَّوْبَةُ لِلَّذِينَ»}, where innamā restricts the predicate to a specific subject, delimiting the scope of accepted repentance to those who turn before death's arrival and before the rust hardens into a seal.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,400,1175],[2,1175,1818],[3,1818,2637],[4,2637,2972],[5,2972,3430],[6,3430,3870],[7,3870,5319],[8,5319,6041],[9,6041,6481],[10,6481,7327],[11,7327,7926],[12,7926,8701],[13,8701,9141],[14,9141,10304],[15,10304,10991],[16,10991,12030],[17,12030,13072]],"2":[[1,400,1242],[2,1242,1708],[3,1708,2335],[4,2335,2783],[5,2783,3643],[6,3643,4378],[7,4378,5203],[8,5203,6010],[9,6010,6745],[10,6745,7552],[11,7552,7910],[12,7910,9556],[13,9556,10291],[14,10291,11133],[15,11133,12029],[16,12029,12728],[17,12728,13920],[18,13920,14979]],"3":[[1,400,1454],[2,1454,2577],[3,2577,3790],[4,3790,4307],[5,4307,5758],[6,5758,7115],[7,7115,7552],[8,7552,8427],[9,8427,9570],[10,9570,11588],[11,11588,12367],[12,12367,13341],[13,13341,13858],[14,13858,14792],[15,14792,15408],[16,15408,16581],[17,16581,17307],[18,17307,17804],[19,17804,19439],[20,19439,20254],[21,20254,20751],[22,20751,21705],[23,21705,23029],[24,23029,23943],[25,23943,24341],[26,24341,25088],[27,25088,26412],[28,26412,27247],[29,27247,28152],[30,28152,28649],[31,28649,29365],[32,29365,30548]],"4":[[1,400,1987],[2,1987,3268],[3,3268,4968],[4,4968,6736],[5,6736,8708],[6,8708,10431],[7,10431,11088],[8,11088,12527],[9,12527,13592],[10,13592,14613]],"5":[[1,400,1810],[2,1810,2559],[3,2559,3525],[4,3525,5182],[5,5182,6645],[6,6645,8144],[7,8144,8716],[8,8716,9682],[9,9682,10362],[10,10362,11151],[11,11151,12079]],"6":[[1,400,1386],[2,1386,2399],[3,2399,3618],[4,3618,4425],[5,4425,5689],[6,5689,6442],[7,6442,7285],[8,7285,7644],[9,7644,8451],[10,8451,8881],[11,8881,9688],[12,9688,11266],[13,11266,12091],[14,12091,12844],[15,12844,13920],[16,13920,14979]],"7":[[1,400,1524],[2,1524,2722],[3,2722,4016],[4,4016,4419],[5,4419,5639],[6,5639,6615],[7,6615,7251],[8,7251,8852],[9,8852,9679],[10,9679,11005],[11,11005,11588],[12,11588,12638],[13,12638,13836],[14,13836,14578],[15,14578,15278],[16,15278,16233]],"8":[[1,400,1686],[2,1686,2407],[3,2407,3177],[4,3177,4093],[5,4093,4522],[6,4522,4892],[7,4892,5720],[8,5720,6110],[9,6110,7211],[10,7211,7718],[11,7718,9140],[12,9140,10621],[13,10621,11108],[14,11108,12316],[15,12316,13811],[16,13811,14979]],"9":[[1,400,1278],[2,1278,2448],[3,2448,3409],[4,3409,3952],[5,3952,4683],[6,4683,6167],[7,