{"surah":34,"verses":[{"ayah":1,"text":"ٱلْحَمْدُ لِلَّهِ ٱلَّذِى لَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَلَهُ ٱلْحَمْدُ فِى ٱلْءَاخِرَةِۚ وَهُوَ ٱلْحَكِيمُ ٱلْخَبِيرُ ","translation":"[All] praise is [due] to Allāh, to whom belongs whatever is in the heavens and whatever is in the earth, and to Him belongs [all] praise in the Hereafter. And He is the Wise, the Aware.","words":[{"id":1,"arabic":"ٱلْحَمْدُ","translit":"ُdْmَḥْlٱ","root":"حمد"},{"id":2,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":3,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":4,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":8,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":11,"arabic":"وَلَهُ","translit":"ُhَlَw","root":""},{"id":12,"arabic":"ٱلْحَمْدُ","translit":"ُdْmَḥْlٱ","root":"حمد"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":15,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":16,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"},{"id":17,"arabic":"ٱلْخَبِيرُ","translit":"ُryِbَhkْlٱ","root":"خبر"}],"hasIhya":true},{"ayah":2,"text":"يَعْلَمُ مَا يَلِجُ فِى ٱلْأَرْضِ وَمَا يَخْرُجُ مِنْهَا وَمَا يَنزِلُ مِنَ ٱلسَّمَآءِ وَمَا يَعْرُجُ فِيهَاۚ وَهُوَ ٱلرَّحِيمُ ٱلْغَفُورُ ","translation":"He knows what penetrates into the earth and what emerges from it and what descends from the heaven and what ascends therein. And He is the Merciful, the Forgiving.","words":[{"id":1,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"يَلِجُ","translit":"ُjgِlَy","root":"ولج"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"يَخْرُجُ","translit":"ُjgُrْhkَy","root":"خرج"},{"id":8,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":9,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":10,"arabic":"يَنزِلُ","translit":"ُlِznَy","root":"نزل"},{"id":11,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":12,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":13,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":14,"arabic":"يَعْرُجُ","translit":"ُjgُrْʿعَy","root":"عرج"},{"id":15,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":16,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":17,"arabic":"ٱلرَّحِيمُ","translit":"ُmyِḥَّrlٱ","root":"رحم"},{"id":18,"arabic":"ٱلْغَفُورُ","translit":"ُrwُfَغْlٱ","root":"غفر"}],"hasIhya":false},{"ayah":3,"text":"وَقَالَ ٱلَّذِينَ كَفَرُوا۟ لَا تَأْتِينَا ٱلسَّاعَةُۖ قُلْ بَلَىٰ وَرَبِّى لَتَأْتِيَنَّكُمْ عَٰلِمِ ٱلْغَيْبِۖ لَا يَعْزُبُ عَنْهُ مِثْقَالُ ذَرَّةٍ فِى ٱلسَّمَٰوَٰتِ وَلَا فِى ٱلْأَرْضِ وَلَآ أَصْغَرُ مِن ذَٰلِكَ وَلَآ أَكْبَرُ إِلَّا فِى كِتَٰبٍ مُّبِينٍ ","translation":"But those who disbelieve say, \"The Hour will not come to us.\" Say, \"Yes, by my Lord, it will surely come to you. [Allāh is] the Knower of the unseen.\" Not absent from Him is an atom's weight[1] within the heavens or within the earth or [what is] smaller than that or greater, except that it is in a clear register -","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَأْتِينَا","translit":"āَnyِtْaʾَt","root":"اتي"},{"id":6,"arabic":"ٱلسَّاعَةُ","translit":"ُẗَʿعāَّslٱ","root":"سوع"},{"id":7,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":8,"arabic":"بَلَىٰ","translit":"ٰàَlَb","root":""},{"id":9,"arabic":"وَرَبِّى","translit":"àِّbَrَw","root":"ربب"},{"id":10,"arabic":"لَتَأْتِيَنَّكُمْ","translit":"ْmُkَّnَyِtْaʾَtَl","root":"اتي"},{"id":11,"arabic":"عَٰلِمِ","translit":"ِmِlَٰʿع","root":"علم"},{"id":12,"arabic":"ٱلْغَيْبِ","translit":"ِbْyَغْlٱ","root":"غيب"},{"id":13,"arabic":"لَا","translit":"āَl","root":""},{"id":14,"arabic":"يَعْزُبُ","translit":"ُbُzْʿعَy","root":"عزب"},{"id":15,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":16,"arabic":"مِثْقَالُ","translit":"ُlāَqْhtِm","root":"ثقل"},{"id":17,"arabic":"ذَرَّةٍ","translit":"ٍẗَّrَhd","root":"ذرر"},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":20,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":21,"arabic":"فِى","translit":"àِf","root":""},{"id":22,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":23,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":24,"arabic":"أَصْغَرُ","translit":"ُrَغْṣَaʾ","root":"صغر"},{"id":25,"arabic":"مِن","translit":"nِm","root":""},{"id":26,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":27,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":28,"arabic":"أَكْبَرُ","translit":"ُrَbْkَaʾ","root":"كبر"},{"id":29,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":30,"arabic":"فِى","translit":"àِf","root":""},{"id":31,"arabic":"كِتَٰبٍ","translit":"ٍbَٰtِk","root":"كتب"},{"id":32,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":true},{"ayah":4,"text":"لِّيَجْزِىَ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِۚ أُو۟لَٰٓئِكَ لَهُم مَّغْفِرَةٌ وَرِزْقٌ كَرِيمٌ ","translation":"That He may reward those who believe and do righteous deeds. Those will have forgiveness and noble provision.","words":[{"id":1,"arabic":"لِّيَجْزِىَ","translit":"َàِzْjgَyِّl","root":"جزي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":5,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":6,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":7,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":8,"arabic":"مَّغْفِرَةٌ","translit":"ٌẗَrِfْغَّm","root":"غفر"},{"id":9,"arabic":"وَرِزْقٌ","translit":"ٌqْzِrَw","root":"رزق"},{"id":10,"arabic":"كَرِيمٌ","translit":"ٌmyِrَk","root":"كرم"}],"hasIhya":true},{"ayah":5,"text":"وَٱلَّذِينَ سَعَوْ فِىٓ ءَايَٰتِنَا مُعَٰجِزِينَ أُو۟لَٰٓئِكَ لَهُمْ عَذَابٌ مِّن رِّجْزٍ أَلِيمٌ ","translation":"But those who strive against Our verses [seeking] to cause failure[1] - for them will be a painful punishment of foul nature.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"سَعَوْ","translit":"ْwَʿعَs","root":"سعي"},{"id":3,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":4,"arabic":"ءَايَٰتِنَا","translit":"āَnِtَٰyāَء","root":"ايي"},{"id":5,"arabic":"مُعَٰجِزِينَ","translit":"َnyِzِjgَٰʿعُm","root":"عجز"},{"id":6,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":7,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":8,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":9,"arabic":"مِّن","translit":"nِّm","root":""},{"id":10,"arabic":"رِّجْزٍ","translit":"ٍzْjgِّr","root":"رجز"},{"id":11,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":6,"text":"وَيَرَى ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ ٱلَّذِىٓ أُنزِلَ إِلَيْكَ مِن رَّبِّكَ هُوَ ٱلْحَقَّ وَيَهْدِىٓ إِلَىٰ صِرَٰطِ ٱلْعَزِيزِ ٱلْحَمِيدِ ","translation":"And those who have been given knowledge see that what is revealed to you from your Lord is the truth, and it guides to the path of the Exalted in Might, the Praiseworthy.","words":[{"id":1,"arabic":"وَيَرَى","translit":"àَrَyَw","root":"راي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"أُوتُوا۟","translit":"۟āwُtwُaʾ","root":"اتي"},{"id":4,"arabic":"ٱلْعِلْمَ","translit":"َmْlِʿعْlٱ","root":"علم"},{"id":5,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":6,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":7,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":10,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":11,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":12,"arabic":"وَيَهْدِىٓ","translit":"ٓàِdْhَyَw","root":"هدي"},{"id":13,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":14,"arabic":"صِرَٰطِ","translit":"ِṭَٰrِṣ","root":"صرط"},{"id":15,"arabic":"ٱلْعَزِيزِ","translit":"ِzyِzَʿعْlٱ","root":"عزز"},{"id":16,"arabic":"ٱلْحَمِيدِ","translit":"ِdyِmَḥْlٱ","root":"حمد"}],"hasIhya":false},{"ayah":7,"text":"وَقَالَ ٱلَّذِينَ كَفَرُوا۟ هَلْ نَدُلُّكُمْ عَلَىٰ رَجُلٍ يُنَبِّئُكُمْ إِذَا مُزِّقْتُمْ كُلَّ مُمَزَّقٍ إِنَّكُمْ لَفِى خَلْقٍ جَدِيدٍ ","translation":"But those who disbelieve say, \"Shall we direct you to a man who will inform you [that] when you have disintegrated in complete disintegration, you will [then] be [recreated] in a new creation?","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":5,"arabic":"نَدُلُّكُمْ","translit":"ْmُkُّlُdَn","root":"دلل"},{"id":6,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":7,"arabic":"رَجُلٍ","translit":"ٍlُjgَr","root":"رجل"},{"id":8,"arabic":"يُنَبِّئُكُمْ","translit":"ْmُkُyʾِّbَnُy","root":"نبا"},{"id":9,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":10,"arabic":"مُزِّقْتُمْ","translit":"ْmُtْqِّzُm","root":"مزق"},{"id":11,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":12,"arabic":"مُمَزَّقٍ","translit":"ٍqَّzَmُm","root":"مزق"},{"id":13,"arabic":"إِنَّكُمْ","translit":"ْmُkَّnِiʾ","root":""},{"id":14,"arabic":"لَفِى","translit":"àِfَl","root":""},{"id":15,"arabic":"خَلْقٍ","translit":"ٍqْlَhk","root":"خلق"},{"id":16,"arabic":"جَدِيدٍ","translit":"ٍdyِdَjg","root":"جدد"}],"hasIhya":false},{"ayah":8,"text":"أَفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَم بِهِۦ جِنَّةٌۢۗ بَلِ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ فِى ٱلْعَذَابِ وَٱلضَّلَٰلِ ٱلْبَعِيدِ ","translation":"Has he invented about Allāh a lie or is there in him madness?\" Rather, they who do not believe in the Hereafter will be in the punishment and [are in] extreme error.","words":[{"id":1,"arabic":"أَفْتَرَىٰ","translit":"ٰàَrَtْfَaʾ","root":"فري"},{"id":2,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"كَذِبًا","translit":"āًbِhdَk","root":"كذب"},{"id":5,"arabic":"أَم","translit":"mَaʾ","root":""},{"id":6,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":7,"arabic":"جِنَّةٌۢ","translit":"ٌۢẗَّnِjg","root":"جنن"},{"id":8,"arabic":"بَلِ","translit":"ِlَb","root":""},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"لَا","translit":"āَl","root":""},{"id":11,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":12,"arabic":"بِٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱِb","root":"اخر"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":15,"arabic":"وَٱلضَّلَٰلِ","translit":"ِlَٰlَّḍlٱَw","root":"ضلل"},{"id":16,"arabic":"ٱلْبَعِيدِ","translit":"ِdyِʿعَbْlٱ","root":"بعد"}],"hasIhya":true},{"ayah":9,"text":"أَفَلَمْ يَرَوْا۟ إِلَىٰ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُم مِّنَ ٱلسَّمَآءِ وَٱلْأَرْضِۚ إِن نَّشَأْ نَخْسِفْ بِهِمُ ٱلْأَرْضَ أَوْ نُسْقِطْ عَلَيْهِمْ كِسَفًا مِّنَ ٱلسَّمَآءِۚ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّكُلِّ عَبْدٍ مُّنِيبٍ ","translation":"Then, do they not look at what is before them and what is behind them of the heaven and earth? If We should will, We could cause the earth to swallow them or [could] let fall upon them fragments from the sky. Indeed in that is a sign for every servant turning back [to Allāh].","words":[{"id":1,"arabic":"أَفَلَمْ","translit":"ْmَlَfَaʾ","root":""},{"id":2,"arabic":"يَرَوْا۟","translit":"۟āْwَrَy","root":"راي"},{"id":3,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":6,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":7,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":8,"arabic":"خَلْفَهُم","translit":"mُhَfْlَhk","root":"خلف"},{"id":9,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":10,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":11,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":12,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":13,"arabic":"نَّشَأْ","translit":"ْaʾَhsَّn","root":"شيا"},{"id":14,"arabic":"نَخْسِفْ","translit":"ْfِsْhkَn","root":"خسف"},{"id":15,"arabic":"بِهِمُ","translit":"ُmِhِb","root":""},{"id":16,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":17,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":18,"arabic":"نُسْقِطْ","translit":"ْṭِqْsُn","root":"سقط"},{"id":19,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":20,"arabic":"كِسَفًا","translit":"āًfَsِk","root":"كسف"},{"id":21,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":22,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":23,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":24,"arabic":"فِى","translit":"àِf","root":""},{"id":25,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":26,"arabic":"لَءَايَةً","translit":"ًẗَyāَءَl","root":"ايي"},{"id":27,"arabic":"لِّكُلِّ","translit":"ِّlُkِّl","root":"كلل"},{"id":28,"arabic":"عَبْدٍ","translit":"ٍdْbَʿع","root":"عبد"},{"id":29,"arabic":"مُّنِيبٍ","translit":"ٍbyِnُّm","root":"نوب"}],"hasIhya":false},{"ayah":10,"text":"وَلَقَدْ ءَاتَيْنَا دَاوُۥدَ مِنَّا فَضْلًاۖ يَٰجِبَالُ أَوِّبِى مَعَهُۥ وَٱلطَّيْرَۖ وَأَلَنَّا لَهُ ٱلْحَدِيدَ ","translation":"And We certainly gave David from Us bounty. [We said], \"O mountains, repeat [Our] praises with him, and the birds [as well].\" And We made pliable for him iron,","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"ءَاتَيْنَا","translit":"āَnْyَtāَء","root":"اتي"},{"id":3,"arabic":"دَاوُۥدَ","translit":"َdۥُwāَd","root":""},{"id":4,"arabic":"مِنَّا","translit":"āَّnِm","root":""},{"id":5,"arabic":"فَضْلًا","translit":"āًlْḍَf","root":"فضل"},{"id":6,"arabic":"يَٰجِبَالُ","translit":"ُlāَbِjgَٰy","root":"جبل"},{"id":7,"arabic":"أَوِّبِى","translit":"àِbِّwَaʾ","root":"اوب"},{"id":8,"arabic":"مَعَهُۥ","translit":"ۥُhَʿعَm","root":""},{"id":9,"arabic":"وَٱلطَّيْرَ","translit":"َrْyَّṭlٱَw","root":"طير"},{"id":10,"arabic":"وَأَلَنَّا","translit":"āَّnَlَaʾَw","root":"لين"},{"id":11,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":12,"arabic":"ٱلْحَدِيدَ","translit":"َdyِdَḥْlٱ","root":"حدد"}],"hasIhya":true},{"ayah":11,"text":"أَنِ ٱعْمَلْ سَٰبِغَٰتٍ وَقَدِّرْ فِى ٱلسَّرْدِۖ وَٱعْمَلُوا۟ صَٰلِحًاۖ إِنِّى بِمَا تَعْمَلُونَ بَصِيرٌ ","translation":"[Commanding him], \"Make full coats of mail and calculate [precisely] the links, and work [all of you] righteousness. Indeed I, of what you do, am Seeing.\"","words":[{"id":1,"arabic":"أَنِ","translit":"ِnَaʾ","root":""},{"id":2,"arabic":"ٱعْمَلْ","translit":"ْlَmْʿعٱ","root":"عمل"},{"id":3,"arabic":"سَٰبِغَٰتٍ","translit":"ٍtَٰغِbَٰs","root":"سبغ"},{"id":4,"arabic":"وَقَدِّرْ","translit":"ْrِّdَqَw","root":"قدر"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلسَّرْدِ","translit":"ِdْrَّslٱ","root":"سرد"},{"id":7,"arabic":"وَٱعْمَلُوا۟","translit":"۟āwُlَmْʿعٱَw","root":"عمل"},{"id":8,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":9,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":10,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":11,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":12,"arabic":"بَصِيرٌ","translit":"ٌryِṣَb","root":"بصر"}],"hasIhya":false},{"ayah":12,"text":"وَلِسُلَيْمَٰنَ ٱلرِّيحَ غُدُوُّهَا شَهْرٌ وَرَوَاحُهَا شَهْرٌۖ وَأَسَلْنَا لَهُۥ عَيْنَ ٱلْقِطْرِۖ وَمِنَ ٱلْجِنِّ مَن يَعْمَلُ بَيْنَ يَدَيْهِ بِإِذْنِ رَبِّهِۦۖ وَمَن يَزِغْ مِنْهُمْ عَنْ أَمْرِنَا نُذِقْهُ مِنْ عَذَابِ ٱلسَّعِيرِ ","translation":"And to Solomon [We subjected] the wind - its morning [journey was that of] a month - and its afternoon [journey was that of] a month, and We made flow for him a spring of [liquid] copper. And among the jinn were those who worked for him by the permission of his Lord. And whoever deviated among them from Our command - We will make him taste of the punishment of the Blaze.","words":[{"id":1,"arabic":"وَلِسُلَيْمَٰنَ","translit":"َnَٰmْyَlُsِlَw","root":""},{"id":2,"arabic":"ٱلرِّيحَ","translit":"َḥyِّrlٱ","root":"روح"},{"id":3,"arabic":"غُدُوُّهَا","translit":"āَhُّwُdُغ","root":"غدو"},{"id":4,"arabic":"شَهْرٌ","translit":"ٌrْhَhs","root":"شهر"},{"id":5,"arabic":"وَرَوَاحُهَا","translit":"āَhُḥāَwَrَw","root":"روح"},{"id":6,"arabic":"شَهْرٌ","translit":"ٌrْhَhs","root":"شهر"},{"id":7,"arabic":"وَأَسَلْنَا","translit":"āَnْlَsَaʾَw","root":"سيل"},{"id":8,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":9,"arabic":"عَيْنَ","translit":"َnْyَʿع","root":"عين"},{"id":10,"arabic":"ٱلْقِطْرِ","translit":"ِrْṭِqْlٱ","root":"قطر"},{"id":11,"arabic":"وَمِنَ","translit":"َnِmَw","root":""},{"id":12,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":13,"arabic":"مَن","translit":"nَm","root":""},{"id":14,"arabic":"يَعْمَلُ","translit":"ُlَmْʿعَy","root":"عمل"},{"id":15,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":16,"arabic":"يَدَيْهِ","translit":"ِhْyَdَy","root":"يدي"},{"id":17,"arabic":"بِإِذْنِ","translit":"ِnْhdِiʾِb","root":"اذن"},{"id":18,"arabic":"رَبِّهِۦ","translit":"ۦِhِّbَr","root":"ربب"},{"id":19,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":20,"arabic":"يَزِغْ","translit":"ْغِzَy","root":"زيغ"},{"id":21,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":22,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":23,"arabic":"أَمْرِنَا","translit":"āَnِrْmَaʾ","root":"امر"},{"id":24,"arabic":"نُذِقْهُ","translit":"ُhْqِhdُn","root":"ذوق"},{"id":25,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":26,"arabic":"عَذَابِ","translit":"ِbāَhdَʿع","root":"عذب"},{"id":27,"arabic":"ٱلسَّعِيرِ","translit":"ِryِʿعَّslٱ","root":"سعر"}],"hasIhya":true},{"ayah":13,"text":"يَعْمَلُونَ لَهُۥ مَا يَشَآءُ مِن مَّحَٰرِيبَ وَتَمَٰثِيلَ وَجِفَانٍ كَٱلْجَوَابِ وَقُدُورٍ رَّاسِيَٰتٍۚ ٱعْمَلُوٓا۟ ءَالَ دَاوُۥدَ شُكْرًاۚ وَقَلِيلٌ مِّنْ عِبَادِىَ ٱلشَّكُورُ ","translation":"They made for him what he willed of elevated chambers,[1] statues,[2] bowls like reservoirs, and stationary kettles. [We said], \"Work, O family of David, in gratitude.\" And few of My servants are grateful.","words":[{"id":1,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"مَّحَٰرِيبَ","translit":"َbyِrَٰḥَّm","root":"حرب"},{"id":7,"arabic":"وَتَمَٰثِيلَ","translit":"َlyِhtَٰmَtَw","root":"مثل"},{"id":8,"arabic":"وَجِفَانٍ","translit":"ٍnāَfِjgَw","root":"جفن"},{"id":9,"arabic":"كَٱلْجَوَابِ","translit":"ِbāَwَjgْlٱَk","root":"جبي"},{"id":10,"arabic":"وَقُدُورٍ","translit":"ٍrwُdُqَw","root":"قدر"},{"id":11,"arabic":"رَّاسِيَٰتٍ","translit":"ٍtَٰyِsāَّr","root":"رسو"},{"id":12,"arabic":"ٱعْمَلُوٓا۟","translit":"۟āٓwُlَmْʿعٱ","root":"عمل"},{"id":13,"arabic":"ءَالَ","translit":"َlāَء","root":"اول"},{"id":14,"arabic":"دَاوُۥدَ","translit":"َdۥُwāَd","root":""},{"id":15,"arabic":"شُكْرًا","translit":"āًrْkُhs","root":"شكر"},{"id":16,"arabic":"وَقَلِيلٌ","translit":"ٌlyِlَqَw","root":"قلل"},{"id":17,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":18,"arabic":"عِبَادِىَ","translit":"َàِdāَbِʿع","root":"عبد"},{"id":19,"arabic":"ٱلشَّكُورُ","translit":"ُrwُkَّhslٱ","root":"شكر"}],"hasIhya":true},{"ayah":14,"text":"فَلَمَّا قَضَيْنَا عَلَيْهِ ٱلْمَوْتَ مَا دَلَّهُمْ عَلَىٰ مَوْتِهِۦٓ إِلَّا دَآبَّةُ ٱلْأَرْضِ تَأْكُلُ مِنسَأَتَهُۥۖ فَلَمَّا خَرَّ تَبَيَّنَتِ ٱلْجِنُّ أَن لَّوْ كَانُوا۟ يَعْلَمُونَ ٱلْغَيْبَ مَا لَبِثُوا۟ فِى ٱلْعَذَابِ ٱلْمُهِينِ ","translation":"And when We decreed for him [i.e., Solomon] death, nothing indicated to them [i.e., the jinn] his death except a creature of the earth eating his staff.[1] But when he fell, it became clear to the jinn that if they had known the unseen, they would not have remained in humiliating punishment.[2]","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"قَضَيْنَا","translit":"āَnْyَḍَq","root":"قضي"},{"id":3,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":4,"arabic":"ٱلْمَوْتَ","translit":"َtْwَmْlٱ","root":"موت"},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"دَلَّهُمْ","translit":"ْmُhَّlَd","root":"دلل"},{"id":7,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":8,"arabic":"مَوْتِهِۦٓ","translit":"ٓۦِhِtْwَm","root":"موت"},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"دَآبَّةُ","translit":"ُẗَّbٓāَd","root":"دبب"},{"id":11,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":12,"arabic":"تَأْكُلُ","translit":"ُlُkْaʾَt","root":"اكل"},{"id":13,"arabic":"مِنسَأَتَهُۥ","translit":"ۥُhَtَaʾَsnِm","root":"نسا"},{"id":14,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":15,"arabic":"خَرَّ","translit":"َّrَhk","root":"خرر"},{"id":16,"arabic":"تَبَيَّنَتِ","translit":"ِtَnَّyَbَt","root":"بين"},{"id":17,"arabic":"ٱلْجِنُّ","translit":"ُّnِjgْlٱ","root":"جنن"},{"id":18,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":19,"arabic":"لَّوْ","translit":"ْwَّl","root":""},{"id":20,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":21,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"},{"id":22,"arabic":"ٱلْغَيْبَ","translit":"َbْyَغْlٱ","root":"غيب"},{"id":23,"arabic":"مَا","translit":"āَm","root":""},{"id":24,"arabic":"لَبِثُوا۟","translit":"۟āwُhtِbَl","root":"لبث"},{"id":25,"arabic":"فِى","translit":"àِf","root":""},{"id":26,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":27,"arabic":"ٱلْمُهِينِ","translit":"ِnyِhُmْlٱ","root":"هون"}],"hasIhya":false},{"ayah":15,"text":"لَقَدْ كَانَ لِسَبَإٍ فِى مَسْكَنِهِمْ ءَايَةٌۖ جَنَّتَانِ عَن يَمِينٍ وَشِمَالٍۖ كُلُوا۟ مِن رِّزْقِ رَبِّكُمْ وَٱشْكُرُوا۟ لَهُۥۚ بَلْدَةٌ طَيِّبَةٌ وَرَبٌّ غَفُورٌ ","translation":"There was for [the tribe of] Saba’ in their dwelling place a sign: two [fields of] gardens on the right and on the left. [They were told], \"Eat from the provisions of your Lord and be grateful to Him. A good land [have you], and a forgiving Lord.\"","words":[{"id":1,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"لِسَبَإٍ","translit":"ٍiʾَbَsِl","root":"سبا"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"مَسْكَنِهِمْ","translit":"ْmِhِnَkْsَm","root":"سكن"},{"id":6,"arabic":"ءَايَةٌ","translit":"ٌẗَyāَء","root":"ايي"},{"id":7,"arabic":"جَنَّتَانِ","translit":"ِnāَtَّnَjg","root":"جنن"},{"id":8,"arabic":"عَن","translit":"nَʿع","root":""},{"id":9,"arabic":"يَمِينٍ","translit":"ٍnyِmَy","root":"يمن"},{"id":10,"arabic":"وَشِمَالٍ","translit":"ٍlāَmِhsَw","root":"شمل"},{"id":11,"arabic":"كُلُوا۟","translit":"۟āwُlُk","root":"اكل"},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"رِّزْقِ","translit":"ِqْzِّr","root":"رزق"},{"id":14,"arabic":"رَبِّكُمْ","translit":"ْmُkِّbَr","root":"ربب"},{"id":15,"arabic":"وَٱشْكُرُوا۟","translit":"۟āwُrُkْhsٱَw","root":"شكر"},{"id":16,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":17,"arabic":"بَلْدَةٌ","translit":"ٌẗَdْlَb","root":"بلد"},{"id":18,"arabic":"طَيِّبَةٌ","translit":"ٌẗَbِّyَṭ","root":"طيب"},{"id":19,"arabic":"وَرَبٌّ","translit":"ٌّbَrَw","root":"ربب"},{"id":20,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"}],"hasIhya":false},{"ayah":16,"text":"فَأَعْرَضُوا۟ فَأَرْسَلْنَا عَلَيْهِمْ سَيْلَ ٱلْعَرِمِ وَبَدَّلْنَٰهُم بِجَنَّتَيْهِمْ جَنَّتَيْنِ ذَوَاتَىْ أُكُلٍ خَمْطٍ وَأَثْلٍ وَشَىْءٍ مِّن سِدْرٍ قَلِيلٍ ","translation":"But they turned away [refusing], so We sent upon them the flood of the dam,[1] and We replaced their two [fields of] gardens with gardens of bitter fruit, tamarisks and something of sparse lote trees.","words":[{"id":1,"arabic":"فَأَعْرَضُوا۟","translit":"۟āwُḍَrْʿعَaʾَf","root":"عرض"},{"id":2,"arabic":"فَأَرْسَلْنَا","translit":"āَnْlَsْrَaʾَf","root":"رسل"},{"id":3,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":4,"arabic":"سَيْلَ","translit":"َlْyَs","root":"سيل"},{"id":5,"arabic":"ٱلْعَرِمِ","translit":"ِmِrَʿعْlٱ","root":"عرم"},{"id":6,"arabic":"وَبَدَّلْنَٰهُم","translit":"mُhَٰnْlَّdَbَw","root":"بدل"},{"id":7,"arabic":"بِجَنَّتَيْهِمْ","translit":"ْmِhْyَtَّnَjgِb","root":"جنن"},{"id":8,"arabic":"جَنَّتَيْنِ","translit":"ِnْyَtَّnَjg","root":"جنن"},{"id":9,"arabic":"ذَوَاتَىْ","translit":"ْàَtāَwَhd","root":""},{"id":10,"arabic":"أُكُلٍ","translit":"ٍlُkُaʾ","root":"اكل"},{"id":11,"arabic":"خَمْطٍ","translit":"ٍṭْmَhk","root":"خمط"},{"id":12,"arabic":"وَأَثْلٍ","translit":"ٍlْhtَaʾَw","root":"اثل"},{"id":13,"arabic":"وَشَىْءٍ","translit":"ٍءْàَhsَw","root":"شيا"},{"id":14,"arabic":"مِّن","translit":"nِّm","root":""},{"id":15,"arabic":"سِدْرٍ","translit":"ٍrْdِs","root":"سدر"},{"id":16,"arabic":"قَلِيلٍ","translit":"ٍlyِlَq","root":"قلل"}],"hasIhya":false},{"ayah":17,"text":"ذَٰلِكَ جَزَيْنَٰهُم بِمَا كَفَرُوا۟ۖ وَهَلْ نُجَٰزِىٓ إِلَّا ٱلْكَفُورَ ","translation":"[By] that We repaid them because they disbelieved. And do We [thus] repay except the ungrateful?","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"جَزَيْنَٰهُم","translit":"mُhَٰnْyَzَjg","root":"جزي"},{"id":3,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":4,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":5,"arabic":"وَهَلْ","translit":"ْlَhَw","root":""},{"id":6,"arabic":"نُجَٰزِىٓ","translit":"ٓàِzَٰjgُn","root":"جزي"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"ٱلْكَفُورَ","translit":"َrwُfَkْlٱ","root":"كفر"}],"hasIhya":false},{"ayah":18,"text":"وَجَعَلْنَا بَيْنَهُمْ وَبَيْنَ ٱلْقُرَى ٱلَّتِى بَٰرَكْنَا فِيهَا قُرًى ظَٰهِرَةً وَقَدَّرْنَا فِيهَا ٱلسَّيْرَۖ سِيرُوا۟ فِيهَا لَيَالِىَ وَأَيَّامًا ءَامِنِينَ ","translation":"And We placed between them and the cities which We had blessed[1] [many] visible cities. And We determined between them the [distances of] journey,[2] [saying], \"Travel between them by night or by day in safety.\"","words":[{"id":1,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":2,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":3,"arabic":"وَبَيْنَ","translit":"َnْyَbَw","root":"بين"},{"id":4,"arabic":"ٱلْقُرَى","translit":"àَrُqْlٱ","root":"قري"},{"id":5,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":6,"arabic":"بَٰرَكْنَا","translit":"āَnْkَrَٰb","root":"برك"},{"id":7,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":8,"arabic":"قُرًى","translit":"àًrُq","root":"قري"},{"id":9,"arabic":"ظَٰهِرَةً","translit":"ًẗَrِhَٰẓ","root":"ظهر"},{"id":10,"arabic":"وَقَدَّرْنَا","translit":"āَnْrَّdَqَw","root":"قدر"},{"id":11,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":12,"arabic":"ٱلسَّيْرَ","translit":"َrْyَّslٱ","root":"سير"},{"id":13,"arabic":"سِيرُوا۟","translit":"۟āwُryِs","root":"سير"},{"id":14,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":15,"arabic":"لَيَالِىَ","translit":"َàِlāَyَl","root":"ليل"},{"id":16,"arabic":"وَأَيَّامًا","translit":"āًmāَّyَaʾَw","root":"يوم"},{"id":17,"arabic":"ءَامِنِينَ","translit":"َnyِnِmāَء","root":"امن"}],"hasIhya":false},{"ayah":19,"text":"فَقَالُوا۟ رَبَّنَا بَٰعِدْ بَيْنَ أَسْفَارِنَا وَظَلَمُوٓا۟ أَنفُسَهُمْ فَجَعَلْنَٰهُمْ أَحَادِيثَ وَمَزَّقْنَٰهُمْ كُلَّ مُمَزَّقٍۚ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّكُلِّ صَبَّارٍ شَكُورٍ ","translation":"But [insolently] they said, \"Our Lord, lengthen the distance between our journeys,\" and wronged themselves, so We made them narrations[1] and dispersed them in total dispersion. Indeed in that are signs for everyone patient and grateful.","words":[{"id":1,"arabic":"فَقَالُوا۟","translit":"۟āwُlāَqَf","root":"قول"},{"id":2,"arabic":"رَبَّنَا","translit":"āَnَّbَr","root":"ربب"},{"id":3,"arabic":"بَٰعِدْ","translit":"ْdِʿعَٰb","root":"بعد"},{"id":4,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":5,"arabic":"أَسْفَارِنَا","translit":"āَnِrāَfْsَaʾ","root":"سفر"},{"id":6,"arabic":"وَظَلَمُوٓا۟","translit":"۟āٓwُmَlَẓَw","root":"ظلم"},{"id":7,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":8,"arabic":"فَجَعَلْنَٰهُمْ","translit":"ْmُhَٰnْlَʿعَjgَf","root":"جعل"},{"id":9,"arabic":"أَحَادِيثَ","translit":"َhtyِdāَḥَaʾ","root":"حدث"},{"id":10,"arabic":"وَمَزَّقْنَٰهُمْ","translit":"ْmُhَٰnْqَّzَmَw","root":"مزق"},{"id":11,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":12,"arabic":"مُمَزَّقٍ","translit":"ٍqَّzَmُm","root":"مزق"},{"id":13,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":14,"arabic":"فِى","translit":"àِf","root":""},{"id":15,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":16,"arabic":"لَءَايَٰتٍ","translit":"ٍtَٰyāَءَl","root":"ايي"},{"id":17,"arabic":"لِّكُلِّ","translit":"ِّlُkِّl","root":"كلل"},{"id":18,"arabic":"صَبَّارٍ","translit":"ٍrāَّbَṣ","root":"صبر"},{"id":19,"arabic":"شَكُورٍ","translit":"ٍrwُkَhs","root":"شكر"}],"hasIhya":false},{"ayah":20,"text":"وَلَقَدْ صَدَّقَ عَلَيْهِمْ إِبْلِيسُ ظَنَّهُۥ فَٱتَّبَعُوهُ إِلَّا فَرِيقًا مِّنَ ٱلْمُؤْمِنِينَ ","translation":"And Iblees had already confirmed through them[1] his assumption,[2] so they followed him, except for a party of believers.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"صَدَّقَ","translit":"َqَّdَṣ","root":"صدق"},{"id":3,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":4,"arabic":"إِبْلِيسُ","translit":"ُsyِlْbِiʾ","root":""},{"id":5,"arabic":"ظَنَّهُۥ","translit":"ۥُhَّnَẓ","root":"ظنن"},{"id":6,"arabic":"فَٱتَّبَعُوهُ","translit":"ُhwُʿعَbَّtٱَf","root":"تبع"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"فَرِيقًا","translit":"āًqyِrَf","root":"فرق"},{"id":9,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":10,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"}],"hasIhya":false},{"ayah":21,"text":"وَمَا كَانَ لَهُۥ عَلَيْهِم مِّن سُلْطَٰنٍ إِلَّا لِنَعْلَمَ مَن يُؤْمِنُ بِٱلْءَاخِرَةِ مِمَّنْ هُوَ مِنْهَا فِى شَكٍّۗ وَرَبُّكَ عَلَىٰ كُلِّ شَىْءٍ حَفِيظٌ ","translation":"And he had over them no authority except [it was decreed] that We might make evident who believes in the Hereafter from who is thereof in doubt. And your Lord, over all things, is Guardian.[1]","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":4,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"سُلْطَٰنٍ","translit":"ٍnَٰṭْlُs","root":"سلط"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"لِنَعْلَمَ","translit":"َmَlْʿعَnِl","root":"علم"},{"id":9,"arabic":"مَن","translit":"nَm","root":""},{"id":10,"arabic":"يُؤْمِنُ","translit":"ُnِmْwʾُy","root":"امن"},{"id":11,"arabic":"بِٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱِb","root":"اخر"},{"id":12,"arabic":"مِمَّنْ","translit":"ْnَّmِm","root":""},{"id":13,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":14,"arabic":"مِنْهَا","translit":