id":35,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":36,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":37,"arabic":"لَا","translit":"āَl","root":""},{"id":38,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":39,"arabic":"ٱلْقَوْمَ","translit":"َmْwَqْlٱ","root":"قوم"},{"id":40,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":true},{"ayah":145,"text":"قُل لَّآ أَجِدُ فِى مَآ أُوحِىَ إِلَىَّ مُحَرَّمًا عَلَىٰ طَاعِمٍ يَطْعَمُهُۥٓ إِلَّآ أَن يَكُونَ مَيْتَةً أَوْ دَمًا مَّسْفُوحًا أَوْ لَحْمَ خِنزِيرٍ فَإِنَّهُۥ رِجْسٌ أَوْ فِسْقًا أُهِلَّ لِغَيْرِ ٱللَّهِ بِهِۦۚ فَمَنِ ٱضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ رَبَّكَ غَفُورٌ رَّحِيمٌ ","translation":"Say, \"I do not find within that which was revealed to me [anything] forbidden to one who would eat it unless it be a dead animal or blood spilled out or the flesh of swine - for indeed, it is impure - or it be [that slaughtered in] disobedience, dedicated to other than Allāh.[1] But whoever is forced [by necessity], neither desiring [it] nor transgressing [its limit], then indeed, your Lord is Forgiving and Merciful.\"","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لَّآ","translit":"ٓāَّl","root":""},{"id":3,"arabic":"أَجِدُ","translit":"ُdِjgَaʾ","root":"وجد"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":6,"arabic":"أُوحِىَ","translit":"َàِḥwُaʾ","root":"وحي"},{"id":7,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":8,"arabic":"مُحَرَّمًا","translit":"āًmَّrَḥُm","root":"حرم"},{"id":9,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":10,"arabic":"طَاعِمٍ","translit":"ٍmِʿعāَṭ","root":"طعم"},{"id":11,"arabic":"يَطْعَمُهُۥٓ","translit":"ٓۥُhُmَʿعْṭَy","root":"طعم"},{"id":12,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":13,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":14,"arabic":"يَكُونَ","translit":"َnwُkَy","root":"كون"},{"id":1