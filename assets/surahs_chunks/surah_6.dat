{"surah": 6, "verses": [{"ayah": 1, "text": "ٱلْحَمْدُ لِلَّهِ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَجَعَلَ ٱلظُّلُمَٰتِ وَٱلنُّورَۖ ثُمَّ ٱلَّذِينَ كَفَرُوا۟ بِرَبِّهِمْ يَعْدِلُونَ ", "translation": "[All] praise is [due] to Allāh, who created the heavens and the earth and made the darkness and the light. Then those who disbelieve equate [others] with their Lord.", "words": [{"id": 1, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "ٱلظُّلُمَٰتِ", "translit": "ِtَٰmُlُّẓlٱ", "root": "ظلم"}, {"id": 9, "arabic": "وَٱلنُّورَ", "translit": "َrwُّnlٱَw", "root": "نور"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 13, "arabic": "بِرَبِّهِمْ", "translit": "ْmِhِّbَrِb", "root": "ربب"}, {"id": 14, "arabic": "يَعْدِلُونَ", "translit": "َnwُlِdْʿعَy", "root": "عدل"}], "hasIhya": true}, {"ayah": 2, "text": "هُوَ ٱلَّذِى خَلَقَكُم مِّن طِينٍ ثُمَّ قَضَىٰٓ أَجَلًاۖ وَأَجَلٌ مُّسَمًّى عِندَهُۥۖ ثُمَّ أَنتُمْ تَمْتَرُونَ ", "translation": "It is He who created you from clay and then decreed a term[1] and a specified time [known] to Him;[2] then [still] you are in dispute.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَكُم", "translit": "mُkَqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "طِينٍ", "translit": "ٍnyِṭ", "root": "طين"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "قَضَىٰٓ", "translit": "ٰٓàَḍَq", "root": "قضي"}, {"id": 8, "arabic": "أَجَلًا", "translit": "āًlَjgَaʾ", "root": "اجل"}, {"id": 9, "arabic": "وَأَجَلٌ", "translit": "ٌlَjgَaʾَw", "root": "اجل"}, {"id": 10, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 11, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 12, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 13, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 14, "arabic": "تَمْتَرُونَ", "translit": "َnwُrَtْmَt", "root": "مري"}], "hasIhya": false}, {"ayah": 3, "text": "وَهُوَ ٱللَّهُ فِى ٱلسَّمَٰوَٰتِ وَفِى ٱلْأَرْضِۖ يَعْلَمُ سِرَّكُمْ وَجَهْرَكُمْ وَيَعْلَمُ مَا تَكْسِبُونَ ", "translation": "And He is Allāh, [the only deity] in the heavens and the earth. He knows your secret and what you make public, and He knows that which you earn.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 8, "arabic": "سِرَّكُمْ", "translit": "ْmُkَّrِs", "root": "سرر"}, {"id": 9, "arabic": "وَجَهْرَكُمْ", "translit": "ْmُkَrْhَjgَw", "root": "جهر"}, {"id": 10, "arabic": "وَيَعْلَمُ", "translit": "ُmَlْʿعَyَw", "root": "علم"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "تَكْسِبُونَ", "translit": "َnwُbِsْkَt", "root": "كسب"}], "hasIhya": false}, {"ayah": 4, "text": "وَمَا تَأْتِيهِم مِّنْ ءَايَةٍ مِّنْ ءَايَٰتِ رَبِّهِمْ إِلَّا كَانُوا۟ عَنْهَا مُعْرِضِينَ ", "translation": "And no sign comes to them from the signs of their Lord except that they turn away therefrom.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تَأْتِيهِم", "translit": "mِhyِtْaʾَt", "root": "اتي"}, {"id": 3, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 4, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 5, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 6, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 7, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 11, "arabic": "مُعْرِضِينَ", "translit": "َnyِḍِrْʿعُm", "root": "عرض"}], "hasIhya": true}, {"ayah": 5, "text": "فَقَدْ كَذَّبُوا۟ بِٱلْحَقِّ لَمَّا جَآءَهُمْۖ فَسَوْفَ يَأْتِيهِمْ أَنۢبَٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "For they had denied the truth when it came to them, but there is going to reach them the news of what they used to ridicule.[1]", "words": [{"id": 1, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 2, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 4, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 5, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 6, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 7, "arabic": "يَأْتِيهِمْ", "translit": "ْmِhyِtْaʾَy", "root": "اتي"}, {"id": 8, "arabic": "أَنۢبَٰٓؤُا۟", "translit": "۟āُwʾَٰٓbۢnَaʾ", "root": "نبا"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 6, "text": "أَلَمْ يَرَوْا۟ كَمْ أَهْلَكْنَا مِن قَبْلِهِم مِّن قَرْنٍ مَّكَّنَّٰهُمْ فِى ٱلْأَرْضِ مَا لَمْ نُمَكِّن لَّكُمْ وَأَرْسَلْنَا ٱلسَّمَآءَ عَلَيْهِم مِّدْرَارًا وَجَعَلْنَا ٱلْأَنْهَٰرَ تَجْرِى مِن تَحْتِهِمْ فَأَهْلَكْنَٰهُم بِذُنُوبِهِمْ وَأَنشَأْنَا مِنۢ بَعْدِهِمْ قَرْنًا ءَاخَرِينَ ", "translation": "Have they not seen how many generations We destroyed before them which We had established upon the earth as We have not established you? And We sent [rain from] the sky upon them in showers and made rivers flow beneath them; then We destroyed them for their sins and brought forth after them a generation of others.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "كَمْ", "translit": "ْmَk", "root": ""}, {"id": 4, "arabic": "أَهْلَكْنَا", "translit": "āَnْkَlْhَaʾ", "root": "هلك"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلِهِم", "translit": "mِhِlْbَq", "root": "قبل"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "قَرْنٍ", "translit": "ٍnْrَq", "root": "قرن"}, {"id": 9, "arabic": "مَّكَّنَّٰهُمْ", "translit": "ْmُhَّٰnَّkَّm", "root": "مكن"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 14, "arabic": "نُمَكِّن", "translit": "nِّkَmُn", "root": "مكن"}, {"id": 15, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 16, "arabic": "وَأَرْسَلْنَا", "translit": "āَnْlَsْrَaʾَw", "root": "رسل"}, {"id": 17, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 18, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 19, "arabic": "مِّدْرَارًا", "translit": "āًrāَrْdِّm", "root": "درر"}, {"id": 20, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 21, "arabic": "ٱلْأَنْهَٰرَ", "translit": "َrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 22, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 23, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 24, "arabic": "تَحْتِهِمْ", "translit": "ْmِhِtْḥَt", "root": "تحت"}, {"id": 25, "arabic": "فَأَهْلَكْنَٰهُم", "translit": "mُhَٰnْkَlْhَaʾَf", "root": "هلك"}, {"id": 26, "arabic": "بِذُنُوبِهِمْ", "translit": "ْmِhِbwُnُhdِb", "root": "ذنب"}, {"id": 27, "arabic": "وَأَنشَأْنَا", "translit": "āَnْaʾَhsnَaʾَw", "root": "نشا"}, {"id": 28, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 29, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 30, "arabic": "قَرْنًا", "translit": "āًnْrَq", "root": "قرن"}, {"id": 31, "arabic": "ءَاخَرِينَ", "translit": "َnyِrَhkāَء", "root": "اخر"}], "hasIhya": false}, {"ayah": 7, "text": "وَلَوْ نَزَّلْنَا عَلَيْكَ كِتَٰبًا فِى قِرْطَاسٍ فَلَمَسُوهُ بِأَيْدِيهِمْ لَقَالَ ٱلَّذِينَ كَفَرُوٓا۟ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ ", "translation": "And even if We had sent down to you, [O Muḥammad], a written scripture on a page and they touched it with their hands, the disbelievers would say, \"This is not but obvious magic.\"", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "نَزَّلْنَا", "translit": "āَnْlَّzَn", "root": "نزل"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "كِتَٰبًا", "translit": "āًbَٰtِk", "root": "كتب"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "قِرْطَاسٍ", "translit": "ٍsāَṭْrِq", "root": "قرطس"}, {"id": 7, "arabic": "فَلَمَسُوهُ", "translit": "ُhwُsَmَlَf", "root": "لمس"}, {"id": 8, "arabic": "بِأَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾِb", "root": "يدي"}, {"id": 9, "arabic": "لَقَالَ", "translit": "َlāَqَl", "root": "قول"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 12, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 13, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "سِحْرٌ", "translit": "ٌrْḥِs", "root": "سحر"}, {"id": 16, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 8, "text": "وَقَالُوا۟ لَوْلَآ أُنزِلَ عَلَيْهِ مَلَكٌۖ وَلَوْ أَنزَلْنَا مَلَكًا لَّقُضِىَ ٱلْأَمْرُ ثُمَّ لَا يُنظَرُونَ ", "translation": "And they say, \"Why was there not sent down to him an angel?\"[1] But if We had sent down an angel, the matter would have been decided;[2] then they would not be reprieved.", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 3, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "مَلَكٌ", "translit": "ٌkَlَm", "root": "ملك"}, {"id": 6, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 7, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 8, "arabic": "مَلَكًا", "translit": "āًkَlَm", "root": "ملك"}, {"id": 9, "arabic": "لَّقُضِىَ", "translit": "َàِḍُqَّl", "root": "قضي"}, {"id": 10, "arabic": "ٱلْأَمْرُ", "translit": "ُrْmَaʾْlٱ", "root": "امر"}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُنظَرُونَ", "translit": "َnwُrَẓnُy", "root": "نظر"}], "hasIhya": true}, {"ayah": 9, "text": "وَلَوْ جَعَلْنَٰهُ مَلَكًا لَّجَعَلْنَٰهُ رَجُلًا وَلَلَبَسْنَا عَلَيْهِم مَّا يَلْبِسُونَ ", "translation": "And if We had made him [i.e., the messenger] an angel, We would have made him [appear as] a man, and We would have covered them with that in which they cover themselves [i.e., confusion and doubt].", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "مَلَكًا", "translit": "āًkَlَm", "root": "ملك"}, {"id": 4, "arabic": "لَّجَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjgَّl", "root": "جعل"}, {"id": 5, "arabic": "رَجُلًا", "translit": "āًlُjgَr", "root": "رجل"}, {"id": 6, "arabic": "وَلَلَبَسْنَا", "translit": "āَnْsَbَlَlَw", "root": "لبس"}, {"id": 7, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "يَلْبِسُونَ", "translit": "َnwُsِbْlَy", "root": "لبس"}], "hasIhya": false}, {"ayah": 10, "text": "وَلَقَدِ ٱسْتُهْزِئَ بِرُسُلٍ مِّن قَبْلِكَ فَحَاقَ بِٱلَّذِينَ سَخِرُوا۟ مِنْهُم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "And already were messengers ridiculed before you, but those who mocked them were enveloped by that which they used to ridicule.", "words": [{"id": 1, "arabic": "وَلَقَدِ", "translit": "ِdَqَlَw", "root": ""}, {"id": 2, "arabic": "ٱسْتُهْزِئَ", "translit": "َyʾِzْhُtْsٱ", "root": "هزا"}, {"id": 3, "arabic": "بِرُسُلٍ", "translit": "ٍlُsُrِb", "root": "رسل"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فَحَاقَ", "translit": "َqāَḥَf", "root": "حيق"}, {"id": 7, "arabic": "بِٱلَّذِينَ", "translit": "َnyِhdَّlٱِb", "root": ""}, {"id": 8, "arabic": "سَخِرُوا۟", "translit": "۟āwُrِhkَs", "root": "سخر"}, {"id": 9, "arabic": "مِنْهُم", "translit": "mُhْnِm", "root": ""}, {"id": 10, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 11, "text": "قُلْ سِيرُوا۟ فِى ٱلْأَرْضِ ثُمَّ ٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ ", "translation": "Say, \"Travel through the land; then observe how was the end of the deniers.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "سِيرُوا۟", "translit": "۟āwُryِs", "root": "سير"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "ٱنظُرُوا۟", "translit": "۟āwُrُẓnٱ", "root": "نظر"}, {"id": 7, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 8, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 9, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 10, "arabic": "ٱلْمُكَذِّبِينَ", "translit": "َnyِbِّhdَkُmْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 12, "text": "قُل لِّمَن مَّا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ قُل لِّلَّهِۚ كَتَبَ عَلَىٰ نَفْسِهِ ٱلرَّحْمَةَۚ لَيَجْمَعَنَّكُمْ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ لَا رَيْبَ فِيهِۚ ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ فَهُمْ لَا يُؤْمِنُونَ ", "translation": "Say, \"To whom belongs whatever is in the heavens and earth?\" Say, \"To Allāh.\" He has decreed upon Himself mercy. He will surely assemble you for the Day of Resurrection, about which there is no doubt. Those who will lose themselves [that Day] do not believe.", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لِّمَن", "translit": "nَmِّl", "root": ""}, {"id": 3, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 8, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 9, "arabic": "كَتَبَ", "translit": "َbَtَk", "root": "كتب"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "نَفْسِهِ", "translit": "ِhِsْfَn", "root": "نفس"}, {"id": 12, "arabic": "ٱلرَّحْمَةَ", "translit": "َẗَmْḥَّrlٱ", "root": "رحم"}, {"id": 13, "arabic": "لَيَجْمَعَنَّكُمْ", "translit": "ْmُkَّnَʿعَmْjgَyَl", "root": "جمع"}, {"id": 14, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 15, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 16, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 19, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 20, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 21, "arabic": "خَسِرُوٓا۟", "translit": "۟āٓwُrِsَhk", "root": "خسر"}, {"id": 22, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 23, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 13, "text": "وَلَهُۥ مَا سَكَنَ فِى ٱلَّيْلِ وَٱلنَّهَارِۚ وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ", "translation": "And to Him belongs that which reposes by night and by day, and He is the Hearing, the Knowing.", "words": [{"id": 1, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "سَكَنَ", "translit": "َnَkَs", "root": "سكن"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 6, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 7, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 8, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 9, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 14, "text": "قُلْ أَغَيْرَ ٱللَّهِ أَتَّخِذُ وَلِيًّا فَاطِرِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَهُوَ يُطْعِمُ وَلَا يُطْعَمُۗ قُلْ إِنِّىٓ أُمِرْتُ أَنْ أَكُونَ أَوَّلَ مَنْ أَسْلَمَۖ وَلَا تَكُونَنَّ مِنَ ٱلْمُشْرِكِينَ ", "translation": "Say, \"Is it other than Allāh I should take as a protector, Creator of the heavens and earth, while it is He who feeds and is not fed?\" Say, [O Muḥammad], \"Indeed, I have been commanded to be the first [among you] who submit [to Allāh] and [was commanded], 'Do not ever be of the polytheists.'\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَغَيْرَ", "translit": "َrْyَغَaʾ", "root": "غير"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "أَتَّخِذُ", "translit": "ُhdِhkَّtَaʾ", "root": "اخذ"}, {"id": 5, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 6, "arabic": "فَاطِرِ", "translit": "ِrِṭāَf", "root": "فطر"}, {"id": 7, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 8, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "يُطْعِمُ", "translit": "ُmِʿعْṭُy", "root": "طعم"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "يُطْعَمُ", "translit": "ُmَʿعْṭُy", "root": "طعم"}, {"id": 13, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 14, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 15, "arabic": "أُمِرْتُ", "translit": "ُtْrِmُaʾ", "root": "امر"}, {"id": 16, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 17, "arabic": "أَكُونَ", "translit": "َnwُkَaʾ", "root": "كون"}, {"id": 18, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 19, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 20, "arabic": "أَسْلَمَ", "translit": "َmَlْsَaʾ", "root": "سلم"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "تَكُونَنَّ", "translit": "َّnَnwُkَt", "root": "كون"}, {"id": 23, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 24, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": false}, {"ayah": 15, "text": "قُلْ إِنِّىٓ أَخَافُ إِنْ عَصَيْتُ رَبِّى عَذَابَ يَوْمٍ عَظِيمٍ ", "translation": "Say, \"Indeed I fear, if I should disobey my Lord, the punishment of a tremendous Day.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 4, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 5, "arabic": "عَصَيْتُ", "translit": "ُtْyَṣَʿع", "root": "عصي"}, {"id": 6, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 7, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 8, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 9, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 16, "text": "مَّن يُصْرَفْ عَنْهُ يَوْمَئِذٍ فَقَدْ رَحِمَهُۥۚ وَذَٰلِكَ ٱلْفَوْزُ ٱلْمُبِينُ ", "translation": "He from whom it is averted that Day - [Allāh] has granted him mercy. And that is the clear attainment.", "words": [{"id": 1, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 2, "arabic": "يُصْرَفْ", "translit": "ْfَrْṣُy", "root": "صرف"}, {"id": 3, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 4, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 5, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 6, "arabic": "رَحِمَهُۥ", "translit": "ۥُhَmِḥَr", "root": "رحم"}, {"id": 7, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 8, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 9, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 17, "text": "وَإِن يَمْسَسْكَ ٱللَّهُ بِضُرٍّ فَلَا كَاشِفَ لَهُۥٓ إِلَّا هُوَۖ وَإِن يَمْسَسْكَ بِخَيْرٍ فَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "And if Allāh should touch you with adversity, there is no remover of it except Him. And if He touches you with good - then He is over all things competent.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "يَمْسَسْكَ", "translit": "َkْsَsْmَy", "root": "مسس"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "بِضُرٍّ", "translit": "ٍّrُḍِb", "root": "ضرر"}, {"id": 5, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 6, "arabic": "كَاشِفَ", "translit": "َfِhsāَk", "root": "كشف"}, {"id": 7, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 10, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 11, "arabic": "يَمْسَسْكَ", "translit": "َkْsَsْmَy", "root": "مسس"}, {"id": 12, "arabic": "بِخَيْرٍ", "translit": "ٍrْyَhkِb", "root": "خير"}, {"id": 13, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 14, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 15, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 16, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 17, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 18, "text": "وَهُوَ ٱلْقَاهِرُ فَوْقَ عِبَادِهِۦۚ وَهُوَ ٱلْحَكِيمُ ٱلْخَبِيرُ ", "translation": "And He is the subjugator over His servants. And He is the Wise,[1] the Aware.[2]", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلْقَاهِرُ", "translit": "ُrِhāَqْlٱ", "root": "قهر"}, {"id": 3, "arabic": "فَوْقَ", "translit": "َqْwَf", "root": "فوق"}, {"id": 4, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}, {"id": 7, "arabic": "ٱلْخَبِيرُ", "translit": "ُryِbَhkْlٱ", "root": "خبر"}], "hasIhya": false}, {"ayah": 19, "text": "قُلْ أَىُّ شَىْءٍ أَكْبَرُ شَهَٰدَةًۖ قُلِ ٱللَّهُۖ شَهِيدٌۢ بَيْنِى وَبَيْنَكُمْۚ وَأُوحِىَ إِلَىَّ هَٰذَا ٱلْقُرْءَانُ لِأُنذِرَكُم بِهِۦ وَمَنۢ بَلَغَۚ أَئِنَّكُمْ لَتَشْهَدُونَ أَنَّ مَعَ ٱللَّهِ ءَالِهَةً أُخْرَىٰۚ قُل لَّآ أَشْهَدُۚ قُلْ إِنَّمَا هُوَ إِلَٰهٌ وَٰحِدٌ وَإِنَّنِى بَرِىٓءٌ مِّمَّا تُشْرِكُونَ ", "translation": "Say, \"What thing is greatest in testimony?\" Say, \"Allāh is witness between me and you. And this Qur’ān was revealed to me that I may warn you thereby and whomever it reaches.[1] Do you [truly] testify that with Allāh there are other deities?\" Say, \"I will not testify [with you].\" Say, \"Indeed, He is but one God, and indeed, I am free of what you associate [with Him].\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَىُّ", "translit": "ُّàَaʾ", "root": "ايي"}, {"id": 3, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 4, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 5, "arabic": "شَهَٰدَةً", "translit": "ًẗَdَٰhَhs", "root": "شهد"}, {"id": 6, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "شَهِيدٌۢ", "translit": "ٌۢdyِhَhs", "root": "شهد"}, {"id": 9, "arabic": "بَيْنِى", "translit": "àِnْyَb", "root": "بين"}, {"id": 10, "arabic": "وَبَيْنَكُمْ", "translit": "ْmُkَnْyَbَw", "root": "بين"}, {"id": 11, "arabic": "وَأُوحِىَ", "translit": "َàِḥwُaʾَw", "root": "وحي"}, {"id": 12, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 13, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 14, "arabic": "ٱلْقُرْءَانُ", "translit": "ُnāَءْrُqْlٱ", "root": "قرا"}, {"id": 15, "arabic": "لِأُنذِرَكُم", "translit": "mُkَrِhdnُaʾِl", "root": "نذر"}, {"id": 16, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 17, "arabic": "وَمَنۢ", "translit": "ۢnَmَw", "root": ""}, {"id": 18, "arabic": "بَلَغَ", "translit": "َغَlَb", "root": "بلغ"}, {"id": 19, "arabic": "أَئِنَّكُمْ", "translit": "ْmُkَّnِyʾَaʾ", "root": ""}, {"id": 20, "arabic": "لَتَشْهَدُونَ", "translit": "َnwُdَhْhsَtَl", "root": "شهد"}, {"id": 21, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 22, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 25, "arabic": "أُخْرَىٰ", "translit": "ٰàَrْhkُaʾ", "root": "اخر"}, {"id": 26, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 27, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 28, "arabic": "أَشْهَدُ", "translit": "ُdَhْhsَaʾ", "root": "شهد"}, {"id": 29, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 30, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 31, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 32, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 33, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 34, "arabic": "وَإِنَّنِى", "translit": "àِnَّnِiʾَw", "root": ""}, {"id": 35, "arabic": "بَرِىٓءٌ", "translit": "ٌءٓàِrَb", "root": "برا"}, {"id": 36, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 37, "arabic": "تُشْرِكُونَ", "translit": "َnwُkِrْhsُt", "root": "شرك"}], "hasIhya": true}, {"ayah": 20, "text": "ٱلَّذِينَ ءَاتَيْنَٰهُمُ ٱلْكِتَٰبَ يَعْرِفُونَهُۥ كَمَا يَعْرِفُونَ أَبْنَآءَهُمُۘ ٱلَّذِينَ خَسِرُوٓا۟ أَنفُسَهُمْ فَهُمْ لَا يُؤْمِنُونَ ", "translation": "Those to whom We have given the Scripture recognize it[1] as they recognize their [own] sons. Those who will lose themselves [in the Hereafter] do not believe.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَٰهُمُ", "translit": "ُmُhَٰnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "يَعْرِفُونَهُۥ", "translit": "ۥُhَnwُfِrْʿعَy", "root": "عرف"}, {"id": 5, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 6, "arabic": "يَعْرِفُونَ", "translit": "َnwُfِrْʿعَy", "root": "عرف"}, {"id": 7, "arabic": "أَبْنَآءَهُمُ", "translit": "ُmُhَءٓāَnْbَaʾ", "root": "بني"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "خَسِرُوٓا۟", "translit": "۟āٓwُrِsَhk", "root": "خسر"}, {"id": 10, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 11, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": true}, {"ayah": 21, "text": "وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوْ كَذَّبَ بِـَٔايَٰتِهِۦٓۗ إِنَّهُۥ لَا يُفْلِحُ ٱلظَّٰلِمُونَ ", "translation": "And who is more unjust than one who invents about Allāh a lie or denies His verses? Indeed, the wrongdoers will not succeed.", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 3, "arabic": "مِمَّنِ", "translit": "ِnَّmِm", "root": ""}, {"id": 4, "arabic": "ٱفْتَرَىٰ", "translit": "ٰàَrَtْfٱ", "root": "فري"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 10, "arabic": "بِـَٔايَٰتِهِۦٓ", "translit": "ٓۦِhِtَٰyāَٔـِb", "root": "ايي"}, {"id": 11, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُفْلِحُ", "translit": "ُḥِlْfُy", "root": "فلح"}, {"id": 14, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 22, "text": "وَيَوْمَ نَحْشُرُهُمْ جَمِيعًا ثُمَّ نَقُولُ لِلَّذِينَ أَشْرَكُوٓا۟ أَيْنَ شُرَكَآؤُكُمُ ٱلَّذِينَ كُنتُمْ تَزْعُمُونَ ", "translation": "And [mention, O Muḥammad], the Day We will gather them all together; then We will say to those who associated others with Allāh, \"Where are your 'partners' that you used to claim [with Him]?\"", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "نَحْشُرُهُمْ", "translit": "ْmُhُrُhsْḥَn", "root": "حشر"}, {"id": 3, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "نَقُولُ", "translit": "ُlwُqَn", "root": "قول"}, {"id": 6, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 7, "arabic": "أَشْرَكُوٓا۟", "translit": "۟āٓwُkَrْhsَaʾ", "root": "شرك"}, {"id": 8, "arabic": "أَيْنَ", "translit": "َnْyَaʾ", "root": ""}, {"id": 9, "arabic": "شُرَكَآؤُكُمُ", "translit": "ُmُkُwʾٓāَkَrُhs", "root": "شرك"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 12, "arabic": "تَزْعُمُونَ", "translit": "َnwُmُʿعْzَt", "root": "زعم"}], "hasIhya": false}, {"ayah": 23, "text": "ثُمَّ لَمْ تَكُن فِتْنَتُهُمْ إِلَّآ أَن قَالُوا۟ وَٱللَّهِ رَبِّنَا مَا كُنَّا مُشْرِكِينَ ", "translation": "Then there will be no [excuse upon] examination except they will say, \"By Allāh, our Lord, we were not those who associated.\"", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 3, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 4, "arabic": "فِتْنَتُهُمْ", "translit": "ْmُhُtَnْtِf", "root": "فتن"}, {"id": 5, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 8, "arabic": "وَٱللَّهِ", "translit": "ِhَّllٱَw", "root": "اله"}, {"id": 9, "arabic": "رَبِّنَا", "translit": "āَnِّbَr", "root": "ربب"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 12, "arabic": "مُشْرِكِينَ", "translit": "َnyِkِrْhsُm", "root": "شرك"}], "hasIhya": false}, {"ayah": 24, "text": "ٱنظُرْ كَيْفَ كَذَبُوا۟ عَلَىٰٓ أَنفُسِهِمْۚ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ", "translation": "See how they will lie about themselves. And lost from them will be what they used to invent.", "words": [{"id": 1, "arabic": "ٱنظُرْ", "translit": "ْrُẓnٱ", "root": "نظر"}, {"id": 2, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 3, "arabic": "كَذَبُوا۟", "translit": "۟āwُbَhdَk", "root": "كذب"}, {"id": 4, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 5, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "وَضَلَّ", "translit": "َّlَḍَw", "root": "ضلل"}, {"id": 7, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}], "hasIhya": false}, {"ayah": 25, "text": "وَمِنْهُم مَّن يَسْتَمِعُ إِلَيْكَۖ وَجَعَلْنَا عَلَىٰ قُلُوبِهِمْ أَكِنَّةً أَن يَفْقَهُوهُ وَفِىٓ ءَاذَانِهِمْ وَقْرًاۚ وَإِن يَرَوْا۟ كُلَّ ءَايَةٍ لَّا يُؤْمِنُوا۟ بِهَاۚ حَتَّىٰٓ إِذَا جَآءُوكَ يُجَٰدِلُونَكَ يَقُولُ ٱلَّذِينَ كَفَرُوٓا۟ إِنْ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلْأَوَّلِينَ ", "translation": "And among them are those who listen to you,[1] but We have placed over their hearts coverings, lest they understand it, and in their ears deafness. And if they should see every sign, they will not believe in it. Even when they come to you arguing with you, those who disbelieve say, \"This is not but legends of the former peoples.\"", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "يَسْتَمِعُ", "translit": "ُʿعِmَtْsَy", "root": "سمع"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 8, "arabic": "أَكِنَّةً", "translit": "ًẗَّnِkَaʾ", "root": "كنن"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يَفْقَهُوهُ", "translit": "ُhwُhَqْfَy", "root": "فقه"}, {"id": 11, "arabic": "وَفِىٓ", "translit": "ٓàِfَw", "root": ""}, {"id": 12, "arabic": "ءَاذَانِهِمْ", "translit": "ْmِhِnāَhdāَء", "root": "اذن"}, {"id": 13, "arabic": "وَقْرًا", "translit": "āًrْqَw", "root": "وقر"}, {"id": 14, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 15, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 16, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 17, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 18, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 19, "arabic": "يُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُy", "root": "امن"}, {"id": 