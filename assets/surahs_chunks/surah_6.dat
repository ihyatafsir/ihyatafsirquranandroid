translit":"ْmُkِlَٰhd","root":""},{"id":42,"arabic":"لَءَايَٰتٍ","translit":"ٍtَٰyāَءَl","root":"ايي"},{"id":43,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":44,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":false},{"ayah":100,"text":"وَجَعَلُوا۟ لِلَّهِ شُرَكَآءَ ٱلْجِنَّ وَخَلَقَهُمْۖ وَخَرَقُوا۟ لَهُۥ بَنِينَ وَبَنَٰتٍۭ بِغَيْرِ عِلْمٍۚ سُبْحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يَصِفُونَ ","translation":"But they have attributed to Allāh partners - the jinn, while He has created them - and have fabricated for Him sons and daughters without knowledge. Exalted is He and high above what they describe.","words":[{"id":1,"arabic":"وَجَعَلُوا۟","translit":"۟āwُlَʿعَjgَw","root":"جعل"},{"id":2,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":3,"arabic":"شُرَكَآءَ","translit":"َءٓāَkَrُhs","root":"شرك"},{"id":4,"arabic":"ٱلْجِنَّ","translit":"َّnِjgْlٱ","root":"جنن"},{"id":5,"arabic":"وَخَلَقَهُمْ","translit":"ْmُhَqَlَhkَw","root":"خلق"},{"id":6,"arabic":"وَخَرَقُوا۟","translit":"۟āwُqَrَhkَw","root":"خرق"},{"id":7,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":8,"arabic":"بَنِينَ","translit":"َnyِnَb","root":"بني"},{"id":9,"arabic":"وَبَنَٰتٍۭ","translit":"ٍۭtَٰnَbَw","root":"بني"},{"id":10,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":11,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":12,"arabic":"سُبْحَٰنَهُۥ","translit":"ۥُhَnَٰḥْbُs","root":"سبح"},{"id":13,"arabic":"وَتَعَٰلَىٰ","translit":"ٰàَlَٰʿعَtَw","root":"علو"},{"id":14,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":15,"arabic":"يَصِفُونَ","translit":"َnwُfِṣَy","root":"وصف"}],"hasIhya":false},{"ayah":101,"text":"بَدِيعُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ أَنَّىٰ يَكُونُ لَهُۥ وَلَدٌ وَلَمْ تَكُن لَّهُۥ صَٰحِبَةٌۖ وَخَلَقَ كُلَّ شَىْءٍۖ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ ","translation":"[He is] Originator of the heavens and the earth. How could He have a son when He does not have a companion [i.e., wife] and He created all things? And He is, of all things, Knowing.","words":[{"id":1,"arabic":"بَدِيعُ","translit":"ُʿعyِdَb","root":"بدع"},{"id":2,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":3,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":4,"arabic":"أَنَّىٰ","translit":"ٰàَّnَaʾ","root":""},{"id":5,"arabic":"يَكُونُ","translit":"ُnwُkَy","root":"كون"},{"id":6,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":7,"arabic":"وَلَدٌ","translit":"ٌdَlَw","root":"ولد"},{"id":8,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":9,"arabic":"تَكُن","translit":"nُkَt","root":"كون"},{"id":10,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":11,"arabic":"صَٰحِبَةٌ","translit":"ٌẗَbِḥَٰṣ","root":"صحب"},{"id":12,"arabic":"وَخَلَقَ","translit":"َqَlَhkَw","root":"خلق"},{"id":13,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":14,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":15,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":16,"arabic":"بِكُلِّ","translit":"ِّlُkِb","root":"كلل"},{"id":17,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":18,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":102,"text":"ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْۖ لَآ إِلَٰهَ إِلَّا هُوَۖ خَٰلِقُ كُلِّ شَىْءٍ فَٱعْبُدُوهُۚ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ وَكِيلٌ ","translation":"That is Allāh, your Lord; there is no deity except Him, the Creator of all things, so worship Him. And He is Disposer of all things.","words":[{"id":1,"arabic":"ذَٰلِكُمُ","translit":"ُmُkِlَٰhd","root":""},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"رَبُّكُمْ","translit":"ْmُkُّbَr","root":"ربب"},{"id":4,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":5,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":8,"arabic":"خَٰلِقُ","translit":"ُqِlَٰhk","root":"خلق"},{"id":9,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":10,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":11,"arabic":"فَٱعْبُدُوهُ","translit":"ُhwُdُbْʿعٱَf","root":"عبد"},{"id":12,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":13,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":14,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":15,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":16,"arabic":"وَكِيلٌ","translit":"ٌlyِkَw","root":"وكل"}],"hasIhya":false},{"ayah":103,"text":"لَّا تُدْرِكُهُ ٱلْأَبْصَٰرُ وَهُوَ يُدْرِكُ ٱلْأَبْصَٰرَۖ وَهُوَ ٱللَّطِيفُ ٱلْخَبِيرُ ","translation":"Vision perceives Him not,[1] but He perceives [all] vision; and He is the Subtle,[2] the Aware.[3]","words":[{"id":1,"arabic":"لَّا","translit":"āَّl","root":""},{"id":2,"arabic":"تُدْرِكُهُ","translit":"ُhُkِrْdُt","root":"درك"},{"id":3,"arabic":"ٱلْأَبْصَٰرُ","translit":"ُrَٰṣْbَaʾْlٱ","root":"بصر"},{"id":4,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":5,"arabic":"يُدْرِكُ","translit":"ُkِrْdُy","root":"درك"},{"id":6,"arabic":"ٱلْأَبْصَٰرَ","translit":"َrَٰṣْbَaʾْlٱ","root":"بصر"},{"id":7,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":8,"arabic":"ٱللَّطِيفُ","translit":"ُfyِṭَّllٱ","root":"لطف"},{"id":9,"arabic":"ٱلْخَبِيرُ","translit":"ُryِbَhkْlٱ","root":"خبر"}],"hasIhya":true},{"ayah":104,"text":"قَدْ جَآءَكُم بَصَآئِرُ مِن رَّبِّكُمْۖ فَمَنْ أَبْصَرَ فَلِنَفْسِهِۦۖ وَمَنْ عَمِىَ فَعَلَيْهَاۚ وَمَآ أَنَا۠ عَلَيْكُم بِحَفِيظٍ ","translation":"There has come to you enlightenment from your Lord. So whoever will see does so for [the benefit of] his soul, and whoever is blind [does harm] against it. And [say], \"I am not a guardian over you.\"[1]","words":[{"id":1,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":2,"arabic":"جَآءَكُم","translit":"mُkَءٓāَjg","root":"جيا"},{"id":3,"arabic":"بَصَآئِرُ","translit":"ُrِyʾٓāَṣَb","root":"بصر"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":6,"arabic":"فَمَنْ","translit":"ْnَmَf","root":""},{"id":7,"arabic":"أَبْصَرَ","translit":"َrَṣْbَaʾ","root":"بصر"},{"id":8,"arabic":"فَلِنَفْسِهِۦ","translit":"ۦِhِsْfَnِlَf","root":"نفس"},{"id":9,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":10,"arabic":"عَمِىَ","translit":"َàِmَʿع","root":"عمي"},{"id":11,"arabic":"فَعَلَيْهَا","translit":"āَhْyَlَʿعَf","root":""},{"id":12,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":13,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":14,"arabic":"عَلَيْكُم","translit":"mُkْyَlَʿع","root":""},{"id":15,"arabic":"بِحَفِيظٍ","translit":"ٍẓyِfَḥِb","root":"حفظ"}],"hasIhya":false},{"ayah":105,"text":"وَكَذَٰلِكَ نُصَرِّفُ ٱلْءَايَٰتِ وَلِيَقُولُوا۟ دَرَسْتَ وَلِنُبَيِّنَهُۥ لِقَوْمٍ يَعْلَمُونَ ","translation":"And thus do We diversify the verses so they [i.e., the disbelievers] will say, \"You have studied,\"[1] and so We may make it [i.e., the Qur’ān] clear for a people who know.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"نُصَرِّفُ","translit":"ُfِّrَṣُn","root":"صرف"},{"id":3,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":4,"arabic":"وَلِيَقُولُوا۟","translit":"۟āwُlwُqَyِlَw","root":"قول"},{"id":5,"arabic":"دَرَسْتَ","translit":"َtْsَrَd","root":"درس"},{"id":6,"arabic":"وَلِنُبَيِّنَهُۥ","translit":"ۥُhَnِّyَbُnِlَw","root":"بين"},{"id":7,"arabic":"لِقَوْمٍ","translit":"ٍmْwَqِl","root":"قوم"},{"id":8,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":106,"text":"ٱتَّبِعْ مَآ أُوحِىَ إِلَيْكَ مِن رَّبِّكَۖ لَآ إِلَٰهَ إِلَّا هُوَۖ وَأَعْرِضْ عَنِ ٱلْمُشْرِكِينَ ","translation":"Follow, [O Muḥammad], what has been revealed to you from your Lord - there is no deity except Him - and turn away from those who associate others with Allāh.","words":[{"id":1,"arabic":"ٱتَّبِعْ","translit":"ْʿعِbَّtٱ","root":"تبع"},{"id":2,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":3,"arabic":"أُوحِىَ","translit":"َàِḥwُaʾ","root":"وحي"},{"id":4,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":7,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":8,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":11,"arabic":"وَأَعْرِضْ","translit":"ْḍِrْʿعَaʾَw","root":"عرض"},{"id":12,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":13,"arabic":"ٱلْمُشْرِكِينَ","translit":"َnyِkِrْhsُmْlٱ","root":"شرك"}],"hasIhya":false},{"ayah":107,"text":"وَلَوْ شَآءَ ٱللَّهُ مَآ أَشْرَكُوا۟ۗ وَمَا جَعَلْنَٰكَ عَلَيْهِمْ حَفِيظًاۖ وَمَآ أَنتَ عَلَيْهِم بِوَكِيلٍ ","translation":"But if Allāh had willed, they would not have associated. And We have not appointed you over them as a guardian, nor are you a manager over them.[1]","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":5,"arabic":"أَشْرَكُوا۟","translit":"۟āwُkَrْhsَaʾ","root":"شرك"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"جَعَلْنَٰكَ","translit":"َkَٰnْlَʿعَjg","root":"جعل"},{"id":8,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":9,"arabic":"حَفِيظًا","translit":"āًẓyِfَḥ","root":"حفظ"},{"id":10,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":11,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":12,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":13,"arabic":"بِوَكِيلٍ","translit":"ٍlyِkَwِb","root":"وكل"}],"hasIhya":true},{"ayah":108,"text":"وَلَا تَسُبُّوا۟ ٱلَّذِينَ يَدْعُونَ مِن دُونِ ٱللَّهِ فَيَسُبُّوا۟ ٱللَّهَ عَدْوًۢا بِغَيْرِ عِلْمٍۗ كَذَٰلِكَ زَيَّنَّا لِكُلِّ أُمَّةٍ عَمَلَهُمْ ثُمَّ إِلَىٰ رَبِّهِم مَّرْجِعُهُمْ فَيُنَبِّئُهُم بِمَا كَانُوا۟ يَعْمَلُونَ ","translation":"And do not insult those they invoke other than Allāh, lest they insult Allāh in enmity without knowledge. Thus We have made pleasing to every community their deeds. Then to their Lord is their return, and He will inform them about what they used to do.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَسُبُّوا۟","translit":"۟āwُّbُsَt","root":"سبب"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"يَدْعُونَ","translit":"َnwُʿعْdَy","root":"دعو"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"فَيَسُبُّوا۟","translit":"۟āwُّbُsَyَf","root":"سبب"},{"id":9,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":10,"arabic":"عَدْوًۢا","translit":"āًۢwْdَʿع","root":"عدو"},{"id":11,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":12,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":13,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":14,"arabic":"زَيَّنَّا","translit":"āَّnَّyَz","root":"زين"},{"id":15,"arabic":"لِكُلِّ","translit":"ِّlُkِl","root":"كلل"},{"id":16,"arabic":"أُمَّةٍ","translit":"ٍẗَّmُaʾ","root":"امم"},{"id":17,"arabic":"عَمَلَهُمْ","translit":"ْmُhَlَmَʿع","root":"عمل"},{"id":18,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":19,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":20,"arabic":"رَبِّهِم","translit":"mِhِّbَr","root":"ربب"},{"id":21,"arabic":"مَّرْجِعُهُمْ","translit":"ْmُhُʿعِjgْrَّm","root":"رجع"},{"id":22,"arabic":"فَيُنَبِّئُهُم","translit":"mُhُyʾِّbَnُyَf","root":"نبا"},{"id":23,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":24,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":25,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":true},{"ayah":109,"text":"وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ أَيْمَٰنِهِمْ لَئِن جَآءَتْهُمْ ءَايَةٌ لَّيُؤْمِنُنَّ بِهَاۚ قُلْ إِنَّمَا ٱلْءَايَٰتُ عِندَ ٱللَّهِۖ وَمَا يُشْعِرُكُمْ أَنَّهَآ إِذَا جَآءَتْ لَا يُؤْمِنُونَ ","translation":"And they swear by Allāh their strongest oaths that if a sign came to them, they would surely believe in it. Say, \"The signs are only with [i.e., from] Allāh.\" And what will make you perceive that even if it [i.e., a sign] came, they would not believe.","words":[{"id":1,"arabic":"وَأَقْسَمُوا۟","translit":"۟āwُmَsْqَaʾَw","root":"قسم"},{"id":2,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":3,"arabic":"جَهْدَ","translit":"َdْhَjg","root":"جهد"},{"id":4,"arabic":"أَيْمَٰنِهِمْ","translit":"ْmِhِnَٰmْyَaʾ","root":"يمن"},{"id":5,"arabic":"لَئِن","translit":"nِyʾَl","root":""},{"id":6,"arabic":"جَآءَتْهُمْ","translit":"ْmُhْtَءٓāَjg","root":"جيا"},{"id":7,"arabic":"ءَايَةٌ","translit":"ٌẗَyāَء","root":"ايي"},{"id":8,"arabic":"لَّيُؤْمِنُنَّ","translit":"َّnُnِmْwʾُyَّl","root":"امن"},{"id":9,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":10,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":11,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":12,"arabic":"ٱلْءَايَٰتُ","translit":"ُtَٰyāَءْlٱ","root":"ايي"},{"id":13,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":14,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":15,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":16,"arabic":"يُشْعِرُكُمْ","translit":"ْmُkُrِʿعْhsُy","root":"شعر"},{"id":17,"arabic":"أَنَّهَآ","translit":"ٓāَhَّnَaʾ","root":""},{"id":18,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":19,"arabic":"جَآءَتْ","translit":"ْtَءٓāَjg","root":"جيا"},{"id":20,"arabic":"لَا","translit":"āَl","root":""},{"id":21,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":false},{"ayah":110,"text":"وَنُقَلِّبُ أَفْـِٔدَتَهُمْ وَأَبْصَٰرَهُمْ كَمَا لَمْ يُؤْمِنُوا۟ بِهِۦٓ أَوَّلَ مَرَّةٍ وَنَذَرُهُمْ فِى طُغْيَٰنِهِمْ يَعْمَهُونَ ","translation":"And We will turn away their hearts and their eyes just as they refused to believe in it [i.e., the revelation] the first time. And We will leave them in their transgression, wandering blindly.","words":[{"id":1,"arabic":"وَنُقَلِّبُ","translit":"ُbِّlَqُnَw","root":"قلب"},{"id":2,"arabic":"أَفْـِٔدَتَهُمْ","translit":"ْmُhَtَdِٔـْfَaʾ","root":"فاد"},{"id":3,"arabic":"وَأَبْصَٰرَهُمْ","translit":"ْmُhَrَٰṣْbَaʾَw","root":"بصر"},{"id":4,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":5,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":6,"arabic":"يُؤْمِنُوا۟","translit":"۟āwُnِmْwʾُy","root":"امن"},{"id":7,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":8,"arabic":"أَوَّلَ","translit":"َlَّwَaʾ","root":"اول"},{"id":9,"arabic":"مَرَّةٍ","translit":"ٍẗَّrَm","root":"مرر"},{"id":10,"arabic":"وَنَذَرُهُمْ","translit":"ْmُhُrَhdَnَw","root":"وذر"},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"طُغْيَٰنِهِمْ","translit":"ْmِhِnَٰyْغُṭ","root":"طغي"},{"id":13,"arabic":"يَعْمَهُونَ","translit":"َnwُhَmْʿعَy","root":"عمه"}],"hasIhya":false},{"ayah":111,"text":"وَلَوْ أَنَّنَا نَزَّلْنَآ إِلَيْهِمُ ٱلْمَلَٰٓئِكَةَ وَكَلَّمَهُمُ ٱلْمَوْتَىٰ وَحَشَرْنَا عَلَيْهِمْ كُلَّ شَىْءٍ قُبُلًا مَّا كَانُوا۟ لِيُؤْمِنُوٓا۟ إِلَّآ أَن يَشَآءَ ٱللَّهُ وَلَٰكِنَّ أَكْثَرَهُمْ يَجْهَلُونَ ","translation":"And even if We had sent down to them the angels [with the message] and the dead spoke to them [of it] and We gathered together every [created] thing in front of them, they would not believe unless Allāh should will. But most of them, [of that], are ignorant.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"أَنَّنَا","translit":"āَnَّnَaʾ","root":""},{"id":3,"arabic":"نَزَّلْنَآ","translit":"ٓāَnْlَّzَn","root":"نزل"},{"id":4,"arabic":"إِلَيْهِمُ","translit":"ُmِhْyَlِiʾ","root":""},{"id":5,"arabic":"ٱلْمَلَٰٓئِكَةَ","translit":"َẗَkِyʾَٰٓlَmْlٱ","root":"ملك"},{"id":6,"arabic":"وَكَلَّمَهُمُ","translit":"ُmُhَmَّlَkَw","root":"كلم"},{"id":7,"arabic":"ٱلْمَوْتَىٰ","translit":"ٰàَtْwَmْlٱ","root":"موت"},{"id":8,"arabic":"وَحَشَرْنَا","translit":"āَnْrَhsَḥَw","root":"حشر"},{"id":9,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":10,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":11,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":12,"arabic":"قُبُلًا","translit":"āًlُbُq","root":"قبل"},{"id":13,"arabic":"مَّا","translit":"āَّm","root":""},{"id":14,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":15,"arabic":"لِيُؤْمِنُوٓا۟","translit":"۟āٓwُnِmْwʾُyِl","root":"امن"},{"id":16,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":17,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":18,"arabic":"يَشَآءَ","translit":"َءٓāَhsَy","root":"شيا"},{"id":19,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":20,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":21,"arabic":"أَكْثَرَهُمْ","translit":"ْmُhَrَhtْkَaʾ","root":"كثر"},{"id":22,"arabic":"يَجْهَلُونَ","translit":"َnwُlَhْjgَy","root":"جهل"}],"hasIhya":false},{"ayah":112,"text":"وَكَذَٰلِكَ جَعَلْنَا لِكُلِّ نَبِىٍّ عَدُوًّا شَيَٰطِينَ ٱلْإِنسِ وَٱلْجِنِّ يُوحِى بَعْضُهُمْ إِلَىٰ بَعْضٍ زُخْرُفَ ٱلْقَوْلِ غُرُورًاۚ وَلَوْ شَآءَ رَبُّكَ مَا فَعَلُوهُۖ فَذَرْهُمْ وَمَا يَفْتَرُونَ ","translation":"And thus We have made for every prophet an enemy - devils from mankind and jinn, inspiring to one another decorative speech in delusion. But if your Lord had willed, they would not have done it, so leave them and that which they invent.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":3,"arabic":"لِكُلِّ","translit":"ِّlُkِl","root":"كلل"},{"id":4,"arabic":"نَبِىٍّ","translit":"ٍّàِbَn","root":"نبا"},{"id":5,"arabic":"عَدُوًّا","translit":"āًّwُdَʿع","root":"عدو"},{"id":6,"arabic":"شَيَٰطِينَ","translit":"َnyِṭَٰyَhs","root":"شطن"},{"id":7,"arabic":"ٱلْإِنسِ","translit":"ِsnِiʾْlٱ","root":"انس"},{"id":8,"arabic":"وَٱلْجِنِّ","translit":"ِّnِjgْlٱَw","root":"جنن"},{"id":9,"arabic":"يُوحِى","translit":"àِḥwُy","root":"وحي"},{"id":10,"arabic":"بَعْضُهُمْ","translit":"ْmُhُḍْʿعَb","root":"بعض"},{"id":11,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":12,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":13,"arabic":"زُخْرُفَ","translit":"َfُrْhkُz","root":"زخرف"},{"id":14,"arabic":"ٱلْقَوْلِ","translit":"ِlْwَqْlٱ","root":"قول"},{"id":15,"arabic":"غُرُورًا","translit":"āًrwُrُغ","root":"غرر"},{"id":16,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":17,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":18,"arabic":"رَبُّكَ","translit":"َkُّbَr","root":"ربب"},{"id":19,"arabic":"مَا","translit":"āَm","root":""},{"id":20,"arabic":"فَعَلُوهُ","translit":"ُhwُlَʿعَf","root":"فعل"},{"id":21,"arabic":"فَذَرْهُمْ","translit":"ْmُhْrَhdَf","root":"وذر"},{"id":22,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":23,"arabic":"يَفْتَرُونَ","translit":"َnwُrَtْfَy","root":"فري"}],"hasIhya":false},{"ayah":113,"text":"وَلِتَصْغَىٰٓ إِلَيْهِ أَفْـِٔدَةُ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ وَلِيَرْضَوْهُ وَلِيَقْتَرِفُوا۟ مَا هُم مُّقْتَرِفُونَ ","translation":"And [it is] so the hearts of those who disbelieve in the Hereafter will incline toward it [i.e., deceptive speech] and that they will be satisfied with it and that they will commit that which they are committing.","words":[{"id":1,"arabic":"وَلِتَصْغَىٰٓ","translit":"ٰٓàَغْṣَtِlَw","root":"صغو"},{"id":2,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":3,"arabic":"أَفْـِٔدَةُ","translit":"ُẗَdِٔـْfَaʾ","root":"فاد"},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":7,"arabic":"بِٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱِb","root":"اخر"},{"id":8,"arabic":"وَلِيَرْضَوْهُ","translit":"ُhْwَḍْrَyِlَw","root":"رضو"},{"id":9,"arabic":"وَلِيَقْتَرِفُوا۟","translit":"۟āwُfِrَtْqَyِlَw","root":"قرف"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"هُم","translit":"mُh","root":""},{"id":12,"arabic":"مُّقْتَرِفُونَ","translit":"َnwُfِrَtْqُّm","root":"قرف"}],"hasIhya":false},{"ayah":114,"text":"أَفَغَيْرَ ٱللَّهِ أَبْتَغِى حَكَمًا وَهُوَ ٱلَّذِىٓ أَنزَلَ إِلَيْكُمُ ٱلْكِتَٰبَ مُفَصَّلًاۚ وَٱلَّذِينَ ءَاتَيْنَٰهُمُ ٱلْكِتَٰبَ يَعْلَمُونَ أَنَّهُۥ مُنَزَّلٌ مِّن رَّبِّكَ بِٱلْحَقِّۖ فَلَا تَكُونَنَّ مِنَ ٱلْمُمْتَرِينَ ","translation":"[Say], \"Then is it other than Allāh I should seek as judge while it is He who has revealed to you the Book [i.e., the Qur’ān] explained in detail?\" And those to whom We [previously] gave the Scripture know that it is sent down from your Lord in truth, so never be among the doubters.","words":[{"id":1,"arabic":"أَفَغَيْرَ","translit":"َrْyَغَfَaʾ","root":"غير"},{"id":2,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":3,"arabic":"أَبْتَغِى","translit":"àِغَtْbَaʾ","root":"بغي"},{"id":4,"arabic":"حَكَمًا","translit":"āًmَkَḥ","root":"حكم"},{"id":5,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":6,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":7,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":8,"arabic":"إِلَيْكُمُ","translit":"ُmُkْyَlِiʾ","root":""},{"id":9,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":10,"arabic":"مُفَصَّلًا","translit":"āًlَّṣَfُm","root":"فصل"},{"id":11,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":12,"arabic":"ءَاتَيْنَٰهُمُ","translit":"ُmُhَٰnْyَtāَء","root":"اتي"},{"id":13,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":14,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"},{"id":15,"arabic":"أَنَّهُۥ","translit":"ۥُhَّnَaʾ","root":""},{"id":16,"arabic":"مُنَزَّلٌ","translit":"ٌlَّzَnُm","root":"نزل"},{"id":17,"arabic":"مِّن","translit":"nِّm","root":""},{"id":18,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":19,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":20,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":21,"arabic":"تَكُونَنَّ","translit":"َّnَnwُkَt","root":"كون"},{"id":22,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":23,"arabic":"ٱلْمُمْتَرِينَ","translit":"َnyِrَtْmُmْlٱ","root":"مري"}],"hasIhya":false},{"ayah":115,"text":"وَتَمَّتْ كَلِمَتُ رَبِّكَ صِدْقًا وَعَدْلًاۚ لَّا مُبَدِّلَ لِكَلِمَٰتِهِۦۚ وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ","translation":"And the word of your Lord has been fulfilled in truth and in justice. None can alter His words, and He is the Hearing, the Knowing.","words":[{"id":1,"arabic":"وَتَمَّتْ","translit":"ْtَّmَtَw","root":"تمم"},{"id":2,"arabic":"كَلِمَتُ","translit":"ُtَmِlَk","root":"كلم"},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"صِدْقًا","translit":"āًqْdِṣ","root":"صدق"},{"id":5,"arabic":"وَعَدْلًا","translit":"āًlْdَʿعَw","root":"عدل"},{"id":6,"arabic":"لَّا","translit":"āَّl","root":""},{"id":7,"arabic":"مُبَدِّلَ","translit":"َlِّdَbُm","root":"بدل"},{"id":8,"arabic":"لِكَلِمَٰتِهِۦ","translit":"ۦِhِtَٰmِlَkِl","root":"كلم"},{"id":9,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":10,"arabic":"ٱلسَّمِيعُ","translit":"ُʿعyِmَّslٱ","root":"سمع"},{"id":11,"arabic":"ٱلْعَلِيمُ","translit":"ُmyِlَʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":116,"text":"وَإِن تُطِعْ أَكْثَرَ مَن فِى ٱلْأَرْضِ يُضِلُّوكَ عَن سَبِيلِ ٱللَّهِۚ إِن يَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنْ هُمْ إِلَّا يَخْرُصُونَ ","translation":"And if you obey most of those upon the earth, they will mislead you from the way of Allāh. They follow not except assumption, and they are not but misjudging.[1]","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"تُطِعْ","translit":"ْʿعِṭُt","root":"طوع"},{"id":3,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":4,"arabic":"مَن","translit":"nَm","root":""},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":7,"arabic":"يُضِلُّوكَ","translit":"َkwُّlِḍُy","root":"ضلل"},{"id":8,"arabic":"عَن","translit":"nَʿع","root":""},{"id":9,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":12,"arabic":"يَتَّبِعُونَ","translit":"َnwُʿعِbَّtَy","root":"تبع"},{"id":13,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":14,"arabic":"ٱلظَّنَّ","translit":"َّnَّẓlٱ","root":"ظنن"},{"id":15,"arabic":"وَإِنْ","translit":"ْnِiʾَw","root":""},{"id":16,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":17,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":18,"arabic":"يَخْرُصُونَ","translit":"َnwُṣُrْhkَy","root":"خرص"}],"hasIhya":true},{"ayah":117,"text":"إِنَّ رَبَّكَ هُوَ أَعْلَمُ مَن يَضِلُّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ ","translation":"Indeed, your Lord is most knowing of who strays from His way, and He is most knowing of the [rightly] guided.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":3,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":4,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":5,"arabic":"مَن","translit":"nَm","root":""},{"id":6,"arabic":"يَضِلُّ","translit":"ُّlِḍَy","root":"ضلل"},{"id":7,"arabic":"عَن","translit":"nَʿع","root":""},{"id":8,"arabic":"سَبِيلِهِۦ","translit":"ۦِhِlyِbَs","root":"سبل"},{"id":9,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":10,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":11,"arabic":"بِٱلْمُهْتَدِينَ","translit":"َnyِdَtْhُmْlٱِb","root":"هدي"}],"hasIhya":false},{"ayah":118,"text":"فَكُلُوا۟ مِمَّا ذُكِرَ ٱسْمُ ٱللَّهِ عَلَيْهِ إِن كُنتُم بِـَٔايَٰتِهِۦ مُؤْمِنِينَ ","translation":"So eat of that [meat] upon which the name of Allāh has been mentioned,[1] if you are believers in His verses [i.e., revealed law].","words":[{"id":1,"arabic":"فَكُلُوا۟","translit":"۟āwُlُkَf","root":"اكل"},{"id":2,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":3,"arabic":"ذُكِرَ","translit":"َrِkُhd","root":"ذكر"},{"id":4,"arabic":"ٱسْمُ","translit":"ُmْsٱ","root":"سمو"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":7,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":8,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":9,"arabic":"بِـَٔايَٰتِهِۦ","translit":"ۦِhِtَٰyāَٔـِb","root":"ايي"},{"id":10,"arabic":"مُؤْمِنِينَ","translit":"َnyِnِmْwʾُm","root":"امن"}],"hasIhya":true},{"ayah":119,"text":"وَمَا لَكُمْ أَلَّا تَأْكُلُوا۟ مِمَّا ذُكِرَ ٱسْمُ ٱللَّهِ عَلَيْهِ وَقَدْ فَصَّلَ لَكُم مَّا حَرَّمَ عَلَيْكُمْ إِلَّا مَا ٱضْطُرِرْتُمْ إِلَيْهِۗ وَإِنَّ كَثِيرًا لَّيُضِلُّونَ بِأَهْوَآئِهِم بِغَيْرِ عِلْمٍۗ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِٱلْمُعْتَدِينَ ","translation":"And why should you not eat of that upon which the name of Allāh has been mentioned while He has explained in detail to you what He has forbidden you, excepting that to which you are compelled.[1] And indeed do many lead [others] astray through their [own] inclinations without knowledge. Indeed, your Lord - He is most knowing of the transgressors.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":3,"arabic":"أَلَّا","translit":"āَّlَaʾ","root":""},{"id":4,"arabic":"تَأْكُلُوا۟","translit":"۟āwُlُkْaʾَt","root":"اكل"},{"id":5,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":6,"arabic":"ذُكِرَ","translit":"َrِkُhd","root":"ذكر"},{"id":7,"arabic":"ٱسْمُ","translit":"ُmْsٱ","root":"سمو"},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":10,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":11,"arabic":"فَصَّلَ","translit":"َlَّṣَf","root":"فصل"},{"id":12,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":13,"arabic":"مَّا","translit":"āَّm","root":""},{"id":14,"arabic":"حَرَّمَ","translit":"َmَّrَḥ","root":"حرم"},{"id":15,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":16,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":17,"arabic":"مَا","translit":"āَm","root":""},{"id":18,"arabic":"ٱضْطُرِرْتُمْ","translit":"ْmُtْrِrُṭْḍٱ","root":"ضرر"},{"id":19,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":20,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":21,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":22,"arabic":"لَّيُضِلُّونَ","translit":"َnwُّlِḍُyَّl","root":"ضلل"},{"id":23,"arabic":"بِأَهْوَآئِهِم","translit":"mِhِyʾٓāَwْhَaʾِb","root":"هوي"},{"id":24,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":25,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":26,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":27,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":28,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":29,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":30,"arabic":"بِٱلْمُعْتَدِينَ","translit":"َnyِdَtْʿعُmْlٱِb","root":"عدو"}],"hasIhya":true},{"ayah":120,"text":"وَذَرُوا۟ ظَٰهِرَ ٱلْإِثْمِ وَبَاطِنَهُۥٓۚ إِنَّ ٱلَّذِينَ يَكْسِبُونَ ٱلْإِثْمَ سَيُجْزَوْنَ بِمَا كَانُوا۟ يَقْتَرِفُونَ ","translation":"And leave [i.e., desist from] what is apparent of sin and what is concealed thereof. Indeed, those who earn [blame for] sin will be recompensed for that which they used to commit.","words":[{"id":1,"arabic":"وَذَرُوا۟","translit":"۟āwُrَhdَw","root":"وذر"},{"id":2,"arabic":"ظَٰهِرَ","translit":"َrِhَٰẓ","root":"ظهر"},{"id":3,"arabic":"ٱلْإِثْمِ","translit":"ِmْhtِiʾْlٱ","root":"اثم"},{"id":4,"arabic":"وَبَاطِنَهُۥٓ","translit":"ٓۥُhَnِṭāَbَw","root":"بطن"},{"id":5,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":6,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":7,"arabic":"يَكْسِبُونَ","translit":"َnwُbِsْkَy","root":"كسب"},{"id":8,"arabic":"ٱلْإِثْمَ","translit":"َmْhtِiʾْlٱ","root":"اثم"},{"id":9,"arabic":"سَيُجْزَوْنَ","translit":"َnْwَzْjgُyَs","root":"جزي"},{"id":10,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":11,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":12,"arabic":"يَقْتَرِفُونَ","translit":"َnwُfِrَtْqَy","root":"قرف"}],"hasIhya":true},{"ayah":121,"text":"وَلَا تَأْكُلُوا۟ مِمَّا لَمْ يُذْكَرِ ٱسْمُ ٱللَّهِ عَلَيْهِ وَإِنَّهُۥ لَفِسْقٌۗ وَإِنَّ ٱلشَّيَٰطِينَ لَيُوحُونَ إِلَىٰٓ أَوْلِيَآئِهِمْ لِيُجَٰدِلُوكُمْۖ وَإِنْ أَطَعْتُمُوهُمْ إِنَّكُمْ لَمُشْرِكُونَ ","translation":"And do not eat of that upon which the name of Allāh has not been mentioned, for indeed, it is grave disobedience. And indeed do the devils inspire their allies [among men] to dispute with you. And if you were to obey them, indeed, you would be associators [of others with Him].[1]","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَأْكُلُوا۟","translit":"۟āwُlُkْaʾَt","root":"اكل"},{"id":3,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":4,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":5,"arabic":"يُذْكَرِ","translit":"ِrَkْhdُy","root":"ذكر"},{"id":6,"arabic":"ٱسْمُ","translit":"ُmْsٱ","root":"سمو"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":9,"arabic":"وَإِنَّهُۥ","translit":"ۥُhَّnِiʾَw","root":""},{"id":10,"arabic":"لَفِسْقٌ","translit":"ٌqْsِfَl","root":"فسق"},{"id":11,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":12,"arabic":"ٱلشَّيَٰطِينَ","translit":"َnyِṭَٰyَّhslٱ","root":"شطن"},{"id":13,"arabic":"لَيُوحُونَ","translit":"َnwُḥwُyَl","root":"وحي"},{"id":14,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":15,"arabic":"أَوْلِيَآئِهِمْ","translit":"ْmِhِyʾٓāَyِlْwَaʾ","root":"ولي"},{"id":16,"arabic":"لِيُجَٰدِلُوكُمْ","translit":"ْmُkwُlِdَٰjgُyِl","root":"جدل"},{"id":17,"arabic":"وَإِنْ","translit":"ْnِiʾَw","root":""},{"id":18,"arabic":"أَطَعْتُمُوهُمْ","translit":"ْmُhwُmُtْʿعَṭَaʾ","root":"طوع"},{"id":19,"arabic":"إِنَّكُمْ","translit":"ْmُkَّnِiʾ","root":""},{"id":20,"arabic":"لَمُشْرِكُونَ","translit":"َnwُkِrْhsُmَl","root":"شرك"}],"hasIhya":true},{"ayah":122,"text":"أَوَمَن كَانَ مَيْتًا فَأَحْيَيْنَٰهُ وَجَعَلْنَا لَهُۥ نُورًا يَمْشِى بِهِۦ فِى ٱلنَّاسِ كَمَن مَّثَلُهُۥ فِى ٱلظُّلُمَٰتِ لَيْسَ بِخَارِجٍ مِّنْهَاۚ كَذَٰلِكَ زُيِّنَ لِلْكَٰفِرِينَ مَا كَانُوا۟ يَعْمَلُونَ ","translation":"And is one who was dead and We gave him life and made for him light by which to walk among the people like one who is in darkness, never to emerge therefrom? Thus it has been made pleasing to the disbelievers that which they were doing.","words":[{"id":1,"arabic":"أَوَمَن","translit":"nَmَwَaʾ","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"مَيْتًا","translit":"āًtْyَm","root":"موت"},{"id":4,"arabic":"فَأَحْيَيْنَٰهُ","translit":"ُhَٰnْyَyْḥَaʾَf","root":"حيي"},{"id":5,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":6,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":7,"arabic":"نُورًا","translit":"āًrwُn","root":"نور"},{"id":8,"arabic":"يَمْشِى","translit":"àِhsْmَy","root":"مشي"},{"id":9,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":12,"arabic":"كَمَن","translit":"nَmَk","root":""},{"id":13,"arabic":"مَّثَلُهُۥ","translit":"ۥُhُlَhtَّm","root":"مثل"},{"id":14,"arabic":"فِى","translit":"àِf","root":""},{"id":15,"arabic":"ٱلظُّلُمَٰتِ","translit":"ِtَٰmُlُّẓlٱ","root":"ظلم"},{"id":16,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":17,"arabic":"بِخَارِجٍ","translit":"ٍjgِrāَhkِb","root":"خرج"},{"id":18,"arabic":"مِّنْهَا","translit":"āَhْnِّm","root":""},{"id":19,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":20,"arabic":"زُيِّنَ","translit":"َnِّyُz","root":"زين"},{"id":21,"arabic":"لِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِl","root":"كفر"},{"id":22,"arabic":"مَا","translit":"āَm","root":""},{"id":23,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":24,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":true},{"ayah":123,"text":"وَكَذَٰلِكَ جَعَلْنَا فِى كُلِّ قَرْيَةٍ أَكَٰبِرَ مُجْرِمِيهَا لِيَمْكُرُوا۟ فِيهَاۖ وَمَا يَمْكُرُونَ إِلَّا بِأَنفُسِهِمْ وَمَا يَشْعُرُونَ ","translation":"And thus We have placed within every city the greatest of its criminals to conspire therein. But they conspire not except against themselves, and they perceive [it] not.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":5,"arabic":"قَرْيَةٍ","translit":"ٍẗَyْrَq","root":"قري"},{"id":6,"arabic":"أَكَٰبِرَ","translit":"َrِbَٰkَaʾ","root":"كبر"},{"id":7,"arabic":"مُجْرِمِيهَا","translit":"āَhyِmِrْjgُm","root":"جرم"},{"id":8,"arabic":"لِيَمْكُرُوا۟","translit":"۟āwُrُkْmَyِl","root":"مكر"},{"id":9,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":10,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":11,"arabic":"يَمْكُرُونَ","translit":"َnwُrُkْmَy","root":"مكر"},{"id":12,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":13,"arabic":"بِأَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾِb","root":"نفس"},{"id":14,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":15,"arabic":"يَشْعُرُونَ","translit":"َnwُrُʿعْhsَy","root":"شعر"}],"hasIhya":false},{"ayah":124,"text":"وَإِذَا جَآءَتْهُمْ ءَايَةٌ قَالُوا۟ لَن نُّؤْمِنَ حَتَّىٰ نُؤْتَىٰ مِثْلَ مَآ أُوتِىَ رُسُلُ ٱللَّهِۘ ٱللَّهُ أَعْلَمُ حَيْثُ يَجْعَلُ رِسَالَتَهُۥۗ سَيُصِيبُ ٱلَّذِينَ أَجْرَمُوا۟ صَغَارٌ عِندَ ٱللَّهِ وَعَذَابٌ شَدِيدٌۢ بِمَا كَانُوا۟ يَمْكُرُونَ ","translation":"And when a sign comes to them, they say, \"Never will we believe until we are given like that which was given to the messengers of Allāh.\" Allāh is most knowing of where [i.e., with whom] He places His message. There will afflict those who committed crimes debasement before Allāh and severe punishment for what they used to conspire.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"جَآءَتْهُمْ","translit":"ْmُhْtَءٓāَjg","root":"جيا"},{"id":3,"arabic":"ءَايَةٌ","translit":"ٌẗَyāَء","root":"ايي"},{"id":4,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":5,"arabic":"لَن","translit":"nَl","root":""},{"id":6,"arabic":"نُّؤْمِنَ","translit":"َnِmْwʾُّn","root":"امن"},{"id":7,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":8,"arabic":"نُؤْتَىٰ","translit":"ٰàَtْwʾُn","root":"اتي"},{"id":9,"arabic":"مِثْلَ","translit":"َlْhtِm","root":"مثل"},{"id":10,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":11,"arabic":"أُوتِىَ","translit":"َàِtwُaʾ","root":"اتي"},{"id":12,"arabic":"رُسُلُ","translit":"ُlُsُr","root":"رسل"},{"id":13,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":14,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":15,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":16,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":17,"arabic":"يَجْعَلُ","translit":"ُlَʿعْjgَy","root":"جعل"},{"id":18,"arabic":"رِسَالَتَهُۥ","translit":"ۥُhَtَlāَsِr","root":"رسل"},{"id":19,"arabic":"سَيُصِيبُ","translit":"ُbyِṣُyَs","root":"صوب"},{"id":20,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":21,"arabic":"أَجْرَمُوا۟","translit":"۟āwُmَrْjgَaʾ","root":"جرم"},{"id":22,"arabic":"صَغَارٌ","translit":"ٌrāَغَṣ","root":"صغر"},{"id":23,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":24,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":25,"arabic":"وَعَذَابٌ","translit":"ٌbāَhdَʿعَw","root":"عذب"},{"id":26,"arabic":"شَدِيدٌۢ","translit":"ٌۢdyِdَhs","root":"شدد"},{"id":27,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":28,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":29,"arabic":"يَمْكُرُونَ","translit":"َnwُrُkْmَy","root":"مكر"}],"hasIhya":false},{"ayah":125,"text":"فَمَن يُرِدِ ٱللَّهُ أَن يَهْدِيَهُۥ يَشْرَحْ صَدْرَهُۥ لِلْإِسْلَٰمِۖ وَمَن يُرِدْ أَن يُضِلَّهُۥ يَجْعَلْ صَدْرَهُۥ ضَيِّقًا حَرَجًا كَأَنَّمَا يَصَّعَّدُ فِى ٱلسَّمَآءِۚ كَذَٰلِكَ يَجْعَلُ ٱللَّهُ ٱلرِّجْسَ عَلَى ٱلَّذِينَ لَا يُؤْمِنُونَ ","translation":"So whoever Allāh wants to guide - He expands his breast to [contain] Islām; and whoever He wants to send astray[1] - He makes his breast tight and constricted as though he were climbing into the sky. Thus does Allāh place defilement upon those who do not believe.","words":[{"id":1,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":2,"arabic":"يُرِدِ","translit":"ِdِrُy","root":"رود"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَهْدِيَهُۥ","translit":"ۥُhَyِdْhَy","root":"هدي"},{"id":6,"arabic":"يَشْرَحْ","translit":"ْḥَrْhsَy","root":"شرح"},{"id":7,"arabic":"صَدْرَهُۥ","translit":"ۥُhَrْdَṣ","root":"صدر"},{"id":8,"arabic":"لِلْإِسْلَٰمِ","translit":"ِmَٰlْsِiʾْlِl","root":"سلم"},{"id":9,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":10,"arabic":"يُرِدْ","translit":"ْdِrُy","root":"رود"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يُضِلَّهُۥ","translit":"ۥُhَّlِḍُy","root":"ضلل"},{"id":13,"arabic":"يَجْعَلْ","translit":"ْlَʿعْjgَy","root":"جعل"},{"id":14,"arabic":"صَدْرَهُۥ","translit":"ۥُhَrْdَṣ","root":"صدر"},{"id":15,"arabic":"ضَيِّقًا","translit":"āًqِّyَḍ","root":"ضيق"},{"id":16,"arabic":"حَرَجًا","translit":"āًjgَrَḥ","root":"حرج"},{"id":17,"arabic":"كَأَنَّمَا","translit":"āَmَّnَaʾَk","root":""},{"id":18,"arabic":"يَصَّعَّدُ","translit":"ُdَّʿعَّṣَy","root":"صعد"},{"id":19,"arabic":"فِى","translit":"àِf","root":""},{"id":20,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":21,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":22,"arabic":"يَجْعَلُ","translit":"ُlَʿعْjgَy","root":"جعل"},{"id":23,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":24,"arabic":"ٱلرِّجْسَ","translit":"َsْjgِّrlٱ","root":"رجس"},{"id":25,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":26,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":27,"arabic":"لَا","translit":"āَl","root":""},{"id":28,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":true},{"ayah":126,"text":"وَهَٰذَا صِرَٰطُ رَبِّكَ مُسْتَقِيمًاۗ قَدْ فَصَّلْنَا ٱلْءَايَٰتِ لِقَوْمٍ يَذَّكَّرُونَ ","translation":"And this is the path of your Lord, [leading] straight. We have detailed the verses for a people who remember.","words":[{"id":1,"arabic":"وَهَٰذَا","translit":"āَhdَٰhَw","root":""},{"id":2,"arabic":"صِرَٰطُ","translit":"ُṭَٰrِṣ","root":"صرط"},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"مُسْتَقِيمًا","translit":"āًmyِqَtْsُm","root":"قوم"},{"id":5,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":6,"arabic":"فَصَّلْنَا","translit":"āَnْlَّṣَf","root":"فصل"},{"id":7,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":8,"arabic":"لِقَوْمٍ","translit":"ٍmْwَqِl","root":"قوم"},{"id":9,"arabic":"يَذَّكَّرُونَ","translit":"َnwُrَّkَّhdَy","root":"ذكر"}],"hasIhya":false},{"ayah":127,"text":"لَهُمْ دَارُ ٱلسَّلَٰمِ عِندَ رَبِّهِمْۖ وَهُوَ وَلِيُّهُم بِمَا كَانُوا۟ يَعْمَلُونَ ","translation":"For them will be the Home of Peace [i.e., Paradise] with their Lord. And He will be their protecting friend because of what they used to do.","words":[{"id":1,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":2,"arabic":"دَارُ","translit":"ُrāَd","root":"دور"},{"id":3,"arabic":"ٱلسَّلَٰمِ","translit":"ِmَٰlَّslٱ","root":"سلم"},{"id":4,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":5,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":6,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":7,"arabic":"وَلِيُّهُم","translit":"mُhُّyِlَw","root":"ولي"},{"id":8,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":9,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":10,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":128,"text":"وَيَوْمَ يَحْشُرُهُمْ جَمِيعًا يَٰمَعْشَرَ ٱلْجِنِّ قَدِ ٱسْتَكْثَرْتُم مِّنَ ٱلْإِنسِۖ وَقَالَ أَوْلِيَآؤُهُم مِّنَ ٱلْإِنسِ رَبَّنَا ٱسْتَمْتَعَ بَعْضُنَا بِبَعْضٍ وَبَلَغْنَآ أَجَلَنَا ٱلَّذِىٓ أَجَّلْتَ لَنَاۚ قَالَ ٱلنَّارُ مَثْوَىٰكُمْ خَٰلِدِينَ فِيهَآ إِلَّا مَا شَآءَ ٱللَّهُۗ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ ","translation":"And [mention, O Muḥammad], the Day when He will gather them together [and say], \"O company of jinn, you have [misled] many of mankind.\" And their allies among mankind will say, \"Our Lord, some of us made use of others, and we have [now] reached our term which You appointed for us.\" He will say, \"The Fire is your residence, wherein you will abide eternally, except for what Allāh wills. Indeed, your Lord is Wise and Knowing.\"","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"يَحْشُرُهُمْ","translit":"ْmُhُrُhsْḥَy","root":"حشر"},{"id":3,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":4,"arabic":"يَٰمَعْشَرَ","translit":"َrَhsْʿعَmَٰy","root":"عشر"},{"id":5,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":6,"arabic":"قَدِ","translit":"ِdَq","root":""},{"id":7,"arabic":"ٱسْتَكْثَرْتُم","translit":"mُtْrَhtْkَtْsٱ","root":"كثر"},{"id":8,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":9,"arabic":"ٱلْإِنسِ","translit":"ِsnِiʾْlٱ","root":"انس"},{"id":10,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":11,"arabic":"أَوْلِيَآؤُهُم","translit":"mُhُwʾٓāَyِlْwَaʾ","root":"ولي"},{"id":12,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":13,"arabic":"ٱلْإِنسِ","translit":"ِsnِiʾْlٱ","root":"انس"},{"id":14,"arabic":"رَبَّنَا","translit":"āَnَّbَr","root":"ربب"},{"id":15,"arabic":"ٱسْتَمْتَعَ","translit":"َʿعَtْmَtْsٱ","root":"متع"},{"id":16,"arabic":"بَعْضُنَا","translit":"āَnُḍْʿعَb","root":"بعض"},{"id":17,"arabic":"بِبَعْضٍ","translit":"ٍḍْʿعَbِb","root":"بعض"},{"id":18,"arabic":"وَبَلَغْنَآ","translit":"ٓāَnْغَlَbَw","root":"بلغ"},{"id":19,"arabic":"أَجَلَنَا","translit":"āَnَlَjgَaʾ","root":"اجل"},{"id":20,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":21,"arabic":"أَجَّلْتَ","translit":"َtْlَّjgَaʾ","root":"اجل"},{"id":22,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":23,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":24,"arabic":"ٱلنَّارُ","translit":"ُrāَّnlٱ","root":"نور"},{"id":25,"arabic":"مَثْوَىٰكُمْ","translit":"ْmُkٰàَwْhtَm","root":"ثوي"},{"id":26,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":27,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":28,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":29,"arabic":"مَا","translit":"āَm","root":""},{"id":30,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":31,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":32,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":33,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":34,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"},{"id":35,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":129,"text":"وَكَذَٰلِكَ نُوَلِّى بَعْضَ ٱلظَّٰلِمِينَ بَعْضًۢا بِمَا كَانُوا۟ يَكْسِبُونَ ","translation":"And thus will We make some of the wrongdoers allies of others for what they used to earn.[1]","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"نُوَلِّى","translit":"àِّlَwُn","root":"ولي"},{"id":3,"arabic":"بَعْضَ","translit":"َḍْʿعَb","root":"بعض"},{"id":4,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":5,"arabic":"بَعْضًۢا","translit":"āًۢḍْʿعَb","root":"بعض"},{"id":6,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":7,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":8,"arabic":"يَكْسِبُونَ","translit":"َnwُbِsْkَy","root":"كسب"}],"hasIhya":true},{"ayah":130,"text":"يَٰمَعْشَرَ ٱلْجِنِّ وَٱلْإِنسِ أَلَمْ يَأْتِكُمْ رُسُلٌ مِّنكُمْ يَقُصُّونَ عَلَيْكُمْ ءَايَٰتِى وَيُنذِرُونَكُمْ لِقَآءَ يَوْمِكُمْ هَٰذَاۚ قَالُوا۟ شَهِدْنَا عَلَىٰٓ أَنفُسِنَاۖ وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَا وَشَهِدُوا۟ عَلَىٰٓ أَنفُسِهِمْ أَنَّهُمْ كَانُوا۟ كَٰفِرِينَ ","translation":"\"O company of jinn and mankind,[1] did there not come to you messengers from among you, relating to you My verses and warning you of the meeting of this Day of yours?\" They will say, \"We bear witness against ourselves\"; and the worldly life had deluded them, and they will bear witness against themselves that they were disbelievers.","words":[{"id":1,"arabic":"يَٰمَعْشَرَ","translit":"َrَhsْʿعَmَٰy","root":"عشر"},{"id":2,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":3,"arabic":"وَٱلْإِنسِ","translit":"ِsnِiʾْlٱَw","root":"انس"},{"id":4,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":5,"arabic":"يَأْتِكُمْ","translit":"ْmُkِtْaʾَy","root":"اتي"},{"id":6,"arabic":"رُسُلٌ","translit":"ٌlُsُr","root":"رسل"},{"id":7,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":8,"arabic":"يَقُصُّونَ","translit":"َnwُّṣُqَy","root":"قصص"},{"id":9,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":10,"arabic":"ءَايَٰتِى","translit":"àِtَٰyāَء","root":"ايي"},{"id":11,"arabic":"وَيُنذِرُونَكُمْ","translit":"ْmُkَnwُrِhdnُyَw","root":"نذر"},{"id":12,"arabic":"لِقَآءَ","translit":"َءٓāَqِl","root":"لقي"},{"id":13,"arabic":"يَوْمِكُمْ","translit":"ْmُkِmْwَy","root":"يوم"},{"id":14,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":15,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":16,"arabic":"شَهِدْنَا","translit":"āَnْdِhَhs","root":"شهد"},{"id":17,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":18,"arabic":"أَنفُسِنَا","translit":"āَnِsُfnَaʾ","root":"نفس"},{"id":19,"arabic":"وَغَرَّتْهُمُ","translit":"ُmُhْtَّrَغَw","root":"غرر"},{"id":20,"arabic":"ٱلْحَيَوٰةُ","translit":"ُẗٰwَyَḥْlٱ","root":"حيي"},{"id":21,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":22,"arabic":"وَشَهِدُوا۟","translit":"۟āwُdِhَhsَw","root":"شهد"},{"id":23,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":24,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":25,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":26,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":27,"arabic":"كَٰفِرِينَ","translit":"َnyِrِfَٰk","root":"كفر"}],"hasIhya":false},{"ayah":131,"text":"ذَٰلِكَ أَن لَّمْ يَكُن رَّبُّكَ مُهْلِكَ ٱلْقُرَىٰ بِظُلْمٍ وَأَهْلُهَا غَٰفِلُونَ ","translation":"That is because your Lord would not destroy the cities for wrongdoing[1] while their people were unaware.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":4,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":5,"arabic":"رَّبُّكَ","translit":"َkُّbَّr","root":"ربب"},{"id":6,"arabic":"مُهْلِكَ","translit":"َkِlْhُm","root":"هلك"},{"id":7,"arabic":"ٱلْقُرَىٰ","translit":"ٰàَrُqْlٱ","root":"قري"},{"id":8,"arabic":"بِظُلْمٍ","translit":"ٍmْlُẓِb","root":"ظلم"},{"id":9,"arabic":"وَأَهْلُهَا","translit":"āَhُlْhَaʾَw","root":"اهل"},{"id":10,"arabic":"غَٰفِلُونَ","translit":"َnwُlِfَٰغ","root":"غفل"}],"hasIhya":false},{"ayah":132,"text":"وَلِكُلٍّ دَرَجَٰتٌ مِّمَّا عَمِلُوا۟ۚ وَمَا رَبُّكَ بِغَٰفِلٍ عَمَّا يَعْمَلُونَ ","translation":"And for all are degrees [i.e., positions resulting] from what they have done. And your Lord is not unaware of what they do.","words":[{"id":1,"arabic":"وَلِكُلٍّ","translit":"ٍّlُkِlَw","root":"كلل"},{"id":2,"arabic":"دَرَجَٰتٌ","translit":"ٌtَٰjgَrَd","root":"درج"},{"id":3,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":4,"arabic":"عَمِلُوا۟","translit":"۟āwُlِmَʿع","root":"عمل"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"رَبُّكَ","translit":"َkُّbَr","root":"ربب"},{"id":7,"arabic":"بِغَٰفِلٍ","translit":"ٍlِfَٰغِb","root":"غفل"},{"id":8,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":9,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":true},{"ayah":133,"text":"وَرَبُّكَ ٱلْغَنِىُّ ذُو ٱلرَّحْمَةِۚ إِن يَشَأْ يُذْهِبْكُمْ وَيَسْتَخْلِفْ مِنۢ بَعْدِكُم مَّا يَشَآءُ كَمَآ أَنشَأَكُم مِّن ذُرِّيَّةِ قَوْمٍ ءَاخَرِينَ ","translation":"And your Lord is the Free of need, the possessor of mercy. If He wills, He can do away with you and give succession after you to whomever He wills, just as He produced you from the descendants of another people.","words":[{"id":1,"arabic":"وَرَبُّكَ","translit":"َkُّbَrَw","root":"ربب"},{"id":2,"arabic":"ٱلْغَنِىُّ","translit":"ُّàِnَغْlٱ","root":"غني"},{"id":3,"arabic":"ذُو","translit":"wُhd","root":""},{"id":4,"arabic":"ٱلرَّحْمَةِ","translit":"ِẗَmْḥَّrlٱ","root":"رحم"},{"id":5,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":6,"arabic":"يَشَأْ","translit":"ْaʾَhsَy","root":"شيا"},{"id":7,"arabic":"يُذْهِبْكُمْ","translit":"ْmُkْbِhْhdُy","root":"ذهب"},{"id":8,"arabic":"وَيَسْتَخْلِفْ","translit":"ْfِlْhkَtْsَyَw","root":"خلف"},{"id":9,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":10,"arabic":"بَعْدِكُم","translit":"mُkِdْʿعَb","root":"بعد"},{"id":11,"arabic":"مَّا","translit":"āَّm","root":""},{"id":12,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":13,"arabic":"كَمَآ","translit":"ٓāَmَk","root":""},{"id":14,"arabic":"أَنشَأَكُم","translit":"mُkَaʾَhsnَaʾ","root":"نشا"},{"id":15,"arabic":"مِّن","translit":"nِّm","root":""},{"id":16,"arabic":"ذُرِّيَّةِ","translit":"ِẗَّyِّrُhd","root":"ذرر"},{"id":17,"arabic":"قَوْمٍ","translit":"ٍmْwَq","root":"قوم"},{"id":18,"arabic":"ءَاخَرِينَ","translit":"َnyِrَhkāَء","root":"اخر"}],"hasIhya":false},{"ayah":134,"text":"إِنَّ مَا تُوعَدُونَ لَءَاتٍۖ وَمَآ أَنتُم بِمُعْجِزِينَ ","translation":"Indeed, what you are promised is coming, and you will not cause failure [to Allāh].[1]","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"تُوعَدُونَ","translit":"َnwُdَʿعwُt","root":"وعد"},{"id":4,"arabic":"لَءَاتٍ","translit":"ٍtāَءَl","root":"اتي"},{"id":5,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":6,"arabic":"أَنتُم","translit":"mُtnَaʾ","root":""},{"id":7,"arabic":"بِمُعْجِزِينَ","translit":"َnyِzِjgْʿعُmِb","root":"عجز"}],"hasIhya":true},{"ayah":135,"text":"قُلْ يَٰقَوْمِ ٱعْمَلُوا۟ عَلَىٰ مَكَانَتِكُمْ إِنِّى عَامِلٌۖ فَسَوْفَ تَعْلَمُونَ مَن تَكُونُ لَهُۥ عَٰقِبَةُ ٱلدَّارِۗ إِنَّهُۥ لَا يُفْلِحُ ٱلظَّٰلِمُونَ ","translation":"Say, \"O my people, work according to your position; [for] indeed, I am working. And you are going to know who will have succession in the home.[1] Indeed, the wrongdoers will not succeed.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":3,"arabic":"ٱعْمَلُوا۟","translit":"۟āwُlَmْʿعٱ","root":"عمل"},{"id":4,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":5,"arabic":"مَكَانَتِكُمْ","translit":"ْmُkِtَnāَkَm","root":"كون"},{"id":6,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":7,"arabic":"عَامِلٌ","translit":"ٌlِmāَʿع","root":"عمل"},{"id":8,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":9,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"},{"id":10,"arabic":"مَن","translit":"nَm","root":""},{"id":11,"arabic":"تَكُونُ","translit":"ُnwُkَt","root":"كون"},{"id":12,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":13,"arabic":"عَٰقِبَةُ","translit":"ُẗَbِqَٰʿع","root":"عقب"},{"id":14,"arabic":"ٱلدَّارِ","translit":"ِrāَّdlٱ","root":"دور"},{"id":15,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":16,"arabic":"لَا","translit":"āَl","root":""},{"id":17,"arabic":"يُفْلِحُ","translit":"ُḥِlْfُy","root":"فلح"},{"id":18,"arabic":"ٱلظَّٰلِمُونَ","translit":"َnwُmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":false},{"ayah":136,"text":"وَجَعَلُوا۟ لِلَّهِ مِمَّا ذَرَأَ مِنَ ٱلْحَرْثِ وَٱلْأَنْعَٰمِ نَصِيبًا فَقَالُوا۟ هَٰذَا لِلَّهِ بِزَعْمِهِمْ وَهَٰذَا لِشُرَكَآئِنَاۖ فَمَا كَانَ لِشُرَكَآئِهِمْ فَلَا يَصِلُ إِلَى ٱللَّهِۖ وَمَا كَانَ لِلَّهِ فَهُوَ يَصِلُ إِلَىٰ شُرَكَآئِهِمْۗ سَآءَ مَا يَحْكُمُونَ ","translation":"And they [i.e., the polytheists] assign to Allāh from that which He created of crops and livestock a share and say, \"This is for Allāh,\" by their claim, \"and this is for our 'partners' [associated with Him].\" But what is for their \"partners\" does not reach Allāh, while what is for Allāh - this reaches their \"partners.\" Evil is that which they rule.","words":[{"id":1,"arabic":"وَجَعَلُوا۟","translit":"۟āwُlَʿعَjgَw","root":"جعل"},{"id":2,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":3,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":4,"arabic":"ذَرَأَ","translit":"َaʾَrَhd","root":"ذرا"},{"id":5,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":6,"arabic":"ٱلْحَرْثِ","translit":"ِhtْrَḥْlٱ","root":"حرث"},{"id":7,"arabic":"وَٱلْأَنْعَٰمِ","translit":"ِmَٰʿعْnَaʾْlٱَw","root":"نعم"},{"id":8,"arabic":"نَصِيبًا","translit":"āًbyِṣَn","root":"نصب"},{"id":9,"arabic":"فَقَالُوا۟","translit":"۟āwُlāَqَf","root":"قول"},{"id":10,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":11,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":12,"arabic":"بِزَعْمِهِمْ","translit":"ْmِhِmْʿعَzِb","root":"زعم"},{"id":13,"arabic":"وَهَٰذَا","translit":"āَhdَٰhَw","root":""},{"id":14,"arabic":"لِشُرَكَآئِنَا","translit":"āَnِyʾٓāَkَrُhsِl","root":"شرك"},{"id":15,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":16,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":17,"arabic":"لِشُرَكَآئِهِمْ","translit":"ْmِhِyʾٓāَkَrُhsِl","root":"شرك"},{"id":18,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":19,"arabic":"يَصِلُ","translit":"ُlِṣَy","root":"وصل"},{"id":20,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":21,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":22,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":23,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":24,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":25,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":26,"arabic":"يَصِلُ","translit":"ُlِṣَy","root":"وصل"},{"id":27,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":28,"arabic":"شُرَكَآئِهِمْ","translit":"ْmِhِyʾٓāَkَrُhs","root":"شرك"},{"id":29,"arabic":"سَآءَ","translit":"َءٓāَs","root":"سوا"},{"id":30,"arabic":"مَا","translit":"āَm","root":""},{"id":31,"arabic":"يَحْكُمُونَ","translit":"َnwُmُkْḥَy","root":"حكم"}],"hasIhya":false},{"ayah":137,"text":"وَكَذَٰلِكَ زَيَّنَ لِكَثِيرٍ مِّنَ ٱلْمُشْرِكِينَ قَتْلَ أَوْلَٰدِهِمْ شُرَكَآؤُهُمْ لِيُرْدُوهُمْ وَلِيَلْبِسُوا۟ عَلَيْهِمْ دِينَهُمْۖ وَلَوْ شَآءَ ٱللَّهُ مَا فَعَلُوهُۖ فَذَرْهُمْ وَمَا يَفْتَرُونَ ","translation":"And likewise, to many of the polytheists their partners[1] have made [to seem] pleasing the killing of their children in order to bring about their destruction and to cover them with confusion in their religion. And if Allāh had willed, they would not have done so. So leave them and that which they invent.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"زَيَّنَ","translit":"َnَّyَz","root":"زين"},{"id":3,"arabic":"لِكَثِيرٍ","translit":"ٍryِhtَkِl","root":"كثر"},{"id":4,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":5,"arabic":"ٱلْمُشْرِكِينَ","translit":"َnyِkِrْhsُmْlٱ","root":"شرك"},{"id":6,"arabic":"قَتْلَ","translit":"َlْtَq","root":"قتل"},{"id":7,"arabic":"أَوْلَٰدِهِمْ","translit":"ْmِhِdَٰlْwَaʾ","root":"ولد"},{"id":8,"arabic":"شُرَكَآؤُهُمْ","translit":"ْmُhُwʾٓāَkَrُhs","root":"شرك"},{"id":9,"arabic":"لِيُرْدُوهُمْ","translit":"ْmُhwُdْrُyِl","root":"ردي"},{"id":10,"arabic":"وَلِيَلْبِسُوا۟","translit":"۟āwُsِbْlَyِlَw","root":"لبس"},{"id":11,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":12,"arabic":"دِينَهُمْ","translit":"ْmُhَnyِd","root":"دين"},{"id":13,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":14,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":15,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":16,"arabic":"مَا","translit":"āَm","root":""},{"id":17,"arabic":"فَعَلُوهُ","translit":"ُhwُlَʿعَf","root":"فعل"},{"id":18,"arabic":"فَذَرْهُمْ","translit":"ْmُhْrَhdَf","root":"وذر"},{"id":19,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":20,"arabic":"يَفْتَرُونَ","translit":"َnwُrَtْfَy","root":"فري"}],"hasIhya":false},{"ayah":138,"text":"وَقَالُوا۟ هَٰذِهِۦٓ أَنْعَٰمٌ وَحَرْثٌ حِجْرٌ لَّا يَطْعَمُهَآ إِلَّا مَن نَّشَآءُ بِزَعْمِهِمْ وَأَنْعَٰمٌ حُرِّمَتْ ظُهُورُهَا وَأَنْعَٰمٌ لَّا يَذْكُرُونَ ٱسْمَ ٱللَّهِ عَلَيْهَا ٱفْتِرَآءً عَلَيْهِۚ سَيَجْزِيهِم بِمَا كَانُوا۟ يَفْتَرُونَ ","translation":"And they say, \"These animals[1] and crops are forbidden; no one may eat from them except whom we will,\" by their claim. And there are those [camels] whose backs are forbidden [by them][2] and those upon which the name of Allāh is not mentioned[3] - [all of this] an invention of untruth about Him.[4] He will punish them for what they were inventing.","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"هَٰذِهِۦٓ","translit":"ٓۦِhِhdَٰh","root":""},{"id":3,"arabic":"أَنْعَٰمٌ","translit":"ٌmَٰʿعْnَaʾ","root":"نعم"},{"id":4,"arabic":"وَحَرْثٌ","translit":"ٌhtْrَḥَw","root":"حرث"},{"id":5,"arabic":"حِجْرٌ","translit":"ٌrْjgِḥ","root":"حجر"},{"id":6,"arabic":"لَّا","translit":"āَّl","root":""},{"id":7,"arabic":"يَطْعَمُهَآ","translit":"ٓāَhُmَʿعْṭَy","root":"طعم"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"مَن","translit":"nَm","root":""},{"id":10,"arabic":"نَّشَآءُ","translit":"ُءٓāَhsَّn","root":"شيا"},{"id":11,"arabic":"بِزَعْمِهِمْ","translit":"ْmِhِmْʿعَzِb","root":"زعم"},{"id":12,"arabic":"وَأَنْعَٰمٌ","translit":"ٌmَٰʿعْnَaʾَw","root":"نعم"},{"id":13,"arabic":"حُرِّمَتْ","translit":"ْtَmِّrُḥ","root":"حرم"},{"id":14,"arabic":"ظُهُورُهَا","translit":"āَhُrwُhُẓ","root":"ظهر"},{"id":15,"arabic":"وَأَنْعَٰمٌ","translit":"ٌmَٰʿعْnَaʾَw","root":"نعم"},{"id":16,"arabic":"لَّا","translit":"āَّl","root":""},{"id":17,"arabic":"يَذْكُرُونَ","translit":"َnwُrُkْhdَy","root":"ذكر"},{"id":18,"arabic":"ٱسْمَ","translit":"َmْsٱ","root":"سمو"},{"id":19,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":20,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":21,"arabic":"ٱفْتِرَآءً","translit":"ًءٓāَrِtْfٱ","root":"فري"},{"id":22,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":23,"arabic":"سَيَجْزِيهِم","translit":"mِhyِzْjgَyَs","root":"جزي"},{"id":24,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":25,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":26,"arabic":"يَفْتَرُونَ","translit":"َnwُrَtْfَy","root":"فري"}],"hasIhya":false},{"ayah":139,"text":"وَقَالُوا۟ مَا فِى بُطُونِ هَٰذِهِ ٱلْأَنْعَٰمِ خَالِصَةٌ لِّذُكُورِنَا وَمُحَرَّمٌ عَلَىٰٓ أَزْوَٰجِنَاۖ وَإِن يَكُن مَّيْتَةً فَهُمْ فِيهِ شُرَكَآءُۚ سَيَجْزِيهِمْ وَصْفَهُمْۚ إِنَّهُۥ حَكِيمٌ عَلِيمٌ ","translation":"And they say, \"What is in the bellies of these animals[1] is exclusively for our males and forbidden to our females. But if it is [born] dead, then all of them have shares therein.\" He will punish them for their description.[2] Indeed, He is Wise and Knowing.","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"بُطُونِ","translit":"ِnwُṭُb","root":"بطن"},{"id":5,"arabic":"هَٰذِهِ","translit":"ِhِhdَٰh","root":""},{"id":6,"arabic":"ٱلْأَنْعَٰمِ","translit":"ِmَٰʿعْnَaʾْlٱ","root":"نعم"},{"id":7,"arabic":"خَالِصَةٌ","translit":"ٌẗَṣِlāَhk","root":"خلص"},{"id":8,"arabic":"لِّذُكُورِنَا","translit":"āَnِrwُkُhdِّl","root":"ذكر"},{"id":9,"arabic":"وَمُحَرَّمٌ","translit":"ٌmَّrَḥُmَw","root":"حرم"},{"id":10,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":11,"arabic":"أَزْوَٰجِنَا","translit":"āَnِjgَٰwْzَaʾ","root":"زوج"},{"id":12,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":13,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":14,"arabic":"مَّيْتَةً","translit":"ًẗَtْyَّm","root":"موت"},{"id":15,"arabic":"فَهُمْ","translit":"ْmُhَf","root":""},{"id":16,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":17,"arabic":"شُرَكَآءُ","translit":"ُءٓāَkَrُhs","root":"شرك"},{"id":18,"arabic":"سَيَجْزِيهِمْ","translit":"ْmِhyِzْjgَyَs","root":"جزي"},{"id":19,"arabic":"وَصْفَهُمْ","translit":"ْmُhَfْṣَw","root":"وصف"},{"id":20,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":21,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"},{"id":22,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":140,"text":"قَدْ خَسِرَ ٱلَّذِينَ قَتَلُوٓا۟ أَوْلَٰدَهُمْ سَفَهًۢا بِغَيْرِ عِلْمٍ وَحَرَّمُوا۟ مَا رَزَقَهُمُ ٱللَّهُ ٱفْتِرَآءً عَلَى ٱللَّهِۚ قَدْ ضَلُّوا۟ وَمَا كَانُوا۟ مُهْتَدِينَ ","translation":"They will have lost who killed their children in foolishness without knowledge and prohibited what Allāh had provided for them, inventing untruth about Allāh. They have gone astray and were not [rightly] guided.","words":[{"id":1,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":2,"arabic":"خَسِرَ","translit":"َrِsَhk","root":"خسر"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"قَتَلُوٓا۟","translit":"۟āٓwُlَtَq","root":"قتل"},{"id":5,"arabic":"أَوْلَٰدَهُمْ","translit":"ْmُhَdَٰlْwَaʾ","root":"ولد"},{"id":6,"arabic":"سَفَهًۢا","translit":"āًۢhَfَs","root":"سفه"},{"id":7,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":8,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":9,"arabic":"وَحَرَّمُوا۟","translit":"۟āwُmَّrَḥَw","root":"حرم"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"رَزَقَهُمُ","translit":"ُmُhَqَzَr","root":"رزق"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"ٱفْتِرَآءً","translit":"ًءٓāَrِtْfٱ","root":"فري"},{"id":14,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":15,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":16,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":17,"arabic":"ضَلُّوا۟","translit":"۟āwُّlَḍ","root":"ضلل"},{"id":18,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":19,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":20,"arabic":"مُهْتَدِينَ","translit":"َnyِdَtْhُm","root":"هدي"}],"hasIhya":true},{"ayah":141,"text":"وَهُوَ ٱلَّذِىٓ أَنشَأَ جَنَّٰتٍ مَّعْرُوشَٰتٍ وَغَيْرَ مَعْرُوشَٰتٍ وَٱلنَّخْلَ وَٱلزَّرْعَ مُخْتَلِفًا أُكُلُهُۥ وَٱلزَّيْتُونَ وَٱلرُّمَّانَ مُتَشَٰبِهًا وَغَيْرَ مُتَشَٰبِهٍۚ كُلُوا۟ مِن ثَمَرِهِۦٓ إِذَآ أَثْمَرَ وَءَاتُوا۟ حَقَّهُۥ يَوْمَ حَصَادِهِۦۖ وَلَا تُسْرِفُوٓا۟ۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُسْرِفِينَ ","translation":"And He it is who causes gardens to grow, [both] trellised and untrellised, and palm trees and crops of different [kinds of] food and olives and pomegranates, similar and dissimilar. Eat of [each of] its fruit when it yields and give its due [zakāh] on the day of its harvest. And be not excessive.[1] Indeed, He does not like those who commit excess.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":3,"arabic":"أَنشَأَ","translit":"َaʾَhsnَaʾ","root":"نشا"},{"id":4,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":5,"arabic":"مَّعْرُوشَٰتٍ","translit":"ٍtَٰhswُrْʿعَّm","root":"عرش"},{"id":6,"arabic":"وَغَيْرَ","translit":"َrْyَغَw","root":"غير"},{"id":7,"arabic":"مَعْرُوشَٰتٍ","translit":"ٍtَٰhswُrْʿعَm","root":"عرش"},{"id":8,"arabic":"وَٱلنَّخْلَ","translit":"َlْhkَّnlٱَw","root":"نخل"},{"id":9,"arabic":"وَٱلزَّرْعَ","translit":"َʿعْrَّzlٱَw","root":"زرع"},{"id":10,"arabic":"مُخْتَلِفًا","translit":"āًfِlَtْhkُm","root":"خلف"},{"id":11,"arabic":"أُكُلُهُۥ","translit":"ۥُhُlُkُaʾ","root":"اكل"},{"id":12,"arabic":"وَٱلزَّيْتُونَ","translit":"َnwُtْyَّzlٱَw","root":"زيت"},{"id":13,"arabic":"وَٱلرُّمَّانَ","translit":"َnāَّmُّrlٱَw","root":"رمن"},{"id":14,"arabic":"مُتَشَٰبِهًا","translit":"āًhِbَٰhsَtُm","root":"شبه"},{"id":15,"arabic":"وَغَيْرَ","translit":"َrْyَغَw","root":"غير"},{"id":16,"arabic":"مُتَشَٰبِهٍ","translit":"ٍhِbَٰhsَtُm","root":"شبه"},{"id":17,"arabic":"كُلُوا۟","translit":"۟āwُlُk","root":"اكل"},{"id":18,"arabic":"مِن","translit":"nِm","root":""},{"id":19,"arabic":"ثَمَرِهِۦٓ","translit":"ٓۦِhِrَmَht","root":"ثمر"},{"id":20,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":21,"arabic":"أَثْمَرَ","translit":"َrَmْhtَaʾ","root":"ثمر"},{"id":22,"arabic":"وَءَاتُوا۟","translit":"۟āwُtāَءَw","root":"اتي"},{"id":23,"arabic":"حَقَّهُۥ","translit":"ۥُhَّqَḥ","root":"حقق"},{"id":24,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":25,"arabic":"حَصَادِهِۦ","translit":"ۦِhِdāَṣَḥ","root":"حصد"},{"id":26,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":27,"arabic":"تُسْرِفُوٓا۟","translit":"۟āٓwُfِrْsُt","root":"سرف"},{"id":28,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":29,"arabic":"لَا","translit":"āَl","root":""},{"id":30,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":31,"arabic":"ٱلْمُسْرِفِينَ","translit":"َnyِfِrْsُmْlٱ","root":"سرف"}],"hasIhya":false},{"ayah":142,"text":"وَمِنَ ٱلْأَنْعَٰمِ حَمُولَةً وَفَرْشًاۚ كُلُوا۟ مِمَّا رَزَقَكُمُ ٱللَّهُ وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ ٱلشَّيْطَٰنِۚ إِنَّهُۥ لَكُمْ عَدُوٌّ مُّبِينٌ ","translation":"And of the grazing livestock are carriers [of burdens] and those [too] small. Eat of what Allāh has provided for you and do not follow the footsteps of Satan.[1] Indeed, he is to you a clear enemy.","words":[{"id":1,"arabic":"وَمِنَ","translit":"َnِmَw","root":""},{"id":2,"arabic":"ٱلْأَنْعَٰمِ","translit":"ِmَٰʿعْnَaʾْlٱ","root":"نعم"},{"id":3,"arabic":"حَمُولَةً","translit":"ًẗَlwُmَḥ","root":"حمل"},{"id":4,"arabic":"وَفَرْشًا","translit":"āًhsْrَfَw","root":"فرش"},{"id":5,"arabic":"كُلُوا۟","translit":"۟āwُlُk","root":"اكل"},{"id":6,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":7,"arabic":"رَزَقَكُمُ","translit":"ُmُkَqَzَr","root":"رزق"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"تَتَّبِعُوا۟","translit":"۟āwُʿعِbَّtَt","root":"تبع"},{"id":11,"arabic":"خُطُوَٰتِ","translit":"ِtَٰwُṭُhk","root":"خطو"},{"id":12,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":13,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":14,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":15,"arabic":"عَدُوٌّ","translit":"ٌّwُdَʿع","root":"عدو"},{"id":16,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":143,"text":"ثَمَٰنِيَةَ أَزْوَٰجٍۖ مِّنَ ٱلضَّأْنِ ٱثْنَيْنِ وَمِنَ ٱلْمَعْزِ ٱثْنَيْنِۗ قُلْ ءَآلذَّكَرَيْنِ حَرَّمَ أَمِ ٱلْأُنثَيَيْنِ أَمَّا ٱشْتَمَلَتْ عَلَيْهِ أَرْحَامُ ٱلْأُنثَيَيْنِۖ نَبِّـُٔونِى بِعِلْمٍ إِن كُنتُمْ صَٰدِقِينَ ","translation":"[They are] eight mates - of the sheep, two and of the goats, two. Say, \"Is it the two males He has forbidden or the two females or that which the wombs of the two females contain? Inform me with knowledge, if you should be truthful.\"","words":[{"id":1,"arabic":"ثَمَٰنِيَةَ","translit":"َẗَyِnَٰmَht","root":"ثمن"},{"id":2,"arabic":"أَزْوَٰجٍ","translit":"ٍjgَٰwْzَaʾ","root":"زوج"},{"id":3,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":4,"arabic":"ٱلضَّأْنِ","translit":"ِnْaʾَّḍlٱ","root":"ضان"},{"id":5,"arabic":"ٱثْنَيْنِ","translit":"ِnْyَnْhtٱ","root":"ثني"},{"id":6,"arabic":"وَمِنَ","translit":"َnِmَw","root":""},{"id":7,"arabic":"ٱلْمَعْزِ","translit":"ِzْʿعَmْlٱ","root":"معز"},{"id":8,"arabic":"ٱثْنَيْنِ","translit":"ِnْyَnْhtٱ","root":"ثني"},{"id":9,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":10,"arabic":"ءَآلذَّكَرَيْنِ","translit":"ِnْyَrَkَّhdlٓāَء","root":"ذكر"},{"id":11,"arabic":"حَرَّمَ","translit":"َmَّrَḥ","root":"حرم"},{"id":12,"arabic":"أَمِ","translit":"ِmَaʾ","root":""},{"id":13,"arabic":"ٱلْأُنثَيَيْنِ","translit":"ِnْyَyَhtnُaʾْlٱ","root":"انث"},{"id":14,"arabic":"أَمَّا","translit":"āَّmَaʾ","root":""},{"id":15,"arabic":"ٱشْتَمَلَتْ","translit":"ْtَlَmَtْhsٱ","root":"شمل"},{"id":16,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":17,"arabic":"أَرْحَامُ","translit":"ُmāَḥْrَaʾ","root":"رحم"},{"id":18,"arabic":"ٱلْأُنثَيَيْنِ","translit":"ِnْyَyَhtnُaʾْlٱ","root":"انث"},{"id":19,"arabic":"نَبِّـُٔونِى","translit":"àِnwُٔـِّbَn","root":"نبا"},{"id":20,"arabic":"بِعِلْمٍ","translit":"ٍmْlِʿعِb","root":"علم"},{"id":21,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":22,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":23,"arabic":"صَٰدِقِينَ","translit":"َnyِqِdَٰṣ","root":"صدق"}],"hasIhya":false},{"ayah":144,"text":"وَمِنَ ٱلْإِبِلِ ٱثْنَيْنِ وَمِنَ ٱلْبَقَرِ ٱثْنَيْنِۗ قُلْ ءَآلذَّكَرَيْنِ حَرَّمَ أَمِ ٱلْأُنثَيَيْنِ أَمَّا ٱشْتَمَلَتْ عَلَيْهِ أَرْحَامُ ٱلْأُنثَيَيْنِۖ أَمْ كُنتُمْ شُهَدَآءَ إِذْ وَصَّىٰكُمُ ٱللَّهُ بِهَٰذَاۚ فَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا لِّيُضِلَّ ٱلنَّاسَ بِغَيْرِ عِلْمٍۗ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّٰلِمِينَ ","translation":"And of the camels, two and of the cattle, two. Say, \"Is it the two males He has forbidden or the two females or that which the wombs of the two females contain? Or were you witnesses when Allāh charged you with this? Then who is more unjust than one who invents a lie about Allāh to mislead the people by [something] other than knowledge? Indeed, Allāh does not guide the wrongdoing people.\"","words":[{"id":1,"arabic":"وَمِنَ","translit":"َnِmَw","root":""},{"id":2,"arabic":"ٱلْإِبِلِ","translit":"ِlِbِiʾْlٱ","root":"ابل"},{"id":3,"arabic":"ٱثْنَيْنِ","translit":"ِnْyَnْhtٱ","root":"ثني"},{"i