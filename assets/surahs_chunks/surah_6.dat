bāَء","root":"ابو"},{"id":38,"arabic":"قُلِ","translit":"ِlُq","root":"قول"},{"id":39,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":40,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":41,"arabic":"ذَرْهُمْ","translit":"ْmُhْrَhd","root":"وذر"},{"id":42,"arabic":"فِى","translit":"àِf","root":""},{"id":43,"arabic":"خَوْضِهِمْ","translit":"ْmِhِḍْwَhk","root":"خوض"},{"id":44,"arabic":"يَلْعَبُونَ","translit":"َnwُbَʿعْlَy","root":"لعب"}],"hasIhya":true},{"ayah":92,"text":"وَهَٰذَا كِتَٰبٌ أَنزَلْنَٰهُ مُبَارَكٌ مُّصَدِّقُ ٱلَّذِى بَيْنَ يَدَيْهِ وَلِتُنذِرَ أُمَّ ٱلْقُرَىٰ وَمَنْ حَوْلَهَاۚ وَٱلَّذِينَ يُؤْمِنُونَ بِٱلْءَاخِرَةِ يُؤْمِنُونَ بِهِۦۖ وَهُمْ عَلَىٰ صَلَاتِهِمْ يُحَافِظُونَ ","translation":"And this is a Book which We have sent down, blessed and confirming what was before it, that you may warn the Mother of Cities [i.e., Makkah] and those around it.[1] Those who believe in the Hereafter believe in it, and they are maintaining their prayers.","words":[{"id":1,"arabic":"وَهَٰذَا","translit":"āَhdَٰhَw","root":""},{"id":2,"arabic":"كِتَٰبٌ","translit":"ٌbَٰtِk","root":"كتب"},{"id":3,"arabic":"أَنزَلْنَٰهُ","translit":"ُhَٰnْlَznَaʾ","root":"نزل"},{"id":4,"arabic":"مُبَارَكٌ","translit":"ٌkَrāَbُm","root":"برك"},{"id":5,"arabic":"مُّصَدِّقُ","translit":"ُqِّdَṣُّm","root":"صدق"},{"id":6,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":7,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":8,"arabic":"يَدَيْهِ","translit":"ِhْyَdَy","root":"يدي"},{"id":9,"arabic":"وَلِتُنذِرَ","translit":"َrِhdnُtِlَw","root":"نذر"},{"id":10,"arabic":"أُمَّ","translit":"َّmُaʾ","root":"امم"},{"id":11,"arabic":"ٱلْقُرَىٰ","translit":"ٰàَrُqْlٱ","root":"قري"},{"id":12,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":13,"arabic":"حَوْلَهَا","translit":"āَhَlْwَḥ","root":"حول"},{"id":14,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":15,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":16,"arabic":"بِٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱِb","root":"اخر"},{"id":17,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":18,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":19,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":20,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":21,"arabic":"صَلَاتِهِمْ","translit":"ْmِhِtāَlَṣ","root":"صلو"},{"id":22,"arabic":"يُحَافِظُونَ","translit":"َnwُẓِfāَḥُy","root":"حفظ"}],"hasIhya":false},{"ayah":93,"text":"وَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا أَوْ قَالَ أُوحِىَ إِلَىَّ وَلَمْ يُوحَ إِلَيْهِ شَىْءٌ وَمَن قَالَ سَأُنزِلُ مِثْلَ مَآ أَنزَلَ ٱللَّهُۗ وَلَوْ تَرَىٰٓ إِذِ ٱلظَّٰلِمُونَ فِى غَمَرَٰتِ ٱلْمَوْتِ وَٱلْمَلَٰٓئِكَةُ بَاسِطُوٓا۟ أَيْدِيهِمْ أَخْرِجُوٓا۟ أَنفُسَكُمُۖ ٱلْيَوْمَ تُجْزَوْنَ عَذَابَ ٱلْهُونِ بِمَا كُنتُمْ تَقُولُونَ عَلَى ٱللَّهِ غَيْرَ ٱلْحَقِّ وَكُنتُمْ عَنْ ءَايَٰتِهِۦ تَسْتَكْبِرُونَ ","translation":"And who is more unjust than one who invents a lie about Allāh or says, \"It has been inspired to me,\" while nothing has been inspired to him, and one who says, \"I will reveal [something] like what Allāh revealed.\" And if you could but see when the wrongdoers are in the overwhelming pangs of death while the angels extend their hands,[1] [saying], \"Discharge your souls! Today you will be awarded the punishment of [extreme] humiliation for what you used to say against Allāh other than the truth and [that] you were, toward His verses, being arrogant.\"","words":[{"id":1,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":2,"arabic":"أَظْلَمُ","translit":"ُmَlْẓَaʾ","root":"ظلم"},{"id":3,"arabic":"مِمَّنِ","translit":"ِnَّmِm","root":""},{"id":4,"arabic":"ٱفْتَرَىٰ","translit":"ٰàَrَtْfٱ","root":"فري"},{"id":5,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"كَذِبًا","translit":"āًbِhdَk","root":"كذب"},{"id":8,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":9,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":10,"arabic":"أُوحِىَ","translit":"َàِḥwُaʾ","root":"وحي"},{"id":11,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":12,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":13,"arabic":"يُوحَ","translit":"َḥwُy","root":"وحي"},{"id":14,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":15,"arabic":"شَىْءٌ","translit":"ٌءْàَhs","root":"شيا"},{"id":16,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":17,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":18,"arabic":"سَأُنزِلُ","translit":"ُlِznُaʾَs","root":"نزل"},{"id":19,"arabic":"مِثْلَ","translit":"َlْhtِm","root":"مثل"},{"id":20,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":21,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":22,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":23,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":24,"arabic":"تَرَىٰٓ","translit":"ٰٓàَrَt","root":"راي"},{"id":25,"arabic":"إِذِ","translit":"ِhdِiʾ","root":""},{"id":26,"arabic":"ٱلظَّٰلِمُونَ","translit":"َnwُmِlَّٰẓlٱ","root":"ظلم"},{"id":27,"arabic":"فِى","translit":"àِf","root":""},{"id":28,"arabic":"غَمَرَٰتِ","translit":"ِtَٰrَmَغ","root":"غمر"},{"id":29,"arabic":"ٱلْمَوْتِ","translit":"ِtْwَmْlٱ","root":"موت"},{"id":30,"arabic":"وَٱلْمَلَٰٓئِكَةُ","translit":"ُẗَkِyʾَٰٓlَmْlٱَw","root":"ملك"},{"id":31,"arabic":"بَاسِطُوٓا۟","translit":"۟āٓwُṭِsāَb","root":"بسط"},{"id":32,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":33,"arabic":"أَخْرِجُوٓا۟","translit":"۟āٓwُjgِrْhkَaʾ","root":"خرج"},{"id":34,"arabic":"أَنفُسَكُمُ","translit":"ُmُkَsُfnَaʾ","root":"نفس"},{"id":35,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":36,"arabic":"تُجْزَوْنَ","translit":"َnْwَzْjgُt","root":"جزي"},{"id":37,"arabic":"عَذَابَ","translit":"َbāَhdَʿع","root":"عذب"},{"id":38,"arabic":"ٱلْهُونِ","translit":"ِnwُhْlٱ","root":"هون"},{"id":39,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":40,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":41,"arabic":"تَقُولُونَ","translit":"َnwُlwُqَt","root":"قول"},{"id":42,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":43,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":44,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":45,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":46,"arabic":"وَكُنتُمْ","translit":"ْmُtnُkَw","root":"كون"},{"id":47,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":48,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":49,"arabic":"تَسْتَكْبِرُونَ","translit":"َnwُrِbْkَtْsَt","root":"كبر"}],"hasIhya":true},{"ayah":94,"text":"وَلَقَدْ جِئْتُمُونَا فُرَٰدَىٰ كَمَا خَلَقْنَٰكُمْ أَوَّلَ مَرَّةٍ وَتَرَكْتُم مَّا خَوَّلْنَٰكُمْ وَرَآءَ ظُهُورِكُمْۖ وَمَا نَرَىٰ مَعَكُمْ شُفَعَآءَكُمُ ٱلَّذِينَ زَعَمْتُمْ أَنَّهُمْ فِيكُمْ شُرَكَٰٓؤُا۟ۚ لَقَد تَّقَطَّعَ بَيْنَكُمْ وَضَلَّ عَنكُم مَّا كُنتُمْ تَزْعُمُونَ ","translation":"[It will be said to them], \"And you have certainly come to Us alone [i.e., individually] as We created you the first time, and you have left whatever We bestowed upon you behind you. And We do not see with you your 'intercessors' which you claimed that they were among you associates [of Allāh]. It has [all] been severed between you,[1] and lost from you is what you used to claim.\"","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"جِئْتُمُونَا","translit":"āَnwُmُtْyʾِjg","root":"جيا"},{"id":3,"arabic":"فُرَٰدَىٰ","translit":"ٰàَdَٰrُf","root":"فرد"},{"id":4,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":5,"arabic":"خَلَقْنَٰكُمْ","translit":"ْmُkَٰnْqَlَhk","root":"خلق"},{"id":6,"arabic":"أَوَّلَ","translit":"َlَّwَaʾ","root":"اول"},{"id":7,"arabic":"مَرَّةٍ","translit":"ٍẗَّrَm","root":"مرر"},{"id":8,"arabic":"وَتَرَكْتُم","translit":"mُtْkَrَtَw","root":"ترك"},{"id":9,"arabic":"مَّا","translit":"āَّm","root":""},{"id":10,"arabic":"خَوَّلْنَٰكُمْ","translit":"ْmُkَٰnْlَّwَhk","root":"خول"},{"id":11,"arabic":"وَرَآءَ","translit":"َءٓāَrَw","root":"وري"},{"id":12,"arabic":"ظُهُورِكُمْ","translit":"ْmُkِrwُhُẓ","root":"ظهر"},{"id":13,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":14,"arabic":"نَرَىٰ","translit":"ٰàَrَn","root":"راي"},{"id":15,"arabic":"مَعَكُمْ","translit":"ْmُkَʿعَm","root":""},{"id":16,"arabic":"شُفَعَآءَكُمُ","translit":"ُmُkَءٓāَʿعَfُhs","root":"شفع"},{"id":17,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":18,"arabic":"زَعَمْتُمْ","translit":"ْmُtْmَʿعَz","root":"زعم"},{"id":19,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":20,"arabic":"فِيكُمْ","translit":"ْmُkyِf","root":""},{"id":21,"arabic":"شُرَكَٰٓؤُا۟","translit":"۟āُwʾَٰٓkَrُhs","root":"شرك"},{"id":22,"arabic":"لَقَد","translit":"dَqَl","root":""},{"id":23,"arabic":"تَّقَطَّعَ","translit":"َʿعَّṭَqَّt","root":"قطع"},{"id":24,"arabic":"بَيْنَكُمْ","translit":"ْmُkَnْyَb","root":"بين"},{"id":25,"arabic":"وَضَلَّ","translit":"َّlَḍَw","root":"ضلل"},{"id":26,"arabic":"عَنكُم","translit":"mُknَʿع","root":""},{"id":27,"arabic":"مَّا","translit":"āَّm","root":""},{"id":28,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":29,"arabic":"تَزْعُمُونَ","translit":"َnwُmُʿعْzَt","root":"زعم"}],"hasIhya":true},{"ayah":95,"text":"إِنَّ ٱللَّهَ فَالِقُ ٱلْحَبِّ وَٱلنَّوَىٰۖ يُخْرِجُ ٱلْحَىَّ مِنَ ٱلْمَيِّتِ وَمُخْرِجُ ٱلْمَيِّتِ مِنَ ٱلْحَىِّۚ ذَٰلِكُمُ ٱللَّهُۖ فَأَنَّىٰ تُؤْفَكُونَ ","translation":"Indeed, Allāh is the cleaver of grain and date seeds.[1] He brings the living out of the dead and brings the dead out of the living. That is Allāh; so how are you deluded?","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"فَالِقُ","translit":"ُqِlāَf","root":"فلق"},{"id":4,"arabic":"ٱلْحَبِّ","translit":"ِّbَḥْlٱ","root":"حبب"},{"id":5,"arabic":"وَٱلنَّوَىٰ","translit":"ٰàَwَّnlٱَw","root":"نوي"},{"id":6,"arabic":"يُخْرِجُ","translit":"ُjgِrْhkُy","root":"خرج"},{"id":7,"arabic":"ٱلْحَىَّ","translit":"َّàَḥْlٱ","root":"حيي"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلْمَيِّتِ","translit":"ِtِّyَmْlٱ","root":"موت"},{"id":10,"arabic":"وَمُخْرِجُ","translit":"ُjgِrْhkُmَw","root":"خرج"},{"id":11,"arabic":"ٱلْمَيِّتِ","translit":"ِtِّyَmْlٱ","root":"موت"},{"id":12,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":13,"arabic":"ٱلْحَىِّ","translit":"ِّàَḥْlٱ","root":"حيي"},{"id":14,"arabic":"ذَٰلِكُمُ","translit":"ُmُkِlَٰhd","root":""},{"id":15,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":16,"arabic":"فَأَنَّىٰ","translit":"ٰàَّnَaʾَf","root":""},{"id":17,"arabic":"تُؤْفَكُونَ","translit":"َnwُkَfْwʾُt","root":"افك"}],"hasIhya":false},{"ayah":96,"text":"فَالِقُ ٱلْإِصْبَاحِ وَجَعَلَ ٱلَّيْلَ سَكَنًا وَٱلشَّمْسَ وَٱلْقَمَرَ حُسْبَانًاۚ ذَٰلِكَ تَقْدِيرُ ٱلْعَزِيزِ ٱلْعَلِيمِ ","translation":"[He is] the cleaver of daybreak and has made the night for rest and the sun and moon for calculation.[1] That is the determination of the Exalted in Might, the Knowing.","words":[{"id":1,"arabic":"فَالِقُ","translit":"ُqِlāَf","root":"فلق"},{"id":2,"arabic":"ٱلْإِصْبَاحِ","translit":"ِḥāَbْṣِiʾْlٱ","root":"صبح"},{"id":3,"arabic":"وَجَعَلَ","translit":"َlَʿعَjgَw","root":"جعل"},{"id":4,"arabic":"ٱلَّيْلَ","translit":"َlْyَّlٱ","root":"ليل"},{"id":5,"arabic":"سَكَنًا","translit":"āًnَkَs","root":"سكن"},{"id":6,"arabic":"وَٱلشَّمْسَ","translit":"َsْmَّhslٱَw","root":"شمس"},{"id":7,"arabic":"وَٱلْقَمَرَ","translit":"َrَmَqْlٱَw","root":"قمر"},{"id":8,"arabic":"حُسْبَانًا","translit":"āًnāَbْsُḥ","root":"حسب"},{"id":9,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":10,"arabic":"تَقْدِيرُ","translit":"ُryِdْqَt","root":"قدر"},{"id":11,"arabic":"ٱلْعَزِيزِ","translit":"ِzyِzَʿعْlٱ","root":"عزز"},{"id":12,"arabic":"ٱلْعَلِيمِ","translit":"ِmyِlَʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":97,"text":"وَهُوَ ٱلَّذِى جَعَلَ لَكُمُ ٱلنُّجُومَ لِتَهْتَدُوا۟ بِهَا فِى ظُلُمَٰتِ ٱلْبَرِّ وَٱلْبَحْرِۗ قَدْ فَصَّلْنَا ٱلْءَايَٰتِ لِقَوْمٍ يَعْلَمُونَ ","translation":"And it is He who placed for you the stars that you may be guided by them through the darknesses of the land and sea. We have detailed the signs for a people who know.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":4,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":5,"arabic":"ٱلنُّجُومَ","translit":"َmwُjgُّnlٱ","root":"نجم"},{"id":6,"arabic":"لِتَهْتَدُوا۟","translit":"۟āwُdَtْhَtِl","root":"هدي"},{"id":7,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ظُلُمَٰتِ","translit":"ِtَٰmُlُẓ","root":"ظلم"},{"id":10,"arabic":"ٱلْبَرِّ","translit":"ِّrَbْlٱ","root":"برر"},{"id":11,"arabic":"وَٱلْبَحْرِ","translit":"ِrْḥَbْlٱَw","root":"بحر"},{"id":12,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":13,"arabic":"فَصَّلْنَا","translit":"āَnْlَّṣَf","root":"فصل"},{"id":14,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":15,"arabic":"لِقَوْمٍ","translit":"ٍmْwَqِl","root":"قوم"},{"id":16,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":true},{"ayah":98,"text":"وَهُوَ ٱلَّذِىٓ أَنشَأَكُم مِّن نَّفْسٍ وَٰحِدَةٍ فَمُسْتَقَرٌّ وَمُسْتَوْدَعٌۗ قَدْ فَصَّلْنَا ٱلْءَايَٰتِ لِقَوْمٍ يَفْقَهُونَ ","translation":"And it is He who produced you from one soul and [gave you] a place of dwelling and of storage.[1] We have detailed the signs for a people who understand.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":3,"arabic":"أَنشَأَكُم","translit":"mُkَaʾَhsnَaʾ","root":"نشا"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"نَّفْسٍ","translit":"ٍsْfَّn","root":"نفس"},{"id":6,"arabic":"وَٰحِدَةٍ","translit":"ٍẗَdِḥَٰw","root":"وحد"},{"id":7,"arabic":"فَمُسْتَقَرٌّ","translit":"ٌّrَqَtْsُmَf","root":"قرر"},{"id":8,"arabic":"وَمُسْتَوْدَعٌ","translit":"ٌʿعَdْwَtْsُmَw","root":"ودع"},{"id":9,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":10,"arabic":"فَصَّلْنَا","translit":"āَnْlَّṣَf","root":"فصل"},{"id":11,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":12,"arabic":"لِقَوْمٍ","translit":"ٍmْwَqِl","root":"قوم"},{"id":13,"arabic":"يَفْقَهُونَ","translit":"َnwُhَqْfَy","root":"فقه"}],"hasIhya":false},{"ayah":99,"text":"وَهُوَ ٱلَّذِىٓ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءً فَأَخْرَجْنَا بِهِۦ نَبَاتَ كُلِّ شَىْءٍ فَأَخْرَجْنَا مِنْهُ خَضِرًا نُّخْرِجُ مِنْهُ حَبًّا مُّتَرَاكِبًا وَمِنَ ٱلنَّخْلِ مِن طَلْعِهَا قِنْوَانٌ دَانِيَةٌ وَجَنَّٰتٍ مِّنْ أَعْنَابٍ وَٱلزَّيْتُونَ وَٱلرُّمَّانَ مُشْتَبِهًا وَغَيْرَ مُتَشَٰبِهٍۗ ٱنظُرُوٓا۟ إِلَىٰ ثَمَرِهِۦٓ إِذَآ أَثْمَرَ وَيَنْعِهِۦٓۚ إِنَّ فِى ذَٰلِكُمْ لَءَايَٰتٍ لِّقَوْمٍ يُؤْمِنُونَ ","translation":"And it is He who sends down rain from the sky, and We produce thereby the growth of all things. We produce from it greenery from which We produce grains arranged in layers. And from the palm trees - of its emerging fruit are clusters hanging low. And [We produce] gardens of grapevines and olives and pomegranates, similar yet varied. Look at [each of] its fruit when it yields and [at] its ripening. Indeed in that are signs for a people who believe.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":3,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":4,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":5,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":6,"arabic":"مَآءً","translit":"ًءٓāَm","root":"موه"},{"id":7,"arabic":"فَأَخْرَجْنَا","translit":"āَnْjgَrْhkَaʾَf","root":"خرج"},{"id":8,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":9,"arabic":"نَبَاتَ","translit":"َtāَbَn","root":"نبت"},{"id":10,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},