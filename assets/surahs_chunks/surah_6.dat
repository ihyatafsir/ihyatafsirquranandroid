"", "root": ""}, {"id": 19, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 38, "text": "وَمَا مِن دَآبَّةࣲ فِے اِ۬لَارْضِ وَلَا طَٰٓئِرࣲ يَطِيرُ بِجَنَاحَيْهِ إِلَّآ أُمَمٌ اَمْثَالُكُمۖ مَّا فَرَّطْنَا فِے اِ۬لْكِتَٰبِ مِن شَےْءࣲۖ ثُمَّ إِلَيٰ رَبِّهِمْ يُحْشَرُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "دَآبَّةࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "طَٰٓئِرࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَطِيرُ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِجَنَاحَيْهِ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أُمَمٌ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَمْثَالُكُمۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 14, "arabic": "فَرَّطْنَا", "translit": "", "root": ""}, {"id": 15, "arabic": "فِے", "translit": "", "root": ""}, {"id": 16, "arabic": "اِ۬لْكِتَٰبِ", "translit": "", "root": ""}, {"id": 17, "arabic": "مِن", "translit": "", "root": ""}, {"id": 18, "arabic": "شَےْءࣲۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 20, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 21, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 22, "arabic": "يُحْشَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 39, "text": "وَالذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا صُمࣱّ وَبُكْمࣱ فِے اِ۬لظُّلُمَٰتِۖ مَنْ يَّشَإِ اِ۬للَّهُ يُضْلِلْهُۖ وَمَنْ يَّشَأْ يَجْعَلْهُ عَلَيٰ صِرَٰطࣲ مُّسْتَقِيمࣲۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَ