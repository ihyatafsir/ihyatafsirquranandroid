ic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 8, "text": "وَقَالُواْ لَوْلَآ أُنزِلَ عَلَيْهِ مَلَكࣱۖ وَلَوَ اَنزَلْنَا مَلَكاࣰ لَّقُضِيَ اَ۬لَامْرُ ثُمَّ لَا يُنظَرُونَۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَوْلَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُنزِلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَلَكࣱۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَوَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَنزَلْنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مَلَكاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَّقُضِيَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لَامْرُ", "translit": "", "root": ""}, {"id": 11, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "", "root": ""}, {"id": 13, "arabic": "يُنظَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 9, "text": "وَلَوْ جَعَلْنَٰهُ مَلَكاࣰ لَّجَعَلْنَٰهُ رَجُلاࣰ وَلَلَبَسْنَا عَلَيْهِم مَّا يَلْبِسُونَۖ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَلَكاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّجَعَلْنَٰهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَجُلاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَلَبَسْنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَلْبِسُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 10, "text": "وَلَقَدُ اُ۟سْتُهْزِۓَ بِرُسُلࣲ مِّن قَبْلِكَ فَحَاقَ بِالذِينَ سَخِرُواْ مِنْهُم مَّا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدُ", "translit": "", "root": ""}, {"