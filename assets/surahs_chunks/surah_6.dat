{"id":2,"arabic":"يَنْهَوْنَ","translit":"َnْwَhْnَy","root":"نهي"},{"id":3,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":4,"arabic":"وَيَنْـَٔوْنَ","translit":"َnْwَٔـْnَyَw","root":"ناي"},{"id":5,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":6,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":7,"arabic":"يُهْلِكُونَ","translit":"َnwُkِlْhُy","root":"هلك"},{"id":8,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":9,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":10,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":11,"arabic":"يَشْعُرُونَ","translit":"َnwُrُʿعْhsَy","root":"شعر"}],"hasIhya":false},{"ayah":27,"text":"وَلَوْ تَرَىٰٓ إِذْ وُقِفُوا۟ عَلَى ٱلنَّارِ فَقَالُوا۟ يَٰلَيْتَنَا نُرَدُّ وَلَا نُكَذِّبَ بِـَٔايَٰتِ رَبِّنَا وَنَكُونَ مِنَ ٱلْمُؤْمِنِينَ ","translation":"If you could but see when they are made to stand before the Fire and will say, \"Oh, would that we could be returned [to life on earth] and not deny the signs of our Lord and be among the believers.\"","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"تَرَىٰٓ","translit":"ٰٓàَrَt","root":"راي"},{"id":3,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":4,"arabic":"وُقِفُوا۟","translit":"۟āwُfِqُw","root":"وقف"},{"id":5,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":6,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":7,"arabic":"فَقَالُوا۟","translit":"۟āwُlāَqَf","root":"قول"},{"id":8,"arabic":"يَٰلَيْتَنَا","translit":"āَnَtْyَlَٰy","root":""},{"id":9,"arabic":"نُرَدُّ","translit":"ُّdَrُn","root":"ردد"},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"نُكَذِّبَ","translit":"َbِّhdَkُn","root":"كذب"},{"id":12,"arabic":"بِـَٔايَٰتِ","translit":"ِtَٰyāَٔـِb","root":"ايي"},{"id":13,"arabic":"رَبِّنَا","translit":"āَnِّbَr","root":"ربب"},{"id":14,"arabic":"وَنَكُونَ","translit":"َnwُkَnَw","root":"كون"},{"id":15,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":16,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"}],"hasIhya":false},{"ayah":28,"text":"بَلْ بَدَا لَهُم مَّا كَانُوا۟ يُخْفُونَ مِن قَبْلُۖ وَلَوْ رُدُّوا۟ لَعَادُوا۟ لِمَا نُهُوا۟ عَنْهُ وَإِنَّهُمْ لَكَٰذِبُونَ ","translation":"But what they concealed before has [now] appeared to them. And even if they were returned, they would return to that which they were forbidden; and indeed, they are liars.","words":[{"id":1,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":2,"arabic":"بَدَا","translit":"āَdَb","root":"بدو"},{"id":3,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":4,"arabic":"مَّا","translit":"āَّm","root":""},{"id":5,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":6,"arabic":"يُخْفُونَ","translit":"َnwُfْhkُy","root":"خفي"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":9,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":10,"arabic":"رُدُّوا۟","translit":"۟āwُّdُr","root":"ردد"},{"id":11,"arabic":"لَعَادُوا۟","translit":"۟āwُdāَʿعَl","root":"عود"},{"id":12,"arabic":"لِمَا","translit":"āَmِl","root":""},{"id":13,"arabic":"نُهُوا۟","translit":"۟āwُhُn","root":"نهي"},{"id":14,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":15,"arabic":"وَإِنَّهُمْ","translit":"ْmُhَّnِiʾَw","root":""},{"id":16,"arabic":"لَكَٰذِبُونَ","translit":"َnwُbِhdَٰkَl","root":"كذب"}],"hasIhya":false},{"ayah":29,"text":"وَقَالُوٓا۟ إِنْ هِىَ إِلَّا حَيَاتُنَا ٱلدُّنْيَا وَمَا نَحْنُ بِمَبْعُوثِينَ ","translation":"And they say, \"There is none but our worldly life, and we will not be resurrected.\"","words":[{"id":1,"arabic":"وَقَالُوٓا۟","translit":"۟āٓwُlāَqَw","root":"قول"},{"id":2,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":3,"arabic":"هِىَ","translit":"َàِh","root":""},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"حَيَاتُنَا","translit":"āَnُtāَyَḥ","root":"حيي"},{"id":6,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":7,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":8,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":9,"arabic":"بِمَبْعُوثِينَ","translit":"َnyِhtwُʿعْbَmِb","root":"بعث"}],"hasIhya":false},{"ayah":30,"text":"وَلَوْ تَرَىٰٓ إِذْ وُقِفُوا۟ عَلَىٰ رَبِّهِمْۚ قَالَ أَلَيْسَ هَٰذَا بِٱلْحَقِّۚ قَالُوا۟ بَلَىٰ وَرَبِّنَاۚ قَالَ فَذُوقُوا۟ ٱلْعَذَابَ بِمَا كُنتُمْ تَكْفُرُونَ ","translation":"If you could but see when they will be made to stand before their Lord. He will say, \"Is this not the truth?\" They will say, \"Yes, by our Lord.\" He will [then] say, \"So taste the punishment for what you used to deny.\"","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"تَرَىٰٓ","translit":"ٰٓàَrَt","root":"راي"},{"id":3,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":4,"arabic":"وُقِفُوا۟","translit":"۟āwُfِqُw","root":"وقف"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":7,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":8,"arabic":"أَلَيْسَ","translit":"َsْyَlَaʾ","root":"ليس"},{"id":9,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":10,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":11,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":12,"arabic":"بَلَىٰ","translit":"ٰàَlَb","root":""},{"id":13,"arabic":"وَرَبِّنَا","translit":"āَnِّbَrَw","root":"ربب"},{"id":14,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":15,"arabic":"فَذُوقُوا۟","translit":"۟āwُqwُhdَf","root":"ذوق"},{"id":16,"arabic":"ٱلْعَذَابَ","translit":"َbāَhdَʿعْlٱ","root":"عذب"},{"id":17,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":18,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":19,"arabic":"تَكْفُرُونَ","translit":"َnwُrُfْkَt","root":"كفر"}],"hasIhya":true},{"ayah":31,"text":"قَدْ خَسِرَ ٱلَّذِينَ كَذَّبُوا۟ بِلِقَآءِ ٱللَّهِۖ حَتَّىٰٓ إِذَا جَآءَتْهُمُ ٱلسَّاعَةُ بَغْتَةً قَالُوا۟ يَٰحَسْرَتَنَا عَلَىٰ مَا فَرَّطْنَا فِيهَا وَهُمْ يَحْمِلُونَ أَوْزَارَهُمْ عَلَىٰ ظُهُورِهِمْۚ أَلَا سَآءَ مَا يَزِرُونَ ","translation":"Those will have lost who deny the meeting with Allāh, until when the Hour [of resurrection] comes upon them unexpectedly, they will say, \"Oh, [how great is] our regret over what we neglected concerning it [i.e., the Hour],\" while they bear their burdens [i.e., sins] on their backs. Unquestionably, evil is that which they bear.","words":[{"id":1,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":2,"arabic":"خَسِرَ","translit":"َrِsَhk","root":"خسر"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":5,"arabic":"بِلِقَآءِ","translit":"ِءٓāَqِlِb","root":"لقي"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":8,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":9,"arabic":"جَآءَتْهُمُ","translit":"ُmُhْtَءٓāَjg","root":"جيا"},{"id":10,"arabic":"ٱلسَّاعَةُ","translit":"ُẗَʿعāَّslٱ","root":"سوع"},{"id":11,"arabic":"بَغْتَةً","translit":"ًẗَtْغَb","root":"بغت"},{"id":12,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":13,"arabic":"يَٰحَسْرَتَنَا","translit":"āَnَtَrْsَḥَٰy","root":"حسر"},{"id":14,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":15,"arabic":"مَا","translit":"āَm","root":""},{"id":16,"arabic":"فَرَّطْنَا","translit":"āَnْṭَّrَf","root":"فرط"},{"id":17,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":18,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":19,"arabic":"يَحْمِلُونَ","translit":"َnwُlِmْḥَy","root":"حمل"},{"id":20,"arabic":"أَوْزَارَهُمْ","translit":"ْmُhَrāَzْwَaʾ","root":"وزر"},{"id":21,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":22,"arabic":"ظُهُورِهِمْ","translit":"ْmِhِrwُhُẓ","root":"ظهر"},{"id":23,"arabic":"أَلَا","translit":"āَlَaʾ","root":""},{"id":24,"arabic":"سَآءَ","translit":"َءٓāَs","root":"سوا"},{"id":25,"arabic":"مَا","translit":"āَm","root":""},{"id":26,"arabic":"يَزِرُونَ","translit":"َnwُrِzَy","root":"وزر"}],"hasIhya":false},{"ayah":32,"text":"وَمَا ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا لَعِبٌ وَلَهْوٌۖ وَلَلدَّارُ ٱلْءَاخِرَةُ خَيْرٌ لِّلَّذِينَ يَتَّقُونَۗ أَفَلَا تَعْقِلُونَ ","translation":"And the worldly life is not but amusement and diversion; but the home of the Hereafter is best for those who fear Allāh, so will you not reason?","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"ٱلْحَيَوٰةُ","translit":"ُẗٰwَyَḥْlٱ","root":"حيي"},{"id":3,"arabic":"ٱلدُّنْيَآ","translit":"ٓāَyْnُّdlٱ","root":"دنو"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"لَعِبٌ","translit":"ٌbِʿعَl","root":"لعب"},{"id":6,"arabic":"وَلَهْوٌ","translit":"ٌwْhَlَw","root":"لهو"},{"id":7,"arabic":"وَلَلدَّارُ","translit":"ُrāَّdlَlَw","root":"دور"},{"id":8,"arabic":"ٱلْءَاخِرَةُ","translit":"ُẗَrِhkāَءْlٱ","root":"اخر"},{"id":9,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":10,"arabic":"لِّلَّذِينَ","translit":"َnyِhdَّlِّl","root":""},{"id":11,"arabic":"يَتَّقُونَ","translit":"َnwُqَّtَy","root":"وقي"},{"id":12,"arabic":"أَفَلَا","translit":"āَlَfَaʾ","root":""},{"id":13,"arabic":"تَعْقِلُونَ","translit":"َnwُlِqْʿعَt","root":"عقل"}],"hasIhya":false},{"ayah":33,"text":"قَدْ نَعْلَمُ إِنَّهُۥ لَيَحْزُنُكَ ٱلَّذِى يَقُولُونَۖ فَإِنَّهُمْ لَا يُكَذِّبُونَكَ وَلَٰكِنَّ ٱلظَّٰلِمِينَ بِـَٔايَٰتِ ٱللَّهِ يَجْحَدُونَ ","translation":"We know that you, [O Muḥammad], are saddened by what they say. And indeed, they do not call you untruthful, but it is the verses of Allāh that the wrongdoers reject.","words":[{"id":1,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":2,"arabic":"نَعْلَمُ","translit":"ُmَlْʿعَn","root":"علم"},{"id":3,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":4,"arabic":"لَيَحْزُنُكَ","translit":"َkُnُzْḥَyَl","root":"حزن"},{"id":5,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":6,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":7,"arabic":"فَإِنَّهُمْ","translit":"ْmُhَّnِiʾَf","root":""},{"id":8,"arabic":"لَا","translit":"āَl","root":""},{"id":9,"arabic":"يُكَذِّبُونَكَ","translit":"َkَnwُbِّhdَkُy","root":"كذب"},{"id":10,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":11,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":12,"arabic":"بِـَٔايَٰتِ","translit":"ِtَٰyāَٔـِb","root":"ايي"},{"id":13,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":14,"arabic":"يَجْحَدُونَ","translit":"َnwُdَḥْjgَy","root":"جحد"}],"hasIhya":false},{"ayah":34,"text":"وَلَقَدْ كُذِّبَتْ رُسُلٌ مِّن قَبْلِكَ فَصَبَرُوا۟ عَلَىٰ مَا كُذِّبُوا۟ وَأُوذُوا۟ حَتَّىٰٓ أَتَىٰهُمْ نَصْرُنَاۚ وَلَا مُبَدِّلَ لِكَلِمَٰتِ ٱللَّهِۚ وَلَقَدْ جَآءَكَ مِن نَّبَإِى۟ ٱلْمُرْسَلِينَ ","translation":"And certainly were messengers denied before you, but they were patient over the denial, and they were harmed until Our victory came to them. And none can alter the words [i.e., decrees] of Allāh. And there has certainly come to you some information about the [previous] messengers.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"كُذِّبَتْ","translit":"ْtَbِّhdُk","root":"كذب"},{"id":3,"arabic":"رُسُلٌ","translit":"ٌlُsُr","root":"رسل"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":6,"arabic":"فَصَبَرُوا۟","translit":"۟āwُrَbَṣَf","root":"صبر"},{"id":7,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":8,"arabic":"مَا","translit":"āَm","root":""},{"id":9,"arabic":"كُذِّبُوا۟","translit":"۟āwُbِّhdُk","root":"كذب"},{"id":10,"arabic":"وَأُوذُوا۟","translit":"۟āwُhdwُaʾَw","root":"اذي"},{"id":11,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":12,"arabic":"أَتَىٰهُمْ","translit":"ْmُhٰàَtَaʾ","root":"اتي"},{"id":13,"arabic":"نَصْرُنَا","translit":"āَnُrْṣَn","root":"نصر"},{"id":14,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":15,"arabic":"مُبَدِّلَ","translit":"َlِّdَbُm","root":"بدل"},{"id":16,"arabic":"لِكَلِمَٰتِ","translit":"ِtَٰmِlَkِl","root":"كلم"},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":19,"arabic":"جَآءَكَ","translit":"َkَءٓāَjg","root":"جيا"},{"id":20,"arabic":"مِن","translit":"nِm","root":""},{"id":21,"arabic":"نَّبَإِى۟","translit":"۟àِiʾَbَّn","root":"نبا"},{"id":22,"arabic":"ٱلْمُرْسَلِينَ","translit":"َnyِlَsْrُmْlٱ","root":"رسل"}],"hasIhya":false},{"ayah":35,"text":"وَإِن كَانَ كَبُرَ عَلَيْكَ إِعْرَاضُهُمْ فَإِنِ ٱسْتَطَعْتَ أَن تَبْتَغِىَ نَفَقًا فِى ٱلْأَرْضِ أَوْ سُلَّمًا فِى ٱلسَّمَآءِ فَتَأْتِيَهُم بِـَٔايَةٍۚ وَلَوْ شَآءَ ٱللَّهُ لَجَمَعَهُمْ عَلَى ٱلْهُدَىٰۚ فَلَا تَكُونَنَّ مِنَ ٱلْجَٰهِلِينَ ","translation":"And if their evasion is difficult for you, then if you are able to seek a tunnel into the earth or a stairway into the sky to bring them a sign, [then do so]. But if Allāh had willed, He would have united them upon guidance. So never be of the ignorant.","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"كَبُرَ","translit":"َrُbَk","root":"كبر"},{"id":4,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":5,"arabic":"إِعْرَاضُهُمْ","translit":"ْmُhُḍāَrْʿعِiʾ","root":"عرض"},{"id":6,"arabic":"فَإِنِ","translit":"ِnِiʾَf","root":""},{"id":7,"arabic":"ٱسْتَطَعْتَ","translit":"َtْʿعَṭَtْsٱ","root":"طوع"},{"id":8,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":9,"arabic":"تَبْتَغِىَ","translit":"َàِغَtْbَt","root":"بغي"},{"id":10,"arabic":"نَفَقًا","translit":"āًqَfَn","root":"نفق"},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":13,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":14,"arabic":"سُلَّمًا","translit":"āًmَّlُs","root":"سلم"},{"id":15,"arabic":"فِى","translit":"àِf","root":""},{"id":16,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":17,"arabic":"فَتَأْتِيَهُم","translit":"mُhَyِtْaʾَtَf","root":"اتي"},{"id":18,"arabic":"بِـَٔايَةٍ","translit":"ٍẗَyāَٔـِb","root":"ايي"},{"id":19,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":20,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":21,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":22,"arabic":"لَجَمَعَهُمْ","translit":"ْmُhَʿعَmَjgَl","root":"جمع"},{"id":23,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":24,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":25,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":26,"arabic":"تَكُونَنَّ","translit":"َّnَnwُkَt","root":"كون"},{"id":27,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":28,"arabic":"ٱلْجَٰهِلِينَ","translit":"َnyِlِhَٰjgْlٱ","root":"جهل"}],"hasIhya":false},{"ayah":36,"text":"إِنَّمَا يَسْتَجِيبُ ٱلَّذِينَ يَسْمَعُونَۘ وَٱلْمَوْتَىٰ يَبْعَثُهُمُ ٱللَّهُ ثُمَّ إِلَيْهِ يُرْجَعُونَ ","translation":"Only those who hear will respond. But the dead[1] - Allāh will resurrect them; then to Him they will be returned.","words":[{"id":1,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":2,"arabic":"يَسْتَجِيبُ","translit":"ُbyِjgَtْsَy","root":"جوب"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"يَسْمَعُونَ","translit":"َnwُʿعَmْsَy","root":"سمع"},{"id":5,"arabic":"وَٱلْمَوْتَىٰ","translit":"ٰàَtْwَmْlٱَw","root":"موت"},{"id":6,"arabic":"يَبْعَثُهُمُ","translit":"ُmُhُhtَʿعْbَy","root":"بعث"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":9,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":10,"arabic":"يُرْجَعُونَ","translit":"َnwُʿعَjgْrُy","root":"رجع"}],"hasIhya":false},{"ayah":37,"text":"وَقَالُوا۟ لَوْلَا نُزِّلَ عَلَيْهِ ءَايَةٌ مِّن رَّبِّهِۦۚ قُلْ إِنَّ ٱللَّهَ قَادِرٌ عَلَىٰٓ أَن يُنَزِّلَ ءَايَةً وَلَٰكِنَّ أَكْثَرَهُمْ لَا يَعْلَمُونَ ","translation":"And they say, \"Why has a sign not been sent down to him from his Lord?\" Say, \"Indeed, Allāh is Able to send down a sign, but most of them do not know.\"","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"لَوْلَا","translit":"āَlْwَl","root":""},{"id":3,"arabic":"نُزِّلَ","translit":"َlِّzُn","root":"نزل"},{"id":4,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":5,"arabic":"ءَايَةٌ","translit":"ٌẗَyāَء","root":"ايي"},{"id":6,"arabic":"مِّن","translit":"nِّm","root":""},{"id":7,"arabic":"رَّبِّهِۦ","translit":"ۦِhِّbَّr","root":"ربب"},{"id":8,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":9,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":10,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":11,"arabic":"قَادِرٌ","translit":"ٌrِdāَq","root":"قدر"},{"id":12,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":13,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":14,"arabic":"يُنَزِّلَ","translit":"َlِّzَnُy","root":"نزل"},{"id":15,"arabic":"ءَايَةً","translit":"ًẗَyāَء","root":"ايي"},{"id":16,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":17,"arabic":"أَكْثَرَهُمْ","translit":"ْmُhَrَhtْkَaʾ","root":"كثر"},{"id":18,"arabic":"لَا","translit":"āَl","root":""},{"id":19,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":38,"text":"وَمَا مِن دَآبَّةٍ فِى ٱلْأَرْضِ وَلَا طَٰٓئِرٍ يَطِيرُ بِجَنَاحَيْهِ إِلَّآ أُمَمٌ أَمْثَالُكُمۚ مَّا فَرَّطْنَا فِى ٱلْكِتَٰبِ مِن شَىْءٍۚ ثُمَّ إِلَىٰ رَبِّهِمْ يُحْشَرُونَ ","translation":"And there is no creature on [or within] the earth or bird that flies with its wings except [that they are] communities like you. We have not neglected in the Register[1] a thing. Then unto their Lord they will be gathered.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"مِن","translit":"nِm","root":""},{"id":3,"arabic":"دَآبَّةٍ","translit":"ٍẗَّbٓāَd","root":"دبب"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"طَٰٓئِرٍ","translit":"ٍrِyʾَٰٓṭ","root":"طير"},{"id":8,"arabic":"يَطِيرُ","translit":"ُryِṭَy","root":"طير"},{"id":9,"arabic":"بِجَنَاحَيْهِ","translit":"ِhْyَḥāَnَjgِb","root":"جنح"},{"id":10,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":11,"arabic":"أُمَمٌ","translit":"ٌmَmُaʾ","root":"امم"},{"id":12,"arabic":"أَمْثَالُكُم","translit":"mُkُlāَhtْmَaʾ","root":"مثل"},{"id":13,"arabic":"مَّا","translit":"āَّm","root":""},{"id":14,"arabic":"فَرَّطْنَا","translit":"āَnْṭَّrَf","root":"فرط"},{"id":15,"arabic":"فِى","translit":"àِf","root":""},{"id":16,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":17,"arabic":"مِن","translit":"nِm","root":""},{"id":18,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":19,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":20,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":21,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":22,"arabic":"يُحْشَرُونَ","translit":"َnwُrَhsْḥُy","root":"حشر"}],"hasIhya":true},{"ayah":39,"text":"وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا صُمٌّ وَبُكْمٌ فِى ٱلظُّلُمَٰتِۗ مَن يَشَإِ ٱللَّهُ يُضْلِلْهُ وَمَن يَشَأْ يَجْعَلْهُ عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ","translation":"But those who deny Our verses are deaf and dumb within darknesses. Whomever Allāh wills - He sends astray; and whomever He wills - He puts him on a straight path.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":3,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":4,"arabic":"صُمٌّ","translit":"ٌّmُṣ","root":"صمم"},{"id":5,"arabic":"وَبُكْمٌ","translit":"ٌmْkُbَw","root":"بكم"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلظُّلُمَٰتِ","translit":"ِtَٰmُlُّẓlٱ","root":"ظلم"},{"id":8,"arabic":"مَن","translit":"nَm","root":""},{"id":9,"arabic":"يَشَإِ","translit":"ِiʾَhsَy","root":"شيا"},{"id":10,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":11,"arabic":"يُضْلِلْهُ","translit":"ُhْlِlْḍُy","root":"ضلل"},{"id":12,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":13,"arabic":"يَشَأْ","translit":"ْaʾَhsَy","root":"شيا"},{"id":14,"arabic":"يَجْعَلْهُ","translit":"ُhْlَʿعْjgَy","root":"جعل"},{"id":15,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":16,"arabic":"صِرَٰطٍ","translit":"ٍṭَٰrِṣ","root":"صرط"},{"id":17,"arabic":"مُّسْتَقِيمٍ","translit":"ٍmyِqَtْsُّm","root":"قوم"}],"hasIhya":false},{"ayah":40,"text":"قُلْ أَرَءَيْتَكُمْ إِنْ أَتَىٰكُمْ عَذَابُ ٱللَّهِ أَوْ أَتَتْكُمُ ٱلسَّاعَةُ أَغَيْرَ ٱللَّهِ تَدْعُونَ إِن كُنتُمْ صَٰدِقِينَ ","translation":"Say, \"Have you considered:[1] if there came to you the punishment of Allāh or there came to you the Hour - is it other than Allāh you would invoke, if you should be truthful?\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أَرَءَيْتَكُمْ","translit":"ْmُkَtْyَءَrَaʾ","root":"راي"},{"id":3,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":4,"arabic":"أَتَىٰكُمْ","translit":"ْmُkٰàَtَaʾ","root":"اتي"},{"id":5,"arabic":"عَذَابُ","translit":"ُbāَhdَʿع","root":"عذب"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":8,"arabic":"أَتَتْكُمُ","translit":"ُmُkْtَtَaʾ","root":"اتي"},{"id":9,"arabic":"ٱلسَّاعَةُ","translit":"ُẗَʿعāَّslٱ","root":"سوع"},{"id":10,"arabic":"أَغَيْرَ","translit":"َrْyَغَaʾ","root":"غير"},{"id":11,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":12,"arabic":"تَدْعُونَ","translit":"َnwُʿعْdَt","root":"دعو"},{"id":13,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":14,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":15,"arabic":"صَٰدِقِينَ","translit":"َnyِqِdَٰṣ","root":"صدق"}],"hasIhya":false},{"ayah":41,"text":"بَلْ إِيَّاهُ تَدْعُونَ فَيَكْشِفُ مَا تَدْعُونَ إِلَيْهِ إِن شَآءَ وَتَنسَوْنَ مَا تُشْرِكُونَ ","translation":"No, it is Him [alone] you would invoke, and He would remove that for which you invoked Him if He willed, and you would forget what you associate [with Him].","words":[{"id":1,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":2,"arabic":"إِيَّاهُ","translit":"ُhāَّyِiʾ","root":""},{"id":3,"arabic":"تَدْعُونَ","translit":"َnwُʿعْdَt","root":"دعو"},{"id":4,"arabic":"فَيَكْشِفُ","translit":"ُfِhsْkَyَf","root":"كشف"},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"تَدْعُونَ","translit":"َnwُʿعْdَt","root":"دعو"},{"id":7,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":8,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":9,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":10,"arabic":"وَتَنسَوْنَ","translit":"َnْwَsnَtَw","root":"نسي"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"تُشْرِكُونَ","translit":"َnwُkِrْhsُt","root":"شرك"}],"hasIhya":true},{"ayah":42,"text":"وَلَقَدْ أَرْسَلْنَآ إِلَىٰٓ أُمَمٍ مِّن قَبْلِكَ فَأَخَذْنَٰهُم بِٱلْبَأْسَآءِ وَٱلضَّرَّآءِ لَعَلَّهُمْ يَتَضَرَّعُونَ ","translation":"And We have already sent [messengers] to nations before you, [O Muḥammad]; then We seized them with poverty and hardship that perhaps they might humble themselves [to Us].","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"أَرْسَلْنَآ","translit":"ٓāَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":4,"arabic":"أُمَمٍ","translit":"ٍmَmُaʾ","root":"امم"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":7,"arabic":"فَأَخَذْنَٰهُم","translit":"mُhَٰnْhdَhkَaʾَf","root":"اخذ"},{"id":8,"arabic":"بِٱلْبَأْسَآءِ","translit":"ِءٓāَsْaʾَbْlٱِb","root":"باس"},{"id":9,"arabic":"وَٱلضَّرَّآءِ","translit":"ِءٓāَّrَّḍlٱَw","root":"ضرر"},{"id":10,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":11,"arabic":"يَتَضَرَّعُونَ","translit":"َnwُʿعَّrَḍَtَy","root":"ضرع"}],"hasIhya":false},{"ayah":43,"text":"فَلَوْلَآ إِذْ جَآءَهُم بَأْسُنَا تَضَرَّعُوا۟ وَلَٰكِن قَسَتْ قُلُوبُهُمْ وَزَيَّنَ لَهُمُ ٱلشَّيْطَٰنُ مَا كَانُوا۟ يَعْمَلُونَ ","translation":"Then why, when Our punishment came to them, did they not humble themselves? But their hearts became hardened, and Satan made attractive to them that which they were doing.","words":[{"id":1,"arabic":"فَلَوْلَآ","translit":"ٓāَlْwَlَf","root":""},{"id":2,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":3,"arabic":"جَآءَهُم","translit":"mُhَءٓāَjg","root":"جيا"},{"id":4,"arabic":"بَأْسُنَا","translit":"āَnُsْaʾَb","root":"باس"},{"id":5,"arabic":"تَضَرَّعُوا۟","translit":"۟āwُʿعَّrَḍَt","root":"ضرع"},{"id":6,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":7,"arabic":"قَسَتْ","translit":"ْtَsَq","root":"قسو"},{"id":8,"arabic":"قُلُوبُهُمْ","translit":"ْmُhُbwُlُq","root":"قلب"},{"id":9,"arabic":"وَزَيَّنَ","translit":"َnَّyَzَw","root":"زين"},{"id":10,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":11,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":12,"arabic":"مَا","translit":"āَm","root":""},{"id":13,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":14,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":44,"text":"فَلَمَّا نَسُوا۟ مَا ذُكِّرُوا۟ بِهِۦ فَتَحْنَا عَلَيْهِمْ أَبْوَٰبَ كُلِّ شَىْءٍ حَتَّىٰٓ إِذَا فَرِحُوا۟ بِمَآ أُوتُوٓا۟ أَخَذْنَٰهُم بَغْتَةً فَإِذَا هُم مُّبْلِسُونَ ","translation":"So when they forgot that by which they had been reminded,[1] We opened to them the doors of every [good] thing until, when they rejoiced in that which they were given, We seized them suddenly, and they were [then] in despair.","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"نَسُوا۟","translit":"۟āwُsَn","root":"نسي"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"ذُكِّرُوا۟","translit":"۟āwُrِّkُhd","root":"ذكر"},{"id":5,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":6,"arabic":"فَتَحْنَا","translit":"āَnْḥَtَf","root":"فتح"},{"id":7,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":8,"arabic":"أَبْوَٰبَ","translit":"َbَٰwْbَaʾ","root":"بوب"},{"id":9,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":10,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":11,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":12,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":13,"arabic":"فَرِحُوا۟","translit":"۟āwُḥِrَf","root":"فرح"},{"id":14,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":15,"arabic":"أُوتُوٓا۟","translit":"۟āٓwُtwُaʾ","root":"اتي"},{"id":16,"arabic":"أَخَذْنَٰهُم","translit":"mُhَٰnْhdَhkَaʾ","root":"اخذ"},{"id":17,"arabic":"بَغْتَةً","translit":"ًẗَtْغَb","root":"بغت"},{"id":18,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":19,"arabic":"هُم","translit":"mُh","root":""},{"id":20,"arabic":"مُّبْلِسُونَ","translit":"َnwُsِlْbُّm","root":"بلس"}],"hasIhya":true},{"ayah":45,"text":"فَقُطِعَ دَابِرُ ٱلْقَوْمِ ٱلَّذِينَ ظَلَمُوا۟ۚ وَٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ ","translation":"So the people that committed wrong were eliminated. And praise to Allāh, Lord of the worlds.","words":[{"id":1,"arabic":"فَقُطِعَ","translit":"َʿعِṭُqَf","root":"قطع"},{"id":2,"arabic":"دَابِرُ","translit":"ُrِbāَd","root":"دبر"},{"id":3,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"ظَلَمُوا۟","translit":"۟āwُmَlَẓ","root":"ظلم"},{"id":6,"arabic":"وَٱلْحَمْدُ","translit":"ُdْmَḥْlٱَw","root":"حمد"},{"id":7,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":8,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":9,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":46,"text":"قُلْ أَرَءَيْتُمْ إِنْ أَخَذَ ٱللَّهُ سَمْعَكُمْ وَأَبْصَٰرَكُمْ وَخَتَمَ عَلَىٰ قُلُوبِكُم مَّنْ إِلَٰهٌ غَيْرُ ٱللَّهِ يَأْتِيكُم بِهِۗ ٱنظُرْ كَيْفَ نُصَرِّفُ ٱلْءَايَٰتِ ثُمَّ هُمْ يَصْدِفُونَ ","translation":"Say, \"Have you considered:[1] if Allāh should take away your hearing and your sight and set a seal upon your hearts, which deity other than Allāh could bring them [back] to you?\" Look how We diversify[2] the verses; then they [still] turn away.","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أَرَءَيْتُمْ","translit":"ْmُtْyَءَrَaʾ","root":"راي"},{"id":3,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":4,"arabic":"أَخَذَ","translit":"َhdَhkَaʾ","root":"اخذ"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"سَمْعَكُمْ","translit":"ْmُkَʿعْmَs","root":"سمع"},{"id":7,"arabic":"وَأَبْصَٰرَكُمْ","translit":"ْmُkَrَٰṣْbَaʾَw","root":"بصر"},{"id":8,"arabic":"وَخَتَمَ","translit":"َmَtَhkَw","root":"ختم"},{"id":9,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":10,"arabic":"قُلُوبِكُم","translit":"mُkِbwُlُq","root":"قلب"},{"id":11,"arabic":"مَّنْ","translit":"ْnَّm","root":""},{"id":12,"arabic":"إِلَٰهٌ","translit":"ٌhَٰlِiʾ","root":"اله"},{"id":13,"arabic":"غَيْرُ","translit":"ُrْyَغ","root":"غير"},{"id":14,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":15,"arabic":"يَأْتِيكُم","translit":"mُkyِtْaʾَy","root":"اتي"},{"id":16,"arabic":"بِهِ","translit":"ِhِb","root":""},{"id":17,"arabic":"ٱنظُرْ","translit":"ْrُẓnٱ","root":"نظر"},{"id":18,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":19,"arabic":"نُصَرِّفُ","translit":"ُfِّrَṣُn","root":"صرف"},{"id":20,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":21,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":22,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":23,"arabic":"يَصْدِفُونَ","translit":"َnwُfِdْṣَy","root":"صدف"}],"hasIhya":true},{"ayah":47,"text":"قُلْ أَرَءَيْتَكُمْ إِنْ أَتَىٰكُمْ عَذَابُ ٱللَّهِ بَغْتَةً أَوْ جَهْرَةً هَلْ يُهْلَكُ إِلَّا ٱلْقَوْمُ ٱلظَّٰلِمُونَ ","translation":"Say, \"Have you considered: if the punishment of Allāh should come to you unexpectedly or manifestly,[1] will any be destroyed but the wrongdoing people?\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أَرَءَيْتَكُمْ","translit":"ْmُkَtْyَءَrَaʾ","root":"راي"},{"id":3,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":4,"arabic":"أَتَىٰكُمْ","translit":"ْmُkٰàَtَaʾ","root":"اتي"},{"id":5,"arabic":"عَذَابُ","translit":"ُbāَhdَʿع","root":"عذب"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"بَغْتَةً","translit":"ًẗَtْغَb","root":"بغت"},{"id":8,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":9,"arabic":"جَهْرَةً","translit":"ًẗَrْhَjg","root":"جهر"},{"id":10,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":11,"arabic":"يُهْلَكُ","translit":"ُkَlْhُy","root":"هلك"},{"id":12,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":13,"arabic":"ٱلْقَوْمُ","translit":"ُmْwَqْlٱ","root":"قوم"},{"id":14,"arabic":"ٱلظَّٰلِمُونَ","translit":"َnwُmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":false},{"ayah":48,"text":"وَمَا نُرْسِلُ ٱلْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ وَمُنذِرِينَۖ فَمَنْ ءَامَنَ وَأَصْلَحَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ","translation":"And We send not the messengers except as bringers of good tidings and warners. So whoever believes and reforms - there will be no fear concerning them, nor will they grieve.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"نُرْسِلُ","translit":"ُlِsْrُn","root":"رسل"},{"id":3,"arabic":"ٱلْمُرْسَلِينَ","translit":"َnyِlَsْrُmْlٱ","root":"رسل"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"مُبَشِّرِينَ","translit":"َnyِrِّhsَbُm","root":"بشر"},{"id":6,"arabic":"وَمُنذِرِينَ","translit":"َnyِrِhdnُmَw","root":"نذر"},{"id":7,"arabic":"فَمَنْ","translit":"ْnَmَf","root":""},{"id":8,"arabic":"ءَامَنَ","translit":"َnَmāَء","root":"امن"},{"id":9,"arabic":"وَأَصْلَحَ","translit":"َḥَlْṣَaʾَw","root":"صلح"},{"id":10,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":11,"arabic":"خَوْفٌ","translit":"ٌfْwَhk","root":"خوف"},{"id":12,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":13,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":14,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":15,"arabic":"يَحْزَنُونَ","translit":"َnwُnَzْḥَy","root":"حزن"}],"hasIhya":false},{"ayah":49,"text":"وَٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا يَمَسُّهُمُ ٱلْعَذَابُ بِمَا كَانُوا۟ يَفْسُقُونَ ","translation":"But those who deny Our verses - the punishment will touch[1] them for their defiant disobedience.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":3,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":4,"arabic":"يَمَسُّهُمُ","translit":"ُmُhُّsَmَy","root":"مسس"},{"id":5,"arabic":"ٱلْعَذَابُ","translit":"ُbāَhdَʿعْlٱ","root":"عذب"},{"id":6,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":7,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":8,"arabic":"يَفْسُقُونَ","translit":"َnwُqُsْfَy","root":"فسق"}],"hasIhya":false},{"ayah":50,"text":"قُل لَّآ أَقُولُ لَكُمْ عِندِى خَزَآئِنُ ٱللَّهِ وَلَآ أَعْلَمُ ٱلْغَيْبَ وَلَآ أَقُولُ لَكُمْ إِنِّى مَلَكٌۖ إِنْ أَتَّبِعُ إِلَّا مَا يُوحَىٰٓ إِلَىَّۚ قُلْ هَلْ يَسْتَوِى ٱلْأَعْمَىٰ وَٱلْبَصِيرُۚ أَفَلَا تَتَفَكَّرُونَ ","translation":"Say, [O Muḥammad], \"I do not tell you that I have the depositories [containing the provision] of Allāh or that I know the unseen, nor do I tell you that I am an angel. I only follow what is revealed to me.\" Say, \"Is the blind equivalent to the seeing? Then will you not give thought?\"","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لَّآ","translit":"ٓāَّl","root":""},{"id":3,"arabic":"أَقُولُ","translit":"ُlwُqَaʾ","root":"قول"},{"id":4,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":5,"arabic":"عِندِى","translit":"àِdnِʿع","root":"عند"},{"id":6,"arabic":"خَزَآئِنُ","translit":"ُnِyʾٓāَzَhk","root":"خزن"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":9,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":10,"arabic":"ٱلْغَيْبَ","translit":"َbْyَغْlٱ","root":"غيب"},{"id":11,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":12,"arabic":"أَقُولُ","translit":"ُlwُqَaʾ","root":"قول"},{"id":13,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":14,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":15,"arabic":"مَلَكٌ","translit":"ٌkَlَm","root":"ملك"},{"id":16,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":17,"arabic":"أَتَّبِعُ","translit":"ُʿعِbَّtَaʾ","root":"تبع"},{"id":18,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":19,"arabic":"مَا","translit":"āَm","root":""},{"id":20,"arabic":"يُوحَىٰٓ","translit":"ٰٓàَḥwُy","root":"وحي"},{"id":21,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":22,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":23,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":24,"arabic":"يَسْتَوِى","translit":"àِwَtْsَy","root":"سوي"},{"id":25,"arabic":"ٱلْأَعْمَىٰ","translit":"ٰàَmْʿعَaʾْlٱ","root":"عمي"},{"id":26,"arabic":"وَٱلْبَصِيرُ","translit":"ُryِṣَbْlٱَw","root":"بصر"},{"id":27,"arabic":"أَفَلَا","translit":"āَlَfَaʾ","root":""},{"id":28,"arabic":"تَتَفَكَّرُونَ","translit":"َnwُrَّkَfَtَt","root":"فكر"}],"hasIhya":false},{"ayah":51,"text":"وَأَنذِرْ بِهِ ٱلَّذِينَ يَخَافُونَ أَن يُحْشَرُوٓا۟ إِلَىٰ رَبِّهِمْۙ لَيْسَ لَهُم مِّن دُونِهِۦ وَلِىٌّ وَلَا شَفِيعٌ لَّعَلَّهُمْ يَتَّقُونَ ","translation":"And warn by it [i.e., the Qur’ān] those who fear that they will be gathered before their Lord - for them besides Him will be no protector and no intercessor - that they might become righteous.","words":[{"id":1,"arabic":"وَأَنذِرْ","translit":"ْrِhdnَaʾَw","root":"نذر"},{"id":2,"arabic":"بِهِ","translit":"ِhِb","root":""},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"يَخَافُونَ","translit":"َnwُfāَhkَy","root":"خوف"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"يُحْشَرُوٓا۟","translit":"۟āٓwُrَhsْḥُy","root":"حشر"},{"id":7,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":8,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":9,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":10,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":11,"arabic":"مِّن","translit":"nِّm","root":""},{"id":12,"arabic":"دُونِهِۦ","translit":"ۦِhِnwُd","root":"دون"},{"id":13,"arabic":"وَلِىٌّ","translit":"ٌّàِlَw","root":"ولي"},{"id":14,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":15,"arabic":"شَفِيعٌ","translit":"ٌʿعyِfَhs","root":"شفع"},{"id":16,"arabic":"لَّعَلَّهُمْ","translit":"ْmُhَّlَʿعَّl","root":""},{"id":17,"arabic":"يَتَّقُونَ","translit":"َnwُqَّtَy","root":"وقي"}],"hasIhya":false},{"ayah":52,"text":"وَلَا تَطْرُدِ ٱلَّذِينَ يَدْعُونَ رَبَّهُم بِٱلْغَدَوٰةِ وَٱلْعَشِىِّ يُرِيدُونَ وَجْهَهُۥۖ مَا عَلَيْكَ مِنْ حِسَابِهِم مِّن شَىْءٍ وَمَا مِنْ حِسَابِكَ عَلَيْهِم مِّن شَىْءٍ فَتَطْرُدَهُمْ فَتَكُونَ مِنَ ٱلظَّٰلِمِينَ ","translation":"And do not send away those who call upon their Lord morning and afternoon, seeking His face [i.e., favor]. Not upon you is anything of their account and not upon them is anything of your account.[1] So were you to send them away, you would [then] be of the wrongdoers.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَطْرُدِ","translit":"ِdُrْṭَt","root":"طرد"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"يَدْعُونَ","translit":"َnwُʿعْdَy","root":"دعو"},{"id":5,"arabic":"رَبَّهُم","translit":"mُhَّbَr","root":"ربب"},{"id":6,"arabic":"بِٱلْغَدَوٰةِ","translit":"ِẗٰwَdَغْlٱِb","root":"غدو"},{"id":7,"arabic":"وَٱلْعَشِىِّ","translit":"ِّàِhsَʿعْlٱَw","root":"عشو"},{"id":8,"arabic":"يُرِيدُونَ","translit":"َnwُdyِrُy","root":"رود"},{"id":9,"arabic":"وَجْهَهُۥ","translit":"ۥُhَhْjgَw","root":"وجه"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":12,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":13,"arabic":"حِسَابِهِم","translit":"mِhِbāَsِḥ","root":"حسب"},{"id":14,"arabic":"مِّن","translit":"nِّm","root":""},{"id":15,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":16,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":17,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":18,"arabic":"حِسَابِكَ","translit":"َkِbāَsِḥ","root":"حسب"},{"id":19,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":20,"arabic":"مِّن","translit":"nِّm","root":""},{"id":21,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":22,"arabic":"فَتَطْرُدَهُمْ","translit":"ْmُhَdُrْṭَtَf","root":"طرد"},{"id":23,"arabic":"فَتَكُونَ","translit":"َnwُkَtَf","root":"كون"},{"id":24,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":25,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":true},{"ayah":53,"text":"وَكَذَٰلِكَ فَتَنَّا بَعْضَهُم بِبَعْضٍ لِّيَقُولُوٓا۟ أَهَٰٓؤُلَآءِ مَنَّ ٱللَّهُ عَلَيْهِم مِّنۢ بَيْنِنَآۗ أَلَيْسَ ٱللَّهُ بِأَعْلَمَ بِٱلشَّٰكِرِينَ ","translation":"And thus We have tried some of them through others that they [i.e., the disbelievers] might say, \"Is it these whom Allāh has favored among us?\" Is not Allāh most knowing of those who are grateful?[1]","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"فَتَنَّا","translit":"āَّnَtَf","root":"فتن"},{"id":3,"arabic":"بَعْضَهُم","translit":"mُhَḍْʿعَb","root":"بعض"},{"id":4,"arabic":"بِبَعْضٍ","translit":"ٍḍْʿعَbِb","root":"بعض"},{"id":5,"arabic":"لِّيَقُولُوٓا۟","translit":"۟āٓwُlwُqَyِّl","root":"قول"},{"id":6,"arabic":"أَهَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓhَaʾ","root":""},{"id":7,"arabic":"مَنَّ","translit":"َّnَm","root":"منن"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":10,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":11,"arabic":"بَيْنِنَآ","translit":"ٓāَnِnْyَb","root":"بين"},{"id":12,"arabic":"أَلَيْسَ","translit":"َsْyَlَaʾ","root":"ليس"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"بِأَعْلَمَ","translit":"َmَlْʿعَaʾِb","root":"علم"},{"id":15,"arabic":"بِٱلشَّٰكِرِينَ","translit":"َnyِrِkَّٰhslٱِb","root":"شكر"}],"hasIhya":true},{"ayah":54,"text":"وَإِذَا جَآءَكَ ٱلَّذِينَ يُؤْمِنُونَ بِـَٔايَٰتِنَا فَقُلْ سَلَٰمٌ عَلَيْكُمْۖ كَتَبَ رَبُّكُمْ عَلَىٰ نَفْسِهِ ٱلرَّحْمَةَۖ أَنَّهُۥ مَنْ عَمِلَ مِنكُمْ سُوٓءًۢا بِجَهَٰلَةٍ ثُمَّ تَابَ مِنۢ بَعْدِهِۦ وَأَصْلَحَ فَأَنَّهُۥ غَفُورٌ رَّحِيمٌ ","translation":"And when those come to you who believe in Our verses, say, \"Peace be upon you. Your Lord has decreed upon Himself mercy: that any of you who does wrong out of ignorance and then repents after that and corrects himself - indeed, He is Forgiving and Merciful.\"","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"جَآءَكَ","translit":"َkَءٓāَjg","root":"جيا"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":5,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":6,"arabic":"فَقُلْ","translit":"ْlُqَf","root":"قول"},{"id":7,"arabic":"سَلَٰمٌ","translit":"ٌmَٰlَs","root":"سلم"},{"id":8,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":9,"arabic":"كَتَبَ","translit":"َbَtَk","root":"كتب"},{"id":10,"arabic":"رَبُّكُمْ","translit":"ْmُkُّbَr","root":"ربب"},{"id":11,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":12,"arabic":"نَفْسِهِ","translit":"ِhِsْfَn","root":"نفس"},{"id":13,"arabic":"ٱلرَّحْمَةَ","translit":"َẗَmْḥَّrlٱ","root":"رحم"},{"id":14,"arabic":"أَنَّهُۥ","translit":"ۥُhَّnَaʾ","root":""},{"id":15,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":16,"arabic":"عَمِلَ","translit":"َlِmَʿع","root":"عمل"},{"id":17,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":18,"arabic":"سُوٓءًۢا","translit":"āًۢءٓwُs","root":"سوا"},{"id":19,"arabic":"بِجَهَٰلَةٍ","translit":"ٍẗَlَٰhَjgِb","root":"جهل"},{"id":20,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":21,"arabic":"تَابَ","translit":"َbāَt","root":"توب"},{"id":22,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":23,"arabic":"بَعْدِهِۦ","translit":"ۦِhِdْʿعَb","root":"بعد"},{"id":24,"arabic":"وَأَصْلَحَ","translit":"َḥَlْṣَaʾَw","root":"صلح"},{"id":25,"arabic":"فَأَنَّهُۥ","translit":"ۥُhَّnَaʾَf","root":""},{"id":26,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":27,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":55,"text":"وَكَذَٰلِكَ نُفَصِّلُ ٱلْءَايَٰتِ وَلِتَسْتَبِينَ سَبِيلُ ٱلْمُجْرِمِينَ ","translation":"And thus do We detail the verses, and [thus] the way of the criminals will become evident.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"نُفَصِّلُ","translit":"ُlِّṣَfُn","root":"فصل"},{"id":3,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":4,"arabic":"وَلِتَسْتَبِينَ","translit":"َnyِbَtْsَtِlَw","root":"بين"},{"id":5,"arabic":"سَبِيلُ","translit":"ُlyِbَs","root":"سبل"},{"id":6,"arabic":"ٱلْمُجْرِمِينَ","translit":"َnyِmِrْjgُmْlٱ","root":"جرم"}],"hasIhya":false},{"ayah":56,"text":"قُلْ إِنِّى نُهِيتُ أَنْ أَعْبُدَ ٱلَّذِينَ تَدْعُونَ مِن دُونِ ٱللَّهِۚ قُل لَّآ أَتَّبِعُ أَهْوَآءَكُمْۙ قَدْ ضَلَلْتُ إِذًا وَمَآ أَنَا۠ مِنَ ٱلْمُهْتَدِينَ ","translation":"Say, \"Indeed, I have been forbidden to worship those you invoke besides Allāh.\" Say, \"I will not follow your desires, for I would then have gone astray, and I would not be of the [rightly] guided.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":3,"arabic":"نُهِيتُ","translit":"ُtyِhُn","root":"نهي"},{"id":4,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":5,"arabic":"أَعْبُدَ","translit":"َdُbْʿعَaʾ","root":"عبد"},{"id":6,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":7,"arabic":"تَدْعُونَ","translit":"َnwُʿعْdَt","root":"دعو"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":12,"arabic":"لَّآ","translit":"ٓāَّl","root":""},{"id":13,"arabic":"أَتَّبِعُ","translit":"ُʿعِbَّtَaʾ","root":"تبع"},{"id":14,"arabic":"أَهْوَآءَكُمْ","translit":"ْmُkَءٓāَwْhَaʾ","root":"هوي"},{"id":15,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":16,"arabic":"ضَلَلْتُ","translit":"ُtْlَlَḍ","root":"ضلل"},{"id":17,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":18,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":19,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":20,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":21,"arabic":"ٱلْمُهْتَدِينَ","translit":"َnyِdَtْhُmْlٱ","root":"هدي"}],"hasIhya":false},{"ayah":57,"text":"قُلْ إِنِّى عَلَىٰ بَيِّنَةٍ مِّن رَّبِّى وَكَذَّبْتُم بِهِۦۚ مَا عِندِى مَا تَسْتَعْجِلُونَ بِهِۦٓۚ إِنِ ٱلْحُكْمُ إِلَّا لِلَّهِۖ يَقُصُّ ٱلْحَقَّۖ وَهُوَ خَيْرُ ٱلْفَٰصِلِينَ ","translation":"Say, \"Indeed, I am on clear evidence from my Lord, and you have denied it. I do not have that for which you are impatient.[1] The decision is only for Allāh. He relates the truth, and He is the best of deciders.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"بَيِّنَةٍ","translit":"ٍẗَnِّyَb","root":"بين"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"رَّبِّى","translit":"àِّbَّr","root":"ربب"},{"id":7,"arabic":"وَكَذَّبْتُم","translit":"mُtْbَّhdَkَw","root":"كذب"},{"id":8,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"عِندِى","translit":"àِdnِʿع","root":"عند"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"تَسْتَعْجِلُونَ","translit":"َnwُlِjgْʿعَtْsَt","root":"عجل"},{"id":13,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":14,"arabic":"إِنِ","translit":"ِnِiʾ","root":""},{"id":15,"arabic":"ٱلْحُكْمُ","translit":"ُmْkُḥْlٱ","root":"حكم"},{"id":16,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":17,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":18,"arabic":"يَقُصُّ","translit":"ُّṣُqَy","root":"قصص"},{"id":19,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":20,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":21,"arabic":"خَيْرُ","translit":"ُrْyَhk","root":"خير"},{"id":22,"arabic":"ٱلْفَٰصِلِينَ","translit":"َnyِlِṣَٰfْlٱ","root":"فصل"}],"hasIhya":false},{"ayah":58,"text":"قُل لَّوْ أَنَّ عِندِى مَا تَسْتَعْجِلُونَ بِهِۦ لَقُضِىَ ٱلْأَمْرُ بَيْنِى وَبَيْنَكُمْۗ وَٱللَّهُ أَعْلَمُ بِٱلظَّٰلِمِينَ ","translation":"Say, \"If I had that for which you are impatient, the matter would have been decided between me and you, but Allāh is most knowing of the wrongdoers.\"","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لَّوْ","translit":"ْwَّl","root":""},{"id":3,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":4,"arabic":"عِندِى","translit":"àِdnِʿع","root":"عند"},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"تَسْتَعْجِلُونَ","translit":"َnwُlِjgْʿعَtْsَt","root":"عجل"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"لَقُضِىَ","translit":"َàِḍُqَl","root":"قضي"},{"id":9,"arabic":"ٱلْأَمْرُ","translit":"ُrْmَaʾْlٱ","root":"امر"},{"id":10,"arabic":"بَيْنِى","translit":"àِnْyَb","root":"بين"},{"id":11,"arabic":"وَبَيْنَكُمْ","translit":"ْmُkَnْyَbَw","root":"بين"},{"id":12,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":13,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":14,"arabic":"بِٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱِb","root":"ظلم"}],"hasIhya":false},{"ayah":59,"text":"وَعِندَهُۥ مَفَاتِحُ ٱلْغَيْبِ لَا يَعْلَمُهَآ إِلَّا هُوَۚ وَيَعْلَمُ مَا فِى ٱلْبَرِّ وَٱلْبَحْرِۚ وَمَا تَسْقُطُ مِن وَرَقَةٍ إِلَّا يَعْلَمُهَا وَلَا حَبَّةٍ فِى ظُلُمَٰتِ ٱلْأَرْضِ وَلَا رَطْبٍ وَلَا يَابِسٍ إِلَّا فِى كِتَٰبٍ مُّبِينٍ ","translation":"And with Him are the keys of the unseen; none knows them except Him. And He knows what is on the land and in the sea. Not a leaf falls but that He knows it. And no grain is there within the darknesses of the earth and no moist or dry [thing] but that it is [written] in a clear record.","words":[{"id":1,"arabic":"وَعِندَهُۥ","translit":"ۥُhَdnِʿعَw","root":"عند"},{"id":2,"arabic":"مَفَاتِحُ","translit":"ُḥِtāَfَm","root":"فتح"},{"id":3,"arabic":"ٱلْغَيْبِ","translit":"ِbْyَغْlٱ","root":"غيب"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"يَعْلَمُهَآ","translit":"ٓāَhُmَlْʿعَy","root":"علم"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":8,"arabic":"وَيَعْلَمُ","translit":"ُmَlْʿعَyَw","root":"علم"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"ٱلْبَرِّ","translit":"ِّrَbْlٱ","root":"برر"},{"id":12,"arabic":"وَٱلْبَحْرِ","translit":"ِrْḥَbْlٱَw","root":"بحر"},{"id":13,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":14,"arabic":"تَسْقُطُ","translit":"ُṭُqْsَt","root":"سقط"},{"id":15,"arabic":"مِن","translit":"nِm","root":""},{"id":16,"arabic":"وَرَقَةٍ","translit":"ٍẗَqَrَw","root":"ورق"},{"id":17,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":18,"arabic":"يَعْلَمُهَا","translit":"āَhُmَlْʿعَy","root":"علم"},{"id":19,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":20,"arabic":"حَبَّةٍ","translit":"ٍẗَّbَḥ","root":"حبب"},{"id":21,"arabic":"فِى","translit":"àِf","root":""},{"id":22,"arabic":"ظُلُمَٰتِ","translit":"ِtَٰmُlُẓ","root":"ظلم"},{"id":23,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":24,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":25,"arabic":"رَطْبٍ","translit":"ٍbْṭَr","root":"رطب"},{"id":26,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":27,"arabic":"يَابِسٍ","translit":"ٍsِbāَy","root":"يبس"},{"id":28,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":29,"arabic":"فِى","translit":"àِf","root":""},{"id":30,"arabic":"كِتَٰبٍ","translit":"ٍbَٰtِk","root":"كتب"},{"id":31,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":true},{"ayah":60,"text":"وَهُوَ ٱلَّذِى يَتَوَفَّىٰكُم بِٱلَّيْلِ وَيَعْلَمُ مَا جَرَحْتُم بِٱلنَّهَارِ ثُمَّ يَبْعَثُكُمْ فِيهِ لِيُقْضَىٰٓ أَجَلٌ مُّسَمًّىۖ ثُمَّ إِلَيْهِ مَرْجِعُكُمْ ثُمَّ يُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ ","translation":"And it is He who takes your souls by night[1] and knows what you have committed by day. Then He revives you therein [i.e., by day] that a specified term[2] may be fulfilled. Then to Him will be your return; then He will inform you about what you used to do.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يَتَوَفَّىٰكُم","translit":"mُkٰàَّfَwَtَy","root":"وفي"},{"id":4,"arabic":"بِٱلَّيْلِ","translit":"ِlْyَّlٱِb","root":"ليل"},{"id":5,"arabic":"وَيَعْلَمُ","translit":"ُmَlْʿعَyَw","root":"علم"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"جَرَحْتُم","translit":"mُtْḥَrَjg","root":"جرح"},{"id":8,"arabic":"بِٱلنَّهَارِ","translit":"ِrāَhَّnlٱِb","root":"نهر"},{"id":9,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":10,"arabic":"يَبْعَثُكُمْ","translit":"ْmُkُhtَʿعْbَy","root":"بعث"},{"id":11,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":12,"arabic":"لِيُقْضَىٰٓ","translit":"ٰٓàَḍْqُyِl","root":"قضي"},{"id":13,"arabic":"أَجَلٌ","translit":"ٌlَjgَaʾ","root":"اجل"},{"id":14,"arabic":"مُّسَمًّى","translit":"àًّmَsُّm","root":"سمو"},{"id":15,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":16,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":17,"arabic":"مَرْجِعُكُمْ","translit":"ْmُkُʿعِjgْrَm","root":"رجع"},{"id":18,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":19,"arabic":"يُنَبِّئُكُم","translit":"mُkُyʾِّbَnُy","root":"نبا"},{"id":20,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":21,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":22,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":true},{"ayah":61,"text":"وَهُوَ ٱلْقَاهِرُ فَوْقَ عِبَادِهِۦۖ وَيُرْسِلُ عَلَيْكُمْ حَفَظَةً حَتَّىٰٓ إِذَا جَآءَ أَحَدَكُمُ ٱلْمَوْتُ تَوَفَّتْهُ رُسُلُنَا وَهُمْ لَا يُفَرِّطُونَ ","translation":"And He is the subjugator over His servants, and He sends over you guardian-angels until, when death comes to one of you, Our messengers [i.e., angels of death] take him, and they do not fail [in their duties].","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلْقَاهِرُ","translit":"ُrِhāَqْlٱ","root":"قهر"},{"id":3,"arabic":"فَوْقَ","translit":"َqْwَf","root":"فوق"},{"id":4,"arabic":"عِبَادِهِۦ","translit":"ۦِhِdāَbِʿع","root":"عبد"},{"id":5,"arabic":"وَيُرْسِلُ","translit":"ُlِsْrُyَw","root":"رسل"},{"id":6,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":7,"arabic":"حَفَظَةً","translit":"ًẗَẓَfَḥ","root":"حفظ"},{"id":8,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":9,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":10,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":11,"arabic":"أَحَدَكُمُ","translit":"ُmُkَdَḥَaʾ","root":"احد"},{"id":12,"arabic":"ٱلْمَوْتُ","translit":"ُtْwَmْlٱ","root":"موت"},{"id":13,"arabic":"تَوَفَّتْهُ","translit":"ُhْtَّfَwَt","root":"وفي"},{"id":14,"arabic":"رُسُلُنَا","translit":"āَnُlُsُr","root":"رسل"},{"id":15,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":16,"arabic":"لَا","translit":"āَl","root":""},{"id":17,"arabic":"يُفَرِّطُونَ","translit":"َnwُṭِّrَfُy","root":"فرط"}],"hasIhya":false},{"ayah":62,"text":"ثُمَّ رُدُّوٓا۟ إِلَى ٱللَّهِ مَوْلَىٰهُمُ ٱلْحَقِّۚ أَلَا لَهُ ٱلْحُكْمُ وَهُوَ أَسْرَعُ ٱلْحَٰسِبِينَ ","translation":"Then they [i.e., His servants] are returned to Allāh, their true Lord. Unquestionably, His is the judgement, and He is the swiftest of accountants.","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"رُدُّوٓا۟","translit":"۟āٓwُّdُr","root":"ردد"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"مَوْلَىٰهُمُ","translit":"ُmُhٰàَlْwَm","root":"ولي"},{"id":6,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":7,"arabic":"أَلَا","translit":"āَlَaʾ","root":""},{"id":8,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":9,"arabic":"ٱلْحُكْمُ","translit":"ُmْkُḥْlٱ","root":"حكم"},{"id":10,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":11,"arabic":"أَسْرَعُ","translit":"ُʿعَrْsَaʾ","root":"سرع"},{"id":12,"arabic":"ٱلْحَٰسِبِينَ","translit":"َnyِbِsَٰḥْlٱ","root":"حسب"}],"hasIhya":false},{"ayah":63,"text":"قُلْ مَن يُنَجِّيكُم مِّن ظُلُمَٰتِ ٱلْبَرِّ وَٱلْبَحْرِ تَدْعُونَهُۥ تَضَرُّعًا وَخُفْيَةً لَّئِنْ أَنجَىٰنَا مِنْ هَٰذِهِۦ لَنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ ","translation":"Say, \"Who rescues you from the darknesses of the land and sea [when] you call upon Him imploring [aloud] and privately, 'If He should save us from this [crisis], we will surely be among the thankful.'\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"مَن","translit":"nَm","root":""},{"id":3,"arabic":"يُنَجِّيكُم","translit":"mُkyِّjgَnُy","root":"نجو"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"ظُلُمَٰتِ","translit":"ِtَٰmُlُẓ","root":"ظلم"},{"id":6,"arabic":"ٱلْبَرِّ","translit":"ِّrَbْlٱ","root":"برر"},{"id":7,"arabic":"وَٱلْبَحْرِ","translit":"ِrْḥَbْlٱَw","root":"بحر"},{"id":8,"arabic":"تَدْعُونَهُۥ","translit":"ۥُhَnwُʿعْdَt","root":"دعو"},{"id":9,"arabic":"تَضَرُّعًا","translit":"āًʿعُّrَḍَt","root":"ضرع"},{"id":10,"arabic":"وَخُفْيَةً","translit":"ًẗَyْfُhkَw","root":"خفي"},{"id":11,"arabic":"لَّئِنْ","translit":"ْnِyʾَّl","root":""},{"id":12,"arabic":"أَنجَىٰنَا","translit":"āَnٰàَjgnَaʾ","root":"نجو"},{"id":13,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":14,"arabic":"هَٰذِهِۦ","translit":"ۦِhِhdَٰh","root":""},{"id":15,"arabic":"لَنَكُونَنَّ","translit":"َّnَnwُkَnَl","root":"كون"},{"id":16,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":17,"arabic":"ٱلشَّٰكِرِينَ","translit":"َnyِrِkَّٰhslٱ","root":"شكر"}],"hasIhya":false},{"ayah":64,"text":"قُلِ ٱللَّهُ يُنَجِّيكُم مِّنْهَا وَمِن كُلِّ كَرْبٍ ثُمَّ أَنتُمْ تُشْرِكُونَ ","translation":"Say, \"It is Allāh who saves you from it and from every distress; then you [still] associate others with Him.\"","words":[{"id":1,"arabic":"قُلِ","translit":"ِlُq","root":"قول"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"يُنَجِّيكُم","translit":"mُkyِّjgَnُy","root":"نجو"},{"id":4,"arabic":"مِّنْهَا","translit":"āَhْnِّm","root":""},{"id":5,"arabic":"وَمِن","translit":"nِmَw","root":""},{"id":6,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":7,"arabic":"كَرْبٍ","translit":"ٍbْrَk","root":"كرب"},{"id":8,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":9,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":10,"arabic":"تُشْرِكُونَ","translit":"َnwُkِrْhsُt","root":"شرك"}],"hasIhya":false},{"ayah":65,"text":"قُلْ هُوَ ٱلْقَادِرُ عَلَىٰٓ أَن يَبْعَثَ عَلَيْكُمْ عَذَابًا مِّن فَوْقِكُمْ أَوْ مِن تَحْتِ أَرْجُلِكُمْ أَوْ يَلْبِسَكُمْ شِيَعًا وَيُذِيقَ بَعْضَكُم بَأْسَ بَعْضٍۗ ٱنظُرْ كَيْفَ نُصَرِّفُ ٱلْءَايَٰتِ لَعَلَّهُمْ يَفْقَهُونَ ","translation":"Say, \"He is the [one] Able to send upon you affliction from above you or from beneath your feet or to confuse you [so you become] sects[1] and make you taste the violence of one another.\" Look how We diversify the signs that they might understand.","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":3,"arabic":"ٱلْقَادِرُ","translit":"ُrِdāَqْlٱ","root":"قدر"},{"id":4,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"يَبْعَثَ","translit":"َhtَʿعْbَy","root":"بعث"},{"id":7,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":8,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":9,"arabic":"مِّن","translit":"nِّm","root":""},{"id":10,"arabic":"فَوْقِكُمْ","translit":"ْmُkِqْwَf","root":"فوق"},{"id":11,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"تَحْتِ","translit":"ِtْḥَt","root":"تحت"},{"id":14,"arabic":"أَرْجُلِكُمْ","translit":"ْmُkِlُjgْrَaʾ","root":"رجل"},{"id":15,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":16,"arabic":"يَلْبِسَكُمْ","translit":"ْmُkَsِbْlَy","root":"لبس"},{"id":17,"arabic":"شِيَعًا","translit":"āًʿعَyِhs","root":"شيع"},{"id":18,"arabic":"وَيُذِيقَ","translit":"َqyِhdُyَw","root":"ذوق"},{"id":19,"arabic":"بَعْضَكُم","translit":"mُkَḍْʿعَb","root":"بعض"},{"id":20,"arabic":"بَأْسَ","translit":"َsْaʾَb","root":"باس"},{"id":21,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":22,"arabic":"ٱنظُرْ","translit":"ْrُẓnٱ","root":"نظر"},{"id":23,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":24,"arabic":"نُصَرِّفُ","translit":"ُfِّrَṣُn","root":"صرف"},{"id":25,"arabic":"ٱلْءَايَٰتِ","translit":"ِtَٰyāَءْlٱ","root":"ايي"},{"id":26,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":27,"arabic":"يَفْقَهُونَ","translit":"َnwُhَqْfَy","root":"فقه"}],"hasIhya":true},{"ayah":66,"text":"وَكَذَّبَ بِهِۦ قَوْمُكَ وَهُوَ ٱلْحَقُّۚ قُل لَّسْتُ عَلَيْكُم بِوَكِيلٍ ","translation":"But your people have denied it while it is the truth. Say, \"I am not over you a manager [i.e., authority].\"","words":[{"id":1,"arabic":"وَكَذَّبَ","translit":"َbَّhdَkَw","root":"كذب"},{"id":2,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":3,"arabic":"قَوْمُكَ","translit":"َkُmْwَq","root":"قوم"},{"id":4,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":5,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":6,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":7,"arabic":"لَّسْتُ","translit":"ُtْsَّl","root":"ليس"},{"id":8,"arabic":"عَلَيْكُم","translit":"mُkْyَlَʿع","root":""},{"id":9,"arabic":"بِوَكِيلٍ","translit":"ٍlyِkَwِb","root":"وكل"}],"hasIhya":false},{"ayah":67,"text":"لِّكُلِّ نَبَإٍ مُّسْتَقَرٌّۚ وَسَوْفَ تَعْلَمُونَ ","translation":"For every news [i.e., happening] is a finality;[1] and you are going to know.","words":[{"id":1,"arabic":"لِّكُلِّ","translit":"ِّlُkِّl","root":"كلل"},{"id":2,"arabic":"نَبَإٍ","translit":"ٍiʾَbَn","root":"نبا"},{"id":3,"arabic":"مُّسْتَقَرٌّ","translit":"ٌّrَqَtْsُّm","root":"قرر"},{"id":4,"arabic":"وَسَوْفَ","translit":"َfْwَsَw","root":""},{"id":5,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":68,"text":"وَإِذَا رَأَيْتَ ٱلَّذِينَ يَخُوضُونَ فِىٓ ءَايَٰتِنَا فَأَعْرِضْ عَنْهُمْ حَتَّىٰ يَخُوضُوا۟ فِى حَدِيثٍ غَيْرِهِۦۚ وَإِمَّا يُنسِيَنَّكَ ٱلشَّيْطَٰنُ فَلَا تَقْعُدْ بَعْدَ ٱلذِّكْرَىٰ مَعَ ٱلْقَوْمِ ٱلظَّٰلِمِينَ ","translation":"And when you see those who engage in [offensive] discourse[1] concerning Our verses, then turn away from them until they enter into another conversation. And if Satan should cause you to forget, then do not remain after the reminder with the wrongdoing people.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"رَأَيْتَ","translit":"َtْyَaʾَr","root":"راي"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"يَخُوضُونَ","translit":"َnwُḍwُhkَy","root":"خوض"},{"id":5,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":6,"arabic":"ءَايَٰتِنَا","translit":"āَnِtَٰyāَء","root":"ايي"},{"id":7,"arabic":"فَأَعْرِضْ","translit":"ْḍِrْʿعَaʾَf","root":"عرض"},{"id":8,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":9,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":10,"arabic":"يَخُوضُوا۟","translit":"۟āwُḍwُhkَy","root":"خوض"},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"حَدِيثٍ","translit":"ٍhtyِdَḥ","root":"حدث"},{"id":13,"arabic":"غَيْرِهِۦ","translit":"ۦِhِrْyَغ","root":"غير"},{"id":14,"arabic":"وَإِمَّا","translit":"āَّmِiʾَw","root":""},{"id":15,"arabic":"يُنسِيَنَّكَ","translit":"َkَّnَyِsnُy","root":"نسي"},{"id":16,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":17,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":18,"arabic":"تَقْعُدْ","translit":"ْdُʿعْqَt","root":"قعد"},{"id":19,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":20,"arabic":"ٱلذِّكْرَىٰ","translit":"ٰàَrْkِّhdlٱ","root":"ذكر"},{"id":21,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":22,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":23,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":true},{"ayah":69,"text":"وَمَا عَلَى ٱلَّذِينَ يَتَّقُونَ مِنْ حِسَابِهِم مِّن شَىْءٍ وَلَٰكِن ذِكْرَىٰ لَعَلَّهُمْ يَتَّقُونَ ","translation":"And those who fear Allāh are not held accountable for them [i.e., the disbelievers] at all, but [only for] a reminder - that perhaps they will fear Him.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"يَتَّقُونَ","translit":"َnwُqَّtَy","root":"وقي"},{"id":5,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":6,"arabic":"حِسَابِهِم","translit":"mِhِbāَsِḥ","root":"حسب"},{"id":7,"arabic":"مِّن","translit":"nِّm","root":""},{"id":8,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":9,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":10,"arabic":"ذِكْرَىٰ","translit":"ٰàَrْkِhd","root":"ذكر"},{"id":11,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":12,"arabic":"يَتَّقُونَ","translit":"َnwُqَّtَy","root":"وقي"}],"hasIhya":false},{"ayah":70,"text":"وَذَرِ ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَهُمْ لَعِبًا وَلَهْوًا وَغَرَّتْهُمُ ٱلْحَيَوٰةُ ٱلدُّنْيَاۚ وَذَكِّرْ بِهِۦٓ أَن تُبْسَلَ نَفْسٌۢ بِمَا كَسَبَتْ لَيْسَ لَهَا مِن دُونِ ٱللَّهِ وَلِىٌّ وَلَا شَفِيعٌ وَإِن تَعْدِلْ كُلَّ عَدْلٍ لَّا يُؤْخَذْ مِنْهَآۗ أُو۟لَٰٓئِكَ ٱلَّذِينَ أُبْسِلُوا۟ بِمَا كَسَبُوا۟ۖ لَهُمْ شَرَابٌ مِّنْ حَمِيمٍ وَعَذَابٌ أَلِيمٌۢ بِمَا كَانُوا۟ يَكْفُرُونَ ","translation":"And leave those who take their religion as amusement and diversion and whom the worldly life has deluded. But remind with it [i.e., the Qur’ān], lest a soul be given up to destruction for what it earned; it will have other than Allāh no protector and no intercessor. And if it should offer every compensation, it would not be taken from it [i.e., that soul]. Those are the ones who are given to destruction for what they have earned. For them will be a drink of scalding water and a painful punishment because they used to disbelieve.","words":[{"id":1,"arabic":"وَذَرِ","translit":"ِrَhdَw","root":"وذر"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ٱتَّخَذُوا۟","translit":"۟āwُhdَhkَّtٱ","root":"اخذ"},{"id":4,"arabic":"دِينَهُمْ","translit":"ْmُhَnyِd","root":"دين"},{"id":5,"arabic":"لَعِبًا","translit":"āًbِʿعَl","root":"لعب"},{"id":6,"arabic":"وَلَهْوًا","translit":"āًwْhَlَw","root":"لهو"},{"id":7,"arabic":"وَغَرَّتْهُمُ","translit":"ُmُhْtَّrَغَw","root":"غرر"},{"id":8,"arabic":"ٱلْحَيَوٰةُ","translit":"ُẗٰwَyَḥْlٱ","root":"حيي"},{"id":9,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":10,"arabic":"وَذَكِّرْ","translit":"ْrِّkَhdَw","root":"ذكر"},{"id":11,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"تُبْسَلَ","translit":"َlَsْbُt","root":"بسل"},{"id":14,"arabic":"نَفْسٌۢ","translit":"ٌۢsْfَn","root":"نفس"},{"id":15,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":16,"arabic":"كَسَبَتْ","translit":"ْtَbَsَk","root":"كسب"},{"id":17,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":18,"arabic":"لَهَا","translit":"āَhَl","root":""},{"id":19,"arabic":"مِن","translit":"nِm","root":""},{"id":20,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":21,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":22,"arabic":"وَلِىٌّ","translit":"ٌّàِlَw","root":"ولي"},{"id":23,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":24,"arabic":"شَفِيعٌ","translit":"ٌʿعyِfَhs","root":"شفع"},{"id":25,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":26,"arabic":"تَعْدِلْ","translit":"ْlِdْʿعَt","root":"عدل"},{"id":27,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":28,"arabic":"عَدْلٍ","translit":"ٍlْdَʿع","root":"عدل"},{"id":29,"arabic":"لَّا","translit":"āَّl","root":""},{"id":30,"arabic":"يُؤْخَذْ","translit":"ْhdَhkْwʾُy","root":"اخذ"},{"id":31,"arabic":"مِنْهَآ","translit":"ٓāَhْnِm","root":""},{"id":32,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":33,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":34,"arabic":"أُبْسِلُوا۟","translit":"۟āwُlِsْbُaʾ","root":"بسل"},{"id":35,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":36,"arabic":"كَسَبُوا۟","translit":"۟āwُbَsَk","root":"كسب"},{"id":37,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":38,"arabic":"شَرَابٌ","translit":"ٌbāَrَhs","root":"شرب"},{"id":39,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":40,"arabic":"حَمِيمٍ","translit":"ٍmyِmَḥ","root":"حمم"},{"id":41,"arabic":"وَعَذَابٌ","translit":"ٌbāَhdَʿعَw","root":"عذب"},{"id":42,"arabic":"أَلِيمٌۢ","translit":"ٌۢmyِlَaʾ","root":"الم"},{"id":43,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":44,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":45,"arabic":"يَكْفُرُونَ","translit":"َnwُrُfْkَy","root":"كفر"}],"hasIhya":true},{"ayah":71,"text":"قُلْ أَنَدْعُوا۟ مِن دُونِ ٱللَّهِ مَا لَا يَنفَعُنَا وَلَا يَضُرُّنَا وَنُرَدُّ عَلَىٰٓ أَعْقَابِنَا بَعْدَ إِذْ هَدَىٰنَا ٱللَّهُ كَٱلَّذِى ٱسْتَهْوَتْهُ ٱلشَّيَٰطِينُ فِى ٱلْأَرْضِ حَيْرَانَ لَهُۥٓ أَصْحَٰبٌ يَدْعُونَهُۥٓ إِلَى ٱلْهُدَى ٱئْتِنَاۗ قُلْ إِنَّ هُدَى ٱللَّهِ هُوَ ٱلْهُدَىٰۖ وَأُمِرْنَا لِنُسْلِمَ لِرَبِّ ٱلْعَٰلَمِينَ ","translation":"Say, \"Shall we invoke[1] instead of Allāh that which neither benefits us nor harms us and be turned back on our heels after Allāh has guided us? [We would then be] like one whom the devils enticed [to wander] upon the earth confused, [while] he has companions inviting him to guidance, [calling], 'Come to us.'\"[2] Say, \"Indeed, the guidance of Allāh is the [only] guidance; and we have been commanded to submit to the Lord of the worlds.","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"أَنَدْعُوا۟","translit":"۟āwُʿعْdَnَaʾ","root":"دعو"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"يَنفَعُنَا","translit":"āَnُʿعَfnَy","root":"نفع"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"يَضُرُّنَا","translit":"āَnُّrُḍَy","root":"ضرر"},{"id":11,"arabic":"وَنُرَدُّ","translit":"ُّdَrُnَw","root":"ردد"},{"id":12,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":13,"arabic":"أَعْقَابِنَا","translit":"āَnِbāَqْʿعَaʾ","root":"عقب"},{"id":14,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":15,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":16,"arabic":"هَدَىٰنَا","translit":"āَnٰàَdَh","root":"هدي"},{"id":17,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":18,"arabic":"كَٱلَّذِى","translit":"àِhdَّlٱَk","root":""},{"id":19,"arabic":"ٱسْتَهْوَتْهُ","translit":"ُhْtَwْhَtْsٱ","root":"هوي"},{"id":20,"arabic":"ٱلشَّيَٰطِينُ","translit":"ُnyِṭَٰyَّhslٱ","root":"شطن"},{"id":21,"arabic":"فِى","translit":"àِf","root":""},{"id":22,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":23,"arabic":"حَيْرَانَ","translit":"َnāَrْyَḥ","root":"حير"},{"id":24,"arabic":"لَهُۥٓ","translit":"ٓۥُhَl","root":""},{"id":25,"arabic":"أَصْحَٰبٌ","translit":"ٌbَٰḥْṣَaʾ","root":"صحب"},{"id":26,"arabic":"يَدْعُونَهُۥٓ","translit":"ٓۥُhَnwُʿعْdَy","root":"دعو"},{"id":27,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":28,"arabic":"ٱلْهُدَى","translit":"àَdُhْlٱ","root":"هدي"},{"id":29,"arabic":"ٱئْتِنَا","translit":"āَnِtْyʾٱ","root":"اتي"},{"id":30,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":31,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":32,"arabic":"هُدَى","translit":"àَdُh","root":"هدي"},{"id":33,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":34,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":35,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":36,"arabic":"وَأُمِرْنَا","translit":"āَnْrِmُaʾَw","root":"امر"},{"id":37,"arabic":"لِنُسْلِمَ","translit":"َmِlْsُnِl","root":"سلم"},{"id":38,"arabic":"لِرَبِّ","translit":"ِّbَrِl","root":"ربب"},{"id":39,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":72,"text":"وَأَنْ أَقِيمُوا۟ ٱلصَّلَوٰةَ وَٱتَّقُوهُۚ وَهُوَ ٱلَّذِىٓ إِلَيْهِ تُحْشَرُونَ ","translation":"And to establish prayer and fear Him.\" And it is He to whom you will be gathered.","words":[{"id":1,"arabic":"وَأَنْ","translit":"ْnَaʾَw","root":""},{"id":2,"arabic":"أَقِيمُوا۟","translit":"۟āwُmyِqَaʾ","root":"قوم"},{"id":3,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":4,"arabic":"وَٱتَّقُوهُ","translit":"ُhwُqَّtٱَw","root":"وقي"},{"id":5,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":6,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":7,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":8,"arabic":"تُحْشَرُونَ","translit":"َnwُrَhsْḥُt","root":"حشر"}],"hasIhya":false},{"ayah":73,"text":"وَهُوَ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّۖ وَيَوْمَ يَقُولُ كُن فَيَكُونُۚ قَوْلُهُ ٱلْحَقُّۚ وَلَهُ ٱلْمُلْكُ يَوْمَ يُنفَخُ فِى ٱلصُّورِۚ عَٰلِمُ ٱلْغَيْبِ وَٱلشَّهَٰدَةِۚ وَهُوَ ٱلْحَكِيمُ ٱلْخَبِيرُ ","translation":"And it is He who created the heavens and earth in truth. And the day [i.e., whenever] He says, \"Be,\" and it is, His word is the truth.[1] And His is the dominion [on] the Day the Horn is blown. [He is] Knower of the unseen[2] and the witnessed;[3] and He is the Wise, the Aware.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":6,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":7,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":8,"arabic":"يَقُولُ","translit":"ُlwُqَy","root":"قول"},{"id":9,"arabic":"كُن","translit":"nُk","root":"كون"},{"id":10,"arabic":"فَيَكُونُ","translit":"ُnwُkَyَf","root":"كون"},{"id":11,"arabic":"قَوْلُهُ","translit":"ُhُlْwَq","root":"قول"},{"id":12,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":13,"arabic":"وَلَهُ","translit":"ُhَlَw","root":""},{"id":14,"arabic":"ٱلْمُلْكُ","translit":"ُkْlُmْlٱ","root":"ملك"},{"id":15,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":16,"arabic":"يُنفَخُ","translit":"ُhkَfnُy","root":"نفخ"},{"id":17,"arabic":"فِى","translit":"àِf","root":""},{"id":18,"arabic":"ٱلصُّورِ","translit":"ِrwُّṣlٱ","root":"صور"},{"id":19,"arabic":"عَٰلِمُ","translit":"ُmِlَٰʿع","root":"علم"},{"id":20,"arabic":"ٱلْغَيْبِ","translit":"ِbْyَغْlٱ","root":"غيب"},{"id":21,"arabic":"وَٱلشَّهَٰدَةِ","translit":"ِẗَdَٰhَّhslٱَw","root":"شهد"},{"id":22,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":23,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"},{"id":24,"arabic":"ٱلْخَبِيرُ","translit":"ُryِbَhkْlٱ","root":"خبر"}],"hasIhya":false},{"ayah":74,"text":"وَإِذْ قَالَ إِبْرَٰهِيمُ لِأَبِيهِ ءَازَرَ أَتَتَّخِذُ أَصْنَامًا ءَالِهَةًۖ إِنِّىٓ أَرَىٰكَ وَقَوْمَكَ فِى ضَلَٰلٍ مُّبِينٍ ","translation":"And [mention, O Muḥammad], when Abraham said to his father Āzar, \"Do you take idols as deities? Indeed, I see you and your people to be in manifest error.\"","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":3,"arabic":"إِبْرَٰهِيمُ","translit":"ُmyِhَٰrْbِiʾ","root":""},{"id":4,"arabic":"لِأَبِيهِ","translit":"ِhyِbَaʾِl","root":"ابو"},{"id":5,"arabic":"ءَازَرَ","translit":"َrَzāَء","root":""},{"id":6,"arabic":"أَتَتَّخِذُ","translit":"ُhdِhkَّtَtَaʾ","root":"اخذ"},{"id":7,"arabic":"أَصْنَامًا","translit":"āًmāَnْṣَaʾ","root":"صنم"},{"id":8,"arabic":"ءَالِهَةً","translit":"ًẗَhِlāَء","root":"اله"},{"id":9,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":10,"arabic":"أَرَىٰكَ","translit":"َkٰàَrَaʾ","root":"راي"},{"id":11,"arabic":"وَقَوْمَكَ","translit":"َkَmْwَqَw","root":"قوم"},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"ضَلَٰلٍ","translit":"ٍlَٰlَḍ","root":"ضلل"},{"id":14,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":75,"text":"وَكَذَٰلِكَ نُرِىٓ إِبْرَٰهِيمَ مَلَكُوتَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَلِيَكُونَ مِنَ ٱلْمُوقِنِينَ ","translation":"And thus did We show Abraham the realm of the heavens and the earth that he would be among the certain [in faith].","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"نُرِىٓ","translit":"ٓàِrُn","root":"راي"},{"id":3,"arabic":"إِبْرَٰهِيمَ","translit":"َmyِhَٰrْbِiʾ","root":""},{"id":4,"arabic":"مَلَكُوتَ","translit":"َtwُkَlَm","root":"ملك"},{"id":5,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":6,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":7,"arabic":"وَلِيَكُونَ","translit":"َnwُkَyِlَw","root":"كون"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلْمُوقِنِينَ","translit":"َnyِnِqwُmْlٱ","root":"يقن"}],"hasIhya":true},{"ayah":76,"text":"فَلَمَّا جَنَّ عَلَيْهِ ٱلَّيْلُ رَءَا كَوْكَبًاۖ قَالَ هَٰذَا رَبِّىۖ فَلَمَّآ أَفَلَ قَالَ لَآ أُحِبُّ ٱلْءَافِلِينَ ","translation":"So when the night covered him [with darkness], he saw a star. He said, \"This is my lord.\"[1] But when it set, he said, \"I like not those that set [i.e., disappear].\"","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"جَنَّ","translit":"َّnَjg","root":"جنن"},{"id":3,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":4,"arabic":"ٱلَّيْلُ","translit":"ُlْyَّlٱ","root":"ليل"},{"id":5,"arabic":"رَءَا","translit":"āَءَr","root":"راي"},{"id":6,"arabic":"كَوْكَبًا","translit":"āًbَkْwَk","root":"كوكب"},{"id":7,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":8,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":9,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":10,"arabic":"فَلَمَّآ","translit":"ٓāَّmَlَf","root":""},{"id":11,"arabic":"أَفَلَ","translit":"َlَfَaʾ","root":"افل"},{"id":12,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":13,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":14,"arabic":"أُحِبُّ","translit":"ُّbِḥُaʾ","root":"حبب"},{"id":15,"arabic":"ٱلْءَافِلِينَ","translit":"َnyِlِfāَءْlٱ","root":"افل"}],"hasIhya":true},{"ayah":77,"text":"فَلَمَّا رَءَا ٱلْقَمَرَ بَازِغًا قَالَ هَٰذَا رَبِّىۖ فَلَمَّآ أَفَلَ قَالَ لَئِن لَّمْ يَهْدِنِى رَبِّى لَأَكُونَنَّ مِنَ ٱلْقَوْمِ ٱلضَّآلِّينَ ","translation":"And when he saw the moon rising, he said, \"This is my lord.\" But when it set, he said, \"Unless my Lord guides me, I will surely be among the people gone astray.\"","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"رَءَا","translit":"āَءَr","root":"راي"},{"id":3,"arabic":"ٱلْقَمَرَ","translit":"َrَmَqْlٱ","root":"قمر"},{"id":4,"arabic":"بَازِغًا","translit":"āًغِzāَb","root":"بزغ"},{"id":5,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":6,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":7,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":8,"arabic":"فَلَمَّآ","translit":"ٓāَّmَlَf","root":""},{"id":9,"arabic":"أَفَلَ","translit":"َlَfَaʾ","root":"افل"},{"id":10,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":11,"arabic":"لَئِن","translit":"nِyʾَl","root":""},{"id":12,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":13,"arabic":"يَهْدِنِى","translit":"àِnِdْhَy","root":"هدي"},{"id":14,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":15,"arabic":"لَأَكُونَنَّ","translit":"َّnَnwُkَaʾَl","root":"كون"},{"id":16,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":17,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":18,"arabic":"ٱلضَّآلِّينَ","translit":"َnyِّlٓāَّḍlٱ","root":"ضلل"}],"hasIhya":false},{"ayah":78,"text":"فَلَمَّا رَءَا ٱلشَّمْسَ بَازِغَةً قَالَ هَٰذَا رَبِّى هَٰذَآ أَكْبَرُۖ فَلَمَّآ أَفَلَتْ قَالَ يَٰقَوْمِ إِنِّى بَرِىٓءٌ مِّمَّا تُشْرِكُونَ ","translation":"And when he saw the sun rising, he said, \"This is my lord; this is greater.\" But when it set, he said, \"O my people, indeed I am free from what you associate with Allāh.","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"رَءَا","translit":"āَءَr","root":"راي"},{"id":3,"arabic":"ٱلشَّمْسَ","translit":"َsْmَّhslٱ","root":"شمس"},{"id":4,"arabic":"بَازِغَةً","translit":"ًẗَغِzāَb","root":"بزغ"},{"id":5,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":6,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":7,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":8,"arabic":"هَٰذَآ","translit":"ٓāَhdَٰh","root":""},{"id":9,"arabic":"أَكْبَرُ","translit":"ُrَbْkَaʾ","root":"كبر"},{"id":10,"arabic":"فَلَمَّآ","translit":"ٓāَّmَlَf","root":""},{"id":11,"arabic":"أَفَلَتْ","translit":"ْtَlَfَaʾ","root":"افل"},{"id":12,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":13,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":14,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":15,"arabic":"بَرِىٓءٌ","translit":"ٌءٓàِrَb","root":"برا"},{"id":16,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":17,"arabic":"تُشْرِكُونَ","translit":"َnwُkِrْhsُt","root":"شرك"}],"hasIhya":false},{"ayah":79,"text":"إِنِّى وَجَّهْتُ وَجْهِىَ لِلَّذِى فَطَرَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ حَنِيفًاۖ وَمَآ أَنَا۠ مِنَ ٱلْمُشْرِكِينَ ","translation":"Indeed, I have turned my face [i.e., self] toward He who created the heavens and the earth, inclining toward truth, and I am not of those who associate others with Allāh.\"","words":[{"id":1,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":2,"arabic":"وَجَّهْتُ","translit":"ُtْhَّjgَw","root":"وجه"},{"id":3,"arabic":"وَجْهِىَ","translit":"َàِhْjgَw","root":"وجه"},{"id":4,"arabic":"لِلَّذِى","translit":"àِhdَّlِl","root":""},{"id":5,"arabic":"فَطَرَ","translit":"َrَṭَf","root":"فطر"},{"id":6,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":7,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":8,"arabic":"حَنِيفًا","translit":"āًfyِnَḥ","root":"حنف"},{"id":9,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":10,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":11,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":12,"arabic":"ٱلْمُشْرِكِينَ","translit":"َnyِkِrْhsُmْlٱ","root":"شرك"}],"hasIhya":true},{"ayah":80,"text":"وَحَآجَّهُۥ قَوْمُهُۥۚ قَالَ أَتُحَٰٓجُّوٓنِّى فِى ٱللَّهِ وَقَدْ هَدَىٰنِۚ وَلَآ أَخَافُ مَا تُشْرِكُونَ بِهِۦٓ إِلَّآ أَن يَشَآءَ رَبِّى شَيْـًٔاۗ وَسِعَ رَبِّى كُلَّ شَىْءٍ عِلْمًاۗ أَفَلَا تَتَذَكَّرُونَ ","translation":"And his people argued with him. He said, \"Do you argue with me concerning Allāh while He has guided me? And I fear not what you associate with Him [and will not be harmed] unless my Lord should will something. My Lord encompasses all things in knowledge; then will you not remember?","words":[{"id":1,"arabic":"وَحَآجَّهُۥ","translit":"ۥُhَّjgٓāَḥَw","root":"حجج"},{"id":2,"arabic":"قَوْمُهُۥ","translit":"ۥُhُmْwَq","root":"قوم"},{"id":3,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":4,"arabic":"أَتُحَٰٓجُّوٓنِّى","translit":"àِّnٓwُّjgَٰٓḥُtَaʾ","root":"حجج"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":8,"arabic":"هَدَىٰنِ","translit":"ِnٰàَdَh","root":"هدي"},{"id":9,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":10,"arabic":"أَخَافُ","translit":"ُfāَhkَaʾ","root":"خوف"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"تُشْرِكُونَ","translit":"َnwُkِrْhsُt","root":"شرك"},{"id":13,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":14,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":15,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":16,"arabic":"يَشَآءَ","translit":"َءٓāَhsَy","root":"شيا"},{"id":17,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":18,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":19,"arabic":"وَسِعَ","translit":"َʿعِsَw","root":"وسع"},{"id":20,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":21,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":22,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":23,"arabic":"عِلْمًا","translit":"āًmْlِʿع","root":"علم"},{"id":24,"arabic":"أَفَلَا","translit":"āَlَfَaʾ","root":""},{"id":25,"arabic":"تَتَذَكَّرُونَ","translit":"َnwُrَّkَhdَtَt","root":"ذكر"}],"hasIhya":false},{"ayah":81,"text":"وَكَيْفَ أَخَافُ مَآ أَشْرَكْتُمْ وَلَا تَخَافُونَ أَنَّكُمْ أَشْرَكْتُم بِٱللَّهِ مَا لَمْ يُنَزِّلْ بِهِۦ عَلَيْكُمْ سُلْطَٰنًاۚ فَأَىُّ ٱلْفَرِيقَيْنِ أَحَقُّ بِٱلْأَمْنِۖ إِن كُنتُمْ تَعْلَمُونَ ","translation":"And how should I fear what you associate while you do not fear that you have associated with Allāh that for which He has not sent down to you any authority? So which of the two parties has more right to security, if you should know?\"","words":[{"id":1,"arabic":"وَكَيْفَ","translit":"َfْyَkَw","root":"كيف"},{"id":2,"arabic":"أَخَافُ","translit":"ُfāَhkَaʾ","root":"خوف"},{"id":3,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":4,"arabic":"أَشْرَكْتُمْ","translit":"ْmُtْkَrْhsَaʾ","root":"شرك"},{"id":5,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":6,"arabic":"تَخَافُونَ","translit":"َnwُfāَhkَt","root":"خوف"},{"id":7,"arabic":"أَنَّكُمْ","translit":"ْmُkَّnَaʾ","root":""},{"id":8,"arabic":"أَشْرَكْتُم","translit":"mُtْkَrْhsَaʾ","root":"شرك"},{"id":9,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":12,"arabic":"يُنَزِّلْ","translit":"ْlِّzَnُy","root":"نزل"},{"id":13,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":14,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":15,"arabic":"سُلْطَٰنًا","translit":"āًnَٰṭْlُs","root":"سلط"},{"id":16,"arabic":"فَأَىُّ","translit":"ُّàَaʾَf","root":"ايي"},{"id":17,"arabic":"ٱلْفَرِيقَيْنِ","translit":"ِnْyَqyِrَfْlٱ","root":"فرق"},{"id":18,"arabic":"أَحَقُّ","translit":"ُّqَḥَaʾ","root":"حقق"},{"id":19,"arabic":"بِٱلْأَمْنِ","translit":"ِnْmَaʾْlٱِb","root":"امن"},{"id":20,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":21,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":22,"arabic":"تَعْلَمُونَ","translit":"َnwُmَlْʿعَt","root":"علم"}],"hasIhya":false},{"ayah":82,"text":"ٱلَّذِينَ ءَامَنُوا۟ وَلَمْ يَلْبِسُوٓا۟ إِيمَٰنَهُم بِظُلْمٍ أُو۟لَٰٓئِكَ لَهُمُ ٱلْأَمْنُ وَهُم مُّهْتَدُونَ ","translation":"They who believe and do not mix their belief with injustice[1] - those will have security, and they are [rightly] guided.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":3,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":4,"arabic":"يَلْبِسُوٓا۟","translit":"۟āٓwُsِbْlَy","root":"لبس"},{"id":5,"arabic":"إِيمَٰنَهُم","translit":"mُhَnَٰmyِiʾ","root":"امن"},{"id":6,"arabic":"بِظُلْمٍ","translit":"ٍmْlُẓِb","root":"ظلم"},{"id":7,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":8,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":9,"arabic":"ٱلْأَمْنُ","translit":"ُnْmَaʾْlٱ","root":"امن"},{"id":10,"arabic":"وَهُم","translit":"mُhَw","root":""},{"id":11,"arabic":"مُّهْتَدُونَ","translit":"َnwُdَtْhُّm","root":"هدي"}],"hasIhya":false},{"ayah":83,"text":"وَتِلْكَ حُجَّتُنَآ ءَاتَيْنَٰهَآ إِبْرَٰهِيمَ عَلَىٰ قَوْمِهِۦۚ نَرْفَعُ دَرَجَٰتٍ مَّن نَّشَآءُۗ إِنَّ رَبَّكَ حَكِيمٌ عَلِيمٌ ","translation":"And that was Our [conclusive] argument which We gave Abraham against his people. We raise by degrees whom We will. Indeed, your Lord is Wise and Knowing.","words":[{"id":1,"arabic":"وَتِلْكَ","translit":"َkْlِtَw","root":""},{"id":2,"arabic":"حُجَّتُنَآ","translit":"ٓāَnُtَّjgُḥ","root":"حجج"},{"id":3,"arabic":"ءَاتَيْنَٰهَآ","translit":"ٓāَhَٰnْyَtāَء","root":"اتي"},{"id":4,"arabic":"إِبْرَٰهِيمَ","translit":"َmyِhَٰrْbِiʾ","root":""},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"قَوْمِهِۦ","translit":"ۦِhِmْwَq","root":"قوم"},{"id":7,"arabic":"نَرْفَعُ","translit":"ُʿعَfْrَn","root":"رفع"},{"id":8,"arabic":"دَرَجَٰتٍ","translit":"ٍtَٰjgَrَd","root":"درج"},{"id":9,"arabic":"مَّن","translit":"nَّm","root":""},{"id":10,"arabic":"نَّشَآءُ","translit":"ُءٓāَhsَّn","root":"شيا"},{"id":11,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":12,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":13,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"},{"id":14,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":84,"text":"وَوَهَبْنَا لَهُۥٓ إِسْحَٰقَ وَيَعْقُوبَۚ كُلًّا هَدَيْنَاۚ وَنُوحًا هَدَيْنَا مِن قَبْلُۖ وَمِن ذُرِّيَّتِهِۦ دَاوُۥدَ وَسُلَيْمَٰنَ وَأَيُّوبَ وَيُوسُفَ وَمُوسَىٰ وَهَٰرُونَۚ وَكَذَٰلِكَ نَجْزِى ٱلْمُحْسِنِينَ ","translation":"And We gave to him [i.e., Abraham] Isaac and Jacob - all [of them] We guided. And Noah, We guided before; and among his descendants, David and Solomon and Job and Joseph and Moses and Aaron. Thus do We reward the doers of good.","words":[{"id":1,"arabic":"وَوَهَبْنَا","translit":"āَnْbَhَwَw","root":"وهب"},{"id":2,"arabic":"لَهُۥٓ","translit":"ٓۥُhَl","root":""},{"id":3,"arabic":"إِسْحَٰقَ","translit":"َqَٰḥْsِiʾ","root":""},{"id":4,"arabic":"وَيَعْقُوبَ","translit":"َbwُqْʿعَyَw","root":""},{"id":5,"arabic":"كُلًّا","translit":"āًّlُk","root":"كلل"},{"id":6,"arabic":"هَدَيْنَا","translit":"āَnْyَdَh","root":"هدي"},{"id":7,"arabic":"وَنُوحًا","translit":"āًḥwُnَw","root":""},{"id":8,"arabic":"هَدَيْنَا","translit":"āَnْyَdَh","root":"هدي"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":11,"arabic":"وَمِن","translit":"nِmَw","root":""},{"id":12,"arabic":"ذُرِّيَّتِهِۦ","translit":"ۦِhِtَّyِّrُhd","root":"ذرر"},{"id":13,"arabic":"دَاوُۥدَ","translit":"َdۥُwāَd","root":""},{"id":14,"arabic":"وَسُلَيْمَٰنَ","translit":"َnَٰmْyَlُsَw","root":""},{"id":15,"arabic":"وَأَيُّوبَ","translit":"َbwُّyَaʾَw","root":""},{"id":16,"arabic":"وَيُوسُفَ","translit":"َfُswُyَw","root":""},{"id":17,"arabic":"وَمُوسَىٰ","translit":"ٰàَswُmَw","root":""},{"id":18,"arabic":"وَهَٰرُونَ","translit":"َnwُrَٰhَw","root":""},{"id":19,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":20,"arabic":"نَجْزِى","translit":"àِzْjgَn","root":"جزي"},{"id":21,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":false},{"ayah":85,"text":"وَزَكَرِيَّا وَيَحْيَىٰ وَعِيسَىٰ وَإِلْيَاسَۖ كُلٌّ مِّنَ ٱلصَّٰلِحِينَ ","translation":"And Zechariah and John and Jesus and Elias - and all were of the righteous.","words":[{"id":1,"arabic":"وَزَكَرِيَّا","translit":"āَّyِrَkَzَw","root":""},{"id":2,"arabic":"وَيَحْيَىٰ","translit":"ٰàَyْḥَyَw","root":"حيي"},{"id":3,"arabic":"وَعِيسَىٰ","translit":"ٰàَsyِʿعَw","root":""},{"id":4,"arabic":"وَإِلْيَاسَ","translit":"َsāَyْlِiʾَw","root":""},{"id":5,"arabic":"كُلٌّ","translit":"ٌّlُk","root":"كلل"},{"id":6,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":7,"arabic":"ٱلصَّٰلِحِينَ","translit":"َnyِḥِlَّٰṣlٱ","root":"صلح"}],"hasIhya":false},{"ayah":86,"text":"وَإِسْمَٰعِيلَ وَٱلْيَسَعَ وَيُونُسَ وَلُوطًاۚ وَكُلًّا فَضَّلْنَا عَلَى ٱلْعَٰلَمِينَ ","translation":"And Ishmael and Elisha and Jonah and Lot - and all [of them] We preferred over the worlds.","words":[{"id":1,"arabic":"وَإِسْمَٰعِيلَ","translit":"َlyِʿعَٰmْsِiʾَw","root":""},{"id":2,"arabic":"وَٱلْيَسَعَ","translit":"َʿعَsَyْlٱَw","root":""},{"id":3,"arabic":"وَيُونُسَ","translit":"َsُnwُyَw","root":""},{"id":4,"arabic":"وَلُوطًا","translit":"āًṭwُlَw","root":""},{"id":5,"arabic":"وَكُلًّا","translit":"āًّlُkَw","root":"كلل"},{"id":6,"arabic":"فَضَّلْنَا","translit":"āَnْlَّḍَf","root":"فضل"},{"id":7,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":8,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":87,"text":"وَمِنْ ءَابَآئِهِمْ وَذُرِّيَّٰتِهِمْ وَإِخْوَٰنِهِمْۖ وَٱجْتَبَيْنَٰهُمْ وَهَدَيْنَٰهُمْ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ","translation":"And [some] among their fathers and their descendants and their brothers - and We chose them and We guided them to a straight path.","words":[{"id":1,"arabic":"وَمِنْ","translit":"ْnِmَw","root":""},{"id":2,"arabic":"ءَابَآئِهِمْ","translit":"ْmِhِyʾٓāَbāَء","root":"ابو"},{"id":3,"arabic":"وَذُرِّيَّٰتِهِمْ","translit":"ْmِhِtَّٰyِّrُhdَw","root":"ذرر"},{"id":4,"arabic":"وَإِخْوَٰنِهِمْ","translit":"ْmِhِnَٰwْhkِiʾَw","root":"اخو"},{"id":5,"arabic":"وَٱجْتَبَيْنَٰهُمْ","translit":"ْmُhَٰnْyَbَtْjgٱَw","root":"جبي"},{"id":6,"arabic":"وَهَدَيْنَٰهُمْ","translit":"ْmُhَٰnْyَdَhَw","root":"هدي"},{"id":7,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":8,"arabic":"صِرَٰطٍ","translit":"ٍṭَٰrِṣ","root":"صرط"},{"id":9,"arabic":"مُّسْتَقِيمٍ","translit":"ٍmyِqَtْsُّm","root":"قوم"}],"hasIhya":false},{"ayah":88,"text":"ذَٰلِكَ هُدَى ٱللَّهِ يَهْدِى بِهِۦ مَن يَشَآءُ مِنْ عِبَادِهِۦۚ وَلَوْ أَشْرَكُوا۟ لَحَبِطَ عَنْهُم مَّا كَانُوا۟ يَعْمَلُونَ ","translation":"That is the guidance of Allāh by which He guides whomever He wills of His servants. But if they had associated others with Allāh, then worthless for them would be whatever they were doing.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"هُدَى","translit":"àَdُh","root":"هدي"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":5,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":6,"arabic":"مَن","translit":"nَm","root":""},{"id":7,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"عِبَادِهِۦ","translit":"ۦِhِdāَbِʿع","root":"عبد"},{"id":10,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":11,"arabic":"أَشْرَكُوا۟","translit":"۟āwُkَrْhsَaʾ","root":"شرك"},{"id":12,"arabic":"لَحَبِطَ","translit":"َṭِbَḥَl","root":"حبط"},{"id":13,"arabic":"عَنْهُم","translit":"mُhْnَʿع","root":""},{"id":14,"arabic":"مَّا","translit":"āَّm","root":""},{"id":15,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":16,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":89,"text":"أُو۟لَٰٓئِكَ ٱلَّذِينَ ءَاتَيْنَٰهُمُ ٱلْكِتَٰبَ وَٱلْحُكْمَ وَٱلنُّبُوَّةَۚ فَإِن يَكْفُرْ بِهَا هَٰٓؤُلَآءِ فَقَدْ وَكَّلْنَا بِهَا قَوْمًا لَّيْسُوا۟ بِهَا بِكَٰفِرِينَ ","translation":"Those are the ones to whom We gave the Scripture and authority and prophethood. But if they [i.e., the disbelievers] deny it, then We have entrusted it to a people who are not therein disbelievers.","words":[{"id":1,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَاتَيْنَٰهُمُ","translit":"ُmُhَٰnْyَtāَء","root":"اتي"},{"id":4,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"وَٱلْحُكْمَ","translit":"َmْkُḥْlٱَw","root":"حكم"},{"id":6,"arabic":"وَٱلنُّبُوَّةَ","translit":"َẗَّwُbُّnlٱَw","root":"نبا"},{"id":7,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":8,"arabic":"يَكْفُرْ","translit":"ْrُfْkَy","root":"كفر"},{"id":9,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":10,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":11,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":12,"arabic":"وَكَّلْنَا","translit":"āَnْlَّkَw","root":"وكل"},{"id":13,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":14,"arabic":"قَوْمًا","translit":"āًmْwَq","root":"قوم"},{"id":15,"arabic":"لَّيْسُوا۟","translit":"۟āwُsْyَّl","root":"ليس"},{"id":16,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":17,"arabic":"بِكَٰفِرِينَ","translit":"َnyِrِfَٰkِb","root":"كفر"}],"hasIhya":false},{"ayah":90,"text":"أُو۟لَٰٓئِكَ ٱلَّذِينَ هَدَى ٱللَّهُۖ فَبِهُدَىٰهُمُ ٱقْتَدِهْۗ قُل لَّآ أَسْـَٔلُكُمْ عَلَيْهِ أَجْرًاۖ إِنْ هُوَ إِلَّا ذِكْرَىٰ لِلْعَٰلَمِينَ ","translation":"Those are the ones whom Allāh has guided, so from their guidance take an example. Say, \"I ask of you for it [i.e., this message] no payment. It is not but a reminder for the worlds.\"","words":[{"id":1,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"هَدَى","translit":"àَdَh","root":"هدي"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"فَبِهُدَىٰهُمُ","translit":"ُmُhٰàَdُhِbَf","root":"هدي"},{"id":6,"arabic":"ٱقْتَدِهْ","translit":"ْhِdَtْqٱ","root":"قدو"},{"id":7,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":8,"arabic":"لَّآ","translit":"ٓāَّl","root":""},{"id":9,"arabic":"أَسْـَٔلُكُمْ","translit":"ْmُkُlَٔـْsَaʾ","root":"سال"},{"id":10,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":11,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":12,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":13,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":14,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":15,"arabic":"ذِكْرَىٰ","translit":"ٰàَrْkِhd","root":"ذكر"},{"id":16,"arabic":"لِلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlِl","root":"علم"}],"hasIhya":false},{"ayah":91,"text":"وَمَا قَدَرُوا۟ ٱللَّهَ حَقَّ قَدْرِهِۦٓ إِذْ قَالُوا۟ مَآ أَنزَلَ ٱللَّهُ عَلَىٰ بَشَرٍ مِّن شَىْءٍۗ قُلْ مَنْ أَنزَلَ ٱلْكِتَٰبَ ٱلَّذِى جَآءَ بِهِۦ مُوسَىٰ نُورًا وَهُدًى لِّلنَّاسِۖ تَجْعَلُونَهُۥ قَرَاطِيسَ تُبْدُونَهَا وَتُخْفُونَ كَثِيرًاۖ وَعُلِّمْتُم مَّا لَمْ تَعْلَمُوٓا۟ أَنتُمْ وَلَآ ءَابَآؤُكُمْۖ قُلِ ٱللَّهُۖ ثُمَّ ذَرْهُمْ فِى خَوْضِهِمْ يَلْعَبُونَ ","translation":"And they did not appraise Allāh with true appraisal[1] when they said, \"Allāh did not reveal to a human being anything.\" Say, \"Who revealed the Scripture that Moses brought as light and guidance to the people? You [Jews] make it into pages, disclosing [some of] it and concealing much. And you[2] were taught that which you knew not - neither you nor your fathers.\" Say, \"Allāh [revealed it].\" Then leave them in their [empty] discourse, amusing themselves.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"قَدَرُوا۟","translit":"۟āwُrَdَq","root":"قدر"},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"حَقَّ","translit":"َّqَḥ","root":"حقق"},{"id":5,"arabic":"قَدْرِهِۦٓ","translit":"ٓۦِhِrْdَq","root":"قدر"},{"