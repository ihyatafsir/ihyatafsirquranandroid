"warsh"}, {"surah": 6, "ayah": 68, "text": "وَإِذَا رَأَيْتَ اَ۬لذِينَ يَخُوضُونَ فِےٓ ءَايَٰتِنَا فَأَعْرِضْ عَنْهُمْ حَتَّيٰ يَخُوضُواْ فِے حَدِيثٍ غَيْرِهِۦۖ وَإِمَّا يُنسِيَنَّكَ اَ۬لشَّيْطَٰنُ فَلَا تَقْعُدْ بَعْدَ اَ۬لذِّكْر۪يٰ مَعَ اَ۬لْقَوْمِ اِ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَأَيْتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَخُوضُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "ءَايَٰتِنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فَأَعْرِضْ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَخُوضُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِے", "translit": "", "root": ""}, {"id": 12, "arabic": "حَدِيثٍ", "translit": "", "root": ""}, {"id": 13, "arabic": "غَيْرِهِۦۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَإِمَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "يُنسِيَنَّكَ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لشَّيْطَٰنُ", "translit": "", "root": ""}, {"id": 17, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 18, "arabic": "تَقْعُدْ", "translit": "", "root": ""}, {"id": 19, "arabic": "بَعْدَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لذِّكْر۪يٰ", "translit": "", "root": ""}, {"id": 21, "arabic": "مَعَ", "translit": "", "root": ""}, {"id": 22, "arabic": "اَ۬لْقَوْمِ", "translit": "", "root": ""}, {"id": 23, "arabic": "اِ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 69, "text": "وَمَا عَلَي اَ۬لذِينَ يَتَّقُونَ مِنْ حِسَابِهِم مِّن شَےْءࣲۖ وَلَٰكِن ذِكْر۪يٰ لَعَلَّهُمْ يَتَّقُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَي", "translit": "", "