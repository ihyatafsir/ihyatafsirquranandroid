ranslation":"And [mention, O Muḥammad], the Day We will gather them all together; then We will say to those who associated others with Allāh, \"Where are your 'partners' that you used to claim [with Him]?\"","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"نَحْشُرُهُمْ","translit":"ْmُhُrُhsْḥَn","root":"حشر"},{"id":3,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":4,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":5,"arabic":"نَقُولُ","translit":"ُlwُqَn","root":"قول"},{"id":6,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":7,"arabic":"أَشْرَكُوٓا۟","translit":"۟āٓwُkَrْhsَaʾ","root":"شرك"},{"id":8,"arabic":"أَيْنَ","translit":"َnْyَaʾ","root":""},{"id":9,"arabic":"شُرَكَآؤُكُمُ","translit":"ُmُkُwʾٓāَkَrُhs","root":"شرك"},{"id":10,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":11,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":12,"arabic":"تَزْعُمُونَ","translit":"َnwُmُʿعْzَt","root":"زعم"}],"hasIhya":false},{"ayah":23,"text":"ثُمَّ لَمْ تَكُن فِتْنَتُهُمْ إِلَّآ أَن قَالُوا۟ وَٱللَّهِ رَبِّنَا مَا كُنَّا مُشْرِكِينَ ","translation":"Then there will be no [excuse upon] examination except they will say, \"By Allāh, our Lord, we were not those who associated.\"","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":3,"arabic":"تَكُن","translit":"nُkَt","root":"كون"},{"id":4,"arabic":"فِتْنَتُهُمْ","translit":"ْmُhُtَnْtِf","root":"فتن"},{"id":5,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":6,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":7,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":8,"arabic":"وَٱللَّهِ","translit":"ِhَّllٱَw","root":"اله"},{"id":9,"arabic":"رَبِّنَا","translit":"āَnِّbَr","root":"ربب"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":12,"arabic":"مُشْرِكِينَ","translit":"َnyِkِrْhsُm","root":"شرك"}],"hasIhya":false},{"ayah":24,"text":"ٱنظُرْ كَيْفَ كَذَبُوا۟ عَلَىٰٓ أَنفُسِهِمْۚ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ","translation":"See how they will lie about themselves. And lost from them will be what they used to invent.","words":[{"id":1,"arabic":"ٱنظُرْ","translit":"ْrُẓnٱ","root":"نظر"},{"id":2,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":3,"arabic":"كَذَبُوا۟","translit":"۟āwُbَhdَk","root":"كذب"},{"id":4,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":5,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":6,"arabic":"وَضَلَّ","translit":"َّlَḍَw","root":"ضلل"},{"id":7,"arabic":"عَنْهُم","translit":"mُhْnَʿع","root":""},{"id":8,"arabic":"مَّا","translit":"āَّm","root":""},{"id":9,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":10,"arabic":"يَفْتَرُونَ","translit":"َnwُrَtْfَy","root":"فري"}],"hasIhya":false},{"ayah":25,"text":"وَمِنْهُم مَّن يَسْتَمِعُ إِلَيْكَۖ وَجَعَلْنَا عَلَىٰ قُلُوبِهِمْ أَكِنَّةً أَن يَفْقَهُوهُ وَفِىٓ ءَاذَانِهِمْ وَقْرًاۚ وَإِن يَرَوْا۟ كُلَّ ءَايَةٍ لَّا يُؤْمِنُوا۟ بِهَاۚ حَتَّىٰٓ إِذَا جَآءُوكَ يُجَٰدِلُونَكَ يَقُولُ ٱلَّذِينَ كَفَرُوٓا۟ إِنْ هَٰذَآ إِلَّآ أَسَٰطِيرُ ٱلْأَوَّلِينَ ","translation":"And among them are those who listen to you,[1] but We have placed over their hearts coverings, lest they understand it, and in their ears deafness. And if they should see every sign, they will not believe in it. Even when they come to you arguing with you, those who disbelieve say, \"This is not but legends of the former peoples.\"","words":[{"id":1,"arabic":"وَمِنْهُم","translit":"mُhْnِmَw","root":""},{"id":2,"arabic":"مَّن","translit":"nَّm","root":""},{"id":3,"arabic":"يَسْتَمِعُ","translit":"ُʿعِmَtْsَy","root":"سمع"},{"id":4,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":5,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":6,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":7,"arabic":"قُلُوبِهِمْ","tr