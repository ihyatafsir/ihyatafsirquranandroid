ic": "لِلْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 91, "text": "۞وَمَا قَدَرُواْ اُ۬للَّهَ حَقَّ قَدْرِهِۦٓ إِذْ قَالُواْ مَآ أَنزَلَ اَ۬للَّهُ عَلَيٰ بَشَرࣲ مِّن شَےْءࣲۖ قُلْ مَنَ اَنزَلَ اَ۬لْكِتَٰبَ اَ۬لذِے جَآءَ بِهِۦ مُوس۪يٰ نُوراࣰ وَهُديࣰ لِّلنَّاسِۖ تَجْعَلُونَهُۥ قَرَاطِيسَ تُبْدُونَهَا وَتُخْفُونَ كَثِيراࣰۖ وَعُلِّمْتُم مَّا لَمْ تَعْلَمُوٓاْ أَنتُمْ وَلَآ ءَابَآؤُكُمْ قُلِ اِ۬للَّهُۖ ثُمَّ ذَرْهُمْ فِے خَوْضِهِمْ يَلْعَبُونَۖ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "قَدَرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 4, "arabic": "حَقَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَدْرِهِۦٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "بَشَرࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 14, "arabic": "شَےْءࣲۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 16, "arabic": "مَنَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَنزَلَ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬لْكِتَٰبَ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 20, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 21, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 22, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 23, "arabic": "نُوراࣰ", "translit": "", "root": ""}, {"id": 24, "arabic": "وَهُديࣰ", "translit": "", "root": ""}, {"id": 25, "arabic": "لِّلنَّاسِۖ", "translit