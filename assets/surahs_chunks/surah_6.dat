":"وَهُوَ اَ۬لْقَاهِرُ فَوْقَ عِبَادِهِۦۖ وَهُوَ اَ۬لْحَكِيمُ اُ۬لْخَبِيرُۖ","words":[{"id":1,"arabic":"وَهُوَ","translit":"","root":""},{"id":2,"arabic":"اَ۬لْقَاهِرُ","translit":"","root":""},{"id":3,"arabic":"فَوْقَ","translit":"","root":""},{"id":4,"arabic":"عِبَادِهِۦۖ","translit":"","root":""},{"id":5,"arabic":"وَهُوَ","translit":"","root":""},{"id":6,"arabic":"اَ۬لْحَكِيمُ","translit":"","root":""},{"id":7,"arabic":"اُ۬لْخَبِيرُۖ","translit":"","root":""}],"narration":"warsh"},{"surah":6,"ayah":19,"text":"قُلَ اَيُّ شَےْءٍ اَكْبَرُ شَهَٰدَةࣰ قُلِ اِ۬للَّهُۖ شَهِيدُۢ بَيْنِے وَبَيْنَكُمْۖ وَأُوحِيَ إِلَيَّ هَٰذَا اَ۬لْقُرْءَانُ لِأُنذِرَكُم بِهِۦ وَمَنۢ بَلَغَۖ أَئِنَّكُمْ لَتَشْهَدُونَ أَنَّ مَعَ اَ۬للَّهِ ءَالِهَةً ا۟خْر۪يٰ قُل لَّآ أَشْهَدُۖ قُلِ اِنَّمَا هُوَ إِلَٰهࣱ وَٰحِدࣱۖ وَإِنَّنِے بَرِےٓءࣱ مِّمَّا تُشْرِكُونَۖ","words":[{"id":1,"arabic":"قُلَ","translit":"","root":""},{"id":2,"arabic":"اَيُّ","translit":"","root":""},{"id":3,"arabic":"شَےْءٍ","translit":"","root":""},{"id":4,"arabic":"اَكْبَرُ","translit":"","root":""},{"id":5,"arabic":"شَهَٰدَةࣰ","translit":"","root":""},{"id":6,"arabic":"قُلِ","translit":"","root":""},{"id":7,"arabic":"اِ۬للَّهُۖ","translit":"","root":""},{"id":8,"arabic":"شَهِيدُۢ","translit":"","root":""},{"id":9,"arabic":"بَيْنِے","translit":"","root":""},{"id":10,"arabic":"وَبَيْنَكُمْۖ","translit":"","root":""},{"id":11,"arabic":"وَأُوحِيَ","translit":"","root":""},{"id":12,"arabic":"إِلَيَّ","translit":"","root":""},{"id":13,"arabic":"هَٰذَا","translit":"","root":""},{"id":14,"arabic":"اَ۬لْقُرْءَانُ","translit":"","root":""},{"id":15,"arabic":"لِأُنذِرَكُم","translit":"","root":""},{"id":16,"arabic":"بِهِۦ","translit":"","root":""},{"id":17,"arabic":"وَمَنۢ","translit":"","root":""},{"id":18,"arabic":"بَلَغَۖ","translit":"","root":""},{"id":19,"arabic":"أَئِنَّكُمْ","translit":"","root":""},{"id":20,"arabic":"لَتَشْهَدُونَ","translit":"","root":""},{"id":21,"arabic":"أَنَّ","translit":"","root":""},{"id":22,"