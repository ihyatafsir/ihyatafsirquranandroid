xt": "۞وَمَا نُرْسِلُ اُ۬لْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ وَمُنذِرِينَۖ فَمَنَ اٰمَنَ وَأَصْلَحَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَۖ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نُرْسِلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمُرْسَلِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "مُبَشِّرِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمُنذِرِينَۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَمَنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اٰمَنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَأَصْلَحَ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 11, "arabic": "خَوْفٌ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 14, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَحْزَنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 49, "text": "وَالذِينَ كَذَّبُواْ بِـَٔايَٰتِنَا يَمَسُّهُمُ اُ۬لْعَذَابُ بِمَا كَانُواْ يَفْسُقُونَۖ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَّبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِـَٔايَٰتِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَمَسُّهُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْعَذَابُ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَفْسُقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 50, "text": "قُل لَّآ أَقُولُ لَكُمْ عِندِے خَزَآئِنُ اُ۬للَّهِ وَلَآ أَعْلَمُ اُ۬لْغَيْبَ وَلَآ أَقُولُ لَكُمُۥٓ إِنِّے مَلَكٌۖ اِنَ اَتَّبِعُ إِلَّا مَا يُوح۪يٰٓ إِلَيَّۖ قُلْ هَلْ يَسْتَوِے