مْۖ وَاجْتَبَيْنَٰهُمْ وَهَدَيْنَٰهُمُۥٓ إِلَيٰ صِرَٰطࣲ مُّسْتَقِيمࣲۖ", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اٰبَآئِهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَذُرِّيَّٰتِهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَإِخْوَٰنِهِمْۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاجْتَبَيْنَٰهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهَدَيْنَٰهُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "صِرَٰطࣲ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّسْتَقِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 88, "text": "ذَٰلِكَ هُدَي اَ۬للَّهِ يَهْدِے بِهِۦ مَنْ يَّشَآءُ مِنْ عِبَادِهِۦۖ وَلَوَ اَشْرَكُواْ لَحَبِطَ عَنْهُم مَّا كَانُواْ يَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُدَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَهْدِے", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَّشَآءُ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "عِبَادِهِۦۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَشْرَكُواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَحَبِطَ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَنْهُم", "translit": "", "root": ""}, {"id": 14, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 16, "arabic": "يَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 89, "text": "أُوْلَٰٓئِكَ اَ۬لذِينَ ءَاتَيْنَٰهُمُ اُ۬لْكِتَٰبَ وَالْحُكْمَ وَالنُّبُوٓءَةَۖ فَإِنْ يَ