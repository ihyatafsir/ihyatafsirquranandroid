c": "لَا", "translit": "āَl", "root": ""}, {"id": 38, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 39, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 40, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 145, "text": "قُل لَّآ أَجِدُ فِى مَآ أُوحِىَ إِلَىَّ مُحَرَّمًا عَلَىٰ طَاعِمٍ يَطْعَمُهُۥٓ إِلَّآ أَن يَكُونَ مَيْتَةً أَوْ دَمًا مَّسْفُوحًا أَوْ لَحْمَ خِنزِيرٍ فَإِنَّهُۥ رِجْسٌ أَوْ فِسْقًا أُهِلَّ لِغَيْرِ ٱللَّهِ بِهِۦۚ فَمَنِ ٱضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ رَبَّكَ غَفُورٌ رَّحِيمٌ ", "translation": "Say, \"I do not find within that which was revealed to me [anything] forbidden to one who would eat it unless it be a dead animal or blood spilled out or the flesh of swine - for indeed, it is impure - or it be [that slaughtered in] disobedience, dedicated to other than Allāh.[1] But whoever is forced [by necessity], neither desiring [it] nor transgressing [its limit], then indeed, your Lord is Forgiving and Merciful.\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 3, "arabic": "أَجِدُ", "translit": "ُdِjgَaʾ", "root": "وجد"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 6, "arabic": "أُوحِىَ", "translit": "َàِḥwُaʾ", "root": "وحي"}, {"id": 7, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 8, "arabic": "مُحَرَّمًا", "translit": "āًmَّrَḥُm", "root": "حرم"}, {"id": 9, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 10, "arabic": "طَاعِمٍ", "translit": "ٍmِʿعāَṭ", "root": "طعم"}, {"id": 11, "arabic": "يَطْعَمُهُۥٓ", "translit": "ٓۥُhُmَʿعْṭَy", "root": "طعم"}, {"id": 12, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 15, "arabic": "مَيْتَةً", "translit": "ًẗَtْyَm", "root": "موت"}, {"id": 16, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 17, "arabic": "دَمًا", "translit": "āًmَd", "root": "دمو"}, {"id": 18, "arabic": "مَّسْفُوحًا", "translit": "āًḥwُfْsَّm", "root": "سفح"}, {"id": 19, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 20, "arabic": "لَحْمَ", "translit": "َmْḥَl", "root": "لحم"}, {"id": 21, "arabic": "خِنزِيرٍ", "translit": "ٍryِznِhk", "root": "خنزر"}, {"id": 22, "arabic": "فَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَf", "root": ""}, {"id": 23, "arabic": "رِجْسٌ", "translit": "ٌsْjgِr", "root": "رجس"}, {"id": 24, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 25, "arabic": "فِسْقًا", "translit": "āًqْsِf", "root": "فسق"}, {"id": 26, "arabic": "أُهِلَّ", "translit": "َّlِhُaʾ", "root": "هلل"}, {"id": 27, "arabic": "لِغَيْرِ", "translit": "ِrْyَغِl", "root": "غير"}, {"id": 28, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 30, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 31, "arabic": "ٱضْطُرَّ", "translit": "َّrُṭْḍٱ", "root": "ضرر"}, {"id": 32, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 33, "arabic": "بَاغٍ", "translit": "ٍغāَb", "root": "بغي"}, {"id": 34, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 35, "arabic": "عَادٍ", "translit": "ٍdāَʿع", "root": "عدو"}, {"id": 36, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 37, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 38, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 39, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 146, "text": "وَعَلَى ٱلَّذِينَ هَادُوا۟ حَرَّمْنَا كُلَّ ذِى ظُفُرٍۖ وَمِنَ ٱلْبَقَرِ وَٱلْغَنَمِ حَرَّمْنَا عَلَيْهِمْ شُحُومَهُمَآ إِلَّا مَا حَمَلَتْ ظُهُورُهُمَآ أَوِ ٱلْحَوَايَآ أَوْ مَا ٱخْتَلَطَ بِعَظْمٍۚ ذَٰلِكَ جَزَيْنَٰهُم بِبَغْيِهِمْۖ وَإِنَّا لَصَٰدِقُونَ ", "translation": "And to those who are Jews We prohibited every animal of uncloven hoof; and of the cattle and the sheep We prohibited to them their fat, except what adheres to their backs or the entrails or what is joined with bone. [By] that We repaid them for their transgression. And indeed, We are truthful.", "words": [{"id": 1, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 4, "arabic": "حَرَّمْنَا", "translit": "āَnْmَّrَḥ", "root": "حرم"}, {"id": 5, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 6, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 7, "arabic": "ظُفُرٍ", "translit": "ٍrُfُẓ", "root": "ظفر"}, {"id": 8, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 9, "arabic": "ٱلْبَقَرِ", "translit": "ِrَqَbْlٱ", "root": "بقر"}, {"id": 10, "arabic": "وَٱلْغَنَمِ", "translit": "ِmَnَغْlٱَw", "root": "غنم"}, {"id": 11, "arabic": "حَرَّمْنَا", "translit": "āَnْmَّrَḥ", "root": "حرم"}, {"id": 12, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "شُحُومَهُمَآ", "translit": "ٓāَmُhَmwُḥُhs", "root": "شحم"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "حَمَلَتْ", "translit": "ْtَlَmَḥ", "root": "حمل"}, {"id": 17, "arabic": "ظُهُورُهُمَآ", "translit": "ٓāَmُhُrwُhُẓ", "root": "ظهر"}, {"id": 18, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 19, "arabic": "ٱلْحَوَايَآ", "translit": "ٓāَyāَwَḥْlٱ", "root": "حوي"}, {"id": 20, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 21, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 22, "arabic": "ٱخْتَلَطَ", "translit": "َṭَlَtْhkٱ", "root": "خلط"}, {"id": 23, "arabic": "بِعَظْمٍ", "translit": "ٍmْẓَʿعِb", "root": "عظم"}, {"id": 24, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 25, "arabic": "جَزَيْنَٰهُم", "translit": "mُhَٰnْyَzَjg", "root": "جزي"}, {"id": 26, "arabic": "بِبَغْيِهِمْ", "translit": "ْmِhِyْغَbِb", "root": "بغي"}, {"id": 27, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 28, "arabic": "لَصَٰدِقُونَ", "translit": "َnwُqِdَٰṣَl", "root": "صدق"}], "hasIhya": false}, {"ayah": 147, "text": "فَإِن كَذَّبُوكَ فَقُل رَّبُّكُمْ ذُو رَحْمَةٍ وَٰسِعَةٍ وَلَا يُرَدُّ بَأْسُهُۥ عَنِ ٱلْقَوْمِ ٱلْمُجْرِمِينَ ", "translation": "So if they deny you, [O Muḥammad], say, \"Your Lord is the possessor of vast mercy; but His punishment cannot be repelled from the people who are criminals.\"", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "كَذَّبُوكَ", "translit": "َkwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "فَقُل", "translit": "lُqَf", "root": "قول"}, {"id": 4, "arabic": "رَّبُّكُمْ", "translit": "ْmُkُّbَّr", "root": "ربب"}, {"id": 5, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 6, "arabic": "رَحْمَةٍ", "translit": "ٍẗَmْḥَr", "root": "رحم"}, {"id": 7, "arabic": "وَٰسِعَةٍ", "translit": "ٍẗَʿعِsَٰw", "root": "وسع"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "يُرَدُّ", "translit": "ُّdَrُy", "root": "ردد"}, {"id": 10, "arabic": "بَأْسُهُۥ", "translit": "ۥُhُsْaʾَb", "root": "باس"}, {"id": 11, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 12, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 13, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 148, "text": "سَيَقُولُ ٱلَّذِينَ أَشْرَكُوا۟ لَوْ شَآءَ ٱللَّهُ مَآ أَشْرَكْنَا وَلَآ ءَابَآؤُنَا وَلَا حَرَّمْنَا مِن شَىْءٍۚ كَذَٰلِكَ كَذَّبَ ٱلَّذِينَ مِن قَبْلِهِمْ حَتَّىٰ ذَاقُوا۟ بَأْسَنَاۗ قُلْ هَلْ عِندَكُم مِّنْ عِلْمٍ فَتُخْرِجُوهُ لَنَآۖ إِن تَتَّبِعُونَ إِلَّا ٱلظَّنَّ وَإِنْ أَنتُمْ إِلَّا تَخْرُصُونَ ", "translation": "Those who associated [others] with Allāh will say, \"If Allāh had willed, we would not have associated [anything] and neither would our fathers, nor would we have prohibited anything.\" Likewise did those before deny until they tasted Our punishment. Say, \"Do you have any knowledge that you can produce for us? You follow not except assumption, and you are not but misjudging.\"", "words": [{"id": 1, "arabic": "سَيَقُولُ", "translit": "ُlwُqَyَs", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 4, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 5, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 8, "arabic": "أَشْرَكْنَا", "translit": "āَnْkَrْhsَaʾ", "root": "شرك"}, {"id": 9, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 10, "arabic": "ءَابَآؤُنَا", "translit": "āَnُwʾٓāَbāَء", "root": "ابو"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "حَرَّمْنَا", "translit": "āَnْmَّrَḥ", "root": "حرم"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 15, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 16, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 17, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 20, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 21, "arabic": "ذَاقُوا۟", "translit": "۟āwُqāَhd", "root": "ذوق"}, {"id": 22, "arabic": "بَأْسَنَا", "translit": "āَnَsْaʾَb", "root": "باس"}, {"id": 23, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 24, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 25, "arabic": "عِندَكُم", "translit": "mُkَdnِʿع", "root": "عند"}, {"id": 26, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 27, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 28, "arabic": "فَتُخْرِجُوهُ", "translit": "ُhwُjgِrْhkُtَf", "root": "خرج"}, {"id": 29, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 30, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 31, "arabic": "تَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَt", "root": "تبع"}, {"id": 32, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 33, "arabic": "ٱلظَّنَّ", "translit": "َّnَّẓlٱ", "root": "ظنن"}, {"id": 34, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 35, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 36, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 37, "arabic": "تَخْرُصُونَ", "translit": "َnwُṣُrْhkَt", "root": "خرص"}], "hasIhya": true}, {"ayah": 149, "text": "قُلْ فَلِلَّهِ ٱلْحُجَّةُ ٱلْبَٰلِغَةُۖ فَلَوْ شَآءَ لَهَدَىٰكُمْ أَجْمَعِينَ ", "translation": "Say, \"With Allāh is the far-reaching [i.e., conclusive] argument. If He had willed, He would have guided you all.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "فَلِلَّهِ", "translit": "ِhَّlِlَf", "root": "اله"}, {"id": 3, "arabic": "ٱلْحُجَّةُ", "translit": "ُẗَّjgُḥْlٱ", "root": "حجج"}, {"id": 4, "arabic": "ٱلْبَٰلِغَةُ", "translit": "ُẗَغِlَٰbْlٱ", "root": "بلغ"}, {"id": 5, "arabic": "فَلَوْ", "translit": "ْwَlَf", "root": ""}, {"id": 6, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 7, "arabic": "لَهَدَىٰكُمْ", "translit": "ْmُkٰàَdَhَl", "root": "هدي"}, {"id": 8, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": true}, {"ayah": 150, "text": "قُلْ هَلُمَّ شُهَدَآءَكُمُ ٱلَّذِينَ يَشْهَدُونَ أَنَّ ٱللَّهَ حَرَّمَ هَٰذَاۖ فَإِن شَهِدُوا۟ فَلَا تَشْهَدْ مَعَهُمْۚ وَلَا تَتَّبِعْ أَهْوَآءَ ٱلَّذِينَ كَذَّبُوا۟ بِـَٔايَٰتِنَا وَٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ وَهُم بِرَبِّهِمْ يَعْدِلُونَ ", "translation": "Say, [O Muḥammad], \"Bring forward your witnesses who will testify that Allāh has prohibited this.\" And if they testify, do not testify with them. And do not follow the desires of those who deny Our verses and those who do not believe in the Hereafter, while they equate [others] with their Lord.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هَلُمَّ", "translit": "َّmُlَh", "root": "هلم"}, {"id": 3, "arabic": "شُهَدَآءَكُمُ", "translit": "ُmُkَءٓāَdَhُhs", "root": "شهد"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَشْهَدُونَ", "translit": "َnwُdَhْhsَy", "root": "شهد"}, {"id": 6, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 9, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 10, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 11, "arabic": "شَهِدُوا۟", "translit": "۟āwُdِhَhs", "root": "شهد"}, {"id": 12, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 13, "arabic": "تَشْهَدْ", "translit": "ْdَhْhsَt", "root": "شهد"}, {"id": 14, "arabic": "مَعَهُمْ", "translit": "ْmُhَʿعَm", "root": ""}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "تَتَّبِعْ", "translit": "ْʿعِbَّtَt", "root": "تبع"}, {"id": 17, "arabic": "أَهْوَآءَ", "translit": "َءٓāَwْhَaʾ", "root": "هوي"}, {"id": 18, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 19, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 20, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 21, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 22, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 23, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 24, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 25, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 26, "arabic": "بِرَبِّهِمْ", "translit": "ْmِhِّbَrِb", "root": "ربب"}, {"id": 27, "arabic": "يَعْدِلُونَ", "translit": "َnwُlِdْʿعَy", "root": "عدل"}], "hasIhya": false}, {"ayah": 151, "text": "قُلْ تَعَالَوْا۟ أَتْلُ مَا حَرَّمَ رَبُّكُمْ عَلَيْكُمْۖ أَلَّا تُشْرِكُوا۟ بِهِۦ شَيْـًٔاۖ وَبِٱلْوَٰلِدَيْنِ إِحْسَٰنًاۖ وَلَا تَقْتُلُوٓا۟ أَوْلَٰدَكُم مِّنْ إِمْلَٰقٍۖ نَّحْنُ نَرْزُقُكُمْ وَإِيَّاهُمْۖ وَلَا تَقْرَبُوا۟ ٱلْفَوَٰحِشَ مَا ظَهَرَ مِنْهَا وَمَا بَطَنَۖ وَلَا تَقْتُلُوا۟ ٱلنَّفْسَ ٱلَّتِى حَرَّمَ ٱللَّهُ إِلَّا بِٱلْحَقِّۚ ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ تَعْقِلُونَ ", "translation": "Say, \"Come, I will recite what your Lord has prohibited to you. [He commands] that you not associate anything with Him, and to parents, good treatment, and do not kill your children out of poverty; We will provide for you and them. And do not approach immoralities - what is apparent of them and what is concealed. And do not kill the soul which Allāh has forbidden [to be killed] except by [legal] right. This has He instructed you that you may use reason.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "تَعَالَوْا۟", "translit": "۟āْwَlāَʿعَt", "root": "علو"}, {"id": 3, "arabic": "أَتْلُ", "translit": "ُlْtَaʾ", "root": "تلو"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 6, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 7, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 9, "arabic": "تُشْرِكُوا۟", "translit": "۟āwُkِrْhsُt", "root": "شرك"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 12, "arabic": "وَبِٱلْوَٰلِدَيْنِ", "translit": "ِnْyَdِlَٰwْlٱِbَw", "root": "ولد"}, {"id": 13, "arabic": "إِحْسَٰنًا", "translit": "āًnَٰsْḥِiʾ", "root": "حسن"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "تَقْتُلُوٓا۟", "translit": "۟āٓwُlُtْqَt", "root": "قتل"}, {"id": 16, "arabic": "أَوْلَٰدَكُم", "translit": "mُkَdَٰlْwَaʾ", "root": "ولد"}, {"id": 17, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 18, "arabic": "إِمْلَٰقٍ", "translit": "ٍqَٰlْmِiʾ", "root": "ملق"}, {"id": 19, "arabic": "نَّحْنُ", "translit": "ُnْḥَّn", "root": ""}, {"id": 20, "arabic": "نَرْزُقُكُمْ", "translit": "ْmُkُqُzْrَn", "root": "رزق"}, {"id": 21, "arabic": "وَإِيَّاهُمْ", "translit": "ْmُhāَّyِiʾَw", "root": ""}, {"id": 22, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 23, "arabic": "تَقْرَبُوا۟", "translit": "۟āwُbَrْqَt", "root": "قرب"}, {"id": 24, "arabic": "ٱلْفَوَٰحِشَ", "translit": "َhsِḥَٰwَfْlٱ", "root": "فحش"}, {"id": 25, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 26, "arabic": "ظَهَرَ", "translit": "َrَhَẓ", "root": "ظهر"}, {"id": 27, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 28, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 29, "arabic": "بَطَنَ", "translit": "َnَṭَb", "root": "بطن"}, {"id": 30, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 31, "arabic": "تَقْتُلُوا۟", "translit": "۟āwُlُtْqَt", "root": "قتل"}, {"id": 32, "arabic": "ٱلنَّفْسَ", "translit": "َsْfَّnlٱ", "root": "نفس"}, {"id": 33, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 34, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 35, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 36, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 37, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 38, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 39, "arabic": "وَصَّىٰكُم", "translit": "mُkٰàَّṣَw", "root": "وصي"}, {"id": 40, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 41, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 42, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": true}, {"ayah": 152, "text": "وَلَا تَقْرَبُوا۟ مَالَ ٱلْيَتِيمِ إِلَّا بِٱلَّتِى هِىَ أَحْسَنُ حَتَّىٰ يَبْلُغَ أَشُدَّهُۥۖ وَأَوْفُوا۟ ٱلْكَيْلَ وَٱلْمِيزَانَ بِٱلْقِسْطِۖ لَا نُكَلِّفُ نَفْسًا إِلَّا وُسْعَهَاۖ وَإِذَا قُلْتُمْ فَٱعْدِلُوا۟ وَلَوْ كَانَ ذَا قُرْبَىٰۖ وَبِعَهْدِ ٱللَّهِ أَوْفُوا۟ۚ ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ تَذَكَّرُونَ ", "translation": "And do not approach the orphan's property except in a way that is best [i.e., intending improvement] until he reaches maturity. And give full measure and weight in justice. We do not charge any soul except [with that within] its capacity. And when you speak [i.e., testify], be just, even if [it concerns] a near relative. And the covenant of Allāh fulfill. This has He instructed you that you may remember.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَقْرَبُوا۟", "translit": "۟āwُbَrْqَt", "root": "قرب"}, {"id": 3, "arabic": "مَالَ", "translit": "َlāَm", "root": "مول"}, {"id": 4, "arabic": "ٱلْيَتِيمِ", "translit": "ِmyِtَyْlٱ", "root": "يتم"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "بِٱلَّتِى", "translit": "àِtَّlٱِb", "root": ""}, {"id": 7, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 8, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 9, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 10, "arabic": "يَبْلُغَ", "translit": "َغُlْbَy", "root": "بلغ"}, {"id": 11, "arabic": "أَشُدَّهُۥ", "translit": "ۥُhَّdُhsَaʾ", "root": "شدد"}, {"id": 12, "arabic": "وَأَوْفُوا۟", "translit": "۟āwُfْwَaʾَw", "root": "وفي"}, {"id": 13, "arabic": "ٱلْكَيْلَ", "translit": "َlْyَkْlٱ", "root": "كيل"}, {"id": 14, "arabic": "وَٱلْمِيزَانَ", "translit": "َnāَzyِmْlٱَw", "root": "وزن"}, {"id": 15, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "نُكَلِّفُ", "translit": "ُfِّlَkُn", "root": "كلف"}, {"id": 18, "arabic": "نَفْسًا", "translit": "āًsْfَn", "root": "نفس"}, {"id": 19, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 20, "arabic": "وُسْعَهَا", "translit": "āَhَʿعْsُw", "root": "وسع"}, {"id": 21, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 22, "arabic": "قُلْتُمْ", "translit": "ْmُtْlُq", "root": "قول"}, {"id": 23, "arabic": "فَٱعْدِلُوا۟", "translit": "۟āwُlِdْʿعٱَf", "root": "عدل"}, {"id": 24, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 25, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 26, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 27, "arabic": "قُرْبَىٰ", "translit": "ٰàَbْrُq", "root": "قرب"}, {"id": 28, "arabic": "وَبِعَهْدِ", "translit": "ِdْhَʿعِbَw", "root": "عهد"}, {"id": 29, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "أَوْفُوا۟", "translit": "۟āwُfْwَaʾ", "root": "وفي"}, {"id": 31, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 32, "arabic": "وَصَّىٰكُم", "translit": "mُkٰàَّṣَw", "root": "وصي"}, {"id": 33, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 34, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 35, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 153, "text": "وَأَنَّ هَٰذَا صِرَٰطِى مُسْتَقِيمًا فَٱتَّبِعُوهُۖ وَلَا تَتَّبِعُوا۟ ٱلسُّبُلَ فَتَفَرَّقَ بِكُمْ عَن سَبِيلِهِۦۚ ذَٰلِكُمْ وَصَّىٰكُم بِهِۦ لَعَلَّكُمْ تَتَّقُونَ ", "translation": "And, [moreover], this is My path, which is straight, so follow it; and do not follow [other] ways, for you will be separated from His way. This has He instructed you that you may become righteous.", "words": [{"id": 1, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "صِرَٰطِى", "translit": "àِṭَٰrِṣ", "root": "صرط"}, {"id": 4, "arabic": "مُسْتَقِيمًا", "translit": "āًmyِqَtْsُm", "root": "قوم"}, {"id": 5, "arabic": "فَٱتَّبِعُوهُ", "translit": "ُhwُʿعِbَّtٱَf", "root": "تبع"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtَt", "root": "تبع"}, {"id": 8, "arabic": "ٱلسُّبُلَ", "translit": "َlُbُّslٱ", "root": "سبل"}, {"id": 9, "arabic": "فَتَفَرَّقَ", "translit": "َqَّrَfَtَf", "root": "فرق"}, {"id": 10, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 11, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 12, "arabic": "سَبِيلِهِۦ", "translit": "ۦِhِlyِbَs", "root": "سبل"}, {"id": 13, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 14, "arabic": "وَصَّىٰكُم", "translit": "mُkٰàَّṣَw", "root": "وصي"}, {"id": 15, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 16, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 17, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": true}, {"ayah": 154, "text": "ثُمَّ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ تَمَامًا عَلَى ٱلَّذِىٓ أَحْسَنَ وَتَفْصِيلًا لِّكُلِّ شَىْءٍ وَهُدًى وَرَحْمَةً لَّعَلَّهُم بِلِقَآءِ رَبِّهِمْ يُؤْمِنُونَ ", "translation": "Then[1] We gave Moses the Scripture, making complete [Our favor] upon the one who did good [i.e., Moses] and as a detailed explanation of all things and as guidance and mercy that perhaps in the meeting with their Lord they would believe.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "تَمَامًا", "translit": "āًmāَmَt", "root": "تمم"}, {"id": 6, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "أَحْسَنَ", "translit": "َnَsْḥَaʾ", "root": "حسن"}, {"id": 9, "arabic": "وَتَفْصِيلًا", "translit": "āًlyِṣْfَtَw", "root": "فصل"}, {"id": 10, "arabic": "لِّكُلِّ", "translit": "ِّlُkِّl", "root": "كلل"}, {"id": 11, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 12, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 13, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 14, "arabic": "لَّعَلَّهُم", "translit": "mُhَّlَʿعَّl", "root": ""}, {"id": 15, "arabic": "بِلِقَآءِ", "translit": "ِءٓāَqِlِb", "root": "لقي"}, {"id": 16, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 17, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 155, "text": "وَهَٰذَا كِتَٰبٌ أَنزَلْنَٰهُ مُبَارَكٌ فَٱتَّبِعُوهُ وَٱتَّقُوا۟ لَعَلَّكُمْ تُرْحَمُونَ ", "translation": "And this [Qur’ān] is a Book We have revealed [which is] blessed, so follow it and fear Allāh that you may receive mercy.", "words": [{"id": 1, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 2, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 3, "arabic": "أَنزَلْنَٰهُ", "translit": "ُhَٰnْlَznَaʾ", "root": "نزل"}, {"id": 4, "arabic": "مُبَارَكٌ", "translit": "ٌkَrāَbُm", "root": "برك"}, {"id": 5, "arabic": "فَٱتَّبِعُوهُ", "translit": "ُhwُʿعِbَّtٱَf", "root": "تبع"}, {"id": 6, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 7, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 8, "arabic": "تُرْحَمُونَ", "translit": "َnwُmَḥْrُt", "root": "رحم"}], "hasIhya": false}, {"ayah": 156, "text": "أَن تَقُولُوٓا۟ إِنَّمَآ أُنزِلَ ٱلْكِتَٰبُ عَلَىٰ طَآئِفَتَيْنِ مِن قَبْلِنَا وَإِن كُنَّا عَن دِرَاسَتِهِمْ لَغَٰفِلِينَ ", "translation": "[We revealed it] lest you say, \"The Scripture was only sent down to two groups before us, but we were of their study unaware,\"", "words": [{"id": 1, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 2, "arabic": "تَقُولُوٓا۟", "translit": "۟āٓwُlwُqَt", "root": "قول"}, {"id": 3, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 4, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 5, "arabic": "ٱلْكِتَٰبُ", "translit": "ُbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "طَآئِفَتَيْنِ", "translit": "ِnْyَtَfِyʾٓāَṭ", "root": "طوف"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قَبْلِنَا", "translit": "āَnِlْbَq", "root": "قبل"}, {"id": 10, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 11, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 12, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 13, "arabic": "دِرَاسَتِهِمْ", "translit": "ْmِhِtَsāَrِd", "root": "درس"}, {"id": 14, "arabic": "لَغَٰفِلِينَ", "translit": "َnyِlِfَٰغَl", "root": "غفل"}], "hasIhya": false}, {"ayah": 157, "text": "أَوْ تَقُولُوا۟ لَوْ أَنَّآ أُنزِلَ عَلَيْنَا ٱلْكِتَٰبُ لَكُنَّآ أَهْدَىٰ مِنْهُمْۚ فَقَدْ جَآءَكُم بَيِّنَةٌ مِّن رَّبِّكُمْ وَهُدًى وَرَحْمَةٌۚ فَمَنْ أَظْلَمُ مِمَّن كَذَّبَ بِـَٔايَٰتِ ٱللَّهِ وَصَدَفَ عَنْهَاۗ سَنَجْزِى ٱلَّذِينَ يَصْدِفُونَ عَنْ ءَايَٰتِنَا سُوٓءَ ٱلْعَذَابِ بِمَا كَانُوا۟ يَصْدِفُونَ ", "translation": "Or lest you say, \"If only the Scripture had been revealed to us, we would have been better guided than they.\" So there has [now] come to you a clear evidence from your Lord and a guidance and mercy. Then who is more unjust than one who denies the verses of Allāh and turns away from them? We will recompense those who turn away from Our verses with the worst of punishment for their having turned away.", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 3, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 4, "arabic": "أَنَّآ", "translit": "ٓāَّnَaʾ", "root": ""}, {"id": 5, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 6, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلْكِتَٰبُ", "translit": "ُbَٰtِkْlٱ", "root": "كتب"}, {"id": 8, "arabic": "لَكُنَّآ", "translit": "ٓāَّnُkَl", "root": "كون"}, {"id": 9, "arabic": "أَهْدَىٰ", "translit": "ٰàَdْhَaʾ", "root": "هدي"}, {"id": 10, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 11, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 12, "arabic": "جَآءَكُم", "translit": "mُkَءٓāَjg", "root": "جيا"}, {"id": 13, "arabic": "بَيِّنَةٌ", "translit": "ٌẗَnِّyَb", "root": "بين"}, {"id": 14, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 15, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 16, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 17, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 18, "arabic": "فَمَنْ", "translit": "ْnَmَf", "root": ""}, {"id": 19, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 20, "arabic": "مِمَّن", "translit": "nَّmِm", "root": ""}, {"id": 21, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 22, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "وَصَدَفَ", "translit": "َfَdَṣَw", "root": "صدف"}, {"id": 25, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 26, "arabic": "سَنَجْزِى", "translit": "àِzْjgَnَs", "root": "جزي"}, {"id": 27, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 28, "arabic": "يَصْدِفُونَ", "translit": "َnwُfِdْṣَy", "root": "صدف"}, {"id": 29, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 30, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 31, "arabic": "سُوٓءَ", "translit": "َءٓwُs", "root": "سوا"}, {"id": 32, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 33, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 34, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 35, "arabic": "يَصْدِفُونَ", "translit": "َnwُfِdْṣَy", "root": "صدف"}], "hasIhya": false}, {"ayah": 158, "text": "هَلْ يَنظُرُونَ إِلَّآ أَن تَأْتِيَهُمُ ٱلْمَلَٰٓئِكَةُ أَوْ يَأْتِىَ رَبُّكَ أَوْ يَأْتِىَ بَعْضُ ءَايَٰتِ رَبِّكَۗ يَوْمَ يَأْتِى بَعْضُ ءَايَٰتِ رَبِّكَ لَا يَنفَعُ نَفْسًا إِيمَٰنُهَا لَمْ تَكُنْ ءَامَنَتْ مِن قَبْلُ أَوْ كَسَبَتْ فِىٓ إِيمَٰنِهَا خَيْرًاۗ قُلِ ٱنتَظِرُوٓا۟ إِنَّا مُنتَظِرُونَ ", "translation": "Do they [then] wait for anything except that the angels should come to them or your Lord should come or that there come some of the signs[1] of your Lord? The Day that some of the signs of your Lord will come no soul will benefit from its faith as long as it had not believed before or had earned through its faith some good. Say, \"Wait. Indeed, we [also] are waiting.\"", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تَأْتِيَهُمُ", "translit": "ُmُhَyِtْaʾَt", "root": "اتي"}, {"id": 6, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "يَأْتِىَ", "translit": "َàِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "يَأْتِىَ", "translit": "َàِtْaʾَy", "root": "اتي"}, {"id": 12, "arabic": "بَعْضُ", "translit": "ُḍْʿعَb", "root": "بعض"}, {"id": 13, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 14, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 15, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 16, "arabic": "يَأْتِى", "translit": "àِtْaʾَy", "root": "اتي"}, {"id": 17, "arabic": "بَعْضُ", "translit": "ُḍْʿعَb", "root": "بعض"}, {"id": 18, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 19, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يَنفَعُ", "translit": "ُʿعَfnَy", "root": "نفع"}, {"id": 22, "arabic": "نَفْسًا", "translit": "āًsْfَn", "root": "نفس"}, {"id": 23, "arabic": "إِيمَٰنُهَا", "translit": "āَhُnَٰmyِiʾ", "root": "امن"}, {"id": 24, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 25, "arabic": "تَكُنْ", "translit": "ْnُkَt", "root": "كون"}, {"id": 26, "arabic": "ءَامَنَتْ", "translit": "ْtَnَmāَء", "root": "امن"}, {"id": 27, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 28, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 29, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 30, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 31, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 32, "arabic": "إِيمَٰنِهَا", "translit": "āَhِnَٰmyِiʾ", "root": "امن"}, {"id": 33, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 34, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 35, "arabic": "ٱنتَظِرُوٓا۟", "translit": "۟āٓwُrِẓَtnٱ", "root": "نظر"}, {"id": 36, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 37, "arabic": "مُنتَظِرُونَ", "translit": "َnwُrِẓَtnُm", "root": "نظر"}], "hasIhya": false}, {"ayah": 159, "text": "إِنَّ ٱلَّذِينَ فَرَّقُوا۟ دِينَهُمْ وَكَانُوا۟ شِيَعًا لَّسْتَ مِنْهُمْ فِى شَىْءٍۚ إِنَّمَآ أَمْرُهُمْ إِلَى ٱللَّهِ ثُمَّ يُنَبِّئُهُم بِمَا كَانُوا۟ يَفْعَلُونَ ", "translation": "Indeed, those who have divided their religion and become sects - you, [O Muḥammad], are not [associated] with them in anything. Their affair is only [left] to Allāh; then He will inform them about what they used to do.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فَرَّقُوا۟", "translit": "۟āwُqَّrَf", "root": "فرق"}, {"id": 4, "arabic": "دِينَهُمْ", "translit": "ْmُhَnyِd", "root": "دين"}, {"id": 5, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 6, "arabic": "شِيَعًا", "translit": "āًʿعَyِhs", "root": "شيع"}, {"id": 7, "arabic": "لَّسْتَ", "translit": "َtْsَّl", "root": "ليس"}, {"id": 8, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 11, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 12, "arabic": "أَمْرُهُمْ", "translit": "ْmُhُrْmَaʾ", "root": "امر"}, {"id": 13, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 16, "arabic": "يُنَبِّئُهُم", "translit": "mُhُyʾِّbَnُy", "root": "نبا"}, {"id": 17, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 18, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 19, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}, {"ayah": 160, "text": "مَن جَآءَ بِٱلْحَسَنَةِ فَلَهُۥ عَشْرُ أَمْثَالِهَاۖ وَمَن جَآءَ بِٱلسَّيِّئَةِ فَلَا يُجْزَىٰٓ إِلَّا مِثْلَهَا وَهُمْ لَا يُظْلَمُونَ ", "translation": "Whoever comes [on the Day of Judgement] with a good deed will have ten times the like thereof [to his credit], and whoever comes with an evil deed will not be recompensed except the like thereof; and they will not be wronged.[1]", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "بِٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱِb", "root": "حسن"}, {"id": 4, "arabic": "فَلَهُۥ", "translit": "ۥُhَlَf", "root": ""}, {"id": 5, "arabic": "عَشْرُ", "translit": "ُrْhsَʿع", "root": "عشر"}, {"id": 6, "arabic": "أَمْثَالِهَا", "translit": "āَhِlāَhtْmَaʾ", "root": "مثل"}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 9, "arabic": "بِٱلسَّيِّئَةِ", "translit": "ِẗَyʾِّyَّslٱِb", "root": "سوا"}, {"id": 10, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 11, "arabic": "يُجْزَىٰٓ", "translit": "ٰٓàَzْjgُy", "root": "جزي"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "مِثْلَهَا", "translit": "āَhَlْhtِm", "root": "مثل"}, {"id": 14, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 161, "text": "قُلْ إِنَّنِى هَدَىٰنِى رَبِّىٓ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ دِينًا قِيَمًا مِّلَّةَ إِبْرَٰهِيمَ حَنِيفًاۚ وَمَا كَانَ مِنَ ٱلْمُشْرِكِينَ ", "translation": "Say, \"Indeed, my Lord has guided me to a straight path - a correct religion - the way of Abraham, inclining toward truth. And he was not among those who associated others with Allāh.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّنِى", "translit": "àِnَّnِiʾ", "root": ""}, {"id": 3, "arabic": "هَدَىٰنِى", "translit": "àِnٰàَdَh", "root": "هدي"}, {"id": 4, "arabic": "رَبِّىٓ", "translit": "ٓàِّbَr", "root": "ربب"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 7, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}, {"id": 8, "arabic": "دِينًا", "translit": "āًnyِd", "root": "دين"}, {"id": 9, "arabic": "قِيَمًا", "translit": "āًmَyِq", "root": "قوم"}, {"id": 10, "arabic": "مِّلَّةَ", "translit": "َẗَّlِّm", "root": "ملل"}, {"id": 11, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 12, "arabic": "حَنِيفًا", "translit": "āًfyِnَḥ", "root": "حنف"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": true}, {"ayah": 162, "text": "قُلْ إِنَّ صَلَاتِى وَنُسُكِى وَمَحْيَاىَ وَمَمَاتِى لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "Say, \"Indeed, my prayer, my rites of sacrifice, my living and my dying are for Allāh, Lord of the worlds.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "صَلَاتِى", "translit": "àِtāَlَṣ", "root": "صلو"}, {"id": 4, "arabic": "وَنُسُكِى", "translit": "àِkُsُnَw", "root": "نسك"}, {"id": 5, "arabic": "وَمَحْيَاىَ", "translit": "َàāَyْḥَmَw", "root": "حيي"}, {"id": 6, "arabic": "وَمَمَاتِى", "translit": "àِtāَmَmَw", "root": "موت"}, {"id": 7, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 8, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 9, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 163, "text": "لَا شَرِيكَ لَهُۥۖ وَبِذَٰلِكَ أُمِرْتُ وَأَنَا۠ أَوَّلُ ٱلْمُسْلِمِينَ ", "translation": "No partner has He. And this I have been commanded, and I am the first [among you] of the Muslims.\"[1]", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "شَرِيكَ", "translit": "َkyِrَhs", "root": "شرك"}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "وَبِذَٰلِكَ", "translit": "َkِlَٰhdِbَw", "root": ""}, {"id": 5, "arabic": "أُمِرْتُ", "translit": "ُtْrِmُaʾ", "root": "امر"}, {"id": 6, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 7, "arabic": "أَوَّلُ", "translit": "ُlَّwَaʾ", "root": "اول"}, {"id": 8, "arabic": "ٱلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlٱ", "root": "سلم"}], "hasIhya": false}, {"ayah": 164, "text": "قُلْ أَغَيْرَ ٱللَّهِ أَبْغِى رَبًّا وَهُوَ رَبُّ كُلِّ شَىْءٍۚ وَلَا تَكْسِبُ كُلُّ نَفْسٍ إِلَّا عَلَيْهَاۚ وَلَا تَزِرُ وَازِرَةٌ وِزْرَ أُخْرَىٰۚ ثُمَّ إِلَىٰ رَبِّكُم مَّرْجِعُكُمْ فَيُنَبِّئُكُم بِمَا كُنتُمْ فِيهِ تَخْتَلِفُونَ ", "translation": "Say, \"Is it other than Allāh I should desire as a lord while He is the Lord of all things? And every soul earns not [blame] except against itself, and no bearer of burdens will bear the burden of another. Then to your Lord is your return, and He will inform you concerning that over which you used to differ.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَغَيْرَ", "translit": "َrْyَغَaʾ", "root": "غير"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "أَبْغِى", "translit": "àِغْbَaʾ", "root": "بغي"}, {"id": 5, "arabic": "رَبًّا", "translit": "āًّbَr", "root": "ربب"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 8, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 9, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تَكْسِبُ", "translit": "ُbِsْkَt", "root": "كسب"}, {"id": 12, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 13, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "تَزِرُ", "translit": "ُrِzَt", "root": "وزر"}, {"id": 18, "arabic": "وَازِرَةٌ", "translit": "ٌẗَrِzāَw", "root": "وزر"}, {"id": 19, "arabic": "وِزْرَ", "translit": "َrْzِw", "root": "وزر"}, {"id": 20, "arabic": "أُخْرَىٰ", "translit": "ٰàَrْhkُaʾ", "root": "اخر"}, {"id": 21, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 22, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 23, "arabic": "رَبِّكُم", "translit": "mُkِّbَr", "root": "ربب"}, {"id": 24, "arabic": "مَّرْجِعُكُمْ", "translit": "ْmُkُʿعِjgْrَّm", "root": "رجع"}, {"id": 25, "arabic": "فَيُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُyَf", "root": "نبا"}, {"id": 26, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 27, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 28, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 29, "arabic": "تَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَt", "root": "خلف"}], "hasIhya": true}, {"ayah": 165, "text": "وَهُوَ ٱلَّذِى جَعَلَكُمْ خَلَٰٓئِفَ ٱلْأَرْضِ وَرَفَعَ بَعْضَكُمْ فَوْقَ بَعْضٍ دَرَجَٰتٍ لِّيَبْلُوَكُمْ فِى مَآ ءَاتَىٰكُمْۗ إِنَّ رَبَّكَ سَرِيعُ ٱلْعِقَابِ وَإِنَّهُۥ لَغَفُورٌ رَّحِيمٌۢ ", "translation": "And it is He who has made you successors upon the earth and has raised some of you above others in degrees [of rank] that He may try you through what He has given you. Indeed, your Lord is swift in penalty; but indeed, He is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَكُمْ", "translit": "ْmُkَlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "خَلَٰٓئِفَ", "translit": "َfِyʾَٰٓlَhk", "root": "خلف"}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "وَرَفَعَ", "translit": "َʿعَfَrَw", "root": "رفع"}, {"id": 7, "arabic": "بَعْضَكُمْ", "translit": "ْmُkَḍْʿعَb", "root": "بعض"}, {"id": 8, "arabic": "فَوْقَ", "translit": "َqْwَf", "root": "فوق"}, {"id": 9, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 10, "arabic": "دَرَجَٰتٍ", "translit": "ٍtَٰjgَrَd", "root": "درج"}, {"id": 11, "arabic": "لِّيَبْلُوَكُمْ", "translit": "ْmُkَwُlْbَyِّl", "root": "بلو"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 14, "arabic": "ءَاتَىٰكُمْ", "translit": "ْmُkٰàَtāَء", "root": "اتي"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 17, "arabic": "سَرِيعُ", "translit": "ُʿعyِrَs", "root": "سرع"}, {"id": 18, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}, {"id": 19, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 20, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 21, "arabic": "رَّحِيمٌۢ", "translit": "ٌۢmyِḥَّr", "root": "رحم"}], "hasIhya": false}], "tafsir": {"1": [{"arabic": "بسم الله الرحمن الرحيم الحمد لله الذي خلق كل شيء فأحسن خلقه وترتيبه وأدب نبيه محمدا صلى الله عليه وسلم فأحسن تأديبه وزكى أوصافه وأخلاقه ثم اتخذه صفيه وحبيبه ووفق للإقتداء به من أراد تهذيبه وحرم عن التخلق بأخلاقه من أراد تخييبه صلى الله على سيدنا محمد سيد المرسلين وعلى آله الطيبين الطاهرين وسلم كثيرا أما بعد فإن آداب الظواهر عنوان آداب البواطن وحركات الجوارح ثمرات الخواطر والأعمال نتيجة الأخلاق والآداب رشح المعارف وسرائر القلوب هي مغارس الأفعال ومنابعها وأنوار السرائر هي التي تشرق على الظواهر فتز", "english": "In the name of Allah, the Most Gracious, the Most Merciful. All praise is to Allah who created everything and perfected its creation and arrangement, and educated His Prophet Muhammad (peace be upon him) and perfected his education, purified his attributes and character, then took him as His intimate friend and beloved, and granted success in following him to whoever desired refinement, and prevented from adopting his character whoever desired corruption. May Allah send blessings upon our master Muhammad, master of the messengers, and upon his pure and purified family, and grant abundant peace. Now then, indeed the manners of outward appearances are an indicator of the manners of the inner selves, and the movements of the limbs are fruits of thoughts, and actions are the result of character traits and manners. The effusion of knowledge and the secrets of the hearts (Qulub) are the planting grounds of deeds and their sources, and the lights of the secrets are what shine upon outward appearances, thus adorning them, revealing them, and replacing their unpleasantness and faults with beauties. Whoever's heart (Qalb) does not humble itself, his limbs do not humble themselves, and whoever's chest is not a niche for the divine lights does not overflow upon his outward appearance with the beauty of the prophetic manners. I had resolved to conclude the quarter of customs in this book with a comprehensive book on the manners of living, so that it would not be difficult for the seeker to extract them from all these books. Then I saw that each book in the quarter of customs has covered a collection of manners, so I found it burdensome to repeat and reiterate them, for seeking repetition is heavy, and souls are inherently disposed to opposing repeated things. Therefore, I decided to limit myself in this book to mentioning the manners of the Messenger of Allah (peace be upon him) and...", "book_file": "vol2_j2-k10.doc.txt", "book_title": "Etiquette of Living and Prophetic Character", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Etiquette of Living and Prophetic Character'", "badge": "Ethics"}, {"arabic": "الحمد لله الذي خلق الإنسان من طين لازب وصلصال ثم ركب  صورته  في  أحسن  تقويم وأتم اعتدال ثم غذاه في أول نشوه بلبن استصفاه من بين  فرث  ودم  سائغا  كالماء الزلال ثم حماه بما آتاه من طيبات الرزق  عن  دواعي  الضعف  والانحلال  ثم  قيد شهوته المعادية له عن السطوة والصيال وقهرها بما  افترضه  عليه  من  طلب  القوت الحلال وهزم بكسرها جند الشيطان المتشمر للإضلال ولقد  كان  يجري  من  ابن  آدم مجرى الدم السيال فضيق عليه عزة الحلال المجرى والمجال إذ كان  لا  يبذرقه  إلى أعماق العروق إلا الشهوة الماثلة إلى ال", "english": "Praise be to Allah who created the human being from sticky clay and ringing clay, then fashioned his form in the best proportion and most complete balance. Then He nourished him in his first growth with milk purified from between feces and blood, pleasant like pure water. Then He protected him with what He gave him of good provisions from the causes of weakness and dissolution. Then He restrained his appetite (Shahwa) that is hostile to him from domination and aggression, and subdued it with what He obligated upon him of seeking lawful (Halal) sustenance, and defeated by breaking it the army of Satan who is girded for misguidance. And indeed, it used to flow in the son of Adam like flowing blood, so the honor of the lawful (Halal) narrowed its channel and scope, since nothing pours it into the depths of the veins except the appetite (Shahwa) inclined to overpowering and indulgence. So he remained, when it was restrained with the rein of the lawful (Halal), disappointed and losing, with no helper or ally. And prayers upon Muhammad, the guide from misguidance, and upon his family, the best of families, and much peace.", "book_file": "vol2_j2-k04.doc.txt", "book_title": "The Lawful and Prohibited", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'The Lawful and Prohibited'", "badge": "Du'a"}, {"arabic": "العاشر في آداب الجماع ويستحب أن يبدأ باسم الله تعالى ويقرأ قل هو الله أحد أولا ويكبر ويهلل ويقول بسم الله العلي العظيم اللهم اجعلها ذرية طيبة إن كنت قدرت أن تخرج ذلك من صلبي وقال صلى الله عليه وسلم (لو أن أحدكم إذا أتى أهله قال اللهم جنبني الشيطان وجنب الشيطان ما رزقتنا فإن كان بينهما ولد لم يضره الشيطان)[139] وإذا قربت من الإنزال فقل في نفسك ولا تحرك شفتيك الحمد لله الذي خلق من الماء بشرا فجعله نسبا وصهرا وكان ربك قديرا وكان بعض أصحاب الحديث يكبر حتى يسمع أهل الدار صوته ثم ينحرف عن القبلة ولا ي", "english": "The tenth [section] is on the etiquettes of intercourse, and it is recommended to begin with the name of Allah the Exalted and to recite 'Say: He is Allah, the One' first, and to say 'Allahu Akbar' (Allah is Greatest) and 'La ilaha illa Allah' (There is no god but Allah), and to say: 'In the name of Allah, the Most High, the Most Great. O Allah, make it good offspring if You have decreed to bring that forth from my loins.' And the Prophet, peace and blessings be upon him, said: 'If one of you, when he approaches his wife, says: O Allah, keep me away from Satan and keep Satan away from what You have provided us, then if there is a child between them, Satan will not harm him.' And when you are close to ejaculation, say in your heart and do not move your lips: 'Praise be to Allah who created from water a human being and made him [a means of] lineage and marriage, and your Lord is ever Powerful.' And some of the companions of hadith would say 'Allahu Akbar' until the people of the house heard his voice, then he would turn away from the qiblah and not face the qiblah during intercourse out of respect for the qiblah, and to cover himself and his wife with a garment. The Messenger of Allah, peace and blessings be upon him, would cover his head, lower his voice, and say to the woman: 'Upon you is tranquility.'", "book_file": "vol2_j2-k02.doc.txt", "book_title": "Etiquette of Marriage", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Etiquette of Marriage'", "badge": "Du'a"}], "4": [{"arabic": "ولكن ما تأتيهم من آية من آيات ربهم إلا كانوا عنها معرضين وذلك لأنّا جعلنا من بين أيديهم سدا ومن خلفهم سدا فأغشيناهم فهم لا يبصرون وسواء عليهم أأنذرتهم أم لم تنذرهم لا يؤمنون ولنرجع إلى الغرض فان هذه تلويحات تشير إلى أمور هي أعلى من علوم المعاملة.", "english": "But no sign (Ayat) from the signs (Ayat) of their Lord comes to them except that they turn away from it. And that is because We have placed a barrier before them and a barrier behind them and covered them, so they do not see. And it is the same to them whether you warn them or do not warn them - they will not believe. And let us return to the purpose, for these allusions point to matters that are higher than the sciences of interaction (Mu'amalat).", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Patience and Gratitude'", "badge": "General"}], "8": [{"arabic": "القسم الثاني: التكبر على الرسل من حيث تعزز النفس وترفعها على الانقياد لبشر مثل سائر الناس؛ وذلك تارة يصرف عن الفكر والاستبصار فيبقى في ظلمة الجهل بكبره فيمتنع عن الانقياد وهو ظان أنه محق فيه، وتارة يمتنع مع المعرفة ولكن لا تطاوعه نفسه للإنقياد للحق والتواضع للرسل، كما حكى الله قولهم \"أنؤمن لبشرين مثلنا\" وقولهم \"إن أنتم إلا بشر مثلنا ولئن أطعتم بشراً مثلكم إنكم إذا لخاسرون\" وقال الذين لا يرجون لقائنا لولا أنزل علينا الملائكة أو نرى ربنا لقد استكبروا في أنفسهم وعتوا عواً كبيراً. وقالوا لولا أنزل ع", "english": "The second category: Arrogance toward the messengers due to the Soul (Nafs) strengthening and elevating itself above submission to a human being like other people; this sometimes diverts from thought and insight, remaining in the darkness of ignorance through its arrogance, thus preventing submission while thinking it is correct in that, and sometimes it prevents despite knowledge but its Soul (Nafs) does not comply with submission to the Truth and humility toward the messengers, as Allah narrated their saying \"Shall we believe in two humans like ourselves\" and their saying \"You are only humans like us, and if you obey a human like yourselves, then indeed you would be losers\" and said those who do not hope for Our meeting: \"If only angels were sent down to us or we see our Lord\" they have certainly become arrogant within themselves and transgressed greatly. And they said: \"If only a angel had been sent down to him\" and Pharaoh, in what Allah informed about him, said: \"Or he comes with the angels accompanying him\" and Allah the Exalted said: \"And he and his soldiers were arrogant in the land without right\" so he was arrogant toward Allah and toward all His messengers.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "13": [{"arabic": "وإذا جن عليه الليل فليقل يا أرض ربي وربك الله أعوذ بالله من شرك ومن شر ما فيك وشر ما دب عليك أعوذ بالله من شر كل أسد وأسود وحية وعقرب ومن شر ساكني البلد ووالد وما ولد وله ما سكن في الليل والنهار وهو السميع العليم", "english": "And when the night covers him, let him say: 'O earth, my Lord and your Lord is Allah. I seek refuge in Allah from your evil and from the evil of what is in you and the evil of what crawls upon you. I seek refuge in Allah from the evil of every lion and black one, and snake and scorpion, and from the evil of the inhabitants of the land, and the parent and what is born.' And to Him belongs what settles in the night and the day, and He is the All-Hearing (As-Sami'), the All-Knowing (Al-'Alim).", "book_file": "vol2_j2-k07.doc.txt", "book_title": "Etiquette of Travel", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Etiquette of Travel'", "badge": "Dhikr"}, {"arabic": "فإذا نزل المنزل صلى ركعتين فيه ثم قال: أعوذ بكلمات الله التامات التي لا يجاوزهن بر ولا فاجر من شر ما خلق فإذا جن عليه الليل يقول يا أرض ربي وربك الله أعوذ بالله من شرك وشر ما فيك وشر ما دب عليك أعوذ بالله من شر كل أسد وأسود وحية وعقرب ومن شر ساكن البلد ووالد وما ولد وله ما سكن في الليل والنهار وهو السميع العليم.", "english": "When he alights at a stopping place, he prays two rak'ahs in it, then says: 'I seek refuge in the perfect words of Allah which no righteous or wicked one can surpass, from the evil of what He has created.' When night falls upon him, he says: 'O earth, my Lord and your Lord is Allah. I seek refuge in Allah from your evil and the evil of what is in you and the evil of what crawls upon you. I seek refuge in Allah from the evil of every lion, black one, snake, and scorpion, and from the evil of the inhabitant of the land, and the parent and what is born. And to Him belongs what settles in the night and the day, and He is the All-Hearing (As-Sami'), the All-Knowing (Al-'Alim).'", "book_file": "vol1_Vol1-book-7.doc.txt", "book_title": "Mysteries of Hajj", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Hajj'", "badge": "Du'a"}], "15": [{"arabic": "فإذا قال ﴿ إني أخاف إن عصيت ربي عذاب يوم عظيم ﴾ {} ولم يكن خائفا كان حاكيا", "english": "If he says, 'Indeed, I fear if I disobey my Lord the punishment of a great day' and he is not fearful, he is merely imitating.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Etiquette of Quran Recitation'", "badge": "Afterlife"}], "19": [{"arabic": "وإذا قصد بالخطاب جميع الناس فقد قصد الآحاد فهذا القارىء الواحد مقصود فما له ولسائر الناس فليقدر أنه المقصود قال الله تعالى ﴿ وأوحى إليّ هذا القرآن لأنذركم به ومن بلغ ﴾ {} قال محمد بن كعب القرظي من بلغه القرآن فكأنما كلمه الله وإذا قدر ذلك لم يتخذ دراسة القرآن عمله بل يقرؤه كما يقرأ العبد كتاب مولاه الذي كتبه إليه ليتأمله ويعمل بمقتضاه.", "english": "And if the address is intended for all people, then the individuals are intended, so this single reader is intended, and what is for him and for all other people, let him consider that he is the intended one. Allah the Exalted said: 'And this Quran has been revealed to me that I may warn you thereby and whoever it reaches.' {} Muhammad ibn Ka'b al-Qurazi said: Whoever the Quran reaches, it is as if Allah has spoken to him. And if he considers that, he does not take studying the Quran as his work, but rather he reads it as the servant reads the book of his Master which He wrote to him to contemplate it and act according to its requirements.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Etiquette of Quran Recitation'", "badge": "General"}], "20": [{"arabic": "وإنما يضاعف عذاب العالم في معصيته لأنه عصى من علم ولذلك قال الله عز وجل: (إن المنافقين في الدرك الأسفل من النار( (النساء:145). لأنهم جحدوا بعد العلم وجعل اليهود شرا من النصارى مع أنهم ما جعلوا لله سبحانه ولدا ولا قالوا إنه ثالث ثلاثة إلا أنهم أنكروا بعد المعرفة إذ قال الله (يعرفونه كما يعرفون أبناءهم( (البقرة:146) (الأنعام:20). وقال تعالى: (فلما جاءهم ما عرفوا كفروا به فلعنة الله على الكافرين( (البقرة:89). وقال تعالى في قصة بلعام بن باعوراء (واتل عليهم نبأ الذي آتيناه آياتنا فانسلخ منها فأتبعه ا", "english": "And indeed, the punishment of the scholar in his disobedience is multiplied because he disobeyed from knowledge. And for that reason, Allah the Exalted said: 'Indeed, the hypocrites will be in the lowest depths of the Fire' (An-Nisa: 145). Because they denied after knowledge. And He made the Jews worse than the Christians, even though they did not make for Allah, glorified be He, a son, nor did they say He is the third of three, except that they rejected after recognition (ma'rifah), since Allah said: 'They recognize him as they recognize their sons' (Al-Baqarah: 146) (Al-An'am: 20). And He the Exalted said: 'But when there came to them that which they recognized, they disbelieved in it. So the curse of Allah be upon the disbelievers' (Al-Baqarah: 89). And He the Exalted said in the story of Balaam son of Beor: 'And recite to them the news of him to whom We gave Our signs, but he detached himself from them; so Satan pursued him, and he became of the deviators' (Al-A'raf: 175) until He said: 'So his example is like that of the dog: if you chase him, he pants, or if you leave him, he [still] pants' (Al-A'raf: 176). Likewise is the wicked scholar, for Balaam was given the Book of Allah the Exalted, but he clung to desires, so he was likened to the dog, meaning whether he was given wisdom or not, he pants towards desires.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Knowledge'", "badge": "Dhikr"}], "21": [{"arabic": "وقد سوى الله تعالى بين من افترى على الله كذبا وبين من كذب بالحق فقال تعالى: (ومن أظلم ممن افترى على الله كذبا أو كذب بالحق لما جاءه( (العنكبوت: 68). وقال تعالى: (فمن أظلم ممن كذب على الله وكذب بالصدق إذ جاءه( (الزمر: 32).", "english": "And Allah the Exalted has equated between one who fabricates a lie against Allah and one who denies the truth when it comes to him, as He said: 'And who is more unjust than one who invents a lie against Allah or denies the truth when it has come to him?' (Al-Ankabut: 68). And He said: 'So who is more unjust than one who lies about Allah and denies the truth when it comes to him?' (Az-Zumar: 32).", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Book of Knowledge'", "badge": "Ethics"}], "25": [{"arabic": "ومن لم يكن له فهم ما في القرآن ولو في أدنى الدرجات دخل في قوله تعالى: ﴿ ومنهم من يستمع إليك حتى إذا خرجوا من عندك قالوا للذين أوتوا العلم ماذا قال آنفا أولئك الذين طبع الله على قلوبهم ﴾ {} والطابع هي الموانع التي سنذكرها في موانع الفهم وقد قيل: لا يكون المريد مريدا حتى يجد في القرآن كل ما يريد ويعرف منه النقصان من المزيد ويستغني بالمولى عن العبيد. السادس: التخلي عن موانع الفهم فإن أكثر الناس منعوا عن فهم معاني القرآن لأسباب وحجب أسدلها الشيطان على قلوبهم فعميت عليهم عجائب أسرار القرآن قال ﭬ: (لو", "english": "And whoever does not have understanding of what is in the Quran, even in the lowest degrees, enters into His saying, the Exalted: 'And among them are those who listen to you until when they depart from you, they say to those who were given knowledge: What did he say just now? Those are the ones upon whose hearts Allah has set a seal.' {} And the seal are the barriers that we will mention in the barriers of understanding. And it has been said: The Seeker (Mureed) does not become a true seeker until he finds in the Quran everything he desires and recognizes from it the deficiency from the increase and becomes independent with the Master (Mawla) from the servants. Sixth: Abandoning the barriers of understanding, for most people are prevented from understanding the meanings of the Quran due to reasons and veils that Satan has draped over their hearts, so the wonders of the secrets of the Quran are blinded to them. He said: 'If it were not that the devils hover around the hearts of the children of Adam, they would look at the Unseen Realm (Malakoot).' And the meanings of the Quran are from the totality of the Unseen Realm (Malakoot), and everything that is absent from the senses and is not perceived except by the light of insight (Basseerah) is from the Unseen Realm (Malakoot).", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "30": [{"arabic": "وقرئ عند يحيى البكاء ﴿ ولو ترى إذ وقفوا على ربهم ﴾{} فصاح صيحة مكث منها مريضا أربعة أشهر يعاد من أطراف البصرة", "english": "And it was recited before Yahya the Weeper: \"And if you could see when they are made to stand before their Lord (Rabb)\" (Quran 6:30), so he cried out a cry, and he remained sick from it for four months, being visited from the outskirts of Basra.", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Fear and Hope'", "badge": "General"}], "38": [{"arabic": "وقال أبو هريرة فى قوله عز وجل ﴿ وما من دابة فى الأرض ولا طائر يطير بجناحيه إلا أمم أمثالكم ﴾ {} أنه يحشر الخلق كلهم يوم القيامة البهائم والدواب والطير وكل شىء فيبلغ من عدل الله تعالى أن يأخذ للجماء من القرناء ثم يقول كونى ترابا فذلك حين يقول الكافر يا ليتنى كنت ترابا فكنت أنت يا مسكين فى يوم ترى صحيفتك خالية عن حسنات طال فيها تعبك فتقول أين حسناتي فيقال نقلت إلى صحيفة خصمائك وترى صحيفتك مشحونة بسيئات طال فى الصبر عنها نصبك واشتد بسبب الكف عنها عناؤك فتقول يا رب هذه سيئات ما قارفتها قط فيقال هذه ", "english": "And Abu Huraira said regarding His Exalted statement 'And there is no creature on the earth nor a bird that flies with its two wings except that they are communities like you' {} that He will gather all creation on the Day of Resurrection - the animals, the beasts, the birds, and everything - to the extent of the justice of Allah the Exalted that He will take for the hornless from the horned, then He says: 'Be dust!' That is when the disbeliever says: 'I wish I were dust!' So you, O wretched one, on a day when you see your record empty of good deeds in which your toil was prolonged, you will say: 'Where are my good deeds?' It will be said: 'They were transferred to the record of your adversaries.' And you see your record laden with bad deeds in which your exertion in abstaining from them was prolonged and your effort in refraining from them intensified, so you say: 'O Lord, these are bad deeds I never committed!' It will be said: 'These are the bad deeds of the people whom you backbit, insulted, intended with evil, and wronged in transactions, neighborliness, conversation, debate, discussion, study, and all other types of dealings.'", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}], "41": [{"arabic": "واستثنى في خمسة اشياء في الاغناء والاجابة والرزق والمغفرة والتوبة فقال تعالى: ﴿ فسوف يغنيكم الله من فضله ان شاء ﴾ {} وقال فيكشف ما تدعون اليه ان شاء - وقال يرزق من يشاء بغير حساب وقال: ويغفر ما دون ذلك لمن يشاء وقال: ويتوب الله على من يشاء وهو خلق من اخلاق الربوبية اذ قال تعالى: ﴿ والله شكور حليم ﴾ {}", "english": "And He made an exception in five things: in enrichment, response, provision, forgiveness, and repentance. So He, the Exalted, said: 'Then Allah will enrich you from His bounty if He wills' (Quran 24:28). And He said: 'He removes what you call to if He wills' (Quran 6:41). And He said: 'He provides for whom He wills without measure' (Quran 2:212). And He said: 'And He forgives what is less than that for whom He wills' (Quran 4:48). And He said: 'And Allah turns in repentance to whom He wills' (Quran 9:15). And it is a character from the characters of Lordship (Rububiyyah), as He, the Exalted, said: 'And Allah is Appreciative (Shakur), Forbearing (Haleem)' (Quran 64:17).", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "44": [{"arabic": "وعن عقبة بن عامر عن النبي ﷺ أنه قال: (إذا رأيتم الرجل يعطيه الله ما يحب وهو مقيم على معصيته فاعلموا أن ذلك استدراج ثم قرأ قوله تعالى: ﴿ فلما نسوا ما ذكروا به فتحنا عليهم أبواب كل شىء ﴾ {}[104]) يعنى لما تركوا ما أمروا به فتحنا عليهم أبواب الخير حتى إذا فرحوا بما أوتوا أى بما أعطوا من الخير أخذناهم بغتة.", "english": "And from Uqbah ibn Amir from the Prophet (peace be upon him) that he said: 'When you see a man whom Allah gives what he loves while he persists in his disobedience (ma'siyyah), know that that is gradual entrapment (istidraj).' Then he recited His saying, the Exalted: 'So when they forgot what they had been reminded of, We opened upon them the doors of every thing' (Quran 6:44). This means: when they abandoned what they were commanded with, We opened upon them the doors of good (khayr) until when they rejoiced with what they were given, that is, with what they were granted of good, We seized them suddenly.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وهذا الغرور علاجه معرفة دلائل الكرامة والهوان إما بالبصيرة أو بالتقليد أما البصيرة فبأن يعرف وجه كون الالتفات إلى شهوات الدنيا مبعد عن الله ووجه كون التباعد عنها مقرباً إلى الله ويدرك ذلك بالإلهام في منازل العارفين والأولياء، وشرحه من جملة علوم المكاشفة ولا يليق بعلم المعاملة \"وأما معرفته بطريق التقليد والتصديق\" فهو أن يؤمن بكتاب الله تعالى ويصدق رسوله وقد قال تعالى \"أيحسبون أن ما نمدهم به من مال وبنين نسارع لهم في الخيرات بل لا يشعرون\" وقال تعالى \"سنستدرجهم من حيث لا يعلمون\" وقال تعالى \"فتحنا ع", "english": "And the cure for this delusion (Ghurur) is knowing the signs of honor (Karama) and humiliation (Hawan) either through insight (Bassira) or through imitation (Taqleed). As for insight, it is by knowing how turning toward worldly desires distances from Allah and how distancing from them brings near to Allah, and one perceives this through inspiration (Ilham) in the stations of the knowers (Arifeen) and the friends (Awliya), and its explanation is among the sciences of unveiling (Makashafa) and is not fitting for the science of transaction (Mu'amala). \"And as for knowing it through the way of imitation and belief (Tasdeeq),\" it is to have faith in the Book of Allah the Exalted and believe His Messenger. And He the Exalted has said: \"Do they think that what We extend to them of wealth and children, We hasten for them in good things? Rather, they do not perceive.\" And He the Exalted has said: \"We will gradually lead them [to destruction] from where they do not know.\" And He the Exalted has said: \"So when they forgot that by which they had been reminded, We opened to them the doors of every [good] thing until, when they rejoiced in that which they were given, We seized them suddenly, and they were [then] in despair.\" And in the interpretation of His saying the Exalted \"We will gradually lead them [to destruction] from where they do not know\" is that whenever they commit a sin, We bring them a blessing to increase their delusion. And He the Exalted has said: \"We only extend time for them that they may increase in sin.\" And He the Exalted has said: \"And never think that Allah is unaware of what the wrongdoers do. He only delays them for a Day when eyes will stare [in horror].\" And other than that from what has come in the Book of Allah the Exalted and the Sunnah of His Messenger. So whoever believes in it is freed from this delusion, for the origin of this delusion is ignorance of Allah and His attributes, for whoever knows Him does not feel secure from His plan (Makr) nor is deceived by such false imaginings, and looks to Pharaoh, Haman, and Korah and to the kings of the earth and what happened to them—how Allah was good to them initially then destroyed them utterly! So He the Exalted said: \"Do you perceive of them anyone?\" the verse.", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Delusion'", "badge": "Ethics"}], "45": [{"arabic": "فَقُطِعَ دَابِرُ الْقَوْمِ الَّذِينَ ظَلَمُوا ۚ وَالْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ", "english": "Then the root of the people who did wrong was cut off, and praise be to Allah, Lord of the worlds.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din", "badge": "General"}], "46": [{"arabic": "فإن قلت: فما علامة عدم اتكاله على البضاعة والكفاية؟ فأقول: علامته أنه إن سرقت بضاعته أو خسرت تجارته أو تعوق أمر من أموره كان راضياً به ولم تبطل طمأنينته ولم يضطرب قلبه، بل كان حال قلبه في السكون قبله وبعده واحداً، فإن لم يسكن إلى شيء لم يضطرب لفقده، ومن اضطرب لفقد شيء فقد سكن إليه، وكان بشر يعمل المغازل فتركها، وذلك لأن البعادي كاتبه قال: بلغني أنك استعنت على رزقك بالمغازل، أرأيت إن أخذ الله سمعك وبصرك الرزق على من؟ فوقع ذلك في قلبه فأخرج آلة المغازل من يده وتركها.", "english": "If you say: What is the sign of not relying on merchandise and sufficiency? I say: Its sign is that if his merchandise is stolen or his trade incurs loss or some matter of his affairs is obstructed, he is content with it and his tranquility (Tuma'ninah) is not nullified and his heart (Qalb) does not become agitated. Rather, the state of his heart in stillness (Sukun) before it and after it is one. For if he does not settle upon something, he does not become agitated by its loss, and whoever becomes agitated by the loss of something has indeed settled upon it. And Bishr used to make spindles then abandoned them, and that is because Al-Ba'adi wrote to him: It has reached me that you have sought help for your provision (Rizq) through spindles. 'Tell me, if Allah takes away your hearing and your sight, upon whom is the provision?' So that settled in his heart, and he took the tool of spindles out of his hand and abandoned them.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "52": [{"arabic": "وقالت قريش لرسول الله ﷺ: كيف نجلس إليك وعند هؤلاء؟ وأشاروا إلى فقراء المسلمين فازدروهم بأعينهم لفقرهم، وتكبروا عن مجالستهم فأنزل الله تعالى \"ولا تطرد الذين يدعون ربهم بالغداة والعشي\" إلى قوله \"ما عليك من حسابهم\" وقال تعالى \"واصبر نفسك مع الذين يدعون ربهم بالغداة والعشي يريدون وجهه ولا تعد عيناك عنهم تريد زينة الحياة الدنيا\" ثم أخبر الله تعالى عن تعجبهم حين دخلوا جهنم إذ لم يروا الذين ازدروهم فقالوا \"ما لنا لا نرى رجالاً كنا نعدهم من الأشرار\" قيل يعنون عماراً وبلالاً وصهيباً والمقداد رضي الله عنه", "english": "And the Quraysh said to the Messenger of Allah (peace be upon him): 'How can we sit with you while these are present?' And they pointed to the poor Muslims, and they looked down upon them with their eyes because of their poverty, and they were too proud to sit with them. So Allah the Exalted revealed: 'And do not drive away those who call upon their Lord in the morning and the evening, seeking His Face (Wajhahu)' up to His saying 'You are not accountable for them.' And He said: 'And restrain your soul (Nafs) with those who call upon their Lord in the morning and the evening, seeking His Face (Wajhahu), and do not turn your eyes away from them, desiring the adornment of the worldly life.' Then Allah the Exalted informed about their astonishment when they entered Hell, as they did not see those whom they had looked down upon, so they said: 'Why do we not see men whom we used to count among the wicked?' It is said they meant Ammar, Bilal, Suhayb, and Miqdad (may Allah be pleased with them). Then among them were those whom pride prevented from reflection and knowledge, so they were ignorant of his (peace be upon him) being right, and among them were those who knew but pride prevented them from acknowledgment. Allah the Exalted said informing about them: 'So when there came to them that which they recognized, they disbelieved in it,' and He said: 'And they denied them while their souls (Anfus) were convinced of them, out of injustice and arrogance.' And this pride is close to being proud against Allah the Almighty, even if it is less than that, but it is pride against accepting the command of Allah and humbling oneself to His Messenger.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "وأما عبادة ذوي الألباب فإنها لا تجاوز ذكر الله تعالى والفكر فيه لجماله لماله وجلاله وسائر الأعمال تكون مؤكدات وروادف وهؤلاء ارفع درجة من الالتفات إلى المنكوح والمطعوم في الجنة فإنهم لم يقصدوها بل هم الذين يدعون ربهم بالغداة والعشي يريدون وجهه فقط وثواب الناس بقدر نياتهم فلا جرم يتنعمون بالنظر إلى وجهه الكريم ويسخرون ممن يلتفت إلى وجه الحور العين كما يسخر المتنعم بالنظر إلى الحور العين ممن يتنعم بالنظر إلى وجه الصور المصنوعة من الطين بل أشد فإن التفاوت بين جمال حضرة الربوبية وجمال الحور العين أشد", "english": "As for the worship of the possessors of intellects (ذوي الألباب), it does not exceed the Remembrance (Dhikr) of Allah the Exalted and contemplation upon Him for His beauty, for what He possesses, and for His majesty, and all other actions are confirmations and accompaniments. These are of a higher degree than turning attention to the one to be coupled with and the food in Paradise, for they did not intend it. Rather, they are those who call upon their Lord in the morning and the evening, desiring only His Face (وجهه). And the reward of people is according to their intentions, so it is no wonder that they delight in gazing upon His Noble Face and mock those who turn to the faces of the wide-eyed maidens (الحور العين), just as one who delights in gazing upon the wide-eyed maidens mocks one who delights in gazing upon the faces of images made from clay—indeed, more severe. For the disparity between the beauty of the Presence of Lordship (حضرة الربوبية) and the beauty of the wide-eyed maidens is more severe and much greater than the disparity between the beauty of the wide-eyed maidens and images made from clay.", "book_file": "vol4_j4-k07-old.doc.txt", "book_title": "Intention, Sincerity and Truthfulness", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Intention, Sincerity and Truthfulness'", "badge": "Dhikr"}, {"arabic": "ويجالس الفقراء حديث كان يجالس الفقراء أخرجه أبو داود من حديث أبي سعيد جلست في عصابة من ضعفاء المهاجرين وإن بعضهم ليستر بعضا من العرى الحديث وفيه فجلس رسول الله صلى الله عليه وسلم وسطنا ليعدل بنفسه فينا الحديث وابن ماجه من حديث خباب وكان رسول الله صلى الله عليه وسلم يجلس معنا الحديث في نزول قوله تعالى ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه ما عليك من حسابهم من شيء وما من حسابك عليهم من شيء فتطردهم فتكون من الظالمين إسنادهما حسن ويؤاكل المساكين حديث مؤاكلته للمساكين أخرجه البخاري من ", "english": "And he would sit with the poor (Fuqara) - a hadith that he would sit with the poor was reported by Abu Dawud from the narration of Abu Sa'id: 'I sat in a group of weak emigrants (Muhajirin), and indeed some of them would cover the nakedness of others...' In it: 'And the Messenger of Allah (peace be upon him) sat among us to make himself equal among us...' And Ibn Majah from the narration of Khabbab: 'And the Messenger of Allah (peace be upon him) would sit with us...' In the revelation of His saying, the Exalted: 'And do not drive away those who call upon their Lord (Rabb) in the morning and the evening, desiring His Face (Wajh). Not upon you is anything of their account, and not of your account upon them is anything, so that you would drive them away and be among the wrongdoers (Zalimin).' Their chains are good (Hasan). And he would eat with the poor (Masakin) - a hadith of his eating with the poor was reported by Bukhari from the narration of Abu Hurairah who said: 'And the People of the Suffah (Ahl al-Suffah) were the guests of Islam; they had no family or wealth to turn to. When charity (Sadaqah) came to him, he would send it to them and not take from it, and when a gift (Hadiyyah) came to him, he would send to them and take from it and share them in it.'", "book_file": "vol2_j2-k10.doc.txt", "book_title": "Etiquette of Living and Prophetic Character", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Etiquette of Living and Prophetic Character'", "badge": "Hadith"}, {"arabic": "بيان فضيلة النية قال الله تعالى ولا تطرد الذين يدعون ربهم بالغداة والعشى يريدون وجهه والمراد بتلك الإرادة هى النية", "english": "Explanation of the virtue of intention (Niyyah). Allah the Exalted said: 'And do not drive away those who call upon their Lord in the morning and the evening, desiring His Face (Wajhahu).' The intended meaning of that desire is the intention (Niyyah).", "book_file": "vol4_j4-k07-old.doc.txt", "book_title": "Intention, Sincerity and Truthfulness", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Intention, Sincerity and Truthfulness'", "badge": "General"}, {"arabic": "وقال تعالى: ﴿ ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه ﴾ {}. فهذا كله يبين لك أن الطريق إلى تعالى مراقبة الأوقات وعمارتها بالأوراد على سبيل الدوام ولذلك قال ﭬ: (أحب عباد الله إلى الله الذين يراعون الشمس والقمر والأظلة لذكر الله تعالى[1]).", "english": "And He, the Exalted, said: 'And do not drive away those who call upon their Lord in the morning and the evening, desiring His Face (Wajhahu).' {}. All of this clarifies for you that the path to the Exalted is the observance (Murāqabah) of the times and filling them with regular litanies (Awrād) on the basis of continuity, and for that reason He, peace be upon him, said: 'The most beloved of Allah's servants to Allah are those who observe the sun, the moon, and the shadows for the Remembrance (Dhikr) of Allah, the Exalted.'", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Knowledge'", "badge": "Dhikr"}], "53": [{"arabic": "السبب الثالث: الكبر؛ وهو أن يكون في طبعه أن يتكبر عليه ويستصغره ويستخدمه ويتوقع منه الانقياد له والمتابعة في أغراضه، فإذا نال نعمة خاف أن لا يحتمل تكبره ويترفع عن متابعته، أو ربما يتشوف إلى مساواته أو إلى أن يرتفع عليه فيعود متكبراً بعد أن كان متكبراً عليه. ومن التكبر والتعزز كان حسد أكثر الكفار لرسول الله ﭬ إذ قالوا: كيف يتقدم علينا غلام يتيم وكيف نطأطئ رؤوسنا؟ فقالوا \"لولا نزل هذا القرآن على رجل من القريتين عظيم\"[108] أي كان لا يثقل علينا أن نتواضع له ونتبعه إذا كان عظيماً وقال تعالى يصف قول ق", "english": "The third cause: Arrogance (Kibr); it is that it be in his nature to be arrogant toward him and belittle him and use him and expect from him submission to him and following in his purposes, so if he attains a blessing (Ni'mah) he fears that he will not bear his arrogance and rise above following him, or perhaps he aspires to equality with him or to rising above him so he returns arrogant after having been arrogant toward him. And from arrogance and self-importance (Ta'azzuz) was the envy (Hasad) of most disbelievers (Kuffar) for the Messenger of Allah ﷺ when they said: How does an orphan boy advance upon us and how do we lower our heads? So they said \"If only this Quran had been revealed to a man of importance from the two towns\" meaning it would not be heavy upon us to humble ourselves to him and follow him if he were important. And Allah the Exalted said describing the saying of Quraysh \"Are these the ones upon whom Allah has bestowed favor from among us?\" as belittling them and pride (Anfah) from them.", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Envy'", "badge": "Ethics"}, {"arabic": "وقالت قريش لرسول الله ﷺ: كيف نجلس إليك وعند هؤلاء؟ وأشاروا إلى فقراء المسلمين فازدروهم بأعينهم لفقرهم، وتكبروا عن مجالستهم فأنزل الله تعالى \"ولا تطرد الذين يدعون ربهم بالغداة والعشي\" إلى قوله \"ما عليك من حسابهم\" وقال تعالى \"واصبر نفسك مع الذين يدعون ربهم بالغداة والعشي يريدون وجهه ولا تعد عيناك عنهم تريد زينة الحياة الدنيا\" ثم أخبر الله تعالى عن تعجبهم حين دخلوا جهنم إذ لم يروا الذين ازدروهم فقالوا \"ما لنا لا نرى رجالاً كنا نعدهم من الأشرار\" قيل يعنون عماراً وبلالاً وصهيباً والمقداد رضي الله عنه", "english": "And the Quraysh said to the Messenger of Allah (peace be upon him): 'How can we sit with you while these are present?' And they pointed to the poor Muslims and despised them with their eyes due to their poverty, and they were too proud to sit with them. So Allah the Exalted revealed: 'And do not drive away those who call upon their Lord in the morning and the evening' up to His saying: 'You are not accountable for them.' And He said: 'And restrain your soul (Nafs) with those who call upon their Lord in the morning and the evening, seeking His Face, and do not turn your eyes away from them, desiring the adornment of the worldly life.' Then Allah the Exalted informed about their astonishment when they entered Hellfire, as they did not see those whom they had despised, so they said: 'Why do we not see men whom we used to count among the wicked?' It is said they meant Ammar, Bilal, Suhayb, and Miqdad (may Allah be pleased with them). Then among them were those whom pride prevented from thought and knowledge, so they were ignorant that he (peace be upon him) was right; and among them were those who knew but pride prevented them from acknowledgment. Allah the Exalted said, informing about them: 'So when there came to them that which they recognized, they disbelieved in it.' And He said: 'And they denied them while their souls (Anfus) were convinced of them, out of injustice and arrogance.' And this pride is close to being proud against Allah the Mighty and Majestic, even though it is less than that, but it is pride against accepting the command of Allah and humbling oneself to His Messenger. And Allah the Exalted said: 'And thus We have tried some of them by others so that they would say, \"Are these the ones upon whom Allah has bestowed favor from among us?\" Is not Allah most knowing of those who are grateful?' meaning despising them and considering their advancement unlikely.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "ومرة ينظرون إلى المؤمنين؛ وهم فقراء شعث غبر فيزدرون بهم ويستحقرونهم، فيقولون \"أهؤلاء من الله عليهم من بيننا\" ويقولون \"لو كان خيراً ما سبقونا إليه\" وترتيب القياس الذي نظمه في قلوبهم أنهم يقولون: قد أحسن الله إلينا بنعيم الدنيا، وكل محسن فهو محب، وكل محب فإنه يحسن أيضاً في المستقبل كما قال الشاعر: |لقد أحسن الله  | |كذلك يحسن فيما| |فيما مضى       | |بقـي          |", "english": "And sometimes they look at the believers; and they are poor, disheveled, and dusty, so they disdain them and belittle them, saying \"Are these the ones whom Allah has favored from among us?\" and saying \"If it were good, they would not have preceded us to it.\" And the arrangement of the analogy that He has organized in their hearts is that they say: Allah has been good to us with the enjoyment of the worldly life, and every one who is good is a lover, and every lover then he is also good in the future as the poet said: |Indeed Allah has been good| |Thus He is good in what| |in what has passed| |remains|", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Condemnation of Delusion'", "badge": "Hadith"}], "54": [{"arabic": "وقد عاتب الله نبيه ﭬ في الإعراض عن عبد والإقبال على عبد، وهما في العبودية سيان ولكن في الحال مختلفان، فقال: \" وأما من جاءك يسعى وهو يخشى فأنت عنده تلهى \"، وقال في الآخر: \" أما من استغنى فأنت له تصدى \" وةكذلك أمره بالقعود مع طائفة، فقال عز وجل: \" وإذا جاءك الذين يؤمنون بآياتنا فقل سلام عليكم \" وأمره بالإعراض عن غيرهم، فقال: \" وإذا رأيت الذين يخوضون في آياتنا فأعرض عنهم \" حتى قال: \" فلا تقعد بعد الذكرى مع القوم الظالمين \" وقال تعالى: \" واصبر نفسك مع الذين يدعون ربهم بالغداة والعشي \".", "english": "And Allah has reproached His Prophet (peace be upon him) regarding turning away from one servant and turning toward another servant, and they are equal in servitude but different in state. He said: \"And as for he who comes to you striving while he fears, you are to him distracted.\" And He said regarding the other: \"As for he who considers himself self-sufficient, you give him attention.\" And likewise, He commanded him to sit with a group, so the Mighty and Majestic said: \"And when those who believe in Our signs come to you, then say: Peace be upon you.\" And He commanded him to turn away from others, saying: \"And when you see those who engage in vain discourse about Our signs, then turn away from them\" until He said: \"So do not sit after the remembrance with the wrongdoing people.\" And Allah said: \"And restrain your soul (Nafs) with those who call upon their Lord in the morning and the evening.\"", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "59": [{"arabic": "ولا يعدو القرآن هذه الأقسام الثلاثة وهي: الإرشاد إلى معرفة ذات الله وتقديسه، أو معرفة صفاته وأسمائه، أو معرفة أفعاله وسنته مع عباده، ولما اشتملت سورة الإخلاص على أحد هذه الأقسام الثلاثة وهو التقديس وازنها رسول الله ﭬ بثلث القرآن فقال: \"من قرأ سورة الإخلاص فقد قرأ ثلث القرآن\"[51] لأن منتهى التقديس أن يكون واحداً في ثلاثة أمور، لا يكون حاصلاً منه من هو نظيره وشبهه، ودل عليه قوله \" لم يلد \" ولا يكون حاصلاً ممن هو نظيره وشبهه، ودل عليه قوله \" ولم يولد \" ولا يكون في درجته وإن لم يكن أصلاً له ولا فرعا", "english": "And the Quran does not exceed these three divisions, which are: guidance to knowledge of the Essence (Dhat) of Allah and His sanctification, or knowledge of His attributes and names, or knowledge of His actions and His way (Sunnah) with His servants. And since Surah Al-Ikhlas contains one of these three divisions, which is sanctification, the Messenger of Allah ﷺ equated it with a third of the Quran, saying: \"Whoever recites Surah Al-Ikhlas has recited a third of the Quran\" because the ultimate sanctification is to be one in three matters: it is not obtained from one who is His equal and likeness, indicated by His saying \"He did not beget\"; nor is it obtained from one who is His equal and likeness, indicated by His saying \"nor was He begotten\"; nor is there in His rank, even if not being His origin or branch, one who is like Him, indicated by His saying: \"nor is there to Him any equivalent.\" And all of that is gathered in His saying, the Exalted: \"Say, He is Allah, the One.\" And its entirety is the detailed explanation of the saying \"There is no god but Allah.\" These are the secrets of the Quran, and examples of these secrets in the Quran are endless, \"nor moist nor dry except in a clear book.\" And therefore, Ibn Mas'ud, may Allah be pleased with him, said: Illuminate the Quran and seek its wonders, for in it is the knowledge of the first and the last. And it is as he said, and none knows it except one who has prolonged in its individual words his thought and purified for it his understanding until every word of it testifies to him that it is the speech of a Mighty (Jabbar), Overpowering (Qahir), Sovereign (Malik), Powerful (Qadir), and that it is beyond the limit of human capability.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "وقال سهل بن عبد الله التستري رحمه الله: خرج العلماء والعباد والزهاد من الدنيا وقلوبهم مقفلة ولم تفتح إلا قلوب الصديقين والشهداء ثم تلا قوله تعالى: (وعنده مفاتح الغيب لا يعلمها إلا هو... الآية( (الأنعام: 59). ولولا أن إدراك قلب من له قلب بالنور الباطن حاكم على علم الظاهر لما قال صلى الله عليه وسلم: (( استفت قلبك وإن أفتوك وأفتوك وأفتوك))[178].", "english": "And Sahl bin Abdullah al-Tustari, may Allah have mercy on him, said: The scholars, worshippers, and ascetics left the world with their hearts locked, and none were opened except the hearts of the truthful ones (al-Siddiqin) and the martyrs (al-Shuhada). Then he recited the saying of the Exalted: 'And with Him are the keys of the unseen; none knows them except Him... the verse' (Al-An'am: 59). And were it not that the perception of the heart (Qalb) of one who has a heart with the inner light (al-Nur al-Batin) is sovereign over the knowledge of the apparent (al-Zahir), He would not have said, peace and blessings be upon him: 'Consult your heart even if they give you legal opinions and give you legal opinions and give you legal opinions.'", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "وكذلك إذا سمع وصف الجنة والنار وسائر ما في القرآن فلا يمكن استقصاء ما يفهم منه لأن ذلك لا نهاية له وإنما لكل عبد بقدر رزقه فلا رطب ولا يابس إلا في كتاب مبين ﴿ قل لو كان البحر مدادا لكلمات ربي لنفد البحر قبل أن تنفد كلمات ربي ولو جئنا بمثله مددا ﴾ {} ولذلك قال علي رضي الله عنه: لو شئت لأوقرت سبعين بعيرا من تفسير فاتحة الكتاب.", "english": "Likewise, if he hears the description of Paradise and Hell and all that is in the Quran, it is not possible to exhaust what is understood from it because that has no end, and indeed for every servant (Abd) according to the measure of his provision (Rizq), so no moist (Rutb) nor dry (Yabis) except in a clear book (Kitab Mubin). 'Say: If the sea were ink for the words of my Lord, the sea would be exhausted before the words of my Lord were exhausted, even if We brought the like of it as a supplement.' And therefore, Ali (may Allah be pleased with him) said: 'If I wished, I could load seventy camels with the interpretation of the Opening of the Book (Fatiha).'", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Etiquette of Quran Recitation'", "badge": "Afterlife"}], "60": [{"arabic": "اللهم إني أسألك أن تبعثنا في هذا اليوم إلى كل خير ونعوذ بك أن نجترح فيه سوءا أو نجره إلى مسلم فإنك قلت ﴿ وهو الذي يتوفاكم بالليل ويعلم ما جرحتم بالنهار ثم يبعثكم فيه ليقضي أجل مسمى ﴾ {}[234] اللهم فالق الإصباح وجاعل الليل سكنا والشمس والقمر حسبانا أسألك خير هذا اليوم وخير ما فيه وأعوذ بك من شره وشر ما فيه[235]", "english": "O Allah, I ask You to resurrect us on this day to every good, and we seek refuge in You from committing evil in it or bringing it upon a Muslim, for You have said: 'And He is the One who takes your souls (Nafs) at night and knows what you have earned (Jaraha) during the day, then He resurrects you in it so that a specified term (Ajal) may be fulfilled.' {}[234] O Allah, Splitter of the dawn and Maker of the night as a rest and the sun and moon as calculation, I ask You for the good of this day and the good in it, and I seek refuge in You from its evil and the evil in it.[235]", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "65": [{"arabic": "وسئل ابن مسعود رضي الله عنه عن تفسير هذه الآية فقال إن هذا ليس زمانها إنها اليوم مقبولة ولكن قد اوشك أن يأتي زمانها تأمرون بالمعروف فيصنع بكم كذا وكذا وتقولون فلا يقبل منكم فحينئذ عليكم انفسكم لا يضركم من ضل إذا اهتديتم", "english": "And Ibn Mas'ud (may Allah be pleased with him) was asked about the interpretation of this verse. He said: 'This is not its time; today it is accepted, but its time is almost upon you. You will command the good (Ma'ruf) and such and such will be done to you, and you will speak but it will not be accepted from you. Then at that time, upon yourselves (Anfusikum) - it will not harm you if someone goes astray when you have been guided.'", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}], "68": [{"arabic": "وقد عاتب الله نبيه ﭬ في الإعراض عن عبد والإقبال على عبد، وهما في العبودية سيان ولكن في الحال مختلفان، فقال: \" وأما من جاءك يسعى وهو يخشى فأنت عنده تلهى \"، وقال في الآخر: \" أما من استغنى فأنت له تصدى \" وةكذلك أمره بالقعود مع طائفة، فقال عز وجل: \" وإذا جاءك الذين يؤمنون بآياتنا فقل سلام عليكم \" وأمره بالإعراض عن غيرهم، فقال: \" وإذا رأيت الذين يخوضون في آياتنا فأعرض عنهم \" حتى قال: \" فلا تقعد بعد الذكرى مع القوم الظالمين \" وقال تعالى: \" واصبر نفسك مع الذين يدعون ربهم بالغداة والعشي \".", "english": "And Allah has reproached His Prophet (peace be upon him) regarding turning away from one servant and turning toward another servant, while they are equal in servitude (ʿubūdiyyah) but differ in state (ḥāl). He said: \"And as for he who comes to you striving while he fears, you are to him distracted.\" And He said regarding the other: \"As for he who considers himself self-sufficient, you give him attention.\" And likewise, He commanded him to sit with a group, so the Mighty and Majestic said: \"And when those who believe in Our signs come to you, say: Peace be upon you.\" And He commanded him to turn away from others, saying: \"And when you see those who engage in vain discourse about Our signs, then turn away from them\" until He said: \"So do not sit after the Remembrance (Dhikr) with the wrongdoing people.\" And He said, Exalted is He: \"And restrain yourself with those who call upon their Lord in the morning and the evening.\"", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "ومنها كلام القصاص والوعاظ الذين يمزجون بكلامهم البدعة فالقاص إن كان يكذب في أخباره فهو فاسق والإنكار عليه واجب وكذا الواعظ المبتدع يجب منعه ولا يجوز حضور مجلسه إلا على قصد إظهار الرد عليه إما للكافة إن قدر عليه أو لبعض الحاضرين حواليه فإن لم يقدر فلا يجوز سماع البدع قال الله تعالى لنبيه فأعرض عنهم حتى يخوضوا في حديث غيره ومهما كان كلامه مائلا إلى الإرجاء وتجرئة الناس على المعاصي وكان الناس يزدادون بكلامه جراءة وبعفو الله وبرحمته وثوقا يزيد بسببه رجاؤهم على خوفهم فهو منكر ويجب منعه عنه لأن فساد ذ", "english": "And among them is the speech of storytellers and preachers who mix innovation (Bid'ah) into their speech. If the storyteller lies in his reports, he is corrupt (Fasiq) and it is obligatory to disapprove of him. Likewise, the innovating preacher must be prevented, and it is not permissible to attend his gathering except with the intention of showing refutation to him, either to all if capable, or to some of those present around him. If incapable, it is not permissible to listen to innovations. Allah the Exalted said to His Prophet: 'And when you see those who engage in [offensive] discourse concerning Our verses, then turn away from them until they enter into another conversation. And if Satan should cause you to forget, then do not remain after the Remembrance (Dhikr) with the wrongdoing people.' And whenever his speech inclines toward postponement (Irja') and emboldening people toward sins, and people increase in boldness through his speech and in confidence in Allah's pardon and mercy, causing their hope (Raja') to increase over their fear (Khawf), this is reprehensible (Munkar) and he must be prevented from it because its corruption is great. Rather, if their fear outweighs their hope, that is more fitting and closer to the nature of creation, for they are in greater need of fear. Indeed, justice is balancing fear and hope, as Umar (may Allah be pleased with him) said: 'If a caller called on the Day of Resurrection for all people to enter the Fire except one man, I would hope to be that man; and if a caller called for all people to enter Paradise except one man, I would fear to be that man.' And whenever the preacher is a youth adorned for women in his clothes and appearance, with much poetry, gestures, and movements, and women have attended his gathering, this is reprehensible and must be prevented, for corruption in it is more than benefit, and this is evident from him through circumstantial evidence of his states. Rather, preaching should not be entrusted except to one whose outward appearance is piety (Wara') and his demeanor is tranquility (Sakinah) and dignity (Waqar), and his attire is that of the righteous; otherwise, people only increase in persistence in misguidance. And a barrier must be placed between men and women to prevent looking, for that too is a source of corruption, and customs testify to these reprehensible acts. And women must be prevented from attending mosques for prayers and gatherings of Remembrance (Dhikr).", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Enjoining Good and Forbidding Evil'", "badge": "Du'a"}], "70": [{"arabic": "وقال ابن عباس رضي الله عنهما: الضلالة لها حلاوة في قلوب أهلها. قال الله تعالى: (وذر الذين اتخذوا دينهم لعبا ولهوا وغرتهم الحياة الدنيا وذكر به أن تبسل نفس بما كسبت ليس لها من دون الله ولي ولا شفيع وإن تعدل كل عدل لا يؤخذ منها أولئك الذين أبسلوا بما كسبوا لهم شراب من حميم وعذاب أليم بما كانوا يكفرون) (الأنعام: 70) وقال تعالى: (أفمن زين له سوء عمله فرآه حسنا) (فاطر: 8) فكل ما أحدث بعد الصحابة رضي الله عنهم مما جاوز قدر الضرورة والحاجة فهو من اللعب واللهو.", "english": "And Ibn Abbas (may Allah be pleased with them both) said: Misguidance has sweetness in the hearts (Qulub) of its people. Allah the Exalted said: 'And leave those who have taken their religion as play and amusement and whom the worldly life has deluded. And remind with it (the Quran) lest a soul (Nafs) be seized for what it has earned - it has no protector besides Allah, nor any intercessor. And if it should offer every compensation, it would not be taken from it. Those are the ones who are seized for what they have earned. For them will be a drink of scalding water and a painful punishment because they used to disbelieve.' (Al-An'am: 70) And He the Exalted said: 'Then is one to whom the evil of his deed has been made attractive so he sees it as good?' (Fatir: 8) So everything that was innovated after the Companions (may Allah be pleased with them) that exceeds the measure of necessity and need is from play and amusement.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}], "71": [{"arabic": "والهداية الثالثة وراء الثانية وهو النور الذى يشرق في عالم النبوة والولاية بعد كمال المجاهدة فيهتدى بها إلا ما لا يهتدى إليه بالعقل الذى يحصل به التكليف وإمكان تعلم العلوم وهو الهوى المطلق وما عداه حجاب له ومقدمات وهو الذى شرفه الله تعالى بتخصيص الإضافة إليه وإن كان الكل من جهته تعالى فقال تعالى: ﴿ قل إن هدى الله هو الهدى ﴾ {} وهو المسمى حياة في قوله تعالى: ﴿ أو من كان ميتا فأحييناه وجعلنا له نورا يمشى به في الناس ﴾ {} والمعنى بقوله تعالى: ﴿ أفمن شرح الله صدره للإسلام فهو على نور من ربه ﴾ {}", "english": "And the third guidance (Hidayah) is beyond the second, and it is the light (Nur) that shines in the realm of prophethood (Nubuwwah) and sainthood (Wilayah) after the perfection of striving (Mujahadah), so one is guided by it except what cannot be guided to by the intellect (Aql) through which obligation (Taklif) and the possibility of learning sciences are attained, and it is the absolute desire (Hawa) and what is besides it is a veil (Hijab) for it and its preliminaries, and it is that which Allah the Exalted honored by specifying the attribution to Him, even though all is from His side, the Exalted, so He said, the Exalted: 'Say: Indeed, the guidance (Hidayah) of Allah is the guidance (Hidayah).' And it is called life (Hayat) in His saying, the Exalted: 'Or one who was dead (Mayyit) and We gave him life (Ahyaynah) and made for him a light (Nur) by which he walks among the people.' And the meaning in His saying, the Exalted: 'Is one whose chest Allah has expanded for Islam (Islam) then he is upon a light (Nur) from his Lord?'", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Patience and Gratitude'", "badge": "Worship"}], "75": [{"arabic": "فانظر إلى الملكوت لترى عجائب العز والجبروت ولا تظنن أن معنى النظر إلى الملكوت بأن تمد البصر إليه فترى زرقة السماء وضوء الكواكب وتفرقها فإن البهائم تشاركك فى هذا النظر فإن كان هذا هو المراد فلم مدح الله تعالى إبراهيم بقوله وكذلك نرى إبراهيم ملكوت السموات والأرض لا بل كل ما يدرك بحاسة البصر فالقرآن يعبر عنه بالملك والشهادة وما غاب عن الأبصار فيعبر عنه بالغيب والملكوت والله تعالى عالم الغيب والشهادة وجبار الملك والملكوت ولا يحيط أحد بشىء من علمه إلا بما شاء وهو عالم الغيب فلا يظهر على غيبه أحدا إلا", "english": "So look to the Dominion (al-Malakūt) to see the wonders of Might (al-ʿIzz) and Power (al-Jabarūt). And do not think that the meaning of looking to the Dominion (al-Malakūt) is by extending your sight to it so that you see the blueness of the sky, the light of the stars, and their dispersion, for the beasts share with you in this looking. If this were the intended meaning, then why did Allah the Exalted praise Abraham with His saying: 'And thus We showed Abraham the Dominion (Malakūt) of the heavens and the earth'? No, rather everything that is perceived by the sense of sight, the Quran expresses it with Kingdom (al-Mulk) and the Witnessed (al-Shahādah), and what is hidden from the sights is expressed with the Unseen (al-Ghayb) and the Dominion (al-Malakūt). And Allah the Exalted is Knower of the Unseen (al-Ghayb) and the Witnessed (al-Shahādah), and Sovereign of the Kingdom (al-Mulk) and the Dominion (al-Malakūt). And no one encompasses anything of His knowledge except by what He wills, and He is Knower of the Unseen (al-Ghayb), so He does not reveal His Unseen (Ghayb) to anyone except a messenger He has approved. So reflect, O intelligent one, upon the Dominion (al-Malakūt), perhaps the doors of the sky will open for you, and you will roam with your Heart (Qalb) in its regions until your Heart (Qalb) stands before the Throne of the Most Merciful. At that point, perhaps it may be hoped for you to reach the rank of ʿUmar ibn al-Khaṭṭāb, may Allah be pleased with him, where he said: 'My Heart (Qalb) saw my Lord.' And this is because reaching the utmost cannot be except after passing beyond the nearest, and the nearest thing to you is your Soul (Nafs), then the earth which is your abode, then the air enveloping you, then the plants and animals and what is on the face of the earth, then the wonders of the atmosphere, which is what is between the sky and the earth, then the seven heavens with their stars, then the Footstool (al-Kursī), then the Throne (al-ʿArsh), then the angels who are the bearers of the Throne (al-ʿArsh) and the keepers of the heavens, then from there you pass beyond to looking at the Lord of the Throne (al-ʿArsh), the Footstool (al-Kursī), the heavens, the earth, and what is between them.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "76": [{"arabic": "وتلك الحجب أيضا مترتبة وتلك الأنوار متفاوتة في الرتب تفاوت الشمس والقمر والكواكب ويبدو في الأول أصغرها ثم ما يليه وعليه أول بعض الصوفية درجات ما كان يظهر لإبراهيم الخليل ﭬ في ترقيه وقال: ﴿ فلما جن عليه الليل ﴾ {} أي أظلم عليه الأمر ﴿ رأى كوكبا ﴾ {} أي وصل إلى حجاب من حجب النور فعبر عنه بالكوكب وما أريد به هذه الأجسام المضيئة فإن آحاد العوام لا يخفى عليهم أن الربوبية لا تليق بالأجسام بل يدركون ذلك بأوائل نظرهم فما لا يضلل العوام لا يضلل الخليل عليه السلام والحجب المسماة أنوارا ما أريد بها الضوء ا", "english": "And those veils are also arranged in order, and those lights are varied in rank like the variation between the sun, the moon, and the stars. In the beginning, the smallest of them appears, then what follows it. Upon this, some Sufis began the degrees of what was appearing to Abraham the Friend (Al-Khalil) ﭬ in his ascension, and He said: 'When the night covered him' {} meaning the matter became dark upon him 'he saw a star' {} meaning he reached a veil from the veils of light, so he expressed it with 'the star', and what is intended by it is not these luminous bodies, for the common people are not unaware that divinity (Ar-Rububiyyah) is not suitable for bodies; rather, they perceive that with the beginnings of their consideration. So what does not mislead the common people does not mislead the Friend (Al-Khalil) upon him peace. And the veils called lights are not intended by them the light perceived by sight; rather, what is intended by them is what is intended by His saying, the Exalted: 'Allah is the Light (Nur) of the heavens and the earth. The example of His light (Nur) is like a niche within which is a lamp' {} the verse. And let us pass over these meanings, for they are outside the knowledge of practice (Ilm Al-Mu'amalah), and none reaches their realities except the unveiling (Al-Kashf) that follows pure thought (Al-Fikr As-Safi), and few are those for whom its door opens. What is made easy for the masses of creation is thought (Al-Fikr) in what benefits in the knowledge of practice (Ilm Al-Mu'amalah), and that also is among what abounds in benefit and magnifies its usefulness.", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Knowledge'", "badge": "Dhikr"}, {"arabic": "وإليه الإشارة بقول إبراهيم عليه السلام إذ قال الله تعالى إخباراً عنه \"فلما جن الليل رأى كوكباً قال هذا ربي\" وليس المعنى به هذه الأجسام المضيئة فإنه كان يراها في الصغر ويعلم أنها ليست آلهة وهي كثيرة وليست واحداً، والجهال يعلمون أن الكوكب ليس بإله فمثل إبراهيم عليه السلام لا يغره الكوكب الذي لا يغر السوادية. ولكن المراد به أنه نور من الأنوار التي هي من حجب الله عز وجل وهي على طريق السالكين، ولا يتصور الوصول إلى الله تعالى إلا بالوصول إلى هذه الحجب، وهي حجب من نور بعضها أكبر من بعض وأصغر النيرات ال", "english": "And to this is alluded by the saying of Abraham (peace be upon him) when Allah the Exalted said, reporting about him: \"When the night covered him, he saw a star. He said, 'This is my Lord.'\" And the meaning is not these luminous bodies, for he used to see them in his youth and knew that they are not gods, and they are many and not one, and the ignorant know that the star is not a god, so one like Abraham (peace be upon him) is not deceived by a star that does not deceive the common people. But what is intended by it is that it is a light from the lights that are from the veils of Allah the Mighty and Majestic, and they are on the path of the travelers (Salikin), and it is inconceivable to reach Allah the Exalted except by reaching these veils, and they are veils of light, some greater than others, and the smallest of the luminous ones is the star, so its term is borrowed for it, and the greatest of them is the sun, and between them is the rank of the moon. So Abraham (peace be upon him) did not cease when he saw the dominion (Malakut) of the heavens, as Allah the Exalted said: \"And thus did We show Abraham the dominion (Malakut) of the heavens and the earth,\" and he reaches light after light, and it is imagined to him at first when he encounters it that he has reached, then it is unveiled to him that beyond it is a matter, so he ascends to it and says: I have reached, then it is unveiled to him what is beyond it until he reached the nearest veil beyond which there is no reaching, so he said \"This is greater.\" Then when it became apparent to him that it, with its greatness, is not free from inclination in the depths of deficiency and decline from the peak of perfection, he said \"I do not love those that set - until he said - Indeed, I have turned my face toward He who created the heavens and the earth.\" And the traveler (Salik) of this path may be deceived in stopping at some of these veils, and he may be deceived by the first veil, and the first veil between Allah and the servant is his own soul (Nafs), for it is also a divine matter and it is a light from the lights of Allah the Exalted; I mean the secret (Sirr) of the heart (Qalb) in which the reality (Haqiqah) of the Truth (Al-Haqq) all is manifested, so much so that it expands to encompass the whole world and surrounds it, and the form of the whole is manifested in it, and at that time its light shines a great shining, for the whole existence appears in it as it is, and in the first matter it is veiled by a niche that is like a cover for it. So when its light is manifested and the beauty (Jamal) of the heart (Qalb) is unveiled after the light of Allah shines upon it, perhaps the possessor of the heart (Qalb) turns to the heart (Qalb) and sees from its surpassing beauty (Jamal) what bewilders him, and perhaps his tongue precedes in this bewilderment, so he says: I am the Truth (Al-Haqq). Then if what is beyond that is not made clear to him, he is deceived by it and stops at it and perishes, and he had been deceived by a small star from the lights of the divine presence (Al-Hadrah Al-Ilahiyyah) and had not yet reached the moon, let alone the sun, so he is deceived, and this is the place of confusion, for the manifested (Al-Mutajalli) is confused with that in which it is manifested (Al-Mutajalla Fihi), as the color of what appears in the mirror is confused so it is thought to be the color of the mirror, and as what is in the glass is confused with the glass, as it is said: |The glass became thin| |so they resembled each other| |And the wine became thin| |so they became similar|.", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Condemnation of Delusion'", "badge": "Worship"}, {"arabic": "وفرقة أخرى جاوزوا هؤلاء ولم يلتفتوا إلى ما يفيض عليهم من الأنوار في الطريق ولا إلا ما تيسر لهم من العطايا الجزيلة ولم يعرجوا على الفرح بها والالتفات إليها جادين في السير حتى قاربوا فوصلوا إلى حد القربة إلى الله تعالى، فظنوا أنهم قد وصلوا إلى الله فوقفوا وغلطوا فإن لله تعالى سبعين حجاباً من نور لا يصل السالك إلى حجاب من تلك الحجب في الطريق إلا ويظن أنه قد وصل. وإليه الإشارة بقول إبراهيم عليه السلام إذ قال الله تعالى إخباراً عنه \"فلما جن الليل رأى كوكباً قال هذا ربي\" وليس المعنى به هذه الأجسام الم", "english": "And another group surpassed these and did not turn to what flows upon them of lights (Anwar) on the path, nor except what was made easy for them of abundant gifts, and they did not linger over rejoicing in them and turning to them, earnest in walking until they approached and reached the limit of nearness (Qurbah) to Allah the Exalted, so they thought that they had reached Allah, so they stopped and erred, for Allah the Exalted has seventy veils (Hujub) of light; the traveler (Salik) does not reach a veil from those veils on the path except that he thinks he has reached. And to this is the allusion in the saying of Abraham, peace be upon him, when Allah the Exalted reported about him: \"When the night covered him, he saw a star; he said, 'This is my Lord (Rabb).'\" And the meaning is not these luminous bodies, for he used to see them in childhood and know that they are not gods, and they are many and not one, and the ignorant know that the star is not a god, so the like of Abraham, peace be upon him, is not deceived by the star that does not deceive the common people. But what is intended is that it is a light from the lights (Anwar) that are from the veils (Hujub) of Allah the Mighty and Majestic, and they are on the path of the travelers (Salikin), and reaching Allah the Exalted is not conceivable except by reaching these veils (Hujub), and they are veils (Hujub) of light, some greater than others, and the smallest of the luminous ones is the star, so its term was borrowed for it, and the greatest is the sun, and between them is the rank of the moon. So Abraham, peace be upon him, did not cease when he saw the dominion (Mulkut) of the heavens, as Allah the Exalted said: \"And thus We showed Abraham the dominion (Mulkut) of the heavens and the earth,\" and he reaches light after light, and it is imagined to him at first what he encounters that he has reached, then it is unveiled to him that beyond it is a matter, so he ascends to it and says: I have reached, then it is unveiled to him what is beyond it until he reached the nearest veil (Hijab) after which there is no reaching, so he said \"This is greater,\" then when it became apparent to him that it, with its greatness, is not free from inclination (Hawa) in the lowliness of deficiency and decline from the peak of perfection (Kamal), \"he said, 'I do not love those that set' - until he said - 'Indeed, I have turned my face toward He who created the heavens and the earth.'\" And the traveler (Salik) of this path may be deceived in stopping at", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Condemnation of Delusion'", "badge": "Worship"}], "79": [{"arabic": "وذلك كإفلاس من يصبح بكرة ويتوجه إلى القبلة ويقول: (وجهت وجهي للذي فطر السموات والأرض حنيفا( (الأنعام: 79). وهو أول كذب يفاتح الله به كل يوم إن لم يكن وجه قلبه متوجها إلى الله تعالى على الخصوص فإنه إن أراد بالوجه وجه الظاهر فما وجهه إلا إلى الكعبة وما صرفه إلا عن سائر الجهات والكعبة ليست جهة للذي فطر السموات والأرض حتى يكون المتوجه إليها متوجها إليه تعالى عن أن تحده الجهات والأقطار وإن أراد به وجه القلب وهو المطلوب المتعبد به فكيف يصدق في قوله وقلبه متردد في أوطاره وحاجاته الدنيوية ومتصرف في طلب ", "english": "And that is like the bankruptcy (إفلاس) of one who rises in the morning and turns toward the Qibla and says: 'I have turned my face toward He Who created the heavens and the earth, as a true monotheist (حنيفا)' (Al-An'am: 79). And it is the first lie with which he addresses Allah each day if the face (وجه) of his Heart (Qalb) is not turned toward Allah, the Exalted, in particular. For if he intended by 'face' the apparent face, then his face is only toward the Ka'bah, and he has only diverted it from other directions. And the Ka'bah is not a direction for He Who created the heavens and the earth, such that one who turns toward it is turning toward Him, the Exalted, above being limited by directions and regions. And if he intended by it the face of the Heart (Qalb), which is the required object of worship, then how can he be truthful in his statement while his Heart (Qalb) is wavering in its familiar places and its worldly needs, and is engaged in seeking means to gather wealth, status, and multiplying causes, and is turned wholly toward them? So when has he turned his face toward He Who created the heavens and the earth? And this statement is a report about the reality of Monotheism (Tawhid). So the monotheist (الموحد) is the one who sees nothing but the One and does not turn his face except toward Him. And it is compliance with His statement, the Exalted: 'Say: Allah, then leave them in their discourse, playing' (Al-An'am: 91). And what is intended by it is not the statement with the tongue, for the tongue is only an interpreter that tells the truth sometimes and lies at other times. Rather, the place of Allah's, the Exalted, gaze, which is interpreted from it, is the Heart (Qalb), and it is the mine and source of Monotheism (Tawhid).", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "ولكن المراد به أنه نور من الأنوار التي هي من حجب الله عز وجل وهي على طريق السالكين، ولا يتصور الوصول إلى الله تعالى إلا بالوصول إلى هذه الحجب، وهي حجب من نور بعضها أكبر من بعض وأصغر النيرات الكوكب فاستعير له لفظه وأعظمها الشمس وبينهما رتبة القمر، فلم يزل إبراهيم عليه السلام لما رأى ملكوت السموات حيث قال تعالى \"وكذلك نرى إبراهيم ملكوت السموات والأرض\" ويصل إلى نور بعد نور ويتخيل إليه في أول ما كان يلقاه أنه قد وصل، ثم كان يكشف له أن وراءه أمراً فيترقى إليه ويقول: قد وصلت فيكشف له ما وراءه حتى وصل ", "english": "But what is intended by it is that it is a light from the lights that are from the veils of Allah, the Mighty and Majestic, and they are upon the path of the travelers (Salikin), and reaching Allah, the Exalted, cannot be conceived except by reaching these veils, and they are veils of light, some greater than others, and the smallest of the luminous ones is the star, so its term was borrowed for it, and the greatest of them is the sun, and between them is the rank of the moon. So Abraham, peace be upon him, did not cease when he saw the dominion (Mulkut) of the heavens, as Allah, the Exalted, said: \"And thus did We show Abraham the dominion (Mulkut) of the heavens and the earth,\" and he reaches light after light, and it appears to him at first what he encounters that he has reached, then it is unveiled to him that beyond it is a matter, so he ascends to it and says: I have reached, then it is unveiled to him what is beyond it until he reached the nearest veil beyond which there is no reaching, so he said: \"This is greater.\" Then when it became apparent to him that despite its greatness, it is not free from inclination in the depths of deficiency and decline from the peak of perfection, \"he said: I do not love those that set - until he said - Indeed, I have turned my face toward He who created the heavens and the earth.\" And the traveler (Salik) of this path may be deceived in stopping at some of these veils, and he may be deceived by the first veil, and the first veil between Allah and the servant is his own self (Nafs), for it is also a divine matter and a light from the lights of Allah, the Exalted; I mean the secret (Sirr) of the heart (Qalb) in which the reality (Haqiqah) of the Truth (Haqq) all is manifested, so much so that it expands to encompass the whole world and surrounds it, and the form (Surah) of the whole is manifested in it. At that time, its light shines a great shining, for the whole existence appears in it as it is, and in the first matter, it is veiled by a niche that is like a cover for it. So when its light is manifested and the beauty (Jamal) of the heart (Qalb) is unveiled after the light of Allah shines upon it, perhaps the possessor of the heart (Qalb) turns to the heart (Qalb) and sees from its surpassing beauty (Jamal) what bewilders him, and perhaps his tongue precedes in this bewilderment, so he says: I am the Truth (Haqq). Then if what is beyond that is not clarified to him, he is deceived by it and stops at it and perishes, and he had been deceived by a small star from the lights of the divine presence (Hadrah Ilahiyyah) and had not yet reached the moon, let alone the sun, so he is deceived, and this is the place of confusion, for the manifested (Mutajalli) is confused with that in which it is manifested (Mutajalla fihi), as the color of what appears in the mirror is confused so it is thought to be the color of the mirror, and as what is in the glass is confused with the glass, as it is said: |The glass became thin | |so they resembled each other | |And the wine became thin | |so they became similar | | | |The matter | |So it is as if they are wine | |And as if it has", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Delusion'", "badge": "Insight"}, {"arabic": "والكمال الثاني أن يراعي معنى الصدق في ألفاظه التى يناجي بها ربه كقوله (وجهت وجهي للذي فطر السموات والأرض) فإن قلبه إن كان منصرفا عن الله تعالى مشغولا بأماني الدنيا وشهواته فهو كذب وكقوله (إياك نعبد) وقوله (أنا عبد الله) فإنه إذا لم يتصف بحقيقة العبودية وكان له مطلب سوى الله لم يكن كلامه صدقا ولو طولب يوم القيامة بالصدق في قوله أنا عبد الله لعجز تحقيقه فإنه إن كان عبدا لنفسه أو عبدا لدنيا أو عبدا لشهواته لم يكن صادقا في قوله.", "english": "And the second perfection is that one should observe the meaning of truthfulness in the words with which he converses with his Lord, such as his saying: 'I have turned my face (Wajhi) toward He who created (Fatar) the heavens and the earth' (Quran 6:79). For if his Heart (Qalb) is turned away from Allah the Exalted, preoccupied with worldly hopes and desires, then it is falsehood. And like his saying: 'You alone we worship' and his saying: 'I am a slave (Abd) of Allah.' For if he is not characterized by the reality of slavery (Ubudiyyah) and has a desire other than Allah, his speech is not truthful. And if he were demanded on the Day of Resurrection for truthfulness in his saying 'I am a slave of Allah,' he would be incapable of fulfilling it. For if he is a slave to his own self (Nafs), or a slave to the world, or a slave to his desires, he is not truthful in his statement.", "book_file": "vol4_j4-k07-old.doc.txt", "book_title": "Intention, Sincerity and Truthfulness", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Intention, Sincerity and Truthfulness'", "badge": "Ethics"}, {"arabic": "ويصلي الإمام بهم ركعتين يكبر في الأولى سوى تكبيرة الإحرام والركوع سبع تكبيرات يقول بين كل تكبيرتين سبحان الله والحمد لله ولا إله إلا الله والله أكبر ويقول وجهت وجهي للذي فطر السموات والأرض عقيب تكبيرة الافتتاح ويؤخر الاستعاذة إلى ما وراء الثامنة ويقرأ سورة ق في الأولى بعد الفاتحة واقتربت في الثانية والتكبيرات الزائدة في الثانية خمس سوى تكبيرتي القيام والركوع وبين كل تكبيرتين ما ذكرناه ثم يخطب خطبتين بينهما جلسة ومن فاتته صلاة العيد قضاها.", "english": "And the Imam (Imam) prays with them two units (rak'ahs), saying the magnification (takbir) in the first unit besides the magnification of commencement (takbirat al-ihram) and the bowing (ruku') seven magnifications, saying between every two magnifications: 'Glory be to Allah (Subhan Allah) and praise be to Allah (Alhamdulillah) and there is no god but Allah (La ilaha illa Allah) and Allah is the greatest (Allahu Akbar).' And he says: 'I have turned my face (wajjahtu wajhiya) to the One who created (fatar) the heavens and the earth, sincerely devoted (hanifan), and I am not of the polytheists (mushrikin)' following the magnification of opening (takbirat al-iftitah), and he delays the seeking refuge (isti'adha) until after the eighth, and he recites Surah Qaf in the first unit after the Opening (Al-Fatihah) and 'It has approached' (Iqtarabat) in the second, and the additional magnifications in the second are five besides the two magnifications of standing (qiyam) and bowing (ruku'), and between every two magnifications is what we have mentioned. Then he delivers two sermons (khutbah) with a sitting (jalsah) between them, and whoever misses the Eid prayer makes it up.", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Mysteries of Prayer'", "badge": "Dhikr"}, {"arabic": "وأما دعاء الاستفتاح فأول كلماته قولك وجهت وجهي للذي فطر السموات والأرض وليس المراد بالوجه الوجه الظاهر فإنك إنما وجهته إلى جهة القبلة والله سبحانه يتقدس عن أن تحده الجهات حتى تقبل بوجه بدنك عليه وإنما وجه القلب هو الذي تتوجه به إلى فاطر السماوات والأرض فانظر إليه أمتوجه هو إلى أمانيه وهمه في البيت والسوق ومتبع للشهوات أو مقبل على فاطر السموات. وإياك أن تكون أول مفاتحتك للمناجاة بالكذب والاختلاق ولن ينصرف الوجه إلى الله تعالى إلا بانصرافه عما سواه فاجتهد في الحال في صرفه إليه وإن عجزت عنه على الد", "english": "And as for the opening supplication, its first words are your saying: 'I have turned my face (Wajh) toward the One Who created the heavens and the earth' (Quran 6:79). And what is intended by 'face' is not the apparent face, for you have only turned it toward the direction of the Qibla, and Allah, glorified be He, is sanctified from being limited by directions such that you would turn your bodily face toward Him. Rather, it is the face of the Heart (Qalb) that you turn toward the Creator (Fāṭir) of the heavens and the earth. So look at it: is it turned toward its hopes and concerns in the house and market, and following desires, or is it turned toward the Creator of the heavens? And beware that your first opening of the intimate discourse (Munājāh) be with falsehood and fabrication. And the face will not turn to Allah, exalted be He, except by turning away from all else besides Him, so strive in the present moment to turn it toward Him, and if you are incapable of that perpetually, then let your saying in the present moment be truthful. And when you say 'as a true monotheist (Ḥanīf), a submitter (Muslim)', it should occur to your mind that the submitter is the one from whose tongue and hand the submitters are safe. If you are not thus, then you are a liar, so strive to resolve upon it in the future and regret what has preceded of states. And when you say 'and I am not of the polytheists (Mushrikīn)', then bring to your mind the hidden polytheism (Shirk), for His saying, exalted be He: 'So whoever hopes for the meeting with his Lord, let him do righteous work and not associate in the worship of his Lord anyone' (Quran 18:110) was revealed concerning one who intends by his worship the face of Allah and the praise of people. And be cautious, fearful of this polytheism, and feel shame (Khajlah) in your heart if you describe yourself as not being from the polytheists without being free from this polytheism, for the name polytheism applies to the little...", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Prayer'", "badge": "Insight"}], "83": [{"arabic": "وكيف تعتدل القسمة مهما وقع النقص في جهته والكمال في خلقه وصنعته أو كيف تستقيم حجة إبراهيم ﭬ على أبيه إذ كان يعبد الأصنام جهلا وغيا فقال له لم تعبد ما لا يسمع ولا يبصر ولا يغني عنك شيئا ولو انقلب ذلك عليه في معبوده لأضحت حجته داحضة ودلالته ساقطة ولم يصدق قوله تعالى وتلك حجتنا آتيناها إبراهيم على قومه نرفع درجات من نشاء إن ربك حكيم عليم وكما عقل كونه فاعلا بلا جارحة وعالما بلا قلب ودماغ فليعقل كونه بصيرا بلا حدقة وسميعا بلا أذن إذ لا فرق بينهما.", "english": "And how would the division be balanced whenever deficiency occurs on His side and perfection in His creation and craftsmanship? Or how would the argument of Abraham (peace be upon him) against his father be sound when he was worshipping idols out of ignorance and misguidance, and he said to him: 'Why do you worship what does not hear nor see, nor benefit you in anything?' And if that were reversed upon him regarding his worshipped one, his argument would become invalid and his proof would fall, and the saying of Allah the Exalted would not be truthful: 'And that is Our argument which We gave to Abraham against his people. We raise in degrees whom We will. Indeed, your Lord is Wise, Knowing.' And just as one comprehends His being an Actor without an organ and a Knower without a heart and brain, let him comprehend His being a Seer without a pupil and a Hearer without an ear, for there is no difference between them.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Foundations of Belief'", "badge": "Insight"}], "91": [{"arabic": "والمعنى الثاني أن ينزله على نفسه في حق الله تعالى فإنه إذا تفكر فمعرفته جهل إذ ما قدروا الله حق قدره وطاعته رياء إذ لا يتقي الله حق تقاته وحبه معلول إذ لا يدع شهوة من شهواته في حبه ومن أراد الله به خيرا بصره بعيوب نفسه فيرى مصداق هذا البيت في نفسه وإن كان على المرتبة بالإضافة إلى الغافلين ولذلك قال صلى الله عليه وسلم لا أحصى ثناء عليك أنت كما أثنيت على نفسك حديث لا أحصي ثناء عليك أنت كما أثنيت على نفسك رواه مسلم وقد تقدم وقال صلى الله عليه وسلم إني لاستغفر الله في اليوم والليلة سبعين مرة حديث إن", "english": "The second meaning is that he applies it to himself regarding Allah (God) the Exalted, for when he reflects, his knowledge is ignorance since 'they did not measure Allah (God) with His true measure' (Quran 6:91), and his obedience is hypocrisy since he does not fear Allah (God) with His true fear, and his love is caused since he does not abandon a desire from his desires in his love. And whoever Allah (God) wills good for, He shows him the faults of his Soul (Nafs), so he sees the truth of this verse in himself, even if it is at a level relative to the heedless. Therefore, the Prophet (peace be upon him) said: 'I cannot enumerate praise upon You; You are as You have praised Yourself' (hadith: I cannot enumerate praise upon You; You are as You have praised Yourself, narrated by Muslim, and it has preceded). And he (peace be upon him) said: 'Indeed, I seek forgiveness from Allah (God) seventy times a day and night' (hadith: Indeed, I seek forgiveness from Allah (God) seventy times a day and night, preceded in the second chapter of the Remembrances (Dhikr)). And his seeking forgiveness was only about states that are degrees later relative to what comes after them, and even if they are closeness relative to what came before them, there is no closeness except that beyond it remains a closeness without end, since the path of Journeying (Suluk) to Allah (God) the Exalted is infinite, and reaching the utmost degrees of closeness is impossible.", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Audition and Ecstasy'", "badge": "Insight"}, {"arabic": "حتى قال أرباب القلوب من تحركت همته بالتصرف في نهاره لتدبير ما يفطر عليه كتبت عليه خطيئة فإن ذلك من قلة الوثوق بفضل الله عز وجل وقلة اليقين برزقه الموعود وهذه رتبة الأنبياء والصديقين والمقربين ولا يطول النظر في تفصيلها قولا ولكن في تحقيقها عملا فإنه إقبال بكنه الهمة على الله عز وجل وانصراف عن غير الله سبحانه وتلبس بمعنى قوله عز وجل: ﴿ قل الله ثم ذرهم في خوضهم يلعبون ﴾{}. وأما صوم الخصوص وهو صوم الصالحين فهو كف الجوارح عن الآثام وتمامه بستة أمور:", "english": "Until the masters of the Hearts (Qulūb) said: 'Whoever's aspiration moves him during his day to arrange what he will break his fast with, a sin is written against him, for that is from lack of trust in the grace of Allah, the Exalted and Majestic, and lack of certainty in His promised provision.' And this is the rank of the Prophets, the Truthful Ones (Ṣiddīqīn), and the Brought-Near Ones (Muqarrabīn). And one should not prolong looking into its details in speech, but in its actualization in practice, for it is turning with the essence of aspiration toward Allah, the Exalted and Majestic, and turning away from other than Allah, the Glorified, and clothing oneself with the meaning of His saying, the Exalted and Majestic: 'Say: Allah, then leave them in their vain discourse playing.' And as for the fast of the special ones, which is the fast of the righteous, it is restraining the limbs from sins, and its perfection is with six matters:", "book_file": "vol1_Vol1-book-6.doc.txt", "book_title": "Mysteries of Fasting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Fasting'", "badge": "Insight"}, {"arabic": "وإلى هذا التفريد والتجريد الإشارة بقوله تعالى: \"قل الله ثم ذرهم في خوضهم\"، وبقوله تعالى: \"إن الذين قالوا ربنا الله ثم استقاموا\" بل هو معنى قولك \"لا إله إلا الله\" أي معبود ولا محبوب سواه، فكل محبوب فإنه معبود، فإن العبد هو المقيد والمعبود هو المقيد به، وكل محب مقيد بما يحبه. ولذلك قال الله تعالى: \"أرأيت من اتخذ إلهه هواه\" وقال ﭬ: \"أبغض إله عبد في الأرض الهوى\" ولذلك قال عليه السلام: \"من قال لا إله إلا الله مخلصاً دخل الجنة\"[27] ومعنى الإخلاص أن يخلص قلبه لله فلا يبقى فيه شرك لغير الله، فيكون الله ", "english": "And to this isolation (Tafreed) and abstraction (Tajreed) is the indication by His saying, the Exalted: \"Say: Allah, then leave them in their vain discourse\" (Quran 6:91), and by His saying, the Exalted: \"Indeed, those who have said, 'Our Lord is Allah,' and then remained steadfast...\" (Quran 41:30). Rather, it is the meaning of your saying \"There is no god but Allah\"—meaning there is no object of worship (Ma'bood) and no beloved (Mahboob) except Him. For every beloved is an object of worship, since the servant (Al-'Abd) is the one bound and the object of worship is what he is bound by, and every lover is bound by what he loves. Therefore, Allah, the Exalted, said: \"Have you seen he who has taken as his god his [own] desire?\" (Quran 25:43) and He said: \"The most hated god of a servant on earth is desire (Hawa).\" And therefore, peace be upon him, said: \"Whoever says 'There is no god but Allah' sincerely (Mukhlisan) enters Paradise.\" And the meaning of sincerity (Ikhlas) is that he purifies his heart (Qalb) for Allah so that no association (Shirk) for other than Allah remains in it. Thus, Allah becomes the beloved (Mahboob) of his heart, the object of worship (Ma'bood) of his heart, and the intended (Maqsood) of his heart only. Whoever is in this state, the world is his prison because it prevents him from witnessing his beloved, and his death is liberation from the prison and arrival at the beloved. So what is the state of one who has only one beloved, and his longing for him has been prolonged, and his imprisonment from him has been extended, then he is freed from the prison and enabled to be with the beloved and given eternal security forever?", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Love, Longing, Intimacy and Contentment'", "badge": "Du'a"}, {"arabic": "والطهارة في كل رتبة نصف العمل الذي فيها فإن الغاية القصوى في عمل السر أن ينكشف له جلال الله تعالى وعظمته ولن تحل معرفة الله تعالى بالحقيقة في السر ما لم يرتحل ما سوى الله تعالى عنه ولذلك قال الله عز وجل: ﴿ قل الله ثم ذرهم في خوضهم يلعبون ﴾ {} لأنهما لا يجتمعان في قلب ﴿ وما جعل الله لرجل من قلبين في جوفه﴾ {}.", "english": "And purification in every rank is half of the work therein, for the ultimate goal in the work of the innermost secret (Sirr) is that the majesty of Allah, the Exalted, and His greatness be unveiled to it, and the knowledge of Allah, the Exalted, in reality will not settle in the innermost secret (Sirr) until what is other than Allah, the Exalted, departs from it. And for that reason, Allah, the Mighty and Majestic, said: 'Say: Allah, then leave them in their vain discourse playing' (Quran 6:91) because the two do not gather in a heart (Qalb) - 'And Allah has not made for any man two hearts within his breast' (Quran 33:4).", "book_file": "vol1_Vol1-book-3.doc.txt", "book_title": "Mysteries of Purity", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Purity'", "badge": "Insight"}, {"arabic": "وهؤلاء هم الذين يرون كل ما ليس لله حراما امتثالا لقوله تعالى قل الله ثم ذرهم في خوضهم يلعيون وهذه رتبة الموحدين المتجردين عن حظوظ أنفسهم المنفردين لله تعالى بالقصد ولا شك في أن من يتورع عما يوصل إليه أو يستعان عليه بمعصية ليتورع عما يقترن بسبب اكتسابه معصية أو كراهية", "english": "And these are those who see everything that is not for Allah as forbidden, in compliance with His saying, the Exalted: 'Say: Allah. Then leave them in their vain discourse playing.' And this is the rank of the monotheists (al-Muwahhidīn) who are stripped of the desires of their souls (Nafs), who are devoted exclusively to Allah, the Exalted, in intention. And there is no doubt that whoever abstains from what leads to it or is aided by it with disobedience, should abstain from what is associated with the cause of its acquisition with disobedience or dislike.", "book_file": "vol2_j2-k04.doc.txt", "book_title": "The Lawful and Prohibited", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'The Lawful and Prohibited'", "badge": "Insight"}], "93": [{"arabic": "ومنها الاستكبار عن الحق وكراهته، والحرص على المماراة فيه حتى إن أبغض شيء إلى المناظر أن يظهر على لسان خصمه الحق ومنهما ظهر تشمر لجحده وإنكاره بأقصى جهده وبذل غاية إمكانه في المخادعة والمكر والحيلة لدفعه حتى تصير المماراة فيه عادة طبيعية فلا يسمع كلاما إلا وينبعث من طبعه داعية الاعتراض عليه حتى يغلب ذلك على قلبه في أدلة القرآن وألفاظ الشرع فيضرب البعض منها بالبعض والمراء في مقابلة الباطل محذور إذ ندب رسول الله صلى الله عليه وسلم إلى ترك المراء بالحق على الباطل قال صلى الله عليه وسلم : (( من ترك ا", "english": "And among them is arrogance (Istikbar) from the truth and hatred of it, and eagerness for disputation (Mira') in it until indeed the most hated thing to the disputer is that the truth appears on the tongue of his opponent, and from these two emerges exertion for its denial and rejection with his utmost effort and expending the ultimate of his capability in deception, cunning, and trickery to repel it until disputation in it becomes a natural habit, so he does not hear speech except that there arises from his nature an urge to object to it until that overcomes his heart (Qalb) in the proofs of the Quran and the expressions of the Sharia, so he strikes some of them with others, and disputation in opposition to falsehood is cautioned against since the Messenger of Allah, peace be upon him, encouraged abandoning disputation even with truth against falsehood. He said, peace be upon him: 'Whoever abandons disputation while being false, Allah builds for him a house in the outskirts of Paradise, and whoever abandons disputation while being truthful, Allah builds for him a house in the highest Paradise.' And Allah the Exalted has equated between one who fabricates a lie against Allah and one who denies the truth, for He said, the Exalted: 'And who is more unjust than one who invents a lie against Allah or denies the truth when it has come to him?' (Al-Ankabut: 68). And He said, the Exalted: 'So who is more unjust than one who lies about Allah and denies the truth when it comes to him?' (Az-Zumar: 32). And among them is showing off (Riya'), and observing the creation and striving to attract their hearts (Qulub) and turn their faces, and showing off (Riya') is the chronic disease that calls to the greatest major sins as will come in the Book of Showing Off, and the disputer intends nothing except appearing before the creation and the release of their tongues with praise upon him. These are ten traits from the mothers of hidden enormities besides what occurs for those among them who are not restrained from quarreling leading to striking, punching, slapping, tearing clothes, grabbing beards, cursing parents, insulting teachers, and explicit slander, for those are not counted in the group of considered people, but rather the great ones and the rational ones among them are those who do not desist from these ten traits. Yes, some of them may be safe from some of them with one who is apparently lower than him or apparently higher than him or is far from his land and means of his livelihood, and no one among them desists from it with his counterparts who are equal to him in rank, then from each one of these ten traits branches ten others from vices we have not prolonged with mentioning them and detailing their individuals like haughtiness, anger, enmity, and...", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "وشر أنواع الكبر ما يمنع من استفادة العلم وقبول الحق والانقياد له وفيه وردت الآيات التي فيها ذم الكبر والمتكبرين قال الله تعالى \"والملائكة باسطو أيديهم\" إلى قوله \"وكنتم عن آياته تستكبرون\" ثم قال \"ادخلوا أبواب جهنم خالدين فيها فبئس مثوى المتكبرين\" ثم أخبر أن أشد أهل النار عذاباً أشدهم عتياً على الله تعالى فقال \"ثم لننزعن من كل شبعة أيهم أشد على الرحمن عتياً\" وقال تعالى \"فالذين لا يؤمنون بالآخرة قلوبهم منكرة وهم مستكبرون\" وقال عز وجل \"يقول الذين استضعفوا للذين استكبروا لولا أنتم لكنا مؤمنين\" وقال ت", "english": "And the worst type of arrogance (Kibr) is what prevents from benefiting from knowledge and accepting the truth (Haqq) and submitting to it, and in it came the verses which contain condemnation of arrogance (Kibr) and the arrogant ones (Mutakabbirun). Allah the Exalted said: 'And the angels are stretching forth their hands' to His saying 'and you were arrogant (Tastakbirun) about His signs.' Then He said: 'Enter the gates of Hell, abiding eternally therein, and wretched is the residence of the arrogant (Mutakabbirun).' Then He informed that the most severely punished people of the Fire are those most insolent (Atiyyan) against Allah the Exalted, so He said: 'Then We will surely extract from every sect those of them who were most insolent (Atiyyan) against the Most Merciful.' And He the Exalted said: 'So those who do not believe in the Hereafter - their hearts are denying and they are arrogant (Mustakbirun).' And He the Mighty and Majestic said: 'Those who were oppressed will say to those who were arrogant (Mustakbirun), \"If not for you, we would have been believers.\"' And He the Exalted said: 'Indeed, those who are arrogant (Yastakbirun) about My worship will enter Hell in humiliation.' And He the Exalted said: 'I will turn away from My signs those who are arrogant (Yatakabbarun) in the earth without right.' It is said in the interpretation (Tafsir): 'I will lift the understanding of the Quran from their hearts (Qulub),' and in some interpretations (Tafasir): 'I will veil their hearts (Qulub) from the dominion (Malakut).' And Ibn Juraij said: 'I will turn them away from reflecting upon them and taking admonition from them.'", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "94": [{"arabic": "ثم تنشر هذه الصحائف المطوية عنه مرتين مرة في القيامة الصغرى ومرة في القيامة الكبرى وأعني بالقيامة الصغرى حالة الموت إذ قال صلى الله ﭬ: (من مات فقد قامت قيامته[12]) وفي هذه القيامة يكون العبد وحده وعندها يقال ﴿ ولقد جئتمونا فرادى كما خلقناكم أول مرة ﴾ {} وفيها يقال ﴿ كفى بنفسك اليوم عليك حسيبا ﴾ {} أما في القيامة الكبرى الجامعة لكافة الخلائق فلا يكون وحده بل ربما يحاسب على ملأ من الخلق وفيها يساق المتقون إلى الجنة والمجرمون إلى النار زمرا لا آحادا والهول الأول هو هول القيامة الصغرى ولجميع أهوال ا", "english": "Then these folded records are unfolded twice: once in the Minor Resurrection (al-Qiyāmah al-Ṣughrā) and once in the Major Resurrection (al-Qiyāmah al-Kubrā). And I mean by the Minor Resurrection the state of death, as the Prophet (peace be upon him) said: 'Whoever dies, his resurrection has occurred.' In this resurrection, the servant (al-ʿabd) is alone, and at it is said: 'And indeed you have come to Us alone as We created you the first time' (Quran 6:94), and in it is said: 'Sufficient is yourself this Day against you as a reckoner' (Quran 17:14). As for the Major Resurrection, which gathers all creation, he is not alone; rather, he may be judged before an assembly of creation, and in it the righteous are driven to Paradise and the criminals to Hell in groups, not as individuals. The first terror is the terror of the Minor Resurrection, and for all the terrors of the Major Resurrection there is a counterpart in the Minor Resurrection, like the earthquake of the earth, for example. For your specific earth trembles in death, as you know that if an earthquake befalls a town, it is truthful to say 'their earth has quaked,' even if the surrounding lands have not quaked. Indeed, if a person's dwelling alone quakes, the earthquake has occurred in his regard because he is harmed by the quaking of his dwelling, not by the quaking of another's dwelling, so his share of the earthquake has been fully realized without diminishment.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Patience and Gratitude'", "badge": "Afterlife"}, {"arabic": "وقيل لعبد الملك بن مروان في مرضه الذي مات فيه كيف تجدك يا أمير المؤمنين؟ قال أجدني كما قال الله تعالى: ﴿ ولقد جئتمونا فرادى كما خلقناكم اول مرة وتركتم ما خولناكم وراء ظهوركم ﴾{} الآية، ومات.", "english": "And it was said to Abd al-Malik ibn Marwan in the illness in which he died: 'How do you find yourself, O Commander of the Believers?' He said: 'I find myself as Allah the Exalted said: \"And verily you have come to Us alone as We created you the first time, and you have left behind your backs what We bestowed upon you\" (Quran 6:94) the verse,' and he died.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Book of Repentance'", "badge": "General"}], "96": [{"arabic": "حديث اللهم فالق الإصباح وجاعل الليل سكنا والشمس والقمر حسبانا أسألك خير هذا اليوم وخير ما فيه وأعوذ بك من شره وشر ما فيه قلت هو مركب من حديثين فروى أبو منصور الديلمي في مسند الفردوس من حديث أبي سعيد قال كان رسول الله ﭬ يدعو اللهم فالق الإصباح وجاعل الليل سكنا والشمس والقمر حسبانا اقض عني الدين وأغنني من الفقر وقوني على الجهاد في سبيلك وللدار قطني في الأفراد من حديث البراء نسألك خير هذا اليوم وخير ما بعده ونعوذ بك من شر هذا اليوم وشر ما بعده وأبو داود من حديث أبي مالك الأشعري اللهم إنا نسألك خير ", "english": "The hadith: 'O Allah, Splitter (Faliq) of the dawn and Maker (Ja'il) of the night as a rest (Sakan) and the sun and the moon as a reckoning (Hisaban), I ask You for the good of this day and the good that is in it, and I seek refuge in You from its evil and the evil that is in it.' I said: It is composed of two hadiths. Abu Mansur al-Daylami narrated in Musnad al-Firdaws from the hadith of Abu Sa'id who said: The Messenger of Allah (peace be upon him) used to supplicate: 'O Allah, Splitter (Faliq) of the dawn and Maker (Ja'il) of the night as a rest (Sakan) and the sun and the moon as a reckoning (Hisaban), settle my debt and enrich me from poverty and strengthen me for the struggle (Jihad) in Your path.' And al-Daraqutni in al-Afrad from the hadith of al-Bara': 'We ask You for the good of this day and the good after it, and we seek refuge in You from the evil of this day and the evil after it.' And Abu Dawud from the hadith of Abu Malik al-Ash'ari: 'O Allah, we ask You for the good of this day, its opening (Fath), victory (Nasr), light (Nur), guidance (Huda), and blessing (Barakah), and we seek refuge in You from the evil that is in it and the evil after it,' and its chain is good. And al-Hasan ibn Ali al-Ma'mari in al-Yawm wa al-Laylah from the hadith of Ibn Mas'ud: 'O Allah, I ask You for the good that is in this day and the good after it, and I seek refuge in You from the evil of this day and the evil after it.' And the hadith is in Muslim: 'The good that is in this night...' then he said: 'And when he became morning, he said that also.'", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "97": [{"arabic": "وقد قال تعالى: ﴿ الشمس والقمر بحسبان ﴾ {} وقال تعالى: ﴿ ألم تر إلى ربك كيف مد الظل ولو شاء لجعله ساكنا ثم جعلنا الشمس عليه دليلا ثم قبضناه إلينا قبضا يسيرا ﴾ {} وقال تعالى: ﴿ والقمر قدرناه منازل ﴾ {} وقال تعالى: ﴿ وهو الذي جعل لكم النجوم لتهتدوا بها في ظلمات البر والبحر ﴾ {} فلا تظنن أن المقصود من سير الشمس والقمر بحسبان منظوم مرتب ومن خلق الظل والنور والنجوم أن يستعان بها على أمور الدنيا بل لتعرف بها مقادير الأوقات فتشتغل فيها بالطاعات والتجارة للدار الآخرة يدلك عليه قوله تعالى: ﴿ وهو الذي جعل ", "english": "And He (Allah), the Exalted, has said: 'The sun and the moon [move] by precise calculation' (Quran 55:5). And He has said: 'Have you not considered your Lord - how He extends the shadow, and if He willed, He could have made it stationary? Then We made the sun for it an indicator. Then We hold it in hand, a gentle seizing' (Quran 25:45-46). And He has said: 'And the moon - We have determined for it phases' (Quran 36:39). And He has said: 'And He is the One who made for you the stars to guide you by them through the darknesses of the land and the sea' (Quran 6:97). So do not think that the intended purpose from the movement of the sun and the moon by precise calculation, organized and ordered, and from the creation of the shadow and the light and the stars, is to be aided by them in worldly matters. Rather, it is to know by them the measures of the times so that you may occupy yourselves in them with acts of obedience (Taa'aat) and trade for the Abode of the Hereafter (Daar al-Aakhirah). What guides you to this is His saying, the Exalted: 'And He is the One who made the night and the day in succession for whoever desires to remember (Dhikr) or desires gratitude (Shukr)' (Quran 25:62). That is, one of them succeeds the other so that what was missed in one may be made up in the other. And He clarified that this is for remembrance (Dhikr) and gratitude (Shukr) only, nothing else. And He has said: 'And We made the night and the day two signs, then We erased the sign of the night and made the sign of the day visible that you may seek bounty from your Lord and may know the number of years and the account' (Quran 17:12). And indeed, the bounty sought is the reward (Thawaab) and forgiveness (Maghfirah). And we ask Allah for good success in what pleases Him.", "book_file": "vol1_Vol1-book-10.doc.txt", "book_title": "Book of Knowledge", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Knowledge'", "badge": "Dhikr"}], "101": [{"arabic": "الأصل الثاني: العلم بأنه تعالى عالم بجميع الموجودات ومحيط بكل المخلوقات لا يعزب عن علمه مثقال ذرة في الأرض ولا في السماء صادق في قوله وهو بكل شيء عليم ومرشد إلى صدقه بقوله تعالى ألا يعلم من خلق وهو اللطيف الخبير أرشدك إلى الاستدلال بالخلق على العلم بأنك لا تستريب في دلالة الخلق اللطيف والصنع المزين بالترتيب ولو في الشيء الحقير الضعيف على علم الصانع بكيفية الترتيب والترصيف فما ذكره الله سبحانه هو المنتهى في الهداية والتعريف.", "english": "The Second Foundation: The Knowledge (Ilm) that He, exalted is He, is Knowing (Alim) of all existents and encompassing of all created beings; not even an atom's weight in the earth or in the heavens escapes His Knowledge (Ilm), truthful in His saying 'and He is of all things Knowing (Alim)', and guiding to its truthfulness by His saying, exalted is He: 'Does He not know, He Who created? And He is the Subtle (Al-Latif), the Aware (Al-Khabir).' He guides you to the deduction from creation to the knowledge that you do not doubt in the indication of the subtle (latif) creation and the work adorned with arrangement, even in the insignificant weak thing, of the Maker's knowledge of the manner of arrangement and composition. So what Allah, glorified is He, has mentioned is the utmost in guidance and definition.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Foundations of Belief'", "badge": "Dhikr"}], "103": [{"arabic": "الأصل التاسع: العلم بأنه تعالى مع كونه منزها عن الصورة والمقدار مقدسا عن الجهات والأقطار مرئي بالأعين والأبصار في الدار الآخرة دار القرار لقوله تعالى وجوه يومئذ ناضرة إلى ربها ناظرة ولا يرى في الدنيا تصديقا لقوله عز وجل لا تدركه الأبصار وهو يدرك الأبصار ولقوله تعالى في خطاب موسى عليه السلام لن تراني وليت شعري كيف عرف المعتزل من صفات رب الأرباب ما جهله موسى عليه السلام وكيف سأل موسى عليه السلام الرؤية مع كونها محالا ولعل الجهل بذوي البدع والأهواء من الجهلة الأغبياء أولى من الجهل بالأنبياء صلوات ا", "english": "The Ninth Principle: The knowledge that He, exalted, while being free from form and magnitude, sanctified from directions and dimensions, is visible to the eyes and sights in the Abode of the Hereafter, the Abode of Settlement, due to His saying, exalted: 'Faces that day will be radiant, looking at their Lord.' And He is not seen in this world, confirming His saying, mighty and glorious: 'The sights do not comprehend Him, and He comprehends the sights,' and His saying in addressing Moses, peace be upon him: 'You will not see Me.' And I wonder how the Mu'tazilite knew from the attributes of the Lord of lords what Moses, peace be upon him, was ignorant of, and how Moses, peace be upon him, asked for vision while it is impossible. Perhaps the ignorance of the people of innovation and desires from the ignorant fools is more appropriate than the ignorance of the prophets, prayers of God be upon them. As for the aspect of applying the verse of vision according to its apparent meaning, it is that it does not lead to impossibility, for vision is a type of unveiling and knowledge, except that it is more complete and clearer than knowledge. So if it is permissible for knowledge to relate to Him without being in a direction, then it is permissible for vision to relate to Him without being in a direction. And just as it is permissible for God, exalted, to see the creation without being opposite them, it is permissible for the creation to see Him without opposition. And just as it is permissible to know without modality and form, it is permissible to see likewise.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Foundations of Belief'", "badge": "Du'a"}], "107": [{"arabic": "مع علمه ﭬ بأنه لو شاء الله ما أشركوا إذا لو شاء لآتي كل نفس هداها، وفي سورة الواقعة ﴿ ليس لوقعتها كاذبة، خافضة رافعة ﴾ {} أي جف القلم بما هو كائن وتمت السابقة حتى نزلت الواقعة إما خافضة قوما كانوا مرفوعين في الدنيا وإما رافعة قوما كانوا مخفوضين في الدنيا", "english": "With his knowledge (peace be upon him) that if Allah had willed, they would not have associated partners (with Him) - since if He had willed, He would have brought every soul (Nafs) its guidance. And in Surah Al-Waqi'ah: 'Its occurrence is not a lie, lowering and raising' - meaning the pen has dried with what is to be, and the precedent has been completed until Al-Waqi'ah descended, either lowering a people who were elevated in the worldly life or raising a people who were lowered in the worldly life.", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Fear and Hope'", "badge": "Ethics"}], "108": [{"arabic": "وأن يقصد به دفع الروائح الكريهة عن نفسه التى تؤدي إلى إيذاء مخالطيه وأن يقصد حسم باب الغيبة عن المغتابين إذا اغتابوه بالروائح الكريهة فيعصون الله بسببه فمن تعرض للغيبة وهو قادر على الاحتراز منها فهو شريك في تلك المعصية كما قيل إذا ترحلت عن قوم وقد قدروا ان لا تفارقهم فالراحلون هم وقال الله تعالى ولا تسبوا الذين يدعون من دون الله فيسبوا الله عدوا بغير علم أشار به إلى أن التسبب إلى الشر شر وأن يقصد به معالجة دماغه لتزيد به فطنته وذكاؤه ويسهل عليه درك مهمات دينه بالفكر فقد قال الشافعي رحمه الله من ", "english": "And he intends by it to repel the foul odors from himself that lead to harming his companions, and he intends to seal the door of backbiting (Ghibah) from the backbiters if they backbite him due to the foul odors, thus they disobey Allah because of him. For whoever exposes himself to backbiting while capable of avoiding it is a partner in that disobedience, as it is said: 'If you depart from a people when they were able not to part from them, the departers are them.' And Allah the Exalted said: 'And do not insult those they invoke besides Allah, lest they insult Allah in enmity without knowledge.' He indicated by this that causing evil is evil, and he intends by it to treat his brain to increase thereby his acumen and intelligence, and to facilitate for him the comprehension of the important matters of his religion through thought (Fikr). Indeed, Al-Shafi'i, may Allah have mercy on him, said: 'Whoever's scent becomes pleasant, his intellect increases.' This and its like from the intentions (Niyyat) the jurist (Faqih) is not incapable of them if the trade of the Hereafter and the seeking of good dominate his heart (Qalb).", "book_file": "vol4_j4-k07-old.doc.txt", "book_title": "Intention, Sincerity and Truthfulness", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Intention, Sincerity and Truthfulness'", "badge": "Insight"}, {"arabic": "ومنها أن يتقي مواضع التهم صيانة لقلوب الناس عن سوء الظن ولألسنتهم عن العيبة فإنهم إذا عصوا الله بذكره وكان هو السبب فيه كان شريكا قال الله تعالى ولا تسبوا الذي يدعون من دون الله فيسبوا الله عدوا بغير علم وقال صلى الله عليه وسلم كيف ترون من يسب أبويه فقالوا وهل من أحد يسب أبويه فقال نعم يسب أبوي غيره فيسبون أبويه حديث كيف ترون من سب أبويه فقالوا وهل من أحد يسب أبويه الحديث متفق عليه من حديث عبد الله بن عمرو", "english": "And among them is that one avoids places of suspicion to protect the hearts of people from bad thought (Sūʾ al-Ẓann) and their tongues from fault-finding (ʿAyb). For if they disobey Allah by mentioning Him and he was the cause in it, he becomes a partner. Allah the Exalted said: 'And do not revile those whom they invoke besides Allah, lest they revile Allah in enmity without knowledge.' And the Prophet (peace be upon him) said: 'What do you think of one who reviles his parents?' They said: 'Is there anyone who reviles his parents?' He said: 'Yes, he reviles the parents of another, so they revile his parents.' The hadith: 'What do you think of one who reviles his parents?' They said: 'Is there anyone who reviles his parents?' The hadith is agreed upon from the narration of ʿAbd Allāh ibn ʿAmr.", "book_file": "vol2_j2-k05.doc.txt", "book_title": "Duties of Brotherhood", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Duties of Brotherhood'", "badge": "Hadith"}], "115": [{"arabic": "وَقِيلَ فِي قَوْلِهِ تَعَالَى: ﴿ وَتَمَّتْ كَلِمَتُ رَبِّكَ صِدْقًا وَعَدْلًا ﴾ صِدْقًا لِمَنْ مَاتَ عَلَى الْإِيمَانِ وَعَدْلًا لِمَنْ مَاتَ عَلَى الشِّرْكِ. وَقَدْ قَالَ تَعَالَى: ﴿ وَلِلَّهِ عَاقِبَةُ الْأُمُورِ ﴾ فَمَهْمَا كَانَ الشَّكُّ بِهَذِهِ الْمِثَابَةِ كَانَ الِاسْتِثْنَاءُ وَاجِبًا لِأَنَّ الْإِيمَانَ عِبَارَةٌ عَمَّا يُفِيدُ الْجَنَّةَ كَمَا أَنَّ الصَّوْمَ عِبَارَةٌ عَمَّا يُبْرِئُ الذِّمَّةَ وَمَا فَسَدَ قَبْلَ الْغُرُوبِ لَا يُبْرِئُ الذِّمَّةَ فَيَخْرُجُ عَنْ كَوْنِهِ صَوْمًا فَ", "english": "And it is said regarding His Exalted statement: 'And the Word (Kalimah) of your Lord has been perfected in truth and justice' (Quran 6:115) — truth for the one who dies upon Faith (Iman) and justice for the one who dies upon Polytheism (Shirk). And He Exalted has said: 'And to Allah belongs the final outcome of all matters' (Quran 22:41). Therefore, whenever doubt exists in this station (Mithabah), the exception (Istithna') becomes obligatory because Faith (Iman) is an expression for that which yields Paradise (Jannah) just as Fasting (Sawm) is an expression for that which absolves the religious obligation (Dhimma). And that which becomes invalid before sunset does not absolve the religious obligation (Dhimma) and thus exits from being a fast, and likewise Faith (Iman). Indeed, it is not far-fetched that one might be asked about the past fast in which there is no doubt after its completion, and it is said: 'Did you fast yesterday?' and he says: 'Yes, if Allah Exalted wills,' since the true fast is the accepted one, and the accepted one is hidden from him; none has insight into it except Allah Exalted. From this, the exception (Istithna') becomes good in all righteous deeds (A'mal al-Birr), and that is doubt regarding acceptance (Qabul), since after the apparent conditions of validity have been met, subtle causes (Asbab Khafifah) that none has insight into except the Lord of Lords (Rabb al-Arbab), Glorious is His Majesty, may prevent acceptance, so doubt in it becomes good. These are the aspects of the goodness of the exception (Istithna') in the answer regarding Faith (Iman), and they are the last with which we conclude the Book of the Foundations of Beliefs (Qawa'id al-'Aqa'id). The book is completed by the praise of Allah Exalted and upon our master Muhammad and upon every chosen servant (Abd Mustafa).", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}], "116": [{"arabic": "فعليك إن كنت من المرابطين المراقبين لنفسك أن تطالع أحوال الرجال والنساء من المجتهدين لينبعث نشاطك ويزيد حرصك وإياك أن تنظر إلى أهل عصرك فإنك إن تطع أكثر من في الأرض يضلوك على سبيل الله وحكايات المجتهدين غير محصورة وفيما ذكرناه كفاية للمعتبر", "english": "So upon you, if you are among those who are steadfast (al-murabitin) and watchful (al-muraqibin) over your self (nafs), is to study the states of the men and women among the diligent ones (al-mujtahidin) so that your eagerness may be aroused and your earnestness may increase. And beware of looking at the people of your era, for if you obey most of those on earth, they will lead you astray from the path of Allah. And the accounts of the diligent ones are not limited, and in what we have mentioned is sufficient for the one who takes heed.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "118": [{"arabic": "ومن ذلك الورع عن متروك التسمية وإن لم يختلف فيه قول الشافعي رحمه الله لأن الآية ظاهرة في إيجابها والأخبار متواترة فيه فإنه صلى الله عليه وسلم قال لكل من سأله عن الصيد إذا أرسلت كلبك المعلم وذكرت عليه اسم الله فكل حديث إذا أرسلت كلبك وذكرت اسم الله فكل متفق عليه من حديث عدي بن حاتم ومن حديث أبي ثعلبة الخشني ونقل ذلك على التكرر وقد شهر الذبح بالبسملة حديث التسمية على الذبح : متفق عليه من حديث رافع بن خديج ما أنهر الدم وذكر اسم الله عليه فكلواليس السن والظفر وكل ذلك يقوي دليل الاشتراط ولكن لما صح ق", "english": "And from that is the scrupulousness (Wara') about omitting the naming (Tasmiyah) even if there is no disagreement in it from the statement of Al-Shafi'i, may Allah have mercy on him, because the verse is apparent in its obligation and the reports are mutawatir in it. For indeed he, peace be upon him, said to everyone who asked him about hunting: 'If you send your trained dog and mention upon it the name of Allah, then eat.' The hadith: 'If you send your dog and mention the name of Allah, then eat' is agreed upon from the hadith of 'Adi ibn Hatim and from the hadith of Abu Tha'labah al-Khushani, and that is transmitted repeatedly. And the slaughtering with the basmalah has become famous. The hadith about the naming upon slaughter: agreed upon from the hadith of Rafi' ibn Khadij: 'What causes the blood to flow and the name of Allah is mentioned upon it, then eat, and not the tooth and the claw.' And all of that strengthens the evidence of the condition. But since his statement, peace be upon him, is authentic: 'The believer (Mu'min) slaughters upon the name of Allah, the Exalted, whether he names or does not name.' The hadith: 'The believer (Mu'min) slaughters upon the name of Allah, the Exalted, whether he names or does not name.' The author said that it is authentic. I said: It is not known with this wording, let alone its authenticity. And Abu Dawud in the Marasil from the narration of Al-Salt, marfu': 'The slaughter of a Muslim is lawful (halal) whether he mentions the name of Allah or does not mention.' And Al-Tabarani in Al-Awsat, Al-Daraqutni, Ibn 'Adi, and Al-Bayhaqi from the hadith of Abu Hurayrah: A man said: 'O Messenger of Allah, a man among us slaughters and forgets to name Allah.' He said: 'The name of Allah is upon every Muslim.' Ibn 'Adi said: It is munkar. And Al-Daraqutni and Al-Bayhaqi from the hadith of Ibn 'Abbas: 'The Muslim, his name suffices him. If he forgets to name when he slaughters, then let him name and mention the name of Allah, then let him eat.' In it is Muhammad ibn Sinan, whom the majority weakened. And it is possible that this is general, necessitating diverting the verse and the other reports from their apparent meanings. And it is possible that this is specified for the forgetful one and the apparent meanings are abandoned without interpretation. And carrying it upon the people was possible as a preparation for his excuse in omitting the naming due to forgetfulness. And generalizing it and interpreting the verse was possible with a closer possibility, so we preferred that. And we do not deny raising the opposite possibility. So the scrupulousness (Wara') about such as this is important, occurring in the first degree. The second degree...", "book_file": "vol2_j2-k04.doc.txt", "book_title": "The Lawful and Prohibited", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'The Lawful and Prohibited'", "badge": "Hadith"}], "119": [{"arabic": "ومن ذلك الورع عن متروك التسمية وإن لم يختلف فيه قول الشافعي رحمه الله لأن الآية ظاهرة في إيجابها والأخبار متواترة فيه فإنه صلى الله عليه وسلم قال لكل من سأله عن الصيد إذا أرسلت كلبك المعلم وذكرت عليه اسم الله فكل حديث إذا أرسلت كلبك وذكرت اسم الله فكل متفق عليه من حديث عدي بن حاتم ومن حديث أبي ثعلبة الخشني ونقل ذلك على التكرر وقد شهر الذبح بالبسملة حديث التسمية على الذبح : متفق عليه من حديث رافع بن خديج ما أنهر الدم وذكر اسم الله عليه فكلواليس السن والظفر وكل ذلك يقوي دليل الاشتراط ولكن لما صح ق", "english": "And from that is the scrupulousness (Wara') about omitting the naming (Tasmiyah) even though there is no disagreement in it according to Imam al-Shafi'i, may Allah have mercy on him, because the verse is apparent in its obligation and the reports are mutawatir in it. For indeed the Prophet, peace be upon him, said to everyone who asked him about hunting: 'If you send your trained dog and mention upon it the name of Allah, then eat.' The hadith 'If you send your dog and mention the name of Allah, then eat' is agreed upon from the hadith of 'Adi ibn Hatim and from the hadith of Abu Tha'labah al-Khushani, and that has been transmitted repeatedly. And the slaughter with the basmalah has become famous. The hadith about naming upon slaughter: agreed upon from the hadith of Rafi' ibn Khadij: 'What causes the blood to flow and the name of Allah is mentioned upon it, then eat, except the tooth and the claw.' And all of that strengthens the evidence of the condition. But when his saying, peace be upon him, was authenticated: 'The believer (Mu'min) slaughters upon the name of Allah the Exalted, whether he names or does not name.' The hadith 'The believer slaughters upon the name of Allah the Exalted, whether he names or does not name' - the author said it is authentic. I said: It is not known with this wording, let alone its authenticity. And Abu Dawud in the Marasil from the narration of al-Salt, marfu': 'The slaughter of the Muslim is lawful (halal) whether he mentions the name of Allah or does not mention.' And al-Tabarani in al-Awsat, al-Daraqutni, Ibn 'Adi, and al-Bayhaqi from the hadith of Abu Hurayrah: A man said: 'O Messenger of Allah, a man among us slaughters and forgets to name Allah.' He said: 'The name of Allah is upon every Muslim.' Ibn 'Adi said it is munkar. And al-Daraqutni and al-Bayhaqi from the hadith of Ibn 'Abbas: 'The Muslim, his name suffices him. If he forgets to name when he slaughters, then let him name and mention the name of Allah, then let him eat.' In it is Muhammad ibn Sinan, whom the majority weakened. And it is possible that this is general, necessitating diverting the verse and the other reports from their apparent meanings. And it is possible that this is specified for the forgetful one and the apparent meanings are abandoned without interpretation. And carrying it upon the people was possible as a preparation for his excuse in omitting the naming due to forgetfulness. And generalizing it and interpreting the verse was possible with a closer possibility - we preferred that. And we do not deny raising the opposite possibility. So scrupulousness (Wara') about something like this is important, occurring in the first degree, the second rank.", "book_file": "vol2_j2-k04.doc.txt", "book_title": "The Lawful and Prohibited", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'The Lawful and Prohibited'", "badge": "Hadith"}], "120": [{"arabic": "فإذن قد أسبغ الله تعالى نعمه عليك ظاهرة وباطنة ثم قال: ﴿ وذروا ظاهر الإثم وباطنه ﴾ فترك باطن الإثم مما لا يعرفه الخلق من الحسد وسوء الظن والبدعة وإضمار الشر للناس إلى غير ذلك من آثام القلوب هو الشكر للنعم الباطنة وترك الإثم الظاهر بالجوارح شكر للنعمة الظاهرة، بل أقول كل من عصى الله تعالى ولو في طريفة واحدة بأن فتح جفنه مثلا حيث يجب غض البصر فقد كفر كل نعمة لله تعالى عليه في السموات والأرض وما بينهما فإن كل ما خلقه الله تعالى حتى الملائكة والسموات والأرض والحيوانات والنبات بجملته نعمة على كل واحد", "english": "Therefore, Allah the Exalted has poured His blessings upon you, apparent and hidden. Then He said: 'And abandon sin, its apparent and its hidden.' So abandoning the hidden sin, which the creation does not recognize—from envy (Hasad), bad suspicion (Su' al-Zann), innovation (Bid'ah), and harboring evil for people, to other than that from the sins of the hearts (Qulub)—is gratitude for the hidden blessings. And abandoning the apparent sin with the limbs (Jawarih) is gratitude for the apparent blessing. Rather, I say: Whoever disobeys Allah the Exalted, even in a single twinkling, by opening his eyelid, for example, where lowering the gaze is obligatory, has disbelieved every blessing of Allah the Exalted upon him in the heavens and the earth and what is between them. For everything that Allah the Exalted created—even the angels, the heavens, the earth, the animals, and the plants in their entirety—is a blessing upon every one of the servants (Ibad), by which his benefit has grown, even if others also benefit from it. For Allah the Exalted has in every twinkling of the eyelid two blessings in the eyelid itself, since He created under each eyelid muscles, and they have tendons and ligaments connected to the nerves of the brain, by which the lowering of the upper eyelid and the raising of the lower eyelid is accomplished. And on each eyelid are black hairs, and the blessing of Allah the Exalted in their blackness is that they gather the light of the eye, since whiteness disperses light and blackness gathers it. And the blessing of Allah the Exalted in arranging them in a single row is to be a barrier for creeping things from crawling into the inner part of the eye and a catcher for the specks that scatter in the air. And He has in each hair of them two blessings: from the softness of its root, and with the softness, the firmness of its erection. And He has in the interweaving of the...", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "121": [{"arabic": "ومن آفات البخل الحرص على ملازمة الأسواق لجمع المال والأسواق هي معشش الشياطين وقال أبو أمامة إن رسول الله صلى الله عليه وسلم قال إن إبليس لما نزل إلى الأرض قال يارب أنزلتني إلى الأرض وجعلتني رجيما فاجعل لي بيتا قال الحمام قال أجعل لي مجلسا قال الأسواق ومجامع الطرق قال اجعل لي طعاما قال طعامك ما لم يذكر اسم الله عليه قال اجعل لي شرابا قال كل مسكر قال اجعل لي مؤذنا قال المزامير قال اجعل لي قرآنا قال الشعر قال اجعل لي كتابا قال الوشم قال اجعل لي حديثا قال الكذب قال اجعل لي مصايد قال النساء[60]", "english": "And from the afflictions of miserliness is the greed for frequenting markets to gather wealth, and markets are the nesting places of devils. And Abu Umamah said: Indeed the Messenger of Allah (peace be upon him) said: When Iblis descended to the earth, he said: 'O Lord, You have sent me down to the earth and made me accursed, so appoint for me a house.' He said: 'The bathhouse.' He said: 'Appoint for me a gathering place.' He said: 'The markets and crossroads.' He said: 'Appoint for me food.' He said: 'Your food is that upon which the name of Allah has not been mentioned.' He said: 'Appoint for me a drink.' He said: 'Every intoxicant.' He said: 'Appoint for me a caller to prayer.' He said: 'The wind instruments.' He said: 'Appoint for me a Quran.' He said: 'Poetry.' He said: 'Appoint for me a book.' He said: 'Tattooing.' He said: 'Appoint for me a discourse.' He said: 'Falsehood.' He said: 'Appoint for me snares.' He said: 'Women.'", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Disciplining the Soul'", "badge": "Ethics"}], "122": [{"arabic": "ومن ليس معه أصل معرفة الله تعالى لم يكن له مطمع في هذا النور، فيبقى كمن مثله في الظلمات ليس بخارج منها بل \"كظلمات في بحر لجى يغشاه موج من فوقه موج من فوقه سحاب ظلمات بعضها فوق بعض\" فإذن لا سعادة إلا في معرفة الله تعالى وأما ما عدا ذلك من المعارف فمنها ما لا فائدة له أصلاً كمعرفة الشعر وأنساب العرب وغيرهما، ومنها ما له منفعة في الإعانة على معرفة الله تعالى كمعرفة لغة العرب والتفسير والفقه والأخبار، فإن معرفة لغة العرب تعين على معرفة تفسير القرآن، ومعرفة التفسير تعين على معرفة ما في القرآن من كيفي", "english": "And whoever does not have the foundation of knowledge of Allah (the Exalted) has no hope for this light, so he remains like one whose likeness is in the darknesses, not exiting from them, rather \"like darknesses in a deep sea covered by a wave above which is a wave above which are clouds, darknesses some above others.\" Therefore, there is no happiness except in knowledge of Allah (the Exalted). As for other than that from the knowledges, among them are those that have no benefit at all, like knowledge of poetry and Arab genealogies and others, and among them are those that have benefit in aiding towards knowledge of Allah (the Exalted), like knowledge of the language of the Arabs, interpretation (Tafsir), jurisprudence (Fiqh), and reports (Akhbar). For knowledge of the language of the Arabs aids in knowledge of interpretation of the Quran, and knowledge of interpretation aids in knowledge of what is in the Quran from the manner of acts of worship and works that benefit purification of the Soul (Nafs), and knowledge of the way of purification of the Soul (Nafs) benefits the preparedness of the Soul (Nafs) for accepting the gifts to knowledge of Allah (the Glorified and Exalted), as He (the Exalted) said: \"Indeed, he has succeeded who purifies it,\" and He (the Mighty and Majestic) said: \"And those who strive in Us, We will surely guide them to Our ways.\" So the totality of these knowledges is like the means to realization of knowledge of Allah (the Exalted), and indeed the perfection is in knowledge of Allah and knowledge of His attributes and His actions, and it encompasses all knowledges surrounding the existents, since the existents are all from His actions. So whoever knows them from the perspective that they are the action of Allah (the Exalted), and from the perspective of their connection to the power and the will and the wisdom, then they are from the completion of knowledge of Allah (the Exalted). And this is the ruling of perfection of knowledge we have mentioned, even if it is not fitting for the chapter.", "book_file": "vol3_Vol3-book-8a.doc.txt", "book_title": "Condemnation of Status and Ostentation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "وقد سماه الله نورا في قوله تعالى: (الله نور السموات والأرض مثل نوره كمشكاة( وسمى العلم المستفاد منه روحا ووحيا وحياة فقال تعالى: (وكذلك أوحينا إليك روحا من أمرنا( وقال سبحانه (أومن كان ميتا فأحييناه وجعلنا له نورا يمشي به في الناس( وحيث ذكر النور والظلمة أراد به العلم والجهل كقوله (يخرجهم من الظلمات إلى النور(.", "english": "And Allah has called it (the intellect) light in His saying: 'Allah is the Light of the heavens and the earth. The example of His light is like a niche...' (Quran 24:35). And He called the knowledge derived from it spirit (Ruh) and revelation (Wahy) and life (Hayat). So He said: 'And thus We have revealed to you a spirit (Ruh) from Our command...' (Quran 42:52). And He, the Exalted, said: 'Or is one who was dead (Maytan) and We gave him life (Ahyaynahu) and made for him a light (Nuran) by which he walks among the people like one who is in darkness (Zulumat) from which he will never emerge?' (Quran 6:122). And wherever He mentioned light (Nur) and darkness (Zulumah), He intended by it knowledge (Ilm) and ignorance (Jahl), as in His saying: 'He brings them out from darknesses (Zulumat) into the light (Nur)...' (Quran 2:257).", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "والهداية الثالثة وراء الثانية وهو النور الذى يشرق في عالم النبوة والولاية بعد كمال المجاهدة فيهتدى بها إلا ما لا يهتدى إليه بالعقل الذى يحصل به التكليف وإمكان تعلم العلوم وهو الهوى المطلق وما عداه حجاب له ومقدمات وهو الذى شرفه الله تعالى بتخصيص الإضافة إليه وإن كان الكل من جهته تعالى فقال تعالى: ﴿ قل إن هدى الله هو الهدى ﴾ {} وهو المسمى حياة في قوله تعالى: ﴿ أو من كان ميتا فأحييناه وجعلنا له نورا يمشى به في الناس ﴾ {} والمعنى بقوله تعالى: ﴿ أفمن شرح الله صدره للإسلام فهو على نور من ربه ﴾ {}", "english": "And the third guidance is beyond the second, and it is the Light (Nur) that shines in the world of Prophethood (Nubuwwah) and Sainthood (Wilayah) after the perfection of striving (Mujahadah), so one is guided by it except what cannot be guided to by the intellect (Aql) through which obligation (Taklif) and the possibility of learning sciences is attained, and it is the absolute desire (Hawa) and what is other than it is a veil for it and its preliminaries, and it is that which Allah the Exalted honored by specifying the attribution to Him, even though all is from His side, the Exalted, so He said: 'Say: Indeed, the guidance of Allah is the guidance.' And it is called life in His saying: 'Or is one who was dead and We gave him life and made for him a light by which he walks among the people?' And the meaning is in His saying: 'So is one whose breast Allah has expanded to Islam, then he is upon a light from his Lord?'", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Patience and Gratitude'", "badge": "Worship"}], "125": [{"arabic": "ولما سئل رسول الله صلى الله عليه وسلم عن معنى الشرح في قوله تعالى: \" فمن يرد الله أن يهديه يشرح صدره للإسلام \" وقيل له: ما هذا الشرح؟ قال: \" إن النور إذا دخل في القلب انشرح له الصدر وانفسح \" قيل يا رسول الله وهل لذلك من علامة؟ قال: \" نعم، التجافي عن دار الغرور؛ والإنابة إلى دار الخلود، والاستعداد للموت قبل نزوله\" فانظر كيف جعل الزهد شرطاً للإسلام وهو التجافي عن دار الغرور؟.", "english": "And when the Messenger of Allah (peace be upon him) was asked about the meaning of the expansion (sharḥ) in the saying of the Exalted: \"So whoever Allah wills to guide, He expands his chest (ṣadr) for Islam\" and it was said to him: What is this expansion? He said: \"When the Light (Nūr) enters the Heart (Qalb), the chest expands and widens for it.\" It was said: O Messenger of Allah, is there a sign for that? He said: \"Yes, turning away from the abode of deception (dār al-ghurūr); and turning repentantly to the abode of eternity (dār al-khulūd), and preparing for death before its arrival.\" So look how he made asceticism (zuhd) a condition for Islam, which is turning away from the abode of deception?", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "[82]  حديث سئل عن قوله تعالى - فمن يرد الله أن يهديه - الحديث أخرجه الحاكم وقد تقدم.", "english": "[82] A hadith was asked about His saying, the Exalted - 'So whoever Allah intends to guide...' - the hadith was reported by Al-Hakim and has preceded.", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Poverty and Abstinence'", "badge": "Hadith"}], "128": [{"arabic": "لذي خلق لأجله؛ وهو العلم والحكمة والمعرفة وحب الله تعالى وعبادته والتلذذ بذكره وإيثاره ذلك على كل شهوة سواه والاستعانة بجميع الشهوات والأعضاء عليه قال الله تعالى \"وما خلقت الجن والإنس إلا ليعبدون\" ففي كل عضو فائدة وفائدة القلب الحكمة والمعرفة. وخاصية النفس التي للآدمي، ما يتميز بها عن البهائم، فإنه لم يتميز عنها بالقوة على الأكل والوقاع والإبصار أو غيرها: بل بمعرفة الأشياء على ما هي عليه. وأصل الأشياء وموجدها ومخترعها هو الله عز وجل الذي جعلها أشياء. فلو عرف كل شيء ولم يعرف الله عز وجل فكأنه لم ", "english": "For which He created; and it is knowledge and wisdom and recognition and love of Allah the Exalted and worship of Him and delighting in His remembrance (Dhikr) and preferring that over every desire besides it and seeking help with all desires and limbs upon it. Allah the Exalted said: \"And I did not create the jinn and mankind except to worship Me.\" So in every limb there is benefit and the benefit of the heart (Qalb) is wisdom and recognition. And the characteristic of the soul (Nafs) that belongs to the human being, that which distinguishes him from the beasts, for he is not distinguished from them by the power to eat and copulate and see or other than that: but by recognizing things as they are. And the origin of things and their bringer-into-existence and their inventor is Allah the Mighty and Majestic who made them things. So if he recognized every thing and did not recognize Allah the Mighty and Majestic, it is as if he did not recognize anything. And the sign of recognition is love, so whoever recognized Allah the Exalted loved Him, and the sign of love is that he does not prefer over Him the world, nor other than it from beloved things, as Allah the Exalted said: \"Say: If your fathers and your sons and your brothers and your wives\" to His saying \"are dearer to you than Allah and His Messenger and striving in His cause, then wait until Allah brings His command.\" So whoever has something dearer to him than Allah, his heart (Qalb) is sick, just as every stomach that clay becomes dearer to it than bread and water or its desire falls away from bread and water, then it is sick. So these are the signs of sickness, and by this it is known that the hearts (Qulub) are all sick except what Allah wills, except that from the sicknesses is what its possessor does not know, and the sickness of the heart (Qalb) is from what its possessor does not know, so therefore he is heedless of it. And if he knew it, patience upon the bitterness of its medicine would be difficult for him, for its medicine is opposing the desires and it is extracting the spirit (Ruh). So if he found from himself the strength of patience upon it, he did not find a skilled physician to treat him, for the physicians are the scholars, and the sickness has dominated them, so the sick physician rarely pays attention to his treatment, so for this the disease became incurable and the sickness chronic, and this knowledge became obliterated, and the medicine of the hearts (Qulub) was denied completely and their sickness was denied, and the creation turned to love of the world, and to works whose outward appearance is acts of worship and their inward reality is habits and ostentation. So these are the signs of the roots of the sicknesses. And as for the signs of their return to health after treatment, it is that he looks at the ailment that he treats, for if he treats the disease of miserliness, it is the destroyer that distances from Allah the Mighty and Majestic, and its treatment is only by giving wealth and spending it, but he may give wealth to a limit that makes him become a squanderer, so squandering also becomes a disease, so it was as if treating coldness with heat until heat overcomes, so it is also a disease, rather what is required is moderation between heat and coldness. And likewise what is required is moderation between squandering and stinginess until it is upon the middle and at the utmost of distance from the two extremes, so if you want to know the middle, then look.", "book_file": "vol3_Vol3-book2a.doc.txt", "book_title": "Breaking the Two Desires", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Breaking the Two Desires'", "badge": "Insight"}, {"arabic": "ولا يتفكر واحد منهم إلا ما شاء الله في جنازة نفسه وفي حاله إذا حمل عليها ولا سبب لهذه الغفلة إلا قسوة القلوب بكثرة المعاصي والذنوب حتى نسينا الله تعالى واليوم الآخر والأهوال التي بين أيدينا فصرنا نلهو ونغفل ونشتغل بما لا يعنينا فنسأل الله تعالى اليقظة من هذه الغفلة فإن أحسن أحوال الحاضرين على الجنائز بكاؤهم على الميت ولو عقلوا لبكوا على أنفسهم لا على الميت نظر إبراهيم الزيات إلى إناس يترحمون على الميت فقال لو ترحمون على أنفسكم لكان خيرا لكم إنه نجا من أهوال ثلاثة: وجه ملك الموت وقد رأى، ومرارة ا", "english": "And not one of them reflects except what Allah wills upon his own funeral and his state when carried upon it, and there is no cause for this heedlessness except the hardening of the hearts (Qulub) through abundant sins and transgressions until we forgot Allah the Exalted and the Last Day and the terrors that are before us, so we became diverted, heedless, and preoccupied with what does not concern us, so we ask Allah the Exalted for awakening from this heedlessness. For the best state of those present at funerals is their weeping over the deceased, and if they were rational, they would weep over themselves, not over the deceased. Ibrahim al-Zayyat looked at people showing mercy upon the deceased and said: 'If you showed mercy upon yourselves, it would be better for you. He has been saved from three terrors: the face of the Angel of Death, which he has seen; the bitterness of death, which he has tasted; and the fear of the end (al-Khatimah), which he has become secure from.' And Abu 'Amr ibn al-'Ala' said: 'I sat with Jarir while he was dictating poetry to his scribe, then a funeral appeared, so he stopped and said: 'By Allah, these funerals have aged me,' and he began to say: 'Funerals frighten us when approaching, and we divert ourselves when they depart, like the fright of a flock at a wolf's den, but when it disappears, they return to grazing.' Among the etiquettes of attending funerals are reflection, alertness, preparation, and walking before them in a manner of humility as we mentioned its etiquettes and practices in the discipline of jurisprudence, and among its etiquettes is having good thoughts about the deceased even if he was a sinner, and having bad thoughts about oneself even if one's outward appearance is righteous, for the end (al-Khatimah) is perilous, not known.'", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}], "129": [{"arabic": "وقال تعالى: \" وكذلك نولي بعض الظالمين بعضاً \". وفي الخبر: \" إن الله تعالى أخذ الميثاق على كل مؤمن أن يبغض كل منافق وعلى كل منافق أن يبغض كل مؤمن\"[69]. وقال عليه السلام: \" المرء مع من أحب\"[70] وقال: \" من أحب قوماً ووالاهم حشر معهم يوم القيامة\"[71]. وقال عليه السلام: \" أوثق عرى الإيمان الحب في الله والبغض في الله\"[72]. وشواهد هذا قد ذكرناها في بيان الحب والبغض في الله تعالى من كتاب آداب الصحبة، وفي كتاب الأمر بالمعروف والنهي عن المنكر؛ فلا نعيده.", "english": "And He, the Exalted, said: \"And thus We make some of the wrongdoers (al-ẓālimīn) allies of others.\" And in the report: \"Indeed, Allah, the Exalted, took a covenant from every believer to hate every hypocrite and from every hypocrite to hate every believer.\" And the Prophet, peace be upon him, said: \"A person is with whom he loves.\" And he said: \"Whoever loves a people and allies with them will be gathered with them on the Day of Resurrection.\" And the Prophet, peace be upon him, said: \"The firmest bond of faith (al-īmān) is love for the sake of Allah and hatred for the sake of Allah.\" The evidences for this we have already mentioned in the explanation of love and hatred for the sake of Allah, the Exalted, from the Book of the Etiquettes of Companionship, and in the Book of Commanding Good and Forbidding Evil; so we do not repeat it.", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}, {"arabic": "يا أيها الناس إن الذنوب تغير النعم وتبدل القسم فإذا بر الناس برهم أئمتهم وإذا فجر الناس عقولهم قال الله تعالى: ﴿ وكذلك نولى بعض الظالمين بعضا بما كانوا يكسبون ﴾", "english": "O people, indeed sins change blessings and alter fate. When people are righteous (Birr), their leaders are righteous (Birr), and when people are wicked (Fujur), their intellects (Aql) are corrupted. Allah the Exalted said: 'And thus We make some of the wrongdoers (Zalimin) allies of others for what they used to earn.'", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "general", "topic": "Commentary from Al-Ghazali's Ihya 'Ulum al-Din, from 'Book of Repentance'", "badge": "General"}], "132": [{"arabic": "ولكل درجات مما عملوا فحظ كل واحد من صلاته بقدر خوفه وخشوعه وتعظيمه فإن موضع نظر الله سبحانه القلوب دون ظاهر الحركات ولذلك قال بعض الصحابة رضي الله عنهم يحشر الناس يوم القيامة على مثال هيئتهم في الصلاة من الطمأنينة والهُدُوء ومن وجود النعيم بها واللذة ولقد صدق فإنه يحشر كل على ما مات عليه ويموت على ما عاش عليه ويراعى في ذلك حال قلبه لا حال شخصه فمن صفات القلوب تصاغ الصور في الدار الآخرة ولا ينجو إلا من أتي الله بقلب سليم، نسأل الله حسن التوفيق بلطفه وكرمه.", "english": "And for each are degrees from what they have done, so the share of each one from his prayer is according to his fear (Khawf) and his humility (Khushu') and his reverence (Ta'zim). For the place of Allah's (Subhanahu) gaze is the hearts (Qulub) without the outward movements. And therefore some of the companions (Sahaba) (may Allah be pleased with them) said: 'The people will be resurrected on the Day of Resurrection according to the likeness of their state in prayer from tranquility (Tuma'nina) and calmness (Hudu') and from the presence of bliss (Na'im) in it and pleasure (Ladhdha).' And he has spoken truthfully, for indeed each will be resurrected upon what he died upon and dies upon what he lived upon, and consideration in that is given to the state of his heart (Qalb) not the state of his person. So from the attributes (Sifat) of the hearts (Qulub) are fashioned the forms (Suwar) in the Abode of the Hereafter (Al-Akhira), and none is saved except he who comes to Allah with a sound heart (Qalb Salim). We ask Allah for good success through His gentleness and generosity.", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Prayer'", "badge": "Insight"}], "134": [{"arabic": "ثم قال يا بني آدم إن كنتم تعقلون فعدوا أنفسكم من الموتي والذي نفسي بيده ﴿ إن ما توعدون لآت وما أنتم بمعجزين ﴾", "english": "Then he said: O children of Adam, if you possess intellect, then count yourselves among the dead, and by the One in whose hand is my soul (Nafs), 'Indeed, what you are promised is coming, and you cannot escape it.'", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Repentance'", "badge": "Insight"}], "140": [{"arabic": "وللبخاري من حديث ابن عباس قال إذا سرك أن تعلم جهل العرب فاقرأ ما فوق الثلاثين ومائة في سورة الأنعام قد خسر الذين قتلوا أولادهم سفها بغير علم", "english": "And from Al-Bukhari, from the narration of Ibn Abbas, he said: If you wish to know the ignorance (Jahl) of the Arabs, read what is above one hundred and thirty in Surah Al-An'am: 'Indeed have lost those who killed their children foolishly (Safahan) without knowledge (Ilm)'", "book_file": "vol2_j2-k10.doc.txt", "book_title": "Etiquette of Living and Prophetic Character", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Etiquette of Living and Prophetic Character'", "badge": "Hadith"}], "144": [{"arabic": "وقد سوى الله تعالى بين من افترى على الله كذبا وبين من كذب بالحق فقال تعالى: (ومن أظلم ممن افترى على الله كذبا أو كذب بالحق لما جاءه( (العنكبوت: 68). وقال تعالى: (فمن أظلم ممن كذب على الله وكذب بالصدق إذ جاءه( (الزمر: 32).", "english": "And Allah the Exalted equated between one who fabricates lies against Allah and one who denies the truth, as He said: 'And who is more unjust than one who invents a lie against Allah or denies the truth when it has come to him?' (Al-Ankabut: 68). And He said: 'So who is more unjust than one who lies about Allah and denies the truth when it comes to him?' (Az-Zumar: 32).", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Book of Knowledge'", "badge": "Ethics"}], "148": [{"arabic": "وقالوا أيضا ﴿ لو شاء الله ما أشركنا ولا آباؤنا ﴾ {} فانظر كيف كانوا صادقين في كلامهم وكيف هلكوا بصدقهم فسبحان من إذا شاء أهلك بالصدق وإذا شاء أسعد بالجهل يضل به كثيرا ويهدى به كثيرا فهؤلاء لما ظنوا أنهم استخدموا لأجل المساكين والفقراء أو جل الله تعالى ثم قالوا لا حظ لنا في المساكين ولا حظ لله فينا وفي أموالنا سواء أنفقنا أو أمسكنا هلكوا كما هلك الصبي لما ظن أن مقصود الوالد استخدامه لأجل العبيد ولم يشعر بأنه كان المقصود ثبات صفة العلم في نفسه وتأكده في قلبه حتى يكون ذلك سبب سعادته في الدنيا وإنما", "english": "And they also said: 'If Allah had willed, we would not have associated partners (with Him) nor would our fathers' (Quran 6:148). Look how they were truthful in their speech and how they perished by their truthfulness. Glory be to the One who, when He wills, destroys with truth, and when He wills, makes happy with ignorance; He misleads many by it and guides many by it. These people, when they thought they were employed for the sake of the poor and the needy—may Allah be exalted—then said: 'We have no share in the poor, and Allah has no share in us or in our wealth, whether we spend or withhold,' they perished just as the boy perished when he thought that the father's intention was to employ him for the sake of the slaves, and he did not realize that the intended purpose was the establishment of the attribute of knowledge in his soul (Nafs) and its firmness in his heart (Qalb) so that it would be the cause of his happiness in this world. Indeed, that was from the father as a kindness to him in drawing him to what contains his happiness. This example clarifies for you the misguidance of those who went astray from this path.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "149": [{"arabic": "وكيف يكون ذكر الحجة والمطالبة بها والبحث عنها محظورا وقد قال الله تعالى: ﴿ قل هاتوا برهانكم ﴾ {} وقال عز وجل: ﴿ ليهلك من هلك عن بينة ويحيا من حي عن بينة ﴾ {} وقال تعالى هل عندكم من سلطان بهذا أي حجة وبرهان وقال تعالى: ﴿ قل فلله الحجة البالغة ﴾ {} وقال تعالى ألم تر إلى الذي حاج إبراهيم في ربه إلى قوله فبهت الذي كفر إذ ذكر سبحانه احتجاج إبراهيم ومجادلته وإفحامه خصمه في معرض الثناء عليه وقال عز وجل وتلك حجتنا آتيناها إبراهيم على قومه وقال تعالى قالوا يا نوح قد جادلتنا فأكثرت جدالنا وقال تعالى في قص", "english": "And how can mentioning the proof (Hujjah) and demanding it and researching it be forbidden when Allah the Exalted has said: 'Say: Bring your proof' (Quran 21:24) and He the Mighty and Majestic said: 'That he who perishes might perish by a clear evidence (Bayyinah) and he who lives might live by a clear evidence (Bayyinah)' (Quran 8:42) and He the Exalted said: 'Do you have any authority for this?' meaning proof (Hujjah) and evidence (Burhan). And He the Exalted said: 'Say: Then to Allah belongs the conclusive proof (Al-Hujjah al-Balighah)' (Quran 6:149). And He the Exalted said: 'Have you not considered the one who argued with Abraham about his Lord...' until His saying 'So the one who disbelieved was dumbfounded' when He the Glorified mentioned Abraham's argumentation (Ihtijaj) and his disputation (Mujadalah) and his silencing of his opponent in the context of praising him. And He the Mighty and Majestic said: 'And that was Our argument (Hujjatuna) which We gave Abraham against his people.' And He the Exalted said: 'They said: O Noah, you have disputed with us and been excessive in your dispute with us.' And He the Exalted said in the story of Pharaoh: 'And what is the Lord of the worlds?' until His saying 'If you should bring me a clear thing.' And in summary, the Quran from its beginning to its end is argumentation (Muhajjah) with the disbelievers. So the foundation of the theologians' proofs in Oneness (Tawhid) is His saying: 'If there had been in them [the heavens and earth] gods besides Allah, they both would have been ruined' (Quran 21:22) and in Prophethood: 'And if you are in doubt about what We have sent down upon Our servant, then produce a surah the like thereof' (Quran 2:23) and in the Resurrection: 'Say: He will give them life who produced them the first time' (Quran 36:79) to other than that of the verses and proofs. And the Messengers, prayers of Allah be upon them, have not ceased to argue with the deniers and dispute with them. He the Exalted said: 'And argue with them in a way that is best' (Quran 16:125). So the Companions, may Allah be pleased with them, also used to argue with the deniers and dispute, but when needed, and the need for it was little in their time. And the first to establish calling the innovators to the truth through disputation was Ali ibn Abi Talib, may Allah be pleased with him, when he sent Ibn Abbas, may Allah be pleased with them both, to the Khawarij and he spoke to them. He said: 'What do you find fault with regarding your Imam?' They said: 'He fought and did not take captives and did not...'", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Foundations of Belief'", "badge": "Worship"}], "151": [{"arabic": "ولأجل غيرة الله تعالى حرم الفواحش ما ظهر منها وما بطن ولا أحد أحب إليه العذر من الله ولذلك بعث المنذرين والمبشرين ولا أحد أحب إليه المدح من الله ولأجل ذلك وعد الجنة.", "english": "And because of the jealousy (ghayrah) of Allah the Exalted, He prohibited the abominations (fawahish) what is apparent of them and what is hidden, and no one is more beloved to Him than excuse, and for that He sent the warners and the bearers of good tidings, and no one is more beloved to Him than praise, and for that He promised Paradise.", "book_file": "vol2_j2-k02.doc.txt", "book_title": "Etiquette of Marriage", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Etiquette of Marriage'", "badge": "Afterlife"}], "153": [{"arabic": "قال عبد الله بن مسعود رضي الله عنه خط لنا رسول الله صلى الله عليه وسلم يوما خطا وقال هذا سبيل الله ثم خط خطوطا عن يمين الخط وعن شماله ثم قال هذه سبل على كل سبيل منها شيطان يدعو إليه ثم تلا وأن هذا صراطي مستقيما فاتبعوه ولا تتبعوا السبل لتلك الخطوط[54] فبين صلى الله عليه وسلم كثرة طرقه وقد ذكرنا مثالا للطريق الغامض من طرقه وهو الذي يخدع به العلماء والعباد المالكين لشهواتهم الكافين عن المعاصي الظاهرة فلنذكر مثالا لطريقه الواضح الذي لا يخفى إلا أن يضطر الآدمي إلى سلوكه وذلك كما روى عن النبي صلى الل", "english": "Abdullah ibn Mas'ud (may Allah be pleased with him) said: The Messenger of Allah (peace be upon him) drew a line for us one day and said: 'This is the Path (Sabil) of Allah.' Then he drew lines to the right and left of the line and said: 'These are paths (Subul), on every path of them is a devil (Shaytan) calling to it.' Then he recited: 'And verily this is My Straight Path (Sirati Mustaqiman), so follow it, and do not follow the paths (Subul) for those lines.' [54] So he (peace be upon him) clarified the multitude of its paths. And we have mentioned an example of the obscure path from his paths, which is that which deceives the scholars and the worshippers who are masters of their desires, abstaining from apparent sins. So let us mention an example of his clear path which is not hidden except that the human (Adam) is compelled to traverse it, and that is as narrated from the Prophet (peace be upon him) that he said: There was a monk among the Children of Israel, so the devil (Shaytan) approached a slave girl and strangled her, and cast into the hearts of her family that her cure was with the monk. So they came to him with her, but he refused to accept her, and they persisted with him until he accepted her. When she was with him to treat her, the devil (Shaytan) came to him and beautified for him approaching her, and persisted with him until he had intercourse with her, and she became pregnant from him. Then he whispered to him and said: 'Now you will be exposed, her family will come to you, so kill her. If they ask you, say she died.' So he killed her and buried her. Then the devil (Shaytan) came to her family and whispered to them and cast into their hearts that he had impregnated her, then killed her and buried her. So her family came to him and asked him about her, and he said she died. So they seized him to kill him for her. Then the devil (Shaytan) came to him and said: 'I am the one who strangled her, and I am the one who cast into the hearts of her family. So obey me, you will be saved and I will deliver you from them.' He said: 'With what?' He said: 'Prostrate to me two prostrations.' So he prostrated to him two prostrations. Then the devil (Shaytan) said to him: 'I am free from you.' So he is the one about whom Allah the Exalted said in His likeness: 'Like the devil (Shaytan) when he said to the human (Insan): Disbelieve (Kafir).' When he disbelieved (Kafara), he said...", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}], "161": [{"arabic": "تستجيب لي أخرجه أبو منصور الديلمي في مسند الفردوس من حديث ابن عباس\n    اللهم ابعثنا في أحب الساعات إليك حتى نذكرك فتذكرنا ونسألك فتعطينا وندعوك\n    فتستجيب لنا ونستغفرك فتغفر لنا وإسناده ضعيف وهو معروف من قول حبيب الطائي\n                                          كما رواه ابن أبي الدنيا في الدعاء.\n   [230]  حديث القول إذا استيقظ من منامه الحمد لله الذي أحيانا بعد ما أماتنا\n              وإليه النشور أخرجه البخاري من حديث حذيفة ومسلم من حديث البراء.\n  [231]  حديث أصبحنا وأصبح الملك لله والعظمة وال", "english": "[232] Hadith: We have awakened upon the natural disposition (Fitrah) of Islam and the word of sincerity (Kalimat al-Ikhlas) and the religion of our Prophet Muhammad (peace be upon him) and the way (Millah) of our father Abraham, upright (Hanifan) and not among the polytheists (Mushrikin). Al-Nasa'i transmitted it in 'Al-Yawm wa al-Laylah' from the hadith of 'Abd al-Rahman ibn Abza with a sound chain, and Ahmad transmitted it from the hadith of Ibn Abza from Ubayy ibn Ka'b, raised to the Prophet.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication", "badge": "Hadith"}], "162": [{"arabic": "وقال ليس بالقوي إسناده وروى المستغفري في الدعوات من حديثه يا علي إن أكثر دعاء من قبلي يوم عرفة أن أقول لا إله إلا الله وحده لا شريك له له الملك وله الحمد وهو على كل شيء قدير اللهم اجعل في صدري نورا وفي سمعي نورا وفي قلبي نورا اللهم اشرح لي صدري ويسر لي أمري اللهم إني أعوذ بك من وسواس الصدر وشتات الأمر وفتنة القبر وشر ما يلج في الليل وشر ما يلج في النهار وشر ما تهب به الرياح ومن شر بوائق الدهر وإسناده ضعيف وروى الطبراني في المعجم الصغير من حديث ابن عباس قال كان مما دعا به رسول الله ﭬ عشية عرفة ال", "english": "And he said: Its chain is not strong. And Al-Mustaghfiri narrated in Ad-Da'awat from his hadith: O Ali, indeed the most frequent supplication from me on the Day of Arafah is that I say: There is no god but Allah alone, with no partner to Him, to Him belongs the dominion and to Him belongs the praise, and He is over all things capable. O Allah, place in my chest a light, and in my hearing a light, and in my heart (Qalb) a light. O Allah, expand for me my chest and ease for me my affair. O Allah, I seek refuge in You from the whisperings of the chest, the scattering of the affair, the trial of the grave, the evil of what enters by night, the evil of what enters by day, the evil of what the winds blow, and from the evil of the calamities of time. And its chain is weak. And At-Tabarani narrated in Al-Mu'jam As-Saghir from the hadith of Ibn Abbas, he said: Among what the Messenger of Allah ﷺ supplicated with on the evening of Arafah was: O Allah, indeed You see my place and hear my speech and know my secret and my openness, and nothing of my affair is hidden from You. I am the miserable, the poor. He mentioned the hadith until his saying: O best of those asked and O best of givers. And its chain is weak. And the remainder of the supplication is from the supplication of some of the predecessors, in some of it is what is raised (to the Prophet) but it is not restricted to the standing at Arafah.", "book_file": "vol1_Vol1-book-7.doc.txt", "book_title": "Mysteries of Hajj", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Hajj'", "badge": "Du'a"}, {"arabic": "اللهم رب الحمد لك الحمد كما تقول وخيرا مما نقول لك صلاتي ونسكي ومحياي ومماتي وإليك مآبي وإليك ثوابي اللهم إني أعوذ بك من وساوس الصدر وشتات الأمر وعذاب القبر", "english": "O Allah, Lord of praise, to You is praise as You say and better than what we say: 'My prayer (Salah), my sacrifice (Nusuk), my life (Mahya), and my death (Mamat) are for Allah, Lord of the worlds' (Quran 6:162), and to You is my return and to You is my reward. O Allah, I seek refuge in You from the whisperings of the chest (Sadr) and the scattering of affairs and the punishment of the grave.", "book_file": "vol1_Vol1-book-7.doc.txt", "book_title": "Mysteries of Hajj", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Hajj'", "badge": "Du'a"}], "164": [{"arabic": "فلا تتفكر فيما هو ممكن لغيرك بل فيما هو مخوف في حقك، فإنه لا تزر وازرة وزر أخرى، وعذاب غيرك لا يخفف شيئاً من عذابك، فإذا تفكرت في هذا الخطر كان عندك شغل شاغل عن التكبر وعن أن ترى نفسك فوق غيرك.", "english": "So do not contemplate what is possible for others, but rather what is feared in your own right, for indeed no bearer of burdens (Wazira) bears the burden (Wizr) of another, and the punishment of another does not alleviate anything from your punishment. If you contemplate this danger, you will have an all-engrossing preoccupation from arrogance and from seeing your own soul (Nafs) as above others.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}, {"arabic": "فالحق أن لا تزر وازرة وزر أخرى. ومن ظن أنه ينجو بتقوى أبيه كمن ظن أنه يشبع بأكل أبيه ويروى بشرب أبيه، ويصير عالماً بتعلم أبيه ويصل إلى الكعبة ويراها بمشي أبيه. فالتقوى فرض عين فلا يجزه فيه والد عن ولده شيئاً وكذا العكس، وعند الله جزاء التقوى \"يوم يفر المرء من أخيه وأمه وأبيه\" إلا على سبيل الشفاعة لمن لم يشتد غضب الله عليه فيأذن في الشفاعة له - كما سبق في كتاب الكبر والعجب.", "english": "The truth is that no bearer of burdens shall bear the burden of another. And whoever thinks that he will be saved by the piety (Taqwa) of his father is like one who thinks that he will be satiated by the eating of his father and quenched by the drinking of his father, and becomes knowledgeable by the learning of his father and reaches the Kaaba and sees it by the walking of his father. So piety (Taqwa) is an individual obligation (Fard 'Ayn), so nothing of it suffices for a parent on behalf of his child, and likewise the opposite, and with Allah is the reward of piety (Taqwa) \"On the Day when a man will flee from his brother, his mother, and his father\" except by way of intercession (Shafa'a) for one upon whom the anger of Allah has not intensified, so He permits intercession (Shafa'a) for him - as preceded in the Book of Arrogance and Vanity.", "book_file": "vol3_Vol3-book-10a.doc.txt", "book_title": "Condemnation of Delusion", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Delusion'", "badge": "Ethics"}, {"arabic": "الوجه الثالث أن يبقى بعده ولدا صالحا يدعو له كما ورد في الخبر أن جميع عمل ابن آدم منقطع إلا ثلاثا فذكر الولد الصالح وفي الخبر إن الأدعية تعرض على الموتى على أطباق من نور وقول القائل إن الولد ربما لم يكن صالحا لا يؤثر فإنه مؤمن والصلاح هو الغالب على أولاد ذوي الدين لا سيما إذا عزم على تربيته وحمله على الصلاح وبالجملة دعاء المؤمن لأبويه مفيد برا كان أو فاجرا فهو مثاب على دعواته وحسناته فإنه من كسبه وغير مؤاخذ بسيئاته فإنه لا تزر وازرة وزر أخرى ولذلك قال تعالى ألحقنا بهم ذرياتهم وما ألتناهم من عمله", "english": "The third aspect is that a righteous child remains after him to pray for him, as mentioned in the report that all the deeds of the son of Adam are cut off except three, and the righteous child was mentioned. And in the report, supplications are presented to the dead on plates of light. The statement of the one who says that the child might not be righteous does not affect it, for he is a believer, and righteousness is predominant among the children of people of religion, especially if he resolves to raise him and urge him toward righteousness. In summary, the supplication of a believer for his parents is beneficial, whether they are righteous or wicked, for he is rewarded for his supplications and good deeds, as they are from his earning, and he is not held accountable for their evil deeds, for no bearer of burdens bears the burden of another. Therefore, Allah the Exalted said: 'We have joined their offspring with them, and We have not diminished anything from their deeds.' That is, We have not decreased anything from their deeds, and We have made their children an increase in their good deeds.", "book_file": "vol2_j2-k02.doc.txt", "book_title": "Etiquette of Marriage", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Etiquette of Marriage'", "badge": "Du'a"}, {"arabic": "وأتى عبد الملك بن مروان بأسارى ابن الأشعث فقال لرجاء بن حيوة. ما ترى؟ قال إن الله تعالى قد أعطاك ما تحب من الظفر فأعط الله ما يحب من العفو فعفا عنهم. وروي أن زياداً أخذ رجلاً من الخوارج فأفلت منه فأخذ أخاً له فقال له: إن جئت بأخيك وإلا ضربت عنقك، فقال: أرأيت إن جئتك بكتاب من أمير المؤمنين تخلي سبيلي؟ قال نعم قال فأنا آتيك بكتاب من العزيز الحكيم وأقيم عليه شاهدين إبراهيم وموسى ثم تلا \"أم لم ينبأ بما في صحف موسى وإبراهيم الذي وفى أن لا تزر وازرة وزر أخرى\" فقال زياد خلوا سبيله، هذا رجل قد لقن حجته،", "english": "And Abd al-Malik ibn Marwan was brought captives of Ibn al-Ash'ath, so he said to Raja' ibn Haywah: What do you see? He said: Indeed Allah the Exalted has given you what you love of victory, so give Allah what He loves of forgiveness, so he forgave them. And it was narrated that Ziyad captured a man from the Khawarij (a sect) who escaped from him, so he took his brother and said to him: If you bring me your brother, otherwise I will strike your neck. He said: What do you think if I bring you a letter from the Commander of the Faithful, will you release me? He said: Yes. He said: Then I will bring you a letter from the Mighty, the Wise and establish upon it two witnesses, Ibrahim (Abraham) and Musa (Moses), then he recited: \"Or has he not been informed of what is in the scriptures of Musa and Ibrahim who fulfilled [his obligations]? That no bearer of burdens will bear the burden of another.\" So Ziyad said: Release him, this man has been taught his argument, and it is said written in the Gospel: Whoever seeks forgiveness for one who wronged him has defeated Satan.", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Condemnation of Envy'", "badge": "Hadith"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1316], [2, 1316, 2076], [3, 2076, 3044], [4, 3044, 3731], [5, 3731, 5444], [6, 5444, 6756], [7, 6756, 7735], [8, 7735, 9229], [9, 9229, 10843], [10, 10843, 11582], [11, 11582, 12758], [12, 12758, 14028], [13, 14028, 15204], [14, 15204, 16703]], "2": [[1, 400, 1179], [2, 1179, 2688], [3, 2688, 4408], [4, 4408, 5527], [5, 5527, 6760], [6, 6760, 7912], [7, 7912, 9988], [8, 9988, 11545], [9, 11545, 13070], [10, 13070, 15503], [11, 15503, 16833], [12, 16833, 17985], [13, 17985, 19348], [14, 19348, 21457]], "3": [[1, 400, 1106], [2, 1106, 1821], [3, 1821, 2274], [4, 2274, 3763], [5, 3763, 4487], [6, 4487, 5356], [7, 5356, 6207], [8, 6207, 7085], [9, 7085, 8244], [10, 8244, 9367], [11, 9367, 9838], [12, 9838, 11034]], "4": [[1, 400, 1252], [2, 1252, 2624], [3, 2624, 3341], [4, 3341, 4318], [5, 4318, 5035], [6, 5035, 6240], [7, 6240, 7206], [8, 7206, 8152], [9, 8152, 9544], [10, 9544, 10521], [11, 10521, 11975]], "5": [[1, 400, 1197], [2, 1197, 2820], [3, 2820, 4091], [4, 4091, 5258], [5, 5258, 7074], [6, 7074, 8137], [7, 