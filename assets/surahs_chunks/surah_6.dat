 [{"id": 1, "arabic": "وَأَنذِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَخَافُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُّحْشَرُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَيْسَ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 12, "arabic": "دُونِهِۦ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَلِيࣱّ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 15, "arabic": "شَفِيعࣱ", "translit": "", "root": ""}, {"id": 16, "arabic": "لَّعَلَّهُمْ", "translit": "", "root": ""}, {"id": 17, "arabic": "يَتَّقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 52, "text": "وَلَا تَطْرُدِ اِ۬لذِينَ يَدْعُونَ رَبَّهُم بِالْغَدَوٰةِ وَالْعَشِيِّ يُرِيدُونَ وَجْهَهُۥ مَا عَلَيْكَ مِنْ حِسَابِهِم مِّن شَےْءࣲ وَمَا مِنْ حِسَابِكَ عَلَيْهِم مِّن شَےْءࣲ فَتَطْرُدَهُمْ فَتَكُونَ مِنَ اَ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَطْرُدِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَدْعُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبَّهُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالْغَدَوٰةِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالْعَشِيِّ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُرِيدُونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَجْهَهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 12, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 13, "arabic": "حِسَابِهِم", "translit": "", "root": ""}, {"id": 14, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 15, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 17, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 18, "arabic": "حِسَابِكَ", "translit": "", "root": ""}, {"id": 19, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 20, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 21, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 22, "arabic": "فَتَطْرُدَهُمْ", "translit": "", "root": ""}, {"id": 23, "arabic": "فَتَكُونَ", "translit": "", "root": ""}, {"id": 24, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 25, "arabic": "اَ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 53, "text": "وَكَذَٰلِكَ فَتَنَّا بَعْضَهُم بِبَعْضࣲ لِّيَقُولُوٓاْ أَهَٰٓؤُلَآءِ مَنَّ اَ۬للَّهُ عَلَيْهِم مِّنۢ بَيْنِنَآۖ أَلَيْسَ اَ۬للَّهُ بِأَعْلَمَ بِالشَّٰكِرِينَۖ", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَتَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "بَعْضَهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِبَعْضࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِّيَقُولُوٓاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَهَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّنۢ", "translit": "", "root": ""}, {"id": 11, "arabic": "بَيْنِنَآۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَلَيْسَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 14, "arabic": "بِأَعْلَمَ", "translit": "", "root": ""}, {"id": 15, "arabic": "بِالشَّٰكِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 54, "text": "وَإِذَا جَآءَكَ اَ۬لذِينَ يُومِنُونَ بِـَٔايَٰتِنَا فَقُلْ سَلَٰمٌ عَلَيْكُمْۖ كَتَبَ رَبُّكُمْ عَلَيٰ نَفْسِهِ اِ۬لرَّحْمَةَ أَنَّهُۥ مَنْ عَمِلَ مِنكُمْ سُوٓءاَۢ بِجَهَٰلَةࣲ ثُمَّ تَابَ مِنۢ بَعْدِهِۦ وَأَصْلَحَ فَإِنَّهُۥ غَفُورࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُومِنُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِـَٔايَٰتِنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فَقُلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "سَلَٰمٌ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَلَيْكُمْۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَتَبَ", "translit": "", "root": ""}, {"id": 10, "arabic": "رَبُّكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 12, "arabic": "نَفْسِهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لرَّحْمَةَ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَنَّهُۥ", "translit": "", "root": ""}, {"id": 15, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَمِلَ", "translit": "", "root": ""}, {"id": 17, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 18, "arabic": "سُوٓءاَۢ", "translit": "", "root": ""}, {"id": 19, "arabic": "بِجَهَٰلَةࣲ", "translit": "", "root": ""}, {"id": 20, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 21, "arabic": "تَابَ", "translit": "", "root": ""}, {"id": 22, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 23, "arabic": "بَعْدِهِۦ", "translit": "", "root": ""}, {"id": 24, "arabic": "وَأَصْلَحَ", "translit": "", "root": ""}, {"id": 25, "arabic": "فَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 26, "arabic": "غَفُورࣱ", "translit": "", "root": ""}, {"id": 27, "arabic": "رَّحِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 55, "text": "وَكَذَٰلِكَ نُفَصِّلُ اُ۬لَايَٰتِ وَلِتَسْتَبِينَ سَبِيلَ اَ۬لْمُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نُفَصِّلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لَايَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلِتَسْتَبِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَبِيلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 6, "ayah": 56, "text": "قُلِ اِنِّے نُهِيتُ أَنَ اَعْبُدَ اَ۬لذِينَ تَدْعُونَ مِن دُونِ اِ۬للَّهِۖ قُل لَّآ أَتَّبِعُ أَهْوَآءَكُمْۖ قَد ضَّلَلْتُ إِذاࣰ وَمَآ أَنَا مِنَ اَ۬لْمُهْتَدِينَۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "نُهِيتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَعْبُدَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَدْعُونَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "", "root": ""}, {"id": 9, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "قُل", "translit": "", "root": ""}, {"id": 12, "arabic": "لَّآ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَتَّبِعُ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَهْوَآءَكُمْۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "قَد", "translit": "", "root": ""}, {"id": 16, "arabic": "ضَّلَلْتُ", "translit": "", "root": ""}, {"id": 17, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 19, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 20, "arabic": "مِنَ",