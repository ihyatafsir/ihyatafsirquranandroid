it": "", "root": ""}, {"id": 11, "arabic": "يُخَوِّفُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 14, "arabic": "عِبَادَهُۥۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَٰعِبَادِ", "translit": "", "root": ""}, {"id": 16, "arabic": "فَاتَّقُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 39, "ayah": 17, "text": "وَالذِينَ اَ۪جْتَنَبُواْ اُ۬لطَّٰغُوتَ أَنْ يَّعْبُدُوهَا وَأَنَابُوٓاْ إِلَي اَ۬للَّهِ لَهُمُ اُ۬لْبُشْر۪يٰۖ فَبَشِّرْ عِبَادِ", "words": [{"id": 1, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪جْتَنَبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لطَّٰغُوتَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَّعْبُدُوهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَنَابُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَهُمُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْبُشْر۪يٰۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَبَشِّرْ", "translit": "", "root": ""}, {"id": 12, "arabic": "عِبَادِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 39, "ayah": 18, "text": "اِ۬لذِينَ يَسْتَمِعُونَ اَ۬لْقَوْلَ فَيَتَّبِعُونَ أَحْسَنَهُۥٓۖ أُوْلَٰٓئِكَ اَ۬لذِينَ هَد۪يٰهُمُ اُ۬للَّهُۖ وَأُوْلَٰٓئِكَ هُمُۥٓ أُوْلُواْ اُ۬لَالْبَٰبِۖ", "words": [{"id": 1, "arabic": "اِ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسْتَمِعُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْقَوْلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَيَتَّبِعُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَحْسَنَهُۥٓۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 7, "