ي", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وُجُوهُهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّسْوَدَّةٌۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَلَيْسَ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِے", "translit": "", "root": ""}, {"id": 12, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَثْويࣰ", "translit": "", "root": ""}, {"id": 14, "arabic": "لِّلْمُتَكَبِّرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 39, "ayah": 61, "text": "وَيُنَجِّے اِ۬للَّهُ اُ۬لذِينَ اَ۪تَّقَوْاْ بِمَفَازَتِهِمْ لَا يَمَسُّهُمُ اُ۬لسُّوٓءُ وَلَا هُمْ يَحْزَنُونَۖ", "words": [{"id": 1, "arabic": "وَيُنَجِّے", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۪تَّقَوْاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِمَفَازَتِهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَمَسُّهُمُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لسُّوٓءُ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَحْزَنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 39, "ayah": 62, "text": "اَ۬للَّهُ خَٰلِقُ كُلِّ شَےْءࣲۖ وَهُوَ عَلَيٰ كُلِّ شَےْءࣲ وَكِيلࣱۖ", "words": [{"id": 1, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَٰلِقُ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "شَےْءࣲۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 8, "arabic": "شَےْءࣲ", "tran