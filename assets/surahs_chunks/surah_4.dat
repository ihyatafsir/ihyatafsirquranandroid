مُ اُ۬لرُّبُعُ مِمَّا تَرَكْنَ مِنۢ بَعْدِ وَصِيَّةࣲ يُوصِينَ بِهَآ أَوْ دَيْنࣲۖ وَلَهُنَّ اَ۬لرُّبُعُ مِمَّا تَرَكْتُمُۥٓ إِن لَّمْ يَكُن لَّكُمْ وَلَدࣱۖ فَإِن كَانَ لَكُمْ وَلَدࣱ فَلَهُنَّ اَ۬لثُّمُنُ مِمَّا تَرَكْتُم مِّنۢ بَعْدِ وَصِيَّةࣲ تُوصُونَ بِهَآ أَوْ دَيْنࣲۖ وَإِن كَانَ رَجُلࣱ يُورَثُ كَلَٰلَةً اَوِ اِ۪مْرَأَةࣱ وَلَهُۥٓ أَخٌ اَوُ ا۟خْتࣱ فَلِكُلِّ وَٰحِدࣲ مِّنْهُمَا اَ۬لسُّدُسُۖ فَإِن كَانُوٓاْ أَكْثَرَ مِن ذَٰلِكَ فَهُمْ شُرَكَآءُ فِے اِ۬لثُّلُثِ مِنۢ بَعْدِ وَصِيَّةࣲ يُوصِے بِهَآ أَوْ دَيْنٍ غَيْرَ مُضَآرࣲّۖ وَصِيَّةࣰ مِّنَ اَ۬للَّهِۖ وَاللَّهُ عَلِيمٌ حَلِيمࣱۖ", "words": [{"id": 1, "arabic": "وَلَكُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نِصْفُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَرَكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَزْوَٰجُكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِن", "translit": "", "root": ""}, {"id": 7, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَكُن", "translit": "", "root": ""}, {"id": 9, "arabic": "لَّهُنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَدࣱۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَإِن", "translit": "", "root": ""}, {"id": 12, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَهُنَّ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَلَدࣱ", "translit": "", "root": ""}, {"id": 15, "arabic": "فَلَكُمُ", "translit": "", "root": ""}, {"id": 16, "arabic": "اُ۬لرُّبُعُ", "translit": "", "root": ""}, {"id": 17, "arabic": "مِمَّا", "translit": "", "root": ""}, {"id": 18, "arabic": "تَرَكْنَ", "translit": "", "root": ""}, {"id": 19, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 20, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَصِيَّةࣲ", "translit": "", "root": ""}, {"id": 22, "arabic": "يُوصِينَ", "translit": "", "root": ""}, {"id": 23, "arabic": "بِهَآ", "translit": "", "root": ""}, {