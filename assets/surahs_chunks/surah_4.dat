","root":""},{"id":33,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":34,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":35,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":36,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":37,"arabic":"خَبِيرًا","translit":"āًryِbَhk","root":"خبر"}],"hasIhya":true},{"ayah":136,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ ءَامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَٱلْكِتَٰبِ ٱلَّذِى نَزَّلَ عَلَىٰ رَسُولِهِۦ وَٱلْكِتَٰبِ ٱلَّذِىٓ أَنزَلَ مِن قَبْلُۚ وَمَن يَكْفُرْ بِٱللَّهِ وَمَلَٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ وَٱلْيَوْمِ ٱلْءَاخِرِ فَقَدْ ضَلَّ ضَلَٰلًۢا بَعِيدًا ","translation":"O you who have believed, believe[1] in Allāh and His Messenger and the Book that He sent down upon His Messenger and the Scripture which He sent down before. And whoever disbelieves in Allāh, His angels, His books, His messengers, and the Last Day has certainly gone far astray.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":4,"arabic":"ءَامِنُوا۟","translit":"۟āwُnِmāَء","root":"امن"},{"id":5,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":6,"arabic":"وَرَسُولِهِۦ","translit":"ۦِhِlwُsَrَw","root":"رسل"},{"id":7,"arabic":"وَٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱَw","root":"كتب"},{"id":8,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":9,"arabic":"نَزَّلَ","translit":"َlَّzَn","root":"نزل"},{"id":10,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":11,"arabic":"رَسُولِهِۦ","translit":"ۦِhِlwُsَr","root":"رسل"},{"id":12,"arabic":"وَٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱَw","root":"كتب"},{"id":13,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":14,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":15,"arabic":"مِن","translit":"nِm","root":""},{"id":16,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},