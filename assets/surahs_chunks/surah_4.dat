َّضَٰعَةِۖ وَأُمَّهَٰتُ نِسَآئِكُمْ وَرَبَٰٓئِبُكُمُ اُ۬لتِے فِے حُجُورِكُم مِّن نِّسَآئِكُمُ اُ۬لتِے دَخَلْتُم بِهِنَّۖ فَإِن لَّمْ تَكُونُواْ دَخَلْتُم بِهِنَّ فَلَا جُنَاحَ عَلَيْكُمْۖ وَحَلَٰٓئِلُ أَبْنَآئِكُمُ اُ۬لذِينَ مِنَ اَصْلَٰبِكُمْۖ وَأَن تَجْمَعُواْ بَيْنَ اَ۬لُاخْتَيْنِ إِلَّا مَا قَدْ سَلَفَۖ إِنَّ اَ۬للَّهَ كَانَ غَفُوراࣰ رَّحِيماࣰۖ", "words": [{"id": 1, "arabic": "حُرِّمَتْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْكُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُمَّهَٰتُكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَبَنَاتُكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَخَوَٰتُكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَعَمَّٰتُكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَخَٰلَٰتُكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَبَنَاتُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لَاخِ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَبَنَاتُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لُاخْتِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَأُمَّهَٰتُكُمُ", "translit": "", "root": ""}, {"id": 13, "arabic": "اُ۬لتِےٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَرْضَعْنَكُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَأَخَوَٰتُكُم", "translit": "", "root": ""}, {"id": 16, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬لرَّضَٰعَةِۖ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَأُمَّهَٰتُ", "translit": "", "root": ""}, {"id": 19, "arabic": "نِسَآئِكُمْ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَرَبَٰٓئِبُكُمُ", "translit": "", "root": ""}, {"id": 21, "arabic": "اُ۬لتِے", "translit": "", "root": ""}, {"id": 22, "arabic": "فِے", "translit": "", "root": ""}, {"id": 23, "arabic": "حُجُورِكُم", "translit": "", "root": ""}, {"id": 24, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 25, "arabic": "نِّسَآئِكُمُ", "translit": "", "root": "