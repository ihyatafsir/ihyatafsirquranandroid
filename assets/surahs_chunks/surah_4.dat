sَy","root":"شري"},{"id":10,"arabic":"ٱلضَّلَٰلَةَ","translit":"َẗَlَٰlَّḍlٱ","root":"ضلل"},{"id":11,"arabic":"وَيُرِيدُونَ","translit":"َnwُdyِrُyَw","root":"رود"},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"تَضِلُّوا۟","translit":"۟āwُّlِḍَt","root":"ضلل"},{"id":14,"arabic":"ٱلسَّبِيلَ","translit":"َlyِbَّslٱ","root":"سبل"}],"hasIhya":false},{"ayah":45,"text":"وَٱللَّهُ أَعْلَمُ بِأَعْدَآئِكُمْۚ وَكَفَىٰ بِٱللَّهِ وَلِيًّا وَكَفَىٰ بِٱللَّهِ نَصِيرًا ","translation":"And Allāh is most knowing of your enemies; and sufficient is Allāh as an ally, and sufficient is Allāh as a helper.","words":[{"id":1,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":2,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":3,"arabic":"بِأَعْدَآئِكُمْ","translit":"ْmُkِyʾٓāَdْʿعَaʾِb","root":"عدو"},{"id":4,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":5,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":6,"arabic":"وَلِيًّا","translit":"āًّyِlَw","root":"ولي"},{"id":7,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":8,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":9,"arabic":"نَصِيرًا","translit":"āًryِṣَn","root":"نصر"}],"hasIhya":true},{"ayah":46,"text":"مِّنَ ٱلَّذِينَ هَادُوا۟ يُحَرِّفُونَ ٱلْكَلِمَ عَن مَّوَاضِعِهِۦ وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَٱسْمَعْ غَيْرَ مُسْمَعٍ وَرَٰعِنَا لَيًّۢا بِأَلْسِنَتِهِمْ وَطَعْنًا فِى ٱلدِّينِۚ وَلَوْ أَنَّهُمْ قَالُوا۟ سَمِعْنَا وَأَطَعْنَا وَٱسْمَعْ وَٱنظُرْنَا لَكَانَ خَيْرًا لَّهُمْ وَأَقْوَمَ وَلَٰكِن لَّعَنَهُمُ ٱللَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا ","translation":"Among the Jews are those who distort words from their [proper] places [i.e., usages] and say, \"We hear and disobey\" and \"Hear but be not heard\" and \"Rāʿinā,\"[1] twisting their tongues and defaming the religion. And if they had said [instead], \"We hear and obey\" and \"Wait for us [to understand],\" it would have been better for them and more suitable. But Allāh has cursed them for their disbelief, so they believe not, except for a few.[2]","words":[{"id":1,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"هَادُوا۟","translit":"۟āwُdāَh","root":"هود"},{"id":4,"arabic":"يُحَرِّفُونَ","translit":"َnwُfِّrَḥُy","root":"حرف"},{"id":5,"arabic":"ٱلْكَلِمَ","translit":"َmِlَkْlٱ","root":"كلم"},{"id":6,"arabic":"عَن","translit":"nَʿع","root":""},{"id":7,"arabic":"مَّوَاضِعِهِۦ","translit":"ۦِhِʿعِḍāَwَّm","root":"وضع"},{"id":8,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":9,"arabic":"سَمِعْنَا","translit":"āَnْʿعِmَs","root":"سمع"},{"id":10,"arabic":"وَعَصَيْنَا","translit":"āَnْyَṣَʿعَw","root":"عصي"},{"id":11,"arabic":"وَٱسْمَعْ","translit":"ْʿعَmْsٱَw","root":"سمع"},{"id":12,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":13,"arabic":"مُسْمَعٍ","translit":"ٍʿعَmْsُm","root":"سمع"},{"id":14,"arabic":"وَرَٰعِنَا","translit":"āَnِʿعَٰrَw","root":"رعي"},{"id":15,"arabic":"لَيًّۢا","translit":"āًّۢyَl","root":"لوي"},{"id":16,"arabic":"بِأَلْسِنَتِهِمْ","translit":"ْmِhِtَnِsْlَaʾِb","root":"لسن"},{"id":17,"arabic":"وَطَعْنًا","translit":"āًnْʿعَṭَw","root":"طعن"},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ٱلدِّينِ","translit":"ِnyِّdlٱ","root":"دين"},{"id":20,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":21,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":22,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":23,"arabic":"سَمِعْنَا","translit":"āَnْʿعِmَs","root":"سمع"},{"id":24,"arabic":"وَأَطَعْنَا","translit":"āَnْʿعَṭَaʾَw","root":"طوع"},{"id":25,"arabic":"وَٱسْمَعْ","translit":"ْʿعَmْsٱَw","root":"سمع"},{"id":26,"arabic":"وَٱنظُرْنَا","translit":"āَnْrُẓnٱَw","root":"نظر"},{"id":27,"arabic":"لَكَانَ","translit":"َnāَkَl","root":"كون"},{"id":28,"arabic":"خَيْرًا","translit":"āًrْyَhk","root":"خير"},{"id":29,"arabic":"لَّهُمْ","translit":"ْmُhَّl","root":""},{"id":30,"arabic":"وَأَقْوَمَ","translit":"َmَwْqَaʾَw","root":"قوم"},{"id":31,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":32,"arabic":"لَّعَنَهُمُ","translit":"ُmُhَnَʿعَّl","root":"لعن"},{"id":33,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":34,"arabic":"بِكُفْرِهِمْ","translit":"ْmِhِrْfُkِb","root":"كفر"},{"id":35,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":36,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":37,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":38,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"}],"hasIhya":false},{"ayah":47,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ ءَامِنُوا۟ بِمَا نَزَّلْنَا مُصَدِّقًا لِّمَا مَعَكُم مِّن قَبْلِ أَن نَّطْمِسَ وُجُوهًا فَنَرُدَّهَا عَلَىٰٓ أَدْبَارِهَآ أَوْ نَلْعَنَهُمْ كَمَا لَعَنَّآ أَصْحَٰبَ ٱلسَّبْتِۚ وَكَانَ أَمْرُ ٱللَّهِ مَفْعُولًا ","translation":"O you who were given the Scripture, believe in what We have sent down [to Prophet Muḥammad (ﷺ)], confirming that which is with you, before We obliterate faces and turn them toward their backs or curse them as We cursed the sabbath-breakers.[1] And ever is the matter [i.e., decree] of Allāh accomplished.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"أُوتُوا۟","translit":"۟āwُtwُaʾ","root":"اتي"},{"id":4,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"ءَامِنُوا۟","translit":"۟āwُnِmāَء","root":"امن"},{"id":6,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":7,"arabic":"نَزَّلْنَا","translit":"āَnْlَّzَn","root":"نزل"},{"id":8,"arabic":"مُصَدِّقًا","translit":"āًqِّdَṣُm","root":"صدق"},{"id":9,"arabic":"لِّمَا","translit":"āَmِّl","root":""},{"id":10,"arabic":"مَعَكُم","translit":"mُkَʿعَm","root":""},{"id":11,"arabic":"مِّن","translit":"nِّm","root":""},{"id":12,"arabic":"قَبْلِ","translit":"ِlْbَq","root":"قبل"},{"id":13,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":14,"arabic":"نَّطْمِسَ","translit":"َsِmْṭَّn","root":"طمس"},{"id":15,"arabic":"وُجُوهًا","translit":"āًhwُjgُw","root":"وجه"},{"id":16,"arabic":"فَنَرُدَّهَا","translit":"āَhَّdُrَnَf","root":"ردد"},{"id":17,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":18,"arabic":"أَدْبَارِهَآ","translit":"ٓāَhِrāَbْdَaʾ","root":"دبر"},{"id":19,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":20,"arabic":"نَلْعَنَهُمْ","translit":"ْmُhَnَʿعْlَn","root":"لعن"},{"id":21,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":22,"arabic":"لَعَنَّآ","translit":"ٓāَّnَʿعَl","root":"لعن"},{"id":23,"arabic":"أَصْحَٰبَ","translit":"َbَٰḥْṣَaʾ","root":"صحب"},{"id":24,"arabic":"ٱلسَّبْتِ","translit":"ِtْbَّslٱ","root":"سبت"},{"id":25,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":26,"arabic":"أَمْرُ","translit":"ُrْmَaʾ","root":"امر"},{"id":27,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":28,"arabic":"مَفْعُولًا","translit":"āًlwُʿعْfَm","root":"فعل"}],"hasIhya":false},{"ayah":48,"text":"إِنَّ ٱللَّهَ لَا يَغْفِرُ أَن يُشْرَكَ بِهِۦ وَيَغْفِرُ مَا دُونَ ذَٰلِكَ لِمَن يَشَآءُۚ وَمَن يُشْرِكْ بِٱللَّهِ فَقَدِ ٱفْتَرَىٰٓ إِثْمًا عَظِيمًا ","translation":"Indeed, Allāh does not forgive association with Him, but He forgives what is less than that for whom He wills. And he who associates others with Allāh has certainly fabricated a tremendous sin.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يَغْفِرُ","translit":"ُrِfْغَy","root":"غفر"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"يُشْرَكَ","translit":"َkَrْhsُy","root":"شرك"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"وَيَغْفِرُ","translit":"ُrِfْغَyَw","root":"غفر"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"دُونَ","translit":"َnwُd","root":"دون"},{"id":11,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":12,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":13,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":14,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":15,"arabic":"يُشْرِكْ","translit":"ْkِrْhsُy","root":"شرك"},{"id":16,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":17,"arabic":"فَقَدِ","translit":"ِdَqَf","root":""},{"id":18,"arabic":"ٱفْتَرَىٰٓ","translit":"ٰٓàَrَtْfٱ","root":"فري"},{"id":19,"arabic":"إِثْمًا","translit":"āًmْhtِiʾ","root":"اثم"},{"id":20,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":49,"text":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ يُزَكُّونَ أَنفُسَهُمۚ بَلِ ٱللَّهُ يُزَكِّى مَن يَشَآءُ وَلَا يُظْلَمُونَ فَتِيلًا ","translation":"Have you not seen those who claim themselves to be pure? Rather, Allāh purifies whom He wills, and injustice is not done to them, [even] as much as a thread [inside a date seed].","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"يُزَكُّونَ","translit":"َnwُّkَzُy","root":"زكو"},{"id":6,"arabic":"أَنفُسَهُم","translit":"mُhَsُfnَaʾ","root":"نفس"},{"id":7,"arabic":"بَلِ","translit":"ِlَb","root":""},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"يُزَكِّى","translit":"àِّkَzُy","root":"زكو"},{"id":10,"arabic":"مَن","translit":"nَm","root":""},{"id":11,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":12,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":13,"arabic":"يُظْلَمُونَ","translit":"َnwُmَlْẓُy","root":"ظلم"},{"id":14,"arabic":"فَتِيلًا","translit":"āًlyِtَf","root":"فتل"}],"hasIhya":true},{"ayah":50,"text":"ٱنظُرْ كَيْفَ يَفْتَرُونَ عَلَى ٱللَّهِ ٱلْكَذِبَۖ وَكَفَىٰ بِهِۦٓ إِثْمًا مُّبِينًا ","translation":"Look how they invent about Allāh untruth, and sufficient is that as a manifest sin.","words":[{"id":1,"arabic":"ٱنظُرْ","translit":"ْrُẓnٱ","root":"نظر"},{"id":2,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":3,"arabic":"يَفْتَرُونَ","translit":"َnwُrَtْfَy","root":"فري"},{"id":4,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"ٱلْكَذِبَ","translit":"َbِhdَkْlٱ","root":"كذب"},{"id":7,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":8,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":9,"arabic":"إِثْمًا","translit":"āًmْhtِiʾ","root":"اثم"},{"id":10,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":true},{"ayah":51,"text":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ أُوتُوا۟ نَصِيبًا مِّنَ ٱلْكِتَٰبِ يُؤْمِنُونَ بِٱلْجِبْتِ وَٱلطَّٰغُوتِ وَيَقُولُونَ لِلَّذِينَ كَفَرُوا۟ هَٰٓؤُلَآءِ أَهْدَىٰ مِنَ ٱلَّذِينَ ءَامَنُوا۟ سَبِيلًا ","translation":"Have you not seen those who were given a portion of the Scripture, who believe in jibt [superstition] and ṭāghūt [false objects of worship] and say about the disbelievers, \"These are better guided than the believers as to the way\"?","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"أُوتُوا۟","translit":"۟āwُtwُaʾ","root":"اتي"},{"id":6,"arabic":"نَصِيبًا","translit":"āًbyِṣَn","root":"نصب"},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":9,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":10,"arabic":"بِٱلْجِبْتِ","translit":"ِtْbِjgْlٱِb","root":"جبت"},{"id":11,"arabic":"وَٱلطَّٰغُوتِ","translit":"ِtwُغَّٰṭlٱَw","root":"طغي"},{"id":12,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":13,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":14,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":15,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":16,"arabic":"أَهْدَىٰ","translit":"ٰàَdْhَaʾ","root":"هدي"},{"id":17,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":18,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":19,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":20,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":52,"text":"أُو۟لَٰٓئِكَ ٱلَّذِينَ لَعَنَهُمُ ٱللَّهُۖ وَمَن يَلْعَنِ ٱللَّهُ فَلَن تَجِدَ لَهُۥ نَصِيرًا ","translation":"Those are the ones whom Allāh has cursed; and he whom Allāh curses - never will you find for him a helper.","words":[{"id":1,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"لَعَنَهُمُ","translit":"ُmُhَnَʿعَl","root":"لعن"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":6,"arabic":"يَلْعَنِ","translit":"ِnَʿعْlَy","root":"لعن"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"فَلَن","translit":"nَlَf","root":""},{"id":9,"arabic":"تَجِدَ","translit":"َdِjgَt","root":"وجد"},{"id":10,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":11,"arabic":"نَصِيرًا","translit":"āًryِṣَn","root":"نصر"}],"hasIhya":false},{"ayah":53,"text":"أَمْ لَهُمْ نَصِيبٌ مِّنَ ٱلْمُلْكِ فَإِذًا لَّا يُؤْتُونَ ٱلنَّاسَ نَقِيرًا ","translation":"Or have they a share of dominion? Then [if that were so], they would not give the people [even as much as] the speck on a date seed.","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":3,"arabic":"نَصِيبٌ","translit":"ٌbyِṣَn","root":"نصب"},{"id":4,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":5,"arabic":"ٱلْمُلْكِ","translit":"ِkْlُmْlٱ","root":"ملك"},{"id":6,"arabic":"فَإِذًا","translit":"āًhdِiʾَf","root":""},{"id":7,"arabic":"لَّا","translit":"āَّl","root":""},{"id":8,"arabic":"يُؤْتُونَ","translit":"َnwُtْwʾُy","root":"اتي"},{"id":9,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":10,"arabic":"نَقِيرًا","translit":"āًryِqَn","root":"نقر"}],"hasIhya":false},{"ayah":54,"text":"أَمْ يَحْسُدُونَ ٱلنَّاسَ عَلَىٰ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦۖ فَقَدْ ءَاتَيْنَآ ءَالَ إِبْرَٰهِيمَ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ وَءَاتَيْنَٰهُم مُّلْكًا عَظِيمًا ","translation":"Or do they envy people for what Allāh has given them of His bounty? But We had already given the family of Abraham the Scripture and wisdom[1] and conferred upon them a great kingdom.","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"يَحْسُدُونَ","translit":"َnwُdُsْḥَy","root":"حسد"},{"id":3,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":4,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":5,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":6,"arabic":"ءَاتَىٰهُمُ","translit":"ُmُhٰàَtāَء","root":"اتي"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"فَضْلِهِۦ","translit":"ۦِhِlْḍَf","root":"فضل"},{"id":10,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":11,"arabic":"ءَاتَيْنَآ","translit":"ٓāَnْyَtāَء","root":"اتي"},{"id":12,"arabic":"ءَالَ","translit":"َlāَء","root":"اول"},{"id":13,"arabic":"إِبْرَٰهِيمَ","translit":"َmyِhَٰrْbِiʾ","root":""},{"id":14,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":15,"arabic":"وَٱلْحِكْمَةَ","translit":"َẗَmْkِḥْlٱَw","root":"حكم"},{"id":16,"arabic":"وَءَاتَيْنَٰهُم","translit":"mُhَٰnْyَtāَءَw","root":"اتي"},{"id":17,"arabic":"مُّلْكًا","translit":"āًkْlُّm","root":"ملك"},{"id":18,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":55,"text":"فَمِنْهُم مَّنْ ءَامَنَ بِهِۦ وَمِنْهُم مَّن صَدَّ عَنْهُۚ وَكَفَىٰ بِجَهَنَّمَ سَعِيرًا ","translation":"And some among them believed in it,[1] and some among them were averse to it. And sufficient is Hell as a blaze.","words":[{"id":1,"arabic":"فَمِنْهُم","translit":"mُhْnِmَf","root":""},{"id":2,"arabic":"مَّنْ","translit":"ْnَّm","root":""},{"id":3,"arabic":"ءَامَنَ","translit":"َnَmāَء","root":"امن"},{"id":4,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":5,"arabic":"وَمِنْهُم","translit":"mُhْnِmَw","root":""},{"id":6,"arabic":"مَّن","translit":"nَّm","root":""},{"id":7,"arabic":"صَدَّ","translit":"َّdَṣ","root":"صدد"},{"id":8,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":9,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":10,"arabic":"بِجَهَنَّمَ","translit":"َmَّnَhَjgِb","root":""},{"id":11,"arabic":"سَعِيرًا","translit":"āًryِʿعَs","root":"سعر"}],"hasIhya":false},{"ayah":56,"text":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا سَوْفَ نُصْلِيهِمْ نَارًا كُلَّمَا نَضِجَتْ جُلُودُهُم بَدَّلْنَٰهُمْ جُلُودًا غَيْرَهَا لِيَذُوقُوا۟ ٱلْعَذَابَۗ إِنَّ ٱللَّهَ كَانَ عَزِيزًا حَكِيمًا ","translation":"Indeed, those who disbelieve in Our verses - We will drive them into a fire. Every time their skins are roasted through, We will replace them with other skins so they may taste the punishment. Indeed, Allāh is ever Exalted in Might and Wise.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":5,"arabic":"سَوْفَ","translit":"َfْwَs","root":""},{"id":6,"arabic":"نُصْلِيهِمْ","translit":"ْmِhyِlْṣُn","root":"صلي"},{"id":7,"arabic":"نَارًا","translit":"āًrāَn","root":"نور"},{"id":8,"arabic":"كُلَّمَا","translit":"āَmَّlُk","root":"كلل"},{"id":9,"arabic":"نَضِجَتْ","translit":"ْtَjgِḍَn","root":"نضج"},{"id":10,"arabic":"جُلُودُهُم","translit":"mُhُdwُlُjg","root":"جلد"},{"id":11,"arabic":"بَدَّلْنَٰهُمْ","translit":"ْmُhَٰnْlَّdَb","root":"بدل"},{"id":12,"arabic":"جُلُودًا","translit":"āًdwُlُjg","root":"جلد"},{"id":13,"arabic":"غَيْرَهَا","translit":"āَhَrْyَغ","root":"غير"},{"id":14,"arabic":"لِيَذُوقُوا۟","translit":"۟āwُqwُhdَyِl","root":"ذوق"},{"id":15,"arabic":"ٱلْعَذَابَ","translit":"َbāَhdَʿعْlٱ","root":"عذب"},{"id":16,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":17,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":18,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":19,"arabic":"عَزِيزًا","translit":"āًzyِzَʿع","root":"عزز"},{"id":20,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":true},{"ayah":57,"text":"وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَنُدْخِلُهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًاۖ لَّهُمْ فِيهَآ أَزْوَٰجٌ مُّطَهَّرَةٌۖ وَنُدْخِلُهُمْ ظِلًّا ظَلِيلًا ","translation":"But those who believe and do righteous deeds - We will admit them to gardens beneath which rivers flow, wherein they abide forever. For them therein are purified spouses, and We will admit them to deepening shade.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":3,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":4,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":5,"arabic":"سَنُدْخِلُهُمْ","translit":"ْmُhُlِhkْdُnَs","root":"دخل"},{"id":6,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":7,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":10,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":11,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":12,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":13,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":14,"arabic":"لَّهُمْ","translit":"ْmُhَّl","root":""},{"id":15,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":16,"arabic":"أَزْوَٰجٌ","translit":"ٌjgَٰwْzَaʾ","root":"زوج"},{"id":17,"arabic":"مُّطَهَّرَةٌ","translit":"ٌẗَrَّhَṭُّm","root":"طهر"},{"id":18,"arabic":"وَنُدْخِلُهُمْ","translit":"ْmُhُlِhkْdُnَw","root":"دخل"},{"id":19,"arabic":"ظِلًّا","translit":"āًّlِẓ","root":"ظلل"},{"id":20,"arabic":"ظَلِيلًا","translit":"āًlyِlَẓ","root":"ظلل"}],"hasIhya":true},{"ayah":58,"text":"إِنَّ ٱللَّهَ يَأْمُرُكُمْ أَن تُؤَدُّوا۟ ٱلْأَمَٰنَٰتِ إِلَىٰٓ أَهْلِهَا وَإِذَا حَكَمْتُم بَيْنَ ٱلنَّاسِ أَن تَحْكُمُوا۟ بِٱلْعَدْلِۚ إِنَّ ٱللَّهَ نِعِمَّا يَعِظُكُم بِهِۦٓۗ إِنَّ ٱللَّهَ كَانَ سَمِيعًۢا بَصِيرًا ","translation":"Indeed, Allāh commands you to render trusts to whom they are due and when you judge between people to judge with justice. Excellent is that which Allāh instructs you. Indeed, Allāh is ever Hearing and Seeing.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"يَأْمُرُكُمْ","translit":"ْmُkُrُmْaʾَy","root":"امر"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"تُؤَدُّوا۟","translit":"۟āwُّdَwʾُt","root":"ادي"},{"id":6,"arabic":"ٱلْأَمَٰنَٰتِ","translit":"ِtَٰnَٰmَaʾْlٱ","root":"امن"},{"id":7,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":8,"arabic":"أَهْلِهَا","translit":"āَhِlْhَaʾ","root":"اهل"},{"id":9,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":10,"arabic":"حَكَمْتُم","translit":"mُtْmَkَḥ","root":"حكم"},{"id":11,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":12,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":13,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":14,"arabic":"تَحْكُمُوا۟","translit":"۟āwُmُkْḥَt","root":"حكم"},{"id":15,"arabic":"بِٱلْعَدْلِ","translit":"ِlْdَʿعْlٱِb","root":"عدل"},{"id":16,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":17,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":18,"arabic":"نِعِمَّا","translit":"āَّmِʿعِn","root":"نعم"},{"id":19,"arabic":"يَعِظُكُم","translit":"mُkُẓِʿعَy","root":"وعظ"},{"id":20,"arabic":"بِهِۦٓ","translit":"ٓۦِhِb","root":""},{"id":21,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":22,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":23,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":24,"arabic":"سَمِيعًۢا","translit":"āًۢʿعyِmَs","root":"سمع"},{"id":25,"arabic":"بَصِيرًا","translit":"āًryِṣَb","root":"بصر"}],"hasIhya":true},{"ayah":59,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ وَأُو۟لِى ٱلْأَمْرِ مِنكُمْۖ فَإِن تَنَٰزَعْتُمْ فِى شَىْءٍ فَرُدُّوهُ إِلَى ٱللَّهِ وَٱلرَّسُولِ إِن كُنتُمْ تُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِۚ ذَٰلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا ","translation":"O you who have believed, obey Allāh and obey the Messenger and those in authority among you. And if you disagree over anything, refer it to Allāh and the Messenger, if you should believe in Allāh and the Last Day. That is the best [way] and best in result.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":4,"arabic":"أَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾ","root":"طوع"},{"id":5,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":6,"arabic":"وَأَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾَw","root":"طوع"},{"id":7,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":8,"arabic":"وَأُو۟لِى","translit":"àِl۟wُaʾَw","root":""},{"id":9,"arabic":"ٱلْأَمْرِ","translit":"ِrْmَaʾْlٱ","root":"امر"},{"id":10,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":11,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":12,"arabic":"تَنَٰزَعْتُمْ","translit":"ْmُtْʿعَzَٰnَt","root":"نزع"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":15,"arabic":"فَرُدُّوهُ","translit":"ُhwُّdُrَf","root":"ردد"},{"id":16,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"وَٱلرَّسُولِ","translit":"ِlwُsَّrlٱَw","root":"رسل"},{"id":19,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":20,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":21,"arabic":"تُؤْمِنُونَ","translit":"َnwُnِmْwʾُt","root":"امن"},{"id":22,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":23,"arabic":"وَٱلْيَوْمِ","translit":"ِmْwَyْlٱَw","root":"يوم"},{"id":24,"arabic":"ٱلْءَاخِرِ","translit":"ِrِhkāَءْlٱ","root":"اخر"},{"id":25,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":26,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":27,"arabic":"وَأَحْسَنُ","translit":"ُnَsْḥَaʾَw","root":"حسن"},{"id":28,"arabic":"تَأْوِيلًا","translit":"āًlyِwْaʾَt","root":"اول"}],"hasIhya":true},{"ayah":60,"text":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ يَزْعُمُونَ أَنَّهُمْ ءَامَنُوا۟ بِمَآ أُنزِلَ إِلَيْكَ وَمَآ أُنزِلَ مِن قَبْلِكَ يُرِيدُونَ أَن يَتَحَاكَمُوٓا۟ إِلَى ٱلطَّٰغُوتِ وَقَدْ أُمِرُوٓا۟ أَن يَكْفُرُوا۟ بِهِۦ وَيُرِيدُ ٱلشَّيْطَٰنُ أَن يُضِلَّهُمْ ضَلَٰلًۢا بَعِيدًا ","translation":"Have you not seen those who claim to have believed in what was revealed to you, [O Muḥammad], and what was revealed before you? They wish to refer legislation to ṭāghūt,[1] while they were commanded to reject it; and Satan wishes to lead them far astray.","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"يَزْعُمُونَ","translit":"َnwُmُʿعْzَy","root":"زعم"},{"id":6,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":7,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":8,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":9,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":10,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":11,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":12,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":15,"arabic":"يُرِيدُونَ","translit":"َnwُdyِrُy","root":"رود"},{"id":16,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":17,"arabic":"يَتَحَاكَمُوٓا۟","translit":"۟āٓwُmَkāَḥَtَy","root":"حكم"},{"id":18,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":19,"arabic":"ٱلطَّٰغُوتِ","translit":"ِtwُغَّٰṭlٱ","root":"طغي"},{"id":20,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":21,"arabic":"أُمِرُوٓا۟","translit":"۟āٓwُrِmُaʾ","root":"امر"},{"id":22,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":23,"arabic":"يَكْفُرُوا۟","translit":"۟āwُrُfْkَy","root":"كفر"},{"id":24,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":25,"arabic":"وَيُرِيدُ","translit":"ُdyِrُyَw","root":"رود"},{"id":26,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":27,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":28,"arabic":"يُضِلَّهُمْ","translit":"ْmُhَّlِḍُy","root":"ضلل"},{"id":29,"arabic":"ضَلَٰلًۢا","translit":"āًۢlَٰlَḍ","root":"ضلل"},{"id":30,"arabic":"بَعِيدًا","translit":"āًdyِʿعَb","root":"بعد"}],"hasIhya":false},{"ayah":61,"text":"وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ رَأَيْتَ ٱلْمُنَٰفِقِينَ يَصُدُّونَ عَنكَ صُدُودًا ","translation":"And when it is said to them, \"Come to what Allāh has revealed and to the Messenger,\" you see the hypocrites turning away from you in aversion.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"قِيلَ","translit":"َlyِq","root":"قول"},{"id":3,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":4,"arabic":"تَعَالَوْا۟","translit":"۟āْwَlāَʿعَt","root":"علو"},{"id":5,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":6,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":7,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"وَإِلَى","translit":"àَlِiʾَw","root":""},{"id":10,"arabic":"ٱلرَّسُولِ","translit":"ِlwُsَّrlٱ","root":"رسل"},{"id":11,"arabic":"رَأَيْتَ","translit":"َtْyَaʾَr","root":"راي"},{"id":12,"arabic":"ٱلْمُنَٰفِقِينَ","translit":"َnyِqِfَٰnُmْlٱ","root":"نفق"},{"id":13,"arabic":"يَصُدُّونَ","translit":"َnwُّdُṣَy","root":"صدد"},{"id":14,"arabic":"عَنكَ","translit":"َknَʿع","root":""},{"id":15,"arabic":"صُدُودًا","translit":"āًdwُdُṣ","root":"صدد"}],"hasIhya":false},{"ayah":62,"text":"فَكَيْفَ إِذَآ أَصَٰبَتْهُم مُّصِيبَةٌۢ بِمَا قَدَّمَتْ أَيْدِيهِمْ ثُمَّ جَآءُوكَ يَحْلِفُونَ بِٱللَّهِ إِنْ أَرَدْنَآ إِلَّآ إِحْسَٰنًا وَتَوْفِيقًا ","translation":"So how [will it be] when disaster strikes them because of what their hands have put forth and then they come to you swearing by Allāh, \"We intended nothing but good conduct and accommodation.\"","words":[{"id":1,"arabic":"فَكَيْفَ","translit":"َfْyَkَf","root":"كيف"},{"id":2,"arabic":"إِذَآ","translit":"ٓāَhdِiʾ","root":""},{"id":3,"arabic":"أَصَٰبَتْهُم","translit":"mُhْtَbَٰṣَaʾ","root":"صوب"},{"id":4,"arabic":"مُّصِيبَةٌۢ","translit":"ٌۢẗَbyِṣُّm","root":"صوب"},{"id":5,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":6,"arabic":"قَدَّمَتْ","translit":"ْtَmَّdَq","root":"قدم"},{"id":7,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":8,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":9,"arabic":"جَآءُوكَ","translit":"َkwُءٓāَjg","root":"جيا"},{"id":10,"arabic":"يَحْلِفُونَ","translit":"َnwُfِlْḥَy","root":"حلف"},{"id":11,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":12,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":13,"arabic":"أَرَدْنَآ","translit":"ٓāَnْdَrَaʾ","root":"رود"},{"id":14,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":15,"arabic":"إِحْسَٰنًا","translit":"āًnَٰsْḥِiʾ","root":"حسن"},{"id":16,"arabic":"وَتَوْفِيقًا","translit":"āًqyِfْwَtَw","root":"وفق"}],"hasIhya":false},{"ayah":63,"text":"أُو۟لَٰٓئِكَ ٱلَّذِينَ يَعْلَمُ ٱللَّهُ مَا فِى قُلُوبِهِمْ فَأَعْرِضْ عَنْهُمْ وَعِظْهُمْ وَقُل لَّهُمْ فِىٓ أَنفُسِهِمْ قَوْلًۢا بَلِيغًا ","translation":"Those are the ones of whom Allāh knows what is in their hearts, so turn away from them[1] but admonish them and speak to them a far-reaching [i.e., effective] word.","words":[{"id":1,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"قُلُوبِهِمْ","translit":"ْmِhِbwُlُq","root":"قلب"},{"id":8,"arabic":"فَأَعْرِضْ","translit":"ْḍِrْʿعَaʾَf","root":"عرض"},{"id":9,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":10,"arabic":"وَعِظْهُمْ","translit":"ْmُhْẓِʿعَw","root":"وعظ"},{"id":11,"arabic":"وَقُل","translit":"lُqَw","root":"قول"},{"id":12,"arabic":"لَّهُمْ","translit":"ْmُhَّl","root":""},{"id":13,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":14,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":15,"arabic":"قَوْلًۢا","translit":"āًۢlْwَq","root":"قول"},{"id":16,"arabic":"بَلِيغًا","translit":"āًغyِlَb","root":"بلغ"}],"hasIhya":false},{"ayah":64,"text":"وَمَآ أَرْسَلْنَا مِن رَّسُولٍ إِلَّا لِيُطَاعَ بِإِذْنِ ٱللَّهِۚ وَلَوْ أَنَّهُمْ إِذ ظَّلَمُوٓا۟ أَنفُسَهُمْ جَآءُوكَ فَٱسْتَغْفَرُوا۟ ٱللَّهَ وَٱسْتَغْفَرَ لَهُمُ ٱلرَّسُولُ لَوَجَدُوا۟ ٱللَّهَ تَوَّابًا رَّحِيمًا ","translation":"And We did not send any messenger except to be obeyed by permission of Allāh. And if, when they wronged themselves, they had come to you, [O Muḥammad], and asked forgiveness of Allāh and the Messenger had asked forgiveness for them, they would have found Allāh Accepting of Repentance and Merciful.","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"رَّسُولٍ","translit":"ٍlwُsَّr","root":"رسل"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"لِيُطَاعَ","translit":"َʿعāَṭُyِl","root":"طوع"},{"id":7,"arabic":"بِإِذْنِ","translit":"ِnْhdِiʾِb","root":"اذن"},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":10,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":11,"arabic":"إِذ","translit":"hdِiʾ","root":""},{"id":12,"arabic":"ظَّلَمُوٓا۟","translit":"۟āٓwُmَlَّẓ","root":"ظلم"},{"id":13,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":14,"arabic":"جَآءُوكَ","translit":"َkwُءٓāَjg","root":"جيا"},{"id":15,"arabic":"فَٱسْتَغْفَرُوا۟","translit":"۟āwُrَfْغَtْsٱَf","root":"غفر"},{"id":16,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":17,"arabic":"وَٱسْتَغْفَرَ","translit":"َrَfْغَtْsٱَw","root":"غفر"},{"id":18,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":19,"arabic":"ٱلرَّسُولُ","translit":"ُlwُsَّrlٱ","root":"رسل"},{"id":20,"arabic":"لَوَجَدُوا۟","translit":"۟āwُdَjgَwَl","root":"وجد"},{"id":21,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":22,"arabic":"تَوَّابًا","translit":"āًbāَّwَt","root":"توب"},{"id":23,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":65,"text":"فَلَا وَرَبِّكَ لَا يُؤْمِنُونَ حَتَّىٰ يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ ثُمَّ لَا يَجِدُوا۟ فِىٓ أَنفُسِهِمْ حَرَجًا مِّمَّا قَضَيْتَ وَيُسَلِّمُوا۟ تَسْلِيمًا ","translation":"But no, by your Lord, they will not [truly] believe until they make you, [O Muḥammad], judge concerning that over which they dispute among themselves and then find within themselves no discomfort from what you have judged and submit in [full, willing] submission.","words":[{"id":1,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":2,"arabic":"وَرَبِّكَ","translit":"َkِّbَrَw","root":"ربب"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":5,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":6,"arabic":"يُحَكِّمُوكَ","translit":"َkwُmِّkَḥُy","root":"حكم"},{"id":7,"arabic":"فِيمَا","translit":"āَmyِf","root":""},{"id":8,"arabic":"شَجَرَ","translit":"َrَjgَhs","root":"شجر"},{"id":9,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":10,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":11,"arabic":"لَا","translit":"āَl","root":""},{"id":12,"arabic":"يَجِدُوا۟","translit":"۟āwُdِjgَy","root":"وجد"},{"id":13,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":14,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":15,"arabic":"حَرَجًا","translit":"āًjgَrَḥ","root":"حرج"},{"id":16,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":17,"arabic":"قَضَيْتَ","translit":"َtْyَḍَq","root":"قضي"},{"id":18,"arabic":"وَيُسَلِّمُوا۟","translit":"۟āwُmِّlَsُyَw","root":"سلم"},{"id":19,"arabic":"تَسْلِيمًا","translit":"āًmyِlْsَt","root":"سلم"}],"hasIhya":false},{"ayah":66,"text":"وَلَوْ أَنَّا كَتَبْنَا عَلَيْهِمْ أَنِ ٱقْتُلُوٓا۟ أَنفُسَكُمْ أَوِ ٱخْرُجُوا۟ مِن دِيَٰرِكُم مَّا فَعَلُوهُ إِلَّا قَلِيلٌ مِّنْهُمْۖ وَلَوْ أَنَّهُمْ فَعَلُوا۟ مَا يُوعَظُونَ بِهِۦ لَكَانَ خَيْرًا لَّهُمْ وَأَشَدَّ تَثْبِيتًا ","translation":"And if We had decreed upon them, \"Kill yourselves\" or \"Leave your homes,\" they would not have done it, except for a few of them. But if they had done what they were instructed, it would have been better for them and a firmer position [for them in faith].","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"