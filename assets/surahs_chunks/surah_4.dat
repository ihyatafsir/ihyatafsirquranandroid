ُّبِينًا ","translation":"But if you want to replace one wife with another and you have given one of them a great amount [in gifts], do not take [back] from it anything. Would you take it in injustice and manifest sin?","words":[{"id":1,"arabic":"وَإِنْ","translit":"ْnِiʾَw","root":""},{"id":2,"arabic":"أَرَدتُّمُ","translit":"ُmُّtdَrَaʾ","root":"رود"},{"id":3,"arabic":"ٱسْتِبْدَالَ","translit":"َlāَdْbِtْsٱ","root":"بدل"},{"id":4,"arabic":"زَوْجٍ","translit":"ٍjgْwَz","root":"زوج"},{"id":5,"arabic":"مَّكَانَ","translit":"َnāَkَّm","root":"كون"},{"id":6,"arabic":"زَوْجٍ","translit":"ٍjgْwَz","root":"زوج"},{"id":7,"arabic":"وَءَاتَيْتُمْ","translit":"ْmُtْyَtāَءَw","root":"اتي"},{"id":8,"arabic":"إِحْدَىٰهُنَّ","translit":"َّnُhٰàَdْḥِiʾ","root":"احد"},{"id":9,"arabic":"قِنطَارًا","translit":"āًrāَṭnِq","root":"قنطر"},{"id":10,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":11,"arabic":"تَأْخُذُوا۟","translit":"۟āwُhdُhkْaʾَt","root":"اخذ"},{"id":12,"arabic":"مِنْهُ","translit":"ُhْnِm","root":""},{"id":13,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":14,"arabic":"أَتَأْخُذُونَهُۥ","translit":"ۥُhَnwُhdُhkْaʾَtَaʾ","root":"اخذ"},{"id":15,"arabic":"بُهْتَٰنًا","translit":"āًnَٰtْhُb","root":"بهت"},{"id":16,"arabic":"وَإِثْمًا","translit":"āًmْhtِiʾَw","root":"اثم"},{"id":17,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":21,"text":"وَكَيْفَ تَأْخُذُونَهُۥ وَقَدْ أَفْضَىٰ بَعْضُكُمْ إِلَىٰ بَعْضٍ وَأَخَذْنَ مِنكُم مِّيثَٰقًا غَلِيظًا ","translation":"And how could you take it while you have gone in unto each other and they have taken from you a solemn covenant?","words":[{"id":1,"arabic":"وَكَيْفَ","translit":"َfْyَkَw","root":"كيف"},{"id":2,"arabic":"تَأْخُذُونَهُۥ","translit":"ۥُhَnwُhdُhkْaʾَt","root":"اخذ"},{"id":3,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":4,"arabic":"أَفْضَىٰ","translit":"ٰàَḍْfَaʾ","root":"فضو"},{"id":5,"arabic":"بَعْضُكُمْ","translit":"ْmُkُḍْʿعَb","root":"بعض"},{"id":6,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":7,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":8,"arabic":"وَأَخَذْنَ","translit":"َnْhdَhkَaʾَw","root":"اخذ"},{"id":9,"arabic":"مِنكُم","translit":"mُknِm","root":""},{"id":10,"arabic":"مِّيثَٰقًا","translit":"āًqَٰhtyِّm","root":"وثق"},{"id":11,"arabic":"غَلِيظًا","translit":"āًẓyِlَغ","root":"غلظ"}],"hasIhya":true},{"ayah":22,"text":"وَلَا تَنكِحُوا۟ مَا نَكَحَ ءَابَآؤُكُم مِّنَ ٱلنِّسَآءِ إِلَّا مَا قَدْ سَلَفَۚ إِنَّهُۥ كَانَ فَٰحِشَةً وَمَقْتًا وَسَآءَ سَبِيلًا ","translation":"And do not marry those [women] whom your fathers married, except what has already occurred.[1] Indeed, it was an immorality and hateful [to Allāh] and was evil as a way.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَنكِحُوا۟","translit":"۟āwُḥِknَt","root":"نكح"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"نَكَحَ","translit":"َḥَkَn","root":"نكح"},{"id":5,"arabic":"ءَابَآؤُكُم","translit":"mُkُwʾٓāَbāَء","root":"ابو"},{"id":6,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":7,"arabic":"ٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱ","root":"نسو"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":11,"arabic":"سَلَفَ","translit":"َfَlَs","root":"سلف"},{"id":12,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":13,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":14,"arabic":"فَٰحِشَةً","translit":"ًẗَhsِḥَٰf","root":"فحش"},{"id":15,"arabic":"وَمَقْتًا","translit":"āًtْqَmَw","root":"مقت"},{"id":16,"arabic":"وَسَآءَ","translit":"َءٓāَsَw","root":"سوا"},{"id":17,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":23,"text":"حُرِّمَتْ عَلَيْكُمْ أُمَّهَٰتُكُمْ وَبَنَاتُكُمْ وَأَخَوَٰتُكُمْ وَعَمَّٰتُكُمْ وَخَٰلَٰتُكُمْ وَبَنَاتُ ٱلْأَخِ وَبَنَاتُ ٱلْأُخْتِ وَأُمَّهَٰتُكُمُ ٱلَّٰتِىٓ أَرْضَعْنَكُمْ وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَٰعَةِ وَأُمَّهَٰتُ نِسَآئِكُمْ وَرَبَٰٓئِبُكُمُ ٱلَّٰتِى فِى حُجُورِكُم مِّن نِّسَآئِكُمُ ٱلَّٰتِى دَخَلْتُم بِهِنَّ فَإِن لَّمْ تَكُونُوا۟ دَخَلْتُم بِهِنَّ فَلَا جُنَاحَ عَلَيْكُمْ وَحَلَٰٓئِلُ أَبْنَآئِكُمُ ٱلَّذِينَ مِنْ أَصْلَٰبِكُمْ وَأَن تَجْمَعُوا۟ بَيْنَ ٱلْأُخْتَيْنِ إِلَّا مَا قَدْ سَلَفَۗ إِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا ","translation":"Prohibited to you [for marriage] are your mothers, your daughters, your sisters, your father's sisters, your mother's sisters, your brother's daughters, your sister's daughters, your [milk] mothers who nursed you, your sisters through nursing, your wives' mothers, and your step-daughters under your guardianship [born] of your wives unto whom you have gone in. But if you have not gone in unto them, there is no sin upon you. And [also prohibited are] the wives of your sons who are from your [own] loins, and that you take [in marriage] two sisters simultaneously, except for what has already occurred.[1] Indeed, Allāh is ever Forgiving and Merciful.","words":[{"id":1,"arabic":"حُرِّمَتْ","translit":"ْtَmِّrُḥ","root":"حرم"},{"id":2,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":3,"arabic":"أُمَّهَٰتُكُمْ","translit":"ْmُkُtَٰhَّmُaʾ","root":"امم"},{"id":4,"arabic":"وَبَنَاتُكُمْ","translit":"ْmُkُtāَnَbَw","root":"بني"},{"id":5,"arabic":"وَأَخَوَٰتُكُمْ","translit":"ْmُkُtَٰwَhkَaʾَw","root":"اخو"},{"id":6,"arabic":"وَعَمَّٰتُكُمْ","translit":"ْmُkُtَّٰmَʿعَw","root":"عمم"},{"id":7,"arabic":"وَخَٰلَٰتُكُمْ","translit":"ْmُkُtَٰlَٰhkَw","root":"خول"},{"id":8,"arabic":"وَبَنَاتُ","translit":"ُtāَnَbَw","root":"بني"},{"id":9,"arabic":"ٱلْأَخِ","translit":"ِhkَaʾْlٱ","root":"اخو"},{"id":10,"arabic":"وَبَنَاتُ","translit":"ُtāَnَbَw","root":"بني"},{"id":11,"arabic":"ٱلْأُخْتِ","translit":"ِtْhkُaʾْlٱ","root":"اخو"},{"id":12,"arabic":"وَأُمَّهَٰتُكُمُ","translit":"ُmُkُtَٰhَّmُaʾَw","root":"امم"},{"id":13,"arabic":"ٱلَّٰتِىٓ","translit":"ٓàِtَّٰlٱ","root":""},{"id":14,"arabic":"أَرْضَعْنَكُمْ","translit":"ْmُkَnْʿعَḍْrَaʾ","root":"رضع"},{"id":15,"arabic":"وَأَخَوَٰتُكُم","translit":"mُkُtَٰwَhkَaʾَw","root":"اخو"},{"id":16,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":17,"arabic":"ٱلرَّضَٰعَةِ","translit":"ِẗَʿعَٰḍَّrlٱ","root":"رضع"},{"id":18,"arabic":"وَأُمَّهَٰتُ","translit":"ُtَٰhَّmُaʾَw","root":"امم"},{"id":19,"arabic":"نِسَآئِكُمْ","translit":"ْmُkِyʾٓāَsِn","root":"نسو"},{"id":20,"arabic":"وَرَبَٰٓئِبُكُمُ","translit":"ُmُkُbِyʾَٰٓbَrَw","root":"ربب"},{"id":21,"arabic":"ٱلَّٰتِى","translit":"àِtَّٰlٱ","root":""},{"id":22,"arabic":"فِى","translit":"àِf","root":""},{"id":23,"arabic":"حُجُورِكُم","translit":"mُkِrwُjgُḥ","root":"حجر"},{"id":24,"arabic":"مِّن","translit":"nِّm","root":""},{"id":25,"arabic":"نِّسَآئِكُمُ","translit":"ُmُkِyʾٓāَsِّn","root":"نسو"},{"id":26,"arabic":"ٱلَّٰتِى","translit":"àِtَّٰlٱ","root":""},{"id":27,"arabic":"دَخَلْتُم","translit":"mُtْlَhkَd","root":"دخل"},{"id":28,"arabic":"بِهِنَّ","translit":"َّnِhِb","root":""},{"id":29,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":30,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":31,"arabic":"تَكُونُوا۟","translit":"۟āwُnwُkَt","root":"كون"},{"id":32,"arabic":"دَخَلْتُم","translit":"mُtْlَhkَd","root":"دخل"},{"id":33,"arabic":"بِهِنَّ","translit":"َّnِhِb","root":""},{"id":34,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":35,"arabic":"جُنَاحَ","translit":"َḥāَnُjg","root":"جنح"},{"id":36,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":37,"arabic":"وَحَلَٰٓئِلُ","translit":"ُlِyʾَٰٓlَḥَw","root":"حلل"},{"id":38,"arabic":"أَبْنَآئِكُمُ","translit":"ُmُkِyʾٓāَnْbَaʾ","root":"بني"},{"id":39,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":40,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":41,"arabic":"أَصْلَٰبِكُمْ","translit":"ْmُkِbَٰlْṣَaʾ","root":"صلب"},{"id":42,"arabic":"وَأَن","translit":"nَaʾَw","root":""},{"id":43,"arabic":"تَجْمَعُوا۟","translit":"۟āwُʿعَmْjgَt","root":"جمع"},{"id":44,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":45,"arabic":"ٱلْأُخْتَيْنِ","translit":"ِnْyَtْhkُaʾْlٱ","root":"اخو"},{"id":46,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":47,"arabic":"مَا","translit":"āَm","root":""},{"id":48,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":49,"arabic":"سَلَفَ","translit":"َfَlَs","root":"سلف"},{"id":50,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":51,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":52,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":53,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"},{"id":54,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":24,"text":"وَٱلْمُحْصَنَٰتُ مِنَ ٱلنِّسَآءِ إِلَّا مَا مَلَكَتْ أَيْمَٰنُكُمْۖ كِتَٰبَ ٱللَّهِ عَلَيْكُمْۚ وَأُحِلَّ لَكُم مَّا وَرَآءَ ذَٰلِكُمْ أَن تَبْتَغُوا۟ بِأَمْوَٰلِكُم مُّحْصِنِينَ غَيْرَ مُسَٰفِحِينَۚ فَمَا ٱسْتَمْتَعْتُم بِهِۦ مِنْهُنَّ فَـَٔاتُوهُنَّ أُجُورَهُنَّ فَرِيضَةًۚ وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا تَرَٰضَيْتُم بِهِۦ مِنۢ بَعْدِ ٱلْفَرِيضَةِۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا ","translation":"And [also prohibited to you are all] married women except those your right hands possess.[1] [This is] the decree of Allāh upon you. And lawful to you are [all others] beyond these, [provided] that you seek them [in marriage] with [gifts from] your property, desiring chastity, not unlawful sexual intercourse. So for whatever you enjoy [of marriage] from them, give them their due compensation[2] as an obligation. And there is no blame upon you for what you mutually agree to beyond the obligation. Indeed, Allāh is ever Knowing and Wise.","words":[{"id":1,"arabic":"وَٱلْمُحْصَنَٰتُ","translit":"ُtَٰnَṣْḥُmْlٱَw","root":"حصن"},{"id":2,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":3,"arabic":"ٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱ","root":"نسو"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"مَلَكَتْ","translit":"ْtَkَlَm","root":"ملك"},{"id":7,"arabic":"أَيْمَٰنُكُمْ","translit":"ْmُkُnَٰmْyَaʾ","root":"يمن"},{"id":8,"arabic":"كِتَٰبَ","translit":"َbَٰtِk","root":"كتب"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":11,"arabic":"وَأُحِلَّ","translit":"َّlِḥُaʾَw","root":"حلل"},{"id":12,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":13,"arabic":"مَّا","translit":"āَّm","root":""},{"id":14,"arabic":"وَرَآءَ","translit":"َءٓāَrَw","root":"وري"},{"id":15,"arabic":"ذَٰلِكُمْ","translit":"ْmُkِlَٰhd","root":""},{"id":16,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":17,"arabic":"تَبْتَغُوا۟","translit":"۟āwُغَtْbَt","root":"بغي"},{"id":18,"arabic":"بِأَمْوَٰلِكُم","translit":"mُkِlَٰwْmَaʾِb","root":"مول"},{"id":19,"arabic":"مُّحْصِنِينَ","translit":"َnyِnِṣْḥُّm","root":"حصن"},{"id":20,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":21,"arabic":"مُسَٰفِحِينَ","translit":"َnyِḥِfَٰsُm","root":"سفح"},{"id":22,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":23,"arabic":"ٱسْتَمْتَعْتُم","translit":"mُtْʿعَtْmَtْsٱ","root":"متع"},{"id":24,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":25,"arabic":"مِنْهُنَّ","translit":"َّnُhْnِm","root":""},{"id":26,"arabic":"فَـَٔاتُوهُنَّ","translit":"َّnُhwُtāَٔـَf","root":"اتي"},{"id":27,"arabic":"أُجُورَهُنَّ","translit":"َّnُhَrwُjgُaʾ","root":"اجر"},{"id":28,"arabic":"فَرِيضَةً","translit":"ًẗَḍyِrَf","root":"فرض"},{"id":29,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":30,"arabic":"جُنَاحَ","translit":"َḥāَnُjg","root":"جنح"},{"id":31,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":32,"arabic":"فِيمَا","translit":"āَmyِf","root":""},{"id":33,"arabic":"تَرَٰضَيْتُم","translit":"mُtْyَḍَٰrَt","root":"رضو"},{"id":34,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":35,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":36,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":37,"arabic":"ٱلْفَرِيضَةِ","translit":"ِẗَḍyِrَfْlٱ","root":"فرض"},{"id":38,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":39,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":40,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":41,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"},{"id":42,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":25,"text":"وَمَن لَّمْ يَسْتَطِعْ مِنكُمْ طَوْلًا أَن يَنكِحَ ٱلْمُحْصَنَٰتِ ٱلْمُؤْمِنَٰتِ فَمِن مَّا مَلَكَتْ أَيْمَٰنُكُم مِّن فَتَيَٰتِكُمُ ٱلْمُؤْمِنَٰتِۚ وَٱللَّهُ أَعْلَمُ بِإِيمَٰنِكُمۚ بَعْضُكُم مِّنۢ بَعْضٍۚ فَٱنكِحُوهُنَّ بِإِذْنِ أَهْلِهِنَّ وَءَاتُوهُنَّ أُجُورَهُنَّ بِٱلْمَعْرُوفِ مُحْصَنَٰتٍ غَيْرَ مُسَٰفِحَٰتٍ وَلَا مُتَّخِذَٰتِ أَخْدَانٍۚ فَإِذَآ أُحْصِنَّ فَإِنْ أَتَيْنَ بِفَٰحِشَةٍ فَعَلَيْهِنَّ نِصْفُ مَا عَلَى ٱلْمُحْصَنَٰتِ مِنَ ٱلْعَذَابِۚ ذَٰلِكَ لِمَنْ خَشِىَ ٱلْعَنَتَ مِنكُمْۚ وَأَن تَصْبِرُوا۟ خَيْرٌ لَّكُمْۗ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ","translation":"And whoever among you cannot [find] the means to marry free, believing women, then [he may marry] from those whom your right hands possess of believing slave girls. And Allāh is most knowing about your faith. You [believers] are of one another. So marry them with the permission of their people and give them their due compensation [i.e., mahr] according to what is acceptable. [They should be] chaste, neither [of] those who commit unlawful intercourse randomly nor those who take [secret] lovers. But once they are sheltered in marriage, if they should commit adultery, then for them is half the punishment for free [unmarried] women. This [allowance] is for him among you who fears affliction [i.e., sin], but to be patient is better for you. And Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":3,"arabic":"يَسْتَطِعْ","translit":"ْʿعِṭَtْsَy","root":"طوع"},{"id":4,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":5,"arabic":"طَوْلًا","translit":"āًlْwَṭ","root":"طول"},{"id":6,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":7,"arabic":"يَنكِحَ","translit":"َḥِknَy","root":"نكح"},{"id":8,"arabic":"ٱلْمُحْصَنَٰتِ","translit":"ِtَٰnَṣْḥُmْlٱ","root":"حصن"},{"id":9,"arabic":"ٱلْمُؤْمِنَٰتِ","translit":"ِtَٰnِmْwʾُmْlٱ","root":"امن"},{"id":10,"arabic":"فَمِن","translit":"nِmَf","root":""},{"id":11,"arabic":"مَّا","translit":"āَّm","root":""},{"id":12,"arabic":"مَلَكَتْ","translit":"ْtَkَlَm","root":"ملك"},{"id":13,"arabic":"أَيْمَٰنُكُم","translit":"mُkُnَٰmْyَaʾ","root":"يمن"},{"id":14,"arabic":"مِّن","translit":"nِّm","root":""},{"id":15,"arabic":"فَتَيَٰتِكُمُ","translit":"ُmُkِtَٰyَtَf","root":"فتي"},{"id":16,"arabic":"ٱلْمُؤْمِنَٰتِ","translit":"ِtَٰnِmْwʾُmْlٱ","root":"امن"},{"id":17,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":18,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":19,"arabic":"بِإِيمَٰنِكُم","translit":"mُkِnَٰmyِiʾِb","root":"امن"},{"id":20,"arabic":"بَعْضُكُم","translit":"mُkُḍْʿعَb","root":"بعض"},{"id":21,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":22,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":23,"arabic":"فَٱنكِحُوهُنَّ","translit":"َّnُhwُḥِknٱَf","root":"نكح"},{"id":24,"arabic":"بِإِذْنِ","translit":"ِnْhdِiʾِb","root":"اذن"},{"id":25,"arabic":"أَهْلِهِنَّ","translit":"َّnِhِlْhَaʾ","root":"اهل"},{"id":26,"arabic":"وَءَاتُوهُنَّ","translit":"َّnُhwُtāَءَw","root":"اتي"},{"id":27,"arabic":"أُجُورَهُنَّ","translit":"َّnُhَrwُjgُaʾ","root":"اجر"},{"id":28,"arabic":"بِٱلْمَعْرُوفِ","translit":"ِfwُrْʿعَmْlٱِb","root":"عرف"},{"id":29,"arabic":"مُحْصَنَٰتٍ","translit":"ٍtَٰnَṣْḥُm","root":"حصن"},{"id":30,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":31,"arabic":"مُسَٰفِحَٰتٍ","translit":"ٍtَٰḥِfَٰsُm","root":"سفح"},{"id":32,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":33,"arabic":"مُتَّخِذَٰتِ","translit":"ِtَٰhdِhkَّtُm","root":"اخذ"},{"id":34,"arabic":"أَخْدَانٍ","translit":"ٍnāَdْhkَaʾ","root":"خدن"},{"id":35,"arabic":"فَإِذَآ","translit":"ٓāَhdِiʾَf","root":""},{"id":36,"arabic":"أُحْصِنَّ","translit":"َّnِṣْḥُaʾ","root":"حصن"},{"id":37,"arabic":"فَإِنْ","translit":"ْnِiʾَf","root":""},{"id":38,"arabic":"أَتَيْنَ","translit":"َnْyَtَaʾ","root":"اتي"},{"id":39,"arabic":"بِفَٰحِشَةٍ","translit":"ٍẗَhsِḥَٰfِb","root":"فحش"},{"id":40,"arabic":"فَعَلَيْهِنَّ","translit":"َّnِhْyَlَʿعَf","root":""},{"id":41,"arabic":"نِصْفُ","translit":"ُfْṣِn","root":"نصف"},{"id":42,"arabic":"مَا","translit":"āَm","root":""},{"id":43,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":44,"arabic":"ٱلْمُحْصَنَٰتِ","translit":"ِtَٰnَṣْḥُmْlٱ","root":"حصن"},{"id":45,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":46,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":47,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":48,"arabic":"لِمَنْ","translit":"ْnَmِl","root":""},{"id":49,"arabic":"خَشِىَ","translit":"َàِhsَhk","root":"خشي"},{"id":50,"arabic":"ٱلْعَنَتَ","translit":"َtَnَʿعْlٱ","root":"عنت"},{"id":51,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":52,"arabic":"وَأَن","translit":"nَaʾَw","root":""},{"id":53,"arabic":"تَصْبِرُوا۟","translit":"۟āwُrِbْṣَt","root":"صبر"},{"id":54,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":55,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":56,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":57,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":58,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":26,"text":"يُرِيدُ ٱللَّهُ لِيُبَيِّنَ لَكُمْ وَيَهْدِيَكُمْ سُنَنَ ٱلَّذِينَ مِن قَبْلِكُمْ وَيَتُوبَ عَلَيْكُمْۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ","translation":"Allāh wants to make clear to you [the lawful from the unlawful] and guide you to the [good] practices of those before you and to accept your repentance. And Allāh is Knowing and Wise.","words":[{"id":1,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"لِيُبَيِّنَ","translit":"َnِّyَbُyِl","root":"بين"},{"id":4,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":5,"arabic":"وَيَهْدِيَكُمْ","translit":"ْmُkَyِdْhَyَw","root":"هدي"},{"id":6,"arabic":"سُنَنَ","translit":"َnَnُs","root":"سنن"},{"id":7,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"قَبْلِكُمْ","translit":"ْmُkِlْbَq","root":"قبل"},{"id":10,"arabic":"وَيَتُوبَ","translit":"َbwُtَyَw","root":"توب"},{"id":11,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":12,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":13,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"},{"id":14,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":27,"text":"وَٱللَّهُ يُرِيدُ أَن يَتُوبَ عَلَيْكُمْ وَيُرِيدُ ٱلَّذِينَ يَتَّبِعُونَ ٱلشَّهَوَٰتِ أَن تَمِيلُوا۟ مَيْلًا عَظِيمًا ","translation":"Allāh wants to accept your repentance, but those who follow [their] passions want you to digress [into] a great deviation.","words":[{"id":1,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":2,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"يَتُوبَ","translit":"َbwُtَy","root":"توب"},{"id":5,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":6,"arabic":"وَيُرِيدُ","translit":"ُdyِrُyَw","root":"رود"},{"id":7,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":8,"arabic":"يَتَّبِعُونَ","translit":"َnwُʿعِbَّtَy","root":"تبع"},{"id":9,"arabic":"ٱلشَّهَوَٰتِ","translit":"ِtَٰwَhَّhslٱ","root":"شهو"},{"id":10,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":11,"arabic":"تَمِيلُوا۟","translit":"۟āwُlyِmَt","root":"ميل"},{"id":12,"arabic":"مَيْلًا","translit":"āًlْyَm","root":"ميل"},{"id":13,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":28,"text":"يُرِيدُ ٱللَّهُ أَن يُخَفِّفَ عَنكُمْۚ وَخُلِقَ ٱلْإِنسَٰنُ ضَعِيفًا ","translation":"And Allāh wants to lighten for you [your difficulties]; and mankind was created weak.","words":[{"id":1,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"يُخَفِّفَ","translit":"َfِّfَhkُy","root":"خفف"},{"id":5,"arabic":"عَنكُمْ","translit":"ْmُknَʿع","root":""},{"id":6,"arabic":"وَخُلِقَ","translit":"َqِlُhkَw","root":"خلق"},{"id":7,"arabic":"ٱلْإِنسَٰنُ","translit":"ُnَٰsnِiʾْlٱ","root":"انس"},{"id":8,"arabic":"ضَعِيفًا","translit":"āًfyِʿعَḍ","root":"ضعف"}],"hasIhya":false},{"ayah":29,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَأْكُلُوٓا۟ أَمْوَٰلَكُم بَيْنَكُم بِٱلْبَٰطِلِ إِلَّآ أَن تَكُونَ تِجَٰرَةً عَن تَرَاضٍ مِّنكُمْۚ وَلَا تَقْتُلُوٓا۟ أَنفُسَكُمْۚ إِنَّ ٱللَّهَ كَانَ بِكُمْ رَحِيمًا ","translation":"O you who have believed, do not consume one another's wealth unjustly[1] but only [in lawful] business by mutual consent. And do not kill yourselves [or one another]. Indeed, Allāh is to you ever Merciful.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَأْكُلُوٓا۟","translit":"۟āٓwُlُkْaʾَt","root":"اكل"},{"id":6,"arabic":"أَمْوَٰلَكُم","translit":"mُkَlَٰwْmَaʾ","root":"مول"},{"id":7,"arabic":"بَيْنَكُم","translit":"mُkَnْyَb","root":"بين"},{"id":8,"arabic":"بِٱلْبَٰطِلِ","translit":"ِlِṭَٰbْlٱِb","root":"بطل"},{"id":9,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":10,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":11,"arabic":"تَكُونَ","translit":"َnwُkَt","root":"كون"},{"id":12,"arabic":"تِجَٰرَةً","translit":"ًẗَrَٰjgِt","root":"تجر"},{"id":13,"arabic":"عَن","translit":"nَʿع","root":""},{"id":14,"arabic":"تَرَاضٍ","translit":"ٍḍāَrَt","root":"رضو"},{"id":15,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":16,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":17,"arabic":"تَقْتُلُوٓا۟","translit":"۟āٓwُlُtْqَt","root":"قتل"},{"id":18,"arabic":"أَنفُسَكُمْ","translit":"ْmُkَsُfnَaʾ","root":"نفس"},{"id":19,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":20,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":21,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":22,"arabic":"بِكُمْ","translit":"ْmُkِb","root":""},{"id":23,"arabic":"رَحِيمًا","translit":"āًmyِḥَr","root":"رحم"}],"hasIhya":true},{"ayah":30,"text":"وَمَن يَفْعَلْ ذَٰلِكَ عُدْوَٰنًا وَظُلْمًا فَسَوْفَ نُصْلِيهِ نَارًاۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرًا ","translation":"And whoever does that in aggression and injustice - then We will drive him into a Fire. And that, for Allāh, is [always] easy.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَفْعَلْ","translit":"ْlَʿعْfَy","root":"فعل"},{"id":3,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":4,"arabic":"عُدْوَٰنًا","translit":"āًnَٰwْdُʿع","root":"عدو"},{"id":5,"arabic":"وَظُلْمًا","translit":"āًmْlُẓَw","root":"ظلم"},{"id":6,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":7,"arabic":"نُصْلِيهِ","translit":"ِhyِlْṣُn","root":"صلي"},{"id":8,"arabic":"نَارًا","translit":"āًrāَn","root":"نور"},{"id":9,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":10,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":11,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"يَسِيرًا","translit":"āًryِsَy","root":"يسر"}],"hasIhya":false},{"ayah":31,"text":"إِن تَجْتَنِبُوا۟ كَبَآئِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنكُمْ سَيِّـَٔاتِكُمْ وَنُدْخِلْكُم مُّدْخَلًا كَرِيمًا ","translation":"If you avoid the major sins which you are forbidden, We will remove from you your lesser sins and admit you to a noble entrance [into Paradise].","words":[{"id":1,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":2,"arabic":"تَجْتَنِبُوا۟","translit":"۟āwُbِnَtْjgَt","root":"جنب"},{"id":3,"arabic":"كَبَآئِرَ","translit":"َrِyʾٓāَbَk","root":"كبر"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"تُنْهَوْنَ","translit":"َnْwَhْnُt","root":"نهي"},{"id":6,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":7,"arabic":"نُكَفِّرْ","translit":"ْrِّfَkُn","root":"كفر"},{"id":8,"arabic":"عَنكُمْ","translit":"ْmُknَʿع","root":""},{"id":9,"arabic":"سَيِّـَٔاتِكُمْ","translit":"ْmُkِtāَٔـِّyَs","root":"سوا"},{"id":10,"arabic":"وَنُدْخِلْكُم","translit":"mُkْlِhkْdُnَw","root":"دخل"},{"id":11,"arabic":"مُّدْخَلًا","translit":"āًlَhkْdُّm","root":"دخل"},{"id":12,"arabic":"كَرِيمًا","translit":"āًmyِrَk","root":"كرم"}],"hasIhya":false},{"ayah":32,"text":"وَلَا تَتَمَنَّوْا۟ مَا فَضَّلَ ٱللَّهُ بِهِۦ بَعْضَكُمْ عَلَىٰ بَعْضٍۚ لِّلرِّجَالِ نَصِيبٌ مِّمَّا ٱكْتَسَبُوا۟ۖ وَلِلنِّسَآءِ نَصِيبٌ مِّمَّا ٱكْتَسَبْنَۚ وَسْـَٔلُوا۟ ٱللَّهَ مِن فَضْلِهِۦٓۗ إِنَّ ٱللَّهَ كَانَ بِكُلِّ شَىْءٍ عَلِيمًا ","translation":"And do not wish for that by which Allāh has made some of you exceed others. For men is a share of what they have earned, and for women is a share of[1] what they have earned. And ask Allāh of His bounty. Indeed Allāh is ever, of all things, Knowing.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَتَمَنَّوْا۟","translit":"۟āْwَّnَmَtَt","root":"مني"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"فَضَّلَ","translit":"َlَّḍَf","root":"فضل"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":7,"arabic":"بَعْضَكُمْ","translit":"ْmُkَḍْʿعَb","root":"بعض"},{"id":8,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":9,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":10,"arabic":"لِّلرِّجَالِ","translit":"ِlāَjgِّrlِّl","root":"رجل"},{"id":11,"arabic":"نَصِيبٌ","translit":"ٌbyِṣَn","root":"نصب"},{"id":12,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":13,"arabic":"ٱكْتَسَبُوا۟","translit":"۟āwُbَsَtْkٱ","root":"كسب"},{"id":14,"arabic":"وَلِلنِّسَآءِ","translit":"ِءٓāَsِّnlِlَw","root":"نسو"},{"id":15,"arabic":"نَصِيبٌ","translit":"ٌbyِṣَn","root":"نصب"},{"id":16,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":17,"arabic":"ٱكْتَسَبْنَ","translit":"َnْbَsَtْkٱ","root":"كسب"},{"id":18,"arabic":"وَسْـَٔلُوا۟","translit":"۟āwُlَٔـْsَw","root":"سال"},{"id":19,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":20,"arabic":"مِن","translit":"nِm","root":""},{"id":21,"arabic":"فَضْلِهِۦٓ","translit":"ٓۦِhِlْḍَf","root":"فضل"},{"id":22,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":23,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":24,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":25,"arabic":"بِكُلِّ","translit":"ِّlُkِb","root":"كلل"},{"id":26,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":27,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":33,"text":"وَلِكُلٍّ جَعَلْنَا مَوَٰلِىَ مِمَّا تَرَكَ ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَۚ وَٱلَّذِينَ عَقَدَتْ أَيْمَٰنُكُمْ فَـَٔاتُوهُمْ نَصِيبَهُمْۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَىْءٍ شَهِيدًا ","translation":"And for all, We have made heirs to what is left by parents and relatives. And to those whom your oaths have bound [to you] - give them their share.[1] Indeed Allāh is ever, over all things, a Witness.","words":[{"id":1,"arabic":"وَلِكُلٍّ","translit":"ٍّlُkِlَw","root":"كلل"},{"id":2,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":3,"arabic":"مَوَٰلِىَ","translit":"َàِlَٰwَm","root":"ولي"},{"id":4,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":5,"arabic":"تَرَكَ","translit":"َkَrَt","root":"ترك"},{"id":6,"arabic":"ٱلْوَٰلِدَانِ","translit":"ِnāَdِlَٰwْlٱ","root":"ولد"},{"id":7,"arabic":"وَٱلْأَقْرَبُونَ","translit":"َnwُbَrْqَaʾْlٱَw","root":"قرب"},{"id":8,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":9,"arabic":"عَقَدَتْ","translit":"ْtَdَqَʿع","root":"عقد"},{"id":10,"arabic":"أَيْمَٰنُكُمْ","translit":"ْmُkُnَٰmْyَaʾ","root":"يمن"},{"id":11,"arabic":"فَـَٔاتُوهُمْ","translit":"ْmُhwُtāَٔـَf","root":"اتي"},{"id":12,"arabic":"نَصِيبَهُمْ","translit":"ْmُhَbyِṣَn","root":"نصب"},{"id":13,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":14,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":15,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":16,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":17,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":18,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":19,"arabic":"شَهِيدًا","translit":"āًdyِhَhs","root":"شهد"}],"hasIhya":false},{"ayah":34,"text":"ٱلرِّجَالُ قَوَّٰمُونَ عَلَى ٱلنِّسَآءِ بِمَا فَضَّلَ ٱللَّهُ بَعْضَهُمْ عَلَىٰ بَعْضٍ وَبِمَآ أَنفَقُوا۟ مِنْ أَمْوَٰلِهِمْۚ فَٱلصَّٰلِحَٰتُ قَٰنِتَٰتٌ حَٰفِظَٰتٌ لِّلْغَيْبِ بِمَا حَفِظَ ٱللَّهُۚ وَٱلَّٰتِى تَخَافُونَ نُشُوزَهُنَّ فَعِظُوهُنَّ وَٱهْجُرُوهُنَّ فِى ٱلْمَضَاجِعِ وَٱضْرِبُوهُنَّۖ فَإِنْ أَطَعْنَكُمْ فَلَا تَبْغُوا۟ عَلَيْهِنَّ سَبِيلًاۗ إِنَّ ٱللَّهَ كَانَ عَلِيًّا كَبِيرًا ","translation":"Men are in charge of women[1] by [right of] what Allāh has given one over the other and what they spend [for maintenance] from their wealth. So righteous women are devoutly obedient, guarding in [the husband's] absence what Allāh would have them guard.[2] But those [wives] from whom you fear arrogance[3] - [first] advise them; [then if they persist], forsake them in bed; and [finally], strike them [lightly].[4] But if they obey you [once more], seek no means against them. Indeed, Allāh is ever Exalted and Grand.","words":[{"id":1,"arabic":"ٱلرِّجَالُ","translit":"ُlāَjgِّrlٱ","root":"رجل"},{"id":2,"arabic":"قَوَّٰمُونَ","translit":"َnwُmَّٰwَq","root":"قوم"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱ","root":"نسو"},{"id":5,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":6,"arabic":"فَضَّلَ","translit":"َlَّḍَf","root":"فضل"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"بَعْضَهُمْ","translit":"ْmُhَḍْʿعَb","root":"بعض"},{"id":9,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":10,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":11,"arabic":"وَبِمَآ","translit":"ٓāَmِbَw","root":""},{"id":12,"arabic":"أَنفَقُوا۟","translit":"۟āwُqَfnَaʾ","root":"نفق"},{"id":13,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":14,"arabic":"أَمْوَٰلِهِمْ","translit":"ْmِhِlَٰwْmَaʾ","root":"مول"},{"id":15,"arabic":"فَٱلصَّٰلِحَٰتُ","translit":"ُtَٰḥِlَّٰṣlٱَf","root":"صلح"},{"id":16,"arabic":"قَٰنِتَٰتٌ","translit":"ٌtَٰtِnَٰq","root":"قنت"},{"id":17,"arabic":"حَٰفِظَٰتٌ","translit":"ٌtَٰẓِfَٰḥ","root":"حفظ"},{"id":18,"arabic":"لِّلْغَيْبِ","translit":"ِbْyَغْlِّl","root":"غيب"},{"id":19,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":20,"arabic":"حَفِظَ","translit":"َẓِfَḥ","root":"حفظ"},{"id":21,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":22,"arabic":"وَٱلَّٰتِى","translit":"àِtَّٰlٱَw","root":""},{"id":23,"arabic":"تَخَافُونَ","translit":"َnwُfāَhkَt","root":"خوف"},{"id":24,"arabic":"نُشُوزَهُنَّ","translit":"َّnُhَzwُhsُn","root":"نشز"},{"id":25,"arabic":"فَعِظُوهُنَّ","translit":"َّnُhwُẓِʿعَf","root":"وعظ"},{"id":26,"arabic":"وَٱهْجُرُوهُنَّ","translit":"َّnُhwُrُjgْhٱَw","root":"هجر"},{"id":27,"arabic":"فِى","translit":"àِf","root":""},{"id":28,"arabic":"ٱلْمَضَاجِعِ","translit":"ِʿعِjgāَḍَmْlٱ","root":"ضجع"},{"id":29,"arabic":"وَٱضْرِبُوهُنَّ","translit":"َّnُhwُbِrْḍٱَw","root":"ضرب"},{"id":30,"arabic":"فَإِنْ","translit":"ْnِiʾَf","root":""},{"id":31,"arabic":"أَطَعْنَكُمْ","translit":"ْmُkَnْʿعَṭَaʾ","root":"طوع"},{"id":32,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":33,"arabic":"تَبْغُوا۟","translit":"۟āwُغْbَt","root":"بغي"},{"id":34,"arabic":"عَلَيْهِنَّ","translit":"َّnِhْyَlَʿع","root":""},{"id":35,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"},{"id":36,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":37,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":38,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":39,"arabic":"عَلِيًّا","translit":"āًّyِlَʿع","root":"علو"},{"id":40,"arabic":"كَبِيرًا","translit":"āًryِbَk","root":"كبر"}],"hasIhya":true},{"ayah":35,"text":"وَإِنْ خِفْتُمْ شِقَاقَ بَيْنِهِمَا فَٱبْعَثُوا۟ حَكَمًا مِّنْ أَهْلِهِۦ وَحَكَمًا مِّنْ أَهْلِهَآ إِن يُرِيدَآ إِصْلَٰحًا يُوَفِّقِ ٱللَّهُ بَيْنَهُمَآۗ إِنَّ ٱللَّهَ كَانَ عَلِيمًا خَبِيرًا ","translation":"And if you fear dissension between the two, send an arbitrator from his people and an arbitrator from her people. If they both desire reconciliation, Allāh will cause it between them. Indeed, Allāh is ever Knowing and Aware.","words":[{"id":1,"arabic":"وَإِنْ","translit":"ْnِiʾَw","root":""},{"id":2,"arabic":"خِفْتُمْ","translit":"ْmُtْfِhk","root":"خوف"},{"id":3,"arabic":"شِقَاقَ","translit":"َqāَqِhs","root":"شقق"},{"id":4,"arabic":"بَيْنِهِمَا","translit":"āَmِhِnْyَb","root":"بين"},{"id":5,"arabic":"فَٱبْعَثُوا۟","translit":"۟āwُhtَʿعْbٱَf","root":"بعث"},{"id":6,"arabic":"حَكَمًا","translit":"āًmَkَḥ","root":"حكم"},{"id":7,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":8,"arabic":"أَهْلِهِۦ","translit":"ۦِhِlْhَaʾ","root":"اهل"},{"id":9,"arabic":"وَحَكَمًا","translit":"āًmَkَḥَw","root":"حكم"},{"id":10,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":11,"arabic":"أَهْلِهَآ","translit":"ٓāَhِlْhَaʾ","root":"اهل"},{"id":12,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":13,"arabic":"يُرِيدَآ","translit":"ٓāَdyِrُy","root":"رود"},{"id":14,"arabic":"إِصْلَٰحًا","translit":"āًḥَٰlْṣِiʾ","root":"صلح"},{"id":15,"arabic":"يُوَفِّقِ","translit":"ِqِّfَwُy","root":"وفق"},{"id":16,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":17,"arabic":"بَيْنَهُمَآ","translit":"ٓāَmُhَnْyَb","root":"بين"},{"id":18,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":19,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":20,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":21,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"},{"id":22,"arabic":"خَبِيرًا","translit":"āًryِbَhk","root":"خبر"}],"hasIhya":true},{"ayah":36,"text":"وَٱعْبُدُوا۟ ٱللَّهَ وَلَا تُشْرِكُوا۟ بِهِۦ شَيْـًٔاۖ وَبِٱلْوَٰلِدَيْنِ إِحْسَٰنًا وَبِذِى ٱلْقُرْبَىٰ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينِ وَٱلْجَارِ ذِى ٱلْقُرْبَىٰ وَٱلْجَارِ ٱلْجُنُبِ وَٱلصَّاحِبِ بِٱلْجَنۢبِ وَٱبْنِ ٱلسَّبِيلِ وَمَا مَلَكَتْ أَيْمَٰنُكُمْۗ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ مُخْتَالًا فَخُورًا ","translation":"Worship Allāh and associate nothing with Him, and to parents do good, and to relatives, orphans, the needy, the near neighbor, the neighbor farther away, the companion at your side,[1] the traveler, and those whom your right hands possess. Indeed, Allāh does not like those who are self-deluding and boastful,","words":[{"id":1,"arabic":"وَٱعْبُدُوا۟","translit":"۟āwُdُbْʿعٱَw","root":"عبد"},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":4,"arabic":"تُشْرِكُوا۟","translit":"۟āwُkِrْhsُt","root":"شرك"},{"id":5,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":6,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":7,"arabic":"وَبِٱلْوَٰلِدَيْنِ","translit":"ِnْyَdِlَٰwْlٱِbَw","root":"ولد"},{"id":8,"arabic":"إِحْسَٰنًا","translit":"āًnَٰsْḥِiʾ","root":"حسن"},{"id":9,"arabic":"وَبِذِى","translit":"àِhdِbَw","root":""},{"id":10,"arabic":"ٱلْقُرْبَىٰ","translit":"ٰàَbْrُqْlٱ","root":"قرب"},{"id":11,"arabic":"وَٱلْيَتَٰمَىٰ","translit":"ٰàَmَٰtَyْlٱَw","root":"يتم"},{"id":12,"arabic":"وَٱلْمَسَٰكِينِ","translit":"ِnyِkَٰsَmْlٱَw","root":"سكن"},{"id":13,"arabic":"وَٱلْجَارِ","translit":"ِrāَjgْlٱَw","root":"جور"},{"id":14,"arabic":"ذِى","translit":"àِhd","root":""},{"id":15,"arabic":"ٱلْقُرْبَىٰ","translit":"ٰàَbْrُqْlٱ","root":"قرب"},{"id":16,"arabic":"وَٱلْجَارِ","translit":"ِrāَjgْlٱَw","root":"جور"},{"id":17,"arabic":"ٱلْجُنُبِ","translit":"ِbُnُjgْlٱ","root":"جنب"},{"id":18,"arabic":"وَٱلصَّاحِبِ","translit":"ِbِḥāَّṣlٱَw","root":"صحب"},{"id":19,"arabic":"بِٱلْجَنۢبِ","translit":"ِbۢnَjgْlٱِb","root":"جنب"},{"id":20,"arabic":"وَٱبْنِ","translit":"ِnْbٱَw","root":"بني"},{"id":21,"arabic":"ٱلسَّبِيلِ","translit":"ِlyِbَّslٱ","root":"سبل"},{"id":22,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":23,"arabic":"مَلَكَتْ","translit":"ْtَkَlَm","root":"ملك"},{"id":24,"arabic":"أَيْمَٰنُكُمْ","translit":"ْmُkُnَٰmْyَaʾ","root":"يمن"},{"id":25,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":26,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":27,"arabic":"لَا","translit":"āَl","root":""},{"id":28,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":29,"arabic":"مَن","translit":"nَm","root":""},{"id":30,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":31,"arabic":"مُخْتَالًا","translit":"āًlāَtْhkُm","root":"خيل"},{"id":32,"arabic":"فَخُورًا","translit":"āًrwُhkَf","root":"فخر"}],"hasIhya":true},{"ayah":37,"text":"ٱلَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِ وَيَكْتُمُونَ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦۗ وَأَعْتَدْنَا لِلْكَٰفِرِينَ عَذَابًا مُّهِينًا ","translation":"Who are stingy and enjoin upon [other] people stinginess and conceal what Allāh has given them of His bounty - and We have prepared for the disbelievers a humiliating punishment -","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"يَبْخَلُونَ","translit":"َnwُlَhkْbَy","root":"بخل"},{"id":3,"arabic":"وَيَأْمُرُونَ","translit":"َnwُrُmْaʾَyَw","root":"امر"},{"id":4,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":5,"arabic":"بِٱلْبُخْلِ","translit":"ِlْhkُbْlٱِb","root":"بخل"},{"id":6,"arabic":"وَيَكْتُمُونَ","translit":"َnwُmُtْkَyَw","root":"كتم"},{"id":7,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":8,"arabic":"ءَاتَىٰهُمُ","translit":"ُmُhٰàَtāَء","root":"اتي"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"فَضْلِهِۦ","translit":"ۦِhِlْḍَf","root":"فضل"},{"id":12,"arabic":"وَأَعْتَدْنَا","translit":"āَnْdَtْʿعَaʾَw","root":"عتد"},{"id":13,"arabic":"لِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِl","root":"كفر"},{"id":14,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":15,"arabic":"مُّهِينًا","translit":"āًnyِhُّm","root":"هون"}],"hasIhya":true},{"ayah":38,"text":"وَٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمْ رِئَآءَ ٱلنَّاسِ وَلَا يُؤْمِنُونَ بِٱللَّهِ وَلَا بِٱلْيَوْمِ ٱلْءَاخِرِۗ وَمَن يَكُنِ ٱلشَّيْطَٰنُ لَهُۥ قَرِينًا فَسَآءَ قَرِينًا ","translation":"And [also] those who spend of their wealth to be seen by the people and believe not in Allāh nor in the Last Day. And he to whom Satan is a companion - then evil is he as a companion.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"يُنفِقُونَ","translit":"َnwُqِfnُy","root":"نفق"},{"id":3,"arabic":"أَمْوَٰلَهُمْ","translit":"ْmُhَlَٰwْmَaʾ","root":"مول"},{"id":4,"arabic":"رِئَآءَ","translit":"َءٓāَyʾِr","root":"راي"},{"id":5,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":8,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"بِٱلْيَوْمِ","translit":"ِmْwَyْlٱِb","root":"يوم"},{"id":11,"arabic":"ٱلْءَاخِرِ","translit":"ِrِhkāَءْlٱ","root":"اخر"},{"id":12,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":13,"arabic":"يَكُنِ","translit":"ِnُkَy","root":"كون"},{"id":14,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":15,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":16,"arabic":"قَرِينًا","translit":"āًnyِrَq","root":"قرن"},{"id":17,"arabic":"فَسَآءَ","translit":"َءٓāَsَf","root":"سوا"},{"id":18,"arabic":"قَرِينًا","translit":"āًnyِrَq","root":"قرن"}],"hasIhya":false},{"ayah":39,"text":"وَمَاذَا عَلَيْهِمْ لَوْ ءَامَنُوا۟ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَأَنفَقُوا۟ مِمَّا رَزَقَهُمُ ٱللَّهُۚ وَكَانَ ٱللَّهُ بِهِمْ عَلِيمًا ","translation":"And what [harm would come] upon them if they believed in Allāh and the Last Day and spent out of what Allāh provided for them? And Allāh is ever, about them, Knowing.","words":[{"id":1,"arabic":"وَمَاذَا","translit":"āَhdāَmَw","root":""},{"id":2,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":3,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":4,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":5,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":6,"arabic":"وَٱلْيَوْمِ","translit":"ِmْwَyْlٱَw","root":"يوم"},{"id":7,"arabic":"ٱلْءَاخِرِ","translit":"ِrِhkāَءْlٱ","root":"اخر"},{"id":8,"arabic":"وَأَنفَقُوا۟","translit":"۟āwُqَfnَaʾَw","root":"نفق"},{"id":9,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":10,"arabic":"رَزَقَهُمُ","translit":"ُmُhَqَzَr","root":"رزق"},{"id":11,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":12,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"بِهِمْ","translit":"ْmِhِb","root":""},{"id":15,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":40,"text":"إِنَّ ٱللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍۖ وَإِن تَكُ حَسَنَةً يُضَٰعِفْهَا وَيُؤْتِ مِن لَّدُنْهُ أَجْرًا عَظِيمًا ","translation":"Indeed, Allāh does not do injustice, [even] as much as an atom's weight; while if there is a good deed, He multiplies it and gives from Himself a great reward.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يَظْلِمُ","translit":"ُmِlْẓَy","root":"ظلم"},{"id":5,"arabic":"مِثْقَالَ","translit":"َlāَqْhtِm","root":"ثقل"},{"id":6,"arabic":"ذَرَّةٍ","translit":"ٍẗَّrَhd","root":"ذرر"},{"id":7,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":8,"arabic":"تَكُ","translit":"ُkَt","root":"كون"},{"id":9,"arabic":"حَسَنَةً","translit":"ًẗَnَsَḥ","root":"حسن"},{"id":10,"arabic":"يُضَٰعِفْهَا","translit":"āَhْfِʿعَٰḍُy","root":"ضعف"},{"id":11,"arabic":"وَيُؤْتِ","translit":"ِtْwʾُyَw","root":"اتي"},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"لَّدُنْهُ","translit":"ُhْnُdَّl","root":"لدن"},{"id":14,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":15,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":41,"text":"فَكَيْفَ إِذَا جِئْنَا مِن كُلِّ أُمَّةٍۭ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَىٰ هَٰٓؤُلَآءِ شَهِيدًا ","translation":"So how [will it be] when We bring from every nation a witness and We bring you, [O Muḥammad], against these [people] as a witness?","words":[{"id":1,"arabic":"فَكَيْفَ","translit":"َfْyَkَf","root":"كيف"},{"id":2,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":3,"arabic":"جِئْنَا","translit":"āَnْyʾِjg","root":"جيا"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":6,"arabic":"أُمَّةٍۭ","translit":"ٍۭẗَّmُaʾ","root":"امم"},{"id":7,"arabic":"بِشَهِيدٍ","translit":"ٍdyِhَhsِb","root":"شهد"},{"id":8,"arabic":"وَجِئْنَا","translit":"āَnْyʾِjgَw","root":"جيا"},{"id":9,"arabic":"بِكَ","translit":"َkِb","root":""},{"id":10,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":11,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":12,"arabic":"شَهِيدًا","translit":"āًdyِhَhs","root":"شهد"}],"hasIhya":true},{"ayah":42,"text":"يَوْمَئِذٍ يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ وَعَصَوُا۟ ٱلرَّسُولَ لَوْ تُسَوَّىٰ بِهِمُ ٱلْأَرْضُ وَلَا يَكْتُمُونَ ٱللَّهَ حَدِيثًا ","translation":"That Day, those who disbelieved and disobeyed the Messenger will wish they could be covered by the earth. And they will not conceal from Allāh a [single] statement.","words":[{"id":1,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":2,"arabic":"يَوَدُّ","translit":"ُّdَwَy","root":"ودد"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":5,"arabic":"وَعَصَوُا۟","translit":"۟āُwَṣَʿعَw","root":"عصي"},{"id":6,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":7,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":8,"arabic":"تُسَوَّىٰ","translit":"ٰàَّwَsُt","root":"سوي"},{"id":9,"arabic":"بِهِمُ","translit":"ُmِhِb","root":""},{"id":10,"arabic":"ٱلْأَرْضُ","translit":"ُḍْrَaʾْlٱ","root":"ارض"},{"id":11,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":12,"arabic":"يَكْتُمُونَ","translit":"َnwُmُtْkَy","root":"كتم"},{"id":13,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":14,"arabic":"حَدِيثًا","translit":"āًhtyِdَḥ","root":"حدث"}],"hasIhya":false},{"ayah":43,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَقْرَبُوا۟ ٱلصَّلَوٰةَ وَأَنتُمْ سُكَٰرَىٰ حَتَّىٰ تَعْلَمُوا۟ مَا تَقُولُونَ وَلَا جُنُبًا إِلَّا عَابِرِى سَبِيلٍ حَتَّىٰ تَغْتَسِلُوا۟ۚ وَإِن كُنتُم مَّرْضَىٰٓ أَوْ عَلَىٰ سَفَرٍ أَوْ جَآءَ أَحَدٌ مِّنكُم مِّنَ ٱلْغَآئِطِ أَوْ لَٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟ مَآءً فَتَيَمَّمُوا۟ صَعِيدًا طَيِّبًا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُمْۗ إِنَّ ٱللَّهَ كَانَ عَفُوًّا غَفُورًا ","translation":"O you who have believed, do not approach prayer while you are intoxicated until you know what you are saying[1] or in a state of janābah,[2] except those passing through [a place of prayer], until you have washed [your whole body]. And if you are ill or on a journey or one of you comes from the place of relieving himself or you have contacted women [i.e., had sexual intercourse] and find no water, then seek clean earth and wipe over your faces and your hands [with it]. Indeed, Allāh is ever Pardoning[3] and Forgiving.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَقْرَبُوا۟","translit":"۟āwُbَrْqَt","root":"قرب"},{"id":6,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":7,"arabic":"وَأَنتُمْ","translit":"ْmُtnَaʾَw","root":""},{"id":8,"arabic":"سُكَٰرَىٰ","translit":"ٰàَrَٰkُs","root":"سكر"},{"id":9,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":10,"arabic":"تَعْلَمُوا۟","translit":"۟āwُmَlْʿعَt","root":"علم"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"تَقُولُونَ","translit":"َnwُlwُqَt","root":"قول"},{"id":13,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":14,"arabic":"جُنُبًا","translit":"āًbُnُjg","root":"جنب"},{"id":15,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":16,"arabic":"عَابِرِى","translit":"àِrِbāَʿع","root":"عبر"},{"id":17,"arabic":"سَبِيلٍ","translit":"ٍlyِbَs","root":"سبل"},{"id":18,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":19,"arabic":"تَغْتَسِلُوا۟","translit":"۟āwُlِsَtْغَt","root":"غسل"},{"id":20,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":21,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":22,"arabic":"مَّرْضَىٰٓ","translit":"ٰٓàَḍْrَّm","root":"مرض"},{"id":23,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":24,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":25,"arabic":"سَفَرٍ","translit":"ٍrَfَs","root":"سفر"},{"id":26,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":27,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":28,"arabic":"أَحَدٌ","translit":"ٌdَḥَaʾ","root":"احد"},{"id":29,"arabic":"مِّنكُم","translit":"mُknِّm","root":""},{"id":30,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":31,"arabic":"ٱلْغَآئِطِ","translit":"ِṭِyʾٓāَغْlٱ","root":"غو