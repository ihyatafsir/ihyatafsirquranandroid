{"surah": 4, "verses": [{"ayah": 1, "text": "يَٰٓأَيُّهَا ٱلنَّاسُ ٱتَّقُوا۟ رَبَّكُمُ ٱلَّذِى خَلَقَكُم مِّن نَّفْسٍ وَٰحِدَةٍ وَخَلَقَ مِنْهَا زَوْجَهَا وَبَثَّ مِنْهُمَا رِجَالًا كَثِيرًا وَنِسَآءًۚ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِى تَسَآءَلُونَ بِهِۦ وَٱلْأَرْحَامَۚ إِنَّ ٱللَّهَ كَانَ عَلَيْكُمْ رَقِيبًا ", "translation": "O mankind, fear your Lord, who created you from one soul and created from it its mate and dispersed from both of them many men and women. And fear Allāh, through whom[1] you ask one another,[2] and the wombs.[3] Indeed Allāh is ever,[4] over you, an Observer.[5]", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 4, "arabic": "رَبَّكُمُ", "translit": "ُmُkَّbَr", "root": "ربب"}, {"id": 5, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "خَلَقَكُم", "translit": "mُkَqَlَhk", "root": "خلق"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "نَّفْسٍ", "translit": "ٍsْfَّn", "root": "نفس"}, {"id": 9, "arabic": "وَٰحِدَةٍ", "translit": "ٍẗَdِḥَٰw", "root": "وحد"}, {"id": 10, "arabic": "وَخَلَقَ", "translit": "َqَlَhkَw", "root": "خلق"}, {"id": 11, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 12, "arabic": "زَوْجَهَا", "translit": "āَhَjgْwَz", "root": "زوج"}, {"id": 13, "arabic": "وَبَثَّ", "translit": "َّhtَbَw", "root": "بثث"}, {"id": 14, "arabic": "مِنْهُمَا", "translit": "āَmُhْnِm", "root": ""}, {"id": 15, "arabic": "رِجَالًا", "translit": "āًlāَjgِr", "root": "رجل"}, {"id": 16, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 17, "arabic": "وَنِسَآءً", "translit": "ًءٓāَsِnَw", "root": "نسو"}, {"id": 18, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 21, "arabic": "تَسَآءَلُونَ", "translit": "َnwُlَءٓāَsَt", "root": "سال"}, {"id": 22, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 23, "arabic": "وَٱلْأَرْحَامَ", "translit": "َmāَḥْrَaʾْlٱَw", "root": "رحم"}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 27, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 28, "arabic": "رَقِيبًا", "translit": "āًbyِqَr", "root": "رقب"}], "hasIhya": true}, {"ayah": 2, "text": "وَءَاتُوا۟ ٱلْيَتَٰمَىٰٓ أَمْوَٰلَهُمْۖ وَلَا تَتَبَدَّلُوا۟ ٱلْخَبِيثَ بِٱلطَّيِّبِۖ وَلَا تَأْكُلُوٓا۟ أَمْوَٰلَهُمْ إِلَىٰٓ أَمْوَٰلِكُمْۚ إِنَّهُۥ كَانَ حُوبًا كَبِيرًا ", "translation": "And give to the orphans their properties and do not substitute the defective [of your own] for the good [of theirs]. And do not consume their properties into your own. Indeed, that is ever a great sin.", "words": [{"id": 1, "arabic": "وَءَاتُوا۟", "translit": "۟āwُtāَءَw", "root": "اتي"}, {"id": 2, "arabic": "ٱلْيَتَٰمَىٰٓ", "translit": "ٰٓàَmَٰtَyْlٱ", "root": "يتم"}, {"id": 3, "arabic": "أَمْوَٰلَهُمْ", "translit": "ْmُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "تَتَبَدَّلُوا۟", "translit": "۟āwُlَّdَbَtَt", "root": "بدل"}, {"id": 6, "arabic": "ٱلْخَبِيثَ", "translit": "َhtyِbَhkْlٱ", "root": "خبث"}, {"id": 7, "arabic": "بِٱلطَّيِّبِ", "translit": "ِbِّyَّṭlٱِb", "root": "طيب"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "تَأْكُلُوٓا۟", "translit": "۟āٓwُlُkْaʾَt", "root": "اكل"}, {"id": 10, "arabic": "أَمْوَٰلَهُمْ", "translit": "ْmُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 11, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 12, "arabic": "أَمْوَٰلِكُمْ", "translit": "ْmُkِlَٰwْmَaʾ", "root": "مول"}, {"id": 13, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 14, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 15, "arabic": "حُوبًا", "translit": "āًbwُḥ", "root": "حوب"}, {"id": 16, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 3, "text": "وَإِنْ خِفْتُمْ أَلَّا تُقْسِطُوا۟ فِى ٱلْيَتَٰمَىٰ فَٱنكِحُوا۟ مَا طَابَ لَكُم مِّنَ ٱلنِّسَآءِ مَثْنَىٰ وَثُلَٰثَ وَرُبَٰعَۖ فَإِنْ خِفْتُمْ أَلَّا تَعْدِلُوا۟ فَوَٰحِدَةً أَوْ مَا مَلَكَتْ أَيْمَٰنُكُمْۚ ذَٰلِكَ أَدْنَىٰٓ أَلَّا تَعُولُوا۟ ", "translation": "And if you fear that you will not deal justly with the orphan girls, then marry those that please you of [other] women, two or three or four. But if you fear that you will not be just, then [marry only] one or those your right hands possess [i.e., slaves]. That is more suitable that you may not incline [to injustice].", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 2, "arabic": "خِفْتُمْ", "translit": "ْmُtْfِhk", "root": "خوف"}, {"id": 3, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 4, "arabic": "تُقْسِطُوا۟", "translit": "۟āwُṭِsْqُt", "root": "قسط"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱ", "root": "يتم"}, {"id": 7, "arabic": "فَٱنكِحُوا۟", "translit": "۟āwُḥِknٱَf", "root": "نكح"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "طَابَ", "translit": "َbāَṭ", "root": "طيب"}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 12, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 13, "arabic": "مَثْنَىٰ", "translit": "ٰàَnْhtَm", "root": "ثني"}, {"id": 14, "arabic": "وَثُلَٰثَ", "translit": "َhtَٰlُhtَw", "root": "ثلث"}, {"id": 15, "arabic": "وَرُبَٰعَ", "translit": "َʿعَٰbُrَw", "root": "ربع"}, {"id": 16, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 17, "arabic": "خِفْتُمْ", "translit": "ْmُtْfِhk", "root": "خوف"}, {"id": 18, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 19, "arabic": "تَعْدِلُوا۟", "translit": "۟āwُlِdْʿعَt", "root": "عدل"}, {"id": 20, "arabic": "فَوَٰحِدَةً", "translit": "ًẗَdِḥَٰwَf", "root": "وحد"}, {"id": 21, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 22, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 23, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 24, "arabic": "أَيْمَٰنُكُمْ", "translit": "ْmُkُnَٰmْyَaʾ", "root": "يمن"}, {"id": 25, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 26, "arabic": "أَدْنَىٰٓ", "translit": "ٰٓàَnْdَaʾ", "root": "دنو"}, {"id": 27, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 28, "arabic": "تَعُولُوا۟", "translit": "۟āwُlwُʿعَt", "root": "عول"}], "hasIhya": false}, {"ayah": 4, "text": "وَءَاتُوا۟ ٱلنِّسَآءَ صَدُقَٰتِهِنَّ نِحْلَةًۚ فَإِن طِبْنَ لَكُمْ عَن شَىْءٍ مِّنْهُ نَفْسًا فَكُلُوهُ هَنِيٓـًٔا مَّرِيٓـًٔا ", "translation": "And give the women [upon marriage] their [bridal] gifts[1] graciously. But if they give up willingly to you anything of it, then take it in satisfaction and ease.[2]", "words": [{"id": 1, "arabic": "وَءَاتُوا۟", "translit": "۟āwُtāَءَw", "root": "اتي"}, {"id": 2, "arabic": "ٱلنِّسَآءَ", "translit": "َءٓāَsِّnlٱ", "root": "نسو"}, {"id": 3, "arabic": "صَدُقَٰتِهِنَّ", "translit": "َّnِhِtَٰqُdَṣ", "root": "صدق"}, {"id": 4, "arabic": "نِحْلَةً", "translit": "ًẗَlْḥِn", "root": "نحل"}, {"id": 5, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 6, "arabic": "طِبْنَ", "translit": "َnْbِṭ", "root": "طيب"}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 8, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 9, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 10, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 11, "arabic": "نَفْسًا", "translit": "āًsْfَn", "root": "نفس"}, {"id": 12, "arabic": "فَكُلُوهُ", "translit": "ُhwُlُkَf", "root": "اكل"}, {"id": 13, "arabic": "هَنِيٓـًٔا", "translit": "āًٔـٓyِnَh", "root": "هنا"}, {"id": 14, "arabic": "مَّرِيٓـًٔا", "translit": "āًٔـٓyِrَّm", "root": "مرا"}], "hasIhya": true}, {"ayah": 5, "text": "وَلَا تُؤْتُوا۟ ٱلسُّفَهَآءَ أَمْوَٰلَكُمُ ٱلَّتِى جَعَلَ ٱللَّهُ لَكُمْ قِيَٰمًا وَٱرْزُقُوهُمْ فِيهَا وَٱكْسُوهُمْ وَقُولُوا۟ لَهُمْ قَوْلًا مَّعْرُوفًا ", "translation": "And do not give the weak-minded your property,[1] which Allāh has made a means of sustenance for you, but provide for them with it and clothe them and speak to them words of appropriate kindness.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تُؤْتُوا۟", "translit": "۟āwُtْwʾُt", "root": "اتي"}, {"id": 3, "arabic": "ٱلسُّفَهَآءَ", "translit": "َءٓāَhَfُّslٱ", "root": "سفه"}, {"id": 4, "arabic": "أَمْوَٰلَكُمُ", "translit": "ُmُkَlَٰwْmَaʾ", "root": "مول"}, {"id": 5, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 6, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 9, "arabic": "قِيَٰمًا", "translit": "āًmَٰyِq", "root": "قوم"}, {"id": 10, "arabic": "وَٱرْزُقُوهُمْ", "translit": "ْmُhwُqُzْrٱَw", "root": "رزق"}, {"id": 11, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 12, "arabic": "وَٱكْسُوهُمْ", "translit": "ْmُhwُsْkٱَw", "root": "كسو"}, {"id": 13, "arabic": "وَقُولُوا۟", "translit": "۟āwُlwُqَw", "root": "قول"}, {"id": 14, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 15, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 16, "arabic": "مَّعْرُوفًا", "translit": "āًfwُrْʿعَّm", "root": "عرف"}], "hasIhya": true}, {"ayah": 6, "text": "وَٱبْتَلُوا۟ ٱلْيَتَٰمَىٰ حَتَّىٰٓ إِذَا بَلَغُوا۟ ٱلنِّكَاحَ فَإِنْ ءَانَسْتُم مِّنْهُمْ رُشْدًا فَٱدْفَعُوٓا۟ إِلَيْهِمْ أَمْوَٰلَهُمْۖ وَلَا تَأْكُلُوهَآ إِسْرَافًا وَبِدَارًا أَن يَكْبَرُوا۟ۚ وَمَن كَانَ غَنِيًّا فَلْيَسْتَعْفِفْۖ وَمَن كَانَ فَقِيرًا فَلْيَأْكُلْ بِٱلْمَعْرُوفِۚ فَإِذَا دَفَعْتُمْ إِلَيْهِمْ أَمْوَٰلَهُمْ فَأَشْهِدُوا۟ عَلَيْهِمْۚ وَكَفَىٰ بِٱللَّهِ حَسِيبًا ", "translation": "And test the orphans [in their abilities] until they reach marriageable age. Then if you perceive in them sound judgement, release their property to them. And do not consume it excessively and quickly, [anticipating] that they will grow up. And whoever, [when acting as guardian], is self-sufficient should refrain [from taking a fee]; and whoever is poor - let him take according to what is acceptable. Then when you release their property to them, bring witnesses upon them. And sufficient is Allāh as Accountant.", "words": [{"id": 1, "arabic": "وَٱبْتَلُوا۟", "translit": "۟āwُlَtْbٱَw", "root": "بلو"}, {"id": 2, "arabic": "ٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱ", "root": "يتم"}, {"id": 3, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "بَلَغُوا۟", "translit": "۟āwُغَlَb", "root": "بلغ"}, {"id": 6, "arabic": "ٱلنِّكَاحَ", "translit": "َḥāَkِّnlٱ", "root": "نكح"}, {"id": 7, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 8, "arabic": "ءَانَسْتُم", "translit": "mُtْsَnāَء", "root": "انس"}, {"id": 9, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 10, "arabic": "رُشْدًا", "translit": "āًdْhsُr", "root": "رشد"}, {"id": 11, "arabic": "فَٱدْفَعُوٓا۟", "translit": "۟āٓwُʿعَfْdٱَf", "root": "دفع"}, {"id": 12, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 13, "arabic": "أَمْوَٰلَهُمْ", "translit": "ْmُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "تَأْكُلُوهَآ", "translit": "ٓāَhwُlُkْaʾَt", "root": "اكل"}, {"id": 16, "arabic": "إِسْرَافًا", "translit": "āًfāَrْsِiʾ", "root": "سرف"}, {"id": 17, "arabic": "وَبِدَارًا", "translit": "āًrāَdِbَw", "root": "بدر"}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "يَكْبَرُوا۟", "translit": "۟āwُrَbْkَy", "root": "كبر"}, {"id": 20, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 21, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 22, "arabic": "غَنِيًّا", "translit": "āًّyِnَغ", "root": "غني"}, {"id": 23, "arabic": "فَلْيَسْتَعْفِفْ", "translit": "ْfِfْʿعَtْsَyْlَf", "root": "عفف"}, {"id": 24, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 25, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 26, "arabic": "فَقِيرًا", "translit": "āًryِqَf", "root": "فقر"}, {"id": 27, "arabic": "فَلْيَأْكُلْ", "translit": "ْlُkْaʾَyْlَf", "root": "اكل"}, {"id": 28, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 29, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 30, "arabic": "دَفَعْتُمْ", "translit": "ْmُtْʿعَfَd", "root": "دفع"}, {"id": 31, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 32, "arabic": "أَمْوَٰلَهُمْ", "translit": "ْmُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 33, "arabic": "فَأَشْهِدُوا۟", "translit": "۟āwُdِhْhsَaʾَf", "root": "شهد"}, {"id": 34, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 35, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 36, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 37, "arabic": "حَسِيبًا", "translit": "āًbyِsَḥ", "root": "حسب"}], "hasIhya": false}, {"ayah": 7, "text": "لِّلرِّجَالِ نَصِيبٌ مِّمَّا تَرَكَ ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ وَلِلنِّسَآءِ نَصِيبٌ مِّمَّا تَرَكَ ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَ مِمَّا قَلَّ مِنْهُ أَوْ كَثُرَۚ نَصِيبًا مَّفْرُوضًا ", "translation": "For men is a share of what the parents and close relatives leave, and for women is a share of what the parents and close relatives leave, be it little or much - an obligatory share.", "words": [{"id": 1, "arabic": "لِّلرِّجَالِ", "translit": "ِlāَjgِّrlِّl", "root": "رجل"}, {"id": 2, "arabic": "نَصِيبٌ", "translit": "ٌbyِṣَn", "root": "نصب"}, {"id": 3, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 4, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 5, "arabic": "ٱلْوَٰلِدَانِ", "translit": "ِnāَdِlَٰwْlٱ", "root": "ولد"}, {"id": 6, "arabic": "وَٱلْأَقْرَبُونَ", "translit": "َnwُbَrْqَaʾْlٱَw", "root": "قرب"}, {"id": 7, "arabic": "وَلِلنِّسَآءِ", "translit": "ِءٓāَsِّnlِlَw", "root": "نسو"}, {"id": 8, "arabic": "نَصِيبٌ", "translit": "ٌbyِṣَn", "root": "نصب"}, {"id": 9, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 10, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 11, "arabic": "ٱلْوَٰلِدَانِ", "translit": "ِnāَdِlَٰwْlٱ", "root": "ولد"}, {"id": 12, "arabic": "وَٱلْأَقْرَبُونَ", "translit": "َnwُbَrْqَaʾْlٱَw", "root": "قرب"}, {"id": 13, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 14, "arabic": "قَلَّ", "translit": "َّlَq", "root": "قلل"}, {"id": 15, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 16, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 17, "arabic": "كَثُرَ", "translit": "َrُhtَk", "root": "كثر"}, {"id": 18, "arabic": "نَصِيبًا", "translit": "āًbyِṣَn", "root": "نصب"}, {"id": 19, "arabic": "مَّفْرُوضًا", "translit": "āًḍwُrْfَّm", "root": "فرض"}], "hasIhya": true}, {"ayah": 8, "text": "وَإِذَا حَضَرَ ٱلْقِسْمَةَ أُو۟لُوا۟ ٱلْقُرْبَىٰ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينُ فَٱرْزُقُوهُم مِّنْهُ وَقُولُوا۟ لَهُمْ قَوْلًا مَّعْرُوفًا ", "translation": "And when [other] relatives and orphans and the needy are present at the [time of] division, then provide for them [something] out of it [i.e., the estate] and speak to them words of appropriate kindness.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "حَضَرَ", "translit": "َrَḍَḥ", "root": "حضر"}, {"id": 3, "arabic": "ٱلْقِسْمَةَ", "translit": "َẗَmْsِqْlٱ", "root": "قسم"}, {"id": 4, "arabic": "أُو۟لُوا۟", "translit": "۟āwُl۟wُaʾ", "root": ""}, {"id": 5, "arabic": "ٱلْقُرْبَىٰ", "translit": "ٰàَbْrُqْlٱ", "root": "قرب"}, {"id": 6, "arabic": "وَٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱَw", "root": "يتم"}, {"id": 7, "arabic": "وَٱلْمَسَٰكِينُ", "translit": "ُnyِkَٰsَmْlٱَw", "root": "سكن"}, {"id": 8, "arabic": "فَٱرْزُقُوهُم", "translit": "mُhwُqُzْrٱَf", "root": "رزق"}, {"id": 9, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 10, "arabic": "وَقُولُوا۟", "translit": "۟āwُlwُqَw", "root": "قول"}, {"id": 11, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 12, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 13, "arabic": "مَّعْرُوفًا", "translit": "āًfwُrْʿعَّm", "root": "عرف"}], "hasIhya": false}, {"ayah": 9, "text": "وَلْيَخْشَ ٱلَّذِينَ لَوْ تَرَكُوا۟ مِنْ خَلْفِهِمْ ذُرِّيَّةً ضِعَٰفًا خَافُوا۟ عَلَيْهِمْ فَلْيَتَّقُوا۟ ٱللَّهَ وَلْيَقُولُوا۟ قَوْلًا سَدِيدًا ", "translation": "And let those [executors and guardians] fear [injustice] as if they [themselves] had left weak offspring behind and feared for them. So let them fear Allāh and speak words of appropriate justice.", "words": [{"id": 1, "arabic": "وَلْيَخْشَ", "translit": "َhsْhkَyْlَw", "root": "خشي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 4, "arabic": "تَرَكُوا۟", "translit": "۟āwُkَrَt", "root": "ترك"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "خَلْفِهِمْ", "translit": "ْmِhِfْlَhk", "root": "خلف"}, {"id": 7, "arabic": "ذُرِّيَّةً", "translit": "ًẗَّyِّrُhd", "root": "ذرر"}, {"id": 8, "arabic": "ضِعَٰفًا", "translit": "āًfَٰʿعِḍ", "root": "ضعف"}, {"id": 9, "arabic": "خَافُوا۟", "translit": "۟āwُfāَhk", "root": "خوف"}, {"id": 10, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "فَلْيَتَّقُوا۟", "translit": "۟āwُqَّtَyْlَf", "root": "وقي"}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَلْيَقُولُوا۟", "translit": "۟āwُlwُqَyْlَw", "root": "قول"}, {"id": 14, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 15, "arabic": "سَدِيدًا", "translit": "āًdyِdَs", "root": "سدد"}], "hasIhya": false}, {"ayah": 10, "text": "إِنَّ ٱلَّذِينَ يَأْكُلُونَ أَمْوَٰلَ ٱلْيَتَٰمَىٰ ظُلْمًا إِنَّمَا يَأْكُلُونَ فِى بُطُونِهِمْ نَارًاۖ وَسَيَصْلَوْنَ سَعِيرًا ", "translation": "Indeed, those who devour the property of orphans unjustly are only consuming into their bellies fire. And they will be burned in a Blaze [i.e., Hellfire].", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَأْكُلُونَ", "translit": "َnwُlُkْaʾَy", "root": "اكل"}, {"id": 4, "arabic": "أَمْوَٰلَ", "translit": "َlَٰwْmَaʾ", "root": "مول"}, {"id": 5, "arabic": "ٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱ", "root": "يتم"}, {"id": 6, "arabic": "ظُلْمًا", "translit": "āًmْlُẓ", "root": "ظلم"}, {"id": 7, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 8, "arabic": "يَأْكُلُونَ", "translit": "َnwُlُkْaʾَy", "root": "اكل"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "بُطُونِهِمْ", "translit": "ْmِhِnwُṭُb", "root": "بطن"}, {"id": 11, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 12, "arabic": "وَسَيَصْلَوْنَ", "translit": "َnْwَlْṣَyَsَw", "root": "صلي"}, {"id": 13, "arabic": "سَعِيرًا", "translit": "āًryِʿعَs", "root": "سعر"}], "hasIhya": true}, {"ayah": 11, "text": "يُوصِيكُمُ ٱللَّهُ فِىٓ أَوْلَٰدِكُمْۖ لِلذَّكَرِ مِثْلُ حَظِّ ٱلْأُنثَيَيْنِۚ فَإِن كُنَّ نِسَآءً فَوْقَ ٱثْنَتَيْنِ فَلَهُنَّ ثُلُثَا مَا تَرَكَۖ وَإِن كَانَتْ وَٰحِدَةً فَلَهَا ٱلنِّصْفُۚ وَلِأَبَوَيْهِ لِكُلِّ وَٰحِدٍ مِّنْهُمَا ٱلسُّدُسُ مِمَّا تَرَكَ إِن كَانَ لَهُۥ وَلَدٌۚ فَإِن لَّمْ يَكُن لَّهُۥ وَلَدٌ وَوَرِثَهُۥٓ أَبَوَاهُ فَلِأُمِّهِ ٱلثُّلُثُۚ فَإِن كَانَ لَهُۥٓ إِخْوَةٌ فَلِأُمِّهِ ٱلسُّدُسُۚ مِنۢ بَعْدِ وَصِيَّةٍ يُوصِى بِهَآ أَوْ دَيْنٍۗ ءَابَآؤُكُمْ وَأَبْنَآؤُكُمْ لَا تَدْرُونَ أَيُّهُمْ أَقْرَبُ لَكُمْ نَفْعًاۚ فَرِيضَةً مِّنَ ٱللَّهِۗ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا ", "translation": "Allāh instructs you concerning your children [i.e., their portions of inheritance]: for the male, what is equal to the share of two females. But if there are [only] daughters, two or more, for them is two thirds of one's estate.[1] And if there is only one, for her is half. And for one's parents, to each one of them is a sixth of his estate if he left children. But if he had no children and the parents [alone] inherit from him, then for his mother is one third. And if he had brothers [and/or sisters], for his mother is a sixth,[2] after any bequest he [may have] made or debt.[3] Your parents or your children - you know not which of them are nearest to you in benefit. [These shares are] an obligation [imposed] by Allāh. Indeed, Allāh is ever Knowing and Wise.", "words": [{"id": 1, "arabic": "يُوصِيكُمُ", "translit": "ُmُkyِṣwُy", "root": "وصي"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "أَوْلَٰدِكُمْ", "translit": "ْmُkِdَٰlْwَaʾ", "root": "ولد"}, {"id": 5, "arabic": "لِلذَّكَرِ", "translit": "ِrَkَّhdlِl", "root": "ذكر"}, {"id": 6, "arabic": "مِثْلُ", "translit": "ُlْhtِm", "root": "مثل"}, {"id": 7, "arabic": "حَظِّ", "translit": "ِّẓَḥ", "root": "حظظ"}, {"id": 8, "arabic": "ٱلْأُنثَيَيْنِ", "translit": "ِnْyَyَhtnُaʾْlٱ", "root": "انث"}, {"id": 9, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 10, "arabic": "كُنَّ", "translit": "َّnُk", "root": "كون"}, {"id": 11, "arabic": "نِسَآءً", "translit": "ًءٓāَsِn", "root": "نسو"}, {"id": 12, "arabic": "فَوْقَ", "translit": "َqْwَf", "root": "فوق"}, {"id": 13, "arabic": "ٱثْنَتَيْنِ", "translit": "ِnْyَtَnْhtٱ", "root": "ثني"}, {"id": 14, "arabic": "فَلَهُنَّ", "translit": "َّnُhَlَf", "root": ""}, {"id": 15, "arabic": "ثُلُثَا", "translit": "āَhtُlُht", "root": "ثلث"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 18, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 19, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 20, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 21, "arabic": "فَلَهَا", "translit": "āَhَlَf", "root": ""}, {"id": 22, "arabic": "ٱلنِّصْفُ", "translit": "ُfْṣِّnlٱ", "root": "نصف"}, {"id": 23, "arabic": "وَلِأَبَوَيْهِ", "translit": "ِhْyَwَbَaʾِlَw", "root": "ابو"}, {"id": 24, "arabic": "لِكُلِّ", "translit": "ِّlُkِl", "root": "كلل"}, {"id": 25, "arabic": "وَٰحِدٍ", "translit": "ٍdِḥَٰw", "root": "وحد"}, {"id": 26, "arabic": "مِّنْهُمَا", "translit": "āَmُhْnِّm", "root": ""}, {"id": 27, "arabic": "ٱلسُّدُسُ", "translit": "ُsُdُّslٱ", "root": "سدس"}, {"id": 28, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 29, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 30, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 31, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 32, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 33, "arabic": "وَلَدٌ", "translit": "ٌdَlَw", "root": "ولد"}, {"id": 34, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 35, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 36, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 37, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 38, "arabic": "وَلَدٌ", "translit": "ٌdَlَw", "root": "ولد"}, {"id": 39, "arabic": "وَوَرِثَهُۥٓ", "translit": "ٓۥُhَhtِrَwَw", "root": "ورث"}, {"id": 40, "arabic": "أَبَوَاهُ", "translit": "ُhāَwَbَaʾ", "root": "ابو"}, {"id": 41, "arabic": "فَلِأُمِّهِ", "translit": "ِhِّmُaʾِlَf", "root": "امم"}, {"id": 42, "arabic": "ٱلثُّلُثُ", "translit": "ُhtُlُّhtlٱ", "root": "ثلث"}, {"id": 43, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 44, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 45, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 46, "arabic": "إِخْوَةٌ", "translit": "ٌẗَwْhkِiʾ", "root": "اخو"}, {"id": 47, "arabic": "فَلِأُمِّهِ", "translit": "ِhِّmُaʾِlَf", "root": "امم"}, {"id": 48, "arabic": "ٱلسُّدُسُ", "translit": "ُsُdُّslٱ", "root": "سدس"}, {"id": 49, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 50, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 51, "arabic": "وَصِيَّةٍ", "translit": "ٍẗَّyِṣَw", "root": "وصي"}, {"id": 52, "arabic": "يُوصِى", "translit": "àِṣwُy", "root": "وصي"}, {"id": 53, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 54, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 55, "arabic": "دَيْنٍ", "translit": "ٍnْyَd", "root": "دين"}, {"id": 56, "arabic": "ءَابَآؤُكُمْ", "translit": "ْmُkُwʾٓāَbāَء", "root": "ابو"}, {"id": 57, "arabic": "وَأَبْنَآؤُكُمْ", "translit": "ْmُkُwʾٓāَnْbَaʾَw", "root": "بني"}, {"id": 58, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 59, "arabic": "تَدْرُونَ", "translit": "َnwُrْdَt", "root": "دري"}, {"id": 60, "arabic": "أَيُّهُمْ", "translit": "ْmُhُّyَaʾ", "root": "ايي"}, {"id": 61, "arabic": "أَقْرَبُ", "translit": "ُbَrْqَaʾ", "root": "قرب"}, {"id": 62, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 63, "arabic": "نَفْعًا", "translit": "āًʿعْfَn", "root": "نفع"}, {"id": 64, "arabic": "فَرِيضَةً", "translit": "ًẗَḍyِrَf", "root": "فرض"}, {"id": 65, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 66, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 67, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 68, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 69, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 70, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 71, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 12, "text": "وَلَكُمْ نِصْفُ مَا تَرَكَ أَزْوَٰجُكُمْ إِن لَّمْ يَكُن لَّهُنَّ وَلَدٌۚ فَإِن كَانَ لَهُنَّ وَلَدٌ فَلَكُمُ ٱلرُّبُعُ مِمَّا تَرَكْنَۚ مِنۢ بَعْدِ وَصِيَّةٍ يُوصِينَ بِهَآ أَوْ دَيْنٍۚ وَلَهُنَّ ٱلرُّبُعُ مِمَّا تَرَكْتُمْ إِن لَّمْ يَكُن لَّكُمْ وَلَدٌۚ فَإِن كَانَ لَكُمْ وَلَدٌ فَلَهُنَّ ٱلثُّمُنُ مِمَّا تَرَكْتُمۚ مِّنۢ بَعْدِ وَصِيَّةٍ تُوصُونَ بِهَآ أَوْ دَيْنٍۗ وَإِن كَانَ رَجُلٌ يُورَثُ كَلَٰلَةً أَوِ ٱمْرَأَةٌ وَلَهُۥٓ أَخٌ أَوْ أُخْتٌ فَلِكُلِّ وَٰحِدٍ مِّنْهُمَا ٱلسُّدُسُۚ فَإِن كَانُوٓا۟ أَكْثَرَ مِن ذَٰلِكَ فَهُمْ شُرَكَآءُ فِى ٱلثُّلُثِۚ مِنۢ بَعْدِ وَصِيَّةٍ يُوصَىٰ بِهَآ أَوْ دَيْنٍ غَيْرَ مُضَآرٍّۚ وَصِيَّةً مِّنَ ٱللَّهِۗ وَٱللَّهُ عَلِيمٌ حَلِيمٌ ", "translation": "And for you is half of what your wives leave if they have no child. But if they have a child, for you is one fourth of what they leave, after any bequest they [may have] made or debt. And for them [i.e., the wives] is one fourth if you leave no child. But if you leave a child, then for them is an eighth of what you leave, after any bequest you [may have] made or debt. And if a man or woman leaves neither ascendants nor descendants but has a brother or a sister, then for each one of them is a sixth. But if they are more than two, they share a third,[1] after any bequest which was made or debt, as long as there is no detriment [caused].[2] [This is] an ordinance from Allāh, and Allāh is Knowing and Forbearing.", "words": [{"id": 1, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 2, "arabic": "نِصْفُ", "translit": "ُfْṣِn", "root": "نصف"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 5, "arabic": "أَزْوَٰجُكُمْ", "translit": "ْmُkُjgَٰwْzَaʾ", "root": "زوج"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 8, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 9, "arabic": "لَّهُنَّ", "translit": "َّnُhَّl", "root": ""}, {"id": 10, "arabic": "وَلَدٌ", "translit": "ٌdَlَw", "root": "ولد"}, {"id": 11, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 12, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 13, "arabic": "لَهُنَّ", "translit": "َّnُhَl", "root": ""}, {"id": 14, "arabic": "وَلَدٌ", "translit": "ٌdَlَw", "root": "ولد"}, {"id": 15, "arabic": "فَلَكُمُ", "translit": "ُmُkَlَf", "root": ""}, {"id": 16, "arabic": "ٱلرُّبُعُ", "translit": "ُʿعُbُّrlٱ", "root": "ربع"}, {"id": 17, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 18, "arabic": "تَرَكْنَ", "translit": "َnْkَrَt", "root": "ترك"}, {"id": 19, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 20, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 21, "arabic": "وَصِيَّةٍ", "translit": "ٍẗَّyِṣَw", "root": "وصي"}, {"id": 22, "arabic": "يُوصِينَ", "translit": "َnyِṣwُy", "root": "وصي"}, {"id": 23, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 24, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 25, "arabic": "دَيْنٍ", "translit": "ٍnْyَd", "root": "دين"}, {"id": 26, "arabic": "وَلَهُنَّ", "translit": "َّnُhَlَw", "root": ""}, {"id": 27, "arabic": "ٱلرُّبُعُ", "translit": "ُʿعُbُّrlٱ", "root": "ربع"}, {"id": 28, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 29, "arabic": "تَرَكْتُمْ", "translit": "ْmُtْkَrَt", "root": "ترك"}, {"id": 30, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 31, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 32, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 33, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 34, "arabic": "وَلَدٌ", "translit": "ٌdَlَw", "root": "ولد"}, {"id"