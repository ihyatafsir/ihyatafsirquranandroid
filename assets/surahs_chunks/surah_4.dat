ّن", "translit": "", "root": ""}, {"id": 10, "arabic": "فَضْلِهِۦۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَأَمَّا", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۪سْتَنكَفُواْ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَاسْتَكْبَرُواْ", "translit": "", "root": ""}, {"id": 15, "arabic": "فَيُعَذِّبُهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَذَاباً", "translit": "", "root": ""}, {"id": 17, "arabic": "اَلِيماࣰ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 19, "arabic": "يَجِدُونَ", "translit": "", "root": ""}, {"id": 20, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 21, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 22, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 23, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 24, "arabic": "وَلِيّاࣰ", "translit": "", "root": ""}, {"id": 25, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 26, "arabic": "نَصِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 4, "ayah": 174, "text": "۞يَٰٓأَيُّهَا اَ۬لنَّاسُ قَدْ جَآءَكُم بُرْهَٰنࣱ مِّن رَّبِّكُمْ وَأَنزَلْنَآ إِلَيْكُمْ نُوراࣰ مُّبِيناࣰۖ", "words": [{"id": 1, "arabic": "۞يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنَّاسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَآءَكُم", "translit": "", "root": ""}, {"id": 5, "arabic": "بُرْهَٰنࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 7, "arabic": "رَّبِّكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَأَنزَلْنَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَيْكُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "نُوراࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّبِيناࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 4, "ayah": 175, "text": "فَأَمَّا اَ۬لذِينَ ءَامَنُواْ بِاللَّهِ وَاعْتَصَمُواْ بِهِۦ فَسَيُدْخِلُهُمْ فِے رَحْمَةࣲ مِّنْهُ وَفَضْلࣲ وَيَهْدِيهِمُۥٓ إِلَيْهِ صِرَٰطاࣰ مُّسْتَقِيماࣰۖ", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَاعْتَصَمُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَسَيُدْخِلُهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "رَحْمَةࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَفَضْلࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَيَهْدِيهِمُۥٓ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 14, "arabic": "صِرَٰطاࣰ", "translit": "", "root": ""}, {"id": 15, "arabic": "مُّسْتَقِيماࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 4, "ayah": 176, "text": "يَسْتَفْتُونَكَۖ قُلِ اِ۬للَّهُ يُفْتِيكُمْ فِے اِ۬لْكَلَٰلَةِۖ إِنِ اِ۪مْرُؤٌاْ هَلَكَ لَيْسَ لَهُۥ وَلَدࣱ وَلَهُۥٓ أُخْتࣱ فَلَهَا نِصْفُ مَا تَرَكَۖ وَهُوَ يَرِثُهَآ إِن لَّمْ يَكُن لَّهَا وَلَدࣱۖ فَإِن كَانَتَا اَ۪ثْنَتَيْنِ فَلَهُمَا اَ۬لثُّلُثَٰنِ مِمَّا تَرَكَۖ وَإِن كَانُوٓاْ إِخْوَةࣰ رِّجَالاࣰ وَنِسَآءࣰ فَلِلذَّكَرِ مِثْلُ حَظِّ اِ۬لُانثَيَيْنِۖ يُبَيِّنُ اُ۬للَّهُ لَكُمُۥٓ أَن تَضِلُّواْۖ وَاللَّهُ بِكُلِّ شَےْءٍ عَلِيمࣱۖ", "words": [{"id": 1, "arabic": "يَسْتَفْتُونَكَۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُفْتِيكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْكَلَٰ