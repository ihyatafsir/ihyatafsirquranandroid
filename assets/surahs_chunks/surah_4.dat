ot": ""}, {"id": 64, "arabic": "ٱلسُّدُسُ", "translit": "ُsُdُّslٱ", "root": "سدس"}, {"id": 65, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 66, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 67, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 68, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 69, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 70, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 71, "arabic": "شُرَكَآءُ", "translit": "ُءٓāَkَrُhs", "root": "شرك"}, {"id": 72, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 73, "arabic": "ٱلثُّلُثِ", "translit": "ِhtُlُّhtlٱ", "root": "ثلث"}, {"id": 74, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 75, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 76, "arabic": "وَصِيَّةٍ", "translit": "ٍẗَّyِṣَw", "root": "وصي"}, {"id": 77, "arabic": "يُوصَىٰ", "translit": "ٰàَṣwُy", "root": "وصي"}, {"id": 78, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 79, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 80, "arabic": "دَيْنٍ", "translit": "ٍnْyَd", "root": "دين"}, {"id": 81, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 82, "arabic": "مُضَآرٍّ", "translit": "ٍّrٓāَḍُm", "root": "ضرر"}, {"id": 83, "arabic": "وَصِيَّةً", "translit": "ًẗَّyِṣَw", "root": "وصي"}, {"id": 84, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 85, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 86, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 87, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 88, "arabic": "حَلِيمٌ", "translit": "ٌmyِlَḥ", "root": "حلم"}], "hasIhya": true}, {"ayah": 13, "text": "تِلْكَ حُدُودُ ٱللَّهِۚ وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ يُدْخِلْهُ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ ", "translation": "These are the limits [set by] Allāh, and whoever obeys Allāh and His Messenger will be admitted by Him to gardens [in Paradise] under which rivers flow, abiding eternally therein; and that is the great attainment.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "حُدُودُ", "translit": "ُdwُdُḥ", "root": "حدد"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 5, "arabic": "يُطِعِ", "translit": "ِʿعِṭُy", "root": "طوع"}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 8, "arabic": "يُدْخِلْهُ", "translit": "ُhْlِhkْdُy", "root": "دخل"}, {"id": 9, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 10, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 13, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 14, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 15, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 16, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 17, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 18, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": true}, {"ayah": 14, "text": "وَمَن يَعْصِ ٱللَّهَ وَرَسُولَهُۥ وَيَتَعَدَّ حُدُودَهُۥ يُدْخِلْهُ نَارًا خَٰلِدًا فِيهَا وَلَهُۥ عَذَابٌ مُّهِينٌ ", "translation": "And whoever disobeys Allāh and His Messenger and transgresses His limits - He will put him into the Fire to abide eternally therein, and he will have a humiliating punishment.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَعْصِ", "translit": "ِṣْʿعَy", "root": "عصي"}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 5, "arabic": "وَيَتَعَدَّ", "translit": "َّdَʿعَtَyَw", "root": "عدو"}, {"id": 6, "arabic": "حُدُودَهُۥ", "translit": "ۥُhَdwُdُḥ", "root": "حدد"}, {"id": 7, "arabic": "يُدْخِلْهُ", "translit": "ُhْlِhkْdُy", "root": "دخل"}, {"id": 8, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 9, "arabic": "خَٰلِدًا", "translit": "āًdِlَٰhk", "root": "خلد"}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 11, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 12, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 13, "arabic": "مُّهِينٌ", "translit": "ٌnyِhُّm", "root": "هون"}], "hasIhya": true}, {"ayah": 15, "text": "وَٱلَّٰتِى يَأْتِينَ ٱلْفَٰحِشَةَ مِن نِّسَآئِكُمْ فَٱسْتَشْهِدُوا۟ عَلَيْهِنَّ أَرْبَعَةً مِّنكُمْۖ فَإِن شَهِدُوا۟ فَأَمْسِكُوهُنَّ فِى ٱلْبُيُوتِ حَتَّىٰ يَتَوَفَّىٰهُنَّ ٱلْمَوْتُ أَوْ يَجْعَلَ ٱللَّهُ لَهُنَّ سَبِيلًا ", "translation": "Those who commit immorality [i.e., unlawful sexual intercourse] of your women - bring against them four [witnesses] from among you. And if they testify,[1] confine them [i.e., the guilty women] to houses until death takes them or Allāh ordains for them [another] way.[2]", "words": [{"id": 1, "arabic": "وَٱلَّٰتِى", "translit": "àِtَّٰlٱَw", "root": ""}, {"id": 2, "arabic": "يَأْتِينَ", "translit": "َnyِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "ٱلْفَٰحِشَةَ", "translit": "َẗَhsِḥَٰfْlٱ", "root": "فحش"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "نِّسَآئِكُمْ", "translit": "ْmُkِyʾٓāَsِّn", "root": "نسو"}, {"id": 6, "arabic": "فَٱسْتَشْهِدُوا۟", "translit": "۟āwُdِhْhsَtْsٱَf", "root": "شهد"}, {"id": 7, "arabic": "عَلَيْهِنَّ", "translit": "َّnِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "أَرْبَعَةً", "translit": "ًẗَʿعَbْrَaʾ", "root": "ربع"}, {"id": 9, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 10, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 11, "arabic": "شَهِدُوا۟", "translit": "۟āwُdِhَhs", "root": "شهد"}, {"id": 12, "arabic": "فَأَمْسِكُوهُنَّ", "translit": "َّnُhwُkِsْmَaʾَf", "root": "مسك"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ٱلْبُيُوتِ", "translit": "ِtwُyُbْlٱ", "root": "بيت"}, {"id": 15, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 16, "arabic": "يَتَوَفَّىٰهُنَّ", "translit": "َّnُhٰàَّfَwَtَy", "root": "وفي"}, {"id": 17, "arabic": "ٱلْمَوْتُ", "translit": "ُtْwَmْlٱ", "root": "موت"}, {"id": 18, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 19, "arabic": "يَجْعَلَ", "translit": "َlَʿعْjgَy", "root": "جعل"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "لَهُنَّ", "translit": "َّnُhَl", "root": ""}, {"id": 22, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 16, "text": "وَٱلَّذَانِ يَأْتِيَٰنِهَا مِنكُمْ فَـَٔاذُوهُمَاۖ فَإِن تَابَا وَأَصْلَحَا فَأَعْرِضُوا۟ عَنْهُمَآۗ إِنَّ ٱللَّهَ كَانَ تَوَّابًا رَّحِيمًا ", "translation": "And the two[1] who commit it [i.e., unlawful sexual intercourse] among you - punish [i.e., dishonor] them both. But if they repent and correct themselves, leave them alone. Indeed, Allāh is ever Accepting of Repentance and Merciful.", "words": [{"id": 1, "arabic": "وَٱلَّذَانِ", "translit": "ِnāَhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يَأْتِيَٰنِهَا", "translit": "āَhِnَٰyِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 4, "arabic": "فَـَٔاذُوهُمَا", "translit": "āَmُhwُhdāَٔـَf", "root": "اذي"}, {"id": 5, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 6, "arabic": "تَابَا", "translit": "āَbāَt", "root": "توب"}, {"id": 7, "arabic": "وَأَصْلَحَا", "translit": "āَḥَlْṣَaʾَw", "root": "صلح"}, {"id": 8, "arabic": "فَأَعْرِضُوا۟", "translit": "۟āwُḍِrْʿعَaʾَf", "root": "عرض"}, {"id": 9, "arabic": "عَنْهُمَآ", "translit": "ٓāَmُhْnَʿع", "root": ""}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 13, "arabic": "تَوَّابًا", "translit": "āًbāَّwَt", "root": "توب"}, {"id": 14, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 17, "text": "إِنَّمَا ٱلتَّوْبَةُ عَلَى ٱللَّهِ لِلَّذِينَ يَعْمَلُونَ ٱلسُّوٓءَ بِجَهَٰلَةٍ ثُمَّ يَتُوبُونَ مِن قَرِيبٍ فَأُو۟لَٰٓئِكَ يَتُوبُ ٱللَّهُ عَلَيْهِمْۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ", "translation": "The repentance accepted by Allāh is only for those who do wrong in ignorance [or carelessness] and then repent soon [after].[1] It is those to whom Allāh will turn in forgiveness, and Allāh is ever Knowing and Wise.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلتَّوْبَةُ", "translit": "ُẗَbْwَّtlٱ", "root": "توب"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 6, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}, {"id": 7, "arabic": "ٱلسُّوٓءَ", "translit": "َءٓwُّslٱ", "root": "سوا"}, {"id": 8, "arabic": "بِجَهَٰلَةٍ", "translit": "ٍẗَlَٰhَjgِb", "root": "جهل"}, {"id": 9, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 10, "arabic": "يَتُوبُونَ", "translit": "َnwُbwُtَy", "root": "توب"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "قَرِيبٍ", "translit": "ٍbyِrَq", "root": "قرب"}, {"id": 13, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 14, "arabic": "يَتُوبُ", "translit": "ُbwُtَy", "root": "توب"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 17, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 20, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 18, "text": "وَلَيْسَتِ ٱلتَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ ٱلسَّيِّـَٔاتِ حَتَّىٰٓ إِذَا حَضَرَ أَحَدَهُمُ ٱلْمَوْتُ قَالَ إِنِّى تُبْتُ ٱلْـَٰٔنَ وَلَا ٱلَّذِينَ يَمُوتُونَ وَهُمْ كُفَّارٌۚ أُو۟لَٰٓئِكَ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا ", "translation": "But repentance is not [accepted] of those who [continue to] do evil deeds up until, when death comes to one of them, he says, \"Indeed, I have repented now,\" or of those who die while they are disbelievers. For them We have prepared a painful punishment.", "words": [{"id": 1, "arabic": "وَلَيْسَتِ", "translit": "ِtَsْyَlَw", "root": "ليس"}, {"id": 2, "arabic": "ٱلتَّوْبَةُ", "translit": "ُẗَbْwَّtlٱ", "root": "توب"}, {"id": 3, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 4, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}, {"id": 5, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 6, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 7, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 8, "arabic": "حَضَرَ", "translit": "َrَḍَḥ", "root": "حضر"}, {"id": 9, "arabic": "أَحَدَهُمُ", "translit": "ُmُhَdَḥَaʾ", "root": "احد"}, {"id": 10, "arabic": "ٱلْمَوْتُ", "translit": "ُtْwَmْlٱ", "root": "موت"}, {"id": 11, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 12, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 13, "arabic": "تُبْتُ", "translit": "ُtْbُt", "root": "توب"}, {"id": 14, "arabic": "ٱلْـَٰٔنَ", "translit": "َnَٰٔـْlٱ", "root": "اون"}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "يَمُوتُونَ", "translit": "َnwُtwُmَy", "root": "موت"}, {"id": 18, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 19, "arabic": "كُفَّارٌ", "translit": "ٌrāَّfُk", "root": "كفر"}, {"id": 20, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 21, "arabic": "أَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾ", "root": "عتد"}, {"id": 22, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 23, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 24, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 19, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا يَحِلُّ لَكُمْ أَن تَرِثُوا۟ ٱلنِّسَآءَ كَرْهًاۖ وَلَا تَعْضُلُوهُنَّ لِتَذْهَبُوا۟ بِبَعْضِ مَآ ءَاتَيْتُمُوهُنَّ إِلَّآ أَن يَأْتِينَ بِفَٰحِشَةٍ مُّبَيِّنَةٍۚ وَعَاشِرُوهُنَّ بِٱلْمَعْرُوفِۚ فَإِن كَرِهْتُمُوهُنَّ فَعَسَىٰٓ أَن تَكْرَهُوا۟ شَيْـًٔا وَيَجْعَلَ ٱللَّهُ فِيهِ خَيْرًا كَثِيرًا ", "translation": "O you who have believed, it is not lawful for you to inherit women by compulsion.[1] And do not make difficulties for them in order to take [back] part of what you gave them[2] unless they commit a clear immorality [i.e., adultery]. And live with them in kindness. For if you dislike them - perhaps you dislike a thing and Allāh makes therein much good.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يَحِلُّ", "translit": "ُّlِḥَy", "root": "حلل"}, {"id": 6, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "تَرِثُوا۟", "translit": "۟āwُhtِrَt", "root": "ورث"}, {"id": 9, "arabic": "ٱلنِّسَآءَ", "translit": "َءٓāَsِّnlٱ", "root": "نسو"}, {"id": 10, "arabic": "كَرْهًا", "translit": "āًhْrَk", "root": "كره"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تَعْضُلُوهُنَّ", "translit": "َّnُhwُlُḍْʿعَt", "root": "عضل"}, {"id": 13, "arabic": "لِتَذْهَبُوا۟", "translit": "۟āwُbَhْhdَtِl", "root": "ذهب"}, {"id": 14, "arabic": "بِبَعْضِ", "translit": "ِḍْʿعَbِb", "root": "بعض"}, {"id": 15, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 16, "arabic": "ءَاتَيْتُمُوهُنَّ", "translit": "َّnُhwُmُtْyَtāَء", "root": "اتي"}, {"id": 17, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "يَأْتِينَ", "translit": "َnyِtْaʾَy", "root": "اتي"}, {"id": 20, "arabic": "بِفَٰحِشَةٍ", "translit": "ٍẗَhsِḥَٰfِb", "root": "فحش"}, {"id": 21, "arabic": "مُّبَيِّنَةٍ", "translit": "ٍẗَnِّyَbُّm", "root": "بين"}, {"id": 22, "arabic": "وَعَاشِرُوهُنَّ", "translit": "َّnُhwُrِhsāَʿعَw", "root": "عشر"}, {"id": 23, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 24, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 25, "arabic": "كَرِهْتُمُوهُنَّ", "translit": "َّnُhwُmُtْhِrَk", "root": "كره"}, {"id": 26, "arabic": "فَعَسَىٰٓ", "translit": "ٰٓàَsَʿعَf", "root": "عسي"}, {"id": 27, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 28, "arabic": "تَكْرَهُوا۟", "translit": "۟āwُhَrْkَt", "root": "كره"}, {"id": 29, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 30, "arabic": "وَيَجْعَلَ", "translit": "َlَʿعْjgَyَw", "root": "جعل"}, {"id": 31, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 33, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 34, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": true}, {"ayah": 20, "text": "وَإِنْ أَرَدتُّمُ ٱسْتِبْدَالَ زَوْجٍ مَّكَانَ زَوْجٍ وَءَاتَيْتُمْ إِحْدَىٰهُنَّ قِنطَارًا فَلَا تَأْخُذُوا۟ مِنْهُ شَيْـًٔاۚ أَتَأْخُذُونَهُۥ بُهْتَٰنًا وَإِثْمًا مُّبِينًا ", "translation": "But if you want to replace one wife with another and you have given one of them a great amount [in gifts], do not take [back] from it anything. Would you take it in injustice and manifest sin?", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 2, "arabic": "أَرَدتُّمُ", "translit": "ُmُّtdَrَaʾ", "root": "رود"}, {"id": 3, "arabic": "ٱسْتِبْدَالَ", "translit": "َlāَdْbِtْsٱ", "root": "بدل"}, {"id": 4, "arabic": "زَوْجٍ", "translit": "ٍjgْwَz", "root": "زوج"}, {"id": 5, "arabic": "مَّكَانَ", "translit": "َnāَkَّm", "root": "كون"}, {"id": 6, "arabic": "زَوْجٍ", "translit": "ٍjgْwَz", "root": "زوج"}, {"id": 7, "arabic": "وَءَاتَيْتُمْ", "translit": "ْmُtْyَtāَءَw", "root": "اتي"}, {"id": 8, "arabic": "إِحْدَىٰهُنَّ", "translit": "َّnُhٰàَdْḥِiʾ", "root": "احد"}, {"id": 9, "arabic": "قِنطَارًا", "translit": "āًrāَṭnِq", "root": "قنطر"}, {"id": 10, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 11, "arabic": "تَأْخُذُوا۟", "translit": "۟āwُhdُhkْaʾَt", "root": "اخذ"}, {"id": 12, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 13, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 14, "arabic": "أَتَأْخُذُونَهُۥ", "translit": "ۥُhَnwُhdُhkْaʾَtَaʾ", "root": "اخذ"}, {"id": 15, "arabic": "بُهْتَٰنًا", "translit": "āًnَٰtْhُb", "root": "بهت"}, {"id": 16, "arabic": "وَإِثْمًا", "translit": "āًmْhtِiʾَw", "root": "اثم"}, {"id": 17, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 21, "text": "وَكَيْفَ تَأْخُذُونَهُۥ وَقَدْ أَفْضَىٰ بَعْضُكُمْ إِلَىٰ بَعْضٍ وَأَخَذْنَ مِنكُم مِّيثَٰقًا غَلِيظًا ", "translation": "And how could you take it while you have gone in unto each other and they have taken from you a solemn covenant?", "words": [{"id": 1, "arabic": "وَكَيْفَ", "translit": "َfْyَkَw", "root": "كيف"}, {"id": 2, "arabic": "تَأْخُذُونَهُۥ", "translit": "ۥُhَnwُhdُhkْaʾَt", "root": "اخذ"}, {"id": 3, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 4, "arabic": "أَفْضَىٰ", "translit": "ٰàَḍْfَaʾ", "root": "فضو"}, {"id": 5, "arabic": "بَعْضُكُمْ", "translit": "ْmُkُḍْʿعَb", "root": "بعض"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 8, "arabic": "وَأَخَذْنَ", "translit": "َnْhdَhkَaʾَw", "root": "اخذ"}, {"id": 9, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 10, "arabic": "مِّيثَٰقًا", "translit": "āًqَٰhtyِّm", "root": "وثق"}, {"id": 11, "arabic": "غَلِيظًا", "translit": "āًẓyِlَغ", "root": "غلظ"}], "hasIhya": true}, {"ayah": 22, "text": "وَلَا تَنكِحُوا۟ مَا نَكَحَ ءَابَآؤُكُم مِّنَ ٱلنِّسَآءِ إِلَّا مَا قَدْ سَلَفَۚ إِنَّهُۥ كَانَ فَٰحِشَةً وَمَقْتًا وَسَآءَ سَبِيلًا ", "translation": "And do not marry those [women] whom your fathers married, except what has already occurred.[1] Indeed, it was an immorality and hateful [to Allāh] and was evil as a way.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَنكِحُوا۟", "translit": "۟āwُḥِknَt", "root": "نكح"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "نَكَحَ", "translit": "َḥَkَn", "root": "نكح"}, {"id": 5, "arabic": "ءَابَآؤُكُم", "translit": "mُkُwʾٓāَbāَء", "root": "ابو"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 11, "arabic": "سَلَفَ", "translit": "َfَlَs", "root": "سلف"}, {"id": 12, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 14, "arabic": "فَٰحِشَةً", "translit": "ًẗَhsِḥَٰf", "root": "فحش"}, {"id": 15, "arabic": "وَمَقْتًا", "translit": "āًtْqَmَw", "root": "مقت"}, {"id": 16, "arabic": "وَسَآءَ", "translit": "َءٓāَsَw", "root": "سوا"}, {"id": 17, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 23, "text": "حُرِّمَتْ عَلَيْكُمْ أُمَّهَٰتُكُمْ وَبَنَاتُكُمْ وَأَخَوَٰتُكُمْ وَعَمَّٰتُكُمْ وَخَٰلَٰتُكُمْ وَبَنَاتُ ٱلْأَخِ وَبَنَاتُ ٱلْأُخْتِ وَأُمَّهَٰتُكُمُ ٱلَّٰتِىٓ أَرْضَعْنَكُمْ وَأَخَوَٰتُكُم مِّنَ ٱلرَّضَٰعَةِ وَأُمَّهَٰتُ نِسَآئِكُمْ وَرَبَٰٓئِبُكُمُ ٱلَّٰتِى فِى حُجُورِكُم مِّن نِّسَآئِكُمُ ٱلَّٰتِى دَخَلْتُم بِهِنَّ فَإِن لَّمْ تَكُونُوا۟ دَخَلْتُم بِهِنَّ فَلَا جُنَاحَ عَلَيْكُمْ وَحَلَٰٓئِلُ أَبْنَآئِكُمُ ٱلَّذِينَ مِنْ أَصْلَٰبِكُمْ وَأَن تَجْمَعُوا۟ بَيْنَ ٱلْأُخْتَيْنِ إِلَّا مَا قَدْ سَلَفَۗ إِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا ", "translation": "Prohibited to you [for marriage] are your mothers, your daughters, your sisters, your father's sisters, your mother's sisters, your brother's daughters, your sister's daughters, your [milk] mothers who nursed you, your sisters through nursing, your wives' mothers, and your step-daughters under your guardianship [born] of your wives unto whom you have gone in. But if you have not gone in unto them, there is no sin upon you. And [also prohibited are] the wives of your sons who are from your [own] loins, and that you take [in marriage] two sisters simultaneously, except for what has already occurred.[1] Indeed, Allāh is ever Forgiving and Merciful.", "words": [{"id": 1, "arabic": "حُرِّمَتْ", "translit": "ْtَmِّrُḥ", "root": "حرم"}, {"id": 2, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "أُمَّهَٰتُكُمْ", "translit": "ْmُkُtَٰhَّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "وَبَنَاتُكُمْ", "translit": "ْmُkُtāَnَbَw", "root": "بني"}, {"id": 5, "arabic": "وَأَخَوَٰتُكُمْ", "translit": "ْmُkُtَٰwَhkَaʾَw", "root": "اخو"}, {"id": 6, "arabic": "وَعَمَّٰتُكُمْ", "translit": "ْmُkُtَّٰmَʿعَw", "root": "عمم"}, {"id": 7, "arabic": "وَخَٰلَٰتُكُمْ", "translit": "ْmُkُtَٰlَٰhkَw", "root": "خول"}, {"id": 8, "arabic": "وَبَنَاتُ", "translit": "ُtāَnَbَw", "root": "بني"}, {"id": 9, "arabic": "ٱلْأَخِ", "translit": "ِhkَaʾْlٱ", "root": "اخو"}, {"id": 10, "arabic": "وَبَنَاتُ", "translit": "ُtāَnَbَw", "root": "بني"}, {"id": 11, "arabic": "ٱلْأُخْتِ", "translit": "ِtْhkُaʾْlٱ", "root": "اخو"}, {"id": 12, "arabic": "وَأُمَّهَٰتُكُمُ", "translit": "ُmُkُtَٰhَّmُaʾَw", "root": "امم"}, {"id": 13, "arabic": "ٱلَّٰتِىٓ", "translit": "ٓàِtَّٰlٱ", "root": ""}, {"id": 14, "arabic": "أَرْضَعْنَكُمْ", "translit": "ْmُkَnْʿعَḍْrَaʾ", "root": "رضع"}, {"id": 15, "arabic": "وَأَخَوَٰتُكُم", "translit": "mُkُtَٰwَhkَaʾَw", "root": "اخو"}, {"id": 16, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 17, "arabic": "ٱلرَّضَٰعَةِ", "translit": "ِẗَʿعَٰḍَّrlٱ", "root": "رضع"}, {"id": 18, "arabic": "وَأُمَّهَٰتُ", "translit": "ُtَٰhَّmُaʾَw", "root": "امم"}, {"id": 19, "arabic": "نِسَآئِكُمْ", "translit": "ْmُkِyʾٓāَsِn", "root": "نسو"}, {"id": 20, "arabic": "وَرَبَٰٓئِبُكُمُ", "translit": "ُmُkُbِyʾَٰٓbَrَw", "root": "ربب"}, {"id": 21, "arabic": "ٱلَّٰتِى", "translit": "àِtَّٰlٱ", "root": ""}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "حُجُورِكُم", "translit": "mُkِrwُjgُḥ", "root": "حجر"}, {"id": 24, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 25, "arabic": "نِّسَآئِكُمُ", "translit": "ُmُkِyʾٓāَsِّn", "root": "نسو"}, {"id": 26, "arabic": "ٱلَّٰتِى", "translit": "àِtَّٰlٱ", "root": ""}, {"id": 27, "arabic": "دَخَلْتُم", "translit": "mُtْlَhkَd", "root": "دخل"}, {"id": 28, "arabic": "بِهِنَّ", "translit": "َّnِhِb", "root": ""}, {"id": 29, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 30, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 31, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 32, "arabic": "دَخَلْتُم", "translit": "mُtْlَhkَd", "root": "دخل"}, {"id": 33, "arabic": "بِهِنَّ", "translit": "َّnِhِb", "root": ""}, {"id": 34, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 35, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 36, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 37, "arabic": "وَحَلَٰٓئِلُ", "translit": "ُlِyʾَٰٓlَḥَw", "root": "حلل"}, {"id": 38, "arabic": "أَبْنَآئِكُمُ", "translit": "ُmُkِyʾٓāَnْbَaʾ", "root": "بني"}, {"id": 39, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 40, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 41, "arabic": "أَصْلَٰبِكُمْ", "translit": "ْmُkِbَٰlْṣَaʾ", "root": "صلب"}, {"id": 42, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 43, "arabic": "تَجْمَعُوا۟", "translit": "۟āwُʿعَmْjgَt", "root": "جمع"}, {"id": 44, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 45, "arabic": "ٱلْأُخْتَيْنِ", "translit": "ِnْyَtْhkُaʾْlٱ", "root": "اخو"}, {"id": 46, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 47, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 48, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 49, "arabic": "سَلَفَ", "translit": "َfَlَs", "root": "سلف"}, {"id": 50, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 51, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 52, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 53, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 54, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 24, "text": "وَٱلْمُحْصَنَٰتُ مِنَ ٱلنِّسَآءِ إِلَّا مَا مَلَكَتْ أَيْمَٰنُكُمْۖ كِتَٰبَ ٱللَّهِ عَلَيْكُمْۚ وَأُحِلَّ لَكُم مَّا وَرَآءَ ذَٰلِكُمْ أَن تَبْتَغُوا۟ بِأَمْوَٰلِكُم مُّحْصِنِينَ غَيْرَ مُسَٰفِحِينَۚ فَمَا ٱسْتَمْتَعْتُم بِهِۦ مِنْهُنَّ فَـَٔاتُوهُنَّ أُجُورَهُنَّ فَرِيضَةًۚ وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا تَرَٰضَيْتُم بِهِۦ مِنۢ بَعْدِ ٱلْفَرِيضَةِۚ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا ", "translation": "And [also prohibited to you are all] married women except those your right hands possess.[1] [This is] the decree of Allāh upon you. And lawful to you are [all others] beyond these, [provided] that you seek them [in marriage] with [gifts from] your property, desiring chastity, not unlawful sexual intercourse. So for whatever you enjoy [of marriage] from them, give them their due compensation[2] as an obligation. And there is no blame upon you for what you mutually agree to beyond the obligation. Indeed, Allāh is ever Knowing and Wise.", "words": [{"id": 1, "arabic": "وَٱلْمُحْصَنَٰتُ", "translit": "ُtَٰnَṣْḥُmْlٱَw", "root": "حصن"}, {"id": 2, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 3, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 7, "arabic": "أَيْمَٰنُكُمْ", "translit": "ْmُkُnَٰmْyَaʾ", "root": "يمن"}, {"id": 8, "arabic": "كِتَٰبَ", "translit": "َbَٰtِk", "root": "كتب"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 11, "arabic": "وَأُحِلَّ", "translit": "َّlِḥُaʾَw", "root": "حلل"}, {"id": 12, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 13, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 14, "arabic": "وَرَآءَ", "translit": "َءٓāَrَw", "root": "وري"}, {"id": 15, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 16, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 17, "arabic": "تَبْتَغُوا۟", "translit": "۟āwُغَtْbَt", "root": "بغي"}, {"id": 18, "arabic": "بِأَمْوَٰلِكُم", "translit": "mُkِlَٰwْmَaʾِb", "root": "مول"}, {"id": 19, "arabic": "مُّحْصِنِينَ", "translit": "َnyِnِṣْḥُّm", "root": "حصن"}, {"id": 20, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 21, "arabic": "مُسَٰفِحِينَ", "translit": "َnyِḥِfَٰsُm", "root": "سفح"}, {"id": 22, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 23, "arabic": "ٱسْتَمْتَعْتُم", "translit": "mُtْʿعَtْmَtْsٱ", "root": "متع"}, {"id": 24, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 25, "arabic": "مِنْهُنَّ", "translit": "َّnُhْnِm", "root": ""}, {"id": 26, "arabic": "فَـَٔاتُوهُنَّ", "translit": "َّnُhwُtāَٔـَf", "root": "اتي"}, {"id": 27, "arabic": "أُجُورَهُنَّ", "translit": "َّnُhَrwُjgُaʾ", "root": "اجر"}, {"id": 28, "arabic": "فَرِيضَةً", "translit": "ًẗَḍyِrَf", "root": "فرض"}, {"id": 29, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 30, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 31, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 32, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 33, "arabic": "تَرَٰضَيْتُم", "translit": "mُtْyَḍَٰrَt", "root": "رضو"}, {"id": 34, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 35, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 36, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 37, "arabic": "ٱلْفَرِيضَةِ", "translit": "ِẗَḍyِrَfْlٱ", "root": "فرض"}, {"id": 38, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 39, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 40, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 41, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 42, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 25, "text": "وَمَن لَّمْ يَسْتَطِعْ مِنكُمْ طَوْلًا أَن يَنكِحَ ٱلْمُحْصَنَٰتِ ٱلْمُؤْمِنَٰتِ فَمِن مَّا مَلَكَتْ أَيْمَٰنُكُم مِّن فَتَيَٰتِكُمُ ٱلْمُؤْمِنَٰتِۚ وَٱللَّهُ أَعْلَمُ بِإِيمَٰنِكُمۚ بَعْضُكُم مِّنۢ بَعْضٍۚ فَٱنكِحُوهُنَّ بِإِذْنِ أَهْلِهِنَّ وَءَاتُوهُنَّ أُجُورَهُنَّ بِٱلْمَعْرُوفِ مُحْصَنَٰتٍ غَيْرَ مُسَٰفِحَٰتٍ وَلَا مُتَّخِذَٰتِ أَخْدَانٍۚ فَإِذَآ أُحْصِنَّ فَإِنْ أَتَيْنَ بِفَٰحِشَةٍ فَعَلَيْهِنَّ نِصْفُ مَا عَلَى ٱلْمُحْصَنَٰتِ مِنَ ٱلْعَذَابِۚ ذَٰلِكَ لِمَنْ خَشِىَ ٱلْعَنَتَ مِنكُمْۚ وَأَن تَصْبِرُوا۟ خَيْرٌ لَّكُمْۗ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "And whoever among you cannot [find] the means to marry free, believing women, then [he may marry] from those whom your right hands possess of believing slave girls. And Allāh is most knowing about your faith. You [believers] are of one another. So marry them with the permission of their people and give them their due compensation [i.e., mahr] according to what is acceptable. [They should be] chaste, neither [of] those who commit unlawful intercourse randomly nor those who take [secret] lovers. But once they are sheltered in marriage, if they should commit adultery, then for them is half the punishment for free [unmarried] women. This [allowance] is for him among you who fears affliction [i.e., sin], but to be patient is better for you. And Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 3, "arabic": "يَسْتَطِعْ", "translit": "ْʿعِṭَtْsَy", "root": "طوع"}, {"id": 4, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 5, "arabic": "طَوْلًا", "translit": "āًlْwَṭ", "root": "طول"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "يَنكِحَ", "translit": "َḥِknَy", "root": "نكح"}, {"id": 8, "arabic": "ٱلْمُحْصَنَٰتِ", "translit": "ِtَٰnَṣْḥُmْlٱ", "root": "حصن"}, {"id": 9, "arabic": "ٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱ", "root": "امن"}, {"id": 10, "arabic": "فَمِن", "translit": "nِmَf", "root": ""}, {"id": 11, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 12, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 13, "arabic": "أَيْمَٰنُكُم", "translit": "mُkُnَٰmْyَaʾ", "root": "يمن"}, {"id": 14, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 15, "arabic": "فَتَيَٰتِكُمُ", "translit": "ُmُkِtَٰyَtَf", "root": "فتي"}, {"id": 16, "arabic": "ٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱ", "root": "امن"}, {"id": 17, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 18, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 19, "arabic": "بِإِيمَٰنِكُم", "translit": "mُkِnَٰmyِiʾِb", "root": "امن"}, {"id": 20, "arabic": "بَعْضُكُم", "translit": "mُkُḍْʿعَb", "root": "بعض"}, {"id": 21, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 22, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 23, "arabic": "فَٱنكِحُوهُنَّ", "translit": "َّnُhwُḥِknٱَf", "root": "نكح"}, {"id": 24, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 25, "arabic": "أَهْلِهِنَّ", "translit": "َّnِhِlْhَaʾ", "root": "اهل"}, {"id": 26, "arabic": "وَءَاتُوهُنَّ", "translit": "َّnُhwُtāَءَw", "root": "اتي"}, {"id": 27, "arabic": "أُجُورَهُنَّ", "translit": "َّnُhَrwُjgُaʾ", "root": "اجر"}, {"id": 28, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 29, "arabic": "مُحْصَنَٰتٍ", "translit": "ٍtَٰnَṣْḥُm", "root": "حصن"}, {"id": 30, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 31, "arabic": "مُسَٰفِحَٰتٍ", "translit": "ٍtَٰḥِfَٰsُm", "root": "سفح"}, {"id": 32, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 33, "arabic": "مُتَّخِذَٰتِ", "translit": "ِtَٰhdِhkَّtُm", "root": "اخذ"}, {"id": 34, "arabic": "أَخْدَانٍ", "translit": "ٍnāَdْhkَaʾ", "root": "خدن"}, {"id": 35, "arabic": "فَإِذَآ", "translit": "ٓāَhdِiʾَf", "root": ""}, {"id": 36, "arabic": "أُحْصِنَّ", "translit": "َّnِṣْḥُaʾ", "root": "حصن"}, {"id": 37, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 38, "arabic": "أَتَيْنَ", "translit": "َnْyَtَaʾ", "root": "اتي"}, {"id": 39, "arabic": "بِفَٰحِشَةٍ", "translit": "ٍẗَhsِḥَٰfِb", "root": "فحش"}, {"id": 40, "arabic": "فَعَلَيْهِنَّ", "translit": "َّnِhْyَlَʿعَf", "root": ""}, {"id": 41, "arabic": "نِصْفُ", "translit": "ُfْṣِn", "root": "نصف"}, {"id": 42, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 43, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 44, "arabic": "ٱلْمُحْصَنَٰتِ", "translit": "ِtَٰnَṣْḥُmْlٱ", "root": "حصن"}, {"id": 45, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 46, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 47, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 48, "arabic": "لِمَنْ", "translit": "ْnَmِl", "root": ""}, {"id": 49, "arabic": "خَشِىَ", "translit": "َàِhsَhk", "root": "خشي"}, {"id": 50, "arabic": "ٱلْعَنَتَ", "translit": "َtَnَʿعْlٱ", "root": "عنت"}, {"id": 51, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 52, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 53, "arabic": "تَصْبِرُوا۟", "translit": "۟āwُrِbْṣَt", "root": "صبر"}, {"id": 54, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 55, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 56, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 57, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 58, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 26, "text": "يُرِيدُ ٱللَّهُ لِيُبَيِّنَ لَكُمْ وَيَهْدِيَكُمْ سُنَنَ ٱلَّذِينَ مِن قَبْلِكُمْ وَيَتُوبَ عَلَيْكُمْۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "Allāh wants to make clear to you [the lawful from the unlawful] and guide you to the [good] practices of those before you and to accept your repentance. And Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لِيُبَيِّنَ", "translit": "َnِّyَbُyِl", "root": "بين"}, {"id": 4, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 5, "arabic": "وَيَهْدِيَكُمْ", "translit": "ْmُkَyِdْhَyَw", "root": "هدي"}, {"id": 6, "arabic": "سُنَنَ", "translit": "َnَnُs", "root": "سنن"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 10, "arabic": "وَيَتُوبَ", "translit": "َbwُtَyَw", "root": "توب"}, {"id": 11, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 14, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 27, "text": "وَٱللَّهُ يُرِيدُ أَن يَتُوبَ عَلَيْكُمْ وَيُرِيدُ ٱلَّذِينَ يَتَّبِعُونَ ٱلشَّهَوَٰتِ أَن تَمِيلُوا۟ مَيْلًا عَظِيمًا ", "translation": "Allāh wants to accept your repentance, but those who follow [their] passions want you to digress [into] a great deviation.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يَتُوبَ", "translit": "َbwُtَy", "root": "توب"}, {"id": 5, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "وَيُرِيدُ", "translit": "ُdyِrُyَw", "root": "رود"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "يَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَy", "root": "تبع"}, {"id": 9, "arabic": "ٱلشَّهَوَٰتِ", "translit": "ِtَٰwَhَّhslٱ", "root": "شهو"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "تَمِيلُوا۟", "translit": "۟āwُlyِmَt", "root": "ميل"}, {"id": 12, "arabic": "مَيْلًا", "translit": "āًlْyَm", "root": "ميل"}, {"id": 13, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 28, "text": "يُرِيدُ ٱللَّهُ أَن يُخَفِّفَ عَنكُمْۚ وَخُلِقَ ٱلْإِنسَٰنُ ضَعِيفًا ", "translation": "And Allāh wants to lighten for you [your difficulties]; and mankind was created weak.", "words": [{"id": 1, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يُخَفِّفَ", "translit": "َfِّfَhkُy", "root": "خفف"}, {"id": 5, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 6, "arabic": "وَخُلِقَ", "translit": "َqِlُhkَw", "root": "خلق"}, {"id": 7, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 8, "arabic": "ضَعِيفًا", "translit": "āًfyِʿعَḍ", "root": "ضعف"}], "hasIhya": false}, {"ayah": 29, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَأْكُلُوٓا۟ أَمْوَٰلَكُم بَيْنَكُم بِٱلْبَٰطِلِ إِلَّآ أَن تَكُونَ تِجَٰرَةً عَن تَرَاضٍ مِّنكُمْۚ وَلَا تَقْتُلُوٓا۟ أَنفُسَكُمْۚ إِنَّ ٱللَّهَ كَانَ بِكُمْ رَحِيمًا ", "translation": "O you who have believed, do not consume one another's wealth unjustly[1] but only [in lawful] business by mutual consent. And do not kill yourselves [or one another]. Indeed, Allāh is to you ever Merciful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَأْكُلُوٓا۟", "translit": "۟āٓwُlُkْaʾَt", "root": "اكل"}, {"id": 6, "arabic": "أَمْوَٰلَكُم", "translit": "mُkَlَٰwْmَaʾ", "root": "مول"}, {"id": 7, "arabic": "بَيْنَكُم", "translit": "mُkَnْyَb", "root": "بين"}, {"id": 8, "arabic": "بِٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱِb", "root": "بطل"}, {"id": 9, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "تَكُونَ", "translit": "َnwُkَt", "root": "كون"}, {"id": 12, "arabic": "تِجَٰرَةً", "translit": "ًẗَrَٰjgِt", "root": "تجر"}, {"id": 13, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 14, "arabic": "تَرَاضٍ", "translit": "ٍḍāَrَt", "root": "رضو"}, {"id": 15, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "تَقْتُلُوٓا۟", "translit": "۟āٓwُlُtْqَt", "root": "قتل"}, {"id": 18, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 19, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 22, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 23, "arabic": "رَحِيمًا", "translit": "āًmyِḥَr", "root": "رحم"}], "hasIhya": true}, {"ayah": 30, "text": "وَمَن يَفْعَلْ ذَٰلِكَ عُدْوَٰنًا وَظُلْمًا فَسَوْفَ نُصْلِيهِ نَارًاۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرًا ", "translation": "And whoever does that in aggression and injustice - then We will drive him into a Fire. And that, for Allāh, is [always] easy.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَفْعَلْ", "translit": "ْlَʿعْfَy", "root": "فعل"}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 4, "arabic": "عُدْوَٰنًا", "translit": "āًnَٰwْdُʿع", "root": "عدو"}, {"id": 5, "arabic": "وَظُلْمًا", "translit": "āًmْlُẓَw", "root": "ظلم"}, {"id": 6, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 7, "arabic": "نُصْلِيهِ", "translit": "ِhyِlْṣُn", "root": "صلي"}, {"id": 8, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 9, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 10, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 11, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "يَسِيرًا", "translit": "āًryِsَy", "root": "يسر"}], "hasIhya": false}, {"ayah": 31, "text": "إِن تَجْتَنِبُوا۟ كَبَآئِرَ مَا تُنْهَوْنَ عَنْهُ نُكَفِّرْ عَنكُمْ سَيِّـَٔاتِكُمْ وَنُدْخِلْكُم مُّدْخَلًا كَرِيمًا ", "translation": "If you avoid the major sins which you are forbidden, We will remove from you your lesser sins and admit you to a noble entrance [into Paradise].", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "تَجْتَنِبُوا۟", "translit": "۟āwُbِnَtْjgَt", "root": "جنب"}, {"id": 3, "arabic": "كَبَآئِرَ", "translit": "َrِyʾٓāَbَk", "root": "كبر"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "تُنْهَوْنَ", "translit": "َnْwَhْnُt", "root": "نهي"}, {"id": 6, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 7, "arabic": "نُكَفِّرْ", "translit": "ْrِّfَkُn", "root": "كفر"}, {"id": 8, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 9, "arabic": "سَيِّـَٔاتِكُمْ", "translit": "ْmُkِtāَٔـِّyَs", "root": "سوا"}, {"id": 10, "arabic": "وَنُدْخِلْكُم", "translit": "mُkْlِhkْdُnَw", "root": "دخل"}, {"id": 11, "arabic": "مُّدْخَلًا", "translit": "āًlَhkْdُّm", "root": "دخل"}, {"id": 12, "arabic": "كَرِيمًا", "translit": "āًmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 32, "text": "وَلَا تَتَمَنَّوْا۟ مَا فَضَّلَ ٱللَّهُ بِهِۦ بَعْضَكُمْ عَلَىٰ بَعْضٍۚ لِّلرِّجَالِ نَصِيبٌ مِّمَّا ٱكْتَسَبُوا۟ۖ وَلِلنِّسَآءِ نَصِيبٌ مِّمَّا ٱكْتَسَبْنَۚ وَسْـَٔلُوا۟ ٱللَّهَ مِن فَضْلِهِۦٓۗ إِنَّ ٱللَّهَ كَانَ بِكُلِّ شَىْءٍ عَلِيمًا ", "translation": "And do not wish for that by which Allāh has made some of you exceed others. For men is a share of what they have earned, and for women is a share of[1] what they have earned. And ask Allāh of His bounty. Indeed Allāh is ever, of all things, Knowing.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَتَمَنَّوْا۟", "translit": "۟āْwَّnَmَtَt", "root": "مني"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "فَضَّلَ", "translit": "َlَّḍَf", "root": "فضل"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 7, "arabic": "بَعْضَكُمْ", "translit": "ْmُkَḍْʿعَb", "root": "بعض"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 10, "arabic": "لِّلرِّجَالِ", "translit": "ِlāَjgِّrlِّl", "root": "رجل"}, {"id": 11, "arabic": "نَصِيبٌ", "translit": "ٌbyِṣَn", "root": "نصب"}, {"id": 12, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 13, "arabic": "ٱكْتَسَبُوا۟", "translit": "۟āwُbَsَtْkٱ", "root": "كسب"}, {"id": 14, "arabic": "وَلِلنِّسَآءِ", "translit": "ِءٓāَsِّnlِlَw", "root": "نسو"}, {"id": 15, "arabic": "نَصِيبٌ", "translit": "ٌbyِṣَn", "root": "نصب"}, {"id": 16, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 17, "arabic": "ٱكْتَسَبْنَ", "translit": "َnْbَsَtْkٱ", "root": "كسب"}, {"id": 18, "arabic": "وَسْـَٔلُوا۟", "translit": "۟āwُlَٔـْsَw", "root": "سال"}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 21, "arabic": "فَضْلِهِۦٓ", "translit": "ٓۦِhِlْḍَf", "root": "فضل"}, {"id": 22, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 23, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 25, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 26, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 27, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 33, "text": "وَلِكُلٍّ جَعَلْنَا مَوَٰلِىَ مِمَّا تَرَكَ ٱلْوَٰلِدَانِ وَٱلْأَقْرَبُونَۚ وَٱلَّذِينَ عَقَدَتْ أَيْمَٰنُكُمْ فَـَٔاتُوهُمْ نَصِيبَهُمْۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَىْءٍ شَهِيدًا ", "translation": "And for all, We have made heirs to what is left by parents and relatives. And to those whom your oaths have bound [to you] - give them their share.[1] Indeed Allāh is ever, over all things, a Witness.", "words": [{"id": 1, "arabic": "وَلِكُلٍّ", "translit": "ٍّlُkِlَw", "root": "كلل"}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "مَوَٰلِىَ", "translit": "َàِlَٰwَm", "root": "ولي"}, {"id": 4, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 5, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 6, "arabic": "ٱلْوَٰلِدَانِ", "translit": "ِnāَdِlَٰwْlٱ", "root": "ولد"}, {"id": 7, "arabic": "وَٱلْأَقْرَبُونَ", "translit": "َnwُbَrْqَaʾْlٱَw", "root": "قرب"}, {"id": 8, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 9, "arabic": "عَقَدَتْ", "translit": "ْtَdَqَʿع", "root": "عقد"}, {"id": 10, "arabic": "أَيْمَٰنُكُمْ", "translit": "ْmُkُnَٰmْyَaʾ", "root": "يمن"}, {"id": 11, "arabic": "فَـَٔاتُوهُمْ", "translit": "ْmُhwُtāَٔـَf", "root": "اتي"}, {"id": 12, "arabic": "نَصِيبَهُمْ", "translit": "ْmُhَbyِṣَn", "root": "نصب"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}], "hasIhya": false}, {"ayah": 34, "text": "ٱلرِّجَالُ قَوَّٰمُونَ عَلَى ٱلنِّسَآءِ بِمَا فَضَّلَ ٱللَّهُ بَعْضَهُمْ عَلَىٰ بَعْضٍ وَبِمَآ أَنفَقُوا۟ مِنْ أَمْوَٰلِهِمْۚ فَٱلصَّٰلِحَٰتُ قَٰنِتَٰتٌ حَٰفِظَٰتٌ لِّلْغَيْبِ بِمَا حَفِظَ ٱللَّهُۚ وَٱلَّٰتِى تَخَافُونَ نُشُوزَهُنَّ فَعِظُوهُنَّ وَٱهْجُرُوهُنَّ فِى ٱلْمَضَاجِعِ وَٱضْرِبُوهُنَّۖ فَإِنْ أَطَعْنَكُمْ فَلَا تَبْغُوا۟ عَلَيْهِنَّ سَبِيلًاۗ إِنَّ ٱللَّهَ كَانَ عَلِيًّا كَبِيرًا ", "translation": "Men are in charge of women[1] by [right of] what Allāh has given one over the other and what they spend [for maintenance] from their wealth. So righteous women are devoutly obedient, guarding in [the husband's] absence what Allāh would have them guard.[2] But those [wives] from whom you fear arrogance[3] - [first] advise them; [then if they persist], forsake them in bed; and [finally], strike them [lightly].[4] But if they obey you [once more], seek no means against them. Indeed, Allāh is ever Exalted and Grand.", "words": [{"id": 1, "arabic": "ٱلرِّجَالُ", "translit": "ُlāَjgِّrlٱ", "root": "رجل"}, {"id": 2, "arabic": "قَوَّٰمُونَ", "translit": "َnwُmَّٰwَq", "root": "قوم"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 5, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 6, "arabic": "فَضَّلَ", "translit": "َlَّḍَf", "root": "فضل"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "بَعْضَهُمْ", "translit": "ْmُhَḍْʿعَb", "root": "بعض"}, {"id": 9, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 10, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 11, "arabic": "وَبِمَآ", "translit": "ٓāَmِbَw", "root": ""}, {"id": 12, "arabic": "أَنفَقُوا۟", "translit": "۟āwُqَfnَaʾ", "root": "نفق"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "أَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾ", "root": "مول"}, {"id": 15, "arabic": "فَٱلصَّٰلِحَٰتُ", "translit": "ُtَٰḥِlَّٰṣlٱَf", "root": "صلح"}, {"id": 16, "arabic": "قَٰنِتَٰتٌ", "translit": "ٌtَٰtِnَٰq", "root": "قنت"}, {"id": 17, "arabic": "حَٰفِظَٰتٌ", "translit": "ٌtَٰẓِfَٰḥ", "root": "حفظ"}, {"id": 18, "arabic": "لِّلْغَيْبِ", "translit": "ِbْyَغْlِّl", "root": "غيب"}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 20, "arabic": "حَفِظَ", "translit": "َẓِfَḥ", "root": "حفظ"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَٱلَّٰتِى", "translit": "àِtَّٰlٱَw", "root": ""}, {"id": 23, "arabic": "تَخَافُونَ", "translit": "َnwُfāَhkَt", "root": "خوف"}, {"id": 24, "arabic": "نُشُوزَهُنَّ", "translit": "َّnُhَzwُhsُn", "root": "نشز"}, {"id": 25, "arabic": "فَعِظُوهُنَّ", "translit": "َّnُhwُẓِʿعَf", "root": "وعظ"}, {"id": 26, "arabic": "وَٱهْجُرُوهُنَّ", "translit": "َّnُhwُrُjgْhٱَw", "root": "هجر"}, {"id": 27, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 28, "arabic": "ٱلْمَضَاجِعِ", "translit": "ِʿعِjgāَḍَmْlٱ", "root": "ضجع"}, {"id": 29, "arabic": "وَٱضْرِبُوهُنَّ", "translit": "َّnُhwُbِrْḍٱَw", "root": "ضرب"}, {"id": 30, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 31, "arabic": "أَطَعْنَكُمْ", "translit": "ْmُkَnْʿعَṭَaʾ", "root": "طوع"}, {"id": 32, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 33, "arabic": "تَبْغُوا۟", "translit": "۟āwُغْbَt", "root": "بغي"}, {"id": 34, "arabic": "عَلَيْهِنَّ", "translit": "َّnِhْyَlَʿع", "root": ""}, {"id": 35, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}, {"id": 36, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 37, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 38, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 39, "arabic": "عَلِيًّا", "translit": "āًّyِlَʿع", "root": "علو"}, {"id": 40, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}], "hasIhya": true}, {"ayah": 35, "text": "وَإِنْ خِفْتُمْ شِقَاقَ بَيْنِهِمَا فَٱبْعَثُوا۟ حَكَمًا مِّنْ أَهْلِهِۦ وَحَكَمًا مِّنْ أَهْلِهَآ إِن يُرِيدَآ إِصْلَٰحًا يُوَفِّقِ ٱللَّهُ بَيْنَهُمَآۗ إِنَّ ٱللَّهَ كَانَ عَلِيمًا خَبِيرًا ", "translation": "And if you fear dissension between the two, send an arbitrator from his people and an arbitrator from her people. If they both desire reconciliation, Allāh will cause it between them. Indeed, Allāh is ever Knowing and Aware.", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 2, "arabic": "خِفْتُمْ", "translit": "ْmُtْfِhk", "root": "خوف"}, {"id": 3, "arabic": "شِقَاقَ", "translit": "َqāَqِhs", "root": "شقق"}, {"id": 4, "arabic": "بَيْنِهِمَا", "translit": "āَmِhِnْyَb", "root": "بين"}, {"id": 5, "arabic": "فَٱبْعَثُوا۟", "translit": "۟āwُhtَʿعْbٱَf", "root": "بعث"}, {"id": 6, "arabic": "حَكَمًا", "translit": "āًmَkَḥ", "root": "حكم"}, {"id": 7, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 8, "arabic": "أَهْلِهِۦ", "translit": "ۦِhِlْhَaʾ", "root": "اهل"}, {"id": 9, "arabic": "وَحَكَمًا", "translit": "āًmَkَḥَw", "root": "حكم"}, {"id": 10, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 11, "arabic": "أَهْلِهَآ", "translit": "ٓāَhِlْhَaʾ", "root": "اهل"}, {"id": 12, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 13, "arabic": "يُرِيدَآ", "translit": "ٓāَdyِrُy", "root": "رود"}, {"id": 14, "arabic": "إِصْلَٰحًا", "translit": "āًḥَٰlْṣِiʾ", "root": "صلح"}, {"id": 15, "arabic": "يُوَفِّقِ", "translit": "ِqِّfَwُy", "root": "وفق"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "بَيْنَهُمَآ", "translit": "ٓāَmُhَnْyَb", "root": "بين"}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 21, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 22, "arabic": "خَبِيرًا", "translit": "āًryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 36, "text": "وَٱعْبُدُوا۟ ٱللَّهَ وَلَا تُشْرِكُوا۟ بِهِۦ شَيْـًٔاۖ وَبِٱلْوَٰلِدَيْنِ إِحْسَٰنًا وَبِذِى ٱلْقُرْبَىٰ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينِ وَٱلْجَارِ ذِى ٱلْقُرْبَىٰ وَٱلْجَارِ ٱلْجُنُبِ وَٱلصَّاحِبِ بِٱلْجَنۢبِ وَٱبْنِ ٱلسَّبِيلِ وَمَا مَلَكَتْ أَيْمَٰنُكُمْۗ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ مُخْتَالًا فَخُورًا ", "translation": "Worship Allāh and associate nothing with Him, and to parents do good, and to relatives, orphans, the needy, the near neighbor, the neighbor farther away, the companion at your side,[1] the traveler, and those whom your right hands possess. Indeed, Allāh does not like those who are self-deluding and boastful,", "words": [{"id": 1, "arabic": "وَٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱَw", "root": "عبد"}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 4, "arabic": "تُشْرِكُوا۟", "translit": "۟āwُkِrْhsُt", "root": "شرك"}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 7, "arabic": "وَبِٱلْوَٰلِدَيْنِ", "translit": "ِnْyَdِlَٰwْlٱِbَw", "root": "ولد"}, {"id": 8, "arabic": "إِحْسَٰنًا", "translit": "āًnَٰsْḥِiʾ", "root": "حسن"}, {"id": 9, "arabic": "وَبِذِى", "translit": "àِhdِbَw", "root": ""}, {"id": 10, "arabic": "ٱلْقُرْبَىٰ", "translit": "ٰàَbْrُqْlٱ", "root": "قرب"}, {"id": 11, "arabic": "وَٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱَw", "root": "يتم"}, {"id": 12, "arabic": "وَٱلْمَسَٰكِينِ", "translit": "ِnyِkَٰsَmْlٱَw", "root": "سكن"}, {"id": 13, "arabic": "وَٱلْجَارِ", "translit": "ِrāَjgْlٱَw", "root": "جور"}, {"id": 14, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 15, "arabic": "ٱلْقُرْبَىٰ", "translit": "ٰàَbْrُqْlٱ", "root": "قرب"}, {"id": 16, "arabic": "وَٱلْجَارِ", "translit": "ِrāَjgْlٱَw", "root": "جور"}, {"id": 17, "arabic": "ٱلْجُنُبِ", "translit": "ِbُnُjgْlٱ", "root": "جنب"}, {"id": 18, "arabic": "وَٱلصَّاحِبِ", "translit": "ِbِḥāَّṣlٱَw", "root": "صحب"}, {"id": 19, "arabic": "بِٱلْجَنۢبِ", "translit": "ِbۢnَjgْlٱِb", "root": "جنب"}, {"id": 20, "arabic": "وَٱبْنِ", "translit": "ِnْbٱَw", "root": "بني"}, {"id": 21, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 22, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 23, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 24, "arabic": "أَيْمَٰنُكُمْ", "translit": "ْmُkُnَٰmْyَaʾ", "root": "يمن"}, {"id": 25, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 26, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 28, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 29, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 30, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 31, "arabic": "مُخْتَالًا", "translit": "āًlāَtْhkُm", "root": "خيل"}, {"id": 32, "arabic": "فَخُورًا", "translit": "āًrwُhkَf", "root": "فخر"}], "hasIhya": true}, {"ayah": 37, "text": "ٱلَّذِينَ يَبْخَلُونَ وَيَأْمُرُونَ ٱلنَّاسَ بِٱلْبُخْلِ وَيَكْتُمُونَ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦۗ وَأَعْتَدْنَا لِلْكَٰفِرِينَ عَذَابًا مُّهِينًا ", "translation": "Who are stingy and enjoin upon [other] people stinginess and conceal what Allāh has given them of His bounty - and We have prepared for the disbelievers a humiliating punishment -", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَبْخَلُونَ", "translit": "َnwُlَhkْbَy", "root": "بخل"}, {"id": 3, "arabic": "وَيَأْمُرُونَ", "translit": "َnwُrُmْaʾَyَw", "root": "امر"}, {"id": 4, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "بِٱلْبُخْلِ", "translit": "ِlْhkُbْlٱِb", "root": "بخل"}, {"id": 6, "arabic": "وَيَكْتُمُونَ", "translit": "َnwُmُtْkَyَw", "root": "كتم"}, {"id": 7, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 8, "arabic": "ءَاتَىٰهُمُ", "translit": "ُmُhٰàَtāَء", "root": "اتي"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 12, "arabic": "وَأَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾَw", "root": "عتد"}, {"id": 13, "arabic": "لِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِl", "root": "كفر"}, {"id": 14, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 15, "arabic": "مُّهِينًا", "translit": "āًnyِhُّm", "root": "هون"}], "hasIhya": true}, {"ayah": 38, "text": "وَٱلَّذِينَ يُنفِقُونَ أَمْوَٰلَهُمْ رِئَآءَ ٱلنَّاسِ وَلَا يُؤْمِنُونَ بِٱللَّهِ وَلَا بِٱلْيَوْمِ ٱلْءَاخِرِۗ وَمَن يَكُنِ ٱلشَّيْطَٰنُ لَهُۥ قَرِينًا فَسَآءَ قَرِينًا ", "translation": "And [also] those who spend of their wealth to be seen by the people and believe not in Allāh nor in the Last Day. And he to whom Satan is a companion - then evil is he as a companion.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 3, "arabic": "أَمْوَٰلَهُمْ", "translit": "ْmُhَlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "رِئَآءَ", "translit": "َءٓāَyʾِr", "root": "راي"}, {"id": 5, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 8, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "بِٱلْيَوْمِ", "translit": "ِmْwَyْlٱِb", "root": "يوم"}, {"id": 11, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 12, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 13, "arabic": "يَكُنِ", "translit": "ِnُkَy", "root": "كون"}, {"id": 14, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 15, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 16, "arabic": "قَرِينًا", "translit": "āًnyِrَq", "root": "قرن"}, {"id": 17, "arabic": "فَسَآءَ", "translit": "َءٓāَsَf", "root": "سوا"}, {"id": 18, "arabic": "قَرِينًا", "translit": "āًnyِrَq", "root": "قرن"}], "hasIhya": false}, {"ayah": 39, "text": "وَمَاذَا عَلَيْهِمْ لَوْ ءَامَنُوا۟ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَأَنفَقُوا۟ مِمَّا رَزَقَهُمُ ٱللَّهُۚ وَكَانَ ٱللَّهُ بِهِمْ عَلِيمًا ", "translation": "And what [harm would come] upon them if they believed in Allāh and the Last Day and spent out of what Allāh provided for them? And Allāh is ever, about them, Knowing.", "words": [{"id": 1, "arabic": "وَمَاذَا", "translit": "āَhdāَmَw", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 7, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "وَأَنفَقُوا۟", "translit": "۟āwُqَfnَaʾَw", "root": "نفق"}, {"id": 9, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 10, "arabic": "رَزَقَهُمُ", "translit": "ُmُhَqَzَr", "root": "رزق"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 15, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 40, "text": "إِنَّ ٱللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍۖ وَإِن تَكُ حَسَنَةً يُضَٰعِفْهَا وَيُؤْتِ مِن لَّدُنْهُ أَجْرًا عَظِيمًا ", "translation": "Indeed, Allāh does not do injustice, [even] as much as an atom's weight; while if there is a good deed, He multiplies it and gives from Himself a great reward.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَظْلِمُ", "translit": "ُmِlْẓَy", "root": "ظلم"}, {"id": 5, "arabic": "مِثْقَالَ", "translit": "َlāَqْhtِm", "root": "ثقل"}, {"id": 6, "arabic": "ذَرَّةٍ", "translit": "ٍẗَّrَhd", "root": "ذرر"}, {"id": 7, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 8, "arabic": "تَكُ", "translit": "ُkَt", "root": "كون"}, {"id": 9, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 10, "arabic": "يُضَٰعِفْهَا", "translit": "āَhْfِʿعَٰḍُy", "root": "ضعف"}, {"id": 11, "arabic": "وَيُؤْتِ", "translit": "ِtْwʾُyَw", "root": "اتي"}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "لَّدُنْهُ", "translit": "ُhْnُdَّl", "root": "لدن"}, {"id": 14, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 15, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 41, "text": "فَكَيْفَ إِذَا جِئْنَا مِن كُلِّ أُمَّةٍۭ بِشَهِيدٍ وَجِئْنَا بِكَ عَلَىٰ هَٰٓؤُلَآءِ شَهِيدًا ", "translation": "So how [will it be] when We bring from every nation a witness and We bring you, [O Muḥammad], against these [people] as a witness?", "words": [{"id": 1, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "جِئْنَا", "translit": "āَnْyʾِjg", "root": "جيا"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 6, "arabic": "أُمَّةٍۭ", "translit": "ٍۭẗَّmُaʾ", "root": "امم"}, {"id": 7, "arabic": "بِشَهِيدٍ", "translit": "ٍdyِhَhsِb", "root": "شهد"}, {"id": 8, "arabic": "وَجِئْنَا", "translit": "āَnْyʾِjgَw", "root": "جيا"}, {"id": 9, "arabic": "بِكَ", "translit": "َkِb", "root": ""}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 12, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}], "hasIhya": true}, {"ayah": 42, "text": "يَوْمَئِذٍ يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ وَعَصَوُا۟ ٱلرَّسُولَ لَوْ تُسَوَّىٰ بِهِمُ ٱلْأَرْضُ وَلَا يَكْتُمُونَ ٱللَّهَ حَدِيثًا ", "translation": "That Day, those who disbelieved and disobeyed the Messenger will wish they could be covered by the earth. And they will not conceal from Allāh a [single] statement.", "words": [{"id": 1, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَوَدُّ", "translit": "ُّdَwَy", "root": "ودد"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "وَعَصَوُا۟", "translit": "۟āُwَṣَʿعَw", "root": "عصي"}, {"id": 6, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 7, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 8, "arabic": "تُسَوَّىٰ", "translit": "ٰàَّwَsُt", "root": "سوي"}, {"id": 9, "arabic": "بِهِمُ", "translit": "ُmِhِb", "root": ""}, {"id": 10, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "يَكْتُمُونَ", "translit": "َnwُmُtْkَy", "root": "كتم"}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "حَدِيثًا", "translit": "āًhtyِdَḥ", "root": "حدث"}], "hasIhya": false}, {"ayah": 43, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَقْرَبُوا۟ ٱلصَّلَوٰةَ وَأَنتُمْ سُكَٰرَىٰ حَتَّىٰ تَعْلَمُوا۟ مَا تَقُولُونَ وَلَا جُنُبًا إِلَّا عَابِرِى سَبِيلٍ حَتَّىٰ تَغْتَسِلُوا۟ۚ وَإِن كُنتُم مَّرْضَىٰٓ أَوْ عَلَىٰ سَفَرٍ أَوْ جَآءَ أَحَدٌ مِّنكُم مِّنَ ٱلْغَآئِطِ أَوْ لَٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟ مَآءً فَتَيَمَّمُوا۟ صَعِيدًا طَيِّبًا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُمْۗ إِنَّ ٱللَّهَ كَانَ عَفُوًّا غَفُورًا ", "translation": "O you who have believed, do not approach prayer while you are intoxicated until you know what you are saying[1] or in a state of janābah,[2] except those passing through [a place of prayer], until you have washed [your whole body]. And if you are ill or on a journey or one of you comes from the place of relieving himself or you have contacted women [i.e., had sexual intercourse] and find no water, then seek clean earth and wipe over your faces and your hands [with it]. Indeed, Allāh is ever Pardoning[3] and Forgiving.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَقْرَبُوا۟", "translit": "۟āwُbَrْqَt", "root": "قرب"}, {"id": 6, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 7, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 8, "arabic": "سُكَٰرَىٰ", "translit": "ٰàَrَٰkُs", "root": "سكر"}, {"id": 9, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 10, "arabic": "تَعْلَمُوا۟", "translit": "۟āwُmَlْʿعَt", "root": "علم"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "تَقُولُونَ", "translit": "َnwُlwُqَt", "root": "قول"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "جُنُبًا", "translit": "āًbُnُjg", "root": "جنب"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "عَابِرِى", "translit": "àِrِbāَʿع", "root": "عبر"}, {"id": 17, "arabic": "سَبِيلٍ", "translit": "ٍlyِbَs", "root": "سبل"}, {"id": 18, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 19, "arabic": "تَغْتَسِلُوا۟", "translit": "۟āwُlِsَtْغَt", "root": "غسل"}, {"id": 20, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 21, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 22, "arabic": "مَّرْضَىٰٓ", "translit": "ٰٓàَḍْrَّm", "root": "مرض"}, {"id": 23, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 24, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 25, "arabic": "سَفَرٍ", "translit": "ٍrَfَs", "root": "سفر"}, {"id": 26, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 27, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 28, "arabic": "أَحَدٌ", "translit": "ٌdَḥَaʾ", "root": "احد"}, {"id": 29, "arabic": "مِّنكُم", "translit": "mُknِّm", "root": ""}, {"id": 30, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 31, "arabic": "ٱلْغَآئِطِ", "translit": "ِṭِyʾٓāَغْlٱ", "root": "غوط"}, {"id": 32, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 33, "arabic": "لَٰمَسْتُمُ", "translit": "ُmُtْsَmَٰl", "root": "لمس"}, {"id": 34, "arabic": "ٱلنِّسَآءَ", "translit": "َءٓāَsِّnlٱ", "root": "نسو"}, {"id": 35, "arabic": "فَلَمْ", "translit": "ْmَlَf", "root": ""}, {"id": 36, "arabic": "تَجِدُوا۟", "translit": "۟āwُdِjgَt", "root": "وجد"}, {"id": 37, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 38, "arabic": "فَتَيَمَّمُوا۟", "translit": "۟āwُmَّmَyَtَf", "root": "يمم"}, {"id": 39, "arabic": "صَعِيدًا", "translit": "āًdyِʿعَṣ", "root": "صعد"}, {"id": 40, "arabic": "طَيِّبًا", "translit": "āًbِّyَṭ", "root": "طيب"}, {"id": 41, "arabic": "فَٱمْسَحُوا۟", "translit": "۟āwُḥَsْmٱَf", "root": "مسح"}, {"id": 42, "arabic": "بِوُجُوهِكُمْ", "translit": "ْmُkِhwُjgُwِb", "root": "وجه"}, {"id": 43, "arabic": "وَأَيْدِيكُمْ", "translit": "ْmُkyِdْyَaʾَw", "root": "يدي"}, {"id": 44, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 45, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 46, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 47, "arabic": "عَفُوًّا", "translit": "āًّwُfَʿع", "root": "عفو"}, {"id": 48, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}], "hasIhya": true}, {"ayah": 44, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ أُوتُوا۟ نَصِيبًا مِّنَ ٱلْكِتَٰبِ يَشْتَرُونَ ٱلضَّلَٰلَةَ وَيُرِيدُونَ أَن تَضِلُّوا۟ ٱلسَّبِيلَ ", "translation": "Have you not seen those who were given a portion of the Scripture, purchasing error [in exchange for it] and wishing you would lose the way?", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 6, "arabic": "نَصِيبًا", "translit": "āًbyِṣَn", "root": "نصب"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 9, "arabic": "يَشْتَرُونَ", "translit": "َnwُrَtْhsَy", "root": "شري"}, {"id": 10, "arabic": "ٱلضَّلَٰلَةَ", "translit": "َẗَlَٰlَّḍlٱ", "root": "ضلل"}, {"id": 11, "arabic": "وَيُرِيدُونَ", "translit": "َnwُdyِrُyَw", "root": "رود"}, {"id": 12, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 13, "arabic": "تَضِلُّوا۟", "translit": "۟āwُّlِḍَt", "root": "ضلل"}, {"id": 14, "arabic": "ٱلسَّبِيلَ", "translit": "َlyِbَّslٱ", "root": "سبل"}], "hasIhya": false}, {"ayah": 45, "text": "وَٱللَّهُ أَعْلَمُ بِأَعْدَآئِكُمْۚ وَكَفَىٰ بِٱللَّهِ وَلِيًّا وَكَفَىٰ بِٱللَّهِ نَصِيرًا ", "translation": "And Allāh is most knowing of your enemies; and sufficient is Allāh as an ally, and sufficient is Allāh as a helper.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 3, "arabic": "بِأَعْدَآئِكُمْ", "translit": "ْmُkِyʾٓāَdْʿعَaʾِb", "root": "عدو"}, {"id": 4, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 7, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 8, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 9, "arabic": "نَصِيرًا", "translit": "āًryِṣَn", "root": "نصر"}], "hasIhya": true}, {"ayah": 46, "text": "مِّنَ ٱلَّذِينَ هَادُوا۟ يُحَرِّفُونَ ٱلْكَلِمَ عَن مَّوَاضِعِهِۦ وَيَقُولُونَ سَمِعْنَا وَعَصَيْنَا وَٱسْمَعْ غَيْرَ مُسْمَعٍ وَرَٰعِنَا لَيًّۢا بِأَلْسِنَتِهِمْ وَطَعْنًا فِى ٱلدِّينِۚ وَلَوْ أَنَّهُمْ قَالُوا۟ سَمِعْنَا وَأَطَعْنَا وَٱسْمَعْ وَٱنظُرْنَا لَكَانَ خَيْرًا لَّهُمْ وَأَقْوَمَ وَلَٰكِن لَّعَنَهُمُ ٱللَّهُ بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا ", "translation": "Among the Jews are those who distort words from their [proper] places [i.e., usages] and say, \"We hear and disobey\" and \"Hear but be not heard\" and \"Rāʿinā,\"[1] twisting their tongues and defaming the religion. And if they had said [instead], \"We hear and obey\" and \"Wait for us [to understand],\" it would have been better for them and more suitable. But Allāh has cursed them for their disbelief, so they believe not, except for a few.[2]", "words": [{"id": 1, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 4, "arabic": "يُحَرِّفُونَ", "translit": "َnwُfِّrَḥُy", "root": "حرف"}, {"id": 5, "arabic": "ٱلْكَلِمَ", "translit": "َmِlَkْlٱ", "root": "كلم"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "مَّوَاضِعِهِۦ", "translit": "ۦِhِʿعِḍāَwَّm", "root": "وضع"}, {"id": 8, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 9, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 10, "arabic": "وَعَصَيْنَا", "translit": "āَnْyَṣَʿعَw", "root": "عصي"}, {"id": 11, "arabic": "وَٱسْمَعْ", "translit": "ْʿعَmْsٱَw", "root": "سمع"}, {"id": 12, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 13, "arabic": "مُسْمَعٍ", "translit": "ٍʿعَmْsُm", "root": "سمع"}, {"id": 14, "arabic": "وَرَٰعِنَا", "translit": "āَnِʿعَٰrَw", "root": "رعي"}, {"id": 15, "arabic": "لَيًّۢا", "translit": "āًّۢyَl", "root": "لوي"}, {"id": 16, "arabic": "بِأَلْسِنَتِهِمْ", "translit": "ْmِhِtَnِsْlَaʾِb", "root": "لسن"}, {"id": 17, "arabic": "وَطَعْنًا", "translit": "āًnْʿعَṭَw", "root": "طعن"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 20, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 21, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 22, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 23, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 24, "arabic": "وَأَطَعْنَا", "translit": "āَnْʿعَṭَaʾَw", "root": "طوع"}, {"id": 25, "arabic": "وَٱسْمَعْ", "translit": "ْʿعَmْsٱَw", "root": "سمع"}, {"id": 26, "arabic": "وَٱنظُرْنَا", "translit": "āَnْrُẓnٱَw", "root": "نظر"}, {"id": 27, "arabic": "لَكَانَ", "translit": "َnāَkَl", "root": "كون"}, {"id": 28, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 29, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 30, "arabic": "وَأَقْوَمَ", "translit": "َmَwْqَaʾَw", "root": "قوم"}, {"id": 31, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 32, "arabic": "لَّعَنَهُمُ", "translit": "ُmُhَnَʿعَّl", "root": "لعن"}, {"id": 33, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 34, "arabic": "بِكُفْرِهِمْ", "translit": "ْmِhِrْfُkِb", "root": "كفر"}, {"id": 35, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 36, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 37, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 38, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}], "hasIhya": false}, {"ayah": 47, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ ءَامِنُوا۟ بِمَا نَزَّلْنَا مُصَدِّقًا لِّمَا مَعَكُم مِّن قَبْلِ أَن نَّطْمِسَ وُجُوهًا فَنَرُدَّهَا عَلَىٰٓ أَدْبَارِهَآ أَوْ نَلْعَنَهُمْ كَمَا لَعَنَّآ أَصْحَٰبَ ٱلسَّبْتِۚ وَكَانَ أَمْرُ ٱللَّهِ مَفْعُولًا ", "translation": "O you who were given the Scripture, believe in what We have sent down [to Prophet Muḥammad (ﷺ)], confirming that which is with you, before We obliterate faces and turn them toward their backs or curse them as We cursed the sabbath-breakers.[1] And ever is the matter [i.e., decree] of Allāh accomplished.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "ءَامِنُوا۟", "translit": "۟āwُnِmāَء", "root": "امن"}, {"id": 6, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 7, "arabic": "نَزَّلْنَا", "translit": "āَnْlَّzَn", "root": "نزل"}, {"id": 8, "arabic": "مُصَدِّقًا", "translit": "āًqِّdَṣُm", "root": "صدق"}, {"id": 9, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 10, "arabic": "مَعَكُم", "translit": "mُkَʿعَm", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "نَّطْمِسَ", "translit": "َsِmْṭَّn", "root": "طمس"}, {"id": 15, "arabic": "وُجُوهًا", "translit": "āًhwُjgُw", "root": "وجه"}, {"id": 16, "arabic": "فَنَرُدَّهَا", "translit": "āَhَّdُrَnَf", "root": "ردد"}, {"id": 17, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 18, "arabic": "أَدْبَارِهَآ", "translit": "ٓāَhِrāَbْdَaʾ", "root": "دبر"}, {"id": 19, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 20, "arabic": "نَلْعَنَهُمْ", "translit": "ْmُhَnَʿعْlَn", "root": "لعن"}, {"id": 21, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 22, "arabic": "لَعَنَّآ", "translit": "ٓāَّnَʿعَl", "root": "لعن"}, {"id": 23, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 24, "arabic": "ٱلسَّبْتِ", "translit": "ِtْbَّslٱ", "root": "سبت"}, {"id": 25, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 26, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 27, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "مَفْعُولًا", "translit": "āًlwُʿعْfَm", "root": "فعل"}], "hasIhya": false}, {"ayah": 48, "text": "إِنَّ ٱللَّهَ لَا يَغْفِرُ أَن يُشْرَكَ بِهِۦ وَيَغْفِرُ مَا دُونَ ذَٰلِكَ لِمَن يَشَآءُۚ وَمَن يُشْرِكْ بِٱللَّهِ فَقَدِ ٱفْتَرَىٰٓ إِثْمًا عَظِيمًا ", "translation": "Indeed, Allāh does not forgive association with Him, but He forgives what is less than that for whom He wills. And he who associates others with Allāh has certainly fabricated a tremendous sin.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَغْفِرُ", "translit": "ُrِfْغَy", "root": "غفر"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يُشْرَكَ", "translit": "َkَrْhsُy", "root": "شرك"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "وَيَغْفِرُ", "translit": "ُrِfْغَyَw", "root": "غفر"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "دُونَ", "translit": "َnwُd", "root": "دون"}, {"id": 11, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 12, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 13, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 14, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 15, "arabic": "يُشْرِكْ", "translit": "ْkِrْhsُy", "root": "شرك"}, {"id": 16, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 17, "arabic": "فَقَدِ", "translit": "ِdَqَf", "root": ""}, {"id": 18, "arabic": "ٱفْتَرَىٰٓ", "translit": "ٰٓàَrَtْfٱ", "root": "فري"}, {"id": 19, "arabic": "إِثْمًا", "translit": "āًmْhtِiʾ", "root": "اثم"}, {"id": 20, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 49, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ يُزَكُّونَ أَنفُسَهُمۚ بَلِ ٱللَّهُ يُزَكِّى مَن يَشَآءُ وَلَا يُظْلَمُونَ فَتِيلًا ", "translation": "Have you not seen those who claim themselves to be pure? Rather, Allāh purifies whom He wills, and injustice is not done to them, [even] as much as a thread [inside a date seed].", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يُزَكُّونَ", "translit": "َnwُّkَzُy", "root": "زكو"}, {"id": 6, "arabic": "أَنفُسَهُم", "translit": "mُhَsُfnَaʾ", "root": "نفس"}, {"id": 7, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "يُزَكِّى", "translit": "àِّkَzُy", "root": "زكو"}, {"id": 10, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 11, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}, {"id": 14, "arabic": "فَتِيلًا", "translit": "āًlyِtَf", "root": "فتل"}], "hasIhya": true}, {"ayah": 50, "text": "ٱنظُرْ كَيْفَ يَفْتَرُونَ عَلَى ٱللَّهِ ٱلْكَذِبَۖ وَكَفَىٰ بِهِۦٓ إِثْمًا مُّبِينًا ", "translation": "Look how they invent about Allāh untruth, and sufficient is that as a manifest sin.", "words": [{"id": 1, "arabic": "ٱنظُرْ", "translit": "ْrُẓnٱ", "root": "نظر"}, {"id": 2, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 3, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 7, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 8, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 9, "arabic": "إِثْمًا", "translit": "āًmْhtِiʾ", "root": "اثم"}, {"id": 10, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 51, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ أُوتُوا۟ نَصِيبًا مِّنَ ٱلْكِتَٰبِ يُؤْمِنُونَ بِٱلْجِبْتِ وَٱلطَّٰغُوتِ وَيَقُولُونَ لِلَّذِينَ كَفَرُوا۟ هَٰٓؤُلَآءِ أَهْدَىٰ مِنَ ٱلَّذِينَ ءَامَنُوا۟ سَبِيلًا ", "translation": "Have you not seen those who were given a portion of the Scripture, who believe in jibt [superstition] and ṭāghūt [false objects of worship] and say about the disbelievers, \"These are better guided than the believers as to the way\"?", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 6, "arabic": "نَصِيبًا", "translit": "āًbyِṣَn", "root": "نصب"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 9, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 10, "arabic": "بِٱلْجِبْتِ", "translit": "ِtْbِjgْlٱِb", "root": "جبت"}, {"id": 11, "arabic": "وَٱلطَّٰغُوتِ", "translit": "ِtwُغَّٰṭlٱَw", "root": "طغي"}, {"id": 12, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 13, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 14, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 15, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 16, "arabic": "أَهْدَىٰ", "translit": "ٰàَdْhَaʾ", "root": "هدي"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 19, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 20, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 52, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ لَعَنَهُمُ ٱللَّهُۖ وَمَن يَلْعَنِ ٱللَّهُ فَلَن تَجِدَ لَهُۥ نَصِيرًا ", "translation": "Those are the ones whom Allāh has cursed; and he whom Allāh curses - never will you find for him a helper.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَعَنَهُمُ", "translit": "ُmُhَnَʿعَl", "root": "لعن"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 6, "arabic": "يَلْعَنِ", "translit": "ِnَʿعْlَy", "root": "لعن"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "فَلَن", "translit": "nَlَf", "root": ""}, {"id": 9, "arabic": "تَجِدَ", "translit": "َdِjgَt", "root": "وجد"}, {"id": 10, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 11, "arabic": "نَصِيرًا", "translit": "āًryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 53, "text": "أَمْ لَهُمْ نَصِيبٌ مِّنَ ٱلْمُلْكِ فَإِذًا لَّا يُؤْتُونَ ٱلنَّاسَ نَقِيرًا ", "translation": "Or have they a share of dominion? Then [if that were so], they would not give the people [even as much as] the speck on a date seed.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "نَصِيبٌ", "translit": "ٌbyِṣَn", "root": "نصب"}, {"id": 4, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 5, "arabic": "ٱلْمُلْكِ", "translit": "ِkْlُmْlٱ", "root": "ملك"}, {"id": 6, "arabic": "فَإِذًا", "translit": "āًhdِiʾَf", "root": ""}, {"id": 7, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 8, "arabic": "يُؤْتُونَ", "translit": "َnwُtْwʾُy", "root": "اتي"}, {"id": 9, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 10, "arabic": "نَقِيرًا", "translit": "āًryِqَn", "root": "نقر"}], "hasIhya": false}, {"ayah": 54, "text": "أَمْ يَحْسُدُونَ ٱلنَّاسَ عَلَىٰ مَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦۖ فَقَدْ ءَاتَيْنَآ ءَالَ إِبْرَٰهِيمَ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ وَءَاتَيْنَٰهُم مُّلْكًا عَظِيمًا ", "translation": "Or do they envy people for what Allāh has given them of His bounty? But We had already given the family of Abraham the Scripture and wisdom[1] and conferred upon them a great kingdom.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "يَحْسُدُونَ", "translit": "َnwُdُsْḥَy", "root": "حسد"}, {"id": 3, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 6, "arabic": "ءَاتَىٰهُمُ", "translit": "ُmُhٰàَtāَء", "root": "اتي"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 10, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 11, "arabic": "ءَاتَيْنَآ", "translit": "ٓāَnْyَtāَء", "root": "اتي"}, {"id": 12, "arabic": "ءَالَ", "translit": "َlāَء", "root": "اول"}, {"id": 13, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 14, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 15, "arabic": "وَٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱَw", "root": "حكم"}, {"id": 16, "arabic": "وَءَاتَيْنَٰهُم", "translit": "mُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 17, "arabic": "مُّلْكًا", "translit": "āًkْlُّm", "root": "ملك"}, {"id": 18, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 55, "text": "فَمِنْهُم مَّنْ ءَامَنَ بِهِۦ وَمِنْهُم مَّن صَدَّ عَنْهُۚ وَكَفَىٰ بِجَهَنَّمَ سَعِيرًا ", "translation": "And some among them believed in it,[1] and some among them were averse to it. And sufficient is Hell as a blaze.", "words": [{"id": 1, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 2, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 3, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 4, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 5, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 6, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 7, "arabic": "صَدَّ", "translit": "َّdَṣ", "root": "صدد"}, {"id": 8, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 9, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 10, "arabic": "بِجَهَنَّمَ", "translit": "َmَّnَhَjgِb", "root": ""}, {"id": 11, "arabic": "سَعِيرًا", "translit": "āًryِʿعَs", "root": "سعر"}], "hasIhya": false}, {"ayah": 56, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِنَا سَوْفَ نُصْلِيهِمْ نَارًا كُلَّمَا نَضِجَتْ جُلُودُهُم بَدَّلْنَٰهُمْ جُلُودًا غَيْرَهَا لِيَذُوقُوا۟ ٱلْعَذَابَۗ إِنَّ ٱللَّهَ كَانَ عَزِيزًا حَكِيمًا ", "translation": "Indeed, those who disbelieve in Our verses - We will drive them into a fire. Every time their skins are roasted through, We will replace them with other skins so they may taste the punishment. Indeed, Allāh is ever Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "سَوْفَ", "translit": "َfْwَs", "root": ""}, {"id": 6, "arabic": "نُصْلِيهِمْ", "translit": "ْmِhyِlْṣُn", "root": "صلي"}, {"id": 7, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 8, "arabic": "كُلَّمَا", "translit": "āَmَّlُk", "root": "كلل"}, {"id": 9, "arabic": "نَضِجَتْ", "translit": "ْtَjgِḍَn", "root": "نضج"}, {"id": 10, "arabic": "جُلُودُهُم", "translit": "mُhُdwُlُjg", "root": "جلد"}, {"id": 11, "arabic": "بَدَّلْنَٰهُمْ", "translit": "ْmُhَٰnْlَّdَb", "root": "بدل"}, {"id": 12, "arabic": "جُلُودًا", "translit": "āًdwُlُjg", "root": "جلد"}, {"id": 13, "arabic": "غَيْرَهَا", "translit": "āَhَrْyَغ", "root": "غير"}, {"id": 14, "arabic": "لِيَذُوقُوا۟", "translit": "۟āwُqwُhdَyِl", "root": "ذوق"}, {"id": 15, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 16, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 19, "arabic": "عَزِيزًا", "translit": "āًzyِzَʿع", "root": "عزز"}, {"id": 20, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 57, "text": "وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَنُدْخِلُهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًاۖ لَّهُمْ فِيهَآ أَزْوَٰجٌ مُّطَهَّرَةٌۖ وَنُدْخِلُهُمْ ظِلًّا ظَلِيلًا ", "translation": "But those who believe and do righteous deeds - We will admit them to gardens beneath which rivers flow, wherein they abide forever. For them therein are purified spouses, and We will admit them to deepening shade.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 4, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 5, "arabic": "سَنُدْخِلُهُمْ", "translit": "ْmُhُlِhkْdُnَs", "root": "دخل"}, {"id": 6, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 7, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 10, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 11, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 12, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 13, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 14, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 15, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 16, "arabic": "أَزْوَٰجٌ", "translit": "ٌjgَٰwْzَaʾ", "root": "زوج"}, {"id": 17, "arabic": "مُّطَهَّرَةٌ", "translit": "ٌẗَrَّhَṭُّm", "root": "طهر"}, {"id": 18, "arabic": "وَنُدْخِلُهُمْ", "translit": "ْmُhُlِhkْdُnَw", "root": "دخل"}, {"id": 19, "arabic": "ظِلًّا", "translit": "āًّlِẓ", "root": "ظلل"}, {"id": 20, "arabic": "ظَلِيلًا", "translit": "āًlyِlَẓ", "root": "ظلل"}], "hasIhya": true}, {"ayah": 58, "text": "إِنَّ ٱللَّهَ يَأْمُرُكُمْ أَن تُؤَدُّوا۟ ٱلْأَمَٰنَٰتِ إِلَىٰٓ أَهْلِهَا وَإِذَا حَكَمْتُم بَيْنَ ٱلنَّاسِ أَن تَحْكُمُوا۟ بِٱلْعَدْلِۚ إِنَّ ٱللَّهَ نِعِمَّا يَعِظُكُم بِهِۦٓۗ إِنَّ ٱللَّهَ كَانَ سَمِيعًۢا بَصِيرًا ", "translation": "Indeed, Allāh commands you to render trusts to whom they are due and when you judge between people to judge with justice. Excellent is that which Allāh instructs you. Indeed, Allāh is ever Hearing and Seeing.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "يَأْمُرُكُمْ", "translit": "ْmُkُrُmْaʾَy", "root": "امر"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تُؤَدُّوا۟", "translit": "۟āwُّdَwʾُt", "root": "ادي"}, {"id": 6, "arabic": "ٱلْأَمَٰنَٰتِ", "translit": "ِtَٰnَٰmَaʾْlٱ", "root": "امن"}, {"id": 7, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 8, "arabic": "أَهْلِهَا", "translit": "āَhِlْhَaʾ", "root": "اهل"}, {"id": 9, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 10, "arabic": "حَكَمْتُم", "translit": "mُtْmَkَḥ", "root": "حكم"}, {"id": 11, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 12, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "تَحْكُمُوا۟", "translit": "۟āwُmُkْḥَt", "root": "حكم"}, {"id": 15, "arabic": "بِٱلْعَدْلِ", "translit": "ِlْdَʿعْlٱِb", "root": "عدل"}, {"id": 16, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "نِعِمَّا", "translit": "āَّmِʿعِn", "root": "نعم"}, {"id": 19, "arabic": "يَعِظُكُم", "translit": "mُkُẓِʿعَy", "root": "وعظ"}, {"id": 20, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 21, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 24, "arabic": "سَمِيعًۢا", "translit": "āًۢʿعyِmَs", "root": "سمع"}, {"id": 25, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 59, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ وَأُو۟لِى ٱلْأَمْرِ مِنكُمْۖ فَإِن تَنَٰزَعْتُمْ فِى شَىْءٍ فَرُدُّوهُ إِلَى ٱللَّهِ وَٱلرَّسُولِ إِن كُنتُمْ تُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِۚ ذَٰلِكَ خَيْرٌ وَأَحْسَنُ تَأْوِيلًا ", "translation": "O you who have believed, obey Allāh and obey the Messenger and those in authority among you. And if you disagree over anything, refer it to Allāh and the Messenger, if you should believe in Allāh and the Last Day. That is the best [way] and best in result.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "أَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾ", "root": "طوع"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَأَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾَw", "root": "طوع"}, {"id": 7, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 8, "arabic": "وَأُو۟لِى", "translit": "àِl۟wُaʾَw", "root": ""}, {"id": 9, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 10, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 11, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 12, "arabic": "تَنَٰزَعْتُمْ", "translit": "ْmُtْʿعَzَٰnَt", "root": "نزع"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 15, "arabic": "فَرُدُّوهُ", "translit": "ُhwُّdُrَf", "root": "ردد"}, {"id": 16, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَٱلرَّسُولِ", "translit": "ِlwُsَّrlٱَw", "root": "رسل"}, {"id": 19, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 20, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 21, "arabic": "تُؤْمِنُونَ", "translit": "َnwُnِmْwʾُt", "root": "امن"}, {"id": 22, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 23, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 24, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 25, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 26, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 27, "arabic": "وَأَحْسَنُ", "translit": "ُnَsْḥَaʾَw", "root": "حسن"}, {"id": 28, "arabic": "تَأْوِيلًا", "translit": "āًlyِwْaʾَt", "root": "اول"}], "hasIhya": true}, {"ayah": 60, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ يَزْعُمُونَ أَنَّهُمْ ءَامَنُوا۟ بِمَآ أُنزِلَ إِلَيْكَ وَمَآ أُنزِلَ مِن قَبْلِكَ يُرِيدُونَ أَن يَتَحَاكَمُوٓا۟ إِلَى ٱلطَّٰغُوتِ وَقَدْ أُمِرُوٓا۟ أَن يَكْفُرُوا۟ بِهِۦ وَيُرِيدُ ٱلشَّيْطَٰنُ أَن يُضِلَّهُمْ ضَلَٰلًۢا بَعِيدًا ", "translation": "Have you not seen those who claim to have believed in what was revealed to you, [O Muḥammad], and what was revealed before you? They wish to refer legislation to ṭāghūt,[1] while they were commanded to reject it; and Satan wishes to lead them far astray.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَزْعُمُونَ", "translit": "َnwُmُʿعْzَy", "root": "زعم"}, {"id": 6, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 9, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 10, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 11, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 12, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 15, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود"}, {"id": 16, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 17, "arabic": "يَتَحَاكَمُوٓا۟", "translit": "۟āٓwُmَkāَḥَtَy", "root": "حكم"}, {"id": 18, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 19, "arabic": "ٱلطَّٰغُوتِ", "translit": "ِtwُغَّٰṭlٱ", "root": "طغي"}, {"id": 20, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 21, "arabic": "أُمِرُوٓا۟", "translit": "۟āٓwُrِmُaʾ", "root": "امر"}, {"id": 22, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 23, "arabic": "يَكْفُرُوا۟", "translit": "۟āwُrُfْkَy", "root": "كفر"}, {"id": 24, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 25, "arabic": "وَيُرِيدُ", "translit": "ُdyِrُyَw", "root": "رود"}, {"id": 26, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 27, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 28, "arabic": "يُضِلَّهُمْ", "translit": "ْmُhَّlِḍُy", "root": "ضلل"}, {"id": 29, "arabic": "ضَلَٰلًۢا", "translit": "āًۢlَٰlَḍ", "root": "ضلل"}, {"id": 30, "arabic": "بَعِيدًا", "translit": "āًdyِʿعَb", "root": "بعد"}], "hasIhya": false}, {"ayah": 61, "text": "وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ رَأَيْتَ ٱلْمُنَٰفِقِينَ يَصُدُّونَ عَنكَ صُدُودًا ", "translation": "And when it is said to them, \"Come to what Allāh has revealed and to the Messenger,\" you see the hypocrites turning away from you in aversion.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "تَعَالَوْا۟", "translit": "۟āْwَlāَʿعَt", "root": "علو"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 7, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَإِلَى", "translit": "àَlِiʾَw", "root": ""}, {"id": 10, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 11, "arabic": "رَأَيْتَ", "translit": "َtْyَaʾَr", "root": "راي"}, {"id": 12, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 13, "arabic": "يَصُدُّونَ", "translit": "َnwُّdُṣَy", "root": "صدد"}, {"id": 14, "arabic": "عَنكَ", "translit": "َknَʿع", "root": ""}, {"id": 15, "arabic": "صُدُودًا", "translit": "āًdwُdُṣ", "root": "صدد"}], "hasIhya": false}, {"ayah": 62, "text": "فَكَيْفَ إِذَآ أَصَٰبَتْهُم مُّصِيبَةٌۢ بِمَا قَدَّمَتْ أَيْدِيهِمْ ثُمَّ جَآءُوكَ يَحْلِفُونَ بِٱللَّهِ إِنْ أَرَدْنَآ إِلَّآ إِحْسَٰنًا وَتَوْفِيقًا ", "translation": "So how [will it be] when disaster strikes them because of what their hands have put forth and then they come to you swearing by Allāh, \"We intended nothing but good conduct and accommodation.\"", "words": [{"id": 1, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 2, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَصَٰبَتْهُم", "translit": "mُhْtَbَٰṣَaʾ", "root": "صوب"}, {"id": 4, "arabic": "مُّصِيبَةٌۢ", "translit": "ٌۢẗَbyِṣُّm", "root": "صوب"}, {"id": 5, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 6, "arabic": "قَدَّمَتْ", "translit": "ْtَmَّdَq", "root": "قدم"}, {"id": 7, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "جَآءُوكَ", "translit": "َkwُءٓāَjg", "root": "جيا"}, {"id": 10, "arabic": "يَحْلِفُونَ", "translit": "َnwُfِlْḥَy", "root": "حلف"}, {"id": 11, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 12, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 13, "arabic": "أَرَدْنَآ", "translit": "ٓāَnْdَrَaʾ", "root": "رود"}, {"id": 14, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 15, "arabic": "إِحْسَٰنًا", "translit": "āًnَٰsْḥِiʾ", "root": "حسن"}, {"id": 16, "arabic": "وَتَوْفِيقًا", "translit": "āًqyِfْwَtَw", "root": "وفق"}], "hasIhya": false}, {"ayah": 63, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ يَعْلَمُ ٱللَّهُ مَا فِى قُلُوبِهِمْ فَأَعْرِضْ عَنْهُمْ وَعِظْهُمْ وَقُل لَّهُمْ فِىٓ أَنفُسِهِمْ قَوْلًۢا بَلِيغًا ", "translation": "Those are the ones of whom Allāh knows what is in their hearts, so turn away from them[1] but admonish them and speak to them a far-reaching [i.e., effective] word.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 8, "arabic": "فَأَعْرِضْ", "translit": "ْḍِrْʿعَaʾَf", "root": "عرض"}, {"id": 9, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 10, "arabic": "وَعِظْهُمْ", "translit": "ْmُhْẓِʿعَw", "root": "وعظ"}, {"id": 11, "arabic": "وَقُل", "translit": "lُqَw", "root": "قول"}, {"id": 12, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 13, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 14, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 15, "arabic": "قَوْلًۢا", "translit": "āًۢlْwَq", "root": "قول"}, {"id": 16, "arabic": "بَلِيغًا", "translit": "āًغyِlَb", "root": "بلغ"}], "hasIhya": false}, {"ayah": 64, "text": "وَمَآ أَرْسَلْنَا مِن رَّسُولٍ إِلَّا لِيُطَاعَ بِإِذْنِ ٱللَّهِۚ وَلَوْ أَنَّهُمْ إِذ ظَّلَمُوٓا۟ أَنفُسَهُمْ جَآءُوكَ فَٱسْتَغْفَرُوا۟ ٱللَّهَ وَٱسْتَغْفَرَ لَهُمُ ٱلرَّسُولُ لَوَجَدُوا۟ ٱللَّهَ تَوَّابًا رَّحِيمًا ", "translation": "And We did not send any messenger except to be obeyed by permission of Allāh. And if, when they wronged themselves, they had come to you, [O Muḥammad], and asked forgiveness of Allāh and the Messenger had asked forgiveness for them, they would have found Allāh Accepting of Repentance and Merciful.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "رَّسُولٍ", "translit": "ٍlwُsَّr", "root": "رسل"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "لِيُطَاعَ", "translit": "َʿعāَṭُyِl", "root": "طوع"}, {"id": 7, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 10, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 11, "arabic": "إِذ", "translit": "hdِiʾ", "root": ""}, {"id": 12, "arabic": "ظَّلَمُوٓا۟", "translit": "۟āٓwُmَlَّẓ", "root": "ظلم"}, {"id": 13, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 14, "arabic": "جَآءُوكَ", "translit": "َkwُءٓāَjg", "root": "جيا"}, {"id": 15, "arabic": "فَٱسْتَغْفَرُوا۟", "translit": "۟āwُrَfْغَtْsٱَf", "root": "غفر"}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَٱسْتَغْفَرَ", "translit": "َrَfْغَtْsٱَw", "root": "غفر"}, {"id": 18, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 19, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 20, "arabic": "لَوَجَدُوا۟", "translit": "۟āwُdَjgَwَl", "root": "وجد"}, {"id": 21, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "تَوَّابًا", "translit": "āًbāَّwَt", "root": "توب"}, {"id": 23, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 65, "text": "فَلَا وَرَبِّكَ لَا يُؤْمِنُونَ حَتَّىٰ يُحَكِّمُوكَ فِيمَا شَجَرَ بَيْنَهُمْ ثُمَّ لَا يَجِدُوا۟ فِىٓ أَنفُسِهِمْ حَرَجًا مِّمَّا قَضَيْتَ وَيُسَلِّمُوا۟ تَسْلِيمًا ", "translation": "But no, by your Lord, they will not [truly] believe until they make you, [O Muḥammad], judge concerning that over which they dispute among themselves and then find within themselves no discomfort from what you have judged and submit in [full, willing] submission.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "وَرَبِّكَ", "translit": "َkِّbَrَw", "root": "ربب"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 6, "arabic": "يُحَكِّمُوكَ", "translit": "َkwُmِّkَḥُy", "root": "حكم"}, {"id": 7, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 8, "arabic": "شَجَرَ", "translit": "َrَjgَhs", "root": "شجر"}, {"id": 9, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يَجِدُوا۟", "translit": "۟āwُdِjgَy", "root": "وجد"}, {"id": 13, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 14, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 15, "arabic": "حَرَجًا", "translit": "āًjgَrَḥ", "root": "حرج"}, {"id": 16, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 17, "arabic": "قَضَيْتَ", "translit": "َtْyَḍَq", "root": "قضي"}, {"id": 18, "arabic": "وَيُسَلِّمُوا۟", "translit": "۟āwُmِّlَsُyَw", "root": "سلم"}, {"id": 19, "arabic": "تَسْلِيمًا", "translit": "āًmyِlْsَt", "root": "سلم"}], "hasIhya": false}, {"ayah": 66, "text": "وَلَوْ أَنَّا كَتَبْنَا عَلَيْهِمْ أَنِ ٱقْتُلُوٓا۟ أَنفُسَكُمْ أَوِ ٱخْرُجُوا۟ مِن دِيَٰرِكُم مَّا فَعَلُوهُ إِلَّا قَلِيلٌ مِّنْهُمْۖ وَلَوْ أَنَّهُمْ فَعَلُوا۟ مَا يُوعَظُونَ بِهِۦ لَكَانَ خَيْرًا لَّهُمْ وَأَشَدَّ تَثْبِيتًا ", "translation": "And if We had decreed upon them, \"Kill yourselves\" or \"Leave your homes,\" they would not have done it, except for a few of them. But if they had done what they were instructed, it would have been better for them and a firmer position [for them in faith].", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 3, "arabic": "كَتَبْنَا", "translit": "āَnْbَtَk", "root": "كتب"}, {"id": 4, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 6, "arabic": "ٱقْتُلُوٓا۟", "translit": "۟āٓwُlُtْqٱ", "root": "قتل"}, {"id": 7, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 8, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 9, "arabic": "ٱخْرُجُوا۟", "translit": "۟āwُjgُrْhkٱ", "root": "خرج"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "دِيَٰرِكُم", "translit": "mُkِrَٰyِd", "root": "دور"}, {"id": 12, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 13, "arabic": "فَعَلُوهُ", "translit": "ُhwُlَʿعَf", "root": "فعل"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "قَلِيلٌ", "translit": "ٌlyِlَq", "root": "قلل"}, {"id": 16, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 17, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 18, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 19, "arabic": "فَعَلُوا۟", "translit": "۟āwُlَʿعَf", "root": "فعل"}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 21, "arabic": "يُوعَظُونَ", "translit": "َnwُẓَʿعwُy", "root": "وعظ"}, {"id": 22, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 23, "arabic": "لَكَانَ", "translit": "َnāَkَl", "root": "كون"}, {"id": 24, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 25, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 26, "arabic": "وَأَشَدَّ", "translit": "َّdَhsَaʾَw", "root": "شدد"}, {"id": 27, "arabic": "تَثْبِيتًا", "translit": "āًtyِbْhtَt", "root": "ثبت"}], "hasIhya": true}, {"ayah": 67, "text": "وَإِذًا لَّءَاتَيْنَٰهُم مِّن لَّدُنَّآ أَجْرًا عَظِيمًا ", "translation": "And then We would have given them from Us a great reward.", "words": [{"id": 1, "arabic": "وَإِذًا", "translit": "āًhdِiʾَw", "root": ""}, {"id": 2, "arabic": "لَّءَاتَيْنَٰهُم", "translit": "mُhَٰnْyَtāَءَّl", "root": "اتي"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "لَّدُنَّآ", "translit": "ٓāَّnُdَّl", "root": "لدن"}, {"id": 5, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 6, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 68, "text": "وَلَهَدَيْنَٰهُمْ صِرَٰطًا مُّسْتَقِيمًا ", "translation": "And We would have guided them to a straight path.", "words": [{"id": 1, "arabic": "وَلَهَدَيْنَٰهُمْ", "translit": "ْmُhَٰnْyَdَhَlَw", "root": "هدي"}, {"id": 2, "arabic": "صِرَٰطًا", "translit": "āًṭَٰrِṣ", "root": "صرط"}, {"id": 3, "arabic": "مُّسْتَقِيمًا", "translit": "āًmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 69, "text": "وَمَن يُطِعِ ٱللَّهَ وَٱلرَّسُولَ فَأُو۟لَٰٓئِكَ مَعَ ٱلَّذِينَ أَنْعَمَ ٱللَّهُ عَلَيْهِم مِّنَ ٱلنَّبِيِّۦنَ وَٱلصِّدِّيقِينَ وَٱلشُّهَدَآءِ وَٱلصَّٰلِحِينَۚ وَحَسُنَ أُو۟لَٰٓئِكَ رَفِيقًا ", "translation": "And whoever obeys Allāh and the Messenger - those will be with the ones upon whom Allāh has bestowed favor of the prophets, the steadfast affirmers of truth, the martyrs and the righteous. And excellent are those as companions.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يُطِعِ", "translit": "ِʿعِṭُy", "root": "طوع"}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَٱلرَّسُولَ", "translit": "َlwُsَّrlٱَw", "root": "رسل"}, {"id": 5, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 6, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "أَنْعَمَ", "translit": "َmَʿعْnَaʾ", "root": "نعم"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 12, "arabic": "ٱلنَّبِيِّۦنَ", "translit": "َnۦِّyِbَّnlٱ", "root": "نبا"}, {"id": 13, "arabic": "وَٱلصِّدِّيقِينَ", "translit": "َnyِqyِّdِّṣlٱَw", "root": "صدق"}, {"id": 14, "arabic": "وَٱلشُّهَدَآءِ", "translit": "ِءٓāَdَhُّhslٱَw", "root": "شهد"}, {"id": 15, "arabic": "وَٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱَw", "root": "صلح"}, {"id": 16, "arabic": "وَحَسُنَ", "translit": "َnُsَḥَw", "root": "حسن"}, {"id": 17, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 18, "arabic": "رَفِيقًا", "translit": "āًqyِfَr", "root": "رفق"}], "hasIhya": true}, {"ayah": 70, "text": "ذَٰلِكَ ٱلْفَضْلُ مِنَ ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ عَلِيمًا ", "translation": "That is the bounty from Allāh, and sufficient is Allāh as Knower.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "ٱلْفَضْلُ", "translit": "ُlْḍَfْlٱ", "root": "فضل"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 6, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 7, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 71, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ خُذُوا۟ حِذْرَكُمْ فَٱنفِرُوا۟ ثُبَاتٍ أَوِ ٱنفِرُوا۟ جَمِيعًا ", "translation": "O you who have believed, take your precaution and [either] go forth in companies or go forth all together.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "خُذُوا۟", "translit": "۟āwُhdُhk", "root": "اخذ"}, {"id": 5, "arabic": "حِذْرَكُمْ", "translit": "ْmُkَrْhdِḥ", "root": "حذر"}, {"id": 6, "arabic": "فَٱنفِرُوا۟", "translit": "۟āwُrِfnٱَf", "root": "نفر"}, {"id": 7, "arabic": "ثُبَاتٍ", "translit": "ٍtāَbُht", "root": "ثبي"}, {"id": 8, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 9, "arabic": "ٱنفِرُوا۟", "translit": "۟āwُrِfnٱ", "root": "نفر"}, {"id": 10, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}], "hasIhya": true}, {"ayah": 72, "text": "وَإِنَّ مِنكُمْ لَمَن لَّيُبَطِّئَنَّ فَإِنْ أَصَٰبَتْكُم مُّصِيبَةٌ قَالَ قَدْ أَنْعَمَ ٱللَّهُ عَلَىَّ إِذْ لَمْ أَكُن مَّعَهُمْ شَهِيدًا ", "translation": "And indeed, there is among you he who lingers behind; and if disaster strikes you, he says, \"Allāh has favored me in that I was not present with them.\"", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 3, "arabic": "لَمَن", "translit": "nَmَl", "root": ""}, {"id": 4, "arabic": "لَّيُبَطِّئَنَّ", "translit": "َّnَyʾِّṭَbُyَّl", "root": "بطا"}, {"id": 5, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 6, "arabic": "أَصَٰبَتْكُم", "translit": "mُkْtَbَٰṣَaʾ", "root": "صوب"}, {"id": 7, "arabic": "مُّصِيبَةٌ", "translit": "ٌẗَbyِṣُّm", "root": "صوب"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 10, "arabic": "أَنْعَمَ", "translit": "َmَʿعْnَaʾ", "root": "نعم"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "عَلَىَّ", "translit": "َّàَlَʿع", "root": ""}, {"id": 13, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 14, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 15, "arabic": "أَكُن", "translit": "nُkَaʾ", "root": "كون"}, {"id": 16, "arabic": "مَّعَهُمْ", "translit": "ْmُhَʿعَّm", "root": ""}, {"id": 17, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}], "hasIhya": true}, {"ayah": 73, "text": "وَلَئِنْ أَصَٰبَكُمْ فَضْلٌ مِّنَ ٱللَّهِ لَيَقُولَنَّ كَأَن لَّمْ تَكُنۢ بَيْنَكُمْ وَبَيْنَهُۥ مَوَدَّةٌ يَٰلَيْتَنِى كُنتُ مَعَهُمْ فَأَفُوزَ فَوْزًا عَظِيمًا ", "translation": "But if bounty comes to you from Allāh, he will surely say, as if [i.e., showing that] there had never been between you and him any affection, \"Oh, I wish I had been with them so I could have attained a great attainment.\"[1]", "words": [{"id": 1, "arabic": "وَلَئِنْ", "translit": "ْnِyʾَlَw", "root": ""}, {"id": 2, "arabic": "أَصَٰبَكُمْ", "translit": "ْmُkَbَٰṣَaʾ", "root": "صوب"}, {"id": 3, "arabic": "فَضْلٌ", "translit": "ٌlْḍَf", "root": "فضل"}, {"id": 4, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "لَيَقُولَنَّ", "translit": "َّnَlwُqَyَl", "root": "قول"}, {"id": 7, "arabic": "كَأَن", "translit": "nَaʾَk", "root": ""}, {"id": 8, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 9, "arabic": "تَكُنۢ", "translit": "ۢnُkَt", "root": "كون"}, {"id": 10, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 11, "arabic": "وَبَيْنَهُۥ", "translit": "ۥُhَnْyَbَw", "root": "بين"}, {"id": 12, "arabic": "مَوَدَّةٌ", "translit": "ٌẗَّdَwَm", "root": "ودد"}, {"id": 13, "arabic": "يَٰلَيْتَنِى", "translit": "àِnَtْyَlَٰy", "root": ""}, {"id": 14, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 15, "arabic": "مَعَهُمْ", "translit": "ْmُhَʿعَm", "root": ""}, {"id": 16, "arabic": "فَأَفُوزَ", "translit": "َzwُfَaʾَf", "root": "فوز"}, {"id": 17, "arabic": "فَوْزًا", "translit": "āًzْwَf", "root": "فوز"}, {"id": 18, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 74, "text": "فَلْيُقَٰتِلْ فِى سَبِيلِ ٱللَّهِ ٱلَّذِينَ يَشْرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا بِٱلْءَاخِرَةِۚ وَمَن يُقَٰتِلْ فِى سَبِيلِ ٱللَّهِ فَيُقْتَلْ أَوْ يَغْلِبْ فَسَوْفَ نُؤْتِيهِ أَجْرًا عَظِيمًا ", "translation": "So let those fight in the cause of Allāh who sell the life of this world for the Hereafter. And he who fights in the cause of Allāh and is killed or achieves victory - We will bestow upon him a great reward.", "words": [{"id": 1, "arabic": "فَلْيُقَٰتِلْ", "translit": "ْlِtَٰqُyْlَf", "root": "قتل"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "يَشْرُونَ", "translit": "َnwُrْhsَy", "root": "شري"}, {"id": 7, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 8, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 9, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 10, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 11, "arabic": "يُقَٰتِلْ", "translit": "ْlِtَٰqُy", "root": "قتل"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "فَيُقْتَلْ", "translit": "ْlَtْqُyَf", "root": "قتل"}, {"id": 16, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 17, "arabic": "يَغْلِبْ", "translit": "ْbِlْغَy", "root": "غلب"}, {"id": 18, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 19, "arabic": "نُؤْتِيهِ", "translit": "ِhyِtْwʾُn", "root": "اتي"}, {"id": 20, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 21, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 75, "text": "وَمَا لَكُمْ لَا تُقَٰتِلُونَ فِى سَبِيلِ ٱللَّهِ وَٱلْمُسْتَضْعَفِينَ مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ وَٱلْوِلْدَٰنِ ٱلَّذِينَ يَقُولُونَ رَبَّنَآ أَخْرِجْنَا مِنْ هَٰذِهِ ٱلْقَرْيَةِ ٱلظَّالِمِ أَهْلُهَا وَٱجْعَل لَّنَا مِن لَّدُنكَ وَلِيًّا وَٱجْعَل لَّنَا مِن لَّدُنكَ نَصِيرًا ", "translation": "And what is [the matter] with you that you fight not in the cause of Allāh and [for] the oppressed among men, women and children who say, \"Our Lord, take us out of this city of oppressive people and appoint for us from Yourself a protector and appoint for us from Yourself a helper\"?", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "تُقَٰتِلُونَ", "translit": "َnwُlِtَٰqُt", "root": "قتل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَٱلْمُسْتَضْعَفِينَ", "translit": "َnyِfَʿعْḍَtْsُmْlٱَw", "root": "ضعف"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلرِّجَالِ", "translit": "ِlāَjgِّrlٱ", "root": "رجل"}, {"id": 11, "arabic": "وَٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱَw", "root": "نسو"}, {"id": 12, "arabic": "وَٱلْوِلْدَٰنِ", "translit": "ِnَٰdْlِwْlٱَw", "root": "ولد"}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 15, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 16, "arabic": "أَخْرِجْنَا", "translit": "āَnْjgِrْhkَaʾ", "root": "خرج"}, {"id": 17, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 18, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 19, "arabic": "ٱلْقَرْيَةِ", "translit": "ِẗَyْrَqْlٱ", "root": "قري"}, {"id": 20, "arabic": "ٱلظَّالِمِ", "translit": "ِmِlāَّẓlٱ", "root": "ظلم"}, {"id": 21, "arabic": "أَهْلُهَا", "translit": "āَhُlْhَaʾ", "root": "اهل"}, {"id": 22, "arabic": "وَٱجْعَل", "translit": "lَʿعْjgٱَw", "root": "جعل"}, {"id": 23, "arabic": "لَّنَا", "translit": "āَnَّl", "root": ""}, {"id": 24, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 25, "arabic": "لَّدُنكَ", "translit": "َknُdَّl", "root": "لدن"}, {"id": 26, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 27, "arabic": "وَٱجْعَل", "translit": "lَʿعْjgٱَw", "root": "جعل"}, {"id": 28, "arabic": "لَّنَا", "translit": "āَnَّl", "root": ""}, {"id": 29, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 30, "arabic": "لَّدُنكَ", "translit": "َknُdَّl", "root": "لدن"}, {"id": 31, "arabic": "نَصِيرًا", "translit": "āًryِṣَn", "root": "نصر"}], "hasIhya": true}, {"ayah": 76, "text": "ٱلَّذِينَ ءَامَنُوا۟ يُقَٰتِلُونَ فِى سَبِيلِ ٱللَّهِۖ وَٱلَّذِينَ كَفَرُوا۟ يُقَٰتِلُونَ فِى سَبِيلِ ٱلطَّٰغُوتِ فَقَٰتِلُوٓا۟ أَوْلِيَآءَ ٱلشَّيْطَٰنِۖ إِنَّ كَيْدَ ٱلشَّيْطَٰنِ كَانَ ضَعِيفًا ", "translation": "Those who believe fight in the cause of Allāh, and those who disbelieve fight in the cause of ṭāghūt.[1] So fight against the allies of Satan. Indeed, the plot of Satan has ever been weak.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "يُقَٰتِلُونَ", "translit": "َnwُlِtَٰqُy", "root": "قتل"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 8, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 9, "arabic": "يُقَٰتِلُونَ", "translit": "َnwُlِtَٰqُy", "root": "قتل"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 12, "arabic": "ٱلطَّٰغُوتِ", "translit": "ِtwُغَّٰṭlٱ", "root": "طغي"}, {"id": 13, "arabic": "فَقَٰتِلُوٓا۟", "translit": "۟āٓwُlِtَٰqَf", "root": "قتل"}, {"id": 14, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 15, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 16, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 17, "arabic": "كَيْدَ", "translit": "َdْyَk", "root": "كيد"}, {"id": 18, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 19, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 20, "arabic": "ضَعِيفًا", "translit": "āًfyِʿعَḍ", "root": "ضعف"}], "hasIhya": false}, {"ayah": 77, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ قِيلَ لَهُمْ كُفُّوٓا۟ أَيْدِيَكُمْ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ فَلَمَّا كُتِبَ عَلَيْهِمُ ٱلْقِتَالُ إِذَا فَرِيقٌ مِّنْهُمْ يَخْشَوْنَ ٱلنَّاسَ كَخَشْيَةِ ٱللَّهِ أَوْ أَشَدَّ خَشْيَةًۚ وَقَالُوا۟ رَبَّنَا لِمَ كَتَبْتَ عَلَيْنَا ٱلْقِتَالَ لَوْلَآ أَخَّرْتَنَآ إِلَىٰٓ أَجَلٍ قَرِيبٍۗ قُلْ مَتَٰعُ ٱلدُّنْيَا قَلِيلٌ وَٱلْءَاخِرَةُ خَيْرٌ لِّمَنِ ٱتَّقَىٰ وَلَا تُظْلَمُونَ فَتِيلًا ", "translation": "Have you not seen those who were told, \"Restrain your hands [from fighting][1] and establish prayer and give zakāh\"? But then when battle was ordained for them, at once a party of them feared men as they fear Allāh or with [even] greater fear. They said, \"Our Lord, why have You decreed upon us fighting? If only You had postponed [it for] us for a short time.\" Say, \"The enjoyment of this world is little, and the Hereafter is better for he who fears Allāh. And injustice will not be done to you, [even] as much as a thread [inside a date seed].\"", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "كُفُّوٓا۟", "translit": "۟āٓwُّfُk", "root": "كفف"}, {"id": 8, "arabic": "أَيْدِيَكُمْ", "translit": "ْmُkَyِdْyَaʾ", "root": "يدي"}, {"id": 9, "arabic": "وَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَw", "root": "قوم"}, {"id": 10, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 11, "arabic": "وَءَاتُوا۟", "translit": "۟āwُtāَءَw", "root": "اتي"}, {"id": 12, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 13, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 14, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 15, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 16, "arabic": "ٱلْقِتَالُ", "translit": "ُlāَtِqْlٱ", "root": "قتل"}, {"id": 17, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 18, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 19, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 20, "arabic": "يَخْشَوْنَ", "translit": "َnْwَhsْhkَy", "root": "خشي"}, {"id": 21, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 22, "arabic": "كَخَشْيَةِ", "translit": "ِẗَyْhsَhkَk", "root": "خشي"}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 25, "arabic": "أَشَدَّ", "translit": "َّdَhsَaʾ", "root": "شدد"}, {"id": 26, "arabic": "خَشْيَةً", "translit": "ًẗَyْhsَhk", "root": "خشي"}, {"id": 27, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 28, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 29, "arabic": "لِمَ", "translit": "َmِl", "root": ""}, {"id": 30, "arabic": "كَتَبْتَ", "translit": "َtْbَtَk", "root": "كتب"}, {"id": 31, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 32, "arabic": "ٱلْقِتَالَ", "translit": "َlāَtِqْlٱ", "root": "قتل"}, {"id": 33, "arabic": "لَوْلَآ", "translit": "ٓāَlْwَl", "root": ""}, {"id": 34, "arabic": "أَخَّرْتَنَآ", "translit": "ٓāَnَtْrَّhkَaʾ", "root": "اخر"}, {"id": 35, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 36, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 37, "arabic": "قَرِيبٍ", "translit": "ٍbyِrَq", "root": "قرب"}, {"id": 38, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 39, "arabic": "مَتَٰعُ", "translit": "ُʿعَٰtَm", "root": "متع"}, {"id": 40, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 41, "arabic": "قَلِيلٌ", "translit": "ٌlyِlَq", "root": "قلل"}, {"id": 42, "arabic": "وَٱلْءَاخِرَةُ", "translit": "ُẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 43, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 44, "arabic": "لِّمَنِ", "translit": "ِnَmِّl", "root": ""}, {"id": 45, "arabic": "ٱتَّقَىٰ", "translit": "ٰàَqَّtٱ", "root": "وقي"}, {"id": 46, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 47, "arabic": "تُظْلَمُونَ", "translit": "َnwُmَlْẓُt", "root": "ظلم"}, {"id": 48, "arabic": "فَتِيلًا", "translit": "āًlyِtَf", "root": "فتل"}], "hasIhya": true}, {"ayah": 78, "text": "أَيْنَمَا تَكُونُوا۟ يُدْرِككُّمُ ٱلْمَوْتُ وَلَوْ كُنتُمْ فِى بُرُوجٍ مُّشَيَّدَةٍۗ وَإِن تُصِبْهُمْ حَسَنَةٌ يَقُولُوا۟ هَٰذِهِۦ مِنْ عِندِ ٱللَّهِۖ وَإِن تُصِبْهُمْ سَيِّئَةٌ يَقُولُوا۟ هَٰذِهِۦ مِنْ عِندِكَۚ قُلْ كُلٌّ مِّنْ عِندِ ٱللَّهِۖ فَمَالِ هَٰٓؤُلَآءِ ٱلْقَوْمِ لَا يَكَادُونَ يَفْقَهُونَ حَدِيثًا ", "translation": "Wherever you may be, death will overtake you, even if you should be within towers of lofty construction. But if good comes to them, they say, \"This is from Allāh\"; and if evil befalls them, they say,[1] \"This is from you.\" Say, \"All [things] are from Allāh.\" So what is [the matter] with those people that they can hardly understand any statement?", "words": [{"id": 1, "arabic": "أَيْنَمَا", "translit": "āَmَnْyَaʾ", "root": ""}, {"id": 2, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 3, "arabic": "يُدْرِككُّمُ", "translit": "ُmُّkkِrْdُy", "root": "درك"}, {"id": 4, "arabic": "ٱلْمَوْتُ", "translit": "ُtْwَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "بُرُوجٍ", "translit": "ٍjgwُrُb", "root": "برج"}, {"id": 9, "arabic": "مُّشَيَّدَةٍ", "translit": "ٍẗَdَّyَhsُّm", "root": "شيد"}, {"id": 10, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 11, "arabic": "تُصِبْهُمْ", "translit": "ْmُhْbِṣُt", "root": "صوب"}, {"id": 12, "arabic": "حَسَنَةٌ", "translit": "ٌẗَnَsَḥ", "root": "حسن"}, {"id": 13, "arabic": "يَقُولُوا۟", "translit": "۟āwُlwُqَy", "root": "قول"}, {"id": 14, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 19, "arabic": "تُصِبْهُمْ", "translit": "ْmُhْbِṣُt", "root": "صوب"}, {"id": 20, "arabic": "سَيِّئَةٌ", "translit": "ٌẗَyʾِّyَs", "root": "سوا"}, {"id": 21, "arabic": "يَقُولُوا۟", "translit": "۟āwُlwُqَy", "root": "قول"}, {"id": 22, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": ""}, {"id": 23, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 24, "arabic": "عِندِكَ", "translit": "َkِdnِʿع", "root": "عند"}, {"id": 25, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 26, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 27, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 28, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 29, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "فَمَالِ", "translit": "ِlāَmَf", "root": ""}, {"id": 31, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 32, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 33, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 34, "arabic": "يَكَادُونَ", "translit": "َnwُdāَkَy", "root": "كود"}, {"id": 35, "arabic": "يَفْقَهُونَ", "translit": "َnwُhَqْfَy", "root": "فقه"}, {"id": 36, "arabic": "حَدِيثًا", "translit": "āًhtyِdَḥ", "root": "حدث"}], "hasIhya": true}, {"ayah": 79, "text": "مَّآ أَصَابَكَ مِنْ حَسَنَةٍ فَمِنَ ٱللَّهِۖ وَمَآ أَصَابَكَ مِن سَيِّئَةٍ فَمِن نَّفْسِكَۚ وَأَرْسَلْنَٰكَ لِلنَّاسِ رَسُولًاۚ وَكَفَىٰ بِٱللَّهِ شَهِيدًا ", "translation": "What comes to you of good is from Allāh, but what comes to you of evil, [O man], is from yourself.[1] And We have sent you, [O Muḥammad], to the people as a messenger, and sufficient is Allāh as Witness.[2]", "words": [{"id": 1, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 2, "arabic": "أَصَابَكَ", "translit": "َkَbāَṣَaʾ", "root": "صوب"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "حَسَنَةٍ", "translit": "ٍẗَnَsَḥ", "root": "حسن"}, {"id": 5, "arabic": "فَمِنَ", "translit": "َnِmَf", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 8, "arabic": "أَصَابَكَ", "translit": "َkَbāَṣَaʾ", "root": "صوب"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "سَيِّئَةٍ", "translit": "ٍẗَyʾِّyَs", "root": "سوا"}, {"id": 11, "arabic": "فَمِن", "translit": "nِmَf", "root": ""}, {"id": 12, "arabic": "نَّفْسِكَ", "translit": "َkِsْfَّn", "root": "نفس"}, {"id": 13, "arabic": "وَأَرْسَلْنَٰكَ", "translit": "َkَٰnْlَsْrَaʾَw", "root": "رسل"}, {"id": 14, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 15, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 16, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 17, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 18, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}], "hasIhya": true}, {"ayah": 80, "text": "مَّن يُطِعِ ٱلرَّسُولَ فَقَدْ أَطَاعَ ٱللَّهَۖ وَمَن تَوَلَّىٰ فَمَآ أَرْسَلْنَٰكَ عَلَيْهِمْ حَفِيظًا ", "translation": "He who obeys the Messenger has obeyed Allāh; but those who turn away - We have not sent you over them as a guardian.", "words": [{"id": 1, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 2, "arabic": "يُطِعِ", "translit": "ِʿعِṭُy", "root": "طوع"}, {"id": 3, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 4, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 5, "arabic": "أَطَاعَ", "translit": "َʿعāَṭَaʾ", "root": "طوع"}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "تَوَلَّىٰ", "translit": "ٰàَّlَwَt", "root": "ولي"}, {"id": 9, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 10, "arabic": "أَرْسَلْنَٰكَ", "translit": "َkَٰnْlَsْrَaʾ", "root": "رسل"}, {"id": 11, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "حَفِيظًا", "translit": "āًẓyِfَḥ", "root": "حفظ"}], "hasIhya": true}, {"ayah": 81, "text": "وَيَقُولُونَ طَاعَةٌ فَإِذَا بَرَزُوا۟ مِنْ عِندِكَ بَيَّتَ طَآئِفَةٌ مِّنْهُمْ غَيْرَ ٱلَّذِى تَقُولُۖ وَٱللَّهُ يَكْتُبُ مَا يُبَيِّتُونَۖ فَأَعْرِضْ عَنْهُمْ وَتَوَكَّلْ عَلَى ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا ", "translation": "And they say, \"[We pledge] obedience.\" But when they leave you, a group of them spend the night determining to do other than what you say. But Allāh records what they plan by night. So leave them alone and rely upon Allāh. And sufficient is Allāh as Disposer of affairs.", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "طَاعَةٌ", "translit": "ٌẗَʿعāَṭ", "root": "طوع"}, {"id": 3, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 4, "arabic": "بَرَزُوا۟", "translit": "۟āwُzَrَb", "root": "برز"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "عِندِكَ", "translit": "َkِdnِʿع", "root": "عند"}, {"id": 7, "arabic": "بَيَّتَ", "translit": "َtَّyَb", "root": "بيت"}, {"id": 8, "arabic": "طَآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 9, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 10, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 11, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "تَقُولُ", "translit": "ُlwُqَt", "root": "قول"}, {"id": 13, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 14, "arabic": "يَكْتُبُ", "translit": "ُbُtْkَy", "root": "كتب"}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "يُبَيِّتُونَ", "translit": "َnwُtِّyَbُy", "root": "بيت"}, {"id": 17, "arabic": "فَأَعْرِضْ", "translit": "ْḍِrْʿعَaʾَf", "root": "عرض"}, {"id": 18, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 19, "arabic": "وَتَوَكَّلْ", "translit": "ْlَّkَwَtَw", "root": "وكل"}, {"id": 20, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 23, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 24, "arabic": "وَكِيلًا", "translit": "āًlyِkَw", "root": "وكل"}], "hasIhya": false}, {"ayah": 82, "text": "أَفَلَا يَتَدَبَّرُونَ ٱلْقُرْءَانَۚ وَلَوْ كَانَ مِنْ عِندِ غَيْرِ ٱللَّهِ لَوَجَدُوا۟ فِيهِ ٱخْتِلَٰفًا كَثِيرًا ", "translation": "Then do they not reflect upon the Qur’ān?[1] If it had been from [any] other than Allāh, they would have found within it much contradiction.", "words": [{"id": 1, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 2, "arabic": "يَتَدَبَّرُونَ", "translit": "َnwُrَّbَdَtَy", "root": "دبر"}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 5, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 8, "arabic": "غَيْرِ", "translit": "ِrْyَغ", "root": "غير"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لَوَجَدُوا۟", "translit": "۟āwُdَjgَwَl", "root": "وجد"}, {"id": 11, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 12, "arabic": "ٱخْتِلَٰفًا", "translit": "āًfَٰlِtْhkٱ", "root": "خلف"}, {"id": 13, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": false}, {"ayah": 83, "text": "وَإِذَا جَآءَهُمْ أَمْرٌ مِّنَ ٱلْأَمْنِ أَوِ ٱلْخَوْفِ أَذَاعُوا۟ بِهِۦۖ وَلَوْ رَدُّوهُ إِلَى ٱلرَّسُولِ وَإِلَىٰٓ أُو۟لِى ٱلْأَمْرِ مِنْهُمْ لَعَلِمَهُ ٱلَّذِينَ يَسْتَنۢبِطُونَهُۥ مِنْهُمْۗ وَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ لَٱتَّبَعْتُمُ ٱلشَّيْطَٰنَ إِلَّا قَلِيلًا ", "translation": "And when there comes to them something [i.e., information] about [public] security or fear, they spread it around. But if they had referred it back to the Messenger or to those of authority among them, then the ones who [can] draw correct conclusions from it would have known about it. And if not for the favor of Allāh upon you and His mercy, you would have followed Satan, except for a few.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "أَمْرٌ", "translit": "ٌrْmَaʾ", "root": "امر"}, {"id": 4, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 5, "arabic": "ٱلْأَمْنِ", "translit": "ِnْmَaʾْlٱ", "root": "امن"}, {"id": 6, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 7, "arabic": "ٱلْخَوْفِ", "translit": "ِfْwَhkْlٱ", "root": "خوف"}, {"id": 8, "arabic": "أَذَاعُوا۟", "translit": "۟āwُʿعāَhdَaʾ", "root": "ذيع"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 11, "arabic": "رَدُّوهُ", "translit": "ُhwُّdَr", "root": "ردد"}, {"id": 12, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 13, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 14, "arabic": "وَإِلَىٰٓ", "translit": "ٰٓàَlِiʾَw", "root": ""}, {"id": 15, "arabic": "أُو۟لِى", "translit": "àِl۟wُaʾ", "root": ""}, {"id": 16, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 17, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 18, "arabic": "لَعَلِمَهُ", "translit": "ُhَmِlَʿعَl", "root": "علم"}, {"id": 19, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "يَسْتَنۢبِطُونَهُۥ", "translit": "ۥُhَnwُṭِbۢnَtْsَy", "root": "نبط"}, {"id": 21, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 22, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 23, "arabic": "فَضْلُ", "translit": "ُlْḍَf", "root": "فضل"}, {"id": 24, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 26, "arabic": "وَرَحْمَتُهُۥ", "translit": "ۥُhُtَmْḥَrَw", "root": "رحم"}, {"id": 27, "arabic": "لَٱتَّبَعْتُمُ", "translit": "ُmُtْʿعَbَّtٱَl", "root": "تبع"}, {"id": 28, "arabic": "ٱلشَّيْطَٰنَ", "translit": "َnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 29, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 30, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}], "hasIhya": true}, {"ayah": 84, "text": "فَقَٰتِلْ فِى سَبِيلِ ٱللَّهِ لَا تُكَلَّفُ إِلَّا نَفْسَكَۚ وَحَرِّضِ ٱلْمُؤْمِنِينَۖ عَسَى ٱللَّهُ أَن يَكُفَّ بَأْسَ ٱلَّذِينَ كَفَرُوا۟ۚ وَٱللَّهُ أَشَدُّ بَأْسًا وَأَشَدُّ تَنكِيلًا ", "translation": "So fight, [O Muḥammad], in the cause of Allāh; you are not held responsible except for yourself. And encourage the believers [to join you] that perhaps Allāh will restrain the [military] might of those who disbelieve. And Allāh is greater in might and stronger in [exemplary] punishment.[1]", "words": [{"id": 1, "arabic": "فَقَٰتِلْ", "translit": "ْlِtَٰqَf", "root": "قتل"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "تُكَلَّفُ", "translit": "ُfَّlَkُt", "root": "كلف"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "نَفْسَكَ", "translit": "َkَsْfَn", "root": "نفس"}, {"id": 9, "arabic": "وَحَرِّضِ", "translit": "ِḍِّrَḥَw", "root": "حرض"}, {"id": 10, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 11, "arabic": "عَسَى", "translit": "àَsَʿع", "root": "عسي"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "يَكُفَّ", "translit": "َّfُkَy", "root": "كفف"}, {"id": 15, "arabic": "بَأْسَ", "translit": "َsْaʾَb", "root": "باس"}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 18, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 19, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 20, "arabic": "بَأْسًا", "translit": "āًsْaʾَb", "root": "باس"}, {"id": 21, "arabic": "وَأَشَدُّ", "translit": "ُّdَhsَaʾَw", "root": "شدد"}, {"id": 22, "arabic": "تَنكِيلًا", "translit": "āًlyِknَt", "root": "نكل"}], "hasIhya": false}, {"ayah": 85, "text": "مَّن يَشْفَعْ شَفَٰعَةً حَسَنَةً يَكُن لَّهُۥ نَصِيبٌ مِّنْهَاۖ وَمَن يَشْفَعْ شَفَٰعَةً سَيِّئَةً يَكُن لَّهُۥ كِفْلٌ مِّنْهَاۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ مُّقِيتًا ", "translation": "Whoever intercedes for a good cause will have a share [i.e., reward] therefrom; and whoever intercedes for an evil cause will have a portion [i.e., burden] therefrom. And ever is Allāh, over all things, a Keeper.[1]", "words": [{"id": 1, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 2, "arabic": "يَشْفَعْ", "translit": "ْʿعَfْhsَy", "root": "شفع"}, {"id": 3, "arabic": "شَفَٰعَةً", "translit": "ًẗَʿعَٰfَhs", "root": "شفع"}, {"id": 4, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 5, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 6, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 7, "arabic": "نَصِيبٌ", "translit": "ٌbyِṣَn", "root": "نصب"}, {"id": 8, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "يَشْفَعْ", "translit": "ْʿعَfْhsَy", "root": "شفع"}, {"id": 11, "arabic": "شَفَٰعَةً", "translit": "ًẗَʿعَٰfَhs", "root": "شفع"}, {"id": 12, "arabic": "سَيِّئَةً", "translit": "ًẗَyʾِّyَs", "root": "سوا"}, {"id": 13, "arabic": "يَكُن", "translit": "nُkَy", "root": "كون"}, {"id": 14, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 15, "arabic": "كِفْلٌ", "translit": "ٌlْfِk", "root": "كفل"}, {"id": 16, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 17, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 20, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 21, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 22, "arabic": "مُّقِيتًا", "translit": "āًtyِqُّm", "root": "قوت"}], "hasIhya": false}, {"ayah": 86, "text": "وَإِذَا حُيِّيتُم بِتَحِيَّةٍ فَحَيُّوا۟ بِأَحْسَنَ مِنْهَآ أَوْ رُدُّوهَآۗ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَىْءٍ حَسِيبًا ", "translation": "And when you are greeted with a greeting, greet [in return] with one better than it or [at least] return it [in a like manner]. Indeed Allāh is ever, over all things, an Accountant.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "حُيِّيتُم", "translit": "mُtyِّyُḥ", "root": "حيي"}, {"id": 3, "arabic": "بِتَحِيَّةٍ", "translit": "ٍẗَّyِḥَtِb", "root": "حيي"}, {"id": 4, "arabic": "فَحَيُّوا۟", "translit": "۟āwُّyَḥَf", "root": "حيي"}, {"id": 5, "arabic": "بِأَحْسَنَ", "translit": "َnَsْḥَaʾِb", "root": "حسن"}, {"id": 6, "arabic": "مِنْهَآ", "translit": "ٓāَhْnِm", "root": ""}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "رُدُّوهَآ", "translit": "ٓāَhwُّdُr", "root": "ردد"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 12, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 13, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 14, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 15, "arabic": "حَسِيبًا", "translit": "āًbyِsَḥ", "root": "حسب"}], "hasIhya": true}, {"ayah": 87, "text": "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۚ لَيَجْمَعَنَّكُمْ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ لَا رَيْبَ فِيهِۗ وَمَنْ أَصْدَقُ مِنَ ٱللَّهِ حَدِيثًا ", "translation": "Allāh - there is no deity except Him. He will surely assemble you for [account on] the Day of Resurrection, about which there is no doubt. And who is more truthful than Allāh in statement.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 3, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "لَيَجْمَعَنَّكُمْ", "translit": "ْmُkَّnَʿعَmْjgَyَl", "root": "جمع"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 9, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 12, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 13, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 14, "arabic": "أَصْدَقُ", "translit": "ُqَdْṣَaʾ", "root": "صدق"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "حَدِيثًا", "translit": "āًhtyِdَḥ", "root": "حدث"}], "hasIhya": false}, {"ayah": 88, "text": "فَمَا لَكُمْ فِى ٱلْمُنَٰفِقِينَ فِئَتَيْنِ وَٱللَّهُ أَرْكَسَهُم بِمَا كَسَبُوٓا۟ۚ أَتُرِيدُونَ أَن تَهْدُوا۟ مَنْ أَضَلَّ ٱللَّهُۖ وَمَن يُضْلِلِ ٱللَّهُ فَلَن تَجِدَ لَهُۥ سَبِيلًا ", "translation": "What is [the matter] with you [that you are] two groups concerning the hypocrites,[1] while Allāh has made them fall back [into error and disbelief] for what they earned.[2] Do you wish to guide those whom Allāh has sent astray? And he whom Allāh sends astray - never will you find for him a way [of guidance].[3]", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 5, "arabic": "فِئَتَيْنِ", "translit": "ِnْyَtَyʾِf", "root": "فاي"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "أَرْكَسَهُم", "translit": "mُhَsَkْrَaʾ", "root": "ركس"}, {"id": 8, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 9, "arabic": "كَسَبُوٓا۟", "translit": "۟āٓwُbَsَk", "root": "كسب"}, {"id": 10, "arabic": "أَتُرِيدُونَ", "translit": "َnwُdyِrُtَaʾ", "root": "رود"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "تَهْدُوا۟", "translit": "۟āwُdْhَt", "root": "هدي"}, {"id": 13, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 14, "arabic": "أَضَلَّ", "translit": "َّlَḍَaʾ", "root": "ضلل"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 17, "arabic": "يُضْلِلِ", "translit": "ِlِlْḍُy", "root": "ضلل"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "فَلَن", "translit": "nَlَf", "root": ""}, {"id": 20, "arabic": "تَجِدَ", "translit": "َdِjgَt", "root": "وجد"}, {"id": 21, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 22, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 89, "text": "وَدُّوا۟ لَوْ تَكْفُرُونَ كَمَا كَفَرُوا۟ فَتَكُونُونَ سَوَآءًۖ فَلَا تَتَّخِذُوا۟ مِنْهُمْ أَوْلِيَآءَ حَتَّىٰ يُهَاجِرُوا۟ فِى سَبِيلِ ٱللَّهِۚ فَإِن تَوَلَّوْا۟ فَخُذُوهُمْ وَٱقْتُلُوهُمْ حَيْثُ وَجَدتُّمُوهُمْۖ وَلَا تَتَّخِذُوا۟ مِنْهُمْ وَلِيًّا وَلَا نَصِيرًا ", "translation": "They wish you would disbelieve as they disbelieved so you would be alike. So do not take from among them allies until they emigrate for the cause of Allāh. But if they turn away [i.e., refuse], then seize them and kill them [for their betrayal] wherever you find them and take not from among them any ally or helper,", "words": [{"id": 1, "arabic": "وَدُّوا۟", "translit": "۟āwُّdَw", "root": "ودد"}, {"id": 2, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 3, "arabic": "تَكْفُرُونَ", "translit": "َnwُrُfْkَt", "root": "كفر"}, {"id": 4, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 5, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 6, "arabic": "فَتَكُونُونَ", "translit": "َnwُnwُkَtَf", "root": "كون"}, {"id": 7, "arabic": "سَوَآءً", "translit": "ًءٓāَwَs", "root": "سوي"}, {"id": 8, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 9, "arabic": "تَتَّخِذُوا۟", "translit": "۟āwُhdِhkَّtَt", "root": "اخذ"}, {"id": 10, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 11, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 12, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 13, "arabic": "يُهَاجِرُوا۟", "translit": "۟āwُrِjgāَhُy", "root": "هجر"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 18, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 19, "arabic": "فَخُذُوهُمْ", "translit": "ْmُhwُhdُhkَf", "root": "اخذ"}, {"id": 20, "arabic": "وَٱقْتُلُوهُمْ", "translit": "ْmُhwُlُtْqٱَw", "root": "قتل"}, {"id": 21, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 22, "arabic": "وَجَدتُّمُوهُمْ", "translit": "ْmُhwُmُّtdَjgَw", "root": "وجد"}, {"id": 23, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 24, "arabic": "تَتَّخِذُوا۟", "translit": "۟āwُhdِhkَّtَt", "root": "اخذ"}, {"id": 25, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 26, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 27, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 28, "arabic": "نَصِيرًا", "translit": "āًryِṣَn", "root": "نصر"}], "hasIhya": true}, {"ayah": 90, "text": "إِلَّا ٱلَّذِينَ يَصِلُونَ إِلَىٰ قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم مِّيثَٰقٌ أَوْ جَآءُوكُمْ حَصِرَتْ صُدُورُهُمْ أَن يُقَٰتِلُوكُمْ أَوْ يُقَٰتِلُوا۟ قَوْمَهُمْۚ وَلَوْ شَآءَ ٱللَّهُ لَسَلَّطَهُمْ عَلَيْكُمْ فَلَقَٰتَلُوكُمْۚ فَإِنِ ٱعْتَزَلُوكُمْ فَلَمْ يُقَٰتِلُوكُمْ وَأَلْقَوْا۟ إِلَيْكُمُ ٱلسَّلَمَ فَمَا جَعَلَ ٱللَّهُ لَكُمْ عَلَيْهِمْ سَبِيلًا ", "translation": "Except for those who take refuge with a people between yourselves and whom is a treaty or those who come to you, their hearts strained at [the prospect of] fighting you or fighting their own people. And if Allāh had willed, He could have given them power over you, and they would have fought you. So if they remove themselves from you and do not fight you and offer you peace, then Allāh has not made for you a cause [for fighting] against them.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَصِلُونَ", "translit": "َnwُlِṣَy", "root": "وصل"}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "قَوْمٍۭ", "translit": "ٍۭmْwَq", "root": "قوم"}, {"id": 6, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 7, "arabic": "وَبَيْنَهُم", "translit": "mُhَnْyَbَw", "root": "بين"}, {"id": 8, "arabic": "مِّيثَٰقٌ", "translit": "ٌqَٰhtyِّm", "root": "وثق"}, {"id": 9, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 10, "arabic": "جَآءُوكُمْ", "translit": "ْmُkwُءٓāَjg", "root": "جيا"}, {"id": 11, "arabic": "حَصِرَتْ", "translit": "ْtَrِṣَḥ", "root": "حصر"}, {"id": 12, "arabic": "صُدُورُهُمْ", "translit": "ْmُhُrwُdُṣ", "root": "صدر"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "يُقَٰتِلُوكُمْ", "translit": "ْmُkwُlِtَٰqُy", "root": "قتل"}, {"id": 15, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 16, "arabic": "يُقَٰتِلُوا۟", "translit": "۟āwُlِtَٰqُy", "root": "قتل"}, {"id": 17, "arabic": "قَوْمَهُمْ", "translit": "ْmُhَmْwَq", "root": "قوم"}, {"id": 18, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 19, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "لَسَلَّطَهُمْ", "translit": "ْmُhَṭَّlَsَl", "root": "سلط"}, {"id": 22, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 23, "arabic": "فَلَقَٰتَلُوكُمْ", "translit": "ْmُkwُlَtَٰqَlَf", "root": "قتل"}, {"id": 24, "arabic": "فَإِنِ", "translit": "ِnِiʾَf", "root": ""}, {"id": 25, "arabic": "ٱعْتَزَلُوكُمْ", "translit": "ْmُkwُlَzَtْʿعٱ", "root": "عزل"}, {"id": 26, "arabic": "فَلَمْ", "translit": "ْmَlَf", "root": ""}, {"id": 27, "arabic": "يُقَٰتِلُوكُمْ", "translit": "ْmُkwُlِtَٰqُy", "root": "قتل"}, {"id": 28, "arabic": "وَأَلْقَوْا۟", "translit": "۟āْwَqْlَaʾَw", "root": "لقي"}, {"id": 29, "arabic": "إِلَيْكُمُ", "translit": "ُmُkْyَlِiʾ", "root": ""}, {"id": 30, "arabic": "ٱلسَّلَمَ", "translit": "َmَlَّslٱ", "root": "سلم"}, {"id": 31, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 32, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 33, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 34, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 35, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 36, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 91, "text": "سَتَجِدُونَ ءَاخَرِينَ يُرِيدُونَ أَن يَأْمَنُوكُمْ وَيَأْمَنُوا۟ قَوْمَهُمْ كُلَّ مَا رُدُّوٓا۟ إِلَى ٱلْفِتْنَةِ أُرْكِسُوا۟ فِيهَاۚ فَإِن لَّمْ يَعْتَزِلُوكُمْ وَيُلْقُوٓا۟ إِلَيْكُمُ ٱلسَّلَمَ وَيَكُفُّوٓا۟ أَيْدِيَهُمْ فَخُذُوهُمْ وَٱقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْۚ وَأُو۟لَٰٓئِكُمْ جَعَلْنَا لَكُمْ عَلَيْهِمْ سُلْطَٰنًا مُّبِينًا ", "translation": "You will find others who wish to obtain security from you and [to] obtain security from their people. Every time they are returned to [the influence of] disbelief, they fall back into it. So if they do not withdraw from you or offer you peace or restrain their hands, then seize them and kill them wherever you overtake them. And those - We have made for you against them a clear authorization.", "words": [{"id": 1, "arabic": "سَتَجِدُونَ", "translit": "َnwُdِjgَtَs", "root": "وجد"}, {"id": 2, "arabic": "ءَاخَرِينَ", "translit": "َnyِrَhkāَء", "root": "اخر"}, {"id": 3, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَأْمَنُوكُمْ", "translit": "ْmُkwُnَmْaʾَy", "root": "امن"}, {"id": 6, "arabic": "وَيَأْمَنُوا۟", "translit": "۟āwُnَmْaʾَyَw", "root": "امن"}, {"id": 7, "arabic": "قَوْمَهُمْ", "translit": "ْmُhَmْwَq", "root": "قوم"}, {"id": 8, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "رُدُّوٓا۟", "translit": "۟āٓwُّdُr", "root": "ردد"}, {"id": 11, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلْفِتْنَةِ", "translit": "ِẗَnْtِfْlٱ", "root": "فتن"}, {"id": 13, "arabic": "أُرْكِسُوا۟", "translit": "۟āwُsِkْrُaʾ", "root": "ركس"}, {"id": 14, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 15, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 16, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 17, "arabic": "يَعْتَزِلُوكُمْ", "translit": "ْmُkwُlِzَtْʿعَy", "root": "عزل"}, {"id": 18, "arabic": "وَيُلْقُوٓا۟", "translit": "۟āٓwُqْlُyَw", "root": "لقي"}, {"id": 19, "arabic": "إِلَيْكُمُ", "translit": "ُmُkْyَlِiʾ", "root": ""}, {"id": 20, "arabic": "ٱلسَّلَمَ", "translit": "َmَlَّslٱ", "root": "سلم"}, {"id": 21, "arabic": "وَيَكُفُّوٓا۟", "translit": "۟āٓwُّfُkَyَw", "root": "كفف"}, {"id": 22, "arabic": "أَيْدِيَهُمْ", "translit": "ْmُhَyِdْyَaʾ", "root": "يدي"}, {"id": 23, "arabic": "فَخُذُوهُمْ", "translit": "ْmُhwُhdُhkَf", "root": "اخذ"}, {"id": 24, "arabic": "وَٱقْتُلُوهُمْ", "translit": "ْmُhwُlُtْqٱَw", "root": "قتل"}, {"id": 25, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 26, "arabic": "ثَقِفْتُمُوهُمْ", "translit": "ْmُhwُmُtْfِqَht", "root": "ثقف"}, {"id": 27, "arabic": "وَأُو۟لَٰٓئِكُمْ", "translit": "ْmُkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 28, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 29, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 30, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 31, "arabic": "سُلْطَٰنًا", "translit": "āًnَٰṭْlُs", "root": "سلط"}, {"id": 32, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 92, "text": "وَمَا كَانَ لِمُؤْمِنٍ أَن يَقْتُلَ مُؤْمِنًا إِلَّا خَطَـًٔاۚ وَمَن قَتَلَ مُؤْمِنًا خَطَـًٔا فَتَحْرِيرُ رَقَبَةٍ مُّؤْمِنَةٍ وَدِيَةٌ مُّسَلَّمَةٌ إِلَىٰٓ أَهْلِهِۦٓ إِلَّآ أَن يَصَّدَّقُوا۟ۚ فَإِن كَانَ مِن قَوْمٍ عَدُوٍّ لَّكُمْ وَهُوَ مُؤْمِنٌ فَتَحْرِيرُ رَقَبَةٍ مُّؤْمِنَةٍۖ وَإِن كَانَ مِن قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم مِّيثَٰقٌ فَدِيَةٌ مُّسَلَّمَةٌ إِلَىٰٓ أَهْلِهِۦ وَتَحْرِيرُ رَقَبَةٍ مُّؤْمِنَةٍۖ فَمَن لَّمْ يَجِدْ فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ تَوْبَةً مِّنَ ٱللَّهِۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ", "translation": "And never is it for a believer to kill a believer except by mistake. And whoever kills a believer by mistake - then the freeing of a believing slave and a compensation payment [diyah] presented to his [i.e., the deceased's] family [is required], unless they give [up their right as] charity. But if he [i.e., the deceased] was from a people at war with you and he was a believer - then [only] the freeing of a believing slave; and if he was from a people with whom you have a treaty - then a compensation payment presented to his family and the freeing of a believing slave. And whoever does not find [one or cannot afford to buy one] - then [instead], a fast for two months consecutively,[1] [seeking] acceptance of repentance from Allāh.[2] And Allāh is ever Knowing and Wise.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِمُؤْمِنٍ", "translit": "ٍnِmْwʾُmِl", "root": "امن"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَقْتُلَ", "translit": "َlُtْqَy", "root": "قتل"}, {"id": 6, "arabic": "مُؤْمِنًا", "translit": "āًnِmْwʾُm", "root": "امن"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "خَطَـًٔا", "translit": "āًٔـَṭَhk", "root": "خطا"}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "قَتَلَ", "translit": "َlَtَq", "root": "قتل"}, {"id": 11, "arabic": "مُؤْمِنًا", "translit": "āًnِmْwʾُm", "root": "امن"}, {"id": 12, "arabic": "خَطَـًٔا", "translit": "āًٔـَṭَhk", "root": "خطا"}, {"id": 13, "arabic": "فَتَحْرِيرُ", "translit": "ُryِrْḥَtَf", "root": "حرر"}, {"id": 14, "arabic": "رَقَبَةٍ", "translit": "ٍẗَbَqَr", "root": "رقب"}, {"id": 15, "arabic": "مُّؤْمِنَةٍ", "translit": "ٍẗَnِmْwʾُّm", "root": "امن"}, {"id": 16, "arabic": "وَدِيَةٌ", "translit": "ٌẗَyِdَw", "root": "ودي"}, {"id": 17, "arabic": "مُّسَلَّمَةٌ", "translit": "ٌẗَmَّlَsُّm", "root": "سلم"}, {"id": 18, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 19, "arabic": "أَهْلِهِۦٓ", "translit": "ٓۦِhِlْhَaʾ", "root": "اهل"}, {"id": 20, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 21, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 22, "arabic": "يَصَّدَّقُوا۟", "translit": "۟āwُqَّdَّṣَy", "root": "صدق"}, {"id": 23, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 24, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 25, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 26, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 27, "arabic": "عَدُوٍّ", "translit": "ٍّwُdَʿع", "root": "عدو"}, {"id": 28, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 29, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 30, "arabic": "مُؤْمِنٌ", "translit": "ٌnِmْwʾُm", "root": "امن"}, {"id": 31, "arabic": "فَتَحْرِيرُ", "translit": "ُryِrْḥَtَf", "root": "حرر"}, {"id": 32, "arabic": "رَقَبَةٍ", "translit": "ٍẗَbَqَr", "root": "رقب"}, {"id": 33, "arabic": "مُّؤْمِنَةٍ", "translit": "ٍẗَnِmْwʾُّm", "root": "امن"}, {"id": 34, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 35, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 36, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 37, "arabic": "قَوْمٍۭ", "translit": "ٍۭmْwَq", "root": "قوم"}, {"id": 38, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 39, "arabic": "وَبَيْنَهُم", "translit": "mُhَnْyَbَw", "root": "بين"}, {"id": 40, "arabic": "مِّيثَٰقٌ", "translit": "ٌqَٰhtyِّm", "root": "وثق"}, {"id": 41, "arabic": "فَدِيَةٌ", "translit": "ٌẗَyِdَf", "root": "ودي"}, {"id": 42, "arabic": "مُّسَلَّمَةٌ", "translit": "ٌẗَmَّlَsُّm", "root": "سلم"}, {"id": 43, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 44, "arabic": "أَهْلِهِۦ", "translit": "ۦِhِlْhَaʾ", "root": "اهل"}, {"id": 45, "arabic": "وَتَحْرِيرُ", "translit": "ُryِrْḥَtَw", "root": "حرر"}, {"id": 46, "arabic": "رَقَبَةٍ", "translit": "ٍẗَbَqَr", "root": "رقب"}, {"id": 47, "arabic": "مُّؤْمِنَةٍ", "translit": "ٍẗَnِmْwʾُّm", "root": "امن"}, {"id": 48, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 49, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 50, "arabic": "يَجِدْ", "translit": "ْdِjgَy", "root": "وجد"}, {"id": 51, "arabic": "فَصِيَامُ", "translit": "ُmāَyِṣَf", "root": "صوم"}, {"id": 52, "arabic": "شَهْرَيْنِ", "translit": "ِnْyَrْhَhs", "root": "شهر"}, {"id": 53, "arabic": "مُتَتَابِعَيْنِ", "translit": "ِnْyَʿعِbāَtَtُm", "root": "تبع"}, {"id": 54, "arabic": "تَوْبَةً", "translit": "ًẗَbْwَt", "root": "توب"}, {"id": 55, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 56, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 57, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 58, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 59, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 60, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 93, "text": "وَمَن يَقْتُلْ مُؤْمِنًا مُّتَعَمِّدًا فَجَزَآؤُهُۥ جَهَنَّمُ خَٰلِدًا فِيهَا وَغَضِبَ ٱللَّهُ عَلَيْهِ وَلَعَنَهُۥ وَأَعَدَّ لَهُۥ عَذَابًا عَظِيمًا ", "translation": "But whoever kills a believer intentionally - his recompense is Hell, wherein he will abide eternally, and Allāh has become angry with him and has cursed him and has prepared for him a great punishment.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَقْتُلْ", "translit": "ْlُtْqَy", "root": "قتل"}, {"id": 3, "arabic": "مُؤْمِنًا", "translit": "āًnِmْwʾُm", "root": "امن"}, {"id": 4, "arabic": "مُّتَعَمِّدًا", "translit": "āًdِّmَʿعَtُّm", "root": "عمد"}, {"id": 5, "arabic": "فَجَزَآؤُهُۥ", "translit": "ۥُhُwʾٓāَzَjgَf", "root": "جزي"}, {"id": 6, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 7, "arabic": "خَٰلِدًا", "translit": "āًdِlَٰhk", "root": "خلد"}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "وَغَضِبَ", "translit": "َbِḍَغَw", "root": "غضب"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "وَلَعَنَهُۥ", "translit": "ۥُhَnَʿعَlَw", "root": "لعن"}, {"id": 13, "arabic": "وَأَعَدَّ", "translit": "َّdَʿعَaʾَw", "root": "عدد"}, {"id": 14, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 15, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 16, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 94, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا ضَرَبْتُمْ فِى سَبِيلِ ٱللَّهِ فَتَبَيَّنُوا۟ وَلَا تَقُولُوا۟ لِمَنْ أَلْقَىٰٓ إِلَيْكُمُ ٱلسَّلَٰمَ لَسْتَ مُؤْمِنًا تَبْتَغُونَ عَرَضَ ٱلْحَيَوٰةِ ٱلدُّنْيَا فَعِندَ ٱللَّهِ مَغَانِمُ كَثِيرَةٌۚ كَذَٰلِكَ كُنتُم مِّن قَبْلُ فَمَنَّ ٱللَّهُ عَلَيْكُمْ فَتَبَيَّنُوٓا۟ۚ إِنَّ ٱللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا ", "translation": "O you who have believed, when you go forth [to fight] in the cause of Allāh, investigate; and do not say to one who gives you [a greeting of] peace, \"You are not a believer,\"[1] aspiring for the goods of worldly life; for with Allāh are many acquisitions. You [yourselves] were like that before; then Allāh conferred His favor [i.e., guidance] upon you, so investigate. Indeed Allāh is ever, of what you do, Aware.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "ضَرَبْتُمْ", "translit": "ْmُtْbَrَḍ", "root": "ضرب"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "فَتَبَيَّنُوا۟", "translit": "۟āwُnَّyَbَtَf", "root": "بين"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 12, "arabic": "لِمَنْ", "translit": "ْnَmِl", "root": ""}, {"id": 13, "arabic": "أَلْقَىٰٓ", "translit": "ٰٓàَqْlَaʾ", "root": "لقي"}, {"id": 14, "arabic": "إِلَيْكُمُ", "translit": "ُmُkْyَlِiʾ", "root": ""}, {"id": 15, "arabic": "ٱلسَّلَٰمَ", "translit": "َmَٰlَّslٱ", "root": "سلم"}, {"id": 16, "arabic": "لَسْتَ", "translit": "َtْsَl", "root": "ليس"}, {"id": 17, "arabic": "مُؤْمِنًا", "translit": "āًnِmْwʾُm", "root": "امن"}, {"id": 18, "arabic": "تَبْتَغُونَ", "translit": "َnwُغَtْbَt", "root": "بغي"}, {"id": 19, "arabic": "عَرَضَ", "translit": "َḍَrَʿع", "root": "عرض"}, {"id": 20, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 21, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 22, "arabic": "فَعِندَ", "translit": "َdnِʿعَf", "root": "عند"}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "مَغَانِمُ", "translit": "ُmِnāَغَm", "root": "غنم"}, {"id": 25, "arabic": "كَثِيرَةٌ", "translit": "ٌẗَryِhtَk", "root": "كثر"}, {"id": 26, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 27, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 28, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 29, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 30, "arabic": "فَمَنَّ", "translit": "َّnَmَf", "root": "منن"}, {"id": 31, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 33, "arabic": "فَتَبَيَّنُوٓا۟", "translit": "۟āٓwُnَّyَbَtَf", "root": "بين"}, {"id": 34, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 35, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 36, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 37, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 38, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 39, "arabic": "خَبِيرًا", "translit": "āًryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 95, "text": "لَّا يَسْتَوِى ٱلْقَٰعِدُونَ مِنَ ٱلْمُؤْمِنِينَ غَيْرُ أُو۟لِى ٱلضَّرَرِ وَٱلْمُجَٰهِدُونَ فِى سَبِيلِ ٱللَّهِ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْۚ فَضَّلَ ٱللَّهُ ٱلْمُجَٰهِدِينَ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ عَلَى ٱلْقَٰعِدِينَ دَرَجَةًۚ وَكُلًّا وَعَدَ ٱللَّهُ ٱلْحُسْنَىٰۚ وَفَضَّلَ ٱللَّهُ ٱلْمُجَٰهِدِينَ عَلَى ٱلْقَٰعِدِينَ أَجْرًا عَظِيمًا ", "translation": "Not equal are those believers remaining [at home] - other than the disabled - and the mujāhideen, [who strive and fight] in the cause of Allāh with their wealth and their lives. Allāh has preferred the mujāhideen through their wealth and their lives over those who remain [behind], by degrees. And to all [i.e., both] Allāh has promised the best [reward]. But Allāh has preferred the mujāhideen over those who remain [behind] with a great reward -", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "يَسْتَوِى", "translit": "àِwَtْsَy", "root": "سوي"}, {"id": 3, "arabic": "ٱلْقَٰعِدُونَ", "translit": "َnwُdِʿعَٰqْlٱ", "root": "قعد"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 6, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 7, "arabic": "أُو۟لِى", "translit": "àِl۟wُaʾ", "root": ""}, {"id": 8, "arabic": "ٱلضَّرَرِ", "translit": "ِrَrَّḍlٱ", "root": "ضرر"}, {"id": 9, "arabic": "وَٱلْمُجَٰهِدُونَ", "translit": "َnwُdِhَٰjgُmْlٱَw", "root": "جهد"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "بِأَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾِb", "root": "مول"}, {"id": 14, "arabic": "وَأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾَw", "root": "نفس"}, {"id": 15, "arabic": "فَضَّلَ", "translit": "َlَّḍَf", "root": "فضل"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "ٱلْمُجَٰهِدِينَ", "translit": "َnyِdِhَٰjgُmْlٱ", "root": "جهد"}, {"id": 18, "arabic": "بِأَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾِb", "root": "مول"}, {"id": 19, "arabic": "وَأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾَw", "root": "نفس"}, {"id": 20, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 21, "arabic": "ٱلْقَٰعِدِينَ", "translit": "َnyِdِʿعَٰqْlٱ", "root": "قعد"}, {"id": 22, "arabic": "دَرَجَةً", "translit": "ًẗَjgَrَd", "root": "درج"}, {"id": 23, "arabic": "وَكُلًّا", "translit": "āًّlُkَw", "root": "كلل"}, {"id": 24, "arabic": "وَعَدَ", "translit": "َdَʿعَw", "root": "وعد"}, {"id": 25, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 27, "arabic": "وَفَضَّلَ", "translit": "َlَّḍَfَw", "root": "فضل"}, {"id": 28, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "ٱلْمُجَٰهِدِينَ", "translit": "َnyِdِhَٰjgُmْlٱ", "root": "جهد"}, {"id": 30, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 31, "arabic": "ٱلْقَٰعِدِينَ", "translit": "َnyِdِʿعَٰqْlٱ", "root": "قعد"}, {"id": 32, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 33, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 96, "text": "دَرَجَٰتٍ مِّنْهُ وَمَغْفِرَةً وَرَحْمَةًۚ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ", "translation": "Degrees [of high position] from Him and forgiveness and mercy. And Allāh is ever Forgiving and Merciful.", "words": [{"id": 1, "arabic": "دَرَجَٰتٍ", "translit": "ٍtَٰjgَrَd", "root": "درج"}, {"id": 2, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 3, "arabic": "وَمَغْفِرَةً", "translit": "ًẗَrِfْغَmَw", "root": "غفر"}, {"id": 4, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 5, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 8, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 97, "text": "إِنَّ ٱلَّذِينَ تَوَفَّىٰهُمُ ٱلْمَلَٰٓئِكَةُ ظَالِمِىٓ أَنفُسِهِمْ قَالُوا۟ فِيمَ كُنتُمْۖ قَالُوا۟ كُنَّا مُسْتَضْعَفِينَ فِى ٱلْأَرْضِۚ قَالُوٓا۟ أَلَمْ تَكُنْ أَرْضُ ٱللَّهِ وَٰسِعَةً فَتُهَاجِرُوا۟ فِيهَاۚ فَأُو۟لَٰٓئِكَ مَأْوَىٰهُمْ جَهَنَّمُۖ وَسَآءَتْ مَصِيرًا ", "translation": "Indeed, those whom the angels take [in death] while wronging themselves[1] - [the angels] will say, \"In what [condition] were you?\" They will say, \"We were oppressed in the land.\" They [the angels] will say, \"Was not the earth of Allāh spacious [enough] for you to emigrate therein?\" For those, their refuge is Hell - and evil it is as a destination.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "تَوَفَّىٰهُمُ", "translit": "ُmُhٰàَّfَwَt", "root": "وفي"}, {"id": 4, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 5, "arabic": "ظَالِمِىٓ", "translit": "ٓàِmِlāَẓ", "root": "ظلم"}, {"id": 6, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 7, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 8, "arabic": "فِيمَ", "translit": "َmyِf", "root": ""}, {"id": 9, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 10, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 11, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 12, "arabic": "مُسْتَضْعَفِينَ", "translit": "َnyِfَʿعْḍَtْsُm", "root": "ضعف"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 15, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 16, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 17, "arabic": "تَكُنْ", "translit": "ْnُkَt", "root": "كون"}, {"id": 18, "arabic": "أَرْضُ", "translit": "ُḍْrَaʾ", "root": "ارض"}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "وَٰسِعَةً", "translit": "ًẗَʿعِsَٰw", "root": "وسع"}, {"id": 21, "arabic": "فَتُهَاجِرُوا۟", "translit": "۟āwُrِjgāَhُtَf", "root": "هجر"}, {"id": 22, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 23, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 24, "arabic": "مَأْوَىٰهُمْ", "translit": "ْmُhٰàَwْaʾَm", "root": "اوي"}, {"id": 25, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 26, "arabic": "وَسَآءَتْ", "translit": "ْtَءٓāَsَw", "root": "سوا"}, {"id": 27, "arabic": "مَصِيرًا", "translit": "āًryِṣَm", "root": "صير"}], "hasIhya": true}, {"ayah": 98, "text": "إِلَّا ٱلْمُسْتَضْعَفِينَ مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ وَٱلْوِلْدَٰنِ لَا يَسْتَطِيعُونَ حِيلَةً وَلَا يَهْتَدُونَ سَبِيلًا ", "translation": "Except for the oppressed among men, women and children who cannot devise a plan nor are they directed to a way[1] -", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْمُسْتَضْعَفِينَ", "translit": "َnyِfَʿعْḍَtْsُmْlٱ", "root": "ضعف"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلرِّجَالِ", "translit": "ِlāَjgِّrlٱ", "root": "رجل"}, {"id": 5, "arabic": "وَٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱَw", "root": "نسو"}, {"id": 6, "arabic": "وَٱلْوِلْدَٰنِ", "translit": "ِnَٰdْlِwْlٱَw", "root": "ولد"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 9, "arabic": "حِيلَةً", "translit": "ًẗَlyِḥ", "root": "حول"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}, {"id": 12, "arabic": "سَبِيلًا", "translit": "āًlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 99, "text": "فَأُو۟لَٰٓئِكَ عَسَى ٱللَّهُ أَن يَعْفُوَ عَنْهُمْۚ وَكَانَ ٱللَّهُ عَفُوًّا غَفُورًا ", "translation": "For those it is expected that Allāh will pardon them, and Allāh is ever Pardoning[1] and Forgiving.", "words": [{"id": 1, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 2, "arabic": "عَسَى", "translit": "àَsَʿع", "root": "عسي"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَعْفُوَ", "translit": "َwُfْʿعَy", "root": "عفو"}, {"id": 6, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 7, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "عَفُوًّا", "translit": "āًّwُfَʿع", "root": "عفو"}, {"id": 10, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}], "hasIhya": false}, {"ayah": 100, "text": "وَمَن يُهَاجِرْ فِى سَبِيلِ ٱللَّهِ يَجِدْ فِى ٱلْأَرْضِ مُرَٰغَمًا كَثِيرًا وَسَعَةًۚ وَمَن يَخْرُجْ مِنۢ بَيْتِهِۦ مُهَاجِرًا إِلَى ٱللَّهِ وَرَسُولِهِۦ ثُمَّ يُدْرِكْهُ ٱلْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُۥ عَلَى ٱللَّهِۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ", "translation": "And whoever emigrates for the cause of Allāh will find on the earth many [alternative] locations and abundance. And whoever leaves his home as an emigrant to Allāh and His Messenger and then death overtakes him - his reward has already become incumbent upon Allāh. And Allāh is ever Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يُهَاجِرْ", "translit": "ْrِjgāَhُy", "root": "هجر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "يَجِدْ", "translit": "ْdِjgَy", "root": "وجد"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "مُرَٰغَمًا", "translit": "āًmَغَٰrُm", "root": "رغم"}, {"id": 10, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 11, "arabic": "وَسَعَةً", "translit": "ًẗَʿعَsَw", "root": "وسع"}, {"id": 12, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 13, "arabic": "يَخْرُجْ", "translit": "ْjgُrْhkَy", "root": "خرج"}, {"id": 14, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 15, "arabic": "بَيْتِهِۦ", "translit": "ۦِhِtْyَb", "root": "بيت"}, {"id": 16, "arabic": "مُهَاجِرًا", "translit": "āًrِjgāَhُm", "root": "هجر"}, {"id": 17, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 18, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 20, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 21, "arabic": "يُدْرِكْهُ", "translit": "ُhْkِrْdُy", "root": "درك"}, {"id": 22, "arabic": "ٱلْمَوْتُ", "translit": "ُtْwَmْlٱ", "root": "موت"}, {"id": 23, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 24, "arabic": "وَقَعَ", "translit": "َʿعَqَw", "root": "وقع"}, {"id": 25, "arabic": "أَجْرُهُۥ", "translit": "ۥُhُrْjgَaʾ", "root": "اجر"}, {"id": 26, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 27, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 29, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 31, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 101, "text": "وَإِذَا ضَرَبْتُمْ فِى ٱلْأَرْضِ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَقْصُرُوا۟ مِنَ ٱلصَّلَوٰةِ إِنْ خِفْتُمْ أَن يَفْتِنَكُمُ ٱلَّذِينَ كَفَرُوٓا۟ۚ إِنَّ ٱلْكَٰفِرِينَ كَانُوا۟ لَكُمْ عَدُوًّا مُّبِينًا ", "translation": "And when you travel throughout the land, there is no blame upon you for shortening the prayer,[1] [especially] if you fear that those who disbelieve may disrupt [or attack] you.[2] Indeed, the disbelievers are ever to you a clear enemy.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ضَرَبْتُمْ", "translit": "ْmُtْbَrَḍ", "root": "ضرب"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "فَلَيْسَ", "translit": "َsْyَlَf", "root": "ليس"}, {"id": 6, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 7, "arabic": "جُنَاحٌ", "translit": "ٌḥāَnُjg", "root": "جنح"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "تَقْصُرُوا۟", "translit": "۟āwُrُṣْqَt", "root": "قصر"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 12, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 13, "arabic": "خِفْتُمْ", "translit": "ْmُtْfِhk", "root": "خوف"}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "يَفْتِنَكُمُ", "translit": "ُmُkَnِtْfَy", "root": "فتن"}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 20, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 21, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 22, "arabic": "عَدُوًّا", "translit": "āًّwُdَʿع", "root": "عدو"}, {"id": 23, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 102, "text": "وَإِذَا كُنتَ فِيهِمْ فَأَقَمْتَ لَهُمُ ٱلصَّلَوٰةَ فَلْتَقُمْ طَآئِفَةٌ مِّنْهُم مَّعَكَ وَلْيَأْخُذُوٓا۟ أَسْلِحَتَهُمْ فَإِذَا سَجَدُوا۟ فَلْيَكُونُوا۟ مِن وَرَآئِكُمْ وَلْتَأْتِ طَآئِفَةٌ أُخْرَىٰ لَمْ يُصَلُّوا۟ فَلْيُصَلُّوا۟ مَعَكَ وَلْيَأْخُذُوا۟ حِذْرَهُمْ وَأَسْلِحَتَهُمْۗ وَدَّ ٱلَّذِينَ كَفَرُوا۟ لَوْ تَغْفُلُونَ عَنْ أَسْلِحَتِكُمْ وَأَمْتِعَتِكُمْ فَيَمِيلُونَ عَلَيْكُم مَّيْلَةً وَٰحِدَةًۚ وَلَا جُنَاحَ عَلَيْكُمْ إِن كَانَ بِكُمْ أَذًى مِّن مَّطَرٍ أَوْ كُنتُم مَّرْضَىٰٓ أَن تَضَعُوٓا۟ أَسْلِحَتَكُمْۖ وَخُذُوا۟ حِذْرَكُمْۗ إِنَّ ٱللَّهَ أَعَدَّ لِلْكَٰفِرِينَ عَذَابًا مُّهِينًا ", "translation": "And when you [i.e., the commander of an army] are among them and lead them in prayer,[1] let a group of them stand [in prayer] with you and let them carry their arms. And when they have prostrated, let them be [in position] behind you and have the other group come forward which has not [yet] prayed and let them pray with you, taking precaution and carrying their arms. Those who disbelieve wish that you would neglect your weapons and your baggage so they could come down upon you in one [single] attack. But there is no blame upon you, if you are troubled by rain or are ill, for putting down your arms, but take precaution. Indeed, Allāh has prepared for the disbelievers a humiliating punishment.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 3, "arabic": "فِيهِمْ", "translit": "ْmِhyِf", "root": ""}, {"id": 4, "arabic": "فَأَقَمْتَ", "translit": "َtْmَqَaʾَf", "root": "قوم"}, {"id": 5, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 6, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 7, "arabic": "فَلْتَقُمْ", "translit": "ْmُqَtْlَf", "root": "قوم"}, {"id": 8, "arabic": "طَآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 9, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 10, "arabic": "مَّعَكَ", "translit": "َkَʿعَّm", "root": ""}, {"id": 11, "arabic": "وَلْيَأْخُذُوٓا۟", "translit": "۟āٓwُhdُhkْaʾَyْlَw", "root": "اخذ"}, {"id": 12, "arabic": "أَسْلِحَتَهُمْ", "translit": "ْmُhَtَḥِlْsَaʾ", "root": "سلح"}, {"id": 13, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 14, "arabic": "سَجَدُوا۟", "translit": "۟āwُdَjgَs", "root": "سجد"}, {"id": 15, "arabic": "فَلْيَكُونُوا۟", "translit": "۟āwُnwُkَyْlَf", "root": "كون"}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "وَرَآئِكُمْ", "translit": "ْmُkِyʾٓāَrَw", "root": "وري"}, {"id": 18, "arabic": "وَلْتَأْتِ", "translit": "ِtْaʾَtْlَw", "root": "اتي"}, {"id": 19, "arabic": "طَآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 20, "arabic": "أُخْرَىٰ", "translit": "ٰàَrْhkُaʾ", "root": "اخر"}, {"id": 21, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 22, "arabic": "يُصَلُّوا۟", "translit": "۟āwُّlَṣُy", "root": "صلو"}, {"id": 23, "arabic": "فَلْيُصَلُّوا۟", "translit": "۟āwُّlَṣُyْlَf", "root": "صلو"}, {"id": 24, "arabic": "مَعَكَ", "translit": "َkَʿعَm", "root": ""}, {"id": 25, "arabic": "وَلْيَأْخُذُوا۟", "translit": "۟āwُhdُhkْaʾَyْlَw", "root": "اخذ"}, {"id": 26, "arabic": "حِذْرَهُمْ", "translit": "ْmُhَrْhdِḥ", "root": "حذر"}, {"id": 27, "arabic": "وَأَسْلِحَتَهُمْ", "translit": "ْmُhَtَḥِlْsَaʾَw", "root": "سلح"}, {"id": 28, "arabic": "وَدَّ", "translit": "َّdَw", "root": "ودد"}, {"id": 29, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 30, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 31, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 32, "arabic": "تَغْفُلُونَ", "translit": "َnwُlُfْغَt", "root": "غفل"}, {"id": 33, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 34, "arabic": "أَسْلِحَتِكُمْ", "translit": "ْmُkِtَḥِlْsَaʾ", "root": "سلح"}, {"id": 35, "arabic": "وَأَمْتِعَتِكُمْ", "translit": "ْmُkِtَʿعِtْmَaʾَw", "root": "متع"}, {"id": 36, "arabic": "فَيَمِيلُونَ", "translit": "َnwُlyِmَyَf", "root": "ميل"}, {"id": 37, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 38, "arabic": "مَّيْلَةً", "translit": "ًẗَlْyَّm", "root": "ميل"}, {"id": 39, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 40, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 41, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 42, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 43, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 44, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 45, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 46, "arabic": "أَذًى", "translit": "àًhdَaʾ", "root": "اذي"}, {"id": 47, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 48, "arabic": "مَّطَرٍ", "translit": "ٍrَṭَّm", "root": "مطر"}, {"id": 49, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 50, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 51, "arabic": "مَّرْضَىٰٓ", "translit": "ٰٓàَḍْrَّm", "root": "مرض"}, {"id": 52, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 53, "arabic": "تَضَعُوٓا۟", "translit": "۟āٓwُʿعَḍَt", "root": "وضع"}, {"id": 54, "arabic": "أَسْلِحَتَكُمْ", "translit": "ْmُkَtَḥِlْsَaʾ", "root": "سلح"}, {"id": 55, "arabic": "وَخُذُوا۟", "translit": "۟āwُhdُhkَw", "root": "اخذ"}, {"id": 56, "arabic": "حِذْرَكُمْ", "translit": "ْmُkَrْhdِḥ", "root": "حذر"}, {"id": 57, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 58, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 59, "arabic": "أَعَدَّ", "translit": "َّdَʿعَaʾ", "root": "عدد"}, {"id": 60, "arabic": "لِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِl", "root": "كفر"}, {"id": 61, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 62, "arabic": "مُّهِينًا", "translit": "āًnyِhُّm", "root": "هون"}], "hasIhya": false}, {"ayah": 103, "text": "فَإِذَا قَضَيْتُمُ ٱلصَّلَوٰةَ فَٱذْكُرُوا۟ ٱللَّهَ قِيَٰمًا وَقُعُودًا وَعَلَىٰ جُنُوبِكُمْۚ فَإِذَا ٱطْمَأْنَنتُمْ فَأَقِيمُوا۟ ٱلصَّلَوٰةَۚ إِنَّ ٱلصَّلَوٰةَ كَانَتْ عَلَى ٱلْمُؤْمِنِينَ كِتَٰبًا مَّوْقُوتًا ", "translation": "And when you have completed the prayer, remember Allāh standing, sitting, or [lying] on your sides. But when you become secure, re-establish [regular] prayer. Indeed, prayer has been decreed upon the believers a decree of specified times.", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "قَضَيْتُمُ", "translit": "ُmُtْyَḍَq", "root": "قضي"}, {"id": 3, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 4, "arabic": "فَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَf", "root": "ذكر"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "قِيَٰمًا", "translit": "āًmَٰyِq", "root": "قوم"}, {"id": 7, "arabic": "وَقُعُودًا", "translit": "āًdwُʿعُqَw", "root": "قعد"}, {"id": 8, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 9, "arabic": "جُنُوبِكُمْ", "translit": "ْmُkِbwُnُjg", "root": "جنب"}, {"id": 10, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 11, "arabic": "ٱطْمَأْنَنتُمْ", "translit": "ْmُtnَnْaʾَmْṭٱ", "root": "طمان"}, {"id": 12, "arabic": "فَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَf", "root": "قوم"}, {"id": 13, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 16, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 17, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 18, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 19, "arabic": "كِتَٰبًا", "translit": "āًbَٰtِk", "root": "كتب"}, {"id": 20, "arabic": "مَّوْقُوتًا", "translit": "āًtwُqْwَّm", "root": "وقت"}], "hasIhya": true}, {"ayah": 104, "text": "وَلَا تَهِنُوا۟ فِى ٱبْتِغَآءِ ٱلْقَوْمِۖ إِن تَكُونُوا۟ تَأْلَمُونَ فَإِنَّهُمْ يَأْلَمُونَ كَمَا تَأْلَمُونَۖ وَتَرْجُونَ مِنَ ٱللَّهِ مَا لَا يَرْجُونَۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ", "translation": "And do not weaken in pursuit of the enemy. If you should be suffering - so are they suffering as you are suffering, but you expect from Allāh that which they expect not. And Allāh is ever Knowing and Wise.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَهِنُوا۟", "translit": "۟āwُnِhَt", "root": "وهن"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱبْتِغَآءِ", "translit": "ِءٓāَغِtْbٱ", "root": "بغي"}, {"id": 5, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 8, "arabic": "تَأْلَمُونَ", "translit": "َnwُmَlْaʾَt", "root": "الم"}, {"id": 9, "arabic": "فَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَf", "root": ""}, {"id": 10, "arabic": "يَأْلَمُونَ", "translit": "َnwُmَlْaʾَy", "root": "الم"}, {"id": 11, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 12, "arabic": "تَأْلَمُونَ", "translit": "َnwُmَlْaʾَt", "root": "الم"}, {"id": 13, "arabic": "وَتَرْجُونَ", "translit": "َnwُjgْrَtَw", "root": "رجو"}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 19, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 22, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 105, "text": "إِنَّآ أَنزَلْنَآ إِلَيْكَ ٱلْكِتَٰبَ بِٱلْحَقِّ لِتَحْكُمَ بَيْنَ ٱلنَّاسِ بِمَآ أَرَىٰكَ ٱللَّهُۚ وَلَا تَكُن لِّلْخَآئِنِينَ خَصِيمًا ", "translation": "Indeed, We have revealed to you, [O Muḥammad], the Book in truth so you may judge between the people by that which Allāh has shown you. And do not be for the deceitful an advocate.", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "لِتَحْكُمَ", "translit": "َmُkْḥَtِl", "root": "حكم"}, {"id": 7, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 8, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 9, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 10, "arabic": "أَرَىٰكَ", "translit": "َkٰàَrَaʾ", "root": "راي"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 14, "arabic": "لِّلْخَآئِنِينَ", "translit": "َnyِnِyʾٓāَhkْlِّl", "root": "خون"}, {"id": 15, "arabic": "خَصِيمًا", "translit": "āًmyِṣَhk", "root": "خصم"}], "hasIhya": false}, {"ayah": 106, "text": "وَٱسْتَغْفِرِ ٱللَّهَۖ إِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا ", "translation": "And seek forgiveness of Allāh. Indeed, Allāh is ever Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَٱسْتَغْفِرِ", "translit": "ِrِfْغَtْsٱَw", "root": "غفر"}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 6, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 7, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 107, "text": "وَلَا تُجَٰدِلْ عَنِ ٱلَّذِينَ يَخْتَانُونَ أَنفُسَهُمْۚ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ خَوَّانًا أَثِيمًا ", "translation": "And do not argue on behalf of those who deceive themselves. Indeed, Allāh loves not one who is a habitually sinful deceiver.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تُجَٰدِلْ", "translit": "ْlِdَٰjgُt", "root": "جدل"}, {"id": 3, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَخْتَانُونَ", "translit": "َnwُnāَtْhkَy", "root": "خون"}, {"id": 6, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 11, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 12, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 13, "arabic": "خَوَّانًا", "translit": "āًnāَّwَhk", "root": "خون"}, {"id": 14, "arabic": "أَثِيمًا", "translit": "āًmyِhtَaʾ", "root": "اثم"}], "hasIhya": true}, {"ayah": 108, "text": "يَسْتَخْفُونَ مِنَ ٱلنَّاسِ وَلَا يَسْتَخْفُونَ مِنَ ٱللَّهِ وَهُوَ مَعَهُمْ إِذْ يُبَيِّتُونَ مَا لَا يَرْضَىٰ مِنَ ٱلْقَوْلِۚ وَكَانَ ٱللَّهُ بِمَا يَعْمَلُونَ مُحِيطًا ", "translation": "They conceal [their evil intentions and deeds] from the people, but they cannot conceal [them] from Allāh, and He is with them [in His knowledge] when they spend the night in such as He does not accept of speech. And ever is Allāh, of what they do, encompassing.", "words": [{"id": 1, "arabic": "يَسْتَخْفُونَ", "translit": "َnwُfْhkَtْsَy", "root": "خفي"}, {"id": 2, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 3, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "يَسْتَخْفُونَ", "translit": "َnwُfْhkَtْsَy", "root": "خفي"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 9, "arabic": "مَعَهُمْ", "translit": "ْmُhَʿعَm", "root": ""}, {"id": 10, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 11, "arabic": "يُبَيِّتُونَ", "translit": "َnwُtِّyَbُy", "root": "بيت"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يَرْضَىٰ", "translit": "ٰàَḍْrَy", "root": "رضو"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْقَوْلِ", "translit": "ِlْwَqْlٱ", "root": "قول"}, {"id": 17, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 20, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}, {"id": 21, "arabic": "مُحِيطًا", "translit": "āًṭyِḥُm", "root": "حوط"}], "hasIhya": false}, {"ayah": 109, "text": "هَٰٓأَنتُمْ هَٰٓؤُلَآءِ جَٰدَلْتُمْ عَنْهُمْ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا فَمَن يُجَٰدِلُ ٱللَّهَ عَنْهُمْ يَوْمَ ٱلْقِيَٰمَةِ أَم مَّن يَكُونُ عَلَيْهِمْ وَكِيلًا ", "translation": "Here you are - those who argue on their behalf in [this] worldly life - but who will argue with Allāh for them on the Day of Resurrection, or who will [then] be their representative?", "words": [{"id": 1, "arabic": "هَٰٓأَنتُمْ", "translit": "ْmُtnَaʾَٰٓh", "root": ""}, {"id": 2, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 3, "arabic": "جَٰدَلْتُمْ", "translit": "ْmُtْlَdَٰjg", "root": "جدل"}, {"id": 4, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 7, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 8, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 9, "arabic": "يُجَٰدِلُ", "translit": "ُlِdَٰjgُy", "root": "جدل"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 12, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 13, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 14, "arabic": "أَم", "translit": "mَaʾ", "root": ""}, {"id": 15, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 16, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 17, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 18, "arabic": "وَكِيلًا", "translit": "āًlyِkَw", "root": "وكل"}], "hasIhya": false}, {"ayah": 110, "text": "وَمَن يَعْمَلْ سُوٓءًا أَوْ يَظْلِمْ نَفْسَهُۥ ثُمَّ يَسْتَغْفِرِ ٱللَّهَ يَجِدِ ٱللَّهَ غَفُورًا رَّحِيمًا ", "translation": "And whoever does a wrong or wrongs himself but then seeks forgiveness of Allāh will find Allāh Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَعْمَلْ", "translit": "ْlَmْʿعَy", "root": "عمل"}, {"id": 3, "arabic": "سُوٓءًا", "translit": "āًءٓwُs", "root": "سوا"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "يَظْلِمْ", "translit": "ْmِlْẓَy", "root": "ظلم"}, {"id": 6, "arabic": "نَفْسَهُۥ", "translit": "ۥُhَsْfَn", "root": "نفس"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "يَسْتَغْفِرِ", "translit": "ِrِfْغَtْsَy", "root": "غفر"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "يَجِدِ", "translit": "ِdِjgَy", "root": "وجد"}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 13, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 111, "text": "وَمَن يَكْسِبْ إِثْمًا فَإِنَّمَا يَكْسِبُهُۥ عَلَىٰ نَفْسِهِۦۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ", "translation": "And whoever earns [i.e., commits] a sin only earns it against himself. And Allāh is ever Knowing and Wise.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَكْسِبْ", "translit": "ْbِsْkَy", "root": "كسب"}, {"id": 3, "arabic": "إِثْمًا", "translit": "āًmْhtِiʾ", "root": "اثم"}, {"id": 4, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 5, "arabic": "يَكْسِبُهُۥ", "translit": "ۥُhُbِsْkَy", "root": "كسب"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "نَفْسِهِۦ", "translit": "ۦِhِsْfَn", "root": "نفس"}, {"id": 8, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 11, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 112, "text": "وَمَن يَكْسِبْ خَطِيٓـَٔةً أَوْ إِثْمًا ثُمَّ يَرْمِ بِهِۦ بَرِيٓـًٔا فَقَدِ ٱحْتَمَلَ بُهْتَٰنًا وَإِثْمًا مُّبِينًا ", "translation": "But whoever earns an offense or a sin and then blames it on an innocent [person] has taken upon himself a slander and manifest sin.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَكْسِبْ", "translit": "ْbِsْkَy", "root": "كسب"}, {"id": 3, "arabic": "خَطِيٓـَٔةً", "translit": "ًẗَٔـٓyِṭَhk", "root": "خطا"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "إِثْمًا", "translit": "āًmْhtِiʾ", "root": "اثم"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "يَرْمِ", "translit": "ِmْrَy", "root": "رمي"}, {"id": 8, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 9, "arabic": "بَرِيٓـًٔا", "translit": "āًٔـٓyِrَb", "root": "برا"}, {"id": 10, "arabic": "فَقَدِ", "translit": "ِdَqَf", "root": ""}, {"id": 11, "arabic": "ٱحْتَمَلَ", "translit": "َlَmَtْḥٱ", "root": "حمل"}, {"id": 12, "arabic": "بُهْتَٰنًا", "translit": "āًnَٰtْhُb", "root": "بهت"}, {"id": 13, "arabic": "وَإِثْمًا", "translit": "āًmْhtِiʾَw", "root": "اثم"}, {"id": 14, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 113, "text": "وَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكَ وَرَحْمَتُهُۥ لَهَمَّت طَّآئِفَةٌ مِّنْهُمْ أَن يُضِلُّوكَ وَمَا يُضِلُّونَ إِلَّآ أَنفُسَهُمْۖ وَمَا يَضُرُّونَكَ مِن شَىْءٍۚ وَأَنزَلَ ٱللَّهُ عَلَيْكَ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ وَعَلَّمَكَ مَا لَمْ تَكُن تَعْلَمُۚ وَكَانَ فَضْلُ ٱللَّهِ عَلَيْكَ عَظِيمًا ", "translation": "And if it was not for the favor of Allāh upon you, [O Muḥammad], and His mercy, a group of them would have determined to mislead you. But they do not mislead except themselves, and they will not harm you at all. And Allāh has revealed to you the Book and wisdom and has taught you that which you did not know. And ever has the favor of Allāh upon you been great.", "words": [{"id": 1, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 2, "arabic": "فَضْلُ", "translit": "ُlْḍَf", "root": "فضل"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "وَرَحْمَتُهُۥ", "translit": "ۥُhُtَmْḥَrَw", "root": "رحم"}, {"id": 6, "arabic": "لَهَمَّت", "translit": "tَّmَhَl", "root": "همم"}, {"id": 7, "arabic": "طَّآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَّṭ", "root": "طوف"}, {"id": 8, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يُضِلُّوكَ", "translit": "َkwُّlِḍُy", "root": "ضلل"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "يُضِلُّونَ", "translit": "َnwُّlِḍُy", "root": "ضلل"}, {"id": 13, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 14, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 15, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 16, "arabic": "يَضُرُّونَكَ", "translit": "َkَnwُّrُḍَy", "root": "ضرر"}, {"id": 17, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 22, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 23, "arabic": "وَٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱَw", "root": "حكم"}, {"id": 24, "arabic": "وَعَلَّمَكَ", "translit": "َkَmَّlَʿعَw", "root": "علم"}, {"id": 25, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 26, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 27, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 28, "arabic": "تَعْلَمُ", "translit": "ُmَlْʿعَt", "root": "علم"}, {"id": 29, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 30, "arabic": "فَضْلُ", "translit": "ُlْḍَf", "root": "فضل"}, {"id": 31, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 33, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 114, "text": "لَّا خَيْرَ فِى كَثِيرٍ مِّن نَّجْوَىٰهُمْ إِلَّا مَنْ أَمَرَ بِصَدَقَةٍ أَوْ مَعْرُوفٍ أَوْ إِصْلَٰحٍۭ بَيْنَ ٱلنَّاسِۚ وَمَن يَفْعَلْ ذَٰلِكَ ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ فَسَوْفَ نُؤْتِيهِ أَجْرًا عَظِيمًا ", "translation": "No good is there in much of their private conversation, except for those who enjoin charity or that which is right or conciliation between people. And whoever does that seeking means to the approval of Allāh - then We are going to give him a great reward.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "خَيْرَ", "translit": "َrْyَhk", "root": "خير"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "كَثِيرٍ", "translit": "ٍryِhtَk", "root": "كثر"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "نَّجْوَىٰهُمْ", "translit": "ْmُhٰàَwْjgَّn", "root": "نجو"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 9, "arabic": "أَمَرَ", "translit": "َrَmَaʾ", "root": "امر"}, {"id": 10, "arabic": "بِصَدَقَةٍ", "translit": "ٍẗَqَdَṣِb", "root": "صدق"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "مَعْرُوفٍ", "translit": "ٍfwُrْʿعَm", "root": "عرف"}, {"id": 13, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 14, "arabic": "إِصْلَٰحٍۭ", "translit": "ٍۭḥَٰlْṣِiʾ", "root": "صلح"}, {"id": 15, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 16, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 17, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 18, "arabic": "يَفْعَلْ", "translit": "ْlَʿعْfَy", "root": "فعل"}, {"id": 19, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 20, "arabic": "ٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱ", "root": "بغي"}, {"id": 21, "arabic": "مَرْضَاتِ", "translit": "ِtāَḍْrَm", "root": "رضو"}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 24, "arabic": "نُؤْتِيهِ", "translit": "ِhyِtْwʾُn", "root": "اتي"}, {"id": 25, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 26, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 115, "text": "وَمَن يُشَاقِقِ ٱلرَّسُولَ مِنۢ بَعْدِ مَا تَبَيَّنَ لَهُ ٱلْهُدَىٰ وَيَتَّبِعْ غَيْرَ سَبِيلِ ٱلْمُؤْمِنِينَ نُوَلِّهِۦ مَا تَوَلَّىٰ وَنُصْلِهِۦ جَهَنَّمَۖ وَسَآءَتْ مَصِيرًا ", "translation": "And whoever opposes the Messenger after guidance has become clear to him and follows other than the way of the believers - We will give him what he has taken[1] and drive him into Hell, and evil it is as a destination.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يُشَاقِقِ", "translit": "ِqِqāَhsُy", "root": "شقق"}, {"id": 3, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "تَبَيَّنَ", "translit": "َnَّyَbَt", "root": "بين"}, {"id": 8, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 9, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 10, "arabic": "وَيَتَّبِعْ", "translit": "ْʿعِbَّtَyَw", "root": "تبع"}, {"id": 11, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 12, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 13, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 14, "arabic": "نُوَلِّهِۦ", "translit": "ۦِhِّlَwُn", "root": "ولي"}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "تَوَلَّىٰ", "translit": "ٰàَّlَwَt", "root": "ولي"}, {"id": 17, "arabic": "وَنُصْلِهِۦ", "translit": "ۦِhِlْṣُnَw", "root": "صلي"}, {"id": 18, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 19, "arabic": "وَسَآءَتْ", "translit": "ْtَءٓāَsَw", "root": "سوا"}, {"id": 20, "arabic": "مَصِيرًا", "translit": "āًryِṣَm", "root": "صير"}], "hasIhya": false}, {"ayah": 116, "text": "إِنَّ ٱللَّهَ لَا يَغْفِرُ أَن يُشْرَكَ بِهِۦ وَيَغْفِرُ مَا دُونَ ذَٰلِكَ لِمَن يَشَآءُۚ وَمَن يُشْرِكْ بِٱللَّهِ فَقَدْ ضَلَّ ضَلَٰلًۢا بَعِيدًا ", "translation": "Indeed, Allāh does not forgive association with Him, but He forgives what is less than that for whom He wills. And he who associates others with Allāh has certainly gone far astray.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَغْفِرُ", "translit": "ُrِfْغَy", "root": "غفر"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يُشْرَكَ", "translit": "َkَrْhsُy", "root": "شرك"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "وَيَغْفِرُ", "translit": "ُrِfْغَyَw", "root": "غفر"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "دُونَ", "translit": "َnwُd", "root": "دون"}, {"id": 11, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 12, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 13, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 14, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 15, "arabic": "يُشْرِكْ", "translit": "ْkِrْhsُy", "root": "شرك"}, {"id": 16, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 17, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 18, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 19, "arabic": "ضَلَٰلًۢا", "translit": "āًۢlَٰlَḍ", "root": "ضلل"}, {"id": 20, "arabic": "بَعِيدًا", "translit": "āًdyِʿعَb", "root": "بعد"}], "hasIhya": true}, {"ayah": 117, "text": "إِن يَدْعُونَ مِن دُونِهِۦٓ إِلَّآ إِنَٰثًا وَإِن يَدْعُونَ إِلَّا شَيْطَٰنًا مَّرِيدًا ", "translation": "They call upon instead of Him none but female [deities], and they [actually] call upon none but a rebellious Satan,", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 5, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 6, "arabic": "إِنَٰثًا", "translit": "āًhtَٰnِiʾ", "root": "انث"}, {"id": 7, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 8, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "شَيْطَٰنًا", "translit": "āًnَٰṭْyَhs", "root": "شطن"}, {"id": 11, "arabic": "مَّرِيدًا", "translit": "āًdyِrَّm", "root": "مرد"}], "hasIhya": false}, {"ayah": 118, "text": "لَّعَنَهُ ٱللَّهُۘ وَقَالَ لَأَتَّخِذَنَّ مِنْ عِبَادِكَ نَصِيبًا مَّفْرُوضًا ", "translation": "Whom Allāh has cursed. For he had said, \"I will surely take from among Your servants a specific portion.", "words": [{"id": 1, "arabic": "لَّعَنَهُ", "translit": "ُhَnَʿعَّl", "root": "لعن"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 4, "arabic": "لَأَتَّخِذَنَّ", "translit": "َّnَhdِhkَّtَaʾَl", "root": "اخذ"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "عِبَادِكَ", "translit": "َkِdāَbِʿع", "root": "عبد"}, {"id": 7, "arabic": "نَصِيبًا", "translit": "āًbyِṣَn", "root": "نصب"}, {"id": 8, "arabic": "مَّفْرُوضًا", "translit": "āًḍwُrْfَّm", "root": "فرض"}], "hasIhya": false}, {"ayah": 119, "text": "وَلَأُضِلَّنَّهُمْ وَلَأُمَنِّيَنَّهُمْ وَلَءَامُرَنَّهُمْ فَلَيُبَتِّكُنَّ ءَاذَانَ ٱلْأَنْعَٰمِ وَلَءَامُرَنَّهُمْ فَلَيُغَيِّرُنَّ خَلْقَ ٱللَّهِۚ وَمَن يَتَّخِذِ ٱلشَّيْطَٰنَ وَلِيًّا مِّن دُونِ ٱللَّهِ فَقَدْ خَسِرَ خُسْرَانًا مُّبِينًا ", "translation": "And I will mislead them, and I will arouse in them [sinful] desires, and I will command them so they will slit the ears of cattle, and I will command them so they will change the creation of Allāh.\" And whoever takes Satan as an ally instead of Allāh has certainly sustained a clear loss.", "words": [{"id": 1, "arabic": "وَلَأُضِلَّنَّهُمْ", "translit": "ْmُhَّnَّlِḍُaʾَlَw", "root": "ضلل"}, {"id": 2, "arabic": "وَلَأُمَنِّيَنَّهُمْ", "translit": "ْmُhَّnَyِّnَmُaʾَlَw", "root": "مني"}, {"id": 3, "arabic": "وَلَءَامُرَنَّهُمْ", "translit": "ْmُhَّnَrُmāَءَlَw", "root": "امر"}, {"id": 4, "arabic": "فَلَيُبَتِّكُنَّ", "translit": "َّnُkِّtَbُyَlَf", "root": "بتك"}, {"id": 5, "arabic": "ءَاذَانَ", "translit": "َnāَhdāَء", "root": "اذن"}, {"id": 6, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 7, "arabic": "وَلَءَامُرَنَّهُمْ", "translit": "ْmُhَّnَrُmāَءَlَw", "root": "امر"}, {"id": 8, "arabic": "فَلَيُغَيِّرُنَّ", "translit": "َّnُrِّyَغُyَlَf", "root": "غير"}, {"id": 9, "arabic": "خَلْقَ", "translit": "َqْlَhk", "root": "خلق"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 12, "arabic": "يَتَّخِذِ", "translit": "ِhdِhkَّtَy", "root": "اخذ"}, {"id": 13, "arabic": "ٱلشَّيْطَٰنَ", "translit": "َnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 14, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 19, "arabic": "خَسِرَ", "translit": "َrِsَhk", "root": "خسر"}, {"id": 20, "arabic": "خُسْرَانًا", "translit": "āًnāَrْsُhk", "root": "خسر"}, {"id": 21, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 120, "text": "يَعِدُهُمْ وَيُمَنِّيهِمْۖ وَمَا يَعِدُهُمُ ٱلشَّيْطَٰنُ إِلَّا غُرُورًا ", "translation": "He [i.e., Satan] promises them and arouses desire in them. But Satan does not promise them except delusion.", "words": [{"id": 1, "arabic": "يَعِدُهُمْ", "translit": "ْmُhُdِʿعَy", "root": "وعد"}, {"id": 2, "arabic": "وَيُمَنِّيهِمْ", "translit": "ْmِhyِّnَmُyَw", "root": "مني"}, {"id": 3, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 4, "arabic": "يَعِدُهُمُ", "translit": "ُmُhُdِʿعَy", "root": "وعد"}, {"id": 5, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "غُرُورًا", "translit": "āًrwُrُغ", "root": "غرر"}], "hasIhya": true}, {"ayah": 121, "text": "أُو۟لَٰٓئِكَ مَأْوَىٰهُمْ جَهَنَّمُ وَلَا يَجِدُونَ عَنْهَا مَحِيصًا ", "translation": "The refuge of those will be Hell, and they will not find from it an escape.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "مَأْوَىٰهُمْ", "translit": "ْmُhٰàَwْaʾَm", "root": "اوي"}, {"id": 3, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد"}, {"id": 6, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 7, "arabic": "مَحِيصًا", "translit": "āًṣyِḥَm", "root": "حيص"}], "hasIhya": false}, {"ayah": 122, "text": "وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَنُدْخِلُهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًاۖ وَعْدَ ٱللَّهِ حَقًّاۚ وَمَنْ أَصْدَقُ مِنَ ٱللَّهِ قِيلًا ", "translation": "But the ones who believe and do righteous deeds - We will admit them to gardens beneath which rivers flow, wherein they will abide forever. [It is] the promise of Allāh, [which is] truth, and who is more truthful than Allāh in statement.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 4, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 5, "arabic": "سَنُدْخِلُهُمْ", "translit": "ْmُhُlِhkْdُnَs", "root": "دخل"}, {"id": 6, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 7, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 10, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 11, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 12, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 13, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 14, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 17, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 18, "arabic": "أَصْدَقُ", "translit": "ُqَdْṣَaʾ", "root": "صدق"}, {"id": 19, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 20, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "قِيلًا", "translit": "āًlyِq", "root": "قول"}], "hasIhya": true}, {"ayah": 123, "text": "لَّيْسَ بِأَمَانِيِّكُمْ وَلَآ أَمَانِىِّ أَهْلِ ٱلْكِتَٰبِۗ مَن يَعْمَلْ سُوٓءًا يُجْزَ بِهِۦ وَلَا يَجِدْ لَهُۥ مِن دُونِ ٱللَّهِ وَلِيًّا وَلَا نَصِيرًا ", "translation": "It [i.e., Paradise] is not [obtained] by your wishful thinking nor by that of the People of the Scripture. Whoever does a wrong will be recompensed for it, and he will not find besides Allāh a protector or a helper.", "words": [{"id": 1, "arabic": "لَّيْسَ", "translit": "َsْyَّl", "root": "ليس"}, {"id": 2, "arabic": "بِأَمَانِيِّكُمْ", "translit": "ْmُkِّyِnāَmَaʾِb", "root": "مني"}, {"id": 3, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 4, "arabic": "أَمَانِىِّ", "translit": "ِّàِnāَmَaʾ", "root": "مني"}, {"id": 5, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 6, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "يَعْمَلْ", "translit": "ْlَmْʿعَy", "root": "عمل"}, {"id": 9, "arabic": "سُوٓءًا", "translit": "āًءٓwُs", "root": "سوا"}, {"id": 10, "arabic": "يُجْزَ", "translit": "َzْjgُy", "root": "جزي"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "يَجِدْ", "translit": "ْdِjgَy", "root": "وجد"}, {"id": 14, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 15, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 16, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 19, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 20, "arabic": "نَصِيرًا", "translit": "āًryِṣَn", "root": "نصر"}], "hasIhya": true}, {"ayah": 124, "text": "وَمَن يَعْمَلْ مِنَ ٱلصَّٰلِحَٰتِ مِن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَأُو۟لَٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ وَلَا يُظْلَمُونَ نَقِيرًا ", "translation": "And whoever does righteous deeds, whether male or female, while being a believer - those will enter Paradise and will not be wronged, [even as much as] the speck on a date seed.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَعْمَلْ", "translit": "ْlَmْʿعَy", "root": "عمل"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "ذَكَرٍ", "translit": "ٍrَkَhd", "root": "ذكر"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "أُنثَىٰ", "translit": "ٰàَhtnُaʾ", "root": "انث"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "مُؤْمِنٌ", "translit": "ٌnِmْwʾُm", "root": "امن"}, {"id": 11, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 12, "arabic": "يَدْخُلُونَ", "translit": "َnwُlُhkْdَy", "root": "دخل"}, {"id": 13, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}, {"id": 16, "arabic": "نَقِيرًا", "translit": "āًryِqَn", "root": "نقر"}], "hasIhya": false}, {"ayah": 125, "text": "وَمَنْ أَحْسَنُ دِينًا مِّمَّنْ أَسْلَمَ وَجْهَهُۥ لِلَّهِ وَهُوَ مُحْسِنٌ وَٱتَّبَعَ مِلَّةَ إِبْرَٰهِيمَ حَنِيفًاۗ وَٱتَّخَذَ ٱللَّهُ إِبْرَٰهِيمَ خَلِيلًا ", "translation": "And who is better in religion than one who submits himself to Allāh while being a doer of good and follows the religion of Abraham, inclining toward truth? And Allāh took Abraham as an intimate friend.", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 3, "arabic": "دِينًا", "translit": "āًnyِd", "root": "دين"}, {"id": 4, "arabic": "مِّمَّنْ", "translit": "ْnَّmِّm", "root": ""}, {"id": 5, "arabic": "أَسْلَمَ", "translit": "َmَlْsَaʾ", "root": "سلم"}, {"id": 6, "arabic": "وَجْهَهُۥ", "translit": "ۥُhَhْjgَw", "root": "وجه"}, {"id": 7, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 8, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 9, "arabic": "مُحْسِنٌ", "translit": "ٌnِsْḥُm", "root": "حسن"}, {"id": 10, "arabic": "وَٱتَّبَعَ", "translit": "َʿعَbَّtٱَw", "root": "تبع"}, {"id": 11, "arabic": "مِلَّةَ", "translit": "َẗَّlِm", "root": "ملل"}, {"id": 12, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 13, "arabic": "حَنِيفًا", "translit": "āًfyِnَḥ", "root": "حنف"}, {"id": 14, "arabic": "وَٱتَّخَذَ", "translit": "َhdَhkَّtٱَw", "root": "اخذ"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 17, "arabic": "خَلِيلًا", "translit": "āًlyِlَhk", "root": "خلل"}], "hasIhya": false}, {"ayah": 126, "text": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۚ وَكَانَ ٱللَّهُ بِكُلِّ شَىْءٍ مُّحِيطًا ", "translation": "And to Allāh belongs whatever is in the heavens and whatever is on the earth. And ever is Allāh, of all things, encompassing.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 11, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 12, "arabic": "مُّحِيطًا", "translit": "āًṭyِḥُّm", "root": "حوط"}], "hasIhya": true}, {"ayah": 127, "text": "وَيَسْتَفْتُونَكَ فِى ٱلنِّسَآءِۖ قُلِ ٱللَّهُ يُفْتِيكُمْ فِيهِنَّ وَمَا يُتْلَىٰ عَلَيْكُمْ فِى ٱلْكِتَٰبِ فِى يَتَٰمَى ٱلنِّسَآءِ ٱلَّٰتِى لَا تُؤْتُونَهُنَّ مَا كُتِبَ لَهُنَّ وَتَرْغَبُونَ أَن تَنكِحُوهُنَّ وَٱلْمُسْتَضْعَفِينَ مِنَ ٱلْوِلْدَٰنِ وَأَن تَقُومُوا۟ لِلْيَتَٰمَىٰ بِٱلْقِسْطِۚ وَمَا تَفْعَلُوا۟ مِنْ خَيْرٍ فَإِنَّ ٱللَّهَ كَانَ بِهِۦ عَلِيمًا ", "translation": "And they request from you, [O Muḥammad], a [legal] ruling concerning women. Say, \"Allāh gives you a ruling about them and [about] what has been recited to you in the Book concerning the orphan girls to whom you do not give what is decreed for them[1] - and [yet] you desire to marry them - and concerning the oppressed among children and that you maintain for orphans [their rights] in justice.\" And whatever you do of good - indeed, Allāh is ever Knowing of it.", "words": [{"id": 1, "arabic": "وَيَسْتَفْتُونَكَ", "translit": "َkَnwُtْfَtْsَyَw", "root": "فتي"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 4, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "يُفْتِيكُمْ", "translit": "ْmُkyِtْfُy", "root": "فتي"}, {"id": 7, "arabic": "فِيهِنَّ", "translit": "َّnِhyِf", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "يُتْلَىٰ", "translit": "ٰàَlْtُy", "root": "تلو"}, {"id": 10, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "يَتَٰمَى", "translit": "àَmَٰtَy", "root": "يتم"}, {"id": 15, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 16, "arabic": "ٱلَّٰتِى", "translit": "àِtَّٰlٱ", "root": ""}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "تُؤْتُونَهُنَّ", "translit": "َّnُhَnwُtْwʾُt", "root": "اتي"}, {"id": 19, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 20, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 21, "arabic": "لَهُنَّ", "translit": "َّnُhَl", "root": ""}, {"id": 22, "arabic": "وَتَرْغَبُونَ", "translit": "َnwُbَغْrَtَw", "root": "رغب"}, {"id": 23, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 24, "arabic": "تَنكِحُوهُنَّ", "translit": "َّnُhwُḥِknَt", "root": "نكح"}, {"id": 25, "arabic": "وَٱلْمُسْتَضْعَفِينَ", "translit": "َnyِfَʿعْḍَtْsُmْlٱَw", "root": "ضعف"}, {"id": 26, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 27, "arabic": "ٱلْوِلْدَٰنِ", "translit": "ِnَٰdْlِwْlٱ", "root": "ولد"}, {"id": 28, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 29, "arabic": "تَقُومُوا۟", "translit": "۟āwُmwُqَt", "root": "قوم"}, {"id": 30, "arabic": "لِلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlِl", "root": "يتم"}, {"id": 31, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 32, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 33, "arabic": "تَفْعَلُوا۟", "translit": "۟āwُlَʿعْfَt", "root": "فعل"}, {"id": 34, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 35, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 36, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 37, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 38, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 39, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 40, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 128, "text": "وَإِنِ ٱمْرَأَةٌ خَافَتْ مِنۢ بَعْلِهَا نُشُوزًا أَوْ إِعْرَاضًا فَلَا جُنَاحَ عَلَيْهِمَآ أَن يُصْلِحَا بَيْنَهُمَا صُلْحًاۚ وَٱلصُّلْحُ خَيْرٌۗ وَأُحْضِرَتِ ٱلْأَنفُسُ ٱلشُّحَّۚ وَإِن تُحْسِنُوا۟ وَتَتَّقُوا۟ فَإِنَّ ٱللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا ", "translation": "And if a woman fears from her husband contempt or evasion, there is no sin upon them if they make terms of settlement between them - and settlement is best. And present in [human] souls is stinginess.[1] But if you do good and fear Allāh - then indeed Allāh is ever, of what you do, Aware.", "words": [{"id": 1, "arabic": "وَإِنِ", "translit": "ِnِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱمْرَأَةٌ", "translit": "ٌẗَaʾَrْmٱ", "root": "مرا"}, {"id": 3, "arabic": "خَافَتْ", "translit": "ْtَfāَhk", "root": "خوف"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَعْلِهَا", "translit": "āَhِlْʿعَb", "root": "بعل"}, {"id": 6, "arabic": "نُشُوزًا", "translit": "āًzwُhsُn", "root": "نشز"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "إِعْرَاضًا", "translit": "āًḍāَrْʿعِiʾ", "root": "عرض"}, {"id": 9, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 10, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 11, "arabic": "عَلَيْهِمَآ", "translit": "ٓāَmِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 13, "arabic": "يُصْلِحَا", "translit": "āَḥِlْṣُy", "root": "صلح"}, {"id": 14, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 15, "arabic": "صُلْحًا", "translit": "āًḥْlُṣ", "root": "صلح"}, {"id": 16, "arabic": "وَٱلصُّلْحُ", "translit": "ُḥْlُّṣlٱَw", "root": "صلح"}, {"id": 17, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 18, "arabic": "وَأُحْضِرَتِ", "translit": "ِtَrِḍْḥُaʾَw", "root": "حضر"}, {"id": 19, "arabic": "ٱلْأَنفُسُ", "translit": "ُsُfnَaʾْlٱ", "root": "نفس"}, {"id": 20, "arabic": "ٱلشُّحَّ", "translit": "َّḥُّhslٱ", "root": "شحح"}, {"id": 21, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 22, "arabic": "تُحْسِنُوا۟", "translit": "۟āwُnِsْḥُt", "root": "حسن"}, {"id": 23, "arabic": "وَتَتَّقُوا۟", "translit": "۟āwُqَّtَtَw", "root": "وقي"}, {"id": 24, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 25, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 27, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 28, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 29, "arabic": "خَبِيرًا", "translit": "āًryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 129, "text": "وَلَن تَسْتَطِيعُوٓا۟ أَن تَعْدِلُوا۟ بَيْنَ ٱلنِّسَآءِ وَلَوْ حَرَصْتُمْۖ فَلَا تَمِيلُوا۟ كُلَّ ٱلْمَيْلِ فَتَذَرُوهَا كَٱلْمُعَلَّقَةِۚ وَإِن تُصْلِحُوا۟ وَتَتَّقُوا۟ فَإِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا ", "translation": "And you will never be able to be equal [in feeling] between wives, even if you should strive [to do so]. So do not incline completely [toward one] and leave another hanging.[1] And if you amend [your affairs] and fear Allāh - then indeed, Allāh is ever Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 2, "arabic": "تَسْتَطِيعُوٓا۟", "translit": "۟āٓwُʿعyِṭَtْsَt", "root": "طوع"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تَعْدِلُوا۟", "translit": "۟āwُlِdْʿعَt", "root": "عدل"}, {"id": 5, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 6, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 7, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 8, "arabic": "حَرَصْتُمْ", "translit": "ْmُtْṣَrَḥ", "root": "حرص"}, {"id": 9, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 10, "arabic": "تَمِيلُوا۟", "translit": "۟āwُlyِmَt", "root": "ميل"}, {"id": 11, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 12, "arabic": "ٱلْمَيْلِ", "translit": "ِlْyَmْlٱ", "root": "ميل"}, {"id": 13, "arabic": "فَتَذَرُوهَا", "translit": "āَhwُrَhdَtَf", "root": "وذر"}, {"id": 14, "arabic": "كَٱلْمُعَلَّقَةِ", "translit": "ِẗَqَّlَʿعُmْlٱَk", "root": "علق"}, {"id": 15, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 16, "arabic": "تُصْلِحُوا۟", "translit": "۟āwُḥِlْṣُt", "root": "صلح"}, {"id": 17, "arabic": "وَتَتَّقُوا۟", "translit": "۟āwُqَّtَtَw", "root": "وقي"}, {"id": 18, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 21, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 22, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 130, "text": "وَإِن يَتَفَرَّقَا يُغْنِ ٱللَّهُ كُلًّا مِّن سَعَتِهِۦۚ وَكَانَ ٱللَّهُ وَٰسِعًا حَكِيمًا ", "translation": "But if they separate [by divorce], Allāh will enrich each [of them] from His abundance. And ever is Allāh Encompassing and Wise.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "يَتَفَرَّقَا", "translit": "āَqَّrَfَtَy", "root": "فرق"}, {"id": 3, "arabic": "يُغْنِ", "translit": "ِnْغُy", "root": "غني"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "كُلًّا", "translit": "āًّlُk", "root": "كلل"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "سَعَتِهِۦ", "translit": "ۦِhِtَʿعَs", "root": "وسع"}, {"id": 8, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَٰسِعًا", "translit": "āًʿعِsَٰw", "root": "وسع"}, {"id": 11, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 131, "text": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۗ وَلَقَدْ وَصَّيْنَا ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ مِن قَبْلِكُمْ وَإِيَّاكُمْ أَنِ ٱتَّقُوا۟ ٱللَّهَۚ وَإِن تَكْفُرُوا۟ فَإِنَّ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۚ وَكَانَ ٱللَّهُ غَنِيًّا حَمِيدًا ", "translation": "And to Allāh belongs whatever is in the heavens and whatever is on the earth. And We have instructed those who were given the Scripture before you and yourselves to fear Allāh. But if you disbelieve - then to Allāh belongs whatever is in the heavens and whatever is on the earth. And ever is Allāh Free of need and Praiseworthy.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 9, "arabic": "وَصَّيْنَا", "translit": "āَnْyَّṣَw", "root": "وصي"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 12, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 15, "arabic": "وَإِيَّاكُمْ", "translit": "ْmُkāَّyِiʾَw", "root": ""}, {"id": 16, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 17, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 18, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 20, "arabic": "تَكْفُرُوا۟", "translit": "۟āwُrُfْkَt", "root": "كفر"}, {"id": 21, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 22, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 23, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 24, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 25, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 26, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 27, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 28, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 29, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 30, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 31, "arabic": "غَنِيًّا", "translit": "āًّyِnَغ", "root": "غني"}, {"id": 32, "arabic": "حَمِيدًا", "translit": "āًdyِmَḥ", "root": "حمد"}], "hasIhya": true}, {"ayah": 132, "text": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا ", "translation": "And to Allāh belongs whatever is in the heavens and whatever is on the earth. And sufficient is Allāh as Disposer of affairs.[1]", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 9, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 10, "arabic": "وَكِيلًا", "translit": "āًlyِkَw", "root": "وكل"}], "hasIhya": true}, {"ayah": 133, "text": "إِن يَشَأْ يُذْهِبْكُمْ أَيُّهَا ٱلنَّاسُ وَيَأْتِ بِـَٔاخَرِينَۚ وَكَانَ ٱللَّهُ عَلَىٰ ذَٰلِكَ قَدِيرًا ", "translation": "If He wills, He can do away with you, O people, and bring others [in your place]. And ever is Allāh competent to do that.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "يَشَأْ", "translit": "ْaʾَhsَy", "root": "شيا"}, {"id": 3, "arabic": "يُذْهِبْكُمْ", "translit": "ْmُkْbِhْhdُy", "root": "ذهب"}, {"id": 4, "arabic": "أَيُّهَا", "translit": "āَhُّyَaʾ", "root": "ايي"}, {"id": 5, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 6, "arabic": "وَيَأْتِ", "translit": "ِtْaʾَyَw", "root": "اتي"}, {"id": 7, "arabic": "بِـَٔاخَرِينَ", "translit": "َnyِrَhkāَٔـِb", "root": "اخر"}, {"id": 8, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 12, "arabic": "قَدِيرًا", "translit": "āًryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 134, "text": "مَّن كَانَ يُرِيدُ ثَوَابَ ٱلدُّنْيَا فَعِندَ ٱللَّهِ ثَوَابُ ٱلدُّنْيَا وَٱلْءَاخِرَةِۚ وَكَانَ ٱللَّهُ سَمِيعًۢا بَصِيرًا ", "translation": "Whoever desires the reward of this world - then with Allāh is the reward of this world and the Hereafter. And ever is Allāh Hearing and Seeing.", "words": [{"id": 1, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 4, "arabic": "ثَوَابَ", "translit": "َbāَwَht", "root": "ثوب"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "فَعِندَ", "translit": "َdnِʿعَf", "root": "عند"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "ثَوَابُ", "translit": "ُbāَwَht", "root": "ثوب"}, {"id": 9, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 10, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 11, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "سَمِيعًۢا", "translit": "āًۢʿعyِmَs", "root": "سمع"}, {"id": 14, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر"}], "hasIhya": false}, {"ayah": 135, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ كُونُوا۟ قَوَّٰمِينَ بِٱلْقِسْطِ شُهَدَآءَ لِلَّهِ وَلَوْ عَلَىٰٓ أَنفُسِكُمْ أَوِ ٱلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَۚ إِن يَكُنْ غَنِيًّا أَوْ فَقِيرًا فَٱللَّهُ أَوْلَىٰ بِهِمَاۖ فَلَا تَتَّبِعُوا۟ ٱلْهَوَىٰٓ أَن تَعْدِلُوا۟ۚ وَإِن تَلْوُۥٓا۟ أَوْ تُعْرِضُوا۟ فَإِنَّ ٱللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا ", "translation": "O you who have believed, be persistently standing firm in justice, witnesses for Allāh, even if it be against yourselves or parents and relatives. Whether one is rich or poor, Allāh is more worthy of both.[1] So follow not [personal] inclination, lest you not be just. And if you distort [your testimony] or refuse [to give it], then indeed Allāh is ever, of what you do, Aware.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "كُونُوا۟", "translit": "۟āwُnwُk", "root": "كون"}, {"id": 5, "arabic": "قَوَّٰمِينَ", "translit": "َnyِmَّٰwَq", "root": "قوم"}, {"id": 6, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 7, "arabic": "شُهَدَآءَ", "translit": "َءٓāَdَhُhs", "root": "شهد"}, {"id": 8, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 9, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 10, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 11, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 12, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 13, "arabic": "ٱلْوَٰلِدَيْنِ", "translit": "ِnْyَdِlَٰwْlٱ", "root": "ولد"}, {"id": 14, "arabic": "وَٱلْأَقْرَبِينَ", "translit": "َnyِbَrْqَaʾْlٱَw", "root": "قرب"}, {"id": 15, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 16, "arabic": "يَكُنْ", "translit": "ْnُkَy", "root": "كون"}, {"id": 17, "arabic": "غَنِيًّا", "translit": "āًّyِnَغ", "root": "غني"}, {"id": 18, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 19, "arabic": "فَقِيرًا", "translit": "āًryِqَf", "root": "فقر"}, {"id": 20, "arabic": "فَٱللَّهُ", "translit": "ُhَّllٱَf", "root": "اله"}, {"id": 21, "arabic": "أَوْلَىٰ", "translit": "ٰàَlْwَaʾ", "root": "ولي"}, {"id": 22, "arabic": "بِهِمَا", "translit": "āَmِhِb", "root": ""}, {"id": 23, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 24, "arabic": "تَتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtَt", "root": "تبع"}, {"id": 25, "arabic": "ٱلْهَوَىٰٓ", "translit": "ٰٓàَwَhْlٱ", "root": "هوي"}, {"id": 26, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 27, "arabic": "تَعْدِلُوا۟", "translit": "۟āwُlِdْʿعَt", "root": "عدل"}, {"id": 28, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 29, "arabic": "تَلْوُۥٓا۟", "translit": "۟āٓۥُwْlَt", "root": "لوي"}, {"id": 30, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 31, "arabic": "تُعْرِضُوا۟", "translit": "۟āwُḍِrْʿعُt", "root": "عرض"}, {"id": 32, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 33, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 34, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 35, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 36, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 37, "arabic": "خَبِيرًا", "translit": "āًryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 136, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ ءَامِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَٱلْكِتَٰبِ ٱلَّذِى نَزَّلَ عَلَىٰ رَسُولِهِۦ وَٱلْكِتَٰبِ ٱلَّذِىٓ أَنزَلَ مِن قَبْلُۚ وَمَن يَكْفُرْ بِٱللَّهِ وَمَلَٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ وَٱلْيَوْمِ ٱلْءَاخِرِ فَقَدْ ضَلَّ ضَلَٰلًۢا بَعِيدًا ", "translation": "O you who have believed, believe[1] in Allāh and His Messenger and the Book that He sent down upon His Messenger and the Scripture which He sent down before. And whoever disbelieves in Allāh, His angels, His books, His messengers, and the Last Day has certainly gone far astray.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ءَامِنُوا۟", "translit": "۟āwُnِmāَء", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 7, "arabic": "وَٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱَw", "root": "كتب"}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "رَسُولِهِۦ", "translit": "ۦِhِlwُsَr", "root": "رسل"}, {"id": 12, "arabic": "وَٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱَw", "root": "كتب"}, {"id": 13, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 15, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 16, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 17, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 18, "arabic": "يَكْفُرْ", "translit": "ْrُfْkَy", "root": "كفر"}, {"id": 19, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 20, "arabic": "وَمَلَٰٓئِكَتِهِۦ", "translit": "ۦِhِtَkِyʾَٰٓlَmَw", "root": "ملك"}, {"id": 21, "arabic": "وَكُتُبِهِۦ", "translit": "ۦِhِbُtُkَw", "root": "كتب"}, {"id": 22, "arabic": "وَرُسُلِهِۦ", "translit": "ۦِhِlُsُrَw", "root": "رسل"}, {"id": 23, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 24, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 25, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 26, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 27, "arabic": "ضَلَٰلًۢا", "translit": "āًۢlَٰlَḍ", "root": "ضلل"}, {"id": 28, "arabic": "بَعِيدًا", "translit": "āًdyِʿعَb", "root": "بعد"}], "hasIhya": true}, {"ayah": 137, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ ثُمَّ كَفَرُوا۟ ثُمَّ ءَامَنُوا۟ ثُمَّ كَفَرُوا۟ ثُمَّ ٱزْدَادُوا۟ كُفْرًا لَّمْ يَكُنِ ٱللَّهُ لِيَغْفِرَ لَهُمْ وَلَا لِيَهْدِيَهُمْ سَبِيلًۢا ", "translation": "Indeed, those who have believed then disbelieved, then believed then disbelieved, and then increased in disbelief - never will Allāh forgive them, nor will He guide them to a way.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "ٱزْدَادُوا۟", "translit": "۟āwُdāَdْzٱ", "root": "زيد"}, {"id": 12, "arabic": "كُفْرًا", "translit": "āًrْfُk", "root": "كفر"}, {"id": 13, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 14, "arabic": "يَكُنِ", "translit": "ِnُkَy", "root": "كون"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "لِيَغْفِرَ", "translit": "َrِfْغَyِl", "root": "غفر"}, {"id": 17, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "لِيَهْدِيَهُمْ", "translit": "ْmُhَyِdْhَyِl", "root": "هدي"}, {"id": 20, "arabic": "سَبِيلًۢا", "translit": "āًۢlyِbَs", "root": "سبل"}], "hasIhya": false}, {"ayah": 138, "text": "بَشِّرِ ٱلْمُنَٰفِقِينَ بِأَنَّ لَهُمْ عَذَابًا أَلِيمًا ", "translation": "Give tidings to the hypocrites that there is for them a painful punishment -", "words": [{"id": 1, "arabic": "بَشِّرِ", "translit": "ِrِّhsَb", "root": "بشر"}, {"id": 2, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 3, "arabic": "بِأَنَّ", "translit": "َّnَaʾِb", "root": ""}, {"id": 4, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 5, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 6, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 139, "text": "ٱلَّذِينَ يَتَّخِذُونَ ٱلْكَٰفِرِينَ أَوْلِيَآءَ مِن دُونِ ٱلْمُؤْمِنِينَۚ أَيَبْتَغُونَ عِندَهُمُ ٱلْعِزَّةَ فَإِنَّ ٱلْعِزَّةَ لِلَّهِ جَمِيعًا ", "translation": "Those who take disbelievers as allies instead of the believers. Do they seek with them honor [through power]? But indeed, honor belongs to Allāh entirely.[1]", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَتَّخِذُونَ", "translit": "َnwُhdِhkَّtَy", "root": "اخذ"}, {"id": 3, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 4, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 8, "arabic": "أَيَبْتَغُونَ", "translit": "َnwُغَtْbَyَaʾ", "root": "بغي"}, {"id": 9, "arabic": "عِندَهُمُ", "translit": "ُmُhَdnِʿع", "root": "عند"}, {"id": 10, "arabic": "ٱلْعِزَّةَ", "translit": "َẗَّzِʿعْlٱ", "root": "عزز"}, {"id": 11, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 12, "arabic": "ٱلْعِزَّةَ", "translit": "َẗَّzِʿعْlٱ", "root": "عزز"}, {"id": 13, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 14, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}], "hasIhya": false}, {"ayah": 140, "text": "وَقَدْ نَزَّلَ عَلَيْكُمْ فِى ٱلْكِتَٰبِ أَنْ إِذَا سَمِعْتُمْ ءَايَٰتِ ٱللَّهِ يُكْفَرُ بِهَا وَيُسْتَهْزَأُ بِهَا فَلَا تَقْعُدُوا۟ مَعَهُمْ حَتَّىٰ يَخُوضُوا۟ فِى حَدِيثٍ غَيْرِهِۦٓۚ إِنَّكُمْ إِذًا مِّثْلُهُمْۗ إِنَّ ٱللَّهَ جَامِعُ ٱلْمُنَٰفِقِينَ وَٱلْكَٰفِرِينَ فِى جَهَنَّمَ جَمِيعًا ", "translation": "And it has already come down to you in the Book [i.e., the Qur’ān] that when you hear the verses of Allāh [recited], they are denied [by them] and ridiculed; so do not sit with them until they enter into another conversation. Indeed, you would then be like them.[1] Indeed, Allāh will gather the hypocrites and disbelievers in Hell all together -", "words": [{"id": 1, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 2, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 3, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 7, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 8, "arabic": "سَمِعْتُمْ", "translit": "ْmُtْʿعِmَs", "root": "سمع"}, {"id": 9, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "يُكْفَرُ", "translit": "ُrَfْkُy", "root": "كفر"}, {"id": 12, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 13, "arabic": "وَيُسْتَهْزَأُ", "translit": "ُaʾَzْhَtْsُyَw", "root": "هزا"}, {"id": 14, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 15, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 16, "arabic": "تَقْعُدُوا۟", "translit": "۟āwُdُʿعْqَt", "root": "قعد"}, {"id": 17, "arabic": "مَعَهُمْ", "translit": "ْmُhَʿعَm", "root": ""}, {"id": 18, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 19, "arabic": "يَخُوضُوا۟", "translit": "۟āwُḍwُhkَy", "root": "خوض"}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 21, "arabic": "حَدِيثٍ", "translit": "ٍhtyِdَḥ", "root": "حدث"}, {"id": 22, "arabic": "غَيْرِهِۦٓ", "translit": "ٓۦِhِrْyَغ", "root": "غير"}, {"id": 23, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 24, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 25, "arabic": "مِّثْلُهُمْ", "translit": "ْmُhُlْhtِّm", "root": "مثل"}, {"id": 26, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 27, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "جَامِعُ", "translit": "ُʿعِmāَjg", "root": "جمع"}, {"id": 29, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 30, "arabic": "وَٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱَw", "root": "كفر"}, {"id": 31, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 32, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 33, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}], "hasIhya": true}, {"ayah": 141, "text": "ٱلَّذِينَ يَتَرَبَّصُونَ بِكُمْ فَإِن كَانَ لَكُمْ فَتْحٌ مِّنَ ٱللَّهِ قَالُوٓا۟ أَلَمْ نَكُن مَّعَكُمْ وَإِن كَانَ لِلْكَٰفِرِينَ نَصِيبٌ قَالُوٓا۟ أَلَمْ نَسْتَحْوِذْ عَلَيْكُمْ وَنَمْنَعْكُم مِّنَ ٱلْمُؤْمِنِينَۚ فَٱللَّهُ يَحْكُمُ بَيْنَكُمْ يَوْمَ ٱلْقِيَٰمَةِۗ وَلَن يَجْعَلَ ٱللَّهُ لِلْكَٰفِرِينَ عَلَى ٱلْمُؤْمِنِينَ سَبِيلًا ", "translation": "Those who wait [and watch] you. Then if you gain a victory from Allāh, they say, \"Were we not with you?\" But if the disbelievers have a success, they say [to them], \"Did we not gain the advantage over you, but we protected you from the believers?\" Allāh will judge between [all of] you on the Day of Resurrection, and never will Allāh give the disbelievers over the believers a way [to overcome them].[1]", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَتَرَبَّصُونَ", "translit": "َnwُṣَّbَrَtَy", "root": "ربص"}, {"id": 3, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 4, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 5, "arabic": "كَانَ", "transli