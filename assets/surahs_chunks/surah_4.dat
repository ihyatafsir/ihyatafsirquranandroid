 اُ۬للَّهَ وَلْيَقُولُواْ قَوْلاࣰ سَدِيداًۖ","words":[{"id":1,"arabic":"وَلْيَخْشَ","translit":"","root":""},{"id":2,"arabic":"اَ۬لذِينَ","translit":"","root":""},{"id":3,"arabic":"لَوْ","translit":"","root":""},{"id":4,"arabic":"تَرَكُواْ","translit":"","root":""},{"id":5,"arabic":"مِنْ","translit":"","root":""},{"id":6,"arabic":"خَلْفِهِمْ","translit":"","root":""},{"id":7,"arabic":"ذُرِّيَّةࣰ","translit":"","root":""},{"id":8,"arabic":"ضِعَٰفاً","translit":"","root":""},{"id":9,"arabic":"خَافُواْ","translit":"","root":""},{"id":10,"arabic":"عَلَيْهِمْۖ","translit":"","root":""},{"id":11,"arabic":"فَلْيَتَّقُواْ","translit":"","root":""},{"id":12,"arabic":"اُ۬للَّهَ","translit":"","root":""},{"id":13,"arabic":"وَلْيَقُولُواْ","translit":"","root":""},{"id":14,"arabic":"قَوْلاࣰ","translit":"","root":""},{"id":15,"arabic":"سَدِيداًۖ","translit":"","root":""}],"narration":"warsh"},{"surah":4,"ayah":10,"text":"اِنَّ اَ۬لذِينَ يَاكُلُونَ أَمْوَٰلَ اَ۬لْيَتَٰم۪يٰ ظُلْماً اِنَّمَا يَاكُلُونَ فِے بُطُونِهِمْ نَاراࣰۖ وَسَيَصْلَوْنَ سَعِيراࣰۖ","words":[{"id":1,"arabic":"اِنَّ","translit":"","root":""},{"id":2,"arabic":"اَ۬لذِينَ","translit":"","root":""},{"id":3,"arabic":"يَاكُلُونَ","translit":"","root":""},{"id":4,"arabic":"أَمْوَٰلَ","translit":"","root":""},{"id":5,"arabic":"اَ۬لْيَتَٰم۪يٰ","translit":"","root":""},{"id":6,"arabic":"ظُلْماً","translit":"","root":""},{"id":7,"arabic":"اِنَّمَا","translit":"","root":""},{"id":8,"arabic":"يَاكُلُونَ","translit":"","root":""},{"id":9,"arabic":"فِے","translit":"","root":""},{"id":10,"arabic":"بُطُونِهِمْ","translit":"","root":""},{"id":11,"arabic":"نَاراࣰۖ","translit":"","root":""},{"id":12,"arabic":"وَسَيَصْلَوْنَ","translit":"","root":""},{"id":13,"arabic":"سَعِيراࣰۖ","translit":"","root":""}],"narration":"warsh"},{"surah":4,"ayah":11,"text":"۞يُوصِيكُمُ اُ۬للَّهُ فِےٓ أَوْلَٰدِكُمْۖ لِلذَّكَرِ مِثْلُ حَظِّ اِ۬لُانثَيَيْنِۖ فَإِن كُنَّ نِسَآءࣰ فَوْقَ اَ۪ثْنَتَيْنِ فَلَهُنَّ ثُلُثَا مَا تَرَكَۖ وَإِن كَانَتْ وَٰحِدَةࣱ فَلَهَا اَ۬لنِّصْفُۖ وَلِأَبَوَيْهِ لِكُلِّ وَٰحِدࣲ مِّنْهُمَا اَ۬لسُّدُسُ مِمَّا تَرَكَ إِن كَانَ لَهُۥ وَلَدࣱۖ فَإِن لَّمْ يَكُن لَّهُۥ وَلَدࣱ وَوَرِثَهُۥٓ أَبَوَٰهُ فَلِأُمِّهِ اِ۬لثُّلُثُۖ فَإِن كَانَ لَهُۥٓ إِخْوَةࣱ فَلِأُمِّهِ اِ۬لسُّدُسُۖ مِنۢ بَعْدِ وَصِيَّةࣲ يُوصِے بِهَآ أَوْ دَيْنٍۖ اٰبَآؤُكُمْ وَأَبْنَآؤُكُمْ لَا تَدْرُونَ أَيُّهُمُۥٓ أَقْرَبُ لَكُمْ نَفْعاࣰۖ فَرِيضَةࣰ مِّنَ اَ۬للَّهِۖ إِنَّ اَ۬للَّهَ كَانَ عَلِيماً حَكِيماࣰۖ","words":[{"id":1,"arabic":"۞يُوصِيكُمُ","translit":"","root":""},{"id":2,"arabic":"اُ۬للَّهُ","translit":"","root":""},{"id":3,"arabic":"فِےٓ","translit":"","root":""},{"id":4,"arabic":"أَوْلَٰدِكُمْۖ","translit":"","root":""},{"id":5,"arabic":"لِلذَّكَرِ","translit":"","root":""},{"id":6,"arabic":"مِثْلُ","translit":"","root":""},{"id":7,"arabic":"حَظِّ","translit":"","root":""},{"id":8,"arabic":"اِ۬لُانثَيَيْنِۖ","translit":"","root":""},{"id":9,"arabic":"فَإِن","translit":"","root":""},{"id":10,"arabic":"كُنَّ","translit":"","root":""},{"id":11,"arabic":"نِسَآءࣰ","translit":"","root":""},{"id":12,"arabic":"فَوْقَ","translit":"","root":""},{"id":13,"arabic":"اَ۪ثْنَتَيْنِ","translit":"","root":""},{"id":14,"arabic":"فَلَهُنَّ","translit":"","root":""},{"id":15,"arabic":"ثُلُثَا","translit":"","root":""},{"id":16,"arabic":"مَا","translit":"","root":""},{"id":17,"arabic":"تَرَكَۖ","translit":"","root":""},{"id":18,"arabic":"وَإِن","translit":"","root":""},{"id":19,"arabic":"كَانَتْ","translit":"","root":""},{"id":20,"arabic":"وَٰحِدَةࣱ","translit":"","root":""},{"id":21,"arabic":"فَلَهَا","translit":"","root":""},{"id":22,"arabic":"اَ۬لنِّصْفُۖ","translit":"","root":""},{"id":23,"arabic":"وَلِأَبَوَيْهِ","translit":"","root":""},{"id":24,"arabic":"لِكُلِّ","translit":"","root":""},{"id":25,"arabic":"وَٰحِدࣲ","translit":"","root":""},{"id":26,"arabic":"مِّنْهُمَا","translit":"","root":""},{"id":27,"arabic":"اَ۬لسُّدُسُ","translit":"","root":""},{"id":28,"arabic":"مِمَّا","translit":"","root":""},{"id":29,"arab