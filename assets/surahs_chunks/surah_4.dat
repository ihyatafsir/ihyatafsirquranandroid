ٍ","translit":"ٍẗَّyِṣَw","root":"وصي"},{"id":77,"arabic":"يُوصَىٰ","translit":"ٰàَṣwُy","root":"وصي"},{"id":78,"arabic":"بِهَآ","translit":"ٓāَhِb","root":""},{"id":79,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":80,"arabic":"دَيْنٍ","translit":"ٍnْyَd","root":"دين"},{"id":81,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":82,"arabic":"مُضَآرٍّ","translit":"ٍّrٓāَḍُm","root":"ضرر"},{"id":83,"arabic":"وَصِيَّةً","translit":"ًẗَّyِṣَw","root":"وصي"},{"id":84,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":85,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":86,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":87,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"},{"id":88,"arabic":"حَلِيمٌ","translit":"ٌmyِlَḥ","root":"حلم"}],"hasIhya":true},{"ayah":13,"text":"تِلْكَ حُدُودُ ٱللَّهِۚ وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ يُدْخِلْهُ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ ","translation":"These are the limits [set by] Allāh, and whoever obeys Allāh and His Messenger will be admitted by Him to gardens [in Paradise] under which rivers flow, abiding eternally therein; and that is the great attainment.","words":[{"id":1,"arabic":"تِلْكَ","translit":"َkْlِt","root":""},{"id":2,"arabic":"حُدُودُ","translit":"ُdwُdُḥ","root":"حدد"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":5,"arabic":"يُطِعِ","translit":"ِʿعِṭُy","root":"طوع"},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":8,"arabic":"يُدْخِلْهُ","translit":"ُhْlِhkْdُy","root":"دخل"},{"id":9,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":10,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":11,"arabic":"مِن","translit":"nِm","root":""},{"id":12,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":13,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":14,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":15,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":16,"arabic":"وَذَٰلِكَ","translit":"َkِlَٰhdَw","root":""},{"id":17,"arabic":"ٱلْفَوْزُ","translit":"ُzْwَfْlٱ","root":"فوز"},{"id":18,"arabic":"ٱلْعَظِيمُ","translit":"ُmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":true},{"ayah":14,"text":"وَمَن يَعْصِ ٱللَّهَ وَرَسُولَهُۥ وَيَتَعَدَّ حُدُودَهُۥ يُدْخِلْهُ نَارًا خَٰلِدًا فِيهَا وَلَهُۥ عَذَابٌ مُّهِينٌ ","translation":"And whoever disobeys Allāh and His Messenger and transgresses His limits - He will put him into the Fire to abide eternally therein, and he will have a humiliating punishment.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَعْصِ","translit":"ِṣْʿعَy","root":"عصي"},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":5,"arabic":"وَيَتَعَدَّ","translit":"َّdَʿعَtَyَw","root":"عدو"},{"id":6,"arabic":"حُدُودَهُۥ","translit":"ۥُhَdwُdُḥ","root":"حدد"},{"id":7,"arabic":"يُدْخِلْهُ","translit":"ُhْlِhkْdُy","root":"دخل"},{"id":8,"arabic":"نَارًا","translit":"āًrāَn","root":"نور"},{"id":9,"arabic":"خَٰلِدًا","translit":"āًdِlَٰhk","root":"خلد"},{"id":10,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":11,"arabic":"وَلَهُۥ","translit":"ۥُhَlَw","root":""},{"id":12,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":13,"arabic":"مُّهِينٌ","translit":"ٌnyِhُّm","root":"هون"}],"hasIhya":true},{"ayah":15,"text":"وَٱلَّٰتِى يَأْتِينَ ٱلْفَٰحِشَةَ مِن نِّسَآئِكُمْ فَٱسْتَشْهِدُوا۟ عَلَيْهِنَّ أَرْبَعَةً مِّنكُمْۖ فَإِن شَهِدُوا۟ فَأَمْسِكُوهُنَّ فِى ٱلْبُيُوتِ حَتَّىٰ يَتَوَفَّىٰهُنَّ ٱلْمَوْتُ أَوْ يَجْعَلَ ٱللَّهُ لَهُنَّ سَبِيلًا ","translation":"Those who commit immorality [i.e., unlawful sexual intercourse] of your women - bring against them four [witnesses] from among you. And if they testify,[1] confine them [i.e., the guilty women] to houses until death takes them or Allāh ordains for them [another] way.[2]","words":[{"id":1,"arabic":"وَٱلَّٰتِى","translit":"àِtَّٰlٱَw","root":""},{"id":2,"arabic":"يَأْتِينَ","translit":"َnyِtْaʾَy","root":"اتي"},{"id":3,"arabic":"ٱلْفَٰحِشَةَ","translit":"َẗَhsِḥَٰfْlٱ","root":"فحش"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"نِّسَآئِكُمْ","translit":"ْmُkِyʾٓāَsِّn","root":"نسو"},{"id":6,"arabic":"فَٱسْتَشْهِدُوا۟","translit":"۟āwُdِhْhsَtْsٱَf","root":"شهد"},{"id":7,"arabic":"عَلَيْهِنَّ","translit":"َّnِhْyَlَʿع","root":""},{"id":8,"arabic":"أَرْبَعَةً","translit":"ًẗَʿعَbْrَaʾ","root":"ربع"},{"id":9,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":10,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":11,"arabic":"شَهِدُوا۟","translit":"۟āwُdِhَhs","root":"شهد"},{"id":12,"arabic":"فَأَمْسِكُوهُنَّ","translit":"َّnُhwُkِsْmَaʾَf","root":"مسك"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"ٱلْبُيُوتِ","translit":"ِtwُyُbْlٱ","root":"بيت"},{"id":15,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":16,"arabic":"يَتَوَفَّىٰهُنَّ","translit":"َّnُhٰàَّfَwَtَy","root":"وفي"},{"id":17,"arabic":"ٱلْمَوْتُ","translit":"ُtْwَmْlٱ","root":"موت"},{"id":18,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":19,"arabic":"يَجْعَلَ","translit":"َlَʿعْjgَy","root":"جعل"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"لَهُنَّ","translit":"َّnُhَl","root":""},{"id":22,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":16,"text":"وَٱلَّذَانِ يَأْتِيَٰنِهَا مِنكُمْ فَـَٔاذُوهُمَاۖ فَإِن تَابَا وَأَصْلَحَا فَأَعْرِضُوا۟ عَنْهُمَآۗ إِنَّ ٱللَّهَ كَانَ تَوَّابًا رَّحِيمًا ","translation":"And the two[1] who commit it [i.e., unlawful sexual intercourse] among you - punish [i.e., dishonor] them both. But if they repent and correct themselves, leave them alone. Indeed, Allāh is ever Accepting of Repentance and Merciful.","words":[{"id":1,"arabic":"وَٱلَّذَانِ","translit":"ِnāَhdَّlٱَw","root":""},{"id":2,"arabic":"يَأْتِيَٰنِهَا","translit":"āَhِnَٰyِtْaʾَy","root":"اتي"},{"id":3,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":4,"arabic":"فَـَٔاذُوهُمَا","translit":"āَmُhwُhdāَٔـَf","root":"اذي"},{"id":5,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":6,"arabic":"تَابَا","translit":"āَbāَt","root":"توب"},{"id":7,"arabic":"وَأَصْلَحَا","translit":"āَḥَlْṣَaʾَw","root":"صلح"},{"id":8,"arabic":"فَأَعْرِضُوا۟","translit":"۟āwُḍِrْʿعَaʾَf","root":"عرض"},{"id":9,"arabic":"عَنْهُمَآ","translit":"ٓāَmُhْnَʿع","root":""},{"id":10,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":11,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":12,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":13,"arabic":"تَوَّابًا","translit":"āًbāَّwَt","root":"توب"},{"id":14,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":17,"text":"إِنَّمَا ٱلتَّوْبَةُ عَلَى ٱللَّهِ لِلَّذِينَ يَعْمَلُونَ ٱلسُّوٓءَ بِجَهَٰلَةٍ ثُمَّ يَتُوبُونَ مِن قَرِيبٍ فَأُو۟لَٰٓئِكَ يَتُوبُ ٱللَّهُ عَلَيْهِمْۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ","translation":"The repentance accepted by Allāh is only for those who do wrong in ignorance [or carelessness] and then repent soon [after].[1] It is those to whom Allāh will turn in forgiveness, and Allāh is ever Knowing and Wise.","words":[{"id":1,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":2,"arabic":"ٱلتَّوْبَةُ","translit":"ُẗَbْwَّtlٱ","root":"توب"},{"id":3,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":6,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"},{"id":7,"arabic":"ٱلسُّوٓءَ","translit":"َءٓwُّslٱ","root":"سوا"},{"id":8,"arabic":"بِجَهَٰلَةٍ","translit":"ٍẗَlَٰhَjgِb","root":"جهل"},{"id":9,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":10,"arabic":"يَتُوبُونَ","translit":"َnwُbwُtَy","root":"توب"},{"id":11,"arabic":"مِن","translit":"nِm","root":""},{"id":12,"arabic":"قَرِيبٍ","translit":"ٍbyِrَq","root":"قرب"},{"id":13,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":14,"arabic":"يَتُوبُ","translit":"ُbwُtَy","root":"توب"},{"id":15,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":16,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":17,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":18,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":19,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"},{"id":20,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":18,"text":"وَلَيْسَتِ ٱلتَّوْبَةُ لِلَّذِينَ يَعْمَلُونَ ٱلسَّيِّـَٔاتِ حَتَّىٰٓ إِذَا حَضَرَ أَحَدَهُمُ ٱلْمَوْتُ قَالَ إِنِّى تُبْتُ ٱلْـَٰٔنَ وَلَا ٱلَّذِينَ يَمُوتُونَ وَهُمْ كُفَّارٌۚ أُو۟لَٰٓئِكَ أَعْتَدْنَا لَهُمْ عَذَابًا أَلِيمًا ","translation":"But repentance is not [accepted] of those who [continue to] do evil deeds up until, when death comes to one of them, he says, \"Indeed, I have repented now,\" or of those who die while they are disbelievers. For them We have prepared a painful punishment.","words":[{"id":1,"arabic":"وَلَيْسَتِ","translit":"ِtَsْyَlَw","root":"ليس"},{"id":2,"arabic":"ٱلتَّوْبَةُ","translit":"ُẗَbْwَّtlٱ","root":"توب"},{"id":3,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":4,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"},{"id":5,"arabic":"ٱلسَّيِّـَٔاتِ","translit":"ِtāَٔـِّyَّslٱ","root":"سوا"},{"id":6,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":7,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":8,"arabic":"حَضَرَ","translit":"َrَḍَḥ","root":"حضر"},{"id":9,"arabic":"أَحَدَهُمُ","translit":"ُmُhَdَḥَaʾ","root":"احد"},{"id":10,"arabic":"ٱلْمَوْتُ","translit":"ُtْwَmْlٱ","root":"موت"},{"id":11,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":12,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":13,"arabic":"تُبْتُ","translit":"ُtْbُt","root":"توب"},{"id":14,"arabic":"ٱلْـَٰٔنَ","translit":"َnَٰٔـْlٱ","root":"اون"},{"id":15,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":16,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":17,"arabic":"يَمُوتُونَ","translit":"َnwُtwُmَy","root":"موت"},{"id":18,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":19,"arabic":"كُفَّارٌ","translit":"ٌrāَّfُk","root":"كفر"},{"id":20,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":21,"arabic":"أَعْتَدْنَا","translit":"āَnْdَtْʿعَaʾ","root":"عتد"},{"id":22,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":23,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":24,"arabic":"أَلِيمًا","translit":"āًmyِlَaʾ","root":"الم"}],"hasIhya":true},{"ayah":19,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا يَحِلُّ لَكُمْ أَن تَرِثُوا۟ ٱلنِّسَآءَ كَرْهًاۖ وَلَا تَعْضُلُوهُنَّ لِتَذْهَبُوا۟ بِبَعْضِ مَآ ءَاتَيْتُمُوهُنَّ إِلَّآ أَن يَأْتِينَ بِفَٰحِشَةٍ مُّبَيِّنَةٍۚ وَعَاشِرُوهُنَّ بِٱلْمَعْرُوفِۚ فَإِن كَرِهْتُمُوهُنَّ فَعَسَىٰٓ أَن تَكْرَهُوا۟ شَيْـًٔا وَيَجْعَلَ ٱللَّهُ فِيهِ خَيْرًا كَثِيرًا ","translation":"O you who have believed, it is not lawful for you to inherit women by compulsion.[1] And do not make difficulties for them in order to take [back] part of what you gave them[2] unless they commit a clear immorality [i.e., adultery]. And live with them in kindness. For if you dislike them - perhaps you dislike a thing and Allāh makes therein much good.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"يَحِلُّ","translit":"ُّlِḥَy","root":"حلل"},{"id":6,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":7,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":8,"arabic":