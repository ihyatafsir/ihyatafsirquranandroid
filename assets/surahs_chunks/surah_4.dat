:"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"يَتَرَبَّصُونَ","translit":"َnwُṣَّbَrَtَy","root":"ربص"},{"id":3,"arabic":"بِكُمْ","translit":"ْmُkِb","root":""},{"id":4,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":5,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":6,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":7,"arabic":"فَتْحٌ","translit":"ٌḥْtَf","root":"فتح"},{"id":8,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":11,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":12,"arabic":"نَكُن","translit":"nُkَn","root":"كون"},{"id":13,"arabic":"مَّعَكُمْ","translit":"ْmُkَʿعَّm","root":""},{"id":14,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":15,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":16,"arabic":"لِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِl","root":"كفر"},{"id":17,"arabic":"نَصِيبٌ","translit":"ٌbyِṣَn","root":"نصب"},{"id":18,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":19,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":20,"arabic":"نَسْتَحْوِذْ","translit":"ْhdِwْḥَtْsَn","root":"حوذ"},{"id":21,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":22,"arabic":"وَنَمْنَعْكُم","translit":"mُkْʿعَnْmَnَw","root":"منع"},{"id":23,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":24,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":25,"arabic":"فَٱللَّهُ","translit":"ُhَّllٱَf","root":"اله"},{"id":26,"arabic":"يَحْكُمُ","translit":"ُmُkْḥَy","root":"حكم"},{"id":27,"arabic":"بَيْنَكُمْ","translit":"ْmُkَnْyَb","root":"بين"},{"id":28,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":29,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":30,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":31,"arabic":"يَجْعَلَ","translit":"َlَʿعْjgَy","root":"جعل"},{"id":32,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":33,"arabic":"لِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِl","root":"كفر"},{"id":34,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":35,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":36,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":true},{"ayah":142,"text":"إِنَّ ٱلْمُنَٰفِقِينَ يُخَٰدِعُونَ ٱللَّهَ وَهُوَ خَٰدِعُهُمْ وَإِذَا قَامُوٓا۟ إِلَى ٱلصَّلَوٰةِ قَامُوا۟ كُسَالَىٰ يُرَآءُونَ ٱلنَّاسَ وَلَا يَذْكُرُونَ ٱللَّهَ إِلَّا قَلِيلًا ","translation":"Indeed, the hypocrites [think to] deceive Allāh, but He is deceiving them. And when they stand for prayer, they stand lazily, showing [themselves to] the people and not remembering Allāh except a little,","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلْمُنَٰفِقِينَ","translit":"َnyِqِfَٰnُmْlٱ","root":"نفق"},{"id":3,"arabic":"يُخَٰدِعُونَ","translit":"َnwُʿعِdَٰhkُy","root":"خدع"},{"id":4,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":5,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":6,"arabic":"خَٰدِعُهُمْ","translit":"ْmُhُʿعِdَٰhk","root":"خدع"},{"id":7,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":8,"arabic":"قَامُوٓا۟","translit":"۟āٓwُmāَq","root":"قوم"},{"id":9,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":10,"arabic":"ٱلصَّلَوٰةِ","translit":"ِẗٰwَlَّṣlٱ","root":"صلو"},{"id":11,"arabic":"قَامُوا۟","translit":"۟āwُmāَq","root":"قوم"},{"id":12,"arabic":"كُسَالَىٰ","translit":"ٰàَlāَsُk","root":"كسل"},{"id":13,"arabic":"يُرَآءُونَ","translit":"َnwُءٓāَrُy","root":"راي"},{"id":14,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":15,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":16,"arabic":"يَذْكُرُونَ","translit":"َnwُrُkْhdَy","root":"ذكر"},{"id":17,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":18,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":19,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"}],"hasIhya":true},{"ayah":143,"text":"مُّذَبْذَبِينَ بَيْنَ ذَٰلِكَ لَآ إِلَىٰ هَٰٓؤُلَآءِ وَلَآ إِلَىٰ هَٰٓؤُلَآءِۚ وَمَن يُضْلِلِ ٱللَّهُ فَلَن تَجِدَ لَهُۥ سَبِيلًا ","translation":"Wavering between them, [belonging] neither to these [i.e., the believers] nor to those [i.e., the disbelievers]. And whoever Allāh sends astray - never will you find for him a way.","words":[{"id":1,"arabic":"مُّذَبْذَبِينَ","translit":"َnyِbَhdْbَhdُّm","root":"ذبذب"},{"id":2,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":3,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":4,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":5,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":6,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":7,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":8,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":9,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":10,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":11,"arabic":"يُضْلِلِ","translit":"ِlِlْḍُy","root":"ضلل"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"فَلَن","translit":"nَlَf","root":""},{"id":14,"arabic":"تَجِدَ","translit":"َdِjgَt","root":"وجد"},{"id":15,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":16,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":true},{"ayah":144,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوا۟ ٱلْكَٰفِرِينَ أَوْلِيَآءَ مِن دُونِ ٱلْمُؤْمِنِينَۚ أَتُرِيدُونَ أَن تَجْعَلُوا۟ لِلَّهِ عَلَيْكُمْ سُلْطَٰنًا مُّبِينًا ","translation":"O you who have believed, do not take the disbelievers as allies instead of the believers. Do you wish to give Allāh against yourselves a clear case?","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَتَّخِذُوا۟","translit":"۟āwُhdِhkَّtَt","root":"اخذ"},{"id":6,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"},{"id":7,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":10,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":11,"arabic":"أَتُرِيدُونَ","translit":"َnwُdyِrُtَaʾ","root":"رود"},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"تَجْعَلُوا۟","translit":"۟āwُlَʿعْjgَt","root":"جعل"},{"id":14,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":15,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":16,"arabic":"سُلْطَٰنًا","translit":"āًnَٰṭْlُs","root":"سلط"},{"id":17,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":true},{"ayah":145,"text":"إِنَّ ٱلْمُنَٰفِقِينَ فِى ٱلدَّرْكِ ٱلْأَسْفَلِ مِنَ ٱلنَّارِ وَلَن تَجِدَ لَهُمْ نَصِيرًا ","translation":"Indeed, the hypocrites will be in the lowest depths of the Fire - and never will you find for them a helper -","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلْمُنَٰفِقِينَ","translit":"َnyِqِfَٰnُmْlٱ","root":"نفق"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلدَّرْكِ","translit":"ِkْrَّdlٱ","root":"درك"},{"id":5,"arabic":"ٱلْأَسْفَلِ","translit":"ِlَfْsَaʾْlٱ","root":"سفل"},{"id":6,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":7,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":8,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":9,"arabic":"تَجِدَ","translit":"َdِjgَt","root":"وجد"},{"id":10,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":11,"arabic":"نَصِيرًا","translit":"āًryِṣَn","root":"نصر"}],"hasIhya":true},{"ayah":146,"text":"إِلَّا ٱلَّذِينَ تَابُوا۟ وَأَصْلَحُوا۟ وَٱعْتَصَمُوا۟ بِٱللَّهِ وَأَخْلَصُوا۟ دِينَهُمْ لِلَّهِ فَأُو۟لَٰٓئِكَ مَعَ ٱلْمُؤْمِنِينَۖ وَسَوْفَ يُؤْتِ ٱللَّهُ ٱلْمُؤْمِنِينَ أَجْرًا عَظِيمًا ","translation":"Except for those who repent, correct themselves, hold fast to Allāh, and are sincere in their religion for Allāh, for those will be with the believers. And Allāh is going to give the believers a great reward.","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"تَابُوا۟","translit":"۟āwُbāَt","root":"توب"},{"id":4,"arabic":"وَأَصْلَحُوا۟","translit":"۟āwُḥَlْṣَaʾَw","root":"صلح"},{"id":5,"arabic":"وَٱعْتَصَمُوا۟","translit":"۟āwُmَṣَtْʿعٱَw","root":"عصم"},{"id":6,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":7,"arabic":"وَأَخْلَصُوا۟","translit":"۟āwُṣَlْhkَaʾَw","root":"خلص"},{"id":8,"arabic":"دِينَهُمْ","translit":"ْmُhَnyِd","root":"دين"},{"id":9,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":10,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":11,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":12,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":13,"arabic":"وَسَوْفَ","translit":"َfْwَsَw","root":""},{"id":14,"arabic":"يُؤْتِ","translit":"ِtْwʾُy","root":"اتي"},{"id":15,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":16,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":17,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":18,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":147,"text":"مَّا يَفْعَلُ ٱللَّهُ بِعَذَابِكُمْ إِن شَكَرْتُمْ وَءَامَنتُمْۚ وَكَانَ ٱللَّهُ شَاكِرًا عَلِيمًا ","translation":"What would Allāh do with [i.e., gain from] your punishment if you are grateful and believe? And ever is Allāh Appreciative[1] and Knowing.","words":[{"id":1,"arabic":"مَّا","translit":"āَّm","root":""},{"id":2,"arabic":"يَفْعَلُ","translit":"ُlَʿعْfَy","root":"فعل"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"بِعَذَابِكُمْ","translit":"ْmُkِbāَhdَʿعِb","root":"عذب"},{"id":5,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":6,"arabic":"شَكَرْتُمْ","translit":"ْmُtْrَkَhs","root":"شكر"},{"id":7,"arabic":"وَءَامَنتُمْ","translit":"ْmُtnَmāَءَw","root":"امن"},{"id":8,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"شَاكِرًا","translit":"āًrِkāَhs","root":"شكر"},{"id":11,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":148,"text":"لَّا يُحِبُّ ٱللَّهُ ٱلْجَهْرَ بِٱلسُّوٓءِ مِنَ ٱلْقَوْلِ إِلَّا مَن ظُلِمَۚ وَكَانَ ٱللَّهُ سَمِيعًا عَلِيمًا ","translation":"Allāh does not like the public mention of evil except by one who has been wronged. And ever is Allāh Hearing and Knowing.","words":[{"id":1,"arabic":"لَّا","translit":"āَّl","root":""},{"id":2,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"ٱلْجَهْرَ","translit":"َrْhَjgْlٱ","root":"جهر"},{"id":5,"arabic":"بِٱلسُّوٓءِ","translit":"ِءٓwُّslٱِb","root":"سوا"},{"id":6,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":7,"arabic":"ٱلْقَوْلِ","translit":"ِlْwَqْlٱ","root":"قول"},{"id":8,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":9,"arabic":"مَن","translit":"nَm","root":""},{"id":10,"arabic":"ظُلِمَ","translit":"َmِlُẓ","root":"ظلم"},{"id":11,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"سَمِيعًا","translit":"āًʿعyِmَs","root":"سمع"},{"id":14,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":149,"text":"إِن تُبْدُوا۟ خَيْرًا أَوْ تُخْفُوهُ أَوْ تَعْفُوا۟ عَن سُوٓءٍ فَإِنَّ ٱللَّهَ كَانَ عَفُوًّا قَدِيرًا ","translation":"If [instead] you show [some] good or conceal it or pardon an offense - indeed, Allāh is ever Pardoning and Competent.[1]","words":[{"id":1,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":2,"arabic":"تُبْدُوا۟","translit":"۟āwُdْbُt","root":"بدو"},{"id":3,"arabic":"خَيْرًا","translit":"āًrْyَhk","root":"خير"},{"id":4,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":5,"arabic":"تُخْفُوهُ","translit":"ُhwُfْhkُt","root":"خفي"},{"id":6,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":7,"arabic":"تَعْفُوا۟","translit":"۟āwُfْʿعَt","root":"عفو"},{"id":8,"arabic":"عَن","translit":"nَʿع","root":""},{"id":9,"arabic":"سُوٓءٍ","translit":"ٍءٓwُs","root":"سوا"},{"id":10,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":11,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":12,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":13,"arabic":"عَفُوًّا","translit":"āًّwُfَʿع","root":"عفو"},{"id":14,"arabic":"قَدِيرًا","translit":"āًryِdَq","root":"قدر"}],"hasIhya":false},{"ayah":150,"text":"إِنَّ ٱلَّذِينَ يَكْفُرُونَ بِٱللَّهِ وَرُسُلِهِۦ وَيُرِيدُونَ أَن يُفَرِّقُوا۟ بَيْنَ ٱللَّهِ وَرُسُلِهِۦ وَيَقُولُونَ نُؤْمِنُ بِبَعْضٍ وَنَكْفُرُ بِبَعْضٍ وَيُرِيدُونَ أَن يَتَّخِذُوا۟ بَيْنَ ذَٰلِكَ سَبِيلًا ","translation":"Indeed, those who disbelieve in Allāh and His messengers and wish to discriminate between Allāh and His messengers and say, \"We believe in some and disbelieve in others,\" and wish to adopt a way in between -","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يَكْفُرُونَ","translit":"َnwُrُfْkَy","root":"كفر"},{"id":4,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":5,"arabic":"وَرُسُلِهِۦ","translit":"ۦِhِlُsُrَw","root":"رسل"},{"id":6,"arabic":"وَيُرِيدُونَ","translit":"َnwُdyِrُyَw","root":"رود"},{"id":7,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":8,"arabic":"يُفَرِّقُوا۟","translit":"۟āwُqِّrَfُy","root":"فرق"},{"id":9,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"وَرُسُلِهِۦ","translit":"ۦِhِlُsُrَw","root":"رسل"},{"id":12,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":13,"arabic":"نُؤْمِنُ","translit":"ُnِmْwʾُn","root":"امن"},{"id":14,"arabic":"بِبَعْضٍ","translit":"ٍḍْʿعَbِb","root":"بعض"},{"id":15,"arabic":"وَنَكْفُرُ","translit":"ُrُfْkَnَw","root":"كفر"},{"id":16,"arabic":"بِبَعْضٍ","translit":"ٍḍْʿعَbِb","root":"بعض"},{"id":17,"arabic":"وَيُرِيدُونَ","translit":"َnwُdyِrُyَw","root":"رود"},{"id":18,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":19,"arabic":"يَتَّخِذُوا۟","translit":"۟āwُhdِhkَّtَy","root":"اخذ"},{"id":20,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":21,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":22,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":151,"text":"أُو۟لَٰٓئِكَ هُمُ ٱلْكَٰفِرُونَ حَقًّاۚ وَأَعْتَدْنَا لِلْكَٰفِرِينَ عَذَابًا مُّهِينًا ","translation":"Those are the disbelievers, truly. And We have prepared for the disbelievers a humiliating punishment.","words":[{"id":1,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":2,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":3,"arabic":"ٱلْكَٰفِرُونَ","translit":"َnwُrِfَٰkْlٱ","root":"كفر"},{"id":4,"arabic":"حَقًّا","translit":"āًّqَḥ","root":"حقق"},{"id":5,"arabic":"وَأَعْتَدْنَا","translit":"āَnْdَtْʿعَaʾَw","root":"عتد"},{"id":6,"arabic":"لِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِl","root":"كفر"},{"id":7,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":8,"arabic":"مُّهِينًا","translit":"āًnyِhُّm","root":"هون"}],"hasIhya":false},{"ayah":152,"text":"وَٱلَّذِينَ ءَامَنُوا۟ بِٱللَّهِ وَرُسُلِهِۦ وَلَمْ يُفَرِّقُوا۟ بَيْنَ أَحَدٍ مِّنْهُمْ أُو۟لَٰٓئِكَ سَوْفَ يُؤْتِيهِمْ أُجُورَهُمْۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ","translation":"But they who believe in Allāh and His messengers and do not discriminate between any of them - to those He is going to give their rewards. And ever is Allāh Forgiving and Merciful.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":3,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":4,"arabic":"وَرُسُلِهِۦ","translit":"ۦِhِlُsُrَw","root":"رسل"},{"id":5,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":6,"arabic":"يُفَرِّقُوا۟","translit":"۟āwُqِّrَfُy","root":"فرق"},{"id":7,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":8,"arabic":"أَحَدٍ","translit":"ٍdَḥَaʾ","root":"احد"},{"id":9,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":10,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":11,"arabic":"سَوْفَ","translit":"َfْwَs","root":""},{"id":12,"arabic":"يُؤْتِيهِمْ","translit":"ْmِhyِtْwʾُy","root":"اتي"},{"id":13,"arabic":"أُجُورَهُمْ","translit":"ْmُhَrwُjgُaʾ","root":"اجر"},{"id":14,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":15,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":16,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"},{"id":17,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":153,"text":"يَسْـَٔلُكَ أَهْلُ ٱلْكِتَٰبِ أَن تُنَزِّلَ عَلَيْهِمْ كِتَٰبًا مِّنَ ٱلسَّمَآءِۚ فَقَدْ سَأَلُوا۟ مُوسَىٰٓ أَكْبَرَ مِن ذَٰلِكَ فَقَالُوٓا۟ أَرِنَا ٱللَّهَ جَهْرَةً فَأَخَذَتْهُمُ ٱلصَّٰعِقَةُ بِظُلْمِهِمْۚ ثُمَّ ٱتَّخَذُوا۟ ٱلْعِجْلَ مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَٰتُ فَعَفَوْنَا عَن ذَٰلِكَۚ وَءَاتَيْنَا مُوسَىٰ سُلْطَٰنًا مُّبِينًا ","translation":"The People of the Scripture ask you to bring down to them a book from the heaven. But they had asked of Moses [even] greater than that and said, \"Show us Allāh outright,\" so the thunderbolt struck them for their wrongdoing. Then they took the calf [for worship] after clear evidences had come to them, and We pardoned that. And We gave Moses a clear authority.","words":[{"id":1,"arabic":"يَسْـَٔلُكَ","translit":"َkُlَٔـْsَy","root":"سال"},{"id":2,"arabic":"أَهْلُ","translit":"ُlْhَaʾ","root":"اهل"},{"id":3,"arabic":"ٱلْكِتَٰبِ","tra