َٰلِهِمْ وَأَنفُسِهِمْ عَلَى ٱلْقَٰعِدِينَ دَرَجَةًۚ وَكُلًّا وَعَدَ ٱللَّهُ ٱلْحُسْنَىٰۚ وَفَضَّلَ ٱللَّهُ ٱلْمُجَٰهِدِينَ عَلَى ٱلْقَٰعِدِينَ أَجْرًا عَظِيمًا ","translation":"Not equal are those believers remaining [at home] - other than the disabled - and the mujāhideen, [who strive and fight] in the cause of Allāh with their wealth and their lives. Allāh has preferred the mujāhideen through their wealth and their lives over those who remain [behind], by degrees. And to all [i.e., both] Allāh has promised the best [reward]. But Allāh has preferred the mujāhideen over those who remain [behind] with a great reward -","words":[{"id":1,"arabic":"لَّا","translit":"āَّl","root":""},{"id":2,"arabic":"يَسْتَوِى","translit":"àِwَtْsَy","root":"سوي"},{"id":3,"arabic":"ٱلْقَٰعِدُونَ","translit":"َnwُdِʿعَٰqْlٱ","root":"قعد"},{"id":4,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":5,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":6,"arabic":"غَيْرُ","translit":"ُrْyَغ","root":"غير"},{"id":7,"arabic":"أُو۟لِى","translit":"àِl۟wُaʾ","root":""},{"id":8,"arabic":"ٱلضَّرَرِ","translit":"ِrَrَّḍlٱ","root":"ضرر"},{"id":9,"arabic":"وَٱلْمُجَٰهِدُونَ","translit":"َnwُdِhَٰjgُmْlٱَw","root":"جهد"},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"بِأَمْوَٰلِهِمْ","translit":"ْmِhِlَٰwْmَaʾِb","root":"مول"},{"id":14,"arabic":"وَأَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾَw","root":"نفس"},{"id":15,"arabic":"فَضَّلَ","translit":"َlَّḍَf","root":"فضل"},{"id":16,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":17,"arabic":"ٱلْمُجَٰهِدِينَ","translit":"َnyِdِhَٰjgُmْlٱ","root":"جهد"},{"id":18,"arabic":"بِأَمْوَٰلِهِمْ","translit":"ْmِhِlَٰwْmَaʾِb","root":"مول"},{"id":19,"arabic":"وَأَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾَw","root":"نفس"},{"id":20,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":21,"arabic":"ٱلْقَٰعِدِينَ","translit":"َnyِdِʿعَٰqْlٱ","root":"قعد"},{"id":22,"arabic":"دَرَجَةً","translit":"ًẗَjgَrَd","root":"درج"},{"id":23,"arabic":"وَكُلًّا","translit":"āًّlُkَw","root":"كلل"},{"id":24,"arabic":"وَعَدَ","translit":"َdَʿعَw","root":"وعد"},{"id":25,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":26,"arabic":"ٱلْحُسْنَىٰ","translit":"ٰàَnْsُḥْlٱ","root":"حسن"},{"id":27,"arabic":"وَفَضَّلَ","translit":"َlَّḍَfَw","root":"فضل"},{"id":28,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":29,"arabic":"ٱلْمُجَٰهِدِينَ","translit":"َnyِdِhَٰjgُmْlٱ","root":"جهد"},{"id":30,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":31,"arabic":"ٱلْقَٰعِدِينَ","translit":"َnyِdِʿعَٰqْlٱ","root":"قعد"},{"id":32,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":33,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":96,"text":"دَرَجَٰتٍ مِّنْهُ وَمَغْفِرَةً وَرَحْمَةًۚ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ","translation":"Degrees [of high position] from Him and forgiveness and mercy. And Allāh is ever Forgiving and Merciful.","words":[{"id":1,"arabic":"دَرَجَٰتٍ","translit":"ٍtَٰjgَrَd","root":"درج"},{"id":2,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":3,"arabic":"وَمَغْفِرَةً","translit":"ًẗَrِfْغَmَw","root":"غفر"},{"id":4,"arabic":"وَرَحْمَةً","translit":"ًẗَmْḥَrَw","root":"رحم"},{"id":5,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"},{"id":8,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":97,"text":"إِنَّ ٱلَّذِينَ تَوَفَّىٰهُمُ ٱلْمَلَٰٓئِكَةُ ظَالِمِىٓ أَنفُسِهِمْ قَالُوا۟ فِيمَ كُنتُمْۖ قَالُوا۟ كُنَّا مُسْتَضْعَفِينَ فِى ٱلْأَرْضِۚ قَالُوٓا۟ أَلَمْ تَكُنْ أَرْضُ ٱللَّهِ وَٰسِعَةً فَتُهَاجِرُوا۟ فِيهَاۚ فَأُو۟لَٰٓئِكَ مَأْوَىٰهُمْ جَهَنَّمُۖ وَسَآءَتْ مَصِيرًا ","translation":"Indeed, those whom the angels take [in death] while wronging themselves[1] - [the angels] will say, \"In what [condition] were you?\" They will say, \"We were oppressed in the land.\" They [the angels] will say, \"Was not the earth of Allāh spacious [enough] for you to emigrate therein?\" For those, their refuge is Hell - and evil it is as a destination.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"تَوَفَّىٰهُمُ","translit":"ُmُhٰàَّfَwَt","root":"وفي"},{"id":4,"arabic":"ٱلْمَلَٰٓئِكَةُ","translit":"ُẗَkِyʾَٰٓlَmْlٱ","root":"ملك"},{"id":5,"arabic":"ظَالِمِىٓ","translit":"ٓàِmِlāَẓ","root":"ظلم"},{"id":6,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":7,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":8,"arabic":"فِيمَ","translit":"َmyِf","root":""},{"id":9,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":10,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":11,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":12,"arabic":"مُسْتَضْعَفِينَ","translit":"َnyِfَʿعْḍَtْsُm","root":"ضعف"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":15,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":16,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":17,"arabic":"تَكُنْ","translit":"ْnُkَt","root":"كون"},{"id":18,"arabic":"أَرْضُ","translit":"ُḍْrَaʾ","root":"ارض"},{"id":19,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":20,"arabic":"وَٰسِعَةً","translit":"ًẗَʿعِsَٰw","root":"وسع"},{"id":21,"arabic":"فَتُهَاجِرُوا۟","translit":"۟āwُrِjgāَhُtَf","root":"هجر"},{"id":22,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":23,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":24,"arabic":"مَأْوَىٰهُمْ","translit":"ْmُhٰàَwْaʾَm","root":"اوي"},{"id":25,"arabic":"جَهَنَّمُ","translit":"ُmَّnَhَjg","root":""},{"id":26,"arabic":"وَسَآءَتْ","translit":"ْtَءٓāَsَw","root":"سوا"},{"id":27,"arabic":"مَصِيرًا","translit":"āًryِṣَm","root":"صير"}],"hasIhya":true},{"ayah":98,"text":"إِلَّا ٱلْمُسْتَضْعَفِينَ مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ وَٱلْوِلْدَٰنِ لَا يَسْتَطِيعُونَ حِيلَةً وَلَا يَهْتَدُونَ سَبِيلًا ","translation":"Except for the oppressed among men, women and children who cannot devise a plan nor are they directed to a way[1] -","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"ٱلْمُسْتَضْعَفِينَ","translit":"َnyِfَʿعْḍَtْsُmْlٱ","root":"ضعف"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلرِّجَالِ","translit":"ِlāَjgِّrlٱ","root":"رجل"},{"id":5,"arabic":"وَٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱَw","root":"نسو"},{"id":6,"arabic":"وَٱلْوِلْدَٰنِ","translit":"ِnَٰdْlِwْlٱَw","root":"ولد"},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"يَسْتَطِيعُونَ","translit":"َnwُʿعyِṭَtْsَy","root":"طوع"},{"id":9,"arabic":"حِيلَةً","translit":"ًẗَlyِḥ","root":"حول"},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"يَهْتَدُونَ","translit":"َnwُdَtْhَy","root":"هدي"},{"id":12,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":99,"text":"فَأُو۟لَٰٓئِكَ عَسَى ٱللَّهُ أَن يَعْفُوَ عَنْهُمْۚ وَكَانَ ٱللَّهُ عَفُوًّا غَفُورًا ","translation":"For those it is expected that Allāh will pardon them, and Allāh is ever Pardoning[1] and Forgiving.","words":[{"id":1,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":2,"arabic":"عَسَى","translit":"àَsَʿع","root":"عسي"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَعْفُوَ","translit":"َwُfْʿعَy","root":"عفو"},{"id":6,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":7,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"عَفُوًّا","translit":"āًّwُfَʿع","root":"عفو"},{"id":10,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"}],"hasIhya":false},{"ayah":100,"text":"وَمَن يُهَاجِرْ فِى سَبِيلِ ٱللَّهِ يَجِدْ فِى ٱلْأَرْضِ مُرَٰغَمًا كَثِيرًا وَسَعَةًۚ وَمَن يَخْرُجْ مِنۢ بَيْتِهِۦ مُهَاجِرًا إِلَى ٱللَّهِ وَرَسُولِهِۦ ثُمَّ يُدْرِكْهُ ٱلْمَوْتُ فَقَدْ وَقَعَ أَجْرُهُۥ عَلَى ٱللَّهِۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ","translation":"And whoever emigrates for the cause of Allāh will find on the earth many [alternative] locations and abundance. And whoever leaves his home as an emigrant to Allāh and His Messenger and then death overtakes him - his reward has already become incumbent upon Allāh. And Allāh is ever Forgiving and Merciful.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يُهَاجِرْ","translit":"ْrِjgāَhُy","root":"هجر"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"يَجِدْ","translit":"ْdِjgَy","root":"وجد"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":9,"arabic":"مُرَٰغَمًا","translit":"āًmَغَٰrُm","root":"رغم"},{"id":10,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":11,"arabic":"وَسَعَةً","translit":"ًẗَʿعَsَw","root":"وسع"},{"id":12,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":13,"arabic":"يَخْرُجْ","translit":"ْjgُrْhkَy","root":"خرج"},{"id":14,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":15,"arabic":"بَيْتِهِۦ","translit":"ۦِhِtْyَb","root":"بيت"},{"id":16,"arabic":"مُهَاجِرًا","translit":"āًrِjgāَhُm","root":"هجر"},{"id":17,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":18,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":19,"arabic":"وَرَسُولِهِۦ","translit":"ۦِhِlwُsَrَw","root":"رسل"},{"id":20,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":21,"arabic":"يُدْرِكْهُ","translit":"ُhْkِrْdُy","root":"درك"},{"id":22,"arabic":"ٱلْمَوْتُ","translit":"ُtْwَmْlٱ","root":"موت"},{"id":23,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":24,"arabic":"وَقَعَ","translit":"َʿعَqَw","root":"وقع"},{"id":25,"arabic":"أَجْرُهُۥ","translit":"ۥُhُrْjgَaʾ","root":"اجر"},{"id":26,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":27,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":28,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":29,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":30,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"},{"id":31,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":101,"text":"وَإِذَا ضَرَبْتُمْ فِى ٱلْأَرْضِ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَقْصُرُوا۟ مِنَ ٱلصَّلَوٰةِ إِنْ خِفْتُمْ أَن يَفْتِنَكُمُ ٱلَّذِينَ كَفَرُوٓا۟ۚ إِنَّ ٱلْكَٰفِرِينَ كَانُوا۟ لَكُمْ عَدُوًّا مُّبِينًا ","translation":"And when you travel throughout the land, there is no blame upon you for shortening the prayer,[1] [especially] if you fear that those who disbelieve may disrupt [or attack] you.[2] Indeed, the disbelievers are ever to you a clear enemy.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"ضَرَبْتُمْ","translit":"ْmُtْbَrَḍ","root":"ضرب"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"فَلَيْسَ","translit":"َsْyَlَf","root":"ليس"},{"id":6,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":7,"arabic":"جُنَاحٌ","translit":"ٌḥāَnُjg","root":"جنح"},{"id":8,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":9,"arabic":"تَقْصُرُوا۟","translit":"۟āwُrُṣْqَt","root":"قصر"},{"id":10,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":11,"arabic":"ٱلصَّلَوٰةِ","translit":"ِẗٰwَlَّṣlٱ","root":"صلو"},{"id":12,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":13,"arabic":"خِفْتُمْ","translit":"ْmُtْfِhk","root":"خوف"},{"id":14,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":15,"arabic":"يَفْتِنَكُمُ","translit":"ُmُkَnِtْfَy","root":"فتن"},{"id":16,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":17,"arabic":"كَفَرُوٓا۟","translit":"۟āٓwُrَfَk","root":"كفر"},{"id":18,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":19,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"},{"id":20,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":21,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":22,"arabic":"عَدُوًّا","translit":"āًّwُdَʿع","root":"عدو"},{"id":23,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":102,"text":"وَإِذَا كُنتَ فِيهِمْ فَأَقَمْتَ لَهُمُ ٱلصَّلَوٰةَ فَلْتَقُمْ طَآئِفَةٌ مِّنْهُم مَّعَكَ وَلْيَأْخُذُوٓا۟ أَسْلِحَتَهُمْ فَإِذَا سَجَدُوا۟ فَلْيَكُونُوا۟ مِن وَرَآئِكُمْ وَلْتَأْتِ طَآئِفَةٌ أُخْرَىٰ لَمْ يُصَلُّوا۟ فَلْيُصَلُّوا۟ مَعَكَ وَلْيَأْخُذُوا۟ حِذْرَهُمْ وَأَسْلِحَتَهُمْۗ وَدَّ ٱلَّذِينَ كَفَرُوا۟ لَوْ تَغْفُلُونَ عَنْ أَسْلِحَتِكُمْ وَأَمْتِعَتِكُمْ فَيَمِيلُونَ عَلَيْكُم مَّيْلَةً وَٰحِدَةًۚ وَلَا جُنَاحَ عَلَيْكُمْ إِن كَانَ بِكُمْ أَذًى مِّن مَّطَرٍ أَوْ كُنتُم مَّرْضَىٰٓ أَن تَضَعُوٓا۟ أَسْلِحَتَكُمْۖ وَخُذُوا۟ حِذْرَكُمْۗ إِنَّ ٱللَّهَ أَعَدَّ لِلْكَٰفِرِينَ عَذَابًا مُّهِينًا ","translation":"And when you [i.e., the commander of an army] are among them and lead them in prayer,[1] let a group of them stand [in prayer] with you and let them carry their arms. And when they have prostrated, let them be [in position] behind you and have the other group come forward which has not [yet] prayed and let them pray with you, taking precaution and carrying their arms. Those who disbelieve wish that you would neglect your weapons and your baggage so they could come down upon you in one [single] attack. But there is no blame upon you, if you are troubled by rain or are ill, for putting down your arms, but take precaution. Indeed, Allāh has prepared for the disbelievers a humiliating punishment.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"كُنتَ","translit":"َtnُk","root":"كون"},{"id":3,"arabic":"فِيهِمْ","translit":"ْmِhyِf","root":""},{"id":4,"arabic":"فَأَقَمْتَ","translit":"َtْmَqَaʾَf","root":"قوم"},{"id":5,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":6,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":7,"arabic":"فَلْتَقُمْ","translit":"ْmُqَtْlَf","root":"قوم"},{"id":8,"arabic":"طَآئِفَةٌ","translit":"ٌẗَfِyʾٓāَṭ","root":"طوف"},{"id":9,"arabic":"مِّنْهُم","translit":"mُhْnِّm","root":""},{"id":10,"arabic":"مَّعَكَ","translit":"َkَʿعَّm","root":""},{"id":11,"arabic":"وَلْيَأْخُذُوٓا۟","translit":"۟āٓwُhdُhkْaʾَyْlَw","root":"اخذ"},{"id":12,"arabic":"أَسْلِحَتَهُمْ","translit":"ْmُhَtَḥِlْsَaʾ","root":"سلح"},{"id":13,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":14,"arabic":"سَجَدُوا۟","translit":"۟āwُdَjgَs","root":"سجد"},{"id":15,"arabic":"فَلْيَكُونُوا۟","translit":"۟āwُnwُkَyْlَf","root":"كون"},{"id":16,"arabic":"مِن","translit":"nِm","root":""},{"id":17,"arabic":"وَرَآئِكُمْ","translit":"ْmُkِyʾٓāَrَw","root":"وري"},{"id":18,"arabic":"وَلْتَأْتِ","translit":"ِtْaʾَtْlَw","root":"اتي"},{"id":19,"arabic":"طَآئِفَةٌ","translit":"ٌẗَfِyʾٓāَṭ","root":"طوف"},{"id":20,"arabic":"أُخْرَىٰ","translit":"ٰàَrْhkُaʾ","root":"اخر"},{"id":21,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":22,"arabic":"يُصَلُّوا۟","translit":"۟āwُّlَṣُy","root":"صلو"},{"id":23,"arabic":"فَلْيُصَلُّوا۟","translit":"۟āwُّlَṣُyْlَf","root":"صلو"},{"id":24,"arabic":"مَعَكَ","translit":"َkَʿعَm","root":""},{"id":25,"arabic":"وَلْيَأْخُذُوا۟","translit":"۟āwُhdُhkْaʾَyْlَw","root":"اخذ"},{"id":26,"arabic":"حِذْرَهُمْ","translit":"ْmُhَrْhdِḥ","root":"حذر"},{"id":27,"arabic":"وَأَسْلِحَتَهُمْ","translit":"ْmُhَtَḥِlْsَaʾَw","root":"سلح"},{"id":28,"arabic":"وَدَّ","translit":"َّdَw","root":"ودد"},{"id":29,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":30,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":31,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":32,"arabic":"تَغْفُلُونَ","translit":"َnwُlُfْغَt","root":"غفل"},{"id":33,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":34,"arabic":"أَسْلِحَتِكُمْ","translit":"ْmُkِtَḥِlْsَaʾ","root":"سلح"},{"id":35,"arabic":"وَأَمْتِعَتِكُمْ","translit":"ْmُkِtَʿعِtْmَaʾَw","root":"متع"},{"id":36,"arabic":"فَيَمِيلُونَ","translit":"َnwُlyِmَyَf","root":"ميل"},{"id":37,"arabic":"عَلَيْكُم","translit":"mُkْyَlَʿع","root":""},{"id":38,"arabic":"مَّيْلَةً","translit":"ًẗَlْyَّm","root":"ميل"},{"id":39,"arabic":"وَٰحِدَةً","translit":"ًẗَdِḥَٰw","root":"وحد"},{"id":40,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":41,"arabic":"جُنَاحَ","translit":"َḥāَnُjg","root":"جنح"},{"id":42,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":43,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":44,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":45,"arabic":"بِكُمْ","translit":"ْmُkِb","root":""},{"id":46,"arabic":"أَذًى","translit":"àًhdَaʾ","root":"اذي"},{"id":47,"arabic":"مِّن","translit":"nِّm","root":""},{"id":48,"arabic":"مَّطَرٍ","translit":"ٍrَṭَّm","root":"مطر"},{"id":49,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":50,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":51,"arabic":"مَّرْضَىٰٓ","translit":"ٰٓàَḍْrَّm","root":"مرض"},{"id":52,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":53,"arabic":"تَضَعُوٓا۟","translit":"۟āٓwُʿعَḍَt","root":"وضع"},{"id":54,"arabic":"أَسْلِحَتَكُمْ","translit":"ْmُkَtَḥِlْsَaʾ","root":"سلح"},{"id":55,"arabic":"وَخُذُوا۟","translit":"۟āwُhdُhkَw","root":"اخذ"},{"id":56,"arabic":"حِذْرَكُمْ","translit":"ْmُkَrْhdِḥ","root":"حذر"},{"id":57,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":58,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":59,"arabic":"أَعَدَّ","translit":"َّdَʿعَaʾ","root":"عدد"},{"id":60,"arabic":"لِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِl","root":"كفر"},{"id":61,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":62,"arabic":"مُّهِينًا","translit":"āًnyِhُّm","root":"هون"}],"hasIhya":false},{"ayah":103,"text":"فَإِذَا قَضَيْتُمُ ٱلصَّلَوٰةَ فَٱذْكُرُوا۟ ٱللَّهَ قِيَٰمًا وَقُعُودًا وَعَلَىٰ جُنُوبِكُمْۚ فَإِذَا ٱطْمَأْنَنتُمْ فَأَقِيمُوا۟ ٱلصَّلَوٰةَۚ إِنَّ ٱلصَّلَوٰةَ كَانَتْ عَلَى ٱلْمُؤْمِنِينَ كِتَٰبًا مَّوْقُوتًا ","translation":"And when you have completed the prayer, remember Allāh standing, sitting, or [lying] on your sides. But when you become secure, re-establish [regular] prayer. Indeed, prayer has been decreed upon the believers a decree of specified times.","words":[{"id":1,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":2,"arabic":"قَضَيْتُمُ","translit":"ُmُtْyَḍَq","root":"قضي"},{"id":3,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":4,"arabic":"فَٱذْكُرُوا۟","translit":"۟āwُrُkْhdٱَf","root":"ذكر"},{"id":5,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":6,"arabic":"قِيَٰمًا","translit":"āًmَٰyِq","root":"قوم"},{"id":7,"arabic":"وَقُعُودًا","translit":"āًdwُʿعُqَw","root":"قعد"},{"id":8,"arabic":"وَعَلَىٰ","translit":"ٰàَlَʿعَw","root":""},{"id":9,"arabic":"جُنُوبِكُمْ","translit":"ْmُkِbwُnُjg","root":"جنب"},{"id":10,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":11,"arabic":"ٱطْمَأْنَنتُمْ","translit":"ْmُtnَnْaʾَmْṭٱ","root":"طمان"},{"id":12,"arabic":"فَأَقِيمُوا۟","translit":"۟āwُmyِqَaʾَf","root":"قوم"},{"id":13,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":14,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":15,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":16,"arabic":"كَانَتْ","translit":"ْtَnāَk","root":"كون"},{"id":17,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":18,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":19,"arabic":"كِتَٰبًا","translit":"āًbَٰtِk","root":"كتب"},{"id":20,"arabic":"مَّوْقُوتًا","translit":"āًtwُqْwَّm","root":"وقت"}],"hasIhya":true},{"ayah":104,"text":"وَلَا تَهِنُوا۟ فِى ٱبْتِغَآءِ ٱلْقَوْمِۖ إِن تَكُونُوا۟ تَأْلَمُونَ فَإِنَّهُمْ يَأْلَمُونَ كَمَا تَأْلَمُونَۖ وَتَرْجُونَ مِنَ ٱللَّهِ مَا لَا يَرْجُونَۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ","translation":"And do not weaken in pursuit of the enemy. If you should be suffering - so are they suffering as you are suffering, but you expect from Allāh that which they expect not. And Allāh is ever Knowing and Wise.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَهِنُوا۟","translit":"۟āwُnِhَt","root":"وهن"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱبْتِغَآءِ","translit":"ِءٓāَغِtْbٱ","root":"بغي"},{"id":5,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":6,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":7,"arabic":"تَكُونُوا۟","translit":"۟āwُnwُkَt","root":"كون"},{"id":8,"arabic":"تَأْلَمُونَ","translit":"َnwُmَlْaʾَt","root":"الم"},{"id":9,"arabic":"فَإِنَّهُمْ","translit":"ْmُhَّnِiʾَf","root":""},{"id":10,"arabic":"يَأْلَمُونَ","translit":"َnwُmَlْaʾَy","root":"الم"},{"id":11,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":12,"arabic":"تَأْلَمُونَ","translit":"َnwُmَlْaʾَt","root":"الم"},{"id":13,"arabic":"وَتَرْجُونَ","translit":"َnwُjgْrَtَw","root":"رجو"},{"id":14,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":15,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":16,"arabic":"مَا","translit":"āَm","root":""},{"id":17,"arabic":"لَا","translit":"āَl","root":""},{"id":18,"arabic":"يَرْجُونَ","translit":"َnwُjgْrَy","root":"رجو"},{"id":19,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"},{"id":22,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":true},{"ayah":105,"text":"إِنَّآ أَنزَلْنَآ إِلَيْكَ ٱلْكِتَٰبَ بِٱلْحَقِّ لِتَحْكُمَ بَيْنَ ٱلنَّاسِ بِمَآ أَرَىٰكَ ٱللَّهُۚ وَلَا تَكُن لِّلْخَآئِنِينَ خَصِيمًا ","translation":"Indeed, We have revealed to you, [O Muḥammad], the Book in truth so you may judge between the people by that which Allāh has shown you. And do not be for the deceitful an advocate.","words":[{"id":1,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":2,"arabic":"أَنزَلْنَآ","translit":"ٓāَnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":4,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":6,"arabic":"لِتَحْكُمَ","translit":"َmُkْḥَtِl","root":"حكم"},{"id":7,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":8,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":9,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":10,"arabic":"أَرَىٰكَ","translit":"َkٰàَrَaʾ","root":"راي"},{"id":11,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":12,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":13,"arabic":"تَكُن","translit":"nُkَt","root":"كون"},{"id":14,"arabic":"لِّلْخَآئِنِينَ","translit":"َnyِnِyʾٓāَhkْlِّl","root":"خون"},{"id":15,"arabic":"خَصِيمًا","translit":"āًmyِṣَhk","root":"خصم"}],"hasIhya":false},{"ayah":106,"text":"وَٱسْتَغْفِرِ ٱللَّهَۖ إِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا ","translation":"And seek forgiveness of Allāh. Indeed, Allāh is ever Forgiving and Merciful.","words":[{"id":1,"arabic":"وَٱسْتَغْفِرِ","translit":"ِrِfْغَtْsٱَw","root":"غفر"},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":4,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":5,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":6,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"},{"id":7,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":107,"text":"وَلَا تُجَٰدِلْ عَنِ ٱلَّذِينَ يَخْتَانُونَ أَنفُسَهُمْۚ إِنَّ ٱللَّهَ لَا يُحِبُّ مَن كَانَ خَوَّانًا أَثِيمًا ","translation":"And do not argue on behalf of those who deceive themselves. Indeed, Allāh loves not one who is a habitually sinful deceiver.","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تُجَٰدِلْ","translit":"ْlِdَٰjgُt","root":"جدل"},{"id":3,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"يَخْتَانُونَ","translit":"َnwُnāَtْhkَy","root":"خون"},{"id":6,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":7,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"لَا","translit":"āَl","root":""},{"id":10,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":11,"arabic":"مَن","translit":"nَm","root":""},{"id":12,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":13,"arabic":"خَوَّانًا","translit":"āًnāَّwَhk","root":"خون"},{"id":14,"arabic":"أَثِيمًا","translit":"āًmyِhtَaʾ","root":"اثم"}],"hasIhya":true},{"ayah":108,"text":"يَسْتَخْفُونَ مِنَ ٱلنَّاسِ وَلَا يَسْتَخْفُونَ مِنَ ٱللَّهِ وَهُوَ مَعَهُمْ إِذْ يُبَيِّتُونَ مَا لَا يَرْضَىٰ مِنَ ٱلْقَوْلِۚ وَكَانَ ٱللَّهُ بِمَا يَعْمَلُونَ مُحِيطًا ","translation":"They conceal [their evil intentions and deeds] from the people, but they cannot conceal [them] from Allāh, and He is with them [in His knowledge] when they spend the night in such as He does not accept of speech. And ever is Allāh, of what they do, encompassing.","words":[{"id":1,"arabic":"يَسْتَخْفُونَ","translit":"َnwُfْhkَtْsَy","root":"خفي"},{"id":2,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":3,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":4,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":5,"arabic":"يَسْتَخْفُونَ","translit":"َnwُfْhkَtْsَy","root":"خفي"},{"id":6,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":9,"arabic":"مَعَهُمْ","translit":"ْmُhَʿعَm","root":""},{"id":10,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":11,"arabic":"يُبَيِّتُونَ","translit":"َnwُtِّyَbُy","root":"بيت"},{"id":12,"arabic":"مَا","translit":"āَm","root":""},{"id":13,"arabic":"لَا","translit":"āَl","root":""},{"id":14,"arabic":"يَرْضَىٰ","translit":"ٰàَḍْrَy","root":"رضو"},{"id":15,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":16,"arabic":"ٱلْقَوْلِ","translit":"ِlْwَqْlٱ","root":"قول"},{"id":17,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":18,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":19,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":20,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"},{"id":21,"arabic":"مُحِيطًا","translit":"āًṭyِḥُm","root":"حوط"}],"hasIhya":false},{"ayah":109,"text":"هَٰٓأَنتُمْ هَٰٓؤُلَآءِ جَٰدَلْتُمْ عَنْهُمْ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا فَمَن يُجَٰدِلُ ٱللَّهَ عَنْهُمْ يَوْمَ ٱلْقِيَٰمَةِ أَم مَّن يَكُونُ عَلَيْهِمْ وَكِيلًا ","translation":"Here you are - those who argue on their behalf in [this] worldly life - but who will argue with Allāh for them on the Day of Resurrection, or who will [then] be their representative?","words":[{"id":1,"arabic":"هَٰٓأَنتُمْ","translit":"ْmُtnَaʾَٰٓh","root":""},{"id":2,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":3,"arabic":"جَٰدَلْتُمْ","translit":"ْmُtْlَdَٰjg","root":"جدل"},{"id":4,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":7,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":8,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":9,"arabic":"يُجَٰدِلُ","translit":"ُlِdَٰjgُy","root":"جدل"},{"id":10,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":11,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":12,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":13,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":14,"arabic":"أَم","translit":"mَaʾ","root":""},{"id":15,"arabic":"مَّن","translit":"nَّm","root":""},{"id":16,"arabic":"يَكُونُ","translit":"ُnwُkَy","root":"كون"},{"id":17,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":18,"arabic":"وَكِيلًا","translit":"āًlyِkَw","root":"وكل"}],"hasIhya":false},{"ayah":110,"text":"وَمَن يَعْمَلْ سُوٓءًا أَوْ يَظْلِمْ نَفْسَهُۥ ثُمَّ يَسْتَغْفِرِ ٱللَّهَ يَجِدِ ٱللَّهَ غَفُورًا رَّحِيمًا ","translation":"And whoever does a wrong or wrongs himself but then seeks forgiveness of Allāh will find Allāh Forgiving and Merciful.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَعْمَلْ","translit":"ْlَmْʿعَy","root":"عمل"},{"id":3,"arabic":"سُوٓءًا","translit":"āًءٓwُs","root":"سوا"},{"id":4,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":5,"arabic":"يَظْلِمْ","translit":"ْmِlْẓَy","root":"ظلم"},{"id":6,"arabic":"نَفْسَهُۥ","translit":"ۥُhَsْfَn","root":"نفس"},{"id":7,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":8,"arabic":"يَسْتَغْفِرِ","translit":"ِrِfْغَtْsَy","root":"غفر"},{"id":9,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":10,"arabic":"يَجِدِ","translit":"ِdِjgَy","root":"وجد"},{"id":11,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":12,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"},{"id":13,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":111,"text":"وَمَن يَكْسِبْ إِثْمًا فَإِنَّمَا يَكْسِبُهُۥ عَلَىٰ نَفْسِهِۦۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ","translation":"And whoever earns [i.e., commits] a sin only earns it against himself. And Allāh is ever Knowing and Wise.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَكْسِبْ","translit":"ْbِsْkَy","root":"كسب"},{"id":3,"arabic":"إِثْمًا","translit":"āًmْhtِiʾ","root":"اثم"},{"id":4,"arabic":"فَإِنَّمَا","translit":"āَmَّnِiʾَf","root":""},{"id":5,"arabic":"يَكْسِبُهُۥ","translit":"ۥُhُbِsْkَy","root":"كسب"},{"id":6,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":7,"arabic":"نَفْسِهِۦ","translit":"ۦِhِsْfَn","root":"نفس"},{"id":8,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"},{"id":11,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":112,"text":"وَمَن يَكْسِبْ خَطِيٓـَٔةً أَوْ إِثْمًا ثُمَّ يَرْمِ بِهِۦ بَرِيٓـًٔا فَقَدِ ٱحْتَمَلَ بُهْتَٰنًا وَإِثْمًا مُّبِينًا ","translation":"But whoever earns an offense or a sin and then blames it on an innocent [person] has taken upon himself a slander and manifest sin.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَكْسِبْ","translit":"ْbِsْkَy","root":"كسب"},{"id":3,"arabic":"خَطِيٓـَٔةً","translit":"ًẗَٔـٓyِṭَhk","root":"خطا"},{"id":4,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":5,"arabic":"إِثْمًا","translit":"āًmْhtِiʾ","root":"اثم"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"يَرْمِ","translit":"ِmْrَy","root":"رمي"},{"id":8,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":9,"arabic":"بَرِيٓـًٔا","translit":"āًٔـٓyِrَb","root":"برا"},{"id":10,"arabic":"فَقَدِ","translit":"ِdَqَf","root":""},{"id":11,"arabic":"ٱحْتَمَلَ","translit":"َlَmَtْḥٱ","root":"حمل"},{"id":12,"arabic":"بُهْتَٰنًا","translit":"āًnَٰtْhُb","root":"بهت"},{"id":13,"arabic":"وَإِثْمًا","translit":"āًmْhtِiʾَw","root":"اثم"},{"id":14,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":113,"text":"وَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكَ وَرَحْمَتُهُۥ لَهَمَّت طَّآئِفَةٌ مِّنْهُمْ أَن يُضِلُّوكَ وَمَا يُضِلُّونَ إِلَّآ أَنفُسَهُمْۖ وَمَا يَضُرُّونَكَ مِن شَىْءٍۚ وَأَنزَلَ ٱللَّهُ عَلَيْكَ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ وَعَلَّمَكَ مَا لَمْ تَكُن تَعْلَمُۚ وَكَانَ فَضْلُ ٱللَّهِ عَلَيْكَ عَظِيمًا ","translation":"And if it was not for the favor of Allāh upon you, [O Muḥammad], and His mercy, a group of them would have determined to mislead you. But they do not mislead except themselves, and they will not harm you at all. And Allāh has revealed to you the Book and wisdom and has taught you that which you did not know. And ever has the favor of Allāh upon you been great.","words":[{"id":1,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":2,"arabic":"فَضْلُ","translit":"ُlْḍَf","root":"فضل"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":5,"arabic":"وَرَحْمَتُهُۥ","translit":"ۥُhُtَmْḥَrَw","root":"رحم"},{"id":6,"arabic":"لَهَمَّت","translit":"tَّmَhَl","root":"همم"},{"id":7,"arabic":"طَّآئِفَةٌ","translit":"ٌẗَfِyʾٓāَّṭ","root":"طوف"},{"id":8,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":9,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":10,"arabic":"يُضِلُّوكَ","translit":"َkwُّlِḍُy","root":"ضلل"},{"id":11,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":12,"arabic":"يُضِلُّونَ","translit":"َnwُّlِḍُy","root":"ضلل"},{"id":13,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":14,"arabic":"أَنفُسَهُمْ","translit":"ْmُhَsُfnَaʾ","root":"نفس"},{"id":15,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":16,"arabic":"يَضُرُّونَكَ","translit":"َkَnwُّrُḍَy","root":"ضرر"},{"id":17,"arabic":"مِن","translit":"nِm","root":""},{"id":18,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":19,"arabic":"وَأَنزَلَ","translit":"َlَznَaʾَw","root":"نزل"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":22,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":23,"arabic":"وَٱلْحِكْمَةَ","translit":"َẗَmْkِḥْlٱَw","root":"حكم"},{"id":24,"arabic":"وَعَلَّمَكَ","translit":"َkَmَّlَʿعَw","root":"علم"},{"id":25,"arabic":"مَا","translit":"āَm","root":""},{"id":26,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":27,"arabic":"تَكُن","translit":"nُkَt","root":"كون"},{"id":28,"arabic":"تَعْلَمُ","translit":"ُmَlْʿعَt","root":"علم"},{"id":29,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":30,"arabic":"فَضْلُ","translit":"ُlْḍَf","root":"فضل"},{"id":31,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":32,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":33,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":114,"text":"لَّا خَيْرَ فِى كَثِيرٍ مِّن نَّجْوَىٰهُمْ إِلَّا مَنْ أَمَرَ بِصَدَقَةٍ أَوْ مَعْرُوفٍ أَوْ إِصْلَٰحٍۭ بَيْنَ ٱلنَّاسِۚ وَمَن يَفْعَلْ ذَٰلِكَ ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِ فَسَوْفَ نُؤْتِيهِ أَجْرًا عَظِيمًا ","translation":"No good is there in much of their private conversation, except for those who enjoin charity or that which is right or conciliation between people. And whoever does that seeking means to the approval of Allāh - then We are going to give him a great reward.","words":[{"id":1,"arabic":"لَّا","translit":"āَّl","root":""},{"id":2,"arabic":"خَيْرَ","translit":"َrْyَhk","root":"خير"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"كَثِيرٍ","translit":"ٍryِhtَk","root":"كثر"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"نَّجْوَىٰهُمْ","translit":"ْmُhٰàَwْjgَّn","root":"نجو"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":9,"arabic":"أَمَرَ","translit":"َrَmَaʾ","root":"امر"},{"id":10,"arabic":"بِصَدَقَةٍ","translit":"ٍẗَqَdَṣِb","root":"صدق"},{"id":11,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":12,"arabic":"مَعْرُوفٍ","translit":"ٍfwُrْʿعَm","root":"عرف"},{"id":13,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":14,"arabic":"إِصْلَٰحٍۭ","translit":"ٍۭḥَٰlْṣِiʾ","root":"صلح"},{"id":15,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":16,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":17,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":18,"arabic":"يَفْعَلْ","translit":"ْlَʿعْfَy","root":"فعل"},{"id":19,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":20,"arabic":"ٱبْتِغَآءَ","translit":"َءٓāَغِtْbٱ","root":"بغي"},{"id":21,"arabic":"مَرْضَاتِ","translit":"ِtāَḍْrَm","root":"رضو"},{"id":22,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":23,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":24,"arabic":"نُؤْتِيهِ","translit":"ِhyِtْwʾُn","root":"اتي"},{"id":25,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":26,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":115,"text":"وَمَن يُشَاقِقِ ٱلرَّسُولَ مِنۢ بَعْدِ مَا تَبَيَّنَ لَهُ ٱلْهُدَىٰ وَيَتَّبِعْ غَيْرَ سَبِيلِ ٱلْمُؤْمِنِينَ نُوَلِّهِۦ مَا تَوَلَّىٰ وَنُصْلِهِۦ جَهَنَّمَۖ وَسَآءَتْ مَصِيرًا ","translation":"And whoever opposes the Messenger after guidance has become clear to him and follows other than the way of the believers - We will give him what he has taken[1] and drive him into Hell, and evil it is as a destination.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يُشَاقِقِ","translit":"ِqِqāَhsُy","root":"شقق"},{"id":3,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"تَبَيَّنَ","translit":"َnَّyَbَt","root":"بين"},{"id":8,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":9,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":10,"arabic":"وَيَتَّبِعْ","translit":"ْʿعِbَّtَyَw","root":"تبع"},{"id":11,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":12,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":13,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":14,"arabic":"نُوَلِّهِۦ","translit":"ۦِhِّlَwُn","root":"ولي"},{"id":15,"arabic":"مَا","translit":"āَm","root":""},{"id":16,"arabic":"تَوَلَّىٰ","translit":"ٰàَّlَwَt","root":"ولي"},{"id":17,"arabic":"وَنُصْلِهِۦ","translit":"ۦِhِlْṣُnَw","root":"صلي"},{"id":18,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":19,"arabic":"وَسَآءَتْ","translit":"ْtَءٓāَsَw","root":"سوا"},{"id":20,"arabic":"مَصِيرًا","translit":"āًryِṣَm","root":"صير"}],"hasIhya":false},{"ayah":116,"text":"إِنَّ ٱللَّهَ لَا يَغْفِرُ أَن يُشْرَكَ بِهِۦ وَيَغْفِرُ مَا دُونَ ذَٰلِكَ لِمَن يَشَآءُۚ وَمَن يُشْرِكْ بِٱللَّهِ فَقَدْ ضَلَّ ضَلَٰلًۢا بَعِيدًا ","translation":"Indeed, Allāh does not forgive association with Him, but He forgives what is less than that for whom He wills. And he who associates others with Allāh has certainly gone far astray.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"يَغْفِرُ","translit":"ُrِfْغَy","root":"غفر"},{"id":5,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":6,"arabic":"يُشْرَكَ","translit":"َkَrْhsُy","root":"شرك"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"وَيَغْفِرُ","translit":"ُrِfْغَyَw","root":"غفر"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"دُونَ","translit":"َnwُd","root":"دون"},{"id":11,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":12,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":13,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":14,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":15,"arabic":"يُشْرِكْ","translit":"ْkِrْhsُy","root":"شرك"},{"id":16,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":17,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":18,"arabic":"ضَلَّ","translit":"َّlَḍ","root":"ضلل"},{"id":19,"arabic":"ضَلَٰلًۢا","translit":"āًۢlَٰlَḍ","root":"ضلل"},{"id":20,"arabic":"بَعِيدًا","translit":"āًdyِʿعَb","root":"بعد"}],"hasIhya":true},{"ayah":117,"text":"إِن يَدْعُونَ مِن دُونِهِۦٓ إِلَّآ إِنَٰثًا وَإِن يَدْعُونَ إِلَّا شَيْطَٰنًا مَّرِيدًا ","translation":"They call upon instead of Him none but female [deities], and they [actually] call upon none but a rebellious Satan,","words":[{"id":1,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":2,"arabic":"يَدْعُونَ","translit":"َnwُʿعْdَy","root":"دعو"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"دُونِهِۦٓ","translit":"ٓۦِhِnwُd","root":"دون"},{"id":5,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":6,"arabic":"إِنَٰثًا","translit":"āًhtَٰnِiʾ","root":"انث"},{"id":7,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":8,"arabic":"يَدْعُونَ","translit":"َnwُʿعْdَy","root":"دعو"},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"شَيْطَٰنًا","translit":"āًnَٰṭْyَhs","root":"شطن"},{"id":11,"arabic":"مَّرِيدًا","translit":"āًdyِrَّm","root":"مرد"}],"hasIhya":false},{"ayah":118,"text":"لَّعَنَهُ ٱللَّهُۘ وَقَالَ لَأَتَّخِذَنَّ مِنْ عِبَادِكَ نَصِيبًا مَّفْرُوضًا ","translation":"Whom Allāh has cursed. For he had said, \"I will surely take from among Your servants a specific portion.","words":[{"id":1,"arabic":"لَّعَنَهُ","translit":"ُhَnَʿعَّl","root":"لعن"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":4,"arabic":"لَأَتَّخِذَنَّ","translit":"َّnَhdِhkَّtَaʾَl","root":"اخذ"},{"id":5,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":6,"arabic":"عِبَادِكَ","translit":"َkِdāَbِʿع","root":"عبد"},{"id":7,"arabic":"نَصِيبًا","translit":"āًbyِṣَn","root":"نصب"},{"id":8,"arabic":"مَّفْرُوضًا","translit":"āًḍwُrْfَّm","root":"فرض"}],"hasIhya":false},{"ayah":119,"text":"وَلَأُضِلَّنَّهُمْ وَلَأُمَنِّيَنَّهُمْ وَلَءَامُرَنَّهُمْ فَلَيُبَتِّكُنَّ ءَاذَانَ ٱلْأَنْعَٰمِ وَلَءَامُرَنَّهُمْ فَلَيُغَيِّرُنَّ خَلْقَ ٱللَّهِۚ وَمَن يَتَّخِذِ ٱلشَّيْطَٰنَ وَلِيًّا مِّن دُونِ ٱللَّهِ فَقَدْ خَسِرَ خُسْرَانًا مُّبِينًا ","translation":"And I will mislead them, and I will arouse in them [sinful] desires, and I will command them so they will slit the ears of cattle, and I will command them so they will change the creation of Allāh.\" And whoever takes Satan as an ally instead of Allāh has certainly sustained a clear loss.","words":[{"id":1,"arabic":"وَلَأُضِلَّنَّهُمْ","translit":"ْmُhَّnَّlِḍُaʾَlَw","root":"ضلل"},{"id":2,"arabic":"وَلَأُمَنِّيَنَّهُمْ","translit":"ْmُhَّnَyِّnَmُaʾَlَw","root":"مني"},{"id":3,"arabic":"وَلَءَامُرَنَّهُمْ","translit":"ْmُhَّnَrُmāَءَlَw","root":"امر"},{"id":4,"arabic":"فَلَيُبَتِّكُنَّ","translit":"َّnُkِّtَbُyَlَf","root":"بتك"},{"id":5,"arabic":"ءَاذَانَ","translit":"َnāَhdāَء","root":"اذن"},{"id":6,"arabic":"ٱلْأَنْعَٰمِ","translit":"ِmَٰʿعْnَaʾْlٱ","root":"نعم"},{"id":7,"arabic":"وَلَءَامُرَنَّهُمْ","translit":"ْmُhَّnَrُmāَءَlَw","root":"امر"},{"id":8,"arabic":"فَلَيُغَيِّرُنَّ","translit":"َّnُrِّyَغُyَlَf","root":"غير"},{"id":9,"arabic":"خَلْقَ","translit":"َqْlَhk","root":"خلق"},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":12,"arabic":"يَتَّخِذِ","translit":"ِhdِhkَّtَy","root":"اخذ"},{"id":13,"arabic":"ٱلشَّيْطَٰنَ","translit":"َnَٰṭْyَّhslٱ","root":"شطن"},{"id":14,"arabic":"وَلِيًّا","translit":"āًّyِlَw","root":"ولي"},{"id":15,"arabic":"مِّن","translit":"nِّm","root":""},{"id":16,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":19,"arabic":"خَسِرَ","translit":"َrِsَhk","root":"خسر"},{"id":20,"arabic":"خُسْرَانًا","translit":"āًnāَrْsُhk","root":"خسر"},{"id":21,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":true},{"ayah":120,"text":"يَعِدُهُمْ وَيُمَنِّيهِمْۖ وَمَا يَعِدُهُمُ ٱلشَّيْطَٰنُ إِلَّا غُرُورًا ","translation":"He [i.e., Satan] promises them and arouses desire in them. But Satan does not promise them except delusion.","words":[{"id":1,"arabic":"يَعِدُهُمْ","translit":"ْmُhُdِʿعَy","root":"وعد"},{"id":2,"arabic":"وَيُمَنِّيهِمْ","translit":"ْmِhyِّnَmُyَw","root":"مني"},{"id":3,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":4,"arabic":"يَعِدُهُمُ","translit":"ُmُhُdِʿعَy","root":"وعد"},{"id":5,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"غُرُورًا","translit":"āًrwُrُغ","root":"غرر"}],"hasIhya":true},{"ayah":121,"text":"أُو۟لَٰٓئِكَ مَأْوَىٰهُمْ جَهَنَّمُ وَلَا يَجِدُونَ عَنْهَا مَحِيصًا ","translation":"The refuge of those will be Hell, and they will not find from it an escape.","words":[{"id":1,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":2,"arabic":"مَأْوَىٰهُمْ","translit":"ْmُhٰàَwْaʾَm","root":"اوي"},{"id":3,"arabic":"جَهَنَّمُ","translit":"ُmَّnَhَjg","root":""},{"id":4,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":5,"arabic":"يَجِدُونَ","translit":"َnwُdِjgَy","root":"وجد"},{"id":6,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":7,"arabic":"مَحِيصًا","translit":"āًṣyِḥَm","root":"حيص"}],"hasIhya":false},{"ayah":122,"text":"وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ سَنُدْخِلُهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًاۖ وَعْدَ ٱللَّهِ حَقًّاۚ وَمَنْ أَصْدَقُ مِنَ ٱللَّهِ قِيلًا ","translation":"But the ones who believe and do righteous deeds - We will admit them to gardens beneath which rivers flow, wherein they will abide forever. [It is] the promise of Allāh, [which is] truth, and who is more truthful than Allāh in statement.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":3,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":4,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":5,"arabic":"سَنُدْخِلُهُمْ","translit":"ْmُhُlِhkْdُnَs","root":"دخل"},{"id":6,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":7,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":10,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":11,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":12,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":13,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":14,"arabic":"وَعْدَ","translit":"َdْʿعَw","root":"وعد"},{"id":15,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":16,"arabic":"حَقًّا","translit":"āًّqَḥ","root":"حقق"},{"id":17,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":18,"arabic":"أَصْدَقُ","translit":"ُqَdْṣَaʾ","root":"صدق"},{"id":19,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":20,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":21,"arabic":"قِيلًا","translit":"āًlyِq","root":"قول"}],"hasIhya":true},{"ayah":123,"text":"لَّيْسَ بِأَمَانِيِّكُمْ وَلَآ أَمَانِىِّ أَهْلِ ٱلْكِتَٰبِۗ مَن يَعْمَلْ سُوٓءًا يُجْزَ بِهِۦ وَلَا يَجِدْ لَهُۥ مِن دُونِ ٱللَّهِ وَلِيًّا وَلَا نَصِيرًا ","translation":"It [i.e., Paradise] is not [obtained] by your wishful thinking nor by that of the People of the Scripture. Whoever does a wrong will be recompensed for it, and he will not find besides Allāh a protector or a helper.","words":[{"id":1,"arabic":"لَّيْسَ","translit":"َsْyَّl","root":"ليس"},{"id":2,"arabic":"بِأَمَانِيِّكُمْ","translit":"ْmُkِّyِnāَmَaʾِb","root":"مني"},{"id":3,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":4,"arabic":"أَمَانِىِّ","translit":"ِّàِnāَmَaʾ","root":"مني"},{"id":5,"arabic":"أَهْلِ","translit":"ِlْhَaʾ","root":"اهل"},{"id":6,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":7,"arabic":"مَن","translit":"nَm","root":""},{"id":8,"arabic":"يَعْمَلْ","translit":"ْlَmْʿعَy","root":"عمل"},{"id":9,"arabic":"سُوٓءًا","translit":"āًءٓwُs","root":"سوا"},{"id":10,"arabic":"يُجْزَ","translit":"َzْjgُy","root":"جزي"},{"id":11,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":12,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":13,"arabic":"يَجِدْ","translit":"ْdِjgَy","root":"وجد"},{"id":14,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":15,"arabic":"مِن","translit":"nِm","root":""},{"id":16,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"وَلِيًّا","translit":"āًّyِlَw","root":"ولي"},{"id":19,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":20,"arabic":"نَصِيرًا","translit":"āًryِṣَn","root":"نصر"}],"hasIhya":true},{"ayah":124,"text":"وَمَن يَعْمَلْ مِنَ ٱلصَّٰلِحَٰتِ مِن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَأُو۟لَٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ وَلَا يُظْلَمُونَ نَقِيرًا ","translation":"And whoever does righteous deeds, whether male or female, while being a believer - those will enter Paradise and will not be wronged, [even as much as] the speck on a date seed.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَعْمَلْ","translit":"ْlَmْʿعَy","root":"عمل"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"ذَكَرٍ","translit":"ٍrَkَhd","root":"ذكر"},{"id":7,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":8,"arabic":"أُنثَىٰ","translit":"ٰàَhtnُaʾ","root":"انث"},{"id":9,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":10,"arabic":"مُؤْمِنٌ","translit":"ٌnِmْwʾُm","root":"امن"},{"id":11,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":12,"arabic":"يَدْخُلُونَ","translit":"َnwُlُhkْdَy","root":"دخل"},{"id":13,"arabic":"ٱلْجَنَّةَ","translit":"َẗَّnَjgْlٱ","root":"جنن"},{"id":14,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":15,"arabic":"يُظْلَمُونَ","translit":"َnwُmَlْẓُy","root":"ظلم"},{"id":16,"arabic":"نَقِيرًا","translit":"āًryِqَn","root":"نقر"}],"hasIhya":false},{"ayah":125,"text":"وَمَنْ أَحْسَنُ دِينًا مِّمَّنْ أَسْلَمَ وَجْهَهُۥ لِلَّهِ وَهُوَ مُحْسِنٌ وَٱتَّبَعَ مِلَّةَ إِبْرَٰهِيمَ حَنِيفًاۗ وَٱتَّخَذَ ٱللَّهُ إِبْرَٰهِيمَ خَلِيلًا ","translation":"And who is better in religion than one who submits himself to Allāh while being a doer of good and follows the religion of Abraham, inclining toward truth? And Allāh took Abraham as an intimate friend.","words":[{"id":1,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":2,"arabic":"أَحْسَنُ","translit":"ُnَsْḥَaʾ","root":"حسن"},{"id":3,"arabic":"دِينًا","translit":"āًnyِd","root":"دين"},{"id":4,"arabic":"مِّمَّنْ","translit":"ْnَّmِّm","root":""},{"id":5,"arabic":"أَسْلَمَ","translit":"َmَlْsَaʾ","root":"سلم"},{"id":6,"arabic":"وَجْهَهُۥ","translit":"ۥُhَhْjgَw","root":"وجه"},{"id":7,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":8,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":9,"arabic":"مُحْسِنٌ","translit":"ٌnِsْḥُm","root":"حسن"},{"id":10,"arabic":"وَٱتَّبَعَ","translit":"َʿعَbَّtٱَw","root":"تبع"},{"id":11,"arabic":"مِلَّةَ","translit":"َẗَّlِm","root":"ملل"},{"id":12,"arabic":"إِبْرَٰهِيمَ","translit":"َmyِhَٰrْbِiʾ","root":""},{"id":13,"arabic":"حَنِيفًا","translit":"āًfyِnَḥ","root":"حنف"},{"id":14,"arabic":"وَٱتَّخَذَ","translit":"َhdَhkَّtٱَw","root":"اخذ"},{"id":15,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":16,"arabic":"إِبْرَٰهِيمَ","translit":"َmyِhَٰrْbِiʾ","root":""},{"id":17,"arabic":"خَلِيلًا","translit":"āًlyِlَhk","root":"خلل"}],"hasIhya":false},{"ayah":126,"text":"وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۚ وَكَانَ ٱللَّهُ بِكُلِّ شَىْءٍ مُّحِيطًا ","translation":"And to Allāh belongs whatever is in the heavens and whatever is on the earth. And ever is Allāh, of all things, encompassing.","words":[{"id":1,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":8,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"بِكُلِّ","translit":"ِّlُkِb","root":"كلل"},{"id":11,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":12,"arabic":"مُّحِيطًا","translit":"āًṭyِḥُّm","root":"حوط"}],"hasIhya":true},{"ayah":127,"text":"وَيَسْتَفْتُونَكَ فِى ٱلنِّسَآءِۖ قُلِ ٱللَّهُ يُفْتِيكُمْ فِيهِنَّ وَمَا يُتْلَىٰ عَلَيْكُمْ فِى ٱلْكِتَٰبِ فِى يَتَٰمَى ٱلنِّسَآءِ ٱلَّٰتِى لَا تُؤْتُونَهُنَّ مَا كُتِبَ لَهُنَّ وَتَرْغَبُونَ أَن تَنكِحُوهُنَّ وَٱلْمُسْتَضْعَفِينَ مِنَ ٱلْوِلْدَٰنِ وَأَن تَقُومُوا۟ لِلْيَتَٰمَىٰ بِٱلْقِسْطِۚ وَمَا تَفْعَلُوا۟ مِنْ خَيْرٍ فَإِنَّ ٱللَّهَ كَانَ بِهِۦ عَلِيمًا ","translation":"And they request from you, [O Muḥammad], a [legal] ruling concerning women. Say, \"Allāh gives you a ruling about them and [about] what has been recited to you in the Book concerning the orphan girls to whom you do not give what is decreed for them[1] - and [yet] you desire to marry them - and concerning the oppressed among children and that you maintain for orphans [their rights] in justice.\" And whatever you do of good - indeed, Allāh is ever Knowing of it.","words":[{"id":1,"arabic":"وَيَسْتَفْتُونَكَ","translit":"َkَnwُtْfَtْsَyَw","root":"فتي"},{"id":2,"arabic":"فِى","translit":"àِf","root":""},{"id":3,"arabic":"ٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱ","root":"نسو"},{"id":4,"arabic":"قُلِ","translit":"ِlُq","root":"قول"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"يُفْتِيكُمْ","translit":"ْmُkyِtْfُy","root":"فتي"},{"id":7,"arabic":"فِيهِنَّ","translit":"َّnِhyِf","root":""},{"id":8,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":9,"arabic":"يُتْلَىٰ","translit":"ٰàَlْtُy","root":"تلو"},{"id":10,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"يَتَٰمَى","translit":"àَmَٰtَy","root":"يتم"},{"id":15,"arabic":"ٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱ","root":"نسو"},{"id":16,"arabic":"ٱلَّٰتِى","translit":"àِtَّٰlٱ","root":""},{"id":17,"arabic":"لَا","translit":"āَl","root":""},{"id":18,"arabic":"تُؤْتُونَهُنَّ","translit":"َّnُhَnwُtْwʾُt","root":"اتي"},{"id":19,"arabic":"مَا","translit":"āَm","root":""},{"id":20,"arabic":"كُتِبَ","translit":"َbِtُk","root":"كتب"},{"id":21,"arabic":"لَهُنَّ","translit":"َّnُhَl","root":""},{"id":22,"arabic":"وَتَرْغَبُونَ","translit":"َnwُbَغْrَtَw","root":"رغب"},{"id":23,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":24,"arabic":"تَنكِحُوهُنَّ","translit":"َّnُhwُḥِknَt","root":"نكح"},{"id":25,"arabic":"وَٱلْمُسْتَضْعَفِينَ","translit":"َnyِfَʿعْḍَtْsُmْlٱَw","root":"ضعف"},{"id":26,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":27,"arabic":"ٱلْوِلْدَٰنِ","translit":"ِnَٰdْlِwْlٱ","root":"ولد"},{"id":28,"arabic":"وَأَن","translit":"nَaʾَw","root":""},{"id":29,"arabic":"تَقُومُوا۟","translit":"۟āwُmwُqَt","root":"قوم"},{"id":30,"arabic":"لِلْيَتَٰمَىٰ","translit":"ٰàَmَٰtَyْlِl","root":"يتم"},{"id":31,"arabic":"بِٱلْقِسْطِ","translit":"ِṭْsِqْlٱِb","root":"قسط"},{"id":32,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":33,"arabic":"تَفْعَلُوا۟","translit":"۟āwُlَʿعْfَt","root":"فعل"},{"id":34,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":35,"arabic":"خَيْرٍ","translit":"ٍrْyَhk","root":"خير"},{"id":36,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":37,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":38,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":39,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":40,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":128,"text":"وَإِنِ ٱمْرَأَةٌ خَافَتْ مِنۢ بَعْلِهَا نُشُوزًا أَوْ إِعْرَاضًا فَلَا جُنَاحَ عَلَيْهِمَآ أَن يُصْلِحَا بَيْنَهُمَا صُلْحًاۚ وَٱلصُّلْحُ خَيْرٌۗ وَأُحْضِرَتِ ٱلْأَنفُسُ ٱلشُّحَّۚ وَإِن تُحْسِنُوا۟ وَتَتَّقُوا۟ فَإِنَّ ٱللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا ","translation":"And if a woman fears from her husband contempt or evasion, there is no sin upon them if they make terms of settlement between them - and settlement is best. And present in [human] souls is stinginess.[1] But if you do good and fear Allāh - then indeed Allāh is ever, of what you do, Aware.","words":[{"id":1,"arabic":"وَإِنِ","translit":"ِnِiʾَw","root":""},{"id":2,"arabic":"ٱمْرَأَةٌ","translit":"ٌẗَaʾَrْmٱ","root":"مرا"},{"id":3,"arabic":"خَافَتْ","translit":"ْtَfāَhk","root":"خوف"},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَعْلِهَا","translit":"āَhِlْʿعَb","root":"بعل"},{"id":6,"arabic":"نُشُوزًا","translit":"āًzwُhsُn","root":"نشز"},{"id":7,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":8,"arabic":"إِعْرَاضًا","translit":"āًḍāَrْʿعِiʾ","root":"عرض"},{"id":9,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":10,"arabic":"جُنَاحَ","translit":"َḥāَnُjg","root":"جنح"},{"id":11,"arabic":"عَلَيْهِمَآ","translit":"ٓāَmِhْyَlَʿع","root":""},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"يُصْلِحَا","translit":"āَḥِlْṣُy","root":"صلح"},{"id":14,"arabic":"بَيْنَهُمَا","translit":"āَmُhَnْyَb","root":"بين"},{"id":15,"arabic":"صُلْحًا","translit":"āًḥْlُṣ","root":"صلح"},{"id":16,"arabic":"وَٱلصُّلْحُ","translit":"ُḥْlُّṣlٱَw","root":"صلح"},{"id":17,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":18,"arabic":"وَأُحْضِرَتِ","translit":"ِtَrِḍْḥُaʾَw","root":"حضر"},{"id":19,"arabic":"ٱلْأَنفُسُ","translit":"ُsُfnَaʾْlٱ","root":"نفس"},{"id":20,"arabic":"ٱلشُّحَّ","translit":"َّḥُّhslٱ","root":"شحح"},{"id":21,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":22,"arabic":"تُحْسِنُوا۟","translit":"۟āwُnِsْḥُt","root":"حسن"},{"id":23,"arabic":"وَتَتَّقُوا۟","translit":"۟āwُqَّtَtَw","root":"وقي"},{"id":24,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":25,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":26,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":27,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":28,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":29,"arabic":"خَبِيرًا","translit":"āًryِbَhk","root":"خبر"}],"hasIhya":false},{"ayah":129,"text":"وَلَن تَسْتَطِيعُوٓا۟ أَن تَعْدِلُوا۟ بَيْنَ ٱلنِّسَآءِ وَلَوْ حَرَصْتُمْۖ فَلَا تَمِيلُوا۟ كُلَّ ٱلْمَيْلِ فَتَذَرُوهَا كَٱلْمُعَلَّقَةِۚ وَإِن تُصْلِحُوا۟ وَتَتَّقُوا۟ فَإِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا ","translation":"And you will never be able to be equal [in feeling] between wives, even if you should strive [to do so]. So do not incline completely [toward one] and leave another hanging.[1] And if you amend [your affairs] and fear Allāh - then indeed, Allāh is ever Forgiving and Merciful.","words":[{"id":1,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":2,"arabic":"تَسْتَطِيعُوٓا۟","translit":"۟āٓwُʿعyِṭَtْsَt","root":"طوع"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"تَعْدِلُوا۟","translit":"۟āwُlِdْʿعَt","root":"عدل"},{"id":5,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":6,"arabic":"ٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱ","root":"نسو"},{"id":7,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":8,"arabic":"حَرَصْتُمْ","translit":"ْmُtْṣَrَḥ","root":"حرص"},{"id":9,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":10,"arabic":"تَمِيلُوا۟","translit":"۟āwُlyِmَt","root":"ميل"},{"id":11,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":12,"arabic":"ٱلْمَيْلِ","translit":"ِlْyَmْlٱ","root":"ميل"},{"id":13,"arabic":"فَتَذَرُوهَا","translit":"āَhwُrَhdَtَf","root":"وذر"},{"id":14,"arabic":"كَٱلْمُعَلَّقَةِ","translit":"ِẗَqَّlَʿعُmْlٱَk","root":"علق"},{"id":15,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":16,"arabic":"تُصْلِحُوا۟","translit":"۟āwُḥِlْṣُt","root":"صلح"},{"id":17,"arabic":"وَتَتَّقُوا۟","translit":"۟āwُqَّtَtَw","root":"وقي"},{"id":18,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":19,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":20,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":21,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"},{"id":22,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":true},{"ayah":130,"text":"وَإِن يَتَفَرَّقَا يُغْنِ ٱللَّهُ كُلًّا مِّن سَعَتِهِۦۚ وَكَانَ ٱللَّهُ وَٰسِعًا حَكِيمًا ","translation":"But if they separate [by divorce], Allāh will enrich each [of them] from His abundance. And ever is Allāh Encompassing and Wise.","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"يَتَفَرَّقَا","translit":"āَqَّrَfَtَy","root":"فرق"},{"id":3,"arabic":"يُغْنِ","translit":"ِnْغُy","root":"غني"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"كُلًّا","translit":"āًّlُk","root":"كلل"},{"id":6,"arabic":"مِّن","translit":"nِّm","root":""},{"id":7,"arabic":"سَعَتِهِۦ","translit":"ۦِhِtَʿعَs","root":"وسع"},{"id":8,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"وَٰسِعًا","translit":"āًʿعِsَٰw","root":"وسع"},{"id":11,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":true},{"ayah":131,"text":"وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۗ وَلَقَدْ وَصَّيْنَا ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ مِن قَبْلِكُمْ وَإِيَّاكُمْ أَنِ ٱتَّقُوا۟ ٱللَّهَۚ وَإِن تَكْفُرُوا۟ فَإِنَّ لِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۚ وَكَانَ ٱللَّهُ غَنِيًّا حَمِيدًا ","translation":"And to Allāh belongs whatever is in the heavens and whatever is on the earth. And We have instructed those who were given the Scripture before you and yourselves to fear Allāh. But if you disbelieve - then to Allāh belongs whatever is in the heavens and whatever is on the earth. And ever is Allāh Free of need and Praiseworthy.","words":[{"id":1,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":8,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":9,"arabic":"وَصَّيْنَا","translit":"āَnْyَّṣَw","root":"وصي"},{"id":10,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":11,"arabic":"أُوتُوا۟","translit":"۟āwُtwُaʾ","root":"اتي"},{"id":12,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"قَبْلِكُمْ","translit":"ْmُkِlْbَq","root":"قبل"},{"id":15,"arabic":"وَإِيَّاكُمْ","translit":"ْmُkāَّyِiʾَw","root":""},{"id":16,"arabic":"أَنِ","translit":"ِnَaʾ","root":""},{"id":17,"arabic":"ٱتَّقُوا۟","translit":"۟āwُqَّtٱ","root":"وقي"},{"id":18,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":19,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":20,"arabic":"تَكْفُرُوا۟","translit":"۟āwُrُfْkَt","root":"كفر"},{"id":21,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":22,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":23,"arabic":"مَا","translit":"āَm","root":""},{"id":24,"arabic":"فِى","translit":"àِf","root":""},{"id":25,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":26,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":27,"arabic":"فِى","translit":"àِf","root":""},{"id":28,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":29,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":30,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":31,"arabic":"غَنِيًّا","translit":"āًّyِnَغ","root":"غني"},{"id":32,"arabic":"حَمِيدًا","translit":"āًdyِmَḥ","root":"حمد"}],"hasIhya":true},{"ayah":132,"text":"وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا ","translation":"And to Allāh belongs whatever is in the heavens and whatever is on the earth. And sufficient is Allāh as Disposer of affairs.[1]","words":[{"id":1,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":8,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":9,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":10,"arabic":"وَكِيلًا","translit":"āًlyِkَw","root":"وكل"}],"hasIhya":true},{"ayah":133,"text":"إِن يَشَأْ يُذْهِبْكُمْ أَيُّهَا ٱلنَّاسُ وَيَأْتِ بِـَٔاخَرِينَۚ وَكَانَ ٱللَّهُ عَلَىٰ ذَٰلِكَ قَدِيرًا ","translation":"If He wills, He can do away with you, O people, and bring others [in your place]. And ever is Allāh competent to do that.","words":[{"id":1,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":2,"arabic":"يَشَأْ","translit":"ْaʾَhsَy","root":"شيا"},{"id":3,"arabic":"يُذْهِبْكُمْ","translit":"ْmُkْbِhْhdُy","root":"ذهب"},{"id":4,"arabic":"أَيُّهَا","translit":"āَhُّyَaʾ","root":"ايي"},{"id":5,"arabic":"ٱلنَّاسُ","translit":"ُsāَّnlٱ","root":"انس"},{"id":6,"arabic":"وَيَأْتِ","translit":"ِtْaʾَyَw","root":"اتي"},{"id":7,"arabic":"بِـَٔاخَرِينَ","translit":"َnyِrَhkāَٔـِb","root":"اخر"},{"id":8,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":11,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":12,"arabic":"قَدِيرًا","translit":"āًryِdَq","root":"قدر"}],"hasIhya":false},{"ayah":134,"text":"مَّن كَانَ يُرِيدُ ثَوَابَ ٱلدُّنْيَا فَعِندَ ٱللَّهِ ثَوَابُ ٱلدُّنْيَا وَٱلْءَاخِرَةِۚ وَكَانَ ٱللَّهُ سَمِيعًۢا بَصِيرًا ","translation":"Whoever desires the reward of this world - then with Allāh is the reward of this world and the Hereafter. And ever is Allāh Hearing and Seeing.","words":[{"id":1,"arabic":"مَّن","translit":"nَّm","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":4,"arabic":"ثَوَابَ","translit":"َbāَwَht","root":"ثوب"},{"id":5,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":6,"arabic":"فَعِندَ","translit":"َdnِʿعَf","root":"عند"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"ثَوَابُ","translit":"ُbāَwَht","root":"ثوب"},{"id":9,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":10,"arabic":"وَٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱَw","root":"اخر"},{"id":11,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"سَمِيعًۢا","translit":"āًۢʿعyِmَs","root":"سمع"},{"id":14,"arabic":"بَصِيرًا","translit":"āًryِṣَb","root":"بصر"}],"hasIhya":false},{"ayah":135,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ كُونُوا۟ قَوَّٰمِينَ بِٱلْقِسْطِ شُهَدَآءَ لِلَّهِ وَلَوْ عَلَىٰٓ أَنفُسِكُمْ أَوِ ٱلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَۚ إِن يَكُنْ غَنِيًّا أَوْ فَقِيرًا فَٱللَّهُ أَوْلَىٰ بِهِمَاۖ فَلَا تَتَّبِعُوا۟ ٱلْهَوَىٰٓ أَن تَعْدِلُوا۟ۚ وَإِن تَلْوُۥٓا۟ أَوْ تُعْرِضُوا۟ فَإِنَّ ٱللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا ","translation":"O you who have believed, be persistently standing firm in justice, witnesses for Allāh, even if it be against yourselves or parents and relatives. Whether one is rich or poor, Allāh is more worthy of both.[1] So follow not [personal] inclination, lest you not be just. And if you distort [your testimony] or refuse [to give it], then indeed Allāh is ever, of what you do, Aware.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","r