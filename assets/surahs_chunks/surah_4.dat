d":4,"arabic":"لَّدُنَّآ","translit":"ٓāَّnُdَّl","root":"لدن"},{"id":5,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":6,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":68,"text":"وَلَهَدَيْنَٰهُمْ صِرَٰطًا مُّسْتَقِيمًا ","translation":"And We would have guided them to a straight path.","words":[{"id":1,"arabic":"وَلَهَدَيْنَٰهُمْ","translit":"ْmُhَٰnْyَdَhَlَw","root":"هدي"},{"id":2,"arabic":"صِرَٰطًا","translit":"āًṭَٰrِṣ","root":"صرط"},{"id":3,"arabic":"مُّسْتَقِيمًا","translit":"āًmyِqَtْsُّm","root":"قوم"}],"hasIhya":false},{"ayah":69,"text":"وَمَن يُطِعِ ٱللَّهَ وَٱلرَّسُولَ فَأُو۟لَٰٓئِكَ مَعَ ٱلَّذِينَ أَنْعَمَ ٱللَّهُ عَلَيْهِم مِّنَ ٱلنَّبِيِّۦنَ وَٱلصِّدِّيقِينَ وَٱلشُّهَدَآءِ وَٱلصَّٰلِحِينَۚ وَحَسُنَ أُو۟لَٰٓئِكَ رَفِيقًا ","translation":"And whoever obeys Allāh and the Messenger - those will be with the ones upon whom Allāh has bestowed favor of the prophets, the steadfast affirmers of truth, the martyrs and the righteous. And excellent are those as companions.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يُطِعِ","translit":"ِʿعِṭُy","root":"طوع"},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"وَٱلرَّسُولَ","translit":"َlwُsَّrlٱَw","root":"رسل"},{"id":5,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":6,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":7,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":8,"arabic":"أَنْعَمَ","translit":"َmَʿعْnَaʾ","root":"نعم"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":11,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":12,"arabic":"ٱلنَّبِيِّۦنَ","translit":"َnۦِّyِbَّnlٱ","root":"نبا"},{"id":13,"arabic":"وَٱلصِّدِّيقِينَ","translit":"َnyِqyِّdِّṣlٱَw","root":"صدق"},{"id":14,"arabic":"وَٱلشُّهَدَآءِ","translit":"ِءٓāَdَhُّhslٱَw","root":"شهد"},{"id":15,"arabic":"وَٱلصَّٰلِحِينَ","translit":"َnyِḥِlَّٰṣlٱَw","root":"صلح"},{"id":16,"arabic":"وَحَسُنَ","translit":"َnُsَḥَw","root":"حسن"},{"id":17,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":18,"arabic":"رَفِيقًا","translit":"āًqyِfَr","root":"رفق"}],"hasIhya":true},{"ayah":70,"text":"ذَٰلِكَ ٱلْفَضْلُ مِنَ ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ عَلِيمًا ","translation":"That is the bounty from Allāh, and sufficient is Allāh as Knower.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"ٱلْفَضْلُ","translit":"ُlْḍَfْlٱ","root":"فضل"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":6,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":7,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":71,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ خُذُوا۟ حِذْرَكُمْ فَٱنفِرُوا۟ ثُبَاتٍ أَوِ ٱنفِرُوا۟ جَمِيعًا ","translation":"O you who have believed, take your precaution and [either] go forth in companies or go forth all together.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"خُذُوا۟","translit":"۟āwُhdُhk","root":"اخذ"},{"id":5,"arabic":"حِذْرَكُمْ","translit":"ْmُkَrْhdِḥ","root":"حذر"},{"id":6,"arabic":"فَٱنفِرُوا۟","translit":"۟āwُrِfnٱَf","root":"نفر"},{"id":7,"arabic":"ثُبَاتٍ","translit":"ٍtāَbُht","root":"ثبي"},{"id":8,"arabic":"أَوِ","translit":"ِwَaʾ","root":""},{"id":9,"arabic":"ٱنفِرُوا۟","translit":"۟āwُrِfnٱ","root":"نفر"},{"id":10,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"}],"hasIhya":true},{"ayah":72,"text":"وَإِنَّ مِنكُمْ لَمَن لَّيُبَطِّئَنَّ فَإِنْ أَصَٰبَتْكُم مُّصِيبَةٌ قَالَ قَدْ أَنْعَمَ ٱللَّهُ عَلَىَّ إِذْ لَمْ أَكُن مَّعَهُمْ شَهِيدًا ","translation":"And indeed, there is among you he who lingers behind; and if disaster strikes you, he says, \"Allāh has favored me in that I was not present with them.\"","words":[{"id":1,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":2,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":3,"arabic":"لَمَن","translit":"nَmَl","root":""},{"id":4,"arabic":"لَّيُبَطِّئَنَّ","translit":"َّnَyʾِّṭَbُyَّl","root":"بطا"},{"id":5,"arabic":"فَإِنْ","translit":"ْnِiʾَf","root":""},{"id":6,"arabic":"أَصَٰبَتْكُم","translit":"mُkْtَbَٰṣَaʾ","root":"صوب"},{"id":7,"arabic":"مُّصِيبَةٌ","translit":"ٌẗَbyِṣُّm","root":"صوب"},{"id":8,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":9,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":10,"arabic":"أَنْعَمَ","translit":"َmَʿعْnَaʾ","root":"نعم"},{"id":11,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":12,"arabic":"عَلَىَّ","translit":"َّàَlَʿع","root":""},{"id":13,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":14,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":15,"arabic":"أَكُن","translit":"nُkَaʾ","root":"كون"},{"id":16,"arabic":"مَّعَهُمْ","translit":"ْmُhَʿعَّm","root":""},{"id":17,"arabic":"شَهِيدًا","translit":"āًdyِhَhs","root":"شهد"}],"hasIhya":true},{"ayah":73,"text":"وَلَئِنْ أَصَٰبَكُمْ فَضْلٌ مِّنَ ٱللَّهِ لَيَقُولَنَّ كَأَن لَّمْ تَكُنۢ بَيْنَكُمْ وَبَيْنَهُۥ مَوَدَّةٌ يَٰلَيْتَنِى كُنتُ مَعَهُمْ فَأَفُوزَ فَوْزًا عَظِيمًا ","translation":"But if bounty comes to you from Allāh, he will surely say, as if [i.e., showing that] there had never been between you and him any affection, \"Oh, I wish I had been with them so I could have attained a great attainment.\"[1]","words":[{"id":1,"arabic":"وَلَئِنْ","translit":"ْnِyʾَlَw","root":""},{"id":2,"arabic":"أَصَٰبَكُمْ","translit":"ْmُkَbَٰṣَaʾ","root":"صوب"},{"id":3,"arabic":"فَضْلٌ","translit":"ٌlْḍَf","root":"فضل"},{"id":4,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"لَيَقُولَنَّ","translit":"َّnَlwُqَyَl","root":"قول"},{"id":7,"arabic":"كَأَن","translit":"nَaʾَk","root":""},{"id":8,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":9,"arabic":"تَكُنۢ","translit":"ۢnُkَt","root":"كون"},{"id":10,"arabic":"بَيْنَكُمْ","translit":"ْmُkَnْyَb","root":"بين"},{"id":11,"arabic":"وَبَيْنَهُۥ","translit":"ۥُhَnْyَbَw","root":"بين"},{"id":12,"arabic":"مَوَدَّةٌ","translit":"ٌẗَّdَwَm","root":"ودد"},{"id":13,"arabic":"يَٰلَيْتَنِى","translit":"àِnَtْyَlَٰy","root":""},{"id":14,"arabic":"كُنتُ","translit":"ُtnُk","root":"كون"},{"id":15,"arabic":"مَعَهُمْ","translit":"ْmُhَʿعَm","root":""},{"id":16,"arabic":"فَأَفُوزَ","translit":"َzwُfَaʾَf","root":"فوز"},{"id":17,"arabic":"فَوْزًا","translit":"āًzْwَf","root":"فوز"},{"id":18,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":74,"text":"فَلْيُقَٰتِلْ فِى سَبِيلِ ٱللَّهِ ٱلَّذِينَ يَشْرُونَ ٱلْحَيَوٰةَ ٱلدُّنْيَا بِٱلْءَاخِرَةِۚ وَمَن يُقَٰتِلْ فِى سَبِيلِ ٱللَّهِ فَيُقْتَلْ أَوْ يَغْلِبْ فَسَوْفَ نُؤْتِيهِ أَجْرًا عَظِيمًا ","translation":"So let those fight in the cause of Allāh who sell the life of this world for the Hereafter. And he who fights in the cause of Allāh and is killed or achieves victory - We will bestow upon him a great reward.","words":[{"id":1,"arabic":"فَلْيُقَٰتِلْ","translit":"ْlِtَٰqُyْlَf","root":"قتل"},{"id":2,"arabic":"فِى","translit":"àِf","root":""},{"id":3,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":6,"arabic":"يَشْرُونَ","translit":"َnwُrْhsَy","root":"شري"},{"id":7,"arabic":"ٱلْحَيَوٰةَ","translit":"َẗٰwَyَḥْlٱ","root":"حيي"},{"id":8,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":9,"arabic":"بِٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱِb","root":"اخر"},{"id":10,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":11,"arabic":"يُقَٰتِلْ","translit":"ْlِtَٰqُy","root":"قتل"},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":14,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":15,"arabic":"فَيُقْتَلْ","translit":"ْlَtْqُyَf","root":"قتل"},{"id":16,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":17,"arabic":"يَغْلِبْ","translit":"ْbِlْغَy","root":"غلب"},{"id":18,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":19,"arabic":"نُؤْتِيهِ","translit":"ِhyِtْwʾُn","root":"اتي"},{"id":20,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":21,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":75,"text":"وَمَا لَكُمْ لَا تُقَٰتِلُونَ فِى سَبِيلِ ٱللَّهِ وَٱلْمُسْتَضْعَفِينَ مِنَ ٱلرِّجَالِ وَٱلنِّسَآءِ وَٱلْوِلْدَٰنِ ٱلَّذِينَ يَقُولُونَ رَبَّنَآ أَخْرِجْنَا مِنْ هَٰذِهِ ٱلْقَرْيَةِ ٱلظَّالِمِ أَهْلُهَا وَٱجْعَل لَّنَا مِن لَّدُنكَ وَلِيًّا وَٱجْعَل لَّنَا مِن لَّدُنكَ نَصِيرًا ","translation":"And what is [the matter] with you that you fight not in the cause of Allāh and [for] the oppressed among men, women and children who say, \"Our Lord, take us out of this city of oppressive people and appoint for us from Yourself a protector and appoint for us from Yourself a helper\"?","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"تُقَٰتِلُونَ","translit":"َnwُlِtَٰqُt","root":"قتل"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"وَٱلْمُسْتَضْعَفِينَ","translit":"َnyِfَʿعْḍَtْsُmْlٱَw","root":"ضعف"},{"id":9,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":10,"arabic":"ٱلرِّجَالِ","translit":"ِlāَjgِّrlٱ","root":"رجل"},{"id":11,"arabic":"وَٱلنِّسَآءِ","translit":"ِءٓāَsِّnlٱَw","root":"نسو"},{"id":12,"arabic":"وَٱلْوِلْدَٰنِ","translit":"ِnَٰdْlِwْlٱَw","root":"ولد"},{"id":13,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":14,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":15,"arabic":"رَبَّنَآ","translit":"ٓāَnَّbَr","root":"ربب"},{"id":16,"arabic":"أَخْرِجْنَا","translit":"āَnْjgِrْhkَaʾ","root":"خرج"},{"id":17,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":18,"arabic":"هَٰذِهِ","translit":"ِhِhdَٰh","root":""},{"id":19,"arabic":"ٱلْقَرْيَةِ","translit":"ِẗَyْrَqْlٱ","root":"قري"},{"id":20,"arabic":"ٱلظَّالِمِ","translit":"ِmِlāَّẓlٱ","root":"ظلم"},{"id":21,"arabic":"أَهْلُهَا","translit":"āَhُlْhَaʾ","root":"اهل"},{"id":22,"arabic":"وَٱجْعَل","translit":"lَʿعْjgٱَw","root":"جعل"},{"id":23,"arabic":"لَّنَا","translit":"āَnَّl","root":""},{"id":24,"arabic":"مِن","translit":"nِm","root":""},{"id":25,"arabic":"لَّدُنكَ","translit":"َknُdَّl","root":"لدن"},{"id":26,"arabic":"وَلِيًّا","translit":"āًّyِlَw","root":"ولي"},{"id":27,"arabic":"وَٱجْعَل","translit":"lَʿعْjgٱَw","root":"جعل"},{"id":28,"arabic":"لَّنَا","translit":"āَnَّl","root":""},{"id":29,"arabic":"مِن","translit":"nِm","root":""},{"id":30,"arabic":"لَّدُنكَ","translit":"َknُdَّl","root":"لدن"},{"id":31,"arabic":"نَصِيرًا","translit":"āًryِṣَn","root":"نصر"}],"hasIhya":true},{"ayah":76,"text":"ٱلَّذِينَ ءَامَنُوا۟ يُقَٰتِلُونَ فِى سَبِيلِ ٱللَّهِۖ وَٱلَّذِينَ كَفَرُوا۟ يُقَٰتِلُونَ فِى سَبِيلِ ٱلطَّٰغُوتِ فَقَٰتِلُوٓا۟ أَوْلِيَآءَ ٱلشَّيْطَٰنِۖ إِنَّ كَيْدَ ٱلشَّيْطَٰنِ كَانَ ضَعِيفًا ","translation":"Those who believe fight in the cause of Allāh, and those who disbelieve fight in the cause of ṭāghūt.[1] So fight against the allies of Satan. Indeed, the plot of Satan has ever been weak.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":3,"arabic":"يُقَٰتِلُونَ","translit":"َnwُlِtَٰqُy","root":"قتل"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":8,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":9,"arabic":"يُقَٰتِلُونَ","translit":"َnwُlِtَٰqُy","root":"قتل"},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":12,"arabic":"ٱلطَّٰغُوتِ","translit":"ِtwُغَّٰṭlٱ","root":"طغي"},{"id":13,"arabic":"فَقَٰتِلُوٓا۟","translit":"۟āٓwُlِtَٰqَf","root":"قتل"},{"id":14,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":15,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":16,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":17,"arabic":"كَيْدَ","translit":"َdْyَk","root":"كيد"},{"id":18,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":19,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":20,"arabic":"ضَعِيفًا","translit":"āًfyِʿعَḍ","root":"ضعف"}],"hasIhya":false},{"ayah":77,"text":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ قِيلَ لَهُمْ كُفُّوٓا۟ أَيْدِيَكُمْ وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ فَلَمَّا كُتِبَ عَلَيْهِمُ ٱلْقِتَالُ إِذَا فَرِيقٌ مِّنْهُمْ يَخْشَوْنَ ٱلنَّاسَ كَخَشْيَةِ ٱللَّهِ أَوْ أَشَدَّ خَشْيَةًۚ وَقَالُوا۟ رَبَّنَا لِمَ كَتَبْتَ عَلَيْنَا ٱلْقِتَالَ لَوْلَآ أَخَّرْتَنَآ إِلَىٰٓ أَجَلٍ قَرِيبٍۗ قُلْ مَتَٰعُ ٱلدُّنْيَا قَلِيلٌ وَٱلْءَاخِرَةُ خَيْرٌ لِّمَنِ ٱتَّقَىٰ وَلَا تُظْلَمُونَ فَتِيلًا ","translation":"Have you not seen those who were told, \"Restrain your hands [from fighting][1] and establish prayer and give zakāh\"? But then when battle was ordained for them, at once a party of them feared men as they fear Allāh or with [even] greater fear. They said, \"Our Lord, why have You decreed upon us fighting? If only You had postponed [it for] us for a short time.\" Say, \"The enjoyment of this world is little, and the Hereafter is better for he who fears Allāh. And injustice will not be done to you, [even] as much as a thread [inside a date seed].\"","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"قِيلَ","translit":"َlyِq","root":"قول"},{"id":6,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":7,"arabic":"كُفُّوٓا۟","translit":"۟āٓwُّfُk","root":"كفف"},{"id":8,"arabic":"أَيْدِيَكُمْ","translit":"ْmُkَyِdْyَaʾ","root":"يدي"},{"id":9,"arabic":"وَأَقِيمُوا۟","translit":"۟āwُmyِqَaʾَw","root":"قوم"},{"id":10,"arabic":"ٱلصَّلَوٰةَ","translit":"َẗٰwَlَّṣlٱ","root":"صلو"},{"id":11,"arabic":"وَءَاتُوا۟","translit":"۟āwُtāَءَw","root":"اتي"},{"id":12,"arabic":"ٱلزَّكَوٰةَ","translit":"َẗٰwَkَّzlٱ","root":"زكو"},{"id":13,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":14,"arabic":"كُتِبَ","translit":"َbِtُk","root":"كتب"},{"id":15,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":16,"arabic":"ٱلْقِتَالُ","translit":"ُlāَtِqْlٱ","root":"قتل"},{"id":17,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":18,"arabic":"فَرِيقٌ","translit":"ٌqyِrَf","root":"فرق"},{"id":19,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":20,"arabic":"يَخْشَوْنَ","translit":"َnْwَhsْhkَy","root":"خشي"},{"id":21,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":22,"arabic":"كَخَشْيَةِ","translit":"ِẗَyْhsَhkَk","root":"خشي"},{"id":23,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":24,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":25,"arabic":"أَشَدَّ","translit":"َّdَhsَaʾ","root":"شدد"},{"id":26,"arabic":"خَشْيَةً","translit":"ًẗَyْhsَhk","root":"خشي"},{"id":27,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":28,"arabic":"رَبَّنَا","translit":"āَnَّbَr","root":"ربب"},{"id":29,"arabic":"لِمَ","translit":"َmِl","root":""},{"id":30,"arabic":"كَتَبْتَ","translit":"َtْbَtَk","root":"كتب"},{"id":31,"arabic":"عَلَيْنَا","translit":"āَnْyَlَʿع","root":""},{"id":32,"arabic":"ٱلْقِتَالَ","translit":"َlāَtِqْlٱ","root":"قتل"},{"id":33,"arabic":"لَوْلَآ","translit":"ٓāَlْwَl","root":""},{"id":34,"arabic":"أَخَّرْتَنَآ","translit":"ٓāَnَtْrَّhkَaʾ","root":"اخر"},{"id":35,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":36,"arabic":"أَجَلٍ","translit":"ٍlَjgَaʾ","root":"اجل"},{"id":37,"arabic":"قَرِيبٍ","translit":"ٍbyِrَq","root":"قرب"},{"id":38,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":39,"arabic":"مَتَٰعُ","translit":"ُʿعَٰtَm","root":"متع"},{"id":40,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":41,"arabic":"قَلِيلٌ","translit":"ٌlyِlَq","root":"قلل"},{"id":42,"arabic":"وَٱلْءَاخِرَةُ","translit":"ُẗَrِhkāَءْlٱَw","root":"اخر"},{"id":43,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":44,"arabic":"لِّمَنِ","translit":"ِnَmِّl","root":""},{"id":45,"arabic":"ٱتَّقَىٰ","translit":"ٰàَqَّtٱ","root":"وقي"},{"id":46,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":47,"arabic":"تُظْلَمُونَ","translit":"َnwُmَlْẓُt","root":"ظلم"},{"id":48,"arabic":"فَتِيلًا","translit":"āًlyِtَf","root":"فتل"}],"hasIhya":true},{"ayah":78,"text":"أَيْنَمَا تَكُونُوا۟ يُدْرِككُّمُ ٱلْمَوْتُ وَلَوْ كُنتُمْ فِى بُرُوجٍ مُّشَيَّدَةٍۗ وَإِن تُصِبْهُمْ حَسَنَةٌ يَقُولُوا۟ هَٰذِهِۦ مِنْ عِندِ ٱللَّهِۖ وَإِن تُصِبْهُمْ سَيِّئَةٌ يَقُولُوا۟ هَٰذِهِۦ مِنْ عِندِكَۚ قُلْ كُلٌّ مِّنْ عِندِ ٱللَّهِۖ فَمَالِ هَٰٓؤُلَآءِ ٱلْقَوْمِ لَا يَكَادُونَ يَفْقَهُونَ حَدِيثًا ","translation":"Wherever you may be, death will overtake you, even if you should be within towers of lofty construction. But if good comes to them, they say, \"This is from Allāh\"; and if evil befalls them, they say,[1] \"This is from you.\" Say, \"All [things] are from Allāh.\" So what is [the matter] with those people that they can hardly understand any statement?","words":[{"id":1,"arabic":"أَيْنَمَا","translit":"āَmَnْyَaʾ","root":""},{"id":2,"arabic":"تَكُونُوا۟","translit":"۟āwُnwُkَt","root":"كون"},{"id":3,"arabic":"يُدْرِككُّمُ","translit":"ُmُّkkِrْdُy","root":"درك"},{"id":4,"arabic":"ٱلْمَوْتُ","translit":"ُtْwَmْlٱ","root":"موت"},{"id":5,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":6,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"بُرُوجٍ","translit":"ٍjgwُrُb","root":"برج"},{"id":9,"arabic":"مُّشَيَّدَةٍ","translit":"ٍẗَdَّyَhsُّm","root":"شيد"},{"id":10,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":11,"arabic":"تُصِبْهُمْ","translit":"ْmُhْbِṣُt","root":"صوب"},{"id":12,"arabic":"حَسَنَةٌ","translit":"ٌẗَnَsَḥ","root":"حسن"},{"id":13,"arabic":"يَقُولُوا۟","translit":"۟āwُlwُqَy","root":"قول"},{"id":14,"arabic":"هَٰذِهِۦ","translit":"ۦِhِhdَٰh","root":""},{"id":15,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":16,"arabic":"عِندِ","translit":"ِdnِʿع","root":"عند"},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":19,"arabic":"تُصِبْهُمْ","translit":"ْmُhْbِṣُt","root":"صوب"},{"id":20,"arabic":"سَيِّئَةٌ","translit":"ٌẗَyʾِّyَs","root":"سوا"},{"id":21,"arabic":"يَقُولُوا۟","translit":"۟āwُlwُqَy","root":"قول"},{"id":22,"arabic":"هَٰذِهِۦ","translit":"ۦِhِhdَٰh","root":""},{"id":23,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":24,"arabic":"عِندِكَ","translit":"َkِdnِʿع","root":"عند"},{"id":25,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":26,"arabic":"كُلٌّ","translit":"ٌّlُk","root":"كلل"},{"id":27,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":28,"arabic":"عِندِ","translit":"ِdnِʿع","root":"عند"},{"id":29,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":30,"arabic":"فَمَالِ","translit":"ِlāَmَf","root":""},{"id":31,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":32,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":33,"arabic":"لَا","translit":"āَl","root":""},{"id":34,"arabic":"يَكَادُونَ","translit":"َnwُdāَkَy","root":"كود"},{"id":35,"arabic":"يَفْقَهُونَ","translit":"َnwُhَqْfَy","root":"فقه"},{"id":36,"arabic":"حَدِيثًا","translit":"āًhtyِdَḥ","root":"حدث"}],"hasIhya":true},{"ayah":79,"text":"مَّآ أَصَابَكَ مِنْ حَسَنَةٍ فَمِنَ ٱللَّهِۖ وَمَآ أَصَابَكَ مِن سَيِّئَةٍ فَمِن نَّفْسِكَۚ وَأَرْسَلْنَٰكَ لِلنَّاسِ رَسُولًاۚ وَكَفَىٰ بِٱللَّهِ شَهِيدًا ","translation":"What comes to you of good is from Allāh, but what comes to you of evil, [O man], is from yourself.[1] And We have sent you, [O Muḥammad], to the people as a messenger, and sufficient is Allāh as Witness.[2]","words":[{"id":1,"arabic":"مَّآ","translit":"ٓāَّm","root":""},{"id":2,"arabic":"أَصَابَكَ","translit":"َkَbāَṣَaʾ","root":"صوب"},{"id":3,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":4,"arabic":"حَسَنَةٍ","translit":"ٍẗَnَsَḥ","root":"حسن"},{"id":5,"arabic":"فَمِنَ","translit":"َnِmَf","root":""},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":8,"arabic":"أَصَابَكَ","translit":"َkَbāَṣَaʾ","root":"صوب"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"سَيِّئَةٍ","translit":"ٍẗَyʾِّyَs","root":"سوا"},{"id":11,"arabic":"فَمِن","translit":"nِmَf","root":""},{"id":12,"arabic":"نَّفْسِكَ","translit":"َkِsْfَّn","root":"نفس"},{"id":13,"arabic":"وَأَرْسَلْنَٰكَ","translit":"َkَٰnْlَsْrَaʾَw","root":"رسل"},{"id":14,"arabic":"لِلنَّاسِ","translit":"ِsāَّnlِl","root":"انس"},{"id":15,"arabic":"رَسُولًا","translit":"āًlwُsَr","root":"رسل"},{"id":16,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":17,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":18,"arabic":"شَهِيدًا","translit":"āًdyِhَhs","root":"شهد"}],"hasIhya":true},{"ayah":80,"text":"مَّن يُطِعِ ٱلرَّسُولَ فَقَدْ أَطَاعَ ٱللَّهَۖ وَمَن تَوَلَّىٰ فَمَآ أَرْسَلْنَٰكَ عَلَيْهِمْ حَفِيظًا ","translation":"He who obeys the Messenger has obeyed Allāh; but those who turn away - We have not sent you over them as a guardian.","words":[{"id":1,"arabic":"مَّن","translit":"nَّm","root":""},{"id":2,"arabic":"يُطِعِ","translit":"ِʿعِṭُy","root":"طوع"},{"id":3,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":4,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":5,"arabic":"أَطَاعَ","translit":"َʿعāَṭَaʾ","root":"طوع"},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":8,"arabic":"تَوَلَّىٰ","translit":"ٰàَّlَwَt","root":"ولي"},{"id":9,"arabic":"فَمَآ","translit":"ٓāَmَf","root":""},{"id":10,"arabic":"أَرْسَلْنَٰكَ","translit":"َkَٰnْlَsْrَaʾ","root":"رسل"},{"id":11,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":12,"arabic":"حَفِيظًا","translit":"āًẓyِfَḥ","root":"حفظ"}],"hasIhya":true},{"ayah":81,"text":"وَيَقُولُونَ طَاعَةٌ فَإِذَا بَرَزُوا۟ مِنْ عِندِكَ بَيَّتَ طَآئِفَةٌ مِّنْهُمْ غَيْرَ ٱلَّذِى تَقُولُۖ وَٱللَّهُ يَكْتُبُ مَا يُبَيِّتُونَۖ فَأَعْرِضْ عَنْهُمْ وَتَوَكَّلْ عَلَى ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا ","translation":"And they say, \"[We pledge] obedience.\" But when they leave you, a group of them spend the night determining to do other than what you say. But Allāh records what they plan by night. So leave them alone and rely upon Allāh. And sufficient is Allāh as Disposer of affairs.","words":[{"id":1,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":2,"arabic":"طَاعَةٌ","translit":"ٌẗَʿعāَṭ","root":"طوع"},{"id":3,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":4,"arabic":"بَرَزُوا۟","translit":"۟āwُzَrَb","root":"برز"},{"id":5,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":6,"arabic":"عِندِكَ","translit":"َkِdnِʿع","root":"عند"},{"id":7,"arabic":"بَيَّتَ","translit":"َtَّyَb","root":"بيت"},{"id":8,"arabic":"طَآئِفَةٌ","translit":"ٌẗَfِyʾٓāَṭ","root":"طوف"},{"id":9,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":10,"arabic":"غَيْرَ","translit":"َrْyَغ","root":"غير"},{"id":11,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":12,"arabic":"تَقُولُ","translit":"ُlwُqَt","root":"قول"},{"id":13,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":14,"arabic":"يَكْتُبُ","translit":"ُbُtْkَy","root":"كتب"},{"id":15,"arabic":"مَا","translit":"āَm","root":""},{"id":16,"arabic":"يُبَيِّتُونَ","translit":"َnwُtِّyَbُy","root":"بيت"},{"id":17,"arabic":"فَأَعْرِضْ","translit":"ْḍِrْʿعَaʾَf","root":"عرض"},{"id":18,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":19,"arabic":"وَتَوَكَّلْ","translit":"ْlَّkَwَtَw","root":"وكل"},{"id":20,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":21,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":22,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":23,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":24,"arabic":"وَكِيلًا","translit":"āًlyِkَw","root":"وكل"}],"hasIhya":false},{"ayah":82,"text":"أَفَلَا يَتَدَبَّرُونَ ٱلْقُرْءَانَۚ وَلَوْ كَانَ مِنْ عِندِ غَيْرِ ٱللَّهِ لَوَجَدُوا۟ فِيهِ ٱخْتِلَٰفًا كَثِيرًا ","translation":"Then do they not reflect upon the Qur’ān?[1] If it had been from [any] other than Allāh, they would have found within it much contradiction.","words":[{"id":1,"arabic":"أَفَلَا","translit":"āَlَfَaʾ","root":""},{"id":2,"arabic":"يَتَدَبَّرُونَ","translit":"َnwُrَّbَdَtَy","root":"دبر"},{"id":3,"arabic":"ٱلْقُرْءَانَ","translit":"َnāَءْrُqْlٱ","root":"قرا"},{"id":4,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":5,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":6,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":7,"arabic":"عِندِ","translit":"ِdnِʿع","root":"عند"},{"id":8,"arabic":"غَيْرِ","translit":"ِrْyَغ","root":"غير"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"لَوَجَدُوا۟","translit":"۟āwُdَjgَwَl","root":"وجد"},{"id":11,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":12,"arabic":"ٱخْتِلَٰفًا","translit":"āًfَٰlِtْhkٱ","root":"خلف"},{"id":13,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"}],"hasIhya":false},{"ayah":83,"text":"وَإِذَا جَآءَهُمْ أَمْرٌ مِّنَ ٱلْأَمْنِ أَوِ ٱلْخَوْفِ أَذَاعُوا۟ بِهِۦۖ وَلَوْ رَدُّوهُ إِلَى ٱلرَّسُولِ وَإِلَىٰٓ أُو۟لِى ٱلْأَمْرِ مِنْهُمْ لَعَلِمَهُ ٱلَّذِينَ يَسْتَنۢبِطُونَهُۥ مِنْهُمْۗ وَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ لَٱتَّبَعْتُمُ ٱلشَّيْطَٰنَ إِلَّا قَلِيلًا ","translation":"And when there comes to them something [i.e., information] about [public] security or fear, they spread it around. But if they had referred it back to the Messenger or to those of authority among them, then the ones who [can] draw correct conclusions from it would have known about it. And if not for the favor of Allāh upon you and His mercy, you would have followed Satan, except for a few.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"جَآءَهُمْ","translit":"ْmُhَءٓāَjg","root":"جيا"},{"id":3,"arabic":"أَمْرٌ","translit":"ٌrْmَaʾ","root":"امر"},{"id":4,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":5,"arabic":"ٱلْأَمْنِ","translit":"ِnْmَaʾْlٱ","root":"امن"},{"id":6,"arabic":"أَوِ","translit":"ِwَaʾ","root":""},{"id":7,"arabic":"ٱلْخَوْفِ","translit":"ِfْwَhkْlٱ","root":"خوف"},{"id":8,"arabic":"أَذَاعُوا۟","translit":"۟āwُʿعāَhdَaʾ","root":"ذيع"},{"id":9,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":10,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":11,"arabic":"رَدُّوهُ","translit":"ُhwُّdَr","root":"ردد"},{"id":12,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":13,"arabic":"ٱلرَّسُولِ","translit":"ِlwُsَّrlٱ","root":"رسل"},{"id":14,"arabic":"وَإِلَىٰٓ","translit":"ٰٓàَlِiʾَw","root":""},{"id":15,"arabic":"أُو۟لِى","translit":"àِl۟wُaʾ","root":""},{"id":16,"arabic":"ٱلْأَمْرِ","translit":"ِrْmَaʾْlٱ","root":"امر"},{"id":17,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":18,"arabic":"لَعَلِمَهُ","translit":"ُhَmِlَʿعَl","root":"علم"},{"id":19,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":20,"arabic":"يَسْتَنۢبِطُونَهُۥ","translit":"ۥُhَnwُṭِbۢnَtْsَy","root":"نبط"},{"id":21,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":22,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":23,"arabic":"فَضْلُ","translit":"ُlْḍَf","root":"فضل"},{"id":24,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":25,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":26,"arabic":"وَرَحْمَتُهُۥ","translit":"ۥُhُtَmْḥَrَw","root":"رحم"},{"id":27,"arabic":"لَٱتَّبَعْتُمُ","translit":"ُmُtْʿعَbَّtٱَl","root":"تبع"},{"id":28,"arabic":"ٱلشَّيْطَٰنَ","translit":"َnَٰṭْyَّhslٱ","root":"شطن"},{"id":29,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":30,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"}],"hasIhya":true},{"ayah":84,"text":"فَقَٰتِلْ فِى سَبِيلِ ٱللَّهِ لَا تُكَلَّفُ إِلَّا نَفْسَكَۚ وَحَرِّضِ ٱلْمُؤْمِنِينَۖ عَسَى ٱللَّهُ أَن يَكُفَّ بَأْسَ ٱلَّذِينَ كَفَرُوا۟ۚ وَٱللَّهُ أَشَدُّ بَأْسًا وَأَشَدُّ تَنكِيلًا ","translation":"So fight, [O Muḥammad], in the cause of Allāh; you are not held responsible except for yourself. And encourage the believers [to join you] that perhaps Allāh will restrain the [military] might of those who disbelieve. And Allāh is greater in might and stronger in [exemplary] punishment.[1]","words":[{"id":1,"arabic":"فَقَٰتِلْ","translit":"ْlِtَٰqَf","root":"قتل"},{"id":2,"arabic":"فِى","translit":"àِf","root":""},{"id":3,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"تُكَلَّفُ","translit":"ُfَّlَkُt","root":"كلف"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"نَفْسَكَ","translit":"َkَsْfَn","root":"نفس"},{"id":9,"arabic":"وَحَرِّضِ","translit":"ِḍِّrَḥَw","root":"حرض"},{"id":10,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":11,"arabic":"عَسَى","translit":"àَsَʿع","root":"عسي"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":14,"arabic":"يَكُفَّ","translit":"َّfُkَy","root":"كفف"},{"id":15,"arabic":"بَأْسَ","translit":"َsْaʾَb","root":"باس"},{"id":16,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":17,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":18,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":19,"arabic":"أَشَدُّ","translit":"ُّdَhsَaʾ","root":"شدد"},{"id":20,"arabic":"بَأْسًا","translit":"āًsْaʾَb","root":"باس"},{"id":21,"arabic":"وَأَشَدُّ","translit":"ُّdَhsَaʾَw","root":"شدد"},{"id":22,"arabic":"تَنكِيلًا","translit":"āًlyِknَt","root":"نكل"}],"hasIhya":false},{"ayah":85,"text":"مَّن يَشْفَعْ شَفَٰعَةً حَسَنَةً يَكُن لَّهُۥ نَصِيبٌ مِّنْهَاۖ وَمَن يَشْفَعْ شَفَٰعَةً سَيِّئَةً يَكُن لَّهُۥ كِفْلٌ مِّنْهَاۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ مُّقِيتًا ","translation":"Whoever intercedes for a good cause will have a share [i.e., reward] therefrom; and whoever intercedes for an evil cause will have a portion [i.e., burden] therefrom. And ever is Allāh, over all things, a Keeper.[1]","words":[{"id":1,"arabic":"مَّن","translit":"nَّm","root":""},{"id":2,"arabic":"يَشْفَعْ","translit":"ْʿعَfْhsَy","root":"شفع"},{"id":3,"arabic":"شَفَٰعَةً","translit":"ًẗَʿعَٰfَhs","root":"شفع"},{"id":4,"arabic":"حَسَنَةً","translit":"ًẗَnَsَḥ","root":"حسن"},{"id":5,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":6,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":7,"arabic":"نَصِيبٌ","translit":"ٌbyِṣَn","root":"نصب"},{"id":8,"arabic":"مِّنْهَا","translit":"āَhْnِّm","root":""},{"id":9,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":10,"arabic":"يَشْفَعْ","translit":"ْʿعَfْhsَy","root":"شفع"},{"id":11,"arabic":"شَفَٰعَةً","translit":"ًẗَʿعَٰfَhs","root":"شفع"},{"id":12,"arabic":"سَيِّئَةً","translit":"ًẗَyʾِّyَs","root":"سوا"},{"id":13,"arabic":"يَكُن","translit":"nُkَy","root":"كون"},{"id":14,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":15,"arabic":"كِفْلٌ","translit":"ٌlْfِk","root":"كفل"},{"id":16,"arabic":"مِّنْهَا","translit":"āَhْnِّm","root":""},{"id":17,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":18,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":19,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":20,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":21,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":22,"arabic":"مُّقِيتًا","translit":"āًtyِqُّm","root":"قوت"}],"hasIhya":false},{"ayah":86,"text":"وَإِذَا حُيِّيتُم بِتَحِيَّةٍ فَحَيُّوا۟ بِأَحْسَنَ مِنْهَآ أَوْ رُدُّوهَآۗ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَىْءٍ حَسِيبًا ","translation":"And when you are greeted with a greeting, greet [in return] with one better than it or [at least] return it [in a like manner]. Indeed Allāh is ever, over all things, an Accountant.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"حُيِّيتُم","translit":"mُtyِّyُḥ","root":"حيي"},{"id":3,"arabic":"بِتَحِيَّةٍ","translit":"ٍẗَّyِḥَtِb","root":"حيي"},{"id":4,"arabic":"فَحَيُّوا۟","translit":"۟āwُّyَḥَf","root":"حيي"},{"id":5,"arabic":"بِأَحْسَنَ","translit":"َnَsْḥَaʾِb","root":"حسن"},{"id":6,"arabic":"مِنْهَآ","translit":"ٓāَhْnِm","root":""},{"id":7,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":8,"arabic":"رُدُّوهَآ","translit":"ٓāَhwُّdُr","root":"ردد"},{"id":9,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":10,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":11,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":12,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":13,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":14,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":15,"arabic":"حَسِيبًا","translit":"āًbyِsَḥ","root":"حسب"}],"hasIhya":true},{"ayah":87,"text":"ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۚ لَيَجْمَعَنَّكُمْ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِ لَا رَيْبَ فِيهِۗ وَمَنْ أَصْدَقُ مِنَ ٱللَّهِ حَدِيثًا ","translation":"Allāh - there is no deity except Him. He will surely assemble you for [account on] the Day of Resurrection, about which there is no doubt. And who is more truthful than Allāh in statement.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":3,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":6,"arabic":"لَيَجْمَعَنَّكُمْ","translit":"ْmُkَّnَʿعَmْjgَyَl","root":"جمع"},{"id":7,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":8,"arabic":"يَوْمِ","translit":"ِmْwَy","root":"يوم"},{"id":9,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":10,"arabic":"لَا","translit":"āَl","root":""},{"id":11,"arabic":"رَيْبَ","translit":"َbْyَr","root":"ريب"},{"id":12,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":13,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":14,"arabic":"أَصْدَقُ","translit":"ُqَdْṣَaʾ","root":"صدق"},{"id":15,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":16,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":17,"arabic":"حَدِيثًا","translit":"āًhtyِdَḥ","root":"حدث"}],"hasIhya":false},{"ayah":88,"text":"فَمَا لَكُمْ فِى ٱلْمُنَٰفِقِينَ فِئَتَيْنِ وَٱللَّهُ أَرْكَسَهُم بِمَا كَسَبُوٓا۟ۚ أَتُرِيدُونَ أَن تَهْدُوا۟ مَنْ أَضَلَّ ٱللَّهُۖ وَمَن يُضْلِلِ ٱللَّهُ فَلَن تَجِدَ لَهُۥ سَبِيلًا ","translation":"What is [the matter] with you [that you are] two groups concerning the hypocrites,[1] while Allāh has made them fall back [into error and disbelief] for what they earned.[2] Do you wish to guide those whom Allāh has sent astray? And he whom Allāh sends astray - never will you find for him a way [of guidance].[3]","words":[{"id":1,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":2,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْمُنَٰفِقِينَ","translit":"َnyِqِfَٰnُmْlٱ","root":"نفق"},{"id":5,"arabic":"فِئَتَيْنِ","translit":"ِnْyَtَyʾِf","root":"فاي"},{"id":6,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":7,"arabic":"أَرْكَسَهُم","translit":"mُhَsَkْrَaʾ","root":"ركس"},{"id":8,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":9,"arabic":"كَسَبُوٓا۟","translit":"۟āٓwُbَsَk","root":"كسب"},{"id":10,"arabic":"أَتُرِيدُونَ","translit":"َnwُdyِrُtَaʾ","root":"رود"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"تَهْدُوا۟","translit":"۟āwُdْhَt","root":"هدي"},{"id":13,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":14,"arabic":"أَضَلَّ","translit":"َّlَḍَaʾ","root":"ضلل"},{"id":15,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":16,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":17,"arabic":"يُضْلِلِ","translit":"ِlِlْḍُy","root":"ضلل"},{"id":18,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":19,"arabic":"فَلَن","translit":"nَlَf","root":""},{"id":20,"arabic":"تَجِدَ","translit":"َdِjgَt","root":"وجد"},{"id":21,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":22,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":89,"text":"وَدُّوا۟ لَوْ تَكْفُرُونَ كَمَا كَفَرُوا۟ فَتَكُونُونَ سَوَآءًۖ فَلَا تَتَّخِذُوا۟ مِنْهُمْ أَوْلِيَآءَ حَتَّىٰ يُهَاجِرُوا۟ فِى سَبِيلِ ٱللَّهِۚ فَإِن تَوَلَّوْا۟ فَخُذُوهُمْ وَٱقْتُلُوهُمْ حَيْثُ وَجَدتُّمُوهُمْۖ وَلَا تَتَّخِذُوا۟ مِنْهُمْ وَلِيًّا وَلَا نَصِيرًا ","translation":"They wish you would disbelieve as they disbelieved so you would be alike. So do not take from among them allies until they emigrate for the cause of Allāh. But if they turn away [i.e., refuse], then seize them and kill them [for their betrayal] wherever you find them and take not from among them any ally or helper,","words":[{"id":1,"arabic":"وَدُّوا۟","translit":"۟āwُّdَw","root":"ودد"},{"id":2,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":3,"arabic":"تَكْفُرُونَ","translit":"َnwُrُfْkَt","root":"كفر"},{"id":4,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":5,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":6,"arabic":"فَتَكُونُونَ","translit":"َnwُnwُkَtَf","root":"كون"},{"id":7,"arabic":"سَوَآءً","translit":"ًءٓāَwَs","root":"سوي"},{"id":8,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":9,"arabic":"تَتَّخِذُوا۟","translit":"۟āwُhdِhkَّtَt","root":"اخذ"},{"id":10,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":11,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":12,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":13,"arabic":"يُهَاجِرُوا۟","translit":"۟āwُrِjgāَhُy","root":"هجر"},{"id":14,"arabic":"فِى","translit":"àِf","root":""},{"id":15,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":16,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":17,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":18,"arabic":"تَوَلَّوْا۟","translit":"۟āْwَّlَwَt","root":"ولي"},{"id":19,"arabic":"فَخُذُوهُمْ","translit":"ْmُhwُhdُhkَf","root":"اخذ"},{"id":20,"arabic":"وَٱقْتُلُوهُمْ","translit":"ْmُhwُlُtْqٱَw","root":"قتل"},{"id":21,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":22,"arabic":"وَجَدتُّمُوهُمْ","translit":"ْmُhwُmُّtdَjgَw","root":"وجد"},{"id":23,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":24,"arabic":"تَتَّخِذُوا۟","translit":"۟āwُhdِhkَّtَt","root":"اخذ"},{"id":25,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":26,"arabic":"وَلِيًّا","translit":"āًّyِlَw","root":"ولي"},{"id":27,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":28,"arabic":"نَصِيرًا","translit":"āًryِṣَn","root":"نصر"}],"hasIhya":true},{"ayah":90,"text":"إِلَّا ٱلَّذِينَ يَصِلُونَ إِلَىٰ قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم مِّيثَٰقٌ أَوْ جَآءُوكُمْ حَصِرَتْ صُدُورُهُمْ أَن يُقَٰتِلُوكُمْ أَوْ يُقَٰتِلُوا۟ قَوْمَهُمْۚ وَلَوْ شَآءَ ٱللَّهُ لَسَلَّطَهُمْ عَلَيْكُمْ فَلَقَٰتَلُوكُمْۚ فَإِنِ ٱعْتَزَلُوكُمْ فَلَمْ يُقَٰتِلُوكُمْ وَأَلْقَوْا۟ إِلَيْكُمُ ٱلسَّلَمَ فَمَا جَعَلَ ٱللَّهُ لَكُمْ عَلَيْهِمْ سَبِيلًا ","translation":"Except for those who take refuge with a people between yourselves and whom is a treaty or those who come to you, their hearts strained at [the prospect of] fighting you or fighting their own people. And if Allāh had willed, He could have given them power over you, and they would have fought you. So if they remove themselves from you and do not fight you and offer you peace, then Allāh has not made for you a cause [for fighting] against them.","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يَصِلُونَ","translit":"َnwُlِṣَy","root":"وصل"},{"id":4,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":5,"arabic":"قَوْمٍۭ","translit":"ٍۭmْwَq","root":"قوم"},{"id":6,"arabic":"بَيْنَكُمْ","translit":"ْmُkَnْyَb","root":"بين"},{"id":7,"arabic":"وَبَيْنَهُم","translit":"mُhَnْyَbَw","root":"بين"},{"id":8,"arabic":"مِّيثَٰقٌ","translit":"ٌqَٰhtyِّm","root":"وثق"},{"id":9,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":10,"arabic":"جَآءُوكُمْ","translit":"ْmُkwُءٓāَjg","root":"جيا"},{"id":11,"arabic":"حَصِرَتْ","translit":"ْtَrِṣَḥ","root":"حصر"},{"id":12,"arabic":"صُدُورُهُمْ","translit":"ْmُhُrwُdُṣ","root":"صدر"},{"id":13,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":14,"arabic":"يُقَٰتِلُوكُمْ","translit":"ْmُkwُlِtَٰqُy","root":"قتل"},{"id":15,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":16,"arabic":"يُقَٰتِلُوا۟","translit":"۟āwُlِtَٰqُy","root":"قتل"},{"id":17,"arabic":"قَوْمَهُمْ","translit":"ْmُhَmْwَq","root":"قوم"},{"id":18,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":19,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"لَسَلَّطَهُمْ","translit":"ْmُhَṭَّlَsَl","root":"سلط"},{"id":22,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":23,"arabic":"فَلَقَٰتَلُوكُمْ","translit":"ْmُkwُlَtَٰqَlَf","root":"قتل"},{"id":24,"arabic":"فَإِنِ","translit":"ِnِiʾَf","root":""},{"id":25,"arabic":"ٱعْتَزَلُوكُمْ","translit":"ْmُkwُlَzَtْʿعٱ","root":"عزل"},{"id":26,"arabic":"فَلَمْ","translit":"ْmَlَf","root":""},{"id":27,"arabic":"يُقَٰتِلُوكُمْ","translit":"ْmُkwُlِtَٰqُy","root":"قتل"},{"id":28,"arabic":"وَأَلْقَوْا۟","translit":"۟āْwَqْlَaʾَw","root":"لقي"},{"id":29,"arabic":"إِلَيْكُمُ","translit":"ُmُkْyَlِiʾ","root":""},{"id":30,"arabic":"ٱلسَّلَمَ","translit":"َmَlَّslٱ","root":"سلم"},{"id":31,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":32,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":33,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":34,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":35,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":36,"arabic":"سَبِيلًا","translit":"āًlyِbَs","root":"سبل"}],"hasIhya":false},{"ayah":91,"text":"سَتَجِدُونَ ءَاخَرِينَ يُرِيدُونَ أَن يَأْمَنُوكُمْ وَيَأْمَنُوا۟ قَوْمَهُمْ كُلَّ مَا رُدُّوٓا۟ إِلَى ٱلْفِتْنَةِ أُرْكِسُوا۟ فِيهَاۚ فَإِن لَّمْ يَعْتَزِلُوكُمْ وَيُلْقُوٓا۟ إِلَيْكُمُ ٱلسَّلَمَ وَيَكُفُّوٓا۟ أَيْدِيَهُمْ فَخُذُوهُمْ وَٱقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْۚ وَأُو۟لَٰٓئِكُمْ جَعَلْنَا لَكُمْ عَلَيْهِمْ سُلْطَٰنًا مُّبِينًا ","translation":"You will find others who wish to obtain security from you and [to] obtain security from their people. Every time they are returned to [the influence of] disbelief, they fall back into it. So if they do not withdraw from you or offer you peace or restrain their hands, then seize them and kill them wherever you overtake them. And those - We have made for you against them a clear authorization.","words":[{"id":1,"arabic":"سَتَجِدُونَ","translit":"َnwُdِjgَtَs","root":"وجد"},{"id":2,"arabic":"ءَاخَرِينَ","translit":"َnyِrَhkāَء","root":"اخر"},{"id":3,"arabic":"يُرِيدُونَ","translit":"َnwُdyِrُy","root":"رود"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَأْمَنُوكُمْ","translit":"ْmُkwُnَmْaʾَy","root":"امن"},{"id":6,"arabic":"وَيَأْمَنُوا۟","translit":"۟āwُnَmْaʾَyَw","root":"امن"},{"id":7,"arabic":"قَوْمَهُمْ","translit":"ْmُhَmْwَq","root":"قوم"},{"id":8,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"رُدُّوٓا۟","translit":"۟āٓwُّdُr","root":"ردد"},{"id":11,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":12,"arabic":"ٱلْفِتْنَةِ","translit":"ِẗَnْtِfْlٱ","root":"فتن"},{"id":13,"arabic":"أُرْكِسُوا۟","translit":"۟āwُsِkْrُaʾ","root":"ركس"},{"id":14,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":15,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":16,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":17,"arabic":"يَعْتَزِلُوكُمْ","translit":"ْmُkwُlِzَtْʿعَy","root":"عزل"},{"id":18,"arabic":"وَيُلْقُوٓا۟","translit":"۟āٓwُqْlُyَw","root":"لقي"},{"id":19,"arabic":"إِلَيْكُمُ","translit":"ُmُkْyَlِiʾ","root":""},{"id":20,"arabic":"ٱلسَّلَمَ","translit":"َmَlَّslٱ","root":"سلم"},{"id":21,"arabic":"وَيَكُفُّوٓا۟","translit":"۟āٓwُّfُkَyَw","root":"كفف"},{"id":22,"arabic":"أَيْدِيَهُمْ","translit":"ْmُhَyِdْyَaʾ","root":"يدي"},{"id":23,"arabic":"فَخُذُوهُمْ","translit":"ْmُhwُhdُhkَf","root":"اخذ"},{"id":24,"arabic":"وَٱقْتُلُوهُمْ","translit":"ْmُhwُlُtْqٱَw","root":"قتل"},{"id":25,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":26,"arabic":"ثَقِفْتُمُوهُمْ","translit":"ْmُhwُmُtْfِqَht","root":"ثقف"},{"id":27,"arabic":"وَأُو۟لَٰٓئِكُمْ","translit":"ْmُkِyʾَٰٓl۟wُaʾَw","root":""},{"id":28,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":29,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":30,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":31,"arabic":"سُلْطَٰنًا","translit":"āًnَٰṭْlُs","root":"سلط"},{"id":32,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":92,"text":"وَمَا كَانَ لِمُؤْمِنٍ أَن يَقْتُلَ مُؤْمِنًا إِلَّا خَطَـًٔاۚ وَمَن قَتَلَ مُؤْمِنًا خَطَـًٔا فَتَحْرِيرُ رَقَبَةٍ مُّؤْمِنَةٍ وَدِيَةٌ مُّسَلَّمَةٌ إِلَىٰٓ أَهْلِهِۦٓ إِلَّآ أَن يَصَّدَّقُوا۟ۚ فَإِن كَانَ مِن قَوْمٍ عَدُوٍّ لَّكُمْ وَهُوَ مُؤْمِنٌ فَتَحْرِيرُ رَقَبَةٍ مُّؤْمِنَةٍۖ وَإِن كَانَ مِن قَوْمٍۭ بَيْنَكُمْ وَبَيْنَهُم مِّيثَٰقٌ فَدِيَةٌ مُّسَلَّمَةٌ إِلَىٰٓ أَهْلِهِۦ وَتَحْرِيرُ رَقَبَةٍ مُّؤْمِنَةٍۖ فَمَن لَّمْ يَجِدْ فَصِيَامُ شَهْرَيْنِ مُتَتَابِعَيْنِ تَوْبَةً مِّنَ ٱللَّهِۗ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ","translation":"And never is it for a believer to kill a believer except by mistake. And whoever kills a believer by mistake - then the freeing of a believing slave and a compensation payment [diyah] presented to his [i.e., the deceased's] family [is required], unless they give [up their right as] charity. But if he [i.e., the deceased] was from a people at war with you and he was a believer - then [only] the freeing of a believing slave; and if he was from a people with whom you have a treaty - then a compensation payment presented to his family and the freeing of a believing slave. And whoever does not find [one or cannot afford to buy one] - then [instead], a fast for two months consecutively,[1] [seeking] acceptance of repentance from Allāh.[2] And Allāh is ever Knowing and Wise.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":3,"arabic":"لِمُؤْمِنٍ","translit":"ٍnِmْwʾُmِl","root":"امن"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يَقْتُلَ","translit":"َlُtْqَy","root":"قتل"},{"id":6,"arabic":"مُؤْمِنًا","translit":"āًnِmْwʾُm","root":"امن"},{"id":7,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":8,"arabic":"خَطَـًٔا","translit":"āًٔـَṭَhk","root":"خطا"},{"id":9,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":10,"arabic":"قَتَلَ","translit":"َlَtَq","root":"قتل"},{"id":11,"arabic":"مُؤْمِنًا","translit":"āًnِmْwʾُm","root":"امن"},{"id":12,"arabic":"خَطَـًٔا","translit":"āًٔـَṭَhk","root":"خطا"},{"id":13,"arabic":"فَتَحْرِيرُ","translit":"ُryِrْḥَtَf","root":"حرر"},{"id":14,"arabic":"رَقَبَةٍ","translit":"ٍẗَbَqَr","root":"رقب"},{"id":15,"arabic":"مُّؤْمِنَةٍ","translit":"ٍẗَnِmْwʾُّm","root":"امن"},{"id":16,"arabic":"وَدِيَةٌ","translit":"ٌẗَyِdَw","root":"ودي"},{"id":17,"arabic":"مُّسَلَّمَةٌ","translit":"ٌẗَmَّlَsُّm","root":"سلم"},{"id":18,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":19,"arabic":"أَهْلِهِۦٓ","translit":"ٓۦِhِlْhَaʾ","root":"اهل"},{"id":20,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":21,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":22,"arabic":"يَصَّدَّقُوا۟","translit":"۟āwُqَّdَّṣَy","root":"صدق"},{"id":23,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":24,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":25,"arabic":"مِن","translit":"nِm","root":""},{"id":26,"arabic":"قَوْمٍ","translit":"ٍmْwَq","root":"قوم"},{"id":27,"arabic":"عَدُوٍّ","translit":"ٍّwُdَʿع","root":"عدو"},{"id":28,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":29,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":30,"arabic":"مُؤْمِنٌ","translit":"ٌnِmْwʾُm","root":"امن"},{"id":31,"arabic":"فَتَحْرِيرُ","translit":"ُryِrْḥَtَf","root":"حرر"},{"id":32,"arabic":"رَقَبَةٍ","translit":"ٍẗَbَqَr","root":"رقب"},{"id":33,"arabic":"مُّؤْمِنَةٍ","translit":"ٍẗَnِmْwʾُّm","root":"امن"},{"id":34,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":35,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":36,"arabic":"مِن","translit":"nِm","root":""},{"id":37,"arabic":"قَوْمٍۭ","translit":"ٍۭmْwَq","root":"قوم"},{"id":38,"arabic":"بَيْنَكُمْ","translit":"ْmُkَnْyَb","root":"بين"},{"id":39,"arabic":"وَبَيْنَهُم","translit":"mُhَnْyَbَw","root":"بين"},{"id":40,"arabic":"مِّيثَٰقٌ","translit":"ٌqَٰhtyِّm","root":"وثق"},{"id":41,"arabic":"فَدِيَةٌ","translit":"ٌẗَyِdَf","root":"ودي"},{"id":42,"arabic":"مُّسَلَّمَةٌ","translit":"ٌẗَmَّlَsُّm","root":"سلم"},{"id":43,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":44,"arabic":"أَهْلِهِۦ","translit":"ۦِhِlْhَaʾ","root":"اهل"},{"id":45,"arabic":"وَتَحْرِيرُ","translit":"ُryِrْḥَtَw","root":"حرر"},{"id":46,"arabic":"رَقَبَةٍ","translit":"ٍẗَbَqَr","root":"رقب"},{"id":47,"arabic":"مُّؤْمِنَةٍ","translit":"ٍẗَnِmْwʾُّm","root":"امن"},{"id":48,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":49,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":50,"arabic":"يَجِدْ","translit":"ْdِjgَy","root":"وجد"},{"id":51,"arabic":"فَصِيَامُ","translit":"ُmāَyِṣَf","root":"صوم"},{"id":52,"arabic":"شَهْرَيْنِ","translit":"ِnْyَrْhَhs","root":"شهر"},{"id":53,"arabic":"مُتَتَابِعَيْنِ","translit":"ِnْyَʿعِbāَtَtُm","root":"تبع"},{"id":54,"arabic":"تَوْبَةً","translit":"ًẗَbْwَt","root":"توب"},{"id":55,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":56,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":57,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":58,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":59,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"},{"id":60,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":93,"text":"وَمَن يَقْتُلْ مُؤْمِنًا مُّتَعَمِّدًا فَجَزَآؤُهُۥ جَهَنَّمُ خَٰلِدًا فِيهَا وَغَضِبَ ٱللَّهُ عَلَيْهِ وَلَعَنَهُۥ وَأَعَدَّ لَهُۥ عَذَابًا عَظِيمًا ","translation":"But whoever kills a believer intentionally - his recompense is Hell, wherein he will abide eternally, and Allāh has become angry with him and has cursed him and has prepared for him a great punishment.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَقْتُلْ","translit":"ْlُtْqَy","root":"قتل"},{"id":3,"arabic":"مُؤْمِنًا","translit":"āًnِmْwʾُm","root":"امن"},{"id":4,"arabic":"مُّتَعَمِّدًا","translit":"āًdِّmَʿعَtُّm","root":"عمد"},{"id":5,"arabic":"فَجَزَآؤُهُۥ","translit":"ۥُhُwʾٓāَzَjgَf","root":"جزي"},{"id":6,"arabic":"جَهَنَّمُ","translit":"ُmَّnَhَjg","root":""},{"id":7,"arabic":"خَٰلِدًا","translit":"āًdِlَٰhk","root":"خلد"},{"id":8,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":9,"arabic":"وَغَضِبَ","translit":"َbِḍَغَw","root":"غضب"},{"id":10,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":11,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":12,"arabic":"وَلَعَنَهُۥ","translit":"ۥُhَnَʿعَlَw","root":"لعن"},{"id":13,"arabic":"وَأَعَدَّ","translit":"َّdَʿعَaʾَw","root":"عدد"},{"id":14,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":15,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":16,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":94,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا ضَرَبْتُمْ فِى سَبِيلِ ٱللَّهِ فَتَبَيَّنُوا۟ وَلَا تَقُولُوا۟ لِمَنْ أَلْقَىٰٓ إِلَيْكُمُ ٱلسَّلَٰمَ لَسْتَ مُؤْمِنًا تَبْتَغُونَ عَرَضَ ٱلْحَيَوٰةِ ٱلدُّنْيَا فَعِندَ ٱللَّهِ مَغَانِمُ كَثِيرَةٌۚ كَذَٰلِكَ كُنتُم مِّن قَبْلُ فَمَنَّ ٱللَّهُ عَلَيْكُمْ فَتَبَيَّنُوٓا۟ۚ إِنَّ ٱللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا ","translation":"O you who have believed, when you go forth [to fight] in the cause of Allāh, investigate; and do not say to one who gives you [a greeting of] peace, \"You are not a believer,\"[1] aspiring for the goods of worldly life; for with Allāh are many acquisitions. You [yourselves] were like that before; then Allāh conferred His favor [i.e., guidance] upon you, so investigate. Indeed Allāh is ever, of what you do, Aware.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":4,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":5,"arabic":"ضَرَبْتُمْ","translit":"ْmُtْbَrَḍ","root":"ضرب"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"فَتَبَيَّنُوا۟","translit":"۟āwُnَّyَbَtَf","root":"بين"},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"تَقُولُوا۟","translit":"۟āwُlwُqَt","root":"قول"},{"id":12,"arabic":"لِمَنْ","tr