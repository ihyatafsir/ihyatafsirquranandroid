 "arabic": "نَصِيراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 4, "ayah": 90, "text": "اِلَّا اَ۬لذِينَ يَصِلُونَ إِلَيٰ قَوْمِۢ بَيْنَكُمْ وَبَيْنَهُم مِّيثَٰقٌ اَوْ جَآءُوكُمْۖ حَصِرَتْ صُدُورُهُمُۥٓ أَنْ يُّقَٰتِلُوكُمُۥٓ أَوْ يُقَٰتِلُواْ قَوْمَهُمْۖ وَلَوْ شَآءَ اَ۬للَّهُ لَسَلَّطَهُمْ عَلَيْكُمْ فَلَقَٰتَلُوكُمْۖ فَإِنِ اِ۪عْتَزَلُوكُمْ فَلَمْ يُقَٰتِلُوكُمْ وَأَلْقَوِاْ اِلَيْكُمُ اُ۬لسَّلَمَ فَمَا جَعَلَ اَ۬للَّهُ لَكُمْ عَلَيْهِمْ سَبِيلاࣰۖ", "words": [{"id": 1, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَصِلُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمِۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْنَكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَبَيْنَهُم", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّيثَٰقٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 10, "arabic": "جَآءُوكُمْۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "حَصِرَتْ", "translit": "", "root": ""}, {"id": 12, "arabic": "صُدُورُهُمُۥٓ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 14, "arabic": "يُّقَٰتِلُوكُمُۥٓ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 16, "arabic": "يُقَٰتِلُواْ", "translit": "", "root": ""}, {"id": 17, "arabic": "قَوْمَهُمْۖ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 19, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 21, "arabic": "لَسَلَّطَهُمْ", "translit": "", "root": ""}, {"id": 22, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 23, "arabic": "فَلَقَٰتَلُوكُمْۖ", "translit": "", "root": ""}, {"id": 24, "arabic": "فَإِنِ", "translit": "", "root":