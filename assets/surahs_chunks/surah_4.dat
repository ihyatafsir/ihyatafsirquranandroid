"translit":"āَnْyَtāَءَw","root":"اتي"},{"id":35,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":36,"arabic":"سُلْطَٰنًا","translit":"āًnَٰṭْlُs","root":"سلط"},{"id":37,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":154,"text":"وَرَفَعْنَا فَوْقَهُمُ ٱلطُّورَ بِمِيثَٰقِهِمْ وَقُلْنَا لَهُمُ ٱدْخُلُوا۟ ٱلْبَابَ سُجَّدًا وَقُلْنَا لَهُمْ لَا تَعْدُوا۟ فِى ٱلسَّبْتِ وَأَخَذْنَا مِنْهُم مِّيثَٰقًا غَلِيظًا ","translation":"And We raised over them the mount for [refusal of] their covenant; and We said to them, \"Enter the gate bowing humbly\"; and We said to them, \"Do not transgress on the sabbath\"; and We took from them a solemn covenant.","words":[{"id":1,"arabic":"وَرَفَعْنَا","translit":"āَnْʿعَfَrَw","root":"رفع"},{"id":2,"arabic":"فَوْقَهُمُ","translit":"ُmُhَqْwَf","root":"فوق"},{"id":3,"arabic":"ٱلطُّورَ","translit":"َrwُّṭlٱ","root":"طور"},{"id":4,"arabic":"بِمِيثَٰقِهِمْ","translit":"ْmِhِqَٰhtyِmِb","root":"وثق"},{"id":5,"arabic":"وَقُلْنَا","translit":"āَnْlُqَw","root":"قول"},{"id":6,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":7,"arabic":"ٱدْخُلُوا۟","translit":"۟āwُlُhkْdٱ","root":"دخل"},{"id":8,"arabic":"ٱلْبَابَ","translit":"َbāَbْlٱ","root":"بوب"},{"id":9,"arabic":"سُجَّدًا","translit":"āًdَّjgُs","root":"سجد"},{"id":10,"arabic":"وَقُلْنَا","translit":"āَnْlُqَw","root":"قول"},{"id":11,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":12,"arabic":"لَا","translit":"āَl","root":""},{"id":13,"arabic":"تَعْدُوا۟","translit":"۟āwُdْʿعَt","root":"عدو"},{"id":14,"arabic":"فِى","translit":"àِf","root":""},{"id":15,"arabic":"ٱلسَّبْتِ","translit":"ِtْbَّslٱ","root":"سبت"},{"id":16,"arabic":"وَأَخَذْنَا","translit":"āَnْhdَhkَaʾَw","root":"اخذ"},{"id":17,"arabic":"مِنْهُم","translit":"mُhْnِm","root":""},{"id":18,"arabic":"مِّيثَٰقًا","translit":"āًqَٰhtyِّm","root":"وثق"},{"id":19,"arabic":"غَلِيظًا","translit":"āًẓyِlَغ","root":"غلظ"}],"hasIhya":false},{"ayah":155,"text":"فَبِمَا نَقْضِهِم مِّيثَٰقَهُمْ وَكُفْرِهِم بِـَٔايَٰتِ ٱللَّهِ وَقَتْلِهِمُ ٱلْأَنۢبِيَآءَ بِغَيْرِ حَقٍّ وَقَوْلِهِمْ قُلُوبُنَا غُلْفٌۢۚ بَلْ طَبَعَ ٱللَّهُ عَلَيْهَا بِكُفْرِهِمْ فَلَا يُؤْمِنُونَ إِلَّا قَلِيلًا ","translation":"And [We cursed them][1] for their breaking of the covenant and their disbelief in the signs of Allāh and their killing of the prophets without right and their saying, \"Our hearts are wrapped\" [i.e., sealed against reception]. Rather, Allāh has sealed them because of their disbelief, so they believe not, except for a few.[2]","words":[{"id":1,"arabic":"فَبِمَا","translit":"āَmِbَf","root":""},{"id":2,"arabic":"نَقْضِهِم","translit":"mِhِḍْqَn","root":"نقض"},{"id":3,"arabic":"مِّيثَٰقَهُمْ","translit":"ْmُhَqَٰhtyِّm","root":"وثق"},{"id":4,"arabic":"وَكُفْرِهِم","translit":"mِhِrْfُkَw","root":"كفر"},{"id":5,"arabic":"بِـَٔايَٰتِ","translit":"ِtَٰyāَٔـِb","root":"ايي"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"وَقَتْلِهِمُ","translit":"ُmِhِlْtَqَw","root":"قتل"},{"id":8,"arabic":"ٱلْأَنۢبِيَآءَ","translit":"َءٓāَyِbۢnَaʾْlٱ","root":"نبا"},{"id":9,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":10,"arabic":"حَقٍّ","translit":"ٍّqَḥ","root":"حقق"},{"id":11,"arabic":"وَقَوْلِهِمْ","translit":"ْmِhِlْwَqَw","root":"قول"},{"id":12,"arabic":"قُلُوبُنَا","translit":"āَnُbwُlُq","root":"قلب"},{"id":13,"arabic":"غُلْفٌۢ","translit":"ٌۢfْlُغ","root":"غلف"},{"id":14,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":15,"arabic":"طَبَعَ","translit":"َʿعَbَṭ","root":"طبع"},{"id":16,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":17,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":18,"arabic":"بِكُفْرِهِمْ","translit":"ْmِhِrْfُkِb","root":"كفر"},{"id":19,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":20,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":21,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":22,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"}],"hasIhya":false},{"ayah":156,"text":"وَبِكُفْرِهِمْ وَقَوْلِهِمْ عَلَىٰ مَرْيَمَ بُهْتَٰنًا عَظِيمًا ","translation":"And [We cursed them] for their disbelief and their saying against Mary a great slander[1]","words":[{"id":1,"arabic":"وَبِكُفْرِهِمْ","translit":"ْmِhِrْfُkِbَw","root":"كفر"},{"id":2,"arabic":"وَقَوْلِهِمْ","translit":"ْmِhِlْwَqَw","root":"قول"},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"مَرْيَمَ","translit":"َmَyْrَm","root":""},{"id":5,"arabic":"بُهْتَٰنًا","translit":"āًnَٰtْhُb","root":"بهت"},{"id":6,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":157,"text":"وَقَوْلِهِمْ إِنَّا قَتَلْنَا ٱلْمَسِيحَ عِيسَى ٱبْنَ مَرْيَمَ رَسُولَ ٱللَّهِ وَمَا قَتَلُوهُ وَمَا صَلَبُوهُ وَلَٰكِن شُبِّهَ لَهُمْۚ وَإِنَّ ٱلَّذِينَ ٱخْتَلَفُوا۟ فِيهِ لَفِى شَكٍّ مِّنْهُۚ مَا لَهُم بِهِۦ مِنْ عِلْمٍ إِلَّا ٱتِّبَاعَ ٱلظَّنِّۚ وَمَا قَتَلُوهُ يَقِينًۢا ","translation":"And [for] their saying, \"Indeed, we have killed the Messiah, Jesus the son of Mary, the messenger of Allāh.\" And they did not kill him, nor did they crucify him; but [another] was made to resemble him to them. And indeed, those who differ over it are in doubt about it. They have no knowledge of it except the following of assumption. And they did not kill him, for certain.[1]","words":[{"id":1,"arabic":"وَقَوْلِهِمْ","translit":"ْmِhِlْwَqَw","root":"قول"},{"id":2,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":3,"arabic":"قَتَلْنَا","translit":"āَnْlَtَq","root":"قتل"},{"id":4,"arabic":"ٱلْمَسِيحَ","translit":"َḥyِsَmْlٱ","root":"مسح"},{"id":5,"arabic":"عِيسَى","translit":"àَsyِʿع","root":""},{"id":6,"arabic":"ٱبْنَ","translit":"َnْbٱ","root":"بني"},{"id":7,"arabic":"مَرْيَمَ","translit":"َmَyْrَm","root":""},{"id":8,"arabic":"رَسُولَ","translit":"َlwُsَr","root":"رسل"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":11,"arabic":"قَتَلُوهُ","translit":"ُhwُlَtَq","root":"قتل"},{"id":12,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":13,"arabic":"صَلَبُوهُ","translit":"ُhwُbَlَṣ","root":"صلب"},{"id":14,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":15,"arabic":"شُبِّهَ","translit":"َhِّbُhs","root":"شبه"},{"id":16,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":17,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":18,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":19,"arabic":"ٱخْتَلَفُوا۟","translit":"۟āwُfَlَtْhkٱ","root":"خلف"},{"id":20,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":21,"arabic":"لَفِى","translit":"àِfَl","root":""},{"id":22,"arabic":"شَكٍّ","translit":"ٍّkَhs","root":"شكك"},{"id":23,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":24,"arabic":"مَا","translit":"āَm","root":""},{"id":25,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":26,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":27,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":28,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":29,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":30,"arabic":"ٱتِّبَاعَ","translit":"َʿعāَbِّtٱ","root":"تبع"},{"id":31,"arabic":"ٱلظَّنِّ","translit":"ِّnَّẓlٱ","root":"ظنن"},{"id":32,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":33,"arabic":"قَتَلُوهُ","translit":"ُhwُlَtَq","root":"قتل"},{"id":34,"arabic":"يَقِينًۢا","translit":"āًۢnyِqَy","root":"يقن"}],"hasIhya":false},{"ayah":158,"text":"بَل رَّفَعَهُ ٱللَّهُ إِلَيْهِۚ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا ","translation":"Rather, Allāh raised him to Himself. And ever is Allāh Exalted in Might and Wise.","words":[{"id":1,"arabic":"بَل","translit":"lَb","root":""},{"id":2,"arabic":"رَّفَعَهُ","translit":"ُhَʿعَfَّr","root":"رفع"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":5,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"عَزِيزًا","translit":"āًzyِzَʿع","root":"عزز"},{"id":8,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":159,"text":"وَإِن مِّنْ أَهْلِ ٱلْكِتَٰبِ إِلَّا لَيُؤْمِنَنَّ بِهِۦ قَبْلَ مَوْتِهِۦۖ وَيَوْمَ ٱلْقِيَٰمَةِ يَكُونُ عَلَيْهِمْ شَهِيدًا ","translation":"And there is none from the People of the Scripture but that he will surely believe in him [i.e., Jesus] before his death.[1] And on the Day of Resurrection he will be against them a witness.","words":[{"id":1,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":2,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":3,"arabic":"أَهْلِ","translit":"ِlْhَaʾ","root":"اهل"},{"id":4,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"لَيُؤْمِنَنَّ","translit":"َّnَnِmْwʾُyَl","root":"امن"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"قَبْلَ","translit":"َlْbَq","root":"قبل"},{"id":9,"arabic":"مَوْتِهِۦ","translit":"ۦِhِtْwَm","root":"موت"},{"id":10,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":11,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":12,"arabic":"يَكُونُ","translit":"ُnwُkَy","root":"كون"},{"id":13,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":14,"arabic":"شَهِيدًا","translit":"āًdyِhَhs","root":"شهد"}],"hasIhya":false},{"ayah":160,"text":"فَبِظُلْمٍ مِّنَ ٱلَّذِينَ هَادُوا۟ حَرَّمْنَا عَلَيْهِمْ طَيِّبَٰتٍ أُحِلَّتْ لَهُمْ وَبِصَدِّهِمْ عَن سَبِيلِ ٱللَّهِ كَثِيرًا ","translation":"For wrongdoing on the part of the Jews, We made unlawful for them [certain] good foods which had been lawful to them, and for their averting from the way of Allāh many [people],","words":[{"id":1,"arabic":"فَبِظُلْمٍ","translit":"ٍmْlُẓِbَf","root":"ظلم"},{"id":2,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"هَادُوا۟","translit":"