ranslit":"َlāَq","root":"قول"},{"id":2,"arabic":"فَإِنَّهَا","translit":"āَhَّnِiʾَf","root":""},{"id":3,"arabic":"مُحَرَّمَةٌ","translit":"ٌẗَmَّrَḥُm","root":"حرم"},{"id":4,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":5,"arabic":"أَرْبَعِينَ","translit":"َnyِʿعَbْrَaʾ","root":"ربع"},{"id":6,"arabic":"سَنَةً","translit":"ًẗَnَs","root":"سنو"},{"id":7,"arabic":"يَتِيهُونَ","translit":"َnwُhyِtَy","root":"تيه"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":10,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":11,"arabic":"تَأْسَ","translit":"َsْaʾَt","root":"اسو"},{"id":12,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":13,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":14,"arabic":"ٱلْفَٰسِقِينَ","translit":"َnyِqِsَٰfْlٱ","root":"فسق"}],"hasIhya":false},{"ayah":27,"text":"وَٱتْلُ عَلَيْهِمْ نَبَأَ ٱبْنَىْ ءَادَمَ بِٱلْحَقِّ إِذْ قَرَّبَا قُرْبَانًا فَتُقُبِّلَ مِنْ أَحَدِهِمَا وَلَمْ يُتَقَبَّلْ مِنَ ٱلْءَاخَرِ قَالَ لَأَقْتُلَنَّكَۖ قَالَ إِنَّمَا يَتَقَبَّلُ ٱللَّهُ مِنَ ٱلْمُتَّقِينَ ","translation":"And recite to them the story of Adam's two sons, in truth, when they both made an offering [to Allāh], and it was accepted from one of them but was not accepted from the other. Said [the latter], \"I will surely kill you.\" Said [the former], \"Indeed, Allāh only accepts from the righteous [who fear Him].","words":[{"id":1,"arabic":"وَٱتْلُ","translit":"ُlْtٱَw","root":"تلو"},{"id":2,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":3,"arabic":"نَبَأَ","translit":"َaʾَbَn","root":"نبا"},{"id":4,"arabic":"ٱبْنَىْ","translit":"ْàَnْbٱ","root":"بني"},{"id":5,"arabic":"ءَادَمَ","translit":"َmَdāَء","root":"ادم"},{"id":6,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":7,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":8,"arabic":"قَرَّبَا","translit":"āَbَّrَq","root":"قرب"},{"id":9,"arabic":"قُرْبَانًا","translit":"āًnāَbْrُq","root":"قرب"},{"id":10,"arabic":"فَتُقُبِّلَ","translit":"َlِّbُqُtَf","root":"قبل"},{"id":11,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":12,"arabic":"أَحَدِهِمَا","translit":"āَmِhِdَḥَaʾ","root":"احد"},{"id":13,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":14,"arabic":"يُتَقَبَّلْ","translit":"ْlَّbَqَtُy","root":"قبل"},{"id":15,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":16,"arabic":"ٱلْءَاخَرِ","translit":"ِrَhkāَءْlٱ","root":"اخر"},{"id":17,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":18,"arabic":"لَأَقْتُلَنَّكَ","translit":"َkَّnَlُtْqَaʾَl","root":"قتل"},{"id":19,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":20,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":21,"arabic":"يَتَقَبَّلُ","translit":"ُlَّbَqَtَy","root":"قبل"},{"id":22,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":23,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":24,"arabic":"ٱلْمُتَّقِينَ","translit":"َnyِqَّtُmْlٱ","root":"وقي"}],"hasIhya":true},{"ayah":28,"text":"لَئِنۢ بَسَطتَ إِلَىَّ يَدَكَ لِتَقْتُلَنِى مَآ أَنَا۠ بِبَاسِطٍ يَدِىَ إِلَيْكَ لِأَقْتُلَكَۖ إِنِّىٓ أَخَافُ ٱللَّهَ رَبَّ ٱلْعَٰلَمِينَ ","translation":"If you should raise your hand toward me to kill me - I shall not raise my hand toward you to kill you. Indeed, I fear Allāh, Lord of the worlds.","words":[{"id":1,"arabic":"لَئِنۢ","translit":"ۢnِyʾَl","root":""},{"id":2,"arabic":"بَسَطتَ","translit":"َtṭَsَb","root":"بسط"},{"id":3,"arabic":"إِلَىَّ","translit":"َّàَlِiʾ","root":""},{"id":4,"arabic":"يَدَكَ","translit":"َkَdَy","root":"يدي"},{"id":5,"arabic":"لِتَقْتُلَنِى","translit":"àِnَlُtْqَtِl","root":"قتل"},{"id":6,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":7,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":8,"arabic":"بِبَاسِطٍ","translit":"ٍṭِsāَbِb","root":"بسط"},{"id":9,"arabic":"يَدِىَ","translit":"َàِdَy","root":"يدي"},{"id":10,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":11,"arabic":"لِأَقْتُلَكَ","tran