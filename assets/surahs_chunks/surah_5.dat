d": 14, "arabic": "رَّحِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 5, "ayah": 40, "text": "اَلَمْ تَعْلَمَ اَنَّ اَ۬للَّهَ لَهُۥ مُلْكُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِۖ يُعَذِّبُ مَنْ يَّشَآءُ وَيَغْفِرُ لِمَنْ يَّشَآءُۖ وَاللَّهُ عَلَيٰ كُلِّ شَےْءࣲ قَدِيرࣱۖ", "words": [{"id": 1, "arabic": "اَلَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَعْلَمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُلْكُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَالَارْضِۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُعَذِّبُ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَّشَآءُ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَيَغْفِرُ", "translit": "", "root": ""}, {"id": 13, "arabic": "لِمَنْ", "translit": "", "root": ""}, {"id": 14, "arabic": "يَّشَآءُۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 18, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 19, "arabic": "قَدِيرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 5, "ayah": 41, "text": "۞يَٰٓأَيُّهَا اَ۬لرَّسُولُ لَا يُحْزِنكَ اَ۬لذِينَ يُسَٰرِعُونَ فِے اِ۬لْكُفْرِ مِنَ اَ۬لذِينَ قَالُوٓاْ ءَامَنَّا بِأَفْوَٰهِهِمْ وَلَمْ تُومِن قُلُوبُهُمْۖ وَمِنَ اَ۬لذِينَ هَادُواْ سَمَّٰعُونَ لِلْكَذِبِ سَمَّٰعُونَ لِقَوْمٍ اٰخَرِينَ لَمْ يَاتُوكَۖ يُحَرِّفُونَ اَ۬لْكَلِمَ مِنۢ بَعْدِ مَوَاضِعِهِۦ يَقُولُونَ إِنُ اُوتِيتُمْ هَٰذَا فَخُذُوهُ وَإِن لَّمْ تُوتَوْهُ فَاحْذَرُواْۖ وَمَنْ يُّرِدِ اِ۬للَّهُ فِتْنَتَهُۥ فَلَن تَمْلِكَ لَهُۥ مِنَ اَ۬للَّهِ شَئْاًۖ ا۟وْلَٰٓئِكَ