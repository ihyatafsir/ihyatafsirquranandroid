"},{"id":16,"arabic":"كَثِيرٍ","translit":"ٍryِhtَk","root":"كثر"},{"id":17,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":18,"arabic":"جَآءَكُم","translit":"mُkَءٓāَjg","root":"جيا"},{"id":19,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":20,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":21,"arabic":"نُورٌ","translit":"ٌrwُn","root":"نور"},{"id":22,"arabic":"وَكِتَٰبٌ","translit":"ٌbَٰtِkَw","root":"كتب"},{"id":23,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":16,"text":"يَهْدِى بِهِ ٱللَّهُ مَنِ ٱتَّبَعَ رِضْوَٰنَهُۥ سُبُلَ ٱلسَّلَٰمِ وَيُخْرِجُهُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِ بِإِذْنِهِۦ وَيَهْدِيهِمْ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ","translation":"By which Allāh guides those who pursue His pleasure to the ways of peace[1] and brings them out from darknesses into the light, by His permission, and guides them to a straight path.","words":[{"id":1,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":2,"arabic":"بِهِ","translit":"ِhِb","root":""},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"مَنِ","translit":"ِnَm","root":""},{"id":5,"arabic":"ٱتَّبَعَ","translit":"َʿعَbَّtٱ","root":"تبع"},{"id":6,"arabic":"رِضْوَٰنَهُۥ","translit":"ۥُhَnَٰwْḍِr","root":"رضو"},{"id":7,"arabic":"سُبُلَ","translit":"َlُbُs","root":"سبل"},{"id":8,"arabic":"ٱلسَّلَٰمِ","translit":"ِmَٰlَّslٱ","root":"سلم"},{"id":9,"arabic":"وَيُخْرِجُهُم","translit":"mُhُjgِrْhkُyَw","root":"خرج"},{"id":10,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":11,"arabic":"ٱلظُّلُمَٰتِ","translit":"ِtَٰmُlُّẓlٱ","root":"ظلم"},{"id":12,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":13,"arabic":"ٱلنُّورِ","translit":"ِrwُّnlٱ","root":"نور"},{"id":14,"arabic":"بِإِذْنِهِۦ","translit":"ۦِhِnْhdِiʾِb","root":"اذن"},{"id":15,"arabic":"وَيَهْدِيهِمْ","translit":"ْmِhyِdْhَyَw","root":"هدي"},{"id":16,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":17,"arabic":"صِرَٰطٍ","translit":"ٍṭَٰrِṣ","root":"صرط"},{"id":18,"arabic":"مُّسْتَقِيمٍ","translit":"ٍmyِqَtْsُّm","root":"قوم"}],"hasIhya":true},{"ayah":17,"text":"لَّقَدْ كَفَرَ ٱلَّذِينَ قَالُوٓا۟ إِنَّ ٱللَّهَ هُوَ ٱلْمَسِيحُ ٱبْنُ مَرْيَمَۚ قُلْ فَمَن يَمْلِكُ مِنَ ٱللَّهِ شَيْـًٔا إِنْ أَرَادَ أَن يُهْلِكَ ٱلْمَسِيحَ ٱبْنَ مَرْيَمَ وَأُمَّهُۥ وَمَن فِى ٱلْأَرْضِ جَمِيعًاۗ وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَاۚ يَخْلُقُ مَا يَشَآءُۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ","translation":"They have certainly disbelieved who say that Allāh is Christ, the son of Mary. Say, \"Then who could prevent Allāh at all if He had intended to destroy Christ, the son of Mary, or his mother or everyone on the earth?\" And to Allāh belongs the dominion of the heavens and the earth and whatever is between them. He creates what He wills, and Allāh is over all things competent.","words":[{"id":1,"arabic":"لَّقَدْ","translit":"ْdَqَّl","root":""},{"id":2,"arabic":"كَفَرَ","translit":"َrَfَk","root":"كفر"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":5,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":8,"arabic":"ٱلْمَسِيحُ","translit":"ُḥyِsَmْlٱ","root":"مسح"},{"id":9,"arabic":"ٱبْنُ","translit":"ُnْbٱ","root":"بني"},{"id":10,"arabic":"مَرْيَمَ","translit":"َmَyْrَm","root":""},{"id":11,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":12,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":13,"arabic":"يَمْلِكُ","translit":"ُkِlْmَy","root":"ملك"},{"id":14,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":15,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":16,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":17,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":18,"arabic":"أَرَادَ","translit":"َdāَrَaʾ","root":"رود"},{"id":19,"arabic":"أَن","translit":"nَaʾ","root":""},