arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":12,"arabic":"مُّقِيمٌ","translit":"ٌmyِqُّm","root":"قوم"}],"hasIhya":false},{"ayah":38,"text":"وَٱلسَّارِقُ وَٱلسَّارِقَةُ فَٱقْطَعُوٓا۟ أَيْدِيَهُمَا جَزَآءًۢ بِمَا كَسَبَا نَكَٰلًا مِّنَ ٱللَّهِۗ وَٱللَّهُ عَزِيزٌ حَكِيمٌ ","translation":"[As for] the thief, the male and the female, amputate their hands in recompense for what they earned [i.e., committed] as a deterrent [punishment] from Allāh. And Allāh is Exalted in Might and Wise.","words":[{"id":1,"arabic":"وَٱلسَّارِقُ","translit":"ُqِrāَّslٱَw","root":"سرق"},{"id":2,"arabic":"وَٱلسَّارِقَةُ","translit":"ُẗَqِrāَّslٱَw","root":"سرق"},{"id":3,"arabic":"فَٱقْطَعُوٓا۟","translit":"۟āٓwُʿعَṭْqٱَf","root":"قطع"},{"id":4,"arabic":"أَيْدِيَهُمَا","translit":"āَmُhَyِdْyَaʾ","root":"يدي"},{"id":5,"arabic":"جَزَآءًۢ","translit":"ًۢءٓāَzَjg","root":"جزي"},{"id":6,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":7,"arabic":"كَسَبَا","translit":"āَbَsَk","root":"كسب"},{"id":8,"arabic":"نَكَٰلًا","translit":"āًlَٰkَn","root":"نكل"},{"id":9,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":12,"arabic":"عَزِيزٌ","translit":"ٌzyِzَʿع","root":"عزز"},{"id":13,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":39,"text":"فَمَن تَابَ مِنۢ بَعْدِ ظُلْمِهِۦ وَأَصْلَحَ فَإِنَّ ٱللَّهَ يَتُوبُ عَلَيْهِۗ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ","translation":"But whoever repents after his wrongdoing and reforms, indeed, Allāh will turn to him in forgiveness. Indeed, Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":2,"arabic":"تَابَ","translit":"َbāَt","root":"توب"},{"id":3,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":4,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":5,"arabic":"ظُلْمِهِۦ","translit":"ۦِhِmْlُẓ","root":"ظلم"},{"id":6,"arabic":"وَ