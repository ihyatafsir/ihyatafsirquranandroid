َّا","translit":"āَّmَʿع","root":""},{"id":41,"arabic":"سَلَفَ","translit":"َfَlَs","root":"سلف"},{"id":42,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":43,"arabic":"عَادَ","translit":"َdāَʿع","root":"عود"},{"id":44,"arabic":"فَيَنتَقِمُ","translit":"ُmِqَtnَyَf","root":"نقم"},{"id":45,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":46,"arabic":"مِنْهُ","translit":"ُhْnِm","root":""},{"id":47,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":48,"arabic":"عَزِيزٌ","translit":"ٌzyِzَʿع","root":"عزز"},{"id":49,"arabic":"ذُو","translit":"wُhd","root":""},{"id":50,"arabic":"ٱنتِقَامٍ","translit":"ٍmāَqِtnٱ","root":"نقم"}],"hasIhya":true},{"ayah":96,"text":"أُحِلَّ لَكُمْ صَيْدُ ٱلْبَحْرِ وَطَعَامُهُۥ مَتَٰعًا لَّكُمْ وَلِلسَّيَّارَةِۖ وَحُرِّمَ عَلَيْكُمْ صَيْدُ ٱلْبَرِّ مَا دُمْتُمْ حُرُمًاۗ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ تُحْشَرُونَ ","translation":"Lawful to you is game from the sea and its food as provision for you and the travelers,[1] but forbidden to you is game from the land as long as you are in the state of iḥrām. And fear Allāh to whom you will be gathered.","words":[{"id":1,"arabic":"أُحِلَّ","translit":"َّlِḥُaʾ","root":"حلل"},{"id":2,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":3,"arabic":"صَيْدُ","translit":"ُdْyَṣ","root":"صيد"},{"id":4,"arabic":"ٱلْبَحْرِ","translit":"ِrْḥَbْlٱ","root":"بحر"},{"id":5,"arabic":"وَطَعَامُهُۥ","translit":"ۥُhُmāَʿعَṭَw","root":"طعم"},{"id":6,"arabic":"مَتَٰعًا","translit":"āًʿعَٰtَm","root":"متع"},{"id":7,"arabic":"لَّكُمْ","translit":"ْmُkَّl","root":""},{"id":8,"arabic":"وَلِلسَّيَّارَةِ","translit":"ِẗَrāَّyَّslِlَw","root":"سير"},{"id":9,"arabic":"وَحُرِّمَ","translit":"َmِّrُḥَw","root":"حرم"},{"id":10,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":11,"arabic":"صَيْدُ","translit":"ُdْyَṣ","root":"صيد"},{"id":12,"arabic":"ٱلْبَرِّ","translit":"ِّrَbْlٱ","root":"برر"},{"id":13,"arabic":"مَا","translit":"āَm","root":""},{"id":14,"arabic":"دُمْتُمْ","translit":"ْmُtْmُd","root":"دوم"},{"id":15,"arabic":"حُرُمًا","translit":"āًmُrُḥ","root":"حرم"},{"id":16,"arabic":"وَٱتَّقُوا۟","translit":"۟āwُqَّtٱَw","root":"وقي"},{"id":17,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":18,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":19,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":20,"arabic":"تُحْشَرُونَ","translit":"َnwُrَhsْḥُt","root":"حشر"}],"hasIhya":false},{"ayah":97,"text":"جَعَلَ ٱللَّهُ ٱلْكَعْبَةَ ٱلْبَيْتَ ٱلْحَرَامَ قِيَٰمًا لِّلنَّاسِ وَٱلشَّهْرَ ٱلْحَرَامَ وَٱلْهَدْىَ وَٱلْقَلَٰٓئِدَۚ ذَٰلِكَ لِتَعْلَمُوٓا۟ أَنَّ ٱللَّهَ يَعْلَمُ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَأَنَّ ٱللَّهَ بِكُلِّ شَىْءٍ عَلِيمٌ ","translation":"Allāh has made the Kaʿbah, the Sacred House, standing[1] for the people and [has sanctified] the sacred months and the sacrificial animals and the garlands [by which they are identified]. That is so you may know that Allāh knows what is in the heavens and what is in the earth and that Allāh is Knowing of all things.","words":[{"id":1,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"ٱلْكَعْبَةَ","translit":"َẗَbْʿعَkْlٱ","root":"كعب"},{"id":4,"arabic":"ٱلْبَيْتَ","translit":"َtْyَbْlٱ","root":"بيت"},{"id":5,"arabic":"ٱلْحَرَامَ","translit":"َmāَrَḥْlٱ","root":"حرم"},{"id":6,"arabic":"قِيَٰمًا","translit":"āًmَٰyِq","root":"قوم"},{"id":7,"arabic":"لِّلنَّاسِ","translit":"ِsāَّnlِّl","root":"انس"},{"id":8,"arabic":"وَٱلشَّهْرَ","translit":"َrْhَّhslٱَw","root":"شهر"},{"id":9,"arabic":"ٱلْحَرَامَ","translit":"َmāَrَḥْlٱ","root":"حرم"},{"id":10,"arabic":"وَٱلْهَدْىَ","translit":"َàْdَhْlٱَw","root":"هدي"},{"id":11,"arabic":"وَٱلْقَلَٰٓئِدَ","translit":"َdِyʾَٰٓlَqْlٱَw","root":"قلد"},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"لِتَعْلَمُوٓا۟","translit":"۟āٓwُmَlْʿعَtِl","root":"علم"},{"id":14,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":15,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":16,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":17,"arabic":"مَا","translit":"āَm","root":""},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":20,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":21,"arabic":"فِى","translit":"àِf","root":""},{"id":22,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":23,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":24,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":25,"arabic":"بِكُلِّ","translit":"ِّlُkِb","root":"كلل"},{"id":26,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":27,"arabic":"عَلِيمٌ","translit":"ٌmyِlَʿع","root":"علم"}],"hasIhya":false},{"ayah":98,"text":"ٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ وَأَنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ","translation":"Know that Allāh is severe in penalty and that Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"ٱعْلَمُوٓا۟","translit":"۟āٓwُmَlْʿعٱ","root":"علم"},{"id":2,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"شَدِيدُ","translit":"ُdyِdَhs","root":"شدد"},{"id":5,"arabic":"ٱلْعِقَابِ","translit":"ِbāَqِʿعْlٱ","root":"عقب"},{"id":6,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":7,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":8,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":9,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":99,"text":"مَّا عَلَى ٱلرَّسُولِ إِلَّا ٱلْبَلَٰغُۗ وَٱللَّهُ يَعْلَمُ مَا تُبْدُونَ وَمَا تَكْتُمُونَ ","translation":"Not upon the Messenger is [responsibility] except [for] notification. And Allāh knows whatever you reveal and whatever you conceal.","words":[{"id":1,"arabic":"مَّا","translit":"āَّm","root":""},{"id":2,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":3,"arabic":"ٱلرَّسُولِ","translit":"ِlwُsَّrlٱ","root":"رسل"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"ٱلْبَلَٰغُ","translit":"ُغَٰlَbْlٱ","root":"بلغ"},{"id":6,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":7,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":8,"arabic":"مَا","translit":"āَm","root":""},{"id":9,"arabic":"تُبْدُونَ","translit":"َnwُdْbُt","root":"بدو"},{"id":10,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":11,"arabic":"تَكْتُمُونَ","translit":"َnwُmُtْkَt","root":"كتم"}],"hasIhya":false},{"ayah":100,"text":"قُل لَّا يَسْتَوِى ٱلْخَبِيثُ وَٱلطَّيِّبُ وَلَوْ أَعْجَبَكَ كَثْرَةُ ٱلْخَبِيثِۚ فَٱتَّقُوا۟ ٱللَّهَ يَٰٓأُو۟لِى ٱلْأَلْبَٰبِ لَعَلَّكُمْ تُفْلِحُونَ ","translation":"Say, \"Not equal are the evil and the good, although the abundance of evil might impress you.\" So fear Allāh, O you of understanding, that you may be successful.","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لَّا","translit":"āَّl","root":""},{"id":3,"arabic":"يَسْتَوِى","translit":"àِwَtْsَy","root":"سوي"},{"id":4,"arabic":"ٱلْخَبِيثُ","translit":"ُhtyِbَhkْlٱ","root":"خبث"},{"id":5,"arabic":"وَٱلطَّيِّبُ","translit":"ُbِّyَّṭlٱَw","root":"طيب"},{"id":6,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":7,"arabic":"أَعْجَبَكَ","translit":"َkَbَjgْʿعَaʾ","root":"عجب"},{"id":8,"arabic":"كَثْرَةُ","translit":"ُẗَrْhtَk","root":"كثر"},{"id":9,"arabic":"ٱلْخَبِيثِ","translit":"ِhtyِbَhkْlٱ","root":"خبث"},{"id":10,"arabic":"فَٱتَّقُوا۟","translit":"۟āwُqَّtٱَf","root":"وقي"},{"id":11,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":12,"arabic":"يَٰٓأُو۟لِى","translit":"àِl۟wُaʾَٰٓy","root":""},{"id":13,"arabic":"ٱلْأَلْبَٰبِ","translit":"ِbَٰbْlَaʾْlٱ","root":"لبب"},{"id":14,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":15,"arabic":"تُفْلِحُونَ","translit":"َnwُḥِlْfُt","root":"فلح"}],"hasIhya":false},{"ayah":101,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَسْـَٔلُوا۟ عَنْ أَشْيَآءَ إِن تُبْدَ لَكُمْ تَسُؤْكُمْ وَإِن تَسْـَٔلُوا۟ عَنْهَا حِينَ يُنَزَّلُ ٱلْقُرْءَانُ تُبْدَ لَكُمْ عَفَا ٱللَّهُ عَنْهَاۗ وَٱللَّهُ غَفُورٌ حَلِيمٌ ","translation":"O you who have believed, do not ask about things which, if they are shown to you, will distress you. But if you ask about them while the Qur’ān is being revealed, they will be shown to you. Allāh has pardoned it [i.e., that which is past]; and Allāh is Forgiving and Forbearing.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَسْـَٔلُوا۟","translit":"۟āwُlَٔـْsَt","root":"سال"},{"id":6,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":7,"arabic":"أَشْيَآءَ","translit":"َءٓāَyْhsَaʾ","root":"شيا"},{"id":8,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":9,"arabic":"تُبْدَ","translit":"َdْbُt","root":"بدو"},{"id":10,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":11,"arabic":"تَسُؤْكُمْ","translit":"ْmُkْwʾُsَt","root":"سوا"},{"id":12,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":13,"arabic":"تَسْـَٔلُوا۟","translit":"۟āwُlَٔـْsَt","root":"سال"},{"id":14,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":15,"arabic":"حِينَ","translit":"َnyِḥ","root":"حين"},{"id":16,"arabic":"يُنَزَّلُ","translit":"ُlَّzَnُy","root":"نزل"},{"id":17,"arabic":"ٱلْقُرْءَانُ","translit":"ُnāَءْrُqْlٱ","root":"قرا"},{"id":18,"arabic":"تُبْدَ","translit":"َdْbُt","root":"بدو"},{"id":19,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":20,"arabic":"عَفَا","translit":"āَfَʿع","root":"عفو"},{"id":21,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":22,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":23,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":24,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":25,"arabic":"حَلِيمٌ","translit":"ٌmyِlَḥ","root":"حلم"}],"hasIhya":true},{"ayah":102,"text":"قَدْ سَأَلَهَا قَوْمٌ مِّن قَبْلِكُمْ ثُمَّ أَصْبَحُوا۟ بِهَا كَٰفِرِينَ ","translation":"A people asked such [questions] before you; then they became thereby disbelievers.[1]","words":[{"id":1,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":2,"arabic":"سَأَلَهَا","translit":"āَhَlَaʾَs","root":"سال"},{"id":3,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"قَبْلِكُمْ","translit":"ْmُkِlْbَq","root":"قبل"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"أَصْبَحُوا۟","translit":"۟āwُḥَbْṣَaʾ","root":"صبح"},{"id":8,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":9,"arabic":"كَٰفِرِينَ","translit":"َnyِrِfَٰk","root":"كفر"}],"hasIhya":false},{"ayah":103,"text":"مَا جَعَلَ ٱللَّهُ مِنۢ بَحِيرَةٍ وَلَا سَآئِبَةٍ وَلَا وَصِيلَةٍ وَلَا حَامٍۙ وَلَٰكِنَّ ٱلَّذِينَ كَفَرُوا۟ يَفْتَرُونَ عَلَى ٱللَّهِ ٱلْكَذِبَۖ وَأَكْثَرُهُمْ لَا يَعْقِلُونَ ","translation":"Allāh has not appointed [such innovations as] baḥīrah or sā’ibah or waṣīlah or ḥām.[1] But those who disbelieve invent falsehood about Allāh, and most of them do not reason.","words":[{"id":1,"arabic":"مَا","translit":"āَm","root":""},{"id":2,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَحِيرَةٍ","translit":"ٍẗَryِḥَb","root":"بحر"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"سَآئِبَةٍ","translit":"ٍẗَbِyʾٓāَs","root":"سيب"},{"id":8,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":9,"arabic":"وَصِيلَةٍ","translit":"ٍẗَlyِṣَw","root":"وصل"},{"id":10,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":11,"arabic":"حَامٍ","translit":"ٍmāَḥ","root":"حمي"},{"id":12,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":13,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":14,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":15,"arabic":"يَفْتَرُونَ","translit":"َnwُrَtْfَy","root":"فري"},{"id":16,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"ٱلْكَذِبَ","translit":"َbِhdَkْlٱ","root":"كذب"},{"id":19,"arabic":"وَأَكْثَرُهُمْ","translit":"ْmُhُrَhtْkَaʾَw","root":"كثر"},{"id":20,"arabic":"لَا","translit":"āَl","root":""},{"id":21,"arabic":"يَعْقِلُونَ","translit":"َnwُlِqْʿعَy","root":"عقل"}],"hasIhya":false},{"ayah":104,"text":"وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ قَالُوا۟ حَسْبُنَا مَا وَجَدْنَا عَلَيْهِ ءَابَآءَنَآۚ أَوَلَوْ كَانَ ءَابَآؤُهُمْ لَا يَعْلَمُونَ شَيْـًٔا وَلَا يَهْتَدُونَ ","translation":"And when it is said to them, \"Come to what Allāh has revealed and to the Messenger,\" they say, \"Sufficient for us is that upon which we found our fathers.\" Even though their fathers knew nothing, nor were they guided?","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"قِيلَ","translit":"َlyِq","root":"قول"},{"id":3,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":4,"arabic":"تَعَالَوْا۟","translit":"۟āْwَlāَʿعَt","root":"علو"},{"id":5,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":6,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":7,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"وَإِلَى","translit":"àَlِiʾَw","root":""},{"id":10,"arabic":"ٱلرَّسُولِ","translit":"ِlwُsَّrlٱ","root":"رسل"},{"id":11,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":12,"arabic":"حَسْبُنَا","translit":"āَnُbْsَḥ","root":"حسب"},{"id":13,"arabic":"مَا","translit":"āَm","root":""},{"id":14,"arabic":"وَجَدْنَا","translit":"āَnْdَjgَw","root":"وجد"},{"id":15,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":16,"arabic":"ءَابَآءَنَآ","translit":"ٓāَnَءٓāَbāَء","root":"ابو"},{"id":17,"arabic":"أَوَلَوْ","translit":"ْwَlَwَaʾ","root":""},{"id":18,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":19,"arabic":"ءَابَآؤُهُمْ","translit":"ْmُhُwʾٓāَbāَء","root":"ابو"},{"id":20,"arabic":"لَا","translit":"āَl","root":""},{"id":21,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"},{"id":22,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":23,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":24,"arabic":"يَهْتَدُونَ","translit":"َnwُdَtْhَy","root":"هدي"}],"hasIhya":false},{"ayah":105,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ عَلَيْكُمْ أَنفُسَكُمْۖ لَا يَضُرُّكُم مَّن ضَلَّ إِذَا ٱهْتَدَيْتُمْۚ إِلَى ٱللَّهِ مَرْجِعُكُمْ جَمِيعًا فَيُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ ","translation":"O you who have believed, upon you is [responsibility for] yourselves. Those who have gone astray will not harm you when you have been guided. To Allāh is your return all together; then He will inform you of what you used to do.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":5,"arabic":"أَنفُسَكُمْ","translit":"ْmُkَsُfnَaʾ","root":"نفس"},{"id":6,"arabic":"لَا","translit":"āَl","root":""},{"id":7,"arabic":"يَضُرُّكُم","translit":"mُkُّrُḍَy","root":"ضرر"},{"id":8,"arabic":"مَّن","translit":"nَّm","root":""},{"id":9,"arabic":"ضَلَّ","translit":"َّlَḍ","root":"ضلل"},{"id":10,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":11,"arabic":"ٱهْتَدَيْتُمْ","translit":"ْmُtْyَdَtْhٱ","root":"هدي"},{"id":12,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":13,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":14,"arabic":"مَرْجِعُكُمْ","translit":"ْmُkُʿعِjgْrَm","root":"رجع"},{"id":15,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":16,"arabic":"فَيُنَبِّئُكُم","translit":"mُkُyʾِّbَnُyَf","root":"نبا"},{"id":17,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":18,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":19,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"}],"hasIhya":true},{"ayah":106,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ شَهَٰدَةُ بَيْنِكُمْ إِذَا حَضَرَ أَحَدَكُمُ ٱلْمَوْتُ حِينَ ٱلْوَصِيَّةِ ٱثْنَانِ ذَوَا عَدْلٍ مِّنكُمْ أَوْ ءَاخَرَانِ مِنْ غَيْرِكُمْ إِنْ أَنتُمْ ضَرَبْتُمْ فِى ٱلْأَرْضِ فَأَصَٰبَتْكُم مُّصِيبَةُ ٱلْمَوْتِۚ تَحْبِسُونَهُمَا مِنۢ بَعْدِ ٱلصَّلَوٰةِ فَيُقْسِمَانِ بِٱللَّهِ إِنِ ٱرْتَبْتُمْ لَا نَشْتَرِى بِهِۦ ثَمَنًا وَلَوْ كَانَ ذَا قُرْبَىٰۙ وَلَا نَكْتُمُ شَهَٰدَةَ ٱللَّهِ إِنَّآ إِذًا لَّمِنَ ٱلْءَاثِمِينَ ","translation":"O you who have believed, testimony [should be taken] among you when death approaches one of you at the time of bequest - [that of] two just men from among you or two others from outside if you are traveling through the land and the disaster of death should strike you. Detain them after the prayer and let them both swear by Allāh if you doubt [their testimony, saying], \"We will not exchange it [i.e., our oath] for a price [i.e., worldly gain], even if he should be a near relative, and we will not withhold the testimony of [i.e., ordained by] Allāh. Indeed, we would then be of the sinful.\"","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"شَهَٰدَةُ","translit":"ُẗَdَٰhَhs","root":"شهد"},{"id":5,"arabic":"بَيْنِكُمْ","translit":"ْmُkِnْyَb","root":"بين"},{"id":6,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":7,"arabic":"حَضَرَ","translit":"َrَḍَḥ","root":"حضر"},{"id":8,"arabic":"أَحَدَكُمُ","translit":"ُmُkَdَḥَaʾ","root":"احد"},{"id":9,"arabic":"ٱلْمَوْتُ","translit":"ُtْwَmْlٱ","root":"موت"},{"id":10,"arabic":"حِينَ","translit":"َnyِḥ","root":"حين"},{"id":11,"arabic":"ٱلْوَصِيَّةِ","translit":"ِẗَّyِṣَwْlٱ","root":"وصي"},{"id":12,"arabic":"ٱثْنَانِ","translit":"ِnāَnْhtٱ","root":"ثني"},{"id":13,"arabic":"ذَوَا","translit":"āَwَhd","root":""},{"id":14,"arabic":"عَدْلٍ","translit":"ٍlْdَʿع","root":"عدل"},{"id":15,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":16,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":17,"arabic":"ءَاخَرَانِ","translit":"ِnāَrَhkāَء","root":"اخر"},{"id":18,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":19,"arabic":"غَيْرِكُمْ","translit":"ْmُkِrْyَغ","root":"غير"},{"id":20,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":21,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":22,"arabic":"ضَرَبْتُمْ","translit":"ْmُtْbَrَḍ","root":"ضرب"},{"id":23,"arabic":"فِى","translit":"àِf","root":""},{"id":24,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":25,"arabic":"فَأَصَٰبَتْكُم","translit":"mُkْtَbَٰṣَaʾَf","root":"صوب"},{"id":26,"arabic":"مُّصِيبَةُ","translit":"ُẗَbyِṣُّm","root":"صوب"},{"id":27,"arabic":"ٱلْمَوْتِ","translit":"ِtْwَmْlٱ","root":"موت"},{"id":28,"arabic":"تَحْبِسُونَهُمَا","translit":"āَmُhَnwُsِbْḥَt","root":"حبس"},{"id":29,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":30,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":31,"arabic":"ٱلصَّلَوٰةِ","translit":"ِẗٰwَlَّṣlٱ","root":"صلو"},{"id":32,"arabic":"فَيُقْسِمَانِ","translit":"ِnāَmِsْqُyَf","root":"قسم"},{"id":33,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":34,"arabic":"إِنِ","translit":"ِnِiʾ","root":""},{"id":35,"arabic":"ٱرْتَبْتُمْ","translit":"ْmُtْbَtْrٱ","root":"ريب"},{"id":36,"arabic":"لَا","translit":"āَl","root":""},{"id":37,"arabic":"نَشْتَرِى","translit":"àِrَtْhsَn","root":"شري"},{"id":38,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":39,"arabic":"ثَمَنًا","translit":"āًnَmَht","root":"ثمن"},{"id":40,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":41,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":42,"arabic":"ذَا","translit":"āَhd","root":""},{"id":43,"arabic":"قُرْبَىٰ","translit":"ٰàَbْrُq","root":"قرب"},{"id":44,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":45,"arabic":"نَكْتُمُ","translit":"ُmُtْkَn","root":"كتم"},{"id":46,"arabic":"شَهَٰدَةَ","translit":"َẗَdَٰhَhs","root":"شهد"},{"id":47,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":48,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":49,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":50,"arabic":"لَّمِنَ","translit":"َnِmَّl","root":""},{"id":51,"arabic":"ٱلْءَاثِمِينَ","translit":"َnyِmِhtāَءْlٱ","root":"اثم"}],"hasIhya":true},{"ayah":107,"text":"فَإِنْ عُثِرَ عَلَىٰٓ أَنَّهُمَا ٱسْتَحَقَّآ إِثْمًا فَـَٔاخَرَانِ يَقُومَانِ مَقَامَهُمَا مِنَ ٱلَّذِينَ ٱسْتَحَقَّ عَلَيْهِمُ ٱلْأَوْلَيَٰنِ فَيُقْسِمَانِ بِٱللَّهِ لَشَهَٰدَتُنَآ أَحَقُّ مِن شَهَٰدَتِهِمَا وَمَا ٱعْتَدَيْنَآ إِنَّآ إِذًا لَّمِنَ ٱلظَّٰلِمِينَ ","translation":"But if it is found that those two were guilty of sin [i.e., perjury], let two others stand in their place [who are] foremost [in claim] from those who have a lawful right. And let them swear by Allāh, \"Our testimony is truer than their testimony, and we have not transgressed. Indeed, we would then be of the wrongdoers.\"","words":[{"id":1,"arabic":"فَإِنْ","translit":"ْnِiʾَf","root":""},{"id":2,"arabic":"عُثِرَ","translit":"َrِhtُʿع","root":"عثر"},{"id":3,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":4,"arabic":"أَنَّهُمَا","translit":"āَmُhَّnَaʾ","root":""},{"id":5,"arabic":"ٱسْتَحَقَّآ","translit":"ٓāَّqَḥَtْsٱ","root":"حقق"},{"id":6,"arabic":"إِثْمًا","translit":"āًmْhtِiʾ","root":"اثم"},{"id":7,"arabic":"فَـَٔاخَرَانِ","translit":"ِnāَrَhkāَٔـَf","root":"اخر"},{"id":8,"arabic":"يَقُومَانِ","translit":"ِnāَmwُqَy","root":"قوم"},{"id":9,"arabic":"مَقَامَهُمَا","translit":"āَmُhَmāَqَm","root":"قوم"},{"id":10,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":11,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":12,"arabic":"ٱسْتَحَقَّ","translit":"َّqَḥَtْsٱ","root":"حقق"},{"id":13,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":14,"arabic":"ٱلْأَوْلَيَٰنِ","translit":"ِnَٰyَlْwَaʾْlٱ","root":"ولي"},{"id":15,"arabic":"فَيُقْسِمَانِ","translit":"ِnāَmِsْqُyَf","root":"قسم"},{"id":16,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":17,"arabic":"لَشَهَٰدَتُنَآ","translit":"ٓāَnُtَdَٰhَhsَl","root":"شهد"},{"id":18,"arabic":"أَحَقُّ","translit":"ُّqَḥَaʾ","root":"حقق"},{"id":19,"arabic":"مِن","translit":"nِm","root":""},{"id":20,"arabic":"شَهَٰدَتِهِمَا","translit":"āَmِhِtَdَٰhَhs","root":"شهد"},{"id":21,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":22,"arabic":"ٱعْتَدَيْنَآ","translit":"ٓāَnْyَdَtْʿعٱ","root":"عدو"},{"id":23,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":24,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":25,"arabic":"لَّمِنَ","translit":"َnِmَّl","root":""},{"id":26,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":false},{"ayah":108,"text":"ذَٰلِكَ أَدْنَىٰٓ أَن يَأْتُوا۟ بِٱلشَّهَٰدَةِ عَلَىٰ وَجْهِهَآ أَوْ يَخَافُوٓا۟ أَن تُرَدَّ أَيْمَٰنٌۢ بَعْدَ أَيْمَٰنِهِمْۗ وَٱتَّقُوا۟ ٱللَّهَ وَٱسْمَعُوا۟ۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلْفَٰسِقِينَ ","translation":"That is more likely that they will give testimony according to its [true] objective, or [at least] they would fear that [other] oaths might be taken after their oaths. And fear Allāh and listen [i.e., obey Him]; and Allāh does not guide the defiantly disobedient people.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"أَدْنَىٰٓ","translit":"ٰٓàَnْdَaʾ","root":"دنو"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"يَأْتُوا۟","translit":"۟āwُtْaʾَy","root":"اتي"},{"id":5,"arabic":"بِٱلشَّهَٰدَةِ","translit":"ِẗَdَٰhَّhslٱِb","root":"شهد"},{"id":6,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":7,"arabic":"وَجْهِ