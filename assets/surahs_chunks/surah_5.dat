d": 16, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 17, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 18, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": true}, {"ayah": 17, "text": "لَّقَدْ كَفَرَ ٱلَّذِينَ قَالُوٓا۟ إِنَّ ٱللَّهَ هُوَ ٱلْمَسِيحُ ٱبْنُ مَرْيَمَۚ قُلْ فَمَن يَمْلِكُ مِنَ ٱللَّهِ شَيْـًٔا إِنْ أَرَادَ أَن يُهْلِكَ ٱلْمَسِيحَ ٱبْنَ مَرْيَمَ وَأُمَّهُۥ وَمَن فِى ٱلْأَرْضِ جَمِيعًاۗ وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَاۚ يَخْلُقُ مَا يَشَآءُۚ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "They have certainly disbelieved who say that Allāh is Christ, the son of Mary. Say, \"Then who could prevent Allāh at all if He had intended to destroy Christ, the son of Mary, or his mother or everyone on the earth?\" And to Allāh belongs the dominion of the heavens and the earth and whatever is between them. He creates what He wills, and Allāh is over all things competent.", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": ""}, {"id": 2, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "ٱلْمَسِيحُ", "translit": "ُḥyِsَmْlٱ", "root": "مسح"}, {"id": 9, "arabic": "ٱبْنُ", "translit": "ُnْbٱ", "root": "بني"}, {"id": 10, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 11, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 12, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 13, "arabic": "يَمْلِكُ", "translit": "ُkِlْmَy", "root": "ملك"}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 17, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 18, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 19, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 20, "arabic": "يُهْلِكَ", "translit": "َkِlْhُy", "root": "هلك"}, {"id": 21, "arabic": "ٱلْمَسِيحَ", "translit": "َḥyِsَmْlٱ", "root": "مسح"}, {"id": 22, "arabic": "ٱبْنَ", "translit": "َnْbٱ", "root": "بني"}, {"id": 23, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 24, "arabic": "وَأُمَّهُۥ", "translit": "ۥُhَّmُaʾَw", "root": "امم"}, {"id": 25, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 26, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 27, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 28, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 29, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 30, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 31, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 32, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 33, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 34, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 35, "arabic": "يَخْلُقُ", "translit": "ُqُlْhkَy", "root": "خلق"}, {"id": 36, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 37, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 38, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 39, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 40, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 41, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 42, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 18, "text": "وَقَالَتِ ٱلْيَهُودُ وَٱلنَّصَٰرَىٰ نَحْنُ أَبْنَٰٓؤُا۟ ٱللَّهِ وَأَحِبَّٰٓؤُهُۥۚ قُلْ فَلِمَ يُعَذِّبُكُم بِذُنُوبِكُمۖ بَلْ أَنتُم بَشَرٌ مِّمَّنْ خَلَقَۚ يَغْفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۚ وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَاۖ وَإِلَيْهِ ٱلْمَصِيرُ ", "translation": "But the Jews and the Christians say, \"We are the children of Allāh and His beloved.\" Say, \"Then why does He punish you for your sins?\" Rather, you are human beings from among those He has created. He forgives whom He wills, and He punishes whom He wills. And to Allāh belongs the dominion of the heavens and the earth and whatever is between them, and to Him is the [final] destination.", "words": [{"id": 1, "arabic": "وَقَالَتِ", "translit": "ِtَlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْيَهُودُ", "translit": "ُdwُhَyْlٱ", "root": "هود"}, {"id": 3, "arabic": "وَٱلنَّصَٰرَىٰ", "translit": "ٰàَrَٰṣَّnlٱَw", "root": "نصر"}, {"id": 4, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 5, "arabic": "أَبْنَٰٓؤُا۟", "translit": "۟āُwʾَٰٓnْbَaʾ", "root": "بني"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَأَحِبَّٰٓؤُهُۥ", "translit": "ۥُhُwʾَّٰٓbِḥَaʾَw", "root": "حبب"}, {"id": 8, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 9, "arabic": "فَلِمَ", "translit": "َmِlَf", "root": ""}, {"id": 10, "arabic": "يُعَذِّبُكُم", "translit": "mُkُbِّhdَʿعُy", "root": "عذب"}, {"id": 11, "arabic": "بِذُنُوبِكُم", "translit": "mُkِbwُnُhdِb", "root": "ذنب"}, {"id": 12, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 13, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 14, "arabic": "بَشَرٌ", "translit": "ٌrَhsَb", "root": "بشر"}, {"id": 15, "arabic": "مِّمَّنْ", "translit": "ْnَّmِّm", "root": ""}, {"id": 16, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 17, "arabic": "يَغْفِرُ", "translit": "ُrِfْغَy", "root": "غفر"}, {"id": 18, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 19, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 20, "arabic": "وَيُعَذِّبُ", "translit": "ُbِّhdَʿعُyَw", "root": "عذب"}, {"id": 21, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 22, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 23, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 24, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 25, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 26, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 27, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 28, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 29, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 30, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 19, "text": "يَٰٓأَهْلَ ٱلْكِتَٰبِ قَدْ جَآءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ عَلَىٰ فَتْرَةٍ مِّنَ ٱلرُّسُلِ أَن تَقُولُوا۟ مَا جَآءَنَا مِنۢ بَشِيرٍ وَلَا نَذِيرٍۖ فَقَدْ جَآءَكُم بَشِيرٌ وَنَذِيرٌۗ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "O People of the Scripture, there has come to you Our Messenger to make clear to you [the religion] after a period [of suspension] of messengers, lest you say, \"There came not to us any bringer of good tidings or a warner.\" But there has come to you a bringer of good tidings and a warner. And Allāh is over all things competent.", "words": [{"id": 1, "arabic": "يَٰٓأَهْلَ", "translit": "َlْhَaʾَٰٓy", "root": "اهل"}, {"id": 2, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "رَسُولُنَا", "translit": "āَnُlwُsَr", "root": "رسل"}, {"id": 6, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "فَتْرَةٍ", "translit": "ٍẗَrْtَf", "root": "فتر"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱلرُّسُلِ", "translit": "ِlُsُّrlٱ", "root": "رسل"}, {"id": 12, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 13, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "جَآءَنَا", "translit": "āَnَءٓāَjg", "root": "جيا"}, {"id": 16, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 17, "arabic": "بَشِيرٍ", "translit": "ٍryِhsَb", "root": "بشر"}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "نَذِيرٍ", "translit": "ٍryِhdَn", "root": "نذر"}, {"id": 20, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 21, "arabic": "جَآءَكُم", "translit": "mُkَءٓāَjg", "root": "جيا"}, {"id": 22, "arabic": "بَشِيرٌ", "translit": "ٌryِhsَb", "root": "بشر"}, {"id": 23, "arabic": "وَنَذِيرٌ", "translit": "ٌryِhdَnَw", "root": "نذر"}, {"id": 24, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 25, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 26, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 27, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 28, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 20, "text": "وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِۦ يَٰقَوْمِ ٱذْكُرُوا۟ نِعْمَةَ ٱللَّهِ عَلَيْكُمْ إِذْ جَعَلَ فِيكُمْ أَنۢبِيَآءَ وَجَعَلَكُم مُّلُوكًا وَءَاتَىٰكُم مَّا لَمْ يُؤْتِ أَحَدًا مِّنَ ٱلْعَٰلَمِينَ ", "translation": "And [mention, O Muḥammad], when Moses said to his people, \"O my people, remember the favor of Allāh upon you when He appointed among you prophets and made you possessors[1] and gave you that which He had not given anyone among the worlds.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "لِقَوْمِهِۦ", "translit": "ۦِhِmْwَqِl", "root": "قوم"}, {"id": 5, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 6, "arabic": "ٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱ", "root": "ذكر"}, {"id": 7, "arabic": "نِعْمَةَ", "translit": "َẗَmْʿعِn", "root": "نعم"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 10, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 11, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 12, "arabic": "فِيكُمْ", "translit": "ْmُkyِf", "root": ""}, {"id": 13, "arabic": "أَنۢبِيَآءَ", "translit": "َءٓāَyِbۢnَaʾ", "root": "نبا"}, {"id": 14, "arabic": "وَجَعَلَكُم", "translit": "mُkَlَʿعَjgَw", "root": "جعل"}, {"id": 15, "arabic": "مُّلُوكًا", "translit": "āًkwُlُّm", "root": "ملك"}, {"id": 16, "arabic": "وَءَاتَىٰكُم", "translit": "mُkٰàَtāَءَw", "root": "اتي"}, {"id": 17, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 18, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 19, "arabic": "يُؤْتِ", "translit": "ِtْwʾُy", "root": "اتي"}, {"id": 20, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}, {"id": 21, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 22, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 21, "text": "يَٰقَوْمِ ٱدْخُلُوا۟ ٱلْأَرْضَ ٱلْمُقَدَّسَةَ ٱلَّتِى كَتَبَ ٱللَّهُ لَكُمْ وَلَا تَرْتَدُّوا۟ عَلَىٰٓ أَدْبَارِكُمْ فَتَنقَلِبُوا۟ خَٰسِرِينَ ", "translation": "O my people, enter the blessed land [i.e., Palestine] which Allāh has assigned to you and do not turn back [from fighting in Allāh's cause] and [thus] become losers.\"", "words": [{"id": 1, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 2, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 3, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "ٱلْمُقَدَّسَةَ", "translit": "َẗَsَّdَqُmْlٱ", "root": "قدس"}, {"id": 5, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 6, "arabic": "كَتَبَ", "translit": "َbَtَk", "root": "كتب"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "تَرْتَدُّوا۟", "translit": "۟āwُّdَtْrَt", "root": "ردد"}, {"id": 11, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 12, "arabic": "أَدْبَارِكُمْ", "translit": "ْmُkِrāَbْdَaʾ", "root": "دبر"}, {"id": 13, "arabic": "فَتَنقَلِبُوا۟", "translit": "۟āwُbِlَqnَtَf", "root": "قلب"}, {"id": 14, "arabic": "خَٰسِرِينَ", "translit": "َnyِrِsَٰhk", "root": "خسر"}], "hasIhya": false}, {"ayah": 22, "text": "قَالُوا۟ يَٰمُوسَىٰٓ إِنَّ فِيهَا قَوْمًا جَبَّارِينَ وَإِنَّا لَن نَّدْخُلَهَا حَتَّىٰ يَخْرُجُوا۟ مِنْهَا فَإِن يَخْرُجُوا۟ مِنْهَا فَإِنَّا دَٰخِلُونَ ", "translation": "They said, \"O Moses, indeed within it is a people of tyrannical strength, and indeed, we will never enter it until they leave it; but if they leave it, then we will enter.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰمُوسَىٰٓ", "translit": "ٰٓàَswُmَٰy", "root": ""}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 5, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 6, "arabic": "جَبَّارِينَ", "translit": "َnyِrāَّbَjg", "root": "جبر"}, {"id": 7, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 8, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 9, "arabic": "نَّدْخُلَهَا", "translit": "āَhَlُhkْdَّn", "root": "دخل"}, {"id": 10, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 11, "arabic": "يَخْرُجُوا۟", "translit": "۟āwُjgُrْhkَy", "root": "خرج"}, {"id": 12, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 13, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 14, "arabic": "يَخْرُجُوا۟", "translit": "۟āwُjgُrْhkَy", "root": "خرج"}, {"id": 15, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 16, "arabic": "فَإِنَّا", "translit": "āَّnِiʾَf", "root": ""}, {"id": 17, "arabic": "دَٰخِلُونَ", "translit": "َnwُlِhkَٰd", "root": "دخل"}], "hasIhya": false}, {"ayah": 23, "text": "قَالَ رَجُلَانِ مِنَ ٱلَّذِينَ يَخَافُونَ أَنْعَمَ ٱللَّهُ عَلَيْهِمَا ٱدْخُلُوا۟ عَلَيْهِمُ ٱلْبَابَ فَإِذَا دَخَلْتُمُوهُ فَإِنَّكُمْ غَٰلِبُونَۚ وَعَلَى ٱللَّهِ فَتَوَكَّلُوٓا۟ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "Said two men from those who feared [to disobey] upon whom Allāh had bestowed favor, \"Enter upon them through the gate, for when you have entered it, you will be predominant.[1] And upon Allāh rely, if you should be believers.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَجُلَانِ", "translit": "ِnāَlُjgَr", "root": "رجل"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَخَافُونَ", "translit": "َnwُfāَhkَy", "root": "خوف"}, {"id": 6, "arabic": "أَنْعَمَ", "translit": "َmَʿعْnَaʾ", "root": "نعم"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "عَلَيْهِمَا", "translit": "āَmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 10, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱلْبَابَ", "translit": "َbāَbْlٱ", "root": "بوب"}, {"id": 12, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 13, "arabic": "دَخَلْتُمُوهُ", "translit": "ُhwُmُtْlَhkَd", "root": "دخل"}, {"id": 14, "arabic": "فَإِنَّكُمْ", "translit": "ْmُkَّnِiʾَf", "root": ""}, {"id": 15, "arabic": "غَٰلِبُونَ", "translit": "َnwُbِlَٰغ", "root": "غلب"}, {"id": 16, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "فَتَوَكَّلُوٓا۟", "translit": "۟āٓwُlَّkَwَtَf", "root": "وكل"}, {"id": 19, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 20, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 21, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": true}, {"ayah": 24, "text": "قَالُوا۟ يَٰمُوسَىٰٓ إِنَّا لَن نَّدْخُلَهَآ أَبَدًا مَّا دَامُوا۟ فِيهَاۖ فَٱذْهَبْ أَنتَ وَرَبُّكَ فَقَٰتِلَآ إِنَّا هَٰهُنَا قَٰعِدُونَ ", "translation": "They said, \"O Moses, indeed we will not enter it, ever, as long as they are within it; so go, you and your Lord, and fight. Indeed, we are remaining right here.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰمُوسَىٰٓ", "translit": "ٰٓàَswُmَٰy", "root": ""}, {"id": 3, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 4, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 5, "arabic": "نَّدْخُلَهَآ", "translit": "ٓāَhَlُhkْdَّn", "root": "دخل"}, {"id": 6, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "دَامُوا۟", "translit": "۟āwُmāَd", "root": "دوم"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "فَٱذْهَبْ", "translit": "ْbَhْhdٱَf", "root": "ذهب"}, {"id": 11, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 12, "arabic": "وَرَبُّكَ", "translit": "َkُّbَrَw", "root": "ربب"}, {"id": 13, "arabic": "فَقَٰتِلَآ", "translit": "ٓāَlِtَٰqَf", "root": "قتل"}, {"id": 14, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 15, "arabic": "هَٰهُنَا", "translit": "āَnُhَٰh", "root": ""}, {"id": 16, "arabic": "قَٰعِدُونَ", "translit": "َnwُdِʿعَٰq", "root": "قعد"}], "hasIhya": false}, {"ayah": 25, "text": "قَالَ رَبِّ إِنِّى لَآ أَمْلِكُ إِلَّا نَفْسِى وَأَخِىۖ فَٱفْرُقْ بَيْنَنَا وَبَيْنَ ٱلْقَوْمِ ٱلْفَٰسِقِينَ ", "translation": "[Moses] said, \"My Lord, indeed I do not possess [i.e., control] except myself and my brother, so part us[1] from the defiantly disobedient people.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 4, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 5, "arabic": "أَمْلِكُ", "translit": "ُkِlْmَaʾ", "root": "ملك"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "نَفْسِى", "translit": "àِsْfَn", "root": "نفس"}, {"id": 8, "arabic": "وَأَخِى", "translit": "àِhkَaʾَw", "root": "اخو"}, {"id": 9, "arabic": "فَٱفْرُقْ", "translit": "ْqُrْfٱَf", "root": "فرق"}, {"id": 10, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 11, "arabic": "وَبَيْنَ", "translit": "َnْyَbَw", "root": "بين"}, {"id": 12, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 13, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 26, "text": "قَالَ فَإِنَّهَا مُحَرَّمَةٌ عَلَيْهِمْۛ أَرْبَعِينَ سَنَةًۛ يَتِيهُونَ فِى ٱلْأَرْضِۚ فَلَا تَأْسَ عَلَى ٱلْقَوْمِ ٱلْفَٰسِقِينَ ", "translation": "[Allāh] said, \"Then indeed, it is forbidden to them for forty years [in which] they will wander throughout the land. So do not grieve over the defiantly disobedient people.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَإِنَّهَا", "translit": "āَhَّnِiʾَf", "root": ""}, {"id": 3, "arabic": "مُحَرَّمَةٌ", "translit": "ٌẗَmَّrَḥُm", "root": "حرم"}, {"id": 4, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "أَرْبَعِينَ", "translit": "َnyِʿعَbْrَaʾ", "root": "ربع"}, {"id": 6, "arabic": "سَنَةً", "translit": "ًẗَnَs", "root": "سنو"}, {"id": 7, "arabic": "يَتِيهُونَ", "translit": "َnwُhyِtَy", "root": "تيه"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 11, "arabic": "تَأْسَ", "translit": "َsْaʾَt", "root": "اسو"}, {"id": 12, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 14, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 27, "text": "وَٱتْلُ عَلَيْهِمْ نَبَأَ ٱبْنَىْ ءَادَمَ بِٱلْحَقِّ إِذْ قَرَّبَا قُرْبَانًا فَتُقُبِّلَ مِنْ أَحَدِهِمَا وَلَمْ يُتَقَبَّلْ مِنَ ٱلْءَاخَرِ قَالَ لَأَقْتُلَنَّكَۖ قَالَ إِنَّمَا يَتَقَبَّلُ ٱللَّهُ مِنَ ٱلْمُتَّقِينَ ", "translation": "And recite to them the story of Adam's two sons, in truth, when they both made an offering [to Allāh], and it was accepted from one of them but was not accepted from the other. Said [the latter], \"I will surely kill you.\" Said [the former], \"Indeed, Allāh only accepts from the righteous [who fear Him].", "words": [{"id": 1, "arabic": "وَٱتْلُ", "translit": "ُlْtٱَw", "root": "تلو"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "نَبَأَ", "translit": "َaʾَbَn", "root": "نبا"}, {"id": 4, "arabic": "ٱبْنَىْ", "translit": "ْàَnْbٱ", "root": "بني"}, {"id": 5, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 6, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 7, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 8, "arabic": "قَرَّبَا", "translit": "āَbَّrَq", "root": "قرب"}, {"id": 9, "arabic": "قُرْبَانًا", "translit": "āًnāَbْrُq", "root": "قرب"}, {"id": 10, "arabic": "فَتُقُبِّلَ", "translit": "َlِّbُqُtَf", "root": "قبل"}, {"id": 11, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 12, "arabic": "أَحَدِهِمَا", "translit": "āَmِhِdَḥَaʾ", "root": "احد"}, {"id": 13, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 14, "arabic": "يُتَقَبَّلْ", "translit": "ْlَّbَqَtُy", "root": "قبل"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْءَاخَرِ", "translit": "ِrَhkāَءْlٱ", "root": "اخر"}, {"id": 17, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 18, "arabic": "لَأَقْتُلَنَّكَ", "translit": "َkَّnَlُtْqَaʾَl", "root": "قتل"}, {"id": 19, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 20, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 21, "arabic": "يَتَقَبَّلُ", "translit": "ُlَّbَqَtَy", "root": "قبل"}, {"id": 22, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 24, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": true}, {"ayah": 28, "text": "لَئِنۢ بَسَطتَ إِلَىَّ يَدَكَ لِتَقْتُلَنِى مَآ أَنَا۠ بِبَاسِطٍ يَدِىَ إِلَيْكَ لِأَقْتُلَكَۖ إِنِّىٓ أَخَافُ ٱللَّهَ رَبَّ ٱلْعَٰلَمِينَ ", "translation": "If you should raise your hand toward me to kill me - I shall not raise my hand toward you to kill you. Indeed, I fear Allāh, Lord of the worlds.", "words": [{"id": 1, "arabic": "لَئِنۢ", "translit": "ۢnِyʾَl", "root": ""}, {"id": 2, "arabic": "بَسَطتَ", "translit": "َtṭَsَb", "root": "بسط"}, {"id": 3, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 4, "arabic": "يَدَكَ", "translit": "َkَdَy", "root": "يدي"}, {"id": 5, "arabic": "لِتَقْتُلَنِى", "translit": "àِnَlُtْqَtِl", "root": "قتل"}, {"id": 6, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 7, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 8, "arabic": "بِبَاسِطٍ", "translit": "ٍṭِsāَbِb", "root": "بسط"}, {"id": 9, "arabic": "يَدِىَ", "translit": "َàِdَy", "root": "يدي"}, {"id": 10, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 11, "arabic": "لِأَقْتُلَكَ", "translit": "َkَlُtْqَaʾِl", "root": "قتل"}, {"id": 12, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 13, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "رَبَّ", "translit": "َّbَr", "root": "ربب"}, {"id": 16, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 29, "text": "إِنِّىٓ أُرِيدُ أَن تَبُوٓأَ بِإِثْمِى وَإِثْمِكَ فَتَكُونَ مِنْ أَصْحَٰبِ ٱلنَّارِۚ وَذَٰلِكَ جَزَٰٓؤُا۟ ٱلظَّٰلِمِينَ ", "translation": "Indeed, I want you to obtain [thereby] my sin and your sin so you will be among the companions of the Fire. And that is the recompense of wrongdoers.\"", "words": [{"id": 1, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 2, "arabic": "أُرِيدُ", "translit": "ُdyِrُaʾ", "root": "رود"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تَبُوٓأَ", "translit": "َaʾٓwُbَt", "root": "بوا"}, {"id": 5, "arabic": "بِإِثْمِى", "translit": "àِmْhtِiʾِb", "root": "اثم"}, {"id": 6, "arabic": "وَإِثْمِكَ", "translit": "َkِmْhtِiʾَw", "root": "اثم"}, {"id": 7, "arabic": "فَتَكُونَ", "translit": "َnwُkَtَf", "root": "كون"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "أَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 10, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 11, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 12, "arabic": "جَزَٰٓؤُا۟", "translit": "۟āُwʾَٰٓzَjg", "root": "جزي"}, {"id": 13, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 30, "text": "فَطَوَّعَتْ لَهُۥ نَفْسُهُۥ قَتْلَ أَخِيهِ فَقَتَلَهُۥ فَأَصْبَحَ مِنَ ٱلْخَٰسِرِينَ ", "translation": "And his soul permitted to him[1] the murder of his brother, so he killed him and became among the losers.", "words": [{"id": 1, "arabic": "فَطَوَّعَتْ", "translit": "ْtَʿعَّwَṭَf", "root": "طوع"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "نَفْسُهُۥ", "translit": "ۥُhُsْfَn", "root": "نفس"}, {"id": 4, "arabic": "قَتْلَ", "translit": "َlْtَq", "root": "قتل"}, {"id": 5, "arabic": "أَخِيهِ", "translit": "ِhyِhkَaʾ", "root": "اخو"}, {"id": 6, "arabic": "فَقَتَلَهُۥ", "translit": "ۥُhَlَtَqَf", "root": "قتل"}, {"id": 7, "arabic": "فَأَصْبَحَ", "translit": "َḥَbْṣَaʾَf", "root": "صبح"}, {"id": 8, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 9, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 31, "text": "فَبَعَثَ ٱللَّهُ غُرَابًا يَبْحَثُ فِى ٱلْأَرْضِ لِيُرِيَهُۥ كَيْفَ يُوَٰرِى سَوْءَةَ أَخِيهِۚ قَالَ يَٰوَيْلَتَىٰٓ أَعَجَزْتُ أَنْ أَكُونَ مِثْلَ هَٰذَا ٱلْغُرَابِ فَأُوَٰرِىَ سَوْءَةَ أَخِىۖ فَأَصْبَحَ مِنَ ٱلنَّٰدِمِينَ ", "translation": "Then Allāh sent a crow searching [i.e., scratching] in the ground to show him how to hide the disgrace[1] of his brother. He said, \"O woe to me! Have I failed to be like this crow and hide the disgrace [i.e., body] of my brother?\" And he became of the regretful.", "words": [{"id": 1, "arabic": "فَبَعَثَ", "translit": "َhtَʿعَbَf", "root": "بعث"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "غُرَابًا", "translit": "āًbāَrُغ", "root": "غرب"}, {"id": 4, "arabic": "يَبْحَثُ", "translit": "ُhtَḥْbَy", "root": "بحث"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "لِيُرِيَهُۥ", "translit": "ۥُhَyِrُyِl", "root": "راي"}, {"id": 8, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 9, "arabic": "يُوَٰرِى", "translit": "àِrَٰwُy", "root": "وري"}, {"id": 10, "arabic": "سَوْءَةَ", "translit": "َẗَءْwَs", "root": "سوا"}, {"id": 11, "arabic": "أَخِيهِ", "translit": "ِhyِhkَaʾ", "root": "اخو"}, {"id": 12, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 13, "arabic": "يَٰوَيْلَتَىٰٓ", "translit": "ٰٓàَtَlْyَwَٰy", "root": ""}, {"id": 14, "arabic": "أَعَجَزْتُ", "translit": "ُtْzَjgَʿعَaʾ", "root": "عجز"}, {"id": 15, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 16, "arabic": "أَكُونَ", "translit": "َnwُkَaʾ", "root": "كون"}, {"id": 17, "arabic": "مِثْلَ", "translit": "َlْhtِm", "root": "مثل"}, {"id": 18, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 19, "arabic": "ٱلْغُرَابِ", "translit": "ِbāَrُغْlٱ", "root": "غرب"}, {"id": 20, "arabic": "فَأُوَٰرِىَ", "translit": "َàِrَٰwُaʾَf", "root": "وري"}, {"id": 21, "arabic": "سَوْءَةَ", "translit": "َẗَءْwَs", "root": "سوا"}, {"id": 22, "arabic": "أَخِى", "translit": "àِhkَaʾ", "root": "اخو"}, {"id": 23, "arabic": "فَأَصْبَحَ", "translit": "َḥَbْṣَaʾَf", "root": "صبح"}, {"id": 24, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 25, "arabic": "ٱلنَّٰدِمِينَ", "translit": "َnyِmِdَّٰnlٱ", "root": "ندم"}], "hasIhya": false}, {"ayah": 32, "text": "مِنْ أَجْلِ ذَٰلِكَ كَتَبْنَا عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ أَنَّهُۥ مَن قَتَلَ نَفْسًۢا بِغَيْرِ نَفْسٍ أَوْ فَسَادٍ فِى ٱلْأَرْضِ فَكَأَنَّمَا قَتَلَ ٱلنَّاسَ جَمِيعًا وَمَنْ أَحْيَاهَا فَكَأَنَّمَآ أَحْيَا ٱلنَّاسَ جَمِيعًاۚ وَلَقَدْ جَآءَتْهُمْ رُسُلُنَا بِٱلْبَيِّنَٰتِ ثُمَّ إِنَّ كَثِيرًا مِّنْهُم بَعْدَ ذَٰلِكَ فِى ٱلْأَرْضِ لَمُسْرِفُونَ ", "translation": "Because of that, We decreed upon the Children of Israel that whoever kills a soul unless for a soul[1] or for corruption [done] in the land[2] - it is as if he had slain mankind entirely. And whoever saves one[3] - it is as if he had saved mankind entirely. And Our messengers had certainly come to them with clear proofs. Then indeed many of them, [even] after that, throughout the land, were transgressors.[4]", "words": [{"id": 1, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 2, "arabic": "أَجْلِ", "translit": "ِlْjgَaʾ", "root": "اجل"}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 4, "arabic": "كَتَبْنَا", "translit": "āَnْbَtَk", "root": "كتب"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 7, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 8, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "قَتَلَ", "translit": "َlَtَq", "root": "قتل"}, {"id": 11, "arabic": "نَفْسًۢا", "translit": "āًۢsْfَn", "root": "نفس"}, {"id": 12, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 13, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 14, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 15, "arabic": "فَسَادٍ", "translit": "ٍdāَsَf", "root": "فسد"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 18, "arabic": "فَكَأَنَّمَا", "translit": "āَmَّnَaʾَkَf", "root": ""}, {"id": 19, "arabic": "قَتَلَ", "translit": "َlَtَq", "root": "قتل"}, {"id": 20, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 21, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 22, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 23, "arabic": "أَحْيَاهَا", "translit": "āَhāَyْḥَaʾ", "root": "حيي"}, {"id": 24, "arabic": "فَكَأَنَّمَآ", "translit": "ٓāَmَّnَaʾَkَf", "root": ""}, {"id": 25, "arabic": "أَحْيَا", "translit": "āَyْḥَaʾ", "root": "حيي"}, {"id": 26, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 27, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 28, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 29, "arabic": "جَآءَتْهُمْ", "translit": "ْmُhْtَءٓāَjg", "root": "جيا"}, {"id": 30, "arabic": "رُسُلُنَا", "translit": "āَnُlُsُr", "root": "رسل"}, {"id": 31, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 32, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 33, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 34, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 35, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 36, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 37, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 38, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 39, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 40, "arabic": "لَمُسْرِفُونَ", "translit": "َnwُfِrْsُmَl", "root": "سرف"}], "hasIhya": true}, {"ayah": 33, "text": "إِنَّمَا جَزَٰٓؤُا۟ ٱلَّذِينَ يُحَارِبُونَ ٱللَّهَ وَرَسُولَهُۥ وَيَسْعَوْنَ فِى ٱلْأَرْضِ فَسَادًا أَن يُقَتَّلُوٓا۟ أَوْ يُصَلَّبُوٓا۟ أَوْ تُقَطَّعَ أَيْدِيهِمْ وَأَرْجُلُهُم مِّنْ خِلَٰفٍ أَوْ يُنفَوْا۟ مِنَ ٱلْأَرْضِۚ ذَٰلِكَ لَهُمْ خِزْىٌ فِى ٱلدُّنْيَاۖ وَلَهُمْ فِى ٱلْءَاخِرَةِ عَذَابٌ عَظِيمٌ ", "translation": "Indeed, the penalty[1] for those who wage war[2] against Allāh and His Messenger and strive upon earth [to cause] corruption is none but that they be killed or crucified or that their hands and feet be cut off from opposite sides or that they be exiled from the land. That is for them a disgrace in this world; and for them in the Hereafter is a great punishment,", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "جَزَٰٓؤُا۟", "translit": "۟āُwʾَٰٓzَjg", "root": "جزي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يُحَارِبُونَ", "translit": "َnwُbِrāَḥُy", "root": "حرب"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 7, "arabic": "وَيَسْعَوْنَ", "translit": "َnْwَʿعْsَyَw", "root": "سعي"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "فَسَادًا", "translit": "āًdāَsَf", "root": "فسد"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يُقَتَّلُوٓا۟", "translit": "۟āٓwُlَّtَqُy", "root": "قتل"}, {"id": 13, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 14, "arabic": "يُصَلَّبُوٓا۟", "translit": "۟āٓwُbَّlَṣُy", "root": "صلب"}, {"id": 15, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 16, "arabic": "تُقَطَّعَ", "translit": "َʿعَّṭَqُt", "root": "قطع"}, {"id": 17, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 18, "arabic": "وَأَرْجُلُهُم", "translit": "mُhُlُjgْrَaʾَw", "root": "رجل"}, {"id": 19, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 20, "arabic": "خِلَٰفٍ", "translit": "ٍfَٰlِhk", "root": "خلف"}, {"id": 21, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 22, "arabic": "يُنفَوْا۟", "translit": "۟āْwَfnُy", "root": "نفي"}, {"id": 23, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 24, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 25, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 26, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 27, "arabic": "خِزْىٌ", "translit": "ٌàْzِhk", "root": "خزي"}, {"id": 28, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 29, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 30, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 31, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 32, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 33, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 34, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 34, "text": "إِلَّا ٱلَّذِينَ تَابُوا۟ مِن قَبْلِ أَن تَقْدِرُوا۟ عَلَيْهِمْۖ فَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "Except for those who return [repenting] before you overcome [i.e., apprehend] them. And know that Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "تَابُوا۟", "translit": "۟āwُbāَt", "root": "توب"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "تَقْدِرُوا۟", "translit": "۟āwُrِdْqَt", "root": "قدر"}, {"id": 8, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "فَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَf", "root": "علم"}, {"id": 10, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 13, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 35, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَٱبْتَغُوٓا۟ إِلَيْهِ ٱلْوَسِيلَةَ وَجَٰهِدُوا۟ فِى سَبِيلِهِۦ لَعَلَّكُمْ تُفْلِحُونَ ", "translation": "O you who have believed, fear Allāh and seek the means [of nearness] to Him and strive in His cause that you may succeed.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَٱبْتَغُوٓا۟", "translit": "۟āٓwُغَtْbٱَw", "root": "بغي"}, {"id": 7, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلْوَسِيلَةَ", "translit": "َẗَlyِsَwْlٱ", "root": "وسل"}, {"id": 9, "arabic": "وَجَٰهِدُوا۟", "translit": "۟āwُdِhَٰjgَw", "root": "جهد"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "سَبِيلِهِۦ", "translit": "ۦِhِlyِbَs", "root": "سبل"}, {"id": 12, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 13, "arabic": "تُفْلِحُونَ", "translit": "َnwُḥِlْfُt", "root": "فلح"}], "hasIhya": true}, {"ayah": 36, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ لَوْ أَنَّ لَهُم مَّا فِى ٱلْأَرْضِ جَمِيعًا وَمِثْلَهُۥ مَعَهُۥ لِيَفْتَدُوا۟ بِهِۦ مِنْ عَذَابِ يَوْمِ ٱلْقِيَٰمَةِ مَا تُقُبِّلَ مِنْهُمْۖ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "Indeed, those who disbelieve - if they should have all that is in the earth and the like of it with it by which to ransom themselves from the punishment of the Day of Resurrection, it will not be accepted from them, and for them is a painful punishment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 5, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 6, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 11, "arabic": "وَمِثْلَهُۥ", "translit": "ۥُhَlْhtِmَw", "root": "مثل"}, {"id": 12, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 13, "arabic": "لِيَفْتَدُوا۟", "translit": "۟āwُdَtْfَyِl", "root": "فدي"}, {"id": 14, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 17, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 18, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 19, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 20, "arabic": "تُقُبِّلَ", "translit": "َlِّbُqُt", "root": "قبل"}, {"id": 21, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 22, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 23, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 24, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 37, "text": "يُرِيدُونَ أَن يَخْرُجُوا۟ مِنَ ٱلنَّارِ وَمَا هُم بِخَٰرِجِينَ مِنْهَاۖ وَلَهُمْ عَذَابٌ مُّقِيمٌ ", "translation": "They will wish to get out of the Fire, but never are they to emerge therefrom, and for them is an enduring punishment.", "words": [{"id": 1, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "يَخْرُجُوا۟", "translit": "۟āwُjgُrْhkَy", "root": "خرج"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 8, "arabic": "بِخَٰرِجِينَ", "translit": "َnyِjgِrَٰhkِb", "root": "خرج"}, {"id": 9, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 10, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "مُّقِيمٌ", "translit": "ٌmyِqُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 38, "text": "وَٱلسَّارِقُ وَٱلسَّارِقَةُ فَٱقْطَعُوٓا۟ أَيْدِيَهُمَا جَزَآءًۢ بِمَا كَسَبَا نَكَٰلًا مِّنَ ٱللَّهِۗ وَٱللَّهُ عَزِيزٌ حَكِيمٌ ", "translation": "[As for] the thief, the male and the female, amputate their hands in recompense for what they earned [i.e., committed] as a deterrent [punishment] from Allāh. And Allāh is Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "وَٱلسَّارِقُ", "translit": "ُqِrāَّslٱَw", "root": "سرق"}, {"id": 2, "arabic": "وَٱلسَّارِقَةُ", "translit": "ُẗَqِrāَّslٱَw", "root": "سرق"}, {"id": 3, "arabic": "فَٱقْطَعُوٓا۟", "translit": "۟āٓwُʿعَṭْqٱَf", "root": "قطع"}, {"id": 4, "arabic": "أَيْدِيَهُمَا", "translit": "āَmُhَyِdْyَaʾ", "root": "يدي"}, {"id": 5, "arabic": "جَزَآءًۢ", "translit": "ًۢءٓāَzَjg", "root": "جزي"}, {"id": 6, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 7, "arabic": "كَسَبَا", "translit": "āَbَsَk", "root": "كسب"}, {"id": 8, "arabic": "نَكَٰلًا", "translit": "āًlَٰkَn", "root": "نكل"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 12, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 13, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 39, "text": "فَمَن تَابَ مِنۢ بَعْدِ ظُلْمِهِۦ وَأَصْلَحَ فَإِنَّ ٱللَّهَ يَتُوبُ عَلَيْهِۗ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "But whoever repents after his wrongdoing and reforms, indeed, Allāh will turn to him in forgiveness. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 2, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 3, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 4, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "ظُلْمِهِۦ", "translit": "ۦِhِmْlُẓ", "root": "ظلم"}, {"id": 6, "arabic": "وَأَصْلَحَ", "translit": "َḥَlْṣَaʾَw", "root": "صلح"}, {"id": 7, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "يَتُوبُ", "translit": "ُbwُtَy", "root": "توب"}, {"id": 10, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 14, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 40, "text": "أَلَمْ تَعْلَمْ أَنَّ ٱللَّهَ لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ يُعَذِّبُ مَن يَشَآءُ وَيَغْفِرُ لِمَن يَشَآءُۗ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Do you not know that to Allāh belongs the dominion of the heavens and the earth? He punishes whom He wills and forgives whom He wills, and Allāh is over all things competent.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَعْلَمْ", "translit": "ْmَlْʿعَt", "root": "علم"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 7, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 8, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 9, "arabic": "يُعَذِّبُ", "translit": "ُbِّhdَʿعُy", "root": "عذب"}, {"id": 10, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 11, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 12, "arabic": "وَيَغْفِرُ", "translit": "ُrِfْغَyَw", "root": "غفر"}, {"id": 13, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 14, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 15, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 41, "text": "يَٰٓأَيُّهَا ٱلرَّسُولُ لَا يَحْزُنكَ ٱلَّذِينَ يُسَٰرِعُونَ فِى ٱلْكُفْرِ مِنَ ٱلَّذِينَ قَالُوٓا۟ ءَامَنَّا بِأَفْوَٰهِهِمْ وَلَمْ تُؤْمِن قُلُوبُهُمْۛ وَمِنَ ٱلَّذِينَ هَادُوا۟ۛ سَمَّٰعُونَ لِلْكَذِبِ سَمَّٰعُونَ لِقَوْمٍ ءَاخَرِينَ لَمْ يَأْتُوكَۖ يُحَرِّفُونَ ٱلْكَلِمَ مِنۢ بَعْدِ مَوَاضِعِهِۦۖ يَقُولُونَ إِنْ أُوتِيتُمْ هَٰذَا فَخُذُوهُ وَإِن لَّمْ تُؤْتَوْهُ فَٱحْذَرُوا۟ۚ وَمَن يُرِدِ ٱللَّهُ فِتْنَتَهُۥ فَلَن تَمْلِكَ لَهُۥ مِنَ ٱللَّهِ شَيْـًٔاۚ أُو۟لَٰٓئِكَ ٱلَّذِينَ لَمْ يُرِدِ ٱللَّهُ أَن يُطَهِّرَ قُلُوبَهُمْۚ لَهُمْ فِى ٱلدُّنْيَا خِزْىٌۖ وَلَهُمْ فِى ٱلْءَاخِرَةِ عَذَابٌ عَظِيمٌ ", "translation": "O Messenger, let them not grieve you who hasten into disbelief – of those who say, \"We believe\" with their mouths, but their hearts believe not, and from among the Jews. [They are] avid listeners to falsehood, listening to another people who have not come to you.[1] They distort words beyond their [proper] places [i.e., usages], saying, \"If you are given this,[2] take it; but if you are not given it, then beware.\" But he for whom Allāh intends fitnah[3] - never will you possess [power to do] for him a thing against Allāh. Those are the ones for whom Allāh does not intend to purify their hearts. For them in this world is disgrace, and for them in the Hereafter is a great punishment.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَحْزُنكَ", "translit": "َknُzْḥَy", "root": "حزن"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "يُسَٰرِعُونَ", "translit": "َnwُʿعِrَٰsُy", "root": "سرع"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْكُفْرِ", "translit": "ِrْfُkْlٱ", "root": "كفر"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 12, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 13, "arabic": "بِأَفْوَٰهِهِمْ", "translit": "ْmِhِhَٰwْfَaʾِb", "root": "فوه"}, {"id": 14, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 15, "arabic": "تُؤْمِن", "translit": "nِmْwʾُt", "root": "امن"}, {"id": 16, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 17, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 18, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 19, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 20, "arabic": "سَمَّٰعُونَ", "translit": "َnwُʿعَّٰmَs", "root": "سمع"}, {"id": 21, "arabic": "لِلْكَذِبِ", "translit": "ِbِhdَkْlِl", "root": "كذب"}, {"id": 22, "arabic": "سَمَّٰعُونَ", "translit": "َnwُʿعَّٰmَs", "root": "سمع"}, {"id": 23, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 24, "arabic": "ءَاخَرِينَ", "translit": "َnyِrَhkāَء", "root": "اخر"}, {"id": 25, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 26, "arabic": "يَأْتُوكَ", "translit": "َkwُtْaʾَy", "root": "اتي"}, {"id": 27, "arabic": "يُحَرِّفُونَ", "translit": "َnwُfِّrَḥُy", "root": "حرف"}, {"id": 28, "arabic": "ٱلْكَلِمَ", "translit": "َmِlَkْlٱ", "root": "كلم"}, {"id": 29, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 30, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 31, "arabic": "مَوَاضِعِهِۦ", "translit": "ۦِhِʿعِḍāَwَm", "roo