قَتْلَ","translit":"َlْtَq","root":"قتل"},{"id":5,"arabic":"أَخِيهِ","translit":"ِhyِhkَaʾ","root":"اخو"},{"id":6,"arabic":"فَقَتَلَهُۥ","translit":"ۥُhَlَtَqَf","root":"قتل"},{"id":7,"arabic":"فَأَصْبَحَ","translit":"َḥَbْṣَaʾَf","root":"صبح"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلْخَٰسِرِينَ","translit":"َnyِrِsَٰhkْlٱ","root":"خسر"}],"hasIhya":false},{"ayah":31,"text":"فَبَعَثَ ٱللَّهُ غُرَابًا يَبْحَثُ فِى ٱلْأَرْضِ لِيُرِيَهُۥ كَيْفَ يُوَٰرِى سَوْءَةَ أَخِيهِۚ قَالَ يَٰوَيْلَتَىٰٓ أَعَجَزْتُ أَنْ أَكُونَ مِثْلَ هَٰذَا ٱلْغُرَابِ فَأُوَٰرِىَ سَوْءَةَ أَخِىۖ فَأَصْبَحَ مِنَ ٱلنَّٰدِمِينَ ","translation":"Then Allāh sent a crow searching [i.e., scratching] in the ground to show him how to hide the disgrace[1] of his brother. He said, \"O woe to me! Have I failed to be like this crow and hide the disgrace [i.e., body] of my brother?\" And he became of the regretful.","words":[{"id":1,"arabic":"فَبَعَثَ","translit":"َhtَʿعَbَf","root":"بعث"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"غُرَابًا","translit":"āًbāَrُغ","root":"غرب"},{"id":4,"arabic":"يَبْحَثُ","translit":"ُhtَḥْbَy","root":"بحث"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":7,"arabic":"لِيُرِيَهُۥ","translit":"ۥُhَyِrُyِl","root":"راي"},{"id":8,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":9,"arabic":"يُوَٰرِى","translit":"àِrَٰwُy","root":"وري"},{"id":10,"arabic":"سَوْءَةَ","translit":"َẗَءْwَs","root":"سوا"},{"id":11,"arabic":"أَخِيهِ","translit":"ِhyِhkَaʾ","root":"اخو"},{"id":12,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":13,"arabic":"يَٰوَيْلَتَىٰٓ","translit":"ٰٓàَtَlْyَwَٰy","root":""},{"id":14,"arabic":"أَعَجَزْتُ","translit":"ُtْzَjgَʿعَaʾ","root":"عجز"},{"id":15,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":16,"arabic":"أَكُونَ","translit":"َnwُkَaʾ","root":"كون"},{"id":17,"arabic":"مِثْلَ","translit":"َlْhtِm","root":"مثل"},{"id":18,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":19,"arabic":"ٱلْغُرَابِ","translit":"ِbāَrُغْlٱ","root":"غرب"},{"id":20,"arabic":"فَأُوَٰرِىَ","translit":"َàِrَٰwُaʾَf","root":"وري"},{"id":21,"arabic":"سَوْءَةَ","translit":"َẗَءْwَs","root":"سوا"},{"id":22,"arabic":"أَخِى","translit":"àِhkَaʾ","root":"اخو"},{"id":23,"arabic":"فَأَصْبَحَ","translit":"َḥَbْṣَaʾَf","root":"صبح"},{"id":24,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":25,"arabic":"ٱلنَّٰدِمِينَ","translit":"َnyِmِdَّٰnlٱ","root":"ندم"}],"hasIhya":false},{"ayah":32,"text":"مِنْ أَجْلِ ذَٰلِكَ كَتَبْنَا عَلَىٰ بَنِىٓ إِسْرَٰٓءِيلَ أَنَّهُۥ مَن قَتَلَ نَفْسًۢا بِغَيْرِ نَفْسٍ أَوْ فَسَادٍ فِى ٱلْأَرْضِ فَكَأَنَّمَا قَتَلَ ٱلنَّاسَ جَمِيعًا وَمَنْ أَحْيَاهَا فَكَأَنَّمَآ أَحْيَا ٱلنَّاسَ جَمِيعًاۚ وَلَقَدْ جَآءَتْهُمْ رُسُلُنَا بِٱلْبَيِّنَٰتِ ثُمَّ إِنَّ كَثِيرًا مِّنْهُم بَعْدَ ذَٰلِكَ فِى ٱلْأَرْضِ لَمُسْرِفُونَ ","translation":"Because of that, We decreed upon the Children of Israel that whoever kills a soul unless for a soul[1] or for corruption [done] in the land[2] - it is as if he had slain mankind entirely. And whoever saves one[3] - it is as if he had saved mankind entirely. And Our messengers had certainly come to them with clear proofs. Then indeed many of them, [even] after that, throughout the land, were transgressors.[4]","words":[{"id":1,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":2,"arabic":"أَجْلِ","translit":"ِlْjgَaʾ","root":"اجل"},{"id":3,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":4,"arabic":"كَتَبْنَا","translit":"āَnْbَtَk","root":"كتب"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"بَنِىٓ","translit":"ٓàِnَb","root":"بني"},{"id":7,"arabic":"إِسْرَٰٓءِيلَ","translit":"َlyِءَٰٓrْsِiʾ","root":""},{"id":8,"arabic":"أَنَّهُۥ","translit":"ۥُhَّnَaʾ","root":""},{"id":9,"arabic":"مَن","translit":"nَm","root":""},{"id":10,"arabic":"قَتَلَ","translit":"َlَtَq","root":"قتل"},{"id":11,"arabic":"نَفْسًۢا","transl