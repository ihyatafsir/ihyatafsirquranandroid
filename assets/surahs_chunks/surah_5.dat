{"surah": 5, "verses": [{"ayah": 1, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَوْفُوا۟ بِٱلْعُقُودِۚ أُحِلَّتْ لَكُم بَهِيمَةُ ٱلْأَنْعَٰمِ إِلَّا مَا يُتْلَىٰ عَلَيْكُمْ غَيْرَ مُحِلِّى ٱلصَّيْدِ وَأَنتُمْ حُرُمٌۗ إِنَّ ٱللَّهَ يَحْكُمُ مَا يُرِيدُ ", "translation": "O you who have believed, fulfill [all] contracts.[1] Lawful for you are the animals of grazing livestock except for that which is recited to you [in this Qur’ān] - hunting not being permitted while you are in the state of iḥrām.[2] Indeed, Allāh ordains what He intends.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "أَوْفُوا۟", "translit": "۟āwُfْwَaʾ", "root": "وفي"}, {"id": 5, "arabic": "بِٱلْعُقُودِ", "translit": "ِdwُqُʿعْlٱِb", "root": "عقد"}, {"id": 6, "arabic": "أُحِلَّتْ", "translit": "ْtَّlِḥُaʾ", "root": "حلل"}, {"id": 7, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 8, "arabic": "بَهِيمَةُ", "translit": "ُẗَmyِhَb", "root": "بهم"}, {"id": 9, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "يُتْلَىٰ", "translit": "ٰàَlْtُy", "root": "تلو"}, {"id": 13, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 14, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 15, "arabic": "مُحِلِّى", "translit": "àِّlِḥُm", "root": "حلل"}, {"id": 16, "arabic": "ٱلصَّيْدِ", "translit": "ِdْyَّṣlٱ", "root": "صيد"}, {"id": 17, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 18, "arabic": "حُرُمٌ", "translit": "ٌmُrُḥ", "root": "حرم"}, {"id": 19, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "يَحْكُمُ", "translit": "ُmُkْḥَy", "root": "حكم"}, {"id": 22, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 23, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}], "hasIhya": true}, {"ayah": 2, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تُحِلُّوا۟ شَعَٰٓئِرَ ٱللَّهِ وَلَا ٱلشَّهْرَ ٱلْحَرَامَ وَلَا ٱلْهَدْىَ وَلَا ٱلْقَلَٰٓئِدَ وَلَآ ءَآمِّينَ ٱلْبَيْتَ ٱلْحَرَامَ يَبْتَغُونَ فَضْلًا مِّن رَّبِّهِمْ وَرِضْوَٰنًاۚ وَإِذَا حَلَلْتُمْ فَٱصْطَادُوا۟ۚ وَلَا يَجْرِمَنَّكُمْ شَنَـَٔانُ قَوْمٍ أَن صَدُّوكُمْ عَنِ ٱلْمَسْجِدِ ٱلْحَرَامِ أَن تَعْتَدُواۘ وَتَعَاوَنُوا۟ عَلَى ٱلْبِرِّ وَٱلتَّقْوَىٰۖ وَلَا تَعَاوَنُوا۟ عَلَى ٱلْإِثْمِ وَٱلْعُدْوَٰنِۚ وَٱتَّقُوا۟ ٱللَّهَۖ إِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ ", "translation": "O you who have believed, do not violate the rites of Allāh or [the sanctity of] the sacred month or [neglect the marking of] the sacrificial animals and garlanding [them] or [violate the safety of] those coming to the Sacred House seeking bounty from their Lord and [His] approval. But when you come out of iḥrām, then [you may] hunt. And do not let the hatred of a people for having obstructed you from al-Masjid al-Ḥarām lead you to transgress. And cooperate in righteousness and piety, but do not cooperate in sin and aggression. And fear Allāh; indeed, Allāh is severe in penalty.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تُحِلُّوا۟", "translit": "۟āwُّlِḥُt", "root": "حلل"}, {"id": 6, "arabic": "شَعَٰٓئِرَ", "translit": "َrِyʾَٰٓʿعَhs", "root": "شعر"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "ٱلشَّهْرَ", "translit": "َrْhَّhslٱ", "root": "شهر"}, {"id": 10, "arabic": "ٱلْحَرَامَ", "translit": "َmāَrَḥْlٱ", "root": "حرم"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "ٱلْهَدْىَ", "translit": "َàْdَhْlٱ", "root": "هدي"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "ٱلْقَلَٰٓئِدَ", "translit": "َdِyʾَٰٓlَqْlٱ", "root": "قلد"}, {"id": 15, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 16, "arabic": "ءَآمِّينَ", "translit": "َnyِّmٓāَء", "root": "امم"}, {"id": 17, "arabic": "ٱلْبَيْتَ", "translit": "َtْyَbْlٱ", "root": "بيت"}, {"id": 18, "arabic": "ٱلْحَرَامَ", "translit": "َmāَrَḥْlٱ", "root": "حرم"}, {"id": 19, "arabic": "يَبْتَغُونَ", "translit": "َnwُغَtْbَy", "root": "بغي"}, {"id": 20, "arabic": "فَضْلًا", "translit": "āًlْḍَf", "root": "فضل"}, {"id": 21, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 22, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 23, "arabic": "وَرِضْوَٰنًا", "translit": "āًnَٰwْḍِrَw", "root": "رضو"}, {"id": 24, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 25, "arabic": "حَلَلْتُمْ", "translit": "ْmُtْlَlَḥ", "root": "حلل"}, {"id": 26, "arabic": "فَٱصْطَادُوا۟", "translit": "۟āwُdāَṭْṣٱَf", "root": "صيد"}, {"id": 27, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 28, "arabic": "يَجْرِمَنَّكُمْ", "translit": "ْmُkَّnَmِrْjgَy", "root": "جرم"}, {"id": 29, "arabic": "شَنَـَٔانُ", "translit": "ُnāَٔـَnَhs", "root": "شنا"}, {"id": 30, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 31, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 32, "arabic": "صَدُّوكُمْ", "translit": "ْmُkwُّdَṣ", "root": "صدد"}, {"id": 33, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 34, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد"}, {"id": 35, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 36, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 37, "arabic": "تَعْتَدُوا۟", "translit": "۟āwُdَtْʿعَt", "root": "عدو"}, {"id": 38, "arabic": "وَتَعَاوَنُوا۟", "translit": "۟āwُnَwāَʿعَtَw", "root": "عون"}, {"id": 39, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 40, "arabic": "ٱلْبِرِّ", "translit": "ِّrِbْlٱ", "root": "برر"}, {"id": 41, "arabic": "وَٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱَw", "root": "وقي"}, {"id": 42, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 43, "arabic": "تَعَاوَنُوا۟", "translit": "۟āwُnَwāَʿعَt", "root": "عون"}, {"id": 44, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 45, "arabic": "ٱلْإِثْمِ", "translit": "ِmْhtِiʾْlٱ", "root": "اثم"}, {"id": 46, "arabic": "وَٱلْعُدْوَٰنِ", "translit": "ِnَٰwْdُʿعْlٱَw", "root": "عدو"}, {"id": 47, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 48, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 49, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 50, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 51, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 52, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}], "hasIhya": true}, {"ayah": 3, "text": "حُرِّمَتْ عَلَيْكُمُ ٱلْمَيْتَةُ وَٱلدَّمُ وَلَحْمُ ٱلْخِنزِيرِ وَمَآ أُهِلَّ لِغَيْرِ ٱللَّهِ بِهِۦ وَٱلْمُنْخَنِقَةُ وَٱلْمَوْقُوذَةُ وَٱلْمُتَرَدِّيَةُ وَٱلنَّطِيحَةُ وَمَآ أَكَلَ ٱلسَّبُعُ إِلَّا مَا ذَكَّيْتُمْ وَمَا ذُبِحَ عَلَى ٱلنُّصُبِ وَأَن تَسْتَقْسِمُوا۟ بِٱلْأَزْلَٰمِۚ ذَٰلِكُمْ فِسْقٌۗ ٱلْيَوْمَ يَئِسَ ٱلَّذِينَ كَفَرُوا۟ مِن دِينِكُمْ فَلَا تَخْشَوْهُمْ وَٱخْشَوْنِۚ ٱلْيَوْمَ أَكْمَلْتُ لَكُمْ دِينَكُمْ وَأَتْمَمْتُ عَلَيْكُمْ نِعْمَتِى وَرَضِيتُ لَكُمُ ٱلْإِسْلَٰمَ دِينًاۚ فَمَنِ ٱضْطُرَّ فِى مَخْمَصَةٍ غَيْرَ مُتَجَانِفٍ لِّإِثْمٍۙ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "Prohibited to you are dead animals,[1] blood, the flesh of swine, and that which has been dedicated to other than Allāh, and [those animals] killed by strangling or by a violent blow or by a head-long fall or by the goring of horns, and those from which a wild animal has eaten, except what you [are able to] slaughter [before its death], and those which are sacrificed on stone altars,[2] and [prohibited is] that you seek decision through divining arrows. That is grave disobedience. This day those who disbelieve have despaired of [defeating] your religion; so fear them not, but fear Me. This day I have perfected for you your religion and completed My favor upon you and have approved for you Islām as religion. But whoever is forced by severe hunger with no inclination to sin - then indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "حُرِّمَتْ", "translit": "ْtَmِّrُḥ", "root": "حرم"}, {"id": 2, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْمَيْتَةُ", "translit": "ُẗَtْyَmْlٱ", "root": "موت"}, {"id": 4, "arabic": "وَٱلدَّمُ", "translit": "ُmَّdlٱَw", "root": "دمو"}, {"id": 5, "arabic": "وَلَحْمُ", "translit": "ُmْḥَlَw", "root": "لحم"}, {"id": 6, "arabic": "ٱلْخِنزِيرِ", "translit": "ِryِznِhkْlٱ", "root": "خنزر"}, {"id": 7, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 8, "arabic": "أُهِلَّ", "translit": "َّlِhُaʾ", "root": "هلل"}, {"id": 9, "arabic": "لِغَيْرِ", "translit": "ِrْyَغِl", "root": "غير"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "وَٱلْمُنْخَنِقَةُ", "translit": "ُẗَqِnَhkْnُmْlٱَw", "root": "خنق"}, {"id": 13, "arabic": "وَٱلْمَوْقُوذَةُ", "translit": "ُẗَhdwُqْwَmْlٱَw", "root": "وقذ"}, {"id": 14, "arabic": "وَٱلْمُتَرَدِّيَةُ", "translit": "ُẗَyِّdَrَtُmْlٱَw", "root": "ردي"}, {"id": 15, "arabic": "وَٱلنَّطِيحَةُ", "translit": "ُẗَḥyِṭَّnlٱَw", "root": "نطح"}, {"id": 16, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 17, "arabic": "أَكَلَ", "translit": "َlَkَaʾ", "root": "اكل"}, {"id": 18, "arabic": "ٱلسَّبُعُ", "translit": "ُʿعُbَّslٱ", "root": "سبع"}, {"id": 19, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 21, "arabic": "ذَكَّيْتُمْ", "translit": "ْmُtْyَّkَhd", "root": "ذكو"}, {"id": 22, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 23, "arabic": "ذُبِحَ", "translit": "َḥِbُhd", "root": "ذبح"}, {"id": 24, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 25, "arabic": "ٱلنُّصُبِ", "translit": "ِbُṣُّnlٱ", "root": "نصب"}, {"id": 26, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 27, "arabic": "تَسْتَقْسِمُوا۟", "translit": "۟āwُmِsْqَtْsَt", "root": "قسم"}, {"id": 28, "arabic": "بِٱلْأَزْلَٰمِ", "translit": "ِmَٰlْzَaʾْlٱِb", "root": "زلم"}, {"id": 29, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 30, "arabic": "فِسْقٌ", "translit": "ٌqْsِf", "root": "فسق"}, {"id": 31, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 32, "arabic": "يَئِسَ", "translit": "َsِyʾَy", "root": "ياس"}, {"id": 33, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 34, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 35, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 36, "arabic": "دِينِكُمْ", "translit": "ْmُkِnyِd", "root": "دين"}, {"id": 37, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 38, "arabic": "تَخْشَوْهُمْ", "translit": "ْmُhْwَhsْhkَt", "root": "خشي"}, {"id": 39, "arabic": "وَٱخْشَوْنِ", "translit": "ِnْwَhsْhkٱَw", "root": "خشي"}, {"id": 40, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 41, "arabic": "أَكْمَلْتُ", "translit": "ُtْlَmْkَaʾ", "root": "كمل"}, {"id": 42, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 43, "arabic": "دِينَكُمْ", "translit": "ْmُkَnyِd", "root": "دين"}, {"id": 44, "arabic": "وَأَتْمَمْتُ", "translit": "ُtْmَmْtَaʾَw", "root": "تمم"}, {"id": 45, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 46, "arabic": "نِعْمَتِى", "translit": "àِtَmْʿعِn", "root": "نعم"}, {"id": 47, "arabic": "وَرَضِيتُ", "translit": "ُtyِḍَrَw", "root": "رضو"}, {"id": 48, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 49, "arabic": "ٱلْإِسْلَٰمَ", "translit": "َmَٰlْsِiʾْlٱ", "root": "سلم"}, {"id": 50, "arabic": "دِينًا", "translit": "āًnyِd", "root": "دين"}, {"id": 51, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 52, "arabic": "ٱضْطُرَّ", "translit": "َّrُṭْḍٱ", "root": "ضرر"}, {"id": 53, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 54, "arabic": "مَخْمَصَةٍ", "translit": "ٍẗَṣَmْhkَm", "root": "خمص"}, {"id": 55, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 56, "arabic": "مُتَجَانِفٍ", "translit": "ٍfِnāَjgَtُm", "root": "جنف"}, {"id": 57, "arabic": "لِّإِثْمٍ", "translit": "ٍmْhtِiʾِّl", "root": "اثم"}, {"id": 58, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 59, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 60, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 61, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 4, "text": "يَسْـَٔلُونَكَ مَاذَآ أُحِلَّ لَهُمْۖ قُلْ أُحِلَّ لَكُمُ ٱلطَّيِّبَٰتُۙ وَمَا عَلَّمْتُم مِّنَ ٱلْجَوَارِحِ مُكَلِّبِينَ تُعَلِّمُونَهُنَّ مِمَّا عَلَّمَكُمُ ٱللَّهُۖ فَكُلُوا۟ مِمَّآ أَمْسَكْنَ عَلَيْكُمْ وَٱذْكُرُوا۟ ٱسْمَ ٱللَّهِ عَلَيْهِۖ وَٱتَّقُوا۟ ٱللَّهَۚ إِنَّ ٱللَّهَ سَرِيعُ ٱلْحِسَابِ ", "translation": "They ask you, [O Muḥammad], what has been made lawful for them. Say, \"Lawful for you are [all] good foods and [game caught by] what you have trained of hunting animals[1] which you train as Allāh has taught you. So eat of what they catch for you, and mention the name of Allāh upon it, and fear Allāh.\" Indeed, Allāh is swift in account.", "words": [{"id": 1, "arabic": "يَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَy", "root": "سال"}, {"id": 2, "arabic": "مَاذَآ", "translit": "ٓāَhdāَm", "root": ""}, {"id": 3, "arabic": "أُحِلَّ", "translit": "َّlِḥُaʾ", "root": "حلل"}, {"id": 4, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 5, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 6, "arabic": "أُحِلَّ", "translit": "َّlِḥُaʾ", "root": "حلل"}, {"id": 7, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 8, "arabic": "ٱلطَّيِّبَٰتُ", "translit": "ُtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "عَلَّمْتُم", "translit": "mُtْmَّlَʿع", "root": "علم"}, {"id": 11, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 12, "arabic": "ٱلْجَوَارِحِ", "translit": "ِḥِrāَwَjgْlٱ", "root": "جرح"}, {"id": 13, "arabic": "مُكَلِّبِينَ", "translit": "َnyِbِّlَkُm", "root": "كلب"}, {"id": 14, "arabic": "تُعَلِّمُونَهُنَّ", "translit": "َّnُhَnwُmِّlَʿعُt", "root": "علم"}, {"id": 15, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 16, "arabic": "عَلَّمَكُمُ", "translit": "ُmُkَmَّlَʿع", "root": "علم"}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "فَكُلُوا۟", "translit": "۟āwُlُkَf", "root": "اكل"}, {"id": 19, "arabic": "مِمَّآ", "translit": "ٓāَّmِm", "root": ""}, {"id": 20, "arabic": "أَمْسَكْنَ", "translit": "َnْkَsْmَaʾ", "root": "مسك"}, {"id": 21, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 22, "arabic": "وَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَw", "root": "ذكر"}, {"id": 23, "arabic": "ٱسْمَ", "translit": "َmْsٱ", "root": "سمو"}, {"id": 24, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 26, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 27, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 29, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "سَرِيعُ", "translit": "ُʿعyِrَs", "root": "سرع"}, {"id": 31, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": false}, {"ayah": 5, "text": "ٱلْيَوْمَ أُحِلَّ لَكُمُ ٱلطَّيِّبَٰتُۖ وَطَعَامُ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ حِلٌّ لَّكُمْ وَطَعَامُكُمْ حِلٌّ لَّهُمْۖ وَٱلْمُحْصَنَٰتُ مِنَ ٱلْمُؤْمِنَٰتِ وَٱلْمُحْصَنَٰتُ مِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ مِن قَبْلِكُمْ إِذَآ ءَاتَيْتُمُوهُنَّ أُجُورَهُنَّ مُحْصِنِينَ غَيْرَ مُسَٰفِحِينَ وَلَا مُتَّخِذِىٓ أَخْدَانٍۗ وَمَن يَكْفُرْ بِٱلْإِيمَٰنِ فَقَدْ حَبِطَ عَمَلُهُۥ وَهُوَ فِى ٱلْءَاخِرَةِ مِنَ ٱلْخَٰسِرِينَ ", "translation": "This day [all] good foods have been made lawful, and the food of those who were given the Scripture is lawful for you and your food is lawful for them. And [lawful in marriage are] chaste women from among the believers and chaste women from among those who were given the Scripture before you, when you have given them their due compensation,[1] desiring chastity, not unlawful sexual intercourse or taking [secret] lovers. And whoever denies the faith - his work has become worthless, and he, in the Hereafter, will be among the losers.", "words": [{"id": 1, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 2, "arabic": "أُحِلَّ", "translit": "َّlِḥُaʾ", "root": "حلل"}, {"id": 3, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 4, "arabic": "ٱلطَّيِّبَٰتُ", "translit": "ُtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 5, "arabic": "وَطَعَامُ", "translit": "ُmāَʿعَṭَw", "root": "طعم"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 8, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 9, "arabic": "حِلٌّ", "translit": "ٌّlِḥ", "root": "حلل"}, {"id": 10, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 11, "arabic": "وَطَعَامُكُمْ", "translit": "ْmُkُmāَʿعَṭَw", "root": "طعم"}, {"id": 12, "arabic": "حِلٌّ", "translit": "ٌّlِḥ", "root": "حلل"}, {"id": 13, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 14, "arabic": "وَٱلْمُحْصَنَٰتُ", "translit": "ُtَٰnَṣْḥُmْlٱَw", "root": "حصن"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱ", "root": "امن"}, {"id": 17, "arabic": "وَٱلْمُحْصَنَٰتُ", "translit": "ُtَٰnَṣْḥُmْlٱَw", "root": "حصن"}, {"id": 18, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 19, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 21, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 22, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 23, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 24, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 25, "arabic": "ءَاتَيْتُمُوهُنَّ", "translit": "َّnُhwُmُtْyَtāَء", "root": "اتي"}, {"id": 26, "arabic": "أُجُورَهُنَّ", "translit": "َّnُhَrwُjgُaʾ", "root": "اجر"}, {"id": 27, "arabic": "مُحْصِنِينَ", "translit": "َnyِnِṣْḥُm", "root": "حصن"}, {"id": 28, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 29, "arabic": "مُسَٰفِحِينَ", "translit": "َnyِḥِfَٰsُm", "root": "سفح"}, {"id": 30, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 31, "arabic": "مُتَّخِذِىٓ", "translit": "ٓàِhdِhkَّtُm", "root": "اخذ"}, {"id": 32, "arabic": "أَخْدَانٍ", "translit": "ٍnāَdْhkَaʾ", "root": "خدن"}, {"id": 33, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 34, "arabic": "يَكْفُرْ", "translit": "ْrُfْkَy", "root": "كفر"}, {"id": 35, "arabic": "بِٱلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlٱِb", "root": "امن"}, {"id": 36, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 37, "arabic": "حَبِطَ", "translit": "َṭِbَḥ", "root": "حبط"}, {"id": 38, "arabic": "عَمَلُهُۥ", "translit": "ۥُhُlَmَʿع", "root": "عمل"}, {"id": 39, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 40, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 41, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 42, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 43, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 6, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا قُمْتُمْ إِلَى ٱلصَّلَوٰةِ فَٱغْسِلُوا۟ وُجُوهَكُمْ وَأَيْدِيَكُمْ إِلَى ٱلْمَرَافِقِ وَٱمْسَحُوا۟ بِرُءُوسِكُمْ وَأَرْجُلَكُمْ إِلَى ٱلْكَعْبَيْنِۚ وَإِن كُنتُمْ جُنُبًا فَٱطَّهَّرُوا۟ۚ وَإِن كُنتُم مَّرْضَىٰٓ أَوْ عَلَىٰ سَفَرٍ أَوْ جَآءَ أَحَدٌ مِّنكُم مِّنَ ٱلْغَآئِطِ أَوْ لَٰمَسْتُمُ ٱلنِّسَآءَ فَلَمْ تَجِدُوا۟ مَآءً فَتَيَمَّمُوا۟ صَعِيدًا طَيِّبًا فَٱمْسَحُوا۟ بِوُجُوهِكُمْ وَأَيْدِيكُم مِّنْهُۚ مَا يُرِيدُ ٱللَّهُ لِيَجْعَلَ عَلَيْكُم مِّنْ حَرَجٍ وَلَٰكِن يُرِيدُ لِيُطَهِّرَكُمْ وَلِيُتِمَّ نِعْمَتَهُۥ عَلَيْكُمْ لَعَلَّكُمْ تَشْكُرُونَ ", "translation": "O you who have believed, when you rise to [perform] prayer, wash your faces and your forearms to the elbows and wipe over your heads and wash your feet to the ankles. And if you are in a state of janābah,[1] then purify yourselves. But if you are ill or on a journey or one of you comes from the place of relieving himself or you have contacted women[2] and do not find water, then seek clean earth and wipe over your faces and hands with it. Allāh does not intend to make difficulty for you, but He intends to purify you and complete His favor upon you that you may be grateful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "قُمْتُمْ", "translit": "ْmُtْmُq", "root": "قوم"}, {"id": 6, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 8, "arabic": "فَٱغْسِلُوا۟", "translit": "۟āwُlِsْغٱَf", "root": "غسل"}, {"id": 9, "arabic": "وُجُوهَكُمْ", "translit": "ْmُkَhwُjgُw", "root": "وجه"}, {"id": 10, "arabic": "وَأَيْدِيَكُمْ", "translit": "ْmُkَyِdْyَaʾَw", "root": "يدي"}, {"id": 11, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلْمَرَافِقِ", "translit": "ِqِfāَrَmْlٱ", "root": "رفق"}, {"id": 13, "arabic": "وَٱمْسَحُوا۟", "translit": "۟āwُḥَsْmٱَw", "root": "مسح"}, {"id": 14, "arabic": "بِرُءُوسِكُمْ", "translit": "ْmُkِswُءُrِb", "root": "راس"}, {"id": 15, "arabic": "وَأَرْجُلَكُمْ", "translit": "ْmُkَlُjgْrَaʾَw", "root": "رجل"}, {"id": 16, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱلْكَعْبَيْنِ", "translit": "ِnْyَbْʿعَkْlٱ", "root": "كعب"}, {"id": 18, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 19, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 20, "arabic": "جُنُبًا", "translit": "āًbُnُjg", "root": "جنب"}, {"id": 21, "arabic": "فَٱطَّهَّرُوا۟", "translit": "۟āwُrَّhَّṭٱَf", "root": "طهر"}, {"id": 22, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 23, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 24, "arabic": "مَّرْضَىٰٓ", "translit": "ٰٓàَḍْrَّm", "root": "مرض"}, {"id": 25, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 26, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 27, "arabic": "سَفَرٍ", "translit": "ٍrَfَs", "root": "سفر"}, {"id": 28, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 29, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 30, "arabic": "أَحَدٌ", "translit": "ٌdَḥَaʾ", "root": "احد"}, {"id": 31, "arabic": "مِّنكُم", "translit": "mُknِّm", "root": ""}, {"id": 32, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 33, "arabic": "ٱلْغَآئِطِ", "translit": "ِṭِyʾٓāَغْlٱ", "root": "غوط"}, {"id": 34, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 35, "arabic": "لَٰمَسْتُمُ", "translit": "ُmُtْsَmَٰl", "root": "لمس"}, {"id": 36, "arabic": "ٱلنِّسَآءَ", "translit": "َءٓāَsِّnlٱ", "root": "نسو"}, {"id": 37, "arabic": "فَلَمْ", "translit": "ْmَlَf", "root": ""}, {"id": 38, "arabic": "تَجِدُوا۟", "translit": "۟āwُdِjgَt", "root": "وجد"}, {"id": 39, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 40, "arabic": "فَتَيَمَّمُوا۟", "translit": "۟āwُmَّmَyَtَf", "root": "يمم"}, {"id": 41, "arabic": "صَعِيدًا", "translit": "āًdyِʿعَṣ", "root": "صعد"}, {"id": 42, "arabic": "طَيِّبًا", "translit": "āًbِّyَṭ", "root": "طيب"}, {"id": 43, "arabic": "فَٱمْسَحُوا۟", "translit": "۟āwُḥَsْmٱَf", "root": "مسح"}, {"id": 44, "arabic": "بِوُجُوهِكُمْ", "translit": "ْmُkِhwُjgُwِb", "root": "وجه"}, {"id": 45, "arabic": "وَأَيْدِيكُم", "translit": "mُkyِdْyَaʾَw", "root": "يدي"}, {"id": 46, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 47, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 48, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 49, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 50, "arabic": "لِيَجْعَلَ", "translit": "َlَʿعْjgَyِl", "root": "جعل"}, {"id": 51, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 52, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 53, "arabic": "حَرَجٍ", "translit": "ٍjgَrَḥ", "root": "حرج"}, {"id": 54, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 55, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 56, "arabic": "لِيُطَهِّرَكُمْ", "translit": "ْmُkَrِّhَṭُyِl", "root": "طهر"}, {"id": 57, "arabic": "وَلِيُتِمَّ", "translit": "َّmِtُyِlَw", "root": "تمم"}, {"id": 58, "arabic": "نِعْمَتَهُۥ", "translit": "ۥُhَtَmْʿعِn", "root": "نعم"}, {"id": 59, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 60, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 61, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": true}, {"ayah": 7, "text": "وَٱذْكُرُوا۟ نِعْمَةَ ٱللَّهِ عَلَيْكُمْ وَمِيثَٰقَهُ ٱلَّذِى وَاثَقَكُم بِهِۦٓ إِذْ قُلْتُمْ سَمِعْنَا وَأَطَعْنَاۖ وَٱتَّقُوا۟ ٱللَّهَۚ إِنَّ ٱللَّهَ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ", "translation": "And remember the favor of Allāh upon you and His covenant with which He bound you when you said, \"We hear and we obey\"; and fear Allāh. Indeed, Allāh is Knowing of that within the breasts.", "words": [{"id": 1, "arabic": "وَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "نِعْمَةَ", "translit": "َẗَmْʿعِn", "root": "نعم"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "وَمِيثَٰقَهُ", "translit": "ُhَqَٰhtyِmَw", "root": "وثق"}, {"id": 6, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "وَاثَقَكُم", "translit": "mُkَqَhtāَw", "root": "وثق"}, {"id": 8, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 9, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 10, "arabic": "قُلْتُمْ", "translit": "ْmُtْlُq", "root": "قول"}, {"id": 11, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 12, "arabic": "وَأَطَعْنَا", "translit": "āَnْʿعَṭَaʾَw", "root": "طوع"}, {"id": 13, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 18, "arabic": "بِذَاتِ", "translit": "ِtāَhdِb", "root": ""}, {"id": 19, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": true}, {"ayah": 8, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ كُونُوا۟ قَوَّٰمِينَ لِلَّهِ شُهَدَآءَ بِٱلْقِسْطِۖ وَلَا يَجْرِمَنَّكُمْ شَنَـَٔانُ قَوْمٍ عَلَىٰٓ أَلَّا تَعْدِلُوا۟ۚ ٱعْدِلُوا۟ هُوَ أَقْرَبُ لِلتَّقْوَىٰۖ وَٱتَّقُوا۟ ٱللَّهَۚ إِنَّ ٱللَّهَ خَبِيرٌۢ بِمَا تَعْمَلُونَ ", "translation": "O you who have believed, be persistently standing firm for Allāh, witnesses in justice, and do not let the hatred of a people prevent you from being just. Be just; that is nearer to righteousness. And fear Allāh; indeed, Allāh is [fully] Aware of what you do.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "كُونُوا۟", "translit": "۟āwُnwُk", "root": "كون"}, {"id": 5, "arabic": "قَوَّٰمِينَ", "translit": "َnyِmَّٰwَq", "root": "قوم"}, {"id": 6, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 7, "arabic": "شُهَدَآءَ", "translit": "َءٓāَdَhُhs", "root": "شهد"}, {"id": 8, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يَجْرِمَنَّكُمْ", "translit": "ْmُkَّnَmِrْjgَy", "root": "جرم"}, {"id": 11, "arabic": "شَنَـَٔانُ", "translit": "ُnāَٔـَnَhs", "root": "شنا"}, {"id": 12, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 13, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 14, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 15, "arabic": "تَعْدِلُوا۟", "translit": "۟āwُlِdْʿعَt", "root": "عدل"}, {"id": 16, "arabic": "ٱعْدِلُوا۟", "translit": "۟āwُlِdْʿعٱ", "root": "عدل"}, {"id": 17, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 18, "arabic": "أَقْرَبُ", "translit": "ُbَrْqَaʾ", "root": "قرب"}, {"id": 19, "arabic": "لِلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlِl", "root": "وقي"}, {"id": 20, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 21, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 23, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 25, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 26, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 9, "text": "وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِۙ لَهُم مَّغْفِرَةٌ وَأَجْرٌ عَظِيمٌ ", "translation": "Allāh has promised those who believe and do righteous deeds [that] for them there is forgiveness and great reward.", "words": [{"id": 1, "arabic": "وَعَدَ", "translit": "َdَʿعَw", "root": "وعد"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 6, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 7, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 8, "arabic": "مَّغْفِرَةٌ", "translit": "ٌẗَrِfْغَّm", "root": "غفر"}, {"id": 9, "arabic": "وَأَجْرٌ", "translit": "ٌrْjgَaʾَw", "root": "اجر"}, {"id": 10, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 10, "text": "وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَٰتِنَآ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْجَحِيمِ ", "translation": "But those who disbelieve and deny Our signs - those are the companions of Hellfire.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 3, "arabic": "وَكَذَّبُوا۟", "translit": "۟āwُbَّhdَkَw", "root": "كذب"}, {"id": 4, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 6, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 7, "arabic": "ٱلْجَحِيمِ", "translit": "ِmyِḥَjgْlٱ", "root": "جحم"}], "hasIhya": false}, {"ayah": 11, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱذْكُرُوا۟ نِعْمَتَ ٱللَّهِ عَلَيْكُمْ إِذْ هَمَّ قَوْمٌ أَن يَبْسُطُوٓا۟ إِلَيْكُمْ أَيْدِيَهُمْ فَكَفَّ أَيْدِيَهُمْ عَنكُمْۖ وَٱتَّقُوا۟ ٱللَّهَۚ وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ ٱلْمُؤْمِنُونَ ", "translation": "O you who have believed, remember the favor of Allāh upon you when a people determined to extend their hands [in aggression] against you, but He withheld their hands from you; and fear Allāh. And upon Allāh let the believers rely.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱ", "root": "ذكر"}, {"id": 5, "arabic": "نِعْمَتَ", "translit": "َtَmْʿعِn", "root": "نعم"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 9, "arabic": "هَمَّ", "translit": "َّmَh", "root": "همم"}, {"id": 10, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَبْسُطُوٓا۟", "translit": "۟āٓwُṭُsْbَy", "root": "بسط"}, {"id": 13, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 14, "arabic": "أَيْدِيَهُمْ", "translit": "ْmُhَyِdْyَaʾ", "root": "يدي"}, {"id": 15, "arabic": "فَكَفَّ", "translit": "َّfَkَf", "root": "كفف"}, {"id": 16, "arabic": "أَيْدِيَهُمْ", "translit": "ْmُhَyِdْyَaʾ", "root": "يدي"}, {"id": 17, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 18, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "فَلْيَتَوَكَّلِ", "translit": "ِlَّkَwَtَyْlَf", "root": "وكل"}, {"id": 23, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": true}, {"ayah": 12, "text": "وَلَقَدْ أَخَذَ ٱللَّهُ مِيثَٰقَ بَنِىٓ إِسْرَٰٓءِيلَ وَبَعَثْنَا مِنْهُمُ ٱثْنَىْ عَشَرَ نَقِيبًاۖ وَقَالَ ٱللَّهُ إِنِّى مَعَكُمْۖ لَئِنْ أَقَمْتُمُ ٱلصَّلَوٰةَ وَءَاتَيْتُمُ ٱلزَّكَوٰةَ وَءَامَنتُم بِرُسُلِى وَعَزَّرْتُمُوهُمْ وَأَقْرَضْتُمُ ٱللَّهَ قَرْضًا حَسَنًا لَّأُكَفِّرَنَّ عَنكُمْ سَيِّـَٔاتِكُمْ وَلَأُدْخِلَنَّكُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۚ فَمَن كَفَرَ بَعْدَ ذَٰلِكَ مِنكُمْ فَقَدْ ضَلَّ سَوَآءَ ٱلسَّبِيلِ ", "translation": "And Allāh had already taken a covenant from the Children of Israel, and We delegated from among them twelve leaders. And Allāh said, \"I am with you. If you establish prayer and give zakāh and believe in My messengers and support them and loan Allāh a goodly loan,[1] I will surely remove from you your misdeeds and admit you to gardens beneath which rivers flow. But whoever of you disbelieves after that has certainly strayed from the soundness of the way.\"", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَخَذَ", "translit": "َhdَhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "مِيثَٰقَ", "translit": "َqَٰhtyِm", "root": "وثق"}, {"id": 5, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 6, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 7, "arabic": "وَبَعَثْنَا", "translit": "āَnْhtَʿعَbَw", "root": "بعث"}, {"id": 8, "arabic": "مِنْهُمُ", "translit": "ُmُhْnِm", "root": ""}, {"id": 9, "arabic": "ٱثْنَىْ", "translit": "ْàَnْhtٱ", "root": "ثني"}, {"id": 10, "arabic": "عَشَرَ", "translit": "َrَhsَʿع", "root": "عشر"}, {"id": 11, "arabic": "نَقِيبًا", "translit": "āًbyِqَn", "root": "نقب"}, {"id": 12, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 15, "arabic": "مَعَكُمْ", "translit": "ْmُkَʿعَm", "root": ""}, {"id": 16, "arabic": "لَئِنْ", "translit": "ْnِyʾَl", "root": ""}, {"id": 17, "arabic": "أَقَمْتُمُ", "translit": "ُmُtْmَqَaʾ", "root": "قوم"}, {"id": 18, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 19, "arabic": "وَءَاتَيْتُمُ", "translit": "ُmُtْyَtāَءَw", "root": "اتي"}, {"id": 20, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 21, "arabic": "وَءَامَنتُم", "translit": "mُtnَmāَءَw", "root": "امن"}, {"id": 22, "arabic": "بِرُسُلِى", "translit": "àِlُsُrِb", "root": "رسل"}, {"id": 23, "arabic": "وَعَزَّرْتُمُوهُمْ", "translit": "ْmُhwُmُtْrَّzَʿعَw", "root": "عزر"}, {"id": 24, "arabic": "وَأَقْرَضْتُمُ", "translit": "ُmُtْḍَrْqَaʾَw", "root": "قرض"}, {"id": 25, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "قَرْضًا", "translit": "āًḍْrَq", "root": "قرض"}, {"id": 27, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 28, "arabic": "لَّأُكَفِّرَنَّ", "translit": "َّnَrِّfَkُaʾَّl", "root": "كفر"}, {"id": 29, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 30, "arabic": "سَيِّـَٔاتِكُمْ", "translit": "ْmُkِtāَٔـِّyَs", "root": "سوا"}, {"id": 31, "arabic": "وَلَأُدْخِلَنَّكُمْ", "translit": "ْmُkَّnَlِhkْdُaʾَlَw", "root": "دخل"}, {"id": 32, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 33, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 34, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 35, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 36, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 37, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 38, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 39, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 40, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 41, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 42, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 43, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 44, "arabic": "سَوَآءَ", "translit": "َءٓāَwَs", "root": "سوي"}, {"id": 45, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}], "hasIhya": false}, {"ayah": 13, "text": "فَبِمَا نَقْضِهِم مِّيثَٰقَهُمْ لَعَنَّٰهُمْ وَجَعَلْنَا قُلُوبَهُمْ قَٰسِيَةًۖ يُحَرِّفُونَ ٱلْكَلِمَ عَن مَّوَاضِعِهِۦۙ وَنَسُوا۟ حَظًّا مِّمَّا ذُكِّرُوا۟ بِهِۦۚ وَلَا تَزَالُ تَطَّلِعُ عَلَىٰ خَآئِنَةٍ مِّنْهُمْ إِلَّا قَلِيلًا مِّنْهُمْۖ فَٱعْفُ عَنْهُمْ وَٱصْفَحْۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُحْسِنِينَ ", "translation": "So for their breaking of the covenant We cursed them and made their hearts hardened. They distort words from their [proper] places [i.e., usages] and have forgotten a portion of that of which they were reminded.[1] And you will still observe deceit among them, except a few of them. But pardon them and overlook [their misdeeds]. Indeed, Allāh loves the doers of good.", "words": [{"id": 1, "arabic": "فَبِمَا", "translit": "āَmِbَf", "root": ""}, {"id": 2, "arabic": "نَقْضِهِم", "translit": "mِhِḍْqَn", "root": "نقض"}, {"id": 3, "arabic": "مِّيثَٰقَهُمْ", "translit": "ْmُhَqَٰhtyِّm", "root": "وثق"}, {"id": 4, "arabic": "لَعَنَّٰهُمْ", "translit": "ْmُhَّٰnَʿعَl", "root": "لعن"}, {"id": 5, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "قُلُوبَهُمْ", "translit": "ْmُhَbwُlُq", "root": "قلب"}, {"id": 7, "arabic": "قَٰسِيَةً", "translit": "ًẗَyِsَٰq", "root": "قسو"}, {"id": 8, "arabic": "يُحَرِّفُونَ", "translit": "َnwُfِّrَḥُy", "root": "حرف"}, {"id": 9, "arabic": "ٱلْكَلِمَ", "translit": "َmِlَkْlٱ", "root": "كلم"}, {"id": 10, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 11, "arabic": "مَّوَاضِعِهِۦ", "translit": "ۦِhِʿعِḍāَwَّm", "root": "وضع"}, {"id": 12, "arabic": "وَنَسُوا۟", "translit": "۟āwُsَnَw", "root": "نسي"}, {"id": 13, "arabic": "حَظًّا", "translit": "āًّẓَḥ", "root": "حظظ"}, {"id": 14, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 15, "arabic": "ذُكِّرُوا۟", "translit": "۟āwُrِّkُhd", "root": "ذكر"}, {"id": 16, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "تَزَالُ", "translit": "ُlāَzَt", "root": "زيل"}, {"id": 19, "arabic": "تَطَّلِعُ", "translit": "ُʿعِlَّṭَt", "root": "طلع"}, {"id": 20, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 21, "arabic": "خَآئِنَةٍ", "translit": "ٍẗَnِyʾٓāَhk", "root": "خون"}, {"id": 22, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 23, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 24, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 25, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 26, "arabic": "فَٱعْفُ", "translit": "ُfْʿعٱَf", "root": "عفو"}, {"id": 27, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 28, "arabic": "وَٱصْفَحْ", "translit": "ْḥَfْṣٱَw", "root": "صفح"}, {"id": 29, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 30, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 31, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 32, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": true}, {"ayah": 14, "text": "وَمِنَ ٱلَّذِينَ قَالُوٓا۟ إِنَّا نَصَٰرَىٰٓ أَخَذْنَا مِيثَٰقَهُمْ فَنَسُوا۟ حَظًّا مِّمَّا ذُكِّرُوا۟ بِهِۦ فَأَغْرَيْنَا بَيْنَهُمُ ٱلْعَدَاوَةَ وَٱلْبَغْضَآءَ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِۚ وَسَوْفَ يُنَبِّئُهُمُ ٱللَّهُ بِمَا كَانُوا۟ يَصْنَعُونَ ", "translation": "And from those who say, \"We are Christians\" We took their covenant; but they forgot a portion of that of which they were reminded.[1] So We caused among them[2] animosity and hatred until the Day of Resurrection. And Allāh is going to inform them about what they used to do.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 4, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 5, "arabic": "نَصَٰرَىٰٓ", "translit": "ٰٓàَrَٰṣَn", "root": "نصر"}, {"id": 6, "arabic": "أَخَذْنَا", "translit": "āَnْhdَhkَaʾ", "root": "اخذ"}, {"id": 7, "arabic": "مِيثَٰقَهُمْ", "translit": "ْmُhَqَٰhtyِm", "root": "وثق"}, {"id": 8, "arabic": "فَنَسُوا۟", "translit": "۟āwُsَnَf", "root": "نسي"}, {"id": 9, "arabic": "حَظًّا", "translit": "āًّẓَḥ", "root": "حظظ"}, {"id": 10, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 11, "arabic": "ذُكِّرُوا۟", "translit": "۟āwُrِّkُhd", "root": "ذكر"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "فَأَغْرَيْنَا", "translit": "āَnْyَrْغَaʾَf", "root": "غرو"}, {"id": 14, "arabic": "بَيْنَهُمُ", "translit": "ُmُhَnْyَb", "root": "بين"}, {"id": 15, "arabic": "ٱلْعَدَاوَةَ", "translit": "َẗَwāَdَʿعْlٱ", "root": "عدو"}, {"id": 16, "arabic": "وَٱلْبَغْضَآءَ", "translit": "َءٓāَḍْغَbْlٱَw", "root": "بغض"}, {"id": 17, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 18, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 19, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 20, "arabic": "وَسَوْفَ", "translit": "َfْwَsَw", "root": ""}, {"id": 21, "arabic": "يُنَبِّئُهُمُ", "translit": "ُmُhُyʾِّbَnُy", "root": "نبا"}, {"id": 22, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 24, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 25, "arabic": "يَصْنَعُونَ", "translit": "َnwُʿعَnْṣَy", "root": "صنع"}], "hasIhya": true}, {"ayah": 15, "text": "يَٰٓأَهْلَ ٱلْكِتَٰبِ قَدْ جَآءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ كَثِيرًا مِّمَّا كُنتُمْ تُخْفُونَ مِنَ ٱلْكِتَٰبِ وَيَعْفُوا۟ عَن كَثِيرٍۚ قَدْ جَآءَكُم مِّنَ ٱللَّهِ نُورٌ وَكِتَٰبٌ مُّبِينٌ ", "translation": "O People of the Scripture, there has come to you Our Messenger making clear to you much of what you used to conceal of the Scripture and overlooking much.[1] There has come to you from Allāh a light and a clear Book [i.e., the Qur’ān]", "words": [{"id": 1, "arabic": "يَٰٓأَهْلَ", "translit": "َlْhَaʾَٰٓy", "root": "اهل"}, {"id": 2, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "رَسُولُنَا", "translit": "āَnُlwُsَr", "root": "رسل"}, {"id": 6, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 8, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 9, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 11, "arabic": "تُخْفُونَ", "translit": "َnwُfْhkُt", "root": "خفي"}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 14, "arabic": "وَيَعْفُوا۟", "translit": "۟āwُfْʿعَyَw", "root": "عفو"}, {"id": 15, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 16, "arabic": "كَثِيرٍ", "translit": "ٍryِhtَk", "root": "كثر"}, {"id"