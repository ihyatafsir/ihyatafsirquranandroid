"},{"id":16,"arabic":"وَءَاتَىٰكُم","translit":"mُkٰàَtāَءَw","root":"اتي"},{"id":17,"arabic":"مَّا","translit":"āَّm","root":""},{"id":18,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":19,"arabic":"يُؤْتِ","translit":"ِtْwʾُy","root":"اتي"},{"id":20,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"},{"id":21,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":22,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":21,"text":"يَٰقَوْمِ ٱدْخُلُوا۟ ٱلْأَرْضَ ٱلْمُقَدَّسَةَ ٱلَّتِى كَتَبَ ٱللَّهُ لَكُمْ وَلَا تَرْتَدُّوا۟ عَلَىٰٓ أَدْبَارِكُمْ فَتَنقَلِبُوا۟ خَٰسِرِينَ ","translation":"O my people, enter the blessed land [i.e., Palestine] which Allāh has assigned to you and do not turn back [from fighting in Allāh's cause] and [thus] become losers.\"","words":[{"id":1,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":2,"arabic":"ٱدْخُلُوا۟","translit":"۟āwُlُhkْdٱ","root":"دخل"},{"id":3,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":4,"arabic":"ٱلْمُقَدَّسَةَ","translit":"َẗَsَّdَqُmْlٱ","root":"قدس"},{"id":5,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":6,"arabic":"كَتَبَ","translit":"َbَtَk","root":"كتب"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"تَرْتَدُّوا۟","translit":"۟āwُّdَtْrَt","root":"ردد"},{"id":11,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":12,"arabic":"أَدْبَارِكُمْ","translit":"ْmُkِrāَbْdَaʾ","root":"دبر"},{"id":13,"arabic":"فَتَنقَلِبُوا۟","translit":"۟āwُbِlَqnَtَf","root":"قلب"},{"id":14,"arabic":"خَٰسِرِينَ","translit":"َnyِrِsَٰhk","root":"خسر"}],"hasIhya":false},{"ayah":22,"text":"قَالُوا۟ يَٰمُوسَىٰٓ إِنَّ فِيهَا قَوْمًا جَبَّارِينَ وَإِنَّا لَن نَّدْخُلَهَا حَتَّىٰ يَخْرُجُوا۟ مِنْهَا فَإِن يَخْرُجُوا۟ مِنْهَا فَإِنَّا دَٰخِلُونَ ","translation":"They said, \"O Moses, indeed within it is a people of tyrannical strength, and indeed, we will never enter it until they leave it; but if they leave it, then we will enter.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"يَٰمُوسَىٰٓ","translit":"ٰٓàَswُmَٰy","root":""},{"id":3,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":4,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":5,"arabic":"قَوْمًا","translit":"āًmْwَq","root":"قوم"},{"id":6,"arabic":"جَبَّارِينَ","translit":"َnyِrāَّbَjg","root":"جبر"},{"id":7,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":8,"arabic":"لَن","translit":"nَl","root":""},{"id":9,"arabic":"نَّدْخُلَهَا","translit":"āَhَlُhkْdَّn","root":"دخل"},{"id":10,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":11,"arabic":"يَخْرُجُوا۟","translit":"۟āwُjgُrْhkَy","root":"خرج"},{"id":12,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":13,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":14,"arabic":"يَخْرُجُوا۟","translit":"۟āwُjgُrْhkَy","root":"خرج"},{"id":15,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":16,"arabic":"فَإِنَّا","translit":"āَّnِiʾَf","root":""},{"id":17,"arabic":"دَٰخِلُونَ","translit":"َnwُlِhkَٰd","root":"دخل"}],"hasIhya":false},{"ayah":23,"text":"قَالَ رَجُلَانِ مِنَ ٱلَّذِينَ يَخَافُونَ أَنْعَمَ ٱللَّهُ عَلَيْهِمَا ٱدْخُلُوا۟ عَلَيْهِمُ ٱلْبَابَ فَإِذَا دَخَلْتُمُوهُ فَإِنَّكُمْ غَٰلِبُونَۚ وَعَلَى ٱللَّهِ فَتَوَكَّلُوٓا۟ إِن كُنتُم مُّؤْمِنِينَ ","translation":"Said two men from those who feared [to disobey] upon whom Allāh had bestowed favor, \"Enter upon them through the gate, for when you have entered it, you will be predominant.[1] And upon Allāh rely, if you should be believers.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"رَجُلَانِ","translit":"ِnāَlُjgَr","root":"رجل"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"يَخَافُونَ","translit":"َnwُfāَhkَy","root":"خوف"},{"id":6,"arabic":"أَنْعَمَ","translit":"َmَʿعْnَaʾ","root":"نعم"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"عَلَيْهِمَا","translit":"āَmِhْyَlَʿع","root":""},{"id":9,"arabic":"ٱدْخُلُوا۟","translit":"۟āwُlُhkْdٱ","root":"دخل"},{"id":10,"arabic":"عَلَيْهِمُ","translit":"ُmِhْyَlَʿع","root":""},{"id":11,"arabic":"ٱلْبَابَ","translit":"َbāَbْlٱ","root":"بوب"},{"id":12,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":13,"arabic":"دَخَلْتُمُوهُ","translit":"ُhwُmُtْlَhkَd","root":"دخل"},{"id":14,"arabic":"فَإِنَّكُمْ","translit":"ْmُkَّnِiʾَf","root":""},{"id":15,"arabic":"غَٰلِبُونَ","translit":"َnwُbِlَٰغ","root":"غلب"},{"id":16,"arabic":"وَعَلَى","translit":"àَlَʿعَw","root":""},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"فَتَوَكَّلُوٓا۟","translit":"۟āٓwُlَّkَwَtَf","root":"وكل"},{"id":19,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":20,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":21,"arabic":"مُّؤْمِنِينَ","translit":"َnyِnِmْwʾُّm","root":"امن"}],"hasIhya":true},{"ayah":24,"text":"قَالُوا۟ يَٰمُوسَىٰٓ إِنَّا لَن نَّدْخُلَهَآ أَبَدًا مَّا دَامُوا۟ فِيهَاۖ فَٱذْهَبْ أَنتَ وَرَبُّكَ فَقَٰتِلَآ إِنَّا هَٰهُنَا قَٰعِدُونَ ","translation":"They said, \"O Moses, indeed we will not enter it, ever, as long as they are within it; so go, you and your Lord, and fight. Indeed, we are remaining right here.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"يَٰمُوسَىٰٓ","translit":"ٰٓàَswُmَٰy","root":""},{"id":3,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":4,"arabic":"لَن","translit":"nَl","root":""},{"id":5,"arabic":"نَّدْخُلَهَآ","translit":"ٓāَhَlُhkْdَّn","root":"دخل"},{"id":6,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":7,"arabic":"مَّا","translit":"āَّm","root":""},{"id":8,"arabic":"دَامُوا۟","translit":"۟āwُmāَd","root":"دوم"},{"id":9,"arabic":"فِيهَا","translit":"āَhyِf","r