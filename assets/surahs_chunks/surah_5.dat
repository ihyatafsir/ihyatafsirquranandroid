سْعَوْنَ فِى ٱلْأَرْضِ فَسَادًا أَن يُقَتَّلُوٓا۟ أَوْ يُصَلَّبُوٓا۟ أَوْ تُقَطَّعَ أَيْدِيهِمْ وَأَرْجُلُهُم مِّنْ خِلَٰفٍ أَوْ يُنفَوْا۟ مِنَ ٱلْأَرْضِۚ ذَٰلِكَ لَهُمْ خِزْىٌ فِى ٱلدُّنْيَاۖ وَلَهُمْ فِى ٱلْءَاخِرَةِ عَذَابٌ عَظِيمٌ ","translation":"Indeed, the penalty[1] for those who wage war[2] against Allāh and His Messenger and strive upon earth [to cause] corruption is none but that they be killed or crucified or that their hands and feet be cut off from opposite sides or that they be exiled from the land. That is for them a disgrace in this world; and for them in the Hereafter is a great punishment,","words":[{"id":1,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":2,"arabic":"جَزَٰٓؤُا۟","translit":"۟āُwʾَٰٓzَjg","root":"جزي"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"يُحَارِبُونَ","translit":"َnwُbِrāَḥُy","root":"حرب"},{"id":5,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":6,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":7,"arabic":"وَيَسْعَوْنَ","translit":"َnْwَʿعْsَyَw","root":"سعي"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":10,"arabic":"فَسَادًا","translit":"āًdāَsَf","root":"فسد"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يُقَتَّلُوٓا۟","translit":"۟āٓwُlَّtَqُy","root":"قتل"},{"id":13,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":14,"arabic":"يُصَلَّبُوٓا۟","translit":"۟āٓwُbَّlَṣُy","root":"صلب"},{"id":15,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":16,"arabic":"تُقَطَّعَ","translit":"َʿعَّṭَqُt","root":"قطع"},{"id":17,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":18,"arabic":"وَأَرْجُلُهُم","translit":"mُhُlُjgْrَaʾَw","root":"رجل"},{"id":19,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":20,"arabic":"خِلَٰفٍ","translit":"ٍfَٰlِhk","root":"خلف"},{"id":21,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":22,"arabic":"يُنفَوْا۟","translit":"۟āْwَfnُy","root":"نفي"},{"id":23,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":24,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":25,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":26,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":27,"arabic":"خِزْىٌ","translit":"ٌàْzِhk","root":"خزي"},{"id":28,"arabic":"فِى","translit":"àِf","root":""},{"id":29,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":30,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":31,"arabic":"فِى","translit":"àِf","root":""},{"id":32,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":33,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":34,"arabic":"عَظِيمٌ","translit":"ٌmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":34,"text":"إِلَّا ٱلَّذِينَ تَابُوا۟ مِن قَبْلِ أَن تَقْدِرُوا۟ عَلَيْهِمْۖ فَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ","translation":"Except for those who return [repenting] before you overcome [i.e., apprehend] them. And know that Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"تَابُوا۟","translit":"۟āwُbāَt","root":"توب"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"قَبْلِ","translit":"ِlْbَq","root":"قبل"},{"id":6,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":7,"arabic":"تَقْدِرُوا۟","translit":"۟āwُrِdْqَt","root":"قدر"},{"id":8,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":9,"arabic":"فَٱعْلَمُوٓا۟","translit":"۟āٓwُmَlْʿعٱَf","root":"علم"},{"id":10,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":11,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":12,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":13,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":35,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَٱبْتَغُوٓا۟ إِلَيْهِ ٱلْوَسِيلَةَ وَجَٰهِدُوا۟ فِى سَبِيلِهِۦ لَعَلَّكُمْ تُفْلِحُونَ ","translation":"O you who have believed, fear Allāh and seek the means [of nearness] to Him and strive in His cause that you may succeed.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"ٱتَّقُوا۟","translit":"۟āwُqَّtٱ","root":"وقي"},{"id":5,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":6,"arabic":"وَٱبْتَغُوٓا۟","translit":"۟āٓwُغَtْbٱَw","root":"بغي"},{"id":7,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":8,"arabic":"ٱلْوَسِيلَةَ","translit":"َẗَlyِsَwْlٱ","root":"وسل"},{"id":9,"arabic":"وَجَٰهِدُوا۟","translit":"۟āwُdِhَٰjgَw","root":"جهد"},{"id":10,"arabic":"فِى","translit":"àِf","root":""},{"id":11,"arabic":"سَبِيلِهِۦ","translit":"ۦِhِlyِbَs","root":"سبل"},{"id":12,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":13,"arabic":"تُفْلِحُونَ","translit":"َnwُḥِlْfُt","root":"فلح"}],"hasIhya":true},{"ayah":36,"text":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ لَوْ أَنَّ لَهُم مَّا فِى ٱلْأَرْضِ جَمِيعًا وَمِثْلَهُۥ مَعَهُۥ لِيَفْتَدُوا۟ بِهِۦ مِنْ عَذَابِ يَوْمِ ٱلْقِيَٰمَةِ مَا تُقُبِّلَ مِنْهُمْۖ وَلَهُمْ عَذَابٌ أَلِيمٌ ","translation":"Indeed, those who disbelieve - if they should have all that is in the earth and the like of it with it by which to ransom themselves from the punishment of the Day of Resurrection, it will not be accepted from them, and for them is a painful punishment.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":5,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":6,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":7,"arabic":"مَّا","tran