k","root":"كون"},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"يَتَنَاهَوْنَ","translit":"َnْwَhāَnَtَy","root":"نهي"},{"id":4,"arabic":"عَن","translit":"nَʿع","root":""},{"id":5,"arabic":"مُّنكَرٍ","translit":"ٍrَknُّm","root":"نكر"},{"id":6,"arabic":"فَعَلُوهُ","translit":"ُhwُlَʿعَf","root":"فعل"},{"id":7,"arabic":"لَبِئْسَ","translit":"َsْyʾِbَl","root":"باس"},{"id":8,"arabic":"مَا","translit":"āَm","root":""},{"id":9,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":10,"arabic":"يَفْعَلُونَ","translit":"َnwُlَʿعْfَy","root":"فعل"}],"hasIhya":false},{"ayah":80,"text":"تَرَىٰ كَثِيرًا مِّنْهُمْ يَتَوَلَّوْنَ ٱلَّذِينَ كَفَرُوا۟ۚ لَبِئْسَ مَا قَدَّمَتْ لَهُمْ أَنفُسُهُمْ أَن سَخِطَ ٱللَّهُ عَلَيْهِمْ وَفِى ٱلْعَذَابِ هُمْ خَٰلِدُونَ ","translation":"You see many of them becoming allies of those who disbelieved [i.e., the polytheists]. How wretched is that which they have put forth for themselves in that Allāh has become angry with them, and in the punishment they will abide eternally.","words":[{"id":1,"arabic":"تَرَىٰ","translit":"ٰàَrَt","root":"راي"},{"id":2,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":3,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":4,"arabic":"يَتَوَلَّوْنَ","translit":"َnْwَّlَwَtَy","root":"ولي"},{"id":5,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":6,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":7,"arabic":"لَبِئْسَ","translit":"َsْyʾِbَl","root":"باس"},{"id":8,"arabic":"مَا","translit":"āَm","root":""},{"id":9,"arabic":"قَدَّمَتْ","translit":"ْtَmَّdَq","root":"قدم"},{"id":10,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":11,"arabic":"أَنفُسُهُمْ","translit":"ْmُhُsُfnَaʾ","root":"نفس"},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"سَخِطَ","translit":"َṭِhkَs","root":"سخط"},{"id":14,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":15,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":16,"arabic":"وَفِى","translit":"àِfَw","root":""},{"id":17,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":18,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":19,"arabic":"خَٰلِدُونَ","translit":"َnwُdِlَٰhk","root":"خلد"}],"hasIhya":false},{"ayah":81,"text":"وَلَوْ كَانُوا۟ يُؤْمِنُونَ بِٱللَّهِ وَٱلنَّبِىِّ وَمَآ أُنزِلَ إِلَيْهِ مَا ٱتَّخَذُوهُمْ أَوْلِيَآءَ وَلَٰكِنَّ كَثِيرًا مِّنْهُمْ فَٰسِقُونَ ","translation":"And if they had believed in Allāh and the Prophet and in what was revealed to him, they would not have taken them as allies; but many of them are defiantly disobedient.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":3,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"},{"id":4,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":5,"arabic":"وَٱلنَّبِىِّ","translit":"ِّàِbَّnlٱَw","root":"نبا"},{"id":6,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":7,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":8,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"ٱتَّخَذُوهُمْ","translit":"ْmُhwُhdَhkَّtٱ","root":"اخذ"},{"id":11,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":12,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":13,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":14,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":15,"arabic":"فَٰسِقُونَ","translit":"َnwُqِsَٰf","root":"فسق"}],"hasIhya":false},{"ayah":82,"text":"لَتَجِدَنَّ أَشَدَّ ٱلنَّاسِ عَدَٰوَةً لِّلَّذِينَ ءَامَنُوا۟ ٱلْيَهُودَ وَٱلَّذِينَ أَشْرَكُوا۟ۖ وَلَتَجِدَنَّ أَقْرَبَهُم مَّوَدَّةً لِّلَّذِينَ ءَامَنُوا۟ ٱلَّذِينَ قَالُوٓا۟ إِنَّا نَصَٰرَىٰۚ ذَٰلِكَ بِأَنَّ مِنْهُمْ قِسِّيسِينَ وَرُهْبَانًا وَأَنَّهُمْ لَا يَسْتَكْبِرُونَ ","translation":"You will surely find the most intense of the people in animosity toward the believers [to be] the Jews and those who associate others with Allāh; and you will find the nearest of them in affection to the believers those who say, \"We are Christians.\" That is because among them are priests and monks and because they are not arrogant.","words":[{"id":1,"arabic":"لَتَجِدَنَّ","translit":"َّnَdِjgَtَl","root":"وجد"},{"id":2,"arabic":"أَشَدَّ","translit":"َّdَhsَaʾ","root":"شدد"},{"id":3,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":4,"arabic":"عَدَٰوَةً","translit":"ًẗَwَٰdَʿع","root":"عدو"},{"id":5,"arabic":"لِّلَّذِينَ","translit":"َnyِhdَّlِّl","root":""},{"id":6,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":7,"arabic":"ٱلْيَهُودَ","translit":"َdwُhَyْlٱ","root":"هود"},{"id":8,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":9,"arabic":"أَشْرَكُوا۟","translit":"۟āwُkَrْhsَaʾ","root":"شرك"},{"id":10,"arabic":"وَلَتَجِدَنَّ","translit":"َّnَdِjgَtَlَw","root":"وجد"},{"id":11,"arabic":"أَقْرَبَهُم","translit":"mُhَbَrْqَaʾ","root":"قرب"},{"id":12,"arabic":"مَّوَدَّةً","translit":"ًẗَّdَwَّm","root":"ودد"},{"id":13,"arabic":"لِّلَّذِينَ","translit":"َnyِhdَّlِّl","root":""},{"id":14,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":15,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":16,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":17,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":18,"arabic":"نَصَٰرَىٰ","translit":"ٰàَrَٰṣَn","root":"نصر"},{"id":19,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":20,"arabic":"بِأَنَّ","translit":"َّnَaʾِb","root":""},{"id":21,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":22,"arabic":"قِسِّيسِينَ","translit":"َnyِsyِّsِq","root":"قسس"},{"id":23,"arabic":"وَرُهْبَانًا","translit":"āًnāَbْhُrَw","root":"رهب"},{"id":24,"arabic":"وَأَنَّهُمْ","translit":"ْmُhَّnَaʾَw","root":""},{"id":25,"arabic":"لَا","translit":"āَl","root":""},{"id":26,"arabic":"يَسْتَكْبِرُونَ","translit":"َnwُrِbْkَtْsَy","root":"كبر"}],"hasIhya":true},{"ayah":83,"text":"وَإِذَا سَمِعُوا۟ مَآ أُنزِلَ إِلَى ٱلرَّسُولِ تَرَىٰٓ أَعْيُنَهُمْ تَفِيضُ مِنَ ٱلدَّمْعِ مِمَّا عَرَفُوا۟ مِنَ ٱلْحَقِّۖ يَقُولُونَ رَبَّنَآ ءَامَنَّا فَٱكْتُبْنَا مَعَ ٱلشَّٰهِدِينَ ","translation":"And when they hear what has been revealed to the Messenger, you see their eyes overflowing with tears because of what they have recognized of the truth. They say, \"Our Lord, we have believed, so register us among the witnesses.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"سَمِعُوا۟","translit":"۟āwُʿعِmَs","root":"سمع"},{"id":3,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":4,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":5,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":6,"arabic":"ٱلرَّسُولِ","translit":"ِlwُsَّrlٱ","root":"رسل"},{"id":7,"arabic":"تَرَىٰٓ","translit":"ٰٓàَrَt","root":"راي"},{"id":8,"arabic":"أَعْيُنَهُمْ","translit":"ْmُhَnُyْʿعَaʾ","root":"عين"},{"id":9,"arabic":"تَفِيضُ","translit":"ُḍyِfَt","root":"فيض"},{"id":10,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":11,"arabic":"ٱلدَّمْعِ","translit":"ِʿعْmَّdlٱ","root":"دمع"},{"id":12,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":13,"arabic":"عَرَفُوا۟","translit":"۟āwُfَrَʿع","root":"عرف"},{"id":14,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":15,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":16,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":17,"arabic":"رَبَّنَآ","translit":"ٓāَnَّbَr","root":"ربب"},{"id":18,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":19,"arabic":"فَٱكْتُبْنَا","translit":"āَnْbُtْkٱَf","root":"كتب"},{"id":20,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":21,"arabic":"ٱلشَّٰهِدِينَ","translit":"َnyِdِhَّٰhslٱ","root":"شهد"}],"hasIhya":true},{"ayah":84,"text":"وَمَا لَنَا لَا نُؤْمِنُ بِٱللَّهِ وَمَا جَآءَنَا مِنَ ٱلْحَقِّ وَنَطْمَعُ أَن يُدْخِلَنَا رَبُّنَا مَعَ ٱلْقَوْمِ ٱلصَّٰلِحِينَ ","translation":"And why should we not believe in Allāh and what has come to us of the truth? And we aspire that our Lord will admit us [to Paradise] with the righteous people.\"","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":3,"arabic":"لَا","translit":"āَl","root":""},{"id":4,"arabic":"نُؤْمِنُ","translit":"ُnِmْwʾُn","root":"امن"},{"id":5,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"جَآءَنَا","translit":"āَnَءٓāَjg","root":"جيا"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":10,"arabic":"وَنَطْمَعُ","translit":"ُʿعَmْṭَnَw","root":"طمع"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يُدْخِلَنَا","translit":"āَnَlِhkْdُy","root":"دخل"},{"id":13,"arabic":"رَبُّنَا","translit":"āَnُّbَr","root":"ربب"},{"id":14,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":15,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":16,"arabic":"ٱلصَّٰلِحِينَ","translit":"َnyِḥِlَّٰṣlٱ","root":"صلح"}],"hasIhya":false},{"ayah":85,"text":"فَأَثَٰبَهُمُ ٱللَّهُ بِمَا قَالُوا۟ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ ٱلْمُحْسِنِينَ ","translation":"So Allāh rewarded them for what they said[1] with gardens [in Paradise] beneath which rivers flow, wherein they abide eternally. And that is the reward of doers of good.","words":[{"id":1,"arabic":"فَأَثَٰبَهُمُ","translit":"ُmُhَbَٰhtَaʾَf","root":"ثوب"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":4,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":5,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":6,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":9,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":10,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":11,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":12,"arabic":"وَذَٰلِكَ","translit":"َkِlَٰhdَw","root":""},{"id":13,"arabic":"جَزَآءُ","translit":"ُءٓāَzَjg","root":"جزي"},{"id":14,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":false},{"ayah":86,"text":"وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَٰتِنَآ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْجَحِيمِ ","translation":"But those who disbelieved and denied Our signs - they are the companions of Hellfire.","words":[{"id":1,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":2,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":3,"arabic":"وَكَذَّبُوا۟","translit":"۟āwُbَّhdَkَw","root":"كذب"},{"id":4,"arabic":"بِـَٔايَٰتِنَآ","translit":"ٓāَnِtَٰyāَٔـِb","root":"ايي"},{"id":5,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":6,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":7,"arabic":"ٱلْجَحِيمِ","translit":"ِmyِḥَjgْlٱ","root":"جحم"}],"hasIhya":false},{"ayah":87,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تُحَرِّمُوا۟ طَيِّبَٰتِ مَآ أَحَلَّ ٱللَّهُ لَكُمْ وَلَا تَعْتَدُوٓا۟ۚ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلْمُعْتَدِينَ ","translation":"O you who have believed, do not prohibit the good things which Allāh has made lawful to you and do not transgress. Indeed, Allāh does not like transgressors.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تُحَرِّمُوا۟","translit":"۟āwُmِّrَḥُt","root":"حرم"},{"id":6,"arabic":"طَيِّبَٰتِ","translit":"ِtَٰbِّyَṭ","root":"طيب"},{"id":7,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":8,"arabic":"أَحَلَّ","translit":"َّlَḥَaʾ","root":"حلل"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":11,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":12,"arabic":"تَعْتَدُوٓا۟","translit":"۟āٓwُdَtْʿعَt","root":"عدو"},{"id":13,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":14,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":15,"arabic":"لَا","translit":"āَl","root":""},{"id":16,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":17,"arabic":"ٱلْمُعْتَدِينَ","translit":"َnyِdَtْʿعُmْlٱ","root":"عدو"}],"hasIhya":true},{"ayah":88,"text":"وَكُلُوا۟ مِمَّا رَزَقَكُمُ ٱللَّهُ حَلَٰلًا طَيِّبًاۚ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ أَنتُم بِهِۦ مُؤْمِنُونَ ","translation":"And eat of what Allāh has provided for you [which is] lawful and good. And fear Allāh, in whom you are believers.","words":[{"id":1,"arabic":"وَكُلُوا۟","translit":"۟āwُlُkَw","root":"اكل"},{"id":2,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":3,"arabic":"رَزَقَكُمُ","translit":"ُmُkَqَzَr","root":"رزق"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"حَلَٰلًا","translit":"āًlَٰlَḥ","root":"حلل"},{"id":6,"arabic":"طَيِّبًا","translit":"āًbِّyَṭ","root":"طيب"},{"id":7,"arabic":"وَٱتَّقُوا۟","translit":"۟āwُqَّtٱَw","root":"وقي"},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":10,"arabic":"أَنتُم","translit":"mُtnَaʾ","root":""},{"id":11,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":12,"arabic":"مُؤْمِنُونَ","translit":"َnwُnِmْwʾُm","root":"امن"}],"hasIhya":false},{"ayah":89,"text":"لَا يُؤَاخِذُكُمُ ٱللَّهُ بِٱللَّغْوِ فِىٓ أَيْمَٰنِكُمْ وَلَٰكِن يُؤَاخِذُكُم بِمَا عَقَّدتُّمُ ٱلْأَيْمَٰنَۖ فَكَفَّٰرَتُهُۥٓ إِطْعَامُ عَشَرَةِ مَسَٰكِينَ مِنْ أَوْسَطِ مَا تُطْعِمُونَ أَهْلِيكُمْ أَوْ كِسْوَتُهُمْ أَوْ تَحْرِيرُ رَقَبَةٍۖ فَمَن لَّمْ يَجِدْ فَصِيَامُ ثَلَٰثَةِ أَيَّامٍۚ ذَٰلِكَ كَفَّٰرَةُ أَيْمَٰنِكُمْ إِذَا حَلَفْتُمْۚ وَٱحْفَظُوٓا۟ أَيْمَٰنَكُمْۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمْ ءَايَٰتِهِۦ لَعَلَّكُمْ تَشْكُرُونَ ","translation":"Allāh will not impose blame upon you for what is meaningless[1] in your oaths, but He will impose blame upon you for [breaking] what you intended of oaths. So its expiation[2] is the feeding of ten needy people from the average of that which you feed your [own] families or clothing them or the freeing of a slave. But whoever cannot find [or afford it] - then a fast of three days [is required]. That is the expiation for oaths when you have sworn. But guard your oaths.[3] Thus does Allāh make clear to you His verses [i.e., revealed law] that you may be grateful.","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"يُؤَاخِذُكُمُ","translit":"ُmُkُhdِhkāَwʾُy","root":"اخذ"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"بِٱللَّغْوِ","translit":"ِwْغَّllٱِb","root":"لغو"},{"id":5,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":6,"arabic":"أَيْمَٰنِكُمْ","translit":"ْmُkِnَٰmْyَaʾ","root":"يمن"},{"id":7,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":8,"arabic":"يُؤَاخِذُكُم","translit":"mُkُhdِhkāَwʾُy","root":"اخذ"},{"id":9,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":10,"arabic":"عَقَّدتُّمُ","translit":"ُmُّtdَّqَʿع","root":"عقد"},{"id":11,"arabic":"ٱلْأَيْمَٰنَ","translit":"َnَٰmْyَaʾْlٱ","root":"يمن"},{"id":12,"arabic":"فَكَفَّٰرَتُهُۥٓ","translit":"ٓۥُhُtَrَّٰfَkَf","root":"كفر"},{"id":13,"arabic":"إِطْعَامُ","translit":"ُmāَʿعْṭِiʾ","root":"طعم"},{"id":14,"arabic":"عَشَرَةِ","translit":"ِẗَrَhsَʿع","root":"عشر"},{"id":15,"arabic":"مَسَٰكِينَ","translit":"َnyِkَٰsَm","root":"سكن"},{"id":16,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":17,"arabic":"أَوْسَطِ","translit":"ِṭَsْwَaʾ","root":"وسط"},{"id":18,"arabic":"مَا","translit":"āَm","root":""},{"id":19,"arabic":"تُطْعِمُونَ","translit":"َnwُmِʿعْṭُt","root":"طعم"},{"id":20,"arabic":"أَهْلِيكُمْ","translit":"ْmُkyِlْhَaʾ","root":"اهل"},{"id":21,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":22,"arabic":"كِسْوَتُهُمْ","translit":"ْmُhُtَwْsِk","root":"كسو"},{"id":23,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":24,"arabic":"تَحْرِيرُ","translit":"ُryِrْḥَt","root":"حرر"},{"id":25,"arabic":"رَقَبَةٍ","translit":"ٍẗَbَqَr","root":"رقب"},{"id":26,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":27,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":28,"arabic":"يَجِدْ","translit":"ْdِjgَy","root":"وجد"},{"id":29,"arabic":"فَصِيَامُ","translit":"ُmāَyِṣَf","root":"صوم"},{"id":30,"arabic":"ثَلَٰثَةِ","translit":"ِẗَhtَٰlَht","root":"ثلث"},{"id":31,"arabic":"أَيَّامٍ","translit":"ٍmāَّyَaʾ","root":"يوم"},{"id":32,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":33,"arabic":"كَفَّٰرَةُ","translit":"ُẗَrَّٰfَk","root":"كفر"},{"id":34,"arabic":"أَيْمَٰنِكُمْ","translit":"ْmُkِnَٰmْyَaʾ","root":"يمن"},{"id":35,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":36,"arabic":"حَلَفْتُمْ","translit":"ْmُtْfَlَḥ","root":"حلف"},{"id":37,"arabic":"وَٱحْفَظُوٓا۟","translit":"۟āٓwُẓَfْḥٱَw","root":"حفظ"},{"id":38,"arabic":"أَيْمَٰنَكُمْ","translit":"ْmُkَnَٰmْyَaʾ","root":"يمن"},{"id":39,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":40,"arabic":"يُبَيِّنُ","translit":"ُnِّyَbُy","root":"بين"},{"id":41,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":42,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":43,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":44,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":45,"arabic":"تَشْكُرُونَ","translit":"َnwُrُkْhsَt","root":"شكر"}],"hasIhya":true},{"ayah":90,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّمَا ٱلْخَمْرُ وَٱلْمَيْسِرُ وَٱلْأَنصَابُ وَٱلْأَزْلَٰمُ رِجْسٌ مِّنْ عَمَلِ ٱلشَّيْطَٰنِ فَٱجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ ","translation":"O you who have believed, indeed, intoxicants, gambling, [sacrificing on] stone alters [to other than Allāh], and divining arrows are but defilement from the work of Satan, so avoid[1] it that you may be successful.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":4,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":5,"arabic":"ٱلْخَمْرُ","translit":"ُrْmَhkْlٱ","root":"خمر"},{"id":6,"arabic":"وَٱلْمَيْسِرُ","translit":"ُrِsْyَmْlٱَw","root":"يسر"},{"id":7,"arabic":"وَٱلْأَنصَابُ","translit":"ُbāَṣnَaʾْlٱَw","root":"نصب"},{"id":8,"arabic":"وَٱلْأَزْلَٰمُ","translit":"ُmَٰlْzَaʾْlٱَw","root":"زلم"},{"id":9,"arabic":"رِجْسٌ","translit":"ٌsْjgِr","root":"رجس"},{"id":10,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":11,"arabic":"عَمَلِ","translit":"ِlَmَʿع","root":"عمل"},{"id":12,"arabic":"ٱلشَّيْطَٰنِ","translit":"ِnَٰṭْyَّhslٱ","root":"شطن"},{"id":13,"arabic":"فَٱجْتَنِبُوهُ","translit":"ُhwُbِnَtْjgٱَf","root":"جنب"},{"id":14,"arabic":"لَعَلَّكُمْ","translit":"ْmُkَّlَʿعَl","root":""},{"id":15,"arabic":"تُفْلِحُونَ","translit":"َnwُḥِlْfُt","root":"فلح"}],"hasIhya":false},{"ayah":91,"text":"إِنَّمَا يُرِيدُ ٱلشَّيْطَٰنُ أَن يُوقِعَ بَيْنَكُمُ ٱلْعَدَٰوَةَ وَٱلْبَغْضَآءَ فِى ٱلْخَمْرِ وَٱلْمَيْسِرِ وَيَصُدَّكُمْ عَن ذِكْرِ ٱللَّهِ وَعَنِ ٱلصَّلَوٰةِۖ فَهَلْ أَنتُم مُّنتَهُونَ ","translation":"Satan only wants to cause between you animosity and hatred through intoxicants and gambling and to avert you from the remembrance of Allāh and from prayer. So will you not desist?","words":[{"id":1,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":2,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":3,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يُوقِعَ","translit":"َʿعِqwُy","root":"وقع"},{"id":6,"arabic":"بَيْنَكُمُ","translit":"ُmُkَnْyَb","root":"بين"},{"id":7,"arabic":"ٱلْعَدَٰوَةَ","translit":"َẗَwَٰdَʿعْlٱ","root":"عدو"},{"id":8,"arabic":"وَٱلْبَغْضَآءَ","translit":"َءٓāَḍْغَbْlٱَw","root":"بغض"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْخَمْرِ","translit":"ِrْmَhkْlٱ","root":"خمر"},{"id":11,"arabic":"وَٱلْمَيْسِرِ","translit":"ِrِsْyَmْlٱَw","root":"يسر"},{"id":12,"arabic":"وَيَصُدَّكُمْ","translit":"ْmُkَّdُṣَyَw","root":"صدد"},{"id":13,"arabic":"عَن","translit":"nَʿع","root":""},{"id":14,"arabic":"ذِكْرِ","translit":"ِrْkِhd","root":"ذكر"},{"id":15,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":16,"arabic":"وَعَنِ","translit":"ِnَʿعَw","root":""},{"id":17,"arabic":"ٱلصَّلَوٰةِ","translit":"ِẗٰwَlَّṣlٱ","root":"صلو"},{"id":18,"arabic":"فَهَلْ","translit":"ْlَhَf","root":""},{"id":19,"arabic":"أَنتُم","translit":"mُtnَaʾ","root":""},{"id":20,"arabic":"مُّنتَهُونَ","translit":"َnwُhَtnُّm","root":"نهي"}],"hasIhya":false},{"ayah":92,"text":"وَأَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ وَٱحْذَرُوا۟ۚ فَإِن تَوَلَّيْتُمْ فَٱعْلَمُوٓا۟ أَنَّمَا عَلَىٰ رَسُولِنَا ٱلْبَلَٰغُ ٱلْمُبِينُ ","translation":"And obey Allāh and obey the Messenger and beware. And if you turn away - then know that upon Our Messenger is only [the responsibility for] clear notification.","words":[{"id":1,"arabic":"وَأَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾَw","root":"طوع"},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"وَأَطِيعُوا۟","translit":"۟āwُʿعyِṭَaʾَw","root":"طوع"},{"id":4,"arabic":"ٱلرَّسُولَ","translit":"َlwُsَّrlٱ","root":"رسل"},{"id":5,"arabic":"وَٱحْذَرُوا۟","translit":"۟āwُrَhdْḥٱَw","root":"حذر"},{"id":6,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":7,"arabic":"تَوَلَّيْتُمْ","translit":"ْmُtْyَّlَwَt","root":"ولي"},{"id":8,"arabic":"فَٱعْلَمُوٓا۟","translit":"۟āٓwُmَlْʿعٱَf","root":"علم"},{"id":9,"arabic":"أَنَّمَا","translit":"āَmَّnَaʾ","root":""},{"id":10,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":11,"arabic":"رَسُولِنَا","translit":"āَnِlwُsَr","root":"رسل"},{"id":12,"arabic":"ٱلْبَلَٰغُ","translit":"ُغَٰlَbْlٱ","root":"بلغ"},{"id":13,"arabic":"ٱلْمُبِينُ","translit":"ُnyِbُmْlٱ","root":"بين"}],"hasIhya":false},{"ayah":93,"text":"لَيْسَ عَلَى ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ جُنَاحٌ فِيمَا طَعِمُوٓا۟ إِذَا مَا ٱتَّقَوا۟ وَّءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ ثُمَّ ٱتَّقَوا۟ وَّءَامَنُوا۟ ثُمَّ ٱتَّقَوا۟ وَّأَحْسَنُوا۟ۗ وَٱللَّهُ يُحِبُّ ٱلْمُحْسِنِينَ ","translation":"There is not upon those who believe and do righteousness [any] blame concerning what they have eaten [in the past] if they [now] fear Allāh and believe and do righteous deeds, and then fear Allāh and believe, and then fear Allāh and do good; and Allāh loves the doers of good.","words":[{"id":1,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":2,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":5,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":6,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":7,"arabic":"جُنَاحٌ","translit":"ٌḥāَnُjg","root":"جنح"},{"id":8,"arabic":"فِيمَا","translit":"āَmyِf","root":""},{"id":9,"arabic":"طَعِمُوٓا۟","translit":"۟āٓwُmِʿعَṭ","root":"طعم"},{"id":10,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"ٱتَّقَوا۟","translit":"۟āwَqَّtٱ","root":"وقي"},{"id":13,"arabic":"وَّءَامَنُوا۟","translit":"۟āwُnَmāَءَّw","root":"امن"},{"id":14,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":15,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":16,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":17,"arabic":"ٱتَّقَوا۟","translit":"۟āwَqَّtٱ","root":"وقي"},{"id":18,"arabic":"وَّءَامَنُوا۟","translit":"۟āwُnَmāَءَّw","root":"امن"},{"id":19,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":20,"arabic":"ٱتَّقَوا۟","translit":"۟āwَqَّtٱ","root":"وقي"},{"id":21,"arabic":"وَّأَحْسَنُوا۟","translit":"۟āwُnَsْḥَaʾَّw","root":"حسن"},{"id":22,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":23,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":24,"arabic":"ٱلْمُحْسِنِينَ","translit":"َnyِnِsْḥُmْlٱ","root":"حسن"}],"hasIhya":false},{"ayah":94,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَيَبْلُوَنَّكُمُ ٱللَّهُ بِشَىْءٍ مِّنَ ٱلصَّيْدِ تَنَالُهُۥٓ أَيْدِيكُمْ وَرِمَاحُكُمْ لِيَعْلَمَ ٱللَّهُ مَن يَخَافُهُۥ بِٱلْغَيْبِۚ فَمَنِ ٱعْتَدَىٰ بَعْدَ ذَٰلِكَ فَلَهُۥ عَذَابٌ أَلِيمٌ ","translation":"O you who have believed, Allāh will surely test you through something of the game that your hands and spears [can] reach, that Allāh may make evident those who fear Him unseen. And whoever transgresses after that - for him is a painful punishment.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَيَبْلُوَنَّكُمُ","translit":"ُmُkَّnَwُlْbَyَl","root":"بلو"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"بِشَىْءٍ","translit":"ٍءْàَhsِb","root":"شيا"},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلصَّيْدِ","translit":"ِdْyَّṣlٱ","root":"صيد"},{"id":9,"arabic":"تَنَالُهُۥٓ","translit":"ٓۥُhُlāَnَt","root":"نيل"},{"id":10,"arabic":"أَيْدِيكُمْ","translit":"ْmُkyِdْyَaʾ","root":"يدي"},{"id":11,"arabic":"وَرِمَاحُكُمْ","translit":"ْmُkُḥāَmِrَw","root":"رمح"},{"id":12,"arabic":"لِيَعْلَمَ","translit":"َmَlْʿعَyِl","root":"علم"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"مَن","translit":"nَm","root":""},{"id":15,"arabic":"يَخَافُهُۥ","translit":"ۥُhُfāَhkَy","root":"خوف"},{"id":16,"arabic":"بِٱلْغَيْبِ","translit":"ِbْyَغْlٱِb","root":"غيب"},{"id":17,"arabic":"فَمَنِ","translit":"ِnَmَf","root":""},{"id":18,"arabic":"ٱعْتَدَىٰ","translit":"ٰàَdَtْʿعٱ","root":"عدو"},{"id":19,"arabic":"بَعْدَ","translit":"َdْʿعَb","root":"بعد"},{"id":20,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":21,"arabic":"فَلَهُۥ","translit":"ۥُhَlَf","root":""},{"id":22,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":23,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":true},{"ayah":95,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَقْتُلُوا۟ ٱلصَّيْدَ وَأَنتُمْ حُرُمٌۚ وَمَن قَتَلَهُۥ مِنكُم مُّتَعَمِّدًا فَجَزَآءٌ مِّثْلُ مَا قَتَلَ مِنَ ٱلنَّعَمِ يَحْكُمُ بِهِۦ ذَوَا عَدْلٍ مِّنكُمْ هَدْيًۢا بَٰلِغَ ٱلْكَعْبَةِ أَوْ كَفَّٰرَةٌ طَعَامُ مَسَٰكِينَ أَوْ عَدْلُ ذَٰلِكَ صِيَامًا لِّيَذُوقَ وَبَالَ أَمْرِهِۦۗ عَفَا ٱللَّهُ عَمَّا سَلَفَۚ وَمَنْ عَادَ فَيَنتَقِمُ ٱللَّهُ مِنْهُۗ وَٱللَّهُ عَزِيزٌ ذُو ٱنتِقَامٍ ","translation":"O you who have believed, do not kill game while you are in the state of iḥrām.[1] And whoever of you kills it intentionally - the penalty is an equivalent from sacrificial animals to what he killed, as judged by two just men among you as an offering [to Allāh] delivered to the Kaʿbah, or an expiation: the feeding of needy people or the equivalent of that in fasting, that he may taste the consequence of his matter [i.e., deed]. Allāh has pardoned what is past; but whoever returns [to violation], then Allāh will take retribution from him. And Allāh is Exalted in Might and Owner of Retribution.[2]","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَقْتُلُوا۟","translit":"۟āwُlُtْqَt","root":"قتل"},{"id":6,"arabic":"ٱلصَّيْدَ","translit":"َdْyَّṣlٱ","root":"صيد"},{"id":7,"arabic":"وَأَنتُمْ","translit":"ْmُtnَaʾَw","root":""},{"id":8,"arabic":"حُرُمٌ","transl