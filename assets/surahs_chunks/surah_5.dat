":56,"text":"وَمَن يَتَوَلَّ ٱللَّهَ وَرَسُولَهُۥ وَٱلَّذِينَ ءَامَنُوا۟ فَإِنَّ حِزْبَ ٱللَّهِ هُمُ ٱلْغَٰلِبُونَ ","translation":"And whoever is an ally of Allāh and His Messenger and those who have believed - indeed, the party of Allāh - they will be the predominant.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَتَوَلَّ","translit":"َّlَwَtَy","root":"ولي"},{"id":3,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":4,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":5,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":6,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":7,"arabic":"فَإِنَّ","translit":"َّnِiʾَf","root":""},{"id":8,"arabic":"حِزْبَ","translit":"َbْzِḥ","root":"حزب"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":11,"arabic":"ٱلْغَٰلِبُونَ","translit":"َnwُbِlَٰغْlٱ","root":"غلب"}],"hasIhya":false},{"ayah":57,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوا۟ ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَكُمْ هُزُوًا وَلَعِبًا مِّنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ مِن قَبْلِكُمْ وَٱلْكُفَّارَ أَوْلِيَآءَۚ وَٱتَّقُوا۟ ٱللَّهَ إِن كُنتُم مُّؤْمِنِينَ ","translation":"O you who have believed, take not those who have taken your religion in ridicule and amusement among the ones who were given the Scripture before you nor the disbelievers as allies. And fear Allāh, if you should [truly] be believers.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَتَّخِذُوا۟","translit":"۟āwُhdِhkَّtَt","root":"اخذ"},{"id":6,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":7,"arabic":"ٱتَّخَذُوا۟","translit":"۟āwُhdَhkَّtٱ","root":"اخذ"},{"id":8,"arabic":"دِينَكُمْ","translit":"ْmُkَnyِd","root":"دين"},{"id":9,"arabic":"هُزُوًا","translit":"āًwُzُh","root":"هزا"},{"id":10,"arabic":"وَلَعِبًا","translit":"āًbِʿعَlَw","root":"لعب"},{"id":11,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":12,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":13,"arabic":"أُوتُوا۟","translit":"۟āwُtwُaʾ","root":"اتي"},{"id":14,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":15,"arabic":"مِن","translit":"nِm","root":""},{"id":16,"arabic":"قَبْلِكُمْ","translit":"ْmُkِlْbَq","root":"قبل"},{"id":17,"arabic":"وَٱلْكُفَّارَ","translit":"َrāَّfُkْlٱَw","root":"كفر"},{"id":18,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":19,"arabic":"وَٱتَّقُوا۟","translit":"۟āwُqَّtٱَw","root":"وقي"},{"id":20,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":21,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":22,"arabic":"كُنتُم","translit":"mُtnُk","root":"كون"},{"id":23,"arabic":"مُّؤْمِنِينَ","translit":"َnyِnِmْwʾُّm","root":"امن"}],"hasIhya":true},{"ayah":58,"text":"وَإِذَا نَادَيْتُمْ إِلَى ٱلصَّلَوٰةِ ٱتَّخَذُوهَا هُزُوًا وَلَعِبًاۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَعْقِلُونَ ","translation":"And when you call to prayer, they take it in ridicule and amusement. That is because they are a people who do not use reason.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"نَادَيْتُمْ","translit":"ْmُtْyَdāَn","root":"ندي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلصَّلَوٰةِ","translit":"ِẗٰwَlَّṣlٱ","root":"صلو"},{"id":5,"arabic":"ٱتَّخَذُوهَا","translit":"āَhwُhdَhkَّtٱ","root":"اخذ"},{"id":6,"arabic":"هُزُوًا","translit":"āًwُzُh","root":"هزا"},{"id":7,"arabic":"وَلَعِبًا","translit":"āًbِʿعَlَw","root":"لعب"},{"id":8,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":9,"arabic":"بِأَنَّهُمْ","translit":"ْmُhَّnَaʾِb","root":""},{"id":10,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":11,"arabic":"لَّا","translit":"āَّl","root":""},{"id":12,"arabic":"يَعْقِلُونَ","translit":"َnwُlِqْʿعَy","root":"عقل"}],"hasIhya":false},{"ayah":59,"text":"قُلْ يَٰٓأَهْلَ ٱلْكِتَٰبِ هَلْ تَنقِمُونَ مِنَّآ إِلَّآ أَنْ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ إِلَيْنَا وَمَآ أُنزِلَ مِن قَبْلُ وَأَنَّ أَكْثَرَكُمْ فَٰسِقُونَ ","translation":"Say, \"O People of the Scripture, do you resent us except [for the fact] that we have believed in Allāh and what was revealed to us and what was revealed before and because most of you are defiantly disobedient?\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"يَٰٓأَهْلَ","translit":"َlْhَaʾَٰٓy","root":"اهل"},{"id":3,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":4,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":5,"arabic":"تَنقِمُونَ","translit":"َnwُmِqnَt","root":"نقم"},{"id":6,"arabic":"مِنَّآ","translit":"ٓāَّnِm","root":""},{"id":7,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":8,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":9,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":10,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":11,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":12,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":13,"arabic":"إِلَيْنَا","translit":"āَnْyَlِiʾ","root":""},{"id":14,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":15,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":16,"arabic":"مِن","translit":"nِm","root":""},{"id":17,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":18,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":19,"arabic":"أَكْثَرَكُمْ","translit":"ْmُkَrَhtْkَaʾ","root":"كثر"},{"id":20,"arabic":"فَٰسِقُونَ","translit":"َnwُqِsَٰf","root":"فسق"}],"hasIhya":false},{"ayah":60,"text":"قُلْ هَلْ أُنَبِّئُكُم بِشَرٍّ مِّن ذَٰلِكَ مَثُوبَةً عِندَ ٱللَّهِۚ مَن لَّعَنَهُ ٱللَّهُ وَغَضِبَ عَلَيْهِ وَجَعَلَ مِنْهُمُ ٱلْقِرَدَةَ وَٱلْخَنَازِيرَ وَعَبَدَ ٱلطَّٰغُوتَۚ أُو۟لَٰٓئِكَ شَرٌّ مَّكَانًا وَأَضَلُّ عَن سَوَآءِ ٱلسَّبِيلِ ","translation":"Say, \"Shall I inform you of [what is] worse than that[1] as penalty from Allāh? [It is that of] those whom Allāh has cursed and with whom He became angry and made of them apes and pigs and slaves of ṭāghūt.[2] Those are worse in position and further astray from the sound way.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":3,"arabic":"أُنَبِّئُكُم","translit":"mُkُyʾِّbَnُaʾ","root":"نبا"},{"id":4,"arabic":"بِشَرٍّ","translit":"ٍّrَhsِb","root":"شرر"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":7,"arabic":"مَثُوبَةً","translit":"ًẗَbwُhtَm","root":"ثوب"},{"id":8,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"مَن","translit":"nَm","root":""},{"id":11,"arabic":"لَّعَنَهُ","translit":"ُhَnَʿعَّl","root":"لعن"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"وَغَضِبَ","translit":"َbِḍَغَw","root":"غضب"},{"id":14,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":15,"arabic":"وَجَعَلَ","translit":"َlَʿعَjgَw","root":"جعل"},{"id":16,"arabic":"مِنْهُمُ","translit":"ُmُhْnِm","root":""},{"id":17,"arabic":"ٱلْقِرَدَةَ","translit":"َẗَdَrِqْlٱ","root":"قرد"},{"id":18,"arabic":"وَٱلْخَنَازِيرَ","translit":"َryِzāَnَhkْlٱَw","root":"خنزر"},{"id":19,"arabic":"وَعَبَدَ","translit":"َdَbَʿعَw","root":"عبد"},{"id":20,"arabic":"ٱلطَّٰغُوتَ","translit":"َtwُغَّٰṭlٱ","root":"طغي"},{"id":21,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":22,"arabic":"شَرٌّ","translit":"ٌّrَhs","root":"شرر"},{"id":23,"arabic":"مَّكَانًا","translit":"āًnāَkَّm","root":"كون"},{"id":24,"arabic":"وَأَضَلُّ","translit":"ُّlَḍَaʾَw","root":"ضلل"},{"id":25,"arabic":"عَن","translit":"nَʿع","root":""},{"id":26,"arabic":"سَوَآءِ","translit":"ِءٓāَwَs","root":"سوي"},{"id":27,"arabic":"ٱلسَّبِيلِ","translit":"ِlyِbَّslٱ","root":"سبل"}],"hasIhya":false},{"ayah":61,"text":"وَإِذَا جَآءُوكُمْ قَالُوٓا۟ ءَامَنَّا وَقَد دَّخَلُوا۟ بِٱلْكُفْرِ وَهُمْ قَدْ خَرَجُوا۟ بِهِۦۚ وَٱللَّهُ أَعْلَمُ بِمَا كَانُوا۟ يَكْتُمُونَ ","translation":"And when they come to you, they say, \"We believe.\" But they have entered with disbelief [in their hearts], and they have certainly left with it. And Allāh is most knowing of what they were concealing.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"جَآءُوكُمْ","translit":"ْmُkwُءٓāَjg","root":"جيا"},{"id":3,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":4,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":5,"arabic":"وَقَد","translit":"dَqَw","root":""},{"id":6,"arabic":"دَّخَلُوا۟","translit":"۟āwُlَhkَّd","root":"دخل"},{"id":7,"arabic":"بِٱلْكُفْرِ","translit":"ِrْfُkْlٱِb","root":"كفر"},{"id":8,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":9,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":10,"arabic":"خَرَجُوا۟","translit":"۟āwُjgَrَhk","root":"خرج"},{"id":11,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":12,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":13,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":14,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":15,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":16,"arabic":"يَكْتُمُونَ","translit":"َnwُmُtْkَy","root":"كتم"}],"hasIhya":false},{"ayah":62,"text":"وَتَرَىٰ كَثِيرًا مِّنْهُمْ يُسَٰرِعُونَ فِى ٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَأَكْلِهِمُ ٱلسُّحْتَۚ لَبِئْسَ مَا كَانُوا۟ يَعْمَلُونَ ","translation":"And you see many of them hastening into sin and aggression and the devouring of [what is] unlawful. How wretched is what they have been doing.","words":[{"id":1,"arabic":"وَتَرَىٰ","translit":"ٰàَrَtَw","root":"راي"},{"id":2,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":3,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":4,"arabic":"يُسَٰرِعُونَ","translit":"َnwُʿعِrَٰsُy","root":"سرع"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلْإِثْمِ","translit":"ِmْhtِiʾْlٱ","root":"اثم"},{"id":7,"arabic":"وَٱلْعُدْوَٰنِ","translit":"ِnَٰwْdُʿعْlٱَw","root":"عدو"},{"id":8,"arabic":"وَأَكْلِهِمُ","translit":"ُmِhِlْkَaʾَw","root":"اكل"},{"id":9,"arabic":"ٱلسُّحْتَ","translit":"َtْḥُّslٱ","root":"سحت"},{"id":10,"arabic":"لَبِئْسَ","translit":"َsْyʾِbَl","root":"باس"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":13,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":63,"text":"لَوْلَا يَنْهَىٰهُمُ ٱلرَّبَّٰنِيُّونَ وَٱلْأَحْبَارُ عَن قَوْلِهِمُ ٱلْإِثْمَ وَأَكْلِهِمُ ٱلسُّحْتَۚ لَبِئْسَ مَا كَانُوا۟ يَصْنَعُونَ ","translation":"Why do the rabbis and religious scholars not forbid them from saying what is sinful and devouring what is unlawful? How wretched is what they have been practicing.","words":[{"id":1,"arabic":"لَوْلَا","translit":"āَlْwَl","root":""},{"id":2,"arabic":"يَنْهَىٰهُمُ","translit":"ُmُhٰàَhْnَy","root":"نهي"},{"id":3,"arabic":"ٱلرَّبَّٰنِيُّونَ","translit":"َnwُّyِnَّٰbَّrlٱ","root":"ربب"},{"id":4,"arabic":"وَٱلْأَحْبَارُ","translit":"ُrāَbْḥَaʾْlٱَw","root":"حبر"},{"id":5,"arabic":"عَن","translit":"nَʿع","root":""},{"id":6,"arabic":"قَوْلِهِمُ","translit":"ُmِhِlْwَq","root":"قول"},{"id":7,"arabic":"ٱلْإِثْمَ","translit":"َmْhtِiʾْlٱ","root":"اثم"},{"id":8,"arabic":"وَأَكْلِهِمُ","translit":"ُmِhِlْkَaʾَw","root":"اكل"},{"id":9,"arabic":"ٱلسُّحْتَ","translit":"َtْḥُّslٱ","root":"سحت"},{"id":10,"arabic":"لَبِئْسَ","translit":"َsْyʾِbَl","root":"باس"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":13,"arabic":"يَصْنَعُونَ","translit":"َnwُʿعَnْṣَy","root":"صنع"}],"hasIhya":true},{"ayah":64,"text":"وَقَالَتِ ٱلْيَهُودُ يَدُ ٱللَّهِ مَغْلُولَةٌۚ غُلَّتْ أَيْدِيهِمْ وَلُعِنُوا۟ بِمَا قَالُواۘ بَلْ يَدَاهُ مَبْسُوطَتَانِ يُنفِقُ كَيْفَ يَشَآءُۚ وَلَيَزِيدَنَّ كَثِيرًا مِّنْهُم مَّآ أُنزِلَ إِلَيْكَ مِن رَّبِّكَ طُغْيَٰنًا وَكُفْرًاۚ وَأَلْقَيْنَا بَيْنَهُمُ ٱلْعَدَٰوَةَ وَٱلْبَغْضَآءَ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِۚ كُلَّمَآ أَوْقَدُوا۟ نَارًا لِّلْحَرْبِ أَطْفَأَهَا ٱللَّهُۚ وَيَسْعَوْنَ فِى ٱلْأَرْضِ فَسَادًاۚ وَٱللَّهُ لَا يُحِبُّ ٱلْمُفْسِدِينَ ","translation":"And the Jews say, \"The hand of Allāh is chained.\"[1] Chained are their hands, and cursed are they for what they say. Rather, both His hands are extended; He spends however He wills. And that which has been revealed to you from your Lord will surely increase many of them in transgression and disbelief. And We have cast among them animosity and hatred until the Day of Resurrection. Every time they kindled the fire of war [against you], Allāh extinguished it. And they strive throughout the land [causing] corruption, and Allāh does not like corrupters.","words":[{"id":1,"arabic":"وَقَالَتِ","translit":"ِtَlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلْيَهُودُ","translit":"ُdwُhَyْlٱ","root":"هود"},{"id":3,"arabic":"يَدُ","translit":"ُdَy","root":"يدي"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"مَغْلُولَةٌ","translit":"ٌẗَlwُlْغَm","root":"غلل"},{"id":6,"arabic":"غُلَّتْ","translit":"ْtَّlُغ","root":"غلل"},{"id":7,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":8,"arabic":"وَلُعِنُوا۟","translit":"۟āwُnِʿعُlَw","root":"لعن"},{"id":9,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":10,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":11,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":12,"arabic":"يَدَاهُ","translit":"ُhāَdَy","root":"يدي"},{"id":13,"arabic":"مَبْسُوطَتَانِ","translit":"ِnāَtَṭwُsْbَm","root":"بسط"},{"id":14,"arabic":"يُنفِقُ","translit":"ُqِfnُy","root":"نفق"},{"id":15,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":16,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":17,"arabic":"وَلَيَزِيدَنَّ","translit":"َّnَdyِzَyَlَw","root":"زيد"},{"id":18,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":19,"arabic":"مِّنْهُم","translit":"mُhْnِّm","root":""},{"id":20,"arabic":"مَّآ","translit":"ٓāَّm","root":""},{"id":21,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":22,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":23,"arabic":"مِن","translit":"nِm","root":""},{"id":24,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":25,"arabic":"طُغْيَٰنًا","translit":"āًnَٰyْغُṭ","root":"طغي"},{"id":26,"arabic":"وَكُفْرًا","translit":"āًrْfُkَw","root":"كفر"},{"id":27,"arabic":"وَأَلْقَيْنَا","translit":"āَnْyَqْlَaʾَw","root":"لقي"},{"id":28,"arabic":"بَيْنَهُمُ","translit":"ُmُhَnْyَb","root":"بين"},{"id":29,"arabic":"ٱلْعَدَٰوَةَ","translit":"َẗَwَٰdَʿعْlٱ","root":"عدو"},{"id":30,"arabic":"وَٱلْبَغْضَآءَ","translit":"َءٓāَḍْغَbْlٱَw","root":"بغض"},{"id":31,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":32,"arabic":"يَوْمِ","translit":"ِmْwَy","root":"يوم"},{"id":33,"arabic":"ٱلْقِيَٰمَةِ","translit":"ِẗَmَٰyِqْlٱ","root":"قوم"},{"id":34,"arabic":"كُلَّمَآ","translit":"ٓāَmَّlُk","root":"كلل"},{"id":35,"arabic":"أَوْقَدُوا۟","translit":"۟āwُdَqْwَaʾ","root":"وقد"},{"id":36,"arabic":"نَارًا","translit":"āًrāَn","root":"نور"},{"id":37,"arabic":"لِّلْحَرْبِ","translit":"ِbْrَḥْlِّl","root":"حرب"},{"id":38,"arabic":"أَطْفَأَهَا","translit":"āَhَaʾَfْṭَaʾ","root":"طفا"},{"id":39,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":40,"arabic":"وَيَسْعَوْنَ","translit":"َnْwَʿعْsَyَw","root":"سعي"},{"id":41,"arabic":"فِى","translit":"àِf","root":""},{"id":42,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":43,"arabic":"فَسَادًا","translit":"āًdāَsَf","root":"فسد"},{"id":44,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":45,"arabic":"لَا","translit":"āَl","root":""},{"id":46,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":47,"arabic":"ٱلْمُفْسِدِينَ","translit":"َnyِdِsْfُmْlٱ","root":"فسد"}],"hasIhya":true},{"ayah":65,"text":"وَلَوْ أَنَّ أَهْلَ ٱلْكِتَٰبِ ءَامَنُوا۟ وَٱتَّقَوْا۟ لَكَفَّرْنَا عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَأَدْخَلْنَٰهُمْ جَنَّٰتِ ٱلنَّعِيمِ ","translation":"And if only the People of the Scripture had believed and feared Allāh, We would have removed from them their misdeeds and admitted them to Gardens of Pleasure.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":3,"arabic":"أَهْلَ","translit":"َlْhَaʾ","root":"اهل"},{"id":4,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":6,"arabic":"وَٱتَّقَوْا۟","translit":"۟āْwَqَّtٱَw","root":"وقي"},{"id":7,"arabic":"لَكَفَّرْنَا","translit":"āَnْrَّfَkَl","root":"كفر"},{"id":8,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":9,"arabic":"سَيِّـَٔاتِهِمْ","translit":"ْmِhِtāَٔـِّyَs","root":"سوا"},{"id":10,"arabic":"وَلَأَدْخَلْنَٰهُمْ","translit":"ْmُhَٰnْlَhkْdَaʾَlَw","root":"دخل"},{"id":11,"arabic":"جَنَّٰتِ","translit":"ِtَّٰnَjg","root":"جنن"},{"id":12,"arabic":"ٱلنَّعِيمِ","translit":"ِmyِʿعَّnlٱ","root":"نعم"}],"hasIhya":false},{"ayah":66,"text":"وَلَوْ أَنَّهُمْ أَقَامُوا۟ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ وَمَآ أُنزِلَ إِلَيْهِم مِّن رَّبِّهِمْ لَأَكَلُوا۟ مِن فَوْقِهِمْ وَمِن تَحْتِ أَرْجُلِهِمۚ مِّنْهُمْ أُمَّةٌ مُّقْتَصِدَةٌۖ وَكَثِيرٌ مِّنْهُمْ سَآءَ مَا يَعْمَلُونَ ","translation":"And if only they had upheld [the law of] the Torah, the Gospel, and what has been revealed to them from their Lord [i.e., the Qur’ān], they would have consumed [provision] from above them and from beneath their feet.[1] Among them are a moderate [i.e., acceptable] community, but many of them - evil is that which they do.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":3,"arabic":"أَقَامُوا۟","translit":"۟āwُmāَqَaʾ","root":"قوم"},{"id":4,"arabic":"ٱلتَّوْرَىٰةَ","translit":"َẗٰàَrْwَّtlٱ","root":""},{"id":5,"arabic":"وَٱلْإِنجِيلَ","translit":"َlyِjgnِiʾْlٱَw","root":""},{"id":6,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":7,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":8,"arabic":"إِلَيْهِم","translit":"mِhْyَlِiʾ","root":""},{"id":9,"arabic":"مِّن","translit":"nِّm","root":""},{"id":10,"arabic":"رَّبِّهِمْ","translit":"ْmِhِّbَّr","root":"ربب"},{"id":11,"arabic":"لَأَكَلُوا۟","translit":"۟āwُlَkَaʾَl","root":"اكل"},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"فَوْقِهِمْ","translit":"ْmِhِqْwَf","root":"فوق"},{"id":14,"arabic":"وَمِن","translit":"nِmَw","root":""},{"id":15,"arabic":"تَحْتِ","translit":"ِtْḥَt","root":"تحت"},{"id":16,"arabic":"أَرْجُلِهِم","translit":"mِhِlُjgْrَaʾ","root":"رجل"},{"id":17,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":18,"arabic":"أُمَّةٌ","translit":"ٌẗَّmُaʾ","root":"امم"},{"id":19,"arabic":"مُّقْتَصِدَةٌ","translit":"ٌẗَdِṣَtْqُّm","root":"قصد"},{"id":20,"arabic":"وَكَثِيرٌ","translit":"ٌryِhtَkَw","root":"كثر"},{"id":21,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":22,"arabic":"سَآءَ","translit":"َءٓāَs","root":"سوا"},{"id":23,"arabic":"مَا","translit":"āَm","root":""},{"id":24,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":67,"text":"يَٰٓأَيُّهَا ٱلرَّسُولُ بَلِّغْ مَآ أُنزِلَ إِلَيْكَ مِن رَّبِّكَۖ وَإِن لَّمْ تَفْعَلْ فَمَا بَلَّغْتَ رِسَالَتَهُۥۚ وَٱللَّهُ يَعْصِمُكَ مِنَ ٱلنَّاسِۗ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلْكَٰفِرِينَ ","translation":"O Messenger, announce that which has been revealed to you from your Lord, and if you do not, then you have not conveyed His message. And Allāh will protect you from the people. Indeed, Allāh does not guide the disbelieving people.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلرَّسُولُ","translit":"ُlwُsَّrlٱ","root":"رسل"},{"id":3,"arabic":"بَلِّغْ","translit":"ْغِّlَb","root":"بلغ"},{"id":4,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":5,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":6,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":9,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":10,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":11,"arabic":"تَفْعَلْ","translit":"ْlَʿعْfَt","root":"فعل"},{"id":12,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":13,"arabic":"بَلَّغْتَ","translit":"َtْغَّlَb","root":"بلغ"},{"id":14,"arabic":"رِسَالَتَهُۥ","translit":"ۥُhَtَlāَsِr","root":"رسل"},{"id":15,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":16,"arabic":"يَعْصِمُكَ","translit":"َkُmِṣْʿعَy","root":"عصم"},{"id":17,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":18,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":19,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":20,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":21,"arabic":"لَا","translit":"āَl","root":""},{"id":22,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":23,"arabic":"ٱلْقَوْمَ","translit":"َmْwَqْlٱ","root":"قوم"},{"id":24,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"}],"hasIhya":true},{"ayah":68,"text":"قُلْ يَٰٓأَهْلَ ٱلْكِتَٰبِ لَسْتُمْ عَلَىٰ شَىْءٍ حَتَّىٰ تُقِيمُوا۟ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ وَمَآ أُنزِلَ إِلَيْكُم مِّن رَّبِّكُمْۗ وَلَيَزِيدَنَّ كَثِيرًا مِّنْهُم مَّآ أُنزِلَ إِلَيْكَ مِن رَّبِّكَ طُغْيَٰنًا وَكُفْرًاۖ فَلَا تَأْسَ عَلَى ٱلْقَوْمِ ٱلْكَٰفِرِينَ ","translation":"Say, \"O People of the Scripture, you are [standing] on nothing until you uphold [the law of] the Torah, the Gospel, and what has been revealed to you from your Lord [i.e., the Qur’ān].\" And that which has been revealed to you from your Lord will surely increase many of them in transgression and disbelief. So do not grieve over the disbelieving people.","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"يَٰٓأَهْلَ","translit":"َlْhَaʾَٰٓy","root":"اهل"},{"id":3,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":4,"arabic":"لَسْتُمْ","translit":"ْmُtْsَl","root":"ليس"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":7,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":8,"arabic":"تُقِيمُوا۟","translit":"۟āwُmyِqُt","root":"قوم"},{"id":9,"arabic":"ٱلتَّوْرَىٰةَ","translit":"َẗٰàَrْwَّtlٱ","root":""},{"id":10,"arabic":"وَٱلْإِنجِيلَ","translit":"َlyِjgnِiʾْlٱَw","root":""},{"id":11,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":12,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":13,"arabic":"إِلَيْكُم","translit":"mُkْyَlِiʾ","root":""},{"id":14,"arabic":"مِّن","translit":"nِّm","root":""},{"id":15,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":16,"arabic":"وَلَيَزِيدَنَّ","translit":"َّnَdyِzَyَlَw","root":"زيد"},{"id":17,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":18,"arabic":"مِّنْهُم","translit":"mُhْnِّm","root":""},{"id":19,"arabic":"مَّآ","translit":"ٓāَّm","root":""},{"id":20,"arabic":"أُنزِلَ","translit":"َlِznُaʾ","root":"نزل"},{"id":21,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":22,"arabic":"مِن","translit":"nِm","root":""},{"id":23,"arabic":"رَّبِّكَ","translit":"َkِّbَّr","root":"ربب"},{"id":24,"arabic":"طُغْيَٰنًا","translit":"āًnَٰyْغُṭ","root":"طغي"},{"id":25,"arabic":"وَكُفْرًا","translit":"āًrْfُkَw","root":"كفر"},{"id":26,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":27,"arabic":"تَأْسَ","translit":"َsْaʾَt","root":"اسو"},{"id":28,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":29,"arabic":"ٱلْقَوْمِ","translit":"ِmْwَqْlٱ","root":"قوم"},{"id":30,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"}],"hasIhya":false},{"ayah":69,"text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ هَادُوا۟ وَٱلصَّٰبِـُٔونَ وَٱلنَّصَٰرَىٰ مَنْ ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَعَمِلَ صَٰلِحًا فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ","translation":"Indeed, those who have believed [in Prophet Muḥammad (ﷺ)] and those [before him (ﷺ)] who were Jews or Sabeans or Christians - those [among them] who believed in Allāh and the Last Day and did righteousness - no fear will there be concerning them, nor will they grieve.[1]","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":5,"arabic":"هَادُوا۟","translit":"۟āwُdāَh","root":"هود"},{"id":6,"arabic":"وَٱلصَّٰبِـُٔونَ","translit":"َnwُٔـِbَّٰṣlٱَw","root":"صبا"},{"id":7,"arabic":"وَٱلنَّصَٰرَىٰ","translit":"ٰàَrَٰṣَّnlٱَw","root":"نصر"},{"id":8,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":9,"arabic":"ءَامَنَ","translit":"َnَmāَء","root":"امن"},{"id":10,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":11,"arabic":"وَٱلْيَوْمِ","translit":"ِmْwَyْlٱَw","root":"يوم"},{"id":12,"arabic":"ٱلْءَاخِرِ","translit":"ِrِhkāَءْlٱ","root":"اخر"},{"id":13,"arabic":"وَعَمِلَ","translit":"َlِmَʿعَw","root":"عمل"},{"id":14,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":15,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":16,"arabic":"خَوْفٌ","translit":"ٌfْwَhk","root":"خوف"},{"id":17,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":18,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":19,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":20,"arabic":"يَحْزَنُونَ","translit":"َnwُnَzْḥَy","root":"حزن"}],"hasIhya":true},{"ayah":70,"text":"لَقَدْ أَخَذْنَا مِيثَٰقَ بَنِىٓ إِسْرَٰٓءِيلَ وَأَرْسَلْنَآ إِلَيْهِمْ رُسُلًاۖ كُلَّمَا جَآءَهُمْ رَسُولٌۢ بِمَا لَا تَهْوَىٰٓ أَنفُسُهُمْ فَرِيقًا كَذَّبُوا۟ وَفَرِيقًا يَقْتُلُونَ ","translation":"We had already taken the covenant of the Children of Israel and had sent to them messengers. Whenever there came to them a messenger with what their souls did not desire, a party [of messengers] they denied, and another party they killed.","words":[{"id":1,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":2,"arabic":"أَخَذْنَا","translit":"āَnْhdَhkَaʾ","root":"اخذ"},{"id":3,"arabic":"مِيثَٰقَ","translit":"َqَٰhtyِm","root":"وثق"},{"id":4,"arabic":"بَنِىٓ","translit":"ٓàِnَb","root":"بني"},{"id":5,"arabic":"إِسْرَٰٓءِيلَ","translit":"َlyِءَٰٓrْsِiʾ","root":""},{"id":6,"arabic":"وَأَرْسَلْنَآ","translit":"ٓāَnْlَsْrَaʾَw","root":"رسل"},{"id":7,"arabic":"إِلَيْهِمْ","translit":"ْmِhْyَlِiʾ","root":""},{"id":8,"arabic":"رُسُلًا","translit":"āًlُsُr","root":"رسل"},{"id":9,"arabic":"كُلَّمَا","translit":"āَmَّlُk","root":"كلل"},{"id":10,"arabic":"جَآءَهُمْ","translit":"ْmُhَءٓāَjg","root":"جيا"},{"id":11,"arabic":"رَسُولٌۢ","translit":"ٌۢlwُsَr","root":"رسل"},{"id":12,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":13,"arabic":"لَا","translit":"āَl","root":""},{"id":14,"arabic":"تَهْوَىٰٓ","translit":"ٰٓàَwْhَt","root":"هوي"},{"id":15,"arabic":"أَنفُسُهُمْ","translit":"ْmُhُsُfnَaʾ","root":"نفس"},{"id":16,"arabic":"فَرِيقًا","translit":"āًqyِrَf","root":"فرق"},{"id":17,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":18,"arabic":"وَفَرِيقًا","translit":"āًqyِrَfَw","root":"فرق"},{"id":19,"arabic":"يَقْتُلُونَ","translit":"َnwُlُtْqَy","root":"قتل"}],"hasIhya":false},{"ayah":71,"text":"وَحَسِبُوٓا۟ أَلَّا تَكُونَ فِتْنَةٌ فَعَمُوا۟ وَصَمُّوا۟ ثُمَّ تَابَ ٱللَّهُ عَلَيْهِمْ ثُمَّ عَمُوا۟ وَصَمُّوا۟ كَثِيرٌ مِّنْهُمْۚ وَٱللَّهُ بَصِيرٌۢ بِمَا يَعْمَلُونَ ","translation":"And they thought there would be no [resulting] punishment, so they became blind and deaf. Then Allāh turned to them in forgiveness; then [again] many of them became blind and deaf. And Allāh is Seeing of what they do.","words":[{"id":1,"arabic":"وَحَسِبُوٓا۟","translit":"۟āٓwُbِsَḥَw","root":"حسب"},{"id":2,"arabic":"أَلَّا","translit":"āَّlَaʾ","root":""},{"id":3,"arabic":"تَكُونَ","translit":"َnwُkَt","root":"كون"},{"id":4,"arabic":"فِتْنَةٌ","translit":"ٌẗَnْtِf","root":"فتن"},{"id":5,"arabic":"فَعَمُوا۟","translit":"۟āwُmَʿعَf","root":"عمي"},{"id":6,"arabic":"وَصَمُّوا۟","translit":"۟āwُّmَṣَw","root":"صمم"},{"id":7,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":8,"arabic":"تَابَ","translit":"َbāَt","root":"توب"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":11,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":12,"arabic":"عَمُوا۟","translit":"۟āwُmَʿع","root":"عمي"},{"id":13,"arabic":"وَصَمُّوا۟","translit":"۟āwُّmَṣَw","root":"صمم"},{"id":14,"arabic":"كَثِيرٌ","translit":"ٌryِhtَk","root":"كثر"},{"id":15,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":16,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":17,"arabic":"بَصِيرٌۢ","translit":"ٌۢryِṣَb","root":"بصر"},{"id":18,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":19,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"}],"hasIhya":false},{"ayah":72,"text":"لَقَدْ كَفَرَ ٱلَّذِينَ قَالُوٓا۟ إِنَّ ٱللَّهَ هُوَ ٱلْمَسِيحُ ٱبْنُ مَرْيَمَۖ وَقَالَ ٱلْمَسِيحُ يَٰبَنِىٓ إِسْرَٰٓءِيلَ ٱعْبُدُوا۟ ٱللَّهَ رَبِّى وَرَبَّكُمْۖ إِنَّهُۥ مَن يُشْرِكْ بِٱللَّهِ فَقَدْ حَرَّمَ ٱللَّهُ عَلَيْهِ ٱلْجَنَّةَ وَمَأْوَىٰهُ ٱلنَّارُۖ وَمَا لِلظَّٰلِمِينَ مِنْ أَنصَارٍ ","translation":"They have certainly disbelieved who say, \"Allāh is the Messiah, the son of Mary\" while the Messiah has said, \"O Children of Israel, worship Allāh, my Lord and your Lord.\" Indeed, he who associates others with Allāh - Allāh has forbidden him Paradise, and his refuge is the Fire. And there are not for the wrongdoers any helpers.","words":[{"id":1,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":2,"arabic":"كَفَرَ","translit":"َrَfَk","root":"كفر"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":5,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":8,"arabic":"ٱلْمَسِيحُ","translit":"ُḥyِsَmْlٱ","root":"مسح"},{"id":9,"arabic":"ٱبْنُ","translit":"ُnْbٱ","root":"بني"},{"id":10,"arabic":"مَرْيَمَ","translit":"َmَyْrَm","root":""},{"id":11,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":12,"arabic":"ٱلْمَسِيحُ","translit":"ُḥyِsَmْlٱ","root":"مسح"},{"id":13,"arabic":"يَٰبَنِىٓ","translit":"ٓàِnَbَٰy","root":"بني"},{"id":14,"arabic":"إِسْرَٰٓءِيلَ","translit":"َlyِءَٰٓrْsِiʾ","root":""},{"id":15,"arabic":"ٱعْبُدُوا۟","translit":"۟āwُdُbْʿعٱ","root":"عبد"},{"id":16,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":17,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":18,"arabic":"وَرَبَّكُمْ","translit":"ْmُkَّbَrَw","root":"ربب"},{"id":19,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":20,"arabic":"مَن","translit":"nَm","root":""},{"id":21,"arabic":"يُشْرِكْ","translit":"ْkِrْhsُy","root":"شرك"},{"id":22,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":23,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":24,"arabic":"حَرَّمَ","translit":"َmَّrَḥ","root":"حرم"},{"id":25,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":26,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":27,"arabic":"ٱلْجَنَّةَ","translit":"َẗَّnَjgْlٱ","root":"جنن"},{"id":28,"arabic":"وَمَأْوَىٰهُ","translit":"ُhٰàَwْaʾَmَw","root":"اوي"},{"id":29,"arabic":"ٱلنَّارُ","translit":"ُrāَّnlٱ","root":"نور"},{"id":30,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":31,"arabic":"لِلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlِl","root":"ظلم"},{"id":32,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":33,"arabic":"أَنصَارٍ","translit":"ٍrāَṣnَaʾ","root":"نصر"}],"hasIhya":true},{"ayah":73,"text":"لَّقَدْ كَفَرَ ٱلَّذِينَ قَالُوٓا۟ إِنَّ ٱللَّهَ ثَالِثُ ثَلَٰثَةٍۘ وَمَا مِنْ إِلَٰهٍ إِلَّآ إِلَٰهٌ وَٰحِدٌۚ وَإِن لَّمْ يَنتَهُوا۟ عَمَّا يَقُولُونَ لَيَمَسَّنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ عَذَابٌ أَلِيمٌ ","translation":"They have certainly disbelieved who say, \"Allāh is the third of three.\"[1] And there is no god except one God. And if they do not desist from what they are saying, there will surely afflict the disbelievers among them a painful punishment.","words":[{"id":1,"arabic":"لَّقَدْ","translit":"ْdَqَّl","root":""},{"id":2,"arabic":"كَفَرَ","translit":"َrَfَk","root":"كفر"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":5,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"ثَالِثُ","translit":"ُhtِlāَht","root":"ثلث"},{"id":8,"arabic":"ثَلَٰثَةٍ","translit":"ٍẗَhtَٰlَht","root":"ثلث"},{"id":9,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":10,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":11,"arabic":"إِلَٰهٍ","translit":"ٍhَٰlِiʾ","root":"اله"},{"id":12,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":13,"arabic":"إِلَٰهٌ","translit":"ٌhَٰlِiʾ","root":"اله"},{"id":14,"arabic":"وَٰحِدٌ","translit":"ٌdِḥَٰw","root":"وحد"},{"id":15,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":16,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":17,"arabic":"يَنتَهُوا۟","translit":"۟āwُhَtnَy","root":"نهي"},{"id":18,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":19,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":20,"arabic":"لَيَمَسَّنَّ","translit":"َّnَّsَmَyَl","root":"مسس"},{"id":21,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":22,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":23,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":24,"arabic":"عَذَابٌ","translit":"ٌbāَhdَʿع","root":"عذب"},{"id":25,"arabic":"أَلِيمٌ","translit":"ٌmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":74,"text":"أَفَلَا يَتُوبُونَ إِلَى ٱللَّهِ وَيَسْتَغْفِرُونَهُۥۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ","translation":"So will they not repent to Allāh and seek His forgiveness? And Allāh is Forgiving and Merciful.","words":[{"id":1,"arabic":"أَفَلَا","translit":"āَlَfَaʾ","root":""},{"id":2,"arabic":"يَتُوبُونَ","translit":"َnwُbwُtَy","root":"توب"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"وَيَسْتَغْفِرُونَهُۥ","translit":"ۥُhَnwُrِfْغَtْsَyَw","root":"غفر"},{"id":6,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":7,"arabic":"غَفُورٌ","translit":"ٌrwُfَغ","root":"غفر"},{"id":8,"arabic":"رَّحِيمٌ","translit":"ٌmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":75,"text":"مَّا ٱلْمَسِيحُ ٱبْنُ مَرْيَمَ إِلَّا رَسُولٌ قَدْ خَلَتْ مِن قَبْلِهِ ٱلرُّسُلُ وَأُمُّهُۥ صِدِّيقَةٌۖ كَانَا يَأْكُلَانِ ٱلطَّعَامَۗ ٱنظُرْ كَيْفَ نُبَيِّنُ لَهُمُ ٱلْءَايَٰتِ ثُمَّ ٱنظُرْ أَنَّىٰ يُؤْفَكُونَ ","translation":"The Messiah, son of Mary, was not but a messenger; [other] messengers have passed on before him. And his mother was a supporter of truth. They both used to eat food.[1] Look how We make clear to them the signs; then look how they are deluded.","words":[{"id":1,"arabic":"مَّا","translit":"āَّm","root":""},{"id":2,"arabic":"ٱلْمَسِيحُ","translit":"ُḥyِsَmْlٱ","root":"مسح"},{"id":3,"arabic":"ٱبْنُ","translit":"ُnْbٱ","root":"بني"},{"id":4,"arabic":"مَرْيَمَ","translit":"َmَyْrَm","root":""},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"رَسُولٌ","translit":"ٌlwُsَr","root":"رسل"},{"id":7,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":8,"arabic":"خَلَتْ","translit":"ْtَlَhk","root":"خلو"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"قَبْلِهِ","