translit":"","root":""},{"id":15,"arabic":"فَٰسِقُونَۖ","translit":"","root":""}],"narration":"warsh"},{"surah":5,"ayah":82,"text":"۞لَتَجِدَنَّ أَشَدَّ اَ۬لنَّاسِ عَدَٰوَةࣰ لِّلذِينَ ءَامَنُواْ اُ۬لْيَهُودَ وَالذِينَ أَشْرَكُواْۖ وَلَتَجِدَنَّ أَقْرَبَهُم مَّوَدَّةࣰ لِّلذِينَ ءَامَنُواْ اُ۬لذِينَ قَالُوٓاْ إِنَّا نَصَٰر۪يٰۖ ذَٰلِكَ بِأَنَّ مِنْهُمْ قِسِّيسِينَ وَرُهْبَاناࣰ وَأَنَّهُمْ لَا يَسْتَكْبِرُونَۖ","words":[{"id":1,"arabic":"۞لَتَجِدَنَّ","translit":"","root":""},{"id":2,"arabic":"أَشَدَّ","translit":"","root":""},{"id":3,"arabic":"اَ۬لنَّاسِ","translit":"","root":""},{"id":4,"arabic":"عَدَٰوَةࣰ","translit":"","root":""},{"id":5,"arabic":"لِّلذِينَ","translit":"","root":""},{"id":6,"arabic":"ءَامَنُواْ","translit":"","root":""},{"id":7,"arabic":"اُ۬لْيَهُودَ","translit":"","root":""},{"id":8,"arabic":"وَالذِينَ","translit":"","root":""},{"id":9,"arabic":"أَشْرَكُواْۖ","translit":"","root":""},{"id":10,"arabic":"وَلَتَجِدَنَّ","translit":"","root":""},{"id":11,"arabic":"أَقْرَبَهُم","translit":"","root":""},{"id":12,"arabic":"مَّوَدَّةࣰ","translit":"","root":""},{"id":13,"arabic":"لِّلذِينَ","translit":"","root":""},{"id":14,"arabic":"ءَامَنُواْ","translit":"","root":""},{"id":15,"arabic":"اُ۬لذِينَ","translit":"","root":""},{"id":16,"arabic":"قَالُوٓاْ","translit":"","root":""},{"id":17,"arabic":"إِنَّا","translit":"","root":""},{"id":18,"arabic":"نَصَٰر۪يٰۖ","translit":"","root":""},{"id":19,"arabic":"ذَٰلِكَ","translit":"","root":""},{"id":20,"arabic":"بِأَنَّ","translit":"","root":""},{"id":21,"arabic":"مِنْهُمْ","translit":"","root":""},{"id":22,"arabic":"قِسِّيسِينَ","translit":"","root":""},{"id":23,"arabic":"وَرُهْبَاناࣰ","translit":"","root":""},{"id":24,"arabic":"وَأَنَّهُمْ","translit":"","root":""},{"id":25,"arabic":"لَا","translit":"","root":""},{"id":26,"arabic":"يَسْتَكْبِرُونَۖ","translit":"","root":""}],"narration":"warsh"},{"surah":5,"ayah":83,"text":"وَإِذَا سَمِعُواْ مَآ أُنزِلَ إِلَي اَ۬لرَّسُولِ تَر۪يٰٓ أَعْيُنَهُمْ تَف