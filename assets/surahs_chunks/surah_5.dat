ٓا۟ ءَامَنَّا وَٱشْهَدْ بِأَنَّنَا مُسْلِمُونَ ","translation":"And [remember] when I inspired to the disciples, \"Believe in Me and in My messenger [i.e., Jesus].\" They said, \"We have believed, so bear witness that indeed we are Muslims [in submission to Allāh].\"","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"أَوْحَيْتُ","translit":"ُtْyَḥْwَaʾ","root":"وحي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلْحَوَارِيِّۦنَ","translit":"َnۦِّyِrāَwَḥْlٱ","root":"حور"},{"id":5,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":6,"arabic":"ءَامِنُوا۟","translit":"۟āwُnِmāَء","root":"امن"},{"id":7,"arabic":"بِى","translit":"àِb","root":""},{"id":8,"arabic":"وَبِرَسُولِى","translit":"àِlwُsَrِbَw","root":"رسل"},{"id":9,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":10,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":11,"arabic":"وَٱشْهَدْ","translit":"ْdَhْhsٱَw","root":"شهد"},{"id":12,"arabic":"بِأَنَّنَا","translit":"āَnَّnَaʾِb","root":""},{"id":13,"arabic":"مُسْلِمُونَ","translit":"َnwُmِlْsُm","root":"سلم"}],"hasIhya":false},{"ayah":112,"text":"إِذْ قَالَ ٱلْحَوَارِيُّونَ يَٰعِيسَى ٱبْنَ مَرْيَمَ هَلْ يَسْتَطِيعُ رَبُّكَ أَن يُنَزِّلَ عَلَيْنَا مَآئِدَةً مِّنَ ٱلسَّمَآءِۖ قَالَ ٱتَّقُوا۟ ٱللَّهَ إِن كُنتُم مُّؤْمِنِينَ ","translation":"[And remember] when the disciples said, \"O Jesus, Son of Mary, can your Lord[1] send down to us a table [spread with food] from the heaven?\" [Jesus] said, \"Fear Allāh, if you should be believers.\"","words":[{"id":1,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":2,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":3,"arabic":"ٱلْحَوَارِيُّونَ","translit":"َnwُّyِrāَwَḥْlٱ","root":"حور"},{"id":4,"arabic":"يَٰعِيسَى","translit":"àَsyِʿعَٰy","root":""},{"id":5,"arabic":"ٱبْنَ","translit":"َnْbٱ","root":"بني"},{"id":6,"arabic":"مَرْيَمَ","translit":"َmَyْrَm","root":""},{"id":7,"arabic":"هَلْ","translit":"ْlَh","root":""}