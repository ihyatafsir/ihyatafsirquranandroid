 created. He forgives whom He wills, and He punishes whom He wills. And to Allāh belongs the dominion of the heavens and the earth and whatever is between them, and to Him is the [final] destination.","words":[{"id":1,"arabic":"وَقَالَتِ","translit":"ِtَlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلْيَهُودُ","translit":"ُdwُhَyْlٱ","root":"هود"},{"id":3,"arabic":"وَٱلنَّصَٰرَىٰ","translit":"ٰàَrَٰṣَّnlٱَw","root":"نصر"},{"id":4,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":5,"arabic":"أَبْنَٰٓؤُا۟","translit":"۟āُwʾَٰٓnْbَaʾ","root":"بني"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"وَأَحِبَّٰٓؤُهُۥ","translit":"ۥُhُwʾَّٰٓbِḥَaʾَw","root":"حبب"},{"id":8,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":9,"arabic":"فَلِمَ","translit":"َmِlَf","root":""},{"id":10,"arabic":"يُعَذِّبُكُم","translit":"mُkُbِّhdَʿعُy","root":"عذب"},{"id":11,"arabic":"بِذُنُوبِكُم","translit":"mُkِbwُnُhdِb","root":"ذنب"},{"id":12,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":13,"arabic":"أَنتُم","translit":"mُtnَaʾ","root":""},{"id":14,"arabic":"بَشَرٌ","translit":"ٌrَhsَb","root":"بشر"},{"id":15,"arabic":"مِّمَّنْ","translit":"ْnَّmِّm","root":""},{"id":16,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":17,"arabic":"يَغْفِرُ","translit":"ُrِfْغَy","root":"غفر"},{"id":18,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":19,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":20,"arabic":"وَيُعَذِّبُ","translit":"ُbِّhdَʿعُyَw","root":"عذب"},{"id":21,"arabic":"مَن","translit":"nَm","root":""},{"id":22,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":23,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":24,"arabic":"مُلْكُ","translit":"ُkْlُm","root":"ملك"},{"id":25,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":26,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":27,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":28,"arabic":"بَيْنَهُمَا","translit":"āَmُhَnْyَb","root":"بين"},{"id":29,"arabic":"وَإِلَيْهِ","translit":"ِhْyَlِiʾَw","root":""},{"id":30,"arabic":"ٱلْمَصِيرُ","translit":"ُryِṣَmْlٱ","root":"صير"}],"hasIhya":true},{"ayah":19,"text":"يَٰٓأَهْلَ ٱلْكِتَٰبِ قَدْ جَآءَكُمْ رَسُولُنَا يُبَيِّنُ لَكُمْ عَلَىٰ فَتْرَةٍ مِّنَ ٱلرُّسُلِ أَن تَقُولُوا۟ مَا جَآءَنَا مِنۢ بَشِيرٍ وَلَا نَذِيرٍۖ فَقَدْ جَآءَكُم بَشِيرٌ وَنَذِيرٌۗ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ","translation":"O People of the Scripture, there has come to you Our Messenger to make clear to you [the religion] after a period [of suspension] of messengers, lest you say, \"There came not to us any bringer of good tidings or a warner.\" But there has come to you a bringer of good tidings and a warner. And Allāh is over all things competent.","words":[{"id":1,"arabic":"يَٰٓأَهْلَ","translit":"َlْhَaʾَٰٓy","root":"اهل"},{"id":2,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":3,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":4,"arabic":"جَآءَكُمْ","translit":"ْmُkَءٓāَjg","root":"جيا"},{"id":5,"arabic":"رَسُولُنَا","translit":"āَnُlwُsَr","root":"رسل"},{"id":6,"arabic":"يُبَيِّنُ","translit":"ُnِّyَbُy","root":"بين"},{"id":7,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":8,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":9,"arabic":"فَتْرَةٍ","translit":"ٍẗَrْtَf","root":"فتر"},{"id":10,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":11,"arabic":"ٱلرُّسُلِ","translit":"ِlُsُّrlٱ","root":"رسل"},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"تَقُولُوا۟","translit":"۟āwُlwُqَt","root":"قول"},{"id":14,"arabic":"مَا","translit":"āَm","root":""},{"id":15,"arabic":"جَآءَنَا","translit":"āَnَءٓāَjg","root":"جيا"},{"id":16,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":17,"arabic":"بَشِيرٍ","translit":"ٍryِhsَb","root":"بشر"},{"id":18,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":19,"arabic":"نَذِيرٍ","translit":"ٍryِhdَn","root":"نذر"},{"id":20,"arabic":"فَقَدْ","tr