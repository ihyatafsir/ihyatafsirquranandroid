 "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 61, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 62, "arabic": "خِزْىٌ", "translit": "ٌàْzِhk", "root": "خزي"}, {"id": 63, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 64, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 65, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 66, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 67, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 42, "text": "سَمَّٰعُونَ لِلْكَذِبِ أَكَّٰلُونَ لِلسُّحْتِۚ فَإِن جَآءُوكَ فَٱحْكُم بَيْنَهُمْ أَوْ أَعْرِضْ عَنْهُمْۖ وَإِن تُعْرِضْ عَنْهُمْ فَلَن يَضُرُّوكَ شَيْـًٔاۖ وَإِنْ حَكَمْتَ فَٱحْكُم بَيْنَهُم بِٱلْقِسْطِۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُقْسِطِينَ ", "translation": "[They are] avid listeners to falsehood, devourers of [what is] unlawful. So if they come to you, [O Muḥammad], judge between them or turn away from them. And if you turn away from them - never will they harm you at all. And if you judge, judge between them with justice. Indeed, Allāh loves those who act justly.", "words": [{"id": 1, "arabic": "سَمَّٰعُونَ", "translit": "َnwُʿعَّٰmَs", "root": "سمع"}, {"id": 2, "arabic": "لِلْكَذِبِ", "translit": "ِbِhdَkْlِl", "root": "كذب"}, {"id": 3, "arabic": "أَكَّٰلُونَ", "translit": "َnwُlَّٰkَaʾ", "root": "اكل"}, {"id": 4, "arabic": "لِلسُّحْتِ", "translit": "ِtْḥُّslِl", "root": "سحت"}, {"id": 5, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 6, "arabic": "جَآءُوكَ", "translit": "َkwُءٓāَjg", "root": "جيا"}, {"id": 7, "arabic": "فَٱحْكُم", "translit": "mُkْḥٱَf", "root": "حكم"}, {"id": 8, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 9, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 10, "arabic": "أَعْرِضْ", "translit": "ْḍِrْʿعَaʾ", "root": "عرض"}, {"id": 11, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 12, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 13, "arabic": "تُعْرِضْ", "translit": "ْḍِrْʿعُt", "root": "عرض"}, {"id": 14, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 15, "arabic": "فَلَن", "translit": "nَlَf", "root": ""}, {"id": 16, "arabic": "يَضُرُّوكَ", "translit": "َkwُّrُḍَy", "root": "ضرر"}, {"id": 17, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 18, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 19, "arabic": "حَكَمْتَ", "translit": "َtْmَkَḥ", "root": "حكم"}, {"id": 20, "arabic": "فَٱحْكُم", "translit": "mُkْḥٱَf", "root": "حكم"}, {"id": 21, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 22, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 23, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 24, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 26, "arabic": "ٱلْمُقْسِطِينَ", "translit": "َnyِṭِsْqُmْlٱ", "root": "قسط"}], "hasIhya": true}, {"ayah": 43, "text": "وَكَيْفَ يُحَكِّمُونَكَ وَعِندَهُمُ ٱلتَّوْرَىٰةُ فِيهَا حُكْمُ ٱللَّهِ ثُمَّ يَتَوَلَّوْنَ مِنۢ بَعْدِ ذَٰلِكَۚ وَمَآ أُو۟لَٰٓئِكَ بِٱلْمُؤْمِنِينَ ", "translation": "But how is it that they come to you for judgement while they have the Torah, in which is the judgement of Allāh? Then they turn away, [even] after that; but those are not [in fact] believers.", "words": [{"id": 1, "arabic": "وَكَيْفَ", "translit": "َfْyَkَw", "root": "كيف"}, {"id": 2, "arabic": "يُحَكِّمُونَكَ", "translit": "َkَnwُmِّkَḥُy", "root": "حكم"}, {"id": 3, "arabic": "وَعِندَهُمُ", "translit": "ُmُhَdnِʿعَw", "root": "عند"}, {"id": 4, "arabic": "ٱلتَّوْرَىٰةُ", "translit": "ُẗٰàَrْwَّtlٱ", "root": ""}, {"id": 5, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 6, "arabic": "حُكْمُ", "translit": "ُmْkُḥ", "root": "حكم"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "يَتَوَلَّوْنَ", "translit": "َnْwَّlَwَtَy", "root": "ولي"}, {"id": 10, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 11, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 14, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 15, "arabic": "بِٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱِb", "root": "امن"}], "hasIhya": false}, {"ayah": 44, "text": "إِنَّآ أَنزَلْنَا ٱلتَّوْرَىٰةَ فِيهَا هُدًى وَنُورٌۚ يَحْكُمُ بِهَا ٱلنَّبِيُّونَ ٱلَّذِينَ أَسْلَمُوا۟ لِلَّذِينَ هَادُوا۟ وَٱلرَّبَّٰنِيُّونَ وَٱلْأَحْبَارُ بِمَا ٱسْتُحْفِظُوا۟ مِن كِتَٰبِ ٱللَّهِ وَكَانُوا۟ عَلَيْهِ شُهَدَآءَۚ فَلَا تَخْشَوُا۟ ٱلنَّاسَ وَٱخْشَوْنِ وَلَا تَشْتَرُوا۟ بِـَٔايَٰتِى ثَمَنًا قَلِيلًاۚ وَمَن لَّمْ يَحْكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُو۟لَٰٓئِكَ هُمُ ٱلْكَٰفِرُونَ ", "translation": "Indeed, We sent down the Torah, in which was guidance and light. The prophets who submitted [to Allāh] judged by it for the Jews, as did the rabbis and scholars by that with which they were entrusted of the Scripture of Allāh, and they were witnesses thereto. So do not fear the people but fear Me, and do not exchange My verses for a small price [i.e., worldly gain]. And whoever does not judge by what Allāh has revealed - then it is those who are the disbelievers.", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "ٱلتَّوْرَىٰةَ", "translit": "َẗٰàَrْwَّtlٱ", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 5, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 6, "arabic": "وَنُورٌ", "translit": "ٌrwُnَw", "root": "نور"}, {"id": 7, "arabic": "يَحْكُمُ", "translit": "ُmُkْḥَy", "root": "حكم"}, {"id": 8, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 9, "arabic": "ٱلنَّبِيُّونَ", "translit": "َnwُّyِbَّnlٱ", "root": "نبا"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "أَسْلَمُوا۟", "translit": "۟āwُmَlْsَaʾ", "root": "سلم"}, {"id": 12, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 13, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 14, "arabic": "وَٱلرَّبَّٰنِيُّونَ", "translit": "َnwُّyِnَّٰbَّrlٱَw", "root": "ربب"}, {"id": 15, "arabic": "وَٱلْأَحْبَارُ", "translit": "ُrāَbْḥَaʾْlٱَw", "root": "حبر"}, {"id": 16, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 17, "arabic": "ٱسْتُحْفِظُوا۟", "translit": "۟āwُẓِfْḥُtْsٱ", "root": "حفظ"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "كِتَٰبِ", "translit": "ِbَٰtِk", "root": "كتب"}, {"id": 20, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 22, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 23, "arabic": "شُهَدَآءَ", "translit": "َءٓāَdَhُhs", "root": "شهد"}, {"id": 24, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 25, "arabic": "تَخْشَوُا۟", "translit": "۟āُwَhsْhkَt", "root": "خشي"}, {"id": 26, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 27, "arabic": "وَٱخْشَوْنِ", "translit": "ِnْwَhsْhkٱَw", "root": "خشي"}, {"id": 28, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 29, "arabic": "تَشْتَرُوا۟", "translit": "۟āwُrَtْhsَt", "root": "شري"}, {"id": 30, "arabic": "بِـَٔايَٰتِى", "translit": "àِtَٰyāَٔـِb", "root": "ايي"}, {"id": 31, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 32, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 33, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 34, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 35, "arabic": "يَحْكُم", "translit": "mُkْḥَy", "root": "حكم"}, {"id": 36, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 37, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 38, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 39, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 40, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 41, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 45, "text": "وَكَتَبْنَا عَلَيْهِمْ فِيهَآ أَنَّ ٱلنَّفْسَ بِٱلنَّفْسِ وَٱلْعَيْنَ بِٱلْعَيْنِ وَٱلْأَنفَ بِٱلْأَنفِ وَٱلْأُذُنَ بِٱلْأُذُنِ وَٱلسِّنَّ بِٱلسِّنِّ وَٱلْجُرُوحَ قِصَاصٌۚ فَمَن تَصَدَّقَ بِهِۦ فَهُوَ كَفَّارَةٌ لَّهُۥۚ وَمَن لَّمْ يَحْكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُو۟لَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ ", "translation": "And We ordained for them therein a life for a life, an eye for an eye, a nose for a nose, an ear for an ear, a tooth for a tooth, and for wounds is legal retribution. But whoever gives [up his right as] charity, it is an expiation for him. And whoever does not judge by what Allāh has revealed - then it is those who are the wrongdoers [i.e., the unjust].", "words": [{"id": 1, "arabic": "وَكَتَبْنَا", "translit": "āَnْbَtَkَw", "root": "كتب"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 4, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 5, "arabic": "ٱلنَّفْسَ", "translit": "َsْfَّnlٱ", "root": "نفس"}, {"id": 6, "arabic": "بِٱلنَّفْسِ", "translit": "ِsْfَّnlٱِb", "root": "نفس"}, {"id": 7, "arabic": "وَٱلْعَيْنَ", "translit": "َnْyَʿعْlٱَw", "root": "عين"}, {"id": 8, "arabic": "بِٱلْعَيْنِ", "translit": "ِnْyَʿعْlٱِb", "root": "عين"}, {"id": 9, "arabic": "وَٱلْأَنفَ", "translit": "َfnَaʾْlٱَw", "root": "انف"}, {"id": 10, "arabic": "بِٱلْأَنفِ", "translit": "ِfnَaʾْlٱِb", "root": "انف"}, {"id": 11, "arabic": "وَٱلْأُذُنَ", "translit": "َnُhdُaʾْlٱَw", "root": "اذن"}, {"id": 12, "arabic": "بِٱلْأُذُنِ", "translit": "ِnُhdُaʾْlٱِb", "root": "اذن"}, {"id": 13, "arabic": "وَٱلسِّنَّ", "translit": "َّnِّslٱَw", "root": "سنن"}, {"id": 14, "arabic": "بِٱلسِّنِّ", "translit": "ِّnِّslٱِb", "root": "سنن"}, {"id": 15, "arabic": "وَٱلْجُرُوحَ", "translit": "َḥwُrُjgْlٱَw", "root": "جرح"}, {"id": 16, "arabic": "قِصَاصٌ", "translit": "ٌṣāَṣِq", "root": "قصص"}, {"id": 17, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 18, "arabic": "تَصَدَّقَ", "translit": "َqَّdَṣَt", "root": "صدق"}, {"id": 19, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 20, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 21, "arabic": "كَفَّارَةٌ", "translit": "ٌẗَrāَّfَk", "root": "كفر"}, {"id": 22, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 23, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 24, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 25, "arabic": "يَحْكُم", "translit": "mُkْḥَy", "root": "حكم"}, {"id": 26, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 27, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 28, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 30, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 31, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 46, "text": "وَقَفَّيْنَا عَلَىٰٓ ءَاثَٰرِهِم بِعِيسَى ٱبْنِ مَرْيَمَ مُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ مِنَ ٱلتَّوْرَىٰةِۖ وَءَاتَيْنَٰهُ ٱلْإِنجِيلَ فِيهِ هُدًى وَنُورٌ وَمُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ مِنَ ٱلتَّوْرَىٰةِ وَهُدًى وَمَوْعِظَةً لِّلْمُتَّقِينَ ", "translation": "And We sent, following in their footsteps,[1] Jesus, the son of Mary, confirming that which came before him in the Torah; and We gave him the Gospel, in which was guidance and light and confirming that which preceded it of the Torah as guidance and instruction for the righteous.", "words": [{"id": 1, "arabic": "وَقَفَّيْنَا", "translit": "āَnْyَّfَqَw", "root": "قفو"}, {"id": 2, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 3, "arabic": "ءَاثَٰرِهِم", "translit": "mِhِrَٰhtāَء", "root": "اثر"}, {"id": 4, "arabic": "بِعِيسَى", "translit": "àَsyِʿعِb", "root": ""}, {"id": 5, "arabic": "ٱبْنِ", "translit": "ِnْbٱ", "root": "بني"}, {"id": 6, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 7, "arabic": "مُصَدِّقًا", "translit": "āًqِّdَṣُm", "root": "صدق"}, {"id": 8, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 9, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 10, "arabic": "يَدَيْهِ", "translit": "ِhْyَdَy", "root": "يدي"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلتَّوْرَىٰةِ", "translit": "ِẗٰàَrْwَّtlٱ", "root": ""}, {"id": 13, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 14, "arabic": "ٱلْإِنجِيلَ", "translit": "َlyِjgnِiʾْlٱ", "root": ""}, {"id": 15, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 16, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 17, "arabic": "وَنُورٌ", "translit": "ٌrwُnَw", "root": "نور"}, {"id": 18, "arabic": "وَمُصَدِّقًا", "translit": "āًqِّdَṣُmَw", "root": "صدق"}, {"id": 19, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 20, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 21, "arabic": "يَدَيْهِ", "translit": "ِhْyَdَy", "root": "يدي"}, {"id": 22, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 23, "arabic": "ٱلتَّوْرَىٰةِ", "translit": "ِẗٰàَrْwَّtlٱ", "root": ""}, {"id": 24, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 25, "arabic": "وَمَوْعِظَةً", "translit": "ًẗَẓِʿعْwَmَw", "root": "وعظ"}, {"id": 26, "arabic": "لِّلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِّl", "root": "وقي"}], "hasIhya": false}, {"ayah": 47, "text": "وَلْيَحْكُمْ أَهْلُ ٱلْإِنجِيلِ بِمَآ أَنزَلَ ٱللَّهُ فِيهِۚ وَمَن لَّمْ يَحْكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُو۟لَٰٓئِكَ هُمُ ٱلْفَٰسِقُونَ ", "translation": "And let the People of the Gospel judge by what Allāh has revealed therein. And whoever does not judge by what Allāh has revealed - then it is those who are the defiantly disobedient.", "words": [{"id": 1, "arabic": "وَلْيَحْكُمْ", "translit": "ْmُkْḥَyْlَw", "root": "حكم"}, {"id": 2, "arabic": "أَهْلُ", "translit": "ُlْhَaʾ", "root": "اهل"}, {"id": 3, "arabic": "ٱلْإِنجِيلِ", "translit": "ِlyِjgnِiʾْlٱ", "root": ""}, {"id": 4, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 9, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 10, "arabic": "يَحْكُم", "translit": "mُkْḥَy", "root": "حكم"}, {"id": 11, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 12, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 15, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 16, "arabic": "ٱلْفَٰسِقُونَ", "translit": "َnwُqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 48, "text": "وَأَنزَلْنَآ إِلَيْكَ ٱلْكِتَٰبَ بِٱلْحَقِّ مُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ مِنَ ٱلْكِتَٰبِ وَمُهَيْمِنًا عَلَيْهِۖ فَٱحْكُم بَيْنَهُم بِمَآ أَنزَلَ ٱللَّهُۖ وَلَا تَتَّبِعْ أَهْوَآءَهُمْ عَمَّا جَآءَكَ مِنَ ٱلْحَقِّۚ لِكُلٍّ جَعَلْنَا مِنكُمْ شِرْعَةً وَمِنْهَاجًاۚ وَلَوْ شَآءَ ٱللَّهُ لَجَعَلَكُمْ أُمَّةً وَٰحِدَةً وَلَٰكِن لِّيَبْلُوَكُمْ فِى مَآ ءَاتَىٰكُمْۖ فَٱسْتَبِقُوا۟ ٱلْخَيْرَٰتِۚ إِلَى ٱللَّهِ مَرْجِعُكُمْ جَمِيعًا فَيُنَبِّئُكُم بِمَا كُنتُمْ فِيهِ تَخْتَلِفُونَ ", "translation": "And We have revealed to you, [O Muḥammad], the Book [i.e., the Qur’ān] in truth, confirming that which preceded it of the Scripture and as a criterion over it. So judge between them by what Allāh has revealed and do not follow their inclinations away from what has come to you of the truth. To each of you We prescribed a law and a method.[1] Had Allāh willed, He would have made you one nation [united in religion], but [He intended] to test you in what He has given you; so race to [all that is] good.[2] To Allāh is your return all together, and He will [then] inform you concerning that over which you used to differ.", "words": [{"id": 1, "arabic": "وَأَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾَw", "root": "نزل"}, {"id": 2, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 5, "arabic": "مُصَدِّقًا", "translit": "āًqِّdَṣُm", "root": "صدق"}, {"id": 6, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 7, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 8, "arabic": "يَدَيْهِ", "translit": "ِhْyَdَy", "root": "يدي"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 11, "arabic": "وَمُهَيْمِنًا", "translit": "āًnِmْyَhُmَw", "root": "همن"}, {"id": 12, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "فَٱحْكُم", "translit": "mُkْḥٱَf", "root": "حكم"}, {"id": 14, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 15, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 16, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "تَتَّبِعْ", "translit": "ْʿعِbَّtَt", "root": "تبع"}, {"id": 20, "arabic": "أَهْوَآءَهُمْ", "translit": "ْmُhَءٓāَwْhَaʾ", "root": "هوي"}, {"id": 21, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 22, "arabic": "جَآءَكَ", "translit": "َkَءٓāَjg", "root": "جيا"}, {"id": 23, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 24, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 25, "arabic": "لِكُلٍّ", "translit": "ٍّlُkِl", "root": "كلل"}, {"id": 26, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 27, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 28, "arabic": "شِرْعَةً", "translit": "ًẗَʿعْrِhs", "root": "شرع"}, {"id": 29, "arabic": "وَمِنْهَاجًا", "translit": "āًjgāَhْnِmَw", "root": "نهج"}, {"id": 30, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 31, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 32, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 33, "arabic": "لَجَعَلَكُمْ", "translit": "ْmُkَlَʿعَjgَl", "root": "جعل"}, {"id": 34, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 35, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 36, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 37, "arabic": "لِّيَبْلُوَكُمْ", "translit": "ْmُkَwُlْbَyِّl", "root": "بلو"}, {"id": 38, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 39, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 40, "arabic": "ءَاتَىٰكُمْ", "translit": "ْmُkٰàَtāَء", "root": "اتي"}, {"id": 41, "arabic": "فَٱسْتَبِقُوا۟", "translit": "۟āwُqِbَtْsٱَf", "root": "سبق"}, {"id": 42, "arabic": "ٱلْخَيْرَٰتِ", "translit": "ِtَٰrْyَhkْlٱ", "root": "خير"}, {"id": 43, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 44, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 45, "arabic": "مَرْجِعُكُمْ", "translit": "ْmُkُʿعِjgْrَm", "root": "رجع"}, {"id": 46, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 47, "arabic": "فَيُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُyَf", "root": "نبا"}, {"id": 48, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 49, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 50, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 51, "arabic": "تَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَt", "root": "خلف"}], "hasIhya": true}, {"ayah": 49, "text": "وَأَنِ ٱحْكُم بَيْنَهُم بِمَآ أَنزَلَ ٱللَّهُ وَلَا تَتَّبِعْ أَهْوَآءَهُمْ وَٱحْذَرْهُمْ أَن يَفْتِنُوكَ عَنۢ بَعْضِ مَآ أَنزَلَ ٱللَّهُ إِلَيْكَۖ فَإِن تَوَلَّوْا۟ فَٱعْلَمْ أَنَّمَا يُرِيدُ ٱللَّهُ أَن يُصِيبَهُم بِبَعْضِ ذُنُوبِهِمْۗ وَإِنَّ كَثِيرًا مِّنَ ٱلنَّاسِ لَفَٰسِقُونَ ", "translation": "And judge, [O Muḥammad], between them by what Allāh has revealed and do not follow their inclinations and beware of them, lest they tempt you away from some of what Allāh has revealed to you. And if they turn away - then know that Allāh only intends to afflict them with some of their [own] sins. And indeed, many among the people are defiantly disobedient.", "words": [{"id": 1, "arabic": "وَأَنِ", "translit": "ِnَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱحْكُم", "translit": "mُkْḥٱ", "root": "حكم"}, {"id": 3, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 4, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "تَتَّبِعْ", "translit": "ْʿعِbَّtَt", "root": "تبع"}, {"id": 9, "arabic": "أَهْوَآءَهُمْ", "translit": "ْmُhَءٓāَwْhَaʾ", "root": "هوي"}, {"id": 10, "arabic": "وَٱحْذَرْهُمْ", "translit": "ْmُhْrَhdْḥٱَw", "root": "حذر"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَفْتِنُوكَ", "translit": "َkwُnِtْfَy", "root": "فتن"}, {"id": 13, "arabic": "عَنۢ", "translit": "ۢnَʿع", "root": ""}, {"id": 14, "arabic": "بَعْضِ", "translit": "ِḍْʿعَb", "root": "بعض"}, {"id": 15, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 16, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 19, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 20, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 21, "arabic": "فَٱعْلَمْ", "translit": "ْmَlْʿعٱَf", "root": "علم"}, {"id": 22, "arabic": "أَنَّمَا", "translit": "āَmَّnَaʾ", "root": ""}, {"id": 23, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 24, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 26, "arabic": "يُصِيبَهُم", "translit": "mُhَbyِṣُy", "root": "صوب"}, {"id": 27, "arabic": "بِبَعْضِ", "translit": "ِḍْʿعَbِb", "root": "بعض"}, {"id": 28, "arabic": "ذُنُوبِهِمْ", "translit": "ْmِhِbwُnُhd", "root": "ذنب"}, {"id": 29, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 30, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 31, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 32, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 33, "arabic": "لَفَٰسِقُونَ", "translit": "َnwُqِsَٰfَl", "root": "فسق"}], "hasIhya": false}, {"ayah": 50, "text": "أَفَحُكْمَ ٱلْجَٰهِلِيَّةِ يَبْغُونَۚ وَمَنْ أَحْسَنُ مِنَ ٱللَّهِ حُكْمًا لِّقَوْمٍ يُوقِنُونَ ", "translation": "Then is it the judgement of [the time of] ignorance they desire? But who is better than Allāh in judgement for a people who are certain [in faith].", "words": [{"id": 1, "arabic": "أَفَحُكْمَ", "translit": "َmْkُḥَfَaʾ", "root": "حكم"}, {"id": 2, "arabic": "ٱلْجَٰهِلِيَّةِ", "translit": "ِẗَّyِlِhَٰjgْlٱ", "root": "جهل"}, {"id": 3, "arabic": "يَبْغُونَ", "translit": "َnwُغْbَy", "root": "بغي"}, {"id": 4, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 5, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "حُكْمًا", "translit": "āًmْkُḥ", "root": "حكم"}, {"id": 9, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 10, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 51, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوا۟ ٱلْيَهُودَ وَٱلنَّصَٰرَىٰٓ أَوْلِيَآءَۘ بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۚ وَمَن يَتَوَلَّهُم مِّنكُمْ فَإِنَّهُۥ مِنْهُمْۗ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّٰلِمِينَ ", "translation": "O you who have believed, do not take the Jews and the Christians as allies. They are [in fact] allies of one another. And whoever is an ally to them among you - then indeed, he is [one] of them. Indeed, Allāh guides not the wrongdoing people.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَتَّخِذُوا۟", "translit": "۟āwُhdِhkَّtَt", "root": "اخذ"}, {"id": 6, "arabic": "ٱلْيَهُودَ", "translit": "َdwُhَyْlٱ", "root": "هود"}, {"id": 7, "arabic": "وَٱلنَّصَٰرَىٰٓ", "translit": "ٰٓàَrَٰṣَّnlٱَw", "root": "نصر"}, {"id": 8, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 9, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 10, "arabic": "أَوْلِيَآءُ", "translit": "ُءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 11, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 12, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 13, "arabic": "يَتَوَلَّهُم", "translit": "mُhَّlَwَtَy", "root": "ولي"}, {"id": 14, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 15, "arabic": "فَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَf", "root": ""}, {"id": 16, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 17, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 18, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 21, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 22, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 52, "text": "فَتَرَى ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ يُسَٰرِعُونَ فِيهِمْ يَقُولُونَ نَخْشَىٰٓ أَن تُصِيبَنَا دَآئِرَةٌۚ فَعَسَى ٱللَّهُ أَن يَأْتِىَ بِٱلْفَتْحِ أَوْ أَمْرٍ مِّنْ عِندِهِۦ فَيُصْبِحُوا۟ عَلَىٰ مَآ أَسَرُّوا۟ فِىٓ أَنفُسِهِمْ نَٰدِمِينَ ", "translation": "So you see those in whose hearts is disease [i.e., hypocrisy] hastening into [association with] them, saying, \"We are afraid a misfortune may strike us.\" But perhaps Allāh will bring conquest or a decision from Him, and they will become, over what they have been concealing within themselves, regretful.", "words": [{"id": 1, "arabic": "فَتَرَى", "translit": "àَrَtَf", "root": "راي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "قُلُوبِهِم", "translit": "mِhِbwُlُq", "root": "قلب"}, {"id": 5, "arabic": "مَّرَضٌ", "translit": "ٌḍَrَّm", "root": "مرض"}, {"id": 6, "arabic": "يُسَٰرِعُونَ", "translit": "َnwُʿعِrَٰsُy", "root": "سرع"}, {"id": 7, "arabic": "فِيهِمْ", "translit": "ْmِhyِf", "root": ""}, {"id": 8, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 9, "arabic": "نَخْشَىٰٓ", "translit": "ٰٓàَhsْhkَn", "root": "خشي"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "تُصِيبَنَا", "translit": "āَnَbyِṣُt", "root": "صوب"}, {"id": 12, "arabic": "دَآئِرَةٌ", "translit": "ٌẗَrِyʾٓāَd", "root": "دور"}, {"id": 13, "arabic": "فَعَسَى", "translit": "àَsَʿعَf", "root": "عسي"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "يَأْتِىَ", "translit": "َàِtْaʾَy", "root": "اتي"}, {"id": 17, "arabic": "بِٱلْفَتْحِ", "translit": "ِḥْtَfْlٱِb", "root": "فتح"}, {"id": 18, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 19, "arabic": "أَمْرٍ", "translit": "ٍrْmَaʾ", "root": "امر"}, {"id": 20, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 21, "arabic": "عِندِهِۦ", "translit": "ۦِhِdnِʿع", "root": "عند"}, {"id": 22, "arabic": "فَيُصْبِحُوا۟", "translit": "۟āwُḥِbْṣُyَf", "root": "صبح"}, {"id": 23, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 24, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 25, "arabic": "أَسَرُّوا۟", "translit": "۟āwُّrَsَaʾ", "root": "سرر"}, {"id": 26, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 27, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 28, "arabic": "نَٰدِمِينَ", "translit": "َnyِmِdَٰn", "root": "ندم"}], "hasIhya": false}, {"ayah": 53, "text": "وَيَقُولُ ٱلَّذِينَ ءَامَنُوٓا۟ أَهَٰٓؤُلَآءِ ٱلَّذِينَ أَقْسَمُوا۟ بِٱللَّهِ جَهْدَ أَيْمَٰنِهِمْۙ إِنَّهُمْ لَمَعَكُمْۚ حَبِطَتْ أَعْمَٰلُهُمْ فَأَصْبَحُوا۟ خَٰسِرِينَ ", "translation": "And those who believe will say,[1] \"Are these the ones who swore by Allāh their strongest oaths that indeed they were with you?\" Their deeds have become worthless, and they have become losers.", "words": [{"id": 1, "arabic": "وَيَقُولُ", "translit": "ُlwُqَyَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "أَهَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓhَaʾ", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "أَقْسَمُوا۟", "translit": "۟āwُmَsْqَaʾ", "root": "قسم"}, {"id": 7, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 8, "arabic": "جَهْدَ", "translit": "َdْhَjg", "root": "جهد"}, {"id": 9, "arabic": "أَيْمَٰنِهِمْ", "translit": "ْmِhِnَٰmْyَaʾ", "root": "يمن"}, {"id": 10, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "لَمَعَكُمْ", "translit": "ْmُkَʿعَmَl", "root": ""}, {"id": 12, "arabic": "حَبِطَتْ", "translit": "ْtَṭِbَḥ", "root": "حبط"}, {"id": 13, "arabic": "أَعْمَٰلُهُمْ", "translit": "ْmُhُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 14, "arabic": "فَأَصْبَحُوا۟", "translit": "۟āwُḥَbْṣَaʾَf", "root": "صبح"}, {"id": 15, "arabic": "خَٰسِرِينَ", "translit": "َnyِrِsَٰhk", "root": "خسر"}], "hasIhya": false}, {"ayah": 54, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ مَن يَرْتَدَّ مِنكُمْ عَن دِينِهِۦ فَسَوْفَ يَأْتِى ٱللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُۥٓ أَذِلَّةٍ عَلَى ٱلْمُؤْمِنِينَ أَعِزَّةٍ عَلَى ٱلْكَٰفِرِينَ يُجَٰهِدُونَ فِى سَبِيلِ ٱللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَآئِمٍۚ ذَٰلِكَ فَضْلُ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ ", "translation": "O you who have believed, whoever of you should revert from his religion - Allāh will bring forth [in place of them] a people He will love and who will love Him [who are] humble toward the believers, strong against the disbelievers; they strive in the cause of Allāh and do not fear the blame of a critic. That is the favor of Allāh; He bestows it upon whom He wills. And Allāh is all-Encompassing and Knowing.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 5, "arabic": "يَرْتَدَّ", "translit": "َّdَtْrَy", "root": "ردد"}, {"id": 6, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 7, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 8, "arabic": "دِينِهِۦ", "translit": "ۦِhِnyِd", "root": "دين"}, {"id": 9, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 10, "arabic": "يَأْتِى", "translit": "àِtْaʾَy", "root": "اتي"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "بِقَوْمٍ", "translit": "ٍmْwَqِb", "root": "قوم"}, {"id": 13, "arabic": "يُحِبُّهُمْ", "translit": "ْmُhُّbِḥُy", "root": "حبب"}, {"id": 14, "arabic": "وَيُحِبُّونَهُۥٓ", "translit": "ٓۥُhَnwُّbِḥُyَw", "root": "حبب"}, {"id": 15, "arabic": "أَذِلَّةٍ", "translit": "ٍẗَّlِhdَaʾ", "root": "ذلل"}, {"id": 16, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 17, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 18, "arabic": "أَعِزَّةٍ", "translit": "ٍẗَّzِʿعَaʾ", "root": "عزز"}, {"id": 19, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 20, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 21, "arabic": "يُجَٰهِدُونَ", "translit": "َnwُdِhَٰjgُy", "root": "جهد"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 24, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 26, "arabic": "يَخَافُونَ", "translit": "َnwُfāَhkَy", "root": "خوف"}, {"id": 27, "arabic": "لَوْمَةَ", "translit": "َẗَmْwَl", "root": "لوم"}, {"id": 28, "arabic": "لَآئِمٍ", "translit": "ٍmِyʾٓāَl", "root": "لوم"}, {"id": 29, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 30, "arabic": "فَضْلُ", "translit": "ُlْḍَf", "root": "فضل"}, {"id": 31, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "يُؤْتِيهِ", "translit": "ِhyِtْwʾُy", "root": "اتي"}, {"id": 33, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 34, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 35, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 36, "arabic": "وَٰسِعٌ", "translit": "ٌʿعِsَٰw", "root": "وسع"}, {"id": 37, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 55, "text": "إِنَّمَا وَلِيُّكُمُ ٱللَّهُ وَرَسُولُهُۥ وَٱلَّذِينَ ءَامَنُوا۟ ٱلَّذِينَ يُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَهُمْ رَٰكِعُونَ ", "translation": "Your ally is none but Allāh and [therefore] His Messenger and those who have believed - those who establish prayer and give zakāh, and they bow [in worship].", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "وَلِيُّكُمُ", "translit": "ُmُkُّyِlَw", "root": "ولي"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 5, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 6, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "يُقِيمُونَ", "translit": "َnwُmyِqُy", "root": "قوم"}, {"id": 9, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 10, "arabic": "وَيُؤْتُونَ", "translit": "َnwُtْwʾُyَw", "root": "اتي"}, {"id": 11, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 12, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 13, "arabic": "رَٰكِعُونَ", "translit": "َnwُʿعِkَٰr", "root": "ركع"}], "hasIhya": false}, {"ayah": 56, "text": "وَمَن يَتَوَلَّ ٱللَّهَ وَرَسُولَهُۥ وَٱلَّذِينَ ءَامَنُوا۟ فَإِنَّ حِزْبَ ٱللَّهِ هُمُ ٱلْغَٰلِبُونَ ", "translation": "And whoever is an ally of Allāh and His Messenger and those who have believed - indeed, the party of Allāh - they will be the predominant.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَتَوَلَّ", "translit": "َّlَwَtَy", "root": "ولي"}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 5, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 6, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 7, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 8, "arabic": "حِزْبَ", "translit": "َbْzِḥ", "root": "حزب"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 11, "arabic": "ٱلْغَٰلِبُونَ", "translit": "َnwُbِlَٰغْlٱ", "root": "غلب"}], "hasIhya": false}, {"ayah": 57, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوا۟ ٱلَّذِينَ ٱتَّخَذُوا۟ دِينَكُمْ هُزُوًا وَلَعِبًا مِّنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ مِن قَبْلِكُمْ وَٱلْكُفَّارَ أَوْلِيَآءَۚ وَٱتَّقُوا۟ ٱللَّهَ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "O you who have believed, take not those who have taken your religion in ridicule and amusement among the ones who were given the Scripture before you nor the disbelievers as allies. And fear Allāh, if you should [truly] be believers.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَتَّخِذُوا۟", "translit": "۟āwُhdِhkَّtَt", "root": "اخذ"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 8, "arabic": "دِينَكُمْ", "translit": "ْmُkَnyِd", "root": "دين"}, {"id": 9, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 10, "arabic": "وَلَعِبًا", "translit": "āًbِʿعَlَw", "root": "لعب"}, {"id": 11, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 12, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 14, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 15, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 16, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 17, "arabic": "وَٱلْكُفَّارَ", "translit": "َrāَّfُkْlٱَw", "root": "كفر"}, {"id": 18, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 19, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 22, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 23, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": true}, {"ayah": 58, "text": "وَإِذَا نَادَيْتُمْ إِلَى ٱلصَّلَوٰةِ ٱتَّخَذُوهَا هُزُوًا وَلَعِبًاۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَعْقِلُونَ ", "translation": "And when you call to prayer, they take it in ridicule and amusement. That is because they are a people who do not use reason.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "نَادَيْتُمْ", "translit": "ْmُtْyَdāَn", "root": "ندي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 5, "arabic": "ٱتَّخَذُوهَا", "translit": "āَhwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 6, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 7, "arabic": "وَلَعِبًا", "translit": "āًbِʿعَlَw", "root": "لعب"}, {"id": 8, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 9, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 10, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 11, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 12, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 59, "text": "قُلْ يَٰٓأَهْلَ ٱلْكِتَٰبِ هَلْ تَنقِمُونَ مِنَّآ إِلَّآ أَنْ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ إِلَيْنَا وَمَآ أُنزِلَ مِن قَبْلُ وَأَنَّ أَكْثَرَكُمْ فَٰسِقُونَ ", "translation": "Say, \"O People of the Scripture, do you resent us except [for the fact] that we have believed in Allāh and what was revealed to us and what was revealed before and because most of you are defiantly disobedient?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَهْلَ", "translit": "َlْhَaʾَٰٓy", "root": "اهل"}, {"id": 3, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 5, "arabic": "تَنقِمُونَ", "translit": "َnwُmِqnَt", "root": "نقم"}, {"id": 6, "arabic": "مِنَّآ", "translit": "ٓāَّnِm", "root": ""}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 9, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 10, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 11, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 12, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 13, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 14, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 15, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 18, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 19, "arabic": "أَكْثَرَكُمْ", "translit": "ْmُkَrَhtْkَaʾ", "root": "كثر"}, {"id": 20, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 60, "text": "قُلْ هَلْ أُنَبِّئُكُم بِشَرٍّ مِّن ذَٰلِكَ مَثُوبَةً عِندَ ٱللَّهِۚ مَن لَّعَنَهُ ٱللَّهُ وَغَضِبَ عَلَيْهِ وَجَعَلَ مِنْهُمُ ٱلْقِرَدَةَ وَٱلْخَنَازِيرَ وَعَبَدَ ٱلطَّٰغُوتَۚ أُو۟لَٰٓئِكَ شَرٌّ مَّكَانًا وَأَضَلُّ عَن سَوَآءِ ٱلسَّبِيلِ ", "translation": "Say, \"Shall I inform you of [what is] worse than that[1] as penalty from Allāh? [It is that of] those whom Allāh has cursed and with whom He became angry and made of them apes and pigs and slaves of ṭāghūt.[2] Those are worse in position and further astray from the sound way.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 3, "arabic": "أُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُaʾ", "root": "نبا"}, {"id": 4, "arabic": "بِشَرٍّ", "translit": "ٍّrَhsِb", "root": "شرر"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 7, "arabic": "مَثُوبَةً", "translit": "ًẗَbwُhtَm", "root": "ثوب"}, {"id": 8, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 11, "arabic": "لَّعَنَهُ", "translit": "ُhَnَʿعَّl", "root": "لعن"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَغَضِبَ", "translit": "َbِḍَغَw", "root": "غضب"}, {"id": 14, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 16, "arabic": "مِنْهُمُ", "translit": "ُmُhْnِm", "root": ""}, {"id": 17, "arabic": "ٱلْقِرَدَةَ", "translit": "َẗَdَrِqْlٱ", "root": "قرد"}, {"id": 18, "arabic": "وَٱلْخَنَازِيرَ", "translit": "َryِzāَnَhkْlٱَw", "root": "خنزر"}, {"id": 19, "arabic": "وَعَبَدَ", "translit": "َdَbَʿعَw", "root": "عبد"}, {"id": 20, "arabic": "ٱلطَّٰغُوتَ", "translit": "َtwُغَّٰṭlٱ", "root": "طغي"}, {"id": 21, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 22, "arabic": "شَرٌّ", "translit": "ٌّrَhs", "root": "شرر"}, {"id": 23, "arabic": "مَّكَانًا", "translit": "āًnāَkَّm", "root": "كون"}, {"id": 24, "arabic": "وَأَضَلُّ", "translit": "ُّlَḍَaʾَw", "root": "ضلل"}, {"id": 25, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 26, "arabic": "سَوَآءِ", "translit": "ِءٓāَwَs", "root": "سوي"}, {"id": 27, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}], "hasIhya": false}, {"ayah": 61, "text": "وَإِذَا جَآءُوكُمْ قَالُوٓا۟ ءَامَنَّا وَقَد دَّخَلُوا۟ بِٱلْكُفْرِ وَهُمْ قَدْ خَرَجُوا۟ بِهِۦۚ وَٱللَّهُ أَعْلَمُ بِمَا كَانُوا۟ يَكْتُمُونَ ", "translation": "And when they come to you, they say, \"We believe.\" But they have entered with disbelief [in their hearts], and they have certainly left with it. And Allāh is most knowing of what they were concealing.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "جَآءُوكُمْ", "translit": "ْmُkwُءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 4, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 5, "arabic": "وَقَد", "translit": "dَqَw", "root": ""}, {"id": 6, "arabic": "دَّخَلُوا۟", "translit": "۟āwُlَhkَّd", "root": "دخل"}, {"id": 7, "arabic": "بِٱلْكُفْرِ", "translit": "ِrْfُkْlٱِb", "root": "كفر"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 10, "arabic": "خَرَجُوا۟", "translit": "۟āwُjgَrَhk", "root": "خرج"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 14, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 15, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 16, "arabic": "يَكْتُمُونَ", "translit": "َnwُmُtْkَy", "root": "كتم"}], "hasIhya": false}, {"ayah": 62, "text": "وَتَرَىٰ كَثِيرًا مِّنْهُمْ يُسَٰرِعُونَ فِى ٱلْإِثْمِ وَٱلْعُدْوَٰنِ وَأَكْلِهِمُ ٱلسُّحْتَۚ لَبِئْسَ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "And you see many of them hastening into sin and aggression and the devouring of [what is] unlawful. How wretched is what they have been doing.", "words": [{"id": 1, "arabic": "وَتَرَىٰ", "translit": "ٰàَrَtَw", "root": "راي"}, {"id": 2, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 3, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 4, "arabic": "يُسَٰرِعُونَ", "translit": "َnwُʿعِrَٰsُy", "root": "سرع"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْإِثْمِ", "translit": "ِmْhtِiʾْlٱ", "root": "اثم"}, {"id": 7, "arabic": "وَٱلْعُدْوَٰنِ", "translit": "ِnَٰwْdُʿعْlٱَw", "root": "عدو"}, {"id": 8, "arabic": "وَأَكْلِهِمُ", "translit": "ُmِhِlْkَaʾَw", "root": "اكل"}, {"id": 9, "arabic": "ٱلسُّحْتَ", "translit": "َtْḥُّslٱ", "root": "سحت"}, {"id": 10, "arabic": "لَبِئْسَ", "translit": "َsْyʾِbَl", "root": "باس"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 63, "text": "لَوْلَا يَنْهَىٰهُمُ ٱلرَّبَّٰنِيُّونَ وَٱلْأَحْبَارُ عَن قَوْلِهِمُ ٱلْإِثْمَ وَأَكْلِهِمُ ٱلسُّحْتَۚ لَبِئْسَ مَا كَانُوا۟ يَصْنَعُونَ ", "translation": "Why do the rabbis and religious scholars not forbid them from saying what is sinful and devouring what is unlawful? How wretched is what they have been practicing.", "words": [{"id": 1, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 2, "arabic": "يَنْهَىٰهُمُ", "translit": "ُmُhٰàَhْnَy", "root": "نهي"}, {"id": 3, "arabic": "ٱلرَّبَّٰنِيُّونَ", "translit": "َnwُّyِnَّٰbَّrlٱ", "root": "ربب"}, {"id": 4, "arabic": "وَٱلْأَحْبَارُ", "translit": "ُrāَbْḥَaʾْlٱَw", "root": "حبر"}, {"id": 5, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 6, "arabic": "قَوْلِهِمُ", "translit": "ُmِhِlْwَq", "root": "قول"}, {"id": 7, "arabic": "ٱلْإِثْمَ", "translit": "َmْhtِiʾْlٱ", "root": "اثم"}, {"id": 8, "arabic": "وَأَكْلِهِمُ", "translit": "ُmِhِlْkَaʾَw", "root": "اكل"}, {"id": 9, "arabic": "ٱلسُّحْتَ", "translit": "َtْḥُّslٱ", "root": "سحت"}, {"id": 10, "arabic": "لَبِئْسَ", "translit": "َsْyʾِbَl", "root": "باس"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يَصْنَعُونَ", "translit": "َnwُʿعَnْṣَy", "root": "صنع"}], "hasIhya": true}, {"ayah": 64, "text": "وَقَالَتِ ٱلْيَهُودُ يَدُ ٱللَّهِ مَغْلُولَةٌۚ غُلَّتْ أَيْدِيهِمْ وَلُعِنُوا۟ بِمَا قَالُواۘ بَلْ يَدَاهُ مَبْسُوطَتَانِ يُنفِقُ كَيْفَ يَشَآءُۚ وَلَيَزِيدَنَّ كَثِيرًا مِّنْهُم مَّآ أُنزِلَ إِلَيْكَ مِن رَّبِّكَ طُغْيَٰنًا وَكُفْرًاۚ وَأَلْقَيْنَا بَيْنَهُمُ ٱلْعَدَٰوَةَ وَٱلْبَغْضَآءَ إِلَىٰ يَوْمِ ٱلْقِيَٰمَةِۚ كُلَّمَآ أَوْقَدُوا۟ نَارًا لِّلْحَرْبِ أَطْفَأَهَا ٱللَّهُۚ وَيَسْعَوْنَ فِى ٱلْأَرْضِ فَسَادًاۚ وَٱللَّهُ لَا يُحِبُّ ٱلْمُفْسِدِينَ ", "translation": "And the Jews say, \"The hand of Allāh is chained.\"[1] Chained are their hands, and cursed are they for what they say. Rather, both His hands are extended; He spends however He wills. And that which has been revealed to you from your Lord will surely increase many of them in transgression and disbelief. And We have cast among them animosity and hatred until the Day of Resurrection. Every time they kindled the fire of war [against you], Allāh extinguished it. And they strive throughout the land [causing] corruption, and Allāh does not like corrupters.", "words": [{"id": 1, "arabic": "وَقَالَتِ", "translit": "ِtَlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْيَهُودُ", "translit": "ُdwُhَyْlٱ", "root": "هود"}, {"id": 3, "arabic": "يَدُ", "translit": "ُdَy", "root": "يدي"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَغْلُولَةٌ", "translit": "ٌẗَlwُlْغَm", "root": "غلل"}, {"id": 6, "arabic": "غُلَّتْ", "translit": "ْtَّlُغ", "root": "غلل"}, {"id": 7, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 8, "arabic": "وَلُعِنُوا۟", "translit": "۟āwُnِʿعُlَw", "root": "لعن"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 11, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 12, "arabic": "يَدَاهُ", "translit": "ُhāَdَy", "root": "يدي"}, {"id": 13, "arabic": "مَبْسُوطَتَانِ", "translit": "ِnāَtَṭwُsْbَm", "root": "بسط"}, {"id": 14, "arabic": "يُنفِقُ", "translit": "ُqِfnُy", "root": "نفق"}, {"id": 15, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 16, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 17, "arabic": "وَلَيَزِيدَنَّ", "translit": "َّnَdyِzَyَlَw", "root": "زيد"}, {"id": 18, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 19, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 20, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 21, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 22, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 23, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 24, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 25, "arabic": "طُغْيَٰنًا", "translit": "āًnَٰyْغُṭ", "root": "طغي"}, {"id": 26, "arabic": "وَكُفْرًا", "translit": "āًrْfُkَw", "root": "كفر"}, {"id": 27, "arabic": "وَأَلْقَيْنَا", "translit": "āَnْyَqْlَaʾَw", "root": "لقي"}, {"id": 28, "arabic": "بَيْنَهُمُ", "translit": "ُmُhَnْyَb", "root": "بين"}, {"id": 29, "arabic": "ٱلْعَدَٰوَةَ", "translit": "َẗَwَٰdَʿعْlٱ", "root": "عدو"}, {"id": 30, "arabic": "وَٱلْبَغْضَآءَ", "translit": "َءٓāَḍْغَbْlٱَw", "root": "بغض"}, {"id": 31, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 32, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 33, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 34, "arabic": "كُلَّمَآ", "translit": "ٓāَmَّlُk", "root": "كلل"}, {"id": 35, "arabic": "أَوْقَدُوا۟", "translit": "۟āwُdَqْwَaʾ", "root": "وقد"}, {"id": 36, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 37, "arabic": "لِّلْحَرْبِ", "translit": "ِbْrَḥْlِّl", "root": "حرب"}, {"id": 38, "arabic": "أَطْفَأَهَا", "translit": "āَhَaʾَfْṭَaʾ", "root": "طفا"}, {"id": 39, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 40, "arabic": "وَيَسْعَوْنَ", "translit": "َnْwَʿعْsَyَw", "root": "سعي"}, {"id": 41, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 42, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 43, "arabic": "فَسَادًا", "translit": "āًdāَsَf", "root": "فسد"}, {"id": 44, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 45, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 46, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 47, "arabic": "ٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱ", "root": "فسد"}], "hasIhya": true}, {"ayah": 65, "text": "وَلَوْ أَنَّ أَهْلَ ٱلْكِتَٰبِ ءَامَنُوا۟ وَٱتَّقَوْا۟ لَكَفَّرْنَا عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَأَدْخَلْنَٰهُمْ جَنَّٰتِ ٱلنَّعِيمِ ", "translation": "And if only the People of the Scripture had believed and feared Allāh, We would have removed from them their misdeeds and admitted them to Gardens of Pleasure.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 3, "arabic": "أَهْلَ", "translit": "َlْhَaʾ", "root": "اهل"}, {"id": 4, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "وَٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱَw", "root": "وقي"}, {"id": 7, "arabic": "لَكَفَّرْنَا", "translit": "āَnْrَّfَkَl", "root": "كفر"}, {"id": 8, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 9, "arabic": "سَيِّـَٔاتِهِمْ", "translit": "ْmِhِtāَٔـِّyَs", "root": "سوا"}, {"id": 10, "arabic": "وَلَأَدْخَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَhkْdَaʾَlَw", "root": "دخل"}, {"id": 11, "arabic": "جَنَّٰتِ", "translit": "ِtَّٰnَjg", "root": "جنن"}, {"id": 12, "arabic": "ٱلنَّعِيمِ", "translit": "ِmyِʿعَّnlٱ", "root": "نعم"}], "hasIhya": false}, {"ayah": 66, "text": "وَلَوْ أَنَّهُمْ أَقَامُوا۟ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ وَمَآ أُنزِلَ إِلَيْهِم مِّن رَّبِّهِمْ لَأَكَلُوا۟ مِن فَوْقِهِمْ وَمِن تَحْتِ أَرْجُلِهِمۚ مِّنْهُمْ أُمَّةٌ مُّقْتَصِدَةٌۖ وَكَثِيرٌ مِّنْهُمْ سَآءَ مَا يَعْمَلُونَ ", "translation": "And if only they had upheld [the law of] the Torah, the Gospel, and what has been revealed to them from their Lord [i.e., the Qur’ān], they would have consumed [provision] from above them and from beneath their feet.[1] Among them are a moderate [i.e., acceptable] community, but many of them - evil is that which they do.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 3, "arabic": "أَقَامُوا۟", "translit": "۟āwُmāَqَaʾ", "root": "قوم"}, {"id": 4, "arabic": "ٱلتَّوْرَىٰةَ", "translit": "َẗٰàَrْwَّtlٱ", "root": ""}, {"id": 5, "arabic": "وَٱلْإِنجِيلَ", "translit": "َlyِjgnِiʾْlٱَw", "root": ""}, {"id": 6, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 7, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 8, "arabic": "إِلَيْهِم", "translit": "mِhْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 11, "arabic": "لَأَكَلُوا۟", "translit": "۟āwُlَkَaʾَl", "root": "اكل"}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "فَوْقِهِمْ", "translit": "ْmِhِqْwَf", "root": "فوق"}, {"id": 14, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 15, "arabic": "تَحْتِ", "translit": "ِtْḥَt", "root": "تحت"}, {"id": 16, "arabic": "أَرْجُلِهِم", "translit": "mِhِlُjgْrَaʾ", "root": "رجل"}, {"id": 17, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 18, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 19, "arabic": "مُّقْتَصِدَةٌ", "translit": "ٌẗَdِṣَtْqُّm", "root": "قصد"}, {"id": 20, "arabic": "وَكَثِيرٌ", "translit": "ٌryِhtَkَw", "root": "كثر"}, {"id": 21, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 22, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 23, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 24, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 67, "text": "يَٰٓأَيُّهَا ٱلرَّسُولُ بَلِّغْ مَآ أُنزِلَ إِلَيْكَ مِن رَّبِّكَۖ وَإِن لَّمْ تَفْعَلْ فَمَا بَلَّغْتَ رِسَالَتَهُۥۚ وَٱللَّهُ يَعْصِمُكَ مِنَ ٱلنَّاسِۗ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلْكَٰفِرِينَ ", "translation": "O Messenger, announce that which has been revealed to you from your Lord, and if you do not, then you have not conveyed His message. And Allāh will protect you from the people. Indeed, Allāh does not guide the disbelieving people.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 3, "arabic": "بَلِّغْ", "translit": "ْغِّlَb", "root": "بلغ"}, {"id": 4, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 5, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 6, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 9, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 10, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 11, "arabic": "تَفْعَلْ", "translit": "ْlَʿعْfَt", "root": "فعل"}, {"id": 12, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 13, "arabic": "بَلَّغْتَ", "translit": "َtْغَّlَb", "root": "بلغ"}, {"id": 14, "arabic": "رِسَالَتَهُۥ", "translit": "ۥُhَtَlāَsِr", "root": "رسل"}, {"id": 15, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 16, "arabic": "يَعْصِمُكَ", "translit": "َkُmِṣْʿعَy", "root": "عصم"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 19, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 23, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 24, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 68, "text": "قُلْ يَٰٓأَهْلَ ٱلْكِتَٰبِ لَسْتُمْ عَلَىٰ شَىْءٍ حَتَّىٰ تُقِيمُوا۟ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ وَمَآ أُنزِلَ إِلَيْكُم مِّن رَّبِّكُمْۗ وَلَيَزِيدَنَّ كَثِيرًا مِّنْهُم مَّآ أُنزِلَ إِلَيْكَ مِن رَّبِّكَ طُغْيَٰنًا وَكُفْرًاۖ فَلَا تَأْسَ عَلَى ٱلْقَوْمِ ٱلْكَٰفِرِينَ ", "translation": "Say, \"O People of the Scripture, you are [standing] on nothing until you uphold [the law of] the Torah, the Gospel, and what has been revealed to you from your Lord [i.e., the Qur’ān].\" And that which has been revealed to you from your Lord will surely increase many of them in transgression and disbelief. So do not grieve over the disbelieving people.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَهْلَ", "translit": "َlْhَaʾَٰٓy", "root": "اهل"}, {"id": 3, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "لَسْتُمْ", "translit": "ْmُtْsَl", "root": "ليس"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 7, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 8, "arabic": "تُقِيمُوا۟", "translit": "۟āwُmyِqُt", "root": "قوم"}, {"id": 9, "arabic": "ٱلتَّوْرَىٰةَ", "translit": "َẗٰàَrْwَّtlٱ", "root": ""}, {"id": 10, "arabic": "وَٱلْإِنجِيلَ", "translit": "َlyِjgnِiʾْlٱَw", "root": ""}, {"id": 11, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 12, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 13, "arabic": "إِلَيْكُم", "translit": "mُkْyَlِiʾ", "root": ""}, {"id": 14, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 15, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 16, "arabic": "وَلَيَزِيدَنَّ", "translit": "َّnَdyِzَyَlَw", "root": "زيد"}, {"id": 17, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 18, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 19, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 20, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 21, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 22, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 23, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 24, "arabic": "طُغْيَٰنًا", "translit": "āًnَٰyْغُṭ", "root": "طغي"}, {"id": 25, "arabic": "وَكُفْرًا", "translit": "āًrْfُkَw", "root": "كفر"}, {"id": 26, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 27, "arabic": "تَأْسَ", "translit": "َsْaʾَt", "root": "اسو"}, {"id": 28, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 29, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 30, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 69, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ هَادُوا۟ وَٱلصَّٰبِـُٔونَ وَٱلنَّصَٰرَىٰ مَنْ ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَعَمِلَ صَٰلِحًا فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "Indeed, those who have believed [in Prophet Muḥammad (ﷺ)] and those [before him (ﷺ)] who were Jews or Sabeans or Christians - those [among them] who believed in Allāh and the Last Day and did righteousness - no fear will there be concerning them, nor will they grieve.[1]", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 6, "arabic": "وَٱلصَّٰبِـُٔونَ", "translit": "َnwُٔـِbَّٰṣlٱَw", "root": "صبا"}, {"id": 7, "arabic": "وَٱلنَّصَٰرَىٰ", "translit": "ٰàَrَٰṣَّnlٱَw", "root": "نصر"}, {"id": 8, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 9, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 10, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 11, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 12, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 13, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 14, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 15, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 16, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 17, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 20, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": true}, {"ayah": 70, "text": "لَقَدْ أَخَذْنَا مِيثَٰقَ بَنِىٓ إِسْرَٰٓءِيلَ وَأَرْسَلْنَآ إِلَيْهِمْ رُسُلًاۖ كُلَّمَا جَآءَهُمْ رَسُولٌۢ بِمَا لَا تَهْوَىٰٓ أَنفُسُهُمْ فَرِيقًا كَذَّبُوا۟ وَفَرِيقًا يَقْتُلُونَ ", "translation": "We had already taken the covenant of the Children of Israel and had sent to them messengers. Whenever there came to them a messenger with what their souls did not desire, a party [of messengers] they denied, and another party they killed.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "أَخَذْنَا", "translit": "āَnْhdَhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "مِيثَٰقَ", "translit": "َqَٰhtyِm", "root": "وثق"}, {"id": 4, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 5, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 6, "arabic": "وَأَرْسَلْنَآ", "translit": "ٓāَnْlَsْrَaʾَw", "root": "رسل"}, {"id": 7, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "رُسُلًا", "translit": "āًlُsُr", "root": "رسل"}, {"id": 9, "arabic": "كُلَّمَا", "translit": "āَmَّlُk", "root": "كلل"}, {"id": 10, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 11, "arabic": "رَسُولٌۢ", "translit": "ٌۢlwُsَr", "root": "رسل"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "تَهْوَىٰٓ", "translit": "ٰٓàَwْhَt", "root": "هوي"}, {"id": 15, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 16, "arabic": "فَرِيقًا", "translit": "āًqyِrَf", "root": "فرق"}, {"id": 17, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 18, "arabic": "وَفَرِيقًا", "translit": "āًqyِrَfَw", "root": "فرق"}, {"id": 19, "arabic": "يَقْتُلُونَ", "translit": "َnwُlُtْqَy", "root": "قتل"}], "hasIhya": false}, {"ayah": 71, "text": "وَحَسِبُوٓا۟ أَلَّا تَكُونَ فِتْنَةٌ فَعَمُوا۟ وَصَمُّوا۟ ثُمَّ تَابَ ٱللَّهُ عَلَيْهِمْ ثُمَّ عَمُوا۟ وَصَمُّوا۟ كَثِيرٌ مِّنْهُمْۚ وَٱللَّهُ بَصِيرٌۢ بِمَا يَعْمَلُونَ ", "translation": "And they thought there would be no [resulting] punishment, so they became blind and deaf. Then Allāh turned to them in forgiveness; then [again] many of them became blind and deaf. And Allāh is Seeing of what they do.", "words": [{"id": 1, "arabic": "وَحَسِبُوٓا۟", "translit": "۟āٓwُbِsَḥَw", "root": "حسب"}, {"id": 2, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 3, "arabic": "تَكُونَ", "translit": "َnwُkَt", "root": "كون"}, {"id": 4, "arabic": "فِتْنَةٌ", "translit": "ٌẗَnْtِf", "root": "فتن"}, {"id": 5, "arabic": "فَعَمُوا۟", "translit": "۟āwُmَʿعَf", "root": "عمي"}, {"id": 6, "arabic": "وَصَمُّوا۟", "translit": "۟āwُّmَṣَw", "root": "صمم"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "عَمُوا۟", "translit": "۟āwُmَʿع", "root": "عمي"}, {"id": 13, "arabic": "وَصَمُّوا۟", "translit": "۟āwُّmَṣَw", "root": "صمم"}, {"id": 14, "arabic": "كَثِيرٌ", "translit": "ٌryِhtَk", "root": "كثر"}, {"id": 15, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 16, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 17, "arabic": "بَصِيرٌۢ", "translit": "ٌۢryِṣَb", "root": "بصر"}, {"id": 18, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 19, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 72, "text": "لَقَدْ كَفَرَ ٱلَّذِينَ قَالُوٓا۟ إِنَّ ٱللَّهَ هُوَ ٱلْمَسِيحُ ٱبْنُ مَرْيَمَۖ وَقَالَ ٱلْمَسِيحُ يَٰبَنِىٓ إِسْرَٰٓءِيلَ ٱعْبُدُوا۟ ٱللَّهَ رَبِّى وَرَبَّكُمْۖ إِنَّهُۥ مَن يُشْرِكْ بِٱللَّهِ فَقَدْ حَرَّمَ ٱللَّهُ عَلَيْهِ ٱلْجَنَّةَ وَمَأْوَىٰهُ ٱلنَّارُۖ وَمَا لِلظَّٰلِمِينَ مِنْ أَنصَارٍ ", "translation": "They have certainly disbelieved who say, \"Allāh is the Messiah, the son of Mary\" while the Messiah has said, \"O Children of Israel, worship Allāh, my Lord and your Lord.\" Indeed, he who associates others with Allāh - Allāh has forbidden him Paradise, and his refuge is the Fire. And there are not for the wrongdoers any helpers.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "ٱلْمَسِيحُ", "translit": "ُḥyِsَmْlٱ", "root": "مسح"}, {"id": 9, "arabic": "ٱبْنُ", "translit": "ُnْbٱ", "root": "بني"}, {"id": 10, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 11, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 12, "arabic": "ٱلْمَسِيحُ", "translit": "ُḥyِsَmْlٱ", "root": "مسح"}, {"id": 13, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 14, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 15, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 18, "arabic": "وَرَبَّكُمْ", "translit": "ْmُkَّbَrَw", "root": "ربب"}, {"id": 19, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 20, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 21, "arabic": "يُشْرِكْ", "translit": "ْkِrْhsُy", "root": "شرك"}, {"id": 22, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 23, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 24, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 25, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 27, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 28, "arabic": "وَمَأْوَىٰهُ", "translit": "ُhٰàَwْaʾَmَw", "root": "اوي"}, {"id": 29, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 30, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 31, "arabic": "لِلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlِl", "root": "ظلم"}, {"id": 32, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 33, "arabic": "أَنصَارٍ", "translit": "ٍrāَṣnَaʾ", "root": "نصر"}], "hasIhya": true}, {"ayah": 73, "text": "لَّقَدْ كَفَرَ ٱلَّذِينَ قَالُوٓا۟ إِنَّ ٱللَّهَ ثَالِثُ ثَلَٰثَةٍۘ وَمَا مِنْ إِلَٰهٍ إِلَّآ إِلَٰهٌ وَٰحِدٌۚ وَإِن لَّمْ يَنتَهُوا۟ عَمَّا يَقُولُونَ لَيَمَسَّنَّ ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ عَذَابٌ أَلِيمٌ ", "translation": "They have certainly disbelieved who say, \"Allāh is the third of three.\"[1] And there is no god except one God. And if they do not desist from what they are saying, there will surely afflict the disbelievers among them a painful punishment.", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": ""}, {"id": 2, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ثَالِثُ", "translit": "ُhtِlāَht", "root": "ثلث"}, {"id": 8, "arabic": "ثَلَٰثَةٍ", "translit": "ٍẗَhtَٰlَht", "root": "ثلث"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 11, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 12, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 13, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 14, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 15, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 16, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 17, "arabic": "يَنتَهُوا۟", "translit": "۟āwُhَtnَy", "root": "نهي"}, {"id": 18, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 19, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 20, "arabic": "لَيَمَسَّنَّ", "translit": "َّnَّsَmَyَl", "root": "مسس"}, {"id": 21, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 22, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 23, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 24, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 25, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 74, "text": "أَفَلَا يَتُوبُونَ إِلَى ٱللَّهِ وَيَسْتَغْفِرُونَهُۥۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "So will they not repent to Allāh and seek His forgiveness? And Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 2, "arabic": "يَتُوبُونَ", "translit": "َnwُbwُtَy", "root": "توب"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَيَسْتَغْفِرُونَهُۥ", "translit": "ۥُhَnwُrِfْغَtْsَyَw", "root": "غفر"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 8, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 75, "text": "مَّا ٱلْمَسِيحُ ٱبْنُ مَرْيَمَ إِلَّا رَسُولٌ قَدْ خَلَتْ مِن قَبْلِهِ ٱلرُّسُلُ وَأُمُّهُۥ صِدِّيقَةٌۖ كَانَا يَأْكُلَانِ ٱلطَّعَامَۗ ٱنظُرْ كَيْفَ نُبَيِّنُ لَهُمُ ٱلْءَايَٰتِ ثُمَّ ٱنظُرْ أَنَّىٰ يُؤْفَكُونَ ", "translation": "The Messiah, son of Mary, was not but a messenger; [other] messengers have passed on before him. And his mother was a supporter of truth. They both used to eat food.[1] Look how We make clear to them the signs; then look how they are deluded.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "ٱلْمَسِيحُ", "translit": "ُḥyِsَmْlٱ", "root": "مسح"}, {"id": 3, "arabic": "ٱبْنُ", "translit": "ُnْbٱ", "root": "بني"}, {"id": 4, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 7, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 8, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "قَبْلِهِ", "translit": "ِhِlْbَq", "root": "قبل"}, {"id": 11, "arabic": "ٱلرُّسُلُ", "translit": "ُlُsُّrlٱ", "root": "رسل"}, {"id": 12, "arabic": "وَأُمُّهُۥ", "translit": "ۥُhُّmُaʾَw", "root": "امم"}, {"id": 13, "arabic": "صِدِّيقَةٌ", "translit": "ٌẗَqyِّdِṣ", "root": "صدق"}, {"id": 14, "arabic": "كَانَا", "translit": "āَnāَk", "root": "كون"}, {"id": 15, "arabic": "يَأْكُلَانِ", "translit": "ِnāَlُkْaʾَy", "root": "اكل"}, {"id": 16, "arabic": "ٱلطَّعَامَ", "translit": "َmāَʿعَّṭlٱ", "root": "طعم"}, {"id": 17, "arabic": "ٱنظُرْ", "translit": "ْrُẓnٱ", "root": "نظر"}, {"id": 18, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 19, "arabic": "نُبَيِّنُ", "translit": "ُnِّyَbُn", "root": "بين"}, {"id": 20, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 21, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 22, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 23, "arabic": "ٱنظُرْ", "translit": "ْrُẓnٱ", "root": "نظر"}, {"id": 24, "arabic": "أَنَّىٰ", "translit": "ٰàَّnَaʾ", "root": ""}, {"id": 25, "arabic": "يُؤْفَكُونَ", "translit": "َnwُkَfْwʾُy", "root": "افك"}], "hasIhya": false}, {"ayah": 76, "text": "قُلْ أَتَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَمْلِكُ لَكُمْ ضَرًّا وَلَا نَفْعًاۚ وَٱللَّهُ هُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ", "translation": "Say, \"Do you worship besides Allāh that which holds for you no [power of] harm or benefit while it is Allāh who is the Hearing, the Knowing?\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَتَعْبُدُونَ", "translit": "َnwُdُbْʿعَtَaʾ", "root": "عبد"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَمْلِكُ", "translit": "ُkِlْmَy", "root": "ملك"}, {"id": 9, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 10, "arabic": "ضَرًّا", "translit": "āًّrَḍ", "root": "ضرر"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "نَفْعًا", "translit": "āًʿعْfَn", "root": "نفع"}, {"id": 13, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 16, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 77, "text": "قُلْ يَٰٓأَهْلَ ٱلْكِتَٰبِ لَا تَغْلُوا۟ فِى دِينِكُمْ غَيْرَ ٱلْحَقِّ وَلَا تَتَّبِعُوٓا۟ أَهْوَآءَ قَوْمٍ قَدْ ضَلُّوا۟ مِن قَبْلُ وَأَضَلُّوا۟ كَثِيرًا وَضَلُّوا۟ عَن سَوَآءِ ٱلسَّبِيلِ ", "translation": "Say, \"O People of the Scripture, do not exceed limits in your religion beyond the truth and do not follow the inclinations of a people who had gone astray before and misled many and have strayed from the soundness of the way.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَهْلَ", "translit": "َlْhَaʾَٰٓy", "root": "اهل"}, {"id": 3, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَغْلُوا۟", "translit": "۟āwُlْغَt", "root": "غلو"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "دِينِكُمْ", "translit": "ْmُkِnyِd", "root": "دين"}, {"id": 8, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 9, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تَتَّبِعُوٓا۟", "translit": "۟āٓwُʿعِbَّtَt", "root": "تبع"}, {"id": 12, "arabic": "أَهْوَآءَ", "translit": "َءٓāَwْhَaʾ", "root": "هوي"}, {"id": 13, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 14, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 15, "arabic": "ضَلُّوا۟", "translit": "۟āwُّlَḍ", "root": "ضلل"}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 18, "arabic": "وَأَضَلُّوا۟", "translit": "۟āwُّlَḍَaʾَw", "root": "ضلل"}, {"id": 19, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 20, "arabic": "وَضَلُّوا۟", "translit": "۟āwُّlَḍَw", "root": "ضلل"}, {"id": 21, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 22, "arabic": "سَوَآءِ", "translit": "ِءٓāَwَs", "root": "سوي"}, {"id": 23, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}], "hasIhya": false}, {"ayah": 78, "text": "لُعِنَ ٱلَّذِينَ كَفَرُوا۟ مِنۢ بَنِىٓ إِسْرَٰٓءِيلَ عَلَىٰ لِسَانِ دَاوُۥدَ وَعِيسَى ٱبْنِ مَرْيَمَۚ ذَٰلِكَ بِمَا عَصَوا۟ وَّكَانُوا۟ يَعْتَدُونَ ", "translation": "Cursed were those who disbelieved among the Children of Israel by the tongue of David and of Jesus, the son of Mary. That was because they disobeyed and [habitually] transgressed.", "words": [{"id": 1, "arabic": "لُعِنَ", "translit": "َnِʿعُl", "root": "لعن"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 6, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "لِسَانِ", "translit": "ِnāَsِl", "root": "لسن"}, {"id": 9, "arabic": "دَاوُۥدَ", "translit": "َdۥُwāَd", "root": ""}, {"id": 10, "arabic": "وَعِيسَى", "translit": "àَsyِʿعَw", "root": ""}, {"id": 11, "arabic": "ٱبْنِ", "translit": "ِnْbٱ", "root": "بني"}, {"id": 12, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 13, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 14, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 15, "arabic": "عَصَوا۟", "translit": "۟āwَṣَʿع", "root": "عصي"}, {"id": 16, "arabic": "وَّكَانُوا۟", "translit": "۟āwُnāَkَّw", "root": "كون"}, {"id": 17, "arabic": "يَعْتَدُونَ", "translit": "َnwُdَtْʿعَy", "root": "عدو"}], "hasIhya": true}, {"ayah": 79, "text": "كَانُوا۟ لَا يَتَنَاهَوْنَ عَن مُّنكَرٍ فَعَلُوهُۚ لَبِئْسَ مَا كَانُوا۟ يَفْعَلُونَ ", "translation": "They used not to prevent one another from wrongdoing that they did. How wretched was that which they were doing.", "words": [{"id": 1, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يَتَنَاهَوْنَ", "translit": "َnْwَhāَnَtَy", "root": "نهي"}, {"id": 4, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 5, "arabic": "مُّنكَرٍ", "translit": "ٍrَknُّm", "root": "نكر"}, {"id": 6, "arabic": "فَعَلُوهُ", "translit": "ُhwُlَʿعَf", "root": "فعل"}, {"id": 7, "arabic": "لَبِئْسَ", "translit": "َsْyʾِbَl", "root": "باس"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}, {"ayah": 80, "text": "تَرَىٰ كَثِيرًا مِّنْهُمْ يَتَوَلَّوْنَ ٱلَّذِينَ كَفَرُوا۟ۚ لَبِئْسَ مَا قَدَّمَتْ لَهُمْ أَنفُسُهُمْ أَن سَخِطَ ٱللَّهُ عَلَيْهِمْ وَفِى ٱلْعَذَابِ هُمْ خَٰلِدُونَ ", "translation": "You see many of them becoming allies of those who disbelieved [i.e., the polytheists]. How wretched is that which they have put forth for themselves in that Allāh has become angry with them, and in the punishment they will abide eternally.", "words": [{"id": 1, "arabic": "تَرَىٰ", "translit": "ٰàَrَt", "root": "راي"}, {"id": 2, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 3, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 4, "arabic": "يَتَوَلَّوْنَ", "translit": "َnْwَّlَwَtَy", "root": "ولي"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 7, "arabic": "لَبِئْسَ", "translit": "َsْyʾِbَl", "root": "باس"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "قَدَّمَتْ", "translit": "ْtَmَّdَq", "root": "قدم"}, {"id": 10, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 11, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 12, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 13, "arabic": "سَخِطَ", "translit": "َṭِhkَs", "root": "سخط"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 16, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 17, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 18, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 19, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 81, "text": "وَلَوْ كَانُوا۟ يُؤْمِنُونَ بِٱللَّهِ وَٱلنَّبِىِّ وَمَآ أُنزِلَ إِلَيْهِ مَا ٱتَّخَذُوهُمْ أَوْلِيَآءَ وَلَٰكِنَّ كَثِيرًا مِّنْهُمْ فَٰسِقُونَ ", "translation": "And if they had believed in Allāh and the Prophet and in what was revealed to him, they would not have taken them as allies; but many of them are defiantly disobedient.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 3, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 4, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 5, "arabic": "وَٱلنَّبِىِّ", "translit": "ِّàِbَّnlٱَw", "root": "نبا"}, {"id": 6, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 7, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 8, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "ٱتَّخَذُوهُمْ", "translit": "ْmُhwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 11, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 12, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 13, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 14, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 15, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 82, "text": "لَتَجِدَنَّ أَشَدَّ ٱلنَّاسِ عَدَٰوَةً لِّلَّذِينَ ءَامَنُوا۟ ٱلْيَهُودَ وَٱلَّذِينَ أَشْرَكُوا۟ۖ وَلَتَجِدَنَّ أَقْرَبَهُم مَّوَدَّةً لِّلَّذِينَ ءَامَنُوا۟ ٱلَّذِينَ قَالُوٓا۟ إِنَّا نَصَٰرَىٰۚ ذَٰلِكَ بِأَنَّ مِنْهُمْ قِسِّيسِينَ وَرُهْبَانًا وَأَنَّهُمْ لَا يَسْتَكْبِرُونَ ", "translation": "You will surely find the most intense of the people in animosity toward the believers [to be] the Jews and those who associate others with Allāh; and you will find the nearest of them in affection to the believers those who say, \"We are Christians.\" That is because among them are priests and monks and because they are not arrogant.", "words": [{"id": 1, "arabic": "لَتَجِدَنَّ", "translit": "َّnَdِjgَtَl", "root": "وجد"}, {"id": 2, "arabic": "أَشَدَّ", "translit": "َّdَhsَaʾ", "root": "شدد"}, {"id": 3, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "عَدَٰوَةً", "translit": "ًẗَwَٰdَʿع", "root": "عدو"}, {"id": 5, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 6, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 7, "arabic": "ٱلْيَهُودَ", "translit": "َdwُhَyْlٱ", "root": "هود"}, {"id": 8, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 9, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 10, "arabic": "وَلَتَجِدَنَّ", "translit": "َّnَdِjgَtَlَw", "root": "وجد"}, {"id": 11, "arabic": "أَقْرَبَهُم", "translit": "mُhَbَrْqَaʾ", "root": "قرب"}, {"id": 12, "arabic": "مَّوَدَّةً", "translit": "ًẗَّdَwَّm", "root": "ودد"}, {"id": 13, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 14, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 15, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 17, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 18, "arabic": "نَصَٰرَىٰ", "translit": "ٰàَrَٰṣَn", "root": "نصر"}, {"id": 19, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 20, "arabic": "بِأَنَّ", "translit": "َّnَaʾِb", "root": ""}, {"id": 21, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 22, "arabic": "قِسِّيسِينَ", "translit": "َnyِsyِّsِq", "root": "قسس"}, {"id": 23, "arabic": "وَرُهْبَانًا", "translit": "āًnāَbْhُrَw", "root": "رهب"}, {"id": 24, "arabic": "وَأَنَّهُمْ", "translit": "ْmُhَّnَaʾَw", "root": ""}, {"id": 25, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 26, "arabic": "يَسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsَy", "root": "كبر"}], "hasIhya": true}, {"ayah": 83, "text": "وَإِذَا سَمِعُوا۟ مَآ أُنزِلَ إِلَى ٱلرَّسُولِ تَرَىٰٓ أَعْيُنَهُمْ تَفِيضُ مِنَ ٱلدَّمْعِ مِمَّا عَرَفُوا۟ مِنَ ٱلْحَقِّۖ يَقُولُونَ رَبَّنَآ ءَامَنَّا فَٱكْتُبْنَا مَعَ ٱلشَّٰهِدِينَ ", "translation": "And when they hear what has been revealed to the Messenger, you see their eyes overflowing with tears because of what they have recognized of the truth. They say, \"Our Lord, we have believed, so register us among the witnesses.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "سَمِعُوا۟", "translit": "۟āwُʿعِmَs", "root": "سمع"}, {"id": 3, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 4, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 7, "arabic": "تَرَىٰٓ", "translit": "ٰٓàَrَt", "root": "راي"}, {"id": 8, "arabic": "أَعْيُنَهُمْ", "translit": "ْmُhَnُyْʿعَaʾ", "root": "عين"}, {"id": 9, "arabic": "تَفِيضُ", "translit": "ُḍyِfَt", "root": "فيض"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلدَّمْعِ", "translit": "ِʿعْmَّdlٱ", "root": "دمع"}, {"id": 12, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 13, "arabic": "عَرَفُوا۟", "translit": "۟āwُfَrَʿع", "root": "عرف"}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 16, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 17, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 18, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 19, "arabic": "فَٱكْتُبْنَا", "translit": "āَnْbُtْkٱَf", "root": "كتب"}, {"id": 20, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 21, "arabic": "ٱلشَّٰهِدِينَ", "translit": "َnyِdِhَّٰhslٱ", "root": "شهد"}], "hasIhya": true}, {"ayah": 84, "text": "وَمَا لَنَا لَا نُؤْمِنُ بِٱللَّهِ وَمَا جَآءَنَا مِنَ ٱلْحَقِّ وَنَطْمَعُ أَن يُدْخِلَنَا رَبُّنَا مَعَ ٱلْقَوْمِ ٱلصَّٰلِحِينَ ", "translation": "And why should we not believe in Allāh and what has come to us of the truth? And we aspire that our Lord will admit us [to Paradise] with the righteous people.\"", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "نُؤْمِنُ", "translit": "ُnِmْwʾُn", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "جَآءَنَا", "translit": "āَnَءٓāَjg", "root": "جيا"}, {"id": 8, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 9, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 10, "arabic": "وَنَطْمَعُ", "translit": "ُʿعَmْṭَnَw", "root": "طمع"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يُدْخِلَنَا", "translit": "āَnَlِhkْdُy", "root": "دخل"}, {"id": 13, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 14, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 15, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 16, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 85, "text": "فَأَثَٰبَهُمُ ٱللَّهُ بِمَا قَالُوا۟ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ وَذَٰلِكَ جَزَآءُ ٱلْمُحْسِنِينَ ", "translation": "So Allāh rewarded them for what they said[1] with gardens [in Paradise] beneath which rivers flow, wherein they abide eternally. And that is the reward of doers of good.", "words": [{"id": 1, "arabic": "فَأَثَٰبَهُمُ", "translit": "ُmُhَbَٰhtَaʾَf", "root": "ثوب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 5, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 6, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 9, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 10, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 11, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 12, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 13, "arabic": "جَزَآءُ", "translit": "ُءٓāَzَjg", "root": "جزي"}, {"id": 14, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": false}, {"ayah": 86, "text": "وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَٰتِنَآ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلْجَحِيمِ ", "translation": "But those who disbelieved and denied Our signs - they are the companions of Hellfire.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 3, "arabic": "وَكَذَّبُوا۟", "translit": "۟āwُbَّhdَkَw", "root": "كذب"}, {"id": 4, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 6, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 7, "arabic": "ٱلْجَحِيمِ", "translit": "ِmyِḥَjgْlٱ", "root": "جحم"}], "hasIhya": false}, {"ayah": 87, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تُحَرِّمُوا۟ طَيِّبَٰتِ مَآ أَحَلَّ ٱللَّهُ لَكُمْ وَلَا تَعْتَدُوٓا۟ۚ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلْمُعْتَدِينَ ", "translation": "O you who have believed, do not prohibit the good things which Allāh has made lawful to you and do not transgress. Indeed, Allāh does not like transgressors.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تُحَرِّمُوا۟", "translit": "۟āwُmِّrَḥُt", "root": "حرم"}, {"id": 6, "arabic": "طَيِّبَٰتِ", "translit": "ِtَٰbِّyَṭ", "root": "طيب"}, {"id": 7, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 8, "arabic": "أَحَلَّ", "translit": "َّlَḥَaʾ", "root": "حلل"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تَعْتَدُوٓا۟", "translit": "۟āٓwُdَtْʿعَt", "root": "عدو"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 17, "arabic": "ٱلْمُعْتَدِينَ", "translit": "َnyِdَtْʿعُmْlٱ", "root": "عدو"}], "hasIhya": true}, {"ayah": 88, "text": "وَكُلُوا۟ مِمَّا رَزَقَكُمُ ٱللَّهُ حَلَٰلًا طَيِّبًاۚ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ أَنتُم بِهِۦ مُؤْمِنُونَ ", "translation": "And eat of what Allāh has provided for you [which is] lawful and good. And fear Allāh, in whom you are believers.", "words": [{"id": 1, "arabic": "وَكُلُوا۟", "translit": "۟āwُlُkَw", "root": "اكل"}, {"id": 2, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 3, "arabic": "رَزَقَكُمُ", "translit": "ُmُkَqَzَr", "root": "رزق"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "حَلَٰلًا", "translit": "āًlَٰlَḥ", "root": "حلل"}, {"id": 6, "arabic": "طَيِّبًا", "translit": "āًbِّyَṭ", "root": "طيب"}, {"id": 7, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "مُؤْمِنُونَ", "translit": "َnwُnِmْwʾُm", "root": "امن"}], "hasIhya": false}, {"ayah": 89, "text": "لَا يُؤَاخِذُكُمُ ٱللَّهُ بِٱللَّغْوِ فِىٓ أَيْمَٰنِكُمْ وَلَٰكِن يُؤَاخِذُكُم بِمَا عَقَّدتُّمُ ٱلْأَيْمَٰنَۖ فَكَفَّٰرَتُهُۥٓ إِطْعَامُ عَشَرَةِ مَسَٰكِينَ مِنْ أَوْسَطِ مَا تُطْعِمُونَ أَهْلِيكُمْ أَوْ كِسْوَتُهُمْ أَوْ تَحْرِيرُ رَقَبَةٍۖ فَمَن لَّمْ يَجِدْ فَصِيَامُ ثَلَٰثَةِ أَيَّامٍۚ ذَٰلِكَ كَفَّٰرَةُ أَيْمَٰنِكُمْ إِذَا حَلَفْتُمْۚ وَٱحْفَظُوٓا۟ أَيْمَٰنَكُمْۚ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمْ ءَايَٰتِهِۦ لَعَلَّكُمْ تَشْكُرُونَ ", "translation": "Allāh will not impose blame upon you for what is meaningless[1] in your oaths, but He will impose blame upon you for [breaking] what you intended of oaths. So its expiation[2] is the feeding of ten needy people from the average of that which you feed your [own] families or clothing them or the freeing of a slave. But whoever cannot find [or afford it] - then a fast of three days [is required]. That is the expiation for oaths when you have sworn. But guard your oaths.[3] Thus does Allāh make clear to you His verses [i.e., revealed law] that you may be grateful.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يُؤَاخِذُكُمُ", "translit": "ُmُkُhdِhkāَwʾُy", "root": "اخذ"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "بِٱللَّغْوِ", "translit": "ِwْغَّllٱِb", "root": "لغو"}, {"id": 5, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 6, "arabic": "أَيْمَٰنِكُمْ", "translit": "ْmُkِnَٰmْyَaʾ", "root": "يمن"}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 8, "arabic": "يُؤَاخِذُكُم", "translit": "mُkُhdِhkāَwʾُy", "root": "اخذ"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "عَقَّدتُّمُ", "translit": "ُmُّtdَّqَʿع", "root": "عقد"}, {"id": 11, "arabic": "ٱلْأَيْمَٰنَ", "translit": "َnَٰmْyَaʾْlٱ", "root": "يمن"}, {"id": 12, "arabic": "فَكَفَّٰرَتُهُۥٓ", "translit": "ٓۥُhُtَrَّٰfَkَf", "root": "كفر"}, {"id": 13, "arabic": "إِطْعَامُ", "translit": "ُmāَʿعْṭِiʾ", "root": "طعم"}, {"id": 14, "arabic": "عَشَرَةِ", "translit": "ِẗَrَhsَʿع", "root": "عشر"}, {"id": 15, "arabic": "مَسَٰكِينَ", "translit": "َnyِkَٰsَm", "root": "سكن"}, {"id": 16, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 17, "arabic": "أَوْسَطِ", "translit": "ِṭَsْwَaʾ", "root": "وسط"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "تُطْعِمُونَ", "translit": "َnwُmِʿعْṭُt", "root": "طعم"}, {"id": 20, "arabic": "أَهْلِيكُمْ", "translit": "ْmُkyِlْhَaʾ", "root": "اهل"}, {"id": 21, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 22, "arabic": "كِسْوَتُهُمْ", "translit": "ْmُhُtَwْsِk", "root": "كسو"}, {"id": 23, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 24, "arabic": "تَحْرِيرُ", "translit": "ُryِrْḥَt", "root": "حرر"}, {"id": 25, "arabic": "رَقَبَةٍ", "translit": "ٍẗَbَqَr", "root": "رقب"}, {"id": 26, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 27, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 28, "arabic": "يَجِدْ", "translit": "ْdِjgَy", "root": "وجد"}, {"id": 29, "arabic": "فَصِيَامُ", "translit": "ُmāَyِṣَf", "root": "صوم"}, {"id": 30, "arabic": "ثَلَٰثَةِ", "translit": "ِẗَhtَٰlَht", "root": "ثلث"}, {"id": 31, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 32, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 33, "arabic": "كَفَّٰرَةُ", "translit": "ُẗَrَّٰfَk", "root": "كفر"}, {"id": 34, "arabic": "أَيْمَٰنِكُمْ", "translit": "ْmُkِnَٰmْyَaʾ", "root": "يمن"}, {"id": 35, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 36, "arabic": "حَلَفْتُمْ", "translit": "ْmُtْfَlَḥ", "root": "حلف"}, {"id": 37, "arabic": "وَٱحْفَظُوٓا۟", "translit": "۟āٓwُẓَfْḥٱَw", "root": "حفظ"}, {"id": 38, "arabic": "أَيْمَٰنَكُمْ", "translit": "ْmُkَnَٰmْyَaʾ", "root": "يمن"}, {"id": 39, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 40, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 41, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 42, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 43, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 44, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 45, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": true}, {"ayah": 90, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّمَا ٱلْخَمْرُ وَٱلْمَيْسِرُ وَٱلْأَنصَابُ وَٱلْأَزْلَٰمُ رِجْسٌ مِّنْ عَمَلِ ٱلشَّيْطَٰنِ فَٱجْتَنِبُوهُ لَعَلَّكُمْ تُفْلِحُونَ ", "translation": "O you who have believed, indeed, intoxicants, gambling, [sacrificing on] stone alters [to other than Allāh], and divining arrows are but defilement from the work of Satan, so avoid[1] it that you may be successful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلْخَمْرُ", "translit": "ُrْmَhkْlٱ", "root": "خمر"}, {"id": 6, "arabic": "وَٱلْمَيْسِرُ", "translit": "ُrِsْyَmْlٱَw", "root": "يسر"}, {"id": 7, "arabic": "وَٱلْأَنصَابُ", "translit": "ُbāَṣnَaʾْlٱَw", "root": "نصب"}, {"id": 8, "arabic": "وَٱلْأَزْلَٰمُ", "translit": "ُmَٰlْzَaʾْlٱَw", "root": "زلم"}, {"id": 9, "arabic": "رِجْسٌ", "translit": "ٌsْjgِr", "root": "رجس"}, {"id": 10, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 11, "arabic": "عَمَلِ", "translit": "ِlَmَʿع", "root": "عمل"}, {"id": 12, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 13, "arabic": "فَٱجْتَنِبُوهُ", "translit": "ُhwُbِnَtْjgٱَf", "root": "جنب"}, {"id": 14, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 15, "arabic": "تُفْلِحُونَ", "translit": "َnwُḥِlْfُt", "root": "فلح"}], "hasIhya": false}, {"ayah": 91, "text": "إِنَّمَا يُرِيدُ ٱلشَّيْطَٰنُ أَن يُوقِعَ بَيْنَكُمُ ٱلْعَدَٰوَةَ وَٱلْبَغْضَآءَ فِى ٱلْخَمْرِ وَٱلْمَيْسِرِ وَيَصُدَّكُمْ عَن ذِكْرِ ٱللَّهِ وَعَنِ ٱلصَّلَوٰةِۖ فَهَلْ أَنتُم مُّنتَهُونَ ", "translation": "Satan only wants to cause between you animosity and hatred through intoxicants and gambling and to avert you from the remembrance of Allāh and from prayer. So will you not desist?", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 3, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يُوقِعَ", "translit": "َʿعِqwُy", "root": "وقع"}, {"id": 6, "arabic": "بَيْنَكُمُ", "translit": "ُmُkَnْyَb", "root": "بين"}, {"id": 7, "arabic": "ٱلْعَدَٰوَةَ", "translit": "َẗَwَٰdَʿعْlٱ", "root": "عدو"}, {"id": 8, "arabic": "وَٱلْبَغْضَآءَ", "translit": "َءٓāَḍْغَbْlٱَw", "root": "بغض"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْخَمْرِ", "translit": "ِrْmَhkْlٱ", "root": "خمر"}, {"id": 11, "arabic": "وَٱلْمَيْسِرِ", "translit": "ِrِsْyَmْlٱَw", "root": "يسر"}, {"id": 12, "arabic": "وَيَصُدَّكُمْ", "translit": "ْmُkَّdُṣَyَw", "root": "صدد"}, {"id": 13, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 14, "arabic": "ذِكْرِ", "translit": "ِrْkِhd", "root": "ذكر"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَعَنِ", "translit": "ِnَʿعَw", "root": ""}, {"id": 17, "arabic": "ٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 18, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 19, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 20, "arabic": "مُّنتَهُونَ", "translit": "َnwُhَtnُّm", "root": "نهي"}], "hasIhya": false}, {"ayah": 92, "text": "وَأَطِيعُوا۟ ٱللَّهَ وَأَطِيعُوا۟ ٱلرَّسُولَ وَٱحْذَرُوا۟ۚ فَإِن تَوَلَّيْتُمْ فَٱعْلَمُوٓا۟ أَنَّمَا عَلَىٰ رَسُولِنَا ٱلْبَلَٰغُ ٱلْمُبِينُ ", "translation": "And obey Allāh and obey the Messenger and beware. And if you turn away - then know that upon Our Messenger is only [the responsibility for] clear notification.", "words": [{"id": 1, "arabic": "وَأَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾَw", "root": "طوع"}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "وَأَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾَw", "root": "طوع"}, {"id": 4, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 5, "arabic": "وَٱحْذَرُوا۟", "translit": "۟āwُrَhdْḥٱَw", "root": "حذر"}, {"id": 6, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 7, "arabic": "تَوَلَّيْتُمْ", "translit": "ْmُtْyَّlَwَt", "root": "ولي"}, {"id": 8, "arabic": "فَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَf", "root": "علم"}, {"id": 9, "arabic": "أَنَّمَا", "translit": "āَmَّnَaʾ", "root": ""}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "رَسُولِنَا", "translit": "āَnِlwُsَr", "root": "رسل"}, {"id": 12, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 13, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 93, "text": "لَيْسَ عَلَى ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ جُنَاحٌ فِيمَا طَعِمُوٓا۟ إِذَا مَا ٱتَّقَوا۟ وَّءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ ثُمَّ ٱتَّقَوا۟ وَّءَامَنُوا۟ ثُمَّ ٱتَّقَوا۟ وَّأَحْسَنُوا۟ۗ وَٱللَّهُ يُحِبُّ ٱلْمُحْسِنِينَ ", "translation": "There is not upon those who believe and do righteousness [any] blame concerning what they have eaten [in the past] if they [now] fear Allāh and believe and do righteous deeds, and then fear Allāh and believe, and then fear Allāh and do good; and Allāh loves the doers of good.", "words": [{"id": 1, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 6, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 7, "arabic": "جُنَاحٌ", "translit": "ٌḥāَnُjg", "root": "جنح"}, {"id": 8, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 9, "arabic": "طَعِمُوٓا۟", "translit": "۟āٓwُmِʿعَṭ", "root": "طعم"}, {"id": 10, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "ٱتَّقَوا۟", "translit": "۟āwَqَّtٱ", "root": "وقي"}, {"id": 13, "arabic": "وَّءَامَنُوا۟", "translit": "۟āwُnَmāَءَّw", "root": "امن"}, {"id": 14, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 15, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 16, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 17, "arabic": "ٱتَّقَوا۟", "translit": "۟āwَqَّtٱ", "root": "وقي"}, {"id": 18, "arabic": "وَّءَامَنُوا۟", "translit": "۟āwُnَmāَءَّw", "root": "امن"}, {"id": 19, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 20, "arabic": "ٱتَّقَوا۟", "translit": "۟āwَqَّtٱ", "root": "وقي"}, {"id": 21, "arabic": "وَّأَحْسَنُوا۟", "translit": "۟āwُnَsْḥَaʾَّw", "root": "حسن"}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 24, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": false}, {"ayah": 94, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَيَبْلُوَنَّكُمُ ٱللَّهُ بِشَىْءٍ مِّنَ ٱلصَّيْدِ تَنَالُهُۥٓ أَيْدِيكُمْ وَرِمَاحُكُمْ لِيَعْلَمَ ٱللَّهُ مَن يَخَافُهُۥ بِٱلْغَيْبِۚ فَمَنِ ٱعْتَدَىٰ بَعْدَ ذَٰلِكَ فَلَهُۥ عَذَابٌ أَلِيمٌ ", "translation": "O you who have believed, Allāh will surely test you through something of the game that your hands and spears [can] reach, that Allāh may make evident those who fear Him unseen. And whoever transgresses after that - for him is a painful punishment.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَيَبْلُوَنَّكُمُ", "translit": "ُmُkَّnَwُlْbَyَl", "root": "بلو"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "بِشَىْءٍ", "translit": "ٍءْàَhsِb", "root": "شيا"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلصَّيْدِ", "translit": "ِdْyَّṣlٱ", "root": "صيد"}, {"id": 9, "arabic": "تَنَالُهُۥٓ", "translit": "ٓۥُhُlāَnَt", "root": "نيل"}, {"id": 10, "arabic": "أَيْدِيكُمْ", "translit": "ْmُkyِdْyَaʾ", "root": "يدي"}, {"id": 11, "arabic": "وَرِمَاحُكُمْ", "translit": "ْmُkُḥāَmِrَw", "root": "رمح"}, {"id": 12, "arabic": "لِيَعْلَمَ", "translit": "َmَlْʿعَyِl", "root": "علم"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 15, "arabic": "يَخَافُهُۥ", "translit": "ۥُhُfāَhkَy", "root": "خوف"}, {"id": 16, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 17, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 18, "arabic": "ٱعْتَدَىٰ", "translit": "ٰàَdَtْʿعٱ", "root": "عدو"}, {"id": 19, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 20, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 21, "arabic": "فَلَهُۥ", "translit": "ۥُhَlَf", "root": ""}, {"id": 22, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 23, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 95, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَقْتُلُوا۟ ٱلصَّيْدَ وَأَنتُمْ حُرُمٌۚ وَمَن قَتَلَهُۥ مِنكُم مُّتَعَمِّدًا فَجَزَآءٌ مِّثْلُ مَا قَتَلَ مِنَ ٱلنَّعَمِ يَحْكُمُ بِهِۦ ذَوَا عَدْلٍ مِّنكُمْ هَدْيًۢا بَٰلِغَ ٱلْكَعْبَةِ أَوْ كَفَّٰرَةٌ طَعَامُ مَسَٰكِينَ أَوْ عَدْلُ ذَٰلِكَ صِيَامًا لِّيَذُوقَ وَبَالَ أَمْرِهِۦۗ عَفَا ٱللَّهُ عَمَّا سَلَفَۚ وَمَنْ عَادَ فَيَنتَقِمُ ٱللَّهُ مِنْهُۗ وَٱللَّهُ عَزِيزٌ ذُو ٱنتِقَامٍ ", "translation": "O you who have believed, do not kill game while you are in the state of iḥrām.[1] And whoever of you kills it intentionally - the penalty is an equivalent from sacrificial animals to what he killed, as judged by two just men among you as an offering [to Allāh] delivered to the Kaʿbah, or an expiation: the feeding of needy people or the equivalent of that in fasting, that he may taste the consequence of his matter [i.e., deed]. Allāh has pardoned what is past; but whoever returns [to violation], then Allāh will take retribution from him. And Allāh is Exalted in Might and Owner of Retribution.[2]", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَقْتُلُوا۟", "translit": "۟āwُlُtْqَt", "root": "قتل"}, {"id": 6, "arabic": "ٱلصَّيْدَ", "translit": "َdْyَّṣlٱ", "root": "صيد"}, {"id": 7, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 8, "arabic": "حُرُمٌ", "translit": "ٌmُrُḥ", "root": "حرم"}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "قَتَلَهُۥ", "translit": "ۥُhَlَtَq", "root": "قتل"}, {"id": 11, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 12, "arabic": "مُّتَعَمِّدًا", "translit": "āًdِّmَʿعَtُّm", "root": "عمد"}, {"id": 13, "arabic": "فَجَزَآءٌ", "translit": "ٌءٓāَzَjgَf", "root": "جزي"}, {"id": 14, "arabic": "مِّثْلُ", "translit": "ُlْhtِّm", "root": "مثل"}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "قَتَلَ", "translit": "َlَtَq", "root": "قتل"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلنَّعَمِ", "translit": "ِmَʿعَّnlٱ", "root": "نعم"}, {"id": 19, "arabic": "يَحْكُمُ", "translit": "ُmُkْḥَy", "root": "حكم"}, {"id": 20, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 21, "arabic": "ذَوَا", "translit": "āَwَhd", "root": ""}, {"id": 22, "arabic": "عَدْلٍ", "translit": "ٍlْdَʿع", "root": "عدل"}, {"id": 23, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 24, "arabic": "هَدْيًۢا", "translit": "āًۢyْdَh", "root": "هدي"}, {"id": 25, "arabic": "بَٰلِغَ", "translit": "َغِlَٰb", "root": "بلغ"}, {"id": 26, "arabic": "ٱلْكَعْبَةِ", "translit": "ِẗَbْʿعَkْlٱ", "root": "كعب"}, {"id": 27, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 28, "arabic": "كَفَّٰرَةٌ", "translit": "ٌẗَrَّٰfَk", "root": "كفر"}, {"id": 29, "arabic": "طَعَامُ", "translit": "ُmāَʿعَṭ", "root": "طعم"}, {"id": 30, "arabic": "مَسَٰكِينَ", "translit": "َnyِkَٰsَm", "root": "سكن"}, {"id": 31, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 32, "arabic": "عَدْلُ", "translit": "ُlْdَʿع", "root": "عدل"}, {"id": 33, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 34, "arabic": "صِيَامًا", "translit": "āًmāَyِṣ", "root": "صوم"}, {"id": 35, "arabic": "لِّيَذُوقَ", "translit": "َqwُhdَyِّl", "root": "ذوق"}, {"id": 36, "arabic": "وَبَالَ", "translit": "َlāَbَw", "root": "وبل"}, {"id": 37, "arabic": "أَمْرِهِۦ", "translit": "ۦِhِrْmَaʾ", "root": "امر"}, {"id": 38, "arabic": "عَفَا", "translit": "āَfَʿع", "root": "عفو"}, {"id": 39, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 40, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 41, "arabic": "سَلَفَ", "translit": "َfَlَs", "root": "سلف"}, {"id": 42, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 43, "arabic": "عَادَ", "translit": "َdāَʿع", "root": "عود"}, {"id": 44, "arabic": "فَيَنتَقِمُ", "translit": "ُmِqَtnَyَf", "root": "نقم"}, {"id": 45, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 46, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 47, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 48, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 49, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 50, "arabic": "ٱنتِقَامٍ", "translit": "ٍmāَqِtnٱ", "root": "نقم"}], "hasIhya": true}, {"ayah": 96, "text": "أُحِلَّ لَكُمْ صَيْدُ ٱلْبَحْرِ وَطَعَامُهُۥ مَتَٰعًا لَّكُمْ وَلِلسَّيَّارَةِۖ وَحُرِّمَ عَلَيْكُمْ صَيْدُ ٱلْبَرِّ مَا دُمْتُمْ حُرُمًاۗ وَٱتَّقُوا۟ ٱللَّهَ ٱلَّذِىٓ إِلَيْهِ تُحْشَرُونَ ", "translation": "Lawful to you is game from the sea and its food as provision for you and the travelers,[1] but forbidden to you is game from the land as long as you are in the state of iḥrām. And fear Allāh to whom you will be gathered.", "words": [{"id": 1, "arabic": "أُحِلَّ", "translit": "َّlِḥُaʾ", "root": "حلل"}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "صَيْدُ", "translit": "ُdْyَṣ", "root": "صيد"}, {"id": 4, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 5, "arabic": "وَطَعَامُهُۥ", "translit": "ۥُhُmāَʿعَṭَw", "root": "طعم"}, {"id": 6, "arabic": "مَتَٰعًا", "translit": "āًʿعَٰtَm", "root": "متع"}, {"id": 7, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 8, "arabic": "وَلِلسَّيَّارَةِ", "translit": "ِẗَrāَّyَّslِlَw", "root": "سير"}, {"id": 9, "arabic": "وَحُرِّمَ", "translit": "َmِّrُḥَw", "root": "حرم"}, {"id": 10, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 11, "arabic": "صَيْدُ", "translit": "ُdْyَṣ", "root": "صيد"}, {"id": 12, "arabic": "ٱلْبَرِّ", "translit": "ِّrَbْlٱ", "root": "برر"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "دُمْتُمْ", "translit": "ْmُtْmُd", "root": "دوم"}, {"id": 15, "arabic": "حُرُمًا", "translit": "āًmُrُḥ", "root": "حرم"}, {"id": 16, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 19, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 20, "arabic": "تُحْشَرُونَ", "translit": "َnwُrَhsْḥُt", "root": "حشر"}], "hasIhya": false}, {"ayah": 97, "text": "جَعَلَ ٱللَّهُ ٱلْكَعْبَةَ ٱلْبَيْتَ ٱلْحَرَامَ قِيَٰمًا لِّلنَّاسِ وَٱلشَّهْرَ ٱلْحَرَامَ وَٱلْهَدْىَ وَٱلْقَلَٰٓئِدَۚ ذَٰلِكَ لِتَعْلَمُوٓا۟ أَنَّ ٱللَّهَ يَعْلَمُ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ وَأَنَّ ٱللَّهَ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "Allāh has made the Kaʿbah, the Sacred House, standing[1] for the people and [has sanctified] the sacred months and the sacrificial animals and the garlands [by which they are identified]. That is so you may know that Allāh knows what is in the heavens and what is in the earth and that Allāh is Knowing of all things.", "words": [{"id": 1, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلْكَعْبَةَ", "translit": "َẗَbْʿعَkْlٱ", "root": "كعب"}, {"id": 4, "arabic": "ٱلْبَيْتَ", "translit": "َtْyَbْlٱ", "root": "بيت"}, {"id": 5, "arabic": "ٱلْحَرَامَ", "translit": "َmāَrَḥْlٱ", "root": "حرم"}, {"id": 6, "arabic": "قِيَٰمًا", "translit": "āًmَٰyِq", "root": "قوم"}, {"id": 7, "arabic": "لِّلنَّاسِ", "translit": "ِsāَّnlِّl", "root": "انس"}, {"id": 8, "arabic": "وَٱلشَّهْرَ", "translit": "َrْhَّhslٱَw", "root": "شهر"}, {"id": 9, "arabic": "ٱلْحَرَامَ", "translit": "َmāَrَḥْlٱ", "root": "حرم"}, {"id": 10, "arabic": "وَٱلْهَدْىَ", "translit": "َàْdَhْlٱَw", "root": "هدي"}, {"id": 11, "arabic": "وَٱلْقَلَٰٓئِدَ", "translit": "َdِyʾَٰٓlَqْlٱَw", "root": "قلد"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "لِتَعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعَtِl", "root": "علم"}, {"id": 14, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 17, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 20, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 21, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 22, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 23, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 24, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 26, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 27, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 98, "text": "ٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ وَأَنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "Know that Allāh is severe in penalty and that Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "ٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱ", "root": "علم"}, {"id": 2, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 5, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}, {"id": 6, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 9, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 99, "text": "مَّا عَلَى ٱلرَّسُولِ إِلَّا ٱلْبَلَٰغُۗ وَٱللَّهُ يَعْلَمُ مَا تُبْدُونَ وَمَا تَكْتُمُونَ ", "translation": "Not upon the Messenger is [responsibility] except [for] notification. And Allāh knows whatever you reveal and whatever you conceal.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "تُبْدُونَ", "translit": "َnwُdْbُt", "root": "بدو"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "تَكْتُمُونَ", "translit": "َnwُmُtْkَt", "root": "كتم"}], "hasIhya": false}, {"ayah": 100, "text": "قُل لَّا يَسْتَوِى ٱلْخَبِيثُ وَٱلطَّيِّبُ وَلَوْ أَعْجَبَكَ كَثْرَةُ ٱلْخَبِيثِۚ فَٱتَّقُوا۟ ٱللَّهَ يَٰٓأُو۟لِى ٱلْأَلْبَٰبِ لَعَلَّكُمْ تُفْلِحُونَ ", "translation": "Say, \"Not equal are the evil and the good, although the abundance of evil might impress you.\" So fear Allāh, O you of understanding, that you may be successful.", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "يَسْتَوِى", "translit": "àِwَtْsَy", "root": "سوي"}, {"id": 4, "arabic": "ٱلْخَبِيثُ", "translit": "ُhtyِbَhkْlٱ", "root": "خبث"}, {"id": 5, "arabic": "وَٱلطَّيِّبُ", "translit": "ُbِّyَّṭlٱَw", "root": "طيب"}, {"id": 6, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 7, "arabic": "أَعْجَبَكَ", "translit": "َkَbَjgْʿعَaʾ", "root": "عجب"}, {"id": 8, "arabic": "كَثْرَةُ", "translit": "ُẗَrْhtَk", "root": "كثر"}, {"id": 9, "arabic": "ٱلْخَبِيثِ", "translit": "ِhtyِbَhkْlٱ", "root": "خبث"}, {"id": 10, "arabic": "فَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَf", "root": "وقي"}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "يَٰٓأُو۟لِى", "translit": "àِl۟wُaʾَٰٓy", "root": ""}, {"id": 13, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}, {"id": 14, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 15, "arabic": "تُفْلِحُونَ", "translit": "َnwُḥِlْfُt", "root": "فلح"}], "hasIhya": false}, {"ayah": 101, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَسْـَٔلُوا۟ عَنْ أَشْيَآءَ إِن تُبْدَ لَكُمْ تَسُؤْكُمْ وَإِن تَسْـَٔلُوا۟ عَنْهَا حِينَ يُنَزَّلُ ٱلْقُرْءَانُ تُبْدَ لَكُمْ عَفَا ٱللَّهُ عَنْهَاۗ وَٱللَّهُ غَفُورٌ حَلِيمٌ ", "translation": "O you who have believed, do not ask about things which, if they are shown to you, will distress you. But if you ask about them while the Qur’ān is being revealed, they will be shown to you. Allāh has pardoned it [i.e., that which is past]; and Allāh is Forgiving and Forbearing.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَسْـَٔلُوا۟", "translit": "۟āwُlَٔـْsَt", "root": "سال"}, {"id": 6, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 7, "arabic": "أَشْيَآءَ", "translit": "َءٓāَyْhsَaʾ", "root": "شيا"}, {"id": 8, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 9, "arabic": "تُبْدَ", "translit": "َdْbُt", "root": "بدو"}, {"id": 10, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 11, "arabic": "تَسُؤْكُمْ", "translit": "ْmُkْwʾُsَt", "root": "سوا"}, {"id": 12, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 13, "arabic": "تَسْـَٔلُوا۟", "translit": "۟āwُlَٔـْsَt", "root": "سال"}, {"id": 14, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 15, "arabic": "حِينَ", "translit": "َnyِḥ", "root": "حين"}, {"id": 16, "arabic": "يُنَزَّلُ", "translit": "ُlَّzَnُy", "root": "نزل"}, {"id": 17, "arabic": "ٱلْقُرْءَانُ", "translit": "ُnāَءْrُqْlٱ", "root": "قرا"}, {"id": 18, "arabic": "تُبْدَ", "translit": "َdْbُt", "root": "بدو"}, {"id": 19, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 20, "arabic": "عَفَا", "translit": "āَfَʿع", "root": "عفو"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 23, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 24, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 25, "arabic": "حَلِيمٌ", "translit": "ٌmyِlَḥ", "root": "حلم"}], "hasIhya": true}, {"ayah": 102, "text": "قَدْ سَأَلَهَا قَوْمٌ مِّن قَبْلِكُمْ ثُمَّ أَصْبَحُوا۟ بِهَا كَٰفِرِينَ ", "translation": "A people asked such [questions] before you; then they became thereby disbelievers.[1]", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "سَأَلَهَا", "translit": "āَhَlَaʾَs", "root": "سال"}, {"id": 3, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "أَصْبَحُوا۟", "translit": "۟āwُḥَbْṣَaʾ", "root": "صبح"}, {"id": 8, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 9, "arabic": "كَٰفِرِينَ", "translit": "َnyِrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 103, "text": "مَا جَعَلَ ٱللَّهُ مِنۢ بَحِيرَةٍ وَلَا سَآئِبَةٍ وَلَا وَصِيلَةٍ وَلَا حَامٍۙ وَلَٰكِنَّ ٱلَّذِينَ كَفَرُوا۟ يَفْتَرُونَ عَلَى ٱللَّهِ ٱلْكَذِبَۖ وَأَكْثَرُهُمْ لَا يَعْقِلُونَ ", "translation": "Allāh has not appointed [such innovations as] baḥīrah or sā’ibah or waṣīlah or ḥām.[1] But those who disbelieve invent falsehood about Allāh, and most of them do not reason.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَحِيرَةٍ", "translit": "ٍẗَryِḥَb", "root": "بحر"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "سَآئِبَةٍ", "translit": "ٍẗَbِyʾٓāَs", "root": "سيب"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "وَصِيلَةٍ", "translit": "ٍẗَlyِṣَw", "root": "وصل"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "حَامٍ", "translit": "ٍmāَḥ", "root": "حمي"}, {"id": 12, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 15, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}, {"id": 16, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 19, "arabic": "وَأَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾَw", "root": "كثر"}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 104, "text": "وَإِذَا قِيلَ لَهُمْ تَعَالَوْا۟ إِلَىٰ مَآ أَنزَلَ ٱللَّهُ وَإِلَى ٱلرَّسُولِ قَالُوا۟ حَسْبُنَا مَا وَجَدْنَا عَلَيْهِ ءَابَآءَنَآۚ أَوَلَوْ كَانَ ءَابَآؤُهُمْ لَا يَعْلَمُونَ شَيْـًٔا وَلَا يَهْتَدُونَ ", "translation": "And when it is said to them, \"Come to what Allāh has revealed and to the Messenger,\" they say, \"Sufficient for us is that upon which we found our fathers.\" Even though their fathers knew nothing, nor were they guided?", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "تَعَالَوْا۟", "translit": "۟āْwَlāَʿعَt", "root": "علو"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 7, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَإِلَى", "translit": "àَlِiʾَw", "root": ""}, {"id": 10, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 11, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 12, "arabic": "حَسْبُنَا", "translit": "āَnُbْsَḥ", "root": "حسب"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "وَجَدْنَا", "translit": "āَnْdَjgَw", "root": "وجد"}, {"id": 15, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 16, "arabic": "ءَابَآءَنَآ", "translit": "ٓāَnَءٓāَbāَء", "root": "ابو"}, {"id": 17, "arabic": "أَوَلَوْ", "translit": "ْwَlَwَaʾ", "root": ""}, {"id": 18, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 19, "arabic": "ءَابَآؤُهُمْ", "translit": "ْmُhُwʾٓāَbāَء", "root": "ابو"}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}, {"id": 22, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 23, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 24, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 105, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ عَلَيْكُمْ أَنفُسَكُمْۖ لَا يَضُرُّكُم مَّن ضَلَّ إِذَا ٱهْتَدَيْتُمْۚ إِلَى ٱللَّهِ مَرْجِعُكُمْ جَمِيعًا فَيُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "O you who have believed, upon you is [responsibility for] yourselves. Those who have gone astray will not harm you when you have been guided. To Allāh is your return all together; then He will inform you of what you used to do.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَضُرُّكُم", "translit": "mُkُّrُḍَy", "root": "ضرر"}, {"id": 8, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 9, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 10, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 11, "arabic": "ٱهْتَدَيْتُمْ", "translit": "ْmُtْyَdَtْhٱ", "root": "هدي"}, {"id": 12, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "مَرْجِعُكُمْ", "translit": "ْmُkُʿعِjgْrَm", "root": "رجع"}, {"id": 15, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 16, "arabic": "فَيُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُyَf", "root": "نبا"}, {"id": 17, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 18, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 19, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 106, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ شَهَٰدَةُ بَيْنِكُمْ إِذَا حَضَرَ أَحَدَكُمُ ٱلْمَوْتُ حِينَ ٱلْوَصِيَّةِ ٱثْنَانِ ذَوَا عَدْلٍ مِّنكُمْ أَوْ ءَاخَرَانِ مِنْ غَيْرِكُمْ إِنْ أَنتُمْ ضَرَبْتُمْ فِى ٱلْأَرْضِ فَأَصَٰبَتْكُم مُّصِيبَةُ ٱلْمَوْتِۚ تَحْبِسُونَهُمَا مِنۢ بَعْدِ ٱلصَّلَوٰةِ فَيُقْسِمَانِ بِٱللَّهِ إِنِ ٱرْتَبْتُمْ لَا نَشْتَرِى بِهِۦ ثَمَنًا وَلَوْ كَانَ ذَا قُرْبَىٰۙ وَلَا نَكْتُمُ شَهَٰدَةَ ٱللَّهِ إِنَّآ إِذًا لَّمِنَ ٱلْءَاثِمِينَ ", "translation": "O you who have believed, testimony [should be taken] among you when death approaches one of you at the time of bequest - [that of] two just men from among you or two others from outside if you are traveling through the land and the disaster of death should strike you. Detain them after the prayer and let them both swear by Allāh if you doubt [their testimony, saying], \"We will not exchange it [i.e., our oath] for a price [i.e., worldly gain], even if he should be a near relative, and we will not withhold the testimony of [i.e., ordained by] Allāh. Indeed, we would then be of the sinful.\"", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "شَهَٰدَةُ", "translit": "ُẗَdَٰhَhs", "root": "شهد"}, {"id": 5, "arabic": "بَيْنِكُمْ", "translit": "ْmُkِnْyَb", "root": "بين"}, {"id": 6, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 7, "arabic": "حَضَرَ", "translit": "َrَḍَḥ", "root": "حضر"}, {"id": 8, "arabic": "أَحَدَكُمُ", "translit": "ُmُkَdَḥَaʾ", "root": "احد"}, {"id": 9, "arabic": "ٱلْمَوْتُ", "translit": "ُtْwَmْlٱ", "root": "موت"}, {"id": 10, "arabic": "حِينَ", "translit": "َnyِḥ", "root": "حين"}, {"id": 11, "arabic": "ٱلْوَصِيَّةِ", "translit": "ِẗَّyِṣَwْlٱ", "root": "وصي"}, {"id": 12, "arabic": "ٱثْنَانِ", "translit": "ِnāَnْhtٱ", "root": "ثني"}, {"id": 13, "arabic": "ذَوَا", "translit": "āَwَhd", "root": ""}, {"id": 14, "arabic": "عَدْلٍ", "translit": "ٍlْdَʿع", "root": "عدل"}, {"id": 15, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 16, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 17, "arabic": "ءَاخَرَانِ", "translit": "ِnāَrَhkāَء", "root": "اخر"}, {"id": 18, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 19, "arabic": "غَيْرِكُمْ", "translit": "ْmُkِrْyَغ", "root": "غير"}, {"id": 20, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 21, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 22, "arabic": "ضَرَبْتُمْ", "translit": "ْmُtْbَrَḍ", "root": "ضرب"}, {"id": 23, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 24, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 25, "arabic": "فَأَصَٰبَتْكُم", "translit": "mُkْtَbَٰṣَaʾَf", "root": "صوب"}, {"id": 26, "arabic": "مُّصِيبَةُ", "translit": "ُẗَbyِṣُّm", "root": "صوب"}, {"id": 27, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 28, "arabic": "تَحْبِسُونَهُمَا", "translit": "āَmُhَnwُsِbْḥَt", "root": "حبس"}, {"id": 29, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 30, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 31, "arabic": "ٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 32, "arabic": "فَيُقْسِمَانِ", "translit": "ِnāَmِsْqُyَf", "root": "قسم"}, {"id": 33, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 34, "arabic": "إِنِ", "translit": "ِnِiʾ", "root": ""}, {"id": 35, "arabic": "ٱرْتَبْتُمْ", "translit": "ْmُtْbَtْrٱ", "root": "ريب"}, {"id": 36, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 37, "arabic": "نَشْتَرِى", "translit": "àِrَtْhsَn", "root": "شري"}, {"id": 38, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 39, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 40, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 41, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 42, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 43, "arabic": "قُرْبَىٰ", "translit": "ٰàَbْrُq", "root": "قرب"}, {"id": 44, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 45, "arabic": "نَكْتُمُ", "translit": "ُmُtْkَn", "root": "كتم"}, {"id": 46, "arabic": "شَهَٰدَةَ", "translit": "َẗَdَٰhَhs", "root": "شهد"}, {"id": 47, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 48, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 49, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 50, "arabic": "لَّمِنَ", "translit": "َnِmَّl", "root": ""}, {"id": 51, "arabic": "ٱلْءَاثِمِينَ", "translit": "َnyِmِhtāَءْlٱ", "root": "اثم"}], "hasIhya": true}, {"ayah": 107, "text": "فَإِنْ عُثِرَ عَلَىٰٓ أَنَّهُمَا ٱسْتَحَقَّآ إِثْمًا فَـَٔاخَرَانِ يَقُومَانِ مَقَامَهُمَا مِنَ ٱلَّذِينَ ٱسْتَحَقَّ عَلَيْهِمُ ٱلْأَوْلَيَٰنِ فَيُقْسِمَانِ بِٱللَّهِ لَشَهَٰدَتُنَآ أَحَقُّ مِن شَهَٰدَتِهِمَا وَمَا ٱعْتَدَيْنَآ إِنَّآ إِذًا لَّمِنَ ٱلظَّٰلِمِينَ ", "translation": "But if it is found that those two were guilty of sin [i.e., perjury], let two others stand in their place [who are] foremost [in claim] from those who have a lawful right. And let them swear by Allāh, \"Our testimony is truer than their testimony, and we have not transgressed. Indeed, we would then be of the wrongdoers.\"", "words": [{"id": 1, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 2, "arabic": "عُثِرَ", "translit": "َrِhtُʿع", "root": "عثر"}, {"id": 3, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 4, "arabic": "أَنَّهُمَا", "translit": "āَmُhَّnَaʾ", "root": ""}, {"id": 5, "arabic": "ٱسْتَحَقَّآ", "translit": "ٓāَّqَḥَtْsٱ", "root": "حقق"}, {"id": 6, "arabic": "إِثْمًا", "translit": "āًmْhtِiʾ", "root": "اثم"}, {"id": 7, "arabic": "فَـَٔاخَرَانِ", "translit": "ِnāَrَhkāَٔـَf", "root": "اخر"}, {"id": 8, "arabic": "يَقُومَانِ", "translit": "ِnāَmwُqَy", "root": "قوم"}, {"id": 9, "arabic": "مَقَامَهُمَا", "translit": "āَmُhَmāَqَm", "root": "قوم"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "ٱسْتَحَقَّ", "translit": "َّqَḥَtْsٱ", "root": "حقق"}, {"id": 13, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "ٱلْأَوْلَيَٰنِ", "translit": "ِnَٰyَlْwَaʾْlٱ", "root": "ولي"}, {"id": 15, "arabic": "فَيُقْسِمَانِ", "translit": "ِnāَmِsْqُyَf", "root": "قسم"}, {"id": 16, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 17, "arabic": "لَشَهَٰدَتُنَآ", "translit": "ٓāَnُtَdَٰhَhsَl", "root": "شهد"}, {"id": 18, "arabic": "أَحَقُّ", "translit": "ُّqَḥَaʾ", "root": "حقق"}, {"id": 19, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 20, "arabic": "شَهَٰدَتِهِمَا", "translit": "āَmِhِtَdَٰhَhs", "root": "شهد"}, {"id": 21, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 22, "arabic": "ٱعْتَدَيْنَآ", "translit": "ٓāَnْyَdَtْʿعٱ", "root": "عدو"}, {"id": 23, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 24, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 25, "arabic": "لَّمِنَ", "translit": "َnِmَّl", "root": ""}, {"id": 26, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 108, "text": "ذَٰلِكَ أَدْنَىٰٓ أَن يَأْتُوا۟ بِٱلشَّهَٰدَةِ عَلَىٰ وَجْهِهَآ أَوْ يَخَافُوٓا۟ أَن تُرَدَّ أَيْمَٰنٌۢ بَعْدَ أَيْمَٰنِهِمْۗ وَٱتَّقُوا۟ ٱللَّهَ وَٱسْمَعُوا۟ۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلْفَٰسِقِينَ ", "translation": "That is more likely that they will give testimony according to its [true] objective, or [at least] they would fear that [other] oaths might be taken after their oaths. And fear Allāh and listen [i.e., obey Him]; and Allāh does not guide the defiantly disobedient people.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "أَدْنَىٰٓ", "translit": "ٰٓàَnْdَaʾ", "root": "دنو"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يَأْتُوا۟", "translit": "۟āwُtْaʾَy", "root": "اتي"}, {"id": 5, "arabic": "بِٱلشَّهَٰدَةِ", "translit": "ِẗَdَٰhَّhslٱِb", "root": "شهد"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "وَجْهِهَآ", "translit": "ٓāَhِhْjgَw", "root": "وجه"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "يَخَافُوٓا۟", "translit": "۟āٓwُfāَhkَy", "root": "خوف"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "تُرَدَّ", "translit": "َّdَrُt", "root": "ردد"}, {"id": 12, "arabic": "أَيْمَٰنٌۢ", "translit": "ٌۢnَٰmْyَaʾ", "root": "يمن"}, {"id": 13, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 14, "arabic": "أَيْمَٰنِهِمْ", "translit": "ْmِhِnَٰmْyَaʾ", "root": "يمن"}, {"id": 15, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَٱسْمَعُوا۟", "translit": "۟āwُʿعَmْsٱَw", "root": "سمع"}, {"id": 18, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 21, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 22, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 109, "text": "يَوْمَ يَجْمَعُ ٱللَّهُ ٱلرُّسُلَ فَيَقُولُ مَاذَآ أُجِبْتُمْۖ قَالُوا۟ لَا عِلْمَ لَنَآۖ إِنَّكَ أَنتَ عَلَّٰمُ ٱلْغُيُوبِ ", "translation": "[Be warned of] the Day when Allāh will assemble the messengers and say, \"What was the response you received?\" They will say, \"We have no knowledge. Indeed, it is You who is Knower of the unseen\" -", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يَجْمَعُ", "translit": "ُʿعَmْjgَy", "root": "جمع"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلرُّسُلَ", "translit": "َlُsُّrlٱ", "root": "رسل"}, {"id": 5, "arabic": "فَيَقُولُ", "translit": "ُlwُqَyَf", "root": "قول"}, {"id": 6, "arabic": "مَاذَآ", "translit": "ٓāَhdāَm", "root": ""}, {"id": 7, "arabic": "أُجِبْتُمْ", "translit": "ْmُtْbِjgُaʾ", "root": "جوب"}, {"id": 8, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "عِلْمَ", "translit": "َmْlِʿع", "root": "علم"}, {"id": 11, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 12, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 13, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 14, "arabic": "عَلَّٰمُ", "translit": "ُmَّٰlَʿع", "root": "علم"}, {"id": 15, "arabic": "ٱلْغُيُوبِ", "translit": "ِbwُyُغْlٱ", "root": "غيب"}], "hasIhya": true}, {"ayah": 110, "text": "إِذْ قَالَ ٱللَّهُ يَٰعِيسَى ٱبْنَ مَرْيَمَ ٱذْكُرْ نِعْمَتِى عَلَيْكَ وَعَلَىٰ وَٰلِدَتِكَ إِذْ أَيَّدتُّكَ بِرُوحِ ٱلْقُدُسِ تُكَلِّمُ ٱلنَّاسَ فِى ٱلْمَهْدِ وَكَهْلًاۖ وَإِذْ عَلَّمْتُكَ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ وَٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَۖ وَإِذْ تَخْلُقُ مِنَ ٱلطِّينِ كَهَيْـَٔةِ ٱلطَّيْرِ بِإِذْنِى فَتَنفُخُ فِيهَا فَتَكُونُ طَيْرًۢا بِإِذْنِىۖ وَتُبْرِئُ ٱلْأَكْمَهَ وَٱلْأَبْرَصَ بِإِذْنِىۖ وَإِذْ تُخْرِجُ ٱلْمَوْتَىٰ بِإِذْنِىۖ وَإِذْ كَفَفْتُ بَنِىٓ إِسْرَٰٓءِيلَ عَنكَ إِذْ جِئْتَهُم بِٱلْبَيِّنَٰتِ فَقَالَ ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ إِنْ هَٰذَآ إِلَّا سِحْرٌ مُّبِينٌ ", "translation": "[The Day] when Allāh will say, \"O Jesus, Son of Mary, remember My favor upon you and upon your mother when I supported you with the Pure Spirit [i.e., the angel Gabriel] and you spoke to the people in the cradle and in maturity; and [remember] when I taught you writing and wisdom and the Torah and the Gospel; and when you designed from clay [what was] like the form of a bird with My permission, then you breathed into it, and it became a bird with My permission; and you healed the blind [from birth] and the leper with My permission; and when you brought forth the dead with My permission; and when I restrained the Children of Israel from [killing] you when you came to them with clear proofs and those who disbelieved among them said, \"This is not but obvious magic.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "يَٰعِيسَى", "translit": "àَsyِʿعَٰy", "root": ""}, {"id": 5, "arabic": "ٱبْنَ", "translit": "َnْbٱ", "root": "بني"}, {"id": 6, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 7, "arabic": "ٱذْكُرْ", "translit": "ْrُkْhdٱ", "root": "ذكر"}, {"id": 8, "arabic": "نِعْمَتِى", "translit": "àِtَmْʿعِn", "root": "نعم"}, {"id": 9, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 10, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 11, "arabic": "وَٰلِدَتِكَ", "translit": "َkِtَdِlَٰw", "root": "ولد"}, {"id": 12, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 13, "arabic": "أَيَّدتُّكَ", "translit": "َkُّtdَّyَaʾ", "root": "ايد"}, {"id": 14, "arabic": "بِرُوحِ", "translit": "ِḥwُrِb", "root": "روح"}, {"id": 15, "arabic": "ٱلْقُدُسِ", "translit": "ِsُdُqْlٱ", "root": "قدس"}, {"id": 16, "arabic": "تُكَلِّمُ", "translit": "ُmِّlَkُt", "root": "كلم"}, {"id": 17, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلْمَهْدِ", "translit": "ِdْhَmْlٱ", "root": "مهد"}, {"id": 20, "arabic": "وَكَهْلًا", "translit": "āًlْhَkَw", "root": "كهل"}, {"id": 21, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 22, "arabic": "عَلَّمْتُكَ", "translit": "َkُtْmَّlَʿع", "root": "علم"}, {"id": 23, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 24, "arabic": "وَٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱَw", "root": "حكم"}, {"id": 25, "arabic": "وَٱلتَّوْرَىٰةَ", "translit": "َẗٰàَrْwَّtlٱَw", "root": ""}, {"id": 26, "arabic": "وَٱلْإِنجِيلَ", "translit": "َlyِjgnِiʾْlٱَw", "root": ""}, {"id": 27, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 28, "arabic": "تَخْلُقُ", "translit": "ُqُlْhkَt", "root": "خلق"}, {"id": 29, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 30, "arabic": "ٱلطِّينِ", "translit": "ِnyِّṭlٱ", "root": "طين"}, {"id": 31, "arabic": "كَهَيْـَٔةِ", "translit": "ِẗَٔـْyَhَk", "root": "هيا"}, {"id": 32, "arabic": "ٱلطَّيْرِ", "translit": "ِrْyَّṭlٱ", "root": "طير"}, {"id": 33, "arabic": "بِإِذْنِى", "translit": "àِnْhdِiʾِb", "root": "اذن"}, {"id": 34, "arabic": "فَتَنفُخُ", "translit": "ُhkُfnَtَf", "root": "نفخ"}, {"id": 35, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 36, "arabic": "فَتَكُونُ", "translit": "ُnwُkَtَf", "root": "كون"}, {"id": 37, "arabic": "طَيْرًۢا", "translit": "āًۢrْyَṭ", "root": "طير"}, {"id": 38, "arabic": "بِإِذْنِى", "translit": "àِnْhdِiʾِb", "root": "اذن"}, {"id": 39, "arabic": "وَتُبْرِئُ", "translit": "ُyʾِrْbُtَw", "root": "برا"}, {"id": 40, "arabic": "ٱلْأَكْمَهَ", "translit": "َhَmْkَaʾْlٱ", "root": "كمه"}, {"id": 41, "arabic": "وَٱلْأَبْرَصَ", "translit": "َṣَrْbَaʾْlٱَw", "root": "برص"}, {"id": 42, "arabic": "بِإِذْنِى", "translit": "àِnْhdِiʾِb", "root": "اذن"}, {"id": 43, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 44, "arabic": "تُخْرِجُ", "translit": "ُjgِrْhkُt", "root": "خرج"}, {"id": 45, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 46, "arabic": "بِإِذْنِى", "translit": "àِnْhdِiʾِb", "root": "اذن"}, {"id": 47, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 48, "arabic": "كَفَفْتُ", "translit": "ُtْfَfَk", "root": "كفف"}, {"id": 49, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 50, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 51, "arabic": "عَنكَ", "translit": "َknَʿع", "root": ""}, {"id": 52, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 53, "arabic": "جِئْتَهُم", "translit": "mُhَtْyʾِjg", "root": "جيا"}, {"id": 54, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 55, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 56, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 57, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 58, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 59, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 60, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 61, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 62, "arabic": "سِحْرٌ", "translit": "ٌrْḥِs", "root": "سحر"}, {"id": 63, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 111, "text": "وَإِذْ أَوْحَيْتُ إِلَى ٱلْحَوَارِيِّۦنَ أَنْ ءَامِنُوا۟ بِى وَبِرَسُولِى قَالُوٓا۟ ءَامَنَّا وَٱشْهَدْ بِأَنَّنَا مُسْلِمُونَ ", "translation": "And [remember] when I inspired to the disciples, \"Believe in Me and in My messenger [i.e., Jesus].\" They said, \"We have believed, so bear witness that indeed we are Muslims [in submission to Allāh].\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَوْحَيْتُ", "translit": "ُtْyَḥْwَaʾ", "root": "وحي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْحَوَارِيِّۦنَ", "translit": "َnۦِّyِrāَwَḥْlٱ", "root": "حور"}, {"id": 5, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 6, "arabic": "ءَامِنُوا۟", "translit": "۟āwُnِmāَء", "root": "امن"}, {"id": 7, "arabic": "بِى", "translit": "àِb", "root": ""}, {"id": 8, "arabic": "وَبِرَسُولِى", "translit": "àِlwُsَrِbَw", "root": "رسل"}, {"id": 9, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 10, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 11, "arabic": "وَٱشْهَدْ", "translit": "ْdَhْhsٱَw", "root": "شهد"}, {"id": 12, "arabic": "بِأَنَّنَا", "translit": "āَnَّnَaʾِb", "root": ""}, {"id": 13, "arabic": "مُسْلِمُونَ", "translit": "َnwُmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 112, "text": "إِذْ قَالَ ٱلْحَوَارِيُّونَ يَٰعِيسَى ٱبْنَ مَرْيَمَ هَلْ يَسْتَطِيعُ رَبُّكَ أَن يُنَزِّلَ عَلَيْنَا مَآئِدَةً مِّنَ ٱلسَّمَآءِۖ قَالَ ٱتَّقُوا۟ ٱللَّهَ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "[And remember] when the disciples said, \"O Jesus, Son of Mary, can your Lord[1] send down to us a table [spread with food] from the heaven?\" [Jesus] said, \"Fear Allāh, if you should be believers.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "ٱلْحَوَارِيُّونَ", "translit": "َnwُّyِrāَwَḥْlٱ", "root": "حور"}, {"id": 4, "arabic": "يَٰعِيسَى", "translit": "àَsyِʿعَٰy", "root": ""}, {"id": 5, "arabic": "ٱبْنَ", "translit": "َnْbٱ", "root": "بني"}, {"id": 6, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 7, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 8, "arabic": "يَسْتَطِيعُ", "translit": "ُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 9, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "يُنَزِّلَ", "translit": "َlِّzَnُy", "root": "نزل"}, {"id": 12, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 13, "arabic": "مَآئِدَةً", "translit": "ًẗَdِyʾٓāَm", "root": "ميد"}, {"id": 14, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 15, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 16, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 17, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 18, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 20, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 21, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": false}, {"ayah": 113, "text": "قَالُوا۟ نُرِيدُ أَن نَّأْكُلَ مِنْهَا وَتَطْمَئِنَّ قُلُوبُنَا وَنَعْلَمَ أَن قَدْ صَدَقْتَنَا وَنَكُونَ عَلَيْهَا مِنَ ٱلشَّٰهِدِينَ ", "translation": "They said, \"We wish to eat from it and let our hearts be reassured and know that you have been truthful to us and be among its witnesses.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "نُرِيدُ", "translit": "ُdyِrُn", "root": "رود"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "نَّأْكُلَ", "translit": "َlُkْaʾَّn", "root": "اكل"}, {"id": 5, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 6, "arabic": "وَتَطْمَئِنَّ", "translit": "َّnِyʾَmْṭَtَw", "root": "طمان"}, {"id": 7, "arabic": "قُلُوبُنَا", "translit": "āَnُbwُlُq", "root": "قلب"}, {"id": 8, "arabic": "وَنَعْلَمَ", "translit": "َmَlْʿعَnَw", "root": "علم"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 11, "arabic": "صَدَقْتَنَا", "translit": "āَnَtْqَdَṣ", "root": "صدق"}, {"id": 12, "arabic": "وَنَكُونَ", "translit": "َnwُkَnَw", "root": "كون"}, {"id": 13, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلشَّٰهِدِينَ", "translit": "َnyِdِhَّٰhslٱ", "root": "شهد"}], "hasIhya": false}, {"ayah": 114, "text": "قَالَ عِيسَى ٱبْنُ مَرْيَمَ ٱللَّهُمَّ رَبَّنَآ أَنزِلْ عَلَيْنَا مَآئِدَةً مِّنَ ٱلسَّمَآءِ تَكُونُ لَنَا عِيدًا لِّأَوَّلِنَا وَءَاخِرِنَا وَءَايَةً مِّنكَۖ وَٱرْزُقْنَا وَأَنتَ خَيْرُ ٱلرَّٰزِقِينَ ", "translation": "Said Jesus, the son of Mary, \"O Allāh, our Lord, send down to us a table [spread with food] from the heaven to be for us a festival for the first of us and the last of us and a sign from You. And provide for us, and You are the best of providers.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "عِيسَى", "translit": "àَsyِʿع", "root": ""}, {"id": 3, "arabic": "ٱبْنُ", "translit": "ُnْbٱ", "root": "بني"}, {"id": 4, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 5, "arabic": "ٱللَّهُمَّ", "translit": "َّmُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 7, "arabic": "أَنزِلْ", "translit": "ْlِznَaʾ", "root": "نزل"}, {"id": 8, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 9, "arabic": "مَآئِدَةً", "translit": "ًẗَdِyʾٓāَm", "root": "ميد"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 12, "arabic": "تَكُونُ", "translit": "ُnwُkَt", "root": "كون"}, {"id": 13, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 14, "arabic": "عِيدًا", "translit": "āًdyِʿع", "root": "عود"}, {"id": 15, "arabic": "لِّأَوَّلِنَا", "translit": "āَnِlَّwَaʾِّl", "root": "اول"}, {"id": 16, "arabic": "وَءَاخِرِنَا", "translit": "āَnِrِhkāَءَw", "root": "اخر"}, {"id": 17, "arabic": "وَءَايَةً", "translit": "ًẗَyāَءَw", "root": "ايي"}, {"id": 18, "arabic": "مِّنكَ", "translit": "َknِّm", "root": ""}, {"id": 19, "arabic": "وَٱرْزُقْنَا", "translit": "āَnْqُzْrٱَw", "root": "رزق"}, {"id": 20, "arabic": "وَأَنتَ", "translit": "َtnَaʾَw", "root": ""}, {"id": 21, "arabic": "خَيْرُ", "translit": "ُrْyَhk", "root": "خير"}, {"id": 22, "arabic": "ٱلرَّٰزِقِينَ", "translit": "َnyِqِzَّٰrlٱ", "root": "رزق"}], "hasIhya": true}, {"ayah": 115, "text": "قَالَ ٱللَّهُ إِنِّى مُنَزِّلُهَا عَلَيْكُمْۖ فَمَن يَكْفُرْ بَعْدُ مِنكُمْ فَإِنِّىٓ أُعَذِّبُهُۥ عَذَابًا لَّآ أُعَذِّبُهُۥٓ أَحَدًا مِّنَ ٱلْعَٰلَمِينَ ", "translation": "Allāh said, \"Indeed, I will send it down to you, but whoever disbelieves afterwards from among you - then indeed will I punish him with a punishment by which I have not punished anyone among the worlds.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 4, "arabic": "مُنَزِّلُهَا", "translit": "āَhُlِّzَnُm", "root": "نزل"}, {"id": 5, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 7, "arabic": "يَكْفُرْ", "translit": "ْrُfْkَy", "root": "كفر"}, {"id": 8, "arabic": "بَعْدُ", "translit": "ُdْʿعَb", "root": "بعد"}, {"id": 9, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 10, "arabic": "فَإِنِّىٓ", "translit": "ٓàِّnِiʾَf", "root": ""}, {"id": 11, "arabic": "أُعَذِّبُهُۥ", "translit": "ۥُhُbِّhdَʿعُaʾ", "root": "عذب"}, {"id": 12, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 13, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 14, "arabic": "أُعَذِّبُهُۥٓ", "translit": "ٓۥُhُbِّhdَʿعُaʾ", "root": "عذب"}, {"id": 15, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}, {"id": 16, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 17, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 116, "text": "وَإِذْ قَالَ ٱللَّهُ يَٰعِيسَى ٱبْنَ مَرْيَمَ ءَأَنتَ قُلْتَ لِلنَّاسِ ٱتَّخِذُونِى وَأُمِّىَ إِلَٰهَيْنِ مِن دُونِ ٱللَّهِۖ قَالَ سُبْحَٰنَكَ مَا يَكُونُ لِىٓ أَنْ أَقُولَ مَا لَيْسَ لِى بِحَقٍّۚ إِن كُنتُ قُلْتُهُۥ فَقَدْ عَلِمْتَهُۥۚ تَعْلَمُ مَا فِى نَفْسِى وَلَآ أَعْلَمُ مَا فِى نَفْسِكَۚ إِنَّكَ أَنتَ عَلَّٰمُ ٱلْغُيُوبِ ", "translation": "And [beware the Day] when Allāh will say, \"O Jesus, Son of Mary, did you say to the people, 'Take me and my mother as deities besides Allāh?'\" He will say, \"Exalted are You! It was not for me to say that to which I have no right. If I had said it, You would have known it. You know what is within myself, and I do not know what is within Yourself. Indeed, it is You who is Knower of the unseen.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "يَٰعِيسَى", "translit": "àَsyِʿعَٰy", "root": ""}, {"id": 5, "arabic": "ٱبْنَ", "translit": "َnْbٱ", "root": "بني"}, {"id": 6, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 7, "arabic": "ءَأَنتَ", "translit": "َtnَaʾَء", "root": ""}, {"id": 8, "arabic": "قُلْتَ", "translit": "َtْlُq", "root": "قول"}, {"id": 9, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 10, "arabic": "ٱتَّخِذُونِى", "translit": "àِnwُhdِhkَّtٱ", "root": "اخذ"}, {"id": 11, "arabic": "وَأُمِّىَ", "translit": "َàِّmُaʾَw", "root": "امم"}, {"id": 12, "arabic": "إِلَٰهَيْنِ", "translit": "ِnْyَhَٰlِiʾ", "root": "اله"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّ