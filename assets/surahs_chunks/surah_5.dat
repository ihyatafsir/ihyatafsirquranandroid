ٱلْقِسْطِۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُقْسِطِينَ ","translation":"[They are] avid listeners to falsehood, devourers of [what is] unlawful. So if they come to you, [O Muḥammad], judge between them or turn away from them. And if you turn away from them - never will they harm you at all. And if you judge, judge between them with justice. Indeed, Allāh loves those who act justly.","words":[{"id":1,"arabic":"سَمَّٰعُونَ","translit":"َnwُʿعَّٰmَs","root":"سمع"},{"id":2,"arabic":"لِلْكَذِبِ","translit":"ِbِhdَkْlِl","root":"كذب"},{"id":3,"arabic":"أَكَّٰلُونَ","translit":"َnwُlَّٰkَaʾ","root":"اكل"},{"id":4,"arabic":"لِلسُّحْتِ","translit":"ِtْḥُّslِl","root":"سحت"},{"id":5,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":6,"arabic":"جَآءُوكَ","translit":"َkwُءٓāَjg","root":"جيا"},{"id":7,"arabic":"فَٱحْكُم","translit":"mُkْḥٱَf","root":"حكم"},{"id":8,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":9,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":10,"arabic":"أَعْرِضْ","translit":"ْḍِrْʿعَaʾ","root":"عرض"},{"id":11,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":12,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":13,"arabic":"تُعْرِضْ","translit":"ْḍِrْʿعُt","root":"عرض"},{"id":14,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":15,"arabic":"فَلَن","translit":"nَlَf","root":""},{"id":16,"arabic":"يَضُرُّوكَ","translit":"َkwُّrُḍَy","root":"ضرر"},{"id":17,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":18,"arabic":"وَإِنْ","translit":"ْnِiʾَw","root":""},{"id":19,"arabic":"حَكَمْتَ","translit":"َtْmَkَḥ","root":"حكم"},{"id":20,"arabic":"فَٱحْكُم","translit":"mُkْḥٱَf","root":"حكم"},{"id":21,"arabic":"بَيْنَهُم","translit":"mُhَnْyَb","root":"بين"},{"id":22,"arabic":"بِٱلْقِسْطِ","translit":"ِṭْsِqْlٱِb","root":"قسط"},{"id":23,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":24,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":25,"arabic":"يُحِبُّ","translit":"ُّbِḥُy","root":"حبب"},{"id":26,"arabic":"ٱلْمُقْسِطِينَ","translit":"َnyِṭِsْqُmْlٱ","root":"قسط"}],"hasIhya":true},{"ayah":43,"text":"وَكَيْفَ يُحَكِّمُونَكَ وَعِندَهُمُ ٱلتَّوْرَىٰةُ فِيهَا حُكْمُ ٱللَّهِ ثُمَّ يَتَوَلَّوْنَ مِنۢ بَعْدِ ذَٰلِكَۚ وَمَآ أُو۟لَٰٓئِكَ بِٱلْمُؤْمِنِينَ ","translation":"But how is it that they come to you for judgement while they have the Torah, in which is the judgement of Allāh? Then they turn away, [even] after that; but those are not [in fact] believers.","words":[{"id":1,"arabic":"وَكَيْفَ","translit":"َfْyَkَw","root":"كيف"},{"id":2,"arabic":"يُحَكِّمُونَكَ","translit":"َkَnwُmِّkَḥُy","root":"حكم"},{"id":3,"arabic":"وَعِندَهُمُ","translit":"ُmُhَdnِʿعَw","root":"عند"},{"id":4,"arabic":"ٱلتَّوْرَىٰةُ","translit":"ُẗٰàَrْwَّtlٱ","root":""},{"id":5,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":6,"arabic":"حُكْمُ","translit":"ُmْkُḥ","root":"حكم"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":9,"arabic":"يَتَوَلَّوْنَ","translit":"َnْwَّlَwَtَy","root":"ولي"},{"id":10,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":11,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":14,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":15,"arabic":"بِٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱِb","root":"امن"}],"hasIhya":false},{"ayah":44,"text":"إِنَّآ أَنزَلْنَا ٱلتَّوْرَىٰةَ فِيهَا هُدًى وَنُورٌۚ يَحْكُمُ بِهَا ٱلنَّبِيُّونَ ٱلَّذِينَ أَسْلَمُوا۟ لِلَّذِينَ هَادُوا۟ وَٱلرَّبَّٰنِيُّونَ وَٱلْأَحْبَارُ بِمَا ٱسْتُحْفِظُوا۟ مِن كِتَٰبِ ٱللَّهِ وَكَانُوا۟ عَلَيْهِ شُهَدَآءَۚ فَلَا تَخْشَوُا۟ ٱلنَّاسَ وَٱخْشَوْنِ وَلَا تَشْتَرُوا۟ بِـَٔايَٰتِى ثَمَنًا قَلِيلًاۚ وَمَن لَّمْ يَحْكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُو۟لَٰٓئِكَ هُمُ ٱلْكَٰفِرُونَ ","translation":"Indeed, We sent down the Torah, in which was guidance and light. The prophets who submitted [to Allāh] judged by it for the Jews, as did the rabbis and scholars by that with which they were entrusted of the Scripture of Allāh, and they were witnesses thereto. So do not fear the people but fear Me, and do not exchange My verses for a small price [i.e., worldly gain]. And whoever does not judge by what Allāh has revealed - then it is those who are the disbelievers.","words":[{"id":1,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":2,"arabic":"أَنزَلْنَا","translit":"āَnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"ٱلتَّوْرَىٰةَ","translit":"َẗٰàَrْwَّtlٱ","root":""},{"id":4,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":5,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"},{"id":6,"arabic":"وَنُورٌ","translit":"ٌrwُnَw","root":"نور"},{"id":7,"arabic":"يَحْكُمُ","translit":"ُmُkْḥَy","root":"حكم"},{"id":8,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":9,"arabic":"ٱلنَّبِيُّونَ","translit":"َnwُّyِbَّnlٱ","root":"نبا"},{"id":10,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":11,"arabic":"أَسْلَمُوا۟","translit":"۟āwُmَlْsَaʾ","root":"سلم"},{"id":12,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":13,"arabic":"هَادُوا۟","translit":"۟āwُdāَh","root":"هود"},{"id":14,"arabic":"وَٱلرَّبَّٰنِيُّونَ","translit":"َnwُّyِnَّٰbَّrlٱَw","root":"ربب"},{"id":15,"arabic":"وَٱلْأَحْبَارُ","translit":"ُrāَbْḥَaʾْlٱَw","root":"حبر"},{"id":16,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":17,"arabic":"ٱسْتُحْفِظُوا۟","translit":"۟āwُẓِfْḥُtْsٱ","root":"حفظ"},{"id":18,"arabic":"مِن","translit":"nِm","root":""},{"id":19,"arabic":"كِتَٰبِ","translit":"ِbَٰtِk","root":"كتب"},{"id":20,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":21,"arabic":"وَكَانُوا۟","translit":"۟āwُnāَkَw","root":"كون"},{"id":22,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":23,"arabic":"شُهَدَآءَ","translit":"َءٓāَdَhُhs","root":"شهد"},{"id":24,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":25,"arabic":"تَخْشَوُا۟","translit":"۟āُwَhsْhkَt","root":"خشي"},{"id":26,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":27,"arabic":"وَٱخْشَوْنِ","translit":"ِnْwَhsْhkٱَw","root":"خشي"},{"id":28,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":29,"arabic":"تَشْتَرُوا۟","translit":"۟āwُrَtْhsَt","root":"شري"},{"id":30,"arabic":"بِـَٔايَٰتِى","translit":"àِtَٰyāَٔـِb","root":"ايي"},{"id":31,"arabic":"ثَمَنًا","translit":"āًnَmَht","root":"ثمن"},{"id":32,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":33,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":34,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":35,"arabic":"يَحْكُم","translit":"mُkْḥَy","root":"حكم"},{"id":36,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":37,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":38,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":39,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":40,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":41,"arabic":"ٱلْكَٰفِرُونَ","translit":"َnwُrِfَٰkْlٱ","root":"كفر"}],"hasIhya":false},{"ayah":45,"text":"وَكَتَبْنَا عَلَيْهِمْ فِيهَآ أَنَّ ٱلنَّفْسَ بِٱلنَّفْسِ وَٱلْعَيْنَ بِٱلْعَيْنِ وَٱلْأَنفَ بِٱلْأَنفِ وَٱلْأُذُنَ بِٱلْأُذُنِ وَٱلسِّنَّ بِٱلسِّنِّ وَٱلْجُرُوحَ قِصَاصٌۚ فَمَن تَصَدَّقَ بِهِۦ فَهُوَ كَفَّارَةٌ لَّهُۥۚ وَمَن لَّمْ يَحْكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُو۟لَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ ","translation":"And We ordained for them therein a life for a life, an eye for an eye, a nose for a nose, an ear for an ear, a tooth for a tooth, and for wounds is legal retribution. But whoever gives [up his right as] charity, it is an expiation for him. And whoever does not judge by what Allāh has revealed - then it is those who are the wrongdoers [i.e., the unjust].","words":[{"id":1,"arabic":"وَكَتَبْنَا","translit":"āَnْbَtَkَw","root":"كتب"},{"id":2,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":3,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":4,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":5,"arabic":"ٱلنَّفْسَ","translit":"َsْfَّnlٱ","root":"نفس"},{"id":6,"arabic":"بِٱلنَّفْسِ","translit":"ِsْfَّnlٱِb","root":"نفس"},{"id":7,"arabic":"وَٱلْعَيْنَ","translit":"َnْyَʿعْlٱَw","root":"عين"},{"id":8,"arabic":"بِٱلْعَيْنِ","translit":"ِnْyَʿعْlٱِb","root":"عين"},{"id":9,"arabic":"وَٱلْأَنفَ","translit":"َfnَaʾْlٱَw","root":"انف"},{"id":10,"arabic":"بِٱلْأَنفِ","translit":"ِfnَaʾْlٱِb","root":"انف"},{"id":11,"arabic":"وَٱلْأُذُنَ","translit":"َnُhdُaʾْlٱَw","root":"اذن"},{"id":12,"arabic":"بِٱلْأُذُنِ","translit":"ِnُhdُaʾْlٱِb","root":"اذن"},{"id":13,"arabic":"وَٱلسِّنَّ","translit":"َّnِّslٱَw","root":"سنن"},{"id":14,"arabic":"بِٱلسِّنِّ","translit":"ِّnِّslٱِb","root":"سنن"},{"id":15,"arabic":"وَٱلْجُرُوحَ","translit":"َḥwُrُjgْlٱَw","root":"جرح"},{"id":16,"arabic":"قِصَاصٌ","translit":"ٌṣāَṣِq","root":"قصص"},{"id":17,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":18,"arabic":"تَصَدَّقَ","translit":"َqَّdَṣَt","root":"صدق"},{"id":19,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":20,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":21,"arabic":"كَفَّارَةٌ","translit":"ٌẗَrāَّfَk","root":"كفر"},{"id":22,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":23,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":24,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":25,"arabic":"يَحْكُم","translit":"mُkْḥَy","root":"حكم"},{"id":26,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":27,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":28,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":29,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":30,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":31,"arabic":"ٱلظَّٰلِمُونَ","translit":"َnwُmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":true},{"ayah":46,"text":"وَقَفَّيْنَا عَلَىٰٓ ءَاثَٰرِهِم بِعِيسَى ٱبْنِ مَرْيَمَ مُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ مِنَ ٱلتَّوْرَىٰةِۖ وَءَاتَيْنَٰهُ ٱلْإِنجِيلَ فِيهِ هُدًى وَنُورٌ وَمُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ مِنَ ٱلتَّوْرَىٰةِ وَهُدًى وَمَوْعِظَةً لِّلْمُتَّقِينَ ","translation":"And We sent, following in their footsteps,[1] Jesus, the son of Mary, confirming that which came before him in the Torah; and We gave him the Gospel, in which was guidance and light and confirming that which preceded it of the Torah as guidance and instruction for the righteous.","words":[{"id":1,"arabic":"وَقَفَّيْنَا","translit":"āَnْyَّfَqَw","root":"قفو"},{"id":2,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":3,"arabic":"ءَاثَٰرِهِم","translit":"mِhِrَٰhtāَء","root":"اثر"},{"id":4,"arabic":"بِعِيسَى","translit":"àَsyِʿعِb","root":""},{"id":5,"arabic":"ٱبْنِ","translit":"ِnْbٱ","root":"بني"},{"id":6,"arabic":"مَرْيَمَ","translit":"َmَyْrَm","root":""},{"id":7,"arabic":"مُصَدِّقًا","translit":"āًqِّdَṣُm","root":"صدق"},{"id":8,"arabic":"لِّمَا","translit":"āَmِّl","root":""},{"id":9,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":10,"arabic":"يَدَيْهِ","translit":"ِhْyَdَy","root":"يدي"},{"id":11,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":12,"arabic":"ٱلتَّوْرَىٰةِ","translit":"ِẗٰàَrْwَّtlٱ","root":""},{"id":13,"arabic":"وَءَاتَيْنَٰهُ","translit":"ُhَٰnْyَtāَءَw","root":"اتي"},{"id":14,"arabic":"ٱلْإِنجِيلَ","translit":"َlyِjgnِiʾْlٱ","root":""},{"id":15,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":16,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"},{"id":17,"arabic":"وَنُورٌ","translit":"ٌrwُnَw","root":"نور"},{"id":18,"arabic":"وَمُصَدِّقًا","translit":"āًqِّdَṣُmَw","root":"صدق"},{"id":19,"arabic":"لِّمَا","translit":"āَmِّl","root":""},{"id":20,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":21,"arabic":"يَدَيْهِ","translit":"ِhْyَdَy","root":"يدي"},{"id":22,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":23,"arabic":"ٱلتَّوْرَىٰةِ","translit":"ِẗٰàَrْwَّtlٱ","root":""},{"id":24,"arabic":"وَهُدًى","translit":"àًdُhَw","root":"هدي"},{"id":25,"arabic":"وَمَوْعِظَةً","translit":"ًẗَẓِʿعْwَmَw","root":"وعظ"},{"id":26,"arabic":"لِّلْمُتَّقِينَ","translit":"َnyِqَّtُmْlِّl","root":"وقي"}],"hasIhya":false},{"ayah":47,"text":"وَلْيَحْكُمْ أَهْلُ ٱلْإِنجِيلِ بِمَآ أَنزَلَ ٱللَّهُ فِيهِۚ وَمَن لَّمْ يَحْكُم بِمَآ أَنزَلَ ٱللَّهُ فَأُو۟لَٰٓئِكَ هُمُ ٱلْفَٰسِقُونَ ","translation":"And let the People of the Gospel judge by what Allāh has revealed therein. And whoever does not judge by what Allāh has revealed - then it is those who are the defiantly disobedient.","words":[{"id":1,"arabic":"وَلْيَحْكُمْ","translit":"ْmُkْḥَyْlَw","root":"حكم"},{"id":2,"arabic":"أَهْلُ","translit":"ُlْhَaʾ","root":"اهل"},{"id":3,"arabic":"ٱلْإِنجِيلِ","translit":"ِlyِjgnِiʾْlٱ","root":""},{"id":4,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":5,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":8,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":9,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":10,"arabic":"يَحْكُم","translit":"mُkْḥَy","root":"حكم"},{"id":11,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":12,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":13,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":14,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":15,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":16,"arabic":"ٱلْفَٰسِقُونَ","translit":"َnwُqِsَٰfْlٱ","root":"فسق"}],"hasIhya":false},{"ayah":48,"text":"وَأَنزَلْنَآ إِلَيْكَ ٱلْكِتَٰبَ بِٱلْحَقِّ مُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ مِنَ ٱلْكِتَٰبِ وَمُهَيْمِنًا عَلَيْهِۖ فَٱحْكُم بَيْنَهُم بِمَآ أَنزَلَ ٱللَّهُۖ وَلَا تَتَّبِعْ أَهْوَآءَهُمْ عَمَّا جَآءَكَ مِنَ ٱلْحَقِّۚ لِكُلٍّ جَعَلْنَا مِنكُمْ شِرْعَةً وَمِنْهَاجًاۚ وَلَوْ شَآءَ ٱللَّهُ لَجَعَلَكُمْ أُمَّةً وَٰحِدَةً وَلَٰكِن لِّيَبْلُوَكُمْ فِى مَآ ءَاتَىٰكُمْۖ فَٱسْتَبِقُوا۟ ٱلْخَيْرَٰتِۚ إِلَى ٱللَّهِ مَرْجِعُكُمْ جَمِيعًا فَيُنَبِّئُكُم بِمَا كُنتُمْ فِيهِ تَخْتَلِفُونَ ","translation":"And We have revealed to you, [O Muḥammad], the Book [i.e., the Qur’ān] in truth, confirming that which preceded it of the Scripture and as a criterion over it. So judge between them by what Allāh has revealed and do not follow their inclinations away from what has come to you of the truth. To each of you We prescribed a law and a method.[1] Had Allāh willed, He would have made you one nation [united in religion], but [He intended] to test you in what He has given you; so race to [all that is] good.[2] To Allāh is your return all together, and He will [then] inform you concerning that over which you used to differ.","words":[{"id":1,"arabic":"وَأَنزَلْنَآ","translit":"ٓāَnْlَznَaʾَw","root":"نزل"},{"id":2,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":3,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":4,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":5,"arabic":"مُصَدِّقًا","translit":"āًqِّdَṣُm","root":"صدق"},{"id":6,"arabic":"لِّمَا","translit":"āَmِّl","root":""},{"id":7,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":8,"arabic":"يَدَيْهِ","translit":"ِhْyَdَy","root":"يدي"},{"id":9,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":10,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":11,"arabic":"وَمُهَيْمِنًا","translit":"āًnِmْyَhُmَw","root":"همن"},{"id":12,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":13,"arabic":"فَٱحْكُم","translit":"mُkْḥٱَf","root":"حكم"},{"id":14,"arabic":"بَيْنَهُم","translit":"mُhَnْyَb","root":"بين"},{"id":15,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":16,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":17,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":18,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":19,"arabic":"تَتَّبِعْ","translit":"ْʿعِbَّtَt","root":"تبع"},{"id":20,"arabic":"أَهْوَآءَهُمْ","translit":"ْmُhَءٓāَwْhَaʾ","root":"هوي"},{"id":21,"arabic":"عَمَّا","translit":"āَّmَʿع","root":""},{"id":22,"arabic":"جَآءَكَ","translit":"َkَءٓāَjg","root":"جيا"},{"id":23,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":24,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":25,"arabic":"لِكُلٍّ","translit":"ٍّlُkِl","root":"كلل"},{"id":26,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":27,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":28,"arabic":"شِرْعَةً","translit":"ًẗَʿعْrِhs","root":"شرع"},{"id":29,"arabic":"وَمِنْهَاجًا","translit":"āًjgāَhْnِmَw","root":"نهج"},{"id":30,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":31,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":32,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":33,"arabic":"لَجَعَلَكُمْ","translit":"ْmُkَlَʿعَjgَl","root":"جعل"},{"id":34,"arabic":"أُمَّةً","translit":"ًẗَّmُaʾ","root":"امم"},{"id":35,"arabic":"وَٰحِدَةً","translit":"ًẗَdِḥَٰw","root":"وحد"},{"id":36,"arabic":"وَلَٰكِن","translit":"nِkَٰlَw","root":""},{"id":37,"arabic":"لِّيَبْلُوَكُمْ","translit":"ْmُkَwُlْbَyِّl","root":"بلو"},{"id":38,"arabic":"فِى","translit":"àِf","root":""},{"id":39,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":40,"arabic":"ءَاتَىٰكُمْ","translit":"ْmُkٰàَtāَء","root":"اتي"},{"id":41,"arabic":"فَٱسْتَبِقُوا۟","translit":"۟āwُqِbَtْsٱَf","root":"سبق"},{"id":42,"arabic":"ٱلْخَيْرَٰتِ","translit":"ِtَٰrْyَhkْlٱ","root":"خير"},{"id":43,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":44,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":45,"arabic":"مَرْجِعُكُمْ","translit":"ْmُkُʿعِjgْrَm","root":"رجع"},{"id":46,"arabic":"جَمِيعًا","translit":"āًʿعyِmَjg","root":"جمع"},{"id":47,"arabic":"فَيُنَبِّئُكُم","translit":"mُkُyʾِّbَnُyَf","root":"نبا"},{"id":48,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":49,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":50,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":51,"arabic":"تَخْتَلِفُونَ","translit":"َnwُfِlَtْhkَt","root":"خلف"}],"hasIhya":true},{"ayah":49,"text":"وَأَنِ ٱحْكُم بَيْنَهُم بِمَآ أَنزَلَ ٱللَّهُ وَلَا تَتَّبِعْ أَهْوَآءَهُمْ وَٱحْذَرْهُمْ أَن يَفْتِنُوكَ عَنۢ بَعْضِ مَآ أَنزَلَ ٱللَّهُ إِلَيْكَۖ فَإِن تَوَلَّوْا۟ فَٱعْلَمْ أَنَّمَا يُرِيدُ ٱللَّهُ أَن يُصِيبَهُم بِبَعْضِ ذُنُوبِهِمْۗ وَإِنَّ كَثِيرًا مِّنَ ٱلنَّاسِ لَفَٰسِقُونَ ","translation":"And judge, [O Muḥammad], between them by what Allāh has revealed and do not follow their inclinations and beware of them, lest they tempt you away from some of what Allāh has revealed to you. And if they turn away - then know that Allāh only intends to afflict them with some of their [own] sins. And indeed, many among the people are defiantly disobedient.","words":[{"id":1,"arabic":"وَأَنِ","translit":"ِnَaʾَw","root":""},{"id":2,"arabic":"ٱحْكُم","translit":"mُkْḥٱ","root":"حكم"},{"id":3,"arabic":"بَيْنَهُم","translit":"mُhَnْyَb","root":"بين"},{"id":4,"arabic":"بِمَآ","translit":"ٓāَmِb","root":""},{"id":5,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":8,"arabic":"تَتَّبِعْ","translit":"ْʿعِbَّtَt","root":"تبع"},{"id":9,"arabic":"أَهْوَآءَهُمْ","translit":"ْmُhَءٓāَwْhَaʾ","root":"هوي"},{"id":10,"arabic":"وَٱحْذَرْهُمْ","translit":"ْmُhْrَhdْḥٱَw","root":"حذر"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يَفْتِنُوكَ","translit":"َkwُnِtْfَy","root":"فتن"},{"id":13,"arabic":"عَنۢ","translit":"ۢnَʿع","root":""},{"id":14,"arabic":"بَعْضِ","translit":"ِḍْʿعَb","root":"بعض"},{"id":15,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":16,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":17,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":18,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":19,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":20,"arabic":"تَوَلَّوْا۟","translit":"۟āْwَّlَwَt","root":"ولي"},{"id":21,"arabic":"فَٱعْلَمْ","translit":"ْmَlْʿعٱَf","root":"علم"},{"id":22,"arabic":"أَنَّمَا","translit":"āَmَّnَaʾ","root":""},{"id":23,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":24,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":25,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":26,"arabic":"يُصِيبَهُم","translit":"mُhَbyِṣُy","root":"صوب"},{"id":27,"arabic":"بِبَعْضِ","translit":"ِḍْʿعَbِb","root":"بعض"},{"id":28,"arabic":"ذُنُوبِهِمْ","translit":"ْmِhِbwُnُhd","root":"ذنب"},{"id":29,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":30,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":31,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":32,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":33,"arabic":"لَفَٰسِقُونَ","translit":"َnwُqِsَٰfَl","root":"فسق"}],"hasIhya":false},{"ayah":50,"text":"أَفَحُكْمَ ٱلْجَٰهِلِيَّةِ يَبْغُونَۚ وَمَنْ أَحْسَنُ مِنَ ٱللَّهِ حُكْمًا لِّقَوْمٍ يُوقِنُونَ ","translation":"Then is it the judgement of [the time of] ignorance they desire? But who is better than Allāh in judgement for a people who are certain [in faith].","words":[{"id":1,"arabic":"أَفَحُكْمَ","translit":"َmْkُḥَfَaʾ","root":"حكم"},{"id":2,"arabic":"ٱلْجَٰهِلِيَّةِ","translit":"ِẗَّyِlِhَٰjgْlٱ","root":"جهل"},{"id":3,"arabic":"يَبْغُونَ","translit":"َnwُغْbَy","root":"بغي"},{"id":4,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":5,"arabic":"أَحْسَنُ","translit":"ُnَsْḥَaʾ","root":"حسن"},{"id":6,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"حُكْمًا","translit":"āًmْkُḥ","root":"حكم"},{"id":9,"arabic":"لِّقَوْمٍ","translit":"ٍmْwَqِّl","root":"قوم"},{"id":10,"arabic":"يُوقِنُونَ","translit":"َnwُnِqwُy","root":"يقن"}],"hasIhya":false},{"ayah":51,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوا۟ ٱلْيَهُودَ وَٱلنَّصَٰرَىٰٓ أَوْلِيَآءَۘ بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۚ وَمَن يَتَوَلَّهُم مِّنكُمْ فَإِنَّهُۥ مِنْهُمْۗ إِنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّٰلِمِينَ ","translation":"O you who have believed, do not take the Jews and the Christians as allies. They are [in fact] allies of one another. And whoever is an ally to them among you - then indeed, he is [one] of them. Indeed, Allāh guides not the wrongdoing people.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"تَتَّخِذُوا۟","translit":"۟āwُhdِhkَّtَt","root":"اخذ"},{"id":6,"arabic":"ٱلْيَهُودَ","translit":"َdwُhَyْlٱ","root":"هود"},{"id":7,"arabic":"وَٱلنَّصَٰرَىٰٓ","translit":"ٰٓàَrَٰṣَّnlٱَw","root":"نصر"},{"id":8,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":9,"arabic":"بَعْضُهُمْ","translit":"ْmُhُḍْʿعَb","root":"بعض"},{"id":10,"arabic":"أَوْلِيَآءُ","translit":"ُءٓāَyِlْwَaʾ","root":"ولي"},{"id":11,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":12,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":13,"arabic":"يَتَوَلَّهُم","translit":"mُhَّlَwَtَy","root":"ولي"},{"id":14,"arabic":"مِّنكُمْ","translit":"ْmُknِّm","root":""},{"id":15,"arabic":"فَإِنَّهُۥ","translit":"ۥُhَّnِiʾَf","root":""},{"id":16,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":17,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":18,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":19,"arabic":"لَا","translit":"āَl","root":""},{"id":20,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":21,"arabic":"ٱلْقَوْمَ","translit":"َmْwَqْlٱ","root":"قوم"},{"id":22,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"}],"hasIhya":true},{"ayah":52,"text":"فَتَرَى ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ يُسَٰرِعُونَ فِيهِمْ يَقُولُونَ نَخْشَىٰٓ أَن تُصِيبَنَا دَآئِرَةٌۚ فَعَسَى ٱللَّهُ أَن يَأْتِىَ بِٱلْفَتْحِ أَوْ أَمْرٍ مِّنْ عِندِهِۦ فَيُصْبِحُوا۟ عَلَىٰ مَآ أَسَرُّوا۟ فِىٓ أَنفُسِهِمْ نَٰدِمِينَ ","translation":"So you see those in whose hearts is disease [i.e., hypocrisy] hastening into [association with] them, saying, \"We are afraid a misfortune may strike us.\" But perhaps Allāh will bring conquest or a decision from Him, and they will become, over what they have been concealing within themselves, regretful.","words":[{"id":1,"arabic":"فَتَرَى","translit":"àَrَtَf","root":"راي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"قُلُوبِهِم","translit":"mِhِbwُlُq","root":"قلب"},{"id":5,"arabic":"مَّرَضٌ","translit":"ٌḍَrَّm","root":"مرض"},{"id":6,"arabic":"يُسَٰرِعُونَ","translit":"َnwُʿعِrَٰsُy","root":"سرع"},{"id":7,"arabic":"فِيهِمْ","translit":"ْmِhyِf","root":""},{"id":8,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":9,"arabic":"نَخْشَىٰٓ","translit":"ٰٓàَhsْhkَn","root":"خشي"},{"id":10,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":11,"arabic":"تُصِيبَنَا","translit":"āَnَbyِṣُt","root":"صوب"},{"id":12,"arabic":"دَآئِرَةٌ","translit":"ٌẗَrِyʾٓāَd","root":"دور"},{"id":13,"arabic":"فَعَسَى","translit":"àَsَʿعَf","root":"عسي"},{"id":14,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":15,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":16,"arabic":"يَأْتِىَ","translit":"َàِtْaʾَy","root":"اتي"},{"id":17,"arabic":"بِٱلْفَتْحِ","translit":"ِḥْtَfْlٱِb","root":"فتح"},{"id":18,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":19,"arabic":"أَمْرٍ","translit":"ٍrْmَaʾ","root":"امر"},{"id":20,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":21,"arabic":"عِندِهِۦ","translit":"ۦِhِdnِʿع","root":"عند"},{"id":22,"arabic":"فَيُصْبِحُوا۟","translit":"۟āwُḥِbْṣُyَf","root":"صبح"},{"id":23,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":24,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":25,"arabic":"أَسَرُّوا۟","translit":"۟āwُّrَsَaʾ","root":"سرر"},{"id":26,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":27,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":28,"arabic":"نَٰدِمِينَ","translit":"َnyِmِdَٰn","root":"ندم"}],"hasIhya":false},{"ayah":53,"text":"وَيَقُولُ ٱلَّذِينَ ءَامَنُوٓا۟ أَهَٰٓؤُلَآءِ ٱلَّذِينَ أَقْسَمُوا۟ بِٱللَّهِ جَهْدَ أَيْمَٰنِهِمْۙ إِنَّهُمْ لَمَعَكُمْۚ حَبِطَتْ أَعْمَٰلُهُمْ فَأَصْبَحُوا۟ خَٰسِرِينَ ","translation":"And those who believe will say,[1] \"Are these the ones who swore by Allāh their strongest oaths that indeed they were with you?\" Their deeds have become worthless, and they have become losers.","words":[{"id":1,"arabic":"وَيَقُولُ","translit":"ُlwُqَyَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوٓا۟","translit":"۟āٓwُnَmāَء","root":"امن"},{"id":4,"arabic":"أَهَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓhَaʾ","root":""},{"id":5,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":6,"arabic":"أَقْسَمُوا۟","translit":"۟āwُmَsْqَaʾ","root":"قسم"},{"id":7,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":8,"arabic":"جَهْدَ","translit":"َdْhَjg","root":"جهد"},{"id":9,"arabic":"أَيْمَٰنِهِمْ","translit":"ْmِhِnَٰmْyَaʾ","root":"يمن"},{"id":10,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":11,"arabic":"لَمَعَكُمْ","translit":"ْmُkَʿعَmَl","root":""},{"id":12,"arabic":"حَبِطَتْ","translit":"ْtَṭِbَḥ","root":"حبط"},{"id":13,"arabic":"أَعْمَٰلُهُمْ","translit":"ْmُhُlَٰmْʿعَaʾ","root":"عمل"},{"id":14,"arabic":"فَأَصْبَحُوا۟","translit":"۟āwُḥَbْṣَaʾَf","root":"صبح"},{"id":15,"arabic":"خَٰسِرِينَ","translit":"َnyِrِsَٰhk","root":"خسر"}],"hasIhya":false},{"ayah":54,"text":"يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ مَن يَرْتَدَّ مِنكُمْ عَن دِينِهِۦ فَسَوْفَ يَأْتِى ٱللَّهُ بِقَوْمٍ يُحِبُّهُمْ وَيُحِبُّونَهُۥٓ أَذِلَّةٍ عَلَى ٱلْمُؤْمِنِينَ أَعِزَّةٍ عَلَى ٱلْكَٰفِرِينَ يُجَٰهِدُونَ فِى سَبِيلِ ٱللَّهِ وَلَا يَخَافُونَ لَوْمَةَ لَآئِمٍۚ ذَٰلِكَ فَضْلُ ٱللَّهِ يُؤْتِيهِ مَن يَشَآءُۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ ","translation":"O you who have believed, whoever of you should revert from his religion - Allāh will bring forth [in place of them] a people He will love and who will love Him [who are] humble toward the believers, strong against the disbelievers; they strive in the cause of Allāh and do not fear the blame of a critic. That is the favor of Allāh; He bestows it upon whom He wills. And Allāh is all-Encompassing and Knowing.","words":[{"id":1,"arabic":"يَٰٓأَيُّهَا","translit":"āَhُّyَaʾَٰٓy","root":"ايي"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"مَن","translit":"nَm","root":""},{"id":5,"arabic":"يَرْتَدَّ","translit":"َّdَtْrَy","root":"ردد"},{"id":6,"arabic":"مِنكُمْ","translit":"ْmُknِm","root":""},{"id":7,"arabic":"عَن","translit":"nَʿع","root":""},{"id":8,"arabic":"دِينِهِۦ","translit":"ۦِhِnyِd","root":"دين"},{"id":9,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":10,"arabic":"يَأْتِى","translit":"àِtْaʾَy","root":"اتي"},{"id":11,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":12,"arabic":"بِقَوْمٍ","translit":"ٍmْwَqِb","root":"قوم"},{"id":13,"arabic":"يُحِبُّهُمْ","translit":"ْmُhُّbِḥُy","root":"حبب"},{"id":14,"arabic":"وَيُحِبُّونَهُۥٓ","translit":"ٓۥُhَnwُّbِḥُyَw","root":"حبب"},{"id":15,"arabic":"أَذِلَّةٍ","translit":"ٍẗَّlِhdَaʾ","root":"ذلل"},{"id":16,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":17,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":18,"arabic":"أَعِزَّةٍ","translit":"ٍẗَّzِʿعَaʾ","root":"عزز"},{"id":19,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":20,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"},{"id":21,"arabic":"يُجَٰهِدُونَ","translit":"َnwُdِhَٰjgُy","root":"جهد"},{"id":22,"arabic":"فِى","translit":"àِf","root":""},{"id":23,"arabic":"سَبِيلِ","translit":"ِlyِbَs","root":"سبل"},{"id":24,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":25,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":26,"arabic":"يَخَافُو