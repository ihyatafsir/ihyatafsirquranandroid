: ""}, {"id": 21, "arabic": "خَيْرُ", "translit": "", "root": ""}, {"id": 22, "arabic": "اُ۬لرَّٰزِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 5, "ayah": 115, "text": "قَالَ اَ۬للَّهُ إِنِّے مُنَزِّلُهَا عَلَيْكُمْ فَمَنْ يَّكْفُرْ بَعْدُ مِنكُمْ فَإِنِّيَ أُعَذِّبُهُۥ عَذَاباࣰ لَّآ أُعَذِّبُهُۥٓ أَحَداࣰ مِّنَ اَ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "مُنَزِّلُهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَمَنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَّكْفُرْ", "translit": "", "root": ""}, {"id": 8, "arabic": "بَعْدُ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِنكُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَإِنِّيَ", "translit": "", "root": ""}, {"id": 11, "arabic": "أُعَذِّبُهُۥ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَذَاباࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَّآ", "translit": "", "root": ""}, {"id": 14, "arabic": "أُعَذِّبُهُۥٓ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَحَداࣰ", "translit": "", "root": ""}, {"id": 16, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 5, "ayah": 116, "text": "وَإِذْ قَالَ اَ۬للَّهُ يَٰعِيسَي اَ۪بْنَ مَرْيَمَ ءَآنتَ قُلْتَ لِلنَّاسِ اِ۪تَّخِذُونِے وَأُمِّيَ إِلَٰهَيْنِ مِن دُونِ اِ۬للَّهِۖ قَالَ سُبْحَٰنَكَ مَا يَكُونُ لِيَ أَنَ اَقُولَ مَا لَيْسَ لِے بِحَقٍّۖ اِن كُنتُ قُلْتُهُۥ فَقَدْ عَلِمْتَهُۥۖ تَعْلَمُ مَا فِے نَفْسِے وَلَآ أَعْلَمُ مَا فِے نَفْسِكَۖ إِنَّكَ أَنتَ عَلَّٰمُ اُ۬لْغُيُوبِۖ", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّه