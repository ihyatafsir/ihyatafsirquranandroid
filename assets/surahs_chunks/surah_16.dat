translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 58, "text": "وَإِذَا بُشِّرَ أَحَدُهُم بِالُانث۪يٰ ظَلَّ وَجْهُهُۥ مُسْوَدّاࣰ وَهُوَ كَظِيمࣱ‏", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بُشِّرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَحَدُهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالُانث۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "ظَلَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَجْهُهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُسْوَدّاࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَظِيمࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 59, "text": "يَتَوَٰر۪يٰ مِنَ اَ۬لْقَوْمِ مِن سُوٓءِ مَا بُشِّرَ بِهِۦٓۖ أَيُمْسِكُهُۥ عَلَيٰ هُونٍ اَمْ يَدُسُّهُۥ فِے اِ۬لتُّرَابِۖ أَلَا سَآءَ مَا يَحْكُمُونَۖ", "words": [{"id": 1, "arabic": "يَتَوَٰر۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْقَوْمِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "سُوٓءِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بُشِّرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِهِۦٓۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَيُمْسِكُهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 11, "arabic": "هُونٍ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَدُسُّهُۥ", "translit": "", "root": ""}, {"id": 14, "arabic": "فِے", "translit": "", "root": ""}, {"id": 15, "arabic": "اِ۬لتُّرَابِۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "أَلَا", "translit": "", "root": ""}, {"id": 17, "arabic": "سَآءَ", "translit": "", "root": ""}, {"id": 18, "ara