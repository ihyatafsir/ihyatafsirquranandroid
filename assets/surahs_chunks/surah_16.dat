": 10, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يُنظَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 86, "text": "وَإِذَا رَءَا اَ۬لذِينَ أَشْرَكُواْ شُرَكَآءَهُمْ قَالُواْ رَبَّنَا هَٰٓؤُلَآءِ شُرَكَآؤُنَا اَ۬لذِينَ كُنَّا نَدْعُواْ مِن دُونِكَۖ فَأَلْقَوِاْ اِلَيْهِمُ اُ۬لْقَوْلَ إِنَّكُمْ لَكَٰذِبُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَءَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَشْرَكُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "شُرَكَآءَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "رَبَّنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 9, "arabic": "شُرَكَآؤُنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 11, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 12, "arabic": "نَدْعُواْ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِن", "translit": "", "root": ""}, {"id": 14, "arabic": "دُونِكَۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "فَأَلْقَوِاْ", "translit": "", "root": ""}, {"id": 16, "arabic": "اِلَيْهِمُ", "translit": "", "root": ""}, {"id": 17, "arabic": "اُ۬لْقَوْلَ", "translit": "", "root": ""}, {"id": 18, "arabic": "إِنَّكُمْ", "translit": "", "root": ""}, {"id": 19, "arabic": "لَكَٰذِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 87, "text": "وَأَلْقَوِاْ اِلَي اَ۬للَّهِ يَوْمَئِذٍ اِ۬لسَّلَمَۖ وَضَلَّ عَنْهُم مَّا كَانُواْ يَفْتَرُونَۖ", "words": [{"id": 1, "arabic": "وَأَلْقَوِاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمَئِذٍ", "translit": "", "r