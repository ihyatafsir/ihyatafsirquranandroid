": 122, "text": "وَءَاتَيْنَٰهُ فِے اِ۬لدُّنْي۪ا حَسَنَةࣰۖ وَإِنَّهُۥ فِے اِ۬لَاخِرَةِ لَمِنَ اَ۬لصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "وَءَاتَيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 4, "arabic": "حَسَنَةࣰۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَمِنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 123, "text": "ثُمَّ أَوْحَيْنَآ إِلَيْكَ أَنِ اِ۪تَّبِعْ مِلَّةَ إِبْرَٰهِيمَ حَنِيفاࣰۖ وَمَا كَانَ مِنَ اَ۬لْمُشْرِكِينَۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۪تَّبِعْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِلَّةَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 8, "arabic": "حَنِيفاࣰۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لْمُشْرِكِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 124, "text": "إِنَّمَا جُعِلَ اَ۬لسَّبْتُ عَلَي اَ۬لذِينَ اَ۪خْتَلَفُواْ فِيهِۖ وَإِنَّ رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ اَ۬لْقِيَٰمَةِ فِيمَا كَانُواْ فِيهِ يَخْتَلِفُونَۖ", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جُعِلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّ