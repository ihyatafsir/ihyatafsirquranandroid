arabic": "اَ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 9, "arabic": "مَسَّكُمُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لضُّرُّ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَإِلَيْهِ", "translit": "", "root": ""}, {"id": 12, "arabic": "تَجْـَٔرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 54, "text": "ثُمَّ إِذَا كَشَفَ اَ۬لضُّرَّ عَنكُمُۥٓ إِذَا فَرِيقࣱ مِّنكُم بِرَبِّهِمْ يُشْرِكُونَ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "كَشَفَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لضُّرَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَنكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فَرِيقࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّنكُم", "translit": "", "root": ""}, {"id": 9, "arabic": "بِرَبِّهِمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يُشْرِكُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 55, "text": "لِيَكْفُرُواْ بِمَآ ءَاتَيْنَٰهُمْۖ فَتَمَتَّعُواْۖ فَسَوْفَ تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "لِيَكْفُرُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَاتَيْنَٰهُمْۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَتَمَتَّعُواْۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَسَوْفَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 56, "text": "وَيَجْعَلُونَ لِمَا لَا يَعْلَمُونَ نَصِيباࣰ مِّمَّا رَزَقْنَٰهُمْۖ تَاللَّهِ لَتُسْـَٔلُنَّ عَمَّا كُنتُمْ تَفْتَرُونَۖ", "words": [{"id": 1, "arabic": "وَيَجْعَلُونَ", "translit": "", "root": ""}, {"id": 2, "ara