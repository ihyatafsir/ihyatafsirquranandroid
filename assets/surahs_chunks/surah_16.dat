تَسْتَعْجِلُوهُۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "سُبْحَٰنَهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَتَعَٰل۪يٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَمَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "يُشْرِكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 2, "text": "يُنَزِّلُ اُ۬لْمَلَٰٓئِكَةَ بِالرُّوحِ مِنَ اَمْرِهِۦ عَلَيٰ مَنْ يَّشَآءُ مِنْ عِبَادِهِۦٓ أَنَ اَنْذِرُوٓاْ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا فَاتَّقُونِۖ", "words": [{"id": 1, "arabic": "يُنَزِّلُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْمَلَٰٓئِكَةَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالرُّوحِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَمْرِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَّشَآءُ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 10, "arabic": "عِبَادِهِۦٓ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَنْذِرُوٓاْ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَنَّهُۥ", "translit": "", "root": ""}, {"id": 14, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 15, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 16, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 17, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 18, "arabic": "فَاتَّقُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 3, "text": "خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ بِالْحَقِّۖ تَعَٰل۪يٰ عَمَّا يُشْرِكُونَۖ", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 4, "arabi