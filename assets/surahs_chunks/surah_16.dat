 "وَعَلَي اَ۬للَّهِ قَصْدُ اُ۬لسَّبِيلِ وَمِنْهَا جَآئِرࣱۖ وَلَوْ شَآءَ لَهَد۪يٰكُمُۥٓ أَجْمَعِينَۖ", "words": [{"id": 1, "arabic": "وَعَلَي", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَصْدُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لسَّبِيلِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "جَآئِرࣱۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 8, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَهَد۪يٰكُمُۥٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَجْمَعِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 10, "text": "هُوَ اَ۬لذِےٓ أَنزَلَ مِنَ اَ۬لسَّمَآءِ مَآءࣰ لَّكُم مِّنْهُ شَرَابࣱ وَمِنْهُ شَجَرࣱ فِيهِ تُسِيمُونَۖ", "words": [{"id": 1, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِےٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَآءࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَّكُم", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "شَرَابࣱ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمِنْهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "شَجَرࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "تُسِيمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 11, "text": "يُنۢبِتُ لَكُم بِهِ اِ۬لزَّرْعَ وَالزَّيْتُونَ وَالنَّخِيلَ وَالَاعْنَٰبَ وَمِن كُلِّ اِ۬لثَّمَرَٰتِۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةࣰ لِّقَوْمࣲ يَتَفَكَّرُونَۖ", "words": [{"id": 1, "arabic": "يُنۢبِتُ", "translit": "", "root": ""}, {"id": 2,