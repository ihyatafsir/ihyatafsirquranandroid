h"}, {"surah": 16, "ayah": 112, "text": "وَضَرَبَ اَ۬للَّهُ مَثَلاࣰ قَرْيَةࣰ كَانَتَ اٰمِنَةࣰ مُّطْمَئِنَّةࣰ يَاتِيهَا رِزْقُهَا رَغَداࣰ مِّن كُلِّ مَكَانࣲ فَكَفَرَتْ بِأَنْعُمِ اِ۬للَّهِ فَأَذَاقَهَا اَ۬للَّهُ لِبَاسَ اَ۬لْجُوعِ وَالْخَوْفِ بِمَا كَانُواْ يَصْنَعُونَۖ", "words": [{"id": 1, "arabic": "وَضَرَبَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَثَلاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَرْيَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانَتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰمِنَةࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّطْمَئِنَّةࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَاتِيهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "رِزْقُهَا", "translit": "", "root": ""}, {"id": 10, "arabic": "رَغَداࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 12, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَكَانࣲ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَكَفَرَتْ", "translit": "", "root": ""}, {"id": 15, "arabic": "بِأَنْعُمِ", "translit": "", "root": ""}, {"id": 16, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 17, "arabic": "فَأَذَاقَهَا", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 19, "arabic": "لِبَاسَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لْجُوعِ", "translit": "", "root": ""}, {"id": 21, "arabic": "وَالْخَوْفِ", "translit": "", "root": ""}, {"id": 22, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 23, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 24, "arabic": "يَصْنَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 113, "text": "وَلَقَدْ جَآءَهُمْ رَسُولࣱ مِّنْهُمْ فَكَذَّبُوهُ فَأَخَذَهُمُ اُ۬لْعَذَابُ وَهُمْ ظَٰلِمُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَسُولࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنْهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَكَذَّبُوهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَأَخَذَهُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْعَذَابُ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "ظَٰلِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 114, "text": "فَكُلُواْ مِمَّا رَزَقَكُمُ اُ۬للَّهُ حَلَٰلاࣰ طَيِّباࣰۖ وَاشْكُرُواْ نِعْمَتَ اَ۬للَّهِ إِن كُنتُمُۥٓ إِيَّاهُ تَعْبُدُونَۖ", "words": [{"id": 1, "arabic": "فَكُلُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِمَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "رَزَقَكُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "حَلَٰلاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "طَيِّباࣰۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَاشْكُرُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "نِعْمَتَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِن", "translit": "", "root": ""}, {"id": 11, "arabic": "كُنتُمُۥٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِيَّاهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "تَعْبُدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 115, "text": "إِنَّمَا حَرَّمَ عَلَيْكُمُ اُ۬لْمَيْتَةَ وَالدَّمَ وَلَحْمَ اَ۬لْخِنزِيرِ وَمَآ أُهِلَّ لِغَيْرِ اِ۬للَّهِ بِهِۦۖ فَمَنُ اُ۟ضْطُرَّ غَيْرَ بَاغࣲ وَلَا عَادࣲ فَإِنَّ اَ۬للَّهَ غَفُورࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "حَرَّمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْكُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬ل