َ رَبَّهُم مِّن فَوْقِهِمْ وَيَفْعَلُونَ مَا يُومَرُونَۖ۩", "words": [{"id": 1, "arabic": "يَخَافُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "فَوْقِهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَفْعَلُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يُومَرُونَۖ۩", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 51, "text": "۞وَقَالَ اَ۬للَّهُ لَا تَتَّخِذُوٓاْ إِلَٰهَيْنِ اِ۪ثْنَيْنِۖ إِنَّمَا هُوَ إِلَٰهࣱ وَٰحِدࣱۖ فَإِيَّٰيَ فَارْهَبُونِۖ", "words": [{"id": 1, "arabic": "۞وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَتَّخِذُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهَيْنِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۪ثْنَيْنِۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَٰهࣱ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَٰحِدࣱۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَإِيَّٰيَ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَارْهَبُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 52, "text": "وَلَهُۥ مَا فِے اِ۬لسَّمَٰوَٰتِ وَالَارْضِۖ وَلَهُ اُ۬لدِّينُ وَاصِباًۖ اَفَغَيْرَ اَ۬للَّهِ تَتَّقُونَۖ", "words": [{"id": 1, "arabic": "وَلَهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَهُ", "translit": "", "root": ""}, {"id": 7, "arabic"