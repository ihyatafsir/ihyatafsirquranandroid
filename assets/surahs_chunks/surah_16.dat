", "root": "لقي"}, {"id": 7, "arabic": "ٱلسَّلَمَ", "translit": "َmَlَّslٱ", "root": "سلم"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 10, "arabic": "نَعْمَلُ", "translit": "ُlَmْʿعَn", "root": "عمل"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "سُوٓءٍۭ", "translit": "ٍۭءٓwُs", "root": "سوا"}, {"id": 13, "arabic": "بَلَىٰٓ", "translit": "ٰٓàَlَb", "root": ""}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 17, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 18, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 19, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 29, "text": "فَٱدْخُلُوٓا۟ أَبْوَٰبَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۖ فَلَبِئْسَ مَثْوَى ٱلْمُتَكَبِّرِينَ ", "translation": "So enter the gates of Hell to abide eternally therein, and how wretched is the residence of the arrogant.", "words": [{"id": 1, "arabic": "فَٱدْخُلُوٓا۟", "translit": "۟āٓwُlُhkْdٱَf", "root": "دخل"}, {"id": 2, "arabic": "أَبْوَٰبَ", "translit": "َbَٰwْbَaʾ", "root": "بوب"}, {"id": 3, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 4, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 5, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 6, "arabic": "فَلَبِئْسَ", "translit": "َsْyʾِbَlَf", "root": "باس"}, {"id": 7, "arabic": "مَثْوَى", "translit": "àَwْhtَm", "root": "ثوي"}, {"id": 8, "arabic": "ٱلْمُتَكَبِّرِينَ", "translit": "َnyِrِّbَkَtُmْlٱ", "root": "كبر"}], "hasIhya": false}, {"ayah": 30, "text": "وَقِيلَ لِلَّذِينَ ٱتَّقَوْا۟ مَاذَآ أَنزَلَ رَبُّكُمْۚ قَالُوا۟ خَيْرًاۗ لِّلَّذِينَ أَحْسَنُوا۟ فِى هَٰذِهِ ٱلدُّنْيَا حَسَنَةٌۚ وَلَدَارُ ٱلْءَاخِرَةِ خَيْرٌۚ وَلَنِعْمَ دَارُ ٱلْمُتَّقِينَ ", "translation": "And it will be said to those who feared Allāh, \"What did your Lord send down?\" They will say, \"[That which is] good.\" For those who do good in this world is good; and the home of the Hereafter is better. And how excellent is the home of the righteous -", "words": [{"id": 1, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 2, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 3, "arabic": "ٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱ", "root": "وقي"}, {"id": 4, "arabic": "مَاذَآ", "translit": "ٓāَhdāَm", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 7, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 8, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 9, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 10, "arabic": "أَحْسَنُوا۟", "translit": "۟āwُnَsْḥَaʾ", "root": "حسن"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 13, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 14, "arabic": "حَسَنَةٌ", "translit": "ٌẗَnَsَḥ", "root": "حسن"}, {"id": 15, "arabic": "وَلَدَارُ", "translit": "ُrāَdَlَw", "root": "دور"}, {"id": 16, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 17, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 18, "arabic": "وَلَنِعْمَ", "translit": "َmْʿعِnَlَw", "root": "نعم"}, {"id": 19, "arabic": "دَارُ", "translit": "ُrāَd", "root": "دور"}, {"id": 20, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 31, "text": "جَنَّٰتُ عَدْنٍ يَدْخُلُونَهَا تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۖ لَهُمْ فِيهَا مَا يَشَآءُونَۚ كَذَٰلِكَ يَجْزِى ٱللَّهُ ٱلْمُتَّقِينَ ", "translation": "Gardens of perpetual residence, which they will enter, beneath which rivers flow. They will have therein whatever they wish. Thus does Allāh reward the righteous -", "words": [{"id": 1, "arabic": "جَنَّٰتُ", "translit": "ُtَّٰnَjg", "root": "جنن"}, {"id": 2, "arabic": "عَدْنٍ", "translit": "ٍnْdَʿع", "root": ""}, {"id": 3, "arabic": "يَدْخُلُونَهَا", "translit": "āَhَnwُlُhkْdَy", "root": "دخل"}, {"id": 4, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 7, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 8, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "يَشَآءُونَ", "translit": "َnwُءٓāَhsَy", "root": "شيا"}, {"id": 12, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 13, "arabic": "يَجْزِى", "translit": "àِzْjgَy", "root": "جزي"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 32, "text": "ٱلَّذِينَ تَتَوَفَّىٰهُمُ ٱلْمَلَٰٓئِكَةُ طَيِّبِينَۙ يَقُولُونَ سَلَٰمٌ عَلَيْكُمُ ٱدْخُلُوا۟ ٱلْجَنَّةَ بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "The ones whom the angels take in death, [being] good and pure; [the angels] will say, \"Peace be upon you. Enter Paradise for what you used to do.\"", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "تَتَوَفَّىٰهُمُ", "translit": "ُmُhٰàَّfَwَtَt", "root": "وفي"}, {"id": 3, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 4, "arabic": "طَيِّبِينَ", "translit": "َnyِbِّyَṭ", "root": "طيب"}, {"id": 5, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 6, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 7, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 9, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 12, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 33, "text": "هَلْ يَنظُرُونَ إِلَّآ أَن تَأْتِيَهُمُ ٱلْمَلَٰٓئِكَةُ أَوْ يَأْتِىَ أَمْرُ رَبِّكَۚ كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبْلِهِمْۚ وَمَا ظَلَمَهُمُ ٱللَّهُ وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ", "translation": "Do they [i.e., the disbelievers] await except that the angels should come to them or there comes the command of your Lord? Thus did those do before them. And Allāh wronged them not, but they had been wronging themselves.", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تَأْتِيَهُمُ", "translit": "ُmُhَyِtْaʾَt", "root": "اتي"}, {"id": 6, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "يَأْتِىَ", "translit": "َàِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 10, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 11, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 12, "arabic": "فَعَلَ", "translit": "َlَʿعَf", "root": "فعل"}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "ظَلَمَهُمُ", "translit": "ُmُhَmَlَẓ", "root": "ظلم"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 20, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 21, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 22, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": true}, {"ayah": 34, "text": "فَأَصَابَهُمْ سَيِّـَٔاتُ مَا عَمِلُوا۟ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "So they were struck by the evil consequences of what they did and were enveloped by what they used to ridicule.", "words": [{"id": 1, "arabic": "فَأَصَابَهُمْ", "translit": "ْmُhَbāَṣَaʾَf", "root": "صوب"}, {"id": 2, "arabic": "سَيِّـَٔاتُ", "translit": "ُtāَٔـِّyَs", "root": "سوا"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 5, "arabic": "وَحَاقَ", "translit": "َqāَḥَw", "root": "حيق"}, {"id": 6, "arabic": "بِهِم", "translit": "mِhِb", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 35, "text": "وَقَالَ ٱلَّذِينَ أَشْرَكُوا۟ لَوْ شَآءَ ٱللَّهُ مَا عَبَدْنَا مِن دُونِهِۦ مِن شَىْءٍ نَّحْنُ وَلَآ ءَابَآؤُنَا وَلَا حَرَّمْنَا مِن دُونِهِۦ مِن شَىْءٍۚ كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبْلِهِمْۚ فَهَلْ عَلَى ٱلرُّسُلِ إِلَّا ٱلْبَلَٰغُ ٱلْمُبِينُ ", "translation": "And those who associate others with Allāh say, \"If Allāh had willed, we would not have worshipped anything other than Him, neither we nor our fathers, nor would we have forbidden anything through other than Him.\" Thus did those do before them. So is there upon the messengers except [the duty of] clear notification?", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 4, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 5, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "عَبَدْنَا", "translit": "āَnْdَbَʿع", "root": "عبد"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "نَّحْنُ", "translit": "ُnْḥَّn", "root": ""}, {"id": 14, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 15, "arabic": "ءَابَآؤُنَا", "translit": "āَnُwʾٓāَbāَء", "root": "ابو"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "حَرَّمْنَا", "translit": "āَnْmَّrَḥ", "root": "حرم"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 21, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 22, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 23, "arabic": "فَعَلَ", "translit": "َlَʿعَf", "root": "فعل"}, {"id": 24, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 25, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 26, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 27, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 28, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 29, "arabic": "ٱلرُّسُلِ", "translit": "ِlُsُّrlٱ", "root": "رسل"}, {"id": 30, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 31, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 32, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 36, "text": "وَلَقَدْ بَعَثْنَا فِى كُلِّ أُمَّةٍ رَّسُولًا أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱجْتَنِبُوا۟ ٱلطَّٰغُوتَۖ فَمِنْهُم مَّنْ هَدَى ٱللَّهُ وَمِنْهُم مَّنْ حَقَّتْ عَلَيْهِ ٱلضَّلَٰلَةُۚ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ ", "translation": "And We certainly sent into every nation a messenger, [saying], \"Worship Allāh and avoid ṭāghūt.\"[1] And among them were those whom Allāh guided, and among them were those upon whom error was [deservedly] decreed. So proceed [i.e., travel] through the earth and observe how was the end of the deniers.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "بَعَثْنَا", "translit": "āَnْhtَʿعَb", "root": "بعث"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "رَّسُولًا", "translit": "āًlwُsَّr", "root": "رسل"}, {"id": 7, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 8, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَٱجْتَنِبُوا۟", "translit": "۟āwُbِnَtْjgٱَw", "root": "جنب"}, {"id": 11, "arabic": "ٱلطَّٰغُوتَ", "translit": "َtwُغَّٰṭlٱ", "root": "طغي"}, {"id": 12, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 13, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 14, "arabic": "هَدَى", "translit": "àَdَh", "root": "هدي"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 17, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 18, "arabic": "حَقَّتْ", "translit": "ْtَّqَḥ", "root": "حقق"}, {"id": 19, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 20, "arabic": "ٱلضَّلَٰلَةُ", "translit": "ُẗَlَٰlَّḍlٱ", "root": "ضلل"}, {"id": 21, "arabic": "فَسِيرُوا۟", "translit": "۟āwُryِsَf", "root": "سير"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 24, "arabic": "فَٱنظُرُوا۟", "translit": "۟āwُrُẓnٱَf", "root": "نظر"}, {"id": 25, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 26, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 27, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 28, "arabic": "ٱلْمُكَذِّبِينَ", "translit": "َnyِbِّhdَkُmْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 37, "text": "إِن تَحْرِصْ عَلَىٰ هُدَىٰهُمْ فَإِنَّ ٱللَّهَ لَا يَهْدِى مَن يُضِلُّۖ وَمَا لَهُم مِّن نَّٰصِرِينَ ", "translation": "[Even] if you should strive for their guidance, [O Muḥammad], indeed, Allāh does not guide those He sends astray,[1] and they will have no helpers.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "تَحْرِصْ", "translit": "ْṣِrْḥَt", "root": "حرص"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "هُدَىٰهُمْ", "translit": "ْmُhٰàَdُh", "root": "هدي"}, {"id": 5, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "يُضِلُّ", "translit": "ُّlِḍُy", "root": "ضلل"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "نَّٰصِرِينَ", "translit": "َnyِrِṣَّٰn", "root": "نصر"}], "hasIhya": false}, {"ayah": 38, "text": "وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ أَيْمَٰنِهِمْۙ لَا يَبْعَثُ ٱللَّهُ مَن يَمُوتُۚ بَلَىٰ وَعْدًا عَلَيْهِ حَقًّا وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ", "translation": "And they swear by Allāh their strongest oaths [that] Allāh will not resurrect one who dies. But yes - [it is] a true promise [binding] upon Him, but most of the people do not know.", "words": [{"id": 1, "arabic": "وَأَقْسَمُوا۟", "translit": "۟āwُmَsْqَaʾَw", "root": "قسم"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "جَهْدَ", "translit": "َdْhَjg", "root": "جهد"}, {"id": 4, "arabic": "أَيْمَٰنِهِمْ", "translit": "ْmِhِnَٰmْyَaʾ", "root": "يمن"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَبْعَثُ", "translit": "ُhtَʿعْbَy", "root": "بعث"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 9, "arabic": "يَمُوتُ", "translit": "ُtwُmَy", "root": "موت"}, {"id": 10, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 11, "arabic": "وَعْدًا", "translit": "āًdْʿعَw", "root": "وعد"}, {"id": 12, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 14, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 15, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 16, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 39, "text": "لِيُبَيِّنَ لَهُمُ ٱلَّذِى يَخْتَلِفُونَ فِيهِ وَلِيَعْلَمَ ٱلَّذِينَ كَفَرُوٓا۟ أَنَّهُمْ كَانُوا۟ كَٰذِبِينَ ", "translation": "[It is] so He will make clear to them [the truth of] that wherein they differ and so those who have disbelieved may know that they were liars.", "words": [{"id": 1, "arabic": "لِيُبَيِّنَ", "translit": "َnِّyَbُyِl", "root": "بين"}, {"id": 2, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}, {"id": 5, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 6, "arabic": "وَلِيَعْلَمَ", "translit": "َmَlْʿعَyِlَw", "root": "علم"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 9, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 10, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 11, "arabic": "كَٰذِبِينَ", "translit": "َnyِbِhdَٰk", "root": "كذب"}], "hasIhya": false}, {"ayah": 40, "text": "إِنَّمَا قَوْلُنَا لِشَىْءٍ إِذَآ أَرَدْنَٰهُ أَن نَّقُولَ لَهُۥ كُن فَيَكُونُ ", "translation": "Indeed, Our word to a thing when We intend it is but that We say to it, \"Be,\" and it is.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "قَوْلُنَا", "translit": "āَnُlْwَq", "root": "قول"}, {"id": 3, "arabic": "لِشَىْءٍ", "translit": "ٍءْàَhsِl", "root": "شيا"}, {"id": 4, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 5, "arabic": "أَرَدْنَٰهُ", "translit": "ُhَٰnْdَrَaʾ", "root": "رود"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "نَّقُولَ", "translit": "َlwُqَّn", "root": "قول"}, {"id": 8, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 9, "arabic": "كُن", "translit": "nُk", "root": "كون"}, {"id": 10, "arabic": "فَيَكُونُ", "translit": "ُnwُkَyَf", "root": "كون"}], "hasIhya": true}, {"ayah": 41, "text": "وَٱلَّذِينَ هَاجَرُوا۟ فِى ٱللَّهِ مِنۢ بَعْدِ مَا ظُلِمُوا۟ لَنُبَوِّئَنَّهُمْ فِى ٱلدُّنْيَا حَسَنَةًۖ وَلَأَجْرُ ٱلْءَاخِرَةِ أَكْبَرُۚ لَوْ كَانُوا۟ يَعْلَمُونَ ", "translation": "And those who emigrated for [the cause of] Allāh after they had been wronged - We will surely settle them in this world in a good place; but the reward of the Hereafter is greater, if only they could know.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "هَاجَرُوا۟", "translit": "۟āwُrَjgāَh", "root": "هجر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "ظُلِمُوا۟", "translit": "۟āwُmِlُẓ", "root": "ظلم"}, {"id": 9, "arabic": "لَنُبَوِّئَنَّهُمْ", "translit": "ْmُhَّnَyʾِّwَbُnَl", "root": "بوا"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 12, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 13, "arabic": "وَلَأَجْرُ", "translit": "ُrْjgَaʾَlَw", "root": "اجر"}, {"id": 14, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 15, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 16, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 42, "text": "ٱلَّذِينَ صَبَرُوا۟ وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ ", "translation": "[They are] those who endured patiently and upon their Lord relied.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 3, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 4, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 5, "arabic": "يَتَوَكَّلُونَ", "translit": "َnwُlَّkَwَtَy", "root": "وكل"}], "hasIhya": true}, {"ayah": 43, "text": "وَمَآ أَرْسَلْنَا مِن قَبْلِكَ إِلَّا رِجَالًا نُّوحِىٓ إِلَيْهِمْۚ فَسْـَٔلُوٓا۟ أَهْلَ ٱلذِّكْرِ إِن كُنتُمْ لَا تَعْلَمُونَ ", "translation": "And We sent not before you except men to whom We revealed [Our message]. So ask the people of the message [i.e., former scriptures] if you do not know.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "رِجَالًا", "translit": "āًlāَjgِr", "root": "رجل"}, {"id": 7, "arabic": "نُّوحِىٓ", "translit": "ٓàِḥwُّn", "root": "وحي"}, {"id": 8, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "فَسْـَٔلُوٓا۟", "translit": "۟āٓwُlَٔـْsَf", "root": "سال"}, {"id": 10, "arabic": "أَهْلَ", "translit": "َlْhَaʾ", "root": "اهل"}, {"id": 11, "arabic": "ٱلذِّكْرِ", "translit": "ِrْkِّhdlٱ", "root": "ذكر"}, {"id": 12, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 44, "text": "بِٱلْبَيِّنَٰتِ وَٱلزُّبُرِۗ وَأَنزَلْنَآ إِلَيْكَ ٱلذِّكْرَ لِتُبَيِّنَ لِلنَّاسِ مَا نُزِّلَ إِلَيْهِمْ وَلَعَلَّهُمْ يَتَفَكَّرُونَ ", "translation": "[We sent them] with clear proofs and written ordinances. And We revealed to you the message [i.e., the Qur’ān] that you may make clear to the people what was sent down to them and that they might give thought.", "words": [{"id": 1, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 2, "arabic": "وَٱلزُّبُرِ", "translit": "ِrُbُّzlٱَw", "root": "زبر"}, {"id": 3, "arabic": "وَأَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾَw", "root": "نزل"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلذِّكْرَ", "translit": "َrْkِّhdlٱ", "root": "ذكر"}, {"id": 6, "arabic": "لِتُبَيِّنَ", "translit": "َnِّyَbُtِl", "root": "بين"}, {"id": 7, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "نُزِّلَ", "translit": "َlِّzُn", "root": "نزل"}, {"id": 10, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 11, "arabic": "وَلَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَlَw", "root": ""}, {"id": 12, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": true}, {"ayah": 45, "text": "أَفَأَمِنَ ٱلَّذِينَ مَكَرُوا۟ ٱلسَّيِّـَٔاتِ أَن يَخْسِفَ ٱللَّهُ بِهِمُ ٱلْأَرْضَ أَوْ يَأْتِيَهُمُ ٱلْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ ", "translation": "Then, do those who have planned evil deeds feel secure that Allāh will not cause the earth to swallow them or that the punishment will not come upon them from where they do not perceive?", "words": [{"id": 1, "arabic": "أَفَأَمِنَ", "translit": "َnِmَaʾَfَaʾ", "root": "امن"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "مَكَرُوا۟", "translit": "۟āwُrَkَm", "root": "مكر"}, {"id": 4, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يَخْسِفَ", "translit": "َfِsْhkَy", "root": "خسف"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "بِهِمُ", "translit": "ُmِhِb", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "يَأْتِيَهُمُ", "translit": "ُmُhَyِtْaʾَy", "root": "اتي"}, {"id": 12, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 46, "text": "أَوْ يَأْخُذَهُمْ فِى تَقَلُّبِهِمْ فَمَا هُم بِمُعْجِزِينَ ", "translation": "Or that He would not seize them during their [usual] activity, and they could not cause failure [i.e., escape from Him]?", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "يَأْخُذَهُمْ", "translit": "ْmُhَhdُhkْaʾَy", "root": "اخذ"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "تَقَلُّبِهِمْ", "translit": "ْmِhِbُّlَqَt", "root": "قلب"}, {"id": 5, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 6, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 7, "arabic": "بِمُعْجِزِينَ", "translit": "َnyِzِjgْʿعُmِb", "root": "عجز"}], "hasIhya": false}, {"ayah": 47, "text": "أَوْ يَأْخُذَهُمْ عَلَىٰ تَخَوُّفٍ فَإِنَّ رَبَّكُمْ لَرَءُوفٌ رَّحِيمٌ ", "translation": "Or that He would not seize them gradually [in a state of dread]?[1] But indeed, your Lord is Kind and Merciful.[2]", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "يَأْخُذَهُمْ", "translit": "ْmُhَhdُhkْaʾَy", "root": "اخذ"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "تَخَوُّفٍ", "translit": "ٍfُّwَhkَt", "root": "خوف"}, {"id": 5, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 6, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 7, "arabic": "لَرَءُوفٌ", "translit": "ٌfwُءَrَl", "root": "راف"}, {"id": 8, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 48, "text": "أَوَلَمْ يَرَوْا۟ إِلَىٰ مَا خَلَقَ ٱللَّهُ مِن شَىْءٍ يَتَفَيَّؤُا۟ ظِلَٰلُهُۥ عَنِ ٱلْيَمِينِ وَٱلشَّمَآئِلِ سُجَّدًا لِّلَّهِ وَهُمْ دَٰخِرُونَ ", "translation": "Have they not considered what things Allāh has created? Their shadows incline to the right and to the left, prostrating to Allāh, while they [i.e., those creations] are humble.", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "يَتَفَيَّؤُا۟", "translit": "۟āُwʾَّyَfَtَy", "root": "فيا"}, {"id": 10, "arabic": "ظِلَٰلُهُۥ", "translit": "ۥُhُlَٰlِẓ", "root": "ظلل"}, {"id": 11, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 12, "arabic": "ٱلْيَمِينِ", "translit": "ِnyِmَyْlٱ", "root": "يمن"}, {"id": 13, "arabic": "وَٱلشَّمَآئِلِ", "translit": "ِlِyʾٓāَmَّhslٱَw", "root": "شمل"}, {"id": 14, "arabic": "سُجَّدًا", "translit": "āًdَّjgُs", "root": "سجد"}, {"id": 15, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 16, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 17, "arabic": "دَٰخِرُونَ", "translit": "َnwُrِhkَٰd", "root": "دخر"}], "hasIhya": false}, {"ayah": 49, "text": "وَلِلَّهِ يَسْجُدُ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ مِن دَآبَّةٍ وَٱلْمَلَٰٓئِكَةُ وَهُمْ لَا يَسْتَكْبِرُونَ ", "translation": "And to Allāh prostrates whatever is in the heavens and whatever is on the earth of creatures, and the angels [as well], and they are not arrogant.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "يَسْجُدُ", "translit": "ُdُjgْsَy", "root": "سجد"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 11, "arabic": "وَٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱَw", "root": "ملك"}, {"id": 12, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يَسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsَy", "root": "كبر"}], "hasIhya": false}, {"ayah": 50, "text": "يَخَافُونَ رَبَّهُم مِّن فَوْقِهِمْ وَيَفْعَلُونَ مَا يُؤْمَرُونَ۩ ", "translation": "They fear their Lord above them, and they do what they are commanded.", "words": [{"id": 1, "arabic": "يَخَافُونَ", "translit": "َnwُfāَhkَy", "root": "خوف"}, {"id": 2, "arabic": "رَبَّهُم", "translit": "mُhَّbَr", "root": "ربب"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "فَوْقِهِمْ", "translit": "ْmِhِqْwَf", "root": "فوق"}, {"id": 5, "arabic": "وَيَفْعَلُونَ", "translit": "َnwُlَʿعْfَyَw", "root": "فعل"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "يُؤْمَرُونَ", "translit": "َnwُrَmْwʾُy", "root": "امر"}], "hasIhya": false}, {"ayah": 51, "text": "وَقَالَ ٱللَّهُ لَا تَتَّخِذُوٓا۟ إِلَٰهَيْنِ ٱثْنَيْنِۖ إِنَّمَا هُوَ إِلَٰهٌ وَٰحِدٌۖ فَإِيَّٰىَ فَٱرْهَبُونِ ", "translation": "And Allāh has said, \"Do not take for yourselves two[1] deities. He [i.e., Allāh] is but one God, so fear only Me.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "تَتَّخِذُوٓا۟", "translit": "۟āٓwُhdِhkَّtَt", "root": "اخذ"}, {"id": 5, "arabic": "إِلَٰهَيْنِ", "translit": "ِnْyَhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "ٱثْنَيْنِ", "translit": "ِnْyَnْhtٱ", "root": "ثني"}, {"id": 7, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 10, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 11, "arabic": "فَإِيَّٰىَ", "translit": "َàَّٰyِiʾَf", "root": ""}, {"id": 12, "arabic": "فَٱرْهَبُونِ", "translit": "ِnwُbَhْrٱَf", "root": "رهب"}], "hasIhya": false}, {"ayah": 52, "text": "وَلَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَلَهُ ٱلدِّينُ وَاصِبًاۚ أَفَغَيْرَ ٱللَّهِ تَتَّقُونَ ", "translation": "And to Him belongs whatever is in the heavens and the earth, and to Him is [due] worship constantly. Then is it other than Allāh that you fear?", "words": [{"id": 1, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَلَهُ", "translit": "ُhَlَw", "root": ""}, {"id": 7, "arabic": "ٱلدِّينُ", "translit": "ُnyِّdlٱ", "root": "دين"}, {"id": 8, "arabic": "وَاصِبًا", "translit": "āًbِṣāَw", "root": "وصب"}, {"id": 9, "arabic": "أَفَغَيْرَ", "translit": "َrْyَغَfَaʾ", "root": "غير"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": true}, {"ayah": 53, "text": "وَمَا بِكُم مِّن نِّعْمَةٍ فَمِنَ ٱللَّهِۖ ثُمَّ إِذَا مَسَّكُمُ ٱلضُّرُّ فَإِلَيْهِ تَجْـَٔرُونَ ", "translation": "And whatever you have of favor - it is from Allāh. Then when adversity touches you, to Him you cry for help.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "بِكُم", "translit": "mُkِb", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "نِّعْمَةٍ", "translit": "ٍẗَmْʿعِّn", "root": "نعم"}, {"id": 5, "arabic": "فَمِنَ", "translit": "َnِmَf", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 9, "arabic": "مَسَّكُمُ", "translit": "ُmُkَّsَm", "root": "مسس"}, {"id": 10, "arabic": "ٱلضُّرُّ", "translit": "ُّrُّḍlٱ", "root": "ضرر"}, {"id": 11, "arabic": "فَإِلَيْهِ", "translit": "ِhْyَlِiʾَf", "root": ""}, {"id": 12, "arabic": "تَجْـَٔرُونَ", "translit": "َnwُrَٔـْjgَt", "root": "جار"}], "hasIhya": false}, {"ayah": 54, "text": "ثُمَّ إِذَا كَشَفَ ٱلضُّرَّ عَنكُمْ إِذَا فَرِيقٌ مِّنكُم بِرَبِّهِمْ يُشْرِكُونَ ", "translation": "Then when He removes the adversity from you, at once a party of you associates others with their Lord", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "كَشَفَ", "translit": "َfَhsَk", "root": "كشف"}, {"id": 4, "arabic": "ٱلضُّرَّ", "translit": "َّrُّḍlٱ", "root": "ضرر"}, {"id": 5, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 6, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 7, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 8, "arabic": "مِّنكُم", "translit": "mُknِّm", "root": ""}, {"id": 9, "arabic": "بِرَبِّهِمْ", "translit": "ْmِhِّbَrِb", "root": "ربب"}, {"id": 10, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 55, "text": "لِيَكْفُرُوا۟ بِمَآ ءَاتَيْنَٰهُمْۚ فَتَمَتَّعُوا۟ۖ فَسَوْفَ تَعْلَمُونَ ", "translation": "So they will deny what We have given them. Then enjoy yourselves, for you are going to know.", "words": [{"id": 1, "arabic": "لِيَكْفُرُوا۟", "translit": "۟āwُrُfْkَyِl", "root": "كفر"}, {"id": 2, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 3, "arabic": "ءَاتَيْنَٰهُمْ", "translit": "ْmُhَٰnْyَtāَء", "root": "اتي"}, {"id": 4, "arabic": "فَتَمَتَّعُوا۟", "translit": "۟āwُʿعَّtَmَtَf", "root": "متع"}, {"id": 5, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 6, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 56, "text": "وَيَجْعَلُونَ لِمَا لَا يَعْلَمُونَ نَصِيبًا مِّمَّا رَزَقْنَٰهُمْۗ تَٱللَّهِ لَتُسْـَٔلُنَّ عَمَّا كُنتُمْ تَفْتَرُونَ ", "translation": "And they assign to what they do not know[1] [i.e., false deities] a portion of that which We have provided them. By Allāh, you will surely be questioned about what you used to invent.", "words": [{"id": 1, "arabic": "وَيَجْعَلُونَ", "translit": "َnwُlَʿعْjgَyَw", "root": "جعل"}, {"id": 2, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}, {"id": 5, "arabic": "نَصِيبًا", "translit": "āًbyِṣَn", "root": "نصب"}, {"id": 6, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 7, "arabic": "رَزَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَzَr", "root": "رزق"}, {"id": 8, "arabic": "تَٱللَّهِ", "translit": "ِhَّllٱَt", "root": "اله"}, {"id": 9, "arabic": "لَتُسْـَٔلُنَّ", "translit": "َّnُlَٔـْsُtَl", "root": "سال"}, {"id": 10, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 11, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 12, "arabic": "تَفْتَرُونَ", "translit": "َnwُrَtْfَt", "root": "فري"}], "hasIhya": false}, {"ayah": 57, "text": "وَيَجْعَلُونَ لِلَّهِ ٱلْبَنَٰتِ سُبْحَٰنَهُۥۙ وَلَهُم مَّا يَشْتَهُونَ ", "translation": "And they attribute to Allāh daughters[1] - exalted is He - and for them is what they desire [i.e., sons].", "words": [{"id": 1, "arabic": "وَيَجْعَلُونَ", "translit": "َnwُlَʿعْjgَyَw", "root": "جعل"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "ٱلْبَنَٰتِ", "translit": "ِtَٰnَbْlٱ", "root": "بني"}, {"id": 4, "arabic": "سُبْحَٰنَهُۥ", "translit": "ۥُhَnَٰḥْbُs", "root": "سبح"}, {"id": 5, "arabic": "وَلَهُم", "translit": "mُhَlَw", "root": ""}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "يَشْتَهُونَ", "translit": "َnwُhَtْhsَy", "root": "شهو"}], "hasIhya": false}, {"ayah": 58, "text": "وَإِذَا بُشِّرَ أَحَدُهُم بِٱلْأُنثَىٰ ظَلَّ وَجْهُهُۥ مُسْوَدًّا وَهُوَ كَظِيمٌ ", "translation": "And when one of them is informed of [the birth of] a female, his face becomes dark, and he suppresses grief.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "بُشِّرَ", "translit": "َrِّhsُb", "root": "بشر"}, {"id": 3, "arabic": "أَحَدُهُم", "translit": "mُhُdَḥَaʾ", "root": "احد"}, {"id": 4, "arabic": "بِٱلْأُنثَىٰ", "translit": "ٰàَhtnُaʾْlٱِb", "root": "انث"}, {"id": 5, "arabic": "ظَلَّ", "translit": "َّlَẓ", "root": "ظلل"}, {"id": 6, "arabic": "وَجْهُهُۥ", "translit": "ۥُhُhْjgَw", "root": "وجه"}, {"id": 7, "arabic": "مُسْوَدًّا", "translit": "āًّdَwْsُm", "root": "سود"}, {"id": 8, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 9, "arabic": "كَظِيمٌ", "translit": "ٌmyِẓَk", "root": "كظم"}], "hasIhya": false}, {"ayah": 59, "text": "يَتَوَٰرَىٰ مِنَ ٱلْقَوْمِ مِن سُوٓءِ مَا بُشِّرَ بِهِۦٓۚ أَيُمْسِكُهُۥ عَلَىٰ هُونٍ أَمْ يَدُسُّهُۥ فِى ٱلتُّرَابِۗ أَلَا سَآءَ مَا يَحْكُمُونَ ", "translation": "He hides himself from the people because of the ill of which he has been informed. Should he keep it in humiliation or bury it in the ground? Unquestionably, evil is what they decide.", "words": [{"id": 1, "arabic": "يَتَوَٰرَىٰ", "translit": "ٰàَrَٰwَtَy", "root": "وري"}, {"id": 2, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 3, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "سُوٓءِ", "translit": "ِءٓwُs", "root": "سوا"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "بُشِّرَ", "translit": "َrِّhsُb", "root": "بشر"}, {"id": 8, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 9, "arabic": "أَيُمْسِكُهُۥ", "translit": "ۥُhُkِsْmُyَaʾ", "root": "مسك"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "هُونٍ", "translit": "ٍnwُh", "root": "هون"}, {"id": 12, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 13, "arabic": "يَدُسُّهُۥ", "translit": "ۥُhُّsُdَy", "root": "دسس"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ٱلتُّرَابِ", "translit": "ِbāَrُّtlٱ", "root": "ترب"}, {"id": 16, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 17, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "يَحْكُمُونَ", "translit": "َnwُmُkْḥَy", "root": "حكم"}], "hasIhya": false}, {"ayah": 60, "text": "لِلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ مَثَلُ ٱلسَّوْءِۖ وَلِلَّهِ ٱلْمَثَلُ ٱلْأَعْلَىٰۚ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "For those who do not believe in the Hereafter is the description [i.e., an attribute] of evil;[1] and for Allāh is the highest attribute. And He is Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 4, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 5, "arabic": "مَثَلُ", "translit": "ُlَhtَm", "root": "مثل"}, {"id": 6, "arabic": "ٱلسَّوْءِ", "translit": "ِءْwَّslٱ", "root": "سوا"}, {"id": 7, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 8, "arabic": "ٱلْمَثَلُ", "translit": "ُlَhtَmْlٱ", "root": "مثل"}, {"id": 9, "arabic": "ٱلْأَعْلَىٰ", "translit": "ٰàَlْʿعَaʾْlٱ", "root": "علو"}, {"id": 10, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 11, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 12, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 61, "text": "وَلَوْ يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ بِظُلْمِهِم مَّا تَرَكَ عَلَيْهَا مِن دَآبَّةٍ وَلَٰكِن يُؤَخِّرُهُمْ إِلَىٰٓ أَجَلٍ مُّسَمًّىۖ فَإِذَا جَآءَ أَجَلُهُمْ لَا يَسْتَـْٔخِرُونَ سَاعَةًۖ وَلَا يَسْتَقْدِمُونَ ", "translation": "And if Allāh were to impose blame on the people for their wrongdoing, He would not have left upon it [i.e., the earth] any creature, but He defers them for a specified term. And when their term has come, they will not remain behind an hour, nor will they precede [it].", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "يُؤَاخِذُ", "translit": "ُhdِhkāَwʾُy", "root": "اخذ"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "بِظُلْمِهِم", "translit": "mِhِmْlُẓِb", "root": "ظلم"}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 8, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 11, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 12, "arabic": "يُؤَخِّرُهُمْ", "translit": "ْmُhُrِّhkَwʾُy", "root": "اخر"}, {"id": 13, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 14, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 15, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 16, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 17, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 18, "arabic": "أَجَلُهُمْ", "translit": "ْmُhُlَjgَaʾ", "root": "اجل"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَسْتَـْٔخِرُونَ", "translit": "َnwُrِhkْٔـَtْsَy", "root": "اخر"}, {"id": 21, "arabic": "سَاعَةً", "translit": "ًẗَʿعāَs", "root": "سوع"}, {"id": 22, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 23, "arabic": "يَسْتَقْدِمُونَ", "translit": "َnwُmِdْqَtْsَy", "root": "قدم"}], "hasIhya": false}, {"ayah": 62, "text": "وَيَجْعَلُونَ لِلَّهِ مَا يَكْرَهُونَ وَتَصِفُ أَلْسِنَتُهُمُ ٱلْكَذِبَ أَنَّ لَهُمُ ٱلْحُسْنَىٰۖ لَا جَرَمَ أَنَّ لَهُمُ ٱلنَّارَ وَأَنَّهُم مُّفْرَطُونَ ", "translation": "And they attribute to Allāh that which they dislike [i.e., daughters], and their tongues assert the lie that they will have the best [from Him]. Assuredly, they will have the Fire, and they will be [therein] neglected.[1]", "words": [{"id": 1, "arabic": "وَيَجْعَلُونَ", "translit": "َnwُlَʿعْjgَyَw", "root": "جعل"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَكْرَهُونَ", "translit": "َnwُhَrْkَy", "root": "كره"}, {"id": 5, "arabic": "وَتَصِفُ", "translit": "ُfِṣَtَw", "root": "وصف"}, {"id": 6, "arabic": "أَلْسِنَتُهُمُ", "translit": "ُmُhُtَnِsْlَaʾ", "root": "لسن"}, {"id": 7, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 8, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 9, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 10, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "جَرَمَ", "translit": "َmَrَjg", "root": "جرم"}, {"id": 13, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 14, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 15, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 16, "arabic": "وَأَنَّهُم", "translit": "mُhَّnَaʾَw", "root": ""}, {"id": 17, "arabic": "مُّفْرَطُونَ", "translit": "َnwُṭَrْfُّm", "root": "فرط"}], "hasIhya": true}, {"ayah": 63, "text": "تَٱللَّهِ لَقَدْ أَرْسَلْنَآ إِلَىٰٓ أُمَمٍ مِّن قَبْلِكَ فَزَيَّنَ لَهُمُ ٱلشَّيْطَٰنُ أَعْمَٰلَهُمْ فَهُوَ وَلِيُّهُمُ ٱلْيَوْمَ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "By Allāh, We did certainly send [messengers] to nations before you, but Satan made their deeds attractive to them. And he is their [i.e., the disbelievers] ally today [as well], and they will have a painful punishment.", "words": [{"id": 1, "arabic": "تَٱللَّهِ", "translit": "ِhَّllٱَt", "root": "اله"}, {"id": 2, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 3, "arabic": "أَرْسَلْنَآ", "translit": "ٓāَnْlَsْrَaʾ", "root": "رسل"}, {"id": 4, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 5, "arabic": "أُمَمٍ", "translit": "ٍmَmُaʾ", "root": "امم"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 8, "arabic": "فَزَيَّنَ", "translit": "َnَّyَzَf", "root": "زين"}, {"id": 9, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 10, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 11, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 12, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 13, "arabic": "وَلِيُّهُمُ", "translit": "ُmُhُّyِlَw", "root": "ولي"}, {"id": 14, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 15, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 16, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 17, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 64, "text": "وَمَآ أَنزَلْنَا عَلَيْكَ ٱلْكِتَٰبَ إِلَّا لِتُبَيِّنَ لَهُمُ ٱلَّذِى ٱخْتَلَفُوا۟ فِيهِۙ وَهُدًى وَرَحْمَةً لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "And We have not revealed to you the Book, [O Muḥammad], except for you to make clear to them that wherein they have differed and as guidance and mercy for a people who believe.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "لِتُبَيِّنَ", "translit": "َnِّyَbُtِl", "root": "بين"}, {"id": 7, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 10, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 11, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 12, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 13, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 14, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 65, "text": "وَٱللَّهُ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءً فَأَحْيَا بِهِ ٱلْأَرْضَ بَعْدَ مَوْتِهَآۚ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَسْمَعُونَ ", "translation": "And Allāh has sent down rain from the sky and given life thereby to the earth after its lifelessness. Indeed in that is a sign for a people who listen.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 6, "arabic": "فَأَحْيَا", "translit": "āَyْḥَaʾَf", "root": "حيي"}, {"id": 7, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "مَوْتِهَآ", "translit": "ٓāَhِtْwَm", "root": "موت"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 14, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 15, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 16, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}], "hasIhya": false}, {"ayah": 66, "text": "وَإِنَّ لَكُمْ فِى ٱلْأَنْعَٰمِ لَعِبْرَةًۖ نُّسْقِيكُم مِّمَّا فِى بُطُونِهِۦ مِنۢ بَيْنِ فَرْثٍ وَدَمٍ لَّبَنًا خَالِصًا سَآئِغًا لِّلشَّٰرِبِينَ ", "translation": "And indeed, for you in grazing livestock is a lesson. We give you drink from what is in their bellies - between excretion and blood - pure milk, palatable to drinkers.", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 5, "arabic": "لَعِبْرَةً", "translit": "ًẗَrْbِʿعَl", "root": "عبر"}, {"id": 6, "arabic": "نُّسْقِيكُم", "translit": "mُkyِqْsُّn", "root": "سقي"}, {"id": 7, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "بُطُونِهِۦ", "translit": "ۦِhِnwُṭُb", "root": "بطن"}, {"id": 10, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 11, "arabic": "بَيْنِ", "translit": "ِnْyَb", "root": "بين"}, {"id": 12, "arabic": "فَرْثٍ", "translit": "ٍhtْrَf", "root": "فرث"}, {"id": 13, "arabic": "وَدَمٍ", "translit": "ٍmَdَw", "root": "دمو"}, {"id": 14, "arabic": "لَّبَنًا", "translit": "āًnَbَّl", "root": "لبن"}, {"id": 15, "arabic": "خَالِصًا", "translit": "āًṣِlāَhk", "root": "خلص"}, {"id": 16, "arabic": "سَآئِغًا", "translit": "āًغِyʾٓāَs", "root": "سوغ"}, {"id": 17, "arabic": "لِّلشَّٰرِبِينَ", "translit": "َnyِbِrَّٰhslِّl", "root": "شرب"}], "hasIhya": true}, {"ayah": 67, "text": "وَمِن ثَمَرَٰتِ ٱلنَّخِيلِ وَٱلْأَعْنَٰبِ تَتَّخِذُونَ مِنْهُ سَكَرًا وَرِزْقًا حَسَنًاۗ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَعْقِلُونَ ", "translation": "And from the fruits of the palm trees and grapevines you take intoxicant and good provision.[1] Indeed in that is a sign for a people who reason.", "words": [{"id": 1, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 2, "arabic": "ثَمَرَٰتِ", "translit": "ِtَٰrَmَht", "root": "ثمر"}, {"id": 3, "arabic": "ٱلنَّخِيلِ", "translit": "ِlyِhkَّnlٱ", "root": "نخل"}, {"id": 4, "arabic": "وَٱلْأَعْنَٰبِ", "translit": "ِbَٰnْʿعَaʾْlٱَw", "root": "عنب"}, {"id": 5, "arabic": "تَتَّخِذُونَ", "translit": "َnwُhdِhkَّtَt", "root": "اخذ"}, {"id": 6, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 7, "arabic": "سَكَرًا", "translit": "āًrَkَs", "root": "سكر"}, {"id": 8, "arabic": "وَرِزْقًا", "translit": "āًqْzِrَw", "root": "رزق"}, {"id": 9, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 14, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 15, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 68, "text": "وَأَوْحَىٰ رَبُّكَ إِلَى ٱلنَّحْلِ أَنِ ٱتَّخِذِى مِنَ ٱلْجِبَالِ بُيُوتًا وَمِنَ ٱلشَّجَرِ وَمِمَّا يَعْرِشُونَ ", "translation": "And your Lord inspired to the bee, \"Take for yourself among the mountains, houses [i.e., hives], and among the trees and [in] that which they construct.", "words": [{"id": 1, "arabic": "وَأَوْحَىٰ", "translit": "ٰàَḥْwَaʾَw", "root": "وحي"}, {"id": 2, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلنَّحْلِ", "translit": "ِlْḥَّnlٱ", "root": "نحل"}, {"id": 5, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 6, "arabic": "ٱتَّخِذِى", "translit": "àِhdِhkَّtٱ", "root": "اخذ"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلْجِبَالِ", "translit": "ِlāَbِjgْlٱ", "root": "جبل"}, {"id": 9, "arabic": "بُيُوتًا", "translit": "āًtwُyُb", "root": "بيت"}, {"id": 10, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 11, "arabic": "ٱلشَّجَرِ", "translit": "ِrَjgَّhslٱ", "root": "شجر"}, {"id": 12, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 13, "arabic": "يَعْرِشُونَ", "translit": "َnwُhsِrْʿعَy", "root": "عرش"}], "hasIhya": true}, {"ayah": 69, "text": "ثُمَّ كُلِى مِن كُلِّ ٱلثَّمَرَٰتِ فَٱسْلُكِى سُبُلَ رَبِّكِ ذُلُلًاۚ يَخْرُجُ مِنۢ بُطُونِهَا شَرَابٌ مُّخْتَلِفٌ أَلْوَٰنُهُۥ فِيهِ شِفَآءٌ لِّلنَّاسِۗ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَتَفَكَّرُونَ ", "translation": "Then eat from all the fruits[1] and follow the ways of your Lord laid down [for you].\" There emerges from their bellies a drink, varying in colors, in which there is healing for people. Indeed in that is a sign for a people who give thought.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "كُلِى", "translit": "àِlُk", "root": "اكل"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "ٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱ", "root": "ثمر"}, {"id": 6, "arabic": "فَٱسْلُكِى", "translit": "àِkُlْsٱَf", "root": "سلك"}, {"id": 7, "arabic": "سُبُلَ", "translit": "َlُbُs", "root": "سبل"}, {"id": 8, "arabic": "رَبِّكِ", "translit": "ِkِّbَr", "root": "ربب"}, {"id": 9, "arabic": "ذُلُلًا", "translit": "āًlُlُhd", "root": "ذلل"}, {"id": 10, "arabic": "يَخْرُجُ", "translit": "ُjgُrْhkَy", "root": "خرج"}, {"id": 11, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 12, "arabic": "بُطُونِهَا", "translit": "āَhِnwُṭُb", "root": "بطن"}, {"id": 13, "arabic": "شَرَابٌ", "translit": "ٌbāَrَhs", "root": "شرب"}, {"id": 14, "arabic": "مُّخْتَلِفٌ", "translit": "ٌfِlَtْhkُّm", "root": "خلف"}, {"id": 15, "arabic": "أَلْوَٰنُهُۥ", "translit": "ۥُhُnَٰwْlَaʾ", "root": "لون"}, {"id": 16, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 17, "arabic": "شِفَآءٌ", "translit": "ٌءٓāَfِhs", "root": "شفي"}, {"id": 18, "arabic": "لِّلنَّاسِ", "translit": "ِsāَّnlِّl", "root": "انس"}, {"id": 19, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 21, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 22, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 23, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 24, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": false}, {"ayah": 70, "text": "وَٱللَّهُ خَلَقَكُمْ ثُمَّ يَتَوَفَّىٰكُمْۚ وَمِنكُم مَّن يُرَدُّ إِلَىٰٓ أَرْذَلِ ٱلْعُمُرِ لِكَىْ لَا يَعْلَمَ بَعْدَ عِلْمٍ شَيْـًٔاۚ إِنَّ ٱللَّهَ عَلِيمٌ قَدِيرٌ ", "translation": "And Allāh created you; then He will take you in death. And among you is he who is reversed to the most decrepit [old] age so that he will not know, after [having had] knowledge, a thing. Indeed, Allāh is Knowing and Competent.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "خَلَقَكُمْ", "translit": "ْmُkَqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 4, "arabic": "يَتَوَفَّىٰكُمْ", "translit": "ْmُkٰàَّfَwَtَy", "root": "وفي"}, {"id": 5, "arabic": "وَمِنكُم", "translit": "mُknِmَw", "root": ""}, {"id": 6, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 7, "arabic": "يُرَدُّ", "translit": "ُّdَrُy", "root": "ردد"}, {"id": 8, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 9, "arabic": "أَرْذَلِ", "translit": "ِlَhdْrَaʾ", "root": "رذل"}, {"id": 10, "arabic": "ٱلْعُمُرِ", "translit": "ِrُmُʿعْlٱ", "root": "عمر"}, {"id": 11, "arabic": "لِكَىْ", "translit": "ْàَkِl", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يَعْلَمَ", "translit": "َmَlْʿعَy", "root": "علم"}, {"id": 14, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 16, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 17, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 18, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 20, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 71, "text": "وَٱللَّهُ فَضَّلَ بَعْضَكُمْ عَلَىٰ بَعْضٍ فِى ٱلرِّزْقِۚ فَمَا ٱلَّذِينَ فُضِّلُوا۟ بِرَآدِّى رِزْقِهِمْ عَلَىٰ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَهُمْ فِيهِ سَوَآءٌۚ أَفَبِنِعْمَةِ ٱللَّهِ يَجْحَدُونَ ", "translation": "And Allāh has favored some of you over others in provision. But those who were favored [i.e., given more] would not hand over their provision to those whom their right hands possess [i.e., slaves] so they would be equal to them therein.[1] Then is it the favor of Allāh they reject?", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "فَضَّلَ", "translit": "َlَّḍَf", "root": "فضل"}, {"id": 3, "arabic": "بَعْضَكُمْ", "translit": "ْmُkَḍْʿعَb", "root": "بعض"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلرِّزْقِ", "translit": "ِqْzِّrlٱ", "root": "رزق"}, {"id": 8, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "فُضِّلُوا۟", "translit": "۟āwُlِّḍُf", "root": "فضل"}, {"id": 11, "arabic": "بِرَآدِّى", "translit": "àِّdٓāَrِb", "root": "ردد"}, {"id": 12, "arabic": "رِزْقِهِمْ", "translit": "ْmِhِqْzِr", "root": "رزق"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 16, "arabic": "أَيْمَٰنُهُمْ", "translit": "ْmُhُnَٰmْyَaʾ", "root": "يمن"}, {"id": 17, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 18, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 19, "arabic": "سَوَآءٌ", "translit": "ٌءٓāَwَs", "root": "سوي"}, {"id": 20, "arabic": "أَفَبِنِعْمَةِ", "translit": "ِẗَmْʿعِnِbَfَaʾ", "root": "نعم"}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "يَجْحَدُونَ", "translit": "َnwُdَḥْjgَy", "root": "جحد"}], "hasIhya": false}, {"ayah": 72, "text": "وَٱللَّهُ جَعَلَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا وَجَعَلَ لَكُم مِّنْ أَزْوَٰجِكُم بَنِينَ وَحَفَدَةً وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِۚ أَفَبِٱلْبَٰطِلِ يُؤْمِنُونَ وَبِنِعْمَتِ ٱللَّهِ هُمْ يَكْفُرُونَ ", "translation": "And Allāh has made for you from yourselves mates and has made for you from your mates sons and grandchildren and has provided for you from the good things. Then in falsehood do they believe and in the favor of Allāh they disbelieve?", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 9, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 10, "arabic": "أَزْوَٰجِكُم", "translit": "mُkِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 11, "arabic": "بَنِينَ", "translit": "َnyِnَb", "root": "بني"}, {"id": 12, "arabic": "وَحَفَدَةً", "translit": "ًẗَdَfَḥَw", "root": "حفد"}, {"id": 13, "arabic": "وَرَزَقَكُم", "translit": "mُkَqَzَrَw", "root": "رزق"}, {"id": 14, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 15, "arabic": "ٱلطَّيِّبَٰتِ", "translit": "ِtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 16, "arabic": "أَفَبِٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱِbَfَaʾ", "root": "بطل"}, {"id": 17, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 18, "arabic": "وَبِنِعْمَتِ", "translit": "ِtَmْʿعِnِbَw", "root": "نعم"}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 21, "arabic": "يَكْفُرُونَ", "translit": "َnwُrُfْkَy", "root": "كفر"}], "hasIhya": false}, {"ayah": 73, "text": "وَيَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَمْلِكُ لَهُمْ رِزْقًا مِّنَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ شَيْـًٔا وَلَا يَسْتَطِيعُونَ ", "translation": "And they worship besides Allāh that which does not possess for them [the power of] provision from the heavens and the earth at all, and [in fact], they are unable.", "words": [{"id": 1, "arabic": "وَيَعْبُدُونَ", "translit": "َnwُdُbْʿعَyَw", "root": "عبد"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَمْلِكُ", "translit": "ُkِlْmَy", "root": "ملك"}, {"id": 8, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 9, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 12, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 13, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}], "hasIhya": false}, {"ayah": 74, "text": "فَلَا تَضْرِبُوا۟ لِلَّهِ ٱلْأَمْثَالَۚ إِنَّ ٱللَّهَ يَعْلَمُ وَأَنتُمْ لَا تَعْلَمُونَ ", "translation": "So do not assert similarities to Allāh.[1] Indeed, Allāh knows and you do not know.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "تَضْرِبُوا۟", "translit": "۟āwُbِrْḍَt", "root": "ضرب"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "ٱلْأَمْثَالَ", "translit": "َlāَhtْmَaʾْlٱ", "root": "مثل"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 8, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 75, "text": "ضَرَبَ ٱللَّهُ مَثَلًا عَبْدًا مَّمْلُوكًا لَّا يَقْدِرُ عَلَىٰ شَىْءٍ وَمَن رَّزَقْنَٰهُ مِنَّا رِزْقًا حَسَنًا فَهُوَ يُنفِقُ مِنْهُ سِرًّا وَجَهْرًاۖ هَلْ يَسْتَوُۥنَۚ ٱلْحَمْدُ لِلَّهِۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ", "translation": "Allāh presents an example: a slave [who is] owned and unable to do a thing and he to whom We have provided from Us good provision, so he spends from it secretly and publicly. Can they be equal? Praise to Allāh! But most of them do not know.", "words": [{"id": 1, "arabic": "ضَرَبَ", "translit": "َbَrَḍ", "root": "ضرب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "عَبْدًا", "translit": "āًdْbَʿع", "root": "عبد"}, {"id": 5, "arabic": "مَّمْلُوكًا", "translit": "āًkwُlْmَّm", "root": "ملك"}, {"id": 6, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 7, "arabic": "يَقْدِرُ", "translit": "ُrِdْqَy", "root": "قدر"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 10, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 11, "arabic": "رَّزَقْنَٰهُ", "translit": "ُhَٰnْqَzَّr", "root": "رزق"}, {"id": 12, "arabic": "مِنَّا", "translit": "āَّnِm", "root": ""}, {"id": 13, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 14, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 15, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 16, "arabic": "يُنفِقُ", "translit": "ُqِfnُy", "root": "نفق"}, {"id": 17, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 18, "arabic": "سِرًّا", "translit": "āًّrِs", "root": "سرر"}, {"id": 19, "arabic": "وَجَهْرًا", "translit": "āًrْhَjgَw", "root": "جهر"}, {"id": 20, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 21, "arabic": "يَسْتَوُۥنَ", "translit": "َnۥُwَtْsَy", "root": "سوي"}, {"id": 22, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 23, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 24, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 25, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 26, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 27, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 76, "text": "وَضَرَبَ ٱللَّهُ مَثَلًا رَّجُلَيْنِ أَحَدُهُمَآ أَبْكَمُ لَا يَقْدِرُ عَلَىٰ شَىْءٍ وَهُوَ كَلٌّ عَلَىٰ مَوْلَىٰهُ أَيْنَمَا يُوَجِّههُّ لَا يَأْتِ بِخَيْرٍۖ هَلْ يَسْتَوِى هُوَ وَمَن يَأْمُرُ بِٱلْعَدْلِۙ وَهُوَ عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "And Allāh presents an example of two men, one of them dumb and unable to do a thing, while he is a burden to his guardian. Wherever he directs him, he brings no good. Is he equal to one who commands justice, while he is on a straight path?", "words": [{"id": 1, "arabic": "وَضَرَبَ", "translit": "َbَrَḍَw", "root": "ضرب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "رَّجُلَيْنِ", "translit": "ِnْyَlُjgَّr", "root": "رجل"}, {"id": 5, "arabic": "أَحَدُهُمَآ", "translit": "ٓāَmُhُdَḥَaʾ", "root": "احد"}, {"id": 6, "arabic": "أَبْكَمُ", "translit": "ُmَkْbَaʾ", "root": "بكم"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَقْدِرُ", "translit": "ُrِdْqَy", "root": "قدر"}, {"id": 9, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 10, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 11, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 12, "arabic": "كَلٌّ", "translit": "ٌّlَk", "root": "كلل"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "مَوْلَىٰهُ", "translit": "ُhٰàَlْwَm", "root": "ولي"}, {"id": 15, "arabic": "أَيْنَمَا", "translit": "āَmَnْyَaʾ", "root": ""}, {"id": 16, "arabic": "يُوَجِّههُّ", "translit": "ُّhhِّjgَwُy", "root": "وجه"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 19, "arabic": "بِخَيْرٍ", "translit": "ٍrْyَhkِb", "root": "خير"}, {"id": 20, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 21, "arabic": "يَسْتَوِى", "translit": "àِwَtْsَy", "root": "سوي"}, {"id": 22, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 23, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 24, "arabic": "يَأْمُرُ", "translit": "ُrُmْaʾَy", "root": "امر"}, {"id": 25, "arabic": "بِٱلْعَدْلِ", "translit": "ِlْdَʿعْlٱِb", "root": "عدل"}, {"id": 26, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 27, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 28, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 29, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": true}, {"ayah": 77, "text": "وَلِلَّهِ غَيْبُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَمَآ أَمْرُ ٱلسَّاعَةِ إِلَّا كَلَمْحِ ٱلْبَصَرِ أَوْ هُوَ أَقْرَبُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "And to Allāh belongs the unseen [aspects] of the heavens and the earth. And the command for the Hour is not but as a glance of the eye or even nearer. Indeed, Allāh is over all things competent.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "غَيْبُ", "translit": "ُbْyَغ", "root": "غيب"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 6, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 7, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "كَلَمْحِ", "translit": "ِḥْmَlَk", "root": "لمح"}, {"id": 10, "arabic": "ٱلْبَصَرِ", "translit": "ِrَṣَbْlٱ", "root": "بصر"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 13, "arabic": "أَقْرَبُ", "translit": "ُbَrْqَaʾ", "root": "قرب"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 78, "text": "وَٱللَّهُ أَخْرَجَكُم مِّنۢ بُطُونِ أُمَّهَٰتِكُمْ لَا تَعْلَمُونَ شَيْـًٔا وَجَعَلَ لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَٰرَ وَٱلْأَفْـِٔدَةَۙ لَعَلَّكُمْ تَشْكُرُونَ ", "translation": "And Allāh has extracted you from the wombs of your mothers not knowing a thing, and He made for you hearing and vision and hearts [i.e., intellect] that perhaps you would be grateful.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "أَخْرَجَكُم", "translit": "mُkَjgَrْhkَaʾ", "root": "خرج"}, {"id": 3, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 4, "arabic": "بُطُونِ", "translit": "ِnwُṭُb", "root": "بطن"}, {"id": 5, "arabic": "أُمَّهَٰتِكُمْ", "translit": "ْmُkِtَٰhَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}, {"id": 8, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 9, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 10, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 11, "arabic": "ٱلسَّمْعَ", "translit": "َʿعْmَّslٱ", "root": "سمع"}, {"id": 12, "arabic": "وَٱلْأَبْصَٰرَ", "translit": "َrَٰṣْbَaʾْlٱَw", "root": "بصر"}, {"id": 13, "arabic": "وَٱلْأَفْـِٔدَةَ", "translit": "َẗَdِٔـْfَaʾْlٱَw", "root": "فاد"}, {"id": 14, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 15, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 79, "text": "أَلَمْ يَرَوْا۟ إِلَى ٱلطَّيْرِ مُسَخَّرَٰتٍ فِى جَوِّ ٱلسَّمَآءِ مَا يُمْسِكُهُنَّ إِلَّا ٱللَّهُۗ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "Do they not see the birds controlled in the atmosphere of the sky? None holds them up except Allāh. Indeed in that are signs for a people who believe.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلطَّيْرِ", "translit": "ِrْyَّṭlٱ", "root": "طير"}, {"id": 5, "arabic": "مُسَخَّرَٰتٍ", "translit": "ٍtَٰrَّhkَsُm", "root": "سخر"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "جَوِّ", "translit": "ِّwَjg", "root": "جوو"}, {"id": 8, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "يُمْسِكُهُنَّ", "translit": "َّnُhُkِsْmُy", "root": "مسك"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 16, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 17, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 18, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 80, "text": "وَٱللَّهُ جَعَلَ لَكُم مِّنۢ بُيُوتِكُمْ سَكَنًا وَجَعَلَ لَكُم مِّن جُلُودِ ٱلْأَنْعَٰمِ بُيُوتًا تَسْتَخِفُّونَهَا يَوْمَ ظَعْنِكُمْ وَيَوْمَ إِقَامَتِكُمْۙ وَمِنْ أَصْوَافِهَا وَأَوْبَارِهَا وَأَشْعَارِهَآ أَثَٰثًا وَمَتَٰعًا إِلَىٰ حِينٍ ", "translation": "And Allāh has made for you from your homes a place of rest and made for you from the hides of the animals tents which you find light on your day of travel and your day of encampment; and from their wool, fur and hair is furnishing and enjoyment [i.e., provision] for a time.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 4, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 5, "arabic": "بُيُوتِكُمْ", "translit": "ْmُkِtwُyُb", "root": "بيت"}, {"id": 6, "arabic": "سَكَنًا", "translit": "āًnَkَs", "root": "سكن"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "جُلُودِ", "translit": "ِdwُlُjg", "root": "جلد"}, {"id": 11, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 12, "arabic": "بُيُوتًا", "translit": "āًtwُyُb", "root": "بيت"}, {"id": 13, "arabic": "تَسْتَخِفُّونَهَا", "translit": "āَhَnwُّfِhkَtْsَt", "root": "خفف"}, {"id": 14, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 15, "arabic": "ظَعْنِكُمْ", "translit": "ْmُkِnْʿعَẓ", "root": "ظعن"}, {"id": 16, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 17, "arabic": "إِقَامَتِكُمْ", "translit": "ْmُkِtَmāَqِiʾ", "root": "قوم"}, {"id": 18, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 19, "arabic": "أَصْوَافِهَا", "translit": "āَhِfāَwْṣَaʾ", "root": "صوف"}, {"id": 20, "arabic": "وَأَوْبَارِهَا", "translit": "āَhِrāَbْwَaʾَw", "root": "وبر"}, {"id": 21, "arabic": "وَأَشْعَارِهَآ", "translit": "ٓāَhِrāَʿعْhsَaʾَw", "root": "شعر"}, {"id": 22, "arabic": "أَثَٰثًا", "translit": "āًhtَٰhtَaʾ", "root": "اثث"}, {"id": 23, "arabic": "وَمَتَٰعًا", "translit": "āًʿعَٰtَmَw", "root": "متع"}, {"id": 24, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 25, "arabic": "حِينٍ", "translit": "ٍnyِḥ", "root": "حين"}], "hasIhya": false}, {"ayah": 81, "text": "وَٱللَّهُ جَعَلَ لَكُم مِّمَّا خَلَقَ ظِلَٰلًا وَجَعَلَ لَكُم مِّنَ ٱلْجِبَالِ أَكْنَٰنًا وَجَعَلَ لَكُمْ سَرَٰبِيلَ تَقِيكُمُ ٱلْحَرَّ وَسَرَٰبِيلَ تَقِيكُم بَأْسَكُمْۚ كَذَٰلِكَ يُتِمُّ نِعْمَتَهُۥ عَلَيْكُمْ لَعَلَّكُمْ تُسْلِمُونَ ", "translation": "And Allāh has made for you, from that which He has created, shadows [i.e., shade] and has made for you from the mountains, shelters and has made for you garments which protect you from the heat and garments [i.e., coats of mail] which protect you from your [enemy in] battle. Thus does He complete His favor upon you that you might submit [to Him].", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 4, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "ظِلَٰلًا", "translit": "āًlَٰlِẓ", "root": "ظلل"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلْجِبَالِ", "translit": "ِlāَbِjgْlٱ", "root": "جبل"}, {"id": 11, "arabic": "أَكْنَٰنًا", "translit": "āًnَٰnْkَaʾ", "root": "كنن"}, {"id": 12, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 13, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 14, "arabic": "سَرَٰبِيلَ", "translit": "َlyِbَٰrَs", "root": "سربل"}, {"id": 15, "arabic": "تَقِيكُمُ", "translit": "ُmُkyِqَt", "root": "وقي"}, {"id": 16, "arabic": "ٱلْحَرَّ", "translit": "َّrَḥْlٱ", "root": "حرر"}, {"id": 17, "arabic": "وَسَرَٰبِيلَ", "translit": "َlyِbَٰrَsَw", "root": "سربل"}, {"id": 18, "arabic": "تَقِيكُم", "translit": "mُkyِqَt", "root": "وقي"}, {"id": 19, "arabic": "بَأْسَكُمْ", "translit": "ْmُkَsْaʾَb", "root": "باس"}, {"id": 20, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 21, "arabic": "يُتِمُّ", "translit": "ُّmِtُy", "root": "تمم"}, {"id": 22, "arabic": "نِعْمَتَهُۥ", "translit": "ۥُhَtَmْʿعِn", "root": "نعم"}, {"id": 23, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 24, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 25, "arabic": "تُسْلِمُونَ", "translit": "َnwُmِlْsُt", "root": "سلم"}], "hasIhya": false}, {"ayah": 82, "text": "فَإِن تَوَلَّوْا۟ فَإِنَّمَا عَلَيْكَ ٱلْبَلَٰغُ ٱلْمُبِينُ ", "translation": "But if they turn away, [O Muḥammad] - then only upon you is [responsibility for] clear notification.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 3, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 4, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 6, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 83, "text": "يَعْرِفُونَ نِعْمَتَ ٱللَّهِ ثُمَّ يُنكِرُونَهَا وَأَكْثَرُهُمُ ٱلْكَٰفِرُونَ ", "translation": "They recognize the favor of Allāh; then they deny it. And most of them are disbelievers.", "words": [{"id": 1, "arabic": "يَعْرِفُونَ", "translit": "َnwُfِrْʿعَy", "root": "عرف"}, {"id": 2, "arabic": "نِعْمَتَ", "translit": "َtَmْʿعِn", "root": "نعم"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "يُنكِرُونَهَا", "translit": "āَhَnwُrِknُy", "root": "نكر"}, {"id": 6, "arabic": "وَأَكْثَرُهُمُ", "translit": "ُmُhُrَhtْkَaʾَw", "root": "كثر"}, {"id": 7, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 84, "text": "وَيَوْمَ نَبْعَثُ مِن كُلِّ أُمَّةٍ شَهِيدًا ثُمَّ لَا يُؤْذَنُ لِلَّذِينَ كَفَرُوا۟ وَلَا هُمْ يُسْتَعْتَبُونَ ", "translation": "And [mention] the Day when We will resurrect from every nation a witness [i.e., their prophet]. Then it will not be permitted to the disbelievers [to apologize or make excuses], nor will they be asked to appease [Allāh].", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "نَبْعَثُ", "translit": "ُhtَʿعْbَn", "root": "بعث"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يُؤْذَنُ", "translit": "ُnَhdْwʾُy", "root": "اذن"}, {"id": 10, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 11, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 14, "arabic": "يُسْتَعْتَبُونَ", "translit": "َnwُbَtْʿعَtْsُy", "root": "عتب"}], "hasIhya": false}, {"ayah": 85, "text": "وَإِذَا رَءَا ٱلَّذِينَ ظَلَمُوا۟ ٱلْعَذَابَ فَلَا يُخَفَّفُ عَنْهُمْ وَلَا هُمْ يُنظَرُونَ ", "translation": "And when those who wronged see the punishment, it will not be lightened for them, nor will they be reprieved.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "رَءَا", "translit": "āَءَr", "root": "راي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 5, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 6, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 7, "arabic": "يُخَفَّفُ", "translit": "ُfَّfَhkُy", "root": "خفف"}, {"id": 8, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 11, "arabic": "يُنظَرُونَ", "translit": "َnwُrَẓnُy", "root": "نظر"}], "hasIhya": false}, {"ayah": 86, "text": "وَإِذَا رَءَا ٱلَّذِينَ أَشْرَكُوا۟ شُرَكَآءَهُمْ قَالُوا۟ رَبَّنَا هَٰٓؤُلَآءِ شُرَكَآؤُنَا ٱلَّذِينَ كُنَّا نَدْعُوا۟ مِن دُونِكَۖ فَأَلْقَوْا۟ إِلَيْهِمُ ٱلْقَوْلَ إِنَّكُمْ لَكَٰذِبُونَ ", "translation": "And when those who associated others with Allāh see their \"partners,\" they will say, \"Our Lord, these are our partners [to You] whom we used to invoke [in worship] besides You.\" But they will throw at them the statement, \"Indeed, you are liars.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "رَءَا", "translit": "āَءَr", "root": "راي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 5, "arabic": "شُرَكَآءَهُمْ", "translit": "ْmُhَءٓāَkَrُhs", "root": "شرك"}, {"id": 6, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 7, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 8, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 9, "arabic": "شُرَكَآؤُنَا", "translit": "āَnُwʾٓāَkَrُhs", "root": "شرك"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 12, "arabic": "نَدْعُوا۟", "translit": "۟āwُʿعْdَn", "root": "دعو"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "دُونِكَ", "translit": "َkِnwُd", "root": "دون"}, {"id": 15, "arabic": "فَأَلْقَوْا۟", "translit": "۟āْwَqْlَaʾَf", "root": "لقي"}, {"id": 16, "arabic": "إِلَيْهِمُ", "translit": "ُmِhْyَlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱلْقَوْلَ", "translit": "َlْwَqْlٱ", "root": "قول"}, {"id": 18, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 19, "arabic": "لَكَٰذِبُونَ", "translit": "َnwُbِhdَٰkَl", "root": "كذب"}], "hasIhya": false}, {"ayah": 87, "text": "وَأَلْقَوْا۟ إِلَى ٱللَّهِ يَوْمَئِذٍ ٱلسَّلَمَۖ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ", "translation": "And they will impart to Allāh that Day [their] submission, and lost from them is what they used to invent.", "words": [{"id": 1, "arabic": "وَأَلْقَوْا۟", "translit": "۟āْwَqْlَaʾَw", "root": "لقي"}, {"id": 2, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 5, "arabic": "ٱلسَّلَمَ", "translit": "َmَlَّslٱ", "root": "سلم"}, {"id": 6, "arabic": "وَضَلَّ", "translit": "َّlَḍَw", "root": "ضلل"}, {"id": 7, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}], "hasIhya": false}, {"ayah": 88, "text": "ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ زِدْنَٰهُمْ عَذَابًا فَوْقَ ٱلْعَذَابِ بِمَا كَانُوا۟ يُفْسِدُونَ ", "translation": "Those who disbelieved and averted [others] from the way of Allāh - We will increase them in punishment over [their] punishment for what corruption they were causing.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 3, "arabic": "وَصَدُّوا۟", "translit": "۟āwُّdَṣَw", "root": "صدد"}, {"id": 4, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 5, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "زِدْنَٰهُمْ", "translit": "ْmُhَٰnْdِz", "root": "زيد"}, {"id": 8, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 9, "arabic": "فَوْقَ", "translit": "َqْwَf", "root": "فوق"}, {"id": 10, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 11, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يُفْسِدُونَ", "translit": "َnwُdِsْfُy", "root": "فسد"}], "hasIhya": false}, {"ayah": 89, "text": "وَيَوْمَ نَبْعَثُ فِى كُلِّ أُمَّةٍ شَهِيدًا عَلَيْهِم مِّنْ أَنفُسِهِمْۖ وَجِئْنَا بِكَ شَهِيدًا عَلَىٰ هَٰٓؤُلَآءِۚ وَنَزَّلْنَا عَلَيْكَ ٱلْكِتَٰبَ تِبْيَٰنًا لِّكُلِّ شَىْءٍ وَهُدًى وَرَحْمَةً وَبُشْرَىٰ لِلْمُسْلِمِينَ ", "translation": "And [mention] the Day when We will resurrect among every nation a witness over them from themselves [i.e., their prophet]. And We will bring you, [O Muḥammad], as a witness over these [i.e., your nation]. And We have sent down to you the Book as clarification for all things and as guidance and mercy and good tidings for the Muslims.[1]", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "نَبْعَثُ", "translit": "ُhtَʿعْbَn", "root": "بعث"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}, {"id": 7, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 9, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 10, "arabic": "وَجِئْنَا", "translit": "āَnْyʾِjgَw", "root": "جيا"}, {"id": 11, "arabic": "بِكَ", "translit": "َkِb", "root": ""}, {"id": 12, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 15, "arabic": "وَنَزَّلْنَا", "translit": "āَnْlَّzَnَw", "root": "نزل"}, {"id": 16, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 17, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 18, "arabic": "تِبْيَٰنًا", "translit": "āًnَٰyْbِt", "root": "بين"}, {"id": 19, "arabic": "لِّكُلِّ", "translit": "ِّlُkِّl", "root": "كلل"}, {"id": 20, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 21, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 22, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 23, "arabic": "وَبُشْرَىٰ", "translit": "ٰàَrْhsُbَw", "root": "بشر"}, {"id": 24, "arabic": "لِلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlِl", "root": "سلم"}], "hasIhya": false}, {"ayah": 90, "text": "إِنَّ ٱللَّهَ يَأْمُرُ بِٱلْعَدْلِ وَٱلْإِحْسَٰنِ وَإِيتَآئِ ذِى ٱلْقُرْبَىٰ وَيَنْهَىٰ عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ وَٱلْبَغْىِۚ يَعِظُكُمْ لَعَلَّكُمْ تَذَكَّرُونَ ", "translation": "Indeed, Allāh orders justice and good conduct and giving [help] to relatives and forbids immorality and bad conduct and oppression. He admonishes you that perhaps you will be reminded.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "يَأْمُرُ", "translit": "ُrُmْaʾَy", "root": "امر"}, {"id": 4, "arabic": "بِٱلْعَدْلِ", "translit": "ِlْdَʿعْlٱِb", "root": "عدل"}, {"id": 5, "arabic": "وَٱلْإِحْسَٰنِ", "translit": "ِnَٰsْḥِiʾْlٱَw", "root": "حسن"}, {"id": 6, "arabic": "وَإِيتَآئِ", "translit": "ِyʾٓāَtyِiʾَw", "root": "اتي"}, {"id": 7, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 8, "arabic": "ٱلْقُرْبَىٰ", "translit": "ٰàَbْrُqْlٱ", "root": "قرب"}, {"id": 9, "arabic": "وَيَنْهَىٰ", "translit": "ٰàَhْnَyَw", "root": "نهي"}, {"id": 10, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 11, "arabic": "ٱلْفَحْشَآءِ", "translit": "ِءٓāَhsْḥَfْlٱ", "root": "فحش"}, {"id": 12, "arabic": "وَٱلْمُنكَرِ", "translit": "ِrَknُmْlٱَw", "root": "نكر"}, {"id": 13, "arabic": "وَٱلْبَغْىِ", "translit": "ِàْغَbْlٱَw", "root": "بغي"}, {"id": 14, "arabic": "يَعِظُكُمْ", "translit": "ْmُkُẓِʿعَy", "root": "وعظ"}, {"id": 15, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 16, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": true}, {"ayah": 91, "text": "وَأَوْفُوا۟ بِعَهْدِ ٱللَّهِ إِذَا عَٰهَدتُّمْ وَلَا تَنقُضُوا۟ ٱلْأَيْمَٰنَ بَعْدَ تَوْكِيدِهَا وَقَدْ جَعَلْتُمُ ٱللَّهَ عَلَيْكُمْ كَفِيلًاۚ إِنَّ ٱللَّهَ يَعْلَمُ مَا تَفْعَلُونَ ", "translation": "And fulfill the covenant of Allāh when you have taken it, [O believers], and do not break oaths after their confirmation while you have made Allāh, over you, a security [i.e., witness]. Indeed, Allāh knows what you do.", "words": [{"id": 1, "arabic": "وَأَوْفُوا۟", "translit": "۟āwُfْwَaʾَw", "root": "وفي"}, {"id": 2, "arabic": "بِعَهْدِ", "translit": "ِdْhَʿعِb", "root": "عهد"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "عَٰهَدتُّمْ", "translit": "ْmُّtdَhَٰʿع", "root": "عهد"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَنقُضُوا۟", "translit": "۟āwُḍُqnَt", "root": "نقض"}, {"id": 8, "arabic": "ٱلْأَيْمَٰنَ", "translit": "َnَٰmْyَaʾْlٱ", "root": "يمن"}, {"id": 9, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "تَوْكِيدِهَا", "translit": "āَhِdyِkْwَt", "root": "وكد"}, {"id": 11, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 12, "arabic": "جَعَلْتُمُ", "translit": "ُmُtْlَʿعَjg", "root": "جعل"}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 15, "arabic": "كَفِيلًا", "translit": "āًlyِfَk", "root": "كفل"}, {"id": 16, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 19, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 20, "arabic": "تَفْعَلُونَ", "translit": "َnwُlَʿعْfَt", "root": "فعل"}], "hasIhya": false}, {"ayah": 92, "text": "وَلَا تَكُونُوا۟ كَٱلَّتِى نَقَضَتْ غَزْلَهَا مِنۢ بَعْدِ قُوَّةٍ أَنكَٰثًا تَتَّخِذُونَ أَيْمَٰنَكُمْ دَخَلًۢا بَيْنَكُمْ أَن تَكُونَ أُمَّةٌ هِىَ أَرْبَىٰ مِنْ أُمَّةٍۚ إِنَّمَا يَبْلُوكُمُ ٱللَّهُ بِهِۦۚ وَلَيُبَيِّنَنَّ لَكُمْ يَوْمَ ٱلْقِيَٰمَةِ مَا كُنتُمْ فِيهِ تَخْتَلِفُونَ ", "translation": "And do not be like she who untwisted her spun thread after it was strong [by] taking your oaths as [means of] deceit between you because one community is more plentiful [in number or wealth] than another community.[1] Allāh only tries you thereby. And He will surely make clear to you on the Day of Resurrection that over which you used to differ.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 3, "arabic": "كَٱلَّتِى", "translit": "àِtَّlٱَk", "root": ""}, {"id": 4, "arabic": "نَقَضَتْ", "translit": "ْtَḍَqَn", "root": "نقض"}, {"id": 5, "arabic": "غَزْلَهَا", "translit": "āَhَlْzَغ", "root": "غزل"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "قُوَّةٍ", "translit": "ٍẗَّwُq", "root": "قوي"}, {"id": 9, "arabic": "أَنكَٰثًا", "translit": "āًhtَٰknَaʾ", "root": "نكث"}, {"id": 10, "arabic": "تَتَّخِذُونَ", "translit": "َnwُhdِhkَّtَt", "root": "اخذ"}, {"id": 11, "arabic": "أَيْمَٰنَكُمْ", "translit": "ْmُkَnَٰmْyَaʾ", "root": "يمن"}, {"id": 12, "arabic": "دَخَلًۢا", "translit": "āًۢlَhkَd", "root": "دخل"}, {"id": 13, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "تَكُونَ", "translit": "َnwُkَt", "root": "كون"}, {"id": 16, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 17, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 18, "arabic": "أَرْبَىٰ", "translit": "ٰàَbْrَaʾ", "root": "ربو"}, {"id": 19, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 20, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 21, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 22, "arabic": "يَبْلُوكُمُ", "translit": "ُmُkwُlْbَy", "root": "بلو"}, {"id": 23, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 25, "arabic": "وَلَيُبَيِّنَنَّ", "translit": "َّnَnِّyَbُyَlَw", "root": "بين"}, {"id": 26, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 27, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 28, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 29, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 30, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 31, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 32, "arabic": "تَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَt", "root": "خلف"}], "hasIhya": false}, {"ayah": 93, "text": "وَلَوْ شَآءَ ٱللَّهُ لَجَعَلَكُمْ أُمَّةً وَٰحِدَةً وَلَٰكِن يُضِلُّ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُۚ وَلَتُسْـَٔلُنَّ عَمَّا كُنتُمْ تَعْمَلُونَ ", "translation": "And if Allāh had willed, He could have made you [of] one religion, but He sends astray whom He wills and guides whom He wills.[1] And you will surely be questioned about what you used to do.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لَجَعَلَكُمْ", "translit": "ْmُkَlَʿعَjgَl", "root": "جعل"}, {"id": 5, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 8, "arabic": "يُضِلُّ", "translit": "ُّlِḍُy", "root": "ضلل"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 11, "arabic": "وَيَهْدِى", "translit": "àِdْhَyَw", "root": "هدي"}, {"id": 12, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 13, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 14, "arabic": "وَلَتُسْـَٔلُنَّ", "translit": "َّnُlَٔـْsُtَlَw", "root": "سال"}, {"id": 15, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 16, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 17, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 94, "text": "وَلَا تَتَّخِذُوٓا۟ أَيْمَٰنَكُمْ دَخَلًۢا بَيْنَكُمْ فَتَزِلَّ قَدَمٌۢ بَعْدَ ثُبُوتِهَا وَتَذُوقُوا۟ ٱلسُّوٓءَ بِمَا صَدَدتُّمْ عَن سَبِيلِ ٱللَّهِۖ وَلَكُمْ عَذَابٌ عَظِيمٌ ", "translation": "And do not take your oaths as [means of] deceit between you, lest a foot slip after it was [once] firm, and you would taste evil [in this world] for what [people] you diverted from the way of Allāh,[1] and you would have [in the Hereafter] a great punishment.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَتَّخِذُوٓا۟", "translit": "۟āٓwُhdِhkَّtَt", "root": "اخذ"}, {"id": 3, "arabic": "أَيْمَٰنَكُمْ", "translit": "ْmُkَnَٰmْyَaʾ", "root": "يمن"}, {"id": 4, "arabic": "دَخَلًۢا", "translit": "āًۢlَhkَd", "root": "دخل"}, {"id": 5, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 6, "arabic": "فَتَزِلَّ", "translit": "َّlِzَtَf", "root": "زلل"}, {"id": 7, "arabic": "قَدَمٌۢ", "translit": "ٌۢmَdَq", "root": "قدم"}, {"id": 8, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 9, "arabic": "ثُبُوتِهَا", "translit": "āَhِtwُbُht", "root": "ثبت"}, {"id": 10, "arabic": "وَتَذُوقُوا۟", "translit": "۟āwُqwُhdَtَw", "root": "ذوق"}, {"id": 11, "arabic": "ٱلسُّوٓءَ", "translit": "َءٓwُّslٱ", "root": "سوا"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "صَدَدتُّمْ", "translit": "ْmُّtdَdَṣ", "root": "صدد"}, {"id": 14, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 15, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 18, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 19, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 95, "text": "وَلَا تَشْتَرُوا۟ بِعَهْدِ ٱللَّهِ ثَمَنًا قَلِيلًاۚ إِنَّمَا عِندَ ٱللَّهِ هُوَ خَيْرٌ لَّكُمْ إِن كُنتُمْ تَعْلَمُونَ ", "translation": "And do not exchange the covenant of Allāh for a small price. Indeed, what is with Allāh is best for you, if only you could know.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَشْتَرُوا۟", "translit": "۟āwُrَtْhsَt", "root": "شري"}, {"id": 3, "arabic": "بِعَهْدِ", "translit": "ِdْhَʿعِb", "root": "عهد"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 6, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 7, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 8, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 12, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 15, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 96, "text": "مَا عِندَكُمْ يَنفَدُۖ وَمَا عِندَ ٱللَّهِ بَاقٍۗ وَلَنَجْزِيَنَّ ٱلَّذِينَ صَبَرُوٓا۟ أَجْرَهُم بِأَحْسَنِ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Whatever you have will end, but what Allāh has is lasting. And We will surely give those who were patient their reward according to the best of what they used to do.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "عِندَكُمْ", "translit": "ْmُkَdnِʿع", "root": "عند"}, {"id": 3, "arabic": "يَنفَدُ", "translit": "ُdَfnَy", "root": "نفد"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "بَاقٍ", "translit": "ٍqāَb", "root": "بقي"}, {"id": 8, "arabic": "وَلَنَجْزِيَنَّ", "translit": "َّnَyِzْjgَnَlَw", "root": "جزي"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "صَبَرُوٓا۟", "translit": "۟āٓwُrَbَṣ", "root": "صبر"}, {"id": 11, "arabic": "أَجْرَهُم", "translit": "mُhَrْjgَaʾ", "root": "اجر"}, {"id": 12, "arabic": "بِأَحْسَنِ", "translit": "ِnَsْḥَaʾِb", "root": "حسن"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 15, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": true}, {"ayah": 97, "text": "مَنْ عَمِلَ صَٰلِحًا مِّن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَلَنُحْيِيَنَّهُۥ حَيَوٰةً طَيِّبَةًۖ وَلَنَجْزِيَنَّهُمْ أَجْرَهُم بِأَحْسَنِ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Whoever does righteousness, whether male or female, while he is a believer - We will surely cause him to live a good life, and We will surely give them their reward [in the Hereafter] according to the best of what they used to do.", "words": [{"id": 1, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 2, "arabic": "عَمِلَ", "translit": "َlِmَʿع", "root": "عمل"}, {"id": 3, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "ذَكَرٍ", "translit": "ٍrَkَhd", "root": "ذكر"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "أُنثَىٰ", "translit": "ٰàَhtnُaʾ", "root": "انث"}, {"id": 8, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 9, "arabic": "مُؤْمِنٌ", "translit": "ٌnِmْwʾُm", "root": "امن"}, {"id": 10, "arabic": "فَلَنُحْيِيَنَّهُۥ", "translit": "ۥُhَّnَyِyْḥُnَlَf", "root": "حيي"}, {"id": 11, "arabic": "حَيَوٰةً", "translit": "ًẗٰwَyَḥ", "root": "حيي"}, {"id": 12, "arabic": "طَيِّبَةً", "translit": "ًẗَbِّyَṭ", "root": "طيب"}, {"id": 13, "arabic": "وَلَنَجْزِيَنَّهُمْ", "translit": "ْmُhَّnَyِzْjgَnَlَw", "root": "جزي"}, {"id": 14, "arabic": "أَجْرَهُم", "translit": "mُhَrْjgَaʾ", "root": "اجر"}, {"id": 15, "arabic": "بِأَحْسَنِ", "translit": "ِnَsْḥَaʾِb", "root": "حسن"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 98, "text": "فَإِذَا قَرَأْتَ ٱلْقُرْءَانَ فَٱسْتَعِذْ بِٱللَّهِ مِنَ ٱلشَّيْطَٰنِ ٱلرَّجِيمِ ", "translation": "So when you recite the Qur’ān, [first] seek refuge in Allāh from Satan, the expelled [from His mercy].", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "قَرَأْتَ", "translit": "َtْaʾَrَq", "root": "قرا"}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "فَٱسْتَعِذْ", "translit": "ْhdِʿعَtْsٱَf", "root": "عوذ"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 8, "arabic": "ٱلرَّجِيمِ", "translit": "ِmyِjgَّrlٱ", "root": "رجم"}], "hasIhya": true}, {"ayah": 99, "text": "إِنَّهُۥ لَيْسَ لَهُۥ سُلْطَٰنٌ عَلَى ٱلَّذِينَ ءَامَنُوا۟ وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ ", "translation": "Indeed, there is for him no authority over those who have believed and rely upon their Lord.", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "سُلْطَٰنٌ", "translit": "ٌnَٰṭْlُs", "root": "سلط"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 9, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 10, "arabic": "يَتَوَكَّلُونَ", "translit": "َnwُlَّkَwَtَy", "root": "وكل"}], "hasIhya": false}, {"ayah": 100, "text": "إِنَّمَا سُلْطَٰنُهُۥ عَلَى ٱلَّذِينَ يَتَوَلَّوْنَهُۥ وَٱلَّذِينَ هُم بِهِۦ مُشْرِكُونَ ", "translation": "His authority is only over those who take him as an ally and those who through him associate others with Allāh.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "سُلْطَٰنُهُۥ", "translit": "ۥُhُnَٰṭْlُs", "root": "سلط"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَتَوَلَّوْنَهُۥ", "translit": "ۥُhَnْwَّlَwَtَy", "root": "ولي"}, {"id": 6, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 7, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 8, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 9, "arabic": "مُشْرِكُونَ", "translit": "َnwُkِrْhsُm", "root": "شرك"}], "hasIhya": false}, {"ayah": 101, "text": "وَإِذَا بَدَّلْنَآ ءَايَةً مَّكَانَ ءَايَةٍۙ وَٱللَّهُ أَعْلَمُ بِمَا يُنَزِّلُ قَالُوٓا۟ إِنَّمَآ أَنتَ مُفْتَرٍۭۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ", "translation": "And when We substitute a verse in place of a verse - and Allāh is most knowing of what He sends down - they say, \"You, [O Muḥammad], are but an inventor [of lies].\" But most of them do not know.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "بَدَّلْنَآ", "translit": "ٓāَnْlَّdَb", "root": "بدل"}, {"id": 3, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 4, "arabic": "مَّكَانَ", "translit": "َnāَkَّm", "root": "كون"}, {"id": 5, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 8, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 9, "arabic": "يُنَزِّلُ", "translit": "ُlِّzَnُy", "root": "نزل"}, {"id": 10, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 11, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 12, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 13, "arabic": "مُفْتَرٍۭ", "translit": "ٍۭrَtْfُm", "root": "فري"}, {"id": 14, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 15, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 102, "text": "قُلْ نَزَّلَهُۥ رُوحُ ٱلْقُدُسِ مِن رَّبِّكَ بِٱلْحَقِّ لِيُثَبِّتَ ٱلَّذِينَ ءَامَنُوا۟ وَهُدًى وَبُشْرَىٰ لِلْمُسْلِمِينَ ", "translation": "Say, [O Muḥammad], \"The Pure Spirit [i.e., Gabriel] has brought it down from your Lord in truth to make firm those who believe and as guidance and good tidings to the Muslims.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "نَزَّلَهُۥ", "translit": "ۥُhَlَّzَn", "root": "نزل"}, {"id": 3, "arabic": "رُوحُ", "translit": "ُḥwُr", "root": "روح"}, {"id": 4, "arabic": "ٱلْقُدُسِ", "translit": "ِsُdُqْlٱ", "root": "قدس"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 8, "arabic": "لِيُثَبِّتَ", "translit": "َtِّbَhtُyِl", "root": "ثبت"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 11, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 12, "arabic": "وَبُشْرَىٰ", "translit": "ٰàَrْhsُbَw", "root": "بشر"}, {"id": 13, "arabic": "لِلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlِl", "root": "سلم"}], "hasIhya": true}, {"ayah": 103, "text": "وَلَقَدْ نَعْلَمُ أَنَّهُمْ يَقُولُونَ إِنَّمَا يُعَلِّمُهُۥ بَشَرٌۗ لِّسَانُ ٱلَّذِى يُلْحِدُونَ إِلَيْهِ أَعْجَمِىٌّ وَهَٰذَا لِسَانٌ عَرَبِىٌّ مُّبِينٌ ", "translation": "And We certainly know that they say, \"It is only a human being who teaches him [i.e., the Prophet (ﷺ)].\" The tongue of the one they refer to is foreign,[1] and this [recitation, i.e., Qur’ān] is [in] a clear Arabic language.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "نَعْلَمُ", "translit": "ُmَlْʿعَn", "root": "علم"}, {"id": 3, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 5, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 6, "arabic": "يُعَلِّمُهُۥ", "translit": "ۥُhُmِّlَʿعُy", "root": "علم"}, {"id": 7, "arabic": "بَشَرٌ", "translit": "ٌrَhsَb", "root": "بشر"}, {"id": 8, "arabic": "لِّسَانُ", "translit": "ُnāَsِّl", "root": "لسن"}, {"id": 9, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "يُلْحِدُونَ", "translit": "َnwُdِḥْlُy", "root": "لحد"}, {"id": 11, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 12, "arabic": "أَعْجَمِىٌّ", "translit": "ٌّàِmَjgْʿعَaʾ", "root": "عجم"}, {"id": 13, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 14, "arabic": "لِسَانٌ", "translit": "ٌnāَsِl", "root": "لسن"}, {"id": 15, "arabic": "عَرَبِىٌّ", "translit": "ٌّàِbَrَʿع", "root": "عرب"}, {"id": 16, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 104, "text": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِـَٔايَٰتِ ٱللَّهِ لَا يَهْدِيهِمُ ٱللَّهُ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "Indeed, those who do not believe in the verses of Allāh - Allāh will not guide them, and for them is a painful punishment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَهْدِيهِمُ", "translit": "ُmِhyِdْhَy", "root": "هدي"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 105, "text": "إِنَّمَا يَفْتَرِى ٱلْكَذِبَ ٱلَّذِينَ لَا يُؤْمِنُونَ بِـَٔايَٰتِ ٱللَّهِۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْكَٰذِبُونَ ", "translation": "They only invent falsehood who do not believe in the verses of Allāh, and it is those who are the liars.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَفْتَرِى", "translit": "àِrَtْfَy", "root": "فري"}, {"id": 3, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 7, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 10, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 11, "arabic": "ٱلْكَٰذِبُونَ", "translit": "َnwُbِhdَٰkْlٱ", "root": "كذب"}], "hasIhya": true}, {"ayah": 106, "text": "مَن كَفَرَ بِٱللَّهِ مِنۢ بَعْدِ إِيمَٰنِهِۦٓ إِلَّا مَنْ أُكْرِهَ وَقَلْبُهُۥ مُطْمَئِنٌّۢ بِٱلْإِيمَٰنِ وَلَٰكِن مَّن شَرَحَ بِٱلْكُفْرِ صَدْرًا فَعَلَيْهِمْ غَضَبٌ مِّنَ ٱللَّهِ وَلَهُمْ عَذَابٌ عَظِيمٌ ", "translation": "Whoever disbelieves in [i.e., denies] Allāh after his belief...[1] except for one who is forced [to renounce his religion] while his heart is secure in faith. But those who [willingly] open their breasts to disbelief, upon them is wrath from Allāh, and for them is a great punishment;", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "إِيمَٰنِهِۦٓ", "translit": "ٓۦِhِnَٰmyِiʾ", "root": "امن"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 9, "arabic": "أُكْرِهَ", "translit": "َhِrْkُaʾ", "root": "كره"}, {"id": 10, "arabic": "وَقَلْبُهُۥ", "translit": "ۥُhُbْlَqَw", "root": "قلب"}, {"id": 11, "arabic": "مُطْمَئِنٌّۢ", "translit": "ٌّۢnِyʾَmْṭُm", "root": "طمان"}, {"id": 12, "arabic": "بِٱلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlٱِb", "root": "امن"}, {"id": 13, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 14, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 15, "arabic": "شَرَحَ", "translit": "َḥَrَhs", "root": "شرح"}, {"id": 16, "arabic": "بِٱلْكُفْرِ", "translit": "ِrْfُkْlٱِb", "root": "كفر"}, {"id": 17, "arabic": "صَدْرًا", "translit": "āًrْdَṣ", "root": "صدر"}, {"id": 18, "arabic": "فَعَلَيْهِمْ", "translit": "ْmِhْyَlَʿعَf", "root": ""}, {"id": 19, "arabic": "غَضَبٌ", "translit": "ٌbَḍَغ", "root": "غضب"}, {"id": 20, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 23, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 24, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 107, "text": "ذَٰلِكَ بِأَنَّهُمُ ٱسْتَحَبُّوا۟ ٱلْحَيَوٰةَ ٱلدُّنْيَا عَلَى ٱلْءَاخِرَةِ وَأَنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلْكَٰفِرِينَ ", "translation": "That is because they preferred the worldly life over the Hereafter and that Allāh does not guide the disbelieving people.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُمُ", "translit": "ُmُhَّnَaʾِb", "root": ""}, {"id": 3, "arabic": "ٱسْتَحَبُّوا۟", "translit": "۟āwُّbَḥَtْsٱ", "root": "حبب"}, {"id": 4, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 12, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 13, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 108, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ طَبَعَ ٱللَّهُ عَلَىٰ قُلُوبِهِمْ وَسَمْعِهِمْ وَأَبْصَٰرِهِمْۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْغَٰفِلُونَ ", "translation": "Those are the ones over whose hearts and hearing and vision Allāh has sealed, and it is those who are the heedless.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "طَبَعَ", "translit": "َʿعَbَṭ", "root": "طبع"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 7, "arabic": "وَسَمْعِهِمْ", "translit": "ْmِhِʿعْmَsَw", "root": "سمع"}, {"id": 8, "arabic": "وَأَبْصَٰرِهِمْ", "translit": "ْmِhِrَٰṣْbَaʾَw", "root": "بصر"}, {"id": 9, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 10, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 11, "arabic": "ٱلْغَٰفِلُونَ", "translit": "َnwُlِfَٰغْlٱ", "root": "غفل"}], "hasIhya": false}, {"ayah": 109, "text": "لَا جَرَمَ أَنَّهُمْ فِى ٱلْءَاخِرَةِ هُمُ ٱلْخَٰسِرُونَ ", "translation": "Assuredly, it is they, in the Hereafter, who will be the losers.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "جَرَمَ", "translit": "َmَrَjg", "root": "جرم"}, {"id": 3, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 6, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 7, "arabic": "ٱلْخَٰسِرُونَ", "translit": "َnwُrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": true}, {"ayah": 110, "text": "ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا۟ مِنۢ بَعْدِ مَا فُتِنُوا۟ ثُمَّ جَٰهَدُوا۟ وَصَبَرُوٓا۟ إِنَّ رَبَّكَ مِنۢ بَعْدِهَا لَغَفُورٌ رَّحِيمٌ ", "translation": "Then, indeed your Lord, to those who emigrated after they had been compelled [to say words of disbelief] and thereafter fought [for the cause of Allāh] and were patient - indeed, your Lord, after that, is Forgiving and Merciful", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 4, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 5, "arabic": "هَاجَرُوا۟", "translit": "۟āwُrَjgāَh", "root": "هجر"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "فُتِنُوا۟", "translit": "۟āwُnِtُf", "root": "فتن"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "جَٰهَدُوا۟", "translit": "۟āwُdَhَٰjg", "root": "جهد"}, {"id": 12, "arabic": "وَصَبَرُوٓا۟", "translit": "۟āٓwُrَbَṣَw", "root": "صبر"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 15, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 16, "arabic": "بَعْدِهَا", "translit": "āَhِdْʿعَb", "root": "بعد"}, {"id": 17, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 18, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 111, "text": "يَوْمَ تَأْتِى كُلُّ نَفْسٍ تُجَٰدِلُ عَن نَّفْسِهَا وَتُوَفَّىٰ كُلُّ نَفْسٍ مَّا عَمِلَتْ وَهُمْ لَا يُظْلَمُونَ ", "translation": "On the Day when every soul will come disputing [i.e., pleading] for itself, and every soul will be fully compensated for what it did, and they will not be wronged [i.e., treated unjustly].", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تَأْتِى", "translit": "àِtْaʾَt", "root": "اتي"}, {"id": 3, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 4, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 5, "arabic": "تُجَٰدِلُ", "translit": "ُlِdَٰjgُt", "root": "جدل"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "نَّفْسِهَا", "translit": "āَhِsْfَّn", "root": "نفس"}, {"id": 8, "arabic": "وَتُوَفَّىٰ", "translit": "ٰàَّfَwُtَw", "root": "وفي"}, {"id": 9, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 10, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 11, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 12, "arabic": "عَمِلَتْ", "translit": "ْtَlِmَʿع", "root": "عمل"}, {"id": 13, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": true}, {"ayah": 112, "text": "وَضَرَبَ ٱللَّهُ مَثَلًا قَرْيَةً كَانَتْ ءَامِنَةً مُّطْمَئِنَّةً يَأْتِيهَا رِزْقُهَا رَغَدًا مِّن كُلِّ مَكَانٍ فَكَفَرَتْ بِأَنْعُمِ ٱللَّهِ فَأَذَٰقَهَا ٱللَّهُ لِبَاسَ ٱلْجُوعِ وَٱلْخَوْفِ بِمَا كَانُوا۟ يَصْنَعُونَ ", "translation": "And Allāh presents an example: a city [i.e., Makkah] which was safe and secure, its provision coming to it in abundance from every location, but it denied the favors of Allāh. So Allāh made it taste the envelopment of hunger and fear for what they had been doing.", "words": [{"id": 1, "arabic": "وَضَرَبَ", "translit": "َbَrَḍَw", "root": "ضرب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "قَرْيَةً", "translit": "ًẗَyْrَq", "root": "قري"}, {"id": 5, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 6, "arabic": "ءَامِنَةً", "translit": "ًẗَnِmāَء", "root": "امن"}, {"id": 7, "arabic": "مُّطْمَئِنَّةً", "translit": "ًẗَّnِyʾَmْṭُّm", "root": "طمان"}, {"id": 8, "arabic": "يَأْتِيهَا", "translit": "āَhyِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "رِزْقُهَا", "translit": "āَhُqْzِr", "root": "رزق"}, {"id": 10, "arabic": "رَغَدًا", "translit": "āًdَغَr", "root": "رغد"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 13, "arabic": "مَكَانٍ", "translit": "ٍnāَkَm", "root": "كون"}, {"id": 14, "arabic": "فَكَفَرَتْ", "translit": "ْtَrَfَkَf", "root": "كفر"}, {"id": 15, "arabic": "بِأَنْعُمِ", "translit": "ِmُʿعْnَaʾِb", "root": "نعم"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "فَأَذَٰقَهَا", "translit": "āَhَqَٰhdَaʾَf", "root": "ذوق"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "لِبَاسَ", "translit": "َsāَbِl", "root": "لبس"}, {"id": 20, "arabic": "ٱلْجُوعِ", "translit": "ِʿعwُjgْlٱ", "root": "جوع"}, {"id": 21, "arabic": "وَٱلْخَوْفِ", "translit": "ِfْwَhkْlٱَw", "root": "خوف"}, {"id": 22, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 23, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 24, "arabic": "يَصْنَعُونَ", "translit": "َnwُʿعَnْṣَy", "root": "صنع"}], "hasIhya": false}, {"ayah": 113, "text": "وَلَقَدْ جَآءَهُمْ رَسُولٌ مِّنْهُمْ فَكَذَّبُوهُ فَأَخَذَهُمُ ٱلْعَذَابُ وَهُمْ ظَٰلِمُونَ ", "translation": "And there had certainly come to them a Messenger from among themselves, but they denied him; so punishment overtook them while they were wrongdoers.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 4, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 5, "arabic": "فَكَذَّبُوهُ", "translit": "ُhwُbَّhdَkَf", "root": "كذب"}, {"id": 6, "arabic": "فَأَخَذَهُمُ", "translit": "ُmُhَhdَhkَaʾَf", "root": "اخذ"}, {"id": 7, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "ظَٰلِمُونَ", "translit": "َnwُmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 114, "text": "فَكُلُوا۟ مِمَّا رَزَقَكُمُ ٱللَّهُ حَلَٰلًا طَيِّبًا وَٱشْكُرُوا۟ نِعْمَتَ ٱللَّهِ إِن كُنتُمْ إِيَّاهُ تَعْبُدُونَ ", "translation": "Then eat of what Allāh has provided for you [which is] lawful and good. And be grateful for the favor of Allāh, if it is [indeed] Him that you worship.", "words": [{"id": 1, "arabic": "فَكُلُوا۟", "translit": "۟āwُlُkَf", "root": "اكل"}, {"id": 2, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 3, "arabic": "رَزَقَكُمُ", "translit": "ُmُkَqَzَr", "root": "رزق"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "حَلَٰلًا", "translit": "āًlَٰlَḥ", "root": "حلل"}, {"id": 6, "arabic": "طَيِّبًا", "translit": "āًbِّyَṭ", "root": "طيب"}, {"id": 7, "arabic": "وَٱشْكُرُوا۟", "translit": "۟āwُrُkْhsٱَw", "root": "شكر"}, {"id": 8, "arabic": "نِعْمَتَ", "translit": "َtَmْʿعِn", "root": "نعم"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 11, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 12, "arabic": "إِيَّاهُ", "translit": "ُhāَّyِiʾ", "root": ""}, {"id": 13, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}], "hasIhya": false}, {"ayah": 115, "text": "إِنَّمَا حَرَّمَ عَلَيْكُمُ ٱلْمَيْتَةَ وَٱلدَّمَ وَلَحْمَ ٱلْخِنزِيرِ وَمَآ أُهِلَّ لِغَيْرِ ٱللَّهِ بِهِۦۖ فَمَنِ ٱضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "He has only forbidden to you dead animals,[1] blood, the flesh of swine, and that which has been dedicated to other than Allāh. But whoever is forced [by necessity], neither desiring [it] nor transgressing [its limit] - then indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 3, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْمَيْتَةَ", "translit": "َẗَtْyَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَٱلدَّمَ", "translit": "َmَّdlٱَw", "root": "دمو"}, {"id": 6, "arabic": "وَلَحْمَ", "translit": "َmْḥَlَw", "root": "لحم"}, {"id": 7, "arabic": "ٱلْخِنزِيرِ", "translit": "ِryِznِhkْlٱ", "root": "خنزر"}, {"id": 8, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 9, "arabic": "أُهِلَّ", "translit": "َّlِhُaʾ", "root": "هلل"}, {"id": 10, "arabic": "لِغَيْرِ", "translit": "ِrْyَغِl", "root": "غير"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 14, "arabic": "ٱضْطُرَّ", "translit": "َّrُṭْḍٱ", "root": "ضرر"}, {"id": 15, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 16, "arabic": "بَاغٍ", "translit": "ٍغāَb", "root": "بغي"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "عَادٍ", "translit": "ٍdāَʿع", "root": "عدو"}, {"id": 19, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 22, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 116, "text": "وَلَا تَقُولُوا۟ لِمَا تَصِفُ أَلْسِنَتُكُمُ ٱلْكَذِبَ هَٰذَا حَلَٰلٌ وَهَٰذَا حَرَامٌ لِّتَفْتَرُوا۟ عَلَى ٱللَّهِ ٱلْكَذِبَۚ إِنَّ ٱلَّذِينَ يَفْتَرُونَ عَلَى ٱللَّهِ ٱلْكَذِبَ لَا يُفْلِحُونَ ", "translation": "And do not say about what your tongues assert of untruth, \"This is lawful and this is unlawful,\" to invent falsehood about Allāh. Indeed, those who invent falsehood about Allāh will not succeed.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 3, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 4, "arabic": "تَصِفُ", "translit": "ُfِṣَt", "root": "وصف"}, {"id": 5, "arabic": "أَلْسِنَتُكُمُ", "translit": "ُmُkُtَnِsْlَaʾ", "root": "لسن"}, {"id": 6, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 7, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 8, "arabic": "حَلَٰلٌ", "translit": "ٌlَٰlَḥ", "root": "حلل"}, {"id": 9, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 10, "arabic": "حَرَامٌ", "translit": "ٌmāَrَḥ", "root": "حرم"}, {"id": 11, "arabic": "لِّتَفْتَرُوا۟", "translit": "۟āwُrَtْfَtِّl", "root": "فري"}, {"id": 12, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}, {"id": 18, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "يُفْلِحُونَ", "translit": "َnwُḥِlْfُy", "root": "فلح"}], "hasIhya": false}, {"ayah": 117, "text": "مَتَٰعٌ قَلِيلٌ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "[It is but] a brief enjoyment, and they will have a painful punishment.", "words": [{"id": 1, "arabic": "مَتَٰعٌ", "translit": "ٌʿعَٰtَm", "root": "متع"}, {"id": 2, "arabic": "قَلِيلٌ", "translit": "ٌlyِlَq", "root": "قلل"}, {"id": 3, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 4, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 118, "text": "وَعَلَى ٱلَّذِينَ هَادُوا۟ حَرَّمْنَا مَا قَصَصْنَا عَلَيْكَ مِن قَبْلُۖ وَمَا ظَلَمْنَٰهُمْ وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ", "translation": "And to those who are Jews We have prohibited that which We related to you before.[1] And We did not wrong them [thereby], but they were wronging themselves.", "words": [{"id": 1, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 4, "arabic": "حَرَّمْنَا", "translit": "āَnْmَّrَḥ", "root": "حرم"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "قَصَصْنَا", "translit": "āَnْṣَṣَq", "root": "قصص"}, {"id": 7, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "ظَلَمْنَٰهُمْ", "translit": "ْmُhَٰnْmَlَẓ", "root": "ظلم"}, {"id": 12, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 13, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 14, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 15, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 119, "text": "ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا۟ ٱلسُّوٓءَ بِجَهَٰلَةٍ ثُمَّ تَابُوا۟ مِنۢ بَعْدِ ذَٰلِكَ وَأَصْلَحُوٓا۟ إِنَّ رَبَّكَ مِنۢ بَعْدِهَا لَغَفُورٌ رَّحِيمٌ ", "translation": "Then, indeed your Lord, to those who have done wrong out of ignorance and then repent after that and correct themselves - indeed, your Lord, thereafter, is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 4, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 5, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 6, "arabic": "ٱلسُّوٓءَ", "translit": "َءٓwُّslٱ", "root": "سوا"}, {"id": 7, "arabic": "بِجَهَٰلَةٍ", "translit": "ٍẗَlَٰhَjgِb", "root": "جهل"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "تَابُوا۟", "translit": "۟āwُbāَt", "root": "توب"}, {"id": 10, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 11, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "وَأَصْلَحُوٓا۟", "translit": "۟āٓwُḥَlْṣَaʾَw", "root": "صلح"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 16, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 17, "arabic": "بَعْدِهَا", "translit": "āَhِdْʿعَb", "root": "بعد"}, {"id": 18, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 19, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 120, "text": "إِنَّ إِبْرَٰهِيمَ كَانَ أُمَّةً قَانِتًا لِّلَّهِ حَنِيفًا وَلَمْ يَكُ مِنَ ٱلْمُشْرِكِينَ ", "translation": "Indeed, Abraham was a [comprehensive] leader,[1] devoutly obedient to Allāh, inclining toward truth, and he was not of those who associate others with Allāh.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 5, "arabic": "قَانِتًا", "translit": "āًtِnāَq", "root": "قنت"}, {"id": 6, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 7, "arabic": "حَنِيفًا", "translit": "āًfyِnَḥ", "root": "حنف"}, {"id": 8, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 9, "arabic": "يَكُ", "translit": "ُkَy", "root": "كون"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": true}, {"ayah": 121, "text": "شَاكِرًا لِّأَنْعُمِهِۚ ٱجْتَبَىٰهُ وَهَدَىٰهُ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "[He was] grateful for His favors. He [i.e., Allāh] chose him and guided him to a straight path.", "words": [{"id": 1, "arabic": "شَاكِرًا", "translit": "āًrِkāَhs", "root": "شكر"}, {"id": 2, "arabic": "لِّأَنْعُمِهِ", "translit": "ِhِmُʿعْnَaʾِّl", "root": "نعم"}, {"id": 3, "arabic": "ٱجْتَبَىٰهُ", "translit": "ُhٰàَbَtْjgٱ", "root": "جبي"}, {"id": 4, "arabic": "وَهَدَىٰهُ", "translit": "ُhٰàَdَhَw", "root": "هدي"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 7, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 122, "text": "وَءَاتَيْنَٰهُ فِى ٱلدُّنْيَا حَسَنَةًۖ وَإِنَّهُۥ فِى ٱلْءَاخِرَةِ لَمِنَ ٱلصَّٰلِحِينَ ", "translation": "And We gave him good in this world, and indeed, in the Hereafter he will be among the righteous.", "words": [{"id": 1, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 4, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 5, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 9, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 123, "text": "ثُمَّ أَوْحَيْنَآ إِلَيْكَ أَنِ ٱتَّبِعْ مِلَّةَ إِبْرَٰهِيمَ حَنِيفًاۖ وَمَا كَانَ مِنَ ٱلْمُشْرِكِينَ ", "translation": "Then We revealed to you, [O Muḥammad], to follow the religion of Abraham, inclining toward truth; and he was not of those who associate with Allāh.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾ", "root": "وحي"}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 5, "arabic": "ٱتَّبِعْ", "translit": "ْʿعِbَّtٱ", "root": "تبع"}, {"id": 6, "arabic": "مِلَّةَ", "translit": "َẗَّlِm", "root": "ملل"}, {"id": 7, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 8, "arabic": "حَنِيفًا", "translit": "āًfyِnَḥ", "root": "حنف"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": true}, {"ayah": 124, "text": "إِنَّمَا جُعِلَ ٱلسَّبْتُ عَلَى ٱلَّذِينَ ٱخْتَلَفُوا۟ فِيهِۚ وَإِنَّ رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ ٱلْقِيَٰمَةِ فِيمَا كَانُوا۟ فِيهِ يَخْتَلِفُونَ ", "translation": "The sabbath was only appointed for those who differed over it. And indeed, your Lord will judge between them on the Day of Resurrection concerning that over which they used to differ.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "جُعِلَ", "translit": "َlِʿعُjg", "root": "جعل"}, {"id": 3, "arabic": "ٱلسَّبْتُ", "translit": "ُtْbَّslٱ", "root": "سبت"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 9, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 10, "arabic": "لَيَحْكُمُ", "translit": "ُmُkْḥَyَl", "root": "حكم"}, {"id": 11, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 12, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 13, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 14, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 15, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 16, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 17, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": false}, {"ayah": 125, "text": "ٱدْعُ إِلَىٰ سَبِيلِ رَبِّكَ بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ ٱلْحَسَنَةِۖ وَجَٰدِلْهُم بِٱلَّتِى هِىَ أَحْسَنُۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ ", "translation": "Invite to the way of your Lord with wisdom and good instruction, and argue with them in a way that is best. Indeed, your Lord is most knowing of who has strayed from His way, and He is most knowing of who is [rightly] guided.", "words": [{"id": 1, "arabic": "ٱدْعُ", "translit": "ُʿعْdٱ", "root": "دعو"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 4, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 5, "arabic": "بِٱلْحِكْمَةِ", "translit": "ِẗَmْkِḥْlٱِb", "root": "حكم"}, {"id": 6, "arabic": "وَٱلْمَوْعِظَةِ", "translit": "ِẗَẓِʿعْwَmْlٱَw", "root": "وعظ"}, {"id": 7, "arabic": "ٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱ", "root": "حسن"}, {"id": 8, "arabic": "وَجَٰدِلْهُم", "translit": "mُhْlِdَٰjgَw", "root": "جدل"}, {"id": 9, "arabic": "بِٱلَّتِى", "translit": "àِtَّlٱِb", "root": ""}, {"id": 10, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 11, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 12, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 13, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 16, "arabic": "بِمَن", "translit": "nَmِb", "root": ""}, {"id": 17, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 18, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 19, "arabic": "سَبِيلِهِۦ", "translit": "ۦِhِlyِbَs", "root": "سبل"}, {"id": 20, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 21, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 22, "arabic": "بِٱلْمُهْتَدِينَ", "translit": "َnyِdَtْhُmْlٱِb", "root": "هدي"}], "hasIhya": true}, {"ayah": 126, "text": "وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا۟ بِمِثْلِ مَا عُوقِبْتُم بِهِۦۖ وَلَئِن صَبَرْتُمْ لَهُوَ خَيْرٌ لِّلصَّٰبِرِينَ ", "translation": "And if you punish [an enemy, O believers], punish with an equivalent of that with which you were harmed.[1] But if you are patient - it is better for those who are patient.", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 2, "arabic": "عَاقَبْتُمْ", "translit": "ْmُtْbَqāَʿع", "root": "عقب"}, {"id": 3, "arabic": "فَعَاقِبُوا۟", "translit": "۟āwُbِqāَʿعَf", "root": "عقب"}, {"id": 4, "arabic": "بِمِثْلِ", "translit": "ِlْhtِmِb", "root": "مثل"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "عُوقِبْتُم", "translit": "mُtْbِqwُʿع", "root": "عقب"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 9, "arabic": "صَبَرْتُمْ", "translit": "ْmُtْrَbَṣ", "root": "صبر"}, {"id": 10, "arabic": "لَهُوَ", "translit": "َwُhَl", "root": ""}, {"id": 11, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 12, "arabic": "لِّلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlِّl", "root": "صبر"}], "hasIhya": true}, {"ayah": 127, "text": "وَٱصْبِرْ وَمَا صَبْرُكَ إِلَّا بِٱللَّهِۚ وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُ فِى ضَيْقٍ مِّمَّا يَمْكُرُونَ ", "translation": "And be patient, [O Muḥammad], and your patience is not but through Allāh. And do not grieve over them and do not be in distress over what they conspire.", "words": [{"id": 1, "arabic": "وَٱصْبِرْ", "translit": "ْrِbْṣٱَw", "root": "صبر"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 3, "arabic": "صَبْرُكَ", "translit": "َkُrْbَṣ", "root": "صبر"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَحْزَنْ", "translit": "ْnَzْḥَt", "root": "حزن"}, {"id": 8, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "تَكُ", "translit": "ُkَt", "root": "كون"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ضَيْقٍ", "translit": "ٍqْyَḍ", "root": "ضيق"}, {"id": 13, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 14, "arabic": "يَمْكُرُونَ", "translit": "َnwُrُkْmَy", "root": "مكر"}], "hasIhya": false}, {"ayah": 128, "text": "إِنَّ ٱللَّهَ مَعَ ٱلَّذِينَ ٱتَّقَوا۟ وَّٱلَّذِينَ هُم مُّحْسِنُونَ ", "translation": "Indeed, Allāh is with those who fear Him and those who are doers of good.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "ٱتَّقَوا۟", "translit": "۟āwَqَّtٱ", "root": "وقي"}, {"id": 6, "arabic": "وَّٱلَّذِينَ", "translit": "َnyِhdَّlٱَّw", "root": ""}, {"id": 7, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 8, "arabic": "مُّحْسِنُونَ", "translit": "َnwُnِsْḥُّm", "root": "حسن"}], "hasIhya": true}], "tafsir": {"2": [{"arabic": "الروح من أمره على من يشاء من عباده} وأحال الإغواء على إبليس فقال تعالى {ليضل عن سبيله} والإغواء هو استيقاف العباد دون بلوغ غاية الحكمة فانظر كيف نسبه إلى العبد الذي غضب عليه والإرشاد سياقه لهم إلى الغاية فانظر كيف نسبه إلى العبد الذي أحبه وعندك في العادة له مثال فالملك إذا كان محتاجا إلى من يسقيه الشراب وإلى من يحجمه وينظف فناء منزله عن القاذورات وكان له عبدان فلا يعين للحجامة والتنظيف إلا أقبحهما وأخسهما ولا يفوض حمل الشراب والطيب إلا إلى أحسنهما وأكملهما وأحبهما إليه ولا ينبغ", "english": "Thus was the beginning of this matter and its end. And do not understand it unless you are worthy of it. And if you are worthy of it, the eye is opened and you see, so you have no need of a leader to lead you. The blind man can indeed be led, but only to a limit. For when the path narrows and becomes sharper than a sword and finer than a hair, the bird is able to fly over it but is not able to drag a blind man behind it. And when the field becomes narrow and subtle — subtle as water, for example — and crossing is possible only by swimming, then the one skilled in the art of swimming may be able to cross by himself, and perhaps he is not able to drag another behind him. These matters bear the same relation to walking upon the way of the common masses of creatures as walking upon water bears to walking upon earth. Swimming can be learned; but as for walking upon water, it is not acquired by instruction, but rather is attained through the strength of certainty (yaqīn). For this reason it was said to the Prophet, peace be upon him, that Jesus, peace be upon him, was said to have walked upon water, and he, peace be upon him, said: \"Had his certainty increased, he would have walked upon the air.\" {«حديث قيل له يقال إن عيسى مشى على الماء قال لو ازداد يقينا لمشي على الهواء»} — This hadith is rejected (munkar) and is not known in this form. What is known is what Ibn Abi al-Dunya narrated in the Book of Certainty from the saying of Bakr ibn Abd Allah al-Muzani, who said: The disciples lost their Prophet, and it was said to them: \"He has headed toward the sea.\" So they set out seeking him, and when they reached the sea, behold, he was coming toward them walking upon the water. And he mentioned a hadith in which Jesus said: \"If the son of Adam had a hair's breadth of certainty, he would walk upon the water.\" And Abu Mansur al-Daylami narrated in the Musnad al-Firdaws with a weak chain from the hadith of Muadh ibn Jabal: \"If you knew God with true knowledge, you would walk upon the seas, and the mountains would be removed by your supplications.\" These are symbols and allusions to the meaning of aversion (karāhah) and love (maḥabbah), and good pleasure (riḍā) and wrath (ghaḍab), and gratitude (shukr) and ingratitude (kufrān) — more than this is not fitting for the science of practical conduct (ʿilm al-muʿāmalah). And God, exalted be He, struck an example of this to draw it near to the understanding of creatures, since He knew that He created the jinn and mankind only to worship Him, and their worship was the ultimate purpose of wisdom (ghāyat al-ḥikmah) with respect to them. Then He informed that He has two servants: one whom He loves, whose name is Gabriel — the Holy Spirit and the Trustworthy One — and he is with Him beloved, obeyed, trustworthy, and honored; and another whom He hates, whose name is Iblis — the accursed one, reprieved until the Day of Judgment. Then He delegated guidance (irshād) to Gabriel, saying, the Exalted: {«قل نزله روح القدس من ربك بالحق»} \"Say: The Holy Spirit has brought it down from your Lord with truth\" (16:102), and said, the Exalted: {«يلقي الروح من أمره على من يشاء من عباده»} \"He casts the Spirit of His command upon whom He wills of His servants\" (40:15). And He delegated misguidance (ighwāʾ) to Iblis, saying, the Exalted: {«ليضل عن سبيله»} \"That he may lead astray from His path\" (4:119). And ighwāʾ is the halting of servants short of attaining the ultimate purpose of wisdom. So observe how He attributed it to the servant with whom He was wrathful; and guidance (irshād) is the conduct of them toward the ultimate purpose — so observe how He attributed it to the servant whom He loves. And you have an example of this in custom: when a king is in need of one to give him drink and one to cup him and to clean the courtyard of his house of filth, and he has two servants, he does not appoint for cupping and cleaning except the ugliest and meanest of them, and he does not entrust the carrying of drink and perfume except to the best and most complete of them and the most beloved to him. And you should not say: \"This is my act, and his act was not without my act\" — for you have erred when you attributed that to yourself. Rather, He is the One who directed your motive (dāʿiyah) to the specification of the disliked act to the disliked person, and the beloved act to the beloved person, as a completion of justice (ʿadl). For His justice is sometimes completed through matters in which you have no entry, and sometimes it is completed in you — for you also are among His acts. So your motive, your power, your knowledge, your action, and all the other causes of your movements in expression — all of this is His act, which He arranged with justice in an arrangement from which moderate acts issue forth. Except that you see only yourself, and so you suppose that what appears through you in the world of witness (ʿālam al-shahādah) has no cause from the world of the unseen and the dominion (ʿālam al-ghayb wa al-malakūt). Therefore you attribute it to yourself. And you are only like the child who looks at night at the play of the juggler (mushʿabadh) who brings forth figures from behind a curtain that dance and scream and rise and sit, composed of rags that do not move by themselves — rather, they are moved by fine hair-like threads that do not appear in the darkness of night, their ends in the hand of the juggler, who is hidden from the eyes of the children. So they rejoice and marvel, supposing that those rags dance and play and rise and sit. As for the intelligent ones, they know that this is a moving (taḥrīk) and not a self-movement, but perhaps they do not know its detailed modality. And the one who knows some of its detail does not know it as the juggler knows it, to whom the command belongs and in whose hand is the pulling. Likewise, the children of the people of this world — and all creatures are children relative to the scholars — look at these persons (ashkhāṣ) and suppose that they are the movers, and so they attribute [action] to them. And the scholars know that they are moved, except that they do not know the modality of the moving — and they are the majority. Except the knowers (ʿārifūn), the scholars, and those firmly rooted in knowledge (al-rāsikhūn), for they have perceived, with the sharpness of their sight, fine spider-web threads — nay, much finer than these — suspended from heaven, their ends attached to the persons of the people of the earth. Those threads are not perceived, due to their fineness, by these outward eyes. Then they witnessed the heads of those threads in their suspension-points (manāṭāt) to which they are attached, and they witnessed for those suspension-points handles (maqābiḍ) that are in the hands of the angels who move the heavens. And they also witnessed the angels of the heavens directed toward the bearers of the Throne (ḥamalat al-ʿarsh), awaiting what descends upon them of the command from the presence of Lordship (ḥaḍrat al-rubūbiyyah) — \"they do not disobey God in what He commands them, and they do what they are commanded\" (66:6). And He expressed these witnessed realities in the Qur'an, and it was said: {«وفي السماء رزقكم وما توعدون»} \"And in the heaven is your provision and what you are promised\" (51:22). And He expressed the waiting of the angels of the heavens for what descends upon them of decree and command, and it was said: \"He created seven heavens and of the earth the like of them; {«يتنزل الأمر بينهن لتعلموا أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما»} 'the command descends between them, that you may know that God is powerful over all things and that God encompasses all things in knowledge'\" (65:12). These are matters whose interpretation (taʾwīl) none knows except God and those firmly rooted in knowledge (al-rāsikhūn fī al-ʿilm). And Ibn Abbas, may God be pleased with them both, expressed the exclusivity of those firmly rooted in knowledge to sciences that the understandings of creatures cannot bear, when he recited the saying of the Exalted: {«يتنزل الأمر بينهن»} \"The command descends between them,\" and said: \"Were I to mention what I know of the meaning of this verse, you would stone me\" — and in another wording: \"You would say he is an unbeliever.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 990", "section_title_en": "On the Degrees of Proximity to God and the Hierarchy of Those Who Perfect Divine Wisdom", "section_index": 990, "anchors": "- Root: سير (s-y-r)\n  * Lisan / Ayn: \"السير: الذهاب والسفر، وسار يسير سيرا ومسيرا، والسيارة: الرفقة المسافرة\"\n  * Al-Raghib (Mufradat): \"السير: الانتقال من مكان إلى مكان، ويستعار للسلوك في الدين والطريقة\"\n  * Al-Zamakhshari (Asas): [Literal] \"سار القوم: مشوا\" — [Metaphorical] \"سار فيه السير: مضى في الأمر، وسار ذكره: انتشر، ومنه: سيرة فلان: طريقته\"\n- Root: مشي (m-sh-y)\n  * Lisan / Ayn: \"المشي: تردد الأركان على الأرض، والماشية: الإبل والغنم لانتقالها في المرعى\"\n  * Al-Raghib (Mufradat): \"المشي: الانتقال من مكان إلى مكان بإرادة، ويكنى به عن النميمة، وعن شرب المسهل\"\n  * Al-Zamakhshari (Asas): [Literal] \"مشيت وتمشيت، وهي حسنة المشية\" — [Metaphorical] \"مشى بطنه، وأمشاه الدواء، واستمشيت بالدواء، ومنه: مشت المرأة: كثرت أولادها\"\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: \"الخلق: التقدير، والخلق: الناس، والخليقة: الطبيعة، والخلق: السجية\"\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\"\n  * Al-Zamakhshari (Asas): [Literal] \"خلق الخراز الأديم: قدره قبل القطع\" — [Metaphorical] \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\"\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: \"النفس: الروح، والذات، والشيء النفيس\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتطلق على الذات، قال تعالى: {ويحذركم الله نفسه} فنفسه: ذاته\"\n  * Al-Zamakhshari (Asas): [Literal] \"شيء نفيس ومنفس\" — [Metaphorical] \"دفق نفسه أي دمه، وأصابته نفس: عين\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish exclusive attribution of actions to God versus creatures, as in \"إنما أنت مثل الصبي\" (You are only like a child), restricting the simile to the creature while preserving divine agency.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}, {"arabic": "وجل في كلام يردده في نفسه كما لو سمع وهو يقول {إنني أنا الله لا إله إلا أنا فاعبدني} فإنه ما كان ينبغي أن يفهم منه ذلك إلا على سبيل الحكاية الصنف الثاني من الشطح كلمات غير مفهومة لها ظواهر رائقة وفيها عبارات هائلة وليس وراءها طائل إما أن تكون غير مفهومة عند قائلها بل يصدرها عن خبط في عقله وتشويش في خياله لقلة إحاطته بمعنى كلام قرع سمعه وهذا هو الأكثر وإما أن تكون مفهومة له ولكنه لا يقدر على تفهيمها وإيرادها بعبارة تدل على ضميره لقلة ممارسته للعلم وعدم تعلمه طريق التعبير عن المعاني بالألفاظ الرشيقة ولا فائدة لهذا الجنس من ا", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "8": [{"arabic": "فيها وكم من الموجودات التى لا نعلمها كما قال الله تعالى ويخلق ما لا تعلمون سبحان الذي خلق الأزواج كلها مما تنبت الأرض ومن أنفسهم ومما لا يعلمون {وقال} وننشئكم فيما لا تعلمون {وإلى} ما يعرف أصلها وجملتها ولا يعرف تفصيلها فيمكننا أن نتفكر في تفصيلها وهي منقسمة إلى ما أدركناه بحس البصر وإلى ما لا ندركه بالبصر أما الذي لا ندركه بالبصر فكالملائكة والجن والشياطين والعرش والكرسي وغير ذلك ومجال الفكر في هذه الأشياء مما يضيق ويغمض فلنعدل إلى الأقرب إلى الأفهام وهي المدركات بحس البصر وذلك هو السموات السبع والأرض وما بينهما", "english": "We say: Created existents are divided into that whose origin is unknown to us, such that we cannot contemplate it—and how many are the existents we do not know! As God Most High said: {«وَيَخْلُقُ مَا لَا تَعْلَمُونَ»} (And He creates what you do not know — Q. 16:8), and {«سُبْحَانَ الَّذِي خَلَقَ الْأَزْوَاجَ كُلَّهَا مِمَّا تُنبِتُ الْأَرْضُ وَمِنْ أَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ»} (Glory be to Him who created all pairs, of what the earth grows, and of themselves, and of what they do not know — Q. 36:36), and He said: {«وَنُنشِئُكُمْ فِيمَا لَا تَعْلَمُونَ»} (And We raise you up in what you do not know — Q. 56:61). And [it is divided] into that whose origin and general nature are known, but whose detailed particulars are not known—so we are able to contemplate its details.", "book_title": "Contemplation", "section_title_ar": "Section 1268", "section_title_en": "Exposition of the Method of Contemplation upon the Creation of God Most High", "section_index": 1268, "anchors": "- Root: فكر (f-k-r)\n  * Lisan / Ayn: Core meaning is reflection, deliberation, and the movement of the mind over a matter to arrive at its reality.\n  * Al-Raghib (Mufradat): In theological usage, *tafakkur* is the soul's journey through created things (al-makhlūqāt) to derive knowledge of the Creator—it is the bridge from the sensory to the intelligible.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is mental consideration; metaphorical (majāz) extension applies it to the heart's \"seeing\" of divine wisdom latent in creation.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Root meaning is measuring, proportioning, and fashioning a thing with precise estimation.\n  * Al-Raghib (Mufradat): *Khalq* denotes origination from nothing (ibdāʿ) or creation of one thing from another, always upon a measure necessitated by wisdom.\n  * Al-Zamakhshari (Asas): Literal: the artisan's sizing of material before cutting; Metaphorical: God's bringing things into existence upon a measure that wisdom dictates—He is Rabb al-khalīqah.\n- Root: بصر (b-ṣ-r)\n  * Lisan / Ayn: Core meaning is sight, both ocular and perceptive.\n  * Al-Raghib (Mufradat): *Baṣar* applies to the eye's organ and its power, and to the heart's perceptive faculty (*baṣīrah*), as in {«فَكَشَفْنَا عَنكَ غِطَاءَكَ فَبَصَرُكَ الْيَوْمَ حَدِيدٌ»} (Q. 50:22).\n  * Al-Zamakhshari (Asas): Literal: physical sight; Metaphorical: *ibṣār* as intellectual discernment—\"هذه آية مبصرة\" (this is an illuminating sign).\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: Core meaning is the self, the soul, the vital principle.\n  * Al-Raghib (Mufradat): *Nafs* denotes the rational soul (al-rūḥ) and also the very essence (al-dhāt); in {«وَفِي أَنفُسِكُمْ أَفَلَا تُبْصِرُونَ»} (Q. 51:21) it refers to the human self as a microcosmic sign.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity; Metaphorical: the inner dimension of man as a locus of divine signs.\n- Sibawayh Rule: Rule of Specification and Restriction (Bāb al-Takhṣīṣ) — When a general term (like \"everything in existence\") is followed by a restrictive clause (\"save God\"), the syntax governs the scope of predication, ensuring the exception is precise and the universal claim is bounded.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "9": [{"arabic": "{ثم إن علينا بيانه} وقال {وعلى الله قصد السبيل} وقال علي كرم الله وجهه الهوى شريك العمى ومن التوفيق التوقف عند الحيرة ونعم طارد الهم اليقين وعاقبة الكذب الندم وفي الصدق السلامة رب بعيد أقرب من قريب وغريب من لم يكن له حبيب والصديق من صدق غيبه ولا يعدمك من حبيب سوء ظن نعم الخلق التكرم والحياء سبب إلى كل جميل وأوثق العرا التقوى واوثق سبب أخذت به سبب بينك وبين الله تعالى إنما لك من دنياك ما أصلحت به مثواك والرزق رزقان رزق تطلبه ورزق يطلبك فان لم تأته أتاك وإن كنت جازعا على ما أصيب مما في يدي", "english": "This pausing at the beginnings of matters, up to the point of clarity, is an obligatory and inescapable duty (wājib maḥtūm) from which no one has any evasion. For it is related in the report (khabar) that for every movement of the servant — however small — three registers (dawāwīn) are unfolded: the first register [asks] \"Why?\" (lim), the second \"How?\" (kayfa), and the third \"For whom?\" (liman). The meaning of \"Why?\" is: Why did you do this? Was it incumbent upon you to do it for your Master, or did you incline toward it out of your lust and caprice? If he is delivered from this — because it was incumbent upon him to do it for his Master — he is asked about the second register, and it is said to him: \"How did you do this?\" For God has in every deed a condition and a ruling whose measure, time, and description cannot be grasped except through knowledge. So it is said to him: \"How did you act — with verified knowledge, or with ignorance and conjecture?\" If he is delivered from this, the third register is unfolded, which is the summons to sincerity (ikhlāṣ). It is said to him: \"For whom did you act? Was it for the Face of God, purely, in fulfillment of your utterance 'There is no god but God' — so that your reward is with God? Or was it for the show of creatures like yourself — then take your reward from them? Or did you do it to attain the immediate [goods] of your worldly life — then we have paid you in full your share of this world? Or did you do it in heedlessness and forgetfulness — then your reward has fallen away, your deed is void, and your striving has failed. And if you acted for other than Me, then you have incurred My wrath and My punishment — for you were a servant of Mine, eating My provision and enjoying My bounty, yet you act for other than Me! Have you not heard Me say: {Those whom you call upon besides God are servants like yourselves} and {Those you worship besides God possess no provision for you, so seek provision from God and worship Him}? Woe to you! Have you not heard Me say: {Surely, to God belongs the pure religion}?\"", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1236", "section_title_en": "The Twofold Vigilance: Examining the Intention Before Action and Perfecting the Action Itself", "section_index": 1236, "anchors": "- Root: رقب (Raqaba)\n  * Lisan / Ayn: To watch, observe, await, and guard; the watcher (raqīb) is one who is on the lookout, not heedless.\n  * Al-Raghib (Mufradat): Moral vigilance (murāqabah) is the soul's persistent awareness that God is ever-watchful over its secret thoughts and open deeds, necessitating reverence (ḥayā') and self-accounting.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is physical watching; here it is metaphorical (majāz) for the heart's state of reverent awe and continuous self-scrutiny before the Divine.\n- Sibawayh Rule: Restriction & Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — Used to isolate the exclusive motive for action (for God alone vs. for caprice), as in the interrogation \"for whom did you act?\"", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "12": [{"arabic": "والعالم الراسخ هو الذي يطلع على أن الشمس والقمر والنجوم مسخرات بأمره سبحانه وتعالى ومثال نظر الضعيف إلى حصول ضوء الشمس عقيب طلوع الشمس مثال النملة لو خلق لها عقل وكانت على سطح قرطاس وهي تنظر إلى سواد الخط يتجدد فتعتقد أنه فعل القلم ولا تترقى في نظرها إلى مشاهدة الأصابع ثم منها إلى اليد ثم منها إلى الإرادة المحركة اليد ثم منها إلى الكاتب القادر المريد ثم منه إلى خالق اليد والقدرة والإرادة فأكثر نظر الخلق مقصور على الأسباب القريبة السافلة مقطوع من الترقي إلى مسبب الأسباب فهذا أحد أسباب النهي عن النجوم وثانيها", "english": "You may say: \"Knowledge is the apprehension of a thing as it is, and it is among the attributes of God, exalted be He. How then can a thing be knowledge, and while being knowledge, be blameworthy?\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 25", "section_title_en": "Section 25 — On the Exposition of the Manner in Which Some Sciences May Be Blameworthy, and the Exposition of the Alteration of the Names of the Sciences — Namely Jurisprudence (Fiqh), Knowledge (ʿIlm), Divine Unity (Tawḥīd), Reminder (Tadhkīr), and Wisdom (Ḥikmah) — and the Exposition of the Praiseworthy Measure of the Religious Sciences and the Blameworthy Measure Thereof", "section_index": 25, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core root denotes the trace or mark by which a thing is known; ʿilm is the apprehension of a thing as it is (idrāk al-shayʾ ʿalā mā huwa bihi), encompassing both the perception of the thing's essence and the judgment of its attributes.\n  * Al-Raghib (Mufradat): ʿIlm is \"the apprehension of a thing by its reality\" (إدراك الشيء بحقيقته), divided into the apprehension of the thing's essence and the judgment upon it. As a divine attribute, it is not blameworthy in itself; blame attaches only to its relation to human subjects.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (ḥaqīqah) from the metaphorical extension whereby a \"learned\" man may be called ignorant when his knowledge harms him — the term ʿilm is transferred (manqūl) in blame contexts to denote what is not truly beneficial knowledge.\n- Root: س ب ب (s-b-b)\n  * Lisan / Ayn: The rope by which one climbs to the palm-tree; extended to any means by which one reaches a thing.\n  * Al-Raghib (Mufradat): \"Every means by which one arrives at a thing is called a sabab\" — thus the science of the properties of substances and stellar computations is a \"cause\" (sabab) that may lead to harm, and the means to evil is evil.\n  * Al-Zamakhshari (Asas): Literal usage denotes a physical cord or tie; metaphorical usage (majāz) extends to any instrumental cause, whether beneficial or harmful.\n- Root: ع ق ل (ʿ-q-l)\n  * Lisan / Ayn: The intellect as that which binds and restrains; its root sense is of a fetter or halter that prevents the soul from straying.\n  * Al-Raghib (Mufradat): The intellect is that by which one apprehends realities; its proper function is to lead one to the truth of prophecy, after which it must be restrained from independent speculation in matters beyond its scope.\n  * Al-Zamakhshari (Asas): Literal usage denotes the binding of the camel; metaphorical usage denotes the restraint of the soul from error.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد بإنما) — When the author states \"knowledge is not blamed for its essence but only in relation to servants for one of three causes,\" the restriction (ḥaṣr) via \"innamā\" confines blame to the relational aspect, not the essence, requiring the translator to preserve this precise logical scope.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "18": [{"arabic": "الأرض وآخرهم الخباز وإن تعدوا نعمة الله لا تحصوها // حديث لا يستدير الرغيف ويوضع بين يديك حتى يعمل فيه ثلثمائة وستون صانعا أولهم ميكائيل الحديث لم أجد له أصل وقال بعضهم أتيت قاسما الجرعي فسألت عن الزهد أي شيء هو فقال أي شيء سمعت فيه فعددت أقوالا فسكت فقلت أي شيء تقول أنت فقال اعلم أن البطن دنيا العبد فبقدر ما يملك من بطنه يملك من الزهد وبقدر ما يملكه بطنه تملكه الدنيا وكان بشر بن الحرث قد اعتل مرة فأتى عبد الرحمن الطبيب يسأله عن شيء يوافقه من المأكولات فقال تسألني فإذا وصفت لك لم تقبل مني قال صف", "english": "I left it upon a loaf of bread, then I met a boy and said: \"Are you not the son of so-and-so, whose father has died?\" He replied: \"Yes.\" So I handed it to him. They said: And he came forward weeping and reciting: {«وَيُطْعِمُونَ الطَّعَامَ عَلَىٰ حُبِّهِ مِسْكِينًا وَيَتِيمًا وَأَسِيرًا»} — \"And they give food, despite their love for it, to the poor, the orphan, and the captive\" {«الإنسان: 8»}. Then he did not taste it after that, and he remained craving dates for years. Then one day, he bought dates for a qīrāṭ and raised them until nightfall to break his fast upon them. He said: Then a violent wind blew until the world grew dark, and the people were terrified. So ʿUtbah turned upon his self, saying: \"This is for my audacity against You, and my buying of dates for a qīrāṭ.\" Then he said to his self: \"I do not think that the people were seized except by your sin—on condition that you do not taste them.\" And Dāwūd al-Ṭāʾī bought greens for half a fals and vinegar for a fals, and he spent his entire night saying to his self: \"Woe to you, O Dāwūd! How long is your reckoning on the Day of Resurrection!\" Then after that, he ate nothing but dry bread. And ʿUtbah al-Ghulām said one day to ʿAbd al-Wāḥid ibn Zayd: \"So-and-so describes of himself a station that I do not recognize in myself.\" He said: \"Because you eat dates with your bread, while he adds nothing to his bread.\" He said: \"If I abandon eating dates, will I recognize that station?\" He said: \"Yes, and others besides it.\" So he began to weep, and one of his companions said to him: \"May Allah not make your eye weep—do you weep over dates?\" ʿAbd al-Wāḥid said: \"Leave him, for his self has recognized the sincerity of his resolve in abandonment, and when he abandons a thing, he does not return to it.\" And Jaʿfar ibn Naṣr said: Al-Junayd ordered me to buy for him the Wazīrī figs. When I bought them, he took one at the time of breaking the fast and placed it in his mouth, then he threw it out and began to weep. Then he said: \"Carry it away.\" I said to him concerning that: \"Why?\" He said: \"A caller called out to me: 'Are you not ashamed? You abandoned it for My sake, then you return to it?'\" And Ṣāliḥ al-Murrī said: I said to ʿAṭāʾ al-Sulamī: \"I am going to trouble myself for your sake with something, so do not reject my kindness.\" He said: \"Do what you wish.\" He said: So I sent to him, with my son, a drink of sawīq which I had kneaded with butter and honey, and I said: \"Do not leave until he drinks it.\" When the next day came, I prepared for him something similar, and he returned it and did not drink it. So I reproached him and blamed him for that, and I said: \"Glory be to Allah! You have rejected my kindness.\" When he saw my distress over that, he said: \"Do not let this grieve you. I did drink it the first time, and I tempted my self the second time to drink it, but I could not do so—whenever I wanted that, I remembered the saying of Allah the Exalted: {«يَتَجَرَّعُهُ وَلَا يَكَادُ يُسِيغُهُ»} — 'He will gulp it but will hardly swallow it' {«إبراهيم: 17»}.\" Ṣāliḥ said: So I wept and said to myself: \"I am in one valley, and you are in another valley.\" And al-Sarī al-Saqaṭī said: \"My self has been demanding of me for thirty years that I dip a carrot in molasses, and I have not fed it that.\" And Abū Bakr al-Jallāʾ said: \"I know a man whose self says to him: 'I will be patient for you through ten days of hunger, then feed me after that a craving I desire.' He says to her: 'I do not want you to endure ten days of hunger, but abandon this craving.'\" And it is related that a worshiper invited some of his brothers, and he placed before him loaves of bread. His brother began turning over the loaves to choose the finest among them, so the worshiper said to him: \"Stop! What are you doing? Do you not know that in the loaf you have turned away from there is such-and-such wisdom, and such-and-such a maker worked upon it—until it was rounded from the cloud that carries the water, and the water that irrigates the earth, and the winds, and the earth, and the beasts, and the sons of Adam—until it reached you? Then after all this, you turn it over and are not satisfied with it?\" And in the report: \"A loaf is not rounded and placed before you until three hundred and sixty makers have worked upon it—the first of them is Michael (Mīkāʾīl), peace be upon him, who measures out the water from the treasuries of mercy, then the angels that drive the clouds, and the sun, and the moon, and the spheres, and the angels of the air, and the beasts of the earth, and the last of them is the baker. {«وَإِن تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا»} — 'And if you should count the favors of Allah, you could not enumerate them' {«إبراهيم: 34»}.\" — A hadith: \"A loaf is not rounded and placed before you until three hundred and sixty makers have worked upon it—the first of them is Michael.\" — I have not found any basis for this hadith. And some of them said: I came to Qāsim al-Jurʿī and asked about asceticism (al-zuhd)—what it is. He said: \"What have you heard about it?\" So I enumerated various sayings, and he fell silent. Then I said: \"What do you yourself say?\" He said: \"Know that the belly is the world (dunyā) of the servant. To the extent that he masters his belly, he masters of asceticism; and to the extent that his belly masters him, the world masters him.\" And Bishr ibn al-Ḥārith was once ill, so he came to ʿAbd al-Raḥmān the physician, asking him about something that would suit him among foods. He said: \"You ask me, and when I describe something for you, you will not accept it from me.\" He said: \"Describe it so that I may hear.\" He said: \"Drink oxymel (sikanjabīn), suck on quince, and eat...\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 646", "section_title_en": "The Revival of the Religious Sciences — Book on Trust (Tawakkul), Section 646: Ascetic Restraint in Food and the Discipline of the Self", "section_index": 646, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates and carries the essential identity of a person.\n  * Al-Raghib (Mufradat): In theological usage, النفس denotes the inner reality of a person—whether the rational soul or the lower appetitive self (al-nafs al-ammārah)—which must be disciplined and opposed in its cravings.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) refers to the soul/self as the seat of volition; metaphorical (majāz) usage extends to the \"blood of life\" (نفس سائلة), indicating that which, when spilled, renders impurity—here, the self is that which must be \"broken\" of its desires.\n- Root: اكل (a-k-l)\n  * Lisan / Ayn: To eat, consume, or take nourishment; the act of ingesting food.\n  * Al-Raghib (Mufradat): الأكل is the taking of food; metaphorically extended to fire consuming wood (أكلت النار الحطب). In ascetic contexts, it signifies the permissible boundary of bodily sustenance versus the indulgence of appetite.\n  * Al-Zamakhshari (Asas): Literal: eating for survival. Metaphorical: \"He ate my wealth\" (أكل مالي) meaning he squandered it; here, the narratives pivot on the literal act of eating as the arena where the self's discipline is tested—whether one eats for need or for pleasure.\n- Root: قال (q-w-l)\n  * Lisan / Ayn: To say, speak, or utter; a statement or discourse.\n  * Al-Raghib (Mufradat): In Quranic and theological contexts, القول is not mere speech but the articulation of conviction or resolve—often used to contrast outward claims with inward reality.\n  * Al-Zamakhshari (Asas): Literal: verbal utterance. Metaphorical: the \"speech\" of the self (حديث النفس) as internal dialogue, where the lower self addresses a person and must be answered with resolve.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its governed noun by an intervening clause, as seen in complex periodic sentences where the narrative flow is interrupted by parenthetical exhortations or Quranic citations, requiring precise parsing to maintain grammatical coherence.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}], "22": [{"arabic": "وقال تعالى فالذين لا يؤمنون بالآخرة قلوبهم منكرة وهم مستكبرون وقال عز وجل يقول الذين استضعفوا للذين استكبروا لولا أنتم لكنا مؤمنين وقال تعالى إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين وقال تعالى سأصرف عن آياتي الذين يتكبرون في الأرض بغير الحق قيل في التفسير سأرفع فهم القرآن عن قلوبهم وفي بعض التفاسير سأحجب قلوبهم عن الملكوت وقال ابن جريج سأصرفهم عن أن يتفكروا فيها ويعتبروا بها ولذلك قال المسيح عليه السلام إن الزرع ينبت في السهل ولا ينبت على الصفا كذلك الحكمة تعمل في قلب المتواضع ولا تعمل في قلب المتكبر أل", "english": "When this [pride] appears upon the bodily limbs, it is called \"behaving arrogantly\" (takabbur); and when it does not appear [outwardly], it is said that in his soul there is pride (kibr). The root [of the matter] is the moral trait (khuluq) that resides in the soul — namely, the soul's taking comfort and repose in seeing itself as above the one over whom it acts proudly. For pride necessarily requires an object over whom one is proud and a quality by virtue of which one is proud; and by this [requirement], pride is distinguished from self-conceit ('ujb), as will come later. For self-conceit does not require an object other than the self-conceited one. Indeed, were a human being created alone, it is conceivable that he would be self-conceited, but it is not conceivable that he would be proud except when there is another alongside him, and he sees himself as above that other in the attributes of perfection. Only at that point does he become proud. Nor is it sufficient that he deem himself great in order to be proud — for a man may deem himself great yet see another as greater than himself or equal to himself, and so he does not act proudly toward him. Nor is it sufficient that he hold another in contempt — for even so, if he saw himself as more contemptible [than that other], he would not be proud; and if he saw the other as his equal, he would not be proud. Rather, he must assign to himself a rank and to the other a rank, then see his own rank as above the other's rank. Upon these three beliefs, the trait of pride comes to be in him. It is not that this perception alone negates pride; rather, this perception and this conviction blow into him [a wind of vanity], and there arises in his heart self-complacency, a thrill, joy, and repose in what he has come to believe, and a sense of vainglory in himself on account of that. That vainglory, that thrill, and that repose in the belief — that is the trait of pride. For this reason, the Prophet — God's peace and blessings be upon him — said: \"I seek refuge in You from the puff of pride (nafkhat al-kibriyā').\" And the hadith has preceded: \"None shall enter Paradise who has in his heart the weight of a mustard seed of pride.\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 854", "section_title_en": "The Reality of Pride (Kibr) and Its Manifestation in the Soul and Limbs", "section_index": 854, "anchors": "- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core meaning of bigness, greatness, and seniority in age or rank; al-Farahidi notes its use for physical growth and maturity.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — great and small are relative terms, applied by comparison; in Kalam, pride (kibr) is a state of the soul that esteems itself above another in perfection.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"كبر الأمر، وخطب كبير\" — to be great in magnitude. Metaphorical (Majaz): \"كبر عليه\" — to find something burdensome or grievous; the moral-spiritual sense of kibr is a metaphorical extension of physical magnitude to the soul's self-assessment.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates and is the seat of inner states.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul; also the very essence (al-dhat), as in \"ويحذركم الله نفسه\" {آل عمران/ 30}, where His \"self\" is His essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — precious thing. Metaphorical: \"دفق نفسه أي دمه\" — \"his self\" for \"his blood\"; here, the soul's inner disposition (khuluq) is the locus where pride takes root before it appears on the limbs.\n- Root: وفي (W-F-Y)\n  * Lisan / Ayn: Completeness, fulfillment, and reaching full measure.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — that which attains completion; \"أوفى بعهده\" — to fulfill one's covenant fully.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" — a full-weight dirham. Metaphorical: \"أوفى على المائة\" — to exceed a hundred; in this text, the \"full measure of a mustard seed\" (مثقال ذرة) of pride is the complete, realized quantity that bars one from Paradise.\n- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: Measuring, shaping, and fashioning; also innate disposition and moral character.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — its root is right measure and estimation; used for God's origination of things and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal: \"خلق الخراز الأديم\" — the leatherworker measures the hide before cutting. Metaphorical: \"خلق الله الخلق\" — God originated creation upon a measure dictated by wisdom; hence khuluq is the soul's fixed moral form.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — used to delimit the precise definition of kibr as a specific soul-state distinct from 'ujb (self-conceit), and to restrict the cause of exclusion from Paradise to the presence of pride in the heart.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "23": [{"arabic": "تعالى {إنه لا يحب المستكبرين} وقال تعالى {لقد استكبروا في أنفسهم وعتوا عتوا كبيرا} وقال تعالى {إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} وذم الكبر في القرآن كثير وقد قال رسول الله صلى الله عليه وسلم لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر ولا يدخل الجنة من كان في قلبه مثقال حبة من خردل من إيمان (1) حديث أبي هريرة يقول الله تعالى الكبرياء ردائي والعظمة إزاري فمن نازعني واحدا منهما ألقيته في جهنم أخرجه مسلم وأبو داود وابن ماجه واللفظ له وقال", "english": "To proceed: The Messenger of God, may God bless him and grant him peace, said — God, exalted be He, said: \"Pride (al-kibriyāʾ) is My cloak, and greatness (al-ʿaẓamah) is My wrapper; whoever contends with Me over either of them, I crush him.\" {«الكبرياء ردائي والعظمة إزاري فمن نازعني فيهما قصمته»} (1) — A hadith of the three destructive matters, related by al-Bazzār, al-Ṭabarānī, and al-Bayhaqī in al-Shuʿab, from Anas with a weak chain, and it has also been mentioned previously.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 847", "section_title_en": "The Book of Condemnation of Pride and Self-Admiration — Being the Ninth Book of the Quarter of Destructive Matters from The Revival of the Religious Sciences", "section_index": 847, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"al-kibriyā'\" is the supreme majesty exclusive to God.\n  * Al-Raghib (Mufradat): \"al-kabīr wa al-ṣaghīr\" are relative terms; used for quantity, quality, and dignity. \"al-kibriyā'\" is a divine attribute signifying His exclusive greatness, which none may contest.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"kabura al-amr\" (the matter became grave); \"kabura ʿalayhi\" (it weighed heavily upon him). Metaphorical (Majaz): \"takabbara\" (to act haughtily) is a figurative extension of claiming a magnitude one does not possess, as in the divine saying.\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Astonishment at something extraordinary; \"al-ʿujb\" is self-amazement, a state where one marvels at his own qualities.\n  * Al-Raghib (Mufradat): Astonishment arises from ignorance of the true cause; self-admiration (ʿujb) blinds one to one's own defects and to the divine origin of all good.\n  * Al-Zamakhshari (Asas): Literal: \"ʿajiba minhu\" (he marveled at it). Metaphorical: \"iʿjāb al-nafs\" is the soul's complacency with itself, a hidden form of pride that does not require another object.\n- Root: هلك (h-l-k)\n  * Lisan / Ayn: Perishing, destruction, ruin; \"al-muhlikāt\" are the things that cause perdition.\n  * Al-Raghib (Mufradat): Destruction is of three kinds: loss, corruption, and death. Here it is spiritual perdition — the ruin of the soul's eternal felicity.\n  * Al-Zamakhshari (Asas): Literal: physical ruin. Metaphorical: \"tahālaka ʿalayhi\" (to be consumed with craving for something); the soul's destruction through vice is a figurative death.\n- Sibawayh Rule: Rule of Apposition and Parenthetical Clauses (al-badal wa al-iʿtirāḍ) — The opening doxology employs extended appositional chains (badal) and parenthetical invocations that delay the main clause, requiring the translator to preserve the periodic structure without collapsing the theological weight of each divine epithet.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'", "badge": "Hadith"}], "33": [{"arabic": "ومن يعمل مثقال ذرة شرا يره وما ظلمهم الله ولكن كانوا أنفسهم يظلمون بيان تفصيل الطريق إلى تهذيب الأخلاق قد عرفت من قبل أن الاعتدال في الأخلاق هو صحة النفس والميل عن الاعتدال سقم ومرض فيها كما أن الاعتدال في مزاج البدن هو صحة له والميل عن الاعتدال مرض فيه فلنتخذ البدن مثالا فنقول مثال النفس في علاجها بمحو الرذائل والأخلاق الرديئة عنها وجلب الفضائل والأخلاق الجميلة إليها مثال البدن في علاجه بمحو العلل عنه وكسب الصحة له وجلبها إليه وكما أن الغالب على أصل المزاج الاعتدال وإنما تعتري المعدة المضرة بعوارض الأغذية والأهو", "english": "For this reason, may God be well pleased with him, said: \"Faith indeed appears in the heart as a white spot; whenever faith increases, that whiteness increases, until when the servant perfects faith, the whole heart becomes white. And hypocrisy indeed appears in the heart as a black spot; whenever hypocrisy increases, that blackness increases, until when hypocrisy is perfected, the whole heart becomes black.\"", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 621", "section_title_en": "The Gradual Acquisition of Moral Character and the Detailed Exposition of the Path to Refining Ethics", "section_index": 621, "anchors": "- Root: فقه (Fiqh)\n  * Lisan / Ayn: Comprehension and understanding of a matter's inward reality; deep penetration into meaning.\n  * Al-Raghib (Mufradat): \"الفقه: هو التوصل إلى علم غائب بعلم شاهد\" — Fiqh is attaining knowledge of the unseen through the witnessed; it is more specific than mere knowledge ('ilm), denoting a settled, abiding comprehension.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"افقه عني ما أقول لك\" — grasp what I say to you. The term denotes active, engaged understanding, not passive reception.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, the soul; that which desires proximity and discourse; the principle of life and animation.\n  * Al-Raghib (Mufradat): The soul as the seat of both blameworthy and praiseworthy traits; its purification (tazkiyah) is the goal of moral discipline.\n  * Al-Zamakhshari (Asas): Literal vs. Metaphorical: \"نفس\" as blood (the life-fluid) versus the immaterial self; here, \"فقيه النفس\" denotes one whose very soul has become imbued with the habit of deep understanding — a settled disposition, not a transient state.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; that which turns and is turned (taqlib), the organ of fluctuating states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant turning and overturning between states; it is the seat of both faith and hypocrisy, whiteness and blackness.\n  * Al-Zamakhshari (Asas): Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — to turn something about, to manage and dispose; the heart is that which is turned by habits until it becomes fixed in one direction.\n- Root: جمل (Jaml)\n  * Lisan / Ayn: Beauty and comeliness; the sum total of a thing; that which is gathered and collected.\n  * Al-Raghib (Mufradat): \"الجمال: الحسن الكثير\" — beauty in abundance; both inward (character) and outward (action).\n  * Al-Zamakhshari (Asas): Literal: \"فلان يعامل الناس بالجميل\" — dealing with people beautifully; here, \"الأفعال الجميلة\" are the beautiful, virtuous actions whose repetition forms character.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The construction \"لا طريق له إلا أن\" (there is no path for him except that) effects complete restriction (hasr), confining the means of moral transformation to a single, specified avenue: the repetition of acts until they become nature.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "40": [{"arabic": "ومن هذا القبيل في كنايته عن الاقتدار قوله تعالى إنما قولنا لشيء إذا أردناه أن نقول له كن فيكون فإن ظاهره ممتنع إذ قوله كن إن كان خطابا للشيء قبل وجوده فهو محال إذا المعدوم لا يفهم الخطاب حتى يمثل وإن كان بعد الوجود فهو مستغن عن التكوين ولكن لما كانت هذه الكناية أوقع في النفوس في تفهيم غاية الاقتدار عدل إليها وأما المدرك بالشرع فهو أن يكون إجراؤه على الظاهر ممكنا ولكنه يروى أنه أريد به غير الظاهر كما ورد في تفسير قوله تعالى أنزل من السماء ماء فسالت أودية بقدرها الآية وأن معنى الماء ههنا هو القرآن ومعنى الأودية هي القلوب وأن بعضها احتم", "english": "The third category is when a thing is such that if it were mentioned explicitly it would be understood and there would be no harm in it, yet one alludes to it by way of metaphor (istiʿārah) and symbol (ramz), so that its impact upon the heart of the listener may be more powerful, and so that there may be a benefit in magnifying the matter's importance in his heart. For example, if someone said, \"I saw so-and-so hanging pearls upon the necks of swine,\" he would be alluding thereby to the dissemination of knowledge and the scattering of wisdom among those unworthy of it. Now, the listener may have his understanding rush to the literal sense of the words; but the verifier (muḥaqqiq), when he reflects and knows that that man had no pearls with him, nor was there any swine in that place, becomes alert to the apprehension of the secret and the inner meaning. Thus people differ in this matter. Of this kind is the poet's saying:", "book_title": "Foundations of Belief", "section_title_ar": "Section 84", "section_title_en": "The Third Category of Allusion: Metaphorical Expression for Deeper Impact", "section_index": 84, "anchors": "- Root: كنو (K-N-W)\n  * Lisan / Ayn: To use a metonymy or indirect expression; to refer to something by a name other than its direct designation\n  * Al-Raghib (Mufradat): The use of indirect expression to convey a meaning whose direct statement, while comprehensible, would lack the desired psychological impact\n  * Al-Zamakhshari (Asas): Distinguishes between literal expression (haqīqah) and metaphorical indirection (kināyah) — here the latter is employed for rhetorical amplification\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn over, to overturn, to transform from one state to another\n  * Al-Raghib (Mufradat): The heart as the seat of understanding and the organ of spiritual perception; the \"turning\" of meanings upon the heart\n  * Al-Zamakhshari (Asas): Literal: to flip a thing over. Metaphorical: the heart's reception and internalization of meaning — \"وقع في قلبه\" (its impact upon his heart)\n- Root: مثل (M-TH-L)\n  * Lisan / Ayn: Likeness, similitude, example, parable\n  * Al-Raghib (Mufradat): The expression of a meaning through an image that contains either the very essence of that meaning or its likeness\n  * Al-Zamakhshari (Asas): Literal: resemblance. Metaphorical: the parabolic mode where the image conveys the inner reality\n- Root: ظهر (Z-H-R)\n  * Lisan / Ayn: The back; the outward, apparent aspect of a thing\n  * Al-Raghib (Mufradat): The apparent sense (zāhir) versus the inner meaning (bāṭin); the exoteric versus the esoteric\n  * Al-Zamakhshari (Asas): Literal: the visible surface. Metaphorical: \"ظهرًا لبطن\" — turning a matter over, examining both its outward and inward aspects\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The structure \"إنما\" in the Quranic citation restricts and focuses the predication, indicating that the creative command is exclusively and entirely Allah's, with no intermediary or temporal process.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "42": [{"arabic": "تعالى فاصبر كما صبر أولي العزم من الرسل وقال تعالى {نعم أجر العاملين الذين صبروا وعلى ربهم يتوكلون} وهذا في أذى الناس وأما الصبر على أذى الحيات والسباع والعقارب فترك دفعها ليس من التوكل في شيء إذ لا فائدة فيه ولا يراد السعي ولا يترك السعي لعينه بل لإعانته على الدين وترتب الأسباب ههنا كترتبها في الكسب وجلب المنافع فلا نطول بالإعادة وكذلك في الأسباب الدافعة عن المال فلا ينقص التوكل بإغلاق باب البيت عند الخروج ولا بأن يعقل البعير لأن هذه أسباب عرفت سنة الله تعالى إما قطعا وإما ظنا ولذلك قال صلى الله عليه وسلم للأعرابي لما أن أهمل البعير وقال ت", "english": "...and its end. Those who possess ends are called \"the foremost\" (al-sābiqūn), and those who possess beginnings are called \"the companions of the right\" (aṣḥāb al-yamīn). Then the companions of the right also have degrees, and likewise the foremost; and the highest degrees of the companions of the right adjoin the lowest degrees of the foremost. So there is no meaning to precise estimation in such matters. Rather, the verified truth is that tawakkul (reliance on God) through abandoning provision-storing (tark al-iddikhār) is not perfected except by the shortening of hope (qaṣr al-amal). As for the total absence of hopes for survival, its being stipulated is remote — even in a single soul — for that is as if impossible to exist. As for people, they vary in the length and shortness of hope. The least degree of hope is a day and a night, and what is less than that of hours; and its utmost is what can be conceived to be a man's lifespan. Between these are degrees beyond enumeration. Whoever does not hope for more than a month is closer to the goal than one who hopes for a year. And restricting it to forty [days] on account of the appointed time of Moses (peace be upon him) is far-fetched, for that incident was not intended to clarify the measure of what hope has been permitted. Rather, Moses' worthiness to attain the promised [encounter] was not completed except after forty days, due to a secret by which — and by its like — the sunnah of God most High proceeds in the gradual unfolding of matters, just as he (peace be upon him) said: \"Indeed God kneaded the clay of Adam with His hand for forty mornings\" {«إن الله خمر طينة آدم بيده أربعين صباحا»} — because the worthiness of that clay for kneading was dependent upon a period reaching what was mentioned. Therefore, whatever is beyond a year is not stored except by virtue of the heart's weakness and its leaning toward the outward aspects of causes; such [storing] falls outside the station of tawakkul, [the person] not being confident in the encompassing governance of the True Deputy (al-wakīl al-ḥaqq) over the hidden dimensions of causes. For the means of income — through harvests and alms — recur with the recurrence of years, generally speaking. Whoever stores for less than a year has a degree proportionate to the shortness of his hope; and whoever's hope is two months — his degree is not like the degree of one who hopes for a month, nor the degree of one who hopes for three months; rather, he is between them in rank. Nothing prevents storing except the shortness of hope. So the most virtuous is that one not store at all — even if his heart is weak — for the less his storing, the greater his merit. It has been related concerning the poor man whom the Prophet (peace be upon him) commanded ʿAlī (may God honor his face) and Usāmah to wash — so they washed him and shrouded him in his own cloak. When he buried him, he said to his companions: \"He will be raised on the Day of Resurrection with his face like the full moon on the night of the full moon; and were it not for one trait in him, he would be raised with his face like the radiant sun.\" We said: \"And what is it, O Messenger of God?\" He said: \"He was a frequent faster, a frequent prayer-stancer, and abundant in the remembrance of God most High — except that when winter came, he stored the summer garment for his summer; and when summer came, he stored the winter garment for his winter.\" Then he (peace be upon him) said: \"Rather, the least of what you have been given is certainty (al-yaqīn) and the resolve of patience (ʿazīmat al-ṣabr)\" — the hadith. The jug and the knife and whatever is needed continuously — that is not the meaning of this; for storing such does not diminish the degree. As for the winter garment, it is not needed in summer. And this [censure] applies to one whose heart is not disturbed by abandoning storing, and whose soul does not look longingly toward the hands of creatures; rather, his heart turns to nothing except the True Deputy. But if he senses within himself a restlessness that occupies his heart away from worship, remembrance, and reflection, then storing is more appropriate for him. Indeed, even if he held onto an estate whose income sufficed for his needs, and his heart would not be free except through it, then that is more appropriate for him — because the goal is the rectification of the heart so that it may be emptied for the remembrance of God. There is a person whom the existence of wealth occupies, and a person whom its absence occupies; and what is harmful is whatever occupies one away from God (mighty and majestic). Otherwise, this world in itself is not harmful — neither its existence nor its absence. For this reason, the Messenger of God (peace be upon him) was sent to all classes of creation, among them merchants, craftsmen, and people of trades and industries. He did not command the merchant to abandon his trade, nor the craftsman to abandon his craft, nor did he command the one who had abandoned both to occupy himself with them. Rather, he called everyone to God most High and guided them to the fact that their triumph and salvation lie in the turning of their hearts away from this world toward God most High. The pillar of occupation with God (mighty and majestic) is the heart. So the correct course for the weak is to store the measure of his need, just as the correct course for the strong is to abandon storing.", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1132", "section_title_en": "On Reliance (Tawakkul): Degrees of Hope, Provision-Storing (Iddikhār), and the Means of Repelling Harm", "section_index": 1132, "anchors": "- Root: أمل (ʾ-m-l)\n  * Lisan / Ayn: Prolonged expectation or hoping for something; the extension of one's aspiration toward a future state.\n  * Al-Raghib (Mufradat): Hope (amal) is the soul's expectation of a beloved matter; its opposite is yaʾs (despair). In the Kalam context, it is tied to the length of one's expectation of worldly continuance, which directly governs the validity of tawakkul.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) usage denotes the temporal span of expectation; metaphorical (majāz) usage applies to the soul's attachment to causes. Here, Ghazali uses it literally to measure degrees of trust.\n- Root: ذكر (dh-k-r)\n  * Lisan / Ayn: To remember, to mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Dhikr is the presence of the remembered thing in the heart; its highest form is absorption in the remembrance of God, which is the very purpose of heart-rectification (iṣlāḥ al-qalb).\n  * Al-Zamakhshari (Asas): Literal: verbal mention; metaphorical: the heart's unwavering orientation toward the object of remembrance, as in \"the heart's distraction from worship and dhikr.\"\n- Root: سبب (s-b-b)\n  * Lisan / Ayn: A rope by which one climbs; a means or connection to something.\n  * Al-Raghib (Mufradat): Everything by which one reaches something else is called a sabab. God has ordained causes (asbāb) as the customary channel (sunnah) of His decree; reliance is placed not on the cause itself but on the Causer of causes (musabbib al-asbāb).\n  * Al-Zamakhshari (Asas): Literal: a physical cord or link; metaphorical: any means, whether certain (maqṭūʿ), probable (maẓnūn), or illusory (mawhūm). Ghazali's tripartite division of causes rests on this rhetorical distinction.\n- Root: وكل (w-k-l)\n  * Lisan / Ayn: To entrust, to delegate; one who relies upon another as a deputy.\n  * Al-Raghib (Mufradat): Tawakkul is to depend upon another and make him a deputy over one's affair. The true wakīl is God alone, for He alone encompasses the hidden dimensions of causes.\n  * Al-Zamakhshari (Asas): Literal: delegation of authority; metaphorical: the heart's utter confidence in the deputy's sufficiency, as in \"he entrusted his burden to God.\" Ghazali contrasts the strong (qawī) who abandons storing with the weak (ḍaʿīf) who stores out of necessity.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Focused Predication) — Used to delimit the conditions of tawakkul, e.g., \"the one who stores is not excluded from tawakkul except by the length of his hope,\" and to distinguish what nullifies reliance from what does not.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "43": [{"arabic": "الدين} وقوله عز وجل {فاسألوا أهل الذكر إن كنتم لا تعلمون} وأما الأخبار فقوله صلى الله عليه وسلم من سلك طريقا يطلب فيه علما سلك الله به طريقا إلى الجنة (1) وقال صلى الله عليه وسلم إن الملائكة لتضع أجنحتها لطالب العلم رضاء بما يصنع (2) وقال صلى الله عليه وسلم لأن تغدو فتتعلم بابا من العلم خير من أن تصلي مائة ركعة (3) وقال صلى الله عليه وسلم باب من العلم يتعلمه الرجل خير له من الدنيا وما فيها (4) وقال صلى الله عليه وسلم اطلبوا العلم ولو بالصين (1) وقال صلى الله عليه وسلم طلب العلم ف", "english": "As for the Quranic verses, there is the saying of God Most High: {«فلولا نفر من كل فرقة منهم طائفة ليتفقهوا في الدين»} — \"Why then did not a party from every section of them go forth, that they might gain deep comprehension in the religion?\" — and His saying, Mighty and Majestic: {«فاسألوا أهل الذكر إن كنتم لا تعلمون»} — \"So ask the people of remembrance if you do not know.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 7", "section_title_en": "The Virtue of Seeking Knowledge (Faḍīlat al-Taʿallum)", "section_index": 7, "anchors": "- Root: فقه (Fiqh)\n  * Lisan / Ayn: Core meaning is \"comprehension\" and \"understanding\" — the penetration into the inner meaning of speech, distinguished from mere hearing (samāʿ).\n  * Al-Raghib (Mufradat): In the theological register, *tafaqquh* (تفقه) is the deep, exhaustive comprehension of the religious sciences — not mere memorization but the attainment of the realities of juridico-theological matters.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes intellectual penetration; metaphorical (majāz) usage extends to any deep discernment of subtle meanings.\n- Root: سأل (Saʾala)\n  * Lisan / Ayn: To ask, to inquire, to seek information — the root act of petitioning for knowledge from its possessor.\n  * Al-Raghib (Mufradat): Asking (*suʾāl*) is the divinely mandated means for the ignorant to access knowledge, as per {«فاسألوا أهل الذكر»} — it is the key that unlocks the treasuries of knowledge.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal request; the Prophet's statement \"العلم خزائن مفاتيحها السؤال\" employs a metaphor (majāz) likening knowledge to locked treasuries and questioning to their keys.\n- Root: طلب (Ṭalab)\n  * Lisan / Ayn: To seek, to pursue, to search out a thing — whether a physical object or a meaning.\n  * Al-Raghib (Mufradat): \"الطلب: الفحص عن وجود الشيء، عينا كان أو معنى\" — the earnest investigation into the existence of a thing, whether concrete or conceptual. In the religious context, *ṭalab al-ʿilm* is the pursuit of that which revives the religion.\n  * Al-Zamakhshari (Asas): Literal usage is the physical pursuit of a quarry; the ḥadīth \"من سلك طريقا يطلب فيه علما\" employs the metaphor of the *path* (ṭarīq) as the means of pursuit, and the divine recompense as the *path to Paradise*.\n- Root: غدو (Ghadā)\n  * Lisan / Ayn: To go out early in the morning, to set forth at dawn — the time of vigorous, purposeful departure.\n  * Al-Zamakhshari (Asas): Literal usage denotes the morning journey; in the saying of Abū al-Dardāʾ, \"الغدو إلى طلب العلم\" is metaphorically elevated to the rank of *jihād* — the early morning departure for knowledge is a martial expedition of the soul.\n- Sibawayh Rule: Rule of Interposition (al-Faṣl bayna al-Jār wa-al-Majrūr) — The syntactic principle governing the separation of the prepositional phrase from its governing verb, as in \"سلك الله به طريقا إلى الجنة,\" where the divine agency is interposed between the act and its recompense, indicating the causal nexus.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "44": [{"arabic": "ذكركم أفلا تعقلون وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم كذلك يضرب الله للناس أمثالهم واتبعوا أحسن ما أنزل إليكم من ربكم هذا بصائر للناس وهدى ورحمة لقوم يوقنون هذا بيان للناس وهدى وموعظة للمتقين وإذا قصد بالخطاب جميع الناس فقد قصد الآحاد فهذا القارىء الواحد مقصود فما له ولسائر الناس فليقدر أنه المقصود قال الله تعالى وأوحي إلي هذا القرآن لأنذركم به ومن بلغ قال محمد بن كعب القرظي من بلغه القرآن فكأنما كلمه الله وإذا قدر ذلك لم يتخذ دراسة القرآن عمله بل يقرؤه كما يقرأ العبد كتاب مولاه الذي كتبه إليه ليتأم", "english": "[Root: ذكر]\n  • Al-Raghib (Al-Mufradat): \"الذكر: حضور الشيء القلب أو القول، ويكون تارة بالقلب وتارة باللسان، والذكر باللسان تارة يكون حضور المعنى وبعده، وقد يقال: ذكرته إذا جرى على لسانه وإن لم يحضره قلبه، والذكر بالقلب هو حضور المعنى، قال تعالى: ولا تطع من أغفلنا قلبه عن ذكرنا [الكهف/ 28]\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"ذكرت الشيء: نطقت به أو استحضرته بقلبك. وذكرت فلانا بخير وشر. واذكروا الله ذكرا كثيرا. والذكر: الشرف والصيت، قال تعالى: وإنه لذكر لك ولقومك [الزخرف/ 44]\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الذكر: الكتاب الذي فيه تذكير الناس، قال تعالى: وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم [النحل/ 44]، والذكر: القرآن، قال تعالى: إنا نحن نزلنا الذكر وإنا له لحافظون [الحجر/ 9]\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 229", "section_title_en": "Section 229", "section_index": 229, "anchors": "*(Anchors established)*", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "52": [{"arabic": "الشكر فى السموات والأرض وله الحمد فى الأولى والآخرة والصلاة على محمد ذي المعجزات الظاهرة والآيات الباهرة وعلى آله وأصحابه وسلم تسليما كثيرا أما بعد فجدير بمن الموت مصرعه والتراب مضجعه والدود أنيسه ومنكر ونكير جليسه والقبر مقره وبطن الأرض مستقره والقيامة موعده والجنة أو النار مورده أن لا يكون له فكر إلا فى الموت ولا ذكر إلا له ولا استعداد إلا لأجله ولا تدبير إلا فيه ولا تطلع إلا إليه ولا تعريج إلا عليه ولا اهتمام إلا به ولا حول إلا حوله ولا انتظار وتربص إلا له وحقيق بأن يع", "english": "To proceed: Worthy is one whose place of downfall is death, whose bed is the dust, whose companion is the worm, whose boon-companions are Munkar and Nakīr, whose abode is the grave, whose resting-place is the belly of the earth, whose appointed time is the Resurrection, and whose destination is Paradise or the Fire — that he should have no thought except of death, no remembrance except of it, no preparation except for it, no deliberation except concerning it, no aspiration except toward it, no lingering except upon it, no concern except with it, no power except around it, and no waiting or tarrying except for it. And it is fitting that he should count himself among the dead and see himself among the inhabitants of the graves, for everything that is coming is near, and the distant is only that which is not coming. The Messenger of God, peace and blessings be upon him, said: \"The shrewd one (al-kayyis) is he who subdues his soul and works for what comes after death\" (1). And preparation for a thing will not be facilitated except upon the renewal of its remembrance in the heart, and its remembrance is not renewed except through recollection by lending ear to those things that remind of it and by looking upon those things that alert to it.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1281", "section_title_en": "The Book of the Remembrance of Death and What Follows It — Introduction and Opening Homily", "section_index": 1281, "anchors": "- Root: موت (m-w-t)\n  * Lisan / Ayn: Core root denotes cessation of vital faculty; death as transition, not annihilation.\n  * Al-Raghib (Mufradat): Death is the divinely ordained terminus of corporeal life, gateway to reckoning; \"أماته فأقبره\" {«عبس/ 21»} implies divine disposal of the deceased.\n  * Al-Zamakhshari (Asas): Literal: bodily death and burial. Metaphorical: \"أحيا الله البلد الميت\" — revival of barren land; death of hearts through heedlessness.\n- Root: قبر (q-b-r)\n  * Lisan / Ayn: Grave as the resting place of the dead; \"المقبرة\" as the site of interment.\n  * Al-Raghib (Mufradat): \"حتى زرتم المقابر\" {«التكاثر/ 2»} — metonymy for death itself; the grave as prelude to resurrection.\n  * Al-Zamakhshari (Asas): Literal: burial of the deceased. Metaphorical: \"رفع قبراه\" — the haughty one who raises his nose like a grave-mound, signifying pride.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: Praise predicated upon volitional excellence; gratitude for beneficence.\n  * Al-Raghib (Mufradat): True praise (ḥamd) is due solely to God, whose acts are pure beneficence; distinct from mere thanks (shukr) for favors received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله بجميع محامده\" — praising God with all praises. Metaphorical: \"أحمدت صنيعه\" — approving an act as praiseworthy.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic opening \"الحمد لله الذي...\" employs a suspended genitive construction (جار ومجرور) with a relative clause (صلة الموصول) that permits extended expansion, governing the entire homiletic sequence that follows.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}, {"arabic": "وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدرك مدارك الملوك (4) وقد نبه بهذا على ثمراته في الدنيا ومعلوم أن الآخرة خير وأبقى وقال صلى الله عليه وسلم خصلتان لا يكونان في منافق حسن سمت وفقه في الدين (5) ولا تشكن في الحديث لنفاق بعض فقهاء الزمان فإنه ما أراد به الفقه الذي ظننته وسيأتي معنى الفقه وأدنى درجات الفقيه أن يعلم أن الآخرة خير من الدنيا", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Contemplation", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'", "badge": "Hadith"}], "62": [{"arabic": "وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعالى ويجعلون لله ما يكرهون وتصف ألسنتهم الكذب أن لهم الحسنى لا وقف بعض القراء على النفي تكذيبا لهم ثم ابتدأ وقال جرم أن لهم النار أي كسب لهم جعلهم لله ما يكرهون النار الوظيفة الثامنة أن يطلب لصدقته من تزكو به الصدقة ولا يكتفي بأن يكون من عموم الأصناف الثمانية فإن في عمومهم خصوص صفات فليراع خصوص تلك الصفات وهي ستة الأولى أن يطلب الأتقياء المعرضين عن الدينا المتجردين لتجارة الآخرة قال صلى الله عليه وسلم لا تأكل إلا طعام تقي ولا يأكل طعامك إلا تقي (1) وهذا لأن التقي يستعين به على التقوى فتكون شريكا في طاعته بإعان", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}, {"arabic": "تكذيبا لهم ثم ابتدأ وقال جرم أن لهم النار أي كسب لهم جعلهم لله ما يكرهون النار الوظيفة الثامنة أن يطلب لصدقته من تزكو به الصدقة ولا يكتفي بأن يكون من عموم الأصناف الثمانية فإن في عمومهم خصوص صفات فليراع خصوص تلك الصفات وهي ستة الأولى أن يطلب الأتقياء المعرضين عن الدينا المتجردين لتجارة الآخرة قال صلى الله عليه وسلم لا تأكل إلا طعام تقي ولا يأكل طعامك إلا تقي (1) وهذا لأن التقي يستعين به على التقوى فتكون شريكا في طاعته بإعانتك إياه وقال صلى الله عليه وسلم أطعموا طعامكم الأتقياء وأولوا معروف", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}], "66": [{"arabic": "تقويم وأتم اعتدال ثم غذاه في أول نشوه بلبن استصفاه من بين فرث ودم سائغا كالماء الزلال ثم حماه بما آتاه من طيبات الرزق عن دواعي الضعف والانحلال ثم قيد شهوته المعادية له عن السطوة والصيال وقهرها بما افترضه عليه من طلب القوت الحلال وهزم بكسرها جند الشيطان المتشمر للإضلال ولقد كان يجري من ابن آدم مجرى الدم السيال فضيق عليه عزة الحلال المجرى والمجال إذ كان لا يبذرقه إلى أعماق العروق إلا الشهوة الماثلة إلى الغلبة والاسترسال فبقي لما زمت بزمام الحلال خائبا خاسرا ما له من ناصر ولا وال والصلاة على محمد الهادي من ال", "english": "To proceed: The Messenger of God, peace and blessings be upon him, said: «Seeking the lawful is an obligation upon every Muslim» — narrated by Ibn Masʿūd, may God be pleased with him. And this obligation, among all the other obligations, is the most resistant to the intellects in comprehension and the heaviest upon the bodily members in action. For this reason it has become utterly effaced, both as knowledge and as practice. The obscurity of its knowledge became the cause of the effacement of its practice, since the ignorant supposed that the lawful is nonexistent, that the path to reaching it is blocked, and that nothing remains of the good things save fresh water and the herbage growing in dead land — and whatever is beyond that, the transgressing hands have corrupted it and corrupt transactions have spoiled it. And when contentment with the herbage of plants proved impossible, no course remained save expansion into the unlawful. So they abandoned this pole of the religion entirely, and they did not perceive between properties any distinction or difference. Nay, far from it! Far from it! For the lawful is clear and the unlawful is clear, and between them are ambiguous matters; and these three remain ever conjoined, however the states may turn.", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 335", "section_title_en": "The Book of the Lawful and the Unlawful — Being the Fourth Book of the Quarter of Customs from The Revival of the Religious Sciences", "section_index": 335, "anchors": "- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: To praise, to laud, to commend; the core sense of acknowledging beneficence with reverence and gratitude.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of favor (niʿmah) with veneration; it is the fitting response to the Divine, who is praised for His essence and His acts alike.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"Aḥmad Allāh\" — to praise God with all His praises. Metaphorical (majāz): \"Aḥmadtu al-arḍ\" — to find the land commendable as a dwelling; thus praise may be directed to that which is not a rational agent by way of extension.\n- Root: طلب (ṭ-l-b)\n  * Lisan / Ayn: To seek, to request, to pursue; the exertion of effort toward obtaining something, whether a physical object or a meaning.\n  * Al-Raghib (Mufradat): Seeking (ṭalab) is the investigation into the existence of a thing, whether it be an entity or a concept; it implies a directed striving of the soul toward its object.\n  * Al-Zamakhshari (Asas): Literal: \"Ṭalaba al-shayʾ\" — to seek a thing with diligence. Metaphorical: \"Al-sirāj yaṭlubu an yanṭafiʾ\" — the lamp seeks to be extinguished, i.e., it is on the verge of it; thus seeking may denote an inherent inclination toward an end.\n- Root: ربع (r-b-ʿ)\n  * Lisan / Ayn: Four; a quarter; a dwelling-place; to remain in a place.\n  * Al-Raghib (Mufradat): The root denotes the number four and its derivatives; the quarter (rubʿ) is one of four parts, and the revival of the sciences is divided into four quarters (rubūʿ), each containing books.\n  * Al-Zamakhshari (Asas): Literal: \"Rabbaʿa al-qawm\" — to be the fourth of a people. Metaphorical: \"Rabbaʿahu Allāh\" — God raised him up and set him aright; thus the quarter (rubʿ) is that which structures and orders the whole.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening phrase is semantically complete, allowing for rhetorical expansion without syntactic rupture.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'The Lawful and Prohibited'", "badge": "Hadith"}, {"arabic": "ويسمى الفعل المصفى المخلص إخلاصا قال الله تعالى من بين فرث ودم لبنا خالصا سائغا للشاربين فإنما خلوص اللبن أن لا يكون فيه شوب من الدم والفرث ومن كل ما يمكن أن يمتزج به والإخلاص يضاده الإشراك فمن ليس مخلصا فهو مشرك إلا أن الشرك درجات فالإخلاص في التوحيد يضاده التشريك في الإلهية والشرك منه خفي ومنه جلي وكذا الإخلاص والإخلاص وضده يتواردان على القلب فمحله القلب وإنما يكون ذلك في القصود والنيات وقد ذكر حقيقة النية وأنها ترجع إلى إجابة البواعث فمهما كان الباعث واحد على التجرد سمي الفعل الصادر عنه إخلاصا بالإضافة إلى المنوي فمن تصدق وغرضه محض", "english": "Know that every thing which can be conceived as having something else mixed into it — when it becomes clear of that admixture and is purified from it — is called *khāliṣ* (pure/sincere). And the act that has been purified and rendered sincere is called *ikhlāṣ* (sincerity). God Most High has said: {«مِن بَيْنِ فَرْثٍ وَدَمٍ لَّبَنًا خَالِصًا سَائِغًا لِّلشَّارِبِينَ»} (\"From between filth and blood, pure milk, palatable to the drinkers\") {Sūrat al-Naḥl: 66}. For the purity of milk consists only in there being no admixture in it of blood or filth, nor of anything else that could possibly be mingled with it.", "book_title": "Intention, Sincerity and Truthfulness", "section_title_ar": "Section 1220", "section_title_en": "** The Reality of Sincerity (Al-Ikhlāṣ) and Its Adversaries — Purifying Works from Worldly Motives", "section_index": 1220, "anchors": "**\n- Root: خلص (Khalasa)\n  * Lisan / Ayn: Core meaning of becoming pure, clear, and free from admixture after having been mixed; the state of a thing being unmixed with any foreign element.\n  * Al-Raghib (Mufradat): Al-Khāliṣ is that which has been stripped of its impurity *after* having contained it — distinguished from ṣāfī which may describe what never had impurity. Theologically: sincerity is the purification of intention from all that is not God.\n  * Al-Zamakhshari (Asas): Literal (Ḥaqīqah): \"خلوص اللبن\" — milk's purity from blood and filth. Metaphorical (Majāz): \"أخلص لله دينه\" — devoting one's religion exclusively to God; the customary transfer of the term from physical purity to spiritual purity of intention.\n- Root: شرك (Sharaka)\n  * Lisan / Ayn: Mixing or sharing between two parties in a single thing; partnership.\n  * Al-Raghib (Mufradat): \"الشركة: خلط الملكين\" — the intermingling of two ownerships; applied to associating another with God in worship or intention.\n  * Al-Zamakhshari (Asas): Literal: partnership in property. Metaphorical: \"أشرك بالله\" — ascribing a partner to God; the hidden degrees of which are the concern here.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self; that which desires and inclines toward worldly gratification.\n  * Al-Raghib (Mufradat): The soul as the seat of appetites and worldly attachments — the internal obstacle to pure devotion.\n  * Al-Zamakhshari (Asas): Literal: the self. Metaphorical: \"نفس سائلة\" — flowing blood; here, the soul's \"shares\" (ḥuẓūẓ) are its cravings for worldly benefit.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The construction \"إنما الإخلاص تخليص العمل\" effects exclusive restriction, confining the reality of sincerity to the sole purification of the act from all admixture, with the predicate grammatically restricted to the subject alone.\n\n---\n\n**", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Intention, Sincerity and Truthfulness'", "badge": "Insight"}], "68": [{"arabic": "النحل وعجائبها وكيف أوحى الله تعالى إليها حتى اتخذت من الجبال بيوتا ومن الشجر ومما يعرشون وكيف استخرج من لعابها الشمع والعسل وجعل أحدهما ضياء وجعل الآخر شفاء ثم لو تأملت عجائب أمرها في تناولها الأزهار والأنوار واحترازها عن النجاسات والأقذار وطاعتها لواحد من جملتها هو أكبرها شخصا وهو أميرها ثم ما سخر الله تعالى له أميرها من العدل والإنصاف بينها حتى إنه ليقتل على باب المنفذ كل ما وقع منها على نجاسة لقضيت منها عجبا آخر العجب إن كنت بصيرا في نفسك وفارغا من هم بطنك وفرجك وشهوات نفسك في معاداة أقرانك وموالاة إخوانك ثم دع عنك جميع ذلك وانظر إ", "english": "...its sphere in which it is fixed — for there is no proportion between it and that sphere, and it is in the fourth heaven. And it is small in comparison to what is above it of the seven heavens. Then the seven heavens in relation to the Footstool (al-Kursī) are like a ring cast in a desert plain, and the Footstool in relation to the Throne (al-ʿArsh) is likewise. This then is a consideration of the outward aspect of bodies in terms of their magnitudes. And how contemptible is the entire earth in comparison to them! Nay, how small is the earth in relation to the seas! For the Messenger of God, peace and blessings be upon him, said: «The earth in the sea is like a stall in the midst of the land» (1). And the confirmation of this has been known through direct observation and experience, and it has been established that the portion of the earth uncovered by water is like a small island in comparison to the whole earth.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1166", "section_title_en": "The Wonders of Divine Creation in the Smallest Creatures — Reflections on the Mosquito, Bee, and the Scale of Creation", "section_index": 1166, "anchors": "- Root: صغر (ṣaghara)\n  * Lisan / Ayn: Smallness in size, stature, or rank; diminutiveness relative to another object.\n  * Al-Raghib (Mufradat): Smallness and greatness are relative terms (mutadāddah) — a thing is small only in comparison to something else, whether in body, time, or station.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical diminutiveness; metaphorical (majāz) for abasement or humility of station.\n- Root: شكل (shakala)\n  * Lisan / Ayn: Form, shape, likeness; also a hobble for a beast (shikāl), from which \"likeness\" is derived.\n  * Al-Raghib (Mufradat): Mushākalah is resemblance in form and figure; the root denotes tying/hobbling, extended metaphorically to that which binds things together in similarity.\n  * Al-Zamakhshari (Asas): Literal — \"this is its shakl\" (its exact like); metaphorical — \"shākilat al-ṭarīq\" (the two sides of a road), i.e., the two flanks of a path.\n- Root: خلق (khalaqa)\n  * Lisan / Ayn: To measure, proportion, fashion precisely; to create ex nihilo or from something.\n  * Al-Raghib (Mufradat): Original meaning is \"straight/right measurement\" (taqdīr mustaqīm); used for bringing forth from nothing (ibdāʿ) and for fashioning from existing matter.\n  * Al-Zamakhshari (Asas): Literal — the leather-worker cutting and measuring hide before cutting; metaphorical — God's creation as bringing into existence upon a measure necessitated by wisdom.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Permissible separation of a preposition from its object by an element upon which speech may properly pause, as in the periodic constructions of this passage.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Love, Longing, Intimacy and Contentment'", "badge": "Ethics"}], "75": [{"arabic": "ظاهرا من الحياة الدنيا وهم عن الآخرة هم غافلون الحمد لله بل أكثرهم لا يعلمون فالحب بهذا السبب أقوى من الحب بالإحسان لأن الإحسان يزيد وينقص ولذلك أوحى الله تعالى إلى داود عليه السلام إن أود الأوداء إلى من عبدني بغير نوال لكن ليعطي الربوبية حقها وفي الزبور من أظلم ممن عبدنى لجنة أونار لو لم أخلق جنة ولا نارا ألم أكن أهلا أن أطاع ومر عيسى عليه السلام على طائفة من العباد قد نحلوا فقالوا نخاف النار ونرجو الجنة فقال لهم مخلوقا خفتم ومخلوقا رجوتم ومر بقوم آخرين كذلك فقالوا نعبده حبا له وتعظيما لجلاله فقال أنتم أولياء الله حقا معكم أ", "english": "...power except through the enabling of his Master, just as He said concerning the greatest of the kings of the earth, Dhul-Qarnayn, when He said: {«إنا مكنا له في الأرض»} — \"Indeed, We established him firmly upon the earth\" (Q. 18:84). For all his kingship and sovereignty was nothing but the enabling of God Most High granted to him over a portion of the earth — and the entire earth is but a speck of dust in relation to the bodies of the world. And all the dominions that people attain from the earth are but a mote from that speck of dust. Then that mote, too, is from the bounty of God Most High and His enabling. It is therefore impossible that a servant should love one of God's servants for his power, his governance, his enablement, his dominion, and the completeness of his strength, yet not love God Most High for that very reason. And there is no might and no power except through God, the Exalted, the Magnificent. For He is the Compeller (al-Jabbār), the Subduer (al-Qāhir), the All-Knowing (al-'Alīm), the All-Powerful (al-Qādir). The heavens are folded in His right hand, and the earth with its kingdom and all that is upon it is in His grasp. The forelock of all creatures is in the grip of His power. If He destroyed them all, from the first to the last, not a single atom would diminish from His sovereignty and kingdom; and if He created their like a thousand times, He would not be wearied by their creation, nor would fatigue or languor touch Him in inventing them. So there is no power and no powerful one except that it is a trace of the traces of His power. To Him belongs beauty (al-jamāl), splendor (al-bahā'), majesty (al-'azamah), grandeur (al-kibriyā'), subjugation (al-qahr), and dominion (al-istīlā'). If, then, it is conceivable that a powerful one be loved for the completeness of his power, then none whatsoever deserves love for completeness of power save Him alone.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1156", "section_title_en": "The Fifth Cause of Love: Essential Beauty and Inner Affinity (Section 1156)", "section_index": 1156, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and enabling power; al-Farahidi notes its application to divine ordainment and human capacity.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is negation of incapacity ('ajz) in God; for humans, it is a contingent capacity granted by God's enabling (tamkīn), never absolute.\n  * Al-Zamakhshari (Asas): Literal: measured capacity and enablement; Metaphorical: \"far-reaching stride\" (ba'īd al-qadr) — here, all creaturely power is but a trace of divine power.\n- Root: قدس (q-d-s)\n  * Lisan / Ayn: Purity and sanctity; being set apart from defilement.\n  * Al-Raghib (Mufradat): Transcendence (taqdīs) as absolute purity from all deficiency — applicable in full only to God, the Holy (al-Quddūs).\n  * Al-Zamakhshari (Asas): Literal: physical cleansing; Metaphorical: moral and ontological transcendence from every imperfection.\n- Root: مثل (m-th-l)\n  * Lisan / Ayn: Likeness, similarity, and representation.\n  * Al-Raghib (Mufradat): Tamthīl (assimilation) and tashbīh (anthropomorphism) are impossible for God; munāsabah (affinity) is not likeness in form but in inner meaning.\n  * Al-Zamakhshari (Asas): Literal: visual resemblance; Metaphorical: spiritual congruence (munāsabah) between the servant and God through acquired divine attributes.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to confine absolute beauty, perfection, and lovability exclusively to God, e.g., \"the Beautiful absolutely is the One who has no equal.\"", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}, {"arabic": "في استحقاق الجنة به وإن قال أردت به أن يعيش مدة طويلة ولا يصلي ولا يقدم على شيء من الأعمال الشرعية فنقول فما ضبط تلك المدة وما عدد تلك الطاعات التي بتركها يبطل الإيمان وما عدد الكبائر التي بارتكابها يبطل الإيمان وهذا لا يمكن التحكم بتقديره ولم يصر إليه صائر أصلا الدرجة الرابعة أن يوجد التصديق بالقلب قبل أن ينطق باللسان أو يشتغل بالأعمال ومات فهل نقول مات مؤمنا بينه وبين الله تعالى وهذا مما اختلف فيه ومن شرط القول لتمام الإيمان يقول هذا مات قبل الإيمان وهو فاسد إذ قال صلى الله عليه وسلم يخرج من النار من كان في قلبه مثقال ذرة من", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}, {"arabic": "كالملوك والأكابر ويضعف مهما كان المادح ممن لا يؤبه له ولا يقدر على شيء فإن القدرة عليه بملك قلبه قدرة على أمر حقير فلا يدل المدح إلا على قدرة قاصرة وبهذه العلة أيضا يكره الذم ويتألم به القلب وإذا كان من الأكابر كانت نكايته أعظم لأن الفائت به أعظم السبب الثالث أن ثناء المثني ومدح المادح سبب لاصطياد قلب كل من يسمعه لا سيما إذا كان ذلك ممن يلتفت إلى قوله ويعتد بثنائه وهذا مختص بثناء يقع على الملأ فلا جرم كلما كان الجمع أكثر والمثني أجدر بأن يلتفت إلى", "english": "This contains no dissimulation (talbīs); rather, it is a blocking of the path to knowledge of that in which there is no benefit in knowing — like one who conceals from the Sultan that he drinks wine, yet does not cast to him that he is pious. For his saying \"I am pious\" would be dissimulation, whereas his failure to confess to drinking does not necessitate the belief in his piety; rather, it merely prevents knowledge of his drinking.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 802", "section_title_en": "Section 802 — On the Causes of the Love of Praise and the Soul's Delight in It, and Its Aversion to Blame", "section_index": 802, "anchors": "- Root: مدح (m-d-ḥ)\n  * Lisan / Ayn: مدح: الحسن الجميل في القول، والثناء على الرجل بما فيه من الخير.\n  * Al-Raghib (Mufradat): المدح: ذكر محاسن الغير، وهو ضرب من الثناء، ويقابله الذم، وكلاهما من أفعال القول الدالة على اعتقاد المتكلم.\n  * Al-Zamakhshari (Asas): Haqiqah: مدحه: أحسن الثناء عليه. Majaz: مدحه بوجهه: إذا أظهر السرور به، ومدحت الأرض: إذا أخصبت وحسنت.\n- Root: ذم (dh-m-m)\n  * Lisan / Ayn: الذم: نقيض المدح، وهو ذكر المساوي والقبائح.\n  * Al-Raghib (Mufradat): الذم: إظهار نقائص الغير، وهو ضد المدح، وقد يكون بحق أو بباطل.\n  * Al-Zamakhshari (Asas): Haqiqah: ذمه: قبح فعله ووصفه بالقبيح. Majaz: ذم الماء: إذا كان غير عذب، وذم المكان: إذا كان وخيما.\n- Root: ملك (m-l-k)\n  * Al-Raghib (Mufradat): الملك: هو المتصرف بالأمر والنهي في الجمهور، والملك ضربان: ملك هو التملك والتولي، وملك هو القوة على ذلك.\n  * Al-Zamakhshari (Asas): Haqiqah: ملك الشيء وامتلكه وتملكه. Majaz: ملك قلبه: استولى عليه، وملكت فلانة أمرها: خليت وشأنها.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to isolate the four causes of love of praise as exhaustive and ordered.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "الله مثلا عبدا مملوكا لا يقدر على شيء أراد به النفقة مما رزق وقوله عز وجل وضرب الله مثلا رجلين أحدهما أبكم لا يقدر على شيء أي الأمر بالعدل والاستقامة وقوله عز وجل فإن اتبعتني فلا تسألني عن شيء أراد به من صفات الربوبية وهو العلوم التي لا يحل السؤال عنها حتى يبتدئ بها العارف في أوان الاستحقاق وقوله عز وجل أم خلقوا من غير شي أم هم الخالقون أي من غير خالق فربما يتوهم به أنه يدل على أنه لا يخلق شيء إلا من شيء وأما القرين فكقوله عز وجل وقال قرينه هذا ما لدي عتيد ألقيا في جهنم كل كفار أر", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}, {"arabic": "حرف أما الكلمة فكالشيء والقرين والأمة والروح ونظائرها قال الله تعالى ضرب الله مثلا عبدا مملوكا لا يقدر على شيء أراد به النفقة مما رزق وقوله عز وجل وضرب الله مثلا رجلين أحدهما أبكم لا يقدر على شيء أي الأمر بالعدل والاستقامة وقوله عز وجل فإن اتبعتني فلا تسألني عن شيء أراد به من صفات الربوبية وهو العلوم التي لا يحل السؤال عنها حتى يبتدئ بها العارف في أوان الاستحقاق وقوله عز وجل أم خلقوا من غير شي أم هم الخالقون أي من غير خالق فربما يتوهم به أنه يدل على أنه لا يخلق شيء إلا من شيء وأما القرين فكقوله عز وجل وقال قرينه هذا ما لدي عتيد ألقيا في جهنم كل كفار أراد", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "76": [{"arabic": "في استحقاق الجنة به وإن قال أردت به أن يعيش مدة طويلة ولا يصلي ولا يقدم على شيء من الأعمال الشرعية فنقول فما ضبط تلك المدة وما عدد تلك الطاعات التي بتركها يبطل الإيمان وما عدد الكبائر التي بارتكابها يبطل الإيمان وهذا لا يمكن التحكم بتقديره ولم يصر إليه صائر أصلا الدرجة الرابعة أن يوجد التصديق بالقلب قبل أن ينطق باللسان أو يشتغل بالأعمال ومات فهل نقول مات مؤمنا بينه وبين الله تعالى وهذا مما اختلف فيه ومن شرط القول لتمام الإيمان يقول هذا مات قبل الإيمان وهو فاسد إذ قال صلى الله عليه وسلم يخرج من النار من كان في قلبه مثقال ذرة من", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}, {"arabic": "كالملوك والأكابر ويضعف مهما كان المادح ممن لا يؤبه له ولا يقدر على شيء فإن القدرة عليه بملك قلبه قدرة على أمر حقير فلا يدل المدح إلا على قدرة قاصرة وبهذه العلة أيضا يكره الذم ويتألم به القلب وإذا كان من الأكابر كانت نكايته أعظم لأن الفائت به أعظم السبب الثالث أن ثناء المثني ومدح المادح سبب لاصطياد قلب كل من يسمعه لا سيما إذا كان ذلك ممن يلتفت إلى قوله ويعتد بثنائه وهذا مختص بثناء يقع على الملأ فلا جرم كلما كان الجمع أكثر والمثني أجدر بأن يلتفت إلى", "english": "This contains no dissimulation (talbīs); rather, it is a blocking of the path to knowledge of that in which there is no benefit in knowing — like one who conceals from the Sultan that he drinks wine, yet does not cast to him that he is pious. For his saying \"I am pious\" would be dissimulation, whereas his failure to confess to drinking does not necessitate the belief in his piety; rather, it merely prevents knowledge of his drinking.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 802", "section_title_en": "Section 802 — On the Causes of the Love of Praise and the Soul's Delight in It, and Its Aversion to Blame", "section_index": 802, "anchors": "- Root: مدح (m-d-ḥ)\n  * Lisan / Ayn: مدح: الحسن الجميل في القول، والثناء على الرجل بما فيه من الخير.\n  * Al-Raghib (Mufradat): المدح: ذكر محاسن الغير، وهو ضرب من الثناء، ويقابله الذم، وكلاهما من أفعال القول الدالة على اعتقاد المتكلم.\n  * Al-Zamakhshari (Asas): Haqiqah: مدحه: أحسن الثناء عليه. Majaz: مدحه بوجهه: إذا أظهر السرور به، ومدحت الأرض: إذا أخصبت وحسنت.\n- Root: ذم (dh-m-m)\n  * Lisan / Ayn: الذم: نقيض المدح، وهو ذكر المساوي والقبائح.\n  * Al-Raghib (Mufradat): الذم: إظهار نقائص الغير، وهو ضد المدح، وقد يكون بحق أو بباطل.\n  * Al-Zamakhshari (Asas): Haqiqah: ذمه: قبح فعله ووصفه بالقبيح. Majaz: ذم الماء: إذا كان غير عذب، وذم المكان: إذا كان وخيما.\n- Root: ملك (m-l-k)\n  * Al-Raghib (Mufradat): الملك: هو المتصرف بالأمر والنهي في الجمهور، والملك ضربان: ملك هو التملك والتولي، وملك هو القوة على ذلك.\n  * Al-Zamakhshari (Asas): Haqiqah: ملك الشيء وامتلكه وتملكه. Majaz: ملك قلبه: استولى عليه، وملكت فلانة أمرها: خليت وشأنها.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to isolate the four causes of love of praise as exhaustive and ordered.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "الله مثلا عبدا مملوكا لا يقدر على شيء أراد به النفقة مما رزق وقوله عز وجل وضرب الله مثلا رجلين أحدهما أبكم لا يقدر على شيء أي الأمر بالعدل والاستقامة وقوله عز وجل فإن اتبعتني فلا تسألني عن شيء أراد به من صفات الربوبية وهو العلوم التي لا يحل السؤال عنها حتى يبتدئ بها العارف في أوان الاستحقاق وقوله عز وجل أم خلقوا من غير شي أم هم الخالقون أي من غير خالق فربما يتوهم به أنه يدل على أنه لا يخلق شيء إلا من شيء وأما القرين فكقوله عز وجل وقال قرينه هذا ما لدي عتيد ألقيا في جهنم كل كفار أر", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}, {"arabic": "وجل وضرب الله مثلا رجلين أحدهما أبكم لا يقدر على شيء أي الأمر بالعدل والاستقامة وقوله عز وجل فإن اتبعتني فلا تسألني عن شيء أراد به من صفات الربوبية وهو العلوم التي لا يحل السؤال عنها حتى يبتدئ بها العارف في أوان الاستحقاق وقوله عز وجل أم خلقوا من غير شي أم هم الخالقون أي من غير خالق فربما يتوهم به أنه يدل على أنه لا يخلق شيء إلا من شيء وأما القرين فكقوله عز وجل وقال قرينه هذا ما لدي عتيد ألقيا في جهنم كل كفار أراد به الملك الموكل به وقوله تعالى قال قرينه ربنا ما أطغيته ولكن كان أراد به الشيطان وأما", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Quran Recitation'", "badge": "Du'a"}, {"arabic": "مملوك لا تقدر على شيء ومن عرف ذلك لا بد وأن يزول كبره ومثاله أن يفتخر الغافل بقوته وجماله وماله وحريته واستقلاله وسعة منازله وكثرة خيوله وغلمانه إذ شهد عليه شاهدان عدلان عند حاكم منصف بأنه رقيق لفلان وأن أبويه كانا مملوكين له فعلم ذلك وحكم به الحاكم فجاء مالكه فأخذه وأخذ جميع ما في يده وهو مع ذلك يخشى أن يعاقبه وينكل به لتفريطه في أمواله وتقصيره في طلب مالكه ليعرف أن له مالكا ثم نظر العبد فرأى نفسه محبوسا في منزل قد أحدقت به الحيات والعقارب والهوام وهو في كل حال على", "english": "...twice. Likewise, Ṭāwūs said to ʿUmar ibn ʿAbd al-ʿAzīz — when he saw him strutting with arrogance, and that was before his caliphate — \"This is not the gait of one in whose belly there is filth.\" And this is its beginning and its middle.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 867", "section_title_en": "The Cure for Pride in Beauty, Strength, and Wealth — Section 867", "section_index": 867, "anchors": "- Root: قبح (qubḥ)\n  * Lisan / Ayn: Core root meaning \"ugliness, foulness, disgrace\" — both moral and physical deformity.\n  * Al-Raghib (Mufradat): Theological nuance: qubḥ is the contrary of ḥusn; in Kalam, it denotes what reason or revelation deems reprehensible, whether in act or attribute.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage applies to sensory ugliness; metaphorical (majāz) extends to moral baseness — here Ghazali pivots between both to shame the proud.\n- Root: ذل (dhillah)\n  * Lisan / Ayn: \"Lowliness, abasement, submission\" — opposite of ʿizzah (honor/might).\n  * Al-Raghib (Mufradat): In Quranic usage, dhullah is the state of one stripped of all self-sufficiency, utterly dependent on another.\n  * Al-Zamakhshari (Asas): Literal: physical humiliation before a conqueror; metaphorical: the soul's recognition of its ontological servitude before its true Owner.\n- Root: ملك (milk)\n  * Lisan / Ayn: \"Possession, ownership, dominion\" — from which malik (king) and mamlūk (slave) derive.\n  * Al-Raghib (Mufradat): True milk belongs to Allah alone; creaturely possession is borrowed, contingent, and revocable at any instant.\n  * Al-Zamakhshari (Asas): Literal: legal ownership of property or persons; metaphorical: the illusion of self-ownership that pride presupposes — Ghazali shatters this illusion via the juridical parable.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic sentence structure here repeatedly delays the apodosis (jawāb al-sharṭ) to build rhetorical tension, as in \"لو توجع عرق واحد... لصار أعجز\" — the protasis and apodosis are separated by expanding clauses, mirroring the cumulative weight of evidence against pride.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "77": [{"arabic": "حق وأمر جزم استعير له لفظ القضاء وقيل إنه كلمح بالبصر أو هو أقرب لفاضت بحار المقادير بحكم ذلك القضاء الجزم بما سبق به التقدير فاستعير لترتب آحاد المقدورات بعضها على بعض لفظ القدر فكان لفظ القضاء بإزاء الآمر الواحد الكلي ولفظ القدر بإزاء التفصيل المتمادي إلى غير نهاية وقيل إن شيئا من ذلك ليس خارجا عن القضاء والقدر فخطر لبعض العباد أن القسمة لماذا اقتضت هذا التفصيل وكيف انتظم العدل مع هذا التفاوت والتفضيل وكان بعضهم لقصوره لا يطيق ملاحظة كنه هذا الأمر والاحتواء على مجامعه فألجموا عما لم يطيقوا خوض غمرته بلجام ا", "english": "...in the light of the sun, but due to a weakness in the eyesight of the bats. Thus those whose eyes had been opened to behold its majesty were compelled to borrow, from the lowly depths of the world of those who converse in languages, an expression that might convey, from the first principles of its realities, something exceedingly feeble. So they borrowed for it the name \"power\" (qudrah), and we, by reason of their borrowing, grew bold in speech, and said: \"To God most high there is an attribute which is power, and from it issue creation and invention.\" Then creation, in its existence, divides into kinds, and into specific attributes; and the source of the division of these kinds and their being distinguished by their specific attributes is another attribute, for which was borrowed, in like manner to the necessity that preceded, the expression \"will\" (mashī'ah). For it suggests of it something obscure to those who converse in languages—which are but letters and sounds by which people understand one another—and the inadequacy of the word \"will\" to indicate the inner reality (kunnah) of that attribute and its true nature is like the inadequacy of the word \"power.\" Then the acts issuing from power divided into what sweeps on to the terminus which is the goal of its wisdom, and into what halts short of the goal. And each of these had a relation to the attribute of will, by virtue of their reversion to the specifications (ikhtiṣāṣāt) through which the division and the differences are completed. So for the relation of that which attains its goal, the expression \"love\" (maḥabbah) was borrowed; and for the relation of that which halts short of its goal, the expression \"aversion\" (karāhah) was borrowed. And it was said that both of these are included within the description of will, but each has another particular property in its relation, which the words \"love\" and \"aversion\" suggest of them as something summarized for those who seek understanding from words and languages. Then His servants—who are also of His creation and invention—divided into: one for whom the eternal will (al-mashī'ah al-azaliyyah) had previously decreed that He would use him to halt His wisdom short of its goal, this being compulsion (qahr) in their regard, by the subjugation of motives and incitements upon them; and one for whom it had previously been decreed in eternity that He would use him to drive His wisdom to its goal in certain matters. So each of the two groups had a particular relation to the will; and for the relation of those used in completing wisdom through them, the expression \"good pleasure\" (riḍā) was borrowed; and for those by whom the causes of wisdom were halted short of its goal, the expression \"wrath\" (ghaḍab) was borrowed. Thus there appeared, upon him against whom wrath was decreed in eternity, an act by which wisdom was halted short of its goal; for this, the expression \"ingratitude\" (kufrān) was borrowed, and it was followed by the infliction of curse and blame as an increase in chastisement. And there appeared, upon him whom He approved in eternity, an act by which wisdom swept on to its goal; for this, the expression \"thanksgiving\" (shukr) was borrowed, and it was followed by the robe of praise and eulogy, as an increase in good pleasure, acceptance, and approach. So the outcome was that He most high gave beauty, then praised; and gave chastisement, then made ugly and destroyed. And His likeness is that a king should cleanse his servant of his filth, then clothe him in the finest of his garments; and when he has perfected his adornment, he says: \"O beautiful one, how beautiful you are, and how beautiful your garments, and how clean your face!\"—so that in reality, he is the one who beautifies, and he is the one who praises beauty; thus he is the praised one in every case. And it is as though, in meaning, he praised none but himself; the servant is merely the target of praise in respect of the outward appearance and form. Even so were the matters in eternity, and even so do causes and effects string themselves in sequence, by the decreeing of the Lord of lords and the Causer of causes. And that was not by chance or deliberation, but by will, and wisdom, and a true judgment, and a decisive command, for which the word \"decree\" (qaḍā') was borrowed. And it was said: it is like the glance of the eye, or nearer still. Then the seas of measured destinies (maqādīr) overflowed by the ruling of that decisive decree, with what predetermination (taqdīr) had previously passed. So for the ordering of the individual determined things (al-maqdūrāt), one upon another, the word \"measure\" (qadar) was borrowed. Thus the word \"decree\" (qaḍā') stood in correspondence to the one, unitary command, and the word \"measure\" (qadar) stood in correspondence to the detailed differentiation extending without end. And it was said that nothing of all this lies outside decree and measure. Then it occurred to some servants to ask: \"Why did the division necessitate this differentiation, and how did justice cohere with this disparity and preference?\" And some of them, due to their deficiency, could not bear to observe the inner reality of this matter or to encompass its totality; so they were bridled, from what they could not bear to plunge into its deep, with the bridle of prevention, and it was said to them: \"Be still—for this you were not created. He is not questioned about what He does, but they shall be questioned\" {«لا يسئل عما يفعل وهم يسئلون»}. And the niche (mishkāh) of others was filled with light borrowed from the light of God most high in the heavens and the earth; and their oil was at first pure, well-nigh luminous, even had no fire touched it; then fire touched it, and it blazed, light upon light, and the regions of the dominion (malakūt) shone before them with the light of their Lord. So they perceived all things as they truly are, and it was said to them: \"Be disciplined with the disciplines of God most high, and be still.\" And when...", "book_title": "Patience and Gratitude", "section_title_ar": "Section 988", "section_title_en": "The Borrowed Language of Divine Attributes: On the Inadequacy of Human Terms for the Realities of Qaḍā', Qadar, and the Eternal Decree", "section_index": 988, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core root denotes measuring, determining, and ordaining a thing's extent and limit; al-Farahidi records its sense of precise appraisal and decreeing.\n  * Al-Raghib (Mufradat): \"القدرة\" when ascribed to God negates incapacity ('ajz) absolutely; it is not a modality of acquisition as in creatures, but the sheer source whence creation issues—here Ghazali uses it as a borrowed term (isti'ārah) for an ineffable divine reality.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) sense is \"ذو قدرة\" (possessor of power); metaphorical (majāz) extension appears in \"فرس بعيد القدر\" (a horse of far-reaching stride)—so too here, \"القدر\" is extended to the serial ordering of ordained particulars, not a spatial or physical measure.\n- Root: قسم (q-s-m)\n  * Lisan / Ayn: Division and apportioning of shares; al-Farahidi ties it to partitioning lots.\n  * Al-Raghib (Mufradat): \"القسم: إفراز النصيب\" — the separation of portions; Ghazali exploits this to show how creation's division into kinds and specific attributes demands a further attribute (the will) that specifies each portion.\n  * Al-Zamakhshari (Asas): Literal: dividing wealth among parties; metaphorical: \"قلبه متقسم\" (his heart is divided by cares)—likewise, the division of acts under the will is a conceptual, not physical, partition.\n- Root: لفظ (l-f-ẓ)\n  * Lisan / Ayn: Utterance as a casting out from the mouth; al-Farahidi notes its source-verb sense of ejection.\n  * Al-Raghib (Mufradat): \"اللفظ بالكلام مستعار من: لفظ الشيء من الفم\" — speech-utterance is borrowed from physical ejection; Ghazali applies this to show how terms like \"power,\" \"will,\" \"love,\" and \"wrath\" are merely cast-out approximations, not containers of divine essence.\n  * Al-Zamakhshari (Asas): Not separately cited; the root's rhetorical force lies in its inadequacy—words are sounds and letters, unable to convey the \"kenne\" (inner reality) of the divine.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Ghazali's repeated \"إنما\" constructions (e.g., \"وإنما العبد هدف الثناء\") restrict the predicate to a single focused truth, isolating the apparent agent from the real one, per Sibawayh's rule that \"إنما\" confines judgment to what follows it, negating all else.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "الأول الذي هو كلمح البصر أو هو أقرب وترتيب تفصيل المسببات على تفاصيل الأسباب على التدريج والتقدير هو القدر والذي قدر الخير قدره بسبب والذي قدر الشر قدر لدفعه سببا فلا تناقض بين هذه الأمور عند من انفتحت بصيرته ثم في الدعاء من الفائدة ما ذكرناه في الذكر فإنه يستدعي حضور القلب مع الله وهو منتهى العبادات ولذلك قال صلى الله عليه وسلم الدعاء مخ العبادة (1) والغالب على الخلق أنه لا تنصرف قلوبهم إلى ذكر الله عز وجل إلا عند إلمام حاجة وإرهاق ملمة فإن الإنسان إذا مسه الشر فذو دعاء عر", "english": "\"O God, whatever blessing has come to me this morning, or to any of Your creatures, it is from You alone, with no partner to You; to You is praise and to You is thanksgiving.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 255", "section_title_en": "Section 255", "section_index": 255, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}], "90": [{"arabic": "والإحسان وإيتاء ذي القربى وينهى عن الفحشاء والمنكر والبغي وأنا رأيت منكرا فغيرته فقال فغيره فوالله ما قال إلا هذا فلما خرج أعطى الخليفة رجلا بدرة وقال اتبع الشيخ فإن رأيته يقول قلت لأمير المؤمنين وقال لي فلا تعطه شيئا وإن رأيته لا يكلم أحدا فأعطه البدرة فلما خرج من القصر إذا هو بنواة في الأرض قد غاصت فجعل يعالجها ولم يكلم أحدا فقال له يقول لك أمير المؤمنين خذه هذه البدرة فقال قل لأمير المؤمنين يردها من حيث أخذها ويروى أنه أقبل بعد فراغه من كلامه على النواة التي يعالج قلعها من الأرض وهو يقول أ", "english": "And it is astonishing that the Rāfiḍah went beyond this and said: \"It is not permissible to enjoin the good as long as the infallible Imam — who, in their view, is the true Imam — has not come forth.\" These are too base in rank to be addressed; rather, their answer is to say to them: When they come to a judge seeking their rights concerning their blood and their wealth, [one says to them:] \"If I aided you, that would be enjoining the good, and extracting your rights from the hands of those who wronged you would be forbidding the munkar — and your seeking your right is part of the good. But this is not the time for forbidding injustice and seeking rights, because the true Imam has not yet come forth.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 526", "section_title_en": "The Fourth Condition: Authorization from the Imam and Governor — Its Invalidity, and the Five Ranks of Ḥisbah", "section_index": 526, "anchors": "- Root: أ ذ ن (ʾ-dh-n)\n  * Lisan / Ayn: Core meaning is \"permission\" or \"license\" — to grant leave for an act; also \"ear\" (udhun), the instrument of hearing command.\n  * Al-Raghib (Mufradat): In theological usage, ʾidhn denotes divine or authoritative sanction that legitimizes an action; its absence renders the act transgressive (muʿtadā).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is \"to permit\"; metaphorical (majāz) extension applies to the Imam's delegation of authority, which is a contingent, not essential, condition.\n- Root: ن ك ر (n-k-r)\n  * Lisan / Ayn: Nakirah denotes the unrecognized or the objectionable; munkar is that which the sound intellect and divine law repudiate.\n  * Al-Raghib (Mufradat): Inkār is the heart's rejection of what it does not conceive as right; it opposes maʿrifah (recognition). The tongue's inkār may be true or feigned.\n  * Al-Zamakhshari (Asas): Nakira is stronger than ankara — the former is the heart's denial, the latter the eye's; here, munkar is the objective evil that the enjoiner must repel.\n- Root: ع ر ف (ʿ-r-f)\n  * Lisan / Ayn: ʿArafa means to know by trace or sign; maʿrūf is that which is well-known and approved by revelation and custom.\n  * Al-Raghib (Mufradat): Maʿrifah is knowledge attained through reflection on effects — more specific than ʿilm; hence, al-amr bi-l-maʿrūf is commanding what is recognized as good by divine attestation.\n  * Al-Zamakhshari (Asas): Literal sense is \"to know\"; here, maʿrūf is the established good, and its enjoining is a communal obligation independent of temporal authorization.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Specification) — The conditional clause \"sharaṭa hādhā al-sharṭ\" is a restrictive predication that the author refutes by universalizing the command (ʿalā al-ʿumūm), a syntactic move that nullifies the exception.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "إني سمعت أباك وأجدادك يقرءون هذه الآية على المنبر إن الله يأمر بالعدل والإحسان وإيتاء ذي القربى وينهى عن الفحشاء والمنكر والبغي وأنا رأيت منكرا فغيرته فقال فغيره فوالله ما قال إلا هذا فلما خرج أعطى الخليفة رجلا بدرة وقال اتبع الشيخ فإن رأيته يقول قلت لأمير المؤمنين وقال لي فلا تعطه شيئا وإن رأيته لا يكلم أحدا فأعطه البدرة فلما خرج من القصر إذا هو بنواة في الأرض قد غاصت فجعل يعالجها ولم يكلم أحدا فقال له يقول لك أمير المؤمنين خذه هذه البدرة فقال قل لأمير المؤمنين يردها من حيث أخذها ويروى أنه أقبل بعد فراغه من كلامه على النواة التي يعالج قلعها من الأرض وهو يقول أرى الدن", "english": "And it is astonishing that the Rāfiḍah went beyond this and said: \"It is not permissible to enjoin the good as long as the infallible Imam — who, in their view, is the true Imam — has not come forth.\" These are too base in rank to be addressed; rather, their answer is to say to them: When they come to a judge seeking their rights concerning their blood and their wealth, [one says to them:] \"If I aided you, that would be enjoining the good, and extracting your rights from the hands of those who wronged you would be forbidding the munkar — and your seeking your right is part of the good. But this is not the time for forbidding injustice and seeking rights, because the true Imam has not yet come forth.\"", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 526", "section_title_en": "The Fourth Condition: Authorization from the Imam and Governor — Its Invalidity, and the Five Ranks of Ḥisbah", "section_index": 526, "anchors": "- Root: أ ذ ن (ʾ-dh-n)\n  * Lisan / Ayn: Core meaning is \"permission\" or \"license\" — to grant leave for an act; also \"ear\" (udhun), the instrument of hearing command.\n  * Al-Raghib (Mufradat): In theological usage, ʾidhn denotes divine or authoritative sanction that legitimizes an action; its absence renders the act transgressive (muʿtadā).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is \"to permit\"; metaphorical (majāz) extension applies to the Imam's delegation of authority, which is a contingent, not essential, condition.\n- Root: ن ك ر (n-k-r)\n  * Lisan / Ayn: Nakirah denotes the unrecognized or the objectionable; munkar is that which the sound intellect and divine law repudiate.\n  * Al-Raghib (Mufradat): Inkār is the heart's rejection of what it does not conceive as right; it opposes maʿrifah (recognition). The tongue's inkār may be true or feigned.\n  * Al-Zamakhshari (Asas): Nakira is stronger than ankara — the former is the heart's denial, the latter the eye's; here, munkar is the objective evil that the enjoiner must repel.\n- Root: ع ر ف (ʿ-r-f)\n  * Lisan / Ayn: ʿArafa means to know by trace or sign; maʿrūf is that which is well-known and approved by revelation and custom.\n  * Al-Raghib (Mufradat): Maʿrifah is knowledge attained through reflection on effects — more specific than ʿilm; hence, al-amr bi-l-maʿrūf is commanding what is recognized as good by divine attestation.\n  * Al-Zamakhshari (Asas): Literal sense is \"to know\"; here, maʿrūf is the established good, and its enjoining is a communal obligation independent of temporal authorization.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Specification) — The conditional clause \"sharaṭa hādhā al-sharṭ\" is a restrictive predication that the author refutes by universalizing the command (ʿalā al-ʿumūm), a syntactic move that nullifies the exception.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}, {"arabic": "علي القرآن فقرأ عليه إن الله يأمر بالعدل والإحسان وإيتاء ذي القربى الآية فقال له فأعاد فقال والله إن له لحلاوة وإن عليه لطلاوة وإن أسفله لمورق وإن أعلاه لمثمر وما يقول هذا بشر (1) وقال الحسن والله ما دون القرآن من غنى ولا بعده من فاقة وقال الفضيل من قرأ خاتمة سورة الحشر حين يصبح ثم مات من يومه ختم له بطابع الشهداء ومن قرأها حين يمسي ثم مات من ليلته ختم له بطابع الشهداء وقال القاسم بن عبد الرحمن قلت لبعض النساك ما ههنا أحد نستأنس به فمد يده إلى المصحف ووضعه على حجره وقال هذا وقال علي بن أبي طالب رضي الله عنه ث", "english": "God, may He be exalted, said: {«...»} (1)", "book_title": "Patience and Gratitude", "section_title_ar": "Section 221", "section_title_en": "The Virtues of the Qur'an — Section 221: Hadiths and Reports on the Excellence of Qur'anic Recitation", "section_index": 221, "anchors": "- Root: قرا (Qara'a)\n  * Lisan / Ayn: Core meaning of reading/reciting; Al-Khalil notes the root's connection to gathering and collecting letters into articulated speech.\n  * Al-Raghib (Mufradat): Theological nuance — recitation (tilāwah) as the act of following the Qur'an's words with attentive devotion; the term qāri' extends to one who is a devoted worshipper (nāsik).\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literally \"reading/reciting\"; metaphorically applied to the one who devotes himself to worship through recitation, as in Jarīr's verse.\n- Sibawayh Rule: Prepositional Interposition (al-faṣl bayn al-jār wa-al-majrūr) — governing the syntactic placement of qualifying phrases within hadith citations.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "93": [{"arabic": "عز وجل سقاه الله ومن كسا لله عز وجل كساه الله وقال الحسن لو شاء الله لجعلكم أغنياء لا فقير فيكم ولكنه ابتلى بعضكم ببعض وقال الشعبي من لم ير نفسه إلى ثواب الصدقة أحوج من الفقير إلى صدقته فقد أبطل صدقته وضرب بها وجهه وقال مالك لا نرى بأسا بشرب المؤمن من الماء الذي يتصدق به ويسقى في المسجد لأنه إنما جعل للعطشان من كان ولم يرد به أهل الحاجة والمسكنة على الخصوص ويقال إن الحسن مر به نخاس ومعه جارية فقال للنخاس أترضى في ثمنها الدرهم والدرهمين قال لا قال فاذهب فإن الله عز وجل رضي في الحور العين بالفلس واللقمة", "english": "Among the reports [concerning charity], his saying (peace and blessings be upon him): \"Give charity, even if with a single date-fruit, for it stays the hunger of the hungry and extinguishes sin just as water extinguishes fire.\" (1) And he said (peace and blessings be upon him): \"Guard yourselves against the Fire, even if with half a date-fruit; and if you find not even that, then with a kind word.\" (2) And he said (peace and blessings be upon him): \"There is no Muslim servant who gives charity from lawful earnings — and God accepts only what is lawful — but that God takes it in His Right Hand and nurtures it just as one of you nurtures his foal, until the single date-fruit grows to be like Mount Uḥud.\" (3) And he said (peace and blessings be upon him) to Abū al-Dardāʾ: \"When you cook a broth, increase its water, then look to a household among your neighbors and bestow upon them from it with kindness.\" (4) And he said (peace and blessings be upon him): \"No servant does well in charity but that God (mighty and majestic) does well for him in the stewardship of what he leaves behind.\" (5) And he said (peace and blessings be upon him): \"Every person is in the shade of his charity until judgment is rendered between the people.\" (6) And he said (peace and blessings be upon him): \"Charity closes seventy doors of evil.\" (7) And he said (peace and blessings be upon him): \"Secret charity extinguishes the wrath of the Lord (mighty and majestic).\" And the Messenger of God (peace and blessings be upon him) said: \"The one who gives from abundance is not more excellent in reward than the one who accepts from need.\" (8) Perhaps what is meant thereby is the one who intends, by the repelling of his need, to free himself for religion — so that he becomes equal to the giver who intends, by his giving, the flourishing of his religion.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 181", "section_title_en": "The Book of the Etiquettes of Eating — Section on the Merits of Charity (Ṣadaqah) and Its Etiquettes", "section_index": 181, "anchors": "- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Core meaning of truthfulness, veracity in speech and action; al-Raghib notes its origin is in speech (al-qawl), whether past or future, promise or otherwise.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood originate in utterance; charity (ṣadaqah) is so named because it is the truthful verification of one's faith through material sacrifice.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صدقته الحديث\" — to affirm someone's statement as true. Metaphorical (majāz): \"رجل صادق الحملة\" — a man truthful in his charge (i.e., steadfast in battle). Charity is thus the \"truthing\" of one's claim to faith by action.\n- Root: عله (ʿ-l-h) — [Note: This root appears in the scholia but is not directly relevant to the present text; the governing root for \"feeding\" is أ-ك-ل and for \"giving\" is ع-ط-ي]\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the sensing of fear within oneself.\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {«إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ»}\" — the believers are those whose hearts tremble when God is mentioned.\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a people fearful. The root conveys the inner trepidation of the heart before divine majesty.\n- Root: سبع (s-b-ʿ)\n  * Al-Raghib (Mufradat): \"أصل السبع العدد\" — the root origin is the number seven; used for the seven heavens, seven earths, and in the present context, the seventy (seventy being a multiple of seven) doors of evil.\n  * Al-Zamakhshari (Asas): Literal: \"هو سابع سبعة\" — he is the seventh of seven. Metaphorical (majāz): \"أخذه أخذ سبعة\" — \"he seized with the seizure of seven,\" a proverb for intense, overwhelming force. The number seventy thus signifies multiplicity and completeness in repelling evil.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" (إنما) restricts and confines the predicate to the subject alone, negating it for all others. This is crucial in the ḥadīth: \"إنما هي أوساخ الناس\" — charity is exclusively the filth of people, restricted to them and forbidden for the Prophet's family.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Mysteries of Zakat'", "badge": "Hadith"}, {"arabic": "ولا معقب لحكمه يضل من يشاء ويهدي من يشاء لا يسئل عما يفعل وهم يسألون ويدل عليه من النقل قول الأمة قاطبة ما شاء كان وما لم يشأ لم يكن وقول الله عز وجل أن لو يشاء الله لهدى الناس جميعا وقوله تعالى ولو شئنا لآتينا كل نفس هداها ويدل عليه من جهة العقل أن المعاصي والجرائم إن كان الله يكرهها ولا يريدها وإنما هي جارية على وفق إرادة العدو إبليس لعنه الله مع أنه عدو لله سبحانه والجاري على وفق إرادة العدو أكثر من الجاري على وفق إرادته تعالى فليت شعري كيف يستجيز المسلم أن يرد ملك الجبار ذي الجلال", "english": "As for the movement, it is a creation of the Lord — exalted is He — an attribute of the servant, and an acquisition of his. For it was created as empowered (maqdūrah) by a power that is His attribute, and the movement has a relation to another attribute called power; thus, by virtue of that relation, it is termed \"acquisition.\" And how could it be pure compulsion (jabr maḥḍ), when he necessarily perceives the distinction between the empowered movement and the involuntary tremor (al-raʿdah al-ḍarūriyyah)? Or how could it be a creation of the servant, when he does not encompass knowledge of the details of the parts of acquired movements nor their numbers? And when both extremes are refuted, nothing remains except moderation in belief (al-iqtiṣād fī al-iʿtiqād) — namely, that it is empowered by the power of God — exalted is He — by way of origination, and by the power of the servant in another mode of attachment (taʿlīq) expressed as acquisition.", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 93", "section_title_en": "The Second Foundation: God's Sole Creation of Servants' Movements Does Not Negate Their Being Acquired by Servants", "section_index": 93, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and empowering; al-Farahidi notes its application to capacity and divine decree.\n  * Al-Raghib (Mufradat): \"القدرة\" when attributed to humans denotes a state enabling one to perform an act; when attributed to God, it negates incapacity. Absolute power belongs solely to God; for others, it is always restricted and particularized.\n  * Al-Zamakhshari (Asas): Literal: \"هو قادر مقتدر ذو قدرة ومقدرة\" — one possessing power. Metaphorical: \"فرس بعيد القدر\" — a horse of far-reaching stride, extending the root to scope and reach.\n- Root: كسب (k-s-b)\n  * Lisan / Ayn: Acquisition, earning, and what one gains; al-Farahidi links it to amassing and profiting.\n  * Al-Raghib (Mufradat): Acquisition (al-kasb) in theological terms denotes an act's relation to the servant whereby responsibility attaches, while its origination remains divine.\n  * Al-Zamakhshari (Asas): Literal: earning and gaining. Metaphorical: the theological sense of acquired act (al-faʿl al-iktisābī) — a relational attribution distinct from creation.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring and smoothing; al-Farahidi notes its application to fashioning and proportioning.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — origination from nothing (ibdāʿ) or from something, always upon a measured determination.\n  * Al-Zamakhshari (Asas): Literal: measuring before cutting. Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom.\n- Root: وجب (w-j-b)\n  * Lisan / Ayn: Being due, necessary, or obligatory; al-Farahidi notes its legal and ontological senses.\n  * Al-Raghib (Mufradat): \"الوجوب: الثبوت\" — necessary being is that whose non-existence entails an impossibility; obligation is that whose omission warrants blame.\n  * Al-Zamakhshari (Asas): Literal: \"وجب البيع\" — the sale became binding. Metaphorical: \"هو يأكل الوجبة\" — eating once daily, extending to fixed determination.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The particle \"إنما\" restricts predication, as in \"إنما هو إله واحد,\" confining the attribute to its subject and negating it from others. This governs the Ashʿarī restriction of creative power to God alone while affirming acquired power for servants through a distinct relational mode.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'The Lawful and Prohibited'", "badge": "Hadith"}], "96": [{"arabic": "ولنجزين الذين صبروا أجرهم بأحسن ما كانوا يعملون وقال تعالى أولئك يؤتون أجرهم مرتين بما صبروا وقال تعالى إنما يوفى الصابرون أجرهم بغير حساب فما من قربة إلا وأجرها بتقدير وحساب إلا الصبر ولأجل كون الصوم من الصبر وأنه نصف الصبر قال الله تعالى الصوم لي وأنا أجزي به فأضافه إلى نفسه من بين سائر العبادات ووعد الصابرين بأنه معهم فقال تعالى واصبروا إن الله مع الصابرين وعلق النصرة على الصبر فقال تعالى بلى إن تصبروا وتتقوا ويأتوكم من فورهم هذا يمددكم ربكم بخمسة آلاف من الملائكة مسومين وجمع للصابرين بين أمو", "english": "Allah — exalted be He — has described the patient (al-ṣābirīn) with attributes, and He mentioned patience (al-ṣabr) in the Qur’an in upwards of seventy places. He attached most of the degrees and goods to patience, making them its fruit. For He said — majestic is His utterance: {«وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا»} — “And We made from among them imams guiding by Our command, when they were patient” (Q 32:24). And He said — exalted be He: {«وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا»} — “And the good word of your Lord was fulfilled upon the Children of Israel, because they were patient” (Q 7:137). And He said — exalted be He: {«وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُم بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ»} — “And We shall surely recompense those who were patient their wage according to the best of what they used to do” (Q 16:96). And He said — exalted be He: {«أُولَٰئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا»} — “Those shall be given their wage twice, because they were patient” (Q 28:54). And He said — exalted be He: {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»} — “Only the patient shall be paid their wage without reckoning” (Q 39:10). Thus there is no act of nearness (qurbah) whose wage is not meted out by measure and account — except patience. And because fasting (al-ṣawm) is of patience, and it is half of patience, Allah — exalted be He — said: “Fasting is Mine, and I recompense it” — so He attributed it to Himself, to the exclusion of all other acts of worship. And He promised the patient that He is with them, saying — exalted be He: {«وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ»} — “And be patient; indeed Allah is with the patient” (Q 8:46). And He made victory contingent upon patience, saying — exalted be He: {«بَلَىٰ إِن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُسَوِّمِينَ»} — “Yes, if you are patient and God-fearing, and they come upon you in their rush, your Lord will reinforce you with five thousand marked angels” (Q 3:125). And He gathered for the patient things He gathered for no others, saying — exalted be He: {«أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ»} — “Those — upon them are blessings from their Lord, and mercy; and those — they are the rightly guided” (Q 2:157). So guidance, mercy, and blessings are all gathered for the patient. And to exhaust all the verses concerning the station of patience would be lengthy.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 954", "section_title_en": "The Virtue of Patience (Ṣabr) — Its Excellence in the Qur’an, Sunnah, and Reports of the Salaf", "section_index": 954, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning is “to restrain, to hold back, to bind firmly” — as in holding an animal by its halter or confining someone against departure.\n  * Al-Raghib (Mufradat): Patience is “the self’s restraint upon what reason and Sacred Law require, or from what they require it to abstain from.” It is a generic term whose specific names vary by context: in calamity it is ṣabr (opposed to jazaʿ); in battle it is courage (shajāʿah); in vexation it is forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): “I bore patiently what I disliked, and I refrained patiently from what I loved.” Metaphorical (majāz): “His right hand was made to swear patiently” (i.e., bound by an emphatic oath), and “this tree is patient against cold” (i.e., unaffected by it).\n- Root: عله (ʿ-L-H) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: ايم (A-Y-M) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: نفس (N-F-S)\n  * Al-Raghib (Mufradat): The self (nafs) as the locus of volitional restraint — patience is an act of the nafs holding itself back, distinguishing it from mere physical endurance.\n  * Al-Zamakhshari (Asas): Literal: “a precious thing” (nafīs). Metaphorical: “he poured out his soul” (i.e., his blood), and “everything that has no flowing soul does not defile water.”\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the exclusive clause {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»}, where innamā restricts the reward-without-account solely to the patient, and {«الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ»}, where the predicate is focused to Allah alone.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "تعالى ما عندكم ينفد وما عنده الله باق ولنجزين الذين صبروا أجرهم الآية (2) الآية وروى جابر أنه سئل صلى الله عليه وسلم عن الإيمان فقال الصبر والسماحة (3) حديث الصبر كنز من كنوز الجنة غريب لم أجده وسئل مرة ما الإيمان فقال الصبر (4) حديث الحج عرفه تقدم في الحج معناه معظم الحج عرفة وقال أيضا صلى صلى الله عليه وسلم أفضل الأعمال ما أكرهت عليه النفوس // حديث أفضل الأعمال ما أكرهت عليه النفوس لا أصل له مرفوعا وإنما هو من قول عمر بن عبد العزيز هكذا رواه ابن أبي الدنيا في كتاب محاسبة النفس وقيل أوحى الله تعالى إلى داود عليه ا", "english": "Allah — exalted be He — has described the patient (al-ṣābirīn) with attributes, and He mentioned patience (al-ṣabr) in the Qur’an in upwards of seventy places. He attached most of the degrees and goods to patience, making them its fruit. For He said — majestic is His utterance: {«وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا»} — “And We made from among them imams guiding by Our command, when they were patient” (Q 32:24). And He said — exalted be He: {«وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا»} — “And the good word of your Lord was fulfilled upon the Children of Israel, because they were patient” (Q 7:137). And He said — exalted be He: {«وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُم بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ»} — “And We shall surely recompense those who were patient their wage according to the best of what they used to do” (Q 16:96). And He said — exalted be He: {«أُولَٰئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا»} — “Those shall be given their wage twice, because they were patient” (Q 28:54). And He said — exalted be He: {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»} — “Only the patient shall be paid their wage without reckoning” (Q 39:10). Thus there is no act of nearness (qurbah) whose wage is not meted out by measure and account — except patience. And because fasting (al-ṣawm) is of patience, and it is half of patience, Allah — exalted be He — said: “Fasting is Mine, and I recompense it” — so He attributed it to Himself, to the exclusion of all other acts of worship. And He promised the patient that He is with them, saying — exalted be He: {«وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ»} — “And be patient; indeed Allah is with the patient” (Q 8:46). And He made victory contingent upon patience, saying — exalted be He: {«بَلَىٰ إِن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُسَوِّمِينَ»} — “Yes, if you are patient and God-fearing, and they come upon you in their rush, your Lord will reinforce you with five thousand marked angels” (Q 3:125). And He gathered for the patient things He gathered for no others, saying — exalted be He: {«أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ»} — “Those — upon them are blessings from their Lord, and mercy; and those — they are the rightly guided” (Q 2:157). So guidance, mercy, and blessings are all gathered for the patient. And to exhaust all the verses concerning the station of patience would be lengthy.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 954", "section_title_en": "The Virtue of Patience (Ṣabr) — Its Excellence in the Qur’an, Sunnah, and Reports of the Salaf", "section_index": 954, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning is “to restrain, to hold back, to bind firmly” — as in holding an animal by its halter or confining someone against departure.\n  * Al-Raghib (Mufradat): Patience is “the self’s restraint upon what reason and Sacred Law require, or from what they require it to abstain from.” It is a generic term whose specific names vary by context: in calamity it is ṣabr (opposed to jazaʿ); in battle it is courage (shajāʿah); in vexation it is forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): “I bore patiently what I disliked, and I refrained patiently from what I loved.” Metaphorical (majāz): “His right hand was made to swear patiently” (i.e., bound by an emphatic oath), and “this tree is patient against cold” (i.e., unaffected by it).\n- Root: عله (ʿ-L-H) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: ايم (A-Y-M) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: نفس (N-F-S)\n  * Al-Raghib (Mufradat): The self (nafs) as the locus of volitional restraint — patience is an act of the nafs holding itself back, distinguishing it from mere physical endurance.\n  * Al-Zamakhshari (Asas): Literal: “a precious thing” (nafīs). Metaphorical: “he poured out his soul” (i.e., his blood), and “everything that has no flowing soul does not defile water.”\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the exclusive clause {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»}, where innamā restricts the reward-without-account solely to the patient, and {«الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ»}, where the predicate is focused to Allah alone.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}, {"arabic": "رفعه وحفظه ثم نظرت إلى قول الله عز وجل ما عندكم ينفذ وما عند الله باق فكلما وقع معي شيء له قيمة ومقدار وجهته إلى الله ليبقى عنده محفوظا الرابعة أني نظرت إلى هذا الخلق فرأيت كل واحد منهم يرجع إلى المال وإلى الحسب والشرف والنسب فنظرت فيها فإذا هي لا شيء ثم نظرت إلى قول الله تعالى إن أكرمكم عند الله أتقاكم فعملت في التقوى حتى أكون عند الله كريما الخامسة أني نظرت إلى هذا الخلق وهم يطعن بعضهم في بعض ويلعن بعضهم بعضا وأصل هذا كله الحسد ثم نظرت إلى قول الله عز وجل نحن قسمنا بينهم معيشتهم في الحياة الدنيا فتركت الحسد وا", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "98": [{"arabic": "تعالى {فاستعذ بالله من الشيطان الرجيم} وسائر الأخبار والآيات الواردة في الذكر قال أبو هريرة التقى شيطان المؤمن وشيطان الكافر فإذا شيطان الكافر دهين سمين كاس وشيطان المؤمن مهزول أشعث أغبر عار فقال شيطان الكافر لشيطان المؤمن مالك مهزول قال أنا مع رجل إذا أكل سمى الله فأظل جائعا وإذا شرب سمى الله فأظل عطشانا وإذا لبس سمى الله فأظل عريانا وإذا ادهن سمى الله فأظل شعثا فقال لكني مع رجل لا يفعل شيئا من ذلك فأنا أشاركه في طعامه وشرابه ولباسه وكان محمد بن واسع يقول كل يوم بعد صلاة الصبح اللهم إ", "english": "If you say: \"What then is the remedy for repelling Satan, and is the remembrance of God—exalted is He—and one's saying 'There is no might and no power except through God' (lā ḥawla wa lā quwwata illā billāh) sufficient for that?\" — Know that the remedy of the heart in this matter is to seal these entry points by purifying the heart of these blameworthy traits. And that is something whose full exposition would be lengthy; our purpose in this quarter of the book is to explain the remedy for the destructive traits (al-ṣifāt al-muhlikāt), and each trait requires a separate book, as will be explained later. Yes — when the roots of these traits are severed from the heart, Satan may still make incursions (ijtiyāzāt) and pass through it with fleeting thoughts (khaṭarāt), but he has no stability therein. And what prevents him from passing through is the remembrance of God—exalted is He—because the reality of dhikr cannot take firm hold of the heart except after the heart is built up with God-consciousness (taqwā) and purified of blameworthy traits. Otherwise, the dhikr is but the whisper of the self (ḥadīth nafs), having no authority over the heart, and so it does not repel the dominion of Satan. For this reason, God—exalted is He—said: {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا فَإِذَا هُمْ مُبْصِرُونَ} \"Indeed, those who fear God — when an impulse touches them from Satan, they remember [Him], and at once they are insightful\" (Q 7:201). He specified thereby the God-fearing (muttaqī).", "book_title": "Disciplining the Soul", "section_title_ar": "Section 603", "section_title_en": "The Revival of the Religious Sciences — Section 603: On the Remedy for Evil Presumption and the Repelling of Satan", "section_index": 603, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or being consumed by fire; also used for one who is destroyed or whose blood is shed in vain.\n  * Al-Raghib (Mufradat): الشيطان (Satan) — the one who is far removed from divine mercy, derived from the root indicating his being burned or destroyed.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"شاط اللحم\" — meat that is burnt or spoiled by fire. Metaphorical (Majaz): \"شاط دمه\" — his blood was shed in vain (i.e., destroyed); \"أشاط السلطان دمه\" — the ruler declared his blood lawful to shed. Thus, Satan is so named for his being \"burned\" or \"destroyed\" by divine curse, and for his causing others to be destroyed.\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; also the act of turning, overturning, or revolving a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning and directing of a thing from one aspect to another. The heart (qalb) is so named for its constant fluctuation and turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises stratagems. The heart's \"suwaydāʾ\" (core/blackness) is its innermost center where Satan seeks to establish his seat.\n- Root: ذكر (Dhikr)\n  * Lisan / Ayn: Remembrance, mention, recollection; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): الذكر is the presence of a thing in the mind, whether by utterance or by heart; true dhikr is that which takes root in the heart, not mere speech of the tongue.\n  * Al-Zamakhshari (Asas): Literal: uttering with the tongue. Metaphorical: the heart's presence with God, which alone has authority over the soul and repels Satan's incursions.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The verse {إِنَّ الَّذِينَ اتَّقَوْا إِذَا مَسَّهُمْ طَائِفٌ مِنَ الشَّيْطَانِ تَذَكَّرُوا} restricts the efficacy of dhikr in repelling Satan to the God-fearing (muttaqūn), whose hearts are emptied of passions, thereby specifying the condition for its effectiveness.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "وإن كان خلف الإمام اختصر إن لم يكن للإمام سكتة طويلة يقرأ فيها ثم يقول أعوذ بالله من الشيطان الرجيم ثم يقرأ الفاتحة يبتدىء فيها ب بسم الله الرحمن الرحيم بتمام تشديداتها وحروفها ويجتهد في الفرق بين الضاد والظاء ويقول آمين في آخر الفاتحة ويمدها مدا ولا يصل آمين بقوله ولا الضالين وصلا ويجهر بالقراءة في الصبح والمغرب والعشاء إلا أن يكون مأموما ويجهر بالتأمين ثم يقرأ السورة أو قدر ثلاث آيات من القرآن فما فوقها ولا يصل آخر السورة بتكبير الهوى بأن يفصل بينهما بقدر قوله سبحان الله ويقرأ في الصبح من السور الطوال من المفضل وفي المغرب من قصاره", "english": "I say: Then the worshipper begins with the opening supplication (duʿāʾ al-istiftāḥ). It is excellent that he say, following his utterance of \"Allāhu akbar, Allāhu akbar\": \"Kabīran wa-l-ḥamdu lillāhi kathīran wa-subḥāna Allāhi bukratan wa-aṣīlā\" (Great indeed is Allah, and abundant praise be to Allah, and glory be to Allah morning and evening) {«الله أكبر كبيرا والحمد لله كثيرا وسبحان الله بكرة وأصيلا»} — then: \"Wajjahtu wajhiya...\" (I have turned my face...) up to his saying \"...wa-anā min al-muslimīn\" (and I am among those who submit) {«وجهت وجهي إلى قوله وأنا من المسلمين»}. Then he says: \"Subḥānaka Allāhumma wa-bi-ḥamdika wa-tabāraka-smuka wa-taʿālā jadduka wa-jalla thanāʾuka wa-lā ilāha ghayruk\" (Glory be to You, O Allah, and with Your praise; blessed is Your Name and exalted is Your majesty; glorious is Your praise and there is no god but You) {«سبحانك اللهم وبحمدك وتبارك اسمك وتعالى جدك وجل ثناؤك ولا إله غيرك»} — so that he may combine within himself the various dispersed reports transmitted in the traditions.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 127", "section_title_en": "Section 127 — On the Recitation (Qirāʾah) and the Bowing (Rukūʿ) with Its Attendant Matters", "section_index": 127, "anchors": "- Root: قرأ (Qaraʾa)\n  * Lisan / Ayn: Core meaning of gathering and assembling letters into articulated speech; recitation as the oral articulation of written or memorized text.\n  * Al-Raghib (Mufradat): In the Quranic and liturgical context, qirāʾah is the deliberate, worshipful utterance of the divine word, distinct from mere reading; it is an act of devotion requiring presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the physical articulation of sounds; metaphorical (majāz) usage extends to the inward recitation of the heart in contemplation.\n- Root: ركع (Rakaʿa)\n  * Lisan / Ayn: The physical act of bowing; the bending of the back in humility.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء، فتارة يستعمل في الهيئة المخصوصة في الصلاة كما هي، وتارة في التواضع والتذلل\" — The bowing is an inclination, used sometimes for the specific posture in prayer, and sometimes for humility and self-abasement.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"شيخ راكع: منحن من الكبر\" — an old man bowed with age. Metaphorical (majāz): \"لغبت الإبل حتى ركعت\" — camels fatigued until they lowered their heads, indicating the physical posture as the outward sign of inward submission.\n- Root: صبح (Ṣabaḥa)\n  * Al-Raghib (Al-Mufradat): \"الصبح والصباح، أول النهار\" — the dawn is the beginning of the day, the time when the horizon reddens.\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"أصبح يا رجل: انتبه من غفلتك\" — \"become awake, O man: awaken from your heedlessness,\" showing the dawn prayer as the time of spiritual awakening.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between governing and governed elements, applied here to the proper pausing (waqf) and connecting (waṣl) of Quranic phrases to preserve meaning.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Envy'", "badge": "Du'a"}], "102": [{"arabic": "إلى جبريل فقال تعالى {قل نزله روح القدس من ربك بالحق} وقال تعالى {يلقي الروح من أمره على من يشاء من عباده} وأحال الإغواء على إبليس فقال تعالى {ليضل عن سبيله} والإغواء هو استيقاف العباد دون بلوغ غاية الحكمة فانظر كيف نسبه إلى العبد الذي غضب عليه والإرشاد سياقه لهم إلى الغاية فانظر كيف نسبه إلى العبد الذي أحبه وعندك في العادة له مثال فالملك إذا كان محتاجا إلى من يسقيه الشراب وإلى من يحجمه وينظف فناء منزله عن القاذورات وكان له عبدان فلا يعين للحجامة والتنظيف إلا أقبحهما وأخسهما ولا يفوض حمل الشراب و", "english": "Thus was the beginning of this matter and its end. And do not understand it unless you are worthy of it. And if you are worthy of it, the eye is opened and you see, so you have no need of a leader to lead you. The blind man can indeed be led, but only to a limit. For when the path narrows and becomes sharper than a sword and finer than a hair, the bird is able to fly over it but is not able to drag a blind man behind it. And when the field becomes narrow and subtle — subtle as water, for example — and crossing is possible only by swimming, then the one skilled in the art of swimming may be able to cross by himself, and perhaps he is not able to drag another behind him. These matters bear the same relation to walking upon the way of the common masses of creatures as walking upon water bears to walking upon earth. Swimming can be learned; but as for walking upon water, it is not acquired by instruction, but rather is attained through the strength of certainty (yaqīn). For this reason it was said to the Prophet, peace be upon him, that Jesus, peace be upon him, was said to have walked upon water, and he, peace be upon him, said: \"Had his certainty increased, he would have walked upon the air.\" {«حديث قيل له يقال إن عيسى مشى على الماء قال لو ازداد يقينا لمشي على الهواء»} — This hadith is rejected (munkar) and is not known in this form. What is known is what Ibn Abi al-Dunya narrated in the Book of Certainty from the saying of Bakr ibn Abd Allah al-Muzani, who said: The disciples lost their Prophet, and it was said to them: \"He has headed toward the sea.\" So they set out seeking him, and when they reached the sea, behold, he was coming toward them walking upon the water. And he mentioned a hadith in which Jesus said: \"If the son of Adam had a hair's breadth of certainty, he would walk upon the water.\" And Abu Mansur al-Daylami narrated in the Musnad al-Firdaws with a weak chain from the hadith of Muadh ibn Jabal: \"If you knew God with true knowledge, you would walk upon the seas, and the mountains would be removed by your supplications.\" These are symbols and allusions to the meaning of aversion (karāhah) and love (maḥabbah), and good pleasure (riḍā) and wrath (ghaḍab), and gratitude (shukr) and ingratitude (kufrān) — more than this is not fitting for the science of practical conduct (ʿilm al-muʿāmalah). And God, exalted be He, struck an example of this to draw it near to the understanding of creatures, since He knew that He created the jinn and mankind only to worship Him, and their worship was the ultimate purpose of wisdom (ghāyat al-ḥikmah) with respect to them. Then He informed that He has two servants: one whom He loves, whose name is Gabriel — the Holy Spirit and the Trustworthy One — and he is with Him beloved, obeyed, trustworthy, and honored; and another whom He hates, whose name is Iblis — the accursed one, reprieved until the Day of Judgment. Then He delegated guidance (irshād) to Gabriel, saying, the Exalted: {«قل نزله روح القدس من ربك بالحق»} \"Say: The Holy Spirit has brought it down from your Lord with truth\" (16:102), and said, the Exalted: {«يلقي الروح من أمره على من يشاء من عباده»} \"He casts the Spirit of His command upon whom He wills of His servants\" (40:15). And He delegated misguidance (ighwāʾ) to Iblis, saying, the Exalted: {«ليضل عن سبيله»} \"That he may lead astray from His path\" (4:119). And ighwāʾ is the halting of servants short of attaining the ultimate purpose of wisdom. So observe how He attributed it to the servant with whom He was wrathful; and guidance (irshād) is the conduct of them toward the ultimate purpose — so observe how He attributed it to the servant whom He loves. And you have an example of this in custom: when a king is in need of one to give him drink and one to cup him and to clean the courtyard of his house of filth, and he has two servants, he does not appoint for cupping and cleaning except the ugliest and meanest of them, and he does not entrust the carrying of drink and perfume except to the best and most complete of them and the most beloved to him. And you should not say: \"This is my act, and his act was not without my act\" — for you have erred when you attributed that to yourself. Rather, He is the One who directed your motive (dāʿiyah) to the specification of the disliked act to the disliked person, and the beloved act to the beloved person, as a completion of justice (ʿadl). For His justice is sometimes completed through matters in which you have no entry, and sometimes it is completed in you — for you also are among His acts. So your motive, your power, your knowledge, your action, and all the other causes of your movements in expression — all of this is His act, which He arranged with justice in an arrangement from which moderate acts issue forth. Except that you see only yourself, and so you suppose that what appears through you in the world of witness (ʿālam al-shahādah) has no cause from the world of the unseen and the dominion (ʿālam al-ghayb wa al-malakūt). Therefore you attribute it to yourself. And you are only like the child who looks at night at the play of the juggler (mushʿabadh) who brings forth figures from behind a curtain that dance and scream and rise and sit, composed of rags that do not move by themselves — rather, they are moved by fine hair-like threads that do not appear in the darkness of night, their ends in the hand of the juggler, who is hidden from the eyes of the children. So they rejoice and marvel, supposing that those rags dance and play and rise and sit. As for the intelligent ones, they know that this is a moving (taḥrīk) and not a self-movement, but perhaps they do not know its detailed modality. And the one who knows some of its detail does not know it as the juggler knows it, to whom the command belongs and in whose hand is the pulling. Likewise, the children of the people of this world — and all creatures are children relative to the scholars — look at these persons (ashkhāṣ) and suppose that they are the movers, and so they attribute [action] to them. And the scholars know that they are moved, except that they do not know the modality of the moving — and they are the majority. Except the knowers (ʿārifūn), the scholars, and those firmly rooted in knowledge (al-rāsikhūn), for they have perceived, with the sharpness of their sight, fine spider-web threads — nay, much finer than these — suspended from heaven, their ends attached to the persons of the people of the earth. Those threads are not perceived, due to their fineness, by these outward eyes. Then they witnessed the heads of those threads in their suspension-points (manāṭāt) to which they are attached, and they witnessed for those suspension-points handles (maqābiḍ) that are in the hands of the angels who move the heavens. And they also witnessed the angels of the heavens directed toward the bearers of the Throne (ḥamalat al-ʿarsh), awaiting what descends upon them of the command from the presence of Lordship (ḥaḍrat al-rubūbiyyah) — \"they do not disobey God in what He commands them, and they do what they are commanded\" (66:6). And He expressed these witnessed realities in the Qur'an, and it was said: {«وفي السماء رزقكم وما توعدون»} \"And in the heaven is your provision and what you are promised\" (51:22). And He expressed the waiting of the angels of the heavens for what descends upon them of decree and command, and it was said: \"He created seven heavens and of the earth the like of them; {«يتنزل الأمر بينهن لتعلموا أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما»} 'the command descends between them, that you may know that God is powerful over all things and that God encompasses all things in knowledge'\" (65:12). These are matters whose interpretation (taʾwīl) none knows except God and those firmly rooted in knowledge (al-rāsikhūn fī al-ʿilm). And Ibn Abbas, may God be pleased with them both, expressed the exclusivity of those firmly rooted in knowledge to sciences that the understandings of creatures cannot bear, when he recited the saying of the Exalted: {«يتنزل الأمر بينهن»} \"The command descends between them,\" and said: \"Were I to mention what I know of the meaning of this verse, you would stone me\" — and in another wording: \"You would say he is an unbeliever.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 990", "section_title_en": "On the Degrees of Proximity to God and the Hierarchy of Those Who Perfect Divine Wisdom", "section_index": 990, "anchors": "- Root: سير (s-y-r)\n  * Lisan / Ayn: \"السير: الذهاب والسفر، وسار يسير سيرا ومسيرا، والسيارة: الرفقة المسافرة\"\n  * Al-Raghib (Mufradat): \"السير: الانتقال من مكان إلى مكان، ويستعار للسلوك في الدين والطريقة\"\n  * Al-Zamakhshari (Asas): [Literal] \"سار القوم: مشوا\" — [Metaphorical] \"سار فيه السير: مضى في الأمر، وسار ذكره: انتشر، ومنه: سيرة فلان: طريقته\"\n- Root: مشي (m-sh-y)\n  * Lisan / Ayn: \"المشي: تردد الأركان على الأرض، والماشية: الإبل والغنم لانتقالها في المرعى\"\n  * Al-Raghib (Mufradat): \"المشي: الانتقال من مكان إلى مكان بإرادة، ويكنى به عن النميمة، وعن شرب المسهل\"\n  * Al-Zamakhshari (Asas): [Literal] \"مشيت وتمشيت، وهي حسنة المشية\" — [Metaphorical] \"مشى بطنه، وأمشاه الدواء، واستمشيت بالدواء، ومنه: مشت المرأة: كثرت أولادها\"\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: \"الخلق: التقدير، والخلق: الناس، والخليقة: الطبيعة، والخلق: السجية\"\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\"\n  * Al-Zamakhshari (Asas): [Literal] \"خلق الخراز الأديم: قدره قبل القطع\" — [Metaphorical] \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\"\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: \"النفس: الروح، والذات، والشيء النفيس\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتطلق على الذات، قال تعالى: {ويحذركم الله نفسه} فنفسه: ذاته\"\n  * Al-Zamakhshari (Asas): [Literal] \"شيء نفيس ومنفس\" — [Metaphorical] \"دفق نفسه أي دمه، وأصابته نفس: عين\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish exclusive attribution of actions to God versus creatures, as in \"إنما أنت مثل الصبي\" (You are only like a child), restricting the simile to the creature while preserving divine agency.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "105": [{"arabic": "تعالى {إنما يفتري الكذب الذين لا يؤمنون بآيات الله} (2) وقال أبو سعيد الخدري سمعت رسول الله صلى الله عليه وسلم يدعو فيقول في دعائه اللهم طهر قلبي من النفاق وفرجي من الزنا ولساني من الكذب (3) وقال صلى الله عليه وسلم ثلاثة لا يكلمهم الله ولا ينظر إليهم ولا يزكيهم ولهم عذاب أليم شيخ زان وملك كذاب وعائل مستكبر (4) حديث عبد الله بن عامر جاء رسول الله صلى الله عليه وسلم إلى بيتنا وأنا صبي صغير فذهبت لألعب فقالت أمي يا عبد الله تعال أعطيك فقال وما أردت أن تعطيه قالت تمرا فقال إن لم تفعلي كتبت عليك كذ", "english": "Among them is the hadith: \"And three whom God hates: the trader or seller who swears much.\" Ahmad narrated it, and the wording is his. In its chain is Ibn al-Aḥmaṣ, whose condition is unknown. Both Ahmad and al-Nasā'ī narrated it with another wording through a sound chain. And al-Nasā'ī has, from the hadith of Abū Hurayrah: \"Four whom God abhors: the seller who swears much\" — the hadith — and its chain is sound.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 676", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 676: On Lying (al-Kadhib) — Hadith Reports and Traditions (Āthār)", "section_index": 676, "anchors": "- Root: كذب (Kadhaba)\n  * Lisan / Ayn: Core meaning: to report a falsehood, to utter what is contrary to reality; al-Kadhdhābah: a variegated cloth that deceives the eye into thinking it is part of the ceiling — indicating the deceptive semblance of truth.\n  * Al-Raghib (Mufradat): Kadhib applies to both speech and action. God says: {«Only they forge falsehood who do not believe in God's signs»} (Q 16:105) — the hypocrites' speech was true, but their inward conviction was false, so God called them liars (kādhibūn) regarding their belief.\n  * Al-Zamakhshari (Asas): Literal (Haqīqah): \"He is kadhib, kadhūb, kadhāb, kaydhabān\" — one who lies habitually. Metaphorical (Majāz): \"He carried [the burden] then lied\" — i.e., he cowardly retreated, making his charge a false one; \"the she-camel lied\" — her pregnancy proved false.\n- Root: حدث (Ḥadatha)\n  * Lisan / Ayn: Core meaning: to originate, to bring into being after non-existence; al-ḥadīth: speech that is new/recently originated.\n  * Al-Raghib (Mufradat): \"Al-Ḥudūth: a thing's coming to be after it was not — whether accident or substance. Its creation (iḥdāth) belongs solely to God. Al-muḥdath: what is brought into existence after non-existence.\" God says: {«There comes not to them a fresh reminder (dhikr muḥdath) from their Lord»} (Q 21:2).\n  * Al-Zamakhshari (Asas): Literal: \"He spoke a ḥadīth; fresh in age.\" Metaphorical: \"They became aḥādīth (topics of talk)\"; ʿUmar was called muḥaddath — one whose intuition is divinely inspired, as if truth were spoken into him.\n- Root: ويل (Wayl)\n  * Lisan / Ayn: An expression of intense woe, destruction, and chastisement; a word of threat and condemnation.\n  * Al-Raghib (Mufradat): Wayl denotes severe affliction and ruin; it is a declaration of impending punishment.\n  * Al-Zamakhshari (Asas): Literal: \"Woe to him\" — a cry of ruin. Used in threats: \"Waylun lahu\" — destruction is his due.\n- Root: شنأ (Shana'a)\n  * Lisan / Ayn: Intense hatred and abhorrence.\n  * Al-Raghib (Mufradat): Al-Shan'ān: intense hatred that drives one to shun the object.\n  * Al-Zamakhshari (Asas): Literal: \"He hated him with shan'an\" — vehement hatred.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating it for all else. Applied in the verse: {«Only they forge falsehood who do not believe»} — restricting fabrication to the disbelievers, affirming that the believer does not lie.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Anger and Hatred'", "badge": "Ethics"}], "107": [{"arabic": "وفضلا عما أعده الله تعالى للذين استحبوا الحياة الدنيا على الآخرة ورضوا بها واطمأنوا إليها من", "english": "The hadith was transmitted by Muslim, on the authority of Abu Hurayrah: \"Verily, a man may work for a long stretch of time with the deeds of the people of Paradise, then his final deed is sealed with a deed of the people of the Fire.\" Al-Bazzar and al-Tabarani in al-Awsat [added]: \"for seventy years,\" and its chain is sound. And from the Two Shaykhs [al-Bukhari and Muslim], within a hadith of Ibn Mas'ud: \"Verily, one of you may work with the deeds of the people of Paradise until there remains between him and it [Paradise] only a cubit...\" — this hadith contains no specification of a time period for the work of fifty years, nor any mention of a span [shibr], nor {nor} the interval of a she-camel's milking [fawaq nāqah]. And in another narration: \"except the measure of the milking-interval of a she-camel,\" then the decree overtakes him, and he is sealed with a deed of the people of the Fire. Now, the measure of a she-camel's milking-interval cannot accommodate any deed performed by the bodily limbs; rather, it is [sufficient] only for the measure of a passing thought [khāṭir] that surges within the heart at the moment of death, thereby necessitating an evil final outcome. So how can one feel secure from that? Therefore, the utmost limit of the believer's aspiration is that his fear and his hope be balanced. Yet the predominance of hope in most people is grounded in self-delusion and deficiency of knowledge. For this reason, God Most High conjoined both [fear and hope] in describing those whom He praised, saying: {«يدعون ربهم خوفا وطمعا»} — \"They call upon their Lord in fear and in hope\" — and He, Mighty and Majestic, said: {«ويدعوننا رغبا ورهبا»} — \"And they call upon Us in desire and in awe.\" And where is the like of Umar, may God be pleased with him? So the creatures existing in this age — all of them — the most salutary for them is the predominance of fear, on the condition that it does not cast them into despair, nor abandon them from work, nor cut off hope of forgiveness; for that would become a cause of indolence in action and a summons to plunging into disobedience. For that is despondency [qunūṭ], not fear. Rather, fear is that which spurs one to action, which clouds all appetites, which agitates the heart away from repose in this world, and which calls it to hold aloof from the Abode of Delusion. That is the praiseworthy fear — not the whisperings of the self that produce no effect in restraint or incitement, and not the despair that necessitates despondency.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1046", "section_title_en": "The Balance of Fear and Hope at Death — Section 1046", "section_index": 1046, "anchors": "- Root: خوف (khawf)\n  * Lisan / Ayn: Core sense of dread and apprehension; the heart's agitation before an anticipated harm.\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — expectation of evil from a conjectured or known sign; antithesis of amn (security); applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Haqiqah: \"خفته على مالي خوفا وخيفة\" — literal fear for what one possesses. Majaz: \"تخوفه: تنقصه\" — metaphorical sense of gradual diminution, as in Zuhayr's verse, implying fear that erodes resolve.\n- Root: موت (mawt)\n  * Lisan / Ayn: Death as the cessation of vital power; \"مات ميتة سوء\" — dying an evil death.\n  * Al-Raghib (Mufradat): Death contrasted with life (ḥayāh); in Quranic usage, linked to the finality of deeds and the sealing of one's fate.\n  * Al-Zamakhshari (Asas): Haqiqah: \"مات موتة لم يمتها أحد\" — literal death. Majaz: \"أحيا الله البلد الميت\" — metaphorical revival of barren land, paralleling spiritual death and life.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart as the seat of fluctuating states; \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning and overturning.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart's constant oscillation between states, here between fear and hope.\n  * Al-Zamakhshari (Asas): Haqiqah: \"قلب الشيء قلبا: حوله عن وجهه\" — literal overturning. Majaz: \"رجل قلب حول: يقلب الأمور ويحتال\" — metaphorical agility in discerning and managing affairs.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the true nature of khawf (fear) as that which impels action, excluding mere whisperings of the self and despair.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "109": [{"arabic": "للدنيا فهم في العاجل عار وشين وفي الآخرة هم الخاسرون أو يعفو الكريم بفضله وبعد فإني رأيت الهالك المؤثر للدنيا سروره ممزوج بالتنغيص فيتفجر عنه أنواع الهموم وفنون المعاصي وإلى البوار والتلف مصيره فرح الهالك برجائه فلم تبق له دنياه ولم يسلم له دينه {خسر الدنيا والآخرة ذلك هو الخسران المبين} فيا لها من مصيبة ما أفظعها ورزية ما أجلها ألا فراقبوا الله إخواني ولا يغرنكم الشيطان وأولياؤه من الآنسين بالحجج الداحضة عند الله فإنهم يتكالبون على الدنيا ثم يطلبون لأنفسهم المعاذير والحجج ويزعمون أن أصحاب رسول الل", "english": "Then al-Ḥārith, may God have mercy on him, said: \"My brothers! These are the scholars of evil — the devils of mankind and a trial upon the people. They coveted the goods of this world and its elevation, preferred it over the Hereafter, and interpreted religion for the sake of this world. So in the immediate term they are disgrace and shame, and in the Hereafter they are the losers — unless the Generous One pardons through His bounty.\"", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 783", "section_title_en": "The Condemnation of the Worldly Scholars — The Admonition of al-Ḥārith al-Muḥāsibī", "section_index": 783, "anchors": "- Root: خرج (kharaja)\n  * Lisan / Ayn: To extract, draw forth, or expel something from its place of containment.\n  * Al-Raghib (Mufradat): Used for the emergence of something from its potential state into actuality, or from the inward to the outward.\n  * Al-Zamakhshari (Asas): Here used metaphorically (Majaz) for \"uttering\" — extracting wisdom from the mouth while the heart remains sealed against it.\n- Root: غل (ghalla)\n  * Lisan / Ayn: Concealed rancor, malice, or treachery harbored within the breast.\n  * Al-Raghib (Mufradat): A hidden corruption of the heart's disposition toward another, often linked to betrayal of trust.\n  * Al-Zamakhshari (Asas): Literal sense is \"thirst\" or \"hidden enmity\"; here it denotes the inward state of hypocrisy where outward speech contradicts inward conviction.\n- Root: خسر (khasira)\n  * Lisan / Ayn: To lose, to suffer diminution of capital or principal.\n  * Al-Raghib (Mufradat): \"الخسر والخسران: انتقاص رأس المال\" — loss of one's true capital (faith and the Hereafter), which is the \"manifest loss\" (الخسران المبين).\n  * Al-Zamakhshari (Asas): Literal for commercial loss; metaphorical (Majaz) for the one who disobeys God — \"ومن لم يطع الله فهو خاسر\" (Whoever does not obey God is a loser).\n- Root: دحض (dahaḍa)\n  * Lisan / Ayn: To slip, slide, or become void; a false argument that has no firm footing.\n  * Al-Raghib (Mufradat): An argument that is invalidated and rendered null, having no grounding in truth.\n  * Al-Zamakhshari (Asas): Literal for a foot slipping on slippery ground; metaphorical for specious reasoning that collapses under scrutiny.\n- Root: دها (dahā)\n  * Lisan / Ayn: To befall with calamity, to deceive cunningly, to afflict with a great matter.\n  * Al-Raghib (Mufradat): A profound and overwhelming affliction or cunning deception that strikes unaware.\n  * Al-Zamakhshari (Asas): Literal for a sudden calamity; here metaphorical for Satan's subtle deception that overcomes the heedless.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governing verb, allowing for rhetorical emphasis and dramatic effect in periodic sentences, as seen in the extended condemnations and rhetorical questions of this admonition.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Ethics"}], "111": [{"arabic": "الهوى وستجد كل نفس ما عملت من سوء أو خير محضرا عند الله ولو في فلتة خاطر أو فلتة ناظر من غير ظلم وجور فما الله بظلام للعبيد وأما القسم الثاني وهو فوات الحاصل فهو مكروه ومعتبر في جواز السكوت في الأمور الأربعة إلا العلم فإن فواته غير مخوف إلا بتقصير منه وإلا فلا يقدر أحد على سلب العلم من غيره وإن قدر على سلب الصحة والسلامة والثروة والمال وهذا أحد أسباب شرف العلم فإنه يدوم في الدنيا ويدوم ثوابه في الآخرة فلا انقطاع له أبد الآباد وأما الصحة والسلامة ففواتهما بالضرب فكل من عل", "english": "All of this does not nullify the obligation of ḥisbah, because these are but increases (ziyādāt) whose attainment is prevented — and calling the mere prevention of attaining increases \"harm\" (ḍarar) is metaphorical (majāz). True harm (al-ḍarar al-ḥaqīqī) is only the loss of something already in hand (fawāt ḥāṣil). Nothing is excepted from this rule save that which necessity (ḥājah) calls for, and whose loss entails a danger (maḥdhūr) exceeding the danger of remaining silent over the wrong (al-sukūt ʿalā al-munkar) — as when one is in need of a physician for an acute illness, and the cure is anticipated from the physician's treatment, and he knows that in the physician's delay there is severe aggravation of his malady and prolongation of his sickness, which may even lead to death.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 532", "section_title_en": "On the Conditions Permitting Abandonment of Enjoining Right — Section 532", "section_index": 532, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and calculating; al-ḥisbah derives from the notion of taking account of another's deeds.\n  * Al-Raghib (Mufradat): \"الحساب: استعمال العدد\" — reckoning is the employment of number; the theological nuance connects to divine accounting and the duty of moral reckoning upon others.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسب المال\" — to count property. Metaphorical (majāz): \"يَتَحَسَّبانِ الأخبار\" — to seek out and investigate news, as one probes and tests; thus ḥisbah is the active seeking-out of wrongs to rectify them.\n- Root: ضرر (ḍ-r-r)\n  * Lisan / Ayn: Core meaning of harm, injury, and detriment; al-ḍarar is that which opposes benefit (nafʿ).\n  * Al-Raghib (Mufradat): Harm is of two kinds — that which is truly detrimental to one's religion or worldly welfare, and that which is merely imagined or anticipated.\n  * Al-Zamakhshari (Asas): Literal: actual physical or material injury. Metaphorical: the mere loss of an anticipated increase (ziyādah), which is not true harm but is called so figuratively.\n- Root: سكت (s-k-t)\n  * Lisan / Ayn: Core meaning of silence, refraining from speech.\n  * Al-Raghib (Mufradat): \"السكوت مختص بترك الكلام\" — silence is specific to abstaining from speech; it is a form of rest (sukūn) and is used metaphorically for the subsiding of anger or other states.\n  * Al-Zamakhshari (Asas): Literal: \"رجل سكوت\" — a man habitually silent. Metaphorical: \"سكت عنه الغضب\" — anger subsided; thus al-sukūt ʿan al-munkar is the deliberate cessation of verbal objection.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core meaning of knowledge, perception, and discernment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; it is that which cannot be forcibly stripped from its possessor.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك\" — I had no awareness of your news. Metaphorical: knowledge as an enduring mark (ʿalam) and signpost of guidance.\n- Sibawayh Rule: Restriction and exception (al-ḥaṣr wa al-istithnāʾ) — the conditional framing of permissibility (al-tarkhīṣ) through specified exceptions (istithnāʾ) governed by the weighing of two harms (taʿāruḍ al-mafsadatayn), where the lesser is borne to avert the greater.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Enjoining Good and Forbidding Evil'", "badge": "Ethics"}, {"arabic": "الرجل يا أمير المؤمنين قال الله عز وجل يوم تأتي كل نفس تجادل عن نفسها أفنجادل الله تعالى ولا نتكلم بين يديك كلاما قال هشام بلى ويحك تكلم وروي أن سارقا دخل خباء عمار بن ياسر بصفين فقيل له اقطعه فإنه من أعدائنا فقال بل أستر عليه لعل الله يستر علي يوم القيامة وجلس ابن مسعود في السوق يبتاع طعاما فابتاع ثم طلب الدراهم وكانت في عمامته فوجدتها قد حلت فقال لقد جلست وإنها لمعي فجعلوا يدعون على من أخذها ويقولون اللهم اقطع يد السارق الذي أخذها اللهم افعل به كذا فقال عبد الله اللهم إن كان حمله على أخذها حاجة فبارك له فيها وإن كان", "english": "A man was brought to Hishām concerning whom word had reached him. When he was made to stand before him, he began to speak in his own defense. Hishām said to him: You speak as well? The man said: O Commander of the Faithful, Allah, Mighty and Majestic, said: {«يَوْمَ تَأْتِي كُلُّ نَفْسٍ تُجَادِلُ عَنْ نَفْسِهَا»} — \"The Day when every soul will come disputing on its own behalf.\" Shall we dispute before Allah the Exalted, and not speak a word before you? Hishām said: Yes, woe to you — speak.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 715", "section_title_en": "** Section 715 — On the Virtue of Forbearance (al-Ḥilm) and Gentleness (al-Rifq)", "section_index": 715, "anchors": "**\n\n- **Root: عفو (ʿ-F-W)**\n  - *Lisan / Ayn:* Al-ʿAfw is the effacing and obliteration of the trace of a thing; to pardon is to efface the trace of the offense entirely.\n  - *Al-Raghib (Mufradat):* Al-ʿAfw is the erasure of the sin such that no consequence remains — it is the highest form of forgiveness, surpassing al-ghufrān which veils but does not necessarily efface.\n  - *Al-Zamakhshari (Asas):* Literal: \"عفا الأثر\" — the trace was effaced. Metaphorical: pardon as the effacing of the offense's consequence, as in \"عفا عن ذنبه.\"\n\n- **Root: حلم (Ḥ-L-M)**\n  - *Lisan / Ayn:* Al-Ḥilm is forbearance, clemency, and the restraint of the soul from agitation upon provocation.\n  - *Al-Raghib (Mufradat):* Al-Ḥilm is the soul's composure and its withholding from haste; it is a virtue opposed to al-ṭaysh (levity) and al-jahl (foolishness) — not ignorance, but the deliberate restraint of passion.\n  - *Al-Zamakhshari (Asas):* Literal: dreams (aḥlām) share the root — the state of being unmoved. Metaphorical: the forbearing man (ḥalīm) whose soul does not stir toward vengeance when provoked.\n\n- **Root: رفق (R-F-Q)**\n  - *Lisan / Ayn:* Al-Rifq is gentleness, lenity, and the opposite of violence (al-ʿunf).\n  - *Al-Raghib (Mufradat):* Al-Rifq is the disposition toward ease and gentleness in all affairs; it is praised by the Law and is a quality of the prophets.\n  - *Al-Zamakhshari (Asas):* Literal: \"رفق به\" — he was gentle with him. Metaphorical: gentleness in conduct as a mode of spiritual excellence.\n\n- **Root: صفح (Ṣ-F-Ḥ)**\n  - *Lisan / Ayn:* Al-Ṣafḥ is turning away from an offense and meeting it with a generous countenance; from ṣafḥah (cheek/face) — to turn one's face away from the wrong.\n  - *Al-Raghib (Mufradat):* Al-Ṣafḥ is the overlooking of the offense combined with graciousness — it is more than mere pardon, for it includes magnanimity (al-Ifḍāl).\n  - *Al-Zamakhshari (Asas):* Literal: \"صفح عنه\" — he turned his face away from him. Metaphorical: to turn away from requital and instead bestow favor.\n\n- **Sibawayh Rule:** *Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā* (Restriction & Focused Predication) — \"إنما أعطى ما أعطى بأربع خصال\" employs innamā to restrict the cause of the gift to four qualities, and \"ليس الحليم من ظلم فحلم حتى إذا قدر انتقم\" uses laysa to negate the predicate entirely before affirming the true definition.\n\n---\n\n**", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'", "badge": "Insight"}], "120": [{"arabic": "ورجل جامع للخير يقتدى به كقوله تعالى إن إبراهيم كان أمة قانتا لله والأمة الدين كقوله عز وجل إنا وجدنا آباءنا على أمة والأمة الحين والزمان كقوله عز وجل إلى أمة معدودة وقوله عز وجل وادكر بعد أمة والأمة القامة يقال فلان حسن الأمة أي القامة وأمة رجل منفرد بدين لا يشركه فيه أحد قال صلى الله عليه وسلم يبعث زيد بن عمرو بن نفيل أمة وحده (1) والأمة يقال هذه أمة زيد أي أم زيد والروح أيضا ورد في القرآن على معان كثيرة فلا نطول بإيرادها وكذلك قد يقع الإبهام في الحروف مثل قوله عز وجل قأثرن به نقعا فوسطن به جمعا فالهاء الأو", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "123": [{"arabic": "محمد صلى الله عليه وسلم وملة أبينا إبراهيم حنيفا وما كان من المشركين (9) اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت وإليك المصير (10) اللهم إني أسألك أن تبعثنا في هذا اليوم إلى كل خير ونعوذ بك أن نجترح فيه سوءا أو نجره إلى مسلم فإنك قلت {وهو الذي يتوفاكم بالليل ويعلم ما جرحتم بالنهار ثم يبعثكم فيه ليقضى أجل مسمى} (11) اللهم فالق الإصباح وجاعل الليل سكنا والشمس والقمر حسبانا أسألك خير هذا اليوم وخير ما فيه وأعوذ بك من شره وشر ما فيه (12) بسم الله ما شاء الله لا قوة إلا بالله ما شاء الله", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "124": [{"arabic": "عالم الغيب والشهادة أنت تحكم بين عبادك فيما كانوا فيه يختلفون اهدني لما اختلف فيه من الحق بإذنك إنك تهدي من تشاء إلى صراط مستقيما (7) ثم يفتتح الصلاة ويصلي ركعتين خفيفتين ثم يصلي مثنى مثنى ما تيسر له ويختم بالوتر إن لم يكن قد صلى الوتر ويستحب أن يفصل بين الصلاتين عند تسليمه بمائة تسبيحة ليستريح ويزيد نشاطه للصلاة وقد صح في صلاة رسول الله صلى الله عليه وسلم بالليل أنه صلى أولا ركعتين خفيفتين ثم ركعتين طويلتين ثم ركعتين دون اللتين قبلهما ثم لم يزل يقصر بالتدريج إلى ثلاث عشرة ركعة (1) وسئلت عائشة رضي الله", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}], "125": [{"arabic": "ولم تزل الرسل صلوات الله عليهم يحاجون المنكرين ويجادلونهم قال تعالى {وجادلهم بالتي هي أحسن} فالصحابة رضي الله عنهم أيضا كانوا يحاجون المنكرين ويجادلون ولكن عند الحاجة وكانت الحاجة إليه قليلة في زمانهم وأول من سن دعوة المبتدعة بالمجادلة إلى الحق علي ابن أبي طالب رضي الله عنه إذ بعث ابن عباس رضي الله عنهما إلى الخوارج فكلمهم فقال ما تنقمون على إمامكم قالوا قاتل ولم يسب ولم يغنم فقال ذلك في قتال الكفار أرأيتم لو سببت عائشة رضي الله عنها في سهم أحدكم أكنتم تستحلون منها ما تستحلون من ملككم وهي أمكم في نص الكتاب فقالوا لا فرجع منهم إلى", "english": "The mention of the proof (ḥujjah), the demand for it, and the search after it — how could these be prohibited, when God — may He be exalted — has said: {«قُلْ هَاتُوا بُرْهَانَكُمْ»} (Say: Bring forth your proof — Qur'an 2:111), and He — mighty and majestic — has said: {«لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَا مَنْ حَيَّ عَنْ بَيِّنَةٍ»} (So that he who perishes may perish upon clear evidence, and he who lives may live upon clear evidence — Qur'an 8:42), and He — may He be exalted — has said: {«هَلْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا»} (Have you any authority for this? — Qur'an 10:68), meaning a proof and demonstration, and He — may He be exalted — has said: {«قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ»} (Say: To God belongs the conclusive proof — Qur'an 6:149), and He — may He be exalted — has said: {«أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ»} (Have you not considered him who disputed with Abraham concerning his Lord? — Qur'an 2:258) up to His words: {«فَبُهِتَ الَّذِي كَفَرَ»} (So the one who disbelieved was confounded — Qur'an 2:258).", "book_title": "Foundations of Belief", "section_title_ar": "Section 77", "section_title_en": "The Revival of the Religious Sciences — Section 77: On the Permissibility of Theological Discourse (Kalām) and Its Early Practice", "section_index": 77, "anchors": "- Root: ح-د-ث (ḥ-d-th)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not; al-ḥadath: the novel event; al-ḥīdāth: origination.\"\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: a thing's becoming after it was not, whether accident or substance; iḥdāth: bringing it into existence. The origination of substances belongs to God alone.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'He is a recent event among events.' Metaphorical: 'They became topics of conversation (aḥādīth).'\"\n- Root: ح-ا-ج (ḥ-ā-j)\n  * Lisan / Ayn: \"Al-ḥājah: need of a thing, with desire for it; its plural: ḥājāt and ḥawā'ij.\"\n  * Al-Raghib (Mufradat): \"Al-ḥājah ilā al-shay': poverty toward it with love of it. God said: {«إِلَّا حَاجَةً فِي نَفْسِ يَعْقُوبَ»} (except a need in Jacob's soul — Qur'an 12:68).\"\n  * Al-Zamakhshari (Asas): \"Literal: need and want. The 'ḥājah' is that which one seeks to obtain.\"\n- Root: ك-و-ن (k-w-n)\n  * Lisan / Ayn: \"Kāna: to be, to exist; takwīn: bringing into being from non-existence.\"\n  * Al-Raghib (Mufradat): \"Al-kawn: existence after non-existence; the muḥdath (originated thing) is that brought forth after it was not.\"\n  * Al-Zamakhshari (Asas): \"Literal: being and becoming. Metaphorical: the continuous states of affairs.\"\n- Sibawayh Rule: Al-Faṣl bayna al-Jār wa-al-Majrūr (Prepositional Interposition) — The permissibility of separating a preposition from its object when the intervening clause is complete in meaning, as in the verse's structure of argumentation where the proof (ḥujjah) stands independently before its conclusion.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}, {"arabic": "الله وعمل صالحا} وقال تعالى {ادع إلى سبيل ربك بالحكمة والموعظة الحسنة} وقال تعالى {ويعلمهم الكتاب والحكمة} وأما الأخبار فقوله صلى الله عليه وسلم لما بعث معاذا رضي الله عنه إلى اليمن لأن يهدي الله بك رجلا واحدا خير لك من الدنيا وما فيها // حديث قال لمعاذ حين بعثه إلى اليمن لأن يهدي الله بك رجلا واحدا خير لك الحديث أخرجه أحمد من حديث معاذ وفي الصحيحين من حديث سهل ابن سعد أنه قال ذلك لعلي وقال صلى الله عليه وسلم من تعلم بابا من العلم ليعلم الناس أعطي ثواب سبعين صديقا (1) وقال عيسى صلى الله عليه وسلم", "english": "As for the Qur'anic verses: His saying, Mighty and Majestic is He: {وَلِيُنذِرُوا قَوْمَهُمْ إِذَا رَجَعُوا إِلَيْهِمْ لَعَلَّهُمْ يَحْذَرُونَ} \"That they may warn their people when they return to them, that perhaps they may be cautious\" {«ولينذروا قومهم إذا رجعوا إليهم لعلهم يحذرون»} — and the intended meaning is teaching and guidance (al-taʿlīm wa-al-irshād).", "book_title": "Book of Knowledge", "section_title_ar": "Section 8", "section_title_en": "The Excellence of Teaching (Faḍīlat al-Taʿlīm)", "section_index": 8, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning is \"to know, to perceive a thing by its reality\"; the root also carries the sense of \"marker, sign, banner\" — that by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing by its true reality, divided into apprehension of the essence of a thing and judgment upon it. This is the attribute by which the scholar (ʿālim) is distinguished and by which he becomes a \"sign\" (ʿalam) pointing to truth.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — the scholar is among the lofty banners of knowledge. The teaching act makes the scholar a living signpost; the root's literal sense of \"marking\" or \"branding\" a thing carries into the metaphorical (majāz) register of \"imprinting\" knowledge upon hearts.\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: Core meaning is \"to be new, to occur after not having been\"; al-ḥadīth is speech that is new and conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence. The prophetic traditions (aḥādīth) cited here are \"newly conveyed\" reports that carry authority.\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"صاروا أحاديث\" — they became subjects of discourse. The transmission of knowledge is an \"event\" (ḥadath) that occurs in the listener, renewing his state.\n- Root: عهد (ʿahida)\n  * Lisan / Ayn: Core meaning is \"covenant, pact, charge\"; al-ʿahd is a binding commission that one is obligated to fulfill.\n  * Al-Raghib (Mufradat): The covenant (mīthāq) taken from the People of the Book and from the scholars is a divine charge (taklīf) that makes teaching an obligation, not a supererogatory act.\n  * Al-Zamakhshari (Asas): Literal: the covenant is a \"charge entrusted\" (waṣiyyah) that binds the one who receives knowledge to its dissemination.\n- Root: كتم (katama)\n  * Lisan / Ayn: Core meaning is \"to conceal, to hide\"; al-kitmān is the deliberate suppression of what ought to be revealed.\n  * Al-Raghib (Mufradat): Concealment of knowledge is paired with concealment of testimony (shahādah) in the Qur'an — both are sins of the heart (ithm al-qalb) because they withhold what God has commanded to be made manifest.\n  * Al-Zamakhshari (Asas): Literal vs. metaphorical: the \"bridle of fire\" (lijām min nār) on the Day of Judgment is a metaphorical (majāz) embodiment of the inner restraint of truth — the concealed knowledge becomes a physical restraint in the afterlife.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The verse {وإن فريقا منهم ليكتمون الحق وهم يعلمون} employs the restrictive particle \"inna\" with the continuous verb form (yaktimūn) to specify an ongoing, willful concealment, distinguishing it from mere ignorance. The conditional structures in the ḥadīth \"man taʿallama... man ʿallama... man katama\" (whoever learns... whoever teaches... whoever conceals) follow the canonical pattern of protasis-apodosis (sharṭ/jazāʾ) that establishes a universal causal linkage between the act and its recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "126": [{"arabic": "في القصاص وغيره فقال تعالى {وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو} خير الصابرين {وقال} صلى الله عليه وسلم صل من قطعك وأعط من حرمك واعف عمن ظلمك // ورأيت في الإنجيل قال عيسى بن مريم عليه السلام لقد قيل لكم من قبل إن السن بالسن والأنف بالأنف وأنا أقول لكم لا تقاوموا بالشر بل من ضرب خدك الأيمن فحول إليه الخد الأيسر ومن أخذ رداءك فأعطه إزارك ومن سخرك لتسير معه ميلا فسر معه ميلين وكل ذلك أمر بالصبر على الأذى فالصبر على أذى الناس من أعلى مراتب الصبر لأنه يتعاون فيه باعث الدين وباعث الشهوة والغضب جميعا", "english": "And acts of disobedience are the requisite of the impulse of caprice (bāʿith al-hawā). And the most severe kind of patience is patience in abstaining from those acts of disobedience that have become familiar through habit — for habit is a fifth nature. When habit is joined to lustful desire, two battalions from the battalions of Satan array themselves in concert against the battalion of God (jund Allāh) — may He be exalted — and the impulse of religion (bāʿith al-dīn) has no strength to suppress them. Then, if that act be one whose commission has been rendered easy (tayassara), patience in abstaining from it is heavier upon the soul — such as patience in abstaining from the sins of the tongue: backbiting (ghībah), falsehood, contentious disputation (mirāʾ), self-praise whether by insinuation (taʿrīḍ) or by explicit statement (taṣrīḥ), the varieties of jesting that wound hearts, the kinds of words by which one intends belittlement and contempt, and the mention of the dead with aspersion cast upon them, upon their sciences, their conduct, and their stations. For such mention is in its outward aspect (fī ẓāhirihi) backbiting, and in its inward aspect (fī bāṭinihi) self-praise. In it the soul has two lusts: one is the negation of the other [person], and the other is the affirmation of oneself. And by these two together there is completed for it that lordship (rubūbiyyah) which is innate in its disposition — and which is the very opposite of what it has been commanded regarding servanthood (ʿubūdiyyah). And because of the conjunction of the two lusts, and the ease of moving the tongue, and the fact that this becomes habitual in everyday converse, patience in abstaining from it becomes difficult. And it is among the greatest of the destructive enormities (al-mūbiqāt) — so much so that its disapproval and ugliness have been effaced from hearts by dint of its frequent repetition and the universality of familiarity with it. Thus you see a man who would, for example, wear silk and deem it utterly remote [of permissibility], yet he unleashes his tongue the whole day long against the reputations (aʿrāḍ) of people and does not deem that objectionable — notwithstanding what has come down in the report that backbiting is more severe than adultery (zinā). And God — may He be exalted — said: {«ودع أذاهم وتوكل على الله»} \"And leave aside their harm and put thy trust in God\" (Q. 33:48). And He said — may He be exalted: {«واصبر على ما يقولون واهجرهم هجرا جميلا»} \"And be patient over what they say, and depart from them with a gracious departure\" (Q. 73:10). And He said — may He be exalted: {«ولقد نعلم أنك يضيق صدرك بما يقولون فسبح بحمد ربك»} \"And indeed We know that thy breast is straitened by what they say; so glorify with the praise of thy Lord\" (Q. 15:97–98) — to the end of the verse. And He said — may He be exalted: {«ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور»} \"And you shall surely hear from those who were given the Scripture before you and from those who associate [others with God] much harm. And if you are patient and God-fearing, indeed that is of the resolute affairs\" (Q. 3:186) — that is, that you be patient in refraining from requital (mukāfaʾah). And for this reason God — may He be exalted — praised those who pardon others their due rights in retaliation (qiṣāṣ) and otherwise, saying — may He be exalted: {«وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو خير الصابرين»} \"And if you punish, then punish with the like of that wherewith you were afflicted. And if you are patient, it is surely better for the patient\" (Q. 16:126). And he — upon him be peace — said: \"Maintain the bond with him who cuts you off, and give to him who withholds from you, and pardon him who wrongs you.\" And I have seen in the Gospel that ʿĪsā ibn Maryam — upon him be peace — said: \"It was said to you of old: an eye for an eye and a nose for a nose. But I say to you: do not resist evil. Rather, whoever strikes your right cheek, turn to him PageV04P071 the left cheek; and whoever takes your cloak, give him your garment; and whoever compels you to walk with him one mile, walk with him two miles.\" And all of that is a command to be patient under harm. So patience under the harm of people is among the highest stations of patience, because in it the impulse of religion and the impulse of lustful desire and anger are all arrayed together [against the soul].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 965", "section_title_en": "The Most Severe Forms of Patience: Abstaining from Habitual Sins and Enduring Harm", "section_index": 965, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; \"ṣabara al-dābbah\" = to hold back an animal without fodder; \"ṣabartu nafsī\" = I restrained my soul.\n  * Al-Raghib (Mufradat): \"الصبر: حبس النفس على ما يقتضيه العقل والشرع، أو عما يقتضيان حبسها عنه\" — Patience is the withholding of the soul upon what reason and Law require, or from what they require it to be withheld. When exercised against calamity it is called ṣabr alone (opposed to jazaʿ); in warfare, courage (shajāʿah); in vexing misfortune, forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — I bore patiently what I dislike, and I restrained myself from what I love. Metaphorical (majāz): \"هو أصبر على الضرب من الأرض\" — he is more enduring of beating than the earth.\n- Root: عادة (ʿ-w-d)\n  * Lisan / Ayn: Recurrence and return; habitual practice that becomes second nature through repetition.\n  * Al-Raghib (Mufradat): Habit (ʿādah) as reiterated action that imprints upon the soul, rendering the act facile and its abandonment burdensome.\n  * Al-Zamakhshari (Asas): Literal: return to a state or place. Metaphorical: the ingrained disposition that governs conduct.\n- Root: غيب (gh-y-b)\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين\" — that which is concealed from the senses; applied to what is absent from human perception, though nothing is absent from God.\n  * Al-Zamakhshari (Asas): Literal: \"تكلم بذلك عن ظهر الغيب\" — he spoke of that behind the veil of the unseen. Metaphorical: \"أتونا في غابة\" — they came in a dense host (like tangled thickets).\n- Sibawayh Rule: Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the periodic construction \"فإن ذلك في ظاهره غيبة وفي باطنه ثناء على النفس\" where the circumstantial qualifiers (ẓāhir/bāṭin) are interposed to contrast outward form with inward reality.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}], "128": [{"arabic": "الله تعالى المنزل إن الله مع الذين اتقوا والذين هم محسنون قال يحيى بن كثير فنظرنا", "english": "Among these manifestations is pride in loving that people stand up for him, or rise before him. ʿAlī — may God honor his face — said: \"Whoever wishes to look upon a man of the Fire, let him look at a man seated while people stand before him.\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 862", "section_title_en": "The Book of Pride and Self-Conceit — Section 862: Manifestations of Pride (Takabbur) in Bearing, Speech, and Conduct, and the Prophetic Model of Humility (Tawāḍuʿ)", "section_index": 862, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core meaning of greatness, magnitude, and elevation in rank or stature; takabbur (تَكَبُّر) is the assumption of greatness over others, the comportment of one who deems himself above his fellow creatures.\n  * Al-Raghib (Mufradat): Al-istikbār is the soul's refusal of truth out of disdain for its bearer, and its haughty rejection of what is right; it is the root of every blameworthy trait, for Iblis's fall was his refusal to prostrate out of pride.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical height and elevation. Metaphorical (majāz): the heart's self-elevation above others, manifesting in bodily postures — the \"ṣaʿar\" (turning the cheek away) being its visible sign.\n- Root: وضع (w-ḍ-ʿ)\n  * Lisan / Ayn: To place down low, to lower, to set something down; tawāḍuʿ (تَوَاضُع) is the lowering of oneself, the opposite of elevation and haughtiness.\n  * Al-Raghib (Mufradat): Al-tawāḍuʿ is humility before God and His creatures — the soul's recognition of its true station and its refusal to claim what it does not deserve; it is the root of every praiseworthy trait.\n  * Al-Zamakhshari (Asas): Literal: physical lowering. Metaphorical: the soul's self-abasement in conduct — sitting where one is bid, serving oneself, and accepting invitation from the poor.\n- Root: شمل (sh-m-l)\n  * Lisan / Ayn: To encompass, to include all parts; shamāʾil (شَمَائِل) are the innate dispositions and outward traits that encompass a man's character.\n  * Al-Raghib (Mufradat): The outward marks and habitual bearing through which inner moral states become visible to observers.\n  * Al-Zamakhshari (Asas): Used here in its literal sense of comprehensive outward features — the face, gait, voice, and gestures that betray the inner state.\n- Root: بذذ (b-dh-dh)\n  * Lisan / Ayn: Al-badhādha (البَذَاذَة) is the roughness and plainness of dress and appearance, the state of one who does not adorn himself.\n  * Al-Raghib (Mufradat): In the prophetic tradition {البَذَاذَةُ مِنَ الإِيمَانِ}, it signifies the believer's indifference to worldly finery — a mean and unadorned appearance that reflects the heart's detachment.\n  * Al-Zamakhshari (Asas): Literal: shabbiness of garment. Metaphorical: the soul's refusal to seek honor through dress, distinguishing genuine humility from affected squalor.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (باب الحصر والتقييد) — governing the author's use of \"إنما\" and restrictive clauses to delimit the precise scope of pride's manifestations and humility's counter-examples, ensuring each trait is specified without overgeneralization.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1848], [2, 1848, 2608], [3, 2608, 3546], [4, 3546, 4401], [5, 4401, 6467], [6, 6467, 7894], [7, 7894, 9751], [8, 9751, 10998], [9, 10998, 12706]], "2": [[1, 400, 1676], [2, 1676, 3620], [3, 3620, 5236], [4, 5236, 5722], [5, 5722, 6718], [6, 6718, 7836], [7, 7836, 8322], [8, 8322, 10183], [9, 10183, 10669], [10, 10669, 12404], [11, 12404, 12939], [12, 12939, 15320], [13, 15320, 16426], [14, 16426, 17680], [15, 17680, 18579], [16, 18579, 20307], [17, 20307, 21230], [18, 21230, 22868]], "3": [[1, 400, 1121], [2, 1121, 2918], [3, 2918, 4295], [4, 4295, 5497], [5, 5497, 6878], [6, 6878, 8025], [7, 8025, 9598]], "4": [[1, 400, 1185], [2, 1185, 2674], [3, 2674, 3150], [4, 3150, 4548], [5, 4548, 5714], [6, 5714, 6285], [7, 6285, 7451], [8, 7451, 8866]], "5": [[1, 400, 1998], [2, 1998, 3168], [3, 3168, 3773], [4, 3773, 4782], [5, 4782, 5347], [6, 5347, 6618], [7, 6618, 7828], [8, 7828, 9180]], "6": [[1, 350, 1145], [2, 1145, 2029], [3, 2029, 2842], [4, 2842, 3478], [5, 3478, 4733], [6, 4733, 5635], [7, 5635, 6820]], "7": [[1, 400, 1605], [2, 1605, 3348], [3, 3348, 4338], [4, 4338, 4984], [5, 4984, 5576], [6, 5576, 7212], [7, 7212, 8525], [8, 8525, 9504], [9, 9504, 10430], [10, 10430, 11635], [11, 11635, 12421], [12, 12421, 13443], [13, 13443, 14584], [14, 14584, 15736]], "8": [[1, 400, 1487], [2, 148