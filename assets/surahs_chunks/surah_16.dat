 "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 13, "text": "وَمَا ذَرَأَ لَكُمْ فِے اِ۬لَارْضِ مُخْتَلِفاً اَلْوَٰنُهُۥٓۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةࣰ لِّقَوْمࣲ يَذَّكَّرُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَرَأَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُخْتَلِفاً", "translit": "", "root": ""}, {"id": 7, "arabic": "اَلْوَٰنُهُۥٓۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَأٓيَةࣰ", "translit": "", "root": ""}, {"id": 12, "arabic": "لِّقَوْمࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَذَّكَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 14, "text": "وَهُوَ اَ۬لذِے سَخَّرَ اَ۬لْبَحْرَ لِتَاكُلُواْ مِنْهُ لَحْماࣰ طَرِيّاࣰ وَتَسْتَخْرِجُواْ مِنْهُ حِلْيَةࣰ تَلْبَسُونَهَاۖ وَتَرَي اَ۬لْفُلْكَ مَوَاخِرَ فِيهِ وَلِتَبْتَغُواْ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "سَخَّرَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْبَحْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِتَاكُلُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَحْماࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "طَرِيّاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَتَسْتَخْرِجُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "حِلْيَةࣰ", "translit": "", "root": ""}, {"id": 12, "arabic": "تَلْبَسُو