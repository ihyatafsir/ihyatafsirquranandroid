{"surah": 16, "verses": [{"ayah": 1, "text": "أَتَىٰٓ أَمْرُ ٱللَّهِ فَلَا تَسْتَعْجِلُوهُۚ سُبْحَٰنَهُۥ وَتَعَٰلَىٰ عَمَّا يُشْرِكُونَ ", "translation": "The command of Allāh is coming,[1] so be not impatient for it. Exalted is He and high above what they associate with Him.", "words": [{"id": 1, "arabic": "أَتَىٰٓ", "translit": "ٰٓàَtَaʾ", "root": "اتي"}, {"id": 2, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "تَسْتَعْجِلُوهُ", "translit": "ُhwُlِjgْʿعَtْsَt", "root": "عجل"}, {"id": 6, "arabic": "سُبْحَٰنَهُۥ", "translit": "ۥُhَnَٰḥْbُs", "root": "سبح"}, {"id": 7, "arabic": "وَتَعَٰلَىٰ", "translit": "ٰàَlَٰʿعَtَw", "root": "علو"}, {"id": 8, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 9, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 2, "text": "يُنَزِّلُ ٱلْمَلَٰٓئِكَةَ بِٱلرُّوحِ مِنْ أَمْرِهِۦ عَلَىٰ مَن يَشَآءُ مِنْ عِبَادِهِۦٓ أَنْ أَنذِرُوٓا۟ أَنَّهُۥ لَآ إِلَٰهَ إِلَّآ أَنَا۠ فَٱتَّقُونِ ", "translation": "He sends down the angels, with the inspiration [i.e., revelation] of His command, upon whom He wills of His servants, [telling them], \"Warn that there is no deity except Me; so fear Me.\"", "words": [{"id": 1, "arabic": "يُنَزِّلُ", "translit": "ُlِّzَnُy", "root": "نزل"}, {"id": 2, "arabic": "ٱلْمَلَٰٓئِكَةَ", "translit": "َẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 3, "arabic": "بِٱلرُّوحِ", "translit": "ِḥwُّrlٱِb", "root": "روح"}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "أَمْرِهِۦ", "translit": "ۦِhِrْmَaʾ", "root": "امر"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 9, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 10, "arabic": "عِبَادِهِۦٓ", "translit": "ٓۦِhِdāَbِʿع", "root": "عبد"}, {"id": 11, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 12, "arabic": "أَنذِرُوٓا۟", "translit": "۟āٓwُrِhdnَaʾ", "root": "نذر"}, {"id": 13, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 14, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 15, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 16, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 17, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 18, "arabic": "فَٱتَّقُونِ", "translit": "ِnwُqَّtٱَf", "root": "وقي"}], "hasIhya": false}, {"ayah": 3, "text": "خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ بِٱلْحَقِّۚ تَعَٰلَىٰ عَمَّا يُشْرِكُونَ ", "translation": "He created the heavens and earth in truth. High is He above what they associate with Him.", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 2, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 4, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 5, "arabic": "تَعَٰلَىٰ", "translit": "ٰàَlَٰʿعَt", "root": "علو"}, {"id": 6, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 7, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 4, "text": "خَلَقَ ٱلْإِنسَٰنَ مِن نُّطْفَةٍ فَإِذَا هُوَ خَصِيمٌ مُّبِينٌ ", "translation": "He created man from a sperm-drop; then at once[1] he is a clear adversary.", "words": [{"id": 1, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 2, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "نُّطْفَةٍ", "translit": "ٍẗَfْṭُّn", "root": "نطف"}, {"id": 5, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 6, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 7, "arabic": "خَصِيمٌ", "translit": "ٌmyِṣَhk", "root": "خصم"}, {"id": 8, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 5, "text": "وَٱلْأَنْعَٰمَ خَلَقَهَاۗ لَكُمْ فِيهَا دِفْءٌ وَمَنَٰفِعُ وَمِنْهَا تَأْكُلُونَ ", "translation": "And the grazing livestock He has created for you; in them is warmth[1] and [numerous] benefits, and from them you eat.", "words": [{"id": 1, "arabic": "وَٱلْأَنْعَٰمَ", "translit": "َmَٰʿعْnَaʾْlٱَw", "root": "نعم"}, {"id": 2, "arabic": "خَلَقَهَا", "translit": "āَhَqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 5, "arabic": "دِفْءٌ", "translit": "ٌءْfِd", "root": "دفا"}, {"id": 6, "arabic": "وَمَنَٰفِعُ", "translit": "ُʿعِfَٰnَmَw", "root": "نفع"}, {"id": 7, "arabic": "وَمِنْهَا", "translit": "āَhْnِmَw", "root": ""}, {"id": 8, "arabic": "تَأْكُلُونَ", "translit": "َnwُlُkْaʾَt", "root": "اكل"}], "hasIhya": false}, {"ayah": 6, "text": "وَلَكُمْ فِيهَا جَمَالٌ حِينَ تُرِيحُونَ وَحِينَ تَسْرَحُونَ ", "translation": "And for you in them is [the enjoyment of] beauty when you bring them in [for the evening] and when you send them out [to pasture].", "words": [{"id": 1, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "جَمَالٌ", "translit": "ٌlāَmَjg", "root": "جمل"}, {"id": 4, "arabic": "حِينَ", "translit": "َnyِḥ", "root": "حين"}, {"id": 5, "arabic": "تُرِيحُونَ", "translit": "َnwُḥyِrُt", "root": "روح"}, {"id": 6, "arabic": "وَحِينَ", "translit": "َnyِḥَw", "root": "حين"}, {"id": 7, "arabic": "تَسْرَحُونَ", "translit": "َnwُḥَrْsَt", "root": "سرح"}], "hasIhya": false}, {"ayah": 7, "text": "وَتَحْمِلُ أَثْقَالَكُمْ إِلَىٰ بَلَدٍ لَّمْ تَكُونُوا۟ بَٰلِغِيهِ إِلَّا بِشِقِّ ٱلْأَنفُسِۚ إِنَّ رَبَّكُمْ لَرَءُوفٌ رَّحِيمٌ ", "translation": "And they carry your loads to a land you could not have reached except with difficulty to yourselves. Indeed, your Lord is Kind and Merciful.", "words": [{"id": 1, "arabic": "وَتَحْمِلُ", "translit": "ُlِmْḥَtَw", "root": "حمل"}, {"id": 2, "arabic": "أَثْقَالَكُمْ", "translit": "ْmُkَlāَqْhtَaʾ", "root": "ثقل"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "بَلَدٍ", "translit": "ٍdَlَb", "root": "بلد"}, {"id": 5, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 6, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 7, "arabic": "بَٰلِغِيهِ", "translit": "ِhyِغِlَٰb", "root": "بلغ"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "بِشِقِّ", "translit": "ِّqِhsِb", "root": "شقق"}, {"id": 10, "arabic": "ٱلْأَنفُسِ", "translit": "ِsُfnَaʾْlٱ", "root": "نفس"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 13, "arabic": "لَرَءُوفٌ", "translit": "ٌfwُءَrَl", "root": "راف"}, {"id": 14, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 8, "text": "وَٱلْخَيْلَ وَٱلْبِغَالَ وَٱلْحَمِيرَ لِتَرْكَبُوهَا وَزِينَةًۚ وَيَخْلُقُ مَا لَا تَعْلَمُونَ ", "translation": "And [He created] the horses, mules and donkeys for you to ride and [as] adornment. And He creates that which you do not know.", "words": [{"id": 1, "arabic": "وَٱلْخَيْلَ", "translit": "َlْyَhkْlٱَw", "root": "خيل"}, {"id": 2, "arabic": "وَٱلْبِغَالَ", "translit": "َlāَغِbْlٱَw", "root": "بغل"}, {"id": 3, "arabic": "وَٱلْحَمِيرَ", "translit": "َryِmَḥْlٱَw", "root": "حمر"}, {"id": 4, "arabic": "لِتَرْكَبُوهَا", "translit": "āَhwُbَkْrَtِl", "root": "ركب"}, {"id": 5, "arabic": "وَزِينَةً", "translit": "ًẗَnyِzَw", "root": "زين"}, {"id": 6, "arabic": "وَيَخْلُقُ", "translit": "ُqُlْhkَyَw", "root": "خلق"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 9, "text": "وَعَلَى ٱللَّهِ قَصْدُ ٱلسَّبِيلِ وَمِنْهَا جَآئِرٌۚ وَلَوْ شَآءَ لَهَدَىٰكُمْ أَجْمَعِينَ ", "translation": "And upon Allāh[1] is the direction of the [right] way, and among them [i.e., the various paths] are those deviating. And if He willed, He could have guided you all.", "words": [{"id": 1, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 2, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "قَصْدُ", "translit": "ُdْṣَq", "root": "قصد"}, {"id": 4, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "āَhْnِmَw", "root": ""}, {"id": 6, "arabic": "جَآئِرٌ", "translit": "ٌrِyʾٓāَjg", "root": "جور"}, {"id": 7, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 8, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 9, "arabic": "لَهَدَىٰكُمْ", "translit": "ْmُkٰàَdَhَl", "root": "هدي"}, {"id": 10, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": true}, {"ayah": 10, "text": "هُوَ ٱلَّذِىٓ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءًۖ لَّكُم مِّنْهُ شَرَابٌ وَمِنْهُ شَجَرٌ فِيهِ تُسِيمُونَ ", "translation": "It is He who sends down rain from the sky; from it is drink and from it is foliage in which you pasture [animals].", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 7, "arabic": "لَّكُم", "translit": "mُkَّl", "root": ""}, {"id": 8, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 9, "arabic": "شَرَابٌ", "translit": "ٌbāَrَhs", "root": "شرب"}, {"id": 10, "arabic": "وَمِنْهُ", "translit": "ُhْnِmَw", "root": ""}, {"id": 11, "arabic": "شَجَرٌ", "translit": "ٌrَjgَhs", "root": "شجر"}, {"id": 12, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 13, "arabic": "تُسِيمُونَ", "translit": "َnwُmyِsُt", "root": "سوم"}], "hasIhya": false}, {"ayah": 11, "text": "يُنۢبِتُ لَكُم بِهِ ٱلزَّرْعَ وَٱلزَّيْتُونَ وَٱلنَّخِيلَ وَٱلْأَعْنَٰبَ وَمِن كُلِّ ٱلثَّمَرَٰتِۗ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَتَفَكَّرُونَ ", "translation": "He causes to grow for you thereby the crops, olives, palm trees, grapevines, and of all the fruits. Indeed in that is a sign for a people who give thought.", "words": [{"id": 1, "arabic": "يُنۢبِتُ", "translit": "ُtِbۢnُy", "root": "نبت"}, {"id": 2, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 3, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 4, "arabic": "ٱلزَّرْعَ", "translit": "َʿعْrَّzlٱ", "root": "زرع"}, {"id": 5, "arabic": "وَٱلزَّيْتُونَ", "translit": "َnwُtْyَّzlٱَw", "root": "زيت"}, {"id": 6, "arabic": "وَٱلنَّخِيلَ", "translit": "َlyِhkَّnlٱَw", "root": "نخل"}, {"id": 7, "arabic": "وَٱلْأَعْنَٰبَ", "translit": "َbَٰnْʿعَaʾْlٱَw", "root": "عنب"}, {"id": 8, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 9, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 10, "arabic": "ٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱ", "root": "ثمر"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 14, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 15, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 16, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": false}, {"ayah": 12, "text": "وَسَخَّرَ لَكُمُ ٱلَّيْلَ وَٱلنَّهَارَ وَٱلشَّمْسَ وَٱلْقَمَرَۖ وَٱلنُّجُومُ مُسَخَّرَٰتٌۢ بِأَمْرِهِۦٓۗ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يَعْقِلُونَ ", "translation": "And He has subjected for you the night and day and the sun and moon, and the stars are subjected by His command. Indeed in that are signs for a people who reason.", "words": [{"id": 1, "arabic": "وَسَخَّرَ", "translit": "َrَّhkَsَw", "root": "سخر"}, {"id": 2, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 3, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 4, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 5, "arabic": "وَٱلشَّمْسَ", "translit": "َsْmَّhslٱَw", "root": "شمس"}, {"id": 6, "arabic": "وَٱلْقَمَرَ", "translit": "َrَmَqْlٱَw", "root": "قمر"}, {"id": 7, "arabic": "وَٱلنُّجُومُ", "translit": "ُmwُjgُّnlٱَw", "root": "نجم"}, {"id": 8, "arabic": "مُسَخَّرَٰتٌۢ", "translit": "ٌۢtَٰrَّhkَsُm", "root": "سخر"}, {"id": 9, "arabic": "بِأَمْرِهِۦٓ", "translit": "ٓۦِhِrْmَaʾِb", "root": "امر"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 14, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 15, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": true}, {"ayah": 13, "text": "وَمَا ذَرَأَ لَكُمْ فِى ٱلْأَرْضِ مُخْتَلِفًا أَلْوَٰنُهُۥٓۗ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَذَّكَّرُونَ ", "translation": "And [He has subjected] whatever He multiplied for you on the earth of varying colors. Indeed in that is a sign for a people who remember.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "ذَرَأَ", "translit": "َaʾَrَhd", "root": "ذرا"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "مُخْتَلِفًا", "translit": "āًfِlَtْhkُm", "root": "خلف"}, {"id": 7, "arabic": "أَلْوَٰنُهُۥٓ", "translit": "ٓۥُhُnَٰwْlَaʾ", "root": "لون"}, {"id": 8, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 11, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 12, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 13, "arabic": "يَذَّكَّرُونَ", "translit": "َnwُrَّkَّhdَy", "root": "ذكر"}], "hasIhya": false}, {"ayah": 14, "text": "وَهُوَ ٱلَّذِى سَخَّرَ ٱلْبَحْرَ لِتَأْكُلُوا۟ مِنْهُ لَحْمًا طَرِيًّا وَتَسْتَخْرِجُوا۟ مِنْهُ حِلْيَةً تَلْبَسُونَهَا وَتَرَى ٱلْفُلْكَ مَوَاخِرَ فِيهِ وَلِتَبْتَغُوا۟ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَ ", "translation": "And it is He who subjected the sea for you to eat from it tender meat and to extract from it ornaments which you wear. And you see the ships plowing through it, and [He subjected it] that you may seek of His bounty; and perhaps you will be grateful.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "سَخَّرَ", "translit": "َrَّhkَs", "root": "سخر"}, {"id": 4, "arabic": "ٱلْبَحْرَ", "translit": "َrْḥَbْlٱ", "root": "بحر"}, {"id": 5, "arabic": "لِتَأْكُلُوا۟", "translit": "۟āwُlُkْaʾَtِl", "root": "اكل"}, {"id": 6, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 7, "arabic": "لَحْمًا", "translit": "āًmْḥَl", "root": "لحم"}, {"id": 8, "arabic": "طَرِيًّا", "translit": "āًّyِrَṭ", "root": "طرو"}, {"id": 9, "arabic": "وَتَسْتَخْرِجُوا۟", "translit": "۟āwُjgِrْhkَtْsَtَw", "root": "خرج"}, {"id": 10, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 11, "arabic": "حِلْيَةً", "translit": "ًẗَyْlِḥ", "root": "حلي"}, {"id": 12, "arabic": "تَلْبَسُونَهَا", "translit": "āَhَnwُsَbْlَt", "root": "لبس"}, {"id": 13, "arabic": "وَتَرَى", "translit": "àَrَtَw", "root": "راي"}, {"id": 14, "arabic": "ٱلْفُلْكَ", "translit": "َkْlُfْlٱ", "root": "فلك"}, {"id": 15, "arabic": "مَوَاخِرَ", "translit": "َrِhkāَwَm", "root": "مخر"}, {"id": 16, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 17, "arabic": "وَلِتَبْتَغُوا۟", "translit": "۟āwُغَtْbَtِlَw", "root": "بغي"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 20, "arabic": "وَلَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَlَw", "root": ""}, {"id": 21, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 15, "text": "وَأَلْقَىٰ فِى ٱلْأَرْضِ رَوَٰسِىَ أَن تَمِيدَ بِكُمْ وَأَنْهَٰرًا وَسُبُلًا لَّعَلَّكُمْ تَهْتَدُونَ ", "translation": "And He has cast into the earth firmly set mountains, lest it shift with you, and [made] rivers and roads, that you may be guided,", "words": [{"id": 1, "arabic": "وَأَلْقَىٰ", "translit": "ٰàَqْlَaʾَw", "root": "لقي"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "رَوَٰسِىَ", "translit": "َàِsَٰwَr", "root": "رسو"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَمِيدَ", "translit": "َdyِmَt", "root": "ميد"}, {"id": 7, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 8, "arabic": "وَأَنْهَٰرًا", "translit": "āًrَٰhْnَaʾَw", "root": "نهر"}, {"id": 9, "arabic": "وَسُبُلًا", "translit": "āًlُbُsَw", "root": "سبل"}, {"id": 10, "arabic": "لَّعَلَّكُمْ", "translit": "ْmُkَّlَʿعَّl", "root": ""}, {"id": 11, "arabic": "تَهْتَدُونَ", "translit": "َnwُdَtْhَt", "root": "هدي"}], "hasIhya": false}, {"ayah": 16, "text": "وَعَلَٰمَٰتٍۚ وَبِٱلنَّجْمِ هُمْ يَهْتَدُونَ ", "translation": "And landmarks. And by the stars they are [also] guided.[1]", "words": [{"id": 1, "arabic": "وَعَلَٰمَٰتٍ", "translit": "ٍtَٰmَٰlَʿعَw", "root": "علم"}, {"id": 2, "arabic": "وَبِٱلنَّجْمِ", "translit": "ِmْjgَّnlٱِbَw", "root": "نجم"}, {"id": 3, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 4, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 17, "text": "أَفَمَن يَخْلُقُ كَمَن لَّا يَخْلُقُۗ أَفَلَا تَذَكَّرُونَ ", "translation": "Then is He who creates like one who does not create? So will you not be reminded?", "words": [{"id": 1, "arabic": "أَفَمَن", "translit": "nَmَfَaʾ", "root": ""}, {"id": 2, "arabic": "يَخْلُقُ", "translit": "ُqُlْhkَy", "root": "خلق"}, {"id": 3, "arabic": "كَمَن", "translit": "nَmَk", "root": ""}, {"id": 4, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 5, "arabic": "يَخْلُقُ", "translit": "ُqُlْhkَy", "root": "خلق"}, {"id": 6, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 7, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 18, "text": "وَإِن تَعُدُّوا۟ نِعْمَةَ ٱللَّهِ لَا تُحْصُوهَآۗ إِنَّ ٱللَّهَ لَغَفُورٌ رَّحِيمٌ ", "translation": "And if you should count the favors of Allāh, you could not enumerate them. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "تَعُدُّوا۟", "translit": "۟āwُّdُʿعَt", "root": "عدد"}, {"id": 3, "arabic": "نِعْمَةَ", "translit": "َẗَmْʿعِn", "root": "نعم"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "تُحْصُوهَآ", "translit": "ٓāَhwُṣْḥُt", "root": "حصي"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 10, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 19, "text": "وَٱللَّهُ يَعْلَمُ مَا تُسِرُّونَ وَمَا تُعْلِنُونَ ", "translation": "And Allāh knows what you conceal and what you declare.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "تُسِرُّونَ", "translit": "َnwُّrِsُt", "root": "سرر"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "تُعْلِنُونَ", "translit": "َnwُnِlْʿعُt", "root": "علن"}], "hasIhya": false}, {"ayah": 20, "text": "وَٱلَّذِينَ يَدْعُونَ مِن دُونِ ٱللَّهِ لَا يَخْلُقُونَ شَيْـًٔا وَهُمْ يُخْلَقُونَ ", "translation": "And those they invoke other than Allāh create nothing, and they [themselves] are created.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَخْلُقُونَ", "translit": "َnwُqُlْhkَy", "root": "خلق"}, {"id": 8, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 9, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 10, "arabic": "يُخْلَقُونَ", "translit": "َnwُqَlْhkُy", "root": "خلق"}], "hasIhya": false}, {"ayah": 21, "text": "أَمْوَٰتٌ غَيْرُ أَحْيَآءٍۖ وَمَا يَشْعُرُونَ أَيَّانَ يُبْعَثُونَ ", "translation": "They are [in fact] dead,[1] not alive, and they do not perceive when they will be resurrected.", "words": [{"id": 1, "arabic": "أَمْوَٰتٌ", "translit": "ٌtَٰwْmَaʾ", "root": "موت"}, {"id": 2, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 3, "arabic": "أَحْيَآءٍ", "translit": "ٍءٓāَyْḥَaʾ", "root": "حيي"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}, {"id": 6, "arabic": "أَيَّانَ", "translit": "َnāَّyَaʾ", "root": ""}, {"id": 7, "arabic": "يُبْعَثُونَ", "translit": "َnwُhtَʿعْbُy", "root": "بعث"}], "hasIhya": false}, {"ayah": 22, "text": "إِلَٰهُكُمْ إِلَٰهٌ وَٰحِدٌۚ فَٱلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ قُلُوبُهُم مُّنكِرَةٌ وَهُم مُّسْتَكْبِرُونَ ", "translation": "Your god is one God. But those who do not believe in the Hereafter - their hearts are disapproving, and they are arrogant.", "words": [{"id": 1, "arabic": "إِلَٰهُكُمْ", "translit": "ْmُkُhَٰlِiʾ", "root": "اله"}, {"id": 2, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 3, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 4, "arabic": "فَٱلَّذِينَ", "translit": "َnyِhdَّlٱَf", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 7, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 8, "arabic": "قُلُوبُهُم", "translit": "mُhُbwُlُq", "root": "قلب"}, {"id": 9, "arabic": "مُّنكِرَةٌ", "translit": "ٌẗَrِknُّm", "root": "نكر"}, {"id": 10, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 11, "arabic": "مُّسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsُّm", "root": "كبر"}], "hasIhya": true}, {"ayah": 23, "text": "لَا جَرَمَ أَنَّ ٱللَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا يُعْلِنُونَۚ إِنَّهُۥ لَا يُحِبُّ ٱلْمُسْتَكْبِرِينَ ", "translation": "Assuredly, Allāh knows what they conceal and what they declare. Indeed, He does not like the arrogant.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "جَرَمَ", "translit": "َmَrَjg", "root": "جرم"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "يُسِرُّونَ", "translit": "َnwُّrِsُy", "root": "سرر"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "يُعْلِنُونَ", "translit": "َnwُnِlْʿعُy", "root": "علن"}, {"id": 10, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 13, "arabic": "ٱلْمُسْتَكْبِرِينَ", "translit": "َnyِrِbْkَtْsُmْlٱ", "root": "كبر"}], "hasIhya": true}, {"ayah": 24, "text": "وَإِذَا قِيلَ لَهُم مَّاذَآ أَنزَلَ رَبُّكُمْۙ قَالُوٓا۟ أَسَٰطِيرُ ٱلْأَوَّلِينَ ", "translation": "And when it is said to them, \"What has your Lord sent down?\" they say, \"Legends of the former peoples,\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 4, "arabic": "مَّاذَآ", "translit": "ٓāَhdāَّm", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 7, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 8, "arabic": "أَسَٰطِيرُ", "translit": "ُryِṭَٰsَaʾ", "root": "سطر"}, {"id": 9, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 25, "text": "لِيَحْمِلُوٓا۟ أَوْزَارَهُمْ كَامِلَةً يَوْمَ ٱلْقِيَٰمَةِۙ وَمِنْ أَوْزَارِ ٱلَّذِينَ يُضِلُّونَهُم بِغَيْرِ عِلْمٍۗ أَلَا سَآءَ مَا يَزِرُونَ ", "translation": "That they may bear their own burdens [i.e., sins] in full on the Day of Resurrection and some of the burdens of those whom they misguide without [i.e., by lack of] knowledge. Unquestionably, evil is that which they bear.", "words": [{"id": 1, "arabic": "لِيَحْمِلُوٓا۟", "translit": "۟āٓwُlِmْḥَyِl", "root": "حمل"}, {"id": 2, "arabic": "أَوْزَارَهُمْ", "translit": "ْmُhَrāَzْwَaʾ", "root": "وزر"}, {"id": 3, "arabic": "كَامِلَةً", "translit": "ًẗَlِmāَk", "root": "كمل"}, {"id": 4, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 5, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 6, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 7, "arabic": "أَوْزَارِ", "translit": "ِrāَzْwَaʾ", "root": "وزر"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "يُضِلُّونَهُم", "translit": "mُhَnwُّlِḍُy", "root": "ضلل"}, {"id": 10, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 11, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 12, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 13, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "يَزِرُونَ", "translit": "َnwُrِzَy", "root": "وزر"}], "hasIhya": false}, {"ayah": 26, "text": "قَدْ مَكَرَ ٱلَّذِينَ مِن قَبْلِهِمْ فَأَتَى ٱللَّهُ بُنْيَٰنَهُم مِّنَ ٱلْقَوَاعِدِ فَخَرَّ عَلَيْهِمُ ٱلسَّقْفُ مِن فَوْقِهِمْ وَأَتَىٰهُمُ ٱلْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ ", "translation": "Those before them had already plotted, but Allāh came at [i.e., uprooted] their building from the foundations, so the roof fell upon them from above them,[1] and the punishment came to them from where they did not perceive.", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "مَكَرَ", "translit": "َrَkَm", "root": "مكر"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فَأَتَى", "translit": "àَtَaʾَf", "root": "اتي"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "بُنْيَٰنَهُم", "translit": "mُhَnَٰyْnُb", "root": "بني"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلْقَوَاعِدِ", "translit": "ِdِʿعāَwَqْlٱ", "root": "قعد"}, {"id": 11, "arabic": "فَخَرَّ", "translit": "َّrَhkَf", "root": "خرر"}, {"id": 12, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلسَّقْفُ", "translit": "ُfْqَّslٱ", "root": "سقف"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "فَوْقِهِمْ", "translit": "ْmِhِqْwَf", "root": "فوق"}, {"id": 16, "arabic": "وَأَتَىٰهُمُ", "translit": "ُmُhٰàَtَaʾَw", "root": "اتي"}, {"id": 17, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 18, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 19, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 27, "text": "ثُمَّ يَوْمَ ٱلْقِيَٰمَةِ يُخْزِيهِمْ وَيَقُولُ أَيْنَ شُرَكَآءِىَ ٱلَّذِينَ كُنتُمْ تُشَٰٓقُّونَ فِيهِمْۚ قَالَ ٱلَّذِينَ أُوتُوا۟ ٱلْعِلْمَ إِنَّ ٱلْخِزْىَ ٱلْيَوْمَ وَٱلسُّوٓءَ عَلَى ٱلْكَٰفِرِينَ ", "translation": "Then on the Day of Resurrection He will disgrace them and say, \"Where are My 'partners' for whom you used to oppose [the believers]?\" Those who were given knowledge will say, \"Indeed disgrace, this Day, and evil are upon the disbelievers\" -", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 3, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 4, "arabic": "يُخْزِيهِمْ", "translit": "ْmِhyِzْhkُy", "root": "خزي"}, {"id": 5, "arabic": "وَيَقُولُ", "translit": "ُlwُqَyَw", "root": "قول"}, {"id": 6, "arabic": "أَيْنَ", "translit": "َnْyَaʾ", "root": ""}, {"id": 7, "arabic": "ش