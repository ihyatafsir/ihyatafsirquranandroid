", "root": "لقي"}, {"id": 7, "arabic": "ٱلسَّلَمَ", "translit": "َmَlَّslٱ", "root": "سلم"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 10, "arabic": "نَعْمَلُ", "translit": "ُlَmْʿعَn", "root": "عمل"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "سُوٓءٍۭ", "translit": "ٍۭءٓwُs", "root": "سوا"}, {"id": 13, "arabic": "بَلَىٰٓ", "translit": "ٰٓàَlَb", "root": ""}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 17, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 18, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 19, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 29, "text": "فَٱدْخُلُوٓا۟ أَبْوَٰبَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۖ فَلَبِئْسَ مَثْوَى ٱلْمُتَكَبِّرِينَ ", "translation": "So enter the gates of Hell to abide eternally therein, and how wretched is the residence of the arrogant.", "words": [{"id": 1, "arabic": "فَٱدْخُلُوٓا۟", "translit": "۟āٓwُlُhkْdٱَf", "root": "دخل"}, {"id": 2, "arabic": "أَبْوَٰبَ", "translit": "َbَٰwْbَaʾ", "root": "بوب"}, {"id": 3, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 4, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 5, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 6, "arabic": "فَلَبِئْسَ", "translit": "َsْyʾِbَlَf", "root": "باس"}, {"id": 7, "arabic": "مَثْوَى", "translit": "àَwْhtَm", "root": "ثوي"}, {"id": 8, "arabic": "ٱلْمُتَكَبِّرِينَ", "translit": "َnyِrِّbَkَtُmْlٱ", "root": "كبر"}], "hasIhya": false}, {"ayah": 30, "text": "وَقِيلَ لِلَّذِينَ ٱتَّقَوْا۟ مَاذَآ أَنزَلَ رَبُّكُمْۚ قَالُوا۟ خَيْرًاۗ لِّلَّذِينَ أَحْسَنُوا۟ فِى هَٰذِهِ ٱلدُّنْيَا حَسَنَةٌۚ وَلَدَارُ ٱلْءَاخِرَةِ خَيْرٌۚ وَلَنِعْمَ دَارُ ٱلْمُتَّقِينَ ", "translation": "And it will be said to those who feared Allāh, \"What did your Lord send down?\" They will say, \"[That which is] good.\" For those who do good in this world is good; and the home of the Hereafter is better. And how excellent is the home of the righteous -", "words": [{"id": 1, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 2, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 3, "arabic": "ٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱ", "root": "وقي"}, {"id": 4, "arabic": "مَاذَآ", "translit": "ٓāَhdāَm", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 7, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 8, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 9, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 10, "arabic": "أَحْسَنُوا۟", "translit": "۟āwُnَsْḥَaʾ", "root": "حسن"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 13, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 14, "arabic": "حَسَنَةٌ", "translit": "ٌẗَnَsَḥ", "root": "حسن"}, {"id": 15, "arabic": "وَلَدَارُ", "translit": "ُrāَdَlَw", "root": "دور"}, {"id": 16, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 17, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 18, "arabic": "وَلَنِعْمَ", "translit": "َmْʿعِnَlَw", "root": "نعم"}, {"id": 19, "arabic": "دَارُ", "translit": "ُrāَd", "root": "دور"}, {"id": 20, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 31, "text": "جَنَّٰتُ عَدْنٍ يَدْخُلُونَهَا تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۖ لَهُمْ فِيهَا مَا يَشَآءُونَۚ كَذَٰلِكَ يَجْزِى ٱللَّهُ ٱلْمُتَّقِينَ ", "translation": "Gardens of perpetual residence, which they will enter, beneath which rivers flow. They will have therein whatever they wish. Thus does Allāh reward the righteous -", "words": [{"id": 1, "arabic": "جَنَّٰتُ", "translit": "ُtَّٰnَjg", "root": "جنن"}, {"id": 2, "arabic": "عَدْنٍ", "translit": "ٍnْdَʿع", "root": ""}, {"id": 3, "arabic": "يَدْخُلُونَهَا", "translit": "āَhَnwُlُhkْdَy", "root": "دخل"}, {"id": 4, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 7, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 8, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "يَشَآءُونَ", "translit": "َnwُءٓāَhsَy", "root": "شيا"}, {"id": 12, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 13, "arabic": "يَجْزِى", "translit": "àِzْjgَy", "root": "جزي"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 32, "text": "ٱلَّذِينَ تَتَوَفَّىٰهُمُ ٱلْمَلَٰٓئِكَةُ طَيِّبِينَۙ يَقُولُونَ سَلَٰمٌ عَلَيْكُمُ ٱدْخُلُوا۟ ٱلْجَنَّةَ بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "The ones whom the angels take in death, [being] good and pure; [the angels] will say, \"Peace be upon you. Enter Paradise for what you used to do.\"", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "تَتَوَفَّىٰهُمُ", "translit": "ُmُhٰàَّfَwَtَt", "root": "وفي"}, {"id": 3, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 4, "arabic": "طَيِّبِينَ", "translit": "َnyِbِّyَṭ", "root": "طيب"}, {"id": 5, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 6, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 7, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 9, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 12, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 33, "text": "هَلْ يَنظُرُونَ إِلَّآ أَن تَأْتِيَهُمُ ٱلْمَلَٰٓئِكَةُ أَوْ يَأْتِىَ أَمْرُ رَبِّكَۚ كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبْلِهِمْۚ وَمَا ظَلَمَهُمُ ٱللَّهُ وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ", "translation": "Do they [i.e., the disbelievers] await except that the angels should come to them or there comes the command of your Lord? Thus did those do before them. And Allāh wronged them not, but they had been wronging themselves.", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تَأْتِيَهُمُ", "translit": "ُmُhَyِtْaʾَt", "root": "اتي"}, {"id": 6, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "يَأْتِىَ", "translit": "َàِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 10, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 11, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 12, "arabic": "فَعَلَ", "translit": "َlَʿعَf", "root": "فعل"}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "ظَلَمَهُمُ", "translit": "ُmُhَmَlَẓ", "root": "ظلم"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 20, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 21, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 22, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": true}, {"ayah": 34, "text": "فَأَصَابَهُمْ سَيِّـَٔاتُ مَا عَمِلُوا۟ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "So they were struck by the evil consequences of what they did and were enveloped by what they used to ridicule.", "words": [{"id": 1, "arabic": "فَأَصَابَهُمْ", "translit": "ْmُhَbāَṣَaʾَf", "root": "صوب"}, {"id": 2, "arabic": "سَيِّـَٔاتُ", "translit": "ُtāَٔـِّyَs", "root": "سوا"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 5, "arabic": "وَحَاقَ", "translit": "َqāَḥَw", "root": "حيق"}, {"id": 6, "arabic": "بِهِم", "translit": "mِhِb", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 35, "text": "وَقَالَ ٱلَّذِينَ أَشْرَكُوا۟ لَوْ شَآءَ ٱللَّهُ مَا عَبَدْنَا مِن دُونِهِۦ مِن شَىْءٍ نَّحْنُ وَلَآ ءَابَآؤُنَا وَلَا حَرَّمْنَا مِن دُونِهِۦ مِن شَىْءٍۚ كَذَٰلِكَ فَعَلَ ٱلَّذِينَ مِن قَبْلِهِمْۚ فَهَلْ عَلَى ٱلرُّسُلِ إِلَّا ٱلْبَلَٰغُ ٱلْمُبِينُ ", "translation": "And those who associate others with Allāh say, \"If Allāh had willed, we would not have worshipped anything other than Him, neither we nor our fathers, nor would we have forbidden anything through other than Him.\" Thus did those do before them. So is there upon the messengers except [the duty of] clear notification?", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 4, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 5, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "عَبَدْنَا", "translit": "āَnْdَbَʿع", "root": "عبد"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "نَّحْنُ", "translit": "ُnْḥَّn", "root": ""}, {"id": 14, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 15, "arabic": "ءَابَآؤُنَا", "translit": "āَnُwʾٓāَbāَء", "root": "ابو"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "حَرَّمْنَا", "translit": "āَnْmَّrَḥ", "root": "حرم"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 21, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 22, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 23, "arabic": "فَعَلَ", "translit": "َlَʿعَf", "root": "فعل"}, {"id": 24, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 25, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 26, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 27, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 28, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 29, "arabic": "ٱلرُّسُلِ", "translit": "ِlُsُّrlٱ", "root": "رسل"}, {"id": 30, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 31, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 32, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 36, "text": "وَلَقَدْ بَعَثْنَا فِى كُلِّ أُمَّةٍ رَّسُولًا أَنِ ٱعْبُدُوا۟ ٱللَّهَ وَٱجْتَنِبُوا۟ ٱلطَّٰغُوتَۖ فَمِنْهُم مَّنْ هَدَى ٱللَّهُ وَمِنْهُم مَّنْ حَقَّتْ عَلَيْهِ ٱلضَّلَٰلَةُۚ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ ", "translation": "And We certainly sent into every nation a messenger, [saying], \"Worship Allāh and avoid ṭāghūt.\"[1] And among them were those whom Allāh guided, and among them were those upon whom error was [deservedly] decreed. So proceed [i.e., travel] through the earth and observe how was the end of the deniers.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "بَعَثْنَا", "translit": "āَnْhtَʿعَb", "root": "بعث"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "رَّسُولًا", "translit": "āًlwُsَّr", "root": "رسل"}, {"id": 7, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 8, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَٱجْتَنِبُوا۟", "translit": "۟āwُbِnَtْjgٱَw", "root": "جنب"}, {"id": 11, "arabic": "ٱلطَّٰغُوتَ", "translit": "َtwُغَّٰṭlٱ", "root": "طغي"}, {"id": 12, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 13, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 14, "arabic": "هَدَى", "translit": "àَdَh", "root": "هدي"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 17, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 18, "arabic": "حَقَّتْ", "translit": "ْtَّqَḥ", "root": "حقق"}, {"id": 19, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 20, "arabic": "ٱلضَّلَٰلَةُ", "translit": "ُẗَlَٰlَّḍlٱ", "root": "ضلل"}, {"id": 21, "arabic": "فَسِيرُوا۟", "translit": "۟āwُryِsَf", "root": "سير"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 24, "arabic": "فَٱنظُرُوا۟", "translit": "۟āwُrُẓnٱَf", "root": "نظر"}, {"id": 25, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 26, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 27, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 28, "arabic": "ٱلْمُكَذِّبِينَ", "translit": "َnyِbِّhdَkُmْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 37, "text": "إِن تَحْرِصْ عَلَىٰ هُدَىٰهُمْ فَإِنَّ ٱللَّهَ لَا يَهْدِى مَن يُضِلُّۖ وَمَا لَهُم مِّن نَّٰصِرِينَ ", "translation": "[Even] if you should strive for their guidance, [O Muḥammad], indeed, Allāh does not guide those He sends astray,[1] and they will have no helpers.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "تَحْرِصْ", "translit": "ْṣِrْḥَt", "root": "حرص"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "هُدَىٰهُمْ", "translit": "ْmُhٰàَdُh", "root": "هدي"}, {"id": 5, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "يُضِلُّ", "translit": "ُّlِḍُy", "root": "ضلل"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "نَّٰصِرِينَ", "translit": "َnyِrِṣَّٰn", "root": "نصر"}], "hasIhya": false}, {"ayah": 38, "text": "وَأَقْسَمُوا۟ بِٱللَّهِ جَهْدَ أَيْمَٰنِهِمْۙ لَا يَبْعَثُ ٱللَّهُ مَن يَمُوتُۚ بَلَىٰ وَعْدًا عَلَيْهِ حَقًّا وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ", "translation": "And they swear by Allāh their strongest oaths [that] Allāh will not resurrect one who dies. But yes - [it is] a true promise [binding] upon Him, but most of the people do not know.", "words": [{"id": 1, "arabic": "وَأَقْسَمُوا۟", "translit": "۟āwُmَsْqَaʾَw", "root": "قسم"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "جَهْدَ", "translit": "َdْhَjg", "root": "جهد"}, {"id": 4, "arabic": "أَيْمَٰنِهِمْ", "translit": "ْmِhِnَٰmْyَaʾ", "root": "يمن"}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَبْعَثُ", "translit": "ُhtَʿعْbَy", "root": "بعث"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 9, "arabic": "يَمُوتُ", "translit": "ُtwُmَy", "root": "موت"}, {"id": 10, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 11, "arabic": "وَعْدًا", "translit": "āًdْʿعَw", "root": "وعد"}, {"id": 12, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 14, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 15, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 16, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 39, "text": "لِيُبَيِّنَ لَهُمُ ٱلَّذِى يَخْتَلِفُونَ فِيهِ وَلِيَعْلَمَ ٱلَّذِينَ كَفَرُوٓا۟ أَنَّهُمْ كَانُوا۟ كَٰذِبِينَ ", "translation": "[It is] so He will make clear to them [the truth of] that wherein they differ and so those who have disbelieved may know that they were liars.", "words": [{"id": 1, "arabic": "لِيُبَيِّنَ", "translit": "َnِّyَbُyِl", "root": "بين"}, {"id": 2, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}, {"id": 5, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 6, "arabic": "وَلِيَعْلَمَ", "translit": "َmَlْʿعَyِlَw", "root": "علم"}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 9, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 10, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 11, "arabic": "كَٰذِبِينَ", "translit": "َnyِbِhdَٰk", "root": "كذب"}], "hasIhya": false}, {"ayah": 40, "text": "إِنَّمَا قَوْلُنَا لِشَىْءٍ إِذَآ أَرَدْنَٰهُ أَن نَّقُولَ لَهُۥ كُن فَيَكُونُ ", "translation": "Indeed, Our word to a thing when We intend it is but that We say to it, \"Be,\" and it is.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "قَوْلُنَا", "translit": "āَnُlْwَq", "root": "قول"}, {"id": 3, "arabic": "لِشَىْءٍ", "translit": "ٍءْàَhsِl", "root": "شيا"}, {"id": 4, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 5, "arabic": "أَرَدْنَٰهُ", "translit": "ُhَٰnْdَrَaʾ", "root": "رود"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "نَّقُولَ", "translit": "َlwُqَّn", "root": "قول"}, {"id": 8, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 9, "arabic": "كُن", "translit": "nُk", "root": "كون"}, {"id": 10, "arabic": "فَيَكُونُ", "translit": "ُnwُkَyَf", "root": "كون"}], "hasIhya": true}, {"ayah": 41, "text": "وَٱلَّذِينَ هَاجَرُوا۟ فِى ٱللَّهِ مِنۢ بَعْدِ مَا ظُلِمُوا۟ لَنُبَوِّئَنَّهُمْ فِى ٱلدُّنْيَا حَسَنَةًۖ وَلَأَجْرُ ٱلْءَاخِرَةِ أَكْبَرُۚ لَوْ كَانُوا۟ يَعْلَمُونَ ", "translation": "And those who emigrated for [the cause of] Allāh after they had been wronged - We will surely settle them in this world in a good place; but the reward of the Hereafter is greater, if only they could know.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "هَاجَرُوا۟", "translit": "۟āwُrَjgāَh", "root": "هجر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "ظُلِمُوا۟", "translit": "۟āwُmِlُẓ", "root": "ظلم"}, {"id": 9, "arabic": "لَنُبَوِّئَنَّهُمْ", "translit": "ْmُhَّnَyʾِّwَbُnَl", "root": "بوا"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 12, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 13, "arabic": "وَلَأَجْرُ", "translit": "ُrْjgَaʾَlَw", "root": "اجر"}, {"id": 14, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 15, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 16, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 42, "text": "ٱلَّذِينَ صَبَرُوا۟ وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ ", "translation": "[They are] those who endured patiently and upon their Lord relied.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "صَبَرُوا۟", "translit": "۟āwُrَbَṣ", "root": "صبر"}, {"id": 3, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 4, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 5, "arabic": "يَتَوَكَّلُونَ", "translit": "َnwُlَّkَwَtَy", "root": "وكل"}], "hasIhya": true}, {"ayah": 43, "text": "وَمَآ أَرْسَلْنَا مِن قَبْلِكَ إِلَّا رِجَالًا نُّوحِىٓ إِلَيْهِمْۚ فَسْـَٔلُوٓا۟ أَهْلَ ٱلذِّكْرِ إِن كُنتُمْ لَا تَعْلَمُونَ ", "translation": "And We sent not before you except men to whom We revealed [Our message]. So ask the people of the message [i.e., former scriptures] if you do not know.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "رِجَالًا", "translit": "āًlāَjgِr", "root": "رجل"}, {"id": 7, "arabic": "نُّوحِىٓ", "translit": "ٓàِḥwُّn", "root": "وحي"}, {"id": 8, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "فَسْـَٔلُوٓا۟", "translit": "۟āٓwُlَٔـْsَf", "root": "سال"}, {"id": 10, "arabic": "أَهْلَ", "translit": "َlْhَaʾ", "root": "اهل"}, {"id": 11, "arabic": "ٱلذِّكْرِ", "translit": "ِrْkِّhdlٱ", "root": "ذكر"}, {"id": 12, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 44, "text": "بِٱلْبَيِّنَٰتِ وَٱلزُّبُرِۗ وَأَنزَلْنَآ إِلَيْكَ ٱلذِّكْرَ لِتُبَيِّنَ لِلنَّاسِ مَا نُزِّلَ إِلَيْهِمْ وَلَعَلَّهُمْ يَتَفَكَّرُونَ ", "translation": "[We sent them] with clear proofs and written ordinances. And We revealed to you the message [i.e., the Qur’ān] that you may make clear to the people what was sent down to them and that they might give thought.", "words": [{"id": 1, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 2, "arabic": "وَٱلزُّبُرِ", "translit": "ِrُbُّzlٱَw", "root": "زبر"}, {"id": 3, "arabic": "وَأَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾَw", "root": "نزل"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلذِّكْرَ", "translit": "َrْkِّhdlٱ", "root": "ذكر"}, {"id": 6, "arabic": "لِتُبَيِّنَ", "translit": "َnِّyَbُtِl", "root": "بين"}, {"id": 7, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "نُزِّلَ", "translit": "َlِّzُn", "root": "نزل"}, {"id": 10, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 11, "arabic": "وَلَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَlَw", "root": ""}, {"id": 12, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": true}, {"ayah": 45, "text": "أَفَأَمِنَ ٱلَّذِينَ مَكَرُوا۟ ٱلسَّيِّـَٔاتِ أَن يَخْسِفَ ٱللَّهُ بِهِمُ ٱلْأَرْضَ أَوْ يَأْتِيَهُمُ ٱلْعَذَابُ مِنْ حَيْثُ لَا يَشْعُرُونَ ", "translation": "Then, do those who have planned evil deeds feel secure that Allāh will not cause the earth to swallow them or that the punishment will not come upon them from where they do not perceive?", "words": [{"id": 1, "arabic": "أَفَأَمِنَ", "translit": "َnِmَaʾَfَaʾ", "root": "امن"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "مَكَرُوا۟", "translit": "۟āwُrَkَm", "root": "مكر"}, {"id": 4, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يَخْسِفَ", "translit": "َfِsْhkَy", "root": "خسف"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "بِهِمُ", "translit": "ُmِhِb", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "يَأْتِيَهُمُ", "translit": "ُmُhَyِtْaʾَy", "root": "اتي"}, {"id": 12, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 46, "text": "أَوْ يَأْخُذَهُمْ فِى تَقَلُّبِهِمْ فَمَا هُم بِمُعْجِزِينَ ", "translation": "Or that He would not seize them during their [usual] activity, and they could not cause failure [i.e., escape from Him]?", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "يَأْخُذَهُمْ", "translit": "ْmُhَhdُhkْaʾَy", "root": "اخذ"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "تَقَلُّبِهِمْ", "translit": "ْmِhِbُّlَqَt", "root": "قلب"}, {"id": 5, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 6, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 7, "arabic": "بِمُعْجِزِينَ", "translit": "َnyِzِjgْʿعُmِb", "root": "عجز"}], "hasIhya": false}, {"ayah": 47, "text": "أَوْ يَأْخُذَهُمْ عَلَىٰ تَخَوُّفٍ فَإِنَّ رَبَّكُمْ لَرَءُوفٌ رَّحِيمٌ ", "translation": "Or that He would not seize them gradually [in a state of dread]?[1] But indeed, your Lord is Kind and Merciful.[2]", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "يَأْخُذَهُمْ", "translit": "ْmُhَhdُhkْaʾَy", "root": "اخذ"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "تَخَوُّفٍ", "translit": "ٍfُّwَhkَt", "root": "خوف"}, {"id": 5, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 6, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 7, "arabic": "لَرَءُوفٌ", "translit": "ٌfwُءَrَl", "root": "راف"}, {"id": 8, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 48, "text": "أَوَلَمْ يَرَوْا۟ إِلَىٰ مَا خَلَقَ ٱللَّهُ مِن شَىْءٍ يَتَفَيَّؤُا۟ ظِلَٰلُهُۥ عَنِ ٱلْيَمِينِ وَٱلشَّمَآئِلِ سُجَّدًا لِّلَّهِ وَهُمْ دَٰخِرُونَ ", "translation": "Have they not considered what things Allāh has created? Their shadows incline to the right and to the left, prostrating to Allāh, while they [i.e., those creations] are humble.", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "يَتَفَيَّؤُا۟", "translit": "۟āُwʾَّyَfَtَy", "root": "فيا"}, {"id": 10, "arabic": "ظِلَٰلُهُۥ", "translit": "ۥُhُlَٰlِẓ", "root": "ظلل"}, {"id": 11, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 12, "arabic": "ٱلْيَمِينِ", "translit": "ِnyِmَyْlٱ", "root": "يمن"}, {"id": 13, "arabic": "وَٱلشَّمَآئِلِ", "translit": "ِlِyʾٓāَmَّhslٱَw", "root": "شمل"}, {"id": 14, "arabic": "سُجَّدًا", "translit": "āًdَّjgُs", "root": "سجد"}, {"id": 15, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 16, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 17, "arabic": "دَٰخِرُونَ", "translit": "َnwُrِhkَٰd", "root": "دخر"}], "hasIhya": false}, {"ayah": 49, "text": "وَلِلَّهِ يَسْجُدُ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِ مِن دَآبَّةٍ وَٱلْمَلَٰٓئِكَةُ وَهُمْ لَا يَسْتَكْبِرُونَ ", "translation": "And to Allāh prostrates whatever is in the heavens and whatever is on the earth of creatures, and the angels [as well], and they are not arrogant.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "يَسْجُدُ", "translit": "ُdُjgْsَy", "root": "سجد"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 11, "arabic": "وَٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱَw", "root": "ملك"}, {"id": 12, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يَسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsَy", "root": "كبر"}], "hasIhya": false}, {"ayah": 50, "text": "يَخَافُونَ رَبَّهُم مِّن فَوْقِهِمْ وَيَفْعَلُونَ مَا يُؤْمَرُونَ۩ ", "translation": "They fear their Lord above them, and they do what they are commanded.", "words": [{"id": 1, "arabic": "يَخَافُونَ", "translit": "َnwُfāَhkَy", "root": "خوف"}, {"id": 2, "arabic": "رَبَّهُم", "translit": "mُhَّbَr", "root": "ربب"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "فَوْقِهِمْ", "translit": "ْmِhِqْwَf", "root": "فوق"}, {"id": 5, "arabic": "وَيَفْعَلُونَ", "translit": "َnwُlَʿعْfَyَw", "root": "فعل"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "يُؤْمَرُونَ", "translit": "َnwُrَmْwʾُy", "root": "امر"}], "hasIhya": false}, {"ayah": 51, "text": "وَقَالَ ٱللَّهُ لَا تَتَّخِذُوٓا۟ إِلَٰهَيْنِ ٱثْنَيْنِۖ إِنَّمَا هُوَ إِلَٰهٌ وَٰحِدٌۖ فَإِيَّٰىَ فَٱرْهَبُونِ ", "translation": "And Allāh has said, \"Do not take for yourselves two[1] deities. He [i.e., Allāh] is but one God, so fear only Me.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "تَتَّخِذُوٓا۟", "translit": "۟āٓwُhdِhkَّtَt", "root": "اخذ"}, {"id": 5, "arabic": "إِلَٰهَيْنِ", "translit": "ِnْyَhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "ٱثْنَيْنِ", "translit": "ِnْyَnْhtٱ", "root": "ثني"}, {"id": 7, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 8, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 9, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 10, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 11, "arabic": "فَإِيَّٰىَ", "translit": "َàَّٰyِiʾَf", "root": ""}, {"id": 12, "arabic": "فَٱرْهَبُونِ", "translit": "ِnwُbَhْrٱَf", "root": "رهب"}], "hasIhya": false}, {"ayah": 52, "text": "وَلَهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَلَهُ ٱلدِّينُ وَاصِبًاۚ أَفَغَيْرَ ٱللَّهِ تَتَّقُونَ ", "translation": "And to Him belongs whatever is in the heavens and the earth, and to Him is [due] worship constantly. Then is it other than Allāh that you fear?", "words": [{"id": 1, "arabic": "وَلَهُۥ", "translit": "ۥُhَlَw", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَلَهُ", "translit": "ُhَlَw", "root": ""}, {"id": 7, "arabic": "ٱلدِّينُ", "translit": "ُnyِّdlٱ", "root": "دين"}, {"id": 8, "arabic": "وَاصِبًا", "translit": "āًbِṣāَw", "root": "وصب"}, {"id": 9, "arabic": "أَفَغَيْرَ", "translit": "َrْyَغَfَaʾ", "root": "غير"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": true}, {"ayah": 53, "text": "وَمَا بِكُم مِّن نِّعْمَةٍ فَمِنَ ٱللَّهِۖ ثُمَّ إِذَا مَسَّكُمُ ٱلضُّرُّ فَإِلَيْهِ تَجْـَٔرُونَ ", "translation": "And whatever you have of favor - it is from Allāh. Then when adversity touches you, to Him you cry for help.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "بِكُم", "translit": "mُkِb", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "نِّعْمَةٍ", "translit": "ٍẗَmْʿعِّn", "root": "نعم"}, {"id": 5, "arabic": "فَمِنَ", "translit": "َnِmَf", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 9, "arabic": "مَسَّكُمُ", "translit": "ُmُkَّsَm", "root": "مسس"}, {"id": 10, "arabic": "ٱلضُّرُّ", "translit": "ُّrُّḍlٱ", "root": "ضرر"}, {"id": 11, "arabic": "فَإِلَيْهِ", "translit": "ِhْyَlِiʾَf", "root": ""}, {"id": 12, "arabic": "تَجْـَٔرُونَ", "translit": "َnwُrَٔـْjgَt", "root": "جار"}], "hasIhya": false}, {"ayah": 54, "text": "ثُمَّ إِذَا كَشَفَ ٱلضُّرَّ عَنكُمْ إِذَا فَرِيقٌ مِّنكُم بِرَبِّهِمْ يُشْرِكُونَ ", "translation": "Then when He removes the adversity from you, at once a party of you associates others with their Lord", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "كَشَفَ", "translit": "َfَhsَk", "root": "كشف"}, {"id": 4, "arabic": "ٱلضُّرَّ", "translit": "َّrُّḍlٱ", "root": "ضرر"}, {"id": 5, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 6, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 7, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 8, "arabic": "مِّنكُم", "translit": "mُknِّm", "root": ""}, {"id": 9, "arabic": "بِرَبِّهِمْ", "translit": "ْmِhِّbَrِb", "root": "ربب"}, {"id": 10, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 55, "text": "لِيَكْفُرُوا۟ بِمَآ ءَاتَيْنَٰهُمْۚ فَتَمَتَّعُوا۟ۖ فَسَوْفَ تَعْلَمُونَ ", "translation": "So they will deny what We have given them. Then enjoy yourselves, for you are going to know.", "words": [{"id": 1, "arabic": "لِيَكْفُرُوا۟", "translit": "۟āwُrُfْkَyِl", "root": "كفر"}, {"id": 2, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 3, "arabic": "ءَاتَيْنَٰهُمْ", "translit": "ْmُhَٰnْyَtāَء", "root": "اتي"}, {"id": 4, "arabic": "فَتَمَتَّعُوا۟", "translit": "۟āwُʿعَّtَmَtَf", "root": "متع"}, {"id": 5, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 6, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 56, "text": "وَيَجْعَلُونَ لِمَا لَا يَعْلَمُونَ نَصِيبًا مِّمَّا رَزَقْنَٰهُمْۗ تَٱللَّهِ لَتُسْـَٔلُنَّ عَمَّا كُنتُمْ تَفْتَرُونَ ", "translation": "And they assign to what they do not know[1] [i.e., false deities] a portion of that which We have provided them. By Allāh, you will surely be questioned about what you used to invent.", "words": [{"id": 1, "arabic": "وَيَجْعَلُونَ", "translit": "َnwُlَʿعْjgَyَw", "root": "جعل"}, {"id": 2, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}, {"id": 5, "arabic": "نَصِيبًا", "translit": "āًbyِṣَn", "root": "نصب"}, {"id": 6, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 7, "arabic": "رَزَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَzَr", "root": "رزق"}, {"id": 8, "arabic": "تَٱللَّهِ", "translit": "ِhَّllٱَt", "root": "اله"}, {"id": 9, "arabic": "لَتُسْـَٔلُنَّ", "translit": "َّnُlَٔـْsُtَl", "root": "سال"}, {"id": 10, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 11, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 12, "arabic": "تَفْتَرُونَ", "translit": "َnwُrَtْfَt", "root": "فري"}], "hasIhya": false}, {"ayah": 57, "text": "وَيَجْعَلُونَ لِلَّهِ ٱلْبَنَٰتِ سُبْحَٰنَهُۥۙ وَلَهُم مَّا يَشْتَهُونَ ", "translation": "And they attribute to Allāh daughters[1] - exalted is He - and for them is what they desire [i.e., sons].", "words": [{"id": 1, "arabic": "وَيَجْعَلُونَ", "translit": "َnwُlَʿعْjgَyَw", "root": "جعل"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "ٱلْبَنَٰتِ", "translit": "ِtَٰnَbْlٱ", "root": "بني"}, {"id": 4, "arabic": "سُبْحَٰنَهُۥ", "translit": "ۥُhَnَٰḥْbُs", "root": "سبح"}, {"id": 5, "arabic": "وَلَهُم", "translit": "mُhَlَw", "root": ""}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "يَشْتَهُونَ", "translit": "َnwُhَtْhsَy", "root": "شهو"}], "hasIhya": false}, {"ayah": 58, "text": "وَإِذَا بُشِّرَ أَحَدُهُم بِٱلْأُنثَىٰ ظَلَّ وَجْهُهُۥ مُسْوَدًّا وَهُوَ كَظِيمٌ ", "translation": "And when one of them is informed of [the birth of] a female, his face becomes dark, and he suppresses grief.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "بُشِّرَ", "translit": "َrِّhsُb", "root": "بشر"}, {"id": 3, "arabic": "أَحَدُهُم", "translit": "mُhُdَḥَaʾ", "root": "احد"}, {"id": 4, "arabic": "بِٱلْأُنثَىٰ", "translit": "ٰàَhtnُaʾْlٱِb", "root": "انث"}, {"id": 5, "arabic": "ظَلَّ", "translit": "َّlَẓ", "root": "ظلل"}, {"id": 6, "arabic": "وَجْهُهُۥ", "translit": "ۥُhُhْjgَw", "root": "وجه"}, {"id": 7, "arabic": "مُسْوَدًّا", "translit": "āًّdَwْsُm", "root": "سود"}, {"id": 8, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 9, "arabic": "كَظِيمٌ", "translit": "ٌmyِẓَk", "root": "كظم"}], "hasIhya": false}, {"ayah": 59, "text": "يَتَوَٰرَىٰ مِنَ ٱلْقَوْمِ مِن سُوٓءِ مَا بُشِّرَ بِهِۦٓۚ أَيُمْسِكُهُۥ عَلَىٰ هُونٍ أَمْ يَدُسُّهُۥ فِى ٱلتُّرَابِۗ أَلَا سَآءَ مَا يَحْكُمُونَ ", "translation": "He hides himself from the people because of the ill of which he has been informed. Should he keep it in humiliation or bury it in the ground? Unquestionably, evil is what they decide.", "words": [{"id": 1, "arabic": "يَتَوَٰرَىٰ", "translit": "ٰàَrَٰwَtَy", "root": "وري"}, {"id": 2, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 3, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "سُوٓءِ", "translit": "ِءٓwُs", "root": "سوا"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "بُشِّرَ", "translit": "َrِّhsُb", "root": "بشر"}, {"id": 8, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 9, "arabic": "أَيُمْسِكُهُۥ", "translit": "ۥُhُkِsْmُyَaʾ", "root": "مسك"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "هُونٍ", "translit": "ٍnwُh", "root": "هون"}, {"id": 12, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 13, "arabic": "يَدُسُّهُۥ", "translit": "ۥُhُّsُdَy", "root": "دسس"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ٱلتُّرَابِ", "translit": "ِbāَrُّtlٱ", "root": "ترب"}, {"id": 16, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 17, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "يَحْكُمُونَ", "translit": "َnwُmُkْḥَy", "root": "حكم"}], "hasIhya": false}, {"ayah": 60, "text": "لِلَّذِينَ لَا يُؤْمِنُونَ بِٱلْءَاخِرَةِ مَثَلُ ٱلسَّوْءِۖ وَلِلَّهِ ٱلْمَثَلُ ٱلْأَعْلَىٰۚ وَهُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "For those who do not believe in the Hereafter is the description [i.e., an attribute] of evil;[1] and for Allāh is the highest attribute. And He is Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 4, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 5, "arabic": "مَثَلُ", "translit": "ُlَhtَm", "root": "مثل"}, {"id": 6, "arabic": "ٱلسَّوْءِ", "translit": "ِءْwَّslٱ", "root": "سوا"}, {"id": 7, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 8, "arabic": "ٱلْمَثَلُ", "translit": "ُlَhtَmْlٱ", "root": "مثل"}, {"id": 9, "arabic": "ٱلْأَعْلَىٰ", "translit": "ٰàَlْʿعَaʾْlٱ", "root": "علو"}, {"id": 10, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 11, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 12, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 61, "text": "وَلَوْ يُؤَاخِذُ ٱللَّهُ ٱلنَّاسَ بِظُلْمِهِم مَّا تَرَكَ عَلَيْهَا مِن دَآبَّةٍ وَلَٰكِن يُؤَخِّرُهُمْ إِلَىٰٓ أَجَلٍ مُّسَمًّىۖ فَإِذَا جَآءَ أَجَلُهُمْ لَا يَسْتَـْٔخِرُونَ سَاعَةًۖ وَلَا يَسْتَقْدِمُونَ ", "translation": "And if Allāh were to impose blame on the people for their wrongdoing, He would not have left upon it [i.e., the earth] any creature, but He defers them for a specified term. And when their term has come, they will not remain behind an hour, nor will they precede [it].", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "يُؤَاخِذُ", "translit": "ُhdِhkāَwʾُy", "root": "اخذ"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "بِظُلْمِهِم", "translit": "mِhِmْlُẓِb", "root": "ظلم"}, {"id": 6, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 7, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 8, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 11, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 12, "arabic": "يُؤَخِّرُهُمْ", "translit": "ْmُhُrِّhkَwʾُy", "root": "اخر"}, {"id": 13, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 14, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 15, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 16, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 17, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 18, "arabic": "أَجَلُهُمْ", "translit": "ْmُhُlَjgَaʾ", "root": "اجل"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَسْتَـْٔخِرُونَ", "translit": "َnwُrِhkْٔـَtْsَy", "root": "اخر"}, {"id": 21, "arabic": "سَاعَةً", "translit": "ًẗَʿعāَs", "root": "سوع"}, {"id": 22, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 23, "arabic": "يَسْتَقْدِمُونَ", "translit": "َnwُmِdْqَtْsَy", "root": "قدم"}], "hasIhya": false}, {"ayah": 62, "text": "وَيَجْعَلُونَ لِلَّهِ مَا يَكْرَهُونَ وَتَصِفُ أَلْسِنَتُهُمُ ٱلْكَذِبَ أَنَّ لَهُمُ ٱلْحُسْنَىٰۖ لَا جَرَمَ أَنَّ لَهُمُ ٱلنَّارَ وَأَنَّهُم مُّفْرَطُونَ ", "translation": "And they attribute to Allāh that which they dislike [i.e., daughters], and their tongues assert the lie that they will have the best [from Him]. Assuredly, they will have the Fire, and they will be [therein] neglected.[1]", "words": [{"id": 1, "arabic": "وَيَجْعَلُونَ", "translit": "َnwُlَʿعْjgَyَw", "root": "جعل"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَكْرَهُونَ", "translit": "َnwُhَrْkَy", "root": "كره"}, {"id": 5, "arabic": "وَتَصِفُ", "translit": "ُfِṣَtَw", "root": "وصف"}, {"id": 6, "arabic": "أَلْسِنَتُهُمُ", "translit": "ُmُhُtَnِsْlَaʾ", "root": "لسن"}, {"id": 7, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 8, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 9, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 10, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "جَرَمَ", "translit": "َmَrَjg", "root": "جرم"}, {"id": 13, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 14, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 15, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 16, "arabic": "وَأَنَّهُم", "translit": "mُhَّnَaʾَw", "root": ""}, {"id": 17, "arabic": "مُّفْرَطُونَ", "translit": "َnwُṭَrْfُّm", "root": "فرط"}], "hasIhya": true}, {"ayah": 63, "text": "تَٱللَّهِ لَقَدْ أَرْسَلْنَآ إِلَىٰٓ أُمَمٍ مِّن قَبْلِكَ فَزَيَّنَ لَهُمُ ٱلشَّيْطَٰنُ أَعْمَٰلَهُمْ فَهُوَ وَلِيُّهُمُ ٱلْيَوْمَ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "By Allāh, We did certainly send [messengers] to nations before you, but Satan made their deeds attractive to them. And he is their [i.e., the disbelievers] ally today [as well], and they will have a painful punishment.", "words": [{"id": 1, "arabic": "تَٱللَّهِ", "translit": "ِhَّllٱَt", "root": "اله"}, {"id": 2, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 3, "arabic": "أَرْسَلْنَآ", "translit": "ٓāَnْlَsْrَaʾ", "root": "رسل"}, {"id": 4, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 5, "arabic": "أُمَمٍ", "translit": "ٍmَmُaʾ", "root": "امم"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 8, "arabic": "فَزَيَّنَ", "translit": "َnَّyَzَf", "root": "زين"}, {"id": 9, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 10, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 11, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 12, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 13, "arabic": "وَلِيُّهُمُ", "translit": "ُmُhُّyِlَw", "root": "ولي"}, {"id": 14, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 15, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 16, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 17, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 64, "text": "وَمَآ أَنزَلْنَا عَلَيْكَ ٱلْكِتَٰبَ إِلَّا لِتُبَيِّنَ لَهُمُ ٱلَّذِى ٱخْتَلَفُوا۟ فِيهِۙ وَهُدًى وَرَحْمَةً لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "And We have not revealed to you the Book, [O Muḥammad], except for you to make clear to them that wherein they have differed and as guidance and mercy for a people who believe.", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "لِتُبَيِّنَ", "translit": "َnِّyَbُtِl", "root": "بين"}, {"id": 7, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 8, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 10, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 11, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 12, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 13, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 14, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 65, "text": "وَٱللَّهُ أَنزَلَ مِنَ ٱلسَّمَآءِ مَآءً فَأَحْيَا بِهِ ٱلْأَرْضَ بَعْدَ مَوْتِهَآۚ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَسْمَعُونَ ", "translation": "And Allāh has sent down rain from the sky and given life thereby to the earth after its lifelessness. Indeed in that is a sign for a people who listen.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 6, "arabic": "فَأَحْيَا", "translit": "āَyْḥَaʾَf", "root": "حيي"}, {"id": 7, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "مَوْتِهَآ", "translit": "ٓāَhِtْwَm", "root": "موت"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 14, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 15, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 16, "arabic": "يَسْمَعُونَ", "translit": "َnwُʿعَmْsَy", "root": "سمع"}], "hasIhya": false}, {"ayah": 66, "text": "وَإِنَّ لَكُمْ فِى ٱلْأَنْعَٰمِ لَعِبْرَةًۖ نُّسْقِيكُم مِّمَّا فِى بُطُونِهِۦ مِنۢ بَيْنِ فَرْثٍ وَدَمٍ لَّبَنًا خَالِصًا سَآئِغًا لِّلشَّٰرِبِينَ ", "translation": "And indeed, for you in grazing livestock is a lesson. We give you drink from what is in their bellies - between excretion and blood - pure milk, palatable to drinkers.", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 5, "arabic": "لَعِبْرَةً", "translit": "ًẗَrْbِʿعَl", "root": "عبر"}, {"id": 6, "arabic": "نُّسْقِيكُم", "translit": "mُkyِqْsُّn", "root": "سقي"}, {"id": 7, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "بُطُونِهِۦ", "translit": "ۦِhِnwُṭُb", "root": "بطن"}, {"id": 10, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 11, "arabic": "بَيْنِ", "translit": "ِnْyَb", "root": "بين"}, {"id": 12, "arabic": "فَرْثٍ", "translit": "ٍhtْrَf", "root": "فرث"}, {"id": 13, "arabic": "وَدَمٍ", "translit": "ٍmَdَw", "root": "دمو"}, {"id": 14, "arabic": "لَّبَنًا", "translit": "āًnَbَّl", "root": "لبن"}, {"id": 15, "arabic": "خَالِصًا", "translit": "āًṣِlāَhk", "root": "خلص"}, {"id": 16, "arabic": "سَآئِغًا", "translit": "āًغِyʾٓāَs", "root": "سوغ"}, {"id": 17, "arabic": "لِّلشَّٰرِبِينَ", "translit": "َnyِbِrَّٰhslِّl", "root": "شرب"}], "hasIhya": true}, {"ayah": 67, "text": "وَمِن ثَمَرَٰتِ ٱلنَّخِيلِ وَٱلْأَعْنَٰبِ تَتَّخِذُونَ مِنْهُ سَكَرًا وَرِزْقًا حَسَنًاۗ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَعْقِلُونَ ", "translation": "And from the fruits of the palm trees and grapevines you take intoxicant and good provision.[1] Indeed in that is a sign for a people who reason.", "words": [{"id": 1, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 2, "arabic": "ثَمَرَٰتِ", "translit": "ِtَٰrَmَht", "root": "ثمر"}, {"id": 3, "arabic": "ٱلنَّخِيلِ", "translit": "ِlyِhkَّnlٱ", "root": "نخل"}, {"id": 4, "arabic": "وَٱلْأَعْنَٰبِ", "translit": "ِbَٰnْʿعَaʾْlٱَw", "root": "عنب"}, {"id": 5, "arabic": "تَتَّخِذُونَ", "translit": "َnwُhdِhkَّtَt", "root": "اخذ"}, {"id": 6, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 7, "arabic": "سَكَرًا", "translit": "āًrَkَs", "root": "سكر"}, {"id": 8, "arabic": "وَرِزْقًا", "translit": "āًqْzِrَw", "root": "رزق"}, {"id": 9, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 14, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 15, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": false}, {"ayah": 68, "text": "وَأَوْحَىٰ رَبُّكَ إِلَى ٱلنَّحْلِ أَنِ ٱتَّخِذِى مِنَ ٱلْجِبَالِ بُيُوتًا وَمِنَ ٱلشَّجَرِ وَمِمَّا يَعْرِشُونَ ", "translation": "And your Lord inspired to the bee, \"Take for yourself among the mountains, houses [i.e., hives], and among the trees and [in] that which they construct.", "words": [{"id": 1, "arabic": "وَأَوْحَىٰ", "translit": "ٰàَḥْwَaʾَw", "root": "وحي"}, {"id": 2, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلنَّحْلِ", "translit": "ِlْḥَّnlٱ", "root": "نحل"}, {"id": 5, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 6, "arabic": "ٱتَّخِذِى", "translit": "àِhdِhkَّtٱ", "root": "اخذ"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلْجِبَالِ", "translit": "ِlāَbِjgْlٱ", "root": "جبل"}, {"id": 9, "arabic": "بُيُوتًا", "translit": "āًtwُyُb", "root": "بيت"}, {"id": 10, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 11, "arabic": "ٱلشَّجَرِ", "translit": "ِrَjgَّhslٱ", "root": "شجر"}, {"id": 12, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 13, "arabic": "يَعْرِشُونَ", "translit": "َnwُhsِrْʿعَy", "root": "عرش"}], "hasIhya": true}, {"ayah": 69, "text": "ثُمَّ كُلِى مِن كُلِّ ٱلثَّمَرَٰتِ فَٱسْلُكِى سُبُلَ رَبِّكِ ذُلُلًاۚ يَخْرُجُ مِنۢ بُطُونِهَا شَرَابٌ مُّخْتَلِفٌ أَلْوَٰنُهُۥ فِيهِ شِفَآءٌ لِّلنَّاسِۗ إِنَّ فِى ذَٰلِكَ لَءَايَةً لِّقَوْمٍ يَتَفَكَّرُونَ ", "translation": "Then eat from all the fruits[1] and follow the ways of your Lord laid down [for you].\" There emerges from their bellies a drink, varying in colors, in which there is healing for people. Indeed in that is a sign for a people who give thought.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "كُلِى", "translit": "àِlُk", "root": "اكل"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "ٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱ", "root": "ثمر"}, {"id": 6, "arabic": "فَٱسْلُكِى", "translit": "àِkُlْsٱَf", "root": "سلك"}, {"id": 7, "arabic": "سُبُلَ", "translit": "َlُbُs", "root": "سبل"}, {"id": 8, "arabic": "رَبِّكِ", "translit": "ِkِّbَr", "root": "ربب"}, {"id": 9, "arabic": "ذُلُلًا", "translit": "āًlُlُhd", "root": "ذلل"}, {"id": 10, "arabic": "يَخْرُجُ", "translit": "ُjgُrْhkَy", "root": "خرج"}, {"id": 11, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 12, "arabic": "بُطُونِهَا", "translit": "āَhِnwُṭُb", "root": "بطن"}, {"id": 13, "arabic": "شَرَابٌ", "translit": "ٌbāَrَhs", "root": "شرب"}, {"id": 14, "arabic": "مُّخْتَلِفٌ", "translit": "ٌfِlَtْhkُّm", "root": "خلف"}, {"id": 15, "arabic": "أَلْوَٰنُهُۥ", "translit": "ۥُhُnَٰwْlَaʾ", "root": "لون"}, {"id": 16, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 17, "arabic": "شِفَآءٌ", "translit": "ٌءٓāَfِhs", "root": "شفي"}, {"id": 18, "arabic": "لِّلنَّاسِ", "translit": "ِsāَّnlِّl", "root": "انس"}, {"id": 19, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 21, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 22, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 23, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 24, "arabic": "يَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَy", "root": "فكر"}], "hasIhya": false}, {"ayah": 70, "text": "وَٱللَّهُ خَلَقَكُمْ ثُمَّ يَتَوَفَّىٰكُمْۚ وَمِنكُم مَّن يُرَدُّ إِلَىٰٓ أَرْذَلِ ٱلْعُمُرِ لِكَىْ لَا يَعْلَمَ بَعْدَ عِلْمٍ شَيْـًٔاۚ إِنَّ ٱللَّهَ عَلِيمٌ قَدِيرٌ ", "translation": "And Allāh created you; then He will take you in death. And among you is he who is reversed to the most decrepit [old] age so that he will not know, after [having had] knowledge, a thing. Indeed, Allāh is Knowing and Competent.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "خَلَقَكُمْ", "translit": "ْmُkَqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 4, "arabic": "يَتَوَفَّىٰكُمْ", "translit": "ْmُkٰàَّfَwَtَy", "root": "وفي"}, {"id": 5, "arabic": "وَمِنكُم", "translit": "mُknِmَw", "root": ""}, {"id": 6, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 7, "arabic": "يُرَدُّ", "translit": "ُّdَrُy", "root": "ردد"}, {"id": 8, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 9, "arabic": "أَرْذَلِ", "translit": "ِlَhdْrَaʾ", "root": "رذل"}, {"id": 10, "arabic": "ٱلْعُمُرِ", "translit": "ِrُmُʿعْlٱ", "root": "عمر"}, {"id": 11, "arabic": "لِكَىْ", "translit": "ْàَkِl", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يَعْلَمَ", "translit": "َmَlْʿعَy", "root": "علم"}, {"id": 14, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 16, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 17, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 18, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 20, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 71, "text": "وَٱللَّهُ فَضَّلَ بَعْضَكُمْ عَلَىٰ بَعْضٍ فِى ٱلرِّزْقِۚ فَمَا ٱلَّذِينَ فُضِّلُوا۟ بِرَآدِّى رِزْقِهِمْ عَلَىٰ مَا مَلَكَتْ أَيْمَٰنُهُمْ فَهُمْ فِيهِ سَوَآءٌۚ أَفَبِنِعْمَةِ ٱللَّهِ يَجْحَدُونَ ", "translation": "And Allāh has favored some of you over others in provision. But those who were favored [i.e., given more] would not hand over their provision to those whom their right hands possess [i.e., slaves] so they would be equal to them therein.[1] Then is it the favor of Allāh they reject?", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "فَضَّلَ", "translit": "َlَّḍَf", "root": "فضل"}, {"id": 3, "arabic": "بَعْضَكُمْ", "translit": "ْmُkَḍْʿعَb", "root": "بعض"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلرِّزْقِ", "translit": "ِqْzِّrlٱ", "root": "رزق"}, {"id": 8, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "فُضِّلُوا۟", "translit": "۟āwُlِّḍُf", "root": "فضل"}, {"id": 11, "arabic": "بِرَآدِّى", "translit": "àِّdٓāَrِb", "root": "ردد"}, {"id": 12, "arabic": "رِزْقِهِمْ", "translit": "ْmِhِqْzِr", "root": "رزق"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 16, "arabic": "أَيْمَٰنُهُمْ", "translit": "ْmُhُnَٰmْyَaʾ", "root": "يمن"}, {"id": 17, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 18, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 19, "arabic": "سَوَآءٌ", "translit": "ٌءٓāَwَs", "root": "سوي"}, {"id": 20, "arabic": "أَفَبِنِعْمَةِ", "translit": "ِẗَmْʿعِnِbَfَaʾ", "root": "نعم"}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "يَجْحَدُونَ", "translit": "َnwُdَḥْjgَy", "root": "جحد"}], "hasIhya": false}, {"ayah": 72, "text": "وَٱللَّهُ جَعَلَ لَكُم مِّنْ أَنفُسِكُمْ أَزْوَٰجًا وَجَعَلَ لَكُم مِّنْ أَزْوَٰجِكُم بَنِينَ وَحَفَدَةً وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِۚ أَفَبِٱلْبَٰطِلِ يُؤْمِنُونَ وَبِنِعْمَتِ ٱللَّهِ هُمْ يَكْفُرُونَ ", "translation": "And Allāh has made for you from yourselves mates and has made for you from your mates sons and grandchildren and has provided for you from the good things. Then in falsehood do they believe and in the favor of Allāh they disbelieve?", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 9, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 10, "arabic": "أَزْوَٰجِكُم", "translit": "mُkِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 11, "arabic": "بَنِينَ", "translit": "َnyِnَb", "root": "بني"}, {"id": 12, "arabic": "وَحَفَدَةً", "translit": "ًẗَdَfَḥَw", "root": "حفد"}, {"id": 13, "arabic": "وَرَزَقَكُم", "translit": "mُkَqَzَrَw", "root": "رزق"}, {"id": 14, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 15, "arabic": "ٱلطَّيِّبَٰتِ", "translit": "ِtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 16, "arabic": "أَفَبِٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱِbَfَaʾ", "root": "بطل"}, {"id": 17, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 18, "arabic": "وَبِنِعْمَتِ", "translit": "ِtَmْʿعِnِbَw", "root": "نعم"}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 21, "arabic": "يَكْفُرُونَ", "translit": "َnwُrُfْkَy", "root": "كفر"}], "hasIhya": false}, {"ayah": 73, "text": "وَيَعْبُدُونَ مِن دُونِ ٱللَّهِ مَا لَا يَمْلِكُ لَهُمْ رِزْقًا مِّنَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ شَيْـًٔا وَلَا يَسْتَطِيعُونَ ", "translation": "And they worship besides Allāh that which does not possess for them [the power of] provision from the heavens and the earth at all, and [in fact], they are unable.", "words": [{"id": 1, "arabic": "وَيَعْبُدُونَ", "translit": "َnwُdُbْʿعَyَw", "root": "عبد"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "يَمْلِكُ", "translit": "ُkِlْmَy", "root": "ملك"}, {"id": 8, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 9, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 12, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 13, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}], "hasIhya": false}, {"ayah": 74, "text": "فَلَا تَضْرِبُوا۟ لِلَّهِ ٱلْأَمْثَالَۚ إِنَّ ٱللَّهَ يَعْلَمُ وَأَنتُمْ لَا تَعْلَمُونَ ", "translation": "So do not assert similarities to Allāh.[1] Indeed, Allāh knows and you do not know.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "تَضْرِبُوا۟", "translit": "۟āwُbِrْḍَt", "root": "ضرب"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "ٱلْأَمْثَالَ", "translit": "َlāَhtْmَaʾْlٱ", "root": "مثل"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 8, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 75, "text": "ضَرَبَ ٱللَّهُ مَثَلًا عَبْدًا مَّمْلُوكًا لَّا يَقْدِرُ عَلَىٰ شَىْءٍ وَمَن رَّزَقْنَٰهُ مِنَّا رِزْقًا حَسَنًا فَهُوَ يُنفِقُ مِنْهُ سِرًّا وَجَهْرًاۖ هَلْ يَسْتَوُۥنَۚ ٱلْحَمْدُ لِلَّهِۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ", "translation": "Allāh presents an example: a slave [who is] owned and unable to do a thing and he to whom We have provided from Us good provision, so he spends from it secretly and publicly. Can they be equal? Praise to Allāh! But most of them do not know.", "words": [{"id": 1, "arabic": "ضَرَبَ", "translit": "َbَrَḍ", "root": "ضرب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "عَبْدًا", "translit": "āًdْbَʿع", "root": "عبد"}, {"id": 5, "arabic": "مَّمْلُوكًا", "translit": "āًkwُlْmَّm", "root": "ملك"}, {"id": 6, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 7, "arabic": "يَقْدِرُ", "translit": "ُrِdْqَy", "root": "قدر"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 10, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 11, "arabic": "رَّزَقْنَٰهُ", "translit": "ُhَٰnْqَzَّr", "root": "رزق"}, {"id": 12, "arabic": "مِنَّا", "translit": "āَّnِm", "root": ""}, {"id": 13, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 14, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 15, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 16, "arabic": "يُنفِقُ", "translit": "ُqِfnُy", "root": "نفق"}, {"id": 17, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 18, "arabic": "سِرًّا", "translit": "āًّrِs", "root": "سرر"}, {"id": 19, "arabic": "وَجَهْرًا", "translit": "āًrْhَjgَw", "root": "جهر"}, {"id": 20, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 21, "arabic": "يَسْتَوُۥنَ", "translit": "َnۥُwَtْsَy", "root": "سوي"}, {"id": 22, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 23, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 24, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 25, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 26, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 27, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 76, "text": "وَضَرَبَ ٱللَّهُ مَثَلًا رَّجُلَيْنِ أَحَدُهُمَآ أَبْكَمُ لَا يَقْدِرُ عَلَىٰ شَىْءٍ وَهُوَ كَلٌّ عَلَىٰ مَوْلَىٰهُ أَيْنَمَا يُوَجِّههُّ لَا يَأْتِ بِخَيْرٍۖ هَلْ يَسْتَوِى هُوَ وَمَن يَأْمُرُ بِٱلْعَدْلِۙ وَهُوَ عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "And Allāh presents an example of two men, one of them dumb and unable to do a thing, while he is a burden to his guardian. Wherever he directs him, he brings no good. Is he equal to one who commands justice, while he is on a straight path?", "words": [{"id": 1, "arabic": "وَضَرَبَ", "translit": "َbَrَḍَw", "root": "ضرب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "رَّجُلَيْنِ", "translit": "ِnْyَlُjgَّr", "root": "رجل"}, {"id": 5, "arabic": "أَحَدُهُمَآ", "translit": "ٓāَmُhُdَḥَaʾ", "root": "احد"}, {"id": 6, "arabic": "أَبْكَمُ", "translit": "ُmَkْbَaʾ", "root": "بكم"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَقْدِرُ", "translit": "ُrِdْqَy", "root": "قدر"}, {"id": 9, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 10, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 11, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 12, "arabic": "كَلٌّ", "translit": "ٌّlَk", "root": "كلل"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "مَوْلَىٰهُ", "translit": "ُhٰàَlْwَm", "root": "ولي"}, {"id": 15, "arabic": "أَيْنَمَا", "translit": "āَmَnْyَaʾ", "root": ""}, {"id": 16, "arabic": "يُوَجِّههُّ", "translit": "ُّhhِّjgَwُy", "root": "وجه"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 19, "arabic": "بِخَيْرٍ", "translit": "ٍrْyَhkِb", "root": "خير"}, {"id": 20, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 21, "arabic": "يَسْتَوِى", "translit": "àِwَtْsَy", "root": "سوي"}, {"id": 22, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 23, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 24, "arabic": "يَأْمُرُ", "translit": "ُrُmْaʾَy", "root": "امر"}, {"id": 25, "arabic": "بِٱلْعَدْلِ", "translit": "ِlْdَʿعْlٱِb", "root": "عدل"}, {"id": 26, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 27, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 28, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 29, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": true}, {"ayah": 77, "text": "وَلِلَّهِ غَيْبُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَمَآ أَمْرُ ٱلسَّاعَةِ إِلَّا كَلَمْحِ ٱلْبَصَرِ أَوْ هُوَ أَقْرَبُۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "And to Allāh belongs the unseen [aspects] of the heavens and the earth. And the command for the Hour is not but as a glance of the eye or even nearer. Indeed, Allāh is over all things competent.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "غَيْبُ", "translit": "ُbْyَغ", "root": "غيب"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 6, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 7, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "كَلَمْحِ", "translit": "ِḥْmَlَk", "root": "لمح"}, {"id": 10, "arabic": "ٱلْبَصَرِ", "translit": "ِrَṣَbْlٱ", "root": "بصر"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 13, "arabic": "أَقْرَبُ", "translit": "ُbَrْqَaʾ", "root": "قرب"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 78, "text": "وَٱللَّهُ أَخْرَجَكُم مِّنۢ بُطُونِ أُمَّهَٰتِكُمْ لَا تَعْلَمُونَ شَيْـًٔا وَجَعَلَ لَكُمُ ٱلسَّمْعَ وَٱلْأَبْصَٰرَ وَٱلْأَفْـِٔدَةَۙ لَعَلَّكُمْ تَشْكُرُونَ ", "translation": "And Allāh has extracted you from the wombs of your mothers not knowing a thing, and He made for you hearing and vision and hearts [i.e., intellect] that perhaps you would be grateful.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "أَخْرَجَكُم", "translit": "mُkَjgَrْhkَaʾ", "root": "خرج"}, {"id": 3, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 4, "arabic": "بُطُونِ", "translit": "ِnwُṭُb", "root": "بطن"}, {"id": 5, "arabic": "أُمَّهَٰتِكُمْ", "translit": "ْmُkِtَٰhَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 7, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}, {"id": 8, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 9, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 10, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 11, "arabic": "ٱلسَّمْعَ", "translit": "َʿعْmَّslٱ", "root": "سمع"}, {"id": 12, "arabic": "وَٱلْأَبْصَٰرَ", "translit": "َrَٰṣْbَaʾْlٱَw", "root": "بصر"}, {"id": 13, "arabic": "وَٱلْأَفْـِٔدَةَ", "translit": "َẗَdِٔـْfَaʾْlٱَw", "root": "فاد"}, {"id": 14, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 15, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 79, "text": "أَلَمْ يَرَوْا۟ إِلَى ٱلطَّيْرِ مُسَخَّرَٰتٍ فِى جَوِّ ٱلسَّمَآءِ مَا يُمْسِكُهُنَّ إِلَّا ٱللَّهُۗ إِنَّ فِى ذَٰلِكَ لَءَايَٰتٍ لِّقَوْمٍ يُؤْمِنُونَ ", "translation": "Do they not see the birds controlled in the atmosphere of the sky? None holds them up except Allāh. Indeed in that are signs for a people who believe.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلطَّيْرِ", "translit": "ِrْyَّṭlٱ", "root": "طير"}, {"id": 5, "arabic": "مُسَخَّرَٰتٍ", "translit": "ٍtَٰrَّhkَsُm", "root": "سخر"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "جَوِّ", "translit": "ِّwَjg", "root": "جوو"}, {"id": 8, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "يُمْسِكُهُنَّ", "translit": "َّnُhُkِsْmُy", "root": "مسك"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 16, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 17, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 18, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 80, "text": "وَٱللَّهُ جَعَلَ لَكُم مِّنۢ بُيُوتِكُمْ سَكَنًا وَجَعَلَ لَكُم مِّن جُلُودِ ٱلْأَنْعَٰمِ بُيُوتًا تَسْتَخِفُّونَهَا يَوْمَ ظَعْنِكُمْ وَيَوْمَ إِقَامَتِكُمْۙ وَمِنْ أَصْوَافِهَا وَأَوْبَارِهَا وَأَشْعَارِهَآ أَثَٰثًا وَمَتَٰعًا إِلَىٰ حِينٍ ", "translation": "And Allāh has made for you from your homes a place of rest and made for you from the hides of the animals tents which you find light on your day of travel and your day of encampment; and from their wool, fur and hair is furnishing and enjoyment [i.e., provision] for a time.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 4, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 5, "arabic": "بُيُوتِكُمْ", "translit": "ْmُkِtwُyُb", "root": "بيت"}, {"id": 6, "arabic": "سَكَنًا", "translit": "āًnَkَs", "root": "سكن"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "جُلُودِ", "translit": "ِdwُlُjg", "root": "جلد"}, {"id": 11, "arabic": "ٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱ", "root": "نعم"}, {"id": 12, "arabic": "بُيُوتًا", "translit": "āًtwُyُb", "root": "بيت"}, {"id": 13, "arabic": "تَسْتَخِفُّونَهَا", "translit": "āَhَnwُّfِhkَtْsَt", "root": "خفف"}, {"id": 14, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 15, "arabic": "ظَعْنِكُمْ", "translit": "ْmُkِnْʿعَẓ", "root": "ظعن"}, {"id": 16, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 17, "arabic": "إِقَامَتِكُمْ", "translit": "ْmُkِtَmāَqِiʾ", "root": "قوم"}, {"id": 18, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 19, "arabic": "أَصْوَافِهَا", "translit": "āَhِfāَwْṣَaʾ", "root": "صوف"}, {"id": 20, "arabic": "وَأَوْبَارِهَا", "translit": "āَhِrāَbْwَaʾَw", "root": "وبر"}, {"id": 21, "arabic": "وَأَشْعَارِهَآ", "translit": "ٓāَhِrāَʿعْhsَaʾَw", "root": "شعر"}, {"id": 22, "arabic": "أَثَٰثًا", "translit": "āًhtَٰhtَaʾ", "root": "اثث"}, {"id": 23, "arabic": "وَمَتَٰعًا", "translit": "āًʿعَٰtَmَw", "root": "متع"}, {"id": 24, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 25, "arabic": "حِينٍ", "translit": "ٍnyِḥ", "root": "حين"}], "hasIhya": false}, {"ayah": 81, "text": "وَٱللَّهُ جَعَلَ لَكُم مِّمَّا خَلَقَ ظِلَٰلًا وَجَعَلَ لَكُم مِّنَ ٱلْجِبَالِ أَكْنَٰنًا وَجَعَلَ لَكُمْ سَرَٰبِيلَ تَقِيكُمُ ٱلْحَرَّ وَسَرَٰبِيلَ تَقِيكُم بَأْسَكُمْۚ كَذَٰلِكَ يُتِمُّ نِعْمَتَهُۥ عَلَيْكُمْ لَعَلَّكُمْ تُسْلِمُونَ ", "translation": "And Allāh has made for you, from that which He has created, shadows [i.e., shade] and has made for you from the mountains, shelters and has made for you garments which protect you from the heat and garments [i.e., coats of mail] which protect you from your [enemy in] battle. Thus does He complete His favor upon you that you might submit [to Him].", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 4, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 5, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "ظِلَٰلًا", "translit": "āًlَٰlِẓ", "root": "ظلل"}, {"id": 7, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلْجِبَالِ", "translit": "ِlāَbِjgْlٱ", "root": "جبل"}, {"id": 11, "arabic": "أَكْنَٰنًا", "translit": "āًnَٰnْkَaʾ", "root": "كنن"}, {"id": 12, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 13, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 14, "arabic": "سَرَٰبِيلَ", "translit": "َlyِbَٰrَs", "root": "سربل"}, {"id": 15, "arabic": "تَقِيكُمُ", "translit": "ُmُkyِqَt", "root": "وقي"}, {"id": 16, "arabic": "ٱلْحَرَّ", "translit": "َّrَḥْlٱ", "root": "حرر"}, {"id": 17, "arabic": "وَسَرَٰبِيلَ", "translit": "َlyِbَٰrَsَw", "root": "سربل"}, {"id": 18, "arabic": "تَقِيكُم", "translit": "mُkyِqَt", "root": "وقي"}, {"id": 19, "arabic": "بَأْسَكُمْ", "translit": "ْmُkَsْaʾَb", "root": "باس"}, {"id": 20, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 21, "arabic": "يُتِمُّ", "translit": "ُّmِtُy", "root": "تمم"}, {"id": 22, "arabic": "نِعْمَتَهُۥ", "translit": "ۥُhَtَmْʿعِn", "root": "نعم"}, {"id": 23, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 24, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 25, "arabic": "تُسْلِمُونَ", "translit": "َnwُmِlْsُt", "root": "سلم"}], "hasIhya": false}, {"ayah": 82, "text": "فَإِن تَوَلَّوْا۟ فَإِنَّمَا عَلَيْكَ ٱلْبَلَٰغُ ٱلْمُبِينُ ", "translation": "But if they turn away, [O Muḥammad] - then only upon you is [responsibility for] clear notification.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 3, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 4, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 6, "arabic": "ٱلْمُبِينُ", "translit": "ُnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 83, "text": "يَعْرِفُونَ نِعْمَتَ ٱللَّهِ ثُمَّ يُنكِرُونَهَا وَأَكْثَرُهُمُ ٱلْكَٰفِرُونَ ", "translation": "They recognize the favor of Allāh; then they deny it. And most of them are disbelievers.", "words": [{"id": 1, "arabic": "يَعْرِفُونَ", "translit": "َnwُfِrْʿعَy", "root": "عرف"}, {"id": 2, "arabic": "نِعْمَتَ", "translit": "َtَmْʿعِn", "root": "نعم"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "يُنكِرُونَهَا", "translit": "āَhَnwُrِknُy", "root": "نكر"}, {"id": 6, "arabic": "وَأَكْثَرُهُمُ", "translit": "ُmُhُrَhtْkَaʾَw", "root": "كثر"}, {"id": 7, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 84, "text": "وَيَوْمَ نَبْعَثُ مِن كُلِّ أُمَّةٍ شَهِيدًا ثُمَّ لَا يُؤْذَنُ لِلَّذِينَ كَفَرُوا۟ وَلَا هُمْ يُسْتَعْتَبُونَ ", "translation": "And [mention] the Day when We will resurrect from every nation a witness [i.e., their prophet]. Then it will not be permitted to the disbelievers [to apologize or make excuses], nor will they be asked to appease [Allāh].", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "نَبْعَثُ", "translit": "ُhtَʿعْbَn", "root": "بعث"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يُؤْذَنُ", "translit": "ُnَhdْwʾُy", "root": "اذن"}, {"id": 10, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 11, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 14, "arabic": "يُسْتَعْتَبُونَ", "translit": "َnwُbَtْʿعَtْsُy", "root": "عتب"}], "hasIhya": false}, {"ayah": 85, "text": "وَإِذَا رَءَا ٱلَّذِينَ ظَلَمُوا۟ ٱلْعَذَابَ فَلَا يُخَفَّفُ عَنْهُمْ وَلَا هُمْ يُنظَرُونَ ", "translation": "And when those who wronged see the punishment, it will not be lightened for them, nor will they be reprieved.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "رَءَا", "translit": "āَءَr", "root": "راي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 5, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 6, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 7, "arabic": "يُخَفَّفُ", "translit": "ُfَّfَhkُy", "root": "خفف"}, {"id": 8, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 11, "arabic": "يُنظَرُونَ", "translit": "َnwُrَẓnُy", "root": "نظر"}], "hasIhya": false}, {"ayah": 86, "text": "وَإِذَا رَءَا ٱلَّذِينَ أَشْرَكُوا۟ شُرَكَآءَهُمْ قَالُوا۟ رَبَّنَا هَٰٓؤُلَآءِ شُرَكَآؤُنَا ٱلَّذِينَ كُنَّا نَدْعُوا۟ مِن دُونِكَۖ فَأَلْقَوْا۟ إِلَيْهِمُ ٱلْقَوْلَ إِنَّكُمْ لَكَٰذِبُونَ ", "translation": "And when those who associated others with Allāh see their \"partners,\" they will say, \"Our Lord, these are our partners [to You] whom we used to invoke [in worship] besides You.\" But they will throw at them the statement, \"Indeed, you are liars.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "رَءَا", "translit": "āَءَr", "root": "راي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 5, "arabic": "شُرَكَآءَهُمْ", "translit": "ْmُhَءٓāَkَrُhs", "root": "شرك"}, {"id": 6, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 7, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 8, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 9, "arabic": "شُرَكَآؤُنَا", "translit": "āَnُwʾٓāَkَrُhs", "root": "شرك"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 12, "arabic": "نَدْعُوا۟", "translit": "۟āwُʿعْdَn", "root": "دعو"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "دُونِكَ", "translit": "َkِnwُd", "root": "دون"}, {"id": 15, "arabic": "فَأَلْقَوْا۟", "translit": "۟āْwَqْlَaʾَf", "root": "لقي"}, {"id": 16, "arabic": "إِلَيْهِمُ", "translit": "ُmِhْyَlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱلْقَوْلَ", "translit": "َlْwَqْlٱ", "root": "قول"}, {"id": 18, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 19, "arabic": "لَكَٰذِبُونَ", "translit": "َnwُbِhdَٰkَl", "root": "كذب"}], "hasIhya": false}, {"ayah": 87, "text": "وَأَلْقَوْا۟ إِلَى ٱللَّهِ يَوْمَئِذٍ ٱلسَّلَمَۖ وَضَلَّ عَنْهُم مَّا كَانُوا۟ يَفْتَرُونَ ", "translation": "And they will impart to Allāh that Day [their] submission, and lost from them is what they used to invent.", "words": [{"id": 1, "arabic": "وَأَلْقَوْا۟", "translit": "۟āْwَqْlَaʾَw", "root": "لقي"}, {"id": 2, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 5, "arabic": "ٱلسَّلَمَ", "translit": "َmَlَّslٱ", "root": "سلم"}, {"id": 6, "arabic": "وَضَلَّ", "translit": "َّlَḍَw", "root": "ضلل"}, {"id": 7, "arabic": "عَنْهُم", "translit": "mُhْnَʿع", "root": ""}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}], "hasIhya": false}, {"ayah": 88, "text": "ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوا۟ عَن سَبِيلِ ٱللَّهِ زِدْنَٰهُمْ عَذَابًا فَوْقَ ٱلْعَذَابِ بِمَا كَانُوا۟ يُفْسِدُونَ ", "translation": "Those who disbelieved and averted [others] from the way of Allāh - We will increase them in punishment over [their] punishment for what corruption they were causing.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 3, "arabic": "وَصَدُّوا۟", "translit": "۟āwُّdَṣَw", "root": "صدد"}, {"id": 4, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 5, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "زِدْنَٰهُمْ", "translit": "ْmُhَٰnْdِz", "root": "زيد"}, {"id": 8, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 9, "arabic": "فَوْقَ", "translit": "َqْwَf", "root": "فوق"}, {"id": 10, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 11, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يُفْسِدُونَ", "translit": "َnwُdِsْfُy", "root": "فسد"}], "hasIhya": false}, {"ayah": 89, "text": "وَيَوْمَ نَبْعَثُ فِى كُلِّ أُمَّةٍ شَهِيدًا عَلَيْهِم مِّنْ أَنفُسِهِمْۖ وَجِئْنَا بِكَ شَهِيدًا عَلَىٰ هَٰٓؤُلَآءِۚ وَنَزَّلْنَا عَلَيْكَ ٱلْكِتَٰبَ تِبْيَٰنًا لِّكُلِّ شَىْءٍ وَهُدًى وَرَحْمَةً وَبُشْرَىٰ لِلْمُسْلِمِينَ ", "translation": "And [mention] the Day when We will resurrect among every nation a witness over them from themselves [i.e., their prophet]. And We will bring you, [O Muḥammad], as a witness over these [i.e., your nation]. And We have sent down to you the Book as clarification for all things and as guidance and mercy and good tidings for the Muslims.[1]", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "نَبْعَثُ", "translit": "ُhtَʿعْbَn", "root": "بعث"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 5, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}, {"id": 7, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 9, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 10, "arabic": "وَجِئْنَا", "translit": "āَnْyʾِjgَw", "root": "جيا"}, {"id": 11, "arabic": "بِكَ", "translit": "َkِb", "root": ""}, {"id": 12, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 15, "arabic": "وَنَزَّلْنَا", "translit": "āَnْlَّzَnَw", "root": "نزل"}, {"id": 16, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 17, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 18, "arabic": "تِبْيَٰنًا", "translit": "āًnَٰyْbِt", "root": "بين"}, {"id": 19, "arabic": "لِّكُلِّ", "translit": "ِّlُkِّl", "root": "كلل"}, {"id": 20, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 21, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 22, "arabic": "وَرَحْمَةً", "translit": "ًẗَmْḥَrَw", "root": "رحم"}, {"id": 23, "arabic": "وَبُشْرَىٰ", "translit": "ٰàَrْhsُbَw", "root": "بشر"}, {"id": 24, "arabic": "لِلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlِl", "root": "سلم"}], "hasIhya": false}, {"ayah": 90, "text": "إِنَّ ٱللَّهَ يَأْمُرُ بِٱلْعَدْلِ وَٱلْإِحْسَٰنِ وَإِيتَآئِ ذِى ٱلْقُرْبَىٰ وَيَنْهَىٰ عَنِ ٱلْفَحْشَآءِ وَٱلْمُنكَرِ وَٱلْبَغْىِۚ يَعِظُكُمْ لَعَلَّكُمْ تَذَكَّرُونَ ", "translation": "Indeed, Allāh orders justice and good conduct and giving [help] to relatives and forbids immorality and bad conduct and oppression. He admonishes you that perhaps you will be reminded.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "يَأْمُرُ", "translit": "ُrُmْaʾَy", "root": "امر"}, {"id": 4, "arabic": "بِٱلْعَدْلِ", "translit": "ِlْdَʿعْlٱِb", "root": "عدل"}, {"id": 5, "arabic": "وَٱلْإِحْسَٰنِ", "translit": "ِnَٰsْḥِiʾْlٱَw", "root": "حسن"}, {"id": 6, "arabic": "وَإِيتَآئِ", "translit": "ِyʾٓāَtyِiʾَw", "root": "اتي"}, {"id": 7, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 8, "arabic": "ٱلْقُرْبَىٰ", "translit": "ٰàَbْrُqْlٱ", "root": "قرب"}, {"id": 9, "arabic": "وَيَنْهَىٰ", "translit": "ٰàَhْnَyَw", "root": "نهي"}, {"id": 10, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 11, "arabic": "ٱلْفَحْشَآءِ", "translit": "ِءٓāَhsْḥَfْlٱ", "root": "فحش"}, {"id": 12, "arabic": "وَٱلْمُنكَرِ", "translit": "ِrَknُmْlٱَw", "root": "نكر"}, {"id": 13, "arabic": "وَٱلْبَغْىِ", "translit": "ِàْغَbْlٱَw", "root": "بغي"}, {"id": 14, "arabic": "يَعِظُكُمْ", "translit": "ْmُkُẓِʿعَy", "root": "وعظ"}, {"id": 15, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 16, "arabic": "تَذَكَّرُونَ", "translit": "َnwُrَّkَhdَt", "root": "ذكر"}], "hasIhya": true}, {"ayah": 91, "text": "وَأَوْفُوا۟ بِعَهْدِ ٱللَّهِ إِذَا عَٰهَدتُّمْ وَلَا تَنقُضُوا۟ ٱلْأَيْمَٰنَ بَعْدَ تَوْكِيدِهَا وَقَدْ جَعَلْتُمُ ٱللَّهَ عَلَيْكُمْ كَفِيلًاۚ إِنَّ ٱللَّهَ يَعْلَمُ مَا تَفْعَلُونَ ", "translation": "And fulfill the covenant of Allāh when you have taken it, [O believers], and do not break oaths after their confirmation while you have made Allāh, over you, a security [i.e., witness]. Indeed, Allāh knows what you do.", "words": [{"id": 1, "arabic": "وَأَوْفُوا۟", "translit": "۟āwُfْwَaʾَw", "root": "وفي"}, {"id": 2, "arabic": "بِعَهْدِ", "translit": "ِdْhَʿعِb", "root": "عهد"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "عَٰهَدتُّمْ", "translit": "ْmُّtdَhَٰʿع", "root": "عهد"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَنقُضُوا۟", "translit": "۟āwُḍُqnَt", "root": "نقض"}, {"id": 8, "arabic": "ٱلْأَيْمَٰنَ", "translit": "َnَٰmْyَaʾْlٱ", "root": "يمن"}, {"id": 9, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "تَوْكِيدِهَا", "translit": "āَhِdyِkْwَt", "root": "وكد"}, {"id": 11, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 12, "arabic": "جَعَلْتُمُ", "translit": "ُmُtْlَʿعَjg", "root": "جعل"}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 15, "arabic": "كَفِيلًا", "translit": "āًlyِfَk", "root": "كفل"}, {"id": 16, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 19, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 20, "arabic": "تَفْعَلُونَ", "translit": "َnwُlَʿعْfَt", "root": "فعل"}], "hasIhya": false}, {"ayah": 92, "text": "وَلَا تَكُونُوا۟ كَٱلَّتِى نَقَضَتْ غَزْلَهَا مِنۢ بَعْدِ قُوَّةٍ أَنكَٰثًا تَتَّخِذُونَ أَيْمَٰنَكُمْ دَخَلًۢا بَيْنَكُمْ أَن تَكُونَ أُمَّةٌ هِىَ أَرْبَىٰ مِنْ أُمَّةٍۚ إِنَّمَا يَبْلُوكُمُ ٱللَّهُ بِهِۦۚ وَلَيُبَيِّنَنَّ لَكُمْ يَوْمَ ٱلْقِيَٰمَةِ مَا كُنتُمْ فِيهِ تَخْتَلِفُونَ ", "translation": "And do not be like she who untwisted her spun thread after it was strong [by] taking your oaths as [means of] deceit between you because one community is more plentiful [in number or wealth] than another community.[1] Allāh only tries you thereby. And He will surely make clear to you on the Day of Resurrection that over which you used to differ.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 3, "arabic": "كَٱلَّتِى", "translit": "àِtَّlٱَk", "root": ""}, {"id": 4, "arabic": "نَقَضَتْ", "translit": "ْtَḍَqَn", "root": "نقض"}, {"id": 5, "arabic": "غَزْلَهَا", "translit": "āَhَlْzَغ", "root": "غزل"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "قُوَّةٍ", "translit": "ٍẗَّwُq", "root": "قوي"}, {"id": 9, "arabic": "أَنكَٰثًا", "translit": "āًhtَٰknَaʾ", "root": "نكث"}, {"id": 10, "arabic": "تَتَّخِذُونَ", "translit": "َnwُhdِhkَّtَt", "root": "اخذ"}, {"id": 11, "arabic": "أَيْمَٰنَكُمْ", "translit": "ْmُkَnَٰmْyَaʾ", "root": "يمن"}, {"id": 12, "arabic": "دَخَلًۢا", "translit": "āًۢlَhkَd", "root": "دخل"}, {"id": 13, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "تَكُونَ", "translit": "َnwُkَt", "root": "كون"}, {"id": 16, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 17, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 18, "arabic": "أَرْبَىٰ", "translit": "ٰàَbْrَaʾ", "root": "ربو"}, {"id": 19, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 20, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 21, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 22, "arabic": "يَبْلُوكُمُ", "translit": "ُmُkwُlْbَy", "root": "بلو"}, {"id": 23, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 25, "arabic": "وَلَيُبَيِّنَنَّ", "translit": "َّnَnِّyَbُyَlَw", "root": "بين"}, {"id": 26, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 27, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 28, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 29, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 30, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 31, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 32, "arabic": "تَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَt", "root": "خلف"}], "hasIhya": false}, {"ayah": 93, "text": "وَلَوْ شَآءَ ٱللَّهُ لَجَعَلَكُمْ أُمَّةً وَٰحِدَةً وَلَٰكِن يُضِلُّ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُۚ وَلَتُسْـَٔلُنَّ عَمَّا كُنتُمْ تَعْمَلُونَ ", "translation": "And if Allāh had willed, He could have made you [of] one religion, but He sends astray whom He wills and guides whom He wills.[1] And you will surely be questioned about what you used to do.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لَجَعَلَكُمْ", "translit": "ْmُkَlَʿعَjgَl", "root": "جعل"}, {"id": 5, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 8, "arabic": "يُضِلُّ", "translit": "ُّlِḍُy", "root": "ضلل"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 11, "arabic": "وَيَهْدِى", "translit": "àِdْhَyَw", "root": "هدي"}, {"id": 12, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 13, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 14, "arabic": "وَلَتُسْـَٔلُنَّ", "translit": "َّnُlَٔـْsُtَlَw", "root": "سال"}, {"id": 15, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 16, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 17, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": true}, {"ayah": 94, "text": "وَلَا تَتَّخِذُوٓا۟ أَيْمَٰنَكُمْ دَخَلًۢا بَيْنَكُمْ فَتَزِلَّ قَدَمٌۢ بَعْدَ ثُبُوتِهَا وَتَذُوقُوا۟ ٱلسُّوٓءَ بِمَا صَدَدتُّمْ عَن سَبِيلِ ٱللَّهِۖ وَلَكُمْ عَذَابٌ عَظِيمٌ ", "translation": "And do not take your oaths as [means of] deceit between you, lest a foot slip after it was [once] firm, and you would taste evil [in this world] for what [people] you diverted from the way of Allāh,[1] and you would have [in the Hereafter] a great punishment.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَتَّخِذُوٓا۟", "translit": "۟āٓwُhdِhkَّtَt", "root": "اخذ"}, {"id": 3, "arabic": "أَيْمَٰنَكُمْ", "translit": "ْmُkَnَٰmْyَaʾ", "root": "يمن"}, {"id": 4, "arabic": "دَخَلًۢا", "translit": "āًۢlَhkَd", "root": "دخل"}, {"id": 5, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 6, "arabic": "فَتَزِلَّ", "translit": "َّlِzَtَf", "root": "زلل"}, {"id": 7, "arabic": "قَدَمٌۢ", "translit": "ٌۢmَdَq", "root": "قدم"}, {"id": 8, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 9, "arabic": "ثُبُوتِهَا", "translit": "āَhِtwُbُht", "root": "ثبت"}, {"id": 10, "arabic": "وَتَذُوقُوا۟", "translit": "۟āwُqwُhdَtَw", "root": "ذوق"}, {"id": 11, "arabic": "ٱلسُّوٓءَ", "translit": "َءٓwُّslٱ", "root": "سوا"}, {"id": 12, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 13, "arabic": "صَدَدتُّمْ", "translit": "ْmُّtdَdَṣ", "root": "صدد"}, {"id": 14, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 15, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 18, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 19, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 95, "text": "وَلَا تَشْتَرُوا۟ بِعَهْدِ ٱللَّهِ ثَمَنًا قَلِيلًاۚ إِنَّمَا عِندَ ٱللَّهِ هُوَ خَيْرٌ لَّكُمْ إِن كُنتُمْ تَعْلَمُونَ ", "translation": "And do not exchange the covenant of Allāh for a small price. Indeed, what is with Allāh is best for you, if only you could know.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَشْتَرُوا۟", "translit": "۟āwُrَtْhsَt", "root": "شري"}, {"id": 3, "arabic": "بِعَهْدِ", "translit": "ِdْhَʿعِb", "root": "عهد"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 6, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 7, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 8, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 12, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 15, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 96, "text": "مَا عِندَكُمْ يَنفَدُۖ وَمَا عِندَ ٱللَّهِ بَاقٍۗ وَلَنَجْزِيَنَّ ٱلَّذِينَ صَبَرُوٓا۟ أَجْرَهُم بِأَحْسَنِ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Whatever you have will end, but what Allāh has is lasting. And We will surely give those who were patient their reward according to the best of what they used to do.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "عِندَكُمْ", "translit": "ْmُkَdnِʿع", "root": "عند"}, {"id": 3, "arabic": "يَنفَدُ", "translit": "ُdَfnَy", "root": "نفد"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "بَاقٍ", "translit": "ٍqāَb", "root": "بقي"}, {"id": 8, "arabic": "وَلَنَجْزِيَنَّ", "translit": "َّnَyِzْjgَnَlَw", "root": "جزي"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "صَبَرُوٓا۟", "translit": "۟āٓwُrَbَṣ", "root": "صبر"}, {"id": 11, "arabic": "أَجْرَهُم", "translit": "mُhَrْjgَaʾ", "root": "اجر"}, {"id": 12, "arabic": "بِأَحْسَنِ", "translit": "ِnَsْḥَaʾِb", "root": "حسن"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 15, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": true}, {"ayah": 97, "text": "مَنْ عَمِلَ صَٰلِحًا مِّن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَلَنُحْيِيَنَّهُۥ حَيَوٰةً طَيِّبَةًۖ وَلَنَجْزِيَنَّهُمْ أَجْرَهُم بِأَحْسَنِ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Whoever does righteousness, whether male or female, while he is a believer - We will surely cause him to live a good life, and We will surely give them their reward [in the Hereafter] according to the best of what they used to do.", "words": [{"id": 1, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 2, "arabic": "عَمِلَ", "translit": "َlِmَʿع", "root": "عمل"}, {"id": 3, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "ذَكَرٍ", "translit": "ٍrَkَhd", "root": "ذكر"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "أُنثَىٰ", "translit": "ٰàَhtnُaʾ", "root": "انث"}, {"id": 8, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 9, "arabic": "مُؤْمِنٌ", "translit": "ٌnِmْwʾُm", "root": "امن"}, {"id": 10, "arabic": "فَلَنُحْيِيَنَّهُۥ", "translit": "ۥُhَّnَyِyْḥُnَlَf", "root": "حيي"}, {"id": 11, "arabic": "حَيَوٰةً", "translit": "ًẗٰwَyَḥ", "root": "حيي"}, {"id": 12, "arabic": "طَيِّبَةً", "translit": "ًẗَbِّyَṭ", "root": "طيب"}, {"id": 13, "arabic": "وَلَنَجْزِيَنَّهُمْ", "translit": "ْmُhَّnَyِzْjgَnَlَw", "root": "جزي"}, {"id": 14, "arabic": "أَجْرَهُم", "translit": "mُhَrْjgَaʾ", "root": "اجر"}, {"id": 15, "arabic": "بِأَحْسَنِ", "translit": "ِnَsْḥَaʾِb", "root": "حسن"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 98, "text": "فَإِذَا قَرَأْتَ ٱلْقُرْءَانَ فَٱسْتَعِذْ بِٱللَّهِ مِنَ ٱلشَّيْطَٰنِ ٱلرَّجِيمِ ", "translation": "So when you recite the Qur’ān, [first] seek refuge in Allāh from Satan, the expelled [from His mercy].", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "قَرَأْتَ", "translit": "َtْaʾَrَq", "root": "قرا"}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "فَٱسْتَعِذْ", "translit": "ْhdِʿعَtْsٱَf", "root": "عوذ"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 8, "arabic": "ٱلرَّجِيمِ", "translit": "ِmyِjgَّrlٱ", "root": "رجم"}], "hasIhya": true}, {"ayah": 99, "text": "إِنَّهُۥ لَيْسَ لَهُۥ سُلْطَٰنٌ عَلَى ٱلَّذِينَ ءَامَنُوا۟ وَعَلَىٰ رَبِّهِمْ يَتَوَكَّلُونَ ", "translation": "Indeed, there is for him no authority over those who have believed and rely upon their Lord.", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "سُلْطَٰنٌ", "translit": "ٌnَٰṭْlُs", "root": "سلط"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 8, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 9, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 10, "arabic": "يَتَوَكَّلُونَ", "translit": "َnwُlَّkَwَtَy", "root": "وكل"}], "hasIhya": false}, {"ayah": 100, "text": "إِنَّمَا سُلْطَٰنُهُۥ عَلَى ٱلَّذِينَ يَتَوَلَّوْنَهُۥ وَٱلَّذِينَ هُم بِهِۦ مُشْرِكُونَ ", "translation": "His authority is only over those who take him as an ally and those who through him associate others with Allāh.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "سُلْطَٰنُهُۥ", "translit": "ۥُhُnَٰṭْlُs", "root": "سلط"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَتَوَلَّوْنَهُۥ", "translit": "ۥُhَnْwَّlَwَtَy", "root": "ولي"}, {"id": 6, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 7, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 8, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 9, "arabic": "مُشْرِكُونَ", "translit": "َnwُkِrْhsُm", "root": "شرك"}], "hasIhya": false}, {"ayah": 101, "text": "وَإِذَا بَدَّلْنَآ ءَايَةً مَّكَانَ ءَايَةٍۙ وَٱللَّهُ أَعْلَمُ بِمَا يُنَزِّلُ قَالُوٓا۟ إِنَّمَآ أَنتَ مُفْتَرٍۭۚ بَلْ أَكْثَرُهُمْ لَا يَعْلَمُونَ ", "translation": "And when We substitute a verse in place of a verse - and Allāh is most knowing of what He sends down - they say, \"You, [O Muḥammad], are but an inventor [of lies].\" But most of them do not know.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "بَدَّلْنَآ", "translit": "ٓāَnْlَّdَb", "root": "بدل"}, {"id": 3, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 4, "arabic": "مَّكَانَ", "translit": "َnāَkَّm", "root": "كون"}, {"id": 5, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 8, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 9, "arabic": "يُنَزِّلُ", "translit": "ُlِّzَnُy", "root": "نزل"}, {"id": 10, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 11, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 12, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 13, "arabic": "مُفْتَرٍۭ", "translit": "ٍۭrَtْfُm", "root": "فري"}, {"id": 14, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 15, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 102, "text": "قُلْ نَزَّلَهُۥ رُوحُ ٱلْقُدُسِ مِن رَّبِّكَ بِٱلْحَقِّ لِيُثَبِّتَ ٱلَّذِينَ ءَامَنُوا۟ وَهُدًى وَبُشْرَىٰ لِلْمُسْلِمِينَ ", "translation": "Say, [O Muḥammad], \"The Pure Spirit [i.e., Gabriel] has brought it down from your Lord in truth to make firm those who believe and as guidance and good tidings to the Muslims.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "نَزَّلَهُۥ", "translit": "ۥُhَlَّzَn", "root": "نزل"}, {"id": 3, "arabic": "رُوحُ", "translit": "ُḥwُr", "root": "روح"}, {"id": 4, "arabic": "ٱلْقُدُسِ", "translit": "ِsُdُqْlٱ", "root": "قدس"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 8, "arabic": "لِيُثَبِّتَ", "translit": "َtِّbَhtُyِl", "root": "ثبت"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 11, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 12, "arabic": "وَبُشْرَىٰ", "translit": "ٰàَrْhsُbَw", "root": "بشر"}, {"id": 13, "arabic": "لِلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlِl", "root": "سلم"}], "hasIhya": true}, {"ayah": 103, "text": "وَلَقَدْ نَعْلَمُ أَنَّهُمْ يَقُولُونَ إِنَّمَا يُعَلِّمُهُۥ بَشَرٌۗ لِّسَانُ ٱلَّذِى يُلْحِدُونَ إِلَيْهِ أَعْجَمِىٌّ وَهَٰذَا لِسَانٌ عَرَبِىٌّ مُّبِينٌ ", "translation": "And We certainly know that they say, \"It is only a human being who teaches him [i.e., the Prophet (ﷺ)].\" The tongue of the one they refer to is foreign,[1] and this [recitation, i.e., Qur’ān] is [in] a clear Arabic language.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "نَعْلَمُ", "translit": "ُmَlْʿعَn", "root": "علم"}, {"id": 3, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 5, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 6, "arabic": "يُعَلِّمُهُۥ", "translit": "ۥُhُmِّlَʿعُy", "root": "علم"}, {"id": 7, "arabic": "بَشَرٌ", "translit": "ٌrَhsَb", "root": "بشر"}, {"id": 8, "arabic": "لِّسَانُ", "translit": "ُnāَsِّl", "root": "لسن"}, {"id": 9, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "يُلْحِدُونَ", "translit": "َnwُdِḥْlُy", "root": "لحد"}, {"id": 11, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 12, "arabic": "أَعْجَمِىٌّ", "translit": "ٌّàِmَjgْʿعَaʾ", "root": "عجم"}, {"id": 13, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 14, "arabic": "لِسَانٌ", "translit": "ٌnāَsِl", "root": "لسن"}, {"id": 15, "arabic": "عَرَبِىٌّ", "translit": "ٌّàِbَrَʿع", "root": "عرب"}, {"id": 16, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 104, "text": "إِنَّ ٱلَّذِينَ لَا يُؤْمِنُونَ بِـَٔايَٰتِ ٱللَّهِ لَا يَهْدِيهِمُ ٱللَّهُ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "Indeed, those who do not believe in the verses of Allāh - Allāh will not guide them, and for them is a painful punishment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يَهْدِيهِمُ", "translit": "ُmِhyِdْhَy", "root": "هدي"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 105, "text": "إِنَّمَا يَفْتَرِى ٱلْكَذِبَ ٱلَّذِينَ لَا يُؤْمِنُونَ بِـَٔايَٰتِ ٱللَّهِۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْكَٰذِبُونَ ", "translation": "They only invent falsehood who do not believe in the verses of Allāh, and it is those who are the liars.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَفْتَرِى", "translit": "àِrَtْfَy", "root": "فري"}, {"id": 3, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 7, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 10, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 11, "arabic": "ٱلْكَٰذِبُونَ", "translit": "َnwُbِhdَٰkْlٱ", "root": "كذب"}], "hasIhya": true}, {"ayah": 106, "text": "مَن كَفَرَ بِٱللَّهِ مِنۢ بَعْدِ إِيمَٰنِهِۦٓ إِلَّا مَنْ أُكْرِهَ وَقَلْبُهُۥ مُطْمَئِنٌّۢ بِٱلْإِيمَٰنِ وَلَٰكِن مَّن شَرَحَ بِٱلْكُفْرِ صَدْرًا فَعَلَيْهِمْ غَضَبٌ مِّنَ ٱللَّهِ وَلَهُمْ عَذَابٌ عَظِيمٌ ", "translation": "Whoever disbelieves in [i.e., denies] Allāh after his belief...[1] except for one who is forced [to renounce his religion] while his heart is secure in faith. But those who [willingly] open their breasts to disbelief, upon them is wrath from Allāh, and for them is a great punishment;", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "إِيمَٰنِهِۦٓ", "translit": "ٓۦِhِnَٰmyِiʾ", "root": "امن"}, {"id": 7, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 8, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 9, "arabic": "أُكْرِهَ", "translit": "َhِrْkُaʾ", "root": "كره"}, {"id": 10, "arabic": "وَقَلْبُهُۥ", "translit": "ۥُhُbْlَqَw", "root": "قلب"}, {"id": 11, "arabic": "مُطْمَئِنٌّۢ", "translit": "ٌّۢnِyʾَmْṭُm", "root": "طمان"}, {"id": 12, "arabic": "بِٱلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlٱِb", "root": "امن"}, {"id": 13, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 14, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 15, "arabic": "شَرَحَ", "translit": "َḥَrَhs", "root": "شرح"}, {"id": 16, "arabic": "بِٱلْكُفْرِ", "translit": "ِrْfُkْlٱِb", "root": "كفر"}, {"id": 17, "arabic": "صَدْرًا", "translit": "āًrْdَṣ", "root": "صدر"}, {"id": 18, "arabic": "فَعَلَيْهِمْ", "translit": "ْmِhْyَlَʿعَf", "root": ""}, {"id": 19, "arabic": "غَضَبٌ", "translit": "ٌbَḍَغ", "root": "غضب"}, {"id": 20, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 23, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 24, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 107, "text": "ذَٰلِكَ بِأَنَّهُمُ ٱسْتَحَبُّوا۟ ٱلْحَيَوٰةَ ٱلدُّنْيَا عَلَى ٱلْءَاخِرَةِ وَأَنَّ ٱللَّهَ لَا يَهْدِى ٱلْقَوْمَ ٱلْكَٰفِرِينَ ", "translation": "That is because they preferred the worldly life over the Hereafter and that Allāh does not guide the disbelieving people.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُمُ", "translit": "ُmُhَّnَaʾِb", "root": ""}, {"id": 3, "arabic": "ٱسْتَحَبُّوا۟", "translit": "۟āwُّbَḥَtْsٱ", "root": "حبب"}, {"id": 4, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 12, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 13, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 108, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ طَبَعَ ٱللَّهُ عَلَىٰ قُلُوبِهِمْ وَسَمْعِهِمْ وَأَبْصَٰرِهِمْۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْغَٰفِلُونَ ", "translation": "Those are the ones over whose hearts and hearing and vision Allāh has sealed, and it is those who are the heedless.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "طَبَعَ", "translit": "َʿعَbَṭ", "root": "طبع"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 7, "arabic": "وَسَمْعِهِمْ", "translit": "ْmِhِʿعْmَsَw", "root": "سمع"}, {"id": 8, "arabic": "وَأَبْصَٰرِهِمْ", "translit": "ْmِhِrَٰṣْbَaʾَw", "root": "بصر"}, {"id": 9, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 10, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 11, "arabic": "ٱلْغَٰفِلُونَ", "translit": "َnwُlِfَٰغْlٱ", "root": "غفل"}], "hasIhya": false}, {"ayah": 109, "text": "لَا جَرَمَ أَنَّهُمْ فِى ٱلْءَاخِرَةِ هُمُ ٱلْخَٰسِرُونَ ", "translation": "Assuredly, it is they, in the Hereafter, who will be the losers.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "جَرَمَ", "translit": "َmَrَjg", "root": "جرم"}, {"id": 3, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 6, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 7, "arabic": "ٱلْخَٰسِرُونَ", "translit": "َnwُrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": true}, {"ayah": 110, "text": "ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ هَاجَرُوا۟ مِنۢ بَعْدِ مَا فُتِنُوا۟ ثُمَّ جَٰهَدُوا۟ وَصَبَرُوٓا۟ إِنَّ رَبَّكَ مِنۢ بَعْدِهَا لَغَفُورٌ رَّحِيمٌ ", "translation": "Then, indeed your Lord, to those who emigrated after they had been compelled [to say words of disbelief] and thereafter fought [for the cause of Allāh] and were patient - indeed, your Lord, after that, is Forgiving and Merciful", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 4, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 5, "arabic": "هَاجَرُوا۟", "translit": "۟āwُrَjgāَh", "root": "هجر"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "فُتِنُوا۟", "translit": "۟āwُnِtُf", "root": "فتن"}, {"id": 10, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 11, "arabic": "جَٰهَدُوا۟", "translit": "۟āwُdَhَٰjg", "root": "جهد"}, {"id": 12, "arabic": "وَصَبَرُوٓا۟", "translit": "۟āٓwُrَbَṣَw", "root": "صبر"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 15, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 16, "arabic": "بَعْدِهَا", "translit": "āَhِdْʿعَb", "root": "بعد"}, {"id": 17, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 18, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 111, "text": "يَوْمَ تَأْتِى كُلُّ نَفْسٍ تُجَٰدِلُ عَن نَّفْسِهَا وَتُوَفَّىٰ كُلُّ نَفْسٍ مَّا عَمِلَتْ وَهُمْ لَا يُظْلَمُونَ ", "translation": "On the Day when every soul will come disputing [i.e., pleading] for itself, and every soul will be fully compensated for what it did, and they will not be wronged [i.e., treated unjustly].", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تَأْتِى", "translit": "àِtْaʾَt", "root": "اتي"}, {"id": 3, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 4, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 5, "arabic": "تُجَٰدِلُ", "translit": "ُlِdَٰjgُt", "root": "جدل"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "نَّفْسِهَا", "translit": "āَhِsْfَّn", "root": "نفس"}, {"id": 8, "arabic": "وَتُوَفَّىٰ", "translit": "ٰàَّfَwُtَw", "root": "وفي"}, {"id": 9, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 10, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 11, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 12, "arabic": "عَمِلَتْ", "translit": "ْtَlِmَʿع", "root": "عمل"}, {"id": 13, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": true}, {"ayah": 112, "text": "وَضَرَبَ ٱللَّهُ مَثَلًا قَرْيَةً كَانَتْ ءَامِنَةً مُّطْمَئِنَّةً يَأْتِيهَا رِزْقُهَا رَغَدًا مِّن كُلِّ مَكَانٍ فَكَفَرَتْ بِأَنْعُمِ ٱللَّهِ فَأَذَٰقَهَا ٱللَّهُ لِبَاسَ ٱلْجُوعِ وَٱلْخَوْفِ بِمَا كَانُوا۟ يَصْنَعُونَ ", "translation": "And Allāh presents an example: a city [i.e., Makkah] which was safe and secure, its provision coming to it in abundance from every location, but it denied the favors of Allāh. So Allāh made it taste the envelopment of hunger and fear for what they had been doing.", "words": [{"id": 1, "arabic": "وَضَرَبَ", "translit": "َbَrَḍَw", "root": "ضرب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 4, "arabic": "قَرْيَةً", "translit": "ًẗَyْrَq", "root": "قري"}, {"id": 5, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 6, "arabic": "ءَامِنَةً", "translit": "ًẗَnِmāَء", "root": "امن"}, {"id": 7, "arabic": "مُّطْمَئِنَّةً", "translit": "ًẗَّnِyʾَmْṭُّm", "root": "طمان"}, {"id": 8, "arabic": "يَأْتِيهَا", "translit": "āَhyِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "رِزْقُهَا", "translit": "āَhُqْzِr", "root": "رزق"}, {"id": 10, "arabic": "رَغَدًا", "translit": "āًdَغَr", "root": "رغد"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 13, "arabic": "مَكَانٍ", "translit": "ٍnāَkَm", "root": "كون"}, {"id": 14, "arabic": "فَكَفَرَتْ", "translit": "ْtَrَfَkَf", "root": "كفر"}, {"id": 15, "arabic": "بِأَنْعُمِ", "translit": "ِmُʿعْnَaʾِb", "root": "نعم"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "فَأَذَٰقَهَا", "translit": "āَhَqَٰhdَaʾَf", "root": "ذوق"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "لِبَاسَ", "translit": "َsāَbِl", "root": "لبس"}, {"id": 20, "arabic": "ٱلْجُوعِ", "translit": "ِʿعwُjgْlٱ", "root": "جوع"}, {"id": 21, "arabic": "وَٱلْخَوْفِ", "translit": "ِfْwَhkْlٱَw", "root": "خوف"}, {"id": 22, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 23, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 24, "arabic": "يَصْنَعُونَ", "translit": "َnwُʿعَnْṣَy", "root": "صنع"}], "hasIhya": false}, {"ayah": 113, "text": "وَلَقَدْ جَآءَهُمْ رَسُولٌ مِّنْهُمْ فَكَذَّبُوهُ فَأَخَذَهُمُ ٱلْعَذَابُ وَهُمْ ظَٰلِمُونَ ", "translation": "And there had certainly come to them a Messenger from among themselves, but they denied him; so punishment overtook them while they were wrongdoers.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 4, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 5, "arabic": "فَكَذَّبُوهُ", "translit": "ُhwُbَّhdَkَf", "root": "كذب"}, {"id": 6, "arabic": "فَأَخَذَهُمُ", "translit": "ُmُhَhdَhkَaʾَf", "root": "اخذ"}, {"id": 7, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "ظَٰلِمُونَ", "translit": "َnwُmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 114, "text": "فَكُلُوا۟ مِمَّا رَزَقَكُمُ ٱللَّهُ حَلَٰلًا طَيِّبًا وَٱشْكُرُوا۟ نِعْمَتَ ٱللَّهِ إِن كُنتُمْ إِيَّاهُ تَعْبُدُونَ ", "translation": "Then eat of what Allāh has provided for you [which is] lawful and good. And be grateful for the favor of Allāh, if it is [indeed] Him that you worship.", "words": [{"id": 1, "arabic": "فَكُلُوا۟", "translit": "۟āwُlُkَf", "root": "اكل"}, {"id": 2, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 3, "arabic": "رَزَقَكُمُ", "translit": "ُmُkَqَzَr", "root": "رزق"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "حَلَٰلًا", "translit": "āًlَٰlَḥ", "root": "حلل"}, {"id": 6, "arabic": "طَيِّبًا", "translit": "āًbِّyَṭ", "root": "طيب"}, {"id": 7, "arabic": "وَٱشْكُرُوا۟", "translit": "۟āwُrُkْhsٱَw", "root": "شكر"}, {"id": 8, "arabic": "نِعْمَتَ", "translit": "َtَmْʿعِn", "root": "نعم"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 11, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 12, "arabic": "إِيَّاهُ", "translit": "ُhāَّyِiʾ", "root": ""}, {"id": 13, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}], "hasIhya": false}, {"ayah": 115, "text": "إِنَّمَا حَرَّمَ عَلَيْكُمُ ٱلْمَيْتَةَ وَٱلدَّمَ وَلَحْمَ ٱلْخِنزِيرِ وَمَآ أُهِلَّ لِغَيْرِ ٱللَّهِ بِهِۦۖ فَمَنِ ٱضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "He has only forbidden to you dead animals,[1] blood, the flesh of swine, and that which has been dedicated to other than Allāh. But whoever is forced [by necessity], neither desiring [it] nor transgressing [its limit] - then indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 3, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْمَيْتَةَ", "translit": "َẗَtْyَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَٱلدَّمَ", "translit": "َmَّdlٱَw", "root": "دمو"}, {"id": 6, "arabic": "وَلَحْمَ", "translit": "َmْḥَlَw", "root": "لحم"}, {"id": 7, "arabic": "ٱلْخِنزِيرِ", "translit": "ِryِznِhkْlٱ", "root": "خنزر"}, {"id": 8, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 9, "arabic": "أُهِلَّ", "translit": "َّlِhُaʾ", "root": "هلل"}, {"id": 10, "arabic": "لِغَيْرِ", "translit": "ِrْyَغِl", "root": "غير"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 14, "arabic": "ٱضْطُرَّ", "translit": "َّrُṭْḍٱ", "root": "ضرر"}, {"id": 15, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 16, "arabic": "بَاغٍ", "translit": "ٍغāَb", "root": "بغي"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "عَادٍ", "translit": "ٍdāَʿع", "root": "عدو"}, {"id": 19, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 22, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 116, "text": "وَلَا تَقُولُوا۟ لِمَا تَصِفُ أَلْسِنَتُكُمُ ٱلْكَذِبَ هَٰذَا حَلَٰلٌ وَهَٰذَا حَرَامٌ لِّتَفْتَرُوا۟ عَلَى ٱللَّهِ ٱلْكَذِبَۚ إِنَّ ٱلَّذِينَ يَفْتَرُونَ عَلَى ٱللَّهِ ٱلْكَذِبَ لَا يُفْلِحُونَ ", "translation": "And do not say about what your tongues assert of untruth, \"This is lawful and this is unlawful,\" to invent falsehood about Allāh. Indeed, those who invent falsehood about Allāh will not succeed.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 3, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 4, "arabic": "تَصِفُ", "translit": "ُfِṣَt", "root": "وصف"}, {"id": 5, "arabic": "أَلْسِنَتُكُمُ", "translit": "ُmُkُtَnِsْlَaʾ", "root": "لسن"}, {"id": 6, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 7, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 8, "arabic": "حَلَٰلٌ", "translit": "ٌlَٰlَḥ", "root": "حلل"}, {"id": 9, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 10, "arabic": "حَرَامٌ", "translit": "ٌmāَrَḥ", "root": "حرم"}, {"id": 11, "arabic": "لِّتَفْتَرُوا۟", "translit": "۟āwُrَtْfَtِّl", "root": "فري"}, {"id": 12, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}, {"id": 18, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "ٱلْكَذِبَ", "translit": "َbِhdَkْlٱ", "root": "كذب"}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "يُفْلِحُونَ", "translit": "َnwُḥِlْfُy", "root": "فلح"}], "hasIhya": false}, {"ayah": 117, "text": "مَتَٰعٌ قَلِيلٌ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "[It is but] a brief enjoyment, and they will have a painful punishment.", "words": [{"id": 1, "arabic": "مَتَٰعٌ", "translit": "ٌʿعَٰtَm", "root": "متع"}, {"id": 2, "arabic": "قَلِيلٌ", "translit": "ٌlyِlَq", "root": "قلل"}, {"id": 3, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 4, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 118, "text": "وَعَلَى ٱلَّذِينَ هَادُوا۟ حَرَّمْنَا مَا قَصَصْنَا عَلَيْكَ مِن قَبْلُۖ وَمَا ظَلَمْنَٰهُمْ وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ", "translation": "And to those who are Jews We have prohibited that which We related to you before.[1] And We did not wrong them [thereby], but they were wronging themselves.", "words": [{"id": 1, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 4, "arabic": "حَرَّمْنَا", "translit": "āَnْmَّrَḥ", "root": "حرم"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "قَصَصْنَا", "translit": "āَnْṣَṣَq", "root": "قصص"}, {"id": 7, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "ظَلَمْنَٰهُمْ", "translit": "ْmُhَٰnْmَlَẓ", "root": "ظلم"}, {"id": 12, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 13, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 14, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 15, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 119, "text": "ثُمَّ إِنَّ رَبَّكَ لِلَّذِينَ عَمِلُوا۟ ٱلسُّوٓءَ بِجَهَٰلَةٍ ثُمَّ تَابُوا۟ مِنۢ بَعْدِ ذَٰلِكَ وَأَصْلَحُوٓا۟ إِنَّ رَبَّكَ مِنۢ بَعْدِهَا لَغَفُورٌ رَّحِيمٌ ", "translation": "Then, indeed your Lord, to those who have done wrong out of ignorance and then repent after that and correct themselves - indeed, your Lord, thereafter, is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 4, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 5, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 6, "arabic": "ٱلسُّوٓءَ", "translit": "َءٓwُّslٱ", "root": "سوا"}, {"id": 7, "arabic": "بِجَهَٰلَةٍ", "translit": "ٍẗَlَٰhَjgِb", "root": "جهل"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "تَابُوا۟", "translit": "۟āwُbāَt", "root": "توب"}, {"id": 10, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 11, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "وَأَصْلَحُوٓا۟", "translit": "۟āٓwُḥَlْṣَaʾَw", "root": "صلح"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 16, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 17, "arabic": "بَعْدِهَا", "translit": "āَhِdْʿعَb", "root": "بعد"}, {"id": 18, "arabic": "لَغَفُورٌ", "translit": "ٌrwُfَغَl", "root": "غفر"}, {"id": 19, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 120, "text": "إِنَّ إِبْرَٰهِيمَ كَانَ أُمَّةً قَانِتًا لِّلَّهِ حَنِيفًا وَلَمْ يَكُ مِنَ ٱلْمُشْرِكِينَ ", "translation": "Indeed, Abraham was a [comprehensive] leader,[1] devoutly obedient to Allāh, inclining toward truth, and he was not of those who associate others with Allāh.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 5, "arabic": "قَانِتًا", "translit": "āًtِnāَq", "root": "قنت"}, {"id": 6, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 7, "arabic": "حَنِيفًا", "translit": "āًfyِnَḥ", "root": "حنف"}, {"id": 8, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 9, "arabic": "يَكُ", "translit": "ُkَy", "root": "كون"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": true}, {"ayah": 121, "text": "شَاكِرًا لِّأَنْعُمِهِۚ ٱجْتَبَىٰهُ وَهَدَىٰهُ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "[He was] grateful for His favors. He [i.e., Allāh] chose him and guided him to a straight path.", "words": [{"id": 1, "arabic": "شَاكِرًا", "translit": "āًrِkāَhs", "root": "شكر"}, {"id": 2, "arabic": "لِّأَنْعُمِهِ", "translit": "ِhِmُʿعْnَaʾِّl", "root": "نعم"}, {"id": 3, "arabic": "ٱجْتَبَىٰهُ", "translit": "ُhٰàَbَtْjgٱ", "root": "جبي"}, {"id": 4, "arabic": "وَهَدَىٰهُ", "translit": "ُhٰàَdَhَw", "root": "هدي"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 7, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 122, "text": "وَءَاتَيْنَٰهُ فِى ٱلدُّنْيَا حَسَنَةًۖ وَإِنَّهُۥ فِى ٱلْءَاخِرَةِ لَمِنَ ٱلصَّٰلِحِينَ ", "translation": "And We gave him good in this world, and indeed, in the Hereafter he will be among the righteous.", "words": [{"id": 1, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 4, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 5, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 9, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 123, "text": "ثُمَّ أَوْحَيْنَآ إِلَيْكَ أَنِ ٱتَّبِعْ مِلَّةَ إِبْرَٰهِيمَ حَنِيفًاۖ وَمَا كَانَ مِنَ ٱلْمُشْرِكِينَ ", "translation": "Then We revealed to you, [O Muḥammad], to follow the religion of Abraham, inclining toward truth; and he was not of those who associate with Allāh.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَوْحَيْنَآ", "translit": "ٓāَnْyَḥْwَaʾ", "root": "وحي"}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 5, "arabic": "ٱتَّبِعْ", "translit": "ْʿعِbَّtٱ", "root": "تبع"}, {"id": 6, "arabic": "مِلَّةَ", "translit": "َẗَّlِm", "root": "ملل"}, {"id": 7, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 8, "arabic": "حَنِيفًا", "translit": "āًfyِnَḥ", "root": "حنف"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": true}, {"ayah": 124, "text": "إِنَّمَا جُعِلَ ٱلسَّبْتُ عَلَى ٱلَّذِينَ ٱخْتَلَفُوا۟ فِيهِۚ وَإِنَّ رَبَّكَ لَيَحْكُمُ بَيْنَهُمْ يَوْمَ ٱلْقِيَٰمَةِ فِيمَا كَانُوا۟ فِيهِ يَخْتَلِفُونَ ", "translation": "The sabbath was only appointed for those who differed over it. And indeed, your Lord will judge between them on the Day of Resurrection concerning that over which they used to differ.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "جُعِلَ", "translit": "َlِʿعُjg", "root": "جعل"}, {"id": 3, "arabic": "ٱلسَّبْتُ", "translit": "ُtْbَّslٱ", "root": "سبت"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 9, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 10, "arabic": "لَيَحْكُمُ", "translit": "ُmُkْḥَyَl", "root": "حكم"}, {"id": 11, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 12, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 13, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 14, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 15, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 16, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 17, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": false}, {"ayah": 125, "text": "ٱدْعُ إِلَىٰ سَبِيلِ رَبِّكَ بِٱلْحِكْمَةِ وَٱلْمَوْعِظَةِ ٱلْحَسَنَةِۖ وَجَٰدِلْهُم بِٱلَّتِى هِىَ أَحْسَنُۚ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِۦۖ وَهُوَ أَعْلَمُ بِٱلْمُهْتَدِينَ ", "translation": "Invite to the way of your Lord with wisdom and good instruction, and argue with them in a way that is best. Indeed, your Lord is most knowing of who has strayed from His way, and He is most knowing of who is [rightly] guided.", "words": [{"id": 1, "arabic": "ٱدْعُ", "translit": "ُʿعْdٱ", "root": "دعو"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 4, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 5, "arabic": "بِٱلْحِكْمَةِ", "translit": "ِẗَmْkِḥْlٱِb", "root": "حكم"}, {"id": 6, "arabic": "وَٱلْمَوْعِظَةِ", "translit": "ِẗَẓِʿعْwَmْlٱَw", "root": "وعظ"}, {"id": 7, "arabic": "ٱلْحَسَنَةِ", "translit": "ِẗَnَsَḥْlٱ", "root": "حسن"}, {"id": 8, "arabic": "وَجَٰدِلْهُم", "translit": "mُhْlِdَٰjgَw", "root": "جدل"}, {"id": 9, "arabic": "بِٱلَّتِى", "translit": "àِtَّlٱِb", "root": ""}, {"id": 10, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 11, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 12, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 13, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 16, "arabic": "بِمَن", "translit": "nَmِb", "root": ""}, {"id": 17, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 18, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 19, "arabic": "سَبِيلِهِۦ", "translit": "ۦِhِlyِbَs", "root": "سبل"}, {"id": 20, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 21, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 22, "arabic": "بِٱلْمُهْتَدِينَ", "translit": "َnyِdَtْhُmْlٱِb", "root": "هدي"}], "hasIhya": true}, {"ayah": 126, "text": "وَإِنْ عَاقَبْتُمْ فَعَاقِبُوا۟ بِمِثْلِ مَا عُوقِبْتُم بِهِۦۖ وَلَئِن صَبَرْتُمْ لَهُوَ خَيْرٌ لِّلصَّٰبِرِينَ ", "translation": "And if you punish [an enemy, O believers], punish with an equivalent of that with which you were harmed.[1] But if you are patient - it is better for those who are patient.", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 2, "arabic": "عَاقَبْتُمْ", "translit": "ْmُtْbَqāَʿع", "root": "عقب"}, {"id": 3, "arabic": "فَعَاقِبُوا۟", "translit": "۟āwُbِqāَʿعَf", "root": "عقب"}, {"id": 4, "arabic": "بِمِثْلِ", "translit": "ِlْhtِmِb", "root": "مثل"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "عُوقِبْتُم", "translit": "mُtْbِqwُʿع", "root": "عقب"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 9, "arabic": "صَبَرْتُمْ", "translit": "ْmُtْrَbَṣ", "root": "صبر"}, {"id": 10, "arabic": "لَهُوَ", "translit": "َwُhَl", "root": ""}, {"id": 11, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 12, "arabic": "لِّلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlِّl", "root": "صبر"}], "hasIhya": true}, {"ayah": 127, "text": "وَٱصْبِرْ وَمَا صَبْرُكَ إِلَّا بِٱللَّهِۚ وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُ فِى ضَيْقٍ مِّمَّا يَمْكُرُونَ ", "translation": "And be patient, [O Muḥammad], and your patience is not but through Allāh. And do not grieve over them and do not be in distress over what they conspire.", "words": [{"id": 1, "arabic": "وَٱصْبِرْ", "translit": "ْrِbْṣٱَw", "root": "صبر"}, {"id": 2, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 3, "arabic": "صَبْرُكَ", "translit": "َkُrْbَṣ", "root": "صبر"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَحْزَنْ", "translit": "ْnَzْḥَt", "root": "حزن"}, {"id": 8, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "تَكُ", "translit": "ُkَt", "root": "كون"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ضَيْقٍ", "translit": "ٍqْyَḍ", "root": "ضيق"}, {"id": 13, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 14, "arabic": "يَمْكُرُونَ", "translit": "َnwُrُkْmَy", "root": "مكر"}], "hasIhya": false}, {"ayah": 128, "text": "إِنَّ ٱللَّهَ مَعَ ٱلَّذِينَ ٱتَّقَوا۟ وَّٱلَّذِينَ هُم مُّحْسِنُونَ ", "translation": "Indeed, Allāh is with those who fear Him and those who are doers of good.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "ٱتَّقَوا۟", "translit": "۟āwَqَّtٱ", "root": "وقي"}, {"id": 6, "arabic": "وَّٱلَّذِينَ", "translit": "َnyِhdَّlٱَّw", "root": ""}, {"id": 7, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 8, "arabic": "مُّحْسِنُونَ", "translit": "َnwُnِsْḥُّm", "root": "حسن"}], "hasIhya": true}], "tafsir": {"8": [{"arabic": "ووجود الأشياء كلها نور من أنوار ذاته تعالى وتقدس إذ قوام وجود الأشياء بذاته القيوم بنفسه كما أن قوام نور الأجسام بنور الشمس المضيئة بنفسها ومهما انكشف بعض الشمس فقد جرت العادة بأن يوضع طشت ماء حتى ترى الشمس فيه ويمكن النظر إليها فيكون الماء واسطة يغض قليلا من نور الشمس حتى يطاق النظر إليها فكذلك الأفعال واسطة نشاهد فيها صفات الفاعل ولا نبهر بأنوار الذات بعد أن تباعدنا عنها بواسطة الأفعال فهذا سر قوله صلى الله عليه وسلم تفكروا في خلق الله ولا تتفكروا في ذات الله تعالى. بيان كيفية التفكر في خلق ال", "english": "And the existence of all things is a light from the lights of His Essence, Exalted and Holy, since the subsistence of the existence of things is by His Self-Subsisting Essence, just as the subsistence of the light of bodies is by the light of the sun that illuminates by itself. And whenever some of the sun is uncovered, it has become customary to place a basin of water so that the sun may be seen in it and it becomes possible to look at it, so the water becomes a medium that slightly reduces the light of the sun until it can be endured to look at. Likewise, actions are a medium through which we witness the attributes of the Actor, and we are not dazzled by the lights of the Essence after we have distanced ourselves from it through the medium of actions. This is the secret of His saying, peace be upon him: 'Reflect upon the creation of Allah and do not reflect upon the Essence of Allah, Exalted.' Explanation of the manner of reflecting upon the creation of Allah, Exalted. Know that everything in existence other than Allah, Exalted, is the action and creation of Allah, and every atom of the atoms, whether substance, accident, attribute, or described thing, contains wonders and marvels through which the wisdom, power, majesty, and greatness of Allah appear. Enumerating that is not possible, for if the sea were ink for that, the sea would be exhausted before a tenth of its tenth is exhausted. But we point to a summary of it so that it may serve as an example for what is beyond it. So we say: The created existents are divided into that whose origin is not known, so we cannot reflect upon it, and how many existents are there that we do not know, as Allah, Exalted, said: 'And He creates what you do not know. Glory be to Him who created all pairs from what the earth grows and from themselves and from what they do not know.' And He said: 'And We will develop you in what you do not know.' And into that whose origin and summary is known but whose details are not known, so we can reflect upon its details. And it is divided into what we perceive by the sense of sight and into what we do not perceive by sight. As for what we do not perceive by sight, such as the angels, jinn, devils, the Throne (Al-'Arsh), the Footstool (Al-Kursi), and other than that, the field of thought in these things is narrow and obscure, so let us turn to what is closer to comprehension, which is what is perceived by the sense of sight, and that is the seven heavens and the earth and what is between them. So the heavens are observed with their stars, sun, moon, movement, and rotation in their rising and setting; and the earth is observed with what is in it of its mountains, minerals, rivers, seas, animals, and plants; and what is between the sky and the earth, which is the atmosphere, is perceived with its clouds, rains, snows, thunder, lightning, thunderbolts, meteors, and stormy winds. These are the observable genera from the heavens and the earth and what is between them, and every genus of them divides into species, and every species divides into categories, and every category branches into varieties, and there is no end to the branching and division of that in the differences of its attributes, forms, and apparent and hidden meanings, and all of that is a field for thought. So not an atom moves in the heavens...", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "9": [{"arabic": "وَعَلَى اللَّهِ قَصْدُ السَّبِيلِ وَمِنْهَا جَائِرٌ ۚ وَلَوْ شَاءَ لَهَدَاكُمْ أَجْمَعِينَ وقال على كرم الله وجهه الهوى شريك العمى ومن التوفيق التوقف عند الحيرة ونعم طارد الهم اليقين وعاقبة الكذب الندم وفي الصدق السلامة رب بعيد أقرب من قريب وغريب من لم يكن له حبيب والصديق من صدق غيبه ولا يعدمك من حبيب سوء ظن نعم الخلق التكرم والحياء سبب إلى كل جميل وأوثق العرا التقوى واوثق سبب أخذت به سبب بينك وبين الله تعالى إنما لك من دنياك ما أصلحت به مثواك والرزق رزقان رزق تطلبه ورزق يطلبك فان لم تأته أتاك و", "english": "And upon Allah is the straightening of the path, and among them are deviant ones. And if He had willed, He would have guided you all. And Ali (may Allah honor his face) said: Desire (Hawa) is a partner of blindness. And from success (Tawfiq) is stopping at perplexity. And an excellent dispeller of worry is certainty (Yaqin). And the consequence of lying is regret. And in truthfulness is safety. A distant lord is closer than a close one, and a stranger is one who has no beloved. And the truthful friend (Sadiq) is one who is truthful in his absence. And do not let a beloved be lacking in you due to bad suspicion. An excellent character is generosity (Takrim). And modesty (Haya) is a means to every beautiful thing. And the most secure bond is piety (Taqwa). And the most secure means you have taken is a means between you and Allah. Indeed, what you have from your worldly life is what you have rectified with your abode. And provision (Rizq) is of two types: provision you seek and provision that seeks you. So if you do not come to it, it will come to you. And if you are distressed over what has befallen you from what is in your hands, then do not be distressed over what has not reached you. And infer about what has not been from what has been, for matters are similar. And a person is pleased by attaining what would not have escaped him and is displeased by missing what he would not have attained. So what reaches you from your worldly life, do not excessively rejoice in it, and what escapes you from it, do not let your soul (Nafs) follow it with regret. And let your joy be in what you have sent forth and your regret over what you have left behind. And your occupation be for your hereafter and your concern in what is after death. And our purpose in transmitting these words is his saying: And from success (Tawfiq) is stopping at perplexity.", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "12": [{"arabic": "والعالم الراسخ هو الذي يطلع على أن الشمس والقمر والنجوم مسخرات بأمره سبحانه وتعالى ومثال نظر الضعيف إلى حصول ضوء الشمس عقيب طلوع الشمس مثال النملة لو خلق لها عقل وكانت على سطح قرطاس وهي تنظر إلى سواد الخط يتجدد فتعتقد أنه فعل القلم ولا تترقى في نظرها إلى مشاهدة الأصابع ثم منها إلى اليد ثم منها إلى الإرادة المحركة اليد ثم منها إلى الكاتب القادر المريد ثم منه إلى خالق اليد والقدرة والإرادة فأكثر نظر الخلق مقصور على الأسباب القريبة السافلة مقطوع من الترقي إلى مسبب الأسباب فهذا أحد أسباب النهي عن ال", "english": "And the firmly established scholar (Alim) is the one who perceives that the sun, the moon, and the stars are subjugated by His command, glorified and exalted is He. The example of the weak person's view regarding the occurrence of sunlight following the rising of the sun is like an ant, if intellect were created for it and it were on the surface of a paper, and it looks at the blackness of the line being renewed, so it believes it is the action of the pen, and it does not ascend in its view to witnessing the fingers, then from them to the hand, then from them to the will (Iradah) that moves the hand, then from them to the writer who is capable (Qadir) and willing (Murid), then from him to the creator of the hand, the capability (Qudrah), and the will (Iradah). So most of the view of creation is restricted to the proximate, lowly causes, cut off from ascending to the causer of causes. This is one of the reasons for the prohibition regarding the stars.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Book of Knowledge'", "badge": "Dhikr"}], "18": [{"arabic": "وإذا كانت تلك الأسباب طويلة لا يحتمل مثل هذا الكتاب استقصاءها فلنذكر منها أنموذجا ليعلم به معنى قوله تعالى: ﴿ وإن تعدوا نعمة الله لا تحصوها ﴾ وبالله التوفيق. (بيان وجه الأنموذج في كثرة نعم الله تعالى وتسلسلها وخروجها عن الحصر والإحصاء) اعلم أنا جمعنا النعم في ستة عشر ضربا وجعلنا صحة البدن نعمة من النعم الواقعة في الرتبة المتأخرة فهذه النعمة الواحدة لو أردنا أن نستقصى الأسباب التي بها تمت هذه النعمة لم نقدر عليها ولكن الأكل أحد أسباب الصحة فلنذكر نبذة من جملة الأسباب التي بها تتم نعمة الأكل فلا ي", "english": "And since those causes are lengthy, a book like this cannot bear their exhaustive enumeration, so let us mention from them a model to understand by it the meaning of His saying, the Exalted: 'And if you count the blessings of Allah, you cannot enumerate them' (Quran 16:18). And by Allah is success. (Explanation of the aspect of the model in the abundance of Allah's blessings and their sequence and their departure from enumeration and counting) Know that we have gathered the blessings into sixteen types, and we made the health of the body a blessing from the blessings occurring in the later rank. So this single blessing, if we wanted to exhaustively enumerate the causes by which this blessing is completed, we would not be able to do so. But eating is one of the causes of health, so let us mention a portion from the totality of causes by which the blessing of eating is completed. It is not hidden that eating is an action, and every action of this type is a movement, and every movement necessarily has a moving body that is its instrument, and necessarily has a power (Qudrah) over the movement, and necessarily has a will (Iradah) for the movement, and necessarily has knowledge (Ilm) of what is intended and perception (Idrak) of it. And eating necessarily has food (Mā'kul), and the food necessarily has an origin from which it is obtained, and necessarily has a maker (Sāni') who prepares it. So let us mention the causes of perception, then the causes of wills, then the causes of power, then the causes of food, by way of allusion, not by way of exhaustive enumeration. (The first aspect in Allah's blessings in creating the causes of perception) Know that Allah, the Exalted, created the plant, and it is more complete in existence than the stone, the clay, the iron, the copper, and the rest of the jewels that do not grow and do not nourish, for the plant...", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وجملة ما عرفناه وعرفه الخلق كلهم بالإضافة إلى ما لم يعرفوه من نعم الله تعالى أقل من قطرة من بحر إلا أن من علم شيئا من هذا أدرك شمة من معانى قوله تعالى: ﴿ وإن تعدوا نعمة الله لا تحصوها ﴾ ثم انظر كيف ربط الله تعالى قوام هذه الأعضاء وقوام منافعها وإدراكاتها وقواها ببخار لطيف يتصاعد من الأخلاط الأربعة ومستقرة القلب ويسرى في جميع البدن بواسطة العروق الضوارب فلا ينتهى إلى جزء من أجزاء البدن إلا ويحدث عند وصوله في تلك الأجزاء ما يحتاج إليه من قوة حس وإدراك وقوة حركة وغيرها كالسراج الذى يدار في أطراف ال", "english": "And the totality of what we have known and what all creation has known, in addition to what they have not known of the blessings of Allah the Exalted, is less than a drop from an ocean. However, whoever knows something of this perceives a whiff of the meanings of His saying the Exalted: 'And if you should count the blessings of Allah, you could not enumerate them.' Then look how Allah the Exalted has tied the uprightness of these limbs and the uprightness of their benefits, their perceptions, and their powers to a subtle vapor that ascends from the four humors and is settled in the Heart (Qalb) and flows in all the body by means of the pulsating veins. So it does not reach a part from the parts of the body except that it causes, upon its arrival in those parts, what is needed from it of sensory power, perception, power of movement, and others, like the lamp that is circulated in the corners of the house. So it does not reach a part except that there occurs, due to its arrival, light upon the parts of the house from the creation of Allah the Exalted and His invention, but He made the lamp a cause for it by His wisdom. And this subtle vapor is what the physicians call the Spirit (Ruh), and its place is the Heart (Qalb), and its example is the fiery substance of the lamp, and the Heart (Qalb) is for it like the lamp-holder, and the black blood that is in the interior of the Heart (Qalb) is for it like the wick, and the nourishment is for it like the oil, and the apparent life in the rest of the body's limbs because of it is like the light for the lamp in the entirety of the house. And just as the lamp, if its oil is cut off, is extinguished, so the lamp of the Spirit (Ruh) also is extinguished whenever its nourishment is cut off. And just as the wick may burn and become ashes such that it does not accept the oil, so the lamp is extinguished with abundance of oil, likewise the blood that this vapor clings to in the Heart (Qalb) may burn due to excessive heat of the Heart (Qalb) and is extinguished with the presence of nourishment, for it does not accept the nourishment that", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "ومنشأ كل ترتيب وتأليف وكل ذلك نعم من رب الأرباب ومسبب الأسباب ولولا فضله وكرمه إذ قال تعالى: ﴿ والذين جاهدوا فينا لنهدينهم سبلنا ﴾ لما اهتدينا إلى هذه النبذة اليسيرة من نعم الله تعالى ولولا عزله إيانا عن أن نطمح بعين الطمع إلى الإحاطة بكنه نعمه لتشوفنا إلى طلب الإحاطة والاستقصاء ولكنه تعالى عزنا بحكم القهر والقدرة فقال تعالى: ﴿ وإن تعدوا نعمة الله لا تحصوها ﴾ فإن تكلمنا فبإذنه انبسطنا وإن سكنا فبقهره انقبضنا، إذ لا معطى لما منع ولا مانع لما أعطى لأنا في كل لحظة من لحظات العمر قبل الموت نسمع بسمع", "english": "And the origin of every arrangement and composition, and all of that is blessings from the Lord of lords and the Causer of causes. And were it not for His grace and generosity when He, the Exalted, said: \"And those who strive in Us, We will surely guide them to Our ways\" (Quran 29:69), we would not have been guided to this small portion of the blessings of Allah, the Exalted. And were it not for His isolating us from aspiring with the eye of greed to encompass the essence of His blessings, we would have yearned to seek encompassing and exhaustive enumeration. But He, the Exalted, isolated us by the decree of overpowering and power, so He, the Exalted, said: \"And if you should count the blessings of Allah, you could not enumerate them\" (Quran 16:18). So if we speak, it is by His permission that we expand; and if we remain silent, it is by His overpowering that we contract, for there is no giver of what He has withheld nor withholder of what He has given. Because we, in every moment of the moments of life before death, hear with the hearing of the hearts (Qulūb) the call of the Compelling King: \"To whom belongs the dominion today? To Allah, the One, the Compeller\" (Quran 40:16). So praise be to Allah who distinguished us from the disbelievers and made us hear this call before the expiration of lifetimes.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Patience and Gratitude'", "badge": "Ethics"}, {"arabic": "وفي الخبر \"لا يستدير الرغيف ويوضع بين يديك حتى يعمل في ثلثمائة وستون صانعاً أولهم ميكائيل عليه السلام الذي يكيل الماء من خزائن الرحمة، ثم الملائكة التي تزجي السحاب والشمس والقمر والأفلاك وملائكة الهواء ودواب الأرض، وآخرهم الخباز \"وإن تعدوا نعمة الله لا تحصوها\"[46]", "english": "And in the report: 'The loaf does not become round and placed before you until three hundred and sixty workers have worked on it, the first of them being Mikail (Michael), peace be upon him, who measures the water from the treasuries of mercy (Rahmah), then the angels who drive the clouds, the sun, the moon, the celestial spheres, the angels of the air, and the creatures of the earth, and the last of them is the baker.' 'And if you count the blessings (Ni'mah) of Allah, you cannot enumerate them.'", "book_file": "vol3_Vol3-book3a.doc.txt", "book_title": "Harms of the Tongue", "content_type": "fiqh", "topic": "Al-Ghazali on the outer and inner dimensions of worship, from 'Harms of the Tongue'", "badge": "Worship"}, {"arabic": "وكما عرفت أن في كل طرفة عين نعما كثيرة فاعلم أن في كل نفس ينبسط وينقبض نعمتين إذ بانبساطه يخرج الدخان المحترق من القلب ولو لم يخرج لهلك وبانقبضه يجمع روح الهواء إلى القلب ولو سد متنفسه لاحترق قلبه بانقطاع روح الهواء وبرودته عنه وهلك بل اليوم والليلة أربع وعشرون ساعة وفي كل ساعة قريب من ألف نفس وكل نفس قريب من عشر لحظات فعليك في كل لحظة آلاف آلاف نعمة في كل جزء من أجزاء بدنك بل في كل جزء من أجزاء العالم فانظر هل يتصور إحصاء ذلك أم لا، ولما انكشف لموسى عليه السلام حقيقة قوله تعالى: ﴿ وإن تعدوا نعم", "english": "And as you know that in every blink of an eye there are many blessings, so know that in every breath that expands and contracts there are two blessings: with its expansion, it expels the burnt smoke from the Heart (Qalb), and if it did not expel it, it would perish; and with its contraction, it gathers the spirit of air to the Heart (Qalb), and if its breathing passage were blocked, its Heart (Qalb) would burn from the cutting off of the spirit of air and its cooling from it, and it would perish. Rather, the day and night are twenty-four hours, and in every hour there are about a thousand breaths, and every breath is about ten moments, so upon you in every moment are thousands upon thousands of blessings in every part of the parts of your body, nay in every part of the parts of the world. So look: is it conceivable to enumerate that or not? And when the reality of His saying, the Exalted, was revealed to Moses, peace be upon him: 'And if you count the blessings of Allah, you cannot enumerate them' (Quran 16:18), he said: 'My God, how can I thank You when for every hair on my body there are two blessings: that You softened its root and that You blunted its tip.' And likewise, it has come in the tradition that whoever does not recognize the blessings of Allah in his food and drink, then his knowledge has diminished and his punishment has drawn near. And all that we have mentioned returns to food and drink, so consider what is other than them from the blessings by it, for the insightful one does not cast his eye in the world upon anything, nor does his thought touch upon an existent, except that he realizes that Allah has in it a blessing upon him. So let us leave exhaustive detailing, for it is aspiration in what is not attainable.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "22": [{"arabic": "وشر أنواع الكبر ما يمنع من استفادة العلم وقبول الحق والانقياد له وفيه وردت الآيات التي فيها ذم الكبر والمتكبرين قال الله تعالى \"والملائكة باسطو أيديهم\" إلى قوله \"وكنتم عن آياته تستكبرون\" ثم قال \"ادخلوا أبواب جهنم خالدين فيها فبئس مثوى المتكبرين\" ثم أخبر أن أشد أهل النار عذاباً أشدهم عتياً على الله تعالى فقال \"ثم لننزعن من كل شبعة أيهم أشد على الرحمن عتياً\" وقال تعالى \"فالذين لا يؤمنون بالآخرة قلوبهم منكرة وهم مستكبرون\" وقال عز وجل \"يقول الذين استضعفوا للذين استكبروا لولا أنتم لكنا مؤمنين\" وقال ت", "english": "And the worst types of arrogance (Kibr) are what prevent from benefiting from knowledge and accepting the truth and submitting to it. In it have come the verses which contain censure of arrogance (Kibr) and the arrogant ones. Allah the Exalted said: 'And the angels will be spreading their hands' up to His saying: 'and you were arrogant (Tastakbirun) about His signs.' Then He said: 'Enter the gates of Hell, abiding eternally therein, and wretched is the residence of the arrogant (Mutakabirin).' Then He informed that the most severely punished of the people of the Fire are the most insolent (Atiyan) against Allah the Exalted, so He said: 'Then We will surely extract from every sect those of them who were most insolent (Atiyan) against the Most Merciful.' And He the Exalted said: 'So those who do not believe in the Hereafter, their hearts (Qulub) are denying (Munkirah) and they are arrogant (Mustakbirun).' And He the Mighty and Majestic said: 'Those who were oppressed say to those who were arrogant (Istakbaru): \"If not for you, we would have been believers.\"' And He the Exalted said: 'Indeed, those who are arrogant (Yastakbirun) about My worship will enter Hell in humiliation.' And He the Exalted said: 'I will turn away from My signs those who are arrogant (Yatakabbarun) in the earth without right.' It is said in the interpretation (Tafsir): I will lift the understanding of the Quran from their hearts (Qulub). And in some interpretations (Tafsir): I will veil their hearts (Qulub) from the dominion (Malakut). And Ibn Juraij said: I will turn them away from reflecting upon them and taking admonition from them. And therefore, Jesus (Isa) peace be upon him said: Indeed, the crop grows in the plain and does not grow upon the rock, likewise wisdom (Hikmah) works in the heart (Qalb) of the humble one and does not work in the heart (Qalb) of the arrogant one (Mutakabbir). Do you not see that whoever raises his head to the ceiling strikes it, and whoever lowers it is shaded and sheltered. So this is a parable he struck for the arrogant ones (Mutakabirin) and how they are deprived of wisdom (Hikmah). And therefore, the Messenger of Allah (peace be upon him) mentioned the rejection (Juhud) of the truth as part of the definition of arrogance (Kibr) and the uncovering of its reality, and he said: 'Whoever belittles the truth and looks down upon people.'", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "23": [{"arabic": "قد ذم الله الكبر في مواضع من كتابه وذم كل جبار متكبر فقال تعالى \"سأصرف عن آياتي الذين يتكبرون في الأرض بغير الحق\" وقال عز وجل \"كذلك يطبع الله على كل قلب متكبر جبار\" وقال تعالى \"واستفتحوا وخاب كل جبار عنيد\" وقال تعالى \"إنه لا يحب المستكبرين\" وقال تعالى \"لقد استكبروا في أنفسهم وعتوا عتواً كبيراً\" وقال تعالى \"إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين\" وذم الكبر في القرآن كثير وقد قال رسول الله ﭬ \"لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر، ولا يدخل النار من كان في قلبه مثقال حبة من", "english": "Indeed, Allah has condemned arrogance in multiple places in His Book and condemned every tyrant who is arrogant. So He, the Exalted, said: \"I will turn away from My signs those who are arrogant on earth without right\" and He, the Mighty and Majestic, said: \"Thus does Allah seal over every arrogant, tyrannical heart (Qalb)\" and He, the Exalted, said: \"And they sought victory, and every obstinate tyrant failed\" and He, the Exalted, said: \"Indeed, He does not love the arrogant ones\" and He, the Exalted, said: \"They have certainly become arrogant within themselves and transgressed a great transgression\" and He, the Exalted, said: \"Indeed, those who are arrogant toward My worship will enter Hell in humiliation.\" And the condemnation of arrogance in the Quran is abundant. And the Messenger of Allah ﭬ said: \"He will not enter Paradise who has in his heart (Qalb) the weight of a mustard seed of arrogance, and he will not enter the Fire who has in his heart (Qalb) the weight of a mustard seed of faith (Iman).\"", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "33": [{"arabic": "فإذا عرفت أن الأخلاق الحسنة تارة تكون بالطبع والفطرة، تكون باعتياد الأفعال الجميلة، وتارة بمشاهدة أرباب الفعال الجميلة ومصاحبتهم وهم قرناء الخير وإخوان الصلاح، إذ الطبع يسرق من الطبع الشر والخير جميعاً. فمن تظاهرت في حقه الجهات الثلاث حتى صار ذا فضيلة طبعاً واعتياداً وتعلماً فهو في غاية الفضيلة، ومن كان رذلاً بالطبع واتفق له قرناء السوء فتعلم منهم وتيسرت له أسباب الشر حتى اعتادها فهو في غاية البعد من الله عز وجل، وبين الرتبتين من اختلفت فيه من هذه الجهات ولكل درجة في القرب والبعد بحسب ما تقتضيه ", "english": "If you know that good character traits (Akhlaq) are sometimes by nature (Tab') and innate disposition (Fitrah), sometimes by habitual practice (I'tiyad) of beautiful actions, and sometimes by observing masters of beautiful deeds and accompanying them—they being companions of good (Qurana' al-Khayr) and brothers of righteousness (Ikhwan al-Salah)—since nature steals from nature both evil and good. So whoever has all three aspects manifest in his case until he becomes virtuous by nature, habit, and learning, he is at the peak of virtue. And whoever is base by nature and happens to have evil companions, learns from them, and finds the means of evil facilitated for him until he habituates them, he is at the peak of distance from Allah, the Exalted and Majestic. And between these two ranks are those who differ in these aspects, and each degree in closeness and distance is according to what his form and state necessitate: \"So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it. And Allah did not wrong them, but they were wronging their own souls (Anfus).\"", "book_file": "vol3_Vol3-book2a.doc.txt", "book_title": "Breaking the Two Desires", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "40": [{"arabic": "ومن هذا القبيل في كنايته عن الاقتدار قوله تعالى: ﴿ إنما قولنا لشيء إذا أردناه أن نقول له كن فيكون ﴾ {} فإن ظاهره ممتنع إذ قوله كن إن كان خطابا للشيء قبل وجوده فهو محال إذا المعدوم لا يفهم الخطاب حتى يمثل وإن كان بعد الوجود فهو مستغن عن التكوين ولكن لما كانت هذه الكناية أوقع في النفوس في تفهيم غاية الاقتدار عدل إليها.", "english": "And from this category in its metaphor for power (Iqtidar) is His saying, the Exalted: 'Indeed, Our word to a thing when We intend it is that We say to it, \"Be,\" and it is.' For its apparent meaning is impossible, because His saying 'Be' - if it is an address to the thing before its existence, it is impossible since the non-existent does not understand the address until it is represented; and if it is after existence, it is independent of formation. But since this metaphor is more impactful in the souls (Nufus) in making understood the utmost power (Iqtidar), He turned to it.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Foundations of Belief'", "badge": "Insight"}], "42": [{"arabic": "وترك الأسباب الدافعة وإن كانت مقطوعة وجه إذا ناله الضرر من إنسان، فإنه إذا أمكنه الصبر وأمكنه الدفع والتشفي فشرط التوكل الاحتمال والصبر، قال الله تعالى: \" فاتخذه وكيلاً واصبر على ما يقولون \". وقال تعالى: \" ولنصبرن على ما آذيتمونا وعلى الله فليتوكل المتوكلون \". وقال عز وجل: \" ودع أذاهم وتوكل على الله \". وقال سبحانه وتعالى: \" فاصبر كما صبر أولو العزم من الرسل \". وقال تعالى: \" نعم أجر العاملين الذين صبروا وعلى ربهم يتوكلون \" وهذا في أذى الناس، وأما الصبر على أذى الحيات والسباع والعقارب، فترك دفعها ", "english": "And abandoning the repelling causes, even if they are certain, is a face when harm reaches him from a human, for if patience is possible for him and repelling and retaliation are possible, then the condition of reliance (Tawakkul) is endurance and patience. Allah the Exalted said: \"So take Him as a disposer of affairs (Wakil) and be patient over what they say.\" And He the Exalted said: \"And we will be patient over what you harm us, and upon Allah let the reliant ones rely (Yatawakkal).\" And He the Mighty and Majestic said: \"And leave their harm and rely (Tawakkul) upon Allah.\" And He the Blessed and Exalted said: \"So be patient as the possessors of resolve (Ulul-Azm) from the messengers were patient.\" And He the Exalted said: \"Excellent is the reward of the doers, those who were patient (Sabaru) and upon their Lord they rely (Yatawakkalun).\" And this is regarding the harm of people. As for patience over the harm of snakes, beasts, and scorpions, abandoning repelling them is not from reliance (Tawakkul) in anything, for there is no benefit in it, and the striving is not intended nor is the striving abandoned for its own sake but for aiding in the religion (Deen). And the arrangement of causes here is like their arrangement in earning and bringing benefits, so we do not prolong with repetition. And likewise in the causes repelling from wealth, reliance (Tawakkul) is not diminished by closing the door of the house when going out nor by tying the camel, because these are causes known by the Sunnah of Allah the Exalted, either certainly or presumptively. And for that reason, he ﷺ said to the Bedouin when he neglected the camel and said 'I have relied (Tawakkaltu) upon Allah': 'Tie it and rely (Tawakkul).' And He the Exalted said: 'Take your precaution.' And He said regarding the manner of the prayer of fear: 'And let them take their weapons.' And He the Blessed said: 'And prepare for them what you are able of power and of tethering horses.' And He the Exalted said to Musa, peace be upon him: 'So travel by night with My servants.' And fortifying by night is hiding from the eyes of enemies and a type of causing, and the hiding of the Messenger of Allah ﷺ in the cave is hiding from the eyes of enemies repelling harm. And taking weapons in prayer is not a repeller certainly like killing the snake and scorpion, for it is a repeller certainly, but taking weapons is a presumptive cause, and we have clarified that the presumptive is like the certain, and only the imagined is what reliance (Tawakkul) necessitates abandoning.", "book_file": "vol4_Vol4-book5.doc.txt", "book_title": "Monotheism and Reliance", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "43": [{"arabic": "فإن قلت فقد قال الله تعالى: (فاسألوا أهل الذكر إن كنتم لا تعلمون( (النحل: 43). فالسؤال مأمور به فاعلم أنه كذلك ولكن فيما يأذن المعلم في السؤال عنه فإن السؤال عما لم تبلغ مرتبتك إلى فهمه مذموم ولذلك منع الخضر موسى عليه السلام من السؤال أي دع السؤال قبل أوانه فالمعلم أعلم بما أنت أهل له وبأوان الكشف وما لم يدخل أوان الكشف في كل درجة من مراقي الدرجات لا يدخل أوان السؤال عنه", "english": "If you say: Indeed, Allah the Exalted has said: 'So ask the people of the Remembrance (Dhikr) if you do not know' (An-Nahl: 43). So asking is commanded. Know that it is indeed so, but only regarding what the teacher permits you to ask about. For asking about what your rank has not reached to understand is blameworthy, and for that reason, Al-Khidr prevented Musa (peace be upon him) from asking, meaning: leave the question before its proper time. The teacher knows better what you are worthy of and the time of unveiling (Kashf), and what has not entered the time of unveiling in every degree of the ascending degrees (Marāqī al-Darajāt) does not enter the time of questioning about it.", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "وقال الزهري رحمه الله العلم ذكر ولا تحبه إلا ذكران الرجال.\n\n                                فضيلة التعلم\n\nأما الآيات فقوله تعالى: ﴿فلولا نفر من كل فرقة منهم طائفة ليتفقهوا في الدين﴾ (سورة التوبة: الآية 122) وقوله عز وجل ﴿فاسألوا أهل الذكر إن كنتم لا تعلمون﴾ (سورة النحل: الآية 43، وسورة الأنبياء: الآية 7)", "english": "And Al-Zuhri, may Allah have mercy upon him, said: Knowledge is Remembrance (Dhikr), and none love it except the men of Remembrance (Dhikr).\n\n                                The Virtue of Learning\n\nAs for the verses, then His saying, the Exalted: 'Then why should not a party from every group of them go forth to gain understanding in the religion?' (Surah At-Tawbah: Verse 122) and His saying, the Mighty and Majestic: 'So ask the people of the Remembrance (Dhikr) if you do not know.' (Surah An-Nahl: Verse 43, and Surah Al-Anbiya: Verse 7)", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "والمقصود أن من قصد الخير بمعصية عن جهل فهو غير معذور إلا إذا كان قريب العهد بالإسلام ولم يجد بعد مهلة للتعلم وقد قال الله سبحانه فاسئلوا أهل الذكر إن كنتم لا تعلمون وقال النبي صلى الله عليه وسلم (لا يعذر الجاهل على الجهل ولا يحل للجاهل أن يسكت على جهله ولا للعالم أن يسكت على علمه)[24]", "english": "The intended meaning is that whoever intends good through disobedience out of ignorance is not excused, except if he is newly converted to Islam and has not yet found an opportunity for learning. And Allah the Exalted has said: 'So ask the people of the Remembrance (Dhikr) if you do not know.' And the Prophet, peace and blessings be upon him, said: 'The ignorant one is not excused for his ignorance, nor is it permissible for the ignorant one to remain silent about his ignorance, nor for the knowledgeable one to remain silent about his knowledge.'", "book_file": "vol4_j4-k07-old.doc.txt", "book_title": "Intention, Sincerity and Truthfulness", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Intention, Sincerity and Truthfulness'", "badge": "Dhikr"}, {"arabic": "وأعظم نعمة الله على عباده هو العلم وكشف الحق والإيمان عبارة عن نوع كشف وعلم ولذلك قال تعالى امتنانا على عبده وكان فضل الله عليك عظيما وأراد به العلم وقال تعالى فاسألوا أهل الذكر إن كنتم لا تعلمون", "english": "And the greatest blessing of Allah upon His servants is knowledge and the unveiling of truth, and faith is an expression of a type of unveiling and knowledge. Therefore, Allah the Exalted said, as a favor upon His servant: 'And great is the grace of Allah upon you' (Quran 4:113), and He intended by it knowledge. And He said: 'So ask the people of the Remembrance (Dhikr) if you do not know' (Quran 16:43).", "book_file": "vol4_j4-k08.doc.txt", "book_title": "Monitoring and Accounting", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "44": [{"arabic": "ولذلك قال تعالى ﴿ ما نثبت به فؤادك ﴾ {} فليقدر العبد أن الله ثبت فؤاده بما يقصه عليه من أحوال الأنبياء وصبرهم على الإيذاء وثباتهم في الدين لانتظار نصر الله تعالى وكيف لا يقدر هذا والقرآن ما أنزل على رسول الله ﭬ لرسول الله خاصة بل هو شفاء وهدى ورحمة ونور للعالمين ولذلك أمر الله تعالى الكافة بشكر نعمة الكتاب فقال تعالى ﴿ واذكروا نعمة الله عليكم وما أنزل عليكم من الكتاب والحكمة يعظكم به ﴾ {} وقال عز وجل ﴿ لقد أنزلنا إليكم كتابا فيه ذكركم أفلا تعقلون. وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم. كذل", "english": "Therefore, Allah the Exalted said: 'What We strengthen with it your heart (Fūād)' {} So let the servant (ʿAbd) consider that Allah strengthened his heart (Fūād) with what He narrates to him of the conditions of the prophets and their patience upon harm and their firmness in the religion (Dīn) in anticipation of the victory of Allah the Exalted. And how can he not consider this when the Quran was not sent down upon the Messenger of Allah ﷺ for the Messenger of Allah alone, but it is a cure (Shifāʾ) and guidance (Hudā) and mercy (Raḥmah) and light (Nūr) for the worlds. Therefore, Allah the Exalted commanded the entirety to give thanks for the blessing of the Book, so He said: 'And remember the blessing of Allah upon you and what He sent down upon you of the Book and the Wisdom (Ḥikmah) by which He admonishes you' {} And He the Mighty and Majestic said: 'We have certainly sent down to you a Book in which is your Remembrance (Dhikr). Do you not then reason? And We sent down to you the Remembrance (Dhikr) that you may make clear to the people what was sent down to them. Thus does Allah set forth for the people their examples. And follow the best of what was sent down to you from your Lord. This is insights for the people and guidance (Hudā) and mercy (Raḥmah) for a people who are certain. This is a clarification for the people and guidance (Hudā) and admonition (Mawʿiẓah) for the God-fearing (Muttaqīn)' {} And if the address intended all people, then the individuals are intended, so this single reader is intended, so what is for him and for the rest of the people, let him consider that he is the intended one.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "52": [{"arabic": "أنه فيماذا يتفكر لم يقدر عليه لأن مجارى الفكر غير محصورة وثمراته غير متناهية نعم نحن نجتهد في ضبط مجاريه بالإضافة إلى مهمات العلوم الدينية وبالإضافة إلى الأحوال التى هى مقامات السالكين ويكون ذلك ضبطا جمليا فإن تفصيل ذلك يستدعى شرح العلوم كلها وجملة هذه الكتب كالشرح لبعضها فإنها مشتملة على علوم تلك العلوم تستفاد من أفكار مخصوصة فلنشر إلى ضبط الجامع فيها ليحصل الوقوف على مجارى الفكر. بيان مجارى الفكر أعلم أن الفكر قد يجرى في أمر يتعلق بالدين وقد يجرى فيما يتعلق بغير الدين وإنما غرضنا ما يتعلق بالد", "english": "That in what he thinks about, he cannot encompass it because the channels of thought are not limited and its fruits are endless. Yes, we strive to control its channels in addition to the important matters of religious sciences and in addition to the states that are the stations of the travelers (Salikeen), and that will be a general control, for detailing that requires explaining all the sciences, and the entirety of these books is like an explanation for some of them, for they contain sciences of those sciences derived from specific thoughts. So let us proceed to controlling the comprehensive in them to achieve standing upon the channels of thought. Explanation of the channels of thought: Know that thought may run in a matter related to religion and may run in what is related to non-religion, and our aim is what is related to religion, so let us leave the other division and focus on religion as the transaction (Mu'amalah) that is between the servant and the Lord, the Exalted. So all the thoughts of the servant either relate to the servant and his attributes and his states, or relate to the Worshipped and His attributes and His actions; it is not possible to go beyond these two divisions. And what relates to the servant is either a consideration of what is beloved to the Lord, the Exalted, or of what is disliked, and there is no need for thought in other than these two divisions. And what relates to the Lord, the Exalted, is either a consideration of His Essence and His attributes and His beautiful names, or it is in His actions and His dominion and His sovereignty and all that is in the heavens and the earth and what is between them. And it becomes clear to you the confinement of thought in these divisions by an example, which is that the state of those who travel to Allah, the Exalted, and those who yearn for meeting Him relates to his Beloved or relates to himself. So if he thinks about his Beloved, then either he thinks about His beauty and the goodness of His image in His Essence to enjoy thinking about Him and witnessing Him, or he thinks about His gentle, good actions indicating His morals and attributes to make that a multiplier of pleasure and a strengthener of his love. And if he thinks about himself, then his thought is in his attributes that drop him from the eye of his Beloved until he abstains from them, or in the attributes that bring him near to Him and make him beloved to Him until he becomes characterized by them. So if he thinks about something outside of these divisions, then that is outside the limit of love (Ishq) and it is a deficiency in it, because the complete, perfect love is what overwhelms the lover and fulfills the heart (Qalb) until it leaves no room for other than Him. So the lover of Allah, the Exalted, should be like that, so his view and thought do not go beyond his Beloved. And as long as his thought is confined in these four divisions, it is not outside the requirement of love at all. So let us begin with the first division, which is his thinking about the attributes of himself and the actions of himself to distinguish the beloved from them from the disliked, for this thought is what relates to the science of transaction (Ilm al-Mu'amalah) which is the purpose of this book, and the other division relates to the science of unveiling (Ilm al-Mukashafah), then every.", "book_file": "vol4_j4-k09.doc.txt", "book_title": "Contemplation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Contemplation'", "badge": "Insight"}], "62": [{"arabic": "وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعالى: ﴿ ويجعلون لله ما يكرهون وتصف ألسنتهم الكذب أن لهم الحسنى لا ﴾{} وقف بعض القراء على النفي تكذيبا لهم ثم ابتدأ وقال: ﴿ جرم أن لهم النار ﴾{} أي كسب لهم جعلهم لله ما يكرهون النار.", "english": "And he may give one hundred thousand dirhams from what he dislikes of his wealth, which indicates that he does not prefer Allah (Exalted and Glorified) with anything that he loves. And with that, Allah (Exalted and Glorified) censured a people who made for Allah what they dislike. So He (Exalted and Glorified) said: 'And they assign to Allah what they dislike, and their tongues describe the falsehood that for them is the best. No' - some reciters paused at the negation to refute them, then began and said: 'It is earned that for them is the Fire' - meaning: their making for Allah what they dislike has earned them the Fire.", "book_file": "vol1_Vol1-book-5.doc.txt", "book_title": "Mysteries of Zakat", "content_type": "dhikr", "topic": "Al-Ghazali on the virtue and practice of remembering God, from 'Mysteries of Zakat'", "badge": "Dhikr"}], "66": [{"arabic": "اعلم أن كل شىء يتصور أن يشوبه غيره فإذا صفا عن شوبه وخلص عنه سمى خالصا ويسمى الفعل المصفى المخلص إخلاصا قال الله تعالى من بين فرث ودم لبنا خالصا سائغا للشاربين فإنما خلوص اللبن أن لا يكون فيه شوب من الدم والفرث ومن كل ما يمكن أن يمتزج به والإخلاص يضاده الإشراك فمن ليس مخلصا فهو مشرك إلا أن الشرك درجات فالإخلاص في التوحيد يضاده التشريك في الإلهية والشرك منه خفي ومنه جلي وكذا الإخلاص والإخلاص وضده يتواردان على القلب فمحله القلب وإنما يكون ذلك في القصود والنيات وقد ذكر حقيقة النية وأنها ترجع إلى إج", "english": "Know that everything that can be imagined to be mixed with something else, when it becomes pure from its mixture and purified from it, is called pure (khalis), and the purified, purified action is called sincerity (ikhlas). Allah the Exalted said: 'From between dung and blood, pure milk, palatable to the drinkers.' For the purity of milk is that there is no mixture in it of blood and dung, and from everything that can mix with it. And sincerity (ikhlas) is opposed to association (shirk), so whoever is not sincere is an associator, except that association has degrees. Sincerity in monotheism (tawhid) is opposed to association in divinity, and association is of two kinds: hidden and apparent, and likewise sincerity. Sincerity and its opposite come upon the heart (qalb), so its place is the heart, and that only occurs in intentions and purposes. And the reality of intention has been mentioned, that it returns to responding to motives. So whenever the motive is single in detachment, the action emanating from it is called sincerity relative to what is intended. So whoever gives charity and his aim is purely ostentation (riya), he is sincere, and whoever's aim is purely drawing near to Allah the Exalted, he is sincere. But custom is established in specifying the name sincerity (ikhlas) to mean purifying the intention of drawing near to Allah the Exalted from all impurities, just as deviation (ilhad) is an expression for inclination, but custom specified it as inclination away from the truth. And whoever's motive is purely ostentation is exposed to destruction, and we are not speaking about it since we have mentioned what pertains to it in the Book of Ostentation from the quarter of destructives, and the least of its matters is what came in the report that the ostentatious will be called on the Day of Resurrection with four names: 'O ostentatious, O deceiver, O associator, O disbeliever.'", "book_file": "vol4_j4-k07-old.doc.txt", "book_title": "Intention, Sincerity and Truthfulness", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Intention, Sincerity and Truthfulness'", "badge": "Insight"}, {"arabic": "الحمد لله الذي خلق الإنسان من طين لازب وصلصال ثم ركب صورته في أحسن تقويم وأتم اعتدال ثم غذاه في أول نشوه بلبن استصفاه من بين فرث ودم سائغا كالماء الزلال ثم حماه بما آتاه من طيبات الرزق عن دواعي الضعف والانحلال ثم قيد شهوته المعادية له عن السطوة والصيال وقهرها بما افترضه عليه من طلب القوت الحلال وهزم بكسرها جند الشيطان المتشمر للإضلال ولقد كان يجري من ابن آدم مجرى الدم السيال فضيق عليه عزة الحلال المجرى والمجال إذ كان لا يبذرقه إلى أعماق العروق إلا الشهوة الماثلة إلى الغلبة والاسترسال فبقي لما زم", "english": "Praise be to Allah who created the human being from sticky clay and ringing clay, then fashioned his form in the best proportion and most perfect balance. Then He nourished him in his first growth with milk purified from between dung and blood, wholesome like pure water. Then He protected him with what He provided of goodly provisions from the causes of weakness and dissolution. Then He restrained his desire (Shahwa) that opposes him from domination and aggression, and subdued it with what He obligated upon him of seeking lawful (Halal) sustenance, and defeated by breaking it the army of Satan who is girded for misguidance. Indeed, it used to flow in the son of Adam like flowing blood, so the honor of the lawful (Halal) narrowed its channel and scope, since nothing could pour it into the depths of the veins except the desire (Shahwa) inclined to overpowering and indulgence. So he remained, when it was restrained with the rein of the lawful (Halal), disappointed and losing, with no helper or ally. And prayers upon Muhammad, the guide from misguidance, and upon his family, the best of families, and abundant salutations.", "book_file": "vol2_j2-k04.doc.txt", "book_title": "The Lawful and Prohibited", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'The Lawful and Prohibited'", "badge": "Du'a"}], "68": [{"arabic": "ثم في كل حيوان ونبات أعجوبة وأعاجيب تخصه لا يشاركه فيها غيره، فانظر إلى النحل وعجائبها وكيف أوحى الله تعالى إليها حتى اتخذت من الجبال بيوتاً ومن الشجر ومما يعرشون، وكيف استخرج من لعابها الشمع والعسل وجعل أحدهما ضياءً وجعل الآخر شفاءً، ثم لو تأملت عجائب أمرها في تناولها الأزهار والأنوار واحترازها عن النجاحات والأقذار، وطاعتها لواحد من جملتها هو أكبرها شخصاً وهو أميرها، ثم ما سخر الله تعالى له أميرها من العدل والإنصاف بينها - حتى إنه ليقتل على باب المنفذ كل ما وقع منها على نجاسة - لقضيت منها عجباً", "english": "Then in every animal and plant there is a wonder and wonders specific to it that no other shares in it, so look at the bees and their wonders and how Allah the Exalted inspired (awḥā) to them until they took from the mountains houses and from the trees and from what they construct, and how He extracted from their saliva wax and honey and made one of them light (ḍiyāʾ) and made the other healing (shifāʾ). Then if you contemplate the wonders of their affair in their consumption of flowers and blossoms and their avoidance of impurities and filth, and their obedience to one from among them who is the largest in body and is their commander (amīr), then what Allah the Exalted has subjugated for their commander of justice (ʿadl) and fairness (inṣāf) among them - until indeed he kills at the entrance of the passage every one of them that falls upon impurity - you would judge from them a wonder of the utmost wonder if you are insightful in your soul (nafs) and free from the concern of your stomach and your private parts and the desires (shahawāt) of your soul in hostility toward your peers and allegiance to your brothers. Then leave all of that and look at their building of their houses from wax, and their choice from among the shapes the hexagonal shape, so they do not build a house circular nor square nor pentagonal but hexagonal, due to a special property in the hexagonal shape that the understanding of the engineers falls short of grasping it, and it is that the widest shapes and the most containing: the circular and what is near to it, for the square produces from it wasted corners and the shape of the bee is circular elongated so they abandoned the square so that the corners are not wasted and remain empty, then if they built them circular there would remain outside the houses wasted gaps for the circular shapes when gathered do not come together compactly, and no shape among the shapes with corners approaches in containment the circular then they...", "book_file": "vol4_Vol4-book6.doc.txt", "book_title": "Love, Longing, Intimacy and Contentment", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "75": [{"arabic": "السبب الثاني: أن المدح يدل على أن قلب المادح مملوك للممدوح وأنه مريد له ومعتقد فيه ومسخر تحت مشيئته وملك القلوب محبوب والشعور بحصوله لذيذ، وبهذه العلة تعظم اللذة مهما صدر الثناء ممن تتسع قدرته وينتفع باقتناص قلبه كالملوك والأكابر، ويضعف مهما كان المادح ممن لا يؤبه له ولا يقدر على شيء، فإن القدرة عليه بملك قلبه قدرة على أمر حقير فلا يدل المدح إلا على قدرة قاصرة، وبهذه العلة أيضاً يكره الذم ويتألم به القلب، وإذا كان من الأكابر كانت نكايته أعظم لأن الفائت به أعظم.", "english": "The second reason: That praise indicates that the heart (Qalb) of the praiser is owned (mamlūk) by the praised one, and that he is desirous of him and believes in him and is subjugated under his will, and the ownership (mulk) of hearts is beloved and the feeling (shuʿūr) of its attainment is delightful. By this cause, the delight magnifies whenever praise issues from one whose capability expands and one benefits from capturing his heart, like kings and notables, and it weakens whenever the praiser is from those who are not heeded and has no capability (lā yaqdiru ʿalā shayʾ) over anything. For the capability over him through owning his heart is a capability over a trivial matter, so the praise indicates nothing but a deficient capability. By this cause also, blame is hated and the heart (Qalb) is pained by it, and if it is from the notables, its injury is greater because what is lost by it is greater.", "book_file": "vol3_Vol3-book-8a.doc.txt", "book_title": "Condemnation of Status and Ostentation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "وما كان قصدهم الرياء بإظهار الشوق وكل عبد سئل عن حال فهو بين ان يشكر او يشكو يسكت فالشكر طاعة والشكوى معصية قبيحة من اهل الدين وكيف لا تقبح الشكوى من ملك الملوك وبيده كل شيء الى عبد مملوك لا يقدر على شيء فالأحرى بالعبد ان لم يحسن الصبر على البلاء والقضاء وأفضي به الضعف الى الشكوى ان تكون شكواه الى الله تعالى فهو المبلى والقادر على ازالة البلاء وذل العبد لمولاه عز والشكوى الى غيره ذل وإظهار الذل للعبد مع كونه عبدا مثله ذل قبيح قال الله تعالى: ﴿ إن الذين تعبدون من دون الله لا يملكون لكم رزقا فابتغ", "english": "And their intention was not ostentation (Riya) by showing longing, and every servant (Abd) asked about his condition is between either giving thanks (Shukr) or complaining (Shakwa) or remaining silent. So giving thanks (Shukr) is obedience (Taa'a), and complaining (Shakwa) is ugly disobedience (Ma'siya) from the people of religion (Ahl al-Din). And how could complaining (Shakwa) not be ugly from the King of Kings (Malik al-Muluk) in whose hand is everything, to an owned slave (Abd Mamlook) who is not capable of anything? So it is more appropriate for the servant (Abd) that if he does not excel in patience (Sabr) upon the trial (Bala) and the decree (Qada), and weakness leads him to complaining (Shakwa), that his complaint (Shakwa) be to Allah the Exalted, for He is the One who afflicts (Al-Mubli) and is capable of removing the trial (Bala), and the humility (Dhull) of the servant (Abd) to his Master (Mawla) is glorious, and complaining (Shakwa) to other than Him is humility (Dhull), and showing humility (Dhull) to a servant (Abd) while he is a servant (Abd) like him is ugly humility (Dhull). Allah the Exalted said: 'Indeed, those you worship besides Allah do not possess for you [the power of] provision. So seek from Allah provision and worship Him and be grateful to Him.' {} And He said: 'Indeed, those you invoke besides Allah are servants like you.' {} So giving thanks (Shukr) by the tongue (Lisan) is from the totality of giving thanks (Shukr).", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "القسم الثالث: التكبر على العباد؛ وذلك بأن يستعظم نفسه ويستحقر غيره، فتأبى نفسه عن الانقياد لهم وتدعوه إلى الترفع عليهم فيزدريهم ويستصغرهم ويأنف عن مساواتهم، وهذا وإن كان دون الأول والثاني فهو أيضاً عظيم من وجهين؛ أحدهما: أن الكبر والعز والعظمة والعلاء لا يليق إلا بالملك القادر، فأما العبد المملوك الضعيف العاجز الذي لا يقدر على شيء فمن أين يليق بحاله الكبر؟ فمهما تكبر العبد فقد نازع الله تعالى في صفة لا تليق إلا بجلاله، ومثاله: أن يأخذ الغلام قلنسوة الملك فيضعها على رأسه ويجلس على سريره، فما أعظم", "english": "The third category: Arrogance (Takabbur) towards the servants (of Allah); that is by magnifying oneself and belittling others, so his soul (Nafs) refuses to submit to them and calls him to elevate himself over them, thus he despises them, considers them insignificant, and disdains equality with them. And this, even though it is less than the first and second, is also great from two aspects; one of them: that arrogance (Kibr), honor (Izz), majesty (Azamah), and loftiness (Ala') are not fitting except for the capable King (Malik), so as for the owned slave (Abd Mamlook), weak, incapable, who is not able to do anything, then from where is arrogance fitting for his condition? Whenever a slave (Abd) becomes arrogant, he has contended with Allah the Exalted in an attribute that is not fitting except for His majesty (Jalal), and its example: that a boy takes the king's cap and places it on his head and sits on his throne, so how great is his deserving of hatred and how great is his targeting for disgrace and punishment! And how severe is his audacity towards his master (Mawla) and how ugly is what he has undertaken! And to this meaning is the allusion in His saying the Exalted \"Majesty (Azamah) is My lower garment and grandeur (Kibriya') is My upper garment, so whoever contends with Me in them I will break him\" meaning that it is specific to My attribute and not fitting except for Me, and the contender in it contends in an attribute from My attributes, and if arrogance (Kibr) over His servants is not fitting except for Him, then whoever is arrogant over His servants has wronged Him, since the one who despises the special servants of the king and uses them and elevates himself over them and monopolizes what is the king's right to monopolize from them is contending with him in some of his affair, even if his degree does not reach the degree of one who wanted to sit on his throne and monopolize his kingdom, so all creation are servants (Ibad) of Allah and to Him belongs majesty (Azamah) and grandeur (Kibriya') over them, so whoever is arrogant over a servant (Abd) from the servants (Ibad) of Allah has contended with Allah in His right. Indeed, the difference between this contention and the contention of Nimrod and Pharaoh, is the difference between contending with the king in belittling some of his slaves and using them and contending with him in the essence of kingship.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}, {"arabic": "فهو مضطر ذليل إن ترك بقي وإن اختطف فني، عبد مملوك لا يقدر على شيء من نفسه ولا شيء من غيره، فأي شيء أذل منه لو عرف نفسه؟ وأنى يليق الكبر به لولا جهله؟ فهذا أوسط أحواله فليتأمله. وأما آخره ومورده فهو الموت المشار إليه بقول تعالى \"ثم أماته فأقبره ثم إذا شاء أنشره\" ومعناه أنه يسلب روحه وسمعه وبصره وعلمه وقدرته وحسه وإدراكه وحركته، فيعود جماداً كما كان أول مرة، لا يبقى إلا شكل أعضائه وصورته لا حس فيه ولا حركة، ثم يوضع في التراب فيصير جيفة منتنة قذرة كما كان في الأول نطفة مذرة، ثم تبلى أعضاؤه وتتفتت أ", "english": "So he is compelled and humiliated; if left, he remains, and if snatched away, he perishes—a slave owned (abd mamluk) who cannot control anything of himself nor anything of others. What is more humiliated than him if he knew himself? And how does arrogance befit him except due to his ignorance? This is his intermediate state, so let him contemplate it. As for his end and destination, it is death, alluded to by the saying of the Exalted: 'Then He causes him to die and buries him, then when He wills, He resurrects him.' Its meaning is that He strips him of his Spirit (Ruh), hearing, sight, knowledge, power, sensation, perception, and movement, so he returns as inanimate matter as he was at first, nothing remains except the form of his limbs and his image—no sensation in it nor movement. Then he is placed in the earth and becomes a stinking, filthy corpse as he was initially a despised drop (nutfah). Then his limbs decay, his parts disintegrate, his bones rot, and he becomes scattered remains and fragments, and worms eat his parts, beginning with his pupils to pluck them out and his cheeks to cut them off, and with all his parts until he becomes dung in the bellies of worms and becomes a corpse from which animals flee and every human finds repulsive and flees from due to the intensity of the stench. The best of his states is that he returns to what he was and becomes earth from which cups are made and from which buildings are constructed, so he becomes non-existent after having been existent. And it becomes as if he had not flourished yesterday as a harvest, as he was in his first affair a long period. Would that he remained thus—how excellent if he were left as earth! No, rather He revives him after long decay to experience severe trial, so he emerges from his grave after gathering his scattered parts, and emerges.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Condemnation of Pride and Conceit'", "badge": "Afterlife"}, {"arabic": "وما أنت إلا عبد مملوك لا تقدر على شيء. ومن عرف ذلك لا بد وأن يزول كبره. ومثاله: أن يفتخر الغافل بقوته وجماله وماله وحريته واستقلاله وسعة منازله وكثرة خيوله وغلمانه، إذ شهد عليه شاهدان عدلان عند حاكم منصف بأنه رقيق لفلان وأن أبويه كانا مملوكين له، فعلم ذلك وحكم به الحاكم، فجاء مالكه فأخذه، وأخذ جميع ما في يده، وهو مع ذلك يخشى أن يعاقبه وينكل به لتفريطه في أمواله وتقصيره في طلب مالكه ليعرف أنه له مالكاً، ثم نظر العبد فرأى نفسه محبوساً في منزل قد أحدقت به الحيات والعقارب والهوام وهو في كل حال على و", "english": "And you are nothing but a slave (abd) owned (mamluk) who cannot do anything. And whoever knows that, his arrogance must vanish. Its example: that the heedless one boasts of his strength, beauty, wealth, freedom, independence, spacious dwellings, and abundance of horses and servants, when two just witnesses testify against him before a fair judge that he is a slave (riq) to so-and-so and that his parents were owned (mamluk) by him, so that is known and the judge rules by it, then his owner (malik) comes and takes him, and takes all that is in his hand, and he with that fears that he will punish him and inflict harm upon him for his wastefulness in his wealth and his shortcoming in seeking his owner (malik) to know that he has an owner (malik). Then the slave (abd) looked and saw himself imprisoned in a dwelling that has been surrounded by snakes, scorpions, and vermin, and he is in every state in fear from each one of them, and he remains not owning himself nor his wealth nor knowing any way of escape at all. Do you think one in this state boasts of his power, wealth, strength, and perfection or humbles himself and submits? And this is the state of every intelligent person who becomes, for he sees himself thus, so he does not own his neck, body, limbs, and wealth, and he with that is among afflictions, desires, illnesses, and diseases that are like scorpions and snakes from which he fears destruction. So one in this state does not become arrogant with his strength and power since he knows that he has no power and no strength. This is the way of treating arrogance with external causes, and it is easier than treating arrogance with knowledge and action, for they are two perfections in the soul (nafs) worthy of rejoicing in them. Allah struck a similitude: a slave (abd) owned (mamluk) who cannot do anything, and one whom We have provided from Us a good provision, so he spends from it secretly and openly. Are they equal? Praise be to Allah. But most of them do not know.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "76": [{"arabic": "ومنها المبهم وهو اللفظ المشترك بين معن من كلمة أو حرف أما الكلمة فكالشيء والقرين والأمة والروح ونظائرها قال الله تعالى ﴿ ضرب الله مثلا عبدا مملوكا لا يقدر على شيء ﴾ {} أراد به النفقة مما رزق وقوله عز وجل ﴿ وضرب الله مثلا رجلين أحدهما أبكم لا يقدر على شيء ﴾ {} أي الأمر بالعدل والاستقامة", "english": "And among them is the ambiguous, which is the word shared between meanings of a word or letter. As for the word, such as 'thing' (al-shay'), 'companion' (al-qarīn), 'community' (al-ummah), 'spirit' (al-rūḥ), and their like. Allah the Exalted said: 'Allah sets forth a parable of a slave owned, unable to do anything' (Quran 16:75) – He intended by it the expenditure from what He has provided. And His saying, the Exalted: 'And Allah sets forth a parable of two men: one of them dumb, unable to do anything' (Quran 16:76) – meaning the command to justice (al-ʿadl) and uprightness (al-istiqāmah).", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}, {"arabic": "القسم الثالث: التكبر على العباد؛ وذلك بأن يستعظم نفسه ويستحقر غيره، فتأبى نفسه عن الانقياد لهم وتدعوه إلى الترفع عليهم فيزدريهم ويستصغرهم ويأنف عن مساواتهم، وهذا وإن كان دون الأول والثاني فهو أيضاً عظيم من وجهين؛ أحدهما: أن الكبر والعز والعظمة والعلاء لا يليق إلا بالملك القادر، فأما العبد المملوك الضعيف العاجز الذي لا يقدر على شيء فمن أين يليق بحاله الكبر؟ فمهما تكبر العبد فقد نازع الله تعالى في صفة لا تليق إلا بجلاله، ومثاله: أن يأخذ الغلام قلنسوة الملك فيضعها على رأسه ويجلس على سريره، فما أعظم", "english": "The third category: Arrogance (Takabbur) towards the servants (of Allah); this is by magnifying oneself and belittling others, so his Soul (Nafs) refuses to submit to them and calls him to elevate himself over them, thus he despises them, considers them insignificant, and disdains equality with them. And this, even if it is less than the first and second, is also great from two aspects. The first: that arrogance (Kibr), honor (Izz), majesty (Azamah), and loftiness (Ala') are not fitting except for the King (Malik) who is capable (Qadir). As for the servant (Abd) who is owned (Mamluk), weak (Da'if), incapable (Ajiz), who cannot do anything, then from where does arrogance (Kibr) befit his state? So whenever a servant (Abd) becomes arrogant (Takabbur), he has contended with Allah the Exalted in an attribute that is not fitting except for His majesty (Jalal). Its example: that a boy (Ghulam) takes the king's cap (Qalansuwah) and places it on his head and sits on his throne (Sarir), so how great is his deserving of contempt (Maqt) and how great is his exposure to disgrace (Khizy) and punishment (Nikal)! And how severe is his audacity (Istijra') towards his master (Mawlah) and how ugly is what he has undertaken! And to this meaning is the allusion in His saying the Exalted: \"Majesty (Azamah) is My lower garment (Izar) and arrogance (Kibriya') is My cloak (Rida'), so whoever contends with Me in them I will break him\" meaning that it is specific to My attribute and not fitting except for Me, and the contender in it contends in an attribute from My attributes. And if arrogance (Kibr) over His servants (Ibad) is not fitting except for Him, then whoever is arrogant (Takabbur) over His servants (Ibad) has wronged Him, since the one who despises the special servants (Khawass) of the king's boys (Ghulman), uses them, elevates himself over them, and monopolizes what it is the king's right to monopolize from them, he is contending with him in some of his affair, even if his degree does not reach the degree of one who wanted to sit on his throne (Sarir) and monopolize his kingdom. So all creation (Khalq) are servants (Ibad) of Allah and to Him belongs majesty (Azamah) and arrogance (Kibriya') over them, so whoever is arrogant (Takabbur) over a servant (Abd) from the servants (Ibad) of Allah has contended with Allah in His right. Yes, the difference between this contention and the contention of Nimrod and Pharaoh is the difference between contending with the king in belittling some of his servants (Abid) and using them and contending with him in the foundation of kingship. The second aspect: by which the vileness of arrogance (Takabbur) towards the servants (of Allah) is magnified is that Allah the Exalted struck for it a parable, saying: \"And Allah presents an example of two men: one of them is dumb (Abkam), unable to do anything, and he is a burden (Kall) upon his master (Mawlah) - wherever he directs him, he brings no good. Is he equal to one who commands justice (Adl) and is upon a straight path (Sirat Mustaqim)?\" So the one arrogant (Mutakabbir) towards the servants (of Allah) is like the dumb (Abkam) who cannot do anything, and he is a burden (Kall) upon his master (Mawlah), meaning a heavy load upon him, wherever he directs him he brings no good. So is he equal to one who commands justice (Adl) and is upon a straight path (Sirat Mustaqim)? So the one arrogant (Mutakabbir) towards the servants (of Allah) does not command justice (Adl) nor is he upon a straight path (Sirat Mustaqim), rather he is like the dumb (Abkam) who cannot do anything, and he is a burden (Kall) upon his master (Mawlah), meaning a heavy load upon Allah the Exalted, wherever he directs him he brings no good. So is he equal to one who commands justice (Adl) and is upon a straight path (Sirat Mustaqim)? So the one arrogant (Mutakabbir) towards the servants (of Allah) does not command justice (Adl) nor is he upon a straight path (Sirat Mustaqim), rather he is like the dumb (Abkam) who cannot do anything, and he is a burden (Kall) upon his master (Mawlah), meaning a heavy load upon Allah the Exalted, wherever he directs him he brings no good. So is he equal to one who commands justice (Adl) and is upon a straight path (Sirat Mustaqim)?", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "77": [{"arabic": "فإن قلت: فما فائدة الدعاء والقضاء لا مرد له. فاعلم أن من القضاء رد البلاء بالدعاء فالدعاء سبب لرد البلاء واستجلاب الرحمة كما أن الترس سبب لرد السهم والماء سبب لخروج النبات من الأرض فكما أن الترس يدفع السهم فيتدافعان فكذلك الدعاء والبلاء يتعالجان وليس من شرط الاعتراف بقضاء الله تعالى أن لا يحمل السلاح وقد قال تعالى: ﴿ خذوا حذركم ﴾ {} وأن لا يسقي الأرض بعد بث البذر فيقال إن سبق القضاء بالنبات نبت البذر وإن لم يسبق لم ينبت بل ربط الأسباب بالمسببات هو القضاء الأول الذي هو كلمح البصر أو هو أقرب وترتي", "english": "If you say: What is the benefit of supplication (Dua) when divine decree (Qada) cannot be reversed? Know that from divine decree (Qada) is repelling affliction (Bala) through supplication (Dua), so supplication (Dua) is a cause for repelling affliction (Bala) and attracting mercy (Rahma) just as a shield is a cause for repelling an arrow and water is a cause for the emergence of plants from the earth. So just as the shield pushes the arrow and they repel each other, likewise supplication (Dua) and affliction (Bala) contend with each other. It is not a condition of acknowledging the divine decree (Qada) of Allah the Exalted to not carry weapons, and He the Exalted has said: 'Take your precautions' (Quran 4:71), and to not water the earth after sowing seeds, saying: If divine decree (Qada) preceded with growth, the seed will grow, and if it did not precede, it will not grow. Rather, linking causes (Asbab) to effects (Musabbabat) is the first divine decree (Qada) which is like the blink of an eye or it is nearer. And arranging the detailing of effects (Musabbabat) upon the details of causes (Asbab) with gradualness and measure is divine destiny (Qadar). And the One who decreed good decreed it with a cause, and the One who decreed evil decreed it to repel it with a cause. So there is no contradiction between these matters for one whose insight (Basira) has opened.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance", "badge": "Du'a"}], "90": [{"arabic": "والطاعات تنقسم الى فرض ونفل وهو محتاج الى الصبر عليهما جميعا وقد جمعهما الله تعالى في قوله: ﴿ إن الله يأمر بالعدل والاحسان وايتاء ذي القربى ﴾ {} فالعدل هو الفرض، والإحسان هو النفل، وايتاء ذي القربى هو المروءة وصلة الرحم وكل ذلك يحتاج الى صبر. الضرب الثاني المعاصي فما أحوج العبد الى الصبر عنها، وقد جمع الله تعالى انواع المعاصي في قوله تعالى: ﴿ وينهى عن الفحشاء والمنكر والبغي ﴾ {}", "english": "And acts of obedience (Tā'āt) are divided into obligatory (Farḍ) and supererogatory (Nafal), and one needs patience (Ṣabr) upon both of them together. And Allah the Exalted has combined them in His saying: 'Indeed, Allah commands justice (Al-'Adl) and excellence (Al-Iḥsān) and giving to relatives (Dhī al-Qurbā)' - so justice (Al-'Adl) is the obligatory (Farḍ), and excellence (Al-Iḥsān) is the supererogatory (Nafal), and giving to relatives (Dhī al-Qurbā) is chivalry (Al-Murū'ah) and maintaining kinship ties (Ṣilat al-Raḥm), and all of that requires patience (Ṣabr). The second category is sins (Al-Ma'āṣī), so how much the servant (Al-'Abd) is in need of patience (Ṣabr) from them! And Allah the Exalted has gathered the types of sins (Al-Ma'āṣī) in His saying: 'And He forbids immorality (Al-Faḥshā') and wrong (Al-Munkar) and oppression (Al-Baghy)'.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "قال إني سمعت اباك واجدادك يقرءون هذه الآية على المنبر إن الله يأمر بالعدل والاحسان وإيتاء ذي القربى وينهى عن الفحشاء والمنكر والبغي وأنا رأيت منكرا فغيرته فقال فغيره فوالله ما قال إلا هذا", "english": "He said: 'Indeed, I heard your father and your forefathers reciting this verse on the pulpit: \"Indeed, Allah commands justice (al-'adl) and excellence (al-ihsan) and giving to the near of kin, and forbids indecency (al-fahsha') and the reprehensible (al-munkar) and aggression (al-baghy). He admonishes you so that you may remember.\" And I saw a reprehensible act (munkar) so I changed it.' So he changed it, and by Allah, he said nothing but this.", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}, {"arabic": "وإنما أدبه القرآن بمثل قوله تعالى خذ العفو وأمر بالعرف وأعرض عن الجاهلين وقوله إن الله يأمر بالعدل والإحسان وإيتاء ذي القربى وينهى عن الفحشاء والمنكر والبغي وقوله واصبر على ما أصابك إن ذلك من عزم الأمور وقوله ولمن صبر وغفر إن ذلك لمن عزم الأمور وقوله فاعف عنهم واصفح إن الله يحب المحسنين وقوله وليعفوا وليصفحوا ألا تحبون أن يغفر الله لكم وقوله ادفع بالتي هي أحسن فإذا الذي بينك وبينه عداوة كأنه ولي حميم وقوله والكاظمين الغيظ والعافين عن الناس والله يحب المحسنين وقوله اجتنبوا كثيرا من الظن إن بعض ال", "english": "And indeed, the Quran educated him with verses like His saying: 'Take forgiveness and command with what is recognized as good and turn away from the ignorant ones,' and His saying: 'Indeed, Allah commands with justice (al-'adl) and excellence (al-ihsan) and giving to the near of kin, and He forbids from indecency (al-fahsha') and what is disapproved (al-munkar) and aggression (al-baghy),' and His saying: 'And be patient over what befalls you; indeed, that is of the matters of determination,' and His saying: 'And for whoever is patient and forgives; indeed, that is of the matters of determination,' and His saying: 'So pardon them and overlook; indeed, Allah loves the doers of excellence (al-muhsinin),' and His saying: 'And let them pardon and overlook; do you not love that Allah should forgive you?' and His saying: 'Repel with that which is better; then indeed, the one between you and whom is enmity will be as if he was a close protector,' and His saying: 'And those who restrain anger and pardon the people; and Allah loves the doers of excellence (al-muhsinin),' and His saying: 'Avoid much of assumption; indeed, some assumption is sin, and do not spy, nor backbite one another.'", "book_file": "vol2_j2-k10.doc.txt", "book_title": "Etiquette of Living and Prophetic Character", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Etiquette of Living and Prophetic Character'", "badge": "Ethics"}, {"arabic": "وقال الفضيل بن عياض: ينبغي لحامل القرآن أن لا يكون له إلى أحد حاجة ولا إلى الخلفاء فمن دونهم فينبغي أن تكون حوائج الخلق إليه وقال أيضا حامل القرآن حامل راية الإسلام فلا ينبغي أن يلهو مع من يلهو ولا يسهو مع من يسهو ولا يلغو مع من يلغو تعظيما لحق القرآن. وقال سفيان الثوري: إذا قرأ الرجل القرآن قبل الملك بين عينيه. وقال عمرو بن ميمون: من نشر مصحفا حين يصلي الصبح فقرأ منه مائة آية رفع الله عز وجل له مثل عمل جميع أهل الدنيا. ويروى أن (خالد بن عقبة جاء إلى رسول الله ﭬ وقال: اقرأ علي القرآن فقرأ عليه ﴿", "english": "And Al-Fudayl ibn Iyad said: It is fitting for the bearer of the Quran that he should have no need of anyone, nor of the caliphs or those below them; rather, the needs of creation should be directed to him. He also said: The bearer of the Quran is the bearer of the banner of Islam, so it is not fitting that he should play around with those who play around, nor be heedless with those who are heedless, nor engage in idle talk with those who engage in idle talk, out of reverence for the right of the Quran. And Sufyan al-Thawri said: When a man recites the Quran, the angel places it between his eyes. And Amr ibn Maymun said: Whoever opens a Quran when he prays the morning prayer and recites one hundred verses from it, Allah the Exalted will raise for him the equivalent of the deeds of all the people of the world. And it is narrated that (Khalid ibn Uqbah came to the Messenger of Allah ﷺ and said: Recite the Quran to me. So he recited to him: 'Indeed, Allah commands justice and excellence (Ihsan) and giving to relatives, and He forbids immorality and wrong and oppression; He admonishes you that perhaps you will be reminded.' Then he said to him: Repeat it. So he repeated it and said: By Allah, indeed it has sweetness, and indeed upon it is freshness, and indeed its lower part is verdant, and indeed its upper part is fruitful, and no human says this). And Al-Hasan said: By Allah, there is no wealth below the Quran, nor any poverty beyond it.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Etiquette of Quran Recitation'", "badge": "Du'a"}, {"arabic": "وقال معاذ أوصاني رسول الله صلى الله عليه وسلم فقال يا معاذ أوصيك بإتقاء الله وصدق الحديث والوفاء بالعهد وأداء الأمانة وترك الخيانة وحفظ الجار ورحمة اليتيم ولين الكلام وبذل السلام وحسن العمل وقصر الأمل ولزوم الإيمان والتفقه في القرآن وحب الآخرة والجزع من الحساب وخفض الجناح وأنهاك أن تسب حكيما أو تكذب صادقا أو تطيع آثما أو تعصي إماما عادلا أو تفسد أرضا وأوصيك باتقاء الله عند كل حجر وشجر ومدر وأن تحدث لكل ذنب توبة السر بالسر والعلانية بالعلانية حديث يا معاذ أوصيك باتقاء الله وصدق الحديث الحديث أخرج", "english": "And Mu'adh said: The Messenger of Allah (peace be upon him) advised me, saying: O Mu'adh, I advise you with the Fear (Taqwa) of Allah, truthful speech, fulfilling the covenant, performing the trust, abandoning treachery, protecting the neighbor, mercy to the orphan, softness in speech, giving the greeting (Salam), good action, shortening hope, adhering to faith, understanding the Quran, love of the Hereafter, dread from the accounting, lowering the wing, and I forbid you from insulting a wise person, lying to a truthful one, obeying a sinner, disobeying a just leader, or corrupting the land. And I advise you with the Fear (Taqwa) of Allah at every stone, tree, and clod, and that you initiate repentance for every sin, the secret with the secret and the public with the public. The hadith: O Mu'adh, I advise you with the Fear (Taqwa) of Allah and truthful speech. The hadith was reported by Abu Nu'aym in Al-Hilyah and Al-Bayhaqi in Al-Zuhd, and it preceded in the etiquettes of companionship. Thus is the manner of the servants of Allah, and He called them to noble character traits and beautiful etiquettes. Explanation of a group of his beautiful character traits that some scholars collected and extracted from the reports, saying: He (peace be upon him) was the most forbearing of people. The hadith: He (peace be upon him) was the most forbearing of people. Reported by Abu Al-Shaykh in the book Akhlaq Rasul Allah (peace be upon him) from the narration of 'Abd al-Rahman ibn Abza: The Messenger of Allah (peace be upon him) was among the most forbearing of people. The hadith is mursal, and Abu Hatim ibn Hibban reported from the hadith of...", "book_file": "vol2_j2-k10.doc.txt", "book_title": "Etiquette of Living and Prophetic Character", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Etiquette of Living and Prophetic Character'", "badge": "Hadith"}], "93": [{"arabic": "ونحن نجوز أن يقدر الله سببا يهلك به الخلق عن آخرهم فيفوت دنياهم ويضلون في دينهم فإنه يضل من يشاء ويهدي من يشاء ويميت من يشاء ويحيي من يشاء ولكنا نقدر الأمر جاريا على ما ألف من سنة الله تعالى في بعثة الأنبياء لصلاح الدين والدنيا", "english": "And we allow that Allah may decree a cause by which He destroys the creation entirely, so their worldly life is lost and they go astray in their religion, for He misguides whom He wills and guides whom He wills, and causes death whom He wills and gives life whom He wills. But we consider the matter proceeding according to what is customary from the established way (Sunnah) of Allah the Exalted in sending the prophets for the rectification of the religion and the worldly life.", "book_file": "vol2_j2-k04.doc.txt", "book_title": "The Lawful and Prohibited", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'The Lawful and Prohibited'", "badge": "Ethics"}], "96": [{"arabic": "وأما العلم الذي هو مثمر لهذه الحال فهو العلم بكون المتروك حقيراً بالإضافة إلى المأخوذ كعلم التاجر بأن العوض خير من المبيع فيرغب فيه، وما لم يتحقق هذا العلم لم يتصور أن تزول الرغبة عن المبيع، فكذلك من عرف أن ما عند الله باق وأن الآخرة خير وأبقى، أي لذاتها خير في أنفسها وأبقى، كما تكون الجواهر خيراً وأبقى من الثلج مثلاً. ولا يعسر على مالك الثلج بيعه بالجواهر واللآلئ، فهكذا مثال الدنيا والآخرة، فالدنيا كالثلج الموضوع في الشمس لا يزال في الذوبان إلى الانقراض، والآخرة كالجوهر الذي لا فناء له، فبقدر ق", "english": "And as for the knowledge that is fruitful for this state, it is the knowledge that what is abandoned is insignificant in comparison to what is taken, like the knowledge of the merchant that the exchange is better than the sold item, so he desires it. And if this knowledge is not realized, it cannot be imagined that the desire for the sold item will vanish. Similarly, whoever knows that what is with Allah remains and that the Hereafter is better and more lasting, meaning its essence is better in itself and more lasting, just as jewels are better and more lasting than snow, for example. And it is not difficult for the owner of snow to sell it for jewels and pearls. Thus is the example of this world and the Hereafter: this world is like snow placed in the sun, constantly melting to extinction, and the Hereafter is like a jewel that has no perishing. So according to the strength of certainty and knowledge of the disparity between this world and the Hereafter, the desire for selling and transaction strengthens, until indeed whoever has strong certainty sells his soul (Nafs) and his wealth, as Allah the Exalted said: \"Indeed, Allah has purchased from the believers their souls (Anfus) and their wealth in exchange for Paradise for them.\" Then He clarified that their transaction is profitable, so He said: \"So rejoice in your transaction which you have contracted.\" So what is needed from knowledge in asceticism (Zuhd) is only this amount: that the Hereafter is better and more lasting. And one may know that yet not be able to abandon this world, either due to weakness in his knowledge and certainty, or due to the domination of desire (Shahwa) in the moment over him and being overpowered in the hand of Satan, or due to his deception by the promises of Satan in procrastination day after day until death snatches him and nothing remains with him except regret after the passing: and to the definition of the baseness of this world, the indication is in His saying: \"Say, the enjoyment of this world is little.\" And to the definition of the preciousness of...", "book_file": "vol4_Vol4-book4.doc.txt", "book_title": "Poverty and Abstinence", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Poverty and Abstinence'", "badge": "Afterlife"}], "98": [{"arabic": "وخذلانا فإن المعاني المختلفة تفتقر إلى أسامي مختلفة والملك عبارة عن خلق خلقه الله تعالى شأنه إفاضة الخير وإفادة العلم وكشف الحق والوعد بالخير والأمر بالمعروف وقد خلقه وسخره لذلك والشيطان عبارة عن خلق شأنه ضد ذلك وهو الوعد بالشر والأمر بالفحشاء والتخويف عند الهم بالخير بالفقر فالوسوسة في مقابلة الإلهام والشيطان في مقابلة الملك والتوفيق في مقابلة الخذلان وإليه الإشارة بقوله تعالى ومن كل شيء خلقنا زوجين فإن الموجودات كلها متقابلة مزدوجة إلا الله تعالى فإنه فرد لا مقابل له بل هو الواحد الحق الخالق ل", "english": "And abandonment (Khudhlan). For different meanings require different names. The Angel (Malak) is an expression for a creation that Allah the Exalted created, its affair being the outpouring of good, imparting knowledge, unveiling truth, promising good, and commanding righteousness. He created it and subjugated it for that. And the Satan (Shaytan) is an expression for a creation whose affair is the opposite of that, which is promising evil, commanding indecency, and frightening when intending good with poverty. So whispering (Waswasa) is in opposition to inspiration (Ilham), and Satan is in opposition to the Angel, and success (Tawfiq) is in opposition to abandonment. To this is the allusion in His saying the Exalted: 'And of all things We created pairs' (51:49). For all existents are opposing, paired except Allah the Exalted, for He is singular with no opposite; rather, He is the One True (Al-Wahid Al-Haqq), Creator of all pairs. So the Heart (Qalb) is pulled between Satan and the Angel. And the Prophet (peace be upon him) said regarding the Heart: 'There are two promptings (Lamatayn) in the Heart: a prompting from the Angel—promising good and confirming truth—so whoever finds that, let him know it is from Allah the Exalted and let him praise Allah; and a prompting from the enemy—promising evil, denying truth, and forbidding good—so whoever finds that, let him seek refuge in Allah from the accursed Satan.' Then he recited His saying the Exalted: 'Satan threatens you with poverty and commands you to indecency' (2:268). And Al-Hasan said: 'They are but two thoughts (Hamman) that roam in the Heart: a thought from Allah the Exalted and a thought from the enemy. May Allah have mercy on a servant who pauses at his thought: if it is from Allah the Exalted, he proceeds with it; and if it is from his enemy, he fights it.' And for the pulling of the Heart between these two dominators, the Messenger of Allah (peace be upon him) said: 'The Heart of the believer is between two fingers from the fingers of the Most Merciful.' Allah is exalted above having a finger composed of flesh, blood, and nerves divided by fingertips. But the spirit (Ruh) of the finger is swift turning and the ability to move and change, for you do not want your finger for its entity but for its action in turning and repeating, just as you undertake actions with your fingers. And Allah the Exalted does what He does by employing the Angel and Satan, and they are subjugated by His power in turning the Hearts, just as your fingers are subjugated to you in turning bodies, for example. And the Heart, by original nature (Fitra), is suitable for accepting the effects of the Angel and for accepting the effects of Satan with equal suitability; neither outweighs the other. Rather, one of the two sides outweighs by following caprice (Hawa) and indulging in desires (Shahawat) or turning away from them and opposing them. For if a human follows the requirement of anger and desire, the domination of Satan appears through caprice, and the Heart becomes the nest and mine of Satan because", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "ولا يمحو وسوسة الشيطان من القلب إلا ذكر ما سوى ما يوسوس به لأنه إذا خطر في القلب ذكر شيء انعدم منه ما كان فيه من قبل ولكن كل شيء سوى الله تعالى وسوى ما يتعلق به فيجوز أيضا أن يكون مجالا للشيطان وذكر الله هو الذي يؤمن جانبه ويعلم أنه ليس للشيطان فيه مجال ولا يعالج الشيء إلا بضده وضد جميع وساوس الشيطان ذكر الله بالاستعاذة والتبري عن الحول والقوة وهو معنى قولك أعوذ بالله من الشيطان الرجيم ولا حول ولا قوة إلا بالله العلي العظيم وذلك لا يقدر عليه إلا المتقون الغالب عليهم ذكر الله تعالى وإنما الشيطان ", "english": "And the whispering (Waswasah) of the Satan (Shaytan) is not erased from the Heart (Qalb) except by the Remembrance (Dhikr) of other than what he whispers about, because when the Remembrance (Dhikr) of something occurs in the Heart (Qalb), what was previously in it disappears. But everything other than Allah the Exalted and other than what is related to Him may also be a field for the Satan (Shaytan), and the Remembrance (Dhikr) of Allah is what secures its side and makes known that there is no field for the Satan (Shaytan) in it. And a thing is not treated except by its opposite, and the opposite of all the whisperings (Waswasah) of the Satan (Shaytan) is the Remembrance (Dhikr) of Allah through seeking refuge (Isti'adha) and disavowal of power and strength, and that is the meaning of your saying: 'I seek refuge (A'udhu) in Allah from the accursed Satan (Shaytan) (Al-Rajim)', and 'There is no power nor strength except with Allah the Most High, the Most Great'. And that is not within the capability except of the God-fearing (Muttaqun) upon whom the Remembrance (Dhikr) of Allah the Exalted predominates. And indeed, the Satan (Shaytan) circulates around them in times of lapses (Falatat) by way of stealth. Allah the Exalted said: 'Indeed, those who fear Allah (Yattaquna) – when an impulse (Ta'if) from the Satan (Shaytan) touches them, they remember (Tadhakkara) and at once they have insight (Mubsirun).' And Mujahid said regarding the meaning of Allah the Exalted's saying: 'From the evil of the retreating whisperer (Al-Waswas Al-Khannas)', he said: 'He is spread out over the Heart (Qalb), so when Allah the Exalted is remembered (Dhikr), he retreats (Khannasa) and contracts, and when he is heedless (Ghafla), he spreads out over his Heart (Qalb).' So the chasing away between the Remembrance (Dhikr) of Allah the Exalted and the whispering (Waswasah) of the Satan (Shaytan) is like the chasing away between light (Nur) and darkness (Zulmah), and between night (Layl) and day (Nahar). And due to their opposition, Allah the Exalted said: 'Satan (Shaytan) has overcome them and made them forget the Remembrance (Dhikr) of Allah.' And Anas said: The Messenger of Allah, peace and blessings be upon him, said: 'Indeed, the Satan (Shaytan) places his snout (Khurtum) on the Heart (Qalb) of the son of Adam, so if he remembers (Dhikr) Allah the Exalted, he retreats (Khannasa), and if he forgets (Nasiya) Allah the Exalted, he swallows (Iltqama) his Heart (Qalb).'", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "وإذا قلت أعوذ بالله من الشيطان الرجيم فاعلم أنه عدوك ومترصد لصرف قلبك عن الله عز وجل حسدا لك على مناجاتك مع الله عز وجل وسجودك له مع أنه لعن بسبب سجدة واحدة تركها ولم يوفق لها وأن استعاذتك بالله سبحانه منه بترك ما يحبه وتبديله بما يحب الله عز وجل لا بمجرد قولك فإن من قصده سبع أو عدو ليفترسه أو يقتله فقال أعوذ منك بذلك الحصن الحصين وهو ثابت على مكانه فإن ذلك لا ينفعه بل لا يعيذه إلا تبديل المكان فكذلك من يتبع الشهوات التي هي محاب الشيطان ومكاره الرحمن فلا يغنيه مجرد القول فليقترن قوله بالعزم على ", "english": "And when you say 'I seek refuge in Allah from the accursed Satan (Shaytan)', know that he is your enemy and lies in wait to divert your Heart (Qalb) from Allah the Exalted, out of envy toward you for your intimate conversation (Munajat) with Allah the Exalted and your prostration (Sujud) to Him, even though he was cursed due to a single prostration he abandoned and was not granted success in it. And your seeking refuge (Isti'adha) in Allah the Glorified from him is by abandoning what he loves and replacing it with what Allah the Exalted loves, not merely by your statement. For if one whom a predator or enemy intends to devour or kill says 'I seek refuge from you with that impregnable fortress' while remaining in his place, that will not benefit him; rather, nothing will grant him refuge except changing his location. Likewise, one who follows the desires (Shahawat) that are the pleasures of Satan and the displeasures of the Most Merciful (Al-Rahman) will not be helped by mere speech. So let his statement be accompanied by the determination (Al-'Azm) to seek refuge with the fortress of Allah the Exalted from the evil of Satan, and his fortress is 'There is no god but Allah (La ilaha illa Allah)', as He the Exalted said in what our Prophet (peace be upon him) reported: 'There is no god but Allah is my fortress, so whoever enters my fortress is safe from my punishment.' And the one who takes refuge in it has no object of worship except Allah the Glorified. As for one who takes his desire (Hawa) as his god, he is in the arena of Satan, not in the fortress of Allah the Exalted. And know that among his stratagems is to distract you in your prayer (Salah) with remembrance (Dhikr) of the Hereafter and planning good deeds to prevent you from understanding what you recite. Know that everything that distracts you from understanding the meanings of your recitation is whispering (Waswas). For the movement of the tongue is not the intended goal; rather, the intended goal is their meanings.", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Mysteries of Prayer'", "badge": "Du'a"}, {"arabic": "[23] حديث الأمر بالتعوذ بالله من الشيطان الرجيم عند الغيظ متفق عليه من حديث سليمان بن صرد قال كنت جالسا مع النبي ﭬ ورجلان يستبان فأحدهما أحمر وجهه وانتفخت أوداجه الحديث وفيه لو قال أعوذ بالله من الشيطان الرجيم لذهب عنه ما يجد فقالوا له إن النبي ﭬ قال تعوذ بالله من الشيطان الرجيم الحديث.", "english": "[23] The hadith about the command to seek refuge with Allah from the Accursed Satan (Al-Shaytan Al-Rajim) during anger is agreed upon from the narration of Sulayman ibn Surad who said: I was sitting with the Prophet ﷺ and two men were insulting each other, and one of them had his face reddened and his veins swollen. The hadith contains: If he had said 'I seek refuge with Allah from the Accursed Satan (Al-Shaytan Al-Rajim)', what he was experiencing would have left him. So they said to him: Indeed the Prophet ﷺ said: Seek refuge with Allah from the Accursed Satan (Al-Shaytan Al-Rajim). The hadith.", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Condemnation of Envy'", "badge": "Hadith"}, {"arabic": "وأما العمل فإن تقول بلسانك أعوذ بالله من الشيطان الرجيم. هكذا أمر رسول الله ﷺ أن يقال عند الغيظ[23] وكان رسول الله ﷺ إذا غضبت عائشة أخذ بأنفها وقال \"يا عويش قولي اللهم رب النبي محمد اغفر لي ذنبي وأذهب غيظ قلبي وأجرني من مضلات الفتن\"[24] فيستحب أن تقول ذلك، فإن لم يزل بذلك فاجلس إن كنت قائماً واضجع إن كنت جالساً واقرب من الأرض التي منها خلقت لتعرف بذلك ذل نفسك، واطلب بالجلوس والاضجاع السكون فإن سبب الغضب الحرارة وسبب الحرارة الحركة. فقد قال رسول الله ﷺ \"إن الغضب جمرة توقد في القلب\"[25] ألم تروا إ", "english": "As for the action, then say with your tongue: 'I seek refuge in Allah from the accursed Satan (Shaytan).' Thus did the Messenger of Allah (peace be upon him) command that it be said during anger [23]. And the Messenger of Allah (peace be upon him), when Aisha became angry, would take her by the nose and say: 'O little Aisha, say: O Allah, Lord of the Prophet Muhammad, forgive me my sin, remove the anger of my heart (Qalb), and deliver me from misleading trials (Fitnah)' [24]. It is recommended to say that. If it does not cease with that, then sit if you are standing, and lie down if you are sitting, and draw near to the earth from which you were created, so that you may recognize thereby the lowliness of your soul (Nafs). And seek through sitting and lying down tranquility, for the cause of anger is heat, and the cause of heat is movement. Indeed, the Messenger of Allah (peace be upon him) said: 'Anger is an ember kindled in the heart (Qalb)' [25]. Have you not seen the swelling of his veins and the redness of his eyes? So if any of you finds something of that, then if he is standing, let him sit, and if he is sitting, let him lie down. If it does not cease with that, then let him perform ablution (Wudu) with cold water or bathe, for fire is not extinguished except by water. Indeed, he (peace be upon him) said: 'When one of you becomes angry, let him perform ablution (Wudu) with water, for indeed anger is from fire' [26]. And in a narration: 'Anger is from Satan (Shaytan), and Satan (Shaytan) was created from fire, and fire is only extinguished by water, so when one of you becomes angry, let him perform ablution (Wudu).' And Ibn Abbas said: The Messenger of Allah (peace be upon him) said: 'And when you become angry, be silent' [27]. And Abu Huraira said: The Messenger of Allah (peace be upon him), when he became angry while standing, would sit, and when he became angry while sitting, would lie down, and his anger would depart [28].", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Envy'", "badge": "Insight"}], "102": [{"arabic": "ثم أخبر أن له عبدين يحب أحدهما واسمه جبريل وروح القدس والأمين وهو عنده محبوب مطاع أمين مكين ويبغض الآخر واسمه إبليس وهو اللعين المنظر إلى يوم الدين، ثم أحال الإرشاد إلى جبريل فقال تعالى: ﴿ قل نزله روح القدس من ربك بالحق ﴾ {} وقال تعالى: ﴿ يلقى الروح من أمره على من يشاء من عباده ﴾ {} وأحال الإغواء على إبليس فقال تعالى: ﴿ ليضلّ عن سبيله ﴾ {} والإغواء هو استيقاف العباد دون بلوغ غاية الحكمة فانظر كيف نسبه إلى العبد الذى غضب عليه والإرشاد سياقه لهم إلى الغاية فانظر كيف نسبه إلى العبد الذى أحبه وعندك ", "english": "Then He informed that He has two servants: He loves one of them, and his name is Jibril and the Spirit of Holiness (Ruh al-Qudus) and the Trustworthy (Al-Amin), and he is with Him beloved, obeyed, trustworthy, and firmly established; and He detests the other, and his name is Iblis, and he is the accursed one, granted respite until the Day of Recompense (Yawm al-Din). Then He attributed guidance to Jibril, so the Exalted said: 'Say: The Spirit of Holiness (Ruh al-Qudus) has brought it down from your Lord with truth' {} and He said: 'He casts the Spirit (Ruh) from His command upon whom He wills of His servants' {} and He attributed misguidance to Iblis, so He said: 'To lead astray from His path' {} and misguidance is preventing the servants from reaching the ultimate wisdom. So see how He attributed it to the servant upon whom He is angry, and guidance is leading them to the ultimate goal, so see how He attributed it to the servant whom He loved. And you have in custom an example for it: if a king needs someone to give him drink and someone to perform cupping and clean the courtyard of his house from filth, and he has two servants, then he does not assign for cupping and cleaning except the ugliest and most base of them, and he does not entrust carrying the drink and perfume except to the best, most complete, and most beloved of them to him. And it is not fitting for you to say: 'This is my action, and was not his action without my action?' For you have erred when you attributed that to yourself; rather, it is He who directed your motivation to specify the disliked action with the disliked person and the beloved action with the beloved person, completing justice. For His justice (Adl) is sometimes accomplished through matters in which you have no involvement, and sometimes it is accomplished in you, for you are also from His actions. So your motivation, your capability, your knowledge, your action, and all the causes of your movements in expression are His action which He arranged with justice, an arrangement from which balanced actions issue, except that you see only yourself, so you think that what appears upon you in the world of witnessing (Alam al-Shahadah) has no cause.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "105": [{"arabic": "وعن عبد الله بن جراد قال: سألت رسول الله ﭬ فقلت: يا رسول الله هل يزني المؤمن؟ قال \"قد يكون ذلك\" قال: يا نبي الله هل يكذب المؤمن؟ قال \"لا\" ثم أتبعها ﭬ بقول الله تعالى \"إنما يفتري الكذب الذين لا يؤمنون بآيات الله\"", "english": "And from Abdullah ibn Jarad, he said: I asked the Messenger of Allah (peace be upon him) and I said: O Messenger of Allah, does the believer (Mu'min) commit adultery? He said: \"That may occur.\" He said: O Prophet of Allah, does the believer (Mu'min) lie? He said: \"No.\" Then he (peace be upon him) followed it with the saying of Allah the Exalted: \"Only those who do not believe in the signs (Ayat) of Allah fabricate falsehood.\"", "book_file": "vol3_Vol3-book4a.doc.txt", "book_title": "Condemnation of Anger and Hatred", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Anger and Hatred'", "badge": "Ethics"}], "107": [{"arabic": "فمهما كان القلب الغالب عليه عند الموت حب الأهل والولد والمال والمسكن والعقار والرفقاء والأصحاب فهذا رجل محابه كلها في الدنيا فالدنيا جنته إذ الجنة عبارة عن البقعة الجامعة لجميع المحاب فموته خروج من الجنة وحيلولة بينه وبين ما يشتهيه ولا يخفى حال من يحال بينه وبين ما يشتهيه فإذا لم يكن له محبوب سوى الله تعالى وسوى ذكره ومعرفته والفكر فيه والدنيا وعلائقها شاغلة له عن المحبوب فالدنيا إذن سجنه لأن السجن عبارة عن البقعة المانعة للمحبوس عن الاسترواح إلى محابه فموته قوم على محبوبه وخلاص من السجن ولا يخف", "english": "Whenever the Heart (Qalb) that dominates at the time of death is love of family, children, wealth, residence, property, companions, and friends, then this is a man whose loves are all in the worldly life (Dunya). Thus, the worldly life is his paradise, since paradise is an expression for the place that gathers all loves. His death is an exit from paradise and a barrier between him and what he desires, and the state of one who is barred between him and what he desires is not hidden. If he has no beloved except Allah, the Exalted, and except His Remembrance (Dhikr), knowledge of Him, and contemplation of Him, and the worldly life and its attachments distract him from the Beloved, then the worldly life is his prison, because prison is an expression for the place that prevents the imprisoned from finding relief in his loves. His death is a standing before his Beloved and a liberation from prison, and the state of one who escapes from prison and is left between him and his Beloved without any barrier or disturbance is not hidden. This is the first thing that everyone who departs from the worldly life encounters immediately after his death from reward and punishment, apart from what Allah has prepared for His righteous servants that no eye has seen, no ear has heard, and no human heart has conceived, and apart from what Allah, the Exalted, has prepared for those who preferred the worldly life over the Hereafter and were pleased with it and felt secure in it—from shackles, chains, fetters, and various kinds of disgrace and punishment. So we ask Allah, the Exalted, to cause us to die as Muslims and join us with the righteous, and there is no hope in the answer to this supplication except by acquiring the love of Allah, the Exalted, and there is no way to it except by removing the love of other than Him from the Heart (Qalb) and cutting off attachments to everything other than Allah, the Exalted, from status, wealth, and homeland. Thus, it is best to supplicate with what our Prophet ﷺ supplicated when he said: 'O Allah, grant me Your love and the love of those who love You and the love of what brings me closer to Your love, and make Your love more beloved to me than cold water.' The purpose is that the dominance of hope at the time of death is better because it is more conducive to love, and the dominance of fear before death is better because it burns the fire of desires and suppresses the love of the worldly life from the Heart (Qalb). Therefore, he ﷺ said: 'Let none of you die except while having good thoughts of his Lord,' and Allah, the Exalted, said: 'I am as My servant thinks of Me, so let him think of Me what he wills.' And when the death of Sulayman al-Taymi approached, he said to his son: 'O my son, tell me the leniencies and remind me of hope so that I meet Allah with good thoughts of Him.' Likewise, when the death of al-Thawri approached and his distress intensified, he gathered scholars around him to give him hope, and Ahmad ibn Hanbal, may Allah be pleased with him, said to his son at the time of death: 'Remind me of the reports that contain hope and good thoughts.' The intended purpose of all that is that Allah, the Exalted, makes beloved...", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Fear and Hope'", "badge": "Insight"}, {"arabic": "وإنما تكثر الحيات والعقارب في قبور الأغنياء الذين استحبوا الحياة الدنيا على الآخرة وفرحوا بها واطمأنوا إليها فهذه مقامات الإيمان في حيات القبر وعقاربه وفي سائر أنواع عذابه.", "english": "And indeed, the snakes and scorpions multiply in the graves of the wealthy who preferred the worldly life (Al-Hayat Al-Dunya) over the Hereafter (Al-Akhirah) and rejoiced in it and found tranquility in it. These are the stations of faith (Iman) in the snakes of the grave and its scorpions and in all other types of its punishment.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}], "109": [{"arabic": "رغبوا في عرض الدنيا ورفعتها وآثروها على الآخرة، وأدلوا الدين للدنيا فهم في العاجل عار وشين، وفي الآخرة هم الخاسرون أو يعفو الكريم بفضله.", "english": "They desired the fleeting pleasure (عرض) of this world and its elevation, and preferred it over the Hereafter (الآخرة), and they sold the religion (الدين) for this world, so they are in the immediate [life] disgrace and shame, and in the Hereafter they are the losers (الخاسرون) or the Generous One (الكريم) may pardon by His grace.", "book_file": "vol3_Vol3-book-7a.doc.txt", "book_title": "Condemnation of Miserliness and Love of Wealth", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Ethics"}, {"arabic": "رغبوا في عرض الدنيا ورفعتها وآثروها على الآخرة وأذلوا الدين للدنيا، فهم في العاجل عار وشين وفي الآخرة هم لخاسرون.", "english": "They desired the fleeting enjoyment (عرض) of this world and its elevation, and preferred it over the Hereafter (الآخرة), and humiliated the religion (الدين) for the sake of this world (الدنيا). So they are in the immediate [life] disgrace and shame, and in the Hereafter (الآخرة) they are the losers (الخاسرون).", "book_file": "vol3_Vol3-book-8a.doc.txt", "book_title": "Condemnation of Status and Ostentation", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Status and Ostentation'", "badge": "Ethics"}], "111": [{"arabic": "وأتى هشام برجل بلغه عنه أمر فلما أقيم بين يديه جعل يتكلم بحجته فقال له هشام: وتتكلم أيضاً؟ فقال الرجل: يا أمير المؤمنين قال الله عز وجل \"يوم تأتي كل نفس تجادل عن نفسها\" أفنجادل الله تعالى ولا نتكلم بين يديك كلاماً؟ قال هشام: بلى ويحك تكلم.", "english": "And Hisham was brought a man about whom something had reached him. When he was placed before him, he began to speak with his argument. Hisham said to him: 'And you still speak?' The man said: 'O Commander of the Faithful, Allah the Exalted said: \"On the Day when every Soul (Nafs) will come disputing for itself.\" Shall we dispute with Allah the Exalted and not speak before you with speech?' Hisham said: 'Yes, woe to you, speak.'", "book_file": "vol3_Vol3-book5a.doc.txt", "book_title": "Condemnation of Envy", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Envy'", "badge": "Insight"}, {"arabic": "وستجد كل نفس ما عملت من سوء أو خير محضرا عند الله ولو في فلتة خاطر أو فلتة ناظر من غير ظلم وجور فما الله بظلام للعبيد", "english": "And every soul (Nafs) will find what it has done of evil or good present before Allah, even if in a fleeting thought (Khatir) or a fleeting glance (Nazir), without injustice (Zulm) or oppression (Jawr), for Allah is not unjust (Zalim) to His servants.", "book_file": "vol2_j2-k09.doc.txt", "book_title": "Enjoining Good and Forbidding Evil", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}], "120": [{"arabic": "وأما الأمة فتطلق على ثمانية أوجه الأمة الجماعة كقوله تعالى ﴿ وجد عليه أمة من الناس يسقون ﴾ {} وأتباع الأنبياء كقولك عن أمة محمد ﭬ، ورجل جامع للخير يقتدي به كقوله تعالى ﴿ إن إبراهيم كان أمة قانتا لله ﴾ {} والأمة الدين كقوله عز وجل ﴿ إنا وجدنا آباءنا على أمة ﴾ {} والأمة الحين والزمان كقوله عز وجل ﴿ إلى أمة معدودة ﴾ {} وقوله عز وجل ﴿ وادكر بعد أمة ﴾ {} والأمة القامة يقال فلان حسن الأمة أي القامة، وأمة رجل منفرد بدين لا يشركه فيه أحد قال ﭬ: (يبعث زيد بن عمرو بن نفيل أمة وحده[57]) والأمة الأم يقال هذ", "english": "And as for 'Ummah' (الأمة), it is applied in eight aspects: The 'Ummah' as a community, as in His saying, the Exalted: 'He found there a community (Ummah) of people watering' (Quran 28:23); and the followers of the prophets, as you say regarding the 'Ummah' of Muhammad (peace be upon him); and a man comprehensive of good who is followed, as in His saying, the Exalted: 'Indeed, Abraham was a community (Ummah), devoutly obedient (Qanitan) to Allah, a true monotheist (Hanifan), and he was not of the polytheists' (Quran 16:120); and the 'Ummah' as religion, as in His saying, the Exalted: 'Indeed, we found our fathers upon a community (Ummah)' (Quran 43:22); and the 'Ummah' as a time or period, as in His saying, the Exalted: 'Until a numbered community (Ummah)' (Quran 11:8) and His saying, the Exalted: 'And remember after a community (Ummah)' (Quran 12:45); and the 'Ummah' as stature, it is said: 'So-and-so has a good 'Ummah' meaning stature; and the 'Ummah' of a man isolated in a religion with no one sharing him in it, he (peace be upon him) said: 'Zayd ibn 'Amr ibn Nufayl will be resurrected as a community (Ummah) alone' (Hadith); and the 'Ummah' as mother, it is said: 'This is the 'Ummah' of Zayd' meaning the mother of Zayd.", "book_file": "vol1_Vol1-book-8.doc.txt", "book_title": "Etiquette of Quran Recitation", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "123": [{"arabic": "تستجيب لي أخرجه أبو منصور الديلمي في مسند الفردوس من حديث ابن عباس\n    اللهم ابعثنا في أحب الساعات إليك حتى نذكرك فتذكرنا ونسألك فتعطينا وندعوك\n    فتستجيب لنا ونستغفرك فتغفر لنا وإسناده ضعيف وهو معروف من قول حبيب الطائي\n                                          كما رواه ابن أبي الدنيا في الدعاء.\n   [230]  حديث القول إذا استيقظ من منامه الحمد لله الذي أحيانا بعد ما أماتنا\n              وإليه النشور أخرجه البخاري من حديث حذيفة ومسلم من حديث البراء.\n  [231]  حديث أصبحنا وأصبح الملك لله والعظمة وال", "english": "[232] Hadith: We have awakened upon the natural disposition (Fitrah) of Islam and the word of sincerity (Kalimat al-Ikhlas) and the religion of our Prophet Muhammad (peace be upon him) and the way (Millah) of our father Abraham, upright (Hanifan) and he was not of the polytheists (Mushrikin). Al-Nasa'i transmitted it in Al-Yawm wa al-Laylah from the narration of Abd al-Rahman ibn Abza with a sound chain, and Ahmad transmitted it from the narration of Ibn Abza from Ubayy ibn Ka'b, raised to the Prophet.", "book_file": "vol1_Vol1-book-9.doc.txt", "book_title": "On Invocations and Supplications", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication", "badge": "Hadith"}], "125": [{"arabic": "ولم تزل الرسل صلوات الله عليهم يحاجون المنكرين ويجادلونهم قال تعالى: ﴿ وجادلهم بالتي هي أحسن ﴾ {} فالصحابة رضي الله عنهم أيضا كانوا يحاجون المنكرين ويجادلون ولكن عند الحاجة وكانت الحاجة إليه قليلة في زمانهم وأول من سن دعوة المبتدعة بالمجادلة إلى الحق علي ابن أبي طالب رضي الله عنه إذ بعث ابن عباس رضي الله عنهما إلى الخوارج فكلمهم فقال ما تنقمون على إمامكم قالوا قاتل ولم يسب ولم يغنم فقال ذلك في قتال الكفار أرأيتم لو سببت عائشة رضي الله عنها في سهم أحدكم أكنتم تستحلون منها ما تستحلون من ملككم وهي ", "english": "And the Messengers, prayers of Allah be upon them, never ceased to argue with the deniers and debate with them. Allah the Exalted said: 'And debate with them in that which is best (bil-latī hiya aḥsanu).' So the Companions, may Allah be pleased with them, also used to argue with the deniers and debate, but only when necessary, and the need for it was little in their time. The first to establish calling the innovators to the truth through debate was Ali ibn Abi Talib, may Allah be pleased with him, when he sent Ibn Abbas, may Allah be pleased with them both, to the Khawarij and he spoke to them. He said: 'What do you find fault with regarding your Imam?' They said: 'He fought but did not take captives nor spoils.' He said: 'That was in fighting the disbelievers. Tell me, if Aisha, may Allah be pleased with her, were among your spoils, would you consider lawful from her what you consider lawful from your property, while she is your mother according to the clear text of the Book?' They said: 'No.' So two thousand of them returned to obedience through his debate.", "book_file": "vol1_Vol1-book-2.doc.txt", "book_title": "Foundations of Belief", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Foundations of Belief'", "badge": "Du'a"}, {"arabic": "وقال تعالى: ﴿ومن أحسن قولا ممن دعا إلى الله وعمل صالحا﴾ ( سورة فصلت: الآية 33) وقال تعالى: ﴿ادع إلى سبيل ربك بالحكمة والموعظة الحسنة﴾ ( سورة النحل: الآية 125) وقال تعالى: ﴿ويعلمهم الكتاب والحكمة﴾( سورة البقرة: الآية 129و الآية:151، وسورة آل عمران، الآية:164 وسورة الجمعة، الآية:2.).", "english": "And He (Exalted is He) said: 'And who is better in speech than one who invites to Allah and does righteous work' (Surah Fussilat: Verse 33). And He (Exalted is He) said: 'Invite to the way of your Lord with wisdom and good admonition' (Surah An-Nahl: Verse 125). And He (Exalted is He) said: 'And teaches them the Book and the Wisdom' (Surah Al-Baqarah: Verse 129 and Verse:151, and Surah Al-Imran, Verse:164 and Surah Al-Jumu'ah, Verse:2.).", "book_file": "vol1_Vol1-book-1.doc.txt", "book_title": "Book of Knowledge", "content_type": "hadith", "topic": "Prophetic traditions cited by Al-Ghazali with scholarly authentication, from 'Book of Knowledge'", "badge": "Hadith"}], "126": [{"arabic": "وقال تعالى: ﴿ وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو خير الصابرين ﴾ {}. وقال ﭬ: (صل من قطعك وأعط من حرمك واعف عمن ظلمك[25]) ورأيت في الإنجيل قال عيسى بن مريم عليه السلام لقد قيل لكم من قبل إن السن بالسن والأنف بالأنف وأنا أقول لكم لا تقاوموا بالشر بل من ضرب خدك الأيمن فحول إليه الخد الأيسر ومن اخذ رداءك فاعطه ازارك ومن سخرك لتسير معه ميلا فسر معه ميلين وكل ذلك أمر بالصبر على الاذى، فالصبر على اذى الناس من أعلى مراتب الصبر لانه يتعاون فيه باعث الدين وباعث الشهوة والغضب جميعا.", "english": "And Allah the Exalted said: 'And if you retaliate, then retaliate with the like of that with which you were afflicted. But if you are patient, it is indeed better for the patient ones.' And the Prophet (peace be upon him) said: 'Maintain ties with the one who cuts you off, give to the one who deprives you, and pardon the one who wrongs you.' And I saw in the Gospel that Jesus son of Mary (peace be upon him) said: 'It was said to you before: An eye for an eye and a tooth for a tooth, but I say to you: Do not resist evil, but whoever strikes your right cheek, turn to him the other also; and whoever takes your cloak, give him your tunic; and whoever compels you to go one mile, go with him two.' And all of that commands patience upon harm, for patience upon the harm of people is from the highest levels of patience because in it the motivator of religion and the motivator of desire and anger all cooperate.", "book_file": "vol4_Vol4-book2.doc.txt", "book_title": "Patience and Gratitude", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Patience and Gratitude'", "badge": "Insight"}], "128": [{"arabic": "وهم أربعون صديقاً أو ثلاثون رجلاً قلوبهم على مثل يقين إبراهيم خليل الرحمن عليه السلام لا يموت الرجل منهم حتى يكون الله قد أنشأ من يخلفه، واعلم يا أخي أنهم لا يلعنون شيئاً ولا يؤذونه ولا يحقرونه ولا يتطاولون عليه ولا يحسدون أحداً ولا يحصرون على الدنيا، هم أطيب الناس خيراً وألينهم عريكة وأسخاهم نفساً، علامتهم السخاء وسجيتهم البشاشة وصفتهم السلامة، ليسوا اليوم في خشية وغداً في غفلة ولكن مدامين على حالهم الظاهر وهم فيما بينهم وبين ربهم لا تدركهم الرياح العواصف ولا الخيل المجراة، قلوبهم تصعد ارتياحاً", "english": "And they are forty righteous ones or thirty men whose hearts (Qulub) are upon the certainty (Yaqin) like Ibrahim, the intimate friend (Khalil) of the Most Merciful, peace be upon him. No man among them dies until Allah has raised up one to succeed him. And know, O my brother, that they do not curse anything, nor harm it, nor belittle it, nor act arrogantly toward it, nor envy anyone, nor are they preoccupied with the worldly life (Dunya). They are the best of people in goodness, the most gentle in disposition, and the most generous in soul (Nafs). Their sign is generosity, their nature is cheerfulness, and their attribute is safety. They are not today in fear and tomorrow in heedlessness, but rather they are constant in their outward state, and between them and their Lord, the raging winds and galloping horses do not reach them. Their hearts ascend with delight to Allah and longing for Him, and they are foremost in racing toward good deeds. \"Those are the party of Allah. Indeed, the party of Allah are the successful.\" The narrator said: So I said: O Abu al-Darda, I have not heard of a description more difficult for me than that description, and how can I attain it? He said: Between you and being in its broadest scope is nothing except that you hate the worldly life (Dunya). For if you hate the worldly life, you turn to the love (Hubb) of the Hereafter (Akhirah), and according to the measure of your love for the Hereafter, you abstain from the worldly life, and according to that measure, you perceive what benefits you. And when Allah knows from a servant (Abd) good seeking, He pours upon him correctness and surrounds him with protection. And know, O son of my brother, that this is in the Book of Allah, the Exalted, the Revealed: \"Indeed, Allah is with those who fear (Ittaqaw) and those who are doers of good (Muhsinun).\" Yahya ibn Kathir said: So we reflected on that, and the delighters have not delighted in anything like the love (Hubb) of Allah and seeking His pleasure. O Allah, make us among the lovers of those who love You, O Lord of the worlds, for none is suitable for Your love except whom You have approved. And may Allah bless our master Muhammad and his family and companions and grant them peace.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 1848], [2, 1848, 2608], [3, 2608, 3546], [4, 3546, 4401], [5, 4401, 6467], [6, 6467, 7894], [7, 7894, 9751], [8, 9751, 10998], [9, 10998, 12706]], "2": [[1, 400, 1676], [2, 1676, 3620], [3, 3620, 5236], [4, 5236, 5722], [5, 5722, 6718], [6, 6718, 7836], [7, 7836, 8322], [8, 8322, 10183], [9, 10183, 10669], [10, 10669, 12404], [11, 12404, 12939], [12, 12939, 15320], [13, 15320, 16426], [14, 16426, 17680], [15, 17680, 18579], [16, 18579, 20307], [17, 20307, 21230], [18, 21230, 22868]], "3": [[1, 400, 1121], [2, 1121, 2918], [3, 2918, 4295], [4, 4295, 5497], [5, 5497, 6878], [6, 6878, 8025], [7, 8025, 9598]], "4": [[1, 400, 1185], [2, 1185, 2674], [3, 2674, 3150], [4, 3150, 4548], [5, 4548, 5714], [6, 5714, 6285], [7, 6285, 7451], [8, 7451, 8866]], "5": [[1, 400, 1998], [2, 1998, 3168], [3, 3168, 3773], [4, 3773, 4782], [5, 4782, 5347], [6, 5347, 6618], [7, 6618, 7828], [8, 7828, 9180]], "6": [[1, 350, 1145], [2, 1145, 2029], [3, 2029, 2842], [4, 2842, 3478], [5, 3478, 4733], [6, 4733, 5635], [7, 5635, 6820]], "7": [[1, 400, 1605], [2, 1605, 3348], [3, 3348, 4338], [4, 4338, 4984], [5, 4984, 5576], [6, 5576, 7212], [7, 7212, 8525], [8, 8525, 9504], [9, 9504, 10430], [10, 10430, 11635], [11, 11635, 12421], [12, 12421, 13443], [13, 13443, 14584], [14, 14584, 15736]], "8": [[1, 400, 1487], [2, 1487, 2761], [3, 2761, 4018], [4, 4018, 5547], [5, 5547, 6532], [6, 6532, 7602], [7, 7602, 8044], [8, 8044, 8486], [9, 8486, 9624]], "9": [[1, 400, 1422], [2, 1422, 2198], [3, 2198, 2886], [4, 2886, 4207], [5, 4207, 5386], [6, 5386, 68