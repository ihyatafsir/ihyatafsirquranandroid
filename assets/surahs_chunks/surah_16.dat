ࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَعْقِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 13, "text": "وَمَا ذَرَأَ لَكُمْ فِے اِ۬لَارْضِ مُخْتَلِفاً اَلْوَٰنُهُۥٓۖ إِنَّ فِے ذَٰلِكَ لَأٓيَةࣰ لِّقَوْمࣲ يَذَّكَّرُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَرَأَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُخْتَلِفاً", "translit": "", "root": ""}, {"id": 7, "arabic": "اَلْوَٰنُهُۥٓۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَأٓيَةࣰ", "translit": "", "root": ""}, {"id": 12, "arabic": "لِّقَوْمࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَذَّكَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 14, "text": "وَهُوَ اَ۬لذِے سَخَّرَ اَ۬لْبَحْرَ لِتَاكُلُواْ مِنْهُ لَحْماࣰ طَرِيّاࣰ وَتَسْتَخْرِجُواْ مِنْهُ حِلْيَةࣰ تَلْبَسُونَهَاۖ وَتَرَي اَ۬لْفُلْكَ مَوَاخِرَ فِيهِ وَلِتَبْتَغُواْ مِن فَضْلِهِۦ وَلَعَلَّكُمْ تَشْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "سَخَّرَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْبَحْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِتَاكُلُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَحْماࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "طَرِيّاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَتَسْتَخْرِجُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنْهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "حِلْيَةࣰ", "translit": "", "root": ""}, {"id": 12, "arabic": "تَلْبَسُونَهَاۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَتَرَي", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لْفُلْكَ", "translit": "", "root": ""}, {"id": 15, "arabic": "مَوَاخِرَ", "translit": "", "root": ""}, {"id": 16, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَلِتَبْتَغُواْ", "translit": "", "root": ""}, {"id": 18, "arabic": "مِن", "translit": "", "root": ""}, {"id": 19, "arabic": "فَضْلِهِۦ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَلَعَلَّكُمْ", "translit": "", "root": ""}, {"id": 21, "arabic": "تَشْكُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 15, "text": "۞وَأَلْق۪يٰ فِے اِ۬لَارْضِ رَوَٰسِيَ أَن تَمِيدَ بِكُمْ وَأَنْهَٰراࣰ وَسُبُلاࣰ لَّعَلَّكُمْ تَهْتَدُونَ", "words": [{"id": 1, "arabic": "۞وَأَلْق۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَوَٰسِيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَمِيدَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَأَنْهَٰراࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَسُبُلاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَّعَلَّكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "تَهْتَدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 16, "text": "وَعَلَٰمَٰتࣲۖ وَبِالنَّجْمِ هُمْ يَهْتَدُونَۖ", "words": [{"id": 1, "arabic": "وَعَلَٰمَٰتࣲۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَبِالنَّجْمِ", "translit": "", "root": ""}, {"id": 3, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَهْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 17, "text": "أَفَمَنْ يَّخْلُقُ كَ