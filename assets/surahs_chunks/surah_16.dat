tion": "warsh"}, {"surah": 16, "ayah": 8, "text": "وَالْخَيْلَ وَالْبِغَالَ وَالْحَمِيرَ لِتَرْكَبُوهَا وَزِينَةࣰۖ وَيَخْلُقُ مَا لَا تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَالْخَيْلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَالْبِغَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالْحَمِيرَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِتَرْكَبُوهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "وَزِينَةࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَخْلُقُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "", "root": ""}, {"id": 9, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 9, "text": "وَعَلَي اَ۬للَّهِ قَصْدُ اُ۬لسَّبِيلِ وَمِنْهَا جَآئِرࣱۖ وَلَوْ شَآءَ لَهَد۪يٰكُمُۥٓ أَجْمَعِينَۖ", "words": [{"id": 1, "arabic": "وَعَلَي", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَصْدُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لسَّبِيلِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمِنْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "جَآئِرࣱۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 8, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَهَد۪يٰكُمُۥٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَجْمَعِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 10, "text": "هُوَ اَ۬لذِےٓ أَنزَلَ مِنَ اَ۬لسَّمَآءِ مَآءࣰ لَّكُم مِّنْهُ شَرَابࣱ وَمِنْهُ شَجَرࣱ فِيهِ تُسِيمُونَۖ", "words": [{"id": 1, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِےٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"i