 {"id": 4, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَخْلُقُونَ", "translit": "", "root": ""}, {"id": 8, "arabic": "شَئْاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يُخْلَقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 21, "text": "أَمْوَٰتٌ غَيْرُ أَحْيَآءࣲۖ وَمَا يَشْعُرُونَ أَيَّانَ يُبْعَثُونَۖ", "words": [{"id": 1, "arabic": "أَمْوَٰتٌ", "translit": "", "root": ""}, {"id": 2, "arabic": "غَيْرُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَحْيَآءࣲۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَشْعُرُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَيَّانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "يُبْعَثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 22, "text": "إِلَٰهُكُمُۥٓ إِلَٰهࣱ وَٰحِدࣱۖ فَالذِينَ لَا يُومِنُونَ بِالَاخِرَةِ قُلُوبُهُم مُّنكِرَةࣱ وَهُم مُّسْتَكْبِرُونَۖ", "words": [{"id": 1, "arabic": "إِلَٰهُكُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَٰهࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَٰحِدࣱۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَالذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "يُومِنُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِالَاخِرَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "قُلُوبُهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مُّنكِرَةࣱ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّسْتَكْبِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 23, "text": "لَا جَرَمَ أَنَّ اَ۬للَّهَ يَعْلَمُ مَا يُسِرُّونَ وَمَا