ext": "وَاللَّهُ خَلَقَكُمْ ثُمَّ يَتَوَفّ۪يٰكُمْۖ وَمِنكُم مَّنْ يُّرَدُّ إِلَيٰٓ أَرْذَلِ اِ۬لْعُمُرِ لِكَےْ لَا يَعْلَمَ بَعْدَ عِلْمࣲ شَئْاًۖ اِنَّ اَ۬للَّهَ عَلِيمࣱ قَدِيرࣱۖ", "words": [{"id": 1, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَتَوَفّ۪يٰكُمْۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمِنكُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يُّرَدُّ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَرْذَلِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْعُمُرِ", "translit": "", "root": ""}, {"id": 11, "arabic": "لِكَےْ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "", "root": ""}, {"id": 13, "arabic": "يَعْلَمَ", "translit": "", "root": ""}, {"id": 14, "arabic": "بَعْدَ", "translit": "", "root": ""}, {"id": 15, "arabic": "عِلْمࣲ", "translit": "", "root": ""}, {"id": 16, "arabic": "شَئْاًۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 19, "arabic": "عَلِيمࣱ", "translit": "", "root": ""}, {"id": 20, "arabic": "قَدِيرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 71, "text": "۞وَاللَّهُ فَضَّلَ بَعْضَكُمْ عَلَيٰ بَعْضࣲ فِے اِ۬لرِّزْقِۖ فَمَا اَ۬لذِينَ فُضِّلُواْ بِرَآدِّے رِزْقِهِمْ عَلَيٰ مَا مَلَكَتَ اَيْمَٰنُهُمْ فَهُمْ فِيهِ سَوَآءٌۖ اَفَبِنِعْمَةِ اِ۬للَّهِ يَجْحَدُونَۖ", "words": [{"id": 1, "arabic": "۞وَاللَّهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَضَّلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَعْضَكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَعْضࣲ", "translit": "", "root": ""}, 