 "arabic": "تَسْرَحُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 7, "text": "وَتَحْمِلُ أَثْقَالَكُمُۥٓ إِلَيٰ بَلَدࣲ لَّمْ تَكُونُواْ بَٰلِغِيهِ إِلَّا بِشِقِّ اِ۬لَانفُسِۖ إِنَّ رَبَّكُمْ لَرَءُوفࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "وَتَحْمِلُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَثْقَالَكُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَلَدࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَكُونُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "بَٰلِغِيهِ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "بِشِقِّ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لَانفُسِۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "رَبَّكُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَرَءُوفࣱ", "translit": "", "root": ""}, {"id": 14, "arabic": "رَّحِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 8, "text": "وَالْخَيْلَ وَالْبِغَالَ وَالْحَمِيرَ لِتَرْكَبُوهَا وَزِينَةࣰۖ وَيَخْلُقُ مَا لَا تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَالْخَيْلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَالْبِغَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالْحَمِيرَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِتَرْكَبُوهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "وَزِينَةࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَخْلُقُ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "", "root": ""}, {"id": 9, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 9, "text": "وَعَلَي اَ۬للَّهِ قَصْدُ اُ۬لسَّبِيلِ وَمِنْهَا جَآئِرࣱۖ وَلَوْ شَآءَ لَهَد۪