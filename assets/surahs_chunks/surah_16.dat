 14, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَعْلَمُ", "translit": "", "root": ""}, {"id": 16, "arabic": "بِمَن", "translit": "", "root": ""}, {"id": 17, "arabic": "ضَلَّ", "translit": "", "root": ""}, {"id": 18, "arabic": "عَن", "translit": "", "root": ""}, {"id": 19, "arabic": "سَبِيلِهِۖۦ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 21, "arabic": "أَعْلَمُ", "translit": "", "root": ""}, {"id": 22, "arabic": "بِالْمُهْتَدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 126, "text": "وَإِنْ عَاقَبْتُمْ فَعَاقِبُواْ بِمِثْلِ مَا عُوقِبْتُم بِهِۦۖ وَلَئِن صَبَرْتُمْ لَهُوَ خَيْرࣱ لِّلصَّٰبِرِينَۖ", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَاقَبْتُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَعَاقِبُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِمِثْلِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "عُوقِبْتُم", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِۦۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَئِن", "translit": "", "root": ""}, {"id": 9, "arabic": "صَبَرْتُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَهُوَ", "translit": "", "root": ""}, {"id": 11, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "لِّلصَّٰبِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 16, "ayah": 127, "text": "وَاصْبِرْۖ وَمَا صَبْرُكَ إِلَّا بِاللَّهِۖ وَلَا تَحْزَنْ عَلَيْهِمْ وَلَا تَكُ فِے ضَيْقࣲ مِّمَّا يَمْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَاصْبِرْۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "صَبْرُكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "بِاللَّهِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَا", "t