 55, "text": "إِذْ قَالَ اَ۬للَّهُ يَٰعِيس۪يٰٓ إِنِّے مُتَوَفِّيكَ وَرَافِعُكَ إِلَيَّ وَمُطَهِّرُكَ مِنَ اَ۬لذِينَ كَفَرُواْۖ وَجَاعِلُ اُ۬لذِينَ اَ۪تَّبَعُوكَ فَوْقَ اَ۬لذِينَ كَفَرُوٓاْ إِلَيٰ يَوْمِ اِ۬لْقِيَٰمَةِۖ ثُمَّ إِلَيَّ مَرْجِعُكُمْ فَأَحْكُمُ بَيْنَكُمْ فِيمَا كُنتُمْ فِيهِ تَخْتَلِفُونَۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَٰعِيس۪يٰٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 6, "arabic": "مُتَوَفِّيكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَرَافِعُكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَيَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمُطَهِّرُكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 12, "arabic": "كَفَرُواْۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَجَاعِلُ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 15, "arabic": "اَ۪تَّبَعُوكَ", "translit": "", "root": ""}, {"id": 16, "arabic": "فَوْقَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 18, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 19, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 20, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 21, "arabic": "اِ۬لْقِيَٰمَةِۖ", "translit": "", "root": ""}, {"id": 22, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 23, "arabic": "إِلَيَّ", "translit": "", "root": ""}, {"id": 24, "arabic": "مَرْجِعُكُمْ", "translit": "", "root": ""}, {"id": 25, "arabic": "فَأَحْكُمُ", "translit": "", "root": ""}, {"id": 26, "arabic": "بَيْنَكُمْ", "translit": "", "root": ""}, {"id": 27, "arabic": "فِيمَا", "translit": "", "r