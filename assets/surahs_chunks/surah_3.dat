اِ۬لْغَمِّ أَمَنَةࣰ نُّعَاساࣰ يَغْش۪يٰ طَآئِفَةࣰ مِّنكُمْۖ وَطَآئِفَةࣱ قَدَ اَهَمَّتْهُمُۥٓ أَنفُسُهُمْ يَظُنُّونَ بِاللَّهِ غَيْرَ اَ۬لْحَقِّ ظَنَّ اَ۬لْجَٰهِلِيَّةِۖ يَقُولُونَ هَل لَّنَا مِنَ اَ۬لَامْرِ مِن شَےْءࣲۖ قُلِ اِنَّ اَ۬لَامْرَ كُلَّهُۥ لِلهِۖ يُخْفُونَ فِےٓ أَنفُسِهِم مَّا لَا يُبْدُونَ لَكَۖ يَقُولُونَ لَوْ كَانَ لَنَا مِنَ اَ۬لَامْرِ شَےْءࣱ مَّا قُتِلْنَا هَٰهُنَاۖ قُل لَّوْ كُنتُمْ فِے بُيُوتِكُمْ لَبَرَزَ اَ۬لذِينَ كُتِبَ عَلَيْهِمُ اُ۬لْقَتْلُ إِلَيٰ مَضَاجِعِهِمْ وَلِيَبْتَلِيَ اَ۬للَّهُ مَا فِے صُدُورِكُمْ وَلِيُمَحِّصَ مَا فِے قُلُوبِكُمْۖ وَاللَّهُ عَلِيمُۢ بِذَاتِ اِ۬لصُّدُورِۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْغَمِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَمَنَةࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "نُّعَاساࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَغْش۪يٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "طَآئِفَةࣰ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّنكُمْۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَطَآئِفَةࣱ", "translit": "", "root": ""}, {"id": 13, "arabic": "قَدَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَهَمَّتْهُمُۥٓ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَنفُسُهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "يَظُنُّونَ", "translit": "", "root": ""}, {"id": 17, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 18, "arabic": "غَيْرَ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬لْحَقِّ", "translit": "", "root": ""}, {"id": 20, "arabic": "ظَنَّ", "translit": "", "root": ""}, {"id": 21, "arabic": "اَ۬لْجَٰهِلِيَّةِۖ", "translit": "", "root": ""}, {"id": 22, "arabic": "يَقُولُونَ", "translit": "", "root