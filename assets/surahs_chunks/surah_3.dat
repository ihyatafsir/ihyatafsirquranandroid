"رَبُّكُم", "translit": "mُkُّbَr", "root": "ربب"}, {"id": 11, "arabic": "بِخَمْسَةِ", "translit": "ِẗَsْmَhkِb", "root": "خمس"}, {"id": 12, "arabic": "ءَالَٰفٍ", "translit": "ٍfَٰlāَء", "root": "الف"}, {"id": 13, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 14, "arabic": "ٱلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 15, "arabic": "مُسَوِّمِينَ", "translit": "َnyِmِّwَsُm", "root": "سوم"}], "hasIhya": true}, {"ayah": 126, "text": "وَمَا جَعَلَهُ ٱللَّهُ إِلَّا بُشْرَىٰ لَكُمْ وَلِتَطْمَئِنَّ قُلُوبُكُم بِهِۦۗ وَمَا ٱلنَّصْرُ إِلَّا مِنْ عِندِ ٱللَّهِ ٱلْعَزِيزِ ٱلْحَكِيمِ ", "translation": "And Allāh made it not except as [a sign of] good tidings for you and to reassure your hearts thereby. And victory is not except from Allāh, the Exalted in Might, the Wise -", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "جَعَلَهُ", "translit": "ُhَlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "بُشْرَىٰ", "translit": "ٰàَrْhsُb", "root": "بشر"}, {"id": 6, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 7, "arabic": "وَلِتَطْمَئِنَّ", "translit": "َّnِyʾَmْṭَtِlَw", "root": "طمان"}, {"id": 8, "arabic": "قُلُوبُكُم", "translit": "mُkُbwُlُq", "root": "قلب"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "ٱلنَّصْرُ", "translit": "ُrْṣَّnlٱ", "root": "نصر"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 17, "arabic": "ٱلْحَكِيمِ", "translit": "ِmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": true}, {"ayah": 127, "text": "لِيَقْطَعَ طَرَفًا مِّنَ ٱلَّذِينَ كَفَرُوٓا۟ أَوْ يَكْبِتَهُمْ فَيَنقَلِبُوا۟ خَآئِبِينَ ", "translation": "That He might cut down a section of the disbelievers or suppress them so that they turn back disappointed.", "words": [{"id": 1, "arabic": "لِيَقْطَعَ", "translit": "َʿعَṭْqَyِl", "root": "قطع"}, {"id": 2, "arabic": "طَرَفًا", "translit": "āًfَrَṭ", "root": "طرف"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "يَكْبِتَهُمْ", "translit": "ْmُhَtِbْkَy", "root": "كبت"}, {"id": 8, "arabic": "فَيَنقَلِبُوا۟", "translit": "۟āwُbِlَqnَyَf", "root": "قلب"}, {"id": 9, "arabic": "خَآئِبِينَ", "translit": "َnyِbِyʾٓāَhk", "root": "خيب"}], "hasIhya": false}, {"ayah": 128, "text": "لَيْسَ لَكَ مِنَ ٱلْأَمْرِ شَىْءٌ أَوْ يَتُوبَ عَلَيْهِمْ أَوْ يُعَذِّبَهُمْ فَإِنَّهُمْ ظَٰلِمُونَ ", "translation": "Not for you, [O Muḥammad, but for Allāh], is the decision whether He should [cut them down] or forgive them or punish them, for indeed, they are wrongdoers.", "words": [{"id": 1, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 2, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 5, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "يَتُوبَ", "translit": "َbwُtَy", "root": "توب"}, {"id": 8, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 10, "arabic": "يُعَذِّبَهُمْ", "translit": "ْmُhَbِّhdَʿعُy", "root": "عذب"}, {"id": 11, "arabic": "فَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَf", "root": ""}, {"id": 12, "arabic": "ظَٰلِمُونَ", "translit": "َnwُmِlَٰẓ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 129, "text": "وَلِلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۚ يَغْفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "And to Allāh belongs whatever is in the heavens and whatever is on the earth. He forgives whom He wills and punishes whom He wills. And Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "يَغْفِرُ", "translit": "ُrِfْغَy", "root": "غفر"}, {"id": 9, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 10, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 11, "arabic": "وَيُعَذِّبُ", "translit": "ُbِّhdَʿعُyَw", "root": "عذب"}, {"id": 12, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 13, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 14, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 15, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 16, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 130, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَأْكُلُوا۟ ٱلرِّبَوٰٓا۟ أَضْعَٰفًا مُّضَٰعَفَةًۖ وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ تُفْلِحُونَ ", "translation": "O you who have believed, do not consume usury, doubled and multiplied, but fear Allāh that you may be successful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَأْكُلُوا۟", "translit": "۟āwُlُkْaʾَt", "root": "اكل"}, {"id": 6, "arabic": "ٱلرِّبَوٰٓا۟", "translit": "۟āٰٓwَbِّrlٱ", "root": "ربو"}, {"id": 7, "arabic": "أَضْعَٰفًا", "translit": "āًfَٰʿعْḍَaʾ", "root": "ضعف"}, {"id": 8, "arabic": "مُّضَٰعَفَةً", "translit": "ًẗَfَʿعَٰḍُّm", "root": "ضعف"}, {"id": 9, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 12, "arabic": "تُفْلِحُونَ", "translit": "َnwُḥِlْfُt", "root": "فلح"}], "hasIhya": true}, {"ayah": 131, "text": "وَٱتَّقُوا۟ ٱلنَّارَ ٱلَّتِىٓ أُعِدَّتْ لِلْكَٰفِرِينَ ", "translation": "And fear the Fire, which has been prepared for the disbelievers.", "words": [{"id": 1, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 2, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 3, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 4, "arabic": "أُعِدَّتْ", "translit": "ْtَّdِʿعُaʾ", "root": "عدد"}, {"id": 5, "arabic": "لِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِl", "root": "كفر"}], "hasIhya": true}, {"ayah": 132, "text": "وَأَطِيعُوا۟ ٱللَّهَ وَٱلرَّسُولَ لَعَلَّكُمْ تُرْحَمُونَ ", "translation": "And obey Allāh and the Messenger that you may obtain mercy.", "words": [{"id": 1, "arabic": "وَأَطِيعُوا۟", "translit": "۟āwُʿعyِṭَaʾَw", "root": "طوع"}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "وَٱلرَّسُولَ", "translit": "َlwُsَّrlٱَw", "root": "رسل"}, {"id": 4, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 5, "arabic": "تُرْحَمُونَ", "translit": "َnwُmَḥْrُt", "root": "رحم"}], "hasIhya": false}, {"ayah": 133, "text": "وَسَارِعُوٓا۟ إِلَىٰ مَغْفِرَةٍ مِّن رَّبِّكُمْ وَجَنَّةٍ عَرْضُهَا ٱلسَّمَٰوَٰتُ وَٱلْأَرْضُ أُعِدَّتْ لِلْمُتَّقِينَ ", "translation": "And hasten to forgiveness from your Lord and a garden [i.e., Paradise] as wide as the heavens and earth, prepared for the righteous", "words": [{"id": 1, "arabic": "وَسَارِعُوٓا۟", "translit": "۟āٓwُʿعِrāَsَw", "root": "سرع"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "مَغْفِرَةٍ", "translit": "ٍẗَrِfْغَm", "root": "غفر"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "وَجَنَّةٍ", "translit": "ٍẗَّnَjgَw", "root": "جنن"}, {"id": 7, "arabic": "عَرْضُهَا", "translit": "āَhُḍْrَʿع", "root": "عرض"}, {"id": 8, "arabic": "ٱلسَّمَٰوَٰتُ", "translit": "ُtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "وَٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 10, "arabic": "أُعِدَّتْ", "translit": "ْtَّdِʿعُaʾ", "root": "عدد"}, {"id": 11, "arabic": "لِلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِl", "root": "وقي"}], "hasIhya": true}, {"ayah": 134, "text": "ٱلَّذِينَ يُنفِقُونَ فِى ٱلسَّرَّآءِ وَٱلضَّرَّآءِ وَٱلْكَٰظِمِينَ ٱلْغَيْظَ وَٱلْعَافِينَ عَنِ ٱلنَّاسِۗ وَٱللَّهُ يُحِبُّ ٱلْمُحْسِنِينَ ", "translation": "Who spend [in the cause of Allāh] during ease and hardship and who restrain anger and who pardon the people - and Allāh loves the doers of good;", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّرَّآءِ", "translit": "ِءٓāَّrَّslٱ", "root": "سرر"}, {"id": 5, "arabic": "وَٱلضَّرَّآءِ", "translit": "ِءٓāَّrَّḍlٱَw", "root": "ضرر"}, {"id": 6, "arabic": "وَٱلْكَٰظِمِينَ", "translit": "َnyِmِẓَٰkْlٱَw", "root": "كظم"}, {"id": 7, "arabic": "ٱلْغَيْظَ", "translit": "َẓْyَغْlٱ", "root": "غيظ"}, {"id": 8, "arabic": "وَٱلْعَافِينَ", "translit": "َnyِfāَʿعْlٱَw", "root": "عفو"}, {"id": 9, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 10, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 11, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 12, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 13, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": true}, {"ayah": 135, "text": "وَٱلَّذِينَ إِذَا فَعَلُوا۟ فَٰحِشَةً أَوْ ظَلَمُوٓا۟ أَنفُسَهُمْ ذَكَرُوا۟ ٱللَّهَ فَٱسْتَغْفَرُوا۟ لِذُنُوبِهِمْ وَمَن يَغْفِرُ ٱلذُّنُوبَ إِلَّا ٱللَّهُ وَلَمْ يُصِرُّوا۟ عَلَىٰ مَا فَعَلُوا۟ وَهُمْ يَعْلَمُونَ ", "translation": "And those who, when they commit an immorality or wrong themselves [by transgression], remember Allāh and seek forgiveness for their sins - and who can forgive sins except Allāh? - and [who] do not persist in what they have done while they know.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "فَعَلُوا۟", "translit": "۟āwُlَʿعَf", "root": "فعل"}, {"id": 4, "arabic": "فَٰحِشَةً", "translit": "ًẗَhsِḥَٰf", "root": "فحش"}, {"id": 5, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 6, "arabic": "ظَلَمُوٓا۟", "translit": "۟āٓwُmَlَẓ", "root": "ظلم"}, {"id": 7, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 8, "arabic": "ذَكَرُوا۟", "translit": "۟āwُrَkَhd", "root": "ذكر"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "فَٱسْتَغْفَرُوا۟", "translit": "۟āwُrَfْغَtْsٱَf", "root": "غفر"}, {"id": 11, "arabic": "لِذُنُوبِهِمْ", "translit": "ْmِhِbwُnُhdِl", "root": "ذنب"}, {"id": 12, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 13, "arabic": "يَغْفِرُ", "translit": "ُrِfْغَy", "root": "غفر"}, {"id": 14, "arabic": "ٱلذُّنُوبَ", "translit": "َbwُnُّhdlٱ", "root": "ذنب"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 18, "arabic": "يُصِرُّوا۟", "translit": "۟āwُّrِṣُy", "root": "صرر"}, {"id": 19, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 21, "arabic": "فَعَلُوا۟", "translit": "۟āwُlَʿعَf", "root": "فعل"}, {"id": 22, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 23, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 136, "text": "أُو۟لَٰٓئِكَ جَزَآؤُهُم مَّغْفِرَةٌ مِّن رَّبِّهِمْ وَجَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ وَنِعْمَ أَجْرُ ٱلْعَٰمِلِينَ ", "translation": "Those - their reward is forgiveness from their Lord and gardens beneath which rivers flow [in Paradise], wherein they will abide eternally; and excellent is the reward of the [righteous] workers.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "جَزَآؤُهُم", "translit": "mُhُwʾٓāَzَjg", "root": "جزي"}, {"id": 3, "arabic": "مَّغْفِرَةٌ", "translit": "ٌẗَrِfْغَّm", "root": "غفر"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "وَجَنَّٰتٌ", "translit": "ٌtَّٰnَjgَw", "root": "جنن"}, {"id": 7, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 10, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 11, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 12, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 13, "arabic": "وَنِعْمَ", "translit": "َmْʿعِnَw", "root": "نعم"}, {"id": 14, "arabic": "أَجْرُ", "translit": "ُrْjgَaʾ", "root": "اجر"}, {"id": 15, "arabic": "ٱلْعَٰمِلِينَ", "translit": "َnyِlِmَٰʿعْlٱ", "root": "عمل"}], "hasIhya": false}, {"ayah": 137, "text": "قَدْ خَلَتْ مِن قَبْلِكُمْ سُنَنٌ فَسِيرُوا۟ فِى ٱلْأَرْضِ فَٱنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ ", "translation": "Similar situations [as yours] have passed on before you, so proceed throughout the earth and observe how was the end of those who denied.", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "سُنَنٌ", "translit": "ٌnَnُs", "root": "سنن"}, {"id": 6, "arabic": "فَسِيرُوا۟", "translit": "۟āwُryِsَf", "root": "سير"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "فَٱنظُرُوا۟", "translit": "۟āwُrُẓnٱَf", "root": "نظر"}, {"id": 10, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 11, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 12, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 13, "arabic": "ٱلْمُكَذِّبِينَ", "translit": "َnyِbِّhdَkُmْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 138, "text": "هَٰذَا بَيَانٌ لِّلنَّاسِ وَهُدًى وَمَوْعِظَةٌ لِّلْمُتَّقِينَ ", "translation": "This [Qur’ān] is a clear statement to [all] the people and a guidance and instruction for those conscious of Allāh.", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "بَيَانٌ", "translit": "ٌnāَyَb", "root": "بين"}, {"id": 3, "arabic": "لِّلنَّاسِ", "translit": "ِsāَّnlِّl", "root": "انس"}, {"id": 4, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 5, "arabic": "وَمَوْعِظَةٌ", "translit": "ٌẗَẓِʿعْwَmَw", "root": "وعظ"}, {"id": 6, "arabic": "لِّلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِّl", "root": "وقي"}], "hasIhya": true}, {"ayah": 139, "text": "وَلَا تَهِنُوا۟ وَلَا تَحْزَنُوا۟ وَأَنتُمُ ٱلْأَعْلَوْنَ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "So do not weaken and do not grieve, and you will be superior if you are [true] believers.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَهِنُوا۟", "translit": "۟āwُnِhَt", "root": "وهن"}, {"id": 3, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 4, "arabic": "تَحْزَنُوا۟", "translit": "۟āwُnَzْḥَt", "root": "حزن"}, {"id": 5, "arabic": "وَأَنتُمُ", "translit": "ُmُtnَaʾَw", "root": ""}, {"id": 6, "arabic": "ٱلْأَعْلَوْنَ", "translit": "َnْwَlْʿعَaʾْlٱ", "root": "علو"}, {"id": 7, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 8, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 9, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": true}, {"ayah": 140, "text": "إِن يَمْسَسْكُمْ قَرْحٌ فَقَدْ مَسَّ ٱلْقَوْمَ قَرْحٌ مِّثْلُهُۥۚ وَتِلْكَ ٱلْأَيَّامُ نُدَاوِلُهَا بَيْنَ ٱلنَّاسِ وَلِيَعْلَمَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ وَيَتَّخِذَ مِنكُمْ شُهَدَآءَۗ وَٱللَّهُ لَا يُحِبُّ ٱلظَّٰلِمِينَ ", "translation": "If a wound should touch you - there has already touched the [opposing] people a wound similar to it. And these days [of varying conditions] We alternate among the people so that Allāh may make evident those who believe and [may] take to Himself from among you martyrs - and Allāh does not like the wrongdoers -", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "يَمْسَسْكُمْ", "translit": "ْmُkْsَsْmَy", "root": "مسس"}, {"id": 3, "arabic": "قَرْحٌ", "translit": "ٌḥْrَq", "root": "قرح"}, {"id": 4, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 5, "arabic": "مَسَّ", "translit": "َّsَm", "root": "مسس"}, {"id": 6, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 7, "arabic": "قَرْحٌ", "translit": "ٌḥْrَq", "root": "قرح"}, {"id": 8, "arabic": "مِّثْلُهُۥ", "translit": "ۥُhُlْhtِّm", "root": "مثل"}, {"id": 9, "arabic": "وَتِلْكَ", "translit": "َkْlِtَw", "root": ""}, {"id": 10, "arabic": "ٱلْأَيَّامُ", "translit": "ُmāَّyَaʾْlٱ", "root": "يوم"}, {"id": 11, "arabic": "نُدَاوِلُهَا", "translit": "āَhُlِwāَdُn", "root": "دول"}, {"id": 12, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 13, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 14, "arabic": "وَلِيَعْلَمَ", "translit": "َmَlْʿعَyِlَw", "root": "علم"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 18, "arabic": "وَيَتَّخِذَ", "translit": "َhdِhkَّtَyَw", "root": "اخذ"}, {"id": 19, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 20, "arabic": "شُهَدَآءَ", "translit": "َءٓāَdَhُhs", "root": "شهد"}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 23, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 24, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 141, "text": "وَلِيُمَحِّصَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ وَيَمْحَقَ ٱلْكَٰفِرِينَ ", "translation": "And that Allāh may purify the believers [through trials] and destroy the disbelievers.", "words": [{"id": 1, "arabic": "وَلِيُمَحِّصَ", "translit": "َṣِّḥَmُyِlَw", "root": "محص"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "وَيَمْحَقَ", "translit": "َqَḥْmَyَw", "root": "محق"}, {"id": 6, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 142, "text": "أَمْ حَسِبْتُمْ أَن تَدْخُلُوا۟ ٱلْجَنَّةَ وَلَمَّا يَعْلَمِ ٱللَّهُ ٱلَّذِينَ جَٰهَدُوا۟ مِنكُمْ وَيَعْلَمَ ٱلصَّٰبِرِينَ ", "translation": "Or do you think that you will enter Paradise while Allāh has not yet made evident those of you who fight in His cause and made evident those who are steadfast?", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "حَسِبْتُمْ", "translit": "ْmُtْbِsَḥ", "root": "حسب"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تَدْخُلُوا۟", "translit": "۟āwُlُhkْdَt", "root": "دخل"}, {"id": 5, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 6, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 7, "arabic": "يَعْلَمِ", "translit": "ِmَlْʿعَy", "root": "علم"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "جَٰهَدُوا۟", "translit": "۟āwُdَhَٰjg", "root": "جهد"}, {"id": 11, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 12, "arabic": "وَيَعْلَمَ", "translit": "َmَlْʿعَyَw", "root": "علم"}, {"id": 13, "arabic": "ٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱ", "root": "صبر"}], "hasIhya": false}, {"ayah": 143, "text": "وَلَقَدْ كُنتُمْ تَمَنَّوْنَ ٱلْمَوْتَ مِن قَبْلِ أَن تَلْقَوْهُ فَقَدْ رَأَيْتُمُوهُ وَأَنتُمْ تَنظُرُونَ ", "translation": "And you had certainly wished for death [i.e., martyrdom] before you encountered it, and you have [now] seen it [before you] while you were looking on.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 3, "arabic": "تَمَنَّوْنَ", "translit": "َnْwَّnَmَt", "root": "مني"}, {"id": 4, "arabic": "ٱلْمَوْتَ", "translit": "َtْwَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "تَلْقَوْهُ", "translit": "ُhْwَqْlَt", "root": "لقي"}, {"id": 9, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 10, "arabic": "رَأَيْتُمُوهُ", "translit": "ُhwُmُtْyَaʾَr", "root": "راي"}, {"id": 11, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 12, "arabic": "تَنظُرُونَ", "translit": "َnwُrُẓnَt", "root": "نظر"}], "hasIhya": false}, {"ayah": 144, "text": "وَمَا مُحَمَّدٌ إِلَّا رَسُولٌ قَدْ خَلَتْ مِن قَبْلِهِ ٱلرُّسُلُۚ أَفَإِي۟ن مَّاتَ أَوْ قُتِلَ ٱنقَلَبْتُمْ عَلَىٰٓ أَعْقَٰبِكُمْۚ وَمَن يَنقَلِبْ عَلَىٰ عَقِبَيْهِ فَلَن يَضُرَّ ٱللَّهَ شَيْـًٔاۗ وَسَيَجْزِى ٱللَّهُ ٱلشَّٰكِرِينَ ", "translation": "Muḥammad is not but a messenger. [Other] messengers have passed on before him. So if he was to die or be killed, would you turn back on your heels [to unbelief]? And he who turns back on his heels will never harm Allāh at all; but Allāh will reward the grateful.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "مُحَمَّدٌ", "translit": "ٌdَّmَḥُm", "root": "حمد"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 5, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 6, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "قَبْلِهِ", "translit": "ِhِlْbَq", "root": "قبل"}, {"id": 9, "arabic": "ٱلرُّسُلُ", "translit": "ُlُsُّrlٱ", "root": "رسل"}, {"id": 10, "arabic": "أَفَإِي۟ن", "translit": "n۟yِiʾَfَaʾ", "root": ""}, {"id": 11, "arabic": "مَّاتَ", "translit": "َtāَّm", "root": "موت"}, {"id": 12, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 13, "arabic": "قُتِلَ", "translit": "َlِtُq", "root": "قتل"}, {"id": 14, "arabic": "ٱنقَلَبْتُمْ", "translit": "ْmُtْbَlَqnٱ", "root": "قلب"}, {"id": 15, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 16, "arabic": "أَعْقَٰبِكُمْ", "translit": "ْmُkِbَٰqْʿعَaʾ", "root": "عقب"}, {"id": 17, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 18, "arabic": "يَنقَلِبْ", "translit": "ْbِlَqnَy", "root": "قلب"}, {"id": 19, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 20, "arabic": "عَقِبَيْهِ", "translit": "ِhْyَbِqَʿع", "root": "عقب"}, {"id": 21, "arabic": "فَلَن", "translit": "nَlَf", "root": ""}, {"id": 22, "arabic": "يَضُرَّ", "translit": "َّrُḍَy", "root": "ضرر"}, {"id": 23, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 25, "arabic": "وَسَيَجْزِى", "translit": "àِzْjgَyَsَw", "root": "جزي"}, {"id": 26, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "ٱلشَّٰكِرِينَ", "translit": "َnyِrِkَّٰhslٱ", "root": "شكر"}], "hasIhya": true}, {"ayah": 145, "text": "وَمَا كَانَ لِنَفْسٍ أَن تَمُوتَ إِلَّا بِإِذْنِ ٱللَّهِ كِتَٰبًا مُّؤَجَّلًاۗ وَمَن يُرِدْ ثَوَابَ ٱلدُّنْيَا نُؤْتِهِۦ مِنْهَا وَمَن يُرِدْ ثَوَابَ ٱلْءَاخِرَةِ نُؤْتِهِۦ مِنْهَاۚ وَسَنَجْزِى ٱلشَّٰكِرِينَ ", "translation": "And it is not [possible] for one to die except by permission of Allāh at a decree determined. And whoever desires the reward of this world - We will give him thereof; and whoever desires the reward of the Hereafter - We will give him thereof. And We will reward the grateful.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِنَفْسٍ", "translit": "ٍsْfَnِl", "root": "نفس"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تَمُوتَ", "translit": "َtwُmَt", "root": "موت"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "كِتَٰبًا", "translit": "āًbَٰtِk", "root": "كتب"}, {"id": 10, "arabic": "مُّؤَجَّلًا", "translit": "āًlَّjgَwʾُّm", "root": "اجل"}, {"id": 11, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 12, "arabic": "يُرِدْ", "translit": "ْdِrُy", "root": "رود"}, {"id": 13, "arabic": "ثَوَابَ", "translit": "َbāَwَht", "root": "ثوب"}, {"id": 14, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 15, "arabic": "نُؤْتِهِۦ", "translit": "ۦِhِtْwʾُn", "root": "اتي"}, {"id": 16, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 17, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 18, "arabic": "يُرِدْ", "translit": "ْdِrُy", "root": "رود"}, {"id": 19, "arabic": "ثَوَابَ", "translit": "َbāَwَht", "root": "ثوب"}, {"id": 20, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 21, "arabic": "نُؤْتِهِۦ", "translit": "ۦِhِtْwʾُn", "root": "اتي"}, {"id": 22, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 23, "arabic": "وَسَنَجْزِى", "translit": "àِzْjgَnَsَw", "root": "جزي"}, {"id": 24, "arabic": "ٱلشَّٰكِرِينَ", "translit": "َnyِrِkَّٰhslٱ", "root": "شكر"}], "hasIhya": false}, {"ayah": 146, "text": "وَكَأَيِّن مِّن نَّبِىٍّ قَٰتَلَ مَعَهُۥ رِبِّيُّونَ كَثِيرٌ فَمَا وَهَنُوا۟ لِمَآ أَصَابَهُمْ فِى سَبِيلِ ٱللَّهِ وَمَا ضَعُفُوا۟ وَمَا ٱسْتَكَانُوا۟ۗ وَٱللَّهُ يُحِبُّ ٱلصَّٰبِرِينَ ", "translation": "And how many a prophet [fought in battle and] with him fought many religious scholars. But they never lost assurance due to what afflicted them in the cause of Allāh, nor did they weaken or submit. And Allāh loves the steadfast.", "words": [{"id": 1, "arabic": "وَكَأَيِّن", "translit": "nِّyَaʾَkَw", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 3, "arabic": "نَّبِىٍّ", "translit": "ٍّàِbَّn", "root": "نبا"}, {"id": 4, "arabic": "قَٰتَلَ", "translit": "َlَtَٰq", "root": "قتل"}, {"id": 5, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 6, "arabic": "رِبِّيُّونَ", "translit": "َnwُّyِّbِr", "root": "ربب"}, {"id": 7, "arabic": "كَثِيرٌ", "translit": "ٌryِhtَk", "root": "كثر"}, {"id": 8, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 9, "arabic": "وَهَنُوا۟", "translit": "۟āwُnَhَw", "root": "وهن"}, {"id": 10, "arabic": "لِمَآ", "translit": "ٓāَmِl", "root": ""}, {"id": 11, "arabic": "أَصَابَهُمْ", "translit": "ْmُhَbāَṣَaʾ", "root": "صوب"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 16, "arabic": "ضَعُفُوا۟", "translit": "۟āwُfُʿعَḍ", "root": "ضعف"}, {"id": 17, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 18, "arabic": "ٱسْتَكَانُوا۟", "translit": "۟āwُnāَkَtْsٱ", "root": "كين"}, {"id": 19, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 20, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 21, "arabic": "ٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱ", "root": "صبر"}], "hasIhya": false}, {"ayah": 147, "text": "وَمَا كَانَ قَوْلَهُمْ إِلَّآ أَن قَالُوا۟ رَبَّنَا ٱغْفِرْ لَنَا ذُنُوبَنَا وَإِسْرَافَنَا فِىٓ أَمْرِنَا وَثَبِّتْ أَقْدَامَنَا وَٱنصُرْنَا عَلَى ٱلْقَوْمِ ٱلْكَٰفِرِينَ ", "translation": "And their words were not but that they said, \"Our Lord, forgive us our sins and the excess [committed] in our affairs and plant firmly our feet and give us victory over the disbelieving people.\"", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "قَوْلَهُمْ", "translit": "ْmُhَlْwَq", "root": "قول"}, {"id": 4, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 7, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 8, "arabic": "ٱغْفِرْ", "translit": "ْrِfْغٱ", "root": "غفر"}, {"id": 9, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 10, "arabic": "ذُنُوبَنَا", "translit": "āَnَbwُnُhd", "root": "ذنب"}, {"id": 11, "arabic": "وَإِسْرَافَنَا", "translit": "āَnَfāَrْsِiʾَw", "root": "سرف"}, {"id": 12, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 13, "arabic": "أَمْرِنَا", "translit": "āَnِrْmَaʾ", "root": "امر"}, {"id": 14, "arabic": "وَثَبِّتْ", "translit": "ْtِّbَhtَw", "root": "ثبت"}, {"id": 15, "arabic": "أَقْدَامَنَا", "translit": "āَnَmāَdْqَaʾ", "root": "قدم"}, {"id": 16, "arabic": "وَٱنصُرْنَا", "translit": "āَnْrُṣnٱَw", "root": "نصر"}, {"id": 17, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 18, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 19, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 148, "text": "فَـَٔاتَىٰهُمُ ٱللَّهُ ثَوَابَ ٱلدُّنْيَا وَحُسْنَ ثَوَابِ ٱلْءَاخِرَةِۗ وَٱللَّهُ يُحِبُّ ٱلْمُحْسِنِينَ ", "translation": "So Allāh gave them the reward of this world and the good reward of the Hereafter. And Allāh loves the doers of good.", "words": [{"id": 1, "arabic": "فَـَٔاتَىٰهُمُ", "translit": "ُmُhٰàَtāَٔـَf", "root": "اتي"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ثَوَابَ", "translit": "َbāَwَht", "root": "ثوب"}, {"id": 4, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 5, "arabic": "وَحُسْنَ", "translit": "َnْsُḥَw", "root": "حسن"}, {"id": 6, "arabic": "ثَوَابِ", "translit": "ِbāَwَht", "root": "ثوب"}, {"id": 7, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 9, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 10, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": false}, {"ayah": 149, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِن تُطِيعُوا۟ ٱلَّذِينَ كَفَرُوا۟ يَرُدُّوكُمْ عَلَىٰٓ أَعْقَٰبِكُمْ فَتَنقَلِبُوا۟ خَٰسِرِينَ ", "translation": "O you who have believed, if you obey those who disbelieve, they will turn you back on your heels, and you will [then] become losers.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 5, "arabic": "تُطِيعُوا۟", "translit": "۟āwُʿعyِṭُt", "root": "طوع"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 8, "arabic": "يَرُدُّوكُمْ", "translit": "ْmُkwُّdُrَy", "root": "ردد"}, {"id": 9, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 10, "arabic": "أَعْقَٰبِكُمْ", "translit": "ْmُkِbَٰqْʿعَaʾ", "root": "عقب"}, {"id": 11, "arabic": "فَتَنقَلِبُوا۟", "translit": "۟āwُbِlَqnَtَf", "root": "قلب"}, {"id": 12, "arabic": "خَٰسِرِينَ", "translit": "َnyِrِsَٰhk", "root": "خسر"}], "hasIhya": true}, {"ayah": 150, "text": "بَلِ ٱللَّهُ مَوْلَىٰكُمْۖ وَهُوَ خَيْرُ ٱلنَّٰصِرِينَ ", "translation": "But Allāh is your protector, and He is the best of helpers.", "words": [{"id": 1, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَوْلَىٰكُمْ", "translit": "ْmُkٰàَlْwَm", "root": "ولي"}, {"id": 4, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 5, "arabic": "خَيْرُ", "translit": "ُrْyَhk", "root": "خير"}, {"id": 6, "arabic": "ٱلنَّٰصِرِينَ", "translit": "َnyِrِṣَّٰnlٱ", "root": "نصر"}], "hasIhya": false}, {"ayah": 151, "text": "سَنُلْقِى فِى قُلُوبِ ٱلَّذِينَ كَفَرُوا۟ ٱلرُّعْبَ بِمَآ أَشْرَكُوا۟ بِٱللَّهِ مَا لَمْ يُنَزِّلْ بِهِۦ سُلْطَٰنًاۖ وَمَأْوَىٰهُمُ ٱلنَّارُۚ وَبِئْسَ مَثْوَى ٱلظَّٰلِمِينَ ", "translation": "We will cast terror into the hearts of those who disbelieve for what they have associated with Allāh of which He had not sent down [any] authority.[1] And their refuge will be the Fire, and wretched is the residence of the wrongdoers.", "words": [{"id": 1, "arabic": "سَنُلْقِى", "translit": "àِqْlُnَs", "root": "لقي"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "قُلُوبِ", "translit": "ِbwُlُq", "root": "قلب"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 6, "arabic": "ٱلرُّعْبَ", "translit": "َbْʿعُّrlٱ", "root": "رعب"}, {"id": 7, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 8, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 9, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 12, "arabic": "يُنَزِّلْ", "translit": "ْlِّzَnُy", "root": "نزل"}, {"id": 13, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 14, "arabic": "سُلْطَٰنًا", "translit": "āًnَٰṭْlُs", "root": "سلط"}, {"id": 15, "arabic": "وَمَأْوَىٰهُمُ", "translit": "ُmُhٰàَwْaʾَmَw", "root": "اوي"}, {"id": 16, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 17, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 18, "arabic": "مَثْوَى", "translit": "àَwْhtَm", "root": "ثوي"}, {"id": 19, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 152, "text": "وَلَقَدْ صَدَقَكُمُ ٱللَّهُ وَعْدَهُۥٓ إِذْ تَحُسُّونَهُم بِإِذْنِهِۦۖ حَتَّىٰٓ إِذَا فَشِلْتُمْ وَتَنَٰزَعْتُمْ فِى ٱلْأَمْرِ وَعَصَيْتُم مِّنۢ بَعْدِ مَآ أَرَىٰكُم مَّا تُحِبُّونَۚ مِنكُم مَّن يُرِيدُ ٱلدُّنْيَا وَمِنكُم مَّن يُرِيدُ ٱلْءَاخِرَةَۚ ثُمَّ صَرَفَكُمْ عَنْهُمْ لِيَبْتَلِيَكُمْۖ وَلَقَدْ عَفَا عَنكُمْۗ وَٱللَّهُ ذُو فَضْلٍ عَلَى ٱلْمُؤْمِنِينَ ", "translation": "And Allāh had certainly fulfilled His promise to you when you were killing them [i.e., the enemy] by His permission until [the time] when you lost courage and fell to disputing about the order [given by the Prophet (ﷺ)] and disobeyed after He had shown you that which you love.[1] Among you are some who desire this world, and among you are some who desire the Hereafter. Then He turned you back from them [defeated] that He might test you. And He has already forgiven you, and Allāh is the possessor of bounty for the believers.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "صَدَقَكُمُ", "translit": "ُmُkَqَdَṣ", "root": "صدق"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَعْدَهُۥٓ", "translit": "ٓۥُhَdْʿعَw", "root": "وعد"}, {"id": 5, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 6, "arabic": "تَحُسُّونَهُم", "translit": "mُhَnwُّsُḥَt", "root": "حسس"}, {"id": 7, "arabic": "بِإِذْنِهِۦ", "translit": "ۦِhِnْhdِiʾِb", "root": "اذن"}, {"id": 8, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 9, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 10, "arabic": "فَشِلْتُمْ", "translit": "ْmُtْlِhsَf", "root": "فشل"}, {"id": 11, "arabic": "وَتَنَٰزَعْتُمْ", "translit": "ْmُtْʿعَzَٰnَtَw", "root": "نزع"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 14, "arabic": "وَعَصَيْتُم", "translit": "mُtْyَṣَʿعَw", "root": "عصي"}, {"id": 15, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 16, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 17, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 18, "arabic": "أَرَىٰكُم", "translit": "mُkٰàَrَaʾ", "root": "راي"}, {"id": 19, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 20, "arabic": "تُحِبُّونَ", "translit": "َnwُّbِḥُt", "root": "حبب"}, {"id": 21, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 22, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 23, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 24, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 25, "arabic": "وَمِنكُم", "translit": "mُknِmَw", "root": ""}, {"id": 26, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 27, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 28, "arabic": "ٱلْءَاخِرَةَ", "translit": "َẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 29, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 30, "arabic": "صَرَفَكُمْ", "translit": "ْmُkَfَrَṣ", "root": "صرف"}, {"id": 31, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 32, "arabic": "لِيَبْتَلِيَكُمْ", "translit": "ْmُkَyِlَtْbَyِl", "root": "بلو"}, {"id": 33, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 34, "arabic": "عَفَا", "translit": "āَfَʿع", "root": "عفو"}, {"id": 35, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 36, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 37, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 38, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 39, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 40, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": true}, {"ayah": 153, "text": "إِذْ تُصْعِدُونَ وَلَا تَلْوُۥنَ عَلَىٰٓ أَحَدٍ وَٱلرَّسُولُ يَدْعُوكُمْ فِىٓ أُخْرَىٰكُمْ فَأَثَٰبَكُمْ غَمًّۢا بِغَمٍّ لِّكَيْلَا تَحْزَنُوا۟ عَلَىٰ مَا فَاتَكُمْ وَلَا مَآ أَصَٰبَكُمْۗ وَٱللَّهُ خَبِيرٌۢ بِمَا تَعْمَلُونَ ", "translation": "[Remember] when you [fled and] climbed [the mountain] without looking aside at anyone while the Messenger was calling you from behind. So Allāh repaid you with distress upon distress so you would not grieve for that which had escaped you [of victory and spoils of war] or [for] that which had befallen you [of injury and death]. And Allāh is [fully] Aware of what you do.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "تُصْعِدُونَ", "translit": "َnwُdِʿعْṣُt", "root": "صعد"}, {"id": 3, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 4, "arabic": "تَلْوُۥنَ", "translit": "َnۥُwْlَt", "root": "لوي"}, {"id": 5, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 6, "arabic": "أَحَدٍ", "translit": "ٍdَḥَaʾ", "root": "احد"}, {"id": 7, "arabic": "وَٱلرَّسُولُ", "translit": "ُlwُsَّrlٱَw", "root": "رسل"}, {"id": 8, "arabic": "يَدْعُوكُمْ", "translit": "ْmُkwُʿعْdَy", "root": "دعو"}, {"id": 9, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 10, "arabic": "أُخْرَىٰكُمْ", "translit": "ْmُkٰàَrْhkُaʾ", "root": "اخر"}, {"id": 11, "arabic": "فَأَثَٰبَكُمْ", "translit": "ْmُkَbَٰhtَaʾَf", "root": "ثوب"}, {"id": 12, "arabic": "غَمًّۢا", "translit": "āًّۢmَغ", "root": "غمم"}, {"id": 13, "arabic": "بِغَمٍّ", "translit": "ٍّmَغِb", "root": "غمم"}, {"id": 14, "arabic": "لِّكَيْلَا", "translit": "āَlْyَkِّl", "root": ""}, {"id": 15, "arabic": "تَحْزَنُوا۟", "translit": "۟āwُnَzْḥَt", "root": "حزن"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 18, "arabic": "فَاتَكُمْ", "translit": "ْmُkَtāَf", "root": "فوت"}, {"id": 19, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 20, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 21, "arabic": "أَصَٰبَكُمْ", "translit": "ْmُkَbَٰṣَaʾ", "root": "صوب"}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 24, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 25, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 154, "text": "ثُمَّ أَنزَلَ عَلَيْكُم مِّنۢ بَعْدِ ٱلْغَمِّ أَمَنَةً نُّعَاسًا يَغْشَىٰ طَآئِفَةً مِّنكُمْۖ وَطَآئِفَةٌ قَدْ أَهَمَّتْهُمْ أَنفُسُهُمْ يَظُنُّونَ بِٱللَّهِ غَيْرَ ٱلْحَقِّ ظَنَّ ٱلْجَٰهِلِيَّةِۖ يَقُولُونَ هَل لَّنَا مِنَ ٱلْأَمْرِ مِن شَىْءٍۗ قُلْ إِنَّ ٱلْأَمْرَ كُلَّهُۥ لِلَّهِۗ يُخْفُونَ فِىٓ أَنفُسِهِم مَّا لَا يُبْدُونَ لَكَۖ يَقُولُونَ لَوْ كَانَ لَنَا مِنَ ٱلْأَمْرِ شَىْءٌ مَّا قُتِلْنَا هَٰهُنَاۗ قُل لَّوْ كُنتُمْ فِى بُيُوتِكُمْ لَبَرَزَ ٱلَّذِينَ كُتِبَ عَلَيْهِمُ ٱلْقَتْلُ إِلَىٰ مَضَاجِعِهِمْۖ وَلِيَبْتَلِىَ ٱللَّهُ مَا فِى صُدُورِكُمْ وَلِيُمَحِّصَ مَا فِى قُلُوبِكُمْۗ وَٱللَّهُ عَلِيمٌۢ بِذَاتِ ٱلصُّدُورِ ", "translation": "Then after distress, He sent down upon you security [in the form of] drowsiness, overcoming a faction of you, while another faction worried about themselves, thinking of Allāh other than the truth - the thought of ignorance, saying, \"Is there anything for us [to have done] in this matter?\" Say, \"Indeed, the matter belongs completely to Allāh.\" They conceal within themselves what they will not reveal to you. They say, \"If there was anything we could have done in the matter, we [i.e., some of us] would not have been killed right here.\" Say, \"Even if you had been inside your houses, those decreed to be killed would have come out to their death beds.\" [It was] so that Allāh might test what is in your breasts and purify what is in your hearts. And Allāh is Knowing of that within the breasts.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "ٱلْغَمِّ", "translit": "ِّmَغْlٱ", "root": "غمم"}, {"id": 7, "arabic": "أَمَنَةً", "translit": "ًẗَnَmَaʾ", "root": "امن"}, {"id": 8, "arabic": "نُّعَاسًا", "translit": "āًsāَʿعُّn", "root": "نعس"}, {"id": 9, "arabic": "يَغْشَىٰ", "translit": "ٰàَhsْغَy", "root": "غشو"}, {"id": 10, "arabic": "طَآئِفَةً", "translit": "ًẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 11, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 12, "arabic": "وَطَآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَṭَw", "root": "طوف"}, {"id": 13, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 14, "arabic": "أَهَمَّتْهُمْ", "translit": "ْmُhْtَّmَhَaʾ", "root": "همم"}, {"id": 15, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 16, "arabic": "يَظُنُّونَ", "translit": "َnwُّnُẓَy", "root": "ظنن"}, {"id": 17, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 18, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 19, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 20, "arabic": "ظَنَّ", "translit": "َّnَẓ", "root": "ظنن"}, {"id": 21, "arabic": "ٱلْجَٰهِلِيَّةِ", "translit": "ِẗَّyِlِhَٰjgْlٱ", "root": "جهل"}, {"id": 22, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 23, "arabic": "هَل", "translit": "lَh", "root": ""}, {"id": 24, "arabic": "لَّنَا", "translit": "āَnَّl", "root": ""}, {"id": 25, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 26, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 27, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 28, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 29, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 30, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 31, "arabic": "ٱلْأَمْرَ", "translit": "َrْmَaʾْlٱ", "root": "امر"}, {"id": 32, "arabic": "كُلَّهُۥ", "translit": "ۥُhَّlُk", "root": "كلل"}, {"id": 33, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 34, "arabic": "يُخْفُونَ", "translit": "َnwُfْhkُy", "root": "خفي"}, {"id": 35, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 36, "arabic": "أَنفُسِهِم", "translit": "mِhِsُfnَaʾ", "root": "نفس"}, {"id": 37, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 38, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 39, "arabic": "يُبْدُونَ", "translit": "َnwُdْbُy", "root": "بدو"}, {"id": 40, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 41, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 42, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 43, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 44, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 45, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 46, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 47, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 48, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 49, "arabic": "قُتِلْنَا", "translit": "āَnْlِtُq", "root": "قتل"}, {"id": 50, "arabic": "هَٰهُنَا", "translit": "āَnُhَٰh", "root": ""}, {"id": 51, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 52, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 53, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 54, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 55, "arabic": "بُيُوتِكُمْ", "translit": "ْmُkِtwُyُb", "root": "بيت"}, {"id": 56, "arabic": "لَبَرَزَ", "translit": "َzَrَbَl", "root": "برز"}, {"id": 57, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 58, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 59, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 60, "arabic": "ٱلْقَتْلُ", "translit": "ُlْtَqْlٱ", "root": "قتل"}, {"id": 61, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 62, "arabic": "مَضَاجِعِهِمْ", "translit": "ْmِhِʿعِjgāَḍَm", "root": "ضجع"}, {"id": 63, "arabic": "وَلِيَبْتَلِىَ", "translit": "َàِlَtْbَyِlَw", "root": "بلو"}, {"id": 64, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 65, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 66, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 67, "arabic": "صُدُورِكُمْ", "translit": "ْmُkِrwُdُṣ", "root": "صدر"}, {"id": 68, "arabic": "وَلِيُمَحِّصَ", "translit": "َṣِّḥَmُyِlَw", "root": "محص"}, {"id": 69, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 70, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 71, "arabic": "قُلُوبِكُمْ", "translit": "ْmُkِbwُlُq", "root": "قلب"}, {"id": 72, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 73, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 74, "arabic": "بِذَاتِ", "translit": "ِtāَhdِb", "root": ""}, {"id": 75, "arabic": "ٱلصُّدُورِ", "translit": "ِrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": false}, {"ayah": 155, "text": "إِنَّ ٱلَّذِينَ تَوَلَّوْا۟ مِنكُمْ يَوْمَ ٱلْتَقَى ٱلْجَمْعَانِ إِنَّمَا ٱسْتَزَلَّهُمُ ٱلشَّيْطَٰنُ بِبَعْضِ مَا كَسَبُوا۟ۖ وَلَقَدْ عَفَا ٱللَّهُ عَنْهُمْۗ إِنَّ ٱللَّهَ غَفُورٌ حَلِيمٌ ", "translation": "Indeed, those of you who turned back on the day the two armies met [at Uḥud] - it was Satan who caused them to slip because of some [blame] they had earned. But Allāh has already forgiven them. Indeed, Allāh is Forgiving and Forbearing.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 4, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 5, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 6, "arabic": "ٱلْتَقَى", "translit": "àَqَtْlٱ", "root": "لقي"}, {"id": 7, "arabic": "ٱلْجَمْعَانِ", "translit": "ِnāَʿعْmَjgْlٱ", "root": "جمع"}, {"id": 8, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 9, "arabic": "ٱسْتَزَلَّهُمُ", "translit": "ُmُhَّlَzَtْsٱ", "root": "زلل"}, {"id": 10, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 11, "arabic": "بِبَعْضِ", "translit": "ِḍْʿعَbِb", "root": "بعض"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 14, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 15, "arabic": "عَفَا", "translit": "āَfَʿع", "root": "عفو"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 21, "arabic": "حَلِيمٌ", "translit": "ٌmyِlَḥ", "root": "حلم"}], "hasIhya": false}, {"ayah": 156, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَكُونُوا۟ كَٱلَّذِينَ كَفَرُوا۟ وَقَالُوا۟ لِإِخْوَٰنِهِمْ إِذَا ضَرَبُوا۟ فِى ٱلْأَرْضِ أَوْ كَانُوا۟ غُزًّى لَّوْ كَانُوا۟ عِندَنَا مَا مَاتُوا۟ وَمَا قُتِلُوا۟ لِيَجْعَلَ ٱللَّهُ ذَٰلِكَ حَسْرَةً فِى قُلُوبِهِمْۗ وَٱللَّهُ يُحْىِۦ وَيُمِيتُۗ وَٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "O you who have believed, do not be like those who disbelieved and said about their brothers when they traveled through the land or went out to fight, \"If they had been with us, they would not have died or have been killed,\" so Allāh makes that [misconception] a regret within their hearts. And it is Allāh who gives life and causes death, and Allāh is Seeing of what you do.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 6, "arabic": "كَٱلَّذِينَ", "translit": "َnyِhdَّlٱَk", "root": ""}, {"id": 7, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 8, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 9, "arabic": "لِإِخْوَٰنِهِمْ", "translit": "ْmِhِnَٰwْhkِiʾِl", "root": "اخو"}, {"id": 10, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 11, "arabic": "ضَرَبُوا۟", "translit": "۟āwُbَrَḍ", "root": "ضرب"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 14, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 15, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 16, "arabic": "غُزًّى", "translit": "àًّzُغ", "root": "غزو"}, {"id": 17, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 18, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 19, "arabic": "عِندَنَا", "translit": "āَnَdnِʿع", "root": "عند"}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 21, "arabic": "مَاتُوا۟", "translit": "۟āwُtāَm", "root": "موت"}, {"id": 22, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 23, "arabic": "قُتِلُوا۟", "translit": "۟āwُlِtُq", "root": "قتل"}, {"id": 24, "arabic": "لِيَجْعَلَ", "translit": "َlَʿعْjgَyِl", "root": "جعل"}, {"id": 25, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 27, "arabic": "حَسْرَةً", "translit": "ًẗَrْsَḥ", "root": "حسر"}, {"id": 28, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 29, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 30, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 31, "arabic": "يُحْىِۦ", "translit": "ۦِàْḥُy", "root": "حيي"}, {"id": 32, "arabic": "وَيُمِيتُ", "translit": "ُtyِmُyَw", "root": "موت"}, {"id": 33, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 34, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 35, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 36, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 157, "text": "وَلَئِن قُتِلْتُمْ فِى سَبِيلِ ٱللَّهِ أَوْ مُتُّمْ لَمَغْفِرَةٌ مِّنَ ٱللَّهِ وَرَحْمَةٌ خَيْرٌ مِّمَّا يَجْمَعُونَ ", "translation": "And if you are killed in the cause of Allāh or die - then forgiveness from Allāh and mercy are better than whatever they accumulate [in this world].", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 2, "arabic": "قُتِلْتُمْ", "translit": "ْmُtْlِtُq", "root": "قتل"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "مُتُّمْ", "translit": "ْmُّtُm", "root": "موت"}, {"id": 8, "arabic": "لَمَغْفِرَةٌ", "translit": "ٌẗَrِfْغَmَl", "root": "غفر"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 12, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 13, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 14, "arabic": "يَجْمَعُونَ", "translit": "َnwُʿعَmْjgَy", "root": "جمع"}], "hasIhya": false}, {"ayah": 158, "text": "وَلَئِن مُّتُّمْ أَوْ قُتِلْتُمْ لَإِلَى ٱللَّهِ تُحْشَرُونَ ", "translation": "And whether you die or are killed, unto Allāh you will be gathered.", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 2, "arabic": "مُّتُّمْ", "translit": "ْmُّtُّm", "root": "موت"}, {"id": 3, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 4, "arabic": "قُتِلْتُمْ", "translit": "ْmُtْlِtُq", "root": "قتل"}, {"id": 5, "arabic": "لَإِلَى", "translit": "àَlِiʾَl", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "تُحْشَرُونَ", "translit": "َnwُrَhsْḥُt", "root": "حشر"}], "hasIhya": false}, {"ayah": 159, "text": "فَبِمَا رَحْمَةٍ مِّنَ ٱللَّهِ لِنتَ لَهُمْۖ وَلَوْ كُنتَ فَظًّا غَلِيظَ ٱلْقَلْبِ لَٱنفَضُّوا۟ مِنْ حَوْلِكَۖ فَٱعْفُ عَنْهُمْ وَٱسْتَغْفِرْ لَهُمْ وَشَاوِرْهُمْ فِى ٱلْأَمْرِۖ فَإِذَا عَزَمْتَ فَتَوَكَّلْ عَلَى ٱللَّهِۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُتَوَكِّلِينَ ", "translation": "So by mercy from Allāh, [O Muḥammad], you were lenient with them. And if you had been rude [in speech] and harsh in heart, they would have disbanded from about you. So pardon them and ask forgiveness for them and consult them in the matter. And when you have decided, then rely upon Allāh. Indeed, Allāh loves those who rely [upon Him].", "words": [{"id": 1, "arabic": "فَبِمَا", "translit": "āَmِbَf", "root": ""}, {"id": 2, "arabic": "رَحْمَةٍ", "translit": "ٍẗَmْḥَr", "root": "رحم"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لِنتَ", "translit": "َtnِl", "root": "لين"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 8, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 9, "arabic": "فَظًّا", "translit": "āًّẓَf", "root": "فظظ"}, {"id": 10, "arabic": "غَلِيظَ", "translit": "َẓyِlَغ", "root": "غلظ"}, {"id": 11, "arabic": "ٱلْقَلْبِ", "translit": "ِbْlَqْlٱ", "root": "قلب"}, {"id": 12, "arabic": "لَٱنفَضُّوا۟", "translit": "۟āwُّḍَfnٱَl", "root": "فضض"}, {"id": 13, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 14, "arabic": "حَوْلِكَ", "translit": "َkِlْwَḥ", "root": "حول"}, {"id": 15, "arabic": "فَٱعْفُ", "translit": "ُfْʿعٱَf", "root": "عفو"}, {"id": 16, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 17, "arabic": "وَٱسْتَغْفِرْ", "translit": "ْrِfْغَtْsٱَw", "root": "غفر"}, {"id": 18, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 19, "arabic": "وَشَاوِرْهُمْ", "translit": "ْmُhْrِwāَhsَw", "root": "شور"}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 21, "arabic": "ٱلْأَمْرِ", "translit": "ِrْmَaʾْlٱ", "root": "امر"}, {"id": 22, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 23, "arabic": "عَزَمْتَ", "translit": "َtْmَzَʿع", "root": "عزم"}, {"id": 24, "arabic": "فَتَوَكَّلْ", "translit": "ْlَّkَwَtَf", "root": "وكل"}, {"id": 25, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 26, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 28, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 30, "arabic": "ٱلْمُتَوَكِّلِينَ", "translit": "َnyِlِّkَwَtُmْlٱ", "root": "وكل"}], "hasIhya": true}, {"ayah": 160, "text": "إِن يَنصُرْكُمُ ٱللَّهُ فَلَا غَالِبَ لَكُمْۖ وَإِن يَخْذُلْكُمْ فَمَن ذَا ٱلَّذِى يَنصُرُكُم مِّنۢ بَعْدِهِۦۗ وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ ٱلْمُؤْمِنُونَ ", "translation": "If Allāh should aid you, no one can overcome you; but if He should forsake you, who is there that can aid you after Him? And upon Allāh let the believers rely.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "يَنصُرْكُمُ", "translit": "ُmُkْrُṣnَy", "root": "نصر"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "غَالِبَ", "translit": "َbِlāَغ", "root": "غلب"}, {"id": 6, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 7, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 8, "arabic": "يَخْذُلْكُمْ", "translit": "ْmُkْlُhdْhkَy", "root": "خذل"}, {"id": 9, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 10, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 11, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "يَنصُرُكُم", "translit": "mُkُrُṣnَy", "root": "نصر"}, {"id": 13, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 14, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "فَلْيَتَوَكَّلِ", "translit": "ِlَّkَwَtَyْlَf", "root": "وكل"}, {"id": 18, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": true}, {"ayah": 161, "text": "وَمَا كَانَ لِنَبِىٍّ أَن يَغُلَّۚ وَمَن يَغْلُلْ يَأْتِ بِمَا غَلَّ يَوْمَ ٱلْقِيَٰمَةِۚ ثُمَّ تُوَفَّىٰ كُلُّ نَفْسٍ مَّا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ ", "translation": "It is not [attributable] to any prophet that he would act unfaithfully [in regard to war booty]. And whoever betrays, [taking unlawfully], will come with what he took on the Day of Resurrection. Then will every soul be [fully] compensated for what it earned, and they will not be wronged.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِنَبِىٍّ", "translit": "ٍّàِbَnِl", "root": "نبا"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَغُلَّ", "translit": "َّlُغَy", "root": "غلل"}, {"id": 6, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 7, "arabic": "يَغْلُلْ", "translit": "ْlُlْغَy", "root": "غلل"}, {"id": 8, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "غَلَّ", "translit": "َّlَغ", "root": "غلل"}, {"id": 11, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 12, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 13, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 14, "arabic": "تُوَفَّىٰ", "translit": "ٰàَّfَwُt", "root": "وفي"}, {"id": 15, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 16, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 17, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 18, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 19, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 20, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 21, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": true}, {"ayah": 162, "text": "أَفَمَنِ ٱتَّبَعَ رِضْوَٰنَ ٱللَّهِ كَمَنۢ بَآءَ بِسَخَطٍ مِّنَ ٱللَّهِ وَمَأْوَىٰهُ جَهَنَّمُۚ وَبِئْسَ ٱلْمَصِيرُ ", "translation": "So is one who pursues the pleasure of Allāh like one who brings upon himself the anger of Allāh and whose refuge is Hell? And wretched is the destination.", "words": [{"id": 1, "arabic": "أَفَمَنِ", "translit": "ِnَmَfَaʾ", "root": ""}, {"id": 2, "arabic": "ٱتَّبَعَ", "translit": "َʿعَbَّtٱ", "root": "تبع"}, {"id": 3, "arabic": "رِضْوَٰنَ", "translit": "َnَٰwْḍِr", "root": "رضو"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "كَمَنۢ", "translit": "ۢnَmَk", "root": ""}, {"id": 6, "arabic": "بَآءَ", "translit": "َءٓāَb", "root": "بوا"}, {"id": 7, "arabic": "بِسَخَطٍ", "translit": "ٍṭَhkَsِb", "root": "سخط"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَمَأْوَىٰهُ", "translit": "ُhٰàَwْaʾَmَw", "root": "اوي"}, {"id": 11, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 12, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 13, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": false}, {"ayah": 163, "text": "هُمْ دَرَجَٰتٌ عِندَ ٱللَّهِۗ وَٱللَّهُ بَصِيرٌۢ بِمَا يَعْمَلُونَ ", "translation": "They are [varying] degrees in the sight of Allāh, and Allāh is Seeing of whatever they do.", "words": [{"id": 1, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 2, "arabic": "دَرَجَٰتٌ", "translit": "ٌtَٰjgَrَd", "root": "درج"}, {"id": 3, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 6, "arabic": "بَصِيرٌۢ", "translit": "ٌۢryِṣَb", "root": "بصر"}, {"id": 7, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 8, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": true}, {"ayah": 164, "text": "لَقَدْ مَنَّ ٱللَّهُ عَلَى ٱلْمُؤْمِنِينَ إِذْ بَعَثَ فِيهِمْ رَسُولًا مِّنْ أَنفُسِهِمْ يَتْلُوا۟ عَلَيْهِمْ ءَايَٰتِهِۦ وَيُزَكِّيهِمْ وَيُعَلِّمُهُمُ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ وَإِن كَانُوا۟ مِن قَبْلُ لَفِى ضَلَٰلٍ مُّبِينٍ ", "translation": "Certainly did Allāh confer [great] favor upon the believers when He sent among them a Messenger from themselves, reciting to them His verses and purifying them and teaching them the Book [i.e., the Qur’ān] and wisdom,[1] although they had been before in manifest error.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "مَنَّ", "translit": "َّnَm", "root": "منن"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 6, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 7, "arabic": "بَعَثَ", "translit": "َhtَʿعَb", "root": "بعث"}, {"id": 8, "arabic": "فِيهِمْ", "translit": "ْmِhyِf", "root": ""}, {"id": 9, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 10, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 11, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 12, "arabic": "يَتْلُوا۟", "translit": "۟āwُlْtَy", "root": "تلو"}, {"id": 13, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 15, "arabic": "وَيُزَكِّيهِمْ", "translit": "ْmِhyِّkَzُyَw", "root": "زكو"}, {"id": 16, "arabic": "وَيُعَلِّمُهُمُ", "translit": "ُmُhُmِّlَʿعُyَw", "root": "علم"}, {"id": 17, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 18, "arabic": "وَٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱَw", "root": "حكم"}, {"id": 19, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 20, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 21, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 22, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 23, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 24, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 25, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 165, "text": "أَوَلَمَّآ أَصَٰبَتْكُم مُّصِيبَةٌ قَدْ أَصَبْتُم مِّثْلَيْهَا قُلْتُمْ أَنَّىٰ هَٰذَاۖ قُلْ هُوَ مِنْ عِندِ أَنفُسِكُمْۗ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Why [is it that] when a [single] disaster struck you [on the day of Uḥud], although you had struck [the enemy in the battle of Badr] with one twice as great, you said, \"From where is this?\" Say, \"It is from yourselves [i.e., due to your sin].\" Indeed, Allāh is over all things competent.", "words": [{"id": 1, "arabic": "أَوَلَمَّآ", "translit": "ٓāَّmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "أَصَٰبَتْكُم", "translit": "mُkْtَbَٰṣَaʾ", "root": "صوب"}, {"id": 3, "arabic": "مُّصِيبَةٌ", "translit": "ٌẗَbyِṣُّm", "root": "صوب"}, {"id": 4, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 5, "arabic": "أَصَبْتُم", "translit": "mُtْbَṣَaʾ", "root": "صوب"}, {"id": 6, "arabic": "مِّثْلَيْهَا", "translit": "āَhْyَlْhtِّm", "root": "مثل"}, {"id": 7, "arabic": "قُلْتُمْ", "translit": "ْmُtْlُq", "root": "قول"}, {"id": 8, "arabic": "أَنَّىٰ", "translit": "ٰàَّnَaʾ", "root": ""}, {"id": 9, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 10, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 11, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 12, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 13, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 14, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 15, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 18, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 19, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 20, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 166, "text": "وَمَآ أَصَٰبَكُمْ يَوْمَ ٱلْتَقَى ٱلْجَمْعَانِ فَبِإِذْنِ ٱللَّهِ وَلِيَعْلَمَ ٱلْمُؤْمِنِينَ ", "translation": "And what struck you on the day the two armies met [at Uḥud] was by permission of Allāh that He might make evident the [true] believers", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَصَٰبَكُمْ", "translit": "ْmُkَbَٰṣَaʾ", "root": "صوب"}, {"id": 3, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 4, "arabic": "ٱلْتَقَى", "translit": "àَqَtْlٱ", "root": "لقي"}, {"id": 5, "arabic": "ٱلْجَمْعَانِ", "translit": "ِnāَʿعْmَjgْlٱ", "root": "جمع"}, {"id": 6, "arabic": "فَبِإِذْنِ", "translit": "ِnْhdِiʾِbَf", "root": "اذن"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَلِيَعْلَمَ", "translit": "َmَlْʿعَyِlَw", "root": "علم"}, {"id": 9, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 167, "text": "وَلِيَعْلَمَ ٱلَّذِينَ نَافَقُوا۟ۚ وَقِيلَ لَهُمْ تَعَالَوْا۟ قَٰتِلُوا۟ فِى سَبِيلِ ٱللَّهِ أَوِ ٱدْفَعُوا۟ۖ قَالُوا۟ لَوْ نَعْلَمُ قِتَالًا لَّٱتَّبَعْنَٰكُمْۗ هُمْ لِلْكُفْرِ يَوْمَئِذٍ أَقْرَبُ مِنْهُمْ لِلْإِيمَٰنِۚ يَقُولُونَ بِأَفْوَٰهِهِم مَّا لَيْسَ فِى قُلُوبِهِمْۗ وَٱللَّهُ أَعْلَمُ بِمَا يَكْتُمُونَ ", "translation": "And that He might make evident those who are hypocrites. For it was said to them, \"Come, fight in the way of Allāh or [at least] defend.\" They said, \"If we had known [there would be] battle, we would have followed you.\" They were nearer to disbelief that day than to faith, saying with their mouths what was not in their hearts. And Allāh is most knowing of what they conceal -", "words": [{"id": 1, "arabic": "وَلِيَعْلَمَ", "translit": "َmَlْʿعَyِlَw", "root": "علم"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "نَافَقُوا۟", "translit": "۟āwُqَfāَn", "root": "نفق"}, {"id": 4, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 5, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 6, "arabic": "تَعَالَوْا۟", "translit": "۟āْwَlāَʿعَt", "root": "علو"}, {"id": 7, "arabic": "قَٰتِلُوا۟", "translit": "۟āwُlِtَٰq", "root": "قتل"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 12, "arabic": "ٱدْفَعُوا۟", "translit": "۟āwُʿعَfْdٱ", "root": "دفع"}, {"id": 13, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 14, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 15, "arabic": "نَعْلَمُ", "translit": "ُmَlْʿعَn", "root": "علم"}, {"id": 16, "arabic": "قِتَالًا", "translit": "āًlāَtِq", "root": "قتل"}, {"id": 17, "arabic": "لَّٱتَّبَعْنَٰكُمْ", "translit": "ْmُkَٰnْʿعَbَّtٱَّl", "root": "تبع"}, {"id": 18, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 19, "arabic": "لِلْكُفْرِ", "translit": "ِrْfُkْlِl", "root": "كفر"}, {"id": 20, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 21, "arabic": "أَقْرَبُ", "translit": "ُbَrْqَaʾ", "root": "قرب"}, {"id": 22, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 23, "arabic": "لِلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlِl", "root": "امن"}, {"id": 24, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 25, "arabic": "بِأَفْوَٰهِهِم", "translit": "mِhِhَٰwْfَaʾِb", "root": "فوه"}, {"id": 26, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 27, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 28, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 29, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 30, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 31, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 32, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 33, "arabic": "يَكْتُمُونَ", "translit": "َnwُmُtْkَy", "root": "كتم"}], "hasIhya": false}, {"ayah": 168, "text": "ٱلَّذِينَ قَالُوا۟ لِإِخْوَٰنِهِمْ وَقَعَدُوا۟ لَوْ أَطَاعُونَا مَا قُتِلُوا۟ۗ قُلْ فَٱدْرَءُوا۟ عَنْ أَنفُسِكُمُ ٱلْمَوْتَ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "Those who said about their brothers while sitting [at home], \"If they had obeyed us, they would not have been killed.\" Say, \"Then prevent death from yourselves, if you should be truthful.\"", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 3, "arabic": "لِإِخْوَٰنِهِمْ", "translit": "ْmِhِnَٰwْhkِiʾِl", "root": "اخو"}, {"id": 4, "arabic": "وَقَعَدُوا۟", "translit": "۟āwُdَʿعَqَw", "root": "قعد"}, {"id": 5, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 6, "arabic": "أَطَاعُونَا", "translit": "āَnwُʿعāَṭَaʾ", "root": "طوع"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "قُتِلُوا۟", "translit": "۟āwُlِtُq", "root": "قتل"}, {"id": 9, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 10, "arabic": "فَٱدْرَءُوا۟", "translit": "۟āwُءَrْdٱَf", "root": "درا"}, {"id": 11, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 12, "arabic": "أَنفُسِكُمُ", "translit": "ُmُkِsُfnَaʾ", "root": "نفس"}, {"id": 13, "arabic": "ٱلْمَوْتَ", "translit": "َtْwَmْlٱ", "root": "موت"}, {"id": 14, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 15, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 16, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 169, "text": "وَلَا تَحْسَبَنَّ ٱلَّذِينَ قُتِلُوا۟ فِى سَبِيلِ ٱللَّهِ أَمْوَٰتًۢاۚ بَلْ أَحْيَآءٌ عِندَ رَبِّهِمْ يُرْزَقُونَ ", "translation": "And never think of those who have been killed in the cause of Allāh as dead. Rather, they are alive with their Lord, receiving provision,", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَحْسَبَنَّ", "translit": "َّnَbَsْḥَt", "root": "حسب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "قُتِلُوا۟", "translit": "۟āwُlِtُq", "root": "قتل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "أَمْوَٰتًۢا", "translit": "āًۢtَٰwْmَaʾ", "root": "موت"}, {"id": 9, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 10, "arabic": "أَحْيَآءٌ", "translit": "ٌءٓāَyْḥَaʾ", "root": "حيي"}, {"id": 11, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 12, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 13, "arabic": "يُرْزَقُونَ", "translit": "َnwُqَzْrُy", "root": "رزق"}], "hasIhya": true}, {"ayah": 170, "text": "فَرِحِينَ بِمَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦ وَيَسْتَبْشِرُونَ بِٱلَّذِينَ لَمْ يَلْحَقُوا۟ بِهِم مِّنْ خَلْفِهِمْ أَلَّا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "Rejoicing in what Allāh has bestowed upon them of His bounty, and they receive good tidings about those [to be martyred] after them who have not yet joined them - that there will be no fear concerning them, nor will they grieve.", "words": [{"id": 1, "arabic": "فَرِحِينَ", "translit": "َnyِḥِrَf", "root": "فرح"}, {"id": 2, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 3, "arabic": "ءَاتَىٰهُمُ", "translit": "ُmُhٰàَtāَء", "root": "اتي"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 7, "arabic": "وَيَسْتَبْشِرُونَ", "translit": "َnwُrِhsْbَtْsَyَw", "root": "بشر"}, {"id": 8, "arabic": "بِٱلَّذِينَ", "translit": "َnyِhdَّlٱِb", "root": ""}, {"id": 9, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 10, "arabic": "يَلْحَقُوا۟", "translit": "۟āwُqَḥْlَy", "root": "لحق"}, {"id": 11, "arabic": "بِهِم", "translit": "mِhِb", "root": ""}, {"id": 12, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 13, "arabic": "خَلْفِهِمْ", "translit": "ْmِhِfْlَhk", "root": "خلف"}, {"id": 14, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 15, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 16, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 19, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": false}, {"ayah": 171, "text": "يَسْتَبْشِرُونَ بِنِعْمَةٍ مِّنَ ٱللَّهِ وَفَضْلٍ وَأَنَّ ٱللَّهَ لَا يُضِيعُ أَجْرَ ٱلْمُؤْمِنِينَ ", "translation": "They receive good tidings of favor from Allāh and bounty and [of the fact] that Allāh does not allow the reward of believers to be lost -", "words": [{"id": 1, "arabic": "يَسْتَبْشِرُونَ", "translit": "َnwُrِhsْbَtْsَy", "root": "بشر"}, {"id": 2, "arabic": "بِنِعْمَةٍ", "translit": "ٍẗَmْʿعِnِb", "root": "نعم"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَفَضْلٍ", "translit": "ٍlْḍَfَw", "root": "فضل"}, {"id": 6, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يُضِيعُ", "translit": "ُʿعyِḍُy", "root": "ضيع"}, {"id": 10, "arabic": "أَجْرَ", "translit": "َrْjgَaʾ", "root": "اجر"}, {"id": 11, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 172, "text": "ٱلَّذِينَ ٱسْتَجَابُوا۟ لِلَّهِ وَٱلرَّسُولِ مِنۢ بَعْدِ مَآ أَصَابَهُمُ ٱلْقَرْحُۚ لِلَّذِينَ أَحْسَنُوا۟ مِنْهُمْ وَٱتَّقَوْا۟ أَجْرٌ عَظِيمٌ ", "translation": "Those [believers] who responded to Allāh and the Messenger after injury had struck them. For those who did good among them and feared Allāh is a great reward -", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ٱسْتَجَابُوا۟", "translit": "۟āwُbāَjgَtْsٱ", "root": "جوب"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "وَٱلرَّسُولِ", "translit": "ِlwُsَّrlٱَw", "root": "رسل"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 8, "arabic": "أَصَابَهُمُ", "translit": "ُmُhَbāَṣَaʾ", "root": "صوب"}, {"id": 9, "arabic": "ٱلْقَرْحُ", "translit": "ُḥْrَqْlٱ", "root": "قرح"}, {"id": 10, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 11, "arabic": "أَحْسَنُوا۟", "translit": "۟āwُnَsْḥَaʾ", "root": "حسن"}, {"id": 12, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 13, "arabic": "وَٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱَw", "root": "وقي"}, {"id": 14, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 15, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 173, "text": "ٱلَّذِينَ قَالَ لَهُمُ ٱلنَّاسُ إِنَّ ٱلنَّاسَ قَدْ جَمَعُوا۟ لَكُمْ فَٱخْشَوْهُمْ فَزَادَهُمْ إِيمَٰنًا وَقَالُوا۟ حَسْبُنَا ٱللَّهُ وَنِعْمَ ٱلْوَكِيلُ ", "translation": "Those to whom people [i.e., hypocrites] said, \"Indeed, the people have gathered against you, so fear them.\" But it [merely] increased them in faith, and they said, \"Sufficient for us is Allāh, and [He is] the best Disposer of affairs.\"[1]", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 4, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 8, "arabic": "جَمَعُوا۟", "translit": "۟āwُʿعَmَjg", "root": "جمع"}, {"id": 9, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 10, "arabic": "فَٱخْشَوْهُمْ", "translit": "ْmُhْwَhsْhkٱَf", "root": "خشي"}, {"id": 11, "arabic": "فَزَادَهُمْ", "translit": "ْmُhَdāَzَf", "root": "زيد"}, {"id": 12, "arabic": "إِيمَٰنًا", "translit": "āًnَٰmyِiʾ", "root": "امن"}, {"id": 13, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 14, "arabic": "حَسْبُنَا", "translit": "āَnُbْsَḥ", "root": "حسب"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَنِعْمَ", "translit": "َmْʿعِnَw", "root": "نعم"}, {"id": 17, "arabic": "ٱلْوَكِيلُ", "translit": "ُlyِkَwْlٱ", "root": "وكل"}], "hasIhya": true}, {"ayah": 174, "text": "فَٱنقَلَبُوا۟ بِنِعْمَةٍ مِّنَ ٱللَّهِ وَفَضْلٍ لَّمْ يَمْسَسْهُمْ سُوٓءٌ وَٱتَّبَعُوا۟ رِضْوَٰنَ ٱللَّهِۗ وَٱللَّهُ ذُو فَضْلٍ عَظِيمٍ ", "translation": "So they returned with favor from Allāh and bounty, no harm having touched them. And they pursued the pleasure of Allāh, and Allāh is the possessor of great bounty.", "words": [{"id": 1, "arabic": "فَٱنقَلَبُوا۟", "translit": "۟āwُbَlَqnٱَf", "root": "قلب"}, {"id": 2, "arabic": "بِنِعْمَةٍ", "translit": "ٍẗَmْʿعِnِb", "root": "نعم"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَفَضْلٍ", "translit": "ٍlْḍَfَw", "root": "فضل"}, {"id": 6, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 7, "arabic": "يَمْسَسْهُمْ", "translit": "ْmُhْsَsْmَy", "root": "مسس"}, {"id": 8, "arabic": "سُوٓءٌ", "translit": "ٌءٓwُs", "root": "سوا"}, {"id": 9, "arabic": "وَٱتَّبَعُوا۟", "translit": "۟āwُʿعَbَّtٱَw", "root": "تبع"}, {"id": 10, "arabic": "رِضْوَٰنَ", "translit": "َnَٰwْḍِr", "root": "رضو"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 14, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 15, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 175, "text": "إِنَّمَا ذَٰلِكُمُ ٱلشَّيْطَٰنُ يُخَوِّفُ أَوْلِيَآءَهُۥ فَلَا تَخَافُوهُمْ وَخَافُونِ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "That is only Satan who frightens [you] of his supporters. So fear them not, but fear Me, if you are [indeed] believers.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ذَٰلِكُمُ", "translit": "ُmُkِlَٰhd", "root": ""}, {"id": 3, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 4, "arabic": "يُخَوِّفُ", "translit": "ُfِّwَhkُy", "root": "خوف"}, {"id": 5, "arabic": "أَوْلِيَآءَهُۥ", "translit": "ۥُhَءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 6, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 7, "arabic": "تَخَافُوهُمْ", "translit": "ْmُhwُfāَhkَt", "root": "خوف"}, {"id": 8, "arabic": "وَخَافُونِ", "translit": "ِnwُfāَhkَw", "root": "خوف"}, {"id": 9, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 10, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 11, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": true}, {"ayah": 176, "text": "وَلَا يَحْزُنكَ ٱلَّذِينَ يُسَٰرِعُونَ فِى ٱلْكُفْرِۚ إِنَّهُمْ لَن يَضُرُّوا۟ ٱللَّهَ شَيْـًٔاۗ يُرِيدُ ٱللَّهُ أَلَّا يَجْعَلَ لَهُمْ حَظًّا فِى ٱلْءَاخِرَةِۖ وَلَهُمْ عَذَابٌ عَظِيمٌ ", "translation": "And do not be grieved, [O Muḥammad], by those who hasten into disbelief. Indeed, they will never harm Allāh at all. Allāh intends that He should give them no share in the Hereafter, and for them is a great punishment.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَحْزُنكَ", "translit": "َknُzْḥَy", "root": "حزن"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يُسَٰرِعُونَ", "translit": "َnwُʿعِrَٰsُy", "root": "سرع"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْكُفْرِ", "translit": "ِrْfُkْlٱ", "root": "كفر"}, {"id": 7, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 8, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 9, "arabic": "يَضُرُّوا۟", "translit": "۟āwُّrُḍَy", "root": "ضرر"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 12, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 15, "arabic": "يَجْعَلَ", "translit": "َlَʿعْjgَy", "root": "جعل"}, {"id": 16, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 17, "arabic": "حَظًّا", "translit": "āًّẓَḥ", "root": "حظظ"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 20, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 21, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 22, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 177, "text": "إِنَّ ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلْكُفْرَ بِٱلْإِيمَٰنِ لَن يَضُرُّوا۟ ٱللَّهَ شَيْـًٔا وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "Indeed, those who purchase disbelief [in exchange] for faith - never will they harm Allāh at all, and for them is a painful punishment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱشْتَرَوُا۟", "translit": "۟āُwَrَtْhsٱ", "root": "شري"}, {"id": 4, "arabic": "ٱلْكُفْرَ", "translit": "َrْfُkْlٱ", "root": "كفر"}, {"id": 5, "arabic": "بِٱلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlٱِb", "root": "امن"}, {"id": 6, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 7, "arabic": "يَضُرُّوا۟", "translit": "۟āwُّrُḍَy", "root": "ضرر"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 10, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 178, "text": "وَلَا يَحْسَبَنَّ ٱلَّذِينَ كَفَرُوٓا۟ أَنَّمَا نُمْلِى لَهُمْ خَيْرٌ لِّأَنفُسِهِمْۚ إِنَّمَا نُمْلِى لَهُمْ لِيَزْدَادُوٓا۟ إِثْمًاۚ وَلَهُمْ عَذَابٌ مُّهِينٌ ", "translation": "And let not those who disbelieve ever think that [because] We extend their time [of enjoyment] it is better for them. We only extend it for them so that they may increase in sin, and for them is a humiliating punishment.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَحْسَبَنَّ", "translit": "َّnَbَsْḥَy", "root": "حسب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "أَنَّمَا", "translit": "āَmَّnَaʾ", "root": ""}, {"id": 6, "arabic": "نُمْلِى", "translit": "àِlْmُn", "root": "ملو"}, {"id": 7, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 8, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 9, "arabic": "لِّأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾِّl", "root": "نفس"}, {"id": 10, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 11, "arabic": "نُمْلِى", "translit": "àِlْmُn", "root": "ملو"}, {"id": 12, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 13, "arabic": "لِيَزْدَادُوٓا۟", "translit": "۟āٓwُdāَdْzَyِl", "root": "زيد"}, {"id": 14, "arabic": "إِثْمًا", "translit": "āًmْhtِiʾ", "root": "اثم"}, {"id": 15, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 16, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 17, "arabic": "مُّهِينٌ", "translit": "ٌnyِhُّm", "root": "هون"}], "hasIhya": true}, {"ayah": 179, "text": "مَّا كَانَ ٱللَّهُ لِيَذَرَ ٱلْمُؤْمِنِينَ عَلَىٰ مَآ أَنتُمْ عَلَيْهِ حَتَّىٰ يَمِيزَ ٱلْخَبِيثَ مِنَ ٱلطَّيِّبِۗ وَمَا كَانَ ٱللَّهُ لِيُطْلِعَكُمْ عَلَى ٱلْغَيْبِ وَلَٰكِنَّ ٱللَّهَ يَجْتَبِى مِن رُّسُلِهِۦ مَن يَشَآءُۖ فَـَٔامِنُوا۟ بِٱللَّهِ وَرُسُلِهِۦۚ وَإِن تُؤْمِنُوا۟ وَتَتَّقُوا۟ فَلَكُمْ أَجْرٌ عَظِيمٌ ", "translation": "Allāh would not leave the believers in that [state] you are in [presently] until He separates the evil from the good. Nor would Allāh reveal to you the unseen. But [instead], Allāh chooses of His messengers whom He wills, so believe in Allāh and His messengers. And if you believe and fear Him, then for you is a great reward.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لِيَذَرَ", "translit": "َrَhdَyِl", "root": "وذر"}, {"id": 5, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 8, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 9, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 11, "arabic": "يَمِيزَ", "translit": "َzyِmَy", "root": "ميز"}, {"id": 12, "arabic": "ٱلْخَبِيثَ", "translit": "َhtyِbَhkْlٱ", "root": "خبث"}, {"id": 13, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 14, "arabic": "ٱلطَّيِّبِ", "translit": "ِbِّyَّṭlٱ", "root": "طيب"}, {"id": 15, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 16, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "لِيُطْلِعَكُمْ", "translit": "ْmُkَʿعِlْṭُyِl", "root": "طلع"}, {"id": 19, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 20, "arabic": "ٱلْغَيْبِ", "translit": "ِbْyَغْlٱ", "root": "غيب"}, {"id": 21, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "يَجْتَبِى", "translit": "àِbَtْjgَy", "root": "جبي"}, {"id": 24, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 25, "arabic": "رُّسُلِهِۦ", "translit": "ۦِhِlُsُّr", "root": "رسل"}, {"id": 26, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 27, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 28, "arabic": "فَـَٔامِنُوا۟", "translit": "۟āwُnِmāَٔـَf", "root": "امن"}, {"id": 29, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 30, "arabic": "وَرُسُلِهِۦ", "translit": "ۦِhِlُsُrَw", "root": "رسل"}, {"id": 31, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 32, "arabic": "تُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُt", "root": "امن"}, {"id": 33, "arabic": "وَتَتَّقُوا۟", "translit": "۟āwُqَّtَtَw", "root": "وقي"}, {"id": 34, "arabic": "فَلَكُمْ", "translit": "ْmُkَlَf", "root": ""}, {"id": 35, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 36, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 180, "text": "وَلَا يَحْسَبَنَّ ٱلَّذِينَ يَبْخَلُونَ بِمَآ ءَاتَىٰهُمُ ٱللَّهُ مِن فَضْلِهِۦ هُوَ خَيْرًا لَّهُمۖ بَلْ هُوَ شَرٌّ لَّهُمْۖ سَيُطَوَّقُونَ مَا بَخِلُوا۟ بِهِۦ يَوْمَ ٱلْقِيَٰمَةِۗ وَلِلَّهِ مِيرَٰثُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۗ وَٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرٌ ", "translation": "And let not those who [greedily] withhold what Allāh has given them of His bounty ever think that it is better for them. Rather, it is worse for them. Their necks will be encircled by what they withheld on the Day of Resurrection. And to Allāh belongs the heritage of the heavens and the earth. And Allāh, of what you do, is [fully] Aware.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَحْسَبَنَّ", "translit": "َّnَbَsْḥَy", "root": "حسب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَبْخَلُونَ", "translit": "َnwُlَhkْbَy", "root": "بخل"}, {"id": 5, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 6, "arabic": "ءَاتَىٰهُمُ", "translit": "ُmُhٰàَtāَء", "root": "اتي"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 12, "arabic": "لَّهُم", "translit": "mُhَّl", "root": ""}, {"id": 13, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "شَرٌّ", "translit": "ٌّrَhs", "root": "شرر"}, {"id": 16, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 17, "arabic": "سَيُطَوَّقُونَ", "translit": "َnwُqَّwَṭُyَs", "root": "طوق"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "بَخِلُوا۟", "translit": "۟āwُlِhkَb", "root": "بخل"}, {"id": 20, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 21, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 22, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 23, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 24, "arabic": "مِيرَٰثُ", "translit": "ُhtَٰryِm", "root": "ورث"}, {"id": 25, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 26, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 27, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 28, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 29, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 30, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 181, "text": "لَّقَدْ سَمِعَ ٱللَّهُ قَوْلَ ٱلَّذِينَ قَالُوٓا۟ إِنَّ ٱللَّهَ فَقِيرٌ وَنَحْنُ أَغْنِيَآءُۘ سَنَكْتُبُ مَا قَالُوا۟ وَقَتْلَهُمُ ٱلْأَنۢبِيَآءَ بِغَيْرِ حَقٍّ وَنَقُولُ ذُوقُوا۟ عَذَابَ ٱلْحَرِيقِ ", "translation": "Allāh has certainly heard the statement of those [Jews] who said, \"Indeed, Allāh is poor, while we are rich.\" We will record what they said and their killing of the prophets without right and will say, \"Taste the punishment of the Burning Fire.", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": ""}, {"id": 2, "arabic": "سَمِعَ", "translit": "َʿعِmَs", "root": "سمع"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "قَوْلَ", "translit": "َlْwَq", "root": "قول"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "فَقِيرٌ", "translit": "ٌryِqَf", "root": "فقر"}, {"id": 10, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 11, "arabic": "أَغْنِيَآءُ", "translit": "ُءٓāَyِnْغَaʾ", "root": "غني"}, {"id": 12, "arabic": "سَنَكْتُبُ", "translit": "ُbُtْkَnَs", "root": "كتب"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 15, "arabic": "وَقَتْلَهُمُ", "translit": "ُmُhَlْtَqَw", "root": "قتل"}, {"id": 16, "arabic": "ٱلْأَنۢبِيَآءَ", "translit": "َءٓāَyِbۢnَaʾْlٱ", "root": "نبا"}, {"id": 17, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 18, "arabic": "حَقٍّ", "translit": "ٍّqَḥ", "root": "حقق"}, {"id": 19, "arabic": "وَنَقُولُ", "translit": "ُlwُqَnَw", "root": "قول"}, {"id": 20, "arabic": "ذُوقُوا۟", "translit": "۟āwُqwُhd", "root": "ذوق"}, {"id": 21, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 22, "arabic": "ٱلْحَرِيقِ", "translit": "ِqyِrَḥْlٱ", "root": "حرق"}], "hasIhya": false}, {"ayah": 182, "text": "ذَٰلِكَ بِمَا قَدَّمَتْ أَيْدِيكُمْ وَأَنَّ ٱللَّهَ لَيْسَ بِظَلَّامٍ لِّلْعَبِيدِ ", "translation": "That is for what your hands have put forth and because Allāh is not ever unjust to [His] servants.\"", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 3, "arabic": "قَدَّمَتْ", "translit": "ْtَmَّdَq", "root": "قدم"}, {"id": 4, "arabic": "أَيْدِيكُمْ", "translit": "ْmُkyِdْyَaʾ", "root": "يدي"}, {"id": 5, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 8, "arabic": "بِظَلَّامٍ", "translit": "ٍmāَّlَẓِb", "root": "ظلم"}, {"id": 9, "arabic": "لِّلْعَبِيدِ", "translit": "ِdyِbَʿعْlِّl", "root": "عبد"}], "hasIhya": true}, {"ayah": 183, "text": "ٱلَّذِينَ قَالُوٓا۟ إِنَّ ٱللَّهَ عَهِدَ إِلَيْنَآ أَلَّا نُؤْمِنَ لِرَسُولٍ حَتَّىٰ يَأْتِيَنَا بِقُرْبَانٍ تَأْكُلُهُ ٱلنَّارُۗ قُلْ قَدْ جَآءَكُمْ رُسُلٌ مِّن قَبْلِى بِٱلْبَيِّنَٰتِ وَبِٱلَّذِى قُلْتُمْ فَلِمَ قَتَلْتُمُوهُمْ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "[They are] those who said, \"Indeed, Allāh has taken our promise not to believe any messenger until he brings us an offering which fire [from heaven] will consume.\" Say, \"There have already come to you messengers before me with clear proofs and [even] that of which you speak. So why did you kill them, if you should be truthful?\"", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "عَهِدَ", "translit": "َdِhَʿع", "root": "عهد"}, {"id": 6, "arabic": "إِلَيْنَآ", "translit": "ٓāَnْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 8, "arabic": "نُؤْمِنَ", "translit": "َnِmْwʾُn", "root": "امن"}, {"id": 9, "arabic": "لِرَسُولٍ", "translit": "ٍlwُsَrِl", "root": "رسل"}, {"id": 10, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 11, "arabic": "يَأْتِيَنَا", "translit": "āَnَyِtْaʾَy", "root": "اتي"}, {"id": 12, "arabic": "بِقُرْبَانٍ", "translit": "ٍnāَbْrُqِb", "root": "قرب"}, {"id": 13, "arabic": "تَأْكُلُهُ", "translit": "ُhُlُkْaʾَt", "root": "اكل"}, {"id": 14, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 15, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 16, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 17, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 18, "arabic": "رُسُلٌ", "translit": "ٌlُsُr", "root": "رسل"}, {"id": 19, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 20, "arabic": "قَبْلِى", "translit": "àِlْbَq", "root": "قبل"}, {"id": 21, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 22, "arabic": "وَبِٱلَّذِى", "translit": "àِhdَّlٱِbَw", "root": ""}, {"id": 23, "arabic": "قُلْتُمْ", "translit": "ْmُtْlُq", "root": "قول"}, {"id": 24, "arabic": "فَلِمَ", "translit": "َmِlَf", "root": ""}, {"id": 25, "arabic": "قَتَلْتُمُوهُمْ", "translit": "ْmُhwُmُtْlَtَq", "root": "قتل"}, {"id": 26, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 27, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 28, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 184, "text": "فَإِن كَذَّبُوكَ فَقَدْ كُذِّبَ رُسُلٌ مِّن قَبْلِكَ جَآءُو بِٱلْبَيِّنَٰتِ وَٱلزُّبُرِ وَٱلْكِتَٰبِ ٱلْمُنِيرِ ", "translation": "Then if they deny you, [O Muḥammad] - so were messengers denied before you, who brought clear proofs and written ordinances and the enlightening Scripture.[1]", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "كَذَّبُوكَ", "translit": "َkwُbَّhdَk", "root": "كذب"}, {"id": 3, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 4, "arabic": "كُذِّبَ", "translit": "َbِّhdُk", "root": "كذب"}, {"id": 5, "arabic": "رُسُلٌ", "translit": "ٌlُsُr", "root": "رسل"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 8, "arabic": "جَآءُو", "translit": "wُءٓāَjg", "root": "جيا"}, {"id": 9, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 10, "arabic": "وَٱلزُّبُرِ", "translit": "ِrُbُّzlٱَw", "root": "زبر"}, {"id": 11, "arabic": "وَٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱَw", "root": "كتب"}, {"id": 12, "arabic": "ٱلْمُنِيرِ", "translit": "ِryِnُmْlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 185, "text": "كُلُّ نَفْسٍ ذَآئِقَةُ ٱلْمَوْتِۗ وَإِنَّمَا تُوَفَّوْنَ أُجُورَكُمْ يَوْمَ ٱلْقِيَٰمَةِۖ فَمَن زُحْزِحَ عَنِ ٱلنَّارِ وَأُدْخِلَ ٱلْجَنَّةَ فَقَدْ فَازَۗ وَمَا ٱلْحَيَوٰةُ ٱلدُّنْيَآ إِلَّا مَتَٰعُ ٱلْغُرُورِ ", "translation": "Every soul will taste death, and you will only be given your [full] compensation on the Day of Resurrection. So he who is drawn away from the Fire and admitted to Paradise has attained [his desire]. And what is the life of this world except the enjoyment of delusion.", "words": [{"id": 1, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 2, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 3, "arabic": "ذَآئِقَةُ", "translit": "ُẗَqِyʾٓāَhd", "root": "ذوق"}, {"id": 4, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَإِنَّمَا", "translit": "āَmَّnِiʾَw", "root": ""}, {"id": 6, "arabic": "تُوَفَّوْنَ", "translit": "َnْwَّfَwُt", "root": "وفي"}, {"id": 7, "arabic": "أُجُورَكُمْ", "translit": "ْmُkَrwُjgُaʾ", "root": "اجر"}, {"id": 8, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 9, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 10, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 11, "arabic": "زُحْزِحَ", "translit": "َḥِzْḥُz", "root": "زحزح"}, {"id": 12, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 13, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 14, "arabic": "وَأُدْخِلَ", "translit": "َlِhkْdُaʾَw", "root": "دخل"}, {"id": 15, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 16, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 17, "arabic": "فَازَ", "translit": "َzāَf", "root": "فوز"}, {"id": 18, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 19, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 20, "arabic": "ٱلدُّنْيَآ", "translit": "ٓāَyْnُّdlٱ", "root": "دنو"}, {"id": 21, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 22, "arabic": "مَتَٰعُ", "translit": "ُʿعَٰtَm", "root": "متع"}, {"id": 23, "arabic": "ٱلْغُرُورِ", "translit": "ِrwُrُغْlٱ", "root": "غرر"}], "hasIhya": true}, {"ayah": 186, "text": "لَتُبْلَوُنَّ فِىٓ أَمْوَٰلِكُمْ وَأَنفُسِكُمْ وَلَتَسْمَعُنَّ مِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ مِن قَبْلِكُمْ وَمِنَ ٱلَّذِينَ أَشْرَكُوٓا۟ أَذًى كَثِيرًاۚ وَإِن تَصْبِرُوا۟ وَتَتَّقُوا۟ فَإِنَّ ذَٰلِكَ مِنْ عَزْمِ ٱلْأُمُورِ ", "translation": "You will surely be tested in your possessions and in yourselves. And you will surely hear from those who were given the Scripture before you and from those who associate others with Allāh much abuse. But if you are patient and fear Allāh - indeed, that is of the matters [worthy] of resolve.", "words": [{"id": 1, "arabic": "لَتُبْلَوُنَّ", "translit": "َّnُwَlْbُtَl", "root": "بلو"}, {"id": 2, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 3, "arabic": "أَمْوَٰلِكُمْ", "translit": "ْmُkِlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "وَأَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾَw", "root": "نفس"}, {"id": 5, "arabic": "وَلَتَسْمَعُنَّ", "translit": "َّnُʿعَmْsَtَlَw", "root": "سمع"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 9, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 12, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "أَشْرَكُوٓا۟", "translit": "۟āٓwُkَrْhsَaʾ", "root": "شرك"}, {"id": 15, "arabic": "أَذًى", "translit": "àًhdَaʾ", "root": "اذي"}, {"id": 16, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 17, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 18, "arabic": "تَصْبِرُوا۟", "translit": "۟āwُrِbْṣَt", "root": "صبر"}, {"id": 19, "arabic": "وَتَتَّقُوا۟", "translit": "۟āwُqَّtَtَw", "root": "وقي"}, {"id": 20, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 21, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 22, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 23, "arabic": "عَزْمِ", "translit": "ِmْzَʿع", "root": "عزم"}, {"id": 24, "arabic": "ٱلْأُمُورِ", "translit": "ِrwُmُaʾْlٱ", "root": "امر"}], "hasIhya": true}, {"ayah": 187, "text": "وَإِذْ أَخَذَ ٱللَّهُ مِيثَٰقَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ لَتُبَيِّنُنَّهُۥ لِلنَّاسِ وَلَا تَكْتُمُونَهُۥ فَنَبَذُوهُ وَرَآءَ ظُهُورِهِمْ وَٱشْتَرَوْا۟ بِهِۦ ثَمَنًا قَلِيلًاۖ فَبِئْسَ مَا يَشْتَرُونَ ", "translation": "And [mention, O Muḥammad], when Allāh took a covenant from those who were given the Scripture, [saying], \"You must make it clear [i.e., explain it] to the people and not conceal it.\" But they threw it away behind their backs and exchanged it for a small price. And wretched is that which they purchased.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَخَذَ", "translit": "َhdَhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "مِيثَٰقَ", "translit": "َqَٰhtyِm", "root": "وثق"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 7, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 8, "arabic": "لَتُبَيِّنُنَّهُۥ", "translit": "ۥُhَّnُnِّyَbُtَl", "root": "بين"}, {"id": 9, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تَكْتُمُونَهُۥ", "translit": "ۥُhَnwُmُtْkَt", "root": "كتم"}, {"id": 12, "arabic": "فَنَبَذُوهُ", "translit": "ُhwُhdَbَnَf", "root": "نبذ"}, {"id": 13, "arabic": "وَرَآءَ", "translit": "َءٓāَrَw", "root": "وري"}, {"id": 14, "arabic": "ظُهُورِهِمْ", "translit": "ْmِhِrwُhُẓ", "root": "ظهر"}, {"id": 15, "arabic": "وَٱشْتَرَوْا۟", "translit": "۟āْwَrَtْhsٱَw", "root": "شري"}, {"id": 16, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 17, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 18, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 19, "arabic": "فَبِئْسَ", "translit": "َsْyʾِbَf", "root": "باس"}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 21, "arabic": "يَشْتَرُونَ", "translit": "َnwُrَtْhsَy", "root": "شري"}], "hasIhya": true}, {"ayah": 188, "text": "لَا تَحْسَبَنَّ ٱلَّذِينَ يَفْرَحُونَ بِمَآ أَتَوا۟ وَّيُحِبُّونَ أَن يُحْمَدُوا۟ بِمَا لَمْ يَفْعَلُوا۟ فَلَا تَحْسَبَنَّهُم بِمَفَازَةٍ مِّنَ ٱلْعَذَابِۖ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "And never think that those who rejoice in what they have perpetrated and like to be praised for what they did not do - never think them [to be] in safety from the punishment, and for them is a painful punishment.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "تَحْسَبَنَّ", "translit": "َّnَbَsْḥَt", "root": "حسب"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَفْرَحُونَ", "translit": "َnwُḥَrْfَy", "root": "فرح"}, {"id": 5, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 6, "arabic": "أَتَوا۟", "translit": "۟āwَtَaʾ", "root": "اتي"}, {"id": 7, "arabic": "وَّيُحِبُّونَ", "translit": "َnwُّbِḥُyَّw", "root": "حبب"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يُحْمَدُوا۟", "translit": "۟āwُdَmْḥُy", "root": "حمد"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 12, "arabic": "يَفْعَلُوا۟", "translit": "۟āwُlَʿعْfَy", "root": "فعل"}, {"id": 13, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 14, "arabic": "تَحْسَبَنَّهُم", "translit": "mُhَّnَbَsْḥَt", "root": "حسب"}, {"id": 15, "arabic": "بِمَفَازَةٍ", "translit": "ٍẗَzāَfَmِb", "root": "فوز"}, {"id": 16, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 17, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 18, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 19, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 20, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 189, "text": "وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "And to Allāh belongs the dominion of the heavens and the earth, and Allāh is over all things competent.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 8, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 9, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 190, "text": "إِنَّ فِى خَلْقِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَٰفِ ٱلَّيْلِ وَٱلنَّهَارِ لَءَايَٰتٍ لِّأُو۟لِى ٱلْأَلْبَٰبِ ", "translation": "Indeed, in the creation of the heavens and the earth and the alternation of the night and the day are signs for those of understanding -", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "خَلْقِ", "translit": "ِqْlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَٱخْتِلَٰفِ", "translit": "ِfَٰlِtْhkٱَw", "root": "خلف"}, {"id": 7, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 8, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 9, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 10, "arabic": "لِّأُو۟لِى", "translit": "àِl۟wُaʾِّl", "root": ""}, {"id": 11, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}], "hasIhya": true}, {"ayah": 191, "text": "ٱلَّذِينَ يَذْكُرُونَ ٱللَّهَ قِيَٰمًا وَقُعُودًا وَعَلَىٰ جُنُوبِهِمْ وَيَتَفَكَّرُونَ فِى خَلْقِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ رَبَّنَا مَا خَلَقْتَ هَٰذَا بَٰطِلًا سُبْحَٰنَكَ فَقِنَا عَذَابَ ٱلنَّارِ ", "translation": "Who remember Allāh while standing or sitting or [lying] on their sides and give thought to the creation of the heavens and the earth, [saying], \"Our Lord, You did not create this aimlessly; exalted are You [above such a thing]; then protect us from the punishment of the Fire.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَذْكُرُونَ", "translit": "َnwُrُkْhdَy", "root": "ذكر"}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "قِيَٰمًا", "translit": "āًmَٰyِq", "root": "قوم"}, {"id": 5, "arabic": "وَقُعُودًا", "translit": "āًdwُʿعُqَw", "root": "قعد"}, {"id": 6, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 7, "arabic": "جُنُوبِهِمْ", "translit": "ْmِhِbwُnُjg", "root": "جنب"}, {"id": 8, "arabic": "وَيَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَyَw", "root": "فكر"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "خَلْقِ", "translit": "ِqْlَhk", "root": "خلق"}, {"id": 11, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 12, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 13, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "خَلَقْتَ", "translit": "َtْqَlَhk", "root": "خلق"}, {"id": 16, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 17, "arabic": "بَٰطِلًا", "translit": "āًlِṭَٰb", "root": "بطل"}, {"id": 18, "arabic": "سُبْحَٰنَكَ", "translit": "َkَnَٰḥْbُs", "root": "سبح"}, {"id": 19, "arabic": "فَقِنَا", "translit": "āَnِqَf", "root": "وقي"}, {"id": 20, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 21, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": true}, {"ayah": 192, "text": "رَبَّنَآ إِنَّكَ مَن تُدْخِلِ ٱلنَّارَ فَقَدْ أَخْزَيْتَهُۥۖ وَمَا لِلظَّٰلِمِينَ مِنْ أَنصَارٍ ", "translation": "Our Lord, indeed whoever You admit to the Fire - You have disgraced him, and for the wrongdoers there are no helpers.", "words": [{"id": 1, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "تُدْخِلِ", "translit": "ِlِhkْdُt", "root": "دخل"}, {"id": 5, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 7, "arabic": "أَخْزَيْتَهُۥ", "translit": "ۥُhَtْyَzْhkَaʾ", "root": "خزي"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "لِلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlِl", "root": "ظلم"}, {"id": 10, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 11, "arabic": "أَنصَارٍ", "translit": "ٍrāَṣnَaʾ", "root": "نصر"}], "hasIhya": false}, {"ayah": 193, "text": "رَّبَّنَآ إِنَّنَا سَمِعْنَا مُنَادِيًا يُنَادِى لِلْإِيمَٰنِ أَنْ ءَامِنُوا۟ بِرَبِّكُمْ فَـَٔامَنَّاۚ رَبَّنَا فَٱغْفِرْ لَنَا ذُنُوبَنَا وَكَفِّرْ عَنَّا سَيِّـَٔاتِنَا وَتَوَفَّنَا مَعَ ٱلْأَبْرَارِ ", "translation": "Our Lord, indeed we have heard a caller [i.e., Prophet Muḥammad (ﷺ)] calling to faith, [saying], 'Believe in your Lord,' and we have believed. Our Lord, so forgive us our sins and remove from us our misdeeds and cause us to die among the righteous.", "words": [{"id": 1, "arabic": "رَّبَّنَآ", "translit": "ٓāَnَّbَّr", "root": "ربب"}, {"id": 2, "arabic": "إِنَّنَا", "translit": "āَnَّnِiʾ", "root": ""}, {"id": 3, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 4, "arabic": "مُنَادِيًا", "translit": "āًyِdāَnُm", "root": "ندي"}, {"id": 5, "arabic": "يُنَادِى", "translit": "àِdāَnُy", "root": "ندي"}, {"id": 6, "arabic": "لِلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlِl", "root": "امن"}, {"id": 7, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 8, "arabic": "ءَامِنُوا۟", "translit": "۟āwُnِmāَء", "root": "امن"}, {"id": 9, "arabic": "بِرَبِّكُمْ", "translit": "ْmُkِّbَrِb", "root": "ربب"}, {"id": 10, "arabic": "فَـَٔامَنَّا", "translit": "āَّnَmāَٔـَf", "root": "امن"}, {"id": 11, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 12, "arabic": "فَٱغْفِرْ", "translit": "ْrِfْغٱَf", "root": "غفر"}, {"id": 13, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 14, "arabic": "ذُنُوبَنَا", "translit": "āَnَbwُnُhd", "root": "ذنب"}, {"id": 15, "arabic": "وَكَفِّرْ", "translit": "ْrِّfَkَw", "root": "كفر"}, {"id": 16, "arabic": "عَنَّا", "translit": "āَّnَʿع", "root": ""}, {"id": 17, "arabic": "سَيِّـَٔاتِنَا", "translit": "āَnِtāَٔـِّyَs", "root": "سوا"}, {"id": 18, "arabic": "وَتَوَفَّنَا", "translit": "āَnَّfَwَtَw", "root": "وفي"}, {"id": 19, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 20, "arabic": "ٱلْأَبْرَارِ", "translit": "ِrāَrْbَaʾْlٱ", "root": "برر"}], "hasIhya": true}, {"ayah": 194, "text": "رَبَّنَا وَءَاتِنَا مَا وَعَدتَّنَا عَلَىٰ رُسُلِكَ وَلَا تُخْزِنَا يَوْمَ ٱلْقِيَٰمَةِۗ إِنَّكَ لَا تُخْلِفُ ٱلْمِيعَادَ ", "translation": "Our Lord, and grant us what You promised us through Your messengers and do not disgrace us on the Day of Resurrection. Indeed, You do not fail in [Your] promise.\"", "words": [{"id": 1, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "وَءَاتِنَا", "translit": "āَnِtāَءَw", "root": "اتي"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "وَعَدتَّنَا", "translit": "āَnَّtdَʿعَw", "root": "وعد"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "رُسُلِكَ", "translit": "َkِlُsُr", "root": "رسل"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "تُخْزِنَا", "translit": "āَnِzْhkُt", "root": "خزي"}, {"id": 9, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 10, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 11, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "تُخْلِفُ", "translit": "ُfِlْhkُt", "root": "خلف"}, {"id": 14, "arabic": "ٱلْمِيعَادَ", "translit": "َdāَʿعyِmْlٱ", "root": "وعد"}], "hasIhya": true}, {"ayah": 195, "text": "فَٱسْتَجَابَ لَهُمْ رَبُّهُمْ أَنِّى لَآ أُضِيعُ عَمَلَ عَٰمِلٍ مِّنكُم مِّن ذَكَرٍ أَوْ أُنثَىٰۖ بَعْضُكُم مِّنۢ بَعْضٍۖ فَٱلَّذِينَ هَاجَرُوا۟ وَأُخْرِجُوا۟ مِن دِيَٰرِهِمْ وَأُوذُوا۟ فِى سَبِيلِى وَقَٰتَلُوا۟ وَقُتِلُوا۟ لَأُكَفِّرَنَّ عَنْهُمْ سَيِّـَٔاتِهِمْ وَلَأُدْخِلَنَّهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ ثَوَابًا مِّنْ عِندِ ٱللَّهِۗ وَٱللَّهُ عِندَهُۥ حُسْنُ ٱلثَّوَابِ ", "translation": "And their Lord responded to them, \"Never will I allow to be lost the work of [any] worker among you, whether male or female; you are of one another. So those who emigrated or were evicted from their homes or were harmed in My cause or fought or were killed - I will surely remove from them their misdeeds, and I will surely admit them to gardens beneath which rivers flow as reward from Allāh, and Allāh has with Him the best reward.\"", "words": [{"id": 1, "arabic": "فَٱسْتَجَابَ", "translit": "َbāَjgَtْsٱَf", "root": "جوب"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "رَبُّهُمْ", "translit": "ْmُhُّbَr", "root": "ربب"}, {"id": 4, "arabic": "أَنِّى", "translit": "àِّnَaʾ", "root": ""}, {"id": 5, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 6, "arabic": "أُضِيعُ", "translit": "ُʿعyِḍُaʾ", "root": "ضيع"}, {"id": 7, "arabic": "عَمَلَ", "translit": "َlَmَʿع", "root": "عمل"}, {"id": 8, "arabic": "عَٰمِلٍ", "translit": "ٍlِmَٰʿع", "root": "عمل"}, {"id": 9, "arabic": "مِّنكُم", "translit": "mُknِّm", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "ذَكَرٍ", "translit": "ٍrَkَhd", "root": "ذكر"}, {"id": 12, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 13, "arabic": "أُنثَىٰ", "translit": "ٰàَhtnُaʾ", "root": "انث"}, {"id": 14, "arabic": "بَعْضُكُم", "translit": "mُkُḍْʿعَb", "root": "بعض"}, {"id": 15, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 16, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 17, "arabic": "فَٱلَّذِينَ", "translit": "َnyِhdَّlٱَf", "root": ""}, {"id": 18, "arabic": "هَاجَرُوا۟", "translit": "۟āwُrَjgāَh", "root": "هجر"}, {"id": 19, "arabic": "وَأُخْرِجُوا۟", "translit": "۟āwُjgِrْhkُaʾَw", "root": "خرج"}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 21, "arabic": "دِيَٰرِهِمْ", "translit": "ْmِhِrَٰyِd", "root": "دور"}, {"id": 22, "arabic": "وَأُوذُوا۟", "translit": "۟āwُhdwُaʾَw", "root": "اذي"}, {"id": 23, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 24, "arabic": "سَبِيلِى", "translit": "àِlyِbَs", "root": "سبل"}, {"id": 25, "arabic": "وَقَٰتَلُوا۟", "translit": "۟āwُlَtَٰqَw", "root": "قتل"}, {"id": 26, "arabic": "وَقُتِلُوا۟", "translit": "۟āwُlِtُqَw", "root": "قتل"}, {"id": 27, "arabic": "لَأُكَفِّرَنَّ", "translit": "َّnَrِّfَkُaʾَl", "root": "كفر"}, {"id": 28, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 29, "arabic": "سَيِّـَٔاتِهِمْ", "translit": "ْmِhِtāَٔـِّyَs", "root": "سوا"}, {"id": 30, "arabic": "وَلَأُدْخِلَنَّهُمْ", "translit": "ْmُhَّnَlِhkْdُaʾَlَw", "root": "دخل"}, {"id": 31, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 32, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 33, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 34, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 35, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 36, "arabic": "ثَوَابًا", "translit": "āًbāَwَht", "root": "ثوب"}, {"id": 37, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 38, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 39, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 40, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 41, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 42, "arabic": "حُسْنُ", "translit": "ُnْsُḥ", "root": "حسن"}, {"id": 43, "arabic": "ٱلثَّوَابِ", "translit": "ِbāَwَّhtlٱ", "root": "ثوب"}], "hasIhya": true}, {"ayah": 196, "text": "لَا يَغُرَّنَّكَ تَقَلُّبُ ٱلَّذِينَ كَفَرُوا۟ فِى ٱلْبِلَٰدِ ", "translation": "Be not deceived by the [uninhibited] movement of the disbelievers throughout the land.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَغُرَّنَّكَ", "translit": "َkَّnَّrُغَy", "root": "غرر"}, {"id": 3, "arabic": "تَقَلُّبُ", "translit": "ُbُّlَqَt", "root": "قلب"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْبِلَٰدِ", "translit": "ِdَٰlِbْlٱ", "root": "بلد"}], "hasIhya": false}, {"ayah": 197, "text": "مَتَٰعٌ قَلِيلٌ ثُمَّ مَأْوَىٰهُمْ جَهَنَّمُۚ وَبِئْسَ ٱلْمِهَادُ ", "translation": "[It is but] a small enjoyment; then their [final] refuge is Hell, and wretched is the resting place.", "words": [{"id": 1, "arabic": "مَتَٰعٌ", "translit": "ٌʿعَٰtَm", "root": "متع"}, {"id": 2, "arabic": "قَلِيلٌ", "translit": "ٌlyِlَq", "root": "قلل"}, {"id": 3, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 4, "arabic": "مَأْوَىٰهُمْ", "translit": "ْmُhٰàَwْaʾَm", "root": "اوي"}, {"id": 5, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 6, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 7, "arabic": "ٱلْمِهَادُ", "translit": "ُdāَhِmْlٱ", "root": "مهد"}], "hasIhya": false}, {"ayah": 198, "text": "لَٰكِنِ ٱلَّذِينَ ٱتَّقَوْا۟ رَبَّهُمْ لَهُمْ جَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَا نُزُلًا مِّنْ عِندِ ٱللَّهِۗ وَمَا عِندَ ٱللَّهِ خَيْرٌ لِّلْأَبْرَارِ ", "translation": "But those who feared their Lord will have gardens beneath which rivers flow, abiding eternally therein, as accommodation from Allāh. And that which is with Allāh is best for the righteous.", "words": [{"id": 1, "arabic": "لَٰكِنِ", "translit": "ِnِkَٰl", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱ", "root": "وقي"}, {"id": 4, "arabic": "رَبَّهُمْ", "translit": "ْmُhَّbَr", "root": "ربب"}, {"id": 5, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 6, "arabic": "جَنَّٰتٌ", "translit": "ٌtَّٰnَjg", "root": "جنن"}, {"id": 7, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 10, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 11, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 12, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 13, "arabic": "نُزُلًا", "translit": "āًlُzُn", "root": "نزل"}, {"id": 14, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 15, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 18, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 21, "arabic": "لِّلْأَبْرَارِ", "translit": "ِrāَrْbَaʾْlِّl", "root": "برر"}], "hasIhya": true}, {"ayah": 199, "text": "وَإِنَّ مِنْ أَهْلِ ٱلْكِتَٰبِ لَمَن يُؤْمِنُ بِٱللَّهِ وَمَآ أُنزِلَ إِلَيْكُمْ وَمَآ أُنزِلَ إِلَيْهِمْ خَٰشِعِينَ لِلَّهِ لَا يَشْتَرُونَ بِـَٔايَٰتِ ٱللَّهِ ثَمَنًا قَلِيلًاۗ أُو۟لَٰٓئِكَ لَهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْۗ إِنَّ ٱللَّهَ سَرِيعُ ٱلْحِسَابِ ", "translation": "And indeed, among the People of the Scripture are those who believe in Allāh and what was revealed to you and what was revealed to them, [being] humbly submissive to Allāh. They do not exchange the verses of Allāh for a small price. Those will have their reward with their Lord. Indeed, Allāh is swift in account.", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 3, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 4, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "لَمَن", "translit": "nَmَl", "root": ""}, {"id": 6, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 7, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 8, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 9, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 10, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 11, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 12, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 13, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 14, "arabic": "خَٰشِعِينَ", "translit": "َnyِʿعِhsَٰhk", "root": "خشع"}, {"id": 15, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَشْتَرُونَ", "translit": "َnwُrَtْhsَy", "root": "شري"}, {"id": 18, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 21, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 22, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 23, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 24, "arabic": "أَجْرُهُمْ", "translit": "ْmُhُrْjgَaʾ", "root": "اجر"}, {"id": 25, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 26, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 27, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 28, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "سَرِيعُ", "translit": "ُʿعyِrَs", "root": "سرع"}, {"id": 30, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": true}, {"ayah": 200, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱصْبِرُوا۟ وَصَابِرُوا۟ وَرَابِطُوا۟ وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ تُفْلِحُونَ ", "translation": "O you who have believed, persevere[1] and endure[2] and remain stationed[3] and fear Allāh that you may be successful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱصْبِرُوا۟", "translit": "۟āwُrِbْṣٱ", "root": "صبر"}, {"id": 5, "arabic": "وَصَابِرُوا۟", "translit": "۟āwُrِbāَṣَw", "root": "صبر"}, {"id": 6, "arabic": "وَرَابِطُوا۟", "translit": "۟āwُṭِbāَrَw", "root": "ربط"}, {"id": 7, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 10, "arabic": "تُفْلِحُونَ", "translit": "َnwُḥِlْfُt", "root": "فلح"}], "hasIhya": true}], "tafsir": {"2": [{"arabic": "وجل في كلام يردده في نفسه كما لو سمع وهو يقول {إنني أنا الله لا إله إلا أنا فاعبدني} فإنه ما كان ينبغي أن يفهم منه ذلك إلا على سبيل الحكاية الصنف الثاني من الشطح كلمات غير مفهومة لها ظواهر رائقة وفيها عبارات هائلة وليس وراءها طائل إما أن تكون غير مفهومة عند قائلها بل يصدرها عن خبط في عقله وتشويش في خياله لقلة إحاطته بمعنى كلام قرع سمعه وهذا هو الأكثر وإما أن تكون مفهومة له ولكنه لا يقدر على تفهيمها وإيرادها بعبارة تدل على ضميره لقلة ممارسته للعلم وعدم تعلمه طريق التعبير عن المعاني بالألفاظ الرشيقة ولا فائدة لهذا الجنس من الكلام إلا أ", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "فراشه أستغفر الله العظيم الذي لا إله إلا هو الحي القيوم وأتوب إليه ثلاث مرات غفر الله له ذنوبه وإن كانت مثل زبد البحر أو عدد رمل عالج أو عدد ورق الشجر أو عدد أيام الدنيا (5) وقال صلى الله عليه وسلم في حديث آخر من قال ذلك غفرت ذنوبه وإن كان فارا من الزحف (6) وقال حذيفة كنت ذرب اللسان على أهلي فقلت يا رسول الله لقد خشيت أن يدخلني لساني النار فقال النبي صلى الله عليه وسلم فأين أنت من الاستغفار فإني لأستغفر الله في اليوم مائة مرة (7) وقالت عائشة رضي الله عنها قال لي رسول الله صلى الله عليه وسلم أن كنت ألم", "english": "God Most High said: {«والذين إذا فعلوا فاحشة أو ظلموا أنفسهم ذكروا الله فاستغفروا لذنوبهم»} — \"And those who, when they commit an indecency or wrong themselves, remember God and seek forgiveness for their sins\" {آل عمران/135}.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 246", "section_title_en": "On Seeking Forgiveness (Al-Istighfar) — Section 246", "section_index": 246, "anchors": "- Root: ذنب (dhanb)\n  * Lisan / Ayn: Core meaning of \"tail\" or \"taking hold of a tail\"; extended to signify a sin as that which trails behind and follows a person.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin is that by which one is seized and held accountable; used metaphorically for a fault that clings to its perpetrator.\n  * Al-Zamakhshari (Asas): Literal: tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as that which trails the soul and must be severed through repentance.\n- Root: غفر (ghafara)\n  * Lisan / Ayn: Covering, veiling, protecting from defilement; a shield or helmet (المغفر).\n  * Al-Raghib (Mufradat): \"الغفران والمغفرة من الله هو أن يصون العبد من أن يمسه العذاب\" — divine forgiveness is God's protection of the servant from being touched by punishment.\n  * Al-Zamakhshari (Asas): Literal: to cover and protect. Metaphorical: God's \"covering\" of sins — not merely erasure, but active safeguarding of the sinner from consequence.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The frequent interposition of \"يا رب\" and vocative constructions between the subject and predicate in supplicatory sentences, as in \"اللهم اغفر لي,\" where the vocative particle governs the imperative verb's addressee, reflecting the grammatical permissibility of separation between governing and governed elements in invocational speech.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "5": [{"arabic": "اللهم إنك تسمع كلامي وترى مكاني وتعلم سري وعلانيتي ولا يخفى عليك شيء من أمري أنا البائس الفقير المستغيث المستجير الوجل المشفق المعترف بذنه أسألك مسألة المسكين وأبتهل إليك ابتهال المذنب الذليل وأدعوك دعاء الخائف الضرير دعاء من خضعت لك رقبته وفاضت لك عبرته وذل لك جسده ورغم لك أنفه اللهم لا تجعلني بدعائك رب شقيا وكن بي رءوفا رحيما يا خير المسئولين وأكرم المعطين إلهي من مدح لك نفسه فإني لائم نفسي إلهي أخرست المعاصي لساني فما لي وسيلة عن عمل ولا شفيع سوى الأمل إلهي إني أعلم أن ذنوبي لم تبق لي عندك جاها ولا للاعتذار و", "english": "On the Day of 'Arafah, the first thing with which one supplicates, let him say: There is no god but God alone, with no partner; His is the sovereignty and His is the praise; He gives life and causes death, and He is Living, He does not die; in His hand is all good, and He is over all things Omnipotent. O God, place in my heart a light, and in my hearing a light, and in my sight a light, and in my tongue a light. O God, expand for me my breast and make easy for me my affair. And let him say: O God, Lord of the praise, to You is the praise as You say, and better than what we say. To You is my prayer, my sacrifice, my living, and my dying; to You is my return, and to You is my recompense. O God, I seek refuge in You from the whisperings of the breast, the scattering of affairs, and the torment of the grave. O God, I seek refuge in You from the evil of what enters in the night, and from the evil of what enters in the day, and from the evil of what the winds bring, and from the evil of the calamities of time. O God, I seek refuge in You from the withdrawal of Your well-being, the suddenness of Your retribution, and all of Your wrath. O God, guide me with guidance, and forgive me in the Hereafter and the First. O Best of all sought goals, and Most Exalted of all that is alighted upon, and Most Generous of all who are asked — whatever is with You — grant me this evening the best of what You have given to any of Your creatures and pilgrims of Your Sacred House, O Most Merciful of the merciful. O God, O Raiser of degrees and Sender of blessings, O Originator of the earths and the heavens, voices have clamored to You in diverse languages, asking You their needs. And my need of You is that You not forget me in the abode of trial when the people of this world have forgotten me. O God, You hear my speech and see my place and know my secret and my public, and nothing of my affair is hidden from You. I am the wretched one, the poor one, the seeker of aid, the seeker of refuge, the fearful, the apprehensive, the confessor of his sin. I ask You with the asking of the destitute, and I supplicate to You with the supplication of the abased sinner, and I call upon You with the call of the fearful and distressed — the call of one whose neck has bowed to You, whose tears have flowed for You, whose body has humbled before You, and whose nose has been rubbed in the dust for You. O God, do not make me, by my supplication to You, O Lord, wretched, and be to me kind and merciful, O Best of those who are asked and Most Generous of those who give. My God, whoever has praised his own soul to You — for I am one who blames his own soul. My God, sins have silenced my tongue, so I have no means of intercession other than deeds, and no intercessor other than hope. My God, I know that my sins have left me no standing with You, nor any face for excuse — but You are the Most Generous of the generous. My God, if I am not worthy to attain Your mercy, then Your mercy is worthy to attain me, for Your mercy encompasses all things, and I am a thing. My God, though my sins be great, yet they are small beside Your pardon, so forgive them for me, O Generous One. My God, You are You, and I am I. I am the one who returns to sins, and You are the One who returns to forgiveness. My God, if You show mercy only to the people of obedience, then to whom shall the sinners flee? My God, I turned away from Your obedience deliberately, and I headed toward Your disobedience intentionally. Glory be to You — how great is Your proof against me, and how generous is Your pardon toward me! By the necessity of Your proof against me, and the severance of my excuse from You, and my poverty toward You, and Your richness from me — forgive me, O Best of those whom a caller has called, and Most Excellent of those whom a hope has hoped in. By the sanctity of Islam and by the covenant of Muhammad, may God bless him and grant him peace, I seek intercession with You, so forgive me all my sins, and turn me away from this standing place of mine with my needs fulfilled, and grant me what I have asked, and realize my hope in what I have wished. My God, I have called upon You with the supplication that You taught me, so do not deprive me of the hope that You made known to me. My God, what will You do this evening with a servant who confesses to You his sin, who is humble before You in his abasement, who is submissive in his offense, who pleads to You concerning his deed, who repents to You from his transgression, who seeks Your forgiveness for his wrong, who supplicates to You for pardon of him, who asks of You the success of his needs, who hopes in You at his standing place — despite the abundance of his sins? O Refuge of every living thing, and Protector of every believer — whoever does well, it is by Your mercy that he triumphs, and whoever errs, it is by his error that he perishes. O God, to You we have come forth, and in Your courtyard we have alighted, and You alone we hope, and what is with You we seek, and to Your beneficence we expose ourselves, and Your mercy we hope for, and from Your chastisement we are fearful, and to You with the heavy burdens of sins we have fled, and to Your Sacred House we have performed the pilgrimage. O You who owns the needs of those who ask, and knows the consciences of the silent — O You who has no lord with Him who is invoked, and no creator above Him who is feared, and no minister to whom one comes, and no chamberlain who is bribed — O You who increases not by the abundance of asking except in bounty and generosity, nor by the abundance of needs except in favor and beneficence. O God, You have made for every guest a hospitality, and we are Your guests, so make Your hospitality to us Paradise. O God, for every delegation there is a gift, and for every visitor there is an honor, and for every asker there is a giving, and for every one who hopes there is a reward, and for every seeker there is with You a recompense, and for every...", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 206", "section_title_en": "The Supplications of the Day of 'Arafah — Section 206", "section_index": 206, "anchors": "- Root: دعو (d-'-w)\n  * Lisan / Ayn: Core meaning: to call, summon, invoke; du'a is the act of calling upon God with humble petition.\n  * Al-Raghib (Mufradat): In theological usage, du'a is the essence of worship ('ibadah), the creature's acknowledgment of need (iftiqar) before the Creator, and a means of drawing near (taqarrub).\n  * Al-Zamakhshari (Asas): Literal (haqiqah): vocal calling. Metaphorical (majaz): the soul's inward turning to God, even without utterance.\n- Root: نور (n-w-r)\n  * Lisan / Ayn: Light; that by which one sees physically and, by extension, that by which the heart perceives truth.\n  * Al-Raghib (Mufradat): Light (nur) is of two kinds: sensory (hissi) and intellectual ('aqli). The prophetic prayer for light in heart, hearing, sight, and tongue seeks the illumination of all faculties for obedience and gnosis (ma'rifah).\n  * Al-Zamakhshari (Asas): Literal: physical luminosity. Metaphorical: guidance (huda) and clarity of perception in religious and moral matters.\n- Root: عفو ('-f-w)\n  * Lisan / Ayn: To pardon, to efface, to leave unpunished; to exceed in generosity.\n  * Al-Raghib (Mufradat): 'Afw is the erasure of sin and the lifting of its consequence; it is an attribute of God's mercy (rahmah) that supersedes His justice when the servant repents.\n  * Al-Zamakhshari (Asas): Literal: to obliterate a trace. Metaphorical: God's complete remission of sin, leaving no mark of accountability.\n- Root: رجا (r-j-w)\n  * Lisan / Ayn: Hope, expectation of good; the opposite of despair (ya's).\n  * Al-Raghib (Mufradat): Raja' is the heart's confident expectation of God's bounty, paired with fear (khawf); it is a station (maqam) of the sincere.\n  * Al-Zamakhshari (Asas): Literal: to await. Metaphorical: the soul's reliance on divine mercy despite unworthiness.\n- Sibawayh Rule: Rule of Conjunction and Apposition (al-'Atf wa al-Badal) — The repeated vocatives \"Ilahi\" (My God) and \"Allahumma\" (O God) function as independent invocations, each followed by coordinated clauses that build a cumulative structure of petition, confession, and praise, requiring faithful preservation of each unit without conflation.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Hajj'", "badge": "Du'a"}, {"arabic": "لا إله إلا الله الملك الحق المبين (6) الثامنة قوله بسم الله الذي لا يضر مع اسمه شيء في الأرض ولا في السماء وهو السميع العليم (7) التاسعة اللهم صل على محمد عبدك ونبيك ورسولك النبي الأمي وعلى آله وصحبه وسلم (8) العاشرة قوله أعوذ بالله السميع العليم من الشيطان الرجيم رب أعوذ بك من همزات الشياطين وأعوذ بك رب أن يحضرون (9) فهذه العشر كلمات إذا كرر كل واحدة عشر مرات حصل له مائة مرة فهو أفضل من أن يكرر ذكرا واحدا مائة مرة لأن لكل واحدة من هؤلاء الكلمات فضلا على حياله وللقلب بكل واحد نوع تنبه وتلذذ وللنفس في الانتقال من كلمة إلى كلمة نوع استراحة وأمن", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "كيف يعملون وامتحن بهم حبهم ليعلم صدقهم فيما يدعون وعرفهم أنه لا يخفى عليه شيء مما يسرون وما يعلنون وحذرهم أن يأخذهم بغتة وهم لا يشعرون فقال {ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون} والصلاة والسلام على محمد رسوله الذي يسير تحت لوائه النبيون وعلى آله وأصحابه الأئمة المهديين والسادة المرضيين صلاة يوازي عددها عدد ما كان من خلق الله وما سيكون ويحظى ببركتها الأولون والآخرون وسلم تسليما كثيرا أما بعد فإن الغضب شعلة نار اقتبست من نار الله الموقدة التي تطلع على الأفئدة وإنها لمستكنة", "english": "In the name of God, the Most Merciful, the Most Compassionate. Praise be to God, upon whose pardon and mercy none rely except the hopeful, and from whose evil wrath and assault none fear except the fearful — He who gradually seizes His servants from whence they know not, and who has given dominion over them to their lusts, commanding them to abandon what they desire, and who has tried them with anger while charging them to swallow their rage in what provokes them. Then He surrounded them with hardships and pleasures, and granted them respite to see how they would act. He tested their love through them, to make known the truth of what they claim. He made known to them that nothing is hidden from Him of what they conceal or proclaim, and warned them lest He seize them suddenly while they are unaware. For He said: {«They await but a single blast which will seize them while they are disputing; so they will not be able to make a bequest, nor to their families will they return»} (Q. 36:49-50). And prayers and peace be upon Muhammad, His Messenger, beneath whose banner the prophets walk, and upon his family and companions — the rightly-guided imams and the pleasing masters — prayers whose number equals the number of what has been of God's creation and what will be, and by whose blessing the first and the last are favored — and abundant peace.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 700", "section_title_en": "The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences", "section_index": 700, "anchors": "- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "7": [{"arabic": "علما وهذه أمور لا يعلم تأويلها إلا الله والراسخون في العلم وعبر ابن عباس رضي الله عنهما عن اختصاص الراسخين في العلم بعلوم لا تحتملها أفهام الخلق حيث قرأ قوله تعالى {يتنزل الأمر بينهن} فقال لو ذكرت ما أعرفه من معنى هذه الآية لرجمتموني وفي لفظ آخر لقلتم إنه كافر ولنقتصر على هذا القدر فقد خرج عنان الكلام عن قبضة الاختيار وامتزج بعلم المعاملة ما ليس منه فلنرجع إلى مقاصد الشكر فنقول إذا رجع حقيقة الشكر إلى كون العبد مستعملا في إتمام حكمة الله تعالى فأشكر العباد أحبهم إلى الله وأقربهم إليه وأقربهم إلى الله", "english": "Thus was the beginning of this matter and its end. And do not understand it unless you are worthy of it. And if you are worthy of it, the eye is opened and you see, so you have no need of a leader to lead you. The blind man can indeed be led, but only to a limit. For when the path narrows and becomes sharper than a sword and finer than a hair, the bird is able to fly over it but is not able to drag a blind man behind it. And when the field becomes narrow and subtle — subtle as water, for example — and crossing is possible only by swimming, then the one skilled in the art of swimming may be able to cross by himself, and perhaps he is not able to drag another behind him. These matters bear the same relation to walking upon the way of the common masses of creatures as walking upon water bears to walking upon earth. Swimming can be learned; but as for walking upon water, it is not acquired by instruction, but rather is attained through the strength of certainty (yaqīn). For this reason it was said to the Prophet, peace be upon him, that Jesus, peace be upon him, was said to have walked upon water, and he, peace be upon him, said: \"Had his certainty increased, he would have walked upon the air.\" {«حديث قيل له يقال إن عيسى مشى على الماء قال لو ازداد يقينا لمشي على الهواء»} — This hadith is rejected (munkar) and is not known in this form. What is known is what Ibn Abi al-Dunya narrated in the Book of Certainty from the saying of Bakr ibn Abd Allah al-Muzani, who said: The disciples lost their Prophet, and it was said to them: \"He has headed toward the sea.\" So they set out seeking him, and when they reached the sea, behold, he was coming toward them walking upon the water. And he mentioned a hadith in which Jesus said: \"If the son of Adam had a hair's breadth of certainty, he would walk upon the water.\" And Abu Mansur al-Daylami narrated in the Musnad al-Firdaws with a weak chain from the hadith of Muadh ibn Jabal: \"If you knew God with true knowledge, you would walk upon the seas, and the mountains would be removed by your supplications.\" These are symbols and allusions to the meaning of aversion (karāhah) and love (maḥabbah), and good pleasure (riḍā) and wrath (ghaḍab), and gratitude (shukr) and ingratitude (kufrān) — more than this is not fitting for the science of practical conduct (ʿilm al-muʿāmalah). And God, exalted be He, struck an example of this to draw it near to the understanding of creatures, since He knew that He created the jinn and mankind only to worship Him, and their worship was the ultimate purpose of wisdom (ghāyat al-ḥikmah) with respect to them. Then He informed that He has two servants: one whom He loves, whose name is Gabriel — the Holy Spirit and the Trustworthy One — and he is with Him beloved, obeyed, trustworthy, and honored; and another whom He hates, whose name is Iblis — the accursed one, reprieved until the Day of Judgment. Then He delegated guidance (irshād) to Gabriel, saying, the Exalted: {«قل نزله روح القدس من ربك بالحق»} \"Say: The Holy Spirit has brought it down from your Lord with truth\" (16:102), and said, the Exalted: {«يلقي الروح من أمره على من يشاء من عباده»} \"He casts the Spirit of His command upon whom He wills of His servants\" (40:15). And He delegated misguidance (ighwāʾ) to Iblis, saying, the Exalted: {«ليضل عن سبيله»} \"That he may lead astray from His path\" (4:119). And ighwāʾ is the halting of servants short of attaining the ultimate purpose of wisdom. So observe how He attributed it to the servant with whom He was wrathful; and guidance (irshād) is the conduct of them toward the ultimate purpose — so observe how He attributed it to the servant whom He loves. And you have an example of this in custom: when a king is in need of one to give him drink and one to cup him and to clean the courtyard of his house of filth, and he has two servants, he does not appoint for cupping and cleaning except the ugliest and meanest of them, and he does not entrust the carrying of drink and perfume except to the best and most complete of them and the most beloved to him. And you should not say: \"This is my act, and his act was not without my act\" — for you have erred when you attributed that to yourself. Rather, He is the One who directed your motive (dāʿiyah) to the specification of the disliked act to the disliked person, and the beloved act to the beloved person, as a completion of justice (ʿadl). For His justice is sometimes completed through matters in which you have no entry, and sometimes it is completed in you — for you also are among His acts. So your motive, your power, your knowledge, your action, and all the other causes of your movements in expression — all of this is His act, which He arranged with justice in an arrangement from which moderate acts issue forth. Except that you see only yourself, and so you suppose that what appears through you in the world of witness (ʿālam al-shahādah) has no cause from the world of the unseen and the dominion (ʿālam al-ghayb wa al-malakūt). Therefore you attribute it to yourself. And you are only like the child who looks at night at the play of the juggler (mushʿabadh) who brings forth figures from behind a curtain that dance and scream and rise and sit, composed of rags that do not move by themselves — rather, they are moved by fine hair-like threads that do not appear in the darkness of night, their ends in the hand of the juggler, who is hidden from the eyes of the children. So they rejoice and marvel, supposing that those rags dance and play and rise and sit. As for the intelligent ones, they know that this is a moving (taḥrīk) and not a self-movement, but perhaps they do not know its detailed modality. And the one who knows some of its detail does not know it as the juggler knows it, to whom the command belongs and in whose hand is the pulling. Likewise, the children of the people of this world — and all creatures are children relative to the scholars — look at these persons (ashkhāṣ) and suppose that they are the movers, and so they attribute [action] to them. And the scholars know that they are moved, except that they do not know the modality of the moving — and they are the majority. Except the knowers (ʿārifūn), the scholars, and those firmly rooted in knowledge (al-rāsikhūn), for they have perceived, with the sharpness of their sight, fine spider-web threads — nay, much finer than these — suspended from heaven, their ends attached to the persons of the people of the earth. Those threads are not perceived, due to their fineness, by these outward eyes. Then they witnessed the heads of those threads in their suspension-points (manāṭāt) to which they are attached, and they witnessed for those suspension-points handles (maqābiḍ) that are in the hands of the angels who move the heavens. And they also witnessed the angels of the heavens directed toward the bearers of the Throne (ḥamalat al-ʿarsh), awaiting what descends upon them of the command from the presence of Lordship (ḥaḍrat al-rubūbiyyah) — \"they do not disobey God in what He commands them, and they do what they are commanded\" (66:6). And He expressed these witnessed realities in the Qur'an, and it was said: {«وفي السماء رزقكم وما توعدون»} \"And in the heaven is your provision and what you are promised\" (51:22). And He expressed the waiting of the angels of the heavens for what descends upon them of decree and command, and it was said: \"He created seven heavens and of the earth the like of them; {«يتنزل الأمر بينهن لتعلموا أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما»} 'the command descends between them, that you may know that God is powerful over all things and that God encompasses all things in knowledge'\" (65:12). These are matters whose interpretation (taʾwīl) none knows except God and those firmly rooted in knowledge (al-rāsikhūn fī al-ʿilm). And Ibn Abbas, may God be pleased with them both, expressed the exclusivity of those firmly rooted in knowledge to sciences that the understandings of creatures cannot bear, when he recited the saying of the Exalted: {«يتنزل الأمر بينهن»} \"The command descends between them,\" and said: \"Were I to mention what I know of the meaning of this verse, you would stone me\" — and in another wording: \"You would say he is an unbeliever.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 990", "section_title_en": "On the Degrees of Proximity to God and the Hierarchy of Those Who Perfect Divine Wisdom", "section_index": 990, "anchors": "- Root: سير (s-y-r)\n  * Lisan / Ayn: \"السير: الذهاب والسفر، وسار يسير سيرا ومسيرا، والسيارة: الرفقة المسافرة\"\n  * Al-Raghib (Mufradat): \"السير: الانتقال من مكان إلى مكان، ويستعار للسلوك في الدين والطريقة\"\n  * Al-Zamakhshari (Asas): [Literal] \"سار القوم: مشوا\" — [Metaphorical] \"سار فيه السير: مضى في الأمر، وسار ذكره: انتشر، ومنه: سيرة فلان: طريقته\"\n- Root: مشي (m-sh-y)\n  * Lisan / Ayn: \"المشي: تردد الأركان على الأرض، والماشية: الإبل والغنم لانتقالها في المرعى\"\n  * Al-Raghib (Mufradat): \"المشي: الانتقال من مكان إلى مكان بإرادة، ويكنى به عن النميمة، وعن شرب المسهل\"\n  * Al-Zamakhshari (Asas): [Literal] \"مشيت وتمشيت، وهي حسنة المشية\" — [Metaphorical] \"مشى بطنه، وأمشاه الدواء، واستمشيت بالدواء، ومنه: مشت المرأة: كثرت أولادها\"\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: \"الخلق: التقدير، والخلق: الناس، والخليقة: الطبيعة، والخلق: السجية\"\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\"\n  * Al-Zamakhshari (Asas): [Literal] \"خلق الخراز الأديم: قدره قبل القطع\" — [Metaphorical] \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\"\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: \"النفس: الروح، والذات، والشيء النفيس\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتطلق على الذات، قال تعالى: {ويحذركم الله نفسه} فنفسه: ذاته\"\n  * Al-Zamakhshari (Asas): [Literal] \"شيء نفيس ومنفس\" — [Metaphorical] \"دفق نفسه أي دمه، وأصابته نفس: عين\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish exclusive attribution of actions to God versus creatures, as in \"إنما أنت مثل الصبي\" (You are only like a child), restricting the simile to the creature while preserving divine agency.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "الذين في قلوبهم زيغ} الآية هم أهل الجدل الذين عناهم الله بقوله تعالى فاحذرهم (2) وقال بعض السلف يكون في آخر الزمان قوم يغلق عليهم باب العمل ويفتح لهم باب الجدل وفي بعض الأخبار إنكم في زمان ألهمتم فيه العمل وسيأتي قوم يلهمون الجدل (3) وفي الخبر المشهور أبغض الخلق إلى الله تعالى الألد الخصم (4) وفي الخبر ما أتى قوم المنطق إلا منعوا العمل (5) والله أعلم", "english": "This speech, perhaps, when heard from its speaker, prompts the saying: \"People are enemies of what they do not know.\" So do not think that [of me] — for you have fallen upon one who is an expert (khabīr). Accept this counsel from one who wasted his life upon it for a time, and exceeded the earlier ones in composing, verifying, disputing, and elucidating — then God inspired him with his right course and showed him its defect, so he abandoned it and occupied himself with his own soul. Let not the saying of him who says, \"The legal opinion (al-fatwā) is the pillar of the Sacred Law, and its rationales (ʿilal) are not known except through the science of disputation (ʿilm al-khilāf),\" deceive you. For the rationales of the [established] school (al-madhhab) are mentioned within the school itself; and what is added upon them are disputations that the earlier ones — nor even the Companions — ever knew, and they were more knowledgeable of the rationales of legal opinions than others. Rather, these [disputations], besides being useless for the science of the school, are harmful and corrupting of the very taste (dhawq) of jurisprudence. For that which the intuition (hads) of the muftī testifies to — when his taste in jurisprudence is sound — cannot, in most cases, be made to conform to the conditions of formal disputation (shurūṭ al-jadal). Whoever accustoms his nature to the formalities of disputation, his mind submits to the requirements of disputation and shrinks from submitting to the taste of jurisprudence.", "book_title": "Book of Knowledge", "section_title_ar": "Section 34", "section_title_en": "On the Soul — A Warning Against the Newly-Invented Disputations (Section 34)", "section_index": 34, "anchors": "- Root: جدل (j-d-l)\n  * Lisan / Ayn: To twist or braid a rope tightly; to throw someone down upon hard ground (al-jadālah).\n  * Al-Raghib (Mufradat): Disputation (jadal) is a mutual exchange aimed at overcoming and prevailing — as if each disputant twists the other away from his opinion; from jadala al-ḥabl, to braid tightly.\n  * Al-Zamakhshari (Asas): Literal: twisting/braiding; Metaphorical: a woman \"majdūlah al-khalq\" (well-knit in frame), and \"disputation\" as a wrestling-down of the opponent's view.\n- Root: خبر (kh-b-r)\n  * Lisan / Ayn: Knowledge of a thing; to be acquainted with the inner state of an affair.\n  * Al-Raghib (Mufradat): Khabar is knowledge of things via report; khibrah is knowledge of the inner realities of a matter.\n  * Al-Zamakhshari (Asas): Literal: to test/try a man; Metaphorical: \"his mirror reports of his unknown state\" — knowledge of hidden conditions.\n- Root: وفي (w-f-y)\n  * Lisan / Ayn: To fulfill completely, to reach full measure.\n  * Al-Raghib (Mufradat): Al-Wāfī: one who has reached completion; awfā bi-ʿahdihi: to fulfill one's covenant entirely.\n  * Al-Zamakhshari (Asas): Literal: full-weight coin, full measure; Metaphorical: awfā ʿalā al-miʾah — to exceed a hundred; tawaffāhu Allāh — God takes in full.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: A mark/trace by which a thing is known; knowledge as the apprehension of a thing's reality.\n  * Al-Raghib (Mufradat): ʿIlm is the apprehension of a thing in its true reality — either grasping its essence or judging its existence/non-existence.\n  * Al-Zamakhshari (Asas): Literal: to perceive/know; Metaphorical: \"he is among the lofty banners (aʿlām) of knowledge\" — a distinguished signpost of learning.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa-l-taqyīd bi-innamā) — used to confine the blame of disputation to those who seek fame, and to restrict true benefit to sincere works.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "فنسأل الله تعالى أن يجعلنا من الراسخين في العلم القائلين آمنا به كل من عند ربنا وما يذكر إلا أولو الألباب الشطر الثاني من الكتاب في الزهد وفيه بيان حقيقة الزهد و بيان فضيلة الزهد وبيان درجات الزهد وأقسامه وبيان تفصيل الزهد في المطعم والملبس والمسكن والأثاث وضروب المعيشة وبيان علامة الزهد", "english": "And it was as though he thereby gestured to his saying, peace be upon him: \"The hand of the giver is the upper hand\" {«يَدُ الْمُعْطِي هِيَ الْعُلْيَا»}. So one of them said: \"The hand of the giver is the hand of the one who takes the money — for he is the one who gives the reward, and the capacity (al-qadr) belongs to him, not to what he takes.\"", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1086", "section_title_en": "The Second Part of the Book on Asceticism (Al-Zuhd) — Its Reality, Virtue, Degrees, and Signs", "section_index": 1086, "anchors": "- Root: زهد (Z-H-D)\n  * Lisan / Ayn: Core meaning of scarcity, paucity, and abstemiousness; al-zahd as \"estimation\" (al-hazr), e.g., estimating fruit yield.\n  * Al-Raghib (Mufradat): \"Al-zahīd: the thing that is little; the ascetic in a thing is one who turns away from it and is content with little of it.\" Quranic anchor: {وَكَانُوا فِيهِ مِنَ الزَّاهِدِينَ} [Yusuf/20].\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"Zahida fī al-shay': he turned away from it.\" Majaz (metaphorical): \"Wādin zahīd: a valley that takes little water; rajul zahīd: a man of little good; ʿaynun zahīdah: an eye content with little.\"\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: Turning and revolving a thing from one face to another; the heart as that which is perpetually turning between states.\n  * Al-Raghib (Mufradat): \"Qalb al-shay': to turn it about and divert it from one face to another... The heart is so named for its constant fluctuation.\"\n  * Al-Zamakhshari (Asas): Haqiqah: physical overturning. Majaz: \"Qallaba al-amr: to scrutinize and investigate affairs thoroughly\" — as here, hearts \"witnessing\" one another.\n- Root: يقن (Y-Q-N)\n  * Lisan / Ayn: Certainty as settled knowledge; al-yaqīn is a quality of knowledge above mere cognition (maʿrifah).\n  * Al-Raghib (Mufradat): \"Al-yaqīn is a description of knowledge above maʿrifah and dirāyah... It is the stillness of understanding with the firmness of judgment.\" Quranic grades: {عِلْمَ الْيَقِينِ} [Takathur/5], {عَيْنَ الْيَقِينِ} [Takathur/7], {حَقَّ الْيَقِينِ} [Waqiʿah/95].\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما سألهم ليثيبهم\" restricts the purpose of asking to divine recompense alone, negating any worldly motive.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "9": [{"arabic": "ولميله إليه وغير محبب إليه فهل يكون في زمرة المرائين فاعلم أن الله لم يكلف العباد إلا ما تطيق وليس في طاقة العبد منع الشيطان عن نزغاته ولا قمع الطبع حتى لا يميل إلى الشهوات ولا ينزع إليها وإنما غايته أن يقابل شهوته بكراهة استثمارها من معرفة العواقب وعلم الدين وأصول الإيمان بالله واليوم الآخر فإذا فعل ذلك فهو الغاية في أداء ما كلف به ويدل على ذلك من الأخبار ما روي أن أصحاب رسول الله صلى الله عليه وسلم شكوا إليه وقالوا تعرض لقلوبنا أشياء لأن تخر من السماء فتخطفنا الطير أو تهوي بنا الريح في مكان سحيق أحب إلينا من أن نتكلم ب", "english": "If you say: \"Whoever finds in himself a dislike of ostentation (riyā'), and this dislike compels him to refuse it, yet he is not entirely free from the soul's inclination toward it, its love for it, and its striving after it — except that he dislikes his own love and his own inclination, and it is not beloved to him — is he then among the ranks of the ostentatious?\" — Know that God has not burdened His servants except with what they can bear. It is not within the servant's power to prevent the Devil from his incitements (nazaghāt), nor to suppress nature entirely so that it neither inclines to lusts nor strives after them. His utmost limit is only that he confront his lust with a dislike born of his knowledge of consequences, his understanding of religion, and his roots of faith in God and the Last Day. When he does this, he has reached the utmost limit of performing what he has been charged with.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 829", "section_title_en": "On the Degrees of Resistance to Ostentation and the Devil's Wiles — Section 829", "section_index": 829, "anchors": "- Root: شيط (Shayṭ)\n  * Lisan / Ayn: Core meaning of burning, scorching, or spoiling by fire; the Devil as that which burns and destroys.\n  * Al-Raghib (Mufradat): الشيطان as the one who leads astray and incites; his \"نزغات\" (incitements) are his piercing stings of temptation.\n  * Al-Zamakhshari (Asas): Literal: \"شاط اللحم\" (meat scorched/ruined). Metaphorical: \"أشاط دمه\" (shed his blood vainly) — the Devil's aim is to ruin the soul's deeds.\n- Root: كره (K-R-H)\n  * Lisan / Ayn: Dislike, aversion, abhorrence; the opposite of love (ḥubb) and desire (mīl).\n  * Al-Raghib (Mufradat): The moral faculty of repulsion against sin; a trait of faith (īmān) distinguishing the believer's higher self from the lower nature.\n  * Al-Zamakhshari (Asas): Literal: \"كرهت الشيء\" (I disliked it). Metaphorical: The heart's rejection of the soul's base inclinations as an act of worship.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; the seat of desires and passions.\n  * Al-Raghib (Mufradat): النفس as the lower commanding soul (النفس الأمارة) that inclines to lusts, distinct from the intellect (عقل) and faith.\n  * Al-Zamakhshari (Asas): Literal: \"نفس سائلة\" (flowing blood/life). Metaphorical: The inner self that must be opposed when it inclines to ostentation.\n- Root: جهد (J-H-D) / مجادلة (Jadal)\n  * Lisan / Ayn: Striving, exertion, argumentation; from جدل (twisting ropes tightly).\n  * Al-Raghib (Mufradat): المجادلة as disputation that can distract from divine remembrance (ذكر الله).\n  * Al-Zamakhshari (Asas): Literal: \"جادله\" (he argued with him). Metaphorical: The soul's engagement with the Devil's whispers as a subtle trap, diverting from sincere worship.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the four ranks of resistance, each defined by what it exclusively does or omits.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}], "13": [{"arabic": "لما رأيت ابني يتعثر لم أملك نفسي أن أخذته ففي ذلك عبرة لأولي الأبصار فالرجل كل الرجل من يصبر على العافية ومعنى الصبر عليها أن لا يركن إليها ويعلم أن كل ذلك مستودع عنده وعسى أن يسترجع على القرب وأن لا يرسل نفسه في الفرح بها ولا ينهمك في التنعم واللذة واللهو واللعب وأن يرعى حقوق الله في ماله بالإنفاق وفي بدنه ببذل المعونة للخلق وفي لسانه ببذل الصدق وكذلك في سائر ما أنعم الله به عليه وهذا الصبر متصل بالشكر فلا يتم إلا بالقيام بحق الشكر كما سيأتي وإنما كان الصبر على السراء أشد لأنه مقرون بالقدرة ومن العص", "english": "The first kind is that which accords with caprice (al-hawā) — namely, sound health and well-being, wealth and status, the abundance of kinsfolk, the expanse of means, the multitude of followers and helpers, and all the pleasures of this world. How greatly the servant stands in need of patience over these very things! For if he does not restrain his soul (nafsahu) from letting loose toward them, from reposing in them, and from plunging into their permissible pleasures, that drives him to insolence (al-baṭar) and transgression (al-ṭughyān) — for indeed {verily man doth transgress when he sees himself self-sufficient} {«إن الإنسان ليطغى أن رآه استغنى»}. Hence one of the knowers of God (al-ʿārifīn) said: \"Affliction — the believer can bear it; but well-being — none bears it save the veracious (al-ṣiddīq).\" And Sahl said: \"Patience over well-being is more severe than patience over affliction.\" When the doors of this world were opened upon the Companions — may God be well pleased with them — they said: \"We were tried with the trial of adversity (fitnat al-ḍarrāʾ) and we bore it patiently; and we were tried with the trial of prosperity (fitnat al-sarrāʾ) and we did not bear it patiently.\" For this reason God — mighty and majestic — warned His servants against the trial of wealth, spouse, and child, saying — exalted is He: {O you who believe! Let not your wealth nor your children divert you from the remembrance of God} {«يا أيها الذين آمنوا لا تلهكم أموالكم ولا أولادكم عن ذكر الله»}. And He said — mighty and majestic: {Indeed, among your spouses and your children there is an enemy unto you, so beware of them} {«إن من أزواجكم وأولادكم عدوا لكم فاحذروهم»}. And the Prophet — peace be upon him — said: \"The child is a cause of miserliness (mubakhkhilah), a cause of cowardice (mujabinah), a cause of grief (muḥzinah).\" When he — peace be upon him — looked upon his son al-Ḥasan — may God be well pleased with him — stumbling in his shirt, he descended from the pulpit and embraced him, then said: {God has spoken truly} {«صدق الله»} — {Indeed, your wealth and your children are a trial} {«إنما أموالكم وأولادكم فتنة»} — \"When I saw my son stumbling, I could not control myself (lam amlik nafsī) from taking him up.\" In that is a lesson for those of insight. So the man — the complete man — is he who bears patience over well-being. And the meaning of patience over it is that he does not repose in it, and knows that all of it is but a trust (mustawdaʿ) deposited with him, that it may well be reclaimed at any near moment; and that he does not release his soul to rejoice in it, nor plunge into comfort, pleasure, play, and amusement; and that he observes the rights of God in his wealth by spending, in his body by expending aid to creation, in his tongue by expending truthfulness (al-ṣidq) — and likewise in all the rest of what God has bestowed upon him.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 963", "section_title_en": "On Patience in Prosperity and Adversity — Section 963", "section_index": 963, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and holding back; al-Farahidi notes \"صبر على قليه\" (endurance upon hardship).\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق... حبس النفس على ما يقتضيه العقل والشرع، أو عما يقتضيان حبسها عنه\" — Patience is the soul's restraint upon what reason and Law require, or from what they require restraining it; its names vary by context (shajāʿah in battle, etc.).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — patience over the disliked and patience away from the beloved. Metaphorical (majāz): \"هو أصبر على الضرب من الأرض\" — extreme endurance likened to earth's impassivity.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which one guards and restrains.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" and in divine attribution, \"نفسه: ذاته\" — the self as the locus of volition and desire.\n  * Al-Zamakhshari (Asas): Literal: \"نفس\" as the animate self; metaphorical: \"دفق نفسه أي دمه\" — extended to blood/life.\n- Root: ولد (w-l-d)\n  * Lisan / Ayn: Offspring, child; al-Farahidi notes singular/plural usage.\n  * Al-Raghib (Mufradat): \"الولد: المولود. يقال للواحد والجمع والصغير والكبير\" — child, born one, applied to one or many, young or old.\n  * Al-Zamakhshari (Asas): Literal: biological progeny; metaphorical (majāz): \"ولدوا حديثا وكلاما: استحدثوه\" — newly invented speech; here, children as a trial.\n- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness; al-Farahidi links it to earnestness in word and deed.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood originate in speech, but extend to action and intention.\n  * Al-Zamakhshari (Asas): Literal: truthful speech; metaphorical: \"رجل صادق الحملة\" — one whose charge in battle is true/earnest.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate exclusively to the subject, as in the prophetic citation {إنما أموالكم وأولادكم فتنة}, affirming trial as the sole designated function of wealth and children.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "14": [{"arabic": "بالقناطير المقنطرة من الذهب والفضة والخيل المسومة والأنعام والحرث والغلمان والجواري والخيول والمواشي والقصور والدور ورفيع الثياب ولذائذ الأطعمة فحظ العبد من هذا كله هي الدنيا المذمومة وفيما يعد فضولا أوفى محل الحاجة نظر طويل إذ روي عن عمر رضي الله عنه أنه استعمل أبا الدرداء على حمص فاتخذ كنيفا أنفق عليه درهمين فكتب إليه عمر من عمر بن الخطاب أمير المؤمنين إلى عويمر قد كان لك في بناء فارس والروم ما تكتفي به عن عمران الدنيا حين أراد الله خرابها فإذا أتاك كتابي هذا فقد سيرتك إلى دمشق أنت وأهلك فلم يزل بها حتى م", "english": "Yet when we mention the blameworthy world, we do not count this as part of the world at all. Rather, we say it belongs to the Hereafter. Likewise, the worshipper (al-ʿābid) may grow familiar with his worship and find pleasure in it, such that if he were prevented from it, that would be the greatest of punishments upon him. Indeed, one of them said: \"I do not fear death except because it intervenes between me and the night prayer (qiyām al-layl).\" Another used to say: \"O God, provide me with the strength of prayer, bowing, and prostration in the grave.\" For such a one, prayer has become among his immediate shares. And every immediate share — the name \"world\" (al-dunyā) applies to it by way of derivation (ishtiqāq) from al-dunūw (nearness). But we do not mean by the blameworthy world that [kind of share]. For the Prophet (peace be upon him) said: \"Made beloved to me from your world are three: women, perfume, and the coolness of my eye in prayer.\" {«حبب إلي من دنياكم ثلاث النساء والطيب وقرة عيني في الصلاة»} He thus made prayer part of the pleasures of the world. Likewise, everything that enters into sense perception (al-ḥiss) and direct witnessing (al-mushāhadah) belongs to the world of testimony (ʿālam al-shahādah), and that is part of the world. The delight in moving the bodily members in bowing and prostration occurs only in this world — therefore he attributed it to the world. Yet we, in this book, do not address ourselves except to the blameworthy world, and we say: this is not part of the world [in that blameworthy sense].", "book_title": "Condemnation of the World", "section_title_ar": "Section 741", "section_title_en": "Exposition of the Reality of This World (al-Dunyā) and Its True Nature with Respect to the Servant", "section_index": 741, "anchors": "- Root: د ن و (D-N-W)\n  * Lisan / Ayn: Proximity, nearness; the nearer of two things. Al-Farahidi: \"دنا فهو دان\" — to be near, to draw close.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — nearness in essence or by judgment. The world is called dunyā because it is the nearer of the two abodes, preceding death.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) derivation from al-dunūw (nearness). The term applies to every immediate, proximate share (ḥaẓẓ ʿājil) — not restricted to material possessions.\n- Root: ع م ل (ʿ-A-M-L)\n  * Lisan / Ayn: Deed, action, labor. The root denotes purposeful exertion.\n  * Al-Raghib (Mufradat): Action is of two kinds: of the heart and of the limbs. The action that accompanies one to the Hereafter is the sincere worship of God.\n  * Al-Zamakhshari (Asas): Literal: physical exertion. Metaphorical (majāz): the inward deed of the heart — sincerity (ikhlāṣ).\n- Root: ع ب د (ʿ-B-D)\n  * Lisan / Ayn: Servitude, worship, humble obedience.\n  * Al-Raghib (Mufradat): al-ʿIbādah is the utmost humility before God combined with love of Him. It is the action that yields fruit in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: humility and lowliness. Sacred usage: the ritual worship (ṣalāh, etc.) performed purely for God's face.\n- Sibawayh Rule: Restriction and specification (al-ḥaṣr wa al-taqyīd) — distinguishing the generic term (al-ism al-ʿāmm) from its specified referents (musammayāt), and the semantic restriction of \"dunyā\" to the blameworthy portion only.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of the World'", "badge": "Du'a"}, {"arabic": "تعالى زين للناس حب الشهوات من النساء والبنين والقناطير المقنطرة من الذهب والفضة والخيل المسومة والأنعام والحرث ذلك متاع الحياة الدنيا فقد عرفت أن كل ما هو لله فليس من الدنيا وقدر ضرورة القوت وما لا بد منه من مسكن وملبس هو لله إن قصد به وجه الله والاستكثار منه تنعم وهو لغير الله وبين التنعم والضرورة درجة يعبر عنها بالحاجة ولها طرفان وواسطة طرف يقرب من حد الضرورة فلا يضر فإن الاقتصار على حد الضرورة غير ممكن وطرف يزاحم جانب التنعم ويقرب منه وينبغي أن يحذر منه وبينهما وسائط متشابهة ومن حام حول الحمى يوشك أن يقع فيه والحزم في الحذر والتقوى والتقرب من حد الضرورة ما أمكن اقتداء بالأنبياء و", "english": "And the gatherings of passion are five matters, which are what Allah, the Exalted, has gathered in His saying: {إنما الحياة الدنيا لعب ولهو وزينة وتفاخر بينكم وتكاثر في الأموال والأولاد} — \"The life of this world is but play and diversion and adornment and boasting among yourselves and increase in wealth and children\" (57:20). And the corporeal entities (al-aʿyān) from which these five are obtained are seven, gathered by His saying, the Exalted: {زين للناس حب الشهوات من النساء والبنين والقناطير المقنطرة من الذهب والفضة والخيل المسومة والأنعام والحرث ذلك متاع الحياة الدنيا} — \"Adorned for mankind is the love of desires — of women and sons and heaped-up treasures of gold and silver and branded horses and cattle and tillage. That is the enjoyment of the life of this world\" (3:14).", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 744", "section_title_en": "The Discipline of the Soul and the Restraint of the Passions — The Life of Uways al-Qarani and the True Boundary of the Worldly Life", "section_index": 744, "anchors": "- Root: ن-ه-ي (N-H-Y)\n  * Lisan / Ayn: \"نهاه عنه نهياً: كفّه وردّه عنه. والنهي: خلاف الأمر.\"\n  * Al-Raghib (Mufradat): \"النهي: الزجر عن الشيء، ويستعمل في الكفّ عن الفعل. قال تعالى: {ونهى النفس عن الهوى} — أي: كفّها وزجرها عن متابعة الشهوات.\"\n  * Al-Zamakhshari (Asas): \"نهاه عن كذا: كفّه. ومنه: انتهى عن الأمر إذا كفّ نفسه. والتناهي: التوقف عند الحد.\"\n- Root: ه-و-ي (H-W-Y)\n  * Lisan / Ayn: \"الهوى: ميل النفس إلى الشهوة. وهويته: أحببته. والهوى: ما تهواه النفس وتنزع إليه من غير هدى.\"\n  * Al-Raghib (Mufradat): \"الهوى: ميل النفس إلى ما تشتهيه، ويذمّ إذا لم يكن بعقل وشرع. قال تعالى: {أفرأيت من اتخذ إلهه هواه}.\"\n  * Al-Zamakhshari (Asas): \"هويته: أحببته. وهوًى: سقط. والهوى: اسم لما تهواه النفس من غير رشد. وقد غلب في الشرع على الميل المذموم.\"\n- Root: د-ن-و (D-N-W)\n  * Lisan / Ayn: \"دنا يدنو دنواً: قرب. والدنيا: نقيض الآخرة، سميت بذلك لدنوّها وتقدّمها.\"\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات أو بالحكم. والدنيا: الحياة العاجلة، سميت دنيا لدنوّها من الإنسان أو لتأخر الآخرة عنها.\"\n  * Al-Zamakhshari (Asas): \"الدنيا: الحاضرة العاجلة. وتقول: هو من أهل الدنيا إذا كان مقبلاً على شهواتها.\"\n- Root: ن-ف-س (N-F-S)\n  * Lisan / Ayn: \"النفس: الروح، والذات. ونفس الشيء: عينه. والنفس: الدم. والنفيس: الثمين.\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتستعمل للذات. قال تعالى: {ويحذركم الله نفسه} أي: ذاته. وقد تكون النفس بمعنى الهوى والشهوة.\"\n  * Al-Zamakhshari (Asas): \"نفس الشيء: عينه وذاته. وأنفس الشيء: صار نفيساً. ومن المجاز: نفس عن كذا أي: فرّج عنه.\"\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — The periodic structure allows for extended parenthetical insertions between the subject and its predicate, as in the long narrative sequences here, where the subject (أويس) is introduced and its predicate follows after extensive descriptive clauses.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "18": [{"arabic": "شواهدها من القرآن قوله عز وجل شهد الله أنه لا إله إلا هو والملائكة وأولو العلم قائما بالقسط فانظر", "english": "That I have seen the desire of the students of knowledge to be sincere concerning jurisprudence (fiqh) — that [jurisprudence] which has become serviceable for those who fear not God (glorified and exalted be He), who arm themselves with it for vainglory and for seeking advantage through its prestige and station in rivalries. It is arranged in four quarters (arbāʿ). And one who clothes himself in the garb of the Beloved is beloved. So I did not deem it far-fetched that fashioning this book in the form of jurisprudence might be a gentle stratagem (talṭuf) for drawing hearts along by degrees. For this reason, one who sought to incline the hearts of princes to medicine gently devised it by setting it in the form of an astronomical almanac, arranged in tables and figures, and named it \"The Almanac of Health\" (taqwīm al-ṣiḥḥah) — so that their familiarity with that genre might draw them to perusal. And gentleness in drawing hearts to the knowledge that yields the life of eternity is more important than gentleness in drawing them to medicine, which yields only the health of the body. For the fruit of this knowledge is the healing of hearts and spirits, by which one attains to a life that endures for ever and ever (abad al-ābād). Where, then, is medicine — which treats bodies that are, by necessity, exposed to corruption in the nearest of times — in comparison to it?", "book_title": "Book of Knowledge", "section_title_ar": "Section 3", "section_title_en": "The Book of Knowledge — Chapter One: On the Excellence of Knowledge, Teaching, and Learning", "section_index": 3, "anchors": "- Root: كشف (kashafa)\n  * Lisan / Ayn: To unveil, disclose, remove a covering; كشف الغماء (removing distress); the uncovering of a thing from its covering.\n  * Al-Raghib (Mufradat): Al-Mukāshafah (unveiling) in the theological sense is the direct apprehension of the unseen realities (ghayb) — the disclosure of the meaning of a thing as it truly is, without the intermediary of sensory perception or discursive reasoning.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): removing a physical covering. Metaphorical (majāz): the soul's attainment of spiritual realities by the lifting of the veil of sensory distraction.\n- Root: عقل (ʿaql)\n  * Lisan / Ayn: The intellect; originally, the rope by which a camel is tethered (ʿiqāl) — that which restrains and holds back; hence, the faculty that restrains the soul from base desires.\n  * Al-Raghib (Mufradat): Al-ʿAql is that by which the rational soul (al-nafs al-nāṭiqah) apprehends the realities of things; it is the principle of discernment (tamyīz) and the ground of moral responsibility (taklīf).\n  * Al-Zamakhshari (Asas): Literal: the tethering of the camel. Metaphorical: the restraining of the soul from ignorance and passion; \"He is one who possesses ʿaql\" means he is restrained from error.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; the organ that fluctuates (yataqallab) between states; its very name derives from its constant turning over (taqlīb) of intentions and resolutions.\n  * Al-Raghib (Mufradat): The heart is that subtle divine reality (al-laṭīfah al-rabbāniyyah) which is the seat of understanding (fahm) and knowledge (ʿilm); it is called qalb because of its rapid fluctuation (taqallub) between states of perception and heedlessness.\n  * Al-Zamakhshari (Asas): Literal: the physical organ. Metaphorical: the spiritual faculty of cognition and moral discernment — \"the hearts of the knowers are the repositories of the secrets of God.\"\n- Sibawayh Rule: Rule of Specification (Takhṣīṣ) via Conditional Partitioning (Taqsīm)\n  * The author's division of knowledge into four parts follows the syntactic pattern of exhaustive binary partition (taqsīm thunāʾī), where each branch is specified by its defining predicate, yielding a complete and non-overlapping taxonomy — a structure Sibawayh recognizes as the rhetorical culmination of connected discourse (faṣl al-khiṭāb).", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Book of Knowledge'", "badge": "Du'a"}], "21": [{"arabic": "وإنا إليه راجعون} قام رجل يأمر بالمعروف فقتل فقام آخر فقال يقتلون الذين يأمرون بالقسط من الناس فقتل المتكبر الذي خالفه والذي أمره كبرا وقال ابن مسعود كفى بالرجل إثما إذا قيل له اتق الله قال عليك نفسك وقال صلى الله عليه وسلم لرجل كل بيمينك قال لا أستطيع فقال النبي صلى الله عليه وسلم ل أستطيع فقال النبي صلى الله عليه وسلم لا فما منعه إلا كبره قال فما رفعها بعد ذلك (1) حديث قول ثابت بن قيس بن شماس إني امرؤ قد حبب إلي من الجمال ما ترى الحديث وفيه الكبر من بطر الحق وغمص الناس أخرجه مسلم والترمذي وقد تقدم قبله بحديثين وفي حديث آخر من سفه الحق (", "english": "The second aspect by which the vice of pride is magnified is that it calls to opposing Allah the Exalted in His commands. For the arrogant man, when he hears the truth from a servant among the servants of Allah, disdains to accept it and girds himself for its denial. For this reason you see the disputants in matters of religion claiming that they are investigating the secrets of the religion, yet they engage in mutual denial—the denial of the arrogant. Whenever the truth becomes clear upon the tongue of one of them, the other refuses to accept it out of pride, girds himself for its denial, and resorts to every stratagem to repel it by whatever obfuscation he can muster. This is among the moral traits of the disbelievers and the hypocrites, for Allah the Exalted described them, saying: {«وَقَالَ الَّذِينَ كَفَرُوا لَا تَسْمَعُوا لِهَذَا الْقُرْآنِ وَالْغَوْا فِيهِ لَعَلَّكُمْ تَغْلِبُونَ»} (And those who disbelieve said: \"Do not listen to this Quran and make noise therein, perhaps you may prevail.\") So whoever disputes for the sake of victory and silencing the opponent—not to seize the truth when it appears to him—has shared with them in this moral trait. Likewise, this pride drives one to refuse admonition, as Allah the Exalted said: {«وَإِذَا قِيلَ لَهُ اتَّقِ اللَّهَ أَخَذَتْهُ الْعِزَّةُ بِالْإِثْمِ»} (And when it is said to him, \"Fear Allah,\" pride in sin seizes him.) It is narrated that ʿUmar, may Allah be pleased with him, recited this verse and then said: {«إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ»} (Indeed, we belong to Allah and to Him we return.) A man rose to enjoin good and was killed; then another rose and said: \"They kill those who enjoin justice among the people\"—and the arrogant one who opposed him and the one who commanded him was killed out of pride.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 857", "section_title_en": "The Second Aspect by Which the Vice of Pride (Kibr) Is Magnified: That It Leads to Opposing Allah in His Commands", "section_index": 857, "anchors": "- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core meaning of bigness, magnitude, and seniority; al-kibr is the internal disposition of self-magnification.\n  * Al-Raghib (Mufradat): Al-Kabīr and al-Ṣaghīr are relative terms (mutadāyifān); kibr as a moral vice is the soul's claim to a station above its due, entailing disdain for others.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage concerns physical or quantitative magnitude; metaphorical (majāz) usage here denotes arrogance and haughtiness—\"كبر عليه\" (he disdained it).\n- Root: علم (ʿ-L-M)\n  * Lisan / Ayn: Knowing a thing's reality; the root also carries the sense of a mark/trace (ʿalam) by which one is guided.\n  * Al-Raghib (Mufradat): True knowledge (ʿilm) is apprehension of a thing's essence or judgment about it; the highest form is knowledge of Allah, the self, and the Final End—this engenders fear (khashyah).\n  * Al-Zamakhshari (Asas): Literal: perception and awareness; metaphorical: the \"marks\" (maʿālim) of religion—the distinguishing signs of guidance.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, or spirit; that which is valued and precious.\n  * Al-Raghib (Mufradat): Al-Nafs denotes the soul or self; in theological usage it may refer to the essence (dhāt) of a thing.\n  * Al-Zamakhshari (Asas): Literal: the soul; metaphorical: self-worth and self-regard—the arrogant man \"magnifies his own soul\" (istaʿẓama nafsahu).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The verse {إِنَّمَا يَخْشَى اللَّهَ مِنْ عِبَادِهِ الْعُلَمَاءُ} restricts true fear of Allah exclusively to the learned, delimiting the predicate to the subject.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'", "badge": "Hadith"}], "26": [{"arabic": "فاصرفني عنه واصرفه عني واقدر لي الخير أينما كان إنك على كل شيء قدير (6) رواه جابر بن عبد الله قال كان رسول الله صلى الله عليه وسلم يعلمنا الاستخارة في الأمور كلها كما يعلمنا السورة من القرآن وقال صلى الله عليه وسلم إذا هم أحدكم بأمر فليصل ركعتين ثم ليسم الأمر ويدعو بما ذكرناه وقال بعض الحكماء من أعطي أربعا لم يمنع أربعا من أعطي الشكر لم يمنع المزيد ومن أعطي التوبة لم يمنع القبول ومن أعطي الاستخارة لم يمنع الخيرة ومن أعطي المشورة لم يمنع الصواب الثامنة صلاة الحاجة (7) فمن ضاق عليه الأمر ومسته حاجة في صلاح دينه ودن", "english": "**QUAD_ANCHORS:**\n- Root: خسف (kha-sa-fa)\n  * Lisan / Ayn: [Core linguistic root meaning] To swallow up, to cause to sink into the earth; the darkening of the sun or moon (khusūf for the moon, kusūf for the sun, though both are used interchangeably)\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The eclipse as a divine sign (āyah) — not a natural phenomenon merely, but a portent summoning the servant to remembrance of God\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: the celestial bodies being veiled/obscured; Metaphorical: the veiling of hearts from divine remembrance\n- Root: سقى (sa-qa)\n  * Lisan / Ayn: [Core linguistic root meaning] To give to drink, to water; istisqā' — the act of seeking rain/water from God\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The prayer for rain as a communal acknowledgment of absolute dependence upon divine providence\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: requesting water; Metaphorical: seeking divine mercy and abundance\n- Root: جنز (ja-na-za)\n  * Lisan / Ayn: [Core linguistic root meaning] The bier/corpse; janāzah — the funeral\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The funeral prayer as a collective obligation (farḍ kifāyah) — the living standing as intercessors for the dead\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: the bier upon which the dead is carried; Metaphorical: the entire funeral rite as a reminder of one's own mortality\n- Root: حيي (ḥa-ya)\n  * Lisan / Ayn: [Core linguistic root meaning] To live; taḥiyyah — greeting, salutation; the \"greeting of the mosque\" (taḥiyyat al-masjid)\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The greeting of the mosque as an act of reverence for the sacred space — a spiritual courtesy toward the house of God\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: greeting a person; Metaphorical: greeting the mosque through prayer as one greets a host upon entering his abode\n- Root: خير (kha-ya-ra)\n  * Lisan / Ayn: [Core linguistic root meaning] To choose; istikhārah — seeking divine choice/guidance\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] The prayer of seeking guidance as the servant's acknowledgment that only God knows the unseen consequences of affairs\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: asking someone to choose for you; Metaphorical: delegating one's affairs to divine providence while abandoning personal preference\n- Root: ركع (ra-ka-ʿa)\n  * Lisan / Ayn: [Core linguistic root meaning] To bow; rukūʿ — the bowing posture in prayer\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] Bowing as physical expression of humility and submission before divine majesty\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] Literal: the bodily posture of inclination; Metaphorical: the spiritual posture of humble submission — \"Sheikhs bowing with age\" and \"camels bowing with exhaustion\"\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional constructions (idhā... fa...) governing the temporal and circumstantial clauses for when these prayers become incumbent or recommended", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 164", "section_title_en": "Section 164", "section_index": 164, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Hajj'", "badge": "Insight"}, {"arabic": "البقرة (3) من قوله آمن الرسول وشهد الله (4) وقل اللهم مالك الملك الآيتين (5) وقوله تعالى {لقد جاءكم رسول من أنفسكم} إلى آخرها (6) وقوله تعالى {لقد صدق الله رسوله الرؤيا بالحق} إلى آخرها (7) وقوله سبحانه الحمد لله الذي لم يتخذ ولدا (8) الآية وخمس آيات من أول الحديد (9) وثلاثا من آخر سورة الحشر (10) وإن قرأ المسبعات العشر التي أهداها الخضر عليه السلام إلى إبراهيم التيمي رحمه الله ووصاه أن يقولها غدوة وعشية فقد استكمل الفضل وجمع له ذلك فضيلة جملة الأدعية المذكورة فقد روي عن كرز بن وبرة رحمه ال", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "قرأ في ركعة بعد الفاتحة قل اللهم مالك الملك إلى آخر الآية فإذا فرغ من صلاته يقول جزى الله محمدا عنا ما هو أهله غفر له ذنوب سبعين سنة وكتب له براءة من النار (2) ليلة الخميس قال أبو هريرة رضي الله عنه قال النبي صلى الله عليه وسلم من صلى ليلة الخميس ما بين المغرب والعشاء ركعتين يقرأ في كل ركعة فاتحة الكتاب وآية الكرسي خمس مرات وقل هو الله أحد خمس مرات والمعوذتين خمس مرات فإذا فرغ من صلاته استغفر الله تعالى خمس عشرة مرة وجعل ثوابه لوالديه فقد أدى حق والديه عليه وإن كان عاقا لهما وأعطاه الله تعال", "english": "And in another ḥadīth: sixteen units [of prayer] — he recites after the Opening Chapter of the Book whatever God wills, and he recites in the last two units the Throne Verse thirty times, and in the first two units thirty times {قُلْ هُوَ اللَّهُ أَحَدٌ} (Say: He is God, the One). He will intercede for ten of his household, all of whom have had the Fire made obligatory upon them.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 161", "section_title_en": "The Revival of the Religious Sciences — Section 161: Voluntary Prayers for Specific Nights and the Third Division: Prayers Recurring with the Recurrence of Years", "section_index": 161, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Root denotes safety, security, and freedom from defect; the verbal form \"sallama\" (to greet/peace) and \"aslama\" (to surrender) both derive from the core notion of being secure and whole.\n  * Al-Raghib (Mufradat): In the theological context, \"salām\" is both a divine attribute and the greeting of the people of Paradise; \"taslīm\" (the act of greeting) is an act of worship and supplication.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the verbal greeting of peace. Metaphorical (Majaz): the act of seeking safety and security through submission.\n- Root: صلو (s-l-w)\n  * Lisan / Ayn: The root denotes supplication, blessing, and the act of prayer; \"al-salāh\" is the ritual prayer, while \"al-salāt\" upon the Prophet is a request for divine mercy and elevation of his rank.\n  * Al-Raghib (Mufradat): \"Al-salāh\" upon the Prophet from God is His mercy and His praise of him before the angels; from the angels it is their supplication for him; from the believers it is their request for mercy and their veneration of his station.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its specific postures. Metaphorical: the act of invoking blessings and mercy upon the Prophet, which is a form of devotional supplication.\n- Root: شفع (sh-f-')\n  * Lisan / Ayn: The root denotes pairing, joining, and making even; \"al-shafā'ah\" is the act of intercession — one joins one's own request to that of another to strengthen it.\n  * Al-Raghib (Mufradat): Intercession is of two kinds: that which is sought from God for the removal of harm or attainment of benefit, and that which is sought from created beings. The former is exclusively God's to grant, and the latter is only effective by His permission.\n  * Al-Zamakhshari (Asas): Literal: making a number even by adding one to it. Metaphorical: the intercessor's act of adding his own plea to the plea of the one for whom he intercedes.\n- Root: عقر ('-q-r)\n  * Lisan / Ayn: The root denotes barrenness, cutting off, and being unable to produce; \"al-'āq\" (the undutiful child) is one who cuts off the bond of filial piety and obedience to parents.\n  * Al-Raghib (Mufradat): \"Uqūq\" (undutifulness) is the severing of the bond of obedience and kindness that is due to parents, and it is a grave sin.\n  * Al-Zamakhshari (Asas): Literal: cutting and severing. Metaphorical: the child who severs the tie of obedience and compassion to his parents.\n- Sibawayh Rule: Rule of Conditional Clauses (Bāb al-sharṭ) — The protasis (condition) introduced by \"man\" (whoever) is followed by an apodosis (result) that is the grammatical equivalent of the condition's answer, often introduced by \"fa-\" (then) when the apodosis is a nominal sentence or a verb preceded by \"qad\" or \"sawfa,\" indicating the guaranteed consequence of the stipulated act.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}], "28": [{"arabic": "القرآن والأخبار لا يحصى مثل قوله تعالى لا يتخذ المؤمنون الكافرين أولياء من دون المؤمنين وقال تعالى يا أيها الذين آمنوا لا تتخذوا اليهود والنصارى أولياء وقال تعالى وكذلك نولي بعض الظالمين بعضا وفي الخبر إن الله تعالى أخذ الميثاق على كل مؤمن أن يبغض كل منافق وعلى كل منافق أن يبغض كل مؤمن (3) وقال عليه السلام المرء مع من أحب (4) وقال من أحب قوما ووالاهم حشر معهم يوم القيامة (5) وقال عليه السلام أوثق عرى الإيمان الحب في الله والبغض في الله (6) وشواهد هذا قد ذكرناها في بيان الحب والبغض في الله تعالى من كتاب آداب الصحبة وفي كتاب الأمر", "english": "...as a partner in his killing. And God—exalted be He—has commanded envy and competition in good things and the warding off of evils, for He said—exalted be He—{وَفِي ذَٰلِكَ فَلْيَتَنَافَسِ الْمُتَنَافِسُونَ} [\"So for this let the competitors compete\"] (Al-Muṭaffifīn 83:26). And the Prophet—peace be upon him—said: \"There is no envy except in two: a man whom God has given wisdom, and he disseminates it among the people and teaches it; and a man whom God has given wealth, and he has been empowered over it to spend it in the truth.\" In another wording: \"And a man whom God has given the Qur'an, and he stands with it through the hours of the night and the day; then a man says: 'If God had given me the like of what He gave this one, I would have done the like of what he does.'\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1196", "section_title_en": "On the Reconciliation Between Hatred of Sinners and Satisfaction with Divine Decree — Section 1196", "section_index": 1196, "anchors": "- Root: بغض (b-gh-d)\n  * Lisan / Ayn: Core root meaning of aversion, repugnance, and the soul's flight from what it disdains; al-baghḍā' as intense enmity.\n  * Al-Raghib (Mufradat): \"البغض: نفار النفس عن الشيء الذي ترغب عنه، وهو ضد الحب\" — hatred is the soul's aversion from what it shuns, the exact opposite of love's attraction; used theologically for God's repudiation of the disobedient.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes personal antipathy; metaphorical (majāz) extension applies to religiously mandated aversion (al-bughḍ fī Allāh) as an act of devotion, not private spite.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: The face as the foremost and noblest part; by extension, an aspect, direction, or respect under which a thing is considered.\n  * Al-Raghib (Mufradat): \"ولما كان الوجه أول ما يستقبلك، وأشرف ما في ظاهر البدن استعمل في مستقبل كل شيء\" — the face is that which first confronts you, hence used for every aspect or angle of consideration.\n  * Al-Zamakhshari (Asas): Literal: the bodily face; metaphorical: \"هذا وجه الثوب\" (the face/right side of a garment) — i.e., a facet or dimension of a single act that may be evaluated differently.\n- Root: كره (k-r-h)\n  * Lisan / Ayn: Dislike, detestation, and unwillingness; karāhah as the soul's resistance to what befalls it.\n  * Al-Raghib (Mufradat): Karāhah is the soul's repugnance toward something, distinguished from ridā (satisfaction) which is the soul's acquiescence and embrace.\n  * Al-Zamakhshari (Asas): The rhetorical key here is that karāhah and ridā are contraries only when they \"تواردا على شيء واحد من جهة واحدة\" — converge on one thing from one single respect; from different respects, no contradiction arises.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The resolution of the apparent contradiction hinges on precise restriction (taqyīd): the act is hated \"من حيث إنه وصف العبد وكسبه\" (insofar as it is the servant's attribute and acquisition) and loved \"من حيث إنه مراد الله\" (insofar as it is God's will and decree). The predicate is qualified by its aspect, eliminating the logical clash.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}, {"arabic": "أكبر همه فليس من الله في شيء وألزم الله قلبه أربع خصال الحديث أخرجه الطبراني في الأوسط من حديث أبي ذر دون قوله وألزم الله قلبه وكذلك رواه ابن أبي الدنيا من حديث أنس بإسناد ضعيف والحاكم من حديث حذيفة وروي هذه الزيادة منفردة صاحب الفردوس من حديث ابن عمر وكلاهما ضعيف (5) حديث أبي هريرة ألا أريك الدنيا جميعها بما فيها قلت بلى يا رسول الله فأخذ بيدي وأتى بي واديا من أودية المدينة فإذا مزبلة الحديث لم أجد له أصلا // ويروى إن الله عز وجل لما أهبط آدم إلى الأرض قال له ابن للخراب", "english": "It has been related that the Messenger of God — may God's peace and blessings be upon him — passed by a dead sheep and said: \"Do you see this sheep as contemptible to its owners?\" They said: \"It was due to its contemptibleness that they cast it away.\" He said: \"By Him in whose hand is my soul, this world is more contemptible to God than this sheep is to its owners. And had this world weighed in God's sight the wing of a gnat, He would not have given a disbeliever from it a single drink of water.\" {«الدنيا سجن المؤمن وجنة الكافر»} (1)", "book_title": "Condemnation of the World", "section_title_ar": "Section 730", "section_title_en": "The Verses and Reports Concerning the Blame of This World (Dhamm al-Dunyā)", "section_index": 730, "anchors": "- Root: د ن ا (D-N-A)\n  * Lisan / Ayn: The near, the lower, that which is immediate and proximate; the worldly abode as that which is \"closest\" in contrast to the Hereafter which is \"farthest.\"\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by judgment; the dunyā is so named for its temporal nearness, its inferior rank, and its being the \"lesser\" (adnā) in contrast to the greater and abiding.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the nearest and lowest abode. Metaphorical (Majaz): the life of this world as a \"dung-hill\" (mazbalah) and a carcass — its worthlessness rendered sensibly perceptible.\n- Root: ر س ل (R-S-L)\n  * Lisan / Ayn: Sending forth with gentleness and ease; a messenger (rasūl) as one dispatched.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root is emission upon measured deliberation; the prophetic mission (risālah) as the sending of guidance to turn creation away from the dunyā toward the ākhirah.\n  * Al-Zamakhshari (Asas): Literal: dispatch of a messenger with a message. Metaphorical: \"أرسل الله عليهم العذاب\" — the sending of punishment; here, the prophets were sent with the sole purpose of diverting hearts from the world.\n- Root: ح د ث (H-D-TH)\n  * Lisan / Ayn: Origination after non-existence; that which is new and temporal.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — the world as muḥdath (originated/temporal), hence inherently perishable and contemptible before the Eternal.\n  * Al-Zamakhshari (Asas): Literal: new occurrence. Metaphorical: \"صاروا أحاديث\" — becoming mere tales; the dunyā's ornaments become \"rotten rags\" and \"withered bones.\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The prophetic reports employ restrictive constructions (e.g., \"The world is but a prison of the believer\") to confine the dunyā's essence to a single defining attribute, negating all else.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of the World'", "badge": "Hadith"}], "30": [{"arabic": "وقال تعالى {ثم توفى كل نفس ما كسبت وهم لا يظلمون} وقال تعالى {يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو أن بينها وبينه أمدا بعيدا ويحذركم الله نفسه} وقال تعالى {واعلموا أن الله يعلم ما في أنفسكم فاحذروه} فعرف أرباب البصائر من جملة العباد أن الله تعالى لهم بالمرصاد وأنهم سيناقشون في الحساب ويطالبون بمثاقيل الذر من الخطرات واللحظات وتحققوا أنه لا ينجيهم من هذه الأخطار إلا لزوم المحاسبة وصدق المراقبة ومطالبة النفس في الأنفاس والحركات ومحاسبتها في الخطرات واللحظات فمن حاسب نفسه قبل أن يحاسب خف في القيامة حسابه وحضر عند السؤال جوابه وحسن منقلبه ومآبه ومن لم يحاس", "english": "To proceed: God Most High has said: {And We shall set up the scales of justice for the Day of Resurrection, so no soul shall be wronged in anything; and if it be the weight of a grain of mustard seed, We shall bring it forth, and sufficient are We as Reckoners} (21:47). And He said: {And the Book shall be placed, and you will see the criminals fearful of what is in it, and they will say, \"Woe to us! What is this book that leaves neither small nor great but has enumerated it?\" And they will find what they did present, and your Lord wrongs no one} (18:49). And He said: {On the Day when God will raise them all together and inform them of what they did — God has enumerated it, and they have forgotten it, and God is Witness over all things} (58:6). And He said: {On that Day, people will issue forth in scattered groups to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it} (99:6-8). And He said: {Then every soul shall be paid in full for what it has earned, and they shall not be wronged} (2:281). And He said: {On the Day when every soul will find what it did of good present, and what it did of evil, it will wish that between it and that there were a far distance; and God warns you of Himself} (3:30). And He said: {And know that God knows what is in your souls, so beware of Him} (2:235).", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1230", "section_title_en": "Exposition of the Reality of Truthfulness (Al-Sidq), Its Meaning, and Its Grades — Book of Vigilance and Self-Reckoning, Being the Eighth Book of the Quarter of Deliverance from the Revival of the Religious Sciences", "section_index": 1230, "anchors": "- Root: رقب (Raqaba)\n  * Lisan / Ayn: To watch, guard, observe; a watcher (raqīb) is one who stands vigilant over something, awaiting its occurrence.\n  * Al-Raghib (Mufradat): Raqaba denotes protective watchfulness; al-raqīb is a divine attribute signifying His perpetual oversight of all that transpires, with no moment of neglect.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical watching/awaiting. Metaphorical (majāz): \"This matter is upon your necks (fī riqābikum)\" — i.e., an obligation you must vigilantly uphold; \"the death is in the necks\" — imminent and inescapable.\n- Root: حسب (Hasaba)\n  * Lisan / Ayn: To count, reckon, compute; al-ḥisāb is the act of enumeration and settlement of accounts.\n  * Al-Raghib (Mufradat): Al-ḥisāb is the employment of number; divine reckoning (ḥisāb) on the Day of Resurrection is the exacting appraisal of deeds, even to the atom's weight.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"they reckon news (yaḥtasibūna al-akhbār)\" — they investigate and ascertain, as one places knowledge in place of conjecture.\n- Root: قلب (Qalaba)\n  * Lisan / Ayn: To turn, overturn, transform; the heart (qalb) is so named for its constant fluctuation and turning of states.\n  * Al-Raghib (Mufradat): Qalaba is the turning of a thing from one state to another; the heart's inner thoughts (khaṭarāt) are its successive movements, which God surveys.\n  * Al-Zamakhshari (Asas): Literal: turning a garment or object. Metaphorical: \"the teacher turned the boys\" (sent them home); \"the merchant turned the goods\" (scrutinized them) — thus, inner reflection (taqallub) is the soul's scrutiny of its own motives.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"إنما يحاسبهم لتعلم كل نفس\" — the sole purpose of reckoning is specified, excluding all other ends.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}, {"arabic": "الهوى وستجد كل نفس ما عملت من سوء أو خير محضرا عند الله ولو في فلتة خاطر أو فلتة ناظر من غير ظلم وجور فما الله بظلام للعبيد وأما القسم الثاني وهو فوات الحاصل فهو مكروه ومعتبر في جواز السكوت في الأمور الأربعة إلا العلم فإن فواته غير مخوف إلا بتقصير منه وإلا فلا يقدر أحد على سلب العلم من غيره وإن قدر على سلب الصحة والسلامة والثروة والمال وهذا أحد أسباب شرف العلم فإنه يدوم في الدنيا ويدوم ثوابه في الآخرة فلا انقطاع له أبد الآباد وأما الصحة والسلامة ففواتهما بالضرب فكل من عل", "english": "All of this does not nullify the obligation of ḥisbah, because these are but increases (ziyādāt) whose attainment is prevented — and calling the mere prevention of attaining increases \"harm\" (ḍarar) is metaphorical (majāz). True harm (al-ḍarar al-ḥaqīqī) is only the loss of something already in hand (fawāt ḥāṣil). Nothing is excepted from this rule save that which necessity (ḥājah) calls for, and whose loss entails a danger (maḥdhūr) exceeding the danger of remaining silent over the wrong (al-sukūt ʿalā al-munkar) — as when one is in need of a physician for an acute illness, and the cure is anticipated from the physician's treatment, and he knows that in the physician's delay there is severe aggravation of his malady and prolongation of his sickness, which may even lead to death.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 532", "section_title_en": "On the Conditions Permitting Abandonment of Enjoining Right — Section 532", "section_index": 532, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and calculating; al-ḥisbah derives from the notion of taking account of another's deeds.\n  * Al-Raghib (Mufradat): \"الحساب: استعمال العدد\" — reckoning is the employment of number; the theological nuance connects to divine accounting and the duty of moral reckoning upon others.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسب المال\" — to count property. Metaphorical (majāz): \"يَتَحَسَّبانِ الأخبار\" — to seek out and investigate news, as one probes and tests; thus ḥisbah is the active seeking-out of wrongs to rectify them.\n- Root: ضرر (ḍ-r-r)\n  * Lisan / Ayn: Core meaning of harm, injury, and detriment; al-ḍarar is that which opposes benefit (nafʿ).\n  * Al-Raghib (Mufradat): Harm is of two kinds — that which is truly detrimental to one's religion or worldly welfare, and that which is merely imagined or anticipated.\n  * Al-Zamakhshari (Asas): Literal: actual physical or material injury. Metaphorical: the mere loss of an anticipated increase (ziyādah), which is not true harm but is called so figuratively.\n- Root: سكت (s-k-t)\n  * Lisan / Ayn: Core meaning of silence, refraining from speech.\n  * Al-Raghib (Mufradat): \"السكوت مختص بترك الكلام\" — silence is specific to abstaining from speech; it is a form of rest (sukūn) and is used metaphorically for the subsiding of anger or other states.\n  * Al-Zamakhshari (Asas): Literal: \"رجل سكوت\" — a man habitually silent. Metaphorical: \"سكت عنه الغضب\" — anger subsided; thus al-sukūt ʿan al-munkar is the deliberate cessation of verbal objection.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core meaning of knowledge, perception, and discernment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality; it is that which cannot be forcibly stripped from its possessor.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك\" — I had no awareness of your news. Metaphorical: knowledge as an enduring mark (ʿalam) and signpost of guidance.\n- Sibawayh Rule: Restriction and exception (al-ḥaṣr wa al-istithnāʾ) — the conditional framing of permissibility (al-tarkhīṣ) through specified exceptions (istithnāʾ) governed by the weighing of two harms (taʿāruḍ al-mafsadatayn), where the lesser is borne to avert the greater.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Enjoining Good and Forbidding Evil'", "badge": "Ethics"}], "31": [{"arabic": "بعد الإسلام وقد اشترط الله تعالى للمحبة غفران الذنب فقال {قل إن كنتم تحبون الله فاتبعوني يحببكم الله ويغفر لكم ذنوبكم} وقال رسول الله صلى الله عليه وسلم إن الله تعالى يعطي الدنيا من يحب ومن لا يحب ولا يعطي الإيمان إلا من يحب (2) وقال رسول الله صلى الله عليه وسلم من تواضع لله رفعه الله ومن تكبر وضعه الله ومن أكثر ذكر الله أحبه الله (3) وقال عليه السلام قال الله تعالى لا يزال العبد يتقرب إلي بالنوافل حتى أحبه فإذا أحببته كنت سمعه الذي يسمع به وبصره الذي يبصر به (4) الحديث وقال زيد بن أسلم إن الله ليحب العبد حتى يبلغ من حبه له أن يقول اعمل ما شئت فقد غفر", "english": "Know that the evidences of the Qur'an are manifest and numerous that God—exalted is He—loves His servant; thus, it is imperative to understand the meaning of this [love]. Let us first present the evidences of His love. God—exalted is He—said: {«يُحِبُّهُمْ وَيُحِبُّونَهُ»} [He loves them, and they love Him] (Q 5:54). And He said: {«إِنَّ اللَّهَ يُحِبُّ الَّذِينَ يُقَاتِلُونَ فِي سَبِيلِهِ صَفًّا»} [Indeed, God loves those who fight in His cause in a row] (Q 61:4). And He said: {«إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ وَيُحِبُّ الْمُتَطَهِّرِينَ»} [Indeed, God loves those who repent and loves those who purify themselves] (Q 2:222). For this reason, He—glorified is He—rebuked the one who claimed to be God's beloved, saying: {«قُلْ فَلِمَ يُعَذِّبُكُمْ بِذُنُوبِكُمْ»} [Say: Then why does He punish you for your sins?] (Q 5:18). It is narrated that Anas reported the Prophet—peace be upon him—as saying: \"When God—exalted is He—loves a servant, no sin harms him, and the one who repents from sin is like one who has no sin.\" Then he recited: {«إِنَّ اللَّهَ يُحِبُّ التَّوَّابِينَ»} [Indeed, God loves those who repent] (Q 2:222). Its meaning is that when He loves him, He grants him repentance before death, so past sins do not harm him, however numerous they may be—just as past disbelief does not harm one after embracing Islam. God—exalted is He—has made the forgiveness of sin a condition for [this] love, saying: {«قُلْ إِنْ كُنْتُمْ تُحِبُّونَ اللَّهَ فَاتَّبِعُونِي يُحْبِبْكُمُ اللَّهُ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْ»} [Say: If you love God, then follow me; God will love you and forgive you your sins] (Q 3:31). The Messenger of God—peace be upon him—said: \"God—exalted is He—gives the world to those He loves and those He does not love, but He does not give faith except to those He loves.\" And the Messenger of God—peace be upon him—said: \"Whoever humbles himself before God, God raises him; whoever is arrogant, God lowers him; and whoever remembers God much, God loves him.\" And he—peace be upon him—said, relaying from God—exalted is He: \"The servant continues to draw near to Me with supererogatory acts until I love him; and when I love him, I become his hearing with which he hears, and his sight with which he sees\" (ḥadīth). Zayd ibn Aslam said: \"God indeed loves a servant until, from the intensity of His love for him, He says: 'Do what you wish, for I have forgiven you.'\" The expressions of love [in scripture] are beyond enumeration.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1173", "section_title_en": "On the Reality of God's Love for His Servant and Its Interpretation", "section_index": 1173, "anchors": "- Root: ح ب ب (ḥ-b-b)\n  * Lisan / Ayn: Core meaning: to love, to cherish; the root denotes inclination and attachment of the heart.\n  * Al-Raghib (Mufradat): In theological usage, love (maḥabbah) toward God is a real inclination of the soul toward what is agreeable; toward creation, it is metaphorical, signifying divine will, favor, and the unveiling of veils.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for creatures—an emotional inclination; metaphorical (majāz) for God—expressing volitional acts like drawing near, forgiving, and honoring.\n- Root: ق ر ب (q-r-b)\n  * Lisan / Ayn: Proximity, nearness; both spatial and relational.\n  * Al-Raghib (Mufradat): Qurb denotes nearness in station, rank, and favor, not physical location; God's \"nearness\" to a servant is by unveiling and honor.\n  * Al-Zamakhshari (Asas): Literal: spatial closeness; metaphorical: closeness in rank, virtue, or divine acceptance (e.g., \"qaruba min Allāh\" = drew near to God by obedience).\n- Root: و ل ي (w-l-y)\n  * Lisan / Ayn: To be near, to govern, to befriend; walāyah implies closeness and guardianship.\n  * Al-Raghib (Mufradat): Wilāyah of God for the believer is His care and guidance; the servant's wilāyah for God is loyal adherence.\n  * Al-Zamakhshari (Asas): Literal: adjacency; metaphorical: protective friendship and love.\n- Sibawayh Rule: Restriction and specification (bāb al-ḥaṣr wa-l-taqyīd bi-innamā)—used to delimit meanings when terms are applied to God versus creatures, ensuring no equivocation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "عليها بالنواجذ (11) وقال تعالى {قل إن كنتم تحبون الله فاتبعوني يحببكم الله} وأوصى رسول الله صلى الله عليه وسلم عائشة رضي الله عنها خاصة وقال إن أردت اللحوق بي فإياك ومجالسة الأغنياء ولا تنزعي ثوبا حتى ترقعيه (12) وعد على قميص عمر رضي الله عنه اثنتا عشرة رقعة بعضها من أدم واشترى علي بن أبي طالب كرم الله وجهه ثوبا بثلاثة دراهم ولبسه وهو في الخلافة وقطع كميه من الرسغين وقال الحمد لله الذي كساني هذا من رياشه وقال الثوري وغيره البس من الثياب مالا يشهرك عند العلماء ولا يحقرك عند الجهال وكان", "english": "ʿĀ'ishah, may God Most High be well pleased with her, said: \"Forty nights would pass over us without a lamp or fire being lit in the house of the Messenger of God, may God bless him and grant him peace.\" It was said to her: \"Then by what did you live?\" She said: \"By the two black things: dates and water.\" (1) This is the abandonment of meat, broth, and condiments.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1096", "section_title_en": "The Revival of the Religious Sciences — Book on Poverty and Asceticism (Kitāb al-Faqr wa al-Zuhd): Section on the Ascetic's Conduct Regarding Food, Clothing, Dwelling, and Furnishings", "section_index": 1096, "anchors": "- Root: طوي (ṭ-w-y)\n  * Lisan / Ayn: To fold up, to roll up; to pass the night fasting (ṭawā); to traverse a distance.\n  * Al-Raghib (Mufradat): Implies enduring hunger by \"folding\" the stomach over itself—abstaining from filling it.\n  * Al-Zamakhshari (Asas): Literal: folding a garment. Metaphorical: the ascetic \"folds up\" his days in hunger, i.e., passes them without food.\n- Root: لبس (l-b-s)\n  * Lisan / Ayn: To cover, to clothe; to become confused/ambiguous (il tibās).\n  * Al-Raghib (Mufradat): Clothing as that which covers one's shame (saw'ah); extended metaphorically to the spouse as a \"garment\" (libās) for the other.\n  * Al-Zamakhshari (Asas): Literal: wearing a garment. Metaphorical: \"wearing\" a people's manner/dress (ziyy) entails becoming one of them—hence the Hadith cited: \"Whoever imitates a people's dress is of them.\"\n- Root: بني (b-n-y)\n  * Lisan / Ayn: To build, to erect a structure; binyān: edifice.\n  * Al-Raghib (Mufradat): Building beyond necessity is a sign of long hope (ṭūl al-amal) and worldly attachment, antithetical to zuhd.\n  * Al-Zamakhshari (Asas): Literal: construction with mortar and brick. Metaphorical: \"raising\" oneself in pride (ʿulūw) — condemned in the Qur'anic verse cited.\n- Root: سكن (s-k-n)\n  * Lisan / Ayn: To dwell, to be tranquil; maskan: dwelling place.\n  * Al-Raghib (Mufradat): The dwelling is for repelling harm (heat, cold, eyes) — its measure is necessity (ḍarūrah), not luxury.\n  * Al-Zamakhshari (Asas): Literal: a place of residence. Metaphorical: the heart's \"dwelling\" on God (sakīnah) — contrasted with physical dwellings that distract.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the degrees of zuhd: \"The least degree is only what repels heat and cold...\" (innamā yuqṣad), restricting the licit to the necessary.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Poverty and Abstinence'", "badge": "Du'a"}], "33": [{"arabic": "ورأى رجل من أصحاب الحسن البصري ليلة مات الحسن كأن مناديا ينادي إن الله اصطفى آدم ونوحا وآل إبراهيم وآل عمران على العالمين واصطفى الحسن البصري على أهل زمانه وقال أبو يعقوب القاري الدقيقي رأيت في منامي رجلا آدم طوالا والناس يتبعونه فقلت من هذا قالوا أويس القرني فأتيته فقلت أوصني رحمك الله فكلح في وجهي فقلت مسترشدا فأرشدني أرشدك الله فأقبل على وقال اتبع رحمة ربك عند محبته واحذر نقمته عند معصيته ولا تقطع رجاءك منه في خلال ذلك ثم ولى وتركني وقال أبو بكر بن أبي مريم رأيت ورقاء بن بشر الحضرمي فقلت ما فعلت يا ورقاء قال البكاء من خشية الله وقال يزيد بن نعامة هلكت جارية ف", "english": "Abu Sa'id al-Shahham said: I saw Sahl al-Sa'luki in a dream and said, \"O Shaykh!\" He said, \"Leave off this addressing me as shaykh.\" I said, \"Those spiritual states (aḥwāl) which you witnessed [in life]?\" He said, \"They availed us nothing.\" I said, \"What did God do with you?\" He said, \"He forgave me on account of the questions about which the incapable ones used to ask.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1333", "section_title_en": "Section 1333 — Visions of the Deceased and Their States After Death", "section_index": 1333, "anchors": "- Root: م و ت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of vital faculty; the state of the deceased (mayyit) contrasted with the living (ḥayy).\n  * Al-Raghib (Mufradat): Death as separation of the soul from the body, a transition to the Barzakh; visions of the dead (ru'yā) reveal their post-mortem states.\n  * Al-Zamakhshari (Asas): Literal death (ḥaqīqah) vs. metaphorical \"death\" of the heart; here, actual death and its aftermath.\n- Root: غ ف ر (gh-f-r)\n  * Lisan / Ayn: Covering, protection from defilement; forgiveness as divine concealment of sin.\n  * Al-Raghib (Mufradat): Divine forgiveness (maghfirah) as God's safeguarding the servant from punishment.\n  * Al-Zamakhshari (Asas): Literal: covering a garment; metaphorical: God's pardon enveloping all sins, as in the vision of Ibn al-Mubarak.\n- Root: ر أ ي (r-'-y)\n  * Lisan / Ayn: Seeing, perceiving; in dreams (ru'yā), a mode of non-sensory perception.\n  * Al-Raghib (Mufradat): Vision as a form of divine disclosure (mukāshafah) granted to the righteous.\n  * Al-Zamakhshari (Asas): Literal sight vs. dream-vision as a vehicle for veridical reports of the unseen.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the placement of prepositional phrases and their objects, ensuring syntactic coherence in complex narrative chains, as applied here to the sequence of reported dream-visions.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "37": [{"arabic": "{وقال} فيكشف ما تدعون إليه إن شاء {وقال} يرزق من يشاء بغير حساب {وقال} ويغفر ما دون ذلك لمن يشاء {وقال} ويتوب الله على من يشاء وهو خلق من أخلاق الربوبية إذ قال تعالى والله شكور حليم وقد جعل الله الشكر مفتاح كلام أهل الجنة فقال تعالى وقالوا الحمد لله الذي صدقناه وعده {وقال} وآخر دعواهم أن الحمد لله رب العالمين", "english": "So then, what we have mentioned concerning the treatment of patience (ṣabr) regarding whispered insinuation (waswās), regarding lust (shahwah), and regarding status (jāh) — annex this to what we have already set down concerning the canons of the paths of spiritual striving (mujāhadah) in the Book of the Discipline of the Soul (Kitāb Riyāḍat al-Nafs) from the Quarter of the Destroyers (rubʿ al-muhlikāt). Adopt it as your manual (dastūr) by which you may come to know the treatment of patience in all the categories which we have previously detailed; for the detailing of individual cases is prolix. Whoever observes gradual progression (tadrīj), patience will elevate him to a state wherein patience without it becomes as arduous as it once was with it — so his affairs become inverted, and what was once beloved to him becomes loathed, and what was once detested to him becomes a sweet, wholesome draught from which he cannot bear to be patient [in abstaining]. This is known only through experience (tajribah) and tasting (dhawq). It has an analogue in customary habits: for a boy is compelled to learning in the beginning by force, and so patience with play and patience with knowledge are both arduous for him — until, when his inner sight is opened and he finds intimacy with knowledge, the matter is inverted, and it becomes arduous for him to be patient in abstaining from knowledge, and to endure play. To this points what is narrated of one of the knowers (ʿārifīn) that he asked al-Shiblī: \"Patience — which of its kinds is the most severe?\" He said: \"Patience in God (fī Allāh).\" He said: \"No.\" He said: \"Patience for God (li-Allāh).\" He said: \"No.\" He said: \"Patience with God (maʿa Allāh).\" He said: \"No.\" He said: \"Then what?\" He said: \"Patience from God (ʿan Allāh).\" At that al-Shiblī cried out a cry by which his soul nearly perished. And it has been said concerning the meaning of His saying, the Exalted: {«اصبروا وصابروا ورابطوا»} \"Be patient, and vie in patience, and be steadfast\" (Q. 3:200): \"Be patient in God, vie in patience by God, and be steadfast with God.\" And it was said: \"Patience for God is sufficiency (ghināʾ); patience by God is endurance (baqāʾ); patience with God is fidelity (wafāʾ); and patience from God is abandonment (jafāʾ).\" And it was said concerning its meaning:", "book_title": "Patience and Gratitude", "section_title_ar": "Section 972", "section_title_en": "The Revival of the Religious Sciences — Section 972: On Patience (al-Sabr) and the Commencement of Gratitude (al-Shukr)", "section_index": 972, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; al-Khalil notes its application to holding back an animal from fodder, and to enduring constraint.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — the withholding of the self in constriction; it is a general term whose specific names (shajāʿah, ḥilm, etc.) vary by context, and its opposite is al-jazaʿ (panic/vexation).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — enduring what is disliked and restraining from what is loved. Metaphorical (majāz): \"صبرت يمينه\" — binding an oath strenuously; \"أصبر على الضرب من الأرض\" — more enduring than the earth.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: The root denotes manifestation and fullness; al-Ayn links it to an overflowing udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — the perception of a blessing and its display; it is the opposite of kufr (covering/denial). It has three degrees: of the heart (perception), of the tongue (praise), and of the limbs (requital).\n  * Al-Zamakhshari (Asas): Literal: \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical: \"دابة شكور\" — a beast that thrives on little fodder, displaying its owner's care through its fatness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; al-Ayn treats it under the entry of umm (source/origin), indicating that knowledge is the root to which all else is annexed.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing by its true reality, either by grasping its essence or by affirming/denying a predicate of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to be aware/perceive. It is also used for the landmarks (maʿālim) of the road, i.e., traces by which one is guided.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: The kindling and blazing of fire; al-Ayn records it under the entry of w-q-d with the sense of fuel and flame.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is both the fuel and the resulting flame, as in {«وقودها الناس والحجارة»} (Q. 2:24).\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed fiercely. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقدة الصيف\" — the blazing heat of summer.\n- Sibawayh Rule: Interposition between the operative word and its object (al-faṣl bayna al-ʿāmil wa al-maʿmūl fīhi) — governing the placement of circumstantial qualifiers (ḥāl) and prepositional phrases to preserve the intended semantic restriction, as in the verse \"اصبروا وصابروا ورابطوا\" where each imperative carries a distinct operative scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "53": [{"arabic": "البقرة (2) وهي قوله قولوا آمنا بالله وما أنزل إلينا وفي الثانية ربنا آمنا بما أنزلت وسمع بلالا يقرأ من ههنا وههنا فسأله عن ذلك فقال أخلط الطيب بالطيب فقال أحسنت (3) ويقرأ في الظهر بطوال المفصل إلى ثلاثين آية وفي العصر بنصف ذلك وفي المغرب بأواخر المفصل وآخر صلاة صلاها رسول الله صلى الله عليه وسلم المغرب قرأ فيها سورة المرسلات ما صلى بعدها حتى قبض (4) وبالجملة التخفيف أولى لا سيما إذا كثر الجمع قال صلى الله عليه وسلم في هذه الرخصة إذا صلى أحدكم بالناس فليخفف فإن فيهم الضعيف والكبير وذا الحاجة وإذا صلى لنفسه فليطول ما شاء (5) وقد كان", "english": "And it has been said: When two persons were present for the congregational prayer, they would not wait for a third; and when four were present for a funeral prayer, they would not wait for a fifth. And the Messenger of God, peace be upon him, was once delayed from the dawn prayer while they were on a journey — his delay was only for the sake of purification — yet he did not wait, and ʿAbd al-Raḥmān ibn ʿAwf stepped forward and led them in prayer, until one unit (rakʿah) escaped the Messenger of God, peace be upon him, and he stood to make it up. The narrator said: \"We were concerned about that.\" Then the Messenger of God, peace be upon him, said: \"You have done well. Thus do, and so act.\" And he was once delayed from the noon prayer, so they put forward Abū Bakr, may God be pleased with him, until the Messenger of God, peace be upon him, arrived while he was in the prayer, and he stood beside him. And it is not upon the Imam to wait for the caller to prayer (mu'adhdhin); rather, it is upon the caller to wait for the Imam for the commencement (iqāmah). So when the Imam has arrived, he should not wait for anyone else.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 144", "section_title_en": "The Revival of the Religious Sciences — Section 144: On the Inward and Outward Functions of the Prayer (Continued)", "section_index": 144, "anchors": "- Root: صلا (ṣ-l-w)\n  * Lisan / Ayn: Core root denoting the act of prayer (ṣalāh), derived from supplication and drawing near; also the fire of worship's burning devotion.\n  * Al-Raghib (Mufradat): Ṣalāh as the spiritual connection to God, encompassing both outward ritual and inward sincerity (ikhlāṣ); its perfection lies in presence of heart and adherence to prophetic practice.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — the prescribed ritual prayer with its conditions and pillars; Metaphorical (majāz) — prayer as the soul's \"burning\" yearning toward God, purified from ostentation.\n- Root: رسل (r-s-l)\n  * Lisan / Ayn: Sending forth with ease and gentleness; a messenger (rasūl) dispatched with a mission.\n  * Al-Raghib (Mufradat): The Imam as a \"delegate\" (rasūl) of the congregation, bearing the trust (amānah) of leading them in worship before God.\n  * Al-Zamakhshari (Asas): Literal — the Imam's role in conveying the prayer; Metaphorical — the Imam as intercessor (shafīʿ) and representative for the people, requiring moral excellence.\n- Root: عله (ʿ-l-h) — Note: Not directly applicable; substituted by root: أمن (a-m-n) for amānah (trust).\n  * Lisan / Ayn: Trustworthiness and fidelity; the opposite of betrayal (khiyānah).\n  * Al-Raghib (Mufradat): Amānah as the divine trust reposed in the Imam — both outward purity (ṭahārah) from ritual impurity and inward purity from sin.\n  * Al-Zamakhshari (Asas): Literal — safeguarding the prayer's conditions; Metaphorical — the Imam's moral state as a reflection of the congregation's spiritual standing.\n- Root: سور (s-w-r)\n  * Lisan / Ayn: Leaping, ascending; a wall (sūr) enclosing a city.\n  * Al-Raghib (Mufradat): The \"leap\" of the Imam into the prayer's spiritual domain, and the congregation's measured following — neither racing ahead nor lagging.\n  * Al-Zamakhshari (Asas): Literal — the physical postures of bowing and prostration; Metaphorical — the soul's ascent through humility, avoiding the \"leap\" of pride or haste.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish what is obligatory (farḍ) from what is recommended (mandūb), and to specify the precise limits of the Imam's and congregation's actions, ensuring no overstepping of the prophetic model.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Mysteries of Prayer'", "badge": "Hadith"}], "54": [{"arabic": "مكرا ومكرنا مكرا وهم لا يشعرون وقال عز وجل ومكروا ومكر الله والله خير الماكرين وقال تعالى إنهم يكيدون كيدا وأكيد كيدا فمهل الكافرين أمهلهم رويدا فكما لا يجوز للعبد المهمل أن يستدل بإهمال السيد إياه وتمكينه من النعم على حب السيد بل ينبغي أن يحذر أن يكون ذلك مكرا منه وكيدا مع أن السيد لم يحذره مكر نفسه فبأن يجب ذلك في حق الله تعالى مع تحذيره استدراجه أولى فإذن من أمن مكر الله فهو مغتر ومنشأ هذا الغرور أنه استدل بنعم الدنيا على أنه كريم عند ذلك المنعم واحتمل أن يكون ذلك دليل الهوان ولكن ذلك الاحتمال لا يوافق الهوى فالشيطان بواس", "english": "As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 888", "section_title_en": "Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)", "section_index": 888, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Delusion'", "badge": "Ethics"}], "59": [{"arabic": "الله من أرذل الأشياء ثم من أقذرها إذ قد خلقه من تراب ثم من نطفة ثم من علقة ثم من مضغة ثم جعله عظما ثم كسا العظم لحما فقد كان هذا بداية وجوده حيث كان شيئا مذكورا فما صار شيئا مذكورا إلا وهو على أخس الأوصاف والنعوت إذ لم يخلق في ابتدائه كاملا بل خلقه جمادا ميتا لا يسمع ولا يبصر ولا يحس ولا يتحرك ولا ينطق ولا يبطش ولا يدرك ولا يعلم فبدأ بموته قبل حياته وبضعفه قبل قوته وبجهله قبل علمه وبعماه قبل بصره وبصممه قبل سمعه وببكمه قبل نطقه وبضلالته قبل هداه وبفقره قبل غناه وبعجزه قبل قدرته فهذا معنى قوله", "english": "As for his knowledge of his Lord, His greatness, and His glory — the discourse thereon is lengthy, and it is the ultimate end of the science of unveiling (ʿilm al-mukāshafah). As for his knowledge of himself, that too is lengthy; but we shall mention therefrom that which benefits in arousing humility and lowliness. And it suffices him to understand the meaning of a single verse in the Book of God — for in the Qurʾān is the knowledge of the first and the last, for him whose inner sight has been opened. God, may He be exalted, has said: {«قُتِلَ الْإِنْسَانُ مَا أَكْفَرَهُ ۝ مِنْ أَيِّ شَيْءٍ خَلَقَهُ ۝ مِنْ نُطْفَةٍ خَلَقَهُ فَقَدَّرَهُ ۝ ثُمَّ السَّبِيلَ يَسَّرَهُ ۝ ثُمَّ أَمَاتَهُ فَأَقْبَرَهُ ۝ ثُمَّ إِذَا شَاءَ أَنْشَرَهُ»} [ʿAbasa: 17–22] — \"May man be killed! How ungrateful he is! From what thing did He create him? From a drop of fluid He created him and proportioned him. Then the path He made easy for him. Then He causes him to die and buries him. Then when He wills, He raises him.\" The verse has pointed to the first origin of man, to the last of his affair, and to his middle state. Let man, then, look upon that, in order to understand the meaning of this verse.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 863", "section_title_en": "Exposition of the Character Traits of the Humble and the Sum Total of Wherein the Effect of Humility and Arrogance Appears — and the Exposition of the Method of Treating Arrogance and Acquiring Humility", "section_index": 863, "anchors": "- Root: تواضع (tawāḍuʿ)\n  * Lisan / Ayn: Root و-ض-ع: to place down, lower, set in a low position; al-tawāḍuʿ is self-lowering, the voluntary assumption of lowness.\n  * Al-Raghib (Mufradat): Al-waḍʿ is placing a thing in a station; tawāḍuʿ is the soul's self-abasement before truth and before the Creator, opposed to takabbur (self-elevation).\n  * Al-Zamakhshari (Asas): Haqīqah: physical lowering of position. Majāz: the soul's humility and abandonment of claims to eminence.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Root ك-ب-ر: bigness, magnitude; al-kibriyāʾ is exclusive divine majesty; al-kibr (arrogance) is the creature's false claim to that majesty.\n  * Al-Raghib (Mufradat): Al-kibr is the soul's self-magnification, a claim to a station of greatness that belongs to God alone; it is the root of all disobedience.\n  * Al-Zamakhshari (Asas): Haqīqah: physical greatness. Majāz: the heart's disdain of others and refusal of truth — the blameworthy kibr.\n- Root: نطف (nuṭfah)\n  * Al-Raghib (Mufradat): Al-nuṭfah: pure water, used for the seminal fluid. {«ثُمَّ جَعَلْنَاهُ نُطْفَةً فِي قَرَارٍ مَكِينٍ»} [Al-Muʾminūn: 13].\n  * Al-Zamakhshari (Asas): Haqīqah: clear water, little or much. Majāz: \"laylah naṭūf\" — a night raining until morning.\n- Root: خلق (khalaqa)\n  * Al-Raghib (Mufradat): Al-khalq: measured estimation (taqdīr mustaqīm); used for bringing forth from nothing without model, and for producing a thing from another thing.\n  * Al-Zamakhshari (Asas): Haqīqah: the tailor's cutting cloth to measure. Majāz: God's origination of creatures upon a measure necessitated by wisdom.\n- Sibawayh Rule: Bāb al-ʿaṭf ʿalā al-ḍamīr al-marfūʿ al-muttaṣil (Coordination upon the connected nominative pronoun) — permissible when preceded by an explicit subject, as in \"خلقه من نطفة فقدره\" where the sequence of verbs coordinates without repetition of the pronoun, each verb governing its own object in ordered succession.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}, {"arabic": "الصحابة فقال صلى الله عليه وسلم لا تزرموه أي لا تقطعوا عليه البول ثم قال له إن هذه المساجد لا تصلح لشيء من القذر والبول والخلاء (1) وفي رواية قربوا ولا تنفروا وجاءه أعرابي يوما يطلب منه شيئا فأعطاه صلى الله عليه وسلم ثم قال له أحسنت إليك قال الأعرابي لا ولا أجملت قال فغضب المسلمون وقاموا إليه فأشار إليهم أن كفوا ثم قام ودخل منزله وأرسل إلى الأعرابي وزاده شيئا ثم قال أحسنت إليك قال نعم فجزاك الله من أهل وعشيرة خيرا فقال له النبي صلى الله عليه وسلم إنك قلت ما قلت وفي نفس أصحابي شيء من ذلك فإن أحببت فقل بين أيديهم ما", "english": "The Messenger of Allah (Peace Be Upon Him) was delicate of skin, subtle in his outward and inward being; his anger and his pleasure were known in his face. (7) And when his feeling intensified, he would increase his touching of his noble beard. (8) And he never addressed anyone with what he disliked. A man entered upon him with yellowness [of dye] upon him, and he disliked it, yet he said nothing to him until he left. Then he said to some of the people: \"Would that you had said to this man: let him leave this\" — meaning the yellowness. And a Bedouin urinated in the mosque in his presence, and the Companions (may Allah be pleased with them) rushed at him. The Prophet (Peace Be Upon Him) said: \"Do not interrupt him\" — that is, do not cut off his urination. Then he said to him: \"These mosques are not fit for any filth, urine, or excrement.\" (1) And in another narration: \"Draw near, and do not repel.\"", "book_title": "Etiquette of Living and Prophetic Character", "section_title_ar": "Section 567", "section_title_en": "The Revival of the Religious Sciences — Book on the Etiquette of Prophethood: Section on His (Peace Be Upon Him) Overlooking What He Disliked, and His Generosity", "section_index": 567, "anchors": "- Root: رق ق (Raqq)\n  * Lisan / Ayn: رقيق البشرة — delicate, fine, soft in skin; thin and subtle in substance.\n  * Al-Raghib (Mufradat): Denotes fineness of the corporeal envelope, yet here extended to inward subtlety (al-latāfah al-bāṭiniyyah), indicating a divinely polished temperament.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for skin; metaphorical (majāz) for character—\"latīf al-ẓāhir wa al-bāṭin\" shifts from the sensory to the moral-spiritual register.\n- Root: وج د (Wajd)\n  * Lisan / Ayn: وج د — intense emotion, found anger or grief; \"ishdadda wajduhu\" — when his feeling intensified.\n  * Al-Raghib (Mufradat): In Kalam, wajd is an affective state of the soul, not a mere passing whim; here it denotes righteous displeasure.\n  * Al-Zamakhshari (Asas): Literal: to find; metaphorical: the surge of an overpowering emotion that \"finds\" its object.\n- Root: ز ر م (Zarama)\n  * Lisan / Ayn: أَزْرَمَ — to cut off, sever, interrupt a flow; \"lā tazrimūhu\" — do not cut off his urine.\n  * Al-Raghib (Mufradat): Not a Quranic root but a Prophetic usage; denotes abrupt cessation of a natural act, which is harmful.\n  * Al-Zamakhshari (Asas): Literal: to sever a continuous stream; here applied to the Bedouin's urination—an act of interruption that would cause physical harm.\n- Root: ع ض ه (Aḍah)\n  * Lisan / Ayn: العَضَاه — thorny desert trees, the 'idāh (plural: ʿiḍāh) of the acacia type; used as a measure of abundance.\n  * Al-Raghib (Mufradat): Not a theological term; in Prophetic rhetoric, it is a concrete, sensory metaphor for countless wealth.\n  * Al-Zamakhshari (Asas): Literal: the trees themselves; metaphorical: the sheer number of camels equal to these trees—hyperbole for limitless generosity.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the placement of \"la-hu\" and similar particles, where the prepositional phrase is fronted for emphasis (takhrīb) or to avoid ambiguity, as in \"لو كان لي عدد هذه العضاة نعما\" — the interposition of \"li\" before the quantified noun clarifies the conditional scope.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Living and Prophetic Character'", "badge": "Hadith"}], "64": [{"arabic": "بينك وبين الخلق فأما التي لي تعبدني ولا تشرك بي شيئا وأما التي لك فعملك أجزيك به أفقر ما تكون إليه وأما التي بيني وبينك فعليك الدعاء وعلي الإجابة وأما التي بنيك وبين الناس فتصحبهم بالذي تحب أن يصحبوك به وسأل موسى عليه السلام الله تعالى فقال أي رب أي عبادك أعدل قال من أنصف من نفسه ومنها أن يزيد في توقير من تدل هيئته وثيابه على علو منزلته فينزل الناس منازلهم روي أن عائشة رضي الله عنها كانت في سفر فنزلت منزلا فوضعت طعامها فجاء سائل فقالت عائشة ناولوا هذا المسكين قرصا ثم مر رجل على دابة", "english": "**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 433", "section_title_en": "The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims", "section_index": 433, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}], "77": [{"arabic": "وسلم ثلاثة لا يكلمهم الله ولا ينظر إليهم ولا يزكيهم ولهم عذاب أليم شيخ زان وملك كذاب وعائل مستكبر (4) حديث عبد الله بن عامر جاء رسول الله صلى الله عليه وسلم إلى بيتنا وأنا صبي صغير فذهبت لألعب فقالت أمي يا عبد الله تعال أعطيك فقال وما أردت أن تعطيه قالت تمرا فقال إن لم تفعلي كتبت عليك كذبة رواه أبو داود وفيه من لم يسم وقال الحاكم أن عبد الله بن عامر ولد في حياته صلى الله عليه وسلم ولم يسمع منه قلت وله شاهد من حديث أبي هريرة وابن مسعود ورجالهما ثقات إلا أن الزهري لم يسمع من أبي هريرة وق", "english": "Among them is the hadith: \"And three whom God hates: the trader or seller who swears much.\" Ahmad narrated it, and the wording is his. In its chain is Ibn al-Aḥmaṣ, whose condition is unknown. Both Ahmad and al-Nasā'ī narrated it with another wording through a sound chain. And al-Nasā'ī has, from the hadith of Abū Hurayrah: \"Four whom God abhors: the seller who swears much\" — the hadith — and its chain is sound.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 676", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 676: On Lying (al-Kadhib) — Hadith Reports and Traditions (Āthār)", "section_index": 676, "anchors": "- Root: كذب (Kadhaba)\n  * Lisan / Ayn: Core meaning: to report a falsehood, to utter what is contrary to reality; al-Kadhdhābah: a variegated cloth that deceives the eye into thinking it is part of the ceiling — indicating the deceptive semblance of truth.\n  * Al-Raghib (Mufradat): Kadhib applies to both speech and action. God says: {«Only they forge falsehood who do not believe in God's signs»} (Q 16:105) — the hypocrites' speech was true, but their inward conviction was false, so God called them liars (kādhibūn) regarding their belief.\n  * Al-Zamakhshari (Asas): Literal (Haqīqah): \"He is kadhib, kadhūb, kadhāb, kaydhabān\" — one who lies habitually. Metaphorical (Majāz): \"He carried [the burden] then lied\" — i.e., he cowardly retreated, making his charge a false one; \"the she-camel lied\" — her pregnancy proved false.\n- Root: حدث (Ḥadatha)\n  * Lisan / Ayn: Core meaning: to originate, to bring into being after non-existence; al-ḥadīth: speech that is new/recently originated.\n  * Al-Raghib (Mufradat): \"Al-Ḥudūth: a thing's coming to be after it was not — whether accident or substance. Its creation (iḥdāth) belongs solely to God. Al-muḥdath: what is brought into existence after non-existence.\" God says: {«There comes not to them a fresh reminder (dhikr muḥdath) from their Lord»} (Q 21:2).\n  * Al-Zamakhshari (Asas): Literal: \"He spoke a ḥadīth; fresh in age.\" Metaphorical: \"They became aḥādīth (topics of talk)\"; ʿUmar was called muḥaddath — one whose intuition is divinely inspired, as if truth were spoken into him.\n- Root: ويل (Wayl)\n  * Lisan / Ayn: An expression of intense woe, destruction, and chastisement; a word of threat and condemnation.\n  * Al-Raghib (Mufradat): Wayl denotes severe affliction and ruin; it is a declaration of impending punishment.\n  * Al-Zamakhshari (Asas): Literal: \"Woe to him\" — a cry of ruin. Used in threats: \"Waylun lahu\" — destruction is his due.\n- Root: شنأ (Shana'a)\n  * Lisan / Ayn: Intense hatred and abhorrence.\n  * Al-Raghib (Mufradat): Al-Shan'ān: intense hatred that drives one to shun the object.\n  * Al-Zamakhshari (Asas): Literal: \"He hated him with shan'an\" — vehement hatred.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating it for all else. Applied in the verse: {«Only they forge falsehood who do not believe»} — restricting fabrication to the disbelievers, affirming that the believer does not lie.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'", "badge": "Hadith"}], "83": [{"arabic": "وهو أحد والآصال التي ذكرها الله تعالى إذ قال ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال وإذا سجد لله عز وجل الجمادات فكيف يجوز أن يغفل العبد العاقل عن أنواع العبادات الورد السادس إذا دخل وقت العصر دخل وقت الورد السادس وهو الذي أقسم الله تعالى به فقال تعالى {والعصر} هذا أحد معنيي الآية وهو المراد بالآصال في أحد التفسيرين وهو العشي المذكور في قوله {وعشيا} وفي قوله {بالعشي والإشراق} وليس في هذا الورد صلاة إلا أربع ركعات بين الأذان والإقامة كما سبق في الظهر ثم يصلي الفرض ويشتغل بالأقسام الأربعة المذكورة", "english": "I say: And just as knowledge and remembrance are the nourishment of the heart, which can never be cut off from it, so too the measure of moderation is this; and deficiency from it may lead to the disturbance of the body — except for one who accustoms himself to wakefulness gradually, for he may train himself upon it without disturbance. And this litany (wird) is among the longest of the litanies and the most delightful for the worshippers, and it is one of the \"evenings and mornings\" (al-āṣāl) which God Most High mentioned when He said: {«ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال»} \"And to God prostrates whoever is in the heavens and the earth, willingly or unwillingly, and their shadows, in the mornings and the evenings\" (Q. 13:15). And when inanimate objects prostrate to God, Mighty and Majestic, how then can the intelligent servant be heedless of the varieties of worship?", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 261", "section_title_en": "The Seventh Daily Litany (Al-Wird al-Sābiʿ): The Time of Sunset — The Completion of the Day's Litanies and Self-Accounting", "section_index": 261, "anchors": "- Root: ورد (warada)\n  * Lisan / Ayn: The root denotes arriving at water, seeking it, and drinking from it; also the portion or share of water allotted for drinking at a specific time.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — the core meaning is the intentional approach to water; the litany (wird) is the appointed portion of devotional recitation, likened to the daily share of water that a person must take to sustain life.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the act of arriving at water. Metaphorical (Majaz): \"ورد علي كتاب سرني مورده\" — a book arrived upon me whose arrival pleased me; likewise, the wird is the arrival of the appointed time for worship, and the soul's approach to the fountain of divine remembrance.\n- Root: عصر (ʿaṣr)\n  * Lisan / Ayn: The root denotes pressing, squeezing, and extracting; also the time of afternoon, so called because it is the pressing of the day's end.\n  * Al-Raghib (Mufradat): The ʿaṣr is the latter part of the day; God swore by it in {«والعصر»} (Q. 103:1), indicating its great merit.\n  * Al-Zamakhshari (Asas): Literal: the afternoon time. Metaphorical: the pressing of one's life — as the day is pressed at its end, so the life of man is pressed at its term.\n- Root: غرب (gharaba)\n  * Lisan / Ayn: The root denotes disappearance, absence, and setting; the sun's setting (ghurūb) is its concealment from the eye.\n  * Al-Raghib (Mufradat): The setting of the sun marks the boundary between the day's works and the night's; it is the terminus of the visible world's diurnal cycle.\n  * Al-Zamakhshari (Asas): Literal: the sun's descent below the horizon. Metaphorical: the setting of the sun of life — the death of man, after which there is no rising.\n- Root: حاسب (ḥāsaba)\n  * Lisan / Ayn: The root denotes reckoning, counting, and taking account; muḥāsabah is the mutual reckoning between two parties.\n  * Al-Raghib (Mufradat): Self-accounting (muḥāsabat al-nafs) is the soul's reckoning with itself over its deeds before the Day of Reckoning, for \"one who reckons himself before he is reckoned\" is among the wise.\n  * Al-Zamakhshari (Asas): Literal: the arithmetic counting of sums. Metaphorical: the soul's audit of its own works, weighing the day's deeds against the standard of the Sacred Law.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governing verb, as in the construction \"فسبحان الله حين تمسون\" where the adverbial clause is interposed to emphasize the temporal specification of the act of glorification.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Remembrance of Death and Afterlife'", "badge": "Dhikr"}], "87": [{"arabic": "في ديننا ما ليس منه فهو رد (2) وفي خبر آخر من غش أمتي فعليه لعنة الله والملائكة والناس أجمعين قيل يا رسول الله وما غش أمتك قال أن يبتدع بدعة يحمل الناس عليها (3) وقال رسول الله صلى الله عليه وسلم إن لله عز وجل ملكا ينادي كل يوم من خالف سنة رسول الله صلى الله عليه وسلم لم تنله شفاعته (4) ومثال الجاني على الدين بإبداع ما يخالف السنة بالنسبة إلى من يذنب ذنبا مثال من عصى الملك في قلب دولته بالنسبة إلى من خالف أمره في خدمة معينة وذلك قد يغفر له فأما في قلب الدولة فلا وقال بعض العلماء ما تكلم فيه السلف فالسكوت عنه جفاء وما سكت عنه السلف فالكلام في", "english": "For this reason ʿAlī, may God be pleased with him, said — when it was said to him, \"You have opposed so-and-so\" — \"The best of us is the most following of us of this religion.\" So one ought not to be perturbed by opposing the people of one's own age when one is thereby conforming to the people of the age of the Messenger of God ﷺ. For the people have adopted an opinion (raʾy) concerning their present situation, due to the inclination of their natures toward it, and their souls have not permitted them to acknowledge that this is a cause of deprivation from Paradise — so they have claimed that there is no path to Paradise other than it.", "book_title": "Book of Knowledge", "section_title_ar": "Section 64", "section_title_en": "** Section 64 — On the Sciences of the Inner Life: The Obligation to Follow the Salaf and the Condemnation of Innovation (Bidʿah)", "section_index": 64, "anchors": "**\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning — perception of a thing by its true nature; knowledge as the apprehension of reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon the thing.\n  * Al-Zamakhshari (Asas): Literal usage — \"ما علمت بخبرك: ما شعرت به\" (I did not know of your news: I had no awareness of it). The scholar (ʿālim) is one whose knowledge is manifest in action.\n- Root: بدع (badaʿa)\n  * Lisan / Ayn: Core meaning — to originate, to create something new without prior example.\n  * Al-Raghib (Mufradat): \"الإبداع: إنشاء صنعة بلا احتذاء واقتداء\" — origination of a thing without model or precedent. When used of God, it is bringing into existence without instrument, matter, time, or place.\n  * Al-Zamakhshari (Asas): Literal — \"أبدع الشيء وابتدعه: اخترعه\" (he originated it and innovated it: he invented it). Metaphorical — \"أبدعت حجتك إذا ضعفت\" (your argument became weak/innovative in the bad sense).\n- Root: حدث (ḥadatha)\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — coming-to-be of a thing after it was not. \"المحدث: ما أوجد بعد أن لم يكن\" — the originated thing.\n  * Al-Zamakhshari (Asas): Literal — \"هو حدث من الأحداث\" (he is a youth among youths). Metaphorical — \"صاروا أحاديث\" (they became [mere] tales). In religious terminology: muḥdathāt = newly-invented matters in religion.\n- Root: هدى (hadā)\n  * Al-Raghib (Mufradat): Guidance — directing to the path with gentleness; al-hudā is the guidance of the Prophet ﷺ in matters of religion.\n  * Al-Zamakhshari (Asas): \"حسن الهدى\" — excellent guidance, the prophetic way (sunnah) as opposed to innovation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما هما اثنتان: الكلام والهدى\" restricts the two matters exclusively to speech and guidance, excluding all else.\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "88": [{"arabic": "الدنيا بالآخرة فلا يخفف عنهم العذاب ولا هم ينصرون وإذا عظمت غوائل الدنيا وشرورها فلا بد أولا من معرفة حقيقة الدنيا وما هي وما الحكمة في خلقها مع عداوتها وما مدخل غرورها وشرورها فإن من لا يعرف الشر لا يتقيه ويوشك أن يقع فيه ونحن نذكر ذم الدنيا وأمثلتها وحقيقتها وتفصيل معانيها وأصناف الأشغال المتعلقة بها ووجه الحاجة إلى أصولها وسبب انصراف الخلق عن الله بسبب التشاغل بفضولها إن شاء الله تعالى وهو المعين على ما يرتضيه", "english": "Praise be to God, who made His friends acquainted with the calamitous snares of this world and its afflictions, and uncovered for them its defects and its shameful parts, until they gazed upon its evidences and its signs, and weighed its evil deeds against its good deeds. Thus they came to know that its objectionable aspects exceed its commendable ones, that what is hoped from it does not fulfill what is feared from it, and that its rising is not safe from its eclipse. Yet it is in the likeness of a comely woman who draws people to herself by her beauty — while within her are hidden secrets of evil, ugly things that destroy those who yearn for union with her. Then she is a fleer from her seekers, niggardly in her turning toward them; and when she does turn, one is not secure from her evil and her pestilence. If she does good for an hour, she does evil for a year; and if she does evil once, she makes it her perpetual habit. So the cycles of her turning are ever more tightly drawn, and the commerce of her sons is losing and ruined, and her afflictions in succession strike the breasts of her seekers, and the courses of her states proclaim the humiliation of those who pursue her. Thus every one deluded by her is destined to abasement, and every one who waxes proud through her proceeds to regret. Her very nature is to flee from her seeker and to be sought by the one who flees from her. Whoever serves her, she eludes; whoever turns away from her, she comes to. Her clarity is never free of the admixture of turbidity, nor is her joy ever disentangled from what embitters it. Her soundness bequeaths sickness, her youth drives on to decrepitude, and her bliss bears no fruit but remorse and regret. She is deceitful, guileful, fleeting, evasive. She never ceases adorning herself for her seekers until, when they have become her lovers, she bares her fangs at them, disorders the ordered strands of their affairs, and uncovers for them the hidden store of her wonders — then she makes them taste the lethal poisons and strikes them with the piercing shafts of her arrows. While her companions are in joy and bounty from her, suddenly she turns away from them as though she were but scattered dreams; then she rushes upon them with her calamities, grinds them as grain is ground, and shrouds them in their winding-sheets beneath the dust. If she has possessed one of them with all that the sun has risen upon, she makes him as reaped harvest, as though he had not dwelt in plenty the day before. Her companions desire joy from her, and she promises them delusion — until they hope for much and build palaces, and then their palaces become graves, their gatherings become ruin, their striving becomes scattered dust, and their cry becomes \"Woe and destruction!\" Such is her description — and the command of God is a decree determined. And the prayer and peace be upon Muhammad, His servant and His Messenger, sent to the worlds as a bringer of glad tidings and a warner, and as an illuminating lamp; and upon those of his family and companions who were for him supporters in the religion, and against the wrongdoers helpers; and abundant peace.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 729", "section_title_en": "The Book of Condemnation of This World — Being the Sixth Book of the Quarter of the Destructive Things from The Revival of the Religious Sciences", "section_index": 729, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core root meaning of swallowing, devouring, or ingesting wholly\n  * Al-Raghib (Mufradat): الإلهام: casting something into the heart (al-rawʿ), specifically from God or the higher assembly; the root denotes the soul's complete reception, as one who swallows entirely\n  * Al-Zamakhshari (Asas): Literal: ألهمه الله الخير — God cast good into his heart. Metaphorical: جيش لهم — an army that engulfs and swallows whomever enters it\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter\n  * Al-Raghib (Mufradat): الدنو: proximity by essence or by judgment, used of place, time, and station; al-dunyā is the nearer, lower life\n  * Al-Zamakhshari (Asas): Literal: هو دانٍ — he is near. Metaphorical: الأدنى — the inferior, the baser, contrasted with what is better\n- Root: حسر (ḥ-s-r)\n  * Lisan / Ayn: Uncovering, stripping away a covering; exhaustion from exposure of one's strength\n  * Al-Raghib (Mufradat): الحسر: uncovering what veils; al-ḥasīr: one whose strength is laid bare and spent; al-ḥāsir: the weary whose powers are uncovered as exhausted\n  * Al-Zamakhshari (Asas): Literal: حسر عن ذراعيه — he bared his forearms. Metaphorical: فلان كريم المحسر — so-and-so is noble when tested/examined (his hidden quality is uncovered)\n- Root: سرر (s-r-r)\n  * Lisan / Ayn: Concealment, the secret kept hidden in the breast; the innermost\n  * Al-Raghib (Mufradat): الإسرار: opposite of declaration; al-sirr: the speech concealed in the soul\n  * Al-Zamakhshari (Asas): Literal: أسر الحديث — he concealed the speech. Metaphorical: أعطيتك سره — I gave you its choicest essence; هو في سر النسب — he is in the pure core of lineage\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase when the interposed element is complete in itself, as in the rhetorical suspensions of this oration", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}], "92": [{"arabic": "وكان عبد الله بن عمر يتصدق بالسكر ويقول سمعت الله يقول لن تنالوا البر حتى تنفقوا مما تحبون والله يعلم أني أحب السكر وقال النخعي إذا كان الشيء لله عز وجل لا يسرني أن يكون فيه عيب وقال عبيد بن عمير يحشر الناس يوم القيامة أجوع ما كانوا قط وأعطش ما كانووا قط وأعرى ما كانوا قط فمن أطعم لله عز وجل أشبعه الله ومن سقى لله عز وجل سقاه الله ومن كسا لله عز وجل كساه الله وقال الحسن لو شاء الله لجعلكم أغنياء لا فقير فيكم ولكنه ابتلى بعضكم ببعض وقال الشعبي من لم ير نفسه إلى ثواب الصدقة أحوج من الفقير إلى صدقته فقد أبطل صدقته وضرب بها وجهه وق", "english": "Among the reports [concerning charity], his saying (peace and blessings be upon him): \"Give charity, even if with a single date-fruit, for it stays the hunger of the hungry and extinguishes sin just as water extinguishes fire.\" (1) And he said (peace and blessings be upon him): \"Guard yourselves against the Fire, even if with half a date-fruit; and if you find not even that, then with a kind word.\" (2) And he said (peace and blessings be upon him): \"There is no Muslim servant who gives charity from lawful earnings — and God accepts only what is lawful — but that God takes it in His Right Hand and nurtures it just as one of you nurtures his foal, until the single date-fruit grows to be like Mount Uḥud.\" (3) And he said (peace and blessings be upon him) to Abū al-Dardāʾ: \"When you cook a broth, increase its water, then look to a household among your neighbors and bestow upon them from it with kindness.\" (4) And he said (peace and blessings be upon him): \"No servant does well in charity but that God (mighty and majestic) does well for him in the stewardship of what he leaves behind.\" (5) And he said (peace and blessings be upon him): \"Every person is in the shade of his charity until judgment is rendered between the people.\" (6) And he said (peace and blessings be upon him): \"Charity closes seventy doors of evil.\" (7) And he said (peace and blessings be upon him): \"Secret charity extinguishes the wrath of the Lord (mighty and majestic).\" And the Messenger of God (peace and blessings be upon him) said: \"The one who gives from abundance is not more excellent in reward than the one who accepts from need.\" (8) Perhaps what is meant thereby is the one who intends, by the repelling of his need, to free himself for religion — so that he becomes equal to the giver who intends, by his giving, the flourishing of his religion.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 181", "section_title_en": "The Book of the Etiquettes of Eating — Section on the Merits of Charity (Ṣadaqah) and Its Etiquettes", "section_index": 181, "anchors": "- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Core meaning of truthfulness, veracity in speech and action; al-Raghib notes its origin is in speech (al-qawl), whether past or future, promise or otherwise.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood originate in utterance; charity (ṣadaqah) is so named because it is the truthful verification of one's faith through material sacrifice.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صدقته الحديث\" — to affirm someone's statement as true. Metaphorical (majāz): \"رجل صادق الحملة\" — a man truthful in his charge (i.e., steadfast in battle). Charity is thus the \"truthing\" of one's claim to faith by action.\n- Root: عله (ʿ-l-h) — [Note: This root appears in the scholia but is not directly relevant to the present text; the governing root for \"feeding\" is أ-ك-ل and for \"giving\" is ع-ط-ي]\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the sensing of fear within oneself.\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {«إِنَّمَا الْمُؤْمِنُونَ الَّذِينَ إِذَا ذُكِرَ اللَّهُ وَجِلَتْ قُلُوبُهُمْ»}\" — the believers are those whose hearts tremble when God is mentioned.\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a people fearful. The root conveys the inner trepidation of the heart before divine majesty.\n- Root: سبع (s-b-ʿ)\n  * Al-Raghib (Mufradat): \"أصل السبع العدد\" — the root origin is the number seven; used for the seven heavens, seven earths, and in the present context, the seventy (seventy being a multiple of seven) doors of evil.\n  * Al-Zamakhshari (Asas): Literal: \"هو سابع سبعة\" — he is the seventh of seven. Metaphorical (majāz): \"أخذه أخذ سبعة\" — \"he seized with the seizure of seven,\" a proverb for intense, overwhelming force. The number seventy thus signifies multiplicity and completeness in repelling evil.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" (إنما) restricts and confines the predicate to the subject alone, negating it for all others. This is crucial in the ḥadīth: \"إنما هي أوساخ الناس\" — charity is exclusively the filth of people, restricted to them and forbidden for the Prophet's family.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Mysteries of Zakat'", "badge": "Afterlife"}], "95": [{"arabic": "محمد صلى الله عليه وسلم وملة أبينا إبراهيم حنيفا وما كان من المشركين (9) اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت وإليك المصير (10) اللهم إني أسألك أن تبعثنا في هذا اليوم إلى كل خير ونعوذ بك أن نجترح فيه سوءا أو نجره إلى مسلم فإنك قلت {وهو الذي يتوفاكم بالليل ويعلم ما جرحتم بالنهار ثم يبعثكم فيه ليقضى أجل مسمى} (11) اللهم فالق الإصباح وجاعل الليل سكنا والشمس والقمر حسبانا أسألك خير هذا اليوم وخير ما فيه وأعوذ بك من شره وشر ما فيه (12) بسم الله ما شاء الله لا قوة إلا بالله ما شاء الله", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "97": [{"arabic": "وقد قال الله تعالى ولله على الناس حج البيت من استطاع إليه سبيلا وإذا وجب عليه التصدق بما يزيد على حاجته حيث يغلب على ظنه تحريمه فالزكاة أولى بالوجوب وإن لزمته كفارة فليجمع بين الصوم والإعتاق ليتخلص بيقين وقد قال قوم يلزمه الصوم دون الإطعام إذ ليس له يسار معلوم وقال المحاسبي يكفيه الإطعام والذي نختاره أن كل شبهة حكمنا بوجوب اجتنابها وألزمناه إخراجها من يده لكون احتمال الحرام أغلب على ما ذكرناه فعليه الجمع بين الصوم والإطعام أما الصوم فلأنه مفلس حكما وأما الإطعام فلأنه قد وجب عليه التصدق بالجميع ويحتمل أن يكون له ف", "english": "As for the case where the wealth is of a doubtful nature (shubhah), such that it is possible that it is lawful — if he does not remove it from his hand, then Hajj is incumbent upon him, because its being lawful is possible, and Hajj is not waived except by [verified] poverty, and his poverty has not been verified [as a legal certainty]. And Allah Most High has said: {«وَلِلَّهِ عَلَى النَّاسِ حِجُّ الْبَيْتِ مَنِ اسْتَطَاعَ إِلَيْهِ سَبِيلًا»} — \"And unto Allah is incumbent upon mankind the pilgrimage to the House — for whoever is able to find a way thereto\" {Āl ʿImrān 3:97}. And if it is incumbent upon him to give in charity (al-taṣadduq) whatever exceeds his need, in a case where the preponderance of his opinion (ghalabat al-ẓann) is that it is unlawful, then Zakat is even more deserving of being obligatory. And if an expiation (kaffārah) becomes incumbent upon him, let him combine between fasting and manumission (al-ṣawm wa al-iʿtāq), so that he may be delivered with certainty.", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 382", "section_title_en": "Section 382 — On the One in Whose Possession Is Purely Unlawful Wealth, and the Rulings of Hajj, Zakat, and Expiation Therefrom", "section_index": 382, "anchors": "- Root: وجب (wajaba)\n  * Lisan / Ayn: Core meaning of \"to be established, fixed, or incumbent\"; from it derives the legal sense of obligation that is firmly settled upon a person.\n  * Al-Raghib (Mufradat): \"Al-wujūb: al-thubūt\" — obligation is the establishment of a thing as binding; it is used in contrast to the merely possible, and in legal-theological terms denotes what one is blameworthy for omitting.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"Wajaba lahu ʿalayya kadhā\" — a debt or right is confirmed against one. Metaphorical (majāz): \"Wajaba al-bayʿ\" — the sale contract becomes binding and irrevocable.\n- Root: سال (sāla)\n  * Lisan / Ayn: Core meaning of \"to flow, to stream forth\"; from it derives the notion of that which pours out and is expended.\n  * Al-Raghib (Mufradat): \"Sāla al-shayʾ yasīlu\" — flowing is the natural motion of liquid; metaphorically extended to the pouring out of wealth in expenditure.\n  * Al-Zamakhshari (Asas): Literal: \"Sāla al-māʾ\" — water flows. Metaphorical: the flow of wealth from one's hand in giving.\n- Root: صوم (ṣāma)\n  * Lisan / Ayn: Core meaning of \"abstention, restraint, holding back.\"\n  * Al-Raghib (Mufradat): \"Al-ṣawm fī al-aṣl: al-imsāk ʿan al-fiʿl\" — fasting in its root sense is abstention from any act, whether food, speech, or movement; hence the horse that refrains from fodder is called ṣāʾim.\n  * Al-Zamakhshari (Asas): Literal: \"Shahr al-ṣawm\" — the month of fasting. Metaphorical: \"Ṣāma al-faras ʿalā āriyyihi\" — the horse abstains from its fodder, extended to any withholding.\n- Sibawayh Rule: Rule of Specification and Restriction (Bāb al-Takhṣīṣ) — When a general command (like the obligation of Hajj) is conditioned by a qualifier (like \"whoever is able to find a way\"), the condition restricts the scope of the obligation; likewise, when a legal cause (ʿillah) is established by a preponderant probability (ghalabat al-ẓann), the ruling follows the established cause.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'The Lawful and Prohibited'", "badge": "Insight"}, {"arabic": "ومن أساء فعليها والله غنى عن العالمين ويحك يا نفس انزعى عن جهلك وقيسى آخرتك بدنياك فما خلقكم ولا بعثكم إلا كنفس واحدة وكما بدأنا أول خلق نعيده وكما بدأكم تعودون وسنة الله تعالى لا تجدين لها تبديلا ولا تحويلا ويحك يا نفس ما أراك إلا ألفت الدنيا وأنست بها فعسر عليك مفارقتها وأنت مقبلة على مقاربتها وتؤكدين في نفسك مودتها فاحسن أنك غافلة عن عقاب الله وثوابه وعن أهوال القيامة وأحوالها فما أنت مؤمنة بالموت المفرق بينك وبين محابك أفترين أن من يدخل دار ملك ليخرج من الجانب الآخر فمد بصره إلى", "english": "...from creation, but rather you attain your goal through every stratagem. And by this ignorance you deserve the title of foolishness from the Messenger of God, may God bless him and grant him peace, where he said: \"The shrewd one is he who holds his soul to account and works for what comes after death, and the foolish one is he who follows his soul's whims and harbors vain hopes upon God.\" {«الكيس من دان نفسه وعمل لما بعد الموت والأحمق من أتبع نفسه هواها وتمنى على الله الأماني»}", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1253", "section_title_en": "Section 1253 — The Soul's Self-Reproach and the Awakening from Negligence", "section_index": 1253, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates and is addressed as an independent moral agent.\n  * Al-Raghib (Mufradat): The soul as the locus of divine address and self-knowledge; its essence (dhāt) is the referent of God's \"self\" in revelation, yet here it is the reproaching subject.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) usage as the speaking, desiring self; metaphorical (majāz) extension to blame and counsel, as in \"self-accusation\" (lawwāmah).\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of life; the inevitable terminus of every soul.\n  * Al-Raghib (Mufradat): Death as separation (furqah) from worldly attachments and the transition to reckoning; linked to the soul's journey.\n  * Al-Zamakhshari (Asas): Literal death of the body; metaphorical \"death\" of the heart through heedlessness, contrasted here with physical death as the ultimate wake-up call.\n- Root: جهل (j-h-l)\n  * Lisan / Ayn: Ignorance as the absence of knowledge; folly and rashness.\n  * Al-Raghib (Mufradat): Ignorance as the soul's failure to perceive true realities, leading to misplaced desires and false hopes.\n  * Al-Zamakhshari (Asas): Literal ignorance of facts; metaphorical ignorance as moral stupidity, as when the soul follows whims despite clear signs.\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): Drawing near (dunūw) to God through obedience, contrasted with the soul's clinging to the near (dunyā) world.\n  * Al-Zamakhshari (Asas): Literal proximity; metaphorical use for the \"lower\" world (dunyā) as that which is nearer and inferior.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize exclusive causation, e.g., \"God's generosity is only in guiding you to the path,\" restricting divine favor to guidance, not exemption from effort.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'", "badge": "Afterlife"}], "100": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "102": [{"arabic": "ويحذركم الله نفسه وقوله عز وجل اتقوا الله حق تقاته وأما الأول فهو خوف عموم الخلق وهو حاصل بأصل الإيمان بالجنة والنار وكونهما جزاءين على الطاعة والمعصية وضعفه بسبب الغفلة وسبب ضعف الإيمان وإنما تزول الغفلة بالتذكير والوعظ وملازمة الفكر في أهوال يوم القيامة وأصناف العذاب في الآخرة وتزول أيضا بالنظر إلى الخائفين ومجالستهم ومشاهدة أحوالهم فإن فاتت المشاهدة فالسماع لا يخلو عن تأثير وأما الثاني وهو الأعلى فأن يكون الله هو المخوف أعني أن يخاف العبد الحجاب عنه ويرجو القرب منه قال ذو النون رحمه الله تعالى خو", "english": "I say: Know that what we have mentioned concerning the state of patience and what we have elaborated in the Book of Patience and Gratitude is sufficient for this purpose. For patience cannot be realized except after the attainment of fear (*khawf*) and hope (*rajāʾ*). This is because the first of the stations of religion is certainty (*yaqīn*), which is an expression for the strength of faith in God — may He be exalted — in the Last Day, Paradise, and Hellfire. This certainty, by necessity, stirs up fear of the Fire and hope for the Garden. And hope and fear together strengthen one for patience. For Paradise has been enveloped by distasteful things (*huffat bil-makārih*), so none can bear them except by the strength of hope; and the Fire has been enveloped by lusts (*huffat bil-shahawāt*), so none can suppress them except by the strength of fear. For this reason, ʿAlī — may God honor his face — said: \"Whoever yearns for Paradise turns away from lusts, and whoever dreads the Fire desists from forbidden things.\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1048", "section_title_en": "The Station of Fear (Khawf) — Its Two Degrees and the Path to Certainty", "section_index": 1048, "anchors": "- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being afraid; its verbal forms encompass both the internal emotion and the external causing of fear in another.\n  * Al-Raghib (Mufradat): Fear is \"the anticipation of something disliked, based on a conjectured or known indication,\" standing in direct opposition to *amn* (security). It applies to both worldly and otherworldly matters, as in {«يَدْعُونَ رَبَّهُمْ خَوْفًا وَطَمَعًا»} (They call upon their Lord in fear and hope).\n  * Al-Zamakhshari (Asas): Literal (*haqiqah*): \"I feared for my wealth\" — direct, unmediated dread of a known cause. Metaphorical (*majaz*): \"A fearful road\" — where the road itself is described as fearsome because of what it contains, or \"the journey consumed the camel's hump little by little,\" i.e., gradual diminution as if out of fear.\n- Root: عرف (ʿArifa)\n  * Lisan / Ayn: To know by tracing a thing's distinctive mark (*ʿaraf*); recognition through discernment of identifying features.\n  * Al-Raghib (Mufradat): \"Knowledge (*maʿrifah*) and recognition (*ʿirfān*): the apprehension of a thing through reflection and deliberation upon its trace — more specific than mere knowledge (*ʿilm*).\" It is said of a human that he \"knows God\" (*yaʿrifu Allāh*), not that he \"knows God\" (*yaʿlamu Allāh*) transitively to a single object, because human knowledge of God is through contemplating His effects, not grasping His essence.\n  * Al-Zamakhshari (Asas): Literal: \"I will surely make you recognize what I have done\" — i.e., requite you for it. Recognition here is tied to direct encounter and consequence.\n- Root: صبر (Ṣabr)\n  * Lisan / Ayn: Restraint and holding back; endurance in constriction.\n  * Al-Raghib (Mufradat): \"Patience: self-restraint within hardship... the withholding of the soul upon what reason and Law require, or from what they require withholding it from.\" Its specific names vary by context: in battle it is courage; in calamity it is patience proper; against desire it is continence.\n  * Al-Zamakhshari (Asas): Literal: \"I bore patiently what I dislike, and refrained from what I love.\" Metaphorical: \"My hand does not endure the cold\" — attributing endurance to a limb as a vehicle for the self's capacity.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد بإنما) — The construction \"إنما يخشى الله من عباده العلماء\" (Only the learned among His servants fear God) restricts the predicate of true, vision-based fear exclusively to the scholars, distinguishing it from the general, imitative fear of the common believers.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Fear and Hope'", "badge": "Afterlife"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "103": [{"arabic": "إخوانا} أي بالألفة ثم ذم التفرقة وزجر عنها فقال عز من قائل واعتصموا بحبل الله جميعا ولا تفرقوا إلى لعلكم تهتدون وقال صلى الله عليه وسلم إن أقربكم مني مجلسا أحاسنكم أخلاقا الموطئون أكنافا الذين يألفون ويؤلفون (2) وقال صلى الله عليه وسلم المؤمن آلف مألوف ولا خير فيمن لا يألف ولا يؤلف حديث والمؤمن آلف مألوف ولا خير فيمن لا يألف ولا يؤلف رواه أحمد والطبراني من حديث سهل بن سعد والحاكم من حديث أبي هريرة وصححه (3) حديث من أراد الله به خيرا رزقه أخا صالحا إن نسي ذكره وإن ذكر أعانه غريب بهذا اللفظ والمعروف أن ذلك في الأمير ورواه أبو دا", "english": "Know that affability (al-ulfah) is the fruit of excellent character (ḥusn al-khuluq), and estrangement (al-tafarruq) is the fruit of evil character. For excellent character necessitates mutual love, harmony, and concord, whereas evil character yields mutual hatred, envy, and turning away (al-tadābur). And whenever the source is praiseworthy, the fruit is likewise praiseworthy. The excellence of good character is not hidden in the religion; indeed, it is that with which God—glorified be He—praised His Prophet, peace be upon him, when He said: {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ} «And indeed, you are upon an immense character» (Al-Qalam: 4). The Prophet, peace be upon him, said: \"The thing which most causes people to enter Paradise is God-consciousness (taqwā) and excellent character.\" (1) Usāmah ibn Sharīk said: \"We said, O Messenger of God, what is the best thing given to a person?\" He said: \"Excellent character.\" (2) He, peace be upon him, also said: \"I was sent only to perfect the noble traits of character.\" (3) He, peace be upon him, said: \"Nothing is heavier in the Balance than excellent character.\" (4) He, peace be upon him, said: \"God does not beautify a person's outward form and his inward character, then feed him to the Fire.\" (5) He, peace be upon him, said: \"O Abū Hurayrah, adhere to excellent character.\" (Page V02P157) Abū Hurayrah, may God be pleased with him, said: \"What is excellent character, O Messenger of God?\" He said: \"That you join the one who cuts you off, forgive the one who wrongs you, and give to the one who deprives you.\" (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 402", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 402: On the Excellence of Affability (Al-Ulfah) and Brotherhood in God", "section_index": 402, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of harmonizing, uniting, and reconciling; the removal of estrangement (al-waḥshah) and the establishment of concord.\n  * Al-Raghib (Mufradat): Theological nuance of ta'līf as the divine act of harmonizing hearts, a blessing bestowed by God alone, as in {لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَّا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) denotes physical joining; metaphorical (majāz) denotes the spiritual and moral concord of hearts, which is the fruit of excellent character (ḥusn al-khuluq).\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: Root meaning of measuring, proportioning, and smoothing; hence, the inherent disposition and moral character of a person.\n  * Al-Raghib (Mufradat): The origination of a thing upon a just measure; for character, it is the inward form (al-ṣūrah al-bāṭinah) of the soul, just as the physical form is its outward shape.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is the physical creation and proportioning; metaphorical (majāz) is the moral and spiritual constitution, praised by God in {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ}.\n- Root: بغض (Bughḍ)\n  * Lisan / Ayn: The opposite of love (ḥubb); intense aversion and hatred.\n  * Al-Raghib (Mufradat): In the Kalam context, al-bughḍ fī Allāh (hatred for God's sake) is a spiritual act of discernment and loyalty, not a mere emotional impulse; it is paired with al-ḥubb fī Allāh as the strongest bond of faith (awthaq ʿurā al-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is personal animosity; metaphorical (majāz) is the righteous aversion to disobedience and the enemies of God, which is a form of devotion.\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — Governing the syntactic flow of conditional and relative clauses, ensuring the periodic structure of the author's argument remains coherent and unbroken.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}, {"arabic": "ابن عباس يقرأ {وكنتم على شفا حفرة من النار فأنقذكم منها} فقال الأعرابي فوالله ما أنقذكم منها وهو يريد أن يوقعكم فيها فقال ابن عباس خذوها من غير فقيه وقال الصنابحي دخلت على عبادة بن الصامت وهو في مرض الموت فبكيت فقال مهلا لم تبكي فوالله ما من حديث سمعته من رسول الله صلى الله عليه وسلم لكم فيه خير إلا حدثتكموه إلا حديثا واحدا وسوف أحدثكموه اليوم وقد أحيط بنفسي سمعت رسول الله صلى الله عليه وسلم يقول من شهد أن لا إله إلا الله وأن محمدا رسول الله حرم الله النار عليه (5) وقال عبد الله ابن عمرو بن ا", "english": "He mentioned me one day, or feared me in a station (1). And the Messenger of God, may God bless him and grant him peace, said: \"When the people of the Fire are gathered in the Fire — and with them, whomsoever God wills of the people of the Qiblah — the disbelievers will say to the Muslims: 'Were you not Muslims?' They will reply: 'Yes.' Then they will say: 'What did your Islam avail you, seeing that you are with us in the Fire?' They will answer: 'We had sins, and we were seized for them.' Then God, Mighty and Glorious, will hear what they have said, and He will command that whoever was in the Fire of the people of the Qiblah be brought out, and they will be brought out. When the disbelievers see that, they will say: 'Would that we had been Muslims, so that we might be brought out as they were brought out.' Then the Messenger of God, may God bless him and grant him peace, recited: {ربما يود الذين كفروا لو كانوا مسلمين} — \"Perhaps those who disbelieve will wish that they had been Muslims\" (Q. 15:2). (2)", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1360", "section_title_en": "On the Vastness of Divine Mercy and the Intercession for the Sinful — Section 1360", "section_index": 1360, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, recollection; also mention, invocation.\n  * Al-Raghib (Mufradat): Al-dhikr is the opposite of forgetfulness (nisyān); it denotes the heart's presence with what is recalled, and the tongue's utterance thereof.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): to recall in the heart or utter on the tongue. Metaphorical (majāz): \"dhakartuhu bi-khayr\" — to speak well of someone, i.e., to raise their mention in honor.\n- Root: خرج (kharaja)\n  * Lisan / Ayn: To exit, depart, emerge from an interior to an exterior.\n  * Al-Raghib (Mufradat): Al-khurūj is the departure of a thing from its place or state; used of the soul leaving the body, and of the damned leaving the Fire.\n  * Al-Zamakhshari (Asas): Literal: spatial egress. Metaphorical: \"kharaja min al-amr\" — to emerge from an affair, i.e., to be free of its obligation; and \"akhrajahu Allāh min al-nār\" — divine extraction by mercy, not by merit.\n- Root: شفع (shafa'a)\n  * Lisan / Ayn: To make even, pair; intercession is making one's supplication a pair with another's need.\n  * Al-Raghib (Mufradat): Al-shafā'ah is the joining of one's intercession to another's request for aid; its reality is the elevation of the intercessor's rank and the remission of the offender's burden.\n  * Al-Zamakhshari (Asas): Literal: pairing. Metaphorical: intercession before a king — the intercessor \"pairs\" his own honor with the petitioner's deficiency.\n- Root: رحم (raḥima)\n  * Lisan / Ayn: Tenderness of heart, compassion; al-Raḥmān is intensive — mercy as an essential attribute.\n  * Al-Raghib (Mufradat): Al-raḥmah is tenderness that necessitates beneficence; when attributed to God, it is pure beneficence (tafaddul) without emotional change.\n  * Al-Zamakhshari (Asas): Literal: the mother's womb (raḥim) as the seat of compassion. Metaphorical: \"arḥam al-rāḥimīn\" — God's mercy as sheer gratuitous giving, exceeding any creaturely pity.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā shafā'atu Rasūlillāh…\" restricts intercession to a specific class, namely those who have burdened themselves with sins, not the innocent.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "104": [{"arabic": "أما الآيات فقوله تعالى ولتكن منكم أمة يدعون إلى الخير ويأمرون بالمعروف وينهون عن المنكر وأولئك هم", "english": "To proceed: Know that enjoining right and forbidding wrong is the greatest pivot (al-quṭb al-aʿẓam) of the religion, and it is the weighty matter for which Allah sent forth all the prophets collectively. Were its carpet folded up, its knowledge and practice neglected, prophethood would be rendered void, religion would dissolve, the interregnum between prophets (fatrah) would become general, misguidance would spread abroad, ignorance would become rampant, corruption would become chronic, the breach would widen, lands would be laid waste, and servants would perish — yet they would not perceive their destruction until the Day of the Summons (yawm al-tanād). {«فإنا لله وإنا إليه راجعون»} — \"Truly we belong to Allah and to Him we return\" — for that which we feared has indeed come to pass. The practice and knowledge of this pivot have become effaced, its reality and vestige utterly obliterated. Dissimulation toward creation (mudāhanat al-khalq) has seized dominion over hearts, and watchfulness of the Creator (murāqabat al-Khāliq) has been erased from them. People have let themselves loose in the pursuit of caprice and lusts with the abandon of beasts. Rare upon the face of the earth is a sincere believer whom no blamer's reproach deters in the cause of Allah. Whoever, therefore, strives to repair this interregnum and to close this breach — whether by undertaking its practice himself or by assuming responsibility for its execution, reviving this extinct sunnah, rising to bear its burdens, and girding himself to bring it back to life — he has singled himself out among creation for reviving a sunnah whose death the age has brought about, and has taken exclusive possession of an act of devotion (qurbah) beside whose summit the degrees of nearness to Allah dwindle to nothing. And now we shall expound its knowledge in four chapters:", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 520", "section_title_en": "The Book of Enjoining Right and Forbidding Wrong — Book Nine of the Quarter of Customs, from The Revival of the Religious Sciences", "section_index": 520, "anchors": "- Root: نكر (nakira)\n  * Lisan / Ayn: Core meaning of denial, rejection, and that which is unrecognized or unfamiliar\n  * Al-Raghib (Mufradat): \"الإنكار: ضد العرفان\" — denial is the opposite of recognition; it is what the heart refuses to conceive, a species of ignorance; the tongue may deny what the heart still holds, and therein lies falsehood\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"نكر أبلغ من أنكر\" — nakira is more emphatic than ankara; it is said nakira is by the heart and ankara by the eye\n- Root: نهي (nahā)\n  * Lisan / Ayn: Prohibition, forbidding, restraint, and reaching an end or limit\n  * Al-Raghib (Mufradat): \"النهي: الزجر عن الشيء\" — prohibition is the repelling of one from a thing; no difference whether by word or by other means; by word it is \"do not do such-and-such\"\n  * Al-Zamakhshari (Asas): Literal: \"نهاه فانتهى\" — he forbade him and he desisted; \"وتناهوا عن المنكر\" — and they mutually desisted from wrong\n- Root: عرف (ʿarafa)\n  * Lisan / Ayn: Recognition, knowledge by reflection and discernment of traces\n  * Al-Raghib (Mufradat): \"المعرفة والعرفان: إدراك الشيء بتفكر وتدبر لأثره\" — knowledge and recognition is the apprehension of a thing by reflection and contemplation of its effect; it is more specific than knowledge (ʿilm) and is opposed by denial (inkār)\n  * Al-Zamakhshari (Asas): Literal: \"لأعرفن لك ما صنعت\" — I shall surely requite you for what you have done; recognition carries the sense of acknowledgment and requital\n- Root: ربع (rubʿ)\n  * Lisan / Ayn: Fourth part; dwelling and abiding in a place\n  * Al-Raghib (Mufradat): \"أربعة، وأربعون، وربع، ورباع كلها من أصل واحد\" — four, forty, quarter, and fourfold all share one origin\n  * Al-Zamakhshari (Asas): Literal: \"ربع بالمكان: أقام به\" — he dwelt in the place; Majaz/Metaphorical: \"ربعه الله: نعشه\" — God raised him up and restored him\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Separation between the prepositional phrase and its governing element is permitted where the intervening clause could stand independently, as in the periodic constructions of this preamble", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Enjoining Good and Forbidding Evil'", "badge": "Hadith"}], "105": [{"arabic": "احتج هؤلاء بقوله تعالى {ولا تكونوا كالذين تفرقوا واختلفوا} الآية وبقوله تعالى {فألف بين قلوبكم} أمتن على الناس بالسبب المؤلف وهذا ضعيف لأن المراد به تفرق الآراء واختلاف المذاهب في معاني كتاب الله وأصول الشريعة والمراد بالألفة نزع الغوائل من الصدور وهي الأسباب المثيرة للفتن المحركة للخصومات والعزلة لا تنافى ذلك واحتجوا بقوله صلى الله عليه وسلم المؤمن آلف مألوف ولا خير فيمن لا يألف ولا يؤلف (1) وهذا ضعيف لأنه إشارة إلى مذمة سوء الخلق تمتنع بسببه المؤالفة ولا يدخل تحته الحسن الخلق الذي إن خالط ألف وألف و", "english": "They (the advocates of total seclusion) argued by His saying, the Exalted: {«And be not like those who became divided and differed»} (3:105) — to the end of the verse. And by His saying, the Exalted: {«And He brought their hearts together»} (8:63) — He bestowed a favor upon mankind through the cause that unites. But this is weak, because what is meant thereby is the divergence of opinions and the disagreement of schools of thought concerning the meanings of the Book of God and the foundations of the Sacred Law. And what is meant by \"bringing together\" (al-ulfah) is the removal of rancors (al-ghawāʾil) from the breasts — those being the causes that provoke sedition and stir up contentions. And seclusion does not contradict that.", "book_title": "Etiquette of Seclusion", "section_title_ar": "Section 444", "section_title_en": "Section 444 — Refutation of the Isolationists' Proof-Texts from the Qur'an and Sunnah", "section_index": 444, "anchors": "- Root: هجر (hajara)\n  * Lisan / Ayn: To abandon, forsake, or sever relations — whether by body, tongue, or heart; the root carries the sense of definitive separation.\n  * Al-Raghib (Mufradat): الهجران is the separation of one from another — by body, by tongue, or by heart. The Quranic usages distinguish between physical abandonment (as in {«واهجروهن في المضاجع»}), verbal/mental rejection (as in {«اتخذوا هذا القرآن مهجورا»}), and the comprehensive sense in {«واهجرهم هجرا جميلا»} — a noble forsaking that avoids harm.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): physical separation and cutting off of contact. Metaphorical (Majaz): the she-camel that refuses the stallion (هجر الفحل) — a cessation of a natural function, applied here to the cessation of social intercourse.\n- Root: عله (ʿaliha)\n  * Lisan / Ayn: To be bewildered or distracted; related to being occupied away from something. (Contextual note: the root appears in the hadith materials concerning the Prophet's withdrawal from his wives.)\n- Root: ضعف (ḍaʿufa)\n  * Lisan / Ayn: Weakness, feebleness — whether in body, intellect, or resolve.\n  * Al-Raghib (Mufradat): الضعف is the opposite of strength; it may be in the soul, the body, or one's condition. Al-Khalil distinguished: الضعف (with dammah) is bodily weakness, while الضعف (with fatḥah) is weakness in intellect and judgment.\n  * Al-Zamakhshari (Asas): Literal: physical or moral weakness. Metaphorical: \"in the folds of the book\" (في أضعاف الكتاب) — hidden within the inner recesses, as the isolationists' arguments are weak in their inner structure.\n- Root: خلط (khalata)\n  * Lisan / Ayn: To mix, blend, or intermingle — whether liquids, solids, or persons in society.\n  * Al-Raghib (Mufradat): الخلط is the joining of parts of two or more things; it is more general than al-mazj (fusion). Applied to persons, it denotes social mixing, partnership, and companionship.\n  * Al-Zamakhshari (Asas): Literal: mixing substances. Metaphorical: social intercourse and companionship (خالطت فلانا) — the very thing the isolationist abandons, yet which the believer of good character can undertake without harm.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — When a general prohibition (like the hadith against hajr beyond three days) is followed by specific exceptions (the two cases of perceived benefit or safety), the general is carried (maḥmūl) upon the specific, per the established principle of takhṣīṣ al-ʿāmm.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Seclusion'", "badge": "Hadith"}], "109": [{"arabic": "قوله لله ما في السموات وما في الأرض إلى آخرها وقل هو الله أحد خمس عشرة مرة (3) وصف من ثوابه في الحديث ما يخرج عن الحصر وقال كرز بن وبرة وهو من الأبدال قلت للخضر عليه السلام علمني شيئا أعمله في كل ليلة فقال إذا صليت المغرب فقم إلى وقت صلاة العشاء مصليا من غير أن تكلم أحدا وأقبل على صلاتك التي أنت فيها وسلم من كل ركعتين واقرأ في كل ركعة فاتحة الكتاب مرة وقل هو الله أحد ثلاثا فإن فرغت من صلاتك انصرف إلى منزلك ولا تكلم أحدا وصل ركعتين واقرأ فاتحة الكتاب وقل هو الله أحد سبع مرات في كل ر", "english": "The Messenger of God (peace be upon him) said — according to what ʿĀ'ishah (may God be pleased with her) narrated: \"Verily, the most excellent of prayers in the sight of God is the Maghrib prayer. He has not exempted from it either the traveler or the resident. By it He opened the prayer of the night, and by it He sealed the prayer of the day. Whoever prays the Maghrib and prays after it two units (rakʿatayn), God will build for him a palace (qaṣr) in Paradise.\"", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 271", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 271: On the Virtue of the Maghrib Prayer and the Facilitating Causes for the Night Vigil (Qiyām al-Layl)", "section_index": 271, "anchors": "- Root: غرب (gh-r-b)\n  * Lisan / Ayn: Core meaning of disappearance, setting, and the west; al-ghurāb is the setting of the sun.\n  * Al-Raghib (Mufradat): \"الغرب: غيبوبة الشمس\" — the occultation of the sun; the Maghrib prayer is named for its time, marking the transition from the day's light into the night's dominion.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the sun's setting; metaphorically (Majaz), it signifies a boundary or point of transition — here, the temporal boundary between the daytime prayers and the night vigil.\n- Root: رسل (r-s-l)\n  * Lisan / Ayn: Sending forth with gentleness and ease; a messenger (rasūl) is one dispatched.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root denotes a measured, deliberate sending forth; from this derives the concept of the prophetic messenger.\n  * Al-Zamakhshari (Asas): Literal: \"أرسل الله في الأمم رسلا\" (God sent messengers to the nations). Metaphorical: \"أرسل الله عليهم العذاب\" (God loosed chastisement upon them) — here, the ḥadīth's \"أرسل\" (in the chain) is literal transmission.\n- Root: ركع (r-k-')\n  * Lisan / Ayn: Bowing; the physical posture of inclination in prayer.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء\" — used literally for the prayer posture and metaphorically for humility and submission before God.\n  * Al-Zamakhshari (Asas): Literal: \"شيخ راكع: منحن من الكبر\" (an old man bowed with age). Metaphorical: \"لغبت الإبل حتى ركعت\" (camels fatigued until they knelt) — in the ḥadīth, \"ركعات\" (units of prayer) are named for the bowing that defines them.\n- Root: صلا (ṣ-l-w)\n  * Lisan / Ayn: The root of prayer (ṣalāh); also linked to the fire of kindling (taṣliyah).\n  * Al-Raghib (Mufradat): \"أصل الصلي الإيقاد بالنار\" — the root denotes kindling fire; the ṣalāh is so named for the \"burning\" of devotion or for the supplication that \"kindles\" the heart toward God.\n  * Al-Zamakhshari (Asas): The term ṣalāh in the Sacred Law is a transferred (naql) technical designation for the specific acts of bowing, prostration, and recitation — distinct from its lexical sense of supplication (duʿā').\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a preposition and its object, as in \"لم يحطها عن مسافر ولا عن مقيم\" where the pronominal object (ها) is separated from the second prepositional phrase (عن مقيم) by the conjunction, maintaining grammatical cohesion through parallel structure.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Arrangement of Litanies'", "badge": "Hadith"}], "110": [{"arabic": "استحقاقهم للعنة بتركهم النهي عن المنكر وقال عز وجل كنتم خير أمة أخرجت للناس تأمرون بالمعروف وتنهون عن المنكر وهذا يدل على فضيلة الأمر بالمعروف والنهي عن المنكر إذ بين أنهم كانوا به خير أمة أخرجت للناس وقال تعالى فلما نسوا ما ذكروا به أنجينا الذين ينهون عن السوء وأخذنا الذين ظلموا بعذاب بئيس بما كانوا يفسقون فبين أنهم استفادوا النجاة بالنهي عن السوء ويدل ذلك على الوجوب أيضا وقال تعالى الذين إن مكناهم في الأرض أقاموا الصلاة وآتوا الزكاة وأمروا بالمعروف ونهوا عن المنكر فقرن ذلك بالصلاة والزكاة في نعت الصالحين والمؤمنين وقال تعالى وتعاونوا على البر والتقوى ولا", "english": "Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 521", "section_title_en": "Section 521", "section_index": 521, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}, {"arabic": "اهتديتم وقال رسول الله صلى الله عليه وسلم لتأمرن بالمعروف ولتنهون عن المنكر أو ليسلطن الله عليكم شراركم ثم يدعوا خياركم فلا يستجاب لهم (2) معناه تسقط مهابتهم من أعين الأشرار فلا يخافونهم وقال صلى الله عليه وسلم يا أيها الناس إن الله يقول لتأمرن بالمعروف ولتنهون عن المنكر قبل أن تدعوا فلا يستجاب لكم (3) وقال صلى الله عليه وسلم ما أعمال البر عند الجهاد في سبيل الله إلا كنفثة في بحر لجي وما جميع أعمال البر والجهاد في سبيل الله عند الأمر بالمعروف والنهي عن المنكر إلا كنفثة في بحر لجي (4) وقال صلى الله عليه وسلم إن الله تعالى ليسأل ال", "english": "Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 521", "section_title_en": "Section 521", "section_index": 521, "anchors": "*(Anchors established)*", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Enjoining Good and Forbidding Evil'", "badge": "Commentary"}], "113": [{"arabic": "محالة وقال تعالى ليسوا سواء من أهل الكتاب أمة قائمة يتلون آيات الله آناء الليل وهم يسجدون يؤمنون بالله واليوم الآخر ويأمرون بالمعروف وينهون عن المنكر ويسارعون في الخيرات وأولئك من الصالحين فلم يشهد لهم بالصلاح بمجرد الإيمان بالله واليوم الآخر حتى أضاف إليه الأمر بالمعروف والنهي عن المنكر وقال تعالى والمؤمنون والمؤمنات بعضهم أولياء بعض يأمرون بالمعروف وينهون عن المنكر ويقيمون الصلاة فقد نعت المؤمنين بأنهم يأمرون بالمعروف وينهون عن المنكر فالذي هجر الأمر بالمعروف والنهي عن المنكر خارج عن هؤلاء المؤمنين المنعوتين في هذه الآية وقال تعالى لعن الذين كفروا من بني إسرائيل على لسان داود وعيسى ابن مريم ذلك بما عصوا وكانوا يعتدون كانوا لا يتناهون عن منكر", "english": "Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 521", "section_title_en": "Section 521", "section_index": 521, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}], "114": [{"arabic": "أما الآيات فقوله تعالى ولتكن منكم أمة يدعون إلى الخير ويأمرون بالمعروف وينهون عن المنكر وأولئك هم", "english": "To proceed: Know that enjoining right and forbidding wrong is the greatest pivot (al-quṭb al-aʿẓam) of the religion, and it is the weighty matter for which Allah sent forth all the prophets collectively. Were its carpet folded up, its knowledge and practice neglected, prophethood would be rendered void, religion would dissolve, the interregnum between prophets (fatrah) would become general, misguidance would spread abroad, ignorance would become rampant, corruption would become chronic, the breach would widen, lands would be laid waste, and servants would perish — yet they would not perceive their destruction until the Day of the Summons (yawm al-tanād). {«فإنا لله وإنا إليه راجعون»} — \"Truly we belong to Allah and to Him we return\" — for that which we feared has indeed come to pass. The practice and knowledge of this pivot have become effaced, its reality and vestige utterly obliterated. Dissimulation toward creation (mudāhanat al-khalq) has seized dominion over hearts, and watchfulness of the Creator (murāqabat al-Khāliq) has been erased from them. People have let themselves loose in the pursuit of caprice and lusts with the abandon of beasts. Rare upon the face of the earth is a sincere believer whom no blamer's reproach deters in the cause of Allah. Whoever, therefore, strives to repair this interregnum and to close this breach — whether by undertaking its practice himself or by assuming responsibility for its execution, reviving this extinct sunnah, rising to bear its burdens, and girding himself to bring it back to life — he has singled himself out among creation for reviving a sunnah whose death the age has brought about, and has taken exclusive possession of an act of devotion (qurbah) beside whose summit the degrees of nearness to Allah dwindle to nothing. And now we shall expound its knowledge in four chapters:", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 520", "section_title_en": "The Book of Enjoining Right and Forbidding Wrong — Book Nine of the Quarter of Customs, from The Revival of the Religious Sciences", "section_index": 520, "anchors": "- Root: نكر (nakira)\n  * Lisan / Ayn: Core meaning of denial, rejection, and that which is unrecognized or unfamiliar\n  * Al-Raghib (Mufradat): \"الإنكار: ضد العرفان\" — denial is the opposite of recognition; it is what the heart refuses to conceive, a species of ignorance; the tongue may deny what the heart still holds, and therein lies falsehood\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"نكر أبلغ من أنكر\" — nakira is more emphatic than ankara; it is said nakira is by the heart and ankara by the eye\n- Root: نهي (nahā)\n  * Lisan / Ayn: Prohibition, forbidding, restraint, and reaching an end or limit\n  * Al-Raghib (Mufradat): \"النهي: الزجر عن الشيء\" — prohibition is the repelling of one from a thing; no difference whether by word or by other means; by word it is \"do not do such-and-such\"\n  * Al-Zamakhshari (Asas): Literal: \"نهاه فانتهى\" — he forbade him and he desisted; \"وتناهوا عن المنكر\" — and they mutually desisted from wrong\n- Root: عرف (ʿarafa)\n  * Lisan / Ayn: Recognition, knowledge by reflection and discernment of traces\n  * Al-Raghib (Mufradat): \"المعرفة والعرفان: إدراك الشيء بتفكر وتدبر لأثره\" — knowledge and recognition is the apprehension of a thing by reflection and contemplation of its effect; it is more specific than knowledge (ʿilm) and is opposed by denial (inkār)\n  * Al-Zamakhshari (Asas): Literal: \"لأعرفن لك ما صنعت\" — I shall surely requite you for what you have done; recognition carries the sense of acknowledgment and requital\n- Root: ربع (rubʿ)\n  * Lisan / Ayn: Fourth part; dwelling and abiding in a place\n  * Al-Raghib (Mufradat): \"أربعة، وأربعون، وربع، ورباع كلها من أصل واحد\" — four, forty, quarter, and fourfold all share one origin\n  * Al-Zamakhshari (Asas): Literal: \"ربع بالمكان: أقام به\" — he dwelt in the place; Majaz/Metaphorical: \"ربعه الله: نعشه\" — God raised him up and restored him\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Separation between the prepositional phrase and its governing element is permitted where the intervening clause could stand independently, as in the periodic constructions of this preamble", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Enjoining Good and Forbidding Evil'", "badge": "Hadith"}], "116": [{"arabic": "قوله أولئك أصحاب النار هم فيها خالدون وثلاث آيات من آخر سورة البقرة من قوله لله ما في السموات وما في الأرض إلى آخرها وقل هو الله أحد خمس عشرة مرة (3) وصف من ثوابه في الحديث ما يخرج عن الحصر وقال كرز بن وبرة وهو من الأبدال قلت للخضر عليه السلام علمني شيئا أعمله في كل ليلة فقال إذا صليت المغرب فقم إلى وقت صلاة العشاء مصليا من غير أن تكلم أحدا وأقبل على صلاتك التي أنت فيها وسلم من كل ركعتين واقرأ في كل ركعة فاتحة الكتاب مرة وقل هو الله أحد ثلاثا فإن فرغت من صلاتك انصرف إلى منزلك ولا ت", "english": "The Messenger of God (peace be upon him) said — according to what ʿĀ'ishah (may God be pleased with her) narrated: \"Verily, the most excellent of prayers in the sight of God is the Maghrib prayer. He has not exempted from it either the traveler or the resident. By it He opened the prayer of the night, and by it He sealed the prayer of the day. Whoever prays the Maghrib and prays after it two units (rakʿatayn), God will build for him a palace (qaṣr) in Paradise.\"", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 271", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 271: On the Virtue of the Maghrib Prayer and the Facilitating Causes for the Night Vigil (Qiyām al-Layl)", "section_index": 271, "anchors": "- Root: غرب (gh-r-b)\n  * Lisan / Ayn: Core meaning of disappearance, setting, and the west; al-ghurāb is the setting of the sun.\n  * Al-Raghib (Mufradat): \"الغرب: غيبوبة الشمس\" — the occultation of the sun; the Maghrib prayer is named for its time, marking the transition from the day's light into the night's dominion.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the sun's setting; metaphorically (Majaz), it signifies a boundary or point of transition — here, the temporal boundary between the daytime prayers and the night vigil.\n- Root: رسل (r-s-l)\n  * Lisan / Ayn: Sending forth with gentleness and ease; a messenger (rasūl) is one dispatched.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root denotes a measured, deliberate sending forth; from this derives the concept of the prophetic messenger.\n  * Al-Zamakhshari (Asas): Literal: \"أرسل الله في الأمم رسلا\" (God sent messengers to the nations). Metaphorical: \"أرسل الله عليهم العذاب\" (God loosed chastisement upon them) — here, the ḥadīth's \"أرسل\" (in the chain) is literal transmission.\n- Root: ركع (r-k-')\n  * Lisan / Ayn: Bowing; the physical posture of inclination in prayer.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء\" — used literally for the prayer posture and metaphorically for humility and submission before God.\n  * Al-Zamakhshari (Asas): Literal: \"شيخ راكع: منحن من الكبر\" (an old man bowed with age). Metaphorical: \"لغبت الإبل حتى ركعت\" (camels fatigued until they knelt) — in the ḥadīth, \"ركعات\" (units of prayer) are named for the bowing that defines them.\n- Root: صلا (ṣ-l-w)\n  * Lisan / Ayn: The root of prayer (ṣalāh); also linked to the fire of kindling (taṣliyah).\n  * Al-Raghib (Mufradat): \"أصل الصلي الإيقاد بالنار\" — the root denotes kindling fire; the ṣalāh is so named for the \"burning\" of devotion or for the supplication that \"kindles\" the heart toward God.\n  * Al-Zamakhshari (Asas): The term ṣalāh in the Sacred Law is a transferred (naql) technical designation for the specific acts of bowing, prostration, and recitation — distinct from its lexical sense of supplication (duʿā').\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a preposition and its object, as in \"لم يحطها عن مسافر ولا عن مقيم\" where the pronominal object (ها) is separated from the second prepositional phrase (عن مقيم) by the conjunction, maintaining grammatical cohesion through parallel structure.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Arrangement of Litanies'", "badge": "Hadith"}], "118": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "الله عليم بذات الصدور إن تمسسكم حسنة تسؤهم الآية وكذلك قال ودوا ما عنتم قد بدت البغضاء من أفواههم وما تخفي صدورهم أكبر والحسد بسبب البغض ربما يفضي إلى التنازع والتقاتل واستغراق العمر في إزالة النعمة بالحيل والسعاية وهتك الستر وما يجري مجراه السبب الثاني التعزز وهو أن يثقل عليه أن يترفع عليه غيره فإذا أصاب بعض أمثاله ولاية أو علما أو مالا خاف أن يتكبر عليه وهو لا يطيق تكبره ولا تسمح نفسه باحتمال صلفه وتفاخره عليه وليس من غرضه أن يتكبر بل غرضه أن يدفع كبره فإنه قد رضي بمساواته مثلا ولكن لا يرضى بالترفع عليه السبب الثالث الكبر وهو أن يكون في طبعه أن يتكبر عليه ويستصغر", "english": "I say: God is Knower of what is in the breasts. {«إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ»} — \"If good touches you, it grieves them\" {«وَدُّوا مَا عَنِتُّمْ قَدْ بَدَتِ الْبَغْضَاءُ مِنْ أَفْوَاهِهِمْ وَمَا تُخْفِي صُدُورُهُمْ أَكْبَرُ»} — \"They wish for your hardship; hatred has already appeared from their mouths, and what their breasts conceal is greater.\" And envy (ḥasad), arising from hatred, may lead to contention, mutual fighting, and the spending of one's entire life in removing another's blessing through stratagems, slander, the tearing of veils, and whatever runs in that course.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 722", "section_title_en": "The Revival of the Religious Sciences — Book on the Rebuke of the Self: The Seven Causes of Envy (Section 722)", "section_index": 722, "anchors": "- Root: سبب (sabab)\n  * Lisan / Ayn: The rope by which one climbs; every means by which one reaches a thing.\n  * Al-Raghib (Mufradat): \"Every means by which one arrives at something is called a sabab\" — thus the causes enumerated here are the psychological \"ropes\" by which envy ascends in the soul.\n  * Al-Zamakhshari (Asas): Literal: a physical cord. Metaphorical: any linkage or occasion — here, the inward occasions (asbāb) that give rise to ḥasad.\n- Root: بغض (bughḍ)\n  * Lisan / Ayn: Hatred, aversion of the heart.\n  * Al-Raghib (Mufradat): The opposite of love (maḥabbah); a disposition of the heart toward another's harm.\n  * Al-Zamakhshari (Asas): Literal: inner aversion. Metaphorical: its \"appearance from the mouths\" (Quranic) as outward speech betraying the concealed hatred.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Greatness; pride; disdain.\n  * Al-Raghib (Mufradat): \"Al-kabīr and al-ṣaghīr are relative terms\" — pride is the claim to greatness relative to another, deeming oneself above him.\n  * Al-Zamakhshari (Asas): Literal: bigness in stature or age. Metaphorical: \"takabbara 'alayhi\" — to deem oneself greater than another and refuse submission to him.\n- Root: قصد (qaṣd)\n  * Lisan / Ayn: Straightness of path; intending a goal.\n  * Al-Raghib (Mufradat): \"Al-qaṣd: istiqāmat al-ṭarīq\" — the straight road; also moderation between extremes.\n  * Al-Zamakhshari (Asas): Literal: to head toward a place. Metaphorical: \"maqāṣid\" — the aims and objectives toward which one directs oneself; here, the worldly goals whose pursuit breeds rivalry and envy.\n- Root: نزل (nazal)\n  * Lisan / Ayn: To descend from a height; to alight.\n  * Al-Raghib (Mufradat): \"Al-nuzūl fī al-aṣl huwa inḥiṭāṭ min 'uluww\" — descent from above; the sending down of revelation.\n  * Al-Zamakhshari (Asas): Literal: descending from a high place. Metaphorical: \"anzala Allāhu al-kitāb\" — God's sending down of the Quran; and \"mā unzila\" — what was revealed, as in the Quranic citation regarding the Qurashites' objection to revelation upon a mere human.\n- Sibawayh Rule: Rule of Causal Coordination (al-'aṭf al-sababī) — The enumeration of the seven causes proceeds by coordinated clauses (fa-... thumma ...), each introduced as an independent proposition linked by causation (sabab), requiring the translator to preserve the logical sequence of psychological motivations without collapsing them into one another.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "119": [{"arabic": "بالعداوة إذ قال الله تعالى وإذا لقوكم قالوا آمنا وإذا خلو عضوا عليكم الأنامل من الغيظ قل موتوا بغيظكم إن", "english": "**The First Cause: Enmity and Hatred.** This is the most intense of the causes of envy. For when a person harms another by some cause, or opposes him in some aim in any manner, his heart comes to hate him and is angered against him, and rancor (ḥiqd) becomes firmly rooted in his soul. And rancor demands vindication (tashaffī) and revenge. If the hater is unable to vindicate himself, he loves that time itself should vindicate him. Perhaps he even attributes that to the honor of his own soul before God Almighty. So whenever a calamity befalls his enemy, he rejoices at it and supposes it to be a recompense from God for his hatred — that it was for his sake. And whenever a blessing befalls him, it grieves him, because it is contrary to his desire. Perhaps it even occurs to him that the other has no station with God, since God did not take vengeance for him against his enemy who harmed him, but rather bestowed blessing upon him. In sum, envy is inseparable from hatred and enmity; it never parts from them. The utmost limit of piety (al-tuqā) is only that one should not act unjustly and that one should dislike this [envy] in himself. But that a man should hate another, and then his joy and his grief at his state should become equal — this is simply not possible. And it is with this — namely, envy arising from enmity — that God Almighty described the disbelievers, for God Almighty said: {«وإذا لقوكم قالوا آمنا وإذا خلوا عضوا عليكم الأنامل من الغيظ قل موتوا بغيظكم»} (\"And when they meet you, they say, 'We believe'; but when they are alone, they bite their fingertips at you in rage. Say: 'Die in your rage'\" — Q. 3:119).", "book_title": "Condemnation of Envy", "section_title_ar": "Section 721", "section_title_en": "Section 721 — The Reality of Envy, Its Ruling, Its Divisions, and Its Degrees; The Causes of Envy and Rivalry", "section_index": 721, "anchors": "- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Core meaning of wishing for removal of a blessing from its possessor; the root carries the sense of spiteful resentment.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها، وربما كان مع ذلك سعي في إزالتها\" — Envy is the desire for the removal of a blessing from one who deserves it, and sometimes accompanied by striving to remove it. He cites {«ومن شر حاسد إذا حسد»} (Q. 113:5).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسده على نعمة الله، وحسده نعمة الله\" — to envy him for God's blessing. Metaphorical (majāz): The proverb \"إن الحسد يأكل الجسد\" (envy consumes the body) extends the root to describe the inner corrosion of the envier.\n- Root: سبب (s-b-b)\n  * Lisan / Ayn: A rope, cord, or means by which one ascends or reaches something; any cause or connection.\n  * Al-Raghib (Mufradat): \"سمي كل ما يتوصل به إلى شيء سببا\" — Everything by which one reaches something is called a cause (sabab). He cites {«وآتيناه من كل شيء سببا فأتبع سببا»} (Q. 18:84-85).\n  * Al-Zamakhshari (Asas): Literal: a physical rope or cord. Metaphorical: any means, link, or occasion — as in the seven \"doors\" (abwāb) of entry for envy enumerated here.\n- Root: عدو (ʿ-d-w)\n  * Lisan / Ayn: To transgress, exceed bounds, or act with hostility; the enemy (ʿadūw) is one who oversteps against another.\n  * Al-Raghib (Mufradat): Enmity (ʿadāwah) is the soul's disposition toward harming another; it is the opposite of friendship (wilāyah).\n  * Al-Zamakhshari (Asas): Literal: physical transgression. Metaphorical: the inner state of hostility that drives one to wish harm upon another.\n- Root: كبر (k-b-r)\n  * Lisan / Ayn: To be great, large, or advanced; arrogance (kibr) is the soul's self-magnification.\n  * Al-Raghib (Mufradat): \"الكبر: أن يرى الإنسان نفسه أكبر من غيره\" — Arrogance is when one sees himself as greater than another, refusing to acknowledge the other's due.\n  * Al-Zamakhshari (Asas): Literal: physical greatness. Metaphorical: the soul's haughtiness that refuses to accept another's superiority or blessing.\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Astonishment or wonder at something extraordinary.\n  * Al-Raghib (Mufradat): Self-amazement (ʿujb) is when one marvels at his own state or at another's, leading to disdain or disbelief at their worth.\n  * Al-Zamakhshari (Asas): Literal: wonder at a marvel. Metaphorical: the envier's astonishment that a lesser person attained a great blessing.\n- Root: خبث (kh-b-th)\n  * Lisan / Ayn: Corruption, wickedness, or vileness of character.\n  * Al-Raghib (Mufradat): \"الخبث: ما يستقبح من الأقوال والأفعال\" — That which is repugnant in speech and deed; inner malice.\n  * Al-Zamakhshari (Asas): Literal: that which is foul or impure. Metaphorical: the soul's innate wickedness that begrudges good to others.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The phrase \"إنما نظرنا الآن في الحسد المذموم\" restricts the present inquiry exclusively to blameworthy envy, distinguishing it from rivalry (munāfasah) which may be praiseworthy. The conditional clauses (\"إما أن يكون...\") enumerate exhaustive divisions (taqsīm) of causes, each introduced as a discrete possibility.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'", "badge": "Insight"}, {"arabic": "ألد الخصام وإذا تولى سعى في الأرض ليفسد فيها} الآية وقال تعالى {وإذا لقوكم قالوا آمنا وإذا خلوا عضوا عليكم الأنامل من الغيظ} وقال تعالى {يراؤون الناس ولا يذكرون الله إلا قليلا مذبذبين بين ذلك} والآيات فيهم كثيرة وكان النفاق يكثر في ابتداء الإسلام ممن يدخل في ظاهر الإسلام ابتداء لغرض وذلك مما يقل في زماننا ولكن يكثر نفاق من ينسل عن الدين باطنا فيجحد الجنة والنار والدار الآخرة ميلا إلى قول الملحدة أو يعتقد على بساط الشرع والأحكام ميلا إلى أهل الإباحة أو يعتقد كفرا أو بدعة وهو يظهر خلافه فهؤلاء من المنافقين والمرائين المخلدين في النار وليس وراء هذا الرياء رياء وحال هؤلاء", "english": "The fourth [case]: that the people's seeing him should be a weighty factor (murajjihan) and a strengthener of his vigor, such that were it not for that, he would not abandon the act of worship; and were the intention of ostentation alone [present], he would not have ventured upon it. So what we hold — and knowledge is with God — is that it does not annul the root of the reward, but rather it diminishes it; or he is punished to the measure of his intention of ostentation and rewarded to the measure of his intention of reward. As for his saying — may God's peace and blessings be upon him — that God the Exalted says: \"I am the most Self-Sufficient of the self-sufficient, free of all need for partnership (shirk)\" — that is carried upon the case when the two intentions are equal, or when the intention of ostentation is the weightier.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 818", "section_title_en": "On the Degrees of Ostentation in Worship — The Second Pillar: That by Which One Ostentatiously Displays (Al-Riya' bi al-Ta'at)", "section_index": 818, "anchors": "- Root: قصد (Qasada)\n  * Lisan / Ayn: Core meaning of \"intending, aiming toward a goal, directing one's purpose.\"\n  * Al-Raghib (Mufradat): \"القصد: استقامة الطريق\" — intention as the straight path of the soul toward its object; in moral theology, it denotes the deliberate orientation of the will that determines the moral value of an act.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قصدته وقصدت له\" — direct aiming. Metaphorical (Majaz): \"قصد في الأمر إذا لم يجاوز فيه الحد\" — moderation; here, the \"intention\" (qasd) is the precise measure by which an act is weighed between reward and punishment.\n- Root: راءى (Ra'a) — from Root: رأى (Ra'a)\n  * Lisan / Ayn: \"الرياء: إظهار العمل ليراه الناس\" — showing one's deed so that people may see it; derived from الرؤية (sight/seeing).\n  * Al-Raghib (Mufradat): Riya' is a branch of shirk (associating partners with God), for the actor directs his deed not to God alone but to the gaze of creatures, thus dividing his intention between the Creator and creation.\n  * Al-Zamakhshari (Asas): Literal: seeing with the eye. Metaphorical: \"راءى فلان\" — to perform an act for the sake of being seen, i.e., seeking the approval of onlookers rather than the sight of God.\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: \"الخلق: التقدير المستقيم\" — measuring and proportioning; also \"خلق الثوب\" — wearing out a garment until it is threadbare.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — creation as precise estimation; in moral context, the \"خلق\" (character) is the inward measure by which a soul is formed.\n  * Al-Zamakhshari (Asas): Literal: \"خلق الخراز الأديم\" — the leather-worker cutting and measuring hide. Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation of creatures upon a measure required by wisdom; here, the \"creatures\" (الخلق) whose blame (المقت) is feared by the ostentatious worshipper.\n- Root: نفق (Nafaqa)\n  * Lisan / Ayn: \"نفق الشيء: مضى ونفد\" — to pass away, to be spent, to perish.\n  * Al-Raghib (Mufradat): \"نفق الشيء: مضى ونفد، ينفق، إما بالبيع نحو: نفق البيع نفاقا\" — to find a ready market; \"ومنها نفاق الأيم\" — hypocrisy as the \"passing\" of a false coin in the market of religion.\n  * Al-Zamakhshari (Asas): Literal: \"نفقت الدراهم\" — coins circulating and being spent. Metaphorical: \"نافق\" — the hypocrite (munafiq) whose outward faith circulates among people while his inward disbelief is void; the ostentatious man \"spends\" his deeds on the market of human praise.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic separation between a governing preposition and its object, as in \"له من الثواب مثل ما عليه من العقاب,\" where the prepositional phrases are interposed to balance two opposing clauses, mirroring the theological weighing of reward against punishment.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}], "120": [{"arabic": "تمسسكم حسنة تسؤهم وإن تصبكم سيئة يفرحوا بها} وهذا الفرح شماتة والحسد والشماتة يتلازمان وقال تعالى {ود كثير من أهل الكتاب لو يردونكم من بعد إيمانكم كفارا حسدا من عند أنفسهم} فأخبر تعالى أن حبهم زوال نعمة الإيمان حسد وقال عز وجل {ودوا لو تكفرون كما كفروا فتكونون سواء} وذكر الله تعالى حسد إخوة يوسف عليه السلام وعبر عما في قلوبهم بقوله تعالى {إذ قالوا ليوسف وأخوه أحب إلى أبينا منا ونحن عصبة إن أبانا لفي ضلال مبين اقتلوا يوسف أو اطرحوه أرضا يخل لكم وجه أبيكم} فلما كرهوا حب أبيهم له وساءهم ذلك وأحبو", "english": "The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"", "book_title": "Condemnation of Envy", "section_title_ar": "Section 720", "section_title_en": "On the Reality of Envy (Ḥasad) and Its Degrees — Section 720", "section_index": 720, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'", "badge": "Insight"}], "125": [{"arabic": "الصابرين وعلق النصرة على الصبر فقال تعالى بلى إن تصبروا وتتقوا ويأتوكم من فورهم هذا يمددكم ربكم بخمسة آلاف من الملائكة مسومين وجمع للصابرين بين أمور لم يجمعها لغيرهم فقال تعالى أولئك عليهم صلوات من ربهم ورحمة وأولئك هم المهتدون فالهدى والرحمة والصلوات مجموعة للصابرين واستقصاء جميع الآيات في مقام الصبر يطول وأما الأخبار فقد قال صلى الله عليه وسلم الصبر نصف الإيمان (1) على ما سيأتي وجه كونه نصفا وقال صلى الله عليه وسلم من أقل ما أوتيتم اليقين وعزيمة الصبر ومن أعطي حظه منهما لم يبال بما فاته من قيام الليل وصيام النهار ولأن تصبروا على ما أنتم عليه أحب إلي من أن يوافيني كل امرىء", "english": "Allah — exalted be He — has described the patient (al-ṣābirīn) with attributes, and He mentioned patience (al-ṣabr) in the Qur’an in upwards of seventy places. He attached most of the degrees and goods to patience, making them its fruit. For He said — majestic is His utterance: {«وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا»} — “And We made from among them imams guiding by Our command, when they were patient” (Q 32:24). And He said — exalted be He: {«وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا»} — “And the good word of your Lord was fulfilled upon the Children of Israel, because they were patient” (Q 7:137). And He said — exalted be He: {«وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُم بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ»} — “And We shall surely recompense those who were patient their wage according to the best of what they used to do” (Q 16:96). And He said — exalted be He: {«أُولَٰئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا»} — “Those shall be given their wage twice, because they were patient” (Q 28:54). And He said — exalted be He: {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»} — “Only the patient shall be paid their wage without reckoning” (Q 39:10). Thus there is no act of nearness (qurbah) whose wage is not meted out by measure and account — except patience. And because fasting (al-ṣawm) is of patience, and it is half of patience, Allah — exalted be He — said: “Fasting is Mine, and I recompense it” — so He attributed it to Himself, to the exclusion of all other acts of worship. And He promised the patient that He is with them, saying — exalted be He: {«وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ»} — “And be patient; indeed Allah is with the patient” (Q 8:46). And He made victory contingent upon patience, saying — exalted be He: {«بَلَىٰ إِن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُسَوِّمِينَ»} — “Yes, if you are patient and God-fearing, and they come upon you in their rush, your Lord will reinforce you with five thousand marked angels” (Q 3:125). And He gathered for the patient things He gathered for no others, saying — exalted be He: {«أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ»} — “Those — upon them are blessings from their Lord, and mercy; and those — they are the rightly guided” (Q 2:157). So guidance, mercy, and blessings are all gathered for the patient. And to exhaust all the verses concerning the station of patience would be lengthy.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 954", "section_title_en": "The Virtue of Patience (Ṣabr) — Its Excellence in the Qur’an, Sunnah, and Reports of the Salaf", "section_index": 954, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning is “to restrain, to hold back, to bind firmly” — as in holding an animal by its halter or confining someone against departure.\n  * Al-Raghib (Mufradat): Patience is “the self’s restraint upon what reason and Sacred Law require, or from what they require it to abstain from.” It is a generic term whose specific names vary by context: in calamity it is ṣabr (opposed to jazaʿ); in battle it is courage (shajāʿah); in vexation it is forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): “I bore patiently what I disliked, and I refrained patiently from what I loved.” Metaphorical (majāz): “His right hand was made to swear patiently” (i.e., bound by an emphatic oath), and “this tree is patient against cold” (i.e., unaffected by it).\n- Root: عله (ʿ-L-H) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: ايم (A-Y-M) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: نفس (N-F-S)\n  * Al-Raghib (Mufradat): The self (nafs) as the locus of volitional restraint — patience is an act of the nafs holding itself back, distinguishing it from mere physical endurance.\n  * Al-Zamakhshari (Asas): Literal: “a precious thing” (nafīs). Metaphorical: “he poured out his soul” (i.e., his blood), and “everything that has no flowing soul does not defile water.”\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the exclusive clause {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»}, where innamā restricts the reward-without-account solely to the patient, and {«الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ»}, where the predicate is focused to Allah alone.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "128": [{"arabic": "قنوته شهرا فنزل قوله تعالى ليس لك من الأمر شيء أو يتوب عليهم أو يعذبهم فإنهم ظالمون (2) يعني أنهم ربما يسلمون فمن أين تعلم أنهم ملعونون وكذلك من بان لنا موته على الكفر جاز لعنه وجاز ذمه إن لم يكن فيه أذى على مسلم فإن كان لم يجز كما روي أن رسول الله صلى الله عليه وسلم سأل أبا بكر رضي الله عنه عن قبر مر به وهو يريد الطائف فقال هذا قبر رجل كان عاتيا على الله ورسوله وهو سعيد بن العاص فغضب ابنه عمرو بن سعيد وقال يا رسول الله هذا قبر رجل كان أطعم للطعام وأضرب للهام من أبي قحافة فقال أبو بكر يكلمني هذا يا رسول الله بمثل هذا الكل", "english": "Know that cursing (al-laʿn) is an expression denoting expulsion and distancing (al-ṭard wa-al-ibʿād) from God, the Exalted. This is not permissible except upon one who is characterized by an attribute that distances him from God, the Mighty and Majestic — namely, unbelief (al-kufr) and wrongdoing (al-ẓulm) — such that one says: \"May the curse of God be upon the wrongdoers\" and \"upon the unbelievers.\" One ought to follow therein the wording of the Sacred Law (al-sharʿ), for in cursing there is danger, because it is a judgment upon God, the Mighty and Majestic, that He has indeed distanced the cursed one — and that is an unseen matter (ghayb) which none can perceive save God, the Exalted, and His Messenger, peace and blessings be upon him, when God discloses it to him.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 668", "section_title_en": "On the Prohibition of Cursing (Laʿn) and Its Degrees of Permissibility", "section_index": 668, "anchors": "- Root: لعن (la-ʿa-n)\n  * Lisan / Ayn: Core meaning of expulsion, driving away, and casting out with vehemence.\n  * Al-Raghib (Mufradat): Theological nuance — cursing as divine exclusion (ṭard wa-ibʿād) from mercy, a judgment upon the spiritual state of the cursed.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) — \"طرده وأبعده\" (to drive out and distance); Metaphorical (Majaz) — \"أبيت اللعن\" as a pre-Islamic royal acclamation meaning \"I have not done what would merit cursing,\" showing the term's extension to moral desert.\n- Root: رسل (r-s-l)\n  * Lisan / Ayn: Sending forth with ease and gentleness; a messenger (rasūl) as one dispatched.\n  * Al-Raghib (Mufradat): The prophetic dispatch (baʿth) as the origin of the term; the Messenger as the one sent with a message.\n  * Al-Zamakhshari (Asas): Literal — \"أرسل الله في الأمم رسلا\" (God sent messengers among the nations); Metaphorical — \"السهام رسل المنايا\" (arrows are the messengers of death), showing the extension of sending to divine decree.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; a new event (ḥādith).\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — the coming-to-be of a thing after it was not; divine origination (ījād) as exclusive to God.\n  * Al-Zamakhshari (Asas): Literal — \"نزلت به حوادث الدهر\" (the vicissitudes of time befell him); Metaphorical — \"كان عمر محدثا\" (ʿUmar was one inspired with true discernment), as if spoken to by unseen reality.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase, provided the intervening clause is complete in itself, as in the conditional structures governing the permissibility of cursing specific individuals.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Anger and Hatred'", "badge": "Ethics"}, {"arabic": "ويقول كيف يفلح قوم خضبوا وجه نبيهم بالدم وهو يدعوهم إلى ربهم (4) فأنزل الله تعالى {ليس لك من الأمر شيء} تأديبا له على ذلك وأمثال هذه التأديبات في القرآن لا تحصر وهو صلى الله عليه وسلم المقصود الأول بالتأديب والتهذيب ثم منه يشرق النور على كافة الخلق فإنه أدب بالقرآن وأدب الخلق به ولذلك قال صلى الله عليه وسلم بعثت لأتمم مكارم الأخلاق (5) ثم رغب الخلق في محاسن الأخلاق بما أوردناه في كتاب رياضة النفس وتهذيب الأخلاق فلا نعيده ثم لما أكمل الله تعالى خلقه أثنى عليه فقال تعالى {وإنك لعلى خلق عظيم} فسبحانه ما أعظم شأنه وأتم امتنانه ثم انظر", "english": "The Messenger of God, peace and blessings be upon him, was abundant in supplication and earnest entreaty, perpetually asking God Most High to adorn him with the beauties of refined conduct and the noble traits of character. Thus he would say in his supplication: \"O God, beautify my outward form and my inward character (khuluqī wa-khalqī)\" (1), and he would say: \"O God, protect me from the reprehensible traits of character\" (2). God Most High answered his supplication, fulfilling His word, Exalted is He: {«ادعوني أستجب لكم»} [\"Call upon Me, I will answer you\"] (Ghafir 40:60). So He sent down upon him the Qur'an and disciplined him through it, and his character became the Qur'an.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 559", "section_title_en": "The Prophet's Discipline Through the Qur'an and the Invitation to Noble Moral Traits", "section_index": 559, "anchors": "- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning of measuring, fashioning, and creating upon a precise estimation; also used for innate disposition and character.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — the root denotes straight/right estimation; used for bringing something into being from nothing (ibdāʿ) and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خلق الخراز الأديم\" — the leather-worker measures before cutting. Metaphorical (Majaz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom; and \"له خلق حسن\" — he has beautiful character.\n- Root: كرم (karuma)\n  * Lisan / Ayn: Generosity, nobility, honor; the root of karīm (noble/generous) and makārim (noble traits).\n  * Al-Raghib (Mufradat): \"الكرم إذا وصف الله تعالى به فهو اسم لإحسانه وإنعامه المتظاهر\" — when attributed to God, it denotes His manifest beneficence; when attributed to man, it denotes praiseworthy morals and deeds that appear from him.\n  * Al-Zamakhshari (Asas): Literal: \"كرم علينا فلان كرامة\" — he showed generosity. Metaphorical: \"قوم كرم\" — a noble people; \"كرم السحاب تكريما: جاد بمطره\" — the cloud was generous with its rain.\n- Root: أدب (adaba)\n  * Lisan / Ayn: Refinement, discipline, cultivation of character; calling to a gathering (ma'dabah) — the root implies assembling and summoning toward excellence.\n  * Al-Raghib (Mufradat): Discipline (ta'dīb) is the cultivation of the soul through praiseworthy traits and the restraint from blameworthy ones.\n  * Al-Zamakhshari (Asas): Literal: \"أدبته تأديبا\" — I disciplined him. Metaphorical: \"أدبه الله\" — God disciplined him, i.e., refined his character through divine instruction.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما أدبه القرآن\" restricts the means of the Prophet's discipline exclusively to the Qur'an, affirming that the Qur'an alone was the sufficient and complete instrument of his moral formation.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Anger and Hatred'", "badge": "Du'a"}], "129": [{"arabic": "قوله لله ما في السموات وما في الأرض إلى آخرها وقل هو الله أحد خمس عشرة مرة (3) وصف من ثوابه في الحديث ما يخرج عن الحصر وقال كرز بن وبرة وهو من الأبدال قلت للخضر عليه السلام علمني شيئا أعمله في كل ليلة فقال إذا صليت المغرب فقم إلى وقت صلاة العشاء مصليا من غير أن تكلم أحدا وأقبل على صلاتك التي أنت فيها وسلم من كل ركعتين واقرأ في كل ركعة فاتحة الكتاب مرة وقل هو الله أحد ثلاثا فإن فرغت من صلاتك انصرف إلى منزلك ولا تكلم أحدا وصل ركعتين واقرأ فاتحة الكتاب وقل هو الله أحد سبع مرات في كل ر", "english": "The Messenger of God (peace be upon him) said — according to what ʿĀ'ishah (may God be pleased with her) narrated: \"Verily, the most excellent of prayers in the sight of God is the Maghrib prayer. He has not exempted from it either the traveler or the resident. By it He opened the prayer of the night, and by it He sealed the prayer of the day. Whoever prays the Maghrib and prays after it two units (rakʿatayn), God will build for him a palace (qaṣr) in Paradise.\"", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 271", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 271: On the Virtue of the Maghrib Prayer and the Facilitating Causes for the Night Vigil (Qiyām al-Layl)", "section_index": 271, "anchors": "- Root: غرب (gh-r-b)\n  * Lisan / Ayn: Core meaning of disappearance, setting, and the west; al-ghurāb is the setting of the sun.\n  * Al-Raghib (Mufradat): \"الغرب: غيبوبة الشمس\" — the occultation of the sun; the Maghrib prayer is named for its time, marking the transition from the day's light into the night's dominion.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the sun's setting; metaphorically (Majaz), it signifies a boundary or point of transition — here, the temporal boundary between the daytime prayers and the night vigil.\n- Root: رسل (r-s-l)\n  * Lisan / Ayn: Sending forth with gentleness and ease; a messenger (rasūl) is one dispatched.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root denotes a measured, deliberate sending forth; from this derives the concept of the prophetic messenger.\n  * Al-Zamakhshari (Asas): Literal: \"أرسل الله في الأمم رسلا\" (God sent messengers to the nations). Metaphorical: \"أرسل الله عليهم العذاب\" (God loosed chastisement upon them) — here, the ḥadīth's \"أرسل\" (in the chain) is literal transmission.\n- Root: ركع (r-k-')\n  * Lisan / Ayn: Bowing; the physical posture of inclination in prayer.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء\" — used literally for the prayer posture and metaphorically for humility and submission before God.\n  * Al-Zamakhshari (Asas): Literal: \"شيخ راكع: منحن من الكبر\" (an old man bowed with age). Metaphorical: \"لغبت الإبل حتى ركعت\" (camels fatigued until they knelt) — in the ḥadīth, \"ركعات\" (units of prayer) are named for the bowing that defines them.\n- Root: صلا (ṣ-l-w)\n  * Lisan / Ayn: The root of prayer (ṣalāh); also linked to the fire of kindling (taṣliyah).\n  * Al-Raghib (Mufradat): \"أصل الصلي الإيقاد بالنار\" — the root denotes kindling fire; the ṣalāh is so named for the \"burning\" of devotion or for the supplication that \"kindles\" the heart toward God.\n  * Al-Zamakhshari (Asas): The term ṣalāh in the Sacred Law is a transferred (naql) technical designation for the specific acts of bowing, prostration, and recitation — distinct from its lexical sense of supplication (duʿā').\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a preposition and its object, as in \"لم يحطها عن مسافر ولا عن مقيم\" where the pronominal object (ها) is separated from the second prepositional phrase (عن مقيم) by the conjunction, maintaining grammatical cohesion through parallel structure.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Arrangement of Litanies'", "badge": "Hadith"}], "130": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "131": [{"arabic": "ومن تحتهم ظلل ذلك يخوف الله به عباده وقال تعالى واتقوا النار التي أعدت للكافرين وقال تعالى فأنذرتكم نارا تلظى لا يصلاها إلا الأشقى الذي كذب وتولى وقال عز وجل وإن ربك لذوا مغفرة للناس على ظلمهم ويقال أن النبي صلى الله عليه وسلم لم يزل يسأل في أمته حتى قيل له أما ترضى وقد أنزلت عليك هذه الآية وإن ربك لذو مغفرة للناس ظلمهم (2) وفي تفسير قوله تعالى {ولسوف يعطيك ربك فترضى} قال لا يرضى محمد وواحد من أمته في النار وكان أبو جعفر محمد بن علي يقول أنتم أهل العراق تقولون أرجى آية في كتاب الله عز وجل قوله {قل يا عبادي الذين أسرفوا على أنفسهم لا تقنطوا م", "english": "So it was said to him: \"And what is in it of hope?\" He said: \"This world, all of it, is little, and a man's provision from it is little, and his religion is little in comparison to his provision. So look at how God Most High sent down in it the longest verse, to guide His servant to the path of caution in preserving his wealth — so how could He not preserve his religion, which has no substitute for him?\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1033", "section_title_en": "The Book of Hope (Kitāb al-Rajā') — Section 1033: The Second Art — Surveying the Verses and Reports Concerning Hope", "section_index": 1033, "anchors": "- Root: وجود (w-j-d)\n  * Lisan / Ayn: Core meaning of \"finding\" and \"existence\"; here in the sense of what is present and available.\n  * Al-Raghib (Mufradat): Existence as that which is found and realized; in theological context, the given order of creation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense of \"being found\"; metaphorical (majāz) extension to the entirety of created things.\n- Root: رجا (r-j-w)\n  * Lisan / Ayn: To hope, to expect with desire; the opposite of despair (ya's).\n  * Al-Raghib (Mufradat): Hope as a theological virtue — the heart's expectation of divine mercy, balanced against fear (khawf).\n  * Al-Zamakhshari (Asas): Literal: expectation of a desired outcome; metaphorical: the soul's reliance on divine generosity.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: To cover, to shield, to pardon; the root implies veiling the fault.\n  * Al-Raghib (Mufradat): Divine forgiveness as the covering of sins and the effacing of their consequence.\n  * Al-Zamakhshari (Asas): Literal: covering; metaphorical: God's remission of punishment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to emphasize exclusive attributes of divine mercy and forgiveness.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "133": [{"arabic": "بمتسع فضاء جنة عرضها السماوات والأرض ظلمة السجن وضيق الحبس ولقد صدق القائل ولم أر في عيوب الناس عيبا ... كنقص القادرين على التمام إلا أن هذا السفر لما كان مقتحمه في خطب خطير لم يستغن فيه عن دليل وخفير فاقتضى غموض السبيل وفقد الخفير والدليل وقناعة السالكين عن الحظ الجزيل بالنصيب النازل القليل اندرس مسالكه فانقطع فيه الرفاق وخلا عن الطائفين متنزهات الأنفس والملكوت والآفاق وإليه دعا الله سبحانه بقوله {سنريهم آياتنا في الآفاق وفي أنفسهم} وبقوله تعالى {وفي الأرض آيات للموقنين وفي أنفسكم أفل", "english": "And to this journey God — exalted be He — has summoned [us] by His saying: {«سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ»} [We shall show them Our signs in the horizons and in their own selves — Fussilat 41:53], and by His saying — exalted be He: {«وَفِي الْأَرْضِ آيَاتٌ لِلْمُوقِنِينَ * وَفِي أَنْفُسِكُمْ أَفَلَا تُبْصِرُونَ»} [And in the earth are signs for those who are certain; and in your own selves — do you not then see? — Dhāriyāt 51:20-21]. And upon sitting back from this journey, censure fell by His saying — exalted be He: {«وَإِنَّكُمْ لَتَمُرُّونَ عَلَيْهِمْ مُصْبِحِينَ * وَبِاللَّيْلِ أَفَلَا تَعْقِلُونَ»} [And indeed you pass by them in the morning, and by night — do you not then comprehend? — Ṣāffāt 37:137-138], and by His saying — exalted be He: {«وَكَأَيِّنْ مِنْ آيَةٍ فِي السَّمَاوَاتِ وَالْأَرْضِ يَمُرُّونَ عَلَيْهَا وَهُمْ عَنْهَا مُعْرِضُونَ»} [And how many a sign in the heavens and the earth do they pass by, while they are from it turning away — Yūsuf 12:105]. So whoever is facilitated this journey, he never ceases in his traveling to take pleasure in a Garden whose breadth is the heavens and the earth — while he is still with his body at rest, settled in his homeland.", "book_title": "Etiquette of Travel", "section_title_ar": "Section 464", "section_title_en": "The Book of the Etiquettes of Travel — Being the Seventh Book of the Quarter of Customs from The Revival of the Religious Sciences", "section_index": 464, "anchors": "- Root: سفر (s-f-r)\n  * Lisan / Ayn: Core meaning is \"unveiling/disclosure\" (kashf al-ghitā'); also denotes journeying across land, and a group of travelers (safar/qawm musāfirūn).\n  * Al-Raghib (Mufradat): Al-safar: \"the removal of a covering,\" specialized to physical unveiling (e.g., removing a turban from the head). Its theological extension: the journey as a means of unveiling hidden realities — both outward horizons (āfāq) and inward selves (anfus).\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical travel with the body, provisions for a journey (sufrah). Metaphorical (majāz): \"a face radiant with joy\" (wajh musfir); \"the morning brightening\" (asfara al-ṣubḥ) — the inner journey as illumination of the heart's countenance.\n- Root: وفي (w-f-y)\n  * Lisan / Ayn: Fullness, completion, fulfillment of a measure or covenant.\n  * Al-Raghib (Mufradat): Al-wāfī: \"that which has reached completion/perfection.\" Awfā bi-ʿahdihi: to fulfill one's covenant completely without breach. Theologically: the complete fulfillment of the servant's journey — arriving at the full measure of human perfection.\n  * Al-Zamakhshari (Asas): Literal: a full-weight dirham, complete measure. Metaphorical: \"to reach completion of years\" (māta wa-ant bi-wafā'); \"to come upon/arrive at\" (awfā ʿalā) — the journey's end as arrival at full term.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit; that which is precious and valued.\n  * Al-Raghib (Mufradat): Al-nafs: the spirit (rūḥ); in God's speech \"He knows what is in your selves\" — the inner dimension of the human being, the seat of the divine secret.\n  * Al-Zamakhshari (Asas): Literal: a precious thing (shay' nafīs). Metaphorical: \"the soul's blood\" (nafsuhu = damuhu); the inner landscape (āfāq al-anfus) as the terrain of the inward journey.\n- Sibawayh Rule: Prepositional Interposition (al-faṣl bayna al-jār wa-al-majrūr) — governing the periodic suspension of meaning across clauses, as in the verse {سَنُرِيهِمْ آيَاتِنَا فِي الْآفَاقِ وَفِي أَنْفُسِهِمْ}, where the dual prepositional phrases (fī al-āfāq / fī anfusihim) are syntactically parallel yet semantically interposed, requiring the translator to preserve the balanced suspension of the two terrains of divine signs.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Travel'", "badge": "Insight"}, {"arabic": "الأصل السادس أن الجنة والنار مخلوقتان قال الله تعالى وسارعوا إلى مغفرة من ربكم وجنة عرضها السموات والأرض أعدت للمتقين فقوله تعالى أعدت دليل على أنها مخلوقة فيجب إجراؤه على الظاهر إذ لا استحالة فيه ولا يقال لا فائدة في خلقهما قبل يوم الجزاء لأن الله تعالى لا يسأل عما يفعل وهم يسألون", "english": "For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].", "book_title": "Foundations of Belief", "section_title_ar": "Section 96", "section_title_en": "The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles", "section_index": 96, "anchors": "- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}, {"arabic": "من ربكم وجنة عرضها السموات والأرض أعدت للمتقين فقوله تعالى أعدت دليل على أنها مخلوقة فيجب إجراؤه على الظاهر إذ لا استحالة فيه ولا يقال لا فائدة في خلقهما قبل يوم الجزاء لأن الله تعالى لا يسأل عما يفعل وهم يسألون", "english": "For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].", "book_title": "Condemnation of Envy", "section_title_ar": "Section 96", "section_title_en": "The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles", "section_index": 96, "anchors": "- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'", "badge": "Insight"}], "134": [{"arabic": "وقوله {ادفع بالتي هي أحسن فإذا الذي بينك وبينه عداوة كأنه ولي حميم} وقوله {والكاظمين الغيظ والعافين عن الناس والله يحب المحسنين} وقوله {اجتنبوا كثيرا من الظن إن بعض الظن إثم ولا تجسسوا ولا يغتب بعضكم بعضا} ولما كسرت رباعيته وشج يوم أحد فجعل الدم يسيل على وجهه وهو يمسح الدم ويقول كيف يفلح قوم خضبوا وجه نبيهم بالدم وهو يدعوهم إلى ربهم (4) فأنزل الله تعالى {ليس لك من الأمر شيء} تأديبا له على ذلك وأمثال هذه التأديبات في القرآن لا تحصر وهو صلى الله عليه وسلم المقصود الأول بالتأديب والتهذيب ثم منه يشرق النور على كافة الخلق فإنه أدب بالقرآن وأدب الخ", "english": "The Messenger of God, peace and blessings be upon him, was abundant in supplication and earnest entreaty, perpetually asking God Most High to adorn him with the beauties of refined conduct and the noble traits of character. Thus he would say in his supplication: \"O God, beautify my outward form and my inward character (khuluqī wa-khalqī)\" (1), and he would say: \"O God, protect me from the reprehensible traits of character\" (2). God Most High answered his supplication, fulfilling His word, Exalted is He: {«ادعوني أستجب لكم»} [\"Call upon Me, I will answer you\"] (Ghafir 40:60). So He sent down upon him the Qur'an and disciplined him through it, and his character became the Qur'an.", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 559", "section_title_en": "The Prophet's Discipline Through the Qur'an and the Invitation to Noble Moral Traits", "section_index": 559, "anchors": "- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning of measuring, fashioning, and creating upon a precise estimation; also used for innate disposition and character.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — the root denotes straight/right estimation; used for bringing something into being from nothing (ibdāʿ) and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خلق الخراز الأديم\" — the leather-worker measures before cutting. Metaphorical (Majaz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure required by wisdom; and \"له خلق حسن\" — he has beautiful character.\n- Root: كرم (karuma)\n  * Lisan / Ayn: Generosity, nobility, honor; the root of karīm (noble/generous) and makārim (noble traits).\n  * Al-Raghib (Mufradat): \"الكرم إذا وصف الله تعالى به فهو اسم لإحسانه وإنعامه المتظاهر\" — when attributed to God, it denotes His manifest beneficence; when attributed to man, it denotes praiseworthy morals and deeds that appear from him.\n  * Al-Zamakhshari (Asas): Literal: \"كرم علينا فلان كرامة\" — he showed generosity. Metaphorical: \"قوم كرم\" — a noble people; \"كرم السحاب تكريما: جاد بمطره\" — the cloud was generous with its rain.\n- Root: أدب (adaba)\n  * Lisan / Ayn: Refinement, discipline, cultivation of character; calling to a gathering (ma'dabah) — the root implies assembling and summoning toward excellence.\n  * Al-Raghib (Mufradat): Discipline (ta'dīb) is the cultivation of the soul through praiseworthy traits and the restraint from blameworthy ones.\n  * Al-Zamakhshari (Asas): Literal: \"أدبته تأديبا\" — I disciplined him. Metaphorical: \"أدبه الله\" — God disciplined him, i.e., refined his character through divine instruction.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما أدبه القرآن\" restricts the means of the Prophet's discipline exclusively to the Qur'an, affirming that the Qur'an alone was the sufficient and complete instrument of his moral formation.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Breaking the Two Desires'", "badge": "Du'a"}], "135": [{"arabic": "قال عز وجل والذين إذا فعلوا فاحشة أو ظلموا أنفسهم ذكروا الله فاستغفروا لذنوبهم وقال علقمة والأسود قال عبد الله بن مسعود رضي الله عنهم في كتاب الله عز وجل آيتان ما أذنب عبد ذنبا فقرأهما واستغفر الله عز وجل إلا غفر الله تعالى له والذين إذا فعلوا فاحشة أو ظلموا أنفسهم الآية وقوله عز وجل ومن يعمل سوءا أو يظلم به ثم يستغفر الله يجد الله غفورا رحيما وقال عز وجل فسبح بحمد ربك واستغفره إنه كان توابا وقال تعالى والمستغفرين بالأسحار وكان صلى الله عليه وسلم يكثر أن يقول سبحانك اللهم وبحمدك اللهم اغفر لي إنك أنت التواب الرحيم (1) وقال صلى ال", "english": "God Most High said: {«والذين إذا فعلوا فاحشة أو ظلموا أنفسهم ذكروا الله فاستغفروا لذنوبهم»} — \"And those who, when they commit an indecency or wrong themselves, remember God and seek forgiveness for their sins\" {آل عمران/135}.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 246", "section_title_en": "On Seeking Forgiveness (Al-Istighfar) — Section 246", "section_index": 246, "anchors": "- Root: ذنب (dhanb)\n  * Lisan / Ayn: Core meaning of \"tail\" or \"taking hold of a tail\"; extended to signify a sin as that which trails behind and follows a person.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin is that by which one is seized and held accountable; used metaphorically for a fault that clings to its perpetrator.\n  * Al-Zamakhshari (Asas): Literal: tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as that which trails the soul and must be severed through repentance.\n- Root: غفر (ghafara)\n  * Lisan / Ayn: Covering, veiling, protecting from defilement; a shield or helmet (المغفر).\n  * Al-Raghib (Mufradat): \"الغفران والمغفرة من الله هو أن يصون العبد من أن يمسه العذاب\" — divine forgiveness is God's protection of the servant from being touched by punishment.\n  * Al-Zamakhshari (Asas): Literal: to cover and protect. Metaphorical: God's \"covering\" of sins — not merely erasure, but active safeguarding of the sinner from consequence.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The frequent interposition of \"يا رب\" and vocative constructions between the subject and predicate in supplicatory sentences, as in \"اللهم اغفر لي,\" where the vocative particle governs the imperative verb's addressee, reflecting the grammatical permissibility of separation between governing and governed elements in invocational speech.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "138": [{"arabic": "وهدى ورحمة لقوم يوقنون هذا بيان للناس وهدى وموعظة للمتقين وإذا قصد بالخطاب جميع الناس فقد قصد الآحاد فهذا القارىء الواحد مقصود فما له ولسائر الناس فليقدر أنه المقصود قال الله تعالى وأوحي إلي هذا القرآن لأنذركم به ومن بلغ قال محمد بن كعب القرظي من بلغه القرآن فكأنما كلمه الله وإذا قدر ذلك لم يتخذ دراسة القرآن عمله بل يقرؤه كما يقرأ العبد كتاب مولاه الذي كتبه إليه ليتأمله ويعمل بمقتضاه ولذلك قال بعض العلماء هذا القرآن رسائل أتتنا من قبل ربنا عز وجل بعهوده نتدبرها في الصلوات ونقف عليها في الخلوات وننفذها", "english": "[Root: ذكر]\n  • Al-Raghib (Al-Mufradat): \"الذكر: حضور الشيء القلب أو القول، ويكون تارة بالقلب وتارة باللسان، والذكر باللسان تارة يكون حضور المعنى وبعده، وقد يقال: ذكرته إذا جرى على لسانه وإن لم يحضره قلبه، والذكر بالقلب هو حضور المعنى، قال تعالى: ولا تطع من أغفلنا قلبه عن ذكرنا [الكهف/ 28]\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"ذكرت الشيء: نطقت به أو استحضرته بقلبك. وذكرت فلانا بخير وشر. واذكروا الله ذكرا كثيرا. والذكر: الشرف والصيت، قال تعالى: وإنه لذكر لك ولقومك [الزخرف/ 44]\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الذكر: الكتاب الذي فيه تذكير الناس، قال تعالى: وأنزلنا إليك الذكر لتبين للناس ما نزل إليهم [النحل/ 44]، والذكر: القرآن، قال تعالى: إنا نحن نزلنا الذكر وإنا له لحافظون [الحجر/ 9]\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 229", "section_title_en": "Section 229", "section_index": 229, "anchors": "*(Anchors established)*", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Quran Recitation'", "badge": "Du'a"}], "139": [{"arabic": "الموقن فإنه خير من ألف قلب من العوام وقد قال تعالى وأنتم الأعلون إن كنتم مؤمنين تفضيلا للمؤمنين على المسلمين والمراد به المؤمن العارف دون المقلد وقال عز وجل يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات فأراد ههنا بالذين آمنوا الذين صدقوا من غير علم وميزهم عن الذين أوتوا العلم ويدل ذلك على أن اسم المؤمن يقع على المقلد وإن لم يكن تصديقه عن بصيرة وكشف وفسر ابن عباس رضي الله عنهما قوله تعالى والذين أوتوا العلم درجات فقال يرفع الله العالم فوق المؤمن بسبعمائة درجة بين كل درجتين كما بين السماء والأرض وقال صلى الله عليه و", "english": "The Hadith—and by this the disparity of people in faith becomes manifest. For if the faith of Abū Bakr were weighed against the faith of all the worlds, save the prophets and messengers, it would preponderate. This too resembles the saying of one who says: \"If the light of the sun were weighed against the light of all lamps, it would preponderate.\" For the light of the common folk (al-ʿawāmm) is like the light of the lamp, and some of them have light like the light of the candle, while the faith of the sincerely truthful (al-ṣiddīqīn) has light like the light of the moon and the stars, and the faith of the prophets is like the sun. And just as in the light of the sun the forms of the horizons are disclosed—[Page V03P022]—with the vastness of their regions, while in the light of a lamp nothing is disclosed save a narrow corner of the house, so likewise is the disparity in the expansion of the breast (sharḥ al-ṣadr) by the gnoses (maʿārif) and the unveiling of the vastness of the Kingdom (malakūt) to the hearts of the knowers (ʿārifīn). For this reason it has come in the report that it will be said on the Day of Resurrection: \"Bring forth from the Fire whoever has in his heart the weight of a grain of faith, and half a grain, and a quarter of a grain, and a barley-corn, and an atom\" (1)—agreed upon (2).", "book_title": "Disciplining the Soul", "section_title_ar": "Section 593", "section_title_en": "The Disparity of People in Faith and the Degrees of the Hereafter", "section_index": 593, "anchors": "- Root: نور (n-w-r)\n  * Lisan / Ayn: Core meaning of light, illumination, and that by which one sees; the lamp, the moon, the stars—all termed nūr in varying intensities.\n  * Al-Raghib (Mufradat): Light is of two kinds: sensory light perceived by the eye, and intellectual/spiritual light perceived by the eye of insight (baṣīrah)—the latter being the light of reason, of the Qur'an, and of divine illumination granted to hearts.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the radiant light of celestial bodies and lamps. Metaphorical (majāz): \"nawwara al-amr\" (he illuminated the matter)—i.e., he made it clear and manifest; thus faith's light is spoken of as illumination of the heart by knowledge.\n- Root: وزن (w-z-n)\n  * Lisan / Ayn: To weigh, to measure, to balance; the act of comparing weights to determine preponderance (rujḥān).\n  * Al-Raghib (Mufradat): Weighing in the metaphysical sense denotes the just assessment of worth and degree; the preponderance of one thing over another in measure or excellence.\n  * Al-Zamakhshari (Asas): Literal: the physical act of weighing on scales. Metaphorical: the weighing of deeds and faiths in the balance of divine justice, as in the scales of the Hereafter.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending ranks; the path of ascent from one station to a higher one.\n  * Al-Raghib (Mufradat): Degree (darajah) is a station considered by ascent, not horizontal extension—used for lofty ranks and elevations in honor and proximity.\n  * Al-Zamakhshari (Asas): Literal: stairs and steps climbed. Metaphorical: \"li-fulān darajah rafīʿah\" (so-and-so has an exalted degree)—i.e., high standing and rank; \"imshi fī madārij al-ḥaqq\" (walk in the paths of truth).\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge, perception, and the mark or sign by which something is known; the scholar (ʿālim) is one distinguished by the sign of knowledge.\n  * Al-Raghib (Mufradat): Knowledge is the apprehension of a thing in its true reality (idrāk al-shayʾ bi-ḥaqīqatihi)—either apprehension of the essence itself, or judgment upon it affirming or negating a predicate.\n  * Al-Zamakhshari (Asas): Literal: perception and awareness. Metaphorical: the \"aʿlām\" (landmarks) of guidance—the traces by which the seeker is directed; the scholar is a living landmark of the religion.\n- Sibawayh Rule: Restriction and Specification (al-ḥaṣr wa al-taqyīd)—the use of syntactic structures to distinguish categories, as in the verse {«Allah will raise those who have believed among you and those who were given knowledge, by degrees»} (58:11), where the two groups are syntactically distinguished to show that faith without knowledge is one rank, and knowledge added to faith is another.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "144": [{"arabic": "يعبد رب محمد فإنه حى لا يموت قال الله تعالى وما محمد إلا رسول قد خلت من قبله الرسل أفإن مات أو قتل أنقلبتم على أعقابكم الآية (1) فكأن الناس لم يسمعوا هذه الآية إلا يومئذ وفي رواية أن أبا بكر رضي الله تعالى عنه لما بلغه الخبر دخل بيت رسول الله صلى الله عليه وسلم وهو يصلي على النبي صلى الله عليه وسلم وعيناه تهملان وغصصه ترتفع كقصع الجرة وهو في ذلك جلد الفعل والمقال فأكب عليه فكشف عن وجهه وقبل جبينه وخديه ومسح وجهه وجعل يبكي ويقول بأبي أنت وأمي ونفسي وأهلي طبت حيا وميتا انقطع لموتك ما لم ينقطع لموت أحد من الأنبياء والنبوة فعظمت عن الصفة وجللت عن البكاء وخصصت حتى صرت", "english": "He said: \"The prayer, the prayer!\" (1) ʿĀʾishah (may Allah be pleased with her) said: \"The Messenger of Allah (ﷺ) died between the rising of the forenoon (al-ḍuḥā) and the midpoint of the day, on Monday.\" (2) Fāṭimah (may Allah be pleased with her) said: \"What have I suffered from Monday! By Allah, the community will never cease to be stricken through it with a tremendous calamity.\" Umm Kulthūm said, on the day ʿAlī (may Allah honor his face) was struck down in Kūfah, the like of what she had said: \"What have I suffered from Monday! On it died the Messenger of Allah (ﷺ), on it was killed ʿAlī (may Allah honor him), and on it was killed my father — so what have I suffered from Monday!\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1300", "section_title_en": "The Death of the Messenger of Allah (ﷺ) — The Events of Monday, the Dispute over His Passing, and the Address of Abu Bakr al-Siddiq (may Allah be pleased with him)", "section_index": 1300, "anchors": "- Root: صلو (ṣ-l-w)\n  * Lisan / Ayn: Core meaning of supplication, blessing, and the act of prayer; al-salāh as the established ritual worship.\n  * Al-Raghib (Mufradat): Al-salāh denotes invocation of mercy (al-rahmah) from Allah, and from angels and believers, supplication and seeking of forgiveness; its theological nuance here is the emphatic exhortation to preserve the prayer at the moment of death.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage for the ritual prayer; metaphorical (majāz) extension for blessing and mercy descending upon the Prophet (ﷺ).\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of life; the opposite of life (al-ḥayāh).\n  * Al-Raghib (Mufradat): Al-mawt is the cessation of the rational soul's governance over the body, not its annihilation; theologically, the Prophet's death is a real tasting of death (dhawq al-mawt) yet his prophetic reality (al-nubuwwah) remains imperishable.\n  * Al-Zamakhshari (Asas): Literal for physical death; metaphorical in the sense that what is \"cut off\" by his death is only the worldly life, while the light of prophethood persists.\n- Root: خلف (kh-l-f)\n  * Lisan / Ayn: To succeed, to remain after; a successor (khalaf) and a substitute.\n  * Al-Raghib (Mufradat): Al-khalaf denotes that which takes the place of another; in theodicy, Allah is the true Successor (al-Khalaf) from every loss — the One in Whom consolation is found for every affliction.\n  * Al-Zamakhshari (Asas): Literal for succession in time; metaphorical for Allah as the abiding Substitute after the passing of every created being.\n- Sibawayh Rule: Bāb al-ḥaṣr wa al-taqyīd bi-innamā (Restriction and Focused Predication) — The construction \"إنما واعده الله\" restricts the promise of death to a single appointed term, negating any second death, and \"إنما انقطع لموتك\" restricts the severance to what pertains to worldly life alone, not to the eternal reality of prophethood.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "147": [{"arabic": "لنا ربنا إنك أنت العزيز الحكيم ربنا اغفر لنا ذنوبنا وإسرافنا في أمرنا وثبت أقدامنا وانصرنا على القوم الكافرين ربنا اغفر لنا ولإخواننا الذين سبقونا بالإيمان ولا تجعل في قلوبنا غلا للذين آمنوا ربنا إنك رؤوف رحيم ربنا آتنا من لدنك رحمة وهيئ لنا من أمرنا رشدا ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ربنا إننا سمعنا مناديا ينادي للإيمان إلى قوله عز وجل إنك لا تخلف الميعاد ربنا لا تؤاخذنا إن نسينا أو أخطأنا ربنا إلى آخر السورة (3) رب اغفر لي ولوالدي وارحمهما كما ربياني صغيرا واغفر للمؤمنين والمؤمنات والمسلمين والمسلمات الأحياء منهم والأموات", "english": "And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 252", "section_title_en": "Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)", "section_index": 252, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}], "149": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "152": [{"arabic": "يعني من القليل قال وما عرفت أن فينا من يحب الدنيا حتى نزل قوله تعالى منكم من يريد الدنيا ومنكم من يريد الآخرة واعلم أنه ليس من الزهد ترك المال وبذله على سبيل السخاء والفتوة وعلى سبيل استمالة القلوب وعلى سبيل الطمع فذلك كله من محاسن العادات ولكن لا مدخل لشيء منه في العبادات وإنما الزهد أن تترك الدنيا لعلمك بحقارتها بالإضافة إلى نفاسة الآخرة فأما كل نوع من الترك فإنه يتصور ممن لا يؤمن بالآخرة فذلك قد يكون مروءة وفتوة وسخاء وحسن خلق ولكن لا يكون زهدا إذ حسن الذكر وميل القلوب من حظوظ العاجلة وهي ألذ وأهنأ من المال وكما أن ترك المال على سبيل السلم طم", "english": "...better and more enduring. Yet one may know this while being unable to abandon this world — either due to the weakness of one's knowledge and certainty, or due to the dominance of lust prevailing over him in the present moment, making him vanquished in the hand of Satan, or due to his being deluded by Satan's promises of procrastination, day after day, until death snatches him away and nothing remains with him but regret after the loss. And to the recognition of the baseness of this world points His saying, exalted: {قُلْ مَتَاعُ الدُّنْيَا قَلِيلٌ} — \"Say: the enjoyment of this world is little\" (Q. 3:196). And to the recognition of the preciousness of the Hereafter points His saying, mighty and majestic: {وَقَالَ الَّذِينَ أُوتُوا الْعِلْمَ وَيْلَكُمْ ثَوَابُ اللَّهِ خَيْرٌ} — \"And those who were given knowledge said: Woe to you! The reward of God is better\" (Q. 28:80). Thus He alerted that it is knowledge of the preciousness of the jewel that turns one away from its substitute. And since zuhd is inconceivable except through an exchange and a turning away from the beloved toward one more beloved, a man said in his supplication: \"O God, show me this world as You see it.\" The Prophet, peace be upon him, said to him: \"Do not say that, but say: Show me this world as You have shown it to the righteous among Your servants.\" This is because God, exalted, sees it as contemptible as it truly is — and every creature, in relation to His majesty, is contemptible — whereas the servant sees it as contemptible in itself relative to what is better for him. It is inconceivable that the seller of a horse, even if he turns away from his horse, should see it as he sees, say, the vermin of the earth, for he has no need whatsoever of vermin, while he is not free of need for the horse. God, exalted, is rich by His essence from all besides Him, so He sees all things at a single degree relative to His majesty, while He sees them as differentiated relative to what is other than Him. The ascetic (al-zāhid) is the one who sees their differentiation relative to himself, not relative to another.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1089", "section_title_en": "On the Reality of Zuhd (Ascetic Renunciation) and Its Conditions — Section 1089", "section_index": 1089, "anchors": "- Root: دنا (d-n-w)\n  * Lisan / Ayn: Proximity, nearness; \"adnā\" as lesser/lower in rank or worth.\n  * Al-Raghib (Mufradat): \"Adnā\" denotes what is inferior or meaner, contrasted with \"khayr\" (the better), as in {أَتَسْتَبْدِلُونَ الَّذِي هُوَ أَدْنَىٰ بِالَّذِي هُوَ خَيْرٌ} (Q. 2:61).\n  * Al-Zamakhshari (Asas): Literal (haqiqah) sense of lowliness and despicableness; metaphorical (majaz) extension to moral baseness.\n- Root: زهد (z-h-d)\n  * Lisan / Ayn: To abstain, to regard as little; also \"zahada al-nakhl\" — to estimate fruit yield (connoting measured appraisal).\n  * Al-Raghib (Mufradat): \"Al-zāhid fī al-shay': al-rāghib 'anhu\" — the one who turns away from a thing, content with little of it; Q. 12:20 {وَكَانُوا فِيهِ مِنَ الزَّاهِدِينَ}.\n  * Al-Zamakhshari (Asas): Literal: renunciation of a thing, paucity of desire. Metaphorical: \"zahīd al-'ayn\" — one satisfied with little; \"wādin zahīd\" — a valley taking little water. Zuhd is not mere abandonment but a valuation-based exchange.\n- Root: ترك (t-r-k)\n  * Lisan / Ayn: To leave, abandon, relinquish; \"tarkah\" — inheritance left behind.\n  * Al-Raghib (Mufradat): Abandonment by choice and intention, or by compulsion; \"taraktu fulānan wahīdan\" — I left him alone, i.e., in a resultant state.\n  * Al-Zamakhshari (Asas): Literal: \"taraka al-shay'\" — to leave a thing; \"tārakahu al-bay'\" — mutual abandonment of a sale. The term implies a deliberate act with a resultant condition.\n- Sibawayh Rule: Restriction and specification via \"innamā\" (الحصر والتقييد) — used to delimit the true definition of zuhd against mere relinquishment, and to distinguish the act of the ascetic from the mere spender.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Poverty and Abstinence'", "badge": "Hadith"}, {"arabic": "بعد ما أراكم ما تحبون قيل العوافي إن الإنسان ليطغى أن رآه استغنى وكذلك إذا استغنى بالعافية قال بعضهم: إنما قال فرعون: أنا ربكم الأعلى لطول العافية لأنه لبث أربعمائة سنة لم يصدع له رأس ولم يحم له جسم ولم يضرب عليه عرق فادعى الربوبية لعنه الله ولو أخذته الشقيقة يوما لشغلته عن الفضول فضلا عن دعوى الربوبية وقال صلى الله عليه وسلم أكثروا من ذكر هاذم اللذات حديث اكثروا ذكر هاذم اللذات أخرجه الترمذي وقال: حسن غريب والنسائي وابن ماجه من حديث أبي هريرة وقد تقدم // وقيل: الحمى را", "english": "Pain is an expiation for the day [of sins]. And when he—peace and blessings be upon him—mentioned the expiation of sins through fever, Zayd ibn Thabit asked his Lord—mighty and majestic—that he not cease to be feverish, and the fever did not leave him until he died—may God have mercy on him. A group of the Ansar also asked for that, and the fever did not cease to afflict them. And when he—peace and blessings be upon him—said: \"Whoever God takes away his two precious things [his eyes],\" he was not satisfied for him with a reward less than Paradise. The hadith: \"Whoever God takes away his two precious things, He is not satisfied for him with a reward less than Paradise\"—the marfuʿ portion of it has preceded without his saying: \"He said: For indeed among the Ansar there were those who wished for blindness.\" And Jesus—peace be upon him—said: \"He is not a scholar who does not rejoice at the entry of calamities and illnesses upon his body and his wealth, for what he hopes in that of the expiation of his sins.\" And it is related that Moses—peace be upon him—looked upon a servant of great affliction and said: \"O Lord, have mercy on him.\" So He—exalted—said: \"How shall I have mercy on him when through what afflicts him I have mercy on him?\"—that is, through it I expiate his sins and increase his ranks.", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1139", "section_title_en": "The Sixth Cause for Not Seeking Medical Treatment: Fear of Returning to Negligence and Transgression Through Health", "section_index": 1139, "anchors": "- Root: مرض (m-r-ḍ)\n  * Lisan / Ayn: Core meaning is departure from the balanced state of the body—sickness, ailment, malady.\n  * Al-Raghib (Mufradat): Twofold: (1) corporeal illness, and (2) metaphorical expression for moral vices—ignorance, cowardice, avarice, hypocrisy—as in {«فِي قُلُوبِهِم مَّرَضٌ»} (Al-Baqarah 10).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): bodily sickness. Metaphorical (Majaz): \"مرض في الأمر\" (to be weak/lax in a matter), and \"تمارض\" (to feign illness). Here, the text uses the literal sense for bodily fever, but the underlying spiritual cure is freedom from the \"disease\" of disobedience.\n- Root: حمي (ḥ-m-y)\n  * Lisan / Ayn: Core meaning: heat, fever; to protect, guard, or forbid.\n  * Al-Raghib (Mufradat): \"الحمي: الحرارة المتولدة من الجواهر المحمية\" — heat generated from heated substances; also \"حميت على فلان\" (to become angry/incensed). Fever (الحمى) is the specific bodily heat-illness.\n  * Al-Zamakhshari (Asas): Literal: \"حماه حماية\" (to protect him). Metaphorical: \"حمي عليه إذا غضب\" (to be angry), and \"شديد الحميا\" (fierce in self-respect). In this text, الحمى (fever) is literal, but its purpose is protective—guarding the servant from sin.\n- Root: عفو (ʿ-f-w) [implied in كفارة]\n  * Lisan / Ayn: كفارة derives from كفر (to cover, expiate); the root عفو means to pardon, obliterate sins.\n  * Al-Raghib (Mufradat): كفارة الذنوب — the expiation that covers sins, removing their punitive trace.\n  * Al-Zamakhshari (Asas): Literal: covering. Metaphorical: expiation as a \"covering\" of the sin's record.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The phrase \"إنما قال فرعون: أنا ربكم الأعلى لطول العافية\" restricts the cause of Pharaoh's claim to prolonged well-being, using \"إنما\" to confine the reason. Also, the conditional structures \"إذا أراد الله بعبد خيرا\" and \"إذا كان في المرض حبس\" employ the syntactic pattern of temporal-condition clauses (ظرفية شرطية) to link divine will to consequent states.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Monotheism and Reliance'", "badge": "Hadith"}], "156": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "159": [{"arabic": "لنت لهم ولو كنت فظا غليظ القلب لانفضوا من حولك ولقد كان يدعو أصحابه بكناهم إكراما لهم واستمالة لقلوبهم (9) ويكني من لم تكن له كنية فكان يدعى بما كناه به (10) ويكني أيضا النساء اللاتي لهن الأولاد واللاتي لم يلدن يبتدئ لهن الكنى (11) ويكني الصبيان فيستلين به قلوبهم (1) وكان أبعد الناس غضبا وأسرعهم رضا (2) وكان أرأف الناس بالناس وخير الناس للناس وأنفع الناس للناس (3) ولم تكن ترفع في مجلسه الأصوات (4) وكان إذا قام من مجلسه قال سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك {ثم ي", "english": "I say: Know that the perfection of repentance (tawbah) is not attained merely by the inward acts of regret and resolve, but by their manifestation in the character (khuluq) that the Prophet (peace be upon him) embodied — for he was the most perfect in repentance, the most complete in turning to God, and the most excellent in conduct toward creation. His very nature was a living repentance, for he was sent as a mercy, not as a curse. The Prophet (peace be upon him) said: \"I was sent only as a mercy, and I was not sent as a curser.\" When he was asked to supplicate against a person — whether Muslim or disbeliever, general or specific — he would turn from supplicating against him to supplicating for him. He never struck anyone with his hand — neither a servant nor a woman — except when striving in the path of God, the Exalted. He never took revenge for anything done to him personally, except when a sanctity of God was violated — then his vengeance was for God's sake. He was never given a choice between two matters except that he chose the easier of them, unless it involved sin or the severing of kinship — then he was the most distant of people from it. Whenever anyone came to him — whether free, slave, or bondmaid — he would stand with him in his need. Anas (may God be pleased with him) said: \"By Him who sent him with the truth, he never said to me regarding anything I did that he disliked, 'Why did you do that?' Nor did his wives rebuke me except that he would say: 'Leave him; this was only by a Book and a decree.'\" They said: \"The Messenger of God (peace be upon him) never found fault with a resting place — if they spread something for him, he lay upon it, and if they did not spread anything, he lay upon the bare earth.\" God, the Exalted, described him in the Torah before His sending him, in the first line, saying: \"Muhammad is My Messenger, My chosen servant — neither harsh nor coarse, nor clamorous in the marketplaces; he does not repay evil with evil, but rather pardons and forgives. His birth is in Mecca, his emigration is in Ṭābah (Medina), and his dominion is in Syria. He and those with him gird themselves at the waist, callers to the Qur'an and knowledge; they perform ablution upon their extremities.\" Likewise, He described him in the Gospel.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 562", "section_title_en": "The Book of Repentance — Section 562: The Prophet's Character as the Model of Repentance and Forbearance", "section_index": 562, "anchors": "- Root: جلس (jalasa)\n  * Lisan / Ayn: Core meaning is \"to sit,\" but the root extends to \"a rugged, elevated land\" (jals) — the place where one establishes one's seat; also \"a sturdy, firm she-camel\" (jals), indicating firmness of posture and resolve.\n  * Al-Raghib (Mufradat): \"The origin of jalsa is the rugged ground, and the elevated plateau was called jals for that reason... Then sitting (julūs) was made for every act of remaining seated, and majlis is every place where a person sits.\"\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"He has a good posture of sitting (jilsah).\" Metaphorical (Majaz): \"He is the companion of his own self (jalis nafsihi)\" — i.e., one who is given to solitude and withdrawal, a state befitting the penitent.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's exclusive attributes, e.g., \"he was not sent but as a mercy,\" restricting the purpose of his mission.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Pride and Conceit'", "badge": "Du'a"}, {"arabic": "ومجلسه مع ذلك مجلس حياء وتواضع وأمانة قال الله تعالى فيما رحمة من الله لنت لهم ولو كنت فظا غليظ القلب لانفضوا من حولك ولقد كان يدعو أصحابه بكناهم إكراما لهم واستمالة لقلوبهم (9) ويكني من لم تكن له كنية فكان يدعى بما كناه به (10) ويكني أيضا النساء اللاتي لهن الأولاد واللاتي لم يلدن يبتدئ لهن الكنى (11) ويكني الصبيان فيستلين به قلوبهم (1) وكان أبعد الناس غضبا وأسرعهم رضا (2) وكان أرأف الناس بالناس وخير الناس للناس وأنفع الناس للناس (3) ولم تكن ترفع في مجلسه الأصوات (4) وكان إذا قام من مجلسه قال سبحانك اللهم وبحمدك أشهد أن لا إله إلا أنت أستغفرك وأتوب إليك {ثم يق", "english": "I say: Know that the perfection of repentance (tawbah) is not attained merely by the inward acts of regret and resolve, but by their manifestation in the character (khuluq) that the Prophet (peace be upon him) embodied — for he was the most perfect in repentance, the most complete in turning to God, and the most excellent in conduct toward creation. His very nature was a living repentance, for he was sent as a mercy, not as a curse. The Prophet (peace be upon him) said: \"I was sent only as a mercy, and I was not sent as a curser.\" When he was asked to supplicate against a person — whether Muslim or disbeliever, general or specific — he would turn from supplicating against him to supplicating for him. He never struck anyone with his hand — neither a servant nor a woman — except when striving in the path of God, the Exalted. He never took revenge for anything done to him personally, except when a sanctity of God was violated — then his vengeance was for God's sake. He was never given a choice between two matters except that he chose the easier of them, unless it involved sin or the severing of kinship — then he was the most distant of people from it. Whenever anyone came to him — whether free, slave, or bondmaid — he would stand with him in his need. Anas (may God be pleased with him) said: \"By Him who sent him with the truth, he never said to me regarding anything I did that he disliked, 'Why did you do that?' Nor did his wives rebuke me except that he would say: 'Leave him; this was only by a Book and a decree.'\" They said: \"The Messenger of God (peace be upon him) never found fault with a resting place — if they spread something for him, he lay upon it, and if they did not spread anything, he lay upon the bare earth.\" God, the Exalted, described him in the Torah before His sending him, in the first line, saying: \"Muhammad is My Messenger, My chosen servant — neither harsh nor coarse, nor clamorous in the marketplaces; he does not repay evil with evil, but rather pardons and forgives. His birth is in Mecca, his emigration is in Ṭābah (Medina), and his dominion is in Syria. He and those with him gird themselves at the waist, callers to the Qur'an and knowledge; they perform ablution upon their extremities.\" Likewise, He described him in the Gospel.", "book_title": "Etiquette of Living and Prophetic Character", "section_title_ar": "Section 562", "section_title_en": "The Book of Repentance — Section 562: The Prophet's Character as the Model of Repentance and Forbearance", "section_index": 562, "anchors": "- Root: جلس (jalasa)\n  * Lisan / Ayn: Core meaning is \"to sit,\" but the root extends to \"a rugged, elevated land\" (jals) — the place where one establishes one's seat; also \"a sturdy, firm she-camel\" (jals), indicating firmness of posture and resolve.\n  * Al-Raghib (Mufradat): \"The origin of jalsa is the rugged ground, and the elevated plateau was called jals for that reason... Then sitting (julūs) was made for every act of remaining seated, and majlis is every place where a person sits.\"\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"He has a good posture of sitting (jilsah).\" Metaphorical (Majaz): \"He is the companion of his own self (jalis nafsihi)\" — i.e., one who is given to solitude and withdrawal, a state befitting the penitent.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's exclusive attributes, e.g., \"he was not sent but as a mercy,\" restricting the purpose of his mission.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Living and Prophetic Character'", "badge": "Du'a"}, {"arabic": "يتوكل على الله فهو حسبه وقال سبحانه وتعالى إن الله يحب المتوكلين وأعظم بمقام موسوم بمحبة الله تعالى صاحبه ومضمون كفاية الله تعالى ملابسه فمن الله تعالى حسبه وكافيه ومحبه ومراعيه فقد فاز الفوز العظيم فإن المحبوب لا يعذب ولا يبعد ولا يحجب وقال تعالى أليس الله بكاف عبده فطالب الكفاية من غيره والتارك للتوكل هو المكذب لهذه الآية فإنه سؤال في معرض استنطاق بالحق كقوله تعالى هل أتى على الإنسان حين من الدهر لم يكن شيئا مذكورا وقال عز وجل ومن يتوكل على الله فإن الله عزيز حكيم أي عزيز لا يذل من استجار به ولا يضيع م", "english": "Praise be to God, the Disposer of the dominion (mulk) and the spiritual sovereignty (malakūt), the One alone in majesty (ʿizzah) and omnipotence (jabarūt), Who raised the heaven without any pillar, and apportioned therein the provisions of His servants; Who turned the eyes of those possessed of hearts and intellects away from the observation of intermediaries and causes (al-wasāʾiṭ wa-l-asbāb) toward the Causer of causes (musabbib al-asbāb); and Who lifted their concern from turning toward anything other than Him, and from relying upon any disposer besides Him. Thus they worshipped none but Him alone — in knowledge that He is the One, the Unique, the Eternal Refuge (al-ṣamad), the God — and in verification that all classes of creatures are servants like themselves, from whom no provision is sought, and that there is no atom but God created it, and no beast but upon God is its sustenance. When they verified that He is the Guarantor of His servants' provision and the Surety for it, they relied upon Him and said: {«حسبنا الله ونعم الوكيل»} — \"God is sufficient for us, and what an excellent Guardian!\" (Q. 3:173).", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1102", "section_title_en": "The Book of Divine Unity (Tawḥīd) and Reliance (Tawakkul) — Book Five of the Quarter of Deliverance from The Revival of the Religious Sciences", "section_index": 1102, "anchors": "- Root: وكل (w-k-l)\n  * Lisan / Ayn: Core meaning of delegating, entrusting, and appointing a deputy (wakīl) to manage one's affairs.\n  * Al-Raghib (Mufradat): \"التوكيل: أن تعتمد على غيرك وتجعله نائبا عنك\" — Reliance (tawakkul) is the act of depending upon another and making him a deputy over your affair; its theological force is that God alone is the sufficient Guardian (wakīl), as in {«وكفى بالله وكيلا»}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): appointing an agent; Metaphorical (majāz): the weak man who leans on others (وكل ووكلة تكلة). In the divine context, tawakkul is a real, not figurative, transfer of one's trust to God as the sole efficient cause.\n- Root: سبب (s-b-b)\n  * Lisan / Ayn: A rope, cord, or means by which one ascends or reaches something; extended to any intermediary cause.\n  * Al-Raghib (Mufradat): \"سمي كل ما يتوصل به إلى شيء سببا\" — Every means by which one reaches a goal is termed a cause (sabab); God is the \"Musabbib al-Asbāb\" (Causer of causes), transcending the causal ropes He suspends.\n  * Al-Zamakhshari (Asas): Literal: a physical cord; Metaphorical: any linkage or connection. Here, the \"gaze upon causes\" (mulāḥaẓat al-asbāb) is a metaphorical veiling of the true Agent.\n- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: To count, reckon, suffice; derived: ḥasb (sufficiency), ḥasīb (one who suffices, or the Reckoner).\n  * Al-Raghib (Mufradat): \"الحساب: استعمال العدد\" — Counting; but in the divine attribute, \"ḥasb\" denotes God's all-sufficient guardianship, as in {«حسبنا الله ونعم الوكيل»}.\n  * Al-Zamakhshari (Asas): Literal: reckoning by number; Metaphorical: \"احتسبت ما عند فلان: اختبرته وسبرته\" — to test and probe. God's being \"Ḥasb\" for the believer is a tested, verified sufficiency, not a mere claim.\n- Root: غمض (gh-m-d)\n  * Lisan / Ayn: To close the eye, to be obscure, low-lying, or hidden ground.\n  * Al-Raghib (Mufradat): \"يستعار للتغافل والتساهل\" — closing the eye is metaphorically used for overlooking; here, the \"ghumūḍ\" (obscurity) of tawakkul is its conceptual hiddenness from the intellect.\n  * Al-Zamakhshari (Asas): Literal: a low, concealed place; Metaphorical: \"أمر غامض\" — a subtle, difficult affair. The text uses it for the doctrinal opacity of tawakkul.\n- Sibawayh Rule: Interposition of the prepositional phrase (باب الفصل بين الجار والمجرور) — The periodic structure \"فلم يعبدوا إلا إياه\" and \"فقالوا حسبنا الله\" shows the separation of the operative verb from its object for rhetorical emphasis, permissible where the pause is complete and the meaning remains unbroken.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}, {"arabic": "فمن قوله تعالى فبما رحمة من الله لنت لهم وأما الزهد فمن قوله تعالى وقال الذين أوتوا العلم ويلكم ثواب الله خير لمن آمن وعمل صالحا ولما تلا رسول الله صلى الله عليه وسلم قوله تعالى فمن يرد الله أن يهديه يشرح صدره للإسلام فقيل له ما هذا الشرح فقال إن النور إذا قذف في القلب انشرح له الصدر وانفسح قيل فهل لذلك من علامة قال صلى الله عليه وسلم نعم التجافي عن دار الغرور والإنابة إلى دار الخلود والاستعداد للموت قبل نزوله (2) ومنها أن يكون أكثر بحثه عن علم الأعمال وعما يفسدها ويشوش القلوب ويهيج الو", "english": "As for the fear (al-khashyah), it is from His saying, the Exalted: {«إِنَّمَا يَخْشَى اللَّهَ مِنْ عِبَادِهِ الْعُلَمَاءُ»} — \"Only those of His servants who possess knowledge fear Allah\" (Fāṭir 35:28). For khashyah is a fear suffused with veneration, and it arises only from knowledge of the Mighty and Majestic — for whoever knows Him fears Him, and whoever does not know Him does not fear Him.", "book_title": "Book of Knowledge", "section_title_ar": "Section 61", "section_title_en": "The Book of God's Book — Fear, Humility, and the Preference for the Hereafter", "section_index": 61, "anchors": "- Root: خشع (Khasha'a)\n  * Lisan / Ayn: Core meaning of lowliness, submissiveness, and being lowered to the ground.\n  * Al-Raghib (Mufradat): \"الخشوع: الضراعة\" — Khushū' is a state of supplication and humility; most often used for what appears on the limbs, while ḍarā'ah is for the heart. When the heart humbles, the limbs follow.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خشع له وتخشع: ذل وتطامن\" — to be lowly and submissive. Metaphorical (Majaz): \"أرض خاشعة\" — a land that is low-lying; \"خشعت الأصوات\" — voices lowered in awe.\n- Root: خشي (Khashiya)\n  * Lisan / Ayn: Fear mixed with awe and reverence.\n  * Al-Raghib (Mufradat): \"الخشية: خوف يشوبه تعظيم\" — Khashyah is fear suffused with veneration, and it most often arises from knowledge of what is feared.\n  * Al-Zamakhshari (Asas): Distinguished from mere fear (khawf) by its component of reverential awe.\n- Root: خلق (Khuluq)\n  * Lisan / Ayn: Inherent disposition, character, nature.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — Its root is right measure and proportion; used for the creation of things and for the moral constitution of the soul.\n  * Al-Zamakhshari (Asas): Literal: \"خلق الخراز الأديم\" — the leather-worker cutting and measuring hide before cutting. Metaphorical: \"خلق الله الخلق\" — God originated creation upon a measure required by wisdom; \"وله خلق حسن\" — he has beautiful character.\n- Root: زهد (Zuhd)\n  * Lisan / Ayn: Abstinence, renunciation, disinclination.\n  * Al-Raghib (Mufradat): \"الزاهد في الشيء: الراغب عنه والراضي منه بالزهيد\" — The ascetic is one who turns away from a thing and is content with little of it.\n  * Al-Zamakhshari (Asas): Literal: \"زهد في الشيء: رغب عنه\" — to turn away from something. Metaphorical: \"واد زهيد\" — a valley that takes little water; \"رجل زهيد\" — a man of little good.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد بإنما) — The particle \"innamā\" restricts the predicate to the subject alone, establishing a definitive causal linkage between knowledge and reverential fear.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "160": [{"arabic": "ومن يرد أن يضله يجعل صدره ضيقا حرجا كأنما يصعد في السماء إن ينصركم الله فلا غالب لكم وإن يخذلكم فمن ذا الذي ينصركم من بعده فهو الهادي والمضل يفعل ما يشاء ويحكم ما يريد لا راد لحكمه ولا معقب لقضائه خلق الجنة وخلق لها أهلا فاستعملهم بالطاعة وخلق النار وخلق لها أهلا فاستعمله بالمعاصي وعرف الخلق علامة أهل الجنة وأهل النار فقال إن الأبرار لفي نعيم وإن الفجار لفي جحيم ثم قال تعالى فيما روى عن نبيه صلى الله عليه وسلم هؤلاء في الجنة ولا أبالي وهؤلاء في النار ولا أبالي (1) فتعالى الله الملك الحق لا يسئل عما يفعل وهم يسئلون ولنقتصر على هذا القدر اليسير من ذكر عجائب القلب فإ", "english": "I say: Know that when the Shayṭān prevails and the heart inclines to its own kind among the parties of the Shayṭān, turning away from the party of God—Exalted is He—and His saints, and aiding the party of the Shayṭān and His enemies, then there flows upon its bodily members, by virtue of the prior decree, that which is the cause of its distance from God—Exalted is He. But if the angelic attributes are predominant over the heart, the heart does not lend its ear to the Shayṭān's seduction, nor to his incitement toward the immediate world, nor to his belittling of the matter of the Hereafter. Rather, it inclines to the party of God—Exalted is He—and obedience appears upon its members in accordance with what has preceded in the decree. Thus, the heart of the believer is between two fingers of the fingers of the All-Merciful—that is, between the mutual tugging of these two hosts—and this is the meaning of \"turning\" (taqlīb): the transition from one party to another. As for perpetual constancy, whether with the party of the angels or with the party of the Shayṭān, that is rare on both sides. These acts of obedience and disobedience emerge from the treasuries of the Unseen into the world of witness by way of the treasury of the heart, for it is among the treasuries of the Malakūt. And when they do emerge, they become signs by which the masters of hearts recognize the prior decree. For whomever is created for Paradise, the means of obedience are made easy for him; and whomever is created for the Fire, the means of disobedience are made easy for him, and evil companions are given sway over him, and the rule of the Shayṭān is cast into his heart. For by various kinds of deceptions he beguiles the foolish, saying: \"God is Merciful, so do not care\"; and \"All people do not fear God, so do not oppose them\"; and \"Life is long, so be patient until you repent tomorrow.\" He promises them and fills them with desires—{يَعِدُهُمْ وَيُمَنِّيهِمْ وَمَا يَعِدُهُمُ الشَّيْطَانُ إِلَّا غُرُورًا} \"He promises them and fills them with desires, and the Shayṭān promises them nothing but delusion\" {النساء/120}. He promises them repentance and fills them with hopes of forgiveness, and thus destroys them, by God's permission, through these ruses and what runs in their course. So he expands their hearts to accept delusion and constricts them from accepting the truth. And all of that is by God's decree and destiny: {فَمَن يُرِدِ اللَّهُ أَن يَهْدِيَهُ يَشْرَحْ صَدْرَهُ لِلْإِسْلَامِ وَمَن يُرِدْ أَن يُضِلَّهُ يَجْعَلْ صَدْرَهُ ضَيِّقًا حَرَجًا كَأَنَّمَا يَصَّعَّدُ فِي السَّمَاءِ} \"Whomsoever God wishes to guide, He expands his breast to Islam; and whomsoever He wishes to lead astray, He makes his breast narrow and constricted, as though he were climbing into the sky\" {الأنعام/125}. {إِن يَنصُرْكُمُ اللَّهُ فَلَا غَالِبَ لَكُمْ وَإِن يَخْذُلْكُمْ فَمَن ذَا الَّذِي يَنصُرُكُم مِّن بَعْدِهِ} \"If God helps you, none can overcome you; and if He forsakes you, who is there to help you after Him?\" {آل عمران/160}. He is the Guide and the Misleader; He does what He wills and decrees what He desires. There is no repeller of His judgment and no reverser of His decree. He created Paradise and created for it its people, and employed them in obedience; and He created the Fire and created for it its people, and employed them in disobedience. And He made known to creation the mark of the people of Paradise and the people of the Fire, saying: {إِنَّ الْأَبْرَارَ لَفِي نَعِيمٍ وَإِنَّ الْفُجَّارَ لَفِي جَحِيمٍ} \"Verily, the righteous shall be in bliss, and verily, the wicked shall be in the Blazing Fire\" {الانفطار/13-14}. Then He—Exalted is He—said, as related from His Prophet, peace be upon him: \"These are in Paradise, and I do not care; and these are in the Fire, and I do not care.\" Exalted is God, the King, the Truth! {لَا يُسْأَلُ عَمَّا يَفْعَلُ وَهُمْ يُسْأَلُونَ} \"He is not questioned about what He does, but they shall be questioned\" {الأنبياء/23}.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 611", "section_title_en": "The Explanation of the Heart's Rapid Fluctuation and the Division of Hearts Between Change and Constancy", "section_index": 611, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning, overturning, and revolving a thing from one face to another; the heart is so named for its constant oscillation.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart's essence is its perpetual turning and redirection; its fluctuation is not accidental but constitutive of its nature.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): physical overturning. Metaphorical (Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — the heart's movement between the two hosts (jundān) is a real, dynamic turnover of allegiance.\n- Root: شيط (sh-y-t)\n  * Lisan / Ayn: Burning, scorching, or spoiling meat by over-smoking; blood going to waste.\n  * Al-Raghib (Mufradat): The Shayṭān is so named for his being burned and banished from mercy.\n  * Al-Zamakhshari (Asas): Metaphorical: \"شاط دمه إذا بطل\" — the Shayṭān's work is to render the servant's spiritual life wasted and nullified, as blood spilled in vain.\n- Root: حزب (ḥ-z-b)\n  * Lisan / Ayn: A group or party with cohesion and strength; al-Ḥayzabūn (the old woman) shows the root's extension to a gathered mass.\n  * Al-Raghib (Mufradat): \"الحزب: جماعة فيها غلظ\" — the party of God (ḥizb Allāh) versus the party of the Shayṭān (ḥizb al-Shayṭān) are two opposing, organized camps in cosmic conflict.\n  * Al-Zamakhshari (Asas): Literal: a band of partisans. Metaphorical: \"قرأ حزبه من القرآن\" — a portion assigned; here, the heart is assigned to one of the two parties by divine decree.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measuring and smoothing; creating as precise estimation.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — creation is origination upon a just measure; God's creative act entails the pre-ordainment of ends.\n  * Al-Zamakhshari (Asas): Literal: shaping leather before cutting. Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation of Paradise and Hellfire and their inhabitants is an act of wise, pre-eternal determination.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"إنما ذكرنا منه ما يحتاج إليه\" restricts the author's purpose: only the necessary measure of the heart's wonders is expounded, not exhaustive treatment, signaling a deliberate boundary of the science of practical religion (ʿilm al-muʿāmalah).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "161": [{"arabic": "وقال تعالى {ثم توفى كل نفس ما كسبت وهم لا يظلمون} وقال تعالى {يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو أن بينها وبينه أمدا بعيدا ويحذركم الله نفسه} وقال تعالى {واعلموا أن الله يعلم ما في أنفسكم فاحذروه} فعرف أرباب البصائر من جملة العباد أن الله تعالى لهم بالمرصاد وأنهم سيناقشون في الحساب ويطالبون بمثاقيل الذر من الخطرات واللحظات وتحققوا أنه لا ينجيهم من هذه الأخطار إلا لزوم المحاسبة وصدق المراقبة ومطالبة النفس في الأنفاس والحركات ومحاسبتها في الخطرات والل", "english": "To proceed: God Most High has said: {And We shall set up the scales of justice for the Day of Resurrection, so no soul shall be wronged in anything; and if it be the weight of a grain of mustard seed, We shall bring it forth, and sufficient are We as Reckoners} (21:47). And He said: {And the Book shall be placed, and you will see the criminals fearful of what is in it, and they will say, \"Woe to us! What is this book that leaves neither small nor great but has enumerated it?\" And they will find what they did present, and your Lord wrongs no one} (18:49). And He said: {On the Day when God will raise them all together and inform them of what they did — God has enumerated it, and they have forgotten it, and God is Witness over all things} (58:6). And He said: {On that Day, people will issue forth in scattered groups to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it} (99:6-8). And He said: {Then every soul shall be paid in full for what it has earned, and they shall not be wronged} (2:281). And He said: {On the Day when every soul will find what it did of good present, and what it did of evil, it will wish that between it and that there were a far distance; and God warns you of Himself} (3:30). And He said: {And know that God knows what is in your souls, so beware of Him} (2:235).", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1230", "section_title_en": "Exposition of the Reality of Truthfulness (Al-Sidq), Its Meaning, and Its Grades — Book of Vigilance and Self-Reckoning, Being the Eighth Book of the Quarter of Deliverance from the Revival of the Religious Sciences", "section_index": 1230, "anchors": "- Root: رقب (Raqaba)\n  * Lisan / Ayn: To watch, guard, observe; a watcher (raqīb) is one who stands vigilant over something, awaiting its occurrence.\n  * Al-Raghib (Mufradat): Raqaba denotes protective watchfulness; al-raqīb is a divine attribute signifying His perpetual oversight of all that transpires, with no moment of neglect.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical watching/awaiting. Metaphorical (majāz): \"This matter is upon your necks (fī riqābikum)\" — i.e., an obligation you must vigilantly uphold; \"the death is in the necks\" — imminent and inescapable.\n- Root: حسب (Hasaba)\n  * Lisan / Ayn: To count, reckon, compute; al-ḥisāb is the act of enumeration and settlement of accounts.\n  * Al-Raghib (Mufradat): Al-ḥisāb is the employment of number; divine reckoning (ḥisāb) on the Day of Resurrection is the exacting appraisal of deeds, even to the atom's weight.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"they reckon news (yaḥtasibūna al-akhbār)\" — they investigate and ascertain, as one places knowledge in place of conjecture.\n- Root: قلب (Qalaba)\n  * Lisan / Ayn: To turn, overturn, transform; the heart (qalb) is so named for its constant fluctuation and turning of states.\n  * Al-Raghib (Mufradat): Qalaba is the turning of a thing from one state to another; the heart's inner thoughts (khaṭarāt) are its successive movements, which God surveys.\n  * Al-Zamakhshari (Asas): Literal: turning a garment or object. Metaphorical: \"the teacher turned the boys\" (sent them home); \"the merchant turned the goods\" (scrutinized them) — thus, inner reflection (taqallub) is the soul's scrutiny of its own motives.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"إنما يحاسبهم لتعلم كل نفس\" — the sole purpose of reckoning is specified, excluding all other ends.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "توفي كل نفس ما كسبت {وأن} كل نفس بما كسبت رهينة فما الذي غركم بالله بعد أن سمعتم وعقلتم قالوا لو كنا نسمع أو نعقل ما كنا في أصحاب السعير فاعترفوا بذنبهم فسحقا لأصحاب السعير فإن قلت فأين مظنة الرجاء وموضعه المحمود فاعلم أنه محمود في موضعين أحدهما في حق العاصي المنهمك إذا خطرت له التوبة فقال له الشيطان وأنى تقبل توبتك فيقنطه من رحمة الله تعالى فيجب عند هذا أن يقمع القنوط بالرجاء ويتذكر أن الله يغفر الذنوب جميعا وأن الله كريم يقبل التوبة عن عباده وأن التوبة طاعة تكفر الذنو", "english": "Every soul shall taste what it has earned. And {«وَأَنَّ كُلَّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ»} — \"And that every soul is a pledge for what it has earned.\" So what has deluded you concerning God, after you have heard and comprehended? They will say: \"Had we but listened or reasoned, we would not be among the companions of the Blaze.\" Thus they will confess their sin. So away with the companions of the Blaze!", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 890", "section_title_en": "The Anatomy of Hope (Rajā') and Delusion (Ghurūr): A Kalamic Dissection of the Soul's Two States", "section_index": 890, "anchors": "- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which desires proximity and discourse; the locus of breath and life.\n  * Al-Raghib (Mufradat): Nafs denotes the rūḥ (spirit) and, in divine attribution, the very Dhāt (Essence) of God—as in {«وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ»}—entailing no real multiplicity despite grammatical annexation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the living, breathing self; metaphorical (Majaz) usage extends to \"blood\" (nafs sā'ilah) and the \"evil eye\" (nafs as 'ayn). Here, it signifies the moral agent bearing responsibility.\n- Root: توب (Tawb)\n  * Lisan / Ayn: Return, repentance; the act of turning back from error.\n  * Al-Raghib (Mufradat): Tawbah is abandoning the sin in the most excellent manner—the third and highest form of excuse (after denial and pretext). In Sacred Law: forsaking the sin due to its ugliness, remorse for the past, resolve against recurrence, and restitution of what can be restored.\n  * Al-Zamakhshari (Asas): Literal: \"The servant repents to God from his sin; God turns in mercy to the servant.\" The reciprocal dynamic—God's acceptance (tawbah) meeting the servant's return (inābah)—is operative in this text.\n- Root: ذنب (Dhanb)\n  * Lisan / Ayn: The tail of an animal; what trails behind; by extension, a fault or crime as the \"consequence\" one drags after oneself.\n  * Al-Raghib (Mufradat): In origin, \"taking hold of a thing's tail\"—i.e., seizing the outcome. Sin is that which trails the soul and binds it as a pledge (rahīnah).\n  * Al-Zamakhshari (Asas): Metaphorical: \"He is among the tails (adhnāb) of the people\"—the laggards. The sinner is one who follows his lower tail, and the verse {«كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ»} makes the soul a hostage to its own trailing deeds.\n- Root: غفر (Ghafr)\n  * Lisan / Ayn: To cover, shield, or protect; the Ghifār tribe's name; a helmet (mighfar) that shields the head.\n  * Al-Raghib (Mufradat): Ghufrān from God is His shielding the servant from the touch of chastisement—a protective covering, not mere erasure. It may also mean outward forbearance.\n  * Al-Zamakhshari (Asas): Literal: \"O God, forgive (ghufrānan)!\"—a covering over the stain. Metaphorical: Zuhayr's beasts \"did not forgive\" their negligence—i.e., did not shield the offspring from destruction. Hope of forgiveness without repentance is thus not ghufrān but ghurūr (delusion).\n- Sibawayh Rule: باب الفصل بين العامل والمعمول (Interposition between Operator and Operand) — The periodic structure of verses like {«إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا»} delays the predicate to heighten rhetorical impact; the conditional \"if you say... know that\" (fa-in qulta... fa-'lam) governs the entire dialectical sequence, requiring the apodosis to resolve the protasis with logical necessity.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "163": [{"arabic": "وسعة معارفهم وهم درجات عند الله ولا يدخل في الحصر تفاوت درجاتهم فقد ظهر أن لذة الرياسة وهي باطنة أقوى في ذوي الكمال من لذات الحواس كلها وأن هذه اللذة لا تكون لبهيمة ولا لصبي ولا لمعتوه وأن لذة المحسوسات والشهوات تكون لذوي الكمال مع لذة الرياسة ولكن يؤثرون الرياسة فأما معنى كون معرفة الله وصفاته وأفعاله وملكوت سمواته وأسرار ملكه أعظم لذة من الرياسة فهذا يختص بمعرفته من نال رتبة المعرفة وذاقها ولا يمكن إثبات ذلك عند من لا قلب له لأن القلب معدن هذه القوة كما أنه لا يمكن إثبات رج", "english": "...and the vastness of their cognitions—and they are [various] degrees before God, and the disparity of their degrees cannot be encompassed [by enumeration]. Thus it has become manifest that the pleasure of dominion (riyāsah)—which is inward—is stronger in those possessed of perfection than all the pleasures of the senses combined, and that this pleasure is not experienced by a beast, nor by a child, nor by one bereft of reason. And the pleasure of sensibles and appetites does occur in those possessed of perfection alongside the pleasure of dominion, yet they prefer dominion. As for the meaning of the fact that the knowledge of God—His attributes, His acts, the kingdom of His heavens, and the secrets of His sovereignty—is a greater pleasure than dominion, this is specific to the one who, of his knowledge, has attained the station of gnosis (maʿrifah) and has tasted it. And it is not possible to establish this before one who has no heart, for the heart is the mine of this faculty—just as it is not possible to establish the preponderance of the pleasure of intercourse over the pleasure of playing with the polo-stick in the case of boys, nor its preponderance over the pleasure of smelling violets in the case of the impotent (ʿanīn), because he has lost the faculty by which this pleasure is perceived. But whoever is spared the affliction of impotence and whose sense of smell remains sound perceives the disparity between the two pleasures. And at this point nothing remains but to say: \"Whoever tastes, knows.\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1160", "section_title_en": "The Superiority of the Pleasure of Knowledge over All Other Pleasures, and the States of Those Whose Hearts Are Occupied with God Alone", "section_index": 1160, "anchors": "- Root: عرف (ʿ-r-f)\n  * Lisan / Ayn: Core meaning of discerning, recognizing, and knowing by reflection upon traces and effects.\n  * Al-Raghib (Mufradat): Maʿrifah is the perception of a thing through reflection and deliberation upon its effect; it is more specific than ʿilm and is the mode by which human beings know God—through His works, not His essence.\n  * Al-Zamakhshari (Asas): Literal usage denotes recognition after prior ignorance; metaphorical usage extends to requital and intimate acquaintance.\n- Root: لذذ (l-dh-dh) — [Note: listed as recently used, but required by the text's central term; I anchor it via its occurrence in the passage itself]\n  * Lisan / Ayn: Pleasure (ladhdhah) as the sensory or spiritual perception of what is agreeable to one's nature.\n  * Al-Raghib (Mufradat): Pleasure is the attainment of what is perceived as harmonious; its highest form is the perception of the intelligible and the divine.\n  * Al-Zamakhshari (Asas): Literal for sensory gratification; metaphorical for intellectual and spiritual delight.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart as the organ of turning and overturning; the seat of fluctuating states.\n  * Al-Raghib (Mufradat): Taqlīb is the turning of a thing from one state to another; the heart (qalb) is so named for its constant fluctuation and is the faculty of intellection.\n  * Al-Zamakhshari (Asas): Literal: to turn over; metaphorical: to ponder and scrutinize matters, as in \"قلبوا لك الأمور\" (they turned matters over for you).\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the construction \"إن لله عبادا\" where the predicate is delayed for emphasis and dramatic effect.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}, {"arabic": "والذين أوتوا العلم درجات} وقال تعالى {هم درجات عند الله} والفضيلة نسبية واستحقارنا للصيارفة عند قياسهم بالملوك لا يدل على حقارتهم إذا قيسوا بالكناسين فلا تظن أن ما نزل عن الرتبة القصوى ساقط القدر بل الرتبة العليا للأنبياء ثم الأولياء ثم العلماء الراسخين في العلم ثم للصالحين على تفاوت درجاتهم وبالجملة {فمن يعمل مثقال ذرة خيرا يره ومن يعمل مثقال ذرة شرا يره} ومن قصد الله تعالى بالعلم أي علم كان نفعه ورفعه لا محالة الوظيفة العاشرة أن يعلم نسبة العلوم إلى المقصد كيما يؤثر الرفيع القريب على البعيد والمهم على", "english": "By this I do not mean the belief which the common man picks up by inheritance or by rote acquisition, nor the method of theological disputation and argumentation for fortifying one's creed against the evasions of opponents—as is the ultimate aim of the scholastic theologian (mutakallim). Rather, it is a kind of certainty which is the fruit of a light that God—may He be exalted—casts into the heart of a servant whose inward being has been purified by spiritual striving (mujāhadah) from all impurities, until he attains to the rank of the faith of Abū Bakr—may God be pleased with him—whose faith, were it weighed against the faith of all created beings, would outweigh them, as the Master of mankind—peace and blessings be upon him—bore witness for him. For in my view, what the common man believes and what the theologian arranges—who exceeds the common man only in the craft of speech (kalām), and for that very reason his craft is named \"kalām\"—is not that rank. Indeed, ʿUmar, ʿUthmān, ʿAlī, and the rest of the Companions—may God be pleased with them all—fell short of it, until Abū Bakr surpassed them by that secret which was deposited in his breast.", "book_title": "Foundations of Belief", "section_title_ar": "Section 43", "section_title_en": "The Revival of the Religious Sciences — Section 43: On the Ordering of the Sciences and the Duties of the Seeker", "section_index": 43, "anchors": "- Root: ذوق (dh-w-q)\n  * Lisan / Ayn: Perceiving by taste; experiential apprehension\n  * Al-Raghib (Mufradat): Direct, unmediated perception—contrasted with mere cognition or hearsay\n  * Al-Zamakhshari (Asas): Literal tasting vs. metaphorical \"savoring\" of knowledge\n- Root: سلك (s-l-k)\n  * Lisan / Ayn: Entering into a path; threading through\n  * Al-Raghib (Mufradat): The spiritual wayfaring (sulūk) toward God\n  * Al-Zamakhshari (Asas): Literal road-taking vs. metaphorical spiritual journeying\n- Root: كشف (k-sh-f) — AVOIDED per constraints; substituted with Root: غور (gh-w-r)\n  * Lisan / Ayn: Depth, profundity; the deep bed of a sea\n  * Al-Raghib (Mufradat): The unfathomable depth of divine knowledge\n  * Al-Zamakhshari (Asas): Literal deep water vs. metaphorical inaccessibility of ultimate truth\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Governing the periodic suspension of meaning across clauses for rhetorical emphasis", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "169": [{"arabic": "إليه لا ينافي ذكر الله عز وجل وقال تعالى ولا تحسبن الذين قتلوا في سبيل الله أمواتا بل أحياء عند ربهم يرزقون فرحين بما آتاهم الله من فضله ويستبشرون بالذين لم يلحقوا بهم من خلفهم الآية ولأجل شرف ذكر الله عز وجل عظمت رتبة الشهادة لأن المطلوب الخاتمة ونعني بالخاتمة وداع الدنيا والقدوم على الله والقلب مستغرق بالله عز وجل منقطع العلائق عن غيره فإن قدر عبد على أن يجعل همه مستغرقا بالله عز وجل فلا يقدر على أن يموت على تلك الحالة إلا في صف القتال فإنه قطع الطمع عن مهجته وأهله وماله وولده بل من الدنيا كلها فإنه يريدها لحياته وقد هون على قلبه حياته في حب الله عز وجل وطلب مرضاته فلا تجرد لله أعظم من ذلك ولذلك عظم أمر الشه", "english": "If, therefore, he had grown intimate with it, he delights in it and takes pleasure in the cessation of the impediments that had diverted him from it. For the pressing necessities of needs in this worldly life divert one from the remembrance of God, may He be mighty and majestic, and after death no impediment remains. It is as if he has been left alone with his Beloved, and so his joy is immense, and he is delivered from the prison in which he had been prevented from that which was his source of intimacy. For this reason, he, peace and blessings be upon him, said: \"The Holy Spirit (Rūḥ al-Qudus) breathed into my heart: Love whom you will, for you shall surely part from him.\" {«أحبب من أحببت فإنك مفارقه»} By this he intended everything connected to this world, for that perishes with respect to him at death. For {«كل من عليها فان * ويبقى وجه ربك ذو الجلال والإكرام»} [Everything upon it is perishing, and there remains the Face of your Lord, Possessor of Majesty and Honor]. And this world only perishes with respect to him at death, until it perishes in itself when the Book reaches its appointed term.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 240", "section_title_en": "Section 240 — The Station of Remembrance (Dhikr): On the Transformation of Habit into Nature, the Intimacy of Remembrance After Death, and the Excellence of Martyrdom as the Seal of One's State", "section_index": 240, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of reconciliation, familiarity, and the formation of habit through repeated engagement.\n  * Al-Raghib (Mufradat): The theological nuance of 'uns' (intimacy) as the soul's acquired disposition of comfort in the presence of its Beloved, contrasting with 'wahsha' (estrangement).\n  * Al-Zamakhshari (Asas): Distinguishes the literal sense of social familiarity from the metaphorical (majaz) sense of the heart's deep-seated repose in the remembrance of God, which becomes a 'second nature' (ṭabʿan ākhara).\n- Root: ختم (Khatama)\n  * Lisan / Ayn: To seal, stamp, or conclude; the final impression left upon a thing.\n  * Al-Raghib (Mufradat): The theological sense of the 'seal' (khātima) of one's life—the terminal state upon which one departs from the world and which determines the nature of the afterlife.\n  * Al-Zamakhshari (Asas): The literal act of sealing a document versus the metaphorical designation of one's final spiritual condition as the determining factor of one's eternal outcome.\n- Root: شهد (Shahida)\n  * Lisan / Ayn: To witness, to be present, to testify.\n  * Al-Raghib (Mufradat): The specific theological elevation of 'shahāda' (martyrdom) as the ultimate act of witnessing the truth of God through the sacrifice of one's own life, rendering the martyr a living witness (shahīd).\n  * Al-Zamakhshari (Asas): The literal sense of legal testimony versus the metaphorical reality of the martyr whose very being testifies to the sincerity of his devotion, being 'alive' with his Lord.\n- Root: قطع (Qata'a)\n  * Lisan / Ayn: To sever, cut off, or detach.\n  * Al-Raghib (Mufradat): The essential spiritual operation of severing worldly attachments ('alā'iq) to achieve the unadulterated focus of the heart upon God.\n  * Al-Zamakhshari (Asas): The literal cutting of a physical tie versus the metaphorical severance of all internal and external impediments that distract the soul from its sole Beloved.\n- Sibawayh Rule: Rule of Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing how the exclusive focus of the martyr's intention is syntactically and logically restricted to God alone, as exemplified in the phrase \"no god but God\" (lā ilāha illā Allāh), which requires the complete negation of all other objects of intention before affirming the sole Divine Object.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "الله أمواتا بل أحياء عند ربهم يرزقون فرحين بما آتاهم الله من فضله ويستبشرون بالذين لم يلحقوا بهم من خلفهم الآية ولأجل شرف ذكر الله عز وجل عظمت رتبة الشهادة لأن المطلوب الخاتمة ونعني بالخاتمة وداع الدنيا والقدوم على الله والقلب مستغرق بالله عز وجل منقطع العلائق عن غيره فإن قدر عبد على أن يجعل همه مستغرقا بالله عز وجل فلا يقدر على أن يموت على تلك الحالة إلا في صف القتال فإنه قطع الطمع عن مهجته وأهله وماله وولده بل من الدنيا كلها فإنه يريدها لحياته وقد هون على قلبه حياته", "english": "If, therefore, he had grown intimate with it, he delights in it and takes pleasure in the cessation of the impediments that had diverted him from it. For the pressing necessities of needs in this worldly life divert one from the remembrance of God, may He be mighty and majestic, and after death no impediment remains. It is as if he has been left alone with his Beloved, and so his joy is immense, and he is delivered from the prison in which he had been prevented from that which was his source of intimacy. For this reason, he, peace and blessings be upon him, said: \"The Holy Spirit (Rūḥ al-Qudus) breathed into my heart: Love whom you will, for you shall surely part from him.\" {«أحبب من أحببت فإنك مفارقه»} By this he intended everything connected to this world, for that perishes with respect to him at death. For {«كل من عليها فان * ويبقى وجه ربك ذو الجلال والإكرام»} [Everything upon it is perishing, and there remains the Face of your Lord, Possessor of Majesty and Honor]. And this world only perishes with respect to him at death, until it perishes in itself when the Book reaches its appointed term.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 240", "section_title_en": "Section 240 — The Station of Remembrance (Dhikr): On the Transformation of Habit into Nature, the Intimacy of Remembrance After Death, and the Excellence of Martyrdom as the Seal of One's State", "section_index": 240, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of reconciliation, familiarity, and the formation of habit through repeated engagement.\n  * Al-Raghib (Mufradat): The theological nuance of 'uns' (intimacy) as the soul's acquired disposition of comfort in the presence of its Beloved, contrasting with 'wahsha' (estrangement).\n  * Al-Zamakhshari (Asas): Distinguishes the literal sense of social familiarity from the metaphorical (majaz) sense of the heart's deep-seated repose in the remembrance of God, which becomes a 'second nature' (ṭabʿan ākhara).\n- Root: ختم (Khatama)\n  * Lisan / Ayn: To seal, stamp, or conclude; the final impression left upon a thing.\n  * Al-Raghib (Mufradat): The theological sense of the 'seal' (khātima) of one's life—the terminal state upon which one departs from the world and which determines the nature of the afterlife.\n  * Al-Zamakhshari (Asas): The literal act of sealing a document versus the metaphorical designation of one's final spiritual condition as the determining factor of one's eternal outcome.\n- Root: شهد (Shahida)\n  * Lisan / Ayn: To witness, to be present, to testify.\n  * Al-Raghib (Mufradat): The specific theological elevation of 'shahāda' (martyrdom) as the ultimate act of witnessing the truth of God through the sacrifice of one's own life, rendering the martyr a living witness (shahīd).\n  * Al-Zamakhshari (Asas): The literal sense of legal testimony versus the metaphorical reality of the martyr whose very being testifies to the sincerity of his devotion, being 'alive' with his Lord.\n- Root: قطع (Qata'a)\n  * Lisan / Ayn: To sever, cut off, or detach.\n  * Al-Raghib (Mufradat): The essential spiritual operation of severing worldly attachments ('alā'iq) to achieve the unadulterated focus of the heart upon God.\n  * Al-Zamakhshari (Asas): The literal cutting of a physical tie versus the metaphorical severance of all internal and external impediments that distract the soul from its sole Beloved.\n- Sibawayh Rule: Rule of Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing how the exclusive focus of the martyr's intention is syntactically and logically restricted to God alone, as exemplified in the phrase \"no god but God\" (lā ilāha illā Allāh), which requires the complete negation of all other objects of intention before affirming the sole Divine Object.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "فوالذي نفسي بيده ليودن رجال قتلوا في سبيل الله شهداء أن يبعثهم الله علماء لما يرون من كرامتهم فإن أحدا لم يولد عالما وإنما العلم بالتعلم وقال ابن عباس رضي الله عنهما تذاكر العلم بعض ليلة أحب إلي من إحيائها وكذلك عن أبي هريرة رضي الله عنه وأحمد بن حنبل رحمة الله وقال الحسن في قوله تعالى {ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة} إن الحسنة في الدنيا هي العلم والعبادة وفي الآخرة هي الجنة وقيل لبعض الحكماء أي الأشياء تقتنى قال الأشياء التي إذا غرقت سفينتك سبحت معك يعني العلم وقيل أراد بغرق السف", "english": "And al-Ḥasan, may God have mercy on him, said: \"The ink of the scholars will be weighed against the blood of the martyrs, and the ink of the scholars will outweigh the blood of the martyrs.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 6", "section_title_en": "The Book of Knowledge — Section 6: On the Virtue of Teaching and Learning (Continued)", "section_index": 6, "anchors": "- Root: شغل (sh-gh-l)\n  * Lisan / Ayn: Occupation, preoccupation, that which engages one entirely\n  * Al-Raghib (Mufradat): Preoccupation that veils one from perception of other things\n  * Al-Zamakhshari (Asas): Literal — physical occupation; Metaphorical — absorption of the heart that blinds the senses\n- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: Beauty, goodness, excellence\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which is pleasing and desirable, of three kinds: rational, appetitive, sensory\n  * Al-Zamakhshari (Asas): Literal — beauty of form; Metaphorical — the ḥasanah in the Qur'anic supplication denotes knowledge and worship\n- Root: علم (ʿ-l-m) — [Note: recently used, but required by text; applied per governing rule]\n  * Lisan / Ayn: Knowledge, perception, cognition\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing in its true reality\n  * Al-Zamakhshari (Asas): Literal — direct perception; Metaphorical — knowledge as a garment of honor from God\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death, cessation of life\n  * Al-Raghib (Mufradat): Death as the lifting of the burdens of this world; awakening from the sleep of heedlessness\n  * Al-Zamakhshari (Asas): Literal — physical death; Metaphorical — \"الناس نيام فإذا ماتوا انتبهوا\" (people are asleep; when they die, they awaken)\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — applied in the ḥadīth \"إنما العلم بالتعلم\" (knowledge is only attained through learning), restricting the means of acquiring knowledge to learning alone.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Book of Knowledge'", "badge": "Afterlife"}], "173": [{"arabic": "وسلم تسليما كثيرا دائما إلى يوم الدين والحمد لله وحده وحسبنا الله ونعم الوكيل", "english": "Ibrāhīm al-Khawwāṣ, al-Junayd, and a group [of the pious] held the view that taking from voluntary charity (ṣadaqah) is superior. For in taking the obligatory alms (zakāh), there is a jostling with the poor and a constriction upon them. And also because perhaps one's attribute of eligibility (ṣifat al-istihqāq) is not fully complete in his taking it, as it was described in the Mighty Book {«إِنَّمَا الصَّدَقَاتُ لِلْفُقَرَاءِ وَالْمَسَاكِينِ»} (Verily the alms are for the poor and the needy). As for voluntary charity (ṣadaqah), the matter therein is more expansive.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 184", "section_title_en": "Section 184 — The Book of the Secrets of Almsgiving (Zakat): On the Concealment and Open Display of Charity, and the Superiority of Taking from Voluntary Charity (Sadaqah) versus Obligatory Alms (Zakat)", "section_index": 184, "anchors": "- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Core root denotes truthfulness and veracity in speech and action; the voluntary charity (ṣadaqah) is so named because it is a truthful manifestation of one's faith and sincerity.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول\" — Truth and falsehood are originally in speech; ṣadaqah (charity) is that which verifies and proves the truthfulness of one's claim to faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"صدقته الحديث\" — truthful in speech. Metaphorical (Majaz): \"رجل صادق الحملة\" — one who is true/steadfast in battle-charge; thus ṣadaqah is that which truthfully manifests inner conviction through outward action.\n- Root: زكا (z-k-w)\n  * Lisan / Ayn: \"زكا الزرع يزكو: ازداد ونماء\" — growth and increase; purification.\n  * Al-Raghib (Mufradat): \"أصل الزكاة: النمو الحاصل عن بركة الله تعالى... أو لتزكية النفس، أي: تنميتها\" — The root of zakāh is growth from divine blessing, or the purification/growth of the soul.\n  * Al-Zamakhshari (Asas): Zakāh is the obligatory alms that purifies wealth and the soul; its taking is a legal right (ḥaqq wājib), not a favor.\n- Root: وجب (w-j-b)\n  * Al-Raghib (Mufradat): \"الوجوب: الثبوت\" — Obligation is fixedness/establishment. \"واجب من جهة الشرع كوجوب العب\" — Obligatory by divine law (Sharʿ).\n  * Al-Zamakhshari (Asas): Literal: \"وجب البيع، وأوجبته\" — the sale became binding. \"استوجب العقاب\" — he merited punishment.\n  * Lisan al-Arab: \"ومُوجِبٌ: من أَسماءِ الـمُحَرَّم\" — from the names of the sacred/preclusive.\n- Root: حمد (ḥ-m-d)\n  * Al-Raghib (Al-Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with veneration; the Book of Secrets of Fasting opens with praise to God.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praises. Metaphorical: \"أحمدت الأرض: رضيت سكناها\" — I found the land praiseworthy (approved its dwelling).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"إِنَّمَا\" restricts predication, as in the legal maxim that zakāh is exclusively a right of God (ḥaqq wājib lillāh), not a discretionary favor of the giver.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "175": [{"arabic": "إلا من ضعف اليقين والإصغاء إلى تخويف الشيطان وقد قال تعالى فلا تخافوهم وخافون إن كنتم مؤمنين وقال عز وجل الشيطان يعدكم الفقر ويأمركم بالفحشاء والله يعدكم مغفرة منه وفضلا والسؤال من الفحشاء التي أبيحت بالضرورة وحال من يسأل لحاجة متراخية عن يومه وإن كان مما يحتاج إليه في السنة أشد من حال من ملك مالا موروثا وادخره لحاجة وراء السنة وكلاهما مباحان في الفتوى الظاهرة ولكنهما صادران عن حب الدنيا وطول الأمل وعدم الثقة بفضل الله وهذه الخصلة من أمهات المهلكات نسأل الله حسن التوفيق بلطفه وكرمه بيان أحوال السائلين كان بشر رحمه الله يقول الفقر", "english": "But if his opportunity to ask would be lost, and he would find no one to give him if he delayed, then asking is permitted for him, because the hope of living a year is not far-fetched. By delaying his asking, he fears that he will remain in dire need, unable to obtain what would aid him. If his fear of being unable to ask in the future is weak, and that for which he asks falls outside the domain of necessity, then his asking is not free from disapproval (karāhah). And the degree of that disapproval corresponds to the degrees of the weakness of his dire need, his fear of missing the opportunity, and the remoteness of the period in which he would need to ask. All of this admits no precise delimitation (ḍabṭ); it is entrusted to the servant's personal striving (ijtihād) and his own discernment for himself, between him and Allah the Exalted. So let him consult his heart concerning it and act upon it, if he is a traveler of the path of the Hereafter. And whoever's certainty (yaqīn) is stronger, whose trust in the coming of provision in the future is more complete, and whose contentment (qanāʿah) with the provision of the moment is more manifest — his rank with Allah the Exalted is higher. Thus, fear of the future — when Allah has given you the provision of your day for yourself and your dependents — arises only from weakness of certainty and hearkening to the intimidation of Satan. Allah the Exalted has said: {«فَلَا تَخَافُوهُمْ وَخَافُونِ إِن كُنتُم مُّؤْمِنِينَ»} \"So fear them not, but fear Me, if you are believers\" (Q. 3:175). And He, Glorified and Exalted, said: {«الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ وَيَأْمُرُكُم بِالْفَحْشَاءِ وَاللَّهُ يَعِدُكُم مَّغْفِرَةً مِّنْهُ وَفَضْلًا»} \"Satan promises you poverty and commands you to indecency, and Allah promises you forgiveness from Him and bounty\" (Q. 2:268). And asking is among the indecencies (fawāḥish) that have been permitted by necessity. The state of one who asks for a need remote from his day — even if it is something he needs within the year — is worse than the state of one who possesses inherited wealth and has stored it for a need beyond the year. Both are permissible in the apparent legal ruling (fatwā), but both originate from love of this world, length of hope (ṭūl al-amal), and lack of trust in Allah's bounty. And this trait is among the mother of all destroyers (ummahāt al-muhlikāt). We ask Allah for beautiful success through His gentleness and generosity.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1085", "section_title_en": "The Revival of the Religious Sciences — Book on the Etiquettes of Poverty and Asceticism: Section on the Degrees of the Askers and the States of the Poor", "section_index": 1085, "anchors": "- Root: س-أ-ل (sa-ʾa-la)\n  * Lisan / Ayn: Core root denotes asking, requesting, or petitioning; the act of seeking something from another.\n  * Al-Raghib (Mufradat): In theological usage, 'suʾāl' (asking) is tied to need (ḥājah) and is morally neutral in itself, becoming blameworthy when it exceeds necessity or arises from weak trust in Allah's provision.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is the verbal request for an object; metaphorical (majāz) extension applies to asking of Allah in supplication (duʿāʾ), which is always praiseworthy.\n- Root: ف-ق-ر (fa-qā-ra)\n  * Lisan / Ayn: Core root denotes poverty, neediness, or lack of means; also spinal vulnerability (faqār), implying one broken by need.\n  * Al-Raghib (Mufradat): 'Faqr' is the existential state of being in want; in the Kalam framework, it contrasts with divine self-sufficiency (ghinā), and the poor (fuqarāʾ) are ranked by their inner state, not mere outward lack.\n  * Al-Zamakhshari (Asas): Literal sense is material destitution; metaphorical sense is spiritual poverty before Allah, the highest station of the knowers (ʿārifūn).\n- Root: ي-ق-ن (ya-qī-na)\n  * Lisan / Ayn: Core root denotes certainty, firm conviction, and the absence of doubt.\n  * Al-Raghib (Mufradat): 'Yaqīn' is the apex of faith (īmān), comprising knowledge (ʿilm), state (ḥāl), and action (ʿamal); it is the antidote to fear of future provision.\n  * Al-Zamakhshari (Asas): Literal sense is settled knowledge; metaphorical sense is the heart's repose in Allah's guarantee of sustenance, rendering anxiety a form of disbelief in that promise.\n- Sibawayh Rule: Rule of Conditional Restriction (al-sharṭ wa-l-jazāʾ) — The protasis (condition) and apodosis (result) structure in \"If he is able to ask and does not miss his opportunity, then it is not lawful for him to ask\" governs the legal determination, where the condition specifies the scope of the ruling.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "أوتوا الكتاب من قبلكم وإياكم أن اتقوا الله} وقال عز وجل {وخافون إن كنتم مؤمنين} فأمر بالخوف وأوجبه وشرطه في الإيمان فلذلك لا يتصور أن ينفك مؤمن عن خوف وإن ضعف ويكون ضعف خوفه بحسب ضعف معرفته وإيمانه وقال رسول الله صلى الله عليه وسلم في فضيلة التقوى وإذا جمع الله الأولين والآخرين لميقات يوم معلوم فإذا هم بصوت يسمع أقصاهم كما يسمع أدناهم فيقول يا أيها الناس إني قد أنصت لكم مند خلقتكم إلى يومكم هذا فانصتوا إلي اليوم إنما هي أعمالكم ترد عليكم أيها الناس إني قد جعلت نسبا وجعلتم نسبا فوضعتم نسبي ورفعتم نسبكم قلت إن أكرمكم عند", "english": "For they possess the Highest Companion (al-Rafīq al-Aʿlā) in which none share with them. Consider how He singled them out for the companionship of the Highest Companion — and that is because they are the scholars (ʿulamāʾ), and the scholars hold the rank of companionship with the prophets, for they are the heirs of the prophets. And the companionship of the Highest Companion belongs to the prophets and to those who attach themselves to them. For this reason, when the Messenger of God — may God's blessings and peace be upon him — was given the choice during his death-illness between remaining in this world and proceeding to God — may He be exalted — he would say: \"I ask of Thee the Highest Companion\" {«الرفيق الأعلى»}.", "book_title": "Fear and Hope", "section_title_ar": "Section 1042", "section_title_en": "On the Excellence of Fear (Khawf) and Its Inseparability from Faith — Section 1042", "section_index": 1042, "anchors": "- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being afraid; its opposite is amn (security).\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — anticipation of something disliked based on an indication, whether conjectural or certain; it is the direct opposite of amn (security), and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — to fear for something. Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as fear erodes the soul's complacency.\n- Root: حدث (Hadath)\n  * Lisan / Ayn: Newness, origination after non-existence; also that which is recent in time.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — the coming-to-be of a thing after it was not; true origination belongs to God alone.\n  * Al-Zamakhshari (Asas): Literal: \"هو حدث من الأحداث\" — one who is recent/young. Metaphorical: \"كان عمر محدثا أي صادق الحدس\" — one whose intuition is true, as if divinely inspired.\n- Root: يوم (Yawm)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — used for the day proper or any extended period; \"أيام الله\" refers to His mighty deeds and visitations upon the wicked.\n  * Al-Zamakhshari (Asas): Literal: \"ما رأيته اليوم\" — temporal designation. Metaphorical: \"ذكر في أيام العرب كذا أي في وقائعها\" — \"days\" as battles and momentous events.\n- Root: قوي (Quwwa)\n  * Lisan / Ayn: Strength, power, capability; the opposite of weakness.\n  * Al-Raghib (Mufradat): \"القوة تستعمل تارة في معنى القدرة\" — power as capability; also potentiality, as when a date-stone is said to be \"potentially\" a palm-tree.\n  * Al-Zamakhshari (Asas): Literal: \"هو قوي مقو\" — physically strong. Metaphorical: strength of heart, of conviction, and of allies.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the particle innamā is employed, it restricts the predicate exclusively to the subject mentioned, negating it for all others. This governs the author's argument that taqwā is exclusively attributed to God's nearness and that the \"Highest Companion\" (al-Rafīq al-Aʿlā) is uniquely reserved for the prophets and their heirs.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "178": [{"arabic": "ذنبا أحدثنا لهم نعمة ليزيد غرورهم وقال تعالى إنما نملي لهم ليزدادوا إثما وقال تعالى ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار إلى غير ذلك مما ورد في كتاب الله تعالى وسنة رسوله فمن آمن به تخلص من هذا الغرور فإن منشأ هذا الغرور الجهل بالله وبصفاته فإن من عرفه لا يأمن مكره ولا يغتر بأمثال هذه الخيالات الفاسدة وينظر إلى فرعون وهامان وقارون وإلى ملوك الأرض وما جرى لهم كيف أحسن الله إليهم ابتداء ثم دمرهم تدميرا فقال تعالى هل تحس منهم من أحد الآية وقد حذر الله تعالى من مكره واستدراجه فقال فلا يأ", "english": "As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 888", "section_title_en": "Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)", "section_index": 888, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Patience and Gratitude'", "badge": "Dhikr"}], "179": [{"arabic": "النهار ولأن تصبروا على ما أنتم عليه أحب إلي من أن يوافيني كل امرىء منكم بمثل عمل جميعكم ولكني أخاف أن تفتح عليكم الدنيا بعدي فينكر بعضكم بعضا وينكركم أهل السماء عند ذلك فمن صبر واحتسب ظفر بكمال ثوابه ثم قرأ قوله تعالى ما عندكم ينفد وما عنده الله باق ولنجزين الذين صبروا أجرهم الآية (2) الآية وروى جابر أنه سئل صلى الله عليه وسلم عن الإيمان فقال الصبر والسماحة (3) حديث الصبر كنز من كنوز الجنة غريب لم أجده وسئل مرة ما الإيمان فقال الصبر (4) حديث الحج عرفه تقدم في الحج معناه معظم الحج عرف", "english": "Allah — exalted be He — has described the patient (al-ṣābirīn) with attributes, and He mentioned patience (al-ṣabr) in the Qur’an in upwards of seventy places. He attached most of the degrees and goods to patience, making them its fruit. For He said — majestic is His utterance: {«وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا»} — “And We made from among them imams guiding by Our command, when they were patient” (Q 32:24). And He said — exalted be He: {«وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا»} — “And the good word of your Lord was fulfilled upon the Children of Israel, because they were patient” (Q 7:137). And He said — exalted be He: {«وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُم بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ»} — “And We shall surely recompense those who were patient their wage according to the best of what they used to do” (Q 16:96). And He said — exalted be He: {«أُولَٰئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا»} — “Those shall be given their wage twice, because they were patient” (Q 28:54). And He said — exalted be He: {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»} — “Only the patient shall be paid their wage without reckoning” (Q 39:10). Thus there is no act of nearness (qurbah) whose wage is not meted out by measure and account — except patience. And because fasting (al-ṣawm) is of patience, and it is half of patience, Allah — exalted be He — said: “Fasting is Mine, and I recompense it” — so He attributed it to Himself, to the exclusion of all other acts of worship. And He promised the patient that He is with them, saying — exalted be He: {«وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ»} — “And be patient; indeed Allah is with the patient” (Q 8:46). And He made victory contingent upon patience, saying — exalted be He: {«بَلَىٰ إِن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُسَوِّمِينَ»} — “Yes, if you are patient and God-fearing, and they come upon you in their rush, your Lord will reinforce you with five thousand marked angels” (Q 3:125). And He gathered for the patient things He gathered for no others, saying — exalted be He: {«أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ»} — “Those — upon them are blessings from their Lord, and mercy; and those — they are the rightly guided” (Q 2:157). So guidance, mercy, and blessings are all gathered for the patient. And to exhaust all the verses concerning the station of patience would be lengthy.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 954", "section_title_en": "The Virtue of Patience (Ṣabr) — Its Excellence in the Qur’an, Sunnah, and Reports of the Salaf", "section_index": 954, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning is “to restrain, to hold back, to bind firmly” — as in holding an animal by its halter or confining someone against departure.\n  * Al-Raghib (Mufradat): Patience is “the self’s restraint upon what reason and Sacred Law require, or from what they require it to abstain from.” It is a generic term whose specific names vary by context: in calamity it is ṣabr (opposed to jazaʿ); in battle it is courage (shajāʿah); in vexation it is forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): “I bore patiently what I disliked, and I refrained patiently from what I loved.” Metaphorical (majāz): “His right hand was made to swear patiently” (i.e., bound by an emphatic oath), and “this tree is patient against cold” (i.e., unaffected by it).\n- Root: عله (ʿ-L-H) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: ايم (A-Y-M) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: نفس (N-F-S)\n  * Al-Raghib (Mufradat): The self (nafs) as the locus of volitional restraint — patience is an act of the nafs holding itself back, distinguishing it from mere physical endurance.\n  * Al-Zamakhshari (Asas): Literal: “a precious thing” (nafīs). Metaphorical: “he poured out his soul” (i.e., his blood), and “everything that has no flowing soul does not defile water.”\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the exclusive clause {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»}, where innamā restricts the reward-without-account solely to the patient, and {«الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ»}, where the predicate is focused to Allah alone.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}], "180": [{"arabic": "قال تعالى ولا يحسبن الذين يبخلون بما آتاهم الله من فضله هو خير لهم بل هو شر لهم سيطوقون ما بخلوا به يوم القيامة وقال تعالى الذين يبخلون ويأمرون الناس بالبخل ويكتمون ما آتاهم الله من فضله وقال صلى الله عليه وسلم إياكم والشح فإنه أهلك من كان قبلكم حملهم على أن سفكوا دماءهم واستحلوا محارمهم (1) وقال صلى الله عليه وسلم إياكم والشح فإنه دعا من كان قبلكم فسفكوا دماءهم ودعاهم فاستحلوا محارمهم ودعاهم فقطعوا أرحامهم (1) وقال صلى الله عليه وسلم لا يدخل الجنة بخيل ولا خب ولا خائن ولا سيء الملكة (2)", "english": "God the Exalted said: {«And whoever is saved from the covetousness of his own soul — those are the successful»} (al-Hashr 59:9). And He said the Exalted: {«And let not those who withhold stingily what God has given them of His bounty suppose that it is good for them. Rather, it is evil for them. They shall be collared with what they withheld on the Day of Resurrection»} (Al 'Imran 3:180). And He said the Exalted: {«Those who are stingy and command people to stinginess, and conceal what God has given them of His bounty»} (al-Nisa' 4:37).", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 773", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 773: On the Condemnation of Stinginess (Al-Bukhl) and Covetousness (Al-Shuhh)", "section_index": 773, "anchors": "- Root: بخل (B-Kh-L)\n  * Lisan / Ayn: Core meaning is withholding or restraining that which one possesses from what does not rightfully permit its detention. Al-Khalil notes: \"بَخِلَ بَخَلاً وبُخْلاً فهو بَخِيلٌ بَخَّالٌ مُبَخِّلٌ. والبَخْلَةُ: بُخْلُ مَرَّةٍ وَاحِدَةٍ.\"\n  * Al-Raghib (Mufradat): \"البخل: إمساك المقتنيات عما لا يحق حبسها عنه، ويقابله الجود... والبخل ضربان: بخل بقنيات نفسه، وبخل بقنيات غيره، وهو أكثرها ذما.\" — Stinginess is of two kinds: withholding one's own possessions, and withholding what belongs to others (i.e., covetousness, shuhh), the latter being more blameworthy.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"فلان لم يبخل ولم يبخل، وما كانت منه بخلة قط.\" Metaphorical (Majaz): \"إذا السماء بخلت بالفطر\" — the sky \"withholding\" rain is a metaphorical extension of the root.\n- Root: شح (Sh-H-H)\n  * Lisan / Ayn: The root denotes intense covetousness combined with avarice — a grasping desire for what others possess alongside a tight-fisted withholding of one's own.\n  * Al-Raghib (Mufradat): The distinction between shuhh and bukhl: shuhh is the more severe — it is the inner disposition of craving that drives one to seize what is in others' hands and to cling to what is in one's own; bukhl is its outward manifestation in withholding.\n  * Al-Zamakhshari (Asas): The rhetorical usage in the hadith \"اتقوا الشح\" employs the term in its comprehensive sense, encompassing both the inward vice and its outward acts.\n- Root: ظلم (Z-L-M)\n  * Lisan / Ayn: The root signifies placing something in other than its proper position; darkness (zulmah) is its sensory correlate.\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور... ويعبر بها عن الجهل والشرك والفسق\" — darkness is used metaphorically for ignorance, polytheism, and transgression.\n  * Al-Zamakhshari (Asas): Literal: \"الظلم ظلمات يوم القيامة\" — injustice is darknesses on the Day of Resurrection. Metaphorical: \"أرض مظلومة: حفر فيها بئر\" — a land \"wronged\" by being dug into for the first time.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase, as in the hadith \"إياكم والشح فإنه أهلك من كان قبلكم,\" where the warning construction (إياكم) governs the subsequent clause with rhetorical emphasis.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "182": [{"arabic": "يوم القيامة بإخراج رجلين من النار فيقول الله تبارك وتعالى ذلك بما قدمت أيديكما وما أنا بظلام للعبيد ويأمر بردهما إلى النار فيعدو أحدهما في سلاسله حتى يقتحمها ويتلكأ الآخر ويأمر بردهما ويسألهما عن فعلهما فيقول الذي عدا إلى النار قد حذرت من وبال المعصية فلم أكن لأتعرض لسخطك ثانية ويقول الذي تلكأ حسن ظني بك كان يشعرني أن لا تردني إليها بعد ما أخرجتني منها فيأمر بهما إلى الجنة وقال رسول الله صلى الله عليه وسلم ينادي مناد من تحت العرش يوم القيامة يا أمة محمد أما ما كان لي قبلكم فقد وهبته لكم وبقيت التبعات فتواهبوها وادخلوا ال", "english": "He mentioned me one day, or feared me in a station (1). And the Messenger of God, may God bless him and grant him peace, said: \"When the people of the Fire are gathered in the Fire — and with them, whomsoever God wills of the people of the Qiblah — the disbelievers will say to the Muslims: 'Were you not Muslims?' They will reply: 'Yes.' Then they will say: 'What did your Islam avail you, seeing that you are with us in the Fire?' They will answer: 'We had sins, and we were seized for them.' Then God, Mighty and Glorious, will hear what they have said, and He will command that whoever was in the Fire of the people of the Qiblah be brought out, and they will be brought out. When the disbelievers see that, they will say: 'Would that we had been Muslims, so that we might be brought out as they were brought out.' Then the Messenger of God, may God bless him and grant him peace, recited: {ربما يود الذين كفروا لو كانوا مسلمين} — \"Perhaps those who disbelieve will wish that they had been Muslims\" (Q. 15:2). (2)", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1360", "section_title_en": "On the Vastness of Divine Mercy and the Intercession for the Sinful — Section 1360", "section_index": 1360, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, recollection; also mention, invocation.\n  * Al-Raghib (Mufradat): Al-dhikr is the opposite of forgetfulness (nisyān); it denotes the heart's presence with what is recalled, and the tongue's utterance thereof.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): to recall in the heart or utter on the tongue. Metaphorical (majāz): \"dhakartuhu bi-khayr\" — to speak well of someone, i.e., to raise their mention in honor.\n- Root: خرج (kharaja)\n  * Lisan / Ayn: To exit, depart, emerge from an interior to an exterior.\n  * Al-Raghib (Mufradat): Al-khurūj is the departure of a thing from its place or state; used of the soul leaving the body, and of the damned leaving the Fire.\n  * Al-Zamakhshari (Asas): Literal: spatial egress. Metaphorical: \"kharaja min al-amr\" — to emerge from an affair, i.e., to be free of its obligation; and \"akhrajahu Allāh min al-nār\" — divine extraction by mercy, not by merit.\n- Root: شفع (shafa'a)\n  * Lisan / Ayn: To make even, pair; intercession is making one's supplication a pair with another's need.\n  * Al-Raghib (Mufradat): Al-shafā'ah is the joining of one's intercession to another's request for aid; its reality is the elevation of the intercessor's rank and the remission of the offender's burden.\n  * Al-Zamakhshari (Asas): Literal: pairing. Metaphorical: intercession before a king — the intercessor \"pairs\" his own honor with the petitioner's deficiency.\n- Root: رحم (raḥima)\n  * Lisan / Ayn: Tenderness of heart, compassion; al-Raḥmān is intensive — mercy as an essential attribute.\n  * Al-Raghib (Mufradat): Al-raḥmah is tenderness that necessitates beneficence; when attributed to God, it is pure beneficence (tafaddul) without emotional change.\n  * Al-Zamakhshari (Asas): Literal: the mother's womb (raḥim) as the seat of compassion. Metaphorical: \"arḥam al-rāḥimīn\" — God's mercy as sheer gratuitous giving, exceeding any creaturely pity.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"Innamā shafā'atu Rasūlillāh…\" restricts intercession to a specific class, namely those who have burdened themselves with sins, not the innocent.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "185": [{"arabic": "الله خير} وقوله {والآخرة خير وأبقى} وقوله {وما الحياة الدنيا إلا متاع الغرور} وقوله {فلا تغرنكم الحياة الدنيا} وقد أخبر رسول الله صلى الله عليه وسلم بذلك طوائف من الكفار فقلدوه وصدقوه وآمنوا به ولم يطالبوه بالبرهان (1) حديث قول من قال له نشدتك الله أبعثك رسولا فيقول {نعم} فيصدق متفق عليه من حديث أنس في قصة ضمام ابن ثعلبة وقوله للنبي صلى الله عليه وسلم أرسلك للناس كلهم فقال اللهم نعم وفي آخره فقال الرجل آمنت بما جئت به وللطبراني من حديث ابن عباس في ضمام قال نشدتك به أهو أرسلك بما أتتنا كتبك وأتتنا رسلك أن نشهد أن لا إله إلا ا", "english": "Know that the saying of God Most High — {«fa-lā taghurrannakum al-ḥayātu al-dunyā wa-lā yaghurrannakum billāhi al-gharūr»} (So let not the life of this world deceive you, nor let the Deceiver deceive you concerning God) — and His saying — {«wa-lākinnakum fatantum anfusakum wa-tarabbastum wa-irtabtum wa-gharratkum al-amānī»} (But ye tempted your own souls, and ye waited, and ye doubted, and vain desires deceived you) — is sufficient for the blameworthiness of self-deception (al-ghurūr). And the Messenger of God, may God's peace and blessing be upon him, has said: \"How excellent is the sleep of the intelligent and their breaking of the fast! How they outwit the wakefulness of the foolish and their striving! And verily a mustard-seed's weight [of faith] from a possessor of piety and certainty is better than the earth filled with the self-deceived.\" And the ḥadīth: \"The intelligent man (al-kayyis) is he who takes account of his own soul and works for what is after death\" — this ḥadīth was transmitted by al-Tirmidhī and Ibn Mājah from the ḥadīth of Shaddād ibn Aws.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 884", "section_title_en": "Exposition of the Blameworthiness of Self-Deception (Al-Ghurūr), Its Reality, and Its Examples", "section_index": 884, "anchors": "- Root: غرر (Gh-R-R)\n  * Lisan / Ayn: The core meaning is \"an apparent trace or mark of a thing\" (al-athar al-ẓāhir), from which derives \"the blaze of a horse\" (ghurrat al-faras). To deceive (gharra) is to strike one's heedlessness (ghirrah) and attain one's sought desire from him, as if folding a garment upon its original crease (ṭawāhu ʿalā gharrihi).\n  * Al-Raghib (Mufradat): \"Ghurrah is heedlessness in wakefulness, and ghirār is heedlessness with drowsiness.\" Theologically, it is the soul's repose upon a false semblance (shubhah) that pleases the caprice (hawā), rendering one oblivious to the true state of affairs—as in {«mā gharraka bi-rabbika al-karīm»} (What deceived thee concerning thy Generous Lord?).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"A gazelle in a moonlit night is called agharr\" because it ventures out thinking it is day and is devoured by beasts—heedlessness in perception. Metaphorical (majāz): \"A day agharr muḥajjal\" (a white-browed, white-legged day) for intense heat, transferring the blaze of a horse to the day's visible intensity.\n- Root: جهل (J-H-L)\n  * Lisan / Ayn: \"Jahila bihi\" — to be ignorant of it; \"jāhala ʿalā qawmihi\" — to act foolishly/insolently against one's people. The pre-Islamic era is \"al-jāhiliyyah al-jahlā'\" (the utterly ignorant age).\n  * Al-Raghib (Mufradat): Ignorance (jahl) is of three kinds: (1) the soul's emptiness of knowledge (this is the root); (2) believing a thing contrary to what it is; (3) doing a thing contrary to what it ought to be, whether one's belief is sound or corrupt. Ghurūr is a species of the second kind—a false belief arising from a corrupt semblance.\n  * Al-Zamakhshari (Asas): Literal: \"Kafā bil-shakki jahlā\" (Sufficient is doubt as ignorance). Metaphorical: \"Istajhalat al-rīḥ al-ghuṣn\" (The wind made the branch sway violently) — transferred from mental foolishness to physical agitation.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not.\" \"Al-ḥadath: the novel event.\" \"Ḥaddatha: to speak/communicate.\"\n  * Al-Raghib (Mufradat): \"Ḥudūth is the existence of a thing after non-existence, whether accident or substance. Iḥdāth is bringing it into existence. The iḥdāth of substances belongs to God alone.\" The \"ḥadīth\" (report/speech) is so-called for its temporal novelty.\n  * Al-Zamakhshari (Asas): Literal: \"Nazalat bihi ḥawādith al-dahr\" (The vicissitudes of time befell him). Metaphorical: \"Kāna ʿUmar muḥaddathan\" (Umar was one inspired with true discernment) — as if he were spoken to (ḥudditha) by what he conjectured.\n- Root: دنا (D-N-W)\n  * Lisan / Ayn: \"Danā fa-huwa dānin\" — he drew near. \"Al-dunyā\" (the lower world) is so named because it is nearer (danat) and precedes the Hereafter.\n  * Al-Raghib (Mufradat): \"Al-dunūw: proximity by essence or by judgment, used of place, time, and station.\" The \"adnā\" (lower/nearer) is contrasted with the greater and with the better: {«a-tastabdilūna alladhī huwa adnā billadhī huwa khayr»} (Will ye take the lower in exchange for what is better?).\n  * Al-Zamakhshari (Asas): Literal: \"Huwa danī' min al-adniyā'\" (He is base, of the base ones) — but this is the homonym danu'a (baseness), distinct from danā (nearness). The dunyā's \"nearness\" is its temporal immediacy versus the Hereafter's deferral.\n- Sibawayh Rule: Bab al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The particle \"bi\" in {«wa-lā yaghurrannakum billāhi al-gharūr»} governs the deceiver (al-gharūr) as the agent of deception, while \"billāh\" (concerning God) is the object of the deception. The syntactic structure permits the deceiver to be named after the prepositional phrase, indicating that the deception is *about* God's attributes (His forbearance, His respite) — a grammatical subtlety showing the ghurūr deceives *by means of* false notions of God, not that God Himself deceives.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Delusion'", "badge": "Afterlife"}, {"arabic": "تعالى وإنما توفون أجوركم يوم القيامة أفترى أن من استؤجر على إصلاح أوان وشرط له أجرة عليها وكان الشارط كريما يفي بالوعد مهما وعد ولا يخلف بل يزيد فجاء الأجير وكسر الأواني وأفسد جميعها ثم جلس ينتظر الأجر ويزعم أن المستأجر كريم أفيراه العقلاء في انتظاره متمنيا مغرورا أو راجيا وهذا للجهل بالفرق بين الرجاء والغرة قيل للحسن قوم يقولون نرجو الله ويضيعون العمل فقال هيهات هيهات تلك أمانيهم يترجحون فيها من رجا شيئا طلبه ومن خاف شيئا هرب منه وقال مسلم بن يسار لقد سجدت البارحة حتى سقطت ثنيتاي فق", "english": "I say: God—exalted is He—loves the obedient and hates the disobedient. So just as He does not hate the obedient father because of His hatred for the disobedient son, likewise He does not love the disobedient son because of His love for the obedient father. And if love were to flow from the father to the son, then hatred would likewise be bound to flow. Rather, the truth is: {«ولا تزر وازرة وزر أخرى»} — \"And no bearer of burdens will bear the burden of another\" {Quran 6:164, 17:15, 35:18, 39:7, 53:38}. And whoever supposes that he will be saved by his father's piety is like one who supposes he will be satiated by his father's eating, quenched by his father's drinking, become a scholar by his father's learning, and reach the Ka'bah and see it by his father's walking.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 889", "section_title_en": "The Reality of Hope (Al-Rajā') and the Futility of Reliance on Another's Piety", "section_index": 889, "anchors": "- Root: و ل د (walada)\n  * Lisan / Ayn: Physical begetting and offspring; the father's generative act.\n  * Al-Raghib (Mufradat): \"الولد: المولود\" — offspring as a created entity; here used metaphorically for spiritual causation.\n  * Al-Zamakhshari (Asas): Literal: physical birth. Metaphorical: \"تولدت العصبية\" — something generated or produced from another; Ghazali exploits this to refute the notion that a father's obedience \"generates\" salvation for the son.\n- Root: ر ج و (rajā)\n  * Lisan / Ayn: Expectation, hope, longing for a favorable outcome.\n  * Al-Raghib (Mufradat): Hope tied to legitimate means; not mere wishful thinking (tamannī).\n  * Al-Zamakhshari (Asas): Literal: awaiting rain. Metaphorical: \"رجوت فلانا\" — to expect from someone; Ghazali contrasts true hope (with action) vs. delusion (ghurūr).\n- Root: غ ر ر (gharara)\n  * Lisan / Ayn: Deception, heedlessness, being lured by a false appearance.\n  * Al-Raghib (Mufradat): The state of one who is duped by Satan's plausible speech.\n  * Al-Zamakhshari (Asas): Literal: a risky venture. Metaphorical: \"اغتر بفلان\" — to be deceived by outward charm while the inner reality is corrupt.\n- Root: ك ي س (kays)\n  * Lisan / Ayn: Intelligence, shrewdness, prudence.\n  * Al-Raghib (Mufradat): The wise man who disciplines his soul and acts for the afterlife.\n  * Al-Zamakhshari (Asas): Literal: alertness. Metaphorical: \"الكيس من دان نفسه\" — the prudent one who holds his soul to account; antonym of \"الأحمق\" (the fool).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يوفى الصابرون أجرهم بغير حساب\" style; Ghazali uses \"إنما\" to restrict reward to personal action, and \"ليس للإنسان إلا ما سعى\" as a restrictive negative clause (nafy + illā) to deny any transfer of merit.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Delusion'", "badge": "Hadith"}, {"arabic": "وقال عليه السلام من سره أن يزحزح عن النار ويدخل الجنة فلتأته منيته وهو يشهد أن لا إله إلا الله وأن محمدا رسول الله وليؤت إلى الناس ما يحب أن يؤتى إليه (6) وقال صلى الله عليه وسلم يا أبا الدرداء أحسن مجاورة من جاورك تكن مؤمنا وأحب للناس ما تحب لنفسك تكن مسلما (7) قال الحسن أوحى الله تعالى إلى آدم صلى الله عليه وسلم بأربع خصال وقال فيهن جماع الأمر لك ولولدك واحدة لي وواحدة لك وواحدة بيني وبينك وواحدة بينك وبين الخلق فأما التي لي تعبدني ولا تشرك بي شيئا وأما التي لك فعملك أجزيك به أفقر ما", "english": "**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 433", "section_title_en": "The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims", "section_index": 433, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}, {"arabic": "وقال بعض الصوفية كنت أقرأ ليلة هذه الآية {كل نفس ذائقة الموت} فجعلت أرددها فإذا هاتف يهتف بي كم تردد هذه الآية فقد قتلت أربعة من الجن ما رفعوا رءوسهم إلى السماء منذ خلقوا وقال أبو علي المغازلي للشبلي ربما تطرق سمعي آية من كتاب الله تعالى فتجذبني إلى الإعراض عن الدنيا ثم أرجع إلى أحوالي وإلى الناس فلا أبقى على ذلك فقال ما طرق سمعك من القرآن فاجتذبك به إليه فذلك عطف منه عليك ولطف منه بك وإذا ردك إلى نفسك فهو شفقة منه عليك فإنه لا يصلح لك إلا التبري من الحول والقوة في التوجه إليه وسمع رجل من أه", "english": "Some of the Sufis said: \"One night I was reciting this verse: {كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ} «Every soul shall taste death» [Q. 3:185]. I kept repeating it, and lo, a caller cried out to me: 'How long will you repeat this verse? You have killed four of the jinn who have not raised their heads to the sky since they were created.'\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 512", "section_title_en": "On the Ecstatic States (Wajd) Produced by Qur'anic Recitation and the Superiority of Song (Ghinā') in Stirring the Heart", "section_index": 512, "anchors": "- Root: وجد (w-j-d)\n  * Lisan / Ayn: Core meaning of finding, attaining, and also denoting the emotional state of ecstasy or rapture that \"finds\" the heart.\n  * Al-Raghib (Mufradat): In the theological context, 'wajd' is the state of spiritual finding—a direct, overwhelming apprehension of divine realities that bypasses discursive reasoning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes \"finding\" a lost object; metaphorical (Majaz) usage denotes the heart \"finding\" its spiritual state, leading to agitation and ecstasy.\n- Root: سمع (s-m-')\n  * Lisan / Ayn: The faculty of hearing; also the ear itself.\n  * Al-Raghib (Mufradat): Hearing can be literal (perception of sound) or figurative (understanding, obedience, acceptance). The heart's \"hearing\" is a deeper comprehension.\n  * Al-Zamakhshari (Asas): Literal: \"سمعته\" (I heard him). Metaphorical: \"سمع الله لمن حمده\" (God answers/he accepts the one who praises Him), indicating a responsive, transformative hearing.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death; the opposite of life.\n  * Al-Raghib (Mufradat): Death is the cessation of the soul's governance over the body, a separation. In the spiritual context, it can be a metaphorical death to worldly desires.\n  * Al-Zamakhshari (Asas): Literal: physical death. Metaphorical: \"أحيا الله البلد الميت\" (God revives the dead land), indicating spiritual revival or the death of the ego.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that the stirring of the heart is exclusively through what is appropriate to its state, as in the phrase \"إنما المحرك لما في القلب ما يناسبه\" (The only thing that moves what is in the heart is that which is suitable to it).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "186": [{"arabic": "صدرك بما يقولون فسبح بحمد ربك} الآية وقال تعالى {ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور} أي تصبروا عن المكافأة ولذلك مدح الله تعالى العافين عن حقوقهم في القصاص وغيره فقال تعالى {وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو} خير الصابرين {وقال} صلى الله عليه وسلم صل من قطعك وأعط من حرمك واعف عمن ظلمك // ورأيت في الإنجيل قال عيسى بن مريم عليه السلام لقد قيل لكم من قبل إن السن بالسن والأنف بالأنف وأنا أقول لكم لا تقاوموا بالشر بل من ضرب خدك الأيمن فحول إليه الخد الأيسر ومن أخذ رداءك فأعطه إزارك ومن سخرك لتسير معه ميلا فسر م", "english": "And acts of disobedience are the requisite of the impulse of caprice (bāʿith al-hawā). And the most severe kind of patience is patience in abstaining from those acts of disobedience that have become familiar through habit — for habit is a fifth nature. When habit is joined to lustful desire, two battalions from the battalions of Satan array themselves in concert against the battalion of God (jund Allāh) — may He be exalted — and the impulse of religion (bāʿith al-dīn) has no strength to suppress them. Then, if that act be one whose commission has been rendered easy (tayassara), patience in abstaining from it is heavier upon the soul — such as patience in abstaining from the sins of the tongue: backbiting (ghībah), falsehood, contentious disputation (mirāʾ), self-praise whether by insinuation (taʿrīḍ) or by explicit statement (taṣrīḥ), the varieties of jesting that wound hearts, the kinds of words by which one intends belittlement and contempt, and the mention of the dead with aspersion cast upon them, upon their sciences, their conduct, and their stations. For such mention is in its outward aspect (fī ẓāhirihi) backbiting, and in its inward aspect (fī bāṭinihi) self-praise. In it the soul has two lusts: one is the negation of the other [person], and the other is the affirmation of oneself. And by these two together there is completed for it that lordship (rubūbiyyah) which is innate in its disposition — and which is the very opposite of what it has been commanded regarding servanthood (ʿubūdiyyah). And because of the conjunction of the two lusts, and the ease of moving the tongue, and the fact that this becomes habitual in everyday converse, patience in abstaining from it becomes difficult. And it is among the greatest of the destructive enormities (al-mūbiqāt) — so much so that its disapproval and ugliness have been effaced from hearts by dint of its frequent repetition and the universality of familiarity with it. Thus you see a man who would, for example, wear silk and deem it utterly remote [of permissibility], yet he unleashes his tongue the whole day long against the reputations (aʿrāḍ) of people and does not deem that objectionable — notwithstanding what has come down in the report that backbiting is more severe than adultery (zinā). And God — may He be exalted — said: {«ودع أذاهم وتوكل على الله»} \"And leave aside their harm and put thy trust in God\" (Q. 33:48). And He said — may He be exalted: {«واصبر على ما يقولون واهجرهم هجرا جميلا»} \"And be patient over what they say, and depart from them with a gracious departure\" (Q. 73:10). And He said — may He be exalted: {«ولقد نعلم أنك يضيق صدرك بما يقولون فسبح بحمد ربك»} \"And indeed We know that thy breast is straitened by what they say; so glorify with the praise of thy Lord\" (Q. 15:97–98) — to the end of the verse. And He said — may He be exalted: {«ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور»} \"And you shall surely hear from those who were given the Scripture before you and from those who associate [others with God] much harm. And if you are patient and God-fearing, indeed that is of the resolute affairs\" (Q. 3:186) — that is, that you be patient in refraining from requital (mukāfaʾah). And for this reason God — may He be exalted — praised those who pardon others their due rights in retaliation (qiṣāṣ) and otherwise, saying — may He be exalted: {«وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو خير الصابرين»} \"And if you punish, then punish with the like of that wherewith you were afflicted. And if you are patient, it is surely better for the patient\" (Q. 16:126). And he — upon him be peace — said: \"Maintain the bond with him who cuts you off, and give to him who withholds from you, and pardon him who wrongs you.\" And I have seen in the Gospel that ʿĪsā ibn Maryam — upon him be peace — said: \"It was said to you of old: an eye for an eye and a nose for a nose. But I say to you: do not resist evil. Rather, whoever strikes your right cheek, turn to him PageV04P071 the left cheek; and whoever takes your cloak, give him your garment; and whoever compels you to walk with him one mile, walk with him two miles.\" And all of that is a command to be patient under harm. So patience under the harm of people is among the highest stations of patience, because in it the impulse of religion and the impulse of lustful desire and anger are all arrayed together [against the soul].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 965", "section_title_en": "The Most Severe Forms of Patience: Abstaining from Habitual Sins and Enduring Harm", "section_index": 965, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; \"ṣabara al-dābbah\" = to hold back an animal without fodder; \"ṣabartu nafsī\" = I restrained my soul.\n  * Al-Raghib (Mufradat): \"الصبر: حبس النفس على ما يقتضيه العقل والشرع، أو عما يقتضيان حبسها عنه\" — Patience is the withholding of the soul upon what reason and Law require, or from what they require it to be withheld. When exercised against calamity it is called ṣabr alone (opposed to jazaʿ); in warfare, courage (shajāʿah); in vexing misfortune, forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — I bore patiently what I dislike, and I restrained myself from what I love. Metaphorical (majāz): \"هو أصبر على الضرب من الأرض\" — he is more enduring of beating than the earth.\n- Root: عادة (ʿ-w-d)\n  * Lisan / Ayn: Recurrence and return; habitual practice that becomes second nature through repetition.\n  * Al-Raghib (Mufradat): Habit (ʿādah) as reiterated action that imprints upon the soul, rendering the act facile and its abandonment burdensome.\n  * Al-Zamakhshari (Asas): Literal: return to a state or place. Metaphorical: the ingrained disposition that governs conduct.\n- Root: غيب (gh-y-b)\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين\" — that which is concealed from the senses; applied to what is absent from human perception, though nothing is absent from God.\n  * Al-Zamakhshari (Asas): Literal: \"تكلم بذلك عن ظهر الغيب\" — he spoke of that behind the veil of the unseen. Metaphorical: \"أتونا في غابة\" — they came in a dense host (like tangled thickets).\n- Sibawayh Rule: Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the periodic construction \"فإن ذلك في ظاهره غيبة وفي باطنه ثناء على النفس\" where the circumstantial qualifiers (ẓāhir/bāṭin) are interposed to contrast outward form with inward reality.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "187": [{"arabic": "علماء الآخرة بالخشوع والزهد فقال عز وجل في علماء الدنيا وإذ أخذ الله ميثاق الذين أوتوا الكتاب لتبيننه للناس ولا تكتمونه فنبذوه وراء ظهورهم واشتروا به ثمنا قليلا وقال تعالى في علماء الآخرة وإن من أهل الكتاب لمن يؤمن بالله وما أنزل إليكم وما أنزل إليهم خاشعين لله لا يشترون بآيات الله ثمنا قليلا أولئك لهم أجرهم عند ربهم وقال بعض السلف العلماء يحشرون في زمرة الأنبياء والقضاة يحشرون في زمرة السلاطين وفي معنى القضاة كل فقيه قصده طلب الدنيا بعلمه وروى أبو الدرداء رضي الله عنه عن النبي صلى الله عليه وسلم أنه قال أوحى الله عز وجل إلى بعض الأنبياء قل للذين يتفقهون لغير الدين ويتعلمون لغير العمل ويطلبون الدنيا بع", "english": "[Root: ملح]\n  • Lisan al-Arab: \"الملح: ما يصلح الطعام، وجمعه ملوح وأملاح. والمليح: الحسن. والملاحة: الحسن. وملح الرجل يملح ملاحة: حسن. وتملح: تزين.\"\n  • Al-Raghib (Al-Mufradat): \"الملح: ما يحفظ الطعام ويمنع فساده، ويستعار لما يحفظ الإيمان والعلم من الفساد.\"\n  • Al-Zamakhshari (Asas): \"ملح الماء: إذا كان فيه ملوحة. وملح الطعام: جعل فيه الملح. وهذا على الحقيقة، ويستعار الملح لما يصلح به الأمر.\"\n  • Kitab al-Ayn: \"الملح: معروف، والمليح: الحسن من كل شيء.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 52", "section_title_en": "Section 52", "section_index": 52, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "ميثاق الذين أوتوا الكتاب لتبيننه للناس ولا تكتمونه فنبذوه وراء ظهورهم واشتروا به ثمنا قليلا وقال تعالى في علماء الآخرة وإن من أهل الكتاب لمن يؤمن بالله وما أنزل إليكم وما أنزل إليهم خاشعين لله لا يشترون بآيات الله ثمنا قليلا أولئك لهم أجرهم عند ربهم وقال بعض السلف العلماء يحشرون في زمرة الأنبياء والقضاة يحشرون في زمرة السلاطين وفي معنى القضاة كل فقيه قصده طلب الدنيا بعلمه وروى أبو الدرداء رضي الله عنه عن النبي صلى الله عليه وسلم أنه قال أوحى الله عز وجل إلى بعض الأنبياء قل للذين يتفقهو", "english": "[Root: ملح]\n  • Lisan al-Arab: \"الملح: ما يصلح الطعام، وجمعه ملوح وأملاح. والمليح: الحسن. والملاحة: الحسن. وملح الرجل يملح ملاحة: حسن. وتملح: تزين.\"\n  • Al-Raghib (Al-Mufradat): \"الملح: ما يحفظ الطعام ويمنع فساده، ويستعار لما يحفظ الإيمان والعلم من الفساد.\"\n  • Al-Zamakhshari (Asas): \"ملح الماء: إذا كان فيه ملوحة. وملح الطعام: جعل فيه الملح. وهذا على الحقيقة، ويستعار الملح لما يصلح به الأمر.\"\n  • Kitab al-Ayn: \"الملح: معروف، والمليح: الحسن من كل شيء.\"", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 52", "section_title_en": "Section 52", "section_index": 52, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'The Lawful and Prohibited'", "badge": "Afterlife"}, {"arabic": "وقوله تعالى وإذ أخذ الله ميثاق الذين أوتوا الكتاب ليبيننه للناس ولا يكتمونه وهو إيجاب للتعليم وقوله تعالى {وإن فريقا منهم ليكتمون الحق وهم يعلمون} وهو تحريم للكتمان كما قال تعالى في الشهادة {ومن يكتمها فإنه آثم قلبه} وقال صلى الله عليه وسلم ما آتى الله عالما علما إلا وأخذ عليه من الميثاق ما أخذ على النبيين أن يبينوه للناس ولا يكتموه (6) وقال تعالى {ومن أحسن قولا ممن دعا إلى الله وعمل صالحا} وقال تعالى {ادع إلى سبيل ربك بالحكمة والموعظة الحسنة} وقال تعالى {ويعلمهم الكتاب والحكمة} وأما الأخبار فقوله صلى الله عليه و", "english": "As for the Qur'anic verses: His saying, Mighty and Majestic is He: {وَلِيُنذِرُوا قَوْمَهُمْ إِذَا رَجَعُوا إِلَيْهِمْ لَعَلَّهُمْ يَحْذَرُونَ} \"That they may warn their people when they return to them, that perhaps they may be cautious\" {«ولينذروا قومهم إذا رجعوا إليهم لعلهم يحذرون»} — and the intended meaning is teaching and guidance (al-taʿlīm wa-al-irshād).", "book_title": "Book of Knowledge", "section_title_ar": "Section 8", "section_title_en": "The Excellence of Teaching (Faḍīlat al-Taʿlīm)", "section_index": 8, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning is \"to know, to perceive a thing by its reality\"; the root also carries the sense of \"marker, sign, banner\" — that by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing by its true reality, divided into apprehension of the essence of a thing and judgment upon it. This is the attribute by which the scholar (ʿālim) is distinguished and by which he becomes a \"sign\" (ʿalam) pointing to truth.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — the scholar is among the lofty banners of knowledge. The teaching act makes the scholar a living signpost; the root's literal sense of \"marking\" or \"branding\" a thing carries into the metaphorical (majāz) register of \"imprinting\" knowledge upon hearts.\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: Core meaning is \"to be new, to occur after not having been\"; al-ḥadīth is speech that is new and conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence. The prophetic traditions (aḥādīth) cited here are \"newly conveyed\" reports that carry authority.\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"صاروا أحاديث\" — they became subjects of discourse. The transmission of knowledge is an \"event\" (ḥadath) that occurs in the listener, renewing his state.\n- Root: عهد (ʿahida)\n  * Lisan / Ayn: Core meaning is \"covenant, pact, charge\"; al-ʿahd is a binding commission that one is obligated to fulfill.\n  * Al-Raghib (Mufradat): The covenant (mīthāq) taken from the People of the Book and from the scholars is a divine charge (taklīf) that makes teaching an obligation, not a supererogatory act.\n  * Al-Zamakhshari (Asas): Literal: the covenant is a \"charge entrusted\" (waṣiyyah) that binds the one who receives knowledge to its dissemination.\n- Root: كتم (katama)\n  * Lisan / Ayn: Core meaning is \"to conceal, to hide\"; al-kitmān is the deliberate suppression of what ought to be revealed.\n  * Al-Raghib (Mufradat): Concealment of knowledge is paired with concealment of testimony (shahādah) in the Qur'an — both are sins of the heart (ithm al-qalb) because they withhold what God has commanded to be made manifest.\n  * Al-Zamakhshari (Asas): Literal vs. metaphorical: the \"bridle of fire\" (lijām min nār) on the Day of Judgment is a metaphorical (majāz) embodiment of the inner restraint of truth — the concealed knowledge becomes a physical restraint in the afterlife.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The verse {وإن فريقا منهم ليكتمون الحق وهم يعلمون} employs the restrictive particle \"inna\" with the continuous verb form (yaktimūn) to specify an ongoing, willful concealment, distinguishing it from mere ignorance. The conditional structures in the ḥadīth \"man taʿallama... man ʿallama... man katama\" (whoever learns... whoever teaches... whoever conceals) follow the canonical pattern of protasis-apodosis (sharṭ/jazāʾ) that establishes a universal causal linkage between the act and its recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}, {"arabic": "والمعرض عن العمل به أريد بقوله عز وجل فنبذوه وراء ظهورهم واشتروا به ثمنا قليلا فبئس ما يشترون ولذلك قال رسول الله صلى الله عليه وسلم اقرءوا القرآن ما ائتلفت عليه قلوبكم ولانت له جلودكم فإذا اختلفتم فلستم تقرءونه وفي بعضها فإذا اختلفتم فقوموا عنه (2) قال الله تعالى الذين إذا ذكر الله وجلت قلوبهم وإذا تليت عليهم آياته زادتهم إيمانا وعلى ربهم يتوكلون وقال صلى الله عليه وسلم إن أحسن الناس صوتا بالقرآن الذي إذا سمعته يقرأ رأيت أنه يخشى الله تعالى (3) وقال صلى الله عليه وسلم لا يسمع القرآن من أحد أشهى ممن يخشى الله عز وجل (4) يراد لاستجلاب هذه ا", "english": "For this reason, Yūsuf ibn Asbāṭ said: \"I intend to recite the Qur'an, but when I recall what is in it, I fear abhorrence (al-maqt), so I turn instead to glorification (al-tasbīḥ) and seeking forgiveness (al-istighfār).\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 231", "section_title_en": "** The Revival of the Religious Sciences — Section 231: On the Inward Conditions of Qur'anic Recitation (Continued)", "section_index": 231, "anchors": "**\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"الوجل: استشعار الخوف\" — the stirring of fear/apprehension within\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف. يقال: وجل يوجل وجلا، فهو وجل. قال تعالى: {إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم}\" — the theological state of the heart's trembling upon remembrance of God\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل وجل، وقوم وجال، وقد وجل وجلا\" — the physical/emotional state of fear. Metaphorical (Majaz): The heart's trembling as the seat of spiritual perception\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — turning and transforming\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart as that which is constantly turning/transforming between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — physical turning. Metaphorical: \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" — the heart's turning toward or away from spiritual realities\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit — that which is breathed\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as the animating principle; also the self as the locus of blameworthy attributes\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — preciousness. Metaphorical: \"دفق نفسه أي دمه\" — the self as that which must be transcended in spiritual realization\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise delimitation of spiritual states (أحوال) and their hierarchical gradation (درجات)\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "190": [{"arabic": "وجنات ألفافا وقال تعالى إن في خلق السموات والأرض واختلاف الليل والنهار والفلك التي تجري في البحر بما ينفع الناس وما أنزل الله من السماء من ماء فأحيا به الأرض بعد موتها وبث فيها من كل دابة وتصريف الرياح والسحاب المسخر بين السماء والأرض لآيات لقوم يعقلون وقال تعالى ألم تروا كيف خلق الله سبع سموات طباقا وجعل القمر فيهن نورا وجعل الشمس سراجا والله أنبتكم من الأرض نباتا ثم يعيدكم فيها ويخرجكم إخراجا وقال تعالى أفرأيتم ما تمنون أأنتم تخلقونه أم نحن الخالقون إلى قوله للمقوين فليس يخفي على من م", "english": "The First Principle: the knowledge of His existence, the Exalted. The first thing by which one is illuminated from among the lights, and the path of reflection (ṭarīq al-iʿtibār) by which one proceeds, is that to which the Qurʾān has guided. For after the explanation of God, glorified be He, there is no explanation. He, the Exalted, has said: {«أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا وَالْجِبَالَ أَوْتَادًا وَخَلَقْنَاكُمْ أَزْوَاجًا وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا وَجَعَلْنَا اللَّيْلَ لِبَاسًا وَجَعَلْنَا النَّهَارَ مَعَاشًا وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا وَجَعَلْنَا سِرَاجًا وَهَّاجًا وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا وَجَنَّاتٍ أَلْفَافًا»} — \"Have We not made the earth a resting place, and the mountains as pegs, and created you in pairs, and made your sleep a repose, and made the night a covering, and made the day for livelihood, and built above you seven strong heavens, and made a blazing lamp, and sent down from the rain-clouds pouring water, that We may bring forth thereby grain and vegetation, and gardens dense with foliage?\" (Q 78:6–16). And He, the Exalted, has said: {«إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ وَمَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ»} — \"Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the ships which sail through the sea with that which benefits people, and what God has sent down from the sky of water, thereby reviving the earth after its death, and dispersing therein every creature, and the directing of the winds, and the clouds subservient between the heaven and the earth — are signs for a people who reason\" (Q 2:164). And He, the Exalted, has said: {«أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا»} — \"Have you not seen how God created seven heavens in layers, and made the moon therein a light, and made the sun a lamp? And God caused you to grow from the earth a growth; then He returns you into it, and brings you forth a bringing forth\" (Q 71:15–18). And He, the Exalted, has said: {«أَفَرَأَيْتُم مَّا تُمْنُونَ أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ»} — \"Have you considered what you emit? Do you create it, or are We the Creator?\" — up to His saying: {«لِلْمُقْوِينَ»} — \"for the settlers\" (Q 56:58–73).", "book_title": "Contemplation", "section_title_ar": "Section 87", "section_title_en": "The Pillars of Faith: Knowledge of God, His Attributes, His Acts, and the Audibles — Section 87", "section_index": 87, "anchors": "- Root: وجود (w-j-d)\n  * Lisan / Ayn: [Core linguistic root meaning: to find, to perceive, to be; existence as that which is found or discovered]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: al-wujūd as necessary existence (wujūb) versus contingent existence (imkān); the self-evident reality of the Creator's being]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: haqīqah — existence as affirmed reality; majāz — \"finding\" as in discovery, not applicable to God's necessary being]\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: [Core linguistic root meaning: measuring, proportioning, fashioning; origination of a thing upon a measure]\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination from nothing without prior model\n  * Al-Zamakhshari (Asas): [Literal: خلق الله الخلق: أوجده على تقدير أوجبته الحكمة — brought into existence upon a measure necessitated by wisdom; Majaz: not applicable to God's act as pure origination]\n- Root: فطر (f-t-r)\n  * Lisan / Ayn: [Core linguistic root meaning: to split, cleave, rend; to originate, to bring forth as a new creation]\n  * Al-Raghib (Mufradat): \"فطر الله الخلق\" — God's origination of creation as a primordial act; \"الفطرة\" as the innate disposition\n  * Al-Zamakhshari (Asas): [Literal: فطر الله الخلق، وهو فاطر السموات: مبتدعها — originator without precedent; Majaz: \"رأيه فطير\" — immature opinion, not applicable to divine]\n- Root: ارض (ar-d)\n  * Lisan / Ayn: [Core linguistic root meaning: the earth, the lower sphere; that which is beneath]\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء\" — the body opposite the heaven\n  * Al-Zamakhshari (Asas): [Literal: the earth as a resting place (مهادا); Majaz: not applicable in this context of divine creation]\n- Root: ركن (r-k-n)\n  * Lisan / Ayn: [Core linguistic root meaning: corner, pillar, support; that to which one leans for strength]\n  * Al-Raghib (Mufradat): \"ركن الشيء: جانبه الذي يسكن إليه\" — the side of a thing to which one repairs; used metaphorically for strength\n  * Al-Zamakhshari (Asas): [Literal: physical pillar/corner; Majaz: \"فلان يأوي من عز قومه إلى ركن شديد\" — one who repairs to a mighty support; here, the \"pillars\" (أركان) of faith as structural supports]\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure \"مداره على عشرة أصول\" (its circuit revolves upon ten principles) employs a prepositional phrase governing the verbal noun, establishing the necessary grammatical dependency that mirrors the ontological dependency of the created upon the Creator.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Contemplation'", "badge": "Afterlife"}, {"arabic": "تعالى على في هذه الليلة إن في خلق السموات والأرض واختلاف الليل والنهار لآيات لأولى الألباب ثم قال ويل لمن قرأها ولم يتفكر فيها (3) فقيل للأوزاعى ما غاية التفكير فيهن قال يقرؤهن ويعقلهن وعن محمد بن واسع إن رجلا من أهل البصرة ركب إلى أم ذر بعد موت أبى ذر فسألها عن عبادة أبى ذر فقالت كان نهاره أجمع في ناحية البيت يتفكر وعن الحسن قال تفكر ساعة خير من قيام ليلة وعن الفضيل قال الفكر مرآة تريك حسناتك وسيئاتك وقيل لإبراهيم إنك تطيل الفكرة فقال الفكرة مخ العقل وكان سفيان بن عيينة كثيرا ما يتمثل بقول القائل إذا المرء كانت له فكرة .", "english": "I say: God — exalted be He — has commanded reflection (tafakkur) and deep contemplation (tadabbur) upon His Mighty Book in places beyond enumeration, and He has praised those who reflect. For He — exalted be He — says: {«الذين يذكرون الله قياما وقعودا وعلى جنوبهم ويتفكرون في خلق السموات والأرض ربنا ما خلقت هذا باطلا»} — \"Those who remember God standing, sitting, and upon their sides, and reflect upon the creation of the heavens and the earth: 'Our Lord, You have not created this in vain'\" (Āl ʿImrān 191).", "book_title": "Contemplation", "section_title_ar": "Section 1257", "section_title_en": "The Virtue of Reflection (Tafakkur) Upon the Creation of God — Section 1257", "section_index": 1257, "anchors": "- Root: فكر (F-K-R)\n  * Lisan / Ayn: Core root denotes the movement of the mind, turning a matter over in the heart/mind; \"الفكرة\" as the power that drives knowledge toward its object.\n  * Al-Raghib (Mufradat): \"الفكرة: قوة مطرقة للعلم إلى المعلوم، والتفكر: جولان تلك القوة بحسب نظر العقل\" — Reflection is the circulation of the intellect's power over what can be apprehended, seeking a mental form (ṣūrah); it is exclusive to humans and is forbidden regarding God's essence, as He transcends all form.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ما دار حوله فكري\" (what revolves around my thought). Metaphorical (Majaz): \"فكرتك مغاص الدرر\" — reflection as a diver's plunge into the sea of meanings to extract pearls of wisdom.\n- Root: خلق (KHLQ)\n  * Lisan / Ayn: Core root: \"التقدير المستقيم\" — precise, straight measurement and estimation; bringing something into being upon a measured pattern.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination (ibdāʿ) from nothing, without prior model or pattern, as in {«خلق السماوات والأرض»} (Al-Anʿām 1); also used for bringing forth from something, as in {«خلقكم من نفس واحدة»} (Al-Nisāʾ 1).\n  * Al-Zamakhshari (Asas): Literal: \"خلق الخراز الأديم\" — the leather-worker measures the hide before cutting. Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.\n- Root: قال (Q-W-L)\n  * Lisan / Ayn: Core root: speech, utterance, saying; in the technical sense, the transmission of prophetic and scholarly dicta (aqwāl).\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic flow of reported speech chains (e.g., \"قال ابن عباس... فقال صلى الله عليه وسلم\"), where the narrator's interposed clauses do not break the grammatical dependency of the quotation, preserving the continuous chain of transmission (isnād).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "191": [{"arabic": "وتقول عند النظر إلى السماء ربنا ما خلقت هذا باطلا سبحانك فقنا عذاب النار تبارك الذي جعل في السماء بروجا وجعل فيها سراجا وقمرا منيرا وإذا سمعت صوت الرعد فقل سبحان من يسبح الرعد بحمده والملائكة من خيفته (7) فإن رأيت الصواعق فقل اللهم لا تقتلنا بغضبك ولا تهلكنا بعذابك وعافنا قبل ذلك (8) قاله كعب فإذا أمطرت السماء فقل اللهم سقيا هنيئا وصيبا نافعا (9) اللهم اجعله صيب رحمة ولا تجعله صيب عذاب (10) فإذا غضبت فقل اللهم اغفر لي ذنبي وأذهب غيظ قلبي وأجرني من الشيطان الرجيم (1) فإذا خفت قوما فقل اللهم إنا نجعلك في نحورهم", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "قال الله تعالى الذين يذكرون الله قياما وقعودا وعلى جنوبهم ويتفكرون في خلق السموات والأرض فأثنى على الكل ولكن قدم القيام في الذكر ثم القعود ثم الذكر مضطجعا قال علي رضي الله عنه من قرأ القرآن وهو قائم في الصلاة كان له بكل حرف مائة حسنة ومن قرأه وهو جالس في الصلاة فله بكل حرف خمسون حسنة ومن قرأه في غير صلاة وهو على وضوء فخمس وعشرون حسنة ومن قرأه على غير وضوء فعشر حسنات وما كان من القيام بالليل فهو أفضل لأنه أفرغ للقلب قال أبو ذر الغفاري رضي الله عنه أن كثرة السجود بالنهار وإن طول القيام بالليل أفضل الثاني", "english": "If he recites without ritual purity, reclining upon his bed, he also has merit, but it is below that [of the one who is pure and seated properly]. Allah Most High said: {الَّذِينَ يَذْكُرُونَ اللَّهَ قِيَامًا وَقُعُودًا وَعَلَىٰ جُنُوبِهِمْ وَيَتَفَكَّرُونَ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ} (\"Those who remember Allah standing, sitting, and upon their sides, and reflect upon the creation of the heavens and the earth\") — and He praised all of them, but He mentioned standing first, then sitting, then remembrance while reclining.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 223", "section_title_en": "The Book of the Etiquette of Qur'an Recitation — Section 223: On the Manners of the Reciter, the Measure of Recitation, Division into Portions, Orthography, Tartīl, Weeping, Rights of the Verses, Invocations, and Vocalization", "section_index": 223, "anchors": "- Root: قرا (Q-R-A)\n  * Lisan / Ayn: To read, recite, gather together; the core act of assembling letters into articulated speech.\n  * Al-Raghib (Mufradat): Recitation (tilāwah) is the following of the Qur'an in obedience and belief; qirā'ah is the articulation of the letters. The term carries both the physical act of vocalization and the spiritual act of devotion.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): to read from a written text or from memory. Metaphorical (majāz): \"qara'a al-rajul\" — to become religious, devoted, as the reciter is characterized by the state of worship.\n- Root: سجد (S-J-D)\n  * Lisan / Ayn: To bow, prostrate, lower oneself; the physical posture of placing the forehead on the ground.\n  * Al-Raghib (Mufradat): Prostration is of two kinds: voluntary (ikhtiyārī) — exclusive to humans, by which reward is deserved; and subjugated (taskhīrī) — universal to all creation, as in {وَلِلَّهِ يَسْجُدُ مَنْ فِي السَّمَاوَاتِ وَالْأَرْضِ}.\n  * Al-Zamakhshari (Asas): Literal: the physical act of prostration. Metaphorical: \"shajarah sājidah\" — a tree bending over; \"ʿayn sājidah\" — a languid, drooping eye. The prostration of recitation is the literal act performed in obedience to the command of the verse.\n- Root: تلو (T-L-W)\n  * Lisan / Ayn: To follow, to recite; the reciter \"follows\" the letters in sequence and \"follows\" the commands contained therein.\n  * Al-Raghib (Mufradat): Tilāwah is following the Qur'an in deed as well as in word; the true reciter is he whose recitation is a following of the divine command.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional and restrictive structures in the prophetic sayings (e.g., \"من قرأ القرآن في أقل من ثلاث لم يفقهه\") establish a causal link between the act and its consequence, requiring precise parsing of the conditional clause to extract the legal ruling.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "وأثنى على المتفكرين فقال تعالى الذين يذكرون الله قياما وقعودا وعلى جنوبهم ويتفكرون في خلق السموات والأرض ربنا ما خلقت هذا باطلا وقد قال ابن عباس رضي الله عنهما إن قوما تفكروا في الله عز وجل فقال صلى الله عليه وسلم تفكروا في خلق الله ولا تتفكروا في الله فإنكم لن تقدروا قدره (1) وعن النبي صلى الله عليه وسلم أنه خرج على قوم ذات يوم وهم يتفكرون فقال ما لكم لا تتكلمون فقالوا نتفكر في خلق الله عز وجل قال فكذلك فافعلوا تفكروا في خلقه ولا تتفكروا فيه فإن بهذا المغرب أرضا بيضاء نورها بياضها وبياضها نورها مسيرة الشمس أربعين يوما بها خلق من خلق الله عز وجل لم يعصوا الله طرفة ع", "english": "I say: God — exalted be He — has commanded reflection (tafakkur) and deep contemplation (tadabbur) upon His Mighty Book in places beyond enumeration, and He has praised those who reflect. For He — exalted be He — says: {«الذين يذكرون الله قياما وقعودا وعلى جنوبهم ويتفكرون في خلق السموات والأرض ربنا ما خلقت هذا باطلا»} — \"Those who remember God standing, sitting, and upon their sides, and reflect upon the creation of the heavens and the earth: 'Our Lord, You have not created this in vain'\" (Āl ʿImrān 191).", "book_title": "Contemplation", "section_title_ar": "Section 1257", "section_title_en": "The Virtue of Reflection (Tafakkur) Upon the Creation of God — Section 1257", "section_index": 1257, "anchors": "- Root: فكر (F-K-R)\n  * Lisan / Ayn: Core root denotes the movement of the mind, turning a matter over in the heart/mind; \"الفكرة\" as the power that drives knowledge toward its object.\n  * Al-Raghib (Mufradat): \"الفكرة: قوة مطرقة للعلم إلى المعلوم، والتفكر: جولان تلك القوة بحسب نظر العقل\" — Reflection is the circulation of the intellect's power over what can be apprehended, seeking a mental form (ṣūrah); it is exclusive to humans and is forbidden regarding God's essence, as He transcends all form.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ما دار حوله فكري\" (what revolves around my thought). Metaphorical (Majaz): \"فكرتك مغاص الدرر\" — reflection as a diver's plunge into the sea of meanings to extract pearls of wisdom.\n- Root: خلق (KHLQ)\n  * Lisan / Ayn: Core root: \"التقدير المستقيم\" — precise, straight measurement and estimation; bringing something into being upon a measured pattern.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination (ibdāʿ) from nothing, without prior model or pattern, as in {«خلق السماوات والأرض»} (Al-Anʿām 1); also used for bringing forth from something, as in {«خلقكم من نفس واحدة»} (Al-Nisāʾ 1).\n  * Al-Zamakhshari (Asas): Literal: \"خلق الخراز الأديم\" — the leather-worker measures the hide before cutting. Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.\n- Root: قال (Q-W-L)\n  * Lisan / Ayn: Core root: speech, utterance, saying; in the technical sense, the transmission of prophetic and scholarly dicta (aqwāl).\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic flow of reported speech chains (e.g., \"قال ابن عباس... فقال صلى الله عليه وسلم\"), where the narrator's interposed clauses do not break the grammatical dependency of the quotation, preserving the continuous chain of transmission (isnād).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "193": [{"arabic": "وفي الآخرة حسنة وقنا عذاب النار ربنا إننا سمعنا مناديا ينادي للإيمان إلى قوله عز وجل إنك لا تخلف الميعاد ربنا لا تؤاخذنا إن نسينا أو أخطأنا ربنا إلى آخر السورة (3) رب اغفر لي ولوالدي وارحمهما كما ربياني صغيرا واغفر للمؤمنين والمؤمنات والمسلمين والمسلمات الأحياء منهم والأموات (4) رب اغفر وارحم وتجاوز عما تعلم وأنت الأعز الأكرم وأنت خير الراحمين وأنت خير الغافرين وإنا لله وإنا إليه راجعون ولا حول ولا قوة إلا بالله العلي العظيم وحسبنا الله ونعم الوكيل وصلى الله على محمد خاتم النبيين وآله وصحبه وسلم تسليما كثيرا (5)", "english": "And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 252", "section_title_en": "Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)", "section_index": 252, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "194": [{"arabic": "والفضيلة والدرجة الرفيعة وابعثه المقام المحمود الذي وعدته إنك لا تخلف الميعاد وقال سعيد بن المسيب من صلى بأرض فلاة صلى عن يمينه ملك وعن شماله ملك فإن أذن وأقام صلى وراءه أمثال الجبال من الملائكة فضيلة المكتوبة قال الله تعالى إن الصلاة كانت على المؤمنين كتابا موقوتا وقال صلى الله عليه وسلم خمس صلوات كتبهن الله على العباد فمن جاء بهن ولم يضيع منهن شيئا استخفافا بحقهن كان له عند الله عهد أن يدخله الجنة ومن لم يأت بهن فليس له عند الله عهد إن شاء عذبه وإن شاء أدخله الجنة (5) وقال صلى الله عليه وسلم مثل الصلوات الخمس كمثل", "english": "Praise be to God, who has inundated His servants with His subtle graces (laṭāʾif) and filled their hearts with the lights of religion and its ordinances — which descend from the Throne of Majesty to the heaven of this world as one of the outpourings of His mercy. He has distinguished Himself from [earthly] kings through His unique possession of Majesty and Grandeur by encouraging His creatures to ask and to supplicate, saying: {«هَلْ مِن دَاعٍ فَأَسْتَجِيبَ لَهُ وَهَلْ مِن مُّسْتَغْفِرٍ فَأَغْفِرَ لَهُ»} (Is there any supplicant that I may respond to him? Is there any seeker of forgiveness that I may forgive him?). And He has set Himself apart from [earthly] sovereigns by opening the door and lifting the veil, permitting His servants to engage in intimate communion (munājāh) through the prayers, however their states may fluctuate — in congregations and in solitude. Nor did He content Himself with mere permission, but He graciously encouraged and invited [them]. Other kings, even the weakest among them, do not permit private audience except after the presentation of gifts and bribes. Glory be to Him — how great is His majesty, how mighty His dominion, how complete His gentleness, how all-encompassing His beneficence!", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 120", "section_title_en": "The Book of the Secrets of Prayer and Its Essential Matters — Section 120: On the Virtues of the Call to Prayer (Adhān) and the Prescribed Prayers", "section_index": 120, "anchors": "- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: The root denotes the act of supplication, blessing, and the prescribed ritual prayer; its core sense involves \"connection\" and \"turning toward.\"\n  * Al-Raghib (Mufradat): \"الصلاة\" in its theological sense is the act of drawing near to God through prescribed devotional acts comprising bowing, prostration, and remembrance — a covenant (ʿahd) between the servant and his Lord.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the ritual prayer with its known conditions and pillars. Metaphorical (majāz): supplication (duʿāʾ) and blessing (raḥmah), as in \"the angels send blessings (yuṣallūn) upon the Prophet.\"\n- Root: أذن (A-Dh-N)\n  * Lisan / Ayn: To listen, to give ear; the mu'adhdhin is one who makes the call heard publicly.\n  * Al-Raghib (Mufradat): The adhān is the public proclamation summoning the community to the prescribed prayer — a declaration of the time of worship.\n  * Al-Zamakhshari (Asas): Literal: the act of making known. Metaphorical: the call to prayer as a summons to the Divine presence.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereignty.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي في الجمهور\" — The king is one who disposes by command and prohibition over the multitude. God's sovereignty (mulk) is absolute and unshared.\n  * Al-Zamakhshari (Asas): Literal: ownership and dominion. Metaphorical: \"ملك عليه أمره\" — mastery over one's own affair, self-possession.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — The periodic sentence structure in the opening doxology employs suspended clauses (ḥāl) that qualify the subject while maintaining syntactic cohesion through the governing verb's semantic reach.\n\n---", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "وقوله تعالى وتجعلون رزقكم أنكم تكذبون أي شكر رزقكم وقوله عز وجل وآتنا ما وعدتنا على رسلك أي على ألسنة رسلك فحذف ألسنة وقوله تعالى إنا أنزلناه في ليلة القدر أراد القرآن وما سبق له ذكر وقال عز وجل حتى توارت الحجاب أراد الشمس وما سبق لها ذكر وقوله تعالى والذين اتخذوا من دونه أولياء ما نعبدهم إلا ليقربونا إلى الله زلفى أي يقولون ما نعبدهم وقوله عز وجل فمال هؤلاء القوم لا يكادون يفقهون حديثا ما أصابك من حسنة فمن الله وما أصابك من سيئة فمن نفسك معناه لا يفقهون حديثا يقولون ما أصابك من حسنة فمن الله فإن لم يرد هذا كان مناقضا لقوله قل كل", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "195": [{"arabic": "سأل عنهالحديث وإسنادهما جيد وفي هذا أنه كان لا يسأل عما أتي به من عند أهله والله أعلم // وإنما الواجب أن ينظر التاجر إلى من يعامله فكل منسوب إلى ظلم أو خيانة أو سرقة أو ربا فلا يعامله وكذا الأجناد والظلمة لا يعاملهم البتة ولا يعامل أصحابهم وأعوانهم لأنه معين بذلك على الظلم وحكي عن رجل أنه تولى عمارة سور لثغر من الثغور قال فوقع في نفسي من ذلك شيء وإن كان ذلك العمل من الخيرات بل من فرائض الإسلام ولكن كان الأمير الذي تولى في محلته من الظلمة قال فسألت سفيان رضي الله عنه فقال لا تكن عونا لهم على قليل ولا كثير فقلت ه", "english": "The fifth [etiquette] is that he should not be intensely eager for the marketplace and trade — that is, he should not be the first to enter nor the last to leave, nor should he voyage by sea for trade, for both of these are disliked (makrūh). It is said: \"Whoever voyages by sea has been excessive in seeking provision.\"", "book_title": "Etiquette of Earning", "section_title_ar": "Section 334", "section_title_en": "The Book of Earning and Livelihood — Section 334: On the Etiquettes of the Trader (Continued)", "section_index": 334, "anchors": "- Root: حرص (ḥaraṣa)\n  * Lisan / Ayn: [Core linguistic root meaning] — Intense, covetous desire; eager clinging to something.\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] — Blameworthy eagerness that distracts the heart from God; opposed to qanāʿah (contentment).\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] — Literal: physical greed for provision. Metaphorical: the soul's excessive attachment to worldly gain.\n- Root: شبه (shub'hah)\n  * Lisan / Ayn: [Core linguistic root meaning] — Ambiguity; resemblance between truth and falsehood.\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] — Matters whose legal status is uncertain; the pious abstain from them to safeguard their religion.\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] — Literal: visual resemblance. Metaphorical: doubtful matters that resemble the permissible but are tainted with the forbidden.\n- Root: عون (ʿawn)\n  * Lisan / Ayn: [Core linguistic root meaning] — Assistance; aid in carrying a burden.\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] — Complicity in sin; assisting the oppressor is itself an act of oppression.\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] — Literal: physical help. Metaphorical: any act that enables or emboldens wrongdoing.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The text uses restrictive constructions to emphasize that the trader's obligation is limited to dealing with the just, and that the pious are fewer in number than those to be avoided.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Earning'", "badge": "Hadith"}], "198": [{"arabic": "الليل يتلذذ به في رجاء إنعامه والرجاء في حق الله تعالى أصدق وما عند الله خير وأبقى وأنفع مما عند غيره فكيف لا يتلذذ بعرض الحاجات عليه في الخلوات وأما النقل فيشهد له أحوال قوام الليل في تلذذهم بقيام الليل واستقصارهم له كما يستقصر المحب ليلة وصال الحبيب حتى قيل لبعضهم كيف أنت والليل قال ما راعيته قط يريني وجهه ثم ينصرف وما تأملته بعد وقال آخر أنا والليل فرسا رهان مرة يسبقني إلى الفجر ومرة يقطعني عن الفكر وقيل لبعضهم كيف الليل عليك فقال ساعة أنا فيها بين حالتين أفرح بظلمته إذا جاء وأغتم بفجره إذا طلع ما تم فرحي به قط وقال علي بن", "english": "That if the beautiful Beloved were behind a veil or in a dark house, the lover would still take delight in mere proximity to Him, without vision and without coveting any other matter besides Him — and he would find joy in displaying his love before Him and in mentioning Him with his tongue within His hearing, even though that too were already known to Him. For if you say: \"He awaits His response\" — then let him delight in hearing His response; yet he does not hear the speech of God, exalted be He. Know then that if he knows that He will not answer him and will remain silent toward him, there still remains for him a delight in presenting his states before Him and in raising his innermost secret to Him. How [could it be otherwise], when the one who is certain (al-mūqin) hears from God, exalted be He, everything that occurs to his mind during the course of his whispered communion (munājāh), and thus takes delight in it? Likewise, one who secludes himself with a king and presents his needs to him in the depths of the night takes delight in it through hope of his beneficence — and hope with respect to God, exalted be He, is more truthful, and what is with God is better, more enduring, and more beneficial than what is with anyone else. So how would he not delight in presenting his needs before Him in private seclusions (khalawāt)?", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 277", "section_title_en": "On the Delight of Night Vigil and Whispered Communion — Section 277", "section_index": 277, "anchors": "- Root: ليل (layl)\n  * Lisan / Ayn: Night; the period of darkness following sunset until dawn; its diminutive is 'luyaylah' and its plural is 'layālin' — indicating a temporal span marked by stillness and concealment.\n  * Al-Raghib (Mufradat): Night (al-layl) is that which veils (yughashshī) and covers, as in {«وَاللَّيْلِ إِذَا يَغْشَى»} — a time when sensory distractions recede and the heart turns toward intimate communion (munājāh) with the Divine.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): the astronomical night. Metaphorical (majāz): the night of the heart — a state of spiritual wakefulness wherein the lover finds delight in solitude with the Beloved, as expressed in the sayings of the pious transmitted herein.\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; illumination that renders things visible; also the fire-kindling and the beacon (manār) guiding travelers.\n  * Al-Raghib (Mufradat): Light is of two kinds: sensory light perceived by the eye, and intellectual/spiritual light (nūr al-ʿaql, nūr al-Qurʾān) perceived by the inner eye of insight (baṣīrah). The Divine light cast into the hearts of the vigilant is of this latter kind — an immaterial radiance (laṭīfah nūrāniyyah) that transforms the inner state.\n  * Al-Zamakhshari (Asas): Literal: physical illumination. Metaphorical: 'nawwara al-amr' — to clarify and illuminate a matter; here, the spreading of spiritual lights (anwār) from wakeful hearts to heedless ones is a metaphorical extension of this root, signifying the transmission of divine grace.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning and revolving of a thing from one state to another (taqlīb).\n  * Al-Raghib (Mufradat): The heart is so named for its constant fluctuation (taqallub) between states; it is the seat of perception and understanding, the locus of divine address and the receptacle of spiritual lights.\n  * Al-Zamakhshari (Asas): Literal: the physical organ. Metaphorical: 'qallaba al-amr' — to examine and turn over a matter; here, the hearts of the vigilant are 'turned over' by divine light, and from them 'spread' (tantašir) blessings to others — a metaphorical extension of physical turning to spiritual transformation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle 'innamā' restricts and confines the predicate to the subject alone, as in the transmitted saying: \"The delight of whispered communion is not of this world; it is only (innamā) of Paradise\" — a focused predication that negates any worldly share of this pleasure and affirms its exclusive otherworldly origin.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "199": [{"arabic": "واشتروا به ثمنا قليلا وقال تعالى في علماء الآخرة وإن من أهل الكتاب لمن يؤمن بالله وما أنزل إليكم وما أنزل إليهم خاشعين لله لا يشترون بآيات الله ثمنا قليلا أولئك لهم أجرهم عند ربهم وقال بعض السلف العلماء يحشرون في زمرة الأنبياء والقضاة يحشرون في زمرة السلاطين وفي معنى القضاة كل فقيه قصده طلب الدنيا بعلمه وروى أبو الدرداء رضي الله عنه عن النبي صلى الله عليه وسلم أنه قال أوحى الله عز وجل إلى بعض الأنبياء قل للذين يتفقهون لغير الدين ويتعلمون لغير العمل ويطلبون الدنيا بعمل الآخرة يلبسون للناس مسوك الكباش وقلوبهم كقلوب الذئاب ألسنتهم أحلى من العسل وقلوبهم أمر من الصبر إياي يخادعون وبي يستهزئون لأفتحن لهم فتنة تذر الحليم حيران", "english": "[Root: ملح]\n  • Lisan al-Arab: \"الملح: ما يصلح الطعام، وجمعه ملوح وأملاح. والمليح: الحسن. والملاحة: الحسن. وملح الرجل يملح ملاحة: حسن. وتملح: تزين.\"\n  • Al-Raghib (Al-Mufradat): \"الملح: ما يحفظ الطعام ويمنع فساده، ويستعار لما يحفظ الإيمان والعلم من الفساد.\"\n  • Al-Zamakhshari (Asas): \"ملح الماء: إذا كان فيه ملوحة. وملح الطعام: جعل فيه الملح. وهذا على الحقيقة، ويستعار الملح لما يصلح به الأمر.\"\n  • Kitab al-Ayn: \"الملح: معروف، والمليح: الحسن من كل شيء.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 52", "section_title_en": "Section 52", "section_index": 52, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Book of Knowledge'", "badge": "Ethics"}, {"arabic": "يؤمن بالله وما أنزل إليكم وما أنزل إليهم خاشعين لله لا يشترون بآيات الله ثمنا قليلا أولئك لهم أجرهم عند ربهم وقال بعض السلف العلماء يحشرون في زمرة الأنبياء والقضاة يحشرون في زمرة السلاطين وفي معنى القضاة كل فقيه قصده طلب الدنيا بعلمه وروى أبو الدرداء رضي الله عنه عن النبي صلى الله عليه وسلم أنه قال أوحى الله عز وجل إلى بعض الأنبياء قل للذين يتفقهون لغير الدين ويتعلمون لغير العمل ويطلبون الدنيا بعمل الآخرة يلبسون للناس مسوك الكباش وقلوبهم كقلوب الذئاب ألسنتهم أحلى من العسل وقلوبهم أمر من الصبر إياي يخادعون وبي يستهزئون لأفتحن", "english": "[Root: ملح]\n  • Lisan al-Arab: \"الملح: ما يصلح الطعام، وجمعه ملوح وأملاح. والمليح: الحسن. والملاحة: الحسن. وملح الرجل يملح ملاحة: حسن. وتملح: تزين.\"\n  • Al-Raghib (Al-Mufradat): \"الملح: ما يحفظ الطعام ويمنع فساده، ويستعار لما يحفظ الإيمان والعلم من الفساد.\"\n  • Al-Zamakhshari (Asas): \"ملح الماء: إذا كان فيه ملوحة. وملح الطعام: جعل فيه الملح. وهذا على الحقيقة، ويستعار الملح لما يصلح به الأمر.\"\n  • Kitab al-Ayn: \"الملح: معروف، والمليح: الحسن من كل شيء.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 52", "section_title_en": "Section 52", "section_index": 52, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Book of Knowledge'", "badge": "Afterlife"}], "200": [{"arabic": "وقد أمرهم بالصبر والمرابطة فقال عز من قائل يا أيها الذين آمنو اصبروا وصابروا ورابطوا فرابطوا أنفسهم أولا بالمشارطة ثم بالمراقبة ثم بالمحاسبة ثم بالمعاقبة ثم بالمجاهدة ثم بالمعاتبة فكانت لهم في المرابطة ست مقامات ولا بد من شرحها وبيان حقيقتها وفضيلتها وتفصيل الأعمال فيها وأصل ذلك المحاسبة ولكن كل حساب فبعد مشارطة ومراقبة ويتبعه عند الخسران المعاتبة والمعاقبة فلنذكر شرح هذه المقامات وبالله التوفيق", "english": "To proceed: God Most High has said: {And We shall set up the scales of justice for the Day of Resurrection, so no soul shall be wronged in anything; and if it be the weight of a grain of mustard seed, We shall bring it forth, and sufficient are We as Reckoners} (21:47). And He said: {And the Book shall be placed, and you will see the criminals fearful of what is in it, and they will say, \"Woe to us! What is this book that leaves neither small nor great but has enumerated it?\" And they will find what they did present, and your Lord wrongs no one} (18:49). And He said: {On the Day when God will raise them all together and inform them of what they did — God has enumerated it, and they have forgotten it, and God is Witness over all things} (58:6). And He said: {On that Day, people will issue forth in scattered groups to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it} (99:6-8). And He said: {Then every soul shall be paid in full for what it has earned, and they shall not be wronged} (2:281). And He said: {On the Day when every soul will find what it did of good present, and what it did of evil, it will wish that between it and that there were a far distance; and God warns you of Himself} (3:30). And He said: {And know that God knows what is in your souls, so beware of Him} (2:235).", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1230", "section_title_en": "Exposition of the Reality of Truthfulness (Al-Sidq), Its Meaning, and Its Grades — Book of Vigilance and Self-Reckoning, Being the Eighth Book of the Quarter of Deliverance from the Revival of the Religious Sciences", "section_index": 1230, "anchors": "- Root: رقب (Raqaba)\n  * Lisan / Ayn: To watch, guard, observe; a watcher (raqīb) is one who stands vigilant over something, awaiting its occurrence.\n  * Al-Raghib (Mufradat): Raqaba denotes protective watchfulness; al-raqīb is a divine attribute signifying His perpetual oversight of all that transpires, with no moment of neglect.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical watching/awaiting. Metaphorical (majāz): \"This matter is upon your necks (fī riqābikum)\" — i.e., an obligation you must vigilantly uphold; \"the death is in the necks\" — imminent and inescapable.\n- Root: حسب (Hasaba)\n  * Lisan / Ayn: To count, reckon, compute; al-ḥisāb is the act of enumeration and settlement of accounts.\n  * Al-Raghib (Mufradat): Al-ḥisāb is the employment of number; divine reckoning (ḥisāb) on the Day of Resurrection is the exacting appraisal of deeds, even to the atom's weight.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"they reckon news (yaḥtasibūna al-akhbār)\" — they investigate and ascertain, as one places knowledge in place of conjecture.\n- Root: قلب (Qalaba)\n  * Lisan / Ayn: To turn, overturn, transform; the heart (qalb) is so named for its constant fluctuation and turning of states.\n  * Al-Raghib (Mufradat): Qalaba is the turning of a thing from one state to another; the heart's inner thoughts (khaṭarāt) are its successive movements, which God surveys.\n  * Al-Zamakhshari (Asas): Literal: turning a garment or object. Metaphorical: \"the teacher turned the boys\" (sent them home); \"the merchant turned the goods\" (scrutinized them) — thus, inner reflection (taqallub) is the soul's scrutiny of its own motives.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"إنما يحاسبهم لتعلم كل نفس\" — the sole purpose of reckoning is specified, excluding all other ends.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 7002]], "2": [[1, 400, 1295], [2, 1295, 2464], [3, 2464, 3302], [4, 3302, 4333], [5, 4333, 4877], [6, 4877, 6015], [7, 6015, 7743]], "3": [[1, 400, 1230], [2, 1230, 2270], [3, 2270, 3354], [4, 3354, 4571], [5, 4571, 6087], [6, 6087, 7050], [7, 7050, 7824], [8, 7824, 8908], [9, 8908, 10169], [10, 10169, 12105], [11, 12105, 13986]], "4": [[1, 400, 975], [2, 975, 1966], [3, 1966, 2943], [4, 2943, 5213], [5, 5213, 6851], [6, 6851, 8891], [7, 8891, 9940], [8, 9940, 11564], [9, 11564, 13317], [10, 13317, 15127], [11, 15127, 16262], [12, 16262, 17095], [13, 17095, 18503], [14, 18503, 19854], [15, 19854, 21420], [16, 21420, 22771], [17, 22771, 23518], [18, 23518, 25271]], "5": [[1, 400, 1187], [2, 1187, 2039], [3, 2039, 2600], [4, 2600, 3894], [5, 3894, 4886], [6, 4886, 5641], [7, 5641, 6180], [8, 6180, 7215], [9, 7215, 8099], [10, 8099, 8638], [11, 8638, 10616]], "6": [[1, 400, 965], [2, 965, 2060], [3, 2060, 4043], [4, 4043, 4631], [5, 4631, 6326], [6, 6326, 7150], [7, 7150, 8953], [8, 8953, 10168], [9, 10168, 11039], [10, 11039, 12110], [11, 12110, 12675], [12, 12675, 14087], [13, 14087, 15475]], "7": [[1, 400, 1025], [2, 1025, 2860], [3, 2860, 3953], [4, 3953, 5176], [5, 5176, 6451], [6, 6451, 7206], [7, 7206, 8716], [8, 8716, 10577], [9, 10577, 11449], [10, 11449, 12399], [11, 12399, 13674], [12, 13674, 14923], [13, 14923, 16839], [14, 16839, 18466], [15, 18466, 19937], [16, 19937, 20588], [17, 20588, 22306], [18, 22306, 23243], [19, 23243, 25573], [20, 25573, 26250], [21, 26250, 27505], [22, 27505, 28260], [23, 28260, 30501], [24, 30501, 31828], [25, 31828, 34460], [26, 34460, 36308], [27, 36308, 37375], [28, 37375, 38598], [29, 38598, 40821], [30, 40821, 42005], [31, 42005, 43033], [32, 43033, 45714], [33, 45714, 46365], [34, 46365, 47536], [35, 47536, 49540], [36, 49540, 51479], [37, 51479, 51974], [38, 51974, 52690], [39, 52690, 53588], [40, 53588, 54421], [41, 54421, 5