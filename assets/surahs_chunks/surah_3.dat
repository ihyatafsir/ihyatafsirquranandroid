{"surah": 3, "verses": [{"ayah": 1, "text": "الٓمٓ ", "translation": "Alif, Lām, Meem.[1]", "words": [{"id": 1, "arabic": "الٓمٓ", "translit": "ٓmٓlā", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ٱلْحَىُّ ٱلْقَيُّومُ ", "translation": "Allāh - there is no deity except Him, the Ever-Living, the Self-Sustaining.[1]", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 3, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "ٱلْحَىُّ", "translit": "ُّàَḥْlٱ", "root": "حيي"}, {"id": 7, "arabic": "ٱلْقَيُّومُ", "translit": "ُmwُّyَqْlٱ", "root": "قوم"}], "hasIhya": true}, {"ayah": 3, "text": "نَزَّلَ عَلَيْكَ ٱلْكِتَٰبَ بِٱلْحَقِّ مُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ وَأَنزَلَ ٱلتَّوْرَىٰةَ وَٱلْإِنجِيلَ ", "translation": "He has sent down upon you, [O Muḥammad], the Book in truth, confirming what was before it. And He revealed the Torah and the Gospel", "words": [{"id": 1, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 2, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 5, "arabic": "مُصَدِّقًا", "translit": "āًqِّdَṣُm", "root": "صدق"}, {"id": 6, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 7, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 8, "arabic": "يَدَيْهِ", "translit": "ِhْyَdَy", "root": "يدي"}, {"id": 9, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 10, "arabic": "ٱلتَّوْرَىٰةَ", "translit": "َẗٰàَrْwَّtlٱ", "root": ""}, {"id": 11, "arabic": "وَٱلْإِنجِيلَ", "translit": "َlyِjgnِiʾْlٱَw", "root": ""}], "hasIhya": false}, {"ayah": 4, "text": "مِن قَبْلُ هُدًى لِّلنَّاسِ وَأَنزَلَ ٱلْفُرْقَانَۗ إِنَّ ٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِ ٱللَّهِ لَهُمْ عَذَابٌ شَدِيدٌۗ وَٱللَّهُ عَزِيزٌ ذُو ٱنتِقَامٍ ", "translation": "Before, as guidance for the people. And He revealed the Criterion [i.e., the Qur’ān]. Indeed, those who disbelieve in the verses of Allāh will have a severe punishment, and Allāh is Exalted in Might, the Owner of Retribution.[1]", "words": [{"id": 1, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 2, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 3, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 4, "arabic": "لِّلنَّاسِ", "translit": "ِsāَّnlِّl", "root": "انس"}, {"id": 5, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 6, "arabic": "ٱلْفُرْقَانَ", "translit": "َnāَqْrُfْlٱ", "root": "فرق"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 13, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 14, "arabic": "شَدِيدٌ", "translit": "ٌdyِdَhs", "root": "شدد"}, {"id": 15, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 16, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 17, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 18, "arabic": "ٱنتِقَامٍ", "translit": "ٍmāَqِtnٱ", "root": "نقم"}], "hasIhya": false}, {"ayah": 5, "text": "إِنَّ ٱللَّهَ لَا يَخْفَىٰ عَلَيْهِ شَىْءٌ فِى ٱلْأَرْضِ وَلَا فِى ٱلسَّمَآءِ ", "translation": "Indeed, from Allāh nothing is hidden in the earth nor in the heaven.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَخْفَىٰ", "translit": "ٰàَfْhkَy", "root": "خفي"}, {"id": 5, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}], "hasIhya": true}, {"ayah": 6, "text": "هُوَ ٱلَّذِى يُصَوِّرُكُمْ فِى ٱلْأَرْحَامِ كَيْفَ يَشَآءُۚ لَآ إِلَٰهَ إِلَّا هُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "It is He who forms you in the wombs however He wills. There is no deity except Him, the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُصَوِّرُكُمْ", "translit": "ْmُkُrِّwَṣُy", "root": "صور"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْحَامِ", "translit": "ِmāَḥْrَaʾْlٱ", "root": "رحم"}, {"id": 6, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 7, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 8, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 9, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 12, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 13, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 7, "text": "هُوَ ٱلَّذِىٓ أَنزَلَ عَلَيْكَ ٱلْكِتَٰبَ مِنْهُ ءَايَٰتٌ مُّحْكَمَٰتٌ هُنَّ أُمُّ ٱلْكِتَٰبِ وَأُخَرُ مُتَشَٰبِهَٰتٌۖ فَأَمَّا ٱلَّذِينَ فِى قُلُوبِهِمْ زَيْغٌ فَيَتَّبِعُونَ مَا تَشَٰبَهَ مِنْهُ ٱبْتِغَآءَ ٱلْفِتْنَةِ وَٱبْتِغَآءَ تَأْوِيلِهِۦۗ وَمَا يَعْلَمُ تَأْوِيلَهُۥٓ إِلَّا ٱللَّهُۗ وَٱلرَّٰسِخُونَ فِى ٱلْعِلْمِ يَقُولُونَ ءَامَنَّا بِهِۦ كُلٌّ مِّنْ عِندِ رَبِّنَاۗ وَمَا يَذَّكَّرُ إِلَّآ أُو۟لُوا۟ ٱلْأَلْبَٰبِ ", "translation": "It is He who has sent down to you, [O Muḥammad], the Book; in it are verses [that are] precise - they are the foundation of the Book - and others unspecific.[1] As for those in whose hearts is deviation [from truth], they will follow that of it which is unspecific, seeking discord and seeking an interpretation [suitable to them]. And no one knows its [true] interpretation except Allāh. But those firm in knowledge say, \"We believe in it. All [of it] is from our Lord.\" And no one will be reminded except those of understanding,", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 4, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 7, "arabic": "ءَايَٰتٌ", "translit": "ٌtَٰyāَء", "root": "ايي"}, {"id": 8, "arabic": "مُّحْكَمَٰتٌ", "translit": "ٌtَٰmَkْḥُّm", "root": "حكم"}, {"id": 9, "arabic": "هُنَّ", "translit": "َّnُh", "root": ""}, {"id": 10, "arabic": "أُمُّ", "translit": "ُّmُaʾ", "root": "امم"}, {"id": 11, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 12, "arabic": "وَأُخَرُ", "translit": "ُrَhkُaʾَw", "root": "اخر"}, {"id": 13, "arabic": "مُتَشَٰبِهَٰتٌ", "translit": "ٌtَٰhِbَٰhsَtُm", "root": "شبه"}, {"id": 14, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 15, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 18, "arabic": "زَيْغٌ", "translit": "ٌغْyَz", "root": "زيغ"}, {"id": 19, "arabic": "فَيَتَّبِعُونَ", "translit": "َnwُʿعِbَّtَyَf", "root": "تبع"}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 21, "arabic": "تَشَٰبَهَ", "translit": "َhَbَٰhsَt", "root": "شبه"}, {"id": 22, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 23, "arabic": "ٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱ", "root": "بغي"}, {"id": 24, "arabic": "ٱلْفِتْنَةِ", "translit": "ِẗَnْtِfْlٱ", "root": "فتن"}, {"id": 25, "arabic": "وَٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱَw", "root": "بغي"}, {"id": 26, "arabic": "تَأْوِيلِهِۦ", "translit": "ۦِhِlyِwْaʾَt", "root": "اول"}, {"id": 27, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 28, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 29, "arabic": "تَأْوِيلَهُۥٓ", "translit": "ٓۥُhَlyِwْaʾَt", "root": "اول"}, {"id": 30, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 31, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "وَٱلرَّٰسِخُونَ", "translit": "َnwُhkِsَّٰrlٱَw", "root": "رسخ"}, {"id": 33, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 34, "arabic": "ٱلْعِلْمِ", "translit": "ِmْlِʿعْlٱ", "root": "علم"}, {"id": 35, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 36, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 37, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 38, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 39, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 40, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 41, "arabic": "رَبِّنَا", "translit": "āَnِّbَr", "root": "ربب"}, {"id": 42, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 43, "arabic": "يَذَّكَّرُ", "translit": "ُrَّkَّhdَy", "root": "ذكر"}, {"id": 44, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 45, "arabic": "أُو۟لُوا۟", "translit": "۟āwُl۟wُaʾ", "root": ""}, {"id": 46, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}], "hasIhya": true}, {"ayah": 8, "text": "رَبَّنَا لَا تُزِغْ قُلُوبَنَا بَعْدَ إِذْ هَدَيْتَنَا وَهَبْ لَنَا مِن لَّدُنكَ رَحْمَةًۚ إِنَّكَ أَنتَ ٱلْوَهَّابُ ", "translation": "[Who say], \"Our Lord, let not our hearts deviate after You have guided us and grant us from Yourself mercy. Indeed, You are the Bestower.[1]", "words": [{"id": 1, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تُزِغْ", "translit": "ْغِzُt", "root": "زيغ"}, {"id": 4, "arabic": "قُلُوبَنَا", "translit": "āَnَbwُlُq", "root": "قلب"}, {"id": 5, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 7, "arabic": "هَدَيْتَنَا", "translit": "āَnَtْyَdَh", "root": "هدي"}, {"id": 8, "arabic": "وَهَبْ", "translit": "ْbَhَw", "root": "وهب"}, {"id": 9, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "لَّدُنكَ", "translit": "َknُdَّl", "root": "لدن"}, {"id": 12, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 13, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 14, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 15, "arabic": "ٱلْوَهَّابُ", "translit": "ُbāَّhَwْlٱ", "root": "وهب"}], "hasIhya": false}, {"ayah": 9, "text": "رَبَّنَآ إِنَّكَ جَامِعُ ٱلنَّاسِ لِيَوْمٍ لَّا رَيْبَ فِيهِۚ إِنَّ ٱللَّهَ لَا يُخْلِفُ ٱلْمِيعَادَ ", "translation": "Our Lord, surely You will gather the people for a Day about which there is no doubt. Indeed, Allāh does not fail in His promise.\"", "words": [{"id": 1, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 3, "arabic": "جَامِعُ", "translit": "ُʿعِmāَjg", "root": "جمع"}, {"id": 4, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "لِيَوْمٍ", "translit": "ٍmْwَyِl", "root": "يوم"}, {"id": 6, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 7, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 8, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُخْلِفُ", "translit": "ُfِlْhkُy", "root": "خلف"}, {"id": 13, "arabic": "ٱلْمِيعَادَ", "translit": "َdāَʿعyِmْlٱ", "root": "وعد"}], "hasIhya": false}, {"ayah": 10, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ لَن تُغْنِىَ عَنْهُمْ أَمْوَٰلُهُمْ وَلَآ أَوْلَٰدُهُم مِّنَ ٱللَّهِ شَيْـًٔاۖ وَأُو۟لَٰٓئِكَ هُمْ وَقُودُ ٱلنَّارِ ", "translation": "Indeed, those who disbelieve - never will their wealth or their children avail them against Allāh at all. And it is they who are fuel for the Fire.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 5, "arabic": "تُغْنِىَ", "translit": "َàِnْغُt", "root": "غني"}, {"id": 6, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 7, "arabic": "أَمْوَٰلُهُمْ", "translit": "ْmُhُlَٰwْmَaʾ", "root": "مول"}, {"id": 8, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 9, "arabic": "أَوْلَٰدُهُم", "translit": "mُhُdَٰlْwَaʾ", "root": "ولد"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 13, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 14, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 15, "arabic": "وَقُودُ", "translit": "ُdwُqَw", "root": "وقد"}, {"id": 16, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 11, "text": "كَدَأْبِ ءَالِ فِرْعَوْنَ وَٱلَّذِينَ مِن قَبْلِهِمْۚ كَذَّبُوا۟ بِـَٔايَٰتِنَا فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمْۗ وَٱللَّهُ شَدِيدُ ٱلْعِقَابِ ", "translation": "[Theirs is] like the custom of the people of Pharaoh and those before them. They denied Our signs, so Allāh seized them for their sins. And Allāh is severe in penalty.", "words": [{"id": 1, "arabic": "كَدَأْبِ", "translit": "ِbْaʾَdَk", "root": "داب"}, {"id": 2, "arabic": "ءَالِ", "translit": "ِlāَء", "root": "اول"}, {"id": 3, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 7, "arabic": "كَذَّبُوا۟", "translit": "۟āwُbَّhdَk", "root": "كذب"}, {"id": 8, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 9, "arabic": "فَأَخَذَهُمُ", "translit": "ُmُhَhdَhkَaʾَf", "root": "اخذ"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "بِذُنُوبِهِمْ", "translit": "ْmِhِbwُnُhdِb", "root": "ذنب"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 14, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}], "hasIhya": false}, {"ayah": 12, "text": "قُل لِّلَّذِينَ كَفَرُوا۟ سَتُغْلَبُونَ وَتُحْشَرُونَ إِلَىٰ جَهَنَّمَۚ وَبِئْسَ ٱلْمِهَادُ ", "translation": "Say to those who disbelieve, \"You will be overcome and gathered together to Hell, and wretched is the resting place.\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "سَتُغْلَبُونَ", "translit": "َnwُbَlْغُtَs", "root": "غلب"}, {"id": 5, "arabic": "وَتُحْشَرُونَ", "translit": "َnwُrَhsْḥُtَw", "root": "حشر"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 8, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 9, "arabic": "ٱلْمِهَادُ", "translit": "ُdāَhِmْlٱ", "root": "مهد"}], "hasIhya": false}, {"ayah": 13, "text": "قَدْ كَانَ لَكُمْ ءَايَةٌ فِى فِئَتَيْنِ ٱلْتَقَتَاۖ فِئَةٌ تُقَٰتِلُ فِى سَبِيلِ ٱللَّهِ وَأُخْرَىٰ كَافِرَةٌ يَرَوْنَهُم مِّثْلَيْهِمْ رَأْىَ ٱلْعَيْنِۚ وَٱللَّهُ يُؤَيِّدُ بِنَصْرِهِۦ مَن يَشَآءُۗ إِنَّ فِى ذَٰلِكَ لَعِبْرَةً لِّأُو۟لِى ٱلْأَبْصَٰرِ ", "translation": "Already there has been for you a sign in the two armies which met [in combat at Badr] - one fighting in the cause of Allāh and another of disbelievers. They saw them [to be] twice their [own] number by [their] eyesight.[1] But Allāh supports with His victory whom He wills. Indeed in that is a lesson for those of vision.", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "ءَايَةٌ", "translit": "ٌẗَyāَء", "root": "ايي"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "فِئَتَيْنِ", "translit": "ِnْyَtَyʾِf", "root": "فاي"}, {"id": 7, "arabic": "ٱلْتَقَتَا", "translit": "āَtَqَtْlٱ", "root": "لقي"}, {"id": 8, "arabic": "فِئَةٌ", "translit": "ٌẗَyʾِf", "root": "فاي"}, {"id": 9, "arabic": "تُقَٰتِلُ", "translit": "ُlِtَٰqُt", "root": "قتل"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَأُخْرَىٰ", "translit": "ٰàَrْhkُaʾَw", "root": "اخر"}, {"id": 14, "arabic": "كَافِرَةٌ", "translit": "ٌẗَrِfāَk", "root": "كفر"}, {"id": 15, "arabic": "يَرَوْنَهُم", "translit": "mُhَnْwَrَy", "root": "راي"}, {"id": 16, "arabic": "مِّثْلَيْهِمْ", "translit": "ْmِhْyَlْhtِّm", "root": "مثل"}, {"id": 17, "arabic": "رَأْىَ", "translit": "َàْaʾَr", "root": "راي"}, {"id": 18, "arabic": "ٱلْعَيْنِ", "translit": "ِnْyَʿعْlٱ", "root": "عين"}, {"id": 19, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 20, "arabic": "يُؤَيِّدُ", "translit": "ُdِّyَwʾُy", "root": "ايد"}, {"id": 21, "arabic": "بِنَصْرِهِۦ", "translit": "ۦِhِrْṣَnِb", "root": "نصر"}, {"id": 22, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 23, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 26, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 27, "arabic": "لَعِبْرَةً", "translit": "ًẗَrْbِʿعَl", "root": "عبر"}, {"id": 28, "arabic": "لِّأُو۟لِى", "translit": "àِl۟wُaʾِّl", "root": ""}, {"id": 29, "arabic": "ٱلْأَبْصَٰرِ", "translit": "ِrَٰṣْbَaʾْlٱ", "root": "بصر"}], "hasIhya": false}, {"ayah": 14, "text": "زُيِّنَ لِلنَّاسِ حُبُّ ٱلشَّهَوَٰتِ مِنَ ٱلنِّسَآءِ وَٱلْبَنِينَ وَٱلْقَنَٰطِيرِ ٱلْمُقَنطَرَةِ مِنَ ٱلذَّهَبِ وَٱلْفِضَّةِ وَٱلْخَيْلِ ٱلْمُسَوَّمَةِ وَٱلْأَنْعَٰمِ وَٱلْحَرْثِۗ ذَٰلِكَ مَتَٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَٱللَّهُ عِندَهُۥ حُسْنُ ٱلْمَـَٔابِ ", "translation": "Beautified for people is the love of that which they desire - of women and sons, heaped-up sums of gold and silver, fine branded horses, and cattle and tilled land. That is the enjoyment of worldly life, but Allāh has with Him the best return [i.e., Paradise].", "words": [{"id": 1, "arabic": "زُيِّنَ", "translit": "َnِّyُz", "root": "زين"}, {"id": 2, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 3, "arabic": "حُبُّ", "translit": "ُّbُḥ", "root": "حبب"}, {"id": 4, "arabic": "ٱلشَّهَوَٰتِ", "translit": "ِtَٰwَhَّhslٱ", "root": "شهو"}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 7, "arabic": "وَٱلْبَنِينَ", "translit": "َnyِnَbْlٱَw", "root": "بني"}, {"id": 8, "arabic": "وَٱلْقَنَٰطِيرِ", "translit": "ِryِṭَٰnَqْlٱَw", "root": "قنطر"}, {"id": 9, "arabic": "ٱلْمُقَنطَرَةِ", "translit": "ِẗَrَṭnَqُmْlٱ", "root": "قنطر"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلذَّهَبِ", "translit": "ِbَhَّhdlٱ", "root": "ذهب"}, {"id": 12, "arabic": "وَٱلْفِضَّةِ", "translit": "ِẗَّḍِfْlٱَw", "root": "فضض"}, {"id": 13, "arabic": "وَٱلْخَيْلِ", "translit": "ِlْyَhkْlٱَw", "root": "خيل"}, {"id": 14, "arabic": "ٱلْمُسَوَّمَةِ", "translit": "ِẗَmَّwَsُmْlٱ", "root": "سوم"}, {"id": 15, "arabic": "وَٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱَw", "root": "نعم"}, {"id": 16, "arabic": "وَٱلْحَرْثِ", "translit": "ِhtْrَḥْlٱَw", "root": "حرث"}, {"id": 17, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 18, "arabic": "مَتَٰعُ", "translit": "ُʿعَٰtَm", "root": "متع"}, {"id": 19, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 20, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 23, "arabic": "حُسْنُ", "translit": "ُnْsُḥ", "root": "حسن"}, {"id": 24, "arabic": "ٱلْمَـَٔابِ", "translit": "ِbāَٔـَmْlٱ", "root": "اوب"}], "hasIhya": true}, {"ayah": 15, "text": "قُلْ أَؤُنَبِّئُكُم بِخَيْرٍ مِّن ذَٰلِكُمْۚ لِلَّذِينَ ٱتَّقَوْا۟ عِندَ رَبِّهِمْ جَنَّٰتٌ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَا وَأَزْوَٰجٌ مُّطَهَّرَةٌ وَرِضْوَٰنٌ مِّنَ ٱللَّهِۗ وَٱللَّهُ بَصِيرٌۢ بِٱلْعِبَادِ ", "translation": "Say, \"Shall I inform you of [something] better than that? For those who fear Allāh will be gardens in the presence of their Lord beneath which rivers flow, wherein they abide eternally, and purified spouses and approval from Allāh. And Allāh is Seeing [i.e., aware] of [His] servants -", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَؤُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُwʾَaʾ", "root": "نبا"}, {"id": 3, "arabic": "بِخَيْرٍ", "translit": "ٍrْyَhkِb", "root": "خير"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 6, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 7, "arabic": "ٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱ", "root": "وقي"}, {"id": 8, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 9, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 10, "arabic": "جَنَّٰتٌ", "translit": "ٌtَّٰnَjg", "root": "جنن"}, {"id": 11, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 14, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 15, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 16, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 17, "arabic": "وَأَزْوَٰجٌ", "translit": "ٌjgَٰwْzَaʾَw", "root": "زوج"}, {"id": 18, "arabic": "مُّطَهَّرَةٌ", "translit": "ٌẗَrَّhَṭُّm", "root": "طهر"}, {"id": 19, "arabic": "وَرِضْوَٰنٌ", "translit": "ٌnَٰwْḍِrَw", "root": "رضو"}, {"id": 20, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "بَصِيرٌۢ", "translit": "ٌۢryِṣَb", "root": "بصر"}, {"id": 24, "arabic": "بِٱلْعِبَادِ", "translit": "ِdāَbِʿعْlٱِb", "root": "عبد"}], "hasIhya": false}, {"ayah": 16, "text": "ٱلَّذِينَ يَقُولُونَ رَبَّنَآ إِنَّنَآ ءَامَنَّا فَٱغْفِرْ لَنَا ذُنُوبَنَا وَقِنَا عَذَابَ ٱلنَّارِ ", "translation": "Those who say, 'Our Lord, indeed we have believed, so forgive us our sins and protect us from the punishment of the Fire,' \"", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 4, "arabic": "إِنَّنَآ", "translit": "ٓāَnَّnِiʾ", "root": ""}, {"id": 5, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 6, "arabic": "فَٱغْفِرْ", "translit": "ْrِfْغٱَf", "root": "غفر"}, {"id": 7, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 8, "arabic": "ذُنُوبَنَا", "translit": "āَnَbwُnُhd", "root": "ذنب"}, {"id": 9, "arabic": "وَقِنَا", "translit": "āَnِqَw", "root": "وقي"}, {"id": 10, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 11, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 17, "text": "ٱلصَّٰبِرِينَ وَٱلصَّٰدِقِينَ وَٱلْقَٰنِتِينَ وَٱلْمُنفِقِينَ وَٱلْمُسْتَغْفِرِينَ بِٱلْأَسْحَارِ ", "translation": "The patient, the true, the obedient, those who spend [in the way of Allāh], and those who seek forgiveness before dawn.", "words": [{"id": 1, "arabic": "ٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱ", "root": "صبر"}, {"id": 2, "arabic": "وَٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱَw", "root": "صدق"}, {"id": 3, "arabic": "وَٱلْقَٰنِتِينَ", "translit": "َnyِtِnَٰqْlٱَw", "root": "قنت"}, {"id": 4, "arabic": "وَٱلْمُنفِقِينَ", "translit": "َnyِqِfnُmْlٱَw", "root": "نفق"}, {"id": 5, "arabic": "وَٱلْمُسْتَغْفِرِينَ", "translit": "َnyِrِfْغَtْsُmْlٱَw", "root": "غفر"}, {"id": 6, "arabic": "بِٱلْأَسْحَارِ", "translit": "ِrāَḥْsَaʾْlٱِb", "root": "سحر"}], "hasIhya": false}, {"ayah": 18, "text": "شَهِدَ ٱللَّهُ أَنَّهُۥ لَآ إِلَٰهَ إِلَّا هُوَ وَٱلْمَلَٰٓئِكَةُ وَأُو۟لُوا۟ ٱلْعِلْمِ قَآئِمًۢا بِٱلْقِسْطِۚ لَآ إِلَٰهَ إِلَّا هُوَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "Allāh witnesses that there is no deity except Him, and [so do] the angels and those of knowledge - [that He is] maintaining [creation] in justice. There is no deity except Him, the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "شَهِدَ", "translit": "َdِhَhs", "root": "شهد"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "وَٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱَw", "root": "ملك"}, {"id": 9, "arabic": "وَأُو۟لُوا۟", "translit": "۟āwُl۟wُaʾَw", "root": ""}, {"id": 10, "arabic": "ٱلْعِلْمِ", "translit": "ِmْlِʿعْlٱ", "root": "علم"}, {"id": 11, "arabic": "قَآئِمًۢا", "translit": "āًۢmِyʾٓāَq", "root": "قوم"}, {"id": 12, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 13, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 14, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 17, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 18, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": true}, {"ayah": 19, "text": "إِنَّ ٱلدِّينَ عِندَ ٱللَّهِ ٱلْإِسْلَٰمُۗ وَمَا ٱخْتَلَفَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ إِلَّا مِنۢ بَعْدِ مَا جَآءَهُمُ ٱلْعِلْمُ بَغْيًۢا بَيْنَهُمْۗ وَمَن يَكْفُرْ بِـَٔايَٰتِ ٱللَّهِ فَإِنَّ ٱللَّهَ سَرِيعُ ٱلْحِسَابِ ", "translation": "Indeed, the religion in the sight of Allāh is Islām. And those who were given the Scripture did not differ except after knowledge had come to them - out of jealous animosity between themselves. And whoever disbelieves in the verses of Allāh, then indeed, Allāh is swift in [taking] account.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 3, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلْإِسْلَٰمُ", "translit": "ُmَٰlْsِiʾْlٱ", "root": "سلم"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "ٱخْتَلَفَ", "translit": "َfَlَtْhkٱ", "root": "خلف"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 10, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 13, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 16, "arabic": "ٱلْعِلْمُ", "translit": "ُmْlِʿعْlٱ", "root": "علم"}, {"id": 17, "arabic": "بَغْيًۢا", "translit": "āًۢyْغَb", "root": "بغي"}, {"id": 18, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 19, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 20, "arabic": "يَكْفُرْ", "translit": "ْrُfْkَy", "root": "كفر"}, {"id": 21, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 24, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "سَرِيعُ", "translit": "ُʿعyِrَs", "root": "سرع"}, {"id": 26, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": false}, {"ayah": 20, "text": "فَإِنْ حَآجُّوكَ فَقُلْ أَسْلَمْتُ وَجْهِىَ لِلَّهِ وَمَنِ ٱتَّبَعَنِۗ وَقُل لِّلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْأُمِّيِّۦنَ ءَأَسْلَمْتُمْۚ فَإِنْ أَسْلَمُوا۟ فَقَدِ ٱهْتَدَوا۟ۖ وَّإِن تَوَلَّوْا۟ فَإِنَّمَا عَلَيْكَ ٱلْبَلَٰغُۗ وَٱللَّهُ بَصِيرٌۢ بِٱلْعِبَادِ ", "translation": "So if they argue with you, say, \"I have submitted myself to Allāh [in Islām], and [so have] those who follow me.\" And say to those who were given the Scripture and [to] the unlearned,[1] \"Have you submitted yourselves?\" And if they submit [in Islām], they are rightly guided; but if they turn away - then upon you is only the [duty of] notification. And Allāh is Seeing of [His] servants.", "words": [{"id": 1, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 2, "arabic": "حَآجُّوكَ", "translit": "َkwُّjgٓāَḥ", "root": "حجج"}, {"id": 3, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 4, "arabic": "أَسْلَمْتُ", "translit": "ُtْmَlْsَaʾ", "root": "سلم"}, {"id": 5, "arabic": "وَجْهِىَ", "translit": "َàِhْjgَw", "root": "وجه"}, {"id": 6, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 7, "arabic": "وَمَنِ", "translit": "ِnَmَw", "root": ""}, {"id": 8, "arabic": "ٱتَّبَعَنِ", "translit": "ِnَʿعَbَّtٱ", "root": "تبع"}, {"id": 9, "arabic": "وَقُل", "translit": "lُqَw", "root": "قول"}, {"id": 10, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 11, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 12, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 13, "arabic": "وَٱلْأُمِّيِّۦنَ", "translit": "َnۦِّyِّmُaʾْlٱَw", "root": "امم"}, {"id": 14, "arabic": "ءَأَسْلَمْتُمْ", "translit": "ْmُtْmَlْsَaʾَء", "root": "سلم"}, {"id": 15, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 16, "arabic": "أَسْلَمُوا۟", "translit": "۟āwُmَlْsَaʾ", "root": "سلم"}, {"id": 17, "arabic": "فَقَدِ", "translit": "ِdَqَf", "root": ""}, {"id": 18, "arabic": "ٱهْتَدَوا۟", "translit": "۟āwَdَtْhٱ", "root": "هدي"}, {"id": 19, "arabic": "وَّإِن", "translit": "nِiʾَّw", "root": ""}, {"id": 20, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 21, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 22, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 23, "arabic": "ٱلْبَلَٰغُ", "translit": "ُغَٰlَbْlٱ", "root": "بلغ"}, {"id": 24, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 25, "arabic": "بَصِيرٌۢ", "translit": "ٌۢryِṣَb", "root": "بصر"}, {"id": 26, "arabic": "بِٱلْعِبَادِ", "translit": "ِdāَbِʿعْlٱِb", "root": "عبد"}], "hasIhya": false}, {"ayah": 21, "text": "إِنَّ ٱلَّذِينَ يَكْفُرُونَ بِـَٔايَٰتِ ٱللَّهِ وَيَقْتُلُونَ ٱلنَّبِيِّۦنَ بِغَيْرِ حَقٍّ وَيَقْتُلُونَ ٱلَّذِينَ يَأْمُرُونَ بِٱلْقِسْطِ مِنَ ٱلنَّاسِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ ", "translation": "Those who disbelieve in the signs of Allāh and kill the prophets without right and kill those who order justice from among the people - give them tidings of a painful punishment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَكْفُرُونَ", "translit": "َnwُrُfْkَy", "root": "كفر"}, {"id": 4, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَيَقْتُلُونَ", "translit": "َnwُlُtْqَyَw", "root": "قتل"}, {"id": 7, "arabic": "ٱلنَّبِيِّۦنَ", "translit": "َnۦِّyِbَّnlٱ", "root": "نبا"}, {"id": 8, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 9, "arabic": "حَقٍّ", "translit": "ٍّqَḥ", "root": "حقق"}, {"id": 10, "arabic": "وَيَقْتُلُونَ", "translit": "َnwُlُtْqَyَw", "root": "قتل"}, {"id": 11, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "يَأْمُرُونَ", "translit": "َnwُrُmْaʾَy", "root": "امر"}, {"id": 13, "arabic": "بِٱلْقِسْطِ", "translit": "ِṭْsِqْlٱِb", "root": "قسط"}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 16, "arabic": "فَبَشِّرْهُم", "translit": "mُhْrِّhsَbَf", "root": "بشر"}, {"id": 17, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 18, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 22, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ حَبِطَتْ أَعْمَٰلُهُمْ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِ وَمَا لَهُم مِّن نَّٰصِرِينَ ", "translation": "They are the ones whose deeds have become worthless in this world and the Hereafter, and for them there will be no helpers.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "حَبِطَتْ", "translit": "ْtَṭِbَḥ", "root": "حبط"}, {"id": 4, "arabic": "أَعْمَٰلُهُمْ", "translit": "ْmُhُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 7, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "نَّٰصِرِينَ", "translit": "َnyِrِṣَّٰn", "root": "نصر"}], "hasIhya": false}, {"ayah": 23, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ أُوتُوا۟ نَصِيبًا مِّنَ ٱلْكِتَٰبِ يُدْعَوْنَ إِلَىٰ كِتَٰبِ ٱللَّهِ لِيَحْكُمَ بَيْنَهُمْ ثُمَّ يَتَوَلَّىٰ فَرِيقٌ مِّنْهُمْ وَهُم مُّعْرِضُونَ ", "translation": "Do you not consider, [O Muḥammad], those who were given a portion of the Scripture? They are invited to the Scripture of Allāh that it should arbitrate between them;[1] then a party of them turns away, and they are refusing.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 6, "arabic": "نَصِيبًا", "translit": "āًbyِṣَn", "root": "نصب"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 9, "arabic": "يُدْعَوْنَ", "translit": "َnْwَʿعْdُy", "root": "دعو"}, {"id": 10, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 11, "arabic": "كِتَٰبِ", "translit": "ِbَٰtِk", "root": "كتب"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "لِيَحْكُمَ", "translit": "َmُkْḥَyِl", "root": "حكم"}, {"id": 14, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 15, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 16, "arabic": "يَتَوَلَّىٰ", "translit": "ٰàَّlَwَtَy", "root": "ولي"}, {"id": 17, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 18, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 19, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 20, "arabic": "مُّعْرِضُونَ", "translit": "َnwُḍِrْʿعُّm", "root": "عرض"}], "hasIhya": false}, {"ayah": 24, "text": "ذَٰلِكَ بِأَنَّهُمْ قَالُوا۟ لَن تَمَسَّنَا ٱلنَّارُ إِلَّآ أَيَّامًا مَّعْدُودَٰتٍۖ وَغَرَّهُمْ فِى دِينِهِم مَّا كَانُوا۟ يَفْتَرُونَ ", "translation": "That is because they say, \"Never will the Fire touch us except for [a few] numbered days,\" and [because] they were deluded in their religion by what they were inventing.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 3, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 4, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 5, "arabic": "تَمَسَّنَا", "translit": "āَnَّsَmَt", "root": "مسس"}, {"id": 6, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "أَيَّامًا", "translit": "āًmāَّyَaʾ", "root": "يوم"}, {"id": 9, "arabic": "مَّعْدُودَٰتٍ", "translit": "ٍtَٰdwُdْʿعَّm", "root": "عدد"}, {"id": 10, "arabic": "وَغَرَّهُمْ", "translit": "ْmُhَّrَغَw", "root": "غرر"}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "دِينِهِم", "translit": "mِhِnyِd", "root": "دين"}, {"id": 13, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 14, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 15, "arabic": "يَفْتَرُونَ", "translit": "َnwُrَtْfَy", "root": "فري"}], "hasIhya": false}, {"ayah": 25, "text": "فَكَيْفَ إِذَا جَمَعْنَٰهُمْ لِيَوْمٍ لَّا رَيْبَ فِيهِ وَوُفِّيَتْ كُلُّ نَفْسٍ مَّا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ ", "translation": "So how will it be when We assemble them for a Day about which there is no doubt? And each soul will be compensated [in full for] what it earned, and they will not be wronged.", "words": [{"id": 1, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "جَمَعْنَٰهُمْ", "translit": "ْmُhَٰnْʿعَmَjg", "root": "جمع"}, {"id": 4, "arabic": "لِيَوْمٍ", "translit": "ٍmْwَyِl", "root": "يوم"}, {"id": 5, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 6, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَوُفِّيَتْ", "translit": "ْtَyِّfُwَw", "root": "وفي"}, {"id": 9, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 10, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 11, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 12, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 13, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 26, "text": "قُلِ ٱللَّهُمَّ مَٰلِكَ ٱلْمُلْكِ تُؤْتِى ٱلْمُلْكَ مَن تَشَآءُ وَتَنزِعُ ٱلْمُلْكَ مِمَّن تَشَآءُ وَتُعِزُّ مَن تَشَآءُ وَتُذِلُّ مَن تَشَآءُۖ بِيَدِكَ ٱلْخَيْرُۖ إِنَّكَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Say, \"O Allāh, Owner of Sovereignty, You give sovereignty to whom You will and You take sovereignty away from whom You will. You honor whom You will and You humble whom You will. In Your hand[1] is [all] good. Indeed, You are over all things competent.", "words": [{"id": 1, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 2, "arabic": "ٱللَّهُمَّ", "translit": "َّmُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مَٰلِكَ", "translit": "َkِlَٰm", "root": "ملك"}, {"id": 4, "arabic": "ٱلْمُلْكِ", "translit": "ِkْlُmْlٱ", "root": "ملك"}, {"id": 5, "arabic": "تُؤْتِى", "translit": "àِtْwʾُt", "root": "اتي"}, {"id": 6, "arabic": "ٱلْمُلْكَ", "translit": "َkْlُmْlٱ", "root": "ملك"}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 9, "arabic": "وَتَنزِعُ", "translit": "ُʿعِznَtَw", "root": "نزع"}, {"id": 10, "arabic": "ٱلْمُلْكَ", "translit": "َkْlُmْlٱ", "root": "ملك"}, {"id": 11, "arabic": "مِمَّن", "translit": "nَّmِm", "root": ""}, {"id": 12, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 13, "arabic": "وَتُعِزُّ", "translit": "ُّzِʿعُtَw", "root": "عزز"}, {"id": 14, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 15, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 16, "arabic": "وَتُذِلُّ", "translit": "ُّlِhdُtَw", "root": "ذلل"}, {"id": 17, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 18, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 19, "arabic": "بِيَدِكَ", "translit": "َkِdَyِb", "root": "يدي"}, {"id": 20, "arabic": "ٱلْخَيْرُ", "translit": "ُrْyَhkْlٱ", "root": "خير"}, {"id": 21, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 22, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 23, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 24, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 25, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 27, "text": "تُولِجُ ٱلَّيْلَ فِى ٱلنَّهَارِ وَتُولِجُ ٱلنَّهَارَ فِى ٱلَّيْلِۖ وَتُخْرِجُ ٱلْحَىَّ مِنَ ٱلْمَيِّتِ وَتُخْرِجُ ٱلْمَيِّتَ مِنَ ٱلْحَىِّۖ وَتَرْزُقُ مَن تَشَآءُ بِغَيْرِ حِسَابٍ ", "translation": "You cause the night to enter the day, and You cause the day to enter the night; and You bring the living out of the dead, and You bring the dead out of the living. And You give provision to whom You will without account [i.e., limit or measure].\"", "words": [{"id": 1, "arabic": "تُولِجُ", "translit": "ُjgِlwُt", "root": "ولج"}, {"id": 2, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلنَّهَارِ", "translit": "ِrāَhَّnlٱ", "root": "نهر"}, {"id": 5, "arabic": "وَتُولِجُ", "translit": "ُjgِlwُtَw", "root": "ولج"}, {"id": 6, "arabic": "ٱلنَّهَارَ", "translit": "َrāَhَّnlٱ", "root": "نهر"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 9, "arabic": "وَتُخْرِجُ", "translit": "ُjgِrْhkُtَw", "root": "خرج"}, {"id": 10, "arabic": "ٱلْحَىَّ", "translit": "َّàَḥْlٱ", "root": "حيي"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلْمَيِّتِ", "translit": "ِtِّyَmْlٱ", "root": "موت"}, {"id": 13, "arabic": "وَتُخْرِجُ", "translit": "ُjgِrْhkُtَw", "root": "خرج"}, {"id": 14, "arabic": "ٱلْمَيِّتَ", "translit": "َtِّyَmْlٱ", "root": "موت"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلْحَىِّ", "translit": "ِّàَḥْlٱ", "root": "حيي"}, {"id": 17, "arabic": "وَتَرْزُقُ", "translit": "ُqُzْrَtَw", "root": "رزق"}, {"id": 18, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 19, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 20, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 21, "arabic": "حِسَابٍ", "translit": "ٍbāَsِḥ", "root": "حسب"}], "hasIhya": false}, {"ayah": 28, "text": "لَّا يَتَّخِذِ ٱلْمُؤْمِنُونَ ٱلْكَٰفِرِينَ أَوْلِيَآءَ مِن دُونِ ٱلْمُؤْمِنِينَۖ وَمَن يَفْعَلْ ذَٰلِكَ فَلَيْسَ مِنَ ٱللَّهِ فِى شَىْءٍ إِلَّآ أَن تَتَّقُوا۟ مِنْهُمْ تُقَىٰةًۗ وَيُحَذِّرُكُمُ ٱللَّهُ نَفْسَهُۥۗ وَإِلَى ٱللَّهِ ٱلْمَصِيرُ ", "translation": "Let not believers take disbelievers as allies [i.e., supporters or protectors] rather than believers. And whoever [of you] does that has nothing [i.e., no association] with Allāh, except when taking precaution against them in prudence.[1] And Allāh warns you of Himself, and to Allāh is the [final] destination.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "يَتَّخِذِ", "translit": "ِhdِhkَّtَy", "root": "اخذ"}, {"id": 3, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}, {"id": 4, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 5, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 8, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "يَفْعَلْ", "translit": "ْlَʿعْfَy", "root": "فعل"}, {"id": 11, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 12, "arabic": "فَلَيْسَ", "translit": "َsْyَlَf", "root": "ليس"}, {"id": 13, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 17, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "تَتَّقُوا۟", "translit": "۟āwُqَّtَt", "root": "وقي"}, {"id": 20, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 21, "arabic": "تُقَىٰةً", "translit": "ًẗٰàَqُt", "root": "وقي"}, {"id": 22, "arabic": "وَيُحَذِّرُكُمُ", "translit": "ُmُkُrِّhdَḥُyَw", "root": "حذر"}, {"id": 23, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "نَفْسَهُۥ", "translit": "ۥُhَsْfَn", "root": "نفس"}, {"id": 25, "arabic": "وَإِلَى", "translit": "àَlِiʾَw", "root": ""}, {"id": 26, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 29, "text": "قُلْ إِن تُخْفُوا۟ مَا فِى صُدُورِكُمْ أَوْ تُبْدُوهُ يَعْلَمْهُ ٱللَّهُۗ وَيَعْلَمُ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۗ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Say, \"Whether you conceal what is in your breasts or reveal it, Allāh knows it. And He knows that which is in the heavens and that which is on the earth. And Allāh is over all things competent.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "تُخْفُوا۟", "translit": "۟āwُfْhkُt", "root": "خفي"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "صُدُورِكُمْ", "translit": "ْmُkِrwُdُṣ", "root": "صدر"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "تُبْدُوهُ", "translit": "ُhwُdْbُt", "root": "بدو"}, {"id": 9, "arabic": "يَعْلَمْهُ", "translit": "ُhْmَlْʿعَy", "root": "علم"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَيَعْلَمُ", "translit": "ُmَlْʿعَyَw", "root": "علم"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 15, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 18, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 19, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 20, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 21, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 22, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 30, "text": "يَوْمَ تَجِدُ كُلُّ نَفْسٍ مَّا عَمِلَتْ مِنْ خَيْرٍ مُّحْضَرًا وَمَا عَمِلَتْ مِن سُوٓءٍ تَوَدُّ لَوْ أَنَّ بَيْنَهَا وَبَيْنَهُۥٓ أَمَدًۢا بَعِيدًاۗ وَيُحَذِّرُكُمُ ٱللَّهُ نَفْسَهُۥۗ وَٱللَّهُ رَءُوفٌۢ بِٱلْعِبَادِ ", "translation": "The Day every soul will find what it has done of good present [before it] and what it has done of evil, it will wish that between itself and that [evil] was a great distance. And Allāh warns you of Himself, and Allāh is Kind to [His] servants.\"", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تَجِدُ", "tran