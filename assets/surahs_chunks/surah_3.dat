ranslit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُمْتَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 3, "ayah": 61, "text": "فَمَنْ حَآجَّكَ فِيهِ مِنۢ بَعْدِ مَا جَآءَكَ مِنَ اَ۬لْعِلْمِ فَقُلْ تَعَالَوْاْ نَدْعُ أَبْنَآءَنَا وَأَبْنَآءَكُمْ وَنِسَآءَنَا وَنِسَآءَكُمْ وَأَنفُسَنَا وَأَنفُسَكُمْ ثُمَّ نَبْتَهِلْ فنَجْعَل لَّعْنَتَ اَ۬للَّهِ عَلَي اَ۬لْكَٰذِبِينَۖ", "words": [{"id": 1, "arabic": "فَمَنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "حَآجَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "جَآءَكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْعِلْمِ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَقُلْ", "translit": "", "root": ""}, {"id": 11, "arabic": "تَعَالَوْاْ", "translit": "", "root": ""}, {"id": 12, "arabic": "نَدْعُ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَبْنَآءَنَا", "translit": "", "root": ""}, {"id": 14, "arabic": "وَأَبْنَآءَكُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَنِسَآءَنَا", "translit": "", "root": ""}, {"id": 16, "arabic": "وَنِسَآءَكُمْ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَأَنفُسَنَا", "translit": "", "root": ""}, {"id": 18, "arabic": "وَأَنفُسَكُمْ", "translit": "", "root": ""}, {"id": 19, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 20, "arabic": "نَبْتَهِلْ", "translit": "", "root": ""}, {"id": 21, "arabic": "فنَجْعَل", "translit": "", "root": ""}, {"id": 22, "arabic": "لَّعْنَتَ", "translit": "", "root": ""}, {"id": 23, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 24, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 25, "arabic": "اَ۬لْ