 {"surah": 49, "ayah": 14, "text": "۞قَالَتِ اِ۬لَاعْرَابُ ءَامَنَّا قُل لَّمْ تُومِنُواْ وَلَٰكِن قُولُوٓاْ أَسْلَمْنَا وَلَمَّا يَدْخُلِ اِ۬لِايمَٰنُ فِے قُلُوبِكُمْۖ وَإِن تُطِيعُواْ اُ۬للَّهَ وَرَسُولَهُۥ لَا يَلِتْكُم مِّنَ اَعْمَٰلِكُمْ شَئْاًۖ اِنَّ اَ۬للَّهَ غَفُورࣱ رَّحِيمٌۖ", "words": [{"id": 1, "arabic": "۞قَالَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لَاعْرَابُ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "قُل", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تُومِنُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "", "root": ""}, {"id": 8, "arabic": "قُولُوٓاْ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَسْلَمْنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "وَلَمَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "يَدْخُلِ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬لِايمَٰنُ", "translit": "", "root": ""}, {"id": 13, "arabic": "فِے", "translit": "", "root": ""}, {"id": 14, "arabic": "قُلُوبِكُمْۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَإِن", "translit": "", "root": ""}, {"id": 16, "arabic": "تُطِيعُواْ", "translit": "", "root": ""}, {"id": 17, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَرَسُولَهُۥ", "translit": "", "root": ""}, {"id": 19, "arabic": "لَا", "translit": "", "root": ""}, {"id": 20, "arabic": "يَلِتْكُم", "translit": "", "root": ""}, {"id": 21, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 22, "arabic": "اَعْمَٰلِكُمْ", "translit": "", "root": ""}, {"id": 23, "arabic": "شَئْاًۖ", "translit": "", "root": ""}, {"id": 24, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 25, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 26, "arabic": "غَفُورࣱ", "translit": "", "root": ""}, {"id": 27, "arabic": "رَّحِيمٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"