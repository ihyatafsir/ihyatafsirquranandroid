{"surah": 81, "verses": [{"ayah": 1, "text": "إِذَا ٱلشَّمْسُ كُوِّرَتْ ", "translation": "When the sun is wrapped up [in darkness]", "words": [{"id": 1, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلشَّمْسُ", "translit": "ُsْmَّhslٱ", "root": "شمس"}, {"id": 3, "arabic": "كُوِّرَتْ", "translit": "ْtَrِّwُk", "root": "كور"}], "hasIhya": false}, {"ayah": 2, "text": "وَإِذَا ٱلنُّجُومُ ٱنكَدَرَتْ ", "translation": "And when the stars fall, dispersing,", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلنُّجُومُ", "translit": "ُmwُjgُّnlٱ", "root": "نجم"}, {"id": 3, "arabic": "ٱنكَدَرَتْ", "translit": "ْtَrَdَknٱ", "root": "كدر"}], "hasIhya": false}, {"ayah": 3, "text": "وَإِذَا ٱلْجِبَالُ سُيِّرَتْ ", "translation": "And when the mountains are removed", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْجِبَالُ", "translit": "ُlāَbِjgْlٱ", "root": "جبل"}, {"id": 3, "arabic": "سُيِّرَتْ", "translit": "ْtَrِّyُs", "root": "سير"}], "hasIhya": false}, {"ayah": 4, "text": "وَإِذَا ٱلْعِشَارُ عُطِّلَتْ ", "translation": "And when full-term she-camels[1] are neglected", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْعِشَارُ", "translit": "ُrāَhsِʿعْlٱ", "root": "عشر"}, {"id": 3, "arabic": "عُطِّلَتْ", "translit": "ْtَlِّṭُʿع", "root": "عطل"}], "hasIhya": false}, {"ayah": 5, "text": "وَإِذَا ٱلْوُحُوشُ حُشِرَتْ ", "translation": "And when the wild beasts are gathered", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْوُحُوشُ", "translit": "ُhswُḥُwْlٱ", "root": "وحش"}, {"id": 3, "arabic": "حُشِرَتْ", "translit": "ْtَrِhsُḥ", "root": "حشر"}], "hasIhya": false}, {"ayah": 6, "text": "وَإِذَا ٱلْبِحَارُ سُجِّرَتْ ", "translation": "And when the seas are filled with flame[1]", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْبِحَارُ", "translit": "ُrāَḥِbْlٱ", "root": "بحر"}, {"id": 3, "arabic": "سُجِّرَتْ", "translit": "ْtَrِّjgُs", "root": "سجر"}], "hasIhya": false}, {"ayah": 7, "text": "وَإِذَا ٱلنُّفُوسُ زُوِّجَتْ ", "translation": "And when the souls are paired[1]", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلنُّفُوسُ", "translit": "ُswُfُّnlٱ", "root": "نفس"}, {"id": 3, "arabic": "زُوِّجَتْ", "translit": "ْtَjgِّwُz", "root": "زوج"}], "hasIhya": false}, {"ayah": 8, "text": "وَإِذَا ٱلْمَوْءُۥدَةُ سُئِلَتْ ", "translation": "And when the girl [who was] buried alive is asked", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْمَوْءُۥدَةُ", "translit": "ُẗَdۥُءْwَmْlٱ", "root": "واد"}, {"id": 3, "arabic": "سُئِلَتْ", "translit": "ْtَlِyʾُs", "root": "سال"}], "hasIhya": false}, {"ayah": 9, "text": "بِأَىِّ ذَنۢبٍ قُتِلَتْ ", "translation": "For what sin she was killed", "words": [{"id": 1, "arabic": "بِأَىِّ", "translit": "ِّàَaʾِb", "root": "ايي"}, {"id": 2, "arabic": "ذَنۢبٍ", "translit": "ٍbۢnَhd", "root": "ذنب"}, {"id": 3, "arabic": "قُتِلَتْ", "translit": "ْtَlِtُq", "root": "قتل"}], "hasIhya": false}, {"ayah": 10, "text": "وَإِذَا ٱلصُّحُفُ نُشِرَتْ ", "translation": "And when the pages[1] are spread [i.e., made public]", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلصُّحُفُ", "translit": "ُfُḥُّṣlٱ", "root": "صحف"}, {"id": 3, "arabic": "نُشِرَتْ", "translit": "ْtَrِhsُn", "root": "نشر"}], "hasIhya": false}, {"ayah": 11, "text": "وَإِذَا ٱلسَّمَآءُ كُشِطَتْ ", "translation": "And when the sky is stripped away", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلسَّمَآءُ", "translit": "ُءٓāَmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "كُشِطَتْ", "translit": "ْtَṭِhsُk", "root": "كشط"}], "hasIhya": false}, {"ayah": 12, "text": "وَإِذَا ٱلْجَحِيمُ سُعِّرَتْ ", "translation": "And when Hellfire is set ablaze", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْجَحِيمُ", "translit": "ُmyِḥَjgْlٱ", "root": "جحم"}, {"id": 3, "arabic": "سُعِّرَتْ", "translit": "ْtَrِّʿعُs", "root": "سعر"}], "hasIhya": true}, {"ayah": 13, "text": "وَإِذَا ٱلْجَنَّةُ أُزْلِفَتْ ", "translation": "And when Paradise is brought near,", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْجَنَّةُ", "translit": "ُẗَّnَjgْlٱ", "root": "جنن"}, {"id": 3, "arabic": "أُزْلِفَتْ", "translit": "ْtَfِlْzُaʾ", "root": "زلف"}], "hasIhya": false}, {"ayah": 14, "text": "عَلِمَتْ نَفْسٌ مَّآ أَحْضَرَتْ ", "translation": "A soul will [then] know what it has brought [with it].[1]", "words": [{"id": 1, "arabic": "عَلِمَتْ", "translit": "ْtَmِlَʿع", "root": "علم"}, {"id": 2, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 3, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 4, "arabic": "أَحْضَرَتْ", "translit": "ْtَrَḍْḥَaʾ", "root": "حضر"}], "hasIhya": false}, {"ayah": 15, "text": "فَلَآ أُقْسِمُ بِٱلْخُنَّسِ ", "translation": "So I swear by the retreating stars -", "words": [{"id": 1, "arabic": "فَلَآ", "translit": "ٓāَlَf", "root": ""}, {"id": 2, "arabic": "أُقْسِمُ", "translit": "ُmِsْqُaʾ", "root": "قسم"}, {"id": 3, "arabic": "بِٱلْخُنَّسِ", "translit": "ِsَّnُhkْlٱِb", "root": "خنس"}], "hasIhya": true}, {"ayah": 16, "text": "ٱلْجَوَارِ ٱلْكُنَّسِ ", "translation": "Those that run [their courses] and disappear [i.e., set]", "words": [{"id": 1, "arabic": "ٱلْجَوَارِ", "translit": "ِrāَwَjgْlٱ", "root": "جري"}, {"id": 2, "arabic": "ٱلْكُنَّسِ", "translit": "ِsَّnُkْlٱ", "root": "كنس"}], "hasIhya": false}, {"ayah": 17, "text": "وَٱلَّيْلِ إِذَا عَسْعَسَ ", "translation": "And by the night as it closes in[1]", "words": [{"id": 1, "arabic": "وَٱلَّيْلِ", "translit": "ِlْyَّlٱَw", "root": "ليل"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "عَسْعَسَ", "translit": "َsَʿعْsَʿع", "root": "عسعس"}], "hasIhya": false}, {"ayah": 18, "text": "وَٱلصُّبْحِ إِذَا تَنَفَّسَ ", "translation": "And by the dawn when it breathes [i.e., stirs]", "words": [{"id": 1, "arabic": "وَٱلصُّبْحِ", "translit": "ِḥْbُّṣlٱَw", "root": "صبح"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "تَنَفَّسَ", "translit": "َsَّfَnَt", "root": "نفس"}], "hasIhya": false}, {"ayah": 19, "text": "إِنَّهُۥ لَقَوْلُ رَسُولٍ كَرِيمٍ ", "translation": "[That] indeed, it [i.e., the Qur’ān] is a word [conveyed by] a noble messenger [i.e., Gabriel]", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَقَوْلُ", "translit": "ُlْwَqَl", "root": "قول"}, {"id": 3, "arabic": "رَسُولٍ", "translit": "ٍlwُsَr", "root": "رسل"}, {"id": 4, "arabic": "كَرِيمٍ", "translit": "ٍmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 20, "text": "ذِى قُوَّةٍ عِندَ ذِى ٱلْعَرْشِ مَكِينٍ ", "translation": "[Who is] possessed of power and with the Owner of the Throne, secure [in position],", "words": [{"id": 1, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 2, "arabic": "قُوَّةٍ", "translit": "ٍẗَّwُq", "root": "قوي"}, {"id": 3, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 4, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 5, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 6, "arabic": "مَكِينٍ", "translit": "ٍnyِkَm", "root": "مكن"}], "hasIhya": false}, {"ayah": 21, "text": "مُّطَاعٍ ثَمَّ أَمِينٍ ", "translation": "Obeyed there [in the heavens] and trustworthy.", "words": [{"id": 1, "arabic": "مُّطَاعٍ", "translit": "ٍʿعāَṭُّm", "root": "طوع"}, {"id": 2, "arabic": "ثَمَّ", "translit": "َّmَht", "root": ""}, {"id": 3, "arabic": "أَمِينٍ", "translit": "ٍnyِmَaʾ", "root": "امن"}], "hasIhya": false}, {"ayah": 22, "text": "وَمَا صَاحِبُكُم بِمَجْنُونٍ ", "translation": "And your companion [i.e., Prophet Muḥammad (ﷺ) ] is not [at all] mad.[1]", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "صَاحِبُكُم", "translit": "mُkُbِḥāَṣ", "root": "صحب"}, {"id": 3, "arabic": "بِمَجْنُونٍ", "translit": "ٍnwُnْjgَmِb", "root": "جنن"}], "hasIhya": false}, {"ayah": 23, "text": "وَلَقَدْ رَءَاهُ بِٱلْأُفُقِ ٱلْمُبِينِ ", "translation": "And he has already seen him [i.e., Gabriel] in the clear horizon.[1]", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "رَءَاهُ", "translit": "ُhāَءَr", "root": "راي"}, {"id": 3, "arabic": "بِٱلْأُفُقِ", "translit": "ِqُfُaʾْlٱِb", "root": "افق"}, {"id": 4, "arabic": "ٱلْمُبِينِ", "translit": "ِnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 24, "text": "وَمَا هُوَ عَلَى ٱلْغَيْبِ بِضَنِينٍ ", "translation": "And he [i.e., Muḥammad (ﷺ)] is not a withholder of [knowledge of] the unseen.[1]", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْغَيْبِ", "translit": "ِbْyَغْlٱ", "root": "غيب"}, {"id": 5, "arabic": "بِضَنِينٍ", "translit": "ٍnyِnَḍِb", "root": "ضنن"}], "hasIhya": false}, {"ayah": 25, "text": "وَمَا هُوَ بِقَوْلِ شَيْطَٰنٍ رَّجِيمٍ ", "translation": "And it [i.e., the Qur’ān] is not the word of a devil, expelled [from the heavens].", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "بِقَوْلِ", "translit": "ِlْwَqِb", "root": "قول"}, {"id": 4, "arabic": "شَيْطَٰنٍ", "translit": "ٍnَٰṭْyَhs", "root": "شطن"}, {"id": 5, "arabic": "رَّجِيمٍ", "translit": "ٍmyِjgَّr", "root": "رجم"}], "hasIhya": false}, {"ayah": 26, "text": "فَأَيْنَ تَذْهَبُونَ ", "translation": "So where are you going?[1]", "words": [{"id": 1, "arabic": "فَأَيْنَ", "translit": "َnْyَaʾَf", "root": ""}, {"id": 2, "arabic": "تَذْهَبُونَ", "translit": "َnwُbَhْhdَt", "root": "ذهب"}], "hasIhya": false}, {"ayah": 27, "text": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ ", "translation": "It is not except a reminder to the worlds", "words": [{"id": 1, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ذِكْرٌ", "translit": "ٌrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "لِّلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlِّl", "root": "علم"}], "hasIhya": false}, {"ayah": 28, "text": "لِمَن شَآءَ مِنكُمْ أَن يَسْتَقِيمَ ", "translation": "For whoever wills among you to take a right course.", "words": [{"id": 1, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَسْتَقِيمَ", "translit": "َmyِqَtْsَy", "root": "قوم"}], "hasIhya": false}, {"ayah": 29, "text": "وَمَا تَشَآءُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ ", "translation": "And you do not will except that Allāh wills - Lord of the worlds.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "تَشَآءُونَ", "translit": "َnwُءٓāَhsَt", "root": "شيا"}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَشَآءَ", "translit": "َءٓāَhsَy", "root": "شيا"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 8, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}], "tafsir": {"15": [{"arabic": "تلاها وكقوله تعالى فلا أقسم بالخنس الجوار الكنس وقوله تعالى والنجم إذا هوى فلا أقسم بمواقع النجوم وإنه لقسم لو تعلمون عظيم فقد علمت أن عجائب النطفة القذرة عجز عن معرفتها الأولون والآخرون وما أقسم الله بها فما ظنك بما أقسم الله تعالى به وأحال الأرزاق عليه وأضافها إليه فقال تعالى وفي السماء رزقكم وما توعدون وأثنى على المفكرين فيه فقال ويتفكرون في خلق السموات والأرض وقال رسول الله صلى الله عليه وسلم ويل لمن قرأ هذه الآية ثم مسح بها سبلته (1) أى تجاوزها من غير فكر وذم المعرضين عنها فقال وجعلنا السماء", "english": "I say — and of the heaven with its woven structure, and the heaven and what built it; and His saying, may He be exalted: {«And the sun and its morning brightness, and the moon when it follows it»} (Q 91:1-2); and His saying, may He be exalted: {«Nay, I swear by the slinking stars, the runners, the sinkers»} (Q 81:15-16); and His saying, may He be exalted: {«And the star when it falls — nay, I swear by the positions of the stars, and verily it is a mighty oath, if you but knew»} (Q 56:75-76). You have thus come to know that the wonders of the filthy drop of semen — the first and last generations have fallen short of comprehending them. So if God swore by such things, what is your assumption concerning that by which God, may He be exalted, swore, and upon which He made provisions dependent, and to which He annexed them, saying, may He be exalted: {«And in the heaven is your provision and that which you are promised»} (Q 51:22)? And He praised those who reflect upon it, saying: {«And they reflect upon the creation of the heavens and the earth»} (Q 3:191). And the Messenger of God, may God's peace and blessing be upon him, said: \"Woe to him who recites this verse and then wipes his moustache with it\" — that is, passes over it without reflection. And He censured those who turn away from it, saying: {«And We made the heaven a protected roof, yet from its signs they turn away»} (Q 21:32). So what comparison is there between all the seas and the earth, on the one hand, and the heaven, on the other — given that the former are subject to rapid changes, while the heavens are solid, mighty, and preserved from change until the Book reaches its appointed term? For this reason God, may He be exalted, called it \"protected,\" saying: {«And We made the heaven a protected roof»} (Q 21:32); and He said, glory be to Him: {«And We built above you seven mighty ones»} (Q 78:12); and He said: {«Are you stronger in creation or the heaven? He built it, He raised high its roof and fashioned it»} (Q 79:27-28).", "book_title": "Contemplation", "section_title_ar": "Section 1278", "section_title_en": "On Contemplating the Kingdom of the Heavens (التفكر في ملكوت السموات)", "section_index": 1278, "anchors": "- Root: م ل ك (malaka)\n  * Lisan / Ayn: الملك: القوة على التصرف، والملكوت: زيادة الميم للمبالغة كالرهبوت والرحموت\n  * Al-Raghib (Mufradat): الملكوت: عالم الغيب الذي لا تدركه الحواس، والملك: عالم الشهادة المحسوس\n  * Al-Zamakhshari (Asas): الملكوت مجاز عن باطن الملك وسرّه، لا عن ظاهره المحسوس\n- Root: س م و (sama)\n  * Lisan / Ayn: السماء: كل ما علاك فأظلك، وأصلها السمو بمعنى الارتفاع\n  * Al-Raghib (Mufradat): السماء: الجرم المقابل للأرض، وتستعمل بمعنى العلو والملكوت الأعلى\n  * Al-Zamakhshari (Asas): \"سقفا محفوظا\" حقيقة في الحفظ عن التغير والاضمحلال\n- Root: غ ي ب (ghayb)\n  * Al-Raghib (Mufradat): الغيب: ما استتر عن الحواس، ويقال للشيء غيب باعتباره بالناس لا بالله تعالى، فإنه لا يغيب عنه شيء\n  * Al-Zamakhshari (Asas): الغيب والملكوت مترادفان في اصطلاح القرآن لما غاب عن الأبصار\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره لمراعاة البلاغة والمقام", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "29": [{"arabic": "ولا تقولن لشيء إني فاعل ذلك غدا إلا أن يشاء الله ثم لم يقتصر على ذلك فيما لا يشك فيه بل قال تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رءؤسكم ومقصرين وكان الله سبحانه عالما بأنهم يدخلون لا محالة وأنه شاءه ولكن المقصود تعليمه ذلك فتأدب رسول الله صلى الله عليه وسلم في ما كان يخبر عنه معلوما كان أو مشكوكا حتى قال صلى الله عليه وسلم لما دخل المقابر السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون (1) واللحوق بهم غير مشكوك فيه ولكن مقتضى الأدب ذكر الله تعالى وربط الأمور به وهذه الصيغ", "english": "If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 102", "section_title_en": "On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102", "section_index": 102, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 510, 1386], [2, 1386, 2358], [3, 2358, 3620]], "81:1": [[1, 510, 1386], [2, 1386, 2358], [3, 2358, 3620]], "2": [[1, 180, 1839], [2, 1839, 3621], [3, 3621, 4820]], "81:2": [[1, 180, 1839], [2, 1839, 3621], [3, 3621, 4820]], "3": [[1, 500, 1708], [2, 1708, 2859], [3, 2859, 4050]], "81:3": [[1, 500, 1708], [2, 1708, 2859], [3, 2859, 4050]], "4": [[1, 120, 1506], [2, 1506, 2911], [3, 2911, 3930]], "81:4": [[1, 120, 1506], [2, 1506, 2911], [3, 2911, 3930]], "5": [[1, 350, 1591], [2, 1591, 3008], [3, 3008, 3730]], "81:5": [[1, 350, 1591], [2, 1591, 3008], [3, 3008, 3730]], "6": [[1, 230, 1721], [2, 1721, 3162], [3, 3162, 4140]], "81:6": [[1, 230, 1721], [2, 1721, 3162], [3, 3162, 4140]], "7": [[1, 490, 1885], [2, 1885, 3403], [3, 3403, 4760]], "81:7": [[1, 490, 1885], [2, 1885, 3403], [3, 3403, 4760]], "8": [[1, 410, 2019], [2, 2019, 3443], [3, 3443, 4400]], "81:8": [[1, 410, 2019], [2, 2019, 3443], [3, 3443, 4400]], "9": [[1, 200, 2265], [2, 2265, 3545], [3, 3545, 5280]], "81:9": [[1, 200, 2265], [2, 2265, 3545], [3, 3545, 5280]], "10": [[1, 450, 1850], [2, 1850, 2916], [3, 2916, 3710]], "81:10": [[1, 450, 1850], [2, 1850, 2916], [3, 2916, 3710]], "11": [[1, 300, 1675], [2, 1675, 4123], [3, 4123, 4950]], "81:11": [[1, 300, 1675], [2, 1675, 4123], [3, 4123, 4950]], "12": [[1, 580, 2031], [2, 2031, 3374], [3, 3374, 4410]], "81:12": [[1, 580, 2031], [2, 2031, 3374], [3, 3374, 4410]], "13": [[1, 310, 2107], [2, 2107, 3406], [3, 3406, 4670]], "81:13": [[1, 310, 2107], [2, 2107, 3406], [3, 3406, 4670]], "14": [[1, 360, 1503], [2, 1503, 2337], [3, 2337, 5107], [4, 5107, 6600]], "81:14": [[1, 360, 1503], [2, 1503, 2337], [3, 2337, 5107], [4, 5107, 6600]], "15": [[1, 610, 3144], [2, 3144, 4363], [3, 4363, 6070]], "81:15": [[1, 610, 3144], [2, 3144, 4363], [3, 4363, 6070]], "16": [[1, 340, 2599], [2, 2599, 4110]], "81:16": [[1, 340, 2599], [2, 2599, 4110]], "17": [[1, 240, 1787], [2, 1787, 2876], [3, 2876, 3900]], "81:17": [[1, 240, 1787], [2, 1787, 2876], [3, 2876, 3900]], "18": [[1, 40, 1929], [2, 1929, 3062], [3, 3062, 4160]]