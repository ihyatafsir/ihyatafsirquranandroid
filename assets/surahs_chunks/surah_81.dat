,10163],[6,10163,11000],[7,11000,11576],[8,11576,13460]]},"abdulbasit_warsh":{"81:1":[[1,400,1080],[2,1160,1955],[3,2035,2715]],"81:2":[[1,400,1195],[2,1275,2185],[3,2265,3175]],"81:3":[[1,400,1195],[2,1275,2185],[3,2265,2945]],"81:4":[[1,400,1195],[2,1275,2185],[3,2265,2945]],"81:5":[[1,400,1195],[2,1275,2185],[3,2265,2945]],"81:6":[[1,400,1195],[2,1275,2185],[3,2265,2945]],"81:7":[[1,400,1195],[2,1275,2185],[3,2265,2945]],"81:8":[[1,400,1195],[2,1275,2415],[3,2495,3290]],"81:9":[[1,400,1080],[2,1160,1840],[3,1920,2600]],"81:10":[[1,400,1195],[2,1275,2070],[3,2150,2830]],"81:11":[[1,400,1195],[2,1275,2185],[3,2265,2945]],"81:12":[[1,400,1195],[2,1275,2185],[3,2265,2945]],"81:13":[[1,400,1195],[2,1275,2070],[3,2150,3060]],"81:14":[[1,400,1080],[2,1160,1725],[3,1805,2255],[4,2335,3245]],"81:15":[[1,400,965],[2,1045,1840],[3,1920,2830]],"81:16":[[1,400,1310],[2,1390,2185]],"81:17":[[1,400,1195],[2,1275,1955],[3,2035,2715]],"81:18":[[1,400,1310],[2,1390,2070],[3,2150,2830]],"81:19":[[1,400,1195],[2,1275,1955],[3,2035,2715],[4,2795,3475]],"81:20":[[1,400,850],[2,930,1495],[3,1575,2140],[4,2220,2670],[5,2750,3545],[6,3625,4305]],"81:21":[[1,400,1080],[2,1160,1610],[3,1690,2485]],"81:22":[[1,400,965],[2,1045,1840],[3,1920,2830]],"81:23":[[1,400,1080],[2,1160,1840],[3,1920,2830],[4,2910,3820]],"81:24":[[1,400,965],[2,1045,1495],[3,1575,2140],[4,2220,3015],[5,3095,3890]],"81:25":[[1,400,965],[2,1045,1495],[3,1575,2255],[4,2335,3015],[5,3095,3775]],"81:26":[[1,400,1195],[2,1275,2185]],"81:27":[[1,400,965],[2,1045,1495],[3,1575,2255],[4,2335,2900],[5,2980,4005]],"81:28":[[1,400,965],[2,1045,1610],[3,1690,2485],[4,2565,3130],[5,3210,4120]],"81:29":[[1,400,965],[2,1045,1955],[3,2035,2715],[4,2795,3360],[5,3440,4120],[6,4200,4880],[7,4960,5410],[8,5490,6515]]}},"letterTiming":{"abdulbasit":{"81:1":[{"wordIdx":0,"charIdx":0,"char":"إ","grapheme":"إِ","start":250,"end":486,"duration":236,"peakTime":368},{"wordIdx":0,"charIdx":1,"char":"ذ","grapheme":"ذَ","start":486,"end":703,"dur