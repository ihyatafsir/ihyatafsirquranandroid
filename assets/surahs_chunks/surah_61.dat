: 360, "peakTime": 63288, "confidence": 0.99}]}}, "warshVerses": [{"surah": 61, "ayah": 1, "text": "سَبَّحَ لِلهِ مَا فِے اِ۬لسَّمَٰوَٰتِ وَمَا فِے اِ۬لَارْضِۖ وَهُوَ اَ۬لْعَزِيزُ اُ۬لْحَكِيمُۖ", "words": [{"id": 1, "arabic": "سَبَّحَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لَارْضِۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْحَكِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 61, "ayah": 2, "text": "يَٰٓأَيُّهَا اَ۬لذِينَ ءَامَنُواْ لِمَ تَقُولُونَ مَا لَا تَفْعَلُونَۖ", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقُولُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَفْعَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 61, "ayah": 3, "text": "كَبُرَ مَقْتاً عِندَ اَ۬للَّهِ أَن تَقُولُواْ مَا لَا تَفْعَلُونَۖ", "words": [{"id": 1, "arabic": "كَبُرَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَقْتاً", "translit": "", "root": ""}, {"id": 3, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَقُولُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "", "root": ""}, {"id": 9, "arabic": "تَفْعَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 61, "ayah": 4, "text": "إِنَّ اَ۬للَّهَ يُحِبُّ اُ۬لذِينَ يُقَٰتِلُونَ فِے سَبِيلِهِۦ صَفّاࣰ كَأَنَّهُم بُنْيَٰنࣱ مَّرْصُوصࣱۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُحِبُّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُقَٰتِلُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "سَبِيلِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "صَفّاࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَأَنَّهُم", "translit": "", "root": ""}, {"id": 10, "arabic": "بُنْيَٰنࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "مَّرْصُوصࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 61, "ayah": 5, "text": "وَإِذْ قَالَ مُوس۪يٰ لِقَوْمِهِۦ يَٰقَوْمِ لِمَ تُوذُونَنِے وَقَد تَّعْلَمُونَ أَنِّے رَسُولُ اُ۬للَّهِ إِلَيْكُمْۖ فَلَمَّا زَاغُوٓاْ أَزَاغَ اَ۬للَّهُ قُلُوبَهُمْۖ وَاللَّهُ لَا يَهْدِے اِ۬لْقَوْمَ اَ۬لْفَٰسِقِينَۖ", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِقَوْمِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِمَ", "translit": "", "root": ""}, {"id": 7, "arabic": "تُوذُونَنِے", "translit": "", "root": ""}, {"id": 8, "arabic": "وَقَد", "translit": "", "root": ""}, {"id": 9, "arabic": "تَّعْلَمُونَ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَنِّے", "translit": "", "root": ""}, {"id": 11, "arabic": "رَسُولُ", "translit": "", "root": ""}, {"id": 12