ّ", "translit": "", "root": ""}, {"id": 16, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬لتَّوْر۪يٰةِ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَمُبَشِّراَۢ", "translit": "", "root": ""}, {"id": 19, "arabic": "بِرَسُولࣲ", "translit": "", "root": ""}, {"id": 20, "arabic": "يَاتِے", "translit": "", "root": ""}, {"id": 21, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 22, "arabic": "بَعْدِيَ", "translit": "", "root": ""}, {"id": 23, "arabic": "اَ۪سْمُهُۥٓ", "translit": "", "root": ""}, {"id": 24, "arabic": "أَحْمَدُۖ", "translit": "", "root": ""}, {"id": 25, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 26, "arabic": "جَآءَهُم", "translit": "", "root": ""}, {"id": 27, "arabic": "بِالْبَيِّنَٰتِ", "translit": "", "root": ""}, {"id": 28, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 29, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 30, "arabic": "سِحْرࣱ", "translit": "", "root": ""}, {"id": 31, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 61, "ayah": 7, "text": "وَمَنَ اَظْلَمُ مِمَّنِ اِ۪فْتَر۪يٰ عَلَي اَ۬للَّهِ اِ۬لْكَذِبَ وَهُوَ يُدْع۪يٰٓ إِلَي اَ۬لِاسْلَٰمِۖ وَاللَّهُ لَا يَهْدِے اِ۬لْقَوْمَ اَ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "وَمَنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَظْلَمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِمَّنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۪فْتَر۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْكَذِبَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُدْع۪يٰٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لِاسْلَٰمِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَاللَّهُ", "translit": "", "root": ""}