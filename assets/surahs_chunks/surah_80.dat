{"surah":80,"verses":[{"ayah":1,"text":"عَبَسَ وَتَوَلَّىٰٓ ","translation":"He [i.e., the Prophet (ﷺ) ] frowned and turned away","words":[{"id":1,"arabic":"عَبَسَ","translit":"َsَbَʿع","root":"عبس"},{"id":2,"arabic":"وَتَوَلَّىٰٓ","translit":"ٰٓàَّlَwَtَw","root":"ولي"}],"hasIhya":true},{"ayah":2,"text":"أَن جَآءَهُ ٱلْأَعْمَىٰ ","translation":"Because there came to him the blind man,[1] [interrupting].","words":[{"id":1,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":2,"arabic":"جَآءَهُ","translit":"ُhَءٓāَjg","root":"جيا"},{"id":3,"arabic":"ٱلْأَعْمَىٰ","translit":"ٰàَmْʿعَaʾْlٱ","root":"عمي"}],"hasIhya":false},{"ayah":3,"text":"وَمَا يُدْرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ ","translation":"But what would make you perceive, [O Muḥammad], that perhaps he might be purified[1]","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"يُدْرِيكَ","translit":"َkyِrْdُy","root":"دري"},{"id":3,"arabic":"لَعَلَّهُۥ","translit":"ۥُhَّlَʿعَl","root":""},{"id":4,"arabic":"يَزَّكَّىٰٓ","translit":"ٰٓàَّkَّzَy","root":"زكو"}],"hasIhya":false},{"ayah":4,"text":"أَوْ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكْرَىٰٓ ","translation":"Or be reminded and the remembrance would benefit him?","words":[{"id":1,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":2,"arabic":"يَذَّكَّرُ","translit":"ُrَّkَّhdَy","root":"ذكر"},{"id":3,"arabic":"فَتَنفَعَهُ","translit":"ُhَʿعَfnَtَf","root":"نفع"},{"id":4,"arabic":"ٱلذِّكْرَىٰٓ","translit":"ٰٓàَrْkِّhdlٱ","root":"ذكر"}],"hasIhya":false},{"ayah":5,"text":"أَمَّا مَنِ ٱسْتَغْنَىٰ ","translation":"As for he who thinks himself without need,[1]","words":[{"id":1,"arabic":"أَمَّا","translit":"āَّmَaʾ","root":""},{"id":2,"arabic":"مَنِ","translit":"ِnَm","root":""},{"id":3,"arabic":"ٱسْتَغْنَىٰ","translit":"ٰàَnْغَtْsٱ","root":"غني"}],"hasIhya":false},{"ayah":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ ","translation":"To him you give attention.","words":[{"id":1,"arabic":"فَأَنتَ","translit":"َtnَaʾَf","root":""},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"تَصَدَّىٰ","translit":"ٰàَّdَṣَt","root":"صدي"}],"hasIhya":false},{"ayah":7,"text":"وَمَا عَلَيْكَ أَلَّا يَزَّكَّىٰ ","translation":"And not upon you [is any blame] if he will not be purified.[1]","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":3,"arabic":"أَلَّا","translit":"āَّlَaʾ","root":""},{"id":4,"arabic":"يَزَّكَّىٰ","translit":"ٰàَّkَّzَy","root":"زكو"}],"hasIhya":false},{"ayah":8,"text":"وَأَمَّا مَن جَآءَكَ يَسْعَىٰ ","translation":"But as for he who came to you striving [for knowledge]","words":[{"id":1,"arabic":"وَأَمَّا","translit":"āَّmَaʾَw","root":""},{"id":2,"arabic":"مَن","translit":"nَm","root":""},{"id":3,"arabic":"جَآءَكَ","translit":"َkَءٓāَjg","root":"جيا"},{"id":4,"arabic":"يَسْعَىٰ","translit":"ٰàَʿعْsَy","root":"سعي"}],"hasIhya":true},{"ayah":9,"text":"وَهُوَ يَخْشَىٰ ","translation":"While he fears [Allāh],","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"يَخْشَىٰ","translit":"ٰàَhsْhkَy","root":"خشي"}],"hasIhya":false},{"ayah":10,"text":"فَأَنتَ عَنْهُ تَلَهَّىٰ ","translation":"From him you are distracted.","words":[{"id":1,"arabic":"فَأَنتَ","translit":"َtnَaʾَf","root":""},{"id":2,"arabic":"عَنْهُ","translit":"ُhْnَʿع","root":""},{"id":3,"arabic":"تَلَهَّىٰ","translit":"ٰàَّhَlَt","root":"لهو"}],"hasIhya":false},{"ayah":11,"text":"كَلَّآ إِنَّهَا تَذْكِرَةٌ ","translation":"No! Indeed, they [i.e., these verses] are a reminder;","words":[{"id":1,"arabic":"كَلَّآ","translit":"ٓāَّlَk","root":""},{"id":2,"arabic":"إِنَّهَا","translit":"āَhَّnِiʾ","root":""},{"id":3,"arabic":"تَذْكِرَةٌ","translit":"ٌẗَrِkْhdَt","root":"ذكر"}],"hasIhya":false},{"ayah":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ ","translation":"So whoever wills may remember it.[1]","words":[{"id":1,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":2,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":3,"arabic":