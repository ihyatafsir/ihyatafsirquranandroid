 وَهُمْ فِے غَفْلَةࣲ وَهُمْ لَا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "وَأَنذِرْهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْحَسْرَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 5, "arabic": "قُضِيَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لَامْرُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "غَفْلَةࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "لَا", "translit": "", "root": ""}, {"id": 12, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 19, "ayah": 40, "text": "إِنَّا نَحْنُ نَرِثُ اُ۬لَارْضَ وَمَنْ عَلَيْهَاۖ وَإِلَيْنَا يُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَرِثُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْهَاۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَإِلَيْنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "يُرْجَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 19, "ayah": 41, "text": "۞وَاذْكُرْ فِے اِ۬لْكِتَٰبِ إِبْرَٰهِيمَ إِنَّهُۥ كَانَ صِدِّيقاࣰ نَّبِيٓـٔاً", "words": [{"id": 1, "arabic": "۞وَاذْكُرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْكِتَٰبِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "صِدِّيقاࣰ", "translit": "", "ro