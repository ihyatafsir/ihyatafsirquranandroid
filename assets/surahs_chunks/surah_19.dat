it": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْكِتَٰبِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُخْلِصاࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَكَانَ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَسُولاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "نَّبِيٓـٔاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 19, "ayah": 52, "text": "وَنَٰدَيْنَٰهُ مِن جَانِبِ اِ۬لطُّورِ اِ۬لَايْمَنِ وَقَرَّبْنَٰهُ نَجِيّاࣰۖ", "words": [{"id": 1, "arabic": "وَنَٰدَيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "جَانِبِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لطُّورِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَايْمَنِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَقَرَّبْنَٰهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَجِيّاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 19, "ayah": 53, "text": "وَوَهَبْنَا لَهُۥ مِن رَّحْمَتِنَآ أَخَاهُ هَٰرُونَ نَبِيٓـٔاࣰۖ", "words": [{"id": 1, "arabic": "وَوَهَبْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "رَّحْمَتِنَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَخَاهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "هَٰرُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَبِيٓـٔاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 19, "ayah": 54, "text": "وَاذْكُرْ فِے اِ۬لْكِتَٰبِ إِسْمَٰعِيلَ إِنَّهُۥ كَانَ صَادِقَ اَ۬لْوَعْدِ وَكَانَ رَسُولاࣰ نَّبِيٓـٔاࣰ‏", "words": [{"id": 1, "arabic": "وَاذْكُرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْكِتَٰبِ