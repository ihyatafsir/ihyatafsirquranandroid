{"surah": 74, "verses": [{"ayah": 1, "text": "يَٰٓأَيُّهَا ٱلْمُدَّثِّرُ ", "translation": "O you who covers himself [with a garment],[1]", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلْمُدَّثِّرُ", "translit": "ُrِّhtَّdُmْlٱ", "root": "دثر"}], "hasIhya": false}, {"ayah": 2, "text": "قُمْ فَأَنذِرْ ", "translation": "Arise and warn", "words": [{"id": 1, "arabic": "قُمْ", "translit": "ْmُq", "root": "قوم"}, {"id": 2, "arabic": "فَأَنذِرْ", "translit": "ْrِhdnَaʾَf", "root": "نذر"}], "hasIhya": false}, {"ayah": 3, "text": "وَرَبَّكَ فَكَبِّرْ ", "translation": "And your Lord glorify", "words": [{"id": 1, "arabic": "وَرَبَّكَ", "translit": "َkَّbَrَw", "root": "ربب"}, {"id": 2, "arabic": "فَكَبِّرْ", "translit": "ْrِّbَkَf", "root": "كبر"}], "hasIhya": false}, {"ayah": 4, "text": "وَثِيَابَكَ فَطَهِّرْ ", "translation": "And your clothing purify", "words": [{"id": 1, "arabic": "وَثِيَابَكَ", "translit": "َkَbāَyِhtَw", "root": "ثوب"}, {"id": 2, "arabic": "فَطَهِّرْ", "translit": "ْrِّhَṭَf", "root": "طهر"}], "hasIhya": false}, {"ayah": 5, "text": "وَٱلرُّجْزَ فَٱهْجُرْ ", "translation": "And uncleanliness[1] avoid", "words": [{"id": 1, "arabic": "وَٱلرُّجْزَ", "translit": "َzْjgُّrlٱَw", "root": "رجز"}, {"id": 2, "arabic": "فَٱهْجُرْ", "translit": "ْrُjgْhٱَf", "root": "هجر"}], "hasIhya": false}, {"ayah": 6, "text": "وَلَا تَمْنُن تَسْتَكْثِرُ ", "translation": "And do not confer favor to acquire more[1]", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَمْنُن", "translit": "nُnْmَt", "root": "منن"}, {"id": 3, "arabic": "تَسْتَكْثِرُ", "translit": "ُrِhtْkَtْsَt", "root": "كثر"}], "hasIhya": false}, {"ayah": 7, "text": "وَلِرَبِّكَ فَٱصْبِرْ ", "translation": "But for your Lord be patient.", "words": [{"id": 1, "arabic": "وَلِرَبِّكَ", "translit": "َkِّbَrِlَw", "root": "ربب"}, {"id": 2, "arabic": "فَٱصْبِرْ", "translit": "ْrِbْṣٱَf", "root": "صبر"}], "hasIhya": false}, {"ayah": 8, "text": "فَإِذَا نُقِرَ فِى ٱلنَّاقُورِ ", "translation": "And when the trumpet is blown,", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "نُقِرَ", "translit": "َrِqُn", "root": "نقر"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلنَّاقُورِ", "translit": "ِrwُqāَّnlٱ", "root": "نقر"}], "hasIhya": true}, {"ayah": 9, "text": "فَذَٰلِكَ يَوْمَئِذٍ يَوْمٌ عَسِيرٌ ", "translation": "That Day will be a difficult day", "words": [{"id": 1, "arabic": "فَذَٰلِكَ", "translit": "َkِlَٰhdَf", "root": ""}, {"id": 2, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 3, "arabic": "يَوْمٌ", "translit": "ٌmْwَy", "root": "يوم"}, {"id": 4, "arabic": "عَسِيرٌ", "translit": "ٌryِsَʿع", "root": "عسر"}], "hasIhya": false}, {"ayah": 10, "text": "عَلَى ٱلْكَٰفِرِينَ غَيْرُ يَسِيرٍ ", "translation": "For the disbelievers - not easy.", "words": [{"id": 1, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 2, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 3, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 4, "arabic": "يَسِيرٍ", "translit": "ٍryِsَy", "root": "يسر"}], "hasIhya": false}, {"ayah": 11, "text": "ذَرْنِى وَمَنْ خَلَقْتُ وَحِيدًا ", "translation": "Leave Me with the one I created alone[1]", "words": [{"id": 1, "arabic": "ذَرْنِى", "translit": "àِnْrَhd", "root": "وذر"}, {"id": 2, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 3, "arabic": "خَلَقْتُ", "translit": "ُtْqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "وَحِيدًا", "translit": "āًdyِḥَw", "root": "وحد"}], "hasIhya": false}, {"ayah": 12, "text": "وَجَعَلْتُ لَهُۥ مَالًا مَّمْدُودًا ", "translation": "And to whom I granted extensive wealth", "words": [{"id": 1, "arabic": "وَجَعَلْتُ", "translit": "ُtْlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "مَالًا", "translit": "āًlāَm", "root": "مول"}, {"id": 4, "arabic": "مَّمْدُودًا", "translit": "āًdwُdْmَّm", "root": "مدد"}], "hasIhya": false}, {"ayah": 13, "text": "وَبَنِينَ شُهُودًا ", "translation": "And children present [with him]", "words": [{"id": 1, "arabic": "وَبَنِينَ", "translit": "َnyِnَbَw", "root": "بني"}, {"id": 2, "arabic": "شُهُودًا", "translit": "āًdwُhُhs", "root": "شهد"}], "hasIhya": false}, {"ayah": 14, "text": "وَمَهَّدتُّ لَهُۥ تَمْهِيدًا ", "translation": "And spread [everything] before him, easing [his life].", "words": [{"id": 1, "arabic": "وَمَهَّدتُّ", "translit": "ُّtdَّhَmَw", "root": "مهد"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "تَمْهِيدًا", "translit": "āًdyِhْmَt", "root": "مهد"}], "hasIhya": false}, {"ayah": 15, "text": "ثُمَّ يَطْمَعُ أَنْ أَزِيدَ ", "translation": "Then he desires that I should add more.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "يَطْمَعُ", "translit": "ُʿعَmْṭَy", "root": "طمع"}, {"id": 3, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 4, "arabic": "أَزِيدَ", "translit": "َdyِzَaʾ", "root": "زيد"}], "hasIhya": false}, {"ayah": 16, "text": "كَلَّآۖ إِنَّهُۥ كَانَ لِءَايَٰتِنَا عَنِيدًا ", "translation": "No! Indeed, he has been toward Our verses obstinate.", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "لِءَايَٰتِنَا", "translit": "āَnِtَٰyāَءِl", "root": "ايي"}, {"id": 5, "arabic": "عَنِيدًا", "translit": "āًdyِnَʿع", "root": "عند"}], "hasIhya": false}, {"ayah": 17, "text": "سَأُرْهِقُهُۥ صَعُودًا ", "translation": "I will cover him with arduous torment.", "words": [{"id": 1, "arabic": "سَأُرْهِقُهُۥ", "translit": "ۥُhُqِhْrُaʾَs", "root": "رهق"}, {"id": 2, "arabic": "صَعُودًا", "translit": "āًdwُʿعَṣ", "root": "صعد"}], "hasIhya": false}, {"ayah": 18, "text": "إِنَّهُۥ فَكَّرَ وَقَدَّرَ ", "translation": "Indeed, he thought and deliberated.[1]", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "فَكَّرَ", "translit": "َrَّkَf", "root": "فكر"}, {"id": 3, "arabic": "وَقَدَّرَ", "translit": "َrَّdَqَw", "root": "قدر"}], "hasIhya": false}, {"ayah": 19, "text": "فَقُتِلَ كَيْفَ قَدَّرَ ", "translation": "So may he be destroyed [for] how he deliberated.", "words": [{"id": 1, "arabic": "فَقُتِلَ", "translit": "َlِtُqَf", "root": "قتل"}, {"id": 2, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 3, "arabic": "قَدَّرَ", "translit": "َrَّdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 20, "text": "ثُمَّ قُتِلَ كَيْفَ قَدَّرَ ", "translation": "Then may he be destroyed [for] how he deliberated.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "قُتِلَ", "translit": "َlِtُq", "root": "قتل"}, {"id": 3, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 4, "arabic": "قَدَّرَ", "translit": "َrَّdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 21, "text": "ثُمَّ نَظَرَ ", "translation": "Then he considered [again];", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "نَظَرَ", "translit": "َrَẓَn", "root": "نظر"}], "hasIhya": false}, {"ayah": 22, "text": "ثُمَّ عَبَسَ وَبَسَرَ ", "translation": "Then he frowned and scowled;", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "عَبَسَ", "translit": "َsَbَʿع", "root": "عبس"}, {"id": 3, "arabic": "وَبَسَرَ", "translit": "َrَsَbَw", "root": "بسر"}], "hasIhya": false}, {"ayah": 23, "text": "ثُمَّ أَدْبَرَ وَٱسْتَكْبَرَ ", "translation": "Then he turned back and was arrogant", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَدْبَرَ", "translit": "َrَbْdَaʾ", "root": "دبر"}, {"id": 3, "arabic": "وَٱسْتَكْبَرَ", "translit": "َrَbْkَtْsٱَw", "root": "كبر"}], "hasIhya": false}, {"ayah": 24, "text": "فَقَالَ إِنْ هَٰذَآ إِلَّا سِحْرٌ يُؤْثَرُ ", "translation": "And said, \"This is not but magic imitated [from others].", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 2, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 3, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "سِحْرٌ", "translit": "ٌrْḥِs", "root": "سحر"}, {"id": 6, "arabic": "يُؤْثَرُ", "translit": "ُrَhtْwʾُy", "root": "اثر"}], "hasIhya": false}, {"ayah": 25, "text": "إِنْ هَٰذَآ إِلَّا قَوْلُ ٱلْبَشَرِ ", "translation": "This is not but the word of a human being.\"", "words": [{"id": 1, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "قَوْلُ", "translit": "ُlْwَq", "root": "قول"}, {"id": 5, "arabic": "ٱلْبَشَرِ", "translit": "ِrَhsَbْlٱ", "root": "بشر"}], "hasIhya": false}, {"ayah": 26, "text": "سَأُصْلِيهِ سَقَرَ ", "translation": "I will drive him into Saqar.[1]", "words": [{"id": 1, "arabic": "سَأُصْلِيهِ", "translit": "ِhyِlْṣُaʾَs", "root": "صلي"}, {"id": 2, "arabic": "سَقَرَ", "translit": "َrَqَs", "root": ""}], "hasIhya": false}, {"ayah": 27, "text": "وَمَآ أَدْرَىٰكَ مَا سَقَرُ ", "translation": "And what can make you know what is Saqar?", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَدْرَىٰكَ", "translit": "َkٰàَrْdَaʾ", "root": "دري"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "سَقَرُ", "translit": "ُrَqَs", "root": ""}], "hasIhya": false}, {"ayah": 28, "text": "لَا تُبْقِى وَلَا تَذَرُ ", "translation": "It lets nothing remain and leaves nothing [unburned],", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "تُبْقِى", "translit": "àِqْbُt", "root": "بقي"}, {"id": 3, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 4, "arabic": "تَذَرُ", "translit": "ُrَhdَt", "root": "وذر"}], "hasIhya": false}, {"ayah": 29, "text": "لَوَّاحَةٌ لِّلْبَشَرِ ", "translation": "Altering [i.e., blackening] the skins.", "words": [{"id": 1, "arabic": "لَوَّاحَةٌ", "translit": "ٌẗَḥāَّwَl", "root": "لوح"}, {"id": 2, "arabic": "لِّلْبَشَرِ", "translit": "ِrَhsَbْlِّl", "root": "بشر"}], "hasIhya": false}, {"ayah": 30, "text": "عَلَيْهَا تِسْعَةَ عَشَرَ ", "translation": "Over it are nineteen [angels].", "words": [{"id": 1, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 2, "arabic": "تِسْعَةَ", "translit": "َẗَʿعْsِt", "root": "تسع"}, {"id": 3, "arabic": "عَشَرَ", "translit": "َrَhsَʿع", "root": "عشر"}], "hasIhya": false}, {"ayah": 31, "text": "وَمَا جَعَلْنَآ أَصْحَٰبَ ٱلنَّارِ إِلَّا مَلَٰٓئِكَةًۙ وَمَا جَعَلْنَا عِدَّتَهُمْ إِلَّا فِتْنَةً لِّلَّذِينَ كَفَرُوا۟ لِيَسْتَيْقِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَيَزْدَادَ ٱلَّذِينَ ءَامَنُوٓا۟ إِيمَٰنًاۙ وَلَا يَرْتَابَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ وَٱلْمُؤْمِنُونَۙ وَلِيَقُولَ ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْكَٰفِرُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلًاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَن يَشَآءُ وَيَهْدِى مَن يَشَآءُۚ وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَۚ وَمَا هِىَ إِلَّا ذِكْرَىٰ لِلْبَشَرِ ", "translation": "And We have not made the keepers of the Fire except angels. And We have not made their number except as a trial for those who disbelieve - that those who were given the Scripture will be convinced and those who have believed will increase in faith and those who were given the Scripture and the believers will not doubt and that those in whose hearts is disease [i.e., hypocrisy] and the disbelievers will say, \"What does Allāh intend by this as an example?\" Thus does Allāh send astray whom He wills and guide whom He wills. And none knows the soldiers of your Lord except Him. And it [i.e., mention of the Fire] is not but a reminder to humanity.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَآ", "translit": "ٓāَnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 4, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "مَلَٰٓئِكَةً", "translit": "ًẗَkِyʾَٰٓlَm", "root": "ملك"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 9, "arabic": "عِدَّتَهُمْ", "translit": "ْmُhَtَّdِʿع", "root": "عدد"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "فِتْنَةً", "translit": "ًẗَnْtِf", "root": "فتن"}, {"id": 12, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 13, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 14, "arabic": "لِيَسْتَيْقِنَ", "translit": "َnِqْyَtْsَyِl", "root": "يقن"}, {"id": 15, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 17, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 18, "arabic": "وَيَزْدَادَ", "translit": "َdāَdْzَyَw", "root": "زيد"}, {"id": 19, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 21, "arabic": "إِيمَٰنًا", "translit": "āًnَٰmyِiʾ", "root": "امن"}, {"id": 22, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 23, "arabic": "يَرْتَابَ", "translit": "َbāَtْrَy", "root": "ريب"}, {"id": 24, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 25, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 26, "arabic": "ٱلْكِتَٰبَ", "t