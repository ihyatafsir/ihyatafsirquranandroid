it": "َàِh", "root": ""}, {"id": 55, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 56, "arabic": "ذِكْرَىٰ", "translit": "ٰàَrْkِhd", "root": "ذكر"}, {"id": 57, "arabic": "لِلْبَشَرِ", "translit": "ِrَhsَbْlِl", "root": "بشر"}], "hasIhya": true}, {"ayah": 32, "text": "كَلَّا وَٱلْقَمَرِ ", "translation": "No! By the moon", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "āَّlَk", "root": ""}, {"id": 2, "arabic": "وَٱلْقَمَرِ", "translit": "ِrَmَqْlٱَw", "root": "قمر"}], "hasIhya": false}, {"ayah": 33, "text": "وَٱلَّيْلِ إِذْ أَدْبَرَ ", "translation": "And [by] the night when it departs", "words": [{"id": 1, "arabic": "وَٱلَّيْلِ", "translit": "ِlْyَّlٱَw", "root": "ليل"}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَدْبَرَ", "translit": "َrَbْdَaʾ", "root": "دبر"}], "hasIhya": false}, {"ayah": 34, "text": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ ", "translation": "And [by] the morning when it brightens,", "words": [{"id": 1, "arabic": "وَٱلصُّبْحِ", "translit": "ِḥْbُّṣlٱَw", "root": "صبح"}, {"id": 2, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَسْفَرَ", "translit": "َrَfْsَaʾ", "root": "سفر"}], "hasIhya": false}, {"ayah": 35, "text": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ ", "translation": "Indeed, it [i.e., the Fire] is of the greatest [afflictions]", "words": [{"id": 1, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَإِحْدَى", "translit": "àَdْḥِiʾَl", "root": "احد"}, {"id": 3, "arabic": "ٱلْكُبَرِ", "translit": "ِrَbُkْlٱ", "root": "كبر"}], "hasIhya": true}, {"ayah": 36, "text": "نَذِيرًا لِّلْبَشَرِ ", "translation": "As a warning to humanity -", "words": [{"id": 1, "arabic": "نَذِيرًا", "translit": "āًryِhdَn", "root": "نذر"}, {"id": 2, "arabic": "لِّلْبَشَرِ", "translit": "ِrَhsَbْlِّl", "root": "بشر"}], "hasIhya": false}, {"ayah": 37, "text": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ ", "translation": "To whoever wills among you to proceed[1] or stay behind.", "words": [{"id": 1, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَتَقَدَّمَ", "translit": "َmَّdَqَtَy", "root": "قدم"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "يَتَأَخَّرَ", "translit": "َrَّhkَaʾَtَy", "root": "اخر"}], "hasIhya": false}, {"ayah": 38, "text": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ ", "translation": "Every soul, for what it has earned, will be retained[1]", "words": [{"id": 1, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 2, "arabic": "نَفْسٍۭ", "translit": "ٍۭsْfَn", "root": "نفس"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 5, "arabic": "رَهِينَةٌ", "translit": "ٌẗَnyِhَr", "root": "رهن"}], "hasIhya": false}, {"ayah": 39, "text": "إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ ", "translation": "Except the companions of the right,[1].", "words": [{"id": 1, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 2, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 3, "arabic": "ٱلْيَمِينِ", "translit": "ِnyِmَyْlٱ", "root": "يمن"}], "hasIhya": false}, {"ayah": 40, "text": "فِى جَنَّٰتٍ يَتَسَآءَلُونَ ", "translation": "[Who will be] in gardens, questioning each other", "words": [{"id": 1, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 2, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 3, "arabic": "يَتَسَآءَلُونَ", "translit": "َnwُlَءٓāَsَtَy", "root": "سال"}], "hasIhya": false}, {"ayah": 41, "text": "عَنِ ٱلْمُجْرِمِينَ ", "translation": "About the criminals,", "words": [{"id": 1, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 2, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 42, "text": "مَا سَلَكَكُمْ فِى سَقَرَ ", "translation": "[And asking them], \"What put you into Saqar?\"", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "سَلَكَكُمْ", "translit": "ْmُkَkَlَs", "root": "سلك"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "سَقَرَ", "translit": "َrَqَs", "root": ""}], "hasIhya": true}, {"ayah": 43, "text": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ ", "translation": "They will say, \"We were not of those who prayed,", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 3, "arabic": "نَكُ", "translit": "ُkَn", "root": "كون"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْمُصَلِّينَ", "translit": "َnyِّlَṣُmْlٱ", "root": "صلو"}], "hasIhya": false}, {"ayah": 44, "text": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ ", "translation": "Nor did we used to feed the poor.", "words": [{"id": 1, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 2, "arabic": "نَكُ", "translit": "ُkَn", "root": "كون"}, {"id": 3, "arabic": "نُطْعِمُ", "translit": "ُmِʿعْṭُn", "root": "طعم"}, {"id": 4, "arabic": "ٱلْمِسْكِينَ", "translit": "َnyِkْsِmْlٱ", "root": "سكن"}], "hasIhya": false}, {"ayah": 45, "text": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ ", "translation": "And we used to enter into vain discourse with those who engaged [in it],", "words": [{"id": 1, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 2, "arabic": "نَخُوضُ", "translit": "ُḍwُhkَn", "root": "خوض"}, {"id": 3, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 4, "arabic": "ٱلْخَآئِضِينَ", "translit": "َnyِḍِyʾٓāَhkْlٱ", "root": "خوض"}], "hasIhya": true}, {"ayah": 46, "text": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ ", "translation": "And we used to deny the Day of Recompense", "words": [{"id": 1, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 2, "arabic": "نُكَذِّبُ", "translit": "ُbِّhdَkُn", "root": "كذب"}, {"id": 3, "arabic": "بِيَوْمِ", "translit": "ِmْwَyِb", "root": "يوم"}, {"id": 4, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}], "hasIhya": false}, {"ayah": 47, "text": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ ", "translation": "Until there came to us the certainty [i.e., death].\"", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "أَتَىٰنَا", "translit": "āَnٰàَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "ٱلْيَقِينُ", "translit": "ُnyِqَyْlٱ", "root": "يقن"}], "hasIhya": false}, {"ayah": 48, "text": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ ", "translation": "So there will not benefit them the intercession of [any] intercessors.", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "تَنفَعُهُمْ", "translit": "ْmُhُʿعَfnَt", "root": "نفع"}, {"id": 3, "arabic": "شَفَٰعَةُ", "translit": "ُẗَʿعَٰfَhs", "root": "شفع"}, {"id": 4, "arabic": "ٱلشَّٰفِعِينَ", "translit": "َnyِʿعِfَّٰhslٱ", "root": "شفع"}], "hasIhya": true}, {"ayah": 49, "text": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ ", "translation": "Then what is [the matter] with them that they are, from the reminder, turning away", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلتَّذْكِرَةِ", "translit": "ِẗَrِkْhdَّtlٱ", "root": "ذكر"}, {"id": 5, "arabic": "مُعْرِضِينَ", "translit": "َnyِḍِrْʿعُm", "root": "عرض"}], "hasIhya": false}, {"ayah": 50, "text": "كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ ", "translation": "As if they were alarmed donkeys", "words": [{"id": 1, "arabic": "كَأَنَّهُمْ", "translit": "ْmُhَّnَaʾَk", "root": ""}, {"id": 2, "arabic": "حُمُرٌ", "translit": "ٌrُmُḥ", "root": "حمر"}, {"id": 3, "arabic": "مُّسْتَنفِرَةٌ", "translit": "ٌẗَrِfnَtْsُّm", "root": "نفر"}], "hasIhya": false}, {"ayah": 51, "text": "فَرَّتْ مِن قَسْوَرَةٍۭ ", "translation": "Fleeing from a lion?", "words": [{"id": 1, "arabic": "فَرَّتْ", "translit": "ْtَّrَf", "root": "فرر"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "قَسْوَرَةٍۭ", "translit": "ٍۭẗَrَwْsَq", "root": "قسر"}], "hasIhya": false}, {"ayah": 52, "text": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً ", "translation": "Rather, every person among them desires that he[1] would be given scriptures spread about.[2]", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 3, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 4, "arabic": "ٱمْرِئٍ", "translit": "ٍyʾِrْmٱ", "root": "مرا"}, {"id": 5, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "يُؤْتَىٰ", "translit": "ٰàَtْwʾُy", "root": "اتي"}, {"id": 8, "arabic": "صُحُفًا", "translit": "āًfُḥُṣ", "root": "صحف"}, {"id": 9, "arabic": "مُّنَشَّرَةً", "translit": "ًẗَrَّhsَnُّm", "root": "نشر"}], "hasIhya": false}, {"ayah": 53, "text": "كَلَّاۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ ", "translation": "No! But they do not fear the Hereafter.", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "āَّlَk", "root": ""}, {"id": 2, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 3, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 4, "arabic": "يَخَافُونَ", "translit": "َnwُfāَhkَy", "root": "خوف"}, {"id": 5, "arabic": "ٱلْءَاخِرَةَ", "translit": "َẗَrِhkāَءْlٱ", "root": "اخر"}], "hasIhya": false}, {"ayah": 54, "text": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌ ", "translation": "No! Indeed, it [i.e., the Qur’ān] is a reminder", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "تَذْكِرَةٌ", "translit": "ٌẗَrِkْhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 55, "text": "فَمَن شَآءَ ذَكَرَهُۥ ", "translation": "Then whoever wills will remember it.", "words": [{"id": 1, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "ذَكَرَهُۥ", "translit": "ۥُhَrَkَhd", "root": "ذكر"}], "hasIhya": false}, {"ayah": 56, "text": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ ", "translation": "And they will not remember except that Allāh wills. He is worthy of fear and adequate for [granting] forgiveness.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يَذْكُرُونَ", "translit": "َnwُrُkْhdَy", "root": "ذكر"}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَشَآءَ", "translit": "َءٓāَhsَy", "root": "شيا"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "أَهْلُ", "translit": "ُlْhَaʾ", "root": "اهل"}, {"id": 9, "arabic": "ٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱ", "root": "وقي"}, {"id": 10, "arabic": "وَأَهْلُ", "translit": "ُlْhَaʾَw", "root": "اهل"}, {"id": 11, "arabic": "ٱلْمَغْفِرَةِ", "translit": "ِẗَrِfْغَmْlٱ", "root": "غفر"}], "hasIhya": true}], "tafsir": {"8": [{"arabic": "فإذا هم قيام ينظرون وقال تعالى {فإذا نقر في الناقور فذلك يومئذ يوم عسير على الكافرين غير يسير} وقال تعالى {ويقولون متى هذا الوعد إن كنتم صادقين ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون ونفخ في الصور فإذا هم من الأجداث إلى ربهم ينسلون قالوا يا ويلنا من بعثنا من مرقدنا هذا ما وعد الرحمن وصدق المرسلون} فلو لم يكن بين يدي الموتى إلا هول تلك النفخة لكان ذلك جديرا بأن يتقى فإنها نفخة وصيحة يصعق بها من في السموات والأرض يعنى يموتون بها إلا من شاء الله وهو بعض الملائكة ولذلك قال رسول الله صلى الله عليه وسلم ك", "english": "The Prophet (peace and blessings be upon him) said: Allah the Exalted said: \"The son of Adam has reviled Me, and he had no right to revile Me; and he has denied Me, and he had no right to deny Me. As for his reviling of Me, it is his saying that I have a son. And as for his denial of Me, it is his saying: 'He will never bring me back as He created me at first.'\" {«شتمني ابن آدم وما ينبغي له أن يشتمني وكذبني وما ينبغي له أن يكذبني...»}", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1335", "section_title_en": "On the Terrors of the Trumpet-Blast and the Awakening for the Resurrection", "section_index": 1335, "anchors": "- Root: نفخ (N-F-Kh)\n  * Lisan / Ayn: To blow into a thing, to inflate; the breath of wind entering a vessel or body.\n  * Al-Raghib (Mufradat): The divine act of breathing spirit into creation {«ونفخت فيه من روحي»}; here, the eschatological blast that annihilates and then revives all beings.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage of blowing into the Trumpet (الصور); metaphorical extension to the \"blast of spring\" reviving the earth—here applied to the two cosmic blasts of death and resurrection.\n- Root: صور (S-W-R)\n  * Lisan / Ayn: Form, image, shape; also a horn or trumpet (the instrument of the blast).\n  * Al-Raghib (Mufradat): The perceptible form of bodies and the intelligible form of souls; here, the Trumpet (الصور) as the instrument of divine command that re-forms and re-shapes creation.\n  * Al-Zamakhshari (Asas): Literal: the horn (القرن) held by Israfil; metaphorical: the \"inclination\" (صورة) of hearts toward terror and anticipation.\n- Root: موت (M-W-T)\n  * Lisan / Ayn: Death as the cessation of life; the state of the corpse.\n  * Al-Raghib (Mufradat): Death as the separation of the soul from the body; the \"first death\" of the blast and the \"second death\" of the wicked.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: the \"death\" of the heart through heedlessness, and the reviving of dead lands by rain—here, the reviving of bodies by the second blast.\n- Root: قبر (Q-B-R)\n  * Lisan / Ayn: The grave as the abode of the dead; burial.\n  * Al-Raghib (Mufradat): The grave as the intermediate state (barzakh) before resurrection; {«حتى زرتم المقابر»} as a metaphor for death.\n  * Al-Zamakhshari (Asas): Literal: the grave and its inhabitants; metaphorical: the \"raising of the nose\" (قبراه) of the proud—contrasted here with the humility of the dead rising from their graves.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that true faith is not mere verbal assent but heartfelt conviction, as in \"إنما فتور البواطن... لقلة الفهم\" (The languor of the inner selves is only due to the lack of understanding).", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}, {"arabic": "وروى أن زرارة بن أوفى لما انتهى إلى قوله تعالى {فإذا نقر في الناقور} خر ميتا وكان إبراهيم النخعي إذا سمع قوله تعالى {إذا السماء انشقت} اضطرب حتى تضطرب أوصاله وقال عبد الله بن واقد رأيت ابن عمر يصلي مغلوبا عليه وحق له أن يحترق قلبه بوعد سيده ووعيده فإنه عبد مذنب ذليل بين يدي جبار قاهر وتكون هذه المعاني بحسب درجات الفهم ويكون الفهم بحسب وفور العلم وصفاء القلب ودرجات ذلك لا تنحصر والصلاة مفتاح القلوب فيها تنكشف أسرار الكلمات فهذا حق القراءة وهو حق الأذكار والتسبيحات أيضا ثم يراعي الهيبة في القراءة فيرتل ولا يسرد فإن ذ", "english": "For this reason, he, peace be upon him, said: \"Give us rest, O Bilāl\" (1) — meaning, give us rest through it (the prayer) and through the call to it, for his delight, peace be upon him, was in it.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 138", "section_title_en": "The Inner Works of Prayer: Unveiling the Heart's Secrets in the Ritual Prayer (Asrār al-Ṣalāh)", "section_index": 138, "anchors": "- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn a thing over, to revolve it, to divert it from one state to another; the heart as that which is constantly turning and fluctuating.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — The heart is that which is turned and diverted; its rectitude lies in its orientation towards God, its ruin in its turning towards other than Him.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" (the teacher turned the boys towards their homes) — thus the heart's turning is its direction and intent.\n- Root: وجه (W-J-H)\n  * Lisan / Ayn: The face; the foremost, noblest, and most apparent part of a thing.\n  * Al-Raghib (Mufradat): \"ولما كان الوجه أول ما يستقبلك، وأشرف ما في ظاهر البدن استعمل في مستقبل كل شيء، وفي أشرفه ومبدئه\" — The face is used metaphorically for the essence and the direction of a thing; the \"face of the heart\" is its intention and aspiration.\n  * Al-Zamakhshari (Asas): Literal: \"واجهته مواجهة ووجاها\" (to face one another). Metaphorical: \"هذا وجه الثوب. ووجه القوم، وهؤلاء وجوه البلد\" (the face of a garment, the chiefs of a people) — thus the \"face\" of the heart is its foremost orientation.\n- Root: وجل (W-J-L)\n  * Lisan / Ayn: A trembling of the heart from fear or awe.\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — The sensing of fear; the heart's tremor before the majesty of the Divine.\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال، وقد وجل وجلا\" — A man trembling with fear.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, negating it from all else. This is crucial for understanding \"إنما هذه الظواهر تحريكات للبواطن\" — the outward acts are *only* movements to stir the inward realities, nothing more.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'", "badge": "Insight"}], "31": [{"arabic": "قال الله تعالى وما يعلم جنود ربك إلا هو فلله سبحانه في القلوب والأرواح وغيرها من العوالم جنود مجندة لا يعرف حقيقتها وتفصيل عددها إلا هو ونحن الآن نشير إلى بعض جنود القلب فهو الذي يتعلق بغرضنا وله جندان جند يرى بالأبصار وجند لا يرى إلا بالبصائر وهو في حكم الملك والجنود في حكم الخدم والأعوان فهذا معنى الجند فأما جنده المشاهد بالعين فهو اليد والرجل والعين والأذن واللسان وسائر الأعضاء الظاهرة والباطنة فإن جميعها خادمة للقلب ومسخرة له فهو المتصرف فيها والمردد لها وقد خلقت م", "english": "God — Exalted is He — said: {«وَمَا يَعْلَمُ جُنُودَ رَبِّكَ إِلَّا هُوَ»} (Q 74:31) — \"And none knows the armies of your Lord except Him.\" Thus, for God — Glorified is He — within hearts, spirits, and other realms, there are marshaled armies (junūd mujannadah) whose true reality and detailed enumeration none knows except Him alone. And we now shall indicate some of the armies of the heart — for it is that which pertains to our purpose.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 575", "section_title_en": "Exposition of the Armies of the Heart", "section_index": 575, "anchors": "- Root: جند (j-n-d)\n  * Lisan / Ayn: \"جند: العسكر، والأرض الغليظة التي فيها حجارة\" — the core meaning denotes both a gathered military host and rough, stony ground, implying hardness, strength, and collective force.\n  * Al-Raghib (Mufradat): \"يقال للعسكر الجند اعتبارا بالغلظة، من الجند، أي: الأرض الغليظة التي فيها حجارة ثم يقال لكل مجتمع جند\" — the term extends from physical ruggedness to any gathered collective serving a purpose, including spiritual hosts.\n  * Al-Zamakhshari (Asas): \"الأرواح جنود مجندة، والريح من جنود الله تعالى\" — used both literally (military hosts) and metaphorically (spiritual forces, natural phenomena as divine armies).\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant turning, flipping, and oscillation between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه، كقلب الثوب، وقلب الإنسان\" — the heart's essence is its capacity for transformation and redirection.\n  * Al-Zamakhshari (Asas - Majaz): \"رجل قلب حول: يقلب الأمور ويحتال\" — metaphorically, the heart is the seat of deliberation, discernment, and spiritual governance.\n- Root: نزل (n-z-l)\n  * Al-Raghib (Mufradat): \"النزول في الأصل هو انحطاط من علو\" — descent from a height; used for divine sending down of revelation and spiritual realities.\n  * Al-Zamakhshari (Asas - Majaz): \"نزل به مكروه، وأصابته نازلة من نوازل الدهر\" — metaphorically, events \"descend\" upon one; the heart is a station where divine armies \"descend\" or are stationed.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the exclusive attribution of knowledge of the divine armies to God alone through the restrictive particle \"إلا\" (except), establishing that full comprehension of these hosts belongs solely to the Creator.\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "35": [{"arabic": "وتصديق ذلك قوله تعالى إنها لإحدى الكبر نذيرا للبشر لمن شاء منكم أن يتقدم أو يتأخر في الموت وقال سحيم مولى بني تميم جلست إلى عامر بن عبد الله وهو يصلي فأوجز في صلاته ثم أقبل على فقال أرحني بحاجتك فإني أبادر قلت وما تبادر قال ملك الموت رحمك الله قال فقمت عنه وقام إلى صلاته ومر داود الطائي فسأله رجل عن حديث فقال دعنى إنما أبادر خروج نفسي قال عمر رضي الله عنه التؤدة في كل شيء خير إلا في أعمال الخير للآخرة وقال المنذر سمعت مالك بن دينار يقول لنفسه ويحك بادرى قبل أن يأتيك الأمر ويحك بادرى قبل أن يأتيك الأمر حتى كرر ذلك ستي", "english": "I say: The hadith was transmitted by al-Tirmidhi and deemed sound (ḥasan) from the narration of Ubayy ibn Kaʿb (5): a hadith that when he (the Prophet, peace be upon him) sensed from his companions heedlessness or negligence, he would call out to them in a raised voice: \"Death has come upon you.\" This hadith was transmitted by Ibn Abi al-Dunya in *Qaṣr al-Amal* from the narration of Zayd al-Sulaymi as a mursal report (6). The hadith of Abu Hurayrah: \"I am the warner, death is the transformer, and the Hour is the appointed meeting\" — transmitted by Ibn Abi al-Dunya in *Qaṣr al-Amal* and by Abu al-Qasim al-Baghawi with an isnad containing some weakness (7). The hadith of Ibn ʿUmar: \"The Messenger of God, peace be upon him, went out while the sun was at the tips of the palm fronds and said: 'What remains of this world is but like what remains of this day of ours, relative to what has passed of it'\" — transmitted by Ibn Abi al-Dunya therein with a sound isnad, and al-Tirmidhi transmitted something similar from the narration of Abu Saʿid and deemed it sound (8). The hadith: \"The likeness of this world is like a garment torn from its beginning to its end\" — transmitted by Ibn Abi al-Dunya therein from the narration of Anas, but it is not authentic (9). Ibn Masʿud, may God be pleased with him, said: The Messenger of God, peace be upon him, recited: {فمن يرد الله أن يهديه يشرح صدره للإسلام} \"Whomsoever God wishes to guide, He expands his breast to Islam\" {فقال} \"Then he said: 'When the light enters the breast, it expands.' It was said: 'O Messenger of God, is there a sign of this that is recognized?' PageV04P459 {قال} He said: 'Yes: withdrawal from the abode of delusion, turning in repentance to the abode of permanence, and preparation for death before its descent.'\" Al-Suddi said concerning His saying: {الذي خلق الموت والحياة ليبلوكم أيكم أحسن عملا} \"He who created death and life to test you, which of you is best in deed\" — meaning: which of you is most mindful of death, best prepared for it, and most fearful and cautious of it. Hudhayfah said: \"There is no morning or evening except that a caller calls out: 'O people, the departure! The departure!'\" The confirmation of that is His saying, the Exalted: {إنها لإحدى الكبر * نذيرا للبشر * لمن شاء منكم أن يتقدم أو يتأخر} \"Indeed, it is one of the greatest calamities, a warning to mankind, for whoever among you wishes to advance or delay\" — regarding death. Suhaym, the freed slave of Banu Tamim, said: I sat with ʿAmir ibn ʿAbd Allah while he was praying, and he shortened his prayer, then turned to me and said: \"Relieve me of your need, for I am hastening.\" I said: \"What are you hastening for?\" He said: \"The angel of death, may God have mercy on you.\" He said: So I rose from him, and he returned to his prayer. Dawud al-Ta'i passed by, and a man asked him about a hadith, so he said: \"Leave me, for I am only hastening against the departure of my soul.\" ʿUmar, may God be pleased with him, said: \"Deliberation is good in everything except in deeds of goodness for the Hereafter.\" Al-Mundhir said: I heard Malik ibn Dinar saying to himself: \"Woe to you, hasten before the matter comes upon you. Woe to you, hasten before the matter comes upon you\" — repeating that sixty times, while I heard him and he did not see me. Al-Hasan used to say in his exhortation: \"Hasten, hasten! For it is but breaths — if they are held back, your deeds by which you draw near to God, the Mighty and Majestic, are cut off. May God have mercy on a man who looked to his own soul and wept over the number of his sins.\" Then he recited this verse: {إنما نعد لهم عدا} \"We only count for them a counting\" — meaning the breaths. The end of the counting is the departure of your soul; the end of the counting is the parting from your family; the end of the counting is your entry into your grave. Abu Musa al-Ashʿari strove with intense exertion before his death, and it was said to him: \"Would you not hold back, or show yourself some gentleness?\" He said: \"When horses are released and approach the end of their course, they bring out all that they have. What remains of my term is less than that.\" He said: He continued in that state until he died. And he used to say to his wife: \"Tighten your saddle, for there is no crossing over Hellfire.\" One of the caliphs said from his pulpit: \"O servants of God, fear God as much as you are able, and be a people who were called out to, so they awoke, and knew that this world is not for them a permanent abode, so they exchanged it, and prepared for death, for it has overshadowed you. And depart, for the journey has become urgent for you. Indeed, a goal that the moment diminishes and the hour demolishes is worthy of a short duration. Indeed, an absent one whom the two new ones — night and day — hasten is deserving of a swift return. Indeed, an arrival that resolves in triumph or misery is worthy of the best provision. So let him meet his Lord — whoever advises his own soul, presents his repentance, and overcomes his desire — for his term is concealed from him, his hope deceives him, and Satan is entrusted to him, promising him repentance to postpone it, and beautifying disobedience to him to commit it, until his death descends upon him when he is most heedless of it. Indeed, between each of you and Paradise or Hellfire is nothing but death, that it should alight upon him. So what a regret for one who is heedless, or whose life is a proof against him, and whose days lead him to misery. May God make us and you among those whom prosperity does not make insolent, whom disobedience does not hold back from obedience to God, and upon whom regret does not alight after death. Indeed, He is Hearing of supplication, and in His hand is goodness always, and He does what He wills.\" Some of the exegetes said concerning His saying, the Exalted: {فتنتم أنفسكم} \"You tried yourselves\" — meaning: with desires and pleasures; {وتربصتم} \"and you waited\" — meaning: for repentance; {وارتبتم} \"and you doubted\" — meaning: you were skeptical, until the command of God came — meaning: death; {وغركم بالله الغرور} \"and the deluder deluded you concerning God\" — meaning: Satan. Al-Hasan said: \"Be patient and be firm, for it is but a few days, and you are but a standing caravan — soon one of you will be called, and he will respond without turning back. So move on with the righteous deeds that are in your possession.\" Ibn Masʿud said: \"There is none of you who wakes up except that he is a guest, and what he has is a loan. The guest departs, and the loan is returned.\" Abu ʿUbaydah al-Baji said: We entered upon al-Hasan in his illness from which he died, and he said: \"Welcome to you, and greetings. May God greet you with peace, and settle us and you in the abode of permanence. This is a good outward sign if you are patient, truthful, and God-fearing. So let not your share of this report — may God have mercy on you — be merely that you hear it with this ear and let it out from this ear. For whoever has seen Muhammad, peace be upon him, has seen him going forth early.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1291", "section_title_en": "The Haste for Death and Readiness for the Hereafter — Section 1291", "section_index": 1291, "anchors": "- Root: موت (m-w-t)\n  * Lisan / Ayn: Core root denotes cessation of vital faculty; \"مات موتة\" as a singular event of death.\n  * Al-Raghib (Mufradat): Death as transition from worldly life to the reckoning; linked to \"أجل\" (appointed term) and divine decree.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) = biological death; Metaphorical (Majaz) = \"إماتة\" of the heart via heedlessness, and \"الموت المغير\" as the transformative destroyer of states.\n- Root: بدر (b-d-r)\n  * Lisan / Ayn: Core root denotes hastening, rushing to a task; \"بادر\" implies competing with time.\n  * Al-Raghib (Mufradat): In Quranic usage, \"المبادر\" is the soul's urgency toward obedience before the term expires.\n  * Al-Zamakhshari (Asas): Literal = physical speed; Metaphorical = spiritual vigilance against procrastination (تسويف).\n- Root: عرض (ʿ-r-ḍ)\n  * Lisan / Ayn: Core root denotes presenting, exposing; \"العارية\" (loan) as something transiently possessed.\n  * Al-Raghib (Mufradat): Worldly life as \"عارية\" (borrowed thing) from God, to be returned at death.\n  * Al-Zamakhshari (Asas): Literal = loaned object; Metaphorical = the body and lifespan as a trust (أمانة) from the Creator.\n- Sibawayh Rule: باب التوكيد بالتكرار (Emphatic Repetition) — Repetition of phrases like \"ويحك بادري\" and \"المبادرة المبادرة\" serves as syntactic emphasis (توكيد لفظي) to intensify the exhortation, a structure Sibawayh treats as permissible for rhetorical force without redundancy.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "42": [{"arabic": "في أضدادهم ما سلككم في سقر قالوا لم نك من المصلين فالمصلون هم ورثة الفردوس وهم المشاهدون لنور الله تعالى والمتمتعون بقربه ودنوه من قلوبهم نسأل الله أن يجعلنا منهم وأن يعيذنا من عقوبة من تزينت أقواله وقبحت أفعاله إنه الكريم المنان القديم الإحسان وصلى الله على كل عبد مصطفى", "english": "For the friends of God (awliyāʾ Allāh) who are granted unveiling of the dominion of the heavens and the earth (malakūt al-samāwāt wa-al-arḍ) and the secrets of lordship (asrār al-rubūbiyyah) — they are unveiled only in prayer, especially in prostration (sujūd), for the servant draws near to his Lord (Mighty and Majestic) through prostration. For this reason, He said, Most High: {«And prostrate and draw near»} (Q 96:19). And the unveiling of each worshiper is only to the measure of his purity from the turbidities of this world. It varies in strength and weakness, in abundance and scarcity, and in clarity and obscurity — until some are unveiled the very thing itself (al-shayʾ bi-ʿaynihi), while others are unveiled its likeness (al-shayʾ bi-mithālihi), just as some were shown this world in the form of a corpse, and Satan in the form of a dog crouching upon it, calling people to it.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 140", "section_title_en": "The Prayer of the Humble and the Unveiling of the Unveiled — Section 140", "section_index": 140, "anchors": "- Root: خ ش ع (kh-sh-ʿ)\n  * Lisan / Ayn: Core meaning of humility, submissiveness, and lowering oneself; the physical posture of one who is abased before a greater power.\n  * Al-Raghib (Mufradat): In theological terms, khushūʿ is the state of the heart's stillness and trembling before divine majesty, manifesting in the body's composure during ritual prayer (ṣalāh).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) refers to the physical lowering of the gaze and voice; metaphorical (majāz) extends to the soul's inner quietude and awe before God.\n- Root: ك ش ف (k-sh-f)\n  * Lisan / Ayn: To remove a covering, unveil, disclose; the act of stripping away an obstruction to reveal what lies beneath.\n  * Al-Raghib (Mufradat): In Quranic usage, kashf denotes divine removal of veils (kashf al-ḥijāb) — the uncovering of unseen realities (ghayb) to the heart, as in {«We have removed from you your covering»} (Q 50:22).\n  * Al-Zamakhshari (Asas): Literal: uncovering a physical object; metaphorical: the disclosure of spiritual truths (mukāshafah) to the purified heart, a technical term in Sufi epistemology.\n- Root: ص ل و (ṣ-l-w)\n  * Lisan / Ayn: The root denotes supplication, blessing, and the act of ritual prayer; also the burning of fire (iṣlāʾ), suggesting the consuming fervor of devotion.\n  * Al-Raghib (Mufradat): Al-ṣalāh is the act of turning toward God in worship, encompassing both the physical rites and the inner orientation of the soul; its perfection lies in the presence of the heart.\n  * Al-Zamakhshari (Asas): Literal: the performance of the prescribed ritual; metaphorical: the soul's \"burning\" with longing and its purification through the fire of sincere devotion.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The use of restrictive particles to single out the specific quality (khushūʿ) as the defining attribute of the believers' prayer, distinguishing it from mere mechanical performance.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Prayer'", "badge": "Du'a"}], "45": [{"arabic": "مسعود بسند صحيح + وإليه الإشارة بقوله تعالى وكنا نخوض مع الخائضين وبقوله تعالى فلا تقعدوا معهم حتى يخوضوا في حديث غيره إنكم إذا مثلهم وقال سلمان أكثر الناس ذنوبا يوم القيامة أكثرهم كلاما في معصية الله وقال ابن سيرين كان رجل من الأنصار يمر بمجلس لهم فيقول لهم توضئوا فإن بعض ما تقولون شر من الحدث فهذا هو الخوض في الباطل وهو وراء ما سيأتي من الغيبة والنميمة والفحش وغيرها بل هو الخوض في ذكر محظورات سبق وجودها أو تدبر للتوصل إليها من غير حاجة دينية إلى ذكرها ويدخل فيه أيضا الخوض في حكاية البدع والمذاهب الفاسدة", "english": "For Bilāl ibn al-Ḥārith has related that the Messenger of God — may God's blessings and peace be upon him — said: \"Indeed, a man speaks a word of God's good pleasure, not imagining that it reaches what it reaches, and God writes for him thereby His good pleasure until the Day of Resurrection. And indeed, a man speaks a word of God's wrath, not imagining that it reaches what it reaches, and God writes against him thereby His wrath until the Day of Resurrection.\" [The hadith of Bilāl ibn al-Ḥārith — \"Indeed, a man speaks a word of God's good pleasure\" — was transmitted by Ibn Mājah and al-Tirmidhī, who said it is ḥasan ṣaḥīḥ.] And ʿAlqamah used to say: \"How much speech has the hadith of Bilāl ibn al-Ḥārith prevented me from [uttering]!\"", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 661", "section_title_en": "The Third Affliction: Wading into Falsehood (al-Khawḍ fī al-Bāṭil)", "section_index": 661, "anchors": "- Root: خوض (Kha-Wa-D)\n  * Lisan / Ayn: Core meaning is wading or plunging into water, passing through it; the Kitab al-Ayn records it as \"الشروع في الماء والمرور فيه\" (entering into water and passing through it).\n  * Al-Raghib (Mufradat): In theological usage, it is predominantly employed in the Quranic context of blameworthy engagement — as in {«وخضتم كالذي خاضوا»} (And you waded as those before you waded) and {«ذرهم في خوضهم يلعبون»} (Leave them in their wading, playing). It denotes immersion in that which is vain or false.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) — physical wading in water. Metaphorical (Majaz) — \"خاضوا في الحديث وتخاوضوا فيه\" (they waded into speech and waded together in it), i.e., plunging into discourse; \"وهو يخوض مع الخائضين أي يبطل مع المبطلين\" (he wades with the waders, i.e., he engages in falsehood with those who engage in falsehood).\n- Root: بطل (Ba-Ta-La)\n  * Lisan / Ayn: The Kitab al-Ayn situates it within the semantic field of that which is null, void, or futile.\n  * Al-Raghib (Mufradat): \"الباطل: نقيض الحق، وهو ما لا ثبات له عند الفحص عنه\" (Al-Bāṭil is the opposite of truth, and it is that which has no stability upon examination). It applies to both speech and deed.\n  * Al-Zamakhshari (Asas): Literal — \"هو باطل بين البطلان\" (it is false, clearly false). Metaphorical — the verbal form \"بطل\" (to become null) and \"أبطله غيره\" (another nullified it), as in {«وبطل ما كانوا يعملون»} (And nullified is what they used to do).\n- Root: كلم (Ka-La-Ma)\n  * Lisan / Ayn: The Kitab al-Ayn treats it under the root of speech and utterance.\n  * Al-Raghib (Mufradat): \"الكلم: التأثير المدرك بإحدى الحاستين\" (Speech: the effect perceived by one of the two senses) — indicating that speech is that which produces an impression.\n  * Al-Zamakhshari (Asas): Literal — \"سمعته يتكلم بكذا\" (I heard him speaking such-and-such). Metaphorical — \"وهذه كلمة شاعرة\" (this is a penetrating word) and \"وهذا مما يكلم العرض والدين\" (this is something that wounds honor and religion) — speech that injures.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a preposition and its object, relevant here to the syntactic structure of \"الخوض في الباطل\" where the verbal noun governs its prepositional complement, and to the periodic constructions of the hadith citations where the conditional clauses (\"إن الرجل ليتكلم بالكلمة...\") require careful parsing of the apodosis.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'", "badge": "Hadith"}], "48": [{"arabic": "وبقوله {فما تنفعهم شفاعة الشافعين} وإذا انقسمت الذنوب إلا ما يشفع فيه وإلا ما لا يشفع فيه وجب الخوف والإشفاق لا محالة ولو كان ذنب تقبل فيه الشفاعة لما أمر قريشا بالطاعة ولما نهى رسول الله صلى الله عليه وسلم فاطمة رضي الله عنها عن المعصية ولكان يأذن لها في اتباع الشهوات لتكمل لذاتها في الدنيا ثم يشفع لها في الآخرة لتكمل لذاتها في الآخرة فالانهماك في الذنوب وترك التقوى اتكالا على رجاء الشفاعة يضاهي انهماك المريض في شهواته اعتمادا على طبيب حاذق قريب مشفق من أب أو أخ أو غيره وذل", "english": "If you say: \"He, peace and blessings be upon him, said after his words to Fāṭimah and Ṣafiyyah: 'I cannot avail you against God in anything, except that you have a tie of kinship which I will moisten with its moisture'\" — a ḥadīth [reported as]: \"Do you hope for my intercession, while the Banū ʿAbd al-Muṭṭalib do not hope for it?\" — narrated by al-Ṭabarānī in al-Awsaṭ from the narration of ʿAbd Allāh ibn Jaʿfar, and in it is Uṣayrim ibn Ḥawshab from Isḥāq ibn Wāṣil, and both are extremely weak — so that indicates that he will single out his relatives for intercession.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 882", "section_title_en": "Section 882 — On the Limits of Intercession, the Vices of Pride in Lineage, Numbers, Wealth, and Opinion, and Their Treatment", "section_index": 882, "anchors": "- Root: شفع (Sh-F-')\n  * Lisan / Ayn: Core meaning is pairing or joining; intercession (shafā'ah) is the joining of one's plea to another's cause.\n  * Al-Raghib (Mufradat): Intercession is the seeking of benefit for another; its acceptance is contingent upon divine permission and good pleasure, as restricted by the Qur'anic qualifiers.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) is the act of making a number even (from watr, odd); metaphorical (majāz) is the mediator's plea before authority.\n- Root: عجب (ʿ-J-B)\n  * Lisan / Ayn: Astonishment arising from an unknown cause; self-admiration (ʿujb) is a blameworthy state of being pleased with oneself.\n  * Al-Raghib (Mufradat): \"العجب والتعجب: حالة تعرض للإنسان عند الجهل بسبب الشيء\" — a state that overtakes a person due to ignorance of the cause; hence, it is impossible regarding God.\n  * Al-Zamakhshari (Asas): Literal: a wondrous thing; metaphorical: the one who performs marvels (taʿjābah). Self-admiration is the root of every error and innovation.\n- Root: رأي (R-'-Y)\n  * Lisan / Ayn: Opinion, view, or judgment formed through reflection.\n  * Al-Raghib (Mufradat): Ra'y is the considered opinion that may err or hit the mark; it is blameworthy when it becomes an object of ʿujb (self-admiration).\n  * Al-Zamakhshari (Asas): Literal: sight/vision; metaphorical: intellectual insight. The ḥadīth \"إعجاب كل ذي رأي برأيه\" (the admiration of every man of opinion for his own view) is cited as a sign of the age's corruption.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Qualification) — The conditional clauses (in-sharṭ) governing intercession, e.g., {إلا لمن ارتضى} and {إلا بإذنه}, impose necessary restrictions that negate any absolute reliance on intercession.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "56": [{"arabic": "ولا تقولن لشيء إني فاعل ذلك غدا إلا أن يشاء الله ثم لم يقتصر على ذلك فيما لا يشك فيه بل قال تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رءؤسكم ومقصرين وكان الله سبحانه عالما بأنهم يدخلون لا محالة وأنه شاءه ولكن المقصود تعليمه ذلك فتأدب رسول الله صلى الله عليه وسلم في ما كان يخبر عنه معلوما كان أو مشكوكا حتى قال صلى الله عليه وسلم لما دخل المقابر السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون (1) واللحوق بهم غير مشكوك فيه ولكن مقتضى الأدب ذكر الله تعالى وربط الأمور به وهذه الصيغ", "english": "If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 102", "section_title_en": "On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102", "section_index": 102, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 2985], [2, 2985, 4782]], "2": [[1, 250, 1033], [2, 1033, 2921]], "3": [[1, 250, 1652], [2, 1652, 2921]], "4": [[1, 250, 2157], [2, 2157, 3365]], "5": [[1, 250, 1868], [2, 1868, 2868]], "6": [[1, 350, 1523], [2, 1523, 2668], [3, 2668, 4442]], "7": [[1, 250, 1819], [2, 1819, 2973]], "8": [[1, 350, 1436], [2, 1436, 2145], [3, 2145, 2699], [4, 2699, 4704]], "9": [[1, 350, 1581], [2, 1581, 3237], [3, 3237, 4272], [4, 4272, 5514]], "10": [[1, 350, 1090], [2, 1090, 2571], [3, 2571, 3291], [4, 3291, 4312]], "11": [[1, 350, 1327], [2, 1327, 2070], [3, 2070, 3047], [4, 3047, 4469]], "12": [[1, 350, 1701], [2, 1701, 2151], [3, 2151, 3383], [4, 3383, 5409]], "13": [[1, 250, 1550], [2, 1550, 2894]], "14": [[1, 350, 2174], [2, 2174, 2664], [3, 2664, 4469]], "15": [[1, 350, 1283], [2, 1283, 2682], [3, 2682, 3260], [4, 3260, 4495]], "16": [[1, 400, 2091], [2, 2091, 3204], [3, 3204, 4085], [4, 4085, 6385], [5, 6385, 7926]], "17": [[1, 250, 1899], [2, 1899, 3626]], "18": [[1, 350, 1747], [2, 1747, 2899], [3, 2899, 4573]], "19": [[1, 250, 1298], [2, 1298, 2171], [3, 2171, 3156]], "20": [[1, 350, 1347], [2, 1347, 2246], [3, 2246, 3229], [4, 3229, 4338]], "21": [[1, 250, 1715], [2, 1715, 3077]], "22": [[1, 350, 1343], [2, 1343, 2266], [3, 2266, 3554]], "23": [[1, 350, 1282], [2, 1282, 2450], [3, 2450, 4260]], "24": [[1, 400, 1680], [2, 1680, 2267], [3, 2267, 4054], [4, 4054, 5268], [5, 5268, 6122], [6, 6122, 7429]], "25": [[1, 350, 914], [2, 914, 2633], [3, 2633, 3800], [4, 3800, 4749], [5, 4749, 5905]], "26": [[1, 250, 1799], [2, 1799, 2529]], "27": [[1, 350, 1808], [2, 1808, 3308], [3, 3308, 3877], [4, 3877, 4599]], "28": [[1, 250, 845], [2, 845, 1978], [3, 1978, 2916], [4, 2916, 3626]], "29": [[1, 250, 2047], [2, 2047, 3548]], "30": [[1, 350, 1800], [2, 1800, 2759], [3, 2759, 3554]], "31": [[1, 400, 1771], [2, 1771, 4566], [3, 4566, 6324], [4, 6324, 8447], [5, 8447, 9968], [6, 9968, 12208], [7, 12208, 13579],