it": "َàِh", "root": ""}, {"id": 55, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 56, "arabic": "ذِكْرَىٰ", "translit": "ٰàَrْkِhd", "root": "ذكر"}, {"id": 57, "arabic": "لِلْبَشَرِ", "translit": "ِrَhsَbْlِl", "root": "بشر"}], "hasIhya": true}, {"ayah": 32, "text": "كَلَّا وَٱلْقَمَرِ ", "translation": "No! By the moon", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "āَّlَk", "root": ""}, {"id": 2, "arabic": "وَٱلْقَمَرِ", "translit": "ِrَmَqْlٱَw", "root": "قمر"}], "hasIhya": false}, {"ayah": 33, "text": "وَٱلَّيْلِ إِذْ أَدْبَرَ ", "translation": "And [by] the night when it departs", "words": [{"id": 1, "arabic": "وَٱلَّيْلِ", "translit": "ِlْyَّlٱَw", "root": "ليل"}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَدْبَرَ", "translit": "َrَbْdَaʾ", "root": "دبر"}], "hasIhya": false}, {"ayah": 34, "text": "وَٱلصُّبْحِ إِذَآ أَسْفَرَ ", "translation": "And [by] the morning when it brightens,", "words": [{"id": 1, "arabic": "وَٱلصُّبْحِ", "translit": "ِḥْbُّṣlٱَw", "root": "صبح"}, {"id": 2, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَسْفَرَ", "translit": "َrَfْsَaʾ", "root": "سفر"}], "hasIhya": false}, {"ayah": 35, "text": "إِنَّهَا لَإِحْدَى ٱلْكُبَرِ ", "translation": "Indeed, it [i.e., the Fire] is of the greatest [afflictions]", "words": [{"id": 1, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَإِحْدَى", "translit": "àَdْḥِiʾَl", "root": "احد"}, {"id": 3, "arabic": "ٱلْكُبَرِ", "translit": "ِrَbُkْlٱ", "root": "كبر"}], "hasIhya": true}, {"ayah": 36, "text": "نَذِيرًا لِّلْبَشَرِ ", "translation": "As a warning to humanity -", "words": [{"id": 1, "arabic": "نَذِيرًا", "translit": "āًryِhdَn", "root": "نذر"}, {"id": 2, "arabic": "لِّلْبَشَرِ", "translit": "ِrَhsَbْlِّl", "root": "بشر"}], "hasIhya": false}, {"ayah": 37, "text": "لِمَن شَآءَ مِنكُمْ أَن يَتَقَدَّمَ أَوْ يَتَأَخَّرَ ", "translation": "To whoever wills among you to proceed[1] or stay behind.", "words": [{"id": 1, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَتَقَدَّمَ", "translit": "َmَّdَqَtَy", "root": "قدم"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "يَتَأَخَّرَ", "translit": "َrَّhkَaʾَtَy", "root": "اخر"}], "hasIhya": false}, {"ayah": 38, "text": "كُلُّ نَفْسٍۭ بِمَا كَسَبَتْ رَهِينَةٌ ", "translation": "Every soul, for what it has earned, will be retained[1]", "words": [{"id": 1, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 2, "arabic": "نَفْسٍۭ", "translit": "ٍۭsْfَn", "root": "نفس"}, {"id": 3, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 4, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 5, "arabic": "رَهِينَةٌ", "translit": "ٌẗَnyِhَr", "root": "رهن"}], "hasIhya": false}, {"ayah": 39, "text": "إِلَّآ أَصْحَٰبَ ٱلْيَمِينِ ", "translation": "Except the companions of the right,[1].", "words": [{"id": 1, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 2, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 3, "arabic": "ٱلْيَمِينِ", "translit": "ِnyِmَyْlٱ", "root": "يمن"}], "hasIhya": false}, {"ayah": 40, "text": "فِى جَنَّٰتٍ يَتَسَآءَلُونَ ", "translation": "[Who will be] in gardens, questioning each other", "words": [{"id": 1, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 2, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 3, "arabic": "يَتَسَآءَلُونَ", "translit": "َnwُlَءٓāَsَtَy", "root": "سال"}], "hasIhya": false}, {"ayah": 41, "text": "عَنِ ٱلْمُجْرِمِينَ ", "translation": "About the criminals,", "words": [{"id": 1, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 2, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}], "hasIhya": false}, {"ayah": 42, "text": "مَا سَلَكَكُمْ فِى سَقَرَ ", "translation": "[And asking them], \"What put you into Saqar?\"", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "سَلَكَكُمْ", "translit": "ْmُkَkَlَs", "root": "سلك"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "سَقَرَ", "translit": "َrَqَs", "root": ""}], "hasIhya": true}, {"ayah": 43, "text": "قَالُوا۟ لَمْ نَكُ مِنَ ٱلْمُصَلِّينَ ", "translation": "They will say, \"We were not of those who prayed,", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 3, "arabic": "نَكُ", "translit": "ُkَn", "root": "كون"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْمُصَلِّينَ", "translit": "َnyِّlَṣُmْlٱ", "root": "صلو"}], "hasIhya": false}, {"ayah": 44, "text": "وَلَمْ نَكُ نُطْعِمُ ٱلْمِسْكِينَ ", "translation": "Nor did we used to feed the poor.", "words": [{"id": 1, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 2, "arabic": "نَكُ", "translit": "ُkَn", "root": "كون"}, {"id": 3, "arabic": "نُطْعِمُ", "translit": "ُmِʿعْṭُn", "root": "طعم"}, {"id": 4, "arabic": "ٱلْمِسْكِينَ", "translit": "َnyِkْsِmْlٱ", "root": "سكن"}], "hasIhya": false}, {"ayah": 45, "text": "وَكُنَّا نَخُوضُ مَعَ ٱلْخَآئِضِينَ ", "translation": "And we used to enter into vain discourse with those who engaged [in it],", "words": [{"id": 1, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 2, "arabic": "نَخُوضُ", "translit": "ُḍwُhkَn", "root": "خوض"}, {"id": 3, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 4, "arabic": "ٱلْخَآئِضِينَ", "translit": "َnyِḍِyʾٓāَhkْlٱ", "root": "خوض"}], "hasIhya": true}, {"ayah": 46, "text": "وَكُنَّا نُكَذِّبُ بِيَوْمِ ٱلدِّينِ ", "translation": "And we used to deny the Day of Recompense", "words": [{"id": 1, "arabic": "وَكُنَّا", "translit": "āَّnُkَw", "root": "كون"}, {"id": 2, "arabic": "نُكَذِّبُ", "translit": "ُbِّhdَkُn", "root": "كذب"}, {"id": 3, "arabic": "بِيَوْمِ", "translit": "ِmْwَyِb", "root": "يوم"}, {"id": 4, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}], "hasIhya": false}, {"ayah": 47, "text": "حَتَّىٰٓ أَتَىٰنَا ٱلْيَقِينُ ", "translation": "Until there came to us the certainty [i.e., death].\"", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "أَتَىٰنَا", "translit": "āَnٰàَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "ٱلْيَقِينُ", "translit": "ُnyِqَyْlٱ", "root": "يقن"}], "hasIhya": false}, {"ayah": 48, "text": "فَمَا تَنفَعُهُمْ شَفَٰعَةُ ٱلشَّٰفِعِينَ ", "translation": "So there will not benefit them the intercession of [any] intercessors.", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "تَنفَعُهُمْ", "translit": "ْmُhُʿعَfnَt", "root": "نفع"}, {"id": 3, "arabic": "شَفَٰعَةُ", "translit": "ُẗَʿعَٰfَhs", "root": "شفع"}, {"id": 4, "arabic": "ٱلشَّٰفِعِينَ", "translit": "َnyِʿعِfَّٰhslٱ", "root": "شفع"}], "hasIhya": true}, {"ayah": 49, "text": "فَمَا لَهُمْ عَنِ ٱلتَّذْكِرَةِ مُعْرِضِينَ ", "translation": "Then what is [the matter] with them that they are, from the reminder, turning away", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلتَّذْكِرَةِ", "translit": "ِẗَrِkْhdَّtlٱ", "root": "ذكر"}, {"id": 5, "arabic": "مُعْرِضِينَ", "translit": "َnyِḍِrْʿعُm", "root": "عرض"}], "hasIhya": false}, {"ayah": 50, "text": "كَأَنَّهُمْ حُمُرٌ مُّسْتَنفِرَةٌ ", "translation": "As if they were alarmed donkeys", "words": [{"id": 1, "arabic": "كَأَنَّهُمْ", "translit": "ْmُhَّnَaʾَk", "root": ""}, {"id": 2, "arabic": "حُمُرٌ", "translit": "ٌrُmُḥ", "root": "حمر"}, {"id": 3, "arabic": "مُّسْتَنفِرَةٌ", "translit": "ٌẗَrِfnَtْsُّm", "root": "نفر"}], "hasIhya": false}, {"ayah": 51, "text": "فَرَّتْ مِن قَسْوَرَةٍۭ ", "translation": "Fleeing from a lion?", "words": [{"id": 1, "arabic": "فَرَّتْ", "translit": "ْtَّrَf", "root": "فرر"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "قَسْوَرَةٍۭ", "translit": "ٍۭẗَrَwْsَq", "root": "قسر"}], "hasIhya": false}, {"ayah": 52, "text": "بَلْ يُرِيدُ كُلُّ ٱمْرِئٍ مِّنْهُمْ أَن يُؤْتَىٰ صُحُفًا مُّنَشَّرَةً ", "translation": "Rather, every person among them desires that he[1] would be given scriptures spread about.[2]", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 3, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 4, "arabic": "ٱمْرِئٍ", "translit": "ٍyʾِrْmٱ", "root": "مرا"}, {"id": 5, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "يُؤْتَىٰ", "translit": "ٰàَtْwʾُy", "root": "اتي"}, {"id": 8, "arabic": "صُحُفًا", "translit": "āًfُḥُṣ", "root": "صحف"}, {"id": 9, "arabic": "مُّنَشَّرَةً", "translit": "ًẗَrَّhsَnُّm", "root": "نشر"}], "hasIhya": false}, {"ayah": 53, "text": "كَلَّاۖ بَل لَّا يَخَافُونَ ٱلْءَاخِرَةَ ", "translation": "No! But they do not fear the Hereafter.", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "āَّlَk", "root": ""}, {"id": 2, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 3, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 4, "arabic": "يَخَافُونَ", "translit": "َnwُfāَhkَy", "root": "خوف"}, {"id": 5, "arabic": "ٱلْءَاخِرَةَ", "translit": "َẗَrِhkāَءْlٱ", "root": "اخر"}], "hasIhya": false}, {"ayah": 54, "text": "كَلَّآ إِنَّهُۥ تَذْكِرَةٌ ", "translation": "No! Indeed, it [i.e., the Qur’ān] is a reminder", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "تَذْكِرَةٌ", "translit": "ٌẗَrِkْhdَt", "root": "ذكر"}], "hasIhya": false}, {"ayah": 55, "text": "فَمَن شَآءَ ذَكَرَهُۥ ", "translation": "Then whoever wills will remember it.", "words": [{"id": 1, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 2, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 3, "arabic": "ذَكَرَهُۥ", "translit": "ۥُhَrَkَhd", "root": "ذكر"}], "hasIhya": false}, {"ayah": 56, "text": "وَمَا يَذْكُرُونَ إِلَّآ أَن يَشَآءَ ٱللَّهُۚ هُوَ أَهْلُ ٱلتَّقْوَىٰ وَأَهْلُ ٱلْمَغْفِرَةِ ", "translation": "And they will not remember except that Allāh wills. He is worthy of fear and adequate for [granting] forgiveness.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يَذْكُرُونَ", "translit": "َnwُrُkْhdَy", "root": "ذكر"}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَشَآءَ", "translit": "َءٓāَhsَy", "root": "شيا"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "أَهْلُ", "translit": "ُlْhَaʾ", "root": "اهل"}, {"id": 9, "arabic": "ٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱ", "root": "وقي"}, {"id": 10, "arabic": "وَأَهْلُ", "translit": "ُlْhَaʾَw", "root": "اهل"}, {"id": 11, "arabic": "ٱلْمَغْفِرَةِ", "translit": "ِẗَrِfْغَmْlٱ", "root": "غفر"}], "hasIhya": true}], "tafsir": {"8": [{"arabic": "وروى أن زرارة بن أوفى لما انتهى إلى قوله تعالى: ﴿ فإذا نقر في الناقور ﴾ {} خر ميتا. وكان إبراهيم النخعي إذا سمع قوله تعالى ﴿ إذا السماء انشقت ﴾ {} اضطرب حتى تضطرب أوصاله. وقال عبد الله بن واقد: رأيت ابن عمر يصلي مغلوبا عليه. وحق له أن يحترق قلبه بوعد سيده ووعيده فإنه عبد مذنب ذليل بين يدي جبار قاهر وتكون هذه المعاني بحسب درجات الفهم ويكون الفهم بحسب وفور العلم وصفاء القلب ودرجات ذلك لا تنحصر والصلاة مفتاح القلوب فيها تنكشف أسرار الكلمات فهذا حق القراءة وهو حق الأذكار والتسبيحات أيضا ثم يراعى اله", "english": "And it is narrated that when Zurarah bin Awfa reached the saying of Allah the Exalted: 'So when the Trumpet (An-Naqur) is blown (Naqira)' (Quran 74:8), he fell dead. And Ibrahim An-Nakha'i, when he heard the saying of Allah the Exalted 'When the sky is split asunder' (Quran 84:1), would tremble until his limbs trembled. And Abdullah bin Waqid said: I saw Ibn Umar praying overwhelmed. And it is right for him that his Heart (Qalb) burns with the promise of his Master and His threat, for he is a sinful servant, humble before a Compelling, Overpowering One. And these meanings are according to the degrees of understanding, and understanding is according to the abundance of knowledge and the purity of the Heart (Qalb), and the degrees of that are not limited. And prayer is the key to the Hearts (Qulub); in it the secrets of the words are unveiled. This is the right of recitation, and it is also the right of the Remembrances (Adhkar) and Glorifications (Tasbihat). Then awe is observed in the recitation, so he recites slowly and deliberately, not rapidly, for that is easier for contemplation, and he differentiates between its tones in the verse of mercy and punishment, promise and threat, praise, magnification, and exaltation.", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Prayer'", "badge": "Insight"}, {"arabic": "فلو لم يكن بين يدي الموتي إلا هول تلك النفخة لكان ذلك جديرا بأن يتقى فإنها نفخة وصيحة يصعق بها من فى السموات والأرض يعنى يموتون بها إلا من شاء الله وهو بعض الملائكة ولذلك قال رسول الله ﭬ: (كيف أنعم وصاحب الصور قد التقم القرن وحنى الجبهة وأصغى بالأذن متى يؤمر فينفخ[144]) قال مقاتل: الصور هو القرن وذلك أن إسرافيل عليه السلام واضع فاه على القرن كهيئة البوق ودائرة رأس القرن كعرض السموات والأرض وهو شاخص بصره نحو العرش ينتظر متى يؤمر فينفخ النفخة الأولى فإذا نفخ صعق من فى السموات والأرض أى مات كل حيوا", "english": "If there were nothing before the dead except the terror of that blowing (of the Horn), it would be worthy of being feared, for it is a blowing and a cry by which those in the heavens and the earth are struck unconscious (صعق), meaning they die by it except whom Allah wills, and that is some of the angels. And for that reason, the Messenger of Allah (peace be upon him) said: 'How can I enjoy comfort when the possessor of the Horn (الصور) has taken the Horn into his mouth, lowered his forehead, and inclined his ear, waiting for when he will be commanded to blow?' [144] Maqatil said: The Horn (الصور) is the trumpet (القرن), and that is because Israfil (upon him be peace) places his mouth on the Horn like the form of a trumpet, and the circumference of the head of the Horn is like the expanse of the heavens and the earth, and he is fixing his gaze toward the Throne (العرش), waiting for when he will be commanded to blow the first blowing. And when he blows, those in the heavens and the earth are struck unconscious (صعق), meaning every living creature dies from the intensity of the terror except whom Allah wills, and that is Jibril, Mika'il, Israfil, and the Angel of Death (ملك الموت). Then the Angel of Death is commanded to take the soul (روح) of Jibril, then the soul of Mika'il, then the soul of Israfil, then the Angel of Death is commanded and he dies. Then the creation remains after the first blowing in...", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}, {"arabic": "وقال صالح المري قرأت على رجل من المتعبدين ﴿ يوم تقلب وجوههم في النار يقولون يا ليتنا أطعنا الله وأطعنا الرسولا ﴾{} فصعق ثم أفاق فقال زدني يا صالح فإني أجد غما فقرأت ﴿ كلما أرادوا أن يخرجوا منها أعيدوا فيها ﴾{} فخر ميتا، وروي أن زرارة بن أبي أوفى صلى بالناس الغداة فلما قرأ ﴿ فإذا نقر في الناقور ﴾{} خر مغشيا عليه فحمل ميتا.", "english": "And Salih al-Murri said: I recited to a man from the worshippers (al-Muta'abbidin) 'The day their faces will be turned over in the Fire, they will say: Would that we had obeyed Allah and obeyed the Messenger' (Quran 33:66), so he fainted then regained consciousness and said: Increase me, O Salih, for I find distress. So I recited 'Whenever they desire to go forth from it, they are returned into it' (Quran 32:20), and he fell dead. And it is narrated that Zurarah ibn Abi Awfa led the people in the morning prayer, and when he recited 'Then when the Trumpet (al-Naqur) is blown' (Quran 74:8), he fell unconscious and was carried dead.", "book_file": "vol4_Vol4-book3.doc.txt", "book_title": "Fear and Hope", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Fear and Hope'", "badge": "Du'a"}, {"arabic": "وَرَوَى أَنَّ زُرَارَةَ بْنَ أَوْفَى وَكَانَ مِنَ التَّابِعِينَ كَانَ يُؤُمُّ النَّاسَ بِالرَّقَّةِ فَقَرَأَ فَإِذَا نُقِرَ فِي النَّاقُورِ فَصَعَقَ وَمَاتَ فِي مِحْرَابِهِ رَحِمَهُ اللَّهُ", "english": "And it was narrated that Zurarah ibn Awfa, who was from the Followers (Tabi'un), was leading the people in prayer in Al-Raqqah, and he recited 'So when the Trumpet is blown (fa-idha nuqira fi al-naqur)', then he fell unconscious (fa-sa'aqa) and died in his prayer niche (mihrab), may Allah have mercy on him.", "book_file": "vol2_j2-k08.doc.txt", "book_title": "Audition and Ecstasy", "content_type": "dua", "topic": "Al-Ghazali on supplications and their spiritual significance, from 'Audition and Ecstasy'", "badge": "Du'a"}], "31": [{"arabic": "قال الله تعالى وما يعلم جنود ربك إلا هو فلله سبحانه في القلوب والأرواح وغيرها من العوالم جنود مجندة لا يعرف حقيقتها وتفصيل عددها إلا هو ونحن الآن نشير إلى بعض جنود القلب فهو الذي يتعلق بغرضنا وله جندان جند يرى بالأبصار وجند لا يرى إلا بالبصائر وهو في حكم الملك والجنود في حكم الخدم والأعوان فهذا معنى الجند فأما جنده المشاهد بالعين فهو اليد والرجل والعين والأذن واللسان وسائر الأعضاء الظاهرة والباطنة فإن جميعها خادمة للقلب ومسخرة له فهو المتصرف فيها والمردد لها وقد خلقت مجبولة على طاعته لا تستطيع ل", "english": "Allah the Exalted said: 'And none knows the hosts of your Lord except Him.' So for Allah, glorified be He, in the hearts (Qulub) and spirits (Arwah) and other worlds are mustered hosts whose reality and detailed number none knows except Him. And we now point to some of the hosts of the heart (Qalb), for that relates to our purpose. It has two hosts: a host seen with the eyes and a host seen only with the insights (Basa'ir). It is in the position of the king, and the hosts are in the position of servants and helpers. This is the meaning of host. As for its host witnessed with the eye, it is the hand, the leg, the eye, the ear, the tongue, and the rest of the apparent and hidden organs, for all of them are servants to the heart (Qalb) and subjugated to it. It is the one disposing them and turning them. They were created molded to obey it, unable to oppose it or rebel against it. If it commands the eye to open, it opens; if it commands the leg to move, it moves; if it commands the tongue to speak and decides the judgment with it, it speaks, and likewise the rest of the organs. And the subjugation of the organs and senses to the heart (Qalb) resembles in one aspect the subjugation of the angels to Allah the Exalted, for they are molded to obedience, unable to oppose Him, rather they do not disobey Allah in what He commands them and they do what they are commanded. They only differ in something, which is that the angels, peace be upon them, are aware of their obedience and compliance, while the eyelids obey the heart (Qalb) in opening and closing by way of subjugation and have no awareness of themselves and of their obedience to the heart (Qalb). And only...", "book_file": "vol3_j3-k01.doc.txt", "book_title": "Disciplining the Soul", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Disciplining the Soul'", "badge": "Insight"}], "35": [{"arabic": "وقال حذيفة: ما من صباح ولا مساء إلا ومنادى ينادى أيها الناس الرحيل الرحيل وتصديق ذلك قوله تعالى ﴿ إنها لإحدى الكبر نذيرا للبشر لمن شاء منكم أن يتقدم أو يتأخر ﴾ {} في الموت.", "english": "And Hudhayfah said: There is no morning or evening except that a caller calls out, 'O people, the departure, the departure!' And the confirmation of that is His saying, the Exalted: 'Indeed it is one of the greatest, a warner to humankind for whoever among you wishes to advance or to delay' in death.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Book of Repentance'", "badge": "Afterlife"}], "42": [{"arabic": "فوصفهم بالفلاح أوّلا وبوراثة الفردوس آخرا وما عندي أن هذرمة اللسان مع غفلة القلب تنتهي إلى هذا الحد ولذلك قال الله عز وجل في أضدادهم: ﴿ ما سلككم في سقر قالوا لم نك من المصلين ﴾ {} فالمصلون هم ورثة الفردوس وهم المشاهدون لنور الله تعالى والمتمتعون بقربه ودنوه من قلوبهم. نسأل الله أن يجعلنا منهم وأن يعيذنا من عقوبة من تزينت أقواله وقبحت أفعاله إنه الكريم المنان القديم الإحسان وصلى الله على كل عبد مصطفى.", "english": "He described them with success (al-Falah) first and with inheritance of Paradise (al-Firdaws) last, and in my opinion, the babbling of the tongue with heedlessness of the Heart (Qalb) does not reach this limit. Therefore, Allah the Exalted said about their opposites: 'What has caused you to enter Saqar?' They said, 'We were not of those who prayed (al-Musallin).' {} So the ones who pray (al-Musallin) are the inheritors of Paradise (al-Firdaws), and they are the witnesses to the Light (Nur) of Allah the Exalted and those who enjoy His Nearness (Qurb) and Proximity (Dunuww) to their Hearts (Qulub). We ask Allah to make us among them and to protect us from the punishment of one whose words are adorned and whose actions are ugly. Indeed, He is the Generous (al-Karim), the Bestower (al-Mannan), the Ancient (al-Qadim), the Beneficent (al-Ihsan). And may Allah bless every chosen servant (Abd Mustafa).", "book_file": "vol1_Vol1-book-4.doc.txt", "book_title": "Mysteries of Prayer", "content_type": "spiritual", "topic": "Al-Ghazali's insights on the inner dimensions of faith, from 'Mysteries of Prayer'", "badge": "Insight"}], "45": [{"arabic": "وقال ﭬ \"أعظم الناس خطايا يوم القيامة أكثرهم خوضاً في الباطل\"[40] وإليه الإشارة بقوله تعالى \"وَكُنَّا نَخُوضُ مَعَ الْخَائِضِينَ\" وبقوله تعالى \"فَلَا تَقْعُدُوا مَعَهُمْ حَتَّىٰ يَخُوضُوا فِي حَدِيثٍ غَيْرِهِ ۚ إِنَّكُمْ إِذًا مِّثْلُهُمْ\" وقال سلمان: أكثر الناس ذنوباً يوم القيامة أكثرهم كلاماً في معصية الله. وقال ابن سيرين: كان رجل من الأنصار يمر بمجلس لهم فيقول لهم توضئوا فإن بعض ما تقولون شر من الحديث. فهذا هو الخوض في الباطل وهو وراء ما سيأتي من الغيبة والنميمة والفحش وغيرها، بل هو الخوض في ذ", "english": "And the Prophet (peace be upon him) said: \"The greatest of people in sins on the Day of Resurrection are those who most engage in falsehood (al-Bāṭil).\" [40] And to this is the allusion in His saying, the Exalted: \"And we used to engage (nakhūḍu) with those who engage (al-khā'iḍīn)\" and in His saying, the Exalted: \"So do not sit with them until they engage in a discourse other than it; indeed, you would then be like them.\" And Salmān said: \"The most sinful of people on the Day of Resurrection are those who speak most in disobedience to Allah.\" And Ibn Sīrīn said: \"A man from the Helpers (al-Anṣār) would pass by a gathering of theirs and say to them: 'Perform ablution (wudū'), for some of what you say is worse than idle talk.'\" This is the engaging in falsehood (al-Bāṭil), and it is beyond what will come of backbiting (al-Ghībah), tale-bearing (al-Namīmah), obscenity (al-Faḥsh), and others. Rather, it is the engaging in mentioning prohibitions that have already occurred or contemplating to reach them without a religious need to mention them.", "book_file": "vol3_Vol3-book4a.doc.txt", "book_title": "Condemnation of Anger and Hatred", "content_type": "afterlife", "topic": "Al-Ghazali on death, the grave, and preparation for the Hereafter, from 'Condemnation of Anger and Hatred'", "badge": "Afterlife"}], "48": [{"arabic": "فإن قلت: فقد قال ﭬ بعد قوله لفاطمة وصفية \"إني لا إني عنكما من الله شيئاً إلا أن لكم رحماً سأبلها ببلاها\"[96] وقال عليه الصلاة والسلام \"أترجو سليم شفاعتي ولا يرجوها بنو عبد المطلب\"[97] فذلك يدل على أنه سيخصص قرابته بالشفاعة؟ فاعلم أن كل مسلم فهو منتظر شفاعة رسول الله ﭬ، والنسيب أيضاً جدير بأن يرجوها لكن بشرط أن يتقي الله أن يغضب عليه، فإنه إن يغضب عليه فلا يأذن لأحد في شفاعته، لأن الذنوب منقسمة إلى ما يوجب المقت فلا يؤذن في الشفاعة له، وإلى ما يعفى عنه بسبب الشفاعة، كالذنوب عند ملوك الدنيا فإن كل", "english": "If you say: Indeed, he (peace be upon him) said after his statement to Fatimah and Safiyyah, \"I cannot avail you anything from Allah except that you have kinship ties which I will fulfill with their due,\" and he (peace and blessings be upon him) said, \"Do you hope, Salim, for my intercession (Shafa'ah) while the sons of Abd al-Muttalib do not hope for it?\" Does that indicate that he will specifically grant his relatives intercession (Shafa'ah)? Know that every Muslim is awaiting the intercession (Shafa'ah) of the Messenger of Allah (peace be upon him), and the relative is also worthy of hoping for it, but on the condition that he guards against Allah's anger upon him, for if He is angry with him, then He does not permit anyone to intercede (Shafa'ah) for him. This is because sins are divided into those that necessitate wrath, so intercession (Shafa'ah) is not permitted for them, and those that are forgiven due to intercession (Shafa'ah), like sins with worldly kings, for every person of status with the king cannot intercede (Shafa'ah) in matters where the king's anger is severe. Thus, among sins are those from which intercession (Shafa'ah) does not save, and about this is the expression in His saying, \"Nor will they intercede (Yashfa'una) except for whom He approves,\" and in His saying, \"Who is it that can intercede (Yashfa'u) with Him except by His permission?\" and in His saying, \"And intercession (Shafa'ah) does not benefit with Him except for whom He permits,\" and in His saying, \"So their intercession (Shafa'ah) of the intercessors (Shafi'in) will not benefit them.\" And when sins are divided into those in which intercession (Shafa'ah) is granted and those in which it is not, fear and apprehension are inevitably obligatory. If there were a sin in which intercession (Shafa'ah) is accepted, He would not have commanded the Quraysh to obey, nor would the Messenger of Allah (peace be upon him) have prohibited Fatimah (may Allah be pleased with her) from disobedience, and He would have permitted her to follow desires to complete her self in this world, then intercede (Shafa'ah) for her in the Hereafter to complete her self in the Hereafter.", "book_file": "vol3_Vol3-book-9a.doc.txt", "book_title": "Condemnation of Pride and Conceit", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "56": [{"arabic": "إذن الأمر أمر الله والقضاء قضاؤه وعصمه الله من كل ما تخوفت عليه من أمر الدنيا والدين", "english": "Then the matter is Allah's matter and the decree is His decree, and Allah protected him from everything I feared for him regarding worldly and religious matters.", "book_file": "vol4_Vol4-book10.doc.txt", "book_title": "Book of Repentance", "content_type": "ethics", "topic": "Al-Ghazali on the diseases of the heart and their cure, from 'Book of Repentance'", "badge": "Ethics"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 2985], [2, 2985, 4782]], "2": [[1, 250, 1033], [2, 1033, 2921]], "3": [[1, 250, 1652], [2, 1652, 2921]], "4": [[1, 250, 2157], [2, 2157, 3365]], "5": [[1, 250, 1868], [2, 1868, 2868]], "6": [[1,