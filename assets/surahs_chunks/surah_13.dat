ُّ", "translit": "", "root": ""}, {"id": 13, "arabic": "نَفْسࣲۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَسَيَعْلَمُ", "translit": "", "root": ""}, {"id": 15, "arabic": "اُ۬لْكَٰفِرُ", "translit": "", "root": ""}, {"id": 16, "arabic": "لِمَنْ", "translit": "", "root": ""}, {"id": 17, "arabic": "عُقْبَي", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬لدّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 13, "ayah": 43, "text": "وَيَقُولُ اُ۬لذِينَ كَفَرُواْ لَسْتَ مُرْسَلاࣰۖ قُلْ كَف۪يٰ بِاللَّهِ شَهِيداَۢ بَيْنِے وَبَيْنَكُمْ وَمَنْ عِندَهُۥ عِلْمُ اُ۬لْكِتَٰبِۖ", "words": [{"id": 1, "arabic": "وَيَقُولُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَسْتَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُرْسَلاࣰۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَف۪يٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "شَهِيداَۢ", "translit": "", "root": ""}, {"id": 10, "arabic": "بَيْنِے", "translit": "", "root": ""}, {"id": 11, "arabic": "وَبَيْنَكُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَمَنْ", "translit": "", "root": ""}, {"id": 13, "arabic": "عِندَهُۥ", "translit": "", "root": ""}, {"id": 14, "arabic": "عِلْمُ", "translit": "", "root": ""}, {"id": 15, "arabic": "اُ۬لْكِتَٰبِۖ", "translit": "", "root": ""}], "narration": "warsh"}]}