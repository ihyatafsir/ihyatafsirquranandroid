ُلِ اِ۬للَّهُۖ قُلَ اَفَاتَّخَذتُّم مِّن دُونِهِۦٓ أَوْلِيَآءَ لَا يَمْلِكُونَ لِأَنفُسِهِمْ نَفْعاࣰ وَلَا ضَرّاࣰۖ قُلْ هَلْ يَسْتَوِے اِ۬لَاعْم۪يٰ وَالْبَصِيرُۖ أَمْ هَلْ تَسْتَوِے اِ۬لظُّلُمَٰتُ وَالنُّورُۖ أَمْ جَعَلُواْ لِلهِ شُرَكَآءَ خَلَقُواْ كَخَلْقِهِۦ فَتَشَٰبَهَ اَ۬لْخَلْقُ عَلَيْهِمْۖ قُلِ اِ۬للَّهُ خَٰلِقُ كُلِّ شَےْءࣲۖ وَهُوَ اَ۬لْوَٰحِدُ اُ۬لْقَهَّٰرُۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "رَّبُّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "قُلَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَفَاتَّخَذتُّم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 11, "arabic": "دُونِهِۦٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَوْلِيَآءَ", "translit": "", "root": ""}, {"id": 13, "arabic": "لَا", "translit": "", "root": ""}, {"id": 14, "arabic": "يَمْلِكُونَ", "translit": "", "root": ""}, {"id": 15, "arabic": "لِأَنفُسِهِمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "نَفْعاࣰ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 18, "arabic": "ضَرّاࣰۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 20, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 21, "arabic": "يَسْتَوِے", "translit": "", "root": ""}, {"id": 22, "arabic": "اِ۬لَاعْم۪يٰ", "translit": "", "root": ""}, {"id": 23, "arabic": "وَالْبَصِيرُۖ", "translit": "", "root": ""}, {"id": 24, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 25, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 26, "arabic": "تَسْتَوِے", "translit": "", "root": ""}, {"id": 27, "a