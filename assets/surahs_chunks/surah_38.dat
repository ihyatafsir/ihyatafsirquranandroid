ot": ""}, {"id": 3, "arabic": "اَ۬لْجِبَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَعَهُۥ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُسَبِّحْنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالْعَشِيِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالِاشْرَاقِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 19, "text": "وَالطَّيْرَ مَحْشُورَةࣰۖ كُلࣱّ لَّهُۥٓ أَوَّابࣱۖ", "words": [{"id": 1, "arabic": "وَالطَّيْرَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَحْشُورَةࣰۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلࣱّ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّهُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَوَّابࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 20, "text": "وَشَدَدْنَا مُلْكَهُۥ وَءَاتَيْنَٰهُ اُ۬لْحِكْمَةَ وَفَصْلَ اَ۬لْخِطَابِۖ", "words": [{"id": 1, "arabic": "وَشَدَدْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مُلْكَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَءَاتَيْنَٰهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْحِكْمَةَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَفَصْلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْخِطَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 21, "text": "۞وَهَلَ اَت۪يٰكَ نَبَؤُاْ اُ۬لْخَصْمِ إِذْ تَسَوَّرُواْ اُ۬لْمِحْرَابَ", "words": [{"id": 1, "arabic": "۞وَهَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَت۪يٰكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَبَؤُاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْخَصْمِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَسَوَّرُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْمِحْرَابَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 22, "text": "إِذْ دَخَلُواْ عَلَيٰ دَاوُۥدَ فَفَزِعَ مِنْهُمْ قَالُواْ لَا تَخَف