{"surah":38,"verses":[{"ayah":1,"text":"صٓۚ وَٱلْقُرْءَانِ ذِى ٱلذِّكْرِ ","translation":"Ṣād.[1] By the Qur’ān containing reminder...[2]","words":[{"id":1,"arabic":"صٓ","translit":"ٓṣ","root":""},{"id":2,"arabic":"وَٱلْقُرْءَانِ","translit":"ِnāَءْrُqْlٱَw","root":"قرا"},{"id":3,"arabic":"ذِى","translit":"àِhd","root":""},{"id":4,"arabic":"ٱلذِّكْرِ","translit":"ِrْkِّhdlٱ","root":"ذكر"}],"hasIhya":false},{"ayah":2,"text":"بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى عِزَّةٍ وَشِقَاقٍ ","translation":"But those who disbelieve are in pride and dissension.","words":[{"id":1,"arabic":"بَلِ","translit":"ِlَb","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"عِزَّةٍ","translit":"ٍẗَّzِʿع","root":"عزز"},{"id":6,"arabic":"وَشِقَاقٍ","translit":"ٍqāَqِhsَw","root":"شقق"}],"hasIhya":false},{"ayah":3,"text":"كَمْ أَهْلَكْنَا مِن قَبْلِهِم مِّن قَرْنٍ فَنَادَوا۟ وَّلَاتَ حِينَ مَنَاصٍ ","translation":"How many a generation have We destroyed before them, and they [then] called out; but it was not a time for escape.","words":[{"id":1,"arabic":"كَمْ","translit":"ْmَk","root":""},{"id":2,"arabic":"أَهْلَكْنَا","translit":"āَnْkَlْhَaʾ","root":"هلك"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"قَبْلِهِم","translit":"mِhِlْbَq","root":"قبل"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"قَرْنٍ","translit":"ٍnْrَq","root":"قرن"},{"id":7,"arabic":"فَنَادَوا۟","translit":"۟āwَdāَnَf","root":"ندي"},{"id":8,"arabic":"وَّلَاتَ","translit":"َtāَlَّw","root":"لوت"},{"id":9,"arabic":"حِينَ","translit":"َnyِḥ","root":"حين"},{"id":10,"arabic":"مَنَاصٍ","translit":"ٍṣāَnَm","root":"نوص"}],"hasIhya":false},{"ayah":4,"text":"وَعَجِبُوٓا۟ أَن جَآءَهُم مُّنذِرٌ مِّنْهُمْۖ وَقَالَ ٱلْكَٰفِرُونَ هَٰذَا سَٰحِرٌ كَذَّابٌ ","translation":"And they wonder that there has come to them a warner [i.e., Prophet Muḥammad (ﷺ)] from among themselves. And the disbelievers say, \"This is a magician and a liar.","words":[{"id":1,"arabic":"وَعَجِبُوٓا۟","translit":"۟āٓwُbِjgَʿعَw","root":"عجب"},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"جَآءَهُم","translit":"mُhَءٓāَjg","root":"جيا"},{"id":4,"arabic":"مُّنذِرٌ","translit":"ٌrِhdnُّm","root":"نذر"},{"id":5,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":6,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":7,"arabic":"ٱلْكَٰفِرُونَ","translit":"َnwُrِfَٰkْlٱ","root":"كفر"},{"id":8,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":9,"arabic":"سَٰحِرٌ","translit":"ٌrِḥَٰs","root":"سحر"},{"id":10,"arabic":"كَذَّابٌ","translit":"ٌbāَّhdَk","root":"كذب"}],"hasIhya":false},{"ayah":5,"text":"أَجَعَلَ ٱلْءَالِهَةَ إِلَٰهًا وَٰحِدًاۖ إِنَّ هَٰذَا لَشَىْءٌ عُجَابٌ ","translation":"Has he made the gods [only] one God? Indeed, this is a curious thing.\"","words":[{"id":1,"arabic":"أَجَعَلَ","translit":"َlَʿعَjgَaʾ","root":"جعل"},{"id":2,"arabic":"ٱلْءَالِهَةَ","translit":"َẗَhِlāَءْlٱ","root":"اله"},{"id":3,"arabic":"إِلَٰهًا","translit":"āًhَٰlِiʾ","root":"اله"},{"id":4,"arabic":"وَٰحِدًا","translit":"āًdِḥَٰw","root":"وحد"},{"id":5,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":6,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":7,"arabic":"لَشَىْءٌ","translit":"ٌءْàَhsَl","root":"شيا"},{"id":8,"arabic":"عُجَابٌ","translit":"ٌbāَjgُʿع","root":"عجب"}],"hasIhya":false},{"ayah":6,"text":"وَٱنطَلَقَ ٱلْمَلَأُ مِنْهُمْ أَنِ ٱمْشُوا۟ وَٱصْبِرُوا۟ عَلَىٰٓ ءَالِهَتِكُمْۖ إِنَّ هَٰذَا لَشَىْءٌ يُرَادُ ","translation":"And the eminent among them went forth, [saying], \"Continue, and be patient over [the defense of] your gods. Indeed, this is a thing intended.[1]","words":[{"id":1,"arabic":"وَٱنطَلَقَ","translit":"َqَlَṭnٱَw","root":"طلق"},{"id":2,"arabic":"ٱلْمَلَأُ","translit":"ُaʾَlَmْlٱ","root":"ملا"},{"id":3,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":4,"arabic":"أَنِ","translit":"ِnَaʾ","root":""},{"id":5,"arabic":"ٱمْشُوا۟","translit":"۟āwُhsْmٱ","root":"مشي"},{"id":6,"arabic":"وَٱصْبِرُوا۟","translit":"۟āwُrِbْṣٱَw","root":"صبر"},{"id":7,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":8,"arabic":"ءَالِهَتِكُمْ","translit":"ْmُkِtَhِlāَء","root":"اله"},{"id":9,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":10,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":11,"arabic":"لَشَىْءٌ","translit":"ٌءْàَhsَl","root":"شيا"},{"id":12,"arabic":"يُرَادُ","translit":"ُdāَrُy","root":"رود"}],"hasIhya":false},{"ayah":7,"text":"مَا سَمِعْنَا بِهَٰذَا فِى ٱلْمِلَّةِ ٱلْءَاخِرَةِ إِنْ هَٰذَآ إِلَّا ٱخْتِلَٰقٌ ","translation":"We have not heard of this in the latest religion.[1] This is not but a fabrication.","words":[{"id":1,"arabic":"مَا","translit":"āَm","root":""},{"id":2,"arabic":"سَمِعْنَا","translit":"āَnْʿعِmَs","root":"سمع"},{"id":3,"arabic":"بِهَٰذَا","translit":"āَhdَٰhِb","root":""},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلْمِلَّةِ","translit":"ِẗَّlِmْlٱ","root":"ملل"},{"id":6,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":7,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":8,"arabic":"هَٰذَآ","translit":"ٓāَhdَٰh","root":""},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"ٱخْتِلَٰقٌ","translit":"ٌqَٰlِtْhkٱ","root":"خلق"}],"hasIhya":false},{"ayah":8,"text":"أَءُنزِلَ عَلَيْهِ ٱلذِّكْرُ مِنۢ بَيْنِنَاۚ بَلْ هُمْ فِى شَكٍّ مِّن ذِكْرِىۖ بَل لَّمَّا يَذُوقُوا۟ عَذَابِ ","translation":"Has the message been revealed to him out of [all of] us?\" Rather, they are in doubt about My message. Rather, they have not yet tasted My punishment.","words":[{"id":1,"arabic":"أَءُنزِلَ","translit":"َlِznُءَaʾ","root":"نزل"},{"id":2,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":3,"arabic":"ٱلذِّكْرُ","translit":"ُrْkِّhdlٱ","root":"ذكر"},{"id":4,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":5,"arabic":"بَيْنِنَا","translit":"āَnِnْyَb","root":"بين"},{"id":6,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":7,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"شَكٍّ","translit":"ٍّkَhs","root":"شكك"},{"id":10,"arabic":"مِّن","translit":"nِّm","root":""},{"id":11,"arabic":"ذِكْرِى","translit":"àِrْkِhd","root":"ذكر"},{"id":12,"arabic":"بَل","translit":"lَb","root":""},{"id":13,"arabic":"لَّمَّا","translit":"āَّmَّl","root":""},{"id":14,"arabic":"يَذُوقُوا۟","translit":"۟āwُqwُhdَy","root":"ذوق"},{"id":15,"arabic":"عَذَابِ","translit":"ِbāَhdَʿع","root":"عذب"}],"hasIhya":false},{"ayah":9,"text":"أَمْ عِندَهُمْ خَزَآئِنُ رَحْمَةِ رَبِّكَ ٱلْعَزِيزِ ٱلْوَهَّابِ ","translation":"Or do they have the depositories of the mercy of your Lord, the Exalted in Might, the Bestower?[1]","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"عِندَهُمْ","translit":"ْmُhَdnِʿع","root":"عند"},{"id":3,"arabic":"خَزَآئِنُ","translit":"ُnِyʾٓāَzَhk","root":"خزن"},{"id":4,"arabic":"رَحْمَةِ","translit":"ِẗَmْḥَr","root":"رحم"},{"id":5,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":6,"arabic":"ٱلْعَزِيزِ","translit":"ِzyِzَʿعْlٱ","root":"عزز"},{"id":7,"arabic":"ٱلْوَهَّابِ","translit":"ِbāَّhَwْlٱ","root":"وهب"}],"hasIhya":false},{"ayah":10,"text":"أَمْ لَهُم مُّلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَاۖ فَلْيَرْتَقُوا۟ فِى ٱلْأَسْبَٰبِ ","translation":"Or is theirs the dominion of the heavens and the earth and what is between them? Then let them ascend through [any] ways of access.[1]","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":3,"arabic":"مُّلْكُ","translit":"ُkْlُّm","root":"ملك"},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":6,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":7,"arabic":"بَيْنَهُمَا","translit":"āَmُhَnْyَb","root":"بين"},{"id":8,"arabic":"فَلْيَرْتَقُوا۟","translit":"۟āwُqَtْrَyْlَf","root":"رقي"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْأَسْبَٰبِ","translit":"ِbَٰbْsَaʾْlٱ","root":"سبب"}],"hasIhya":false},{"ayah":11,"text":"جُندٌ مَّا هُنَالِكَ مَهْزُومٌ مِّنَ ٱلْأَحْزَابِ ","translation":"[They are but] soldiers [who will be] defeated there among the companies [of disbelievers].","words":[{"id":1,"arabic":"جُندٌ","translit":"ٌdnُjg","root":"جند"},{"id":2,"arabic":"مَّا","translit":"āَّm","root":""},{"id":3,"arabic":"هُنَالِكَ","translit":"َkِlāَnُh","root":""},{"id":4,"arabic":"مَهْزُومٌ","translit":"ٌmwُzْhَm","root":"هزم"},{"id":5,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":6,"arabic":"ٱلْأَحْزَابِ","translit":"ِbāَzْḥَaʾْlٱ","root":"حزب"}],"hasIhya":false},{"ayah":12,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعَادٌ وَفِرْعَوْنُ ذُو ٱلْأَوْتَادِ ","translation":"The people of Noah denied before them, and [the tribe of] ʿAad and Pharaoh, the owner of stakes,[1]","words":[{"id":1,"arabic":"كَذَّبَتْ","translit":"ْtَbَّhdَk","root":"كذب"},{"id":2,"arabic":"قَبْلَهُمْ","translit":"ْmُhَlْbَq","root":"قبل"},{"id":3,"arabic":"قَوْمُ","translit":"ُmْwَq","root":"قوم"},{"id":4,"arabic":"نُوحٍ","translit":"ٍḥwُn","root":""},{"id":5,"arabic":"وَعَادٌ","translit":"ٌdāَʿعَw","root":"عود"},{"id":6,"arabic":"وَفِرْعَوْنُ","translit":"ُnْwَʿعْrِfَw","root":""},{"id":7,"arabic":"ذُو","translit":"wُhd","root":""},{"id":8,"arabic":"ٱلْأَوْتَادِ","translit":"ِdāَtْwَaʾْlٱ","root":"وتد"}],"hasIhya":false},{"ayah":13,"text":"وَثَمُودُ وَقَوْمُ لُوطٍ وَأَصْحَٰبُ لْـَٔيْكَةِۚ أُو۟لَٰٓئِكَ ٱلْأَحْزَابُ ","translation":"And [the tribe of] Thamūd and the people of Lot and the companions of the thicket [i.e., people of Madyan]. Those are the companies.[1]","words":[{"id":1,"arabic":"وَثَمُودُ","translit":"ُdwُmَhtَw","root":""},{"id":2,"arabic":"وَقَوْمُ","translit":"ُmْwَqَw","root":"قوم"},{"id":3,"arabic":"لُوطٍ","translit":"ٍṭwُl",