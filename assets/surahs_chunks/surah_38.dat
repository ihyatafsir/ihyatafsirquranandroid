ُرِ اِسْمَٰعِيلَ وَالْيَسَعَ وَذَا اَ۬لْكِفْلِۖ وَكُلࣱّ مِّنَ اَ۬لَاخْي۪ارِۖ", "words": [{"id": 1, "arabic": "وَاذْكُرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِسْمَٰعِيلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالْيَسَعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَذَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْكِفْلِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَكُلࣱّ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لَاخْي۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 49, "text": "هَٰذَا ذِكْرࣱۖ وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ مَـَٔابࣲ‏", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذِكْرࣱۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلْمُتَّقِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَحُسْنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَـَٔابࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 50, "text": "جَنَّٰتِ عَدْنࣲ مُّفَتَّحَةࣰ لَّهُمُ اُ۬لَابْوَٰبُ", "words": [{"id": 1, "arabic": "جَنَّٰتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَدْنࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّفَتَّحَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَّهُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَابْوَٰبُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 51, "text": "مُتَّكِـِٕينَ فِيهَا يَدْعُونَ فِيهَا بِفَٰكِهَةࣲ كَثِيرَةࣲ وَشَرَابࣲۖ", "words": [{"id": 1, "arabic": "مُتَّكِـِٕينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَدْعُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بِفَٰكِهَةࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَثِيرَةࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَشَرَابࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 52, "text": "۞وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ أَتْرَابٌۖ", "words": [{"id": 1, "arabic": "۞وَعِندَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَٰصِرَٰتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لطَّرْفِ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَتْرَابٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 53, "text": "هَٰذَا مَا تُوعَدُونَ لِيَوْمِ اِ۬لْحِسَابِۖ", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تُوعَدُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَوْمِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْحِسَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 54, "text": "إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُۥ مِن نَّفَادٍۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَرِزْقُنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "", "root": ""}, {"id": 7, "arabic": "نَّفَادٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 55, "text": "هَٰذَا وَإِنَّ لِلطَّٰغِينَ لَشَرَّ مَـَٔابࣲ‏", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلطَّٰغِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَشَرَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَـَٔابࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 56, "text": "جَهَنَّمَ يَصْلَوْنَهَاۖ فَبِيسَ اَ۬لْمِهَادُۖ", "words": [{"id": 1, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصْلَوْنَهَاۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَبِيسَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمِهَادُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 57, "text": "هَٰذَا فَلْيَذُوقُوهُ حَمِيمࣱ وَغَسَاقࣱ‏", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فَلْيَذُوقُوهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "حَمِيمࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَغَسَاقࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 58, "text": "وَءَاخَرُ مِن شَكْلِهِۦٓ أَزْوَٰجٌۖ", "words": [{"id": 1, "arabic": "وَءَاخَرُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "شَكْلِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَزْوَٰجٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 59, "text": "هَٰذَا فَوْجࣱ مُّقْتَحِمࣱ مَّعَكُمْۖ لَا مَرْحَباَۢ بِهِمُۥٓۖ إِنَّهُمْ صَالُواْ اُ۬لنّ۪ارِۖ", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فَوْجࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّقْتَحِمࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّعَكُمْۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مَرْحَباَۢ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِمُۥٓۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "صَالُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 60, "text": "قَالُواْ بَلَ اَنتُمْ لَا مَرْحَباَۢ بِكُمُۥٓ أَنتُمْ قَدَّمْتُمُوهُ لَنَاۖ فَبِيسَ اَ۬لْقَرَارُۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مَرْحَباَۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِكُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَدَّمْتُمُوهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَنَاۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَبِيسَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْقَرَارُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 61, "text": "قَالُواْ رَبَّنَا مَن قَدَّمَ لَنَا هَٰذَا فَزِدْهُ عَذَاباࣰ ضِعْفاࣰ فِے اِ۬لنّ۪ارِۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَدَّمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فَزِدْهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَذَاباࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "ضِعْفاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِے", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 62, "text": "وَقَالُواْ مَا لَنَا لَا نَر۪يٰ رِجَالاࣰ كُنَّا نَعُدُّهُم مِّنَ اَ۬لَاشْر۪ارِۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "نَر۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "رِجَالاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "نَعُدُّهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لَاشْر۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 63, "text": "أَتَّخَذْنَٰهُمْ سُخْرِيّاً اَمْ زَاغَتْ عَنْهُمُ اُ۬لَابْصَٰرُۖ", "words": [{"id": 1, "arabic": "أَتَّخَذْنَٰهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سُخْرِيّاً", "translit": "", "root": ""}, {"id": 3, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "زَاغَتْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَنْهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لَابْصَٰرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 64, "text": "إِنَّ ذَٰلِكَ لَحَقࣱّ تَخَاصُمُ أَهْلِ اِ۬لنّ۪ارِۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَحَقࣱّ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَخَاصُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَهْلِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 65, "text": "قُلِ اِنَّمَآ أَنَا مُنذِرࣱۖ وَمَا مِنِ اِلَٰهٍ اِلَّا اَ۬للَّهُ اُ۬لْوَٰحِدُ اُ۬لْقَهَّارُۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنَّمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مُنذِرࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِلَٰهٍ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْوَٰحِدُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْقَهَّارُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 66, "text": "رَبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ اَ۬لْعَزِيزُ اُ۬لْغَفَّٰرُۖ", "words": [{"id": 1, "arabic": "رَبُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنَهُمَاۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْغَفَّٰرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 67, "text": "قُلْ هُوَ نَبَؤٌاْ عَظِيمٌ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَبَؤٌاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَظِيمٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 68, "text": "اَنتُمْ عَنْهُ مُعْرِضُونَۖ", "words": [{"id": 1, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُعْرِضُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 69, "text": "مَا كَانَ لِے مِنْ عِلْمِۢ بِالْمَلَإِ اِ۬لَاعْل۪يٰٓ إِذْ يَخْتَصِمُونَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عِلْمِۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالْمَلَإِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَاعْل۪يٰٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَخْتَصِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 70, "text": "إِنْ يُّوح۪يٰٓ إِلَيَّ إِلَّآ أَنَّمَآ أَنَا نَذِيرࣱ مُّبِينٌۖ", "words": [{"id": 1, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُّوح۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنَّمَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "نَذِيرࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 71, "text": "اِذْ قَالَ رَبُّكَ لِلْمَلَٰٓئِكَةِ إِنِّے خَٰلِقُۢ بَشَراࣰ مِّن طِينࣲ‏", "words": [{"id": 1, "arabic": "اِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 6, "arabic": "خَٰلِقُۢ", "translit": "", "root": ""}, {"id": 7, "arabic": "بَشَراࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 9, "arabic": "طِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 72, "text": "فَإِذَا سَوَّيْتُهُۥ وَنَفَخْتُ فِيهِ مِن رُّوحِے فَقَعُواْ لَهُۥ سَٰجِدِينَۖ", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "سَوَّيْتُهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَنَفَخْتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "رُّوحِے", "translit": "", "root": ""}, {"id": 7, "arabic": "فَقَعُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَٰجِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 73, "text": "فَسَجَدَ اَ۬لْمَلَٰٓئِكَةُ كُلُّهُمُۥٓ أَجْمَعُونَ", "words": [{"id": 1, "arabic": "فَسَجَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمَلَٰٓئِكَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلُّهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَجْمَعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 74, "text": "إِلَّآ إِبْلِيسَ اَ۪سْتَكْبَرَ وَكَانَ مِنَ اَ۬لْكٰ۪فِرِينَۖ", "words": [{"id": 1, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِبْلِيسَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۪سْتَكْبَرَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَكَانَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْكٰ۪فِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 75, "text": "قَالَ يَٰٓإِبْلِيسُ مَا مَنَعَكَ أَن تَسْجُدَ لِمَا خَلَقْتُ بِيَدَيَّ أَسْتَكْبَرْتَ أَمْ كُنتَ مِنَ اَ۬لْعَالِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰٓإِبْلِيسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَنَعَكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَن", "translit": "", "root": ""}, {"id": 6, "arabic": "تَسْجُدَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لِمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "خَلَقْتُ", "translit": "", "root": ""}, {"id": 9, "arabic": "بِيَدَيَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَسْتَكْبَرْتَ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لْعَالِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 76, "text": "قَالَ أَنَا خَيْرࣱ مِّنْهُ خَلَقْتَنِے مِن نّ۪ارࣲ وَخَلَقْتَهُۥ مِن طِينࣲۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "خَلَقْتَنِے", "translit": "", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "", "root": ""}, {"id": 7, "arabic": "نّ۪ارࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَخَلَقْتَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "", "root": ""}, {"id": 10, "arabic": "طِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 77, "text": "قَالَ فَاخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمࣱ‏", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَاخْرُجْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فَإِنَّكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَجِيمࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 78, "text": "وَإِنَّ عَلَيْكَ لَعْنَتِيَ إِلَيٰ يَوْمِ اِ۬لدِّينِۖ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَعْنَتِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لدِّينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 79, "text": "قَالَ رَبِّ فَأَنظِرْنِےٓ إِلَيٰ يَوْمِ يُبْعَثُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَأَنظِرْنِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُبْعَثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 80, "text": "قَالَ فَإِنَّكَ مِنَ اَ۬لْمُنظَرِينَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَإِنَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُنظَرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 81, "text": "إِلَيٰ يَوْمِ اِ۬لْوَقْتِ اِ۬لْمَعْلُومِۖ", "words": [{"id": 1, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْوَقْتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْمَعْلُومِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 82, "text": "قَالَ فَبِعِزَّتِكَ لَأُغْوِيَنَّهُمُۥٓ أَجْمَعِينَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَبِعِزَّتِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَأُغْوِيَنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَجْمَعِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 83, "text": "إِلَّا عِبَادَكَ مِنْهُمُ اُ۬لْمُخْلَصِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "عِبَادَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْمُخْلَصِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 84, "text": "۞قَالَ فَالْحَقَّ وَالْحَقَّ أَقُولُۖ", "words": [{"id": 1, "arabic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَالْحَقَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالْحَقَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَقُولُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 85, "text": "لَأَمْلَأَنَّ جَهَنَّمَ مِنكَ وَمِمَّن تَبِعَكَ مِنْهُمُۥٓ أَجْمَعِينَۖ", "words": [{"id": 1, "arabic": "لَأَمْلَأَنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمِمَّن", "translit": "", "root": ""}, {"id": 5, "arabic": "تَبِعَكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنْهُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَجْمَعِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 86, "text": "قُلْ مَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنَ اَجْرࣲ وَمَآ أَنَا مِنَ اَ۬لْمُتَكَلِّفِينَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَسْـَٔلُكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَجْرࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 9, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْمُتَكَلِّفِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 87, "text": "إِنْ هُوَ إِلَّا ذِكْرࣱ لِّلْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "ذِكْرࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِّلْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 88, "text": "وَلَتَعْلَمُنَّ نَبَأَهُۥ بَعْدَ حِينࣲۖ", "words": [{"id": 1, "arabic": "وَلَتَعْلَمُنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَبَأَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَعْدَ", "translit": "", "root": ""}, {"id": 4, "arabic": "حِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}]}