"ارض"},{"id":5,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":6,"arabic":"بَيْنَهُمَا","translit":"āَmُhَnْyَb","root":"بين"},{"id":7,"arabic":"بَٰطِلًا","translit":"āًlِṭَٰb","root":"بطل"},{"id":8,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":9,"arabic":"ظَنُّ","translit":"ُّnَẓ","root":"ظنن"},{"id":10,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":11,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":12,"arabic":"فَوَيْلٌ","translit":"ٌlْyَwَf","root":""},{"id":13,"arabic":"لِّلَّذِينَ","translit":"َnyِhdَّlِّl","root":""},{"id":14,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":15,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":16,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"}],"hasIhya":false},{"ayah":28,"text":"أَمْ نَجْعَلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ كَٱلْمُفْسِدِينَ فِى ٱلْأَرْضِ أَمْ نَجْعَلُ ٱلْمُتَّقِينَ كَٱلْفُجَّارِ ","translation":"Or should We treat those who believe and do righteous deeds like corrupters in the land? Or should We treat those who fear Allāh like the wicked?","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"نَجْعَلُ","translit":"ُlَʿعْjgَn","root":"جعل"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":5,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":6,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":7,"arabic":"كَٱلْمُفْسِدِينَ","translit":"َnyِdِsْfُmْlٱَk","root":"فسد"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":10,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":11,"arabic":"نَجْعَلُ","translit":"ُlَʿعْjgَn","root":"جعل"},{"id":12,"arabic":"ٱلْمُتَّقِينَ","translit":"َnyِqَّtُmْlٱ","root":"وقي"},{"id":13,"arabic":"كَٱلْفُجَّارِ","translit":"ِrāَّjgُfْlٱَk","root":"فجر"}],"hasIhya":false},{"ayah":29,"text":"كِتَٰبٌ أَنزَلْنَٰهُ إِلَيْكَ مُبَٰرَكٌ لِّيَدَّبَّرُوٓا۟ ءَايَٰتِهِۦ وَلِيَتَذَكَّرَ أُو۟لُوا۟ ٱلْأَلْبَٰبِ ","translation":"[This is] a blessed Book which We have revealed to you, [O Muḥammad], that they might reflect upon its verses and that those of understanding would be reminded.","words":[{"id":1,"arabic":"كِتَٰبٌ","translit":"ٌbَٰtِk","root":"كتب"},{"id":2,"arabic":"أَنزَلْنَٰهُ","translit":"ُhَٰnْlَznَaʾ","root":"نزل"},{"id":3,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":4,"arabic":"مُبَٰرَكٌ","translit":"ٌkَrَٰbُm","root":"برك"},{"id":5,"arabic":"لِّيَدَّبَّرُوٓا۟","translit":"۟āٓwُrَّbَّdَyِّl","root":"دبر"},{"id":6,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":7,"arabic":"وَلِيَتَذَكَّرَ","translit":"َrَّkَhdَtَyِlَw","root":"ذكر"},{"id":8,"arabic":"أُو۟لُوا۟","translit":"۟āwُl۟wُaʾ","root":""},{"id":9,"arabic":"ٱلْأَلْبَٰبِ","translit":"ِbَٰbْlَaʾْlٱ","root":"لبب"}],"hasIhya":false},{"ayah":30,"text":"وَوَهَبْنَا لِدَاوُۥدَ سُلَيْمَٰنَۚ نِعْمَ ٱلْعَبْدُۖ إِنَّهُۥٓ أَوَّابٌ ","translation":"And to David We gave Solomon. An excellent servant, indeed he was one repeatedly turning back [to Allāh].","words":[{"id":1,"arabic":"وَوَهَبْنَا","translit":"āَnْbَhَwَw","root":"وهب"},{"id":2,"arabic":"لِدَاوُۥدَ","translit":"َdۥُwāَdِl","root":""},{"id":3,"arabic":"سُلَيْمَٰنَ","translit":"َnَٰmْyَlُs","root":""},{"id":4,"arabic":"نِعْمَ","translit":"َmْʿعِn","root":"نعم"},{"id":5,"arabic":"ٱلْعَبْدُ","translit":"ُdْbَʿعْlٱ","root":"عبد"},{"id":6,"arabic":"إِنَّهُۥٓ","translit":"ٓۥُhَّnِiʾ","root":""},{"id":7,"arabic":"أَوَّابٌ","translit":"ٌbāَّwَaʾ","root":"اوب"}],"hasIhya":true},{"ayah":31,"text":"إِذْ عُرِضَ عَلَيْهِ بِٱلْعَشِىِّ ٱلصَّٰفِنَٰتُ ٱلْجِيَادُ ","translation":"[Mention] when there were exhibited before him in the afternoon the poised [standing] racehorses.","words":[{"id":1,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":2,"arabic":"عُرِضَ","translit":"َḍِrُʿع","root":"عرض"},{"id":3,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":4,"arabic":"بِٱلْعَشِىِّ","translit":"ِّàِhsَʿعْlٱِb","root":"عشو"},{"id":5,"arabic":"ٱلصَّٰفِنَٰتُ","translit":"ُtَٰnِfَّٰṣlٱ","root":"صفن"},{"id":6,"arabic":"ٱلْجِيَادُ","translit":"ُdāَyِjgْlٱ","root":"جود"}],"hasIhya":false},{"ayah":32,"text":"فَقَالَ إِنِّىٓ أَحْبَبْتُ حُبَّ ٱلْخَيْرِ عَن ذِكْرِ رَبِّى حَتَّىٰ تَوَارَتْ بِٱلْحِجَابِ ","translation":"And he said, \"Indeed, I gave preference to the love of good [things] over the remembrance of my Lord until it [i.e., the sun] disappeared into the curtain [of darkness].\"","words":[{"id":1,"arabic":"فَقَالَ","translit":"َlāَqَf","root":"قول"},{"id":2,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":3,"arabic":"أَحْبَبْتُ","translit":"ُtْbَbْḥَaʾ","root":"حبب"},{"id":4,"arabic":"حُبَّ","translit":"َّbُḥ","root":"حبب"},{"id":5,"arabic":"ٱلْخَيْرِ","translit":"ِrْyَhkْlٱ","root":"خير"},{"id":6,"arabic":"عَن","translit":"nَʿع","root":""},{"id":7,"arabic":"ذِكْرِ","translit":"ِrْkِhd","root":"ذكر"},{"id":8,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":9,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":10,"arabic":"تَوَارَتْ","translit":"ْtَrāَwَt","root":"وري"},{"id":11,"arabic":"بِٱلْحِجَابِ","translit":"ِbāَjgِḥْlٱِb","root":"حجب"}],"hasIhya":false},{"ayah":33,"text":"رُدُّوهَا عَلَىَّۖ فَطَفِقَ مَسْحًۢا بِٱلسُّوقِ وَٱلْأَعْنَاقِ ","translation":"[He said], \"Return them to me,\" and set about striking[1] [their] legs and necks.","words":[{"id":1,"arabic":"رُدُّوهَا","translit":"āَhwُّdُr","root":"ردد"},{"id":2,"arabic":"عَلَىَّ","translit":"َّàَlَʿع","root":""},{"id":3,"arabic":"فَطَفِقَ","translit":"َqِfَṭَf","root":"طفق"},{"id":4,"arabic":"مَسْحًۢا","translit":"āًۢḥْsَm","root":"مسح"},{"id":5,"arabic":"بِٱلسُّوقِ","translit":"ِqwُّslٱِb","root":"سوق"},{"id":6,"arabic":"وَٱلْأَعْنَاقِ","translit":"ِqāَnْʿعَaʾْlٱَw","root":"عنق"}],"hasIhya":false},{"ayah":34,"text":"وَلَقَدْ فَتَنَّا سُلَيْمَٰنَ وَأَلْقَيْنَا عَلَىٰ كُرْسِيِّهِۦ جَسَدًا ثُمَّ أَنَابَ ","translation":"And We certainly tried Solomon and placed on his throne a body;[1] then he returned.[2]","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"فَتَنَّا","translit":"āَّnَtَf","root":"فتن"},{"id":3,"arabic":"سُلَيْمَٰنَ","translit":"َnَٰmْyَlُs","root":""},{"id":4,"arabic":"وَأَلْقَيْنَا","translit":"āَnْyَqْlَaʾَw","root":"لقي"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"كُرْسِيِّهِۦ","translit":"ۦِhِّyِsْrُk","root":"كرس"},{"id":7,"arabic":"جَسَدًا","translit":"āًdَsَjg","root":"جسد"},{"id":8,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":9,"arabic":"أَنَابَ","translit":"َbāَnَaʾ","root":"نوب"}],"hasIhya":false},{"ayah":35,"text":"قَالَ رَبِّ ٱغْفِرْ لِى وَهَبْ لِى مُلْكًا لَّا يَنۢبَغِى لِأَحَدٍ مِّنۢ بَعْدِىٓۖ إِنَّكَ أَنتَ ٱلْوَهَّابُ ","translation":"He said, \"My Lord, forgive me and grant me a kingdom such as will not belong to anyone after me. Indeed, You are the Bestower.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":3,"arabic":"ٱغْفِرْ","translit":"ْrِfْغٱ","root":"غفر"},{"id":4,"arabic":"لِى","translit":"àِl","root":""},{"id":5,"arabic":"وَهَبْ","translit":"ْbَhَw","root":"وهب"},{"id":6,"arabic":"لِى","translit":"àِl","root":""},{"id":7,"arabic":"مُلْكًا","translit":"āًkْlُm","root":"ملك"},{"id":8,"arabic":"لَّا","translit":"āَّl","root":""},{"id":9,"arabic":"يَنۢبَغِى","translit":"àِغَbۢnَy","root":"بغي"},{"id":10,"arabic":"لِأَحَدٍ","translit":"ٍdَḥَaʾِl","root":"احد"},{"id":11,"arabic":"مِّنۢ","translit":"ۢnِّm","root":""},{"id":12,"arabic":"بَعْدِىٓ","translit":"ٓàِdْʿعَb","root":"بعد"},{"id":13,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":14,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":15,"arabic":"ٱلْوَهَّابُ","translit":"ُbāَّhَwْlٱ","root":"وهب"}],"hasIhya":false},{"ayah":36,"text":"فَسَخَّرْنَا لَهُ ٱلرِّيحَ تَجْرِى بِأَمْرِهِۦ رُخَآءً حَيْثُ أَصَابَ ","translation":"So We subjected to him the wind blowing by his command, gently, wherever he directed,","words":[{"id":1,"arabic":"فَسَخَّرْنَا","translit":"āَnْrَّhkَsَf","root":"سخر"},{"id":2,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":3,"arabic":"ٱلرِّيحَ","translit":"َḥyِّrlٱ","root":"روح"},{"id":4,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":5,"arabic":"بِأَمْرِهِۦ","translit":"ۦِhِrْmَaʾِb","root":"امر"},{"id":6,"arabic":"رُخَآءً","translit":"ًءٓāَhkُr","root":"رخو"},{"id":7,"arabic":"حَيْثُ","translit":"ُhtْyَḥ","root":"حيث"},{"id":8,"arabic":"أَصَابَ","translit":"َbāَṣَaʾ","root":"صوب"}],"hasIhya":false},{"ayah":37,"text":"وَٱلشَّيَٰطِينَ كُلَّ بَنَّآءٍ وَغَوَّاصٍ ","translation":"And [also] the devils [of jinn] - every builder and diver","words":[{"id":1,"arabic":"وَٱلشَّيَٰطِينَ","translit":"َnyِṭَٰyَّhslٱَw","root":"شطن"},{"id":2,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":3,"arabic":"بَنَّآءٍ","translit":"ٍءٓāَّnَb","root":"بني"},{"id":4,"arabic":"وَغَوَّاصٍ","translit":"ٍṣāَّwَغَw","root":"غوص"}],"hasIhya":false},{"ayah":38,"text":"وَءَاخَرِينَ مُقَرَّنِينَ فِى ٱلْأَصْفَادِ ","translation":"And others bound together in irons.","words":[{"id":1,"arabic":"وَءَاخَرِينَ","translit":"َnyِrَhkāَءَw","root":"اخر"},{"id":2,"arabic":"مُقَرَّنِينَ","translit":"َnyِnَّrَqُm","root":"قرن"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَصْفَادِ","translit":"ِdāَfْṣَaʾْlٱ","root":"صفد"}],"hasIhya":false},{"ayah":39,"text":"هَٰذَا عَطَآؤُنَا فَٱمْنُنْ أَوْ أَمْسِكْ بِغَيْرِ حِسَابٍ ","translation":"[We said], \"This is Our gift, so grant or withhold without account.\"","words":[{"id":1,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":2,"arabic":"عَطَآؤُنَا","translit":"āَnُwʾٓāَṭَʿع","root":"عطو"},{"id":3,"arabic":"فَٱمْنُنْ","translit":"ْnُnْmٱَf","root":"منن"},{"id":4,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":5,"arabic":"أَمْسِكْ","translit":"ْkِsْmَaʾ","root":"مسك"},{"id":6,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":7,"arabic":"حِسَابٍ","translit":"ٍbāَsِḥ","root":"حسب"}],"hasIhya":false},{"ayah":40,"text":"وَإِنَّ لَهُۥ عِندَنَا لَزُلْفَىٰ وَحُسْنَ مَـَٔابٍ ","translation":"And indeed, for him is nearness to Us and a good place of return.","words":[{"id":1,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"عِندَنَا","translit":"āَnَdnِʿع","root":"عند"},{"id":4,"arabic":"لَزُلْفَىٰ","translit":"ٰàَfْlُzَl","root":"زلف"},{"id":5,"arabic":"وَحُسْنَ","translit":"َnْsُḥَw","root":"حسن"},{"id":6,"arabic":"مَـَٔابٍ","translit":"ٍbāَٔـَm","root":"اوب"}],"hasIhya":false},{"ayah":41,"text":"وَٱذْكُرْ عَبْدَنَآ أَيُّوبَ إِذْ نَادَىٰ رَبَّهُۥٓ أَنِّى مَسَّنِىَ ٱلشَّيْطَٰنُ بِنُصْبٍ وَعَذَابٍ ","translation":"And remember Our servant Job, when he called to his Lord, \"Indeed, Satan has touched me with hardship and torment.\"","words":[{"id":1,"arabic":"وَٱذْكُرْ","translit":"ْrُkْhdٱَw","root":"ذكر"},{"id":2,"arabic":"عَبْدَنَآ","translit":"ٓāَnَdْbَʿع","root":"عبد"},{"id":3,"arabic":"أَيُّوبَ","translit":"َbwُّyَaʾ","root":""},{"id":4,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":5,"arabic":"نَادَىٰ","translit":"ٰàَdāَn","root":"ندي"},{"id":6,"arabic":"رَبَّهُۥٓ","translit":"ٓۥُhَّbَr","root":"ربب"},{"id":7,"arabic":"أَنِّى","translit":"àِّnَaʾ","root":""},{"id":8,"arabic":"مَسَّنِىَ","translit":"َàِnَّsَm","root":"مسس"},{"id":9,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":10,"arabic":"بِنُصْبٍ","translit":"ٍbْṣُnِb","root":"نصب"},{"id":11,"arabic":"وَعَذَابٍ","translit":"ٍbāَhdَʿعَw","root":"عذب"}],"hasIhya":false},{"ayah":42,"text":"ٱرْكُضْ بِرِجْلِكَۖ هَٰذَا مُغْتَسَلٌۢ بَارِدٌ وَشَرَابٌ ","translation":"[So he was told], \"Strike [the ground] with your foot; this is a [spring for a] cool bath and drink.\"","words":[{"id":1,"arabic":"ٱرْكُضْ","translit":"ْḍُkْrٱ","root":"ركض"},{"id":2,"arabic":"بِرِجْلِكَ","translit":"َkِlْjgِrِb","root":"رجل"},{"id":3,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":4,"arabic":"مُغْتَسَلٌۢ","translit":"ٌۢlَsَtْغُm","root":"غسل"},{"id":5,"arabic":"بَارِدٌ","translit":"ٌdِrāَb","root":"برد"},{"id":6,"arabic":"وَشَرَابٌ","translit":"ٌbāَrَhsَw","root":"شرب"}],"hasIhya":false},{"ayah":43,"text":"وَوَهَبْنَا لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم مَّعَهُمْ رَحْمَةً مِّنَّا وَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَٰبِ ","translation":"And We granted him his family and a like [number] with them as mercy from Us and a reminder for those of understanding.","words":[{"id":1,"arabic":"وَوَهَبْنَا","translit":"āَnْbَhَwَw","root":"وهب"},{"id":2,"arabic":"لَهُۥٓ","translit":"ٓۥُhَl","root":""},{"id":3,"arabic":"أَهْلَهُۥ","translit":"ۥُhَlْhَaʾ","root":"اهل"},{"id":4,"arabic":"وَمِثْلَهُم","translit":"mُhَlْhtِmَw","root":"مثل"},{"id":5,"arabic":"مَّعَهُمْ","translit":"ْmُhَʿعَّm","root":""},{"id":6,"arabic":"رَحْمَةً","translit":"ًẗَmْḥَr","root":"رحم"},{"id":7,"arabic":"مِّنَّا","translit":"āَّnِّm","root":""},{"id":8,"arabic":"وَذِكْرَىٰ","translit":"ٰàَrْkِhdَw","root":"ذكر"},{"id":9,"arabic":"لِأُو۟لِى","translit":"àِl۟wُaʾِl","root":""},{"id":10,"arabic":"ٱلْأَلْبَٰبِ","translit":"ِbَٰbْlَaʾْlٱ","root":"لبب"}],"hasIhya":false},{"ayah":44,"text":"وَخُذْ بِيَدِكَ ضِغْثًا فَٱضْرِب بِّهِۦ وَلَا تَحْنَثْۗ إِنَّا وَجَدْنَٰهُ صَابِرًاۚ نِّعْمَ ٱلْعَبْدُۖ إِنَّهُۥٓ أَوَّابٌ ","translation":"[We said], \"And take in your hand a bunch [of grass] and strike with it and do not break your oath.\"[1] Indeed, We found him patient, an excellent servant. Indeed, he was one repeatedly turning back [to Allāh].","words":[{"id":1,"arabic":"وَخُذْ","translit":"ْhdُhkَw","root":"اخذ"},{"id":2,"arabic":"بِيَدِكَ","translit":"َkِdَyِb","root":"يدي"},{"id":3,"arabic":"ضِغْثًا","translit":"āًhtْغِḍ","root":"ضغث"},{"id":4,"arabic":"فَٱضْرِب","translit":"bِrْḍٱَf","root":"ضرب"},{"id":5,"arabic":"بِّهِۦ","translit":"ۦِhِّb","root":""},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"تَحْنَثْ","translit":"ْhtَnْḥَt","root":"حنث"},{"id":8,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":9,"arabic":"وَجَدْنَٰهُ","translit":"ُhَٰnْdَjgَw","root":"وجد"},{"id":10,"arabic":"صَابِرًا","translit":"āًrِbāَṣ","root":"صبر"},{"id":11,"arabic":"نِّعْمَ","translit":"َmْʿعِّn","root":"نعم"},{"id":12,"arabic":"ٱلْعَبْدُ","translit":"ُdْbَʿعْlٱ","root":"عبد"},{"id":13,"arabic":"إِنَّهُۥٓ","translit":"ٓۥُhَّnِiʾ","root":""},{"id":14,"arabic":"أَوَّابٌ","translit":"ٌbāَّwَaʾ","root":"اوب"}],"hasIhya":true},{"ayah":45,"text":"وَٱذْكُرْ عِبَٰدَنَآ إِبْرَٰهِيمَ وَإِسْحَٰقَ وَيَعْقُوبَ أُو۟لِى ٱلْأَيْدِى وَٱلْأَبْصَٰرِ ","translation":"And remember Our servants, Abraham, Isaac and Jacob - those of strength and [religious] vision.","words":[{"id":1,"arabic":"وَٱذْكُرْ","translit":"ْrُkْhdٱَw","root":"ذكر"},{"id":2,"arabic":"عِبَٰدَنَآ","translit":"ٓāَnَdَٰbِʿع","root":"عبد"},{"id":3,"arabic":"إِبْرَٰهِيمَ","translit":"َmyِhَٰrْbِiʾ","root":""},{"id":4,"arabic":"وَإِسْحَٰقَ","translit":"َqَٰḥْsِiʾَw","root":""},{"id":5,"arabic":"وَيَعْقُوبَ","translit":"َbwُqْʿعَyَw","root":""},{"id":6,"arabic":"أُو۟لِى","translit":"àِl۟wُaʾ","root":""},{"id":7,"arabic":"ٱلْأَيْدِى","translit":"àِdْyَaʾْlٱ","root":"يدي"},{"id":8,"arabic":"وَٱلْأَبْصَٰرِ","translit":"ِrَٰṣْbَaʾْlٱَw","root":"بصر"}],"hasIhya":false},{"ayah":46,"text":"إِنَّآ أَخْلَصْنَٰهُم بِخَالِصَةٍ ذِكْرَى ٱلدَّارِ ","translation":"Indeed, We chose them for an exclusive quality: remembrance of the home [of the Hereafter].","words":[{"id":1,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":2,"arabic":"أَخْلَصْنَٰهُم","translit":"mُhَٰnْṣَlْhkَaʾ","root":"خلص"},{"id":3,"arabic":"بِخَالِصَةٍ","translit":"ٍẗَṣِlāَhkِb","root":"خلص"},{"id":4,"arabic":"ذِكْرَى","translit":"àَrْkِhd","root":"ذكر"},{"id":5,"arabic":"ٱلدَّارِ","translit":"ِrāَّdlٱ","root":"دور"}],"hasIhya":false},{"ayah":47,"text":"وَإِنَّهُمْ عِندَنَا لَمِنَ ٱلْمُصْطَفَيْنَ ٱلْأَخْيَارِ ","translation":"And indeed they are, to Us, among the chosen and outstanding.","words":[{"id":1,"arabic":"وَإِنَّهُمْ","translit":"ْmُhَّnِiʾَw","root":""},{"id":2,"arabic":"عِندَنَا","translit":"āَnَdnِʿع","root":"عند"},{"id":3,"arabic":"لَمِنَ","translit":"َnِmَl","root":""},{"id":4,"arabic":"ٱلْمُصْطَفَيْنَ","translit":"َnْyَfَṭْṣُmْlٱ","root":"صفو"},{"id":5,"arabic":"ٱلْأَخْيَارِ","translit":"ِrāَyْhkَaʾْlٱ","root":"خير"}],"hasIhya":false},{"ayah":48,"text":"وَٱذْكُرْ إِسْمَٰعِيلَ وَٱلْيَسَعَ وَذَا ٱلْكِفْلِۖ وَكُلٌّ مِّنَ ٱلْأَخْيَارِ ","translation":"And remember Ishmael, Elisha and Dhul-Kifl, and all are among the outstanding.","words":[{"id":1,"arabic":"وَٱذْكُرْ","translit":"ْrُkْhdٱَw","root":"ذكر"},{"id":2,"arabic":"إِسْمَٰعِيلَ","translit":"َlyِʿعَٰmْsِiʾ","root":""},{"id":3,"arabic":"وَٱلْيَسَعَ","translit":"َʿعَsَyْlٱَw","root":""},{"id":4,"arabic":"وَذَا","translit":"āَhdَw","root":""},{"id":5,"arabic":"ٱلْكِفْلِ","translit":"ِlْfِkْlٱ","root":"كفل"},{"id":6,"arabic":"وَكُلٌّ","translit":"ٌّlُkَw","root":"كلل"},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلْأَخْيَارِ","translit":"ِrāَyْhkَaʾْlٱ","root":"خير"}],"hasIhya":false},{"ayah":49,"text":"هَٰذَا ذِكْرٌۚ وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ مَـَٔابٍ ","translation":"This is a reminder. And indeed, for the righteous is a good place of return -","words":[{"id":1,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":2,"arabic":"ذِكْرٌ","translit":"ٌrْkِhd","root":"ذكر"},{"id":3,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":4,"arabic":"لِلْمُتَّقِينَ","translit":"َnyِqَّtُmْlِl","root":"وقي"},{"id":5,"arabic":"لَحُسْنَ","translit":"َnْsُḥَl","root":"حسن"},{"id":6,"arabic":"مَـَٔابٍ","translit":"ٍbāَٔـَm","root":"اوب"}],"hasIhya":false},{"ayah":50,"text":"جَنَّٰتِ عَدْنٍ مُّفَتَّحَةً لَّهُمُ ٱلْأَبْوَٰبُ ","translation":"Gardens of perpetual residence, whose doors will be opened to them.","words":[{"id":1,"arabic":"جَنَّٰتِ","translit":"ِtَّٰnَjg","root":"جنن"},{"id":2,"arabic":"عَدْنٍ","translit":"ٍnْdَʿع","root":""},{"id":3,"arabic":"مُّفَتَّحَةً","translit":"ًẗَḥَّtَfُّm","root":"فتح"},{"id":4,"arabic":"لَّهُمُ","translit":"ُmُhَّl","root":""},{"id":5,"arabic":"ٱلْأَبْوَٰبُ","translit":"ُbَٰwْbَaʾْlٱ","root":"بوب"}],"hasIhya":false},{"ayah":51,"text":"مُتَّكِـِٔينَ فِيهَا يَدْعُونَ فِيهَا بِفَٰكِهَةٍ كَثِيرَةٍ وَشَرَابٍ ","translation":"Reclining within them, they will call therein for abundant fruit and drink.","words":[{"id":1,"arabic":"مُتَّكِـِٔينَ","translit":"َnyِٔـِkَّtُm","root":"وكا"},{"id":2,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":3,"arabic":"يَدْعُونَ","translit":"َnwُʿعْdَy","root":"دعو"},{"id":4,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":5,"arabic":"بِفَٰكِهَةٍ","translit":"ٍẗَhِkَٰfِb","root":"فكه"},{"id":6,"arabic":"كَثِيرَةٍ","translit":"ٍẗَryِhtَk","root":"كثر"},{"id":7,"arabic":"وَشَرَابٍ","translit":"ٍbāَrَhsَw","root":"شرب"}],"hasIhya":false},{"ayah":52,"text":"وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ أَتْرَابٌ ","translation":"And with them will be women limiting [their] glances[1] and of equal age.","words":[{"id":1,"arabic":"وَعِندَهُمْ","translit":"ْmُhَdnِʿعَw","root":"عند"},{"id":2,"arabic":"قَٰصِرَٰتُ","translit":"ُtَٰrِṣَٰq","root":"قصر"},{"id":3,"arabic":"ٱلطَّرْفِ","translit":"ِfْrَّṭlٱ","root":"طرف"},{"id":4,"arabic":"أَتْرَابٌ","translit":"ٌbāَrْtَaʾ","root":"ترب"}],"hasIhya":false},{"ayah":53,"text":"هَٰذَا مَا تُوعَدُونَ لِيَوْمِ ٱلْحِسَابِ ","translation":"This is what you, [the righteous], are promised for the Day of Account.","words":[{"id":1,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"تُوعَدُونَ","translit":"َnwُdَʿعwُt","root":"وعد"},{"id":4,"arabic":"لِيَوْمِ","translit":"ِmْwَyِl","root":"يوم"},{"id":5,"arabic":"ٱلْحِسَابِ","translit":"ِbāَsِḥْlٱ","root":"حسب"}],"hasIhya":false},{"ayah":54,"text":"إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُۥ مِن نَّفَادٍ ","translation":"Indeed, this is Our provision; for it there is no depletion.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":3,"arabic":"لَرِزْقُنَا","translit":"āَnُqْzِrَl","root":"رزق"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"نَّفَادٍ","translit":"ٍdāَfَّn","root":"نفد"}],"hasIhya":false},{"ayah":55,"text":"هَٰذَاۚ وَإِنَّ لِلطَّٰغِينَ لَشَرَّ مَـَٔابٍ ","translation":"This [is so]. But indeed, for the transgressors is an evil place of return -","words":[{"id":1,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":2,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":3,"arabic":"لِلطَّٰغِينَ","translit":"َnyِغَّٰṭlِl","root":"طغي"},{"id":4,"arabic":"لَشَرَّ","translit":"َّrَhsَl","root":"شرر"},{"id":5,"arabic":"مَـَٔابٍ","translit":"ٍbāَٔـَm","root":"اوب"}],"hasIhya":false},{"ayah":56,"text":"جَهَنَّمَ يَصْلَوْنَهَا فَبِئْسَ ٱلْمِهَادُ ","translation":"Hell, which they will [enter to] burn, and wretched is the resting place.","words":[{"id":1,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":2,"arabic":"يَصْلَوْنَهَا","translit":"āَhَnْwَlْṣَy","root":"صلي"},{"id":3,"arabic":"فَبِئْسَ","translit":"َsْyʾِbَf","root":"باس"},{"id":4,"arabic":"ٱلْمِهَادُ","translit":"ُdāَhِmْlٱ","root":"مهد"}],"hasIhya":false},{"ayah":57,"text":"هَٰذَا فَلْيَذُوقُوهُ حَمِيمٌ وَغَسَّاقٌ ","translation":"This - so let them taste it - is scalding water and [foul] purulence.","words":[{"id":1,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":2,"arabic":"فَلْيَذُوقُوهُ","translit":"ُhwُqwُhdَyْlَf","root":"ذوق"},{"id":3,"arabic":"حَمِيمٌ","translit":"ٌmyِmَḥ","root":"حمم"},{"id":4,"arabic":"وَغَسَّاقٌ","translit":"ٌqāَّsَغَw","root":"غسق"}],"hasIhya":false},{"ayah":58,"text":"وَءَاخَرُ مِن شَكْلِهِۦٓ أَزْوَٰجٌ ","translation":"And other [punishments] of its type [in various] kinds.","words":[{"id":1,"arabic":"وَءَاخَرُ","translit":"ُrَhkāَءَw","root":"اخر"},{"id":2,"arabic":"مِن","translit":"nِm","root":""},{"id":3,"arabic":"شَكْلِهِۦٓ","translit":"ٓۦِhِlْkَhs","root":"شكل"},{"id":4,"arabic":"أَزْوَٰجٌ","translit":"ٌjgَٰwْzَaʾ","root":"زوج"}],"hasIhya":false},{"ayah":59,"text":"هَٰذَا فَوْجٌ مُّقْتَحِمٌ مَّعَكُمْۖ لَا مَرْحَبًۢا بِهِمْۚ إِنَّهُمْ صَالُوا۟ ٱلنَّارِ ","translation":"[Its inhabitants will say], \"This is a company bursting in with you. No welcome for them. Indeed, they will burn in the Fire.\"","words":[{"id":1,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":2,"arabic":"فَوْجٌ","translit":"ٌjgْwَf","root":"فوج"},{"id":3,"arabic":"مُّقْتَحِمٌ","translit":"ٌmِḥَtْqُّm","root":"قحم"},{"id":4,"arabic":"مَّعَكُمْ","translit":"ْmُkَʿعَّm","root":""},{"id":5,"arabic":"لَا","translit":"āَl","root":""},{"id":6,"arabic":"مَرْحَبًۢا","translit":"āًۢbَḥْrَm","root":"رحب"},{"id":7,"arabic":"بِهِمْ","translit":"ْmِhِb","root":""},{"id":8,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":9,"arabic":"صَالُوا۟","translit":"۟āwُlāَṣ","root":"صلي"},{"id":10,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"}],"hasIhya":false},{"ayah":60,"text":"قَالُوا۟ بَلْ أَنتُمْ لَا مَرْحَبًۢا بِكُمْۖ أَنتُمْ قَدَّمْتُمُوهُ لَنَاۖ فَبِئْسَ ٱلْقَرَارُ ","translation":"They will say, \"Nor you! No welcome for you. You, [our leaders], brought this upon us, and wretched is the settlement.\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":3,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"مَرْحَبًۢا","translit":"āًۢbَḥْrَm","root":"رحب"},{"id":6,"arabic":"بِكُمْ","translit":"ْmُkِb","root":""},{"id":7,"arabic":"أَنتُمْ","translit":"ْmُtnَaʾ","root":""},{"id":8,"arabic":"قَدَّمْتُمُوهُ","translit":"ُhwُmُtْmَّdَq","root":"قدم"},{"id":9,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":10,"arabic":"فَبِئْسَ","translit":"َsْyʾِbَf","r