 "warsh"}, {"surah": 38, "ayah": 42, "text": "اُ۟رْكُضْ بِرِجْلِكَۖ هَٰذَا مُغْتَسَلُۢ بَارِدࣱ وَشَرَابࣱۖ", "words": [{"id": 1, "arabic": "اُ۟رْكُضْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِرِجْلِكَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مُغْتَسَلُۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَارِدࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَشَرَابࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 43, "text": "وَوَهَبْنَا لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم مَّعَهُمْ رَحْمَةࣰ مِّنَّا وَذِكْر۪يٰ لِأُوْلِے اِ۬لَالْبَٰبِۖ", "words": [{"id": 1, "arabic": "وَوَهَبْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَهْلَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمِثْلَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّعَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَحْمَةࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "وَذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "لِأُوْلِے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لَالْبَٰبِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 44, "text": "وَخُذْ بِيَدِكَ ضِغْثاࣰ فَاضْرِب بِّهِۦ وَلَا تَحْنَثِۖ اِنَّا وَجَدْنَٰهُ صَابِراࣰۖ نِّعْمَ اَ۬لْعَبْدُۖ إِنَّهُۥٓ أَوَّابࣱۖ", "words": [{"id": 1, "arabic": "وَخُذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِيَدِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ضِغْثاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاضْرِب", "translit": "", "root": ""}, {"id": 5, "arabic": "بِّهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تَحْنَثِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "وَجَدْن