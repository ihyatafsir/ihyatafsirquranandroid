"text": "فَقَالَ إِنِّيَ أَحْبَبْتُ حُبَّ اَ۬لْخَيْرِ عَن ذِكْرِ رَبِّے حَتَّيٰ تَوَارَتْ بِالْحِجَابِۖ", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَحْبَبْتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "حُبَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْخَيْرِ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَن", "translit": "", "root": ""}, {"id": 7, "arabic": "ذِكْرِ", "translit": "", "root": ""}, {"id": 8, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 9, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 10, "arabic": "تَوَارَتْ", "translit": "", "root": ""}, {"id": 11, "arabic": "بِالْحِجَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 33, "text": "رُدُّوهَا عَلَيَّ فَطَفِقَ مَسْحاَۢ بِالسُّوقِ وَالَاعْنَاقِۖ", "words": [{"id": 1, "arabic": "رُدُّوهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَطَفِقَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَسْحاَۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِالسُّوقِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالَاعْنَاقِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 34, "text": "وَلَقَدْ فَتَنَّا سُلَيْمَٰنَ وَأَلْقَيْنَا عَلَيٰ كُرْسِيِّهِۦ جَسَداࣰ ثُمَّ أَنَابَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَتَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "سُلَيْمَٰنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَلْقَيْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "كُرْسِيِّهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "جَسَداࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَنَابَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 35, "text": "قَالَ رَبِّ اِ۪غْفِرْ لِے وَهَبْ لِے مُلْكاࣰ لَّا يَنۢبَغِے لِأَحَدࣲ مِّنۢ بَعْدِيَۖ إِنَّكَ أَنتَ اَ۬لْوَهَّابُۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۪غْفِرْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِے", "translit": "", "root": ""}, {"id": 5, "arabic": "وَهَبْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِے", "translit": "", "root": ""}, {"id": 7, "arabic": "مُلْكاࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "يَنۢبَغِے", "translit": "", "root": ""}, {"id": 10, "arabic": "لِأَحَدࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِّنۢ", "translit": "", "root": ""}, {"id": 12, "arabic": "بَعْدِيَۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 15, "arabic": "اَ۬لْوَهَّابُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 36, "text": "فَسَخَّرْنَا لَهُ اُ۬لرِّيحَ تَجْرِے بِأَمْرِهِۦ رُخَآءً حَيْثُ أَصَابَ", "words": [{"id": 1, "arabic": "فَسَخَّرْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لرِّيحَ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَجْرِے", "translit": "", "root": ""}, {"id": 5, "arabic": "بِأَمْرِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "رُخَآءً", "translit": "", "root": ""}, {"id": 7, "arabic": "حَيْثُ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَصَابَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 37, "text": "وَالشَّيَٰطِينَ كُلَّ بَنَّآءࣲ وَغَوَّاصࣲ‏", "words": [{"id": 1, "arabic": "وَالشَّيَٰطِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَنَّآءࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَغَوَّاصࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 38, "text": "وَءَاخَرِينَ مُقَرَّنِينَ فِے اِ۬لَاصْفَادِۖ", "words": [{"id": 1, "arabic": "وَءَاخَرِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مُقَرَّنِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَاصْفَادِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 39, "text": "هَٰذَا عَطَآؤُنَا فَامْنُنَ اَوَ اَمْسِكْ بِغَيْرِ حِسَابࣲۖ", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَطَآؤُنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فَامْنُنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَوَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَمْسِكْ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِغَيْرِ", "translit": "", "root": ""}, {"id": 7, "arabic": "حِسَابࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 40, "text": "وَإِنَّ لَهُۥ عِندَنَا لَزُلْف۪يٰ وَحُسْنَ مَـَٔابࣲۖ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِندَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَزُلْف۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَحُسْنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَـَٔابࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 41, "text": "وَاذْكُرْ عَبْدَنَآ أَيُّوبَ إِذْ نَاد۪يٰ رَبَّهُۥٓ أَنِّے مَسَّنِيَ اَ۬لشَّيْطَٰنُ بِنُصْبࣲ وَعَذَابٍۖ", "words": [{"id": 1, "arabic": "وَاذْكُرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَبْدَنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَيُّوبَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَاد۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَبَّهُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنِّے", "translit": "", "root": ""}, {"id": 8, "arabic": "مَسَّنِيَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لشَّيْطَٰنُ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِنُصْبࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَعَذَابٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 42, "text": "اُ۟رْكُضْ بِرِجْلِكَۖ هَٰذَا مُغْتَسَلُۢ بَارِدࣱ وَشَرَابࣱۖ", "words": [{"id": 1, "arabic": "اُ۟رْكُضْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِرِجْلِكَۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مُغْتَسَلُۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَارِدࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَشَرَابࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 43, "text": "وَوَهَبْنَا لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم مَّعَهُمْ رَحْمَةࣰ مِّنَّا وَذِكْر۪يٰ لِأُوْلِے اِ۬لَالْبَٰبِۖ", "words": [{"id": 1, "arabic": "وَوَهَبْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَهْلَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمِثْلَهُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّعَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَحْمَةࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "وَذِكْر۪يٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "لِأُوْلِے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لَالْبَٰبِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 44, "text": "وَخُذْ بِيَدِكَ ضِغْثاࣰ فَاضْرِب بِّهِۦ وَلَا تَحْنَثِۖ اِنَّا وَجَدْنَٰهُ صَابِراࣰۖ نِّعْمَ اَ۬لْعَبْدُۖ إِنَّهُۥٓ أَوَّابࣱۖ", "words": [{"id": 1, "arabic": "وَخُذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِيَدِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ضِغْثاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاضْرِب", "translit": "", "root": ""}, {"id": 5, "arabic": "بِّهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "تَحْنَثِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "وَجَدْنَٰهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "صَابِراࣰۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "نِّعْمَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لْعَبْدُۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِنَّهُۥٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَوَّابࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 45, "text": "وَاذْكُرْ عِبَٰدَنَآ إِبْرَٰهِيمَ وَإِسْحَٰقَ وَيَعْقُوبَ أُوْلِے اِ۬لَايْدِے وَالَابْصٰ۪رِۖ", "words": [{"id": 1, "arabic": "وَاذْكُرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِبَٰدَنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِبْرَٰهِيمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَإِسْحَٰقَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَعْقُوبَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أُوْلِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لَايْدِے", "translit": "", "root": ""}, {"id": 8, "arabic": "وَالَابْصٰ۪رِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 46, "text": "إِنَّآ أَخْلَصْنَٰهُم بِخَالِصَةِ ذِكْرَي اَ۬لدّ۪ارِۖ", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَخْلَصْنَٰهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِخَالِصَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذِكْرَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لدّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 47, "text": "وَإِنَّهُمْ عِندَنَا لَمِنَ اَ۬لْمُصْطَفَيْنَ اَ۬لَاخْي۪ارِ