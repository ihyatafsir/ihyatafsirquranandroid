 يَدْعُونَ فِيهَا بِفَٰكِهَةࣲ كَثِيرَةࣲ وَشَرَابࣲۖ", "words": [{"id": 1, "arabic": "مُتَّكِـِٕينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَدْعُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بِفَٰكِهَةࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَثِيرَةࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَشَرَابࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 52, "text": "۞وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ أَتْرَابٌۖ", "words": [{"id": 1, "arabic": "۞وَعِندَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَٰصِرَٰتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لطَّرْفِ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَتْرَابٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 53, "text": "هَٰذَا مَا تُوعَدُونَ لِيَوْمِ اِ۬لْحِسَابِۖ", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تُوعَدُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَوْمِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْحِسَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 54, "text": "إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُۥ مِن نَّفَادٍۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَرِزْقُنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "", "root": ""}, {"id": 7, "arabic": "نَّفَادٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 55, "text": "هَٰذَا وَإِنَّ لِلطَّٰغِينَ لَشَرَّ مَـَٔابࣲ‏", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root":