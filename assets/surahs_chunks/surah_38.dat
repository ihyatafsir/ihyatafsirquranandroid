": "warsh"}, {"surah": 38, "ayah": 79, "text": "قَالَ رَبِّ فَأَنظِرْنِےٓ إِلَيٰ يَوْمِ يُبْعَثُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَأَنظِرْنِےٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُبْعَثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 80, "text": "قَالَ فَإِنَّكَ مِنَ اَ۬لْمُنظَرِينَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَإِنَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُنظَرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 81, "text": "إِلَيٰ يَوْمِ اِ۬لْوَقْتِ اِ۬لْمَعْلُومِۖ", "words": [{"id": 1, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْوَقْتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْمَعْلُومِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 82, "text": "قَالَ فَبِعِزَّتِكَ لَأُغْوِيَنَّهُمُۥٓ أَجْمَعِينَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَبِعِزَّتِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَأُغْوِيَنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَجْمَعِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 83, "text": "إِلَّا عِبَادَكَ مِنْهُمُ اُ۬لْمُخْلَصِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "عِبَادَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْمُخْلَصِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "aya