":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"رَبَّنَا","translit":"āَnَّbَr","root":"ربب"},{"id":3,"arabic":"عَجِّل","translit":"lِّjgَʿع","root":"عجل"},{"id":4,"arabic":"لَّنَا","translit":"āَnَّl","root":""},{"id":5,"arabic":"قِطَّنَا","translit":"āَnَّṭِq","root":"قطط"},{"id":6,"arabic":"قَبْلَ","translit":"َlْbَq","root":"قبل"},{"id":7,"arabic":"يَوْمِ","translit":"ِmْwَy","root":"يوم"},{"id":8,"arabic":"ٱلْحِسَابِ","translit":"ِbāَsِḥْlٱ","root":"حسب"}],"hasIhya":false},{"ayah":17,"text":"ٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَٱذْكُرْ عَبْدَنَا دَاوُۥدَ ذَا ٱلْأَيْدِۖ إِنَّهُۥٓ أَوَّابٌ ","translation":"Be patient over what they say and remember Our servant, David, the possessor of strength; indeed, he was one who repeatedly turned back [to Allāh].","words":[{"id":1,"arabic":"ٱصْبِرْ","translit":"ْrِbْṣٱ","root":"صبر"},{"id":2,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":5,"arabic":"وَٱذْكُرْ","translit":"ْrُkْhdٱَw","root":"ذكر"},{"id":6,"arabic":"عَبْدَنَا","translit":"āَnَdْbَʿع","root":"عبد"},{"id":7,"arabic":"دَاوُۥدَ","translit":"َdۥُwāَd","root":""},{"id":8,"arabic":"ذَا","translit":"āَhd","root":""},{"id":9,"arabic":"ٱلْأَيْدِ","translit":"ِdْyَaʾْlٱ","root":"ايد"},{"id":10,"arabic":"إِنَّهُۥٓ","translit":"ٓۥُhَّnِiʾ","root":""},{"id":11,"arabic":"أَوَّابٌ","translit":"ٌbāَّwَaʾ","root":"اوب"}],"hasIhya":false},{"ayah":18,"text":"إِنَّا سَخَّرْنَا ٱلْجِبَالَ مَعَهُۥ يُسَبِّحْنَ بِٱلْعَشِىِّ وَٱلْإِشْرَاقِ ","translation":"Indeed, We subjected the mountains [to praise] with him, exalting [Allāh] in the [late] afternoon and [after] sunrise.","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"سَخَّرْنَا","translit":"āَnْrَّhkَs","root":"سخر"},{"id":3,"arabic":"ٱلْجِبَالَ","translit":"َlāَbِjgْlٱ","root":"جبل"},{"id":4,"arabic":"مَعَهُۥ","translit":"ۥُhَʿعَm","root":""},{"id":5,"arabic":"يُسَبِّحْنَ",