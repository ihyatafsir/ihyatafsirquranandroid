ic": "مُّبِينٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 71, "text": "اِذْ قَالَ رَبُّكَ لِلْمَلَٰٓئِكَةِ إِنِّے خَٰلِقُۢ بَشَراࣰ مِّن طِينࣲ‏", "words": [{"id": 1, "arabic": "اِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 6, "arabic": "خَٰلِقُۢ", "translit": "", "root": ""}, {"id": 7, "arabic": "بَشَراࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 9, "arabic": "طِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 72, "text": "فَإِذَا سَوَّيْتُهُۥ وَنَفَخْتُ فِيهِ مِن رُّوحِے فَقَعُواْ لَهُۥ سَٰجِدِينَۖ", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "سَوَّيْتُهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَنَفَخْتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "رُّوحِے", "translit": "", "root": ""}, {"id": 7, "arabic": "فَقَعُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَٰجِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 73, "text": "فَسَجَدَ اَ۬لْمَلَٰٓئِكَةُ كُلُّهُمُۥٓ أَجْمَعُونَ", "words": [{"id": 1, "arabic": "فَسَجَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمَلَٰٓئِكَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلُّهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَجْمَعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 74, "text": "إِلَّآ إِبْلِيسَ اَ۪سْتَكْبَرَ وَكَانَ مِنَ اَ۬لْكٰ۪فِرِينَۖ", "words": [{"id": 1, "arabic": "إِلَّآ", "translit": "", "