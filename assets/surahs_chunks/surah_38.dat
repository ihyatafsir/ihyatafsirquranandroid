ِمُۥٓۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "صَالُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 60, "text": "قَالُواْ بَلَ اَنتُمْ لَا مَرْحَباَۢ بِكُمُۥٓ أَنتُمْ قَدَّمْتُمُوهُ لَنَاۖ فَبِيسَ اَ۬لْقَرَارُۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مَرْحَباَۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِكُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَدَّمْتُمُوهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَنَاۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَبِيسَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْقَرَارُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 61, "text": "قَالُواْ رَبَّنَا مَن قَدَّمَ لَنَا هَٰذَا فَزِدْهُ عَذَاباࣰ ضِعْفاࣰ فِے اِ۬لنّ۪ارِۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَدَّمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فَزِدْهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَذَاباࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "ضِعْفاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِے", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 62, "text": "وَقَالُواْ مَا لَنَا لَا نَر۪يٰ رِجَالاࣰ كُنَّا نَعُدُّهُم مِّنَ اَ۬لَاشْر۪ارِۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "نَر۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "رِجَالاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "نَعُدُّهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لَاشْر۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 63, "text": "أَتَّخَذْنَٰهُمْ سُخْرِيّاً اَمْ زَاغَتْ عَنْهُمُ اُ۬لَابْصَٰرُۖ", "words": [{"id": 1, "arabic": "أَتَّخَذْنَٰهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سُخْرِيّاً", "translit": "", "root": ""}, {"id": 3, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "زَاغَتْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَنْهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لَابْصَٰرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 64, "text": "إِنَّ ذَٰلِكَ لَحَقࣱّ تَخَاصُمُ أَهْلِ اِ۬لنّ۪ارِۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَحَقࣱّ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَخَاصُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَهْلِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 65, "text": "قُلِ اِنَّمَآ أَنَا مُنذِرࣱۖ وَمَا مِنِ اِلَٰهٍ اِلَّا اَ۬للَّهُ اُ۬لْوَٰحِدُ اُ۬لْقَهَّارُۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِنَّمَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مُنذِرࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِلَٰهٍ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْوَٰحِدُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْقَهَّارُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 66, "text": "رَبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ اَ۬لْعَزِيزُ اُ۬لْغَفَّٰرُۖ", "words": [{"id": 1, "arabic": "رَبُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنَهُمَاۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْغَفَّٰرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 67, "text": "قُلْ هُوَ نَبَؤٌاْ عَظِيمٌ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَبَؤٌاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَظِيمٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 68, "text": "اَنتُمْ عَنْهُ مُعْرِضُونَۖ", "words": [{"id": 1, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُعْرِضُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 69, "text": "مَا كَانَ لِے مِنْ عِلْمِۢ بِالْمَلَإِ اِ۬لَاعْل۪يٰٓ إِذْ يَخْتَصِمُونَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِے", "translit": "", "root": 