t": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 53, "text": "هَٰذَا مَا تُوعَدُونَ لِيَوْمِ اِ۬لْحِسَابِۖ", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تُوعَدُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِيَوْمِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْحِسَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 54, "text": "إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُۥ مِن نَّفَادٍۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَرِزْقُنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "", "root": ""}, {"id": 7, "arabic": "نَّفَادٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 55, "text": "هَٰذَا وَإِنَّ لِلطَّٰغِينَ لَشَرَّ مَـَٔابࣲ‏", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلطَّٰغِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَشَرَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَـَٔابࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 56, "text": "جَهَنَّمَ يَصْلَوْنَهَاۖ فَبِيسَ اَ۬لْمِهَادُۖ", "words": [{"id": 1, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَصْلَوْنَهَاۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَبِيسَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمِهَادُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 57, "text": "هَٰذَا فَلْيَذُوقُوهُ حَمِيمࣱ وَغَسَاقࣱ‏", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فَلْيَذُوقُوهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "حَمِيمࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَغَسَاقࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 58, "text": "وَءَاخَرُ مِن شَكْلِهِۦٓ أَزْوَٰجٌۖ", "words": [{"id": 1, "arabic": "وَءَاخَرُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "شَكْلِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَزْوَٰجٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 59, "text": "هَٰذَا فَوْجࣱ مُّقْتَحِمࣱ مَّعَكُمْۖ لَا مَرْحَباَۢ بِهِمُۥٓۖ إِنَّهُمْ صَالُواْ اُ۬لنّ۪ارِۖ", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فَوْجࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّقْتَحِمࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّعَكُمْۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "", "root": ""}, {"id": 6, "arabic": "مَرْحَباَۢ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِمُۥٓۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "صَالُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 60, "text": "قَالُواْ بَلَ اَنتُمْ لَا مَرْحَباَۢ بِكُمُۥٓ أَنتُمْ قَدَّمْتُمُوهُ لَنَاۖ فَبِيسَ اَ۬لْقَرَارُۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنتُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مَرْحَباَۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِكُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَدَّمْتُمُوهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَنَاۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَبِيسَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْقَرَارُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 61, "text": "قَالُواْ رَبَّنَا مَن قَدَّمَ لَنَا هَٰذَا فَزِدْهُ عَذَاباࣰ ضِعْفاࣰ فِے اِ۬لنّ۪ارِۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَدَّمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "فَزِدْهُ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَذَاباࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "ضِعْفاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِے", "translit": "", "root": ""}, {"id": 11, "arabic": "اِ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 62, "text": "وَقَالُواْ مَا لَنَا لَا نَر۪يٰ رِجَالاࣰ كُنَّا نَعُدُّهُم مِّنَ اَ۬لَاشْر۪ارِۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "نَر۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "رِجَالاࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "نَعُدُّهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لَاشْر۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 63, "text": "أَتَّخَذْنَٰهُمْ سُخْرِيّاً اَمْ زَاغَتْ عَنْهُمُ اُ۬لَابْصَٰرُۖ", "words": [{"id": 1, "arabic": "أَتَّخَذْنَٰهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "سُخْرِيّاً", "translit": "", "root": ""}, {"id": 3, "arabic": "اَمْ", "translit": "", "root":