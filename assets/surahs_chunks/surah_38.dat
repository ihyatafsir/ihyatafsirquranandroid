{"surah": 38, "verses": [{"ayah": 1, "text": "صٓۚ وَٱلْقُرْءَانِ ذِى ٱلذِّكْرِ ", "translation": "Ṣād.[1] By the Qur’ān containing reminder...[2]", "words": [{"id": 1, "arabic": "صٓ", "translit": "ٓṣ", "root": ""}, {"id": 2, "arabic": "وَٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱَw", "root": "قرا"}, {"id": 3, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 4, "arabic": "ٱلذِّكْرِ", "translit": "ِrْkِّhdlٱ", "root": "ذكر"}], "hasIhya": false}, {"ayah": 2, "text": "بَلِ ٱلَّذِينَ كَفَرُوا۟ فِى عِزَّةٍ وَشِقَاقٍ ", "translation": "But those who disbelieve are in pride and dissension.", "words": [{"id": 1, "arabic": "بَلِ", "translit": "ِlَb", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "عِزَّةٍ", "translit": "ٍẗَّzِʿع", "root": "عزز"}, {"id": 6, "arabic": "وَشِقَاقٍ", "translit": "ٍqāَqِhsَw", "root": "شقق"}], "hasIhya": false}, {"ayah": 3, "text": "كَمْ أَهْلَكْنَا مِن قَبْلِهِم مِّن قَرْنٍ فَنَادَوا۟ وَّلَاتَ حِينَ مَنَاصٍ ", "translation": "How many a generation have We destroyed before them, and they [then] called out; but it was not a time for escape.", "words": [{"id": 1, "arabic": "كَمْ", "translit": "ْmَk", "root": ""}, {"id": 2, "arabic": "أَهْلَكْنَا", "translit": "āَnْkَlْhَaʾ", "root": "هلك"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِهِم", "translit": "mِhِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "قَرْنٍ", "translit": "ٍnْrَq", "root": "قرن"}, {"id": 7, "arabic": "فَنَادَوا۟", "translit": "۟āwَdāَnَf", "root": "ندي"}, {"id": 8, "arabic": "وَّلَاتَ", "translit": "َtāَlَّw", "root": "لوت"}, {"id": 9, "arabic": "حِينَ", "translit": "َnyِḥ", "root": "حين"}, {"id": 10, "arabic": "مَنَاصٍ", "translit": "ٍṣāَnَm", "root": "نوص"}], "hasIhya": false}, {"ayah": 4, "text": "وَعَجِبُوٓا۟ أَن جَآءَهُم مُّنذِرٌ مِّنْهُمْۖ وَقَالَ ٱلْكَٰفِرُونَ هَٰذَا سَٰحِرٌ كَذَّابٌ ", "translation": "And they wonder that there has come to them a warner [i.e., Prophet Muḥammad (ﷺ)] from among themselves. And the disbelievers say, \"This is a magician and a liar.", "words": [{"id": 1, "arabic": "وَعَجِبُوٓا۟", "translit": "۟āٓwُbِjgَʿعَw", "root": "عجب"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "جَآءَهُم", "translit": "mُhَءٓāَjg", "root": "جيا"}, {"id": 4, "arabic": "مُّنذِرٌ", "translit": "ٌrِhdnُّm", "root": "نذر"}, {"id": 5, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 6, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 7, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}, {"id": 8, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 9, "arabic": "سَٰحِرٌ", "translit": "ٌrِḥَٰs", "root": "سحر"}, {"id": 10, "arabic": "كَذَّابٌ", "translit": "ٌbāَّhdَk", "root": "كذب"}], "hasIhya": false}, {"ayah": 5, "text": "أَجَعَلَ ٱلْءَالِهَةَ إِلَٰهًا وَٰحِدًاۖ إِنَّ هَٰذَا لَشَىْءٌ عُجَابٌ ", "translation": "Has he made the gods [only] one God? Indeed, this is a curious thing.\"", "words": [{"id": 1, "arabic": "أَجَعَلَ", "translit": "َlَʿعَjgَaʾ", "root": "جعل"}, {"id": 2, "arabic": "ٱلْءَالِهَةَ", "translit": "َẗَhِlāَءْlٱ", "root": "اله"}, {"id": 3, "arabic": "إِلَٰهًا", "translit": "āًhَٰlِiʾ", "root": "اله"}, {"id": 4, "arabic": "وَٰحِدًا", "translit": "āًdِḥَٰw", "root": "وحد"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 7, "arabic": "لَشَىْءٌ", "translit": "ٌءْàَhsَl", "root": "شيا"}, {"id": 8, "arabic": "عُجَابٌ", "translit": "ٌbāَjgُʿع", "root": "عجب"}], "hasIhya": false}, {"ayah": 6, "text": "وَٱنطَلَقَ ٱلْمَلَأُ مِنْهُمْ أَنِ ٱمْشُوا۟ وَٱصْبِرُوا۟ عَلَىٰٓ ءَالِهَتِكُمْۖ إِنَّ هَٰذَا لَشَىْءٌ يُرَادُ ", "translation": "And the eminent among them went forth, [saying], \"Continue, and be patient over [the defense of] your gods. Indeed, this is a thing intended.[1]", "words": [{"id": 1, "arabic": "وَٱنطَلَقَ", "translit": "َqَlَṭnٱَw", "root": "طلق"}, {"id": 2, "arabic": "ٱلْمَلَأُ", "translit": "ُaʾَlَmْlٱ", "root": "ملا"}, {"id": 3, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 4, "arabic": "أَنِ", "translit": "ِnَaʾ", "root": ""}, {"id": 5, "arabic": "ٱمْشُوا۟", "translit": "۟āwُhsْmٱ", "root": "مشي"}, {"id": 6, "arabic": "وَٱصْبِرُوا۟", "translit": "۟āwُrِbْṣٱَw", "root": "صبر"}, {"id": 7, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 8, "arabic": "ءَالِهَتِكُمْ", "translit": "ْmُkِtَhِlāَء", "root": "اله"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 11, "arabic": "لَشَىْءٌ", "translit": "ٌءْàَhsَl", "root": "شيا"}, {"id": 12, "arabic": "يُرَادُ", "translit": "ُdāَrُy", "root": "رود"}], "hasIhya": false}, {"ayah": 7, "text": "مَا سَمِعْنَا بِهَٰذَا فِى ٱلْمِلَّةِ ٱلْءَاخِرَةِ إِنْ هَٰذَآ إِلَّا ٱخْتِلَٰقٌ ", "translation": "We have not heard of this in the latest religion.[1] This is not but a fabrication.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 3, "arabic": "بِهَٰذَا", "translit": "āَhdَٰhِb", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْمِلَّةِ", "translit": "ِẗَّlِmْlٱ", "root": "ملل"}, {"id": 6, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 7, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 8, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱخْتِلَٰقٌ", "translit": "ٌqَٰlِtْhkٱ", "root": "خلق"}], "hasIhya": false}, {"ayah": 8, "text": "أَءُنزِلَ عَلَيْهِ ٱلذِّكْرُ مِنۢ بَيْنِنَاۚ بَلْ هُمْ فِى شَكٍّ مِّن ذِكْرِىۖ بَل لَّمَّا يَذُوقُوا۟ عَذَابِ ", "translation": "Has the message been revealed to him out of [all of] us?\" Rather, they are in doubt about My message. Rather, they have not yet tasted My punishment.", "words": [{"id": 1, "arabic": "أَءُنزِلَ", "translit": "َlِznُءَaʾ", "root": "نزل"}, {"id": 2, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلذِّكْرُ", "translit": "ُrْkِّhdlٱ", "root": "ذكر"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَيْنِنَا", "translit": "āَnِnْyَb", "root": "بين"}, {"id": 6, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "ذِكْرِى", "translit": "àِrْkِhd", "root": "ذكر"}, {"id": 12, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 13, "arabic": "لَّمَّا", "translit": "āَّmَّl", "root": ""}, {"id": 14, "arabic": "يَذُوقُوا۟", "translit": "۟āwُqwُhdَy", "root": "ذوق"}, {"id": 15, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}], "hasIhya": false}, {"ayah": 9, "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَحْمَةِ رَبِّكَ ٱلْعَزِيزِ ٱلْوَهَّابِ ", "translation": "Or do they have the depositories of the mercy of your Lord, the Exalted in Might, the Bestower?[1]", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "عِندَهُمْ", "translit": "ْmُhَdnِʿع", "root": "عند"}, {"id": 3, "arabic": "خَزَآئِنُ", "translit": "ُnِyʾٓāَzَhk", "root": "خزن"}, {"id": 4, "arabic": "رَحْمَةِ", "translit": "ِẗَmْḥَr", "root": "رحم"}, {"id": 5, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 6, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 7, "arabic": "ٱلْوَهَّابِ", "translit": "ِbāَّhَwْlٱ", "root": "وهب"}], "hasIhya": false}, {"ayah": 10, "text": "أَمْ لَهُم مُّلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَاۖ فَلْيَرْتَقُوا۟ فِى ٱلْأَسْبَٰبِ ", "translation": "Or is theirs the dominion of the heavens and the earth and what is between them? Then let them ascend through [any] ways of access.[1]", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 3, "arabic": "مُّلْكُ", "translit": "ُkْlُّm", "root": "ملك"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 8, "arabic": "فَلْيَرْتَقُوا۟", "translit": "۟āwُqَtْrَyْlَf", "root": "رقي"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْأَسْبَٰبِ", "translit": "ِbَٰbْsَaʾْlٱ", "root": "سبب"}], "hasIhya": false}, {"ayah": 11, "text": "جُندٌ مَّا هُنَالِكَ مَهْزُومٌ مِّنَ ٱلْأَحْزَابِ ", "translation": "[They are but] soldiers [who will be] defeated there among the companies [of disbelievers].", "words": [{"id": 1, "arabic": "جُندٌ", "translit": "ٌdnُjg", "root": "جند"}, {"id": 2, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 3, "arabic": "هُنَالِكَ", "translit": "َkِlāَnُh", "root": ""}, {"id": 4, "arabic": "مَهْزُومٌ", "translit": "ٌmwُzْhَm", "root": "هزم"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلْأَحْزَابِ", "translit": "ِbāَzْḥَaʾْlٱ", "root": "حزب"}], "hasIhya": false}, {"ayah": 12, "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَعَادٌ وَفِرْعَوْنُ ذُو ٱلْأَوْتَادِ ", "translation": "The people of Noah denied before them, and [the tribe of] ʿAad and Pharaoh, the owner of stakes,[1]", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "ْtَbَّhdَk", "root": "كذب"}, {"id": 2, "arabic": "قَبْلَهُمْ", "translit": "ْmُhَlْbَq", "root": "قبل"}, {"id": 3, "arabic": "قَوْمُ", "translit": "ُmْwَq", "root": "قوم"}, {"id": 4, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 5, "arabic": "وَعَادٌ", "translit": "ٌdāَʿعَw", "root": "عود"}, {"id": 6, "arabic": "وَفِرْعَوْنُ", "translit": "ُnْwَʿعْrِfَw", "root": ""}, {"id": 7, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 8, "arabic": "ٱلْأَوْتَادِ", "translit": "ِdāَtْwَaʾْlٱ", "root": "وتد"}], "hasIhya": false}, {"ayah": 13, "text": "وَثَمُودُ وَقَوْمُ لُوطٍ وَأَصْحَٰبُ لْـَٔيْكَةِۚ أُو۟لَٰٓئِكَ ٱلْأَحْزَابُ ", "translation": "And [the tribe of] Thamūd and the people of Lot and the companions of the thicket [i.e., people of Madyan]. Those are the companies.[1]", "words": [{"id": 1, "arabic": "وَثَمُودُ", "translit": "ُdwُmَhtَw", "root": ""}, {"id": 2, "arabic": "وَقَوْمُ", "translit": "ُmْwَqَw", "root": "قوم"}, {"id": 3, "arabic": "لُوطٍ", "translit": "ٍṭwُl", "root": ""}, {"id": 4, "arabic": "وَأَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾَw", "root": "صحب"}, {"id": 5, "arabic": "لْـَٔيْكَةِ", "translit": "ِẗَkْyَٔـْl", "root": ""}, {"id": 6, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 7, "arabic": "ٱلْأَحْزَابُ", "translit": "ُbāَzْḥَaʾْlٱ", "root": "حزب"}], "hasIhya": false}, {"ayah": 14, "text": "إِن كُلٌّ إِلَّا كَذَّبَ ٱلرُّسُلَ فَحَقَّ عِقَابِ ", "translation": "Each of them denied the messengers, so My penalty was justified.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "كَذَّبَ", "translit": "َbَّhdَk", "root": "كذب"}, {"id": 5, "arabic": "ٱلرُّسُلَ", "translit": "َlُsُّrlٱ", "root": "رسل"}, {"id": 6, "arabic": "فَحَقَّ", "translit": "َّqَḥَf", "root": "حقق"}, {"id": 7, "arabic": "عِقَابِ", "translit": "ِbāَqِʿع", "root": "عقب"}], "hasIhya": false}, {"ayah": 15, "text": "وَمَا يَنظُرُ هَٰٓؤُلَآءِ إِلَّا صَيْحَةً وَٰحِدَةً مَّا لَهَا مِن فَوَاقٍ ", "translation": "And these [disbelievers] await not but one blast [of the Horn]; for it there will be no delay.[1]", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يَنظُرُ", "translit": "ُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "صَيْحَةً", "translit": "ًẗَḥْyَṣ", "root": "صيح"}, {"id": 6, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "فَوَاقٍ", "translit": "ٍqāَwَf", "root": "فوق"}], "hasIhya": false}, {"ayah": 16, "text": "وَقَالُوا۟ رَبَّنَا عَجِّل لَّنَا قِطَّنَا قَبْلَ يَوْمِ ٱلْحِسَابِ ", "translation": "And they say, \"Our Lord, hasten for us our share [of the punishment] before the Day of Account.\"", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 3, "arabic": "عَجِّل", "translit": "lِّjgَʿع", "root": "عجل"}, {"id": 4, "arabic": "لَّنَا", "translit": "āَnَّl", "root": ""}, {"id": 5, "arabic": "قِطَّنَا", "translit": "āَnَّṭِq", "root": "قطط"}, {"id": 6, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 7, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 8, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": false}, {"ayah": 17, "text": "ٱصْبِرْ عَلَىٰ مَا يَقُولُونَ وَٱذْكُرْ عَبْدَنَا دَاوُۥدَ ذَا ٱلْأَيْدِۖ إِنَّهُۥٓ أَوَّابٌ ", "translation": "Be patient over what they say and remember Our servant, David, the possessor of strength; indeed, he was one who repeatedly turned back [to Allāh].", "words": [{"id": 1, "arabic": "ٱصْبِرْ", "translit": "ْrِbْṣٱ", "root": "صبر"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 5, "arabic": "وَٱذْكُرْ", "translit": "ْrُkْhdٱَw", "root": "ذكر"}, {"id": 6, "arabic": "عَبْدَنَا", "translit": "āَnَdْbَʿع", "root": "عبد"}, {"id": 7, "arabic": "دَاوُۥدَ", "translit": "َdۥُwāَd", "root": ""}, {"id": 8, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 9, "arabic": "ٱلْأَيْدِ", "translit": "ِdْyَaʾْlٱ", "root": "ايد"}, {"id": 10, "arabic": "إِنَّهُۥٓ", "translit": "ٓۥُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "أَوَّابٌ", "translit": "ٌbāَّwَaʾ", "root": "اوب"}], "hasIhya": false}, {"ayah": 18, "text": "إِنَّا سَخَّرْنَا ٱلْجِبَالَ مَعَهُۥ يُسَبِّحْنَ بِٱلْعَشِىِّ وَٱلْإِشْرَاقِ ", "translation": "Indeed, We subjected the mountains [to praise] with him, exalting [Allāh] in the [late] afternoon and [after] sunrise.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "سَخَّرْنَا", "translit": "āَnْrَّhkَs", "root": "سخر"}, {"id": 3, "arabic": "ٱلْجِبَالَ", "translit": "َlāَbِjgْlٱ", "root": "جبل"}, {"id": 4, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 5, "arabic": "يُسَبِّحْنَ", "translit": "َnْḥِّbَsُy", "root": "سبح"}, {"id": 6, "arabic": "بِٱلْعَشِىِّ", "translit": "ِّàِhsَʿعْlٱِb", "root": "عشو"}, {"id": 7, "arabic": "وَٱلْإِشْرَاقِ", "translit": "ِqāَrْhsِiʾْlٱَw", "root": "شرق"}], "hasIhya": false}, {"ayah": 19, "text": "وَٱلطَّيْرَ مَحْشُورَةًۖ كُلٌّ لَّهُۥٓ أَوَّابٌ ", "translation": "And the birds were assembled, all with him repeating [praises].", "words": [{"id": 1, "arabic": "وَٱلطَّيْرَ", "translit": "َrْyَّṭlٱَw", "root": "طير"}, {"id": 2, "arabic": "مَحْشُورَةً", "translit": "ًẗَrwُhsْḥَm", "root": "حشر"}, {"id": 3, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 4, "arabic": "لَّهُۥٓ", "translit": "ٓۥُhَّl", "root": ""}, {"id": 5, "arabic": "أَوَّابٌ", "translit": "ٌbāَّwَaʾ", "root": "اوب"}], "hasIhya": false}, {"ayah": 20, "text": "وَشَدَدْنَا مُلْكَهُۥ وَءَاتَيْنَٰهُ ٱلْحِكْمَةَ وَفَصْلَ ٱلْخِطَابِ ", "translation": "And We strengthened his kingdom and gave him wisdom and discernment in speech.", "words": [{"id": 1, "arabic": "وَشَدَدْنَا", "translit": "āَnْdَdَhsَw", "root": "شدد"}, {"id": 2, "arabic": "مُلْكَهُۥ", "translit": "ۥُhَkْlُm", "root": "ملك"}, {"id": 3, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 4, "arabic": "ٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱ", "root": "حكم"}, {"id": 5, "arabic": "وَفَصْلَ", "translit": "َlْṣَfَw", "root": "فصل"}, {"id": 6, "arabic": "ٱلْخِطَابِ", "translit": "ِbāَṭِhkْlٱ", "root": "خطب"}], "hasIhya": false}, {"ayah": 21, "text": "وَهَلْ أَتَىٰكَ نَبَؤُا۟ ٱلْخَصْمِ إِذْ تَسَوَّرُوا۟ ٱلْمِحْرَابَ ", "translation": "And has there come to you the news of the adversaries, when they climbed over the wall of [his] prayer chamber -", "words": [{"id": 1, "arabic": "وَهَلْ", "translit": "ْlَhَw", "root": ""}, {"id": 2, "arabic": "أَتَىٰكَ", "translit": "َkٰàَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "نَبَؤُا۟", "translit": "۟āُwʾَbَn", "root": "نبا"}, {"id": 4, "arabic": "ٱلْخَصْمِ", "translit": "ِmْṣَhkْlٱ", "root": "خصم"}, {"id": 5, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 6, "arabic": "تَسَوَّرُوا۟", "translit": "۟āwُrَّwَsَt", "root": "سور"}, {"id": 7, "arabic": "ٱلْمِحْرَابَ", "translit": "َbāَrْḥِmْlٱ", "root": "حرب"}], "hasIhya": false}, {"ayah": 22, "text": "إِذْ دَخَلُوا۟ عَلَىٰ دَاوُۥدَ فَفَزِعَ مِنْهُمْۖ قَالُوا۟ لَا تَخَفْۖ خَصْمَانِ بَغَىٰ بَعْضُنَا عَلَىٰ بَعْضٍ فَٱحْكُم بَيْنَنَا بِٱلْحَقِّ وَلَا تُشْطِطْ وَٱهْدِنَآ إِلَىٰ سَوَآءِ ٱلصِّرَٰطِ ", "translation": "When they entered upon David and he was alarmed by them? They said, \"Fear not. [We are] two adversaries, one of whom has wronged the other, so judge between us with truth and do not exceed [it] and guide us to the sound path.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "دَخَلُوا۟", "translit": "۟āwُlَhkَd", "root": "دخل"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "دَاوُۥدَ", "translit": "َdۥُwāَd", "root": ""}, {"id": 5, "arabic": "فَفَزِعَ", "translit": "َʿعِzَfَf", "root": "فزع"}, {"id": 6, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 7, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "تَخَفْ", "translit": "ْfَhkَt", "root": "خوف"}, {"id": 10, "arabic": "خَصْمَانِ", "translit": "ِnāَmْṣَhk", "root": "خصم"}, {"id": 11, "arabic": "بَغَىٰ", "translit": "ٰàَغَb", "root": "بغي"}, {"id": 12, "arabic": "بَعْضُنَا", "translit": "āَnُḍْʿعَb", "root": "بعض"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 15, "arabic": "فَٱحْكُم", "translit": "mُkْḥٱَf", "root": "حكم"}, {"id": 16, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 17, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "تُشْطِطْ", "translit": "ْṭِṭْhsُt", "root": "شطط"}, {"id": 20, "arabic": "وَٱهْدِنَآ", "translit": "ٓāَnِdْhٱَw", "root": "هدي"}, {"id": 21, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 22, "arabic": "سَوَآءِ", "translit": "ِءٓāَwَs", "root": "سوي"}, {"id": 23, "arabic": "ٱلصِّرَٰطِ", "translit": "ِṭَٰrِّṣlٱ", "root": "صرط"}], "hasIhya": false}, {"ayah": 23, "text": "إِنَّ هَٰذَآ أَخِى لَهُۥ تِسْعٌ وَتِسْعُونَ نَعْجَةً وَلِىَ نَعْجَةٌ وَٰحِدَةٌ فَقَالَ أَكْفِلْنِيهَا وَعَزَّنِى فِى ٱلْخِطَابِ ", "translation": "Indeed this, my brother, has ninety-nine ewes, and I have one ewe; so he said, 'Entrust her to me,' and he overpowered me in speech.\"", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَآ", "translit": "ٓāَhdَٰh", "root": ""}, {"id": 3, "arabic": "أَخِى", "translit": "àِhkَaʾ", "root": "اخو"}, {"id": 4, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 5, "arabic": "تِسْعٌ", "translit": "ٌʿعْsِt", "root": "تسع"}, {"id": 6, "arabic": "وَتِسْعُونَ", "translit": "َnwُʿعْsِtَw", "root": "تسع"}, {"id": 7, "arabic": "نَعْجَةً", "translit": "ًẗَjgْʿعَn", "root": "نعج"}, {"id": 8, "arabic": "وَلِىَ", "translit": "َàِlَw", "root": ""}, {"id": 9, "arabic": "نَعْجَةٌ", "translit": "ٌẗَjgْʿعَn", "root": "نعج"}, {"id": 10, "arabic": "وَٰحِدَةٌ", "translit": "ٌẗَdِḥَٰw", "root": "وحد"}, {"id": 11, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 12, "arabic": "أَكْفِلْنِيهَا", "translit": "āَhyِnْlِfْkَaʾ", "root": "كفل"}, {"id": 13, "arabic": "وَعَزَّنِى", "translit": "àِnَّzَʿعَw", "root": "عزز"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ٱلْخِطَابِ", "translit": "ِbāَṭِhkْlٱ", "root": "خطب"}], "hasIhya": false}, {"ayah": 24, "text": "قَالَ لَقَدْ ظَلَمَكَ بِسُؤَالِ نَعْجَتِكَ إِلَىٰ نِعَاجِهِۦۖ وَإِنَّ كَثِيرًا مِّنَ ٱلْخُلَطَآءِ لَيَبْغِى بَعْضُهُمْ عَلَىٰ بَعْضٍ إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَقَلِيلٌ مَّا هُمْۗ وَظَنَّ دَاوُۥدُ أَنَّمَا فَتَنَّٰهُ فَٱسْتَغْفَرَ رَبَّهُۥ وَخَرَّ رَاكِعًا وَأَنَابَ۩ ", "translation": "[David] said, \"He has certainly wronged you in demanding your ewe [in addition] to his ewes. And indeed, many associates oppress one another, except for those who believe and do righteous deeds - and few are they.\" And David became certain that We had tried him, and he asked forgiveness of his Lord[1] and fell down bowing [in prostration] and turned in repentance [to Allāh].", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 3, "arabic": "ظَلَمَكَ", "translit": "َkَmَlَẓ", "root": "ظلم"}, {"id": 4, "arabic": "بِسُؤَالِ", "translit": "ِlāَwʾُsِb", "root": "سال"}, {"id": 5, "arabic": "نَعْجَتِكَ", "translit": "َkِtَjgْʿعَn", "root": "نعج"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "نِعَاجِهِۦ", "translit": "ۦِhِjgāَʿعِn", "root": "نعج"}, {"id": 8, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 9, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 10, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 11, "arabic": "ٱلْخُلَطَآءِ", "translit": "ِءٓāَṭَlُhkْlٱ", "root": "خلط"}, {"id": 12, "arabic": "لَيَبْغِى", "translit": "àِغْbَyَl", "root": "بغي"}, {"id": 13, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 14, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 15, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 16, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 18, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 19, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 20, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 21, "arabic": "وَقَلِيلٌ", "translit": "ٌlyِlَqَw", "root": "قلل"}, {"id": 22, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 23, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 24, "arabic": "وَظَنَّ", "translit": "َّnَẓَw", "root": "ظنن"}, {"id": 25, "arabic": "دَاوُۥدُ", "translit": "ُdۥُwāَd", "root": ""}, {"id": 26, "arabic": "أَنَّمَا", "translit": "āَmَّnَaʾ", "root": ""}, {"id": 27, "arabic": "فَتَنَّٰهُ", "translit": "ُhَّٰnَtَf", "root": "فتن"}, {"id": 28, "arabic": "فَٱسْتَغْفَرَ", "translit": "َrَfْغَtْsٱَf", "root": "غفر"}, {"id": 29, "arabic": "رَبَّهُۥ", "translit": "ۥُhَّbَr", "root": "ربب"}, {"id": 30, "arabic": "وَخَرَّ", "translit": "َّrَhkَw", "root": "خرر"}, {"id": 31, "arabic": "رَاكِعًا", "translit": "āًʿعِkāَr", "root": "ركع"}, {"id": 32, "arabic": "وَأَنَابَ", "translit": "َbāَnَaʾَw", "root": "نوب"}], "hasIhya": false}, {"ayah": 25, "text": "فَغَفَرْنَا لَهُۥ ذَٰلِكَۖ وَإِنَّ لَهُۥ عِندَنَا لَزُلْفَىٰ وَحُسْنَ مَـَٔابٍ ", "translation": "So We forgave him that; and indeed, for him is nearness to Us and a good place of return.", "words": [{"id": 1, "arabic": "فَغَفَرْنَا", "translit": "āَnْrَfَغَf", "root": "غفر"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 4, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "عِندَنَا", "translit": "āَnَdnِʿع", "root": "عند"}, {"id": 7, "arabic": "لَزُلْفَىٰ", "translit": "ٰàَfْlُzَl", "root": "زلف"}, {"id": 8, "arabic": "وَحُسْنَ", "translit": "َnْsُḥَw", "root": "حسن"}, {"id": 9, "arabic": "مَـَٔابٍ", "translit": "ٍbāَٔـَm", "root": "اوب"}], "hasIhya": false}, {"ayah": 26, "text": "يَٰدَاوُۥدُ إِنَّا جَعَلْنَٰكَ خَلِيفَةً فِى ٱلْأَرْضِ فَٱحْكُم بَيْنَ ٱلنَّاسِ بِٱلْحَقِّ وَلَا تَتَّبِعِ ٱلْهَوَىٰ فَيُضِلَّكَ عَن سَبِيلِ ٱللَّهِۚ إِنَّ ٱلَّذِينَ يَضِلُّونَ عَن سَبِيلِ ٱللَّهِ لَهُمْ عَذَابٌ شَدِيدٌۢ بِمَا نَسُوا۟ يَوْمَ ٱلْحِسَابِ ", "translation": "[We said], \"O David, indeed We have made you a successor upon the earth, so judge between the people in truth and do not follow [your own] desire, as it will lead you astray from the way of Allāh.\" Indeed, those who go astray from the way of Allāh will have a severe punishment for having forgotten the Day of Account.", "words": [{"id": 1, "arabic": "يَٰدَاوُۥدُ", "translit": "ُdۥُwāَdَٰy", "root": ""}, {"id": 2, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 3, "arabic": "جَعَلْنَٰكَ", "translit": "َkَٰnْlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "خَلِيفَةً", "translit": "ًẗَfyِlَhk", "root": "خلف"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "فَٱحْكُم", "translit": "mُkْḥٱَf", "root": "حكم"}, {"id": 8, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 9, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 10, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تَتَّبِعِ", "translit": "ِʿعِbَّtَt", "root": "تبع"}, {"id": 13, "arabic": "ٱلْهَوَىٰ", "translit": "ٰàَwَhْlٱ", "root": "هوي"}, {"id": 14, "arabic": "فَيُضِلَّكَ", "translit": "َkَّlِḍُyَf", "root": "ضلل"}, {"id": 15, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 16, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "يَضِلُّونَ", "translit": "َnwُّlِḍَy", "root": "ضلل"}, {"id": 21, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 22, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 25, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 26, "arabic": "شَدِيدٌۢ", "translit": "ٌۢdyِdَhs", "root": "شدد"}, {"id": 27, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 28, "arabic": "نَسُوا۟", "translit": "۟āwُsَn", "root": "نسي"}, {"id": 29, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 30, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": true}, {"ayah": 27, "text": "وَمَا خَلَقْنَا ٱلسَّمَآءَ وَٱلْأَرْضَ وَمَا بَيْنَهُمَا بَٰطِلًاۚ ذَٰلِكَ ظَنُّ ٱلَّذِينَ كَفَرُوا۟ۚ فَوَيْلٌ لِّلَّذِينَ كَفَرُوا۟ مِنَ ٱلنَّارِ ", "translation": "And We did not create the heaven and the earth and that between them aimlessly. That is the assumption of those who disbelieve, so woe to those who disbelieve from the Fire.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "āَnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 7, "arabic": "بَٰطِلًا", "translit": "āًlِṭَٰb", "root": "بطل"}, {"id": 8, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 9, "arabic": "ظَنُّ", "translit": "ُّnَẓ", "root": "ظنن"}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 12, "arabic": "فَوَيْلٌ", "translit": "ٌlْyَwَf", "root": ""}, {"id": 13, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 14, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 15, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 16, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 28, "text": "أَمْ نَجْعَلُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ كَٱلْمُفْسِدِينَ فِى ٱلْأَرْضِ أَمْ نَجْعَلُ ٱلْمُتَّقِينَ كَٱلْفُجَّارِ ", "translation": "Or should We treat those who believe and do righteous deeds like corrupters in the land? Or should We treat those who fear Allāh like the wicked?", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "نَجْعَلُ", "translit": "ُlَʿعْjgَn", "root": "جعل"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 6, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 7, "arabic": "كَٱلْمُفْسِدِينَ", "translit": "َnyِdِsْfُmْlٱَk", "root": "فسد"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 11, "arabic": "نَجْعَلُ", "translit": "ُlَʿعْjgَn", "root": "جعل"}, {"id": 12, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}, {"id": 13, "arabic": "كَٱلْفُجَّارِ", "translit": "ِrāَّjgُfْlٱَk", "root": "فجر"}], "hasIhya": false}, {"ayah": 29, "text": "كِتَٰبٌ أَنزَلْنَٰهُ إِلَيْكَ مُبَٰرَكٌ لِّيَدَّبَّرُوٓا۟ ءَايَٰتِهِۦ وَلِيَتَذَكَّرَ أُو۟لُوا۟ ٱلْأَلْبَٰبِ ", "translation": "[This is] a blessed Book which We have revealed to you, [O Muḥammad], that they might reflect upon its verses and that those of understanding would be reminded.", "words": [{"id": 1, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 2, "arabic": "أَنزَلْنَٰهُ", "translit": "ُhَٰnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "مُبَٰرَكٌ", "translit": "ٌkَrَٰbُm", "root": "برك"}, {"id": 5, "arabic": "لِّيَدَّبَّرُوٓا۟", "translit": "۟āٓwُrَّbَّdَyِّl", "root": "دبر"}, {"id": 6, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 7, "arabic": "وَلِيَتَذَكَّرَ", "translit": "َrَّkَhdَtَyِlَw", "root": "ذكر"}, {"id": 8, "arabic": "أُو۟لُوا۟", "translit": "۟āwُl۟wُaʾ", "root": ""}, {"id": 9, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}], "hasIhya": false}, {"ayah": 30, "text": "وَوَهَبْنَا لِدَاوُۥدَ سُلَيْمَٰنَۚ نِعْمَ ٱلْعَبْدُۖ إِنَّهُۥٓ أَوَّابٌ ", "translation": "And to David We gave Solomon. An excellent servant, indeed he was one repeatedly turning back [to Allāh].", "words": [{"id": 1, "arabic": "وَوَهَبْنَا", "translit": "āَnْbَhَwَw", "root": "وهب"}, {"id": 2, "arabic": "لِدَاوُۥدَ", "translit": "َdۥُwāَdِl", "root": ""}, {"id": 3, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 4, "arabic": "نِعْمَ", "translit": "َmْʿعِn", "root": "نعم"}, {"id": 5, "arabic": "ٱلْعَبْدُ", "translit": "ُdْbَʿعْlٱ", "root": "عبد"}, {"id": 6, "arabic": "إِنَّهُۥٓ", "translit": "ٓۥُhَّnِiʾ", "root": ""}, {"id": 7, "arabic": "أَوَّابٌ", "translit": "ٌbāَّwَaʾ", "root": "اوب"}], "hasIhya": true}, {"ayah": 31, "text": "إِذْ عُرِضَ عَلَيْهِ بِٱلْعَشِىِّ ٱلصَّٰفِنَٰتُ ٱلْجِيَادُ ", "translation": "[Mention] when there were exhibited before him in the afternoon the poised [standing] racehorses.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "عُرِضَ", "translit": "َḍِrُʿع", "root": "عرض"}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "بِٱلْعَشِىِّ", "translit": "ِّàِhsَʿعْlٱِb", "root": "عشو"}, {"id": 5, "arabic": "ٱلصَّٰفِنَٰتُ", "translit": "ُtَٰnِfَّٰṣlٱ", "root": "صفن"}, {"id": 6, "arabic": "ٱلْجِيَادُ", "translit": "ُdāَyِjgْlٱ", "root": "جود"}], "hasIhya": false}, {"ayah": 32, "text": "فَقَالَ إِنِّىٓ أَحْبَبْتُ حُبَّ ٱلْخَيْرِ عَن ذِكْرِ رَبِّى حَتَّىٰ تَوَارَتْ بِٱلْحِجَابِ ", "translation": "And he said, \"Indeed, I gave preference to the love of good [things] over the remembrance of my Lord until it [i.e., the sun] disappeared into the curtain [of darkness].\"", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 2, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَحْبَبْتُ", "translit": "ُtْbَbْḥَaʾ", "root": "حبب"}, {"id": 4, "arabic": "حُبَّ", "translit": "َّbُḥ", "root": "حبب"}, {"id": 5, "arabic": "ٱلْخَيْرِ", "translit": "ِrْyَhkْlٱ", "root": "خير"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "ذِكْرِ", "translit": "ِrْkِhd", "root": "ذكر"}, {"id": 8, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 9, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 10, "arabic": "تَوَارَتْ", "translit": "ْtَrāَwَt", "root": "وري"}, {"id": 11, "arabic": "بِٱلْحِجَابِ", "translit": "ِbāَjgِḥْlٱِb", "root": "حجب"}], "hasIhya": false}, {"ayah": 33, "text": "رُدُّوهَا عَلَىَّۖ فَطَفِقَ مَسْحًۢا بِٱلسُّوقِ وَٱلْأَعْنَاقِ ", "translation": "[He said], \"Return them to me,\" and set about striking[1] [their] legs and necks.", "words": [{"id": 1, "arabic": "رُدُّوهَا", "translit": "āَhwُّdُr", "root": "ردد"}, {"id": 2, "arabic": "عَلَىَّ", "translit": "َّàَlَʿع", "root": ""}, {"id": 3, "arabic": "فَطَفِقَ", "translit": "َqِfَṭَf", "root": "طفق"}, {"id": 4, "arabic": "مَسْحًۢا", "translit": "āًۢḥْsَm", "root": "مسح"}, {"id": 5, "arabic": "بِٱلسُّوقِ", "translit": "ِqwُّslٱِb", "root": "سوق"}, {"id": 6, "arabic": "وَٱلْأَعْنَاقِ", "translit": "ِqāَnْʿعَaʾْlٱَw", "root": "عنق"}], "hasIhya": false}, {"ayah": 34, "text": "وَلَقَدْ فَتَنَّا سُلَيْمَٰنَ وَأَلْقَيْنَا عَلَىٰ كُرْسِيِّهِۦ جَسَدًا ثُمَّ أَنَابَ ", "translation": "And We certainly tried Solomon and placed on his throne a body;[1] then he returned.[2]", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "فَتَنَّا", "translit": "āَّnَtَf", "root": "فتن"}, {"id": 3, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 4, "arabic": "وَأَلْقَيْنَا", "translit": "āَnْyَqْlَaʾَw", "root": "لقي"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "كُرْسِيِّهِۦ", "translit": "ۦِhِّyِsْrُk", "root": "كرس"}, {"id": 7, "arabic": "جَسَدًا", "translit": "āًdَsَjg", "root": "جسد"}, {"id": 8, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 9, "arabic": "أَنَابَ", "translit": "َbāَnَaʾ", "root": "نوب"}], "hasIhya": false}, {"ayah": 35, "text": "قَالَ رَبِّ ٱغْفِرْ لِى وَهَبْ لِى مُلْكًا لَّا يَنۢبَغِى لِأَحَدٍ مِّنۢ بَعْدِىٓۖ إِنَّكَ أَنتَ ٱلْوَهَّابُ ", "translation": "He said, \"My Lord, forgive me and grant me a kingdom such as will not belong to anyone after me. Indeed, You are the Bestower.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱغْفِرْ", "translit": "ْrِfْغٱ", "root": "غفر"}, {"id": 4, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 5, "arabic": "وَهَبْ", "translit": "ْbَhَw", "root": "وهب"}, {"id": 6, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 7, "arabic": "مُلْكًا", "translit": "āًkْlُm", "root": "ملك"}, {"id": 8, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 9, "arabic": "يَنۢبَغِى", "translit": "àِغَbۢnَy", "root": "بغي"}, {"id": 10, "arabic": "لِأَحَدٍ", "translit": "ٍdَḥَaʾِl", "root": "احد"}, {"id": 11, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 12, "arabic": "بَعْدِىٓ", "translit": "ٓàِdْʿعَb", "root": "بعد"}, {"id": 13, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 14, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 15, "arabic": "ٱلْوَهَّابُ", "translit": "ُbāَّhَwْlٱ", "root": "وهب"}], "hasIhya": false}, {"ayah": 36, "text": "فَسَخَّرْنَا لَهُ ٱلرِّيحَ تَجْرِى بِأَمْرِهِۦ رُخَآءً حَيْثُ أَصَابَ ", "translation": "So We subjected to him the wind blowing by his command, gently, wherever he directed,", "words": [{"id": 1, "arabic": "فَسَخَّرْنَا", "translit": "āَnْrَّhkَsَf", "root": "سخر"}, {"id": 2, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 3, "arabic": "ٱلرِّيحَ", "translit": "َḥyِّrlٱ", "root": "روح"}, {"id": 4, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 5, "arabic": "بِأَمْرِهِۦ", "translit": "ۦِhِrْmَaʾِb", "root": "امر"}, {"id": 6, "arabic": "رُخَآءً", "translit": "ًءٓāَhkُr", "root": "رخو"}, {"id": 7, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 8, "arabic": "أَصَابَ", "translit": "َbāَṣَaʾ", "root": "صوب"}], "hasIhya": false}, {"ayah": 37, "text": "وَٱلشَّيَٰطِينَ كُلَّ بَنَّآءٍ وَغَوَّاصٍ ", "translation": "And [also] the devils [of jinn] - every builder and diver", "words": [{"id": 1, "arabic": "وَٱلشَّيَٰطِينَ", "translit": "َnyِṭَٰyَّhslٱَw", "root": "شطن"}, {"id": 2, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 3, "arabic": "بَنَّآءٍ", "translit": "ٍءٓāَّnَb", "root": "بني"}, {"id": 4, "arabic": "وَغَوَّاصٍ", "translit": "ٍṣāَّwَغَw", "root": "غوص"}], "hasIhya": false}, {"ayah": 38, "text": "وَءَاخَرِينَ مُقَرَّنِينَ فِى ٱلْأَصْفَادِ ", "translation": "And others bound together in irons.", "words": [{"id": 1, "arabic": "وَءَاخَرِينَ", "translit": "َnyِrَhkāَءَw", "root": "اخر"}, {"id": 2, "arabic": "مُقَرَّنِينَ", "translit": "َnyِnَّrَqُm", "root": "قرن"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَصْفَادِ", "translit": "ِdāَfْṣَaʾْlٱ", "root": "صفد"}], "hasIhya": false}, {"ayah": 39, "text": "هَٰذَا عَطَآؤُنَا فَٱمْنُنْ أَوْ أَمْسِكْ بِغَيْرِ حِسَابٍ ", "translation": "[We said], \"This is Our gift, so grant or withhold without account.\"", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "عَطَآؤُنَا", "translit": "āَnُwʾٓāَṭَʿع", "root": "عطو"}, {"id": 3, "arabic": "فَٱمْنُنْ", "translit": "ْnُnْmٱَf", "root": "منن"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "أَمْسِكْ", "translit": "ْkِsْmَaʾ", "root": "مسك"}, {"id": 6, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 7, "arabic": "حِسَابٍ", "translit": "ٍbāَsِḥ", "root": "حسب"}], "hasIhya": false}, {"ayah": 40, "text": "وَإِنَّ لَهُۥ عِندَنَا لَزُلْفَىٰ وَحُسْنَ مَـَٔابٍ ", "translation": "And indeed, for him is nearness to Us and a good place of return.", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "عِندَنَا", "translit": "āَnَdnِʿع", "root": "عند"}, {"id": 4, "arabic": "لَزُلْفَىٰ", "translit": "ٰàَfْlُzَl", "root": "زلف"}, {"id": 5, "arabic": "وَحُسْنَ", "translit": "َnْsُḥَw", "root": "حسن"}, {"id": 6, "arabic": "مَـَٔابٍ", "translit": "ٍbāَٔـَm", "root": "اوب"}], "hasIhya": false}, {"ayah": 41, "text": "وَٱذْكُرْ عَبْدَنَآ أَيُّوبَ إِذْ نَادَىٰ رَبَّهُۥٓ أَنِّى مَسَّنِىَ ٱلشَّيْطَٰنُ بِنُصْبٍ وَعَذَابٍ ", "translation": "And remember Our servant Job, when he called to his Lord, \"Indeed, Satan has touched me with hardship and torment.\"", "words": [{"id": 1, "arabic": "وَٱذْكُرْ", "translit": "ْrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "عَبْدَنَآ", "translit": "ٓāَnَdْbَʿع", "root": "عبد"}, {"id": 3, "arabic": "أَيُّوبَ", "translit": "َbwُّyَaʾ", "root": ""}, {"id": 4, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 5, "arabic": "نَادَىٰ", "translit": "ٰàَdāَn", "root": "ندي"}, {"id": 6, "arabic": "رَبَّهُۥٓ", "translit": "ٓۥُhَّbَr", "root": "ربب"}, {"id": 7, "arabic": "أَنِّى", "translit": "àِّnَaʾ", "root": ""}, {"id": 8, "arabic": "مَسَّنِىَ", "translit": "َàِnَّsَm", "root": "مسس"}, {"id": 9, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 10, "arabic": "بِنُصْبٍ", "translit": "ٍbْṣُnِb", "root": "نصب"}, {"id": 11, "arabic": "وَعَذَابٍ", "translit": "ٍbāَhdَʿعَw", "root": "عذب"}], "hasIhya": false}, {"ayah": 42, "text": "ٱرْكُضْ بِرِجْلِكَۖ هَٰذَا مُغْتَسَلٌۢ بَارِدٌ وَشَرَابٌ ", "translation": "[So he was told], \"Strike [the ground] with your foot; this is a [spring for a] cool bath and drink.\"", "words": [{"id": 1, "arabic": "ٱرْكُضْ", "translit": "ْḍُkْrٱ", "root": "ركض"}, {"id": 2, "arabic": "بِرِجْلِكَ", "translit": "َkِlْjgِrِb", "root": "رجل"}, {"id": 3, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 4, "arabic": "مُغْتَسَلٌۢ", "translit": "ٌۢlَsَtْغُm", "root": "غسل"}, {"id": 5, "arabic": "بَارِدٌ", "translit": "ٌdِrāَb", "root": "برد"}, {"id": 6, "arabic": "وَشَرَابٌ", "translit": "ٌbāَrَhsَw", "root": "شرب"}], "hasIhya": false}, {"ayah": 43, "text": "وَوَهَبْنَا لَهُۥٓ أَهْلَهُۥ وَمِثْلَهُم مَّعَهُمْ رَحْمَةً مِّنَّا وَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَٰبِ ", "translation": "And We granted him his family and a like [number] with them as mercy from Us and a reminder for those of understanding.", "words": [{"id": 1, "arabic": "وَوَهَبْنَا", "translit": "āَnْbَhَwَw", "root": "وهب"}, {"id": 2, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 3, "arabic": "أَهْلَهُۥ", "translit": "ۥُhَlْhَaʾ", "root": "اهل"}, {"id": 4, "arabic": "وَمِثْلَهُم", "translit": "mُhَlْhtِmَw", "root": "مثل"}, {"id": 5, "arabic": "مَّعَهُمْ", "translit": "ْmُhَʿعَّm", "root": ""}, {"id": 6, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 7, "arabic": "مِّنَّا", "translit": "āَّnِّm", "root": ""}, {"id": 8, "arabic": "وَذِكْرَىٰ", "translit": "ٰàَrْkِhdَw", "root": "ذكر"}, {"id": 9, "arabic": "لِأُو۟لِى", "translit": "àِl۟wُaʾِl", "root": ""}, {"id": 10, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}], "hasIhya": false}, {"ayah": 44, "text": "وَخُذْ بِيَدِكَ ضِغْثًا فَٱضْرِب بِّهِۦ وَلَا تَحْنَثْۗ إِنَّا وَجَدْنَٰهُ صَابِرًاۚ نِّعْمَ ٱلْعَبْدُۖ إِنَّهُۥٓ أَوَّابٌ ", "translation": "[We said], \"And take in your hand a bunch [of grass] and strike with it and do not break your oath.\"[1] Indeed, We found him patient, an excellent servant. Indeed, he was one repeatedly turning back [to Allāh].", "words": [{"id": 1, "arabic": "وَخُذْ", "translit": "ْhdُhkَw", "root": "اخذ"}, {"id": 2, "arabic": "بِيَدِكَ", "translit": "َkِdَyِb", "root": "يدي"}, {"id": 3, "arabic": "ضِغْثًا", "translit": "āًhtْغِḍ", "root": "ضغث"}, {"id": 4, "arabic": "فَٱضْرِب", "translit": "bِrْḍٱَf", "root": "ضرب"}, {"id": 5, "arabic": "بِّهِۦ", "translit": "ۦِhِّb", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَحْنَثْ", "translit": "ْhtَnْḥَt", "root": "حنث"}, {"id": 8, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 9, "arabic": "وَجَدْنَٰهُ", "translit": "ُhَٰnْdَjgَw", "root": "وجد"}, {"id": 10, "arabic": "صَابِرًا", "translit": "āًrِbāَṣ", "root": "صبر"}, {"id": 11, "arabic": "نِّعْمَ", "translit": "َmْʿعِّn", "root": "نعم"}, {"id": 12, "arabic": "ٱلْعَبْدُ", "translit": "ُdْbَʿعْlٱ", "root": "عبد"}, {"id": 13, "arabic": "إِنَّهُۥٓ", "translit": "ٓۥُhَّnِiʾ", "root": ""}, {"id": 14, "arabic": "أَوَّابٌ", "translit": "ٌbāَّwَaʾ", "root": "اوب"}], "hasIhya": true}, {"ayah": 45, "text": "وَٱذْكُرْ عِبَٰدَنَآ إِبْرَٰهِيمَ وَإِسْحَٰقَ وَيَعْقُوبَ أُو۟لِى ٱلْأَيْدِى وَٱلْأَبْصَٰرِ ", "translation": "And remember Our servants, Abraham, Isaac and Jacob - those of strength and [religious] vision.", "words": [{"id": 1, "arabic": "وَٱذْكُرْ", "translit": "ْrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "عِبَٰدَنَآ", "translit": "ٓāَnَdَٰbِʿع", "root": "عبد"}, {"id": 3, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 4, "arabic": "وَإِسْحَٰقَ", "translit": "َqَٰḥْsِiʾَw", "root": ""}, {"id": 5, "arabic": "وَيَعْقُوبَ", "translit": "َbwُqْʿعَyَw", "root": ""}, {"id": 6, "arabic": "أُو۟لِى", "translit": "àِl۟wُaʾ", "root": ""}, {"id": 7, "arabic": "ٱلْأَيْدِى", "translit": "àِdْyَaʾْlٱ", "root": "يدي"}, {"id": 8, "arabic": "وَٱلْأَبْصَٰرِ", "translit": "ِrَٰṣْbَaʾْlٱَw", "root": "بصر"}], "hasIhya": false}, {"ayah": 46, "text": "إِنَّآ أَخْلَصْنَٰهُم بِخَالِصَةٍ ذِكْرَى ٱلدَّارِ ", "translation": "Indeed, We chose them for an exclusive quality: remembrance of the home [of the Hereafter].", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَخْلَصْنَٰهُم", "translit": "mُhَٰnْṣَlْhkَaʾ", "root": "خلص"}, {"id": 3, "arabic": "بِخَالِصَةٍ", "translit": "ٍẗَṣِlāَhkِb", "root": "خلص"}, {"id": 4, "arabic": "ذِكْرَى", "translit": "àَrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "ٱلدَّارِ", "translit": "ِrāَّdlٱ", "root": "دور"}], "hasIhya": false}, {"ayah": 47, "text": "وَإِنَّهُمْ عِندَنَا لَمِنَ ٱلْمُصْطَفَيْنَ ٱلْأَخْيَارِ ", "translation": "And indeed they are, to Us, among the chosen and outstanding.", "words": [{"id": 1, "arabic": "وَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "عِندَنَا", "translit": "āَnَdnِʿع", "root": "عند"}, {"id": 3, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 4, "arabic": "ٱلْمُصْطَفَيْنَ", "translit": "َnْyَfَṭْṣُmْlٱ", "root": "صفو"}, {"id": 5, "arabic": "ٱلْأَخْيَارِ", "translit": "ِrāَyْhkَaʾْlٱ", "root": "خير"}], "hasIhya": false}, {"ayah": 48, "text": "وَٱذْكُرْ إِسْمَٰعِيلَ وَٱلْيَسَعَ وَذَا ٱلْكِفْلِۖ وَكُلٌّ مِّنَ ٱلْأَخْيَارِ ", "translation": "And remember Ishmael, Elisha and Dhul-Kifl, and all are among the outstanding.", "words": [{"id": 1, "arabic": "وَٱذْكُرْ", "translit": "ْrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "إِسْمَٰعِيلَ", "translit": "َlyِʿعَٰmْsِiʾ", "root": ""}, {"id": 3, "arabic": "وَٱلْيَسَعَ", "translit": "َʿعَsَyْlٱَw", "root": ""}, {"id": 4, "arabic": "وَذَا", "translit": "āَhdَw", "root": ""}, {"id": 5, "arabic": "ٱلْكِفْلِ", "translit": "ِlْfِkْlٱ", "root": "كفل"}, {"id": 6, "arabic": "وَكُلٌّ", "translit": "ٌّlُkَw", "root": "كلل"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْأَخْيَارِ", "translit": "ِrāَyْhkَaʾْlٱ", "root": "خير"}], "hasIhya": false}, {"ayah": 49, "text": "هَٰذَا ذِكْرٌۚ وَإِنَّ لِلْمُتَّقِينَ لَحُسْنَ مَـَٔابٍ ", "translation": "This is a reminder. And indeed, for the righteous is a good place of return -", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "ذِكْرٌ", "translit": "ٌrْkِhd", "root": "ذكر"}, {"id": 3, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 4, "arabic": "لِلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِl", "root": "وقي"}, {"id": 5, "arabic": "لَحُسْنَ", "translit": "َnْsُḥَl", "root": "حسن"}, {"id": 6, "arabic": "مَـَٔابٍ", "translit": "ٍbāَٔـَm", "root": "اوب"}], "hasIhya": false}, {"ayah": 50, "text": "جَنَّٰتِ عَدْنٍ مُّفَتَّحَةً لَّهُمُ ٱلْأَبْوَٰبُ ", "translation": "Gardens of perpetual residence, whose doors will be opened to them.", "words": [{"id": 1, "arabic": "جَنَّٰتِ", "translit": "ِtَّٰnَjg", "root": "جنن"}, {"id": 2, "arabic": "عَدْنٍ", "translit": "ٍnْdَʿع", "root": ""}, {"id": 3, "arabic": "مُّفَتَّحَةً", "translit": "ًẗَḥَّtَfُّm", "root": "فتح"}, {"id": 4, "arabic": "لَّهُمُ", "translit": "ُmُhَّl", "root": ""}, {"id": 5, "arabic": "ٱلْأَبْوَٰبُ", "translit": "ُbَٰwْbَaʾْlٱ", "root": "بوب"}], "hasIhya": false}, {"ayah": 51, "text": "مُتَّكِـِٔينَ فِيهَا يَدْعُونَ فِيهَا بِفَٰكِهَةٍ كَثِيرَةٍ وَشَرَابٍ ", "translation": "Reclining within them, they will call therein for abundant fruit and drink.", "words": [{"id": 1, "arabic": "مُتَّكِـِٔينَ", "translit": "َnyِٔـِkَّtُm", "root": "وكا"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 4, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 5, "arabic": "بِفَٰكِهَةٍ", "translit": "ٍẗَhِkَٰfِb", "root": "فكه"}, {"id": 6, "arabic": "كَثِيرَةٍ", "translit": "ٍẗَryِhtَk", "root": "كثر"}, {"id": 7, "arabic": "وَشَرَابٍ", "translit": "ٍbāَrَhsَw", "root": "شرب"}], "hasIhya": false}, {"ayah": 52, "text": "وَعِندَهُمْ قَٰصِرَٰتُ ٱلطَّرْفِ أَتْرَابٌ ", "translation": "And with them will be women limiting [their] glances[1] and of equal age.", "words": [{"id": 1, "arabic": "وَعِندَهُمْ", "translit": "ْmُhَdnِʿعَw", "root": "عند"}, {"id": 2, "arabic": "قَٰصِرَٰتُ", "translit": "ُtَٰrِṣَٰq", "root": "قصر"}, {"id": 3, "arabic": "ٱلطَّرْفِ", "translit": "ِfْrَّṭlٱ", "root": "طرف"}, {"id": 4, "arabic": "أَتْرَابٌ", "translit": "ٌbāَrْtَaʾ", "root": "ترب"}], "hasIhya": false}, {"ayah": 53, "text": "هَٰذَا مَا تُوعَدُونَ لِيَوْمِ ٱلْحِسَابِ ", "translation": "This is what you, [the righteous], are promised for the Day of Account.", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "تُوعَدُونَ", "translit": "َnwُdَʿعwُt", "root": "وعد"}, {"id": 4, "arabic": "لِيَوْمِ", "translit": "ِmْwَyِl", "root": "يوم"}, {"id": 5, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": false}, {"ayah": 54, "text": "إِنَّ هَٰذَا لَرِزْقُنَا مَا لَهُۥ مِن نَّفَادٍ ", "translation": "Indeed, this is Our provision; for it there is no depletion.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "لَرِزْقُنَا", "translit": "āَnُqْzِrَl", "root": "رزق"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "نَّفَادٍ", "translit": "ٍdāَfَّn", "root": "نفد"}], "hasIhya": false}, {"ayah": 55, "text": "هَٰذَاۚ وَإِنَّ لِلطَّٰغِينَ لَشَرَّ مَـَٔابٍ ", "translation": "This [is so]. But indeed, for the transgressors is an evil place of return -", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 3, "arabic": "لِلطَّٰغِينَ", "translit": "َnyِغَّٰṭlِl", "root": "طغي"}, {"id": 4, "arabic": "لَشَرَّ", "translit": "َّrَhsَl", "root": "شرر"}, {"id": 5, "arabic": "مَـَٔابٍ", "translit": "ٍbāَٔـَm", "root": "اوب"}], "hasIhya": false}, {"ayah": 56, "text": "جَهَنَّمَ يَصْلَوْنَهَا فَبِئْسَ ٱلْمِهَادُ ", "translation": "Hell, which they will [enter to] burn, and wretched is the resting place.", "words": [{"id": 1, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 2, "arabic": "يَصْلَوْنَهَا", "translit": "āَhَnْwَlْṣَy", "root": "صلي"}, {"id": 3, "arabic": "فَبِئْسَ", "translit": "َsْyʾِbَf", "root": "باس"}, {"id": 4, "arabic": "ٱلْمِهَادُ", "translit": "ُdāَhِmْlٱ", "root": "مهد"}], "hasIhya": false}, {"ayah": 57, "text": "هَٰذَا فَلْيَذُوقُوهُ حَمِيمٌ وَغَسَّاقٌ ", "translation": "This - so let them taste it - is scalding water and [foul] purulence.", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "فَلْيَذُوقُوهُ", "translit": "ُhwُqwُhdَyْlَf", "root": "ذوق"}, {"id": 3, "arabic": "حَمِيمٌ", "translit": "ٌmyِmَḥ", "root": "حمم"}, {"id": 4, "arabic": "وَغَسَّاقٌ", "translit": "ٌqāَّsَغَw", "root": "غسق"}], "hasIhya": false}, {"ayah": 58, "text": "وَءَاخَرُ مِن شَكْلِهِۦٓ أَزْوَٰجٌ ", "translation": "And other [punishments] of its type [in various] kinds.", "words": [{"id": 1, "arabic": "وَءَاخَرُ", "translit": "ُrَhkāَءَw", "root": "اخر"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "شَكْلِهِۦٓ", "translit": "ٓۦِhِlْkَhs", "root": "شكل"}, {"id": 4, "arabic": "أَزْوَٰجٌ", "translit": "ٌjgَٰwْzَaʾ", "root": "زوج"}], "hasIhya": false}, {"ayah": 59, "text": "هَٰذَا فَوْجٌ مُّقْتَحِمٌ مَّعَكُمْۖ لَا مَرْحَبًۢا بِهِمْۚ إِنَّهُمْ صَالُوا۟ ٱلنَّارِ ", "translation": "[Its inhabitants will say], \"This is a company bursting in with you. No welcome for them. Indeed, they will burn in the Fire.\"", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 2, "arabic": "فَوْجٌ", "translit": "ٌjgْwَf", "root": "فوج"}, {"id": 3, "arabic": "مُّقْتَحِمٌ", "translit": "ٌmِḥَtْqُّm", "root": "قحم"}, {"id": 4, "arabic": "مَّعَكُمْ", "translit": "ْmُkَʿعَّm", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "مَرْحَبًۢا", "translit": "āًۢbَḥْrَm", "root": "رحب"}, {"id": 7, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 8, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 9, "arabic": "صَالُوا۟", "translit": "۟āwُlāَṣ", "root": "صلي"}, {"id": 10, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 60, "text": "قَالُوا۟ بَلْ أَنتُمْ لَا مَرْحَبًۢا بِكُمْۖ أَنتُمْ قَدَّمْتُمُوهُ لَنَاۖ فَبِئْسَ ٱلْقَرَارُ ", "translation": "They will say, \"Nor you! No welcome for you. You, [our leaders], brought this upon us, and wretched is the settlement.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 3, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "مَرْحَبًۢا", "translit": "āًۢbَḥْrَm", "root": "رحب"}, {"id": 6, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 7, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 8, "arabic": "قَدَّمْتُمُوهُ", "translit": "ُhwُmُtْmَّdَq", "root": "قدم"}, {"id": 9, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 10, "arabic": "فَبِئْسَ", "translit": "َsْyʾِbَf", "root": "باس"}, {"id": 11, "arabic": "ٱلْقَرَارُ", "translit": "ُrāَrَqْlٱ", "root": "قرر"}], "hasIhya": false}, {"ayah": 61, "text": "قَالُوا۟ رَبَّنَا مَن قَدَّمَ لَنَا هَٰذَا فَزِدْهُ عَذَابًا ضِعْفًا فِى ٱلنَّارِ ", "translation": "They will say, \"Our Lord, whoever brought this upon us - increase for him double punishment in the Fire.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "قَدَّمَ", "translit": "َmَّdَq", "root": "قدم"}, {"id": 5, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 6, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 7, "arabic": "فَزِدْهُ", "translit": "ُhْdِzَf", "root": "زيد"}, {"id": 8, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 9, "arabic": "ضِعْفًا", "translit": "āًfْʿعِḍ", "root": "ضعف"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 62, "text": "وَقَالُوا۟ مَا لَنَا لَا نَرَىٰ رِجَالًا كُنَّا نَعُدُّهُم مِّنَ ٱلْأَشْرَارِ ", "translation": "And they will say, \"Why do we not see men whom we used to count among the worst?[1]", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "نَرَىٰ", "translit": "ٰàَrَn", "root": "راي"}, {"id": 6, "arabic": "رِجَالًا", "translit": "āًlāَjgِr", "root": "رجل"}, {"id": 7, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 8, "arabic": "نَعُدُّهُم", "translit": "mُhُّdُʿعَn", "root": "عدد"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلْأَشْرَارِ", "translit": "ِrāَrْhsَaʾْlٱ", "root": "شرر"}], "hasIhya": true}, {"ayah": 63, "text": "أَتَّخَذْنَٰهُمْ سِخْرِيًّا أَمْ زَاغَتْ عَنْهُمُ ٱلْأَبْصَٰرُ ", "translation": "Is it [because] we took them in ridicule, or has [our] vision turned away from them?\"", "words": [{"id": 1, "arabic": "أَتَّخَذْنَٰهُمْ", "translit": "ْmُhَٰnْhdَhkَّtَaʾ", "root": "اخذ"}, {"id": 2, "arabic": "سِخْرِيًّا", "translit": "āًّyِrْhkِs", "root": "سخر"}, {"id": 3, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 4, "arabic": "زَاغَتْ", "translit": "ْtَغāَz", "root": "زيغ"}, {"id": 5, "arabic": "عَنْهُمُ", "translit": "ُmُhْnَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْأَبْصَٰرُ", "translit": "ُrَٰṣْbَaʾْlٱ", "root": "بصر"}], "hasIhya": false}, {"ayah": 64, "text": "إِنَّ ذَٰلِكَ لَحَقٌّ تَخَاصُمُ أَهْلِ ٱلنَّارِ ", "translation": "Indeed, that is truth [i.e., reality] - the quarreling of the people of the Fire.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 3, "arabic": "لَحَقٌّ", "translit": "ٌّqَḥَl", "root": "حقق"}, {"id": 4, "arabic": "تَخَاصُمُ", "translit": "ُmُṣāَhkَt", "root": "خصم"}, {"id": 5, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 6, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 65, "text": "قُلْ إِنَّمَآ أَنَا۠ مُنذِرٌۖ وَمَا مِنْ إِلَٰهٍ إِلَّا ٱللَّهُ ٱلْوَٰحِدُ ٱلْقَهَّارُ ", "translation": "Say, [O Muḥammad], \"I am only a warner, and there is not any deity except Allāh, the One, the Prevailing,[1]", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 4, "arabic": "مُنذِرٌ", "translit": "ٌrِhdnُm", "root": "نذر"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "إِلَٰهٍ", "translit": "ٍhَٰlِiʾ", "root": "اله"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "ٱلْوَٰحِدُ", "translit": "ُdِḥَٰwْlٱ", "root": "وحد"}, {"id": 11, "arabic": "ٱلْقَهَّارُ", "translit": "ُrāَّhَqْlٱ", "root": "قهر"}], "hasIhya": true}, {"ayah": 66, "text": "رَبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا ٱلْعَزِيزُ ٱلْغَفَّٰرُ ", "translation": "Lord of the heavens and the earth and whatever is between them, the Exalted in Might,[1] the Perpetual Forgiver.\"[2]", "words": [{"id": 1, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 2, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 6, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 7, "arabic": "ٱلْغَفَّٰرُ", "translit": "ُrَّٰfَغْlٱ", "root": "غفر"}], "hasIhya": true}, {"ayah": 67, "text": "قُلْ هُوَ نَبَؤٌا۟ عَظِيمٌ ", "translation": "Say, \"It is great news", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "نَبَؤٌا۟", "translit": "۟āٌwʾَbَn", "root": "نبا"}, {"id": 4, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 68, "text": "أَنتُمْ عَنْهُ مُعْرِضُونَ ", "translation": "From which you turn away.", "words": [{"id": 1, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 2, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 3, "arabic": "مُعْرِضُونَ", "translit": "َnwُḍِrْʿعُm", "root": "عرض"}], "hasIhya": false}, {"ayah": 69, "text": "مَا كَانَ لِىَ مِنْ عِلْمٍۭ بِٱلْمَلَإِ ٱلْأَعْلَىٰٓ إِذْ يَخْتَصِمُونَ ", "translation": "I had no knowledge of the exalted assembly [of angels] when they were disputing [the creation of Adam].", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِىَ", "translit": "َàِl", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "عِلْمٍۭ", "translit": "ٍۭmْlِʿع", "root": "علم"}, {"id": 6, "arabic": "بِٱلْمَلَإِ", "translit": "ِiʾَlَmْlٱِb", "root": "ملا"}, {"id": 7, "arabic": "ٱلْأَعْلَىٰٓ", "translit": "ٰٓàَlْʿعَaʾْlٱ", "root": "علو"}, {"id": 8, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 9, "arabic": "يَخْتَصِمُونَ", "translit": "َnwُmِṣَtْhkَy", "root": "خصم"}], "hasIhya": false}, {"ayah": 70, "text": "إِن يُوحَىٰٓ إِلَىَّ إِلَّآ أَنَّمَآ أَنَا۠ نَذِيرٌ مُّبِينٌ ", "translation": "It has not been revealed to me except that I am a clear warner.\"", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 3, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 4, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 5, "arabic": "أَنَّمَآ", "translit": "ٓāَmَّnَaʾ", "root": ""}, {"id": 6, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 7, "arabic": "نَذِيرٌ", "translit": "ٌryِhdَn", "root": "نذر"}, {"id": 8, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 71, "text": "إِذْ قَالَ رَبُّكَ لِلْمَلَٰٓئِكَةِ إِنِّى خَٰلِقٌۢ بَشَرًا مِّن طِينٍ ", "translation": "[So mention] when your Lord said to the angels, \"Indeed, I am going to create a human being from clay.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlِl", "root": "ملك"}, {"id": 5, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 6, "arabic": "خَٰلِقٌۢ", "translit": "ٌۢqِlَٰhk", "root": "خلق"}, {"id": 7, "arabic": "بَشَرًا", "translit": "āًrَhsَb", "root": "بشر"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "طِينٍ", "translit": "ٍnyِṭ", "root": "طين"}], "hasIhya": true}, {"ayah": 72, "text": "فَإِذَا سَوَّيْتُهُۥ وَنَفَخْتُ فِيهِ مِن رُّوحِى فَقَعُوا۟ لَهُۥ سَٰجِدِينَ ", "translation": "So when I have proportioned him and breathed into him of My [created] soul,[1] then fall down to him in prostration.\"", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "سَوَّيْتُهُۥ", "translit": "ۥُhُtْyَّwَs", "root": "سوي"}, {"id": 3, "arabic": "وَنَفَخْتُ", "translit": "ُtْhkَfَnَw", "root": "نفخ"}, {"id": 4, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "رُّوحِى", "translit": "àِḥwُّr", "root": "روح"}, {"id": 7, "arabic": "فَقَعُوا۟", "translit": "۟āwُʿعَqَf", "root": "وقع"}, {"id": 8, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 9, "arabic": "سَٰجِدِينَ", "translit": "َnyِdِjgَٰs", "root": "سجد"}], "hasIhya": true}, {"ayah": 73, "text": "فَسَجَدَ ٱلْمَلَٰٓئِكَةُ كُلُّهُمْ أَجْمَعُونَ ", "translation": "So the angels prostrated - all of them entirely,", "words": [{"id": 1, "arabic": "فَسَجَدَ", "translit": "َdَjgَsَf", "root": "سجد"}, {"id": 2, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 3, "arabic": "كُلُّهُمْ", "translit": "ْmُhُّlُk", "root": "كلل"}, {"id": 4, "arabic": "أَجْمَعُونَ", "translit": "َnwُʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": false}, {"ayah": 74, "text": "إِلَّآ إِبْلِيسَ ٱسْتَكْبَرَ وَكَانَ مِنَ ٱلْكَٰفِرِينَ ", "translation": "Except Iblees;[1] he was arrogant and became among the disbelievers.", "words": [{"id": 1, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 2, "arabic": "إِبْلِيسَ", "translit": "َsyِlْbِiʾ", "root": ""}, {"id": 3, "arabic": "ٱسْتَكْبَرَ", "translit": "َrَbْkَtْsٱ", "root": "كبر"}, {"id": 4, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 75, "text": "قَالَ يَٰٓإِبْلِيسُ مَا مَنَعَكَ أَن تَسْجُدَ لِمَا خَلَقْتُ بِيَدَىَّۖ أَسْتَكْبَرْتَ أَمْ كُنتَ مِنَ ٱلْعَالِينَ ", "translation": "[Allāh] said, \"O Iblees, what prevented you from prostrating to that which I created with My hands?[1] Were you arrogant [then], or were you [already] among the haughty?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓإِبْلِيسُ", "translit": "ُsyِlْbِiʾَٰٓy", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "مَنَعَكَ", "translit": "َkَʿعَnَm", "root": "منع"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَسْجُدَ", "translit": "َdُjgْsَt", "root": "سجد"}, {"id": 7, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 8, "arabic": "خَلَقْتُ", "translit": "ُtْqَlَhk", "root": "خلق"}, {"id": 9, "arabic": "بِيَدَىَّ", "translit": "َّàَdَyِb", "root": "يدي"}, {"id": 10, "arabic": "أَسْتَكْبَرْتَ", "translit": "َtْrَbْkَtْsَaʾ", "root": "كبر"}, {"id": 11, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 12, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 13, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 14, "arabic": "ٱلْعَالِينَ", "translit": "َnyِlāَʿعْlٱ", "root": "علو"}], "hasIhya": false}, {"ayah": 76, "text": "قَالَ أَنَا۠ خَيْرٌ مِّنْهُۖ خَلَقْتَنِى مِن نَّارٍ وَخَلَقْتَهُۥ مِن طِينٍ ", "translation": "He said, \"I am better than him. You created me from fire and created him from clay.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 3, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 4, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 5, "arabic": "خَلَقْتَنِى", "translit": "àِnَtْqَlَhk", "root": "خلق"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "نَّارٍ", "translit": "ٍrāَّn", "root": "نور"}, {"id": 8, "arabic": "وَخَلَقْتَهُۥ", "translit": "ۥُhَtْqَlَhkَw", "root": "خلق"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "طِينٍ", "translit": "ٍnyِṭ", "root": "طين"}], "hasIhya": true}, {"ayah": 77, "text": "قَالَ فَٱخْرُجْ مِنْهَا فَإِنَّكَ رَجِيمٌ ", "translation": "[Allāh] said, \"Then get out of it [i.e., Paradise], for indeed, you are expelled.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَٱخْرُجْ", "translit": "ْjgُrْhkٱَf", "root": "خرج"}, {"id": 3, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 4, "arabic": "فَإِنَّكَ", "translit": "َkَّnِiʾَf", "root": ""}, {"id": 5, "arabic": "رَجِيمٌ", "translit": "ٌmyِjgَr", "root": "رجم"}], "hasIhya": false}, {"ayah": 78, "text": "وَإِنَّ عَلَيْكَ لَعْنَتِىٓ إِلَىٰ يَوْمِ ٱلدِّينِ ", "translation": "And indeed, upon you is My curse until the Day of Recompense.\"", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 2, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "لَعْنَتِىٓ", "translit": "ٓàِtَnْʿعَl", "root": "لعن"}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 6, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}], "hasIhya": false}, {"ayah": 79, "text": "قَالَ رَبِّ فَأَنظِرْنِىٓ إِلَىٰ يَوْمِ يُبْعَثُونَ ", "translation": "He said, \"My Lord, then reprieve me until the Day they are resurrected.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "فَأَنظِرْنِىٓ", "translit": "ٓàِnْrِẓnَaʾَf", "root": "نظر"}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 6, "arabic": "يُبْعَثُونَ", "translit": "َnwُhtَʿعْbُy", "root": "بعث"}], "hasIhya": true}, {"ayah": 80, "text": "قَالَ فَإِنَّكَ مِنَ ٱلْمُنظَرِينَ ", "translation": "[Allāh] said, \"So indeed, you are of those reprieved", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَإِنَّكَ", "translit": "َkَّnِiʾَf", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْمُنظَرِينَ", "translit": "َnyِrَẓnُmْlٱ", "root": "نظر"}], "hasIhya": false}, {"ayah": 81, "text": "إِلَىٰ يَوْمِ ٱلْوَقْتِ ٱلْمَعْلُومِ ", "translation": "Until the Day of the time well-known.\"", "words": [{"id": 1, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 2, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 3, "arabic": "ٱلْوَقْتِ", "translit": "ِtْqَwْlٱ", "root": "وقت"}, {"id": 4, "arabic": "ٱلْمَعْلُومِ", "translit": "ِmwُlْʿعَmْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 82, "text": "قَالَ فَبِعِزَّتِكَ لَأُغْوِيَنَّهُمْ أَجْمَعِينَ ", "translation": "[Iblees] said, \"By Your might, I will surely mislead them all", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَبِعِزَّتِكَ", "translit": "َkِtَّzِʿعِbَf", "root": "عزز"}, {"id": 3, "arabic": "لَأُغْوِيَنَّهُمْ", "translit": "ْmُhَّnَyِwْغُaʾَl", "root": "غوي"}, {"id": 4, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": false}, {"ayah": 83, "text": "إِلَّا عِبَادَكَ مِنْهُمُ ٱلْمُخْلَصِينَ ", "translation": "Except, among them, Your chosen servants.\"", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "عِبَادَكَ", "translit": "َkَdāَbِʿع", "root": "عبد"}, {"id": 3, "arabic": "مِنْهُمُ", "translit": "ُmُhْnِm", "root": ""}, {"id": 4, "arabic": "ٱلْمُخْلَصِينَ", "translit": "َnyِṣَlْhkُmْlٱ", "root": "خلص"}], "hasIhya": true}, {"ayah": 84, "text": "قَالَ فَٱلْحَقُّ وَٱلْحَقَّ أَقُولُ ", "translation": "[Allāh] said, \"The truth [is My oath], and the truth I say -", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَٱلْحَقُّ", "translit": "ُّqَḥْlٱَf", "root": "حقق"}, {"id": 3, "arabic": "وَٱلْحَقَّ", "translit": "َّqَḥْlٱَw", "root": "حقق"}, {"id": 4, "arabic": "أَقُولُ", "translit": "ُlwُqَaʾ", "root": "قول"}], "hasIhya": false}, {"ayah": 85, "text": "لَأَمْلَأَنَّ جَهَنَّمَ مِنكَ وَمِمَّن تَبِعَكَ مِنْهُمْ أَجْمَعِينَ ", "translation": "[That] I will surely fill Hell with you and those of them that follow you all together.\"", "words": [{"id": 1, "arabic": "لَأَمْلَأَنَّ", "translit": "َّnَaʾَlْmَaʾَl", "root": "ملا"}, {"id": 2, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 3, "arabic": "مِنكَ", "translit": "َknِm", "root": ""}, {"id": 4, "arabic": "وَمِمَّن", "translit": "nَّmِmَw", "root": ""}, {"id": 5, "arabic": "تَبِعَكَ", "translit": "َkَʿعِbَt", "root": "تبع"}, {"id": 6, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 7, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": false}, {"ayah": 86, "text": "قُلْ مَآ أَسْـَٔلُكُمْ عَلَيْهِ مِنْ أَجْرٍ وَمَآ أَنَا۠ مِنَ ٱلْمُتَكَلِّفِينَ ", "translation": "Say, [O Muḥammad], \"I do not ask you for it [i.e., the Qur’ān] any payment, and I am not of the pretentious.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أَسْـَٔلُكُمْ", "translit": "ْmُkُlَٔـْsَaʾ", "root": "سال"}, {"id": 4, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "أَجْرٍ", "translit": "ٍrْjgَaʾ", "root": "اجر"}, {"id": 7, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 8, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلْمُتَكَلِّفِينَ", "translit": "َnyِfِّlَkَtُmْlٱ", "root": "كلف"}], "hasIhya": false}, {"ayah": 87, "text": "إِنْ هُوَ إِلَّا ذِكْرٌ لِّلْعَٰلَمِينَ ", "translation": "It is but a reminder to the worlds.", "words": [{"id": 1, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ذِكْرٌ", "translit": "ٌrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "لِّلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlِّl", "root": "علم"}], "hasIhya": false}, {"ayah": 88, "text": "وَلَتَعْلَمُنَّ نَبَأَهُۥ بَعْدَ حِينٍۭ ", "translation": "And you will surely know [the truth of] its information after a time.\"", "words": [{"id": 1, "arabic": "وَلَتَعْلَمُنَّ", "translit": "َّnُmَlْʿعَtَlَw", "root": "علم"}, {"id": 2, "arabic": "نَبَأَهُۥ", "translit": "ۥُhَaʾَbَn", "root": "نبا"}, {"id": 3, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 4, "arabic": "حِينٍۭ", "translit": "ٍۭnyِḥ", "root": "حين"}], "hasIhya": true}], "tafsir": {"26": [{"arabic": "في تأويل هذه الآية عن جدك {يا داود إنا جعلناك خليفة في الأرض فاحكم بين الناس بالحق ولا تتبع الهوى فيضلك عن سبيل الله} قال الله تعالى في الزبور يا داود إذا قعد الخصمان بين يديك فكان لك في أحدهما هوى فلا تتمنين في نفسك أن يكون الحق له فيفلح على صاحبه فأمحوك عن نبوتي ثم لا تكون خلفتي ولا كرامة يا داود إنما جعلت رسلي إلى عبادي رعاء كرعاء الإبل لعلمهم بالرعاية ورفقهم بالسياسة ليجبروا الكسير ويدلوا الهزيل على الكلأ والماء يا أمير المؤمنين إنك قد بليت بأمر لو عرض على السموات والأرض والجبال لأبين أن يحملنه وأشفقن منه يا أمير المؤمنين حدثني يزيد بن جابر عن عبد الرحمن بن", "english": "He turned to al-Shaʿbī and said: \"O Abā ʿAmr! I am the trustee of the Commander of the Faithful over Iraq and his governor over it, and a man commanded to obedience. I have been tried with the subjects, and their right has become incumbent upon me. So I love to preserve them and to attend to what sets them right, along with sincere counsel (naṣīḥah) to them. And reports may reach me about a band of people from the regions concerning a matter, and I find myself severe against them therein, so I withhold a portion of their stipends and place it in the treasury (bayt al-māl), with the intention in myself that I shall return it to them. Then it reaches the Commander of the Faithful that I have withheld it in that manner, so he writes to me that I must not return it. I cannot then countermand his order, nor can I execute his letter [against my better judgment]. I am but a man commanded to obedience. Is there any liability upon me in this, and in similar matters, where the intention is as I have described?\"", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 553", "section_title_en": "The Upright Scholars Before the Tyrannical Rulers — Counsel and Fearless Truth-Telling", "section_index": 553, "anchors": "- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning is sincerity, faithfulness, and pure counsel free from deceit; the root denotes the act of seeking the welfare of another with complete integrity.\n  * Al-Raghib (Mufradat): In theological context, naṣīḥah is the obligation of the sincere advisor to guide the ruler toward divine truth, even at personal peril, as it is a form of worship (ʿibādah) and a trust (amānah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes pure honey (ʿasal naṣīḥ) free from admixture; metaphorical (majāz) usage applies to counsel that is untainted by flattery or self-interest.\n- Root: سلط (sulṭ)\n  * Lisan / Ayn: Denotes authority, power, and dominion; the ruler (sulṭān) is one who has been given sway over affairs.\n  * Al-Raghib (Mufradat): In Kalam, sulṭān is a trial (ibtilāʾ) and a trust (amānah) from God, whose exercise demands justice (ʿadl) and whose neglect invites divine wrath.\n  * Al-Zamakhshari (Asas): Literal usage refers to physical power or a governing authority; metaphorical usage extends to the authority of proof (sulṭān al-burhān) that compels assent.\n- Root: عظ (waʿaẓa)\n  * Lisan / Ayn: Root denotes admonition, exhortation, and reminding of consequences; it implies softening the heart through remembrance of God and the Hereafter.\n  * Al-Raghib (Mufradat): In theological terms, ʿiẓah is the act of turning the soul away from transgression through a blend of fear (tarhīb) and hope (targhīb), grounded in revealed truth.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal admonition; metaphorical usage is the admonition of circumstance (ʿiẓah al-ḥāl) when events themselves teach a lesson.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (bāb al-ḥaṣr wa al-taqyīd bi-innamā) — Governing the emphasis of exclusive predication in statements of counsel, such as \"No obedience to a creature in disobedience of the Creator,\" where the restriction (ḥaṣr) is achieved through negation and exception (nafy wa istithnāʾ).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}], "30": [{"arabic": "قوله تعالى {نعم العبد إنه أواب} إلى غير ذلك وليقل القابض في دعائه طهر الله قلبك في قلوب الأبرار وزكى عملك في عمل الأخيار وصلى على روحك في أرواح الشهداء وقد قال صلى الله عليه وسلم من أسدى إليكم معروفا فكافئوه فإن لم تستطيعوا فادعوا له حتى تعلموا أنكم قد كافأتموه (2) ومن تمام الشكر أن يستر عيوب العطاء إن كان فيه عيب ولا يحقره ولا يذمه ولا يعيره بالمنع إذا منع ويفخم عند نفسه وعند الناس صنيعه فوظيفة المعطي الاستصغار ووظيفة القابض تقلد المنة والاستعظام وعلى كل عبد القيام بحقه وذلك ل", "english": "The second: that he thank the giver, supplicate for him, and praise him; and his gratitude and supplication should be such that it does not remove him from being a mere intermediary, but rather he is a channel for the arrival of God's blessing to him. And the channel has a right, insofar as God made him a channel and an intermediary — and that does not negate seeing the blessing as from God, Glorified be He. For he, peace and blessings be upon him, said: \"He who does not thank the people has not thanked God\" {«من لم يشكر الناس لم يشكر الله»}. And God, Mighty and Majestic, has praised His servants in places for their deeds, while He is their Creator and the Originator of the capacity for them — such as His saying, Exalted is He: {«نعم العبد إنه أواب»} [\"Excellent is the servant. Indeed, he is penitent.\"] — and other similar instances.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 179", "section_title_en": "The Etiquette of the Recipient of Wealth: On the Virtue of Poverty and the Conduct of Taking from Others", "section_index": 179, "anchors": "- Root: كرم (karuma)\n  * Lisan / Ayn: Core root meaning: nobility, generosity, honorableness of origin and character.\n  * Al-Raghib (Mufradat): Theological nuance: Divine Generosity (al-Karam) as an attribute of God entailing beneficence (al-Ifḍāl) that is pure grace, not obligation.\n  * Al-Zamakhshari (Asas): Literal: nobility of lineage/character. Metaphorical: God's abundant giving without recompense.\n- Root: فضل (faḍala)\n  * Lisan / Ayn: Core root meaning: surplus, excess, superiority, that which remains beyond need.\n  * Al-Raghib (Mufradat): Theological nuance: God's Bounty (al-Faḍl) as gratuitous favor exceeding what is merited; distinct from justice ('Adl).\n  * Al-Zamakhshari (Asas): Literal: excess/surplus. Metaphorical: divine favor and grace.\n- Root: نعم (ni'ma)\n  * Lisan / Ayn: Core root meaning: well-being, bounty, benefaction; state of goodness.\n  * Al-Raghib (Mufradat): Theological nuance: al-Ni'ma as the good state (al-ḥālah al-ḥasanah) bestowed by God; its genus encompasses both little and much.\n  * Al-Zamakhshari (Asas): Literal: pleasant life and bounty. Metaphorical: \"خفت نعامتهم\" (their ostriches departed) — i.e., they went away, indicating the fleeting nature of worldly boons.\n- Root: قدر (qadara)\n  * Lisan / Ayn: Core root meaning: measure, extent, power, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-Qudrah for God is the negation of incapacity; for man, a capacity for specific acts. Al-Qadr: the divine measure/decree.\n  * Al-Zamakhshari (Asas): Literal: measure, amount, power. Metaphorical: \"فرس بعيد القدر\" (a horse of far-reaching stride) — extended reach.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the precise restriction of agency and causation in statements like \"إنما المنكر أن يرى الواسطة أصلا\" (The only objectionable thing is to regard the intermediary as the origin).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}], "35": [{"arabic": "سوءا وظلمت نفسي أستغفرك اللهم وأتوب إليك فاغفر لي وتب على إنك أنت التواب الرحيم اللهم اجعلني من التوابين واجعلني من المتطهرين واجعلني من عبادك الصالحين واجعلني عبدا صبورا شكورا واجعلني أذكرك كثيرا وأسبحك بكرة وأصيلا يقال إن من قال هذا بعد الوضوء ختم على وضوئه بخاتم ورفع له تحت العرش فلم يزل يسبح الله تعالى ويقدسه ويكتب له ثواب ذلك إلى يوم القيامة ويكره في الوضوء أمور منها أن يزيد على الثلاث فمن زاد فقد ظلم وأن يسرف في الماء توضأ عليه السلام ثلاثا وقال من زاد فقد ظلم وأساء (4) وقال سيكون قوم من هذه الأمة", "english": "Know that the use of the tooth-stick is a confirmed Sunnah. It is reported concerning its virtue from the ḥadīth of Ibn ʿUmar through a weak chain of transmission, and Abū Dāwūd and al-Ḥākim narrated it, and the latter declared it sound (ṣaḥīḥ). Al-Bayhaqī, however, deemed it weak from the ḥadīth of ʿĀʾishah, and he weakened the version containing the wording \"from seventy prayers.\" There is the ḥadīth: \"Were it not that I would impose hardship upon my community, I would have commanded them to use the tooth-stick at every prayer\" — agreed upon (muttafaq ʿalayh) from the ḥadīth of Abū Hurayrah. There is the ḥadīth: \"Why do I see you entering upon me with yellowed teeth? Use the tooth-stick!\" — al-Bazzār and al-Bayhaqī narrated it from the ḥadīth of al-ʿAbbās ibn ʿAbd al-Muṭṭalib; Abū Dāwūd and al-Baghawī from the ḥadīth of Tammām ibn al-ʿAbbās; and al-Bayhaqī from the ḥadīth of ʿAbd Allāh ibn ʿAbbās — and it is disordered (muḍṭarib). There is the ḥadīth: \"He used the tooth-stick multiple times during the night\" — Muslim narrated it from the ḥadīth of Ibn ʿAbbās. And the ḥadīth of Ibn ʿAbbās: \"The Messenger of God, may God bless him and grant him peace, did not cease commanding us to use the tooth-stick until we thought that something concerning it would be revealed to him\" — Aḥmad narrated it.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 112", "section_title_en": "The Book of the Tooth-Stick (Siwāk) and the Etiquette of Ablution (Wuḍūʾ)", "section_index": 112, "anchors": "- Root: س و ك (s-w-k)\n  * Lisan / Ayn: The root denotes rubbing or cleansing the teeth with a stick (siwāk); al-Farāhīdī notes its use for the act of friction against a surface to remove residue.\n  * Al-Raghib (Mufradat): In the religious lexicon, siwāk is a purifying act (taṭhīr) of the mouth, tied to devotional hygiene and the Sunnah's emphasis on preparing the body for prayer.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the physical stick (ʿūd) and the mechanical action; metaphorical (majāz) extension applies to spiritual purification, as the mouth's cleanliness mirrors the heart's purity.\n- Root: و ض ء (w-ḍ-ʾ)\n  * Lisan / Ayn: Wuḍūʾ signifies washing specific bodily parts for ritual purity; al-Khalīl links it to brightness and radiance (ḍawʾ), as the washed limbs shine on the Day of Resurrection.\n  * Al-Raghib (Mufradat): It is a legislated act of cleansing (ṭahārah) that removes minor ritual impurity (ḥadath), preconditioning the soul for communion with God in prayer.\n  * Al-Zamakhshari (Asas): Literal: washing with water; metaphorical: the inner purification of the heart from vices, as the outward washing symbolizes inward renewal.\n- Root: غ ر ر (gh-r-r)\n  * Lisan / Ayn: Ghurrah denotes a blaze or white mark on a horse's forehead; al-Ayn records its use for a prominent, shining feature.\n  * Al-Raghib (Mufradat): In the ḥadīth, \"ghurrah\" refers to the luminous mark on the forehead of the believer from washing in ablution, a sign of honor on the Day of Judgment.\n  * Al-Zamakhshari (Asas): Literal: the white star on a horse's brow; metaphorical: the radiant trace of worship on the believer's body, visible in the Hereafter.\n- Sibawayh Rule: Bāb al-ʿAṭf ʿalā al-Sabab (Coordination of Causes) — When linking actions or supplications (duʿāʾ) with fa- or thumma, the syntactic sequence mirrors the chronological order of ritual acts, ensuring that each clause is semantically complete and temporally precise.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "44": [{"arabic": "ورحمة وأولئك هم المهتدون} وكان حبيب بن أبي حبيب إذا قرأ هذه الآية إنا وجدناه صابرا نعم العبد إنه أواب بكى وقال واعجباه أعطى وأثنى أي هو المعطي للصبر وهو المثني وقال أبو الدرداء ذروة الإيمان الصبر للحكم والرضا بالقدر هذا بيان فضيلة الصبر من حيث النقل وأما من حيث النظر بعين الاعتبار فلا تفهمه إلا بعد فهم حقيقة الصبر ومعناه إذ معرفة الفضيلة والرتبة معرفة صفة فلا تحصل قبل معرفة الموصوف فلنذكر حقيقته ومعناه وبالله التوفيق", "english": "Allah — exalted be He — has described the patient (al-ṣābirīn) with attributes, and He mentioned patience (al-ṣabr) in the Qur’an in upwards of seventy places. He attached most of the degrees and goods to patience, making them its fruit. For He said — majestic is His utterance: {«وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا»} — “And We made from among them imams guiding by Our command, when they were patient” (Q 32:24). And He said — exalted be He: {«وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا»} — “And the good word of your Lord was fulfilled upon the Children of Israel, because they were patient” (Q 7:137). And He said — exalted be He: {«وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُم بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ»} — “And We shall surely recompense those who were patient their wage according to the best of what they used to do” (Q 16:96). And He said — exalted be He: {«أُولَٰئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا»} — “Those shall be given their wage twice, because they were patient” (Q 28:54). And He said — exalted be He: {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»} — “Only the patient shall be paid their wage without reckoning” (Q 39:10). Thus there is no act of nearness (qurbah) whose wage is not meted out by measure and account — except patience. And because fasting (al-ṣawm) is of patience, and it is half of patience, Allah — exalted be He — said: “Fasting is Mine, and I recompense it” — so He attributed it to Himself, to the exclusion of all other acts of worship. And He promised the patient that He is with them, saying — exalted be He: {«وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ»} — “And be patient; indeed Allah is with the patient” (Q 8:46). And He made victory contingent upon patience, saying — exalted be He: {«بَلَىٰ إِن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُسَوِّمِينَ»} — “Yes, if you are patient and God-fearing, and they come upon you in their rush, your Lord will reinforce you with five thousand marked angels” (Q 3:125). And He gathered for the patient things He gathered for no others, saying — exalted be He: {«أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ»} — “Those — upon them are blessings from their Lord, and mercy; and those — they are the rightly guided” (Q 2:157). So guidance, mercy, and blessings are all gathered for the patient. And to exhaust all the verses concerning the station of patience would be lengthy.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 954", "section_title_en": "The Virtue of Patience (Ṣabr) — Its Excellence in the Qur’an, Sunnah, and Reports of the Salaf", "section_index": 954, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning is “to restrain, to hold back, to bind firmly” — as in holding an animal by its halter or confining someone against departure.\n  * Al-Raghib (Mufradat): Patience is “the self’s restraint upon what reason and Sacred Law require, or from what they require it to abstain from.” It is a generic term whose specific names vary by context: in calamity it is ṣabr (opposed to jazaʿ); in battle it is courage (shajāʿah); in vexation it is forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): “I bore patiently what I disliked, and I refrained patiently from what I loved.” Metaphorical (majāz): “His right hand was made to swear patiently” (i.e., bound by an emphatic oath), and “this tree is patient against cold” (i.e., unaffected by it).\n- Root: عله (ʿ-L-H) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: ايم (A-Y-M) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: نفس (N-F-S)\n  * Al-Raghib (Mufradat): The self (nafs) as the locus of volitional restraint — patience is an act of the nafs holding itself back, distinguishing it from mere physical endurance.\n  * Al-Zamakhshari (Asas): Literal: “a precious thing” (nafīs). Metaphorical: “he poured out his soul” (i.e., his blood), and “everything that has no flowing soul does not defile water.”\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the exclusive clause {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»}, where innamā restricts the reward-without-account solely to the patient, and {«الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ»}, where the predicate is focused to Allah alone.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "قوله تعالى {نعم العبد إنه أواب} إلى غير ذلك وليقل القابض في دعائه طهر الله قلبك في قلوب الأبرار وزكى عملك في عمل الأخيار وصلى على روحك في أرواح الشهداء وقد قال صلى الله عليه وسلم من أسدى إليكم معروفا فكافئوه فإن لم تستطيعوا فادعوا له حتى تعلموا أنكم قد كافأتموه (2) ومن تمام الشكر أن يستر عيوب العطاء إن كان فيه عيب ولا يحقره ولا يذمه ولا يعيره بالمنع إذا منع ويفخم عند نفسه وعند الناس صنيعه فوظيفة المعطي الاستصغار ووظيفة القابض تقلد المنة والاستعظام وعلى كل عبد القيام بحقه وذلك ل", "english": "The second: that he thank the giver, supplicate for him, and praise him; and his gratitude and supplication should be such that it does not remove him from being a mere intermediary, but rather he is a channel for the arrival of God's blessing to him. And the channel has a right, insofar as God made him a channel and an intermediary — and that does not negate seeing the blessing as from God, Glorified be He. For he, peace and blessings be upon him, said: \"He who does not thank the people has not thanked God\" {«من لم يشكر الناس لم يشكر الله»}. And God, Mighty and Majestic, has praised His servants in places for their deeds, while He is their Creator and the Originator of the capacity for them — such as His saying, Exalted is He: {«نعم العبد إنه أواب»} [\"Excellent is the servant. Indeed, he is penitent.\"] — and other similar instances.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 179", "section_title_en": "The Etiquette of the Recipient of Wealth: On the Virtue of Poverty and the Conduct of Taking from Others", "section_index": 179, "anchors": "- Root: كرم (karuma)\n  * Lisan / Ayn: Core root meaning: nobility, generosity, honorableness of origin and character.\n  * Al-Raghib (Mufradat): Theological nuance: Divine Generosity (al-Karam) as an attribute of God entailing beneficence (al-Ifḍāl) that is pure grace, not obligation.\n  * Al-Zamakhshari (Asas): Literal: nobility of lineage/character. Metaphorical: God's abundant giving without recompense.\n- Root: فضل (faḍala)\n  * Lisan / Ayn: Core root meaning: surplus, excess, superiority, that which remains beyond need.\n  * Al-Raghib (Mufradat): Theological nuance: God's Bounty (al-Faḍl) as gratuitous favor exceeding what is merited; distinct from justice ('Adl).\n  * Al-Zamakhshari (Asas): Literal: excess/surplus. Metaphorical: divine favor and grace.\n- Root: نعم (ni'ma)\n  * Lisan / Ayn: Core root meaning: well-being, bounty, benefaction; state of goodness.\n  * Al-Raghib (Mufradat): Theological nuance: al-Ni'ma as the good state (al-ḥālah al-ḥasanah) bestowed by God; its genus encompasses both little and much.\n  * Al-Zamakhshari (Asas): Literal: pleasant life and bounty. Metaphorical: \"خفت نعامتهم\" (their ostriches departed) — i.e., they went away, indicating the fleeting nature of worldly boons.\n- Root: قدر (qadara)\n  * Lisan / Ayn: Core root meaning: measure, extent, power, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-Qudrah for God is the negation of incapacity; for man, a capacity for specific acts. Al-Qadr: the divine measure/decree.\n  * Al-Zamakhshari (Asas): Literal: measure, amount, power. Metaphorical: \"فرس بعيد القدر\" (a horse of far-reaching stride) — extended reach.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the precise restriction of agency and causation in statements like \"إنما المنكر أن يرى الواسطة أصلا\" (The only objectionable thing is to regard the intermediary as the origin).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}], "62": [{"arabic": "فقالوا {ما لنا لا نرى رجالا كنا نعدهم من الأشرار} قيل يعنون عمارا وبلالا وصهيبا والمقداد رضي الله عنهم ثم كان منهم من منعه الكبر عن الفكر والمعرفة فجهل كونه صلى الله عليه وسلم محقا ومنهم من عرف ومنعه الكبر عن الاعتراف قال الله تعالى مخبرا عنهم {فلما جاءهم ما عرفوا كفروا به} وقال {وجحدوا بها واستيقنتها أنفسهم ظلما وعلوا} وهذا الكبر قريب من التكبر على الله عز وجل وإن كان دونه ولكنه تكبر على قبول أمر الله والتواضع لرسوله", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "65": [{"arabic": "يقوله رسول الله صلى الله عليه وسلم لا إله إلا الله الواحد القهار رب السموات والأرض وما بينهما العزيز الغفار (3) وليجتهد أن يكون آخر ما يجري على قلبه عند النوم ذكر الله تعالى وأول ما يرد على قلبه عند التيقظ ذكر الله تعالى فهو علامة الحب ولا يلازم القلب في هاتين الحالتين إلا ما هو الغالب عليه فليجرب قلبه به فهو علامة الحب فإنها علامة تكشف من باطن القلب وإنما استحبت هذه الأذكار لتستجر القلب إلى ذكر الله تعالى فإذا استيقظ ليقوم قال الحمد لله الذي أحيانا بعد ما أماتنا وإليه النشور إلى آخر ما أوردناه من أدعية التيق", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Patience and Gratitude'", "badge": "Du'a"}], "66": [{"arabic": "يقوله رسول الله صلى الله عليه وسلم لا إله إلا الله الواحد القهار رب السموات والأرض وما بينهما العزيز الغفار (3) وليجتهد أن يكون آخر ما يجري على قلبه عند النوم ذكر الله تعالى وأول ما يرد على قلبه عند التيقظ ذكر الله تعالى فهو علامة الحب ولا يلازم القلب في هاتين الحالتين إلا ما هو الغالب عليه فليجرب قلبه به فهو علامة الحب فإنها علامة تكشف من باطن القلب وإنما استحبت هذه الأذكار لتستجر القلب إلى ذكر الله تعالى فإذا استيقظ ليقوم قال الحمد لله الذي أحيانا بعد ما أماتنا وإليه النشور إلى آخر ما أوردناه من أدعية التيقظ الورد الرابع يدخل بمضي النصف الأول", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}], "71": [{"arabic": "أمره بإضافته إليه إذ قال تعالى إني خالق بشرا من طين فإذا سويته ونفخت فيه من روحي فقعوا له ساجدين فنبه على أن الجسد منسوب إلى الطين والروح إلى رب العالمين والمراد بالروح والنفس في هذا المقام واحد فالخلق عبارة عن هيئة في النفس راسخة عنها تصدر الأفعال بسهولة ويسر من غير حاجة إلى فكر وروية فإن كانت الهيئة بحيث تصدر عنها الأفعال الجميلة المحمودة عقلا وشرعا سميت تلك الهيئة خلقا حسنا وإن كان الصادر عنها الأفعال القبيحة سميت الهيئة التي هي المصدر خلقا سيئا وإنما قلنا إنها هيئة راسخة لأن من يصدر منه بذل المال على الندور لحاجة عارضة لا يقال خلقه السخاء ما", "english": "I say: Know that people have spoken concerning the reality of good character (ḥusn al-khulq) — what it is — yet they have not addressed its true nature; rather, they have addressed its fruits. Then they did not even exhaust all of its fruits, but each one mentioned only those fruits that occurred to him and were present in his mind. They did not direct their attention to mentioning its definition (ḥadd) and its reality (ḥaqīqah) that encompasses all its fruits in detail and with completeness. This is like the saying of al-Ḥasan: \"Good character is a cheerful face, the giving of bounty, and the withholding of harm.\" Al-Wāsiṭī said: \"It is that one neither disputes nor is disputed with, by virtue of his intense knowledge of God most high.\" Shāh al-Kirmānī said: \"It is the withholding of harm and the bearing of burdens.\" Some said: \"It is that one be near to people, yet a stranger among them.\" Al-Wāsiṭī said on another occasion: \"It is the pleasing of creation in prosperity and adversity.\" Abū ʿUthmān said: \"It is satisfaction with God most high.\" Sahl al-Tustarī was asked about good character, and he said: \"Its lowest degree is forbearance, the abandonment of retaliation, mercy toward the oppressor, seeking forgiveness for him, and compassion toward him.\" He said on another occasion: \"It is that one does not accuse the Truth concerning provision, but trusts in Him, and reposes in His faithfulness to what He has guaranteed, so that he obeys Him and does not disobey Him in all matters — both in what is between him and his Lord, and in what is between him and people.\" ʿAlī, may God be pleased with him, said: \"Good character consists in three qualities: avoiding forbidden things, seeking what is lawful, and enlarging one's provision upon one's dependents.\" Al-Ḥusayn ibn Manṣūr said: \"It is that the harshness of creation does not affect you after your contemplation of the Truth.\" Abū Saʿīd al-Kharrāz said: \"It is that you have no concern other than God most high.\" This and the like of it is abundant — and it is an addressing of the fruits of good character, not of its very self. Nor is it even encompassing of all the fruits.", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 615", "section_title_en": "The Reality of Good Character (Ḥusn al-Khulq) — Its True Nature and the Four Pillars of the Soul", "section_index": 615, "anchors": "- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: \"التقدير المستقيم\" — precise measurement and fashioning; the outward form (khalq) and inward disposition (khuluq) as twin designations of the same root.\n  * Al-Raghib (Mufradat): \"إبداع الشيء من غير أصل ولا احتذاء\" — origination without precedent; here extended to the soul's innate constitution, which God alone originates and proportions.\n  * Al-Zamakhshari (Asas): Haqiqah: \"خلق الخراز الأديم\" — the tanner measures the hide before cutting. Majaz: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation as measured origination. Thus khuluq is the soul's measured inward form, as khalq is the body's measured outward form.\n- Root: حسن (Ḥ-S-N)\n  * Lisan / Ayn: Beauty and comeliness in both visible and invisible orders.\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which delights and is desired; three kinds: rational, appetitive, sensory. The good character is that which reason and revelation (ʿaqlan wa sharʿan) deem beautiful.\n  * Al-Zamakhshari (Asas): Haqiqah: \"أنظر إلى محاسن وجهه\" — visible beauties. Majaz: \"فلان لا يحسن شيئا\" — competence and virtue as moral beauty. The \"beautiful\" act is the metaphorical extension of visible comeliness to inward excellence.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, spirit; that which is valued and precious.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as spirit; in the verse {«ونفخت فيه من روحي»} the soul is that which is divinely breathed, distinguished from the clay body.\n  * Al-Zamakhshari (Asas): Haqiqah: \"شيء نفيس\" — precious thing. Majaz: \"دفق نفسه أي دمه\" — the self as the whole living person. Here, the soul (nafs) perceived by inner vision (baṣīrah) is of greater rank than the body perceived by sight (baṣar).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The author's repeated \"إنما قلنا\" and \"ليس الخلق عبارة عن...\" employ restrictive predication to delimit the definition of khuluq against rival candidates (act, power, knowledge), each negated in turn before the fourth meaning is affirmed.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "72": [{"arabic": "أمره بإضافته إليه إذ قال تعالى إني خالق بشرا من طين فإذا سويته ونفخت فيه من روحي فقعوا له ساجدين فنبه على أن الجسد منسوب إلى الطين والروح إلى رب العالمين والمراد بالروح والنفس في هذا المقام واحد فالخلق عبارة عن هيئة في النفس راسخة عنها تصدر الأفعال بسهولة ويسر من غير حاجة إلى فكر وروية فإن كانت الهيئة بحيث تصدر عنها الأفعال الجميلة المحمودة عقلا وشرعا سميت تلك الهيئة خلقا حسنا وإن كان الصادر عنها الأفعال القبيحة سميت الهيئة التي هي المصدر خلقا سيئا وإنما قلنا إنها هيئة راسخة لأن من يصدر منه بذل المال على الندور لحاجة عارضة", "english": "I say: Know that people have spoken concerning the reality of good character (ḥusn al-khulq) — what it is — yet they have not addressed its true nature; rather, they have addressed its fruits. Then they did not even exhaust all of its fruits, but each one mentioned only those fruits that occurred to him and were present in his mind. They did not direct their attention to mentioning its definition (ḥadd) and its reality (ḥaqīqah) that encompasses all its fruits in detail and with completeness. This is like the saying of al-Ḥasan: \"Good character is a cheerful face, the giving of bounty, and the withholding of harm.\" Al-Wāsiṭī said: \"It is that one neither disputes nor is disputed with, by virtue of his intense knowledge of God most high.\" Shāh al-Kirmānī said: \"It is the withholding of harm and the bearing of burdens.\" Some said: \"It is that one be near to people, yet a stranger among them.\" Al-Wāsiṭī said on another occasion: \"It is the pleasing of creation in prosperity and adversity.\" Abū ʿUthmān said: \"It is satisfaction with God most high.\" Sahl al-Tustarī was asked about good character, and he said: \"Its lowest degree is forbearance, the abandonment of retaliation, mercy toward the oppressor, seeking forgiveness for him, and compassion toward him.\" He said on another occasion: \"It is that one does not accuse the Truth concerning provision, but trusts in Him, and reposes in His faithfulness to what He has guaranteed, so that he obeys Him and does not disobey Him in all matters — both in what is between him and his Lord, and in what is between him and people.\" ʿAlī, may God be pleased with him, said: \"Good character consists in three qualities: avoiding forbidden things, seeking what is lawful, and enlarging one's provision upon one's dependents.\" Al-Ḥusayn ibn Manṣūr said: \"It is that the harshness of creation does not affect you after your contemplation of the Truth.\" Abū Saʿīd al-Kharrāz said: \"It is that you have no concern other than God most high.\" This and the like of it is abundant — and it is an addressing of the fruits of good character, not of its very self. Nor is it even encompassing of all the fruits.", "book_title": "Fear and Hope", "section_title_ar": "Section 615", "section_title_en": "The Reality of Good Character (Ḥusn al-Khulq) — Its True Nature and the Four Pillars of the Soul", "section_index": 615, "anchors": "- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: \"التقدير المستقيم\" — precise measurement and fashioning; the outward form (khalq) and inward disposition (khuluq) as twin designations of the same root.\n  * Al-Raghib (Mufradat): \"إبداع الشيء من غير أصل ولا احتذاء\" — origination without precedent; here extended to the soul's innate constitution, which God alone originates and proportions.\n  * Al-Zamakhshari (Asas): Haqiqah: \"خلق الخراز الأديم\" — the tanner measures the hide before cutting. Majaz: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation as measured origination. Thus khuluq is the soul's measured inward form, as khalq is the body's measured outward form.\n- Root: حسن (Ḥ-S-N)\n  * Lisan / Ayn: Beauty and comeliness in both visible and invisible orders.\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which delights and is desired; three kinds: rational, appetitive, sensory. The good character is that which reason and revelation (ʿaqlan wa sharʿan) deem beautiful.\n  * Al-Zamakhshari (Asas): Haqiqah: \"أنظر إلى محاسن وجهه\" — visible beauties. Majaz: \"فلان لا يحسن شيئا\" — competence and virtue as moral beauty. The \"beautiful\" act is the metaphorical extension of visible comeliness to inward excellence.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, spirit; that which is valued and precious.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul as spirit; in the verse {«ونفخت فيه من روحي»} the soul is that which is divinely breathed, distinguished from the clay body.\n  * Al-Zamakhshari (Asas): Haqiqah: \"شيء نفيس\" — precious thing. Majaz: \"دفق نفسه أي دمه\" — the self as the whole living person. Here, the soul (nafs) perceived by inner vision (baṣīrah) is of greater rank than the body perceived by sight (baṣar).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The author's repeated \"إنما قلنا\" and \"ليس الخلق عبارة عن...\" employ restrictive predication to delimit the definition of khuluq against rival candidates (act, power, knowledge), each negated in turn before the fourth meaning is affirmed.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}, {"arabic": "وحذرتك سخطى ألم أخلقك بيدى ونفخت فيك من روحى وأسجدت لك ملائكتى فعصيت أمرى ونسيت عهدى وتعرضت لسخطى فو عزتى وجلالى لو ملأت الأرض رجالا كلهم مثلك يعبدونني ويسبحونني ثم عصونى لأنزلتهم منازل العاصين فبكى آدم عليه السلام عند ذلك ثلثمائة عام وكان عبيد الله البجلى كثير البكاء يقول في بكائه طول ليله إلهى أنا الذى كلما طال عمرى زادت ذنوبى أنا الذى كلما هممت بترك خطيئة عرضت لى شهوة أخرى واعبيداه خطيئة لم تبل وصاحبها في طلب أخرى واعبيداه إن كانت النار لك مقيلا ومأوى واعبيداه إن كانت المقامع برأسك تهيأ", "english": "Following the example of your father Adam (upon him be peace). For Wahb ibn Munabbih related: When God caused Adam to descend from Paradise to the earth, he remained in a state where his tears would not dry. Then God—mighty and majestic is He—looked upon him on the seventh day, and he was sorrowful, dejected, and choked with grief, his head bowed low. So God—exalted is He—revealed to him: \"O Adam, what is this anguish I see in you?\" He said: \"O my Lord, my calamity has become immense, my sin has encompassed me, and I have been expelled from the dominion of my Lord. I have come to dwell in the abode of humiliation after honor, in the abode of misery after happiness, in the abode of toil after rest, in the abode of tribulation after well-being, in the abode of transience after permanence, and in the abode of death and annihilation after immortality and endurance. How should I not weep over my sin?\" So God—exalted is He—revealed to him: \"O Adam, did I not choose you for Myself, settle you in My abode, single you out with My honor, and warn you of My wrath? Did I not create you with My hand, breathe into you of My spirit, and cause My angels to prostrate before you? Yet you disobeyed My command, forgot My covenant, and exposed yourself to My wrath. By My might and My majesty, were I to fill the earth with men, all of them like you, worshipping Me and glorifying Me, and then they disobeyed Me, I would cast them down to the stations of the disobedient.\" At that, Adam (upon him be peace) wept for three hundred years.", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1255", "section_title_en": "Section 1255 — The Supplication of the Distressed and the Path of the Devout in Private Confession", "section_index": 1255, "anchors": "- Root: ضرر (ḍ-r-r)\n  * Lisan / Ayn: Core meaning of hardship, harm, and dire necessity; al-muḍṭarr is one compelled by overwhelming distress.\n  * Al-Raghib (Mufradat): Theological nuance of existential neediness before God, where the creature’s incapacity meets divine sufficiency.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense of physical/compelling necessity; metaphorical (majāz) extension to spiritual desperation and supplication.\n- Root: كرم (k-r-m)\n  * Lisan / Ayn: Nobility and generosity as intrinsic qualities of character and divine action.\n  * Al-Raghib (Mufradat): When ascribed to God, denotes His manifest, overflowing beneficence; when to humans, praiseworthy acts and virtues.\n  * Al-Zamakhshari (Asas): Literal: abundant giving; metaphorical: the \"generosity\" of rain-laden clouds or a land rich in bounty.\n- Root: عفو (ʿ-f-w)\n  * Lisan / Ayn: Erasure, pardon, and remission of a fault; to leave something unpunished.\n  * Al-Raghib (Mufradat): Divine pardon as the effacement of sin and the restoration of the sinner to a state of grace.\n  * Al-Zamakhshari (Asas): Literal: blotting out; metaphorical: comprehensive mercy that \"covers\" (shāmil) all transgressions.\n- Sibawayh Rule: باب النداء والتضرع (The Chapter of Vocative Appeal and Supplication) — Governing the syntactic patterns of direct address (yā) with epithets of divine mercy, and the anaphoric repetition of \"anā\" (I am...) for emphatic self-abasement.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'", "badge": "Afterlife"}], "76": [{"arabic": "فمن استفزته نار الغضب فقد قويت فيه قرابة الشيطان حيث قال {خلقتني من نار وخلقته من طين} فإن شأن الطين السكون والوقار وشأن النار التلظي والاستعار والحركة والاضطراب ومن نتائج الغضب الحقد والحسد وبهما هلك من هلك وفسد من فسد ومفيضهما مضغة إذا صلحت صلح معها سائر الجسد وإذا كان الحقد والحسد والغضب مما يسوق العبد إلى مواطن العطب فما أحوجه إلى معرفة معاطبه ومساويه ليحذر ذلك ويتقيه ويميطه عن القلب إن كان وينفيه ويعالجه إن رسخ في قلبه ويداويه فإن من لا يعرف الشر يقع فيه ومن عرفه فالمعرفة لا تكفيه ما لم يعرف الطريق الذي به يدفع الشر ويقصيه و", "english": "In the name of God, the Most Merciful, the Most Compassionate. Praise be to God, upon whose pardon and mercy none rely except the hopeful, and from whose evil wrath and assault none fear except the fearful — He who gradually seizes His servants from whence they know not, and who has given dominion over them to their lusts, commanding them to abandon what they desire, and who has tried them with anger while charging them to swallow their rage in what provokes them. Then He surrounded them with hardships and pleasures, and granted them respite to see how they would act. He tested their love through them, to make known the truth of what they claim. He made known to them that nothing is hidden from Him of what they conceal or proclaim, and warned them lest He seize them suddenly while they are unaware. For He said: {«They await but a single blast which will seize them while they are disputing; so they will not be able to make a bequest, nor to their families will they return»} (Q. 36:49-50). And prayers and peace be upon Muhammad, His Messenger, beneath whose banner the prophets walk, and upon his family and companions — the rightly-guided imams and the pleasing masters — prayers whose number equals the number of what has been of God's creation and what will be, and by whose blessing the first and the last are favored — and abundant peace.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 700", "section_title_en": "The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences", "section_index": 700, "anchors": "- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}, {"arabic": "وهذه أقيسة فاسدة تشبه قياس إبليس حيث قال {أنا خير منه خلقتني من نار وخلقته من طين} وإلى هؤلاء الإشارة بقوله تعالى {أولئك الذين اشتروا الحياة الدنيا بالآخرة فلا يخفف عنهم العذاب ولا هم ينصرون} وعلاج هذا الغرور إما بتصديق الإيمان وإما بالبرهان أما التصديق بمجرد الإيمان فهو أن يصدق الله تعالى في قوله ما عندكم ينفذ وما عند الله باق وفي قوله عز وجل {وما عند الله خير} وقوله {والآخرة خير وأبقى} وقوله {وما الحياة الدنيا إلا متاع الغرور} وقوله {فلا تغرنكم الحياة الدنيا} وقد أخبر رسول الله صلى الله عليه وسلم بذلك طوائف من الكفار فقلدوه وصدقوه", "english": "Know that the saying of God Most High — {«fa-lā taghurrannakum al-ḥayātu al-dunyā wa-lā yaghurrannakum billāhi al-gharūr»} (So let not the life of this world deceive you, nor let the Deceiver deceive you concerning God) — and His saying — {«wa-lākinnakum fatantum anfusakum wa-tarabbastum wa-irtabtum wa-gharratkum al-amānī»} (But ye tempted your own souls, and ye waited, and ye doubted, and vain desires deceived you) — is sufficient for the blameworthiness of self-deception (al-ghurūr). And the Messenger of God, may God's peace and blessing be upon him, has said: \"How excellent is the sleep of the intelligent and their breaking of the fast! How they outwit the wakefulness of the foolish and their striving! And verily a mustard-seed's weight [of faith] from a possessor of piety and certainty is better than the earth filled with the self-deceived.\" And the ḥadīth: \"The intelligent man (al-kayyis) is he who takes account of his own soul and works for what is after death\" — this ḥadīth was transmitted by al-Tirmidhī and Ibn Mājah from the ḥadīth of Shaddād ibn Aws.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 884", "section_title_en": "Exposition of the Blameworthiness of Self-Deception (Al-Ghurūr), Its Reality, and Its Examples", "section_index": 884, "anchors": "- Root: غرر (Gh-R-R)\n  * Lisan / Ayn: The core meaning is \"an apparent trace or mark of a thing\" (al-athar al-ẓāhir), from which derives \"the blaze of a horse\" (ghurrat al-faras). To deceive (gharra) is to strike one's heedlessness (ghirrah) and attain one's sought desire from him, as if folding a garment upon its original crease (ṭawāhu ʿalā gharrihi).\n  * Al-Raghib (Mufradat): \"Ghurrah is heedlessness in wakefulness, and ghirār is heedlessness with drowsiness.\" Theologically, it is the soul's repose upon a false semblance (shubhah) that pleases the caprice (hawā), rendering one oblivious to the true state of affairs—as in {«mā gharraka bi-rabbika al-karīm»} (What deceived thee concerning thy Generous Lord?).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"A gazelle in a moonlit night is called agharr\" because it ventures out thinking it is day and is devoured by beasts—heedlessness in perception. Metaphorical (majāz): \"A day agharr muḥajjal\" (a white-browed, white-legged day) for intense heat, transferring the blaze of a horse to the day's visible intensity.\n- Root: جهل (J-H-L)\n  * Lisan / Ayn: \"Jahila bihi\" — to be ignorant of it; \"jāhala ʿalā qawmihi\" — to act foolishly/insolently against one's people. The pre-Islamic era is \"al-jāhiliyyah al-jahlā'\" (the utterly ignorant age).\n  * Al-Raghib (Mufradat): Ignorance (jahl) is of three kinds: (1) the soul's emptiness of knowledge (this is the root); (2) believing a thing contrary to what it is; (3) doing a thing contrary to what it ought to be, whether one's belief is sound or corrupt. Ghurūr is a species of the second kind—a false belief arising from a corrupt semblance.\n  * Al-Zamakhshari (Asas): Literal: \"Kafā bil-shakki jahlā\" (Sufficient is doubt as ignorance). Metaphorical: \"Istajhalat al-rīḥ al-ghuṣn\" (The wind made the branch sway violently) — transferred from mental foolishness to physical agitation.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not.\" \"Al-ḥadath: the novel event.\" \"Ḥaddatha: to speak/communicate.\"\n  * Al-Raghib (Mufradat): \"Ḥudūth is the existence of a thing after non-existence, whether accident or substance. Iḥdāth is bringing it into existence. The iḥdāth of substances belongs to God alone.\" The \"ḥadīth\" (report/speech) is so-called for its temporal novelty.\n  * Al-Zamakhshari (Asas): Literal: \"Nazalat bihi ḥawādith al-dahr\" (The vicissitudes of time befell him). Metaphorical: \"Kāna ʿUmar muḥaddathan\" (Umar was one inspired with true discernment) — as if he were spoken to (ḥudditha) by what he conjectured.\n- Root: دنا (D-N-W)\n  * Lisan / Ayn: \"Danā fa-huwa dānin\" — he drew near. \"Al-dunyā\" (the lower world) is so named because it is nearer (danat) and precedes the Hereafter.\n  * Al-Raghib (Mufradat): \"Al-dunūw: proximity by essence or by judgment, used of place, time, and station.\" The \"adnā\" (lower/nearer) is contrasted with the greater and with the better: {«a-tastabdilūna alladhī huwa adnā billadhī huwa khayr»} (Will ye take the lower in exchange for what is better?).\n  * Al-Zamakhshari (Asas): Literal: \"Huwa danī' min al-adniyā'\" (He is base, of the base ones) — but this is the homonym danu'a (baseness), distinct from danā (nearness). The dunyā's \"nearness\" is its temporal immediacy versus the Hereafter's deferral.\n- Sibawayh Rule: Bab al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The particle \"bi\" in {«wa-lā yaghurrannakum billāhi al-gharūr»} governs the deceiver (al-gharūr) as the agent of deception, while \"billāh\" (concerning God) is the object of the deception. The syntactic structure permits the deceiver to be named after the prepositional phrase, indicating that the deception is *about* God's attributes (His forbearance, His respite) — a grammatical subtlety showing the ghurūr deceives *by means of* false notions of God, not that God Himself deceives.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Delusion'", "badge": "Afterlife"}], "79": [{"arabic": "أحدكم من الدعاء ما يعلم من نفسه فإن الله عز وجل أجاب دعاء شر الخلق إبليس لعنه الله إذ قال رب فانظرني إلى يوم يبعثون قال إنك من المنظرين الثامن أن يلح في الدعاء ويكرره ثلاثا قال ابن مسعود كان صلى الله عليه وسلم إذا دعا دعا ثلاثا وإذا سال سأل ثلاثا (1) وينبغي أن لا يستبطىء الإجابة لقوله صلى الله عليه وسلم يستجاب لأحدكم ما لم يعجل فيقول قد دعوت فلم يستجب لي فإذا دعوت فاسأل الله كثيرا فإنك تدعو كريما (2) وقال بعضهم إني أسأل الله عز وجل منذ عشرين سنة حاجة وما أجابني وأنا أرجو الإجابة سألت الله تعالى أن يوفقني لترك ما لا يعنيني وقال", "english": "[Root: دعو]\n  • Lisan al-Arab: \"الدعاء: الرغبة إلى الله تعالى، والابتهال في المسألة. والدعوة: الكلمة التي يدعو بها. وأصل الدعاء: طلب الإقبال من الغير.\"\n  • Al-Raghib (Mufradat): \"الدعاء: ضربان: أحدهما دعاء العبادة، والآخر دعاء المسألة. فدعاء العبادة: هو توجه العبد إلى الله تعالى بالطاعة. ودعاء المسألة: طلب الحاجة من الله تعالى. قال تعالى: {وقال ربكم ادعوني أستجب لكم}.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعا فلان ربه: ابتهل إليه بالسؤال. ودعا الله: عبده. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} أي عن دعائي.\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"دعا عليه: سأل الله أن يصيبه بمكروه. ودعا له: سأل الله أن يحسن إليه. ومن المجاز: دعا الأمر إلى كذا، أي أدى إليه.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 242", "section_title_en": "Section 242", "section_index": 242, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}], "83": [{"arabic": "وإليه الإشارة بقوله تعالى إلا عبادك منهم المخلصين وبقوله تعالى {إن عبادي ليس لك عليهم سلطان} والسماع سبب لصفاء القلب وهو شبكة للحق بواسطة الصفاء وعلى هذا يدل ما روى أن ذا النون المصري رحمه الله دخل بغداد فاجتمع إليه قوم من الصوفية ومعهم قوال فاستأذنوه في أن يقول لهم شيئا فأذن لهم في ذلك فأنشأ يقول صغير هواك عذبني .", "english": "For this reason, he (peace and blessings be upon him) said: \"Beware the discernment of the believer, for he looks with the light of God.\" (2)", "book_title": "Intention, Sincerity and Truthfulness", "section_title_ar": "Section 509", "section_title_en": "The Revival of the Religious Sciences — Section 509: On the Vision of Spiritual Realities Through Purity of Heart", "section_index": 509, "anchors": "- Root: صفا (ṣafā)\n  * Lisan / Ayn: Core meaning of clarity, purity, and transparency — free from turbidity or admixture.\n  * Al-Raghib (Mufradat): Denotes the heart's purification from base attributes, rendering it receptive to divine disclosures (mukāshafāt).\n  * Al-Zamakhshari (Asas): Literal: clarity of water or wine. Metaphorical: purity of the heart as the condition for spiritual perception.\n- Root: مثل (mathala)\n  * Lisan / Ayn: To stand before, to appear, to take shape or form.\n  * Al-Raghib (Mufradat): Used for representation and formation — the appearing of a thing in a form (ṣūrah) that may or may not correspond to its true reality.\n  * Al-Zamakhshari (Asas): Literal: standing erect before someone. Metaphorical: the self-representation of spiritual beings (arwāḥ) in sensible forms perceptible to the purified heart.\n- Root: نظر (naẓar)\n  * Lisan / Ayn: Vision, sight, and also reflection and consideration.\n  * Al-Raghib (Mufradat): Distinguishes between baṣar (physical sight) and baṣīrah (insight); the latter perceives spiritual realities (malakūt).\n  * Al-Zamakhshari (Asas): Literal: seeing with the eye. Metaphorical: \"looking with the light of God\" (al-naẓar bi-nūr Allāh) — perception through divine illumination.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, to seize — the ferāsah (discernment) is so named because it seizes upon the inner reality.\n  * Al-Raghib (Mufradat): The intuitive perception of inner states — a form of inspired knowledge (ʿilm ladunī).\n  * Al-Zamakhshari (Asas): Literal: the lion preying on its quarry. Metaphorical: the believer's discernment that pierces through outward appearances to inward truths.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to confine the activity of devils to hearts filled with blameworthy attributes, and to restrict the vision of the Kingdom of Heaven to purified hearts.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Intention, Sincerity and Truthfulness'", "badge": "Insight"}], "88": [{"arabic": "ولتعلمن نبأه بعد حين وعند ذلك يقولون كما أخبر الله عنهم ربنا أبصرنا وسمعنا فارجعنا نعمل صالحا إنا موقنون أي علمنا أنه كما لا يولد إلا بوقاع ونكاح ولا ينبت زرع إلا بحراثة وبث بذر فكذلك لا يحصل في الآخرة ثواب وأجر إلا بعمل صالح فارجعنا نعمل صالحا فقد علمنا الآن صدقك في قولك وأن ليس للإنسان إلا ما سعى وأن سعيه سوف يرى كلما ألقى فيها فوج سألهم خزنتها ألم يأتكم نذير قالوا بلى قد جاءنا نذير أي ألم نسمعكم سنة الله في عباده وأنه", "english": "I say: God—exalted is He—loves the obedient and hates the disobedient. So just as He does not hate the obedient father because of His hatred for the disobedient son, likewise He does not love the disobedient son because of His love for the obedient father. And if love were to flow from the father to the son, then hatred would likewise be bound to flow. Rather, the truth is: {«ولا تزر وازرة وزر أخرى»} — \"And no bearer of burdens will bear the burden of another\" {Quran 6:164, 17:15, 35:18, 39:7, 53:38}. And whoever supposes that he will be saved by his father's piety is like one who supposes he will be satiated by his father's eating, quenched by his father's drinking, become a scholar by his father's learning, and reach the Ka'bah and see it by his father's walking.", "book_title": "Fear and Hope", "section_title_ar": "Section 889", "section_title_en": "The Reality of Hope (Al-Rajā') and the Futility of Reliance on Another's Piety", "section_index": 889, "anchors": "- Root: و ل د (walada)\n  * Lisan / Ayn: Physical begetting and offspring; the father's generative act.\n  * Al-Raghib (Mufradat): \"الولد: المولود\" — offspring as a created entity; here used metaphorically for spiritual causation.\n  * Al-Zamakhshari (Asas): Literal: physical birth. Metaphorical: \"تولدت العصبية\" — something generated or produced from another; Ghazali exploits this to refute the notion that a father's obedience \"generates\" salvation for the son.\n- Root: ر ج و (rajā)\n  * Lisan / Ayn: Expectation, hope, longing for a favorable outcome.\n  * Al-Raghib (Mufradat): Hope tied to legitimate means; not mere wishful thinking (tamannī).\n  * Al-Zamakhshari (Asas): Literal: awaiting rain. Metaphorical: \"رجوت فلانا\" — to expect from someone; Ghazali contrasts true hope (with action) vs. delusion (ghurūr).\n- Root: غ ر ر (gharara)\n  * Lisan / Ayn: Deception, heedlessness, being lured by a false appearance.\n  * Al-Raghib (Mufradat): The state of one who is duped by Satan's plausible speech.\n  * Al-Zamakhshari (Asas): Literal: a risky venture. Metaphorical: \"اغتر بفلان\" — to be deceived by outward charm while the inner reality is corrupt.\n- Root: ك ي س (kays)\n  * Lisan / Ayn: Intelligence, shrewdness, prudence.\n  * Al-Raghib (Mufradat): The wise man who disciplines his soul and acts for the afterlife.\n  * Al-Zamakhshari (Asas): Literal: alertness. Metaphorical: \"الكيس من دان نفسه\" — the prudent one who holds his soul to account; antonym of \"الأحمق\" (the fool).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يوفى الصابرون أجرهم بغير حساب\" style; Ghazali uses \"إنما\" to restrict reward to personal action, and \"ليس للإنسان إلا ما سعى\" as a restrictive negative clause (nafy + illā) to deny any transfer of merit.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Fear and Hope'", "badge": "Du'a"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 1510], [2, 1510, 4394], [3, 4394, 5287], [4, 5287, 7081]], "2": [[1, 350, 752], [2, 752, 1889], [3, 1889, 3116], [4, 3116, 3619], [5, 3619, 4373], [6, 4373, 5722]], "3": [[1, 400, 838], [2, 838, 2305], [3, 2305, 2743], [4, 2743, 3914], [5, 3914, 4669], [6, 4669, 5369], [7, 5369, 7054], [8, 7054, 8417], [9, 8417, 9205], [10, 9205, 10277]], "4": [[1, 400, 3233], [2, 3233, 3844], [3, 3844, 6027], [4, 6027, 7568], [5, 7568, 9054], [6, 9054, 10526], [7, 10526, 12581], [8, 12581, 13731], [9, 13731, 14803], [10, 14803, 16337]], "5": [[1, 400, 1480], [2, 1480, 3051], [3, 3051, 4352], [4, 4352, 5849], [5, 5849, 6745], [6, 6745, 7761], [7, 7761, 8865], [8, 8865, 10042]], "6": [[1, 400, 1805], [2, 1805, 2809], [3, 2809, 3679], [4, 3679, 4170], [5, 4170, 5419], [6, 5419, 7248], [7, 7248, 8609], [8, 8609, 10237], [9, 10237, 11051], [10, 11051, 11975], [11, 11975, 12979], [12, 12979, 14117]], "7": [[1, 400, 885], [2, 885, 1985], [3, 1985, 2944], [4, 2944, 3410], [5, 3410, 4314], [6, 4314, 5545], [7, 5545, 5955], [8, 5955, 7204], [9, 7204, 8053], [10, 8053, 9023]], "8": [[1, 400, 1710], [2, 1710, 2915], [3, 2915, 4284], [4, 4284, 4808], [5, 4808, 6406], [6, 6406, 6930], [7, 6930, 7428], [8, 7428, 8083], [9, 8083, 8856], [10, 8856, 9760], [11, 9760, 10965], [12, 10965, 11489], [13, 11489, 13009], [14, 13009, 15210], [15, 15210, 16494]], "9": [[1, 350, 781], [2, 781, 1780], [3, 1780, 3457], [4, 3457, 4221], [5, 4221, 4956], [6, 4956, 6132], [7, 6132, 7499]], "10": [[1, 400, 799], [2, 799, 1326], [3, 1326, 2134], [4, 2134, 3627], [5, 3627, 4771], [6, 4771, 5515], [7, 5515, 6786], [8, 6786, 8565], [9, 8565, 9019], [10, 9019, 10146]], "11": [[1, 350, 1018], [2, 1018, 1919], [3, 1919, 3143], [4, 3143, 4345], [5, 4345, 5113], [6, 5113, 6715]], "12": [[1, 400, 1352], [2, 1352, 2386], [3, 2386, 3101], [4, 3101, 3797], [5, 3797, 4822], [6, 4822, 6214], [7, 6214, 6717], [8, 6717, 8187]], "13": [[1, 400, 1725], [2, 1725, 2854], [3, 2854, 3679], [4, 3679, 5147], [5, 5147, 6146], [6, 6146, 7797], [7, 7797, 9362]], "