": "warsh"}, {"surah": 38, "ayah": 3, "text": "كَمَ اَهْلَكْنَا مِن قَبْلِهِم مِّن قَرْنࣲ فَنَادَواْ وَّلَاتَ حِينَ مَنَاصࣲۖ", "words": [{"id": 1, "arabic": "كَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَهْلَكْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلِهِم", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "قَرْنࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَنَادَواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَّلَاتَ", "translit": "", "root": ""}, {"id": 9, "arabic": "حِينَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَنَاصࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 4, "text": "وَعَجِبُوٓاْ أَن جَآءَهُم مُّنذِرࣱ مِّنْهُمْۖ وَقَالَ اَ۬لْكَٰفِرُونَ هَٰذَا سَٰحِرࣱ كَذَّابٌ", "words": [{"id": 1, "arabic": "وَعَجِبُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "", "root": ""}, {"id": 3, "arabic": "جَآءَهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّنذِرࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنْهُمْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْكَٰفِرُونَ", "translit": "", "root": ""}, {"id": 8, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 9, "arabic": "سَٰحِرࣱ", "translit": "", "root": ""}, {"id": 10, "arabic": "كَذَّابٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 5, "text": "اَجَعَلَ اَ۬لَالِهَةَ إِلَٰهاࣰ وَٰحِداً اِنَّ هَٰذَا لَشَےْءٌ عُجَابࣱۖ", "words": [{"id": 1, "arabic": "اَجَعَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَالِهَةَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَٰهاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَٰحِداً", "translit": "", "root": ""}, {"id": 5, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَشَےْءٌ", "translit": "", "root": ""}, {"id": 8, "arabic": "عُجَابࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 6, "text": "وَانطَلَقَ اَ۬لْمَلَأُ مِنْهُمُۥٓ أَنِ اِ۪مْشُواْ وَاصْبِرُواْ عَلَيٰٓ ءَالِهَتِكُمُۥٓ إِنَّ هَٰذَا لَشَےْءࣱ يُرَادُ", "words": [{"id": 1, "arabic": "وَانطَلَقَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمَلَأُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۪مْشُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَاصْبِرُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "ءَالِهَتِكُمُۥٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 11, "arabic": "لَشَےْءࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "يُرَادُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 7, "text": "مَا سَمِعْنَا بِهَٰذَا فِے اِ۬لْمِلَّةِ اِ۬لَاخِرَةِ إِنْ هَٰذَآ إِلَّا اَ۪خْتِلَٰقٌ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "سَمِعْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْمِلَّةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۪خْتِلَٰقٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 8, "text": "اَ۟نزِلَ عَلَيْهِ اِ۬لذِّكْرُ مِنۢ بَيْنِنَاۖ بَلْ هُمْ فِے شَكࣲّ مِّن ذِكْرِے بَل لَّمَّ