": ""}, {"id": 14, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 15, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لنّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 28, "text": "أَمْ نَجْعَلُ اُ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ كَالْمُفْسِدِينَ فِے اِ۬لَارْضِۖ أَمْ نَجْعَلُ اُ۬لْمُتَّقِينَ كَالْفُجّ۪ارِۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَجْعَلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَالْمُفْسِدِينَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لَارْضِۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "نَجْعَلُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْمُتَّقِينَ", "translit": "", "root": ""}, {"id": 13, "arabic": "كَالْفُجّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 29, "text": "كِتَٰبٌ اَنزَلْنَٰهُ إِلَيْكَ مُبَٰرَكࣱ لِّيَدَّبَّرُوٓاْ ءَايَٰتِهِۦ وَلِيَتَذَكَّرَ أُوْلُواْ اُ۬لَالْبَٰبِۖ", "words": [{"id": 1, "arabic": "كِتَٰبٌ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَنزَلْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُبَٰرَكࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِّيَدَّبَّرُوٓاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "ءَايَٰتِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَلِيَتَذَكَّرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "أُوْلُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لَالْبَٰبِۖ", "translit": "", "root": ""}], "na