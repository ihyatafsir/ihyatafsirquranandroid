"root":"حرب"}],"hasIhya":false},{"ayah":22,"text":"إِذْ دَخَلُوا۟ عَلَىٰ دَاوُۥدَ فَفَزِعَ مِنْهُمْۖ قَالُوا۟ لَا تَخَفْۖ خَصْمَانِ بَغَىٰ بَعْضُنَا عَلَىٰ بَعْضٍ فَٱحْكُم بَيْنَنَا بِٱلْحَقِّ وَلَا تُشْطِطْ وَٱهْدِنَآ إِلَىٰ سَوَآءِ ٱلصِّرَٰطِ ","translation":"When they entered upon David and he was alarmed by them? They said, \"Fear not. [We are] two adversaries, one of whom has wronged the other, so judge between us with truth and do not exceed [it] and guide us to the sound path.","words":[{"id":1,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":2,"arabic":"دَخَلُوا۟","translit":"۟āwُlَhkَd","root":"دخل"},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"دَاوُۥدَ","translit":"َdۥُwāَd","root":""},{"id":5,"arabic":"فَفَزِعَ","translit":"َʿعِzَfَf","root":"فزع"},{"id":6,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":7,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":8,"arabic":"لَا","translit":"āَl","root":""},{"id":9,"arabic":"تَخَفْ","translit":"ْfَhkَt","root":"خوف"},{"id":10,"arabic":"خَصْمَانِ","translit":"ِnāَmْṣَhk","root":"خصم"},{"id":11,"arabic":"بَغَىٰ","translit":"ٰàَغَb","root":"بغي"},{"id":12,"arabic":"بَعْضُنَا","translit":"āَnُḍْʿعَb","root":"بعض"},{"id":13,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":14,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":15,"arabic":"فَٱحْكُم","translit":"mُkْḥٱَf","root":"حكم"},{"id":16,"arabic":"بَيْنَنَا","translit":"āَnَnْyَb","root":"بين"},{"id":17,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":18,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":19,"arabic":"تُشْطِطْ","translit":"ْṭِṭْhsُt","root":"شطط"},{"id":20,"arabic":"وَٱهْدِنَآ","translit":"ٓāَnِdْhٱَw","root":"هدي"},{"id":21,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":22,"arabic":"سَوَآءِ","translit":"ِءٓāَwَs","root":"سوي"},{"id":23,"arabic":"ٱلصِّرَٰطِ","translit":"ِṭَٰrِّṣlٱ","root":"صرط"}],"hasIhya":false},{"ayah":23,"text":"إِنَّ هَٰذَآ أَخِى لَهُۥ تِسْعٌ وَتِسْعُونَ نَعْجَةً وَلِىَ نَعْجَةٌ وَٰحِدَةٌ فَقَالَ أَكْفِلْنِيهَا وَعَزَّنِى فِى ٱلْخِطَابِ ","translation":"Indeed this, my brother, has ninety-nine ewes, and I have one ewe; so he said, 'Entrust her to me,' and he overpowered me in speech.\"","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"هَٰذَآ","translit":"ٓāَhdَٰh","root":""},{"id":3,"arabic":"أَخِى","translit":"àِhkَaʾ","root":"اخو"},{"id":4,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":5,"arabic":"تِسْعٌ","translit":"ٌʿعْsِt","root":"تسع"},{"id":6,"arabic":"وَتِسْعُونَ","translit":"َnwُʿعْsِtَw","root":"تسع"},{"id":7,"arabic":"نَعْجَةً","translit":"ًẗَjgْʿعَn","root":"نعج"},{"id":8,"arabic":"وَلِىَ","translit":"َàِlَw","root":""},{"id":9,"arabic":"نَعْجَةٌ","translit":"ٌẗَjgْʿعَn","root":"نعج"},{"id":10,"arabic":"وَٰحِدَةٌ","translit":"ٌẗَdِḥَٰw","root":"وحد"},{"id":11,"arabic":"فَقَالَ","translit":"َlāَqَf","root":"قول"},{"id":12,"arabic":"أَكْفِلْنِيهَا","translit":"āَhyِnْlِfْkَaʾ","root":"كفل"},{"id":13,"arabic":"وَعَزَّنِى","translit":"àِnَّzَʿعَw","root":"عزز"},{"id":14,"arabic":"فِى","translit":"àِf","root":""},{"id":15,"arabic":"ٱلْخِطَابِ","translit":"ِbāَṭِhkْlٱ","root":"خطب"}],"hasIhya":false},{"ayah":24,"text":"قَالَ لَقَدْ ظَلَمَكَ بِسُؤَالِ نَعْجَتِكَ إِلَىٰ نِعَاجِهِۦۖ وَإِنَّ كَثِيرًا مِّنَ ٱلْخُلَطَآءِ لَيَبْغِى بَعْضُهُمْ عَلَىٰ بَعْضٍ إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَقَلِيلٌ مَّا هُمْۗ وَظَنَّ دَاوُۥدُ أَنَّمَا فَتَنَّٰهُ فَٱسْتَغْفَرَ رَبَّهُۥ وَخَرَّ رَاكِعًا وَأَنَابَ۩ ","translation":"[David] said, \"He has certainly wronged you in demanding your ewe [in addition] to his ewes. And indeed, many associates oppress one another, except for those who believe and do righteous deeds - and few are they.\" And David became certain that We had tried him, and he asked forgiveness of his Lord[1] and fell down bowing [in prostration] and turned in repentance [to Allāh].","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":3,"arabic":"ظَلَمَكَ","translit":"َkَmَlَẓ","root":"ظلم"},{"id":4,"arabic":"بِسُؤَالِ","translit":"ِlāَwʾُsِb","root":"سال"},{"id":5,"arabic":"نَعْجَتِكَ","translit":"َkِtَjgْʿعَn","root":"نعج"},{"id":6,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":7,"arabic":"نِعَاجِهِۦ","translit":"ۦِhِjgāَʿعِn","root":"نعج"},{"id":8,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":9,"arabic":"كَثِيرًا","translit":"āًryِhtَk","root":"كثر"},{"id":10,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":11,"arabic":"ٱلْخُلَطَآءِ","translit":"ِءٓāَṭَlُhkْlٱ","root":"خلط"},{"id":12,"arabic":"لَيَبْغِى","translit":"àِغْbَyَl","root":"بغي"},{"id":13,"arabic":"بَعْضُهُمْ","translit":"ْmُhُḍْʿعَb","root":"بعض"},{"id":14,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":15,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":16,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":17,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":18,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":19,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":20,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":21,"arabic":"وَقَلِيلٌ","translit":"ٌlyِlَqَw","root":"قلل"},{"id":22,"arabic":"مَّا","translit":"āَّm","root":""},{"id":23,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":24,"arabic":"وَظَنَّ","translit":"َّnَẓَw","root":"ظنن"},{"id":25,"arabic":"دَاوُۥدُ","translit":"ُdۥُwāَd","root":""},{"id":26,"arabic":"أَنَّمَا","translit":"āَmَّnَaʾ","root":""},{"id":27,"arabic":"فَتَنَّٰهُ","translit":"ُhَّٰnَtَf","root":"فتن"},{"id":28,"arabic":"فَٱسْتَغْفَرَ","translit":"َrَfْغَtْsٱَf","root":"غفر"},{"id":29,"arabic":"رَبَّهُۥ","translit":"ۥُhَّbَr","root":"ربب"},{"id":30,"arabic":"وَخَرَّ","translit":"َّrَhkَw","root":"خرر"},{"id":31,"arabic":"رَاكِعًا","translit":"āًʿعِkāَr","root":"ركع"},{"id":32,"arabic":"وَأَنَابَ","translit":"َbāَnَaʾَw","root":"نوب"}],"hasIhya":false},{"ayah":25,"text":"فَغَفَرْنَا لَهُۥ ذَٰلِكَۖ وَإِنَّ لَهُۥ عِندَنَا لَزُلْفَىٰ وَحُسْنَ مَـَٔابٍ ","translation":"So We forgave him that; and indeed, for him is nearness to Us and a good place of return.","words":[{"id":1,"arabic":"فَغَفَرْنَا","translit":"āَnْrَfَغَf","root":"غفر"},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":4,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":5,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":6,"arabic":"عِندَنَا","translit":"āَnَdnِʿع","root":"عند"},{"id":7,"arabic":"لَزُلْفَىٰ","translit":"ٰàَfْlُzَl","root":"زلف"},{"id":8,"arabic":"وَحُسْنَ","translit":"َnْsُḥَw","root":"حسن"},{"id":9,"arabic":"مَـَٔابٍ","translit":"ٍbāَٔـَm","root":"اوب"}],"hasIhya":false},{"ayah":26,"text":"يَٰدَاوُۥدُ إِنَّا جَعَلْنَٰكَ خَلِيفَةً فِى ٱلْأَرْضِ فَٱحْكُم بَيْنَ ٱلنَّاسِ بِٱلْحَقِّ وَلَا تَتَّبِعِ ٱلْهَوَىٰ فَيُضِلَّكَ عَن سَبِيلِ ٱللَّهِۚ إِنَّ ٱلَّذِينَ يَضِلُّونَ عَن سَبِيلِ ٱللَّهِ لَهُمْ عَذَابٌ شَدِيدٌۢ بِمَا نَسُوا۟ يَوْمَ ٱلْحِسَابِ ","translation":"[We said], \"O David, indeed We have made you a successor upon the earth, so judge between the people in truth and do not follow [your own] desire, as it will lead you astray from the way of Allāh.\" Indeed, those who go astray from the way of Allāh will have a severe punishment for having forgotten the Day of Account.","words":[{"id":1,"arabic":"يَٰدَاوُۥدُ","translit":"ُdۥُwāَdَٰy","root":""},{"id":2,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":3,"arabic":"جَعَلْنَٰكَ","translit":"َkَٰnْlَʿعَjg","root":"جعل"},{"id":4,"arabic":"خَلِيفَةً","translit":"ًẗَfyِlَhk","root":"خلف"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":7,"arabic":"فَٱحْكُم","translit":"mُkْḥٱَf","root":"حكم"},{"id":8,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":9,"arabic":"ٱلنَّ