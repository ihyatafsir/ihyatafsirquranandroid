ُجَابࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 6, "text": "وَانطَلَقَ اَ۬لْمَلَأُ مِنْهُمُۥٓ أَنِ اِ۪مْشُواْ وَاصْبِرُواْ عَلَيٰٓ ءَالِهَتِكُمُۥٓ إِنَّ هَٰذَا لَشَےْءࣱ يُرَادُ", "words": [{"id": 1, "arabic": "وَانطَلَقَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمَلَأُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۪مْشُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَاصْبِرُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "ءَالِهَتِكُمُۥٓ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 11, "arabic": "لَشَےْءࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "يُرَادُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 7, "text": "مَا سَمِعْنَا بِهَٰذَا فِے اِ۬لْمِلَّةِ اِ۬لَاخِرَةِ إِنْ هَٰذَآ إِلَّا اَ۪خْتِلَٰقٌ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "سَمِعْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْمِلَّةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 8, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۪خْتِلَٰقٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 8, "text": "اَ۟نزِلَ عَلَيْهِ اِ۬لذِّكْرُ مِنۢ بَيْنِنَاۖ بَلْ هُمْ فِے شَكࣲّ مِّن ذِكْرِے بَل لَّمَّا يَذُوقُواْ عَذَابِۖ", "words": [{"id": 1, "arabic": "اَ۟نزِلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لذِّكْرُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنِنَاۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "شَكࣲّ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 11, "arabic": "ذِكْرِے", "translit": "", "root": ""}, {"id": 12, "arabic": "بَل", "translit": "", "root": ""}, {"id": 13, "arabic": "لَّمَّا", "translit": "", "root": ""}, {"id": 14, "arabic": "يَذُوقُواْ", "translit": "", "root": ""}, {"id": 15, "arabic": "عَذَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 9, "text": "أَمْ عِندَهُمْ خَزَآئِنُ رَحْمَةِ رَبِّكَ اَ۬لْعَزِيزِ اِ۬لْوَهَّابِۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "خَزَآئِنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَحْمَةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَزِيزِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْوَهَّابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 38, "ayah": 10, "text": "أَمْ لَهُم مُّلْكُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ فَلْيَرْتَقُواْ فِے اِ۬لَاسْبَٰبِۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّلْكُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 7, "arabic": "بَيْنَهُمَاۖ", "translit": "", "root": ""