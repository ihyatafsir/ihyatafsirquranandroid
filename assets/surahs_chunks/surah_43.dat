is blinded from remembrance of the Most Merciful - We appoint for him a devil, and he is to him a companion.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"يَعْشُ","translit":"ُhsْʿعَy","root":"عشو"},{"id":3,"arabic":"عَن","translit":"nَʿع","root":""},{"id":4,"arabic":"ذِكْرِ","translit":"ِrْkِhd","root":"ذكر"},{"id":5,"arabic":"ٱلرَّحْمَٰنِ","translit":"ِnَٰmْḥَّrlٱ","root":"رحم"},{"id":6,"arabic":"نُقَيِّضْ","translit":"ْḍِّyَqُn","root":"قيض"},{"id":7,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":8,"arabic":"شَيْطَٰنًا","translit":"āًnَٰṭْyَhs","root":"شطن"},{"id":9,"arabic":"فَهُوَ","translit":"َwُhَf","root":""},{"id":10,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":11,"arabic":"قَرِينٌ","translit":"ٌnyِrَq","root":"قرن"}],"hasIhya":true},{"ayah":37,"text":"وَإِنَّهُمْ لَيَصُدُّونَهُمْ عَنِ ٱلسَّبِيلِ وَيَحْسَبُونَ أَنَّهُم مُّهْتَدُونَ ","translation":"And indeed, they [i.e., the devils] avert them from the way [of guidance] while they think that they are [rightly] guided","words":[{"id":1,"arabic":"وَإِنَّهُمْ","translit":"ْmُhَّnِiʾَw","root":""},{"id":2,"arabic":"لَيَصُدُّونَهُمْ","translit":"ْmُhَnwُّdُṣَyَl","root":"صدد"},{"id":3,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":4,"arabic":"ٱلسَّبِيلِ","translit":"ِlyِbَّslٱ","root":"سبل"},{"id":5,"arabic":"وَيَحْسَبُونَ","translit":"َnwُbَsْḥَyَw","root":"حسب"},{"id":6,"arabic":"أَنَّهُم","translit":"mُhَّnَaʾ","root":""},{"id":7,"arabic":"مُّهْتَدُونَ","translit":"َnwُdَtْhُّm","root":"هدي"}],"hasIhya":false},{"ayah":38,"text":"حَتَّىٰٓ إِذَا جَآءَنَا قَالَ يَٰلَيْتَ بَيْنِى وَبَيْنَكَ بُعْدَ ٱلْمَشْرِقَيْنِ فَبِئْسَ ٱلْقَرِينُ ","translation":"Until, when he comes to Us [at Judgement], he says [to his companion], \"How I wish there was between me and you the distance between the east and west; and what a wretched companion.\"","words":[{"id":1,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":2,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":3,"arabic":"جَآءَنَا","translit":"āَnَءٓāَjg","root":"جيا"},{"id":4,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":5,"arabic":"يَٰلَيْتَ","translit":"َtْyَlَٰy","root":""},{"id":6,"arabic":"بَيْنِى","translit":"àِnْyَb","root":"بين"},{"id":7,"arabic":"وَبَيْنَكَ","translit":"َkَnْyَbَw","root":"بين"},{"id":8,"arabic":"بُعْدَ","translit":"َdْʿعُb","root":"بعد"},{"id":9,"arabic":"ٱلْمَشْرِقَيْنِ","translit":"ِnْyَqِrْhsَmْlٱ","root":"شرق"},{"id":10,"arabic":"فَبِئْسَ","translit":"َsْyʾِbَf","root":"باس"},{"id":11,"arabic":"ٱلْقَرِينُ","translit":"ُnyِrَqْlٱ","root":"قرن"}],"hasIhya":false},{"ayah":39,"text":"وَلَن يَنفَعَكُمُ ٱلْيَوْمَ إِذ ظَّلَمْتُمْ أَنَّكُمْ فِى ٱلْعَذَابِ مُشْتَرِكُونَ ","translation":"And never will it benefit you that Day, when you have wronged, that you are [all] sharing in the punishment.","words":[{"id":1,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":2,"arabic":"يَنفَعَكُمُ","translit":"ُmُkَʿعَfnَy","root":"نفع"},{"id":3,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":4,"arabic":"إِذ","translit":"hdِiʾ","root":""},{"id":5,"arabic":"ظَّلَمْتُمْ","translit":"ْmُtْmَlَّẓ","root":"ظلم"},{"id":6,"arabic":"أَنَّكُمْ","translit":"ْmُkَّnَaʾ","root":""},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"},{"id":9,"arabic":"مُشْتَرِكُونَ","translit":"َnwُkِrَtْhsُm","root":"شرك"}],"hasIhya":false},{"ayah":40,"text":"أَفَأَنتَ تُسْمِعُ ٱلصُّمَّ أَوْ تَهْدِى ٱلْعُمْىَ وَمَن كَانَ فِى ضَلَٰلٍ مُّبِينٍ ","translation":"Then will you make the deaf hear, [O Muḥammad], or guide the blind or he who is in clear error?","words":[{"id":1,"arabic":"أَفَأَنتَ","translit":"َtnَaʾَfَaʾ","root":""},{"id":2,"arabic":"تُسْمِعُ","translit":"ُʿعِmْsُt","root":"سمع"},{"id":3,"arabic":"ٱلصُّمَّ","translit":"َّmُّṣlٱ","root":"صمم"},{"id":4,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":5,"arabic":"تَهْدِى","translit":"àِdْhَt","root":"هدي"},{"id":6,"arabic":"ٱلْعُمْىَ","translit":"َàْmُʿعْlٱ","root":"عمي"},{"id":7,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":8,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ضَلَٰلٍ","translit":"ٍlَٰlَḍ","root":"ضلل"},{"id":11,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":41,"text":"فَإِمَّا نَذْهَبَنَّ بِكَ فَإِنَّا مِنْهُم مُّنتَقِمُونَ ","translation":"And whether [or not] We take you away [in death], indeed, We will take retribution upon them.","words":[{"id":1,"arabic":"فَإِمَّا","translit":"āَّmِiʾَf","root":""},{"id":2,"arabic":"نَذْهَبَنَّ","translit":"َّnَbَhْhdَn","root":"ذهب"},{"id":3,"arabic":"بِكَ","translit":"َkِb","root":""},{"id":4,"arabic":"فَإِنَّا","translit":"āَّnِiʾَf","root":""},{"id":5,"arabic":"مِنْهُم","translit":"mُhْnِm","root":""},{"id":6,"arabic":"مُّنتَقِمُونَ","translit":"َnwُmِqَtnُّm","root":"نقم"}],"hasIhya":false},{"ayah":42,"text":"أَوْ نُرِيَنَّكَ ٱلَّذِى وَعَدْنَٰهُمْ فَإِنَّا عَلَيْهِم مُّقْتَدِرُونَ ","translation":"Or whether [or not] We show you that which We have promised them, indeed, We are Perfect in Ability.","words":[{"id":1,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":2,"arabic":"نُرِيَنَّكَ","translit":"َkَّnَyِrُn","root":"راي"},{"id":3,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":4,"arabic":"وَعَدْنَٰهُمْ","translit":"ْmُhَٰnْdَʿعَw","root":"وعد"},{"id":5,"arabic":"فَإِنَّا","translit":"āَّnِiʾَf","root":""},{"id":6,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":7,"arabic":"مُّقْتَدِرُونَ","translit":"َnwُrِdَtْqُّm","root":"قدر"}],"hasIhya":false},{"ayah":43,"text":"فَٱسْتَمْسِكْ بِٱلَّذِىٓ أُوحِىَ إِلَيْكَۖ إِنَّكَ عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ","translation":"So adhere to that which is revealed to you. Indeed, you are on a straight path.","words":[{"id":1,"arabic":"فَٱسْتَمْسِكْ","translit":"ْkِsْmَtْsٱَf","root":"مسك"},{"id":2,"arabic":"بِٱلَّذِىٓ","translit":"ٓàِhdَّlٱِb","root":""},{"id":3,"arabic":"أُوحِىَ","translit":"َàِḥwُaʾ","root":"وحي"},{"id":4,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":5,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":6,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":7,"arabic":"صِرَٰطٍ","translit":"ٍṭَٰrِṣ","root":"صرط"},{"id":8,"arabic":"مُّسْتَقِيمٍ","translit":"ٍmyِqَtْsُّm","root":"قوم"}],"hasIhya":false},{"ayah":44,"text":"وَإِنَّهُۥ لَذِكْرٌ لَّكَ وَلِقَوْمِكَۖ وَسَوْفَ تُسْـَٔلُونَ ","translation":"And indeed, it is a remembrance[1] for you and your people, and you [all] are going to be questioned.","words":[{"id":1,"arabic":"وَإِنَّهُۥ","translit":"ۥُhَّnِiʾَw","root":""},{"id":2,"arabic":"لَذِكْرٌ","translit":"ٌrْkِhdَl","root":"ذكر"},{"id":3,"arabic":"لَّكَ","translit":"َkَّl","root":""},{"id":4,"arabic":"وَلِقَوْمِكَ","translit":"َkِmْwَqِlَw","root":"قوم"},{"id":5,"arabic":"وَسَوْفَ","translit":"َfْwَsَw","root":""},{"id":6,"arabic":"تُسْـَٔلُونَ","translit":"َnwُlَٔـْsُt","root":"سال"}],"hasIhya":false},{"ayah":45,"text":"وَسْـَٔلْ مَنْ أَرْسَلْنَا مِن قَبْلِكَ مِن رُّسُلِنَآ أَجَعَلْنَا مِن دُونِ ٱلرَّحْمَٰنِ ءَالِهَةً يُعْبَدُونَ ","translation":"And ask those We sent before you of Our messengers; have We made besides the Most Merciful deities to be worshipped?","words":[{"id":1,"arabic":"وَسْـَٔلْ","translit":"ْlَٔـْsَw","root":"سال"},{"id":2,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":3,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"رُّسُلِنَآ","translit":"ٓāَnِlُsُّr","root":"رسل"},{"id":8,"arabic":"أَجَعَلْنَا","translit":"āَnْlَʿعَjgَaʾ","root":"جعل"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":11,"arabic":"ٱلرَّحْمَٰنِ","translit":"ِnَٰmْḥَّrlٱ","root":"رحم"},{"id":12,"arabic":"ءَالِهَةً","translit":"ًẗَhِlāَء","root":"اله"},{"id":13,"arabic":"يُعْبَدُونَ","translit":"َnwُdَbْʿعُy","root":"عبد"}],"hasIhya":false},{"ayah":46,"text":"وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِـَٔايَٰتِنَآ إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ فَقَالَ إِنِّى رَسُولُ رَبِّ ٱلْعَٰلَمِينَ ","translation":"And certainly did We send Moses with Our signs to Pharaoh and his establishment, and he said, \"Indeed, I am the messenger of the Lord of the worlds.\"","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":4,"arabic":"بِـَٔايَٰتِنَآ","translit":"ٓāَnِtَٰyāَٔـِb","root":"ايي"},{"id":5,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":6,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":7,"arabic":"وَمَلَإِي۟هِۦ","translit":"ۦِh۟yِiʾَlَmَw","root":"ملا"},{"id":8,"arabic":"فَقَالَ","translit":"َlāَqَf","root":"قول"},{"id":9,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":10,"arabic":"رَسُولُ","translit":"ُlwُsَr","root":"رسل"},{"id":11,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":12,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":47,"text":"فَلَمَّا جَآءَهُم بِـَٔايَٰتِنَآ إِذَا هُم مِّنْهَا يَضْحَكُونَ ","translation":"But when he brought them Our signs, at once they laughed at them.","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"جَآءَهُم","translit":"mُhَءٓāَjg","root":"جيا"},{"id":3,"arabic":"بِـَٔايَٰتِنَآ","translit":"ٓāَnِtَٰyāَٔـِb","root":"ايي"},{"id":4,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":5,"arabic":"هُم","translit":"mُh","root":""},{"id":6,"arabic":"مِّنْهَا","translit":"āَhْnِّm","root":""},{"id":7,"arabic":"يَضْحَكُونَ","translit":"َnwُkَḥْḍَy","root":"ضحك"}],"hasIhya":false},{"ayah":48,"text":"وَمَا نُرِيهِم مِّنْ ءَايَةٍ إِلَّا هِىَ أَكْبَرُ مِنْ أُخْتِهَاۖ وَأَخَذْنَٰهُم بِٱلْعَذَابِ لَعَلَّهُمْ يَرْجِعُونَ ","translation":"And We showed them not a sign except that it was greater than its sister, and We seized them with affliction that perhaps they might return [to faith].","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"نُرِيهِم","translit":"mِhyِrُn","root":"راي"},{"id":3,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":4,"arabic":"ءَايَةٍ","translit":"ٍẗَyāَء","root":"ايي"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"هِىَ","translit":"َàِh","root":""},{"id":7,"arabic":"أَكْبَرُ","translit":"ُrَbْkَaʾ","root":"كبر"},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"أُخْتِهَا","translit":"āَhِtْhkُaʾ","root":"اخو"},{"id":10,"arabic":"وَأَخَذْنَٰهُم","translit":"mُhَٰnْhdَhkَaʾَw","root":"اخذ"},{"id":11,"arabic":"بِٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱِb","root":"عذب"},{"id":12,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":13,"arabic":"يَرْجِعُونَ","translit":"َnwُʿعِjgْrَy","root":"رجع"}],"hasIhya":false},{"ayah":49,"text":"وَقَالُوا۟ يَٰٓأَيُّهَ ٱلسَّاحِرُ ٱدْعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَ إِنَّنَا لَمُهْتَدُونَ ","translation":"And they said [to Moses], \"O magician, invoke for us your Lord by what He has promised you. Indeed, we will be guided.\"","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"يَٰٓأَيُّهَ","translit":"َhُّyَaʾَٰٓy","root":"ايي"},{"id":3,"arabic":"ٱلسَّاحِرُ","translit":"ُrِḥāَّslٱ","root":"سحر"},{"id":4,"arabic":"ٱدْعُ","translit":"ُʿعْdٱ","root":"دعو"},{"id":5,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":6,"arabic":"رَبَّكَ","translit":"َkَّbَr","root":"ربب"},{"id":7,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":8,"arabic":"عَهِدَ","translit":"َdِhَʿع","root":"عهد"},{"id":9,"arabic":"عِندَكَ","translit":"َkَdnِʿع","root":"عند"},{"id":10,"arabic":"إِنَّنَا","translit":"āَnَّnِiʾ","root":""},{"id":11,"arabic":"لَمُهْتَدُونَ","translit":"َnwُdَtْhُ