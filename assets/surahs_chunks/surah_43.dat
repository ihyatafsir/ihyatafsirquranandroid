تَخَفَّ قَوْمَهُۥ فَأَطَاعُوهُۚ إِنَّهُمْ كَانُوا۟ قَوْمًا فَٰسِقِينَ ","translation":"So he bluffed his people, and they obeyed him. Indeed, they were [themselves] a people defiantly disobedient [of Allāh].","words":[{"id":1,"arabic":"فَٱسْتَخَفَّ","translit":"َّfَhkَtْsٱَf","root":"خفف"},{"id":2,"arabic":"قَوْمَهُۥ","translit":"ۥُhَmْwَq","root":"قوم"},{"id":3,"arabic":"فَأَطَاعُوهُ","translit":"ُhwُʿعāَṭَaʾَf","root":"طوع"},{"id":4,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":5,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":6,"arabic":"قَوْمًا","translit":"āًmْwَq","root":"قوم"},{"id":7,"arabic":"فَٰسِقِينَ","translit":"َnyِqِsَٰf","root":"فسق"}],"hasIhya":false},{"ayah":55,"text":"فَلَمَّآ ءَاسَفُونَا ٱنتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَٰهُمْ أَجْمَعِينَ ","translation":"And when they angered Us, We took retribution from them and drowned them all.","words":[{"id":1,"arabic":"فَلَمَّآ","translit":"ٓāَّmَlَf","root":""},{"id":2,"arabic":"ءَاسَفُونَا","translit":"āَnwُfَsāَء","root":"اسف"},{"id":3,"arabic":"ٱنتَقَمْنَا","translit":"āَnْmَqَtnٱ","root":"نقم"},{"id":4,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":5,"arabic":"فَأَغْرَقْنَٰهُمْ","translit":"ْmُhَٰnْqَrْغَaʾَf","root":"غرق"},{"id":6,"arabic":"أَجْمَعِينَ","translit":"َnyِʿعَmْjgَaʾ","root":"جمع"}],"hasIhya":false},{"ayah":56,"text":"فَجَعَلْنَٰهُمْ سَلَفًا وَمَثَلًا لِّلْءَاخِرِينَ ","translation":"And We made them a precedent and an example for the later peoples.","words":[{"id":1,"arabic":"فَجَعَلْنَٰهُمْ","translit":"ْmُhَٰnْlَʿعَjgَf","root":"جعل"},{"id":2,"arabic":"سَلَفًا","translit":"āًfَlَs","root":"سلف"},{"id":3,"arabic":"وَمَثَلًا","translit":"āًlَhtَmَw","root":"مثل"},{"id":4,"arabic":"لِّلْءَاخِرِينَ","translit":"َnyِrِhkāَءْlِّl","root":"اخر"}],"hasIhya":false},{"ayah":57,"text":"وَلَمَّا ضُرِبَ ٱبْنُ مَرْيَمَ مَثَلًا إِذَا قَوْمُكَ مِنْهُ يَصِدُّونَ ","translation":"And when the son of Mary was presented as an example,[1] immediately your people laughed aloud.","words":[{"id":1,"arabic":"وَلَمَّا","translit":"āَّmَlَw","root":""},{"id":2,"arabic":"ضُرِبَ","translit":"َbِrُḍ","root":"ضرب"},{"id":3,"arabic":"ٱبْنُ","translit":"ُnْbٱ","root":"بني"},{"id":4,"arabic":"مَرْيَمَ","translit":"َmَyْrَm","root":""},{"id":5,"arabic":"مَثَلًا","translit":"āًlَhtَm","root":"مثل"},{"id":6,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":7,"arabic":"قَوْمُكَ","translit":"َkُmْwَq","root":"قوم"},{"id":8,"arabic":"مِنْهُ","translit":"ُhْnِm","root":""},{"id":9,"arabic":"يَصِدُّونَ","translit":"َnwُّdِṣَy","root":"صدد"}],"hasIhya":false},{"ayah":58,"text":"وَقَالُوٓا۟ ءَأَٰلِهَتُنَا خَيْرٌ أَمْ هُوَۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَلًۢاۚ بَلْ هُمْ قَوْمٌ خَصِمُونَ ","translation":"And they said, \"Are our gods better, or is he?\"[1] They did not present it [i.e., the comparison] except for [mere] argument. But, [in fact], they are a people prone to dispute.","words":[{"id":1,"arabic":"وَقَالُوٓا۟","translit":"۟āٓwُlāَqَw","root":"قول"},{"id":2,"arabic":"ءَأَٰلِهَتُنَا","translit":"āَnُtَhِlَٰaʾَء","root":"اله"},{"id":3,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":4,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":5,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"ضَرَبُوهُ","translit":"ُhwُbَrَḍ","root":"ضرب"},{"id":8,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"جَدَلًۢا","translit":"āًۢlَdَjg","root":"جدل"},{"id":11,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":12,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":13,"arabic":"قَوْمٌ","translit":"ٌmْwَq","root":"قوم"},{"id":14,"arabic":"خَصِمُونَ","translit":"َnwُmِṣَhk","root":"خصم"}],"hasIhya":true},{"ayah":59,"text":"إِنْ هُوَ إِلَّا عَبْدٌ أَنْعَمْنَا عَلَيْهِ وَجَعَلْنَٰهُ مَثَلًا لِّبَنِىٓ إِسْرَٰٓءِيلَ ","translation":"He [i.e., Jesus] was not but a servant upon whom We bestowed favor, and We made him 