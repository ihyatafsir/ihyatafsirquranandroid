ed from that which you worship","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":3,"arabic":"إِبْرَٰهِيمُ","translit":"ُmyِhَٰrْbِiʾ","root":""},{"id":4,"arabic":"لِأَبِيهِ","translit":"ِhyِbَaʾِl","root":"ابو"},{"id":5,"arabic":"وَقَوْمِهِۦٓ","translit":"ٓۦِhِmْwَqَw","root":"قوم"},{"id":6,"arabic":"إِنَّنِى","translit":"àِnَّnِiʾ","root":""},{"id":7,"arabic":"بَرَآءٌ","translit":"ٌءٓāَrَb","root":"برا"},{"id":8,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":9,"arabic":"تَعْبُدُونَ","translit":"َnwُdُbْʿعَt","root":"عبد"}],"hasIhya":false},{"ayah":27,"text":"إِلَّا ٱلَّذِى فَطَرَنِى فَإِنَّهُۥ سَيَهْدِينِ ","translation":"Except for He who created me; and indeed, He will guide me.\"","words":[{"id":1,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"فَطَرَنِى","translit":"àِnَrَṭَf","root":"فطر"},{"id":4,"arabic":"فَإِنَّهُۥ","translit":"ۥُhَّnِiʾَf","root":""},{"id":5,"arabic":"سَيَهْدِينِ","translit":"ِnyِdْhَyَs","root":"هدي"}],"hasIhya":false},{"ayah":28,"text":"وَجَعَلَهَا كَلِمَةًۢ بَاقِيَةً فِى عَقِبِهِۦ لَعَلَّهُمْ يَرْجِعُونَ ","translation":"And he made it[1] a word remaining among his descendants that they might return [to it].","words":[{"id":1,"arabic":"وَجَعَلَهَا","translit":"āَhَlَʿعَjgَw","root":"جعل"},{"id":2,"arabic":"كَلِمَةًۢ","translit":"ًۢẗَmِlَk","root":"كلم"},{"id":3,"arabic":"بَاقِيَةً","translit":"ًẗَyِqāَb","root":"بقي"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"عَقِبِهِۦ","translit":"ۦِhِbِqَʿع","root":"عقب"},{"id":6,"arabic":"لَعَلَّهُمْ","translit":"ْmُhَّlَʿعَl","root":""},{"id":7,"arabic":"يَرْجِعُونَ","translit":"َnwُʿعِjgْrَy","root":"رجع"}],"hasIhya":false},{"ayah":29,"text":"بَلْ مَتَّعْتُ هَٰٓؤُلَآءِ وَءَابَآءَهُمْ حَتَّىٰ جَآءَهُمُ ٱلْحَقُّ وَرَسُولٌ مُّبِينٌ ","translation":"However, I gave enjoyment to these [people of Makkah] and their fathers[1] until there came to them the truth and a clear Messenger.[2]","words":[{"id":1,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":2,"arabic":"مَتَّعْتُ","translit":"ُtْʿعَّtَm","root":"متع"},{"id":3,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":4,"arabic":"وَءَابَآءَهُمْ","translit":"ْmُhَءٓāَbāَءَw","root":"ابو"},{"id":5,"arabic":"حَتَّىٰ","translit":"ٰàَّtَḥ","root":""},{"id":6,"arabic":"جَآءَهُمُ","translit":"ُmُhَءٓāَjg","root":"جيا"},{"id":7,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":8,"arabic":"وَرَسُولٌ","translit":"ٌlwُsَrَw","root":"رسل"},{"id":9,"arabic":"مُّبِينٌ","translit":"ٌnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":30,"text":"وَلَمَّا جَآءَهُمُ ٱلْحَقُّ قَالُوا۟ هَٰذَا سِحْرٌ وَإِنَّا بِهِۦ كَٰفِرُونَ ","translation":"But when the truth came to them, they said, \"This is magic, and indeed we are, concerning it, disbelievers.\"","words":[{"id":1,"arabic":"وَلَمَّا","translit":"āَّmَlَw","root":""},{"id":2,"arabic":"جَآءَهُمُ","translit":"ُmُhَءٓāَjg","root":"جيا"},{"id":3,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":4,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":5,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":6,"arabic":"سِحْرٌ","translit":"ٌrْḥِs","root":"سحر"},{"id":7,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":8,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":9,"arabic":"كَٰفِرُونَ","translit":"َnwُrِfَٰk","root":"كفر"}],"hasIhya":false},{"ayah":31,"text":"وَقَالُوا۟ لَوْلَا نُزِّلَ هَٰذَا ٱلْقُرْءَانُ عَلَىٰ رَجُلٍ مِّنَ ٱلْقَرْيَتَيْنِ عَظِيمٍ ","translation":"And they said, \"Why was this Qur’ān not sent down upon a great man from [one of] the two cities?\"[1]","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"لَوْلَا","translit":"āَlْwَl","root":""},{"id":3,"arabic":"نُزِّلَ","translit":"َlِّzُn","root":"نزل"},{"id":4,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":5,"arabic":"ٱلْقُرْءَانُ","translit":"ُnāَءْrُqْlٱ","root":"قرا"},{"id":6,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":7,"arabic":"رَجُلٍ","translit":"ٍlُjgَr","root":"رجل"},{"id":8,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":9,"arabic":"ٱلْقَرْيَتَيْنِ","translit":"ِnْyَtَyْrَqْlٱ","root":"قري"},{"id":10,"arabic":"عَظِيمٍ","translit":"ٍmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":32,"text":"أَهُمْ يَقْسِمُونَ رَحْمَتَ رَبِّكَۚ نَحْنُ قَسَمْنَا بَيْنَهُم مَّعِيشَتَهُمْ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَاۚ وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْضٍ دَرَجَٰتٍ لِّيَتَّخِذَ بَعْضُهُم بَعْضًا سُخْرِيًّاۗ وَرَحْمَتُ رَبِّكَ خَيْرٌ مِّمَّا يَجْمَعُونَ ","translation":"Do they distribute the mercy of your Lord? It is We who have apportioned among them their livelihood in the life of this world and have raised some of them above others in degrees [of rank] that they may make use of one another for service. But the mercy of your Lord is better than whatever they accumulate.","words":[{"id":1,"arabic":"أَهُمْ","translit":"ْmُhَaʾ","root":""},{"id":2,"arabic":"يَقْسِمُونَ","translit":"َnwُmِsْqَy","root":"قسم"},{"id":3,"arabic":"رَحْمَتَ","translit":"َtَmْḥَr","root":"رحم"},{"id":4,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":5,"arabic":"نَحْنُ","translit":"ُnْḥَn","root":""},{"id":6,"arabic":"قَسَمْنَا","translit":"āَnْmَsَq","root":"قسم"},{"id":7,"arabic":"بَيْنَهُم","translit":"mُhَnْyَb","root":"بين"},{"id":8,"arabic":"مَّعِيشَتَهُمْ","translit":"ْmُhَtَhsyِʿعَّm","root":"عيش"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":11,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":12,"arabic":"وَرَفَعْنَا","translit":"āَnْʿعَfَrَw","root":"رفع"},{"id":13,"arabic":"بَعْضَهُمْ","translit":"ْmُhَḍْʿعَb","root":"بعض"},{"id":14,"arabic":"فَوْقَ","translit":"َqْwَf","root":"فوق"},{"id":15,"arabic":"بَعْضٍ","translit":"ٍḍْʿعَb","root":"بعض"},{"id":16,"arabic":"دَرَجَٰتٍ","translit":"ٍtَٰjgَrَd","root":"درج"},{"id":17,"arabic":"لِّيَتَّخِذَ","translit":"َhdِhkَّtَyِّl","root":"اخذ"},{"id":18,"arabic":"بَعْضُهُم","translit":"mُhُḍْʿعَb","root":"بعض"},{"id":19,"arabic":"بَعْضًا","translit":"āًḍْʿعَb","root":"بعض"},{"id":20,"arabic":"سُخْرِيًّا","translit":"āًّyِrْhkُs","root":"سخر"},{"id":21,"arabic":"وَرَحْمَتُ","translit":"ُtَmْḥَrَw","root":"رحم"},{"id":22,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":23,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":24,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":25,"arabic":"يَجْمَعُونَ","translit":"َnwُʿعَmْjgَy","root":"جمع"}],"hasIhya":true},{"ayah":33,"text":"وَلَوْلَآ أَن يَكُونَ ٱلنَّاسُ أُمَّةً وَٰحِدَةً لَّجَعَلْنَا لِمَن يَكْفُرُ بِٱلرَّحْمَٰنِ لِبُيُوتِهِمْ سُقُفًا مِّن فِضَّةٍ وَمَعَارِجَ عَلَيْهَا يَظْهَرُونَ ","translation":"And if it were not that the people would become one community [of disbelievers],[1] We would have made for those who disbelieve in the Most Merciful - for their houses - ceilings and stairways of silver upon which to mount.","words":[{"id":1,"arabic":"وَلَوْلَآ","translit":"ٓāَlْwَlَw","root":""},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"يَكُونَ","translit":"َnwُkَy","root":"كون"},{"id":4,"arabic":"ٱلنَّاسُ","translit":"ُsāَّnlٱ","root":"انس"},{"id":5,"arabic":"أُمَّةً","translit":"ًẗَّmُaʾ","root":"امم"},{"id":6,"arabic":"وَٰحِدَةً","translit":"ًẗَdِḥَٰw","root":"وحد"},{"id":7,"arabic":"لَّجَعَلْنَا","translit":"āَnْlَʿعَjgَّl","root":"جعل"},{"id":8,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":9,"arabic":"يَكْفُرُ","translit":"ُrُfْkَy","root":"كفر"},{"id":10,"arabic":"بِٱلرَّحْمَٰنِ","translit":"ِnَٰmْḥَّrlٱِb","root":"رحم"},{"id":11,"arabic":"لِبُيُوتِهِمْ","translit":"ْmِhِtwُyُbِl","root":"بيت"},{"id":12,"arabic":"سُقُفًا","translit":"āًfُqُs","root":"سقف"},{"id":13,"arabic":"مِّن","translit":"nِّm","root":""},{"id":14,"arabic":"فِضَّةٍ","translit":"ٍẗَّḍِf","root":"فضض"},