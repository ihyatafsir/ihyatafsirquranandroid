{"surah":43,"verses":[{"ayah":1,"text":"حمٓ ","translation":"Ḥā, Meem.[1]","words":[{"id":1,"arabic":"حمٓ","translit":"ٓmḥ","root":""}],"hasIhya":false},{"ayah":2,"text":"وَٱلْكِتَٰبِ ٱلْمُبِينِ ","translation":"By the clear Book,","words":[{"id":1,"arabic":"وَٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱَw","root":"كتب"},{"id":2,"arabic":"ٱلْمُبِينِ","translit":"ِnyِbُmْlٱ","root":"بين"}],"hasIhya":false},{"ayah":3,"text":"إِنَّا جَعَلْنَٰهُ قُرْءَٰنًا عَرَبِيًّا لَّعَلَّكُمْ تَعْقِلُونَ ","translation":"Indeed, We have made it an Arabic Qur’ān that you might understand.","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"جَعَلْنَٰهُ","translit":"ُhَٰnْlَʿعَjg","root":"جعل"},{"id":3,"arabic":"قُرْءَٰنًا","translit":"āًnَٰءْrُq","root":"قرا"},{"id":4,"arabic":"عَرَبِيًّا","translit":"āًّyِbَrَʿع","root":"عرب"},{"id":5,"arabic":"لَّعَلَّكُمْ","translit":"ْmُkَّlَʿعَّl","root":""},{"id":6,"arabic":"تَعْقِلُونَ","translit":"َnwُlِqْʿعَt","root":"عقل"}],"hasIhya":false},{"ayah":4,"text":"وَإِنَّهُۥ فِىٓ أُمِّ ٱلْكِتَٰبِ لَدَيْنَا لَعَلِىٌّ حَكِيمٌ ","translation":"And indeed it is, in the Mother of the Book[1] with Us, exalted and full of wisdom.[2]","words":[{"id":1,"arabic":"وَإِنَّهُۥ","translit":"ۥُhَّnِiʾَw","root":""},{"id":2,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":3,"arabic":"أُمِّ","translit":"ِّmُaʾ","root":"امم"},{"id":4,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":5,"arabic":"لَدَيْنَا","translit":"āَnْyَdَl","root":""},{"id":6,"arabic":"لَعَلِىٌّ","translit":"ٌّàِlَʿعَl","root":"علو"},{"id":7,"arabic":"حَكِيمٌ","translit":"ٌmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":5,"text":"أَفَنَضْرِبُ عَنكُمُ ٱلذِّكْرَ صَفْحًا أَن كُنتُمْ قَوْمًا مُّسْرِفِينَ ","translation":"Then should We turn the message away, disregarding you, because you are a transgressing people?","words":[{"id":1,"arabic":"أَفَنَضْرِبُ","translit":"ُbِrْḍَnَfَaʾ","root":"ضرب"},{"id":2,"arabic":"عَنكُمُ","translit":"ُmُknَʿع","root":""},{