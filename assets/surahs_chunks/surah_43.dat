{"surah": 43, "verses": [{"ayah": 1, "text": "حمٓ ", "translation": "Ḥā, Meem.[1]", "words": [{"id": 1, "arabic": "حمٓ", "translit": "ٓmḥ", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "وَٱلْكِتَٰبِ ٱلْمُبِينِ ", "translation": "By the clear Book,", "words": [{"id": 1, "arabic": "وَٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱَw", "root": "كتب"}, {"id": 2, "arabic": "ٱلْمُبِينِ", "translit": "ِnyِbُmْlٱ", "root": "بين"}], "hasIhya": false}, {"ayah": 3, "text": "إِنَّا جَعَلْنَٰهُ قُرْءَٰنًا عَرَبِيًّا لَّعَلَّكُمْ تَعْقِلُونَ ", "translation": "Indeed, We have made it an Arabic Qur’ān that you might understand.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "قُرْءَٰنًا", "translit": "āًnَٰءْrُq", "root": "قرا"}, {"id": 4, "arabic": "عَرَبِيًّا", "translit": "āًّyِbَrَʿع", "root": "عرب"}, {"id": 5, "arabic": "لَّعَلَّكُمْ", "translit": "ْmُkَّlَʿعَّl", "root": ""}, {"id": 6, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": false}, {"ayah": 4, "text": "وَإِنَّهُۥ فِىٓ أُمِّ ٱلْكِتَٰبِ لَدَيْنَا لَعَلِىٌّ حَكِيمٌ ", "translation": "And indeed it is, in the Mother of the Book[1] with Us, exalted and full of wisdom.[2]", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 3, "arabic": "أُمِّ", "translit": "ِّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "لَدَيْنَا", "translit": "āَnْyَdَl", "root": ""}, {"id": 6, "arabic": "لَعَلِىٌّ", "translit": "ٌّàِlَʿعَl", "root": "علو"}, {"id": 7, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 5, "text": "أَفَنَضْرِبُ عَنكُمُ ٱلذِّكْرَ صَفْحًا أَن كُنتُمْ قَوْمًا مُّسْرِفِينَ ", "translation": "Then should We turn the message away, disregarding you, because you are a transgressing people?", "words": [{"id": 1, "arabic": "أَفَنَضْرِبُ", "translit": "ُbِrْḍَnَfَaʾ", "root": "ضرب"}, {"id": 2, "arabic": "عَنكُمُ", "translit": "ُmُknَʿع", "root": ""}, {"id": 3, "arabic": "ٱلذِّكْرَ", "translit": "َrْkِّhdlٱ", "root": "ذكر"}, {"id": 4, "arabic": "صَفْحًا", "translit": "āًḥْfَṣ", "root": "صفح"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 8, "arabic": "مُّسْرِفِينَ", "translit": "َnyِfِrْsُّm", "root": "سرف"}], "hasIhya": false}, {"ayah": 6, "text": "وَكَمْ أَرْسَلْنَا مِن نَّبِىٍّ فِى ٱلْأَوَّلِينَ ", "translation": "And how many a prophet We sent among the former peoples,", "words": [{"id": 1, "arabic": "وَكَمْ", "translit": "ْmَkَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "نَّبِىٍّ", "translit": "ٍّàِbَّn", "root": "نبا"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 7, "text": "وَمَا يَأْتِيهِم مِّن نَّبِىٍّ إِلَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ", "translation": "But there would not come to them a prophet except that they used to ridicule him.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يَأْتِيهِم", "translit": "mِhyِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "نَّبِىٍّ", "translit": "ٍّàِbَّn", "root": "نبا"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "يَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَy", "root": "هزا"}], "hasIhya": false}, {"ayah": 8, "text": "فَأَهْلَكْنَآ أَشَدَّ مِنْهُم بَطْشًا وَمَضَىٰ مَثَلُ ٱلْأَوَّلِينَ ", "translation": "And We destroyed greater than them[1] in [striking] power, and the example of the former peoples has preceded.", "words": [{"id": 1, "arabic": "فَأَهْلَكْنَآ", "translit": "ٓāَnْkَlْhَaʾَf", "root": "هلك"}, {"id": 2, "arabic": "أَشَدَّ", "translit": "َّdَhsَaʾ", "root": "شدد"}, {"id": 3, "arabic": "مِنْهُم", "translit": "mُhْnِm", "root": ""}, {"id": 4, "arabic": "بَطْشًا", "translit": "āًhsْṭَb", "root": "بطش"}, {"id": 5, "arabic": "وَمَضَىٰ", "translit": "ٰàَḍَmَw", "root": "مضي"}, {"id": 6, "arabic": "مَثَلُ", "translit": "ُlَhtَm", "root": "مثل"}, {"id": 7, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}], "hasIhya": false}, {"ayah": 9, "text": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ خَلَقَهُنَّ ٱلْعَزِيزُ ٱلْعَلِيمُ ", "translation": "And if you should ask them, \"Who has created the heavens and the earth?\" they would surely say, \"They were created by the Exalted in Might, the Knowing,\"", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 2, "arabic": "سَأَلْتَهُم", "translit": "mُhَtْlَaʾَs", "root": "سال"}, {"id": 3, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 4, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "لَيَقُولُنَّ", "translit": "َّnُlwُqَyَl", "root": "قول"}, {"id": 8, "arabic": "خَلَقَهُنَّ", "translit": "َّnُhَqَlَhk", "root": "خلق"}, {"id": 9, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 10, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 10, "text": "ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ مَهْدًا وَجَعَلَ لَكُمْ فِيهَا سُبُلًا لَّعَلَّكُمْ تَهْتَدُونَ ", "translation": "[The one] who has made for you the earth a bed and made for you upon it roads that you might be guided", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "مَهْدًا", "translit": "āًdْhَm", "root": "مهد"}, {"id": 6, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "سُبُلًا", "translit": "āًlُbُs", "root": "سبل"}, {"id": 10, "arabic": "لَّعَلَّكُمْ", "translit": "ْmُkَّlَʿعَّl", "root": ""}, {"id": 11, "arabic": "تَهْتَدُونَ", "translit": "َnwُdَtْhَt", "root": "هدي"}], "hasIhya": false}, {"ayah": 11, "text": "وَٱلَّذِى نَزَّلَ مِنَ ٱلسَّمَآءِ مَآءًۢ بِقَدَرٍ فَأَنشَرْنَا بِهِۦ بَلْدَةً مَّيْتًاۚ كَذَٰلِكَ تُخْرَجُونَ ", "translation": "And who sends down rain from the sky in measured amounts, and We revive thereby a dead land - thus will you be brought forth -", "words": [{"id": 1, "arabic": "وَٱلَّذِى", "translit": "àِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "مَآءًۢ", "translit": "ًۢءٓāَm", "root": "موه"}, {"id": 6, "arabic": "بِقَدَرٍ", "translit": "ٍrَdَqِb", "root": "قدر"}, {"id": 7, "arabic": "فَأَنشَرْنَا", "translit": "āَnْrَhsnَaʾَf", "root": "نشر"}, {"id": 8, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 9, "arabic": "بَلْدَةً", "translit": "ًẗَdْlَb", "root": "بلد"}, {"id": 10, "arabic": "مَّيْتًا", "translit": "āًtْyَّm", "root": "موت"}, {"id": 11, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 12, "arabic": "تُخْرَجُونَ", "translit": "َnwُjgَrْhkُt", "root": "خرج"}], "hasIhya": false}, {"ayah": 12, "text": "وَٱلَّذِى خَلَقَ ٱلْأَزْوَٰجَ كُلَّهَا وَجَعَلَ لَكُم مِّنَ ٱلْفُلْكِ وَٱلْأَنْعَٰمِ مَا تَرْكَبُونَ ", "translation": "And who created the species, all of them, and has made for you of ships and animals those which you mount", "words": [{"id": 1, "arabic": "وَٱلَّذِى", "translit": "àِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلْأَزْوَٰجَ", "translit": "َjgَٰwْzَaʾْlٱ", "root": "زوج"}, {"id": 4, "arabic": "كُلَّهَا", "translit": "āَhَّlُk", "root": "كلل"}, {"id": 5, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْفُلْكِ", "translit": "ِkْlُfْlٱ", "root": "فلك"}, {"id": 9, "arabic": "وَٱلْأَنْعَٰمِ", "translit": "ِmَٰʿعْnَaʾْlٱَw", "root": "نعم"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "تَرْكَبُونَ", "translit": "َnwُbَkْrَt", "root": "ركب"}], "hasIhya": false}, {"ayah": 13, "text": "لِتَسْتَوُۥا۟ عَلَىٰ ظُهُورِهِۦ ثُمَّ تَذْكُرُوا۟ نِعْمَةَ رَبِّكُمْ إِذَا ٱسْتَوَيْتُمْ عَلَيْهِ وَتَقُولُوا۟ سُبْحَٰنَ ٱلَّذِى سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُۥ مُقْرِنِينَ ", "translation": "That you may settle yourselves upon their backs and then remember the favor of your Lord when you have settled upon them and say, \"Exalted is He who has subjected this to us, and we could not have [otherwise] subdued it.[1]", "words": [{"id": 1, "arabic": "لِتَسْتَوُۥا۟", "translit": "۟āۥُwَtْsَtِl", "root": "سوي"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "ظُهُورِهِۦ", "translit": "ۦِhِrwُhُẓ", "root": "ظهر"}, {"id": 4, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 5, "arabic": "تَذْكُرُوا۟", "translit": "۟āwُrُkْhdَt", "root": "ذكر"}, {"id": 6, "arabic": "نِعْمَةَ", "translit": "َẗَmْʿعِn", "root": "نعم"}, {"id": 7, "arabic": "رَبِّكُمْ", "translit": "ْmُkِّbَr", "root": "ربب"}, {"id": 8, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 9, "arabic": "ٱسْتَوَيْتُمْ", "translit": "ْmُtْyَwَtْsٱ", "root": "سوي"}, {"id": 10, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "وَتَقُولُوا۟", "translit": "۟āwُlwُqَtَw", "root": "قول"}, {"id": 12, "arabic": "سُبْحَٰنَ", "translit": "َnَٰḥْbُs", "root": "سبح"}, {"id": 13, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "سَخَّرَ", "translit": "َrَّhkَs", "root": "سخر"}, {"id": 15, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 16, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 17, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 18, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 19, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 20, "arabic": "مُقْرِنِينَ", "translit": "َnyِnِrْqُm", "root": "قرن"}], "hasIhya": true}, {"ayah": 14, "text": "وَإِنَّآ إِلَىٰ رَبِّنَا لَمُنقَلِبُونَ ", "translation": "And indeed we, to our Lord, will [surely] return.\"", "words": [{"id": 1, "arabic": "وَإِنَّآ", "translit": "ٓāَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "رَبِّنَا", "translit": "āَnِّbَr", "root": "ربب"}, {"id": 4, "arabic": "لَمُنقَلِبُونَ", "translit": "َnwُbِlَqnُmَl", "root": "قلب"}], "hasIhya": true}, {"ayah": 15, "text": "وَجَعَلُوا۟ لَهُۥ مِنْ عِبَادِهِۦ جُزْءًاۚ إِنَّ ٱلْإِنسَٰنَ لَكَفُورٌ مُّبِينٌ ", "translation": "But they have attributed to Him from His servants a portion.[1] Indeed, man is clearly ungrateful.", "words": [{"id": 1, "arabic": "وَجَعَلُوا۟", "translit": "۟āwُlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 5, "arabic": "جُزْءًا", "translit": "āًءْzُjg", "root": "جزا"}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 8, "arabic": "لَكَفُورٌ", "translit": "ٌrwُfَkَl", "root": "كفر"}, {"id": 9, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 16, "text": "أَمِ ٱتَّخَذَ مِمَّا يَخْلُقُ بَنَاتٍ وَأَصْفَىٰكُم بِٱلْبَنِينَ ", "translation": "Or has He taken, out of what He has created, daughters and chosen you for [having] sons?", "words": [{"id": 1, "arabic": "أَمِ", "translit": "ِmَaʾ", "root": ""}, {"id": 2, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 4, "arabic": "يَخْلُقُ", "translit": "ُqُlْhkَy", "root": "خلق"}, {"id": 5, "arabic": "بَنَاتٍ", "translit": "ٍtāَnَb", "root": "بني"}, {"id": 6, "arabic": "وَأَصْفَىٰكُم", "translit": "mُkٰàَfْṣَaʾَw", "root": "صفو"}, {"id": 7, "arabic": "بِٱلْبَنِينَ", "translit": "َnyِnَbْlٱِb", "root": "بني"}], "hasIhya": false}, {"ayah": 17, "text": "وَإِذَا بُشِّرَ أَحَدُهُم بِمَا ضَرَبَ لِلرَّحْمَٰنِ مَثَلًا ظَلَّ وَجْهُهُۥ مُسْوَدًّا وَهُوَ كَظِيمٌ ", "translation": "And when one of them is given good tidings of that which he attributes to the Most Merciful in comparison [i.e., a daughter], his face becomes dark, and he suppresses grief.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "بُشِّرَ", "translit": "َrِّhsُb", "root": "بشر"}, {"id": 3, "arabic": "أَحَدُهُم", "translit": "mُhُdَḥَaʾ", "root": "احد"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "ضَرَبَ", "translit": "َbَrَḍ", "root": "ضرب"}, {"id": 6, "arabic": "لِلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlِl", "root": "رحم"}, {"id": 7, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 8, "arabic": "ظَلَّ", "translit": "َّlَẓ", "root": "ظلل"}, {"id": 9, "arabic": "وَجْهُهُۥ", "translit": "ۥُhُhْjgَw", "root": "وجه"}, {"id": 10, "arabic": "مُسْوَدًّا", "translit": "āًّdَwْsُm", "root": "سود"}, {"id": 11, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 12, "arabic": "كَظِيمٌ", "translit": "ٌmyِẓَk", "root": "كظم"}], "hasIhya": false}, {"ayah": 18, "text": "أَوَمَن يُنَشَّؤُا۟ فِى ٱلْحِلْيَةِ وَهُوَ فِى ٱلْخِصَامِ غَيْرُ مُبِينٍ ", "translation": "So is one brought up in ornaments while being during conflict unevident[1] [attributed to Allāh]?", "words": [{"id": 1, "arabic": "أَوَمَن", "translit": "nَmَwَaʾ", "root": ""}, {"id": 2, "arabic": "يُنَشَّؤُا۟", "translit": "۟āُwʾَّhsَnُy", "root": "نشا"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْحِلْيَةِ", "translit": "ِẗَyْlِḥْlٱ", "root": "حلي"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْخِصَامِ", "translit": "ِmāَṣِhkْlٱ", "root": "خصم"}, {"id": 8, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 9, "arabic": "مُبِينٍ", "translit": "ٍnyِbُm", "root": "بين"}], "hasIhya": false}, {"ayah": 19, "text": "وَجَعَلُوا۟ ٱلْمَلَٰٓئِكَةَ ٱلَّذِينَ هُمْ عِبَٰدُ ٱلرَّحْمَٰنِ إِنَٰثًاۚ أَشَهِدُوا۟ خَلْقَهُمْۚ سَتُكْتَبُ شَهَٰدَتُهُمْ وَيُسْـَٔلُونَ ", "translation": "And they described the angels, who are servants of the Most Merciful, as females. Did they witness their creation? Their testimony will be recorded, and they will be questioned.", "words": [{"id": 1, "arabic": "وَجَعَلُوا۟", "translit": "۟āwُlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "ٱلْمَلَٰٓئِكَةَ", "translit": "َẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 5, "arabic": "عِبَٰدُ", "translit": "ُdَٰbِʿع", "root": "عبد"}, {"id": 6, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 7, "arabic": "إِنَٰثًا", "translit": "āًhtَٰnِiʾ", "root": "انث"}, {"id": 8, "arabic": "أَشَهِدُوا۟", "translit": "۟āwُdِhَhsَaʾ", "root": "شهد"}, {"id": 9, "arabic": "خَلْقَهُمْ", "translit": "ْmُhَqْlَhk", "root": "خلق"}, {"id": 10, "arabic": "سَتُكْتَبُ", "translit": "ُbَtْkُtَs", "root": "كتب"}, {"id": 11, "arabic": "شَهَٰدَتُهُمْ", "translit": "ْmُhُtَdَٰhَhs", "root": "شهد"}, {"id": 12, "arabic": "وَيُسْـَٔلُونَ", "translit": "َnwُlَٔـْsُyَw", "root": "سال"}], "hasIhya": false}, {"ayah": 20, "text": "وَقَالُوا۟ لَوْ شَآءَ ٱلرَّحْمَٰنُ مَا عَبَدْنَٰهُمۗ مَّا لَهُم بِذَٰلِكَ مِنْ عِلْمٍۖ إِنْ هُمْ إِلَّا يَخْرُصُونَ ", "translation": "And they said, \"If the Most Merciful had willed, we would not have worshipped them.\" They have of that no knowledge. They are not but misjudging.", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 3, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 4, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "عَبَدْنَٰهُم", "translit": "mُhَٰnْdَbَʿع", "root": "عبد"}, {"id": 7, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 8, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 9, "arabic": "بِذَٰلِكَ", "translit": "َkِlَٰhdِb", "root": ""}, {"id": 10, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 11, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 12, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 13, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "يَخْرُصُونَ", "translit": "َnwُṣُrْhkَy", "root": "خرص"}], "hasIhya": false}, {"ayah": 21, "text": "أَمْ ءَاتَيْنَٰهُمْ كِتَٰبًا مِّن قَبْلِهِۦ فَهُم بِهِۦ مُسْتَمْسِكُونَ ", "translation": "Or have We given them a book before it [i.e., the Qur’ān] to which they are adhering?", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَٰهُمْ", "translit": "ْmُhَٰnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "كِتَٰبًا", "translit": "āًbَٰtِk", "root": "كتب"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "قَبْلِهِۦ", "translit": "ۦِhِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فَهُم", "translit": "mُhَf", "root": ""}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "مُسْتَمْسِكُونَ", "translit": "َnwُkِsْmَtْsُm", "root": "مسك"}], "hasIhya": false}, {"ayah": 22, "text": "بَلْ قَالُوٓا۟ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٍ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّهْتَدُونَ ", "translation": "Rather, they say, \"Indeed, we found our fathers upon a religion, and we are in their footsteps [rightly] guided.\"", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 3, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 4, "arabic": "وَجَدْنَآ", "translit": "ٓāَnْdَjgَw", "root": "وجد"}, {"id": 5, "arabic": "ءَابَآءَنَا", "translit": "āَnَءٓāَbāَء", "root": "ابو"}, {"id": 6, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 7, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 8, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 9, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 10, "arabic": "ءَاثَٰرِهِم", "translit": "mِhِrَٰhtāَء", "root": "اثر"}, {"id": 11, "arabic": "مُّهْتَدُونَ", "translit": "َnwُdَtْhُّm", "root": "هدي"}], "hasIhya": true}, {"ayah": 23, "text": "وَكَذَٰلِكَ مَآ أَرْسَلْنَا مِن قَبْلِكَ فِى قَرْيَةٍ مِّن نَّذِيرٍ إِلَّا قَالَ مُتْرَفُوهَآ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٍ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّقْتَدُونَ ", "translation": "And similarly, We did not send before you any warner into a city except that its affluent said, \"Indeed, we found our fathers upon a religion, and we are, in their footsteps, following.\"", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 8, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 9, "arabic": "نَّذِيرٍ", "translit": "ٍryِhdَّn", "root": "نذر"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 12, "arabic": "مُتْرَفُوهَآ", "translit": "ٓāَhwُfَrْtُm", "root": "ترف"}, {"id": 13, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 14, "arabic": "وَجَدْنَآ", "translit": "ٓāَnْdَjgَw", "root": "وجد"}, {"id": 15, "arabic": "ءَابَآءَنَا", "translit": "āَnَءٓāَbāَء", "root": "ابو"}, {"id": 16, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 17, "arabic": "أُمَّةٍ", "translit": "ٍẗَّmُaʾ", "root": "امم"}, {"id": 18, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 19, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 20, "arabic": "ءَاثَٰرِهِم", "translit": "mِhِrَٰhtāَء", "root": "اثر"}, {"id": 21, "arabic": "مُّقْتَدُونَ", "translit": "َnwُdَtْqُّm", "root": "قدو"}], "hasIhya": true}, {"ayah": 24, "text": "قَٰلَ أَوَلَوْ جِئْتُكُم بِأَهْدَىٰ مِمَّا وَجَدتُّمْ عَلَيْهِ ءَابَآءَكُمْۖ قَالُوٓا۟ إِنَّا بِمَآ أُرْسِلْتُم بِهِۦ كَٰفِرُونَ ", "translation": "[Each warner] said, \"Even if I brought you better guidance than that [religion] upon which you found your fathers?\" They said, \"Indeed we, in that with which you were sent, are disbelievers.\"", "words": [{"id": 1, "arabic": "قَٰلَ", "translit": "َlَٰq", "root": "قول"}, {"id": 2, "arabic": "أَوَلَوْ", "translit": "ْwَlَwَaʾ", "root": ""}, {"id": 3, "arabic": "جِئْتُكُم", "translit": "mُkُtْyʾِjg", "root": "جيا"}, {"id": 4, "arabic": "بِأَهْدَىٰ", "translit": "ٰàَdْhَaʾِb", "root": "هدي"}, {"id": 5, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 6, "arabic": "وَجَدتُّمْ", "translit": "ْmُّtdَjgَw", "root": "وجد"}, {"id": 7, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "ءَابَآءَكُمْ", "translit": "ْmُkَءٓāَbāَء", "root": "ابو"}, {"id": 9, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 10, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 11, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 12, "arabic": "أُرْسِلْتُم", "translit": "mُtْlِsْrُaʾ", "root": "رسل"}, {"id": 13, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 14, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 25, "text": "فَٱنتَقَمْنَا مِنْهُمْۖ فَٱنظُرْ كَيْفَ كَانَ عَٰقِبَةُ ٱلْمُكَذِّبِينَ ", "translation": "So We took retribution from them; then see how was the end of the deniers.", "words": [{"id": 1, "arabic": "فَٱنتَقَمْنَا", "translit": "āَnْmَqَtnٱَf", "root": "نقم"}, {"id": 2, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 3, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 4, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 5, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 6, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 7, "arabic": "ٱلْمُكَذِّبِينَ", "translit": "َnyِbِّhdَkُmْlٱ", "root": "كذب"}], "hasIhya": false}, {"ayah": 26, "text": "وَإِذْ قَالَ إِبْرَٰهِيمُ لِأَبِيهِ وَقَوْمِهِۦٓ إِنَّنِى بَرَآءٌ مِّمَّا تَعْبُدُونَ ", "translation": "And [mention, O Muḥammad], when Abraham said to his father and his people, \"Indeed, I am disassociated from that which you worship", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "إِبْرَٰهِيمُ", "translit": "ُmyِhَٰrْbِiʾ", "root": ""}, {"id": 4, "arabic": "لِأَبِيهِ", "translit": "ِhyِbَaʾِl", "root": "ابو"}, {"id": 5, "arabic": "وَقَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَqَw", "root": "قوم"}, {"id": 6, "arabic": "إِنَّنِى", "translit": "àِnَّnِiʾ", "root": ""}, {"id": 7, "arabic": "بَرَآءٌ", "translit": "ٌءٓāَrَb", "root": "برا"}, {"id": 8, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 9, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}], "hasIhya": false}, {"ayah": 27, "text": "إِلَّا ٱلَّذِى فَطَرَنِى فَإِنَّهُۥ سَيَهْدِينِ ", "translation": "Except for He who created me; and indeed, He will guide me.\"", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فَطَرَنِى", "translit": "àِnَrَṭَf", "root": "فطر"}, {"id": 4, "arabic": "فَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَf", "root": ""}, {"id": 5, "arabic": "سَيَهْدِينِ", "translit": "ِnyِdْhَyَs", "root": "هدي"}], "hasIhya": false}, {"ayah": 28, "text": "وَجَعَلَهَا كَلِمَةًۢ بَاقِيَةً فِى عَقِبِهِۦ لَعَلَّهُمْ يَرْجِعُونَ ", "translation": "And he made it[1] a word remaining among his descendants that they might return [to it].", "words": [{"id": 1, "arabic": "وَجَعَلَهَا", "translit": "āَhَlَʿعَjgَw", "root": "جعل"}, {"id": 2, "arabic": "كَلِمَةًۢ", "translit": "ًۢẗَmِlَk", "root": "كلم"}, {"id": 3, "arabic": "بَاقِيَةً", "translit": "ًẗَyِqāَb", "root": "بقي"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "عَقِبِهِۦ", "translit": "ۦِhِbِqَʿع", "root": "عقب"}, {"id": 6, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 7, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 29, "text": "بَلْ مَتَّعْتُ هَٰٓؤُلَآءِ وَءَابَآءَهُمْ حَتَّىٰ جَآءَهُمُ ٱلْحَقُّ وَرَسُولٌ مُّبِينٌ ", "translation": "However, I gave enjoyment to these [people of Makkah] and their fathers[1] until there came to them the truth and a clear Messenger.[2]", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 2, "arabic": "مَتَّعْتُ", "translit": "ُtْʿعَّtَm", "root": "متع"}, {"id": 3, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 4, "arabic": "وَءَابَآءَهُمْ", "translit": "ْmُhَءٓāَbāَءَw", "root": "ابو"}, {"id": 5, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 6, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 7, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 8, "arabic": "وَرَسُولٌ", "translit": "ٌlwُsَrَw", "root": "رسل"}, {"id": 9, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 30, "text": "وَلَمَّا جَآءَهُمُ ٱلْحَقُّ قَالُوا۟ هَٰذَا سِحْرٌ وَإِنَّا بِهِۦ كَٰفِرُونَ ", "translation": "But when the truth came to them, they said, \"This is magic, and indeed we are, concerning it, disbelievers.\"", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 4, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 5, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 6, "arabic": "سِحْرٌ", "translit": "ٌrْḥِs", "root": "سحر"}, {"id": 7, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 8, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 9, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 31, "text": "وَقَالُوا۟ لَوْلَا نُزِّلَ هَٰذَا ٱلْقُرْءَانُ عَلَىٰ رَجُلٍ مِّنَ ٱلْقَرْيَتَيْنِ عَظِيمٍ ", "translation": "And they said, \"Why was this Qur’ān not sent down upon a great man from [one of] the two cities?\"[1]", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 3, "arabic": "نُزِّلَ", "translit": "َlِّzُn", "root": "نزل"}, {"id": 4, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 5, "arabic": "ٱلْقُرْءَانُ", "translit": "ُnāَءْrُqْlٱ", "root": "قرا"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "رَجُلٍ", "translit": "ٍlُjgَr", "root": "رجل"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلْقَرْيَتَيْنِ", "translit": "ِnْyَtَyْrَqْlٱ", "root": "قري"}, {"id": 10, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 32, "text": "أَهُمْ يَقْسِمُونَ رَحْمَتَ رَبِّكَۚ نَحْنُ قَسَمْنَا بَيْنَهُم مَّعِيشَتَهُمْ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَاۚ وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْضٍ دَرَجَٰتٍ لِّيَتَّخِذَ بَعْضُهُم بَعْضًا سُخْرِيًّاۗ وَرَحْمَتُ رَبِّكَ خَيْرٌ مِّمَّا يَجْمَعُونَ ", "translation": "Do they distribute the mercy of your Lord? It is We who have apportioned among them their livelihood in the life of this world and have raised some of them above others in degrees [of rank] that they may make use of one another for service. But the mercy of your Lord is better than whatever they accumulate.", "words": [{"id": 1, "arabic": "أَهُمْ", "translit": "ْmُhَaʾ", "root": ""}, {"id": 2, "arabic": "يَقْسِمُونَ", "translit": "َnwُmِsْqَy", "root": "قسم"}, {"id": 3, "arabic": "رَحْمَتَ", "translit": "َtَmْḥَr", "root": "رحم"}, {"id": 4, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 5, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 6, "arabic": "قَسَمْنَا", "translit": "āَnْmَsَq", "root": "قسم"}, {"id": 7, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 8, "arabic": "مَّعِيشَتَهُمْ", "translit": "ْmُhَtَhsyِʿعَّm", "root": "عيش"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 11, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 12, "arabic": "وَرَفَعْنَا", "translit": "āَnْʿعَfَrَw", "root": "رفع"}, {"id": 13, "arabic": "بَعْضَهُمْ", "translit": "ْmُhَḍْʿعَb", "root": "بعض"}, {"id": 14, "arabic": "فَوْقَ", "translit": "َqْwَf", "root": "فوق"}, {"id": 15, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 16, "arabic": "دَرَجَٰتٍ", "translit": "ٍtَٰjgَrَd", "root": "درج"}, {"id": 17, "arabic": "لِّيَتَّخِذَ", "translit": "َhdِhkَّtَyِّl", "root": "اخذ"}, {"id": 18, "arabic": "بَعْضُهُم", "translit": "mُhُḍْʿعَb", "root": "بعض"}, {"id": 19, "arabic": "بَعْضًا", "translit": "āًḍْʿعَb", "root": "بعض"}, {"id": 20, "arabic": "سُخْرِيًّا", "translit": "āًّyِrْhkُs", "root": "سخر"}, {"id": 21, "arabic": "وَرَحْمَتُ", "translit": "ُtَmْḥَrَw", "root": "رحم"}, {"id": 22, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 23, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 24, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 25, "arabic": "يَجْمَعُونَ", "translit": "َnwُʿعَmْjgَy", "root": "جمع"}], "hasIhya": true}, {"ayah": 33, "text": "وَلَوْلَآ أَن يَكُونَ ٱلنَّاسُ أُمَّةً وَٰحِدَةً لَّجَعَلْنَا لِمَن يَكْفُرُ بِٱلرَّحْمَٰنِ لِبُيُوتِهِمْ سُقُفًا مِّن فِضَّةٍ وَمَعَارِجَ عَلَيْهَا يَظْهَرُونَ ", "translation": "And if it were not that the people would become one community [of disbelievers],[1] We would have made for those who disbelieve in the Most Merciful - for their houses - ceilings and stairways of silver upon which to mount.", "words": [{"id": 1, "arabic": "وَلَوْلَآ", "translit": "ٓāَlْwَlَw", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 4, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 6, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 7, "arabic": "لَّجَعَلْنَا", "translit": "āَnْlَʿعَjgَّl", "root": "جعل"}, {"id": 8, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 9, "arabic": "يَكْفُرُ", "translit": "ُrُfْkَy", "root": "كفر"}, {"id": 10, "arabic": "بِٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱِb", "root": "رحم"}, {"id": 11, "arabic": "لِبُيُوتِهِمْ", "translit": "ْmِhِtwُyُbِl", "root": "بيت"}, {"id": 12, "arabic": "سُقُفًا", "translit": "āًfُqُs", "root": "سقف"}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "فِضَّةٍ", "translit": "ٍẗَّḍِf", "root": "فضض"}, {"id": 15, "arabic": "وَمَعَارِجَ", "translit": "َjgِrāَʿعَmَw", "root": "عرج"}, {"id": 16, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 17, "arabic": "يَظْهَرُونَ", "translit": "َnwُrَhْẓَy", "root": "ظهر"}], "hasIhya": false}, {"ayah": 34, "text": "وَلِبُيُوتِهِمْ أَبْوَٰبًا وَسُرُرًا عَلَيْهَا يَتَّكِـُٔونَ ", "translation": "And for their houses - doors and couches [of silver] upon which to recline", "words": [{"id": 1, "arabic": "وَلِبُيُوتِهِمْ", "translit": "ْmِhِtwُyُbِlَw", "root": "بيت"}, {"id": 2, "arabic": "أَبْوَٰبًا", "translit": "āًbَٰwْbَaʾ", "root": "بوب"}, {"id": 3, "arabic": "وَسُرُرًا", "translit": "āًrُrُsَw", "root": "سرر"}, {"id": 4, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "يَتَّكِـُٔونَ", "translit": "َnwُٔـِkَّtَy", "root": "وكا"}], "hasIhya": false}, {"ayah": 35, "text": "وَزُخْرُفًاۚ وَإِن كُلُّ ذَٰلِكَ لَمَّا مَتَٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَاۚ وَٱلْءَاخِرَةُ عِندَ رَبِّكَ لِلْمُتَّقِينَ ", "translation": "And gold ornament. But all that is not but the enjoyment of worldly life. And the Hereafter with your Lord is for the righteous.", "words": [{"id": 1, "arabic": "وَزُخْرُفًا", "translit": "āًfُrْhkُzَw", "root": "زخرف"}, {"id": 2, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 3, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 4, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 5, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 6, "arabic": "مَتَٰعُ", "translit": "ُʿعَٰtَm", "root": "متع"}, {"id": 7, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 8, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 9, "arabic": "وَٱلْءَاخِرَةُ", "translit": "ُẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 10, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 11, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 12, "arabic": "لِلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِl", "root": "وقي"}], "hasIhya": true}, {"ayah": 36, "text": "وَمَن يَعْشُ عَن ذِكْرِ ٱلرَّحْمَٰنِ نُقَيِّضْ لَهُۥ شَيْطَٰنًا فَهُوَ لَهُۥ قَرِينٌ ", "translation": "And whoever is blinded from remembrance of the Most Merciful - We appoint for him a devil, and he is to him a companion.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَعْشُ", "translit": "ُhsْʿعَy", "root": "عشو"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "ذِكْرِ", "translit": "ِrْkِhd", "root": "ذكر"}, {"id": 5, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 6, "arabic": "نُقَيِّضْ", "translit": "ْḍِّyَqُn", "root": "قيض"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "شَيْطَٰنًا", "translit": "āًnَٰṭْyَhs", "root": "شطن"}, {"id": 9, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 10, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 11, "arabic": "قَرِينٌ", "translit": "ٌnyِrَq", "root": "قرن"}], "hasIhya": true}, {"ayah": 37, "text": "وَإِنَّهُمْ لَيَصُدُّونَهُمْ عَنِ ٱلسَّبِيلِ وَيَحْسَبُونَ أَنَّهُم مُّهْتَدُونَ ", "translation": "And indeed, they [i.e., the devils] avert them from the way [of guidance] while they think that they are [rightly] guided", "words": [{"id": 1, "arabic": "وَإِنَّهُمْ", "translit": "ْmُhَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَيَصُدُّونَهُمْ", "translit": "ْmُhَnwُّdُṣَyَl", "root": "صدد"}, {"id": 3, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 5, "arabic": "وَيَحْسَبُونَ", "translit": "َnwُbَsْḥَyَw", "root": "حسب"}, {"id": 6, "arabic": "أَنَّهُم", "translit": "mُhَّnَaʾ", "root": ""}, {"id": 7, "arabic": "مُّهْتَدُونَ", "translit": "َnwُdَtْhُّm", "root": "هدي"}], "hasIhya": false}, {"ayah": 38, "text": "حَتَّىٰٓ إِذَا جَآءَنَا قَالَ يَٰلَيْتَ بَيْنِى وَبَيْنَكَ بُعْدَ ٱلْمَشْرِقَيْنِ فَبِئْسَ ٱلْقَرِينُ ", "translation": "Until, when he comes to Us [at Judgement], he says [to his companion], \"How I wish there was between me and you the distance between the east and west; and what a wretched companion.\"", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "جَآءَنَا", "translit": "āَnَءٓāَjg", "root": "جيا"}, {"id": 4, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 5, "arabic": "يَٰلَيْتَ", "translit": "َtْyَlَٰy", "root": ""}, {"id": 6, "arabic": "بَيْنِى", "translit": "àِnْyَb", "root": "بين"}, {"id": 7, "arabic": "وَبَيْنَكَ", "translit": "َkَnْyَbَw", "root": "بين"}, {"id": 8, "arabic": "بُعْدَ", "translit": "َdْʿعُb", "root": "بعد"}, {"id": 9, "arabic": "ٱلْمَشْرِقَيْنِ", "translit": "ِnْyَqِrْhsَmْlٱ", "root": "شرق"}, {"id": 10, "arabic": "فَبِئْسَ", "translit": "َsْyʾِbَf", "root": "باس"}, {"id": 11, "arabic": "ٱلْقَرِينُ", "translit": "ُnyِrَqْlٱ", "root": "قرن"}], "hasIhya": false}, {"ayah": 39, "text": "وَلَن يَنفَعَكُمُ ٱلْيَوْمَ إِذ ظَّلَمْتُمْ أَنَّكُمْ فِى ٱلْعَذَابِ مُشْتَرِكُونَ ", "translation": "And never will it benefit you that Day, when you have wronged, that you are [all] sharing in the punishment.", "words": [{"id": 1, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 2, "arabic": "يَنفَعَكُمُ", "translit": "ُmُkَʿعَfnَy", "root": "نفع"}, {"id": 3, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 4, "arabic": "إِذ", "translit": "hdِiʾ", "root": ""}, {"id": 5, "arabic": "ظَّلَمْتُمْ", "translit": "ْmُtْmَlَّẓ", "root": "ظلم"}, {"id": 6, "arabic": "أَنَّكُمْ", "translit": "ْmُkَّnَaʾ", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 9, "arabic": "مُشْتَرِكُونَ", "translit": "َnwُkِrَtْhsُm", "root": "شرك"}], "hasIhya": false}, {"ayah": 40, "text": "أَفَأَنتَ تُسْمِعُ ٱلصُّمَّ أَوْ تَهْدِى ٱلْعُمْىَ وَمَن كَانَ فِى ضَلَٰلٍ مُّبِينٍ ", "translation": "Then will you make the deaf hear, [O Muḥammad], or guide the blind or he who is in clear error?", "words": [{"id": 1, "arabic": "أَفَأَنتَ", "translit": "َtnَaʾَfَaʾ", "root": ""}, {"id": 2, "arabic": "تُسْمِعُ", "translit": "ُʿعِmْsُt", "root": "سمع"}, {"id": 3, "arabic": "ٱلصُّمَّ", "translit": "َّmُّṣlٱ", "root": "صمم"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "تَهْدِى", "translit": "àِdْhَt", "root": "هدي"}, {"id": 6, "arabic": "ٱلْعُمْىَ", "translit": "َàْmُʿعْlٱ", "root": "عمي"}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}, {"id": 11, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 41, "text": "فَإِمَّا نَذْهَبَنَّ بِكَ فَإِنَّا مِنْهُم مُّنتَقِمُونَ ", "translation": "And whether [or not] We take you away [in death], indeed, We will take retribution upon them.", "words": [{"id": 1, "arabic": "فَإِمَّا", "translit": "āَّmِiʾَf", "root": ""}, {"id": 2, "arabic": "نَذْهَبَنَّ", "translit": "َّnَbَhْhdَn", "root": "ذهب"}, {"id": 3, "arabic": "بِكَ", "translit": "َkِb", "root": ""}, {"id": 4, "arabic": "فَإِنَّا", "translit": "āَّnِiʾَf", "root": ""}, {"id": 5, "arabic": "مِنْهُم", "translit": "mُhْnِm", "root": ""}, {"id": 6, "arabic": "مُّنتَقِمُونَ", "translit": "َnwُmِqَtnُّm", "root": "نقم"}], "hasIhya": false}, {"ayah": 42, "text": "أَوْ نُرِيَنَّكَ ٱلَّذِى وَعَدْنَٰهُمْ فَإِنَّا عَلَيْهِم مُّقْتَدِرُونَ ", "translation": "Or whether [or not] We show you that which We have promised them, indeed, We are Perfect in Ability.", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "نُرِيَنَّكَ", "translit": "َkَّnَyِrُn", "root": "راي"}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "وَعَدْنَٰهُمْ", "translit": "ْmُhَٰnْdَʿعَw", "root": "وعد"}, {"id": 5, "arabic": "فَإِنَّا", "translit": "āَّnِiʾَf", "root": ""}, {"id": 6, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "مُّقْتَدِرُونَ", "translit": "َnwُrِdَtْqُّm", "root": "قدر"}], "hasIhya": false}, {"ayah": 43, "text": "فَٱسْتَمْسِكْ بِٱلَّذِىٓ أُوحِىَ إِلَيْكَۖ إِنَّكَ عَلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "So adhere to that which is revealed to you. Indeed, you are on a straight path.", "words": [{"id": 1, "arabic": "فَٱسْتَمْسِكْ", "translit": "ْkِsْmَtْsٱَf", "root": "مسك"}, {"id": 2, "arabic": "بِٱلَّذِىٓ", "translit": "ٓàِhdَّlٱِb", "root": ""}, {"id": 3, "arabic": "أُوحِىَ", "translit": "َàِḥwُaʾ", "root": "وحي"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 8, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 44, "text": "وَإِنَّهُۥ لَذِكْرٌ لَّكَ وَلِقَوْمِكَۖ وَسَوْفَ تُسْـَٔلُونَ ", "translation": "And indeed, it is a remembrance[1] for you and your people, and you [all] are going to be questioned.", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَذِكْرٌ", "translit": "ٌrْkِhdَl", "root": "ذكر"}, {"id": 3, "arabic": "لَّكَ", "translit": "َkَّl", "root": ""}, {"id": 4, "arabic": "وَلِقَوْمِكَ", "translit": "َkِmْwَqِlَw", "root": "قوم"}, {"id": 5, "arabic": "وَسَوْفَ", "translit": "َfْwَsَw", "root": ""}, {"id": 6, "arabic": "تُسْـَٔلُونَ", "translit": "َnwُlَٔـْsُt", "root": "سال"}], "hasIhya": false}, {"ayah": 45, "text": "وَسْـَٔلْ مَنْ أَرْسَلْنَا مِن قَبْلِكَ مِن رُّسُلِنَآ أَجَعَلْنَا مِن دُونِ ٱلرَّحْمَٰنِ ءَالِهَةً يُعْبَدُونَ ", "translation": "And ask those We sent before you of Our messengers; have We made besides the Most Merciful deities to be worshipped?", "words": [{"id": 1, "arabic": "وَسْـَٔلْ", "translit": "ْlَٔـْsَw", "root": "سال"}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "رُّسُلِنَآ", "translit": "ٓāَnِlُsُّr", "root": "رسل"}, {"id": 8, "arabic": "أَجَعَلْنَا", "translit": "āَnْlَʿعَjgَaʾ", "root": "جعل"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 11, "arabic": "ٱلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 12, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 13, "arabic": "يُعْبَدُونَ", "translit": "َnwُdَbْʿعُy", "root": "عبد"}], "hasIhya": false}, {"ayah": 46, "text": "وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِـَٔايَٰتِنَآ إِلَىٰ فِرْعَوْنَ وَمَلَإِي۟هِۦ فَقَالَ إِنِّى رَسُولُ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "And certainly did We send Moses with Our signs to Pharaoh and his establishment, and he said, \"Indeed, I am the messenger of the Lord of the worlds.\"", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 7, "arabic": "وَمَلَإِي۟هِۦ", "translit": "ۦِh۟yِiʾَlَmَw", "root": "ملا"}, {"id": 8, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 9, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 10, "arabic": "رَسُولُ", "translit": "ُlwُsَr", "root": "رسل"}, {"id": 11, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 12, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 47, "text": "فَلَمَّا جَآءَهُم بِـَٔايَٰتِنَآ إِذَا هُم مِّنْهَا يَضْحَكُونَ ", "translation": "But when he brought them Our signs, at once they laughed at them.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَهُم", "translit": "mُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 6, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 7, "arabic": "يَضْحَكُونَ", "translit": "َnwُkَḥْḍَy", "root": "ضحك"}], "hasIhya": false}, {"ayah": 48, "text": "وَمَا نُرِيهِم مِّنْ ءَايَةٍ إِلَّا هِىَ أَكْبَرُ مِنْ أُخْتِهَاۖ وَأَخَذْنَٰهُم بِٱلْعَذَابِ لَعَلَّهُمْ يَرْجِعُونَ ", "translation": "And We showed them not a sign except that it was greater than its sister, and We seized them with affliction that perhaps they might return [to faith].", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "نُرِيهِم", "translit": "mِhyِrُn", "root": "راي"}, {"id": 3, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 4, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 7, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "أُخْتِهَا", "translit": "āَhِtْhkُaʾ", "root": "اخو"}, {"id": 10, "arabic": "وَأَخَذْنَٰهُم", "translit": "mُhَٰnْhdَhkَaʾَw", "root": "اخذ"}, {"id": 11, "arabic": "بِٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱِb", "root": "عذب"}, {"id": 12, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 13, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 49, "text": "وَقَالُوا۟ يَٰٓأَيُّهَ ٱلسَّاحِرُ ٱدْعُ لَنَا رَبَّكَ بِمَا عَهِدَ عِندَكَ إِنَّنَا لَمُهْتَدُونَ ", "translation": "And they said [to Moses], \"O magician, invoke for us your Lord by what He has promised you. Indeed, we will be guided.\"", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "يَٰٓأَيُّهَ", "translit": "َhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 3, "arabic": "ٱلسَّاحِرُ", "translit": "ُrِḥāَّslٱ", "root": "سحر"}, {"id": 4, "arabic": "ٱدْعُ", "translit": "ُʿعْdٱ", "root": "دعو"}, {"id": 5, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 6, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 7, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 8, "arabic": "عَهِدَ", "translit": "َdِhَʿع", "root": "عهد"}, {"id": 9, "arabic": "عِندَكَ", "translit": "َkَdnِʿع", "root": "عند"}, {"id": 10, "arabic": "إِنَّنَا", "translit": "āَnَّnِiʾ", "root": ""}, {"id": 11, "arabic": "لَمُهْتَدُونَ", "translit": "َnwُdَtْhُmَl", "root": "هدي"}], "hasIhya": false}, {"ayah": 50, "text": "فَلَمَّا كَشَفْنَا عَنْهُمُ ٱلْعَذَابَ إِذَا هُمْ يَنكُثُونَ ", "translation": "But when We removed from them the affliction, at once they broke their word.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "كَشَفْنَا", "translit": "āَnْfَhsَk", "root": "كشف"}, {"id": 3, "arabic": "عَنْهُمُ", "translit": "ُmُhْnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 5, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 6, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 7, "arabic": "يَنكُثُونَ", "translit": "َnwُhtُknَy", "root": "نكث"}], "hasIhya": false}, {"ayah": 51, "text": "وَنَادَىٰ فِرْعَوْنُ فِى قَوْمِهِۦ قَالَ يَٰقَوْمِ أَلَيْسَ لِى مُلْكُ مِصْرَ وَهَٰذِهِ ٱلْأَنْهَٰرُ تَجْرِى مِن تَحْتِىٓۖ أَفَلَا تُبْصِرُونَ ", "translation": "And Pharaoh called out among his people; he said, \"O my people, does not the kingdom of Egypt belong to me, and these rivers flowing beneath me; then do you not see?", "words": [{"id": 1, "arabic": "وَنَادَىٰ", "translit": "ٰàَdāَnَw", "root": "ندي"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦ", "translit": "ۦِhِmْwَq", "root": "قوم"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 7, "arabic": "أَلَيْسَ", "translit": "َsْyَlَaʾ", "root": "ليس"}, {"id": 8, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 9, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 10, "arabic": "مِصْرَ", "translit": "َrْṣِm", "root": "مصر"}, {"id": 11, "arabic": "وَهَٰذِهِ", "translit": "ِhِhdَٰhَw", "root": ""}, {"id": 12, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 13, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "تَحْتِىٓ", "translit": "ٓàِtْḥَt", "root": "تحت"}, {"id": 16, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 17, "arabic": "تُبْصِرُونَ", "translit": "َnwُrِṣْbُt", "root": "بصر"}], "hasIhya": false}, {"ayah": 52, "text": "أَمْ أَنَا۠ خَيْرٌ مِّنْ هَٰذَا ٱلَّذِى هُوَ مَهِينٌ وَلَا يَكَادُ يُبِينُ ", "translation": "Or am I [not] better than this one [i.e., Moses] who is insignificant and hardly makes himself clear?[1]", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 3, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 6, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "مَهِينٌ", "translit": "ٌnyِhَm", "root": "مهن"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يَكَادُ", "translit": "ُdāَkَy", "root": "كود"}, {"id": 11, "arabic": "يُبِينُ", "translit": "ُnyِbُy", "root": "بين"}], "hasIhya": false}, {"ayah": 53, "text": "فَلَوْلَآ أُلْقِىَ عَلَيْهِ أَسْوِرَةٌ مِّن ذَهَبٍ أَوْ جَآءَ مَعَهُ ٱلْمَلَٰٓئِكَةُ مُقْتَرِنِينَ ", "translation": "Then why have there not been placed upon him bracelets of gold or come with him the angels in conjunction?\"", "words": [{"id": 1, "arabic": "فَلَوْلَآ", "translit": "ٓāَlْwَlَf", "root": ""}, {"id": 2, "arabic": "أُلْقِىَ", "translit": "َàِqْlُaʾ", "root": "لقي"}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "أَسْوِرَةٌ", "translit": "ٌẗَrِwْsَaʾ", "root": "سور"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "ذَهَبٍ", "translit": "ٍbَhَhd", "root": "ذهب"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 9, "arabic": "مَعَهُ", "translit": "ُhَʿعَm", "root": ""}, {"id": 10, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 11, "arabic": "مُقْتَرِنِينَ", "translit": "َnyِnِrَtْqُm", "root": "قرن"}], "hasIhya": true}, {"ayah": 54, "text": "فَٱسْتَخَفَّ قَوْمَهُۥ فَأَطَاعُوهُۚ إِنَّهُمْ كَانُوا۟ قَوْمًا فَٰسِقِينَ ", "translation": "So he bluffed his people, and they obeyed him. Indeed, they were [themselves] a people defiantly disobedient [of Allāh].", "words": [{"id": 1, "arabic": "فَٱسْتَخَفَّ", "translit": "َّfَhkَtْsٱَf", "root": "خفف"}, {"id": 2, "arabic": "قَوْمَهُۥ", "translit": "ۥُhَmْwَq", "root": "قوم"}, {"id": 3, "arabic": "فَأَطَاعُوهُ", "translit": "ُhwُʿعāَṭَaʾَf", "root": "طوع"}, {"id": 4, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 6, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 7, "arabic": "فَٰسِقِينَ", "translit": "َnyِqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 55, "text": "فَلَمَّآ ءَاسَفُونَا ٱنتَقَمْنَا مِنْهُمْ فَأَغْرَقْنَٰهُمْ أَجْمَعِينَ ", "translation": "And when they angered Us, We took retribution from them and drowned them all.", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 2, "arabic": "ءَاسَفُونَا", "translit": "āَnwُfَsāَء", "root": "اسف"}, {"id": 3, "arabic": "ٱنتَقَمْنَا", "translit": "āَnْmَqَtnٱ", "root": "نقم"}, {"id": 4, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 5, "arabic": "فَأَغْرَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَrْغَaʾَf", "root": "غرق"}, {"id": 6, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": false}, {"ayah": 56, "text": "فَجَعَلْنَٰهُمْ سَلَفًا وَمَثَلًا لِّلْءَاخِرِينَ ", "translation": "And We made them a precedent and an example for the later peoples.", "words": [{"id": 1, "arabic": "فَجَعَلْنَٰهُمْ", "translit": "ْmُhَٰnْlَʿعَjgَf", "root": "جعل"}, {"id": 2, "arabic": "سَلَفًا", "translit": "āًfَlَs", "root": "سلف"}, {"id": 3, "arabic": "وَمَثَلًا", "translit": "āًlَhtَmَw", "root": "مثل"}, {"id": 4, "arabic": "لِّلْءَاخِرِينَ", "translit": "َnyِrِhkāَءْlِّl", "root": "اخر"}], "hasIhya": false}, {"ayah": 57, "text": "وَلَمَّا ضُرِبَ ٱبْنُ مَرْيَمَ مَثَلًا إِذَا قَوْمُكَ مِنْهُ يَصِدُّونَ ", "translation": "And when the son of Mary was presented as an example,[1] immediately your people laughed aloud.", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "ضُرِبَ", "translit": "َbِrُḍ", "root": "ضرب"}, {"id": 3, "arabic": "ٱبْنُ", "translit": "ُnْbٱ", "root": "بني"}, {"id": 4, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 5, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 6, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 7, "arabic": "قَوْمُكَ", "translit": "َkُmْwَq", "root": "قوم"}, {"id": 8, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 9, "arabic": "يَصِدُّونَ", "translit": "َnwُّdِṣَy", "root": "صدد"}], "hasIhya": false}, {"ayah": 58, "text": "وَقَالُوٓا۟ ءَأَٰلِهَتُنَا خَيْرٌ أَمْ هُوَۚ مَا ضَرَبُوهُ لَكَ إِلَّا جَدَلًۢاۚ بَلْ هُمْ قَوْمٌ خَصِمُونَ ", "translation": "And they said, \"Are our gods better, or is he?\"[1] They did not present it [i.e., the comparison] except for [mere] argument. But, [in fact], they are a people prone to dispute.", "words": [{"id": 1, "arabic": "وَقَالُوٓا۟", "translit": "۟āٓwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ءَأَٰلِهَتُنَا", "translit": "āَnُtَhِlَٰaʾَء", "root": "اله"}, {"id": 3, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 4, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "ضَرَبُوهُ", "translit": "ُhwُbَrَḍ", "root": "ضرب"}, {"id": 8, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "جَدَلًۢا", "translit": "āًۢlَdَjg", "root": "جدل"}, {"id": 11, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 12, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 13, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 14, "arabic": "خَصِمُونَ", "translit": "َnwُmِṣَhk", "root": "خصم"}], "hasIhya": true}, {"ayah": 59, "text": "إِنْ هُوَ إِلَّا عَبْدٌ أَنْعَمْنَا عَلَيْهِ وَجَعَلْنَٰهُ مَثَلًا لِّبَنِىٓ إِسْرَٰٓءِيلَ ", "translation": "He [i.e., Jesus] was not but a servant upon whom We bestowed favor, and We made him an example for the Children of Israel.", "words": [{"id": 1, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "عَبْدٌ", "translit": "ٌdْbَʿع", "root": "عبد"}, {"id": 5, "arabic": "أَنْعَمْنَا", "translit": "āَnْmَʿعْnَaʾ", "root": "نعم"}, {"id": 6, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "وَجَعَلْنَٰهُ", "translit": "ُhَٰnْlَʿعَjgَw", "root": "جعل"}, {"id": 8, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 9, "arabic": "لِّبَنِىٓ", "translit": "ٓàِnَbِّl", "root": "بني"}, {"id": 10, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}], "hasIhya": false}, {"ayah": 60, "text": "وَلَوْ نَشَآءُ لَجَعَلْنَا مِنكُم مَّلَٰٓئِكَةً فِى ٱلْأَرْضِ يَخْلُفُونَ ", "translation": "And if We willed, We could have made [instead] of you angels succeeding [one another][1] on the earth.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "نَشَآءُ", "translit": "ُءٓāَhsَn", "root": "شيا"}, {"id": 3, "arabic": "لَجَعَلْنَا", "translit": "āَnْlَʿعَjgَl", "root": "جعل"}, {"id": 4, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 5, "arabic": "مَّلَٰٓئِكَةً", "translit": "ًẗَkِyʾَٰٓlَّm", "root": "ملك"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "يَخْلُفُونَ", "translit": "َnwُfُlْhkَy", "root": "خلف"}], "hasIhya": false}, {"ayah": 61, "text": "وَإِنَّهُۥ لَعِلْمٌ لِّلسَّاعَةِ فَلَا تَمْتَرُنَّ بِهَا وَٱتَّبِعُونِۚ هَٰذَا صِرَٰطٌ مُّسْتَقِيمٌ ", "translation": "And indeed, he [i.e., Jesus] will be [a sign for] knowledge of the Hour, so be not in doubt of it, and follow Me.[1] This is a straight path.", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَعِلْمٌ", "translit": "ٌmْlِʿعَl", "root": "علم"}, {"id": 3, "arabic": "لِّلسَّاعَةِ", "translit": "ِẗَʿعāَّslِّl", "root": "سوع"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "تَمْتَرُنَّ", "translit": "َّnُrَtْmَt", "root": "مري"}, {"id": 6, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 7, "arabic": "وَٱتَّبِعُونِ", "translit": "ِnwُʿعِbَّtٱَw", "root": "تبع"}, {"id": 8, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 9, "arabic": "صِرَٰطٌ", "translit": "ٌṭَٰrِṣ", "root": "صرط"}, {"id": 10, "arabic": "مُّسْتَقِيمٌ", "translit": "ٌmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 62, "text": "وَلَا يَصُدَّنَّكُمُ ٱلشَّيْطَٰنُۖ إِنَّهُۥ لَكُمْ عَدُوٌّ مُّبِينٌ ", "translation": "And never let Satan avert you. Indeed, he is to you a clear enemy.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَصُدَّنَّكُمُ", "translit": "ُmُkَّnَّdُṣَy", "root": "صدد"}, {"id": 3, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 4, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 6, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 7, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 63, "text": "وَلَمَّا جَآءَ عِيسَىٰ بِٱلْبَيِّنَٰتِ قَالَ قَدْ جِئْتُكُم بِٱلْحِكْمَةِ وَلِأُبَيِّنَ لَكُم بَعْضَ ٱلَّذِى تَخْتَلِفُونَ فِيهِۖ فَٱتَّقُوا۟ ٱللَّهَ وَأَطِيعُونِ ", "translation": "And when Jesus brought clear proofs, he said, \"I have come to you with wisdom [i.e., prophethood] and to make clear to you some of that over which you differ, so fear Allāh and obey me.", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "عِيسَىٰ", "translit": "ٰàَsyِʿع", "root": ""}, {"id": 4, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 7, "arabic": "جِئْتُكُم", "translit": "mُkُtْyʾِjg", "root": "جيا"}, {"id": 8, "arabic": "بِٱلْحِكْمَةِ", "translit": "ِẗَmْkِḥْlٱِb", "root": "حكم"}, {"id": 9, "arabic": "وَلِأُبَيِّنَ", "translit": "َnِّyَbُaʾِlَw", "root": "بين"}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "بَعْضَ", "translit": "َḍْʿعَb", "root": "بعض"}, {"id": 12, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 13, "arabic": "تَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَt", "root": "خلف"}, {"id": 14, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 15, "arabic": "فَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَf", "root": "وقي"}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَأَطِيعُونِ", "translit": "ِnwُʿعyِṭَaʾَw", "root": "طوع"}], "hasIhya": false}, {"ayah": 64, "text": "إِنَّ ٱللَّهَ هُوَ رَبِّى وَرَبُّكُمْ فَٱعْبُدُوهُۚ هَٰذَا صِرَٰطٌ مُّسْتَقِيمٌ ", "translation": "Indeed, Allāh is my Lord and your Lord, so worship Him. This is a straight path.\"", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 4, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 5, "arabic": "وَرَبُّكُمْ", "translit": "ْmُkُّbَrَw", "root": "ربب"}, {"id": 6, "arabic": "فَٱعْبُدُوهُ", "translit": "ُhwُdُbْʿعٱَf", "root": "عبد"}, {"id": 7, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 8, "arabic": "صِرَٰطٌ", "translit": "ٌṭَٰrِṣ", "root": "صرط"}, {"id": 9, "arabic": "مُّسْتَقِيمٌ", "translit": "ٌmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 65, "text": "فَٱخْتَلَفَ ٱلْأَحْزَابُ مِنۢ بَيْنِهِمْۖ فَوَيْلٌ لِّلَّذِينَ ظَلَمُوا۟ مِنْ عَذَابِ يَوْمٍ أَلِيمٍ ", "translation": "But the denominations from among them differed [and separated], so woe to those who have wronged from the punishment of a painful Day.", "words": [{"id": 1, "arabic": "فَٱخْتَلَفَ", "translit": "َfَlَtْhkٱَf", "root": "خلف"}, {"id": 2, "arabic": "ٱلْأَحْزَابُ", "translit": "ُbāَzْḥَaʾْlٱ", "root": "حزب"}, {"id": 3, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 4, "arabic": "بَيْنِهِمْ", "translit": "ْmِhِnْyَb", "root": "بين"}, {"id": 5, "arabic": "فَوَيْلٌ", "translit": "ٌlْyَwَf", "root": ""}, {"id": 6, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 7, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 10, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 11, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 66, "text": "هَلْ يَنظُرُونَ إِلَّا ٱلسَّاعَةَ أَن تَأْتِيَهُم بَغْتَةً وَهُمْ لَا يَشْعُرُونَ ", "translation": "Are they waiting except for the Hour to come upon them suddenly while they perceive not?", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَأْتِيَهُم", "translit": "mُhَyِtْaʾَt", "root": "اتي"}, {"id": 7, "arabic": "بَغْتَةً", "translit": "ًẗَtْغَb", "root": "بغت"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": true}, {"ayah": 67, "text": "ٱلْأَخِلَّآءُ يَوْمَئِذٍۭ بَعْضُهُمْ لِبَعْضٍ عَدُوٌّ إِلَّا ٱلْمُتَّقِينَ ", "translation": "Close friends, that Day, will be enemies to each other, except for the righteous", "words": [{"id": 1, "arabic": "ٱلْأَخِلَّآءُ", "translit": "ُءٓāَّlِhkَaʾْlٱ", "root": "خلل"}, {"id": 2, "arabic": "يَوْمَئِذٍۭ", "translit": "ٍۭhdِyʾَmْwَy", "root": "يوم"}, {"id": 3, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 4, "arabic": "لِبَعْضٍ", "translit": "ٍḍْʿعَbِl", "root": "بعض"}, {"id": 5, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": true}, {"ayah": 68, "text": "يَٰعِبَادِ لَا خَوْفٌ عَلَيْكُمُ ٱلْيَوْمَ وَلَآ أَنتُمْ تَحْزَنُونَ ", "translation": "[To whom Allāh will say], \"O My servants, no fear will there be concerning you this Day, nor will you grieve,", "words": [{"id": 1, "arabic": "يَٰعِبَادِ", "translit": "ِdāَbِʿعَٰy", "root": "عبد"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 4, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 6, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 7, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 8, "arabic": "تَحْزَنُونَ", "translit": "َnwُnَzْḥَt", "root": "حزن"}], "hasIhya": false}, {"ayah": 69, "text": "ٱلَّذِينَ ءَامَنُوا۟ بِـَٔايَٰتِنَا وَكَانُوا۟ مُسْلِمِينَ ", "translation": "[You] who believed in Our verses and were Muslims.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 4, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 5, "arabic": "مُسْلِمِينَ", "translit": "َnyِmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 70, "text": "ٱدْخُلُوا۟ ٱلْجَنَّةَ أَنتُمْ وَأَزْوَٰجُكُمْ تُحْبَرُونَ ", "translation": "Enter Paradise, you and your kinds,[1] delighted.\"", "words": [{"id": 1, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 2, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 3, "arabic": "أَنتُمْ", "translit": "ْmُtnَaʾ", "root": ""}, {"id": 4, "arabic": "وَأَزْوَٰجُكُمْ", "translit": "ْmُkُjgَٰwْzَaʾَw", "root": "زوج"}, {"id": 5, "arabic": "تُحْبَرُونَ", "translit": "َnwُrَbْḥُt", "root": "حبر"}], "hasIhya": false}, {"ayah": 71, "text": "يُطَافُ عَلَيْهِم بِصِحَافٍ مِّن ذَهَبٍ وَأَكْوَابٍۖ وَفِيهَا مَا تَشْتَهِيهِ ٱلْأَنفُسُ وَتَلَذُّ ٱلْأَعْيُنُۖ وَأَنتُمْ فِيهَا خَٰلِدُونَ ", "translation": "Circulated among them will be plates and vessels of gold. And therein is whatever the souls desire and [what] delights the eyes, and you will abide therein eternally.", "words": [{"id": 1, "arabic": "يُطَافُ", "translit": "ُfāَṭُy", "root": "طوف"}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "بِصِحَافٍ", "translit": "ٍfāَḥِṣِb", "root": "صحف"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "ذَهَبٍ", "translit": "ٍbَhَhd", "root": "ذهب"}, {"id": 6, "arabic": "وَأَكْوَابٍ", "translit": "ٍbāَwْkَaʾَw", "root": "كوب"}, {"id": 7, "arabic": "وَفِيهَا", "translit": "āَhyِfَw", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "تَشْتَهِيهِ", "translit": "ِhyِhَtْhsَt", "root": "شهو"}, {"id": 10, "arabic": "ٱلْأَنفُسُ", "translit": "ُsُfnَaʾْlٱ", "root": "نفس"}, {"id": 11, "arabic": "وَتَلَذُّ", "translit": "ُّhdَlَtَw", "root": "لذذ"}, {"id": 12, "arabic": "ٱلْأَعْيُنُ", "translit": "ُnُyْʿعَaʾْlٱ", "root": "عين"}, {"id": 13, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 14, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 15, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 72, "text": "وَتِلْكَ ٱلْجَنَّةُ ٱلَّتِىٓ أُورِثْتُمُوهَا بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "And that is Paradise which you are made to inherit for what you used to do.", "words": [{"id": 1, "arabic": "وَتِلْكَ", "translit": "َkْlِtَw", "root": ""}, {"id": 2, "arabic": "ٱلْجَنَّةُ", "translit": "ُẗَّnَjgْlٱ", "root": "جنن"}, {"id": 3, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 4, "arabic": "أُورِثْتُمُوهَا", "translit": "āَhwُmُtْhtِrwُaʾ", "root": "ورث"}, {"id": 5, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 6, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 7, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 73, "text": "لَكُمْ فِيهَا فَٰكِهَةٌ كَثِيرَةٌ مِّنْهَا تَأْكُلُونَ ", "translation": "For you therein is much fruit[1] from which you will eat.", "words": [{"id": 1, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "فَٰكِهَةٌ", "translit": "ٌẗَhِkَٰf", "root": "فكه"}, {"id": 4, "arabic": "كَثِيرَةٌ", "translit": "ٌẗَryِhtَk", "root": "كثر"}, {"id": 5, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 6, "arabic": "تَأْكُلُونَ", "translit": "َnwُlُkْaʾَt", "root": "اكل"}], "hasIhya": false}, {"ayah": 74, "text": "إِنَّ ٱلْمُجْرِمِينَ فِى عَذَابِ جَهَنَّمَ خَٰلِدُونَ ", "translation": "Indeed, the criminals will be in the punishment of Hell, abiding eternally.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 6, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 75, "text": "لَا يُفَتَّرُ عَنْهُمْ وَهُمْ فِيهِ مُبْلِسُونَ ", "translation": "It will not be allowed to subside for them, and they, therein, are in despair.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يُفَتَّرُ", "translit": "ُrَّtَfُy", "root": "فتر"}, {"id": 3, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 4, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 5, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 6, "arabic": "مُبْلِسُونَ", "translit": "َnwُsِlْbُm", "root": "بلس"}], "hasIhya": false}, {"ayah": 76, "text": "وَمَا ظَلَمْنَٰهُمْ وَلَٰكِن كَانُوا۟ هُمُ ٱلظَّٰلِمِينَ ", "translation": "And We did not wrong them, but it was they who were the wrongdoers.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "ظَلَمْنَٰهُمْ", "translit": "ْmُhَٰnْmَlَẓ", "root": "ظلم"}, {"id": 3, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 4, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 5, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 6, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 77, "text": "وَنَادَوْا۟ يَٰمَٰلِكُ لِيَقْضِ عَلَيْنَا رَبُّكَۖ قَالَ إِنَّكُم مَّٰكِثُونَ ", "translation": "And they will call, \"O Mālik,[1] let your Lord put an end to us!\" He will say, \"Indeed, you will remain.\"", "words": [{"id": 1, "arabic": "وَنَادَوْا۟", "translit": "۟āْwَdāَnَw", "root": "ندي"}, {"id": 2, "arabic": "يَٰمَٰلِكُ", "translit": "ُkِlَٰmَٰy", "root": "ملك"}, {"id": 3, "arabic": "لِيَقْضِ", "translit": "ِḍْqَyِl", "root": "قضي"}, {"id": 4, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 5, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "إِنَّكُم", "translit": "mُkَّnِiʾ", "root": ""}, {"id": 8, "arabic": "مَّٰكِثُونَ", "translit": "َnwُhtِkَّٰm", "root": "مكث"}], "hasIhya": true}, {"ayah": 78, "text": "لَقَدْ جِئْنَٰكُم بِٱلْحَقِّ وَلَٰكِنَّ أَكْثَرَكُمْ لِلْحَقِّ كَٰرِهُونَ ", "translation": "We had certainly brought you the truth, but most of you, to the truth, were averse.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "جِئْنَٰكُم", "translit": "mُkَٰnْyʾِjg", "root": "جيا"}, {"id": 3, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 4, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 5, "arabic": "أَكْثَرَكُمْ", "translit": "ْmُkَrَhtْkَaʾ", "root": "كثر"}, {"id": 6, "arabic": "لِلْحَقِّ", "translit": "ِّqَḥْlِl", "root": "حقق"}, {"id": 7, "arabic": "كَٰرِهُونَ", "translit": "َnwُhِrَٰk", "root": "كره"}], "hasIhya": false}, {"ayah": 79, "text": "أَمْ أَبْرَمُوٓا۟ أَمْرًا فَإِنَّا مُبْرِمُونَ ", "translation": "Or have they devised [some] affair?[1] But indeed, We are devising [a plan].", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "أَبْرَمُوٓا۟", "translit": "۟āٓwُmَrْbَaʾ", "root": "برم"}, {"id": 3, "arabic": "أَمْرًا", "translit": "āًrْmَaʾ", "root": "امر"}, {"id": 4, "arabic": "فَإِنَّا", "translit": "āَّnِiʾَf", "root": ""}, {"id": 5, "arabic": "مُبْرِمُونَ", "translit": "َnwُmِrْbُm", "root": "برم"}], "hasIhya": false}, {"ayah": 80, "text": "أَمْ يَحْسَبُونَ أَنَّا لَا نَسْمَعُ سِرَّهُمْ وَنَجْوَىٰهُمۚ بَلَىٰ وَرُسُلُنَا لَدَيْهِمْ يَكْتُبُونَ ", "translation": "Or do they think that We hear not their secrets and their private conversations? Yes, [We do], and Our messengers [i.e., angels] are with them recording.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "يَحْسَبُونَ", "translit": "َnwُbَsْḥَy", "root": "حسب"}, {"id": 3, "arabic": "أَنَّا", "translit": "āَّnَaʾ", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "نَسْمَعُ", "translit": "ُʿعَmْsَn", "root": "سمع"}, {"id": 6, "arabic": "سِرَّهُمْ", "translit": "ْmُhَّrِs", "root": "سرر"}, {"id": 7, "arabic": "وَنَجْوَىٰهُم", "translit": "mُhٰàَwْjgَnَw", "root": "نجو"}, {"id": 8, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 9, "arabic": "وَرُسُلُنَا", "translit": "āَnُlُsُrَw", "root": "رسل"}, {"id": 10, "arabic": "لَدَيْهِمْ", "translit": "ْmِhْyَdَl", "root": ""}, {"id": 11, "arabic": "يَكْتُبُونَ", "translit": "َnwُbُtْkَy", "root": "كتب"}], "hasIhya": false}, {"ayah": 81, "text": "قُلْ إِن كَانَ لِلرَّحْمَٰنِ وَلَدٌ فَأَنَا۠ أَوَّلُ ٱلْعَٰبِدِينَ ", "translation": "Say, [O Muḥammad], \"If the Most Merciful had a son, then I would be the first of [his] worshippers.\"[1]", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "لِلرَّحْمَٰنِ", "translit": "ِnَٰmْḥَّrlِl", "root": "رحم"}, {"id": 5, "arabic": "وَلَدٌ", "translit": "ٌdَlَw", "root": "ولد"}, {"id": 6, "arabic": "فَأَنَا۠", "translit": "۠āَnَaʾَf", "root": ""}, {"id": 7, "arabic": "أَوَّلُ", "translit": "ُlَّwَaʾ", "root": "اول"}, {"id": 8, "arabic": "ٱلْعَٰبِدِينَ", "translit": "َnyِdِbَٰʿعْlٱ", "root": "عبد"}], "hasIhya": false}, {"ayah": 82, "text": "سُبْحَٰنَ رَبِّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ رَبِّ ٱلْعَرْشِ عَمَّا يَصِفُونَ ", "translation": "Exalted is the Lord of the heavens and the earth, Lord of the Throne, above what they describe.", "words": [{"id": 1, "arabic": "سُبْحَٰنَ", "translit": "َnَٰḥْbُs", "root": "سبح"}, {"id": 2, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 5, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 6, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 7, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 8, "arabic": "يَصِفُونَ", "translit": "َnwُfِṣَy", "root": "وصف"}], "hasIhya": false}, {"ayah": 83, "text": "فَذَرْهُمْ يَخُوضُوا۟ وَيَلْعَبُوا۟ حَتَّىٰ يُلَٰقُوا۟ يَوْمَهُمُ ٱلَّذِى يُوعَدُونَ ", "translation": "So leave them to converse vainly and amuse themselves until they meet their Day which they are promised.", "words": [{"id": 1, "arabic": "فَذَرْهُمْ", "translit": "ْmُhْrَhdَf", "root": "وذر"}, {"id": 2, "arabic": "يَخُوضُوا۟", "translit": "۟āwُḍwُhkَy", "root": "خوض"}, {"id": 3, "arabic": "وَيَلْعَبُوا۟", "translit": "۟āwُbَʿعْlَyَw", "root": "لعب"}, {"id": 4, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 5, "arabic": "يُلَٰقُوا۟", "translit": "۟āwُqَٰlُy", "root": "لقي"}, {"id": 6, "arabic": "يَوْمَهُمُ", "translit": "ُmُhَmْwَy", "root": "يوم"}, {"id": 7, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "يُوعَدُونَ", "translit": "َnwُdَʿعwُy", "root": "وعد"}], "hasIhya": false}, {"ayah": 84, "text": "وَهُوَ ٱلَّذِى فِى ٱلسَّمَآءِ إِلَٰهٌ وَفِى ٱلْأَرْضِ إِلَٰهٌۚ وَهُوَ ٱلْحَكِيمُ ٱلْعَلِيمُ ", "translation": "And it is He [i.e., Allāh] who is [the only] deity in the heaven, and on the earth [the only] deity. And He is the Wise, the Knowing.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 9, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 10, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}, {"id": 11, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 85, "text": "وَتَبَارَكَ ٱلَّذِى لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَمَا بَيْنَهُمَا وَعِندَهُۥ عِلْمُ ٱلسَّاعَةِ وَإِلَيْهِ تُرْجَعُونَ ", "translation": "And blessed is He to whom belongs the dominion of the heavens and the earth and whatever is between them and with whom is knowledge of the Hour and to whom you will be returned.", "words": [{"id": 1, "arabic": "وَتَبَارَكَ", "translit": "َkَrāَbَtَw", "root": "برك"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 8, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 9, "arabic": "وَعِندَهُۥ", "translit": "ۥُhَdnِʿعَw", "root": "عند"}, {"id": 10, "arabic": "عِلْمُ", "translit": "ُmْlِʿع", "root": "علم"}, {"id": 11, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 12, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 13, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": false}, {"ayah": 86, "text": "وَلَا يَمْلِكُ ٱلَّذِينَ يَدْعُونَ مِن دُونِهِ ٱلشَّفَٰعَةَ إِلَّا مَن شَهِدَ بِٱلْحَقِّ وَهُمْ يَعْلَمُونَ ", "translation": "And those they invoke[1] besides Him do not possess [power of] intercession; but only those who testify to the truth [can benefit], and they know.[2]", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يَمْلِكُ", "translit": "ُkِlْmَy", "root": "ملك"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِهِ", "translit": "ِhِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱلشَّفَٰعَةَ", "translit": "َẗَʿعَٰfَّhslٱ", "root": "شفع"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 10, "arabic": "شَهِدَ", "translit": "َdِhَhs", "root": "شهد"}, {"id": 11, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 12, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 13, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 87, "text": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَهُمْ لَيَقُولُنَّ ٱللَّهُۖ فَأَنَّىٰ يُؤْفَكُونَ ", "translation": "And if you asked them[1] who created them, they would surely say, \"Allāh.\" So how are they deluded?", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 2, "arabic": "سَأَلْتَهُم", "translit": "mُhَtْlَaʾَs", "root": "سال"}, {"id": 3, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 4, "arabic": "خَلَقَهُمْ", "translit": "ْmُhَqَlَhk", "root": "خلق"}, {"id": 5, "arabic": "لَيَقُولُنَّ", "translit": "َّnُlwُqَyَl", "root": "قول"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "فَأَنَّىٰ", "translit": "ٰàَّnَaʾَf", "root": ""}, {"id": 8, "arabic": "يُؤْفَكُونَ", "translit": "َnwُkَfْwʾُy", "root": "افك"}], "hasIhya": true}, {"ayah": 88, "text": "وَقِيلِهِۦ يَٰرَبِّ إِنَّ هَٰٓؤُلَآءِ قَوْمٌ لَّا يُؤْمِنُونَ ", "translation": "And [Allāh acknowledges] his saying,[1] \"O my Lord, indeed these are a people who do not believe.\"", "words": [{"id": 1, "arabic": "وَقِيلِهِۦ", "translit": "ۦِhِlyِqَw", "root": "قول"}, {"id": 2, "arabic": "يَٰرَبِّ", "translit": "ِّbَrَٰy", "root": "ربب"}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 5, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 6, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 7, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 89, "text": "فَٱصْفَحْ عَنْهُمْ وَقُلْ سَلَٰمٌۚ فَسَوْفَ يَعْلَمُونَ ", "translation": "So turn aside from them and say, \"Peace.\"[1] But they are going to know.", "words": [{"id": 1, "arabic": "فَٱصْفَحْ", "translit": "ْḥَfْṣٱَf", "root": "صفح"}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 3, "arabic": "وَقُلْ", "translit": "ْlُqَw", "root": "قول"}, {"id": 4, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 5, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 6, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}], "tafsir": {"9": [{"arabic": "ولذلك قال عز وجل ولئن سألتهم من خلق السموات والأرض ليقولن الله وقال تعالى فأقم وجهك للدين حنيفا فطرة الله التي", "english": "The First Principle: the knowledge of His existence, the Exalted. The first thing by which one is illuminated from among the lights, and the path of reflection (ṭarīq al-iʿtibār) by which one proceeds, is that to which the Qurʾān has guided. For after the explanation of God, glorified be He, there is no explanation. He, the Exalted, has said: {«أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا وَالْجِبَالَ أَوْتَادًا وَخَلَقْنَاكُمْ أَزْوَاجًا وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا وَجَعَلْنَا اللَّيْلَ لِبَاسًا وَجَعَلْنَا النَّهَارَ مَعَاشًا وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا وَجَعَلْنَا سِرَاجًا وَهَّاجًا وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا وَجَنَّاتٍ أَلْفَافًا»} — \"Have We not made the earth a resting place, and the mountains as pegs, and created you in pairs, and made your sleep a repose, and made the night a covering, and made the day for livelihood, and built above you seven strong heavens, and made a blazing lamp, and sent down from the rain-clouds pouring water, that We may bring forth thereby grain and vegetation, and gardens dense with foliage?\" (Q 78:6–16). And He, the Exalted, has said: {«إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ وَمَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ»} — \"Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the ships which sail through the sea with that which benefits people, and what God has sent down from the sky of water, thereby reviving the earth after its death, and dispersing therein every creature, and the directing of the winds, and the clouds subservient between the heaven and the earth — are signs for a people who reason\" (Q 2:164). And He, the Exalted, has said: {«أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا»} — \"Have you not seen how God created seven heavens in layers, and made the moon therein a light, and made the sun a lamp? And God caused you to grow from the earth a growth; then He returns you into it, and brings you forth a bringing forth\" (Q 71:15–18). And He, the Exalted, has said: {«أَفَرَأَيْتُم مَّا تُمْنُونَ أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ»} — \"Have you considered what you emit? Do you create it, or are We the Creator?\" — up to His saying: {«لِلْمُقْوِينَ»} — \"for the settlers\" (Q 56:58–73).", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 87", "section_title_en": "The Pillars of Faith: Knowledge of God, His Attributes, His Acts, and the Audibles — Section 87", "section_index": 87, "anchors": "- Root: وجود (w-j-d)\n  * Lisan / Ayn: [Core linguistic root meaning: to find, to perceive, to be; existence as that which is found or discovered]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: al-wujūd as necessary existence (wujūb) versus contingent existence (imkān); the self-evident reality of the Creator's being]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: haqīqah — existence as affirmed reality; majāz — \"finding\" as in discovery, not applicable to God's necessary being]\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: [Core linguistic root meaning: measuring, proportioning, fashioning; origination of a thing upon a measure]\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination from nothing without prior model\n  * Al-Zamakhshari (Asas): [Literal: خلق الله الخلق: أوجده على تقدير أوجبته الحكمة — brought into existence upon a measure necessitated by wisdom; Majaz: not applicable to God's act as pure origination]\n- Root: فطر (f-t-r)\n  * Lisan / Ayn: [Core linguistic root meaning: to split, cleave, rend; to originate, to bring forth as a new creation]\n  * Al-Raghib (Mufradat): \"فطر الله الخلق\" — God's origination of creation as a primordial act; \"الفطرة\" as the innate disposition\n  * Al-Zamakhshari (Asas): [Literal: فطر الله الخلق، وهو فاطر السموات: مبتدعها — originator without precedent; Majaz: \"رأيه فطير\" — immature opinion, not applicable to divine]\n- Root: ارض (ar-d)\n  * Lisan / Ayn: [Core linguistic root meaning: the earth, the lower sphere; that which is beneath]\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء\" — the body opposite the heaven\n  * Al-Zamakhshari (Asas): [Literal: the earth as a resting place (مهادا); Majaz: not applicable in this context of divine creation]\n- Root: ركن (r-k-n)\n  * Lisan / Ayn: [Core linguistic root meaning: corner, pillar, support; that to which one leans for strength]\n  * Al-Raghib (Mufradat): \"ركن الشيء: جانبه الذي يسكن إليه\" — the side of a thing to which one repairs; used metaphorically for strength\n  * Al-Zamakhshari (Asas): [Literal: physical pillar/corner; Majaz: \"فلان يأوي من عز قومه إلى ركن شديد\" — one who repairs to a mighty support; here, the \"pillars\" (أركان) of faith as structural supports]\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure \"مداره على عشرة أصول\" (its circuit revolves upon ten principles) employs a prepositional phrase governing the verbal noun, establishing the necessary grammatical dependency that mirrors the ontological dependency of the created upon the Creator.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "13": [{"arabic": "وما لم يشأ لم يكن سبحان الذي سخر لنا هذا وما كنا له مقرنين وإنا إلى ربنا لمنقلبون اللهم إني وجهت وجهي إليك وفوضت أمري كله إليك وتوكلت في جميع أموري عليك أنت حسبي ونعم الوكيل فإذا استوى على الراحلة واستوت تحته قال سبحان الله والحمد لله ولا إله إلا الله والله أكبر سبع مرات وقال الحمد لله الذي هدانا لهذا وما كنا لنهتدي لولا أن هدانا الله اللهم أنت الحامل على الظهر وأنت المستعان على الأمور السادسة في النزول والسنة أن لا ينزل حتى يحمى النهار ويكون أكثر سيره بالليل قال صلى الله عليه وسلم عليكم بالدلجة فإن الأرض تطوي بالليل ما لا تطوي با", "english": "He ought to seek out a righteous companion, one who loves goodness and assists in it: if he forgets, the companion reminds him; if he remembers, the companion aids him; if he fears, the companion emboldens him; if he weakens, the companion strengthens him; if his breast narrows, the companion enlarges his patience. He should bid farewell to his resident companions, his brothers, and his neighbors — taking leave of them and seeking their supplications, for God Most High places goodness in their prayers. The Sunnah of farewell is to say: «أستودع الله دينك وأمانتك وخواتيم عملك» — \"I entrust to God your religion, your trustworthiness, and the seal of your deeds.\" And he, peace and blessings be upon him, used to say to one intending travel: \"In God's protection and His care — may God provide you with piety, forgive your sin, and direct you toward goodness wherever you may be.\"", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 199", "section_title_en": "The Book of the Etiquette of Travel — Section 199: On the Comprehensive Etiquette of the Journey (From Provisioning to Guarding)", "section_index": 199, "anchors": "- Root: س ف ر (S-F-R)\n  * Lisan / Ayn: \"السفر: كشف الغطاء\" — unveiling, uncovering; the traveler is one who uncovers the veils of distant lands.\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء، ويختص ذلك بالأعيان\" — the journey is a literal uncovering of horizons, yet the spiritual journey unveils the soul's veils.\n  * Al-Zamakhshari (Asas): Haqiqah: \"سافر سفرا بعيدا\" (to travel far); Majaz: \"وجه مسفر: مشرق سرورا\" — a face radiant with joy, as the traveler's face brightens with divine trust.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the supplications' structural pauses.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Hajj'", "badge": "Du'a"}], "14": [{"arabic": "وما لم يشأ لم يكن سبحان الذي سخر لنا هذا وما كنا له مقرنين وإنا إلى ربنا لمنقلبون اللهم إني وجهت وجهي إليك وفوضت أمري كله إليك وتوكلت في جميع أموري عليك أنت حسبي ونعم الوكيل فإذا استوى على الراحلة واستوت تحته قال سبحان الله والحمد لله ولا إله إلا الله والله أكبر سبع مرات وقال الحمد لله الذي هدانا لهذا وما كنا لنهتدي لولا أن هدانا الله اللهم أنت الحامل على الظهر وأنت المستعان على الأمور السادسة في النزول والسنة أن لا ينزل حتى يحمى النهار ويكون أكثر سيره بالليل قال صلى الله عليه وسلم عليكم بالدلجة فإن الأرض تطوي بالليل ما لا تط", "english": "He ought to seek out a righteous companion, one who loves goodness and assists in it: if he forgets, the companion reminds him; if he remembers, the companion aids him; if he fears, the companion emboldens him; if he weakens, the companion strengthens him; if his breast narrows, the companion enlarges his patience. He should bid farewell to his resident companions, his brothers, and his neighbors — taking leave of them and seeking their supplications, for God Most High places goodness in their prayers. The Sunnah of farewell is to say: «أستودع الله دينك وأمانتك وخواتيم عملك» — \"I entrust to God your religion, your trustworthiness, and the seal of your deeds.\" And he, peace and blessings be upon him, used to say to one intending travel: \"In God's protection and His care — may God provide you with piety, forgive your sin, and direct you toward goodness wherever you may be.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 199", "section_title_en": "The Book of the Etiquette of Travel — Section 199: On the Comprehensive Etiquette of the Journey (From Provisioning to Guarding)", "section_index": 199, "anchors": "- Root: س ف ر (S-F-R)\n  * Lisan / Ayn: \"السفر: كشف الغطاء\" — unveiling, uncovering; the traveler is one who uncovers the veils of distant lands.\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء، ويختص ذلك بالأعيان\" — the journey is a literal uncovering of horizons, yet the spiritual journey unveils the soul's veils.\n  * Al-Zamakhshari (Asas): Haqiqah: \"سافر سفرا بعيدا\" (to travel far); Majaz: \"وجه مسفر: مشرق سرورا\" — a face radiant with joy, as the traveler's face brightens with divine trust.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the supplications' structural pauses.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "22": [{"arabic": "الدين كقوله عز وجل إنا وجدنا آباءنا على أمة والأمة الحين والزمان كقوله عز وجل إلى أمة معدودة وقوله عز وجل وادكر بعد أمة والأمة القامة يقال فلان حسن الأمة أي القامة وأمة رجل منفرد بدين لا يشركه فيه أحد قال صلى الله عليه وسلم يبعث زيد بن عمرو بن نفيل أمة وحده (1) والأمة يقال هذه أمة زيد أي أم زيد والروح أيضا ورد في القرآن على معان كثيرة فلا نطول بإيرادها وكذلك قد يقع الإبهام في الحروف مثل قوله عز وجل قأثرن به نقعا فوسطن به جمعا فالهاء الأولى كناية عن الحوافر وهي الموريات أي أثرن بالحوافر ن", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}], "23": [{"arabic": "زمانهم حيث قالو إنا وجدنا آباءنا على أمة وإنا على آثارهم مقتدون فعليك إذا اشتغلت بمعاتبة نفسك وحملها على الاجتهاد فاستعصت أن لا تترك معاتبتها وتوبيخها وتعريفها سوء نظرها لنفسها فعساها تنزجر عن طغيانها المرابطة السادسة في توبيخ النفس ومعاتبتها اعلم أن أعدى عدوك نفسك التي بين جنبيك وقد خلقت أمارة بالسوء ميالة إلى الشر فرارة من الخير وأمرت بتزكيتها وتقويمها وقودها بسلاسل القهر إلى عبادة ربها وخالقها ومنعها عن شهواتها وفطامها عن لذاتها فإن أهملتها جمحت وشردت ولم تظفر بها بعد ذلك وإن لازمتها بالتوبيخ والمعاتب", "english": "So upon you — if you are among those who stand watch, those who keep vigil over their own souls (al-murāqibīn li-nafsik) — to scrutinize the states of the men and women among the strivers (al-mujtahidīn), that your zeal may be stirred and your eagerness increased. And beware of looking to the people of your own age, for if you obey most of those on earth, they will lead you astray from the path of God {«وإن تطع أكثر من في الأرض يضلوك عن سبيل الله»}.", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1250", "section_title_en": "Section 1250 — The Sixth Vigil: The Rebuke and Admonishment of the Soul", "section_index": 1250, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit; that which animates and is the seat of desire and volition.\n  * Al-Raghib (Mufradat): Al-nafs denotes the immaterial reality of the human (al-rūḥ), the locus of divine address and moral accountability; its states range from al-ammārah (inciting to evil) to al-lawwāmah (self-reproaching) to al-muṭmaʾinnah (tranquil).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul itself; metaphorical (majāz) usage extends to blood (nafs sāʾilah) or the eye of envy — but here it is the true essence of man.\n- Root: جهل (j-h-l)\n  * Lisan / Ayn: Ignorance as the absence of knowledge; also foolish conduct contrary to right action.\n  * Al-Raghib (Mufradat): Jahl is threefold: (1) the soul's emptiness of knowledge (the root), (2) belief contrary to reality, (3) acting contrary to what is due — whether with correct or corrupt belief.\n  * Al-Zamakhshari (Asas): Literal: ignorance and folly; metaphorical: the wind \"ignoring\" the branch (i.e., agitating it violently) — here, the soul's self-deception is exposed as true ignorance.\n- Root: اهل (a-h-l)\n  * Lisan / Ayn: Those united by kinship, religion, or dwelling; one who is worthy or fit for something.\n  * Al-Raghib (Mufradat): Ahl al-rajul: those joined by lineage, faith, or craft; Ahl al-Bayt in the Qurʾān {«إنما يريد الله ليذهب عنكم الرجس أهل البيت»} — and by extension, what one merits.\n  * Al-Zamakhshari (Asas): Literal: family or inhabitants; metaphorical: \"he is ahl (worthy) for such-and-such\" — i.e., deserving of it, as in the supplication \"tawallā min amrī mā anta ahluh\" (undertake my affair as befits Thee).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate exclusively to the subject, as in the soul's whisper \"إنما تيسر الخير في ذلك الزمان لكثرة الأعوان\" — a false restriction used to delude, and the divine reply \"وذكر فإن الذكرى تنفع المؤمنين\" — where the command is unrestricted.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "الدين كقوله عز وجل إنا وجدنا آباءنا على أمة والأمة الحين والزمان كقوله عز وجل إلى أمة معدودة وقوله عز وجل وادكر بعد أمة والأمة القامة يقال فلان حسن الأمة أي القامة وأمة رجل منفرد بدين لا يشركه فيه أحد قال صلى الله عليه وسلم يبعث زيد بن عمرو بن نفيل أمة وحده (1) والأمة يقال هذه أمة زيد أي أم زيد والروح أيضا ورد في القرآن على معان كثيرة فلا نطول بإيرادها وكذلك قد يقع الإبهام في الحروف مثل قوله عز وجل قأثرن به نقعا فوسطن به جمعا فالهاء الأولى كناية عن الحوافر وهي الموريات أي أثرن بالحوافر ن", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}], "31": [{"arabic": "وجدنا آباءنا على أمة} الآية وعن الكبر والحسد العبارة بقوله تعالى {وقالوا لولا نزل هذا القرآن على رجل من القريتين عظيم} وقوله تعالى {أبشرا منا واحدا نتبعه} فهذه المعميات هي التي منعت الاهتداء والهداية الثانية وراء هذه الهداية العامة وهي التي يمد الله تعالى بها العبد حالا بعد حال وهي ثمرة المجاهدة حيث قال تعالى {والذين جاهدوا فينا لنهدينهم سبلنا} وهو المراد بقوله تعالى {والذين اهتدوا زادهم هدى} والهداية الثالثة وراء الثانية وهو النور الذي يشرق في عالم النبوة والولاية بعد كمال المجاهدة فيهتدي بها إلا ما لا يهتدى إليه بالعقل الذي يحصل به التكليف وإمكان تعلم ال", "english": "PageV04P107\nBut if one does not know what constitutes the welfare of his hereafter—so that he even supposes corruption to be welfare—then from where would mere volition benefit him? There is no benefit in volition, power, and causes except after guidance (hidāyah). For this reason, God—exalted is He—said: {«ربنا الذي أعطى كل شيء خلقه ثم هدى»} \"Our Lord who gave everything its creation, then guided.\" And He said—exalted is He—: {«ولولا فضل الله عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء»} \"And were it not for God's bounty upon you and His mercy, not one of you would ever be purified; but God purifies whom He wills.\" And the Prophet—peace be upon him—said: \"No one enters Paradise except by the mercy of God—exalted is He—,\" that is, by His guidance. So it was said: \"Not even you, O Messenger of God?\" He said: \"Not even I\" (1). And guidance (hidāyah) has three stations (manāzil):", "book_title": "Patience and Gratitude", "section_title_ar": "Section 999", "section_title_en": "The Degrees of Divine Guidance (Hidāyah), Righteous Discernment (Rushd), Straightening (Tasdīd), and Divine Support (Ta'yīd)", "section_index": 999, "anchors": "- Root: هدي (H-D-Y)\n  * Lisan / Ayn: Core meaning of gentle, gracious direction (dalālah bi-luṭf); the root also yields \"gift\" (hadiyyah) and the leading beasts of prey (hawādī) that guide the herd.\n  * Al-Raghib (Mufradat): Guidance is \"directional indication with gentleness\" (dalālah bi-luṭf), distinct from mere intellectual proof; it is a divine act that may be general (to all) or specific (to the elect), and its withholding is a form of abandonment.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He guided him to the path\" (hadāhu lil-sabīl). Metaphorical (majāz): \"He guided him\" meaning \"he preceded him\" (taqaddamahu), as a leader precedes the caravan; hence guidance is not merely pointing but active leading.\n- Root: رشد (R-SH-D)\n  * Lisan / Ayn: The state of being rightly directed in one's affairs; integrity of judgment; names Rāshid, Rushayd derive from it.\n  * Al-Raghib (Mufradat): Rushd is the opposite of ghayy (error/ruin); it is used like hidāyah but with a nuance of practical, executive discernment—knowing the good AND being moved to pursue it. Al-Raghib explicitly distinguishes the rushd of Abraham (given before, as a special gift) from the mere legal competence (rushd) of an orphan.\n  * Al-Zamakhshari (Asas): Literal: \"A man is rāshid or rashīd\" (possessing rightness in conduct). Metaphorical: \"He is of sound lineage\" (huwa li-rushdah), i.e., legitimate—showing the root's extension to ontological soundness.\n- Root: سدد (S-D-D)\n  * Lisan / Ayn: To aim correctly, to hit the mark; the arrow that flies straight (sadīd); the opposite of deviation (ighrāḍ).\n  * Al-Raghib (Mufradat): (Not in the retrieved scholia, but by extension from the root's usage in the Qur'an, e.g., {wa-saddidū}, \"and be straight/aim rightly\")—it denotes the divine facilitation of the creature's movements so they align with the intended good.\n  * Al-Zamakhshari (Asas): Literal: \"He aimed the arrow and it went straight.\" Metaphorical: \"He was granted success in speech and action\" (sudda li-l-ṣawāb).\n- Root: أيد (A-Y-D)\n  * Lisan / Ayn: Strength, support, reinforcement; the \"aid\" (ayd) of God is His empowering of His servant.\n  * Al-Raghib (Mufradat): (By extension from {إذ أيدتك بروح القدس})—divine reinforcement through a holy spirit, i.e., an immaterial power that fortifies both inner perception (baṣīrah) and outer action.\n  * Al-Zamakhshari (Asas): Literal: \"He strengthened him\" (ayyadahu). Metaphorical: Used for the conferral of spiritual power that makes the servant invincible against error.\n- Sibawayh Rule: Rule of Gradation and Specification (Tartīb wa-Takhṣīṣ) — The author structures a sequence of terms (hidāyah → rushd → tasdīd → ta'yīd) where each subsequent term is syntactically and semantically superordinate, building a hierarchy of divine acts. The particle \"wa-ammā\" (وأما) marks a new topic with contrastive focus, and the anaphoric references (هو، وهي) bind the exposition into a single periodic argument.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وكيف نطأطيء رءوسنا فقالوا لولا نزل هذا القرآن على رجل من القريتين عظيم (1) أي كان لا يثقل علينا أن نتواضع له ونتبعه إذا كان عظيما وقال تعالى يصف قول قريش أهؤلاء من الله عليهم من بيننا كالاستحقار لهم والأنفة منهم السبب الرابع التعجب كما أخبر الله تعالى عن الأمم السالفة إذ قالوا ما أنتم إلا بشر مثلنا وقالوا أنؤمن لبشرين مثلنا ولئن أطعتم بشرا مثلكم إنكم إذا لخاسرون فتعجبوا من أن يفوز برتبة الرسالة والوحي والقرب من الله تعالى بشر مثلهم فحسدوهم وأحبوا زوال النبوة عنهم جزعا أن يفضل عليهم من هو مثلهم في الخلقة لا عن قص", "english": "I say: God is Knower of what is in the breasts. {«إِنْ تَمْسَسْكُمْ حَسَنَةٌ تَسُؤْهُمْ»} — \"If good touches you, it grieves them\" {«وَدُّوا مَا عَنِتُّمْ قَدْ بَدَتِ الْبَغْضَاءُ مِنْ أَفْوَاهِهِمْ وَمَا تُخْفِي صُدُورُهُمْ أَكْبَرُ»} — \"They wish for your hardship; hatred has already appeared from their mouths, and what their breasts conceal is greater.\" And envy (ḥasad), arising from hatred, may lead to contention, mutual fighting, and the spending of one's entire life in removing another's blessing through stratagems, slander, the tearing of veils, and whatever runs in that course.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 722", "section_title_en": "The Revival of the Religious Sciences — Book on the Rebuke of the Self: The Seven Causes of Envy (Section 722)", "section_index": 722, "anchors": "- Root: سبب (sabab)\n  * Lisan / Ayn: The rope by which one climbs; every means by which one reaches a thing.\n  * Al-Raghib (Mufradat): \"Every means by which one arrives at something is called a sabab\" — thus the causes enumerated here are the psychological \"ropes\" by which envy ascends in the soul.\n  * Al-Zamakhshari (Asas): Literal: a physical cord. Metaphorical: any linkage or occasion — here, the inward occasions (asbāb) that give rise to ḥasad.\n- Root: بغض (bughḍ)\n  * Lisan / Ayn: Hatred, aversion of the heart.\n  * Al-Raghib (Mufradat): The opposite of love (maḥabbah); a disposition of the heart toward another's harm.\n  * Al-Zamakhshari (Asas): Literal: inner aversion. Metaphorical: its \"appearance from the mouths\" (Quranic) as outward speech betraying the concealed hatred.\n- Root: كبر (kibr)\n  * Lisan / Ayn: Greatness; pride; disdain.\n  * Al-Raghib (Mufradat): \"Al-kabīr and al-ṣaghīr are relative terms\" — pride is the claim to greatness relative to another, deeming oneself above him.\n  * Al-Zamakhshari (Asas): Literal: bigness in stature or age. Metaphorical: \"takabbara 'alayhi\" — to deem oneself greater than another and refuse submission to him.\n- Root: قصد (qaṣd)\n  * Lisan / Ayn: Straightness of path; intending a goal.\n  * Al-Raghib (Mufradat): \"Al-qaṣd: istiqāmat al-ṭarīq\" — the straight road; also moderation between extremes.\n  * Al-Zamakhshari (Asas): Literal: to head toward a place. Metaphorical: \"maqāṣid\" — the aims and objectives toward which one directs oneself; here, the worldly goals whose pursuit breeds rivalry and envy.\n- Root: نزل (nazal)\n  * Lisan / Ayn: To descend from a height; to alight.\n  * Al-Raghib (Mufradat): \"Al-nuzūl fī al-aṣl huwa inḥiṭāṭ min 'uluww\" — descent from above; the sending down of revelation.\n  * Al-Zamakhshari (Asas): Literal: descending from a high place. Metaphorical: \"anzala Allāhu al-kitāb\" — God's sending down of the Quran; and \"mā unzila\" — what was revealed, as in the Quranic citation regarding the Qurashites' objection to revelation upon a mere human.\n- Sibawayh Rule: Rule of Causal Coordination (al-'aṭf al-sababī) — The enumeration of the seven causes proceeds by coordinated clauses (fa-... thumma ...), each introduced as an independent proposition linked by causation (sabab), requiring the translator to preserve the logical sequence of psychological motivations without collapsing them into one another.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "32": [{"arabic": "بقوله تعالى: {نحن قسمنا بينهم معيشتهم في الحياة الدنيا ورفعنا بعضهم فوق بعض درجات ليتخذ بعضهم بعضا سخريا} فإن قيل: لا حاجة إلى تقدير عموم التحريم حتى لا يبقى حلال فإن ذلك غير واقع وهو معلوم ولا شك في أن البعض حرام وذلك البعض هو الأقل أو الأكثر فيه نظر وما ذكرتموه من أنه الأقل بالإضافة إلى الكل جلي ولكن لا بد من دليل محصل على تجويزه ليس من المصالح المرسلة وما ذكرتموه من التقسيمات كلها مصالح مرسلة فلا بد لها من شاهد معين تقاس عليه حتى يكون الدليل مقبولا بالاتفاق فإن بعض العلماء لا يقبل المصالح المرسلة فأقول: إن سلم أن الحرام هو الأقل فيكفينا برهانا عصر", "english": "For the craftsmen are only subjugated so that the kingdom may be ordered for the kings. Likewise, those who turn toward the worldly life are subjugated so that the path of religion may be secured for the people of religion — and it is the kingdom of the Hereafter. And were it not for them, the religion of the people of religion would not be secured either. Thus the condition for the soundness of their religion is that the majority turn away from their path and occupy themselves with the affairs of the world. And that is a division preceded by the eternal will (al-mashīʾah al-azaliyyah). And to it points His saying, exalted: {«نَحْنُ قَسَمْنَا بَيْنَهُم مَّعِيشَتَهُمْ فِي الْحَيَاةِ الدُّنْيَا وَرَفَعْنَا بَعْضَهُمْ فَوْقَ بَعْضٍ دَرَجَاتٍ لِّيَتَّخِذَ بَعْضُهُم بَعْضًا سُخْرِيًّا»} (\"We have apportioned among them their livelihood in the life of this world, and raised some of them above others in degrees, that some of them may take others in service\") [al-Zukhruf 43:32].", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 355", "section_title_en": "On the Permissibility of Dealing with Unlawful Wealth in Times of General Corruption — Section 355", "section_index": 355, "anchors": "- Root: رسل (R-S-L)\n  * Lisan / Ayn: Core meaning of sending forth gently, dispatch with ease; a messenger (rasūl) is one sent forth.\n  * Al-Raghib (Mufradat): Root denotes being sent forth with deliberation and ease; from it derives the concept of the messenger, and metaphorically gentleness (rifq) — \"upon your gentleness\" (ʿalā rislika).\n  * Al-Zamakhshari (Asas): Literal: sending a message or messenger. Metaphorical: \"God sent upon them punishment\" — the unleashing of divine decree; \"the arrows are the messengers of death\" — the instrumentality of created causes in executing ordained ends.\n- Root: صلح (S-L-Ḥ)\n  * Lisan / Ayn: Rightness, soundness, the opposite of corruption (fasād).\n  * Al-Raghib (Mufradat): Ṣalāḥ is the opposite of fasād, applied predominantly to acts; the Quran contrasts it with corruption and with evil deeds. The term ṣulḥ specifically concerns removing discord between people.\n  * Al-Zamakhshari (Asas): Literal: \"his condition became sound\"; \"I repaired the sandal.\" Metaphorical: \"this leather is suitable for the sandal\" — fitness for a purpose; \"he did good to his beast\" — beneficence and care.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereignty; to have power over something.\n  * Al-Raghib (Mufradat): Al-Mulk is one who disposes by command and prohibition over a people — specifically governance of rational beings. Two types: possession/assumption of authority, and the power/capacity for it whether or not exercised.\n  * Al-Zamakhshari (Asas): Literal: \"he possessed the thing and owned it\"; \"to God belongs the Kingdom and the Dominion.\" Metaphorical: \"he married the woman\" (malaka al-mar'ah); \"he mastered himself at the moment of anger\" — self-possession as dominion over one's own faculties.\n- Root: دنا (D-N-W)\n  * Lisan / Ayn: Nearness, proximity; the lower world (dunyā) named for its nearness to us.\n  * Al-Raghib (Mufradat): Al-Dunūw is proximity by essence or by judgment, used of place, time, and station. The \"nearer\" (adnā) sometimes means the lesser, contrasted with the greater.\n  * Al-Zamakhshari (Asas): Literal: proximity in space or rank. Metaphorical: the dunyā as that which is low and base (danīʾ) — the world as the inferior realm contrasted with the Hereafter.\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication)\n  * Governing Rule: When the particle innamā precedes a clause, it restricts the predicate to the subject alone, negating any extension beyond it. This is operative in the author's argument that the way of complete scrupulousness (al-waraʿ) is restricted to the fifth probability alone, and that the fourth probability is the one determined for legal ruling (fatwā) — each restricted to its proper domain.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'The Lawful and Prohibited'", "badge": "Hadith"}, {"arabic": "وأصل هذا كله الحسد ثم نظرت إلى قول الله عز وجل نحن قسمنا بينهم معيشتهم في الحياة الدنيا فتركت الحسد واجتنبت الخلق وعلمت أن القسمة من عند الله سبحانه وتعالى فتركت عداوة الخلق عني السادسة نظرت إلى هذا الخلق يبغي بعضهم على بعض ويقاتل بعضهم بعضا فرجعت إلى قول الله عز وجل إن الشيطان لكم عدو فاتخذوه عدوا فعاديته وحده واجتهدت في أخذ حذري منه لأن الله تعالى شهد عليه أنه عدو لي فتركت عداوة الخلق غيره السابعة نظرت إلى هذا الخلق فرأيت كل واحد منهم يطلب هذه الكسرة فيذل فيها نفسه ويدخل فيما لا يحل له ثم نظرت إلى قوله تعالى وما من دابة في الأرض إل", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "Book of Knowledge", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "يتيم كيف بعثه الله إلينا فقال تعالى {أهم يقسمون رحمة ربك} وقال الله تعالى {ليقولوا أهؤلاء من الله عليهم من بيننا} أي استحقارا لهم واستبعادا لتقدمهم وقالت قريش لرسول الله صلى الله عليه وسلم كيف نجلس إليك وعندك هؤلاء وأشاروا إلى فقراء المسلمين فازدروهم بأعينهم لفقرهم وتكبروا عن مجالستهم فأنزل الله تعالى {ولا تطرد الذين يدعون ربهم بالغداة والعشي} إلى قوله {ما عليك من حسابهم} وقال تعالى {واصبر نفسك مع الذين يدعون ربهم بالغداة والعشي يريدون وجهه ولا تعد عيناك عنهم تريد زينة الحياة الدنيا} // حديث قالت قريش لرسول", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "35": [{"arabic": "وعظمت منزلته فقال صلى الله عليه وسلم {وإن كل ذلك لما متاع الحياة الدنيا والآخرة عند ربك للمتقين} إن العاقل هو المتقي وإن كان في الدنيا خسيسا ذليلا (4) قال صلى الله عليه وسلم في حديث آخر إنما العاقل من آمن بالله وصدق رسله وعمل بطاعته (5) ويشبه أن يكون أصل الاسم في أصل اللغة لتلك الغريزة وكذلك في الاستعمال وإنما أطلق على العلوم من حيث إنها ثمرتها كما يعرف الشيء بثمرته فيقال العلم هو الخشية والعالم من يخشى الله تعالى فإن الخشية ثمرة العلم فتكون كالمجاز لغير تلك الغريزة ولكن ليس الغرض البحث عن اللغة والمقصود أن هذه الأقسام الأربعة موجودة وال", "english": "I say: Know that the washing of the eye is forbidden — that is, the eye of insight (ʿayn al-baṣīrah) is not to be washed with the water of blind imitation and mere hearsay, for it is the organ by which the realities of the intellect are disclosed. And the divisions of what the name \"intellect\" (al-ʿaql) is applied to have become clear: it is said of the inborn faculty (al-gharīzah), and it is said of the knowledge that is acquired through that faculty, and it is said of the state of that knowledge when it governs the soul, and it is said of the very actions that proceed from that governance.", "book_title": "Book of Knowledge", "section_title_ar": "Section 68", "section_title_en": "The Washing of the Eye is Forbidden — On the True Meaning of Intellect (ʿAql) and Its Divisions", "section_index": 68, "anchors": "- Root: عقل (ʿAql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back — the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — al-ʿaql is said of the faculty prepared to receive knowledge, and it is also said of the knowledge acquired by that faculty. It is the instrument of divine discernment and the locus of taklīf (moral responsibility).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the inborn faculty of discernment. Metaphorical (Majaz): \"نخلة لا تعقل الإبار إذا لم تقبله\" — a palm tree that does not accept pollination is said to be \"not to ʿaqil\" the pollen, extending the root to the sense of \"accepting/receiving.\" Thus, knowledge is called ʿaql metaphorically as its fruit.\n- Root: بصر (Baṣar)\n  * Lisan / Ayn: Sight, perception — both of the eye and of the heart.\n  * Al-Raghib (Mufradat): \"البصر يقال للجارحة الناظرة... ويقال لقوة القلب المدركة: بصيرة وبصر\" — baṣar is said of the seeing organ, and of the perceiving power of the heart: baṣīrah and baṣar. The inner sight (baṣīrah) perceives immaterial realities.\n  * Al-Zamakhshari (Asas): Literal: ocular vision. Metaphorical: \"هذه آية مبصرة\" — this is an illuminating sign; \"واجعلني بصيرة عليهم أي رقيبا وشاهدا\" — make me a watcher over them. The inner eye perceives what the outer eye cannot.\n- Root: فطر (Faṭara)\n  * Lisan / Ayn: To split, cleave, originate, create — the primordial act of divine creation.\n  * Al-Raghib (Mufradat): \"أصل الفطر: الشق طولا... وفطر الله الخلق\" — the root is splitting lengthwise; God's \"fatr\" of creation is His originating of things. \"فطرة الله التي فطر الناس عليها\" — the primordial disposition upon which God originated mankind.\n  * Al-Zamakhshari (Asas): Literal: \"فطر الله الخلق، وهو فاطر السموات: مبتدعها\" — God originated creation; He is the Originator of the heavens. \"وكل مولود يولد على الفطرة\" — every newborn is born upon the fiṭrah, i.e., the innate disposition receptive to the religion of truth.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: Self, soul, spirit; the innermost reality of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: تعلم ما في نفسي ولا أعلم ما في نفسك\" — nafs is the spirit/soul; \"You know what is in my nafs and I know not what is in Your nafs\" — the nafs is the seat of inner assent and recognition.\n  * Al-Zamakhshari (Asas): Literal: the self. Metaphorical: \"دفق نفسه أي دمه\" — he poured out his nafs, i.e., his blood. The nafs is the locus of the primordial covenant (mīthāq).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The construction \"إنما العاقل من آمن بالله\" restricts the predicate: the intellect is not merely a faculty of cleverness but is defined by its fruit — faith and God-consciousness (taqwā).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "36": [{"arabic": "يدرك بقي مع المحرومين في أسفل السافلين ومن يعش عن ذكر الرحمن نقيض له شيطانا فهو له قرين بيان الدواء الذي ينفي مرض الحسد عن القلب اعلم أن الحسد من الأمراض العظيمة للقلوب ولا تداوى أمراض القلوب إلا بالعلم والعمل والعلم النافع لمرض الحسد هو أن تعرف تحقيقا أن الحسد ضرر عليك في الدنيا والدين وأنه لا ضرر فيه على المحسود في الدنيا والدين بل ينتفع به فيهما ومهما عرفت هذا عن بصيرة ولم تكن عدو نفسك وصديق عدوك فارقت الحسد لا محالة أما كونه ضررا عليك في الدين فهو أنك بالحسد سخطت قضاء الله تعالى وكرهت نعمته التي قسمها بين عباده وعدله الذي", "english": "As for its being a harm upon the envied one in his religion and his worldly life — it is clear that the blessing does not depart from him through your envy. Rather, whatever Allah — exalted be He — has decreed of prosperity and blessing, it must endure until an appointed term unknown to us, which Allah — glorified be He — has measured. There is no stratagem to repel it, for everything with Him is by measure (miqdār), and for every term there is a book (kitāb). {«لكل أجل كتاب»} \"For every term there is a decree.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 725", "section_title_en": "The Remedy That Expels the Disease of Envy from the Heart — Section 725", "section_index": 725, "anchors": "- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Core meaning — wishing for removal of a blessing from its possessor; the root also carries the sense of \"grudging malice\" that consumes the envier himself.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — Envy is the wish for the removal of a blessing from one who deserves it, sometimes accompanied by striving to effect its removal. The believer envies not but rather admires (ghibṭah); the hypocrite envies.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — envy is directed at another's blessing; metaphorically (majāz), envy \"eats the body\" as fire eats wood, indicating its self-destructive spiritual physiology.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart as that which is ever-turning, overturning, and fluctuating between states.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — To turn a thing from one face to another; the heart's diseases are its deviations from its original sound disposition (fiṭrah).\n  * Al-Zamakhshari (Asas): Literal — turning a thing over; metaphorical — \"رجل قلب\" (a man who turns matters over) i.e., one who examines affairs with penetrating insight, as the physician of hearts must do.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Blessing, well-being, graciousness; the state of being in a condition of good.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — Blessing is the good state; it is a genus term applying to both little and much. Divine blessings are distributed by divine decree (qadar), and envy is resentment against that distribution.\n  * Al-Zamakhshari (Asas): Literal — the act of bestowing; metaphorical — \"خفت نعامتهم\" (their ostriches departed) i.e., their blessings vanished, illustrating that blessings flee from the envier while remaining with the envied.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic sentence structure here employs extended conditional and causal chains (law-lā, fa-in, fa-innaka) where the apodosis is delayed by embedded justificatory clauses, requiring the translator to preserve the logical subordination without collapsing the rhetorical tension.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "53": [{"arabic": "وقال فرعون فيما أخبر الله عنه {أو جاء معه الملائكة مقترنين} وقال الله تعالى {واستكبر هو وجنوده في الأرض بغير الحق} فتكبر هو على الله وعلى رسله جميعا قال وهب قال له موسى عليه السلام آمن ولك ملكك قال حتى أشاور هامان فشاور هامان فقال هامان بينما أنت رب يعبد إذ صرت عبد تعبد فاسنكف عن عبودية الله وعن اتباع موسى عليه السلام وقالت قريش فيما أخبر الله تعالى عنهم {لولا نزل هذا القرآن على رجل من القريتين عظيم} قال قتاده عظيم القريتين هو الوليد بن المغيرة وأبو مسعود الثقفي طلبوا من هو أعظم رياسة من النبي صلى الله عليه وسل", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "58": [{"arabic": "ضربوه لك إلا جدلا بل هم قوم خصمون وفي الحديث في معنى قوله تعالى {فأما الذين في قلوبهم زيغ} الآية هم أهل الجدل الذين عناهم الله بقوله تعالى فاحذرهم (2) وقال بعض السلف يكون في آخر الزمان قوم يغلق عليهم باب العمل ويفتح لهم باب الجدل وفي بعض الأخبار إنكم في زمان ألهمتم فيه العمل وسيأتي قوم يلهمون الجدل (3) وفي الخبر المشهور أبغض الخلق إلى الله تعالى الألد الخصم (4) وفي الخبر ما أتى قوم المنطق إلا منعوا العمل (5) والله أعلم", "english": "This speech, perhaps, when heard from its speaker, prompts the saying: \"People are enemies of what they do not know.\" So do not think that [of me] — for you have fallen upon one who is an expert (khabīr). Accept this counsel from one who wasted his life upon it for a time, and exceeded the earlier ones in composing, verifying, disputing, and elucidating — then God inspired him with his right course and showed him its defect, so he abandoned it and occupied himself with his own soul. Let not the saying of him who says, \"The legal opinion (al-fatwā) is the pillar of the Sacred Law, and its rationales (ʿilal) are not known except through the science of disputation (ʿilm al-khilāf),\" deceive you. For the rationales of the [established] school (al-madhhab) are mentioned within the school itself; and what is added upon them are disputations that the earlier ones — nor even the Companions — ever knew, and they were more knowledgeable of the rationales of legal opinions than others. Rather, these [disputations], besides being useless for the science of the school, are harmful and corrupting of the very taste (dhawq) of jurisprudence. For that which the intuition (hads) of the muftī testifies to — when his taste in jurisprudence is sound — cannot, in most cases, be made to conform to the conditions of formal disputation (shurūṭ al-jadal). Whoever accustoms his nature to the formalities of disputation, his mind submits to the requirements of disputation and shrinks from submitting to the taste of jurisprudence.", "book_title": "Book of Knowledge", "section_title_ar": "Section 34", "section_title_en": "On the Soul — A Warning Against the Newly-Invented Disputations (Section 34)", "section_index": 34, "anchors": "- Root: جدل (j-d-l)\n  * Lisan / Ayn: To twist or braid a rope tightly; to throw someone down upon hard ground (al-jadālah).\n  * Al-Raghib (Mufradat): Disputation (jadal) is a mutual exchange aimed at overcoming and prevailing — as if each disputant twists the other away from his opinion; from jadala al-ḥabl, to braid tightly.\n  * Al-Zamakhshari (Asas): Literal: twisting/braiding; Metaphorical: a woman \"majdūlah al-khalq\" (well-knit in frame), and \"disputation\" as a wrestling-down of the opponent's view.\n- Root: خبر (kh-b-r)\n  * Lisan / Ayn: Knowledge of a thing; to be acquainted with the inner state of an affair.\n  * Al-Raghib (Mufradat): Khabar is knowledge of things via report; khibrah is knowledge of the inner realities of a matter.\n  * Al-Zamakhshari (Asas): Literal: to test/try a man; Metaphorical: \"his mirror reports of his unknown state\" — knowledge of hidden conditions.\n- Root: وفي (w-f-y)\n  * Lisan / Ayn: To fulfill completely, to reach full measure.\n  * Al-Raghib (Mufradat): Al-Wāfī: one who has reached completion; awfā bi-ʿahdihi: to fulfill one's covenant entirely.\n  * Al-Zamakhshari (Asas): Literal: full-weight coin, full measure; Metaphorical: awfā ʿalā al-miʾah — to exceed a hundred; tawaffāhu Allāh — God takes in full.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: A mark/trace by which a thing is known; knowledge as the apprehension of a thing's reality.\n  * Al-Raghib (Mufradat): ʿIlm is the apprehension of a thing in its true reality — either grasping its essence or judging its existence/non-existence.\n  * Al-Zamakhshari (Asas): Literal: to perceive/know; Metaphorical: \"he is among the lofty banners (aʿlām) of knowledge\" — a distinguished signpost of learning.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa-l-taqyīd bi-innamā) — used to confine the blame of disputation to those who seek fame, and to restrict true benefit to sincere works.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "66": [{"arabic": "عليه شيء مما يسرون وما يعلنون وحذرهم أن يأخذهم بغتة وهم لا يشعرون فقال {ما ينظرون إلا صيحة واحدة تأخذهم وهم يخصمون فلا يستطيعون توصية ولا إلى أهلهم يرجعون} والصلاة والسلام على محمد رسوله الذي يسير تحت لوائه النبيون وعلى آله وأصحابه الأئمة المهديين والسادة المرضيين صلاة يوازي عددها عدد ما كان من خلق الله وما سيكون ويحظى ببركتها الأولون والآخرون وسلم تسليما كثيرا أما بعد فإن الغضب شعلة نار اقتبست من نار الله الموقدة التي تطلع على الأفئدة وإنها لمستكنة في طي الفؤاد استكنان الجمر تحت الرماد ويستخرجه الكبر الدفي", "english": "In the name of God, the Most Merciful, the Most Compassionate. Praise be to God, upon whose pardon and mercy none rely except the hopeful, and from whose evil wrath and assault none fear except the fearful — He who gradually seizes His servants from whence they know not, and who has given dominion over them to their lusts, commanding them to abandon what they desire, and who has tried them with anger while charging them to swallow their rage in what provokes them. Then He surrounded them with hardships and pleasures, and granted them respite to see how they would act. He tested their love through them, to make known the truth of what they claim. He made known to them that nothing is hidden from Him of what they conceal or proclaim, and warned them lest He seize them suddenly while they are unaware. For He said: {«They await but a single blast which will seize them while they are disputing; so they will not be able to make a bequest, nor to their families will they return»} (Q. 36:49-50). And prayers and peace be upon Muhammad, His Messenger, beneath whose banner the prophets walk, and upon his family and companions — the rightly-guided imams and the pleasing masters — prayers whose number equals the number of what has been of God's creation and what will be, and by whose blessing the first and the last are favored — and abundant peace.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 700", "section_title_en": "The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences", "section_index": 700, "anchors": "- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "67": [{"arabic": "المؤمنون إخوة} وداخلون في مقتضى قوله تعالى {الأخلاء يومئذ بعضهم لبعض عدو إلا المتقين} الوظيفة الثانية أن يقتدى بصاحب الشرع صلوات الله عليه وسلامه فلا يطلب على إفادة العلم أجرا ولا يقصد به جزاء ولا شكرا بل يعلم لوجه الله تعالى وطلبا للتقرب إليه ولا يرى لنفسه منة عليهم وإن كانت المنة لازمة عليهم بل يرى الفضل لهم إذ هذبوا قلوبهم لأن تتقرب إلى الله تعالى بزراعة العلوم فيها كالذي يعيرك الأرض لتزرع فيها لنفسك زراعة فمنفعتك بها تزيد على منفعة صاحب الأرض فكيف تقلده منه وثوابك في التعليم أكثر من ثواب المتعلم عند الله تعالى ولولا المتعلم", "english": "And those who turn aside to seek leadership (al-riyāsah) through the sciences have departed from the requirement of His saying, Exalted: {«The believers are but brothers»} (al-Ḥujurāt 49:10), and have entered into the implication of His saying, Exalted: {«Intimate friends on that Day will be enemies to one another, except the God-fearing»} (al-Zukhruf 43:67).", "book_title": "Book of Knowledge", "section_title_ar": "Section 46", "section_title_en": "The Duties of the Teacher — Section 46: On the Teacher's Sincerity, His Conduct Toward Students, and the Signs of Those Who Seek the World Through Knowledge", "section_index": 46, "anchors": "- Root: قصد (qaṣada)\n  * Lisan / Ayn: Core meaning of \"intending, aiming toward, taking the straight path to a goal\"; al-Ayn notes its use in aiming at a target.\n  * Al-Raghib (Mufradat): \"Al-Qaṣd: the straightness of the path... al-iqtiṣād (moderation) is praiseworthy absolutely, as in generosity between extravagance and miserliness.\"\n  * Al-Zamakhshari (Asas): Literal: \"I intended him and intended for him\" (physical direction). Metaphorical: \"He was moderate in his livelihood... he who does not exceed the limit in a matter and is content with the middle way.\"\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge as the perception of a thing's reality; al-Ayn traces its verbal forms across perception and knowing.\n  * Al-Raghib (Mufradat): \"Al-ʿIlm: the apprehension of a thing by its true reality... two kinds: apprehension of the essence of a thing, and judgment upon a thing.\"\n  * Al-Zamakhshari (Asas): Literal: \"He was a sign (ʿalam) of knowledge.\" Metaphorical: \"The landmarks (maʿālim) of the road\" — the traces by which one is guided.\n- Root: أخل (akhala)\n  * Lisan / Ayn: \"Al-Akhillāʾ: intimate friends (pl. of khalīl).\" Al-Ayn: \"Al-Maʾlaka: the message, because it is chewed (yuʾlak) in the mouth.\"\n  * Al-Raghib (Mufradat): \"Al-Khullāh: sincere friendship... {«Intimate friends on that Day will be enemies to one another, except the God-fearing»} (al-Zukhruf 43:67).\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"Innamā\" restricts the predicate to the subject alone, excluding all else; used here to delimit the brotherhood of believers and the enmity of the wicked on the Day of Judgment.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "77": [{"arabic": "وما دعاء الكافرين إلا في ضلال قال فيقولون ادعوا مالكا فيدعون فيقولون يا مالك ليقض علينا ربك قال فيجيبهم إنكم ماكثون (4) قال الأعمش أنبئت أن بين دعائهم وبين إجابة مالك إياهم ألف عام قال فيقولون ادعوا ربكم فلا أحد خير من ربكم فيقولون ربنا غلبت علينا شقوتنا وكنا قوما ضالين ربنا أخرجنا منها فإن عدنا فإنا ظالمون قال فيجيبهم اخسئوا فيها ولا تكلمون {قال}", "english": "And ʿAlī, may God honor his face, said: The Messenger of God, may God bless him and grant him peace, said: \"Seek refuge in God from the Pit of Sorrow, or the Valley of Sorrow.\" It was said: \"O Messenger of God, what is the Valley or Pit of Sorrow?\" He said: \"A valley in Hell from which Hell itself seeks refuge with God seventy times each day. God, the Exalted, has prepared it for the reciters who show off.\" (2)", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1349", "section_title_en": "The Vastness of Hellfire, Its Depths, and the Torments of Its Inhabitants", "section_index": 1349, "anchors": "- Root: و د ي (w-d-y)\n  * Lisan / Ayn: A valley; a place where torrents flow. In the lexicon, it denotes a lowland or watercourse between mountains.\n  * Al-Raghib (Mufradat): Used for the valleys of Hell as places of confinement and passage, each containing further branching ravines (شُعَب), indicating graded descent.\n  * Al-Zamakhshari (Asas): Literal for earthly valleys; here transferred (majāz) to the topographical reality of Hell, affirming its corporeal vastness.\n- Root: ع م ق (ʿ-m-q)\n  * Lisan / Ayn: Depth; the far bottom of a well or pit. Al-Farahidi: \"العمق: قعر البئر ونحوها.\"\n  * Al-Raghib (Mufradat): Depth as a measure of descent; in the Hereafter, it is unbounded, paralleling the unbounded depth of worldly desire.\n  * Al-Zamakhshari (Asas): Literal for physical depth; here extended to show the infinite regress of punishment corresponding to infinite craving.\n- Root: غ س ق (gh-s-q)\n  * Lisan / Ayn: Stinking, foul pus or ichor that flows from the skin of the damned; also intense darkness.\n  * Al-Raghib (Mufradat): Al-Ghassāq is the putrid effusion of Hell, a punishment for the senses, specifically for drinking when the damned cry out in thirst.\n  * Al-Zamakhshari (Asas): Literal for what is loathsome and fetid; in the Quranic context, it is the designated drink of the inhabitants.\n- Root: ز ق م (z-q-m)\n  * Lisan / Ayn: To swallow with difficulty; the tree of Zaqqūm, which grows in the depths of Hell.\n  * Al-Raghib (Mufradat): A specific tree in Hell whose fruit is like the heads of devils, eaten by the damned to fill their bellies, causing choking and agony.\n  * Al-Zamakhshari (Asas): Literal for a real tree; its description is sensory, not metaphorical, affirming the physical reality of punishment.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of \"في جهنم سبعين ألف واد\" allows the prepositional phrase to precede the subject for emphasis, establishing the spatial setting before detailing its contents.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Remembrance of Death and Afterlife'", "badge": "Du'a"}], "87": [{"arabic": "ولذلك قال تعالى ولئن سألتهم من خلقهم ليقولن الله معناه إن اعتبرت أحوالهم شهدت بذلك نفوسهم وبواطنهم فطرة الله التي فطر الناس عليها أي كل آدمي فطر على الإيمان بالله عز وجل بل على معرفة الأشياء على ما هي عليه أعني أنها كالمضمنة فيها لقرب استعدادها للإدراك ثم لما كان الإيمان مركوزا في النفوس بالفطرة انقسم الناس إلى قسمين إلى من أعرض فنسي وهم الكفار وإلى من أجال خاطره فتذكر فكان كمن حمل شهادة فنسيها بغفلة ثم تذكرها ولذلك قال عز وجل لعلهم يتذكرون وليتذكر أولوا الألباب واذكروا نعمة الله عليكم وميثاقه", "english": "I say: Know that the washing of the eye is forbidden — that is, the eye of insight (ʿayn al-baṣīrah) is not to be washed with the water of blind imitation and mere hearsay, for it is the organ by which the realities of the intellect are disclosed. And the divisions of what the name \"intellect\" (al-ʿaql) is applied to have become clear: it is said of the inborn faculty (al-gharīzah), and it is said of the knowledge that is acquired through that faculty, and it is said of the state of that knowledge when it governs the soul, and it is said of the very actions that proceed from that governance.", "book_title": "Book of Knowledge", "section_title_ar": "Section 68", "section_title_en": "The Washing of the Eye is Forbidden — On the True Meaning of Intellect (ʿAql) and Its Divisions", "section_index": 68, "anchors": "- Root: عقل (ʿAql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back — the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — al-ʿaql is said of the faculty prepared to receive knowledge, and it is also said of the knowledge acquired by that faculty. It is the instrument of divine discernment and the locus of taklīf (moral responsibility).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the inborn faculty of discernment. Metaphorical (Majaz): \"نخلة لا تعقل الإبار إذا لم تقبله\" — a palm tree that does not accept pollination is said to be \"not to ʿaqil\" the pollen, extending the root to the sense of \"accepting/receiving.\" Thus, knowledge is called ʿaql metaphorically as its fruit.\n- Root: بصر (Baṣar)\n  * Lisan / Ayn: Sight, perception — both of the eye and of the heart.\n  * Al-Raghib (Mufradat): \"البصر يقال للجارحة الناظرة... ويقال لقوة القلب المدركة: بصيرة وبصر\" — baṣar is said of the seeing organ, and of the perceiving power of the heart: baṣīrah and baṣar. The inner sight (baṣīrah) perceives immaterial realities.\n  * Al-Zamakhshari (Asas): Literal: ocular vision. Metaphorical: \"هذه آية مبصرة\" — this is an illuminating sign; \"واجعلني بصيرة عليهم أي رقيبا وشاهدا\" — make me a watcher over them. The inner eye perceives what the outer eye cannot.\n- Root: فطر (Faṭara)\n  * Lisan / Ayn: To split, cleave, originate, create — the primordial act of divine creation.\n  * Al-Raghib (Mufradat): \"أصل الفطر: الشق طولا... وفطر الله الخلق\" — the root is splitting lengthwise; God's \"fatr\" of creation is His originating of things. \"فطرة الله التي فطر الناس عليها\" — the primordial disposition upon which God originated mankind.\n  * Al-Zamakhshari (Asas): Literal: \"فطر الله الخلق، وهو فاطر السموات: مبتدعها\" — God originated creation; He is the Originator of the heavens. \"وكل مولود يولد على الفطرة\" — every newborn is born upon the fiṭrah, i.e., the innate disposition receptive to the religion of truth.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: Self, soul, spirit; the innermost reality of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: تعلم ما في نفسي ولا أعلم ما في نفسك\" — nafs is the spirit/soul; \"You know what is in my nafs and I know not what is in Your nafs\" — the nafs is the seat of inner assent and recognition.\n  * Al-Zamakhshari (Asas): Literal: the self. Metaphorical: \"دفق نفسه أي دمه\" — he poured out his nafs, i.e., his blood. The nafs is the locus of the primordial covenant (mīthāq).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The construction \"إنما العاقل من آمن بالله\" restricts the predicate: the intellect is not merely a faculty of cleverness but is defined by its fruit — faith and God-consciousness (taqwā).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 10, 3800]], "43:1": [[1, 10, 3800]], "2": [[1, 320, 1555], [2, 1555, 2660]], "43:2": [[1, 320, 1555], [2, 1555, 2660]], "3": [[1, 150, 1181], [2, 1181, 2187], [3, 2187, 3428], [4, 3428, 5143], [5, 5143, 6284], [6, 6284, 7610]], "43:3": [[1, 150, 1181], [2, 1181, 2187], [3, 2187, 3428], [4, 3428, 5143], [5, 5143, 6284], [6, 6284, 7610]], "4": [[1, 420, 1790], [2, 1790, 3467], [3, 3467, 4162], [4, 4162, 5215], [5, 5215, 6708], [6, 6708, 7945], [7, 7945, 9070]], "43:4": [[1, 420, 1790], [2, 1790, 3467], [3, 3467, 4162], [4, 4162, 5215], [5, 5215, 6708], [6, 6708, 7945], [7, 7945, 9070]], "5": [[1, 540, 1872], [2, 1872, 2750], [3, 2750, 3840], [4, 3840, 5090], [5, 5090, 5544], [6, 5544, 6370], [7, 6370, 7713], [8, 7713, 9510]], "43:5": [[1, 540, 1872], [2, 1872, 2750], [3, 2750, 3840], [4, 3840, 5090], [5, 5090, 5544], [6, 5544, 6370], [7, 6370, 7713], [8, 7713, 9510]], "6": [[1, 440, 1155], [2, 1155, 2455], [3, 2455, 2780], [4, 2780, 3755], [5, 3755, 4178], [6, 4178, 5990]], "43:6": [[1, 440, 1155], [2, 1155, 2455], [3, 2455, 2780], [4, 2780, 3755], [5, 3755, 4178], [6, 4178, 5990]], "7": [[1, 10, 943], [2, 943, 2305], [3, 2305, 2795], [4, 2795, 3713], [5, 3713, 4578], [6, 4578, 6078], [7, 6078, 6369], [8, 6369, 7990]], "43:7": [[1, 10, 943], [2, 943, 2305], [3, 2305, 2795], [4, 2795, 3713], [5, 3713, 4578], [6, 4578, 6078], [7, 6078, 6369], [8, 6369, 7990]], "8": [[1, 350, 2777], [2, 2777, 3486], [3, 3486, 4153], [4, 4153, 5268], [5, 5268, 6555], [6, 6555, 7085], [7, 7085, 8990]], "43:8": [[1, 350, 2777], [2, 2777, 3486], [3, 3486, 4153], [4, 4153, 5268], [5, 5268, 6555], [6, 6555, 7085], [7, 7085, 8990]], "9": [[1, 570, 1618], [2, 1618, 2758], [3, 2758, 3346], [4, 3346, 3962], [5, 3962, 5609], [6, 5609, 6933], [7, 6933, 8809], [8, 8809, 9995], [9, 9995, 11282], [10, 11282, 12570]], "43:9": [[1, 570, 1618], [2, 1618, 2758], [3, 2758, 3346], [4, 3346, 3962], [5, 3962, 5609], [6, 5609, 6933], [7, 6933, 8809], [8, 8809, 9995], [9, 9995, 11282], [10, 11282, 12570]], "10": [[1, 440, 1231], [2, 1231, 1766], [3, 1766, 2260], [4, 2260, 3051], [5, 3051, 3973], [6, 3973, 4904], [7, 4904, 5398], [8, 5398, 6551], [9, 6551, 7506], [10, 7506, 8618], [11, 8618, 9820]], "43:10": [[1, 440, 1231], [2, 1231, 1766], [3, 1766, 2260], [4, 2260, 3051], [5, 3051, 3973], [6, 3973, 4904], [7, 4904, 5398], [8, 5398, 6551], [9, 6551, 7506], [10, 7506, 8618], [11, 8618, 9820]], "11": [[1, 620, 2121], [2, 2121, 2903], [3, 2903, 3320], [4, 3320, 6067], [5, 6067, 8131], [6, 8131, 9007], [7, 9007, 10904], [8, 10904, 11300], [9, 11300, 12092], [10, 12092, 13656], [11, 13656, 14694], [12, 14694, 16270]], "43:11": [[1, 620, 2121], [2, 2121, 2903], [3, 2903, 3320], [4, 3320, 6067], [5, 6067, 8131], [6, 8131, 9007], [7, 9007, 10904], [8, 10904, 11300], [9, 11300, 12092], [10, 12092, 13656], [11, 13656, 14694], [12, 14694, 16270]], "12": [[1, 330, 1490], [2, 1490, 2030], [3, 2030, 3227], [4, 3227, 4250], [5, 4250, 5160], [6, 5160, 5643], [7, 5643, 6159], [8, 6159, 6860], [9, 6860, 8342], [10, 8342, 8938], [11, 8938, 10130]], "43:12": [[1, 330, 1490], [2, 1490, 2030], [3, 2030, 3227], [4, 3227, 4250], [5, 4250, 5160], [6, 5160, 5643], [7, 5643, 6159], [8, 6159, 6860], [9, 6860, 8342], [10, 8342, 8938], [11, 8938, 10130]], "13": [[1, 490, 2065], [2, 2065, 2943], [3, 2943, 4047], [4, 4047, 4612], [5, 4612, 6187], [6, 6187, 6880], [7, 6880, 7693], [8, 7693, 8549], [9, 8549, 9995], [10, 9995, 10808], [11, 10808, 13050], [12, 13050, 13971], [13, 13971, 14793], [14, 14793, 15497], [15, 15497, 16301], [16, 16301, 17229],