"ayah":17,"text":"وَإِذَا بُشِّرَ أَحَدُهُم بِمَا ضَرَبَ لِلرَّحْمَٰنِ مَثَلًا ظَلَّ وَجْهُهُۥ مُسْوَدًّا وَهُوَ كَظِيمٌ ","translation":"And when one of them is given good tidings of that which he attributes to the Most Merciful in comparison [i.e., a daughter], his face becomes dark, and he suppresses grief.","words":[{"id":1,"arabic":"وَإِذَا","translit":"āَhdِiʾَw","root":""},{"id":2,"arabic":"بُشِّرَ","translit":"َrِّhsُb","root":"بشر"},{"id":3,"arabic":"أَحَدُهُم","translit":"mُhُdَḥَaʾ","root":"احد"},{"id":4,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":5,"arabic":"ضَرَبَ","translit":"َbَrَḍ","root":"ضرب"},{"id":6,"arabic":"لِلرَّحْمَٰنِ","translit":"ِnَٰmْḥَّrlِl","root":"رحم"},{"id":7,"arabic":"مَثَلًا","translit":"āًlَhtَm","root":"مثل"},{"id":8,"arabic":"ظَلَّ","translit":"َّlَẓ","root":"ظلل"},{"id":9,"arabic":"وَجْهُهُۥ","translit":"ۥُhُhْjgَw","root":"وجه"},{"id":10,"arabic":"مُسْوَدًّا","translit":"āًّdَwْsُm","root":"سود"},{"id":11,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":12,"arabic":"كَظِيمٌ","translit":"ٌmyِẓَk","root":"كظم"}],"hasIhya":false},{"ayah":18,"text":"أَوَمَن يُنَشَّؤُا۟ فِى ٱلْحِلْيَةِ وَهُوَ فِى ٱلْخِصَامِ غَيْرُ مُبِينٍ ","translation":"So is one brought up in ornaments while being during conflict unevident[1] [attributed to Allāh]?","words":[{"id":1,"arabic":"أَوَمَن","translit":"nَmَwَaʾ","root":""},{"id":2,"arabic":"يُنَشَّؤُا۟","translit":"۟āُwʾَّhsَnُy","root":"نشا"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْحِلْيَةِ","translit":"ِẗَyْlِḥْlٱ","root":"حلي"},{"id":5,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْخِصَامِ","translit":"ِmāَṣِhkْlٱ","root":"خصم"},{"id":8,"arabic":"غَيْرُ","translit":"ُrْyَغ","root":"غير"},{"id":9,"arabic":"مُبِينٍ","translit":"ٍnyِbُm","root":"بين"}],"hasIhya":false},{"ayah":19,"text":"وَجَعَلُوا۟ ٱلْمَلَٰٓئِكَةَ ٱلَّذِينَ هُمْ عِبَٰدُ ٱلرَّحْمَٰنِ إِنَٰثًاۚ أَشَهِدُوا۟ خَلْقَهُمْۚ سَتُكْتَبُ شَهَٰدَتُهُمْ وَيُسْـَٔلُونَ ","translation":"And they described the angels, who are servants of the Most Merciful, as females. Did they witness their creation? Their testimony will be recorded, and they will be questioned.","words":[{"id":1,"arabic":"وَجَعَلُوا۟","translit":"۟āwُlَʿعَjgَw","root":"جعل"},{"id":2,"arabic":"ٱلْمَلَٰٓئِكَةَ","translit":"َẗَkِyʾَٰٓlَmْlٱ","root":"ملك"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":5,"arabic":"عِبَٰدُ","translit":"ُdَٰbِʿع","root":"عبد"},{"id":6,"arabic":"ٱلرَّحْمَٰنِ","translit":"ِnَٰmْḥَّrlٱ","root":"رحم"},{"id":7,"arabic":"إِنَٰثًا","translit":"āًhtَٰnِiʾ","root":"انث"},{"id":8,"arabic":"أَشَهِدُوا۟","translit":"۟āwُdِhَhsَaʾ","root":"شهد"},{"id":9,"arabic":"خَلْقَهُمْ","translit":"ْmُhَqْlَhk","root":"خلق"},{"id":10,"arabic":"سَتُكْتَبُ","translit":"ُbَtْkُtَs","root":"كتب"},{"id":11,"arabic":"شَهَٰدَتُهُمْ","translit":"ْmُhُtَdَٰhَhs","root":"شهد"},{"id":12,"arabic":"وَيُسْـَٔلُونَ","translit":"َnwُlَٔـْsُyَw","root":"سال"}],"hasIhya":false},{"ayah":20,"text":"وَقَالُوا۟ لَوْ شَآءَ ٱلرَّحْمَٰنُ مَا عَبَدْنَٰهُمۗ مَّا لَهُم بِذَٰلِكَ مِنْ عِلْمٍۖ إِنْ هُمْ إِلَّا يَخْرُصُونَ ","translation":"And they said, \"If the Most Merciful had willed, we would not have worshipped them.\" They have of that no knowledge. They are not but misjudging.","words":[{"id":1,"arabic":"وَقَالُوا۟","translit":"۟āwُlāَqَw","root":"قول"},{"id":2,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":3,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":4,"arabic":"ٱلرَّحْمَٰنُ","translit":"ُnَٰmْḥَّrlٱ","root":"رحم"},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"عَبَدْنَٰهُم","translit":"mُhَٰnْdَbَʿع","root":"عبد"},{"id":7,"arabic":"مَّا","translit":"āَّm","root":""},{"id":8,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":9,"arabic":"بِذَٰلِكَ","translit":"َkِlَٰhdِb","root":""},{"id":10,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":11,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":12,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":13,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":14,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":15,"arabic":"يَخْرُصُونَ","translit":"َnwُṣُrْhkَy","root":"خرص"}],"hasIhya":false},{"ayah":21,"text":"أَمْ ءَاتَيْنَٰهُمْ كِتَٰبًا مِّن قَبْلِهِۦ فَهُم بِهِۦ مُسْتَمْسِكُونَ ","translation":"Or have We given them a book before it [i.e., the Qur’ān] to which they are adhering?","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"ءَاتَيْنَٰهُمْ","translit":"ْmُhَٰnْyَtāَء","root":"اتي"},{"id":3,"arabic":"كِتَٰبًا","translit":"āًbَٰtِk","root":"كتب"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"قَبْلِهِۦ","translit":"ۦِhِlْbَq","root":"قبل"},{"id":6,"arabic":"فَهُم","translit":"mُhَf","root":""},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"مُسْتَمْسِكُونَ","translit":"َnwُkِsْmَtْsُm","root":"مسك"}],"hasIhya":false},{"ayah":22,"text":"بَلْ قَالُوٓا۟ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٍ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّهْتَدُونَ ","translation":"Rather, they say, \"Indeed, we found our fathers upon a religion, and we are in their footsteps [rightly] guided.\"","words":[{"id":1,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":2,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":3,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":4,"arabic":"وَجَدْنَآ","translit":"ٓāَnْdَjgَw","root":"وجد"},{"id":5,"arabic":"ءَابَآءَنَا","translit":"āَnَءٓāَbāَء","root":"ابو"},{"id":6,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":7,"arabic":"أُمَّةٍ","translit":"ٍẗَّmُaʾ","root":"امم"},{"id":8,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":9,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":10,"arabic":"ءَاثَٰرِهِم","translit":"mِhِrَٰhtāَء","root":"اثر"},{"id":11,"arabic":"مُّهْتَدُونَ","translit":"َnwُdَtْhُّm","root":"هدي"}],"hasIhya":true},{"ayah":23,"text":"وَكَذَٰلِكَ مَآ أَرْسَلْنَا مِن قَبْلِكَ فِى قَرْيَةٍ مِّن نَّذِيرٍ إِلَّا قَالَ مُتْرَفُوهَآ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَىٰٓ أُمَّةٍ وَإِنَّا عَلَىٰٓ ءَاثَٰرِهِم مُّقْتَدُونَ ","translation":"And similarly, We did not send before you any warner into a city except that its affluent said, \"Indeed, we found our fathers upon a religion, and we are, in their footsteps, following.\"","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":3,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"قَرْيَةٍ","translit":"ٍẗَyْrَq","root":"قري"},{"id":8,"arabic":"مِّن","translit":"nِّm","root":""},{"id":9,"arabic":"نَّذِيرٍ","translit":"ٍryِhdَّn","root":"نذر"},{"id":10,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":11,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":12,"arabic":"مُتْرَفُوهَآ","translit":"ٓāَhwُfَrْtُm","root":"ترف"},{"id":13,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":14,"arabic":"وَجَدْنَآ","translit":"ٓāَnْdَjgَw","root":"وجد"},{"id":15,"arabic":"ءَابَآءَنَا","translit":"āَnَءٓāَbāَء","root":"ابو"},{"id":16,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":17,"arabic":"أُمَّةٍ","translit":"ٍẗَّmُaʾ","root":"امم"},{"id":18,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":19,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":20,"arabic":"ءَاثَٰرِهِم","translit":"mِhِrَٰhtāَء","root":"اثر"},{"id":21,"arabic":"مُّقْتَدُونَ","translit":"َnwُdَtْqُّm","root":"قدو"}],"hasIhya":true},{"ayah":24,"text":"قَٰلَ أَوَلَوْ جِئْتُكُم بِأَهْدَىٰ مِمَّا وَجَدتُّمْ عَلَيْهِ ءَابَآءَكُمْۖ قَالُوٓا۟ إِنَّا بِمَآ أُرْسِلْتُم بِهِۦ كَٰفِرُونَ ","translation":"[Each warner] said, \