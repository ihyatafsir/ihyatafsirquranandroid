 43, "ayah": 50, "text": "فَلَمَّا كَشَفْنَا عَنْهُمُ اُ۬لْعَذَابَ إِذَا هُمْ يَنكُثُونَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَشَفْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْعَذَابَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَنكُثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 51, "text": "وَنَاد۪يٰ فِرْعَوْنُ فِے قَوْمِهِۦ قَالَ يَٰقَوْمِ أَلَيْسَ لِے مُلْكُ مِصْرَ وَهَٰذِهِ اِ۬لَانْهَٰرُ تَجْرِے مِن تَحْتِيَۖ أَفَلَا تُبْصِرُونَۖ", "words": [{"id": 1, "arabic": "وَنَاد۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَٰقَوْمِ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَلَيْسَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِے", "translit": "", "root": ""}, {"id": 9, "arabic": "مُلْكُ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِصْرَ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَهَٰذِهِ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬لَانْهَٰرُ", "translit": "", "root": ""}, {"id": 13, "arabic": "تَجْرِے", "translit": "", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "", "root": ""}, {"id": 15, "arabic": "تَحْتِيَۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "أَفَلَا", "translit": "", "root": ""}, {"id": 17, "arabic": "تُبْصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 52, "text": "أَمَ اَنَا خَيْرࣱ مِّنْ هَٰذَا اَ۬لذِے هُوَ مَهِينࣱ وَلَا يَكَادُ يُبِينُۖ", "words": [{"id": 1, "arabic": "أَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَهِينࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَكَادُ", "translit": "", "root": ""}, {"id": 11, "arabic": "يُبِينُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 53, "text": "فَلَوْلَآ أُلْقِيَ عَلَيْهِ أَسَٰوِرَةࣱ مِّن ذَهَبٍ اَوْ جَآءَ مَعَهُ اُ۬لْمَلَٰٓئِكَةُ مُقْتَرِنِينَۖ", "words": [{"id": 1, "arabic": "فَلَوْلَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أُلْقِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَسَٰوِرَةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "ذَهَبٍ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 8, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَعَهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْمَلَٰٓئِكَةُ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُقْتَرِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 54, "text": "فَاسْتَخَفَّ قَوْمَهُۥ فَأَطَاعُوهُۖ إِنَّهُمْ كَانُواْ قَوْماࣰ فَٰسِقِينَۖ", "words": [{"id": 1, "arabic": "فَاسْتَخَفَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَوْمَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَأَطَاعُوهُۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَٰسِ