َ۬لرَّحْمَٰنِ إِنَٰثاًۖ اَ۟شْهِدُواْ خَلْقَهُمْۖ سَتُكْتَبُ شَهَٰدَتُهُمْ وَيُسْـَٔلُونَۖ", "words": [{"id": 1, "arabic": "وَجَعَلُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْمَلَٰٓئِكَةَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لرَّحْمَٰنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَٰثاًۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۟شْهِدُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "خَلْقَهُمْۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "سَتُكْتَبُ", "translit": "", "root": ""}, {"id": 11, "arabic": "شَهَٰدَتُهُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَيُسْـَٔلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 20, "text": "وَقَالُواْ لَوْ شَآءَ اَ۬لرَّحْمَٰنُ مَا عَبَدْنَٰهُمۖ مَّا لَهُم بِذَٰلِكَ مِنْ عِلْمٍۖ اِنْ هُمُۥٓ إِلَّا يَخْرُصُونَۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَوْ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لرَّحْمَٰنُ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "عَبَدْنَٰهُمۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 9, "arabic": "بِذَٰلِكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 11, "arabic": "عِلْمٍۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِنْ", "translit": "", "root": ""}, {"id": 13, "arabic": "هُمُۥٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 15, "arabic": "يَخْرُصُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 21, "text": "أَمَ اٰتَيْنَٰهُمْ كِتَٰباࣰ مِّن قَبْلِهِۦ فَهُم بِهِۦ مُسْتَمْسِكُونَۖ", "words": [{"id": 1, "arabic": "أَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اٰتَيْنَٰهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "كِتَٰباࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُسْتَمْسِكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 22, "text": "بَلْ قَالُوٓاْ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَيٰٓ أُمَّةࣲ وَإِنَّا عَلَيٰٓ ءَاثٰ۪رِهِم مُّهْتَدُونَۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "وَجَدْنَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَابَآءَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أُمَّةࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 10, "arabic": "ءَاثٰ۪رِهِم", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّهْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 23, "text": "وَكَذَٰلِكَ مَآ أَرْسَلْنَا مِن قَبْلِكَ فِے قَرْيَةࣲ مِّن نَّذِيرٍ اِلَّا قَالَ مُتْرَفُوهَآ إِنَّا وَجَدْنَآ ءَابَآءَنَا عَلَيٰٓ أُمَّةࣲ وَإِنَّا عَلَيٰٓ ءَاثٰ۪رِهِم مُّقْتَدُونَۖ", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَرْسَلْنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْل