 ""}], "narration": "warsh"}, {"surah": 43, "ayah": 9, "text": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ اَ۬لسَّمَٰوَٰتِ وَالَارْضَ لَيَقُولُنَّ خَلَقَهُنَّ اَ۬لْعَزِيزُ اُ۬لْعَلِيمُۖ", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "", "root": ""}, {"id": 2, "arabic": "سَأَلْتَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلَقَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَيَقُولُنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "خَلَقَهُنَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 10, "text": "اُ۬لذِے جَعَلَ لَكُمُ اُ۬لَارْضَ مِهَٰداࣰ وَجَعَلَ لَكُمْ فِيهَا سُبُلاࣰ لَّعَلَّكُمْ تَهْتَدُونَۖ", "words": [{"id": 1, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لَارْضَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِهَٰداࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَجَعَلَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 9, "arabic": "سُبُلاࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَّعَلَّكُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "تَهْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 11, "text": "۞وَالذِے نَزَّلَ مِنَ اَ۬لسَّمَآءِ مَآءَۢ بِقَدَرࣲ فَأَنشَرْنَا بِهِۦ بَلْدَةࣰ مَّيْتاࣰۖ كَذَٰلِكَ تُخْرَجُونَۖ", "words": [{"id": 1, "arabic": "۞وَالذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "نَزَّلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ