ينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 37, "text": "وَإِنَّهُمْ لَيَصُدُّونَهُمْ عَنِ اِ۬لسَّبِيلِ وَيَحْسِبُونَ أَنَّهُم مُّهْتَدُونَۖ", "words": [{"id": 1, "arabic": "وَإِنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَيَصُدُّونَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لسَّبِيلِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَحْسِبُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَنَّهُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّهْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 38, "text": "حَتَّيٰٓ إِذَا جَآءَٰنَا قَالَ يَٰلَيْتَ بَيْنِے وَبَيْنَكَ بُعْدَ اَ۬لْمَشْرِقَيْنِۖ فَبِيسَ اَ۬لْقَرِينُۖ", "words": [{"id": 1, "arabic": "حَتَّيٰٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "جَآءَٰنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰلَيْتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْنِے", "translit": "", "root": ""}, {"id": 7, "arabic": "وَبَيْنَكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "بُعْدَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْمَشْرِقَيْنِۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَبِيسَ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬لْقَرِينُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 39, "text": "وَلَنْ يَّنفَعَكُمُ اُ۬لْيَوْمَ إِذ ظَّلَمْتُمُۥٓ أَنَّكُمْ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ", "words": [{"id": 1, "arabic": "وَلَنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّنفَعَكُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْيَوْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذ", "translit": "", "root": ""}, {"id": 5, "arabic": "ظَّلَمْتُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabi