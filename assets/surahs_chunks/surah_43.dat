ayah": 87, "text": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَهُمْ لَيَقُولُنَّ اَ۬للَّهُۖ فَأَنّ۪يٰ يُوفَكُونَۖ", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "", "root": ""}, {"id": 2, "arabic": "سَأَلْتَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلَقَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَيَقُولُنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَأَنّ۪يٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُوفَكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 88, "text": "وَقِيلَهُۥ يَٰرَبِّ إِنَّ هَٰٓؤُلَآءِ قَوْمࣱ لَّا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "وَقِيلَهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰرَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 89, "text": "فَاصْفَحْ عَنْهُمْ وَقُلْ سَلَٰمࣱۖ فَسَوْفَ تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "فَاصْفَحْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَقُلْ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَلَٰمࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَسَوْفَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}