 ""}, {"id": 8, "arabic": "إِلَٰهࣱۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬لْحَكِيمُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 85, "text": "۞وَتَبَٰرَكَ اَ۬لذِے لَهُۥ مُلْكُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَاۖ وَعِندَهُۥ عِلْمُ اُ۬لسَّاعَةِۖ وَإِلَيْهِ تُرْجَعُونَۖ", "words": [{"id": 1, "arabic": "۞وَتَبَٰرَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُلْكُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 8, "arabic": "بَيْنَهُمَاۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَعِندَهُۥ", "translit": "", "root": ""}, {"id": 10, "arabic": "عِلْمُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لسَّاعَةِۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَإِلَيْهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "تُرْجَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 86, "text": "وَلَا يَمْلِكُ اُ۬لذِينَ يَدْعُونَ مِن دُونِهِ اِ۬لشَّفَٰعَةَ إِلَّا مَن شَهِدَ بِالْحَقِّ وَهُمْ يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَمْلِكُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَدْعُونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "دُونِهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لشَّفَٰعَةَ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "مَن", "translit": "", "root": ""}, {"id": 10, "arabic": "شَهِدَ", "translit": "", "root": ""}, {"id": 11, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 87, "text": "وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَهُمْ لَيَقُولُنَّ اَ۬للَّهُۖ فَأَنّ۪يٰ يُوفَكُونَۖ", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "", "root": ""}, {"id": 2, "arabic": "سَأَلْتَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلَقَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَيَقُولُنَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهُۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَأَنّ۪يٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُوفَكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 88, "text": "وَقِيلَهُۥ يَٰرَبِّ إِنَّ هَٰٓؤُلَآءِ قَوْمࣱ لَّا يُومِنُونَۖ", "words": [{"id": 1, "arabic": "وَقِيلَهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰرَبِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَٰٓؤُلَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "يُومِنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 89, "text": "فَاصْفَحْ عَنْهُمْ وَقُلْ سَلَٰمࣱۖ فَسَوْفَ تَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "فَاصْفَحْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَقُلْ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَلَٰمࣱۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَسَوْفَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}