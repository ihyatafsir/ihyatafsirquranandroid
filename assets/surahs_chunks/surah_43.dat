 "words": [{"id": 1, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نُرِيَنَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَدْنَٰهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَإِنَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّقْتَدِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 43, "text": "۞فَاسْتَمْسِكْ بِالذِےٓ أُوحِيَ إِلَيْكَۖ إِنَّكَ عَلَيٰ صِرَٰطࣲ مُّسْتَقِيمࣲۖ", "words": [{"id": 1, "arabic": "۞فَاسْتَمْسِكْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِالذِےٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُوحِيَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيْكَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "صِرَٰطࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّسْتَقِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 44, "text": "وَإِنَّهُۥ لَذِكْرࣱ لَّكَ وَلِقَوْمِكَۖ وَسَوْفَ تُسْـَٔلُونَۖ", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَذِكْرࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلِقَوْمِكَۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَسَوْفَ", "translit": "", "root": ""}, {"id": 6, "arabic": "تُسْـَٔلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 45, "text": "وَسْـَٔلْ مَنَ اَرْسَلْنَا مِن قَبْلِكَ مِن رُّسُلِنَآۖ أَجَعَلْنَا مِن دُونِ اِ۬لرَّحْمَٰنِ ءَالِهَةࣰ يُعْبَدُونَۖ", "words": [{"id": 1, "arabic": "وَسْـَٔلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 4, "arab