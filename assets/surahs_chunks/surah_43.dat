yah": 75, "text": "لَا يُفَتَّرُ عَنْهُمْ وَهُمْ فِيهِ مُبْلِسُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُفَتَّرُ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُبْلِسُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 76, "text": "وَمَا ظَلَمْنَٰهُمْۖ وَلَٰكِن كَانُواْ هُمُ اُ۬لظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ظَلَمْنَٰهُمْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَلَٰكِن", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 77, "text": "وَنَادَوْاْ يَٰمَٰلِكُ لِيَقْضِ عَلَيْنَا رَبُّكَۖ قَالَ إِنَّكُم مَّٰكِثُونَۖ", "words": [{"id": 1, "arabic": "وَنَادَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰمَٰلِكُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِيَقْضِ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبُّكَۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّكُم", "translit": "", "root": ""}, {"id": 8, "arabic": "مَّٰكِثُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 78, "text": "لَقَدْ جِئْنَٰكُم بِالْحَقِّۖ وَلَٰكِنَّ أَكْثَرَكُمْ لِلْحَقِّ كَٰرِهُونَۖ", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جِئْنَٰكُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْحَقِّۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَٰكِنَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَكْثَرَكُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِلْحَقِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَٰرِهُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 79, "text": "أَمَ اَبْرَمُوٓاْ أَمْراࣰ فَإِنَّا مُبْرِمُونَۖ", "words": [{"id": 1, "arabic": "أَمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَبْرَمُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَمْراࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَإِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "مُبْرِمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 80, "text": "أَمْ يَحْسِبُونَ أَنَّا لَا نَسْمَعُ سِرَّهُمْ وَنَجْو۪يٰهُم بَل۪يٰۖ وَرُسُلُنَا لَدَيْهِمْ يَكْتُبُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَحْسِبُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "نَسْمَعُ", "translit": "", "root": ""}, {"id": 6, "arabic": "سِرَّهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَنَجْو۪يٰهُم", "translit": "", "root": ""}, {"id": 8, "arabic": "بَل۪يٰۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَرُسُلُنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "لَدَيْهِمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يَكْتُبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 43, "ayah": 81, "text": "قُلِ اِن كَانَ لِلرَّحْمَٰنِ وَلَدࣱۖ فَأَنَآ أَوَّلُ اُ۬لْعَٰبِدِينَۖ", "words": [{"id": 1, "arabic": "قُلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِن", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلرَّحْمَٰنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَدࣱۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَأَنَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "