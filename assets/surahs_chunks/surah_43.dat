":"شدد"},{"id":3,"arabic":"مِنْهُم","translit":"mُhْnِm","root":""},{"id":4,"arabic":"بَطْشًا","translit":"āًhsْṭَb","root":"بطش"},{"id":5,"arabic":"وَمَضَىٰ","translit":"ٰàَḍَmَw","root":"مضي"},{"id":6,"arabic":"مَثَلُ","translit":"ُlَhtَm","root":"مثل"},{"id":7,"arabic":"ٱلْأَوَّلِينَ","translit":"َnyِlَّwَaʾْlٱ","root":"اول"}],"hasIhya":false},{"ayah":9,"text":"وَلَئِن سَأَلْتَهُم مَّنْ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ لَيَقُولُنَّ خَلَقَهُنَّ ٱلْعَزِيزُ ٱلْعَلِيمُ ","translation":"And if you should ask them, \"Who has created the heavens and the earth?\" they would surely say, \"They were created by the Exalted in Might, the Knowing,\"","words":[{"id":1,"arabic":"وَلَئِن","translit":"nِyʾَlَw","root":""},{"id":2,"arabic":"سَأَلْتَهُم","translit":"mُhَtْlَaʾَs","root":"سال"},{"id":3,"arabic":"مَّنْ","translit":"ْnَّm","root":""},{"id":4,"arabic":"خَلَقَ","translit":"َqَlَhk","root":"خلق"},{"id":5,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":6,"arabic":"وَٱلْأَرْضَ","translit":"َḍْrَaʾْlٱَw","root":"ارض"},{"id":7,"arabic":"لَيَقُولُنَّ","translit":"َّnُlwُqَyَl","root":"قول"},{"id":8,"arabic":"خَلَقَهُنَّ","translit":"َّnُhَqَlَhk","root":"خلق"},{"id":9,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":10,"arabic":"ٱلْعَلِيمُ","translit":"ُmyِlَʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":10,"text":"ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ مَهْدًا وَجَعَلَ لَكُمْ فِيهَا سُبُلًا لَّعَلَّكُمْ تَهْتَدُونَ ","translation":"[The one] who has made for you the earth a bed and made for you upon it roads that you might be guided","words":[{"id":1,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":2,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":3,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":4,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"مَهْدًا","translit":"āًdْhَm","root":"مهد"},{"id":6,"arabic":"وَجَعَلَ","translit":"َlَʿعَjgَw","root":"جعل"},{"id":7,"arabic":"لَكُمْ","trans