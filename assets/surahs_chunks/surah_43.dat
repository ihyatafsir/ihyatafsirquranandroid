َl","root":""},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلْفُلْكِ","translit":"ِkْlُfْlٱ","root":"فلك"},{"id":9,"arabic":"وَٱلْأَنْعَٰمِ","translit":"ِmَٰʿعْnَaʾْlٱَw","root":"نعم"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"تَرْكَبُونَ","translit":"َnwُbَkْrَt","root":"ركب"}],"hasIhya":false},{"ayah":13,"text":"لِتَسْتَوُۥا۟ عَلَىٰ ظُهُورِهِۦ ثُمَّ تَذْكُرُوا۟ نِعْمَةَ رَبِّكُمْ إِذَا ٱسْتَوَيْتُمْ عَلَيْهِ وَتَقُولُوا۟ سُبْحَٰنَ ٱلَّذِى سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُۥ مُقْرِنِينَ ","translation":"That you may settle yourselves upon their backs and then remember the favor of your Lord when you have settled upon them and say, \"Exalted is He who has subjected this to us, and we could not have [otherwise] subdued it.[1]","words":[{"id":1,"arabic":"لِتَسْتَوُۥا۟","translit":"۟āۥُwَtْsَtِl","root":"سوي"},{"id":2,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":3,"arabic":"ظُهُورِهِۦ","translit":"ۦِhِrwُhُẓ","root":"ظهر"},{"id":4,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":5,"arabic":"تَذْكُرُوا۟","translit":"۟āwُrُkْhdَt","root":"ذكر"},{"id":6,"arabic":"نِعْمَةَ","translit":"َẗَmْʿعِn","root":"نعم"},{"id":7,"arabic":"رَبِّكُمْ","translit":"ْmُkِّbَr","root":"ربب"},{"id":8,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":9,"arabic":"ٱسْتَوَيْتُمْ","translit":"ْmُtْyَwَtْsٱ","root":"سوي"},{"id":10,"arabic":"عَلَيْهِ","translit":"ِhْyَlَʿع","root":""},{"id":11,"arabic":"وَتَقُولُوا۟","translit":"۟āwُlwُqَtَw","root":"قول"},{"id":12,"arabic":"سُبْحَٰنَ","translit":"َnَٰḥْbُs","root":"سبح"},{"id":13,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":14,"arabic":"سَخَّرَ","translit":"َrَّhkَs","root":"سخر"},{"id":15,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":16,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":17,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":18,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":19,"arabic":"لَهُۥ","translit":"ۥُhَl"