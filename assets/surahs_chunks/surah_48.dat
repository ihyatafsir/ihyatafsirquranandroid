d":4,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"قُلُوبِهِمُ","translit":"ُmِhِbwُlُq","root":"قلب"},{"id":7,"arabic":"ٱلْحَمِيَّةَ","translit":"َẗَّyِmَḥْlٱ","root":"حمي"},{"id":8,"arabic":"حَمِيَّةَ","translit":"َẗَّyِmَḥ","root":"حمي"},{"id":9,"arabic":"ٱلْجَٰهِلِيَّةِ","translit":"ِẗَّyِlِhَٰjgْlٱ","root":"جهل"},{"id":10,"arabic":"فَأَنزَلَ","translit":"َlَznَaʾَf","root":"نزل"},{"id":11,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":12,"arabic":"سَكِينَتَهُۥ","translit":"ۥُhَtَnyِkَs","root":"سكن"},{"id":13,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":14,"arabic":"رَسُولِهِۦ","translit":"ۦِhِlwُsَr","root":"رسل"},{"id":15,"arabic":"وَعَلَى","translit":"àَlَʿعَw","root":""},{"id":16,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":17,"arabic":"وَأَلْزَمَهُمْ","translit":"ْmُhَmَzْlَaʾَw","root":"لزم"},{"id":18,"arabic":"كَلِمَةَ","translit":"َẗَmِlَk","root":"كلم"},{"id":19,"arabic":"ٱلتَّقْوَىٰ","translit":"ٰàَwْqَّtlٱ","root":"وقي"},{"id":20,"arabic":"وَكَانُوٓا۟","translit":"۟āٓwُnāَkَw","root":"كون"},{"id":21,"arabic":"أَحَقَّ","translit":"َّqَḥَaʾ","root":"حقق"},{"id":22,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":23,"arabic":"وَأَهْلَهَا","translit":"āَhَlْhَaʾَw","root":"اهل"},{"id":24,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":25,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":26,"arabic":"بِكُلِّ","translit":"ِّlُkِb","root":"كلل"},{"id":27,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":28,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"}],"hasIhya":true},{"ayah":27,"text":"لَّقَدْ صَدَقَ ٱللَّهُ رَسُولَهُ ٱلرُّءْيَا بِٱلْحَقِّۖ لَتَدْخُلُنَّ ٱلْمَسْجِدَ ٱلْحَرَامَ إِن شَآءَ ٱللَّهُ ءَامِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ لَا تَخَافُونَۖ فَعَلِمَ مَا لَمْ تَعْلَمُوا۟ فَجَعَلَ مِن دُونِ ذَٰلِكَ فَتْحًا قَرِيبًا ","translation":"Certainly has Allāh showed to His Messenger the vision [i.e., dream] in truth. You will surely enter al-Masjid al-Ḥarām, if Allāh wills, in safety, with your heads shaved and [hair] shortened,[1] not fearing [anyone]. He knew what you did not know and has arranged before that a conquest near [at hand].","words":[{"id":1,"arabic":"لَّقَدْ","translit":"ْdَqَّl","root":""},{"id":2,"arabic":"صَدَقَ","translit":"َqَdَṣ","root":"صدق"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"رَسُولَهُ","translit":"ُhَlwُsَr","root":"رسل"},{"id":5,"arabic":"ٱلرُّءْيَا","translit":"āَyْءُّrlٱ","root":"راي"},{"id":6,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":7,"arabic":"لَتَدْخُلُنَّ","translit":"َّnُlُhkْdَtَl","root":"دخل"},{"id":8,"arabic":"ٱلْمَسْجِدَ","translit":"َdِjgْsَmْlٱ","root":"سجد"},{"id":9,"arabic":"ٱلْحَرَامَ","translit":"َmāَrَḥْlٱ","root":"حرم"},{"id":10,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":11,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"ءَامِنِينَ","translit":"َnyِnِmāَء","root":"امن"},{"id":14,"arabic":"مُحَلِّقِينَ","translit":"َnyِqِّlَḥُm","root":"حلق"},{"id":15,"arabic":"رُءُوسَكُمْ","translit":"ْmُkَswُءُr","root":"راس"},{"id":16,"arabic":"وَمُقَصِّرِينَ","translit":"َnyِrِّṣَqُmَw","root":"قصر"},{"id":17,"arabic":"لَا","translit":"āَl","root":""},{"id":18,"arabic":"تَخَافُونَ","translit":"َnwُfāَhkَt","root":"خوف"},{"id":19,"arabic":"فَعَلِمَ","translit":"َmِlَʿعَf","root":"علم"},{"id":20,"arabic":"مَا","translit":"āَm","root":""},{"id":21,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":22,"arabic":"تَعْلَمُوا۟","translit":"۟āwُmَlْʿعَt","root":"علم"},{"id":23,"arabic":"فَجَعَلَ","translit":"َlَʿعَjgَf","root":"جعل"},{"id":24,"arabic":"مِن","translit":"nِm","root":""},{"id":25,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":26,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":27,"arabic":"فَتْحًا","translit":"āًḥْtَf","root":"فتح"},{"id":28,"arabic":"قَرِيبًا","translit":"āًbyِrَq","root":"قرب"}],"hasIhya":true},{"ayah":28,"text":"هُوَ ٱلَّذِىٓ أَرْسَلَ رَسُولَهُۥ بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦۚ وَكَفَىٰ بِٱللَّهِ شَهِيدًا ","translation":"It is He who sent His Messenger with guidance and the religion of truth to manifest it over all religion. And sufficient is Allāh as Witness.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":3,"arabic":"أَرْسَلَ","translit":"َlَsْrَaʾ","root":"رسل"},{"id":4,"arabic":"رَسُولَهُۥ","translit":"ۥُhَlwُsَr","root":"رسل"},{"id":5,"arabic":"بِٱلْهُدَىٰ","translit":"ٰàَdُhْlٱِb","root":"هدي"},{"id":6,"arabic":"وَدِينِ","translit":"ِnyِdَw","root":"دين"},{"id":7,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":8,"arabic":"لِيُظْهِرَهُۥ","translit":"ۥُhَrِhْẓُyِl","root":"ظهر"},{"id":9,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":10,"arabic":"ٱلدِّينِ","translit":"ِnyِّdlٱ","root":"دين"},{"id":11,"arabic":"كُلِّهِۦ","translit":"ۦِhِّlُk","root":"كلل"},{"id":12,"arabic":"وَكَفَىٰ","translit":"ٰàَfَkَw","root":"كفي"},{"id":13,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":14,"arabic":"شَهِيدًا","translit":"āًdyِhَhs","root":"شهد"}],"hasIhya":false},{"ayah":29,"text":"مُّحَمَّدٌ رَّسُولُ ٱللَّهِۚ وَٱلَّذِينَ مَعَهُۥٓ أَشِدَّآءُ عَلَى ٱلْكُفَّارِ رُحَمَآءُ بَيْنَهُمْۖ تَرَىٰهُمْ رُكَّعًا سُجَّدًا يَبْتَغُونَ فَضْلًا مِّنَ ٱللَّهِ وَرِضْوَٰنًاۖ سِيمَاهُمْ فِى وُجُوهِهِم مِّنْ أَثَرِ ٱلسُّجُودِۚ ذَٰلِكَ مَثَلُهُمْ فِى ٱلتَّوْرَىٰةِۚ وَمَثَلُهُمْ فِى ٱلْإِنجِيلِ كَزَرْعٍ أَخْرَجَ شَطْـَٔهُۥ فَـَٔازَرَهُۥ فَٱسْتَغْلَظَ فَٱسْتَوَىٰ عَلَىٰ سُوقِهِۦ يُعْجِبُ ٱلزُّرَّاعَ لِيَغِيظَ بِهِمُ ٱلْكُفَّارَۗ وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ مِنْهُم مَّغْفِرَةً وَأَجْرًا عَظِيمًۢا ","translation":"Muḥammad is the Messenger of Allāh; and those with him are forceful against the disbelievers, merciful among themselves. You see them bowing and prostrating [in prayer], seeking bounty from Allāh and [His] pleasure. Their sign is in their faces from the effect of prostration [i.e., prayer]. That is their description in the Torah. And their description in the Gospel is as a plant which produces its offshoots and strengthens them so they grow firm and stand upon their stalks, delighting the sowers - so that He [i.e., Allāh] may enrage by them[1] the disbelievers. Allāh has promised those who believe and do righteous deeds among them forgiveness and a great reward.","words":[{"id":1,"arabic":"مُّحَمَّدٌ","translit":"ٌdَّmَḥُّm","root":"حمد"},{"id":2,"arabic":"رَّسُولُ","translit":"ُlwُsَّr","root":"رسل"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":5,"arabic":"مَعَهُۥٓ","translit":"ٓۥُhَʿعَm","root":""},{"id":6,"arabic":"أَشِدَّآءُ","translit":"ُءٓāَّdِhsَaʾ","root":"شدد"},{"id":7,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":8,"arabic":"ٱلْكُفَّارِ","translit":"ِrāَّfُkْlٱ","root":"كفر"},{"id":9,"arabic":"رُحَمَآءُ","translit":"ُءٓāَmَḥُr","root":"رحم"},{"id":10,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":11,"arabic":"تَرَىٰهُمْ","translit":"ْmُhٰàَrَt","root":"راي"},{"id":12,"arabic":"رُكَّعًا","translit":"āًʿعَّkُr","root":"ركع"},{"id":13,"arabic":"سُجَّدًا","translit":"āًdَّjgُs","root":"سجد"},{"id":14,"arabic":"يَبْتَغُونَ","translit":"َnwُغَtْbَy","root":"بغي"},{"id":15,"arabic":"فَضْلًا","translit":"āًlْḍَf","root":"فضل"},{"id":16,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"وَرِضْوَٰنًا","translit":"āًnَٰwْḍِrَw","root":"رضو"},{"id":19,"arabic":"سِيمَاهُمْ","translit":"ْmُhāَmyِs","root":"سوم"},{"id":20,"arabic":"فِى","translit":"àِf","root":""},{"id":21,"arabic":"وُجُوهِهِم","translit":"mِhِhwُjgُw","root":"وجه"},{"id":22,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":23,"arabic":"أَثَرِ","translit":"ِrَhtَaʾ","root":"اثر"},{"id":24,"arabic":"ٱلسُّجُودِ","translit":"ِdwُjgُّslٱ","root":"سجد"},{"id":25,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":26,"arabic":"مَثَلُهُمْ","translit":"ْmُhُlَhtَm","root":"مثل"},{"id":27,"arabic":"فِى","translit":"àِf","root":""},{"id":28,"arabic":"ٱلتَّوْرَىٰةِ","translit":"ِẗٰàَrْwَّtlٱ","root":""},{"id":29,"arabic":"وَمَثَلُهُمْ","translit":"ْmُhُlَhtَmَw","root":"مثل"},{"id":30,"arabic":"فِى","translit":"àِf","root":""},{"id":31,"arabic":"ٱلْإِنجِيلِ","translit":"ِlyِjgnِiʾْlٱ","root":""},{"id":32,"arabic":"كَزَرْعٍ","translit":"ٍʿعْrَzَk","root":"زرع"},{"id":33,"arabic":"أَخْرَجَ","translit":"َjgَrْhkَaʾ","root":"خرج"},{"id":34,"arabic":"شَطْـَٔهُۥ","translit":"ۥُhَٔـْṭَhs","root":"شطا"},{"id":35,"arabic":"فَـَٔازَرَهُۥ","translit":"ۥُhَrَzāَٔـَf","root":"ازر"},{"id":36,"arabic":"فَٱسْتَغْلَظَ","translit":"َẓَlْغَtْsٱَf","root":"غلظ"},{"id":37,"arabic":"فَٱسْتَوَىٰ","translit":"ٰàَwَtْsٱَf","root":"سوي"},{"id":38,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":39,"arabic":"سُوقِهِۦ","translit":"ۦِhِqwُs","root":"سوق"},{"id":40,"arabic":"يُعْجِبُ","translit":"ُbِjgْʿعُy","root":"عجب"},{"id":41,"arabic":"ٱلزُّرَّاعَ","translit":"َʿعāَّrُّzlٱ","root":"زرع"},{"id":42,"arabic":"لِيَغِيظَ","translit":"َẓyِغَyِl","root":"غيظ"},{"id":43,"arabic":"بِهِمُ","translit":"ُmِhِb","root":""},{"id":44,"arabic":"ٱلْكُفَّارَ","translit":"َrāَّfُkْlٱ","root":"كفر"},{"id":45,"arabic":"وَعَدَ","translit":"َdَʿعَw","root":"وعد"},{"id":46,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":47,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":48,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":49,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":50,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":51,"arabic":"مِنْهُم","translit":"mُhْnِm","root":""},{"id":52,"arabic":"مَّغْفِرَةً","translit":"ًẗَrِfْغَّm","root":"غفر"},{"id":53,"arabic":"وَأَجْرًا","translit":"āًrْjgَaʾَw","root":"اجر"},{"id":54,"arabic":"عَظِيمًۢا","translit":"āًۢmyِẓَʿع","root":"عظم"}],"hasIhya":true}],"tafsir":{"2":[{"arabic":"آخر ولم يسه فيهما غفر له ما تقدم من ذنبه وقال صلى الله عليه وسلم أيضا ألا أنبئكم بما يكفر الله به الخطايا ويرفع به الدرجات إسباغ الوضوء على المكاره ونقل الأقدام إلى المساجد وانتظار الصلاة بعد الصلاة فذلكم الرباط ثلاث مرات (2) وتوضأ صلى الله عليه وسلم مرة مرة وقال هذا وضوء لا يقبل الله الصلاة إلا به وتوضأ مرتين مرتين وقال من توضأ مرتين مرتين أتاه الله أجره مرتين وتوضأ ثلاثا ثلاثا وقال هذا وضوئي ووضوء الأنبياء من قبلي ووضوء خليل الرحمن إبراهيم عليه السلام (3) وقال صلى الله عليه وسلم م","english":"The Messenger of God, may God bless him and grant him peace, said: \"Whoever performs ablution and does it well, then prays two rakʿahs in which he does not speak to himself of anything of this world, will come out of his sins like the day his mother bore him.\" In another wording: \"And does not err in them, his past sins will be forgiven him.\" He, may God bless him and grant him peace, also said: \"Shall I not inform you of that by which God erases sins and by which He raises degrees? The perfecting of ablution despite hardships, and the taking of many steps to the mosques, and the waiting for prayer after prayer — that is the ribāṭ (the constant guarding of the frontier).\" He said this three times. And he, may God bless him and grant him peace, performed ablution once each (washing each limb once) and said: \"This is an ablution without which God does not accept the prayer.\" And he performed ablution twice each and said: \"Whoever performs ablution twice each, God will give him his reward twice.\" And he performed ablution three times each and said: \"This is my ablution, and the ablution of the prophets before me, and the ablution of the Friend of the Merciful, Abraham, peace be upon him.\" And he, may God bless him and grant him peace, said: \"Whoever mentions God at his ablution, God will purify his entire body; and whoever does not mention God, only that which the water touches will be purified.\" And he, may God bless him and grant him peace, said: \"Whoever performs ablution while already in a state of purity, God writes for him ten good deeds.\" And he, may God bless him and grant him peace, said: \"Ablution upon ablution is light upon light.\" All of this is an encouragement to renew the ablution. And he, peace be upon him, said: \"When the Muslim servant performs ablution and rinses his mouth, the sins exit from his mouth; when he snuffs water into his nose, the sins exit from his nose; when he washes his face, the sins exit from his face, until they exit from beneath his eyelashes; when he washes his hands, the sins exit from his hands, until they exit from beneath his fingernails; when he wipes his head, the sins exit from his head, until they exit from beneath his ears; and when he washes his feet, the sins exit from his feet, until they exit from beneath the nails of his feet. Then his walking to the mosque and his prayer are an additional merit for him.\" And it is related that \"the one in a state of purity is like the one who is fasting.\" He, may God bless him and grant him peace, said: \"Whoever performs ablution and does it well, then raises his gaze to the sky and says, 'I bear witness that there is no god but God alone, with no partner, and I bear witness that Muhammad is His servant and His Messenger' — the eight gates of Paradise are opened for him, and he enters through whichever of them he wishes.\" And ʿUmar, may God be pleased with him, said: \"Indeed, the sound ablution drives the devil away from you.\" And Mujāhid said: \"Whoever is able to not spend the night except in a state of purity, remembering God and seeking His forgiveness, let him do so, for the souls are raised according to the state in which they were seized.\"","book_title":"Mysteries of Prayer","section_title_ar":"Section 113","section_title_en":"The Virtue of Ablution (Faḍīlat al-Wuḍūʾ) and the Manner of the Major Ritual Bath (Kayfiyyat al-Ghusl)","section_index":113,"anchors":"- Root: وضو (W-Ḍ-W)\n  * Lisan / Ayn: The root denotes cleanliness, brightness, and perfection; al-wuḍūʾ is the specific act of ritual purification with water for prayer.\n  * Al-Raghib (Mufradat): The term is used for the specific act of washing the limbs in preparation for prayer, a divinely ordained purification that removes both physical and spiritual defilement.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the physical washing of the limbs; metaphorical (majāz) usage extends to the purification of the soul from sins, as sins are said to \"exit\" with the water.\n- Root: غسل (Gh-S-L)\n  * Lisan / Ayn: To wash, to remove dirt or filth by pouring water over something.\n  * Al-Raghib (Mufradat): \"غسلت الشيء غسلا: أسلت عليه الماء فأزلت درنه\" — to pour water over a thing to remove its filth. Al-Ghusl is the name for the act of washing the entire body, and al-ghusl (with damma) is the water used for washing. The root also yields \"al-ghislīn\" (غسلين), the filth-washing of the bodies of the disbelievers in Hellfire.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is the physical washing of the body. Metaphorical (majāz) usage is found in phrases like \"تلطخ بعار لن يغسل عنه أبدا\" (stained with a disgrace that will never be washed away), indicating that which cannot be cleansed or absolved.\n- Root: راس (R-A-S)\n  * Lisan / Ayn: The head; also used for a leader or chief.\n  * Al-Raghib (Mufradat): \"الرأس معروف\" — the head is well-known; it is used metaphorically for the leader (al-raʾīs).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the physical head. Metaphorical (majāz) usage is found in \"رأس الدين الخشية\" (the head of the religion is God-consciousness) and \"هو رأس قومه\" (he is the head of his people).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of separating a preposition from its object, which is relevant for correctly parsing the grammatical relationships in the hadith reports, ensuring the subject of the verb is correctly identified.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Prayer'","badge":"Du'a"},{"arabic":"استأنف العمل فقد غفر لك ما تقدم من ذنبك ورفع الله سبحانه عنك عذاب القبر وضيقه وظلمته ورفع عنك شدائد القيامة ورفع له من يومه عمل نبي (4) يوم الخميس عن عكرمة عن ابن عباس قال قال رسول الله صلى الله عليه وسلم من صلى يوم الخميس بين الظهر والعصر ركعتين يقرأ في الأولى فاتحة الكتاب وآية الكرسي مائة مرة وفي الثانية فاتحة الكتاب وقل هو الله أحد مائة مرة ويصلي على محمد مائة مرة أعطاه الله ثواب من صام رجب وشعبان ورمضان وكان له من الثواب مثل حاج البيت وكتب له بعدد كل من آمن بالله سبحانه وتوكل عليه","english":"**Sunday:** Abū Hurayrah — may Allah be pleased with him — narrated from the Prophet — peace and blessings be upon him — that he said: \"Whoever prays on Sunday four units (rakʿāt), reciting in each unit the Opening of the Book {«فاتحة الكتاب»} and {«آمن الرسول»} once, Allah will write for him, for every Christian man and woman, good deeds; and He will give him the reward of a prophet; and He will write for him a Pilgrimage (ḥajj) and an ʿUmrah; and He will write for him, for every unit, a thousand prayers; and Allah will give him, in Paradise, for every letter, a city of pure musk.\" And it is narrated from ʿAlī ibn Abī Ṭālib — may Allah be pleased with him — from the Prophet — peace and blessings be upon him — that he said: \"Declare the oneness of Allah (waḥḥidū Allāh) by multiplying prayer on Sunday, for He — Glorified be He — is One (wāḥid), having no partner. Whoever prays on Sunday after the noon prayer (ẓuhr) four units after the obligatory and the sunnah — reciting in the first unit the Opening of the Book and {«تنزيل السجدة»}, and in the second unit the Opening of the Book and {«تبارك الملك»} — then gives the greeting of peace (tashahhud wa salām), then stands and prays two further units, reciting in them the Opening of the Book and the Chapter of Friday {«سورة الجمعة»}, and asks Allah — Glorified be He — for his need, it is incumbent upon Allah to fulfill his need.\"","book_title":"Mysteries of Prayer","section_title_ar":"Section 159","section_title_en":"The Revival of the Religious Sciences — Section 159: On the Virtues of Prayers for Each Day of the Week","section_index":159,"anchors":"- Root: يوم (yawm)\n  * Lisan / Ayn: Core temporal unit; from sunrise to sunset, or any extended period.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — denotes the period from sunrise to sunset, or any duration whatsoever; when added to Allah (أيام الله), it signifies His mighty deeds and epochs.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the solar day. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — used for notable events and battles.\n- Root: ركع (rakaʿa)\n  * Lisan / Ayn: To bow; the act of bowing in prayer.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء، فتارة يستعمل في الهيئة المخصوصة في الصلاة كما هي، وتارة في التواضع والتذلل\" — bowing; used literally for the specific prayer posture, and metaphorically for humility and submission.\n  * Al-Zamakhshari (Asas): Literal: \"شيخ راكع: منحن من الكبر\" — an old man bent with age. Metaphorical: \"لغبت الإبل حتى ركعت\" — camels weary to the point of collapsing on their front legs. In prayer, a ركعة (rakʿah) is a unit named after its bowing.\n- Root: فتح (fataḥa)\n  * Lisan / Ayn: To open; to unlock.\n  * Al-Raghib (Mufradat): \"الفتح: إزالة الإغلاق والإشكال\" — removal of closure and obstruction; perceptible by sight (opening a door) or by insight (removing distress).\n  * Al-Zamakhshari (Asas): Literal: opening a physical door. Metaphorical: \"فتح الله عليه: نصره\" — Allah's granting victory; \"فتح على فلان\" — prosperity and worldly success.\n- Root: احد (aḥad)\n  * Lisan / Ayn: One; unique; the first of the six roots of the triliteral system.\n  * Al-Raghib (Mufradat): Used for Allah's absolute oneness; \"وحدوا الله\" — declare His unity.\n  * Al-Zamakhshari (Asas): Literal: numerical oneness. Metaphorical: exclusive uniqueness, as in the divine name \"الأحد\" (The One).\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional clauses (من صلى...) followed by apodoses (كتب له...) establish a restricted causal nexus: the reward is bound precisely to the specified action, its time, and its prescribed form.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Mysteries of Prayer'","badge":"Afterlife"},{"arabic":"قدماه فقيل له أما قد غفر الله لك ما تقدم من ذنبك وما تأخر فقال أفلا أكون عبدا شكورا (6) ويظهر من معناه أن ذلك كناية عن زيادة الرتبة فإن الشكر سبب المزيد قال تعالى {لئن شكرتم لأزيدنكم} وقال صلى الله عليه وسلم يا أبا هريرة أتريد أن تكون رحمة الله عليك حيا وميتا ومقبورا ومبعوثا قم من الليل","english":"As for the Qur'anic verses, there is the saying of Allah Most High: {«إِنَّ رَبَّكَ يَعْلَمُ أَنَّكَ تَقُومُ أَدْنَىٰ مِن ثُلُثَيِ اللَّيْلِ»} — the verse (Al-Muzzammil: 20) — and His saying: {«إِنَّ نَاشِئَةَ اللَّيْلِ هِيَ أَشَدُّ وَطْئًا وَأَقْوَمُ قِيلًا»} (Al-Muzzammil: 6), and His saying, Glorified and Exalted: {«تَتَجَافَىٰ جُنُوبُهُمْ عَنِ الْمَضَاجِعِ»} (Al-Sajdah: 16), and His saying: {«أَمَّنْ هُوَ قَانِتٌ آنَاءَ اللَّيْلِ»} — the verse (Al-Zumar: 9), and His saying, Mighty and Majestic: {«وَالَّذِينَ يَبِيتُونَ لِرَبِّهِمْ سُجَّدًا وَقِيَامًا»} (Al-Furqan: 64), and His saying: {«وَاسْتَعِينُوا بِالصَّبْرِ وَالصَّلَاةِ»} (Al-Baqarah: 45). It is said that this refers to night prayer — one seeks aid through patience upon it in the struggle against the soul (*mujāhadat al-nafs*).","book_title":"Contemplation","section_title_ar":"Section 272","section_title_en":"The Virtue of Reviving the Time Between the Two Evening Prayers (Maghrib and ʿIshāʾ) — The Virtue of Night Prayer (Qiyām al-Layl)","section_index":272,"anchors":"- Root: ليل (Layl)\n  * Lisan / Ayn: The root denotes the night, from sunset to dawn; its plural forms include *layāl* and *layālī*. Al-Farahidi notes its archaic derivation from *laylāh*.\n  * Al-Raghib (Mufradat): The night is a divinely ordained sign and period of worship; Allah says {«وَسَخَّرَ لَكُمُ اللَّيْلَ وَالنَّهَارَ»} (Ibrahim: 33) and swears by it in {«وَاللَّيْلِ إِذَا يَغْشَىٰ»} (Al-Layl: 1). It is the chosen time for the *nāshiʾah* — the prayer that rises by night.\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): the night as a temporal span. Metaphorical (*majāz*): \"a night of hardship\" or the soul's \"night\" of heedlessness. Here, the night is the literal arena for supererogatory worship.\n- Root: وفي (Wafā)\n  * Lisan / Ayn: Completeness, fulfillment, and reaching full measure. A thing that is *wāfin* is complete and whole.\n  * Al-Raghib (Mufradat): *Al-Wāfī* is that which has reached completion. Allah says {«وَأَوْفُوا بِعَهْدِي أُوفِ بِعَهْدِكُمْ»} (Al-Baqarah: 40). The night prayer is described as {«أَقْوَمُ قِيلًا»} — more upright in speech and more complete in its effect upon the heart.\n  * Al-Zamakhshari (Asas): Literal: a full measure or complete thing. Metaphorical: \"he reached the hundred\" (*awfā ʿalā al-miʾah*), i.e., surpassed it. The night prayer \"fulfills\" the soul's potential for nearness to Allah.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and has life. Al-Farahidi connects it to *nafas* (breath) and *nufūs* (precious things).\n  * Al-Raghib (Mufradat): The *nafs* is the rational soul and the seat of moral struggle (*mujāhadah*). Allah says {«إِنَّ النَّفْسَ لَأَمَّارَةٌ بِالسُّوءِ»} (Yusuf: 53). The ḥadīth describes the one who prays at night as becoming \"good of soul\" (*ṭayyib al-nafs*), while the sluggard becomes \"evil of soul\" (*khabīth al-nafs*).\n  * Al-Zamakhshari (Asas): Literal: the self or person. Metaphorical: \"he poured out his soul\" (i.e., his blood). Here, the *nafs* is the battlefield between the worshipper and the devil's whisperings.\n- Root: خبر (Khabar)\n  * Lisan / Ayn: News, report, or information; also experience and knowledge of a thing's inner state.\n  * Al-Raghib (Mufradat): *Al-Khabar* is knowledge of things through report. The *akhbār* (plural) are the prophetic traditions cited as evidence alongside the Qur'anic verses.\n  * Al-Zamakhshari (Asas): Literal: to test or try a thing to know its state. Metaphorical: \"his mirror reports of his unknown\" — i.e., reveals what is hidden. The *akhbār* here are the authoritative reports from the Prophet (ﷺ).\n- Sibawayh Rule: The rule of *al-ʿaṭf ʿalā al-sabab* (coordination on a cause) — when multiple conditions are linked by *fa* (then), each is a consequence of the preceding, as in the ḥadīth of the three knots: \"If he wakes and remembers Allah, a knot is untied; if he performs ablution, a knot is untied; if he prays, a knot is untied\" — each act builds upon the previous, and the *fa* indicates sequential causation.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'","badge":"Insight"},{"arabic":"سبعين مرة (3) هذا مع أنه صلى الله عليه وسلم غفر له ما تقدم من ذنبه وما تأخر وقال صلى الله عليه وسلم إنه ليغان على قلبي حتى إني لأستغفر الله تعالى في كل يوم مائة مرة (4) وقال صلى الله عليه وسلم من قال حين يأوي إلى فراشه أستغفر الله العظيم الذي لا إله إلا هو الحي القيوم وأتوب إليه ثلاث مرات غفر الله له ذنوبه وإن كانت مثل زبد البحر أو عدد رمل عالج أو عدد ورق الشجر أو عدد أيام الدنيا (5) وقال صلى الله عليه وسلم في حديث آخر من قال ذلك غفرت ذنوبه وإن كان فارا من الزحف (6) وقال حذيفة كنت ذرب اللسان على أهلي فقلت يا رسول الله","english":"God Most High said: {«والذين إذا فعلوا فاحشة أو ظلموا أنفسهم ذكروا الله فاستغفروا لذنوبهم»} — \"And those who, when they commit an indecency or wrong themselves, remember God and seek forgiveness for their sins\" {آل عمران/135}.","book_title":"On Invocations and Supplications","section_title_ar":"Section 246","section_title_en":"On Seeking Forgiveness (Al-Istighfar) — Section 246","section_index":246,"anchors":"- Root: ذنب (dhanb)\n  * Lisan / Ayn: Core meaning of \"tail\" or \"taking hold of a tail\"; extended to signify a sin as that which trails behind and follows a person.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin is that by which one is seized and held accountable; used metaphorically for a fault that clings to its perpetrator.\n  * Al-Zamakhshari (Asas): Literal: tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as that which trails the soul and must be severed through repentance.\n- Root: غفر (ghafara)\n  * Lisan / Ayn: Covering, veiling, protecting from defilement; a shield or helmet (المغفر).\n  * Al-Raghib (Mufradat): \"الغفران والمغفرة من الله هو أن يصون العبد من أن يمسه العذاب\" — divine forgiveness is God's protection of the servant from being touched by punishment.\n  * Al-Zamakhshari (Asas): Literal: to cover and protect. Metaphorical: God's \"covering\" of sins — not merely erasure, but active safeguarding of the sinner from consequence.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The frequent interposition of \"يا رب\" and vocative constructions between the subject and predicate in supplicatory sentences, as in \"اللهم اغفر لي,\" where the vocative particle governs the imperative verb's addressee, reflecting the grammatical permissibility of separation between governing and governed elements in invocational speech.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'","badge":"Du'a"}],"4":[{"arabic":"إيمانا وقال تعالى ليزدادوا إيمانا مع إيمانهم وقال صلى الله عليه وسلم فيما يروى في بعض الأخبار الإيمان يزيد وينقص (2) وذلك بتأثير الطاعات في القلب وهذا لا يدركه إلا من راقب أحوال نفسه في أوقات المواظبة على العبادة والتجرد لها بحضور القلب مع أوقات الفتور وإدراك التفاوت في السكون إلى عقائد الإيمان في هذه الأحوال حتى يزيد عقده استعصاء على من يريد حله بالتشكيك بل من يعتقد في اليتيم معنى الرحمة إذا عمل بموجب اعتقاده فمسح رأسه وتلطف به أدرك من باطنه تأكيد الرحمة وتضاعفها بسبب العمل وكذلك مع","english":"And this exists in the true conviction as well. Works effect the growth of this resolve and its increase, just as the watering of trees effects their growth. For this reason God — exalted — said: {فزادتهم إيمانا} \"And it increased them in faith\" {«فزادتهم إيمانا»} and said: {ليزدادوا إيمانا مع إيمانهم} \"That they might increase in faith upon their faith\" {«ليزدادوا إيمانا مع إيمانهم»}. And the Prophet — peace be upon him — said, as narrated in some reports: \"Faith increases and decreases\" (2). That is by the effect of acts of obedience upon the heart. This is perceived only by one who watches over the states of his soul — in the times of persevering in worship and devoting oneself to it with presence of heart — as against the times of languor, and perceives the disparity in tranquility (sukūn) toward the tenets of faith in these states, until his knot increases in resistance to anyone who would undo it by casting doubt. Nay, consider one who holds the meaning of mercy toward an orphan: if he acts upon the requirement of his conviction — wiping the orphan's head and being kind to him — he perceives within his inner self the reinforcement of mercy and its multiplication by reason of the work. Likewise, one who holds the conviction of humility: if he acts upon its requirement — advancing or prostrating before another — he senses in his heart the humility when he undertakes the service.","book_title":"Foundations of Belief","section_title_ar":"Section 100","section_title_en":"On the Increase and Decrease of Faith (Al-Īmān) — Section 100","section_index":100,"anchors":"- Root: زيد (z-y-d)\n  * Lisan / Ayn: Core meaning of increase in quantity, quality, or degree; augmentation upon a pre-existing base.\n  * Al-Raghib (Mufradat): Increase (ziyādah) presupposes an existing essence (dhāt) that receives accretion; it is not constitutive of the thing's existence but an accident upon it.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage applies to corporeal growth (e.g., a man's height); metaphorical (majāz) usage extends to spiritual and moral states, where increase is by qualities, not by essence.\n- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Firmness, veracity, and strength of conviction; the root implies solidity without fissure.\n  * Al-Raghib (Mufradat): Taṣdīq (assent) is the heart's affirmation of a reported truth, distinguished from mere knowledge by its volitional and settled character.\n  * Al-Zamakhshari (Asas): Literal: confirming a statement as true. Metaphorical: the heart's unwavering resolution (taṣmīm) that admits of degrees of intensity.\n- Root: عقد (ʿ-q-d)\n  * Lisan / Ayn: Tying, knotting, binding; a knot (ʿuqdah) that holds fast or loosens.\n  * Al-Raghib (Mufradat): Contract or covenant; here extended to the heart's conviction as a binding knot that strengthens or weakens.\n  * Al-Zamakhshari (Asas): Literal: physical knotting of a rope. Metaphorical: the firmness of belief as a knot in the heart, subject to tightening and loosening.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the referent of \"faith\" (īmān) to taṣdīq alone, excluding works from its essence while affirming their augmentative role.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'","badge":"Insight"}],"5":[{"arabic":"نفسه وعلم ذلك كان كذلك عند الله وكذا من كان مسرورا أو حزينا أو سميعا أو بصيرا ولو قيل للإنسان هل أنت حيوان لم يحسن أن يقول أنا حيوان إن شاء الله ولما قال سفيان ذلك قيل له فماذا نقول قال قولوا آمنا بالله وما أنزل إلينا وأي فرق بين أن يقول آمنا بالله وما أنزل إلينا وبين أن يقول أنا مؤمن وقيل للحسن أمؤمن أنت فقال إن شاء الله فقيل له لم تستثني يا أبا سعيد في الإيمان فقال أخاف أن أقول نعم فيقول الله سبحانه كذبت يا حسن فتحق علي الكلمة وكان يقول ما يؤمنني أن يكون الله سب","english":"If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"","book_title":"Foundations of Belief","section_title_ar":"Section 102","section_title_en":"On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102","section_index":102,"anchors":"- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'","badge":"Hadith"}],"12":[{"arabic":"بربكم أرداكم وقال تعالى وظننتم ظن السوء وكنتم قوما بورا وقال صلى الله عليه وسلم إن الله تعالى يقول للعبد يوم القيامة ما منعك إذ رأيت المنكر أن تنكره فإن لقنه الله حجته قال يا رب رجوتك وخفت الناس قال فيقول الله تعالى قد غفرته لك (4) وفي الخبر الصحيح أن رجلا كان يداين الناس فيسامح الغني ويتجاوز عن المعسر فلقي الله ولم يعمل خيرا قط فقال الله عز وجل من أحق بذلك منا (5) فعفا عنه لحسن ظنه ورجائه أن يعفو عنه مع إفلاسه عن الطاعات وقال تعالى إن الذين يتلون كتاب الله وأقاموا الصلاة وأنفقوا مما رزقناهم سرا وع","english":"The Prophet, peace be upon him, said: \"Let not one of you die except while he holds a good opinion of God, the Exalted.\" (1) And he, peace be upon him, said: \"God, the Mighty and Majestic, says: I am as My servant thinks of Me, so let him think of Me whatever he wishes.\" (2)","book_title":"Fear and Hope","section_title_ar":"Section 1031","section_title_en":"On the Excellence of Good Opinion of God and the Virtue of Hope (Section 1031)","section_index":1031,"anchors":"- Root: ظن (Ẓann)\n  * Lisan / Ayn: Core meaning oscillates between certainty and doubt; in theological usage, predominates as \"belief/opinion\" regarding God's attributes and acts.\n  * Al-Raghib (Mufradat): Al-ẓann denotes a preponderant belief (iʿtiqād rājiḥ) that admits of contrary possibility; when coupled with God (ḥusn al-ẓann billāh), it signifies the servant's confident trust in divine mercy and forgiveness, not mere conjecture.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — doubt mixed with certainty; Metaphorical (majāz) — in the ḥadīth \"I am as My servant thinks of Me,\" it is transferred to the heart's settled reliance on God's beneficence, for God's actual response is entailed by His own decree, not by the servant's thought.\n- Root: رجو (Rajā')\n  * Lisan / Ayn: Expectation of something desirable with attendant effort; opposite of yaʾs (despair).\n  * Al-Raghib (Mufradat): Rajā' is the heart's aspiration toward a good whose attainment is possible; it is praiseworthy only when accompanied by fear (khawf) and action, for pure hope without works is delusion (ghurūr).\n  * Al-Zamakhshari (Asas): Literal — awaiting rain (rajāʾ al-ghayth); Metaphorical — the soul's yearning for divine pardon, as in the verse {يَرْجُونَ تِجَارَةً لَنْ تَبُورَ} (they hope for a commerce that will never perish).\n- Root: قنط (Qanaṭa)\n  * Lisan / Ayn: Despair of good; severance of hope.\n  * Al-Raghib (Mufradat): Qunūṭ is the cessation of expectation of divine mercy, which is blameworthy and tantamount to disbelief in God's power to forgive.\n  * Al-Zamakhshari (Asas): Literal — drought-stricken land yielding no vegetation; Metaphorical — the soul barren of hope, as in {وَكُنْتُمْ قَوْمًا بُورًا} (you were a ruined people).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The ḥadīth \"أنا عند ظن عبدي بي\" employs the prepositional phrase \"بي\" as a complement to \"ظن,\" governing the servant's cognitive stance toward God; the interposition of \"عبدي\" between the noun and its complement emphasizes the possessive intimacy of the servant's relation to his Lord.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Fear and Hope'","badge":"Hadith"}],"13":[{"arabic":"القبائل من لم يؤمن بالله واليوم الآخر وكانوا عند الله شرا من الكلاب وأخس من الخنازير ولذلك قال تعالى {يا أيها الناس إنا خلقناكم من ذكر وأنثى} أي لا تفاوت في أنسابكم لاجتماعكم في أصل واحد ثم ذكر فائدة النسب فقال {وجعلناكم شعوبا وقبائل لتعارفوا} ثم بين أن الشرف بالتقوى لا بالنسب فقال {إن أكرمكم عند الله أتقاكم} ولما قيل لرسول الله صلى الله عليه وسلم من أكرم الناس من أكيس الناس لم يقل من ينتمي إلى نسبي ولكن قال أكرمهم أكثرهم للموت ذكرا وأشدهم له استعدادا (1) حديث إن الله قد أذهب ع","english":"The fourth: pride in noble lineage, like the pride of the Hashimite, to the point that some of them imagine that they will be saved by the nobility of their lineage and the salvation of their forefathers, and that they are forgiven; and some of them fancy that all of creation are their clients and slaves. Its remedy is that he should know that whenever he contradicts his forefathers in their deeds and their moral traits, yet imagines himself to be joined with them, he has indeed been ignorant. And if he emulates his forefathers, then their moral traits were not pride, but rather fear, self-contempt, magnifying others, and self-blame. For they were ennobled by obedience, knowledge, and praiseworthy qualities — not by lineage. So let him seek honor through that by which they were honored. For those who shared their lineage and participated with them in their tribes, yet did not believe in God and the Last Day, were in God's sight worse than dogs and viler than swine. For this reason God (Exalted is He) said: {«يا أيها الناس إنا خلقناكم من ذكر وأنثى»} — \"O mankind, indeed We have created you from a male and a female\" — that is, there is no disparity in your lineages because you all share a single origin. Then He mentioned the benefit of lineage, saying: {«وجعلناكم شعوبا وقبائل لتعارفوا»} — \"And We made you peoples and tribes that you may know one another.\" Then He clarified that honor is by piety, not by lineage, saying: {«إن أكرمكم عند الله أتقاكم»} — \"Indeed, the most noble of you in the sight of God is the most righteous of you.\" And when it was said to the Messenger of God (peace and blessings be upon him), \"Who is the most noble of people?\" — he did not say, \"Whoever traces himself to my lineage,\" but rather he said, \"The most noble of them is the one most mindful of death and the most prepared for it.\" (1) A hadith: \"Indeed, God has removed from you the pride of the Age of Ignorance\" — this hadith was transmitted by Abu Dawud and al-Tirmidhi, who deemed it sound (ḥasan), from the narration of Abu Hurayrah; al-Tirmidhi also narrated it from the narration of Ibn ʿUmar and said it is gharīb (uncommon).","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 881","section_title_en":"The Book of the Revival of the Religious Sciences — Section 881: On the Wonders of Pride in Strength, Intellect, and Lineage, and Their Remedies","section_index":881,"anchors":"- Root: عقل (ʿaql)\n  * Lisan / Ayn: The faculty of restraint and comprehension; the intellect as that which binds one from error.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — the power prepared for receiving knowledge, and the knowledge acquired thereby.\n  * Al-Zamakhshari (Asas): Literal: sound judgment after folly; Metaphorical: \"نخلة لا تعقل الإبار\" — a palm that does not accept pollination, i.e., lacks receptivity.\n- Root: نسب (nasab)\n  * Lisan / Ayn: Lineage and kinship through forebears.\n  * Al-Raghib (Mufradat): \"النسب والنسبة: اشتراك من جهة أحد الأبوين\" — participation through one of the two parents; two types: vertical (through ancestors) and horizontal (through collaterals).\n  * Al-Zamakhshari (Asas): Literal: \"فلان حسيب نسيب\" — noble in deed and lineage; Metaphorical: \"بين الشيئين مناسبة\" — proportionality or correspondence between things.\n- Root: حدث (ḥadath)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — a thing's coming to be after it was not; \"المحدث: ما أوجد بعد أن لم يكن\" — the originated.\n  * Al-Zamakhshari (Asas): Literal: recent events; Metaphorical: \"كان عمر رضي الله عنه محدثا\" — one inspired with true discernment.\n- Root: نفس (nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the spirit; also the very essence (dhāt) when attributed to God.\n  * Al-Zamakhshari (Asas): Literal: preciousness; Metaphorical: \"دفق نفسه\" — poured out his blood, i.e., his life.\n- Sibawayh Rule: Rule of Interposition (الفصل بين الجار والمجرور) — governing the permissible separation between a governing word and its governed prepositional phrase, applied here to parse the conditional and relative clauses conveying causal relations between pride and its consequences.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'","badge":"Insight"}],"17":[{"arabic":"وخطب رجل عند رسول الله صلى الله عليه وسلم فقال من يطع الله ورسوله فقد رشد ومن يعصهما فقد غوى فقال قل ومن يعص الله ورسوله فقد غوى (2) فكره رسول الله صلى الله عليه وسلم قوله ومن يعصهما لأنه تسوية وجمع وكان إبراهيم يكره أن يقول الرجل أعوذ بالله وبك ويجوز أن يقول أعوذ بالله ثم بك وأن يقول لولا الله ثم فلان ولا يقول لولا الله وفلان وكره بعضهم أن يقال اللهم أعتقنا من النار وكان يقول العتق يكون بعد الورود وكانوا يستجيرون من النار ويتعوذون من النار وقال رجل اللهم اجعلني ممن تصيبه شفاعة محمد صلى الله عليه وسلم فق","english":"An example of this is what Ḥudhayfah reported: The Prophet, peace be upon him, said: \"Let none of you say: 'What Allah willed and you willed' — but rather let him say: 'What Allah willed, then you willed.'\" (5) This is because in the absolute conjunction [with \"and\"] there is an association and an equalization, which is contrary to [the due measure of] reverence. And Ibn ʿAbbās, may Allah be pleased with them both, said: A man came to the Messenger of Allah, peace be upon him, speaking to him concerning some matter, and he said: \"What Allah willed and you willed.\" The Prophet, peace be upon him, said: \"Have you made me an equal to Allah? Rather, [say]: 'What Allah willed alone.'\" (1)","book_title":"Condemnation of Anger and Hatred","section_title_ar":"Section 698","section_title_en":"The Revival of the Religious Sciences — Section 698: The Nineteenth Affliction — Heedlessness Regarding Subtle Errors in the Import of Speech","section_index":698,"anchors":"- Root: غفل (ghafla)\n  * Lisan / Ayn: Core meaning of heedlessness, neglect, and inattention; the absence of vigilance over a matter.\n  * Al-Raghib (Mufradat): Heedlessness (al-ghafla) is the soul's failure to attend to what it is obligated to know or consider; it is the opposite of mindfulness (al-tayaqquẓ) and remembrance (al-dhikr).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the absence of guarding; metaphorical (majāz) usage extends to the tongue's straying from precise expression in sacred matters.\n- Root: عطف (ʿaṭf)\n  * Lisan / Ayn: Inclination, turning, or joining one thing to another; grammatically, the conjunction that links two items in a shared ruling.\n  * Al-Raghib (Mufradat): Joining (al-ʿaṭf) implies equal treatment of the conjoined items; in theological speech, absolute conjunction (al-ʿaṭf al-muṭlaq) with Allah entails an inadmissible association.\n  * Al-Zamakhshari (Asas): Literal: the bending of a staff or the inclining of a branch; metaphorical: the grammatical coupling that levels two referents under one predicate.\n- Root: شرك (shirk)\n  * Lisan / Ayn: Sharing, partnership, or association; the root of polytheism (al-shirk) as the ascription of a partner to Allah.\n  * Al-Raghib (Mufradat): Association (al-shirk) is the equalization of two things in a shared ruling; in theology, it is the gravest form when applied to the Divine, whether in belief or in the mere wording of speech.\n  * Al-Zamakhshari (Asas): Literal: co-participation in ownership; metaphorical: any verbal or creedal equalization of the creature with the Creator.\n- Sibawayh Rule: Rule of Conjunction (al-ʿaṭf) and Restriction (al-ḥaṣr) — The particle \"thumma\" (then) indicates sequential ordering and distinction of rank, whereas \"wa\" (and) denotes absolute conjunction and mutual equivalence; thus the Prophet's command to replace \"wa\" with \"thumma\" in \"what Allah willed and you willed\" is a syntactic correction to abolish the implication of equal partnership.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Anger and Hatred'","badge":"Du'a"}],"23":[{"arabic":"سنة الله تعالى في خلقه ولن تجد لسنة الله تبديلا فلا يخلق الله حركة اليد بكتابة منظومة ما لم يخلق فيها صفة تسمى قدرة وما لم يخلق فيها حياة وما لم يخلق إرادة مجزومة ولا يخلق الإرادة المجزومة ما لم يخلق شهوة وميلا في النفس ولا ينبعث هذا الميل انبعاثا تاما ما لم يخلق علما بأنه موافق للنفس إما في الحال أو في المآل ولا يخلق العلم أيضا إلا بأسباب أخر ترجع إلى حركة وإرادة وعلم فالعلم والميل الطبيعي أبدا يستتبع الإرادة الجازمة والقدرة والإرادة أبدا تستردف الحركة وهكذا الترتيب في كل فعل والكل من اختراع","english":"Know that the obligation of repentance is made evident by the transmitted reports (1) and the Quranic verses, and it is clear by the light of inner vision (nūr al-baṣīrah) for the one whose insight has been opened and whose breast God has expanded with the light of faith, until he is able to walk by his light which is before him through the darknesses of ignorance, independent of a guide to lead him at every step. For the wayfarer is either blind, not independent of a guide in his steps, or sighted, guided to the beginning of the road and then guided by himself. Likewise, people on the path of religion are divided according to this division. There is the deficient one who cannot surpass emulation (taqlīd) in his steps, and thus needs to hear at every footfall a text from the Book of God or the Sunnah of His Messenger — and perhaps that fails him, and he becomes bewildered. The journeying of this one, even if his life is long and his effort great, is short, and his steps are deficient. And there is the fortunate one whose breast God has expanded for Islam, and he is upon a light from his Lord. He is alerted by the slightest indication to traverse a rugged path and to cut through exhausting obstacles, and the light of the Quran and the light of faith shine in his heart. Due to the intensity of the light of his inner being, he is satisfied with the slightest explanation, as if his oil were about to glow even if fire did not touch it — and when fire touches it, it is light upon light. {«يَهْدِي اللَّهُ لِنُورِهِ مَنْ يَشَاءُ»} God guides to His light whom He wills. This one does not need a transmitted text in every occurrence. So whoever is in this state, when he wishes to know the obligation of repentance, he looks first with the light of inner vision at what repentance is, then at what the meaning of obligation is, then he combines the meaning of obligation with repentance and does not doubt its being established for it. That is, by knowing that the meaning of \"the obligatory\" is that which is necessary for reaching the felicity of eternity and for deliverance from the perdition of eternity. For were it not for the attachment of felicity and misery to the doing of a thing or its abandonment, there would be no meaning to describing it as obligatory. And the saying of one who says, \"It became obligatory by an act of imposition,\" is pure idle talk. For that in whose doing or abandoning we have no interest, whether in the hereafter or in this world, has no meaning for our occupying ourselves with it, whether another imposed it upon us or did not impose it. So when he knows the meaning of obligation — that it is the means to the felicity of eternity — and knows that there is no felicity in the abode of permanence except in the encounter (liqāʾ) of God Most High, and that everyone veiled from Him is miserable without exception, cut off from what he desires, burned by the fire of separation and the fire of Hell; and knows that nothing distances from the encounter of God except the following of passions and intimacy with this perishing world and clinging to the love of what must inevitably be parted from; and knows that nothing brings near to the encounter of God except severing the heart's attachment from the ornament of this world and turning wholly to God, seeking intimacy with Him through the constancy of His remembrance, and love for Him through knowledge of His majesty and beauty to the extent of one's capacity; and knows that sins — which are a turning away from God and a following of what the devils, the enemies of God who distance from His presence, love — are the cause of one's being veiled and distanced from God Most High — then he does not doubt that turning away from the path of distance is obligatory for reaching proximity. And turning away is only completed by knowledge, remorse, and resolve. For as long as he does not know that sins are causes of distance from the Beloved, he will not regret nor feel pain due to his traveling the path of distance; and as long as he does not feel pain, he will not return; and the meaning of returning is abandoning and resolving. So he does not doubt that the three meanings are necessary for reaching the Beloved. And such is the faith that results from the light of inner vision.","book_title":"Love, Longing, Intimacy and Contentment","section_title_ar":"Section 917","section_title_en":"The Obligation of Repentance: Its Reality, Its Proofs, and the Reconciliation of Divine Decree with Human Agency","section_index":917,"anchors":"- Root: توب (T-W-B)\n  * Lisan / Ayn: Core meaning is \"return\" (rujūʿ) — the act of turning back from a path one was on.\n  * Al-Raghib (Mufradat): In theological usage, it signifies returning from sin (dhamb) to obedience, and from distance (buʿd) from God to proximity (qurb) to Him. It is the servant's reversion to his original, sound nature.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is \"returning\"; metaphorical (majāz) extension applies it to the heart's turning away from the pursuit of worldly desires (shahawāt) toward the remembrance of God.\n- Root: وجب (W-J-B)\n  * Lisan / Ayn: Core meaning is \"to be established, fixed, or necessary\" — something whose non-existence entails a contradiction or harm.\n  * Al-Raghib (Mufradat): The obligatory (wājib) is that which, if neglected, incurs blame; it is divided into what is obligatory by reason (ʿaql) and what is obligatory by revelation (sharʿ).\n  * Al-Zamakhshari (Asas): Literal sense: \"to be due\" or \"to fall\" (as in a price being fixed); metaphorical sense: the soul's \"falling\" into action out of necessity.\n- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: Core meaning is \"measuring\" or \"estimating\" (taqdīr) — bringing something into existence according to a precise measure.\n  * Al-Raghib (Mufradat): Used for creation from nothing (ibdāʿ) and for bringing something forth from another thing; all of God's acts are measured by His eternal decree.\n  * Al-Zamakhshari (Asas): Literal: the artisan's measuring of leather before cutting; Metaphorical: God's origination of creation upon a measure necessitated by wisdom.\n- Root: كسب (K-S-B)\n  * Lisan / Ayn: Core meaning is \"to acquire\" or \"to earn\" — an act that returns a benefit or harm to the agent.\n  * Al-Raghib (Mufradat): In Kalam, acquisition (kasb) denotes the creature's relation to an act that is entirely God's creation, yet is attributed to the servant by way of his being the locus of its occurrence.\n  * Al-Zamakhshari (Asas): Literal: to gather wealth; Metaphorical: the soul's \"gathering\" of deeds that cling to it as its own.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — used to delimit the meaning of \"obligation\" to its true referent (the means to eternal felicity), and to restrict the attribution of acts to God alone as their sole Creator.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'","badge":"Insight"}],"26":[{"arabic":"قال الله تعالى {إذ جعل الذين كفروا في قلوبهم الحمية حمية الجاهلية فأنزل الله سكينته على رسوله وعلى}","english":"In the name of God, the Most Merciful, the Most Compassionate. Praise be to God, upon whose pardon and mercy none rely except the hopeful, and from whose evil wrath and assault none fear except the fearful — He who gradually seizes His servants from whence they know not, and who has given dominion over them to their lusts, commanding them to abandon what they desire, and who has tried them with anger while charging them to swallow their rage in what provokes them. Then He surrounded them with hardships and pleasures, and granted them respite to see how they would act. He tested their love through them, to make known the truth of what they claim. He made known to them that nothing is hidden from Him of what they conceal or proclaim, and warned them lest He seize them suddenly while they are unaware. For He said: {«They await but a single blast which will seize them while they are disputing; so they will not be able to make a bequest, nor to their families will they return»} (Q. 36:49-50). And prayers and peace be upon Muhammad, His Messenger, beneath whose banner the prophets walk, and upon his family and companions — the rightly-guided imams and the pleasing masters — prayers whose number equals the number of what has been of God's creation and what will be, and by whose blessing the first and the last are favored — and abundant peace.","book_title":"Condemnation of Envy","section_title_ar":"Section 700","section_title_en":"The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences","section_index":700,"anchors":"- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Envy'","badge":"Du'a"}],"27":[{"arabic":"صلى الله عليه وسلم في النوم حتى نزل قوله تعالى لقد صدق الله ورسوله الرؤيا بالحق (4) وقلما يخلوا الإنسان عن منامات دلت على أمور فوجدها صحيحة والرؤيا ومعرفة الغيب في النوم من عجائب صنع الله تعالى وبدائع فطرة الآدمي وهو من أوضح الأدلة على عالم الملكوت والخلق غافلون عنه كغفلتهم عن سائر عجائب القلب وعجائب العالم والقول في حقيقة الرؤيا من دقائق علوم المكاشفة فلا يمكن ذكره علاوة على علم المعاملة ولكن القدر الذي يمكن ذكره ههنا مثال يفهمك المقصود وهو أن تعلم أن القلب مثاله مثال مرآة تتراءى فيها الصور وحقائق الأمور وأن كل ما قدره","english":"Know that the lights of inner insights (anwār al-baṣā'ir) derived from the Book of God—mighty and majestic is He—and from the Sunnah of His Messenger—may God's peace and blessings be upon him—and from the pathways of reflective consideration, make known to us the states of the dead in general and their division into the blessed and the wretched. But the specific case of Zayd and ʿAmr in particular is not disclosed at all. For if we rely upon the faith of Zayd and ʿAmr, we do not know upon what they died nor how their end was sealed for them. And if we rely upon their outward righteousness, then piety (taqwā) has its seat in the heart, and it is hidden—concealed even from the possessor of that piety himself—so how then from others? Thus there is no ruling for outward righteousness apart from inward piety. God—exalted is He—said: {«إنما يتقبل الله من المتقين»} [\"God only accepts from the God-fearing\"] (Al-Mā'idah 5:27). So the knowledge of the judgment concerning Zayd and ʿAmr is not possible except by witnessing them and witnessing what transpires upon them. And when one dies, he has transferred from the world of dominion and testimony (ʿālam al-mulk wa al-shahādah) to the world of the unseen and the kingdom (ʿālam al-ghayb wa al-malakūt), so he is not seen by the outward eye. Rather, he is seen only by another eye—that eye being created in the heart of every human being. But upon it has been placed a dense covering (ghishāwah) of his lusts and worldly preoccupations, so that he does not see with it, nor is it conceivable that he should see with it anything of the realm of the kingdom (malakūt) unless that covering is peeled away from the eye of his heart.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1327","section_title_en":"The Unveiling of the Veil: On the Vision of the Dead and the Reality of Dreams","section_index":1327,"anchors":"- Root: بصر (B-Ṣ-R)\n  * Lisan / Ayn: Inner perception and discernment; the eye as an organ of sight versus the \"insight\" (baṣīrah) as the heart's eye.\n  * Al-Raghib (Mufradat): Baṣīrah is the perception of the heart, a spiritual sight (ru'yah qalbiyyah) that penetrates to realities, distinct from mere ocular vision.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sight is of the physical eye; metaphorical (majāz) sight is the heart's illumination by which hidden truths are disclosed.\n- Root: كشف (K-Sh-F)\n  * Lisan / Ayn: Removal of a covering; disclosure of what is concealed.\n  * Al-Raghib (Mufradat): Kashf in the theological sense is the lifting of the veil (ghishāwah) from the heart so that the unseen realm (malakūt) becomes manifest.\n  * Al-Zamakhshari (Asas): Literal: uncovering a physical object; metaphorical: revelation of meanings and hidden affairs to the inner eye.\n- Root: لوح (L-W-Ḥ)\n  * Lisan / Ayn: A tablet or board upon which writing appears; also the flat bones of the body.\n  * Al-Raghib (Mufradat): The Preserved Tablet (al-Lawḥ al-Maḥfūẓ) is that upon which all destinies are inscribed; its modality is unknown to us save by report.\n  * Al-Zamakhshari (Asas): Literal: a wooden plank; metaphorical: the divine register of all that was and will be, not corporeal but a subtle reality.\n- Root: مثل (M-Th-L)\n  * Lisan / Ayn: Likeness, similitude, example; to stand in representation of another.\n  * Al-Raghib (Mufradat): Mathal is the analogical representation by which an absent or abstract reality is brought near to understanding through a present likeness.\n  * Al-Zamakhshari (Asas): Literal: a resembling image; metaphorical: the parabolic example (mithāl) used to approximate what transcends sensory grasp.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle \"innamā\" confines the predicate to the subject alone, as in \"إنما يتقبل الله من المتقين,\" restricting divine acceptance exclusively to the God-fearing, a syntactic anchor for the theological point that outward piety without inward taqwā avails nothing.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"},{"arabic":"(5) وقوله تعالى {لقد جاءكم رسول من أنفسكم} إلى آخرها (6) وقوله تعالى {لقد صدق الله رسوله الرؤيا بالحق} إلى آخرها (7) وقوله سبحانه الحمد لله الذي لم يتخذ ولدا (8) الآية وخمس آيات من أول الحديد (9) وثلاثا من آخر سورة الحشر (10) وإن قرأ المسبعات العشر التي أهداها الخضر عليه السلام إلى إبراهيم التيمي رحمه الله ووصاه أن يقولها غدوة وعشية فقد استكمل الفضل وجمع له ذلك فضيلة جملة الأدعية المذكورة فقد روي عن كرز بن وبرة رحمه الله وكان من الأبدال قال أتاني أخ لي من أهل الشام فأهدى لي هدية وقال يا كرز اقبل مني هذه الهدية فإنها نع","english":"Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}","book_title":"Arrangement of Litanies","section_title_ar":"Section 260","section_title_en":"The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)","section_index":260,"anchors":"- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'","badge":"Du'a"},{"arabic":"الاستقبال كقوله تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رؤوسكم ومقصرين وكقوله ألم غلبت الروم في أدنى الأرض وهم من بعد غلبهم سيغلبون في بضع سنين ووجه دلالة المعجزة على صدق الرسل أن كل ما عجز عنه البشر لم يكن إلا فعلا لله تعالى فمهما كان مقرونا بتحدي النبي صلى الله عليه وسلم ينزل منزلة قوله صدقت وذلك مثل القائل بين يدي 2 الملك المدعي على رعيته أنه رسول الملك إليهم فإنه مهما قال لذلك إن كنت صادقا فقم على سريرك ثلاثا واقعد على خلاف عادتك ففعل الملك ذلك حصل للحاضرين علم ضروري بأن ذلك نازل منزلة قوله صدقت الركن ا","english":"For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].","book_title":"Foundations of Belief","section_title_ar":"Section 96","section_title_en":"The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles","section_index":96,"anchors":"- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.","content_type":"general","topic":"Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Foundations of Belief'","badge":"Commentary"},{"arabic":"الاحتمال في كتاب الحلال والحرام إن شاء الله تعالى","english":"The second: that he thank the giver, supplicate for him, and praise him; and his gratitude and supplication should be such that it does not remove him from being a mere intermediary, but rather he is a channel for the arrival of God's blessing to him. And the channel has a right, insofar as God made him a channel and an intermediary — and that does not negate seeing the blessing as from God, Glorified be He. For he, peace and blessings be upon him, said: \"He who does not thank the people has not thanked God\" {«من لم يشكر الناس لم يشكر الله»}. And God, Mighty and Majestic, has praised His servants in places for their deeds, while He is their Creator and the Originator of the capacity for them — such as His saying, Exalted is He: {«نعم العبد إنه أواب»} [\"Excellent is the servant. Indeed, he is penitent.\"] — and other similar instances.","book_title":"Mysteries of Zakat","section_title_ar":"Section 179","section_title_en":"The Etiquette of the Recipient of Wealth: On the Virtue of Poverty and the Conduct of Taking from Others","section_index":179,"anchors":"- Root: كرم (karuma)\n  * Lisan / Ayn: Core root meaning: nobility, generosity, honorableness of origin and character.\n  * Al-Raghib (Mufradat): Theological nuance: Divine Generosity (al-Karam) as an attribute of God entailing beneficence (al-Ifḍāl) that is pure grace, not obligation.\n  * Al-Zamakhshari (Asas): Literal: nobility of lineage/character. Metaphorical: God's abundant giving without recompense.\n- Root: فضل (faḍala)\n  * Lisan / Ayn: Core root meaning: surplus, excess, superiority, that which remains beyond need.\n  * Al-Raghib (Mufradat): Theological nuance: God's Bounty (al-Faḍl) as gratuitous favor exceeding what is merited; distinct from justice ('Adl).\n  * Al-Zamakhshari (Asas): Literal: excess/surplus. Metaphorical: divine favor and grace.\n- Root: نعم (ni'ma)\n  * Lisan / Ayn: Core root meaning: well-being, bounty, benefaction; state of goodness.\n  * Al-Raghib (Mufradat): Theological nuance: al-Ni'ma as the good state (al-ḥālah al-ḥasanah) bestowed by God; its genus encompasses both little and much.\n  * Al-Zamakhshari (Asas): Literal: pleasant life and bounty. Metaphorical: \"خفت نعامتهم\" (their ostriches departed) — i.e., they went away, indicating the fleeting nature of worldly boons.\n- Root: قدر (qadara)\n  * Lisan / Ayn: Core root meaning: measure, extent, power, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-Qudrah for God is the negation of incapacity; for man, a capacity for specific acts. Al-Qadr: the divine measure/decree.\n  * Al-Zamakhshari (Asas): Literal: measure, amount, power. Metaphorical: \"فرس بعيد القدر\" (a horse of far-reaching stride) — extended reach.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the precise restriction of agency and causation in statements like \"إنما المنكر أن يرى الواسطة أصلا\" (The only objectionable thing is to regard the intermediary as the origin).","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Zakat'","badge":"Du'a"},{"arabic":"فيما لا يشك فيه بل قال تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رءؤسكم ومقصرين وكان الله سبحانه عالما بأنهم يدخلون لا محالة وأنه شاءه ولكن المقصود تعليمه ذلك فتأدب رسول الله صلى الله عليه وسلم في ما كان يخبر عنه معلوما كان أو مشكوكا حتى قال صلى الله عليه وسلم لما دخل المقابر السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون (1) واللحوق بهم غير مشكوك فيه ولكن مقتضى الأدب ذكر الله تعالى وربط الأمور به وهذه الصيغة دالة عليه حتى صار بعرف الاستعمال عبارة عن إظهار الرغبة والتمني فإذا قيل لك إن فلانا يموت سريعا فتقول إن شاء الله","english":"If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"","book_title":"Foundations of Belief","section_title_ar":"Section 102","section_title_en":"On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102","section_index":102,"anchors":"- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'","badge":"Insight"}],"29":[{"arabic":"واقترب وقال عز وجل سيماهم في وجوههم من أثر السجود فقيل هو ما يلتصق بوجوههم من الأرض عند السجود وقيل هو نور الخشوع فإنه يشرق من الباطن على الظاهر وهو الأصح وقيل هي الغرر التي تكون في وجوههم يوم القيامة من أثر الوضوء وقال صلى الله عليه وسلم إذا قرأ ابن آدم السجدة فسجد اعتزل الشيطان يبكي ويقول يا ويلاه أمر هذا بالسجود فسجد فله الجنة وأمرت أنا بالسجود فعصيت فلي النار (6) ويروى عن علي بن عبد الله بن عباس أنه كان يسجد في كل يوم ألف سجدة وكانوا يسمونه السجاد ويروى أن عمر بن عبد العزيز رضي ا","english":"The Messenger of God — peace be upon him — said: \"The servant draws near to God through nothing better than a hidden prostration.\" (2) And the Messenger of God — peace be upon him — said: \"No Muslim prostrates to God with a single prostration, except that God raises him by it a degree and removes from him by it a sin.\" (3) And it is related that a man said to the Messenger of God — peace be upon him: \"Supplicate God to make me among the people of your intercession and to grant me your companionship in Paradise.\" He — peace be upon him — said: \"Help me by multiplying prostration.\" (4) And it was said: \"The closest that the servant is to God — Mighty and Majestic — is when he is prostrating.\" (5) And this is the meaning of His saying — Glorified and Exalted: {«واسجد واقترب»} (\"Prostrate and draw near\") (Q. 96:19). And He — Glorified and Exalted — said: {«سيماهم في وجوههم من أثر السجود»} (\"Their mark is on their faces from the trace of prostration\") (Q. 48:29). It was said: \"It is the dust that clings to their faces during prostration.\" And it was said: \"It is the light of reverence (nūr al-khushūʿ), for it radiates from the inward to the outward\" — and this is the most sound opinion. And it was said: \"It is the radiant whiteness (al-ghurrah) that will be on their faces on the Day of Resurrection from the trace of ablution.\" And he — peace be upon him — said: \"When the son of Adam recites the verse of prostration and then prostrates, Satan withdraws, weeping and saying: 'Woe to me! This one was commanded to prostrate, and he prostrated, so Paradise is his. And I was commanded to prostrate, but I disobeyed, so the Fire is mine.'\" (6)","book_title":"Mysteries of Prayer","section_title_ar":"Section 123","section_title_en":"The Virtue of Prostration (Faḍīlat al-Sujūd)","section_index":123,"anchors":"- Root: سجد (S-J-D)\n  * Lisan / Ayn: Core root denotes bowing, lowering oneself, and touching the ground in humility.\n  * Al-Raghib (Mufradat): Prostration (sujūd) is of two types: voluntary (ikhtiyārī), exclusive to humans and meriting reward, and compelled (taskhīrī), shared by all creation. The Prophet's statement \"a hidden prostration\" (sujūd khafī) points to the voluntary type performed in secret, maximizing sincerity and divine proximity.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is the physical act of placing the forehead on the ground in worship. Metaphorical (majāz) usage extends to any act of humble submission, such as a tree leaning or a ship yielding to the wind. Here, the term is literal, but its virtue is tied to the spiritual state of khushūʿ (reverent humility).\n- Root: عبد (ʿ-B-D)\n  * Lisan / Ayn: Root denotes servitude, obedience, and worship.\n  * Al-Raghib (Mufradat): ʿIbādah is the utmost degree of self-abasement (tadhallul), rendered exclusively to God due to His ultimate beneficence. The ḥadīth \"the servant draws near to God\" (yataqarrab al-ʿabd) frames prostration as the servant's act of voluntary worship (ʿibādah ikhtiyāriyyah), distinct from compelled submission.\n  * Al-Zamakhshari (Asas): Literal usage is the state of being a slave (ʿabd). Metaphorically, it implies total devotion and self-surrender, as in \"he enslaved me\" (taʿabbadanī). In this context, the servant (al-ʿabd) is the believing human who freely chooses worship.\n- Root: قرب (Q-R-B)\n  * Lisan / Ayn: Root denotes proximity, nearness, and approach.\n  * Al-Raghib (Mufradat): Proximity (qurb) applies to place, time, relation, and — crucially here — to divine favor and honor (al-ḥaẓwah wa al-riʿāyah). The verse {«واسجد واقترب»} (\"Prostrate and draw near\") (Q. 96:19) indicates that prostration is the means to spiritual nearness to God, not physical closeness.\n  * Al-Zamakhshari (Asas): Literal usage is spatial nearness. Metaphorical usage is drawing near in rank or favor, as in \"he approached a matter\" (qarraba amran). Here, the servant's proximity to God is metaphorical — a station of honor and divine acceptance achieved through the act of prostration.\n- Root: وجل (W-J-L)\n  * Lisan / Ayn: Root denotes fear, trembling, and apprehension.\n  * Al-Raghib (Mufradat): Wajal is the inward sensation of fear, as in {«الذين إذا ذكر الله وجلت قلوبهم»} (\"those whose hearts tremble when God is mentioned\") (Q. 8:2). The \"light of khushūʿ\" (nūr al-khushūʿ) mentioned in the exegesis of the prostration mark is an outward manifestation of this inward awe.\n  * Al-Zamakhshari (Asas): Literal usage is the feeling of fear. Metaphorically, it can denote a profound reverence that transforms the believer's demeanor. The \"mark on the face\" (sīmā) is interpreted as this radiant awe shining from within.\n- Sibawayh Rule: Prepositional Interposition (al-faṣl bayna al-jār wa al-majrūr) — The construction \"أقرب ما يكون العبد من الله تعالى أن يكون ساجدا\" (the closest the servant is to God is when he is prostrating) employs a nominal sentence with an implied temporal clause, where the predicate (an yakūna sājidan) is delayed for rhetorical emphasis, highlighting the state of prostration as the pinnacle of proximity.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Mysteries of Prayer'","badge":"Afterlife"},{"arabic":"الدين وأصفاها في اليقين وأرقها على الإخوان وهو إشارة إلى قوله تعالى أشداء على الكفار رحماء بينهم وقوله تعالى مثل نوره كمشكاة فيها مصباح قال أبي بن كعب رضي الله عنه معناه مثل نور المؤمن وقلبه وقوله تعالى أو كظلمات في بحر لجى مثل قلب المنافق وقال زيد بن أسلم في قوله تعالى في لوح محفوظ وهو قلب المؤمن وقال سهل مثل القلب والصدر مثل العرش والكرسي فهذه أمثلة القلب","english":"Know that just as the rational person does not know the necessary sciences (al-ʿulūm al-ḍarūriyyah) nor what distinguishes the state of the rational one from what he has acquired of the theoretical sciences, so too does the rational person not know what Allah has opened for His friends (awliyāʾ) and His prophets of the prerogatives of His gentleness (luṭf) and mercy. Whatever mercy Allah opens to people, none can withhold it. This mercy is dispensed by the decree of bounty and generosity from Allah, Glorified and Exalted, not grudged to anyone. But it only appears in hearts that expose themselves to the wafts of the mercy of Allah, Exalted — as he, peace and blessings be upon him, said: \"Indeed, your Lord has, in the days of your time, wafts of mercy — so expose yourselves to them.\" (1) Hadith: Allah, Mighty and Majestic, says: \"Long has been the yearning of the righteous for My meeting\" — the hadith. I found no source for it except that the author of al-Firdaws transmitted it from the hadith of Abū al-Dardāʾ, and his son did not mention for it in the Musnad of al-Firdaws an isnād.","book_title":"Condemnation of Envy","section_title_ar":"Section 579","section_title_en":"The Revival of the Religious Sciences — Section 579: The Human's Distinguishing Property is Knowledge and Wisdom; The Heart as the Seat of the King","section_index":579,"anchors":"- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning over, revolving, and transformation from one state to another; the heart as that which is constantly turning and fluctuating.\n  * Al-Raghib (Mufradat): The heart (qalb) is so named for its constant turning (taqallub) between states; it is the seat of perception and understanding, the faculty by which one grasps realities.\n  * Al-Zamakhshari (Asas): Literal: turning a thing over. Metaphorical: the heart as the seat of understanding and the center of the human kingdom, that which governs and directs the faculties.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge, perception, and certainty; the mark or trace by which a thing is known.\n  * Al-Raghib (Mufradat): Knowledge is the apprehension of a thing as it truly is; it is the distinguishing property of the human being and the purpose of his creation.\n  * Al-Zamakhshari (Asas): Literal: knowing. Metaphorical: the light by which the heart perceives realities, the noblest of which is knowledge of God.\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Possession, sovereignty, and dominion; a king who rules over a domain.\n  * Al-Raghib (Mufradat): The king is one who possesses authority and commands; the heart is the king of the human body, ruling over its faculties.\n  * Al-Zamakhshari (Asas): Literal: a king. Metaphorical: the heart as the sovereign of the human kingdom, with the faculties as its subjects, messengers, and servants.\n- Sibawayh Rule: باب التشبيه والتمثيل (The Chapter of Simile and Analogy) — The use of extended analogies (tamthīl) to clarify abstract realities through concrete images, where the comparison is drawn between the relations of parts, not merely individual attributes.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,350,1790],[2,1790,3354],[3,3354,3903],[4,3903,5193],[5,5193,7264]],"2":[[1,400,1959],[2,1959,2450],[3,2450,3420],[4,3420,4058],[5,4058,5274],[6,5274,5765],[7,5765,6772],[8,6772,7779],[9,7779,9037],[10,9037,10621],[11,10621,11873],[12,11873,13027],[13,13027,14844],[14,14844,16268],[15,16268,18688]],"3":[[1,350,2199],[2,2199,3199],[3,3199,4440],[4,4440,6036]],"4":[[1,400,998],[2,998,2756],[3,2756,3803],[4,3803,5679],[5,5679,6302],[6,6302,7474],[7,7474,9493],[8,9493,12634],[9,12634,14354],[10,14354,15264],[11,15264,17059],[12,17059,18343],[13,18343,19465],[14,19465,21515],[15,21515,23086],[16,23086,24357],[17,24357,25342],[18,25342,26913],[19,26913,28458]],"5":[[1,400,2125],[2,2125,4242],[3,4242,6516],[4,6516,8063],[5,8063,9304],[6,9304,9827],[7,9827,11291],[8,11291,12843],[9,12843,14479],[10,14479,15786],[11,15786,17550],[12,17550,18622],[13,18622,20850],[14,20850,22183],[15,22183,23166],[16,23166,24002],[17,24002,25034],[18,25034,26367],[19,26367,28092]],"6":[[1,400,2412],[2,2412,4840],[3,4840,7471],[4,7471,10153],[5,10153,12581],[6,12581,16162],[7,16162,17560],[8,17560,18619],[9,18619,20179],[10,20179,21760],[11,21760,24092],[12,24092,25652],[13,25652,27035],[14,27035,28150],[15,28150,29731],[16,29731,31594],[17,31594,33189],[18,33189,34008],[19,34008,35518],[20,35518,37935],[21,37935,39743]],"7":[[1,400,1598],[2,1598,2645],[3,2645,4558],[4,4558,6023],[5,6023,7209],[6,7209,8128],[7,8128,9593],[8,9593,11034]],"8":[[1,400,2626],[2,2626,4593],[3,4593,6138],[4,6138,8475],[5,8475,10669]],"9":[[1,400,2485],[2,2485,3613],[3,3613,5208],[4,5208,7225],[5,7225,9390],[6,9390,11407],[7,11407,12273],[8,12273,14117]],"10":[[1,400,1317],[2,1317,2737],[3,2737,5325],[4,5325,6895],[5,6895,9232],[6,9232,10224],[7,10224,10852],[8,10852,11844],[9,11844,12774],[10,12774,14558],[11,14558,15312],[12,15312,16455],[13,16455,18277],[14,18277,19433],[15,19433,20589],[16,20589,21594],[17,21594,22473],[18,22473,24006],[19,24006,24910],[20,24910,25870],[21,25870,27026],[22,27026,28018],[23,28018,30103],[24,30103,31372],[25,31372,33029]],"11":[[1,400,1974],[2,1974,2474],[