َثَلُهُمْ فِے اِ۬لتَّوْر۪يٰةِۖ وَمَثَلُهُمْ فِے اِ۬لِانجِيلِ كَزَرْعٍ اَخْرَجَ شَطْـَٔهُۥ فَـَٔازَرَهُۥ فَاسْتَغْلَظَ فَاسْتَو۪يٰ عَلَيٰ سُوقِهِۦ يُعْجِبُ اُ۬لزُّرَّاعَ لِيَغِيظَ بِهِمُ اُ۬لْكُفَّارَۖ وَعَدَ اَ۬للَّهُ اُ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ مِنْهُم مَّغْفِرَةࣰ وَأَجْراً عَظِيماࣰۖ", "words": [{"id": 1, "arabic": "مُّحَمَّدࣱ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَّسُولُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَعَهُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَشِدَّآءُ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْكُفّ۪ارِ", "translit": "", "root": ""}, {"id": 9, "arabic": "رُحَمَآءُ", "translit": "", "root": ""}, {"id": 10, "arabic": "بَيْنَهُمْۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "تَر۪يٰهُمْ", "translit": "", "root": ""}, {"id": 12, "arabic": "رُكَّعاࣰ", "translit": "", "root": ""}, {"id": 13, "arabic": "سُجَّداࣰ", "translit": "", "root": ""}, {"id": 14, "arabic": "يَبْتَغُونَ", "translit": "", "root": ""}, {"id": 15, "arabic": "فَضْلاࣰ", "translit": "", "root": ""}, {"id": 16, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَرِضْوَٰناࣰۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "سِيم۪اهُمْ", "translit": "", "root": ""}, {"id": 20, "arabic": "فِے", "translit": "", "root": ""}, {"id": 21, "arabic": "وُجُوهِهِم", "translit": "", "root": ""}, {"id": 22, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 23, "arabic": "اَثَرِ", "translit": "", "root": ""}, {"id": 24, "arabic": "اِ۬لسُّجُودِۖ", "translit": "", "root": ""}, {"id": 25, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 26, "arabic": "مَثَلُهُمْ", "translit": "", "root": ""}, {"id": 27, "arabic": "فِے", "translit": "", "root": ""