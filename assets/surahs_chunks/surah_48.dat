arsh"}, {"surah": 48, "ayah": 3, "text": "وَيَنصُرَكَ اَ۬للَّهُ نَصْراً عَزِيزاًۖ", "words": [{"id": 1, "arabic": "وَيَنصُرَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَصْراً", "translit": "", "root": ""}, {"id": 4, "arabic": "عَزِيزاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 48, "ayah": 4, "text": "هُوَ اَ۬لذِےٓ أَنزَلَ اَ۬لسَّكِينَةَ فِے قُلُوبِ اِ۬لْمُومِنِينَ لِيَزْدَادُوٓاْ إِيمَٰناࣰ مَّعَ إِيمَٰنِهِمْۖ وَلِلهِ جُنُودُ اُ۬لسَّمَٰوَٰتِ وَالَارْضِۖ وَكَانَ اَ۬للَّهُ عَلِيماً حَكِيماࣰ‏", "words": [{"id": 1, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِےٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنزَلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لسَّكِينَةَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "قُلُوبِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْمُومِنِينَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِيَزْدَادُوٓاْ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِيمَٰناࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "مَّعَ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِيمَٰنِهِمْۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَلِلهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "جُنُودُ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَالَارْضِۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَكَانَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 18, "arabic": "عَلِيماً", "translit": "", "root": ""}, {"id": 19, "arabic": "حَكِيماࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 48, "ayah": 5, "text": "لِّيُدْخِلَ اَ۬لْمُومِنِينَ وَالْمُومِنَٰتِ جَنَّٰتࣲ تَجْرِے مِن تَحْتِهَا اَ۬لَانْهَٰرُ خَٰلِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّـَٔاتِهِم