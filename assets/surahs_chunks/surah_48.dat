 فَتْحاࣰ مُّبِيناࣰ‏", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "فَتَحْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَتْحاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّبِيناࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 48, "ayah": 2, "text": "لِّيَغْفِرَ لَكَ اَ۬للَّهُ مَا تَقَدَّمَ مِن ذَنۢبِكَ وَمَا تَأَخَّرَ وَيُتِمَّ نِعْمَتَهُۥ عَلَيْكَ وَيَهْدِيَكَ صِرَٰطاࣰ مُّسْتَقِيماࣰ‏", "words": [{"id": 1, "arabic": "لِّيَغْفِرَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "تَقَدَّمَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "", "root": ""}, {"id": 7, "arabic": "ذَنۢبِكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "تَأَخَّرَ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَيُتِمَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "نِعْمَتَهُۥ", "translit": "", "root": ""}, {"id": 12, "arabic": "عَلَيْكَ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَيَهْدِيَكَ", "translit": "", "root": ""}, {"id": 14, "arabic": "صِرَٰطاࣰ", "translit": "", "root": ""}, {"id": 15, "arabic": "مُّسْتَقِيماࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 48, "ayah": 3, "text": "وَيَنصُرَكَ اَ۬للَّهُ نَصْراً عَزِيزاًۖ", "words": [{"id": 1, "arabic": "وَيَنصُرَكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَصْراً", "translit": "", "root": ""}, {"id": 4, "arabic": "عَزِيزاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 48, "ayah": 4, "text": "هُوَ اَ۬لذِےٓ أَنزَلَ اَ۬لسَّكِينَةَ فِے قُلُوبِ اِ۬لْمُومِنِينَ لِيَزْدَادُوٓاْ إِيمَٰناࣰ مَّعَ إِيمَٰنِهِمْۖ وَ