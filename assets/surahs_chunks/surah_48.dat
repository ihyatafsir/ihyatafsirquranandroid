{"surah": 48, "verses": [{"ayah": 1, "text": "إِنَّا فَتَحْنَا لَكَ فَتْحًا مُّبِينًا ", "translation": "Indeed, We have given you, [O Muḥammad], a clear conquest[1]", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": "", "latinTranslit": "innā"}, {"id": 2, "arabic": "فَتَحْنَا", "translit": "āَnْḥَtَf", "root": "فتح", "latinTranslit": "fataḥnā"}, {"id": 3, "arabic": "لَكَ", "translit": "َkَl", "root": "", "latinTranslit": "laka"}, {"id": 4, "arabic": "فَتْحًا", "translit": "āًḥْtَf", "root": "فتح", "latinTranslit": "fatḥan"}, {"id": 5, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين", "latinTranslit": "mubīnan"}], "hasIhya": false, "haleemTranslation": "Truly We have opened up a path to clear triumph for you [Prophet]", "clearyTranslation": "Truly We have opened up a path to clear triumph for you [Prophet]"}, {"ayah": 2, "text": "لِّيَغْفِرَ لَكَ ٱللَّهُ مَا تَقَدَّمَ مِن ذَنۢبِكَ وَمَا تَأَخَّرَ وَيُتِمَّ نِعْمَتَهُۥ عَلَيْكَ وَيَهْدِيَكَ صِرَٰطًا مُّسْتَقِيمًا ", "translation": "That Allāh may forgive for you what preceded of your sin [i.e., errors] and what will follow and complete His favor upon you and guide you to a straight path", "words": [{"id": 1, "arabic": "لِّيَغْفِرَ", "translit": "َrِfْغَyِّl", "root": "غفر", "latinTranslit": "liyaghfira"}, {"id": 2, "arabic": "لَكَ", "translit": "َkَl", "root": "", "latinTranslit": "laka"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": "", "latinTranslit": "mā"}, {"id": 5, "arabic": "تَقَدَّمَ", "translit": "َmَّdَqَt", "root": "قدم", "latinTranslit": "taqaddama"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": "", "latinTranslit": "min"}, {"id": 7, "arabic": "ذَنۢبِكَ", "translit": "َkِbۢnَhd", "root": "ذنب", "latinTranslit": "dhanbika"}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": "", "latinTranslit": "wamā"}, {"id": 9, "arabic": "تَأَخَّرَ", "translit": "َrَّhkَaʾَt", "root": "اخر", "latinTranslit": "ta-akhara"}, {"id": 10, "arabic": "وَيُتِمَّ", "translit": "َّmِtُyَw", "root": "تمم", "latinTranslit": "wayutimma"}, {"id": 11, "arabic": "نِعْمَتَهُۥ", "translit": "ۥُhَtَmْعِn", "root": "نعم", "latinTranslit": "niʿ'matahu"}, {"id": 12, "arabic": "عَلَيْكَ", "translit": "َkْyَlَع", "root": "", "latinTranslit": "ʿalayka"}, {"id": 13, "arabic": "وَيَهْدِيَكَ", "translit": "َkَyِdْhَyَw", "root": "هدي", "latinTranslit": "wayahdiyaka"}, {"id": 14, "arabic": "صِرَٰطًا", "translit": "āًṭَٰrِṣ", "root": "صرط", "latinTranslit": "ṣirāṭan"}, {"id": 15, "arabic": "مُّسْتَقِيمًا", "translit": "āًmyِqَtْsُّm", "root": "قوم", "latinTranslit": "mus'taqīman"}], "hasIhya": true, "haleemTranslation": "so that God may forgive you your past and future sins, complete His grace upon you, guide you to a straight path", "clearyTranslation": "so that God may forgive you your past and future sins, complete His grace upon you, guide you to a straight path"}, {"ayah": 3, "text": "وَيَنصُرَكَ ٱللَّهُ نَصْرًا عَزِيزًا ", "translation": "And [that] Allāh may aid you with a mighty victory.", "words": [{"id": 1, "arabic": "وَيَنصُرَكَ", "translit": "َkَrُṣnَyَw", "root": "نصر", "latinTranslit": "wayanṣuraka"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 3, "arabic": "نَصْرًا", "translit": "āًrْṣَn", "root": "نصر", "latinTranslit": "naṣran"}, {"id": 4, "arabic": "عَزِيزًا", "translit": "āًzyِzَع", "root": "عزز", "latinTranslit": "ʿazīzan"}], "hasIhya": false, "haleemTranslation": "and help you mightily", "clearyTranslation": "and help you mightily"}, {"ayah": 4, "text": "هُوَ ٱلَّذِىٓ أَنزَلَ ٱلسَّكِينَةَ فِى قُلُوبِ ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَٰنًا مَّعَ إِيمَٰنِهِمْۗ وَلِلَّهِ جُنُودُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ", "translation": "It is He who sent down tranquility into the hearts of the believers that they would increase in faith along with their [present] faith. And to Allāh belong the soldiers of the heavens and the earth, and ever is Allāh Knowing and Wise.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": "", "latinTranslit": "huwa"}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": "", "latinTranslit": "alladhī"}, {"id": 3, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل", "latinTranslit": "anzala"}, {"id": 4, "arabic": "ٱلسَّكِينَةَ", "translit": "َẗَnyِkَّslٱ", "root": "سكن", "latinTranslit": "l-sakīnata"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 6, "arabic": "قُلُوبِ", "translit": "ِbwُlُq", "root": "قلب", "latinTranslit": "qulūbi"}, {"id": 7, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن", "latinTranslit": "l-mu'minīna"}, {"id": 8, "arabic": "لِيَزْدَادُوٓا۟", "translit": "۟āٓwُdāَdْzَyِl", "root": "زيد", "latinTranslit": "liyazdādū"}, {"id": 9, "arabic": "إِيمَٰنًا", "translit": "āًnَٰmyِiʾ", "root": "امن", "latinTranslit": "īmānan"}, {"id": 10, "arabic": "مَّعَ", "translit": "َعَّm", "root": "", "latinTranslit": "maʿa"}, {"id": 11, "arabic": "إِيمَٰنِهِمْ", "translit": "ْmِhِnَٰmyِiʾ", "root": "امن", "latinTranslit": "īmānihim"}, {"id": 12, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله", "latinTranslit": "walillahi"}, {"id": 13, "arabic": "جُنُودُ", "translit": "ُdwُnُjg", "root": "جند", "latinTranslit": "junūdu"}, {"id": 14, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو", "latinTranslit": "l-samāwāti"}, {"id": 15, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض", "latinTranslit": "wal-arḍi"}, {"id": 16, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون", "latinTranslit": "wakāna"}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 18, "arabic": "عَلِيمًا", "translit": "āًmyِlَع", "root": "علم", "latinTranslit": "ʿalīman"}, {"id": 19, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم", "latinTranslit": "ḥakīman"}], "hasIhya": true, "haleemTranslation": "It was He who made His tranquillity descend into the hearts of the believers, to add faith to their faith––the forces of the heavens and earth belong to God; He is all knowing and all wise––", "clearyTranslation": "It was He who made His tranquillity descend into the hearts of the believers, to add faith to their faith––the forces of the heavens and earth belong to God; He is all knowing and all wise––"}, {"ayah": 5, "text": "لِّيُدْخِلَ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّـَٔاتِهِمْۚ وَكَانَ ذَٰلِكَ عِندَ ٱللَّهِ فَوْزًا عَظِيمًا ", "translation": "[And] that He may admit the believing men and the believing women to gardens beneath which rivers flow to abide therein eternally and remove from them their misdeeds - and ever is that, in the sight of Allāh, a great attainment –", "words": [{"id": 1, "arabic": "لِّيُدْخِلَ", "translit": "َlِhkْdُyِّl", "root": "دخل", "latinTranslit": "liyud'khila"}, {"id": 2, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن", "latinTranslit": "l-mu'minīna"}, {"id": 3, "arabic": "وَٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱَw", "root": "امن", "latinTranslit": "wal-mu'mināti"}, {"id": 4, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن", "latinTranslit": "jannātin"}, {"id": 5, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري", "latinTranslit": "tajrī"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": "", "latinTranslit": "min"}, {"id": 7, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت", "latinTranslit": "taḥtihā"}, {"id": 8, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر", "latinTranslit": "l-anhāru"}, {"id": 9, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد", "latinTranslit": "khālidīna"}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": "", "latinTranslit": "fīhā"}, {"id": 11, "arabic": "وَيُكَفِّرَ", "translit": "َrِّfَkُyَw", "root": "كفر", "latinTranslit": "wayukaffira"}, {"id": 12, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَع", "root": "", "latinTranslit": "ʿanhum"}, {"id": 13, "arabic": "سَيِّـَٔاتِهِمْ", "translit": "ْmِhِtāَٔـِّyَs", "root": "سوا", "latinTranslit": "sayyiātihim"}, {"id": 14, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون", "latinTranslit": "wakāna"}, {"id": 15, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": "", "latinTranslit": "dhālika"}, {"id": 16, "arabic": "عِندَ", "translit": "َdnِع", "root": "عند", "latinTranslit": "ʿinda"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 18, "arabic": "فَوْزًا", "translit": "āًzْwَf", "root": "فوز", "latinTranslit": "fawzan"}, {"id": 19, "arabic": "عَظِيمًا", "translit": "āًmyِẓَع", "root": "عظم", "latinTranslit": "ʿaẓīman"}], "hasIhya": true, "haleemTranslation": "so as to admit believing men and women into Gardens graced with flowing streams, there to remain, absolving their bad deeds––a great triumph in God’s eyes––", "clearyTranslation": "so as to admit believing men and women into Gardens graced with flowing streams, there to remain, absolving their bad deeds––a great triumph in God’s eyes––"}, {"ayah": 6, "text": "وَيُعَذِّبَ ٱلْمُنَٰفِقِينَ وَٱلْمُنَٰفِقَٰتِ وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَٰتِ ٱلظَّآنِّينَ بِٱللَّهِ ظَنَّ ٱلسَّوْءِۚ عَلَيْهِمْ دَآئِرَةُ ٱلسَّوْءِۖ وَغَضِبَ ٱللَّهُ عَلَيْهِمْ وَلَعَنَهُمْ وَأَعَدَّ لَهُمْ جَهَنَّمَۖ وَسَآءَتْ مَصِيرًا ", "translation": "And [that] He may punish the hypocrite men and hypocrite women, and the polytheist men and polytheist women - those who assume about Allāh an assumption of evil nature. Upon them is a misfortune of evil nature; and Allāh has become angry with them and has cursed them and prepared for them Hell, and evil it is as a destination.", "words": [{"id": 1, "arabic": "وَيُعَذِّبَ", "translit": "َbِّhdَعُyَw", "root": "عذب", "latinTranslit": "wayuʿadhiba"}, {"id": 2, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق", "latinTranslit": "l-munāfiqīna"}, {"id": 3, "arabic": "وَٱلْمُنَٰفِقَٰتِ", "translit": "ِtَٰqِfَٰnُmْlٱَw", "root": "نفق", "latinTranslit": "wal-munāfiqāti"}, {"id": 4, "arabic": "وَٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱَw", "root": "شرك", "latinTranslit": "wal-mush'rikīna"}, {"id": 5, "arabic": "وَٱلْمُشْرِكَٰتِ", "translit": "ِtَٰkِrْhsُmْlٱَw", "root": "شرك", "latinTranslit": "wal-mush'rikāti"}, {"id": 6, "arabic": "ٱلظَّآنِّينَ", "translit": "َnyِّnٓāَّẓlٱ", "root": "ظنن", "latinTranslit": "l-ẓānīna"}, {"id": 7, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله", "latinTranslit": "bil-lahi"}, {"id": 8, "arabic": "ظَنَّ", "translit": "َّnَẓ", "root": "ظنن", "latinTranslit": "ẓanna"}, {"id": 9, "arabic": "ٱلسَّوْءِ", "translit": "ِءْwَّslٱ", "root": "سوا", "latinTranslit": "l-sawi"}, {"id": 10, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَع", "root": "", "latinTranslit": "ʿalayhim"}, {"id": 11, "arabic": "دَآئِرَةُ", "translit": "ُẗَrِyʾٓāَd", "root": "دور", "latinTranslit": "dāiratu"}, {"id": 12, "arabic": "ٱلسَّوْءِ", "translit": "ِءْwَّslٱ", "root": "سوا", "latinTranslit": "l-sawi"}, {"id": 13, "arabic": "وَغَضِبَ", "translit": "َbِḍَغَw", "root": "غضب", "latinTranslit": "waghaḍiba"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 15, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَع", "root": "", "latinTranslit": "ʿalayhim"}, {"id": 16, "arabic": "وَلَعَنَهُمْ", "translit": "ْmُhَnَعَlَw", "root": "لعن", "latinTranslit": "walaʿanahum"}, {"id": 17, "arabic": "وَأَعَدَّ", "translit": "َّdَعَaʾَw", "root": "عدد", "latinTranslit": "wa-aʿadda"}, {"id": 18, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": "", "latinTranslit": "lahum"}, {"id": 19, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": "", "latinTranslit": "jahannama"}, {"id": 20, "arabic": "وَسَآءَتْ", "translit": "ْtَءٓāَsَw", "root": "سوا", "latinTranslit": "wasāat"}, {"id": 21, "arabic": "مَصِيرًا", "translit": "āًryِṣَm", "root": "صير", "latinTranslit": "maṣīran"}], "hasIhya": false, "haleemTranslation": "and to torment the hypocritical and idolatrous men and women who harbour evil thoughts about God––it is they who will be encircled by evil!––who carry the burden of God’s anger, whom God has rejected and for whom He has prepared Hell, an evil destination", "clearyTranslation": "and to torment the hypocritical and idolatrous men and women who harbour evil thoughts about God––it is they who will be encircled by evil!––who carry the burden of God’s anger, whom God has rejected and for whom He has prepared Hell, an evil destination"}, {"ayah": 7, "text": "وَلِلَّهِ جُنُودُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا ", "translation": "And to Allāh belong the soldiers of the heavens and the earth. And ever is Allāh Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله", "latinTranslit": "walillahi"}, {"id": 2, "arabic": "جُنُودُ", "translit": "ُdwُnُjg", "root": "جند", "latinTranslit": "junūdu"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو", "latinTranslit": "l-samāwāti"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض", "latinTranslit": "wal-arḍi"}, {"id": 5, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون", "latinTranslit": "wakāna"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 7, "arabic": "عَزِيزًا", "translit": "āًzyِzَع", "root": "عزز", "latinTranslit": "ʿazīzan"}, {"id": 8, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم", "latinTranslit": "ḥakīman"}], "hasIhya": false, "haleemTranslation": "The forces of heaven and earth belong to God; He is almighty and all wise", "clearyTranslation": "The forces of heaven and earth belong to God; He is almighty and all wise"}, {"ayah": 8, "text": "إِنَّآ أَرْسَلْنَٰكَ شَٰهِدًا وَمُبَشِّرًا وَنَذِيرًا ", "translation": "Indeed, We have sent you as a witness and a bringer of good tidings and a warner", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": "", "latinTranslit": "innā"}, {"id": 2, "arabic": "أَرْسَلْنَٰكَ", "translit": "َkَٰnْlَsْrَaʾ", "root": "رسل", "latinTranslit": "arsalnāka"}, {"id": 3, "arabic": "شَٰهِدًا", "translit": "āًdِhَٰhs", "root": "شهد", "latinTranslit": "shāhidan"}, {"id": 4, "arabic": "وَمُبَشِّرًا", "translit": "āًrِّhsَbُmَw", "root": "بشر", "latinTranslit": "wamubashiran"}, {"id": 5, "arabic": "وَنَذِيرًا", "translit": "āًryِhdَnَw", "root": "نذر", "latinTranslit": "wanadhīran"}], "hasIhya": false, "haleemTranslation": "We have sent you [Prophet] to bring good news and to give warning", "clearyTranslation": "We have sent you [Prophet] to bring good news and to give warning"}, {"ayah": 9, "text": "لِّتُؤْمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَتُعَزِّرُوهُ وَتُوَقِّرُوهُ وَتُسَبِّحُوهُ بُكْرَةً وَأَصِيلًا ", "translation": "That you [people] may believe in Allāh and His Messenger and honor him and respect him [i.e., the Prophet (ﷺ)] and exalt Him [i.e., Allāh] morning and afternoon.", "words": [{"id": 1, "arabic": "لِّتُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُtِّl", "root": "امن", "latinTranslit": "litu'minū"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله", "latinTranslit": "bil-lahi"}, {"id": 3, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل", "latinTranslit": "warasūlihi"}, {"id": 4, "arabic": "وَتُعَزِّرُوهُ", "translit": "ُhwُrِّzَعُtَw", "root": "عزر", "latinTranslit": "watuʿazzirūhu"}, {"id": 5, "arabic": "وَتُوَقِّرُوهُ", "translit": "ُhwُrِّqَwُtَw", "root": "وقر", "latinTranslit": "watuwaqqirūhu"}, {"id": 6, "arabic": "وَتُسَبِّحُوهُ", "translit": "ُhwُḥِّbَsُtَw", "root": "سبح", "latinTranslit": "watusabbiḥūhu"}, {"id": 7, "arabic": "بُكْرَةً", "translit": "ًẗَrْkُb", "root": "بكر", "latinTranslit": "buk'ratan"}, {"id": 8, "arabic": "وَأَصِيلًا", "translit": "āًlyِṣَaʾَw", "root": "اصل", "latinTranslit": "wa-aṣīlan"}], "hasIhya": false, "haleemTranslation": "so that you[people] may believe in God and His Messenger, support Him, honour Him, and praise Him morning and evening", "clearyTranslation": "so that you[people] may believe in God and His Messenger, support Him, honour Him, and praise Him morning and evening"}, {"ayah": 10, "text": "إِنَّ ٱلَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ ٱللَّهَ يَدُ ٱللَّهِ فَوْقَ أَيْدِيهِمْۚ فَمَن نَّكَثَ فَإِنَّمَا يَنكُثُ عَلَىٰ نَفْسِهِۦۖ وَمَنْ أَوْفَىٰ بِمَا عَٰهَدَ عَلَيْهُ ٱللَّهَ فَسَيُؤْتِيهِ أَجْرًا عَظِيمًا ", "translation": "Indeed, those who pledge allegiance to you, [O Muḥammad] - they are actually pledging allegiance to Allāh. The hand[1] of Allāh is over their hands.[2] So he who breaks his word only breaks it to the detriment of himself. And he who fulfills that which he has promised Allāh - He will give him a great reward.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": "", "latinTranslit": "inna"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": "", "latinTranslit": "alladhīna"}, {"id": 3, "arabic": "يُبَايِعُونَكَ", "translit": "َkَnwُعِyāَbُy", "root": "بيع", "latinTranslit": "yubāyiʿūnaka"}, {"id": 4, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": "", "latinTranslit": "innamā"}, {"id": 5, "arabic": "يُبَايِعُونَ", "translit": "َnwُعِyāَbُy", "root": "بيع", "latinTranslit": "yubāyiʿūna"}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله", "latinTranslit": "l-laha"}, {"id": 7, "arabic": "يَدُ", "translit": "ُdَy", "root": "يدي", "latinTranslit": "yadu"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 9, "arabic": "فَوْقَ", "translit": "َqْwَf", "root": "فوق", "latinTranslit": "fawqa"}, {"id": 10, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي", "latinTranslit": "aydīhim"}, {"id": 11, "arabic": "فَمَن", "translit": "nَmَf", "root": "", "latinTranslit": "faman"}, {"id": 12, "arabic": "نَّكَثَ", "translit": "َhtَkَّn", "root": "نكث", "latinTranslit": "nakatha"}, {"id": 13, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": "", "latinTranslit": "fa-innamā"}, {"id": 14, "arabic": "يَنكُثُ", "translit": "ُhtُknَy", "root": "نكث", "latinTranslit": "yankuthu"}, {"id": 15, "arabic": "عَلَىٰ", "translit": "ٰàَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 16, "arabic": "نَفْسِهِۦ", "translit": "ۦِhِsْfَn", "root": "نفس", "latinTranslit": "nafsihi"}, {"id": 17, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": "", "latinTranslit": "waman"}, {"id": 18, "arabic": "أَوْفَىٰ", "translit": "ٰàَfْwَaʾ", "root": "وفي", "latinTranslit": "awfā"}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": "", "latinTranslit": "bimā"}, {"id": 20, "arabic": "عَٰهَدَ", "translit": "َdَhَٰع", "root": "عهد", "latinTranslit": "ʿāhada"}, {"id": 21, "arabic": "عَلَيْهُ", "translit": "ُhْyَlَع", "root": "", "latinTranslit": "ʿalayhu"}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله", "latinTranslit": "l-laha"}, {"id": 23, "arabic": "فَسَيُؤْتِيهِ", "translit": "ِhyِtْwʾُyَsَf", "root": "اتي", "latinTranslit": "fasayu'tīhi"}, {"id": 24, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر", "latinTranslit": "ajran"}, {"id": 25, "arabic": "عَظِيمًا", "translit": "āًmyِẓَع", "root": "عظم", "latinTranslit": "ʿaẓīman"}], "hasIhya": false, "haleemTranslation": "Those who pledge loyalty to you [Prophet] are actually pledging loyalty to God Himself- God’s hand is placed on theirs––and anyone who breaks his pledge does so to his own detriment: God will give a great reward to the one who fulfils his pledge to Him", "clearyTranslation": "Those who pledge loyalty to you [Prophet] are actually pledging loyalty to God Himself- God’s hand is placed on theirs––and anyone who breaks his pledge does so to his own detriment: God will give a great reward to the one who fulfils his pledge to Him"}, {"ayah": 11, "text": "سَيَقُولُ لَكَ ٱلْمُخَلَّفُونَ مِنَ ٱلْأَعْرَابِ شَغَلَتْنَآ أَمْوَٰلُنَا وَأَهْلُونَا فَٱسْتَغْفِرْ لَنَاۚ يَقُولُونَ بِأَلْسِنَتِهِم مَّا لَيْسَ فِى قُلُوبِهِمْۚ قُلْ فَمَن يَمْلِكُ لَكُم مِّنَ ٱللَّهِ شَيْـًٔا إِنْ أَرَادَ بِكُمْ ضَرًّا أَوْ أَرَادَ بِكُمْ نَفْعًۢاۚ بَلْ كَانَ ٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرًۢا ", "translation": "Those who remained behind[1] of the bedouins will say to you, \"Our properties and our families occupied us, so ask forgiveness for us.\" They say with their tongues what is not within their hearts. Say, \"Then who could prevent Allāh at all if He intended for you harm or intended for you benefit? Rather, ever is Allāh, of what you do, Aware.", "words": [{"id": 1, "arabic": "سَيَقُولُ", "translit": "ُlwُqَyَs", "root": "قول", "latinTranslit": "sayaqūlu"}, {"id": 2, "arabic": "لَكَ", "translit": "َkَl", "root": "", "latinTranslit": "laka"}, {"id": 3, "arabic": "ٱلْمُخَلَّفُونَ", "translit": "َnwُfَّlَhkُmْlٱ", "root": "خلف", "latinTranslit": "l-mukhalafūna"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": "", "latinTranslit": "mina"}, {"id": 5, "arabic": "ٱلْأَعْرَابِ", "translit": "ِbāَrْعَaʾْlٱ", "root": "عرب", "latinTranslit": "l-aʿrābi"}, {"id": 6, "arabic": "شَغَلَتْنَآ", "translit": "ٓāَnْtَlَغَhs", "root": "شغل", "latinTranslit": "shaghalatnā"}, {"id": 7, "arabic": "أَمْوَٰلُنَا", "translit": "āَnُlَٰwْmَaʾ", "root": "مول", "latinTranslit": "amwālunā"}, {"id": 8, "arabic": "وَأَهْلُونَا", "translit": "āَnwُlْhَaʾَw", "root": "اهل", "latinTranslit": "wa-ahlūnā"}, {"id": 9, "arabic": "فَٱسْتَغْفِرْ", "translit": "ْrِfْغَtْsٱَf", "root": "غفر", "latinTranslit": "fa-is'taghfir"}, {"id": 10, "arabic": "لَنَا", "translit": "āَnَl", "root": "", "latinTranslit": "lanā"}, {"id": 11, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول", "latinTranslit": "yaqūlūna"}, {"id": 12, "arabic": "بِأَلْسِنَتِهِم", "translit": "mِhِtَnِsْlَaʾِb", "root": "لسن", "latinTranslit": "bi-alsinatihim"}, {"id": 13, "arabic": "مَّا", "translit": "āَّm", "root": "", "latinTranslit": "mā"}, {"id": 14, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس", "latinTranslit": "laysa"}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 16, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب", "latinTranslit": "qulūbihim"}, {"id": 17, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول", "latinTranslit": "qul"}, {"id": 18, "arabic": "فَمَن", "translit": "nَmَf", "root": "", "latinTranslit": "faman"}, {"id": 19, "arabic": "يَمْلِكُ", "translit": "ُkِlْmَy", "root": "ملك", "latinTranslit": "yamliku"}, {"id": 20, "arabic": "لَكُم", "translit": "mُkَl", "root": "", "latinTranslit": "lakum"}, {"id": 21, "arabic": "مِّنَ", "translit": "َnِّm", "root": "", "latinTranslit": "mina"}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 23, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا", "latinTranslit": "shayan"}, {"id": 24, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": "", "latinTranslit": "in"}, {"id": 25, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود", "latinTranslit": "arāda"}, {"id": 26, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": "", "latinTranslit": "bikum"}, {"id": 27, "arabic": "ضَرًّا", "translit": "āًّrَḍ", "root": "ضرر", "latinTranslit": "ḍarran"}, {"id": 28, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": "", "latinTranslit": "aw"}, {"id": 29, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود", "latinTranslit": "arāda"}, {"id": 30, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": "", "latinTranslit": "bikum"}, {"id": 31, "arabic": "نَفْعًۢا", "translit": "āًۢعْfَn", "root": "نفع", "latinTranslit": "nafʿan"}, {"id": 32, "arabic": "بَلْ", "translit": "ْlَb", "root": "", "latinTranslit": "bal"}, {"id": 33, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون", "latinTranslit": "kāna"}, {"id": 34, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 35, "arabic": "بِمَا", "translit": "āَmِb", "root": "", "latinTranslit": "bimā"}, {"id": 36, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْعَt", "root": "عمل", "latinTranslit": "taʿmalūna"}, {"id": 37, "arabic": "خَبِيرًۢا", "translit": "āًۢryِbَhk", "root": "خبر", "latinTranslit": "khabīran"}], "hasIhya": false, "haleemTranslation": "The desert Arabs who stayed behind will say to you, ‘We were busy with our property and our families: ask forgiveness for us,’ but they say with their tongues what is not in their hearts. Say, ‘Whether it is God’s will to do you harm or good, who can intervene for you?’ No! God is fully aware of everything you [people] do", "clearyTranslation": "The desert Arabs who stayed behind will say to you, ‘We were busy with our property and our families: ask forgiveness for us,’ but they say with their tongues what is not in their hearts. Say, ‘Whether it is God’s will to do you harm or good, who can intervene for you?’ No! God is fully aware of everything you [people] do"}, {"ayah": 12, "text": "بَلْ ظَنَنتُمْ أَن لَّن يَنقَلِبَ ٱلرَّسُولُ وَٱلْمُؤْمِنُونَ إِلَىٰٓ أَهْلِيهِمْ أَبَدًا وَزُيِّنَ ذَٰلِكَ فِى قُلُوبِكُمْ وَظَنَنتُمْ ظَنَّ ٱلسَّوْءِ وَكُنتُمْ قَوْمًۢا بُورًا ", "translation": "But you thought that the Messenger and the believers would never return to their families, ever, and that was made pleasing in your hearts. And you assumed an assumption of evil and became a people ruined.\"", "words": [{"id": 1, "arabic": "بَلْ", "translit": "ْlَb", "root": "", "latinTranslit": "bal"}, {"id": 2, "arabic": "ظَنَنتُمْ", "translit": "ْmُtnَnَẓ", "root": "ظنن", "latinTranslit": "ẓanantum"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": "", "latinTranslit": "an"}, {"id": 4, "arabic": "لَّن", "translit": "nَّl", "root": "", "latinTranslit": "lan"}, {"id": 5, "arabic": "يَنقَلِبَ", "translit": "َbِlَqnَy", "root": "قلب", "latinTranslit": "yanqaliba"}, {"id": 6, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل", "latinTranslit": "l-rasūlu"}, {"id": 7, "arabic": "وَٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱَw", "root": "امن", "latinTranslit": "wal-mu'minūna"}, {"id": 8, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": "", "latinTranslit": "ilā"}, {"id": 9, "arabic": "أَهْلِيهِمْ", "translit": "ْmِhyِlْhَaʾ", "root": "اهل", "latinTranslit": "ahlīhim"}, {"id": 10, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد", "latinTranslit": "abadan"}, {"id": 11, "arabic": "وَزُيِّنَ", "translit": "َnِّyُzَw", "root": "زين", "latinTranslit": "wazuyyina"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": "", "latinTranslit": "dhālika"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 14, "arabic": "قُلُوبِكُمْ", "translit": "ْmُkِbwُlُq", "root": "قلب", "latinTranslit": "qulūbikum"}, {"id": 15, "arabic": "وَظَنَنتُمْ", "translit": "ْmُtnَnَẓَw", "root": "ظنن", "latinTranslit": "waẓanantum"}, {"id": 16, "arabic": "ظَنَّ", "translit": "َّnَẓ", "root": "ظنن", "latinTranslit": "ẓanna"}, {"id": 17, "arabic": "ٱلسَّوْءِ", "translit": "ِءْwَّslٱ", "root": "سوا", "latinTranslit": "l-sawi"}, {"id": 18, "arabic": "وَكُنتُمْ", "translit": "ْmُtnُkَw", "root": "كون", "latinTranslit": "wakuntum"}, {"id": 19, "arabic": "قَوْمًۢا", "translit": "āًۢmْwَq", "root": "قوم", "latinTranslit": "qawman"}, {"id": 20, "arabic": "بُورًا", "translit": "āًrwُb", "root": "بور", "latinTranslit": "būran"}], "hasIhya": true, "haleemTranslation": "No! You thought that the Messenger and the believers would never return to their families and this thought warmed your hearts. Your thoughts are evil, for you are corrupt people", "clearyTranslation": "No! You thought that the Messenger and the believers would never return to their families and this thought warmed your hearts. Your thoughts are evil, for you are corrupt people"}, {"ayah": 13, "text": "وَمَن لَّمْ يُؤْمِنۢ بِٱللَّهِ وَرَسُولِهِۦ فَإِنَّآ أَعْتَدْنَا لِلْكَٰفِرِينَ سَعِيرًا ", "translation": "And whoever has not believed in Allāh and His Messenger - then indeed, We have prepared for the disbelievers a Blaze.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": "", "latinTranslit": "waman"}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": "", "latinTranslit": "lam"}, {"id": 3, "arabic": "يُؤْمِنۢ", "translit": "ۢnِmْwʾُy", "root": "امن", "latinTranslit": "yu'min"}, {"id": 4, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله", "latinTranslit": "bil-lahi"}, {"id": 5, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل", "latinTranslit": "warasūlihi"}, {"id": 6, "arabic": "فَإِنَّآ", "translit": "ٓāَّnِiʾَf", "root": "", "latinTranslit": "fa-innā"}, {"id": 7, "arabic": "أَعْتَدْنَا", "translit": "āَnْdَtْعَaʾ", "root": "عتد", "latinTranslit": "aʿtadnā"}, {"id": 8, "arabic": "لِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِl", "root": "كفر", "latinTranslit": "lil'kāfirīna"}, {"id": 9, "arabic": "سَعِيرًا", "translit": "āًryِعَs", "root": "سعر", "latinTranslit": "saʿīran"}], "hasIhya": true, "haleemTranslation": "We have prepared a blazing Fire for those who do not believe in God and His Messenger", "clearyTranslation": "We have prepared a blazing Fire for those who do not believe in God and His Messenger"}, {"ayah": 14, "text": "وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ يَغْفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۚ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ", "translation": "And to Allāh belongs the dominion of the heavens and the earth. He forgives whom He wills and punishes whom He wills. And ever is Allāh Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله", "latinTranslit": "walillahi"}, {"id": 2, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك", "latinTranslit": "mul'ku"}, {"id": 3, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو", "latinTranslit": "l-samāwāti"}, {"id": 4, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض", "latinTranslit": "wal-arḍi"}, {"id": 5, "arabic": "يَغْفِرُ", "translit": "ُrِfْغَy", "root": "غفر", "latinTranslit": "yaghfiru"}, {"id": 6, "arabic": "لِمَن", "translit": "nَmِl", "root": "", "latinTranslit": "liman"}, {"id": 7, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا", "latinTranslit": "yashāu"}, {"id": 8, "arabic": "وَيُعَذِّبُ", "translit": "ُbِّhdَعُyَw", "root": "عذب", "latinTranslit": "wayuʿadhibu"}, {"id": 9, "arabic": "مَن", "translit": "nَm", "root": "", "latinTranslit": "man"}, {"id": 10, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا", "latinTranslit": "yashāu"}, {"id": 11, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون", "latinTranslit": "wakāna"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 13, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر", "latinTranslit": "ghafūran"}, {"id": 14, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم", "latinTranslit": "raḥīman"}], "hasIhya": false, "haleemTranslation": "Control of the heavens and earth belongs to God and He forgives whoever He will and punishes whoever He will: God is most forgiving and merciful", "clearyTranslation": "Control of the heavens and earth belongs to God and He forgives whoever He will and punishes whoever He will: God is most forgiving and merciful"}, {"ayah": 15, "text": "سَيَقُولُ ٱلْمُخَلَّفُونَ إِذَا ٱنطَلَقْتُمْ إِلَىٰ مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْۖ يُرِيدُونَ أَن يُبَدِّلُوا۟ كَلَٰمَ ٱللَّهِۚ قُل لَّن تَتَّبِعُونَا كَذَٰلِكُمْ قَالَ ٱللَّهُ مِن قَبْلُۖ فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَاۚ بَلْ كَانُوا۟ لَا يَفْقَهُونَ إِلَّا قَلِيلًا ", "translation": "Those who remained[1] behind will say when you set out toward the war booty to take it, \"Let us follow you.\" They wish to change the words of Allāh. Say, \"Never will you follow us. Thus did Allāh say before.\" So they will say, \"Rather, you envy us.\" But [in fact] they were not understanding except a little.[2]", "words": [{"id": 1, "arabic": "سَيَقُولُ", "translit": "ُlwُqَyَs", "root": "قول", "latinTranslit": "sayaqūlu"}, {"id": 2, "arabic": "ٱلْمُخَلَّفُونَ", "translit": "َnwُfَّlَhkُmْlٱ", "root": "خلف", "latinTranslit": "l-mukhalafūna"}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": "", "latinTranslit": "idhā"}, {"id": 4, "arabic": "ٱنطَلَقْتُمْ", "translit": "ْmُtْqَlَṭnٱ", "root": "طلق", "latinTranslit": "inṭalaqtum"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": "", "latinTranslit": "ilā"}, {"id": 6, "arabic": "مَغَانِمَ", "translit": "َmِnāَغَm", "root": "غنم", "latinTranslit": "maghānima"}, {"id": 7, "arabic": "لِتَأْخُذُوهَا", "translit": "āَhwُhdُhkْaʾَtِl", "root": "اخذ", "latinTranslit": "litakhudhūhā"}, {"id": 8, "arabic": "ذَرُونَا", "translit": "āَnwُrَhd", "root": "وذر", "latinTranslit": "dharūnā"}, {"id": 9, "arabic": "نَتَّبِعْكُمْ", "translit": "ْmُkْعِbَّtَn", "root": "تبع", "latinTranslit": "nattabiʿ'kum"}, {"id": 10, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود", "latinTranslit": "yurīdūna"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": "", "latinTranslit": "an"}, {"id": 12, "arabic": "يُبَدِّلُوا۟", "translit": "۟āwُlِّdَbُy", "root": "بدل", "latinTranslit": "yubaddilū"}, {"id": 13, "arabic": "كَلَٰمَ", "translit": "َmَٰlَk", "root": "كلم", "latinTranslit": "kalāma"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 15, "arabic": "قُل", "translit": "lُq", "root": "قول", "latinTranslit": "qul"}, {"id": 16, "arabic": "لَّن", "translit": "nَّl", "root": "", "latinTranslit": "lan"}, {"id": 17, "arabic": "تَتَّبِعُونَا", "translit": "āَnwُعِbَّtَt", "root": "تبع", "latinTranslit": "tattabiʿūnā"}, {"id": 18, "arabic": "كَذَٰلِكُمْ", "translit": "ْmُkِlَٰhdَk", "root": "", "latinTranslit": "kadhālikum"}, {"id": 19, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول", "latinTranslit": "qāla"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 21, "arabic": "مِن", "translit": "nِm", "root": "", "latinTranslit": "min"}, {"id": 22, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل", "latinTranslit": "qablu"}, {"id": 23, "arabic": "فَسَيَقُولُونَ", "translit": "َnwُlwُqَyَsَf", "root": "قول", "latinTranslit": "fasayaqūlūna"}, {"id": 24, "arabic": "بَلْ", "translit": "ْlَb", "root": "", "latinTranslit": "bal"}, {"id": 25, "arabic": "تَحْسُدُونَنَا", "translit": "āَnَnwُdُsْḥَt", "root": "حسد", "latinTranslit": "taḥsudūnanā"}, {"id": 26, "arabic": "بَلْ", "translit": "ْlَb", "root": "", "latinTranslit": "bal"}, {"id": 27, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون", "latinTranslit": "kānū"}, {"id": 28, "arabic": "لَا", "translit": "āَl", "root": "", "latinTranslit": "lā"}, {"id": 29, "arabic": "يَفْقَهُونَ", "translit": "َnwُhَqْfَy", "root": "فقه", "latinTranslit": "yafqahūna"}, {"id": 30, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": "", "latinTranslit": "illā"}, {"id": 31, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل", "latinTranslit": "qalīlan"}], "hasIhya": false, "haleemTranslation": "When you [believers] set off for somewhere that promises war gains, those who [previously] stayed behind will say, ‘Let us come with you.’ They want to change God’s words, but tell them [Prophet], ‘You may not come with us: God has said this before.’ They will reply, ‘You begrudge us out of jealousy.’ How little they understand", "clearyTranslation": "When you [believers] set off for somewhere that promises war gains, those who [previously] stayed behind will say, ‘Let us come with you.’ They want to change God’s words, but tell them [Prophet], ‘You may not come with us: God has said this before.’ They will reply, ‘You begrudge us out of jealousy.’ How little they understand"}, {"ayah": 16, "text": "قُل لِّلْمُخَلَّفِينَ مِنَ ٱلْأَعْرَابِ سَتُدْعَوْنَ إِلَىٰ قَوْمٍ أُو۟لِى بَأْسٍ شَدِيدٍ تُقَٰتِلُونَهُمْ أَوْ يُسْلِمُونَۖ فَإِن تُطِيعُوا۟ يُؤْتِكُمُ ٱللَّهُ أَجْرًا حَسَنًاۖ وَإِن تَتَوَلَّوْا۟ كَمَا تَوَلَّيْتُم مِّن قَبْلُ يُعَذِّبْكُمْ عَذَابًا أَلِيمًا ", "translation": "Say to those who remained behind of the bedouins, \"You will be called to [face] a people of great military might; you may fight them, or they will submit.[1] So if you obey, Allāh will give you a good reward; but if you turn away as you turned away before, He will punish you with a painful punishment.\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول", "latinTranslit": "qul"}, {"id": 2, "arabic": "لِّلْمُخَلَّفِينَ", "translit": "َnyِfَّlَhkُmْlِّl", "root": "خلف", "latinTranslit": "lil'mukhallafīna"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": "", "latinTranslit": "mina"}, {"id": 4, "arabic": "ٱلْأَعْرَابِ", "translit": "ِbāَrْعَaʾْlٱ", "root": "عرب", "latinTranslit": "l-aʿrābi"}, {"id": 5, "arabic": "سَتُدْعَوْنَ", "translit": "َnْwَعْdُtَs", "root": "دعو", "latinTranslit": "satud'ʿawna"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": "", "latinTranslit": "ilā"}, {"id": 7, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم", "latinTranslit": "qawmin"}, {"id": 8, "arabic": "أُو۟لِى", "translit": "àِl۟wُaʾ", "root": "", "latinTranslit": "ulī"}, {"id": 9, "arabic": "بَأْسٍ", "translit": "ٍsْaʾَb", "root": "باس", "latinTranslit": "basin"}, {"id": 10, "arabic": "شَدِيدٍ", "translit": "ٍdyِdَhs", "root": "شدد", "latinTranslit": "shadīdin"}, {"id": 11, "arabic": "تُقَٰتِلُونَهُمْ", "translit": "ْmُhَnwُlِtَٰqُt", "root": "قتل", "latinTranslit": "tuqātilūnahum"}, {"id": 12, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": "", "latinTranslit": "aw"}, {"id": 13, "arabic": "يُسْلِمُونَ", "translit": "َnwُmِlْsُy", "root": "سلم", "latinTranslit": "yus'limūna"}, {"id": 14, "arabic": "فَإِن", "translit": "nِiʾَf", "root": "", "latinTranslit": "fa-in"}, {"id": 15, "arabic": "تُطِيعُوا۟", "translit": "۟āwُعyِṭُt", "root": "طوع", "latinTranslit": "tuṭīʿū"}, {"id": 16, "arabic": "يُؤْتِكُمُ", "translit": "ُmُkِtْwʾُy", "root": "اتي", "latinTranslit": "yu'tikumu"}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 18, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر", "latinTranslit": "ajran"}, {"id": 19, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن", "latinTranslit": "ḥasanan"}, {"id": 20, "arabic": "وَإِن", "translit": "nِiʾَw", "root": "", "latinTranslit": "wa-in"}, {"id": 21, "arabic": "تَتَوَلَّوْا۟", "translit": "۟āْwَّlَwَtَt", "root": "ولي", "latinTranslit": "tatawallaw"}, {"id": 22, "arabic": "كَمَا", "translit": "āَmَk", "root": "", "latinTranslit": "kamā"}, {"id": 23, "arabic": "تَوَلَّيْتُم", "translit": "mُtْyَّlَwَt", "root": "ولي", "latinTranslit": "tawallaytum"}, {"id": 24, "arabic": "مِّن", "translit": "nِّm", "root": "", "latinTranslit": "min"}, {"id": 25, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل", "latinTranslit": "qablu"}, {"id": 26, "arabic": "يُعَذِّبْكُمْ", "translit": "ْmُkْbِّhdَعُy", "root": "عذب", "latinTranslit": "yuʿadhib'kum"}, {"id": 27, "arabic": "عَذَابًا", "translit": "āًbāَhdَع", "root": "عذب", "latinTranslit": "ʿadhāban"}, {"id": 28, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم", "latinTranslit": "alīman"}], "hasIhya": false, "haleemTranslation": "Tell the desert Arabs who stayed behind, ‘You will be called to face a people of great might in war and to fight them, unless they surrender: if you obey, God will reward you well, but if you turn away, as you have done before, He will punish you heavily", "clearyTranslation": "Tell the desert Arabs who stayed behind, ‘You will be called to face a people of great might in war and to fight them, unless they surrender: if you obey, God will reward you well, but if you turn away, as you have done before, He will punish you heavily"}, {"ayah": 17, "text": "لَّيْسَ عَلَى ٱلْأَعْمَىٰ حَرَجٌ وَلَا عَلَى ٱلْأَعْرَجِ حَرَجٌ وَلَا عَلَى ٱلْمَرِيضِ حَرَجٌۗ وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ يُدْخِلْهُ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۖ وَمَن يَتَوَلَّ يُعَذِّبْهُ عَذَابًا أَلِيمًا ", "translation": "There is not upon the blind any guilt or upon the lame any guilt or upon the ill any guilt [for remaining behind]. And whoever obeys Allāh and His Messenger - He will admit him to gardens beneath which rivers flow; but whoever turns away - He will punish him with a painful punishment.", "words": [{"id": 1, "arabic": "لَّيْسَ", "translit": "َsْyَّl", "root": "ليس", "latinTranslit": "laysa"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 3, "arabic": "ٱلْأَعْمَىٰ", "translit": "ٰàَmْعَaʾْlٱ", "root": "عمي", "latinTranslit": "l-aʿmā"}, {"id": 4, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج", "latinTranslit": "ḥarajun"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": "", "latinTranslit": "walā"}, {"id": 6, "arabic": "عَلَى", "translit": "àَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 7, "arabic": "ٱلْأَعْرَجِ", "translit": "ِjgَrْعَaʾْlٱ", "root": "عرج", "latinTranslit": "l-aʿraji"}, {"id": 8, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج", "latinTranslit": "ḥarajun"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": "", "latinTranslit": "walā"}, {"id": 10, "arabic": "عَلَى", "translit": "àَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 11, "arabic": "ٱلْمَرِيضِ", "translit": "ِḍyِrَmْlٱ", "root": "مرض", "latinTranslit": "l-marīḍi"}, {"id": 12, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج", "latinTranslit": "ḥarajun"}, {"id": 13, "arabic": "وَمَن", "translit": "nَmَw", "root": "", "latinTranslit": "waman"}, {"id": 14, "arabic": "يُطِعِ", "translit": "ِعِṭُy", "root": "طوع", "latinTranslit": "yuṭiʿi"}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله", "latinTranslit": "l-laha"}, {"id": 16, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل", "latinTranslit": "warasūlahu"}, {"id": 17, "arabic": "يُدْخِلْهُ", "translit": "ُhْlِhkْdُy", "root": "دخل", "latinTranslit": "yud'khil'hu"}, {"id": 18, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن", "latinTranslit": "jannātin"}, {"id": 19, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري", "latinTranslit": "tajrī"}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": "", "latinTranslit": "min"}, {"id": 21, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت", "latinTranslit": "taḥtihā"}, {"id": 22, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر", "latinTranslit": "l-anhāru"}, {"id": 23, "arabic": "وَمَن", "translit": "nَmَw", "root": "", "latinTranslit": "waman"}, {"id": 24, "arabic": "يَتَوَلَّ", "translit": "َّlَwَtَy", "root": "ولي", "latinTranslit": "yatawalla"}, {"id": 25, "arabic": "يُعَذِّبْهُ", "translit": "ُhْbِّhdَعُy", "root": "عذب", "latinTranslit": "yuʿadhib'hu"}, {"id": 26, "arabic": "عَذَابًا", "translit": "āًbāَhdَع", "root": "عذب", "latinTranslit": "ʿadhāban"}, {"id": 27, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم", "latinTranslit": "alīman"}], "hasIhya": true, "haleemTranslation": "the blind, the lame, and the sick will not be blamed.’ God will admit anyone who obeys Him and His Messenger to Gardens graced with flowing streams; He will painfully punish anyone who turns away", "clearyTranslation": "the blind, the lame, and the sick will not be blamed.’ God will admit anyone who obeys Him and His Messenger to Gardens graced with flowing streams; He will painfully punish anyone who turns away"}, {"ayah": 18, "text": "لَّقَدْ رَضِىَ ٱللَّهُ عَنِ ٱلْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ تَحْتَ ٱلشَّجَرَةِ فَعَلِمَ مَا فِى قُلُوبِهِمْ فَأَنزَلَ ٱلسَّكِينَةَ عَلَيْهِمْ وَأَثَٰبَهُمْ فَتْحًا قَرِيبًا ", "translation": "Certainly was Allāh pleased with the believers when they pledged allegiance to you, [O Muḥammad], under the tree, and He knew what was in their hearts, so He sent down tranquility upon them and rewarded them with an imminent conquest[1]", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": "", "latinTranslit": "laqad"}, {"id": 2, "arabic": "رَضِىَ", "translit": "َàِḍَr", "root": "رضو", "latinTranslit": "raḍiya"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 4, "arabic": "عَنِ", "translit": "ِnَع", "root": "", "latinTranslit": "ʿani"}, {"id": 5, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن", "latinTranslit": "l-mu'minīna"}, {"id": 6, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": "", "latinTranslit": "idh"}, {"id": 7, "arabic": "يُبَايِعُونَكَ", "translit": "َkَnwُعِyāَbُy", "root": "بيع", "latinTranslit": "yubāyiʿūnaka"}, {"id": 8, "arabic": "تَحْتَ", "translit": "َtْḥَt", "root": "تحت", "latinTranslit": "taḥta"}, {"id": 9, "arabic": "ٱلشَّجَرَةِ", "translit": "ِẗَrَjgَّhslٱ", "root": "شجر", "latinTranslit": "l-shajarati"}, {"id": 10, "arabic": "فَعَلِمَ", "translit": "َmِlَعَf", "root": "علم", "latinTranslit": "faʿalima"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": "", "latinTranslit": "mā"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 13, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب", "latinTranslit": "qulūbihim"}, {"id": 14, "arabic": "فَأَنزَلَ", "translit": "َlَznَaʾَf", "root": "نزل", "latinTranslit": "fa-anzala"}, {"id": 15, "arabic": "ٱلسَّكِينَةَ", "translit": "َẗَnyِkَّslٱ", "root": "سكن", "latinTranslit": "l-sakīnata"}, {"id": 16, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَع", "root": "", "latinTranslit": "ʿalayhim"}, {"id": 17, "arabic": "وَأَثَٰبَهُمْ", "translit": "ْmُhَbَٰhtَaʾَw", "root": "ثوب", "latinTranslit": "wa-athābahum"}, {"id": 18, "arabic": "فَتْحًا", "translit": "āًḥْtَf", "root": "فتح", "latinTranslit": "fatḥan"}, {"id": 19, "arabic": "قَرِيبًا", "translit": "āًbyِrَq", "root": "قرب", "latinTranslit": "qarīban"}], "hasIhya": false, "haleemTranslation": "God was pleased with the believers when they swore allegiance to you [Prophet] under the tree: He knew what was in their hearts and so He sent tranquillity down to them and rewarded them with a speedy triumph", "clearyTranslation": "God was pleased with the believers when they swore allegiance to you [Prophet] under the tree: He knew what was in their hearts and so He sent tranquillity down to them and rewarded them with a speedy triumph"}, {"ayah": 19, "text": "وَمَغَانِمَ كَثِيرَةً يَأْخُذُونَهَاۗ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا ", "translation": "And much war booty which they will take. And ever is Allāh Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "وَمَغَانِمَ", "translit": "َmِnāَغَmَw", "root": "غنم", "latinTranslit": "wamaghānima"}, {"id": 2, "arabic": "كَثِيرَةً", "translit": "ًẗَryِhtَk", "root": "كثر", "latinTranslit": "kathīratan"}, {"id": 3, "arabic": "يَأْخُذُونَهَا", "translit": "āَhَnwُhdُhkْaʾَy", "root": "اخذ", "latinTranslit": "yakhudhūnahā"}, {"id": 4, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون", "latinTranslit": "wakāna"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 6, "arabic": "عَزِيزًا", "translit": "āًzyِzَع", "root": "عزز", "latinTranslit": "ʿazīzan"}, {"id": 7, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم", "latinTranslit": "ḥakīman"}], "hasIhya": false, "haleemTranslation": "and with many future gains. God is mighty and wise", "clearyTranslation": "and with many future gains. God is mighty and wise"}, {"ayah": 20, "text": "وَعَدَكُمُ ٱللَّهُ مَغَانِمَ كَثِيرَةً تَأْخُذُونَهَا فَعَجَّلَ لَكُمْ هَٰذِهِۦ وَكَفَّ أَيْدِىَ ٱلنَّاسِ عَنكُمْ وَلِتَكُونَ ءَايَةً لِّلْمُؤْمِنِينَ وَيَهْدِيَكُمْ صِرَٰطًا مُّسْتَقِيمًا ", "translation": "Allāh has promised you much booty that you will take [in the future] and has hastened for you this [victory] and withheld the hands of people from you - that it may be a sign for the believers and [that] He may guide you to a straight path.", "words": [{"id": 1, "arabic": "وَعَدَكُمُ", "translit": "ُmُkَdَعَw", "root": "وعد", "latinTranslit": "waʿadakumu"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 3, "arabic": "مَغَانِمَ", "translit": "َmِnāَغَm", "root": "غنم", "latinTranslit": "maghānima"}, {"id": 4, "arabic": "كَثِيرَةً", "translit": "ًẗَryِhtَk", "root": "كثر", "latinTranslit": "kathīratan"}, {"id": 5, "arabic": "تَأْخُذُونَهَا", "translit": "āَhَnwُhdُhkْaʾَt", "root": "اخذ", "latinTranslit": "takhudhūnahā"}, {"id": 6, "arabic": "فَعَجَّلَ", "translit": "َlَّjgَعَf", "root": "عجل", "latinTranslit": "faʿajjala"}, {"id": 7, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": "", "latinTranslit": "lakum"}, {"id": 8, "arabic": "هَٰذِهِۦ", "translit": "ۦِhِhdَٰh", "root": "", "latinTranslit": "hādhihi"}, {"id": 9, "arabic": "وَكَفَّ", "translit": "َّfَkَw", "root": "كفف", "latinTranslit": "wakaffa"}, {"id": 10, "arabic": "أَيْدِىَ", "translit": "َàِdْyَaʾ", "root": "يدي", "latinTranslit": "aydiya"}, {"id": 11, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس", "latinTranslit": "l-nāsi"}, {"id": 12, "arabic": "عَنكُمْ", "translit": "ْmُknَع", "root": "", "latinTranslit": "ʿankum"}, {"id": 13, "arabic": "وَلِتَكُونَ", "translit": "َnwُkَtِlَw", "root": "كون", "latinTranslit": "walitakūna"}, {"id": 14, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي", "latinTranslit": "āyatan"}, {"id": 15, "arabic": "لِّلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِّl", "root": "امن", "latinTranslit": "lil'mu'minīna"}, {"id": 16, "arabic": "وَيَهْدِيَكُمْ", "translit": "ْmُkَyِdْhَyَw", "root": "هدي", "latinTranslit": "wayahdiyakum"}, {"id": 17, "arabic": "صِرَٰطًا", "translit": "āًṭَٰrِṣ", "root": "صرط", "latinTranslit": "ṣirāṭan"}, {"id": 18, "arabic": "مُّسْتَقِيمًا", "translit": "āًmyِqَtْsُّm", "root": "قوم", "latinTranslit": "mus'taqīman"}], "hasIhya": false, "haleemTranslation": "He has promised you [people] many future gains: He has hastened this gain for you. He has held back the hands of hostile people from you as a sign for the faithful and He will guide you to a straight path", "clearyTranslation": "He has promised you [people] many future gains: He has hastened this gain for you. He has held back the hands of hostile people from you as a sign for the faithful and He will guide you to a straight path"}, {"ayah": 21, "text": "وَأُخْرَىٰ لَمْ تَقْدِرُوا۟ عَلَيْهَا قَدْ أَحَاطَ ٱللَّهُ بِهَاۚ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرًا ", "translation": "And [He promises] other [victories] that you were [so far] unable to [realize] which Allāh has already encompassed.[1] And ever is Allāh, over all things, competent.", "words": [{"id": 1, "arabic": "وَأُخْرَىٰ", "translit": "ٰàَrْhkُaʾَw", "root": "اخر", "latinTranslit": "wa-ukh'rā"}, {"id": 2, "arabic": "لَمْ", "translit": "ْmَl", "root": "", "latinTranslit": "lam"}, {"id": 3, "arabic": "تَقْدِرُوا۟", "translit": "۟āwُrِdْqَt", "root": "قدر", "latinTranslit": "taqdirū"}, {"id": 4, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَع", "root": "", "latinTranslit": "ʿalayhā"}, {"id": 5, "arabic": "قَدْ", "translit": "ْdَq", "root": "", "latinTranslit": "qad"}, {"id": 6, "arabic": "أَحَاطَ", "translit": "َṭāَḥَaʾ", "root": "حوط", "latinTranslit": "aḥāṭa"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 8, "arabic": "بِهَا", "translit": "āَhِb", "root": "", "latinTranslit": "bihā"}, {"id": 9, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون", "latinTranslit": "wakāna"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 11, "arabic": "عَلَىٰ", "translit": "ٰàَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 12, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل", "latinTranslit": "kulli"}, {"id": 13, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا", "latinTranslit": "shayin"}, {"id": 14, "arabic": "قَدِيرًا", "translit": "āًryِdَq", "root": "قدر", "latinTranslit": "qadīran"}], "hasIhya": false, "haleemTranslation": "There are many other gains [to come], over which you have no power. God has full control over them: God has power over all things", "clearyTranslation": "There are many other gains [to come], over which you have no power. God has full control over them: God has power over all things"}, {"ayah": 22, "text": "وَلَوْ قَٰتَلَكُمُ ٱلَّذِينَ كَفَرُوا۟ لَوَلَّوُا۟ ٱلْأَدْبَٰرَ ثُمَّ لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا ", "translation": "And if those [Makkans] who disbelieve had fought you, they would have turned their backs [in flight]. Then they would not find a protector or a helper.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": "", "latinTranslit": "walaw"}, {"id": 2, "arabic": "قَٰتَلَكُمُ", "translit": "ُmُkَlَtَٰq", "root": "قتل", "latinTranslit": "qātalakumu"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": "", "latinTranslit": "alladhīna"}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر", "latinTranslit": "kafarū"}, {"id": 5, "arabic": "لَوَلَّوُا۟", "translit": "۟āُwَّlَwَl", "root": "ولي", "latinTranslit": "lawallawū"}, {"id": 6, "arabic": "ٱلْأَدْبَٰرَ", "translit": "َrَٰbْdَaʾْlٱ", "root": "دبر", "latinTranslit": "l-adbāra"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": "", "latinTranslit": "thumma"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": "", "latinTranslit": "lā"}, {"id": 9, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد", "latinTranslit": "yajidūna"}, {"id": 10, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي", "latinTranslit": "waliyyan"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": "", "latinTranslit": "walā"}, {"id": 12, "arabic": "نَصِيرًا", "translit": "āًryِṣَn", "root": "نصر", "latinTranslit": "naṣīran"}], "hasIhya": false, "haleemTranslation": "If the disbelievers had fought against you, they would have taken flight and found no one to protect or support them", "clearyTranslation": "If the disbelievers had fought against you, they would have taken flight and found no one to protect or support them"}, {"ayah": 23, "text": "سُنَّةَ ٱللَّهِ ٱلَّتِى قَدْ خَلَتْ مِن قَبْلُۖ وَلَن تَجِدَ لِسُنَّةِ ٱللَّهِ تَبْدِيلًا ", "translation": "[This is] the established way of Allāh which has occurred before. And never will you find in the way of Allāh any change.", "words": [{"id": 1, "arabic": "سُنَّةَ", "translit": "َẗَّnُs", "root": "سنن", "latinTranslit": "sunnata"}, {"id": 2, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 3, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": "", "latinTranslit": "allatī"}, {"id": 4, "arabic": "قَدْ", "translit": "ْdَq", "root": "", "latinTranslit": "qad"}, {"id": 5, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو", "latinTranslit": "khalat"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": "", "latinTranslit": "min"}, {"id": 7, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل", "latinTranslit": "qablu"}, {"id": 8, "arabic": "وَلَن", "translit": "nَlَw", "root": "", "latinTranslit": "walan"}, {"id": 9, "arabic": "تَجِدَ", "translit": "َdِjgَt", "root": "وجد", "latinTranslit": "tajida"}, {"id": 10, "arabic": "لِسُنَّةِ", "translit": "ِẗَّnُsِl", "root": "سنن", "latinTranslit": "lisunnati"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 12, "arabic": "تَبْدِيلًا", "translit": "āًlyِdْbَt", "root": "بدل", "latinTranslit": "tabdīlan"}], "hasIhya": true, "haleemTranslation": "such was God’s practice in the past and you will find no change in God’s practices", "clearyTranslation": "such was God’s practice in the past and you will find no change in God’s practices"}, {"ayah": 24, "text": "وَهُوَ ٱلَّذِى كَفَّ أَيْدِيَهُمْ عَنكُمْ وَأَيْدِيَكُمْ عَنْهُم بِبَطْنِ مَكَّةَ مِنۢ بَعْدِ أَنْ أَظْفَرَكُمْ عَلَيْهِمْۚ وَكَانَ ٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرًا ", "translation": "And it is He who withheld their hands from you and your hands from them within [the area of] Makkah after He caused you to overcome them. And ever is Allāh, of what you do, Seeing.", "words": [{"id": 1, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": "", "latinTranslit": "wahuwa"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": "", "latinTranslit": "alladhī"}, {"id": 3, "arabic": "كَفَّ", "translit": "َّfَk", "root": "كفف", "latinTranslit": "kaffa"}, {"id": 4, "arabic": "أَيْدِيَهُمْ", "translit": "ْmُhَyِdْyَaʾ", "root": "يدي", "latinTranslit": "aydiyahum"}, {"id": 5, "arabic": "عَنكُمْ", "translit": "ْmُknَع", "root": "", "latinTranslit": "ʿankum"}, {"id": 6, "arabic": "وَأَيْدِيَكُمْ", "translit": "ْmُkَyِdْyَaʾَw", "root": "يدي", "latinTranslit": "wa-aydiyakum"}, {"id": 7, "arabic": "عَنْهُم", "translit": "mُhْnَع", "root": "", "latinTranslit": "ʿanhum"}, {"id": 8, "arabic": "بِبَطْنِ", "translit": "ِnْṭَbِb", "root": "بطن", "latinTranslit": "bibaṭni"}, {"id": 9, "arabic": "مَكَّةَ", "translit": "َẗَّkَm", "root": "", "latinTranslit": "makkata"}, {"id": 10, "arabic": "مِنۢ", "translit": "ۢnِm", "root": "", "latinTranslit": "min"}, {"id": 11, "arabic": "بَعْدِ", "translit": "ِdْعَb", "root": "بعد", "latinTranslit": "baʿdi"}, {"id": 12, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": "", "latinTranslit": "an"}, {"id": 13, "arabic": "أَظْفَرَكُمْ", "translit": "ْmُkَrَfْẓَaʾ", "root": "ظفر", "latinTranslit": "aẓfarakum"}, {"id": 14, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَع", "root": "", "latinTranslit": "ʿalayhim"}, {"id": 15, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون", "latinTranslit": "wakāna"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 17, "arabic": "بِمَا", "translit": "āَmِb", "root": "", "latinTranslit": "bimā"}, {"id": 18, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْعَt", "root": "عمل", "latinTranslit": "taʿmalūna"}, {"id": 19, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر", "latinTranslit": "baṣīran"}], "hasIhya": false, "haleemTranslation": "In the valley of Mecca it was He who held their hands back from you and your hands back from them after He gave you the advantage over them––God sees all that you do", "clearyTranslation": "In the valley of Mecca it was He who held their hands back from you and your hands back from them after He gave you the advantage over them––God sees all that you do"}, {"ayah": 25, "text": "هُمُ ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوكُمْ عَنِ ٱلْمَسْجِدِ ٱلْحَرَامِ وَٱلْهَدْىَ مَعْكُوفًا أَن يَبْلُغَ مَحِلَّهُۥۚ وَلَوْلَا رِجَالٌ مُّؤْمِنُونَ وَنِسَآءٌ مُّؤْمِنَٰتٌ لَّمْ تَعْلَمُوهُمْ أَن تَطَـُٔوهُمْ فَتُصِيبَكُم مِّنْهُم مَّعَرَّةٌۢ بِغَيْرِ عِلْمٍۖ لِّيُدْخِلَ ٱللَّهُ فِى رَحْمَتِهِۦ مَن يَشَآءُۚ لَوْ تَزَيَّلُوا۟ لَعَذَّبْنَا ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ عَذَابًا أَلِيمًا ", "translation": "They are the ones who disbelieved and obstructed you from al-Masjid al-Ḥarām while the offering[1] was prevented from reaching its place of sacrifice. And if not for believing men and believing women whom you did not know - that you might trample [i.e., kill] them and there would befall you because of them dishonor without [your] knowledge - [you would have been permitted to enter Makkah]. [This was so] that Allāh might admit to His mercy whom He willed. If they had been apart [from them], We would have punished those who disbelieved among them with painful punishment", "words": [{"id": 1, "arabic": "هُمُ", "translit": "ُmُh", "root": "", "latinTranslit": "humu"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": "", "latinTranslit": "alladhīna"}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر", "latinTranslit": "kafarū"}, {"id": 4, "arabic": "وَصَدُّوكُمْ", "translit": "ْmُkwُّdَṣَw", "root": "صدد", "latinTranslit": "waṣaddūkum"}, {"id": 5, "arabic": "عَنِ", "translit": "ِnَع", "root": "", "latinTranslit": "ʿani"}, {"id": 6, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد", "latinTranslit": "l-masjidi"}, {"id": 7, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم", "latinTranslit": "l-ḥarāmi"}, {"id": 8, "arabic": "وَٱلْهَدْىَ", "translit": "َàْdَhْlٱَw", "root": "هدي", "latinTranslit": "wal-hadya"}, {"id": 9, "arabic": "مَعْكُوفًا", "translit": "āًfwُkْعَm", "root": "عكف", "latinTranslit": "maʿkūfan"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": "", "latinTranslit": "an"}, {"id": 11, "arabic": "يَبْلُغَ", "translit": "َغُlْbَy", "root": "بلغ", "latinTranslit": "yablugha"}, {"id": 12, "arabic": "مَحِلَّهُۥ", "translit": "ۥُhَّlِḥَm", "root": "حلل", "latinTranslit": "maḥillahu"}, {"id": 13, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": "", "latinTranslit": "walawlā"}, {"id": 14, "arabic": "رِجَالٌ", "translit": "ٌlāَjgِr", "root": "رجل", "latinTranslit": "rijālun"}, {"id": 15, "arabic": "مُّؤْمِنُونَ", "translit": "َnwُnِmْwʾُّm", "root": "امن", "latinTranslit": "mu'minūna"}, {"id": 16, "arabic": "وَنِسَآءٌ", "translit": "ٌءٓāَsِnَw", "root": "نسو", "latinTranslit": "wanisāon"}, {"id": 17, "arabic": "مُّؤْمِنَٰتٌ", "translit": "ٌtَٰnِmْwʾُّm", "root": "امن", "latinTranslit": "mu'minātun"}, {"id": 18, "arabic": "لَّمْ", "translit": "ْmَّl", "root": "", "latinTranslit": "lam"}, {"id": 19, "arabic": "تَعْلَمُوهُمْ", "translit": "ْmُhwُmَlْعَt", "root": "علم", "latinTranslit": "taʿlamūhum"}, {"id": 20, "arabic": "أَن", "translit": "nَaʾ", "root": "", "latinTranslit": "an"}, {"id": 21, "arabic": "تَطَـُٔوهُمْ", "translit": "ْmُhwُٔـَṭَt", "root": "وطا", "latinTranslit": "taṭaūhum"}, {"id": 22, "arabic": "فَتُصِيبَكُم", "translit": "mُkَbyِṣُtَf", "root": "صوب", "latinTranslit": "fatuṣībakum"}, {"id": 23, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": "", "latinTranslit": "min'hum"}, {"id": 24, "arabic": "مَّعَرَّةٌۢ", "translit": "ٌۢẗَّrَعَّm", "root": "عرر", "latinTranslit": "maʿarratun"}, {"id": 25, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير", "latinTranslit": "bighayri"}, {"id": 26, "arabic": "عِلْمٍ", "translit": "ٍmْlِع", "root": "علم", "latinTranslit": "ʿil'min"}, {"id": 27, "arabic": "لِّيُدْخِلَ", "translit": "َlِhkْdُyِّl", "root": "دخل", "latinTranslit": "liyud'khila"}, {"id": 28, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 29, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 30, "arabic": "رَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَr", "root": "رحم", "latinTranslit": "raḥmatihi"}, {"id": 31, "arabic": "مَن", "translit": "nَm", "root": "", "latinTranslit": "man"}, {"id": 32, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا", "latinTranslit": "yashāu"}, {"id": 33, "arabic": "لَوْ", "translit": "ْwَl", "root": "", "latinTranslit": "law"}, {"id": 34, "arabic": "تَزَيَّلُوا۟", "translit": "۟āwُlَّyَzَt", "root": "زيل", "latinTranslit": "tazayyalū"}, {"id": 35, "arabic": "لَعَذَّبْنَا", "translit": "āَnْbَّhdَعَl", "root": "عذب", "latinTranslit": "laʿadhabnā"}, {"id": 36, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": "", "latinTranslit": "alladhīna"}, {"id": 37, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر", "latinTranslit": "kafarū"}, {"id": 38, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": "", "latinTranslit": "min'hum"}, {"id": 39, "arabic": "عَذَابًا", "translit": "āًbāَhdَع", "root": "عذب", "latinTranslit": "ʿadhāban"}, {"id": 40, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم", "latinTranslit": "alīman"}], "hasIhya": false, "haleemTranslation": "They were the ones who disbelieved, who barred you from the Sacred Mosque, and who prevented the offering from reaching its place of sacrifice. If there had not been among them, unknown to you, believing men and women whom you would have trampled underfoot, inadvertently incurring guilt on their account- God brings whoever He will into His mercy- if the [believers] had been clearly separated, We would have inflicted a painful punishment on the disbelievers", "clearyTranslation": "They were the ones who disbelieved, who barred you from the Sacred Mosque, and who prevented the offering from reaching its place of sacrifice. If there had not been among them, unknown to you, believing men and women whom you would have trampled underfoot, inadvertently incurring guilt on their account- God brings whoever He will into His mercy- if the [believers] had been clearly separated, We would have inflicted a painful punishment on the disbelievers"}, {"ayah": 26, "text": "إِذْ جَعَلَ ٱلَّذِينَ كَفَرُوا۟ فِى قُلُوبِهِمُ ٱلْحَمِيَّةَ حَمِيَّةَ ٱلْجَٰهِلِيَّةِ فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلْمُؤْمِنِينَ وَأَلْزَمَهُمْ كَلِمَةَ ٱلتَّقْوَىٰ وَكَانُوٓا۟ أَحَقَّ بِهَا وَأَهْلَهَاۚ وَكَانَ ٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمًا ", "translation": "When those who disbelieved had put into their hearts chauvinism - the chauvinism of the time of ignorance. But Allāh sent down His tranquility upon His Messenger and upon the believers and imposed upon them the word of righteousness, and they were more deserving of it and worthy of it. And ever is Allāh, of all things, Knowing.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": "", "latinTranslit": "idh"}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَعَjg", "root": "جعل", "latinTranslit": "jaʿala"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": "", "latinTranslit": "alladhīna"}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر", "latinTranslit": "kafarū"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 6, "arabic": "قُلُوبِهِمُ", "translit": "ُmِhِbwُlُq", "root": "قلب", "latinTranslit": "qulūbihimu"}, {"id": 7, "arabic": "ٱلْحَمِيَّةَ", "translit": "َẗَّyِmَḥْlٱ", "root": "حمي", "latinTranslit": "l-ḥamiyata"}, {"id": 8, "arabic": "حَمِيَّةَ", "translit": "َẗَّyِmَḥ", "root": "حمي", "latinTranslit": "ḥamiyyata"}, {"id": 9, "arabic": "ٱلْجَٰهِلِيَّةِ", "translit": "ِẗَّyِlِhَٰjgْlٱ", "root": "جهل", "latinTranslit": "l-jāhiliyati"}, {"id": 10, "arabic": "فَأَنزَلَ", "translit": "َlَznَaʾَf", "root": "نزل", "latinTranslit": "fa-anzala"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 12, "arabic": "سَكِينَتَهُۥ", "translit": "ۥُhَtَnyِkَs", "root": "سكن", "latinTranslit": "sakīnatahu"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 14, "arabic": "رَسُولِهِۦ", "translit": "ۦِhِlwُsَr", "root": "رسل", "latinTranslit": "rasūlihi"}, {"id": 15, "arabic": "وَعَلَى", "translit": "àَlَعَw", "root": "", "latinTranslit": "waʿalā"}, {"id": 16, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن", "latinTranslit": "l-mu'minīna"}, {"id": 17, "arabic": "وَأَلْزَمَهُمْ", "translit": "ْmُhَmَzْlَaʾَw", "root": "لزم", "latinTranslit": "wa-alzamahum"}, {"id": 18, "arabic": "كَلِمَةَ", "translit": "َẗَmِlَk", "root": "كلم", "latinTranslit": "kalimata"}, {"id": 19, "arabic": "ٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱ", "root": "وقي", "latinTranslit": "l-taqwā"}, {"id": 20, "arabic": "وَكَانُوٓا۟", "translit": "۟āٓwُnāَkَw", "root": "كون", "latinTranslit": "wakānū"}, {"id": 21, "arabic": "أَحَقَّ", "translit": "َّqَḥَaʾ", "root": "حقق", "latinTranslit": "aḥaqqa"}, {"id": 22, "arabic": "بِهَا", "translit": "āَhِb", "root": "", "latinTranslit": "bihā"}, {"id": 23, "arabic": "وَأَهْلَهَا", "translit": "āَhَlْhَaʾَw", "root": "اهل", "latinTranslit": "wa-ahlahā"}, {"id": 24, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون", "latinTranslit": "wakāna"}, {"id": 25, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 26, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل", "latinTranslit": "bikulli"}, {"id": 27, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا", "latinTranslit": "shayin"}, {"id": 28, "arabic": "عَلِيمًا", "translit": "āًmyِlَع", "root": "علم", "latinTranslit": "ʿalīman"}], "hasIhya": true, "haleemTranslation": "While the disbelievers had fury in their hearts- the fury of ignorance- God sent His tranquillity down on to His Messenger and the believers and made binding on them [their] promise to obey God, for that was more appropriate and fitting for them. God has full knowledge of all things", "clearyTranslation": "While the disbelievers had fury in their hearts- the fury of ignorance- God sent His tranquillity down on to His Messenger and the believers and made binding on them [their] promise to obey God, for that was more appropriate and fitting for them. God has full knowledge of all things"}, {"ayah": 27, "text": "لَّقَدْ صَدَقَ ٱللَّهُ رَسُولَهُ ٱلرُّءْيَا بِٱلْحَقِّۖ لَتَدْخُلُنَّ ٱلْمَسْجِدَ ٱلْحَرَامَ إِن شَآءَ ٱللَّهُ ءَامِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ لَا تَخَافُونَۖ فَعَلِمَ مَا لَمْ تَعْلَمُوا۟ فَجَعَلَ مِن دُونِ ذَٰلِكَ فَتْحًا قَرِيبًا ", "translation": "Certainly has Allāh showed to His Messenger the vision [i.e., dream] in truth. You will surely enter al-Masjid al-Ḥarām, if Allāh wills, in safety, with your heads shaved and [hair] shortened,[1] not fearing [anyone]. He knew what you did not know and has arranged before that a conquest near [at hand].", "words": [{"id": 1, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": "", "latinTranslit": "laqad"}, {"id": 2, "arabic": "صَدَقَ", "translit": "َqَdَṣ", "root": "صدق", "latinTranslit": "ṣadaqa"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 4, "arabic": "رَسُولَهُ", "translit": "ُhَlwُsَr", "root": "رسل", "latinTranslit": "rasūlahu"}, {"id": 5, "arabic": "ٱلرُّءْيَا", "translit": "āَyْءُّrlٱ", "root": "راي", "latinTranslit": "l-ru'yā"}, {"id": 6, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق", "latinTranslit": "bil-ḥaqi"}, {"id": 7, "arabic": "لَتَدْخُلُنَّ", "translit": "َّnُlُhkْdَtَl", "root": "دخل", "latinTranslit": "latadkhulunna"}, {"id": 8, "arabic": "ٱلْمَسْجِدَ", "translit": "َdِjgْsَmْlٱ", "root": "سجد", "latinTranslit": "l-masjida"}, {"id": 9, "arabic": "ٱلْحَرَامَ", "translit": "َmāَrَḥْlٱ", "root": "حرم", "latinTranslit": "l-ḥarāma"}, {"id": 10, "arabic": "إِن", "translit": "nِiʾ", "root": "", "latinTranslit": "in"}, {"id": 11, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا", "latinTranslit": "shāa"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 13, "arabic": "ءَامِنِينَ", "translit": "َnyِnِmāَء", "root": "امن", "latinTranslit": "āminīna"}, {"id": 14, "arabic": "مُحَلِّقِينَ", "translit": "َnyِqِّlَḥُm", "root": "حلق", "latinTranslit": "muḥalliqīna"}, {"id": 15, "arabic": "رُءُوسَكُمْ", "translit": "ْmُkَswُءُr", "root": "راس", "latinTranslit": "ruūsakum"}, {"id": 16, "arabic": "وَمُقَصِّرِينَ", "translit": "َnyِrِّṣَqُmَw", "root": "قصر", "latinTranslit": "wamuqaṣṣirīna"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": "", "latinTranslit": "lā"}, {"id": 18, "arabic": "تَخَافُونَ", "translit": "َnwُfāَhkَt", "root": "خوف", "latinTranslit": "takhāfūna"}, {"id": 19, "arabic": "فَعَلِمَ", "translit": "َmِlَعَf", "root": "علم", "latinTranslit": "faʿalima"}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": "", "latinTranslit": "mā"}, {"id": 21, "arabic": "لَمْ", "translit": "ْmَl", "root": "", "latinTranslit": "lam"}, {"id": 22, "arabic": "تَعْلَمُوا۟", "translit": "۟āwُmَlْعَt", "root": "علم", "latinTranslit": "taʿlamū"}, {"id": 23, "arabic": "فَجَعَلَ", "translit": "َlَعَjgَf", "root": "جعل", "latinTranslit": "fajaʿala"}, {"id": 24, "arabic": "مِن", "translit": "nِm", "root": "", "latinTranslit": "min"}, {"id": 25, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون", "latinTranslit": "dūni"}, {"id": 26, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": "", "latinTranslit": "dhālika"}, {"id": 27, "arabic": "فَتْحًا", "translit": "āًḥْtَf", "root": "فتح", "latinTranslit": "fatḥan"}, {"id": 28, "arabic": "قَرِيبًا", "translit": "āًbyِrَq", "root": "قرب", "latinTranslit": "qarīban"}], "hasIhya": true, "haleemTranslation": "God has truly fulfilled His Messenger’s vision: ‘God willing, you will most certainly enter the Sacred Mosque in safety, shavenheaded or with cropped hair, without fear!’- God knew what you did not- and He has granted you a speedy triumph", "clearyTranslation": "God has truly fulfilled His Messenger’s vision: ‘God willing, you will most certainly enter the Sacred Mosque in safety, shavenheaded or with cropped hair, without fear!’- God knew what you did not- and He has granted you a speedy triumph"}, {"ayah": 28, "text": "هُوَ ٱلَّذِىٓ أَرْسَلَ رَسُولَهُۥ بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦۚ وَكَفَىٰ بِٱللَّهِ شَهِيدًا ", "translation": "It is He who sent His Messenger with guidance and the religion of truth to manifest it over all religion. And sufficient is Allāh as Witness.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": "", "latinTranslit": "huwa"}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": "", "latinTranslit": "alladhī"}, {"id": 3, "arabic": "أَرْسَلَ", "translit": "َlَsْrَaʾ", "root": "رسل", "latinTranslit": "arsala"}, {"id": 4, "arabic": "رَسُولَهُۥ", "translit": "ۥُhَlwُsَr", "root": "رسل", "latinTranslit": "rasūlahu"}, {"id": 5, "arabic": "بِٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱِb", "root": "هدي", "latinTranslit": "bil-hudā"}, {"id": 6, "arabic": "وَدِينِ", "translit": "ِnyِdَw", "root": "دين", "latinTranslit": "wadīni"}, {"id": 7, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق", "latinTranslit": "l-ḥaqi"}, {"id": 8, "arabic": "لِيُظْهِرَهُۥ", "translit": "ۥُhَrِhْẓُyِl", "root": "ظهر", "latinTranslit": "liyuẓ'hirahu"}, {"id": 9, "arabic": "عَلَى", "translit": "àَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 10, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين", "latinTranslit": "l-dīni"}, {"id": 11, "arabic": "كُلِّهِۦ", "translit": "ۦِhِّlُk", "root": "كلل", "latinTranslit": "kullihi"}, {"id": 12, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي", "latinTranslit": "wakafā"}, {"id": 13, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله", "latinTranslit": "bil-lahi"}, {"id": 14, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد", "latinTranslit": "shahīdan"}], "hasIhya": false, "haleemTranslation": "It was He who sent His Messenger, with guidance and the religion of Truth, for him to show that it is above all [false] religion. God suffices as a witness", "clearyTranslation": "It was He who sent His Messenger, with guidance and the religion of Truth, for him to show that it is above all [false] religion. God suffices as a witness"}, {"ayah": 29, "text": "مُّحَمَّدٌ رَّسُولُ ٱللَّهِۚ وَٱلَّذِينَ مَعَهُۥٓ أَشِدَّآءُ عَلَى ٱلْكُفَّارِ رُحَمَآءُ بَيْنَهُمْۖ تَرَىٰهُمْ رُكَّعًا سُجَّدًا يَبْتَغُونَ فَضْلًا مِّنَ ٱللَّهِ وَرِضْوَٰنًاۖ سِيمَاهُمْ فِى وُجُوهِهِم مِّنْ أَثَرِ ٱلسُّجُودِۚ ذَٰلِكَ مَثَلُهُمْ فِى ٱلتَّوْرَىٰةِۚ وَمَثَلُهُمْ فِى ٱلْإِنجِيلِ كَزَرْعٍ أَخْرَجَ شَطْـَٔهُۥ فَـَٔازَرَهُۥ فَٱسْتَغْلَظَ فَٱسْتَوَىٰ عَلَىٰ سُوقِهِۦ يُعْجِبُ ٱلزُّرَّاعَ لِيَغِيظَ بِهِمُ ٱلْكُفَّارَۗ وَعَدَ ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ مِنْهُم مَّغْفِرَةً وَأَجْرًا عَظِيمًۢا ", "translation": "Muḥammad is the Messenger of Allāh; and those with him are forceful against the disbelievers, merciful among themselves. You see them bowing and prostrating [in prayer], seeking bounty from Allāh and [His] pleasure. Their sign is in their faces from the effect of prostration [i.e., prayer]. That is their description in the Torah. And their description in the Gospel is as a plant which produces its offshoots and strengthens them so they grow firm and stand upon their stalks, delighting the sowers - so that He [i.e., Allāh] may enrage by them[1] the disbelievers. Allāh has promised those who believe and do righteous deeds among them forgiveness and a great reward.", "words": [{"id": 1, "arabic": "مُّحَمَّدٌ", "translit": "ٌdَّmَḥُّm", "root": "حمد", "latinTranslit": "muḥammadun"}, {"id": 2, "arabic": "رَّسُولُ", "translit": "ُlwُsَّr", "root": "رسل", "latinTranslit": "rasūlu"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": "", "latinTranslit": "wa-alladhīna"}, {"id": 5, "arabic": "مَعَهُۥٓ", "translit": "ٓۥُhَعَm", "root": "", "latinTranslit": "maʿahu"}, {"id": 6, "arabic": "أَشِدَّآءُ", "translit": "ُءٓāَّdِhsَaʾ", "root": "شدد", "latinTranslit": "ashiddāu"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 8, "arabic": "ٱلْكُفَّارِ", "translit": "ِrāَّfُkْlٱ", "root": "كفر", "latinTranslit": "l-kufāri"}, {"id": 9, "arabic": "رُحَمَآءُ", "translit": "ُءٓāَmَḥُr", "root": "رحم", "latinTranslit": "ruḥamāu"}, {"id": 10, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين", "latinTranslit": "baynahum"}, {"id": 11, "arabic": "تَرَىٰهُمْ", "translit": "ْmُhٰàَrَt", "root": "راي", "latinTranslit": "tarāhum"}, {"id": 12, "arabic": "رُكَّعًا", "translit": "āًعَّkُr", "root": "ركع", "latinTranslit": "rukkaʿan"}, {"id": 13, "arabic": "سُجَّدًا", "translit": "āًdَّjgُs", "root": "سجد", "latinTranslit": "sujjadan"}, {"id": 14, "arabic": "يَبْتَغُونَ", "translit": "َnwُغَtْbَy", "root": "بغي", "latinTranslit": "yabtaghūna"}, {"id": 15, "arabic": "فَضْلًا", "translit": "āًlْḍَf", "root": "فضل", "latinTranslit": "faḍlan"}, {"id": 16, "arabic": "مِّنَ", "translit": "َnِّm", "root": "", "latinTranslit": "mina"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله", "latinTranslit": "l-lahi"}, {"id": 18, "arabic": "وَرِضْوَٰنًا", "translit": "āًnَٰwْḍِrَw", "root": "رضو", "latinTranslit": "wariḍ'wānan"}, {"id": 19, "arabic": "سِيمَاهُمْ", "translit": "ْmُhāَmyِs", "root": "سوم", "latinTranslit": "sīmāhum"}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 21, "arabic": "وُجُوهِهِم", "translit": "mِhِhwُjgُw", "root": "وجه", "latinTranslit": "wujūhihim"}, {"id": 22, "arabic": "مِّنْ", "translit": "ْnِّm", "root": "", "latinTranslit": "min"}, {"id": 23, "arabic": "أَثَرِ", "translit": "ِrَhtَaʾ", "root": "اثر", "latinTranslit": "athari"}, {"id": 24, "arabic": "ٱلسُّجُودِ", "translit": "ِdwُjgُّslٱ", "root": "سجد", "latinTranslit": "l-sujūdi"}, {"id": 25, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": "", "latinTranslit": "dhālika"}, {"id": 26, "arabic": "مَثَلُهُمْ", "translit": "ْmُhُlَhtَm", "root": "مثل", "latinTranslit": "mathaluhum"}, {"id": 27, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 28, "arabic": "ٱلتَّوْرَىٰةِ", "translit": "ِẗٰàَrْwَّtlٱ", "root": "", "latinTranslit": "l-tawrāti"}, {"id": 29, "arabic": "وَمَثَلُهُمْ", "translit": "ْmُhُlَhtَmَw", "root": "مثل", "latinTranslit": "wamathaluhum"}, {"id": 30, "arabic": "فِى", "translit": "àِf", "root": "", "latinTranslit": "fī"}, {"id": 31, "arabic": "ٱلْإِنجِيلِ", "translit": "ِlyِjgnِiʾْlٱ", "root": "", "latinTranslit": "l-injīli"}, {"id": 32, "arabic": "كَزَرْعٍ", "translit": "ٍعْrَzَk", "root": "زرع", "latinTranslit": "kazarʿin"}, {"id": 33, "arabic": "أَخْرَجَ", "translit": "َjgَrْhkَaʾ", "root": "خرج", "latinTranslit": "akhraja"}, {"id": 34, "arabic": "شَطْـَٔهُۥ", "translit": "ۥُhَٔـْṭَhs", "root": "شطا", "latinTranslit": "shaṭahu"}, {"id": 35, "arabic": "فَـَٔازَرَهُۥ", "translit": "ۥُhَrَzāَٔـَf", "root": "ازر", "latinTranslit": "faāzarahu"}, {"id": 36, "arabic": "فَٱسْتَغْلَظَ", "translit": "َẓَlْغَtْsٱَf", "root": "غلظ", "latinTranslit": "fa-is'taghlaẓa"}, {"id": 37, "arabic": "فَٱسْتَوَىٰ", "translit": "ٰàَwَtْsٱَf", "root": "سوي", "latinTranslit": "fa-is'tawā"}, {"id": 38, "arabic": "عَلَىٰ", "translit": "ٰàَlَع", "root": "", "latinTranslit": "ʿalā"}, {"id": 39, "arabic": "سُوقِهِۦ", "translit": "ۦِhِqwُs", "root": "سوق", "latinTranslit": "sūqihi"}, {"id": 40, "arabic": "يُعْجِبُ", "translit": "ُbِjgْعُy", "root": "عجب", "latinTranslit": "yuʿ'jibu"}, {"id": 41, "arabic": "ٱلزُّرَّاعَ", "translit": "َعāَّrُّzlٱ", "root": "زرع", "latinTranslit": "l-zurāʿa"}, {"id": 42, "arabic": "لِيَغِيظَ", "translit": "َẓyِغَyِl", "root": "غيظ", "latinTranslit": "liyaghīẓa"}, {"id": 43, "arabic": "بِهِمُ", "translit": "ُmِhِb", "root": "", "latinTranslit": "bihimu"}, {"id": 44, "arabic": "ٱلْكُفَّارَ", "translit": "َrāَّfُkْlٱ", "root": "كفر", "latinTranslit": "l-kufāra"}, {"id": 45, "arabic": "وَعَدَ", "translit": "َdَعَw", "root": "وعد", "latinTranslit": "waʿada"}, {"id": 46, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله", "latinTranslit": "l-lahu"}, {"id": 47, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": "", "latinTranslit": "alladhīna"}, {"id": 48, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن", "latinTranslit": "āmanū"}, {"id": 49, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَعَw", "root": "عمل", "latinTranslit": "waʿamilū"}, {"id": 50, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح", "latinTranslit": "l-ṣāliḥāti"}, {"id": 51, "arabic": "مِنْهُم", "translit": "mُhْnِm", "root": "", "latinTranslit": "min'hum"}, {"id": 52, "arabic": "مَّغْفِرَةً", "translit": "ًẗَrِfْغَّm", "root": "غفر", "latinTranslit": "maghfiratan"}, {"id": 53, "arabic": "وَأَجْرًا", "translit": "āًrْjgَaʾَw", "root": "اجر", "latinTranslit": "wa-ajran"}, {"id": 54, "arabic": "عَظِيمًۢا", "translit": "āًۢmyِẓَع", "root": "عظم", "latinTranslit": "ʿaẓīman"}], "hasIhya": true, "haleemTranslation": "Muhammad is the Messenger of God. Those who follow him are harsh towards the disbelievers and compassionate towards each other. You see them kneeling and prostrating, seeking God’s bounty and His good pleasure: on their faces they bear the marks of their prostrations. This is how they are pictured in the Torah and the Gospel: like a seed that puts forth its shoot, becomes strong, grows thick, and rises on its stem to the delight of its sowers. So God infuriates the disbelievers through them; God promises forgiveness and a great reward to those who believe and do righteous deeds", "clearyTranslation": "Muhammad is the Messenger of God. Those who follow him are harsh towards the disbelievers and compassionate towards each other. You see them kneeling and prostrating, seeking God’s bounty and His good pleasure: on their faces they bear the marks of their prostrations. This is how they are pictured in the Torah and the Gospel: like a seed that puts forth its shoot, becomes strong, grows thick, and rises on its stem to the delight of its sowers. So God infuriates the disbelievers through them; God promises forgiveness and a great reward to those who believe and do righteous deeds"}], "tafsir": {"2": [{"arabic": "آخر ولم يسه فيهما غفر له ما تقدم من ذنبه وقال صلى الله عليه وسلم أيضا ألا أنبئكم بما يكفر الله به الخطايا ويرفع به الدرجات إسباغ الوضوء على المكاره ونقل الأقدام إلى المساجد وانتظار الصلاة بعد الصلاة فذلكم الرباط ثلاث مرات (2) وتوضأ صلى الله عليه وسلم مرة مرة وقال هذا وضوء لا يقبل الله الصلاة إلا به وتوضأ مرتين مرتين وقال من توضأ مرتين مرتين أتاه الله أجره مرتين وتوضأ ثلاثا ثلاثا وقال هذا وضوئي ووضوء الأنبياء من قبلي ووضوء خليل الرحمن", "english": "The Messenger of God, may God bless him and grant him peace, said: \"Whoever performs ablution and does it well, then prays two rakʿahs in which he does not speak to himself of anything of this world, will come out of his sins like the day his mother bore him.\" In another wording: \"And does not err in them, his past sins will be forgiven him.\" He, may God bless him and grant him peace, also said: \"Shall I not inform you of that by which God erases sins and by which He raises degrees? The perfecting of ablution despite hardships, and the taking of many steps to the mosques, and the waiting for prayer after prayer — that is the ribāṭ (the constant guarding of the frontier).\" He said this three times. And he, may God bless him and grant him peace, performed ablution once each (washing each limb once) and said: \"This is an ablution without which God does not accept the prayer.\" And he performed ablution twice each and said: \"Whoever performs ablution twice each, God will give him his reward twice.\" And he performed ablution three times each and said: \"This is my ablution, and the ablution of the prophets before me, and the ablution of the Friend of the Merciful, Abraham, peace be upon him.\" And he, may God bless him and grant him peace, said: \"Whoever mentions God at his ablution, God will purify his entire body; and whoever does not mention God, only that which the water touches will be purified.\" And he, may God bless him and grant him peace, said: \"Whoever performs ablution while already in a state of purity, God writes for him ten good deeds.\" And he, may God bless him and grant him peace, said: \"Ablution upon ablution is light upon light.\" All of this is an encouragement to renew the ablution. And he, peace be upon him, said: \"When the Muslim servant performs ablution and rinses his mouth, the sins exit from his mouth; when he snuffs water into his nose, the sins exit from his nose; when he washes his face, the sins exit from his face, until they exit from beneath his eyelashes; when he washes his hands, the sins exit from his hands, until they exit from beneath his fingernails; when he wipes his head, the sins exit from his head, until they exit from beneath his ears; and when he washes his feet, the sins exit from his feet, until they exit from beneath the nails of his feet. Then his walking to the mosque and his prayer are an additional merit for him.\" And it is related that \"the one in a state of purity is like the one who is fasting.\" He, may God bless him and grant him peace, said: \"Whoever performs ablution and does it well, then raises his gaze to the sky and says, 'I bear witness that there is no god but God alone, with no partner, and I bear witness that Muhammad is His servant and His Messenger' — the eight gates of Paradise are opened for him, and he enters through whichever of them he wishes.\" And ʿUmar, may God be pleased with him, said: \"Indeed, the sound ablution drives the devil away from you.\" And Mujāhid said: \"Whoever is able to not spend the night except in a state of purity, remembering God and seeking His forgiveness, let him do so, for the souls are raised according to the state in which they were seized.\"", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 113", "section_title_en": "The Virtue of Ablution (Faḍīlat al-Wuḍūʾ) and the Manner of the Major Ritual Bath (Kayfiyyat al-Ghusl)", "section_index": 113, "anchors": "- Root: وضو (W-Ḍ-W)\n  * Lisan / Ayn: The root denotes cleanliness, brightness, and perfection; al-wuḍūʾ is the specific act of ritual purification with water for prayer.\n  * Al-Raghib (Mufradat): The term is used for the specific act of washing the limbs in preparation for prayer, a divinely ordained purification that removes both physical and spiritual defilement.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the physical washing of the limbs; metaphorical (majāz) usage extends to the purification of the soul from sins, as sins are said to \"exit\" with the water.\n- Root: غسل (Gh-S-L)\n  * Lisan / Ayn: To wash, to remove dirt or filth by pouring water over something.\n  * Al-Raghib (Mufradat): \"غسلت الشيء غسلا: أسلت عليه الماء فأزلت درنه\" — to pour water over a thing to remove its filth. Al-Ghusl is the name for the act of washing the entire body, and al-ghusl (with damma) is the water used for washing. The root also yields \"al-ghislīn\" (غسلين), the filth-washing of the bodies of the disbelievers in Hellfire.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is the physical washing of the body. Metaphorical (majāz) usage is found in phrases like \"تلطخ بعار لن يغسل عنه أبدا\" (stained with a disgrace that will never be washed away), indicating that which cannot be cleansed or absolved.\n- Root: راس (R-A-S)\n  * Lisan / Ayn: The head; also used for a leader or chief.\n  * Al-Raghib (Mufradat): \"الرأس معروف\" — the head is well-known; it is used metaphorically for the leader (al-raʾīs).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the physical head. Metaphorical (majāz) usage is found in \"رأس الدين الخشية\" (the head of the religion is God-consciousness) and \"هو رأس قومه\" (he is the head of his people).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of separating a preposition from its object, which is relevant for correctly parsing the grammatical relationships in the hadith reports, ensuring the subject of the verb is correctly identified.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}, {"arabic": "استأنف العمل فقد غفر لك ما تقدم من ذنبك ورفع الله سبحانه عنك عذاب القبر وضيقه وظلمته ورفع عنك شدائد القيامة ورفع له من يومه عمل نبي (4) يوم الخميس عن عكرمة عن ابن عباس قال قال رسول الله صلى الله عليه وسلم من صلى يوم الخميس بين الظهر والعصر ركعتين يقرأ في الأولى فاتحة الكتاب وآية الكرسي مائة مرة وفي الثانية فاتحة الكتاب وقل هو الله أحد مائة مرة ويصلي على محمد مائة مرة أعطاه الله ثواب من صام رجب وشعبان ورمضان وكان له من الثواب مثل حاج الب", "english": "**Wednesday:** Abū Idrīs al-Khawlānī narrated from Muʿādh ibn Jabal — may Allah be pleased with him — who said: The Messenger of Allah — peace and blessings be upon him — said: \"Whoever prays on Wednesday twelve units when the sun has risen high, reciting in each unit the Opening of the Book and the Throne Verse once, {«قل هو الله أحد»} three times, and the two chapters of refuge three times — a caller will call out from beside the Throne: 'O servant of Allah, begin your deeds anew, for what has preceded of your sin has been forgiven you.' And Allah — Glorified be He — will raise from you the punishment of the grave, its constriction and its darkness; and He will raise from you the severities of the Resurrection; and there will be raised for him, from that day, the deed of a prophet.\"", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 159", "section_title_en": "The Revival of the Religious Sciences — Section 159: On the Virtues of Prayers for Each Day of the Week", "section_index": 159, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: Core temporal unit; from sunrise to sunset, or any extended period.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — denotes the period from sunrise to sunset, or any duration whatsoever; when added to Allah (أيام الله), it signifies His mighty deeds and epochs.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the solar day. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — used for notable events and battles.\n- Root: ركع (rakaʿa)\n  * Lisan / Ayn: To bow; the act of bowing in prayer.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء، فتارة يستعمل في الهيئة المخصوصة في الصلاة كما هي، وتارة في التواضع والتذلل\" — bowing; used literally for the specific prayer posture, and metaphorically for humility and submission.\n  * Al-Zamakhshari (Asas): Literal: \"شيخ راكع: منحن من الكبر\" — an old man bent with age. Metaphorical: \"لغبت الإبل حتى ركعت\" — camels weary to the point of collapsing on their front legs. In prayer, a ركعة (rakʿah) is a unit named after its bowing.\n- Root: فتح (fataḥa)\n  * Lisan / Ayn: To open; to unlock.\n  * Al-Raghib (Mufradat): \"الفتح: إزالة الإغلاق والإشكال\" — removal of closure and obstruction; perceptible by sight (opening a door) or by insight (removing distress).\n  * Al-Zamakhshari (Asas): Literal: opening a physical door. Metaphorical: \"فتح الله عليه: نصره\" — Allah's granting victory; \"فتح على فلان\" — prosperity and worldly success.\n- Root: احد (aḥad)\n  * Lisan / Ayn: One; unique; the first of the six roots of the triliteral system.\n  * Al-Raghib (Mufradat): Used for Allah's absolute oneness; \"وحدوا الله\" — declare His unity.\n  * Al-Zamakhshari (Asas): Literal: numerical oneness. Metaphorical: exclusive uniqueness, as in the divine name \"الأحد\" (The One).\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The conditional clauses (من صلى...) followed by apodoses (كتب له...) establish a restricted causal nexus: the reward is bound precisely to the specified action, its time, and its prescribed form.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}, {"arabic": "قدماه فقيل له أما قد غفر الله لك ما تقدم من ذنبك وما تأخر فقال أفلا أكون عبدا شكورا (6) ويظهر من معناه أن ذلك كناية عن زيادة الرتبة فإن الشكر سبب المزيد قال تعالى {لئن شكرتم لأزيدنكم} وقال صلى الله عليه وسلم يا أبا هريرة أتريد أن تكون رحمة الله عليك حيا وميتا ومقبورا ومبعوثا قم من الليل", "english": "And al-Mughīrah ibn Shuʿbah said: \"The Messenger of Allah (ﷺ) stood in prayer until his feet swelled. It was said to him: 'Has Allah not already forgiven you your former and latter sins?' He said: 'Shall I not then be a grateful servant?'\" What appears from its meaning is that this is a metaphor (*kināyah*) for the increase of rank — for gratitude is the cause of increase. Allah, Exalted is He, said: {«لَئِن شَكَرْتُمْ لَأَزِيدَنَّكُمْ»} (Ibrahim: 7).", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 272", "section_title_en": "The Virtue of Reviving the Time Between the Two Evening Prayers (Maghrib and ʿIshāʾ) — The Virtue of Night Prayer (Qiyām al-Layl)", "section_index": 272, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: The root denotes the night, from sunset to dawn; its plural forms include *layāl* and *layālī*. Al-Farahidi notes its archaic derivation from *laylāh*.\n  * Al-Raghib (Mufradat): The night is a divinely ordained sign and period of worship; Allah says {«وَسَخَّرَ لَكُمُ اللَّيْلَ وَالنَّهَارَ»} (Ibrahim: 33) and swears by it in {«وَاللَّيْلِ إِذَا يَغْشَىٰ»} (Al-Layl: 1). It is the chosen time for the *nāshiʾah* — the prayer that rises by night.\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): the night as a temporal span. Metaphorical (*majāz*): \"a night of hardship\" or the soul's \"night\" of heedlessness. Here, the night is the literal arena for supererogatory worship.\n- Root: وفي (Wafā)\n  * Lisan / Ayn: Completeness, fulfillment, and reaching full measure. A thing that is *wāfin* is complete and whole.\n  * Al-Raghib (Mufradat): *Al-Wāfī* is that which has reached completion. Allah says {«وَأَوْفُوا بِعَهْدِي أُوفِ بِعَهْدِكُمْ»} (Al-Baqarah: 40). The night prayer is described as {«أَقْوَمُ قِيلًا»} — more upright in speech and more complete in its effect upon the heart.\n  * Al-Zamakhshari (Asas): Literal: a full measure or complete thing. Metaphorical: \"he reached the hundred\" (*awfā ʿalā al-miʾah*), i.e., surpassed it. The night prayer \"fulfills\" the soul's potential for nearness to Allah.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and has life. Al-Farahidi connects it to *nafas* (breath) and *nufūs* (precious things).\n  * Al-Raghib (Mufradat): The *nafs* is the rational soul and the seat of moral struggle (*mujāhadah*). Allah says {«إِنَّ النَّفْسَ لَأَمَّارَةٌ بِالسُّوءِ»} (Yusuf: 53). The ḥadīth describes the one who prays at night as becoming \"good of soul\" (*ṭayyib al-nafs*), while the sluggard becomes \"evil of soul\" (*khabīth al-nafs*).\n  * Al-Zamakhshari (Asas): Literal: the self or person. Metaphorical: \"he poured out his soul\" (i.e., his blood). Here, the *nafs* is the battlefield between the worshipper and the devil's whisperings.\n- Root: خبر (Khabar)\n  * Lisan / Ayn: News, report, or information; also experience and knowledge of a thing's inner state.\n  * Al-Raghib (Mufradat): *Al-Khabar* is knowledge of things through report. The *akhbār* (plural) are the prophetic traditions cited as evidence alongside the Qur'anic verses.\n  * Al-Zamakhshari (Asas): Literal: to test or try a thing to know its state. Metaphorical: \"his mirror reports of his unknown\" — i.e., reveals what is hidden. The *akhbār* here are the authoritative reports from the Prophet (ﷺ).\n- Sibawayh Rule: The rule of *al-ʿaṭf ʿalā al-sabab* (coordination on a cause) — when multiple conditions are linked by *fa* (then), each is a consequence of the preceding, as in the ḥadīth of the three knots: \"If he wakes and remembers Allah, a knot is untied; if he performs ablution, a knot is untied; if he prays, a knot is untied\" — each act builds upon the previous, and the *fa* indicates sequential causation.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}], "4": [{"arabic": "إيمانا وقال تعالى ليزدادوا إيمانا مع إيمانهم وقال صلى الله عليه وسلم فيما يروى في بعض الأخبار الإيمان يزيد وينقص (2) وذلك بتأثير الطاعات في القلب وهذا لا يدركه إلا من راقب أحوال نفسه في أوقات المواظبة على العبادة والتجرد لها بحضور القلب مع أوقات الفتور وإدراك التفاوت في السكون إلى عقائد الإيمان في هذه الأحوال حتى يزيد عقده استعصاء على من يريد حله بالتشكيك بل من يعتقد في اليتيم معنى الرحمة إذا عمل بموجب اعتقاده فمسح رأسه وتلطف به أدرك", "english": "And this exists in the true conviction as well. Works effect the growth of this resolve and its increase, just as the watering of trees effects their growth. For this reason God — exalted — said: {فزادتهم إيمانا} \"And it increased them in faith\" {«فزادتهم إيمانا»} and said: {ليزدادوا إيمانا مع إيمانهم} \"That they might increase in faith upon their faith\" {«ليزدادوا إيمانا مع إيمانهم»}. And the Prophet — peace be upon him — said, as narrated in some reports: \"Faith increases and decreases\" (2). That is by the effect of acts of obedience upon the heart. This is perceived only by one who watches over the states of his soul — in the times of persevering in worship and devoting oneself to it with presence of heart — as against the times of languor, and perceives the disparity in tranquility (sukūn) toward the tenets of faith in these states, until his knot increases in resistance to anyone who would undo it by casting doubt. Nay, consider one who holds the meaning of mercy toward an orphan: if he acts upon the requirement of his conviction — wiping the orphan's head and being kind to him — he perceives within his inner self the reinforcement of mercy and its multiplication by reason of the work. Likewise, one who holds the conviction of humility: if he acts upon its requirement — advancing or prostrating before another — he senses in his heart the humility when he undertakes the service.", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 100", "section_title_en": "On the Increase and Decrease of Faith (Al-Īmān) — Section 100", "section_index": 100, "anchors": "- Root: زيد (z-y-d)\n  * Lisan / Ayn: Core meaning of increase in quantity, quality, or degree; augmentation upon a pre-existing base.\n  * Al-Raghib (Mufradat): Increase (ziyādah) presupposes an existing essence (dhāt) that receives accretion; it is not constitutive of the thing's existence but an accident upon it.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage applies to corporeal growth (e.g., a man's height); metaphorical (majāz) usage extends to spiritual and moral states, where increase is by qualities, not by essence.\n- Root: صدق (ṣ-d-q)\n  * Lisan / Ayn: Firmness, veracity, and strength of conviction; the root implies solidity without fissure.\n  * Al-Raghib (Mufradat): Taṣdīq (assent) is the heart's affirmation of a reported truth, distinguished from mere knowledge by its volitional and settled character.\n  * Al-Zamakhshari (Asas): Literal: confirming a statement as true. Metaphorical: the heart's unwavering resolution (taṣmīm) that admits of degrees of intensity.\n- Root: عقد (ʿ-q-d)\n  * Lisan / Ayn: Tying, knotting, binding; a knot (ʿuqdah) that holds fast or loosens.\n  * Al-Raghib (Mufradat): Contract or covenant; here extended to the heart's conviction as a binding knot that strengthens or weakens.\n  * Al-Zamakhshari (Asas): Literal: physical knotting of a rope. Metaphorical: the firmness of belief as a knot in the heart, subject to tightening and loosening.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the referent of \"faith\" (īmān) to taṣdīq alone, excluding works from its essence while affirming their augmentative role.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}], "5": [{"arabic": "نفسه وعلم ذلك كان كذلك عند الله وكذا من كان مسرورا أو حزينا أو سميعا أو بصيرا ولو قيل للإنسان هل أنت حيوان لم يحسن أن يقول أنا حيوان إن شاء الله ولما قال سفيان ذلك قيل له فماذا نقول قال قولوا آمنا بالله وما أنزل إلينا وأي فرق بين أن يقول آمنا بالله وما أنزل إلينا وبين أن يقول أنا مؤمن وقيل للحسن أمؤمن أنت فقال إن شاء الله فقيل له لم تستثني يا أبا سعيد في الإيمان فقال أخاف أن أقول نعم فيقول الله سبحانه كذبت يا حسن ف", "english": "For Sufyān al-Thawrī — may God have mercy on him — said: \"Whoever says, 'I am a believer before God,' is among the liars. And whoever says, 'I am a believer truly (ḥaqqan),' is an innovator (bidʿah).\"", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 102", "section_title_en": "On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102", "section_index": 102, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Ihya Ulum al-Din'", "badge": "Insight"}], "12": [{"arabic": "بربكم أرداكم وقال تعالى وظننتم ظن السوء وكنتم قوما بورا وقال صلى الله عليه وسلم إن الله تعالى يقول للعبد يوم القيامة ما منعك إذ رأيت المنكر أن تنكره فإن لقنه الله حجته قال يا رب رجوتك وخفت الناس قال فيقول الله تعالى قد غفرته لك (4) وفي الخبر الصحيح أن رجلا كان يداين الناس فيسامح الغني ويتجاوز عن المعسر فلقي الله ولم يعمل خيرا قط فقال الله عز وجل من أحق بذلك منا (5) فعفا عنه لحسن ظنه ورجائه أن يعفو عنه مع إفلاسه عن الطاعات وقال تعالى إن الذين يتلون ك", "english": "And ʿAlī, may God be pleased with him, said to a man whom fear had driven to despair because of the multitude of his sins: \"O this man, your despair of God's mercy is greater than your sins.\"", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 1031", "section_title_en": "On the Excellence of Good Opinion of God and the Virtue of Hope (Section 1031)", "section_index": 1031, "anchors": "- Root: ظن (Ẓann)\n  * Lisan / Ayn: Core meaning oscillates between certainty and doubt; in theological usage, predominates as \"belief/opinion\" regarding God's attributes and acts.\n  * Al-Raghib (Mufradat): Al-ẓann denotes a preponderant belief (iʿtiqād rājiḥ) that admits of contrary possibility; when coupled with God (ḥusn al-ẓann billāh), it signifies the servant's confident trust in divine mercy and forgiveness, not mere conjecture.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — doubt mixed with certainty; Metaphorical (majāz) — in the ḥadīth \"I am as My servant thinks of Me,\" it is transferred to the heart's settled reliance on God's beneficence, for God's actual response is entailed by His own decree, not by the servant's thought.\n- Root: رجو (Rajā')\n  * Lisan / Ayn: Expectation of something desirable with attendant effort; opposite of yaʾs (despair).\n  * Al-Raghib (Mufradat): Rajā' is the heart's aspiration toward a good whose attainment is possible; it is praiseworthy only when accompanied by fear (khawf) and action, for pure hope without works is delusion (ghurūr).\n  * Al-Zamakhshari (Asas): Literal — awaiting rain (rajāʾ al-ghayth); Metaphorical — the soul's yearning for divine pardon, as in the verse {يَرْجُونَ تِجَارَةً لَنْ تَبُورَ} (they hope for a commerce that will never perish).\n- Root: قنط (Qanaṭa)\n  * Lisan / Ayn: Despair of good; severance of hope.\n  * Al-Raghib (Mufradat): Qunūṭ is the cessation of expectation of divine mercy, which is blameworthy and tantamount to disbelief in God's power to forgive.\n  * Al-Zamakhshari (Asas): Literal — drought-stricken land yielding no vegetation; Metaphorical — the soul barren of hope, as in {وَكُنْتُمْ قَوْمًا بُورًا} (you were a ruined people).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The ḥadīth \"أنا عند ظن عبدي بي\" employs the prepositional phrase \"بي\" as a complement to \"ظن,\" governing the servant's cognitive stance toward God; the interposition of \"عبدي\" between the noun and its complement emphasizes the possessive intimacy of the servant's relation to his Lord.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Ihya Ulum al-Din'", "badge": "Du'a"}], "13": [{"arabic": "القبائل من لم يؤمن بالله واليوم الآخر وكانوا عند الله شرا من الكلاب وأخس من الخنازير ولذلك قال تعالى {يا أيها الناس إنا خلقناكم من ذكر وأنثى} أي لا تفاوت في أنسابكم لاجتماعكم في أصل واحد ثم ذكر فائدة النسب فقال {وجعلناكم شعوبا وقبائل لتعارفوا} ثم بين أن الشرف بالتقوى لا بالنسب فقال {إن أكرمكم عند الله أتقاكم} ولما قيل لرسول الله صلى الله عليه وسلم من أكرم الناس من أكيس الناس لم يقل من ينتمي إلى نسبي ولكن قال أكرمهم أكثرهم للموت", "english": "The fourth: pride in noble lineage, like the pride of the Hashimite, to the point that some of them imagine that they will be saved by the nobility of their lineage and the salvation of their forefathers, and that they are forgiven; and some of them fancy that all of creation are their clients and slaves. Its remedy is that he should know that whenever he contradicts his forefathers in their deeds and their moral traits, yet imagines himself to be joined with them, he has indeed been ignorant. And if he emulates his forefathers, then their moral traits were not pride, but rather fear, self-contempt, magnifying others, and self-blame. For they were ennobled by obedience, knowledge, and praiseworthy qualities — not by lineage. So let him seek honor through that by which they were honored. For those who shared their lineage and participated with them in their tribes, yet did not believe in God and the Last Day, were in God's sight worse than dogs and viler than swine. For this reason God (Exalted is He) said: {«يا أيها الناس إنا خلقناكم من ذكر وأنثى»} — \"O mankind, indeed We have created you from a male and a female\" — that is, there is no disparity in your lineages because you all share a single origin. Then He mentioned the benefit of lineage, saying: {«وجعلناكم شعوبا وقبائل لتعارفوا»} — \"And We made you peoples and tribes that you may know one another.\" Then He clarified that honor is by piety, not by lineage, saying: {«إن أكرمكم عند الله أتقاكم»} — \"Indeed, the most noble of you in the sight of God is the most righteous of you.\" And when it was said to the Messenger of God (peace and blessings be upon him), \"Who is the most noble of people?\" — he did not say, \"Whoever traces himself to my lineage,\" but rather he said, \"The most noble of them is the one most mindful of death and the most prepared for it.\" (1) A hadith: \"Indeed, God has removed from you the pride of the Age of Ignorance\" — this hadith was transmitted by Abu Dawud and al-Tirmidhi, who deemed it sound (ḥasan), from the narration of Abu Hurayrah; al-Tirmidhi also narrated it from the narration of Ibn ʿUmar and said it is gharīb (uncommon).", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 881", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 881: On the Wonders of Pride in Strength, Intellect, and Lineage, and Their Remedies", "section_index": 881, "anchors": "- Root: عقل (ʿaql)\n  * Lisan / Ayn: The faculty of restraint and comprehension; the intellect as that which binds one from error.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — the power prepared for receiving knowledge, and the knowledge acquired thereby.\n  * Al-Zamakhshari (Asas): Literal: sound judgment after folly; Metaphorical: \"نخلة لا تعقل الإبار\" — a palm that does not accept pollination, i.e., lacks receptivity.\n- Root: نسب (nasab)\n  * Lisan / Ayn: Lineage and kinship through forebears.\n  * Al-Raghib (Mufradat): \"النسب والنسبة: اشتراك من جهة أحد الأبوين\" — participation through one of the two parents; two types: vertical (through ancestors) and horizontal (through collaterals).\n  * Al-Zamakhshari (Asas): Literal: \"فلان حسيب نسيب\" — noble in deed and lineage; Metaphorical: \"بين الشيئين مناسبة\" — proportionality or correspondence between things.\n- Root: حدث (ḥadath)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — a thing's coming to be after it was not; \"المحدث: ما أوجد بعد أن لم يكن\" — the originated.\n  * Al-Zamakhshari (Asas): Literal: recent events; Metaphorical: \"كان عمر رضي الله عنه محدثا\" — one inspired with true discernment.\n- Root: نفس (nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which animates.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the spirit; also the very essence (dhāt) when attributed to God.\n  * Al-Zamakhshari (Asas): Literal: preciousness; Metaphorical: \"دفق نفسه\" — poured out his blood, i.e., his life.\n- Sibawayh Rule: Rule of Interposition (الفصل بين الجار والمجرور) — governing the permissible separation between a governing word and its governed prepositional phrase, applied here to parse the conditional and relative clauses conveying causal relations between pride and its consequences.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}], "17": [{"arabic": "وخطب رجل عند رسول الله صلى الله عليه وسلم فقال من يطع الله ورسوله فقد رشد ومن يعصهما فقد غوى فقال قل ومن يعص الله ورسوله فقد غوى (2) فكره رسول الله صلى الله عليه وسلم قوله ومن يعصهما لأنه تسوية وجمع وكان إبراهيم يكره أن يقول الرجل أعوذ بالله وبك ويجوز أن يقول أعوذ بالله ثم بك وأن يقول لولا الله ثم فلان ولا يقول لولا الله وفلان وكره بعضهم أن يقال اللهم أعتقنا من النار وكان يقول العتق يكون بعد الورود وكانوا يستجيرون من النار ويتعوذون من النار وقال رجل اللهم", "english": "And a man delivered an address before the Messenger of Allah, peace be upon him, and said: \"Whoever obeys Allah and His Messenger has been rightly guided, and whoever disobeys them both has gone astray.\" He said: \"Say: 'And whoever disobeys Allah and His Messenger has gone astray.'\" (2) The Messenger of Allah, peace be upon him, disliked his saying \"disobeys them both,\" because it was an equalization and a joining [of the two in a single pronoun].", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 698", "section_title_en": "The Revival of the Religious Sciences — Section 698: The Nineteenth Affliction — Heedlessness Regarding Subtle Errors in the Import of Speech", "section_index": 698, "anchors": "- Root: غفل (ghafla)\n  * Lisan / Ayn: Core meaning of heedlessness, neglect, and inattention; the absence of vigilance over a matter.\n  * Al-Raghib (Mufradat): Heedlessness (al-ghafla) is the soul's failure to attend to what it is obligated to know or consider; it is the opposite of mindfulness (al-tayaqquẓ) and remembrance (al-dhikr).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the absence of guarding; metaphorical (majāz) usage extends to the tongue's straying from precise expression in sacred matters.\n- Root: عطف (ʿaṭf)\n  * Lisan / Ayn: Inclination, turning, or joining one thing to another; grammatically, the conjunction that links two items in a shared ruling.\n  * Al-Raghib (Mufradat): Joining (al-ʿaṭf) implies equal treatment of the conjoined items; in theological speech, absolute conjunction (al-ʿaṭf al-muṭlaq) with Allah entails an inadmissible association.\n  * Al-Zamakhshari (Asas): Literal: the bending of a staff or the inclining of a branch; metaphorical: the grammatical coupling that levels two referents under one predicate.\n- Root: شرك (shirk)\n  * Lisan / Ayn: Sharing, partnership, or association; the root of polytheism (al-shirk) as the ascription of a partner to Allah.\n  * Al-Raghib (Mufradat): Association (al-shirk) is the equalization of two things in a shared ruling; in theology, it is the gravest form when applied to the Divine, whether in belief or in the mere wording of speech.\n  * Al-Zamakhshari (Asas): Literal: co-participation in ownership; metaphorical: any verbal or creedal equalization of the creature with the Creator.\n- Sibawayh Rule: Rule of Conjunction (al-ʿaṭf) and Restriction (al-ḥaṣr) — The particle \"thumma\" (then) indicates sequential ordering and distinction of rank, whereas \"wa\" (and) denotes absolute conjunction and mutual equivalence; thus the Prophet's command to replace \"wa\" with \"thumma\" in \"what Allah willed and you willed\" is a syntactic correction to abolish the implication of equal partnership.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Ihya Ulum al-Din'", "badge": "Du'a"}], "23": [{"arabic": "سنة الله تعالى في خلقه ولن تجد لسنة الله تبديلا فلا يخلق الله حركة اليد بكتابة منظومة ما لم يخلق فيها صفة تسمى قدرة وما لم يخلق فيها حياة وما لم يخلق إرادة مجزومة ولا يخلق الإرادة المجزومة ما لم يخلق شهوة وميلا في النفس ولا ينبعث هذا الميل انبعاثا تاما ما لم يخلق علما بأنه موافق للنفس إما في الحال أو في المآل ولا يخلق العلم أيضا إلا بأسباب أخر ترجع إلى حركة وإرادة وعلم فالعلم والميل الطبيعي أبدا يستتبع الإرادة الجازمة والقدرة والإرادة أبدا تست", "english": "If you say: \"The heart's pain is a necessary thing that does not fall under choice — how then is it described as obligatory?\" — Know that its cause is the realization of knowledge of the loss of the Beloved, and one has a way to procure its cause. And by this very meaning, knowledge falls under obligation — not in the sense that the servant creates knowledge and brings it about in himself, for that is impossible. Rather, knowledge, remorse, action, will, power, and the powerful agent — all are from God's creation and His act. {«وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَ»} \"And God created you and what you do.\" This is the truth with those of insight, and anything other than this is error.", "book_title": "Repentance (Kitab al-Tawbah)", "section_title_ar": "Section 917", "section_title_en": "The Obligation of Repentance: Its Reality, Its Proofs, and the Reconciliation of Divine Decree with Human Agency", "section_index": 917, "anchors": "- Root: توب (T-W-B)\n  * Lisan / Ayn: Core meaning is \"return\" (rujūʿ) — the act of turning back from a path one was on.\n  * Al-Raghib (Mufradat): In theological usage, it signifies returning from sin (dhamb) to obedience, and from distance (buʿd) from God to proximity (qurb) to Him. It is the servant's reversion to his original, sound nature.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is \"returning\"; metaphorical (majāz) extension applies it to the heart's turning away from the pursuit of worldly desires (shahawāt) toward the remembrance of God.\n- Root: وجب (W-J-B)\n  * Lisan / Ayn: Core meaning is \"to be established, fixed, or necessary\" — something whose non-existence entails a contradiction or harm.\n  * Al-Raghib (Mufradat): The obligatory (wājib) is that which, if neglected, incurs blame; it is divided into what is obligatory by reason (ʿaql) and what is obligatory by revelation (sharʿ).\n  * Al-Zamakhshari (Asas): Literal sense: \"to be due\" or \"to fall\" (as in a price being fixed); metaphorical sense: the soul's \"falling\" into action out of necessity.\n- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: Core meaning is \"measuring\" or \"estimating\" (taqdīr) — bringing something into existence according to a precise measure.\n  * Al-Raghib (Mufradat): Used for creation from nothing (ibdāʿ) and for bringing something forth from another thing; all of God's acts are measured by His eternal decree.\n  * Al-Zamakhshari (Asas): Literal: the artisan's measuring of leather before cutting; Metaphorical: God's origination of creation upon a measure necessitated by wisdom.\n- Root: كسب (K-S-B)\n  * Lisan / Ayn: Core meaning is \"to acquire\" or \"to earn\" — an act that returns a benefit or harm to the agent.\n  * Al-Raghib (Mufradat): In Kalam, acquisition (kasb) denotes the creature's relation to an act that is entirely God's creation, yet is attributed to the servant by way of his being the locus of its occurrence.\n  * Al-Zamakhshari (Asas): Literal: to gather wealth; Metaphorical: the soul's \"gathering\" of deeds that cling to it as its own.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — used to delimit the meaning of \"obligation\" to its true referent (the means to eternal felicity), and to restrict the attribution of acts to God alone as their sole Creator.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Repentance (Kitab al-Tawbah)'", "badge": "Insight"}], "26": [{"arabic": "قال الله تعالى {إذ جعل الذين كفروا في قلوبهم الحمية حمية الجاهلية فأنزل الله سكينته على رسوله وعلى}", "english": "Know that the obligation in expelling envy is that the servant does not act upon his envy — that he does not harm the one he envies in word or deed, and that he does not rejoice in his misfortune or grieve at his blessing. And this is the obligatory extent — for the heart is not blamed for what it does not choose, but it is blamed for what it chooses and acts upon. And the Prophet — peace be upon him — said: \"God has pardoned my community for what their souls whisper to them, as long as they do not speak or act upon it.\"", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 700", "section_title_en": "The Book of Condemnation of Anger, Spite, and Envy — Book Five of the Quarter of Destroyers from The Revival of the Religious Sciences", "section_index": 700, "anchors": "- Root: غضب (ghadab)\n  * Lisan / Ayn: Core root meaning of anger, rage, fury; the boiling and agitation of the blood\n  * Al-Raghib (Mufradat): Theological nuance — when attributed to God, it means retribution (intiqām) alone, not emotional agitation; the Prophet described it as \"a live coal kindled in the heart of the son of Adam\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal anger is the boiling of the blood in living beings; metaphorical usage extends to inanimate things like fire and the reins of a mount\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning, overturning, and transformation of a thing from one state to another\n  * Al-Raghib (Mufradat): Theological nuance — the heart is so named for its constant turning (taqallub) and fluctuation between states; it is the seat of understanding and the locus of divine address\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is the physical organ; metaphorical is the subtle spiritual reality (laṭīfah rabbāniyyah) that is the locus of knowledge and will\n- Root: حسد (hasad)\n  * Lisan / Ayn: Envy; the wishing for removal of another's blessing\n  * Al-Raghib (Mufradat): Theological nuance — envy is the desire for the removal of a blessing from one who deserves it, sometimes accompanied by striving to remove it; the believer envies (ghibṭah) while the hypocrite envies (hasad)\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — \"Envy consumes the body as fire consumes wood\"; the envier is one who wishes evil upon the blessed\n- Root: هلك (halak)\n  * Lisan / Ayn: Perdition, destruction, ruin; death\n  * Al-Raghib (Mufradat): Theological nuance — three senses: (1) loss of a thing from one's possession while it exists elsewhere, (2) corruption and dissolution of a thing, (3) death; the Quran uses it for all three\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal is physical destruction; metaphorical is the ruin of one's religion and afterlife through spiritual corruption\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening material constitutes a complete, meaningful unit, as in the Quranic pattern of extended periodic sentences that delay resolution for rhetorical effect.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Ihya Ulum al-Din'", "badge": "Insight"}], "27": [{"arabic": "صلى الله عليه وسلم في النوم حتى نزل قوله تعالى لقد صدق الله ورسوله الرؤيا بالحق (4) وقلما يخلوا الإنسان عن منامات دلت على أمور فوجدها صحيحة", "english": "What is possible for the likes of us is another witnessing—a weak one—yet it too is a prophetic witnessing. I mean by it the witnessing in sleep (al-mushāhadah fī al-manām), which is among the lights of prophethood. The Messenger of God—may God's peace and blessings be upon him—said: \"The righteous vision is a part of forty-six parts of prophethood\" (Agreed upon). It too is an unveiling that occurs only by the peeling away of the covering from the heart. Therefore, trust is placed only in the vision of the righteous, truthful man. And whoever's falsehood abounds, his vision is not credited; and whoever's corruption and disobedience abound, his heart is darkened, so that what he sees is but \"confused dreams\" (aḍghāth aḥlām). For this reason, the Messenger of God—may God's peace and blessings be upon him—commanded purification at the time of sleep, so that one sleeps in a state of purity—and this is also an indication of the purification of the inward; for that is the root, and the purification of the outward is in the position of the completion and perfection of it. And whenever the inward becomes clear, there is disclosed in the pupil of the heart what will be in the future, just as the entry into Mecca was disclosed to the Messenger of God—may God's peace and blessings be upon him—in sleep, until the saying of God—exalted is He—descended: {«لقد صدق الله ورسوله الرؤيا بالحق»} [\"Indeed God has fulfilled for His Messenger the vision in truth\"] (Al-Fatḥ 48:27). And rarely is a person devoid of dreams that indicated matters which he then found to be true.", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 1327", "section_title_en": "The Unveiling of the Veil: On the Vision of the Dead and the Reality of Dreams", "section_index": 1327, "anchors": "- Root: بصر (B-Ṣ-R)\n  * Lisan / Ayn: Inner perception and discernment; the eye as an organ of sight versus the \"insight\" (baṣīrah) as the heart's eye.\n  * Al-Raghib (Mufradat): Baṣīrah is the perception of the heart, a spiritual sight (ru'yah qalbiyyah) that penetrates to realities, distinct from mere ocular vision.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sight is of the physical eye; metaphorical (majāz) sight is the heart's illumination by which hidden truths are disclosed.\n- Root: كشف (K-Sh-F)\n  * Lisan / Ayn: Removal of a covering; disclosure of what is concealed.\n  * Al-Raghib (Mufradat): Kashf in the theological sense is the lifting of the veil (ghishāwah) from the heart so that the unseen realm (malakūt) becomes manifest.\n  * Al-Zamakhshari (Asas): Literal: uncovering a physical object; metaphorical: revelation of meanings and hidden affairs to the inner eye.\n- Root: لوح (L-W-Ḥ)\n  * Lisan / Ayn: A tablet or board upon which writing appears; also the flat bones of the body.\n  * Al-Raghib (Mufradat): The Preserved Tablet (al-Lawḥ al-Maḥfūẓ) is that upon which all destinies are inscribed; its modality is unknown to us save by report.\n  * Al-Zamakhshari (Asas): Literal: a wooden plank; metaphorical: the divine register of all that was and will be, not corporeal but a subtle reality.\n- Root: مثل (M-Th-L)\n  * Lisan / Ayn: Likeness, similitude, example; to stand in representation of another.\n  * Al-Raghib (Mufradat): Mathal is the analogical representation by which an absent or abstract reality is brought near to understanding through a present likeness.\n  * Al-Zamakhshari (Asas): Literal: a resembling image; metaphorical: the parabolic example (mithāl) used to approximate what transcends sensory grasp.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle \"innamā\" confines the predicate to the subject alone, as in \"إنما يتقبل الله من المتقين,\" restricting divine acceptance exclusively to the God-fearing, a syntactic anchor for the theological point that outward piety without inward taqwā avails nothing.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}, {"arabic": "الاحتمال في كتاب الحلال والحرام إن شاء الله تعالى", "english": "And the closest to moderation is the sufficiency of a year. What is beyond it contains peril, and what is below it contains restriction. And these matters, when there is no definitive determination by scriptural text (tawqif), the one exercising judgment (mujtahid) has no recourse but to rule by what occurs to him. Then it is said to the pious one: \"Consult your heart, even if they give you rulings — even if they give you rulings\" {«استفت قلبك وإن أفتوك وأفتوك»}, as he, peace and blessings be upon him, said — for sin is the pricking of the hearts. So if the recipient finds in himself something regarding what he takes, let him fear God in it and not take liberties, seeking pretexts in the fatwas of the outward scholars — for their fatwas have restrictions and absolutes conditioned by necessities, and in them are conjectures and plunging into ambiguities.", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 179", "section_title_en": "The Etiquette of the Recipient of Wealth: On the Virtue of Poverty and the Conduct of Taking from Others", "section_index": 179, "anchors": "- Root: كرم (karuma)\n  * Lisan / Ayn: Core root meaning: nobility, generosity, honorableness of origin and character.\n  * Al-Raghib (Mufradat): Theological nuance: Divine Generosity (al-Karam) as an attribute of God entailing beneficence (al-Ifḍāl) that is pure grace, not obligation.\n  * Al-Zamakhshari (Asas): Literal: nobility of lineage/character. Metaphorical: God's abundant giving without recompense.\n- Root: فضل (faḍala)\n  * Lisan / Ayn: Core root meaning: surplus, excess, superiority, that which remains beyond need.\n  * Al-Raghib (Mufradat): Theological nuance: God's Bounty (al-Faḍl) as gratuitous favor exceeding what is merited; distinct from justice ('Adl).\n  * Al-Zamakhshari (Asas): Literal: excess/surplus. Metaphorical: divine favor and grace.\n- Root: نعم (ni'ma)\n  * Lisan / Ayn: Core root meaning: well-being, bounty, benefaction; state of goodness.\n  * Al-Raghib (Mufradat): Theological nuance: al-Ni'ma as the good state (al-ḥālah al-ḥasanah) bestowed by God; its genus encompasses both little and much.\n  * Al-Zamakhshari (Asas): Literal: pleasant life and bounty. Metaphorical: \"خفت نعامتهم\" (their ostriches departed) — i.e., they went away, indicating the fleeting nature of worldly boons.\n- Root: قدر (qadara)\n  * Lisan / Ayn: Core root meaning: measure, extent, power, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-Qudrah for God is the negation of incapacity; for man, a capacity for specific acts. Al-Qadr: the divine measure/decree.\n  * Al-Zamakhshari (Asas): Literal: measure, amount, power. Metaphorical: \"فرس بعيد القدر\" (a horse of far-reaching stride) — extended reach.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the precise restriction of agency and causation in statements like \"إنما المنكر أن يرى الواسطة أصلا\" (The only objectionable thing is to regard the intermediary as the origin).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Ihya Ulum al-Din'", "badge": "Insight"}, {"arabic": "الاستقبال كقوله تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رؤوسكم ومقصرين وكقوله ألم غلبت الروم في أدنى الأرض وهم من بعد غلبهم سيغلبون في بضع سنين ووجه دلالة المعجزة على صدق الرسل أن كل ما عجز عنه البشر لم يكن إلا فعلا لله تعالى فمهما كان مقرونا بتحدي النبي صلى الله عليه وسلم ينزل منزلة قوله صدقت وذلك مثل القائل بين يدي 2 الملك المدعي على رعيته أنه رسول الملك إليهم فإنه مهما قال لذلك إن كنت صادقا فقم على سريرك ثلاثا واقعد على خلاف عادتك ففعل الملك ذلك حصل للحاضرين علم ضرو", "english": "And the manner in which the miracle indicates the truthfulness of the messengers is that everything which human beings are incapable of accomplishing is none other than an act of God, Exalted is He. Thus, whenever it is conjoined with the challenge (taḥaddī) of the Prophet ﷺ, it assumes the station of his saying, \"I have spoken truthfully.\" This is like the example of a man standing before a king, claiming to the king's subjects that he is the king's messenger to them. For whenever he says to them, \"If you are truthful, then rise upon your throne three times and sit in a manner contrary to your custom\" — and the king does that — there occurs for those present a necessary knowledge (ʿilm ḍarūrī) that this [act] assumes the station of his saying, \"I have spoken truthfully.\"", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 96", "section_title_en": "The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles", "section_index": 96, "anchors": "- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}], "29": [{"arabic": "واقترب وقال عز وجل سيماهم في وجوههم من أثر السجود فقيل هو ما يلتصق بوجوههم من الأرض عند السجود وقيل هو نور الخشوع فإنه يشرق من الباطن على الظاهر وهو الأصح وقيل هي الغرر التي تكون في وجوههم يوم القيامة من أثر الوضوء وقال صلى الله عليه وسلم إذا قرأ ابن آدم السجدة فسجد اعتزل الشيطان يبكي ويقول يا ويلاه أمر هذا بالسجود فسجد فله الجنة وأمرت أنا بالسجود فعصيت فلي النار (6) ويروى عن علي بن عبد الله بن عباس أنه كان يسجد في كل يوم ألف سجدة وكا", "english": "The Messenger of God — peace be upon him — said: \"The servant draws near to God through nothing better than a hidden prostration.\" (2) And the Messenger of God — peace be upon him — said: \"No Muslim prostrates to God with a single prostration, except that God raises him by it a degree and removes from him by it a sin.\" (3) And it is related that a man said to the Messenger of God — peace be upon him: \"Supplicate God to make me among the people of your intercession and to grant me your companionship in Paradise.\" He — peace be upon him — said: \"Help me by multiplying prostration.\" (4) And it was said: \"The closest that the servant is to God — Mighty and Majestic — is when he is prostrating.\" (5) And this is the meaning of His saying — Glorified and Exalted: {«واسجد واقترب»} (\"Prostrate and draw near\") (Q. 96:19). And He — Glorified and Exalted — said: {«سيماهم في وجوههم من أثر السجود»} (\"Their mark is on their faces from the trace of prostration\") (Q. 48:29). It was said: \"It is the dust that clings to their faces during prostration.\" And it was said: \"It is the light of reverence (nūr al-khushūʿ), for it radiates from the inward to the outward\" — and this is the most sound opinion. And it was said: \"It is the radiant whiteness (al-ghurrah) that will be on their faces on the Day of Resurrection from the trace of ablution.\" And he — peace be upon him — said: \"When the son of Adam recites the verse of prostration and then prostrates, Satan withdraws, weeping and saying: 'Woe to me! This one was commanded to prostrate, and he prostrated, so Paradise is his. And I was commanded to prostrate, but I disobeyed, so the Fire is mine.'\" (6)", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 123", "section_title_en": "The Virtue of Prostration (Faḍīlat al-Sujūd)", "section_index": 123, "anchors": "- Root: سجد (S-J-D)\n  * Lisan / Ayn: Core root denotes bowing, lowering oneself, and touching the ground in humility.\n  * Al-Raghib (Mufradat): Prostration (sujūd) is of two types: voluntary (ikhtiyārī), exclusive to humans and meriting reward, and compelled (taskhīrī), shared by all creation. The Prophet's statement \"a hidden prostration\" (sujūd khafī) points to the voluntary type performed in secret, maximizing sincerity and divine proximity.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is the physical act of placing the forehead on the ground in worship. Metaphorical (majāz) usage extends to any act of humble submission, such as a tree leaning or a ship yielding to the wind. Here, the term is literal, but its virtue is tied to the spiritual state of khushūʿ (reverent humility).\n- Root: عبد (ʿ-B-D)\n  * Lisan / Ayn: Root denotes servitude, obedience, and worship.\n  * Al-Raghib (Mufradat): ʿIbādah is the utmost degree of self-abasement (tadhallul), rendered exclusively to God due to His ultimate beneficence. The ḥadīth \"the servant draws near to God\" (yataqarrab al-ʿabd) frames prostration as the servant's act of voluntary worship (ʿibādah ikhtiyāriyyah), distinct from compelled submission.\n  * Al-Zamakhshari (Asas): Literal usage is the state of being a slave (ʿabd). Metaphorically, it implies total devotion and self-surrender, as in \"he enslaved me\" (taʿabbadanī). In this context, the servant (al-ʿabd) is the believing human who freely chooses worship.\n- Root: قرب (Q-R-B)\n  * Lisan / Ayn: Root denotes proximity, nearness, and approach.\n  * Al-Raghib (Mufradat): Proximity (qurb) applies to place, time, relation, and — crucially here — to divine favor and honor (al-ḥaẓwah wa al-riʿāyah). The verse {«واسجد واقترب»} (\"Prostrate and draw near\") (Q. 96:19) indicates that prostration is the means to spiritual nearness to God, not physical closeness.\n  * Al-Zamakhshari (Asas): Literal usage is spatial nearness. Metaphorical usage is drawing near in rank or favor, as in \"he approached a matter\" (qarraba amran). Here, the servant's proximity to God is metaphorical — a station of honor and divine acceptance achieved through the act of prostration.\n- Root: وجل (W-J-L)\n  * Lisan / Ayn: Root denotes fear, trembling, and apprehension.\n  * Al-Raghib (Mufradat): Wajal is the inward sensation of fear, as in {«الذين إذا ذكر الله وجلت قلوبهم»} (\"those whose hearts tremble when God is mentioned\") (Q. 8:2). The \"light of khushūʿ\" (nūr al-khushūʿ) mentioned in the exegesis of the prostration mark is an outward manifestation of this inward awe.\n  * Al-Zamakhshari (Asas): Literal usage is the feeling of fear. Metaphorically, it can denote a profound reverence that transforms the believer's demeanor. The \"mark on the face\" (sīmā) is interpreted as this radiant awe shining from within.\n- Sibawayh Rule: Prepositional Interposition (al-faṣl bayna al-jār wa al-majrūr) — The construction \"أقرب ما يكون العبد من الله تعالى أن يكون ساجدا\" (the closest the servant is to God is when he is prostrating) employs a nominal sentence with an implied temporal clause, where the predicate (an yakūna sājidan) is delayed for rhetorical emphasis, highlighting the state of prostration as the pinnacle of proximity.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Ihya Ulum al-Din'", "badge": "Hadith"}, {"arabic": "الدين وأصفاها في اليقين وأرقها على الإخوان وهو إشارة إلى قوله تعالى أشداء على الكفار رحماء بينهم وقوله تعالى مثل نوره كمشكاة فيها مصباح قال أبي بن كعب رضي الله عنه معناه مثل نور المؤمن وقلبه وقوله تعالى أو كظلمات في بحر لجى مثل قلب المنافق وقال زيد بن أسلم في قوله تعالى في لوح محفوظ وهو قلب المؤمن وقال سهل مثل القلب والصدر مثل العرش والكرسي فهذه أمثلة القلب", "english": "And Zayd ibn Aslam said concerning His saying, Exalted: \"In a preserved tablet\" {فِي لَوْحٍ مَحْفُوظٍ} — it is the heart of the believer.", "book_title": "Ihya Ulum al-Din", "section_title_ar": "Section 579", "section_title_en": "The Revival of the Religious Sciences — Section 579: The Human's Distinguishing Property is Knowledge and Wisdom; The Heart as the Seat of the King", "section_index": 579, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning over, revolving, and transformation from one state to another; the heart as that which is constantly turning and fluctuating.\n  * Al-Raghib (Mufradat): The heart (qalb) is so named for its constant turning (taqallub) between states; it is the seat of perception and understanding, the faculty by which one grasps realities.\n  * Al-Zamakhshari (Asas): Literal: turning a thing over. Metaphorical: the heart as the seat of understanding and the center of the human kingdom, that which governs and directs the faculties.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge, perception, and certainty; the mark or trace by which a thing is known.\n  * Al-Raghib (Mufradat): Knowledge is the apprehension of a thing as it truly is; it is the distinguishing property of the human being and the purpose of his creation.\n  * Al-Zamakhshari (Asas): Literal: knowing. Metaphorical: the light by which the heart perceives realities, the noblest of which is knowledge of God.\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Possession, sovereignty, and dominion; a king who rules over a domain.\n  * Al-Raghib (Mufradat): The king is one who possesses authority and commands; the heart is the king of the human body, ruling over its faculties.\n  * Al-Zamakhshari (Asas): Literal: a king. Metaphorical: the heart as the sovereign of the human kingdom, with the faculties as its subjects, messengers, and servants.\n- Sibawayh Rule: باب التشبيه والتمثيل (The Chapter of Simile and Analogy) — The use of extended analogies (tamthīl) to clarify abstract realities through concrete images, where the comparison is drawn between the relations of parts, not merely individual attributes.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Ihya Ulum al-Din'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 460, 1606], [2, 1606, 2884], [3, 2884, 3260], [4, 3260, 4350], [5, 4350, 6470]], "48:1": [[1, 460, 1606], [2, 1606, 2884], [3, 2884, 3260], [4, 3260, 4350], [5, 4350, 6470]], "2": [[1, 750, 2094], [2, 2094, 2462], [3, 2462, 3198], [4, 3198, 3879], [5, 3879, 4790], [6, 4790, 5158], [7, 5158, 5913], [8, 5913, 7036], [9, 7036, 7996], [10, 7996, 9469], [11, 9469, 10417], [12, 10417, 11310], [13, 11310, 13170], [14, 13170, 14459], [15, 14459, 16960]], "48:2": [[1, 750, 2094], [2, 2094, 2462], [3, 2462, 3198], [4, 3198, 3879], [5, 3879, 4790], [6, 4790, 5158], [7, 5158, 5913], [8, 5913, 7036], [9, 7036, 7996], [10, 7996, 9469], [11, 9469, 10417], [12, 10417, 11310], [13, 11310, 13170], [14, 13170, 14459], [15, 14459, 16960]], "3": [[1, 1110, 2647], [2, 2647, 3326], [3, 3326, 4336], [4, 4336, 6090]], "48:3": [[1, 1110, 2647], [2, 2647, 3326], [3, 3326, 4336], [4, 4336, 6090]], "4": [[1, 670, 1267], [2, 1267, 3148], [3, 3148, 3908], [4, 3908, 5441], [5, 5441, 5911], [6, 5911, 6924], [7, 6924, 8561], [8, 8561, 11998], [9, 11998, 13644], [10, 13644, 14268], [11, 14268, 15769], [12, 15769, 16863], [13, 16863, 17840], [14, 17840, 19460], [15, 19460, 20762], [16, 20762, 22046], [17, 22046, 22769], [18, 22769, 24279], [19, 24279, 26120]], "48:4": [[1, 670, 1267], [2, 1267, 3148], [3, 3148, 3908], [4, 3908, 5441], [5, 5441, 5911], [6, 5911, 6924], [7, 6924, 8561], [8, 8561, 11998], [9, 11998, 13644], [10, 13644, 14268], [11, 14268, 15769], [12, 15769, 16863], [13, 16863, 17840], [14, 17840, 19460], [15, 19460, 20762], [16, 20762, 22046], [17, 22046, 22769], [18, 22769, 24279], [19, 24279, 26120]], "5": [[1, 490, 1960], [2, 1960, 3711], [3, 3711, 5617], [4, 5617, 6770], [5, 6770, 7718], [6, 7718, 8105], [7, 8105, 9401], [8, 9401, 10595], [9, 10595, 12040], [10, 12040, 13394], [11, 13394, 15048], [12, 15048, 15851], [13, 15851, 17998], [14, 17998, 19372], [15, 19372, 20142], [16, 20142, 20771], [17, 20771, 21545], [18, 21545, 22764