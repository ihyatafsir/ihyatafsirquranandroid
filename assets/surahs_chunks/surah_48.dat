{"surah":48,"verses":[{"ayah":1,"text":"إِنَّا فَتَحْنَا لَكَ فَتْحًا مُّبِينًا ","translation":"Indeed, We have given you, [O Muḥammad], a clear conquest[1]","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"فَتَحْنَا","translit":"āَnْḥَtَf","root":"فتح"},{"id":3,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":4,"arabic":"فَتْحًا","translit":"āًḥْtَf","root":"فتح"},{"id":5,"arabic":"مُّبِينًا","translit":"āًnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":2,"text":"لِّيَغْفِرَ لَكَ ٱللَّهُ مَا تَقَدَّمَ مِن ذَنۢبِكَ وَمَا تَأَخَّرَ وَيُتِمَّ نِعْمَتَهُۥ عَلَيْكَ وَيَهْدِيَكَ صِرَٰطًا مُّسْتَقِيمًا ","translation":"That Allāh may forgive for you what preceded of your sin [i.e., errors] and what will follow and complete His favor upon you and guide you to a straight path","words":[{"id":1,"arabic":"لِّيَغْفِرَ","translit":"َrِfْغَyِّl","root":"غفر"},{"id":2,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"تَقَدَّمَ","translit":"َmَّdَqَt","root":"قدم"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"ذَنۢبِكَ","translit":"َkِbۢnَhd","root":"ذنب"},{"id":8,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":9,"arabic":"تَأَخَّرَ","translit":"َrَّhkَaʾَt","root":"اخر"},{"id":10,"arabic":"وَيُتِمَّ","translit":"َّmِtُyَw","root":"تمم"},{"id":11,"arabic":"نِعْمَتَهُۥ","translit":"ۥُhَtَmْʿعِn","root":"نعم"},{"id":12,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":13,"arabic":"وَيَهْدِيَكَ","translit":"َkَyِdْhَyَw","root":"هدي"},{"id":14,"arabic":"صِرَٰطًا","translit":"āًṭَٰrِṣ","root":"صرط"},{"id":15,"arabic":"مُّسْتَقِيمًا","translit":"āًmyِqَtْsُّm","root":"قوم"}],"hasIhya":true},{"ayah":3,"text":"وَيَنصُرَكَ ٱللَّهُ نَصْرًا عَزِيزًا ","translation":"And [that] Allāh may aid you with a mighty victory.","words":[{"id":1,"arabic":"وَيَنصُرَكَ","translit":"َkَrُṣnَyَw","root":"نصر"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"نَصْرًا","translit":"āًrْṣَn","root":"نصر"},{"id":4,"arabic":"عَزِيزًا","translit":"āًzyِzَʿع","root":"عزز"}],"hasIhya":false},{"ayah":4,"text":"هُوَ ٱلَّذِىٓ أَنزَلَ ٱلسَّكِينَةَ فِى قُلُوبِ ٱلْمُؤْمِنِينَ لِيَزْدَادُوٓا۟ إِيمَٰنًا مَّعَ إِيمَٰنِهِمْۗ وَلِلَّهِ جُنُودُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَكَانَ ٱللَّهُ عَلِيمًا حَكِيمًا ","translation":"It is He who sent down tranquility into the hearts of the believers that they would increase in faith along with their [present] faith. And to Allāh belong the soldiers of the heavens and the earth, and ever is Allāh Knowing and Wise.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":3,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":4,"arabic":"ٱلسَّكِينَةَ","translit":"َẗَnyِkَّslٱ","root":"سكن"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"قُلُوبِ","translit":"ِbwُlُq","root":"قلب"},{"id":7,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":8,"arabic":"لِيَزْدَادُوٓا۟","translit":"۟āٓwُdāَdْzَyِl","root":"زيد"},{"id":9,"arabic":"إِيمَٰنًا","translit":"āًnَٰmyِiʾ","root":"امن"},{"id":10,"arabic":"مَّعَ","translit":"َʿعَّm","root":""},{"id":11,"arabic":"إِيمَٰنِهِمْ","translit":"ْmِhِnَٰmyِiʾ","root":"امن"},{"id":12,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":13,"arabic":"جُنُودُ","translit":"ُdwُnُjg","root":"جند"},{"id":14,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":15,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":16,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":17,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":18,"arabic":"عَلِيمًا","translit":"āًmyِlَʿع","root":"علم"},{"id":19,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":true},{"ayah":5,"text":"لِّيُدْخِلَ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَا وَيُكَفِّرَ عَنْهُمْ سَيِّـَٔاتِهِمْۚ وَكَانَ ذَٰلِكَ عِندَ ٱللَّهِ فَوْزًا عَظِيمًا ","translation":"[And] that He may admit the believing men and the believing women to gardens beneath which rivers flow to abide therein eternally and remove from them their misdeeds - and ever is that, in the sight of Allāh, a great attainment –","words":[{"id":1,"arabic":"لِّيُدْخِلَ","translit":"َlِhkْdُyِّl","root":"دخل"},{"id":2,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":3,"arabic":"وَٱلْمُؤْمِنَٰتِ","translit":"ِtَٰnِmْwʾُmْlٱَw","root":"امن"},{"id":4,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":5,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":8,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":9,"arabic":"خَٰلِدِينَ","translit":"َnyِdِlَٰhk","root":"خلد"},{"id":10,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":11,"arabic":"وَيُكَفِّرَ","translit":"َrِّfَkُyَw","root":"كفر"},{"id":12,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":13,"arabic":"سَيِّـَٔاتِهِمْ","translit":"ْmِhِtāَٔـِّyَs","root":"سوا"},{"id":14,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":15,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":16,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"فَوْزًا","translit":"āًzْwَf","root":"فوز"},{"id":19,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":true},{"ayah":6,"text":"وَيُعَذِّبَ ٱلْمُنَٰفِقِينَ وَٱلْمُنَٰفِقَٰتِ وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَٰتِ ٱلظَّآنِّينَ بِٱللَّهِ ظَنَّ ٱلسَّوْءِۚ عَلَيْهِمْ دَآئِرَةُ ٱلسَّوْءِۖ وَغَضِبَ ٱللَّهُ عَلَيْهِمْ وَلَعَنَهُمْ وَأَعَدَّ لَهُمْ جَهَنَّمَۖ وَسَآءَتْ مَصِيرًا ","translation":"And [that] He may punish the hypocrite men and hypocrite women, and the polytheist men and polytheist women - those who assume about Allāh an assumption of evil nature. Upon them is a misfortune of evil nature; and Allāh has become angry with them and has cursed them and prepared for them Hell, and evil it is as a destination.","words":[{"id":1,"arabic":"وَيُعَذِّبَ","translit":"َbِّhdَʿعُyَw","root":"عذب"},{"id":2,"arabic":"ٱلْمُنَٰفِقِينَ","translit":"َnyِqِfَٰnُmْlٱ","root":"نفق"},{"id":3,"arabic":"وَٱلْمُنَٰفِقَٰتِ","translit":"ِtَٰqِfَٰnُmْlٱَw","root":"نفق"},{"id":4,"arabic":"وَٱلْمُشْرِكِينَ","translit":"َnyِkِrْhsُmْlٱَw","root":"شرك"},{"id":5,"arabic":"وَٱلْمُشْرِكَٰتِ","translit":"ِtَٰkِrْhsُmْlٱَw","root":"شرك"},{"id":6,"arabic":"ٱلظَّآنِّينَ","translit":"َnyِّnٓāَّẓlٱ","root":"ظنن"},{"id":7,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":8,"arabic":"ظَنَّ","translit":"َّnَẓ","root":"ظنن"},{"id":9,"arabic":"ٱلسَّوْءِ","translit":"ِءْwَّslٱ","root":"سوا"},{"id":10,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":11,"arabic":"دَآئِرَةُ","translit":"ُẗَrِyʾٓāَd","root":"دور"},{"id":12,"arabic":"ٱلسَّوْءِ","translit":"ِءْwَّslٱ","root":"سوا"},{"id":13,"arabic":"وَغَضِبَ","translit":"َbِḍَغَw","root":"غضب"},{"id":14,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":15,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":16,"arabic":"وَلَعَنَهُمْ","translit":"ْmُhَnَʿعَlَw","root":"لعن"},{"id":17,"arabic":"وَأَعَدَّ","translit":"َّdَʿعَaʾَw","root":"عدد"},{"id":18,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":19,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":20,"arabic":"وَسَآءَتْ","translit":"ْtَءٓāَsَw","root":"سوا"},{"id":21,"arabic":"مَصِيرًا","translit":"āًryِṣَm","root":"صير"}],"hasIhya":false},{"ayah":7,"text":"وَلِلَّهِ جُنُودُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا ","translation":"And to Allāh belong the soldiers of the heavens and the earth. And ever is Allāh Exalted in Might and Wise.","words":[{"id":1,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":2,"arabic":"جُنُودُ","translit":"ُdwُnُjg","root":"جند"},{"id":3,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":4,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":5,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":6,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":7,"arabic":"عَزِيزًا","translit":"āًzyِzَʿع","root":"عزز"},{"id":8,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":8,"text":"إِنَّآ أَرْسَلْنَٰكَ شَٰهِدًا وَمُبَشِّرًا وَنَذِيرًا ","translation":"Indeed, We have sent you as a witness and a bringer of good tidings and a warner","words":[{"id":1,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":2,"arabic":"أَرْسَلْنَٰكَ","translit":"َkَٰnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"شَٰهِدًا","translit":"āًdِhَٰhs","root":"شهد"},{"id":4,"arabic":"وَمُبَشِّرًا","translit":"āًrِّhsَbُmَw","root":"بشر"},{"id":5,"arabic":"وَنَذِيرًا","translit":"āًryِhdَnَw","root":"نذر"}],"hasIhya":false},{"ayah":9,"text":"لِّتُؤْمِنُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَتُعَزِّرُوهُ وَتُوَقِّرُوهُ وَتُسَبِّحُوهُ بُكْرَةً وَأَصِيلًا ","translation":"That you [people] may believe in Allāh and His Messenger and honor him and respect him [i.e., the Prophet (ﷺ)] and exalt Him [i.e., Allāh] morning and afternoon.","words":[{"id":1,"arabic":"لِّتُؤْمِنُوا۟","translit":"۟āwُnِmْwʾُtِّl","root":"امن"},{"id":2,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":3,"arabic":"وَرَسُولِهِۦ","translit":"ۦِhِlwُsَrَw","root":"رسل"},{"id":4,"arabic":"وَتُعَزِّرُوهُ","translit":"ُhwُrِّzَʿعُtَw","root":"عزر"},{"id":5,"arabic":"وَتُوَقِّرُوهُ","translit":"ُhwُrِّqَwُtَw","root":"وقر"},{"id":6,"arabic":"وَتُسَبِّحُوهُ","translit":"ُhwُḥِّbَsُtَw","root":"سبح"},{"id":7,"arabic":"بُكْرَةً","translit":"ًẗَrْkُb","root":"بكر"},{"id":8,"arabic":"وَأَصِيلًا","translit":"āًlyِṣَaʾَw","root":"اصل"}],"hasIhya":false},{"ayah":10,"text":"إِنَّ ٱلَّذِينَ يُبَايِعُونَكَ إِنَّمَا يُبَايِعُونَ ٱللَّهَ يَدُ ٱللَّهِ فَوْقَ أَيْدِيهِمْۚ فَمَن نَّكَثَ فَإِنَّمَا يَنكُثُ عَلَىٰ نَفْسِهِۦۖ وَمَنْ أَوْفَىٰ بِمَا عَٰهَدَ عَلَيْهُ ٱللَّهَ فَسَيُؤْتِيهِ أَجْرًا عَظِيمًا ","translation":"Indeed, those who pledge allegiance to you, [O Muḥammad] - they are actually pledging allegiance to Allāh. The hand[1] of Allāh is over their hands.[2] So he who breaks his word only breaks it to the detriment of himself. And he who fulfills that which he has promised Allāh - He will give him a great reward.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يُبَايِعُونَكَ","translit":"َkَnwُʿعِyāَbُy","root":"بيع"},{"id":4,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":5,"arabic":"يُبَايِعُونَ","translit":"َnwُʿعِyāَbُy","root":"بيع"},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"يَدُ","translit":"ُdَy","root":"يدي"},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"فَوْقَ","translit":"َqْwَf","root":"فوق"},{"id":10,"arabic":"أَيْدِيهِمْ","translit":"ْmِhyِdْyَaʾ","root":"يدي"},{"id":11,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":12,"arabic":"نَّكَثَ","translit":"َhtَkَّn","root":"نكث"},{"id":13,"arabic":"فَإِنَّمَا","translit":"āَmَّnِiʾَf","root":""},{"id":14,"arabic":"يَنكُثُ","translit":"ُhtُknَy","root":"نكث"},{"id":15,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":16,"arabic":"نَفْسِهِۦ","translit":"ۦِhِsْfَn","root":"نفس"},{"id":17,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":18,"arabic":"أَوْفَىٰ","translit":"ٰàَfْwَaʾ","root":"وفي"},{"id":19,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":20,"arabic":"عَٰهَدَ","translit":"َdَhَٰʿع","root":"عهد"},{"id":21,"arabic":"عَلَيْهُ","translit":"ُhْyَlَʿع","root":""},{"id":22,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":23,"arabic":"فَسَيُؤْتِيهِ","translit":"ِhyِtْwʾُyَsَf","root":"اتي"},{"id":24,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":25,"arabic":"عَظِيمًا","translit":"āًmyِẓَʿع","root":"عظم"}],"hasIhya":false},{"ayah":11,"text":"سَيَقُولُ لَكَ ٱلْمُخَلَّفُونَ مِنَ ٱلْأَعْرَابِ شَغَلَتْنَآ أَمْوَٰلُنَا وَأَهْلُونَا فَٱسْتَغْفِرْ لَنَاۚ يَقُولُونَ بِأَلْسِنَتِهِم مَّا لَيْسَ فِى قُلُوبِهِمْۚ قُلْ فَمَن يَمْلِكُ لَكُم مِّنَ ٱللَّهِ شَيْـًٔا إِنْ أَرَادَ بِكُمْ ضَرًّا أَوْ أَرَادَ بِكُمْ نَفْعًۢاۚ بَلْ كَانَ ٱللَّهُ بِمَا تَعْمَلُونَ خَبِيرًۢا ","translation":"Those who remained behind[1] of the bedouins will say to you, \"Our properties and our families occupied us, so ask forgiveness for us.\" They say with their tongues what is not within their hearts. Say, \"Then who could prevent Allāh at all if He intended for you harm or intended for you benefit? Rather, ever is Allāh, of what you do, Aware.","words":[{"id":1,"arabic":"سَيَقُولُ","translit":"ُlwُqَyَs","root":"قول"},{"id":2,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":3,"arabic":"ٱلْمُخَلَّفُونَ","translit":"َnwُfَّlَhkُmْlٱ","root":"خلف"},{"id":4,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":5,"arabic":"ٱلْأَعْرَابِ","translit":"ِbāَrْʿعَaʾْlٱ","root":"عرب"},{"id":6,"arabic":"شَغَلَتْنَآ","translit":"ٓāَnْtَlَغَhs","root":"شغل"},{"id":7,"arabic":"أَمْوَٰلُنَا","translit":"āَnُlَٰwْmَaʾ","root":"مول"},{"id":8,"arabic":"وَأَهْلُونَا","translit":"āَnwُlْhَaʾَw","root":"اهل"},{"id":9,"arabic":"فَٱسْتَغْفِرْ","translit":"ْrِfْغَtْsٱَf","root":"غفر"},{"id":10,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":11,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":12,"arabic":"بِأَلْسِنَتِهِم","translit":"mِhِtَnِsْlَaʾِb","root":"لسن"},{"id":13,"arabic":"مَّا","translit":"āَّm","root":""},{"id":14,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":15,"arabic":"فِى","translit":"àِf","root":""},{"id":16,"arabic":"قُلُوبِهِمْ","translit":"ْmِhِbwُlُq","root":"قلب"},{"id":17,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":18,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":19,"arabic":"يَمْلِكُ","translit":"ُkِlْmَy","root":"ملك"},{"id":20,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":21,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":22,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":23,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":24,"arabic":"إِنْ","translit":"ْnِiʾ","root":""},{"id":25,"arabic":"أَرَادَ","translit":"َdāَrَaʾ","root":"رود"},{"id":26,"arabic":"بِكُمْ","translit":"ْmُkِb","root":""},{"id":27,"arabic":"ضَرًّا","translit":"āًّrَḍ","root":"ضرر"},{"id":28,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":29,"arabic":"أَرَادَ","translit":"َdāَrَaʾ","root":"رود"},{"id":30,"arabic":"بِكُمْ","translit":"ْmُkِb","root":""},{"id":31,"arabic":"نَفْعًۢا","translit":"āًۢʿعْfَn","root":"نفع"},{"id":32,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":33,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":34,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":35,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":36,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":37,"arabic":"خَبِيرًۢا","translit":"āًۢryِbَhk","root":"خبر"}],"hasIhya":false},{"ayah":12,"text":"بَلْ ظَنَنتُمْ أَن لَّن يَنقَلِبَ ٱلرَّسُولُ وَٱلْمُؤْمِنُونَ إِلَىٰٓ أَهْلِيهِمْ أَبَدًا وَزُيِّنَ ذَٰلِكَ فِى قُلُوبِكُمْ وَظَنَنتُمْ ظَنَّ ٱلسَّوْءِ وَكُنتُمْ قَوْمًۢا بُورًا ","translation":"But you thought that the Messenger and the believers would never return to their families, ever, and that was made pleasing in your hearts. And you assumed an assumption of evil and became a people ruined.\"","words":[{"id":1,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":2,"arabic":"ظَنَنتُمْ","translit":"ْmُtnَnَẓ","root":"ظنن"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"لَّن","translit":"nَّl","root":""},{"id":5,"arabic":"يَنقَلِبَ","translit":"َbِlَqnَy","root":"قلب"},{"id":6,"arabic":"ٱلرَّسُولُ","translit":"ُlwُsَّrlٱ","root":"رسل"},{"id":7,"arabic":"وَٱلْمُؤْمِنُونَ","translit":"َnwُnِmْwʾُmْlٱَw","root":"امن"},{"id":8,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":9,"arabic":"أَهْلِيهِمْ","translit":"ْmِhyِlْhَaʾ","root":"اهل"},{"id":10,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"},{"id":11,"arabic":"وَزُيِّنَ","translit":"َnِّyُzَw","root":"زين"},{"id":12,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"قُلُوبِكُمْ","translit":"ْmُkِbwُlُq","root":"قلب"},{"id":15,"arabic":"وَظَنَنتُمْ","translit":"ْmُtnَnَẓَw","root":"ظنن"},{"id":16,"arabic":"ظَنَّ","translit":"َّnَẓ","root":"ظنن"},{"id":17,"arabic":"ٱلسَّوْءِ","translit":"ِءْwَّslٱ","root":"سوا"},{"id":18,"arabic":"وَكُنتُمْ","translit":"ْmُtnُkَw","root":"كون"},{"id":19,"arabic":"قَوْمًۢا","translit":"āًۢmْwَq","root":"قوم"},{"id":20,"arabic":"بُورًا","translit":"āًrwُb","root":"بور"}],"hasIhya":true},{"ayah":13,"text":"وَمَن لَّمْ يُؤْمِنۢ بِٱللَّهِ وَرَسُولِهِۦ فَإِنَّآ أَعْتَدْنَا لِلْكَٰفِرِينَ سَعِيرًا ","translation":"And whoever has not believed in Allāh and His Messenger - then indeed, We have prepared for the disbelievers a Blaze.","words":[{"id":1,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":2,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":3,"arabic":"يُؤْمِنۢ","translit":"ۢnِmْwʾُy","root":"امن"},{"id":4,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":5,"arabic":"وَرَسُولِهِۦ","translit":"ۦِhِlwُsَrَw","root":"رسل"},{"id":6,"arabic":"فَإِنَّآ","translit":"ٓāَّnِiʾَf","root":""},{"id":7,"arabic":"أَعْتَدْنَا","translit":"āَnْdَtْʿعَaʾ","root":"عتد"},{"id":8,"arabic":"لِلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlِl","root":"كفر"},{"id":9,"arabic":"سَعِيرًا","translit":"āًryِʿعَs","root":"سعر"}],"hasIhya":true},{"ayah":14,"text":"وَلِلَّهِ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۚ يَغْفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۚ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ","translation":"And to Allāh belongs the dominion of the heavens and the earth. He forgives whom He wills and punishes whom He wills. And ever is Allāh Forgiving and Merciful.","words":[{"id":1,"arabic":"وَلِلَّهِ","translit":"ِhَّlِlَw","root":"اله"},{"id":2,"arabic":"مُلْكُ","translit":"ُkْlُm","root":"ملك"},{"id":3,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":4,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":5,"arabic":"يَغْفِرُ","translit":"ُrِfْغَy","root":"غفر"},{"id":6,"arabic":"لِمَن","translit":"nَmِl","root":""},{"id":7,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":8,"arabic":"وَيُعَذِّبُ","translit":"ُbِّhdَʿعُyَw","root":"عذب"},{"id":9,"arabic":"مَن","translit":"nَm","root":""},{"id":10,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":11,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"غَفُورًا","translit":"āًrwُfَغ","root":"غفر"},{"id":14,"arabic":"رَّحِيمًا","translit":"āًmyِḥَّr","root":"رحم"}],"hasIhya":false},{"ayah":15,"text":"سَيَقُولُ ٱلْمُخَلَّفُونَ إِذَا ٱنطَلَقْتُمْ إِلَىٰ مَغَانِمَ لِتَأْخُذُوهَا ذَرُونَا نَتَّبِعْكُمْۖ يُرِيدُونَ أَن يُبَدِّلُوا۟ كَلَٰمَ ٱللَّهِۚ قُل لَّن تَتَّبِعُونَا كَذَٰلِكُمْ قَالَ ٱللَّهُ مِن قَبْلُۖ فَسَيَقُولُونَ بَلْ تَحْسُدُونَنَاۚ بَلْ كَانُوا۟ لَا يَفْقَهُونَ إِلَّا قَلِيلًا ","translation":"Those who remained[1] behind will say when you set out toward the war booty to take it, \"Let us follow you.\" They wish to change the words of Allāh. Say, \"Never will you follow us. Thus did Allāh say before.\" So they will say, \"Rather, you envy us.\" But [in fact] they were not understanding except a little.[2]","words":[{"id":1,"arabic":"سَيَقُولُ","translit":"ُlwُqَyَs","root":"قول"},{"id":2,"arabic":"ٱلْمُخَلَّفُونَ","translit":"َnwُfَّlَhkُmْlٱ","root":"خلف"},{"id":3,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":4,"arabic":"ٱنطَلَقْتُمْ","translit":"ْmُtْqَlَṭnٱ","root":"طلق"},{"id":5,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":6,"arabic":"مَغَانِمَ","translit":"َmِnāَغَm","root":"غنم"},{"id":7,"arabic":"لِتَأْخُذُوهَا","translit":"āَhwُhdُhkْaʾَtِl","root":"اخذ"},{"id":8,"arabic":"ذَرُونَا","translit":"āَnwُrَhd","root":"وذر"},{"id":9,"arabic":"نَتَّبِعْكُمْ","translit":"ْmُkْʿعِbَّtَn","root":"تبع"},{"id":10,"arabic":"يُرِيدُونَ","translit":"َnwُdyِrُy","root":"رود"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يُبَدِّلُوا۟","translit":"۟āwُlِّdَbُy","root":"بدل"},{"id":13,"arabic":"كَلَٰمَ","translit":"َmَٰlَk","root":"كلم"},{"id":14,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":15,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":16,"arabic":"لَّن","translit":"nَّl","root":""},{"id":17,"arabic":"تَتَّبِعُونَا","translit":"āَnwُʿعِbَّtَt","root":"تبع"},{"id":18,"arabic":"كَذَٰلِكُمْ","translit":"ْmُkِlَٰhdَk","root":""},{"id":19,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"مِن","translit":"nِm","root":""},{"id":22,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":23,"arabic":"فَسَيَقُولُونَ","translit":"َnwُlwُqَyَsَf","root":"قول"},{"id":24,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":25,"arabic":"تَحْسُدُونَنَا","translit":"āَnَnwُdُsْḥَt","root":"حسد"},{"id":26,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":27,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":28,"arabic":"لَا","translit":"āَl","root":""},{"id":29,"arabic":"يَفْقَهُونَ","translit":"َnwُhَqْfَy","root":"فقه"},{"id":30,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":31,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"}],"hasIhya":false},{"ayah":16,"text":"قُل لِّلْمُخَلَّفِينَ مِنَ ٱلْأَعْرَابِ سَتُدْعَوْنَ إِلَىٰ قَوْمٍ أُو۟لِى بَأْسٍ شَدِيدٍ تُقَٰتِلُونَهُمْ أَوْ يُسْلِمُونَۖ فَإِن تُطِيعُوا۟ يُؤْتِكُمُ ٱللَّهُ أَجْرًا حَسَنًاۖ وَإِن تَتَوَلَّوْا۟ كَمَا تَوَلَّيْتُم مِّن قَبْلُ يُعَذِّبْكُمْ عَذَابًا أَلِيمًا ","translation":"Say to those who remained behind of the bedouins, \"You will be called to [face] a people of great military might; you may fight them, or they will submit.[1] So if you obey, Allāh will give you a good reward; but if you turn away as you turned away before, He will punish you with a painful punishment.\"","words":[{"id":1,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":2,"arabic":"لِّلْمُخَلَّفِينَ","translit":"َnyِfَّlَhkُmْlِّl","root":"خلف"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱلْأَعْرَابِ","translit":"ِbāَrْʿعَaʾْlٱ","root":"عرب"},{"id":5,"arabic":"سَتُدْعَوْنَ","translit":"َnْwَʿعْdُtَs","root":"دعو"},{"id":6,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":7,"arabic":"قَوْمٍ","translit":"ٍmْwَq","root":"قوم"},{"id":8,"arabic":"أُو۟لِى","translit":"àِl۟wُaʾ","root":""},{"id":9,"arabic":"بَأْسٍ","translit":"ٍsْaʾَb","root":"باس"},{"id":10,"arabic":"شَدِيدٍ","translit":"ٍdyِdَhs","root":"شدد"},{"id":11,"arabic":"تُقَٰتِلُونَهُمْ","translit":"ْmُhَnwُlِtَٰqُt","root":"قتل"},{"id":12,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":13,"arabic":"يُسْلِمُونَ","translit":"َnwُmِlْsُy","root":"سلم"},{"id":14,"arabic":"فَإِن","translit":"nِiʾَf","root":""},{"id":15,"arabic":"تُطِيعُوا۟","translit":"۟āwُʿعyِṭُt","root":"طوع"},{"id":16,"arabic":"يُؤْتِكُمُ","translit":"ُmُkِtْwʾُy","root":"اتي"},{"id":17,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":18,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":19,"arabic":"حَسَنًا","translit":"āًnَsَḥ","root":"حسن"},{"id":20,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":21,"arabic":"تَتَوَلَّوْا۟","translit":"۟āْwَّlَwَtَt","root":"ولي"},{"id":22,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":23,"arabic":"تَوَلَّيْتُم","translit":"mُtْyَّlَwَt","root":"ولي"},{"id":24,"arabic":"مِّن","translit":"nِّm","root":""},{"id":25,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":26,"arabic":"يُعَذِّبْكُمْ","translit":"ْmُkْbِّhdَʿعُy","root":"عذب"},{"id":27,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":28,"arabic":"أَلِيمًا","translit":"āًmyِlَaʾ","root":"الم"}],"hasIhya":false},{"ayah":17,"text":"لَّيْسَ عَلَى ٱلْأَعْمَىٰ حَرَجٌ وَلَا عَلَى ٱلْأَعْرَجِ حَرَجٌ وَلَا عَلَى ٱلْمَرِيضِ حَرَجٌۗ وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ يُدْخِلْهُ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۖ وَمَن يَتَوَلَّ يُعَذِّبْهُ عَذَابًا أَلِيمًا ","translation":"There is not upon the blind any guilt or upon the lame any guilt or upon the ill any guilt [for remaining behind]. And whoever obeys Allāh and His Messenger - He will admit him to gardens beneath which rivers flow; but whoever turns away - He will punish him with a painful punishment.","words":[{"id":1,"arabic":"لَّيْسَ","translit":"َsْyَّl","root":"ليس"},{"id":2,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":3,"arabic":"ٱلْأَعْمَىٰ","translit":"ٰàَmْʿعَaʾْlٱ","root":"عمي"},{"id":4,"arabic":"حَرَجٌ","translit":"ٌjgَrَḥ","root":"حرج"},{"id":5,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":6,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":7,"arabic":"ٱلْأَعْرَجِ","translit":"ِjgَrْʿعَaʾْlٱ","root":"عرج"},{"id":8,"arabic":"حَرَجٌ","translit":"ٌjgَrَḥ","root":"حرج"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":11,"arabic":"ٱلْمَرِيضِ","translit":"ِḍyِrَmْlٱ","root":"مرض"},{"id":12,"arabic":"حَرَجٌ","translit":"ٌjgَrَḥ","root":"حرج"},{"id":13,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":14,"arabic":"يُطِعِ","translit":"ِʿعِṭُy","root":"طوع"},{"id":15,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":16,"arabic":"وَرَسُولَهُۥ","translit":"ۥُhَlwُsَrَw","root":"رسل"},{"id":17,"arabic":"يُدْخِلْهُ","translit":"ُhْlِhkْdُy","root":"دخل"},{"id":18,"arabic":"جَنَّٰتٍ","translit":"ٍtَّٰnَjg","root":"جنن"},{"id":19,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":20,"arabic":"مِن","translit":"nِm","root":""},{"id":21,"arabic":"تَحْتِهَا","translit":"āَhِtْḥَt","root":"تحت"},{"id":22,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":23,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":24,"arabic":"يَتَوَلَّ","translit":"َّlَwَtَy","root":"ولي"},{"id":25,"arabic":"يُعَذِّبْهُ","translit":"ُhْbِّhdَʿعُy","root":"عذب"},{"id":26,"arabic":"عَذَابًا","translit":"āًbāَhdَʿع","root":"عذب"},{"id":27,"arabic":"أَلِيمًا","translit":"āًmyِlَaʾ","root":"الم"}],"hasIhya":true},{"ayah":18,"text":"لَّقَدْ رَضِىَ ٱللَّهُ عَنِ ٱلْمُؤْمِنِينَ إِذْ يُبَايِعُونَكَ تَحْتَ ٱلشَّجَرَةِ فَعَلِمَ مَا فِى قُلُوبِهِمْ فَأَنزَلَ ٱلسَّكِينَةَ عَلَيْهِمْ وَأَثَٰبَهُمْ فَتْحًا قَرِيبًا ","translation":"Certainly was Allāh pleased with the believers when they pledged allegiance to you, [O Muḥammad], under the tree, and He knew what was in their hearts, so He sent down tranquility upon them and rewarded them with an imminent conquest[1]","words":[{"id":1,"arabic":"لَّقَدْ","translit":"ْdَqَّl","root":""},{"id":2,"arabic":"رَضِىَ","translit":"َàِḍَr","root":"رضو"},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":5,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":6,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":7,"arabic":"يُبَايِعُونَكَ","translit":"َkَnwُʿعِyāَbُy","root":"بيع"},{"id":8,"arabic":"تَحْتَ","translit":"َtْḥَt","root":"تحت"},{"id":9,"arabic":"ٱلشَّجَرَةِ","translit":"ِẗَrَjgَّhslٱ","root":"شجر"},{"id":10,"arabic":"فَعَلِمَ","translit":"َmِlَʿعَf","root":"علم"},{"id":11,"arabic":"مَا","translit":"āَm","root":""},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"قُلُوبِهِمْ","translit":"ْmِhِbwُlُq","root":"قلب"},{"id":14,"arabic":"فَأَنزَلَ","translit":"َlَznَaʾَf","root":"نزل"},{"id":15,"arabic":"ٱلسَّكِينَةَ","translit":"َẗَnyِkَّslٱ","root":"سكن"},{"id":16,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":17,"arabic":"وَأَثَٰبَهُمْ","translit":"ْmُhَbَٰhtَaʾَw","root":"ثوب"},{"id":18,"arabic":"فَتْحًا","translit":"āًḥْtَf","root":"فتح"},{"id":19,"arabic":"قَرِيبًا","translit":"āًbyِrَq","root":"قرب"}],"hasIhya":false},{"ayah":19,"text":"وَمَغَانِمَ كَثِيرَةً يَأْخُذُونَهَاۗ وَكَانَ ٱللَّهُ عَزِيزًا حَكِيمًا ","translation":"And much war booty which they will take. And ever is Allāh Exalted in Might and Wise.","words":[{"id":1,"arabic":"وَمَغَانِمَ","translit":"َmِnāَغَmَw","root":"غنم"},{"id":2,"arabic":"كَثِيرَةً","translit":"ًẗَryِhtَk","root":"كثر"},{"id":3,"arabic":"يَأْخُذُونَهَا","translit":"āَhَnwُhdُhkْaʾَy","root":"اخذ"},{"id":4,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"عَزِيزًا","translit":"āًzyِzَʿع","root":"عزز"},{"id":7,"arabic":"حَكِيمًا","translit":"āًmyِkَḥ","root":"حكم"}],"hasIhya":false},{"ayah":20,"text":"وَعَدَكُمُ ٱللَّهُ مَغَانِمَ كَثِيرَةً تَأْخُذُونَهَا فَعَجَّلَ لَكُمْ هَٰذِهِۦ وَكَفَّ أَيْدِىَ ٱلنَّاسِ عَنكُمْ وَلِتَكُونَ ءَايَةً لِّلْمُؤْمِنِينَ وَيَهْدِيَكُمْ صِرَٰطًا مُّسْتَقِيمًا ","translation":"Allāh has promised you much booty that you will take [in the future] and has hastened for you this [victory] and withheld the hands of people from you - that it may be a sign for the believers and [that] He may guide you to a straight path.","words":[{"id":1,"arabic":"وَعَدَكُمُ","translit":"ُmُkَdَʿعَw","root":"وعد"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"مَغَانِمَ","translit":"َmِnāَغَm","root":"غنم"},{"id":4,"arabic":"كَثِيرَةً","translit":"ًẗَryِhtَk","root":"كثر"},{"id":5,"arabic":"تَأْخُذُونَهَا","translit":"āَhَnwُhdُhkْaʾَt","root":"اخذ"},{"id":6,"arabic":"فَعَجَّلَ","translit":"َlَّjgَʿعَf","root":"عجل"},{"id":7,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":8,"arabic":"هَٰذِهِۦ","translit":"ۦِhِhdَٰh","root":""},{"id":9,"arabic":"وَكَفَّ","translit":"َّfَkَw","root":"كفف"},{"id":10,"arabic":"أَيْدِىَ","translit":"َàِdْyَaʾ","root":"يدي"},{"id":11,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":12,"arabic":"عَنكُمْ","translit":"ْmُknَʿع","root":""},{"id":13,"arabic":"وَلِتَكُونَ","translit":"َnwُkَtِlَw","root":"كون"},{"id":14,"arabic":"ءَايَةً","translit":"ًẗَyāَء","root":"ايي"},{"id":15,"arabic":"لِّلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlِّl","root":"امن"},{"id":16,"arabic":"وَيَهْدِيَكُمْ","translit":"ْmُkَyِdْhَyَw","root":"هدي"},{"id":17,"arabic":"صِرَٰطًا","translit":"āًṭَٰrِṣ","root":"صرط"},{"id":18,"arabic":"مُّسْتَقِيمًا","translit":"āًmyِqَtْsُّm","root":"قوم"}],"hasIhya":false},{"ayah":21,"text":"وَأُخْرَىٰ لَمْ تَقْدِرُوا۟ عَلَيْهَا قَدْ أَحَاطَ ٱللَّهُ بِهَاۚ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرًا ","translation":"And [He promises] other [victories] that you were [so far] unable to [realize] which Allāh has already encompassed.[1] And ever is Allāh, over all things, competent.","words":[{"id":1,"arabic":"وَأُخْرَىٰ","translit":"ٰàَrْhkُaʾَw","root":"اخر"},{"id":2,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":3,"arabic":"تَقْدِرُوا۟","translit":"۟āwُrِdْqَt","root":"قدر"},{"id":4,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":5,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":6,"arabic":"أَحَاطَ","translit":"َṭāَḥَaʾ","root":"حوط"},{"id":7,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":8,"arabic":"بِهَا","translit":"āَhِb","root":""},{"id":9,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":10,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":11,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":12,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":13,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":14,"arabic":"قَدِيرًا","translit":"āًryِdَq","root":"قدر"}],"hasIhya":false},{"ayah":22,"text":"وَلَوْ قَٰتَلَكُمُ ٱلَّذِينَ كَفَرُوا۟ لَوَلَّوُا۟ ٱلْأَدْبَٰرَ ثُمَّ لَا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا ","translation":"And if those [Makkans] who disbelieve had fought you, they would have turned their backs [in flight]. Then they would not find a protector or a helper.","words":[{"id":1,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":2,"arabic":"قَٰتَلَكُمُ","translit":"ُmُkَlَtَٰq","root":"قتل"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":5,"arabic":"لَوَلَّوُا۟","translit":"۟āُwَّlَwَl","root":"ولي"},{"id":6,"arabic":"ٱلْأَدْبَٰرَ","translit":"َrَٰbْdَaʾْlٱ","root":"دبر"},{"id":7,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":8,"arabic":"لَا","translit":"āَl","root":""},{"id":9,"arabic":"يَجِدُونَ","translit":"َnwُdِjgَy","root":"وجد"},{"id":10,"arabic":"وَلِيًّا","translit":"āًّyِlَw","root":"ولي"},{"id":11,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":12,"arabic":"نَصِيرًا","translit":"āًryِṣَn","root":"نصر"}],"hasIhya":false},{"ayah":23,"text":"سُنَّةَ ٱللَّهِ ٱلَّتِى قَدْ خَلَتْ مِن قَبْلُۖ وَلَن تَجِدَ لِسُنَّةِ ٱللَّهِ تَبْدِيلًا ","translation":"[This is] the established way of Allāh which has occurred before. And never will you find in the way of Allāh any change.","words":[{"id":1,"arabic":"سُنَّةَ","translit":"َẗَّnُs","root":"سنن"},{"id":2,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":3,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":4,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":5,"arabic":"خَلَتْ","translit":"ْtَlَhk","root":"خلو"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":8,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":9,"arabic":"تَجِدَ","translit":"َdِjgَt","root":"وجد"},{"id":10,"arabic":"لِسُنَّةِ","translit":"ِẗَّnُsِl","root":"سنن"},{"id":11,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":12,"arabic":"تَبْدِيلًا","translit":"āًlyِdْbَt","root":"بدل"}],"hasIhya":true},{"ayah":24,"text":"وَهُوَ ٱلَّذِى كَفَّ أَيْدِيَهُمْ عَنكُمْ وَأَيْدِيَكُمْ عَنْهُم بِبَطْنِ مَكَّةَ مِنۢ بَعْدِ أَنْ أَظْفَرَكُمْ عَلَيْهِمْۚ وَكَانَ ٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرًا ","translation":"And it is He who withheld their hands from you and your hands from them within [the area of] Makkah after He caused you to overcome them. And ever is Allāh, of what you do, Seeing.","words":[{"id":1,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَّ","translit":"َّfَk","root":"كفف"},{"id":4,"arabic":"أَيْدِيَهُمْ","translit":"ْmُhَyِdْyَaʾ","root":"يدي"},{"id":5,"arabic":"عَنكُمْ","translit":"ْmُknَʿع","root":""},{"id":6,"arabic":"وَأَيْدِيَكُمْ","translit":"ْmُkَyِdْyَaʾَw","root":"يدي"},{"id":7,"arabic":"عَنْهُم","translit":"mُhْnَʿع","root":""},{"id":8,"arabic":"بِبَطْنِ","translit":"ِnْṭَbِb","root":"بطن"},{"id":9,"arabic":"مَكَّةَ","translit":"َẗَّkَm","root":""},{"id":10,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":11,"arabic":"بَعْدِ","translit":"ِdْʿعَb","root":"بعد"},{"id":12,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":13,"arabic":"أَظْفَرَكُمْ","translit":"ْmُkَrَfْẓَaʾ","root":"ظفر"},{"id":14,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":15,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":16,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":17,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":18,"arabic":"تَعْمَلُونَ","translit":"َnwُlَmْʿعَt","root":"عمل"},{"id":19,"arabic":"بَصِيرًا","translit":"āًryِṣَb","root":"بصر"}],"hasIhya":false},{"ayah":25,"text":"هُمُ ٱلَّذِينَ كَفَرُوا۟ وَصَدُّوكُمْ عَنِ ٱلْمَسْجِدِ ٱلْحَرَامِ وَٱلْهَدْىَ مَعْكُوفًا أَن يَبْلُغَ مَحِلَّهُۥۚ وَلَوْلَا رِجَالٌ مُّؤْمِنُونَ وَنِسَآءٌ مُّؤْمِنَٰتٌ لَّمْ تَعْلَمُوهُمْ أَن تَطَـُٔوهُمْ فَتُصِيبَكُم مِّنْهُم مَّعَرَّةٌۢ بِغَيْرِ عِلْمٍۖ لِّيُدْخِلَ ٱللَّهُ فِى رَحْمَتِهِۦ مَن يَشَآءُۚ لَوْ تَزَيَّلُوا۟ لَعَذَّبْنَا ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ عَذَابًا أَلِيمًا ","translation":"They are the ones who disbelieved and obstructed you from al-Masjid al-Ḥarām while the offering[1] was prevented from reaching its place of sacrifice. And if not for believing men and believing women whom you did not know - that you might trample [i.e., kill] them and there would befall you because of them dishonor without [your] knowledge - [you would have been permitted to enter Makkah]. [This was so] that Allāh might admit to His mercy whom He willed. If they had been apart [from them], We would have punished those who disbelieved among them with painful punishment","words":[{"id":1,"arabic":"هُمُ","translit":"ُmُh","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"وَصَدُّوكُمْ","translit":"ْmُkwُّdَṣَw","root":"صدد"},{"id":5,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":6,"arabic":"ٱلْمَسْجِدِ","translit":"ِdِjgْsَmْlٱ","root":"سجد"},{"id":7,"arabic":"ٱلْحَرَامِ","translit":"ِmāَrَḥْlٱ","root":"حرم"},{"id":8,"arabic":"وَٱلْهَدْىَ","translit":"َàْdَhْlٱَw","root":"هدي"},{"id":9,"arabic":"مَعْكُوفًا","translit":"āًfwُkْʿعَm","root":"عكف"},{"id":10,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":11,"arabic":"يَبْلُغَ","translit":"َغُlْbَy","root":"بلغ"},{"id":12,"arabic":"مَحِلَّهُۥ","translit":"ۥُhَّlِḥَm","root":"حلل"},{"id":13,"arabic":"وَلَوْلَا","translit":"āَlْwَlَw","root":""},{"id":14,"arabic":"رِجَالٌ","translit":"ٌlāَjgِr","root":"رجل"},{"id":15,"arabic":"مُّؤْمِنُونَ","translit":"َnwُnِmْwʾُّm","root":"امن"},{"id":16,"arabic":"وَنِسَآءٌ","translit":"ٌءٓāَsِnَw","root":"نسو"},{"id":17,"arabic":"مُّؤْمِنَٰتٌ","translit":"ٌtَٰnِmْwʾُّm","root":"امن"},{"id":18,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":19,"arabic":"تَعْلَمُوهُمْ","translit":"ْmُhwُmَlْʿعَt","root":"علم"},{"id":20,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":21,"arabic":"تَطَـُٔوهُمْ","translit":"ْmُhwُٔـَṭَt","root":"وطا"},{"id":22,"arabic":"فَتُصِيبَكُم","translit":"mُkَbyِṣُtَf","root":"صوب"},{"id":23,"arabic":