{"surah": 94, "verses": [{"ayah": 1, "text": "أَلَمْ نَشْرَحْ لَكَ صَدْرَكَ ", "translation": "Did We not expand for you, [O Muḥammad], your breast?[1]", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "نَشْرَحْ", "translit": "ْḥَrْhsَn", "root": "شرح"}, {"id": 3, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 4, "arabic": "صَدْرَكَ", "translit": "َkَrْdَṣ", "root": "صدر"}], "hasIhya": false}, {"ayah": 2, "text": "وَوَضَعْنَا عَنكَ وِزْرَكَ ", "translation": "And We removed from you your burden[1]", "words": [{"id": 1, "arabic": "وَوَضَعْنَا", "translit": "āَnْʿعَḍَwَw", "root": "وضع"}, {"id": 2, "arabic": "عَنكَ", "translit": "َknَʿع", "root": ""}, {"id": 3, "arabic": "وِزْرَكَ", "translit": "َkَrْzِw", "root": "وزر"}], "hasIhya": false}, {"ayah": 3, "text": "ٱلَّذِىٓ أَنقَضَ ظَهْرَكَ ", "translation": "Which had weighed upon your back", "words": [{"id": 1, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "أَنقَضَ", "translit": "َḍَqnَaʾ", "root": "نقض"}, {"id": 3, "arabic": "ظَهْرَكَ", "translit": "َkَrْhَẓ", "root": "ظهر"}], "hasIhya": false}, {"ayah": 4, "text": "وَرَفَعْنَا لَكَ ذِكْرَكَ ", "translation": "And raised high for you your repute.", "words": [{"id": 1, "arabic": "وَرَفَعْنَا", "translit": "āَnْʿعَfَrَw", "root": "رفع"}, {"id": 2, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 3, "arabic": "ذِكْرَكَ", "translit": "َkَrْkِhd", "root": "ذكر"}], "hasIhya": false}, {"ayah": 5, "text": "فَإِنَّ مَعَ ٱلْعُسْرِ يُسْرًا ", "translation": "For indeed, with hardship [will be] ease [i.e., relief].", "words": [{"id": 1, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 2, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 3, "arabic": "ٱلْعُسْرِ", "translit": "ِrْsُʿعْlٱ", "root": "عسر"}, {"id": 4, "arabic": "يُسْرًا", "translit": "āًrْsُy", "root": "يسر"}], "hasIhya": false}, {"ayah": 6, "text": "إِنَّ مَعَ ٱلْعُسْرِ يُسْرًا ", "translation": "Indeed, with hardship [will be] ease.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 3, "arabic": "ٱلْعُسْرِ", "translit": "ِrْsُʿعْlٱ", "root": "عسر"}, {"id": 4, "arabic": "يُسْرًا", "translit": "āًrْsُy", "root": "يسر"}], "hasIhya": false}, {"ayah": 7, "text": "فَإِذَا فَرَغْتَ فَٱنصَبْ ", "translation": "So when you have finished [your duties], then stand up [for worship].", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "فَرَغْتَ", "translit": "َtْغَrَf", "root": "فرغ"}, {"id": 3, "arabic": "فَٱنصَبْ", "translit": "ْbَṣnٱَf", "root": "نصب"}], "hasIhya": false}, {"ayah": 8, "text": "وَإِلَىٰ رَبِّكَ فَٱرْغَب ", "translation": "And to your Lord direct [your] longing.", "words": [{"id": 1, "arabic": "وَإِلَىٰ", "translit": "ٰàَlِiʾَw", "root": ""}, {"id": 2, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 3, "arabic": "فَٱرْغَب", "translit": "bَغْrٱَf", "root": "رغب"}], "hasIhya": false}], "tafsir": {}, "wordTiming": {"minshawi": {"1": [[1, 440, 1335], [2, 1335, 2538], [3, 2538, 3097], [4, 3097, 4370]], "94:1": [[1, 440, 1335], [2, 1335, 2538], [3, 2538, 3097], [4, 3097, 4370]], "2": [[1, 200, 2713], [2, 2713, 3456], [3, 3456, 4690]], "94:2": [[1, 200, 2713], [2, 2713, 3456], [3, 3456, 4690]], "3": [[1, 380, 3473], [2, 3473, 4856], [3, 4856, 6090]], "94:3": [[1, 380, 3473], [2, 3473, 4856], [3, 4856, 6090]], "4": [[1, 230, 2372], [2, 2372, 2830], [3, 2830, 3770]], "94:4": [[1, 230, 2372], [2, 2372, 2830], [3, 2830, 3770]], "5": [[1, 510, 1603], [2, 1603, 2162], [3, 2162, 3330], [4, 3330, 5610]], "94:5": [[1, 510, 1603], [2, 1603, 2162], [3, 2162, 3330], [4, 3330, 5610]], "6": [[1, 290, 1122], [2, 1122, 1673], [3, 1673, 2823], [4, 2823, 5070]], "94:6": [[1, 290, 1122], [2, 1122, 1673], [3, 1673, 2823], [4, 2823, 5070]], "7": [[1, 10, 1800], [2, 1800, 3038], [3, 3038, 4500]], "94:7": [[1, 10, 180