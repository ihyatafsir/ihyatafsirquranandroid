ation": "warsh"}, {"surah": 26, "ayah": 189, "text": "فَكَذَّبُوهُ فَأَخَذَهُمْ عَذَابُ يَوْمِ اِ۬لظُّلَّةِۖ إِنَّهُۥ كَانَ عَذَابَ يَوْمٍ عَظِيمٍۖ", "words": [{"id": 1, "arabic": "فَكَذَّبُوهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَأَخَذَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَذَابُ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لظُّلَّةِۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَذَابَ", "translit": "", "root": ""}, {"id": 9, "arabic": "يَوْمٍ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَظِيمٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 190, "text": "اِنَّ فِے ذَٰلِكَ لَأٓيَةࣰۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَأٓيَةࣰۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَكْثَرُهُم", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 191, "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لرَّحِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 192, "text": "وَإِنَّهُۥ لَتَنزِيلُ رَبِّ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "وَإِنَّهُۥ", "translit": 