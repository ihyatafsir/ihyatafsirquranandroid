lit": "", "root": ""}, {"id": 4, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَرَوُاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْعَذَابَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لَالِيمَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 202, "text": "فَيَاتِيَهُم بَغْتَةࣰ وَهُمْ لَا يَشْعُرُونَ", "words": [{"id": 1, "arabic": "فَيَاتِيَهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "بَغْتَةࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَشْعُرُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 203, "text": "فَيَقُولُواْ هَلْ نَحْنُ مُنظَرُونَۖ", "words": [{"id": 1, "arabic": "فَيَقُولُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُنظَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 204, "text": "أَفَبِعَذَابِنَا يَسْتَعْجِلُونَۖ", "words": [{"id": 1, "arabic": "أَفَبِعَذَابِنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسْتَعْجِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 205, "text": "أَفَرَٰٓيْتَ إِن مَّتَّعْنَٰهُمْ سِنِينَ", "words": [{"id": 1, "arabic": "أَفَرَٰٓيْتَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّتَّعْنَٰهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "سِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 206, "text": "ثُمَّ جَآءَهُم مَّا كَانُواْ يُوعَدُونَ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يُوعَدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 207, "text": "مَآ أَغْن۪يٰ عَنْهُم مَّا كَانُواْ يُمَتَّعُونَۖ", "words": [{"id": 1, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَغْن۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَنْهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "يُمَتَّعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 208, "text": "وَمَآ أَهْلَكْنَا مِن قَرْيَةٍ اِلَّا لَهَا مُنذِرُونَ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَهْلَكْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَرْيَةٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "مُنذِرُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 209, "text": "ذِكْر۪يٰۖ وَمَا كُنَّا ظَٰلِمِينَۖ", "words": [{"id": 1, "arabic": "ذِكْر۪يٰۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "ظَٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 210, "text": "۞وَمَا تَنَزَّلَتْ بِهِ اِ۬لشَّيَٰطِينُ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَنَزَّلَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لشَّيَٰطِينُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 211, "text": "وَمَا يَنۢبَغِے لَهُمْ وَمَا يَسْتَطِيعُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id