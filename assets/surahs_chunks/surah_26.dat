 "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 46, "text": "فَأُلْقِيَ اَ۬لسَّحَرَةُ سَٰجِدِينَۖ", "words": [{"id": 1, "arabic": "فَأُلْقِيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّحَرَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَٰجِدِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 47, "text": "قَالُوٓاْ ءَامَنَّا بِرَبِّ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِرَبِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 48, "text": "رَبِّ مُوس۪يٰ وَهَٰرُونَۖ", "words": [{"id": 1, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 2, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَهَٰرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 49, "text": "قَالَ ءَاٰ۬مَنتُمْ لَهُۥ قَبْلَ أَنَ اٰذَنَ لَكُمُۥٓ إِنَّهُۥ لَكَبِيرُكُمُ اُ۬لذِے عَلَّمَكُمُ اُ۬لسِّحْرَۖ فَلَسَوْفَ تَعْلَمُونَۖ لَأُقَطِّعَنَّ أَيْدِيَكُمْ وَأَرْجُلَكُم مِّنْ خِلَٰفࣲ وَلَأُصَلِّبَنَّكُمُۥٓ أَجْمَعِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَاٰ۬مَنتُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰذَنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكُمُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَكَبِيرُكُمُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لذِے", "translit": "", "root": ""}, {"id": 11, "arabic": "عَلَّمَكُمُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لسِّحْرَۖ", "transl