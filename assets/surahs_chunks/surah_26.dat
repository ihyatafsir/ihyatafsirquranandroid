it": "", "root": ""}, {"id": 5, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَادࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَهِيمُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 226, "text": "وَأَنَّهُمْ يَقُولُونَ مَا لَا يَفْعَلُونَۖ", "words": [{"id": 1, "arabic": "وَأَنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَفْعَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 227, "text": "إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ وَذَكَرُواْ اُ۬للَّهَ كَثِيراࣰ وَانتَصَرُواْ مِنۢ بَعْدِ مَا ظُلِمُواْۖ وَسَيَعْلَمُ اُ۬لذِينَ ظَلَمُوٓاْ أَيَّ مُنقَلَبࣲ يَنقَلِبُونَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَذَكَرُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَثِيراࣰ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَانتَصَرُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 11, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَا", "translit": "", "root": ""}, {"id": 13, "arabic": "ظُلِمُواْۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَسَيَعْلَمُ", "translit": "", "root": ""}, {"id": 15, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 16, "arabic": "ظَلَمُوٓاْ", "translit": "", "root": ""}, {"id": 17, "arabic": "أَيَّ", "translit": "", "root": ""}, {"id": 18, "arabic": "مُنقَلَبࣲ", "translit": "",