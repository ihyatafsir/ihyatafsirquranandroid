نَا وَلِيداࣰ وَلَبِثْتَ فِينَا مِنْ عُمُرِكَ سِنِينَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَلَمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُرَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِينَا", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلِيداࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَبِثْتَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِينَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "عُمُرِكَ", "translit": "", "root": ""}, {"id": 10, "arabic": "سِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 19, "text": "وَفَعَلْتَ فَعْلَتَكَ اَ۬لتِے فَعَلْتَ وَأَنتَ مِنَ اَ۬لْكٰ۪فِرِينَۖ", "words": [{"id": 1, "arabic": "وَفَعَلْتَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَعْلَتَكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لتِے", "translit": "", "root": ""}, {"id": 4, "arabic": "فَعَلْتَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَنتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْكٰ۪فِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 20, "text": "قَالَ فَعَلْتُهَآ إِذاࣰ وَأَنَا مِنَ اَ۬لضَّآلِّينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَعَلْتُهَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لضَّآلِّينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 21, "text": "فَفَرَرْتُ مِنكُمْ لَمَّا خِفْتُكُمْ فَوَهَبَ لِے رَبِّے حُكْماࣰ وَجَعَلَنِے مِنَ اَ۬لْمُرْسَلِينَۖ", "words": [{"id": 1, "arabic": "فَفَرَرْتُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنكُمْ