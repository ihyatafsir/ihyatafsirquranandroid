", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 29, "text": "قَالَ لَئِنِ اِ۪تَّخَذتَّ إِلَٰهاً غَيْرِے لَأَجْعَلَنَّكَ مِنَ اَ۬لْمَسْجُونِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَئِنِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۪تَّخَذتَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَٰهاً", "translit": "", "root": ""}, {"id": 5, "arabic": "غَيْرِے", "translit": "", "root": ""}, {"id": 6, "arabic": "لَأَجْعَلَنَّكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْمَسْجُونِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 30, "text": "قَالَ أَوَلَوْ جِئْتُكَ بِشَےْءࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَوَلَوْ", "translit": "", "root": ""}, {"id": 3, "arabic": "جِئْتُكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِشَےْءࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّبِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 31, "text": "قَالَ فَاتِ بِهِۦٓ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَاتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لصَّٰدِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 32, "text": "فَأَلْق۪يٰ عَصَاهُ فَإِذَا هِيَ ثُعْبَانࣱ مُّبِينࣱ‏", "words": [{"id": 1, "arabic": "فَأَلْق۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَصَاهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "ثُعْبَانࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّبِينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 33, "text": "وَنَزَعَ يَدَهُۥ فَإِذَا هِيَ بَيْضَآءُ لِلنَّٰظِرِينَۖ", "words": [{"id": 1, "arabic": "وَنَزَعَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَدَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَإِذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْضَآءُ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِلنَّٰظِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 34, "text": "قَالَ لِلْمَلَإِ حَوْلَهُۥٓ إِنَّ هَٰذَا لَسَٰحِرٌ عَلِيمࣱ‏", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلْمَلَإِ", "translit": "", "root": ""}, {"id": 3, "arabic": "حَوْلَهُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 6, "arabic": "لَسَٰحِرٌ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلِيمࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 35, "text": "يُرِيدُ أَنْ يُّخْرِجَكُم مِّنَ اَرْضِكُم بِسِحْرِهِۦ فَمَاذَا تَامُرُونَۖ", "words": [{"id": 1, "arabic": "يُرِيدُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُّخْرِجَكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَرْضِكُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِسِحْرِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَمَاذَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَامُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 36, "text": "قَالُوٓاْ أَرْجِهِۦ وَأَخَاهُ وَابْعَثْ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْجِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَخَاهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَابْعَثْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْمَدَآئِنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَٰشِرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 37, "text": "يَاتُوكَ بِكُلِّ سَحّ۪ارٍ عَلِيمࣲۖ", "words": [{"id": 1, "arabic": "يَاتُوكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِكُلِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَحّ۪ارٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 38, "text": "فَجُمِعَ اَ۬لسَّحَرَةُ لِمِيقَٰتِ يَوْمࣲ مَّعْلُومࣲۖ", "words": [{"id": 1, "arabic": "فَجُمِعَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّحَرَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِمِيقَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّعْلُومࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 39, "text": "وَقِيلَ لِلنَّاسِ هَلَ اَنتُم مُّجْتَمِعُونَ", "words": [{"id": 1, "arabic": "وَقِيلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلنَّاسِ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَنتُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّجْتَمِعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 40, "text": "لَعَلَّنَا نَتَّبِعُ اُ۬لسَّحَرَةَ إِن كَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ", "words": [{"id": 1, "arabic": "لَعَلَّنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَتَّبِعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لسَّحَرَةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْغَٰلِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 41, "text": "فَلَمَّا جَآءَ اَ۬لسَّحَرَةُ قَالُواْ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْراً اِن كُنَّا نَحْنُ اُ۬لْغَٰلِبِينَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّحَرَةُ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِفِرْعَوْنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَئِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "لَأَجْراً", "translit": "", "root": ""}, {"id": 9, "arabic": "اِن", "translit": "", "root": ""}, {"id": 10, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْغَٰلِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 42, "text": "قَالَ نَعَمْ وَإِنَّكُمُۥٓ إِذاࣰ لَّمِنَ اَ۬لْمُقَرَّبِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَعَمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَإِنَّكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّمِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُقَرَّبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 43, "text": "قَالَ لَهُم مُّوس۪يٰٓ أَلْقُواْ مَآ أَنتُم مُّلْقُونَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّوس۪يٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَلْقُواْ", "translit": "", "root": ""}, {"id": 