": ""}, {"id": 6, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۟يَةࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَظَلَّتَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَعْنَٰقُهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 11, "arabic": "خَٰضِعِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 5, "text": "وَمَا يَاتِيهِم مِّن ذِكْرࣲ مِّنَ اَ۬لرَّحْمَٰنِ مُحْدَثٍ اِلَّا كَانُواْ عَنْهُ مُعْرِضِينَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَاتِيهِم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "ذِكْرࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لرَّحْمَٰنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُحْدَثٍ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُعْرِضِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 6, "text": "فَقَدْ كَذَّبُواْ فَسَيَاتِيهِمُۥٓ أَنۢبَٰٓؤُاْ مَا كَانُواْ بِهِۦ يَسْتَهْزِءُونَۖ", "words": [{"id": 1, "arabic": "فَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَّبُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَسَيَاتِيهِمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنۢبَٰٓؤُاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَسْتَهْزِءُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 7, "text": "أَوَلَمْ يَرَوِاْ اِلَي اَ۬لَارْضِ كَمَ اَنۢبَتْنَا فِيهَا مِن كُ