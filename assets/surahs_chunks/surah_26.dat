on": "warsh"}, {"surah": 26, "ayah": 63, "text": "فَأَوْحَيْنَآ إِلَيٰ مُوس۪يٰٓ أَنِ اِ۪ضْرِب بِّعَصَاكَ اَ۬لْبَحْرَ فَانفَلَقَ فَكَانَ كُلُّ فِرْقࣲ كَالطَّوْدِ اِ۬لْعَظِيمِۖ", "words": [{"id": 1, "arabic": "فَأَوْحَيْنَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۪ضْرِب", "translit": "", "root": ""}, {"id": 6, "arabic": "بِّعَصَاكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْبَحْرَ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَانفَلَقَ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَكَانَ", "translit": "", "root": ""}, {"id": 10, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 11, "arabic": "فِرْقࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "كَالطَّوْدِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لْعَظِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 64, "text": "وَأَزْلَفْنَا ثَمَّ اَ۬لَاخَرِينَۖ", "words": [{"id": 1, "arabic": "وَأَزْلَفْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ثَمَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لَاخَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 65, "text": "وَأَنجَيْنَا مُوس۪يٰ وَمَن مَّعَهُۥٓ أَجْمَعِينَ", "words": [{"id": 1, "arabic": "وَأَنجَيْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَمَن", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّعَهُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَجْمَعِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 66, "text": "ثُمَّ أَغْرَقْنَا اَ۬لَاخَرِينَۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَغْرَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لَاخَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 67, "text": "إِنَّ فِے ذَٰلِكَ لَأٓيَةࣰۖ وَمَا كَانَ أَكْثَرُهُم مُّومِنِينَۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَأٓيَةࣰۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَكْثَرُهُم", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 68, "text": "وَإِنَّ رَبَّكَ لَهُوَ اَ۬لْعَزِيزُ اُ۬لرَّحِيمُۖ", "words": [{"id": 1, "arabic": "وَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لرَّحِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 69, "text": "وَاتْلُ عَلَيْهِمْ نَبَأَ ا۪بْرَٰهِيمَ", "words": [{"id": 1, "arabic": "وَاتْلُ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَبَأَ", "translit": "", "root": ""}, {"id": 4, "arabic": "ا۪بْرَٰهِيمَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 70, "text": "إِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَا تَعْبُدُونَۖ", "words": [{"id": 1, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِأَبِيهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَقَوْمِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَعْبُدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 71, "text": "قَالُواْ نَعْبُدُ أَصْنَاماࣰ فَنَظَلُّ لَهَا عَٰكِفِينَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَعْبُدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَصْنَاماࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَنَظَلُّ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "عَٰكِفِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 72, "text": "قَالَ هَلْ يَسْمَعُونَكُمُۥٓ إِذْ تَدْعُونَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَسْمَعُونَكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَدْعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 73, "text": "أَوْ يَنفَعُونَكُمُۥٓ أَوْ يَضُرُّونَۖ", "words": [{"id": 1, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَنفَعُونَكُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَضُرُّونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 74, "text": "قَالُواْ بَلْ وَجَدْنَآ ءَابَآءَنَا كَذَٰلِكَ يَفْعَلُونَۖ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَجَدْنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَابَآءَنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَفْعَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 75, "text": "قَالَ أَفَرَٰٓيْتُم مَّا كُنتُمْ تَعْبُدُونَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَفَرَٰٓيْتُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "تَعْبُدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 76, "text": "أَنتُمْ وَءَابَآؤُكُمُ اُ۬لَاقْدَمُونَ", "words": [{"id": 1, "arabic": "أَنتُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَءَابَآؤُكُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لَاقْدَمُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 77, "text": "فَإِنَّهُمْ عَدُوࣱّ لِّيَۖ إِلَّا رَبَّ اَ۬لْعَٰلَمِينَ", "words": [{"id": 1, "arabic": "فَإِنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَدُوࣱّ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِّيَۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبَّ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَٰلَمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 78, "text": "اَ۬لذِے خَلَقَنِے فَهُوَ يَهْدِينِۖ", "words": [{"id": 1, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقَنِے", "translit": "", "root": ""}, {"id": 3, "arabic": "فَهُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَهْدِينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 79, "text": "وَالذِے هُوَ يُطْعِمُنِے وَيَسْقِينِ", "words": [{"id": 1, "arabic": "وَالذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُطْعِمُنِے", "translit": "", "root": ""}, {"id": 4, "arabic": "وَيَسْقِينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 80, "text": "وَإِذَا مَرِضْتُ فَهُوَ يَشْفِينِۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَرِضْتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَهُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَشْفِينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 81, "text": "وَالذِے يُمِيتُنِے ثُمَّ يُحْيِينِۖ", "words": [{"id": 1, "arabic": "وَالذِے", "translit": "", "root": ""}, {"id": 2, "arabic": "يُمِيتُنِے", "translit": "", "root": ""}, {"id": 3, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُحْيِينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 82, "text": "۞وَالذِےٓ أَطْمَعُ أَنْ يَّغْفِرَ لِے خَطِيَٓٔتِے يَوْمَ اَ۬لدِّينِۖ", "words": [{"id": 1, "arabic": "۞وَالذِےٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَطْمَعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَّغْفِرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِے", "translit": "", "root": ""}, {"id": 6, "arabic": "خَطِيَٓٔتِے", "translit": "", "root": ""}, {"id": 7, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لدِّينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 83, "text": "رَبِّ هَبْ لِے حُكْماࣰ وَأَلْحِقْنِے بِالصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَبْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِے", "translit": "", "root": ""}, {"id": 4, "arabic": "حُكْماࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَلْحِقْنِے", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 84, "text": "وَاجْعَل لِّے لِسَانَ صِدْقࣲ فِے اِ۬لَاخِرِينَۖ", "words": [{"id": 1, "arabic": "وَاجْعَل", "translit": "", "root": ""}, {"id": 2, "arabic": "لِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "لِسَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "صِدْقࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لَاخِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 85, "text": "وَاجْعَلْنِے مِنْ وَّرَثَةِ جَنَّةِ اِ۬لنَّعِيمِۖ", "words": [{"id": 1, "arabic": "وَاجْعَلْنِے", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَّرَثَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّةِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لنَّعِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 86, "text": "وَاغْفِرْ لِأَبِيَ إِنَّهُۥ كَانَ مِنَ اَ۬لضَّآلِّينَۖ", "words": [{"id": 1, "arabic": "وَاغْفِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِأَبِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لضَّآلِّينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 87, "text": "وَلَا تُخْزِنِے يَوْمَ يُبْعَثُونَ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تُخْزِنِے", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُبْعَثُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 88, "text": "يَوْمَ لَا يَنفَعُ مَالࣱ وَلَا بَنُونَ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يَنفَعُ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَالࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَنُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 89, "text": "إِلَّا مَنَ اَتَي اَ۬للَّهَ بِقَلْبࣲ سَلِيمࣲۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَتَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِقَلْبࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "سَلِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 90, "text": "وَأُزْلِفَتِ اِ۬لْجَنَّةُ لِلْمُتَّقِينَۖ", "words": [{"id": 1, "arabic": "وَأُزْلِفَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْجَنَّةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْمُتَّقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 91, "text": "وَبُرِّزَتِ اِ۬لْجَحِيمُ لِلْغَاوِينَۖ", "words": [{"id": 1, "arabic": "وَبُرِّزَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْجَحِيمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْغَاوِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 92, "text": "وَقِيلَ لَهُمُۥٓ أَيْنَ مَا كُنتُمْ تَعْبُدُونَ", "words": [{"id": 1, "arabic": "وَقِيلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَيْنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَعْبُدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 93, "text": "مِن دُونِ اِ۬للَّهِۖ هَلْ يَنصُرُونَكُمُۥٓ أَوْ يَنتَصِرُونَۖ", "words": [{"id": 1, "arabic": "مِن", "translit": "", "root": ""}, {"id": 2, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَنصُرُونَكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَنتَصِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 94, "text": "فَكُبْكِبُواْ فِيهَا هُمْ وَالْغَاوُۥنَ", "words": [{"id": 1, "arabic": "فَكُبْكِبُواْ", "translit": "", "roo