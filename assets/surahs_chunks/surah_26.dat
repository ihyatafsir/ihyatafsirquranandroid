}, {"id": 2, "arabic": "رَبُّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمَشْرِقِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالْمَغْرِبِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَيْنَهُمَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِن", "translit": "", "root": ""}, {"id": 8, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "تَعْقِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 29, "text": "قَالَ لَئِنِ اِ۪تَّخَذتَّ إِلَٰهاً غَيْرِے لَأَجْعَلَنَّكَ مِنَ اَ۬لْمَسْجُونِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَئِنِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۪تَّخَذتَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَٰهاً", "translit": "", "root": ""}, {"id": 5, "arabic": "غَيْرِے", "translit": "", "root": ""}, {"id": 6, "arabic": "لَأَجْعَلَنَّكَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْمَسْجُونِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 30, "text": "قَالَ أَوَلَوْ جِئْتُكَ بِشَےْءࣲ مُّبِينࣲۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَوَلَوْ", "translit": "", "root": ""}, {"id": 3, "arabic": "جِئْتُكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِشَےْءࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّبِينࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 31, "text": "قَالَ فَاتِ بِهِۦٓ إِن كُنتَ مِنَ اَ۬لصَّٰدِقِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَاتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتَ", "translit": "", "root": ""}, {"id": 6,