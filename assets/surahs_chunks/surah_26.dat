: "۞وَمَا تَنَزَّلَتْ بِهِ اِ۬لشَّيَٰطِينُ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَنَزَّلَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لشَّيَٰطِينُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 211, "text": "وَمَا يَنۢبَغِے لَهُمْ وَمَا يَسْتَطِيعُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَنۢبَغِے", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَسْتَطِيعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 212, "text": "إِنَّهُمْ عَنِ اِ۬لسَّمْعِ لَمَعْزُولُونَۖ", "words": [{"id": 1, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لسَّمْعِ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَمَعْزُولُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 213, "text": "فَلَا تَدْعُ مَعَ اَ۬للَّهِ إِلَٰهاً اٰخَرَ فَتَكُونَ مِنَ اَ۬لْمُعَذَّبِينَۖ", "words": [{"id": 1, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَدْعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهاً", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰخَرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَتَكُونَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْمُعَذَّبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 214, "text": "وَأَنذِرْ عَشِيرَتَكَ اَ۬لَاقْرَبِينَ", "words": [{"id": 1, "arabic": "وَأَنذِرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَشِيرَتَكَ", 