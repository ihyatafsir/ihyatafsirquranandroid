": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَرْضِكُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِسِحْرِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَمَاذَا", "translit": "", "root": ""}, {"id": 8, "arabic": "تَامُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 36, "text": "قَالُوٓاْ أَرْجِهِۦ وَأَخَاهُ وَابْعَثْ فِے اِ۬لْمَدَآئِنِ حَٰشِرِينَ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْجِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَخَاهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَابْعَثْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْمَدَآئِنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَٰشِرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 37, "text": "يَاتُوكَ بِكُلِّ سَحّ۪ارٍ عَلِيمࣲۖ", "words": [{"id": 1, "arabic": "يَاتُوكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِكُلِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَحّ۪ارٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 38, "text": "فَجُمِعَ اَ۬لسَّحَرَةُ لِمِيقَٰتِ يَوْمࣲ مَّعْلُومࣲۖ", "words": [{"id": 1, "arabic": "فَجُمِعَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لسَّحَرَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِمِيقَٰتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّعْلُومࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 39, "text": "وَقِيلَ لِلنَّاسِ هَلَ اَنتُم مُّجْتَمِعُونَ", "words": [{"id": 1, "arabic": "وَقِيلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلنَّاسِ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَنتُم", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّجْتَمِعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 40, "text": "لَعَلَّنَا نَتَّبِعُ اُ۬لسَّحَرَةَ إِن كَانُواْ هُمُ اُ۬لْغَٰلِبِينَۖ", "words": [{"id": 1, "arabic": "لَعَلَّنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَتَّبِعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لسَّحَرَةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْغَٰلِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 41, "text": "فَلَمَّا جَآءَ اَ۬لسَّحَرَةُ قَالُواْ لِفِرْعَوْنَ أَئِنَّ لَنَا لَأَجْراً اِن كُنَّا نَحْنُ اُ۬لْغَٰلِبِينَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّحَرَةُ", "translit": "", "root": ""}, {"id": 4, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لِفِرْعَوْنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَئِنَّ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "لَأَجْراً", "translit": "", "root": ""}, {"id": 9, "arabic": "اِن", "translit": "", "root": ""}, {"id": 10, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬لْغَٰلِبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 26, "ayah": 42, "text": "قَالَ نَعَمْ وَإِنَّكُمُۥٓ إِذاࣰ لَّمِنَ اَ۬لْمُقَرَّبِينَۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَعَمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَإِنَّكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّمِ