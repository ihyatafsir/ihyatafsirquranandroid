ic": "فَاسْتَفْتِهِمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَشَدُّ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلْقاً", "translit": "", "root": ""}, {"id": 5, "arabic": "اَم", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَلَقْنَآۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "خَلَقْنَٰهُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 11, "arabic": "طِينࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَّٰزِبِۢۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 12, "text": "بَلْ عَجِبْتَ وَيَسْخَرُونَۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَجِبْتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيَسْخَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 13, "text": "وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذُكِّرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَذْكُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 14, "text": "وَإِذَا رَأَوَاْ اٰيَةࣰ يَسْتَسْخِرُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَأَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْتَسْخِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 15, "text": "وَقَالُوٓاْ إِنْ هَٰذَآ إِلَّا سِحْرࣱ مُّبِينٌ", "words": [{"id": 1, "arabic": "وَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَآ", "