bic": "جَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِقَلْبࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "سَلِيمٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 85, "text": "اِذْ قَالَ لِأَبِيهِ وَقَوْمِهِۦ مَاذَا تَعْبُدُونَۖ", "words": [{"id": 1, "arabic": "اِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِأَبِيهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَقَوْمِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَاذَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَعْبُدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 86, "text": "أَئِفْكاً اٰلِهَةࣰ دُونَ اَ۬للَّهِ تُرِيدُونَۖ", "words": [{"id": 1, "arabic": "أَئِفْكاً", "translit": "", "root": ""}, {"id": 2, "arabic": "اٰلِهَةࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "دُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "تُرِيدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 87, "text": "فَمَا ظَنُّكُم بِرَبِّ اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ظَنُّكُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِرَبِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 88, "text": "فَنَظَرَ نَظْرَةࣰ فِے اِ۬لنُّجُومِ", "words": [{"id": 1, "arabic": "فَنَظَرَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَظْرَةࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لنُّجُومِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 89, "text": "فَقَالَ إِنِّے سَقِيمࣱ‏", "words": [{"id": 1, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "سَقِيمࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 90, "text": "فَتَوَلَّوْاْ عَنْهُ مُدْبِرِينَۖ", "words": [{"id": 1, "arabic": "فَتَوَلَّوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُدْبِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 91, "text": "فَرَاغَ إِلَيٰٓ ءَالِهَتِهِمْ فَقَالَ أَلَا تَاكُلُونَ", "words": [{"id": 1, "arabic": "فَرَاغَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَالِهَتِهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَقَالَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "تَاكُلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 92, "text": "مَا لَكُمْ لَا تَنطِقُونَۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَنطِقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 93, "text": "فَرَاغَ عَلَيْهِمْ ضَرْباَۢ بِالْيَمِينِ", "words": [{"id": 1, "arabic": "فَرَاغَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "ضَرْباَۢ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْيَمِينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 94, "text": "فَأَقْبَلُوٓاْ إِلَيْهِ يَزِفُّونَۖ", "words": [{"id": 1, "arabic": "فَأَقْبَلُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَزِفُّونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 95, "text": "قَالَ أَتَعْبُدُونَ مَا تَنْحِتُونَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَتَعْبُدُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَنْحِتُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 96, "text": "وَاللَّهُ خَلَقَكُمْ وَمَا تَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 97, "text": "قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناࣰ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۪بْنُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "بُنْيَٰناࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَلْقُوهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْجَحِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 98, "text": "فَأَرَادُواْ بِهِۦ كَيْداࣰ فَجَعَلْنَٰهُمُ اُ۬لَاسْفَلِينَۖ", "words": [{"id": 1, "arabic": "فَأَرَادُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَيْداࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَجَعَلْنَٰهُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَاسْفَلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 99, "text": "وَقَالَ إِنِّے ذَاهِبٌ اِلَيٰ رَبِّے سَيَهْدِينِۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَاهِبٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِلَيٰ", "translit": "