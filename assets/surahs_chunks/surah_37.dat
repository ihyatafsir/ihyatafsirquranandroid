 "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 75, "text": "وَلَقَدْ نَاد۪يٰنَا نُوحࣱ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَاد۪يٰنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلَنِعْمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُجِيبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 76, "text": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ", "words": [{"id": 1, "arabic": "وَنَجَّيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَأَهْلَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكَرْبِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْعَظِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 77, "text": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذُرِّيَّتَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْبَاقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 78, "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ", "words": [{"id": 1, "arabic": "وَتَرَكْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَاخِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 79, "text": "سَلَٰمٌ عَلَيٰ نُوحࣲ فِے اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "سَلَٰمٌ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "ا