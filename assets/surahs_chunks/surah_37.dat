sh"}, {"surah": 37, "ayah": 20, "text": "وَقَالُواْ يَٰوَيْلَنَا هَٰذَا يَوْمُ اُ۬لدِّينِۖ", "words": [{"id": 1, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَٰوَيْلَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لدِّينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 21, "text": "هَٰذَا يَوْمُ اُ۬لْفَصْلِ اِ۬لذِے كُنتُم بِهِۦ تُكَذِّبُونَۖ", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْفَصْلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لذِے", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتُم", "translit": "", "root": ""}, {"id": 6, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 7, "arabic": "تُكَذِّبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 22, "text": "۞اَ۟حْشُرُواْ اُ۬لذِينَ ظَلَمُواْ وَأَزْوَٰجَهُمْ وَمَا كَانُواْ يَعْبُدُونَ", "words": [{"id": 1, "arabic": "۞اَ۟حْشُرُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأَزْوَٰجَهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يَعْبُدُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 23, "text": "مِن دُونِ اِ۬للَّهِ فَاهْدُوهُمُۥٓ إِلَيٰ صِرَٰطِ اِ۬لْجَحِيمِۖ", "words": [{"id": 1, "arabic": "مِن", "translit": "", "root": ""}, {"id": 2, "arabic": "دُونِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَاهْدُوهُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيٰ", "translit": "", "root": ""}, 