ic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فَلْيَعْمَلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْعَٰمِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 62, "text": "أَذَٰلِكَ خَيْرࣱ نُّزُلاً اَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ", "words": [{"id": 1, "arabic": "أَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُّزُلاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "شَجَرَةُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لزَّقُّومِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 63, "text": "إِنَّا جَعَلْنَٰهَا فِتْنَةࣰ لِّلظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِتْنَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّلظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 64, "text": "إِنَّهَا شَجَرَةࣱ تَخْرُجُ فِےٓ أَصْلِ اِ۬لْجَحِيمِ", "words": [{"id": 1, "arabic": "إِنَّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "شَجَرَةࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَخْرُجُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَصْلِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْجَحِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 65, "text": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ", "words": [{"id": 1, "arabic": "طَلْعُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَأَنَّهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "رُءُوسُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لشَّيَٰطِينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 66, "text": "فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ", "words": [{"id": 1, "arabic": "فَإِنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَأٓكِلُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فَمَالِـُٔونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْبُطُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 67, "text": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباࣰ مِّنْ حَمِيمࣲۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَشَوْباࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَمِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 68, "text": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَي اَ۬لْجَحِيمِۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَرْجِعَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَإِلَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْجَحِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 69, "text": "إِنَّهُمُۥٓ أَلْفَوَاْ اٰبَآءَهُمْ ضَآلِّينَ", "words": [{"id": 1, "arabic": "إِنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَلْفَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰبَآءَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "ضَآلِّينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 70, "text": "فَهُمْ عَلَيٰٓ ءَاثٰ۪رِهِمْ يُهْرَعُونَۖ", "words": [{"id": 1, "arabic": "فَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَاثٰ۪رِهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُهْرَعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 71, "text": "وَلَقَد ضَّلَّ قَبْلَهُمُۥٓ أَكْثَرُ اُ۬لَاوَّلِينَۖ", "words": [{"id": 1, "arabic": "وَلَقَد", "translit": "", "root": ""}, {"id": 2, "arabic": "ضَّلَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَبْلَهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَكْثَرُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَاوَّلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 72, "text": "وَلَقَدَ اَرْسَلْنَا فِيهِم مُّنذِرِينَۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهِم", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّنذِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 73, "text": "فَانظُرْ كَيْفَ كَانَ عَٰقِبَةُ اُ۬لْمُنذَرِينَ", "words": [{"id": 1, "arabic": "فَانظُرْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَٰقِبَةُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْمُنذَرِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 74, "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "عِبَادَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْمُخْلَصِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 75, "text": "وَلَقَدْ نَاد۪يٰنَا نُوحࣱ فَلَنِعْمَ اَ۬لْمُجِيبُونَۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَاد۪يٰنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَلَنِعْمَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُجِيبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 76, "text": "وَنَجَّيْنَٰهُ وَأَهْلَهُۥ مِنَ اَ۬لْكَرْبِ اِ۬لْعَظِيمِۖ", "words": [{"id": 1, "arabic": "وَنَجَّيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَأَهْلَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْكَرْبِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْعَظِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 77, "text": "وَجَعَلْنَا ذُرِّيَّتَهُۥ هُمُ اُ۬لْبَاقِينَۖ", "words": [{"id": 1, "arabic": "وَجَعَلْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذُرِّيَّتَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْبَاقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 78, "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ", "words": [{"id": 1, "arabic": "وَتَرَكْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَاخِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 79, "text": "سَلَٰمٌ عَلَيٰ نُوحࣲ فِے اِ۬لْعَٰلَمِينَۖ", "words": [{"id": 1, "arabic": "سَلَٰمٌ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُوحࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْعَٰلَمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 80, "text": "إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَٰلِكَ", "translit": "", "root"