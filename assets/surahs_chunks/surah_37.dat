": 36, "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرࣲ مَّجْنُونِۢۖ", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَئِنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَتَارِكُوٓاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَالِهَتِنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لِشَاعِرࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّجْنُونِۢۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 37, "text": "بَلْ جَآءَ بِالْحَقِّ وَصَدَّقَ اَ۬لْمُرْسَلِينَۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْحَقِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَصَدَّقَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُرْسَلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 38, "text": "إِنَّكُمْ لَذَآئِقُواْ اُ۬لْعَذَابِ اِ۬لَالِيمِۖ", "words": [{"id": 1, "arabic": "إِنَّكُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَذَآئِقُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْعَذَابِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَالِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 39, "text": "وَمَا تُجْزَوْنَ إِلَّا مَا كُنتُمْ تَعْمَلُونَ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تُجْزَوْنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَعْمَلُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 40, "text": "إِلَّا عِبَادَ اَ۬للَّهِ اِ۬لْمُخْلَصِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "عِبَادَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْمُخْلَصِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 41, "text": "أُوْلَٰٓئِكَ لَهُمْ رِزْقࣱ مَّعْلُومࣱ‏", "words": [{"id": 1, "arabic": "أُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "رِزْقࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّعْلُومࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 42, "text": "فَوَٰكِهُۖ وَهُم مُّكْرَمُونَ", "words": [{"id": 1, "arabic": "فَوَٰكِهُۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّكْرَمُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 43, "text": "فِے جَنَّٰتِ اِ۬لنَّعِيمِ", "words": [{"id": 1, "arabic": "فِے", "translit": "", "root": ""}, {"id": 2, "arabic": "جَنَّٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لنَّعِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 44, "text": "عَلَيٰ سُرُرࣲ مُّتَقَٰبِلِينَۖ", "words": [{"id": 1, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "سُرُرࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُّتَقَٰبِلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 45, "text": "يُطَافُ عَلَيْهِم بِكَأْسࣲ مِّن مَّعِينِۢ", "words": [{"id": 1, "arabic": "يُطَافُ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِكَأْسࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّعِينِۢ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 46, "text": "بَيْضَآءَ لَذَّةࣲ لِّلشَّٰرِبِينَ", "words": [{"id": 1, "arabic": "بَيْضَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَذَّةࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِّلشَّٰرِبِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 47, "text": "لَا فِيهَا غَوْلࣱ وَلَا هُمْ عَنْهَا يُنزَفُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "غَوْلࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 5, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَنْهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يُنزَفُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 48, "text": "وَعِندَهُمْ قَٰصِرَٰتُ اُ۬لطَّرْفِ عِينࣱ‏", "words": [{"id": 1, "arabic": "وَعِندَهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَٰصِرَٰتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لطَّرْفِ", "translit": "", "root": ""}, {"id": 4, "arabic": "عِينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 49, "text": "كَأَنَّهُنَّ بَيْضࣱ مَّكْنُونࣱۖ", "words": [{"id": 1, "arabic": "كَأَنَّهُنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَيْضࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّكْنُونࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 50, "text": "فَأَقْبَلَ بَعْضُهُمْ عَلَيٰ بَعْضࣲ يَتَسَآءَلُونَۖ", "words": [{"id": 1, "arabic": "فَأَقْبَلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَعْضُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْضࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَتَسَآءَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 51, "text": "۞قَالَ قَآئِلࣱ مِّنْهُمُۥٓ إِنِّے كَانَ لِے قَرِينࣱ‏", "words": [{"id": 1, "arabic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَآئِلࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنْهُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 5, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِے", "translit": "", "root": ""}, {"id": 7, "arabic": "قَرِينࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 52, "text": "يَقُولُ أَ۟نَّكَ لَمِنَ اَ۬لْمُصَدِّقِينَ", "words": [{"id": 1, "arabic": "يَقُولُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَ۟نَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَمِنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُصَدِّقِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 53, "text": "أَ۟ذَا مِتْنَا وَكُنَّا تُرَاباࣰ وَعِظَٰماً اِنَّا لَمَدِينُونَۖ", "words": [{"id": 1, "arabic": "أَ۟ذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِتْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَكُنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "تُرَاباࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعِظَٰماً", "translit": "", "root": ""}, {"id": 6, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَمَدِينُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 54, "text": "قَالَ هَلَ اَنتُم مُّطَّلِعُونَ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَنتُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّطَّلِعُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 55, "text": "فَاطَّلَعَ فَر۪ء۪اهُ فِے سَوَآءِ اِ۬لْجَحِيمِۖ", "words": [{"id": 1, "arabic": "فَاطَّلَعَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَر۪ء۪اهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "سَوَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْجَحِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 56, "text": "قَالَ تَاللَّهِ إِن كِدتَّ لَتُرْدِينِۦ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تَاللَّهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِن", "translit": "", "root": ""}, {"id": 4, "arabic": "كِدتَّ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَتُرْدِينِۦ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 57, "text": "وَلَوْلَا نِعْمَةُ رَبِّے لَكُنتُ مِنَ اَ۬لْمُحْضَرِينَۖ", "words": [{"id": 1, "arabic": "وَلَوْلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نِعْمَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "لَكُنتُ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُحْضَرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 58, "text": "أَفَمَا نَحْنُ بِمَيِّتِينَ", "words": [{"id": 1, "arabic": "أَفَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِمَيِّتِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 59, "text": "إِلَّا مَوْتَتَنَا اَ۬لُاول۪يٰ وَمَا نَحْنُ بِمُعَذَّبِينَۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَوْتَتَنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لُاول۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِمُعَذَّبِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 60, "text": "إِنَّ هَٰذَا لَهُوَ اَ۬لْفَوْزُ اُ۬لْعَظِيمُۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْفَوْزُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْعَظِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 61, "text": "لِمِثْلِ هَٰذَا فَلْيَعْمَلِ اِ۬لْعَٰمِلُونَۖ", "words": [{"id": 1, "arabic": "لِمِثْلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فَلْيَعْمَلِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْعَٰمِلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 62, "text": "أَذَٰلِكَ خَيْرࣱ نُّزُلاً اَمْ شَجَرَةُ اُ۬لزَّقُّومِۖ", "words": [{"id": 1, "arabic": "أَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُّزُلاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اَمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "شَجَرَةُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لزَّقُّومِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 63, "text": "إِنَّا جَعَلْنَٰهَا فِتْنَةࣰ لِّلظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِتْنَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّلظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 64, "text": "إِنَّهَا شَجَرَةࣱ تَخْرُجُ فِےٓ أَصْلِ اِ۬لْجَحِيمِ", "words": [{"id": 1, "arabic": "إِنَّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "شَجَرَةࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَخْرُجُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِےٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَصْلِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْجَحِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 65, "text": "طَلْعُهَا كَأَنَّهُۥ رُءُوسُ اُ۬لشَّيَٰطِينِۖ", "words": [{"id": 1, "arabic": "طَلْعُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَأَنَّهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "رُءُوسُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لشَّيَٰطِينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 66, "text": "فَإِنَّهُمْ لَأٓكِلُونَ مِنْهَا فَمَالِـُٔونَ مِنْهَا اَ۬لْبُطُونَ", "words": [{"id": 1, "arabic": "فَإِنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَأٓكِلُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فَمَالِـُٔونَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنْهَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْبُطُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 67, "text": "ثُمَّ إِنَّ لَهُمْ عَلَيْهَا لَشَوْباࣰ مِّنْ حَمِيمࣲۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَلَيْهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَشَوْباࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَمِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 68, "text": "ثُمَّ إِنَّ مَرْجِعَهُمْ لَإِلَي اَ۬لْجَحِيمِۖ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَرْجِعَهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَإِلَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْجَحِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 69, "text": "إِنَّهُمُۥٓ أَلْفَوَاْ اٰبَآءَهُمْ ضَآلِّينَ", "words": [{"id": 1, "arabic": "إِنَّهُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَلْفَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰبَآءَهُمْ", "translit": "", "root": ""}, {"id