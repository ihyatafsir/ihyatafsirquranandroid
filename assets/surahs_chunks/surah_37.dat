urah": 37, "ayah": 97, "text": "قَالُواْ اُ۪بْنُواْ لَهُۥ بُنْيَٰناࣰ فَأَلْقُوهُ فِے اِ۬لْجَحِيمِ", "words": [{"id": 1, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۪بْنُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "بُنْيَٰناࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَلْقُوهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْجَحِيمِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 98, "text": "فَأَرَادُواْ بِهِۦ كَيْداࣰ فَجَعَلْنَٰهُمُ اُ۬لَاسْفَلِينَۖ", "words": [{"id": 1, "arabic": "فَأَرَادُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَيْداࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَجَعَلْنَٰهُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَاسْفَلِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 99, "text": "وَقَالَ إِنِّے ذَاهِبٌ اِلَيٰ رَبِّے سَيَهْدِينِۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَاهِبٌ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "رَبِّے", "translit": "", "root": ""}, {"id": 6, "arabic": "سَيَهْدِينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 100, "text": "رَبِّ هَبْ لِے مِنَ اَ۬لصَّٰلِحِينَۖ", "words": [{"id": 1, "arabic": "رَبِّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَبْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لصَّٰلِحِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 101, "text": "فَبَشَّرْنَٰهُ بِغُلَٰمٍ حَلِيمࣲۖ", "words": [{"id": 1, "arabic": "فَبَشَّرْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِغُلَٰمٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "حَلِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 102, "text": "فَلَمَّا بَلَغَ مَعَهُ اُ۬لسَّعْيَ قَالَ يَٰبُنَيِّ إِنِّيَ أَر۪يٰ فِے اِ۬لْمَنَامِ أَنِّيَ أَذْبَحُكَ فَانظُرْ مَاذَا تَر۪يٰۖ قَالَ يَٰٓأَبَتِ اِ۪فْعَلْ مَا تُومَرُۖ سَتَجِدُنِيَ إِن شَآءَ اَ۬للَّهُ مِنَ اَ۬لصَّٰبِرِينَۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلَغَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَعَهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لسَّعْيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَٰبُنَيِّ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَر۪يٰ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْمَنَامِ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَنِّيَ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَذْبَحُكَ", "translit": "", "root": ""}, {"id": 13, "arabic": "فَانظُرْ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَاذَا", "translit": "", "root": ""}, {"id": 15, "arabic": "تَر۪يٰۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 17, "arabic": "يَٰٓأَبَتِ", "translit": "", "root": ""}, {"id": 18, "arabic": "اِ۪فْعَلْ", "translit": "", "root": ""}, {"id": 19, "arabic": "مَا", "translit": "", "root": ""}, {"id": 20, "arabic": "تُومَرُۖ", "translit": "", "root": ""}, {"id": 21, "arabic": "سَتَجِدُنِيَ", "translit": "", "root": ""}, {"id": 22, "arabic": "إِن", "translit": "", "root": ""}, {"id": 23, "arabic": "شَآءَ", "translit": "", "root": ""}, {"id": 24, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 25, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 26, "arabic": "اَ۬لصَّٰبِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 103, "text": "فَلَمَّآ أَسْلَمَا وَتَلَّهُۥ لِلْجَبِينِ", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَسْلَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَتَلَّهُۥ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلْجَبِينِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 104, "text": "وَنَٰدَيْنَٰهُ أَنْ يَّٰٓإِبْرَٰهِيمُ", "words": [{"id": 1, "arabic": "وَنَٰدَيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَّٰٓإِبْرَٰهِيمُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 105, "text": "قَدْ صَدَّقْتَ اَ۬لرُّءْي۪آۖ إِنَّا كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "words": [{"id": 1, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَدَّقْتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لرُّءْي۪آۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "نَجْزِے", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْمُحْسِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 106, "text": "إِنَّ هَٰذَا لَهُوَ اَ۬لْبَلَٰٓؤُاْ اُ۬لْمُبِينُۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَهُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْبَلَٰٓؤُاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْمُبِينُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 107, "text": "وَفَدَيْنَٰهُ بِذِبْحٍ عَظِيمࣲۖ", "words": [{"id": 1, "arabic": "وَفَدَيْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِذِبْحٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَظِيمࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 108, "text": "وَتَرَكْنَا عَلَيْهِ فِے اِ۬لَاخِرِينَۖ", "words": [{"id": 1, "arabic": "وَتَرَكْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لَاخِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 109, "text": "سَلَٰمٌ عَلَيٰٓ إِبْرَٰهِيمَۖ", "words": [{"id": 1, "arabic": "سَلَٰمٌ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِبْرَٰهِيمَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 110, "text": "كَذَٰلِكَ نَجْزِے اِ۬لْمُحْسِنِينَۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَجْزِے", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لْمُحْسِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 111, "text": "إِنَّهُۥ مِنْ عِبَادِنَا اَ۬لْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عِبَادِنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 112, "text": "وَبَشَّرْنَٰهُ بِإِسْحَٰقَ نَبِيٓـٔاࣰ مِّنَ اَ۬لصَّٰلِحِينَ", "words": [{"id": 1, "arabic": "وَبَشَّرْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِإِسْحَٰقَ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَبِيٓـٔاࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لصَّٰلِحِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 113, "text": "وَبَٰرَكْنَا عَلَيْهِ وَعَلَيٰٓ إِسْحَٰقَۖ وَمِن ذُرِّيَّتِهِمَا مُحْسِنࣱ وَظَالِمࣱ لِّنَفْسِهِۦ مُب