, {"surah": 37, "ayah": 149, "text": "فَاسْتَفْتِهِمُۥٓ أَلِرَبِّكَ اَ۬لْبَنَاتُ وَلَهُمُ اُ۬لْبَنُونَۖ", "words": [{"id": 1, "arabic": "فَاسْتَفْتِهِمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَلِرَبِّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْبَنَاتُ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلَهُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْبَنُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 150, "text": "أَمْ خَلَقْنَا اَ۬لْمَلَٰٓئِكَةَ إِنَٰثاࣰ وَهُمْ شَٰهِدُونَۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْمَلَٰٓئِكَةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنَٰثاࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "شَٰهِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 151, "text": "أَلَآ إِنَّهُم مِّنِ اِفْكِهِمْ لَيَقُولُونَ", "words": [{"id": 1, "arabic": "أَلَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِفْكِهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَيَقُولُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 152, "text": "وَلَدَ اَ۬للَّهُ وَإِنَّهُمْ لَكَٰذِبُونَۖ", "words": [{"id": 1, "arabic": "وَلَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَإِنَّهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَكَٰذِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 153, "text": "أَصْطَفَي اَ۬لْبَنَاتِ عَلَي اَ۬لْبَنِينَۖ", "words": [{"id": 1, "arabic": "أَصْطَفَي", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْبَنَاتِ", "translit": "", "root": ""}, {"id