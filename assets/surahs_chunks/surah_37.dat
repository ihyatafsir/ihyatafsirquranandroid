ّا", "translit": "", "root": ""}, {"id": 4, "arabic": "غَٰوِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 33, "text": "فَإِنَّهُمْ يَوْمَئِذࣲ فِے اِ۬لْعَذَابِ مُشْتَرِكُونَۖ", "words": [{"id": 1, "arabic": "فَإِنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْعَذَابِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُشْتَرِكُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 34, "text": "إِنَّا كَذَٰلِكَ نَفْعَلُ بِالْمُجْرِمِينَۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "كَذَٰلِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَفْعَلُ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالْمُجْرِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 35, "text": "إِنَّهُمْ كَانُوٓاْ إِذَا قِيلَ لَهُمْ لَآ إِلَٰهَ إِلَّا اَ۬للَّهُ يَسْتَكْبِرُونَ", "words": [{"id": 1, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَٰهَ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَسْتَكْبِرُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 36, "text": "وَيَقُولُونَ أَئِنَّا لَتَارِكُوٓاْ ءَالِهَتِنَا لِشَاعِرࣲ مَّجْنُونِۢۖ", "words": [{"id": 1, "arabic": "وَيَقُولُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَئِنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "لَتَارِكُوٓاْ", "translit"