shVerses": [{"surah": 37, "ayah": 1, "text": "وَالصَّٰٓفَّٰتِ صَفّاࣰ‏", "words": [{"id": 1, "arabic": "وَالصَّٰٓفَّٰتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَفّاࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 2, "text": "فَالزَّٰجِرَٰتِ زَجْراࣰ‏", "words": [{"id": 1, "arabic": "فَالزَّٰجِرَٰتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "زَجْراࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 3, "text": "فَالتَّٰلِيَٰتِ ذِكْراً", "words": [{"id": 1, "arabic": "فَالتَّٰلِيَٰتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذِكْراً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 4, "text": "اِنَّ إِلَٰهَكُمْ لَوَٰحِدࣱۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَٰهَكُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَوَٰحِدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 5, "text": "رَّبُّ اُ۬لسَّمَٰوَٰتِ وَالَارْضِ وَمَا بَيْنَهُمَا وَرَبُّ اُ۬لْمَشَٰرِقِۖ", "words": [{"id": 1, "arabic": "رَّبُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لسَّمَٰوَٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنَهُمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "وَرَبُّ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لْمَشَٰرِقِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 6, "text": "إِنَّا زَيَّنَّا اَ۬لسَّمَآءَ اَ۬لدُّنْي۪ا بِزِينَةِ اِ۬لْكَوَاكِبِۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "زَيَّنَّا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 5, "arabic": "بِزِينَةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لْكَوَاكِبِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 7, "text": "وَحِفْظاࣰ مِّن كُلِّ شَيْطَٰنࣲ مَّارِدࣲۖ", "words": [{"id": 1, "arabic": "وَحِفْظاࣰ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 4, "arabic": "شَيْطَٰنࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّارِدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 8, "text": "لَّا يَسْمَعُونَ إِلَي اَ۬لْمَلَإِ اِ۬لَاعْل۪يٰ وَيُقْذَفُونَ مِن كُلِّ جَانِبࣲۖ", "words": [{"id": 1, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسْمَعُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَلَإِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لَاعْل۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيُقْذَفُونَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 9, "arabic": "جَانِبࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 9, "text": "دُحُوراࣰۖ وَلَهُمْ عَذَابࣱ وَاصِبٌ", "words": [{"id": 1, "arabic": "دُحُوراࣰۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَلَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَذَابࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَاصِبٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 10, "text": "اِلَّا مَنْ خَطِفَ اَ۬لْخَطْفَةَ فَأَتْبَعَهُۥ شِهَابࣱ ثَاقِبࣱۖ", "words": [{"id": 1, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "خَطِفَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْخَطْفَةَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَتْبَعَهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "شِهَابࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "ثَاقِبࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 11, "text": "فَاسْتَفْتِهِمُۥٓ أَهُمُۥٓ أَشَدُّ خَلْقاً اَم مَّنْ خَلَقْنَآۖ إِنَّا خَلَقْنَٰهُم مِّن طِينࣲ لَّٰزِبِۢۖ", "words": [{"id": 1, "arabic": "فَاسْتَفْتِهِمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَشَدُّ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلْقاً", "translit": "", "root": ""}, {"id": 5, "arabic": "اَم", "translit": "", "root": ""}, {"id": 6, "arabic": "مَّنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَلَقْنَآۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 9, "arabic": "خَلَقْنَٰهُم", "translit": "", "root": ""}, {"id": 10, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 11, "arabic": "طِينࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَّٰزِبِۢۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 12, "text": "بَلْ عَجِبْتَ وَيَسْخَرُونَۖ", "words": [{"id": 1, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَجِبْتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيَسْخَرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 13, "text": "وَإِذَا ذُكِّرُواْ لَا يَذْكُرُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "ذُكِّرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "", "root": ""}, {"id": 4, "arabic": "يَذْكُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 14, "text": "وَإِذَا رَأَوَاْ اٰيَةࣰ يَسْتَسْخِرُونَۖ", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَأَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَسْتَسْخِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 15, "text": "وَقَالُوٓاْ إِنْ هَٰذَآ إِلَّا سِحْرࣱ مُّبِينٌ", "words": [{"id": 1, "arabic": "وَقَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 3, "arabic": "هَٰذَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "سِحْرࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّبِينٌ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 16, "text": "اَ۟ذَا مِتْنَا وَكُنَّا تُرَاباࣰ وَعِظَٰماً اِنَّا لَمَبْعُوثُونَ", "words": [{"id": 1, "arabic": "اَ۟ذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مِتْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "وَكُنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "تُرَاباࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعِظَٰماً", "translit": "", "root": ""}, {"id": 6, "arabic": "اِنَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَمَبْعُوثُونَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 17, "text": "أَوَ ءَابَآؤُنَا اَ۬لَاوَّلُونَۖ", "words": [{"id": 1, "arabic": "أَوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ءَابَآؤُنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لَاوَّلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 18, "text": "قُلْ نَعَمْ وَأَنتُمْ دَٰخِرُونَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "نَعَمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَنتُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "دَٰخِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 37, "ayah": 19, "text": "فَإِنَّمَا هِيَ زَجْرَةࣱ وَٰحِدَةࣱ فَإِذَا هُمْ يَنظُرُونَۖ", "words": [{"id": 1, "arabic": "فَإِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 3, "arabic": "زَجْرَةࣱ", "translit": ""