{"surah": 95, "verses": [{"ayah": 1, "text": "وَٱلتِّينِ وَٱلزَّيْتُونِ ", "translation": "By the fig and the olive[1]", "words": [{"id": 1, "arabic": "وَٱلتِّينِ", "translit": "ِnyِّtlٱَw", "root": "تين"}, {"id": 2, "arabic": "وَٱلزَّيْتُونِ", "translit": "ِnwُtْyَّzlٱَw", "root": "زيت"}], "hasIhya": false}, {"ayah": 2, "text": "وَطُورِ سِينِينَ ", "translation": "And [by] Mount Sinai", "words": [{"id": 1, "arabic": "وَطُورِ", "translit": "ِrwُṭَw", "root": "طور"}, {"id": 2, "arabic": "سِينِينَ", "translit": "َnyِnyِs", "root": ""}], "hasIhya": false}, {"ayah": 3, "text": "وَهَٰذَا ٱلْبَلَدِ ٱلْأَمِينِ ", "translation": "And [by] this secure city [i.e., Makkah],", "words": [{"id": 1, "arabic": "وَهَٰذَا", "translit": "āَhdَٰhَw", "root": ""}, {"id": 2, "arabic": "ٱلْبَلَدِ", "translit": "ِdَlَbْlٱ", "root": "بلد"}, {"id": 3, "arabic": "ٱلْأَمِينِ", "translit": "ِnyِmَaʾْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 4, "text": "لَقَدْ خَلَقْنَا ٱلْإِنسَٰنَ فِىٓ أَحْسَنِ تَقْوِيمٍ ", "translation": "We have certainly created man in the best of stature;[1]", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "خَلَقْنَا", "translit": "āَnْqَlَhk", "root": "خلق"}, {"id": 3, "arabic": "ٱلْإِنسَٰنَ", "translit": "َnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 4, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 5, "arabic": "أَحْسَنِ", "translit": "ِnَsْḥَaʾ", "root": "حسن"}, {"id": 6, "arabic": "تَقْوِيمٍ", "translit": "ٍmyِwْqَt", "root": "قوم"}], "hasIhya": true}, {"ayah": 5, "text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ ", "translation": "Then We return him to the lowest of the low,[1]", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "رَدَدْنَٰهُ", "translit": "ُhَٰnْdَdَr", "root": "ردد"}, {"id": 3, "arabic": "أَسْفَلَ", "translit": "َlَfْsَaʾ", "root": "سفل"}, {"id": 4, "arabic": "سَٰفِلِينَ", "translit": "َnyِlِfَٰs", "root": "سفل"}], "hasIhya": false}, {"ayah": 6, "text": "إِلَّا ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ فَلَهُمْ أَجْرٌ غَيْرُ مَمْنُونٍ ", "translation": "Except for those who believe and do righteous deeds, for they will have a reward uninterrupted.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "فَلَهُمْ", "translit": "ْmُhَlَf", "root": ""}, {"id": 7, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 8, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 9, "arabic": "مَمْنُونٍ", "translit": "ٍnwُnْmَm", "root": "منن"}], "hasIhya": false}, {"ayah": 7, "text": "فَمَا يُكَذِّبُكَ بَعْدُ بِٱلدِّينِ ", "translation": "So what yet causes you to deny the Recompense?[1]", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "يُكَذِّبُكَ", "translit": "َkُbِّhdَkُy", "root": "كذب"}, {"id": 3, "arabic": "بَعْدُ", "translit": "ُdْʿعَb", "root": "بعد"}, {"id": 4, "arabic": "بِٱلدِّينِ", "translit": "ِnyِّdlٱِb", "root": "دين"}], "hasIhya": false}, {"ayah": 8, "text": "أَلَيْسَ ٱللَّهُ بِأَحْكَمِ ٱلْحَٰكِمِينَ ", "translation": "Is not Allāh the most just of judges?", "words": [{"id": 1, "arabic": "أَلَيْسَ", "translit": "َsْyَlَaʾ", "root": "ليس"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "بِأَحْكَمِ", "translit": "ِmَkْḥَaʾِb", "root": "حكم"}, {"id": 4, "arabic": "ٱلْحَٰكِمِينَ", "translit": "َnyِmِkَٰḥْlٱ", "root": "حكم"}], "hasIhya": false}], "tafsir": {"4": [{"arabic": "استعماله في نيل درجة القرب وعن بعدهم وقربهم عبر الله تعالى إذ قال {لقد خلقنا الإنسان في أحسن تقويم ثم رددناه أسفل سافلين إلا الذين آمنوا} الآية فإذن نعم الله تعالى آلات يترقى العبد بها عن أسفل السافلين خلقها الله تعالى لأجل العبد حتى ينال بها سعادة القرب والله تعالى غني عنه قرب أم بعد والعبد فيها بين أن يستعملها في الطاعة فيكون قد شكر لموافقة محبة مولاه وبين أن يستعملها في معصيته فقد كفر لاقتحامه ما يكرهه مولاه ولا يرضاه له فإن الله لا يرضى لعباده الكفر والمعصية وإن عطلها ولم يستعملها في طاعة ولا معصية فهو أيضا كفر كفران إن للنعمة بالتضييع وكل ما خلق في الدنيا إنما خلق آلة للعبد ل", "english": "The hadith has already been presented in the Book of Repentance, and before that in the Book of Supplications. That was because of his ascent to seventy stations, some of which are above others. Its beginning — even though it surpassed the utmost limits of [all] creatures — was nevertheless a deficiency relative to its end. Thus his seeking forgiveness was for that [deficiency]. And when ʿĀʾishah, may God be pleased with her, said: \"Has God not forgiven you what preceded of your sin and what came after? Then what is this weeping in prostration, and what is this severe exertion?\" — PageV04P087 — he {said}: \"Shall I not then be a grateful servant?\" // The hadith of ʿĀʾishah, when she said to him: \"God has forgiven you what preceded of your sin and what came after — so what is this weeping?\" — the hadith was narrated by Abū al-Shaykh, and it is the remainder of the hadith of ʿAṭāʾ from her, which preceded this by nine hadiths. It is also in Muslim from the narration of ʿUrwah from her, in abbreviated form. Likewise it is in the Two Ṣaḥīḥs, abbreviated, from the hadith of al-Mughīrah ibn Shuʿbah. Its meaning is: \"Shall I not be a seeker of increase in the stations?\" — for gratitude is the cause of increase, as God Most High said: {«لئن شكرتم لأزيدنكم»} [\"If you are grateful, I will surely increase you\"].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 980", "section_title_en": "The Reality of Gratitude and Ingratitude — The Parable of the King and the Servant", "section_index": 980, "anchors": "- Root: شكر (sh-k-r)\n  * Lisan / Ayn: Core meaning of \"opening/disclosing\" (kashf) — the opposite of kufr, which is \"covering/concealing\"; also linked to a full udder (shukrā), i.e., abundance and fullness.\n  * Al-Raghib (Mufradat): Gratitude is \"the conceptualization of the blessing and its manifestation\" — threefold: gratitude of the heart (perceiving the blessing), of the tongue (praising the Bestower), and of the limbs (rewarding the blessing through obedience).\n  * Al-Zamakhshari (Asas): Literal (haqīqah): \"I thanked God for His blessing.\" Metaphorical (majāz): A beast that suffices on little fodder yet fattens — gratitude as efficient use of provision for its intended purpose.\n- Root: عبد (ʿ-b-d)\n  * Lisan / Ayn: Servitude as manifest humility; ʿibādah is the utmost degree of self-abasement before the One deserving ultimate beneficence.\n  * Al-Raghib (Mufradat): ʿUbūdiyyah is \"displaying humility,\" while ʿibādah is its extreme — and is of two kinds: by compulsion (all creatures) and by choice (the rational, who are commanded to worship).\n  * Al-Zamakhshari (Asas): Literal: \"He is a servant (ʿabd) between servitude.\" Metaphorical: \"So-and-so has enslaved me (taʿabbadanī)\" — making one like a servant.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Originary estimation and measuring out (taqdīr) — creation as precise ordainment.\n  * Al-Raghib (Mufradat): \"Creation is originally: precise estimation (al-taqdīr al-mustaqīm)\" — used for bringing forth from nothing (ibdāʿ) and for fashioning from existing matter.\n  * Al-Zamakhshari (Asas): Literal: The leatherworker \"estimates\" (khalq) the hide before cutting. Metaphorical: \"God created the creation\" — brought them into being upon an estimation necessitated by wisdom.\n- Root: قرب (q-r-b)\n  * Lisan / Ayn: Nearness in place or station; the opposite of buʿd (distance).\n  * Al-Raghib (Mufradat): Nearness to God is not spatial but by rank, honor, and obedience — the soul's proximity to the divine presence through virtuous acts.\n  * Al-Zamakhshari (Asas): Literal: physical proximity. Metaphorical: \"nearness to the King\" — honor and favor, not spatial contiguity.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"إنما الشرع كله تعريف طريق\" restricts the entire purpose of the Sacred Law to one function: defining the path. Also, conditional and bipartite clauses (al-sharṭ wa al-jawāb) governing \"مهما لبس العبد الثوب... فقد شكر\" — the protasis-apodosis structure establishing a causal equivalence between action and its moral verdict.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 250, 1495], [2, 1495, 3182]], "2": [[1, 250, 1492], [2, 1492, 2921]], "3": [[1, 250, 1333], [2, 1333, 2159], [3, 2159, 3312]], "4": [[1, 400, 1222], [2, 1222, 2699], [3, 2699, 4190], [4, 4190, 5357], [5, 5357, 6405], [6, 6405, 7952]], "5": [[1, 350, 1231], [2, 1231, 2658], [3, 2658, 3725], [4, 3725, 5278]], "6": [[1, 400, 1254], [2, 1254, 2315], [3, 2315, 3723], [4, 3723, 5188], [5, 5188, 6822], [6, 6822, 7554], [7, 7554, 8202], [8, 8202, 8878], [9, 8878, 9911]], "7": [[1, 350, 1100], [2, 1100, 2438], [3, 2438, 3105], [4, 3105, 4469]], "8": [[1, 350, 1311], [2, 1311, 2102], [3, 2102, 3163], [4, 3163, 4678]]}, "minshawi": {"1": [[1, 310, 1754], [2, 1754, 3620]], "2": [[1, 220, 1413], [2, 1413, 2750]], "3": [[1, 180, 1620], [2, 1620, 2421], [3, 2421, 3700]], "4": [[1, 270, 1039], [2, 1039, 2668], [3, 2668, 4103], [4, 4103, 5905], [5, 5905, 6872], [6, 6872, 8710]], "5": [[1, 410, 1357], [2, 1357, 3079], [3, 3079, 4313], [4, 4313, 6430]], "6": [[1, 210, 1299], [2, 1299, 2572], [3, 2572, 4616], [4, 4616, 6689], [5, 6689, 8476], [6, 8476, 9228], [7, 9228, 9903], [8, 9903, 10626], [9, 10626, 11860]], "7": [[1, 400, 1419], [2, 1419, 3008], [3, 3008, 3713], [4, 3713, 5340]], "8": [[1, 130, 1340], [2, 1340, 2327], [3, 2327, 3635], [4, 3635, 5790]]}, "abdulbasit_warsh": {"95:1": [[1, 445, 1875], [2, 1875, 4945]], "1": [[1, 445, 1875], [2, 1875, 4945]], "95:2": [[1, 379, 1740], [2, 1740, 4213]], "2": [[1, 379, 1740], [2, 1740, 4213]], "95:3": [[1, 431, 1507], [2, 1507, 2560], [3, 2560, 4788]], "3": [[1, 431, 1507], [2, 1507, 2560], [3, 2560, 4788]], "95:4": [[1, 600, 1316], [2, 1316, 2605], [3, 2605, 4839], [4, 4839, 5505], [5, 5505, 6758], [6, 6758, 9594]], "4": [[1, 600, 1316], [2, 1316, 2605], [3, 2605, 4839], [4, 4839, 5505], [5, 5505, 6758], [6, 6758, 9594]], "95:5": [[1, 600, 1311], [2, 1311, 2945], [3, 2945, 4307], [4, 4307, 7322]], "5": [[1, 600, 1311], [2, 1311, 2945], [3, 2945, 4307], [4, 4307, 7322]], "95:6": [[1, 600, 1995], [2, 1995, 3502], [3, 3502, 5155], [4, 5155, 6899], [5, 6899, 9318], [6, 9318, 10822], [7, 10822, 11839], [8, 11839, 12656], [9, 12656, 15315]], "6": [[1, 600, 1995], [2, 1995, 3502], [3, 3502, 5155], [4, 5155, 6899], [5, 6899, 9318], [6, 9318, 10822], [7, 10822, 11839], [8, 11839, 12656], [9, 12656, 15315]], "95:7": [[1, 565, 1257], [2, 1257, 2672], [3, 2672, 3301], [4, 3301, 6277]], "7": [[1, 565, 1257], [2, 1257, 2672], [3, 2672, 3301], [4, 3301, 6277]], "95:8": [[1, 591, 1505], [2, 1505, 2500], [3, 2500, 3499], [4, 3499, 6564]], "8": [[1, 591, 1505], [2, 1505, 2500], [3, 2500, 3499], [4, 3499, 6564]]}}, "letterTiming": {"abdulbasit": {"95:1": [{"wordIdx": 0, "charIdx": 0, "char": "و", "grapheme": "وَ", "start": 250, "end": 515, "duration": 265, "peakTime": 382}, {"wordIdx": 0, "charIdx": 1, "char": "ٱ", "grapheme": "ٱ", "start": 515, "end": 568, "duration": 53, "peakTime": 542}, {"wordIdx": 0, "charIdx": 2, "char": "ل", "grapheme": "ل", "start": 568, "end": 745, "duration": 177, "peakTime": 656}, {"wordIdx": 0, "charIdx": 3, "char": "ت", "grapheme": "تِّ", "start": 745, "end": 1054, "duration": 309, "peakTime": 900}, {"wordIdx": 0, "charIdx": 4, "char": "ي", "grapheme": "ي", "start": 1054, "end": 1319, "duration": 265, "peakTime": 1186}, {"wordIdx"