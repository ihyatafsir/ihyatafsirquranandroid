ic": "تَقْوِيمࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 95, "ayah": 5, "text": "ثُمَّ رَدَدْنَٰهُ أَسْفَلَ سَٰفِلِينَ", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَدَدْنَٰهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَسْفَلَ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَٰفِلِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 95, "ayah": 6, "text": "إِلَّا اَ۬لذِينَ ءَامَنُواْ وَعَمِلُواْ اُ۬لصَّٰلِحَٰتِ فَلَهُمُۥٓ أَجْرٌ غَيْرُ مَمْنُونࣲۖ", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَعَمِلُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لصَّٰلِحَٰتِ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَلَهُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَجْرٌ", "translit": "", "root": ""}, {"id": 8, "arabic": "غَيْرُ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَمْنُونࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 95, "ayah": 7, "text": "فَمَا يُكَذِّبُكَ بَعْدُ بِالدِّينِۖ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُكَذِّبُكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَعْدُ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالدِّينِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 95, "ayah": 8, "text": "أَلَيْسَ اَ۬للَّهُ بِأَحْكَمِ اِ۬لْحَٰكِمِينَۖ", "words": [{"id": 1, "arabic": "أَلَيْسَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِأَحْكَمِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْحَٰكِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}]}