, "root": ""}, {"id": 16, "arabic": "فَلْيَتَوَكَّلِ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِ۬لْمُتَوَكِّلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 13, "text": "وَقَالَ اَ۬لذِينَ كَفَرُواْ لِرُسُلِهِمْ لَنُخْرِجَنَّكُم مِّنَ اَرْضِنَآ أَوْ لَتَعُودُنَّ فِے مِلَّتِنَاۖ فَأَوْح۪يٰٓ إِلَيْهِمْ رَبُّهُمْ لَنُهْلِكَنَّ اَ۬لظَّٰلِمِينَ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِرُسُلِهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَنُخْرِجَنَّكُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَرْضِنَآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَتَعُودُنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِے", "translit": "", "root": ""}, {"id": 11, "arabic": "مِلَّتِنَاۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَأَوْح۪يٰٓ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِلَيْهِمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "رَبُّهُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "لَنُهْلِكَنَّ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لظَّٰلِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 14, "text": "وَلَنُسْكِنَنَّكُمُ اُ۬لَارْضَ مِنۢ بَعْدِهِمْۖ ذَٰلِكَ لِمَنْ خَافَ مَقَامِے وَخَافَ وَعِيدِۖۦ", "words": [{"id": 1, "arabic": "وَلَنُسْكِنَنَّكُمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لَارْضَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 4, "arabic": "بَعْدِهِمْۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "لِمَنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "خَافَ", "translit":