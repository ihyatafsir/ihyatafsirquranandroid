عْدِهِۦ رُسُلَهُۥٓۖ إِنَّ اَ۬للَّهَ عَزِيزࣱ ذُو اُ۪نتِقَامࣲۖ", "words": [{"id": 1, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَحْسِبَنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُخْلِفَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَعْدِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "رُسُلَهُۥٓۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَزِيزࣱ", "translit": "", "root": ""}, {"id": 10, "arabic": "ذُو", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۪نتِقَامࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 48, "text": "يَوْمَ تُبَدَّلُ اُ۬لَارْضُ غَيْرَ اَ۬لَارْضِ وَالسَّمَٰوَٰتُۖ وَبَرَزُواْ لِلهِ اِ۬لْوَٰحِدِ اِ۬لْقَهّ۪ارِۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تُبَدَّلُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لَارْضُ", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لَارْضِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَالسَّمَٰوَٰتُۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَبَرَزُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِلهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لْوَٰحِدِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْقَهّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 49, "text": "وَتَرَي اَ۬لْمُجْرِمِينَ يَوْمَئِذࣲ مُّقَرَّنِينَ فِے اِ۬لَاصْفَادِ", "words": [{"id": 1, "arabic": "وَتَرَي", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمُجْرِمِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّقَرَّنِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لَاصْفَادِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 50, "text": "سَرَابِيلُهُم مِّن قَطِرَانࣲ وَتَغْش۪يٰ وُجُوهَهُمُ اُ۬لنَّارُ", "words": [{"id": 1, "arabic": "سَرَابِيلُهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "قَطِرَانࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَتَغْش۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وُجُوهَهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لنَّارُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 51, "text": "لِيَجْزِيَ اَ۬للَّهُ كُلَّ نَفْسࣲ مَّا كَسَبَتِۖ اِنَّ اَ۬للَّهَ سَرِيعُ اُ۬لْحِسَابِۖ", "words": [{"id": 1, "arabic": "لِيَجْزِيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَفْسࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَسَبَتِۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَرِيعُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْحِسَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 52, "text": "هَٰذَا بَلَٰغࣱ لِّلنَّاسِ وَلِيُنذَرُواْ بِهِۦ وَلِيَعْلَمُوٓاْ أَنَّمَا هُوَ إِلَٰهࣱ وَٰحِدࣱ وَلِيَذَّكَّرَ أُوْلُواْ اُ۬لَالْبَٰبِۖ", "words": [{"id": 1, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "بَلَٰغࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِّلنَّاسِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَلِيُنذَرُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلِيَعْلَمُوٓاْ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَنَّمَا", "translit": "", "root": ""},