 "ayah": 43, "text": "مُهْطِعِينَ مُقْنِعِے رُءُوسِهِمْ لَا يَرْتَدُّ إِلَيْهِمْ طَرْفُهُمْ وَأَفْـِٕدَتُهُمْ هَوَآءࣱۖ", "words": [{"id": 1, "arabic": "مُهْطِعِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مُقْنِعِے", "translit": "", "root": ""}, {"id": 3, "arabic": "رُءُوسِهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "", "root": ""}, {"id": 5, "arabic": "يَرْتَدُّ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَيْهِمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "طَرْفُهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَأَفْـِٕدَتُهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "هَوَآءࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 44, "text": "وَأَنذِرِ اِ۬لنَّاسَ يَوْمَ يَاتِيهِمُ اُ۬لْعَذَابُ فَيَقُولُ اُ۬لذِينَ ظَلَمُواْ رَبَّنَآ أَخِّرْنَآ إِلَيٰٓ أَجَلࣲ قَرِيبࣲ نُّجِبْ دَعْوَتَكَ وَنَتَّبِعِ اِ۬لرُّسُلَۖ أَوَلَمْ تَكُونُوٓاْ أَقْسَمْتُم مِّن قَبْلُ مَا لَكُم مِّن زَوَالࣲۖ", "words": [{"id": 1, "arabic": "وَأَنذِرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لنَّاسَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَاتِيهِمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْعَذَابُ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَيَقُولُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 8, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبَّنَآ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَخِّرْنَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَجَلࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "قَرِيبࣲ", "translit": "", "root": ""}, {"id": 14, "arabic": "نُّجِبْ", "translit": "", "root": ""}, {"id": 15, "arabic": "دَعْوَتَكَ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَنَتَّبِعِ", "translit