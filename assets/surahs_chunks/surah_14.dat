14, "ayah": 44, "text": "وَأَنذِرِ اِ۬لنَّاسَ يَوْمَ يَاتِيهِمُ اُ۬لْعَذَابُ فَيَقُولُ اُ۬لذِينَ ظَلَمُواْ رَبَّنَآ أَخِّرْنَآ إِلَيٰٓ أَجَلࣲ قَرِيبࣲ نُّجِبْ دَعْوَتَكَ وَنَتَّبِعِ اِ۬لرُّسُلَۖ أَوَلَمْ تَكُونُوٓاْ أَقْسَمْتُم مِّن قَبْلُ مَا لَكُم مِّن زَوَالࣲۖ", "words": [{"id": 1, "arabic": "وَأَنذِرِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لنَّاسَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَاتِيهِمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْعَذَابُ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَيَقُولُ", "translit": "", "root": ""}, {"id": 7, "arabic": "اُ۬لذِينَ", "translit": "", "root": ""}, {"id": 8, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبَّنَآ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَخِّرْنَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "إِلَيٰٓ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَجَلࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "قَرِيبࣲ", "translit": "", "root": ""}, {"id": 14, "arabic": "نُّجِبْ", "translit": "", "root": ""}, {"id": 15, "arabic": "دَعْوَتَكَ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَنَتَّبِعِ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِ۬لرُّسُلَۖ", "translit": "", "root": ""}, {"id": 18, "arabic": "أَوَلَمْ", "translit": "", "root": ""}, {"id": 19, "arabic": "تَكُونُوٓاْ", "translit": "", "root": ""}, {"id": 20, "arabic": "أَقْسَمْتُم", "translit": "", "root": ""}, {"id": 21, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 22, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 23, "arabic": "مَا", "translit": "", "root": ""}, {"id": 24, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 25, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 26, "arabic": "زَوَالࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 45, "text": "وَسَكَنتُمْ فِے مَسَٰكِنِ اِ۬لذِينَ ظَلَمُو