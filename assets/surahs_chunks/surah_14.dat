 "", "root": ""}, {"id": 16, "arabic": "بَعِيدࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 4, "text": "وَمَآ أَرْسَلْنَا مِن رَّسُولٍ اِلَّا بِلِسَانِ قَوْمِهِۦ لِيُبَيِّنَ لَهُمْۖ فَيُضِلُّ اُ۬للَّهُ مَنْ يَّشَآءُ وَيَهْدِے مَنْ يَّشَآءُۖ وَهُوَ اَ۬لْعَزِيزُ اُ۬لْحَكِيمُۖ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "رَّسُولٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "بِلِسَانِ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْمِهِۦ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِيُبَيِّنَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَهُمْۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَيُضِلُّ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَّشَآءُ", "translit": "", "root": ""}, {"id": 14, "arabic": "وَيَهْدِے", "translit": "", "root": ""}, {"id": 15, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 16, "arabic": "يَّشَآءُۖ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬لْعَزِيزُ", "translit": "", "root": ""}, {"id": 19, "arabic": "اُ۬لْحَكِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 5, "text": "وَلَقَدَ اَرْسَلْنَا مُوس۪يٰ بِـَٔايَٰتِنَآ أَنَ اَخْرِجْ قَوْمَكَ مِنَ اَ۬لظُّلُمَٰتِ إِلَي اَ۬لنُّورِ وَذَكِّرْهُم بِأَييَّٰمِ اِ۬للَّهِۖ إِنَّ فِے ذَٰلِكَ لَأٓيَٰتࣲ لِّكُلِّ صَبّ۪ارࣲ شَكُورࣲۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مُوس۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِـَٔايَٰتِنَآ", "transl