َٰوَٰتُۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَبَرَزُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِلهِ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لْوَٰحِدِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْقَهّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 49, "text": "وَتَرَي اَ۬لْمُجْرِمِينَ يَوْمَئِذࣲ مُّقَرَّنِينَ فِے اِ۬لَاصْفَادِ", "words": [{"id": 1, "arabic": "وَتَرَي", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمُجْرِمِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّقَرَّنِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "فِے", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لَاصْفَادِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 50, "text": "سَرَابِيلُهُم مِّن قَطِرَانࣲ وَتَغْش۪يٰ وُجُوهَهُمُ اُ۬لنَّارُ", "words": [{"id": 1, "arabic": "سَرَابِيلُهُم", "translit": "", "root": ""}, {"id": 2, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 3, "arabic": "قَطِرَانࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَتَغْش۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "وُجُوهَهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لنَّارُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 14, "ayah": 51, "text": "لِيَجْزِيَ اَ۬للَّهُ كُلَّ نَفْسࣲ مَّا كَسَبَتِۖ اِنَّ اَ۬للَّهَ سَرِيعُ اُ۬لْحِسَابِۖ", "words": [{"id": 1, "arabic": "لِيَجْزِيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَفْسࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَسَبَتِۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَرِيعُ", "tran