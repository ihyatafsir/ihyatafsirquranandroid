{"surah": 89, "verses": [{"ayah": 1, "text": "وَٱلْفَجْرِ ", "translation": "By the dawn", "words": [{"id": 1, "arabic": "وَٱلْفَجْرِ", "translit": "ِrْjgَfْlٱَw", "root": "فجر"}], "hasIhya": false}, {"ayah": 2, "text": "وَلَيَالٍ عَشْرٍ ", "translation": "And [by] ten nights[1]", "words": [{"id": 1, "arabic": "وَلَيَالٍ", "translit": "ٍlāَyَlَw", "root": "ليل"}, {"id": 2, "arabic": "عَشْرٍ", "translit": "ٍrْhsَʿع", "root": "عشر"}], "hasIhya": false}, {"ayah": 3, "text": "وَٱلشَّفْعِ وَٱلْوَتْرِ ", "translation": "And [by] the even [number] and the odd", "words": [{"id": 1, "arabic": "وَٱلشَّفْعِ", "translit": "ِʿعْfَّhslٱَw", "root": "شفع"}, {"id": 2, "arabic": "وَٱلْوَتْرِ", "translit": "ِrْtَwْlٱَw", "root": "وتر"}], "hasIhya": false}, {"ayah": 4, "text": "وَٱلَّيْلِ إِذَا يَسْرِ ", "translation": "And [by] the night when it passes,", "words": [{"id": 1, "arabic": "وَٱلَّيْلِ", "translit": "ِlْyَّlٱَw", "root": "ليل"}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "يَسْرِ", "translit": "ِrْsَy", "root": "سري"}], "hasIhya": false}, {"ayah": 5, "text": "هَلْ فِى ذَٰلِكَ قَسَمٌ لِّذِى حِجْرٍ ", "translation": "Is there [not] in [all] that an oath [sufficient] for one of perception?[1]", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 4, "arabic": "قَسَمٌ", "translit": "ٌmَsَq", "root": "قسم"}, {"id": 5, "arabic": "لِّذِى", "translit": "àِhdِّl", "root": ""}, {"id": 6, "arabic": "حِجْرٍ", "translit": "ٍrْjgِḥ", "root": "حجر"}], "hasIhya": false}, {"ayah": 6, "text": "أَلَمْ تَرَ كَيْفَ فَعَلَ رَبُّكَ بِعَادٍ ", "translation": "Have you not considered how your Lord dealt with ʿAad -", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 4, "arabic": "فَعَلَ", "translit": "َlَʿعَf", "root": "فعل"}, {"id": 5, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 6, "arabic": "بِعَادٍ", "translit": "ٍdāَʿعِb", "root": "عود"}], "hasIhya": true}, {"ayah": 7, "text": "إِرَمَ ذَاتِ ٱلْعِمَادِ ", "translation": "[With] Iram[1] - who had lofty pillars,[2]", "words": [{"id": 1, "arabic": "إِرَمَ", "translit": "َmَrِiʾ", "root": ""}, {"id": 2, "arabic": "ذَاتِ", "translit": "ِtāَhd", "root": ""}, {"id": 3, "arabic": "ٱلْعِمَادِ", "translit": "ِdāَmِʿعْlٱ", "root": "عمد"}], "hasIhya": false}, {"ayah": 8, "text": "ٱلَّتِى لَمْ يُخْلَقْ مِثْلُهَا فِى ٱلْبِلَٰدِ ", "translation": "The likes of whom had never been created in the land?", "words": [{"id": 1, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 2, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 3, "arabic": "يُخْلَقْ", "translit": "ْqَlْhkُy", "root": "خلق"}, {"id": 4, "arabic": "مِثْلُهَا", "translit": "āَhُlْhtِm", "root": "مثل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْبِلَٰدِ", "translit": "ِdَٰlِbْlٱ", "root": "بلد"}], "hasIhya": false}, {"ayah": 9, "text": "وَثَمُودَ ٱلَّذِينَ جَابُوا۟ ٱلصَّخْرَ بِٱلْوَادِ ", "translation": "And [with] Thamūd, who carved out the rocks in the valley?", "words": [{"id": 1, "arabic": "وَثَمُودَ", "translit": "َdwُmَhtَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَابُوا۟", "translit": "۟āwُbāَjg", "root": "جوب"}, {"id": 4, "arabic": "ٱلصَّخْرَ", "translit": "َrْhkَّṣlٱ", "root": "صخر"}, {"id": 5, "arabic": "بِٱلْوَادِ", "translit": "ِdāَwْlٱِb", "root": "ودي"}], "hasIhya": false}, {"ayah": 10, "text": "وَفِرْعَوْنَ ذِى ٱلْأَوْتَادِ ", "translation": "And [with] Pharaoh, owner of the stakes?[1]", "words": [{"id": 1, "arabic": "وَفِرْعَوْنَ", "translit": "َnْwَʿعْrِfَw", "root": ""}, {"id": 2, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 3, "arabic": "ٱلْأَوْتَادِ", "translit": "ِdāَtْwَaʾْlٱ", "root": "وتد"}], "hasIhya": false}, {"ayah": 11, "text": "ٱلَّذِينَ طَغَوْا۟ فِى ٱلْبِلَٰدِ ", "translation": "[All of] whom oppressed within the lands", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "طَغَوْا۟", "translit": "۟āْwَغَṭ", "root": "طغي"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْبِلَٰدِ", "translit": "ِdَٰlِbْlٱ", "root": "بلد"}], "hasIhya": false}, {"ayah": 12, "text": "فَأَكْثَرُوا۟ فِيهَا ٱلْفَسَادَ ", "translation": "And increased therein the corruption.", "words": [{"id": 1, "arabic": "فَأَكْثَرُوا۟", "translit": "۟āwُrَhtْkَaʾَf", "root": "كثر"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "ٱلْفَسَادَ", "translit": "َdāَsَfْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 13, "text": "فَصَبَّ عَلَيْهِمْ رَبُّكَ سَوْطَ عَذَابٍ ", "translation": "So your Lord poured upon them a scourge of punishment.", "words": [{"id": 1, "arabic": "فَصَبَّ", "translit": "َّbَṣَf", "root": "صبب"}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "سَوْطَ", "translit": "َṭْwَs", "root": "سوط"}, {"id": 5, "arabic": "عَذَابٍ", "translit": "ٍbāَhdَʿع", "root": "عذب"}], "hasIhya": false}, {"ayah": 14, "text": "إِنَّ رَبَّكَ لَبِٱلْمِرْصَادِ ", "translation": "Indeed, your Lord is in observation.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 3, "arabic": "لَبِٱلْمِرْصَادِ", "translit": "ِdāَṣْrِmْlٱِbَl", "root": "رصد"}], "hasIhya": false}, {"ayah": 15, "text": "فَأَمَّا ٱلْإِنسَٰنُ إِذَا مَا ٱبْتَلَىٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّىٓ أَكْرَمَنِ ", "translation": "And as for man, when his Lord tries him and [thus] is generous to him and favors him, he says, \"My Lord has honored me.\"[1]", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 2, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "ٱبْتَلَىٰهُ", "translit": "ُhٰàَlَtْbٱ", "root": "بلو"}, {"id": 6, "arabic": "رَبُّهُۥ", "translit": "ۥُhُّbَr", "root": "ربب"}, {"id": 7, "arabic": "فَأَكْرَمَهُۥ", "translit": "ۥُhَmَrْkَaʾَf", "root": "كرم"}, {"id": 8, "arabic": "وَنَعَّمَهُۥ", "translit": "ۥُhَmَّʿعَnَw", "root": "نعم"}, {"id": 9, "arabic": "فَيَقُولُ", "translit": "ُlwُqَyَf", "root": "قول"}, {"id": 10, "arabic": "رَبِّىٓ", "translit": "ٓàِّbَr", "root": "ربب"}, {"id": 11, "arabic": "أَكْرَمَنِ", "translit": "ِnَmَrْkَaʾ", "root": "كرم"}], "hasIhya": true}, {"ayah": 16, "text": "وَأَمَّآ إِذَا مَا ٱبْتَلَىٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّىٓ أَهَٰنَنِ ", "translation": "But when He tries him and restricts his provision, he says, \"My Lord has humiliated me.\"", "words": [{"id": 1, "arabic": "وَأَمَّآ", "translit": "ٓāَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "ٱبْتَلَىٰهُ", "translit": "ُhٰàَlَtْbٱ", "root": "بلو"}, {"id": 5, "arabic": "فَقَدَرَ", "translit": "َrَdَqَf", "root": "قدر"}, {"id": 6, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "رِزْقَهُۥ", "translit": "ۥُhَqْzِr", "root": "رزق"}, {"id": 8, "arabic": "فَيَقُولُ", "translit": "ُlwُqَyَf", "root": "قول"}, {"id": 9, "arabic": "رَبِّىٓ", "translit": "ٓàِّbَr", "root": "ربب"}, {"id": 10, "arabic": "أَهَٰنَنِ", "translit": "ِnَnَٰhَaʾ", "root": "هون"}], "hasIhya": false}, {"ayah": 17, "text": "كَلَّاۖ بَل لَّا تُكْرِمُونَ ٱلْيَتِيمَ ", "translation": "No![1] But you do not honor the orphan", "words": [{"id": 1, "arabic": "كَلَّا", "translit": "āَّlَk", "root": ""}, {"id": 2, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 3, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 4, "arabic": "تُكْرِمُونَ", "translit": "َnwُmِrْkُt", "root": "كرم"}, {"id": 5, "arabic": "ٱلْيَتِيمَ", "translit": "َmyِtَyْlٱ", "root": "يتم"}], "hasIhya": false}, {"ayah": 18, "text": "وَلَا تَحَٰٓضُّونَ عَلَىٰ طَعَامِ ٱلْمِسْكِينِ ", "translation": "And you do not encourage one another to feed the poor.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَحَٰٓضُّونَ", "translit": "َnwُّḍَٰٓḥَt", "root": "حضض"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "طَعَامِ", "translit": "ِmāَʿعَṭ", "root": "طعم"}, {"id": 5, "arabic": "ٱلْمِسْكِينِ", "translit": "ِnyِkْsِmْlٱ", "root": "سكن"}], "hasIhya": false}, {"ayah": 19, "text": "وَتَأْكُلُونَ ٱلتُّرَاثَ أَكْلًا لَّمًّا ", "translation": "And you consume inheritance, devouring [it] altogether,[1]", "words": [{"id": 1, "arabic": "وَتَأْكُلُونَ", "translit": "َnwُlُkْaʾَtَw", "root": "اكل"}, {"id": 2, "arabic": "ٱلتُّرَاثَ", "translit": "َhtāَrُّtlٱ", "root": "ورث"}, {"id": 3, "arabic": "أَكْلًا", "translit": "āًlْkَaʾ", "root": "اكل"}, {"id": 4, "arabic": "لَّمًّا", "translit": "āًّmَّl", "root": "لمم"}], "hasIhya": false}, {"ayah": 20, "text": "وَتُحِبُّونَ ٱلْمَالَ حُبًّا جَمًّا ", "translation": "And you love wealth with immense love.", "words": [{"id": 1, "arabic": "وَتُحِبُّونَ", "translit": "َnwُّbِḥُtَw", "root": "حبب"}, {"id": 2, "arabic": "ٱلْمَالَ", "translit": "َlāَmْlٱ", "root": "مول"}, {"id": 3, "arabic": "حُبًّا", "translit": "āًّbُḥ", "root": "حبب"}, {"id": 4, "arabic": "جَمًّا", "translit": "āًّmَjg", "root": "جمم"}], "hasIhya": false}, {"ayah": 21, "text": "كَلَّآ إِذَا دُكَّتِ ٱلْأَرْضُ دَكًّا دَكًّا ", "translation": "No! When the earth has been leveled - pounded and crushed", "words": [{"id": 1, "arabic": "كَلَّآ", "translit": "ٓāَّlَk", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "دُكَّتِ", "translit": "ِtَّkُd", "root": "دكك"}, {"id": 4, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "دَكًّا", "translit": "āًّkَd", "root": "دكك"}, {"id": 6, "arabic": "دَكًّا", "translit": "āًّkَd", "root": "دكك"}], "hasIhya": false}, {"ayah": 22, "text": "وَجَآءَ رَبُّكَ وَٱلْمَلَكُ صَفًّا صَفًّا ", "translation": "And your Lord has come[1] and the angels, rank upon rank,", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "َءٓāَjgَw", "root": "جيا"}, {"id": 2, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 3, "arabic": "وَٱلْمَلَكُ", "translit": "ُkَlَmْlٱَw", "root": "ملك"}, {"id": 4, "arabic": "صَفًّا", "translit": "āًّfَṣ", "root": "صفف"}, {"id": 5, "arabic": "صَفًّا", "translit": "āًّfَṣ", "root": "صفف"}], "hasIhya": false}, {"ayah": 23, "text": "وَجِا۟ىٓءَ يَوْمَئِذٍۭ بِجَهَنَّمَۚ يَوْمَئِذٍ يَتَذَكَّرُ ٱلْإِنسَٰنُ وَأَنَّىٰ لَهُ ٱلذِّكْرَىٰ ", "translation": "And brought [within view], that Day, is Hell - that Day, man will remember, but how [i.e., what good] to him will be the remembrance?", "words": [{"id": 1, "arabic": "وَجِا۟ىٓءَ", "translit": "َءٓà۟āِjgَw", "root": "جيا"}, {"id": 2, "arabic": "يَوْمَئِذٍۭ", "translit": "ٍۭhdِyʾَmْwَy", "root": "يوم"}, {"id": 3, "arabic": "بِجَهَنَّمَ", "translit": "َmَّnَhَjgِb", "root": ""}, {"id": 4, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 5, "arabic": "يَتَذَكَّرُ", "translit": "ُrَّkَhdَtَy", "root": "ذكر"}, {"id": 6, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 7, "arabic": "وَأَنَّىٰ", "translit": "ٰàَّnَaʾَw", "root": ""}, {"id": 8, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 9, "arabic": "ٱلذِّكْرَىٰ", "translit": "ٰàَrْkِّhdlٱ", "root": "ذكر"}], "hasIhya": false}, {"ayah": 24, "text": "يَقُولُ يَٰلَيْتَنِى قَدَّمْتُ لِحَيَاتِى ", "translation": "He will say, \"Oh, I wish I had sent ahead [some good] for my life.\"[1]", "words": [{"id": 1, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 2, "arabic": "يَٰلَيْتَنِى", "translit": "àِnَtْyَlَٰy", "root": ""}, {"id": 3, "arabic": "قَدَّمْتُ", "translit": "ُtْmَّdَq", "root": "قدم"}, {"id": 4, "arabic": "لِحَيَاتِى", "translit": "àِtāَyَḥِl", "root": "حيي"}], "hasIhya": false}, {"ayah": 25, "text": "فَيَوْمَئِذٍ لَّا يُعَذِّبُ عَذَابَهُۥٓ أَحَدٌ ", "translation": "So on that Day, none will punish [as severely] as His punishment,", "words": [{"id": 1, "arabic": "فَيَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَyَf", "root": "يوم"}, {"id": 2, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 3, "arabic": "يُعَذِّبُ", "translit": "ُbِّhdَʿعُy", "root": "عذب"}, {"id": 4, "arabic": "عَذَابَهُۥٓ", "translit": "ٓۥُhَbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "أَحَدٌ", "translit": "ٌdَḥَaʾ", "root": "احد"}], "hasIhya": false}, {"ayah": 26, "text": "وَلَا يُوثِقُ وَثَاقَهُۥٓ أَحَدٌ ", "translation": "And none will bind [as severely] as His binding [of the evildoers].", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يُوثِقُ", "translit": "ُqِhtwُy", "root": "وثق"}, {"id": 3, "arabic": "وَثَاقَهُۥٓ", "translit": "ٓۥُhَqāَhtَw", "root": "وثق"}, {"id": 4, "arabic": "أَحَدٌ", "translit": "ٌdَḥَaʾ", "root": "احد"}], "hasIhya": false}, {"ayah": 27, "text": "يَٰٓأَيَّتُهَا ٱلنَّفْسُ ٱلْمُطْمَئِنَّةُ ", "translation": "[To the righteous it will be said], \"O reassured soul,", "words": [{"id": 1, "arabic": "يَٰٓأَيَّتُهَا", "translit": "āَhُtَّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّفْسُ", "translit": "ُsْfَّnlٱ", "root": "نفس"}, {"id": 3, "arabic": "ٱلْمُطْمَئِنَّةُ", "translit": "ُẗَّnِyʾَmْṭُmْlٱ", "root": "طمان"}], "hasIhya": true}, {"ayah": 28, "text": "ٱرْجِعِىٓ إِلَىٰ رَبِّكِ رَاضِيَةً مَّرْضِيَّةً ", "translation": "Return to your Lord, well-pleased and pleasing [to Him],", "words": [{"id": 1, "arabic": "ٱرْجِعِىٓ", "translit": "ٓàِʿعِjgْrٱ", "root": "رجع"}, {"id": 2, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 3, "arabic": "رَبِّكِ", "translit": "ِkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "رَاضِيَةً", "translit": "ًẗَyِḍāَr", "root": "رضو"}, {"id": 5, "arabic": "مَّرْضِيَّةً", "translit": "ًẗَّyِḍْrَّm", "root": "رضو"}], "hasIhya": true}, {"ayah": 29, "text": "فَٱدْخُلِى فِى عِبَٰدِى ", "translation": "And enter among My [righteous] servants", "words": [{"id": 1, "arabic": "فَٱدْخُلِى", "translit": "àِlُhkْdٱَf", "root": "دخل"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "عِبَٰدِى", "translit": "àِdَٰbِʿع", "root": "عبد"}], "hasIhya": false}, {"ayah": 30, "text": "وَٱدْخُلِى جَنَّتِى ", "translation": "And enter My Paradise.\"", "words": [{"id": 1, "arabic": "وَٱدْخُلِى", "translit": "àِlُhkْdٱَw", "root": "دخل"}, {"id": 2, "arabic": "جَنَّتِى", "translit": "àِtَّnَjg", "root": "جنن"}], "hasIhya": false}], "tafsir": {"6": [{"arabic": "تر كيف فعل ربك بعاد إرم ذات العماد ألم تر كيف فعل ربك بأصحاب الفيل ولايعدو القرآن هذه الأقسام الثلاثة وهي الإرشاد إلى معرفة ذات الله وتقديسه أو معرفة صفاته وأسمائه أو معرفة أفعاله وسنته مع عباده ولما اشتملت سورة الإخلاص على أحد هذه الأقسام الثلاثة وهو التقديس وازنها رسول الله صلى الله عليه وسلم بثلث القرآن فقال من قرأ سورة الإخلاص فقد قرأ ثلث القرآن (1) حديث دعائه لابن عباس اللهم فقهه في الدين وعلمه التأويل متفق عليه دون قوله وعلمه التأويل ورواه أحمد بهذه الزيادة وتقدم في العلم ###", "english": "And in the report [it is said]: Verily God—exalted is He—revealed to a servant whom He had taken by the hand after he had been on the brink of destruction: \"How many a sin did you commit against Me, and I forgave it for you—sins for the sake of which I destroyed entire nations among the nations!\" So this is the way (sunnah) of God—exalted is He—with His servants, by way of favor (tafḍīl), and bringing forward (taqdīm), and deferring (taʾkhīr), according to what the eternal will (al-mashīʾah al-azaliyyah) had previously decreed.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1188", "section_title_en": "On the Meaning of Contentment with God's Decree (Al-Riḍā bi Qaḍāʾ Allāh), Its Reality, and What Has Been Reported Concerning Its Virtue", "section_index": 1188, "anchors": "- Root: رضي (Raḍā)\n  * Lisan / Ayn: Core meaning of being pleased, satisfied, consenting; the opposite of anger (sakhaṭ). Its object is that which is agreeable and harmonious with one's will.\n  * Al-Raghib (Mufradat): Raḍā is a state of the heart (ḥāl min aḥwāl al-qalb) signifying the soul's inclination toward what is pleasing, and its cessation of opposition. In theological terms, it is the soul's acquiescence to the divine decree (qaḍāʾ) after the removal of inner resistance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"رَضِيَ عَنْهُ\" — to be content with someone. Metaphorical (majāz): \"رَضِيَ بِالكَوْنِ\" — submission to what is, even when it opposes the appetites, which is the higher spiritual usage.\n- Root: قضي (Qaḍā)\n  * Lisan / Ayn: To decree, determine, execute, or finish a matter; the cutting off of a thing decisively.\n  * Al-Raghib (Mufradat): Qaḍāʾ is the divine determination (taqdīr) and execution of affairs according to prior eternal knowledge; it encompasses both what is feared and what is hoped for.\n  * Al-Zamakhshari (Asas): Literal: the completion of a judgment. Metaphorical: the divine decree as the all-encompassing will of God, which the believer must embrace.\n- Root: ولي (Waliya)\n  * Lisan / Ayn: Nearness, guardianship, and governance; the one who manages affairs.\n  * Al-Raghib (Mufradat): Walī is the one who is near to God through obedience, and God is the Walī of the believer through grace and protection.\n  * Al-Zamakhshari (Asas): Literal: proximity. Metaphorical: friendship and divine patronage.\n- Sibawayh Rule: Rule of Predicate Emphasis (Bāb al-Taʾkīd bi al-Ḍamīr al-Munfaṣil) — The repetition of the pronoun for emphasis, as in \"اللهُ هُوَ\" structures, to affirm the exclusivity of divine attributes without ambiguity.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Love, Longing, Intimacy and Contentment'", "badge": "Hadith"}], "15": [{"arabic": "أنها هوان كما أخبر الله تعالى عنه إذ قال فأما الإنسان إذا ما ابتلاه ربه فأكرمه ونعمه فيقول ربي أكرمن وأما إذا ما ابتلاه فقدر عليه رزقه فيقول ربي أهانن فأجاب الله عن ذلك كلا أي ليس كما قال إنما هو ابتلاء نعوذ بالله من شر البلاء ونسأل الله التثبيت فبين أن ذلك غرور قال الحسن كذبهما جميعا بقوله كلا يقول ليس هذا بإكرامي ولا هذا بهواني ولكن الكريم من أكرمته بطاعتي غنيا كان أو فقيرا والمهان من أهنته بمعصيتي غنيا كان أو فقيرا", "english": "It was said of that sort, so they are falsehoods (akādhīb). And even if it were so, then \"there will surely be for me in Paradise better than this\" {«لَيَكُونَنَّ لِي فِي الْجَنَّةِ خَيْرٌ مِنْ هَذَا»}. Likewise, God Most High described the saying of al-ʿĀṣ ibn Wāʾil when he said, \"I will surely be given wealth and children\" {«لَأُوتَيَنَّ مَالًا وَوَلَدًا»}. So God Most High replied to him: \"Has he looked into the unseen, or has he taken with the Most Merciful a covenant? No indeed (kallā)\" {«أَطَّلَعَ الْغَيْبَ أَمِ اتَّخَذَ عِنْدَ الرَّحْمَنِ عَهْدًا كَلَّا»}. And it is related from Khabbāb ibn al-Aratt that he said: I had a debt owed to me by al-ʿĀṣ ibn Wāʾil, so I came demanding payment, but he did not pay me. So I said, \"I will indeed take it from you in the Hereafter.\" He said to me, \"When you come to the Hereafter, I will have there wealth and children, and I will pay you from it.\" So God Most High revealed His saying: \"Have you seen the one who disbelieved in Our signs and said, 'I will surely be given wealth and children'?\" {«أَفَرَأَيْتَ الَّذِي كَفَرَ بِآيَاتِنَا وَقَالَ لَأُوتَيَنَّ مَالًا وَوَلَدًا»}. (1) The hadith \"God protects His servant from the world while loving him\" — narrated by al-Tirmidhī who deemed it good (ḥasan), and by al-Ḥākim who deemed it authentic (ṣaḥīḥ), from the report of Qatādah ibn al-Nuʿmān. Thus it came in the report from the master of mankind (peace be upon him).", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 887", "section_title_en": "The Delusion of Wealth and the Reality of Divine Trial — Section 887", "section_index": 887, "anchors": "- Root: كلا (Kalla)\n  * Lisan / Ayn: An emphatic particle of denial and refutation; signifies categorical rejection of a prior claim.\n  * Al-Raghib (Mufradat): Used to negate and refute utterly; here, it rebuts the deluded assumption that wealth signals divine favor.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) — a decisive \"No!\"; Metaphorical (Majaz) — not merely denying words but the very presumption underlying them.\n- Root: حدث (Ḥadatha)\n  * Lisan / Ayn: To originate, to be new; in Kalam, that which comes into being after non-existence.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination of a thing after it was not; divine acts of trial are originated events.\n  * Al-Zamakhshari (Asas): Literal — new occurrences; Metaphorical — \"محدث\" as one whose inner state is renewed by divine testing.\n- Root: كذب (Kadhaba)\n  * Lisan / Ayn: To lie, to falsify; a false report or claim.\n  * Al-Raghib (Mufradat): Falsehood in word and deed; here, the disbeliever's boast is exposed as self-deception.\n  * Al-Zamakhshari (Asas): Literal — verbal lying; Metaphorical — \"كذبهما جميعا\" (he declared both of them liars) — attributing falsity to the two human assumptions about wealth and poverty.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما هو ابتلاء\" restricts the reality of wealth and poverty solely to divine testing, excluding the deluded interpretations of honor or humiliation.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Delusion'", "badge": "Hadith"}], "27": [{"arabic": "وسمع رجل من أهل التصوف قارئا يقرأ {يا أيتها النفس المطمئنة ارجعي إلى ربك راضية مرضية} فاستعادها من القارىء وقال كم أقول لها ارجعي وليست ترجع وتواجد وزعق زعقة فخرجت روحه وسمع بكر بن معاذ قارئا يقرأ {وأنذرهم يوم الآزفة} الآية فاضطرب ثم صاح ارحم من أنذرته ولم يقبل إليك بعد الإنذار بطاعتك ثم غشى عليه وكان إبراهيم ابن أدهم رحمه الله إذا سمع أحدا يقرأ {إذا السماء انشقت} اضطربت أوصاله حتى كان يرتعد وعن محمد بن صبيح قال كان رجل يغتسل في الفرات فمر به رجل على الشاطىء يقرأ {وامتازوا اليوم أيها المجرمون} فلم يزل الرجل يضطرب حتى غرق ومات وذكر أن سلمان الفارسي أبصر شابا يقرأ فأتى على آية فاقشعر جلده فأحبه سلمان وفقده فسأل عنه فقيل له إنه مريض فأتاه يعوده فإذا هو في الموت فقال يا عبد الله أرأيت تلك القشعريرة التي كانت بي فإنها أتتني في أحسن صورة فأخبرتني أن الله قد غفر لي بها كل ذنب وبالجملة لا يخلو صاحب القلب عن وجد عند سماع القرآن فإن كان القرآن لا يؤثر فيه أصلا ف مثله كمثل الذي ينعق بما لا يسمع إلا دعاء ونداء صم بكم عمي فهم لا يعقلون بل صاحب القلب تؤثر فيه الكلمة من الحكمة يسمعها قال جعفر الخلدي دخل رجل من أهل خراسان على الجنيد وعنده جماعة فقال للجنيد متى يستوي عند العبد حامده وذامه فقال بعض الشيوخ إذا دخل البيمارستان وقيد بقيدين فقال الجنيد ليس هذا من شأنك ثم أقبل على الرجل وقال إذا تحقق أنه مخلوق فشهق الرجل شهقة ومات فإن قلت فإن كان سماع القرآن مفيدا للوجد فما بالهم يجتمعون على سماع الغناء من القوالين دون القارئين فكان ينبغي أن يكون اجتماعهم وتواجدهم في حلق القراء لا حلق المغنين وكان ينبغي أن يطلب عند كل اجتماع في كل دعوة قارىء لأقوال فإن كلام الله تعالى أفضل من الغناء لا محالة فاعلم أن الغناء أشد تهييجا للوجد من القرآن من سبعة أوجه الوجه الأول أن جميع آيات القرآن لا تناسب حال المستمع ولا تصلح لفهمه وتنزيله على ما هو ملابس له فمن استولى عليه حزن أو شوق أو ندم فمن أين يناسب حاله قوله تعالى {يوصيكم الله في أولادكم للذكر مثل حظ الأنثيين} وقوله تعالى {والذين يرمون المحصنات} وكذلك جميع الآيات التي فيها بيان أحكام الميراث والطلاق والحدود وغيرها وإنما المحرك لما في القلب ما يناسبه والأبيات إنما يضعها الشعراء إعرابا بها عن أحوال القلب فلا يحتاج في فهم الحال منها إلى تكلف نعم من يستولي عليه حالة غالبة قاهرة لم تبق فيه متسعا لغيرها ومعه تيقظ وذكاء ثاقب يتفطن به للمعاني البعيدة من الألفاظ فقد يخرج وجده على كل مسموع كمن يخطر له عند ذكر قوله تعالى {يوصيكم الله في أولادكم} حالة الموت المحوج إلى الوصية وأن كل إنسان لا بد أن يخلف ماله وولده وهما محبوباه من الدنيا فيترك أحد المحبوبين للثاني ويهجرهما جميعا فيغلب عليه الخوف والجزع أو يسمع ذكر الله في قوله {يوصيكم الله في أولادكم} فيدهش بمجرد الاسم عما قبله وبعده أو يخطر له رحمة الله على عباده وشفقته بأن تولى قسم مواريثهم بنفسه نظرا لهم في حياتهم وموتهم فيقول إذا نظر لأولادنا بعد موتنا فلا نشك بأنه ينظر لنا فيهيج", "english": "Some of the Sufis said: \"One night I was reciting this verse: {كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ} «Every soul shall taste death» [Q. 3:185]. I kept repeating it, and lo, a caller cried out to me: 'How long will you repeat this verse? You have killed four of the jinn who have not raised their heads to the sky since they were created.'\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 512", "section_title_en": "On the Ecstatic States (Wajd) Produced by Qur'anic Recitation and the Superiority of Song (Ghinā') in Stirring the Heart", "section_index": 512, "anchors": "- Root: وجد (w-j-d)\n  * Lisan / Ayn: Core meaning of finding, attaining, and also denoting the emotional state of ecstasy or rapture that \"finds\" the heart.\n  * Al-Raghib (Mufradat): In the theological context, 'wajd' is the state of spiritual finding—a direct, overwhelming apprehension of divine realities that bypasses discursive reasoning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes \"finding\" a lost object; metaphorical (Majaz) usage denotes the heart \"finding\" its spiritual state, leading to agitation and ecstasy.\n- Root: سمع (s-m-')\n  * Lisan / Ayn: The faculty of hearing; also the ear itself.\n  * Al-Raghib (Mufradat): Hearing can be literal (perception of sound) or figurative (understanding, obedience, acceptance). The heart's \"hearing\" is a deeper comprehension.\n  * Al-Zamakhshari (Asas): Literal: \"سمعته\" (I heard him). Metaphorical: \"سمع الله لمن حمده\" (God answers/he accepts the one who praises Him), indicating a responsive, transformative hearing.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death; the opposite of life.\n  * Al-Raghib (Mufradat): Death is the cessation of the soul's governance over the body, a separation. In the spiritual context, it can be a metaphorical death to worldly desires.\n  * Al-Zamakhshari (Asas): Literal: physical death. Metaphorical: \"أحيا الله البلد الميت\" (God revives the dead land), indicating spiritual revival or the death of the ego.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that the stirring of the heart is exclusively through what is appropriate to its state, as in the phrase \"إنما المحرك لما في القلب ما يناسبه\" (The only thing that moves what is in the heart is that which is suitable to it).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "28": [{"arabic": "وسمع رجل من أهل التصوف قارئا يقرأ {يا أيتها النفس المطمئنة ارجعي إلى ربك راضية مرضية} فاستعادها من القارىء وقال كم أقول لها ارجعي وليست ترجع وتواجد وزعق زعقة فخرجت روحه وسمع بكر بن معاذ قارئا يقرأ {وأنذرهم يوم الآزفة} الآية فاضطرب ثم صاح ارحم من أنذرته ولم يقبل إليك بعد الإنذار بطاعتك ثم غشى عليه وكان إبراهيم ابن أدهم رحمه الله إذا سمع أحدا يقرأ {إذا السماء انشقت} اضطربت أوصاله حتى كان يرتعد وعن محمد بن صبيح قال كان رجل يغتسل في الفرات فمر به رجل على الشاطىء يقرأ {وامتازوا اليوم أيها المجرمون} فلم يزل الرجل يضطرب حتى غرق ومات وذكر", "english": "Some of the Sufis said: \"One night I was reciting this verse: {كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ} «Every soul shall taste death» [Q. 3:185]. I kept repeating it, and lo, a caller cried out to me: 'How long will you repeat this verse? You have killed four of the jinn who have not raised their heads to the sky since they were created.'\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 512", "section_title_en": "On the Ecstatic States (Wajd) Produced by Qur'anic Recitation and the Superiority of Song (Ghinā') in Stirring the Heart", "section_index": 512, "anchors": "- Root: وجد (w-j-d)\n  * Lisan / Ayn: Core meaning of finding, attaining, and also denoting the emotional state of ecstasy or rapture that \"finds\" the heart.\n  * Al-Raghib (Mufradat): In the theological context, 'wajd' is the state of spiritual finding—a direct, overwhelming apprehension of divine realities that bypasses discursive reasoning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes \"finding\" a lost object; metaphorical (Majaz) usage denotes the heart \"finding\" its spiritual state, leading to agitation and ecstasy.\n- Root: سمع (s-m-')\n  * Lisan / Ayn: The faculty of hearing; also the ear itself.\n  * Al-Raghib (Mufradat): Hearing can be literal (perception of sound) or figurative (understanding, obedience, acceptance). The heart's \"hearing\" is a deeper comprehension.\n  * Al-Zamakhshari (Asas): Literal: \"سمعته\" (I heard him). Metaphorical: \"سمع الله لمن حمده\" (God answers/he accepts the one who praises Him), indicating a responsive, transformative hearing.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death; the opposite of life.\n  * Al-Raghib (Mufradat): Death is the cessation of the soul's governance over the body, a separation. In the spiritual context, it can be a metaphorical death to worldly desires.\n  * Al-Zamakhshari (Asas): Literal: physical death. Metaphorical: \"أحيا الله البلد الميت\" (God revives the dead land), indicating spiritual revival or the death of the ego.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that the stirring of the heart is exclusively through what is appropriate to its state, as in the phrase \"إنما المحرك لما في القلب ما يناسبه\" (The only thing that moves what is in the heart is that which is suitable to it).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 140, 1630]], "89:1": [[1, 140, 1630]], "2": [[1, 370, 2109], [2, 2109, 2740]], "89:2": [[1, 370, 2109], [2, 2109, 2740]], "3": [[1, 320, 1676], [2, 1676, 3040]], "89:3": [[1, 320, 1676], [2, 1676, 3040]], "4": [[1, 390, 1686], [2, 1686, 2599], [3, 2599, 3420]], "89:4": [[1, 390, 1686], [2, 1686, 2599], [3, 2599, 3420]], "5": [[1, 480, 966], [2, 966, 1631], [3, 1631, 2649], [4, 2649, 3493], [5, 3493, 4631], [6, 4631, 5500]], "89:5": [[1, 480, 966], [2, 966, 1631], [3, 1631, 2649], [4, 2649, 3493], [5, 3493, 4631], [6, 4631, 5500]], "6": [[1, 350, 1168], [2, 1168, 1679], [3, 1679, 2599], [4, 2599, 3430], [5, 3430, 4389], [6, 4389, 5910]], "89:6": [[1, 350, 1168], [2, 1168, 1679], [3, 1679, 2599], [4, 2599, 3430], [5, 3430, 4389], [6, 4389, 5910]], "7": [[1, 380, 1076], [2, 1076, 2121], [3, 2121, 3710]], "89:7": [[1, 380, 1076], [2, 1076, 2121], [3, 2121, 3710]], "8": [[1, 280, 1413], [2, 1413, 1895], [3, 1895, 3368], [4, 3368, 4983], [5, 4983, 5610], [6, 5610, 6850]], "89:8": [[1, 280, 1413], [2, 1413, 1895], [3, 1895, 3368], [4, 3368, 4983], [5, 4983, 5610], [6, 5610, 6850]], "9": [[1, 300, 1624], [2, 1624, 2730], [3, 2730, 4372], [4, 4372, 5325], [5, 5325, 6740]], "89:9": [[1, 300, 1624], [2, 1624, 2730], [3, 2730, 4372], [4, 4372, 5325], [5, 5325, 6740]], "10": [[1, 350, 2004], [2, 2004, 2545], [3, 2545, 4320]], "89:10": [[1, 350, 2004], [2, 2004, 2545], [3, 2545, 4320]], "11": [[1, 200, 1580], [2, 1580, 2980], [3, 2980, 3523], [4, 3523, 4600]], "89:11": [[1, 200, 1580], [2, 1580, 2980], [3, 2980, 3523], [4, 3523, 4600]], "12": [[1, 230, 2026], [2, 2026, 3235], [3, 3235, 4470]], "89:12": [[1, 230, 2026], [2, 2026, 3235], [3, 3235, 4470]], "13": [[1, 330, 1358], [2, 1358, 2836], [3, 2836, 3800], [4, 3800, 4815], 