: 14, "text": "اِنَّ رَبَّكَ لَبِالْمِرْصَادِۖ", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "لَبِالْمِرْصَادِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 89, "ayah": 15, "text": "فَأَمَّا اَ۬لِانسَٰنُ إِذَا مَا اَ۪بْتَل۪يٰهُ رَبُّهُۥ فَأَكْرَمَهُۥ وَنَعَّمَهُۥ فَيَقُولُ رَبِّيَ أَكْرَمَنِۦۖ", "words": [{"id": 1, "arabic": "فَأَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لِانسَٰنُ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۪بْتَل۪يٰهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "رَبُّهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَأَكْرَمَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَنَعَّمَهُۥ", "translit": "", "root": ""}, {"id": 9, "arabic": "فَيَقُولُ", "translit": "", "root": ""}, {"id": 10, "arabic": "رَبِّيَ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَكْرَمَنِۦۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 89, "ayah": 16, "text": "وَأَمَّآ إِذَا مَا اَ۪بْتَل۪يٰهُ فَقَدَرَ عَلَيْهِ رِزْقَهُۥ فَيَقُولُ رَبِّيَ أَهَٰنَنِۦ", "words": [{"id": 1, "arabic": "وَأَمَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۪بْتَل۪يٰهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَقَدَرَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "رِزْقَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَيَقُولُ", "translit": "", "root": ""}, {"id": 9, "arabic": "رَبِّيَ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَهَٰنَنِۦ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 89, "ayah": 17, "text": "كَلَّاۖ بَل لَّا تُكْرِمُونَ اَ۬لْي