َدࣱۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يُوثِقُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَثَاقَهُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَحَدࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 89, "ayah": 27, "text": "يَٰٓأَيَّتُهَا اَ۬لنَّفْسُ اُ۬لْمُطْمَئِنَّةُ", "words": [{"id": 1, "arabic": "يَٰٓأَيَّتُهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنَّفْسُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْمُطْمَئِنَّةُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 89, "ayah": 28, "text": "اُ۪رْجِعِےٓ إِلَيٰ رَبِّكِ رَاضِيَةࣰ مَّرْضِيَّةࣰ‏", "words": [{"id": 1, "arabic": "اُ۪رْجِعِےٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَاضِيَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَّرْضِيَّةࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 89, "ayah": 29, "text": "فَادْخُلِے فِے عِبَٰدِے", "words": [{"id": 1, "arabic": "فَادْخُلِے", "translit": "", "root": ""}, {"id": 2, "arabic": "فِے", "translit": "", "root": ""}, {"id": 3, "arabic": "عِبَٰدِے", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 89, "ayah": 30, "text": "وَادْخُلِے جَنَّتِےۖ", "words": [{"id": 1, "arabic": "وَادْخُلِے", "translit": "", "root": ""}, {"id": 2, "arabic": "جَنَّتِےۖ", "translit": "", "root": ""}], "narration": "warsh"}]}