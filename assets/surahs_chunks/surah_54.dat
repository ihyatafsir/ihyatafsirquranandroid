ic": "أَبَشَراࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "وَٰحِداࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "نَّتَّبِعُهُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِذاࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَّفِے", "translit": "", "root": ""}, {"id": 9, "arabic": "ضَلَٰلࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَسُعُرٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 25, "text": "اَ۟لْقِيَ اَ۬لذِّكْرُ عَلَيْهِ مِنۢ بَيْنِنَا بَلْ هُوَ كَذَّابٌ اَشِرࣱۖ", "words": [{"id": 1, "arabic": "اَ۟لْقِيَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِّكْرُ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنِنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَذَّابٌ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَشِرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 26, "text": "سَيَعْلَمُونَ غَداࣰ مَّنِ اِ۬لْكَذَّابُ اُ۬لَاشِرُۖ", "words": [{"id": 1, "arabic": "سَيَعْلَمُونَ", "translit": "", "root": ""}, {"id": 2, "arabic": "غَداࣰ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لْكَذَّابُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لَاشِرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 27, "text": "إِنَّا مُرْسِلُواْ اُ۬لنَّاقَةِ فِتْنَةࣰ لَّهُمْ فَارْتَقِبْهُمْ وَاصْطَبِرْۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "مُرْسِلُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لنَّاقَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِتْنَةࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَّهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَارْتَقِبْهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَاصْطَبِرْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 28, "text": "وَنَبِّئْهُمُۥٓ أَنَّ اَ۬لْمَآءَ قِسْمَةُۢ بَيْنَهُمْۖ كُلُّ شِرْبࣲ مُّحْتَضَرࣱۖ", "words": [{"id": 1, "arabic": "وَنَبِّئْهُمُۥٓ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْمَآءَ", "translit": "", "root": ""}, {"id": 4, "arabic": "قِسْمَةُۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْنَهُمْۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 7, "arabic": "شِرْبࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّحْتَضَرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 29, "text": "فَنَادَوْاْ صَٰحِبَهُمْ فَتَعَاط۪يٰ فَعَقَرَۖ", "words": [{"id": 1, "arabic": "فَنَادَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَٰحِبَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَتَعَاط۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَعَقَرَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 30, "text": "فَكَيْفَ كَانَ عَذَابِے وَنُذُرِۦٓۖ", "words": [{"id": 1, "arabic": "فَكَيْفَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَذَابِے", "translit": "", "root": ""}, {"id": 4, "arabic": "وَنُذُرِۦٓۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 31, "text": "إِنَّآ أَرْسَلْنَا عَلَيْهِمْ صَيْحَةࣰ وَٰحِدَةࣰ فَكَانُواْ كَهَشِيمِ اِ۬لْمُحْتَظِرِۖ", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "صَ