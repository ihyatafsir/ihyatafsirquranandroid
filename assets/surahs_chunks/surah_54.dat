 "۞وَلَقَدْ رَٰوَدُوهُ عَن ضَيْفِهِۦ فَطَمَسْنَآ أَعْيُنَهُمْ فَذُوقُواْ عَذَابِے وَنُذُرِۦۖ", "words": [{"id": 1, "arabic": "۞وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَٰوَدُوهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَن", "translit": "", "root": ""}, {"id": 4, "arabic": "ضَيْفِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَطَمَسْنَآ", "translit": "", "root": ""}, {"id": 6, "arabic": "أَعْيُنَهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَذُوقُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَذَابِے", "translit": "", "root": ""}, {"id": 9, "arabic": "وَنُذُرِۦۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 38, "text": "وَلَقَدْ صَبَّحَهُم بُكْرَةً عَذَابࣱ مُّسْتَقِرࣱّۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَبَّحَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بُكْرَةً", "translit": "", "root": ""}, {"id": 4, "arabic": "عَذَابࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّسْتَقِرࣱّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 39, "text": "فَذُوقُواْ عَذَابِے وَنُذُرِۦۖ", "words": [{"id": 1, "arabic": "فَذُوقُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَذَابِے", "translit": "", "root": ""}, {"id": 3, "arabic": "وَنُذُرِۦۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 40, "text": "وَلَقَدْ يَسَّرْنَا اَ۬لْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرࣲۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَسَّرْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لْقُرْءَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلذِّكْرِ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَهَلْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّدَّكِرࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 41, "text": "وَلَقَدْ جَآءَ ا۟لَ فِرْعَوْنَ اَ۬لنُّذُرُۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ا۟لَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لنُّذُرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 42, "text": "كَذَّبُواْ بِـَٔايَٰتِنَا كُلِّهَا فَأَخَذْنَٰهُمُۥٓ أَخْذَ عَزِيزࣲ مُّقْتَدِرٍۖ", "words": [{"id": 1, "arabic": "كَذَّبُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِـَٔايَٰتِنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلِّهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "فَأَخَذْنَٰهُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَخْذَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَزِيزࣲ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّقْتَدِرٍۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 43, "text": "اَكُفَّارُكُمْ خَيْرࣱ مِّنُ ا۟وْلَٰٓئِكُمُۥٓ أَمْ لَكُم بَرَآءَةࣱ فِے اِ۬لزُّبُرِۖ", "words": [{"id": 1, "arabic": "اَكُفَّارُكُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "ا۟وْلَٰٓئِكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 7, "arabic": "بَرَآءَةࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لزُّبُرِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 44, "text": "أَمْ يَقُولُونَ نَحْنُ جَمِيعࣱ مُّنتَصِرࣱۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَمِيعࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّنتَصِرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 45, "text": "سَيُهْزَمُ اُ۬لْجَمْعُ وَيُوَلُّونَ اَ۬لدُّبُرَۖ", "words": [{"id": 1, "arabic": "سَيُهْزَمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْجَمْعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيُوَلُّونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لدُّبُرَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 46, "text": "بَلِ اِ۬لسَّاعَةُ مَوْعِدُهُمْۖ وَالسَّاعَةُ أَدْه۪يٰ وَأَمَرُّۖ", "words": [{"id": 1, "arabic": "بَلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لسَّاعَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَوْعِدُهُمْۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالسَّاعَةُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَدْه۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَمَرُّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 47, "text": "إِنَّ اَ۬لْمُجْرِمِينَ فِے ضَلَٰلࣲ وَسُعُرࣲ‏", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمُجْرِمِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "ضَلَٰلࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَسُعُرࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 48, "text": "يَوْمَ يُسْحَبُونَ فِے اِ۬لنّ۪ارِ عَلَيٰ وُجُوهِهِمْ ذُوقُواْ مَسَّ سَقَرَۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُسْحَبُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لنّ۪ارِ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وُجُوهِهِمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "ذُوقُواْ", "translit": "", "root": 