ayah": 53, "text": "وَكُلُّ صَغِيرࣲ وَكَبِيرࣲ مُّسْتَطَرٌۖ", "words": [{"id": 1, "arabic": "وَكُلُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَغِيرࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَكَبِيرࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّسْتَطَرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 54, "text": "اِنَّ اَ۬لْمُتَّقِينَ فِے جَنَّٰتࣲ وَنَهَرࣲ‏", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمُتَّقِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنَهَرࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 55, "text": "فِے مَقْعَدِ صِدْقٍ عِندَ مَلِيكࣲ مُّقْتَدِرٍۖ", "words": [{"id": 1, "arabic": "فِے", "translit": "", "root": ""}, {"id": 2, "arabic": "مَقْعَدِ", "translit": "", "root": ""}, {"id": 3, "arabic": "صِدْقٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَلِيكࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّقْتَدِرٍۖ", "translit": "", "root": ""}], "narration": "warsh"}]}