2, "arabic": "اِ۬لسَّاعَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَانشَقَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْقَمَرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 2, "text": "وَإِنْ يَّرَوَاْ اٰيَةࣰ يُعْرِضُواْ وَيَقُولُواْ سِحْرࣱ مُّسْتَمِرࣱّۖ", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّرَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُعْرِضُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَقُولُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "سِحْرࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّسْتَمِرࣱّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 3, "text": "وَكَذَّبُواْ وَاتَّبَعُوٓاْ أَهْوَآءَهُمْۖ وَكُلُّ أَمْرࣲ مُّسْتَقِرࣱّۖ", "words": [{"id": 1, "arabic": "وَكَذَّبُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَاتَّبَعُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَهْوَآءَهُمْۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَكُلُّ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْرࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّسْتَقِرࣱّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 4, "text": "وَلَقَدْ جَآءَهُم مِّنَ اَ۬لَانۢبَآءِ مَا فِيهِ مُزْدَجَرٌۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَانۢبَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُزْدَجَرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 5, "text": "حِكْمَةُۢ بَٰلِغَةࣱۖ فَمَا تُغْنِ اِ۬لنُّذُرُۖ", "words": [{"id": 1, "arabic": "حِكْمَةُۢ",