ah": 54, "ayah": 43, "text": "اَكُفَّارُكُمْ خَيْرࣱ مِّنُ ا۟وْلَٰٓئِكُمُۥٓ أَمْ لَكُم بَرَآءَةࣱ فِے اِ۬لزُّبُرِۖ", "words": [{"id": 1, "arabic": "اَكُفَّارُكُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَيْرࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "ا۟وْلَٰٓئِكُمُۥٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 7, "arabic": "بَرَآءَةࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لزُّبُرِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 44, "text": "أَمْ يَقُولُونَ نَحْنُ جَمِيعࣱ مُّنتَصِرࣱۖ", "words": [{"id": 1, "arabic": "أَمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "نَحْنُ", "translit": "", "root": ""}, {"id": 4, "arabic": "جَمِيعࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّنتَصِرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 45, "text": "سَيُهْزَمُ اُ۬لْجَمْعُ وَيُوَلُّونَ اَ۬لدُّبُرَۖ", "words": [{"id": 1, "arabic": "سَيُهْزَمُ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬لْجَمْعُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَيُوَلُّونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لدُّبُرَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 46, "text": "بَلِ اِ۬لسَّاعَةُ مَوْعِدُهُمْۖ وَالسَّاعَةُ أَدْه۪يٰ وَأَمَرُّۖ", "words": [{"id": 1, "arabic": "بَلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لسَّاعَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَوْعِدُهُمْۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالسَّاعَةُ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَدْه۪يٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَأَمَرُّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 47, "text": "إِنَّ اَ۬لْمُجْرِمِينَ فِے ضَلَٰلࣲ وَسُعُرࣲ‏", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمُجْرِمِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "ضَلَٰلࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَسُعُرࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 48, "text": "يَوْمَ يُسْحَبُونَ فِے اِ۬لنّ۪ارِ عَلَيٰ وُجُوهِهِمْ ذُوقُواْ مَسَّ سَقَرَۖ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُسْحَبُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لنّ۪ارِ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وُجُوهِهِمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "ذُوقُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَسَّ", "translit": "", "root": ""}, {"id": 9, "arabic": "سَقَرَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 49, "text": "إِنَّا كُلَّ شَےْءٍ خَلَقْنَٰهُ بِقَدَرࣲۖ", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلَقْنَٰهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِقَدَرࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 50, "text": "وَمَآ أَمْرُنَآ إِلَّا وَٰحِدَةࣱ كَلَمْحِۢ بِالْبَصَرِۖ", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَمْرُنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 4, "arabic": "وَٰحِدَةࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَلَمْحِۢ", "translit": "", "root": ""}, {"id": 6, "arabic": "بِالْبَصَرِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 51, "text": "وَلَقَدَ اَهْلَكْنَآ أَشْيَاعَكُمْ فَهَلْ مِن مُّدَّكِرࣲۖ", "words": [{"id": 1, "arabic": "وَلَقَدَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَهْلَكْنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَشْيَاعَكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَهَلْ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّدَّكِرࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 52, "text": "وَكُلُّ شَےْءࣲ فَعَلُوهُ فِے اِ۬لزُّبُرِۖ", "words": [{"id": 1, "arabic": "وَكُلُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَعَلُوهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لزُّبُرِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 53, "text": "وَكُلُّ صَغِيرࣲ وَكَبِيرࣲ مُّسْتَطَرٌۖ", "words": [{"id": 1, "arabic": "وَكُلُّ", "translit": "", "root": ""}, {"id": 2, "arabic": "صَغِيرࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَكَبِيرࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "مُّسْتَطَرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 54, "text": "اِنَّ اَ۬لْمُتَّقِينَ فِے جَنَّٰتࣲ وَنَهَرࣲ‏", "words": [{"id": 1, "arabic": "اِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لْمُتَّقِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "جَنَّٰتࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَنَهَرࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 55, "text": "فِے مَقْعَدِ صِدْقٍ عِندَ مَلِيكࣲ مُّقْتَدِرٍۖ", "words": [{"id": 1, "arabic": "فِے", "translit": "", "root": ""}, {"id": 2, "arabic": "مَقْعَدِ", "translit": "", "root": ""}, {"id": 3, "arabic": "صِدْقٍ", "translit"