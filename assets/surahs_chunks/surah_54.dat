{"surah": 54, "verses": [{"ayah": 1, "text": "ٱقْتَرَبَتِ ٱلسَّاعَةُ وَٱنشَقَّ ٱلْقَمَرُ ", "translation": "The Hour has come near, and the moon has split [in two].[1]", "words": [{"id": 1, "arabic": "ٱقْتَرَبَتِ", "translit": "ِtَbَrَtْqٱ", "root": "قرب"}, {"id": 2, "arabic": "ٱلسَّاعَةُ", "translit": "ُẗَʿعāَّslٱ", "root": "سوع"}, {"id": 3, "arabic": "وَٱنشَقَّ", "translit": "َّqَhsnٱَw", "root": "شقق"}, {"id": 4, "arabic": "ٱلْقَمَرُ", "translit": "ُrَmَqْlٱ", "root": "قمر"}], "hasIhya": true}, {"ayah": 2, "text": "وَإِن يَرَوْا۟ ءَايَةً يُعْرِضُوا۟ وَيَقُولُوا۟ سِحْرٌ مُّسْتَمِرٌّ ", "translation": "And if they see a sign [i.e., miracle], they turn away and say, \"Passing magic.\"[1]", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "يَرَوْا۟", "translit": "۟āْwَrَy", "root": "راي"}, {"id": 3, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 4, "arabic": "يُعْرِضُوا۟", "translit": "۟āwُḍِrْʿعُy", "root": "عرض"}, {"id": 5, "arabic": "وَيَقُولُوا۟", "translit": "۟āwُlwُqَyَw", "root": "قول"}, {"id": 6, "arabic": "سِحْرٌ", "translit": "ٌrْḥِs", "root": "سحر"}, {"id": 7, "arabic": "مُّسْتَمِرٌّ", "translit": "ٌّrِmَtْsُّm", "root": "مرر"}], "hasIhya": false}, {"ayah": 3, "text": "وَكَذَّبُوا۟ وَٱتَّبَعُوٓا۟ أَهْوَآءَهُمْۚ وَكُلُّ أَمْرٍ مُّسْتَقِرٌّ ", "translation": "And they denied and followed their inclinations. But for every matter is a [time of] settlement.", "words": [{"id": 1, "arabic": "وَكَذَّبُوا۟", "translit": "۟āwُbَّhdَkَw", "root": "كذب"}, {"id": 2, "arabic": "وَٱتَّبَعُوٓا۟", "translit": "۟āٓwُʿعَbَّtٱَw", "root": "تبع"}, {"id": 3, "arabic": "أَهْوَآءَهُمْ", "translit": "ْmُhَءٓāَwْhَaʾ", "root": "هوي"}, {"id": 4, "arabic": "وَكُلُّ", "translit": "ُّlُkَw", "root": "كلل"}, {"id": 5, "arabic": "أَمْرٍ", "translit": "ٍrْmَaʾ", "root": "امر"}, {"id": 6, "arabic": "مُّسْتَقِرٌّ", "translit": "ٌّrِqَtْsُّm", "root": "قرر"}], "hasIhya": false}, {"ayah": 4, "text": "وَلَقَدْ جَآءَهُم مِّنَ ٱلْأَنۢبَآءِ مَا فِيهِ مُزْدَجَرٌ ", "translation": "And there has already come to them of information that in which there is deterrence.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَهُم", "translit": "mُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْأَنۢبَآءِ", "translit": "ِءٓāَbۢnَaʾْlٱ", "root": "نبا"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 7, "arabic": "مُزْدَجَرٌ", "translit": "ٌrَjgَdْzُm", "root": "زجر"}], "hasIhya": false}, {"ayah": 5, "text": "حِكْمَةٌۢ بَٰلِغَةٌۖ فَمَا تُغْنِ ٱلنُّذُرُ ", "translation": "Extensive wisdom - but warning does not avail [them].", "words": [{"id": 1, "arabic": "حِكْمَةٌۢ", "translit": "ٌۢẗَmْkِḥ", "root": "حكم"}, {"id": 2, "arabic": "بَٰلِغَةٌ", "translit": "ٌẗَغِlَٰb", "root": "بلغ"}, {"id": 3, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 4, "arabic": "تُغْنِ", "translit": "ِnْغُt", "root": "غني"}, {"id": 5, "arabic": "ٱلنُّذُرُ", "translit": "ُrُhdُّnlٱ", "root": "نذر"}], "hasIhya": false}, {"ayah": 6, "text": "فَتَوَلَّ عَنْهُمْۘ يَوْمَ يَدْعُ ٱلدَّاعِ إِلَىٰ شَىْءٍ نُّكُرٍ ", "translation": "So leave them, [O Muḥammad]. The Day the Caller[1] calls to something forbidding,", "words": [{"id": 1, "arabic": "فَتَوَلَّ", "translit": "َّlَwَtَf", "root": "ولي"}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 3, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 4, "arabic": "يَدْعُ", "translit": "ُʿعْdَy", "root": "دعو"}, {"id": 5, "arabic": "ٱلدَّاعِ", "translit": "ِʿعāَّdlٱ", "root": "دعو"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 8, "arabic": "نُّكُرٍ", "translit": "ٍrُkُّn", "root": "نكر"}], "hasIhya": false}, {"ayah": 7, "text": "خُشَّعًا أَبْصَٰرُهُمْ يَخْرُجُونَ مِنَ ٱلْأَجْدَاثِ كَأَنَّهُمْ جَرَادٌ مُّنتَشِرٌ ", "translation": "Their eyes humbled, they will emerge from the graves as if they were locusts spreading,", "words": [{"id": 1, "arabic": "خُشَّعًا", "translit": "āًʿعَّhsُhk", "root": "خشع"}, {"id": 2, "arabic": "أَبْصَٰرُهُمْ", "translit": "ْmُhُrَٰṣْbَaʾ", "root": "بصر"}, {"id": 3, "arabic": "يَخْرُجُونَ", "translit": "َnwُjgُrْhkَy", "root": "خرج"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْأَجْدَاثِ", "translit": "ِhtāَdْjgَaʾْlٱ", "root": "جدث"}, {"id": 6, "arabic": "كَأَنَّهُمْ", "translit": "ْmُhَّnَaʾَk", "root": ""}, {"id": 7, "arabic": "جَرَادٌ", "translit": "ٌdāَrَjg", "root": "جرد"}, {"id": 8, "arabic": "مُّنتَشِرٌ", "translit": "ٌrِhsَtnُّm", "root": "نشر"}], "hasIhya": false}, {"ayah": 8, "text": "مُّهْطِعِينَ إِلَى ٱلدَّاعِۖ يَقُولُ ٱلْكَٰفِرُونَ هَٰذَا يَوْمٌ عَسِرٌ ", "translation": "Racing ahead toward the Caller. The disbelievers will say, \"This is a difficult Day.\"", "words": [{"id": 1, "arabic": "مُّهْطِعِينَ", "translit": "َnyِʿعِṭْhُّm", "root": "هطع"}, {"id": 2, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 3, "arabic": "ٱلدَّاعِ", "translit": "ِʿعāَّdlٱ", "root": "دعو"}, {"id": 4, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 5, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}, {"id": 6, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 7, "arabic": "يَوْمٌ", "translit": "ٌmْwَy", "root": "يوم"}, {"id": 8, "arabic": "عَسِرٌ", "translit": "ٌrِsَʿع", "root": "عسر"}], "hasIhya": false}, {"ayah": 9, "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ فَكَذَّبُوا۟ عَبْدَنَا وَقَالُوا۟ مَجْنُونٌ وَٱزْدُجِرَ ", "translation": "The people of Noah denied before them, and they denied Our servant and said, \"A madman,\" and he was repelled.", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "ْtَbَّhdَk", "root": "كذب"}, {"id": 2, "arabic": "قَبْلَهُمْ", "translit": "ْmُhَlْbَq", "root": "قبل"}, {"id": 3, "arabic": "قَوْمُ", "translit": "ُmْwَq", "root": "قوم"}, {"id": 4, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 5, "arabic": "فَكَذَّبُوا۟", "translit": "۟āwُbَّhdَkَf", "root": "كذب"}, {"id": 6, "arabic": "عَبْدَنَا", "translit": "āَnَdْbَʿع", "root": "عبد"}, {"id": 7, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 8, "arabic": "مَجْنُونٌ", "translit": "ٌnwُnْjgَm", "root": "جنن"}, {"id": 9, "arabic": "وَٱزْدُجِرَ", "translit": "َrِjgُdْzٱَw", "root": "زجر"}], "hasIhya": false}, {"ayah": 10, "text": "فَدَعَا رَبَّهُۥٓ أَنِّى مَغْلُوبٌ فَٱنتَصِرْ ", "translation": "So he invoked his Lord, \"Indeed, I am overpowered, so help.\"", "words": [{"id": 1, "arabic": "فَدَعَا", "translit": "āَʿعَdَf", "root": "دعو"}, {"id": 2, "arabic": "رَبَّهُۥٓ", "translit": "ٓۥُhَّbَr", "root": "ربب"}, {"id": 3, "arabic": "أَنِّى", "translit": "àِّnَaʾ", "root": ""}, {"id": 4, "arabic": "مَغْلُوبٌ", "translit": "ٌbwُlْغَm", "root": "غلب"}, {"id": 5, "arabic": "فَٱنتَصِرْ", "translit": "ْrِṣَtnٱَf", "root": "نصر"}], "hasIhya": false}, {"ayah": 11, "text": "فَفَتَحْنَآ أَبْوَٰبَ ٱلسَّمَآءِ بِمَآءٍ مُّنْهَمِرٍ ", "translation": "Then We opened the gates of the heaven with rain pouring down", "words": [{"id": 1, "arabic": "فَفَتَحْنَآ", "translit": "ٓāَnْḥَtَfَf", "root": "فتح"}, {"id": 2, "arabic": "أَبْوَٰبَ", "translit": "َbَٰwْbَaʾ", "root": "بوب"}, {"id": 3, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 4, "arabic": "بِمَآءٍ", "translit": "ٍءٓāَmِb", "root": "موه"}, {"id": 5, "arabic": "مُّنْهَمِرٍ", "translit": "ٍrِmَhْnُّm", "root": "همر"}], "hasIhya": false}, {"ayah": 12, "text": "وَفَجَّرْنَا ٱلْأَرْضَ عُيُونًا فَٱلْتَقَى ٱلْمَآءُ عَلَىٰٓ أَمْرٍ قَدْ قُدِرَ ", "translation": "And caused the earth to burst with springs, and the waters met for a matter already predestined.", "words": [{"id": 1, "arabic": "وَفَجَّرْنَا", "translit": "āَnْrَّjgَfَw", "root": "فجر"}, {"id": 2, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 3, "arabic": "عُيُونًا", "translit": "āًnwُyُʿع", "root": "عين"}, {"id": 4, "arabic": "فَٱلْتَقَى", "translit": "àَqَtْlٱَf", "root": "لقي"}, {"id": 5, "arabic": "ٱلْمَآءُ", "translit": "ُءٓāَmْlٱ", "root": "موه"}, {"id": 6, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 7, "arabic": "أَمْرٍ", "translit": "ٍrْmَaʾ", "root": "امر"}, {"id": 8, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 9, "arabic": "قُدِرَ", "translit": "َrِdُq", "root": "قدر"}], "hasIhya": false}, {"ayah": 13, "text": "وَحَمَلْنَٰهُ عَلَىٰ ذَاتِ أَلْوَٰحٍ وَدُسُرٍ ", "translation": "And We carried him on a [construction of] planks and nails,", "words": [{"id": 1, "arabic": "وَحَمَلْنَٰهُ", "translit": "ُhَٰnْlَmَḥَw", "root": "حمل"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "ذَاتِ", "translit": "ِtāَhd", "root": ""}, {"id": 4, "arabic": "أَلْوَٰحٍ", "translit": "ٍḥَٰwْlَaʾ", "root": "لوح"}, {"id": 5, "arabic": "وَدُسُرٍ", "translit": "ٍrُsُdَw", "root": "دسر"}], "hasIhya": false}, {"ayah": 14, "text": "تَجْرِى بِأَعْيُنِنَا جَزَآءً لِّمَن كَانَ كُفِرَ ", "translation": "Sailing under Our observation as reward for he who had been denied.", "words": [{"id": 1, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 2, "arabic": "بِأَعْيُنِنَا", "translit": "āَnِnُyْʿعَaʾِb", "root": "عين"}, {"id": 3, "arabic": "جَزَآءً", "translit": "ًءٓāَzَjg", "root": "جزي"}, {"id": 4, "arabic": "لِّمَن", "translit": "nَmِّl", "root": ""}, {"id": 5, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 6, "arabic": "كُفِرَ", "translit": "َrِfُk", "root": "كفر"}], "hasIhya": false}, {"ayah": 15, "text": "وَلَقَد تَّرَكْنَٰهَآ ءَايَةً فَهَلْ مِن مُّدَّكِرٍ ", "translation": "And We left it as a sign, so is there any who will remember?", "words": [{"id": 1, "arabic": "وَلَقَد", "translit": "dَqَlَw", "root": ""}, {"id": 2, "arabic": "تَّرَكْنَٰهَآ", "translit": "ٓāَhَٰnْkَrَّt", "root": "ترك"}, {"id": 3, "arabic": "ءَايَةً", "translit": "ًẗَyāَء", "root": "ايي"}, {"id": 4, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "مُّدَّكِرٍ", "translit": "ٍrِkَّdُّm", "root": "ذكر"}], "hasIhya": false}, {"ayah": 16, "text": "فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ ", "translation": "And how [severe] were My punishment and warning.[1]", "words": [{"id": 1, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "عَذَابِى", "translit": "àِbāَhdَʿع", "root": "عذب"}, {"id": 4, "arabic": "وَنُذُرِ", "translit": "ِrُhdُnَw", "root": "نذر"}], "hasIhya": false}, {"ayah": 17, "text": "وَلَقَدْ يَسَّرْنَا ٱلْقُرْءَانَ لِلذِّكْرِ فَهَلْ مِن مُّدَّكِرٍ ", "translation": "And We have certainly made the Qur’ān easy for remembrance, so is there any who will remember?", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "يَسَّرْنَا", "translit": "āَnْrَّsَy", "root": "يسر"}, {"id": 3, "arabic": "ٱلْقُرْءَانَ", "translit": "َnāَءْrُqْlٱ", "root": "قرا"}, {"id": 4, "arabic": "لِلذِّكْرِ", "translit": "ِrْkِّhdlِl", "root": "ذكر"}, {"id": 5, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "مُّدَّكِرٍ", "translit": "ٍrِkَّdُّm", "root": "ذكر"}], "hasIhya": true}, {"ayah": 18, "text": "كَذَّبَتْ عَادٌ فَكَيْفَ كَانَ عَذَابِى وَنُذُرِ ", "translation": "ʿAad denied; and how [severe] were My punishment and warning.", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "ْtَbَّhdَk", "root": "كذب"}, {"id": 2, "arabic": "عَادٌ", "translit": "ٌdāَʿع", "root": "عود"}, {"id": 3, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 4, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 5, "arabic": "عَذَابِى", "translit":