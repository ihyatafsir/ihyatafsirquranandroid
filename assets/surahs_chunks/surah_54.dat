: "ك", "grapheme": "ك", "start": 4694, "end": 4946, "duration": 252, "peakTime": 4820}, {"wordIdx": 4, "charIdx": 4, "char": "ࣲ", "grapheme": "ࣲ", "start": 4946, "end": 5199, "duration": 253, "peakTime": 5072}, {"wordIdx": 5, "charIdx": 0, "char": "م", "grapheme": "م", "start": 5199, "end": 5452, "duration": 253, "peakTime": 5326}, {"wordIdx": 5, "charIdx": 1, "char": "ق", "grapheme": "ق", "start": 5452, "end": 5754, "duration": 302, "peakTime": 5603}, {"wordIdx": 5, "charIdx": 2, "char": "ت", "grapheme": "ت", "start": 5754, "end": 6007, "duration": 253, "peakTime": 5880}, {"wordIdx": 5, "charIdx": 3, "char": "د", "grapheme": "د", "start": 6007, "end": 6260, "duration": 253, "peakTime": 6134}, {"wordIdx": 5, "charIdx": 4, "char": "ر", "grapheme": "ر", "start": 6260, "end": 6512, "duration": 252, "peakTime": 6386}]}}, "warshVerses": [{"surah": 54, "ayah": 1, "text": "اُ۪قْتَرَبَتِ اِ۬لسَّاعَةُ وَانشَقَّ اَ۬لْقَمَرُۖ", "words": [{"id": 1, "arabic": "اُ۪قْتَرَبَتِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لسَّاعَةُ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَانشَقَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْقَمَرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 2, "text": "وَإِنْ يَّرَوَاْ اٰيَةࣰ يُعْرِضُواْ وَيَقُولُواْ سِحْرࣱ مُّسْتَمِرࣱّۖ", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَّرَوَاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اٰيَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "يُعْرِضُواْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيَقُولُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "سِحْرࣱ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُّسْتَمِرࣱّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 3, "text": "وَكَذَّبُواْ وَاتَّبَعُوٓاْ أَهْوَآءَهُمْۖ وَكُلُّ أَمْرࣲ مُّسْتَقِرࣱّۖ", "words": [{"id": 1, "arabic": "وَكَذَّبُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَاتَّبَعُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَهْوَآءَهُمْۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَكُلُّ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَمْرࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّسْتَقِرࣱّۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 4, "text": "وَلَقَدْ جَآءَهُم مِّنَ اَ۬لَانۢبَآءِ مَا فِيهِ مُزْدَجَرٌۖ", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لَانۢبَآءِ", "translit": "", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "", "root": ""}, {"id": 6, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُزْدَجَرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 5, "text": "حِكْمَةُۢ بَٰلِغَةࣱۖ فَمَا تُغْنِ اِ۬لنُّذُرُۖ", "words": [{"id": 1, "arabic": "حِكْمَةُۢ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَٰلِغَةࣱۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تُغْنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لنُّذُرُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 6, "text": "فَتَوَلَّ عَنْهُمْۖ يَوْمَ يَدْعُ اُ۬لدَّاعِۦٓ إِلَيٰ شَےْءࣲ نُّكُرٍ", "words": [{"id": 1, "arabic": "فَتَوَلَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُمْۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَدْعُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لدَّاعِۦٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 7, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "نُّكُرٍ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 7, "text": "خُشَّعاً اَبْصَٰرُهُمْ يَخْرُجُونَ مِنَ اَ۬لَاجْدَاثِ كَأَنَّهُمْ جَرَادࣱ مُّنتَشِرࣱ‏", "words": [{"id": 1, "arabic": "خُشَّعاً", "translit": "", "root": ""}, {"id": 2, "arabic": "اَبْصَٰرُهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَخْرُجُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لَاجْدَاثِ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَأَنَّهُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "جَرَادࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّنتَشِرࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 8, "text": "مُّهْطِعِينَ إِلَي اَ۬لدَّاعِۦۖ يَقُولُ اُ۬لْكَٰفِرُونَ هَٰذَا يَوْمٌ عَسِرࣱۖ", "words": [{"id": 1, "arabic": "مُّهْطِعِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لدَّاعِۦۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "يَقُولُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْكَٰفِرُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "يَوْمٌ", "translit": "", "root": ""}, {"id": 8, "arabic": "عَسِرࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 9, "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحࣲ فَكَذَّبُواْ عَبْدَنَا وَقَالُواْ مَجْنُونࣱ وَازْدُجِرَۖ", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَبْلَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْمُ", "translit": "", "root": ""}, {"id": 4, "arabic": "نُوحࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَكَذَّبُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَبْدَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "مَجْنُونࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَازْدُجِرَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 10, "text": "۞فَدَعَا رَبَّهُۥٓ أَنِّے مَغْلُوبࣱ فَانتَصِرْۖ", "words": [{"id": 1, "arabic": "۞فَدَعَا", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "مَغْلُوبࣱ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَانتَصِرْۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 11, "text": "فَفَتَحْنَآ أَبْوَٰبَ اَ۬لسَّمَآءِ بِمَآءࣲ مُّنْهَمِرࣲۖ", "words": [{"id": 1, "arabic": "فَفَتَحْنَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَبْوَٰبَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِمَآءࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مُّنْهَمِرࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 12, "text": "وَفَجَّرْنَا اَ۬لَارْضَ عُيُوناࣰ فَالْتَقَي اَ۬لْمَآءُ عَلَيٰٓ أَمْرࣲ قَدْ قُدِرَۖ", "words": [{"id": 1, "arabic": "وَفَجَّرْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لَارْضَ", "translit": "", "root": ""}, {"id": 3, "arabic": "عُيُوناࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "فَالْتَقَي", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمَآءُ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيٰٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "أَمْرࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "قَدْ", "translit": "", "root": ""}, {"id": 9, "arabic": "قُدِرَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah": 13, "text": "وَحَمَلْنَٰهُ عَلَيٰ ذَاتِ أَلْوَٰحࣲ وَدُسُرࣲۖ", "words": [{"id": 1, "arabic": "وَحَمَلْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "ذَاتِ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَلْوَٰحࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَدُسُرࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 54, "ayah":