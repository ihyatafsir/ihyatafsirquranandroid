نُوحٍ","translit":"ٍḥwُn","root":""},{"id":5,"arabic":"وَعَادٍ","translit":"ٍdāَʿعَw","root":"عود"},{"id":6,"arabic":"وَثَمُودَ","translit":"َdwُmَhtَw","root":""},{"id":7,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":8,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":9,"arabic":"بَعْدِهِمْ","translit":"ْmِhِdْʿعَb","root":"بعد"},{"id":10,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":11,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":12,"arabic":"يُرِيدُ","translit":"ُdyِrُy","root":"رود"},{"id":13,"arabic":"ظُلْمًا","translit":"āًmْlُẓ","root":"ظلم"},{"id":14,"arabic":"لِّلْعِبَادِ","translit":"ِdāَbِʿعْlِّl","root":"عبد"}],"hasIhya":false},{"ayah":32,"text":"وَيَٰقَوْمِ إِنِّىٓ أَخَافُ عَلَيْكُمْ يَوْمَ ٱلتَّنَادِ ","translation":"And O my people, indeed I fear for you the Day of Calling[1] -","words":[{"id":1,"arabic":"وَيَٰقَوْمِ","translit":"ِmْwَqَٰyَw","root":"قوم"},{"id":2,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":3,"arabic":"أَخَافُ","translit":"ُfāَhkَaʾ","root":"خوف"},{"id":4,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":5,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":6,"arabic":"ٱلتَّنَادِ","translit":"ِdāَnَّtlٱ","root":"ندي"}],"hasIhya":false},{"ayah":33,"text":"يَوْمَ تُوَلُّونَ مُدْبِرِينَ مَا لَكُم مِّنَ ٱللَّهِ مِنْ عَاصِمٍۗ وَمَن يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِنْ هَادٍ ","translation":"The Day you will turn your backs fleeing; there is not for you from Allāh any protector. And whoever Allāh sends astray - there is not for him any guide.","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"تُوَلُّونَ","translit":"َnwُّlَwُt","root":"ولي"},{"id":3,"arabic":"مُدْبِرِينَ","translit":"َnyِrِbْdُm","root":"دبر"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":6,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"عَاصِمٍ","translit":"ٍmِṣāَʿع","root":"عصم"},{"id":10,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":11,"arabic":"يُضْلِلِ","translit":"ِlِlْḍُy","root":"ضلل"},{"id":12,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":13,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":14,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":15,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":16,"arabic":"هَادٍ","translit":"ٍdāَh","root":"هدي"}],"hasIhya":true},{"ayah":34,"text":"وَلَقَدْ جَآءَكُمْ يُوسُفُ مِن قَبْلُ بِٱلْبَيِّنَٰتِ فَمَا زِلْتُمْ فِى شَكٍّ مِّمَّا جَآءَكُم بِهِۦۖ حَتَّىٰٓ إِذَا هَلَكَ قُلْتُمْ لَن يَبْعَثَ ٱللَّهُ مِنۢ بَعْدِهِۦ رَسُولًاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَنْ هُوَ مُسْرِفٌ مُّرْتَابٌ ","translation":"And Joseph had already come to you before with clear proofs, but you remained in doubt of that which he brought to you, until when he died, you said, 'Never will Allāh send a messenger after him.' Thus does Allāh leave astray he who is a transgressor and skeptic.\"","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"جَآءَكُمْ","translit":"ْmُkَءٓāَjg","root":"جيا"},{"id":3,"arabic":"يُوسُفُ","translit":"ُfُswُy","root":""},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":6,"arabic":"بِٱلْبَيِّنَٰتِ","translit":"ِtَٰnِّyَbْlٱِb","root":"بين"},{"id":7,"arabic":"فَمَا","translit":"āَmَf","root":""},{"id":8,"arabic":"زِلْتُمْ","translit":"ْmُtْlِz","root":"زيل"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"شَكٍّ","translit":"ٍّkَhs","root":"شكك"},{"id":11,"arabic":"مِّمَّا","translit":"āَّmِّm","root":""},{"id":12,"arabic":"جَآءَكُم","translit":"mُkَءٓāَjg","root":"جيا"},{"id":13,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":14,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":15,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":16,"arabic":"هَلَكَ","translit":"َkَlَh","root":"هلك"},{"id":17,"arabic":"قُلْتُمْ","translit":"ْmُtْlُq","root":"قول"},{"id":18,"arabic":"لَن","translit":"nَl","root":""},{"id":19,"arabic":"يَبْعَثَ","translit":"َhtَʿعْbَy","root":"بعث"},{"id":20,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":21,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":22,"arabic":"بَعْدِهِۦ","translit":"ۦِhِdْʿعَb","root":"بعد"},{"id":23,"arabic":"رَسُولًا","translit":"āًlwُsَr","root":"رسل"},{"id":24,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":25,"arabic":"يُضِلُّ","translit":"ُّlِḍُy","root":"ضلل"},{"id":26,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":27,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":28,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":29,"arabic":"مُسْرِفٌ","translit":"ٌfِrْsُm","root":"سرف"},{"id":30,"arabic":"مُّرْتَابٌ","translit":"ٌbāَtْrُّm","root":"ريب"}],"hasIhya":false},{"ayah":35,"text":"ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِ ٱللَّهِ بِغَيْرِ سُلْطَٰنٍ أَتَىٰهُمْۖ كَبُرَ مَقْتًا عِندَ ٱللَّهِ وَعِندَ ٱلَّذِينَ ءَامَنُوا۟ۚ كَذَٰلِكَ يَطْبَعُ ٱللَّهُ عَلَىٰ كُلِّ قَلْبِ مُتَكَبِّرٍ جَبَّارٍ ","translation":"Those who dispute concerning the signs of Allāh without an authority[1] having come to them - great is hatred [of them] in the sight of Allāh and in the sight of those who have believed. Thus does Allāh seal over every heart [belonging to] an arrogant tyrant.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"يُجَٰدِلُونَ","translit":"َnwُlِdَٰjgُy","root":"جدل"},{"id":3,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":4,"arabic":"ءَايَٰتِ","translit":"ِtَٰyāَء","root":"ايي"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":7,"arabic":"سُلْطَٰنٍ","translit":"ٍnَٰṭْlُs","root":"سلط"},{"id":8,"arabic":"أَتَىٰهُمْ","translit":"ْmُhٰàَtَaʾ","root":"اتي"},{"id":9,"arabic":"كَبُرَ","translit":"َrُbَk","root":"كبر"},{"id":10,"arabic":"مَقْتًا","translit":"āًtْqَm","root":"مقت"},{"id":11,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"وَعِندَ","translit":"َdnِʿعَw","root":"عند"},{"id":14,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":15,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":16,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":17,"arabic":"يَطْبَعُ","translit":"ُʿعَbْṭَy","root":"طبع"},{"id":18,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":19,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":20,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":21,"arabic":"قَلْبِ","translit":"ِbْlَq","root":"قلب"},{"id":22,"arabic":"مُتَكَبِّرٍ","translit":"ٍrِّbَkَtُm","root":"كبر"},{"id":23,"arabic":"جَبَّارٍ","translit":"ٍrāَّbَjg","root":"جبر"}],"hasIhya":true},{"ayah":36,"text":"وَقَالَ فِرْعَوْنُ يَٰهَٰمَٰنُ ٱبْنِ لِى صَرْحًا لَّعَلِّىٓ أَبْلُغُ ٱلْأَسْبَٰبَ ","translation":"And Pharaoh said, \"O Hāmān, construct for me a tower that I might reach the ways[1] -","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"فِرْعَوْنُ","translit":"ُnْwَʿعْrِf","root":""},{"id":3,"arabic":"يَٰهَٰمَٰنُ","translit":"ُnَٰmَٰhَٰy","root":""},{"id":4,"arabic":"ٱبْنِ","translit":"ِnْbٱ","root":"بني"},{"id":5,"arabic":"لِى","translit":"àِl","root":""},{"id":6,"arabic":"صَرْحًا","translit":"āًḥْrَṣ","root":"صرح"},{"id":7,"arabic":"لَّعَلِّىٓ","translit":"ٓàِّlَʿعَّl","root":""},{"id":8,"arabic":"أَبْلُغُ","translit":"ُغُlْbَaʾ","root":"بلغ"},{"id":9,"arabic":"ٱلْأَسْبَٰبَ","translit":"َbَٰbْsَaʾْlٱ","root":"سبب"}],"hasIhya":false},{"ayah":37,"text":"أَسْبَٰبَ ٱلسَّمَٰوَٰتِ فَأَطَّلِعَ إِلَىٰٓ إِلَٰهِ مُوسَىٰ وَإِنِّى لَأَظُنُّهُۥ كَٰذِبًاۚ وَكَذَٰلِكَ زُيِّنَ لِفِرْعَوْنَ سُوٓءُ عَمَلِهِۦ وَصُدَّ عَنِ ٱلسَّبِيلِۚ وَمَا كَيْدُ فِرْعَوْنَ إِلَّا فِى تَبَابٍ ","translation":"The ways into the heavens - so that I may look at the deity of Moses; but indeed, I think he is a liar.\" And thus was made attractive to Pharaoh the evil of his deed, and he was averted from the [right] way. And the plan of Pharaoh was not except in ruin.","words":[{"id":1,"arabic":"أَسْبَٰبَ","translit":"َbَٰbْsَaʾ","root":"سبب"},{"id":2,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":3,"arabic":"فَأَطَّلِعَ","translit":"َʿعِlَّṭَaʾَf","root":"طلع"},{"id":4,"arabic":"إِلَىٰٓ","translit":"ٰٓàَlِiʾ","root":""},{"id":5,"arabic":"إِلَٰهِ","translit":"ِhَٰlِiʾ","root":"اله"},{"id":6,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":7,"arabic":"وَإِنِّى","translit":"àِّnِiʾَw","root":""},{"id":8,"arabic":"لَأَظُنُّهُۥ","translit":"ۥُhُّnُẓَaʾَl","root":"ظنن"},{"id":9,"arabic":"كَٰذِبًا","translit":"āًbِhdَٰk","root":"كذب"},{"id":10,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":11,"arabic":"زُيِّنَ","translit":"َnِّyُz","root":"زين"},{"id":12,"arabic":"لِفِرْعَوْنَ","translit":"َnْwَʿعْrِfِl","root":""},{"id":13,"arabic":"سُوٓءُ","translit":"ُءٓwُs","root":"سوا"},{"id":14,"arabic":"عَمَلِهِۦ","translit":"ۦِhِlَmَʿع","root":"عمل"},{"id":15,"arabic":"وَصُدَّ","translit":"َّdُṣَw","root":"صدد"},{"id":16,"arabic":"عَنِ","translit":"ِnَʿع","root":""},{"id":17,"arabic":"ٱلسَّبِيلِ","translit":"ِlyِbَّslٱ","root":"سبل"},{"id":18,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":19,"arabic":"كَيْدُ","translit":"ُdْyَk","root":"كيد"},{"id":20,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":21,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":22,"arabic":"فِى","translit":"àِf","root":""},{"id":23,"arabic":"تَبَابٍ","translit":"ٍbāَbَt","root":"تبب"}],"hasIhya":false},{"ayah":38,"text":"وَقَالَ ٱلَّذِىٓ ءَامَنَ يَٰقَوْمِ ٱتَّبِعُونِ أَهْدِكُمْ سَبِيلَ ٱلرَّشَادِ ","translation":"And he who believed said, \"O my people, follow me; I will guide you to the way of right conduct.","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنَ","translit":"َnَmāَء","root":"امن"},{"id":4,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":5,"arabic":"ٱتَّبِعُونِ","translit":"ِnwُʿعِbَّtٱ","root":"تبع"},{"id":6,"arabic":"أَهْدِكُمْ","translit":"ْmُkِdْhَaʾ","root":"هدي"},{"id":7,"arabic":"سَبِيلَ","translit":"َlyِbَs","root":"سبل"},{"id":8,"arabic":"ٱلرَّشَادِ","translit":"ِdāَhsَّrlٱ","root":"رشد"}],"hasIhya":false},{"ayah":39,"text":"يَٰقَوْمِ إِنَّمَا هَٰذِهِ ٱلْحَيَوٰةُ ٱلدُّنْيَا مَتَٰعٌ وَإِنَّ ٱلْءَاخِرَةَ هِىَ دَارُ ٱلْقَرَارِ ","translation":"O my people, this worldly life is only [temporary] enjoyment, and indeed, the Hereafter - that is the home of [permanent] settlement.","words":[{"id":1,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":2,"arabic":"إِنَّمَا","translit":"āَmَّnِiʾ","root":""},{"id":3,"arabic":"هَٰذِهِ","translit":"ِhِhdَٰh","root":""},{"id":4,"arabic":"ٱلْحَيَوٰةُ","translit":"ُẗٰwَyَḥْlٱ","root":"حيي"},{"id":5,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":6,"arabic":"مَتَٰعٌ","translit":"ٌʿعَٰtَm","root":"متع"},{"id":7,"arabic":"وَإِنَّ","translit":"َّnِiʾَw","root":""},{"id":8,"arabic":"ٱلْءَاخِرَةَ","translit":"َẗَrِhkāَءْlٱ","root":"اخر"},{"id":9,"arabic":"هِىَ","translit":"َàِh","root":""},{"id":10,"arabic":"دَارُ","translit":"ُrāَd","root":"دور"},{"id":11,"arabic":"ٱلْقَرَارِ","translit":"ِrāَrَqْlٱ","root":"قرر"}],"hasIhya":false},{"ayah":40,"text":"مَنْ عَمِلَ سَيِّئَةً فَلَا يُجْزَىٰٓ إِلَّا مِثْلَهَاۖ وَمَنْ عَمِلَ صَٰلِحًا مِّن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَأُو۟لَٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ يُرْزَقُونَ فِيهَا بِغَيْرِ حِسَابٍ ","translation":"Whoever does an evil deed will not be recompensed except by the like thereof; but whoever does righteousness, whether male or female, while he is a believer - those will enter Paradise, being given provision therein without account.","words":[{"id":1,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":2,"arabic":"عَمِلَ","translit":"َlِmَʿع","root":"عمل"},{"id":3,"arabic":"سَيِّئَةً","translit":"ًẗَyʾِّyَs","root":"سوا"},{"id":4,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":5,"arabic":"يُجْزَىٰٓ","translit":"ٰٓàَzْjgُy","root":"جزي"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"مِثْلَهَا","translit":"āَhَlْhtِm","root":"مثل"},{"id":8,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":9,"arabic":"عَمِلَ","translit":"َlِmَʿع","root":"عمل"},{"id":10,"arabic":"صَٰلِحًا","translit":"āًḥِlَٰṣ","root":"صلح"},{"id":11,"arabic":"مِّن","translit":"nِّm","root":""},{"id":12,"arabic":"ذَكَرٍ","translit":"ٍrَkَhd","root":"ذكر"},{"id":13,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":14,"arabic":"أُنثَىٰ","translit":"ٰàَhtnُaʾ","root":"انث"},{"id":15,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":16,"arabic":"مُؤْمِنٌ","translit":"ٌnِmْwʾُm","root":"امن"},{"id":17,"arabic":"فَأُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾَf","root":""},{"id":18,"arabic":"يَدْخُلُونَ","translit":"َnwُlُhkْdَy","root":"دخل"},{"id":19,"arabic":"ٱلْجَنَّةَ","translit":"َẗَّnَjgْlٱ","root":"جنن"},{"id":20,"arabic":"يُرْزَقُونَ","translit":"َnwُqَzْrُy","root":"رزق"},{"id":21,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":22,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":23,"arabic":"حِسَابٍ","translit":"ٍbāَsِḥ","root":"حسب"}],"hasIhya":false},{"ayah":41,"text":"وَيَٰقَوْمِ مَا لِىٓ أَدْعُوكُمْ إِلَى ٱلنَّجَوٰةِ وَتَدْعُونَنِىٓ إِلَى ٱلنَّارِ ","translation":"And O my people, how is it that I invite you to salvation while you invite me to the Fire?","words":[{"id":1,"arabic":"وَيَٰقَوْمِ","translit":"ِmْwَqَٰyَw","root":"قوم"},{"id":2,"arabic":"مَا","translit":"āَm","root":""},{"id":3,"arabic":"لِىٓ","translit":"ٓàِl","root":""},{"id":4,"arabic":"أَدْعُوكُمْ","translit":"ْmُkwُʿعْdَaʾ","root":"دعو"},{"id":5,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":6,"arabic":"ٱلنَّجَوٰةِ","translit":"ِẗٰwَjgَّnlٱ","root":"نجو"},{"id":7,"arabic":"وَتَدْعُونَنِىٓ","translit":"ٓàِnَnwُʿعْdَtَw","root":"دعو"},{"id":8,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":9,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"}],"hasIhya":false},{"ayah":42,"text":"تَدْعُونَنِى لِأَكْفُرَ بِٱللَّهِ وَأُشْرِكَ بِهِۦ مَا لَيْسَ لِى بِهِۦ عِلْمٌ وَأَنَا۠ أَدْعُوكُمْ إِلَى ٱلْعَزِيزِ ٱلْغَفَّٰرِ ","translation":"You invite me to disbelieve in Allāh and associate with Him that of which I have no knowledge, and I invite you to the Exalted in Might, the Perpetual Forgiver.[1]","words":[{"id":1,"arabic":"تَدْعُونَنِى","translit":"àِnَnwُʿعْdَt","root":"دعو"},{"id":2,"arabic":"لِأَكْفُرَ","translit":"َrُfْkَaʾِl","root":"كفر"},{"id":3,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":4,"arabic":"وَأُشْرِكَ","translit":"َkِrْhsُaʾَw","root":"شرك"},{"id":5,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":8,"arabic":"لِى","translit":"àِl","root":""},{"id":9,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":10,"arabic":"عِلْمٌ","translit":"ٌmْlِʿع","root":"علم"},{"id":11,"arabic":"وَأَنَا۠","translit":"۠āَnَaʾَw","root":""},{"id":12,"arabic":"أَدْعُوكُمْ","translit":"ْmُkwُʿعْdَaʾ","root":"دعو"},{"id":13,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":14,"arabic":"ٱلْعَزِيزِ","translit":"ِzyِzَʿعْlٱ","root":"عزز"},{"id":15,"arabic":"ٱلْغَفَّٰرِ","translit":"ِrَّٰfَغْlٱ","root":"غفر"}],"hasIhya":false},{"ayah":43,"text":"لَا جَرَمَ أَنَّمَا تَدْعُونَنِىٓ إِلَيْهِ لَيْسَ لَهُۥ دَعْوَةٌ فِى ٱلدُّنْيَا وَلَا فِى ٱلْءَاخِرَةِ وَأَنَّ مَرَدَّنَآ إِلَى ٱللَّهِ وَأَنَّ ٱلْمُسْرِفِينَ هُمْ أَصْحَٰبُ ٱلنَّارِ ","translation":"Assuredly, that to which you invite me has no [response to a] supplication in this world or in the Hereafter; and indeed, our return is to Allāh, and indeed, the transgressors will be companions of the Fire.","words":[{"id":1,"arabic":"لَا","translit":"āَl","root":""},{"id":2,"arabic":"جَرَمَ","translit":"َmَrَjg","root":"جرم"},{"id":3,"arabic":"أَنَّمَا","translit":"āَmَّnَaʾ","root":""},{"id":4,"arabic":"تَدْعُونَنِىٓ","translit":"ٓàِnَnwُʿعْdَt","root":"دعو"},{"id":5,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":6,"arabic":"لَيْسَ","translit":"َsْyَl","root":"ليس"},{"id":7,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":8,"arabic":"دَعْوَةٌ","translit":"ٌẗَwْʿعَd","root":"دعو"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":11,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"ٱلْءَاخِرَةِ","translit":"ِẗَrِhkāَءْlٱ","root":"اخر"},{"id":14,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":15,"arabic":"مَرَدَّنَآ","translit":"ٓāَnَّdَrَm","root":"ردد"},{"id":16,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":19,"arabic":"ٱلْمُسْرِفِينَ","translit":"َnyِfِrْsُmْlٱ","root":"سرف"},{"id":20,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":21,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":22,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"}],"hasIhya":true},{"ayah":44,"text":"فَسَتَذْكُرُونَ مَآ أَقُولُ لَكُمْۚ وَأُفَوِّضُ أَمْرِىٓ إِلَى ٱللَّهِۚ إِنَّ ٱللَّهَ بَصِيرٌۢ بِٱلْعِبَادِ ","translation":"And you will remember what I [now] say to you, and I entrust my affair to Allāh. Indeed, Allāh is Seeing of [His] servants.\"","words":[{"id":1,"arabic":"فَسَتَذْكُرُونَ","translit":"َnwُrُkْhdَtَsَf","root":"ذكر"},{"id":2,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":3,"arabic":"أَقُولُ","translit":"ُlwُqَaʾ","root":"قول"},{"id":4,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":5,"arabic":"وَأُفَوِّضُ","translit":"ُḍِّwَfُaʾَw","root":"فوض"},{"id":6,"arabic":"أَمْرِىٓ","translit":"ٓàِrْmَaʾ","root":"امر"},{"id":7,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":10,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":11,"arabic":"بَصِيرٌۢ","translit":"ٌۢryِṣَb","root":"بصر"},{"id":12,"arabic":"بِٱلْعِبَادِ","translit":"ِdāَbِʿعْlٱِb","root":"عبد"}],"hasIhya":false},{"ayah":45,"text":"فَوَقَىٰهُ ٱللَّهُ سَيِّـَٔاتِ مَا مَكَرُوا۟ۖ وَحَاقَ بِـَٔالِ فِرْعَوْنَ سُوٓءُ ٱلْعَذَابِ ","translation":"So Allāh protected him from the evils they plotted, and the people of Pharaoh were enveloped by the worst of punishment -","words":[{"id":1,"arabic":"فَوَقَىٰهُ","translit":"ُhٰàَqَwَf","root":"وقي"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"سَيِّـَٔاتِ","translit":"ِtāَٔـِّyَs","root":"سوا"},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"مَكَرُوا۟","translit":"۟āwُrَkَm","root":"مكر"},{"id":6,"arabic":"وَحَاقَ","translit":"َqāَḥَw","root":"حيق"},{"id":7,"arabic":"بِـَٔالِ","translit":"ِlāَٔـِb","root":"اول"},{"id":8,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":9,"arabic":"سُوٓءُ","translit":"ُءٓwُs","root":"سوا"},{"id":10,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"}],"hasIhya":false},{"ayah":46,"text":"ٱلنَّارُ يُعْرَضُونَ عَلَيْهَا غُدُوًّا وَعَشِيًّاۖ وَيَوْمَ تَقُومُ ٱلسَّاعَةُ أَدْخِلُوٓا۟ ءَالَ فِرْعَوْنَ أَشَدَّ ٱلْعَذَابِ ","translation":"The Fire; they are exposed to it morning and evening.[1] And the Day the Hour appears [it will be said], \"Make the people of Pharaoh enter the severest punishment.\"","words":[{"id":1,"arabic":"ٱلنَّارُ","translit":"ُrāَّnlٱ","root":"نور"},{"id":2,"arabic":"يُعْرَضُونَ","translit":"َnwُḍَrْʿعُy","root":"عرض"},{"id":3,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":4,"arabic":"غُدُوًّا","translit":"āًّwُdُغ","root":"غدو"},{"id":5,"arabic":"وَعَشِيًّا","translit":"āًّyِhsَʿعَw","root":"عشو"},{"id":6,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":7,"arabic":"تَقُومُ","translit":"ُmwُqَt","root":"قوم"},{"id":8,"arabic":"ٱلسَّاعَةُ","translit":"ُẗَʿعāَّslٱ","root":"سوع"},{"id":9,"arabic":"أَدْخِلُوٓا۟","translit":"۟āٓwُlِhkْdَaʾ","root":"دخل"},{"id":10,"arabic":"ءَالَ","translit":"َlāَء","root":"اول"},{"id":11,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":12,"arabic":"أَشَدَّ","translit":"َّdَhsَaʾ","root":"شدد"},{"id":13,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"}],"hasIhya":true},{"ayah":47,"text":"وَإِذْ يَتَحَآجُّونَ فِى ٱلنَّارِ فَيَقُولُ ٱلضُّعَفَٰٓؤُا۟ لِلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا كُنَّا لَكُمْ تَبَعًا فَهَلْ أَنتُم مُّغْنُونَ عَنَّا نَصِيبًا مِّنَ ٱلنَّارِ ","translation":"And [mention] when they will argue within the Fire, and the weak will say to those who had been arrogant, \"Indeed, we were [only] your followers, so will you relieve us of a share of the Fire?\"","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"يَتَحَآجُّونَ","translit":"َnwُّjgٓāَḥَtَy","root":"حجج"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":5,"arabic":"فَيَقُولُ","translit":"ُlwُqَyَf","root":"قول"},{"id":6,"arabic":"ٱلضُّعَفَٰٓؤُا۟","translit":"۟āُwʾَٰٓfَʿعُّḍlٱ","root":"ضعف"},{"id":7,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":8,"arabic":"ٱسْتَكْبَرُوٓا۟","translit":"۟āٓwُrَbْkَtْsٱ","root":"كبر"},{"id":9,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":10,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":11,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":12,"arabic":"تَبَعًا","translit":"āًʿعَbَt","root":"تبع"},{"id":13,"arabic":"فَهَلْ","translit":"ْlَhَf","root":""},{"id":14,"arabic":"أَنتُم","translit":"mُtnَaʾ","root":""},{"id":15,"arabic":"مُّغْنُونَ","translit":"َnwُnْغُّm","root":"غني"},{"id":16,"arabic":"عَنَّا","translit":"āَّnَʿع","root":""},{"id":17,"arabic":"نَصِيبًا","translit":"āًbyِṣَn","root":"نصب"},{"id":18,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":19,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"}],"hasIhya":false},{"ayah":48,"text":"قَالَ ٱلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا كُلٌّ فِيهَآ إِنَّ ٱللَّهَ قَدْ حَكَمَ بَيْنَ ٱلْعِبَادِ ","translation":"Those who had been arrogant will say, \"Indeed, all [of us] are in it. Indeed, Allāh has judged between the servants.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ٱسْتَكْبَرُوٓا۟","translit":"۟āٓwُrَbْkَtْsٱ","root":"كبر"},{"id":4,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":5,"arabic":"كُلٌّ","translit":"ٌّlُk","root":"كلل"},{"id":6,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":7,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":8,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":9,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":10,"arabic":"حَكَمَ","translit":"َmَkَḥ","root":"حكم"},{"id":11,"arabic":"بَيْنَ","translit":"َnْyَb","root":"بين"},{"id":12,"arabic":"ٱلْعِبَادِ","translit":"ِdāَbِʿعْlٱ","root":"عبد"}],"hasIhya":true},{"ayah":49,"text":"وَقَالَ ٱلَّذِينَ فِى ٱلنَّارِ لِخَزَنَةِ جَهَنَّمَ ٱدْعُوا۟ رَبَّكُمْ يُخَفِّفْ عَنَّا يَوْمًا مِّنَ ٱلْعَذَابِ ","translation":"And those in the Fire will say to the keepers of Hell, \"Supplicate your Lord to lighten for us a day from the punishment.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":5,"arabic":"لِخَزَنَةِ","translit":"ِẗَnَzَhkِl","root":"خزن"},{"id":6,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":7,"arabic":"ٱدْعُوا۟","translit":"۟āwُʿعْdٱ","root":"دعو"},{"id":8,"arabic":"رَبَّكُمْ","translit":"ْmُkَّbَr","root":"ربب"},{"id":9,"arabic":"يُخَفِّفْ","translit":"ْfِّfَhkُy","root":"خفف"},{"id":10,"arabic":"عَنَّا","translit":"āَّnَʿع","root":""},{"id":11,"arabic":"يَوْمًا","translit":"āًmْwَy","root":"يوم"},{"id":12,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":13,"arabic":"ٱلْعَذَابِ","translit":"ِbāَhdَʿعْlٱ","root":"عذب"}],"hasIhya":true},{"ayah":50,"text":"قَالُوٓا۟ أَوَلَمْ تَكُ تَأْتِيكُمْ رُسُلُكُم بِٱلْبَيِّنَٰتِۖ قَالُوا۟ بَلَىٰۚ قَالُوا۟ فَٱدْعُوا۟ۗ وَمَا دُعَٰٓؤُا۟ ٱلْكَٰفِرِينَ إِلَّا فِى ضَلَٰلٍ ","translation":"They will say, \"Did there not come to you your messengers with clear proofs?\" They will say, \"Yes.\" They will reply, \"Then supplicate [yourselves], but the supplication of the disbelievers is not except in error [i.e., futility].\"","words":[{"id":1,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":2,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":3,"arabic":"تَكُ","translit":"ُkَt","root":"كون"},{"id":4,"arabic":"تَأْتِيكُمْ","translit":"ْmُkyِtْaʾَt","root":"اتي"},{"id":5,"arabic":"رُسُلُكُم","translit":"mُkُlُsُr","root":"رسل"},{"id":6,"arabic":"بِٱلْبَيِّنَٰتِ","translit":"ِtَٰnِّyَbْlٱِb","root":"بين"},{"id":7,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":8,"arabic":"بَلَىٰ","translit":"ٰàَlَb","root":""},{"id":9,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":10,"arabic":"فَٱدْعُوا۟","translit":"۟āwُʿعْdٱَf","root":"دعو"},{"id":11,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":12,"arabic":"دُعَٰٓؤُا۟","translit":"۟āُwʾَٰٓʿعُd","root":"دعو"},{"id":13,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"},{"id":14,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":15,"arabic":"فِى","translit":"àِf","root":""},{"id":16,"arabic":"ضَلَٰلٍ","translit":"ٍlَٰlَḍ","root":"ضلل"}],"hasIhya":true},{"ayah":51,"text":"إِنَّا لَنَنصُرُ رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَيَوْمَ يَقُومُ ٱلْأَشْهَٰدُ ","translation":"Indeed, We will support Our messengers and those who believe during the life of this world and on the Day when the witnesses will stand -","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"لَنَنصُرُ","translit":"ُrُṣnَnَl","root":"نصر"},{"id":3,"arabic":"رُسُلَنَا","translit":"āَnَlُsُr","root":"رسل"},{"id":4,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":5,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":8,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":9,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":10,"arabic":"يَقُومُ","translit":"ُmwُqَy","root":"قوم"},{"id":11,"arabic":"ٱلْأَشْهَٰدُ","translit":"ُdَٰhْhsَaʾْlٱ","root":"شهد"}],"hasIhya":false},{"ayah":52,"text":"يَوْمَ لَا يَنفَعُ ٱلظَّٰلِمِينَ مَعْذِرَتُهُمْۖ وَلَهُمُ ٱللَّعْنَةُ وَلَهُمْ سُوٓءُ ٱلدَّارِ ","translation":"The Day their excuse will not benefit the wrongdoers, and they will have the curse, and they will have the worst home [i.e., Hell].","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"يَنفَعُ","translit":"ُʿعَfnَy","root":"نفع"},{"id":4,"arabic":"ٱلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlٱ","root":"ظلم"},{"id":5,"arabic":"مَعْذِرَتُهُمْ","translit":"ْmُhُtَrِhdْʿعَm","root":"عذر"},{"id":6,"arabic":"وَلَهُمُ","translit":"ُmُhَlَw","root":""},{"id":7,"arabic":"ٱللَّعْنَةُ","translit":"ُẗَnْʿعَّllٱ","root":"لعن"},{"id":8,"arabic":"وَلَهُمْ","translit":"ْmُhَlَw","root":""},{"id":9,"arabic":"سُوٓءُ","translit":"ُءٓwُs","root":"سوا"},{"id":10,"arabic":"ٱلدَّارِ","translit":"ِrāَّdlٱ","root":"دور"}],"hasIhya":true},{"ayah":53,"text":"وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْهُدَىٰ وَأَوْرَثْنَا بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَٰبَ ","translation":"And We had certainly given Moses guidance, and We caused the Children of Israel to inherit the Scripture","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"ءَاتَيْنَا","translit":"āَnْyَtāَء","root":"اتي"},{"id":3,"arabic":"مُوسَى","translit":"àَswُm","root":""},{"id":4,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":5,"arabic":"وَأَوْرَثْنَا","translit":"āَnْhtَrْwَaʾَw","root":"ورث"},{"id":6,"arabic":"بَنِىٓ","translit":"ٓàِnَb","root":"بني"},{"id":7,"arabic":"إِسْرَٰٓءِيلَ","translit":"َlyِءَٰٓrْsِiʾ","root":""},{"id":8,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"}],"hasIhya":false},{"ayah":54,"text":"هُدًى وَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَٰبِ ","translation":"As guidance and a reminder for those of understanding.","words":[{"id":1,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"},{"id":2,"arabic":"وَذِكْرَىٰ","translit":"ٰàَrْkِhdَw","root":"ذكر"},{"id":3,"arabic":"لِأُو۟لِى","translit":"àِl۟wُaʾِl","root":""},{"id":4,"arabic":"ٱلْأَلْبَٰبِ","translit":"ِbَٰbْlَaʾْlٱ","root":"لبب"}],"hasIhya":false},{"ayah":55,"text":"فَٱصْبِرْ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ وَٱسْتَغْفِرْ لِذَنۢبِكَ وَسَبِّحْ بِحَمْدِ رَبِّكَ بِٱلْعَشِىِّ وَٱلْإِبْكَٰرِ ","translation":"So be patient, [O Muḥammad]. Indeed, the promise of Allāh is truth. And ask forgiveness for your sin[1] and exalt [Allāh] with praise of your Lord in the evening and the morning.","words":[{"id":1,"arabic":"فَٱصْبِرْ","translit":"ْrِbْṣٱَf","root":"صبر"},{"id":2,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":3,"arabic":"وَعْدَ","translit":"َdْʿعَw","root":"وعد"},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"حَقٌّ","translit":"ٌّqَḥ","root":"حقق"},{"id":6,"arabic":"وَٱسْتَغْفِرْ","translit":"ْrِfْغَtْsٱَw","root":"غفر"},{"id":7,"arabic":"لِذَنۢبِكَ","translit":"َkِbۢnَhdِl","root":"ذنب"},{"id":8,"arabic":"وَسَبِّحْ","translit":"ْḥِّbَsَw","root":"سبح"},{"id":9,"arabic":"بِحَمْدِ","translit":"ِdْmَḥِb","root":"حمد"},{"id":10,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":11,"arabic":"بِٱلْعَشِىِّ","translit":"ِّàِhsَʿعْlٱِb","root":"عشو"},{"id":12,"arabic":"وَٱلْإِبْكَٰرِ","translit":"ِrَٰkْbِiʾْlٱَw","root":"بكر"}],"hasIhya":true},{"ayah":56,"text":"إِنَّ ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِ ٱللَّهِ بِغَيْرِ سُلْطَٰنٍ أَتَىٰهُمْۙ إِن فِى صُدُورِهِمْ إِلَّا كِبْرٌ مَّا هُم بِبَٰلِغِيهِۚ فَٱسْتَعِذْ بِٱللَّهِۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ ","translation":"Indeed, those who dispute concerning the signs of Allāh without [any] evidence having come to them - there is not within their breasts except pride, [the extent of] which they cannot reach. So seek refuge in Allāh. Indeed, it is He who is the Hearing, the Seeing.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"يُجَٰدِلُونَ","translit":"َnwُlِdَٰjgُy","root":"جدل"},{"id":4,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":5,"arabic":"ءَايَٰتِ","translit":"ِtَٰyāَء","root":"ايي"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":8,"arabic":"سُلْطَٰنٍ","translit":"ٍnَٰṭْlُs","root":"سلط"},{"id":9,"arabic":"أَتَىٰهُمْ","translit":"ْmُhٰàَtَaʾ","root":"اتي"},{"id":10,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":11,"arabic":"فِى","translit":"àِf","root":""},{"id":12,"arabic":"صُدُورِهِمْ","translit":"ْmِhِrwُdُṣ","root":"صدر"},{"id":13,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":14,"arabic":"كِبْرٌ","translit":"ٌrْbِk","root":"كبر"},{"id":15,"arabic":"مَّا","translit":"āَّm","root":""},{"id":16,"arabic":"هُم","translit":"mُh","root":""},{"id":17,"arabic":"بِبَٰلِغِيهِ","translit":"ِhyِغِlَٰbِb","root":"بلغ"},{"id":18,"arabic":"فَٱسْتَعِذْ","translit":"ْhdِʿعَtْsٱَf","root":"عوذ"},{"id":19,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":20,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":21,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":22,"arabic":"ٱلسَّمِيعُ","translit":"ُʿعyِmَّslٱ","root":"سمع"},{"id":23,"arabic":"ٱلْبَصِيرُ","translit":"ُryِṣَbْlٱ","root":"بصر"}],"hasIhya":true},{"ayah":57,"text":"لَخَلْقُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ أَكْبَرُ مِنْ خَلْقِ ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ","translation":"The creation of the heavens and earth is greater than the creation of mankind, but most of the people do not know.","words":[{"id":1,"arabic":"لَخَلْقُ","translit":"ُqْlَhkَl","root":"خلق"},{"id":2,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":3,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":4,"arabic":"أَكْبَرُ","translit":"ُrَbْkَaʾ","root":"كبر"},{"id":5,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":6,"arabic":"خَلْقِ","translit":"ِqْlَhk","root":"خلق"},{"id":7,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":8,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":9,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":10,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":11,"arabic":"لَا","translit":"āَl","root":""},{"id":12,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":58,"text":"وَمَا يَسْتَوِى ٱلْأَعْمَىٰ وَٱلْبَصِيرُ وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَلَا ٱلْمُسِىٓءُۚ قَلِيلًا مَّا تَتَذَكَّرُونَ ","translation":"And not equal are the blind and the seeing, nor are those who believe and do righteous deeds and the evildoer. Little do you remember.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"يَسْتَوِى","translit":"àِwَtْsَy","root":"سوي"},{"id":3,"arabic":"ٱلْأَعْمَىٰ","translit":"ٰàَmْʿعَaʾْlٱ","root":"عمي"},{"id":4,"arabic":"وَٱلْبَصِيرُ","translit":"ُryِṣَbْlٱَw","root":"بصر"},{"id":5,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":6,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":7,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":8,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":9,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":10,"arabic":"ٱلْمُسِىٓءُ","translit":"ُءٓàِsُmْlٱ","root":"سوا"},{"id":11,"arabic":"قَلِيلًا","translit":"āًlyِlَq","root":"قلل"},{"id":12,"arabic":"مَّا","translit":"āَّm","root":""},{"id":13,"arabic":"تَتَذَكَّرُونَ","translit":"َnwُrَّkَhdَtَt","root":"ذكر"}],"hasIhya":true},{"ayah":59,"text":"إِنَّ ٱلسَّاعَةَ لَءَاتِيَةٌ لَّا رَيْبَ فِيهَا وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يُؤْمِنُونَ ","translation":"Indeed, the Hour is coming - no doubt about it - but most of the people do not believe.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلسَّاعَةَ","translit":"َẗَʿعāَّslٱ","root":"سوع"},{"id":3,"arabic":"لَءَاتِيَةٌ","translit":"ٌẗَyِtāَءَl","root":"اتي"},{"id":4,"arabic":"لَّا","translit":"āَّl","root":""},{"id":5,"arabic":"رَيْبَ","translit":"َbْyَr","root":"ريب"},{"id":6,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":7,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":8,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":9,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":10,"arabic":"لَا","translit":"āَl","root":""},{"id":11,"arabic":"يُؤْمِنُونَ","translit":"َnwُnِmْwʾُy","root":"امن"}],"hasIhya":false},{"ayah":60,"text":"وَقَالَ رَبُّكُمُ ٱدْعُونِىٓ أَسْتَجِبْ لَكُمْۚ إِنَّ ٱلَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِى سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ ","translation":"And your Lord says, \"Call upon Me; I will respond to you.\" Indeed, those who disdain My worship will enter Hell [rendered] contemptible.","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"رَبُّكُمُ","translit":"ُmُkُّbَr","root":"ربب"},{"id":3,"arabic":"ٱدْعُونِىٓ","translit":"ٓàِnwُʿعْdٱ","root":"دعو"},{"id":4,"arabic":"أَسْتَجِبْ","translit":"ْbِjgَtْsَaʾ","root":"جوب"},{"id":5,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":6,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":7,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":8,"arabic":"يَسْتَكْبِرُونَ","translit":"َnwُrِbْkَtْsَy","root":"كبر"},{"id":9,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":10,"arabic":"عِبَادَتِى","translit":"àِtَdāَbِʿع","root":"عبد"},{"id":11,"arabic":"سَيَدْخُلُونَ","translit":"َnwُlُhkْdَyَs","root":"دخل"},{"id":12,"arabic":"جَهَنَّمَ","translit":"َmَّnَhَjg","root":""},{"id":13,"arabic":"دَاخِرِينَ","translit":"َnyِrِhkāَd","root":"دخر"}],"hasIhya":true},{"ayah":61,"text":"ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًاۚ إِنَّ ٱللَّهَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَشْكُرُونَ ","translation":"It is Allāh who made for you the night that you may rest therein and the day giving sight.[1] Indeed, Allāh is the possessor of bounty for the people, but most of them are not grateful.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":4,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":5,"arabic":"ٱلَّيْلَ","translit":"َlْyَّlٱ","root":"ليل"},{"id":6,"arabic":"لِتَسْكُنُوا۟","translit":"۟āwُnُkْsَtِl","root":"سكن"},{"id":7,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":8,"arabic":"وَٱلنَّهَارَ","translit":"َrāَhَّnlٱَw","root":"نهر"},{"id":9,"arabic":"مُبْصِرًا","translit":"āًrِṣْbُm","root":"بصر"},{"id":10,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":11,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":12,"arabic":"لَذُو","translit":"wُhdَl","root":""},{"id":13,"arabic":"فَضْلٍ","translit":"ٍlْḍَf","root":"فضل"},{"id":14,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":15,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":16,"arabic":"وَلَٰكِنَّ","translit":"َّnِkَٰlَw","root":""},{"id":17,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":18,"arabic":"ٱلنَّاسِ","translit":"ِsāَّnlٱ","root":"انس"},{"id":19,"arabic":"لَا","translit":"āَl","root":""},{"id":20,"arabic":"يَشْكُرُونَ","translit":"َnwُrُkْhsَy","root":"شكر"}],"hasIhya":false},{"ayah":62,"text":"ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ خَٰلِقُ كُلِّ شَىْءٍ لَّآ إِلَٰهَ إِلَّا هُوَۖ فَأَنَّىٰ تُؤْفَكُونَ ","translation":"That is Allāh, your Lord, Creator of all things; there is no deity except Him, so how are you deluded?","words":[{"id":1,"arabic":"ذَٰلِكُمُ","translit":"ُmُkِlَٰhd","root":""},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"رَبُّكُمْ","translit":"ْmُkُّbَr","root":"ربب"},{"id":4,"arabic":"خَٰلِقُ","translit":"ُqِlَٰhk","root":"خلق"},{"id":5,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":6,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":7,"arabic":"لَّآ","translit":"ٓāَّl","root":""},{"id":8,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":9,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":10,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":11,"arabic":"فَأَنَّىٰ","translit":"ٰàَّnَaʾَf","root":""},{"id":12,"arabic":"تُؤْفَكُونَ","translit":"َnwُkَfْwʾُt","root":"افك"}],"hasIhya":true},{"ayah":63,"text":"كَذَٰلِكَ يُؤْفَكُ ٱلَّذِينَ كَانُوا۟ بِـَٔايَٰتِ ٱللَّهِ يَجْحَدُونَ ","translation":"Thus were those [before you] deluded who were rejecting the signs of Allāh.","words":[{"id":1,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":2,"arabic":"يُؤْفَكُ","translit":"ُkَfْwʾُy","root":"افك"},{"id":3,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":4,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":5,"arabic":"بِـَٔايَٰتِ","translit":"ِtَٰyāَٔـِb","root":"ايي"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"يَجْحَدُونَ","translit":"َnwُdَḥْjgَy","root":"جحد"}],"hasIhya":false},{"ayah":64,"text":"ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ قَرَارًا وَٱلسَّمَآءَ بِنَآءً وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْۖ فَتَبَارَكَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ ","translation":"It is Allāh who made for you the earth a place of settlement and the sky a structure [i.e., ceiling] and formed you and perfected your forms and provided you with good things. That is Allāh, your Lord; then blessed is Allāh, Lord of the worlds.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":4,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":5,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"قَرَارًا","translit":"āًrāَrَq","root":"قرر"},{"id":7,"arabic":"وَٱلسَّمَآءَ","translit":"َءٓāَmَّslٱَw","root":"سمو"},{"id":8,"arabic":"بِنَآءً","translit":"ًءٓāَnِb","root":"بني"},{"id":9,"arabic":"وَصَوَّرَكُمْ","translit":"ْmُkَrَّwَṣَw","root":"صور"},{"id":10,"arabic":"فَأَحْسَنَ","translit":"َnَsْḥَaʾَf","root":"حسن"},{"id":11,"arabic":"صُوَرَكُمْ","translit":"ْmُkَrَwُṣ","root":"صور"},{"id":12,"arabic":"وَرَزَقَكُم","translit":"mُkَqَzَrَw","root":"رزق"},{"id":13,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":14,"arabic":"ٱلطَّيِّبَٰتِ","translit":"ِtَٰbِّyَّṭlٱ","root":"طيب"},{"id":15,"arabic":"ذَٰلِكُمُ","translit":"ُmُkِlَٰhd","root":""},{"id":16,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":17,"arabic":"رَبُّكُمْ","translit":"ْmُkُّbَr","root":"ربب"},{"id":18,"arabic":"فَتَبَارَكَ","translit":"َkَrāَbَtَf","root":"برك"},{"id":19,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":20,"arabic":"رَبُّ","translit":"ُّbَr","root":"ربب"},{"id":21,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":65,"text":"هُوَ ٱلْحَىُّ لَآ إِلَٰهَ إِلَّا هُوَ فَٱدْعُوهُ مُخْلِصِينَ لَهُ ٱلدِّينَۗ ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ ","translation":"He is the Ever-Living;[1] there is no deity except Him, so call upon Him, [being] sincere to Him in religion. [All] praise is [due] to Allāh, Lord of the worlds.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلْحَىُّ","translit":"ُّàَḥْlٱ","root":"حيي"},{"id":3,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":4,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":7,"arabic":"فَٱدْعُوهُ","translit":"ُhwُʿعْdٱَf","root":"دعو"},{"id":8,"arabic":"مُخْلِصِينَ","translit":"َnyِṣِlْhkُm","root":"خلص"},{"id":9,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":10,"arabic":"ٱلدِّينَ","translit":"َnyِّdlٱ","root":"دين"},{"id":11,"arabic":"ٱلْحَمْدُ","translit":"ُdْmَḥْlٱ","root":"حمد"},{"id":12,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":13,"arabic":"رَبِّ","translit":"ِّbَr","root":"ربب"},{"id":14,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":true},{"ayah":66,"text":"قُلْ إِنِّى نُهِيتُ أَنْ أَعْبُدَ ٱلَّذِينَ تَدْعُونَ مِن دُونِ ٱللَّهِ لَمَّا جَآءَنِىَ ٱلْبَيِّنَٰتُ مِن رَّبِّى وَأُمِرْتُ أَنْ أُسْلِمَ لِرَبِّ ٱلْعَٰلَمِينَ ","translation":"Say, [O Muḥammad], \"Indeed, I have been forbidden to worship those you call upon besides Allāh once the clear proofs have come to me from my Lord, and I have been commanded to submit to the Lord of the worlds.\"","words":[{"id":1,"arabic":"قُلْ","translit":"ْlُq","root":"قول"},{"id":2,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":3,"arabic":"نُهِيتُ","translit":"ُtyِhُn","root":"نهي"},{"id":4,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":5,"arabic":"أَعْبُدَ","translit":"َdُbْʿعَaʾ","root":"عبد"},{"id":6,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":7,"arabic":"تَدْعُونَ","translit":"َnwُʿعْdَt","root":"دعو"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":10,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":11,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":12,"arabic":"جَآءَنِىَ","translit":"َàِnَءٓāَjg","root":"جيا"},{"id":13,"arabic":"ٱلْبَيِّنَٰتُ","translit":"ُtَٰnِّyَbْlٱ","root":"بين"},{"id":14,"arabic":"مِن","translit":"nِm","root":""},{"id":15,"arabic":"رَّبِّى","translit":"àِّbَّr","root":"ربب"},{"id":16,"arabic":"وَأُمِرْتُ","translit":"ُtْrِmُaʾَw","root":"امر"},{"id":17,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":18,"arabic":"أُسْلِمَ","translit":"َmِlْsُaʾ","root":"سلم"},{"id":19,"arabic":"لِرَبِّ","translit":"ِّbَrِl","root":"ربب"},{"id":20,"arabic":"ٱلْعَٰلَمِينَ","translit":"َnyِmَlَٰʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":67,"text":"هُوَ ٱلَّذِى خَلَقَكُم مِّن تُرَابٍ ثُمَّ مِن نُّطْفَةٍ ثُمَّ مِنْ عَلَقَةٍ ثُمَّ يُخْرِجُكُمْ طِفْلًا ثُمَّ لِتَبْلُغُوٓا۟ أَشُدَّكُمْ ثُمَّ لِتَكُونُوا۟ شُيُوخًاۚ وَمِنكُم مَّن يُتَوَفَّىٰ مِن قَبْلُۖ وَلِتَبْلُغُوٓا۟ أَجَلًا مُّسَمًّى وَلَعَلَّكُمْ تَعْقِلُونَ ","translation":"It is He who created you from dust, then from a sperm-drop, then from a clinging clot; then He brings you out as a child; then [He develops you] that you reach your [time of] maturity, then [further] that you become elders. And among you is he who is taken in death before [that], so that you reach a specified term;[1] and perhaps you will use reason.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"خَلَقَكُم","translit":"mُkَqَlَhk","root":"خلق"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"تُرَابٍ","translit":"ٍbāَrُt","root":"ترب"},{"id":6,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"نُّطْفَةٍ","translit":"ٍẗَfْṭُّn","root":"نطف"},{"id":9,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":10,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":11,"arabic":"عَلَقَةٍ","translit":"ٍẗَqَlَʿع","root":"علق"},{"id":12,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":13,"arabic":"يُخْرِجُكُمْ","translit":"ْmُkُjgِrْhkُy","root":"خرج"},{"id":14,"arabic":"طِفْلًا","translit":"āًlْfِṭ","root":"طفل"},{"id":15,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":16,"arabic":"لِتَبْلُغُوٓا۟","translit":"۟āٓwُغُlْbَtِl","root":"بلغ"},{"id":17,"arabic":"أَشُدَّكُمْ","translit":"ْmُkَّdُhsَaʾ","root":"شدد"},{"id":18,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":19,"arabic":"لِتَكُونُوا۟","translit":"۟āwُnwُkَtِl","root":"كون"},{"id":20,"arabic":"شُيُوخًا","translit":"āًhkwُyُhs","root":"شيخ"},{"id":21,"arabic":"وَمِنكُم","translit":"mُknِmَw","root":""},{"id":22,"arabic":"مَّن","translit":"nَّm","root":""},{"id":23,"arabic":"يُتَوَفَّىٰ","translit":"ٰàَّfَwَtُy","root":"وفي"},{"id":24,"arabic":"مِن","translit":"nِm","root":""},{"id":25,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":26,"arabic":"وَلِتَبْلُغُوٓا۟","translit":"۟āٓwُغُlْbَtِlَw","root":"بلغ"},{"id":27,"arabic":"أَجَلًا","translit":"āًlَjgَaʾ","root":"اجل"},{"id":28,"arabic":"مُّسَمًّى","translit":"àًّmَsُّm","root":"سمو"},{"id":29,"arabic":"وَلَعَلَّكُمْ","translit":"ْmُkَّlَʿعَlَw","root":""},{"id":30,"arabic":"تَعْقِلُونَ","translit":"َnwُlِqْʿعَt","root":"عقل"}],"hasIhya":false},{"ayah":68,"text":"هُوَ ٱلَّذِى يُحْىِۦ وَيُمِيتُۖ فَإِذَا قَضَىٰٓ أَمْرًا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ ","translation":"He it is who gives life and causes death; and when He decrees a matter, He but says to it, \"Be,\" and it is.","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يُحْىِۦ","translit":"ۦِàْḥُy","root":"حيي"},{"id":4,"arabic":"وَيُمِيتُ","translit":"ُtyِmُyَw","root":"موت"},{"id":5,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":6,"arabic":"قَضَىٰٓ","translit":"ٰٓàَḍَq","root":"قضي"},{"id":7,"arabic":"أَمْرًا","translit":"āًrْmَaʾ","root":"امر"},{"id":8,"arabic":"فَإِنَّمَا","translit":"āَmَّnِiʾَf","root":""},{"id":9,"arabic":"يَقُولُ","translit":"ُlwُqَy","root":"قول"},{"id":10,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":11,"arabic":"كُن","translit":"nُk","root":"كون"},{"id":12,"arabic":"فَيَكُونُ","translit":"ُnwُkَyَf","root":"كون"}],"hasIhya":false},{"ayah":69,"text":"أَلَمْ تَرَ إِلَى ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِ ٱللَّهِ أَنَّىٰ يُصْرَفُونَ ","translation":"Do you not consider those who dispute concerning the signs of Allāh - how are they averted?","words":[{"id":1,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":2,"arabic":"تَرَ","translit":"َrَt","root":"راي"},{"id":3,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"يُجَٰدِلُونَ","translit":"َnwُlِdَٰjgُy","root":"جدل"},{"id":6,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":7,"arabic":"ءَايَٰتِ","translit":"ِtَٰyāَء","root":"ايي"},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"أَنَّىٰ","translit":"ٰàَّnَaʾ","root":""},{"id":10,"arabic":"يُصْرَفُونَ","translit":"َnwُfَrْṣُy","root":"صرف"}],"hasIhya":false},{"ayah":70,"text":"ٱلَّذِينَ كَذَّبُوا۟ بِٱلْكِتَٰبِ وَبِمَآ أَرْسَلْنَا بِهِۦ رُسُلَنَاۖ فَسَوْفَ يَعْلَمُونَ ","translation":"Those who deny the Book [i.e., the Qur’ān] and that with which We sent Our messengers - they are going to know,","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"كَذَّبُوا۟","translit":"۟āwُbَّhdَk","root":"كذب"},{"id":3,"arabic":"بِٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱِb","root":"كتب"},{"id":4,"arabic":"وَبِمَآ","translit":"ٓāَmِbَw","root":""},{"id":5,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":6,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":7,"arabic":"رُسُلَنَا","translit":"āَnَlُsُr","root":"رسل"},{"id":8,"arabic":"فَسَوْفَ","translit":"َfْwَsَf","root":""},{"id":9,"arabic":"يَعْلَمُونَ","translit":"َnwُmَlْʿعَy","root":"علم"}],"hasIhya":false},{"ayah":71,"text":"إِذِ ٱلْأَغْلَٰلُ فِىٓ أَعْنَٰقِهِمْ وَٱلسَّلَٰسِلُ يُسْحَبُونَ ","translation":"When the shackles are around their necks and the chains; they will be dragged","words":[{"id":1,"arabic":"إِذِ","translit":"ِhdِiʾ","root":""},{"id":2,"arabic":"ٱلْأَغْلَٰلُ","translit":"ُlَٰlْغَaʾْlٱ","root":"غلل"},{"id":3,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":4,"arabic":"أَعْنَٰقِهِمْ","translit":"ْmِhِqَٰnْʿعَaʾ","root":"عنق"},{"id":5,"arabic":"وَٱلسَّلَٰسِلُ","translit":"ُlِsَٰlَّslٱَw","root":"سلسل"},{"id":6,"arabic":"يُسْحَبُونَ","translit":"َnwُbَḥْsُy","root":"سحب"}],"hasIhya":true},{"ayah":72,"text":"فِى ٱلْحَمِيمِ ثُمَّ فِى ٱلنَّارِ يُسْجَرُونَ ","translation":"In boiling water; then in the Fire they will be filled [with flame].","words":[{"id":1,"arabic":"فِى","translit":"àِf","root":""},{"id":2,"arabic":"ٱلْحَمِيمِ","translit":"ِmyِmَḥْlٱ","root":"حمم"},{"id":3,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"},{"id":6,"arabic":"يُسْجَرُونَ","translit":"َnwُrَjgْsُy","root":"سجر"}],"hasIhya":false},{"ayah":73,"text":"ثُمَّ قِيلَ لَهُمْ أَيْنَ مَا كُنتُمْ تُشْرِكُونَ ","translation":"Then it will be said to them, \"Where is that which you used to associate [with Him in worship]","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"قِيلَ","translit":"َlyِq","root":"قول"},{"id":3,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":4,"arabic":"أَيْنَ","translit":"َnْyَaʾ","root":""},{"id":5,"arabic":"مَا","translit":"āَm","root":""},{"id":6,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":7,"arabic":"تُشْرِكُونَ","translit":"َnwُkِrْhsُt","root":"شرك"}],"hasIhya":false},{"ayah":74,"text":"مِن دُونِ ٱللَّهِۖ قَالُوا۟ ضَلُّوا۟ عَنَّا بَل لَّمْ نَكُن نَّدْعُوا۟ مِن قَبْلُ شَيْـًٔاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ ٱلْكَٰفِرِينَ ","translation":"Other than Allāh?\" They will say, \"They have departed from us; rather, we did not used to invoke previously anything.\" Thus does Allāh put astray the disbelievers.","words":[{"id":1,"arabic":"مِن","translit":"nِm","root":""},{"id":2,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":3,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":4,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":5,"arabic":"ضَلُّوا۟","translit":"۟āwُّlَḍ","root":"ضلل"},{"id":6,"arabic":"عَنَّا","translit":"āَّnَʿع","root":""},{"id":7,"arabic":"بَل","translit":"lَb","root":""},{"id":8,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":9,"arabic":"نَكُن","translit":"nُkَn","root":"كون"},{"id":10,"arabic":"نَّدْعُوا۟","translit":"۟āwُʿعْdَّn","root":"دعو"},{"id":11,"arabic":"مِن","translit":"nِm","root":""},{"id":12,"arabic":"قَبْلُ","translit":"ُlْbَq","root":"قبل"},{"id":13,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":14,"arabic":"كَذَٰلِكَ","translit":"َkِlَٰhdَk","root":""},{"id":15,"arabic":"يُضِلُّ","translit":"ُّlِḍُy","root":"ضلل"},{"id":16,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":17,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"}],"hasIhya":false},{"ayah":75,"text":"ذَٰلِكُم بِمَا كُنتُمْ تَفْرَحُونَ فِى ٱلْأَرْضِ بِغَيْرِ ٱلْحَقِّ وَبِمَا كُنتُمْ تَمْرَحُونَ ","translation":"[The angels will say], \"That was because you used to exult upon the earth without right and you used to behave insolently.","words":[{"id":1,"arabic":"ذَٰلِكُم","translit":"mُkِlَٰhd","root":""},{"id":2,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":3,"arabic":"كُنتُمْ","translit":"ْmُtnُk","root":"كون"},{"id":4,"arabic":"تَفْرَحُونَ","translit":"َnwُḥَrْfَt","root":"فرح"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":7,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":8,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":9,"arabic":"وَبِمَا","translit":"āَmِbَw","root":""},{"id":10,"arabic":"كُنتُمْ","transl