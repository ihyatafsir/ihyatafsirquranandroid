{"surah": 40, "verses": [{"ayah": 1, "text": "حمٓ ", "translation": "Ḥā, Meem.[1]", "words": [{"id": 1, "arabic": "حمٓ", "translit": "ٓmḥ", "root": ""}], "hasIhya": true}, {"ayah": 2, "text": "تَنزِيلُ ٱلْكِتَٰبِ مِنَ ٱللَّهِ ٱلْعَزِيزِ ٱلْعَلِيمِ ", "translation": "The revelation of the Book [i.e., the Qur’ān] is from Allāh, the Exalted in Might, the Knowing,", "words": [{"id": 1, "arabic": "تَنزِيلُ", "translit": "ُlyِznَt", "root": "نزل"}, {"id": 2, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 6, "arabic": "ٱلْعَلِيمِ", "translit": "ِmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 3, "text": "غَافِرِ ٱلذَّنۢبِ وَقَابِلِ ٱلتَّوْبِ شَدِيدِ ٱلْعِقَابِ ذِى ٱلطَّوْلِۖ لَآ إِلَٰهَ إِلَّا هُوَۖ إِلَيْهِ ٱلْمَصِيرُ ", "translation": "The forgiver of sin, acceptor of repentance, severe in punishment, owner of abundance. There is no deity except Him; to Him is the destination.", "words": [{"id": 1, "arabic": "غَافِرِ", "translit": "ِrِfāَغ", "root": "غفر"}, {"id": 2, "arabic": "ٱلذَّنۢبِ", "translit": "ِbۢnَّhdlٱ", "root": "ذنب"}, {"id": 3, "arabic": "وَقَابِلِ", "translit": "ِlِbāَqَw", "root": "قبل"}, {"id": 4, "arabic": "ٱلتَّوْبِ", "translit": "ِbْwَّtlٱ", "root": "توب"}, {"id": 5, "arabic": "شَدِيدِ", "translit": "ِdyِdَhs", "root": "شدد"}, {"id": 6, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}, {"id": 7, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 8, "arabic": "ٱلطَّوْلِ", "translit": "ِlْwَّṭlٱ", "root": "طول"}, {"id": 9, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 10, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 13, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 14, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 4, "text": "مَا يُجَٰدِلُ فِىٓ ءَايَٰتِ ٱللَّهِ إِلَّا ٱلَّذِينَ كَفَرُوا۟ فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِى ٱلْبِلَٰدِ ", "translation": "No one disputes concerning the signs of Allāh except those who disbelieve, so be not deceived by their [uninhibited] movement throughout the land.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "يُجَٰدِلُ", "translit": "ُlِdَٰjgُy", "root": "جدل"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 9, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 10, "arabic": "يَغْرُرْكَ", "translit": "َkْrُrْغَy", "root": "غرر"}, {"id": 11, "arabic": "تَقَلُّبُهُمْ", "translit": "ْmُhُbُّlَqَt", "root": "قلب"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْبِلَٰدِ", "translit": "ِdَٰlِbْlٱ", "root": "بلد"}], "hasIhya": false}, {"ayah": 5, "text": "كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَٱلْأَحْزَابُ مِنۢ بَعْدِهِمْۖ وَهَمَّتْ كُلُّ أُمَّةٍۭ بِرَسُولِهِمْ لِيَأْخُذُوهُۖ وَجَٰدَلُوا۟ بِٱلْبَٰطِلِ لِيُدْحِضُوا۟ بِهِ ٱلْحَقَّ فَأَخَذْتُهُمْۖ فَكَيْفَ كَانَ عِقَابِ ", "translation": "The people of Noah denied before them and the [disbelieving] factions after them, and every nation intended [a plot] for their messenger to seize him, and they disputed by [using] falsehood to [attempt to] invalidate thereby the truth. So I seized them, and how [terrible] was My penalty.", "words": [{"id": 1, "arabic": "كَذَّبَتْ", "translit": "ْtَbَّhdَk", "root": "كذب"}, {"id": 2, "arabic": "قَبْلَهُمْ", "translit": "ْmُhَlْbَq", "root": "قبل"}, {"id": 3, "arabic": "قَوْمُ", "translit": "ُmْwَq", "root": "قوم"}, {"id": 4, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 5, "arabic": "وَٱلْأَحْزَابُ", "translit": "ُbāَzْḥَaʾْlٱَw", "root": "حزب"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "وَهَمَّتْ", "translit": "ْtَّmَhَw", "root": "همم"}, {"id": 9, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 10, "arabic": "أُمَّةٍۭ", "translit": "ٍۭẗَّmُaʾ", "root": "امم"}, {"id": 11, "arabic": "بِرَسُولِهِمْ", "translit": "ْmِhِlwُsَrِb", "root": "رسل"}, {"id": 12, "arabic": "لِيَأْخُذُوهُ", "translit": "ُhwُhdُhkْaʾَyِl", "root": "اخذ"}, {"id": 13, "arabic": "وَجَٰدَلُوا۟", "translit": "۟āwُlَdَٰjgَw", "root": "جدل"}, {"id": 14, "arabic": "بِٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱِb", "root": "بطل"}, {"id": 15, "arabic": "لِيُدْحِضُوا۟", "translit": "۟āwُḍِḥْdُyِl", "root": "دحض"}, {"id": 16, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 17, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 18, "arabic": "فَأَخَذْتُهُمْ", "translit": "ْmُhُtْhdَhkَaʾَf", "root": "اخذ"}, {"id": 19, "arabic": "فَكَيْفَ", "translit": "َfْyَkَf", "root": "كيف"}, {"id": 20, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 21, "arabic": "عِقَابِ", "translit": "ِbāَqِʿع", "root": "عقب"}], "hasIhya": false}, {"ayah": 6, "text": "وَكَذَٰلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى ٱلَّذِينَ كَفَرُوٓا۟ أَنَّهُمْ أَصْحَٰبُ ٱلنَّارِ ", "translation": "And thus has the word [i.e., decree] of your Lord come into effect upon those who disbelieved that they are companions of the Fire.", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "حَقَّتْ", "translit": "ْtَّqَḥ", "root": "حقق"}, {"id": 3, "arabic": "كَلِمَتُ", "translit": "ُtَmِlَk", "root": "كلم"}, {"id": 4, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 8, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 9, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 10, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 7, "text": "ٱلَّذِينَ يَحْمِلُونَ ٱلْعَرْشَ وَمَنْ حَوْلَهُۥ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ بِهِۦ وَيَسْتَغْفِرُونَ لِلَّذِينَ ءَامَنُوا۟ رَبَّنَا وَسِعْتَ كُلَّ شَىْءٍ رَّحْمَةً وَعِلْمًا فَٱغْفِرْ لِلَّذِينَ تَابُوا۟ وَٱتَّبَعُوا۟ سَبِيلَكَ وَقِهِمْ عَذَابَ ٱلْجَحِيمِ ", "translation": "Those [angels] who carry the Throne and those around it exalt [Allāh] with praise of their Lord and believe in Him and ask forgiveness for those who have believed, [saying], \"Our Lord, You have encompassed all things in mercy and knowledge, so forgive those who have repented and followed Your way and protect them from the punishment of Hellfire.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَحْمِلُونَ", "translit": "َnwُlِmْḥَy", "root": "حمل"}, {"id": 3, "arabic": "ٱلْعَرْشَ", "translit": "َhsْrَʿعْlٱ", "root": "عرش"}, {"id": 4, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 5, "arabic": "حَوْلَهُۥ", "translit": "ۥُhَlْwَḥ", "root": "حول"}, {"id": 6, "arabic": "يُسَبِّحُونَ", "translit": "َnwُḥِّbَsُy", "root": "سبح"}, {"id": 7, "arabic": "بِحَمْدِ", "translit": "ِdْmَḥِb", "root": "حمد"}, {"id": 8, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 9, "arabic": "وَيُؤْمِنُونَ", "translit": "َnwُnِmْwʾُyَw", "root": "امن"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "وَيَسْتَغْفِرُونَ", "translit": "َnwُrِfْغَtْsَyَw", "root": "غفر"}, {"id": 12, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 13, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 14, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 15, "arabic": "وَسِعْتَ", "translit": "َtْʿعِsَw", "root": "وسع"}, {"id": 16, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 17, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 18, "arabic": "رَّحْمَةً", "translit": "ًẗَmْḥَّr", "root": "رحم"}, {"id": 19, "arabic": "وَعِلْمًا", "translit": "āًmْlِʿعَw", "root": "علم"}, {"id": 20, "arabic": "فَٱغْفِرْ", "translit": "ْrِfْغٱَf", "root": "غفر"}, {"id": 21, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 22, "arabic": "تَابُوا۟", "translit": "۟āwُbāَt", "root": "توب"}, {"id": 23, "arabic": "وَٱتَّبَعُوا۟", "translit": "۟āwُʿعَbَّtٱَw", "root": "تبع"}, {"id": 24, "arabic": "سَبِيلَكَ", "translit": "َkَlyِbَs", "root": "سبل"}, {"id": 25, "arabic": "وَقِهِمْ", "translit": "ْmِhِqَw", "root": "وقي"}, {"id": 26, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 27, "arabic": "ٱلْجَحِيمِ", "translit": "ِmyِḥَjgْlٱ", "root": "جحم"}], "hasIhya": false}, {"ayah": 8, "text": "رَبَّنَا وَأَدْخِلْهُمْ جَنَّٰتِ عَدْنٍ ٱلَّتِى وَعَدتَّهُمْ وَمَن صَلَحَ مِنْ ءَابَآئِهِمْ وَأَزْوَٰجِهِمْ وَذُرِّيَّٰتِهِمْۚ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "Our Lord, and admit them to gardens of perpetual residence which You have promised them and whoever was righteous among their forefathers, their spouses and their offspring. Indeed, it is You who is the Exalted in Might, the Wise.", "words": [{"id": 1, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "وَأَدْخِلْهُمْ", "translit": "ْmُhْlِhkْdَaʾَw", "root": "دخل"}, {"id": 3, "arabic": "جَنَّٰتِ", "translit": "ِtَّٰnَjg", "root": "جنن"}, {"id": 4, "arabic": "عَدْنٍ", "translit": "ٍnْdَʿع", "root": ""}, {"id": 5, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 6, "arabic": "وَعَدتَّهُمْ", "translit": "ْmُhَّtdَʿعَw", "root": "وعد"}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "صَلَحَ", "translit": "َḥَlَṣ", "root": "صلح"}, {"id": 9, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 10, "arabic": "ءَابَآئِهِمْ", "translit": "ْmِhِyʾٓāَbāَء", "root": "ابو"}, {"id": 11, "arabic": "وَأَزْوَٰجِهِمْ", "translit": "ْmِhِjgَٰwْzَaʾَw", "root": "زوج"}, {"id": 12, "arabic": "وَذُرِّيَّٰتِهِمْ", "translit": "ْmِhِtَّٰyِّrُhdَw", "root": "ذرر"}, {"id": 13, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 14, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 15, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 16, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 9, "text": "وَقِهِمُ ٱلسَّيِّـَٔاتِۚ وَمَن تَقِ ٱلسَّيِّـَٔاتِ يَوْمَئِذٍ فَقَدْ رَحِمْتَهُۥۚ وَذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ", "translation": "And protect them from the evil consequences [of their deeds]. And he whom You protect from evil consequences that Day - You will have given him mercy. And that is the great attainment.\"", "words": [{"id": 1, "arabic": "وَقِهِمُ", "translit": "ُmِhِqَw", "root": "وقي"}, {"id": 2, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 3, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 4, "arabic": "تَقِ", "translit": "ِqَt", "root": "وقي"}, {"id": 5, "arabic": "ٱلسَّيِّـَٔاتِ", "translit": "ِtāَٔـِّyَّslٱ", "root": "سوا"}, {"id": 6, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 7, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 8, "arabic": "رَحِمْتَهُۥ", "translit": "ۥُhَtْmِḥَr", "root": "رحم"}, {"id": 9, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 12, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 10, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ يُنَادَوْنَ لَمَقْتُ ٱللَّهِ أَكْبَرُ مِن مَّقْتِكُمْ أَنفُسَكُمْ إِذْ تُدْعَوْنَ إِلَى ٱلْإِيمَٰنِ فَتَكْفُرُونَ ", "translation": "Indeed, those who disbelieve will be addressed, \"The hatred of Allāh for you was [even] greater than your hatred of yourselves [this Day in Hell] when you were invited to faith, but you disbelieved [i.e., refused].\"", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "يُنَادَوْنَ", "translit": "َnْwَdāَnُy", "root": "ندي"}, {"id": 5, "arabic": "لَمَقْتُ", "translit": "ُtْqَmَl", "root": "مقت"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "مَّقْتِكُمْ", "translit": "ْmُkِtْqَّm", "root": "مقت"}, {"id": 10, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 11, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 12, "arabic": "تُدْعَوْنَ", "translit": "َnْwَʿعْdُt", "root": "دعو"}, {"id": 13, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 14, "arabic": "ٱلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlٱ", "root": "امن"}, {"id": 15, "arabic": "فَتَكْفُرُونَ", "translit": "َnwُrُfْkَtَf", "root": "كفر"}], "hasIhya": false}, {"ayah": 11, "text": "قَالُوا۟ رَبَّنَآ أَمَتَّنَا ٱثْنَتَيْنِ وَأَحْيَيْتَنَا ٱثْنَتَيْنِ فَٱعْتَرَفْنَا بِذُنُوبِنَا فَهَلْ إِلَىٰ خُرُوجٍ مِّن سَبِيلٍ ", "translation": "They will say, \"Our Lord, You made us lifeless twice and gave us life twice, and we have confessed our sins. So is there to an exit any way?\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 3, "arabic": "أَمَتَّنَا", "translit": "āَnَّtَmَaʾ", "root": "موت"}, {"id": 4, "arabic": "ٱثْنَتَيْنِ", "translit": "ِnْyَtَnْhtٱ", "root": "ثني"}, {"id": 5, "arabic": "وَأَحْيَيْتَنَا", "translit": "āَnَtْyَyْḥَaʾَw", "root": "حيي"}, {"id": 6, "arabic": "ٱثْنَتَيْنِ", "translit": "ِnْyَtَnْhtٱ", "root": "ثني"}, {"id": 7, "arabic": "فَٱعْتَرَفْنَا", "translit": "āَnْfَrَtْʿعٱَf", "root": "عرف"}, {"id": 8, "arabic": "بِذُنُوبِنَا", "translit": "āَnِbwُnُhdِb", "root": "ذنب"}, {"id": 9, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 10, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 11, "arabic": "خُرُوجٍ", "translit": "ٍjgwُrُhk", "root": "خرج"}, {"id": 12, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 13, "arabic": "سَبِيلٍ", "translit": "ٍlyِbَs", "root": "سبل"}], "hasIhya": true}, {"ayah": 12, "text": "ذَٰلِكُم بِأَنَّهُۥٓ إِذَا دُعِىَ ٱللَّهُ وَحْدَهُۥ كَفَرْتُمْۖ وَإِن يُشْرَكْ بِهِۦ تُؤْمِنُوا۟ۚ فَٱلْحُكْمُ لِلَّهِ ٱلْعَلِىِّ ٱلْكَبِيرِ ", "translation": "[They will be told], \"That is because, when Allāh was called upon alone, you disbelieved; but if others were associated with Him, you believed. So the judgement is with Allāh, the Most High, the Grand.\"", "words": [{"id": 1, "arabic": "ذَٰلِكُم", "translit": "mُkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُۥٓ", "translit": "ٓۥُhَّnَaʾِb", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "دُعِىَ", "translit": "َàِʿعُd", "root": "دعو"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَحْدَهُۥ", "translit": "ۥُhَdْḥَw", "root": "وحد"}, {"id": 7, "arabic": "كَفَرْتُمْ", "translit": "ْmُtْrَfَk", "root": "كفر"}, {"id": 8, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 9, "arabic": "يُشْرَكْ", "translit": "ْkَrْhsُy", "root": "شرك"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "تُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُt", "root": "امن"}, {"id": 12, "arabic": "فَٱلْحُكْمُ", "translit": "ُmْkُḥْlٱَf", "root": "حكم"}, {"id": 13, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 14, "arabic": "ٱلْعَلِىِّ", "translit": "ِّàِlَʿعْlٱ", "root": "علو"}, {"id": 15, "arabic": "ٱلْكَبِيرِ", "translit": "ِryِbَkْlٱ", "root": "كبر"}], "hasIhya": true}, {"ayah": 13, "text": "هُوَ ٱلَّذِى يُرِيكُمْ ءَايَٰتِهِۦ وَيُنَزِّلُ لَكُم مِّنَ ٱلسَّمَآءِ رِزْقًاۚ وَمَا يَتَذَكَّرُ إِلَّا مَن يُنِيبُ ", "translation": "It is He who shows you His signs and sends down to you from the sky, provision. But none will remember except he who turns back [in repentance].", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُرِيكُمْ", "translit": "ْmُkyِrُy", "root": "راي"}, {"id": 4, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "وَيُنَزِّلُ", "translit": "ُlِّzَnُyَw", "root": "نزل"}, {"id": 6, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "يَتَذَكَّرُ", "translit": "ُrَّkَhdَtَy", "root": "ذكر"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 14, "arabic": "يُنِيبُ", "translit": "ُbyِnُy", "root": "نوب"}], "hasIhya": true}, {"ayah": 14, "text": "فَٱدْعُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ وَلَوْ كَرِهَ ٱلْكَٰفِرُونَ ", "translation": "So invoke Allāh, [being] sincere to Him in religion, although the disbelievers dislike it.", "words": [{"id": 1, "arabic": "فَٱدْعُوا۟", "translit": "۟āwُʿعْdٱَf", "root": "دعو"}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "مُخْلِصِينَ", "translit": "َnyِṣِlْhkُm", "root": "خلص"}, {"id": 4, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 5, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 6, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 7, "arabic": "كَرِهَ", "translit": "َhِrَk", "root": "كره"}, {"id": 8, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 15, "text": "رَفِيعُ ٱلدَّرَجَٰتِ ذُو ٱلْعَرْشِ يُلْقِى ٱلرُّوحَ مِنْ أَمْرِهِۦ عَلَىٰ مَن يَشَآءُ مِنْ عِبَادِهِۦ لِيُنذِرَ يَوْمَ ٱلتَّلَاقِ ", "translation": "[He is] the Exalted above [all] degrees, Owner of the Throne; He places the inspiration of His command [i.e., revelation] upon whom He wills of His servants to warn of the Day of Meeting.", "words": [{"id": 1, "arabic": "رَفِيعُ", "translit": "ُʿعyِfَr", "root": "رفع"}, {"id": 2, "arabic": "ٱلدَّرَجَٰتِ", "translit": "ِtَٰjgَrَّdlٱ", "root": "درج"}, {"id": 3, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 4, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 5, "arabic": "يُلْقِى", "translit": "àِqْlُy", "root": "لقي"}, {"id": 6, "arabic": "ٱلرُّوحَ", "translit": "َḥwُّrlٱ", "root": "روح"}, {"id": 7, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 8, "arabic": "أَمْرِهِۦ", "translit": "ۦِhِrْmَaʾ", "root": "امر"}, {"id": 9, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 10, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 11, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 12, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 13, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 14, "arabic": "لِيُنذِرَ", "translit": "َrِhdnُyِl", "root": "نذر"}, {"id": 15, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 16, "arabic": "ٱلتَّلَاقِ", "translit": "ِqāَlَّtlٱ", "root": "لقي"}], "hasIhya": true}, {"ayah": 16, "text": "يَوْمَ هُم بَٰرِزُونَۖ لَا يَخْفَىٰ عَلَى ٱللَّهِ مِنْهُمْ شَىْءٌۚ لِّمَنِ ٱلْمُلْكُ ٱلْيَوْمَۖ لِلَّهِ ٱلْوَٰحِدِ ٱلْقَهَّارِ ", "translation": "The Day they come forth nothing concerning them will be concealed from Allāh. To whom belongs [all] sovereignty this Day? To Allāh, the One, the Prevailing.[1]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 3, "arabic": "بَٰرِزُونَ", "translit": "َnwُzِrَٰb", "root": "برز"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يَخْفَىٰ", "translit": "ٰàَfْhkَy", "root": "خفي"}, {"id": 6, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 9, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 10, "arabic": "لِّمَنِ", "translit": "ِnَmِّl", "root": ""}, {"id": 11, "arabic": "ٱلْمُلْكُ", "translit": "ُkْlُmْlٱ", "root": "ملك"}, {"id": 12, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 13, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 14, "arabic": "ٱلْوَٰحِدِ", "translit": "ِdِḥَٰwْlٱ", "root": "وحد"}, {"id": 15, "arabic": "ٱلْقَهَّارِ", "translit": "ِrāَّhَqْlٱ", "root": "قهر"}], "hasIhya": true}, {"ayah": 17, "text": "ٱلْيَوْمَ تُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا كَسَبَتْۚ لَا ظُلْمَ ٱلْيَوْمَۚ إِنَّ ٱللَّهَ سَرِيعُ ٱلْحِسَابِ ", "translation": "This Day every soul will be recompensed for what it earned. No injustice today! Indeed, Allāh is swift in account.", "words": [{"id": 1, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 2, "arabic": "تُجْزَىٰ", "translit": "ٰàَzْjgُt", "root": "جزي"}, {"id": 3, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 4, "arabic": "نَفْسٍۭ", "translit": "ٍۭsْfَn", "root": "نفس"}, {"id": 5, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 6, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "ظُلْمَ", "translit": "َmْlُẓ", "root": "ظلم"}, {"id": 9, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "سَرِيعُ", "translit": "ُʿعyِrَs", "root": "سرع"}, {"id": 13, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": true}, {"ayah": 18, "text": "وَأَنذِرْهُمْ يَوْمَ ٱلْءَازِفَةِ إِذِ ٱلْقُلُوبُ لَدَى ٱلْحَنَاجِرِ كَٰظِمِينَۚ مَا لِلظَّٰلِمِينَ مِنْ حَمِيمٍ وَلَا شَفِيعٍ يُطَاعُ ", "translation": "And warn them, [O Muḥammad], of the Approaching Day, when hearts are at the throats, filled [with distress]. For the wrongdoers there will be no devoted friend and no intercessor [who is] obeyed.", "words": [{"id": 1, "arabic": "وَأَنذِرْهُمْ", "translit": "ْmُhْrِhdnَaʾَw", "root": "نذر"}, {"id": 2, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 3, "arabic": "ٱلْءَازِفَةِ", "translit": "ِẗَfِzāَءْlٱ", "root": "ازف"}, {"id": 4, "arabic": "إِذِ", "translit": "ِhdِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلْقُلُوبُ", "translit": "ُbwُlُqْlٱ", "root": "قلب"}, {"id": 6, "arabic": "لَدَى", "translit": "àَdَl", "root": ""}, {"id": 7, "arabic": "ٱلْحَنَاجِرِ", "translit": "ِrِjgāَnَḥْlٱ", "root": "حنجر"}, {"id": 8, "arabic": "كَٰظِمِينَ", "translit": "َnyِmِẓَٰk", "root": "كظم"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لِلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlِl", "root": "ظلم"}, {"id": 11, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 12, "arabic": "حَمِيمٍ", "translit": "ٍmyِmَḥ", "root": "حمم"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "شَفِيعٍ", "translit": "ٍʿعyِfَhs", "root": "شفع"}, {"id": 15, "arabic": "يُطَاعُ", "translit": "ُʿعāَṭُy", "root": "طوع"}], "hasIhya": true}, {"ayah": 19, "text": "يَعْلَمُ خَآئِنَةَ ٱلْأَعْيُنِ وَمَا تُخْفِى ٱلصُّدُورُ ", "translation": "He knows that which deceives the eyes and what the breasts conceal.", "words": [{"id": 1, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 2, "arabic": "خَآئِنَةَ", "translit": "َẗَnِyʾٓāَhk", "root": "خون"}, {"id": 3, "arabic": "ٱلْأَعْيُنِ", "translit": "ِnُyْʿعَaʾْlٱ", "root": "عين"}, {"id": 4, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 5, "arabic": "تُخْفِى", "translit": "àِfْhkُt", "root": "خفي"}, {"id": 6, "arabic": "ٱلصُّدُورُ", "translit": "ُrwُdُّṣlٱ", "root": "صدر"}], "hasIhya": false}, {"ayah": 20, "text": "وَٱللَّهُ يَقْضِى بِٱلْحَقِّۖ وَٱلَّذِينَ يَدْعُونَ مِن دُونِهِۦ لَا يَقْضُونَ بِشَىْءٍۗ إِنَّ ٱللَّهَ هُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ ", "translation": "And Allāh judges with truth, while those they invoke[1] besides Him judge not with anything. Indeed, Allāh - He is the Hearing, the Seeing.", "words": [{"id": 1, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 2, "arabic": "يَقْضِى", "translit": "àِḍْqَy", "root": "قضي"}, {"id": 3, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يَقْضُونَ", "translit": "َnwُḍْqَy", "root": "قضي"}, {"id": 10, "arabic": "بِشَىْءٍ", "translit": "ٍءْàَhsِb", "root": "شيا"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 14, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 15, "arabic": "ٱلْبَصِيرُ", "translit": "ُryِṣَbْlٱ", "root": "بصر"}], "hasIhya": false}, {"ayah": 21, "text": "أَوَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ كَانُوا۟ مِن قَبْلِهِمْۚ كَانُوا۟ هُمْ أَشَدَّ مِنْهُمْ قُوَّةً وَءَاثَارًا فِى ٱلْأَرْضِ فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَهُم مِّنَ ٱللَّهِ مِن وَاقٍ ", "translation": "Have they not traveled through the land and observed how was the end of those who were before them? They were greater than them in strength and in impression on the land, but Allāh seized them for their sins. And they had not from Allāh any protector.", "words": [{"id": 1, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَسِيرُوا۟", "translit": "۟āwُryِsَy", "root": "سير"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "فَيَنظُرُوا۟", "translit": "۟āwُrُẓnَyَf", "root": "نظر"}, {"id": 6, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "عَٰقِبَةُ", "translit": "ُẗَbِqَٰʿع", "root": "عقب"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 13, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 14, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 15, "arabic": "أَشَدَّ", "translit": "َّdَhsَaʾ", "root": "شدد"}, {"id": 16, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 17, "arabic": "قُوَّةً", "translit": "ًẗَّwُq", "root": "قوي"}, {"id": 18, "arabic": "وَءَاثَارًا", "translit": "āًrāَhtāَءَw", "root": "اثر"}, {"id": 19, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 20, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 21, "arabic": "فَأَخَذَهُمُ", "translit": "ُmُhَhdَhkَaʾَf", "root": "اخذ"}, {"id": 22, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "بِذُنُوبِهِمْ", "translit": "ْmِhِbwُnُhdِb", "root": "ذنب"}, {"id": 24, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 25, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 26, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 27, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 28, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 30, "arabic": "وَاقٍ", "translit": "ٍqāَw", "root": "وقي"}], "hasIhya": false}, {"ayah": 22, "text": "ذَٰلِكَ بِأَنَّهُمْ كَانَت تَّأْتِيهِمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ فَكَفَرُوا۟ فَأَخَذَهُمُ ٱللَّهُۚ إِنَّهُۥ قَوِىٌّ شَدِيدُ ٱلْعِقَابِ ", "translation": "That was because their messengers were coming to them with clear proofs, but they disbelieved, so Allāh seized them. Indeed, He is Powerful and severe in punishment.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 3, "arabic": "كَانَت", "translit": "tَnāَk", "root": "كون"}, {"id": 4, "arabic": "تَّأْتِيهِمْ", "translit": "ْmِhyِtْaʾَّt", "root": "اتي"}, {"id": 5, "arabic": "رُسُلُهُم", "translit": "mُhُlُsُr", "root": "رسل"}, {"id": 6, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 7, "arabic": "فَكَفَرُوا۟", "translit": "۟āwُrَfَkَf", "root": "كفر"}, {"id": 8, "arabic": "فَأَخَذَهُمُ", "translit": "ُmُhَhdَhkَaʾَf", "root": "اخذ"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "قَوِىٌّ", "translit": "ٌّàِwَq", "root": "قوي"}, {"id": 12, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 13, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}], "hasIhya": false}, {"ayah": 23, "text": "وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِـَٔايَٰتِنَا وَسُلْطَٰنٍ مُّبِينٍ ", "translation": "And We did certainly send Moses with Our signs and a clear authority[1]", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "بِـَٔايَٰتِنَا", "translit": "āَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "وَسُلْطَٰنٍ", "translit": "ٍnَٰṭْlُsَw", "root": "سلط"}, {"id": 6, "arabic": "مُّبِينٍ", "translit": "ٍnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 24, "text": "إِلَىٰ فِرْعَوْنَ وَهَٰمَٰنَ وَقَٰرُونَ فَقَالُوا۟ سَٰحِرٌ كَذَّابٌ ", "translation": "To Pharaoh, Hāmān and Qārūn, but they said, \"[He is] a magician and a liar.\"", "words": [{"id": 1, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 2, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "وَهَٰمَٰنَ", "translit": "َnَٰmَٰhَw", "root": ""}, {"id": 4, "arabic": "وَقَٰرُونَ", "translit": "َnwُrَٰqَw", "root": ""}, {"id": 5, "arabic": "فَقَالُوا۟", "translit": "۟āwُlāَqَf", "root": "قول"}, {"id": 6, "arabic": "سَٰحِرٌ", "translit": "ٌrِḥَٰs", "root": "سحر"}, {"id": 7, "arabic": "كَذَّابٌ", "translit": "ٌbāَّhdَk", "root": "كذب"}], "hasIhya": true}, {"ayah": 25, "text": "فَلَمَّا جَآءَهُم بِٱلْحَقِّ مِنْ عِندِنَا قَالُوا۟ ٱقْتُلُوٓا۟ أَبْنَآءَ ٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ وَٱسْتَحْيُوا۟ نِسَآءَهُمْۚ وَمَا كَيْدُ ٱلْكَٰفِرِينَ إِلَّا فِى ضَلَٰلٍ ", "translation": "And when he brought them the truth from Us, they said, \"Kill the sons of those who have believed with him and keep their women alive.\" But the plan of the disbelievers is not except in error.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَآءَهُم", "translit": "mُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "عِندِنَا", "translit": "āَnِdnِʿع", "root": "عند"}, {"id": 6, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 7, "arabic": "ٱقْتُلُوٓا۟", "translit": "۟āٓwُlُtْqٱ", "root": "قتل"}, {"id": 8, "arabic": "أَبْنَآءَ", "translit": "َءٓāَnْbَaʾ", "root": "بني"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 11, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 12, "arabic": "وَٱسْتَحْيُوا۟", "translit": "۟āwُyْḥَtْsٱَw", "root": "حيي"}, {"id": 13, "arabic": "نِسَآءَهُمْ", "translit": "ْmُhَءٓāَsِn", "root": "نسو"}, {"id": 14, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 15, "arabic": "كَيْدُ", "translit": "ُdْyَk", "root": "كيد"}, {"id": 16, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 17, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}], "hasIhya": false}, {"ayah": 26, "text": "وَقَالَ فِرْعَوْنُ ذَرُونِىٓ أَقْتُلْ مُوسَىٰ وَلْيَدْعُ رَبَّهُۥٓۖ إِنِّىٓ أَخَافُ أَن يُبَدِّلَ دِينَكُمْ أَوْ أَن يُظْهِرَ فِى ٱلْأَرْضِ ٱلْفَسَادَ ", "translation": "And Pharaoh said, \"Let me kill Moses and let him call upon his Lord. Indeed, I fear that he will change your religion or that he will cause corruption[1] in the land.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "ذَرُونِىٓ", "translit": "ٓàِnwُrَhd", "root": "وذر"}, {"id": 4, "arabic": "أَقْتُلْ", "translit": "ْlُtْqَaʾ", "root": "قتل"}, {"id": 5, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 6, "arabic": "وَلْيَدْعُ", "translit": "ُʿعْdَyْlَw", "root": "دعو"}, {"id": 7, "arabic": "رَبَّهُۥٓ", "translit": "ٓۥُhَّbَr", "root": "ربب"}, {"id": 8, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 9, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "يُبَدِّلَ", "translit": "َlِّdَbُy", "root": "بدل"}, {"id": 12, "arabic": "دِينَكُمْ", "translit": "ْmُkَnyِd", "root": "دين"}, {"id": 13, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "يُظْهِرَ", "translit": "َrِhْẓُy", "root": "ظهر"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 18, "arabic": "ٱلْفَسَادَ", "translit": "َdāَsَfْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 27, "text": "وَقَالَ مُوسَىٰٓ إِنِّى عُذْتُ بِرَبِّى وَرَبِّكُم مِّن كُلِّ مُتَكَبِّرٍ لَّا يُؤْمِنُ بِيَوْمِ ٱلْحِسَابِ ", "translation": "But Moses said, \"Indeed, I have sought refuge in my Lord and your Lord from every arrogant one who does not believe in the Day of Account.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 3, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 4, "arabic": "عُذْتُ", "translit": "ُtْhdُʿع", "root": "عوذ"}, {"id": 5, "arabic": "بِرَبِّى", "translit": "àِّbَrِb", "root": "ربب"}, {"id": 6, "arabic": "وَرَبِّكُم", "translit": "mُkِّbَrَw", "root": "ربب"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 9, "arabic": "مُتَكَبِّرٍ", "translit": "ٍrِّbَkَtُm", "root": "كبر"}, {"id": 10, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 11, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 12, "arabic": "بِيَوْمِ", "translit": "ِmْwَyِb", "root": "يوم"}, {"id": 13, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": false}, {"ayah": 28, "text": "وَقَالَ رَجُلٌ مُّؤْمِنٌ مِّنْ ءَالِ فِرْعَوْنَ يَكْتُمُ إِيمَٰنَهُۥٓ أَتَقْتُلُونَ رَجُلًا أَن يَقُولَ رَبِّىَ ٱللَّهُ وَقَدْ جَآءَكُم بِٱلْبَيِّنَٰتِ مِن رَّبِّكُمْۖ وَإِن يَكُ كَٰذِبًا فَعَلَيْهِ كَذِبُهُۥۖ وَإِن يَكُ صَادِقًا يُصِبْكُم بَعْضُ ٱلَّذِى يَعِدُكُمْۖ إِنَّ ٱللَّهَ لَا يَهْدِى مَنْ هُوَ مُسْرِفٌ كَذَّابٌ ", "translation": "And a believing man from the family of Pharaoh who concealed his faith said, \"Do you kill a man [merely] because he says, 'My Lord is Allāh' while he has brought you clear proofs from your Lord? And if he should be lying, then upon him is [the consequence of] his lie; but if he should be truthful, there will strike you some of what he promises you. Indeed, Allāh does not guide one who is a transgressor and a liar.", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "رَجُلٌ", "translit": "ٌlُjgَr", "root": "رجل"}, {"id": 3, "arabic": "مُّؤْمِنٌ", "translit": "ٌnِmْwʾُّm", "root": "امن"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "ءَالِ", "translit": "ِlāَء", "root": "اول"}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 7, "arabic": "يَكْتُمُ", "translit": "ُmُtْkَy", "root": "كتم"}, {"id": 8, "arabic": "إِيمَٰنَهُۥٓ", "translit": "ٓۥُhَnَٰmyِiʾ", "root": "امن"}, {"id": 9, "arabic": "أَتَقْتُلُونَ", "translit": "َnwُlُtْqَtَaʾ", "root": "قتل"}, {"id": 10, "arabic": "رَجُلًا", "translit": "āًlُjgَr", "root": "رجل"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَقُولَ", "translit": "َlwُqَy", "root": "قول"}, {"id": 13, "arabic": "رَبِّىَ", "translit": "َàِّbَr", "root": "ربب"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 16, "arabic": "جَآءَكُم", "translit": "mُkَءٓāَjg", "root": "جيا"}, {"id": 17, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 20, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 21, "arabic": "يَكُ", "translit": "ُkَy", "root": "كون"}, {"id": 22, "arabic": "كَٰذِبًا", "translit": "āًbِhdَٰk", "root": "كذب"}, {"id": 23, "arabic": "فَعَلَيْهِ", "translit": "ِhْyَlَʿعَf", "root": ""}, {"id": 24, "arabic": "كَذِبُهُۥ", "translit": "ۥُhُbِhdَk", "root": "كذب"}, {"id": 25, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 26, "arabic": "يَكُ", "translit": "ُkَy", "root": "كون"}, {"id": 27, "arabic": "صَادِقًا", "translit": "āًqِdāَṣ", "root": "صدق"}, {"id": 28, "arabic": "يُصِبْكُم", "translit": "mُkْbِṣُy", "root": "صوب"}, {"id": 29, "arabic": "بَعْضُ", "translit": "ُḍْʿعَb", "root": "بعض"}, {"id": 30, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 31, "arabic": "يَعِدُكُمْ", "translit": "ْmُkُdِʿعَy", "root": "وعد"}, {"id": 32, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 33, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 34, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 35, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 36, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 37, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 38, "arabic": "مُسْرِفٌ", "translit": "ٌfِrْsُm", "root": "سرف"}, {"id": 39, "arabic": "كَذَّابٌ", "translit": "ٌbāَّhdَk", "root": "كذب"}], "hasIhya": true}, {"ayah": 29, "text": "يَٰقَوْمِ لَكُمُ ٱلْمُلْكُ ٱلْيَوْمَ ظَٰهِرِينَ فِى ٱلْأَرْضِ فَمَن يَنصُرُنَا مِنۢ بَأْسِ ٱللَّهِ إِن جَآءَنَاۚ قَالَ فِرْعَوْنُ مَآ أُرِيكُمْ إِلَّا مَآ أَرَىٰ وَمَآ أَهْدِيكُمْ إِلَّا سَبِيلَ ٱلرَّشَادِ ", "translation": "O my people, sovereignty is yours today, [your being] dominant in the land. But who would protect us from the punishment of Allāh if it came to us?\" Pharaoh said, \"I do not show you except what I see, and I do not guide you except to the way of right conduct.\"", "words": [{"id": 1, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 2, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 3, "arabic": "ٱلْمُلْكُ", "translit": "ُkْlُmْlٱ", "root": "ملك"}, {"id": 4, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 5, "arabic": "ظَٰهِرِينَ", "translit": "َnyِrِhَٰẓ", "root": "ظهر"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 9, "arabic": "يَنصُرُنَا", "translit": "āَnُrُṣnَy", "root": "نصر"}, {"id": 10, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 11, "arabic": "بَأْسِ", "translit": "ِsْaʾَb", "root": "باس"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "جَآءَنَا", "translit": "āَnَءٓāَjg", "root": "جيا"}, {"id": 15, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 16, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 17, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 18, "arabic": "أُرِيكُمْ", "translit": "ْmُkyِrُaʾ", "root": "راي"}, {"id": 19, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 20, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 21, "arabic": "أَرَىٰ", "translit": "ٰàَrَaʾ", "root": "راي"}, {"id": 22, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 23, "arabic": "أَهْدِيكُمْ", "translit": "ْmُkyِdْhَaʾ", "root": "هدي"}, {"id": 24, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 25, "arabic": "سَبِيلَ", "translit": "َlyِbَs", "root": "سبل"}, {"id": 26, "arabic": "ٱلرَّشَادِ", "translit": "ِdāَhsَّrlٱ", "root": "رشد"}], "hasIhya": false}, {"ayah": 30, "text": "وَقَالَ ٱلَّذِىٓ ءَامَنَ يَٰقَوْمِ إِنِّىٓ أَخَافُ عَلَيْكُم مِّثْلَ يَوْمِ ٱلْأَحْزَابِ ", "translation": "And he who believed said, \"O my people, indeed I fear for you [a fate] like the day of the companies[1] -", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 4, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 5, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 6, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 7, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مِّثْلَ", "translit": "َlْhtِّm", "root": "مثل"}, {"id": 9, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 10, "arabic": "ٱلْأَحْزَابِ", "translit": "ِbāَzْḥَaʾْlٱ", "root": "حزب"}], "hasIhya": false}, {"ayah": 31, "text": "مِثْلَ دَأْبِ قَوْمِ نُوحٍ وَعَادٍ وَثَمُودَ وَٱلَّذِينَ مِنۢ بَعْدِهِمْۚ وَمَا ٱللَّهُ يُرِيدُ ظُلْمًا لِّلْعِبَادِ ", "translation": "Like the custom of the people of Noah and of ʿAad and Thamūd and those after them. And Allāh wants no injustice for [His] servants.", "words": [{"id": 1, "arabic": "مِثْلَ", "translit": "َlْhtِm", "root": "مثل"}, {"id": 2, "arabic": "دَأْبِ", "translit": "ِbْaʾَd", "root": "داب"}, {"id": 3, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 4, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 5, "arabic": "وَعَادٍ", "translit": "ٍdāَʿعَw", "root": "عود"}, {"id": 6, "arabic": "وَثَمُودَ", "translit": "َdwُmَhtَw", "root": ""}, {"id": 7, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 8, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 9, "arabic": "بَعْدِهِمْ", "translit": "ْmِhِdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 13, "arabic": "ظُلْمًا", "translit": "āًmْlُẓ", "root": "ظلم"}, {"id": 14, "arabic": "لِّلْعِبَادِ", "translit": "ِdāَbِʿعْlِّl", "root": "عبد"}], "hasIhya": false}, {"ayah": 32, "text": "وَيَٰقَوْمِ إِنِّىٓ أَخَافُ عَلَيْكُمْ يَوْمَ ٱلتَّنَادِ ", "translation": "And O my people, indeed I fear for you the Day of Calling[1] -", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَخَافُ", "translit": "ُfāَhkَaʾ", "root": "خوف"}, {"id": 4, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 6, "arabic": "ٱلتَّنَادِ", "translit": "ِdāَnَّtlٱ", "root": "ندي"}], "hasIhya": false}, {"ayah": 33, "text": "يَوْمَ تُوَلُّونَ مُدْبِرِينَ مَا لَكُم مِّنَ ٱللَّهِ مِنْ عَاصِمٍۗ وَمَن يُضْلِلِ ٱللَّهُ فَمَا لَهُۥ مِنْ هَادٍ ", "translation": "The Day you will turn your backs fleeing; there is not for you from Allāh any protector. And whoever Allāh sends astray - there is not for him any guide.", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تُوَلُّونَ", "translit": "َnwُّlَwُt", "root": "ولي"}, {"id": 3, "arabic": "مُدْبِرِينَ", "translit": "َnyِrِbْdُm", "root": "دبر"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "عَاصِمٍ", "translit": "ٍmِṣāَʿع", "root": "عصم"}, {"id": 10, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 11, "arabic": "يُضْلِلِ", "translit": "ِlِlْḍُy", "root": "ضلل"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 14, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "هَادٍ", "translit": "ٍdāَh", "root": "هدي"}], "hasIhya": true}, {"ayah": 34, "text": "وَلَقَدْ جَآءَكُمْ يُوسُفُ مِن قَبْلُ بِٱلْبَيِّنَٰتِ فَمَا زِلْتُمْ فِى شَكٍّ مِّمَّا جَآءَكُم بِهِۦۖ حَتَّىٰٓ إِذَا هَلَكَ قُلْتُمْ لَن يَبْعَثَ ٱللَّهُ مِنۢ بَعْدِهِۦ رَسُولًاۚ كَذَٰلِكَ يُضِلُّ ٱللَّهُ مَنْ هُوَ مُسْرِفٌ مُّرْتَابٌ ", "translation": "And Joseph had already come to you before with clear proofs, but you remained in doubt of that which he brought to you, until when he died, you said, 'Never will Allāh send a messenger after him.' Thus does Allāh leave astray he who is a transgressor and skeptic.\"", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "يُوسُفُ", "translit": "ُfُswُy", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 6, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 7, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 8, "arabic": "زِلْتُمْ", "translit": "ْmُtْlِz", "root": "زيل"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "شَكٍّ", "translit": "ٍّkَhs", "root": "شكك"}, {"id": 11, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 12, "arabic": "جَآءَكُم", "translit": "mُkَءٓāَjg", "root": "جيا"}, {"id": 13, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 14, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 15, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 16, "arabic": "هَلَكَ", "translit": "َkَlَh", "root": "هلك"}, {"id": 17, "arabic": "قُلْتُمْ", "translit": "ْmُtْlُq", "root": "قول"}, {"id": 18, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 19, "arabic": "يَبْعَثَ", "translit": "َhtَʿعْbَy", "root": "بعث"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 22, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 23, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 24, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 25, "arabic": "يُضِلُّ", "translit": "ُّlِḍُy", "root": "ضلل"}, {"id": 26, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 28, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 29, "arabic": "مُسْرِفٌ", "translit": "ٌfِrْsُm", "root": "سرف"}, {"id": 30, "arabic": "مُّرْتَابٌ", "translit": "ٌbāَtْrُّm", "root": "ريب"}], "hasIhya": false}, {"ayah": 35, "text": "ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِ ٱللَّهِ بِغَيْرِ سُلْطَٰنٍ أَتَىٰهُمْۖ كَبُرَ مَقْتًا عِندَ ٱللَّهِ وَعِندَ ٱلَّذِينَ ءَامَنُوا۟ۚ كَذَٰلِكَ يَطْبَعُ ٱللَّهُ عَلَىٰ كُلِّ قَلْبِ مُتَكَبِّرٍ جَبَّارٍ ", "translation": "Those who dispute concerning the signs of Allāh without an authority[1] having come to them - great is hatred [of them] in the sight of Allāh and in the sight of those who have believed. Thus does Allāh seal over every heart [belonging to] an arrogant tyrant.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُجَٰدِلُونَ", "translit": "َnwُlِdَٰjgُy", "root": "جدل"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 7, "arabic": "سُلْطَٰنٍ", "translit": "ٍnَٰṭْlُs", "root": "سلط"}, {"id": 8, "arabic": "أَتَىٰهُمْ", "translit": "ْmُhٰàَtَaʾ", "root": "اتي"}, {"id": 9, "arabic": "كَبُرَ", "translit": "َrُbَk", "root": "كبر"}, {"id": 10, "arabic": "مَقْتًا", "translit": "āًtْqَm", "root": "مقت"}, {"id": 11, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَعِندَ", "translit": "َdnِʿعَw", "root": "عند"}, {"id": 14, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 16, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 17, "arabic": "يَطْبَعُ", "translit": "ُʿعَbْṭَy", "root": "طبع"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 20, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 21, "arabic": "قَلْبِ", "translit": "ِbْlَq", "root": "قلب"}, {"id": 22, "arabic": "مُتَكَبِّرٍ", "translit": "ٍrِّbَkَtُm", "root": "كبر"}, {"id": 23, "arabic": "جَبَّارٍ", "translit": "ٍrāَّbَjg", "root": "جبر"}], "hasIhya": true}, {"ayah": 36, "text": "وَقَالَ فِرْعَوْنُ يَٰهَٰمَٰنُ ٱبْنِ لِى صَرْحًا لَّعَلِّىٓ أَبْلُغُ ٱلْأَسْبَٰبَ ", "translation": "And Pharaoh said, \"O Hāmān, construct for me a tower that I might reach the ways[1] -", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "فِرْعَوْنُ", "translit": "ُnْwَʿعْrِf", "root": ""}, {"id": 3, "arabic": "يَٰهَٰمَٰنُ", "translit": "ُnَٰmَٰhَٰy", "root": ""}, {"id": 4, "arabic": "ٱبْنِ", "translit": "ِnْbٱ", "root": "بني"}, {"id": 5, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 6, "arabic": "صَرْحًا", "translit": "āًḥْrَṣ", "root": "صرح"}, {"id": 7, "arabic": "لَّعَلِّىٓ", "translit": "ٓàِّlَʿعَّl", "root": ""}, {"id": 8, "arabic": "أَبْلُغُ", "translit": "ُغُlْbَaʾ", "root": "بلغ"}, {"id": 9, "arabic": "ٱلْأَسْبَٰبَ", "translit": "َbَٰbْsَaʾْlٱ", "root": "سبب"}], "hasIhya": false}, {"ayah": 37, "text": "أَسْبَٰبَ ٱلسَّمَٰوَٰتِ فَأَطَّلِعَ إِلَىٰٓ إِلَٰهِ مُوسَىٰ وَإِنِّى لَأَظُنُّهُۥ كَٰذِبًاۚ وَكَذَٰلِكَ زُيِّنَ لِفِرْعَوْنَ سُوٓءُ عَمَلِهِۦ وَصُدَّ عَنِ ٱلسَّبِيلِۚ وَمَا كَيْدُ فِرْعَوْنَ إِلَّا فِى تَبَابٍ ", "translation": "The ways into the heavens - so that I may look at the deity of Moses; but indeed, I think he is a liar.\" And thus was made attractive to Pharaoh the evil of his deed, and he was averted from the [right] way. And the plan of Pharaoh was not except in ruin.", "words": [{"id": 1, "arabic": "أَسْبَٰبَ", "translit": "َbَٰbْsَaʾ", "root": "سبب"}, {"id": 2, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "فَأَطَّلِعَ", "translit": "َʿعِlَّṭَaʾَf", "root": "طلع"}, {"id": 4, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 5, "arabic": "إِلَٰهِ", "translit": "ِhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 7, "arabic": "وَإِنِّى", "translit": "àِّnِiʾَw", "root": ""}, {"id": 8, "arabic": "لَأَظُنُّهُۥ", "translit": "ۥُhُّnُẓَaʾَl", "root": "ظنن"}, {"id": 9, "arabic": "كَٰذِبًا", "translit": "āًbِhdَٰk", "root": "كذب"}, {"id": 10, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 11, "arabic": "زُيِّنَ", "translit": "َnِّyُz", "root": "زين"}, {"id": 12, "arabic": "لِفِرْعَوْنَ", "translit": "َnْwَʿعْrِfِl", "root": ""}, {"id": 13, "arabic": "سُوٓءُ", "translit": "ُءٓwُs", "root": "سوا"}, {"id": 14, "arabic": "عَمَلِهِۦ", "translit": "ۦِhِlَmَʿع", "root": "عمل"}, {"id": 15, "arabic": "وَصُدَّ", "translit": "َّdُṣَw", "root": "صدد"}, {"id": 16, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 17, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 18, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 19, "arabic": "كَيْدُ", "translit": "ُdْyَk", "root": "كيد"}, {"id": 20, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 21, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "تَبَابٍ", "translit": "ٍbāَbَt", "root": "تبب"}], "hasIhya": false}, {"ayah": 38, "text": "وَقَالَ ٱلَّذِىٓ ءَامَنَ يَٰقَوْمِ ٱتَّبِعُونِ أَهْدِكُمْ سَبِيلَ ٱلرَّشَادِ ", "translation": "And he who believed said, \"O my people, follow me; I will guide you to the way of right conduct.", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 4, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 5, "arabic": "ٱتَّبِعُونِ", "translit": "ِnwُʿعِbَّtٱ", "root": "تبع"}, {"id": 6, "arabic": "أَهْدِكُمْ", "translit": "ْmُkِdْhَaʾ", "root": "هدي"}, {"id": 7, "arabic": "سَبِيلَ", "translit": "َlyِbَs", "root": "سبل"}, {"id": 8, "arabic": "ٱلرَّشَادِ", "translit": "ِdāَhsَّrlٱ", "root": "رشد"}], "hasIhya": false}, {"ayah": 39, "text": "يَٰقَوْمِ إِنَّمَا هَٰذِهِ ٱلْحَيَوٰةُ ٱلدُّنْيَا مَتَٰعٌ وَإِنَّ ٱلْءَاخِرَةَ هِىَ دَارُ ٱلْقَرَارِ ", "translation": "O my people, this worldly life is only [temporary] enjoyment, and indeed, the Hereafter - that is the home of [permanent] settlement.", "words": [{"id": 1, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 2, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 4, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "مَتَٰعٌ", "translit": "ٌʿعَٰtَm", "root": "متع"}, {"id": 7, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 8, "arabic": "ٱلْءَاخِرَةَ", "translit": "َẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 9, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 10, "arabic": "دَارُ", "translit": "ُrāَd", "root": "دور"}, {"id": 11, "arabic": "ٱلْقَرَارِ", "translit": "ِrāَrَqْlٱ", "root": "قرر"}], "hasIhya": false}, {"ayah": 40, "text": "مَنْ عَمِلَ سَيِّئَةً فَلَا يُجْزَىٰٓ إِلَّا مِثْلَهَاۖ وَمَنْ عَمِلَ صَٰلِحًا مِّن ذَكَرٍ أَوْ أُنثَىٰ وَهُوَ مُؤْمِنٌ فَأُو۟لَٰٓئِكَ يَدْخُلُونَ ٱلْجَنَّةَ يُرْزَقُونَ فِيهَا بِغَيْرِ حِسَابٍ ", "translation": "Whoever does an evil deed will not be recompensed except by the like thereof; but whoever does righteousness, whether male or female, while he is a believer - those will enter Paradise, being given provision therein without account.", "words": [{"id": 1, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 2, "arabic": "عَمِلَ", "translit": "َlِmَʿع", "root": "عمل"}, {"id": 3, "arabic": "سَيِّئَةً", "translit": "ًẗَyʾِّyَs", "root": "سوا"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "يُجْزَىٰٓ", "translit": "ٰٓàَzْjgُy", "root": "جزي"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "مِثْلَهَا", "translit": "āَhَlْhtِm", "root": "مثل"}, {"id": 8, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 9, "arabic": "عَمِلَ", "translit": "َlِmَʿع", "root": "عمل"}, {"id": 10, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "ذَكَرٍ", "translit": "ٍrَkَhd", "root": "ذكر"}, {"id": 13, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 14, "arabic": "أُنثَىٰ", "translit": "ٰàَhtnُaʾ", "root": "انث"}, {"id": 15, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 16, "arabic": "مُؤْمِنٌ", "translit": "ٌnِmْwʾُm", "root": "امن"}, {"id": 17, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 18, "arabic": "يَدْخُلُونَ", "translit": "َnwُlُhkْdَy", "root": "دخل"}, {"id": 19, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 20, "arabic": "يُرْزَقُونَ", "translit": "َnwُqَzْrُy", "root": "رزق"}, {"id": 21, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 22, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 23, "arabic": "حِسَابٍ", "translit": "ٍbāَsِḥ", "root": "حسب"}], "hasIhya": false}, {"ayah": 41, "text": "وَيَٰقَوْمِ مَا لِىٓ أَدْعُوكُمْ إِلَى ٱلنَّجَوٰةِ وَتَدْعُونَنِىٓ إِلَى ٱلنَّارِ ", "translation": "And O my people, how is it that I invite you to salvation while you invite me to the Fire?", "words": [{"id": 1, "arabic": "وَيَٰقَوْمِ", "translit": "ِmْwَqَٰyَw", "root": "قوم"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "لِىٓ", "translit": "ٓàِl", "root": ""}, {"id": 4, "arabic": "أَدْعُوكُمْ", "translit": "ْmُkwُʿعْdَaʾ", "root": "دعو"}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱلنَّجَوٰةِ", "translit": "ِẗٰwَjgَّnlٱ", "root": "نجو"}, {"id": 7, "arabic": "وَتَدْعُونَنِىٓ", "translit": "ٓàِnَnwُʿعْdَtَw", "root": "دعو"}, {"id": 8, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 42, "text": "تَدْعُونَنِى لِأَكْفُرَ بِٱللَّهِ وَأُشْرِكَ بِهِۦ مَا لَيْسَ لِى بِهِۦ عِلْمٌ وَأَنَا۠ أَدْعُوكُمْ إِلَى ٱلْعَزِيزِ ٱلْغَفَّٰرِ ", "translation": "You invite me to disbelieve in Allāh and associate with Him that of which I have no knowledge, and I invite you to the Exalted in Might, the Perpetual Forgiver.[1]", "words": [{"id": 1, "arabic": "تَدْعُونَنِى", "translit": "àِnَnwُʿعْdَt", "root": "دعو"}, {"id": 2, "arabic": "لِأَكْفُرَ", "translit": "َrُfْkَaʾِl", "root": "كفر"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "وَأُشْرِكَ", "translit": "َkِrْhsُaʾَw", "root": "شرك"}, {"id": 5, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 8, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "عِلْمٌ", "translit": "ٌmْlِʿع", "root": "علم"}, {"id": 11, "arabic": "وَأَنَا۠", "translit": "۠āَnَaʾَw", "root": ""}, {"id": 12, "arabic": "أَدْعُوكُمْ", "translit": "ْmُkwُʿعْdَaʾ", "root": "دعو"}, {"id": 13, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 14, "arabic": "ٱلْعَزِيزِ", "translit": "ِzyِzَʿعْlٱ", "root": "عزز"}, {"id": 15, "arabic": "ٱلْغَفَّٰرِ", "translit": "ِrَّٰfَغْlٱ", "root": "غفر"}], "hasIhya": false}, {"ayah": 43, "text": "لَا جَرَمَ أَنَّمَا تَدْعُونَنِىٓ إِلَيْهِ لَيْسَ لَهُۥ دَعْوَةٌ فِى ٱلدُّنْيَا وَلَا فِى ٱلْءَاخِرَةِ وَأَنَّ مَرَدَّنَآ إِلَى ٱللَّهِ وَأَنَّ ٱلْمُسْرِفِينَ هُمْ أَصْحَٰبُ ٱلنَّارِ ", "translation": "Assuredly, that to which you invite me has no [response to a] supplication in this world or in the Hereafter; and indeed, our return is to Allāh, and indeed, the transgressors will be companions of the Fire.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "جَرَمَ", "translit": "َmَrَjg", "root": "جرم"}, {"id": 3, "arabic": "أَنَّمَا", "translit": "āَmَّnَaʾ", "root": ""}, {"id": 4, "arabic": "تَدْعُونَنِىٓ", "translit": "ٓàِnَnwُʿعْdَt", "root": "دعو"}, {"id": 5, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "دَعْوَةٌ", "translit": "ٌẗَwْʿعَd", "root": "دعو"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 14, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 15, "arabic": "مَرَدَّنَآ", "translit": "ٓāَnَّdَrَm", "root": "ردد"}, {"id": 16, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 19, "arabic": "ٱلْمُسْرِفِينَ", "translit": "َnyِfِrْsُmْlٱ", "root": "سرف"}, {"id": 20, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 21, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 22, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": true}, {"ayah": 44, "text": "فَسَتَذْكُرُونَ مَآ أَقُولُ لَكُمْۚ وَأُفَوِّضُ أَمْرِىٓ إِلَى ٱللَّهِۚ إِنَّ ٱللَّهَ بَصِيرٌۢ بِٱلْعِبَادِ ", "translation": "And you will remember what I [now] say to you, and I entrust my affair to Allāh. Indeed, Allāh is Seeing of [His] servants.\"", "words": [{"id": 1, "arabic": "فَسَتَذْكُرُونَ", "translit": "َnwُrُkْhdَtَsَf", "root": "ذكر"}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أَقُولُ", "translit": "ُlwُqَaʾ", "root": "قول"}, {"id": 4, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 5, "arabic": "وَأُفَوِّضُ", "translit": "ُḍِّwَfُaʾَw", "root": "فوض"}, {"id": 6, "arabic": "أَمْرِىٓ", "translit": "ٓàِrْmَaʾ", "root": "امر"}, {"id": 7, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "بَصِيرٌۢ", "translit": "ٌۢryِṣَb", "root": "بصر"}, {"id": 12, "arabic": "بِٱلْعِبَادِ", "translit": "ِdāَbِʿعْlٱِb", "root": "عبد"}], "hasIhya": false}, {"ayah": 45, "text": "فَوَقَىٰهُ ٱللَّهُ سَيِّـَٔاتِ مَا مَكَرُوا۟ۖ وَحَاقَ بِـَٔالِ فِرْعَوْنَ سُوٓءُ ٱلْعَذَابِ ", "translation": "So Allāh protected him from the evils they plotted, and the people of Pharaoh were enveloped by the worst of punishment -", "words": [{"id": 1, "arabic": "فَوَقَىٰهُ", "translit": "ُhٰàَqَwَf", "root": "وقي"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "سَيِّـَٔاتِ", "translit": "ِtāَٔـِّyَs", "root": "سوا"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "مَكَرُوا۟", "translit": "۟āwُrَkَm", "root": "مكر"}, {"id": 6, "arabic": "وَحَاقَ", "translit": "َqāَḥَw", "root": "حيق"}, {"id": 7, "arabic": "بِـَٔالِ", "translit": "ِlāَٔـِb", "root": "اول"}, {"id": 8, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 9, "arabic": "سُوٓءُ", "translit": "ُءٓwُs", "root": "سوا"}, {"id": 10, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}], "hasIhya": false}, {"ayah": 46, "text": "ٱلنَّارُ يُعْرَضُونَ عَلَيْهَا غُدُوًّا وَعَشِيًّاۖ وَيَوْمَ تَقُومُ ٱلسَّاعَةُ أَدْخِلُوٓا۟ ءَالَ فِرْعَوْنَ أَشَدَّ ٱلْعَذَابِ ", "translation": "The Fire; they are exposed to it morning and evening.[1] And the Day the Hour appears [it will be said], \"Make the people of Pharaoh enter the severest punishment.\"", "words": [{"id": 1, "arabic": "ٱلنَّارُ", "translit": "ُrāَّnlٱ", "root": "نور"}, {"id": 2, "arabic": "يُعْرَضُونَ", "translit": "َnwُḍَrْʿعُy", "root": "عرض"}, {"id": 3, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "غُدُوًّا", "translit": "āًّwُdُغ", "root": "غدو"}, {"id": 5, "arabic": "وَعَشِيًّا", "translit": "āًّyِhsَʿعَw", "root": "عشو"}, {"id": 6, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 7, "arabic": "تَقُومُ", "translit": "ُmwُqَt", "root": "قوم"}, {"id": 8, "arabic": "ٱلسَّاعَةُ", "translit": "ُẗَʿعāَّslٱ", "root": "سوع"}, {"id": 9, "arabic": "أَدْخِلُوٓا۟", "translit": "۟āٓwُlِhkْdَaʾ", "root": "دخل"}, {"id": 10, "arabic": "ءَالَ", "translit": "َlāَء", "root": "اول"}, {"id": 11, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 12, "arabic": "أَشَدَّ", "translit": "َّdَhsَaʾ", "root": "شدد"}, {"id": 13, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}], "hasIhya": true}, {"ayah": 47, "text": "وَإِذْ يَتَحَآجُّونَ فِى ٱلنَّارِ فَيَقُولُ ٱلضُّعَفَٰٓؤُا۟ لِلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا كُنَّا لَكُمْ تَبَعًا فَهَلْ أَنتُم مُّغْنُونَ عَنَّا نَصِيبًا مِّنَ ٱلنَّارِ ", "translation": "And [mention] when they will argue within the Fire, and the weak will say to those who had been arrogant, \"Indeed, we were [only] your followers, so will you relieve us of a share of the Fire?\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "يَتَحَآجُّونَ", "translit": "َnwُّjgٓāَḥَtَy", "root": "حجج"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 5, "arabic": "فَيَقُولُ", "translit": "ُlwُqَyَf", "root": "قول"}, {"id": 6, "arabic": "ٱلضُّعَفَٰٓؤُا۟", "translit": "۟āُwʾَٰٓfَʿعُّḍlٱ", "root": "ضعف"}, {"id": 7, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 8, "arabic": "ٱسْتَكْبَرُوٓا۟", "translit": "۟āٓwُrَbْkَtْsٱ", "root": "كبر"}, {"id": 9, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 10, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 11, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 12, "arabic": "تَبَعًا", "translit": "āًʿعَbَt", "root": "تبع"}, {"id": 13, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 14, "arabic": "أَنتُم", "translit": "mُtnَaʾ", "root": ""}, {"id": 15, "arabic": "مُّغْنُونَ", "translit": "َnwُnْغُّm", "root": "غني"}, {"id": 16, "arabic": "عَنَّا", "translit": "āَّnَʿع", "root": ""}, {"id": 17, "arabic": "نَصِيبًا", "translit": "āًbyِṣَn", "root": "نصب"}, {"id": 18, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 19, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 48, "text": "قَالَ ٱلَّذِينَ ٱسْتَكْبَرُوٓا۟ إِنَّا كُلٌّ فِيهَآ إِنَّ ٱللَّهَ قَدْ حَكَمَ بَيْنَ ٱلْعِبَادِ ", "translation": "Those who had been arrogant will say, \"Indeed, all [of us] are in it. Indeed, Allāh has judged between the servants.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱسْتَكْبَرُوٓا۟", "translit": "۟āٓwُrَbْkَtْsٱ", "root": "كبر"}, {"id": 4, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 5, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 6, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 10, "arabic": "حَكَمَ", "translit": "َmَkَḥ", "root": "حكم"}, {"id": 11, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 12, "arabic": "ٱلْعِبَادِ", "translit": "ِdāَbِʿعْlٱ", "root": "عبد"}], "hasIhya": true}, {"ayah": 49, "text": "وَقَالَ ٱلَّذِينَ فِى ٱلنَّارِ لِخَزَنَةِ جَهَنَّمَ ٱدْعُوا۟ رَبَّكُمْ يُخَفِّفْ عَنَّا يَوْمًا مِّنَ ٱلْعَذَابِ ", "translation": "And those in the Fire will say to the keepers of Hell, \"Supplicate your Lord to lighten for us a day from the punishment.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 5, "arabic": "لِخَزَنَةِ", "translit": "ِẗَnَzَhkِl", "root": "خزن"}, {"id": 6, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 7, "arabic": "ٱدْعُوا۟", "translit": "۟āwُʿعْdٱ", "root": "دعو"}, {"id": 8, "arabic": "رَبَّكُمْ", "translit": "ْmُkَّbَr", "root": "ربب"}, {"id": 9, "arabic": "يُخَفِّفْ", "translit": "ْfِّfَhkُy", "root": "خفف"}, {"id": 10, "arabic": "عَنَّا", "translit": "āَّnَʿع", "root": ""}, {"id": 11, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 12, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 13, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}], "hasIhya": true}, {"ayah": 50, "text": "قَالُوٓا۟ أَوَلَمْ تَكُ تَأْتِيكُمْ رُسُلُكُم بِٱلْبَيِّنَٰتِۖ قَالُوا۟ بَلَىٰۚ قَالُوا۟ فَٱدْعُوا۟ۗ وَمَا دُعَٰٓؤُا۟ ٱلْكَٰفِرِينَ إِلَّا فِى ضَلَٰلٍ ", "translation": "They will say, \"Did there not come to you your messengers with clear proofs?\" They will say, \"Yes.\" They will reply, \"Then supplicate [yourselves], but the supplication of the disbelievers is not except in error [i.e., futility].\"", "words": [{"id": 1, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 2, "arabic": "أَوَلَمْ", "translit": "ْmَlَwَaʾ", "root": ""}, {"id": 3, "arabic": "تَكُ", "translit": "ُkَt", "root": "كون"}, {"id": 4, "arabic": "تَأْتِيكُمْ", "translit": "ْmُkyِtْaʾَt", "root": "اتي"}, {"id": 5, "arabic": "رُسُلُكُم", "translit": "mُkُlُsُr", "root": "رسل"}, {"id": 6, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 7, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 8, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 9, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 10, "arabic": "فَٱدْعُوا۟", "translit": "۟āwُʿعْdٱَf", "root": "دعو"}, {"id": 11, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 12, "arabic": "دُعَٰٓؤُا۟", "translit": "۟āُwʾَٰٓʿعُd", "root": "دعو"}, {"id": 13, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "ضَلَٰلٍ", "translit": "ٍlَٰlَḍ", "root": "ضلل"}], "hasIhya": true}, {"ayah": 51, "text": "إِنَّا لَنَنصُرُ رُسُلَنَا وَٱلَّذِينَ ءَامَنُوا۟ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَيَوْمَ يَقُومُ ٱلْأَشْهَٰدُ ", "translation": "Indeed, We will support Our messengers and those who believe during the life of this world and on the Day when the witnesses will stand -", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَنَنصُرُ", "translit": "ُrُṣnَnَl", "root": "نصر"}, {"id": 3, "arabic": "رُسُلَنَا", "translit": "āَnَlُsُr", "root": "رسل"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 8, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 9, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 10, "arabic": "يَقُومُ", "translit": "ُmwُqَy", "root": "قوم"}, {"id": 11, "arabic": "ٱلْأَشْهَٰدُ", "translit": "ُdَٰhْhsَaʾْlٱ", "root": "شهد"}], "hasIhya": false}, {"ayah": 52, "text": "يَوْمَ لَا يَنفَعُ ٱلظَّٰلِمِينَ مَعْذِرَتُهُمْۖ وَلَهُمُ ٱللَّعْنَةُ وَلَهُمْ سُوٓءُ ٱلدَّارِ ", "translation": "The Day their excuse will not benefit the wrongdoers, and they will have the curse, and they will have the worst home [i.e., Hell].", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "يَنفَعُ", "translit": "ُʿعَfnَy", "root": "نفع"}, {"id": 4, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}, {"id": 5, "arabic": "مَعْذِرَتُهُمْ", "translit": "ْmُhُtَrِhdْʿعَm", "root": "عذر"}, {"id": 6, "arabic": "وَلَهُمُ", "translit": "ُmُhَlَw", "root": ""}, {"id": 7, "arabic": "ٱللَّعْنَةُ", "translit": "ُẗَnْʿعَّllٱ", "root": "لعن"}, {"id": 8, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 9, "arabic": "سُوٓءُ", "translit": "ُءٓwُs", "root": "سوا"}, {"id": 10, "arabic": "ٱلدَّارِ", "translit": "ِrāَّdlٱ", "root": "دور"}], "hasIhya": true}, {"ayah": 53, "text": "وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْهُدَىٰ وَأَوْرَثْنَا بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَٰبَ ", "translation": "And We had certainly given Moses guidance, and We caused the Children of Israel to inherit the Scripture", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 5, "arabic": "وَأَوْرَثْنَا", "translit": "āَnْhtَrْwَaʾَw", "root": "ورث"}, {"id": 6, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 7, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 8, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}], "hasIhya": false}, {"ayah": 54, "text": "هُدًى وَذِكْرَىٰ لِأُو۟لِى ٱلْأَلْبَٰبِ ", "translation": "As guidance and a reminder for those of understanding.", "words": [{"id": 1, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 2, "arabic": "وَذِكْرَىٰ", "translit": "ٰàَrْkِhdَw", "root": "ذكر"}, {"id": 3, "arabic": "لِأُو۟لِى", "translit": "àِl۟wُaʾِl", "root": ""}, {"id": 4, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}], "hasIhya": false}, {"ayah": 55, "text": "فَٱصْبِرْ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ وَٱسْتَغْفِرْ لِذَنۢبِكَ وَسَبِّحْ بِحَمْدِ رَبِّكَ بِٱلْعَشِىِّ وَٱلْإِبْكَٰرِ ", "translation": "So be patient, [O Muḥammad]. Indeed, the promise of Allāh is truth. And ask forgiveness for your sin[1] and exalt [Allāh] with praise of your Lord in the evening and the morning.", "words": [{"id": 1, "arabic": "فَٱصْبِرْ", "translit": "ْrِbْṣٱَf", "root": "صبر"}, {"id": 2, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 3, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "حَقٌّ", "translit": "ٌّqَḥ", "root": "حقق"}, {"id": 6, "arabic": "وَٱسْتَغْفِرْ", "translit": "ْrِfْغَtْsٱَw", "root": "غفر"}, {"id": 7, "arabic": "لِذَنۢبِكَ", "translit": "َkِbۢnَhdِl", "root": "ذنب"}, {"id": 8, "arabic": "وَسَبِّحْ", "translit": "ْḥِّbَsَw", "root": "سبح"}, {"id": 9, "arabic": "بِحَمْدِ", "translit": "ِdْmَḥِb", "root": "حمد"}, {"id": 10, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 11, "arabic": "بِٱلْعَشِىِّ", "translit": "ِّàِhsَʿعْlٱِb", "root": "عشو"}, {"id": 12, "arabic": "وَٱلْإِبْكَٰرِ", "translit": "ِrَٰkْbِiʾْlٱَw", "root": "بكر"}], "hasIhya": true}, {"ayah": 56, "text": "إِنَّ ٱلَّذِينَ يُجَٰدِلُونَ فِىٓ ءَايَٰتِ ٱللَّهِ بِغَيْرِ سُلْطَٰنٍ أَتَىٰهُمْۙ إِن فِى صُدُورِهِمْ إِلَّا كِبْرٌ مَّا هُم بِبَٰلِغِيهِۚ فَٱسْتَعِذْ بِٱللَّهِۖ إِنَّهُۥ هُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ ", "translation": "Indeed, those who dispute concerning the signs of Allāh without [any] evidence having come to them - there is not within their breasts except pride, [the extent of] which they cannot reach. So seek refuge in Allāh. Indeed, it is He who is the Hearing, the Seeing.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُجَٰدِلُونَ", "translit": "َnwُlِdَٰjgُy", "root": "جدل"}, {"id": 4, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 5, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 8, "arabic": "سُلْطَٰنٍ", "translit": "ٍnَٰṭْlُs", "root": "سلط"}, {"id": 9, "arabic": "أَتَىٰهُمْ", "translit": "ْmُhٰàَtَaʾ", "root": "اتي"}, {"id": 10, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "صُدُورِهِمْ", "translit": "ْmِhِrwُdُṣ", "root": "صدر"}, {"id": 13, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 14, "arabic": "كِبْرٌ", "translit": "ٌrْbِk", "root": "كبر"}, {"id": 15, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 16, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 17, "arabic": "بِبَٰلِغِيهِ", "translit": "ِhyِغِlَٰbِb", "root": "بلغ"}, {"id": 18, "arabic": "فَٱسْتَعِذْ", "translit": "ْhdِʿعَtْsٱَf", "root": "عوذ"}, {"id": 19, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 20, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 21, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 22, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 23, "arabic": "ٱلْبَصِيرُ", "translit": "ُryِṣَbْlٱ", "root": "بصر"}], "hasIhya": true}, {"ayah": 57, "text": "لَخَلْقُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ أَكْبَرُ مِنْ خَلْقِ ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَعْلَمُونَ ", "translation": "The creation of the heavens and earth is greater than the creation of mankind, but most of the people do not know.", "words": [{"id": 1, "arabic": "لَخَلْقُ", "translit": "ُqْlَhkَl", "root": "خلق"}, {"id": 2, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 4, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "خَلْقِ", "translit": "ِqْlَhk", "root": "خلق"}, {"id": 7, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 8, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 9, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 10, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 58, "text": "وَمَا يَسْتَوِى ٱلْأَعْمَىٰ وَٱلْبَصِيرُ وَٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَلَا ٱلْمُسِىٓءُۚ قَلِيلًا مَّا تَتَذَكَّرُونَ ", "translation": "And not equal are the blind and the seeing, nor are those who believe and do righteous deeds and the evildoer. Little do you remember.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "يَسْتَوِى", "translit": "àِwَtْsَy", "root": "سوي"}, {"id": 3, "arabic": "ٱلْأَعْمَىٰ", "translit": "ٰàَmْʿعَaʾْlٱ", "root": "عمي"}, {"id": 4, "arabic": "وَٱلْبَصِيرُ", "translit": "ُryِṣَbْlٱَw", "root": "بصر"}, {"id": 5, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 6, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 7, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 8, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "ٱلْمُسِىٓءُ", "translit": "ُءٓàِsُmْlٱ", "root": "سوا"}, {"id": 11, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 12, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 13, "arabic": "تَتَذَكَّرُونَ", "translit": "َnwُrَّkَhdَtَt", "root": "ذكر"}], "hasIhya": true}, {"ayah": 59, "text": "إِنَّ ٱلسَّاعَةَ لَءَاتِيَةٌ لَّا رَيْبَ فِيهَا وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يُؤْمِنُونَ ", "translation": "Indeed, the Hour is coming - no doubt about it - but most of the people do not believe.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 3, "arabic": "لَءَاتِيَةٌ", "translit": "ٌẗَyِtāَءَl", "root": "اتي"}, {"id": 4, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 5, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 6, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 7, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 8, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 9, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 60, "text": "وَقَالَ رَبُّكُمُ ٱدْعُونِىٓ أَسْتَجِبْ لَكُمْۚ إِنَّ ٱلَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِى سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ ", "translation": "And your Lord says, \"Call upon Me; I will respond to you.\" Indeed, those who disdain My worship will enter Hell [rendered] contemptible.", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "رَبُّكُمُ", "translit": "ُmُkُّbَr", "root": "ربب"}, {"id": 3, "arabic": "ٱدْعُونِىٓ", "translit": "ٓàِnwُʿعْdٱ", "root": "دعو"}, {"id": 4, "arabic": "أَسْتَجِبْ", "translit": "ْbِjgَtْsَaʾ", "root": "جوب"}, {"id": 5, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "يَسْتَكْبِرُونَ", "translit": "َnwُrِbْkَtْsَy", "root": "كبر"}, {"id": 9, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 10, "arabic": "عِبَادَتِى", "translit": "àِtَdāَbِʿع", "root": "عبد"}, {"id": 11, "arabic": "سَيَدْخُلُونَ", "translit": "َnwُlُhkْdَyَs", "root": "دخل"}, {"id": 12, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 13, "arabic": "دَاخِرِينَ", "translit": "َnyِrِhkāَd", "root": "دخر"}], "hasIhya": true}, {"ayah": 61, "text": "ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلَّيْلَ لِتَسْكُنُوا۟ فِيهِ وَٱلنَّهَارَ مُبْصِرًاۚ إِنَّ ٱللَّهَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَشْكُرُونَ ", "translation": "It is Allāh who made for you the night that you may rest therein and the day giving sight.[1] Indeed, Allāh is the possessor of bounty for the people, but most of them are not grateful.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلَّيْلَ", "translit": "َlْyَّlٱ", "root": "ليل"}, {"id": 6, "arabic": "لِتَسْكُنُوا۟", "translit": "۟āwُnُkْsَtِl", "root": "سكن"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَٱلنَّهَارَ", "translit": "َrāَhَّnlٱَw", "root": "نهر"}, {"id": 9, "arabic": "مُبْصِرًا", "translit": "āًrِṣْbُm", "root": "بصر"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "لَذُو", "translit": "wُhdَl", "root": ""}, {"id": 13, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 14, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 15, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 16, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 17, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 18, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَشْكُرُونَ", "translit": "َnwُrُkْhsَy", "root": "شكر"}], "hasIhya": false}, {"ayah": 62, "text": "ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْ خَٰلِقُ كُلِّ شَىْءٍ لَّآ إِلَٰهَ إِلَّا هُوَۖ فَأَنَّىٰ تُؤْفَكُونَ ", "translation": "That is Allāh, your Lord, Creator of all things; there is no deity except Him, so how are you deluded?", "words": [{"id": 1, "arabic": "ذَٰلِكُمُ", "translit": "ُmُkِlَٰhd", "root": ""}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "خَٰلِقُ", "translit": "ُqِlَٰhk", "root": "خلق"}, {"id": 5, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 6, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 7, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 8, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 11, "arabic": "فَأَنَّىٰ", "translit": "ٰàَّnَaʾَf", "root": ""}, {"id": 12, "arabic": "تُؤْفَكُونَ", "translit": "َnwُkَfْwʾُt", "root": "افك"}], "hasIhya": true}, {"ayah": 63, "text": "كَذَٰلِكَ يُؤْفَكُ ٱلَّذِينَ كَانُوا۟ بِـَٔايَٰتِ ٱللَّهِ يَجْحَدُونَ ", "translation": "Thus were those [before you] deluded who were rejecting the signs of Allāh.", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 2, "arabic": "يُؤْفَكُ", "translit": "ُkَfْwʾُy", "root": "افك"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 5, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "يَجْحَدُونَ", "translit": "َnwُdَḥْjgَy", "root": "جحد"}], "hasIhya": false}, {"ayah": 64, "text": "ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ قَرَارًا وَٱلسَّمَآءَ بِنَآءً وَصَوَّرَكُمْ فَأَحْسَنَ صُوَرَكُمْ وَرَزَقَكُم مِّنَ ٱلطَّيِّبَٰتِۚ ذَٰلِكُمُ ٱللَّهُ رَبُّكُمْۖ فَتَبَارَكَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ ", "translation": "It is Allāh who made for you the earth a place of settlement and the sky a structure [i.e., ceiling] and formed you and perfected your forms and provided you with good things. That is Allāh, your Lord; then blessed is Allāh, Lord of the worlds.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "قَرَارًا", "translit": "āًrāَrَq", "root": "قرر"}, {"id": 7, "arabic": "وَٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱَw", "root": "سمو"}, {"id": 8, "arabic": "بِنَآءً", "translit": "ًءٓāَnِb", "root": "بني"}, {"id": 9, "arabic": "وَصَوَّرَكُمْ", "translit": "ْmُkَrَّwَṣَw", "root": "صور"}, {"id": 10, "arabic": "فَأَحْسَنَ", "translit": "َnَsْḥَaʾَf", "root": "حسن"}, {"id": 11, "arabic": "صُوَرَكُمْ", "translit": "ْmُkَrَwُṣ", "root": "صور"}, {"id": 12, "arabic": "وَرَزَقَكُم", "translit": "mُkَqَzَrَw", "root": "رزق"}, {"id": 13, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 14, "arabic": "ٱلطَّيِّبَٰتِ", "translit": "ِtَٰbِّyَّṭlٱ", "root": "طيب"}, {"id": 15, "arabic": "ذَٰلِكُمُ", "translit": "ُmُkِlَٰhd", "root": ""}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 18, "arabic": "فَتَبَارَكَ", "translit": "َkَrāَbَtَf", "root": "برك"}, {"id": 19, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 21, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 65, "text": "هُوَ ٱلْحَىُّ لَآ إِلَٰهَ إِلَّا هُوَ فَٱدْعُوهُ مُخْلِصِينَ لَهُ ٱلدِّينَۗ ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَٰلَمِينَ ", "translation": "He is the Ever-Living;[1] there is no deity except Him, so call upon Him, [being] sincere to Him in religion. [All] praise is [due] to Allāh, Lord of the worlds.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلْحَىُّ", "translit": "ُّàَḥْlٱ", "root": "حيي"}, {"id": 3, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 4, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 7, "arabic": "فَٱدْعُوهُ", "translit": "ُhwُʿعْdٱَf", "root": "دعو"}, {"id": 8, "arabic": "مُخْلِصِينَ", "translit": "َnyِṣِlْhkُm", "root": "خلص"}, {"id": 9, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 10, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 11, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 12, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 13, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 14, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 66, "text": "قُلْ إِنِّى نُهِيتُ أَنْ أَعْبُدَ ٱلَّذِينَ تَدْعُونَ مِن دُونِ ٱللَّهِ لَمَّا جَآءَنِىَ ٱلْبَيِّنَٰتُ مِن رَّبِّى وَأُمِرْتُ أَنْ أُسْلِمَ لِرَبِّ ٱلْعَٰلَمِينَ ", "translation": "Say, [O Muḥammad], \"Indeed, I have been forbidden to worship those you call upon besides Allāh once the clear proofs have come to me from my Lord, and I have been commanded to submit to the Lord of the worlds.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 3, "arabic": "نُهِيتُ", "translit": "ُtyِhُn", "root": "نهي"}, {"id": 4, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 5, "arabic": "أَعْبُدَ", "translit": "َdُbْʿعَaʾ", "root": "عبد"}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "تَدْعُونَ", "translit": "َnwُʿعْdَt", "root": "دعو"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 12, "arabic": "جَآءَنِىَ", "translit": "َàِnَءٓāَjg", "root": "جيا"}, {"id": 13, "arabic": "ٱلْبَيِّنَٰتُ", "translit": "ُtَٰnِّyَbْlٱ", "root": "بين"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "رَّبِّى", "translit": "àِّbَّr", "root": "ربب"}, {"id": 16, "arabic": "وَأُمِرْتُ", "translit": "ُtْrِmُaʾَw", "root": "امر"}, {"id": 17, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 18, "arabic": "أُسْلِمَ", "translit": "َmِlْsُaʾ", "root": "سلم"}, {"id": 19, "arabic": "لِرَبِّ", "translit": "ِّbَrِl", "root": "ربب"}, {"id": 20, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 67, "text": "هُوَ ٱلَّذِى خَلَقَكُم مِّن تُرَابٍ ثُمَّ مِن نُّطْفَةٍ ثُمَّ مِنْ عَلَقَةٍ ثُمَّ يُخْرِجُكُمْ طِفْلًا ثُمَّ لِتَبْلُغُوٓا۟ أَشُدَّكُمْ ثُمَّ لِتَكُونُوا۟ شُيُوخًاۚ وَمِنكُم مَّن يُتَوَفَّىٰ مِن قَبْلُۖ وَلِتَبْلُغُوٓا۟ أَجَلًا مُّسَمًّى وَلَعَلَّكُمْ تَعْقِلُونَ ", "translation": "It is He who created you from dust, then from a sperm-drop, then from a clinging clot; then He brings you out as a child; then [He develops you] that you reach your [time of] maturity, then [further] that you become elders. And among you is he who is taken in death before [that], so that you reach a specified term;[1] and perhaps you will use reason.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَكُم", "translit": "mُkَqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "تُرَابٍ", "translit": "ٍbāَrُt", "root": "ترب"}, {"id": 6, "arabic": "ثُمَّ", "tran