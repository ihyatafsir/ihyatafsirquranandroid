nslit": "", "root": ""}, {"id": 14, "arabic": "اِ۬لْوَٰحِدِ", "translit": "", "root": ""}, {"id": 15, "arabic": "اِ۬لْقَهّ۪ارِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 17, "text": "اِ۬لْيَوْمَ تُجْز۪يٰ كُلُّ نَفْسِۢ بِمَا كَسَبَتْۖ لَا ظُلْمَ اَ۬لْيَوْمَۖ إِنَّ اَ۬للَّهَ سَرِيعُ اُ۬لْحِسَابِۖ", "words": [{"id": 1, "arabic": "اِ۬لْيَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تُجْز۪يٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "كُلُّ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَفْسِۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَسَبَتْۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "ظُلْمَ", "translit": "", "root": ""}, {"id": 9, "arabic": "اَ۬لْيَوْمَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 11, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 12, "arabic": "سَرِيعُ", "translit": "", "root": ""}, {"id": 13, "arabic": "اُ۬لْحِسَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 18, "text": "وَأَنذِرْهُمْ يَوْمَ اَ۬لَازِفَةِ إِذِ اِ۬لْقُلُوبُ لَدَي اَ۬لْحَنَاجِرِ كَٰظِمِينَۖ مَا لِلظَّٰلِمِينَ مِنْ حَمِيمࣲ وَلَا شَفِيعࣲ يُطَاعُۖ", "words": [{"id": 1, "arabic": "وَأَنذِرْهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لَازِفَةِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِذِ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْقُلُوبُ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَدَي", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْحَنَاجِرِ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَٰظِمِينَۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "مَا", "translit": "", "root": ""}, {"id": 10, "arabic": "لِلظَّٰلِمِينَ", "translit": "", "root": ""}, {"id": 11, "arabic": "