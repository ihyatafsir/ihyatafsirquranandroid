{"surah":40,"verses":[{"ayah":1,"text":"حمٓ ","translation":"Ḥā, Meem.[1]","words":[{"id":1,"arabic":"حمٓ","translit":"ٓmḥ","root":""}],"hasIhya":true},{"ayah":2,"text":"تَنزِيلُ ٱلْكِتَٰبِ مِنَ ٱللَّهِ ٱلْعَزِيزِ ٱلْعَلِيمِ ","translation":"The revelation of the Book [i.e., the Qur’ān] is from Allāh, the Exalted in Might, the Knowing,","words":[{"id":1,"arabic":"تَنزِيلُ","translit":"ُlyِznَt","root":"نزل"},{"id":2,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":3,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":4,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":5,"arabic":"ٱلْعَزِيزِ","translit":"ِzyِzَʿعْlٱ","root":"عزز"},{"id":6,"arabic":"ٱلْعَلِيمِ","translit":"ِmyِlَʿعْlٱ","root":"علم"}],"hasIhya":false},{"ayah":3,"text":"غَافِرِ ٱلذَّنۢبِ وَقَابِلِ ٱلتَّوْبِ شَدِيدِ ٱلْعِقَابِ ذِى ٱلطَّوْلِۖ لَآ إِلَٰهَ إِلَّا هُوَۖ إِلَيْهِ ٱلْمَصِيرُ ","translation":"The forgiver of sin, acceptor of repentance, severe in punishment, owner of abundance. There is no deity except Him; to Him is the destination.","words":[{"id":1,"arabic":"غَافِرِ","translit":"ِrِfāَغ","root":"غفر"},{"id":2,"arabic":"ٱلذَّنۢبِ","translit":"ِbۢnَّhdlٱ","root":"ذنب"},{"id":3,"arabic":"وَقَابِلِ","translit":"ِlِbāَqَw","root":"قبل"},{"id":4,"arabic":"ٱلتَّوْبِ","translit":"ِbْwَّtlٱ","root":"توب"},{"id":5,"arabic":"شَدِيدِ","translit":"ِdyِdَhs","root":"شدد"},{"id":6,"arabic":"ٱلْعِقَابِ","translit":"ِbāَqِʿعْlٱ","root":"عقب"},{"id":7,"arabic":"ذِى","translit":"àِhd","root":""},{"id":8,"arabic":"ٱلطَّوْلِ","translit":"ِlْwَّṭlٱ","root":"طول"},{"id":9,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":10,"arabic":"إِلَٰهَ","translit":"َhَٰlِiʾ","root":"اله"},{"id":11,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":12,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":13,"arabic":"إِلَيْهِ","translit":"ِhْyَlِiʾ","root":""},{"id":14,"arabic":"ٱلْمَصِيرُ","translit":"ُryِṣَmْlٱ","root":"صير"}],"hasIhya":true},{"ayah":4,"text":"مَا يُجَٰدِلُ فِىٓ ءَايَٰتِ ٱللَّهِ إِلَّا ٱلَّذِينَ كَفَرُوا۟ فَلَا يَغْرُرْكَ تَقَلُّبُهُمْ فِى ٱلْبِلَٰدِ ","translation":"No one disputes concerning the signs of Allāh except those who disbelieve, so be not deceived by their [uninhibited] movement throughout the land.","words":[{"id":1,"arabic":"مَا","translit":"āَm","root":""},{"id":2,"arabic":"يُجَٰدِلُ","translit":"ُlِdَٰjgُy","root":"جدل"},{"id":3,"arabic":"فِىٓ","translit":"ٓàِf","root":""},{"id":4,"arabic":"ءَايَٰتِ","translit":"ِtَٰyāَء","root":"ايي"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":7,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":8,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":9,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":10,"arabic":"يَغْرُرْكَ","translit":"َkْrُrْغَy","root":"غرر"},{"id":11,"arabic":"تَقَلُّبُهُمْ","translit":"ْmُhُbُّlَqَt","root":"قلب"},{"id":12,"arabic":"فِى","translit":"àِf","root":""},{"id":13,"arabic":"ٱلْبِلَٰدِ","translit":"ِdَٰlِbْlٱ","root":"بلد"}],"hasIhya":false},{"ayah":5,"text":"كَذَّبَتْ قَبْلَهُمْ قَوْمُ نُوحٍ وَٱلْأَحْزَابُ مِنۢ بَعْدِهِمْۖ وَهَمَّتْ كُلُّ أُمَّةٍۭ بِرَسُولِهِمْ لِيَأْخُذُوهُۖ وَجَٰدَلُوا۟ بِٱلْبَٰطِلِ لِيُدْحِضُوا۟ بِهِ ٱلْحَقَّ فَأَخَذْتُهُمْۖ فَكَيْفَ كَانَ عِقَابِ ","translation":"The people of Noah denied before them and the [disbelieving] factions after them, and every nation intended [a plot] for their messenger to seize him, and they disputed by [using] falsehood to [attempt to] invalidate thereby the truth. So I seized them, and how [terrible] was My penalty.","words":[{"id":1,"arabic":"كَذَّبَتْ","translit":"ْtَbَّhdَk","root":"كذب"},{"id":2,"arabic":"قَبْلَهُمْ","translit":"ْmُhَlْbَq","root":"قبل"},{"id":3,"arabic":"قَوْمُ","translit":"ُmْwَq","root":"قوم"},{"id":4,"arabic":"نُوحٍ","translit":"ٍḥwُn","root":""},{"id":5,"arabic":"وَٱلْأَحْزَابُ","translit":"ُbāَzْḥَaʾْlٱَw","root":"حزب"},{"id":6,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":7,"arabic":"بَعْدِهِمْ","translit":"ْmِhِdْʿعَb","root":"بعد"},{"id":8,"arabic":"وَهَمَّتْ","translit":"ْtَّmَhَw","root":"همم"},{"id":9,"arabic":"كُلُّ","translit":"ُّlُk","root":"كلل"},{"id":10,"arabic":"أُمَّةٍۭ","translit":"ٍۭẗَّmُaʾ","root":"امم"},{"id":11,"arabic":"بِرَسُولِهِمْ","translit":"ْmِhِlwُsَrِb","root":"رسل"},{"id":12,"arabic":"لِيَأْخُذُوهُ","translit":"ُhwُhdُhkْaʾَyِl","root":"اخذ"},{"id":13,"arabic":"وَجَٰدَلُوا۟","translit":"۟āwُlَdَٰjgَw","root":"جدل"},{"id":14,"arabic":"بِٱلْبَٰطِلِ","translit":"ِlِṭَٰbْlٱِb","root":"بطل"},{"id":15,"arabic":"لِيُدْحِضُوا۟","translit":"۟āwُḍِḥْdُyِl","root":"دحض"},{"id":16,"arabic":"بِهِ","translit":"ِhِb","root":""},{"id":17,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":18,"arabic":"فَأَخَذْتُهُمْ","translit":"ْmُhُtْhdَhkَaʾَf","root":"اخذ"},{"id":19,"arabic":"فَكَيْفَ","translit":"َfْyَkَf","root":"كيف"},{"id":20,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":21,"arabic":"عِقَابِ","translit":"ِbāَqِʿع","root":"عقب"}],"hasIhya":false},{"ayah":6,"text":"وَكَذَٰلِكَ حَقَّتْ كَلِمَتُ رَبِّكَ عَلَى ٱلَّذِينَ كَفَرُوٓا۟ أَنَّهُمْ أَصْحَٰبُ ٱلنَّارِ ","translation":"And thus has the word [i.e., decree] of your Lord come into effect upon those who disbelieved that they are companions of the Fire.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"حَقَّتْ","translit":"ْtَّqَḥ","root":"حقق"},{"id":3,"arabic":"كَلِمَتُ","translit":"ُtَmِlَk","root":"كلم"},{"id":4,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":5,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":6,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":7,"arabic":"كَفَرُوٓا۟","translit":"۟āٓwُrَfَk","root":"كفر"},{"id":8,"arabic":"أَنَّهُمْ","translit":"ْmُhَّnَaʾ","root":""},{"id":9,"arabic":"أَصْحَٰبُ","translit":"ُbَٰḥْṣَaʾ","root":"صحب"},{"id":10,"arabic":"ٱلنَّارِ","translit":"ِrāَّnlٱ","root":"نور"}],"hasIhya":false},{"ayah":7,"text":"ٱلَّذِينَ يَحْمِلُونَ ٱلْعَرْشَ وَمَنْ حَوْلَهُۥ يُسَبِّحُونَ بِحَمْدِ رَبِّهِمْ وَيُؤْمِنُونَ بِهِۦ وَيَسْتَغْفِرُونَ لِلَّذِينَ ءَامَنُوا۟ رَبَّنَا وَسِعْتَ كُلَّ شَىْءٍ رَّحْمَةً وَعِلْمًا فَٱغْفِرْ لِلَّذِينَ تَابُوا۟ وَٱتَّبَعُوا۟ سَبِيلَكَ وَقِهِمْ عَذَابَ ٱلْجَحِيمِ ","translation":"Those [angels] who carry the Throne and those around it exalt [Allāh] with praise of their Lord and believe in Him and ask forgiveness for those who have believed, [saying], \"Our Lord, You have encompassed all things in mercy and knowledge, so forgive those who have repented and followed Your way and protect them from the punishment of Hellfire.","words":[{"id":1,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":2,"arabic":"يَحْمِلُونَ","translit":"َnwُlِmْḥَy","root":"حمل"},{"id":3,"arabic":"ٱلْعَرْشَ","translit":"َhsْrَʿعْlٱ","root":"عرش"},{"id":4,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":5,"arabic":"حَوْلَهُۥ","translit":"ۥُhَlْwَḥ","root":"حول"},{"id":6,"arabic":"يُسَبِّحُونَ","translit":"َnwُḥِّbَsُy","root":"سبح"},{"id":7,"arabic":"بِحَمْدِ","translit":"ِdْmَḥِb","root":"حمد"},{"id":8,"arabic":"رَبِّهِمْ","translit":"ْmِhِّbَr","root":"ربب"},{"id":9,"arabic":"وَيُؤْمِنُونَ","translit":"َnwُnِmْwʾُyَw","root":"امن"},{"id":10,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":11,"arabic":"وَيَسْتَغْفِرُونَ","translit":"َnwُrِfْغَtْsَyَw","root":"غفر"},{"id":12,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":13,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":14,"arabic":"رَبَّنَا","translit":"āَnَّbَr","root":"ربب"},{"id":15,"arabic":"وَسِعْتَ","translit":"َtْʿعِsَw","root":"وسع"},{"id":16,"arabic":"كُلَّ","translit":"َّlُk","root":"كلل"},{"id":17,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":18,"arabic":"رَّحْمَةً","translit":"ًẗَmْḥَّr","root":"رحم"},{"id":19,"arabic":"وَعِلْمًا","translit":"āًmْlِʿعَw","root":"علم"},{"id":20,"arabic":"فَٱغْفِرْ","translit":"ْrِfْغٱَf","root":"غفر"},{"id":21,"arabic":"لِلَّذِينَ","translit":"َnyِhdَّlِl","root":""},{"id":22,"arabic":"تَابُوا۟","translit":"۟āwُbāَt","root":"توب"},{"id":23,"arabic":"وَٱتَّبَعُوا۟","translit":"۟āwُʿعَbَّtٱَw","root":"تبع"},{"id":24,"arabic":"سَبِيلَكَ","translit":"َkَlyِbَs","root":"سبل"},{"id":25,"arabic":"وَقِهِمْ","translit":"ْmِhِqَw","root":"وقي"},{"id":26,"arabic":"عَذَابَ","translit":"َbāَhdَʿع","root":"عذب"},{"id":27,"arabic":"ٱلْجَحِيمِ","translit":"ِmyِḥَjgْlٱ","root":"جحم"}],"hasIhya":false},{"ayah":8,"text":"رَبَّنَا وَأَدْخِلْهُمْ جَنَّٰتِ عَدْنٍ ٱلَّتِى وَعَدتَّهُمْ وَمَن صَلَحَ مِنْ ءَابَآئِهِمْ وَأَزْوَٰجِهِمْ وَذُرِّيَّٰتِهِمْۚ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْحَكِيمُ ","translation":"Our Lord, and admit them to gardens of perpetual residence which You have promised them and whoever was righteous among their forefathers, their spouses and their offspring. Indeed, it is You who is the Exalted in Might, the Wise.","words":[{"id":1,"arabic":"رَبَّنَا","translit":"āَnَّbَr","root":"ربب"},{"id":2,"arabic":"وَأَدْخِلْهُمْ","translit":"ْmُhْlِhkْdَaʾَw","root":"دخل"},{"id":3,"arabic":"جَنَّٰتِ","translit":"ِtَّٰnَjg","root":"جنن"},{"id":4,"arabic":"عَدْنٍ","translit":"ٍnْdَʿع","root":""},{"id":5,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":6,"arabic":"وَعَدتَّهُمْ","translit":"ْmُhَّtdَʿعَw","root":"وعد"},{"id":7,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":8,"arabic":"صَلَحَ","translit":"َḥَlَṣ","root":"صلح"},{"id":9,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":10,"arabic":"ءَابَآئِهِمْ","translit":"ْmِhِyʾٓāَbāَء","root":"ابو"},{"id":11,"arabic":"وَأَزْوَٰجِهِمْ","translit":"ْmِhِjgَٰwْzَaʾَw","root":"زوج"},{"id":12,"arabic":"وَذُرِّيَّٰتِهِمْ","translit":"ْmِhِtَّٰyِّrُhdَw","root":"ذرر"},{"id":13,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":14,"arabic":"أَنتَ","translit":"َtnَaʾ","root":""},{"id":15,"arabic":"ٱلْعَزِيزُ","translit":"ُzyِzَʿعْlٱ","root":"عزز"},{"id":16,"arabic":"ٱلْحَكِيمُ","translit":"ُmyِkَḥْlٱ","root":"حكم"}],"hasIhya":false},{"ayah":9,"text":"وَقِهِمُ ٱلسَّيِّـَٔاتِۚ وَمَن تَقِ ٱلسَّيِّـَٔاتِ يَوْمَئِذٍ فَقَدْ رَحِمْتَهُۥۚ وَذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ","translation":"And protect them from the evil consequences [of their deeds]. And he whom You protect from evil consequences that Day - You will have given him mercy. And that is the great attainment.\"","words":[{"id":1,"arabic":"وَقِهِمُ","translit":"ُmِhِqَw","root":"وقي"},{"id":2,"arabic":"ٱلسَّيِّـَٔاتِ","translit":"ِtāَٔـِّyَّslٱ","root":"سوا"},{"id":3,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":4,"arabic":"تَقِ","translit":"ِqَt","root":"وقي"},{"id":5,"arabic":"ٱلسَّيِّـَٔاتِ","translit":"ِtāَٔـِّyَّslٱ","root":"سوا"},{"id":6,"arabic":"يَوْمَئِذٍ","translit":"ٍhdِyʾَmْwَy","root":"يوم"},{"id":7,"arabic":"فَقَدْ","translit":"ْdَqَf","root":""},{"id":8,"arabic":"رَحِمْتَهُۥ","translit":"ۥُhَtْmِḥَr","root":"رحم"},{"id":9,"arabic":"وَذَٰلِكَ","translit":"َkِlَٰhdَw","root":""},{"id":10,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":11,"arabic":"ٱلْفَوْزُ","translit":"ُzْwَfْlٱ","root":"فوز"},{"id":12,"arabic":"ٱلْعَظِيمُ","translit":"ُmyِẓَʿعْlٱ","root":"عظم"}],"hasIhya":false},{"ayah":10,"text":"إِنَّ ٱلَّذِينَ كَفَرُوا۟ يُنَادَوْنَ لَمَقْتُ ٱللَّهِ أَكْبَرُ مِن مَّقْتِكُمْ أَنفُسَكُمْ إِذْ تُدْعَوْنَ إِلَى ٱلْإِيمَٰنِ فَتَكْفُرُونَ ","translation":"Indeed, those who disbelieve will be addressed, \"The hatred of Allāh for you was [even] greater than your hatred of yourselves [this Day in Hell] when you were invited to faith, but you disbelieved [i.e., refused].\"","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":4,"arabic":"يُنَادَوْنَ","translit":"َnْwَdāَnُy","root":"ندي"},{"id":5,"arabic":"لَمَقْتُ","translit":"ُtْqَmَl","root":"مقت"},{"id":6,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":7,"arabic":"أَكْبَرُ","translit":"ُrَbْkَaʾ","root":"كبر"},{"id":8,"arabic":"مِن","translit":"nِm","root":""},{"id":9,"arabic":"مَّقْتِكُمْ","translit":"ْmُkِtْqَّm","root":"مقت"},{"id":10,"arabic":"أَنفُسَكُمْ","translit":"ْmُkَsُfnَaʾ","root":"نفس"},{"id":11,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":12,"arabic":"تُدْعَوْنَ","translit":"َnْwَʿعْdُt","root":"دعو"},{"id":13,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":14,"arabic":"ٱلْإِيمَٰنِ","translit":"ِnَٰmyِiʾْlٱ","root":"امن"},{"id":15,"arabic":"فَتَكْفُرُونَ","translit":"َnwُrُfْkَtَf","root":"كفر"}],"hasIhya":false},{"ayah":11,"text":"قَالُوا۟ رَبَّنَآ أَمَتَّنَا ٱثْنَتَيْنِ وَأَحْيَيْتَنَا ٱثْنَتَيْنِ فَٱعْتَرَفْنَا بِذُنُوبِنَا فَهَلْ إِلَىٰ خُرُوجٍ مِّن سَبِيلٍ ","translation":"They will say, \"Our Lord, You made us lifeless twice and gave us life twice, and we have confessed our sins. So is there to an exit any way?\"","words":[{"id":1,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":2,"arabic":"رَبَّنَآ","translit":"ٓāَnَّbَr","root":"ربب"},{"id":3,"arabic":"أَمَتَّنَا","translit":"āَnَّtَmَaʾ","root":"موت"},{"id":4,"arabic":"ٱثْنَتَيْنِ","translit":"ِnْyَtَnْhtٱ","root":"ثني"},{"id":5,"arabic":"وَأَحْيَيْتَنَا","translit":"āَnَtْyَyْḥَaʾَw","root":"حيي"},{"id":6,"arabic":"ٱثْنَتَيْنِ","translit":"ِnْyَtَnْhtٱ","root":"ثني"},{"id":7,"arabic":"فَٱعْتَرَفْنَا","translit":"āَnْfَrَtْʿعٱَf","root":"عرف"},{"id":8,"arabic":"بِذُنُوبِنَا","translit":"āَnِbwُnُhdِb","root":"ذنب"},{"id":9,"arabic":"فَهَلْ","translit":"ْlَhَf","root":""},{"id":10,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":11,"arabic":"خُرُوجٍ","translit":"ٍjgwُrُhk","root":"خرج"},{"id":12,"arabic":"مِّن","translit":"nِّm","root":""},{"id":13,"arabic":"سَبِيلٍ","translit":"ٍlyِbَs","root":"سبل"}],"hasIhya":true},{"ayah":12,"text":"ذَٰلِكُم بِأَنَّهُۥٓ إِذَا دُعِىَ ٱللَّهُ وَحْدَهُۥ كَفَرْتُمْۖ وَإِن يُشْرَكْ بِهِۦ تُؤْمِنُوا۟ۚ فَٱلْحُكْمُ لِلَّهِ ٱلْعَلِىِّ ٱلْكَبِيرِ ","translation":"[They will be told], \"That is because, when Allāh was called upon alone, you disbelieved; but if others were associated with Him, you believed. So the judgement is with Allāh, the Most High, the Grand.\"","words":[{"id":1,"arabic":"ذَٰلِكُم","translit":"mُkِlَٰhd","root":""},{"id":2,"arabic":"بِأَنَّهُۥٓ","translit":"ٓۥُhَّnَaʾِb","root":""},{"id":3,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":4,"arabic":"دُعِىَ","translit":"َàِʿعُd","root":"دعو"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"وَحْدَهُۥ","translit":"ۥُhَdْḥَw","root":"وحد"},{"id":7,"arabic":"كَفَرْتُمْ","translit":"ْmُtْrَfَk","root":"كفر"},{"id":8,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":9,"arabic":"يُشْرَكْ","translit":"ْkَrْhsُy","root":"شرك"},{"id":10,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":11,"arabic":"تُؤْمِنُوا۟","translit":"۟āwُnِmْwʾُt","root":"امن"},{"id":12,"arabic":"فَٱلْحُكْمُ","translit":"ُmْkُḥْlٱَf","root":"حكم"},{"id":13,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":14,"arabic":"ٱلْعَلِىِّ","translit":"ِّàِlَʿعْlٱ","root":"علو"},{"id":15,"arabic":"ٱلْكَبِيرِ","translit":"ِryِbَkْlٱ","root":"كبر"}],"hasIhya":true},{"ayah":13,"text":"هُوَ ٱلَّذِى يُرِيكُمْ ءَايَٰتِهِۦ وَيُنَزِّلُ لَكُم مِّنَ ٱلسَّمَآءِ رِزْقًاۚ وَمَا يَتَذَكَّرُ إِلَّا مَن يُنِيبُ ","translation":"It is He who shows you His signs and sends down to you from the sky, provision. But none will remember except he who turns back [in repentance].","words":[{"id":1,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"يُرِيكُمْ","translit":"ْmُkyِrُy","root":"راي"},{"id":4,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":5,"arabic":"وَيُنَزِّلُ","translit":"ُlِّzَnُyَw","root":"نزل"},{"id":6,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":7,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":8,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":9,"arabic":"رِزْقًا","translit":"āًqْzِr","root":"رزق"},{"id":10,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":11,"arabic":"يَتَذَكَّرُ","translit":"ُrَّkَhdَtَy","root":"ذكر"},{"id":12,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":13,"arabic":"مَن","translit":"nَm","root":""},{"id":14,"arabic":"يُنِيبُ","translit":"ُbyِnُy","root":"نوب"}],"hasIhya":true},{"ayah":14,"text":"فَٱدْعُوا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ وَلَوْ كَرِهَ ٱلْكَٰفِرُونَ ","translation":"So invoke Allāh, [being] sincere to Him in religion, although the disbelievers dislike it.","words":[{"id":1,"arabic":"فَٱدْعُوا۟","translit":"۟āwُʿعْdٱَf","root":"دعو"},{"id":2,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":3,"arabic":"مُخْلِصِينَ","translit":"َnyِṣِlْhkُm","root":"خلص"},{"id":4,"arabic":"لَهُ","translit":"ُhَl","root":""},{"id":5,"arabic":"ٱلدِّينَ","translit":"َnyِّdlٱ","root":"دين"},{"id":6,"arabic":"وَلَوْ","translit":"ْwَlَw","root":""},{"id":7,"arabic":"كَرِهَ","translit":"َhِrَk","root":"كره"},{"id":8,"arabic":"ٱلْكَٰفِرُونَ","translit":"َnwُrِfَٰkْlٱ","root":"كفر"}],"hasIhya":true},{"ayah":15,"text":"رَفِيعُ ٱلدَّرَجَٰتِ ذُو ٱلْعَرْشِ يُلْقِى ٱلرُّوحَ مِنْ أَمْرِهِۦ عَلَىٰ مَن يَشَآءُ مِنْ عِبَادِهِۦ لِيُنذِرَ يَوْمَ ٱلتَّلَاقِ ","translation":"[He is] the Exalted above [all] degrees, Owner of the Throne; He places the inspiration of His command [i.e., revelation] upon whom He wills of His servants to warn of the Day of Meeting.","words":[{"id":1,"arabic":"رَفِيعُ","translit":"ُʿعyِfَr","root":"رفع"},{"id":2,"arabic":"ٱلدَّرَجَٰتِ","translit":"ِtَٰjgَrَّdlٱ","root":"درج"},{"id":3,"arabic":"ذُو","translit":"wُhd","root":""},{"id":4,"arabic":"ٱلْعَرْشِ","translit":"ِhsْrَʿعْlٱ","root":"عرش"},{"id":5,"arabic":"يُلْقِى","translit":"àِqْlُy","root":"لقي"},{"id":6,"arabic":"ٱلرُّوحَ","translit":"َḥwُّrlٱ","root":"روح"},{"id":7,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":8,"arabic":"أَمْرِهِۦ","translit":"ۦِhِrْmَaʾ","root":"امر"},{"id":9,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":10,"arabic":"مَن","translit":"nَm","root":""},{"id":11,"arabic":"يَشَآءُ","translit":"ُءٓāَhsَy","root":"شيا"},{"id":12,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":13,"arabic":"عِبَادِهِۦ","translit":"ۦِhِdāَbِʿع","root":"عبد"},{"id":14,"arabic":"لِيُنذِرَ","translit":"َrِhdnُyِl","root":"نذر"},{"id":15,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":16,"arabic":"ٱلتَّلَاقِ","translit":"ِqāَlَّtlٱ","root":"لقي"}],"hasIhya":true},{"ayah":16,"text":"يَوْمَ هُم بَٰرِزُونَۖ لَا يَخْفَىٰ عَلَى ٱللَّهِ مِنْهُمْ شَىْءٌۚ لِّمَنِ ٱلْمُلْكُ ٱلْيَوْمَۖ لِلَّهِ ٱلْوَٰحِدِ ٱلْقَهَّارِ ","translation":"The Day they come forth nothing concerning them will be concealed from Allāh. To whom belongs [all] sovereignty this Day? To Allāh, the One, the Prevailing.[1]","words":[{"id":1,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":2,"arabic":"هُم","translit":"mُh","root":""},{"id":3,"arabic":"بَٰرِزُونَ","translit":"َnwُzِrَٰb","root":"برز"},{"id":4,"arabic":"لَا","translit":"āَl","root":""},{"id":5,"arabic":"يَخْفَىٰ","translit":"ٰàَfْhkَy","root":"خفي"},{"id":6,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":9,"arabic":"شَىْءٌ","translit":"ٌءْàَhs","root":"شيا"},{"id":10,"arabic":"لِّمَنِ","translit":"ِnَmِّl","root":""},{"id":11,"arabic":"ٱلْمُلْكُ","translit":"ُkْlُmْlٱ","root":"ملك"},{"id":12,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":13,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":14,"arabic":"ٱلْوَٰحِدِ","translit":"ِdِḥَٰwْlٱ","root":"وحد"},{"id":15,"arabic":"ٱلْقَهَّارِ","translit":"ِrāَّhَqْlٱ","root":"قهر"}],"hasIhya":true},{"ayah":17,"text":"ٱلْيَوْمَ تُجْزَىٰ كُلُّ نَفْسٍۭ بِمَا كَسَبَتْۚ لَا ظُلْمَ ٱلْيَوْمَۚ إِنَّ ٱللَّهَ سَرِيعُ ٱلْحِسَابِ ","translation":"This Day every soul will be recompensed for what it earned. No injustice today! Indeed, Allāh is swift in account.","words":[{"id":1,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":2,"arabic":"تُجْزَىٰ","translit":"ٰàَzْjgُt","root":"جزي"},{"id":3,"arabic":"كُلُّ","translit":"ُّlُk","root":"كلل"},{"id":4,"arabic":"نَفْسٍۭ","translit":"ٍۭsْfَn","root":"نفس"},{"id":5,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":6,"arabic":"كَسَبَتْ","translit":"ْtَbَsَk","root":"كسب"},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"ظُلْمَ","translit":"َmْlُẓ","root":"ظلم"},{"id":9,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":10,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":11,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":12,"arabic":"سَرِيعُ","translit":"ُʿعyِrَs","root":"سرع"},{"id":13,"arabic":"ٱلْحِسَابِ","translit":"ِbāَsِḥْlٱ","root":"حسب"}],"hasIhya":true},{"ayah":18,"text":"وَأَنذِرْهُمْ يَوْمَ ٱلْءَازِفَةِ إِذِ ٱلْقُلُوبُ لَدَى ٱلْحَنَاجِرِ كَٰظِمِينَۚ مَا لِلظَّٰلِمِينَ مِنْ حَمِيمٍ وَلَا شَفِيعٍ يُطَاعُ ","translation":"And warn them, [O Muḥammad], of the Approaching Day, when hearts are at the throats, filled [with distress]. For the wrongdoers there will be no devoted friend and no intercessor [who is] obeyed.","words":[{"id":1,"arabic":"وَأَنذِرْهُمْ","translit":"ْmُhْrِhdnَaʾَw","root":"نذر"},{"id":2,"arabic":"يَوْمَ","translit":"َmْwَy","root":"يوم"},{"id":3,"arabic":"ٱلْءَازِفَةِ","translit":"ِẗَfِzāَءْlٱ","root":"ازف"},{"id":4,"arabic":"إِذِ","translit":"ِhdِiʾ","root":""},{"id":5,"arabic":"ٱلْقُلُوبُ","translit":"ُbwُlُqْlٱ","root":"قلب"},{"id":6,"arabic":"لَدَى","translit":"àَdَl","root":""},{"id":7,"arabic":"ٱلْحَنَاجِرِ","translit":"ِrِjgāَnَḥْlٱ","root":"حنجر"},{"id":8,"arabic":"كَٰظِمِينَ","translit":"َnyِmِẓَٰk","root":"كظم"},{"id":9,"arabic":"مَا","translit":"āَm","root":""},{"id":10,"arabic":"لِلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlِl","root":"ظلم"},{"id":11,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":12,"arabic":"حَمِيمٍ","translit":"ٍmyِmَḥ","root":"حمم"},{"id":13,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":14,"arabic":"شَفِيعٍ","translit":"ٍʿعyِfَhs","root":"شفع"},{"id":15,"arabic":"يُطَاعُ","translit":"ُʿعāَṭُy","root":"طوع"}],"hasIhya":true},{"ayah":19,"text":"يَعْلَمُ خَآئِنَةَ ٱلْأَعْيُنِ وَمَا تُخْفِى ٱلصُّدُورُ ","translation":"He knows that which deceives the eyes and what the breasts conceal.","words":[{"id":1,"arabic":"يَعْلَمُ","translit":"ُmَlْʿعَy","root":"علم"},{"id":2,"arabic":"خَآئِنَةَ","translit":"َẗَnِyʾٓāَhk","root":"خون"},{"id":3,"arabic":"ٱلْأَعْيُنِ","translit":"ِnُyْʿعَaʾْlٱ","root":"عين"},{"id":4,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":5,"arabic":"تُخْفِى","translit":"àِfْhkُt","root":"خفي"},{"id":6,"arabic":"ٱلصُّدُورُ","translit":"ُrwُdُّṣlٱ","root":"صدر"}],"hasIhya":false},{"ayah":20,"text":"وَٱللَّهُ يَقْضِى بِٱلْحَقِّۖ وَٱلَّذِينَ يَدْعُونَ مِن دُونِهِۦ لَا يَقْضُونَ بِشَىْءٍۗ إِنَّ ٱللَّهَ هُوَ ٱلسَّمِيعُ ٱلْبَصِيرُ ","translation":"And Allāh judges with truth, while those they invoke[1] besides Him judge not with anything. Indeed, Allāh - He is the Hearing, the Seeing.","words":[{"id":1,"arabic":"وَٱللَّهُ","translit":"ُhَّllٱَw","root":"اله"},{"id":2,"arabic":"يَقْضِى","translit":"àِḍْqَy","root":"قضي"},{"id":3,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":4,"arabic":"وَٱلَّذِينَ","translit":"َnyِhdَّlٱَw","root":""},{"id":5,"arabic":"يَدْعُونَ","translit":"َnwُʿعْdَy","root":"دعو"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"دُونِهِۦ","translit":"ۦِhِnwُd","root":"دون"},{"id":8,"arabic":"لَا","translit":"āَl","root":""},{"id":9,"arabic":"يَقْضُونَ","translit":"َnwُḍْqَy","root":"قضي"},{"id":10,"arabic":"بِشَىْءٍ","translit":"ٍءْàَhsِb","root":"شيا"},{"id":11,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":12,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":13,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":14,"arabic":"ٱلسَّمِيعُ","translit":"ُʿعyِmَّslٱ","root":"سمع"},{"id":15,"arabic":"ٱلْبَصِيرُ","translit":"ُryِṣَbْlٱ","root":"بصر"}],"hasIhya":false},{"ayah":21,"text":"أَوَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ كَانُوا۟ مِن قَبْلِهِمْۚ كَانُوا۟ هُمْ أَشَدَّ مِنْهُمْ قُوَّةً وَءَاثَارًا فِى ٱلْأَرْضِ فَأَخَذَهُمُ ٱللَّهُ بِذُنُوبِهِمْ وَمَا كَانَ لَهُم مِّنَ ٱللَّهِ مِن وَاقٍ ","translation":"Have they not traveled through the land and observed how was the end of those who were before them? They were greater than them in strength and in impression on the land, but Allāh seized them for their sins. And they had not from Allāh any protector.","words":[{"id":1,"arabic":"أَوَلَمْ","translit":"ْmَlَwَaʾ","root":""},{"id":2,"arabic":"يَسِيرُوا۟","translit":"۟āwُryِsَy","root":"سير"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"فَيَنظُرُوا۟","translit":"۟āwُrُẓnَyَf","root":"نظر"},{"id":6,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":7,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":8,"arabic":"عَٰقِبَةُ","translit":"ُẗَbِqَٰʿع","root":"عقب"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":11,"arabic":"مِن","translit":"nِm","root":""},{"id":12,"arabic":"قَبْلِهِمْ","translit":"ْmِhِlْbَq","root":"قبل"},{"id":13,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":14,"arabic":"هُمْ","translit":"ْmُh","root":""},{"id":15,"arabic":"أَشَدَّ","translit":"َّdَhsَaʾ","root":"شدد"},{"id":16,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":17,"arabic":"قُوَّةً","translit":"ًẗَّwُq","root":"قوي"},{"id":18,"arabic":"وَءَاثَارًا","translit":"āًrāَhtāَءَw","root":"اثر"},{"id":19,"arabic":"فِى","translit":"àِf","root":""},{"id":20,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":21,"arabic":"فَأَخَذَهُمُ","translit":"ُmُhَhdَhkَaʾَf","root":"اخذ"},{"id":22,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":23,"arabic":"بِذُنُوبِهِمْ","translit":"ْmِhِbwُnُhdِb","root":"ذنب"},{"id":24,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":25,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":26,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":27,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":28,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":29,"arabic":"مِن","translit":"nِm","root":""},{"id":30,"arabic":"وَاقٍ","translit":"ٍqāَw","root":"وقي"}],"hasIhya":false},{"ayah":22,"text":"ذَٰلِكَ بِأَنَّهُمْ كَانَت تَّأْتِيهِمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ فَكَفَرُوا۟ فَأَخَذَهُمُ ٱللَّهُۚ إِنَّهُۥ قَوِىٌّ شَدِيدُ ٱلْعِقَابِ ","translation":"That was because their messengers were coming to them with clear proofs, but they disbelieved, so Allāh seized them. Indeed, He is Powerful and severe in punishment.","words":[{"id":1,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":2,"arabic":"بِأَنَّهُمْ","translit":"ْmُhَّnَaʾِb","root":""},{"id":3,"arabic":"كَانَت","translit":"tَnāَk","root":"كون"},{"id":4,"arabic":"تَّأْتِيهِمْ","translit":"ْmِhyِtْaʾَّt","root":"اتي"},{"id":5,"arabic":"رُسُلُهُم","translit":"mُhُlُsُr","root":"رسل"},{"id":6,"arabic":"بِٱلْبَيِّنَٰتِ","translit":"ِtَٰnِّyَbْlٱِb","root":"بين"},{"id":7,"arabic":"فَكَفَرُوا۟","translit":"۟āwُrَfَkَf","root":"كفر"},{"id":8,"arabic":"فَأَخَذَهُمُ","translit":"ُmُhَhdَhkَaʾَf","root":"اخذ"},{"id":9,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":10,"arabic":"إِنَّهُۥ","translit":"ۥُhَّnِiʾ","root":""},{"id":11,"arabic":"قَوِىٌّ","translit":"ٌّàِwَq","root":"قوي"},{"id":12,"arabic":"شَدِيدُ","translit":"ُdyِdَhs","root":"شدد"},{"id":13,"arabic":"ٱلْعِقَابِ","translit":"ِbāَqِʿعْlٱ","root":"عقب"}],"hasIhya":false},{"ayah":23,"text":"وَلَقَدْ أَرْسَلْنَا مُوسَىٰ بِـَٔايَٰتِنَا وَسُلْطَٰنٍ مُّبِينٍ ","translation":"And We did certainly send Moses with Our signs and a clear authority[1]","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":4,"arabic":"بِـَٔايَٰتِنَا","translit":"āَnِtَٰyāَٔـِb","root":"ايي"},{"id":5,"arabic":"وَسُلْطَٰنٍ","translit":"ٍnَٰṭْlُsَw","root":"سلط"},{"id":6,"arabic":"مُّبِينٍ","translit":"ٍnyِbُّm","root":"بين"}],"hasIhya":false},{"ayah":24,"text":"إِلَىٰ فِرْعَوْنَ وَهَٰمَٰنَ وَقَٰرُونَ فَقَالُوا۟ سَٰحِرٌ كَذَّابٌ ","translation":"To Pharaoh, Hāmān and Qārūn, but they said, \"[He is] a magician and a liar.\"","words":[{"id":1,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":2,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":3,"arabic":"وَهَٰمَٰنَ","translit":"َnَٰmَٰhَw","root":""},{"id":4,"arabic":"وَقَٰرُونَ","translit":"َnwُrَٰqَw","root":""},{"id":5,"arabic":"فَقَالُوا۟","translit":"۟āwُlāَqَf","root":"قول"},{"id":6,"arabic":"سَٰحِرٌ","translit":"ٌrِḥَٰs","root":"سحر"},{"id":7,"arabic":"كَذَّابٌ","translit":"ٌbāَّhdَk","root":"كذب"}],"hasIhya":true},{"ayah":25,"text":"فَلَمَّا جَآءَهُم بِٱلْحَقِّ مِنْ عِندِنَا قَالُوا۟ ٱقْتُلُوٓا۟ أَبْنَآءَ ٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ وَٱسْتَحْيُوا۟ نِسَآءَهُمْۚ وَمَا كَيْدُ ٱلْكَٰفِرِينَ إِلَّا فِى ضَلَٰلٍ ","translation":"And when he brought them the truth from Us, they said, \"Kill the sons of those who have believed with him and keep their women alive.\" But the plan of the disbelievers is not except in error.","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"جَآءَهُم","translit":"mُhَءٓāَjg","root":"جيا"},{"id":3,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":4,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":5,"arabic":"عِندِنَا","translit":"āَnِdnِʿع","root":"عند"},{"id":6,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":7,"arabic":"ٱقْتُلُوٓا۟","translit":"۟āٓwُlُtْqٱ","root":"قتل"},{"id":8,"arabic":"أَبْنَآءَ","translit":"َءٓāَnْbَaʾ","root":"بني"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":11,"arabic":"مَعَهُۥ","translit":"ۥُhَʿعَm","root":""},{"id":12,"arabic":"وَٱسْتَحْيُوا۟","translit":"۟āwُyْḥَtْsٱَw","root":"حيي"},{"id":13,"arabic":"نِسَآءَهُمْ","translit":"ْmُhَءٓāَsِn","root":"نسو"},{"id":14,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":15,"arabic":"كَيْدُ","translit":"ُdْyَk","root":"كيد"},{"id":16,"arabic":"ٱلْكَٰفِرِينَ","translit":"َnyِrِfَٰkْlٱ","root":"كفر"},{"id":17,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ضَلَٰلٍ","translit":"ٍlَٰlَḍ","root":"ضلل"}],"hasIhya":false},{"ayah":26,"text":"وَقَالَ فِرْعَوْنُ ذَرُونِىٓ أَقْتُلْ مُوسَىٰ وَلْيَدْعُ رَبَّهُۥٓۖ إِنِّىٓ أَخَافُ أَن يُبَدِّلَ دِينَكُمْ أَوْ أَن يُظْهِرَ فِى ٱلْأَرْضِ ٱلْفَسَادَ ","translation":"And Pharaoh said, \"Let me kill Moses and let him call upon his Lord. Indeed, I fear that he will change your religion or that he will cause corruption[1] in the land.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"فِرْعَوْنُ","translit":"ُnْwَʿعْrِf","root":""},{"id":3,"arabic":"ذَرُونِىٓ","translit":"ٓàِnwُrَhd","root":"وذر"},{"id":4,"arabic":"أَقْتُلْ","translit":"ْlُtْqَaʾ","root":"قتل"},{"id":5,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":6,"arabic":"وَلْيَدْعُ","translit":"ُʿعْdَyْlَw","root":"دعو"},{"id":7,"arabic":"رَبَّهُۥٓ","translit":"ٓۥُhَّbَr","root":"ربب"},{"id":8,"arabic":"إِنِّىٓ","translit":"ٓàِّnِiʾ","root":""},{"id":9,"arabic":"أَخَافُ","translit":"ُfāَhkَaʾ","root":"خوف"},{"id":10,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":11,"arabic":"يُبَدِّلَ","translit":"َlِّdَbُy","root":"بدل"},{"id":12,"arabic":"دِينَكُمْ","translit":"ْmُkَnyِd","root":"دين"},{"id":13,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":14,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":15,"arabic":"يُظْهِرَ","translit":"َrِhْẓُy","root":"ظهر"},{"id":16,"arabic":"فِى","translit":"àِf","root":""},{"id":17,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":18,"arabic":"ٱلْفَسَادَ","translit":"َdāَsَfْlٱ","root":"فسد"}],"hasIhya":false},{"ayah":27,"text":"وَقَالَ مُوسَىٰٓ إِنِّى عُذْتُ بِرَبِّى وَرَبِّكُم مِّن كُلِّ مُتَكَبِّرٍ لَّا يُؤْمِنُ بِيَوْمِ ٱلْحِسَابِ ","translation":"But Moses said, \"Indeed, I have sought refuge in my Lord and your Lord from every arrogant one who does not believe in the Day of Account.\"","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"مُوسَىٰٓ","translit":"ٰٓàَswُm","root":""},{"id":3,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":4,"arabic":"عُذْتُ","translit":"ُtْhdُʿع","root":"عوذ"},{"id":5,"arabic":"بِرَبِّى","translit":"àِّbَrِb","root":"ربب"},{"id":6,"arabic":"وَرَبِّكُم","translit":"mُkِّbَrَw","root":"ربب"},{"id":7,"arabic":"مِّن","translit":"nِّm","root":""},{"id":8,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":9,"arabic":"مُتَكَبِّرٍ","translit":"ٍrِّbَkَtُm","root":"كبر"},{"id":10,"arabic":"لَّا","translit":"āَّl","root":""},{"id":11,"arabic":"يُؤْمِنُ","translit":"ُnِmْwʾُy","root":"امن"},{"id":12,"arabic":"بِيَوْمِ","translit":"ِmْwَyِb","root":"يوم"},{"id":13,"arabic":"ٱلْحِسَابِ","translit":"ِbāَsِḥْlٱ","root":"حسب"}],"hasIhya":false},{"ayah":28,"text":"وَقَالَ رَجُلٌ مُّؤْمِنٌ مِّنْ ءَالِ فِرْعَوْنَ يَكْتُمُ إِيمَٰنَهُۥٓ أَتَقْتُلُونَ رَجُلًا أَن يَقُولَ رَبِّىَ ٱللَّهُ وَقَدْ جَآءَكُم بِٱلْبَيِّنَٰتِ مِن رَّبِّكُمْۖ وَإِن يَكُ كَٰذِبًا فَعَلَيْهِ كَذِبُهُۥۖ وَإِن يَكُ صَادِقًا يُصِبْكُم بَعْضُ ٱلَّذِى يَعِدُكُمْۖ إِنَّ ٱللَّهَ لَا يَهْدِى مَنْ هُوَ مُسْرِفٌ كَذَّابٌ ","translation":"And a believing man from the family of Pharaoh who concealed his faith said, \"Do you kill a man [merely] because he says, 'My Lord is Allāh' while he has brought you clear proofs from your Lord? And if he should be lying, then upon him is [the consequence of] his lie; but if he should be truthful, there will strike you some of what he promises you. Indeed, Allāh does not guide one who is a transgressor and a liar.","words":[{"id":1,"arabic":"وَقَالَ","translit":"َlāَqَw","root":"قول"},{"id":2,"arabic":"رَجُلٌ","translit":"ٌlُjgَr","root":"رجل"},{"id":3,"arabic":"مُّؤْمِنٌ","translit":"ٌnِmْwʾُّm","root":"امن"},{"id":4,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":5,"arabic":"ءَالِ","translit":"ِlāَء","root":"اول"},{"id":6,"arabic":"فِرْعَوْنَ","translit":"َnْwَʿعْrِf","root":""},{"id":7,"arabic":"يَكْتُمُ","translit":"ُmُtْkَy","root":"كتم"},{"id":8,"arabic":"إِيمَٰنَهُۥٓ","translit":"ٓۥُhَnَٰmyِiʾ","root":"امن"},{"id":9,"arabic":"أَتَقْتُلُونَ","translit":"َnwُlُtْqَtَaʾ","root":"قتل"},{"id":10,"arabic":"رَجُلًا","translit":"āًlُjgَr","root":"رجل"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يَقُولَ","translit":"َlwُqَy","root":"قول"},{"id":13,"arabic":"رَبِّىَ","translit":"َàِّbَr","root":"ربب"},{"id":14,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":15,"arabic":"وَقَدْ","translit":"ْdَqَw","root":""},{"id":16,"arabic":"جَآءَكُم","translit":"mُkَءٓāَjg","root":"جيا"},{"id":17,"arabic":"بِٱلْبَيِّنَٰتِ","translit":"ِtَٰnِّyَbْlٱِb","root":"بين"},{"id":18,"arabic":"مِن","translit":"nِm","root":""},{"id":19,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":20,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":21,"arabic":"يَكُ","translit":"ُkَy","root":"كون"},{"id":22,"arabic":"كَٰذِبًا","translit":"āًbِhdَٰk","root":"كذب"},{"id":23,"arabic":"فَعَلَيْهِ","translit":"ِhْyَlَʿعَf","root":""},{"id":24,"arabic":"كَذِبُهُۥ","translit":"ۥُhُbِhdَk","root":"كذب"},{"id":25,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":26,"arabic":"يَكُ","translit":"ُkَy","root":"كون"},{"id":27,"arabic":"صَادِقًا","translit":"āًqِdāَṣ","root":"صدق"},{"id":28,"arabic":"يُصِبْكُم","translit":"mُkْbِṣُy","root":"صوب"},{"id":29,"arabic":"بَعْضُ","translit":"ُḍْʿعَb","root":"بعض"},{"id":30,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":31,"arabic":"يَعِدُكُمْ","translit":"ْmُkُdِʿعَy","root":"وعد"},{"id":32,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":33,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":34,"arabic":"لَا","translit":"āَl","root":""},{"id":35,"arabic":"يَهْدِى","translit":"àِdْhَy","root":"هدي"},{"id":36,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":37,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":38,"arabic":"مُسْرِفٌ","translit":"ٌfِrْsُm","root":"سرف"},{"id":39,"arabic":"كَذَّابٌ","translit":"ٌbāَّhdَk","root":"كذب"}],"hasIhya":true},{"ayah":29,"text":"يَٰقَوْمِ لَكُمُ ٱلْمُلْكُ ٱلْيَوْمَ ظَٰهِرِينَ فِى ٱلْأَرْضِ فَمَن يَنصُرُنَا مِنۢ بَأْسِ ٱللَّهِ إِن جَآءَنَاۚ قَالَ فِرْعَوْنُ مَآ أُرِيكُمْ إِلَّا مَآ أَرَىٰ وَمَآ أَهْدِيكُمْ إِلَّا سَبِيلَ ٱلرَّشَادِ ","translation":"O my people, sovereignty is yours today, [your being] dominant in the land. But who would protect us from the punishment of Allāh if it came to us?\" Pharaoh said, \"I do not show you except what I see, and I do not guide you except to the way of right conduct.\"","words":[{"id":1,"arabic":"يَٰقَوْمِ","translit":"ِmْwَqَٰy","root":"قوم"},{"id":2,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":3,"arabic":"ٱلْمُلْكُ","translit":"ُkْlُmْlٱ","root":"ملك"},{"id":4,"arabic":"ٱلْيَوْمَ","translit":"َmْwَyْlٱ","root":"يوم"},{"id":5,"arabic":"ظَٰهِرِينَ","translit":"َnyِrِhَٰẓ","root":"ظهر"},{"id":6,"arabic":"فِى","translit":"àِf","root":""},{"id":7,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":8,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":9,"arabic":"يَنصُرُنَا","translit":"āَnُrُṣnَy","root":"نصر"},{"id":10,"arabic":"مِنۢ","translit":"ۢnِm","root":""},{"id":11,"arabic":"بَأْسِ","translit":"ِsْaʾَb","root":"باس"},{"id":12,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":13,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":14,"arabic":"جَآءَنَا","translit":"āَnَءٓāَjg","root":"جيا"},{"id":15,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":16,"arabic":"فِرْعَوْنُ","translit":"ُnْwَʿعْrِf","root":""},{"id":17,"arabic":"مَآ","tra