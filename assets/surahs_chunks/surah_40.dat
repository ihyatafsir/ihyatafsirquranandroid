warsh"}, {"surah": 40, "ayah": 42, "text": "تَدْعُونَنِے لِأَكْفُرَ بِاللَّهِ وَأُشْرِكَ بِهِۦ مَا لَيْسَ لِے بِهِۦ عِلْمࣱ وَأَنَآ أَدْعُوكُمُۥٓ إِلَي اَ۬لْعَزِيزِ اِ۬لْغَفّٰ۪رِۖ", "words": [{"id": 1, "arabic": "تَدْعُونَنِے", "translit": "", "root": ""}, {"id": 2, "arabic": "لِأَكْفُرَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَأُشْرِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَيْسَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِے", "translit": "", "root": ""}, {"id": 9, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 10, "arabic": "عِلْمࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَأَنَآ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَدْعُوكُمُۥٓ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لْعَزِيزِ", "translit": "", "root": ""}, {"id": 15, "arabic": "اِ۬لْغَفّٰ۪رِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 43, "text": "لَا جَرَمَ أَنَّمَا تَدْعُونَنِےٓ إِلَيْهِ لَيْسَ لَهُۥ دَعْوَةࣱ فِے اِ۬لدُّنْي۪ا وَلَا فِے اِ۬لَاخِرَةِ وَأَنَّ مَرَدَّنَآ إِلَي اَ۬للَّهِ وَأَنَّ اَ۬لْمُسْرِفِينَ هُمُۥٓ أَصْحَٰبُ اُ۬لنّ۪ارِۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَرَمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَنَّمَا", "translit": "", "root": ""}, {"id": 4, "arabic": "تَدْعُونَنِےٓ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيْهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَيْسَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "دَعْوَةࣱ", "translit": "", "root": ""}, {"id": 9, "arabic": "فِے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""},