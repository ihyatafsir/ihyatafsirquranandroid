xt": "۞قَالُواْ رَبَّنَآ أَمَتَّنَا اَ۪ثْنَتَيْنِ وَأَحْيَيْتَنَا اَ۪ثْنَتَيْنِ فَاعْتَرَفْنَا بِذُنُوبِنَا فَهَلِ اِلَيٰ خُرُوجࣲ مِّن سَبِيلࣲۖ", "words": [{"id": 1, "arabic": "۞قَالُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "رَبَّنَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَمَتَّنَا", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۪ثْنَتَيْنِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَأَحْيَيْتَنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۪ثْنَتَيْنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَاعْتَرَفْنَا", "translit": "", "root": ""}, {"id": 8, "arabic": "بِذُنُوبِنَا", "translit": "", "root": ""}, {"id": 9, "arabic": "فَهَلِ", "translit": "", "root": ""}, {"id": 10, "arabic": "اِلَيٰ", "translit": "", "root": ""}, {"id": 11, "arabic": "خُرُوجࣲ", "translit": "", "root": ""}, {"id": 12, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 13, "arabic": "سَبِيلࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 12, "text": "ذَٰلِكُم بِأَنَّهُۥٓ إِذَا دُعِيَ اَ۬للَّهُ وَحْدَهُۥ كَفَرْتُمْ وَإِنْ يُّشْرَكْ بِهِۦ تُومِنُواْۖ فَالْحُكْمُ لِلهِ اِ۬لْعَلِيِّ اِ۬لْكَبِيرِۖ", "words": [{"id": 1, "arabic": "ذَٰلِكُم", "translit": "", "root": ""}, {"id": 2, "arabic": "بِأَنَّهُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 4, "arabic": "دُعِيَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَحْدَهُۥ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَفَرْتُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَإِنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُّشْرَكْ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 11, "arabic": "تُومِنُواْۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَالْحُكْمُ", "translit": "", "root": ""}, {"id": 13, "arabic": "لِلهِ", "translit": "", "root": ""}, {"id": 14, "arabic": "اِ۬لْعَلِيِّ", "translit": "", "root": ""}, {"id": 15, "arabic": "اِ۬لْكَبِيرِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 13, "text": "هُوَ اَ۬لذِے يُرِيكُمُۥٓ ءَايَٰتِهِۦ وَيُنَزِّلُ لَكُم مِّنَ اَ۬لسَّمَآءِ رِزْقاࣰۖ وَمَا يَتَذَكَّرُ إِلَّا مَنْ يُّنِيبُۖ", "words": [{"id": 1, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِے", "translit": "", "root": ""}, {"id": 3, "arabic": "يُرِيكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "ءَايَٰتِهِۦ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيُنَزِّلُ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لسَّمَآءِ", "translit": "", "root": ""}, {"id": 9, "arabic": "رِزْقاࣰۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "يَتَذَكَّرُ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 13, "arabic": "مَنْ", "translit": "", "root": ""}, {"id": 14, "arabic": "يُّنِيبُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 14, "text": "فَادْعُواْ اُ۬للَّهَ مُخْلِصِينَ لَهُ اُ۬لدِّينَ وَلَوْ كَرِهَ اَ۬لْكَٰفِرُونَۖ", "words": [{"id": 1, "arabic": "فَادْعُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "اُ۬للَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مُخْلِصِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لدِّينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 7, "arabic": "كَرِهَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لْكَٰفِرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 15, "text": "رَفِيعُ اُ۬لدَّرَجَٰتِ ذُو اُ۬لْعَرْشِۖ يُلْقِے اِ۬لرُّوحَ مِنَ اَمْرِهِۦ عَلَيٰ مَنْ يَّشَآءُ مِنْ عِبَاد