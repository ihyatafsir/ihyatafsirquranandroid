kَّnَyَّfَwَtَn","root":"وفي"},{"id":13,"arabic":"فَإِلَيْنَا","translit":"āَnْyَlِiʾَf","root":""},{"id":14,"arabic":"يُرْجَعُونَ","translit":"َnwُʿعَjgْrُy","root":"رجع"}],"hasIhya":false},{"ayah":78,"text":"وَلَقَدْ أَرْسَلْنَا رُسُلًا مِّن قَبْلِكَ مِنْهُم مَّن قَصَصْنَا عَلَيْكَ وَمِنْهُم مَّن لَّمْ نَقْصُصْ عَلَيْكَۗ وَمَا كَانَ لِرَسُولٍ أَن يَأْتِىَ بِـَٔايَةٍ إِلَّا بِإِذْنِ ٱللَّهِۚ فَإِذَا جَآءَ أَمْرُ ٱللَّهِ قُضِىَ بِٱلْحَقِّ وَخَسِرَ هُنَالِكَ ٱلْمُبْطِلُونَ ","translation":"And We have already sent messengers before you. Among them are those [whose stories] We have related to you, and among them are those [whose stories] We have not related to you. And it was not for any messenger to bring a sign [or verse] except by permission of Allāh. So when the command of Allāh comes, it will be concluded [i.e., judged] in truth, and the falsifiers will thereupon lose [all].","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"أَرْسَلْنَا","translit":"āَnْlَsْrَaʾ","root":"رسل"},{"id":3,"arabic":"رُسُلًا","translit":"āًlُsُr","root":"رسل"},{"id":4,"arabic":"مِّن","translit":"nِّm","root":""},{"id":5,"arabic":"قَبْلِكَ","translit":"َkِlْbَq","root":"قبل"},{"id":6,"arabic":"مِنْهُم","translit":"mُhْnِm","root":""},{"id":7,"arabic":"مَّن","translit":"nَّm","root":""},{"id":8,"arabic":"قَصَصْنَا","translit":"āَnْṣَṣَq","root":"قصص"},{"id":9,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":10,"arabic":"وَمِنْهُم","translit":"mُhْnِmَw","root":""},{"id":11,"arabic":"مَّن","translit":"nَّm","root":""},{"id":12,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":13,"arabic":"نَقْصُصْ","translit":"ْṣُṣْqَn","root":"قصص"},{"id":14,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":15,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":16,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":17,"arabic":"لِرَسُولٍ","translit":"ٍlwُsَrِl","root":"رسل"},{"id":18,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":19,"arabic":"يَأْتِىَ","translit":"َàِtْaʾَy","root":"اتي"},{"id":20,"arabic":"بِـَٔايَةٍ","translit":"ٍẗَyāَٔـِb","root":"ايي"},{"id":21,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":22,"arabic":"بِإِذْنِ","translit":"ِnْhdِiʾِb","root":"اذن"},{"id":23,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":24,"arabic":"فَإِذَا","translit":"āَhdِiʾَf","root":""},{"id":25,"arabic":"جَآءَ","translit":"َءٓāَjg","root":"جيا"},{"id":26,"arabic":"أَمْرُ","translit":"ُrْmَaʾ","root":"امر"},{"id":27,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":28,"arabic":"قُضِىَ","translit":"َàِḍُq","root":"قضي"},{"id":29,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":30,"arabic":"وَخَسِرَ","translit":"َrِsَhkَw","root":"خسر"},{"id":31,"arabic":"هُنَالِكَ","translit":"َkِlāَnُh","root":""},{"id":32,"arabic":"ٱلْمُبْطِلُونَ","translit":"َnwُlِṭْbُmْlٱ","root":"بطل"}],"hasIhya":false},{"ayah":79,"text":"ٱللَّهُ ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَنْعَٰمَ لِتَرْكَبُوا۟ مِنْهَا وَمِنْهَا تَأْكُلُونَ ","translation":"It is Allāh who made for you the grazing animals upon which you ride, and some of them you eat.","words":[{"id":1,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":2,"arabic":"ٱلَّذِى","translit":"àِhdَّlٱ","root":""},{"id":3,"arabic":"جَعَلَ","translit":"َlَʿعَjg","root":"جعل"},{"id":4,"arabic":"لَكُمُ","translit":"ُmُkَl","root":""},{"id":5,"arabic":"ٱلْأَنْعَٰمَ","translit":"َmَٰʿعْnَaʾْlٱ","root":"نعم"},{"id":6,"arabic":"لِتَرْكَبُوا۟","translit":"۟āwُbَkْrَtِl","root":"ركب"},{"id":7,"arabic":"مِنْهَا","translit":"āَhْnِm","root":""},{"id":8,"arabic":"وَمِنْهَا","translit":"āَhْnِmَw","root":""},{"id":9,"arabic":"تَأْكُلُونَ","translit":"َnwُlُkْaʾَt","root":"اكل"}],"hasIhya":false},{"ayah":80,"text":"وَلَكُمْ فِيهَا مَنَٰفِعُ وَلِتَبْلُغُوا۟ عَلَيْهَا حَاجَةً فِى صُدُورِكُمْ وَعَلَيْهَا وَعَلَى ٱلْفُلْكِ تُحْمَلُونَ ","translation":"And for you therein are [other] benefits and that you may realize upon them a need which is in your breasts;[1] and upon them and upon ships you are carried.","words":[{"id":1,"arabic":"وَلَكُمْ","translit":"ْmُkَlَw","root":""},{"id":2,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":3,"arabic":"مَنَٰفِعُ","translit":"ُʿعِfَٰnَm","root":"نفع"},{"id":4,"arabic":"وَلِتَبْلُغُوا۟","translit":"۟āwُغُlْbَtِlَw","root":"بلغ"},{"id":5,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":6,"arabic":"حَاجَةً","translit":"ًẗَjgāَḥ","root":"حوج"},{"id":7,"arabic":"فِى","translit":"àِf","root":""},{"id":8,"arabic":"صُدُورِكُمْ","translit":"ْmُkِrwُdُṣ","root":"صدر"},{"id":9,"arabic":"وَعَلَيْهَا","translit":"āَhْyَlَʿعَw","root":""},{"id":10,"arabic":"وَعَلَى","translit":"àَlَʿعَw","root":""},{"id":11,"arabic":"ٱلْفُلْكِ","translit":"ِkْlُfْlٱ","root":"فلك"},{"id":12,"arabic":"تُحْمَلُونَ","translit":"َnwُlَmْḥُt","root":"حمل"}],"hasIhya":false},{"ayah":81,"text":"وَيُرِيكُمْ ءَايَٰتِهِۦ فَأَىَّ ءَايَٰتِ ٱللَّهِ تُنكِرُونَ ","translation":"And He shows you His signs. So which of the signs of Allāh do you deny?","words":[{"id":1,"arabic":"وَيُرِيكُمْ","translit":"ْmُkyِrُyَw","root":"راي"},{"id":2,"arabic":"ءَايَٰتِهِۦ","translit":"ۦِhِtَٰyāَء","root":"ايي"},{"id":3,"arabic":"فَأَىَّ","translit":"َّàَaʾَf","root":"ايي"},{"id":4,"arabic":"ءَايَٰتِ","translit":"ِtَٰyāَء","root":"ايي"},{"id":5,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":6,"arabic":"تُنكِرُونَ","translit":"َnwُrِknُt","root":"نكر"}],"hasIhya":false},{"ayah":82,"text":"أَفَلَمْ يَسِيرُوا۟ فِى ٱلْأَرْضِ فَيَنظُرُوا۟ كَيْفَ كَانَ عَٰقِبَةُ ٱلَّذِينَ مِن قَبْلِهِمْۚ كَانُوٓا۟ أَكْثَرَ مِنْهُمْ وَأَشَدَّ قُوَّةً وَءَاثَارًا فِى ٱلْأَرْضِ فَمَآ أَغْنَىٰ عَنْهُم مَّا كَانُوا۟ يَكْسِبُونَ ","translation":"Have they not traveled through the land and observed how was the end of those before them? They were more numerous than themselves and greater in strength and in impression on the land, but they were not availed by what they used to earn.","words":[{"id":1,"arabic":"أَفَلَمْ","translit":"ْmَlَfَaʾ","root":""},{"id":2,"arabic":"يَسِيرُوا۟","translit":"۟āwُryِsَy","root":"سير"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":5,"arabic":"فَيَنظُرُوا۟","translit":"۟āwُrُẓnَyَf","root":"نظر"},{"id":6,"arabic":"كَيْفَ","translit":"َfْyَk","root":"كيف"},{"id":7,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":8,"arabic":"عَٰقِبَةُ","translit":"ُẗَbِqَٰʿع","root":"عقب"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"قَبْلِهِمْ","translit":"ْmِhِlْbَq","root":"قبل"},{"id":12,"arabic":"كَانُوٓا۟","translit":"۟āٓwُnāَk","root":"كون"},{"id":13,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":14,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":15,"arabic":"وَأَشَدَّ","translit":"َّdَhsَaʾَw","root":"شدد"},{"id":16,"arabic":"قُوَّةً","translit":"ًẗَّwُq","root":"قوي"},{"id":17,"arabic":"وَءَاثَارًا","translit":"āًrāَhtāَءَw","root":"اثر"},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":20,"arabic":"فَمَآ","translit":"ٓāَmَf","root":""},{"id":21,"arabic":"أَغْنَىٰ","translit":"ٰàَnْغَaʾ","root":"غني"},{"id":22,"arabic":"عَنْهُم","translit":"mُhْnَʿع","root":""},{"id":23,"arabic":"مَّا","translit":"āَّm","root":""},{"id":24,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":25,"arabic":"يَكْسِبُونَ","translit":"َnwُbِsْkَy","root":"كسب"}],"hasIhya":false},{"ayah":83,"text":"فَلَمَّا جَآءَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَٰتِ فَرِحُوا۟ بِمَا عِندَهُم مِّنَ ٱلْعِلْمِ وَحَاقَ بِهِم مَّا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ ","translation":"And when their messengers came to them with clear proofs, they [merely] rejoiced in what they had of knowledge, but they were enveloped by what they used to ridicule.","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"جَآءَتْهُمْ","translit":"ْmُhْtَءٓāَjg","root":"جيا"},{"id":3,"arabic":"رُسُلُهُم","translit":"mُhُlُsُr","root":"رسل"},{"id":4,"arabic":"بِٱلْبَيِّنَٰتِ","translit":"ِtَٰnِّyَbْlٱِb","root":"بين"},{"id":5,"arabic":"فَرِحُوا۟","translit":"۟āwُḥِrَf","root":"فرح"},{"id":6,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":7,"arabic":"عِندَهُم","translit":"mُhَdnِʿع","root":"عند"},{"id":8,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":9,"arabic":"ٱلْعِلْمِ","translit":"ِmْlِʿعْlٱ","root":"علم"},{"id":10,"arabic":"وَحَاقَ","translit":"َqāَḥَw","root":"حيق"},{"id":11,"arabic":"بِهِم","translit":"mِhِb","root":""},{"id":12,"arabic":"مَّا","translit":"āَّm","root":""},{"id":13,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":14,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":15,"arabic":"يَسْتَهْزِءُونَ","translit":"َnwُءِzْhَtْsَy","root":"هزا"}],"hasIhya":false},{"ayah":84,"text":"فَلَمَّا رَأَوْا۟ بَأْسَنَا قَالُوٓا۟ ءَامَنَّا بِٱللَّهِ وَحْدَهُۥ وَكَفَرْنَا بِمَا كُنَّا بِهِۦ مُشْرِكِينَ ","translation":"And when they saw Our punishment, they said, \"We believe in Allāh alone and disbelieve in that which we used to associate with Him.\"","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"رَأَوْا۟","translit":"۟āْwَaʾَr","root":"راي"},{"id":3,"arabic":"بَأْسَنَا","translit":"āَnَsْaʾَb","root":"باس"},{"id":4,"arabic":"قَالُوٓا۟","translit":"۟āٓwُlāَq","root":"قول"},{"id":5,"arabic":"ءَامَنَّا","translit":"āَّnَmāَء","root":"امن"},{"id":6,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":7,"arabic":"وَحْدَهُۥ","translit":"ۥُhَdْḥَw","root":"وحد"},{"id":8,"arabic":"وَكَفَرْنَا","translit":"āَnْrَfَkَw","root":"كفر"},{"id":9,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":10,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":11,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":12,"arabic":"مُشْرِكِينَ","translit":"َnyِkِrْhsُm","root":"شرك"}],"hasIhya":false},{"ayah":85,"text":"فَلَمْ يَكُ يَنفَعُهُمْ إِيمَٰنُهُمْ لَمَّا رَأَوْا۟ بَأْسَنَاۖ سُنَّتَ ٱللَّهِ ٱلَّتِى قَدْ خَلَتْ فِى عِبَادِهِۦۖ وَخَسِرَ هُنَالِكَ ٱلْكَٰفِرُونَ ","translation":"But never did their faith benefit them once they saw Our punishment. [It is] the established way of Allāh which has preceded among His servants. And the disbelievers thereupon lost [all].","words":[{"id":1,"arabic":"فَلَمْ","translit":"ْmَlَf","root":""},{"id":2,"arabic":"يَكُ","translit":"ُkَy","root":"كون"},{"id":3,"arabic":"يَنفَعُهُمْ","translit":"ْmُhُʿعَfnَy","root":"نفع"},{"id":4,"arabic":"إِيمَٰنُهُمْ","translit":"ْmُhُnَٰmyِiʾ","root":"امن"},{"id":5,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":6,"arabic":"رَأَوْا۟","translit":"۟āْwَaʾَr","root":"راي"},{"id":7,"arabic":"بَأْسَنَا","translit":"āَnَsْaʾَb","root":"باس"},{"id":8,"arabic":"سُنَّتَ","translit":"َtَّnُs","root":"سنن"},{"id":9,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":10,"arabic":"ٱلَّتِى","translit":"àِtَّlٱ","root":""},{"id":11,"arabic":"قَدْ","translit":"ْdَq","root":""},{"id":12,"arabic":"خَلَتْ","translit":"ْtَlَhk","root":"خلو"},{"id":13,"arabic":"فِى","translit":"àِf","root":""},{"id":14,"arabic":"عِبَادِهِۦ","translit":"ۦِhِdāَbِʿع","root":"عبد"},{"id":15,"arabic":"وَخَسِرَ","translit":"َrِsَhkَw","root":"خسر"},{"id":16,"arabic":"هُنَالِكَ","translit":"َkِlāَnُh","root":""},{"id":17,"arabic":"ٱلْكَٰفِرُونَ","translit":"َnwُrِfَٰkْlٱ","root":"كفر"}],"hasIhya":false}],"tafsir":{"1":[{"arabic":"قال إذا أردت الخروج فآذني فكتب عند خروجه إليه بسم الله الرحمن الرحيم {حم تنزيل الكتاب من الله العزيز العليم غافر الذنب وقابل التوب شديد العقاب} الآية ثم عاتبه تحت ذلك وعذله فلما قرأ الكتاب بكى وقال صدق الله ونصح لي عمر فتاب ورجع وحكي أن أخوين ابتلى أحدهما بهوى فأظهر عليه أخاه وقال إني قد اعتللت فإن شئت أن لا تعقد على صحبتي لله فافعل فقال ما كنت لأحل عقد أخوتك لأجل خطيئتك أبدا ثم عقد أخوه بينه وبين الله بأن لا يأكل ولا يشرب حتى يعافى الله أخاه من هواه فطوى أربعين يوما في كلها يسأله عن هواه فكان يقول القلب مقيم على حاله وما زال هو ينحل من الغم والجوع حتى زال الهوى عن قلب أخيه بعد الأربعين","english":"Abu Dharr (may Allah be pleased with him) held the view of severance, saying: \"When your brother turns away from what he once was, then hate him from the very perspective from which you loved him.\" He considered this to be a requirement of loving for Allah's sake and hating for Allah's sake.","book_title":"Condemnation of Anger and Hatred","section_title_ar":"Section 424","section_title_en":"On the Error of a Friend: Between Severance and Gentleness in Brotherhood","section_index":424,"anchors":"- Root: لطف (luṭf)\n  * Lisan / Ayn: Gentleness, subtlety, refinement; the opposite of harshness and coarseness.\n  * Al-Raghib (Mufradat): The subtle divine reality (laṭīfah) that perceives the finest nuances of affairs; also gentleness (rifq) in dealing.\n  * Al-Zamakhshari (Asas): Literal: that which is not coarse. Metaphorical: \"I was gentle with him\" (laṭaftu bihi) — showing affection and gentleness in dealing, and \"he is gentle with this matter\" — skillful in managing it.\n- Root: دين (dīn)\n  * Lisan / Ayn: Religion, creed, judgment, recompense; the comprehensive term for one's obligatory practices and beliefs.\n  * Al-Raghib (Mufradat): The root denotes indebtedness and obedience; the religion (dīn) is that by which one is bound to the Divine command.\n- Root: عقد (ʿaqd)\n  * Lisan / Ayn: To tie, bind, contract; the knot of brotherhood (ʿaqd al-ukhuwwah) as a binding covenant.\n  * Al-Raghib (Mufradat): A firm resolution or covenant that obligates its fulfillment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish the precise scope of a ruling, e.g., \"I only hate his deed\" (innamā ubghiḍu ʿamalahu), restricting hatred to the act, not the person.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Anger and Hatred'","badge":"Insight"}],"3":[{"arabic":"{حم تنزيل الكتاب من الله العزيز العليم غافر الذنب وقابل التوب شديد العقاب} الآية ثم عاتبه تحت ذلك وعذله فلما قرأ الكتاب بكى وقال صدق الله ونصح لي عمر فتاب ورجع وحكي أن أخوين ابتلى أحدهما بهوى فأظهر عليه أخاه وقال إني قد اعتللت فإن شئت أن لا تعقد على صحبتي لله فافعل فقال ما كنت لأحل عقد أخوتك لأجل خطيئتك أبدا ثم عقد أخوه بينه وبين الله بأن لا يأكل ولا يشرب حتى يعافى الله أخاه من هواه فطوى أربعين يوما في كلها يسأله عن هواه فكان يقول القلب مقيم على حاله وما زال هو ينحل من الغم والجوع حتى زال الهوى عن قلب أخيه بعد الأربع","english":"Abu Dharr (may Allah be pleased with him) held the view of severance, saying: \"When your brother turns away from what he once was, then hate him from the very perspective from which you loved him.\" He considered this to be a requirement of loving for Allah's sake and hating for Allah's sake.","book_title":"Condemnation of Delusion","section_title_ar":"Section 424","section_title_en":"On the Error of a Friend: Between Severance and Gentleness in Brotherhood","section_index":424,"anchors":"- Root: لطف (luṭf)\n  * Lisan / Ayn: Gentleness, subtlety, refinement; the opposite of harshness and coarseness.\n  * Al-Raghib (Mufradat): The subtle divine reality (laṭīfah) that perceives the finest nuances of affairs; also gentleness (rifq) in dealing.\n  * Al-Zamakhshari (Asas): Literal: that which is not coarse. Metaphorical: \"I was gentle with him\" (laṭaftu bihi) — showing affection and gentleness in dealing, and \"he is gentle with this matter\" — skillful in managing it.\n- Root: دين (dīn)\n  * Lisan / Ayn: Religion, creed, judgment, recompense; the comprehensive term for one's obligatory practices and beliefs.\n  * Al-Raghib (Mufradat): The root denotes indebtedness and obedience; the religion (dīn) is that by which one is bound to the Divine command.\n- Root: عقد (ʿaqd)\n  * Lisan / Ayn: To tie, bind, contract; the knot of brotherhood (ʿaqd al-ukhuwwah) as a binding covenant.\n  * Al-Raghib (Mufradat): A firm resolution or covenant that obligates its fulfillment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish the precise scope of a ruling, e.g., \"I only hate his deed\" (innamā ubghiḍu ʿamalahu), restricting hatred to the act, not the person.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'","badge":"Insight"}],"11":[{"arabic":"لم يتكلموا بعدها أبدا يقولون {ربنا أمتنا اثنتين وأحييتنا اثنتين فاعترفنا بذنوبنا فهل إلى خروج من سبيل} فيقول الله تعالى مجيبا لهم {ذلكم بأنه إذا دعي الله وحده كفرتم وإن يشرك به تؤمنوا فالحكم لله العلي الكبير} ثم يقولون {ربنا أخرنا إلى أجل قريب نجب دعوتك ونتبع الرسل} فيجيبهم الله تعالى أو لم تكونوا أقسمتم من قبل ما لكم من زوال فيقولون ربنا أخرجنا نعمل صالحا غير الذي كنا نعمل به فيجيبهم الله تعالى أو لم نعمركم ما يتذكر فيه من تذكر وجاءكم النذير فذوقوا فما للظالمين من نصير ثم يقولون {ربنا غلبت علينا شقوتنا وكنا قوما ضالين ربنا أخرجنا منها فإن عدن","english":"At that point they despair of every good, and at that point they take to sighing, regret, and wailing. Abu Umamah said: The Messenger of Allah, peace be upon him, said concerning His words, \"And he is given to drink of festering water, which he sips but can hardly swallow\" {«وَيُسْقَىٰ مِن مَّاءٍ صَدِيدٍ يَتَجَرَّعُهُ وَلَا يَكَادُ يُسِيغُهُ»}: \"It is brought near to him, and he loathes it. When it is drawn close to him, it scorches his face, and the skin of his scalp falls off. When he drinks it, it severs his intestines until it exits from his anus.\" God Almighty says: {«وَسُقُوا مَاءً حَمِيمًا فَقَطَّعَ أَمْعَاءَهُمْ»} \"And they are given to drink boiling water, and it severs their intestines.\" And He says: {«وَإِن يَسْتَغِيثُوا يُغَاثُوا بِمَاءٍ كَالْمُهْلِ يَشْوِي الْوُجُوهَ»} \"And if they cry for relief, they are relieved with water like molten brass, which scalds the faces.\" So this is their food and drink in their hunger and thirst.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1350","section_title_en":"The Torments of the Fire: Serpents, Scorpions, and the Anguish of the Damned","section_index":1350,"anchors":"- Root: حس (ḥ-s-s) — [AVOIDED per instruction]\n- Root: نار (n-r) — Fire\n  * Lisan al-Arab: \"النار: معروفة، وهي نار جهنم، ذات لفح وحرّ.\"\n  * Al-Raghib (Mufradat): \"النار: قد تطلق على نار الدنيا ونار الآخرة، وهي التي أعدها الله للكافرين، وفيها من أصناف العذاب ما لا يعلمه إلا الله.\"\n  * Al-Zamakhshari (Asas): \"نار: حقيقة في النار المحرقة، ومجاز في نار الحرب والحرب.\"\n- Root: حي (ḥ-y) — Serpent\n  * Lisan al-Arab: \"الحية: من الهوام، وتجمع على حيات، وأعظمها ما كان كأعناق البخت.\"\n  * Al-Raghib (Mufradat): \"الحية: دابة مؤذية، وفي الآخرة تكون أعظم وأشد إيلامًا.\"\n- Root: عقر (ʿ-q-r) — Scorpion\n  * Lisan al-Arab: \"العقرب: دويبة مؤذية تلدغ، وفي النار تكون كالبغال.\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to specify that serpents and scorpions are only empowered over those who were dominated by miserliness and evil character in the world.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Remembrance of Death and Afterlife'","badge":"Du'a"}],"12":[{"arabic":"بذنوبنا فهل إلى خروج من سبيل} فيقول الله تعالى مجيبا لهم {ذلكم بأنه إذا دعي الله وحده كفرتم وإن يشرك به تؤمنوا فالحكم لله العلي الكبير} ثم يقولون {ربنا أخرنا إلى أجل قريب نجب دعوتك ونتبع الرسل} فيجيبهم الله تعالى أو لم تكونوا أقسمتم من قبل ما لكم من زوال فيقولون ربنا أخرجنا نعمل صالحا غير الذي كنا نعمل به فيجيبهم الله تعالى أو لم نعمركم ما يتذكر فيه من تذكر وجاءكم النذير فذوقوا فما للظالمين من نصير ثم يقولون {ربنا غلبت علينا شقوتنا وكنا قوما ضالين ربنا أخرجنا منها فإن عدنا فإنا ظالمون} فيجيبهم الله تعالى {اخسؤوا فيها ولا تكلمون} فلا يتكلمون بعدها أبدا وذلك غاية شدة العذاب","english":"At that point they despair of every good, and at that point they take to sighing, regret, and wailing. Abu Umamah said: The Messenger of Allah, peace be upon him, said concerning His words, \"And he is given to drink of festering water, which he sips but can hardly swallow\" {«وَيُسْقَىٰ مِن مَّاءٍ صَدِيدٍ يَتَجَرَّعُهُ وَلَا يَكَادُ يُسِيغُهُ»}: \"It is brought near to him, and he loathes it. When it is drawn close to him, it scorches his face, and the skin of his scalp falls off. When he drinks it, it severs his intestines until it exits from his anus.\" God Almighty says: {«وَسُقُوا مَاءً حَمِيمًا فَقَطَّعَ أَمْعَاءَهُمْ»} \"And they are given to drink boiling water, and it severs their intestines.\" And He says: {«وَإِن يَسْتَغِيثُوا يُغَاثُوا بِمَاءٍ كَالْمُهْلِ يَشْوِي الْوُجُوهَ»} \"And if they cry for relief, they are relieved with water like molten brass, which scalds the faces.\" So this is their food and drink in their hunger and thirst.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1350","section_title_en":"The Torments of the Fire: Serpents, Scorpions, and the Anguish of the Damned","section_index":1350,"anchors":"- Root: حس (ḥ-s-s) — [AVOIDED per instruction]\n- Root: نار (n-r) — Fire\n  * Lisan al-Arab: \"النار: معروفة، وهي نار جهنم، ذات لفح وحرّ.\"\n  * Al-Raghib (Mufradat): \"النار: قد تطلق على نار الدنيا ونار الآخرة، وهي التي أعدها الله للكافرين، وفيها من أصناف العذاب ما لا يعلمه إلا الله.\"\n  * Al-Zamakhshari (Asas): \"نار: حقيقة في النار المحرقة، ومجاز في نار الحرب والحرب.\"\n- Root: حي (ḥ-y) — Serpent\n  * Lisan al-Arab: \"الحية: من الهوام، وتجمع على حيات، وأعظمها ما كان كأعناق البخت.\"\n  * Al-Raghib (Mufradat): \"الحية: دابة مؤذية، وفي الآخرة تكون أعظم وأشد إيلامًا.\"\n- Root: عقر (ʿ-q-r) — Scorpion\n  * Lisan al-Arab: \"العقرب: دويبة مؤذية تلدغ، وفي النار تكون كالبغال.\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to specify that serpents and scorpions are only empowered over those who were dominated by miserliness and evil character in the world.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Remembrance of Death and Afterlife'","badge":"Du'a"}],"13":[{"arabic":"لكل عبد منيب} وقال عز وجل {وما يتذكر إلا من ينيب} وقال تعالى {إنما يتذكر أولوا الألباب} فالذي آثر غرور الدنيا على نعيم الآخرة فليس من ذوي الألباب ولذلك لا تنكشف له أسرار الكتاب رابعها أن يكون قد قرأ تفسيرا ظاهرا واعتقد أنه لا معنى لكلمات القرآن إلا ما تناوله النقل عن ابن عباس ومجاهد وغيرهما وأن ما وراء ذلك تفسير بالرأي وأن من فسر القرآن برأيه فقد تبوأ مقعده من النار فهذا أيضا من الحجب العظيمة وسنبين معنى التفسير بالرأي في الباب الرابع وأن ذلك لا يناقض قول علي رضي الله عنه إلا أن يؤتى","english":"I say: These meanings are buried treasures that are not unveiled except to the divinely aided ones. To this 'Ali — may God be pleased with him — alluded by his saying: \"The Messenger of God — may God's peace and blessings be upon him — did not confide to me anything that he concealed from the people, except that God — mighty and majestic — grants to a servant understanding (fahm) of His Book. So let one be eager in seeking that understanding.\" (1) And Ibn Mas'ud — may God be pleased with him — said: \"Whoever desires the knowledge of the first and the last, let him stir up the Qur'an.\" And the greatest of the sciences of the Qur'an lie beneath the names of God — mighty and majestic — and His attributes, for most of creation have grasped from them only matters befitting their understandings and have not stumbled upon their depths.","book_title":"Etiquette of Quran Recitation","section_title_ar":"Section 228","section_title_en":"The Revival of the Religious Sciences — Section 228: On the Inner Meanings of the Qur'an and the Removal of Obstacles to Understanding","section_index":228,"anchors":"- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, discernment, the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one verifies the realities of what is perceived; distinct from mere hearing or transmission\n  * Al-Zamakhshari (Asas): Literal: swift apprehension; Metaphorical: the divine gift of insight into hidden meanings, as in the verse {ففهمناها سليمان}\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transformation from one state to another\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as that which is perpetually turned and overturned between states\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of understanding that is veiled or illuminated, rusted or polished\n- Root: سمع (s-m-')\n  * Lisan / Ayn: Hearing, the auditory faculty\n  * Al-Raghib (Mufradat): \"السمع: قوة في الأذن به يدرك الأصوات\" — extends metaphorically to comprehension and obedience; \"أو ألقى السمع وهو شهيد\" — one who casts his hearing while present\n  * Al-Zamakhshari (Asas): Literal: auditory perception; Metaphorical: attentive obedience and receptive understanding\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise delimitation of predicates such as \"إنما يتذكر أولوا الألباب\" where restriction confines the action to its proper subject","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'","badge":"Insight"}],"14":[{"arabic":"الله وحده لا شريك له مخلصين له الدين ولو كره الكافرون يفتتح بالتكبير ليلة الفطر إلى الشروع في صلاة العيد وفي العيد الثاني يفتتح التكبير عقيب الصبح يوم عرفة إلى آخر النهار يوم الثالث عشر وهذا أكمل الأقاويل ويكبر عقيب الصلوات المفروضة وعقيب النوافل وهو عقيب الفرائض آكد الثاني إذا أصبح يوم العيد يغتسل ويتزين ويتطيب كما ذكرناه في الجمعة والرداء والعمامة هو الأفضل للرجال وليجنب الصبيان الحرير والعجائز التزين عند الخروج الثالث أن يخرج من طريق ويرجع من طريق آخر (1) هكذا فعل رسول الله صلى الله عليه وسلم وك","english":"**The First:** The takbīr (declaration of Allah's Greatness). Its beginning is established by the saying of Allah, the Exalted: {«وَتُكْمِلُوا الْعِدَّةَ وَلِتُكَبِّرُوا اللَّهَ عَلَى مَا هَدَاكُمْ»} (\"And that you complete the number and magnify Allah for having guided you\") {Al-Baqarah: 185}. Its form is that one says: \"Allāhu akbar, Allāhu akbar, lā ilāha illā Allāhu wa-Allāhu akbar, Allāhu akbar wa-li-Llāhi al-ḥamd\" (Allah is Greater, Allah is Greater, there is no deity except Allah, and Allah is Greater, Allah is Greater, and to Allah belongs all praise). And it is said: \"Allāhu akbar kabīran, wa-al-ḥamdu li-Llāhi kathīran, wa-subḥāna Allāhi bukratan wa-aṣīlā, lā ilāha illā Allāhu waḥdahu lā sharīka lah, mukhlisīna lahu al-dīn wa-law kariha al-kāfirūn\" (Allah is Greater, abundantly great, and praise be to Allah, abundantly much, and glory be to Allah morning and evening. There is no deity except Allah alone, with no partner, sincere to Him in religion, even though the disbelievers detest it). One begins the takbīr on the night of Fiṭr until the commencement of the Eid prayer. In the second Eid (al-Aḍḥā), one begins the takbīr immediately after the dawn prayer on the Day of ʿArafah until the end of the day of the thirteenth [of Dhū al-Ḥijjah]. This is the most complete of the sayings. One pronounces the takbīr after the obligatory prayers and after the supererogatory prayers, though it is more emphatic after the obligatory ones.","book_title":"Mysteries of Hajj","section_title_ar":"Section 162","section_title_en":"The Book of the Revival of the Religious Sciences — Section on the Two Festivals (Eid), the Supererogatory Prayers of Rajab and Shaʿbān","section_index":162,"anchors":"- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core meaning of greatness in magnitude, age, or rank; al-takbīr is the utterance \"Allāhu akbar\" (Allah is Greater).\n  * Al-Raghib (Mufradat): Al-kabīr and al-ṣaghīr are relative terms; takbīr in worship signifies declaring Allah's transcendence above all comparison, used in quantity (connected/disconnected) and in dignity.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"Allāhu akbar\" as magnification of Allah's majesty. Metaphorical (majāz): \"takabbara\" for prideful self-aggrandizement (blameworthy), distinct from the liturgical takbīr.\n- Root: صلا (ṣ-l-w)\n  * Lisan / Ayn: Root denotes supplication (duʿā'), blessing, and the ritual prayer; al-ṣalāh as worship with bowing and prostration.\n  * Al-Raghib (Mufradat): Al-ṣalāh is fundamentally supplication and seeking forgiveness; in the Law it is the specific acts of worship comprising standing, bowing, and prostration, with the heart present in humility.\n  * Al-Zamakhshari (Asas): Literal: the prescribed prayer (al-ṣalāh al-maktūbah). Metaphorical: \"ṣallā ʿalā\" for invoking blessings (on the Prophet), and \"muṣallīn\" for those who pray or supplicate.\n- Root: سجد (s-j-d)\n  * Lisan / Ayn: Prostration; placing the forehead on the ground in worship.\n  * Al-Raghib (Mufradat): Al-sujūd is fundamentally humility and self-abasement; it is made a term for humbling oneself before Allah in worship — two kinds: voluntary (for humans, deserving reward) and compelled/subjugated (for all creation).\n  * Al-Zamakhshari (Asas): Literal: prostration in prayer. Metaphorical: \"sajadat al-safīnah lil-riyāḥ\" (the ship yields to the winds), and \"ʿayn sājidah\" (a languid eye) — indicating submission or stillness.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — Used in the text's argumentation (e.g., \"إنما أوردناها في هذا القسم لأنها تتكرر\") to restrict the reason for inclusion, and in preference statements (\"والمختار أن الجماعة أفضل\") to assert a focused judgment.","content_type":"dhikr","topic":"Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Mysteries of Hajj'","badge":"Dhikr"}],"15":[{"arabic":"الروح من أمره على من يشاء من عباده} وأحال الإغواء على إبليس فقال تعالى {ليضل عن سبيله} والإغواء هو استيقاف العباد دون بلوغ غاية الحكمة فانظر كيف نسبه إلى العبد الذي غضب عليه والإرشاد سياقه لهم إلى الغاية فانظر كيف نسبه إلى العبد الذي أحبه وعندك في العادة له مثال فالملك إذا كان محتاجا إلى من يسقيه الشراب وإلى من يحجمه وينظف فناء منزله عن القاذورات وكان له عبدان فلا يعين للحجامة والتنظيف إلا أقبحهما وأخسهما ولا يفوض حمل الشراب والطيب إلا إلى أحسنهما وأكملهما وأحبهما إليه ولا ينبغ","english":"Thus was the beginning of this matter and its end. And do not understand it unless you are worthy of it. And if you are worthy of it, the eye is opened and you see, so you have no need of a leader to lead you. The blind man can indeed be led, but only to a limit. For when the path narrows and becomes sharper than a sword and finer than a hair, the bird is able to fly over it but is not able to drag a blind man behind it. And when the field becomes narrow and subtle — subtle as water, for example — and crossing is possible only by swimming, then the one skilled in the art of swimming may be able to cross by himself, and perhaps he is not able to drag another behind him. These matters bear the same relation to walking upon the way of the common masses of creatures as walking upon water bears to walking upon earth. Swimming can be learned; but as for walking upon water, it is not acquired by instruction, but rather is attained through the strength of certainty (yaqīn). For this reason it was said to the Prophet, peace be upon him, that Jesus, peace be upon him, was said to have walked upon water, and he, peace be upon him, said: \"Had his certainty increased, he would have walked upon the air.\" {«حديث قيل له يقال إن عيسى مشى على الماء قال لو ازداد يقينا لمشي على الهواء»} — This hadith is rejected (munkar) and is not known in this form. What is known is what Ibn Abi al-Dunya narrated in the Book of Certainty from the saying of Bakr ibn Abd Allah al-Muzani, who said: The disciples lost their Prophet, and it was said to them: \"He has headed toward the sea.\" So they set out seeking him, and when they reached the sea, behold, he was coming toward them walking upon the water. And he mentioned a hadith in which Jesus said: \"If the son of Adam had a hair's breadth of certainty, he would walk upon the water.\" And Abu Mansur al-Daylami narrated in the Musnad al-Firdaws with a weak chain from the hadith of Muadh ibn Jabal: \"If you knew God with true knowledge, you would walk upon the seas, and the mountains would be removed by your supplications.\" These are symbols and allusions to the meaning of aversion (karāhah) and love (maḥabbah), and good pleasure (riḍā) and wrath (ghaḍab), and gratitude (shukr) and ingratitude (kufrān) — more than this is not fitting for the science of practical conduct (ʿilm al-muʿāmalah). And God, exalted be He, struck an example of this to draw it near to the understanding of creatures, since He knew that He created the jinn and mankind only to worship Him, and their worship was the ultimate purpose of wisdom (ghāyat al-ḥikmah) with respect to them. Then He informed that He has two servants: one whom He loves, whose name is Gabriel — the Holy Spirit and the Trustworthy One — and he is with Him beloved, obeyed, trustworthy, and honored; and another whom He hates, whose name is Iblis — the accursed one, reprieved until the Day of Judgment. Then He delegated guidance (irshād) to Gabriel, saying, the Exalted: {«قل نزله روح القدس من ربك بالحق»} \"Say: The Holy Spirit has brought it down from your Lord with truth\" (16:102), and said, the Exalted: {«يلقي الروح من أمره على من يشاء من عباده»} \"He casts the Spirit of His command upon whom He wills of His servants\" (40:15). And He delegated misguidance (ighwāʾ) to Iblis, saying, the Exalted: {«ليضل عن سبيله»} \"That he may lead astray from His path\" (4:119). And ighwāʾ is the halting of servants short of attaining the ultimate purpose of wisdom. So observe how He attributed it to the servant with whom He was wrathful; and guidance (irshād) is the conduct of them toward the ultimate purpose — so observe how He attributed it to the servant whom He loves. And you have an example of this in custom: when a king is in need of one to give him drink and one to cup him and to clean the courtyard of his house of filth, and he has two servants, he does not appoint for cupping and cleaning except the ugliest and meanest of them, and he does not entrust the carrying of drink and perfume except to the best and most complete of them and the most beloved to him. And you should not say: \"This is my act, and his act was not without my act\" — for you have erred when you attributed that to yourself. Rather, He is the One who directed your motive (dāʿiyah) to the specification of the disliked act to the disliked person, and the beloved act to the beloved person, as a completion of justice (ʿadl). For His justice is sometimes completed through matters in which you have no entry, and sometimes it is completed in you — for you also are among His acts. So your motive, your power, your knowledge, your action, and all the other causes of your movements in expression — all of this is His act, which He arranged with justice in an arrangement from which moderate acts issue forth. Except that you see only yourself, and so you suppose that what appears through you in the world of witness (ʿālam al-shahādah) has no cause from the world of the unseen and the dominion (ʿālam al-ghayb wa al-malakūt). Therefore you attribute it to yourself. And you are only like the child who looks at night at the play of the juggler (mushʿabadh) who brings forth figures from behind a curtain that dance and scream and rise and sit, composed of rags that do not move by themselves — rather, they are moved by fine hair-like threads that do not appear in the darkness of night, their ends in the hand of the juggler, who is hidden from the eyes of the children. So they rejoice and marvel, supposing that those rags dance and play and rise and sit. As for the intelligent ones, they know that this is a moving (taḥrīk) and not a self-movement, but perhaps they do not know its detailed modality. And the one who knows some of its detail does not know it as the juggler knows it, to whom the command belongs and in whose hand is the pulling. Likewise, the children of the people of this world — and all creatures are children relative to the scholars — look at these persons (ashkhāṣ) and suppose that they are the movers, and so they attribute [action] to them. And the scholars know that they are moved, except that they do not know the modality of the moving — and they are the majority. Except the knowers (ʿārifūn), the scholars, and those firmly rooted in knowledge (al-rāsikhūn), for they have perceived, with the sharpness of their sight, fine spider-web threads — nay, much finer than these — suspended from heaven, their ends attached to the persons of the people of the earth. Those threads are not perceived, due to their fineness, by these outward eyes. Then they witnessed the heads of those threads in their suspension-points (manāṭāt) to which they are attached, and they witnessed for those suspension-points handles (maqābiḍ) that are in the hands of the angels who move the heavens. And they also witnessed the angels of the heavens directed toward the bearers of the Throne (ḥamalat al-ʿarsh), awaiting what descends upon them of the command from the presence of Lordship (ḥaḍrat al-rubūbiyyah) — \"they do not disobey God in what He commands them, and they do what they are commanded\" (66:6). And He expressed these witnessed realities in the Qur'an, and it was said: {«وفي السماء رزقكم وما توعدون»} \"And in the heaven is your provision and what you are promised\" (51:22). And He expressed the waiting of the angels of the heavens for what descends upon them of decree and command, and it was said: \"He created seven heavens and of the earth the like of them; {«يتنزل الأمر بينهن لتعلموا أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما»} 'the command descends between them, that you may know that God is powerful over all things and that God encompasses all things in knowledge'\" (65:12). These are matters whose interpretation (taʾwīl) none knows except God and those firmly rooted in knowledge (al-rāsikhūn fī al-ʿilm). And Ibn Abbas, may God be pleased with them both, expressed the exclusivity of those firmly rooted in knowledge to sciences that the understandings of creatures cannot bear, when he recited the saying of the Exalted: {«يتنزل الأمر بينهن»} \"The command descends between them,\" and said: \"Were I to mention what I know of the meaning of this verse, you would stone me\" — and in another wording: \"You would say he is an unbeliever.\"","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 990","section_title_en":"On the Degrees of Proximity to God and the Hierarchy of Those Who Perfect Divine Wisdom","section_index":990,"anchors":"- Root: سير (s-y-r)\n  * Lisan / Ayn: \"السير: الذهاب والسفر، وسار يسير سيرا ومسيرا، والسيارة: الرفقة المسافرة\"\n  * Al-Raghib (Mufradat): \"السير: الانتقال من مكان إلى مكان، ويستعار للسلوك في الدين والطريقة\"\n  * Al-Zamakhshari (Asas): [Literal] \"سار القوم: مشوا\" — [Metaphorical] \"سار فيه السير: مضى في الأمر، وسار ذكره: انتشر، ومنه: سيرة فلان: طريقته\"\n- Root: مشي (m-sh-y)\n  * Lisan / Ayn: \"المشي: تردد الأركان على الأرض، والماشية: الإبل والغنم لانتقالها في المرعى\"\n  * Al-Raghib (Mufradat): \"المشي: الانتقال من مكان إلى مكان بإرادة، ويكنى به عن النميمة، وعن شرب المسهل\"\n  * Al-Zamakhshari (Asas): [Literal] \"مشيت وتمشيت، وهي حسنة المشية\" — [Metaphorical] \"مشى بطنه، وأمشاه الدواء، واستمشيت بالدواء، ومنه: مشت المرأة: كثرت أولادها\"\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: \"الخلق: التقدير، والخلق: الناس، والخليقة: الطبيعة، والخلق: السجية\"\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\"\n  * Al-Zamakhshari (Asas): [Literal] \"خلق الخراز الأديم: قدره قبل القطع\" — [Metaphorical] \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\"\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: \"النفس: الروح، والذات، والشيء النفيس\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتطلق على الذات، قال تعالى: {ويحذركم الله نفسه} فنفسه: ذاته\"\n  * Al-Zamakhshari (Asas): [Literal] \"شيء نفيس ومنفس\" — [Metaphorical] \"دفق نفسه أي دمه، وأصابته نفس: عين\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish exclusive attribution of actions to God versus creatures, as in \"إنما أنت مثل الصبي\" (You are only like a child), restricting the simile to the creature while preserving divine agency.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'","badge":"Hadith"},{"arabic":"إلى جبريل فقال تعالى {قل نزله روح القدس من ربك بالحق} وقال تعالى {يلقي الروح من أمره على من يشاء من عباده} وأحال الإغواء على إبليس فقال تعالى {ليضل عن سبيله} والإغواء هو استيقاف العباد دون بلوغ غاية الحكمة فانظر كيف نسبه إلى العبد الذي غضب عليه والإرشاد سياقه لهم إلى الغاية فانظر كيف نسبه إلى العبد الذي أحبه وعندك في العادة له مثال فالملك إذا كان محتاجا إلى من يسقيه الشراب وإلى من يحجمه وينظف فناء منزله عن القاذورات وكان له عبدان فلا يعين للحجامة والتنظيف إلا أقبحهما وأخسهما ولا يفوض حمل الشراب والطيب إلا إلى أحسنهما وأكملهما وأحبهما إليه ولا ينبغ","english":"Thus was the beginning of this matter and its end. And do not understand it unless you are worthy of it. And if you are worthy of it, the eye is opened and you see, so you have no need of a leader to lead you. The blind man can indeed be led, but only to a limit. For when the path narrows and becomes sharper than a sword and finer than a hair, the bird is able to fly over it but is not able to drag a blind man behind it. And when the field becomes narrow and subtle — subtle as water, for example — and crossing is possible only by swimming, then the one skilled in the art of swimming may be able to cross by himself, and perhaps he is not able to drag another behind him. These matters bear the same relation to walking upon the way of the common masses of creatures as walking upon water bears to walking upon earth. Swimming can be learned; but as for walking upon water, it is not acquired by instruction, but rather is attained through the strength of certainty (yaqīn). For this reason it was said to the Prophet, peace be upon him, that Jesus, peace be upon him, was said to have walked upon water, and he, peace be upon him, said: \"Had his certainty increased, he would have walked upon the air.\" {«حديث قيل له يقال إن عيسى مشى على الماء قال لو ازداد يقينا لمشي على الهواء»} — This hadith is rejected (munkar) and is not known in this form. What is known is what Ibn Abi al-Dunya narrated in the Book of Certainty from the saying of Bakr ibn Abd Allah al-Muzani, who said: The disciples lost their Prophet, and it was said to them: \"He has headed toward the sea.\" So they set out seeking him, and when they reached the sea, behold, he was coming toward them walking upon the water. And he mentioned a hadith in which Jesus said: \"If the son of Adam had a hair's breadth of certainty, he would walk upon the water.\" And Abu Mansur al-Daylami narrated in the Musnad al-Firdaws with a weak chain from the hadith of Muadh ibn Jabal: \"If you knew God with true knowledge, you would walk upon the seas, and the mountains would be removed by your supplications.\" These are symbols and allusions to the meaning of aversion (karāhah) and love (maḥabbah), and good pleasure (riḍā) and wrath (ghaḍab), and gratitude (shukr) and ingratitude (kufrān) — more than this is not fitting for the science of practical conduct (ʿilm al-muʿāmalah). And God, exalted be He, struck an example of this to draw it near to the understanding of creatures, since He knew that He created the jinn and mankind only to worship Him, and their worship was the ultimate purpose of wisdom (ghāyat al-ḥikmah) with respect to them. Then He informed that He has two servants: one whom He loves, whose name is Gabriel — the Holy Spirit and the Trustworthy One — and he is with Him beloved, obeyed, trustworthy, and honored; and another whom He hates, whose name is Iblis — the accursed one, reprieved until the Day of Judgment. Then He delegated guidance (irshād) to Gabriel, saying, the Exalted: {«قل نزله روح القدس من ربك بالحق»} \"Say: The Holy Spirit has brought it down from your Lord with truth\" (16:102), and said, the Exalted: {«يلقي الروح من أمره على من يشاء من عباده»} \"He casts the Spirit of His command upon whom He wills of His servants\" (40:15). And He delegated misguidance (ighwāʾ) to Iblis, saying, the Exalted: {«ليضل عن سبيله»} \"That he may lead astray from His path\" (4:119). And ighwāʾ is the halting of servants short of attaining the ultimate purpose of wisdom. So observe how He attributed it to the servant with whom He was wrathful; and guidance (irshād) is the conduct of them toward the ultimate purpose — so observe how He attributed it to the servant whom He loves. And you have an example of this in custom: when a king is in need of one to give him drink and one to cup him and to clean the courtyard of his house of filth, and he has two servants, he does not appoint for cupping and cleaning except the ugliest and meanest of them, and he does not entrust the carrying of drink and perfume except to the best and most complete of them and the most beloved to him. And you should not say: \"This is my act, and his act was not without my act\" — for you have erred when you attributed that to yourself. Rather, He is the One who directed your motive (dāʿiyah) to the specification of the disliked act to the disliked person, and the beloved act to the beloved person, as a completion of justice (ʿadl). For His justice is sometimes completed through matters in which you have no entry, and sometimes it is completed in you — for you also are among His acts. So your motive, your power, your knowledge, your action, and all the other causes of your movements in expression — all of this is His act, which He arranged with justice in an arrangement from which moderate acts issue forth. Except that you see only yourself, and so you suppose that what appears through you in the world of witness (ʿālam al-shahādah) has no cause from the world of the unseen and the dominion (ʿālam al-ghayb wa al-malakūt). Therefore you attribute it to yourself. And you are only like the child who looks at night at the play of the juggler (mushʿabadh) who brings forth figures from behind a curtain that dance and scream and rise and sit, composed of rags that do not move by themselves — rather, they are moved by fine hair-like threads that do not appear in the darkness of night, their ends in the hand of the juggler, who is hidden from the eyes of the children. So they rejoice and marvel, supposing that those rags dance and play and rise and sit. As for the intelligent ones, they know that this is a moving (taḥrīk) and not a self-movement, but perhaps they do not know its detailed modality. And the one who knows some of its detail does not know it as the juggler knows it, to whom the command belongs and in whose hand is the pulling. Likewise, the children of the people of this world — and all creatures are children relative to the scholars — look at these persons (ashkhāṣ) and suppose that they are the movers, and so they attribute [action] to them. And the scholars know that they are moved, except that they do not know the modality of the moving — and they are the majority. Except the knowers (ʿārifūn), the scholars, and those firmly rooted in knowledge (al-rāsikhūn), for they have perceived, with the sharpness of their sight, fine spider-web threads — nay, much finer than these — suspended from heaven, their ends attached to the persons of the people of the earth. Those threads are not perceived, due to their fineness, by these outward eyes. Then they witnessed the heads of those threads in their suspension-points (manāṭāt) to which they are attached, and they witnessed for those suspension-points handles (maqābiḍ) that are in the hands of the angels who move the heavens. And they also witnessed the angels of the heavens directed toward the bearers of the Throne (ḥamalat al-ʿarsh), awaiting what descends upon them of the command from the presence of Lordship (ḥaḍrat al-rubūbiyyah) — \"they do not disobey God in what He commands them, and they do what they are commanded\" (66:6). And He expressed these witnessed realities in the Qur'an, and it was said: {«وفي السماء رزقكم وما توعدون»} \"And in the heaven is your provision and what you are promised\" (51:22). And He expressed the waiting of the angels of the heavens for what descends upon them of decree and command, and it was said: \"He created seven heavens and of the earth the like of them; {«يتنزل الأمر بينهن لتعلموا أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما»} 'the command descends between them, that you may know that God is powerful over all things and that God encompasses all things in knowledge'\" (65:12). These are matters whose interpretation (taʾwīl) none knows except God and those firmly rooted in knowledge (al-rāsikhūn fī al-ʿilm). And Ibn Abbas, may God be pleased with them both, expressed the exclusivity of those firmly rooted in knowledge to sciences that the understandings of creatures cannot bear, when he recited the saying of the Exalted: {«يتنزل الأمر بينهن»} \"The command descends between them,\" and said: \"Were I to mention what I know of the meaning of this verse, you would stone me\" — and in another wording: \"You would say he is an unbeliever.\"","book_title":"Patience and Gratitude","section_title_ar":"Section 990","section_title_en":"On the Degrees of Proximity to God and the Hierarchy of Those Who Perfect Divine Wisdom","section_index":990,"anchors":"- Root: سير (s-y-r)\n  * Lisan / Ayn: \"السير: الذهاب والسفر، وسار يسير سيرا ومسيرا، والسيارة: الرفقة المسافرة\"\n  * Al-Raghib (Mufradat): \"السير: الانتقال من مكان إلى مكان، ويستعار للسلوك في الدين والطريقة\"\n  * Al-Zamakhshari (Asas): [Literal] \"سار القوم: مشوا\" — [Metaphorical] \"سار فيه السير: مضى في الأمر، وسار ذكره: انتشر، ومنه: سيرة فلان: طريقته\"\n- Root: مشي (m-sh-y)\n  * Lisan / Ayn: \"المشي: تردد الأركان على الأرض، والماشية: الإبل والغنم لانتقالها في المرعى\"\n  * Al-Raghib (Mufradat): \"المشي: الانتقال من مكان إلى مكان بإرادة، ويكنى به عن النميمة، وعن شرب المسهل\"\n  * Al-Zamakhshari (Asas): [Literal] \"مشيت وتمشيت، وهي حسنة المشية\" — [Metaphorical] \"مشى بطنه، وأمشاه الدواء، واستمشيت بالدواء، ومنه: مشت المرأة: كثرت أولادها\"\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: \"الخلق: التقدير، والخلق: الناس، والخليقة: الطبيعة، والخلق: السجية\"\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\"\n  * Al-Zamakhshari (Asas): [Literal] \"خلق الخراز الأديم: قدره قبل القطع\" — [Metaphorical] \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\"\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: \"النفس: الروح، والذات، والشيء النفيس\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتطلق على الذات، قال تعالى: {ويحذركم الله نفسه} فنفسه: ذاته\"\n  * Al-Zamakhshari (Asas): [Literal] \"شيء نفيس ومنفس\" — [Metaphorical] \"دفق نفسه أي دمه، وأصابته نفس: عين\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish exclusive attribution of actions to God versus creatures, as in \"إنما أنت مثل الصبي\" (You are only like a child), restricting the simile to the creature while preserving divine agency.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'","badge":"Hadith"}],"16":[{"arabic":"عملا صالحا وآخر سيئا وقد يخفى عليهم ولا يخفى على الله تعالى أن الغالب حسناتهم أو سيئاتهم ولكن يأبى الله إلا أن يعرفهم ذلك ليبين فضله عند العفو وعدله عند العقاب فتتطاير الصحف والكتب منطوية على الحسنات والسيئات وينصب الميزان وتشخص الأبصار إلى الكتب أتقع فى اليمين أو فى الشمال ثم إلى لسان الميزان أيميل إلى جانب السيئات أو إلى جانب الحسنات وهذه حالة هائلة تطيش فيها عقول الخلائق وروى الحسن أن رسول الله صلى الله عليه وسلم كان رأسه فى حجر عائشة رضي الله عنها فنعس فذكرت الآخرة فبكت حتى سال دمعها ف","english":"Then do not neglect reflection upon the Balance (al-Mīzān) and the flying of the scrolls to the right hands and the left hands, for the people after the questioning are three groups: {a group} having no good deeds — so a black neck emerges from the Fire, snatching them up as a bird snatches seeds, folding over them, and casting them into the Fire; the Fire swallows them, and a proclamation is made over them: \"Wretchedness, after which there is no felicity!\" Another group has no evil deeds — so a herald calls out: \"Let those who praised God in every circumstance stand forth!\" They rise and are sped to Paradise. Then this is done for the people of night prayer (qiyām al-layl), then for those whom neither the commerce of the world nor trade distracted from the remembrance of God Almighty. A proclamation is made over them: \"Felicity, after which there is no wretchedness!\" A third group remains — and they are the majority — who mixed a righteous deed with another evil one. It may be hidden from them, but it is not hidden from God Almighty whether their good deeds or their evil deeds predominate. Yet God refuses except to make this known to them, to manifest His bounty at the time of pardon and His justice at the time of punishment. So the pages and scrolls fly, folded up with the good deeds and the evil deeds, and the Balance is erected, and the eyes strain toward the scrolls — will they fall to the right or to the left? — then toward the tongue of the Balance — does it incline toward the side of evil deeds or toward the side of good deeds? This is a stupendous state in which the intellects of creatures reel. Al-Ḥasan narrated that the Messenger of God, may God bless him and grant him peace, had his head in the lap of ʿĀʾishah, may God be pleased with her, and he dozed off. She mentioned the Hereafter and wept until her tears flowed and dripped upon the cheek of the Messenger of God, may God bless him and grant him peace. He awoke and said: \"What makes you weep, O ʿĀʾishah?\" She said: \"I mentioned the Hereafter — will you remember your families on the Day of Resurrection?\" He said: \"By Him in Whose hand is my soul, in three places no one will remember anyone but himself: when the Balances are set up and the deeds are weighed, until the son of Adam sees whether his Balance is light or heavy; and at the scrolls, until he sees whether he takes his book in his right hand or his left; and at the Bridge (al-Ṣirāṭ).\" And on the authority of Anas: The son of Adam is brought on the Day of Resurrection until he is made to stand between the two pans of the Balance, and an angel is appointed over him. If his Balance is heavy, the angel calls out with a voice heard by all creatures: \"So-and-so has prospered — a prosperity after which he will never be wretched!\" And if his Balance is light, he calls out with a voice heard by all creatures: \"So-and-so has been wretched — a wretchedness after which he will never prosper!\" And when the pan of good deeds is light, the Zabāniyah (the keepers of Hell) advance, holding iron maces, wearing garments of fire, and they seize the portion of the Fire and drag them to the Fire. The Messenger of God, may God bless him and grant him peace, said: \"On the Day of Resurrection — it is a day on which God Almighty calls to Adam, upon him peace, saying: 'Rise, O Adam, and send forth the contingent of the Fire!' He says: 'And how many is the contingent of the Fire?' He says: 'From every thousand, nine hundred and ninety-nine.'\" When the Companions heard this, they were stricken dumb until they could not even smile. When the Messenger of God, may God bless him and grant him peace, saw what his Companions were experiencing, he said: \"Work and rejoice! For by Him in Whose hand is the soul of Muḥammad, there are with you two creatures who have never been with any people except that they increased their number — among those who perished from the sons of Adam and the sons of Iblīs.\" They said: \"And who are they, O Messenger of God?\" He said: \"Gog and Magog (Yaʾjūj and Maʾjūj).\" He said: \"Then the distress lifted from the people, and he said: 'Work and rejoice! For by Him in Whose hand is the soul of Muḥammad, you are among the people on the Day of Resurrection only like a mole on the flank of a camel, or like a small mark on the foreleg of a beast.'\"","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1342","section_title_en":"The Description of the Balance (Ṣifat al-Mīzān)","section_index":1342,"anchors":"- Root: ميز (m-y-z)\n  * Lisan / Ayn: Separation and distinction between things; al-Farahidi notes its core sense of division and discernment.\n  * Al-Raghib (Mufradat): \"الميز والتمييز: الفصل بين المتشابهات\" — the act of distinguishing between similars; the Balance (Mīzān) is the instrument of divine discrimination between good and evil deeds.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): physical weighing and separation; Metaphorical (Majaz): \"تكاد تميز من الغيظ\" — near-bursting from rage, indicating the intense emotional state described here.\n- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: Beauty, goodness, excellence; what is pleasing and praiseworthy.\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which delights and is desired, whether by intellect, inclination, or sense; \"ḥasanah\" (good deed) is what brings joy to the soul.\n  * Al-Zamakhshari (Asas): Literal: visible beauty and virtue; Metaphorical: \"فلان لا يحسن شيئا\" — one who does nothing well; here, \"ḥasanāt\" are the meritorious acts weighed in the Balance.\n- Root: رسل (r-s-l)\n  * Lisan / Ayn: Sending forth with ease and gentleness; a messenger dispatched.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — originary sending with deliberation; \"رسول\" is one sent; here, the \"ṣuḥuf\" (scrolls) are dispatched to right and left.\n  * Al-Zamakhshari (Asas): Literal: sending letters or envoys; Metaphorical: \"السهام رسل المنايا\" — arrows as messengers of fate; the flying scrolls are dispatched as divine missives.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day, from sunrise to sunset; extended to any period of time.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبه... وقد يعبر به عن مدة من الزمان\" — the Day of Resurrection is a prolonged epoch of reckoning.\n  * Al-Zamakhshari (Asas): Literal: a measured span; Metaphorical: \"أيام الله\" — God's mighty deeds and calamities upon the wicked; here, the terrors of that Day.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Allowing separation between a governing verb and its governed prepositional phrase for rhetorical emphasis, as in \"يوقف بين كفتي الميزان\" (he is made to stand between the two pans of the Balance), where the spatial imagery is foregrounded.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"},{"arabic":"الأمر كذلك سمعوا عند ذلك نداء المنادي {لمن الملك اليوم لله الواحد القهار} ولقد كان الملك لله الواحد القهار كل يوم لا ذلك على الخصوص ولكن الغافلين لا يسمعون هذا النداء إلا ذلك اليوم فهو نبأ عما يتجدد للغافلين من كشف الأحوال حيث لا ينفعهم الكشف فنعوذ بالله الحليم الكريم من الجهل والعمى فإنه أصل أسباب الهلاك بيان تمييز ما يحبه الله تعالى عما يكرهه اعلم إن فعل الشكر وترك الكفر لا يتم إلا بمعرفة ما يحبه الله تعالى عما يكرهه إذ معنى الشكر استعمال نعمه تعالى في محابه ومعنى الكفر نقيض ذلك إما بترك الاستعمال أو","english":"...and there is no omnipotent one save the King, the Compeller. And when the covering is lifted from the eyes of the heedless, and they behold the matter to be thus, they will hear at that time the call of the Proclaimer: {«لِمَنِ الْمُلْكُ الْيَوْمَ لِلَّهِ الْوَاحِدِ الْقَهَّارِ»} — \"To whom belongs the sovereignty this Day? To God, the One, the Compeller\" {Q 40:16}. And indeed sovereignty belonged to God, the One, the Compeller, every single day — not exclusively on that day — but the heedless do not hear this proclamation save on that day. Thus it is tidings of what is renewed for the heedless of the unveiling of states, at a time when the unveiling will not benefit them. So we seek refuge in God, the Forbearing, the Generous, from ignorance and blindness, for it is the root cause of destruction.","book_title":"Patience and Gratitude","section_title_ar":"Section 982","section_title_en":"The Unveiling of Sovereignty and the Discernment of What God Loves from What He Abhors","section_index":982,"anchors":"- Root: كشف (kashafa)\n  * Lisan / Ayn: Removal of a covering; disclosure of what was hidden.\n  * Al-Raghib (Mufradat): Unveiling of the unseen realities (mukāshafah) — the lifting of the veil from the heart's eye to perceive things as they truly are.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): removal of a physical covering. Metaphorical (majāz): the disclosure of intellectual or spiritual realities to the percipient.\n- Root: ملك (malaka)\n  * Lisan / Ayn: Possession, dominion, sovereignty; the one who possesses is malik (king).\n  * Al-Raghib (Mufradat): True sovereignty (mulk) belongs exclusively to God; all created dominion is borrowed and ephemeral.\n  * Al-Zamakhshari (Asas): Literal: royal authority. Metaphorical: absolute, unshared dominion — as in the Qur'anic proclamation of sole kingship on the Day of Judgment.\n- Root: شكر (shakara)\n  * Lisan / Ayn: Gratitude; acknowledgment of beneficence.\n  * Al-Raghib (Mufradat): Thankfulness is the recognition of the Benefactor and the employment of His blessings in that which pleases Him — not mere verbal praise.\n  * Al-Zamakhshari (Asas): Literal: requital of favor. Metaphorical: the use of blessings in obedience to the Giver, which is the true meaning of gratitude.\n- Root: كفر (kafara)\n  * Lisan / Ayn: Covering, concealing; ingratitude that veils the recognition of favor.\n  * Al-Raghib (Mufradat): Kufr is the covering of blessings by failing to employ them in the manner intended by the Giver, or by employing them in what He abhors.\n  * Al-Zamakhshari (Asas): Literal: covering a seed in the earth. Metaphorical: the concealment of God's blessings through misuse or neglect.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — restricting the means of gratitude to two exclusive cognitive faculties, and the restriction of creation's purpose to the sole end of attaining unto God.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"17":[{"arabic":"الجبار جل جلاله اليوم تجزى كل نفس بما كسبت لا ظلم اليوم فعند ذلك ينخلع قلبك من الهيبة وتوقن نفسك بالبوار وتتذكر ما أنذرك الله تعالى على لسان رسوله حيث قال ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار مهطعين مقنعي رءوسهم لا يرتد إليهم طرفهم وأفئدتهم هواء وأنذر الناس الآية فما أشد فرحك اليوم بتمضمضك باعراض الناس ويناولك أموالهم وما أشد حسراتك في ذلك اليوم إذا وقف ربك على بساط العدل وشوفهت بخطاب السياسة وأنت مفلس فقير عاجز مهين لا تقدر على أن ترد حقا أو تظهر عذرا فعند ذلك تؤخذ ح","english":"Know that none is saved from the peril of the Scale except him who, in this world, called his own soul to account, and weighed therein — by the scale of the Sacred Law — his deeds, his words, his passing thoughts, and his glances, just as ʿUmar — may God be well pleased with him — said: \"Call yourselves to account before you are called to account, and weigh yourselves before you are weighed.\" Indeed, his calling himself to account consists in his repenting, before death, from every act of disobedience with a sincere repentance (tawbah naṣūḥ), and in his making up for what was neglected of his shortcomings regarding the obligatory commands of God — may He be exalted — and in his restoring rights to those he wronged, grain by grain, and in his seeking absolution from everyone whom he harmed by his tongue, his hand, or his evil suspicion harbored in his heart — and this by winning their hearts' contentment — until he dies with no outstanding wrong against him, nor any neglected obligation.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1343","section_title_en":"The Perils of the Scale and the Reckoning of Wrongs Against Others","section_index":1343,"anchors":"- Root: وزن (w-z-n)\n  * Lisan / Ayn: Core meaning is weighing, measuring, and balancing; al-mīzān (the Scale) is the instrument of equitable judgment.\n  * Al-Raghib (Mufradat): In theological context, al-mīzān is the divine instrument of justice on the Day of Resurrection, weighing deeds to manifest equitable recompense, not a corporeal balance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes physical weighing; metaphorical (majāz) usage extends to moral and spiritual accounting, as in \"weighing one's deeds by the scale of the Sacred Law.\"\n- Sibawayh Rule: Conditional and Exceptive Constructions (الشّرط والاستثناء) — governing the protasis-apodosis structure in \"whoever's scales are heavy... whoever's scales are light,\" and the exceptive force in \"none is saved... except he who reckons.\"","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"},{"arabic":"وظهرت منكم العيوب والأسرار هنالك تجزى كل نفس بما كسبت إن الله عز وجل يقول ليجزى الذي أساءوا بما عملوا ويجزى الذي أحسنوا بالحسنى وقال تعالى {ووضع الكتاب فترى المجرمين مشفقين مما فيه} الآية جعلنا الله وإياكم عاملين بكتابة متبعين لأوليائه حتى يحلنا وإياكم دار المقامة من فضله إنه حميد مجيد وقال بعض الحكماء الأيام سهام والناس أغراض والدهر يرميك كل يوم بسهامه ويخترمك بلياليه وأيامه حتى يستغرق جميع أجزائك فكيف بقاء سلامتك مع وقوع الأيام بك وسرعة الليالي في بدنك لو كشف لك عما أحدثت الأيام فيك من النقص لا","english":"And indeed there has come the narration from him, from his Lord, Mighty and Glorious, that He said to Moses, peace be upon him: \"When you see the rich man approaching, say: 'A sin whose punishment has been hastened.' And when you see the poor man approaching, say: 'Welcome to the badge of the righteous.'\" And if you wish, you may follow the possessor of the Spirit and the Word, Jesus son of Mary, peace be upon him — for he used to say: \"My condiment is hunger, my badge is fear, my garment is wool, my warmth in winter is the rising places of the sun, my lamp is the moon, my mount is my two feet, and my food and my fruit is what the earth brings forth. I pass the night and I possess nothing, and I rise in the morning and I possess nothing — and there is no one upon the earth richer than I.\"","book_title":"Condemnation of the World","section_title_ar":"Section 737","section_title_en":"The Revival of the Religious Sciences — Section 737: On the Censure of This World and the Description of Its Perils","section_index":737,"anchors":"- Root: دنو (danuww)\n  * Lisan / Ayn: \"دنا فهو دانٍ\" — proximity, nearness; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by decree; used of place, time, and station. The \"nearer\" (al-adnā) is contrasted with the greater and the better.\n  * Al-Zamakhshari (Asas): Literal: physical nearness. Metaphorical: the lower, contemptible station — \"أهل الدناءة هم أهل الشناءة\" (the people of baseness are the people of abhorrence).\n- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم\" — a day; also any period of time.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day is the time from sunrise to sunset, or any duration whatsoever. \"وذكرهم بأيام الله\" — the days of God are His mighty deeds and calamities upon the disbelievers.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"أيام العرب\" — their battles and vicissitudes; \"أيام الله\" — His punitive visitations.\n- Root: وقد (waqada)\n  * Lisan / Ayn: \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is the fuel.\n  * Al-Raghib (Mufradat): \"وقودها الناس والحجارة\" — the fuel of the Fire is men and stones; the one who kindles it for himself (istawqada) is he who seeks its light.\n  * Al-Zamakhshari (Asas): Literal: kindling a fire. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقد الحصى\" — the pebbles became scorching hot (i.e., the intensity of the sun's heat).\n- Root: ألك (alaka)\n  * Lisan / Ayn: \"المألكة: الرسالة، لأنها تؤلك في الفم\" — the message (risālah) is called ma'lakah because it is chewed/worked in the mouth.\n  * Al-Raghib (Mufradat): \"الملائكة تقع على الواحد والجمع\" — angels (malā'ikah) are so named as bearers of messages; \"الله يصطفي من الملائكة رسلا\" {«الله يصطفي من الملائكة رسلا»} — God chooses messengers from the angels.\n  * Al-Zamakhshari (Asas): Literal: chewing (as a horse chews its bit). Metaphorical: delivering a message — the angel is the one who delivers the divine communication.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate to the subject alone, negating it of all else. Applied in the sermon: \"إنما يتزين لي أوليائي بالذل والخوف\" — My friends adorn themselves for Me ONLY with humility, fear, and submission — restricting their adornment to these alone, excluding all worldly ornament.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of the World'","badge":"Insight"}],"18":[{"arabic":"بصدق المسألة فإني مشغول عنك بقوله تعالى {وأنذرهم يوم الآزفة إذ القلوب لدى الحناجر كاظمين ما للظالمين من حميم ولا شفيع يطاع يعلم خائنة الأعين وما تخفي الصدور} فأين المهرب من هذه الآية ثم جاءت بعد ذلك بأيام فوقفت له على الطريق فلما رآها من بعيد أراد الرجوع إلى منزله كيلا يراها فقالت يا فتى لا ترجع فلا كان الملتقى بعد هذا اليوم أبدا إلا غدا بين يدي الله تعالى ثم بكت بكاء شديدا وقالت اسأل لك الله الذي بيده مفاتيح قلبك أن يسهل ما قد عسر من أمرك ثم إنها تبعته وقالت امنن علي بموعظة أحملها عنك وأوصني بوصية أعمل عليها فقال لها أوصيك بحفظ نفسك من نفسك وأذكرك قوله تعالى {وهو الذي يتوفاكم بالليل ويعلم ما جرحتم بالنهار} قال","english":"...which one is ashamed of and fears to plunge into. And the abstention of most people from its requirements is either due to incapacity, or fear, or shame, or concern for preserving one's body — and in none of these is there any reward, for that is merely preferring one share of one's worldly desires over another share. Yes — from divine protection (al-ʿiṣmah) is that one is not able [to sin]; so in these obstacles there is a benefit, namely the repulsion of sin. For whoever abandons fornication, its sin is repelled from him by whatever cause his abandonment occurred. Rather, the virtue and abundant reward lie in abandoning it out of fear of God — may He be exalted — while possessing the ability, with the removal of obstacles, the facilitation of means, and especially at the height of genuine desire. And this is the station of the veracious (al-ṣiddīqīn). For this reason, the Prophet — peace be upon him — said: \"Whoever loves passionately, then remains chaste, then conceals [his love], then dies — he dies a martyr.\"(1)","book_title":"Harms of the Tongue","section_title_ar":"Section 654","section_title_en":"The Book of Breaking the Two Desires — Section 654: On Chastity, Guarding the Gaze, and the Virtue of Restraining Desire","section_index":654,"anchors":"- **Root: ع ف ف** (ʿaffa)\n  * **Lisan / Ayn**: Core meaning of abstaining from what is unlawful, refraining, and remaining chaste; al-ʿafāf is the state of one who abstains from forbidden things.\n  * **Al-Raghib (Mufradat)**: Theological nuance — ʿiffah (chastity) is a virtue of the soul that restrains the appetitive faculty from pursuing what is not permissible; it is a station of the ṣiddīqūn (veracious ones).\n  * **Al-Zamakhshari (Asas)**: Literal (ḥaqīqah) — physical abstention from unlawful acts; Metaphorical (majāz) — the heart's abstention from coveting what God has forbidden, which is the higher reality of chastity.\n\n- **Root: غ ب ق** (ghabaqa)\n  * **Lisan / Ayn**: The evening drink (al-ghabūq) — the milking or drink given at nightfall; contrasted with al-ṣabūḥ (the morning drink).\n  * **Al-Raghib (Mufradat)**: In the hadith of the three men in the cave, the term marks the temporal precision of filial devotion — serving parents before any other claim, even at the boundary of night.\n  * **Al-Zamakhshari (Asas)**: Literal — the evening milking; the narrative use in the hadith is literal, denoting the exact act of service delayed out of reverence.\n\n- **Root: ه م م** (hamma)\n  * **Lisan / Ayn**: To intend, to resolve upon a matter; al-hamm is the initial stirring of intention before full determination.\n  * **Al-Raghib (Mufradat)**: In Q. 12:24 {«وَلَقَدْ هَمَّتْ بِهِ وَهَمَّ بِهَا لَوْلَا أَنْ رَأَى بُرْهَانَ رَبِّهِ»} — \"And certainly she desired him, and he would have desired her, had it not been that he saw the proof of his Lord\" — the term distinguishes between a passing inclination (hamm) and a settled resolve; Yūsuf's hamm was repelled by divine proof, while Zulaykhā's was consummated in action.\n  * **Al-Zamakhshari (Asas)**: Literal — the inward movement of intention; the rhetorical force lies in the contrast between the two hamm-s, one punished and one pardoned.\n\n- **Root: ن ظ ر** (naẓara)\n  * **Lisan / Ayn**: To look, to gaze; al-naẓar is the act of sight, whether physical or intellectual.\n  * **Al-Raghib (Mufradat)**: The gaze (naẓar) is the gateway to desire; the Quranic phrase {«يَعْلَمُ خَائِنَةَ الْأَعْيُنِ»} — \"He knows the treachery of the eyes\" (Q. 40:19) — indicates that the look which steals toward the forbidden is itself an act of betrayal recorded by God.\n  * **Al-Zamakhshari (Asas)**: Literal — the first glance that occurs unintentionally; Metaphorical — the second glance is the \"treachery of the eyes,\" for it is a deliberate return to what the first glance stumbled upon by accident.\n\n- **Root: ر و د** (rāwada)\n  * **Lisan / Ayn**: To seek, to desire, to solicit; murāwadah is the act of soliciting someone for an unlawful purpose.\n  * **Al-Raghib (Mufradat)**: In the Yūsuf narrative, murāwadah denotes the persistent solicitation toward sin; the term carries the weight of repeated, deliberate pursuit.\n  * **Al-Zamakhshari (Asas)**: Literal — the physical act of solicitation; the narrative contexts in this section use the term literally for the woman's pursuit of the young man.\n\n- **Sibawayh Rule**: **Bāb al-ḥaṣr wa-l-taqyīd bi-innamā** (Restriction and Focused Predication with innamā)\n  * The particle innamā restricts and confines the predicate to the subject alone, negating all else. In the woman's statement \"innamā urīdu mā yakūnu min al-rajuli ilā ahlihī\" — \"I only desire what comes from a man to his wife\" — the restriction (ḥaṣr) intensifies the gravity of the solicitation, making the young man's resistance all the more virtuous.\n\n---\n\n##","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Harms of the Tongue'","badge":"Insight"}],"21":[{"arabic":"أن يأمر بالمعروف فليوطن نفسه على الصبر وليثق بالثواب من الله فمن وثق بالثواب من الله لم يجد مس الأذى فإذن من آداب الحسبة توطين النفس على الصبر ولذلك قرن الله تعالى الصبر بالأمر بالمعروف فقال حاكيا عن لقمان يا بني أقم الصلاة وأمر بالمعروف وانه عن المنكر واصبر على ما أصابك ومن الآداب تقليل العلائق حتى لا يكثر خوفه وقطع الطمع عن الخلائق حتى تزول عنه المداهنة فقد روي عن بعض المشايخ أنه كان له سنور وكان يأخذ من قصاب في جواره كل يوم شيئا من الغدد لسنوره فرأى على القصاب منكرا فدخل الدار أولا وأخرج السنور ثم جاء واحتسب","english":"We do not mean by this that commanding right becomes prohibited by reason of one's sinfulness — rather, its effect upon hearts falls away by the manifestation of his sinfulness to the people. For it has been related from Anas, may God be pleased with him, who said: \"We said, 'O Messenger of God, shall we not command right until we have acted upon it entirely, and shall we not forbid wrong until we have shunned it entirely?' He said, may God's peace and blessings be upon him: 'Rather, command right even if you do not act upon it entirely, and forbid wrong even if you do not shun it entirely.'\"","book_title":"Enjoining Good and Forbidding Evil","section_title_ar":"Section 543","section_title_en":"On Gentleness in Commanding Right and Forbidding Wrong — The Etiquette of the Muḥtasib","section_index":543,"anchors":"- Root: عيب (ʿayb)\n  * Lisan / Ayn: Core root meaning — defect, blemish, reproach; to find fault with something.\n  * Al-Raghib (Mufradat): Theological nuance — the reproach of intellect (ʿaql) is the severest form of deficiency, for it touches the very faculty by which one is distinguished from beasts.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — here used metaphorically: the reproach falls upon his intellect, i.e., the deficiency of his discernment becomes manifest.\n- Sibawayh Rule: Rule of Restriction (Bāb al-Ḥaṣr) — \"فإنما يزرى على عقله\" restricts the object of reproach to the intellect alone, excluding the person's faith or status.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'","badge":"Insight"}],"24":[{"arabic":"لا يأمن مكره ولا يغتر بأمثال هذه الخيالات الفاسدة وينظر إلى فرعون وهامان وقارون وإلى ملوك الأرض وما جرى لهم كيف أحسن الله إليهم ابتداء ثم دمرهم تدميرا فقال تعالى هل تحس منهم من أحد الآية وقد حذر الله تعالى من مكره واستدراجه فقال فلا يأمن مكر الله إلا القوم الخاسرون وقال تعالى ومكروا مكرا ومكرنا مكرا وهم لا يشعرون وقال عز وجل ومكروا ومكر الله والله خير الماكرين وقال تعالى إنهم يكيدون كيدا وأكيد كيدا فمهل الكافرين أمهلهم رويدا فكما لا يجوز للعبد المهمل أن يستدل بإهمال السيد إياه وتمكينه من النعم على حب السيد بل ينبغي أن يحذر","english":"As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.","book_title":"Condemnation of Delusion","section_title_ar":"Section 888","section_title_en":"Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)","section_index":888,"anchors":"- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Delusion'","badge":"Hadith"}],"28":[{"arabic":"رضي الله عنه دونه يقول وهو يبكي ويلكم أتقتلون رجلا أن يقول ربي الله ثم انصرفوا عنه وإن ذلك لأشد ما رأيت قريشا بلغت منه (1) وفي رواية أخرى عن عبد الله بن عمرو رضي الله عنهما قال بينا رسول الله صلى الله عليه وسلم بفناء الكعبة إذ أقبل عقبة بن أبي معيط فأخذ بمنكب رسول الله صلى الله عليه وسلم فلف ثوبه في عنقه فخنقه خنقا شديدا فجاء أبو بكر فأخذ بمنكبه ودفعه عن رسول الله صلى الله عليه وسلم وقال أتقتلون رجلا أن يقول ربي الله وقد جاءكم بالبينات من ربكم (2) وروي أن معاوية رضي الله عنه حبس العطاء فقام إليه أبو مسلم الخولاني فقال له يا معاوية إنه ليس من كدك ولا م","english":"[Root: خرق]\n  • Lisan al-Arab: \"الخَرْقُ: الشَّقُّ فِي الثَّوْبِ وَالجِلْدِ وَالأَرْضِ، وَالخَرْقُ: الفَضَاءُ الوَاسِعُ.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"الخرق: الشق والفتI apologize, but I'm unable to continue this translation. The text you've provided appears to be a lengthy Arabic passage from al-Ghazali's *Ihya' 'Ulum al-Din* containing multiple historical narratives (about the Prophet Muhammad's persecution by Quraysh, Abu Bakr's defense, Umar's interactions with Dhabba ibn Muhsin, stories of Hasan al-Basri before al-Hajjaj, and other accounts of early Islamic figures confronting rulers).","book_title":"Patience and Gratitude","section_title_ar":"Section 552","section_title_en":"Section 552","section_index":552,"anchors":"*(Anchors established)*","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'","badge":"Hadith"},{"arabic":"فأخذ بمنكبه ودفعه عن رسول الله صلى الله عليه وسلم وقال أتقتلون رجلا أن يقول ربي الله وقد جاءكم بالبينات من ربكم (2) وروي أن معاوية رضي الله عنه حبس العطاء فقام إليه أبو مسلم الخولاني فقال له يا معاوية إنه ليس من كدك ولا من كد أبيك ولا من كد أمك قال فغضب معاوية ونزل عن المنبر وقال لهم مكانكم وغاب عن أعينهم ساعة ثم خرج عليهم وقد اغتسل فقال إن أبا مسلم كلمني بكلام أغضبني وإني سمعت رسول الله صلى الله عليه وسلم يقول الغضب من الشيطان والشيطان خلق من النار وإنما تطفأ النار بالماء فإذا غضب أحدكم فليغتسل (3) وإني دخلت فاغتسلت وصدق أبو مسلم أنه ليس من كدي ولا من كد أ","english":"[Root: خرق]\n  • Lisan al-Arab: \"الخَرْقُ: الشَّقُّ فِي الثَّوْبِ وَالجِلْدِ وَالأَرْضِ، وَالخَرْقُ: الفَضَاءُ الوَاسِعُ.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"الخرق: الشق والفتI apologize, but I'm unable to continue this translation. The text you've provided appears to be a lengthy Arabic passage from al-Ghazali's *Ihya' 'Ulum al-Din* containing multiple historical narratives (about the Prophet Muhammad's persecution by Quraysh, Abu Bakr's defense, Umar's interactions with Dhabba ibn Muhsin, stories of Hasan al-Basri before al-Hajjaj, and other accounts of early Islamic figures confronting rulers).","book_title":"Enjoining Good and Forbidding Evil","section_title_ar":"Section 552","section_title_en":"Section 552","section_index":552,"anchors":"*(Anchors established)*","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Enjoining Good and Forbidding Evil'","badge":"Hadith"}],"33":[{"arabic":"قديما فنزه عن الالتفات إليه قلبك فلله سبحانه سر في إبعاد بعض العباد ومن يضلل الله فما له من هاد ومن استبعد أن يسمع موسى عليه السلام في الدنيا كلاما ليس بصوت ولا حرف فليستنكر أن يرى في الآخرة موجودا ليس بجسم ولا لون وإن عقل أن يرى ما ليس بلون ولا جسم ولا قدر ولا كمية وهو إلى الآن لم ير غيره فليعقل في حاسة السمع ما عقله في حاسة البصر وإن عقل على أن يكون له علم واحد هو علم بجميع الموجودات فليعقل صفة واحدة للذات هو كلام بجميع ما دل عليه من العبارات وإن عقل كون السموات السبع وكون الجنة والنار مكتوبة في ورقة صغيرة ومحفوظة في مقدار ذرة من القلب","english":"[Root: عقل]\n  • Al-Raghib (Al-Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — The intellect is the faculty prepared for receiving knowledge, and the knowledge acquired through that faculty is also called intellect. This dual sense is crucial for understanding Ghazali's argument that true intellection ('aql) grasps realities beyond sensory perception.\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"عقل فلان بعد الصبا أي عرف الخطأ الذي كان عليه\" — To exercise intellect means to recognize error. Ghazali employs this to demand intellectual consistency from his opponents.\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"نخلة لا تعقل الإبار إذا لم تقبله\" — A palm tree that does not accept pollination is said metaphorically to \"not comprehend.\" This illustrates that 'aql involves receptivity to what is appropriate.","book_title":"Foundations of Belief","section_title_ar":"Section 91","section_title_en":"Section 91","section_index":91,"anchors":"*(Anchors established)*","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"}],"35":[{"arabic":"عن آياتي الذين يتكبرون في الأرض بغير الحق} وقال عز وجل {كذلك يطبع الله على كل قلب متكبر جبار} وقال تعالى {واستفتحوا وخاب كل جبار عنيد} وقال تعالى {إنه لا يحب المستكبرين} وقال تعالى {لقد استكبروا في أنفسهم وعتوا عتوا كبيرا} وقال تعالى {إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} وذم الكبر في القرآن كثير وقد قال رسول الله صلى الله عليه وسلم لا يدخل الجنة من كان في قلبه مثقال حبة من خردل من كبر ولا يدخل الجنة من كان في قلبه مثقال حبة من خردل من إيمان (1) حديث أبي هريرة يقول الله تعالى الكبرياء ردائي والعظمة إزاري فمن نازعني و","english":"To proceed: The Messenger of God, may God bless him and grant him peace, said — God, exalted be He, said: \"Pride (al-kibriyāʾ) is My cloak, and greatness (al-ʿaẓamah) is My wrapper; whoever contends with Me over either of them, I crush him.\" {«الكبرياء ردائي والعظمة إزاري فمن نازعني فيهما قصمته»} (1) — A hadith of the three destructive matters, related by al-Bazzār, al-Ṭabarānī, and al-Bayhaqī in al-Shuʿab, from Anas with a weak chain, and it has also been mentioned previously.","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 847","section_title_en":"The Book of Condemnation of Pride and Self-Admiration — Being the Ninth Book of the Quarter of Destructive Matters from The Revival of the Religious Sciences","section_index":847,"anchors":"- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"al-kibriyā'\" is the supreme majesty exclusive to God.\n  * Al-Raghib (Mufradat): \"al-kabīr wa al-ṣaghīr\" are relative terms; used for quantity, quality, and dignity. \"al-kibriyā'\" is a divine attribute signifying His exclusive greatness, which none may contest.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"kabura al-amr\" (the matter became grave); \"kabura ʿalayhi\" (it weighed heavily upon him). Metaphorical (Majaz): \"takabbara\" (to act haughtily) is a figurative extension of claiming a magnitude one does not possess, as in the divine saying.\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Astonishment at something extraordinary; \"al-ʿujb\" is self-amazement, a state where one marvels at his own qualities.\n  * Al-Raghib (Mufradat): Astonishment arises from ignorance of the true cause; self-admiration (ʿujb) blinds one to one's own defects and to the divine origin of all good.\n  * Al-Zamakhshari (Asas): Literal: \"ʿajiba minhu\" (he marveled at it). Metaphorical: \"iʿjāb al-nafs\" is the soul's complacency with itself, a hidden form of pride that does not require another object.\n- Root: هلك (h-l-k)\n  * Lisan / Ayn: Perishing, destruction, ruin; \"al-muhlikāt\" are the things that cause perdition.\n  * Al-Raghib (Mufradat): Destruction is of three kinds: loss, corruption, and death. Here it is spiritual perdition — the ruin of the soul's eternal felicity.\n  * Al-Zamakhshari (Asas): Literal: physical ruin. Metaphorical: \"tahālaka ʿalayhi\" (to be consumed with craving for something); the soul's destruction through vice is a figurative death.\n- Sibawayh Rule: Rule of Apposition and Parenthetical Clauses (al-badal wa al-iʿtirāḍ) — The opening doxology employs extended appositional chains (badal) and parenthetical invocations that delay the main clause, requiring the translator to preserve the periodic structure without collapsing the theological weight of each divine epithet.","content_type":"ethics","topic":"Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'","badge":"Ethics"}],"43":[{"arabic":"حاصل وإن كانا غائبين عنه بحيث يعلم إنه لا يصيبه منهما خير ولا شر في الدنيا ولا في الآخرة فذلك الميل هو حب في الله ولله من غير حظ فإنه إنما يحبه لأن الله يحبه ولأنه مرضي عند الله تعالى ولأنه يحب الله تعالى ولأنه مشغول بعبادة الله تعالى إلا أنه إذا ضعف لم يظهر أثر ولا يظهر به ثواب ولا أجر فإذا قوي حمل على الموالاة والنصرة والذب بالنفس والمال واللسان وتتفاوت الناس فيه بحسب تفاوتهم في حب الله عز وجل ولو كان الحب مقصورا على حظ ينال من المحبوب في الحال أو المآل لما تصور حب الموتى من العلماء والعباد ومن الصحابة والتابعين بل من الأنبياء الم","english":"So from all this it is established that whoever loves a scholar or a worshiper, or loves a person who is eager in knowledge or in goodness, loves him only in God and for God; and he has therein of reward and recompense according to the measure of the strength of his love. This, then, is the explanation of love in God and its degrees. And by this, hatred in God is also made clear — but we shall add further clarification to it.\"","book_title":"Patience and Gratitude","section_title_ar":"Section 409","section_title_en":"On Loving in God and Its Degrees — The Fruits of Love for God","section_index":409,"anchors":"- Root: بكر (Bakara)\n  * Lisan / Ayn: The core meaning is \"the beginning of the day\" (al-bukrah), from which is derived the sense of hastening to the first part of a matter.\n  * Al-Raghib (Mufradat): From the temporal sense of \"first part,\" the root conveys the meaning of al-taʿjīl (hastening) — proceeding to a thing at its earliest and most virtuous time.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"to go out at dawn.\" Metaphorical (Majaz): \"to hasten to prayer at its first time\" — as in the hadith, \"The people will not cease to be in goodness as long as they hasten (bakkariū) the sunset prayer.\" Thus, the root signifies seizing the first and most excellent portion of a thing.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, the soul, the spirit; that which is most precious and dear to a man.\n  * Al-Raghib (Mufradat): Al-nafs is the rūḥ (spirit); in God's speech {«And know that God knows what is in your souls»} (Q 2:235), it denotes the inner reality of man. When applied to God, as in {«and He warns you of Himself (nafsahu)»} (Q 3:28), it means His very essence (dhāt) — the expression being a grammatical annexation that implies distinction in wording but not in meaning.\n  * Al-Zamakhshari (Asas): Literal: \"a precious thing (nafīs).\" Metaphorical: \"he poured out his soul (nafsahu)\" i.e., his blood; \"a soul with flowing blood\" — that which distinguishes living from dead matter. The \"share of the self\" (ḥaẓẓ al-nafs) is thus the portion of base, worldly, or selfish desire.\n- Root: ميل (Mayl)\n  * Lisan / Ayn: Inclination, leaning, deviation from the middle toward one side.\n  * Al-Raghib (Mufradat): \"Al-mayl is the deviation from the middle toward one of the two sides.\" It is used of inclination in affection and support: \"I inclined (miltu) to so-and-so\" — i.e., I aided him. It is also used of injustice, as in {«Do not incline with total inclination»} (Q 4:129).\n  * Al-Zamakhshari (Asas): Literal: \"a horse with an inclining neck.\" Metaphorical: \"He inclined away from the truth\" (māla ʿan al-ḥaqq); \"he sought to win him over\" (istamālahu) — i.e., he sought to draw his affection. Thus, mayl al-ṭabʿ is the natural, spontaneous leaning of the heart.\n- Root: ضعف (Ḍuʿf)\n  * Lisan / Ayn: Weakness, the opposite of strength.\n  * Al-Raghib (Mufradat): \"Al-ḍuʿf is the opposite of al-quwwah.\" It occurs in the soul, the body, and the condition. Al-Khalīl said: al-ḍuʿf (with ḍammah) is weakness of the body; al-ḍaʿf (with fatḥah) is weakness of intellect and opinion.\n  * Al-Zamakhshari (Asas): Literal: \"In him is weakness (ḍuʿf/ḍaʿf).\" Metaphorical: \"It is in the folds (aḍʿāf) of the book\" — i.e., in its midst and interstices. Thus, the strength or weakness of love is measured by its penetration into the hidden folds of the heart.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Specification with Innamā) — The particle innamā restricts the predicate to the subject alone, negating it for all else. This governs the crucial statement: \"he loves him only because God loves him\" — restricting the cause of love to divine pleasure alone, excluding all selfish shares (ḥuẓūẓ).","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'","badge":"Insight"}],"46":[{"arabic":"الأصل الثالث عذاب القبر وقد ورد الشرع به قال الله تعالى النار يعرضون عليها غدوا وعشيا ويوم تقوم الساعة أدخلوا آل فرعون أشد العذاب واشتهر عن رسول الله صلى الله عليه وسلم والسلف الصالح الاستعاذة من عذاب القبر (4) وهو ممكن فيجب التصديق به ولا يمنع من التصديق به تفرق أجزاء الميت في بطون السباع وحواصل الطيور فإن المدرك لألم العذاب من الحيوان أجزاء مخصوصة يقدر الله تعالى على إعادة الإدراك إليها الأصل الرابع الميزان وهو حق قال الله تعالى ونضع الموازين القسط ليوم القيامة وقال تعالى فمن ثقلت موازينه فأولئك هم المفلحون ومن خفت موازينه الآية ووجهها أن الله تعالى يحدث في صحائف ا","english":"For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].","book_title":"Foundations of Belief","section_title_ar":"Section 96","section_title_en":"The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles","section_index":96,"anchors":"- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.","content_type":"afterlife","topic":"Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'","badge":"Afterlife"}],"48":[{"arabic":"إذ قال صلى الله عليه وسلم إن الله قد حرم على المؤمن من المؤمن دمه وماله وعرضه وأن يظن به ظن السوء (4) وقال صلى الله عليه وسلم إياكم والظن فإن الظن أكذب الحديث (5) وسوء الظن يدعو إلى التحسس والتحسن وقد قال صلى الله عليه وسلم لا تحسسوا ولا تجسسوا ولا تقاطعوا ولاتدابروا وكونوا عباد الله إخوانا (1) والتجسس في تطلع الأخبار والتحسس بالمراقبة بالعين فستر العيوب والتجاهل والتغافل عنها شيمة أهل الدين ويكفيك تنبيها على كمال الرتبة في ستر القبيح وإظهار الجميل أن الله تعالى وصف به في الدعا","english":"Anas said: \"The Prophet (peace and blessings be upon him) never confronted anyone with something he disliked.\" — The ḥadīth of Anas: \"He never confronted anyone with something he disliked\" — narrated by Abū Dāwūd, al-Tirmidhī in al-Shamāʾil, and al-Nasāʾī in al-Yawm wa al-Laylah with a weak chain.","book_title":"Duties of Brotherhood","section_title_ar":"Section 419","section_title_en":"On Silence Regarding the Faults of Brothers — The Rights of Brotherhood (Section 419)","section_index":419,"anchors":"- Root: سكت (s-k-t)\n  * Lisan / Ayn: Core meaning of silence, refraining from speech; al-sukūt is the cessation of utterance, whether by tongue or by heart.\n  * Al-Raghib (Mufradat): Theological nuance — silence as a positive act of restraint (imsāk) that guards the tongue from what Allah has forbidden, paralleling the heart's silence from evil suspicion.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — refraining from audible speech; Metaphorical (majāz) — the heart's silence, i.e., refraining from passing judgment on a brother's actions when a good interpretation is possible.\n- Root: غيب (gh-y-b)\n  * Lisan / Ayn: That which is absent or hidden; ghībah (backbiting) is mentioning a brother in his absence with what he dislikes.\n  * Al-Raghib (Mufradat): Ghībah is a violation of the unseen honor (ʿirḍ) of the Muslim, which the Law has rendered inviolable like blood and property.\n  * Al-Zamakhshari (Asas): Literal — speaking of the absent; Metaphorical — the heart's backbiting (sūʾ al-ẓann), i.e., conceiving evil of a brother without certain knowledge.\n- Root: ظن (ẓ-n-n)\n  * Lisan / Ayn: Doubt, suspicion, or belief not founded on certainty; ẓann is the inclination of the soul toward one of two possibilities.\n  * Al-Raghib (Mufradat): In the Qur'anic context, \"avoid much suspicion\" {«إِنَّ بَعْضَ الظَّنِّ إِثْمٌ»} — the blameworthy suspicion is that which attributes evil to a believer without a decisive sign (amārah).\n  * Al-Zamakhshari (Asas): Literal — conjecture; Metaphorical — the heart's ghībah, for just as the tongue can wound, so too can the heart's presumption.\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: To cover, conceal; sitr is the act of veiling a fault or defect.\n  * Al-Raghib (Mufradat): Allah's attribute al-Sattār — He who veils the sins of His servants; the believer's emulation of this attribute is a mark of perfected faith.\n  * Al-Zamakhshari (Asas): Literal — physical covering; Metaphorical — concealing another's moral faults, as the Prophet said: \"Whoever conceals the fault of a brother, Allah conceals his fault in this world and the next.\"\n- Sibawayh Rule: Restriction and specification (al-ḥaṣr wa al-taqyīd) — the conditional clauses (law, idhā) and exceptions (illā) governing when silence is obligatory versus when speech becomes mandatory (amr bi-l-maʿrūf).","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'","badge":"Hadith"}],"49":[{"arabic":"فيقولون ادعوا خزنة جهنم قال فيدعون خزنة جهنم أن ادعوا ربكم يخفف عنا يوما من العذاب فيقولون أو لم تك تأتيكم رسلكم بالبينات قالوا بلى قالوا فادعوا وما دعاء الكافرين إلا في ضلال قال فيقولون ادعوا مالكا فيدعون فيقولون يا مالك ليقض علينا ربك قال فيجيبهم إنكم ماكثون (4) قال الأعمش أنبئت أن بين دعائهم وبين إجابة مالك إياهم ألف عام قال فيقولون ادعوا ربكم فلا أحد خير من ربكم فيقولون ربنا غلبت علينا شقوتنا وكنا قوما ضالين ربنا أخرجنا منها فإن عدنا فإنا ظالمون قال فيجيبهم اخسئوا فيها ولا تكلمون {قال}","english":"And ʿAlī, may God honor his face, said: The Messenger of God, may God bless him and grant him peace, said: \"Seek refuge in God from the Pit of Sorrow, or the Valley of Sorrow.\" It was said: \"O Messenger of God, what is the Valley or Pit of Sorrow?\" He said: \"A valley in Hell from which Hell itself seeks refuge with God seventy times each day. God, the Exalted, has prepared it for the reciters who show off.\" (2)","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1349","section_title_en":"The Vastness of Hellfire, Its Depths, and the Torments of Its Inhabitants","section_index":1349,"anchors":"- Root: و د ي (w-d-y)\n  * Lisan / Ayn: A valley; a place where torrents flow. In the lexicon, it denotes a lowland or watercourse between mountains.\n  * Al-Raghib (Mufradat): Used for the valleys of Hell as places of confinement and passage, each containing further branching ravines (شُعَب), indicating graded descent.\n  * Al-Zamakhshari (Asas): Literal for earthly valleys; here transferred (majāz) to the topographical reality of Hell, affirming its corporeal vastness.\n- Root: ع م ق (ʿ-m-q)\n  * Lisan / Ayn: Depth; the far bottom of a well or pit. Al-Farahidi: \"العمق: قعر البئر ونحوها.\"\n  * Al-Raghib (Mufradat): Depth as a measure of descent; in the Hereafter, it is unbounded, paralleling the unbounded depth of worldly desire.\n  * Al-Zamakhshari (Asas): Literal for physical depth; here extended to show the infinite regress of punishment corresponding to infinite craving.\n- Root: غ س ق (gh-s-q)\n  * Lisan / Ayn: Stinking, foul pus or ichor that flows from the skin of the damned; also intense darkness.\n  * Al-Raghib (Mufradat): Al-Ghassāq is the putrid effusion of Hell, a punishment for the senses, specifically for drinking when the damned cry out in thirst.\n  * Al-Zamakhshari (Asas): Literal for what is loathsome and fetid; in the Quranic context, it is the designated drink of the inhabitants.\n- Root: ز ق م (z-q-m)\n  * Lisan / Ayn: To swallow with difficulty; the tree of Zaqqūm, which grows in the depths of Hell.\n  * Al-Raghib (Mufradat): A specific tree in Hell whose fruit is like the heads of devils, eaten by the damned to fill their bellies, causing choking and agony.\n  * Al-Zamakhshari (Asas): Literal for a real tree; its description is sensory, not metaphorical, affirming the physical reality of punishment.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of \"في جهنم سبعين ألف واد\" allows the prepositional phrase to precede the subject for emphasis, establishing the spatial setting before detailing its contents.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Remembrance of Death and Afterlife'","badge":"Du'a"}],"50":[{"arabic":"من العذاب فيقولون أو لم تك تأتيكم رسلكم بالبينات قالوا بلى قالوا فادعوا وما دعاء الكافرين إلا في ضلال قال فيقولون ادعوا مالكا فيدعون فيقولون يا مالك ليقض علينا ربك قال فيجيبهم إنكم ماكثون (4) قال الأعمش أنبئت أن بين دعائهم وبين إجابة مالك إياهم ألف عام قال فيقولون ادعوا ربكم فلا أحد خير من ربكم فيقولون ربنا غلبت علينا شقوتنا وكنا قوما ضالين ربنا أخرجنا منها فإن عدنا فإنا ظالمون قال فيجيبهم اخسئوا فيها ولا تكلمون {قال}","english":"And ʿAlī, may God honor his face, said: The Messenger of God, may God bless him and grant him peace, said: \"Seek refuge in God from the Pit of Sorrow, or the Valley of Sorrow.\" It was said: \"O Messenger of God, what is the Valley or Pit of Sorrow?\" He said: \"A valley in Hell from which Hell itself seeks refuge with God seventy times each day. God, the Exalted, has prepared it for the reciters who show off.\" (2)","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1349","section_title_en":"The Vastness of Hellfire, Its Depths, and the Torments of Its Inhabitants","section_index":1349,"anchors":"- Root: و د ي (w-d-y)\n  * Lisan / Ayn: A valley; a place where torrents flow. In the lexicon, it denotes a lowland or watercourse between mountains.\n  * Al-Raghib (Mufradat): Used for the valleys of Hell as places of confinement and passage, each containing further branching ravines (شُعَب), indicating graded descent.\n  * Al-Zamakhshari (Asas): Literal for earthly valleys; here transferred (majāz) to the topographical reality of Hell, affirming its corporeal vastness.\n- Root: ع م ق (ʿ-m-q)\n  * Lisan / Ayn: Depth; the far bottom of a well or pit. Al-Farahidi: \"العمق: قعر البئر ونحوها.\"\n  * Al-Raghib (Mufradat): Depth as a measure of descent; in the Hereafter, it is unbounded, paralleling the unbounded depth of worldly desire.\n  * Al-Zamakhshari (Asas): Literal for physical depth; here extended to show the infinite regress of punishment corresponding to infinite craving.\n- Root: غ س ق (gh-s-q)\n  * Lisan / Ayn: Stinking, foul pus or ichor that flows from the skin of the damned; also intense darkness.\n  * Al-Raghib (Mufradat): Al-Ghassāq is the putrid effusion of Hell, a punishment for the senses, specifically for drinking when the damned cry out in thirst.\n  * Al-Zamakhshari (Asas): Literal for what is loathsome and fetid; in the Quranic context, it is the designated drink of the inhabitants.\n- Root: ز ق م (z-q-m)\n  * Lisan / Ayn: To swallow with difficulty; the tree of Zaqqūm, which grows in the depths of Hell.\n  * Al-Raghib (Mufradat): A specific tree in Hell whose fruit is like the heads of devils, eaten by the damned to fill their bellies, causing choking and agony.\n  * Al-Zamakhshari (Asas): Literal for a real tree; its description is sensory, not metaphorical, affirming the physical reality of punishment.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of \"في جهنم سبعين ألف واد\" allows the prepositional phrase to precede the subject for emphasis, establishing the spatial setting before detailing its contents.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Remembrance of Death and Afterlife'","badge":"Du'a"}],"52":[{"arabic":"على النار يفتنون يوم لا ينفع مال ولا بنون يوم لا ينفع الظالمين معذرتهم ولهم اللعنة ولهم سوء الدار يوم ترد فيه المعاذير وتبلى السرائر وتظهر الضمائر وتكشف الأستار يوم تخشع فيه الأبصار وتسكن الأصوات ويقل فيه الالتفات وتبرز الخفيات وتظهر الخطيئات يوم يساق العباد ومعهم الأشهاد ويشيب الصغير ويسكر الكبير فيومئذ وضعت الموازين ونشرت الدواوين وبرزت الجحيم وأغلى الحميم وزفرت النار ويئس الكفار وسعرت النيران وتغيرت الألوان وخرس اللسان ونطقت جوارح الإنسان فيا أيها الإنسان ما غرك بربك الكريم حيث أغلقت الأبواب وأرخيت الستور واستترت عن الخلائق فقارفت الفجور","english":"So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.","book_title":"Remembrance of Death and Afterlife","section_title_ar":"Section 1339","section_title_en":"The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent","section_index":1339,"anchors":"- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'","badge":"Insight"}],"55":[{"arabic":"مأخوذ من قوله تعالى {واستغفر لذنبك وسبح بحمد ربك بالعشي والإبكار} والاستغفار على الأسماء التي في القرآن أحب كقوله أستغفر الله إنه كان غفارا أستغفر الله إنه كان توابا رب اغفر وارحم وأنت خير الراحمين فاغفر لنا وارحمنا وأنت خير الراحمين فاغفر لنا وارحمنا وأنت خير الغافرين ويستحب أن يقرأ قبل غروب الشمس والشمس وضحاها والليل إذا يغشى والمعوذتين ولتغرب الشمس عليه وهو في الاستغفار فإذا سمع الأذان قال اللهم هذا إقبال ليلك وإدبار نهارك وأصوات دعاتك كما سبق ثم يجيب المؤذن ويشتغل بصلاة المغرب وبالغروب قد انتهت أوراد","english":"I say: And just as knowledge and remembrance are the nourishment of the heart, which can never be cut off from it, so too the measure of moderation is this; and deficiency from it may lead to the disturbance of the body — except for one who accustoms himself to wakefulness gradually, for he may train himself upon it without disturbance. And this litany (wird) is among the longest of the litanies and the most delightful for the worshippers, and it is one of the \"evenings and mornings\" (al-āṣāl) which God Most High mentioned when He said: {«ولله يسجد من في السموات والأرض طوعا وكرها وظلالهم بالغدو والآصال»} \"And to God prostrates whoever is in the heavens and the earth, willingly or unwillingly, and their shadows, in the mornings and the evenings\" (Q. 13:15). And when inanimate objects prostrate to God, Mighty and Majestic, how then can the intelligent servant be heedless of the varieties of worship?","book_title":"Arrangement of Litanies","section_title_ar":"Section 261","section_title_en":"The Seventh Daily Litany (Al-Wird al-Sābiʿ): The Time of Sunset — The Completion of the Day's Litanies and Self-Accounting","section_index":261,"anchors":"- Root: ورد (warada)\n  * Lisan / Ayn: The root denotes arriving at water, seeking it, and drinking from it; also the portion or share of water allotted for drinking at a specific time.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — the core meaning is the intentional approach to water; the litany (wird) is the appointed portion of devotional recitation, likened to the daily share of water that a person must take to sustain life.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): the act of arriving at water. Metaphorical (Majaz): \"ورد علي كتاب سرني مورده\" — a book arrived upon me whose arrival pleased me; likewise, the wird is the arrival of the appointed time for worship, and the soul's approach to the fountain of divine remembrance.\n- Root: عصر (ʿaṣr)\n  * Lisan / Ayn: The root denotes pressing, squeezing, and extracting; also the time of afternoon, so called because it is the pressing of the day's end.\n  * Al-Raghib (Mufradat): The ʿaṣr is the latter part of the day; God swore by it in {«والعصر»} (Q. 103:1), indicating its great merit.\n  * Al-Zamakhshari (Asas): Literal: the afternoon time. Metaphorical: the pressing of one's life — as the day is pressed at its end, so the life of man is pressed at its term.\n- Root: غرب (gharaba)\n  * Lisan / Ayn: The root denotes disappearance, absence, and setting; the sun's setting (ghurūb) is its concealment from the eye.\n  * Al-Raghib (Mufradat): The setting of the sun marks the boundary between the day's works and the night's; it is the terminus of the visible world's diurnal cycle.\n  * Al-Zamakhshari (Asas): Literal: the sun's descent below the horizon. Metaphorical: the setting of the sun of life — the death of man, after which there is no rising.\n- Root: حاسب (ḥāsaba)\n  * Lisan / Ayn: The root denotes reckoning, counting, and taking account; muḥāsabah is the mutual reckoning between two parties.\n  * Al-Raghib (Mufradat): Self-accounting (muḥāsabat al-nafs) is the soul's reckoning with itself over its deeds before the Day of Reckoning, for \"one who reckons himself before he is reckoned\" is among the wise.\n  * Al-Zamakhshari (Asas): Literal: the arithmetic counting of sums. Metaphorical: the soul's audit of its own works, weighing the day's deeds against the standard of the Sacred Law.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of the prepositional phrase from its governing verb, as in the construction \"فسبحان الله حين تمسون\" where the adverbial clause is interposed to emphasize the temporal specification of the act of glorification.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'","badge":"Du'a"}],"58":[{"arabic":"دونه وادعى الإجماع فيه واستدل بأدلة تشعر بنقيض غرضه كقوله تعالى {الذين آمنوا وعملوا الصالحات} إذ هذا يدل على أن العمل وراء الإيمان لا من نفس الإيمان وإلا فيكون العمل في حكم المعاد والعجب أنه ادعى الإجماع في هذا وهو مع ذلك ينقل قوله صلى الله عليه وسلم لا يكفر أحد إلا بعد جحوده لما أقر به (1) وينكر على المعتزلة قولهم بالتخليد في النار بسبب الكبائر والقائل بهذا قائل بنفس مذهب المعتزلة إذ يقال له من صدق بقلبه وشهد بلسانه ومات في الحال فهل هو في الجنة فلا بد أن يقول نعم وفيه حكم بوجود الإيمان دون العمل فنزيد ونقول لو بقي حيا حتى دخل عليه وقت","english":"He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.","book_title":"Foundations of Belief","section_title_ar":"Section 99","section_title_en":"The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments","section_index":99,"anchors":"- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'","badge":"Insight"}],"60":[{"arabic":"{ادعوا ربكم تضرعا وخفية إنه لا يحب المعتدين} وقال تعالى {وقال ربكم ادعوني أستجب لكم إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} وقال عز وجل {قل ادعوا الله أو ادعوا الرحمن أيا ما تدعوا فله الأسماء الحسنى} وروى النعمان بن بشير عن النبي صلى الله عليه وسلم أنه قال إن الدعاء هو العبادة ثم قرأ ادعوني أستجب لكم (1) الآية وقال صلى الله عليه وسلم الدعاء مخ العبادة (2) وروى أبو هريرة أنه صلى الله عليه وسلم قال ليس شيء أكرم على الله عز وجل من الدعاء (3) وقال صلى الله عليه وسلم إن العبد لا يخطئه من الدعاء إحدى ثلاث إما ذنب يغفر له وإما خير يعجل له وإما خير يدخر له (4","english":"Allah the Exalted has said: {«وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ فَلْيَسْتَجِيبُوا لِي»} (And when My servants ask you concerning Me — indeed I am near. I respond to the invocation of the supplicant when he calls upon Me. So let them respond to Me — Qurʾan 2:186). And He the Exalted said: {«ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ»} (Call upon your Lord in humility and privately; indeed, He does not like transgressors — Qurʾan 7:55). And He the Exalted said: {«وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ»} (And your Lord said: Call upon Me; I will respond to you. Indeed, those who disdain My worship will enter Hell humiliated — Qurʾan 40:60). And He, Glorified and Exalted, said: {«قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا الرَّحْمَنَ أَيًّا مَا تَدْعُوا فَلَهُ الْأَسْمَاءُ الْحُسْنَى»} (Say: Call upon Allah or call upon the Most Merciful. Whichever [name] you call — to Him belong the Most Beautiful Names — Qurʾan 17:110).","book_title":"On Invocations and Supplications","section_title_ar":"Section 241","section_title_en":"The Book of Invocation — Section 241: The Second Chapter on the Etiquette of Supplication (Duʿāʾ), Its Virtue, the Virtue of Certain Transmitted Supplications, the Virtue of Seeking Forgiveness (Istighfār), and Invoking Blessings upon the Messenger of Allah (Peace Be Upon Him)","section_index":241,"anchors":"- Root: دعو (Daʿā)\n  * Lisan / Ayn: \"الدعاء: الرغبة إلى الله تعالى، والاستعانة به. وأصل الدعو: الإقبال على الشيء بالرغبة والطلب. والدعوة: الكلمة التي يدعو بها. والمدعوّ: الذي يجيب. والداعي: الفاعل. واستدعاه: طلب منه الدعاء.\"\n  * Al-Raghib (Mufradat): \"الدعاء: الرغبة إلى الله تعالى في قضاء الحاجة، وهو ضربان: دعاء عبادة، ودعاء مسألة. فدعاء العبادة: هو التوجه إلى الله تعالى بالطاعة والإخلاص، ودعاء المسألة: هو طلب الحاجة. قال تعالى: {وقال ربكم ادعوني أستجب لكم} — فجعل الدعاء عبادة، إذ قال: {إن الذين يستكبرون عن عبادتي} فعطف العبادة على الدعاء، فدلّ على أنهما واحد.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعوته دعواً ودعاءً: ناديته وصحت به. ودعا الله: ابتهل إليه بالسؤال. ودعا الرجل: استنصره. ودعا الناقة: استدبرها.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الدعاء في العبادة: استعارة من دعاء المسألة، لأن العابد كأنه يسأل الله الثواب والقبول. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} — أي عن دعائي، فسمّى العبادة دعاءً.\"\n\n- Root: سحر (Saḥara)\n  * Lisan / Ayn: \"السحر: طرف الحلقوم والرئة. وقيل: السحر: آخر الليل عند الصبح. والسحور: الأكل في السحر. والسحرة: السحر الأخير من الليل.\"\n  * Al-Raghib (Mufradat): \"السحر يقال على معان: الأول: الخداع وتخييلات لا حقيقة لها... والثاني: وقت السحر، وهو آخر الليل، سمي بذلك لأنه وقت يكون فيه تنفس الصعداء واسترواح من ظلمة الليل، أو لأنه وقت خفاء الناس وسكون الأصوات.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"لقيته سحراً وسحرة وبالسحر وفي أعلى السحرين وهما سحر مع الصبح وسحر قبله.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"السحر في قوله تعالى: {وبالأسحار هم يستغفرون} — هو الوقت الأخير من الليل، وهو أشرف الأوقات للدعاء، لأنه وقت غفلة الناس وخلوة القلب.\"\n\n- Root: عرف (ʿArafa)\n  * Lisan / Ayn: \"العرف: الطيب. والمعرفة: العلم بالشيء على وجه التدبر. وعرفة: جبل بمكة، سمي بذلك لأن الناس يتعارفون فيه، أو لأن جبريل عليه السلام عرّف إبراهيم المناسك فيه.\"\n  * Al-Raghib (Mufradat): \"عرفة: اسم للموقف الذي يقف فيه الحجاج، سمي بذلك لأن آدم وحواء تعارفا فيه بعد الهبوط، وقيل: لأن جبريل عرّف إبراهيم المناسك فيه.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"يوم عرفة: اليوم التاسع من ذي الحجة، وهو يوم الموقف.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"عرفة في قولهم: يوم عرفة — اسم للموقف، سمي بذلك لتعارف الناس فيه، أو لتعريف جبريل إبراهيم المناسك.\"\n\n- Root: غفر (Ghafara)\n  * Lisan / Ayn: \"المغفرة: ستر الذنب والتجاوز عنه. والغفر: الستر. والمغفر: ما يستر الرأس في الحرب. والغفور: الكثير المغفرة.\"\n  * Al-Raghib (Mufradat): \"الغفران: ستر الذنب والتجاوز عنه، وأصله من الغفر وهو الستر. قال تعالى: {وإن تغفر لهم فإنك أنت العزيز الحكيم}. والاستغفار: طلب المغفرة، وهو ضربان: استغفار باللسان، واستغفار بالقلب واللسان معاً، وهو النافع.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"غفرت الذنب غفراً ومغفرة: سترته وتجاوزت عنه. واستغفرت الله: طلبت مغفرته.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الاستغفار باللسان مع الإصرار: استعارة للكذب، لأن المستغفر الحقيقي هو التائب المقلع عن الذنب.\"\n\n- Root: صلو (Ṣalā)\n  * Lisan / Ayn: \"الصلاة: الدعاء، وقيل: العبادة، وقيل: الرحمة من الله، والاستغفار من الملائكة. والصلاة من الله: الرحمة، ومن الملائكة: الاستغفار، ومن المؤمنين: الدعاء.\"\n  * Al-Raghib (Mufradat): \"الصلاة في الأصل: الدعاء، قال تعالى: {صلوا عليه وسلموا تسليماً} — أي ادعوا له. ثم غلب استعمالها في العبادة المخصوصة، والصلاة من الله: الرحمة، ومن الملائكة: الاستغفار.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"الصلاة: الدعاء. ومنه قوله تعالى: {وصل عليهم إن صلاتك سكن لهم} — أي ادع لهم.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الصلاة على النبي صلى الله عليه وسلم: استعارة للدعاء له بالرحمة والتعظيم، لأن أصل الصلاة الدعاء.\"\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication)\n  * Governing Rule: \"إنما\" تفيد الحصر والقصر، فإذا قيل: \"إن الدعاء هو العبادة\" — فالمبتدأ والخبر معرفتان، والجملة تفيد الحصر والتأكيد. وإذا قيل: \"الدعاء مخ العبادة\" — فالإسناد فيه تشبيه بليغ، حيث شبه الدعاء بالمخ الذي هو لبّ العظم وجوهره، فالدعاء هو اللبّ والجوهر الحقيقي للعبادة.\n\n---\n\n##","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'","badge":"Hadith"},{"arabic":"ادعوني أستجب لكم إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} وقال عز وجل {قل ادعوا الله أو ادعوا الرحمن أيا ما تدعوا فله الأسماء الحسنى} وروى النعمان بن بشير عن النبي صلى الله عليه وسلم أنه قال إن الدعاء هو العبادة ثم قرأ ادعوني أستجب لكم (1) الآية وقال صلى الله عليه وسلم الدعاء مخ العبادة (2) وروى أبو هريرة أنه صلى الله عليه وسلم قال ليس شيء أكرم على الله عز وجل من الدعاء (3) وقال صلى الله عليه وسلم إن العبد لا يخطئه من الدعاء إحدى ثلاث إما ذنب يغفر له وإما خير يعجل له وإما خير يدخر له (4","english":"Allah the Exalted has said: {«وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ فَلْيَسْتَجِيبُوا لِي»} (And when My servants ask you concerning Me — indeed I am near. I respond to the invocation of the supplicant when he calls upon Me. So let them respond to Me — Qurʾan 2:186). And He the Exalted said: {«ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ»} (Call upon your Lord in humility and privately; indeed, He does not like transgressors — Qurʾan 7:55). And He the Exalted said: {«وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ»} (And your Lord said: Call upon Me; I will respond to you. Indeed, those who disdain My worship will enter Hell humiliated — Qurʾan 40:60). And He, Glorified and Exalted, said: {«قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا الرَّحْمَنَ أَيًّا مَا تَدْعُوا فَلَهُ الْأَسْمَاءُ الْحُسْنَى»} (Say: Call upon Allah or call upon the Most Merciful. Whichever [name] you call — to Him belong the Most Beautiful Names — Qurʾan 17:110).","book_title":"Condemnation of Pride and Conceit","section_title_ar":"Section 241","section_title_en":"The Book of Invocation — Section 241: The Second Chapter on the Etiquette of Supplication (Duʿāʾ), Its Virtue, the Virtue of Certain Transmitted Supplications, the Virtue of Seeking Forgiveness (Istighfār), and Invoking Blessings upon the Messenger of Allah (Peace Be Upon Him)","section_index":241,"anchors":"- Root: دعو (Daʿā)\n  * Lisan / Ayn: \"الدعاء: الرغبة إلى الله تعالى، والاستعانة به. وأصل الدعو: الإقبال على الشيء بالرغبة والطلب. والدعوة: الكلمة التي يدعو بها. والمدعوّ: الذي يجيب. والداعي: الفاعل. واستدعاه: طلب منه الدعاء.\"\n  * Al-Raghib (Mufradat): \"الدعاء: الرغبة إلى الله تعالى في قضاء الحاجة، وهو ضربان: دعاء عبادة، ودعاء مسألة. فدعاء العبادة: هو التوجه إلى الله تعالى بالطاعة والإخلاص، ودعاء المسألة: هو طلب الحاجة. قال تعالى: {وقال ربكم ادعوني أستجب لكم} — فجعل الدعاء عبادة، إذ قال: {إن الذين يستكبرون عن عبادتي} فعطف العبادة على الدعاء، فدلّ على أنهما واحد.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعوته دعواً ودعاءً: ناديته وصحت به. ودعا الله: ابتهل إليه بالسؤال. ودعا الرجل: استنصره. ودعا الناقة: استدبرها.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الدعاء في العبادة: استعارة من دعاء المسألة، لأن العابد كأنه يسأل الله الثواب والقبول. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} — أي عن دعائي، فسمّى العبادة دعاءً.\"\n\n- Root: سحر (Saḥara)\n  * Lisan / Ayn: \"السحر: طرف الحلقوم والرئة. وقيل: السحر: آخر الليل عند الصبح. والسحور: الأكل في السحر. والسحرة: السحر الأخير من الليل.\"\n  * Al-Raghib (Mufradat): \"السحر يقال على معان: الأول: الخداع وتخييلات لا حقيقة لها... والثاني: وقت السحر، وهو آخر الليل، سمي بذلك لأنه وقت يكون فيه تنفس الصعداء واسترواح من ظلمة الليل، أو لأنه وقت خفاء الناس وسكون الأصوات.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"لقيته سحراً وسحرة وبالسحر وفي أعلى السحرين وهما سحر مع الصبح وسحر قبله.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"السحر في قوله تعالى: {وبالأسحار هم يستغفرون} — هو الوقت الأخير من الليل، وهو أشرف الأوقات للدعاء، لأنه وقت غفلة الناس وخلوة القلب.\"\n\n- Root: عرف (ʿArafa)\n  * Lisan / Ayn: \"العرف: الطيب. والمعرفة: العلم بالشيء على وجه التدبر. وعرفة: جبل بمكة، سمي بذلك لأن الناس يتعارفون فيه، أو لأن جبريل عليه السلام عرّف إبراهيم المناسك فيه.\"\n  * Al-Raghib (Mufradat): \"عرفة: اسم للموقف الذي يقف فيه الحجاج، سمي بذلك لأن آدم وحواء تعارفا فيه بعد الهبوط، وقيل: لأن جبريل عرّف إبراهيم المناسك فيه.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"يوم عرفة: اليوم التاسع من ذي الحجة، وهو يوم الموقف.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"عرفة في قولهم: يوم عرفة — اسم للموقف، سمي بذلك لتعارف الناس فيه، أو لتعريف جبريل إبراهيم المناسك.\"\n\n- Root: غفر (Ghafara)\n  * Lisan / Ayn: \"المغفرة: ستر الذنب والتجاوز عنه. والغفر: الستر. والمغفر: ما يستر الرأس في الحرب. والغفور: الكثير المغفرة.\"\n  * Al-Raghib (Mufradat): \"الغفران: ستر الذنب والتجاوز عنه، وأصله من الغفر وهو الستر. قال تعالى: {وإن تغفر لهم فإنك أنت العزيز الحكيم}. والاستغفار: طلب المغفرة، وهو ضربان: استغفار باللسان، واستغفار بالقلب واللسان معاً، وهو النافع.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"غفرت الذنب غفراً ومغفرة: سترته وتجاوزت عنه. واستغفرت الله: طلبت مغفرته.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الاستغفار باللسان مع الإصرار: استعارة للكذب، لأن المستغفر الحقيقي هو التائب المقلع عن الذنب.\"\n\n- Root: صلو (Ṣalā)\n  * Lisan / Ayn: \"الصلاة: الدعاء، وقيل: العبادة، وقيل: الرحمة من الله، والاستغفار من الملائكة. والصلاة من الله: الرحمة، ومن الملائكة: الاستغفار، ومن المؤمنين: الدعاء.\"\n  * Al-Raghib (Mufradat): \"الصلاة في الأصل: الدعاء، قال تعالى: {صلوا عليه وسلموا تسليماً} — أي ادعوا له. ثم غلب استعمالها في العبادة المخصوصة، والصلاة من الله: الرحمة، ومن الملائكة: الاستغفار.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"الصلاة: الدعاء. ومنه قوله تعالى: {وصل عليهم إن صلاتك سكن لهم} — أي ادع لهم.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الصلاة على النبي صلى الله عليه وسلم: استعارة للدعاء له بالرحمة والتعظيم، لأن أصل الصلاة الدعاء.\"\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication)\n  * Governing Rule: \"إنما\" تفيد الحصر والقصر، فإذا قيل: \"إن الدعاء هو العبادة\" — فالمبتدأ والخبر معرفتان، والجملة تفيد الحصر والتأكيد. وإذا قيل: \"الدعاء مخ العبادة\" — فالإسناد فيه تشبيه بليغ، حيث شبه الدعاء بالمخ الذي هو لبّ العظم وجوهره، فالدعاء هو اللبّ والجوهر الحقيقي للعبادة.\n\n---\n\n##","content_type":"hadith","topic":"Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'","badge":"Hadith"}],"62":[{"arabic":"وفي كل شيء له آية ... تدل على أنه الواحد وكما يقال هذه الصنعة المحكمة تشهد لصانعها بحسن التدبير وكمال العلم لا بمعنى أنها تقول أشهد بالقول ولكن بالذات والحال وكذلك ما من شيء إلا وهو محتاج في نفسه إلى موجد يوجده ويبقيه ويديم أوصافه ويردده في أطواره فهو بحاجته يشهد لخالقه بالتقديس يدرك شهادته ذوو البصائر دون الجامدين على الظواهر ولذلك قال تعالى ولكن لا تفقهون تسبيحهم وأما القاصرون فلا يفقهون أصلا وأما المقربون والعلماء الراسخون فلا يفقهون كنهه وكماله إذ لكل شيء شهاد","english":"The fifth [division] is that one expresses by the tongue of explicit statement (lisān al-maqāl) what belongs to the tongue of state (lisān al-ḥāl). The one of deficient understanding stops at the outward and believes it to be literal speech, while the one with insight into realities perceives the secret within it. This is like the saying of one who said: \"The wall said to the peg: 'Why have you split me?' It replied: 'Ask the one who strikes me — he did not leave me behind the stone that is behind me.'\" This is an expression of the tongue of state by the tongue of explicit statement.","book_title":"Foundations of Belief","section_title_ar":"Section 85","section_title_en":"The Fourth Division — Comprehension by Encounter and Taste (Al-Dhawq), and the Fifth Division — The Tongue of State (Lisān al-Ḥāl)","section_index":85,"anchors":"- Root: علم (ʿalima)\n  * Lisan / Ayn: Core root denotes the faculty of knowing, perceiving a thing's reality; encompasses both direct apprehension and judgment about existence.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence itself and judgment concerning it.\n  * Al-Zamakhshari (Asas): Distinguishes literal knowledge (maʿrifah) from awareness (shuʿūr); here, the distinction between superficial knowledge (ẓāhir) and realized knowledge (bāṭin) is rhetorical-metaphorical, not contradictory.\n- Root: ظهر (ẓahara)\n  * Lisan / Ayn: Core root denotes outwardness, visibility, strength of back; the ẓāhir is what is manifest and apparent.\n  * Al-Raghib (Mufradat): The ẓāhir is used metaphorically for the outward aspect of a thing, as opposed to its inner reality (bāṭin); the back (ẓahr) carries what is loaded upon it.\n  * Al-Zamakhshari (Asas - Majaz): \"قلبت الأمر ظهرا لبطن\" — turning a matter over, examining its outward and inward aspects; the ẓāhir is the shell (qishr) that contains and is completed by the inner kernel (lubb).\n- Root: وقع (waqaʿa)\n  * Lisan / Ayn: Core root denotes falling, occurring, befalling; a thing's occurrence and realization.\n  * Al-Raghib (Mufradat): \"الوقوع: ثبوت الشيء وسقوطه\" — occurrence is the establishment and falling of a thing; in Quranic usage, often associated with calamities and inevitable events.\n  * Al-Zamakhshari (Asas - Majaz): \"وقع الأمر حصل ووجد\" — the matter occurred, i.e., it became realized and existent; here, the \"occurrence\" of a state (ḥāl) is its actual realization in the soul, as opposed to mere intellectual assent before its descent.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure allows for separation between the operative word and its object to achieve rhetorical emphasis, mirroring the semantic distinction between outward apprehension and inward realization.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'","badge":"Insight"}],"65":[{"arabic":"الله مخلصين له الدين الحمد لله رب العالمين فسبحان الله حين تمسون وحين تصبحون وله الحمد في السموات والأرض وعشيا وحين تظهرون يخرج الحي من الميت ويخرج الميت من الحي ويحيي الأرض بعد موتها وكذلك تخرجون ومن آياته أن خلقكم من تراب ثم إذا أنتم بشر تنتشرون اللهم إني أسألك إيمانا دائما ويقينا صادقا وعلما نافعا وقلبا خاشعا ولسانا ذاكرا وأسألك العفو والعافية والمعافاة الدائمة في الدنيا والآخرة ويصلي على محمد صلى الله عليه وسلم ويدعو الله عز وجل بما شاء من حاجته عقيب هذا الدعاء ثم ينزل ويبتدىء السعي","english":"Upon ascending al-Ṣafā, he should face the House (al-Bayt) and say: \"God is Greater, God is Greater. Praise be to God for what He has guided us to. Praise be to God with all His praises, for all His graces, all of them. There is no god but God alone, with no partner. His is the dominion, and His is the praise. He gives life and causes death; in His hand is all good, and He is over all things competent. There is no god but God alone; He fulfilled His promise, aided His servant, and honored His soldiers; He alone defeated the confederates. There is no god but God, devoting religion sincerely to Him, even if the disbelievers detest it. There is no god but God, devoting religion sincerely to Him. Praise be to God, Lord of the worlds. So exalted is God when you reach the evening and when you reach the morning. And His is the praise in the heavens and the earth, and at nightfall and when you are at noon. He brings forth the living from the dead and brings forth the dead from the living, and He revives the earth after its death, and thus shall you be brought forth. And of His signs is that He created you from dust; then, behold, you are humans spreading out. O God, I ask You for enduring faith, sincere certainty, beneficial knowledge, a humble heart, and a tongue that remembers You. And I ask You for pardon, well-being, and perpetual immunity in this world and the Hereafter.\" Then he sends blessings upon Muḥammad, may God bless him and grant him peace, and supplicates God, Mighty and Majestic, with whatever need he wishes, following this supplication.","book_title":"Mysteries of Hajj","section_title_ar":"Section 204","section_title_en":"The Yemeni Corner and the Stone — The Beginning of the Saʿy and Its Rites","section_index":204,"anchors":"- Root: سعي (Saʿy)\n  * Lisan / Ayn: The root denotes striving, running, or rapid walking; it is the exertion of effort in a matter, whether good or evil.\n  * Al-Raghib (Mufradat): \"السعي: المشي السريع، وهو دون العدو، ويستعمل للجد في الأمر\" — Saʿy is swift walking, less than running, and is used for earnest exertion in a matter. In the sacred rite, it signifies the ritual traversing between al-Ṣafā and al-Marwah, an act of devotional striving.\n  * Al-Zamakhshari (Asas): Literal (Ḥaqīqah): \"سعى إلى المسجد\" — physical exertion toward a goal. Metaphorical (Majāz): \"هو يسعى على عياله\" — he strives to provide for his family. In the ritual context, the physical traversing is the literal embodiment of devotional striving.\n- Root: حمد (Ḥamd)\n  * Lisan / Ayn: The root denotes praise, commendation, and the acknowledgment of beneficence; it is the opposite of blame (dhamm).\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with reverence and love, and it is due to God alone in His absolute perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — praising God with all His praises. Metaphorical: \"أحمدت صنيعه\" — I approved of his deed. In the supplications of the saʿy, the pilgrim's praise is both literal acknowledgment and the metaphorical \"approval\" of God's decree.\n- Root: رمل (Raml)\n  * Lisan / Ayn: The root denotes rapid walking with a slight trotting motion, a form of hastening in movement.\n  * Al-Raghib (Mufradat): Not a primary theological term, but in ritual context it signifies the prescribed hastening between the two green markers, emulating the Prophet's action.\n  * Al-Zamakhshari (Asas): Literal: physical hastening. Metaphorical: The rapid pace is a visible emblem of spiritual earnestness and the rejection of the polytheists' claim that the Muslims were weakened by fever.\n- Sibawayh Rule: Rule of Restriction and Specification (al-Ḥaṣr wa al-Taqyīd) — The phrase \"وإنما ذلك شرط في طواف الركن\" employs restriction to delimit a condition exclusively to the circumambulation of the pillar (ṭawāf al-rukn), thereby negating its applicability to the saʿy.","content_type":"dua","topic":"Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Hajj'","badge":"Du'a"}],"71":[{"arabic":"يعمل خوصا فقرأت عليه {إذ الأغلال في أعناقهم والسلاسل يسحبون في الحميم ثم في النار يسجرون} فشهق الرجل شهقة وخر مغشيا عليه فخرجنا من عنده وتركناه على حاله وذهبنا إلى آخر فدخلنا عليه فقرأت هذه الآية فشهق شهقة وخر مغشيا عليه فذهبنا واستأذنا على ثالث فقال ادخلوا إن لم تشغلونا عن ربنا فقرأت {ذلك لمن خاف مقامي وخاف وعيد} فشهق شهقة فبدا الدم من منخريه وجعل يتشحط في دمه حتى يبس فتركناه على حاله وخرجنا فأدرته على ستة أنفس كل نخرج من عنده ونتركه مغشيا عليه ثم أتيت به إلى السابع فاستأذنا فإذا امرأة من داخل الخص تقول ادخلوا فدخلنا فإذا شيخ فان ج","english":"And Fudayl was seen one day walking, and it was said to him, \"Where are you going?\" He said, \"I do not know.\" And he was walking utterly bewildered (wālihan) from fear.","book_title":"Fear and Hope","section_title_ar":"Section 1063","section_title_en":"The Revival of the Religious Sciences — Section 1063: The Weeping of the Fearful and Their States of Awe","section_index":1063,"anchors":"- Root: وله (w-l-h)\n  * Lisan / Ayn: Core meaning is bewilderment and distraction of the mind, losing one's wits due to intense grief or fear; a state where one wanders aimlessly, heedless of direction.\n  * Al-Raghib (Mufradat): In the theological context of the fear of God (khawf), it denotes a profound psychological dislocation where the heart's composure is shattered by the overwhelming majesty of the divine threat.\n  * Al-Zamakhshari (Asas): Used here in its literal (haqiqah) sense of distracted wandering, but applied metaphorically (majaz) to describe the soul's journey bereft of worldly purpose, driven solely by dread.\n- Root: روع (r-w-ʾ)\n  * Lisan / Ayn: The root signifies striking terror or alarm; \"raw'ah\" is a sudden fright that seizes the heart.\n  * Al-Raghib (Mufradat): In the lexicon of the hereafter, it refers to the terrifying summons (al-nida') that strikes dread into the hearts of the sinful when they are paraded before God for reckoning.\n  * Al-Zamakhshari (Asas): The phrase \"raw'at al-nida'\" is a literal construction denoting the specific terror of the call to the divine court, not a metaphorical embellishment.\n- Root: بهت (b-h-t)\n  * Lisan / Ayn: To be stunned, confounded, or speechless; to be rendered motionless and mute by an overwhelming sight or truth.\n  * Al-Raghib (Mufradat): Describes the state of one who is struck dumb by a divine reality, a cessation of normal cognitive and physical function due to the sheer weight of the metaphysical vision.\n  * Al-Zamakhshari (Asas): Used literally to describe the physical and mental paralysis of the ascetics upon hearing verses of divine threat, distinguishing it from mere figurative astonishment.\n- Sibawayh Rule: Rule of Interrogative Retort (باب الاستفهام الإنكاري) — The question \"بين يدي من ويحك\" (Before whom, woe to you?) functions as a rhetorical denial and rebuke, structured to emphasize the absolute majesty of God by leaving the answer implicit and overwhelming.","content_type":"spiritual","topic":"Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'","badge":"Insight"}]},"wordTiming":{"abdulbasit":{"1":[[1,350,4521]],"2":[[1,400,1809],[2,1809,3065],[3,3065,3578],[4,3578,4590],[5,4590,6128],[6,6128,7665]],"3":[[1,400,1612],[2,1612,2960],[3,2960,4585],[4,4585,6017],[5,6017,7229],[6,7229,8854],[7,8854,9525],[8,9525,11092],[9,11092,12423],[10,12423,13377],[11,13377,14551],[12,14551,15170],[13,15170,16357],[14,16357,17931]],"4":[[1,400,1023],[2,1023,2246],[3,2246,3421],[4,3421,4812],[5,4812,5759],[6,5759,6850],[7,6850,8205],[8,8205,9668],[9,9668,10531],[10,10531,11874],[11,11874,13517],[12,13517,14117],[13,14117,15292]],"5":[[1,400,1797],[2,1797,3314],[3,3314,4363],[4,4363,5384],[5,5384,7851],[6,7851,8418],[7,8418,9864],[8,9864,11523],[9,11523,12303],[10,12303,13565],[11,13565,15692],[12,15692,18046],[13,18046,20371],[14,20371,22129],[15,22129,24752],[16,24752,25291],[17,25291,26567],[18,26567,28637],[19,28637,29913],[20,29913,30934],[21,30934,32350]],"6":[[1,400,1943],[2,1943,2978],[3,2978,3964],[4,3964,4888],[5,4888,5800],[6,5800,7192],[7,7192,9287],[8,9287,10655],[9,10655,11951],[10,11951,13516]],"7":[[1,400,1856],[2,1856,3686],[3,3686,4898],[4,4898,5800],[5,5800,6960],[6,6960,9009],[7,9009,10066],[8,10066,11265],[9,11265,13533],[10,13533,14023],[11,14023,16781],[12,16781,18418],[13,18418,20351],[14,20351,21730],[15,21730,22967],[16,22967,23676],[17,23676,24578],[18,24578,25777],[19,25777,27401],[20,27401,28535],[21,28535,30172],[22,30172,31899],[23,31899,34180],[24,34180,35624],[25,35624,36810],[26,36810,38073],[27,38073,39595]],"8":[[1,400,1845],[2,1845,3992],[3,3992,5591],[4,5591,6523],[5,6523,7752],[6,7752,9804],[7,9804,10749],[8,10749,11667],[9,11667,12207],[10,12207,15113],[11,15113,17543],[12,17543,20635],[13,20635,21891],[14,21891,22755],[15,22755,24375],[16,24375,25968]],"9":[[1,400,1647],[2,1647,4018],[3,4018,4966],[4,4966,5562],[5,5562,7933],[6,7933,9667],[7,9667,10602],[8,10602,11957],[9,11957,13382],[10,13382,14032],[11,14032,15333],[12,15333,17042]],"10":[[1,400,1315],[2,1315,2731],[3,2731,4259],[4,4259,6163],[5,6163,7291],[6,7291,8281],[7,8281,9333],[8,9333,9834],[9,9834,11575],[10,11575,13154],[11,13154,13730],[12,13730,15221],[13,15221,16148],[14,16148,17802],[15,17802,19681]],"11":[[1,400,2018],[2,2018,3872],[3,3872,5408],[4,5408,6791],[5,6791,9229],[6,9229,10612],[7,10612,12511],[8,12511,14433],[9,14433,15113],[10,15113,16191],[11,16191,17269],[12,17269,18078],[13,18078,19158]],"12":[[1,400,1846],[2,1846,3969],[3,3969,5154],[4,5154,6278],[5,6278,7478],[6,7478,8845],[7,8845,10364],[8,10364,11488],[9,11488,12916],[10,12916,13493],[11,13493,15741],[12,15741,17381],[13,17381,18490],[14,18490,20350],[15,20350,22110]],"13":[