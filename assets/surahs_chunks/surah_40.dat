ic": "رَبَّهُۥٓ", "translit": "", "root": ""}, {"id": 8, "arabic": "إِنِّيَ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَخَافُ", "translit": "", "root": ""}, {"id": 10, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 11, "arabic": "يُّبَدِّلَ", "translit": "", "root": ""}, {"id": 12, "arabic": "دِينَكُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَأَنْ", "translit": "", "root": ""}, {"id": 14, "arabic": "يُّظْهِرَ", "translit": "", "root": ""}, {"id": 15, "arabic": "فِے", "translit": "", "root": ""}, {"id": 16, "arabic": "اِ۬لَارْضِ", "translit": "", "root": ""}, {"id": 17, "arabic": "اِ۬لْفَسَادَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 27, "text": "وَقَالَ مُوس۪يٰٓ إِنِّے عُذْتُ بِرَبِّے وَرَبِّكُم مِّن كُلِّ مُتَكَبِّرࣲ لَّا يُومِنُ بِيَوْمِ اِ۬لْحِسَابِۖ", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 4, "arabic": "عُذْتُ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِرَبِّے", "translit": "", "root": ""}, {"id": 6, "arabic": "وَرَبِّكُم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 9, "arabic": "مُتَكَبِّرࣲ", "translit": "", "root": ""}, {"id": 10, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 11, "arabic": "يُومِنُ", "translit": "", "root": ""}, {"id": 12, "arabic": "بِيَوْمِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۬لْحِسَابِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 40, "ayah": 28, "text": "وَقَالَ رَجُلࣱ مُّومِنࣱ مِّنَ اٰلِ فِرْعَوْنَ يَكْتُمُ إِيمَٰنَهُۥٓ أَتَقْتُلُونَ رَجُلاً اَنْ يَّقُولَ رَبِّيَ اَ۬للَّهُ وَقَدْ جَآءَكُم بِالْبَيِّنَٰتِ مِن رَّبِّكُمْ وَإِنْ يَّكُ كَٰذِباࣰ فَعَلَيْهِ كَذِبُهُۥ وَإِنْ يَّكُ صَادِقاࣰ يُصِبْكُم بَعْضُ اُ۬لذِے يَعِدُكُمُۥٓۖ إِنَّ اَ۬للَّهَ لَا يَ