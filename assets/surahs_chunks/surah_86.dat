 86, "ayah": 6, "text": "خُلِقَ مِن مَّآءࣲ دَافِقࣲ‏", "words": [{"id": 1, "arabic": "خُلِقَ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "", "root": ""}, {"id": 3, "arabic": "مَّآءࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "دَافِقࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 7, "text": "يَخْرُجُ مِنۢ بَيْنِ اِ۬لصُّلْبِ وَالتَّرَآئِبِۖ", "words": [{"id": 1, "arabic": "يَخْرُجُ", "translit": "", "root": ""}, {"id": 2, "arabic": "مِنۢ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَيْنِ", "translit": "", "root": ""}, {"id": 4, "arabic": "اِ۬لصُّلْبِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالتَّرَآئِبِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 8, "text": "إِنَّهُۥ عَلَيٰ رَجْعِهِۦ لَقَادِرࣱ‏", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَجْعِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "لَقَادِرࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 9, "text": "يَوْمَ تُبْلَي اَ۬لسَّرَآئِرُ", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "تُبْلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لسَّرَآئِرُ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 10, "text": "فَمَا لَهُۥ مِن قُوَّةࣲ وَلَا نَاصِرࣲۖ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قُوَّةࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 6, "arabic": "نَاصِرࣲۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 11, "text": "وَالسَّمَآءِ ذَاتِ اِ۬لرَّجْعِ", "words": [{"id": 1, "arabic": "وَالسَّمَآءِ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَاتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لرَّجْعِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 12, "text": "وَالَارْضِ ذَاتِ اِ۬لصَّدْعِ", "words": [{"id": 1, "arabic": "وَالَارْضِ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَاتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬لصَّدْعِ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 13, "text": "إِنَّهُۥ لَقَوْلࣱ فَصْلࣱ‏", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 2, "arabic": "لَقَوْلࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَصْلࣱ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 14, "text": "وَمَا هُوَ بِالْهَزْلِۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 3, "arabic": "بِالْهَزْلِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 15, "text": "إِنَّهُمْ يَكِيدُونَ كَيْداࣰ‏", "words": [{"id": 1, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَكِيدُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَيْداࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 16, "text": "وَأَكِيدُ كَيْداࣰۖ", "words": [{"id": 1, "arabic": "وَأَكِيدُ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَيْداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 86, "ayah": 17, "text": "فَمَهِّلِ اِ۬لْكٰ۪فِرِينَ أَمْهِلْهُمْ رُوَيْداࣰۖ", "words": [{"id": 1, "arabic": "فَمَهِّلِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۬لْكٰ۪فِرِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَمْهِلْهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "رُوَيْداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}]}