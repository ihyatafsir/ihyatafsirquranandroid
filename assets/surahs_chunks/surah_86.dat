{"surah": 86, "verses": [{"ayah": 1, "text": "وَٱلسَّمَآءِ وَٱلطَّارِقِ ", "translation": "By the sky and the knocker", "words": [{"id": 1, "arabic": "وَٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱَw", "root": "سمو"}, {"id": 2, "arabic": "وَٱلطَّارِقِ", "translit": "ِqِrāَّṭlٱَw", "root": "طرق"}], "hasIhya": false}, {"ayah": 2, "text": "وَمَآ أَدْرَىٰكَ مَا ٱلطَّارِقُ ", "translation": "And what can make you know what is the knocker?", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَدْرَىٰكَ", "translit": "َkٰàَrْdَaʾ", "root": "دري"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "ٱلطَّارِقُ", "translit": "ُqِrāَّṭlٱ", "root": "طرق"}], "hasIhya": false}, {"ayah": 3, "text": "ٱلنَّجْمُ ٱلثَّاقِبُ ", "translation": "It is the piercing star[1].", "words": [{"id": 1, "arabic": "ٱلنَّجْمُ", "translit": "ُmْjgَّnlٱ", "root": "نجم"}, {"id": 2, "arabic": "ٱلثَّاقِبُ", "translit": "ُbِqāَّhtlٱ", "root": "ثقب"}], "hasIhya": false}, {"ayah": 4, "text": "إِن كُلُّ نَفْسٍ لَّمَّا عَلَيْهَا حَافِظٌ ", "translation": "There is no soul but that it has over it a protector.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 3, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 4, "arabic": "لَّمَّا", "translit": "āَّmَّl", "root": ""}, {"id": 5, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "حَافِظٌ", "translit": "ٌẓِfāَḥ", "root": "حفظ"}], "hasIhya": false}, {"ayah": 5, "text": "فَلْيَنظُرِ ٱلْإِنسَٰنُ مِمَّ خُلِقَ ", "translation": "So let man observe from what he was created.", "words": [{"id": 1, "arabic": "فَلْيَنظُرِ", "translit": "ِrُẓnَyْlَf", "root": "نظر"}, {"id": 2, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 3, "arabic": "مِمَّ", "translit": "َّmِm", "root": ""}, {"id": 4, "arabic": "خُلِقَ", "translit": "َqِlُhk", "root": "خلق"}], "hasIhya": false}, {"ayah": 6, "text": "خُلِقَ مِن مَّآءٍ دَافِقٍ ", "translation": "He was created from a fluid, ejected,", "words": [{"id": 1, "arabic": "خُلِقَ", "translit": "َqِlُhk", "root": "خلق"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "مَّآءٍ", "translit": "ٍءٓāَّm", "root": "موه"}, {"id": 4, "arabic": "دَافِقٍ", "translit": "ٍqِfāَd", "root": "دفق"}], "hasIhya": false}, {"ayah": 7, "text": "يَخْرُجُ مِنۢ بَيْنِ ٱلصُّلْبِ وَٱلتَّرَآئِبِ ", "translation": "Emerging from between the backbone and the ribs.", "words": [{"id": 1, "arabic": "يَخْرُجُ", "translit": "ُjgُrْhkَy", "root": "خرج"}, {"id": 2, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 3, "arabic": "بَيْنِ", "translit": "ِnْyَb", "root": "بين"}, {"id": 4, "arabic": "ٱلصُّلْبِ", "translit": "ِbْlُّṣlٱ", "root": "صلب"}, {"id": 5, "arabic": "وَٱلتَّرَآئِبِ", "translit": "ِbِyʾٓāَrَّtlٱَw", "root": "ترب"}], "hasIhya": false}, {"ayah": 8, "text": "إِنَّهُۥ عَلَىٰ رَجْعِهِۦ لَقَادِرٌ ", "translation": "Indeed, He [i.e., Allāh], to return him [to life], is Able.", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "رَجْعِهِۦ", "translit": "ۦِhِʿعْjgَr", "root": "رجع"}, {"id": 4, "arabic": "لَقَادِرٌ", "translit": "ٌrِdāَqَl", "root": "قدر"}], "hasIhya": false}, {"ayah": 9, "text": "يَوْمَ تُبْلَى ٱلسَّرَآئِرُ ", "translation": "The Day when secrets will be put on trial,[1]", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تُبْلَى", "translit": "àَlْbُt", "root": "بلو"}, {"id": 3, "arabic": "ٱلسَّرَآئِرُ", "translit": "ُrِyʾٓāَrَّslٱ", "root": "سرر"}], "hasIhya": false}, {"ayah": 10, "text": "فَمَا لَهُۥ مِن قُوَّةٍ وَلَا نَاصِرٍ ", "translation": "Then he [i.e., man] will have no power or any helper.", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قُوَّةٍ", "translit": "ٍẗَّwُq", "root": "قوي"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "نَاصِرٍ", "translit": "ٍrِṣāَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 11, "text": "وَٱلسَّمَآءِ ذَاتِ ٱلرَّجْعِ ", "translation": "By the sky which sends back[1]", "words": [{"id": 1, "arabic": "وَٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱَw", "root": "سمو"}, {"id": 2, "arabic": "ذَاتِ", "translit": "ِtāَhd", "root": ""}, {"id": 3, "arabic": "ٱلرَّجْعِ", "translit": "ِʿعْjgَّrlٱ", "root": "رجع"}], "hasIhya": false}, {"ayah": 12, "text": "وَٱلْأَرْضِ ذَاتِ ٱلصَّدْعِ ", "translation": "And [by] the earth which splits,[1]", "words": [{"id": 1, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 2, "arabic": "ذَاتِ", "translit": "ِtāَhd", "root": ""}, {"id": 3, "arabic": "ٱلصَّدْعِ", "translit": "ِʿعْdَّṣlٱ", "root": "صدع"}], "hasIhya": false}, {"ayah": 13, "text": "إِنَّهُۥ لَقَوْلٌ فَصْلٌ ", "translation": "Indeed, it [i.e., the Qur’ān] is a decisive statement,", "words": [{"id": 1, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "لَقَوْلٌ", "translit": "ٌlْwَqَl", "root": "قول"}, {"id": 3, "arabic": "فَصْلٌ", "translit": "ٌlْṣَf", "root": "فصل"}], "hasIhya": false}, {"ayah": 14, "text": "وَمَا هُوَ بِٱلْهَزْلِ ", "translation": "And it is not amusement.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "بِٱلْهَزْلِ", "translit": "ِlْzَhْlٱِb", "root": "هزل"}], "hasIhya": false}, {"ayah": 15, "text": "إِنَّهُمْ يَكِيدُونَ كَيْدًا ", "translation": "Indeed, they are planning a plan,", "words": [{"id": 1, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَكِيدُونَ", "translit": "َnwُdyِkَy", "root": "كيد"}, {"id": 3, "arabic": "كَيْدًا", "translit": "āًdْyَk", "root": "كيد"}], "hasIhya": true}, {"ayah": 16, "text": "وَأَكِيدُ كَيْدًا ", "translation": "But I am planning a plan.", "words": [{"id": 1, "arabic": "وَأَكِيدُ", "translit": "ُdyِkَaʾَw", "root": "كيد"}, {"id": 2, "arabic": "كَيْدًا", "translit": "āًdْyَk", "root": "كيد"}], "hasIhya": false}, {"ayah": 17, "text": "فَمَهِّلِ ٱلْكَٰفِرِينَ أَمْهِلْهُمْ رُوَيْدًۢا ", "translation": "So allow time for the disbelievers. Leave them awhile.[1]", "words": [{"id": 1, "arabic": "فَمَهِّلِ", "translit": "ِlِّhَmَf", "root": "مهل"}, {"id": 2, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 3, "arabic": "أَمْهِلْهُمْ", "translit": "ْmُhْlِhْmَaʾ", "root": "مهل"}, {"id": 4, "arabic": "رُوَيْدًۢا", "translit": "āًۢdْyَwُr", "root": "رود"}], "hasIhya": false}], "tafsir": {"15": [{"arabic": "الماكرين وقال تعالى إنهم يكيدون كيدا وأكيد كيدا فمهل الكافرين أمهلهم رويدا فكما لا يجوز للعبد المهمل أن يستدل بإهمال السيد إياه وتمكينه من النعم على حب السيد بل ينبغي أن يحذر أن يكون ذلك مكرا منه وكيدا مع أن السيد لم يحذره مكر نفسه فبأن يجب ذلك في حق الله تعالى مع تحذيره استدراجه أولى فإذن من أمن مكر الله فهو مغتر ومنشأ هذا الغرور أنه استدل بنعم الدنيا على أنه كريم عند ذلك المنعم واحتمل أن يكون ذلك دليل الهوان ولكن ذلك الاحتمال لا يوافق الهوى فالشيطان بواسطة الهوى يميل بالقلب إلى ما يوافقه وهو التصديق بدلالته على الكرامة وهذ", "english": "As for knowing it by way of authoritative transmission and affirmation (taṣdīq): it is that one believes in the Book of God — exalted is He — and affirms His Messenger. For God — exalted is He — has said: {«أيحسبون أن ما نمدهم به من مال وبنين * نسارع لهم في الخيرات بل لا يشعرون»} — \"Do they reckon that what We extend to them of wealth and sons — [that] We hasten for them good things? Nay, but they do not perceive\" (Q. 23:55-56). And He said — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — \"We shall draw them on by degrees from whence they do not know\" (Q. 7:182). And He said — exalted is He: {«فتحنا عليهم أبواب كل شيء حتى إذا فرحوا بما أوتوا أخذناهم بغتة فإذا هم مبلسون»} — \"We opened upon them the gates of everything, until when they rejoiced in what they were given, We seized them suddenly, and behold, they were in despair\" (Q. 6:44). And in the interpretation of His saying — exalted is He: {«سنستدرجهم من حيث لا يعلمون»} — it is said: \"Whenever they innovated a sin, We innovated for them a blessing, to increase their self-deception.\" And He said — exalted is He: {«إنما نملي لهم ليزدادوا إثما»} — \"We only grant them respite that they may increase in sin\" (Q. 3:178). And He said — exalted is He: {«ولا تحسبن الله غافلا عما يعمل الظالمون إنما يؤخرهم ليوم تشخص فيه الأبصار»} — \"And do not reckon God heedless of what the wrongdoers do; He only delays them to a Day when eyes will stare fixedly\" (Q. 14:42). And [there is] more of that kind which has come in the Book of God — exalted is He — and in the Sunnah of His Messenger. So whoever believes in it is delivered from this self-deception. For the origin of this self-deception is ignorance of God and of His attributes; for whoever knows Him does not feel secure from His stratagem (makr) and is not deceived by such corrupt fancies.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 888", "section_title_en": "Section 888 — On the Remedy for Self-Deception (Ghurūr): Recognizing the Signs of Divine Honor (Karāmah) and Humiliation (Hawān)", "section_index": 888, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; heedlessness in wakefulness; the blaze on a horse's forehead.\n  * Al-Raghib (Mufradat): \"Ghurūr\" is delusion stemming from heedlessness — the soul's being overtaken while imagining security, as in {«ما غرك بربك الكريم»} (Q. 82:6). It is the state of one who is deceived by apparent favors while blind to their underlying test.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): heedlessness and exposure to predation, like a gazelle deceived by moonlight. Metaphorical (Majaz): being \"deceived by God\" (ightirār billāh) — trusting in His mercy while persisting in disobedience.\n- Root: لهم (l-h-m)\n  * Lisan / Ayn: Swallowing whole; the gullet.\n  * Al-Raghib (Mufradat): \"Ilhām\" — God's casting a meaning into the heart (al-raw'), distinct from demonic whispering; the channel of inner vision for the knowers (ʿārifūn).\n  * Al-Zamakhshari (Asas): Literal: to swallow. Metaphorical: the heart's receptive \"swallowing\" of divine inspiration.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): \"Ḥudūth\" — a thing's coming to be after it was not; \"muḥdith\" — the originator, exclusively God for substances (jawāhir). \"Iḥdāth\" — bringing about a novel state or act.\n  * Al-Zamakhshari (Asas): Literal: temporal newness. Metaphorical: \"muḥaddath\" — one inspired with correct discernment, as if newly spoken-to.\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Softness, ease, well-being; a state of comfort.\n  * Al-Raghib (Mufradat): \"Niʿmah\" — the good state one inhabits; \"naʿīm\" — the act of living pleasantly. Blessings are both a test and a sign, per {«وإن تعدوا نعمة الله لا تحصوها»} (Q. 16:18).\n  * Al-Zamakhshari (Asas): Literal: bounty and comfort. Metaphorical: \"khafat naʿāmatuhum\" — their prosperity vanished; blessings may signal either favor or gradual ruin (istidrāj).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with \"innamā\")\n  * In {«إنما نملي لهم ليزدادوا إثما»} (Q. 3:178) and {«إنما يؤخرهم ليوم تشخص فيه الأبصار»} (Q. 14:42), \"innamā\" restricts the purpose of divine respite exclusively to increase of sin and deferred reckoning — negating any reading of it as benevolent indulgence.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Delusion'", "badge": "Ethics"}]}, "wordTiming": {"minshawi": {"1": [[1, 460, 3308], [2, 3308, 5290]], "86:1": [[1, 460, 3308], [2, 3308, 5290]], "2": [[1, 360, 2351], [2, 2351, 3629], [3, 3629, 4270], [4, 4270, 5730]], "86:2": [[1, 360, 2351], [2, 2351, 3629], [3, 3629, 4270], [4, 4270, 5730]], "3": [[1, 180, 1657], [2, 1657, 3720]], "86:3": [[1, 180, 1657], [2, 1657, 3720]], "4": [[1, 390, 968], [2, 968, 1691], [3, 1691, 2506], [4, 2506, 4253], [5, 4253, 6211], [6, 6211, 7800]], "86:4": [[1, 390, 968], [2, 968, 1691], [3, 1691, 2506], [4, 2506, 4253], [5, 4253, 6211], [6, 6211, 7800]], "5": [[1, 70, 2579], [2, 2579, 4721], [3, 4721, 5771], [4, 5771, 6870]], "86:5": [[1, 70, 2579], [2, 2579, 4721], [3, 4721, 5771], [4, 5771, 6870]], "6": [[1, 110, 981], [2, 981, 1501], [3, 1501, 4387], [4, 4387, 5920]], "86:6": [[1, 110, 981], [2, 981, 1501], [3, 1501, 4387], [4, 4387, 5920]], "7": [[1, 300, 1566], [2, 1566, 2022], [3, 2022, 2843], [4, 2843, 4106], [5, 4106, 7960]], "86:7": [[1, 300, 1566], [2, 1566, 2022], [3, 2022, 2843], [4, 2843, 4106], [5, 4106, 7960]], "8": [[1, 470, 1649], [2, 1649, 3056], [3, 3056, 4277], [4, 4277, 6170]], "86:8": [[1, 470, 1649], [2, 1649, 3056], [3, 3056, 4277], [4, 4277, 6170]], "9": [[1, 220, 1144], [2, 1144, 2049], [3, 2049, 4760]], "86:9": [[1, 220, 1144], [2, 1144, 2049], [3, 2049, 4760]], "10": [[1, 130, 1315], [2, 1315, 1794], [3, 1794, 2298], [4, 2298, 3861], [5, 3861, 5399], [6, 5399, 6900]], "86:10": [[1, 130, 1315], [2, 1315, 1794], [3, 1794, 2298], [4, 2298, 3861], [5, 3861, 5399], [6, 5399, 6900]], "11": [[1, 330, 3119], [2, 3119, 3978], [3, 3978, 4990]], "86:11": [[1, 330, 3119], [2, 3119, 3978], [3, 3978, 4990]], "12": [[1, 200, 1585], [2, 1585, 2509], [3, 2509, 3680]], "86:12": [[1, 200, 1585], [2, 1585, 2509], [3, 2509, 3680]], "13": [[1, 310, 1985], [2, 1985, 3854], [3, 3854, 5120]], "86:13": [[1, 310, 1985], [2, 1985, 3854], [3, 3854, 5120]], "14": [[1, 320, 1461], [2, 1461, 2078], [3, 2078, 3060]], "86:14": [[1, 320, 1461], [2, 1461, 2078], [3, 2078, 3060]], "15": [[1, 300, 1492]