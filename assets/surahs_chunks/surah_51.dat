حِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 44, "text": "فَعَتَوْاْ عَنَ اَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ اُ۬لصَّٰعِقَةُ وَهُمْ يَنظُرُونَۖ", "words": [{"id": 1, "arabic": "فَعَتَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَمْرِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَخَذَتْهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لصَّٰعِقَةُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَنظُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 45, "text": "فَمَا اَ۪سْتَطَٰعُواْ مِن قِيَامࣲ وَمَا كَانُواْ مُنتَصِرِينَۖ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪سْتَطَٰعُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قِيَامࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُنتَصِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 46, "text": "وَقَوْمَ نُوحࣲ مِّن قَبْلُۖ إِنَّهُمْ كَانُواْ قَوْماࣰ فَٰسِقِينَۖ", "words": [{"id": 1, "arabic": "وَقَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نُوحࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَٰسِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 47, "text": "وَالسَّمَآءَ بَنَيْنَٰهَا بِأَيَيْدࣲۖ وَإِنَّا لَمُوسِعُونَۖ", "words": [{"id": 1, "arabic": "وَالسَّمَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَنَيْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِأَيَيْدࣲۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَمُوسِعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 48, "text": "وَالَارْضَ فَرَشْنَٰهَاۖ فَنِعْمَ اَ۬لْمَٰهِدُونَۖ", "words": [{"id": 1, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَرَشْنَٰهَاۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَنِعْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَٰهِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 49, "text": "وَمِن كُلِّ شَےْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَّكَّرُونَۖ", "words": [{"id": 1, "arabic": "وَمِن", "translit": "", "root": ""}, {"id": 2, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "زَوْجَيْنِ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَعَلَّكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَذَّكَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 50, "text": "فَفِرُّوٓاْ إِلَي اَ۬للَّهِ إِنِّے لَكُم مِّنْهُ نَذِيرࣱ مُّبِينࣱۖ", "words": [{"id": 1, "arabic": "فَفِرُّوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 5, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَذِيرࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 51, "text": "وَلَا تَجْعَلُواْ مَعَ اَ۬للَّهِ إِلَٰهاً اٰخَرَ إِنِّے لَكُم مِّنْهُ نَذِيرࣱ مُّبِينࣱۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَجْعَلُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهاً", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰخَرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 8, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "نَذِيرࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 52, "text": "كَذَٰلِكَۖ مَآ أَتَي اَ۬لذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ اِلَّا قَالُواْ سَاحِرٌ اَوْ مَجْنُونٌۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَتَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "قَبْلِهِم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 8, "arabic": "رَّسُولٍ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَاحِرٌ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَجْنُونٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 53, "text": "اَتَوَاصَوْاْ بِهِۦۖ بَلْ هُمْ قَوْمࣱ طَاغُونَۖ", "words": [{"id": 1, "arabic": "اَتَوَاصَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِۦۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 4, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "طَاغُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 54, "text": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومࣲ‏", "words": [{"id": 1, "arabic": "فَتَوَلَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَمَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِمَلُومࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 55, "text": "وَذَكِّرْۖ فَإِنَّ اَ۬لذِّكْر۪يٰ تَنفَعُ اُ۬لْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "وَذَكِّرْۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِّكْر۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَنفَعُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 56, "text": "۞وَمَا خَلَقْتُ اُ۬لْجِنَّ وَالِانسَ إِلَّا لِيَعْبُدُونِۖ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْجِنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالِانسَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "لِيَعْبُدُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 57, "text": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقࣲ وَمَآ أُرِيدُ أَنْ يُّطْعِمُونِۖ", "words": [{"id": 1, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أُرِيدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "رِّزْقࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَا