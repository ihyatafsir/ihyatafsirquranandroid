ic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "خَطْبُكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَيُّهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُرْسَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 32, "text": "قَالُوٓاْ إِنَّآ أُرْسِلْنَآ إِلَيٰ قَوْمࣲ مُّجْرِمِينَ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُرْسِلْنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّجْرِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 33, "text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةࣰ مِّن طِينࣲ‏", "words": [{"id": 1, "arabic": "لِنُرْسِلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "حِجَارَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "طِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 34, "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَۖ", "words": [{"id": 1, "arabic": "مُّسَوَّمَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلْمُسْرِفِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 35, "text": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ اَ۬لْمُومِنِينَ", "words": [{"id": 1, "arabic": "فَأَخْرَجْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُومِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 36, "text": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتࣲ مِّنَ اَ۬لْمُسْلِمِينَ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "وَجَدْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْتࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُسْلِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 37, "text": "وَتَرَكْنَا فِيهَآ ءَايَةࣰ لِّلذِينَ يَخَافُونَ اَ۬لْعَذَابَ اَ۬لَالِيمَۖ", "words": [{"id": 1, "arabic": "وَتَرَكْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَايَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّلذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَخَافُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَذَابَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لَالِيمَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 38, "text": "وَفِے مُوس۪يٰٓ إِذَ اَرْسَلْنَٰهُ إِلَيٰ فِرْعَوْنَ بِسُلْطَٰنࣲ مُّبِينࣲ‏", "words": [{"id": 1, "arabic": "وَفِے", "translit": "", "root": ""}, {"id": 2, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَرْسَلْنَٰهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِسُلْطَٰنࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 39, "text": "فَتَوَلّ۪يٰ بِرُكْنِهِۦ وَقَالَ سَٰحِرٌ اَوْ مَجْنُونࣱۖ", "words": [{"id": 1, "arabic": "فَتَوَلّ۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِرُكْنِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَٰحِرٌ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَجْنُونࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 40, "text": "فَأَخَذْنَٰهُ وَجُنُودَهُۥ فَنَبَذْنَٰهُمْ فِے اِ۬لْيَمِّ وَهُوَ مُلِيمࣱۖ", "words": [{"id": 1, "arabic": "فَأَخَذْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَجُنُودَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَنَبَذْنَٰهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْيَمِّ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهُوَ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُلِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 41, "text": "وَفِے عَادٍ اِذَ اَرْسَلْنَا عَلَيْهِمُ اُ۬لرِّيحَ اَ۬لْعَقِيمَ", "words": [{"id": 1, "arabic": "وَفِے", "translit": "", "root": ""}, {"id": 2, "arabic": "عَادٍ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِذَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَرْسَلْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيْهِمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لرِّيحَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْعَقِيمَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 42, "text": "مَا تَذَرُ مِن شَےْءٍ اَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَالرَّمِيمِۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَذَرُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَتَتْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "جَعَلَتْهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَالرَّمِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 43, "text": "وَفِے ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُواْ حَتَّيٰ حِينࣲ‏", "words": [{"id": 1, "arabic": "وَفِے", "translit": "", "root": ""}, {"id": 2, "arabic": "ثَمُودَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 4, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَمَتَّعُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "حِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 44, "text": "فَعَتَوْاْ عَنَ اَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ اُ۬لصَّٰعِقَةُ وَهُمْ يَنظُرُونَۖ", "words": [{"id": 1, "arabic": "فَعَتَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَمْرِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَخَذَتْهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لصَّٰعِقَةُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَنظُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 45, "text": "فَمَا اَ۪سْتَطَٰعُواْ مِن قِيَامࣲ وَمَا كَانُواْ مُنتَصِرِينَۖ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪سْتَطَٰعُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قِيَامࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُنتَصِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 46, "text": "وَقَوْمَ نُوحࣲ مِّن قَبْلُۖ إِنَّهُمْ كَانُواْ قَوْماࣰ فَٰسِقِينَۖ", "words": [{"id": 1, "arabic": "وَقَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نُوحࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَٰسِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 47, "text": "وَالسَّمَآءَ بَنَيْنَٰهَا بِأَيَيْدࣲۖ وَإِنَّا لَمُوسِعُونَۖ", "words": [{"id": 1, "arabic": "وَالسَّمَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَنَيْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِأَيَيْدࣲۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَمُوسِعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 48, "text": "وَالَارْضَ فَرَشْنَٰهَاۖ فَنِعْمَ اَ۬لْمَٰهِدُونَۖ", "words": [{"id": 1, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَرَشْنَٰهَاۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَنِعْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَٰهِدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 49, "text": "وَمِن كُلِّ شَےْءٍ خَلَقْنَا زَوْجَيْنِ لَعَلَّكُمْ تَذَّكَّرُونَۖ", "words": [{"id": 1, "arabic": "وَمِن", "translit": "", "root": ""}, {"id": 2, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 3, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 4, "arabic": "خَلَقْنَا", "translit": "", "root": ""}, {"id": 5, "arabic": "زَوْجَيْنِ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَعَلَّكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "تَذَّكَّرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 50, "text": "فَفِرُّوٓاْ إِلَي اَ۬للَّهِ إِنِّے لَكُم مِّنْهُ نَذِيرࣱ مُّبِينࣱۖ", "words": [{"id": 1, "arabic": "فَفِرُّوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 5, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "نَذِيرࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 51, "text": "وَلَا تَجْعَلُواْ مَعَ اَ۬للَّهِ إِلَٰهاً اٰخَرَ إِنِّے لَكُم مِّنْهُ نَذِيرࣱ مُّبِينࣱۖ", "words": [{"id": 1, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَجْعَلُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَعَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَٰهاً", "translit": "", "root": ""}, {"id": 6, "arabic": "اٰخَرَ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنِّے", "translit": "", "root": ""}, {"id": 8, "arabic": "لَكُم", "translit": "", "root": ""}, {"id": 9, "arabic": "مِّنْهُ", "translit": "", "root": ""}, {"id": 10, "arabic": "نَذِيرࣱ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّبِينࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 52, "text": "كَذَٰلِكَۖ مَآ أَتَي اَ۬لذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ اِلَّا قَالُواْ سَاحِرٌ اَوْ مَجْنُونٌۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَتَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "قَبْلِهِم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 8, "arabic": "رَّسُولٍ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَاحِرٌ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَجْنُونٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 53, "text": "اَتَوَاصَوْاْ بِهِۦۖ بَلْ هُمْ قَوْمࣱ طَاغُونَۖ", "words": [{"id": 1, "arabic": "اَتَوَاصَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِۦۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 4, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "طَاغُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 54, "text": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومࣲ‏", "words": [{"id": 1, "arabic": "فَتَوَلَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَمَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِمَلُومࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 55, "text": "وَذَكِّرْۖ فَإِنَّ اَ۬لذِّكْر۪يٰ تَنفَعُ اُ۬لْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "وَذَكِّرْۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِّكْر۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَنفَعُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 56, "text": "۞وَمَا خَلَقْتُ اُ۬لْجِنَّ وَالِانسَ إِلَّا لِيَعْبُدُونِۖ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْجِنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالِانسَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "لِيَعْبُدُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 57, "text": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقࣲ وَمَآ أُرِيدُ أَنْ يُّطْعِمُونِۖ", "words": [{"id": 1, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أُرِيدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "رِّزْقࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أُرِيدُ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُّطْعِمُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 58, "text": "إِنَّ اَ۬للَّهَ هُوَ اَ۬لرَّزَّاقُ ذُو اُ۬لْقُوَّةِ اِ۬لْمَتِينُۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لرَّزَّاقُ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذُو", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْقُوَّةِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْمَتِينُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 59, "text": "فَإِنَّ لِلذِينَ ظَلَمُواْ ذَنُوباࣰ مِّثْلَ ذَنُوبِ أَصْحَٰبِهِمْ فَلَا يَسْتَعْجِلُونِۖ", "words": [{"id": 1, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "لِلذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ظَلَمُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "ذَنُوباࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّثْلَ", "translit": "", "root"