: "", "root": ""}, {"id": 3, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبُّكِۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُۥ", "translit": "", "root": ""}, {"id": 6, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْحَكِيمُ", "translit": "", "root": ""}, {"id": 8, "arabic": "اُ۬لْعَلِيمُۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 31, "text": "۞قَالَ فَمَا خَطْبُكُمُۥٓ أَيُّهَا اَ۬لْمُرْسَلُونَۖ", "words": [{"id": 1, "arabic": "۞قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 3, "arabic": "خَطْبُكُمُۥٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَيُّهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬لْمُرْسَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 32, "text": "قَالُوٓاْ إِنَّآ أُرْسِلْنَآ إِلَيٰ قَوْمࣲ مُّجْرِمِينَ", "words": [{"id": 1, "arabic": "قَالُوٓاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أُرْسِلْنَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُّجْرِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 33, "text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةࣰ مِّن طِينࣲ‏", "words": [{"id": 1, "arabic": "لِنُرْسِلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "حِجَارَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "طِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 34, "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَۖ", "words": [{"id": 1, "arabic": "مُّسَوَّمَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 3, "