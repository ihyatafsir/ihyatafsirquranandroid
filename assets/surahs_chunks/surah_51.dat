"translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 42, "text": "مَا تَذَرُ مِن شَےْءٍ اَتَتْ عَلَيْهِ إِلَّا جَعَلَتْهُ كَالرَّمِيمِۖ", "words": [{"id": 1, "arabic": "مَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَذَرُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "شَےْءٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَتَتْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 8, "arabic": "جَعَلَتْهُ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَالرَّمِيمِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 43, "text": "وَفِے ثَمُودَ إِذْ قِيلَ لَهُمْ تَمَتَّعُواْ حَتَّيٰ حِينࣲ‏", "words": [{"id": 1, "arabic": "وَفِے", "translit": "", "root": ""}, {"id": 2, "arabic": "ثَمُودَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذْ", "translit": "", "root": ""}, {"id": 4, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "تَمَتَّعُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "حِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 44, "text": "فَعَتَوْاْ عَنَ اَمْرِ رَبِّهِمْ فَأَخَذَتْهُمُ اُ۬لصَّٰعِقَةُ وَهُمْ يَنظُرُونَۖ", "words": [{"id": 1, "arabic": "فَعَتَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَمْرِ", "translit": "", "root": ""}, {"id": 4, "arabic": "رَبِّهِمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَأَخَذَتْهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لصَّٰعِقَةُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَنظُرُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 45, "text": "فَمَا اَ۪سْتَطَٰعُواْ مِن قِيَامࣲ وَمَا كَانُواْ مُنتَصِرِينَۖ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪سْتَطَٰعُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِن", "translit": "", "root": ""}, {"id": 4, "arabic": "قِيَامࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُنتَصِرِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 46, "text": "وَقَوْمَ نُوحࣲ مِّن قَبْلُۖ إِنَّهُمْ كَانُواْ قَوْماࣰ فَٰسِقِينَۖ", "words": [{"id": 1, "arabic": "وَقَوْمَ", "translit": "", "root": ""}, {"id": 2, "arabic": "نُوحࣲ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 4, "arabic": "قَبْلُۖ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "فَٰسِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 47, "text": "وَالسَّمَآءَ بَنَيْنَٰهَا بِأَيَيْدࣲۖ وَإِنَّا لَمُوسِعُونَۖ", "words": [{"id": 1, "arabic": "وَالسَّمَآءَ", "translit": "", "root": ""}, {"id": 2, "arabic": "بَنَيْنَٰهَا", "translit": "", "root": ""}, {"id": 3, "arabic": "بِأَيَيْدࣲۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَإِنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَمُوسِعُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 48, "text": "وَالَارْضَ فَرَشْنَٰهَاۖ فَنِعْمَ اَ۬لْمَٰهِدُونَۖ", "words": [{"id": 1, "arabic": "وَالَارْضَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَرَشْنَٰهَاۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَنِعْمَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمَٰهِدُونَۖ", "translit": "", "root": ""}], "na