bic": "مُّجْرِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 33, "text": "لِنُرْسِلَ عَلَيْهِمْ حِجَارَةࣰ مِّن طِينࣲ‏", "words": [{"id": 1, "arabic": "لِنُرْسِلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "حِجَارَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "طِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 34, "text": "مُّسَوَّمَةً عِندَ رَبِّكَ لِلْمُسْرِفِينَۖ", "words": [{"id": 1, "arabic": "مُّسَوَّمَةً", "translit": "", "root": ""}, {"id": 2, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِلْمُسْرِفِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 35, "text": "فَأَخْرَجْنَا مَن كَانَ فِيهَا مِنَ اَ۬لْمُومِنِينَ", "words": [{"id": 1, "arabic": "فَأَخْرَجْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَن", "translit": "", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْمُومِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 36, "text": "فَمَا وَجَدْنَا فِيهَا غَيْرَ بَيْتࣲ مِّنَ اَ۬لْمُسْلِمِينَ", "words": [{"id": 1, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "وَجَدْنَا", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيهَا", "translit": "", "root": ""}, {"id": 4, "arabic": "غَيْرَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَيْتࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْمُسْلِمِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 37, "text": "وَتَرَكْنَا فِيهَآ ءَايَةࣰ لِّلذِينَ يَخَافُونَ اَ۬لْعَذَابَ اَ۬لَالِيمَۖ", "words": [{"id": 1, "arabic": "وَتَرَكْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَايَةࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّلذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَخَافُونَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لْعَذَابَ", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لَالِيمَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 38, "text": "وَفِے مُوس۪يٰٓ إِذَ اَرْسَلْنَٰهُ إِلَيٰ فِرْعَوْنَ بِسُلْطَٰنࣲ مُّبِينࣲ‏", "words": [{"id": 1, "arabic": "وَفِے", "translit": "", "root": ""}, {"id": 2, "arabic": "مُوس۪يٰٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَرْسَلْنَٰهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فِرْعَوْنَ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِسُلْطَٰنࣲ", "translit": "", "root": ""}, {"id": 8, "arabic": "مُّبِينࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 39, "text": "فَتَوَلّ۪يٰ بِرُكْنِهِۦ وَقَالَ سَٰحِرٌ اَوْ مَجْنُونࣱۖ", "words": [{"id": 1, "arabic": "فَتَوَلّ۪يٰ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِرُكْنِهِۦ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَقَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "سَٰحِرٌ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 6, "arabic": "مَجْنُونࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 40, "text": "فَأَخَذْنَٰهُ وَجُنُودَهُۥ فَنَبَذْنَٰهُمْ فِے اِ۬لْيَمِّ وَهُوَ مُلِيمࣱۖ", "words": [{"id": 1, "arabic": "فَأَخَذْنَٰهُ", "translit": "", "root": ""}, {"id": 2, "arabic": "وَجُنُودَهُۥ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَنَبَذْنَٰهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}