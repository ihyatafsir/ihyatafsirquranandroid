, "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 52, "text": "كَذَٰلِكَۖ مَآ أَتَي اَ۬لذِينَ مِن قَبْلِهِم مِّن رَّسُولٍ اِلَّا قَالُواْ سَاحِرٌ اَوْ مَجْنُونٌۖ", "words": [{"id": 1, "arabic": "كَذَٰلِكَۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَتَي", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "قَبْلِهِم", "translit": "", "root": ""}, {"id": 7, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 8, "arabic": "رَّسُولٍ", "translit": "", "root": ""}, {"id": 9, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 10, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَاحِرٌ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَجْنُونٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 53, "text": "اَتَوَاصَوْاْ بِهِۦۖ بَلْ هُمْ قَوْمࣱ طَاغُونَۖ", "words": [{"id": 1, "arabic": "اَتَوَاصَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِهِۦۖ", "translit": "", "root": ""}, {"id": 3, "arabic": "بَلْ", "translit": "", "root": ""}, {"id": 4, "arabic": "هُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 6, "arabic": "طَاغُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 54, "text": "فَتَوَلَّ عَنْهُمْ فَمَآ أَنتَ بِمَلُومࣲ‏", "words": [{"id": 1, "arabic": "فَتَوَلَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَنْهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَمَآ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنتَ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِمَلُومࣲ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 55, "text": "وَذَكِّرْۖ فَإِنَّ اَ۬لذِّكْر۪يٰ تَنفَعُ اُ۬لْمُومِنِينَۖ", "words": [{"id": 1, "arabic": "وَذَكِّرْۖ", "translit": "", "root": ""}, {"id": 2, "arabic": "فَإِنَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لذِّكْر۪يٰ", "translit": "", "root": ""}, {"id": 4, "arabic": "تَنفَعُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬لْمُومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 56, "text": "۞وَمَا خَلَقْتُ اُ۬لْجِنَّ وَالِانسَ إِلَّا لِيَعْبُدُونِۖ", "words": [{"id": 1, "arabic": "۞وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "خَلَقْتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْجِنَّ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالِانسَ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 6, "arabic": "لِيَعْبُدُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 57, "text": "مَآ أُرِيدُ مِنْهُم مِّن رِّزْقࣲ وَمَآ أُرِيدُ أَنْ يُّطْعِمُونِۖ", "words": [{"id": 1, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 2, "arabic": "أُرِيدُ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِنْهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 5, "arabic": "رِّزْقࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 7, "arabic": "أُرِيدُ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 9, "arabic": "يُّطْعِمُونِۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 51, "ayah": 58, "text": "إِنَّ اَ۬للَّهَ هُوَ اَ۬لرَّزَّاقُ ذُو اُ۬لْقُوَّةِ اِ۬لْمَتِينُۖ", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 3, "arabic": "هُوَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لرَّزَّاقُ", "translit": "", "root": ""}, {"id": 5, "arabic": "ذُو", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْقُوَّةِ", "translit": "", "root": ""}