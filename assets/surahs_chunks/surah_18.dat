 "مَّٰكِثِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "فِيهِ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَبَداࣰ‏", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 4, "text": "وَيُنذِرَ اَ۬لذِينَ قَالُواْ اُ۪تَّخَذَ اَ۬للَّهُ وَلَداࣰۖ", "words": [{"id": 1, "arabic": "وَيُنذِرَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَالُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۪تَّخَذَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَداࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 5, "text": "مَّا لَهُم بِهِۦ مِنْ عِلْمࣲ وَلَا لِأٓبَآئِهِمْۖ كَبُرَتْ كَلِمَةࣰ تَخْرُجُ مِنَ اَفْوَٰهِهِمُۥٓۖ إِنْ يَّقُولُونَ إِلَّا كَذِباࣰۖ", "words": [{"id": 1, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عِلْمࣲ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لِأٓبَآئِهِمْۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "كَبُرَتْ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَلِمَةࣰ", "translit": "", "root": ""}, {"id": 10, "arabic": "تَخْرُجُ", "translit": "", "root": ""}, {"id": 11, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَفْوَٰهِهِمُۥٓۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِنْ", "translit": "", "root": ""}, {"id": 14, "arabic": "يَّقُولُونَ", "translit": "", "root": ""}, {"id": 15, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 16, "arabic": "كَذِباࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 6, "text": "فَلَعَلَّكَ بَٰخِعࣱ نَّفْسَكَ عَلَيٰٓ ءَاثٰ۪رِهِمُۥٓ إِن لَّمْ يُومِنُواْ بِهَٰذَا اَ۬لْحَدِي