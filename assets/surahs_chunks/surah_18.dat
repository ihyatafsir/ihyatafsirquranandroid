ration": "warsh"}, {"surah": 18, "ayah": 63, "text": "قَالَ أَرَٰٓيْتَ إِذَ اَوَيْنَآ إِلَي اَ۬لصَّخْرَةِ فَإِنِّے نَسِيتُ اُ۬لْحُوتَۖ وَمَآ أَنس۪يٰنِيهِ إِلَّا اَ۬لشَّيْطَٰنُ أَنَ اَذْكُرَهُۥۖ وَاتَّخَذَ سَبِيلَهُۥ فِے اِ۬لْبَحْرِۖ عَجَباࣰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرَٰٓيْتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَوَيْنَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لصَّخْرَةِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَإِنِّے", "translit": "", "root": ""}, {"id": 8, "arabic": "نَسِيتُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لْحُوتَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَنس۪يٰنِيهِ", "translit": "", "root": ""}, {"id": 12, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لشَّيْطَٰنُ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَنَ", "translit": "", "root": ""}, {"id": 15, "arabic": "اَذْكُرَهُۥۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَاتَّخَذَ", "translit": "", "root": ""}, {"id": 17, "arabic": "سَبِيلَهُۥ", "translit": "", "root": ""}, {"id": 18, "arabic": "فِے", "translit": "", "root": ""}, {"id": 19, "arabic": "اِ۬لْبَحْرِۖ", "translit": "", "root": ""}, {"id": 20, "arabic": "عَجَباࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 64, "text": "قَالَ ذَٰلِكَ مَا كُنَّا نَبْغِۦۖ فَارْتَدَّا عَلَيٰٓ ءَاث۪ارِهِمَا قَصَصاࣰ‏", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "", "root": ""}, {"id": 4, "arabic": "كُنَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "نَبْغِۦۖ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَارْتَدَّا", "translit": 