"ayah": 100, "text": "وَعَرَضْنَا جَهَنَّمَ يَوْمَئِذࣲ لِّلْكٰ۪فِرِينَ عَرْضاً", "words": [{"id": 1, "arabic": "وَعَرَضْنَا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَوْمَئِذࣲ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّلْكٰ۪فِرِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَرْضاً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 101, "text": "اِ۬لذِينَ كَانَتَ اَعْيُنُهُمْ فِے غِطَآءٍ عَن ذِكْرِے وَكَانُواْ لَا يَسْتَطِيعُونَ سَمْعاًۖ", "words": [{"id": 1, "arabic": "اِ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "كَانَتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَعْيُنُهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "غِطَآءٍ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَن", "translit": "", "root": ""}, {"id": 7, "arabic": "ذِكْرِے", "translit": "", "root": ""}, {"id": 8, "arabic": "وَكَانُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "", "root": ""}, {"id": 10, "arabic": "يَسْتَطِيعُونَ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَمْعاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 102, "text": "۞اَفَحَسِبَ اَ۬لذِينَ كَفَرُوٓاْ أَنْ يَّتَّخِذُواْ عِبَادِے مِن دُونِيَ أَوْلِيَآءَۖ ا۪نَّآ أَعْتَدْنَا جَهَنَّمَ لِلْكٰ۪فِرِينَ نُزُلاࣰۖ", "words": [{"id": 1, "arabic": "۞اَفَحَسِبَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓاْ", "translit": "", "root": ""}, {"id": 4, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَّتَّخِذُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "عِبَادِے", "translit": "", "root": ""}, {"id": 7, "arabic": "مِن", "translit": "", "root": ""}, {"id": 8, "arabic": "دُونِيَ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَوْلِيَآءَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "ا۪نَّآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَعْتَدْنَا", "translit": "", "root": ""}, {"id": 12, "arabic": "جَهَنَّمَ", "translit": "", "root": ""}, {"id": 13, "arabic": "لِلْكٰ۪فِرِينَ", "translit": "", "root": ""}, {"id": 14, "arabic": "نُزُلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 103, "text": "قُلْ هَلْ نُنَبِّئُكُم بِالَاخْسَرِينَ أَعْمَٰلاً", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 3, "arabic": "نُنَبِّئُكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "بِالَاخْسَرِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَعْمَٰلاً", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 104, "text": "اِ۬لذِينَ ضَلَّ سَعْيُهُمْ فِے اِ۬لْحَيَوٰةِ اِ۬لدُّنْي۪ا وَهُمْ يَحْسِبُونَ أَنَّهُمْ يُحْسِنُونَ صُنْعاًۖ", "words": [{"id": 1, "arabic": "اِ۬لذِينَ", "translit": "", "root": ""}, {"id": 2, "arabic": "ضَلَّ", "translit": "", "root": ""}, {"id": 3, "arabic": "سَعْيُهُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "فِے", "translit": "", "root": ""}, {"id": 5, "arabic": "اِ۬لْحَيَوٰةِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَحْسِبُونَ", "translit": "", "root": ""}, {"id": 9, "arabic": "أَنَّهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يُحْسِنُونَ", "translit": "", "root": ""}, {"id": 11, "arabic": "صُنْعاًۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 105, "text": "ا۟وْلَٰٓئِكَ اَ۬لذِينَ كَفَرُواْ بِـَٔايَٰتِ رَبِّهِمْ وَلِقَآئِهِۦ فَحَبِطَتَ اَعْمَٰلُهُمْ فَلَا نُقِيمُ لَهُمْ يَوْمَ اَ۬لْقِيَٰمَةِ وَزْناࣰۖ", "words": [{"id": 1, "arabic": "ا۟وْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "ar