it": "", "root": ""}, {"id": 10, "arabic": "اِ۬لْبَحْرِ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَرَباࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 62, "text": "فَلَمَّا جَاوَزَا قَالَ لِفَت۪يٰهُ ءَاتِنَا غَدَآءَنَا لَقَدْ لَقِينَا مِن سَفَرِنَا هَٰذَا نَصَباࣰۖ", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَاوَزَا", "translit": "", "root": ""}, {"id": 3, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِفَت۪يٰهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَاتِنَا", "translit": "", "root": ""}, {"id": 6, "arabic": "غَدَآءَنَا", "translit": "", "root": ""}, {"id": 7, "arabic": "لَقَدْ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَقِينَا", "translit": "", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "", "root": ""}, {"id": 10, "arabic": "سَفَرِنَا", "translit": "", "root": ""}, {"id": 11, "arabic": "هَٰذَا", "translit": "", "root": ""}, {"id": 12, "arabic": "نَصَباࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 18, "ayah": 63, "text": "قَالَ أَرَٰٓيْتَ إِذَ اَوَيْنَآ إِلَي اَ۬لصَّخْرَةِ فَإِنِّے نَسِيتُ اُ۬لْحُوتَۖ وَمَآ أَنس۪يٰنِيهِ إِلَّا اَ۬لشَّيْطَٰنُ أَنَ اَذْكُرَهُۥۖ وَاتَّخَذَ سَبِيلَهُۥ فِے اِ۬لْبَحْرِۖ عَجَباࣰۖ", "words": [{"id": 1, "arabic": "قَالَ", "translit": "", "root": ""}, {"id": 2, "arabic": "أَرَٰٓيْتَ", "translit": "", "root": ""}, {"id": 3, "arabic": "إِذَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَوَيْنَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬لصَّخْرَةِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَإِنِّے", "translit": "", "root": ""}, {"id": 8, "arabic": "نَسِيتُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۬لْحُوتَۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَنس۪يٰنِيهِ", "translit": "", "root": ""}, 