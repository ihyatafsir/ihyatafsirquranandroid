a": true}, {"ayah": 48, "text": "وَعُرِضُوا۟ عَلَىٰ رَبِّكَ صَفًّا لَّقَدْ جِئْتُمُونَا كَمَا خَلَقْنَٰكُمْ أَوَّلَ مَرَّةٍۭۚ بَلْ زَعَمْتُمْ أَلَّن نَّجْعَلَ لَكُم مَّوْعِدًا ", "translation": "And they will be presented before your Lord in rows, [and He will say], \"You have certainly come to Us just as We created you the first time. But you claimed that We would never make for you an appointment.\"", "words": [{"id": 1, "arabic": "وَعُرِضُوا۟", "translit": "۟āwُḍِrُʿعَw", "root": "عرض"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 4, "arabic": "صَفًّا", "translit": "āًّfَṣ", "root": "صفف"}, {"id": 5, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": ""}, {"id": 6, "arabic": "جِئْتُمُونَا", "translit": "āَnwُmُtْyʾِjg", "root": "جيا"}, {"id": 7, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 8, "arabic": "خَلَقْنَٰكُمْ", "translit": "ْmُkَٰnْqَlَhk", "root": "خلق"}, {"id": 9, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 10, "arabic": "مَرَّةٍۭ", "translit": "ٍۭẗَّrَm", "root": "مرر"}, {"id": 11, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 12, "arabic": "زَعَمْتُمْ", "translit": "ْmُtْmَʿعَz", "root": "زعم"}, {"id": 13, "arabic": "أَلَّن", "translit": "nَّlَaʾ", "root": ""}, {"id": 14, "arabic": "نَّجْعَلَ", "translit": "َlَʿعْjgَّn", "root": "جعل"}, {"id": 15, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 16, "arabic": "مَّوْعِدًا", "translit": "āًdِʿعْwَّm", "root": "وعد"}], "hasIhya": false}, {"ayah": 49, "text": "وَوُضِعَ ٱلْكِتَٰبُ فَتَرَى ٱلْمُجْرِمِينَ مُشْفِقِينَ مِمَّا فِيهِ وَيَقُولُونَ يَٰوَيْلَتَنَا مَالِ هَٰذَا ٱلْكِتَٰبِ لَا يُغَادِرُ صَغِيرَةً وَلَا كَبِيرَةً إِلَّآ أَحْصَىٰهَاۚ وَوَجَدُوا۟ مَا عَمِلُوا۟ حَاضِرًاۗ وَلَا يَظْلِمُ رَبُّكَ أَحَدًا ", "translation": "And the record [of deeds] will be placed [open], and you will see the criminals fearful of that within it, and they will say, \"Oh, woe to us! What is this book that leaves nothing small or great except that it has enumerated it?\" And they will find what they did present [before them]. And your Lord does injustice to no one.", "words": [{"id": 1, "arabic": "وَوُضِعَ", "translit": "َʿعِḍُwَw", "root": "وضع"}, {"id": 2, "arabic": "ٱلْكِتَٰبُ", "translit": "ُbَٰtِkْlٱ", "root": "كتب"}, {"id": 3, "arabic": "فَتَرَى", "translit": "àَrَtَf", "root": "راي"}, {"id": 4, "arabic": "ٱلْمُجْرِمِينَ", "translit": "َnyِmِrْjgُmْlٱ", "root": "جرم"}, {"id": 5, "arabic": "مُشْفِقِينَ", "translit": "َnyِqِfْhsُm", "root": "شفق"}, {"id": 6, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 9, "arabic": "يَٰوَيْلَتَنَا", "translit": "āَnَtَlْyَwَٰy", "root": ""}, {"id": 10, "arabic": "مَالِ", "translit": "ِlāَm", "root": ""}, {"id": 11, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 12, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 13, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 14, "arabic": "يُغَادِرُ", "translit": "ُrِdāَغُy", "root": "غدر"}, {"id": 15, "arabic": "صَغِيرَةً", "translit": "ًẗَryِغَṣ", "root": "صغر"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "كَبِيرَةً", "translit": "ًẗَryِbَk", "root": "كبر"}, {"id": 18, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 19, "arabic": "أَحْصَىٰهَا", "translit": "āَhٰàَṣْḥَaʾ", "root": "حصي"}, {"id": 20, "arabic": "وَوَجَدُوا۟", "translit": "۟āwُdَjgَwَw", "root": "وجد"}, {"id": 21, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 22, "arabic": "عَمِلُوا۟", "translit": "۟āwُlِmَʿع", "root": "عمل"}, {"id": 23, "arabic": "حَاضِرًا", "translit": "āًrِḍāَḥ", "root": "حضر"}, {"id": 24, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 25, "arabic": "يَظْلِمُ", "translit": "ُmِlْẓَy", "root": "ظلم"}, {"id": 26, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 27, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}], "hasIhya": true}, {"ayah": 50, "text": "وَإِذْ قُلْنَا لِلْمَلَٰٓئِكَةِ ٱسْجُدُوا۟ لِءَادَمَ فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ كَانَ مِنَ ٱلْجِنِّ فَفَسَقَ عَنْ أَمْرِ رَبِّهِۦٓۗ أَفَتَتَّخِذُونَهُۥ وَذُرِّيَّتَهُۥٓ أَوْلِيَآءَ مِن دُونِى وَهُمْ لَكُمْ عَدُوٌّۢۚ بِئْسَ لِلظَّٰلِمِينَ بَدَلًا ", "translation": "And [mention] when We said to the angels, \"Prostrate to Adam,\" and they prostrated, except for Iblees. He was of the jinn and departed from [i.e., disobeyed] the command of his Lord. Then will you take him and his descendants as allies other than Me while they are enemies to you? Wretched it is for the wrongdoers as an exchange.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 3, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlِl", "root": "ملك"}, {"id": 4, "arabic": "ٱسْجُدُوا۟", "translit": "۟āwُdُjgْsٱ", "root": "سجد"}, {"id": 5, "arabic": "لِءَادَمَ", "translit": "َmَdāَءِl", "root": "ادم"}, {"id": 6, "arabic": "فَسَجَدُوٓا۟", "translit": "۟āٓwُdَjgَsَf", "root": "سجد"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "إِبْلِيسَ", "translit": "َsyِlْbِiʾ", "root": ""}, {"id": 9, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْجِنِّ", "translit": "ِّnِjgْlٱ", "root": "جنن"}, {"id": 12, "arabic": "فَفَسَقَ", "translit": "َqَsَfَf", "root": "فسق"}, {"id": 13, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 14, "arabic": "أَمْرِ", "translit": "ِrْmَaʾ", "root": "امر"}, {"id": 15, "arabic": "رَبِّهِۦٓ", "translit": "ٓۦِhِّbَr", "root": "ربب"}, {"id": 16, "arabic": "أَفَتَتَّخِذُونَهُۥ", "translit": "ۥُhَnwُhdِhkَّtَtَfَaʾ", "root": "اخذ"}, {"id": 17, "arabic": "وَذُرِّيَّتَهُۥٓ", "translit": "ٓۥُhَtَّyِّrُhdَw", "root": "ذرر"}, {"id": 18, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 19, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 20, "arabic": "دُونِى", "translit": "àِnwُd", "root": "دون"}, {"id": 21, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 22, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 23, "arabic": "عَدُوٌّۢ", "translit": "ٌّۢwُdَʿع", "root": "عدو"}, {"id": 24, "arabic": "بِئْسَ", "translit": "َsْyʾِb", "root": "باس"}, {"id": 25, "arabic": "لِلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlِl", "root": "ظلم"}, {"id": 26, "arabic": "بَدَلًا", "translit": "āًlَdَb", "root": "بدل"}], "hasIhya": true}, {"ayah": 51, "text": "مَّآ أَشْهَدتُّهُمْ خَلْقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَلَا خَلْقَ أَنفُسِهِمْ وَمَا كُنتُ مُتَّخِذَ ٱلْمُضِلِّينَ عَضُدًا ", "translation": "I did not make them witness to the creation of the heavens and the earth or to the creation of themselves, and I would not have taken the misguiders as assistants.", "words": [{"id": 1, "arabic": "مَّآ", "translit": "ٓāَّm", "root": ""}, {"id": 2, "arabic": "أَشْهَدتُّهُمْ", "translit": "ْmُhُّtdَhْhsَaʾ", "root": "شهد"}, {"id": 3, "arabic": "خَلْقَ", "translit": "َqْlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "خَلْقَ", "translit": "َqْlَhk", "root": "خلق"}, {"id": 8, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "كُنتُ", "translit": "ُtnُk", "root": "كون"}, {"id": 11, "arabic": "مُتَّخِذَ", "translit": "َhdِhkَّtُm", "root": "اخذ"}, {"id": 12, "arabic": "ٱلْمُضِلِّينَ", "translit": "َnyِّlِḍُmْlٱ", "root": "ضلل"}, {"id": 13, "arabic": "عَضُدًا", "translit": "āًdُḍَʿع", "root": "عضد"}], "hasIhya": false}, {"ayah": 52, "text": "وَيَوْمَ يَقُولُ نَادُوا۟ شُرَكَآءِىَ ٱلَّذِينَ زَعَمْتُمْ فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُوا۟ لَهُمْ وَجَعَلْنَا بَيْنَهُم مَّوْبِقًا ", "translation": "And [warn of] the Day when He will say, \"Call My 'partners' whom you claimed,\" and they will invoke them, but they will not respond to them. And We will put between them [a valley of] destruction.", "words": [{"id": 1, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 2, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "نَادُوا۟", "translit": "۟āwُdāَn", "root": "ندي"}, {"id": 4, "arabic": "شُرَكَآءِىَ", "translit": "َàِءٓāَkَrُhs", "root": "شرك"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "زَعَمْتُمْ", "translit": "ْmُtْmَʿعَz", "root": "زعم"}, {"id": 7, "arabic": "فَدَعَوْهُمْ", "translit": "ْmُhْwَʿعَdَf", "root": "دعو"}, {"id": 8, "arabic": "فَلَمْ", "translit": "ْmَlَf", "root": ""}, {"id": 9, "arabic": "يَسْتَجِيبُوا۟", "translit": "۟āwُbyِjgَtْsَy", "root": "جوب"}, {"id": 10, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 11, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 12, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 13, "arabic": "مَّوْبِقًا", "translit": "āًqِbْwَّm", "root": "وبق"}], "hasIhya": false}, {"ayah": 53, "text": "وَرَءَا ٱلْمُجْرِمُونَ ٱلنَّارَ فَظَنُّوٓا۟ أَنَّهُم مُّوَاقِعُوهَا وَلَمْ يَجِدُوا۟ عَنْهَا مَصْرِفًا ", "translation": "And the criminals will see the Fire and will be certain that they are to fall therein. And they will not find from it a way elsewhere.", "words": [{"id": 1, "arabic": "وَرَءَا", "translit": "āَءَrَw", "root": "راي"}, {"id": 2, "arabic": "ٱلْمُجْرِمُونَ", "translit": "َnwُmِrْjgُmْlٱ", "root": "جرم"}, {"id": 3, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 4, "arabic": "فَظَنُّوٓا۟", "translit": "۟āٓwُّnَẓَf", "root": "ظنن"}, {"id": 5, "arabic": "أَنَّهُم", "translit": "mُhَّnَaʾ", "root": ""}, {"id": 6, "arabic": "مُّوَاقِعُوهَا", "translit": "āَhwُʿعِqāَwُّm", "root": "وقع"}, {"id": 7, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 8, "arabic": "يَجِدُوا۟", "translit": "۟āwُdِjgَy", "root": "وجد"}, {"id": 9, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 10, "arabic": "مَصْرِفًا", "translit": "āًfِrْṣَm", "root": "صرف"}], "hasIhya": false}, {"ayah": 54, "text": "وَلَقَدْ صَرَّفْنَا فِى هَٰذَا ٱلْقُرْءَانِ لِلنَّاسِ مِن كُلِّ مَثَلٍۚ وَكَانَ ٱلْإِنسَٰنُ أَكْثَرَ شَىْءٍ جَدَلًا ", "translation": "And We have certainly diversified in this Qur’ān for the people from every [kind of] example; but man has ever been, most of anything, [prone to] dispute.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "صَرَّفْنَا", "translit": "āَnْfَّrَṣ", "root": "صرف"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 5, "arabic": "ٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱ", "root": "قرا"}, {"id": 6, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 9, "arabic": "مَثَلٍ", "translit": "ٍlَhtَm", "root": "مثل"}, {"id": 10, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 11, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 12, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 13, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 14, "arabic": "جَدَلًا", "translit": "āًlَdَjg", "root": "جدل"}], "hasIhya": true}, {"ayah": 55, "text": "وَمَا مَنَعَ ٱلنَّاسَ أَن يُؤْمِنُوٓا۟ إِذْ جَآءَهُمُ ٱلْهُدَىٰ وَيَسْتَغْفِرُوا۟ رَبَّهُمْ إِلَّآ أَن تَأْتِيَهُمْ سُنَّةُ ٱلْأَوَّلِينَ أَوْ يَأْتِيَهُمُ ٱلْعَذَابُ قُبُلًا ", "translation": "And nothing has prevented the people from believing when guidance came to them and from asking forgiveness of their Lord except that there [must] befall them the [accustomed] precedent of the former peoples[1] or that the punishment should come [directly] before them.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "مَنَعَ", "translit": "َʿعَnَm", "root": "منع"}, {"id": 3, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يُؤْمِنُوٓا۟", "translit": "۟āٓwُnِmْwʾُy", "root": "امن"}, {"id": 6, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 7, "arabic": "جَآءَهُمُ", "translit": "ُmُhَءٓāَjg", "root": "جيا"}, {"id": 8, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 9, "arabic": "وَيَسْتَغْفِرُوا۟", "translit": "۟āwُrِfْغَtْsَyَw", "root": "غفر"}, {"id": 10, "arabic": "رَبَّهُمْ", "translit": "ْmُhَّbَr", "root": "ربب"}, {"id": 11, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 12, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 13, "arabic": "تَأْتِيَهُمْ", "translit": "ْmُhَyِtْaʾَt", "root": "اتي"}, {"id": 14, "arabic": "سُنَّةُ", "translit": "ُẗَّnُs", "root": "سنن"}, {"id": 15, "arabic": "ٱلْأَوَّلِينَ", "translit": "َnyِlَّwَaʾْlٱ", "root": "اول"}, {"id": 16, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 17, "arabic": "يَأْتِيَهُمُ", "translit": "ُmُhَyِtْaʾَy", "root": "اتي"}, {"id": 18, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 19, "arabic": "قُبُلًا", "translit": "āًlُbُq", "root": "قبل"}], "hasIhya": false}, {"ayah": 56, "text": "وَمَا نُرْسِلُ ٱلْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ وَمُنذِرِينَۚ وَيُجَٰدِلُ ٱلَّذِينَ كَفَرُوا۟ بِٱلْبَٰطِلِ لِيُدْحِضُوا۟ بِهِ ٱلْحَقَّۖ وَٱتَّخَذُوٓا۟ ءَايَٰتِى وَمَآ أُنذِرُوا۟ هُزُوًا ", "translation": "And We send not the messengers except as bringers of good tidings and warners. And those who disbelieve dispute by [using] falsehood to [attempt to] invalidate thereby the truth and have taken My verses, and that of which they are warned, in ridicule.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "نُرْسِلُ", "translit": "ُlِsْrُn", "root": "رسل"}, {"id": 3, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "مُبَشِّرِينَ", "translit": "َnyِrِّhsَbُm", "root": "بشر"}, {"id": 6, "arabic": "وَمُنذِرِينَ", "translit": "َnyِrِhdnُmَw", "root": "نذر"}, {"id": 7, "arabic": "وَيُجَٰدِلُ", "translit": "ُlِdَٰjgُyَw", "root": "جدل"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "بِٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱِb", "root": "بطل"}, {"id": 11, "arabic": "لِيُدْحِضُوا۟", "translit": "۟āwُḍِḥْdُyِl", "root": "دحض"}, {"id": 12, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 13, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 14, "arabic": "وَٱتَّخَذُوٓا۟", "translit": "۟āٓwُhdَhkَّtٱَw", "root": "اخذ"}, {"id": 15, "arabic": "ءَايَٰتِى", "translit": "àِtَٰyāَء", "root": "ايي"}, {"id": 16, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 17, "arabic": "أُنذِرُوا۟", "translit": "۟āwُrِhdnُaʾ", "root": "نذر"}, {"id": 18, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}], "hasIhya": false}, {"ayah": 57, "text": "وَمَنْ أَظْلَمُ مِمَّن ذُكِّرَ بِـَٔايَٰتِ رَبِّهِۦ فَأَعْرَضَ عَنْهَا وَنَسِىَ مَا قَدَّمَتْ يَدَاهُۚ إِنَّا جَعَلْنَا عَلَىٰ قُلُوبِهِمْ أَكِنَّةً أَن يَفْقَهُوهُ وَفِىٓ ءَاذَانِهِمْ وَقْرًاۖ وَإِن تَدْعُهُمْ إِلَى ٱلْهُدَىٰ فَلَن يَهْتَدُوٓا۟ إِذًا أَبَدًا ", "translation": "And who is more unjust than one who is reminded of the verses of his Lord but turns away from them and forgets what his hands have put forth? Indeed, We have placed over their hearts coverings, lest they understand it, and in their ears deafness. And if you invite them to guidance - they will never be guided, then - ever.", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 3, "arabic": "مِمَّن", "translit": "nَّmِm", "root": ""}, {"id": 4, "arabic": "ذُكِّرَ", "translit": "َrِّkُhd", "root": "ذكر"}, {"id": 5, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 6, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 7, "arabic": "فَأَعْرَضَ", "translit": "َḍَrْʿعَaʾَf", "root": "عرض"}, {"id": 8, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 9, "arabic": "وَنَسِىَ", "translit": "َàِsَnَw", "root": "نسي"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "قَدَّمَتْ", "translit": "ْtَmَّdَq", "root": "قدم"}, {"id": 12, "arabic": "يَدَاهُ", "translit": "ُhāَdَy", "root": "يدي"}, {"id": 13, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 14, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 15, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 16, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 17, "arabic": "أَكِنَّةً", "translit": "ًẗَّnِkَaʾ", "root": "كنن"}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "يَفْقَهُوهُ", "translit": "ُhwُhَqْfَy", "root": "فقه"}, {"id": 20, "arabic": "وَفِىٓ", "translit": "ٓàِfَw", "root": ""}, {"id": 21, "arabic": "ءَاذَانِهِمْ", "translit": "ْmِhِnāَhdāَء", "root": "اذن"}, {"id": 22, "arabic": "وَقْرًا", "translit": "āًrْqَw", "root": "وقر"}, {"id": 23, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 24, "arabic": "تَدْعُهُمْ", "translit": "ْmُhُʿعْdَt", "root": "دعو"}, {"id": 25, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 26, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 27, "arabic": "فَلَن", "translit": "nَlَf", "root": ""}, {"id": 28, "arabic": "يَهْتَدُوٓا۟", "translit": "۟āٓwُdَtْhَy", "root": "هدي"}, {"id": 29, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 30, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}], "hasIhya": false}, {"ayah": 58, "text": "وَرَبُّكَ ٱلْغَفُورُ ذُو ٱلرَّحْمَةِۖ لَوْ يُؤَاخِذُهُم بِمَا كَسَبُوا۟ لَعَجَّلَ لَهُمُ ٱلْعَذَابَۚ بَل لَّهُم مَّوْعِدٌ لَّن يَجِدُوا۟ مِن دُونِهِۦ مَوْئِلًا ", "translation": "And your Lord is the Forgiving, the possessor of mercy. If He were to impose blame upon them for what they earned, He would have hastened for them the punishment. Rather, for them is an appointment from which they will never find an escape.", "words": [{"id": 1, "arabic": "وَرَبُّكَ", "translit": "َkُّbَrَw", "root": "ربب"}, {"id": 2, "arabic": "ٱلْغَفُورُ", "translit": "ُrwُfَغْlٱ", "root": "غفر"}, {"id": 3, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 4, "arabic": "ٱلرَّحْمَةِ", "translit": "ِẗَmْḥَّrlٱ", "root": "رحم"}, {"id": 5, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 6, "arabic": "يُؤَاخِذُهُم", "translit": "mُhُhdِhkāَwʾُy", "root": "اخذ"}, {"id": 7, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 8, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 9, "arabic": "لَعَجَّلَ", "translit": "َlَّjgَʿعَl", "root": "عجل"}, {"id": 10, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 11, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 12, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 13, "arabic": "لَّهُم", "translit": "mُhَّl", "root": ""}, {"id": 14, "arabic": "مَّوْعِدٌ", "translit": "ٌdِʿعْwَّm", "root": "وعد"}, {"id": 15, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 16, "arabic": "يَجِدُوا۟", "translit": "۟āwُdِjgَy", "root": "وجد"}, {"id": 17, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 18, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 19, "arabic": "مَوْئِلًا", "translit": "āًlِyʾْwَm", "root": "وال"}], "hasIhya": false}, {"ayah": 59, "text": "وَتِلْكَ ٱلْقُرَىٰٓ أَهْلَكْنَٰهُمْ لَمَّا ظَلَمُوا۟ وَجَعَلْنَا لِمَهْلِكِهِم مَّوْعِدًا ", "translation": "And those cities - We destroyed them when they wronged, and We made for their destruction an appointed time.", "words": [{"id": 1, "arabic": "وَتِلْكَ", "translit": "َkْlِtَw", "root": ""}, {"id": 2, "arabic": "ٱلْقُرَىٰٓ", "translit": "ٰٓàَrُqْlٱ", "root": "قري"}, {"id": 3, "arabic": "أَهْلَكْنَٰهُمْ", "translit": "ْmُhَٰnْkَlْhَaʾ", "root": "هلك"}, {"id": 4, "arabic": "لَمَّا", "translit": "āَّmَl", "root": ""}, {"id": 5, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 6, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 7, "arabic": "لِمَهْلِكِهِم", "translit": "mِhِkِlْhَmِl", "root": "هلك"}, {"id": 8, "arabic": "مَّوْعِدًا", "translit": "āًdِʿعْwَّm", "root": "وعد"}], "hasIhya": false}, {"ayah": 60, "text": "وَإِذْ قَالَ مُوسَىٰ لِفَتَىٰهُ لَآ أَبْرَحُ حَتَّىٰٓ أَبْلُغَ مَجْمَعَ ٱلْبَحْرَيْنِ أَوْ أَمْضِىَ حُقُبًا ", "translation": "And [mention] when Moses said to his boy [i.e., servant], \"I will not cease [traveling] until I reach the junction of the two seas or continue for a long period.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "لِفَتَىٰهُ", "translit": "ُhٰàَtَfِl", "root": "فتي"}, {"id": 5, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 6, "arabic": "أَبْرَحُ", "translit": "ُḥَrْbَaʾ", "root": "برح"}, {"id": 7, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 8, "arabic": "أَبْلُغَ", "translit": "َغُlْbَaʾ", "root": "بلغ"}, {"id": 9, "arabic": "مَجْمَعَ", "translit": "َʿعَmْjgَm", "root": "جمع"}, {"id": 10, "arabic": "ٱلْبَحْرَيْنِ", "translit": "ِnْyَrْḥَbْlٱ", "root": "بحر"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "أَمْضِىَ", "translit": "َàِḍْmَaʾ", "root": "مضي"}, {"id": 13, "arabic": "حُقُبًا", "translit": "āًbُqُḥ", "root": "حقب"}], "hasIhya": false}, {"ayah": 61, "text": "فَلَمَّا بَلَغَا مَجْمَعَ بَيْنِهِمَا نَسِيَا حُوتَهُمَا فَٱتَّخَذَ سَبِيلَهُۥ فِى ٱلْبَحْرِ سَرَبًا ", "translation": "But when they reached the junction between them, they forgot their fish, and it took its course into the sea, slipping away.", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "بَلَغَا", "translit": "āَغَlَb", "root": "بلغ"}, {"id": 3, "arabic": "مَجْمَعَ", "translit": "َʿعَmْjgَm", "root": "جمع"}, {"id": 4, "arabic": "بَيْنِهِمَا", "translit": "āَmِhِnْyَb", "root": "بين"}, {"id": 5, "arabic": "نَسِيَا", "translit": "āَyِsَn", "root": "نسي"}, {"id": 6, "arabic": "حُوتَهُمَا", "translit": "āَmُhَtwُḥ", "root": "حوت"}, {"id": 7, "arabic": "فَٱتَّخَذَ", "translit": "َhdَhkَّtٱَf", "root": "اخذ"}, {"id": 8, "arabic": "سَبِيلَهُۥ", "translit": "ۥُhَlyِbَs", "root": "سبل"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 11, "arabic": "سَرَبًا", "translit": "āًbَrَs", "root": "سرب"}], "hasIhya": false}, {"ayah": 62, "text": "فَلَمَّا جَاوَزَا قَالَ لِفَتَىٰهُ ءَاتِنَا غَدَآءَنَا لَقَدْ لَقِينَا مِن سَفَرِنَا هَٰذَا نَصَبًا ", "translation": "So when they had passed beyond it, [Moses] said to his boy, \"Bring us our morning meal. We have certainly suffered in this, our journey, [much] fatigue.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "جَاوَزَا", "translit": "āَzَwāَjg", "root": "جوز"}, {"id": 3, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 4, "arabic": "لِفَتَىٰهُ", "translit": "ُhٰàَtَfِl", "root": "فتي"}, {"id": 5, "arabic": "ءَاتِنَا", "translit": "āَnِtāَء", "root": "اتي"}, {"id": 6, "arabic": "غَدَآءَنَا", "translit": "āَnَءٓāَdَغ", "root": "غدو"}, {"id": 7, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 8, "arabic": "لَقِينَا", "translit": "āَnyِqَl", "root": "لقي"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "سَفَرِنَا", "translit": "āَnِrَfَs", "root": "سفر"}, {"id": 11, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 12, "arabic": "نَصَبًا", "translit": "āًbَṣَn", "root": "نصب"}], "hasIhya": false}, {"ayah": 63, "text": "قَالَ أَرَءَيْتَ إِذْ أَوَيْنَآ إِلَى ٱلصَّخْرَةِ فَإِنِّى نَسِيتُ ٱلْحُوتَ وَمَآ أَنسَىٰنِيهُ إِلَّا ٱلشَّيْطَٰنُ أَنْ أَذْكُرَهُۥۚ وَٱتَّخَذَ سَبِيلَهُۥ فِى ٱلْبَحْرِ عَجَبًا ", "translation": "He said, \"Did you see when we retired to the rock? Indeed, I forgot [there] the fish. And none made me forget it except Satan - that I should mention it. And it took its course into the sea amazingly.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَرَءَيْتَ", "translit": "َtْyَءَrَaʾ", "root": "راي"}, {"id": 3, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 4, "arabic": "أَوَيْنَآ", "translit": "ٓāَnْyَwَaʾ", "root": "اوي"}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱلصَّخْرَةِ", "translit": "ِẗَrْhkَّṣlٱ", "root": "صخر"}, {"id": 7, "arabic": "فَإِنِّى", "translit": "àِّnِiʾَf", "root": ""}, {"id": 8, "arabic": "نَسِيتُ", "translit": "ُtyِsَn", "root": "نسي"}, {"id": 9, "arabic": "ٱلْحُوتَ", "translit": "َtwُḥْlٱ", "root": "حوت"}, {"id": 10, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 11, "arabic": "أَنسَىٰنِيهُ", "translit": "ُhyِnٰàَsnَaʾ", "root": "نسي"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 14, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 15, "arabic": "أَذْكُرَهُۥ", "translit": "ۥُhَrُkْhdَaʾ", "root": "ذكر"}, {"id": 16, "arabic": "وَٱتَّخَذَ", "translit": "َhdَhkَّtٱَw", "root": "اخذ"}, {"id": 17, "arabic": "سَبِيلَهُۥ", "translit": "ۥُhَlyِbَs", "root": "سبل"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 20, "arabic": "عَجَبًا", "translit": "āًbَjgَʿع", "root": "عجب"}], "hasIhya": false}, {"ayah": 64, "text": "قَالَ ذَٰلِكَ مَا كُنَّا نَبْغِۚ فَٱرْتَدَّا عَلَىٰٓ ءَاثَارِهِمَا قَصَصًا ", "translation": "[Moses] said, \"That is what we were seeking.\" So they returned, following their footprints.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 5, "arabic": "نَبْغِ", "translit": "ِغْbَn", "root": "بغي"}, {"id": 6, "arabic": "فَٱرْتَدَّا", "translit": "āَّdَtْrٱَf", "root": "ردد"}, {"id": 7, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 8, "arabic": "ءَاثَارِهِمَا", "translit": "āَmِhِrāَhtāَء", "root": "اثر"}, {"id": 9, "arabic": "قَصَصًا", "translit": "āًṣَṣَq", "root": "قصص"}], "hasIhya": false}, {"ayah": 65, "text": "فَوَجَدَا عَبْدًا مِّنْ عِبَادِنَآ ءَاتَيْنَٰهُ رَحْمَةً مِّنْ عِندِنَا وَعَلَّمْنَٰهُ مِن لَّدُنَّا عِلْمًا ", "translation": "And they found a servant from among Our servants [i.e., al-Khiḍr] to whom We had given mercy from Us and had taught him from Us a [certain] knowledge.", "words": [{"id": 1, "arabic": "فَوَجَدَا", "translit": "āَdَjgَwَf", "root": "وجد"}, {"id": 2, "arabic": "عَبْدًا", "translit": "āًdْbَʿع", "root": "عبد"}, {"id": 3, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 4, "arabic": "عِبَادِنَآ", "translit": "ٓāَnِdāَbِʿع", "root": "عبد"}, {"id": 5, "arabic": "ءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَء", "root": "اتي"}, {"id": 6, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 7, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 8, "arabic": "عِندِنَا", "translit": "āَnِdnِʿع", "root": "عند"}, {"id": 9, "arabic": "وَعَلَّمْنَٰهُ", "translit": "ُhَٰnْmَّlَʿعَw", "root": "علم"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "لَّدُنَّا", "translit": "āَّnُdَّl", "root": "لدن"}, {"id": 12, "arabic": "عِلْمًا", "translit": "āًmْlِʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 66, "text": "قَالَ لَهُۥ مُوسَىٰ هَلْ أَتَّبِعُكَ عَلَىٰٓ أَن تُعَلِّمَنِ مِمَّا عُلِّمْتَ رُشْدًا ", "translation": "Moses said to him, \"May I follow you on [the condition] that you teach me from what you have been taught of sound judgement?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 5, "arabic": "أَتَّبِعُكَ", "translit": "َkُʿعِbَّtَaʾ", "root": "تبع"}, {"id": 6, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "تُعَلِّمَنِ", "translit": "ِnَmِّlَʿعُt", "root": "علم"}, {"id": 9, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 10, "arabic": "عُلِّمْتَ", "translit": "َtْmِّlُʿع", "root": "علم"}, {"id": 11, "arabic": "رُشْدًا", "translit": "āًdْhsُr", "root": "رشد"}], "hasIhya": false}, {"ayah": 67, "text": "قَالَ إِنَّكَ لَن تَسْتَطِيعَ مَعِىَ صَبْرًا ", "translation": "He said, \"Indeed, with me you will never be able to have patience.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 3, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 4, "arabic": "تَسْتَطِيعَ", "translit": "َʿعyِṭَtْsَt", "root": "طوع"}, {"id": 5, "arabic": "مَعِىَ", "translit": "َàِʿعَm", "root": ""}, {"id": 6, "arabic": "صَبْرًا", "translit": "āًrْbَṣ", "root": "صبر"}], "hasIhya": true}, {"ayah": 68, "text": "وَكَيْفَ تَصْبِرُ عَلَىٰ مَا لَمْ تُحِطْ بِهِۦ خُبْرًا ", "translation": "And how can you have patience for what you do not encompass in knowledge?\"", "words": [{"id": 1, "arabic": "وَكَيْفَ", "translit": "َfْyَkَw", "root": "كيف"}, {"id": 2, "arabic": "تَصْبِرُ", "translit": "ُrِbْṣَt", "root": "صبر"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 6, "arabic": "تُحِطْ", "translit": "ْṭِḥُt", "root": "حوط"}, {"id": 7, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 8, "arabic": "خُبْرًا", "translit": "āًrْbُhk", "root": "خبر"}], "hasIhya": true}, {"ayah": 69, "text": "قَالَ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ صَابِرًا وَلَآ أَعْصِى لَكَ أَمْرًا ", "translation": "[Moses] said, \"You will find me, if Allāh wills, patient, and I will not disobey you in [any] order.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "سَتَجِدُنِىٓ", "translit": "ٓàِnُdِjgَtَs", "root": "وجد"}, {"id": 3, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 4, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "صَابِرًا", "translit": "āًrِbāَṣ", "root": "صبر"}, {"id": 7, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 8, "arabic": "أَعْصِى", "translit": "àِṣْʿعَaʾ", "root": "عصي"}, {"id": 9, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 10, "arabic": "أَمْرًا", "translit": "āًrْmَaʾ", "root": "امر"}], "hasIhya": false}, {"ayah": 70, "text": "قَالَ فَإِنِ ٱتَّبَعْتَنِى فَلَا تَسْـَٔلْنِى عَن شَىْءٍ حَتَّىٰٓ أُحْدِثَ لَكَ مِنْهُ ذِكْرًا ", "translation": "He said, \"Then if you follow me, do not ask me about anything until I make to you about it mention [i.e., explanation].\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "فَإِنِ", "translit": "ِnِiʾَf", "root": ""}, {"id": 3, "arabic": "ٱتَّبَعْتَنِى", "translit": "àِnَtْʿعَbَّtٱ", "root": "تبع"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "تَسْـَٔلْنِى", "translit": "àِnْlَٔـْsَt", "root": "سال"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 8, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 9, "arabic": "أُحْدِثَ", "translit": "َhtِdْḥُaʾ", "root": "حدث"}, {"id": 10, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 11, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 12, "arabic": "ذِكْرًا", "translit": "āًrْkِhd", "root": "ذكر"}], "hasIhya": true}, {"ayah": 71, "text": "فَٱنطَلَقَا حَتَّىٰٓ إِذَا رَكِبَا فِى ٱلسَّفِينَةِ خَرَقَهَاۖ قَالَ أَخَرَقْتَهَا لِتُغْرِقَ أَهْلَهَا لَقَدْ جِئْتَ شَيْـًٔا إِمْرًا ", "translation": "So they set out, until when they had embarked on the ship, he [i.e., al-Khiḍr] tore it open. [Moses] said, \"Have you torn it open to drown its people? You have certainly done a grave thing.\"", "words": [{"id": 1, "arabic": "فَٱنطَلَقَا", "translit": "āَqَlَṭnٱَf", "root": "طلق"}, {"id": 2, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "رَكِبَا", "translit": "āَbِkَr", "root": "ركب"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسَّفِينَةِ", "translit": "ِẗَnyِfَّslٱ", "root": "سفن"}, {"id": 7, "arabic": "خَرَقَهَا", "translit": "āَhَqَrَhk", "root": "خرق"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "أَخَرَقْتَهَا", "translit": "āَhَtْqَrَhkَaʾ", "root": "خرق"}, {"id": 10, "arabic": "لِتُغْرِقَ", "translit": "َqِrْغُtِl", "root": "غرق"}, {"id": 11, "arabic": "أَهْلَهَا", "translit": "āَhَlْhَaʾ", "root": "اهل"}, {"id": 12, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 13, "arabic": "جِئْتَ", "translit": "َtْyʾِjg", "root": "جيا"}, {"id": 14, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 15, "arabic": "إِمْرًا", "translit": "āًrْmِiʾ", "root": "امر"}], "hasIhya": false}, {"ayah": 72, "text": "قَالَ أَلَمْ أَقُلْ إِنَّكَ لَن تَسْتَطِيعَ مَعِىَ صَبْرًا ", "translation": "[Al-Khiḍr] said, \"Did I not say that with me you would never be able to have patience?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 3, "arabic": "أَقُلْ", "translit": "ْlُqَaʾ", "root": "قول"}, {"id": 4, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 5, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 6, "arabic": "تَسْتَطِيعَ", "translit": "َʿعyِṭَtْsَt", "root": "طوع"}, {"id": 7, "arabic": "مَعِىَ", "translit": "َàِʿعَm", "root": ""}, {"id": 8, "arabic": "صَبْرًا", "translit": "āًrْbَṣ", "root": "صبر"}], "hasIhya": true}, {"ayah": 73, "text": "قَالَ لَا تُؤَاخِذْنِى بِمَا نَسِيتُ وَلَا تُرْهِقْنِى مِنْ أَمْرِى عُسْرًا ", "translation": "[Moses] said, \"Do not blame me for what I forgot and do not overwhelm me in my matter with difficulty.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 3, "arabic": "تُؤَاخِذْنِى", "translit": "àِnْhdِhkāَwʾُt", "root": "اخذ"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "نَسِيتُ", "translit": "ُtyِsَn", "root": "نسي"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تُرْهِقْنِى", "translit": "àِnْqِhْrُt", "root": "رهق"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "أَمْرِى", "translit": "àِrْmَaʾ", "root": "امر"}, {"id": 10, "arabic": "عُسْرًا", "translit": "āًrْsُʿع", "root": "عسر"}], "hasIhya": true}, {"ayah": 74, "text": "فَٱنطَلَقَا حَتَّىٰٓ إِذَا لَقِيَا غُلَٰمًا فَقَتَلَهُۥ قَالَ أَقَتَلْتَ نَفْسًا زَكِيَّةًۢ بِغَيْرِ نَفْسٍ لَّقَدْ جِئْتَ شَيْـًٔا نُّكْرًا ", "translation": "So they set out, until when they met a boy, he [i.e., al-Khiḍr] killed him. [Moses] said, \"Have you killed a pure soul for other than [having killed] a soul? You have certainly done a deplorable thing.\"", "words": [{"id": 1, "arabic": "فَٱنطَلَقَا", "translit": "āَqَlَṭnٱَf", "root": "طلق"}, {"id": 2, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "لَقِيَا", "translit": "āَyِqَl", "root": "لقي"}, {"id": 5, "arabic": "غُلَٰمًا", "translit": "āًmَٰlُغ", "root": "غلم"}, {"id": 6, "arabic": "فَقَتَلَهُۥ", "translit": "ۥُhَlَtَqَf", "root": "قتل"}, {"id": 7, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 8, "arabic": "أَقَتَلْتَ", "translit": "َtْlَtَqَaʾ", "root": "قتل"}, {"id": 9, "arabic": "نَفْسًا", "translit": "āًsْfَn", "root": "نفس"}, {"id": 10, "arabic": "زَكِيَّةًۢ", "translit": "ًۢẗَّyِkَz", "root": "زكو"}, {"id": 11, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 12, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 13, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": ""}, {"id": 14, "arabic": "جِئْتَ", "translit": "َtْyʾِjg", "root": "جيا"}, {"id": 15, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 16, "arabic": "نُّكْرًا", "translit": "āًrْkُّn", "root": "نكر"}], "hasIhya": false}, {"ayah": 75, "text": "قَالَ أَلَمْ أَقُل لَّكَ إِنَّكَ لَن تَسْتَطِيعَ مَعِىَ صَبْرًا ", "translation": "[Al-Khiḍr] said, \"Did I not tell you that with me you would never be able to have patience?\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 3, "arabic": "أَقُل", "translit": "lُqَaʾ", "root": "قول"}, {"id": 4, "arabic": "لَّكَ", "translit": "َkَّl", "root": ""}, {"id": 5, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 6, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 7, "arabic": "تَسْتَطِيعَ", "translit": "َʿعyِṭَtْsَt", "root": "طوع"}, {"id": 8, "arabic": "مَعِىَ", "translit": "َàِʿعَm", "root": ""}, {"id": 9, "arabic": "صَبْرًا", "translit": "āًrْbَṣ", "root": "صبر"}], "hasIhya": true}, {"ayah": 76, "text": "قَالَ إِن سَأَلْتُكَ عَن شَىْءٍۭ بَعْدَهَا فَلَا تُصَٰحِبْنِىۖ قَدْ بَلَغْتَ مِن لَّدُنِّى عُذْرًا ", "translation": "[Moses] said, \"If I should ask you about anything after this, then do not keep me as a companion. You have obtained from me an excuse.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "سَأَلْتُكَ", "translit": "َkُtْlَaʾَs", "root": "سال"}, {"id": 4, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 5, "arabic": "شَىْءٍۭ", "translit": "ٍۭءْàَhs", "root": "شيا"}, {"id": 6, "arabic": "بَعْدَهَا", "translit": "āَhَdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 8, "arabic": "تُصَٰحِبْنِى", "translit": "àِnْbِḥَٰṣُt", "root": "صحب"}, {"id": 9, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 10, "arabic": "بَلَغْتَ", "translit": "َtْغَlَb", "root": "بلغ"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "لَّدُنِّى", "translit": "àِّnُdَّl", "root": "لدن"}, {"id": 13, "arabic": "عُذْرًا", "translit": "āًrْhdُʿع", "root": "عذر"}], "hasIhya": false}, {"ayah": 77, "text": "فَٱنطَلَقَا حَتَّىٰٓ إِذَآ أَتَيَآ أَهْلَ قَرْيَةٍ ٱسْتَطْعَمَآ أَهْلَهَا فَأَبَوْا۟ أَن يُضَيِّفُوهُمَا فَوَجَدَا فِيهَا جِدَارًا يُرِيدُ أَن يَنقَضَّ فَأَقَامَهُۥۖ قَالَ لَوْ شِئْتَ لَتَّخَذْتَ عَلَيْهِ أَجْرًا ", "translation": "So they set out, until when they came to the people of a town, they asked its people for food, but they refused to offer them hospitality. And they found therein a wall about to collapse, so he [i.e., al-Khiḍr] restored it. [Moses] said, \"If you wished, you could have taken for it a payment.\"", "words": [{"id": 1, "arabic": "فَٱنطَلَقَا", "translit": "āَqَlَṭnٱَf", "root": "طلق"}, {"id": 2, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 3, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 4, "arabic": "أَتَيَآ", "translit": "ٓāَyَtَaʾ", "root": "اتي"}, {"id": 5, "arabic": "أَهْلَ", "translit": "َlْhَaʾ", "root": "اهل"}, {"id": 6, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 7, "arabic": "ٱسْتَطْعَمَآ", "translit": "ٓāَmَʿعْṭَtْsٱ", "root": "طعم"}, {"id": 8, "arabic": "أَهْلَهَا", "translit": "āَhَlْhَaʾ", "root": "اهل"}, {"id": 9, "arabic": "فَأَبَوْا۟", "translit": "۟āْwَbَaʾَf", "root": "ابي"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "يُضَيِّفُوهُمَا", "translit": "āَmُhwُfِّyَḍُy", "root": "ضيف"}, {"id": 12, "arabic": "فَوَجَدَا", "translit": "āَdَjgَwَf", "root": "وجد"}, {"id": 13, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 14, "arabic": "جِدَارًا", "translit": "āًrāَdِjg", "root": "جدر"}, {"id": 15, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 16, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 17, "arabic": "يَنقَضَّ", "translit": "َّḍَqnَy", "root": "قضض"}, {"id": 18, "arabic": "فَأَقَامَهُۥ", "translit": "ۥُhَmāَqَaʾَf", "root": "قوم"}, {"id": 19, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 20, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 21, "arabic": "شِئْتَ", "translit": "َtْyʾِhs", "root": "شيا"}, {"id": 22, "arabic": "لَتَّخَذْتَ", "translit": "َtْhdَhkَّtَl", "root": "اخذ"}, {"id": 23, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 24, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}], "hasIhya": false}, {"ayah": 78, "text": "قَالَ هَٰذَا فِرَاقُ بَيْنِى وَبَيْنِكَۚ سَأُنَبِّئُكَ بِتَأْوِيلِ مَا لَمْ تَسْتَطِع عَّلَيْهِ صَبْرًا ", "translation": "[Al-Khiḍr] said, \"This is parting between me and you. I will inform you of the interpretation of that about which you could not have patience.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "فِرَاقُ", "translit": "ُqāَrِf", "root": "فرق"}, {"id": 4, "arabic": "بَيْنِى", "translit": "àِnْyَb", "root": "بين"}, {"id": 5, "arabic": "وَبَيْنِكَ", "translit": "َkِnْyَbَw", "root": "بين"}, {"id": 6, "arabic": "سَأُنَبِّئُكَ", "translit": "َkُyʾِّbَnُaʾَs", "root": "نبا"}, {"id": 7, "arabic": "بِتَأْوِيلِ", "translit": "ِlyِwْaʾَtِb", "root": "اول"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 10, "arabic": "تَسْتَطِع", "translit": "ʿعِṭَtْsَt", "root": "طوع"}, {"id": 11, "arabic": "عَّلَيْهِ", "translit": "ِhْyَlَّʿع", "root": ""}, {"id": 12, "arabic": "صَبْرًا", "translit": "āًrْbَṣ", "root": "صبر"}], "hasIhya": true}, {"ayah": 79, "text": "أَمَّا ٱلسَّفِينَةُ فَكَانَتْ لِمَسَٰكِينَ يَعْمَلُونَ فِى ٱلْبَحْرِ فَأَرَدتُّ أَنْ أَعِيبَهَا وَكَانَ وَرَآءَهُم مَّلِكٌ يَأْخُذُ كُلَّ سَفِينَةٍ غَصْبًا ", "translation": "As for the ship, it belonged to poor people working at sea. So I intended to cause defect in it as there was after them a king who seized every [good] ship by force.", "words": [{"id": 1, "arabic": "أَمَّا", "translit": "āَّmَaʾ", "root": ""}, {"id": 2, "arabic": "ٱلسَّفِينَةُ", "translit": "ُẗَnyِfَّslٱ", "root": "سفن"}, {"id": 3, "arabic": "فَكَانَتْ", "translit": "ْtَnāَkَf", "root": "كون"}, {"id": 4, "arabic": "لِمَسَٰكِينَ", "translit": "َnyِkَٰsَmِl", "root": "سكن"}, {"id": 5, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 8, "arabic": "فَأَرَدتُّ", "translit": "ُّtdَrَaʾَf", "root": "رود"}, {"id": 9, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 10, "arabic": "أَعِيبَهَا", "translit": "āَhَbyِʿعَaʾ", "root": "عيب"}, {"id": 11, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 12, "arabic": "وَرَآءَهُم", "translit": "mُhَءٓāَrَw", "root": "وري"}, {"id": 13, "arabic": "مَّلِكٌ", "translit": "ٌkِlَّm", "root": "ملك"}, {"id": 14, "arabic": "يَأْخُذُ", "translit": "ُhdُhkْaʾَy", "root": "اخذ"}, {"id": 15, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 16, "arabic": "سَفِينَةٍ", "translit": "ٍẗَnyِfَs", "root": "سفن"}, {"id": 17, "arabic": "غَصْبًا", "translit": "āًbْṣَغ", "root": "غصب"}], "hasIhya": false}, {"ayah": 80, "text": "وَأَمَّا ٱلْغُلَٰمُ فَكَانَ أَبَوَاهُ مُؤْمِنَيْنِ فَخَشِينَآ أَن يُرْهِقَهُمَا طُغْيَٰنًا وَكُفْرًا ", "translation": "And as for the boy, his parents were believers, and we feared that he would overburden them by transgression and disbelief.", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْغُلَٰمُ", "translit": "ُmَٰlُغْlٱ", "root": "غلم"}, {"id": 3, "arabic": "فَكَانَ", "translit": "َnāَkَf", "root": "كون"}, {"id": 4, "arabic": "أَبَوَاهُ", "translit": "ُhāَwَbَaʾ", "root": "ابو"}, {"id": 5, "arabic": "مُؤْمِنَيْنِ", "translit": "ِnْyَnِmْwʾُm", "root": "امن"}, {"id": 6, "arabic": "فَخَشِينَآ", "translit": "ٓāَnyِhsَhkَf", "root": "خشي"}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "يُرْهِقَهُمَا", "translit": "āَmُhَqِhْrُy", "root": "رهق"}, {"id": 9, "arabic": "طُغْيَٰنًا", "translit": "āًnَٰyْغُṭ", "root": "طغي"}, {"id": 10, "arabic": "وَكُفْرًا", "translit": "āًrْfُkَw", "root": "كفر"}], "hasIhya": false}, {"ayah": 81, "text": "فَأَرَدْنَآ أَن يُبْدِلَهُمَا رَبُّهُمَا خَيْرًا مِّنْهُ زَكَوٰةً وَأَقْرَبَ رُحْمًا ", "translation": "So we intended that their Lord should substitute for them one better than him in purity and nearer to mercy.", "words": [{"id": 1, "arabic": "فَأَرَدْنَآ", "translit": "ٓāَnْdَrَaʾَf", "root": "رود"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "يُبْدِلَهُمَا", "translit": "āَmُhَlِdْbُy", "root": "بدل"}, {"id": 4, "arabic": "رَبُّهُمَا", "translit": "āَmُhُّbَr", "root": "ربب"}, {"id": 5, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 6, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 7, "arabic": "زَكَوٰةً", "translit": "ًẗٰwَkَz", "root": "زكو"}, {"id": 8, "arabic": "وَأَقْرَبَ", "translit": "َbَrْqَaʾَw", "root": "قرب"}, {"id": 9, "arabic": "رُحْمًا", "translit": "āًmْḥُr", "root": "رحم"}], "hasIhya": false}, {"ayah": 82, "text": "وَأَمَّا ٱلْجِدَارُ فَكَانَ لِغُلَٰمَيْنِ يَتِيمَيْنِ فِى ٱلْمَدِينَةِ وَكَانَ تَحْتَهُۥ كَنزٌ لَّهُمَا وَكَانَ أَبُوهُمَا صَٰلِحًا فَأَرَادَ رَبُّكَ أَن يَبْلُغَآ أَشُدَّهُمَا وَيَسْتَخْرِجَا كَنزَهُمَا رَحْمَةً مِّن رَّبِّكَۚ وَمَا فَعَلْتُهُۥ عَنْ أَمْرِىۚ ذَٰلِكَ تَأْوِيلُ مَا لَمْ تَسْطِع عَّلَيْهِ صَبْرًا ", "translation": "And as for the wall, it belonged to two orphan boys in the city, and there was beneath it a treasure for them, and their father had been righteous. So your Lord intended that they reach maturity and extract their treasure, as a mercy from your Lord. And I did it not of my own accord. That is the interpretation of that about which you could not have patience.\"", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱلْجِدَارُ", "translit": "ُrāَdِjgْlٱ", "root": "جدر"}, {"id": 3, "arabic": "فَكَانَ", "translit": "َnāَkَf", "root": "كون"}, {"id": 4, "arabic": "لِغُلَٰمَيْنِ", "translit": "ِnْyَmَٰlُغِl", "root": "غلم"}, {"id": 5, "arabic": "يَتِيمَيْنِ", "translit": "ِnْyَmyِtَy", "root": "يتم"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 8, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 9, "arabic": "تَحْتَهُۥ", "translit": "ۥُhَtْḥَt", "root": "تحت"}, {"id": 10, "arabic": "كَنزٌ", "translit": "ٌznَk", "root": "كنز"}, {"id": 11, "arabic": "لَّهُمَا", "translit": "āَmُhَّl", "root": ""}, {"id": 12, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 13, "arabic": "أَبُوهُمَا", "translit": "āَmُhwُbَaʾ", "root": "ابو"}, {"id": 14, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 15, "arabic": "فَأَرَادَ", "translit": "َdāَrَaʾَf", "root": "رود"}, {"id": 16, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 17, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 18, "arabic": "يَبْلُغَآ", "translit": "ٓāَغُlْbَy", "root": "بلغ"}, {"id": 19, "arabic": "أَشُدَّهُمَا", "translit": "āَmُhَّdُhsَaʾ", "root": "شدد"}, {"id": 20, "arabic": "وَيَسْتَخْرِجَا", "translit": "āَjgِrْhkَtْsَyَw", "root": "خرج"}, {"id": 21, "arabic": "كَنزَهُمَا", "translit": "āَmُhَznَk", "root": "كنز"}, {"id": 22, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 23, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 24, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 25, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 26, "arabic": "فَعَلْتُهُۥ", "translit": "ۥُhُtْlَʿعَf", "root": "فعل"}, {"id": 27, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 28, "arabic": "أَمْرِى", "translit": "àِrْmَaʾ", "root": "امر"}, {"id": 29, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 30, "arabic": "تَأْوِيلُ", "translit": "ُlyِwْaʾَt", "root": "اول"}, {"id": 31, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 32, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 33, "arabic": "تَسْطِع", "translit": "ʿعِṭْsَt", "root": "طوع"}, {"id": 34, "arabic": "عَّلَيْهِ", "translit": "ِhْyَlَّʿع", "root": ""}, {"id": 35, "arabic": "صَبْرًا", "translit": "āًrْbَṣ", "root": "صبر"}], "hasIhya": true}, {"ayah": 83, "text": "وَيَسْـَٔلُونَكَ عَن ذِى ٱلْقَرْنَيْنِۖ قُلْ سَأَتْلُوا۟ عَلَيْكُم مِّنْهُ ذِكْرًا ", "translation": "And they ask you, [O Muḥammad], about Dhul-Qarnayn. Say, \"I will recite to you about him a report.\"", "words": [{"id": 1, "arabic": "وَيَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَyَw", "root": "سال"}, {"id": 2, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 3, "arabic": "ذِى", "translit": "àِhd", "root": ""}, {"id": 4, "arabic": "ٱلْقَرْنَيْنِ", "translit": "ِnْyَnْrَqْlٱ", "root": "قرن"}, {"id": 5, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 6, "arabic": "سَأَتْلُوا۟", "translit": "۟āwُlْtَaʾَs", "root": "تلو"}, {"id": 7, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 9, "arabic": "ذِكْرًا", "translit": "āًrْkِhd", "root": "ذكر"}], "hasIhya": false}, {"ayah": 84, "text": "إِنَّا مَكَّنَّا لَهُۥ فِى ٱلْأَرْضِ وَءَاتَيْنَٰهُ مِن كُلِّ شَىْءٍ سَبَبًا ", "translation": "Indeed, We established him upon the earth, and We gave him from everything a way [i.e., means].", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "مَكَّنَّا", "translit": "āَّnَّkَm", "root": "مكن"}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "وَءَاتَيْنَٰهُ", "translit": "ُhَٰnْyَtāَءَw", "root": "اتي"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 9, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 10, "arabic": "سَبَبًا", "translit": "āًbَbَs", "root": "سبب"}], "hasIhya": true}, {"ayah": 85, "text": "فَأَتْبَعَ سَبَبًا ", "translation": "So he followed a way", "words": [{"id": 1, "arabic": "فَأَتْبَعَ", "translit": "َʿعَbْtَaʾَf", "root": "تبع"}, {"id": 2, "arabic": "سَبَبًا", "translit": "āًbَbَs", "root": "سبب"}], "hasIhya": false}, {"ayah": 86, "text": "حَتَّىٰٓ إِذَا بَلَغَ مَغْرِبَ ٱلشَّمْسِ وَجَدَهَا تَغْرُبُ فِى عَيْنٍ حَمِئَةٍ وَوَجَدَ عِندَهَا قَوْمًاۗ قُلْنَا يَٰذَا ٱلْقَرْنَيْنِ إِمَّآ أَن تُعَذِّبَ وَإِمَّآ أَن تَتَّخِذَ فِيهِمْ حُسْنًا ", "translation": "Until, when he reached the setting of the sun [i.e., the west], he found it [as if] setting in a body of dark water,[1] and he found near it a people. We [i.e., Allāh] said, \"O Dhul-Qarnayn, either you punish [them] or else adopt among them [a way of] goodness.\"", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "بَلَغَ", "translit": "َغَlَb", "root": "بلغ"}, {"id": 4, "arabic": "مَغْرِبَ", "translit": "َbِrْغَm", "root": "غرب"}, {"id": 5, "arabic": "ٱلشَّمْسِ", "translit": "ِsْmَّhslٱ", "root": "شمس"}, {"id": 6, "arabic": "وَجَدَهَا", "translit": "āَhَdَjgَw", "root": "وجد"}, {"id": 7, "arabic": "تَغْرُبُ", "translit": "ُbُrْغَt", "root": "غرب"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "عَيْنٍ", "translit": "ٍnْyَʿع", "root": "عين"}, {"id": 10, "arabic": "حَمِئَةٍ", "translit": "ٍẗَyʾِmَḥ", "root": "حما"}, {"id": 11, "arabic": "وَوَجَدَ", "translit": "َdَjgَwَw", "root": "وجد"}, {"id": 12, "arabic": "عِندَهَا", "translit": "āَhَdnِʿع", "root": "عند"}, {"id": 13, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 14, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 15, "arabic": "يَٰذَا", "translit": "āَhdَٰy", "root": ""}, {"id": 16, "arabic": "ٱلْقَرْنَيْنِ", "translit": "ِnْyَnْrَqْlٱ", "root": "قرن"}, {"id": 17, "arabic": "إِمَّآ", "translit": "ٓāَّmِiʾ", "root": ""}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "تُعَذِّبَ", "translit": "َbِّhdَʿعُt", "root": "عذب"}, {"id": 20, "arabic": "وَإِمَّآ", "translit": "ٓāَّmِiʾَw", "root": ""}, {"id": 21, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 22, "arabic": "تَتَّخِذَ", "translit": "َhdِhkَّtَt", "root": "اخذ"}, {"id": 23, "arabic": "فِيهِمْ", "translit": "ْmِhyِf", "root": ""}, {"id": 24, "arabic": "حُسْنًا", "translit": "āًnْsُḥ", "root": "حسن"}], "hasIhya": false}, {"ayah": 87, "text": "قَالَ أَمَّا مَن ظَلَمَ فَسَوْفَ نُعَذِّبُهُۥ ثُمَّ يُرَدُّ إِلَىٰ رَبِّهِۦ فَيُعَذِّبُهُۥ عَذَابًا نُّكْرًا ", "translation": "He said, \"As for one who wrongs,[1] we will punish him. Then he will be returned to his Lord, and He will punish him with a terrible punishment [i.e., Hellfire].", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "أَمَّا", "translit": "āَّmَaʾ", "root": ""}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "ظَلَمَ", "translit": "َmَlَẓ", "root": "ظلم"}, {"id": 5, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 6, "arabic": "نُعَذِّبُهُۥ", "translit": "ۥُhُbِّhdَʿعُn", "root": "عذب"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "يُرَدُّ", "translit": "ُّdَrُy", "root": "ردد"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 11, "arabic": "فَيُعَذِّبُهُۥ", "translit": "ۥُhُbِّhdَʿعُyَf", "root": "عذب"}, {"id": 12, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 13, "arabic": "نُّكْرًا", "translit": "āًrْkُّn", "root": "نكر"}], "hasIhya": false}, {"ayah": 88, "text": "وَأَمَّا مَنْ ءَامَنَ وَعَمِلَ صَٰلِحًا فَلَهُۥ جَزَآءً ٱلْحُسْنَىٰۖ وَسَنَقُولُ لَهُۥ مِنْ أَمْرِنَا يُسْرًا ", "translation": "But as for one who believes and does righteousness, he will have a reward of the best [i.e., Paradise], and we [i.e., Dhul-Qarnayn] will speak to him from our command with ease.\"", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 6, "arabic": "فَلَهُۥ", "translit": "ۥُhَlَf", "root": ""}, {"id": 7, "arabic": "جَزَآءً", "translit": "ًءٓāَzَjg", "root": "جزي"}, {"id": 8, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 9, "arabic": "وَسَنَقُولُ", "translit": "ُlwُqَnَsَw", "root": "قول"}, {"id": 10, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 11, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 12, "arabic": "أَمْرِنَا", "translit": "āَnِrْmَaʾ", "root": "امر"}, {"id": 13, "arabic": "يُسْرًا", "translit": "āًrْsُy", "root": "يسر"}], "hasIhya": false}, {"ayah": 89, "text": "ثُمَّ أَتْبَعَ سَبَبًا ", "translation": "Then he followed a way", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَتْبَعَ", "translit": "َʿعَbْtَaʾ", "root": "تبع"}, {"id": 3, "arabic": "سَبَبًا", "translit": "āًbَbَs", "root": "سبب"}], "hasIhya": false}, {"ayah": 90, "text": "حَتَّىٰٓ إِذَا بَلَغَ مَطْلِعَ ٱلشَّمْسِ وَجَدَهَا تَطْلُعُ عَلَىٰ قَوْمٍ لَّمْ نَجْعَل لَّهُم مِّن دُونِهَا سِتْرًا ", "translation": "Until, when he came to the rising of the sun [i.e., the east], he found it rising on a people for whom We had not made against it any shield.", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "بَلَغَ", "translit": "َغَlَb", "root": "بلغ"}, {"id": 4, "arabic": "مَطْلِعَ", "translit": "َʿعِlْṭَm", "root": "طلع"}, {"id": 5, "arabic": "ٱلشَّمْسِ", "translit": "ِsْmَّhslٱ", "root": "شمس"}, {"id": 6, "arabic": "وَجَدَهَا", "translit": "āَhَdَjgَw", "root": "وجد"}, {"id": 7, "arabic": "تَطْلُعُ", "translit": "ُʿعُlْṭَt", "root": "طلع"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 10, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 11, "arabic": "نَجْعَل", "translit": "lَʿعْjgَn", "root": "جعل"}, {"id": 12, "arabic": "لَّهُم", "translit": "mُhَّl", "root": ""}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "دُونِهَا", "translit": "āَhِnwُd", "root": "دون"}, {"id": 15, "arabic": "سِتْرًا", "translit": "āًrْtِs", "root": "ستر"}], "hasIhya": false}, {"ayah": 91, "text": "كَذَٰلِكَ وَقَدْ أَحَطْنَا بِمَا لَدَيْهِ خُبْرًا ", "translation": "Thus.[1] And We had encompassed [all] that he had in knowledge.", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 2, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 3, "arabic": "أَحَطْنَا", "translit": "āَnْṭَḥَaʾ", "root": "حوط"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "لَدَيْهِ", "translit": "ِhْyَdَl", "root": ""}, {"id": 6, "arabic": "خُبْرًا", "translit": "āًrْbُhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 92, "text": "ثُمَّ أَتْبَعَ سَبَبًا ", "translation": "Then he followed a way", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَتْبَعَ", "translit": "َʿعَbْtَaʾ", "root": "تبع"}, {"id": 3, "arabic": "سَبَبًا", "translit": "āًbَbَs", "root": "سبب"}], "hasIhya": false}, {"ayah": 93, "text": "حَتَّىٰٓ إِذَا بَلَغَ بَيْنَ ٱلسَّدَّيْنِ وَجَدَ مِن دُونِهِمَا قَوْمًا لَّا يَكَادُونَ يَفْقَهُونَ قَوْلًا ", "translation": "Until, when he reached [a pass] between two mountains, he found beside them a people who could hardly understand [his] speech.", "words": [{"id": 1, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 2, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 3, "arabic": "بَلَغَ", "translit": "َغَlَb", "root": "بلغ"}, {"id": 4, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 5, "arabic": "ٱلسَّدَّيْنِ", "translit": "ِnْyَّdَّslٱ", "root": "سدد"}, {"id": 6, "arabic": "وَجَدَ", "translit": "َdَjgَw", "root": "وجد"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "دُونِهِمَا", "translit": "āَmِhِnwُd", "root": "دون"}, {"id": 9, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 10, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 11, "arabic": "يَكَادُونَ", "translit": "َnwُdāَkَy", "root": "كود"}, {"id": 12, "arabic": "يَفْقَهُونَ", "translit": "َnwُhَqْfَy", "root": "فقه"}, {"id": 13, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}], "hasIhya": false}, {"ayah": 94, "text": "قَالُوا۟ يَٰذَا ٱلْقَرْنَيْنِ إِنَّ يَأْجُوجَ وَمَأْجُوجَ مُفْسِدُونَ فِى ٱلْأَرْضِ فَهَلْ نَجْعَلُ لَكَ خَرْجًا عَلَىٰٓ أَن تَجْعَلَ بَيْنَنَا وَبَيْنَهُمْ سَدًّا ", "translation": "They said, \"O Dhul-Qarnayn, indeed Gog and Magog[1] are [great] corrupters in the land. So may we assign for you an expenditure that you might make between us and them a barrier?\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰذَا", "translit": "āَhdَٰy", "root": ""}, {"id": 3, "arabic": "ٱلْقَرْنَيْنِ", "translit": "ِnْyَnْrَqْlٱ", "root": "قرن"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "يَأْجُوجَ", "translit": "َjgwُjgْaʾَy", "root": ""}, {"id": 6, "arabic": "وَمَأْجُوجَ", "translit": "َjgwُjgْaʾَmَw", "root": ""}, {"id": 7, "arabic": "مُفْسِدُونَ", "translit": "َnwُdِsْfُm", "root": "فسد"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "فَهَلْ", "translit": "ْlَhَf", "root": ""}, {"id": 11, "arabic": "نَجْعَلُ", "translit": "ُlَʿعْjgَn", "root": "جعل"}, {"id": 12, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 13, "arabic": "خَرْجًا", "translit": "āًjgْrَhk", "root": "خرج"}, {"id": 14, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "تَجْعَلَ", "translit": "َlَʿعْjgَt", "root": "جعل"}, {"id": 17, "arabic": "بَيْنَنَا", "translit": "āَnَnْyَb", "root": "بين"}, {"id": 18, "arabic": "وَبَيْنَهُمْ", "translit": "ْmُhَnْyَbَw", "root": "بين"}, {"id": 19, "arabic": "سَدًّا", "translit": "āًّdَs", "root": "سدد"}], "hasIhya": false}, {"ayah": 95, "text": "قَالَ مَا مَكَّنِّى فِيهِ رَبِّى خَيْرٌ فَأَعِينُونِى بِقُوَّةٍ أَجْعَلْ بَيْنَكُمْ وَبَيْنَهُمْ رَدْمًا ", "translation": "He said, \"That in which my Lord has established me is better [than what you offer], but assist me with strength [i.e., manpower]; I will make between you and them a dam.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "مَكَّنِّى", "translit": "àِّnَّkَm", "root": "مكن"}, {"id": 4, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 5, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 6, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 7, "arabic": "فَأَعِينُونِى", "translit": "àِnwُnyِʿعَaʾَf", "root": "عون"}, {"id": 8, "arabic": "بِقُوَّةٍ", "translit": "ٍẗَّwُqِb", "root": "قوي"}, {"id": 9, "arabic": "أَجْعَلْ", "translit": "ْlَʿعْjgَaʾ", "root": "جعل"}, {"id": 10, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 11, "arabic": "وَبَيْنَهُمْ", "translit": "ْmُhَnْyَbَw", "root": "بين"}, {"id": 12, "arabic": "رَدْمًا", "translit": "āًmْdَr", "root": "ردم"}], "hasIhya": false}, {"ayah": 96, "text": "ءَاتُونِى زُبَرَ ٱلْحَدِيدِۖ حَتَّىٰٓ إِذَا سَاوَىٰ بَيْنَ ٱلصَّدَفَيْنِ قَالَ ٱنفُخُوا۟ۖ حَتَّىٰٓ إِذَا جَعَلَهُۥ نَارًا قَالَ ءَاتُونِىٓ أُفْرِغْ عَلَيْهِ قِطْرًا ", "translation": "Bring me bars of iron\" - until, when he had leveled [them] between the two mountain walls, he said, \"Blow [with bellows],\" until when he had made it [like] fire, he said, \"Bring me, that I may pour over it molten copper.\"", "words": [{"id": 1, "arabic": "ءَاتُونِى", "translit": "àِnwُtāَء", "root": "اتي"}, {"id": 2, "arabic": "زُبَرَ", "translit": "َrَbُz", "root": "زبر"}, {"id": 3, "arabic": "ٱلْحَدِيدِ", "translit": "ِdyِdَḥْlٱ", "root": "حدد"}, {"id": 4, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 5, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 6, "arabic": "سَاوَىٰ", "translit": "ٰàَwāَs", "root": "سوي"}, {"id": 7, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 8, "arabic": "ٱلصَّدَفَيْنِ", "translit": "ِnْyَfَdَّṣlٱ", "root": "صدف"}, {"id": 9, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 10, "arabic": "ٱنفُخُوا۟", "translit": "۟āwُhkُfnٱ", "root": "نفخ"}, {"id": 11, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 12, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 13, "arabic": "جَعَلَهُۥ", "translit": "ۥُhَlَʿعَjg", "root": "جعل"}, {"id": 14, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 15, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 16, "arabic": "ءَاتُونِىٓ", "translit": "ٓàِnwُtāَء", "root": "اتي"}, {"id": 17, "arabic": "أُفْرِغْ", "translit": "ْغِrْfُaʾ", "root": "فرغ"}, {"id": 18, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 19, "arabic": "قِطْرًا", "translit": "āًrْṭِq", "root": "قطر"}], "hasIhya": false}, {"ayah": 97, "text": "فَمَا ٱسْطَٰعُوٓا۟ أَن يَظْهَرُوهُ وَمَا ٱسْتَطَٰعُوا۟ لَهُۥ نَقْبًا ", "translation": "So they [i.e., Gog and Magog] were unable to pass over it, nor were they able [to effect] in it any penetration.", "words": [{"id": 1, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 2, "arabic": "ٱسْطَٰعُوٓا۟", "translit": "۟āٓwُʿعَٰṭْsٱ", "root": "طوع"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يَظْهَرُوهُ", "translit": "ُhwُrَhْẓَy", "root": "ظهر"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "ٱسْتَطَٰعُوا۟", "translit": "۟āwُʿعَٰṭَtْsٱ", "root": "طوع"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "نَقْبًا", "translit": "āًbْqَn", "root": "نقب"}], "hasIhya": false}, {"ayah": 98, "text": "قَالَ هَٰذَا رَحْمَةٌ مِّن رَّبِّىۖ فَإِذَا جَآءَ وَعْدُ رَبِّى جَعَلَهُۥ دَكَّآءَۖ وَكَانَ وَعْدُ رَبِّى حَقًّا ", "translation": "[Dhul-Qarnayn] said, \"This is a mercy from my Lord; but when the promise of my Lord[1] comes [i.e., approaches], He will make it level, and ever is the promise of my Lord true.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 3, "arabic": "رَحْمَةٌ", "translit": "ٌẗَmْḥَr", "root": "رحم"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "رَّبِّى", "translit": "àِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 7, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 8, "arabic": "وَعْدُ", "translit": "ُdْʿعَw", "root": "وعد"}, {"id": 9, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 10, "arabic": "جَعَلَهُۥ", "translit": "ۥُhَlَʿعَjg", "root": "جعل"}, {"id": 11, "arabic": "دَكَّآءَ", "translit": "َءٓāَّkَd", "root": "دكك"}, {"id": 12, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 13, "arabic": "وَعْدُ", "translit": "ُdْʿعَw", "root": "وعد"}, {"id": 14, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 15, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}], "hasIhya": false}, {"ayah": 99, "text": "وَتَرَكْنَا بَعْضَهُمْ يَوْمَئِذٍ يَمُوجُ فِى بَعْضٍۖ وَنُفِخَ فِى ٱلصُّورِ فَجَمَعْنَٰهُمْ جَمْعًا ", "translation": "And We will leave them that day[1] surging over each other, and [then] the Horn will be blown, and We will assemble them in [one] assembly.", "words": [{"id": 1, "arabic": "وَتَرَكْنَا", "translit": "āَnْkَrَtَw", "root": "ترك"}, {"id": 2, "arabic": "بَعْضَهُمْ", "translit": "ْmُhَḍْʿعَb", "root": "بعض"}, {"id": 3, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 4, "arabic": "يَمُوجُ", "translit": "ُjgwُmَy", "root": "موج"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 7, "arabic": "وَنُفِخَ", "translit": "َhkِfُnَw", "root": "نفخ"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلصُّورِ", "translit": "ِrwُّṣlٱ", "root": "صور"}, {"id": 10, "arabic": "فَجَمَعْنَٰهُمْ", "translit": "ْmُhَٰnْʿعَmَjgَf", "root": "جمع"}, {"id": 11, "arabic": "جَمْعًا", "translit": "āًʿعْmَjg", "root": "جمع"}], "hasIhya": false}, {"ayah": 100, "text": "وَعَرَضْنَا جَهَنَّمَ يَوْمَئِذٍ لِّلْكَٰفِرِينَ عَرْضًا ", "translation": "And We will present Hell that Day to the disbelievers, on display -", "words": [{"id": 1, "arabic": "وَعَرَضْنَا", "translit": "āَnْḍَrَʿعَw", "root": "عرض"}, {"id": 2, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 3, "arabic": "يَوْمَئِذٍ", "translit": "ٍhdِyʾَmْwَy", "root": "يوم"}, {"id": 4, "arabic": "لِّلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِّl", "root": "كفر"}, {"id": 5, "arabic": "عَرْضًا", "translit": "āًḍْrَʿع", "root": "عرض"}], "hasIhya": false}, {"ayah": 101, "text": "ٱلَّذِينَ كَانَتْ أَعْيُنُهُمْ فِى غِطَآءٍ عَن ذِكْرِى وَكَانُوا۟ لَا يَسْتَطِيعُونَ سَمْعًا ", "translation": "Those whose eyes had been within a cover [removed] from My remembrance,[1] and they were not able to hear.[2]", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 3, "arabic": "أَعْيُنُهُمْ", "translit": "ْmُhُnُyْʿعَaʾ", "root": "عين"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "غِطَآءٍ", "translit": "ٍءٓāَṭِغ", "root": "غطو"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "ذِكْرِى", "translit": "àِrْkِhd", "root": "ذكر"}, {"id": 8, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَسْتَطِيعُونَ", "translit": "َnwُʿعyِṭَtْsَy", "root": "طوع"}, {"id": 11, "arabic": "سَمْعًا", "translit": "āًʿعْmَs", "root": "سمع"}], "hasIhya": false}, {"ayah": 102, "text": "أَفَحَسِبَ ٱلَّذِينَ كَفَرُوٓا۟ أَن يَتَّخِذُوا۟ عِبَادِى مِن دُونِىٓ أَوْلِيَآءَۚ إِنَّآ أَعْتَدْنَا جَهَنَّمَ لِلْكَٰفِرِينَ نُزُلًا ", "translation": "Then do those who disbelieve think that they can take My servants instead of Me as allies? Indeed, We have prepared Hell for the disbelievers as a lodging.", "words": [{"id": 1, "arabic": "أَفَحَسِبَ", "translit": "َbِsَḥَfَaʾ", "root": "حسب"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَتَّخِذُوا۟", "translit": "۟āwُhdِhkَّtَy", "root": "اخذ"}, {"id": 6, "arabic": "عِبَادِى", "translit": "àِdāَbِʿع", "root": "عبد"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "دُونِىٓ", "translit": "ٓàِnwُd", "root": "دون"}, {"id": 9, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 10, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 11, "arabic": "أَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾ", "root": "عتد"}, {"id": 12, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 13, "arabic": "لِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِl", "root": "كفر"}, {"id": 14, "arabic": "نُزُلًا", "translit": "āًlُzُn", "root": "نزل"}], "hasIhya": false}, {"ayah": 103, "text": "قُلْ هَلْ نُنَبِّئُكُم بِٱلْأَخْسَرِينَ أَعْمَٰلًا ", "translation": "Say, [O Muḥammad], \"Shall we [believers] inform you of the greatest losers as to [their] deeds?", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 3, "arabic": "نُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُn", "root": "نبا"}, {"id": 4, "arabic": "بِٱلْأَخْسَرِينَ", "translit": "َnyِrَsْhkَaʾْlٱِb", "root": "خسر"}, {"id": 5, "arabic": "أَعْمَٰلًا", "translit": "āًlَٰmْʿعَaʾ", "root": "عمل"}], "hasIhya": true}, {"ayah": 104, "text": "ٱلَّذِينَ ضَلَّ سَعْيُهُمْ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَهُمْ يَحْسَبُونَ أَنَّهُمْ يُحْسِنُونَ صُنْعًا ", "translation": "[They are] those whose effort is lost in worldly life, while they think that they are doing well in work.\"", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 3, "arabic": "سَعْيُهُمْ", "translit": "ْmُhُyْʿعَs", "root": "سعي"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 6, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 7, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 8, "arabic": "يَحْسَبُونَ", "translit": "َnwُbَsْḥَy", "root": "حسب"}, {"id": 9, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 10, "arabic": "يُحْسِنُونَ", "translit": "َnwُnِsْḥُy", "root": "حسن"}, {"id": 11, "arabic": "صُنْعًا", "translit": "āًʿعْnُṣ", "root": "صنع"}], "hasIhya": true}, {"ayah": 105, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ كَفَرُوا۟ بِـَٔايَٰتِ رَبِّهِمْ وَلِقَآئِهِۦ فَحَبِطَتْ أَعْمَٰلُهُمْ فَلَا نُقِيمُ لَهُمْ يَوْمَ ٱلْقِيَٰمَةِ وَزْنًا ", "translation": "Those are the ones who disbelieve in the verses of their Lord and in [their] meeting Him, so their deeds have become worthless; and We will not assign to them on the Day of Resurrection any weight [i.e., importance].", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 6, "arabic": "وَلِقَآئِهِۦ", "translit": "ۦِhِyʾٓāَqِlَw", "root": "لقي"}, {"id": 7, "arabic": "فَحَبِطَتْ", "translit": "ْtَṭِbَḥَf", "root": "حبط"}, {"id": 8, "arabic": "أَعْمَٰلُهُمْ", "translit": "ْmُhُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 9, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 10, "arabic": "نُقِيمُ", "translit": "ُmyِqُn", "root": "قوم"}, {"id": 11, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 12, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 13, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 14, "arabic": "وَزْنًا", "translit": "āًnْzَw", "root": "وزن"}], "hasIhya": false}, {"ayah": 106, "text": "ذَٰلِكَ جَزَآؤُهُمْ جَهَنَّمُ بِمَا كَفَرُوا۟ وَٱتَّخَذُوٓا۟ ءَايَٰتِى وَرُسُلِى هُزُوًا ", "translation": "That is their recompense - Hell - for what they denied and [because] they took My signs and My messengers in ridicule.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "جَزَآؤُهُمْ", "translit": "ْmُhُwʾٓāَzَjg", "root": "جزي"}, {"id": 3, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 6, "arabic": "وَٱتَّخَذُوٓا۟", "translit": "۟āٓwُhdَhkَّtٱَw", "root": "اخذ"}, {"id": 7, "arabic": "ءَايَٰتِى", "translit": "àِtَٰyāَء", "root": "ايي"}, {"id": 8, "arabic": "وَرُسُلِى", "translit": "àِlُsُrَw", "root": "رسل"}, {"id": 9, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}], "hasIhya": false}, {"ayah": 107, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ كَانَتْ لَهُمْ جَنَّٰتُ ٱلْفِرْدَوْسِ نُزُلًا ", "translation": "Indeed, those who have believed and done righteous deeds - they will have the Gardens of Paradise[1] as a lodging,", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 7, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 8, "arabic": "جَنَّٰتُ", "translit": "ُtَّٰnَjg", "root": "جنن"}, {"id": 9, "arabic": "ٱلْفِرْدَوْسِ", "translit": "ِsْwَdْrِfْlٱ", "root": ""}, {"id": 10, "arabic": "نُزُلًا", "translit": "āًlُzُn", "root": "نزل"}], "hasIhya": false}, {"ayah": 108, "text": "خَٰلِدِينَ فِيهَا لَا يَبْغُونَ عَنْهَا حِوَلًا ", "translation": "Wherein they abide eternally. They will not desire from it any transfer.", "words": [{"id": 1, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَبْغُونَ", "translit": "َnwُغْbَy", "root": "بغي"}, {"id": 5, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 6, "arabic": "حِوَلًا", "translit": "āًlَwِḥ", "root": "حول"}], "hasIhya": false}, {"ayah": 109, "text": "قُل لَّوْ كَانَ ٱلْبَحْرُ مِدَادًا لِّكَلِمَٰتِ رَبِّى لَنَفِدَ ٱلْبَحْرُ قَبْلَ أَن تَنفَدَ كَلِمَٰتُ رَبِّى وَلَوْ جِئْنَا بِمِثْلِهِۦ مَدَدًا ", "translation": "Say, \"If the sea were ink for [writing] the words[1] of my Lord, the sea would be exhausted before the words of my Lord were exhausted, even if We brought the like of it in [continual] supplement.\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "ٱلْبَحْرُ", "translit": "ُrْḥَbْlٱ", "root": "بحر"}, {"id": 5, "arabic": "مِدَادًا", "translit": "āًdāَdِm", "root": "مدد"}, {"id": 6, "arabic": "لِّكَلِمَٰتِ", "translit": "ِtَٰmِlَkِّl", "root": "كلم"}, {"id": 7, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 8, "arabic": "لَنَفِدَ", "translit": "َdِfَnَl", "root": "نفد"}, {"id": 9, "arabic": "ٱلْبَحْرُ", "translit": "ُrْḥَbْlٱ", "root": "بحر"}, {"id": 10, "arabic": "قَبْلَ", "translit": "َlْbَq", "root": "قبل"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "تَنفَدَ", "translit": "َdَfnَt", "root": "نفد"}, {"id": 13, "arabic": "كَلِمَٰتُ", "translit": "ُtَٰmِlَk", "root": "كلم"}, {"id": 14, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 15, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 16, "arabic": "جِئْنَا", "translit": "āَnْyʾِjg", "root": "جيا"}, {"id": 17, "arabic": "بِمِثْلِهِۦ", "translit": "ۦِhِlْhtِmِb", "root": "مثل"}, {"id": 18, "arabic": "مَدَدًا", "translit": "āًdَdَm", "root": "مدد"}], "hasIhya": true}, {"ayah": 110, "text": "قُلْ إِنَّمَآ أَنَا۠ بَشَرٌ مِّثْلُكُمْ يُوحَىٰٓ إِلَىَّ أَنَّمَآ إِلَٰهُكُمْ إِلَٰهٌ وَٰحِدٌۖ فَمَن كَانَ يَرْجُوا۟ لِقَآءَ رَبِّهِۦ فَلْيَعْمَلْ عَمَلًا صَٰلِحًا وَلَا يُشْرِكْ بِعِبَادَةِ رَبِّهِۦٓ أَحَدًۢا ", "translation": "Say, \"I am only a man like you, to whom has been revealed that your god is one God. So whoever would hope for the meeting with his Lord - let him do righteous work and not associate in the worship of his Lord anyone.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِنَّمَآ", "translit": "ٓāَmَّnِiʾ", "root": ""}, {"id": 3, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 4, "arabic": "بَشَرٌ", "translit": "ٌrَhsَb", "root": "بشر"}, {"id": 5, "arabic": "مِّثْلُكُمْ", "translit": "ْmُkُlْhtِّm", "root": "مثل"}, {"id": 6, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 7, "arabic": "إِلَىَّ", "translit": "َّàَlِiʾ", "root": ""}, {"id": 8, "arabic": "أَنَّمَآ", "translit": "ٓāَmَّnَaʾ", "root": ""}, {"id": 9, "arabic": "إِلَٰهُكُمْ", "translit": "ْmُkُhَٰlِiʾ", "root": "اله"}, {"id": 10, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 11, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 12, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 13, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 14, "arabic": "يَرْجُوا۟", "translit": "۟āwُjgْrَy", "root": "رجو"}, {"id": 15, "arabic": "لِقَآءَ", "translit": "َءٓāَqِl", "root": "لقي"}, {"id": 16, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 17, "arabic": "فَلْيَعْمَلْ", "translit": "ْlَmْʿعَyْlَf", "root": "عمل"}, {"id": 18, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}, {"id": 19, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 20, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 21, "arabic": "يُشْرِكْ", "translit": "ْkِrْhsُy", "root": "شرك"}, {"id": 22, "arabic": "بِعِبَادَةِ", "translit": "ِẗَdāَbِʿعِb", "root": "عبد"}, {"id": 23, "arabic": "رَبِّهِۦٓ", "translit": "ٓۦِhِّbَr", "root": "ربب"}, {"id": 24, "arabic": "أَحَدًۢا", "translit": "āًۢdَḥَaʾ", "root": "احد"}], "hasIhya": true}], "tafsir": {"7": [{"arabic": "أراك ناجيا وقال الفضيل طالت فكرتي في هذه الآية {إنا جعلنا ما على الأرض زينة لها لنبلوهم أيهم أحسن عملا وإنا لجاعلون ما عليها صعيدا جرزا} وقال بعض الحكماء إنك لن تصبح في شيء من الدنيا إلا وقد كان له أهل قبلك وسيكون له أهل بعدك وليس لك من الدنيا إلا عشاء ليلة وغداء يوم فلا تهلك في أكله وصم عن الدنيا وأفطر على الآخرة وإن رأس مال الدنيا الهوى وربحها النار وقيل لبعض الرهبان كيف ترى الدهر قال يخلق الأبدان ويجدد الآمال ويقرب المنية ويبعد الأمنية قيل فما حال أهله قال من ظفر به تعب ومن فاته نصب وفي ذلك قيل ومن يحمد الدنيا لعيش يسره .", "english": "And Jesus, peace be upon him, said: \"O seeker of the world for the sake of piety — verily, your abandoning the world is more pious.\"", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 733", "section_title_en": "The Revival of the Religious Sciences — On the Blame of the World and the Virtue of Renouncing It (Section 733)", "section_index": 733, "anchors": "- Root: دنا (d-n-w)\n  * Lisan / Ayn: Core meaning of proximity, nearness; also lowness and baseness (dani'a) in moral character.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by judgment; al-dunya (the lower world) is so named for its nearness to us in time and its lowness in rank relative to the Hereafter.\n  * Al-Zamakhshari (Asas): Literal (haqiqah): \"هو دنيء من الأدنياء وهو الرقيق الخلق الحقير\" — the base, contemptible man. The world (al-dunya) is that which is low and base in contrast to the exalted Hereafter.\n- Root: طلب (t-l-b)\n  * Lisan / Ayn: To seek, to search out, to demand; also to pursue with earnestness.\n  * Al-Raghib (Mufradat): \"الطلب: الفحص عن وجود الشيء، عينا كان أو معنى\" — the investigation into the existence of a thing, whether corporeal or conceptual.\n  * Al-Zamakhshari (Asas): Literal: \"طلب الشيء طلبا ومطلبا وطلابا وطلابة\" — seeking with various intensifications. Metaphorical (majaz): \"السراج يطلب أن ينطفيء\" — the lamp seeks to go out, i.e., tends toward its natural end. Thus \"seeking the world\" (talab al-dunya) is the soul's natural gravitation toward the base and ephemeral.\n- Root: اكل (a-k-l)\n  * Lisan / Ayn: To eat, to consume; also to corrode, to erode.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم، وعلى طريق التشبيه قيل: أكلت النار الحطب\" — eating is consuming nourishment; metaphorically, fire \"eats\" wood.\n  * Al-Zamakhshari (Asas): Metaphorical: \"فلان أكل غنمي وشربها\" — he consumed my sheep and drank them, i.e., he devoured my wealth. Thus the world \"eats\" faith as fire eats firewood — a consuming, destructive corrosion of the spiritual substance.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: To kindle, to ignite, to blaze.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-waqūd is the fuel itself.\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed up. Metaphorical: \"قلب وقاد\" — a blazing heart, i.e., one that is intensely alive and perceptive. The comparison of the world's consumption of faith to fire's consumption of firewood is thus a literal-metaphorical analogy of total annihilation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts and confines the predicate to the subject alone, excluding all else. Applied in the aphorism \"إنما الدنيا عشاء ليلة وغداء يوم\" — the world is nothing but an evening meal and a morning meal, restricting its entirety to a single day's sustenance.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "10": [{"arabic": "سبقونا بالإيمان ولا تجعل في قلوبنا غلا للذين آمنوا ربنا إنك رؤوف رحيم ربنا آتنا من لدنك رحمة وهيئ لنا من أمرنا رشدا ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ربنا إننا سمعنا مناديا ينادي للإيمان إلى قوله عز وجل إنك لا تخلف الميعاد ربنا لا تؤاخذنا إن نسينا أو أخطأنا ربنا إلى آخر السورة (3) رب اغفر لي ولوالدي وارحمهما كما ربياني صغيرا واغفر للمؤمنين والمؤمنات والمسلمين والمسلمات الأحياء منهم والأموات (4) رب اغفر وارحم وتجاوز عما تعلم وأنت الأعز الأكرم وأنت خير الراحمين وأنت خير الغافرين وإنا لله وإنا إليه راجعون ولا حول ولا قوة إلا بالله العلي العظ", "english": "And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 252", "section_title_en": "Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)", "section_index": 252, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "ربنا آتنا من لدنك رحمة وهيئ لنا من أمرنا رشدا ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ربنا إننا سمعنا مناديا ينادي للإيمان إلى قوله عز وجل إنك لا تخلف الميعاد ربنا لا تؤاخذنا إن نسينا أو أخطأنا ربنا إلى آخر السورة (3) رب اغفر لي ولوالدي وارحمهما كما ربياني صغيرا واغفر للمؤمنين والمؤمنات والمسلمين والمسلمات الأحياء منهم والأموات (4) رب اغفر وارحم وتجاوز عما تعلم وأنت الأعز الأكرم وأنت خير الراحمين وأنت خير الغافرين وإنا لله وإنا إليه راجعون ولا حول ولا قوة إلا بالله العلي", "english": "And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 252", "section_title_en": "Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)", "section_index": 252, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "13": [{"arabic": "إبراهيم} وقوله تعالى {إنهم فتية آمنوا بربهم وزدناهم هدى} وقوله تعالى {وآتيناه الحكم صبيا} وكان أنس رضي الله عنه يقول قبض رسول الله صلى الله عليه وسلم وليس في رأسه ولحيته عشرون شعرة بيضاء فقيل له يا أبا حمزة فقد أسن فقال لم يشنه الله بالشيب فقيل أهو شين فقال كلكم يكرهه (1) ويقال إن يحيى بن أكثم ولي القضاء وهو ابن إحدى وعشرين سنة فقال له رجل في مجلسه يريد أن يخجله بصغر سنه كم سن القاضي أيده الله فقال مثل سن عتاب بن أسيد حين ولاه رسول الله صلى الله عليه وسلم إمارة مكة وقضاءها فأفحمه (2) وروي عن مالك", "english": "As for the first — namely, dyeing it black — it is prohibited, for the Prophet, peace be upon him, said: \"The best of your young men are those who resemble your old men, and the worst of your old men are those who resemble your young men.\" (1) What is meant by resembling the old men is in dignity (al-waqār), not in whitening the hair. And he prohibited dyeing with black, (2) saying: \"It is the dye of the inhabitants of the Fire.\" (3) In another wording: \"Dyeing with black is the dye of the disbelievers.\" A man married during the caliphate of ʿUmar, may Allah be pleased with him, while dyeing his hair black; his dye faded and his whiteness appeared. The woman's family brought him to ʿUmar, may Allah be pleased with him, who annulled his marriage, struck him painfully, and said: \"You deceived the people with youth and disguised your whiteness from them.\" It is said that the first to dye with black was Pharaoh, may Allah curse him. And it is related from Ibn ʿAbbās, may Allah be pleased with them both, from the Prophet, peace be upon him, that he said: \"There will come at the end of time a people who dye with black like the crops of pigeons; they will not smell the fragrance of Paradise.\" (4)", "book_title": "Mysteries of Purity", "section_title_ar": "Section 119", "section_title_en": "The Book of the Secrets of Purification — Section 119: On the Beard and Its Disapproved Practices", "section_index": 119, "anchors": "- Root: شيب (sh-y-b)\n  * Lisan / Ayn: Whiteness of hair; the first appearance of white hairs marking the transition from youth to age.\n  * Al-Raghib (Mufradat): \"الشيب والمشيب: بياض الشعر\" — cited with {واشتعل الرأس شيبا} [Maryam/4]; theologically, it is the visible sign of decrepitude and the approach of death, thus a divine summons.\n  * Al-Zamakhshari (Asas): Haqiqah: \"شاب شيبة، ورجل أشيب\" — literal whitening of hair. Majaz: \"شابت رءوس الإكام\" — metaphorical whitening of mountain peaks with frost/snow, indicating that the physical whiteness of the beard is but a surface sign of an inner reality.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as a mark, sign, or banner (ʿalam); the act of knowing by direct apprehension.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing by its true reality; it is a fruit of the intellect (ʿaql), not of accumulated years.\n  * Al-Zamakhshari (Asas): Haqiqah: \"ما علمت بخبرك: ما شعرت به\" — knowledge as direct awareness. The scholia here ground the author's argument that age does not confer knowledge; rather, knowledge is a divinely-given subtle reality (laṭīfah rabbāniyyah) independent of bodily whitening.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: Fire blazing and burning intensely.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the kindling and blazing of fire; cited with {وقودها الناس والحجارة} [Al-Baqara/24].\n  * Al-Zamakhshari (Asas): Majaz: \"قلب وقاد\" — a blazing, keen intellect. This anchors the contrast between the superficial blaze of dyed hair (a false fire) and the inner blaze of youthful intelligence (a true light).\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule permits interposition between a governing word and its governed prepositional phrase when the intervening element is semantically complete. This governs the periodic structure of the author's long enumerations, where each disapproved characteristic is stated, then separated from its governing judgment by explanatory clauses, requiring the translator to preserve the suspended syntactic tension until the judgment is delivered.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Mysteries of Purity'", "badge": "Hadith"}], "15": [{"arabic": "الله تعالى بين من افترى على الله كذبا وبين من كذب بالحق فقال تعالى ومن أظلم ممن افترى على الله كذبا أو كذب بالحق لما جاءه وقال تعالى فمن أظلم ممن كذب على الله وكذب بالصدق إذ جاءه ومنها الرياء وملاحظة الخلق والجهد في استمالة قلوبهم وصرف وجوههم والرياء هو الداء العضال الذي يدعو إلى أكبر الكبائر كما سيأتي في كتاب الرياء والمناظر لا يقصد إلا الظهور عند الخلق وانطلاق ألسنتهم بالثناء عليه فهذه عشر خصال من أمهات الفواحش الباطنة سوى ما يتفق لغير المتماسكين منهم من الخصام المؤدي إلى الضرب", "english": "**QUAD_ANCHORS:**\n- Root: نظر (naẓara)\n  * Lisan / Ayn: Core meaning: to look, to examine, to consider; al-munāẓarah is mutual examination/argumentation between two parties.\n  * Al-Raghib (Mufradat): Theological nuance: naẓar as intellectual contemplation (taʾammul bi-l-baṣīrah); munāẓarah as dialectical exchange.\n  * Al-Zamakhshari (Asas): Literal: sitting face-to-face in debate; Metaphorical: disputation for victory.\n- Root: غلب (ghalaba)\n  * Lisan / Ayn: Core meaning: to overcome, to conquer, to prevail.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghalabah as seeking to dominate another in argument.\n  * Al-Zamakhshari (Asas): Literal: victory in combat; Metaphorical: intellectual supremacy.\n- Root: حسد (ḥasada)\n  * Lisan / Ayn: Core meaning: to envy, to wish removal of blessings from another.\n  * Al-Raghib (Mufradat): Theological nuance: envy as wishing deprivation of blessings from the deserving — among the basest traits.\n  * Al-Zamakhshari (Asas): Literal: envy of another's blessing; Metaphorical: consuming fire of the soul.\n- Root: كبر (kabura)\n  * Lisan / Ayn: Core meaning: to be great, to be haughty.\n  * Al-Raghib (Mufradat): Theological nuance: al-kibr as self-elevation above others; condemned by God.\n  * Al-Zamakhshari (Asas): Literal: greatness; Metaphorical: arrogance and pride.\n- Root: غيب (ghāba)\n  * Lisan / Ayn: Core meaning: to be absent, to be hidden.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghībah as mentioning another with what he dislikes in his absence — likened to eating carrion.\n  * Al-Zamakhshari (Asas): Literal: backbiting; Metaphorical: consuming the flesh of one's brother.\n- Root: راءى (rāʾā)\n  * Lisan / Ayn: Core meaning: to show off, to display.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as performing acts for the sake of being seen — hidden shirk.\n  * Al-Zamakhshari (Asas): Literal: showing good deeds; Metaphorical: seeking reputation.\n- Root: نفس (nafs)\n  * Lisan / Ayn: Core meaning: self, soul, spirit.\n  * Al-Raghib (Mufradat): Theological nuance: tazkiyat al-nafs as self-praise and self-purification — forbidden by God.\n  * Al-Zamakhshari (Asas): Literal: self; Metaphorical: self-commendation.\n- Root: حقd (ḥaqida)\n  * Lisan / Ayn: Core meaning: to bear malice, to harbor resentment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ḥiqd as nursing enmity in the heart — negated from the believer.\n  * Al-Zamakhshari (Asas): Literal: bearing grudge; Metaphorical: hidden rancor.\n- Root: نفاق (nifāq)\n  * Lisan / Ayn: Core meaning: hypocrisy, showing contrary to what one conceals.\n  * Al-Raghib (Mufradat): Theological nuance: hypocrisy in deeds — outward display contrary to inward state.\n  * Al-Zamakhshari (Asas): Literal: hypocrisy in faith; Metaphorical: hypocrisy in character.\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning: to know, to perceive.\n  * Al-Raghib (Mufradat): Theological nuance: knowledge as apprehension of reality — its pursuit for other than God is destructive.\n  * Al-Zamakhshari (Asas): Literal: knowledge; Metaphorical: the dangerous burden of the scholar.\n- Root: جدل (jadala)\n  * Lisan / Ayn: Core meaning: to argue, to dispute.\n  * Al-Raghib (Mufradat): Theological nuance: al-jidāl as contention; al-mirāʾ as disputation with falsehood — condemned.\n  * Al-Zamakhshari (Asas): Literal: argumentation; Metaphorical: obstinate disputation.\n- Root: شرك (sharaka)\n  * Lisan / Ayn: Core meaning: to associate, to share.\n  * Al-Raghib (Mufradat): Theological nuance: al-riyāʾ as hidden shirk — associating others with God in intention.\n  * Al-Zamakhshari (Asas): Literal: polytheism; Metaphorical: hidden association in deeds.\n- Root: موت (māta)\n  * Lisan / Ayn: Core meaning: to die.\n  * Al-Raghib (Mufradat): Theological nuance: death as separation of soul from body; spiritual death as ruin of the soul.\n  * Al-Zamakhshari (Asas): Literal: physical death; Metaphorical: spiritual destruction.\n- Root: حيى (ḥayiya)\n  * Lisan / Ayn: Core meaning: to live.\n  * Al-Raghib (Mufradat): Theological nuance: life as the power of perception; eternal life as the reward of the righteous.\n  * Al-Zamakhshari (Asas): Literal: physical life; Metaphorical: spiritual vitality.\n- Root: هلك (halaka)\n  * Lisan / Ayn: Core meaning: to perish, to be destroyed.\n  * Al-Raghib (Mufradat): Theological nuance: al-halāk as ruin; eternal destruction as everlasting punishment.\n  * Al-Zamakhshari (Asas): Literal: destruction; Metaphorical: eternal ruin.\n- Root: رياء (riyāʾ)\n  * Lisan / Ayn: Core meaning: showing off, ostentation.\n  * Al-Raghib (Mufradat): Theological nuance: riyāʾ as the incurable disease calling to the greatest sins.\n  * Al-Zamakhshari (Asas): Literal: ostentation; Metaphorical: spiritual disease.\n- Root: جاه (jāh)\n  * Lisan / Ayn: Core meaning: rank, status, prestige.\n  * Al-Raghib (Mufradat): Theological nuance: love of status (ḥubb al-jāh) among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: position; Metaphorical: seeking prestige.\n- Root: مباهاة (mubāhāh)\n  * Lisan / Ayn: Core meaning: mutual boasting, vying in splendor.\n  * Al-Raghib (Mufradat): Theological nuance: mubāhāh as each seeking to display superiority over the other.\n  * Al-Zamakhshari (Asas): Literal: mutual boasting; Metaphorical: rivalry in honor.\n- Root: مماراة (mumārāh)\n  * Lisan / Ayn: Core meaning: disputation, wrangling.\n  * Al-Raghib (Mufradat): Theological nuance: al-mirāʾ as contentious argument — condemned by the Prophet.\n  * Al-Zamakhshari (Asas): Literal: disputation; Metaphorical: obstinate wrangling.\n- Root: فخر (fakhara)\n  * Lisan / Ayn: Core meaning: to boast, to pride oneself.\n  * Al-Raghib (Mufradat): Theological nuance: al-fakhr as self-glorification — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: boasting; Metaphorical: vainglory.\n- Root: عجب (ʿajiba)\n  * Lisan / Ayn: Core meaning: to wonder, to be amazed.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿujb as self-admiration — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: wonder; Metaphorical: self-conceit.\n- Root: بغض (baghiḍa)\n  * Lisan / Ayn: Core meaning: to hate, to detest.\n  * Al-Raghib (Mufradat): Theological nuance: al-baghdāʾ as mutual hatred — contrary to brotherhood.\n  * Al-Zamakhshari (Asas): Literal: hatred; Metaphorical: mutual enmity.\n- Root: غضب (ghaḍiba)\n  * Lisan / Ayn: Core meaning: to be angry.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaḍab as anger — among the blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: anger; Metaphorical: rage.\n- Root: طمع (ṭamiʿa)\n  * Lisan / Ayn: Core meaning: to covet, to desire.\n  * Al-Raghib (Mufradat): Theological nuance: al-ṭamaʿ as covetousness — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: desire; Metaphorical: greed.\n- Root: أشر (ashira)\n  * Lisan / Ayn: Core meaning: to be exultant, to be insolent.\n  * Al-Raghib (Mufradat): Theological nuance: al-ashar as excessive joy and insolence — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: exultation; Metaphorical: insolence.\n- Root: بطر (baṭira)\n  * Lisan / Ayn: Core meaning: to be arrogant, to be ungrateful.\n  * Al-Raghib (Mufradat): Theological nuance: al-baṭar as arrogance in prosperity — among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: arrogance; Metaphorical: ingratitude for blessings.\n- Root: خيلاء (khuyalāʾ)\n  * Lisan / Ayn: Core meaning: pride, haughtiness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khuyalāʾ as pride and conceit — blameworthy.\n  * Al-Zamakhshari (Asas): Literal: pride; Metaphorical: haughty bearing.\n- Root: خشية (khashyah)\n  * Lisan / Ayn: Core meaning: fear, awe.\n  * Al-Raghib (Mufradat): Theological nuance: al-khashyah as reverential fear — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: fear; Metaphorical: reverential awe.\n- Root: رحمة (raḥmah)\n  * Lisan / Ayn: Core meaning: mercy, compassion.\n  * Al-Raghib (Mufradat): Theological nuance: al-raḥmah as tenderness of heart — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: mercy; Metaphorical: compassion.\n- Root: غفلة (ghaflah)\n  * Lisan / Ayn: Core meaning: heedlessness, inattention.\n  * Al-Raghib (Mufradat): Theological nuance: al-ghaflah as heedlessness — contrary to vigilance.\n  * Al-Zamakhshari (Asas): Literal: inattention; Metaphorical: spiritual heedlessness.\n- Root: خشوع (khushūʿ)\n  * Lisan / Ayn: Core meaning: humility, submissiveness.\n  * Al-Raghib (Mufradat): Theological nuance: al-khushūʿ as humility — among the traits of the believers.\n  * Al-Zamakhshari (Asas): Literal: humility; Metaphorical: devotional submission.\n- Root: تذكير (tadhkīr)\n  * Lisan / Ayn: Core meaning: reminding, admonishing.\n  * Al-Raghib (Mufradat): Theological nuance: al-tadhkīr as reminding of God — a righteous act.\n  * Al-Zamakhshari (Asas): Literal: reminding; Metaphorical: preaching.\n- Root: وعظ (waʿaẓa)\n  * Lisan / Ayn: Core meaning: to admonish, to exhort.\n  * Al-Raghib (Mufradat): Theological nuance: al-waʿẓ as exhortation to obedience and warning against disobedience.\n  * Al-Zamakhshari (Asas): Literal: admonition; Metaphorical: sermonizing.\n- Root: فتوى (fatwā)\n  * Lisan / Ayn: Core meaning: legal ruling, formal opinion.\n  * Al-Raghib (Mufradat): Theological nuance: al-fatwā as clarification of legal rulings.\n  * Al-Zamakhshari (Asas): Literal: legal opinion; Metaphorical: religious authority.\n- Root: قضاء (qaḍāʾ)\n  * Lisan / Ayn: Core meaning: judgment, decree.\n  * Al-Raghib (Mufradat): Theological nuance: al-qaḍāʾ as judgment between people.\n  * Al-Zamakhshari (Asas): Literal: judgment; Metaphorical: judicial authority.\n- Root: وقف (waqafa)\n  * Lisan / Ayn: Core meaning: to stop, to stand.\n  * Al-Raghib (Mufradat): Theological nuance: al-waqf as endowment of property for charitable purposes.\n  * Al-Zamakhshari (Asas): Literal: standing; Metaphorical: religious endowment.\n- Root: ثواب (thawāb)\n  * Lisan / Ayn: Core meaning: reward, recompense.\n  * Al-Raghib (Mufradat): Theological nuance: al-thawāb as divine recompense for righteous deeds.\n  * Al-Zamakhshari (Asas): Literal: reward; Metaphorical: divine recompense.\n- Root: عذاب (ʿadhāb)\n  * Lisan / Ayn: Core meaning: punishment, torment.\n  * Al-Raghib (Mufradat): Theological nuance: al-ʿadhāb as divine punishment for the disobedient.\n  * Al-Zamakhshari (Asas): Literal: punishment; Metaphorical: divine chastisement.\n- Root: ملك (malaka)\n  * Lisan / Ayn: Core meaning: to possess, to rule.\n  * Al-Raghib (Mufradat): Theological nuance: al-mulk as sovereignty; al-mulk al-muʾabbad as eternal sovereignty in Paradise.\n  * Al-Zamakhshari (Asas): Literal: dominion; Metaphorical: eternal kingdom.\n- Root: نعيم (naʿīm)\n  * Lisan / Ayn: Core meaning: bliss, delight.\n  * Al-Raghib (Mufradat): Theological nuance: al-naʿīm as bliss; al-naʿīm al-sarmad as everlasting bliss.\n  * Al-Zamakhshari (Asas): Literal: delight; Metaphorical: eternal bliss.\n- Root: رخصة (rukhaṣah)\n  * Lisan / Ayn: Core meaning: concession, dispensation.\n  * Al-Raghib (Mufradat): Theological nuance: al-rukhaṣah as legal concession.\n  * Al-Zamakhshari (Asas): Literal: concession; Metaphorical: legal dispensation.\n- Root: رياسة (riyāsah)\n  * Lisan / Ayn: Core meaning: leadership, headship.\n  * Al-Raghib (Mufradat): Theological nuance: love of leadership among the destructive traits.\n  * Al-Zamakhshari (Asas): Literal: leadership; Metaphorical: seeking authority.\n- Root: اندراس (indirās)\n  * Lisan / Ayn: Core meaning: effacement, obliteration.\n  * Al-Raghib (Mufradat): Theological nuance: indirās al-ʿulūm as the obliteration of the sciences.\n  * Al-Zamakhshari (Asas): Literal: effacement; Metaphorical: extinction of knowledge.\n- Root: صبيان (ṣibyān)\n  * Lisan / Ayn: Core meaning: boys, children.\n  * Al-Raghib (Mufradat): Theological nuance: children's motivation for learning through play.\n  * Al-Zamakhshari (Asas): Literal: boys; Metaphorical: pupils.\n- Root: مكتب (maktab)\n  * Lisan / Ayn- Root: مكتب (maktab)\n  * Lisan / Ayn: Core meaning: place of instruction, school for boys.\n  * Al-Raghib (Mufradat): Theological nuance: the elementary school where children are taught.\n  * Al-Zamakhshari (Asas): Literal: school; Metaphorical: place of elementary learning.\n- Root: خلاق (khilāq)\n  * Lisan / Ayn: Core meaning: portion, share, lot.\n  * Al-Raghib (Mufradat): Theological nuance: \"no portion\" (lā khilāq) in the Hereafter — utter deprivation of divine reward.\n  * Al-Zamakhshari (Asas): Literal: share; Metaphorical: spiritual allotment in the afterlife.\n- Root: فاجر (fājir)\n  * Lisan / Ayn: Core meaning: wicked, immoral, profligate.\n  * Al-Raghib (Mufradat): Theological nuance: the dissolute one who commits sins openly.\n  * Al-Zamakhshari (Asas): Literal: sinner; Metaphorical: one through whom God nonetheless supports religion.\n- Root: شمع (shamʿ)\n  * Lisan / Ayn: Core meaning: candle, wax taper.\n  * Al-Raghib (Mufradat): Theological nuance: the candle as parable — consuming itself while giving light to others.\n  * Al-Zamakhshari (Asas): Literal: candle; Metaphorical: one who destroys himself but benefits others.\n- Root: نار (nār)\n  * Lisan / Ayn: Core meaning: fire.\n  * Al-Raghib (Mufradat): Theological nuance: fire as parable — consuming itself and all around it.\n  * Al-Zamakhshari (Asas): Literal: fire; Metaphorical: one who destroys himself and others.\n- Root: سعد (saʿida)\n  * Lisan / Ayn: Core meaning: to be fortunate, to prosper.\n  * Al-Raghib (Mufradat): Theological nuance: saʿādah as felicity — success in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: good fortune; Metaphorical: eternal felicity.\n- Root: شقي (shaqiya)\n  * Lisan / Ayn: Core meaning: to be wretched, to be miserable.\n  * Al-Raghib (Mufradat): Theological nuance: shaqāwah as wretchedness — ruin in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: misery; Metaphorical: eternal ruin.\n- Root: أخلص (akhlaṣa)\n  * Lisan / Ayn: Core meaning: to purify, to be sincere.\n  * Al-Raghib (Mufradat): Theological nuance: ikhlāṣ as purifying intention for God alone — the condition of acceptance.\n  * Al-Zamakhshari (Asas): Literal: sincerity; Metaphorical: pure devotion.\n- Root: ريب (rāba)\n  * Lisan / Ayn: Core meaning: to doubt, to suspect.\n  * Al-Raghib (Mufradat): Theological nuance: al-rayb as doubt and uncertainty — to be dispelled by evidence.\n  * Al-Zamakhshari (Asas): Literal: doubt; Metaphorical: skepticism.", "book_title": "Book of Knowledge", "section_title_ar": "Section 39", "section_title_en": "Section 39", "section_index": 39, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Book of Knowledge'", "badge": "Ethics"}], "16": [{"arabic": "وجل كما قال تعالى لعلكم تذكرون ففروا إلى الله وتحقق فيهم قوله تعالى وإذ اعتزلتموهم وما يعبدون إلا الله فأووا إلى الكهف ينشر لكم ربكم من رحمته وإليه الإشارة بقوله إني ذاهب إلى ربي سيهدين وهذه منتهى درجات الصديقين ولا وصول إليها إلا بعد ترتيب الأوراد والمواظبة عليها دهرا طويلا فلا ينبغي أن يغتر المريد بما سمعه من ذلك فيدعيه لنفسه ويفتر عن وظائف عبادته فذلك علامته أن لا يهجس في قلبه وسواس ولا يخطر في قلبه معصية ولا ترعجه هواجم الأهوال ولا تستفزه عظائم الأشغال وأنى ترزق هذه الرتبة لكل أحد فيتعين على الكافة ترتيب الأوراد كما ذكرناه وجميع ما ذكرناه طرق إلى الله تعالى قال تعالى قل كل يعمل على شاك", "english": "The fifth [category]: the ruler (al-wālī) — such as the Imām, the judge (al-qāḍī), and the one who administers the affairs of the Muslims. His undertaking the needs of the Muslims and their interests in accordance with the Sacred Law (al-sharʿ) and with the intention of sincerity (ikhlāṣ) is superior to the aforementioned litanies (al-awrād). It is fitting for him to occupy himself with the rights of the people by day, to content himself with the obligatory prayers (al-maktūbah), and to perform the aforementioned litanies by night — just as ʿUmar, may Allah be pleased with him, used to do, for he said: \"What have I to do with sleep? If I sleep by day, I waste the Muslims; and if I sleep by night, I waste my own soul.\"", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 269", "section_title_en": "The Revival of the Religious Sciences — Section 269: On the Superiority of Transitive Acts of Worship and the Paths to God", "section_index": 269, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst by reaching the source.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — theologically extended to mean the soul's approach to God; the \"litany\" (wird) is the appointed spiritual \"watering\" that sustains the traveler.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ورد الماء\" (to arrive at water). Metaphorical (Majaz): \"ورد عليه أمر لم يطقه\" (an affair befell him) and \"طرقني الخيال\" (the phantom visited me) — thus the wird is the appointed visitation of the heart by divine remembrance.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the immaterial reality of the human; in the verse {«ويحذركم الله نفسه»} it denotes the very Essence (al-Dhāt), not a physical part.\n  * Al-Zamakhshari (Asas): Literal: \"نفس سائلة\" (flowing blood/life). Metaphorical: \"أصابته نفس\" (an evil eye afflicted him) — showing the soul's power to effect beyond its own bounds.\n- Root: طرق (t-r-q)\n  * Lisan / Ayn: To strike, to beat, to knock; a path beaten by feet.\n  * Al-Raghib (Mufradat): \"الطريق: السبيل الذي يطرق بالأرجل\" — then extended to every path (maslak) a man traverses in deed, whether praiseworthy or blameworthy.\n  * Al-Zamakhshari (Asas): Literal: \"طرق الباب\" (to knock at the door). Metaphorical: \"طرقني الخيال\" (the phantom came to me by night) — hence the \"ways to God\" (turūq) are the paths beaten by the feet of the seekers, each leading to the Door.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish the exclusive rank of the muwaḥḥid whose sole concern is God, and to restrict the claim of such a station to those who have first traversed the ordered litanies.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'", "badge": "Insight"}, {"arabic": "اعتزلتموهم وما يعبدون إلا الله فأووا إلى الكهف ينشر لكم ربكم من رحمته وإليه الإشارة بقوله إني ذاهب إلى ربي سيهدين وهذه منتهى درجات الصديقين ولا وصول إليها إلا بعد ترتيب الأوراد والمواظبة عليها دهرا طويلا فلا ينبغي أن يغتر المريد بما سمعه من ذلك فيدعيه لنفسه ويفتر عن وظائف عبادته فذلك علامته أن لا يهجس في قلبه وسواس ولا يخطر في قلبه معصية ولا ترعجه هواجم الأهوال ولا تستفزه عظائم الأشغال وأنى ترزق هذه الرتبة لكل أحد فيتعين على الكافة ترتيب الأوراد كما ذكرناه وجميع ما ذكرناه طرق إلى الله تعالى قال تعالى قل كل يعمل على شاك", "english": "The fifth [category]: the ruler (al-wālī) — such as the Imām, the judge (al-qāḍī), and the one who administers the affairs of the Muslims. His undertaking the needs of the Muslims and their interests in accordance with the Sacred Law (al-sharʿ) and with the intention of sincerity (ikhlāṣ) is superior to the aforementioned litanies (al-awrād). It is fitting for him to occupy himself with the rights of the people by day, to content himself with the obligatory prayers (al-maktūbah), and to perform the aforementioned litanies by night — just as ʿUmar, may Allah be pleased with him, used to do, for he said: \"What have I to do with sleep? If I sleep by day, I waste the Muslims; and if I sleep by night, I waste my own soul.\"", "book_title": "Etiquette of Seclusion", "section_title_ar": "Section 269", "section_title_en": "The Revival of the Religious Sciences — Section 269: On the Superiority of Transitive Acts of Worship and the Paths to God", "section_index": 269, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst by reaching the source.\n  * Al-Raghib (Mufradat): \"الورود أصله: قصد الماء\" — theologically extended to mean the soul's approach to God; the \"litany\" (wird) is the appointed spiritual \"watering\" that sustains the traveler.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ورد الماء\" (to arrive at water). Metaphorical (Majaz): \"ورد عليه أمر لم يطقه\" (an affair befell him) and \"طرقني الخيال\" (the phantom visited me) — thus the wird is the appointed visitation of the heart by divine remembrance.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the immaterial reality of the human; in the verse {«ويحذركم الله نفسه»} it denotes the very Essence (al-Dhāt), not a physical part.\n  * Al-Zamakhshari (Asas): Literal: \"نفس سائلة\" (flowing blood/life). Metaphorical: \"أصابته نفس\" (an evil eye afflicted him) — showing the soul's power to effect beyond its own bounds.\n- Root: طرق (t-r-q)\n  * Lisan / Ayn: To strike, to beat, to knock; a path beaten by feet.\n  * Al-Raghib (Mufradat): \"الطريق: السبيل الذي يطرق بالأرجل\" — then extended to every path (maslak) a man traverses in deed, whether praiseworthy or blameworthy.\n  * Al-Zamakhshari (Asas): Literal: \"طرق الباب\" (to knock at the door). Metaphorical: \"طرقني الخيال\" (the phantom came to me by night) — hence the \"ways to God\" (turūq) are the paths beaten by the feet of the seekers, each leading to the Door.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish the exclusive rank of the muwaḥḥid whose sole concern is God, and to restrict the claim of such a station to those who have first traversed the ordered litanies.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Seclusion'", "badge": "Insight"}], "19": [{"arabic": "شيء يسير فقال له عمر حسبك بصحبته يوما أو بعض يوم شؤما وشرا وقال الفضيل ما ازداد رجل من ذي سلطان قربا إلا ازداد من الله بعدا وكان سعيد بن المسيب يتجر في الزيت ويقول إن في هذا لغنى عن هؤلاء السلاطين وقال وهيب هؤلاء الذين يدخلون على الملوك لهم أضر على الأمة من المقامرين وقال محمد بن سلمة الذباب على العذرة أحسن من قارئ على باب هؤلاء ولما خالط الزهري السلطان كتب أخ له في الدين إليه عافانا الله وإياك أبا بكر من الفتن فقد أصبحت بحال ينبغي لمن عرفك أن يدعوا لك الله ويرحمك أصبحت شيخا كبيرا قد أثقلتك", "english": "As for the reports: When the Messenger of God, may God bless him and grant him peace, described the tyrannical rulers, he said: \"Whoever opposes them is saved, whoever withdraws from them is safe — or nearly safe — and whoever falls in with them in their worldly affairs is of them.\" (1)", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 389", "section_title_en": "The Sixth Chapter: On What is Lawful and Unlawful in Associating with Tyrannical Rulers, and the Ruling on Frequent Their Assemblies, Entering Upon Them, and Showing Them Honor", "section_index": 389, "anchors": "- Root: ظلم (Ẓ-L-M)\n  * Lisan / Ayn: Core meaning is placing something in other than its proper place; darkness as the absence of light.\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور\" — darkness is the absence of light; used metaphorically for ignorance, polytheism, and transgression, as opposed to light (نور) which represents knowledge and justice.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"الظلم ظلمة كما أن العدل نور\" — injustice is darkness just as justice is light. Metaphorical (Majaz): \"أرض مظلومة\" — land never dug or watered, indicating the deprivation of benefit.\n- Root: وهي (W-H-Y)\n  * Lisan / Ayn: Weakness, fissure, or slackening in a structure; a crack in leather or a wall.\n  * Al-Raghib (Mufradat): \"الوهي: شق في الأديم والثوب\" — a rent in hide or cloth; \"وكل شيء استرخى رباطه فقد وهي\" — anything whose binding slackens has become weak.\n  * Al-Zamakhshari (Asas): Literal: \"وهى الحائط\" — the wall cracked. Metaphorical: \"واهي العزالي\" — clouds pouring forth rain, i.e., their water-skins have burst open.\n- Root: خبر (KHB-R)\n  * Lisan / Ayn: Knowledge of a thing from report or direct experience; testing and ascertaining.\n  * Al-Raghib (Mufradat): \"الخبر: العلم بالأشياء المعلومة من جهة الخبر\" — knowledge of things from the channel of report; \"الخبرة المعرفة ببواطن الأمر\" — experiential knowledge of the inner realities of affairs.\n  * Al-Zamakhshari (Asas): Literal: \"خبرت الرجل واختبرته خبرا وخبرة\" — I tested the man and gained knowledge of him. Metaphorical: \"تخبر عن مجهوله مرآته\" — one's mirror reveals his unknown state.\n- Root: وفي (W-F-Y)\n  * Lisan / Ayn: Completeness, fulfillment, and reaching full measure.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — that which has attained completion; \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — fulfilled the covenant and did not breach its preservation.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" — a full-weight dirham. Metaphorical: \"أوفى على المائة\" — he surpassed a hundred; \"توفاه الله\" — God took him in full, i.e., completed his term.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the exclusive restriction of predication, as in \"فليس مني ولست منه\" (he is not of me, nor am I of him), where the negation establishes complete disassociation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'The Lawful and Prohibited'", "badge": "Insight"}], "23": [{"arabic": "ولا تقولن لشيء إني فاعل ذلك غدا إلا أن يشاء الله ثم لم يقتصر على ذلك فيما لا يشك فيه بل قال تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رءؤسكم ومقصرين وكان الله سبحانه عالما بأنهم يدخلون لا محالة وأنه شاءه ولكن المقصود تعليمه ذلك فتأدب رسول الله صلى الله عليه وسلم في ما كان يخبر عنه معلوما كان أو مشكوكا حتى قال صلى الله عليه وسلم لما دخل المقابر السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون (1) واللحوق بهم غير مشكوك فيه ولكن مقتضى الأدب ذكر الله تعالى وربط الأمور به وهذه الصيغ", "english": "If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"", "book_title": "Foundations of Belief", "section_title_ar": "Section 102", "section_title_en": "On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102", "section_index": 102, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "24": [{"arabic": "ولا تقولن لشيء إني فاعل ذلك غدا إلا أن يشاء الله ثم لم يقتصر على ذلك فيما لا يشك فيه بل قال تعالى لتدخلن المسجد الحرام إن شاء الله آمنين محلقين رءؤسكم ومقصرين وكان الله سبحانه عالما بأنهم يدخلون لا محالة وأنه شاءه ولكن المقصود تعليمه ذلك فتأدب رسول الله صلى الله عليه وسلم في ما كان يخبر عنه معلوما كان أو مشكوكا حتى قال صلى الله عليه وسلم لما دخل المقابر السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون (1) واللحوق بهم غير مشكوك فيه ولكن مقتضى الأدب ذكر الله تعالى وربط الأمور به وهذه الصيغ", "english": "If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 102", "section_title_en": "On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102", "section_index": 102, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "28": [{"arabic": "{فسبحان الله حين تمسون وحين تصبحون} وقال تعالى {ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه} فهذا كله يبين لك أن الطريق إلى تعالى مراقبة الأوقات وعمارتها بالأوراد على سبيل الدوام ولذلك قال صلى الله عليه وسلم أحب عباد الله إلى الله الذين يراعون الشمس والقمر والأظلة لذكر الله تعالى (1) وقد قال تعالى {الشمس والقمر بحسبان} وقال تعالى {ألم تر إلى ربك كيف مد الظل ولو شاء لجعله ساكنا ثم جعلنا الشمس عليه دليلا ثم قبضناه إلينا قبضا يسيرا} وقال تعالى {والقمر قدرناه منازل} وقال تعالى {وهو الذي جعل لكم النجوم لتهتدوا بها في ظلمات البر والبحر}", "english": "{«آناء الليل ساجدا وقائما يحذر الآخرة ويرجو رحمة ربه قل هل يستوي الذين يعلمون والذين لا يعلمون»} — \"During the hours of the night, prostrating and standing, fearing the Hereafter and hoping for the mercy of his Lord. Say: Are those who know equal to those who do not know?\" (Q. 39:9). And God Most High said: {«تتجافى جنوبهم عن المضاجع يدعون ربهم خوفا وطمعا»} — \"Their sides forsake their beds, calling upon their Lord in fear and hope\" (Q. 32:16). And God, Mighty and Majestic, said: {«والذين يبيتون لربهم سجدا وقياما»} — \"And those who pass the night prostrating and standing before their Lord\" (Q. 25:64). And God, Mighty and Majestic, said: {«كانوا قليلا من الليل ما يهجعون وبالأسحار هم يستغفرون»} — \"They used to sleep but little of the night, and in the dawn-hours they would seek forgiveness\" (Q. 51:17-18). And God, Mighty and Majestic, said: {«فسبحان الله حين تمسون وحين تصبحون»} — \"So glory be to God when you enter the evening and when you enter the morning\" (Q. 30:17). And God Most High said: {«ولا تطرد الذين يدعون ربهم بالغداة والعشي يريدون وجهه»} — \"And do not drive away those who call upon their Lord morning and evening, desiring His Face\" (Q. 6:52). All of this makes clear to you that the path to God Most High is the watchfulness over the times (murāqabat al-awqāt) and the cultivation of them with the appointed devotions (al-awrād) in a perpetual manner.", "book_title": "Intention, Sincerity and Truthfulness", "section_title_ar": "Section 258", "section_title_en": "The Revival of the Religious Sciences — Section 258: The Virtues of the Watches (Awrād) and Their Ordering", "section_index": 258, "anchors": "- Root: ورد (w-r-d)\n  * Lisan / Ayn: Core meaning is \"to arrive at water\" — the quenching of thirst at a watering place; al-Wird (pl. Awrād) denotes a set portion or appointed round of devotional recitation, by extension from the regular \"arrival\" at a source.\n  * Al-Raghib (Mufradat): Al-Wurūd is originally \"the intending of water,\" then used for other things. The theological nuance: the awrād are the appointed \"watering places\" of the soul — fixed times at which the servant presents himself before God to drink from the fountain of remembrance (dhikr).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"warda al-mā'a\" — to arrive at water. Metaphorical (Majāz): \"warada ʿalayhi amrun lam yuṭiqhu\" — an affair he could not bear arrived upon him; \"waradat-hu al-ḥummā\" — fever came upon him. Here, the awrād are the appointed times that \"come upon\" the servant, demanding their due of devotion.\n- Root: طلع (ṭ-l-ʿ)\n  * Lisan / Ayn: To rise, to appear above the horizon (of the sun); to ascend; to come upon suddenly.\n  * Al-Raghib (Mufradat): \"Ṭalaʿa al-shams ṭulūʿan wa-maṭlaʿan\" — the sun rose. From this is borrowed: \"ṭalaʿa ʿalaynā fulān\" — so-and-so came upon us. The maṭlaʿ is the place of rising.\n  * Al-Zamakhshari (Asas): Literal: \"ṭalaʿat al-shams\" — the sun rose. Metaphorical: \"ṭalaʿa ʿalaynā fulān\" — he descended upon us suddenly. The \"rising of the sun\" is the boundary-marker of the first watch.\n- Root: ليل (l-y-l)\n  * Lisan / Ayn: The night — from the time of sunset to sunrise; its root suggests \"enveloping\" and \"concealing.\"\n  * Al-Raghib (Mufradat): The night (al-layl) and the day (al-nahār) are two signs (āyatān) of God; the night is for stillness and the day for seeking provision.\n  * Al-Zamakhshari (Asas): Literal: the period of darkness. Metaphorical: \"layl al-hamm\" — the night of anxiety (a dark affair). The night is divided into watches for the one who stands in prayer.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating all else. Applied here: \"the purpose of the sun and moon's course is not for worldly matters, but only (innamā) for knowing the measures of the times.\"", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Intention, Sincerity and Truthfulness'", "badge": "Dhikr"}, {"arabic": "الله عز وجل {ولا تطع من أغفلنا قلبه عن ذكرنا واتبع هواه وكان أمره فرطا} والعوام العصاة أسعد حالا من الجهال بطريق الدين المعتقدين أنهم من العلماء لأن العامي العاصي معترف بتقصيره فيستغفر ويتوب وهذا الجاهل الظان أنه عالم وأن ما هو مشتغل به من العلوم التي هي وسائله إلى الدنيا عن سلوك طريق الدين فلا يتوب ولا يستغفر بل لا يزال مستمرا عليه إلى الموت وإذ غلب هذا على أكثر الناس إلا من عصمه الله تعالى وانقطع الطمع من إصلاحهم فالأسلم لذي الدين المحتاط العزلة والانفراد عنهم كما سيأتي في", "english": "For this reason ʿAlī, may God be pleased with him, said — when it was said to him, \"You have opposed so-and-so\" — \"The best of us is the most following of us of this religion.\" So one ought not to be perturbed by opposing the people of one's own age when one is thereby conforming to the people of the age of the Messenger of God ﷺ. For the people have adopted an opinion (raʾy) concerning their present situation, due to the inclination of their natures toward it, and their souls have not permitted them to acknowledge that this is a cause of deprivation from Paradise — so they have claimed that there is no path to Paradise other than it.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 64", "section_title_en": "** Section 64 — On the Sciences of the Inner Life: The Obligation to Follow the Salaf and the Condemnation of Innovation (Bidʿah)", "section_index": 64, "anchors": "**\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning — perception of a thing by its true nature; knowledge as the apprehension of reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon the thing.\n  * Al-Zamakhshari (Asas): Literal usage — \"ما علمت بخبرك: ما شعرت به\" (I did not know of your news: I had no awareness of it). The scholar (ʿālim) is one whose knowledge is manifest in action.\n- Root: بدع (badaʿa)\n  * Lisan / Ayn: Core meaning — to originate, to create something new without prior example.\n  * Al-Raghib (Mufradat): \"الإبداع: إنشاء صنعة بلا احتذاء واقتداء\" — origination of a thing without model or precedent. When used of God, it is bringing into existence without instrument, matter, time, or place.\n  * Al-Zamakhshari (Asas): Literal — \"أبدع الشيء وابتدعه: اخترعه\" (he originated it and innovated it: he invented it). Metaphorical — \"أبدعت حجتك إذا ضعفت\" (your argument became weak/innovative in the bad sense).\n- Root: حدث (ḥadatha)\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — coming-to-be of a thing after it was not. \"المحدث: ما أوجد بعد أن لم يكن\" — the originated thing.\n  * Al-Zamakhshari (Asas): Literal — \"هو حدث من الأحداث\" (he is a youth among youths). Metaphorical — \"صاروا أحاديث\" (they became [mere] tales). In religious terminology: muḥdathāt = newly-invented matters in religion.\n- Root: هدى (hadā)\n  * Al-Raghib (Mufradat): Guidance — directing to the path with gentleness; al-hudā is the guidance of the Prophet ﷺ in matters of religion.\n  * Al-Zamakhshari (Asas): \"حسن الهدى\" — excellent guidance, the prophetic way (sunnah) as opposed to innovation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما هما اثنتان: الكلام والهدى\" restricts the two matters exclusively to speech and guidance, excluding all else.\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "عليك من حسابهم} وقال تعالى {واصبر نفسك مع الذين يدعون ربهم بالغداة والعشي يريدون وجهه ولا تعد عيناك عنهم تريد زينة الحياة الدنيا} // حديث قالت قريش لرسول الله صلى الله عليه وسلم كيف نجلس إليك وعندك هؤلاء الحديث في نزول قوله تعالى {ولا تطرد الذين يدعون ربهم} أخرجه مسلم من حديث سعد بن أبي وقاص إلا أنه قال فقال المشركون وقال ابن ماجه قالت قريش ثم أخبر الله تعالى عن تعجبهم حين دخلوا جهنم إذا لم يروا الذين ازدروهم فقالوا {ما لنا لا نرى رجالا كنا نعدهم من الأشرار} قيل يعنون عمارا وبلالا وصهيبا والمقداد رضي الله عنهم ثم كان منهم من منعه الكبر عن الفكر والمع", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Poverty and Abstinence'", "badge": "Ethics"}, {"arabic": "والعشي يريدون وجهه ولا تعد عيناك عنهم تريد زينة الحياة الدنيا} // حديث قالت قريش لرسول الله صلى الله عليه وسلم كيف نجلس إليك وعندك هؤلاء الحديث في نزول قوله تعالى {ولا تطرد الذين يدعون ربهم} أخرجه مسلم من حديث سعد بن أبي وقاص إلا أنه قال فقال المشركون وقال ابن ماجه قالت قريش ثم أخبر الله تعالى عن تعجبهم حين دخلوا جهنم إذا لم يروا الذين ازدروهم فقالوا {ما لنا لا نرى رجالا كنا نعدهم من الأشرار} قيل يعنون عمارا وبلالا وصهيبا والمقداد رضي الله عنهم ثم كان منهم من منعه الكبر عن الفكر والمعرفة فجهل كونه صلى الله ع", "english": "Know that the one against whom pride is directed is either God—mighty and majestic—or His messengers, or the rest of His creation. Man has been created unjust and ignorant {«وخلق الإنسان ظلوما جهولا»}, so at times he grows proud against the creation, and at times he grows proud against the Creator. Thus, pride, considered with respect to the one against whom it is directed, falls into three divisions.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 855", "section_title_en": "Exposition of the One Against Whom Pride Is Directed, Its Degrees, Its Divisions, and the Fruits of Pride Within It", "section_index": 855, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core root denotes magnitude, whether physical size, age, or rank; \"الكبرة\" specifically marks the state of advanced age or an ingrained, chronic condition.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — bigness and smallness are relative terms. In the theological context, pride (الكبر) is the soul's self-magnification against another, a relational vice that distorts the creature's standing before the Creator.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage concerns physical or quantitative magnitude. Metaphorical (Majaz) usage transfers this to moral and spiritual stature, as in \"كبر علي ذلك\" (it weighed heavily upon him) — here, the soul's swelling against divine command is a metaphorical arrogation of greatness.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic tension between the agent of pride (المتكبر) and its object (المتكبر عليه), where the preposition \"على\" carries the full weight of opposition and elevation, structuring the periodic sentences that follow.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Poverty and Abstinence'", "badge": "Ethics"}], "29": [{"arabic": "كل مكان وما هو يميت وإن يستغيثوا يغاثوا بماء كالمهل يشوي الوجوه بئس الشراب وساءت مرتفقا ثم انظر إلى طعامهم وهو الزقوم كما قال الله تعالى {ثم إنكم أيها الضالون المكذبون لآكلون من شجر من زقوم فمالئون منها البطون فشاربون عليه من الحميم فشاربون شرب الهيم} وقال تعالى {إنها شجرة تخرج في أصل الجحيم طلعها كأنه رؤوس الشياطين فإنهم لآكلون منها فمالئون منها البطون ثم إن لهم عليها لشوبا من حميم ثم إن مرجعهم لإلى الجحيم} وقال تعالى {تصلى نارا حامية تسقى من عين آنية} وقال تعالى {إن لدينا أنكالا وجحيما وطعاما ذا غصة وعذابا أليما} وقال ابن عباس قال رس", "english": "And ʿAlī, may God honor his face, said: The Messenger of God, may God bless him and grant him peace, said: \"Seek refuge in God from the Pit of Sorrow, or the Valley of Sorrow.\" It was said: \"O Messenger of God, what is the Valley or Pit of Sorrow?\" He said: \"A valley in Hell from which Hell itself seeks refuge with God seventy times each day. God, the Exalted, has prepared it for the reciters who show off.\" (2)", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1349", "section_title_en": "The Vastness of Hellfire, Its Depths, and the Torments of Its Inhabitants", "section_index": 1349, "anchors": "- Root: و د ي (w-d-y)\n  * Lisan / Ayn: A valley; a place where torrents flow. In the lexicon, it denotes a lowland or watercourse between mountains.\n  * Al-Raghib (Mufradat): Used for the valleys of Hell as places of confinement and passage, each containing further branching ravines (شُعَب), indicating graded descent.\n  * Al-Zamakhshari (Asas): Literal for earthly valleys; here transferred (majāz) to the topographical reality of Hell, affirming its corporeal vastness.\n- Root: ع م ق (ʿ-m-q)\n  * Lisan / Ayn: Depth; the far bottom of a well or pit. Al-Farahidi: \"العمق: قعر البئر ونحوها.\"\n  * Al-Raghib (Mufradat): Depth as a measure of descent; in the Hereafter, it is unbounded, paralleling the unbounded depth of worldly desire.\n  * Al-Zamakhshari (Asas): Literal for physical depth; here extended to show the infinite regress of punishment corresponding to infinite craving.\n- Root: غ س ق (gh-s-q)\n  * Lisan / Ayn: Stinking, foul pus or ichor that flows from the skin of the damned; also intense darkness.\n  * Al-Raghib (Mufradat): Al-Ghassāq is the putrid effusion of Hell, a punishment for the senses, specifically for drinking when the damned cry out in thirst.\n  * Al-Zamakhshari (Asas): Literal for what is loathsome and fetid; in the Quranic context, it is the designated drink of the inhabitants.\n- Root: ز ق م (z-q-m)\n  * Lisan / Ayn: To swallow with difficulty; the tree of Zaqqūm, which grows in the depths of Hell.\n  * Al-Raghib (Mufradat): A specific tree in Hell whose fruit is like the heads of devils, eaten by the damned to fill their bellies, causing choking and agony.\n  * Al-Zamakhshari (Asas): Literal for a real tree; its description is sensory, not metaphorical, affirming the physical reality of punishment.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic structure of \"في جهنم سبعين ألف واد\" allows the prepositional phrase to precede the subject for emphasis, establishing the spatial setting before detailing its contents.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}, {"arabic": "تطع من أغفلنا قلبه عن ذكرنا يعني الأغنياء إلى قوله تعالى وقل الحق من ربكم فمن شاء فليؤمن ومن شاء فليكفر (3) الآية واستأذن ابن أم مكتوم على النبي صلى الله عليه وسلم وعنده رجل من أشراف قريش فشق ذلك على النبي صلى الله عليه وسلم فأنزل الله تعالى عبس وتولى أن جاءه الأعمى وما يدريك لعله يزكى أو يذكر فتنفعه الذكرى يعني ابن مكتوم أما من استغنى فأنت له تصدى (4) يعني هذا الشريف وعن النبي صلى الله عليه وسلم أنه قال يؤتى بالعبد يوم القيامة فيعتذر الله تعالى إليه كما يعتذر الرجل للرجل في الدنيا فيقول وعزتي وجلالي ما زويت الدنيا عنك لهوانك علي ولكن لما أعدد", "english": "The Messiah, peace be upon him, said: \"With difficulty shall the rich man enter Paradise.\"", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1071", "section_title_en": "The Virtue of Poverty and the Condemnation of Wealth — Section 1071", "section_index": 1071, "anchors": "- Root: دخل (dakhala)\n  * Lisan / Ayn: Core meaning of entering, penetrating, or intruding into a space or state.\n  * Al-Raghib (Mufradat): Often used for entering into a condition or abode, including the afterlife states of Paradise and Hell.\n  * Al-Zamakhshari (Asas): Literal for physical entry; metaphorical for entering into a spiritual state or reckoning.\n- Root: فقر (faqara)\n  * Lisan / Ayn: To hollow out, pierce, or be in a state of neediness; the poor one is \"hollowed\" of worldly goods.\n  * Al-Raghib (Mufradat): Denotes the state of one lacking sufficient means; in the Kalam context, it signifies a spiritual station of utter dependence upon God, not merely material lack.\n  * Al-Zamakhshari (Asas): Literal for material destitution; metaphorical for the soul's essential neediness before its Lord.\n- Root: غني (ghaniya)\n  * Lisan / Ayn: To be rich, self-sufficient, or free from need.\n  * Al-Raghib (Mufradat): In theological terms, absolute Ghina (Self-Sufficiency) belongs to God alone; human wealth is a relative accident (ʿaraḍ) that often breeds heedlessness.\n  * Al-Zamakhshari (Asas): Literal for possessing abundance; metaphorical for the false sense of independence that veils one from God.\n- Sibawayh Rule: Rule of Prepositional Interposition (باب الفصل بين الجار والمجرور) — Governing the syntactic flow of conditional and circumstantial clauses, ensuring the periodic structure of the narrative remains unbroken across multiple embedded quotations.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Poverty and Abstinence'", "badge": "Afterlife"}], "30": [{"arabic": "فالإيمان رأس الحسنات ولقوله تعالى {والله يحب المحسنين} وقال تعالى {إنا لا نضيع أجر من أحسن عملا} ولا حجة لهم في ذلك فإنه حيث ذكر الإيمان في هذه الآيات أريد به الإيمان مع العمل إذ بينا أن الإيمان قد يطلق ويراد به الإسلام وهو الموافقة بالقلب والقول والعمل ودليل هذا التأويل أخبار كثيرة في معاقبة العاصين ومقادير العقاب وقوله صلى الله عليه وسلم يخرج من النار من كان في قلبه مثقال ذرة من إيمان فكيف يخرج إذا لم يدخل ومن القرآن قوله تعالى {إن الله لا يغفر أن يشرك به ويغفر ما دون ذلك لمن يشاء} والاستثناء بالمشيئة يدل على الانقسام وقوله تعالى {ومن يعص ال", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "31": [{"arabic": "قال الله يحلون فيها من أساور من ذهب ولؤلؤا ولباسهم فيها حرير والآيات في ذلك كثيرة وإنما تفصيله في الأخبار فقد روى أبو هريرة أن النبي صلى الله عليه وسلم قال من يدخل الجنة ينعم لا يبأس لا تبلى ثيابه ولا يفنى شبابه في الجنة ما لا عين رأت ولا أذن سمعت ولا خطر عن قلب بشر (1) وقال رجل يا رسول الله أخبرنا عن ثياب أهل الجنة أخلق تخلق أم نسج تنسج فسكت رسول الله صلى الله عليه وسلم وضحك بعض القوم فقال رسول الله صلى الله عليه وسلم مم تضحكون من جاهل سأل عالما ثم قال رسول ا", "english": "Ponder the form of Paradise, and reflect upon the bliss of its inhabitants, and upon the remorse of him who is deprived of it for his contentment with this world as a substitute for it. For Abu Hurayrah said: The Messenger of God, may God bless him and grant him peace, said: \"Verily, the wall of Paradise is a brick of silver and a brick of gold; its soil is saffron, and its clay is musk.\" (1) And he was asked, may God bless him and grant him peace, about the earth of Paradise, and he said: \"A white flour-like pure musk.\" (2) And Abu Hurayrah said: The Messenger of God, may God bless him and grant him peace, said: \"Whosoever would delight that God, Mighty and Majestic, should give him wine to drink in the Hereafter, let him abandon it in this world; and whosoever would delight that God should clothe him in silk in the Hereafter, let him abandon it in this world.\" (3) And he said: \"The rivers of Paradise gush forth from beneath hills, or beneath mountains, of musk.\" (4) And were the least of the people of Paradise in adornment to be weighed against the adornment of all the people of this world together, that with which God, Mighty and Majestic, adorns him in the Hereafter would still be better than all the adornment of this world. (5) And Abu Hurayrah said: The Messenger of God, may God bless him and grant him peace, said: \"Verily, in Paradise there is a tree beneath whose shade a rider travels for a hundred years without crossing it. Recite, if you wish: {And a shade extended} (6) {«وَظِلٍّ مَمْدُودٍ»}.\" And Abu Umāmah said: The companions of the Messenger of God, may God bless him and grant him peace, used to say: \"God, Mighty and Majestic, benefits us through the Bedouins and their questions.\" A Bedouin came forward and said: \"O Messenger of God, God has mentioned in the Qur'an a harmful tree, and I did not know that in Paradise there is a tree that harms its companion.\" The Messenger of God, may God bless him and grant him peace, said: \"{What is it?} {«مَا هِيَ»}\" He said: \"The lote-tree (al-sidr), for it has thorns.\" He said: \"God, Exalted is He, has said: {In a lote-tree that is thornless} {«فِي سِدْرٍ مَخْضُودٍ»} — God clips its thorns and places in the stead of every thorn a fruit; then the fruit splits open from it into seventy-two colors of food, no one color of which resembles another.\" (7) And Jarīr ibn ʿAbd Allāh said: We alighted at al-Ṣifāḥ, and there was a man sleeping beneath a tree, the sun having nearly reached him. I said to the youth: \"Go with this leather sheet and shade him.\" So he went and shaded him. When he awoke, behold, it was Salmān. I came to him and greeted him, and he said: \"O Jarīr, humble yourself before God, for whosoever humbles himself before God in this world, God raises him on the Day of Resurrection. Do you know what the darknesses are on the Day of Resurrection?\" I said: \"I do not know.\" He said: \"The wronging of people, one another.\" Then he took a small twig that I could scarcely see due to its smallness, and said: \"O Jarīr, were you to seek the like of this in Paradise, you would not find it.\" I said: \"O Abu ʿAbd Allāh, where then are the date-palms and the trees?\" He said: \"Their roots are of pearl and gold, and their tops are the fruit.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1354", "section_title_en": "The Description of the Wall of Paradise, Its Lands, Trees, and Rivers; and the Description of the Garments, Furnishings, Couches, Canopies, and Tents of Its Inhabitants", "section_index": 1354, "anchors": "- Root: حوط (ḥ-w-ṭ)\n  * Lisan / Ayn: The enclosing wall or boundary that surrounds and protects a garden; its core sense is preservation and encompassment.\n  * Al-Raghib (Mufradat): In the eschatological context, the wall (ḥā'iṭ) is a corporeal boundary delineating the Garden, yet its materials (silver and gold bricks) signify a reality transcending earthly substance (jawhar), pointing to the immaterial bounty (faḍl) of the divine grant.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for the physical wall; metaphorical (majāz) extension when the \"wall\" denotes the barrier of honor separating the blessed from deprivation.\n- Root: خلد (kh-l-d)\n  * Lisan / Ayn: Perpetuity and endless duration; the state of abiding without termination.\n  * Al-Raghib (Mufradat): Eternal subsistence (khulūd) is an attribute of the abode of recompense, contrasting with the temporal accidents (aʿrāḍ) of worldly existence; it is a fixed, necessary concomitant of the divine promise.\n  * Al-Zamakhshari (Asas): Literal for unceasing time; metaphorical for the soul's permanent state of felicity, free from the vicissitudes of generation and corruption.\n- Root: ثمر (th-m-r)\n  * Lisan / Ayn: The fruit borne by trees; the yield of a plant at its culmination.\n  * Al-Raghib (Mufradat): In the Garden, fruit (thamarah) is a designated reality (musammā) whose essence is transformed by divine power—each thorn replaced by fruit—demonstrating the absolute capacity of the Creator over nature.\n  * Al-Zamakhshari (Asas): Literal for edible produce; metaphorical for the \"fruit\" of deeds, whether reward or punishment, as an accrued outcome.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — Governing how predicates like \"its soil is saffron\" and \"its clay is musk\" are syntactically focused to affirm the exclusive, unprecedented nature of Paradise's attributes, distinguishing them from earthly analogues.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "34": [{"arabic": "وإليه الإشارة بقوله تعالى {فقال لصاحبه وهو يحاوره أنا أكثر منك مالا وأعز نفرا} حتى أجابه فقال إن ترن أنا أقل منك مالا وولدا فعسى ربي أن يؤتيني خيرا من جنتك ويرسل عليها حسبانا من السماء فتصبح صعيدا زلقا أو يصبح ماؤها غورا فلن تستطيع له طلبا وكان ذلك منه تكبرا بالمال والولد ثم بين الله عاقبة أمره بقوله {يا ليتني لم أشرك بربي أحدا} ومن ذلك تكبر قارون إذ قال تعالى إخبارا عن تكبره {فخرج على قومه في زينته قال الذين يريدون الحياة الدنيا يا ليت لنا مثل ما أوتي قارون إنه لذو حظ عظيم} السادس الكبر بالقوة وشدة البطش والتكبر ب", "english": "All of this is the very character of pride (أخلاق الكبر) and its effects, which self-exaltation through knowledge and action (التعزز بالعلم والعمل) produces. And where is the one who is free of all of that, or even of some of it? Would that I knew! Who is it that has recognized these traits within himself, and has heard the saying of the Messenger of God, peace and blessings be upon him: \"None shall enter Paradise who has in his heart the weight of a grain of mustard-seed of pride\" {«لا يدخل الجنة من في قلبه مثقال حبة من خردل من كبر»} — a hadith already cited earlier — how then can he magnify himself and behave arrogantly toward others, while the Messenger of God, peace and blessings be upon him, declares him to be among the people of the Fire? Rather, the truly great (العظيم) is only the one who is free of this; and whoever is free of it has in him no self-magnification and no arrogance. And the learned man (العالم) is the one who understands that God, Exalted is He, has said to him: \"You have with Us a standing, so long as you do not see for yourself any standing; for if you see for yourself a standing, then you have no standing with Us.\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 860", "section_title_en": "The Fruits of Pride in Knowledge and Lineage — Section 860 of the Revival of the Religious Sciences", "section_index": 860, "anchors": "- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core root denotes magnitude, size, and seniority — whether in age, rank, or physical dimension; \"الكبرة\" is the burden of advanced age.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — great and small are relative terms, assessed by comparison; pride (الكبر) is the soul's self-magnification vis-à-vis another, a theological vice when it entails disdain for God's creatures.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"كبر الأمر\" — the matter became grave. Metaphorical (Majaz): \"كبر عليه\" — it weighed heavily upon him; here, the physical sense of \"bigness\" is transferred to the moral-spiritual state of self-inflation (التعاظم) against others.\n- Root: حدث (H-D-TH)\n  * Lisan / Ayn: Denotes newness, origination after non-existence; \"الحديث\" is speech that is newly articulated or conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination of a thing after it was not; the \"حديث\" (Prophetic report) is so named as newly transmitted discourse bearing authority.\n  * Al-Zamakhshari (Asas): Literal: \"حدث من الأحداث\" — a youth among youths. Metaphorical: \"صاروا أحاديث\" — they became the talk of the town; here, the scholar's memorization of hadiths (ألفاظها وأسانيدها) is a means of self-aggrandizement, perverting the transmitted word into an instrument of rivalry.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and animates; also blood (نفس سائلة) as the seat of life.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; in \"ويحذركم الله نفسه\" (آل عمران/30), His \"Self\" is His very Essence (ذاته), showing that self-regard (رؤية النفس قدرًا) is a subtle disease of the innermost reality.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"أصابته نفس\" — the evil eye struck him; the proud man's gaze upon his own rank is a form of self-inflicted blindness, extinguishing the light of insight (نور البصيرة).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Prophet's words \"إنما العظيم من خلا عن هذا\" restrict greatness exclusively to the one free of pride, negating it for all others; likewise \"ليس لابن البيضاء على ابن السوداء فضل\" employs negation (ليس) to nullify any pretension of superiority by lineage, a syntactic structure of absolute denial.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "36": [{"arabic": "الله تعالى عنه من قول الرجلين المتحاورين إذ قال وما أظن الساعة قائمة ولئن رددت إلى ربي لأجدن خيرا منها منقلبا وجملة أمرهما كما نقل في التفسير أن الكافر منهما بنى قصرا بألف دينار واشترى بستانا بألف دينار وخدما بألف دينار وتزوج امرأة على ألف دينار وفي ذلك كله يعظه المؤمن ويقول اشتريت قصرا يفنى ويخرب ألا اشتريت قصرا في الجنة لا يفنى واشتريت بستانا يخرب ويفنى ألا اشتريت بستانا في الجنة لا يفنى وخدما لا يفنون ولا يموتون وزوجة من الحور العين لا تموت وفي كل ذلك يرد عليه الكافر ويقول ما هناك شيء وما", "english": "Rather, the world is two worlds: the world of Command (ālam al-amr) and the world of Creation (ālam al-khalq). And to God belongs the Creation and the Command {«ألا له الخلق والأمر»} (Q. 7:54). For bodies — those possessing quantity (kammiyyah) and magnitudes (maqādīr) — belong to the world of Creation, since \"creation\" (khalq) in linguistic usage is an expression for measuring and determining (taqdīr). And every existent that is exalted above quantity and magnitude belongs to the world of Command. The explanation of this is the secret of the Spirit (sirr al-rūḥ), and there is no license to divulge it, because of the harm most creatures would suffer upon hearing it — like the breaking of the vessel (kasr al-qidr) which prevented its contents from being spilled abroad.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 886", "section_title_en": "The Two Worlds: The World of Command and the World of Creation — On the Spirit, Self-Knowledge, and the Delusion of the World", "section_index": 886, "anchors": "- Root: امر (amr)\n  * Lisan / Ayn: Command, affair, matter; al-amr as divine imperative opposed to al-khalq (creation).\n  * Al-Raghib (Mufradat): Amr denotes the divine word of fiat (kun) by which things exist without mediate causation, contrasted with khalq as measured, quantified formation.\n  * Al-Zamakhshari (Asas): Haqiqah — amr is the unquantified, unmeasured divine decree; majaz would be applying it to corporeal extension.\n- Root: قدر (qadr)\n  * Lisan / Ayn: Measuring, determining, apportioning; al-taqdir is the assignment of quantity and limit.\n  * Al-Raghib (Mufradat): Khalq is taqdir — the imposition of quantity and magnitude upon bodies; what is exempt from quantity belongs to the world of amr.\n  * Al-Zamakhshari (Asas): Haqiqah — taqdir as delimitation; majaz — the \"measure\" of destiny as divine ordainment.\n- Root: فسق (fsq)\n  * Lisan / Ayn: To emerge, to exit; said of a ripe date (rutabah) bursting from its sheath (kimam).\n  * Al-Raghib (Mufradat): Fusuq is departure from the straight path — exiting one's natural, primordial locus (ma'din).\n  * Al-Zamakhshari (Asas): Haqiqah — physical emergence from a covering; majaz — moral transgression as deviation from innate disposition.\n- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Negligence, heedlessness; the white blaze on a horse's forehead; being deceived while unaware.\n  * Al-Raghib (Mufradat): Ghurur is delusion that seizes one in a state of ghaflah (unawareness), as in {«ما غرك بربك الكريم»} (Q. 82:6).\n  * Al-Zamakhshari (Asas): Haqiqah — the gazelle deceived by moonlight; majaz — the soul deceived by worldly allurements into false security.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — Long periodic sentences with parenthetical clarifications (e.g., \"بل العالم عالمان...\") require the predicate to be held in suspense, mirroring the rhetorical deferral of meaning until the full contrast is established.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Delusion'", "badge": "Afterlife"}, {"arabic": "أبدا وما أظن الساعة قائمة ولئن رددت إلى ربدى لأجدن خيرا منها منقلبا فإذا العبد المجتهد في الطاعات المجتنب للمعاصي حقيق بأن ينتظر من فضل الله تمام النعمة وما تمام النعمة إلا بدخول الجنة وأما العاصي فإذا تاب وتدارك جميع ما فرط منه من تقصير فحقيق بأن يرجو قبول التوبة وأما قبل التوبة إذا كان كارها للمعصية تسوءه السيئة وتسره الحسنة وهو يذم نفسه ويلومها ويشتهي التوبة ويشتاق إليها فحقيق بأن يرجو منا لله التوفيق للتوبة لأن كراهيته للمعصية وحؤصه على التوبة يجري مجرى السبب الذي قد يفضي إلى التوبة وإما الرجاء بعد تأكد الأسبا", "english": "It is fitting, therefore, that the servant's hope for forgiveness be measured against the hope of the cultivator. For whoever seeks good earth and casts into it good seed — neither rotten nor worm-eaten — then supplies it with what it needs, namely channeling water to it at its proper times, then clears away the thorns and weeds from the earth and everything that prevents the growth of the seed or corrupts it, then sits waiting for the bounty of God — may He be exalted — to repel the lightning-bolts and corrupting afflictions until the crop is completed and reaches its full extent — his waiting is named \"hope\" (rajā').", "book_title": "Fear and Hope", "section_title_ar": "Section 1029", "section_title_en": "The True Nature of Hope (Rajā') — Distinguishing Hope from Delusion and Wishful Thinking", "section_index": 1029, "anchors": "- Root: بذر (B-Dh-R)\n  * Lisan / Ayn: Scattering and casting seed into the earth; the core physical act of sowing.\n  * Al-Raghib (Mufradat): \"التبذير: التفريق\" — dispersion; metaphorically applied to the squanderer of wealth. Here, Ghazali employs the literal sense (Haqiqah) of sowing seed as the foundational analogy for the cultivation of faith.\n  * Al-Zamakhshari (Asas): Literal: \"بذر الحب في الأرض\" (sowing grain in the earth). Metaphorical: \"بذر الله الخلق في الأرض\" (God scattered creation) and \"بذرت الأرض: أخرجت نباتها\" (the earth brought forth its plants). Ghazali uses the literal agricultural sense to ground the metaphysical analogy.\n- Root: سبب (S-B-B)\n  * Lisan / Ayn: A rope, cord, or means by which one ascends or reaches something.\n  * Al-Raghib (Mufradat): \"سمي كل ما يتوصل به إلى شيء سببا\" — everything by which one arrives at a thing is called a cause/means. This is the technical sense operative here: the causes (asbāb) of hope are the means within the servant's capacity.\n  * Al-Zamakhshari (Asas): Literal: a cord. Metaphorical: \"خيل مسببة\" (well-trained horses) and \"أشار إليه بالسبابة\" (pointing). Ghazali uses the term in its rational, causal sense — the means leading to an end.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: Turning, overturning, transforming a thing from one state to another.\n  * Al-Raghib (Mufradat): \"تصريفه وصرفه عن وجه إلى وجه\" — the turning of a thing from one aspect to another. The heart (qalb) is so named for its constant fluctuation and transformation.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"قلب المعلم الصبيان\" (the teacher dismissed the boys) and \"رجل قلب حول\" (a man who turns matters over and manages them). The heart is the seat of this turning — the spiritual organ that must be cultivated or left barren.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication with 'innamā')\n  * The particle 'innamā' restricts and confines the predicate to the subject alone. Ghazali employs this structure repeatedly to delimit the precise application of terms like 'rajā'' (hope), 'ghurūr' (delusion), and 'tamannī' (wishful thinking), ensuring each name is applied only to its exact referent.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "39": [{"arabic": "وشهد الله والإخلاص والمعوذتين وليقل بسم الله ما شاء الله لا قوة إلا بالله حسبي الله توكلت على الله ما شاء الله لا يأتي بالخير إلا الله ما شاء الله لا يصرف السوء إلا الله حسبي الله وكفى سمع الله لمن دعا ليس وراء الله منتهى ولا دون الله ملجأ كتب الله لأغلبن أنا ورسلي إن الله قوي عزيز تحصنت بالله العظيم واستغثت بالحي الذي لا يموت اللهم احرسنا بعينك التي لا تنام واكنفنا بركنك الذي لا يرام اللهم ارحمنا بقدرتك علينا فلا نهلك وأنت ثقتنا ورجاؤنا اللهم أعطف علينا قلوب عبادك وإمائك برأفة ورحمة إنك أنت أرحم الراحمين الثامنة م", "english": "He ought to seek out a righteous companion, one who loves goodness and assists in it: if he forgets, the companion reminds him; if he remembers, the companion aids him; if he fears, the companion emboldens him; if he weakens, the companion strengthens him; if his breast narrows, the companion enlarges his patience. He should bid farewell to his resident companions, his brothers, and his neighbors — taking leave of them and seeking their supplications, for God Most High places goodness in their prayers. The Sunnah of farewell is to say: «أستودع الله دينك وأمانتك وخواتيم عملك» — \"I entrust to God your religion, your trustworthiness, and the seal of your deeds.\" And he, peace and blessings be upon him, used to say to one intending travel: \"In God's protection and His care — may God provide you with piety, forgive your sin, and direct you toward goodness wherever you may be.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 199", "section_title_en": "The Book of the Etiquette of Travel — Section 199: On the Comprehensive Etiquette of the Journey (From Provisioning to Guarding)", "section_index": 199, "anchors": "- Root: س ف ر (S-F-R)\n  * Lisan / Ayn: \"السفر: كشف الغطاء\" — unveiling, uncovering; the traveler is one who uncovers the veils of distant lands.\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء، ويختص ذلك بالأعيان\" — the journey is a literal uncovering of horizons, yet the spiritual journey unveils the soul's veils.\n  * Al-Zamakhshari (Asas): Haqiqah: \"سافر سفرا بعيدا\" (to travel far); Majaz: \"وجه مسفر: مشرق سرورا\" — a face radiant with joy, as the traveler's face brightens with divine trust.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the supplications' structural pauses.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "التوفيق ولا حول ولا قوة إلا بالله العلي العظيم فأما ما ذكرت لي أني آكل الرقاق وألبس الدقاق وأحتجب وأجلس على الوطىء فنحن نفعل ذلك ونستغفر الله تعالى فقد قال الله تعالى {قل من حرم زينة الله التي أخرج لعباده والطيبات من الرزق} وإني لأعلم أن ترك ذلك خير من الدخول فيه ولا تدعنا من كتابك فلسنا ندعك من كتابنا والسلام فانظر إلى إنصاف مالك إذ اعترف أن", "english": "...that he intended that (i.e., the debate) rather than formal learning. So he entered his house and did not come out to the people for forty days. When Hātim entered Baghdad, the people of Baghdad gathered around him and said: \"O Abā ʿAbd al-Raḥmān, you are a man, but you are a foreigner (aʿjamī), and no one speaks with you except that you cut him off (in argument).\" He said: \"I have three traits (khiṣāl) by which I overcome my opponent: I rejoice when my opponent is correct, I grieve when he errs, and I guard myself from acting ignorantly toward him.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 55", "section_title_en": "The Story of Hātim al-Aṣamm and the Letter of Mālik ibn Anas — On Renunciation of Worldly Adornment", "section_index": 55, "anchors": "- Root: ع-ج-م (ʿ-j-m)\n  * Lisan / Ayn: The core meaning denotes one who is non-Arab, or one whose speech is unclear/ungrammatical; also used for the unintelligible.\n  * Al-Raghib (Mufradat): In theological contexts, it distinguishes the foreigner (aʿjamī) who lacks the eloquence of the Arabs, yet may possess wisdom.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for non-Arab; metaphorical (majāz) for one who is silent or whose argument is weak.\n- Root: خ-ص-ل (kh-ṣ-l)\n  * Lisan / Ayn: A trait, quality, or characteristic (khiṣāl) inherent in a person, whether praiseworthy or blameworthy.\n  * Al-Raghib (Mufradat): Used for moral and spiritual attributes that define one's character in the path of salvation.\n  * Al-Zamakhshari (Asas): Literal for a natural or acquired quality; metaphorical for a portion of good or evil.\n- Root: ز-ي-ن (z-y-n)\n  * Lisan / Ayn: Adornment, ornament, or beautification (zīnah); to decorate.\n  * Al-Raghib (Mufradat): In the Quranic verse {قل من حرم زينة الله} it refers to permissible worldly beautification, which is not forbidden but can distract from the Hereafter.\n  * Al-Zamakhshari (Asas): Literal for physical ornament; metaphorical for spiritual adornment through piety.\n- Sibawayh Rule: باب الحكاية والمحكي (Narration and the Quoted) — When quoting speech, the syntactic case of the original utterance is preserved, as seen in the direct quotes of Hātim and the letters exchanged.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "41": [{"arabic": "غورا فلن تستطيع له طلبا وكان ذلك منه تكبرا بالمال والولد ثم بين الله عاقبة أمره بقوله {يا ليتني لم أشرك بربي أحدا} ومن ذلك تكبر قارون إذ قال تعالى إخبارا عن تكبره {فخرج على قومه في زينته قال الذين يريدون الحياة الدنيا يا ليت لنا مثل ما أوتي قارون إنه لذو حظ عظيم} السادس الكبر بالقوة وشدة البطش والتكبر به على أهل الضعف السابع التكبر بالأتباع والأنصار والتلامذة والغلمان وبالعشيرة والأقارب والبنين ويجري ذلك بين الملوك في المكاثرة بالجنود وبين العلماء في المكاثرة بالم", "english": "All of this is the very character of pride (أخلاق الكبر) and its effects, which self-exaltation through knowledge and action (التعزز بالعلم والعمل) produces. And where is the one who is free of all of that, or even of some of it? Would that I knew! Who is it that has recognized these traits within himself, and has heard the saying of the Messenger of God, peace and blessings be upon him: \"None shall enter Paradise who has in his heart the weight of a grain of mustard-seed of pride\" {«لا يدخل الجنة من في قلبه مثقال حبة من خردل من كبر»} — a hadith already cited earlier — how then can he magnify himself and behave arrogantly toward others, while the Messenger of God, peace and blessings be upon him, declares him to be among the people of the Fire? Rather, the truly great (العظيم) is only the one who is free of this; and whoever is free of it has in him no self-magnification and no arrogance. And the learned man (العالم) is the one who understands that God, Exalted is He, has said to him: \"You have with Us a standing, so long as you do not see for yourself any standing; for if you see for yourself a standing, then you have no standing with Us.\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 860", "section_title_en": "The Fruits of Pride in Knowledge and Lineage — Section 860 of the Revival of the Religious Sciences", "section_index": 860, "anchors": "- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core root denotes magnitude, size, and seniority — whether in age, rank, or physical dimension; \"الكبرة\" is the burden of advanced age.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — great and small are relative terms, assessed by comparison; pride (الكبر) is the soul's self-magnification vis-à-vis another, a theological vice when it entails disdain for God's creatures.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"كبر الأمر\" — the matter became grave. Metaphorical (Majaz): \"كبر عليه\" — it weighed heavily upon him; here, the physical sense of \"bigness\" is transferred to the moral-spiritual state of self-inflation (التعاظم) against others.\n- Root: حدث (H-D-TH)\n  * Lisan / Ayn: Denotes newness, origination after non-existence; \"الحديث\" is speech that is newly articulated or conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination of a thing after it was not; the \"حديث\" (Prophetic report) is so named as newly transmitted discourse bearing authority.\n  * Al-Zamakhshari (Asas): Literal: \"حدث من الأحداث\" — a youth among youths. Metaphorical: \"صاروا أحاديث\" — they became the talk of the town; here, the scholar's memorization of hadiths (ألفاظها وأسانيدها) is a means of self-aggrandizement, perverting the transmitted word into an instrument of rivalry.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and animates; also blood (نفس سائلة) as the seat of life.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; in \"ويحذركم الله نفسه\" (آل عمران/30), His \"Self\" is His very Essence (ذاته), showing that self-regard (رؤية النفس قدرًا) is a subtle disease of the innermost reality.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"أصابته نفس\" — the evil eye struck him; the proud man's gaze upon his own rank is a form of self-inflicted blindness, extinguishing the light of insight (نور البصيرة).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Prophet's words \"إنما العظيم من خلا عن هذا\" restrict greatness exclusively to the one free of pride, negating it for all others; likewise \"ليس لابن البيضاء على ابن السوداء فضل\" employs negation (ليس) to nullify any pretension of superiority by lineage, a syntactic structure of absolute denial.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "42": [{"arabic": "ثم بين الله عاقبة أمره بقوله {يا ليتني لم أشرك بربي أحدا} ومن ذلك تكبر قارون إذ قال تعالى إخبارا عن تكبره {فخرج على قومه في زينته قال الذين يريدون الحياة الدنيا يا ليت لنا مثل ما أوتي قارون إنه لذو حظ عظيم} السادس الكبر بالقوة وشدة البطش والتكبر به على أهل الضعف السابع التكبر بالأتباع والأنصار والتلامذة والغلمان وبالعشيرة والأقارب والبنين ويجري ذلك بين الملوك في المكاثرة بالجنود وبين العلماء في المكاثرة بالمستفيدين وبالجملة فكل ما هو نعمة وأمكن أن يعتقد كمالا وإن لم يكن في نفسه كمالا أمكن أن يتكبر به حتى", "english": "All of this is the very character of pride (أخلاق الكبر) and its effects, which self-exaltation through knowledge and action (التعزز بالعلم والعمل) produces. And where is the one who is free of all of that, or even of some of it? Would that I knew! Who is it that has recognized these traits within himself, and has heard the saying of the Messenger of God, peace and blessings be upon him: \"None shall enter Paradise who has in his heart the weight of a grain of mustard-seed of pride\" {«لا يدخل الجنة من في قلبه مثقال حبة من خردل من كبر»} — a hadith already cited earlier — how then can he magnify himself and behave arrogantly toward others, while the Messenger of God, peace and blessings be upon him, declares him to be among the people of the Fire? Rather, the truly great (العظيم) is only the one who is free of this; and whoever is free of it has in him no self-magnification and no arrogance. And the learned man (العالم) is the one who understands that God, Exalted is He, has said to him: \"You have with Us a standing, so long as you do not see for yourself any standing; for if you see for yourself a standing, then you have no standing with Us.\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 860", "section_title_en": "The Fruits of Pride in Knowledge and Lineage — Section 860 of the Revival of the Religious Sciences", "section_index": 860, "anchors": "- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core root denotes magnitude, size, and seniority — whether in age, rank, or physical dimension; \"الكبرة\" is the burden of advanced age.\n  * Al-Raghib (Mufradat): \"الكبير والصغير من الأسماء المتضايفة\" — great and small are relative terms, assessed by comparison; pride (الكبر) is the soul's self-magnification vis-à-vis another, a theological vice when it entails disdain for God's creatures.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"كبر الأمر\" — the matter became grave. Metaphorical (Majaz): \"كبر عليه\" — it weighed heavily upon him; here, the physical sense of \"bigness\" is transferred to the moral-spiritual state of self-inflation (التعاظم) against others.\n- Root: حدث (H-D-TH)\n  * Lisan / Ayn: Denotes newness, origination after non-existence; \"الحديث\" is speech that is newly articulated or conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination of a thing after it was not; the \"حديث\" (Prophetic report) is so named as newly transmitted discourse bearing authority.\n  * Al-Zamakhshari (Asas): Literal: \"حدث من الأحداث\" — a youth among youths. Metaphorical: \"صاروا أحاديث\" — they became the talk of the town; here, the scholar's memorization of hadiths (ألفاظها وأسانيدها) is a means of self-aggrandizement, perverting the transmitted word into an instrument of rivalry.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and animates; also blood (نفس سائلة) as the seat of life.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; in \"ويحذركم الله نفسه\" (آل عمران/30), His \"Self\" is His very Essence (ذاته), showing that self-regard (رؤية النفس قدرًا) is a subtle disease of the innermost reality.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"أصابته نفس\" — the evil eye struck him; the proud man's gaze upon his own rank is a form of self-inflicted blindness, extinguishing the light of insight (نور البصيرة).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Prophet's words \"إنما العظيم من خلا عن هذا\" restrict greatness exclusively to the one free of pride, negating it for all others; likewise \"ليس لابن البيضاء على ابن السوداء فضل\" employs negation (ليس) to nullify any pretension of superiority by lineage, a syntactic structure of absolute denial.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "45": [{"arabic": "تعالى لها مثلا فقال تعالى واضرب لهم مثل الحياة الدنيا كماء أنزلناه من السماء فاختلط به نبات الأرض فأصبح هشيما تذروه الرياح والزهد في الدنيا لما أن كان ملكا حاضرا حسده الشيطان عليه فصده عنه ومعنى الزهد أن يملك العبد شهوته وغضبه فينقادان لباعث الدين وإشارة الإيمان وهذا ملك بالاستحقاق إذ به يصير صاحبه حرا وباستيلاء الشهوة عليه يصير عبدا لفرجه وبطنه وسائر أغراضه فيكون مسخرا مثل البهيمة مملوكا يستجره زمام الشهوة آخذا بمختنقه إلى حيث يريد ويهوى فما أعظم اغترار الإنسان إذ ظن أنه ينال الملك بأنه يصير مملوكا وينال الربوبية بأن يصير عبدا ومثل هذا هل يكون إلا معكوسا في الدنيا من", "english": "...anxieties in [worldly] administrations, and likewise all the other means to rank. Then, whenever the means are secured and completed, the lifespan expires — until, when the earth has taken on its ornament and is adorned, and its people suppose that they are able to master it, there comes to it Our command by night or by day, and We make it a harvested stubble as if it had not flourished the day before. Thus God — exalted be He — struck for it a parable, saying — exalted be He: {And strike for them the parable of the life of this world: like water which We send down from the sky, and the vegetation of the earth mingles with it, and then it becomes dry chaff which the winds scatter} {«وَاضْرِبْ لَهُمْ مَثَلَ الْحَيَاةِ الدُّنْيَا كَمَاءٍ أَنْزَلْنَاهُ مِنَ السَّمَاءِ فَاخْتَلَطَ بِهِ نَبَاتُ الْأَرْضِ فَأَصْبَحَ هَشِيمًا تَذْرُوهُ الرِّيَاحُ»} [Al-Kahf: 45]. And asceticism (al-zuhd) in this world — because it was a present sovereignty — Satan envied him for it and barred him from it.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 971", "section_title_en": "On Renouncing Status and the True Meaning of Sovereignty — The Cure for the Love of Prestige", "section_index": 971, "anchors": "- Root: ملك (malaka)\n  * Lisan / Ayn: Core root denotes possession, dominion, and the power to command and forbid; al-Farahidi notes its application to kingship and ownership alike.\n  * Al-Raghib (Mufradat): Distinguishes two modes: (1) actual possession/sovereignty (al-tamalluk wa al-tawallī) and (2) the capacity/power to exercise it (al-quwwah ʿalā dhālika), whether or not one actually rules. True sovereignty belongs to him who governs his own soul.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): ownership of property and dominion over subjects. Metaphorical (majāz): \"he mastered his anger\" (malaka nafsahu ʿinda al-ghadab) — self-mastery as the paradigmatic figurative extension of kingship.\n- Root: عقد (ʿabada)\n  * Lisan / Ayn: Servitude and worship; the slave (ʿabd) is one who is owned and subjugated.\n  * Al-Raghib (Mufradat): ʿUbūdiyyah is the state of being subjugated to another's command; true slavery to passion is the degradation of the rational soul.\n  * Al-Zamakhshari (Asas): Literal: chattel slavery. Metaphorical: he who is led by his lusts is a slave in reality, even if free in legal form.\n- Root: سخر (sakhkhara)\n  * Lisan / Ayn: To subjugate, compel, and employ against one's will; used of beasts and forces pressed into service.\n  * Al-Raghib (Mufradat): Taskhīr is the compelled employment of a thing for another's purpose — the opposite of free, rational agency.\n  * Al-Zamakhshari (Asas): Literal: subjugation of animals. Metaphorical: the man ruled by appetite is musakhkhar — driven like a beast by its halter.\n- Root: دنا (dānā)\n  * Lisan / Ayn: Nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): Al-dunyā (the lower world) is so named for its nearness and lowness relative to the Hereafter; it is the realm of delusion when pursued for its own sake.\n  * Al-Zamakhshari (Asas): Literal: proximity. Metaphorical: the \"nearer\" life as the inferior, contemptible portion.\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The periodic sentence structure here interposes lengthy causal and conditional clauses between the governing verb and its complements, requiring the translator to preserve the logical sequence of protasis and apodosis without collapsing the rhetorical tension of the original.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Patience and Gratitude'", "badge": "Ethics"}, {"arabic": "أنزلناه من السماء فاختلط به نبات الأرض الآية وقال تعالى واضرب لهم مثل الحياة الدنيا كماء أنزلناه من السماء إلى قوله فأصبح هشيما تذروه الرياح وكل ما تذروه رياح الموت فهو زهرة الحياة الدنيا وكل ما لا يقطعه الموت فهو الباقيات الصالحات فقد عرفت بهذا أن كمال القدرة بالمال والجاه كمال ظني لا أصل له وأن من قصر الوقت على طلبه وظنه مقصودا فهو جاهل وإليه أشار أبو الطيب بقوله ومن ينفق الساعات في جمع ماله .", "english": "Therefore, the perfections are three, if we count non-change through appetites and non-submission to them as a perfection—like the perfection of knowledge and the perfection of freedom. By \"freedom\" I mean non-enslavement to appetites and to willing worldly causes. The perfection of power for the servant is a path to acquiring the perfection of knowledge and the perfection of freedom, but he has no path to acquiring the perfection of power that endures after his death. For his power over the very substances of wealth and over subjugating hearts and bodies is cut off by death, whereas his knowledge and his freedom are not annihilated by death; rather, they both endure as perfection within him and as a means to nearness to God—may He be exalted.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 800", "section_title_en": "On True Perfection: Knowledge and Freedom Over Power, Wealth, and Status", "section_index": 800, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and enabling; power as capacity to bring about an effect.\n  * Al-Raghib (Mufradat): True power (qudrah) belongs absolutely to God alone; for humans, it is a relative capacity, never absolute, and is a means, not an end.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) power is God's; metaphorical (majaz) attribution of \"power\" to creatures is restricted and conditional, tied to specific acts.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as apprehension of a thing's reality; also traces and signs by which one is guided.\n  * Al-Raghib (Mufradat): Knowledge (ʿilm) is the apprehension of a thing's true nature or the judgment of existence or non-existence regarding it; it is the enduring perfection of the soul.\n  * Al-Zamakhshari (Asas): Literal: \"he knew\" as direct awareness; metaphorical: \"he knew\" as perception or discernment of signs (maʿālim) leading to truth.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of vital functions; also the state of being inanimate or lifeless.\n  * Al-Raghib (Mufradat): Death is the opposite of life; in theological context, it marks the termination of worldly capacities but not of the soul's acquired knowledge or freedom.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: \"death\" of the heart through ignorance or enslavement to passion, and \"revival\" of the land through rain as a similitude for the fleeting world.\n- Sibawayh Rule: Restriction and Focused Predication (الحصر والتقييد بإنما) — Used to confine true perfection exclusively to knowledge and freedom, negating it for power, wealth, and status.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}, {"arabic": "الحياة الدنيا كماء أنزلناه من السماء إلى قوله فأصبح هشيما تذروه الرياح وكل ما تذروه رياح الموت فهو زهرة الحياة الدنيا وكل ما لا يقطعه الموت فهو الباقيات الصالحات فقد عرفت بهذا أن كمال القدرة بالمال والجاه كمال ظني لا أصل له وأن من قصر الوقت على طلبه وظنه مقصودا فهو جاهل وإليه أشار أبو الطيب بقوله ومن ينفق الساعات في جمع ماله .", "english": "Therefore, the perfections are three, if we count non-change through appetites and non-submission to them as a perfection—like the perfection of knowledge and the perfection of freedom. By \"freedom\" I mean non-enslavement to appetites and to willing worldly causes. The perfection of power for the servant is a path to acquiring the perfection of knowledge and the perfection of freedom, but he has no path to acquiring the perfection of power that endures after his death. For his power over the very substances of wealth and over subjugating hearts and bodies is cut off by death, whereas his knowledge and his freedom are not annihilated by death; rather, they both endure as perfection within him and as a means to nearness to God—may He be exalted.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 800", "section_title_en": "On True Perfection: Knowledge and Freedom Over Power, Wealth, and Status", "section_index": 800, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and enabling; power as capacity to bring about an effect.\n  * Al-Raghib (Mufradat): True power (qudrah) belongs absolutely to God alone; for humans, it is a relative capacity, never absolute, and is a means, not an end.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) power is God's; metaphorical (majaz) attribution of \"power\" to creatures is restricted and conditional, tied to specific acts.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as apprehension of a thing's reality; also traces and signs by which one is guided.\n  * Al-Raghib (Mufradat): Knowledge (ʿilm) is the apprehension of a thing's true nature or the judgment of existence or non-existence regarding it; it is the enduring perfection of the soul.\n  * Al-Zamakhshari (Asas): Literal: \"he knew\" as direct awareness; metaphorical: \"he knew\" as perception or discernment of signs (maʿālim) leading to truth.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of vital functions; also the state of being inanimate or lifeless.\n  * Al-Raghib (Mufradat): Death is the opposite of life; in theological context, it marks the termination of worldly capacities but not of the soul's acquired knowledge or freedom.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: \"death\" of the heart through ignorance or enslavement to passion, and \"revival\" of the land through rain as a similitude for the fleeting world.\n- Sibawayh Rule: Restriction and Focused Predication (الحصر والتقييد بإنما) — Used to confine true perfection exclusively to knowledge and freedom, negating it for power, wealth, and status.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}], "46": [{"arabic": "ولا هم ينصرون وهم الذين لم يفهموا قوله تعالى المال والبنون زينة الحياة الدنيا والباقيات الصالحات خير عند ربك ثوابا وخير أملا فالعلم والحرية هي الباقيات الصالحات التي تبقى كمالا في النفس والمال والجاه هو الذي ينقضي على القرب وهو كما مثله الله تعالى حيث قال إنما مثل الحياة الدنيا كماء أنزلناه من السماء فاختلط به نبات الأرض الآية وقال تعالى واضرب لهم مثل الحياة الدنيا كماء أنزلناه من السماء إلى قوله فأصبح هشيما تذروه الرياح وكل ما تذروه رياح الموت فهو زهرة الحياة الدنيا وكل ما لا يقطعه الموت فهو الباقيات الصالحات فقد عرفت بهذا أن كمال القدرة بالمال والجاه كمال ظني لا أصل له وأن من", "english": "Therefore, the perfections are three, if we count non-change through appetites and non-submission to them as a perfection—like the perfection of knowledge and the perfection of freedom. By \"freedom\" I mean non-enslavement to appetites and to willing worldly causes. The perfection of power for the servant is a path to acquiring the perfection of knowledge and the perfection of freedom, but he has no path to acquiring the perfection of power that endures after his death. For his power over the very substances of wealth and over subjugating hearts and bodies is cut off by death, whereas his knowledge and his freedom are not annihilated by death; rather, they both endure as perfection within him and as a means to nearness to God—may He be exalted.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 800", "section_title_en": "On True Perfection: Knowledge and Freedom Over Power, Wealth, and Status", "section_index": 800, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and enabling; power as capacity to bring about an effect.\n  * Al-Raghib (Mufradat): True power (qudrah) belongs absolutely to God alone; for humans, it is a relative capacity, never absolute, and is a means, not an end.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) power is God's; metaphorical (majaz) attribution of \"power\" to creatures is restricted and conditional, tied to specific acts.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as apprehension of a thing's reality; also traces and signs by which one is guided.\n  * Al-Raghib (Mufradat): Knowledge (ʿilm) is the apprehension of a thing's true nature or the judgment of existence or non-existence regarding it; it is the enduring perfection of the soul.\n  * Al-Zamakhshari (Asas): Literal: \"he knew\" as direct awareness; metaphorical: \"he knew\" as perception or discernment of signs (maʿālim) leading to truth.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of vital functions; also the state of being inanimate or lifeless.\n  * Al-Raghib (Mufradat): Death is the opposite of life; in theological context, it marks the termination of worldly capacities but not of the soul's acquired knowledge or freedom.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: \"death\" of the heart through ignorance or enslavement to passion, and \"revival\" of the land through rain as a similitude for the fleeting world.\n- Sibawayh Rule: Restriction and Focused Predication (الحصر والتقييد بإنما) — Used to confine true perfection exclusively to knowledge and freedom, negating it for power, wealth, and status.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}], "47": [{"arabic": "ويحمل عرش ربك فوقهم يومئذ ثمانية يومئذ تعرضون لا تخفى منكم خافية يوم تسير الجبال وترى الأرض بارزة يوم ترج الأرض فيه رجا وتبس الجبال بسا فكانت هباء منبثا يوم يكون الناس كالفراش المبثوث وتكون الجبال كالعهن المنفوش يوم تذهل فيه كل مرضعة عما أرضعت وتضع كل ذات حمل حملها وترى الناس سكارى وما هم بسكارى ولكن عذاب الله شديد يوم تبدل الأرض غير الأرض والسموات وبرزوا لله الواحد القهار يوم تنسف فيه الجبال نسفا فتترك قاعا صفصفا لا ترى فيها عوجا ولا أمتا يوم ترى الجبال تحسبها جامدة وهي تمر مر السحاب يوم تنشق فيه السماء فتكون وردة كالدهان فيومئذ لا يسئل عن ذنبه", "english": "So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1339", "section_title_en": "The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent", "section_index": 1339, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "49": [{"arabic": "نفس شيئا وإن كان مثقال حبة من خردل أتينا بها وكفى بنا حاسبين} وقال تعالى {ووضع الكتاب فترى المجرمين مشفقين مما فيه ويقولون يا ويلتنا ما لهذا الكتاب لا يغادر صغيرة ولا كبيرة إلا أحصاها ووجدوا ما عملوا حاضرا ولا يظلم ربك أحدا} وقال تعالى {يوم يبعثهم الله جميعا فينبئهم بما عملوا أحصاه الله ونسوه والله على كل شيء شهيد} وقال تعالى {يومئذ يصدر الناس أشتاتا ليروا أعمالهم فمن يعمل مثقال ذرة خيرا يره ومن يعمل مثقال ذرة شرا يره} وقال تعالى {ثم توفى كل نفس ما كسبت وهم لا يظلمون} وقال تعالى {يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو أن بينها وبينه أمدا بعيدا ويحذركم الله نفسه} وقال تعالى {واعلموا أن الله يعلم ما في أنفسكم فاحذروه} فعرف أرباب البصائر من جملة الع", "english": "To proceed: God Most High has said: {And We shall set up the scales of justice for the Day of Resurrection, so no soul shall be wronged in anything; and if it be the weight of a grain of mustard seed, We shall bring it forth, and sufficient are We as Reckoners} (21:47). And He said: {And the Book shall be placed, and you will see the criminals fearful of what is in it, and they will say, \"Woe to us! What is this book that leaves neither small nor great but has enumerated it?\" And they will find what they did present, and your Lord wrongs no one} (18:49). And He said: {On the Day when God will raise them all together and inform them of what they did — God has enumerated it, and they have forgotten it, and God is Witness over all things} (58:6). And He said: {On that Day, people will issue forth in scattered groups to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it} (99:6-8). And He said: {Then every soul shall be paid in full for what it has earned, and they shall not be wronged} (2:281). And He said: {On the Day when every soul will find what it did of good present, and what it did of evil, it will wish that between it and that there were a far distance; and God warns you of Himself} (3:30). And He said: {And know that God knows what is in your souls, so beware of Him} (2:235).", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1230", "section_title_en": "Exposition of the Reality of Truthfulness (Al-Sidq), Its Meaning, and Its Grades — Book of Vigilance and Self-Reckoning, Being the Eighth Book of the Quarter of Deliverance from the Revival of the Religious Sciences", "section_index": 1230, "anchors": "- Root: رقب (Raqaba)\n  * Lisan / Ayn: To watch, guard, observe; a watcher (raqīb) is one who stands vigilant over something, awaiting its occurrence.\n  * Al-Raghib (Mufradat): Raqaba denotes protective watchfulness; al-raqīb is a divine attribute signifying His perpetual oversight of all that transpires, with no moment of neglect.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical watching/awaiting. Metaphorical (majāz): \"This matter is upon your necks (fī riqābikum)\" — i.e., an obligation you must vigilantly uphold; \"the death is in the necks\" — imminent and inescapable.\n- Root: حسب (Hasaba)\n  * Lisan / Ayn: To count, reckon, compute; al-ḥisāb is the act of enumeration and settlement of accounts.\n  * Al-Raghib (Mufradat): Al-ḥisāb is the employment of number; divine reckoning (ḥisāb) on the Day of Resurrection is the exacting appraisal of deeds, even to the atom's weight.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"they reckon news (yaḥtasibūna al-akhbār)\" — they investigate and ascertain, as one places knowledge in place of conjecture.\n- Root: قلب (Qalaba)\n  * Lisan / Ayn: To turn, overturn, transform; the heart (qalb) is so named for its constant fluctuation and turning of states.\n  * Al-Raghib (Mufradat): Qalaba is the turning of a thing from one state to another; the heart's inner thoughts (khaṭarāt) are its successive movements, which God surveys.\n  * Al-Zamakhshari (Asas): Literal: turning a garment or object. Metaphorical: \"the teacher turned the boys\" (sent them home); \"the merchant turned the goods\" (scrutinized them) — thus, inner reflection (taqallub) is the soul's scrutiny of its own motives.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"إنما يحاسبهم لتعلم كل نفس\" — the sole purpose of reckoning is specified, excluding all other ends.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monitoring and Accounting'", "badge": "Afterlife"}, {"arabic": "الكتاب لا يغادر صغيرة ولا كبيرة إلا أحصاها} قال الصغيرة التبسم والكبيرة الضحك فكيف بما عملته الأيدي وحصدته الألسن يا أمير المؤمنين بلغني أن عمر بن الخطاب رضي الله عنه قال لو ماتت سخلة على شاطئ الفرات ضيعة لخشيت أن أسأل عنها فكيف بمن حرم عدلك وهو على بساطك يا أمير المؤمنين أتدري ما جاء في تأويل هذه الآية عن جدك {يا داود إنا جعلناك خليفة في الأرض فاحكم بين الناس بالحق ولا تتبع الهوى فيضلك عن سبيل الله} قال الله تعالى في الزبور يا داود إذا قعد الخصمان بين يديك فكان لك في أحدهما هوى فلا تتمني", "english": "He turned to al-Shaʿbī and said: \"O Abā ʿAmr! I am the trustee of the Commander of the Faithful over Iraq and his governor over it, and a man commanded to obedience. I have been tried with the subjects, and their right has become incumbent upon me. So I love to preserve them and to attend to what sets them right, along with sincere counsel (naṣīḥah) to them. And reports may reach me about a band of people from the regions concerning a matter, and I find myself severe against them therein, so I withhold a portion of their stipends and place it in the treasury (bayt al-māl), with the intention in myself that I shall return it to them. Then it reaches the Commander of the Faithful that I have withheld it in that manner, so he writes to me that I must not return it. I cannot then countermand his order, nor can I execute his letter [against my better judgment]. I am but a man commanded to obedience. Is there any liability upon me in this, and in similar matters, where the intention is as I have described?\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 553", "section_title_en": "The Upright Scholars Before the Tyrannical Rulers — Counsel and Fearless Truth-Telling", "section_index": 553, "anchors": "- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning is sincerity, faithfulness, and pure counsel free from deceit; the root denotes the act of seeking the welfare of another with complete integrity.\n  * Al-Raghib (Mufradat): In theological context, naṣīḥah is the obligation of the sincere advisor to guide the ruler toward divine truth, even at personal peril, as it is a form of worship (ʿibādah) and a trust (amānah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes pure honey (ʿasal naṣīḥ) free from admixture; metaphorical (majāz) usage applies to counsel that is untainted by flattery or self-interest.\n- Root: سلط (sulṭ)\n  * Lisan / Ayn: Denotes authority, power, and dominion; the ruler (sulṭān) is one who has been given sway over affairs.\n  * Al-Raghib (Mufradat): In Kalam, sulṭān is a trial (ibtilāʾ) and a trust (amānah) from God, whose exercise demands justice (ʿadl) and whose neglect invites divine wrath.\n  * Al-Zamakhshari (Asas): Literal usage refers to physical power or a governing authority; metaphorical usage extends to the authority of proof (sulṭān al-burhān) that compels assent.\n- Root: عظ (waʿaẓa)\n  * Lisan / Ayn: Root denotes admonition, exhortation, and reminding of consequences; it implies softening the heart through remembrance of God and the Hereafter.\n  * Al-Raghib (Mufradat): In theological terms, ʿiẓah is the act of turning the soul away from transgression through a blend of fear (tarhīb) and hope (targhīb), grounded in revealed truth.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal admonition; metaphorical usage is the admonition of circumstance (ʿiẓah al-ḥāl) when events themselves teach a lesson.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (bāb al-ḥaṣr wa al-taqyīd bi-innamā) — Governing the emphasis of exclusive predication in statements of counsel, such as \"No obedience to a creature in disobedience of the Creator,\" where the restriction (ḥaṣr) is achieved through negation and exception (nafy wa istithnāʾ).", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Remembrance of Death and Afterlife'", "badge": "Ethics"}, {"arabic": "يا أمير المؤمنين أتدري ما جاء في تأويل هذه الآية عن جدك {ما لهذا الكتاب لا يغادر صغيرة ولا كبيرة إلا أحصاها} قال الصغيرة التبسم والكبيرة الضحك فكيف بما عملته الأيدي وحصدته الألسن يا أمير المؤمنين بلغني أن عمر بن الخطاب رضي الله عنه قال لو ماتت سخلة على شاطئ الفرات ضيعة لخشيت أن أسأل عنها فكيف بمن حرم عدلك وهو على بساطك يا أمير المؤمنين أتدري ما جاء في تأويل هذه الآية عن جدك {يا داود إنا جعلناك خليفة في الأرض فاحكم بين الناس بالحق ولا تتبع الهوى فيضلك عن سبيل الله} قال الله تعالى في الزبور يا داود إذا قعد الخصمان بين يديك فكان لك في أحدهما هوى فلا تتمني", "english": "He turned to al-Shaʿbī and said: \"O Abā ʿAmr! I am the trustee of the Commander of the Faithful over Iraq and his governor over it, and a man commanded to obedience. I have been tried with the subjects, and their right has become incumbent upon me. So I love to preserve them and to attend to what sets them right, along with sincere counsel (naṣīḥah) to them. And reports may reach me about a band of people from the regions concerning a matter, and I find myself severe against them therein, so I withhold a portion of their stipends and place it in the treasury (bayt al-māl), with the intention in myself that I shall return it to them. Then it reaches the Commander of the Faithful that I have withheld it in that manner, so he writes to me that I must not return it. I cannot then countermand his order, nor can I execute his letter [against my better judgment]. I am but a man commanded to obedience. Is there any liability upon me in this, and in similar matters, where the intention is as I have described?\"", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 553", "section_title_en": "The Upright Scholars Before the Tyrannical Rulers — Counsel and Fearless Truth-Telling", "section_index": 553, "anchors": "- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning is sincerity, faithfulness, and pure counsel free from deceit; the root denotes the act of seeking the welfare of another with complete integrity.\n  * Al-Raghib (Mufradat): In theological context, naṣīḥah is the obligation of the sincere advisor to guide the ruler toward divine truth, even at personal peril, as it is a form of worship (ʿibādah) and a trust (amānah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes pure honey (ʿasal naṣīḥ) free from admixture; metaphorical (majāz) usage applies to counsel that is untainted by flattery or self-interest.\n- Root: سلط (sulṭ)\n  * Lisan / Ayn: Denotes authority, power, and dominion; the ruler (sulṭān) is one who has been given sway over affairs.\n  * Al-Raghib (Mufradat): In Kalam, sulṭān is a trial (ibtilāʾ) and a trust (amānah) from God, whose exercise demands justice (ʿadl) and whose neglect invites divine wrath.\n  * Al-Zamakhshari (Asas): Literal usage refers to physical power or a governing authority; metaphorical usage extends to the authority of proof (sulṭān al-burhān) that compels assent.\n- Root: عظ (waʿaẓa)\n  * Lisan / Ayn: Root denotes admonition, exhortation, and reminding of consequences; it implies softening the heart through remembrance of God and the Hereafter.\n  * Al-Raghib (Mufradat): In theological terms, ʿiẓah is the act of turning the soul away from transgression through a blend of fear (tarhīb) and hope (targhīb), grounded in revealed truth.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal admonition; metaphorical usage is the admonition of circumstance (ʿiẓah al-ḥāl) when events themselves teach a lesson.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (bāb al-ḥaṣr wa al-taqyīd bi-innamā) — Governing the emphasis of exclusive predication in statements of counsel, such as \"No obedience to a creature in disobedience of the Creator,\" where the restriction (ḥaṣr) is achieved through negation and exception (nafy wa istithnāʾ).", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Enjoining Good and Forbidding Evil'", "badge": "Ethics"}, {"arabic": "يقول ليجزى الذي أساءوا بما عملوا ويجزى الذي أحسنوا بالحسنى وقال تعالى {ووضع الكتاب فترى المجرمين مشفقين مما فيه} الآية جعلنا الله وإياكم عاملين بكتابة متبعين لأوليائه حتى يحلنا وإياكم دار المقامة من فضله إنه حميد مجيد وقال بعض الحكماء الأيام سهام والناس أغراض والدهر يرميك كل يوم بسهامه ويخترمك بلياليه وأيامه حتى يستغرق جميع أجزائك فكيف بقاء سلامتك مع وقوع الأيام بك وسرعة الليالي في بدنك لو كشف لك عما أحدثت الأيام فيك من النقص لاستوحشت من كل يوم يأتي عليك واستثقلت ممر الساعة بك ولكن تدبير الله فوق تدبير الاعتبار وبالسلو عن غوائل الدنيا وجد طعم لذات", "english": "And indeed there has come the narration from him, from his Lord, Mighty and Glorious, that He said to Moses, peace be upon him: \"When you see the rich man approaching, say: 'A sin whose punishment has been hastened.' And when you see the poor man approaching, say: 'Welcome to the badge of the righteous.'\" And if you wish, you may follow the possessor of the Spirit and the Word, Jesus son of Mary, peace be upon him — for he used to say: \"My condiment is hunger, my badge is fear, my garment is wool, my warmth in winter is the rising places of the sun, my lamp is the moon, my mount is my two feet, and my food and my fruit is what the earth brings forth. I pass the night and I possess nothing, and I rise in the morning and I possess nothing — and there is no one upon the earth richer than I.\"", "book_title": "Condemnation of the World", "section_title_ar": "Section 737", "section_title_en": "The Revival of the Religious Sciences — Section 737: On the Censure of This World and the Description of Its Perils", "section_index": 737, "anchors": "- Root: دنو (danuww)\n  * Lisan / Ayn: \"دنا فهو دانٍ\" — proximity, nearness; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter.\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — proximity by essence or by decree; used of place, time, and station. The \"nearer\" (al-adnā) is contrasted with the greater and the better.\n  * Al-Zamakhshari (Asas): Literal: physical nearness. Metaphorical: the lower, contemptible station — \"أهل الدناءة هم أهل الشناءة\" (the people of baseness are the people of abhorrence).\n- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم\" — a day; also any period of time.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day is the time from sunrise to sunset, or any duration whatsoever. \"وذكرهم بأيام الله\" — the days of God are His mighty deeds and calamities upon the disbelievers.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"أيام العرب\" — their battles and vicissitudes; \"أيام الله\" — His punitive visitations.\n- Root: وقد (waqada)\n  * Lisan / Ayn: \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is the fuel.\n  * Al-Raghib (Mufradat): \"وقودها الناس والحجارة\" — the fuel of the Fire is men and stones; the one who kindles it for himself (istawqada) is he who seeks its light.\n  * Al-Zamakhshari (Asas): Literal: kindling a fire. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقد الحصى\" — the pebbles became scorching hot (i.e., the intensity of the sun's heat).\n- Root: ألك (alaka)\n  * Lisan / Ayn: \"المألكة: الرسالة، لأنها تؤلك في الفم\" — the message (risālah) is called ma'lakah because it is chewed/worked in the mouth.\n  * Al-Raghib (Mufradat): \"الملائكة تقع على الواحد والجمع\" — angels (malā'ikah) are so named as bearers of messages; \"الله يصطفي من الملائكة رسلا\" {«الله يصطفي من الملائكة رسلا»} — God chooses messengers from the angels.\n  * Al-Zamakhshari (Asas): Literal: chewing (as a horse chews its bit). Metaphorical: delivering a message — the angel is the one who delivers the divine communication.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate to the subject alone, negating it of all else. Applied in the sermon: \"إنما يتزين لي أوليائي بالذل والخوف\" — My friends adorn themselves for Me ONLY with humility, fear, and submission — restricting their adornment to these alone, excluding all worldly ornament.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of the World'", "badge": "Insight"}, {"arabic": "تعالى يا ويلتنا ما لهذا الكتاب لا يغادر صغيرة ولا كبيرة إلا أحصاها إن الصغيرة التبسم بالاستهزاء بالمؤمن والكبيرة القهقهة بذلك وهذا إشارة إلى أن الضحك على الناس من جملة الذنوب والكبائر وعن عبد الله بن زمعة أنه قال سمعت رسول الله صلى الله عليه وسلم وهو يخطب فوعظهم في ضحكهم من الضرطة فقال علام يضحك أحدكم مما يفعل (3) وقال صلى الله عليه وسلم إن المستهزئين بالناس يفتح لأحدهم باب من الجنة فيقال هلم هلم فيجيء بكربه وغمه فإذا أتاه أغلق دونه ثم يفتح له باب آخر فيقال هلم هلم فيجيء بكربه وغمه فإذا أتاه أغلق دونه فما يزال", "english": "This is forbidden whenever it is harmful, just as God—Exalted is He—has said: {«يا أيها الذين آمنوا لا يسخر قوم من قوم عسى أن يكونوا خيرا منهم ولا نساء من نساء عسى أن يكن خيرا منهن»} [\"O you who believe, let not a people deride a people; perhaps they may be better than them. Nor let women deride women; perhaps they may be better than them\"] (Q. 49:11). The meaning of mockery (al-sukhriyyah) is contempt, belittlement, and drawing attention to faults and defects in a manner that causes laughter at the person. This may occur through imitation in action and speech, and it may occur through gesture and indication. And if it occurs in the presence of the one being mocked, it is not called backbiting (ghībah), yet it contains the meaning of backbiting.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 673", "section_title_en": "The Revival of the Religious Sciences — Section 673: The Eleventh Affliction: Mockery and Derision", "section_index": 673, "anchors": "- Root: سخر (s-kh-r)\n  * Lisan / Ayn: Core meaning of subjugation and forced employment; also derision and making a mockery of someone.\n  * Al-Raghib (Mufradat): \"التسخير: سياقة إلى الغرض المختص قهرا\" — driving toward a specific purpose by compulsion. The theological nuance here shifts to the passive form (سُخِرَ) and the verbal noun (سخرية) denoting the act of holding another in contempt and compelling them into a position of ridicule.\n  * Al-Zamakhshari (Asas): Haqiqah (Literal): \"فلان سخرة سخرة: يضحك منه الناس\" — one whom people laugh at. Majaz (Metaphorical): The root's use for subjugated service (as in \"سخر الله لك\") is distinct from this interpersonal derision, which is the literal sense intended here.\n- Root: ضحك (ḍ-ḥ-k)\n  * Lisan / Ayn: Physical laughter with the baring of teeth; the molars are called الضواحك.\n  * Al-Raghib (Mufradat): \"الضحك: انبساط الوجه وتكشر الأسنان من سرور النفس\" — expansion of the face and baring of teeth from delight of the soul. He explicitly notes: \"واستعير الضحك للسخرية\" — laughter is metaphorically extended to mockery, as in \"ضحكت منه\" (I laughed at him). This metaphorical extension is precisely the mechanism of the sin discussed here.\n  * Al-Zamakhshari (Asas): Haqiqah: \"افتر عن ضاحكته\" — smiling broadly. Majaz: \"ضحكت الأرض عن النبات\" — the earth \"laughs\" forth vegetation. The distinction is critical: the physical act of laughing (haqiqah) becomes blameworthy mockery (majaz) when directed at another's defects.\n- Root: هلم (h-l-m)\n  * Al-Raghib (Mufradat): \"هلم دعاء إلى الشيء\" — a call toward something. Derived from \"ها لم\" (come, repair to) or \"هل أم\" (is there intent?). It is an imperative summons.\n  * Lisan al-Arab: \"لأَن الهاء زائدة، وأَصله هالُمّ\" — the ha is augmentative; the root is l-m-m (to repair, to mend).\n- Root: وقد (w-q-d)\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed. The verbal noun وقود refers both to fuel and to the resulting flame.\n  * Al-Zamakhshari (Asas): Haqiqah: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire ignited and blazed. Majaz: \"قلب وقاد\" — a blazing heart (for intelligence). The imagery of a door opening to the scorner, who approaches \"بكربه وغمه\" (with his distress and grief), evokes this root's sense of burning anguish.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The prohibition is restricted by the conditional clause \"مهما كان مؤذيا\" (whenever it is harmful), and the focus is sharpened by the Quranic address \"يا أيها الذين آمنوا\" which restricts the address to believers, making the prohibition binding upon them specifically.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Anger and Hatred'", "badge": "Afterlife"}], "50": [{"arabic": "فقال وما هو قال إياك والكبر فإنه أول ذنب عصي الله به ثم قرأ {وإذ قلنا للملائكة اسجدوا لآدم فسجدوا إلا إبليس} الآية وإياك والحرص فإنه أخرج آدم من الجنة أمكنه الله سبحانه من جنة عرضها السموات والأرض يأكل منها إلا شجرة واحدة نهاه الله عنها فأكل منها فأخرجه الله تعالى منها ثم قال {اهبطوا منها} إلى آخر الآية وإياك والحسد فإنما قتل ابن آدم أخاه حين حسده ثم قرأ {واتل عليهم نبأ ابني آدم بالحق} الآيات وإذا ذكر أصحاب رسول الله صلى الله عليه وسلم فأمسك وإذا ذكر القدر فاسكت وإذا ذكرت النجوم فاسكت وقال بكر بن عبد الله كان رجل يغشى بعض الملوك فيقوم بحذاء الملك ف", "english": "Know that envy (ḥasad) is likewise among the fruits of rancor (ḥiqd), and rancor is among the fruits of anger (ghaḍab) — so envy is a branch of a branch, while anger is the root of the root. Then envy has, among its blameworthy branches, that which can scarcely be enumerated. And there have come down, specifically in condemnation of envy, many reports (akhbār). The Messenger of God, may God bless him and grant him peace, said: {«Envy consumes good deeds just as fire consumes wood»} (1). The ḥadīth: {«Do not cut one another off, nor turn your backs on one another, nor hate one another»} — agreed upon (muttafaq ʿalayh), and it has already preceded. (2) The ḥadīth of Anas: \"We were sitting one day with the Messenger of God, may God bless him and grant him peace, when he said: 'There will now come upon you from this mountain pass a man from among the people of Paradise'\" — the ḥadīth in its entirety, and in it: that man said, \"I do not find in myself any rancor toward any of the Muslims, nor envy of anyone for the good that God has given him.\" Narrated by Aḥmad with a sound chain (isnād) upon the condition of the two Shaykhs (al-Bukhārī and Muslim), and narrated by al-Bazzār, and the man was named in one of its narrations as Saʿd — though in it there is Ibn Lahīʿah. (3) The ḥadīth: {«Three things from which no one escapes: suspicion, slander, and envy»} — and in another narration: \"And few are those who escape them.\" It was related by Ibn Abī al-Dunyā in his book \"Dhamm al-Ḥasad\" (The Condemnation of Envy) from the ḥadīth of Abū Hurayrah — though in its chain there are Yaʿqūb ibn Muḥammad al-Zuhrī and Mūsā ibn Yaʿqūb al-Zamaʿī, both of whom the majority of scholars have declared weak. The second narration was also related by Ibn Abī al-Dunyā from the narration of ʿAbd al-Raḥmān ibn Muʿāwiyah, and it is mursal (broken chain) and weak. Al-Ṭabarānī has something similar from the ḥadīth of Ḥārithah ibn al-Nuʿmān, and it has already preceded in the section on the afflictions of the tongue. And in one narration: {«Three things from which no one escapes — and few are those who escape them»} — so this narration affirms the possibility of deliverance. And he, may God bless him and grant him peace, said: {«There has crept upon you the disease of the nations before you: envy and hatred. And hatred is the clipper — I do not say it clips the hair, but rather it clips the religion. By Him in whose hand is the soul of Muḥammad, you shall not enter Paradise until you believe, and you shall not believe until you love one another. Shall I not inform you of that which will establish this for you? Spread peace (salām) among you»} (4). And he, may God bless him and grant him peace, said: {«Poverty almost becomes unbelief, and envy almost overcomes destiny (qadar)»} (5). And he, may God bless him and grant him peace, said: {«Indeed, my community will be afflicted with the disease of the nations.» They said: \"And what is the disease of the nations?\" He said: {«Extravagance, arrogance, accumulation, rivalry in worldly things, mutual distance, and mutual envy — until transgression (baghy) comes, and then destruction (harj)»} (6). And he, may God bless him and grant him peace, said: {«Do not show gloating (shamātah) over your brother, lest God heal him and afflict you»} (7). And it is narrated that Moses, peace be upon him, when he hastened to his Lord, Exalted is He, saw a man in the shade of the Throne (ʿArsh) and envied him his station (ghabaṭahu), saying: \"This one is honored before his Lord.\" So he asked his Lord, Exalted is He, to inform him of his name, but He did not inform him, and said: \"I shall tell you of three of his deeds: he did not envy people for what God had given them of His bounty, he was not undutiful to his parents, and he did not go about with slander (namīmah).\" And Zechariah, peace be upon him, said: God, Exalted is He, said: {«The envier is an enemy of My blessing, resentful of My decree, dissatisfied with My apportioning which I have apportioned among My servants»}. And he, may God bless him and grant him peace, said: {«The thing I most fear for my community is that wealth will increase among them, and they will envy one another and fight one another»} (1). And he, may God bless him and grant him peace, said: {«Seek help in fulfilling your needs by keeping them secret, for everyone who possesses a blessing is envied»} (2). And he, may God bless him and grant him peace, said: {«Indeed, the blessings of God have enemies.» It was said: \"And who are they?\" He said: {«Those who envy people for what God has given them of His bounty»} (3). The ḥadīth: {«Six will enter the Fire before the Reckoning by a year.» It was said: \"O Messenger of God, who are they?\" He said: {«The unjust rulers»} — the ḥadīth — and in it: {«And the scholars who envy»}. Narrated by Abū Manṣūr al-Daylamī from the ḥadīth of Ibn ʿUmar and Anas with two weak chains of transmission.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 718", "section_title_en": "Section 718 — On Envy (Ḥasad): Its Roots, Branches, and Blameworthy Fruits", "section_index": 718, "anchors": "- Root: حسد (Ḥ-S-D)\n  * Lisan / Ayn: Core meaning of wishing for removal of a blessing from its possessor, rooted in spite and resentment.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — Envy is the desire for the removal of a blessing from one who rightly deserves it, sometimes accompanied by active striving to effect its removal. The believer envies not, but the hypocrite does.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسده على نعمة الله\" — to envy him for God's blessing. Metaphorical (majāz): \"إن الحسد يأكل الجسد\" — envy consumes the body, as fire consumes wood, indicating its destructive spiritual effect.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: Origination after non-existence; bringing into being after nothingness.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination is a thing's coming to be after it was not. The ḥadīth (report) is so-called for its temporal proximity to the event it narrates.\n  * Al-Zamakhshari (Asas): Literal: \"هو حدث من الأحداث\" — he is a youth among youths. Metaphorical: \"صاروا أحاديث\" — they became subjects of talk, indicating fame or infamy spread by tongues.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereignty; the one who possesses and disposes.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي\" — dominion is disposal by command and prohibition. Two kinds: actual possession/sovereignty, and the power/capacity to exercise it.\n  * Al-Zamakhshari (Asas): Literal: \"ملكت فلانة\" — he married her (possessed her in wedlock). Metaphorical: \"ملك نفسه عند الغضب\" — he mastered himself at the moment of anger, i.e., self-restraint.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the Prophet (ﷺ) says \"إنما قتل ابن آدم أخاه حين حسده\" (It was only envy that led the son of Adam to kill his brother), the restrictive particle إنما confines the cause of the first murder to envy alone, isolating it as the sole efficient cause of that primordial transgression.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "54": [{"arabic": "فسمعته وهو منصرف يضرب فخذه ويقول وكان الإنسان أكثر شيء جدلا (8) ثم ينبغي أن يشتغل بعد ركعتي الفجر ودعائه بالاستغفار والتسبيح إلى أن تقام الصلاة فيقول أستغفر الله الذي لا إله إلا هو الحي القيوم وأتوب إليه سبعين مرة", "english": "I say: We have already mentioned these matters in the Book of Purification (Kitāb al-Ṭahārah) concerning entering and exiting [the lavatory]. Then one uses the tooth-stick (siwāk) according to the Sunnah, as has preceded, and performs the ablution (wuḍūʾ), observing all the Sunnahs and supplications which we have mentioned in the Book of Purification — for we have only presented the individual acts of worship individually so that in this Book we might mention only the manner of their combination and arrangement. When he has finished his ablution, he prays the two rakʿahs of the dawn [i.e., the Sunnah of Fajr] in his house — for thus did the Messenger of Allah ﷺ do — and he recites after the two rakʿahs, whether he performs them in the house or in the mosque, the supplication narrated by Ibn ʿAbbās (may Allah be pleased with them both), saying: \"O Allah, I ask You for mercy from Your presence, by which You may guide my heart...\" — to the end of the supplication.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 259", "section_title_en": "The Morning Rituals of the Prophet ﷺ — From Waking to the Mosque", "section_index": 259, "anchors": "- Root: سواك (Siwāk)\n  * Lisan / Ayn: Cleansing and rubbing the teeth with a tooth-stick\n  * Al-Raghib (Mufradat): Purification of the mouth — an act pleasing to the Lord\n  * Al-Zamakhshari (Asas): Literal — physical cleansing of the teeth; established as Sunnah of ablution\n- Root: غلس (Ghalas)\n  * Lisan / Ayn: The darkness of the last part of the night before dawn\n  * Al-Zamakhshari (Asas): Literal — performing the dawn prayer in the early darkness; Metaphorical — doing something in concealment\n- Root: خطو (Khatw)\n  * Lisan / Ayn: A single step — the distance between the two feet in walking\n  * Al-Raghib (Mufradat): The act of moving from one place to another\n  * Al-Zamakhshari (Asas): Literal — walking with measured steps\n- Root: عتم (ʿAtam)\n  * Lisan / Ayn: The darkness of night; the ʿAtamah prayer is the ʿIshāʾ (night) prayer\n  * Al-Zamakhshari (Asas): Literal — the first third of the night after the disappearance of the twilight\n- Root: حجج (Ḥajj)\n  * Lisan / Ayn: The pilgrimage; a \"Ḥajjah mabrūrah\" — an accepted pilgrimage\n  * Al-Raghib (Mufradat): Ḥajj is intent/course toward a goal; mabrūrah — accepted, untainted by sin\n  * Al-Zamakhshari (Asas): Literal — an accepted pilgrimage; God \"accepts\" (yaburru) the ḥajj\n- Root: عمر (ʿUmr)\n  * Lisan / Ayn: The ʿUmrah — the visitation; iʿtamara — to visit\n  * Al-Raghib (Mufradat): The ʿUmrah — the intended visitation for worship\n  * Al-Zamakhshari (Asas): Literal — intending the House for worship; a \"ʿUmrah mabrūrah\" — an accepted one\n- Root: سبح (Sabbaḥa)\n  * Lisan / Ayn: Declaring God's transcendence above all evil; the \"subḥah\" — the act of glorification\n  * Al-Raghib (Mufradat): Declaring God's transcendence by speech, realized through the heart\n  * Al-Zamakhshari (Asas): Literal — glorifying God; also used for performing prayer\n- Root: قوم (Qawm)\n  * Lisan / Ayn: Al-Qayyūm — the One who undertakes the governance of His creation\n  * Al-Raghib (Mufradat): Al-Qayyūm — the Self-Subsisting who sustains all else; among the most specific Names of God\n  * Al-Zamakhshari (Asas): Literal — the One who undertakes the governance of all affairs\n- Sibawayh Rule: The Fā' of Sequential Order (فاء الترتيب والتعقيب) — governing the ordered sequence of ritual actions where each act follows its predecessor in immediate succession, as in the description of the Prophet's ﷺ morning worship.\n\n---", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}], "65": [{"arabic": "الإشارة بقوله تعالى {وعلمناه من لدنا علما} مع أن كل علم من لدنه ولكن بعضها بوسائط تعليم الخلق فلا يسمى ذلك علما لدنيا بل اللدني الذي ينفتح في سر القلب من غير سبب مألوف من خارج فهذه شواهد النقل ولو جمع كل ما ورد فيه من الآيات والأخبار والآثار لخرج عن الحصر وأما مشاهدة ذلك بالتجارب فذلك أيضا خارج عن الحصر وظهر ذلك على الصحابة والتابعين ومن بعدهم وقال أبو بكر الصديق رضي الله عنه لعائشة رضي الله عنها عند موته إنما هما أخواك وأختاك وكانت زوجته حاملا فولدت بنتا فكان", "english": "As for the evidences of the Sacred Law, there is His saying (Exalted is He): {«وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا»} (\"And those who strive in Us, We shall surely guide them to Our paths\") (Q. 29:69). So every wisdom that appears from the heart through persevering devotion to worship, without learning, is by way of unveiling and inspiration. And he (peace and blessings be upon him) said: \"Whoever acts upon what he knows, God bequeaths to him knowledge of what he does not know, and grants him success in what he does\" — until he becomes deserving of Paradise. And whoever does not act upon what he knows wanders astray in what he knows and is not granted success in what he does, until he becomes deserving of the Fire. [The hadith \"Whoever acts upon what he knows\" has preceded in the Book of Knowledge, without his saying \"and grants him success in what he does\" — I have not found it with that addition.] And God (Exalted is He) said: {«وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا»} (\"And whoever fears God, He makes for him a way out\") (Q. 65:2) — from perplexities and doubts — {«وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ»} (\"and provides for him from whence he does not reckon\") (Q. 65:3) — teaching him knowledge without learning and granting him discernment without experience. And God (Exalted is He) said: {«يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا»} (\"O you who believe, if you fear God, He will make for you a criterion\") (Q. 8:29) — it is said: a light by which one distinguishes between truth and falsehood and by which one emerges from doubts. For this reason, he (peace and blessings be upon him) was abundant in his supplication in asking for light, saying (peace and blessings be upon him): \"O God, grant me light, and increase me in light, and make for me light in my heart, and light in my grave, and light in my hearing, and light in my sight\" — until he said: \"and light in my hair, and in my skin, and in my flesh, and in my blood, and in my bones.\" [Agreed upon (by al-Bukhari and Muslim).] [The hadith concerning his being asked about His saying {«أَفَمَنْ شَرَحَ اللَّهُ صَدْرَهُ لِلْإِسْلَامِ»} (\"Is he whose breast God has expanded for Islam\") (Q. 39:22) — and in al-Mustadrak from the hadith of Ibn Masʿūd — has preceded in the Book of Knowledge.] And he (peace and blessings be upon him) said concerning Ibn ʿAbbās: \"O God, grant him understanding in religion and teach him the interpretation (taʾwīl).\" [The hadith of ʿAlī: \"We have nothing with us that the Messenger of God (peace and blessings be upon him) confided to us except that God grants a servant understanding in His Book\" — has preceded in the Etiquettes of Qurʾanic Recitation.] And it is said in the interpretation of His saying (Exalted is He): {«يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ»} (\"He grants wisdom to whom He wills\") (Q. 2:269) that it is understanding in the Book of God. And He (Exalted is He) said: {«فَفَهَّمْنَاهَا سُلَيْمَانَ»} (\"And We made Solomon understand it\") (Q. 21:79) — singling out what was unveiled with the name of understanding (fahm). And Abū al-Dardāʾ used to say: \"The believer is one who sees by the light of God from behind a thin veil. By God, it is the truth that God casts into their hearts and causes to flow upon their tongues.\" And some of the Salaf said: \"The believer's conjecture is like soothsaying.\"", "book_title": "Disciplining the Soul", "section_title_ar": "Section 594", "section_title_en": "The Unveiling of Knowledge Through Divine Inspiration and the Evidences of the Unseen", "section_index": 594, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning encompasses both perception of a thing's essence and judgment upon it—knowledge as direct apprehension or discursive ruling.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence (transitive to one object) and judgment upon existence or non-existence (transitive to two objects).\n  * Al-Zamakhshari (Asas): Literal usage denotes certainty and awareness (\"ما علمت بخبرك: ما شعرت به\"); metaphorical extension applies to marks, signs, and beacons of guidance (معالم الطريق) — here, the inspired knowledge is a \"mark\" of the path.\n- Root: كشف (kashafa)\n  * Lisan / Ayn: To remove a covering, unveil, disclose what was hidden.\n  * Al-Raghib (Mufradat): Unveiling (kashf) in theological terms is the removal of the veil (ghishāwah) from the heart such that the realities of things become directly witnessed, not merely inferred.\n  * Al-Zamakhshari (Asas): Literal: to lift a covering from a thing; metaphorical: the disclosure of inward states and hidden matters — the heart's eye perceives what the outward senses cannot.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, devour; farāsah — the lion's pouncing upon its prey.\n  * Al-Raghib (Mufradat): Discernment (farāsah) is a spiritual perception by which the believer penetrates into the inner states of others, a light cast by God into the heart.\n  * Al-Zamakhshari (Asas): Literal: the beast of prey seizing its quarry; metaphorical: the believer's insight seizing the truth of a matter or the hidden state of a person — \"اتقوا فراسة المؤمن فإنه ينظر بنور الله.\"\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: To be new, originate after non-existence; muḥaddath — one who is spoken to, inspired with true speech from the unseen.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence; the muḥaddath is one to whom divine inspiration comes as a new, immediate occurrence without acquired means.\n  * Al-Zamakhshari (Asas): Literal: newness of a thing; metaphorical: \"كان عمر رضي الله عنه محدثا أي صادق الحدس، كأنما حدث بما ظن\" — one whose intuition is so true it is as if he were directly spoken to.\n- Sibawayh Rule: Restriction and specification (الحصر والتقييد) — the particle \"إنما\" and conditional clauses (إن/إذا) restrict predicates to their subjects, as in \"إنما العالم الذي يأخذ علمه من ربه\" — the true scholar is exclusively the one who takes knowledge from his Lord.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "67": [{"arabic": "نبه الله تعالى بقصة الخضر وموسى عليهما السلام حيث قال الخضر {إنك لن تستطيع معي صبرا وكيف تصبر على ما لم تحط به خبرا} ثم شرط عليه السكوت والتسليم فقال {فإن اتبعتني فلا تسألني عن شيء حتى أحدث لك منه ذكرا} ثم لم يصبر ولم يزل في مراودته إلى أن كان ذلك سبب الفراق بينهما وبالجملة كل متعلم استبقى لنفسه رأيا واختيارا دون اختيار المعلم فاحكم عليه بالإخفاق والخسران فإن قلت فقد قال الله تعالى {فاسألوا أهل الذكر إن كنتم لا تعلمون} فالسؤال مأمور به فاعلم أنه كذلك ولكن فيما يأذن المعلم في السؤال عنه فإن السؤال عما لم تبلغ مرتبتك إل", "english": "I say: Knowledge is like a torrent that is hostile to the elevated place — it flows only to the low ground. Thus knowledge is not attained except through humility and the casting of one's hearing [in attentive submission]. God — exalted is He — said: {«Indeed in that is a reminder for whoever has a heart or casts his hearing while present as a witness»} (Q 50:37). And the meaning of his being \"one having a heart\" is that he should be receptive to knowledge, comprehending it. But then the capacity for understanding does not avail him until he casts his hearing while being a present witness — present of heart — so that he may receive everything that is cast to him with excellence of listening, supplication, gratitude, joy, and acceptance of the benefaction.", "book_title": "Book of Knowledge", "section_title_ar": "Section 42", "section_title_en": "The Revival of the Religious Sciences — Book I, Section 42: On the Duties of the Student (Ādāb al-Mutaʿallim)", "section_index": 42, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core meaning of knowing, perceiving a thing in its reality; the mark, trace, or sign by which one is guided.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge. Metaphorical (majāz): \"خفيت معالم الطريق\" — the waymarks of the road are hidden, i.e., the traces by which one is guided.\n- Root: س م ع (s-m-ʿ)\n  * Lisan / Ayn: Hearing, listening; the ear; obedience and acceptance.\n  * Al-Raghib (Mufradat): Hearing with attentive presence of heart, not merely the physical sensation of sound.\n  * Al-Zamakhshari (Asas): Literal: auditory perception. Metaphorical: \"ألقى السمع\" — to cast one's hearing, i.e., to listen with full attentiveness and submission.\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: The heart; to turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning of a thing from one face to another; the heart as that which is ever-turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises means.\n- Root: ب ح ر (b-ḥ-r)\n  * Lisan / Ayn: The sea; vast expanse of water.\n  * Al-Raghib (Mufradat): \"أصل البحر: كل مكان واسع جامع للماء الكثير\" — the sea is every vast place gathering much water; then metaphorically applied to one who expands deeply into a domain.\n  * Al-Zamakhshari (Asas): Metaphorical: \"تبحر في العلم واستبحر فيه\" — he plunged deep into knowledge and expanded therein like a sea.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Focused Predication) — the particle innamā restricts the predicate to the subject alone, negating all else; applied here to the exclusive path of the student's submission to the teacher's direction.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "68": [{"arabic": "تستطيع معي صبرا وكيف تصبر على ما لم تحط به خبرا} ثم شرط عليه السكوت والتسليم فقال {فإن اتبعتني فلا تسألني عن شيء حتى أحدث لك منه ذكرا} ثم لم يصبر ولم يزل في مراودته إلى أن كان ذلك سبب الفراق بينهما وبالجملة كل متعلم استبقى لنفسه رأيا واختيارا دون اختيار المعلم فاحكم عليه بالإخفاق والخسران فإن قلت فقد قال الله تعالى {فاسألوا أهل الذكر إن كنتم لا تعلمون} فالسؤال مأمور به فاعلم أنه كذلك ولكن فيما يأذن المعلم في السؤال عنه فإن السؤال عما لم تبلغ مرتبتك إلى فهمه مذموم ولذلك منع الخضر مو", "english": "I say: Knowledge is like a torrent that is hostile to the elevated place — it flows only to the low ground. Thus knowledge is not attained except through humility and the casting of one's hearing [in attentive submission]. God — exalted is He — said: {«Indeed in that is a reminder for whoever has a heart or casts his hearing while present as a witness»} (Q 50:37). And the meaning of his being \"one having a heart\" is that he should be receptive to knowledge, comprehending it. But then the capacity for understanding does not avail him until he casts his hearing while being a present witness — present of heart — so that he may receive everything that is cast to him with excellence of listening, supplication, gratitude, joy, and acceptance of the benefaction.", "book_title": "Book of Knowledge", "section_title_ar": "Section 42", "section_title_en": "The Revival of the Religious Sciences — Book I, Section 42: On the Duties of the Student (Ādāb al-Mutaʿallim)", "section_index": 42, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core meaning of knowing, perceiving a thing in its reality; the mark, trace, or sign by which one is guided.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge. Metaphorical (majāz): \"خفيت معالم الطريق\" — the waymarks of the road are hidden, i.e., the traces by which one is guided.\n- Root: س م ع (s-m-ʿ)\n  * Lisan / Ayn: Hearing, listening; the ear; obedience and acceptance.\n  * Al-Raghib (Mufradat): Hearing with attentive presence of heart, not merely the physical sensation of sound.\n  * Al-Zamakhshari (Asas): Literal: auditory perception. Metaphorical: \"ألقى السمع\" — to cast one's hearing, i.e., to listen with full attentiveness and submission.\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: The heart; to turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning of a thing from one face to another; the heart as that which is ever-turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises means.\n- Root: ب ح ر (b-ḥ-r)\n  * Lisan / Ayn: The sea; vast expanse of water.\n  * Al-Raghib (Mufradat): \"أصل البحر: كل مكان واسع جامع للماء الكثير\" — the sea is every vast place gathering much water; then metaphorically applied to one who expands deeply into a domain.\n  * Al-Zamakhshari (Asas): Metaphorical: \"تبحر في العلم واستبحر فيه\" — he plunged deep into knowledge and expanded therein like a sea.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Focused Predication) — the particle innamā restricts the predicate to the subject alone, negating all else; applied here to the exclusive path of the student's submission to the teacher's direction.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "70": [{"arabic": "والتسليم فقال {فإن اتبعتني فلا تسألني عن شيء حتى أحدث لك منه ذكرا} ثم لم يصبر ولم يزل في مراودته إلى أن كان ذلك سبب الفراق بينهما وبالجملة كل متعلم استبقى لنفسه رأيا واختيارا دون اختيار المعلم فاحكم عليه بالإخفاق والخسران فإن قلت فقد قال الله تعالى {فاسألوا أهل الذكر إن كنتم لا تعلمون} فالسؤال مأمور به فاعلم أنه كذلك ولكن فيما يأذن المعلم في السؤال عنه فإن السؤال عما لم تبلغ مرتبتك إلى فهمه مذموم ولذلك منع الخضر موسى عليه السلام من السؤال أي دع السؤال قبل أوانه فالمعلم أعلم بما أنت أهل له وبأوان الك", "english": "I say: Knowledge is like a torrent that is hostile to the elevated place — it flows only to the low ground. Thus knowledge is not attained except through humility and the casting of one's hearing [in attentive submission]. God — exalted is He — said: {«Indeed in that is a reminder for whoever has a heart or casts his hearing while present as a witness»} (Q 50:37). And the meaning of his being \"one having a heart\" is that he should be receptive to knowledge, comprehending it. But then the capacity for understanding does not avail him until he casts his hearing while being a present witness — present of heart — so that he may receive everything that is cast to him with excellence of listening, supplication, gratitude, joy, and acceptance of the benefaction.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 42", "section_title_en": "The Revival of the Religious Sciences — Book I, Section 42: On the Duties of the Student (Ādāb al-Mutaʿallim)", "section_index": 42, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core meaning of knowing, perceiving a thing in its reality; the mark, trace, or sign by which one is guided.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge. Metaphorical (majāz): \"خفيت معالم الطريق\" — the waymarks of the road are hidden, i.e., the traces by which one is guided.\n- Root: س م ع (s-m-ʿ)\n  * Lisan / Ayn: Hearing, listening; the ear; obedience and acceptance.\n  * Al-Raghib (Mufradat): Hearing with attentive presence of heart, not merely the physical sensation of sound.\n  * Al-Zamakhshari (Asas): Literal: auditory perception. Metaphorical: \"ألقى السمع\" — to cast one's hearing, i.e., to listen with full attentiveness and submission.\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: The heart; to turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning of a thing from one face to another; the heart as that which is ever-turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises means.\n- Root: ب ح ر (b-ḥ-r)\n  * Lisan / Ayn: The sea; vast expanse of water.\n  * Al-Raghib (Mufradat): \"أصل البحر: كل مكان واسع جامع للماء الكثير\" — the sea is every vast place gathering much water; then metaphorically applied to one who expands deeply into a domain.\n  * Al-Zamakhshari (Asas): Metaphorical: \"تبحر في العلم واستبحر فيه\" — he plunged deep into knowledge and expanded therein like a sea.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Focused Predication) — the particle innamā restricts the predicate to the subject alone, negating all else; applied here to the exclusive path of the student's submission to the teacher's direction.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Anger and Hatred'", "badge": "Insight"}], "72": [{"arabic": "نبه الله تعالى بقصة الخضر وموسى عليهما السلام حيث قال الخضر {إنك لن تستطيع معي صبرا وكيف تصبر على ما لم تحط به خبرا} ثم شرط عليه السكوت والتسليم فقال {فإن اتبعتني فلا تسألني عن شيء حتى أحدث لك منه ذكرا} ثم لم يصبر ولم يزل في مراودته إلى أن كان ذلك سبب الفراق بينهما وبالجملة كل متعلم استبقى لنفسه رأيا واختيارا دون اختيار المعلم فاحكم عليه بالإخفاق والخسران فإن قلت فقد قال الله تعالى {فاسألوا أهل الذكر إن كنتم لا تعلمون} فالسؤال مأمور به فاعلم أنه كذلك ولكن فيما يأذن المعلم في السؤال عنه فإن السؤال عما لم تبلغ مرتبتك إل", "english": "I say: Knowledge is like a torrent that is hostile to the elevated place — it flows only to the low ground. Thus knowledge is not attained except through humility and the casting of one's hearing [in attentive submission]. God — exalted is He — said: {«Indeed in that is a reminder for whoever has a heart or casts his hearing while present as a witness»} (Q 50:37). And the meaning of his being \"one having a heart\" is that he should be receptive to knowledge, comprehending it. But then the capacity for understanding does not avail him until he casts his hearing while being a present witness — present of heart — so that he may receive everything that is cast to him with excellence of listening, supplication, gratitude, joy, and acceptance of the benefaction.", "book_title": "Book of Knowledge", "section_title_ar": "Section 42", "section_title_en": "The Revival of the Religious Sciences — Book I, Section 42: On the Duties of the Student (Ādāb al-Mutaʿallim)", "section_index": 42, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core meaning of knowing, perceiving a thing in its reality; the mark, trace, or sign by which one is guided.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge. Metaphorical (majāz): \"خفيت معالم الطريق\" — the waymarks of the road are hidden, i.e., the traces by which one is guided.\n- Root: س م ع (s-m-ʿ)\n  * Lisan / Ayn: Hearing, listening; the ear; obedience and acceptance.\n  * Al-Raghib (Mufradat): Hearing with attentive presence of heart, not merely the physical sensation of sound.\n  * Al-Zamakhshari (Asas): Literal: auditory perception. Metaphorical: \"ألقى السمع\" — to cast one's hearing, i.e., to listen with full attentiveness and submission.\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: The heart; to turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning of a thing from one face to another; the heart as that which is ever-turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises means.\n- Root: ب ح ر (b-ḥ-r)\n  * Lisan / Ayn: The sea; vast expanse of water.\n  * Al-Raghib (Mufradat): \"أصل البحر: كل مكان واسع جامع للماء الكثير\" — the sea is every vast place gathering much water; then metaphorically applied to one who expands deeply into a domain.\n  * Al-Zamakhshari (Asas): Metaphorical: \"تبحر في العلم واستبحر فيه\" — he plunged deep into knowledge and expanded therein like a sea.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Focused Predication) — the particle innamā restricts the predicate to the subject alone, negating all else; applied here to the exclusive path of the student's submission to the teacher's direction.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "73": [{"arabic": "فلما سأل عن السفينة أنكر عليه حتى اعتذر وقال {لا تؤاخذني بما نسيت ولا ترهقني من أمري عسرا} فلم يصبر حتى سأل ثلاثا قال {هذا فراق بيني وبينك} وفارقه فسؤال العوام عن غوامض الدين من أعظم الآفات وهو من المثيرات للفتن فيجب قمعهم ومنعهم من ذلك وخوضهم في حروف القرآن يضاهي حال من كتب الملك إليه كتابا ورسم له فيه أمورا فلم يشتغل بشيء منها وضيع زمانه في أن قرطاس الكتاب عتيق أم حديث فاستحق بذلك العقوبة لا محالة فكذلك تضييع العامي حدود القرآن واشتغاله بحروفه أهي قديمة أم حديثة وكذلك سائر صفات الله سبحانه وتعالى والله تعالى أعلم", "english": "Whoever asks concerning an obscure science (ʿilm ghāmiḍ) while his understanding has not reached that degree is blameworthy, for relative to that [science] he is a common man. For this reason, the Prophet, peace and blessings be upon him, said: \"Leave me as I have left you, for those before you were destroyed only by their excessive questioning and their differing with their prophets. What I have forbidden you, avoid; and what I have commanded you, do of it what you are able.\" {«ذروني ما تركتكم فإنما هلك من كان قبلكم بكثرة سؤالهم واختلافهم على أنبيائهم ما نهيتكم عنه فاجتنبوه وما أمرتكم به فأتوا منه ما استطعتم»} (1)", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 699", "section_title_en": "The Twentieth Affliction: The Questioning of the Common Folk Concerning the Attributes of God and His Speech", "section_index": 699, "anchors": "- Root: س-أ-ل (sa-ʾa-la)\n  * Lisan / Ayn: The act of asking, inquiring, or seeking information; its core sense involves a request directed toward another.\n  * Al-Raghib (Mufradat): In theological discourse, questioning (suʾāl) about divine matters without proper preparation or station is blameworthy, as it exceeds the bounds of what the questioner is obligated to know and ventures into what is not his concern.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) questioning seeks permissible knowledge; metaphorical (majāz) usage extends to the \"questioning\" of fate or the soul's improper probing into hidden matters, which is censured.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Prophet's command {«ذروني ما تركتكم»} uses restriction to delimit the sphere of permissible inquiry, confining it to what the Lawgiver has addressed.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'", "badge": "Hadith"}], "75": [{"arabic": "قصدني سبع فخرج وصاح به وقال ألم أقل لك لا تتعرض لضيفاني فتنحى الأسد فتطهرت فلما رجعت قال لي اشتغلتم بتقويم الظاهر فخفتم الأسد واشتغلنا بتقويم البواطن فخافنا الأسد وما حكي من تفرس المشايخ وإخبارهم عن اعتقادات الناس وضمائرهم يخرج عن الحصر بل ما حكي عنهم من مشاهدة الخضر عليه السلام والسؤال منه ومن سماع صوت الهاتف ومن فنون الكرامات خارج عن الحصر والحكاية لا تنفع الجاحد ما لم يشاهد ذلك من نفسه ومن أنكر الأصل أنكر التفصيل والدليل القاطع الذي لا يقدر أحد على جحده أمران أحدهما عجائب الرؤي", "english": "As for the evidences of the Sacred Law, there is His saying (Exalted is He): {«وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا»} (\"And those who strive in Us, We shall surely guide them to Our paths\") (Q. 29:69). So every wisdom that appears from the heart through persevering devotion to worship, without learning, is by way of unveiling and inspiration. And he (peace and blessings be upon him) said: \"Whoever acts upon what he knows, God bequeaths to him knowledge of what he does not know, and grants him success in what he does\" — until he becomes deserving of Paradise. And whoever does not act upon what he knows wanders astray in what he knows and is not granted success in what he does, until he becomes deserving of the Fire. [The hadith \"Whoever acts upon what he knows\" has preceded in the Book of Knowledge, without his saying \"and grants him success in what he does\" — I have not found it with that addition.] And God (Exalted is He) said: {«وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا»} (\"And whoever fears God, He makes for him a way out\") (Q. 65:2) — from perplexities and doubts — {«وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ»} (\"and provides for him from whence he does not reckon\") (Q. 65:3) — teaching him knowledge without learning and granting him discernment without experience. And God (Exalted is He) said: {«يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا»} (\"O you who believe, if you fear God, He will make for you a criterion\") (Q. 8:29) — it is said: a light by which one distinguishes between truth and falsehood and by which one emerges from doubts. For this reason, he (peace and blessings be upon him) was abundant in his supplication in asking for light, saying (peace and blessings be upon him): \"O God, grant me light, and increase me in light, and make for me light in my heart, and light in my grave, and light in my hearing, and light in my sight\" — until he said: \"and light in my hair, and in my skin, and in my flesh, and in my blood, and in my bones.\" [Agreed upon (by al-Bukhari and Muslim).] [The hadith concerning his being asked about His saying {«أَفَمَنْ شَرَحَ اللَّهُ صَدْرَهُ لِلْإِسْلَامِ»} (\"Is he whose breast God has expanded for Islam\") (Q. 39:22) — and in al-Mustadrak from the hadith of Ibn Masʿūd — has preceded in the Book of Knowledge.] And he (peace and blessings be upon him) said concerning Ibn ʿAbbās: \"O God, grant him understanding in religion and teach him the interpretation (taʾwīl).\" [The hadith of ʿAlī: \"We have nothing with us that the Messenger of God (peace and blessings be upon him) confided to us except that God grants a servant understanding in His Book\" — has preceded in the Etiquettes of Qurʾanic Recitation.] And it is said in the interpretation of His saying (Exalted is He): {«يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ»} (\"He grants wisdom to whom He wills\") (Q. 2:269) that it is understanding in the Book of God. And He (Exalted is He) said: {«فَفَهَّمْنَاهَا سُلَيْمَانَ»} (\"And We made Solomon understand it\") (Q. 21:79) — singling out what was unveiled with the name of understanding (fahm). And Abū al-Dardāʾ used to say: \"The believer is one who sees by the light of God from behind a thin veil. By God, it is the truth that God casts into their hearts and causes to flow upon their tongues.\" And some of the Salaf said: \"The believer's conjecture is like soothsaying.\"", "book_title": "Disciplining the Soul", "section_title_ar": "Section 594", "section_title_en": "The Unveiling of Knowledge Through Divine Inspiration and the Evidences of the Unseen", "section_index": 594, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning encompasses both perception of a thing's essence and judgment upon it—knowledge as direct apprehension or discursive ruling.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence (transitive to one object) and judgment upon existence or non-existence (transitive to two objects).\n  * Al-Zamakhshari (Asas): Literal usage denotes certainty and awareness (\"ما علمت بخبرك: ما شعرت به\"); metaphorical extension applies to marks, signs, and beacons of guidance (معالم الطريق) — here, the inspired knowledge is a \"mark\" of the path.\n- Root: كشف (kashafa)\n  * Lisan / Ayn: To remove a covering, unveil, disclose what was hidden.\n  * Al-Raghib (Mufradat): Unveiling (kashf) in theological terms is the removal of the veil (ghishāwah) from the heart such that the realities of things become directly witnessed, not merely inferred.\n  * Al-Zamakhshari (Asas): Literal: to lift a covering from a thing; metaphorical: the disclosure of inward states and hidden matters — the heart's eye perceives what the outward senses cannot.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, devour; farāsah — the lion's pouncing upon its prey.\n  * Al-Raghib (Mufradat): Discernment (farāsah) is a spiritual perception by which the believer penetrates into the inner states of others, a light cast by God into the heart.\n  * Al-Zamakhshari (Asas): Literal: the beast of prey seizing its quarry; metaphorical: the believer's insight seizing the truth of a matter or the hidden state of a person — \"اتقوا فراسة المؤمن فإنه ينظر بنور الله.\"\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: To be new, originate after non-existence; muḥaddath — one who is spoken to, inspired with true speech from the unseen.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence; the muḥaddath is one to whom divine inspiration comes as a new, immediate occurrence without acquired means.\n  * Al-Zamakhshari (Asas): Literal: newness of a thing; metaphorical: \"كان عمر رضي الله عنه محدثا أي صادق الحدس، كأنما حدث بما ظن\" — one whose intuition is so true it is as if he were directly spoken to.\n- Sibawayh Rule: Restriction and specification (الحصر والتقييد) — the particle \"إنما\" and conditional clauses (إن/إذا) restrict predicates to their subjects, as in \"إنما العالم الذي يأخذ علمه من ربه\" — the true scholar is exclusively the one who takes knowledge from his Lord.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "نبه الله تعالى بقصة الخضر وموسى عليهما السلام حيث قال الخضر {إنك لن تستطيع معي صبرا وكيف تصبر على ما لم تحط به خبرا} ثم شرط عليه السكوت والتسليم فقال {فإن اتبعتني فلا تسألني عن شيء حتى أحدث لك منه ذكرا} ثم لم يصبر ولم يزل في مراودته إلى أن كان ذلك سبب الفراق بينهما وبالجملة كل متعلم استبقى لنفسه رأيا واختيارا دون اختيار المعلم فاحكم عليه بالإخفاق والخسران فإن قلت فقد قال الله تعالى {فاسألوا أهل الذكر إن كنتم لا تعلمون} فالسؤال مأمور به فاعلم أنه كذلك ولكن فيما يأذن المعلم في السؤال عنه فإن السؤال عما لم تبلغ مرتبتك إل", "english": "I say: Knowledge is like a torrent that is hostile to the elevated place — it flows only to the low ground. Thus knowledge is not attained except through humility and the casting of one's hearing [in attentive submission]. God — exalted is He — said: {«Indeed in that is a reminder for whoever has a heart or casts his hearing while present as a witness»} (Q 50:37). And the meaning of his being \"one having a heart\" is that he should be receptive to knowledge, comprehending it. But then the capacity for understanding does not avail him until he casts his hearing while being a present witness — present of heart — so that he may receive everything that is cast to him with excellence of listening, supplication, gratitude, joy, and acceptance of the benefaction.", "book_title": "Book of Knowledge", "section_title_ar": "Section 42", "section_title_en": "The Revival of the Religious Sciences — Book I, Section 42: On the Duties of the Student (Ādāb al-Mutaʿallim)", "section_index": 42, "anchors": "- Root: ع ل م (ʿ-l-m)\n  * Lisan / Ayn: Core meaning of knowing, perceiving a thing in its reality; the mark, trace, or sign by which one is guided.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon it.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge. Metaphorical (majāz): \"خفيت معالم الطريق\" — the waymarks of the road are hidden, i.e., the traces by which one is guided.\n- Root: س م ع (s-m-ʿ)\n  * Lisan / Ayn: Hearing, listening; the ear; obedience and acceptance.\n  * Al-Raghib (Mufradat): Hearing with attentive presence of heart, not merely the physical sensation of sound.\n  * Al-Zamakhshari (Asas): Literal: auditory perception. Metaphorical: \"ألقى السمع\" — to cast one's hearing, i.e., to listen with full attentiveness and submission.\n- Root: ق ل ب (q-l-b)\n  * Lisan / Ayn: The heart; to turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the turning of a thing from one face to another; the heart as that which is ever-turning between states.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" — to turn a thing from its face. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — a man who turns matters over and devises means.\n- Root: ب ح ر (b-ḥ-r)\n  * Lisan / Ayn: The sea; vast expanse of water.\n  * Al-Raghib (Mufradat): \"أصل البحر: كل مكان واسع جامع للماء الكثير\" — the sea is every vast place gathering much water; then metaphorically applied to one who expands deeply into a domain.\n  * Al-Zamakhshari (Asas): Metaphorical: \"تبحر في العلم واستبحر فيه\" — he plunged deep into knowledge and expanded therein like a sea.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Focused Predication) — the particle innamā restricts the predicate to the subject alone, negating all else; applied here to the exclusive path of the student's submission to the teacher's direction.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "78": [{"arabic": "ترهقني من أمري عسرا} فلم يصبر حتى سأل ثلاثا قال {هذا فراق بيني وبينك} وفارقه فسؤال العوام عن غوامض الدين من أعظم الآفات وهو من المثيرات للفتن فيجب قمعهم ومنعهم من ذلك وخوضهم في حروف القرآن يضاهي حال من كتب الملك إليه كتابا ورسم له فيه أمورا فلم يشتغل بشيء منها وضيع زمانه في أن قرطاس الكتاب عتيق أم حديث فاستحق بذلك العقوبة لا محالة فكذلك تضييع العامي حدود القرآن واشتغاله بحروفه أهي قديمة أم حديثة وكذلك سائر صفات الله سبحانه وتعالى والله تعالى أعلم", "english": "Whoever asks concerning an obscure science (ʿilm ghāmiḍ) while his understanding has not reached that degree is blameworthy, for relative to that [science] he is a common man. For this reason, the Prophet, peace and blessings be upon him, said: \"Leave me as I have left you, for those before you were destroyed only by their excessive questioning and their differing with their prophets. What I have forbidden you, avoid; and what I have commanded you, do of it what you are able.\" {«ذروني ما تركتكم فإنما هلك من كان قبلكم بكثرة سؤالهم واختلافهم على أنبيائهم ما نهيتكم عنه فاجتنبوه وما أمرتكم به فأتوا منه ما استطعتم»} (1)", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 699", "section_title_en": "The Twentieth Affliction: The Questioning of the Common Folk Concerning the Attributes of God and His Speech", "section_index": 699, "anchors": "- Root: س-أ-ل (sa-ʾa-la)\n  * Lisan / Ayn: The act of asking, inquiring, or seeking information; its core sense involves a request directed toward another.\n  * Al-Raghib (Mufradat): In theological discourse, questioning (suʾāl) about divine matters without proper preparation or station is blameworthy, as it exceeds the bounds of what the questioner is obligated to know and ventures into what is not his concern.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) questioning seeks permissible knowledge; metaphorical (majāz) usage extends to the \"questioning\" of fate or the soul's improper probing into hidden matters, which is censured.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Prophet's command {«ذروني ما تركتكم»} uses restriction to delimit the sphere of permissible inquiry, confining it to what the Lawgiver has addressed.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'", "badge": "Hadith"}], "82": [{"arabic": "إليهما إلا به وقال تعالى {ويستخرجا كنزهما رحمة من ربك} وقال تعالى ممتنا على عباده {ويمددكم بأموال وبنين ويجعل لكم جنات ويجعل لكم أنهارا} وقال صلى الله عليه وسلم كاد الفقر أن يكون كفرا (2) حديث من أكرم الناس وأكيسهم قال أكثرهم للموت ذكرا الحديث أخرجه ابن ماجه من حديث ابن عمر بلفظ أي المؤمنين أكيس ورواه ابن أبي الدنيا في الموت بلفظ المصنف وإسناده جيد //", "english": "It is related from Maslamah ibn ʿAbd al-Malik that he entered upon ʿUmar ibn ʿAbd al-ʿAzīz, may God have mercy on him, at the time of his death, and said: \"O Commander of the Believers, you have done a deed that no one before you has done — you have left your children with neither a dirham nor a dinar.\" And he had thirteen children. ʿUmar said: \"Seat me upright.\" So they seated him upright. He said: \"As for your saying that I have not left them a dinar or a dirham — I have not withheld from them any right that was theirs, nor have I given them any right that belonged to others. Rather, my children are one of two men: either one obedient to God — and God suffices him, for God takes charge of the righteous; or one disobedient to God — and then I care not upon what he falls.\"", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 754", "section_title_en": "The Dispraise of Wealth and the Reconciliation Between Its Dispraise and Praise", "section_index": 754, "anchors": "- Root: ورع (wariʿa)\n  * Lisan / Ayn: Abstinence, scrupulous avoidance of what is doubtful or forbidden; the root conveys a shrinking back and restraint.\n  * Al-Raghib (Mufradat): The theological virtue of scrupulous piety (waraʿ) — the soul's restraint from anything that might taint one's standing before God.\n  * Al-Zamakhshari (Asas): Literal: to avoid, to withdraw. Metaphorical: the heart's recoiling from sin as the body recoils from a harmful thing.\n- Root: ولد (walada)\n  * Lisan / Ayn: To beget, to give birth; offspring (walad) — used for both singular and plural, young and old.\n  * Al-Raghib (Mufradat): Offspring; in the Qur'anic context, the concern for one's children and the question of providing for them after death.\n  * Al-Zamakhshari (Asas): Literal: biological progeny. Metaphorical: \"to generate\" new things — here, the tension between leaving wealth for heirs versus sending it forward for oneself.\n- Root: مال (māl)\n  * Lisan / Ayn: Property, wealth, possessions — from the root meaning to incline or tend toward something.\n  * Al-Raghib (Mufradat): In the Qur'an, wealth is called \"good\" (khayr) — {«إن ترك خيرا»} — indicating its potential as a means to goodness.\n  * Al-Zamakhshari (Asas): Literal: what one owns. Metaphorical: the \"true wealth\" is what is sent forward for the Hereafter, not what is left behind.\n- Root: خير (khayr)\n  * Lisan / Ayn: Goodness, benefit, that which is choice-worthy.\n  * Al-Raghib (Mufradat): The Qur'anic designation of wealth as khayr — a conditional good, dependent on its use.\n  * Al-Zamakhshari (Asas): Literal: good. Metaphorical: the \"good\" of wealth is only realized through righteous expenditure.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The use of \"innamā\" to restrict and focus the predicate, as in the reconciliation between the dispraise and praise of wealth, where each applies under distinct conditions.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Hadith"}], "84": [{"arabic": "قدرة إلا بتمكين مولاه كما قال في أعظم ملوك الأرض ذي القرنين إذ قال إنا مكنا له في الأرض فلم يكن جميع ملكه وسلطنته إلا بتمكين الله تعالى إياه في جزء من الأرض والأرض كلها مدرة بالإضافة إلى أجسام العالم وجميع الولايات التي يحظى بها الناس من الأرض غبرة من تلك المدرة ثم تلك الغبرة أيضا من فضل الله تعالى وتمكينه فيستحيل أن يحب عبدا من عباد الله تعالى لقدرته وسياسته وتمكينه واستيلائه وكمال قوته ولا يحب الله تعالى لذلك ولا حول ولا قوة إلا بالله العلي العظيم فهو الجبار القاهر والعليم القادر السموات مطويات بيمينه والأرض وملكها وما عليها في", "english": "...power except through the enabling of his Master, just as He said concerning the greatest of the kings of the earth, Dhul-Qarnayn, when He said: {«إنا مكنا له في الأرض»} — \"Indeed, We established him firmly upon the earth\" (Q. 18:84). For all his kingship and sovereignty was nothing but the enabling of God Most High granted to him over a portion of the earth — and the entire earth is but a speck of dust in relation to the bodies of the world. And all the dominions that people attain from the earth are but a mote from that speck of dust. Then that mote, too, is from the bounty of God Most High and His enabling. It is therefore impossible that a servant should love one of God's servants for his power, his governance, his enablement, his dominion, and the completeness of his strength, yet not love God Most High for that very reason. And there is no might and no power except through God, the Exalted, the Magnificent. For He is the Compeller (al-Jabbār), the Subduer (al-Qāhir), the All-Knowing (al-'Alīm), the All-Powerful (al-Qādir). The heavens are folded in His right hand, and the earth with its kingdom and all that is upon it is in His grasp. The forelock of all creatures is in the grip of His power. If He destroyed them all, from the first to the last, not a single atom would diminish from His sovereignty and kingdom; and if He created their like a thousand times, He would not be wearied by their creation, nor would fatigue or languor touch Him in inventing them. So there is no power and no powerful one except that it is a trace of the traces of His power. To Him belongs beauty (al-jamāl), splendor (al-bahā'), majesty (al-'azamah), grandeur (al-kibriyā'), subjugation (al-qahr), and dominion (al-istīlā'). If, then, it is conceivable that a powerful one be loved for the completeness of his power, then none whatsoever deserves love for completeness of power save Him alone.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1156", "section_title_en": "The Fifth Cause of Love: Essential Beauty and Inner Affinity (Section 1156)", "section_index": 1156, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and enabling power; al-Farahidi notes its application to divine ordainment and human capacity.\n  * Al-Raghib (Mufradat): Divine power (qudrah) is negation of incapacity ('ajz) in God; for humans, it is a contingent capacity granted by God's enabling (tamkīn), never absolute.\n  * Al-Zamakhshari (Asas): Literal: measured capacity and enablement; Metaphorical: \"far-reaching stride\" (ba'īd al-qadr) — here, all creaturely power is but a trace of divine power.\n- Root: قدس (q-d-s)\n  * Lisan / Ayn: Purity and sanctity; being set apart from defilement.\n  * Al-Raghib (Mufradat): Transcendence (taqdīs) as absolute purity from all deficiency — applicable in full only to God, the Holy (al-Quddūs).\n  * Al-Zamakhshari (Asas): Literal: physical cleansing; Metaphorical: moral and ontological transcendence from every imperfection.\n- Root: مثل (m-th-l)\n  * Lisan / Ayn: Likeness, similarity, and representation.\n  * Al-Raghib (Mufradat): Tamthīl (assimilation) and tashbīh (anthropomorphism) are impossible for God; munāsabah (affinity) is not likeness in form but in inner meaning.\n  * Al-Zamakhshari (Asas): Literal: visual resemblance; Metaphorical: spiritual congruence (munāsabah) between the servant and God through acquired divine attributes.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to confine absolute beauty, perfection, and lovability exclusively to God, e.g., \"the Beautiful absolutely is the One who has no equal.\"", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Love, Longing, Intimacy and Contentment'", "badge": "Du'a"}], "103": [{"arabic": "ويخسره في الآخرة وفيهم قال الله تعالى قل هل ننبئكم بالأخسرين أعمالا الذين ضل سعيهم في الحياة الدنيا وهم يحسبون أنهم يحسنون صنعا الحالة الرابعة وهي الصدق في العبادة أن يكره المدح ويمقت المادح إذا يعلم أنه فتنة عليه قاصمة للظهر مضرة له في الدين ويحب الذام إذ يعلم أنه مهد إليه عيبه ومرشد له إلى مهمه ومهد إليه حسناته فقد قال صلى الله عليه وسلم رأس التواضع أن تكره أن تذكر بالبر والتقوى (1) حديث ويل للصائم وويل للقائم وويل لصاحب الصوف الحديث لم أجده هكذا وذكر صاحب الفردوس من حديث أنس ويل لمن لبس الصوف فخالف فعله قوله ولم يخرجه ولد في مسنده وهذا شديد جدا وغاية أمثالنا الطمع في الحالة", "english": "...their own selves by these signs. And perhaps the worshipper perceives in his heart an inclination toward the one who praises him and away from the one who blames him. The Devil beautifies this for him and says: \"The blamer has disobeyed God by his blame of you, and the praiser has obeyed God by his praise of you. How then can you hold them equal? Your aversion to the blamer is pure religion.\"", "book_title": "Fear and Hope", "section_title_ar": "Section 809", "section_title_en": "On the Deceptions of the Devil Regarding Praise and Blame — The Fourth State: Sincerity in Worship", "section_index": 809, "anchors": "- Root: مدح (m-d-ḥ)\n  * Lisan / Ayn: Core meaning is commendation, eulogy, and laudatory speech directed at a person for a praiseworthy quality or act.\n  * Al-Raghib (Mufradat): In theological context, praise (madḥ) is an act of the tongue that corresponds to a real or perceived virtue; its acceptance in the heart reveals the soul's attachment to created opinion rather than divine truth.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes verbal commendation; metaphorical (majāz) usage extends to the inner inclination of the heart toward the praiser, which is the very trap the Devil exploits.\n- Root: ذام (dh-m-m)\n  * Lisan / Ayn: Root ذمم signifies blame, censure, and the imputation of defect; the augmented form ذأم (dh-m) intensifies this as reproach with contempt.\n  * Al-Raghib (Mufradat): Blame (dhamm) is the counterpart of praise; in the Quranic verse {«اخرج منها مذؤما»} (7:18), the derived form madh'ūman means \"cast out with blame,\" indicating that blame is a divine and cosmic reality, not merely a human social reaction.\n  * Al-Zamakhshari (Asas): Literal usage is the utterance of censure; metaphorical usage is the inner aversion (nufrah) one feels, which the deceived worshipper mistakenly sanctifies as religious zeal.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self (nafs) as the locus of desire, inclination, and passion; also the breath that carries life and the animating spirit.\n  * Al-Raghib (Mufradat): The nafs is the soul in its commanding aspect (al-nafs al-ammārah) that inclines toward what pleases it; its hidden affections are the battlefield where the Devil plants deception, making the worshipper believe his ego-driven anger is pure religion.\n  * Al-Zamakhshari (Asas): Literal: the self as an entity; metaphorical: \"دفق نفسه\" (he poured out his self, i.e., his blood) — showing that the self's attachments are so deep they are life itself; thus severing them is a form of spiritual death.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The phrase \"إنما استثقالك للذام من الدين المحض\" (your aversion to the blamer is pure religion) uses innamā to restrict and focus the predicate, revealing the Devil's rhetorical trick of confining the worshipper's perception to a single false equivalence, which the translator must render with the same restrictive force.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "104": [{"arabic": "الذي ضل سعيهم في الحياة الدنيا وهم يحسبون أنهم يحسنون صنعا وبالجملة لا ينبغي للإنسان أن يشتغل بدقائق الورع إلا بحضرة عالم متقن فإنه إذا جاوز ما رسم وتصرف بذهنه من غير سماع كان ما يفسده أكثر مما يصلحه وقد روي عن سعد بن أبي وقاص رضي الله عنه أنه أحرق كرمه خوفا من أن يباع العنب ممن يتخذه خمرا وهذا لا أعرف له وجها إن لم يعرف هو سببا خاصا يوجب الإحراق إذا ما أحرق كرمه ونخله من كان أرفع قدرامنه من الصحابة ولو جاز هذا لجاز قطع الذكر خيفة من الزنا وقطع اللسان خيفة من الكذب إلى غير ذلك من الإتلافات وأما المقدمات: فلت", "english": "Next is that which is an exaggeration and nearly attaches to obsessive scrupulosity (al-waswās)—namely, the saying of a group that one may not transact with farmers over the tools of tillage, because they use them to aid in plowing and sell food to oppressors; nor may one buy from them cattle, land, and plowing implements. This is the abstinence of obsession, for it leads to not selling food to the farmer because he gains strength thereby for plowing, nor watering [his land] from the public water for that reason. This reaches the limit of excessive affectation (al-tanaṭṭuʿ) that is prohibited. For everyone who directs himself toward something with the intention of good cannot but exceed [proper bounds] unless verified knowledge (al-ʿilm al-muḥaqqiq) censures him. Perhaps he may embark upon something that becomes an innovation in religion (bidʿah), by which people are harmed afterward, while he supposes himself occupied with good. For this reason, he said—peace and blessings be upon him: \"The superiority of the scholar over the worshiper is like my superiority over the lowest man among my companions.\" And the excessive affectationists (al-mutanaṭṭiʿūn) are those feared to be among those of whom it was said: {«الَّذِينَ ضَلَّ سَعْيُهُمْ فِي الْحَيَاةِ الدُّنْيَا وَهُمْ يَحْسَبُونَ أَنَّهُمْ يُحْسِنُونَ صُنْعًا»} (Q. 18:104) — \"Those whose effort is lost in the life of this world while they suppose that they are doing well in work.\"", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 358", "section_title_en": "On the Degrees of Abstinence (Al-Waraʿ) Concerning Transactions That Facilitate Sin", "section_index": 358, "anchors": "- Root: كرم (karuma)\n  * Lisan / Ayn: Core meaning of nobility, generosity, and honor; also used for the grapevine (karm) as a noble plant.\n  * Al-Raghib (Mufradat): When ascribed to God, denotes His manifest beneficence; when ascribed to man, denotes praiseworthy character and acts that appear from him. It is not said \"he is noble\" until that becomes manifest.\n  * Al-Zamakhshari (Asas): Literal: \"He was generous to us\" (karma ʿalaynā). Metaphorical: \"This land is but a grapevine and a date-palm\" (karmah wa-nakhlah) when these abound therein—likewise, the sale of grapes (karm) is the very subject of this discourse.\n- Root: شطر (shaṭara)\n  * Lisan / Ayn: To halve, to divide into two parts; a half or portion.\n  * Al-Raghib (Mufradat): \"The half and middle of a thing.\" Used in {«فَوَلِّ وَجْهَكَ شَطْرَ الْمَسْجِدِ الْحَرَامِ»} (Q. 2:144) meaning its direction.\n  * Al-Zamakhshari (Asas): Literal: \"He took his half\" (shaṭrahu). \"I divided the thing into two halves.\" Also: \"He shared with him his wealth\" (shāṭarahu mālī). This anchors the account of ʿUmar dividing the camels with his sons by halves (shāṭarahumā).\n- Sibawayh Rule: Rule of Interposition and Continuity in Conditional Sentences (al-sharṭ wa-l-jawāb)—governing the balanced periodic structure of \"If it is said... we say...\" (fa-in qīla... qulnā...) where the protasis and apodosis maintain syntactic parallelism without ellipsis of the governing particle.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "بأنفسهم خيرا ويحسبون أنهم يحسنون صنعا ويعتقدون أن كل سوداء تمرة ويتوهمون أن المشاركة في الظاهر توجب المساهمة في الحقائق وهيهات فما أغزر حماقة من لا يميز بين الشحم والورم فهؤلاء بغضاء الله فإن الله تعالى يبغض الشاب الفارغ ولم يحملهم على السياحة إلا الشباب والفراغ إلا من سافر لحج أو عمرة في غير رياء ولا سمعة أو سافر لمشاهدة شيخ يقتدي به في علمه وسيرته وقد خلت البلاد عنه الآن والأمور الدينية كلها قد فسدت وضعفت إلا التصوف فإنه قد انمحق بالكلية وبطل لأن العلوم لم تندرس بعد والعالم وإن كان", "english": "And the most excellent in this matter is whatever is most helpful to one's religion. The ultimate fruit of religion in this world is the attainment of knowledge of God — may He be exalted — and the attainment of intimacy (uns) with the remembrance of God — may He be exalted. Intimacy is attained through the constancy of remembrance (dhikr), and knowledge is attained through the constancy of reflection (fikr).", "book_title": "Etiquette of Travel", "section_title_ar": "Section 470", "section_title_en": "The Book of Seclusion (Kitāb al-ʿUzlah) — Section 470: On Travel and Its Relation to the Seeker's Path", "section_index": 470, "anchors": "- Root: سفر (s-f-r)\n  * Lisan / Ayn: Core meaning: \"to uncover, to remove a covering\"; al-Ayn: \"al-safar: a people journeying\"; the journey as that which unveils states and conditions.\n  * Al-Raghib (Mufradat): \"al-safar: the uncovering of a veil... al-isfār is specific to color/brightness\" — travel as that which exposes the heart's true constitution.\n  * Al-Zamakhshari (Asas): Haqiqah: physical journeying; Majaz: \"a face bright with joy\" — here, the literal journey as a means that may either illuminate or agitate the heart.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"to turn over, to transform, to flip from one state to another.\"\n  * Al-Raghib (Mufradat): \"taṣrīf al-shayʾ wa ṣarfuhu ʿan wajh ilā wajh\" — the heart's constant overturning between states.\n  * Al-Zamakhshari (Asas): Majaz: \"a man who turns matters over [in his mind]\" — the heart's agitation through travel's distractions.\n- Root: صوف (ṣ-w-f)\n  * Lisan / Ayn: \"wool\"; al-Raghib: \"al-Ṣūfī: one who wears wool, or one attributed to the Ṣūfah who served the Kaʿbah.\"\n  * Al-Zamakhshari (Asas): Majaz: \"a clumsy woman who found wool [and wasted it]\" — one who finds a treasure but lacks the knowledge to use it; the false Sufi who dons the garb without the reality.\n- Sibawayh Rule: Restriction and Specification (al-ḥaṣr wa al-taqyīd bi-innamā) — the text's repeated use of \"إنما\" to delimit the true nature of Sufism (heart's purification) against its counterfeit forms.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Etiquette of Travel'", "badge": "Ethics"}], "109": [{"arabic": "لو كان البحر مدادا لكلمات ربي لنفد البحر قبل أن تنفد كلمات ربي ولو جئنا بمثله مددا ولذلك قال علي رضي الله عنه لو شئت لأوقرت سبعين بعيرا من تفسير فاتحة الكتاب فالغرض مما ذكرناه التنبيه على طريق التفهيم لينفتح بابه فأما الاستقصاء فلا مطمع فيه ومن لم يكن له فهم ما في القرآن ولو في أدنى الدرجات دخل في قوله تعالى ومنهم من يستمع إليك حتى إذا خرجوا من عندك قالوا للذين أوتوا العلم ماذا قال آنفا أولئك الذين طبع الله على قلوبهم والطابع هي الموانع التي سنذكرها في م", "english": "I say: These meanings are buried treasures that are not unveiled except to the divinely aided ones. To this 'Ali — may God be pleased with him — alluded by his saying: \"The Messenger of God — may God's peace and blessings be upon him — did not confide to me anything that he concealed from the people, except that God — mighty and majestic — grants to a servant understanding (fahm) of His Book. So let one be eager in seeking that understanding.\" (1) And Ibn Mas'ud — may God be pleased with him — said: \"Whoever desires the knowledge of the first and the last, let him stir up the Qur'an.\" And the greatest of the sciences of the Qur'an lie beneath the names of God — mighty and majestic — and His attributes, for most of creation have grasped from them only matters befitting their understandings and have not stumbled upon their depths.", "book_title": "Contemplation", "section_title_ar": "Section 228", "section_title_en": "The Revival of the Religious Sciences — Section 228: On the Inner Meanings of the Qur'an and the Removal of Obstacles to Understanding", "section_index": 228, "anchors": "- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, discernment, the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one verifies the realities of what is perceived; distinct from mere hearing or transmission\n  * Al-Zamakhshari (Asas): Literal: swift apprehension; Metaphorical: the divine gift of insight into hidden meanings, as in the verse {ففهمناها سليمان}\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transformation from one state to another\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as that which is perpetually turned and overturned between states\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of understanding that is veiled or illuminated, rusted or polished\n- Root: سمع (s-m-')\n  * Lisan / Ayn: Hearing, the auditory faculty\n  * Al-Raghib (Mufradat): \"السمع: قوة في الأذن به يدرك الأصوات\" — extends metaphorically to comprehension and obedience; \"أو ألقى السمع وهو شهيد\" — one who casts his hearing while present\n  * Al-Zamakhshari (Asas): Literal: auditory perception; Metaphorical: attentive obedience and receptive understanding\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise delimitation of predicates such as \"إنما يتذكر أولوا الألباب\" where restriction confines the action to its proper subject", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}, {"arabic": "وقدرته وجلاله وعظمته وإحصاء ذلك غير ممكن لأنه لو كان البحر مدادا لذلك لنفد البحر قبل أن ينفد عشر عشيره ولكنا نشير إلى جمل منه ليكون ذلك كالمثال لماعداه فنقول الموجودات المخلوقة منقسمة الى مالا يعرف أصلها فلا يمكننا التفكر فيها وكم من الموجودات التى لا نعلمها كما قال الله تعالى ويخلق ما لا تعلمون سبحان الذي خلق الأزواج كلها مما تنبت الأرض ومن أنفسهم ومما لا يعلمون {وقال} وننشئكم فيما لا تعلمون {وإلى} ما يعرف أصلها وجملتها ولا يعرف تفصيلها فيمكننا أن نتفكر في تفصيلها وهي منقسمة إلى ما أدركناه بحس البصر وإلى ما لا ندركه بالبصر أما", "english": "We say: Created existents are divided into that whose origin is unknown to us, such that we cannot contemplate it—and how many are the existents we do not know! As God Most High said: {«وَيَخْلُقُ مَا لَا تَعْلَمُونَ»} (And He creates what you do not know — Q. 16:8), and {«سُبْحَانَ الَّذِي خَلَقَ الْأَزْوَاجَ كُلَّهَا مِمَّا تُنبِتُ الْأَرْضُ وَمِنْ أَنفُسِهِمْ وَمِمَّا لَا يَعْلَمُونَ»} (Glory be to Him who created all pairs, of what the earth grows, and of themselves, and of what they do not know — Q. 36:36), and He said: {«وَنُنشِئُكُمْ فِيمَا لَا تَعْلَمُونَ»} (And We raise you up in what you do not know — Q. 56:61). And [it is divided] into that whose origin and general nature are known, but whose detailed particulars are not known—so we are able to contemplate its details.", "book_title": "Contemplation", "section_title_ar": "Section 1268", "section_title_en": "Exposition of the Method of Contemplation upon the Creation of God Most High", "section_index": 1268, "anchors": "- Root: فكر (f-k-r)\n  * Lisan / Ayn: Core meaning is reflection, deliberation, and the movement of the mind over a matter to arrive at its reality.\n  * Al-Raghib (Mufradat): In theological usage, *tafakkur* is the soul's journey through created things (al-makhlūqāt) to derive knowledge of the Creator—it is the bridge from the sensory to the intelligible.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is mental consideration; metaphorical (majāz) extension applies it to the heart's \"seeing\" of divine wisdom latent in creation.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Root meaning is measuring, proportioning, and fashioning a thing with precise estimation.\n  * Al-Raghib (Mufradat): *Khalq* denotes origination from nothing (ibdāʿ) or creation of one thing from another, always upon a measure necessitated by wisdom.\n  * Al-Zamakhshari (Asas): Literal: the artisan's sizing of material before cutting; Metaphorical: God's bringing things into existence upon a measure that wisdom dictates—He is Rabb al-khalīqah.\n- Root: بصر (b-ṣ-r)\n  * Lisan / Ayn: Core meaning is sight, both ocular and perceptive.\n  * Al-Raghib (Mufradat): *Baṣar* applies to the eye's organ and its power, and to the heart's perceptive faculty (*baṣīrah*), as in {«فَكَشَفْنَا عَنكَ غِطَاءَكَ فَبَصَرُكَ الْيَوْمَ حَدِيدٌ»} (Q. 50:22).\n  * Al-Zamakhshari (Asas): Literal: physical sight; Metaphorical: *ibṣār* as intellectual discernment—\"هذه آية مبصرة\" (this is an illuminating sign).\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: Core meaning is the self, the soul, the vital principle.\n  * Al-Raghib (Mufradat): *Nafs* denotes the rational soul (al-rūḥ) and also the very essence (al-dhāt); in {«وَفِي أَنفُسِكُمْ أَفَلَا تُبْصِرُونَ»} (Q. 51:21) it refers to the human self as a microcosmic sign.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity; Metaphorical: the inner dimension of man as a locus of divine signs.\n- Sibawayh Rule: Rule of Specification and Restriction (Bāb al-Takhṣīṣ) — When a general term (like \"everything in existence\") is followed by a restrictive clause (\"save God\"), the syntax governs the scope of predication, ensuring the exception is precise and the universal claim is bounded.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "110": [{"arabic": "فمن كان يرجو لقاء ربه فليعمل عملا صالحا ولا يشرك بعبادة ربه أحدا نزل فيمن يقصد بعبادته وجه الله وحمد الناس وكن حذرا مشفقا من هذا الشرك واستشعر الخجلة في قلبك إن وصفت نفسك بأنك لست من المشركين من غير براءة عن هذا الشرك فإن اسم الشرك يقع على القليل والكثير منه وإذا قلت محياي ومماتي لله فاعلم أن هذا حال عبد مفقود لنفسه موجود لسيده وأنه إن صدر ممن رضاه وغضبه وقيامه وقعوده ورغبته في الحياة ورهبته من الموت لأمور الدنيا لم يكن ملائما للحال وإذا قلت أعوذ بالله من الشيطان الرجيم فاعلم أنه عدوك ومترصد لصرف قلبك عن الله", "english": "For this reason, he, peace be upon him, said: \"Give us rest, O Bilāl\" (1) — meaning, give us rest through it (the prayer) and through the call to it, for his delight, peace be upon him, was in it.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 138", "section_title_en": "The Inner Works of Prayer: Unveiling the Heart's Secrets in the Ritual Prayer (Asrār al-Ṣalāh)", "section_index": 138, "anchors": "- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn a thing over, to revolve it, to divert it from one state to another; the heart as that which is constantly turning and fluctuating.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — The heart is that which is turned and diverted; its rectitude lies in its orientation towards God, its ruin in its turning towards other than Him.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical (Majaz): \"قلب المعلم الصبيان: صرفهم إلى بيوتهم\" (the teacher turned the boys towards their homes) — thus the heart's turning is its direction and intent.\n- Root: وجه (W-J-H)\n  * Lisan / Ayn: The face; the foremost, noblest, and most apparent part of a thing.\n  * Al-Raghib (Mufradat): \"ولما كان الوجه أول ما يستقبلك، وأشرف ما في ظاهر البدن استعمل في مستقبل كل شيء، وفي أشرفه ومبدئه\" — The face is used metaphorically for the essence and the direction of a thing; the \"face of the heart\" is its intention and aspiration.\n  * Al-Zamakhshari (Asas): Literal: \"واجهته مواجهة ووجاها\" (to face one another). Metaphorical: \"هذا وجه الثوب. ووجه القوم، وهؤلاء وجوه البلد\" (the face of a garment, the chiefs of a people) — thus the \"face\" of the heart is its foremost orientation.\n- Root: وجل (W-J-L)\n  * Lisan / Ayn: A trembling of the heart from fear or awe.\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — The sensing of fear; the heart's tremor before the majesty of the Divine.\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال، وقد وجل وجلا\" — A man trembling with fear.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, negating it from all else. This is crucial for understanding \"إنما هذه الظواهر تحريكات للبواطن\" — the outward acts are *only* movements to stir the inward realities, nothing more.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 170, 1054], [2, 1054, 1779], [3, 1779, 3845], [4, 3845, 4679], [5, 4679, 5698], [6, 5698, 6582], [7, 6582, 7605], [8, 7605, 8479], [9, 8479, 9661], [10, 9661, 10187], [11, 10187, 12040]], "18:1": [[1, 170, 1054], [2, 1054, 1779], [3, 1779, 3845], [4, 3845, 4679], [5, 4679, 5698], [6, 5698, 6582], [7, 6582, 7605], [8, 7605, 8479], [9, 8479, 9661], [10, 9661, 10187], [11, 10187, 12040]], "2": [[1, 550, 2159], [2, 2159, 3441], [3, 3441, 4502], [4, 4502, 5970], [5, 5970, 6536], [6, 6536, 7358], [7, 7358, 8932], [8, 8932, 10532], [9, 10532, 11699], [10, 11699, 13299], [11, 13299, 14938], [12, 14938, 15539], [13, 15539, 16052], [14, 16052, 17148], [15, 17148, 18540]], "18:2": [[1, 550, 2159], [2, 2159, 3441], [3, 3441, 4502], [4, 4502, 5970], [5, 5970, 6536], [6, 6536, 7358], [7, 7358, 8932], [8, 8932, 10532], [9, 10532, 11699], [10, 11699, 13299], [11, 13299, 14938], [12, 14938, 15539], [13, 15539, 1605