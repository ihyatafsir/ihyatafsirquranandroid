 the left, while their dog stretched his forelegs at the entrance. If you had looked at them, you would have turned from them in flight and been filled by them with terror.","words":[{"id":1,"arabic":"وَتَحْسَبُهُمْ","translit":"ْmُhُbَsْḥَtَw","root":"حسب"},{"id":2,"arabic":"أَيْقَاظًا","translit":"āًẓāَqْyَaʾ","root":"يقظ"},{"id":3,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":4,"arabic":"رُقُودٌ","translit":"ٌdwُqُr","root":"رقد"},{"id":5,"arabic":"وَنُقَلِّبُهُمْ","translit":"ْmُhُbِّlَqُnَw","root":"قلب"},{"id":6,"arabic":"ذَاتَ","translit":"َtāَhd","root":""},{"id":7,"arabic":"ٱلْيَمِينِ","translit":"ِnyِmَyْlٱ","root":"يمن"},{"id":8,"arabic":"وَذَاتَ","translit":"َtāَhdَw","root":""},{"id":9,"arabic":"ٱلشِّمَالِ","translit":"ِlāَmِّhslٱ","root":"شمل"},{"id":10,"arabic":"وَكَلْبُهُم","translit":"mُhُbْlَkَw","root":"كلب"},{"id":11,"arabic":"بَٰسِطٌ","translit":"ٌṭِsَٰb","root":"بسط"},{"id":12,"arabic":"ذِرَاعَيْهِ","translit":"ِhْyَʿعāَrِhd","root":"ذرع"},{"id":13,"arabic":"بِٱلْوَصِيدِ","translit":"ِdyِṣَwْlٱِb","root":"وصد"},{"id":14,"arabic":"لَوِ","translit":"ِwَl","root":""},{"id":15,"arabic":"ٱطَّلَعْتَ","translit":"َtْʿعَlَّṭٱ","root":"طلع"},{"id":16,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":17,"arabic":"لَوَلَّيْتَ","translit":"َtْyَّlَwَl","root":"ولي"},{"id":18,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":19,"arabic":"فِرَارًا","translit":"āًrāَrِf","root":"فرر"},{"id":20,"arabic":"وَلَمُلِئْتَ","translit":"َtْyʾِlُmَlَw","root":"ملا"},{"id":21,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":22,"arabic":"رُعْبًا","translit":"āًbْʿعُr","root":"رعب"}],"hasIhya":false},{"ayah":19,"text":"وَكَذَٰلِكَ بَعَثْنَٰهُمْ لِيَتَسَآءَلُوا۟ بَيْنَهُمْۚ قَالَ قَآئِلٌ مِّنْهُمْ كَمْ لَبِثْتُمْۖ قَالُوا۟ لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْمٍۚ قَالُوا۟ رَبُّكُمْ أَعْلَمُ بِمَا لَبِثْتُمْ فَٱبْعَثُوٓا۟ أَحَدَكُم بِوَرِقِكُمْ هَٰذِهِۦٓ إِلَى ٱلْمَدِينَةِ فَلْيَنظُرْ أَيُّهَآ أَزْكَىٰ طَعَامًا فَلْيَأْتِكُم بِرِزْقٍ مِّنْهُ وَلْيَتَلَطَّفْ وَلَا يُشْعِرَنَّ بِكُمْ أَحَدًا ","translation":"And similarly,[1] We awakened them that they might question one another. Said a speaker from among them, \"How long have you remained [here]?\" They said, \"We have remained a day or part of a day.\" They said, \"Your Lord is most knowing of how long you remained. So send one of you with this silver coin of yours to the city and let him look to which is the best of food and bring you provision from it and let him be cautious. And let no one be aware of you.","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"بَعَثْنَٰهُمْ","translit":"ْmُhَٰnْhtَʿعَb","root":"بعث"},{"id":3,"arabic":"لِيَتَسَآءَلُوا۟","translit":"۟āwُlَءٓāَsَtَyِl","root":"سال"},{"id":4,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":5,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":6,"arabic":"قَآئِلٌ","translit":"ٌlِyʾٓāَq","root":"قول"},{"id":7,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":8,"arabic":"كَمْ","translit":"ْmَk","root":""},{"id":9,"arabic":"لَبِثْتُمْ","translit":"ْmُtْhtِbَl","root":"لبث"},{"id":10,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":11,"arabic":"لَبِثْنَا","translit":"āَnْhtِbَl","root":"لبث"},{"id":12,"arabic":"يَوْمًا","translit":"āًmْwَy","root":"يوم"},{"id":13,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":14,"arabic":"بَعْضَ","translit":"َḍْʿعَb","root":"بعض"},{"id":15,"arabic":"يَوْمٍ","translit":"ٍmْwَy","root":"يوم"},{"id":16,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":17,"arabic":"رَبُّكُمْ","translit":"ْmُkُّbَr","root":"ربب"},{"id":18,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":19,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":20,"arabic":"لَبِثْتُمْ","translit":"ْmُtْhtِbَl","root":"لبث"},{"id":21,"arabic":"فَٱبْعَثُوٓا۟","translit":"۟āٓwُhtَʿعْbٱَf","root":"بعث"},{"id":22,"arabic":"أَحَدَكُم","translit":"mُkَdَḥَaʾ","root":"احد"},{"id":23,"arabic":"بِوَرِقِكُمْ","translit":"ْmُkِqِrَwِb","root":"ورق"},{"id":24,"arabic":"هَٰذِهِۦٓ","translit":"ٓۦِhِhdَٰh","root":""},{"id":25,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":26,"arabic":"ٱلْمَدِينَةِ","translit":"ِẗَnyِdَmْlٱ","root":"مدن"},{"id":27,"arabic":"فَلْيَنظُرْ","translit":"ْrُẓnَyْlَf","root":"نظر"},{"id":28,"arabic":"أَيُّهَآ","translit":"ٓāَhُّyَaʾ","root":"ايي"},{"id":29,"arabic":"أَزْكَىٰ","translit":"ٰàَkْzَaʾ","root":"زكو"},{"id":30,"arabic":"طَعَامًا","translit":"āًmāَʿعَṭ","root":"طعم"},{"id":31,"arabic":"فَلْيَأْتِكُم","translit":"mُkِtْaʾَyْlَf","root":"اتي"},{"id":32,"arabic":"بِرِزْقٍ","translit":"ٍqْzِrِb","root":"رزق"},{"id":33,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":34,"arabic":"وَلْيَتَلَطَّفْ","translit":"ْfَّṭَlَtَyْlَw","root":"لطف"},{"id":35,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":36,"arabic":"يُشْعِرَنَّ","translit":"َّnَrِʿعْhsُy","root":"شعر"},{"id":37,"arabic":"بِكُمْ","translit":"ْmُkِb","root":""},{"id":38,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":true},{"ayah":20,"text":"إِنَّهُمْ إِن يَظْهَرُوا۟ عَلَيْكُمْ يَرْجُمُوكُمْ أَوْ يُعِيدُوكُمْ فِى مِلَّتِهِمْ وَلَن تُفْلِحُوٓا۟ إِذًا أَبَدًا ","translation":"Indeed, if they come to know of you, they will stone you or return you to their religion. And never would you succeed, then - ever.\"","words":[{"id":1,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":2,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":3,"arabic":"يَظْهَرُوا۟","translit":"۟āwُrَhْẓَy","root":"ظهر"},{"id":4,"arabic":"عَلَيْكُمْ","translit":"ْmُkْyَlَʿع","root":""},{"id":5,"arabic":"يَرْجُمُوكُمْ","translit":"ْmُkwُmُjgْrَy","root":"رجم"},{"id":6,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":7,"arabic":"يُعِيدُوكُمْ","translit":"ْmُkwُdyِʿعُy","root":"عود"},{"id":8,"arabic":"فِى","translit":"àِf","root":""},{"id":9,"arabic":"مِلَّتِهِمْ","translit":"ْmِhِtَّlِm","root":"ملل"},{"id":10,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":11,"arabic":"تُفْلِحُوٓا۟","translit":"۟āٓwُḥِlْfُt","root":"فلح"},{"id":12,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":13,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"}],"hasIhya":false},{"ayah":21,"text":"وَكَذَٰلِكَ أَعْثَرْنَا عَلَيْهِمْ لِيَعْلَمُوٓا۟ أَنَّ وَعْدَ ٱللَّهِ حَقٌّ وَأَنَّ ٱلسَّاعَةَ لَا رَيْبَ فِيهَآ إِذْ يَتَنَٰزَعُونَ بَيْنَهُمْ أَمْرَهُمْۖ فَقَالُوا۟ ٱبْنُوا۟ عَلَيْهِم بُنْيَٰنًاۖ رَّبُّهُمْ أَعْلَمُ بِهِمْۚ قَالَ ٱلَّذِينَ غَلَبُوا۟ عَلَىٰٓ أَمْرِهِمْ لَنَتَّخِذَنَّ عَلَيْهِم مَّسْجِدًا ","translation":"And similarly, We caused them to be found that they [who found them] would know that the promise of Allāh is truth and that of the Hour there is no doubt. [That was] when they[1] disputed among themselves about their affair and [then] said, \"Construct over them a structure. Their Lord is most knowing about them.\" Said those who prevailed in the matter, \"We will surely take [for ourselves] over them a masjid.\"[2]","words":[{"id":1,"arabic":"وَكَذَٰلِكَ","translit":"َkِlَٰhdَkَw","root":""},{"id":2,"arabic":"أَعْثَرْنَا","translit":"āَnْrَhtْʿعَaʾ","root":"عثر"},{"id":3,"arabic":"عَلَيْهِمْ","translit":"ْmِhْyَlَʿع","root":""},{"id":4,"arabic":"لِيَعْلَمُوٓا۟","translit":"۟āٓwُmَlْʿعَyِl","root":"علم"},{"id":5,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":6,"arabic":"وَعْدَ","translit":"َdْʿعَw","root":"وعد"},{"id":7,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":8,"arabic":"حَقٌّ","translit":"ٌّqَḥ","root":"حقق"},{"id":9,"arabic":"وَأَنَّ","translit":"َّnَaʾَw","root":""},{"id":10,"arabic":"ٱلسَّاعَةَ","translit":"َẗَʿعāَّslٱ","root":"سوع"},{"id":11,"arabic":"لَا","translit":"āَl","root":""},{"id":12,"arabic":"رَيْبَ","translit":"َbْyَr","root":"ريب"},{"id":13,"arabic":"فِيهَآ","translit":"ٓāَhyِf","root":""},{"id":14,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":15,"arabic":"يَتَنَٰزَعُونَ","translit":"َnwُʿعَzَٰnَtَy","root":"نزع"},{"id":16,"arabic":"بَيْنَهُمْ","translit":"ْmُhَnْyَb","root":"بين"},{"id":17,"arabic":"أَمْرَهُمْ","translit":"ْmُhَrْmَaʾ","root":"امر"},{"id":18,"arabic":"فَقَالُوا۟","translit":"۟āwُlāَqَf","root":"قول"},{"id":19,"arabic":"ٱبْنُوا۟","translit":"۟āwُnْbٱ","root":"بني"},{"id":20,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":21,"arabic":"بُنْيَٰنًا","translit":"āًnَٰyْnُb","root":"بني"},{"id":22,"arabic":"رَّبُّهُمْ","translit":"ْmُhُّbَّr","root":"ربب"},{"id":23,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":24,"arabic":"بِهِمْ","translit":"ْmِhِb","root":""},{"id":25,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":26,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":27,"arabic":"غَلَبُوا۟","translit":"۟āwُbَlَغ","root":"غلب"},{"id":28,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":29,"arabic":"أَمْرِهِمْ","translit":"ْmِhِrْmَaʾ","root":"امر"},{"id":30,"arabic":"لَنَتَّخِذَنَّ","translit":"َّnَhdِhkَّtَnَl","root":"اخذ"},{"id":31,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":32,"arabic":"مَّسْجِدًا","translit":"āًdِjgْsَّm","root":"سجد"}],"hasIhya":false},{"ayah":22,"text":"سَيَقُولُونَ ثَلَٰثَةٌ رَّابِعُهُمْ كَلْبُهُمْ وَيَقُولُونَ خَمْسَةٌ سَادِسُهُمْ كَلْبُهُمْ رَجْمًۢا بِٱلْغَيْبِۖ وَيَقُولُونَ سَبْعَةٌ وَثَامِنُهُمْ كَلْبُهُمْۚ قُل رَّبِّىٓ أَعْلَمُ بِعِدَّتِهِم مَّا يَعْلَمُهُمْ إِلَّا قَلِيلٌۗ فَلَا تُمَارِ فِيهِمْ إِلَّا مِرَآءً ظَٰهِرًا وَلَا تَسْتَفْتِ فِيهِم مِّنْهُمْ أَحَدًا ","translation":"They [i.e., people] will say there were three, the fourth of them being their dog; and they will say there were five, the sixth of them being their dog - guessing at the unseen; and they will say there were seven, and the eighth of them was their dog. Say, [O Muḥammad], \"My Lord is most knowing of their number. None knows them except a few. So do not argue about them except with an obvious argument[1] and do not inquire about them among [the speculators] from anyone.\"","words":[{"id":1,"arabic":"سَيَقُولُونَ","translit":"َnwُlwُqَyَs","root":"قول"},{"id":2,"arabic":"ثَلَٰثَةٌ","translit":"ٌẗَhtَٰlَht","root":"ثلث"},{"id":3,"arabic":"رَّابِعُهُمْ","translit":"ْmُhُʿعِbāَّr","root":"ربع"},{"id":4,"arabic":"كَلْبُهُمْ","translit":"ْmُhُbْlَk","root":"كلب"},{"id":5,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":6,"arabic":"خَمْسَةٌ","translit":"ٌẗَsْmَhk","root":"خمس"},{"id":7,"arabic":"سَادِسُهُمْ","translit":"ْmُhُsِdāَs","root":"سدس"},{"id":8,"arabic":"كَلْبُهُمْ","translit":"ْmُhُbْlَk","root":"كلب"},{"id":9,"arabic":"رَجْمًۢا","translit":"āًۢmْjgَr","root":"رجم"},{"id":10,"arabic":"بِٱلْغَيْبِ","translit":"ِbْyَغْlٱِb","root":"غيب"},{"id":11,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":12,"arabic":"سَبْعَةٌ","translit":"ٌẗَʿعْbَs","root":"سبع"},{"id":13,"arabic":"وَثَامِنُهُمْ","translit":"ْmُhُnِmāَhtَw","root":"ثمن"},{"id":14,"arabic":"كَلْبُهُمْ","translit":"ْmُhُbْlَk","root":"كلب"},{"id":15,"arabic":"قُل","translit":"lُq","root":"قول"},{"id":16,"arabic":"رَّبِّىٓ","translit":"ٓàِّbَّr","root":"ربب"},{"id":17,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":18,"arabic":"بِعِدَّتِهِم","translit":"mِhِtَّdِʿعِb","root":"عدد"},{"id":19,"arabic":"مَّا","translit":"āَّm","root":""},{"id":20,"arabic":"يَعْلَمُهُمْ","translit":"ْmُhُmَlْʿعَy","root":"علم"},{"id":21,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":22,"arabic":"قَلِيلٌ","translit":"ٌlyِlَq","root":"قلل"},{"id":23,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":24,"arabic":"تُمَارِ","translit":"ِrāَmُt","root":"مري"},{"id":25,"arabic":"فِيهِمْ","translit":"ْmِhyِf","root":""},{"id":26,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":27,"arabic":"مِرَآءً","translit":"ًءٓāَrِm","root":"مري"},{"id":28,"arabic":"ظَٰهِرًا","translit":"āًrِhَٰẓ","root":"ظهر"},{"id":29,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":30,"arabic":"تَسْتَفْتِ","translit":"ِtْfَtْsَt","root":"فتي"},{"id":31,"arabic":"فِيهِم","translit":"mِhyِf","root":""},{"id":32,"arabic":"مِّنْهُمْ","translit":"ْmُhْnِّm","root":""},{"id":33,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":false},{"ayah":23,"text":"وَلَا تَقُولَنَّ لِشَا۟ىْءٍ إِنِّى فَاعِلٌ ذَٰلِكَ غَدًا ","translation":"And never say of anything, \"Indeed, I will do that tomorrow,\"","words":[{"id":1,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":2,"arabic":"تَقُولَنَّ","translit":"َّnَlwُqَt","root":"قول"},{"id":3,"arabic":"لِشَا۟ىْءٍ","translit":"ٍءْà۟āَhsِl","root":"شيا"},{"id":4,"arabic":"إِنِّى","translit":"àِّnِiʾ","root":""},{"id":5,"arabic":"فَاعِلٌ","translit":"ٌlِʿعāَf","root":"فعل"},{"id":6,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":7,"arabic":"غَدًا","translit":"āًdَغ","root":"غدو"}],"hasIhya":true},{"ayah":24,"text":"إِلَّآ أَن يَشَآءَ ٱللَّهُۚ وَٱذْكُر رَّبَّكَ إِذَا نَسِيتَ وَقُلْ عَسَىٰٓ أَن يَهْدِيَنِ رَبِّى لِأَقْرَبَ مِنْ هَٰذَا رَشَدًا ","translation":"Except [when adding], \"If Allāh wills.\" And remember your Lord when you forget [it] and say, \"Perhaps my Lord will guide me to what is nearer than this to right conduct.\"","words":[{"id":1,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":2,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":3,"arabic":"يَشَآءَ","translit":"َءٓāَhsَy","root":"شيا"},{"id":4,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":5,"arabic":"وَٱذْكُر","translit":"rُkْhdٱَw","root":"ذكر"},{"id":6,"arabic":"رَّبَّكَ","translit":"َkَّbَّr","root":"ربب"},{"id":7,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":8,"arabic":"نَسِيتَ","translit":"َtyِsَn","root":"نسي"},{"id":9,"arabic":"وَقُلْ","translit":"ْlُqَw","root":"قول"},{"id":10,"arabic":"عَسَىٰٓ","translit":"ٰٓàَsَʿع","root":"عسي"},{"id":11,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":12,"arabic":"يَهْدِيَنِ","translit":"ِnَyِdْhَy","root":"هدي"},{"id":13,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":14,"arabic":"لِأَقْرَبَ","translit":"َbَrْqَaʾِl","root":"قرب"},{"id":15,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":16,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":17,"arabic":"رَشَدًا","translit":"āًdَhsَr","root":"رشد"}],"hasIhya":true},{"ayah":25,"text":"وَلَبِثُوا۟ فِى كَهْفِهِمْ ثَلَٰثَ مِا۟ئَةٍ سِنِينَ وَٱزْدَادُوا۟ تِسْعًا ","translation":"And they remained in their cave for three hundred years and exceeded by nine.[1]","words":[{"id":1,"arabic":"وَلَبِثُوا۟","translit":"۟āwُhtِbَlَw","root":"لبث"},{"id":2,"arabic":"فِى","translit":"àِf","root":""},{"id":3,"arabic":"كَهْفِهِمْ","translit":"ْmِhِfْhَk","root":"كهف"},{"id":4,"arabic":"ثَلَٰثَ","translit":"َhtَٰlَht","root":"ثلث"},{"id":5,"arabic":"مِا۟ئَةٍ","translit":"ٍẗَyʾ۟āِm","root":"ماي"},{"id":6,"arabic":"سِنِينَ","translit":"َnyِnِs","root":"سنو"},{"id":7,"arabic":"وَٱزْدَادُوا۟","translit":"۟āwُdāَdْzٱَw","root":"زيد"},{"id":8,"arabic":"تِسْعًا","translit":"āًʿعْsِt","root":"تسع"}],"hasIhya":false},{"ayah":26,"text":"قُلِ ٱللَّهُ أَعْلَمُ بِمَا لَبِثُوا۟ۖ لَهُۥ غَيْبُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ أَبْصِرْ بِهِۦ وَأَسْمِعْۚ مَا لَهُم مِّن دُونِهِۦ مِن وَلِىٍّ وَلَا يُشْرِكُ فِى حُكْمِهِۦٓ أَحَدًا ","translation":"Say, \"Allāh is most knowing of how long they remained. He has [knowledge of] the unseen [aspects] of the heavens and the earth. How Seeing is He and how Hearing! They have not besides Him any protector, and He shares not His legislation with anyone.\"","words":[{"id":1,"arabic":"قُلِ","translit":"ِlُq","root":"قول"},{"id":2,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":3,"arabic":"أَعْلَمُ","translit":"ُmَlْʿعَaʾ","root":"علم"},{"id":4,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":5,"arabic":"لَبِثُوا۟","translit":"۟āwُhtِbَl","root":"لبث"},{"id":6,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":7,"arabic":"غَيْبُ","translit":"ُbْyَغ","root":"غيب"},{"id":8,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":9,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":10,"arabic":"أَبْصِرْ","translit":"ْrِṣْbَaʾ","root":"بصر"},{"id":11,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":12,"arabic":"وَأَسْمِعْ","translit":"ْʿعِmْsَaʾَw","root":"سمع"},{"id":13,"arabic":"مَا","translit":"āَm","root":""},{"id":14,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":15,"arabic":"مِّن","translit":"nِّm","root":""},{"id":16,"arabic":"دُونِهِۦ","translit":"ۦِhِnwُd","root":"دون"},{"id":17,"arabic":"مِن","translit":"nِm","root":""},{"id":18,"arabic":"وَلِىٍّ","translit":"ٍّàِlَw","root":"ولي"},{"id":19,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":20,"arabic":"يُشْرِكُ","translit":"ُkِrْhsُy","root":"شرك"},{"id":21,"arabic":"فِى","translit":"àِf","root":""},{"id":22,"arabic":"حُكْمِهِۦٓ","translit":"ٓۦِhِmْkُḥ","root":"حكم"},{"id":23,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":false},{"ayah":27,"text":"وَٱتْلُ مَآ أُوحِىَ إِلَيْكَ مِن كِتَابِ رَبِّكَۖ لَا مُبَدِّلَ لِكَلِمَٰتِهِۦ وَلَن تَجِدَ مِن دُونِهِۦ مُلْتَحَدًا ","translation":"And recite, [O Muḥammad], what has been revealed to you of the Book of your Lord. There is no changer of His words, and never will you find in other than Him a refuge.","words":[{"id":1,"arabic":"وَٱتْلُ","translit":"ُlْtٱَw","root":"تلو"},{"id":2,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":3,"arabic":"أُوحِىَ","translit":"َàِḥwُaʾ","root":"وحي"},{"id":4,"arabic":"إِلَيْكَ","translit":"َkْyَlِiʾ","root":""},{"id":5,"arabic":"مِن","translit":"nِm","root":""},{"id":6,"arabic":"كِتَابِ","translit":"ِbāَtِk","root":"كتب"},{"id":7,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":8,"arabic":"لَا","translit":"āَl","root":""},{"id":9,"arabic":"مُبَدِّلَ","translit":"َlِّdَbُm","root":"بدل"},{"id":10,"arabic":"لِكَلِمَٰتِهِۦ","translit":"ۦِhِtَٰmِlَkِl","root":"كلم"},{"id":11,"arabic":"وَلَن","translit":"nَlَw","root":""},{"id":12,"arabic":"تَجِدَ","translit":"َdِjgَt","root":"وجد"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"دُونِهِۦ","translit":"ۦِhِnwُd","root":"دون"},{"id":15,"arabic":"مُلْتَحَدًا","translit":"āًdَḥَtْlُm","root":"لحد"}],"hasIhya":false},{"ayah":28,"text":"وَٱصْبِرْ نَفْسَكَ مَعَ ٱلَّذِينَ يَدْعُونَ رَبَّهُم بِٱلْغَدَوٰةِ وَٱلْعَشِىِّ يُرِيدُونَ وَجْهَهُۥۖ وَلَا تَعْدُ عَيْنَاكَ عَنْهُمْ تُرِيدُ زِينَةَ ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَلَا تُطِعْ مَنْ أَغْفَلْنَا قَلْبَهُۥ عَن ذِكْرِنَا وَٱتَّبَعَ هَوَىٰهُ وَكَانَ أَمْرُهُۥ فُرُطًا ","translation":"And keep yourself patient [by being] with those who call upon their Lord in the morning and the evening, seeking His face [i.e., acceptance]. And let not your eyes pass beyond them, desiring adornments of the worldly life, and do not obey one whose heart We have made heedless of Our remembrance and who follows his desire and whose affair is ever [in] neglect.[1]","words":[{"id":1,"arabic":"وَٱصْبِرْ","translit":"ْrِbْṣٱَw","root":"صبر"},{"id":2,"arabic":"نَفْسَكَ","translit":"َkَsْfَn","root":"نفس"},{"id":3,"arabic":"مَعَ","translit":"َʿعَm","root":""},{"id":4,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":5,"arabic":"يَدْعُونَ","translit":"َnwُʿعْdَy","root":"دعو"},{"id":6,"arabic":"رَبَّهُم","translit":"mُhَّbَr","root":"ربب"},{"id":7,"arabic":"بِٱلْغَدَوٰةِ","translit":"ِẗٰwَdَغْlٱِb","root":"غدو"},{"id":8,"arabic":"وَٱلْعَشِىِّ","translit":"ِّàِhsَʿعْlٱَw","root":"عشو"},{"id":9,"arabic":"يُرِيدُونَ","translit":"َnwُdyِrُy","root":"رود"},{"id":10,"arabic":"وَجْهَهُۥ","translit":"ۥُhَhْjgَw","root":"وجه"},{"id":11,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":12,"arabic":"تَعْدُ","translit":"ُdْʿعَt","root":"عدو"},{"id":13,"arabic":"عَيْنَاكَ","translit":"َkāَnْyَʿع","root":"عين"},{"id":14,"arabic":"عَنْهُمْ","translit":"ْmُhْnَʿع","root":""},{"id":15,"arabic":"تُرِيدُ","translit":"ُdyِrُt","root":"رود"},{"id":16,"arabic":"زِينَةَ","translit":"َẗَnyِz","root":"زين"},{"id":17,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":18,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":19,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":20,"arabic":"تُطِعْ","translit":"ْʿعِṭُt","root":"طوع"},{"id":21,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":22,"arabic":"أَغْفَلْنَا","translit":"āَnْlَfْغَaʾ","root":"غفل"},{"id":23,"arabic":"قَلْبَهُۥ","translit":"ۥُhَbْlَq","root":"قلب"},{"id":24,"arabic":"عَن","translit":"nَʿع","root":""},{"id":25,"arabic":"ذِكْرِنَا","translit":"āَnِrْkِhd","root":"ذكر"},{"id":26,"arabic":"وَٱتَّبَعَ","translit":"َʿعَbَّtٱَw","root":"تبع"},{"id":27,"arabic":"هَوَىٰهُ","translit":"ُhٰàَwَh","root":"هوي"},{"id":28,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":29,"arabic":"أَمْرُهُۥ","translit":"ۥُhُrْmَaʾ","root":"امر"},{"id":30,"arabic":"فُرُطًا","translit":"āًṭُrُf","root":"فرط"}],"hasIhya":true},{"ayah":29,"text":"وَقُلِ ٱلْحَقُّ مِن رَّبِّكُمْۖ فَمَن شَآءَ فَلْيُؤْمِن وَمَن شَآءَ فَلْيَكْفُرْۚ إِنَّآ أَعْتَدْنَا لِلظَّٰلِمِينَ نَارًا أَحَاطَ بِهِمْ سُرَادِقُهَاۚ وَإِن يَسْتَغِيثُوا۟ يُغَاثُوا۟ بِمَآءٍ كَٱلْمُهْلِ يَشْوِى ٱلْوُجُوهَۚ بِئْسَ ٱلشَّرَابُ وَسَآءَتْ مُرْتَفَقًا ","translation":"And say, \"The truth is from your Lord, so whoever wills - let him believe; and whoever wills - let him disbelieve.\" Indeed, We have prepared for the wrongdoers a fire whose walls will surround them. And if they call for relief, they will be relieved with water like murky oil, which scalds [their] faces. Wretched is the drink, and evil is the resting place.","words":[{"id":1,"arabic":"وَقُلِ","translit":"ِlُqَw","root":"قول"},{"id":2,"arabic":"ٱلْحَقُّ","translit":"ُّqَḥْlٱ","root":"حقق"},{"id":3,"arabic":"مِن","translit":"nِm","root":""},{"id":4,"arabic":"رَّبِّكُمْ","translit":"ْmُkِّbَّr","root":"ربب"},{"id":5,"arabic":"فَمَن","translit":"nَmَf","root":""},{"id":6,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":7,"arabic":"فَلْيُؤْمِن","translit":"nِmْwʾُyْlَf","root":"امن"},{"id":8,"arabic":"وَمَن","translit":"nَmَw","root":""},{"id":9,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":10,"arabic":"فَلْيَكْفُرْ","translit":"ْrُfْkَyْlَf","root":"كفر"},{"id":11,"arabic":"إِنَّآ","translit":"ٓāَّnِiʾ","root":""},{"id":12,"arabic":"أَعْتَدْنَا","translit":"āَnْdَtْʿعَaʾ","root":"عتد"},{"id":13,"arabic":"لِلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlِl","root":"ظلم"},{"id":14,"arabic":"نَارًا","translit":"āًrāَn","root":"نور"},{"id":15,"arabic":"أَحَاطَ","translit":"َṭāَḥَaʾ","root":"حوط"},{"id":16,"arabic":"بِهِمْ","translit":"ْmِhِb","root":""},{"id":17,"arabic":"سُرَادِقُهَا","translit":"āَhُqِdāَrُs","root":"سردق"},{"id":18,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":19,"arabic":"يَسْتَغِيثُوا۟","translit":"۟āwُhtyِغَtْsَy","root":"غوث"},{"id":20,"arabic":"يُغَاثُوا۟","translit":"۟āwُhtāَغُy","root":"غوث"},{"id":21,"arabic":"بِمَآءٍ","translit":"ٍءٓāَmِb","root":"موه"},{"id":22,"arabic":"كَٱلْمُهْلِ","translit":"ِlْhُmْlٱَk","root":"مهل"},{"id":23,"arabic":"يَشْوِى","translit":"àِwْhsَy","root":"شوي"},{"id":24,"arabic":"ٱلْوُجُوهَ","translit":"َhwُjgُwْlٱ","root":"وجه"},{"id":25,"arabic":"بِئْسَ","translit":"َsْyʾِb","root":"باس"},{"id":26,"arabic":"ٱلشَّرَابُ","translit":"ُbāَrَّhslٱ","root":"شرب"},{"id":27,"arabic":"وَسَآءَتْ","translit":"ْtَءٓāَsَw","root":"سوا"},{"id":28,"arabic":"مُرْتَفَقًا","translit":"āًqَfَtْrُm","root":"رفق"}],"hasIhya":true},{"ayah":30,"text":"إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ إِنَّا لَا نُضِيعُ أَجْرَ مَنْ أَحْسَنَ عَمَلًا ","translation":"Indeed, those who have believed and done righteous deeds - indeed, We will not allow to be lost the reward of any who did well in deeds.","words":[{"id":1,"arabic":"إِنَّ","translit":"َّnِiʾ","root":""},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":4,"arabic":"وَعَمِلُوا۟","translit":"۟āwُlِmَʿعَw","root":"عمل"},{"id":5,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":6,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":7,"arabic":"لَا","translit":"āَl","root":""},{"id":8,"arabic":"نُضِيعُ","translit":"ُʿعyِḍُn","root":"ضيع"},{"id":9,"arabic":"أَجْرَ","translit":"َrْjgَaʾ","root":"اجر"},{"id":10,"arabic":"مَنْ","translit":"ْnَm","root":""},{"id":11,"arabic":"أَحْسَنَ","translit":"َnَsْḥَaʾ","root":"حسن"},{"id":12,"arabic":"عَمَلًا","translit":"āًlَmَʿع","root":"عمل"}],"hasIhya":true},{"ayah":31,"text":"أُو۟لَٰٓئِكَ لَهُمْ جَنَّٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهِمُ ٱلْأَنْهَٰرُ يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِن ذَهَبٍ وَيَلْبَسُونَ ثِيَابًا خُضْرًا مِّن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلْأَرَآئِكِۚ نِعْمَ ٱلثَّوَابُ وَحَسُنَتْ مُرْتَفَقًا ","translation":"Those will have gardens of perpetual residence; beneath them rivers will flow. They will be adorned therein with bracelets of gold and will wear green garments of fine silk and brocade, reclining therein on adorned couches. Excellent is the reward, and good is the resting place.","words":[{"id":1,"arabic":"أُو۟لَٰٓئِكَ","translit":"َkِyʾَٰٓl۟wُaʾ","root":""},{"id":2,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":3,"arabic":"جَنَّٰتُ","translit":"ُtَّٰnَjg","root":"جنن"},{"id":4,"arabic":"عَدْنٍ","translit":"ٍnْdَʿع","root":""},{"id":5,"arabic":"تَجْرِى","translit":"àِrْjgَt","root":"جري"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"تَحْتِهِمُ","translit":"ُmِhِtْḥَt","root":"تحت"},{"id":8,"arabic":"ٱلْأَنْهَٰرُ","translit":"ُrَٰhْnَaʾْlٱ","root":"نهر"},{"id":9,"arabic":"يُحَلَّوْنَ","translit":"َnْwَّlَḥُy","root":"حلي"},{"id":10,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":11,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":12,"arabic":"أَسَاوِرَ","translit":"َrِwāَsَaʾ","root":"سور"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"ذَهَبٍ","translit":"ٍbَhَhd","root":"ذهب"},{"id":15,"arabic":"وَيَلْبَسُونَ","translit":"َnwُsَbْlَyَw","root":"لبس"},{"id":16,"arabic":"ثِيَابًا","translit":"āًbāَyِht","root":"ثوب"},{"id":17,"arabic":"خُضْرًا","translit":"āًrْḍُhk","root":"خضر"},{"id":18,"arabic":"مِّن","translit":"nِّm","root":""},{"id":19,"arabic":"سُندُسٍ","translit":"ٍsُdnُs","root":""},{"id":20,"arabic":"وَإِسْتَبْرَقٍ","translit":"ٍqَrْbَtْsِiʾَw","root":""},{"id":21,"arabic":"مُّتَّكِـِٔينَ","translit":"َnyِٔـِkَّtُّm","root":"وكا"},{"id":22,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":23,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":24,"arabic":"ٱلْأَرَآئِكِ","translit":"ِkِyʾٓāَrَaʾْlٱ","root":"ارك"},{"id":25,"arabic":"نِعْمَ","translit":"َmْʿعِn","root":"نعم"},{"id":26,"arabic":"ٱلثَّوَابُ","translit":"ُbāَwَّhtlٱ","root":"ثوب"},{"id":27,"arabic":"وَحَسُنَتْ","translit":"ْtَnُsَḥَw","root":"حسن"},{"id":28,"arabic":"مُرْتَفَقًا","translit":"āًqَfَtْrُm","root":"رفق"}],"hasIhya":true},{"ayah":32,"text":"وَٱضْرِبْ لَهُم مَّثَلًا رَّجُلَيْنِ جَعَلْنَا لِأَحَدِهِمَا جَنَّتَيْنِ مِنْ أَعْنَٰبٍ وَحَفَفْنَٰهُمَا بِنَخْلٍ وَجَعَلْنَا بَيْنَهُمَا زَرْعًا ","translation":"And present to them an example of two men: We granted to one of them two gardens of grapevines, and We bordered them with palm trees and placed between them [fields of] crops.","words":[{"id":1,"arabic":"وَٱضْرِبْ","translit":"ْbِrْḍٱَw","root":"ضرب"},{"id":2,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":3,"arabic":"مَّثَلًا","translit":"āًlَhtَّm","root":"مثل"},{"id":4,"arabic":"رَّجُلَيْنِ","translit":"ِnْyَlُjgَّr","root":"رجل"},{"id":5,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":6,"arabic":"لِأَحَدِهِمَا","translit":"āَmِhِdَḥَaʾِl","root":"احد"},{"id":7,"arabic":"جَنَّتَيْنِ","translit":"ِnْyَtَّnَjg","root":"جنن"},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"أَعْنَٰبٍ","translit":"ٍbَٰnْʿعَaʾ","root":"عنب"},{"id":10,"arabic":"وَحَفَفْنَٰهُمَا","translit":"āَmُhَٰnْfَfَḥَw","root":"حفف"},{"id":11,"arabic":"بِنَخْلٍ","translit":"ٍlْhkَnِb","root":"نخل"},{"id":12,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":13,"arabic":"بَيْنَهُمَا","translit":"āَmُhَnْyَb","root":"بين"},{"id":14,"arabic":"زَرْعًا","translit":"āًʿعْrَz","root":"زرع"}],"hasIhya":false},{"ayah":33,"text":"كِلْتَا ٱلْجَنَّتَيْنِ ءَاتَتْ أُكُلَهَا وَلَمْ تَظْلِم مِّنْهُ شَيْـًٔاۚ وَفَجَّرْنَا خِلَٰلَهُمَا نَهَرًا ","translation":"Each of the two gardens produced its fruit and did not fall short thereof in anything. And We caused to gush forth within them a river.","words":[{"id":1,"arabic":"كِلْتَا","translit":"āَtْlِk","root":"كلو"},{"id":2,"arabic":"ٱلْجَنَّتَيْنِ","translit":"ِnْyَtَّnَjgْlٱ","root":"جنن"},{"id":3,"arabic":"ءَاتَتْ","translit":"ْtَtāَء","root":"اتي"},{"id":4,"arabic":"أُكُلَهَا","translit":"āَhَlُkُaʾ","root":"اكل"},{"id":5,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":6,"arabic":"تَظْلِم","translit":"mِlْẓَt","root":"ظلم"},{"id":7,"arabic":"مِّنْهُ","translit":"ُhْnِّm","root":""},{"id":8,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":9,"arabic":"وَفَجَّرْنَا","translit":"āَnْrَّjgَfَw","root":"فجر"},{"id":10,"arabic":"خِلَٰلَهُمَا","translit":"āَmُhَlَٰlِhk","root":"خلل"},{"id":11,"arabic":"نَهَرًا","translit":"āًrَhَn","root":"نهر"}],"hasIhya":false},{"ayah":34,"text":"وَكَانَ لَهُۥ ثَمَرٌ فَقَالَ لِصَٰحِبِهِۦ وَهُوَ يُحَاوِرُهُۥٓ أَنَا۠ أَكْثَرُ مِنكَ مَالًا وَأَعَزُّ نَفَرًا ","translation":"And he had fruit, so he said to his companion while he was conversing with him, \"I am greater than you in wealth and mightier in [numbers of] men.\"","words":[{"id":1,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"ثَمَرٌ","translit":"ٌrَmَht","root":"ثمر"},{"id":4,"arabic":"فَقَالَ","translit":"َlāَqَf","root":"قول"},{"id":5,"arabic":"لِصَٰحِبِهِۦ","translit":"ۦِhِbِḥَٰṣِl","root":"صحب"},{"id":6,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":7,"arabic":"يُحَاوِرُهُۥٓ","translit":"ٓۥُhُrِwāَḥُy","root":"حور"},{"id":8,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":9,"arabic":"أَكْثَرُ","translit":"ُrَhtْkَaʾ","root":"كثر"},{"id":10,"arabic":"مِنكَ","translit":"َknِm","root":""},{"id":11,"arabic":"مَالًا","translit":"āًlāَm","root":"مول"},{"id":12,"arabic":"وَأَعَزُّ","translit":"ُّzَʿعَaʾَw","root":"عزز"},{"id":13,"arabic":"نَفَرًا","translit":"āًrَfَn","root":"نفر"}],"hasIhya":true},{"ayah":35,"text":"وَدَخَلَ جَنَّتَهُۥ وَهُوَ ظَالِمٌ لِّنَفْسِهِۦ قَالَ مَآ أَظُنُّ أَن تَبِيدَ هَٰذِهِۦٓ أَبَدًا ","translation":"And he entered his garden while he was unjust to himself.[1] He said, \"I do not think that this will perish - ever.","words":[{"id":1,"arabic":"وَدَخَلَ","translit":"َlَhkَdَw","root":"دخل"},{"id":2,"arabic":"جَنَّتَهُۥ","translit":"ۥُhَtَّnَjg","root":"جنن"},{"id":3,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":4,"arabic":"ظَالِمٌ","translit":"ٌmِlāَẓ","root":"ظلم"},{"id":5,"arabic":"لِّنَفْسِهِۦ","translit":"ۦِhِsْfَnِّl","root":"نفس"},{"id":6,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":7,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":8,"arabic":"أَظُنُّ","translit":"ُّnُẓَaʾ","root":"ظنن"},{"id":9,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":10,"arabic":"تَبِيدَ","translit":"َdyِbَt","root":"بيد"},{"id":11,"arabic":"هَٰذِهِۦٓ","translit":"ٓۦِhِhdَٰh","root":""},{"id":12,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"}],"hasIhya":false},{"ayah":36,"text":"وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةً وَلَئِن رُّدِدتُّ إِلَىٰ رَبِّى لَأَجِدَنَّ خَيْرًا مِّنْهَا مُنقَلَبًا ","translation":"And I do not think the Hour will occur. And even if I should be brought back to my Lord, I will surely find better than this as a return.\"","words":[{"id":1,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":2,"arabic":"أَظُنُّ","translit":"ُّnُẓَaʾ","root":"ظنن"},{"id":3,"arabic":"ٱلسَّاعَةَ","translit":"َẗَʿعāَّslٱ","root":"سوع"},{"id":4,"arabic":"قَآئِمَةً","translit":"ًẗَmِyʾٓāَq","root":"قوم"},{"id":5,"arabic":"وَلَئِن","translit":"nِyʾَlَw","root":""},{"id":6,"arabic":"رُّدِدتُّ","translit":"ُّtdِdُّr","root":"ردد"},{"id":7,"arabic":"إِلَىٰ","translit":"ٰàَlِiʾ","root":""},{"id":8,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":9,"arabic":"لَأَجِدَنَّ","translit":"َّnَdِjgَaʾَl","root":"وجد"},{"id":10,"arabic":"خَيْرًا","translit":"āًrْyَhk","root":"خير"},{"id":11,"arabic":"مِّنْهَا","translit":"āَhْnِّm","root":""},{"id":12,"arabic":"مُنقَلَبًا","translit":"āًbَlَqnُm","root":"قلب"}],"hasIhya":true},{"ayah":37,"text":"قَالَ لَهُۥ صَاحِبُهُۥ وَهُوَ يُحَاوِرُهُۥٓ أَكَفَرْتَ بِٱلَّذِى خَلَقَكَ مِن تُرَابٍ ثُمَّ مِن نُّطْفَةٍ ثُمَّ سَوَّىٰكَ رَجُلًا ","translation":"His companion said to him while he was conversing with him, \"Have you disbelieved in He who created you from dust and then from a sperm-drop and then proportioned you [as] a man?","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"صَاحِبُهُۥ","translit":"ۥُhُbِḥāَṣ","root":"صحب"},{"id":4,"arabic":"وَهُوَ","translit":"َwُhَw","root":""},{"id":5,"arabic":"يُحَاوِرُهُۥٓ","translit":"ٓۥُhُrِwāَḥُy","root":"حور"},{"id":6,"arabic":"أَكَفَرْتَ","translit":"َtْrَfَkَaʾ","root":"كفر"},{"id":7,"arabic":"بِٱلَّذِى","translit":"àِhdَّlٱِb","root":""},{"id":8,"arabic":"خَلَقَكَ","translit":"َkَqَlَhk","root":"خلق"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"تُرَابٍ","translit":"ٍbāَrُt","root":"ترب"},{"id":11,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":12,"arabic":"مِن","translit":"nِm","root":""},{"id":13,"arabic":"نُّطْفَةٍ","translit":"ٍẗَfْṭُّn","root":"نطف"},{"id":14,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":15,"arabic":"سَوَّىٰكَ","translit":"َkٰàَّwَs","root":"سوي"},{"id":16,"arabic":"رَجُلًا","translit":"āًlُjgَr","root":"رجل"}],"hasIhya":false},{"ayah":38,"text":"لَّٰكِنَّا۠ هُوَ ٱللَّهُ رَبِّى وَلَآ أُشْرِكُ بِرَبِّىٓ أَحَدًا ","translation":"But as for me, He is Allāh, my Lord, and I do not associate with my Lord anyone.","words":[{"id":1,"arabic":"لَّٰكِنَّا۠","translit":"۠āَّnِkَّٰl","root":""},{"id":2,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":3,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":4,"arabic":"رَبِّى","translit":"àِّbَr","root":"ربب"},{"id":5,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":6,"arabic":"أُشْرِكُ","translit":"ُkِrْhsُaʾ","root":"شرك"},{"id":7,"arabic":"بِرَبِّىٓ","translit":"ٓàِّbَrِb","root":"ربب"},{"id":8,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":false},{"ayah":39,"text":"وَلَوْلَآ إِذْ دَخَلْتَ جَنَّتَكَ قُلْتَ مَا شَآءَ ٱللَّهُ لَا قُوَّةَ إِلَّا بِٱللَّهِۚ إِن تَرَنِ أَنَا۠ أَقَلَّ مِنكَ مَالًا وَوَلَدًا ","translation":"And why did you, when you entered your garden, not say, 'What Allāh willed [has occurred]; there is no power except in Allāh'? Although you see me less than you in wealth and children,","words":[{"id":1,"arabic":"وَلَوْلَآ","translit":"ٓāَlْwَlَw","root":""},{"id":2,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":3,"arabic":"دَخَلْتَ","translit":"َtْlَhkَd","root":"دخل"},{"id":4,"arabic":"جَنَّتَكَ","translit":"َkَtَّnَjg","root":"جنن"},{"id":5,"arabic":"قُلْتَ","translit":"َtْlُq","root":"قول"},{"id":6,"arabic":"مَا","translit":"āَm","root":""},{"id":7,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":8,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":9,"arabic":"لَا","translit":"āَl","root":""},{"id":10,"arabic":"قُوَّةَ","translit":"َẗَّwُq","root":"قوي"},{"id":11,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":12,"arabic":"بِٱللَّهِ","translit":"ِhَّllٱِb","root":"اله"},{"id":13,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":14,"arabic":"تَرَنِ","translit":"ِnَrَt","root":"راي"},{"id":15,"arabic":"أَنَا۠","translit":"۠āَnَaʾ","root":""},{"id":16,"arabic":"أَقَلَّ","translit":"َّlَqَaʾ","root":"قلل"},{"id":17,"arabic":"مِنكَ","translit":"َknِm","root":""},{"id":18,"arabic":"مَالًا","translit":"āًlāَm","root":"مول"},{"id":19,"arabic":"وَوَلَدًا","translit":"āًdَlَwَw","root":"ولد"}],"hasIhya":true},{"ayah":40,"text":"فَعَسَىٰ رَبِّىٓ أَن يُؤْتِيَنِ خَيْرًا مِّن جَنَّتِكَ وَيُرْسِلَ عَلَيْهَا حُسْبَانًا مِّنَ ٱلسَّمَآءِ فَتُصْبِحَ صَعِيدًا زَلَقًا ","translation":"It may be that my Lord will give me [something] better than your garden and will send upon it a [disastrous] penalty from the sky, and it will become a smooth, dusty ground,","words":[{"id":1,"arabic":"فَعَسَىٰ","translit":"ٰàَsَʿعَf","root":"عسي"},{"id":2,"arabic":"رَبِّىٓ","translit":"ٓàِّbَr","root":"ربب"},{"id":3,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":4,"arabic":"يُؤْتِيَنِ","translit":"ِnَyِtْwʾُy","root":"اتي"},{"id":5,"arabic":"خَيْرًا","translit":"āًrْyَhk","root":"خير"},{"id":6,"arabic":"مِّن","translit":"nِّm","root":""},{"id":7,"arabic":"جَنَّتِكَ","translit":"َkِtَّnَjg","root":"جنن"},{"id":8,"arabic":"وَيُرْسِلَ","translit":"َlِsْrُyَw","root":"رسل"},{"id":9,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":10,"arabic":"حُسْبَانًا","translit":"āًnāَbْsُḥ","root":"حسب"},{"id":11,"arabic":"مِّنَ","translit":"َnِّm","root":""},{"id":12,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":13,"arabic":"فَتُصْبِحَ","translit":"َḥِbْṣُtَf","root":"صبح"},{"id":14,"arabic":"صَعِيدًا","translit":"āًdyِʿعَṣ","root":"صعد"},{"id":15,"arabic":"زَلَقًا","translit":"āًqَlَz","root":"زلق"}],"hasIhya":false},{"ayah":41,"text":"أَوْ يُصْبِحَ مَآؤُهَا غَوْرًا فَلَن تَسْتَطِيعَ لَهُۥ طَلَبًا ","translation":"Or its water will become sunken [into the earth], so you would never be able to seek it.\"","words":[{"id":1,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":2,"arabic":"يُصْبِحَ","translit":"َḥِbْṣُy","root":"صبح"},{"id":3,"arabic":"مَآؤُهَا","translit":"āَhُwʾٓāَm","root":"موه"},{"id":4,"arabic":"غَوْرًا","translit":"āًrْwَغ","root":"غور"},{"id":5,"arabic":"فَلَن","translit":"nَlَf","root":""},{"id":6,"arabic":"تَسْتَطِيعَ","translit":"َʿعyِṭَtْsَt","root":"طوع"},{"id":7,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":8,"arabic":"طَلَبًا","translit":"āًbَlَṭ","root":"طلب"}],"hasIhya":true},{"ayah":42,"text":"وَأُحِيطَ بِثَمَرِهِۦ فَأَصْبَحَ يُقَلِّبُ كَفَّيْهِ عَلَىٰ مَآ أَنفَقَ فِيهَا وَهِىَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَيَقُولُ يَٰلَيْتَنِى لَمْ أُشْرِكْ بِرَبِّىٓ أَحَدًا ","translation":"And his fruits were encompassed [by ruin], so he began to turn his hands about [in dismay] over what he had spent on it, while it had collapsed upon its trellises, and said, \"Oh, I wish I had not associated with my Lord anyone.\"[1]","words":[{"id":1,"arabic":"وَأُحِيطَ","translit":"َṭyِḥُaʾَw","root":"حوط"},{"id":2,"arabic":"بِثَمَرِهِۦ","translit":"ۦِhِrَmَhtِb","root":"ثمر"},{"id":3,"arabic":"فَأَصْبَحَ","translit":"َḥَbْṣَaʾَf","root":"صبح"},{"id":4,"arabic":"يُقَلِّبُ","translit":"ُbِّlَqُy","root":"قلب"},{"id":5,"arabic":"كَفَّيْهِ","translit":"ِhْyَّfَk","root":"كفف"},{"id":6,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":7,"arabic":"مَآ","translit":"ٓāَm","root":""},{"id":8,"arabic":"أَنفَقَ","translit":"َqَfnَaʾ","root":"نفق"},{"id":9,"arabic":"فِيهَا","translit":"āَhyِf","root":""},{"id":10,"arabic":"وَهِىَ","translit":"َàِhَw","root":""},{"id":11,"arabic":"خَاوِيَةٌ","translit":"ٌẗَyِwāَhk","root":"خوي"},{"id":12,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":13,"arabic":"عُرُوشِهَا","translit":"āَhِhswُrُʿع","root":"عرش"},{"id":14,"arabic":"وَيَقُولُ","translit":"ُlwُqَyَw","root":"قول"},{"id":15,"arabic":"يَٰلَيْتَنِى","translit":"àِnَtْyَlَٰy","root":""},{"id":16,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":17,"arabic":"أُشْرِكْ","translit":"ْkِrْhsُaʾ","root":"شرك"},{"id":18,"arabic":"بِرَبِّىٓ","translit":"ٓàِّbَrِb","root":"ربب"},{"id":19,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":true},{"ayah":43,"text":"وَلَمْ تَكُن لَّهُۥ فِئَةٌ يَنصُرُونَهُۥ مِن دُونِ ٱللَّهِ وَمَا كَانَ مُنتَصِرًا ","translation":"And there was for him no company to aid him other than Allāh, nor could he defend himself.","words":[{"id":1,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":2,"arabic":"تَكُن","translit":"nُkَt","root":"كون"},{"id":3,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":4,"arabic":"فِئَةٌ","translit":"ٌẗَyʾِf","root":"فاي"},{"id":5,"arabic":"يَنصُرُونَهُۥ","translit":"ۥُhَnwُrُṣnَy","root":"نصر"},{"id":6,"arabic":"مِن","translit":"nِm","root":""},{"id":7,"arabic":"دُونِ","translit":"ِnwُd","root":"دون"},{"id":8,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":9,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":10,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":11,"arabic":"مُنتَصِرًا","translit":"āًrِṣَtnُm","root":"نصر"}],"hasIhya":false},{"ayah":44,"text":"هُنَالِكَ ٱلْوَلَٰيَةُ لِلَّهِ ٱلْحَقِّۚ هُوَ خَيْرٌ ثَوَابًا وَخَيْرٌ عُقْبًا ","translation":"There[1] the authority is [completely] for Allāh, the Truth. He is best in reward and best in outcome.","words":[{"id":1,"arabic":"هُنَالِكَ","translit":"َkِlāَnُh","root":""},{"id":2,"arabic":"ٱلْوَلَٰيَةُ","translit":"ُẗَyَٰlَwْlٱ","root":"ولي"},{"id":3,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":4,"arabic":"ٱلْحَقِّ","translit":"ِّqَḥْlٱ","root":"حقق"},{"id":5,"arabic":"هُوَ","translit":"َwُh","root":""},{"id":6,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":7,"arabic":"ثَوَابًا","translit":"āًbāَwَht","root":"ثوب"},{"id":8,"arabic":"وَخَيْرٌ","translit":"ٌrْyَhkَw","root":"خير"},{"id":9,"arabic":"عُقْبًا","translit":"āًbْqُʿع","root":"عقب"}],"hasIhya":false},{"ayah":45,"text":"وَٱضْرِبْ لَهُم مَّثَلَ ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَآءٍ أَنزَلْنَٰهُ مِنَ ٱلسَّمَآءِ فَٱخْتَلَطَ بِهِۦ نَبَاتُ ٱلْأَرْضِ فَأَصْبَحَ هَشِيمًا تَذْرُوهُ ٱلرِّيَٰحُۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ مُّقْتَدِرًا ","translation":"And present to them the example of the life of this world, [its being] like rain which We send down from the sky, and the vegetation of the earth mingles with it[1] and [then] it becomes dry remnants, scattered by the winds. And Allāh is ever, over all things, Perfect in Ability.","words":[{"id":1,"arabic":"وَٱضْرِبْ","translit":"ْbِrْḍٱَw","root":"ضرب"},{"id":2,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":3,"arabic":"مَّثَلَ","translit":"َlَhtَّm","root":"مثل"},{"id":4,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":5,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":6,"arabic":"كَمَآءٍ","translit":"ٍءٓāَmَk","root":"موه"},{"id":7,"arabic":"أَنزَلْنَٰهُ","translit":"ُhَٰnْlَznَaʾ","root":"نزل"},{"id":8,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":9,"arabic":"ٱلسَّمَآءِ","translit":"ِءٓāَmَّslٱ","root":"سمو"},{"id":10,"arabic":"فَٱخْتَلَطَ","translit":"َṭَlَtْhkٱَf","root":"خلط"},{"id":11,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":12,"arabic":"نَبَاتُ","translit":"ُtāَbَn","root":"نبت"},{"id":13,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":14,"arabic":"فَأَصْبَحَ","translit":"َḥَbْṣَaʾَf","root":"صبح"},{"id":15,"arabic":"هَشِيمًا","translit":"āًmyِhsَh","root":"هشم"},{"id":16,"arabic":"تَذْرُوهُ","translit":"ُhwُrْhdَt","root":"ذرو"},{"id":17,"arabic":"ٱلرِّيَٰحُ","translit":"ُḥَٰyِّrlٱ","root":"روح"},{"id":18,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":19,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":20,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":21,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":22,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":23,"arabic":"مُّقْتَدِرًا","translit":"āًrِdَtْqُّm","root":"قدر"}],"hasIhya":true},{"ayah":46,"text":"ٱلْمَالُ وَٱلْبَنُونَ زِينَةُ ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَٱلْبَٰقِيَٰتُ ٱلصَّٰلِحَٰتُ خَيْرٌ عِندَ رَبِّكَ ثَوَابًا وَخَيْرٌ أَمَلًا ","translation":"Wealth and children are [but] adornment of the worldly life. But the enduring good deeds are better to your Lord[1] for reward and better for [one's] hope.","words":[{"id":1,"arabic":"ٱلْمَالُ","translit":"ُlāَmْlٱ","root":"مول"},{"id":2,"arabic":"وَٱلْبَنُونَ","translit":"َnwُnَbْlٱَw","root":"بني"},{"id":3,"arabic":"زِينَةُ","translit":"ُẗَnyِz","root":"زين"},{"id":4,"arabic":"ٱلْحَيَوٰةِ","translit":"ِẗٰwَyَḥْlٱ","root":"حيي"},{"id":5,"arabic":"ٱلدُّنْيَا","translit":"āَyْnُّdlٱ","root":"دنو"},{"id":6,"arabic":"وَٱلْبَٰقِيَٰتُ","translit":"ُtَٰyِqَٰbْlٱَw","root":"بقي"},{"id":7,"arabic":"ٱلصَّٰلِحَٰتُ","translit":"ُtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":8,"arabic":"خَيْرٌ","translit":"ٌrْyَhk","root":"خير"},{"id":9,"arabic":"عِندَ","translit":"َdnِʿع","root":"عند"},{"id":10,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":11,"arabic":"ثَوَابًا","translit":"āًbāَwَht","root":"ثوب"},{"id":12,"arabic":"وَخَيْرٌ","translit":"ٌrْyَhkَw","root":"خير"},{"id":13,"arabic":"أَمَلًا","translit":"āًlَmَaʾ","root":"امل"}],"hasIhya":true},{"ayah":47,"text":"وَيَوْمَ نُسَيِّرُ ٱلْجِبَالَ وَتَرَى ٱلْأَرْضَ بَارِزَةً وَحَشَرْنَٰهُمْ فَلَمْ نُغَادِرْ مِنْهُمْ أَحَدًا ","translation":"And [warn of] the Day when We will remove the mountains and you will see the earth exposed,[1] and We will gather them and not leave behind from them anyone.","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"نُسَيِّرُ","translit":"ُrِّyَsُn","root":"سير"},{"id":3,"arabic":"ٱلْجِبَالَ","translit":"َlāَbِjgْlٱ","root":"جبل"},{"id":4,"arabic":"وَتَرَى","translit":"àَrَtَw","root":"راي"},{"id":5,"arabic":"ٱلْأَرْضَ","translit":"َḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"بَارِزَةً","translit":"ًẗَzِrāَb","root":"برز"},{"id":7,"arabic":"وَحَشَرْنَٰهُمْ","translit":"ْmُhَٰnْrَhsَḥَw","root":"حشر"},{"id":8,"arabic":"فَلَمْ","translit":"ْmَlَf","root":""},{"id":9,"arabic":"نُغَادِرْ","translit":"ْrِdāَغُn","root":"غدر"},{"id":10,"arabic":"مِنْهُمْ","translit":"ْmُhْnِm","root":""},{"id":11,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":true},{"ayah":48,"text":"وَعُرِضُوا۟ عَلَىٰ رَبِّكَ صَفًّا لَّقَدْ جِئْتُمُونَا كَمَا خَلَقْنَٰكُمْ أَوَّلَ مَرَّةٍۭۚ بَلْ زَعَمْتُمْ أَلَّن نَّجْعَلَ لَكُم مَّوْعِدًا ","translation":"And they will be presented before your Lord in rows, [and He will say], \"You have certainly come to Us just as We created you the first time. But you claimed that We would never make for you an appointment.\"","words":[{"id":1,"arabic":"وَعُرِضُوا۟","translit":"۟āwُḍِrُʿعَw","root":"عرض"},{"id":2,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":3,"arabic":"رَبِّكَ","translit":"َkِّbَr","root":"ربب"},{"id":4,"arabic":"صَفًّا","translit":"āًّfَṣ","root":"صفف"},{"id":5,"arabic":"لَّقَدْ","translit":"ْdَqَّl","root":""},{"id":6,"arabic":"جِئْتُمُونَا","translit":"āَnwُmُtْyʾِjg","root":"جيا"},{"id":7,"arabic":"كَمَا","translit":"āَmَk","root":""},{"id":8,"arabic":"خَلَقْنَٰكُمْ","translit":"ْmُkَٰnْqَlَhk","root":"خلق"},{"id":9,"arabic":"أَوَّلَ","translit":"َlَّwَaʾ","root":"اول"},{"id":10,"arabic":"مَرَّةٍۭ","translit":"ٍۭẗَّrَm","root":"مرر"},{"id":11,"arabic":"بَلْ","translit":"ْlَb","root":""},{"id":12,"arabic":"زَعَمْتُمْ","translit":"ْmُtْmَʿعَz","root":"زعم"},{"id":13,"arabic":"أَلَّن","translit":"nَّlَaʾ","root":""},{"id":14,"arabic":"نَّجْعَلَ","translit":"َlَʿعْjgَّn","root":"جعل"},{"id":15,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":16,"arabic":"مَّوْعِدًا","translit":"āًdِʿعْwَّm","root":"وعد"}],"hasIhya":false},{"ayah":49,"text":"وَوُضِعَ ٱلْكِتَٰبُ فَتَرَى ٱلْمُجْرِمِينَ مُشْفِقِينَ مِمَّا فِيهِ وَيَقُولُونَ يَٰوَيْلَتَنَا مَالِ هَٰذَا ٱلْكِتَٰبِ لَا يُغَادِرُ صَغِيرَةً وَلَا كَبِيرَةً إِلَّآ أَحْصَىٰهَاۚ وَوَجَدُوا۟ مَا عَمِلُوا۟ حَاضِرًاۗ وَلَا يَظْلِمُ رَبُّكَ أَحَدًا ","translation":"And the record [of deeds] will be placed [open], and you will see the criminals fearful of that within it, and they will say, \"Oh, woe to us! What is this book that leaves nothing small or great except that it has enumerated it?\" And they will find what they did present [before them]. And your Lord does injustice to no one.","words":[{"id":1,"arabic":"وَوُضِعَ","translit":"َʿعِḍُwَw","root":"وضع"},{"id":2,"arabic":"ٱلْكِتَٰبُ","translit":"ُbَٰtِkْlٱ","root":"كتب"},{"id":3,"arabic":"فَتَرَى","translit":"àَrَtَf","root":"راي"},{"id":4,"arabic":"ٱلْمُجْرِمِينَ","translit":"َnyِmِrْjgُmْlٱ","root":"جرم"},{"id":5,"arabic":"مُشْفِقِينَ","translit":"َnyِqِfْhsُm","root":"شفق"},{"id":6,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":7,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":8,"arabic":"وَيَقُولُونَ","translit":"َnwُlwُqَyَw","root":"قول"},{"id":9,"arabic":"يَٰوَيْلَتَنَا","translit":"āَnَtَlْyَwَٰy","root":""},{"id":10,"arabic":"مَالِ","translit":"ِlāَm","root":""},{"id":11,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":12,"arabic":"ٱلْكِتَٰبِ","translit":"ِbَٰtِkْlٱ","root":"كتب"},{"id":13,"arabic":"لَا","translit":"āَl","root":""},{"id":14,"arabic":"يُغَادِرُ","translit":"ُrِdāَغُy","root":"غدر"},{"id":15,"arabic":"صَغِيرَةً","translit":"ًẗَryِغَṣ","root":"صغر"},{"id":16,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":17,"arabic":"كَبِيرَةً","translit":"ًẗَryِbَk","root":"كبر"},{"id":18,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":19,"arabic":"أَحْصَىٰهَا","translit":"āَhٰàَṣْḥَaʾ","root":"حصي"},{"id":20,"arabic":"وَوَجَدُوا۟","translit":"۟āwُdَjgَwَw","root":"وجد"},{"id":21,"arabic":"مَا","translit":"āَm","root":""},{"id":22,"arabic":"عَمِلُوا۟","translit":"۟āwُlِmَʿع","root":"عمل"},{"id":23,"arabic":"حَاضِرًا","translit":"āًrِḍāَḥ","root":"حضر"},{"id":24,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":25,"arabic":"يَظْلِمُ","translit":"ُmِlْẓَy","root":"ظلم"},{"id":26,"arabic":"رَبُّكَ","translit":"َkُّbَr","root":"ربب"},{"id":27,"arabic":"أَحَدًا","translit":"āًdَḥَaʾ","root":"احد"}],"hasIhya":true},{"ayah":50,"text":"وَإِذْ قُلْنَا لِلْمَلَٰٓئِكَةِ ٱسْجُدُوا۟ لِءَادَمَ فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ كَانَ مِنَ ٱلْجِنِّ فَفَسَقَ عَنْ أَمْرِ رَبِّهِۦٓۗ أَفَتَتَّخِذُونَهُۥ وَذُرِّيَّتَهُۥٓ أَوْلِيَآءَ مِن دُونِى وَهُمْ لَكُمْ عَدُوٌّۢۚ بِئْسَ لِلظَّٰلِمِينَ بَدَلًا ","translation":"And [mention] when We said to the angels, \"Prostrate to Adam,\" and they prostrated, except for Iblees. He was of the jinn and departed from [i.e., disobeyed] the command of his Lord. Then will you take him and his descendants as allies other than Me while they are enemies to you? Wretched it is for the wrongdoers as an exchange.","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"قُلْنَا","translit":"āَnْlُq","root":"قول"},{"id":3,"arabic":"لِلْمَلَٰٓئِكَةِ","translit":"ِẗَkِyʾَٰٓlَmْlِl","root":"ملك"},{"id":4,"arabic":"ٱسْجُدُوا۟","translit":"۟āwُdُjgْsٱ","root":"سجد"},{"id":5,"arabic":"لِءَادَمَ","translit":"َmَdāَءِl","root":"ادم"},{"id":6,"arabic":"فَسَجَدُوٓا۟","translit":"۟āٓwُdَjgَsَf","root":"سجد"},{"id":7,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":8,"arabic":"إِبْلِيسَ","translit":"َsyِlْbِiʾ","root":""},{"id":9,"arabic":"كَانَ","translit":"َnāَk","root":"كون"},{"id":10,"arabic":"مِنَ","translit":"َnِm","root":""},{"id":11,"arabic":"ٱلْجِنِّ","translit":"ِّnِjgْlٱ","root":"جنن"},{"id":12,"arabic":"فَفَسَقَ","translit":"َqَsَfَf","root":"فسق"},{"id":13,"arabic":"عَنْ","translit":"ْnَʿع","root":""},{"id":14,"arabic":"أَمْرِ","translit":"ِrْmَaʾ","root":"امر"},{"id":15,"arabic":"رَبِّهِۦٓ","translit":"ٓۦِhِّbَr","root":"ربب"},{"id":16,"arabic":"أَفَتَتَّخِذُونَهُۥ","translit":"ۥُhَnwُhdِhkَّtَtَfَaʾ","root":"اخذ"},{"id":17,"arabic":"وَذُرِّيَّتَهُۥٓ","translit":"ٓۥُhَtَّyِّrُhdَw","root":"ذرر"},{"id":18,"arabic":"أَوْلِيَآءَ","translit":"َءٓāَyِlْwَaʾ","root":"ولي"},{"id":19,"arabic":"مِن","translit":"nِm","root":""},{"id":20,"arabic":"دُونِى","translit":"àِnwُd","root":"دون"},{"id":21,"arabic":"وَهُمْ","translit":"ْmُhَw","root":""},{"id":22,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":23,"arabic":"عَدُوٌّۢ","translit":"ٌّۢwُdَʿع","root":"عدو"},{"id":24,"arabic":"بِئْسَ","translit":"َsْyʾِb","root":"باس"},{"id":25,"arabic":"لِلظَّٰلِمِينَ","translit":"َnyِmِlَّٰẓlِl","root":"ظلم"},{"id":26,"arabic":"بَدَلًا","translit":"āًlَdَb","root":"بدل"}],"hasIhya":true},{"ayah":51,"text":"مَّآ أَشْهَدتُّهُمْ خَلْقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَلَا خَلْقَ أَنفُسِهِمْ وَمَا كُنتُ مُتَّخِذَ ٱلْمُضِلِّينَ عَضُدًا ","translation":"I did not make them witness to the creation of the heavens and the earth or to the creation of themselves, and I would not have taken the misguiders as assistants.","words":[{"id":1,"arabic":"مَّآ","translit":"ٓāَّm","root":""},{"id":2,"arabic":"أَشْهَدتُّهُمْ","translit":"ْmُhُّtdَhْhsَaʾ","root":"شهد"},{"id":3,"arabic":"خَلْقَ","translit":"َqْlَhk","root":"خلق"},{"id":4,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":5,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"خَلْقَ","translit":"َqْlَhk","root":"خلق"},{"id":8,"arabic":"أَنفُسِهِمْ","translit":"ْmِhِsُfnَaʾ","root":"نفس"},{"id":9,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":10,"arabic":"كُنتُ","translit":"ُtnُk","root":"كون"},{"id":11,"arabic":"مُتَّخِذَ","translit":"َhdِhkَّtُm","root":"اخذ"},{"id":12,"arabic":"ٱلْمُضِلِّينَ","translit":"َnyِّlِḍُmْlٱ","root":"ضلل"},{"id":13,"arabic":"عَضُدًا","translit":"āًdُḍَʿع","root":"عضد"}],"hasIhya":false},{"ayah":52,"text":"وَيَوْمَ يَقُولُ نَادُوا۟ شُرَكَآءِىَ ٱلَّذِينَ زَعَمْتُمْ فَدَعَوْهُمْ فَلَمْ يَسْتَجِيبُوا۟ لَهُمْ وَجَعَلْنَا بَيْنَهُم مَّوْبِقًا ","translation":"And [warn of] the Day when He will say, \"Call My 'partners' whom you claimed,\" and they will invoke them, but they will not respond to them. And We will put between them [a valley of] destruction.","words":[{"id":1,"arabic":"وَيَوْمَ","translit":"َmْwَyَw","root":"يوم"},{"id":2,"arabic":"يَقُولُ","translit":"ُlwُqَy","root":"قول"},{"id":3,"arabic":"نَادُوا۟","translit":"۟āwُdāَn","root":"ندي"},{"id":4,"arabic":"شُرَكَآءِىَ","translit":"َàِءٓāَkَrُhs","root":"شرك"},{"id":5,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":6,"arabic":"زَعَمْتُمْ","translit":"ْmُtْmَʿعَz","root":"زعم"},{"id":7,"arabic":"فَدَعَوْهُمْ","translit":"ْmُhْwَʿعَdَf","root":"دعو"},{"id":8,"arabic":"فَلَمْ","translit":"ْmَlَf","root":""},{"id":9,"arabic":"يَسْتَجِيبُوا۟","translit":"۟āwُbyِjgَtْsَy","root":"جوب"},{"id":10,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":11,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":12,"arabic":"بَيْنَهُم","translit":"mُhَnْyَb","root":"بين"},{"id":13,"arabic":"مَّوْبِقًا","translit":"āًqِbْwَّm","root":"وبق"}],"hasIhya":false},{"ayah":53,"text":"وَرَءَا ٱلْمُجْرِمُونَ ٱلنَّارَ فَظَنُّوٓا۟ أَنَّهُم مُّوَاقِعُوهَا وَلَمْ يَجِدُوا۟ عَنْهَا مَصْرِفًا ","translation":"And the criminals will see the Fire and will be certain that they are to fall therein. And they will not find from it a way elsewhere.","words":[{"id":1,"arabic":"وَرَءَا","translit":"āَءَrَw","root":"راي"},{"id":2,"arabic":"ٱلْمُجْرِمُونَ","translit":"َnwُmِrْjgُmْlٱ","root":"جرم"},{"id":3,"arabic":"ٱلنَّارَ","translit":"َrāَّnlٱ","root":"نور"},{"id":4,"arabic":"فَظَنُّوٓا۟","translit":"۟āٓwُّnَẓَf","root":"ظنن"},{"id":5,"arabic":"أَنَّهُم","translit":"mُhَّnَaʾ","root":""},{"id":6,"arabic":"مُّوَاقِعُوهَا","translit":"āَhwُʿعِqāَwُّm","root":"وقع"},{"id":7,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":8,"arabic":"يَجِدُوا۟","translit":"۟āwُdِjgَy","root":"وجد"},{"id":9,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":10,"arabic":"مَصْرِفًا","translit":"āًfِrْṣَm","root":"صرف"}],"hasIhya":false},{"ayah":54,"text":"وَلَقَدْ صَرَّفْنَا فِى هَٰذَا ٱلْقُرْءَانِ لِلنَّاسِ مِن كُلِّ مَثَلٍۚ وَكَانَ ٱلْإِنسَٰنُ أَكْثَرَ شَىْءٍ جَدَلًا ","translation":"And We have certainly diversified in this Qur’ān for the people from every [kind of] example; but man has ever been, most of anything, [prone to] dispute.","words":[{"id":1,"arabic":"وَلَقَدْ","translit":"ْdَqَlَw","root":""},{"id":2,"arabic":"صَرَّفْنَا","translit":"āَnْfَّrَṣ","root":"صرف"},{"id":3,"arabic":"فِى","translit":"àِf","root":""},{"id":4,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":5,"arabic":"ٱلْقُرْءَانِ","translit":"ِnāَءْrُqْlٱ","root":"قرا"},{"id":6,"arabic":"لِلنَّاسِ","translit":"ِsāَّnlِl","root":"انس"},{"id":7,"arabic":"مِن","translit":"nِm","root":""},{"id":8,"arabic":"كُلِّ","translit":"ِّlُk","root":"كلل"},{"id":9,"arabic":"مَثَلٍ","translit":"ٍlَhtَm","root":"مثل"},{"id":10,"arabic":"وَكَانَ","translit":"َnāَkَw","root":"كون"},{"id":11,"arabic":"ٱلْإِنسَٰنُ","translit":"ُnَٰsnِiʾْlٱ","root":"انس"},{"id":12,"arabic":"أَكْثَرَ","translit":"َrَhtْkَaʾ","root":"كثر"},{"id":13,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":14,"arabic":"جَدَلًا","translit":"āًlَdَjg","root":"جدل"}],"hasIhya":true},{"ayah":55,"text":"وَمَا مَنَعَ ٱلنَّاسَ أَن يُؤْمِنُوٓا۟ إِذْ جَآءَهُمُ ٱلْهُدَىٰ وَيَسْتَغْفِرُوا۟ رَبَّهُمْ إِلَّآ أَن تَأْتِيَهُمْ سُنَّةُ ٱلْأَوَّلِينَ أَوْ يَأْتِيَهُمُ ٱلْعَذَابُ قُبُلًا ","translation":"And nothing has prevented the people from believing when guidance came to them and from asking forgiveness of their Lord except that there [must] befall them the [accustomed] precedent of the former peoples[1] or that the punishment should come [directly] before them.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"مَنَعَ","translit":"َʿعَnَm","root":"منع"},{"id":3,"arabic":"ٱلنَّاسَ","translit":"َsāَّnlٱ","root":"انس"},{"id":4,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":5,"arabic":"يُؤْمِنُوٓا۟","translit":"۟āٓwُnِmْwʾُy","root":"امن"},{"id":6,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":7,"arabic":"جَآءَهُمُ","translit":"ُmُhَءٓāَjg","root":"جيا"},{"id":8,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":9,"arabic":"وَيَسْتَغْفِرُوا۟","translit":"۟āwُrِfْغَtْsَyَw","root":"غفر"},{"id":10,"arabic":"رَبَّهُمْ","translit":"ْmُhَّbَr","root":"ربب"},{"id":11,"arabic":"إِلَّآ","translit":"ٓāَّlِiʾ","root":""},{"id":12,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":13,"arabic":"تَأْتِيَهُمْ","translit":"ْmُhَyِtْaʾَt","root":"اتي"},{"id":14,"arabic":"سُنَّةُ","translit":"ُẗَّnُs","root":"سنن"},{"id":15,"arabic":"ٱلْأَوَّلِينَ","translit":"َnyِlَّwَaʾْlٱ","root":"اول"},{"id":16,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":17,"arabic":"يَأْتِيَهُمُ","translit":"ُmُhَyِtْaʾَy","root":"اتي"},{"id":18,"arabic":"ٱلْعَذَابُ","translit":"ُbāَhdَʿعْlٱ","root":"عذب"},{"id":19,"arabic":"قُبُلًا","translit":"āًlُbُq","root":"قبل"}],"hasIhya":false},{"ayah":56,"text":"وَمَا نُرْسِلُ ٱلْمُرْسَلِينَ إِلَّا مُبَشِّرِينَ وَمُنذِرِينَۚ وَيُجَٰدِلُ ٱلَّذِينَ كَفَرُوا۟ بِٱلْبَٰطِلِ لِيُدْحِضُوا۟ بِهِ ٱلْحَقَّۖ وَٱتَّخَذُوٓا۟ ءَايَٰتِى وَمَآ أُنذِرُوا۟ هُزُوًا ","translation":"And We send not the messengers except as bringers of good tidings and warners. And those who disbelieve dispute by [using] falsehood to [attempt to] invalidate thereby the truth and have taken My verses, and that of which they are warned, in ridicule.","words":[{"id":1,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":2,"arabic":"نُرْسِلُ","translit":"ُlِsْrُn","root":"رسل"},{"id":3,"arabic":"ٱلْمُرْسَلِينَ","translit":"َnyِlَsْrُmْlٱ","root":"رسل"},{"id":4,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":5,"arabic":"مُبَشِّرِينَ","translit":"َnyِrِّhsَbُm","root":"بشر"},{"id":6,"arabic":"وَمُنذِرِينَ","translit":"َnyِrِhdnُmَw","root":"نذر"},{"id":7,"arabic":"وَيُجَٰدِلُ","translit":"ُlِdَٰjgُyَw","root":"جدل"},{"id":8,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":9,"arabic":"كَفَرُوا۟","translit":"۟āwُrَfَk","root":"كفر"},{"id":10,"arabic":"بِٱلْبَٰطِلِ","translit":"ِlِṭَٰbْlٱِb","root":"بطل"},{"id":11,"arabic":"لِيُدْحِضُوا۟","translit":"۟āwُḍِḥْdُyِl","root":"دحض"},{"id":12,"arabic":"بِهِ","translit":"ِhِb","root":""},{"id":13,"arabic":"ٱلْحَقَّ","translit":"َّqَḥْlٱ","root":"حقق"},{"id":14,"arabic":"وَٱتَّخَذُوٓا۟","translit":"۟āٓwُhdَhkَّtٱَw","root":"اخذ"},{"id":15,"arabic":"ءَايَٰتِى","translit":"àِtَٰyāَء","root":"ايي"},{"id":16,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":17,"arabic":"أُنذِرُوا۟","translit":"۟āwُrِhdnُaʾ","root":"نذر"},{"id":18,"arabic":"هُزُوًا","translit":"āًwُzُh","root":"هزا"}],"hasIhya":false},{"ayah":57,"text":"وَمَنْ أَظْلَمُ مِمَّن ذُكِّرَ بِـَٔايَٰتِ رَبِّهِۦ فَأَعْرَضَ عَنْهَا وَنَسِىَ مَا قَدَّمَتْ يَدَاهُۚ إِنَّا جَعَلْنَا عَلَىٰ قُلُوبِهِمْ أَكِنَّةً أَن يَفْقَهُوهُ وَفِىٓ ءَاذَانِهِمْ وَقْرًاۖ وَإِن تَدْعُهُمْ إِلَى ٱلْهُدَىٰ فَلَن يَهْتَدُوٓا۟ إِذًا أَبَدًا ","translation":"And who is more unjust than one who is reminded of the verses of his Lord but turns away from them and forgets what his hands have put forth? Indeed, We have placed over their hearts coverings, lest they understand it, and in their ears deafness. And if you invite them to guidance - they will never be guided, then - ever.","words":[{"id":1,"arabic":"وَمَنْ","translit":"ْnَmَw","root":""},{"id":2,"arabic":"أَظْلَمُ","translit":"ُmَlْẓَaʾ","root":"ظلم"},{"id":3,"arabic":"مِمَّن","translit":"nَّmِm","root":""},{"id":4,"arabic":"ذُكِّرَ","translit":"َrِّkُhd","root":"ذكر"},{"id":5,"arabic":"بِـَٔايَٰتِ","translit":"ِtَٰyāَٔـِb","root":"ايي"},{"id":6,"arabic":"رَبِّهِۦ","translit":"ۦِhِّbَr","root":"ربب"},{"id":7,"arabic":"فَأَعْرَضَ","translit":"َḍَrْʿعَaʾَf","root":"عرض"},{"id":8,"arabic":"عَنْهَا","translit":"āَhْnَʿع","root":""},{"id":9,"arabic":"وَنَسِىَ","translit":"َàِsَnَw","root":"نسي"},{"id":10,"arabic":"مَا","translit":"āَm","root":""},{"id":11,"arabic":"قَدَّمَتْ","translit":"ْtَmَّdَq","root":"قدم"},{"id":12,"arabic":"يَدَاهُ","translit":"ُhāَdَy","root":"يدي"},{"id":13,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":14,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":15,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":16,"arabic":"قُلُوبِهِمْ","translit":"ْmِhِbwُlُq","root":"قلب"},{"id":17,"arabic":"أَكِنَّةً","translit":"ًẗَّnِkَaʾ","root":"كنن"},{"id":18,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":19,"arabic":"يَفْقَهُوهُ","translit":"ُhwُhَqْfَy","root":"فقه"},{"id":20,"arabic":"وَفِىٓ","translit":"ٓàِfَw","root":""},{"id":21,"arabic":"ءَاذَانِهِمْ","translit":"ْmِhِnāَhdāَء","root":"اذن"},{"id":22,"arabic":"وَقْرًا","translit":"āًrْqَw","root":"وقر"},{"id":23,"arabic":"وَإِن","translit":"nِiʾَw","root":""},{"id":24,"arabic":"تَدْعُهُمْ","translit":"ْmُhُʿعْdَt","root":"دعو"},{"id":25,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":26,"arabic":"ٱلْهُدَىٰ","translit":"ٰàَdُhْlٱ","root":"هدي"},{"id":27,"arabic":"فَلَن","translit":"nَlَf","root":""},{"id":28,"arabic":"يَهْتَدُوٓا۟","translit":"۟āٓwُdَtْhَy","root":"هدي"},{"id":29,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":30,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"}],"hasIhya":false},{"ayah":58,"text":"وَرَبُّكَ ٱلْغَفُورُ ذُو ٱلرَّحْمَةِۖ لَوْ يُؤَاخِذُهُم بِمَا كَسَبُوا۟ لَعَجَّلَ لَهُمُ ٱلْعَذَابَۚ بَل لَّهُم مَّوْعِدٌ لَّن يَجِدُوا۟ مِن دُونِهِۦ مَوْئِلًا ","translation":"And your Lord is the Forgiving, the possessor of mercy. If He were to impose blame upon them for what they earned, He would have hastened for them the punishment. Rather, for them is an appointment from which they will never find an escape.","words":[{"id":1,"arabic":"وَرَبُّكَ","translit":"َkُّbَrَw","root":"ربب"},{"id":2,"arabic":"ٱلْغَفُورُ","translit":"ُrwُfَغْlٱ","root":"غفر"},{"id":3,"arabic":"ذُو","translit":"wُhd","root":""},{"id":4,"arabic":"ٱلرَّحْمَةِ","translit":"ِẗَmْḥَّrlٱ","root":"رحم"},{"id":5,"arabic":"لَوْ","translit":"ْwَl","root":""},{"id":6,"arabic":"يُؤَاخِذُهُم","translit":"mُhُhdِhkāَwʾُy","root":"اخذ"},{"id":7,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":8,"arabic":"كَسَبُوا۟","translit":"۟āwُbَsَk","root":"كسب"},{"id":9,"arabic":"لَعَجَّلَ","translit":"َlَّjgَʿعَl","root":"عجل"},{"id":10,"arabic":"لَهُمُ","translit":"ُmُhَl","root":""},{"id":11,"arabic":"ٱلْعَذَابَ","translit":"َbāَhdَʿعْlٱ","root":"عذب"},{"id":12,"arabic":"بَل","translit":"lَb","root":""},{"id":13,"arabic":"لَّهُم","translit":"mُhَّl","root":""},{"id":14,"arabic":"مَّوْعِدٌ","translit":"ٌdِʿعْwَّm","root":"وعد"},{"id":15,"arabic":"لَّن","translit":"nَّl","root":""},{"id":16,"arabic":"يَجِدُوا۟","translit":"۟āwُdِjgَy","root":"وجد"},{"id":17,"arabic":"مِن","translit":"nِm","root":""},{"id":18,"arabic":"دُونِهِۦ","translit":"ۦِhِnwُd","root":"دون"},{"id":19,"arabic":"مَوْئِلًا","translit":"āًlِyʾْwَm","root":"وال"}],"hasIhya":false},{"ayah":59,"text":"وَتِلْكَ ٱلْقُرَىٰٓ أَهْلَكْنَٰهُمْ لَمَّا ظَلَمُوا۟ وَجَعَلْنَا لِمَهْلِكِهِم مَّوْعِدًا ","translation":"And those cities - We destroyed them when they wronged, and We made for their destruction an appointed time.","words":[{"id":1,"arabic":"وَتِلْكَ","translit":"َkْlِtَw","root":""},{"id":2,"arabic":"ٱلْقُرَىٰٓ","translit":"ٰٓàَrُqْlٱ","root":"قري"},{"id":3,"arabic":"أَهْلَكْنَٰهُمْ","translit":"ْmُhَٰnْkَlْhَaʾ","root":"هلك"},{"id":4,"arabic":"لَمَّا","translit":"āَّmَl","root":""},{"id":5,"arabic":"ظَلَمُوا۟","translit":"۟āwُmَlَẓ","root":"ظلم"},{"id":6,"arabic":"وَجَعَلْنَا","translit":"āَnْlَʿعَjgَw","root":"جعل"},{"id":7,"arabic":"لِمَهْلِكِهِم","translit":"mِhِkِlْhَmِl","root":"هلك"},{"id":8,"arabic":"مَّوْعِدًا","translit":"āًdِʿعْwَّm","root":"وعد"}],"hasIhya":false},{"ayah":60,"text":"وَإِذْ قَالَ مُوسَىٰ لِفَتَىٰهُ لَآ أَبْرَحُ حَتَّىٰٓ أَبْلُغَ مَجْمَعَ ٱلْبَحْرَيْنِ أَوْ أَمْضِىَ حُقُبًا ","translation":"And [mention] when Moses said to his boy [i.e., servant], \"I will not cease [traveling] until I reach the junction of the two seas or continue for a long period.\"","words":[{"id":1,"arabic":"وَإِذْ","translit":"ْhdِiʾَw","root":""},{"id":2,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":3,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":4,"arabic":"لِفَتَىٰهُ","translit":"ُhٰàَtَfِl","root":"فتي"},{"id":5,"arabic":"لَآ","translit":"ٓāَl","root":""},{"id":6,"arabic":"أَبْرَحُ","translit":"ُḥَrْbَaʾ","root":"برح"},{"id":7,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":8,"arabic":"أَبْلُغَ","translit":"َغُlْbَaʾ","root":"بلغ"},{"id":9,"arabic":"مَجْمَعَ","translit":"َʿعَmْjgَm","root":"جمع"},{"id":10,"arabic":"ٱلْبَحْرَيْنِ","translit":"ِnْyَrْḥَbْlٱ","root":"بحر"},{"id":11,"arabic":"أَوْ","translit":"ْwَaʾ","root":""},{"id":12,"arabic":"أَمْضِىَ","translit":"َàِḍْmَaʾ","root":"مضي"},{"id":13,"arabic":"حُقُبًا","translit":"āًbُqُḥ","root":"حقب"}],"hasIhya":false},{"ayah":61,"text":"فَلَمَّا بَلَغَا مَجْمَعَ بَيْنِهِمَا نَسِيَا حُوتَهُمَا فَٱتَّخَذَ سَبِيلَهُۥ فِى ٱلْبَحْرِ سَرَبًا ","translation":"But when they reached the junction between them, they forgot their fish, and it took its course into the sea, slipping away.","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"بَلَغَا","translit":"āَغَlَb","root":"بلغ"},{"id":3,"arabic":"مَجْمَعَ","translit":"َʿعَmْjgَm","root":"جمع"},{"id":4,"arabic":"بَيْنِهِمَا","translit":"āَmِhِnْyَb","root":"بين"},{"id":5,"arabic":"نَسِيَا","translit":"āَyِsَn","root":"نسي"},{"id":6,"arabic":"حُوتَهُمَا","translit":"āَmُhَtwُḥ","root":"حوت"},{"id":7,"arabic":"فَٱتَّخَذَ","translit":"َhdَhkَّtٱَf","root":"اخذ"},{"id":8,"arabic":"سَبِيلَهُۥ","translit":"ۥُhَlyِbَs","root":"سبل"},{"id":9,"arabic":"فِى","translit":"àِf","root":""},{"id":10,"arabic":"ٱلْبَحْرِ","translit":"ِrْḥَbْlٱ","root":"بحر"},{"id":11,"arabic":"سَرَبًا","translit":"āًbَrَs","root":"سرب"}],"hasIhya":false},{"ayah":62,"text":"فَلَمَّا جَاوَزَا قَالَ لِفَتَىٰهُ ءَاتِنَا غَدَآءَنَا لَقَدْ لَقِينَا مِن سَفَرِنَا هَٰذَا نَصَبًا ","translation":"So when they had passed beyond it, [Moses] said to his boy, \"Bring us our morning meal. We have certainly suffered in this, our journey, [much] fatigue.\"","words":[{"id":1,"arabic":"فَلَمَّا","translit":"āَّmَlَf","root":""},{"id":2,"arabic":"جَاوَزَا","translit":"āَzَwāَjg","root":"جوز"},{"id":3,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":4,"arabic":"لِفَتَىٰهُ","translit":"ُhٰàَtَfِl","root":"فتي"},{"id":5,"arabic":"ءَاتِنَا","translit":"āَnِtāَء","root":"اتي"},{"id":6,"arabic":"غَدَآءَنَا","translit":"āَnَءٓāَdَغ","root":"غدو"},{"id":7,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":8,"arabic":"لَقِينَا","translit":"āَnyِqَl","root":"لقي"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"سَفَرِنَا","translit":"āَnِrَfَs","root":"سفر"},{"id":11,"arabic":"هَٰذَا","translit":"āَhdَٰh","root":""},{"id":12,"arabic":"نَصَبًا","translit":"āًbَṣَn","root":"نصب"}],"hasIhya":false},{"ayah":63,"text":"قَالَ أَرَءَيْتَ إِذْ أَوَيْنَآ إِلَى ٱلصَّخْرَةِ فَإِنِّى نَسِيتُ ٱلْحُوتَ وَمَآ أَنسَىٰنِيهُ إِلَّا ٱلشَّيْطَٰنُ أَنْ أَذْكُرَهُۥۚ وَٱتَّخَذَ سَبِيلَهُۥ فِى ٱلْبَحْرِ عَجَبًا ","translation":"He said, \"Did you see when we retired to the rock? Indeed, I forgot [there] the fish. And none made me forget it except Satan - that I should mention it. And it took its course into the sea amazingly.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"أَرَءَيْتَ","translit":"َtْyَءَrَaʾ","root":"راي"},{"id":3,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":4,"arabic":"أَوَيْنَآ","translit":"ٓāَnْyَwَaʾ","root":"اوي"},{"id":5,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":6,"arabic":"ٱلصَّخْرَةِ","translit":"ِẗَrْhkَّṣlٱ","root":"صخر"},{"id":7,"arabic":"فَإِنِّى","translit":"àِّnِiʾَf","root":""},{"id":8,"arabic":"نَسِيتُ","translit":"ُtyِsَn","root":"نسي"},{"id":9,"arabic":"ٱلْحُوتَ","translit":"َtwُḥْlٱ","root":"حوت"},{"id":10,"arabic":"وَمَآ","translit":"ٓāَmَw","root":""},{"id":11,"arabic":"أَنسَىٰنِيهُ","translit":"ُhyِnٰàَsnَaʾ","root":"نسي"},{"id":12,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":13,"arabic":"ٱلشَّيْطَٰنُ","translit":"ُnَٰṭْyَّhslٱ","root":"شطن"},{"id":14,"arabic":"أَنْ","translit":"ْnَaʾ","root":""},{"id":15,"arabic":"أَذْكُرَهُۥ","translit":"ۥُhَrُkْhdَaʾ","root":"ذكر"},{"id":16,"arabic":"وَٱتَّخَذَ","translit":"َhdَhkَّtٱَw","root":"اخذ"},{"id":17,"arabic":"سَبِيلَهُۥ","translit":"ۥُhَlyِbَs","root":"سبل"},{"id":18,"arabic":"فِى","translit":"àِf","root":""},{"id":19,"arabic":"ٱلْبَحْرِ","translit":"ِrْḥَbْlٱ","root":"بحر"},{"id":20,"arabic":"عَجَبًا","translit":"āًbَjgَʿع","root":"عجب"}],"hasIhya":false},{"ayah":64,"text":"قَالَ ذَٰلِكَ مَا كُنَّا نَبْغِۚ فَٱرْتَدَّا عَلَىٰٓ ءَاثَارِهِمَا قَصَصًا ","translation":"[Moses] said, \"That is what we were seeking.\" So they returned, following their footprints.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"ذَٰلِكَ","translit":"َkِlَٰhd","root":""},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"كُنَّا","translit":"āَّnُk","root":"كون"},{"id":5,"arabic":"نَبْغِ","translit":"ِغْbَn","root":"بغي"},{"id":6,"arabic":"فَٱرْتَدَّا","translit":"āَّdَtْrٱَf","root":"ردد"},{"id":7,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":8,"arabic":"ءَاثَارِهِمَا","translit":"āَmِhِrāَhtāَء","root":"اثر"},{"id":9,"arabic":"قَصَصًا","translit":"āًṣَṣَq","root":"قصص"}],"hasIhya":false},{"ayah":65,"text":"فَوَجَدَا عَبْدًا مِّنْ عِبَادِنَآ ءَاتَيْنَٰهُ رَحْمَةً مِّنْ عِندِنَا وَعَلَّمْنَٰهُ مِن لَّدُنَّا عِلْمًا ","translation":"And they found a servant from among Our servants [i.e., al-Khiḍr] to whom We had given mercy from Us and had taught him from Us a [certain] knowledge.","words":[{"id":1,"arabic":"فَوَجَدَا","translit":"āَdَjgَwَf","root":"وجد"},{"id":2,"arabic":"عَبْدًا","translit":"āًdْbَʿع","root":"عبد"},{"id":3,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":4,"arabic":"عِبَادِنَآ","translit":"ٓāَnِdāَbِʿع","root":"عبد"},{"id":5,"arabic":"ءَاتَيْنَٰهُ","translit":"ُhَٰnْyَtāَء","root":"اتي"},{"id":6,"arabic":"رَحْمَةً","translit":"ًẗَmْḥَr","root":"رحم"},{"id":7,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":8,"arabic":"عِندِنَا","translit":"āَnِdnِʿع","root":"عند"},{"id":9,"arabic":"وَعَلَّمْنَٰهُ","translit":"ُhَٰnْmَّlَʿعَw","root":"علم"},{"id":10,"arabic":"مِن","translit":"nِm","root":""},{"id":11,"arabic":"لَّدُنَّا","translit":"āَّnُdَّl","root":"لدن"},{"id":12,"arabic":"عِلْمًا","translit":"āًmْlِʿع","root":"علم"}],"hasIhya":true},{"ayah":66,"text":"قَالَ لَهُۥ مُوسَىٰ هَلْ أَتَّبِعُكَ عَلَىٰٓ أَن تُعَلِّمَنِ مِمَّا عُلِّمْتَ رُشْدًا ","translation":"Moses said to him, \"May I follow you on [the condition] that you teach me from what you have been taught of sound judgement?\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"لَهُۥ","translit":"ۥُhَl","root":""},{"id":3,"arabic":"مُوسَىٰ","translit":"ٰàَswُm","root":""},{"id":4,"arabic":"هَلْ","translit":"ْlَh","root":""},{"id":5,"arabic":"أَتَّبِعُكَ","translit":"َkُʿعِbَّtَaʾ","root":"تبع"},{"id":6,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":7,"arabic":"أَن","translit":"nَaʾ","root":""},{"id":8,"arabic":"تُعَلِّمَنِ","translit":"ِnَmِّlَʿعُt","root":"علم"},{"id":9,"arabic":"مِمَّا","translit":"āَّmِm","root":""},{"id":10,"arabic":"عُلِّمْتَ","translit":"َtْmِّlُʿع","root":"علم"},{"id":11,"arabic":"رُشْدًا","translit":"āًdْhsُr","root":"رشد"}],"hasIhya":false},{"ayah":67,"text":"قَالَ إِنَّكَ لَن تَسْتَطِيعَ مَعِىَ صَبْرًا ","translation":"He said, \"Indeed, with me you will never be able to have patience.","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":3,"arabic":"لَن","translit":"nَl","root":""},{"id":4,"arabic":"تَسْتَطِيعَ","translit":"َʿعyِṭَtْsَt","root":"طوع"},{"id":5,"arabic":"مَعِىَ","translit":"َàِʿعَm","root":""},{"id":6,"arabic":"صَبْرًا","translit":"āًrْbَṣ","root":"صبر"}],"hasIhya":true},{"ayah":68,"text":"وَكَيْفَ تَصْبِرُ عَلَىٰ مَا لَمْ تُحِطْ بِهِۦ خُبْرًا ","translation":"And how can you have patience for what you do not encompass in knowledge?\"","words":[{"id":1,"arabic":"وَكَيْفَ","translit":"َfْyَkَw","root":"كيف"},{"id":2,"arabic":"تَصْبِرُ","translit":"ُrِbْṣَt","root":"صبر"},{"id":3,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":4,"arabic":"مَا","translit":"āَm","root":""},{"id":5,"arabic":"لَمْ","translit":"ْmَl","root":""},{"id":6,"arabic":"تُحِطْ","translit":"ْṭِḥُt","root":"حوط"},{"id":7,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":8,"arabic":"خُبْرًا","translit":"āًrْbُhk","root":"خبر"}],"hasIhya":true},{"ayah":69,"text":"قَالَ سَتَجِدُنِىٓ إِن شَآءَ ٱللَّهُ صَابِرًا وَلَآ أَعْصِى لَكَ أَمْرًا ","translation":"[Moses] said, \"You will find me, if Allāh wills, patient, and I will not disobey you in [any] order.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"سَتَجِدُنِىٓ","translit":"ٓàِnُdِjgَtَs","root":"وجد"},{"id":3,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":4,"arabic":"شَآءَ","translit":"َءٓāَhs","root":"شيا"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"صَابِرًا","translit":"āًrِbāَṣ","root":"صبر"},{"id":7,"arabic":"وَلَآ","translit":"ٓāَlَw","root":""},{"id":8,"arabic":"أَعْصِى","translit":"àِṣْʿعَaʾ","root":"عصي"},{"id":9,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":10,"arabic":"أَمْرًا","translit":"āًrْmَaʾ","root":"امر"}],"hasIhya":false},{"ayah":70,"text":"قَالَ فَإِنِ ٱتَّبَعْتَنِى فَلَا تَسْـَٔلْنِى عَن شَىْءٍ حَتَّىٰٓ أُحْدِثَ لَكَ مِنْهُ ذِكْرًا ","translation":"He said, \"Then if you follow me, do not ask me about anything until I make to you about it mention [i.e., explanation].\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"فَإِنِ","translit":"ِnِiʾَf","root":""},{"id":3,"arabic":"ٱتَّبَعْتَنِى","translit":"àِnَtْʿعَbَّtٱ","root":"تبع"},{"id":4,"arabic":"فَلَا","translit":"āَlَf","root":""},{"id":5,"arabic":"تَسْـَٔلْنِى","translit":"àِnْlَٔـْsَt","root":"سال"},{"id":6,"arabic":"عَن","translit":"nَʿع","root":""},{"id":7,"arabic":"شَىْءٍ","translit":"ٍءْàَhs","root":"شيا"},{"id":8,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":9,"arabic":"أُحْدِثَ","translit":"َhtِdْḥُaʾ","root":"حدث"},{"id":10,"arabic":"لَكَ","translit":"َkَl","root":""},{"id":11,"arabic":"مِنْهُ","translit":"ُhْnِm","root":""},{"id":12,"arabic":"ذِكْرًا","translit":"āًrْkِhd","root":"ذكر"}],"hasIhya":true},{"ayah":71,"text":"فَٱنطَلَقَا حَتَّىٰٓ إِذَا رَكِبَا فِى ٱلسَّفِينَةِ خَرَقَهَاۖ قَالَ أَخَرَقْتَهَا لِتُغْرِقَ أَهْلَهَا لَقَدْ جِئْتَ شَيْـًٔا إِمْرًا ","translation":"So they set out, until when they had embarked on the ship, he [i.e., al-Khiḍr] tore it open. [Moses] said, \"Have you torn it open to drown its people? You have certainly done a grave thing.\"","words":[{"id":1,"arabic":"فَٱنطَلَقَا","translit":"āَqَlَṭnٱَf","root":"طلق"},{"id":2,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":3,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":4,"arabic":"رَكِبَا","translit":"āَbِkَr","root":"ركب"},{"id":5,"arabic":"فِى","translit":"àِf","root":""},{"id":6,"arabic":"ٱلسَّفِينَةِ","translit":"ِẗَnyِfَّslٱ","root":"سفن"},{"id":7,"arabic":"خَرَقَهَا","translit":"āَhَqَrَhk","root":"خرق"},{"id":8,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":9,"arabic":"أَخَرَقْتَهَا","translit":"āَhَtْqَrَhkَaʾ","root":"خرق"},{"id":10,"arabic":"لِتُغْرِقَ","translit":"َqِrْغُtِl","root":"غرق"},{"id":11,"arabic":"أَهْلَهَا","translit":"āَhَlْhَaʾ","root":"اهل"},{"id":12,"arabic":"لَقَدْ","translit":"ْdَqَl","root":""},{"id":13,"arabic":"جِئْتَ","translit":"َtْyʾِjg","root":"جيا"},{"id":14,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"id":15,"arabic":"إِمْرًا","translit":"āًrْmِiʾ","root":"امر"}],"hasIhya":false},{"ayah":72,"text":"قَالَ أَلَمْ أَقُلْ إِنَّكَ لَن تَسْتَطِيعَ مَعِىَ صَبْرًا ","translation":"[Al-Khiḍr] said, \"Did I not say that with me you would never be able to have patience?\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"أَلَمْ","translit":"ْmَlَaʾ","root":""},{"id":3,"arabic":"أَقُلْ","translit":"ْlُqَaʾ","root":"قول"},{"id":4,"arabic":"إِنَّكَ","translit":"َkَّnِiʾ","root":""},{"id":5,"arabic":"لَن","translit":"nَl","root":""},{"id":6,"arabic":"تَسْتَطِيعَ","translit":"َʿعyِṭَtْsَt","root":"طوع"},{"id":7,"arabic":"مَعِىَ","translit":"َàِʿعَm","root":""},{"id":8,"arabic":"صَبْرًا","translit":"āًrْbَṣ","root":"صبر"}],"hasIhya":true},{"ayah":73,"text":"قَالَ لَا تُؤَاخِذْنِى بِمَا نَسِيتُ وَلَا تُرْهِقْنِى مِنْ أَمْرِى عُسْرًا ","translation":"[Moses] said, \"Do not blame me for what I forgot and do not overwhelm me in my matter with difficulty.\"","words":[{"id":1,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":2,"arabic":"لَا","translit":"āَl","root":""},{"id":3,"arabic":"تُؤَاخِذْنِى","translit":"àِnْhdِhkāَwʾُt","root":"اخذ"},{"id":4,"arabic":"بِمَا","translit":"āَmِb","root":""},{"id":5,"arabic":"نَسِيتُ","translit":"ُtyِsَn","root":"نسي"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"تُرْهِقْنِى","translit":"àِnْqِhْrُt","root":"رهق"},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"أَمْرِى","translit":"àِrْmَaʾ","root":"امر"},{"id":10,"arabic":"عُسْرًا","translit":"āًrْsُʿع","root":"عسر"}],"hasIhya":true},{"ayah":74,"text":"فَٱنطَلَقَا حَتَّىٰٓ إِذَا لَقِيَا غُلَٰمًا فَقَتَلَهُۥ قَالَ أَقَتَلْتَ نَفْسًا زَكِيَّةًۢ بِغَيْرِ نَفْسٍ لَّقَدْ جِئْتَ شَيْـًٔا نُّكْرًا ","translation":"So they set out, until when they met a boy, he [i.e., al-Khiḍr] killed him. [Moses] said, \"Have you killed a pure soul for other than [having killed] a soul? You have certainly done a deplorable thing.\"","words":[{"id":1,"arabic":"فَٱنطَلَقَا","translit":"āَqَlَṭnٱَf","root":"طلق"},{"id":2,"arabic":"حَتَّىٰٓ","translit":"ٰٓàَّtَḥ","root":""},{"id":3,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":4,"arabic":"لَقِيَا","translit":"āَyِqَl","root":"لقي"},{"id":5,"arabic":"غُلَٰمًا","translit":"āًmَٰlُغ","root":"غلم"},{"id":6,"arabic":"فَقَتَلَهُۥ","translit":"ۥُhَlَtَqَf","root":"قتل"},{"id":7,"arabic":"قَالَ","translit":"َlāَq","root":"قول"},{"id":8,"arabic":"أَقَتَلْتَ","translit":"َtْlَtَqَaʾ","root":"قتل"},{"id":9,"arabic":"نَفْسًا","translit":"āًsْfَn","root":"نفس"},{"id":10,"arabic":"زَكِيَّةًۢ","translit":"ًۢẗَّyِkَz","root":"زكو"},{"id":11,"arabic":"بِغَيْرِ","translit":"ِrْyَغِb","root":"غير"},{"id":12,"arabic":"نَفْسٍ","translit":"ٍsْfَn","root":"نفس"},{"id":13,"arabic":"لَّقَدْ","translit":"ْdَqَّl","root":""},{"id":14,"arabic":"جِئْتَ","translit":"َtْyʾِjg","root":"جيا"},{"id":15,"arabic":"شَيْـًٔا","translit":"āًٔـْyَhs","root":"شيا"},{"i