{"surah":18,"verses":[{"ayah":1,"text":"ٱلْحَمْدُ لِلَّهِ ٱلَّذِىٓ أَنزَلَ عَلَىٰ عَبْدِهِ ٱلْكِتَٰبَ وَلَمْ يَجْعَل لَّهُۥ عِوَجَاۜ ","translation":"[All] praise is [due] to Allāh, who has sent down upon His Servant [Muḥammad (ﷺ)] the Book and has not made therein any deviance.[1]","words":[{"id":1,"arabic":"ٱلْحَمْدُ","translit":"ُdْmَḥْlٱ","root":"حمد"},{"id":2,"arabic":"لِلَّهِ","translit":"ِhَّlِl","root":"اله"},{"id":3,"arabic":"ٱلَّذِىٓ","translit":"ٓàِhdَّlٱ","root":""},{"id":4,"arabic":"أَنزَلَ","translit":"َlَznَaʾ","root":"نزل"},{"id":5,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":6,"arabic":"عَبْدِهِ","translit":"ِhِdْbَʿع","root":"عبد"},{"id":7,"arabic":"ٱلْكِتَٰبَ","translit":"َbَٰtِkْlٱ","root":"كتب"},{"id":8,"arabic":"وَلَمْ","translit":"ْmَlَw","root":""},{"id":9,"arabic":"يَجْعَل","translit":"lَʿعْjgَy","root":"جعل"},{"id":10,"arabic":"لَّهُۥ","translit":"ۥُhَّl","root":""},{"id":11,"arabic":"عِوَجَا","translit":"āَjgَwِʿع","root":"عوج"}],"hasIhya":false},{"ayah":2,"text":"قَيِّمًا لِّيُنذِرَ بَأْسًا شَدِيدًا مِّن لَّدُنْهُ وَيُبَشِّرَ ٱلْمُؤْمِنِينَ ٱلَّذِينَ يَعْمَلُونَ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمْ أَجْرًا حَسَنًا ","translation":"[He has made it] straight, to warn of severe punishment from Him and to give good tidings to the believers who do righteous deeds that they will have a good reward [i.e., Paradise]","words":[{"id":1,"arabic":"قَيِّمًا","translit":"āًmِّyَq","root":"قوم"},{"id":2,"arabic":"لِّيُنذِرَ","translit":"َrِhdnُyِّl","root":"نذر"},{"id":3,"arabic":"بَأْسًا","translit":"āًsْaʾَb","root":"باس"},{"id":4,"arabic":"شَدِيدًا","translit":"āًdyِdَhs","root":"شدد"},{"id":5,"arabic":"مِّن","translit":"nِّm","root":""},{"id":6,"arabic":"لَّدُنْهُ","translit":"ُhْnُdَّl","root":"لدن"},{"id":7,"arabic":"وَيُبَشِّرَ","translit":"َrِّhsَbُyَw","root":"بشر"},{"id":8,"arabic":"ٱلْمُؤْمِنِينَ","translit":"َnyِnِmْwʾُmْlٱ","root":"امن"},{"id":9,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":10,"arabic":"يَعْمَلُونَ","translit":"َnwُlَmْʿعَy","root":"عمل"},{"id":11,"arabic":"ٱلصَّٰلِحَٰتِ","translit":"ِtَٰḥِlَّٰṣlٱ","root":"صلح"},{"id":12,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":13,"arabic":"لَهُمْ","translit":"ْmُhَl","root":""},{"id":14,"arabic":"أَجْرًا","translit":"āًrْjgَaʾ","root":"اجر"},{"id":15,"arabic":"حَسَنًا","translit":"āًnَsَḥ","root":"حسن"}],"hasIhya":false},{"ayah":3,"text":"مَّٰكِثِينَ فِيهِ أَبَدًا ","translation":"In which they will remain forever","words":[{"id":1,"arabic":"مَّٰكِثِينَ","translit":"َnyِhtِkَّٰm","root":"مكث"},{"id":2,"arabic":"فِيهِ","translit":"ِhyِf","root":""},{"id":3,"arabic":"أَبَدًا","translit":"āًdَbَaʾ","root":"ابد"}],"hasIhya":false},{"ayah":4,"text":"وَيُنذِرَ ٱلَّذِينَ قَالُوا۟ ٱتَّخَذَ ٱللَّهُ وَلَدًا ","translation":"And to warn those who say, \"Allāh has taken a son.\"","words":[{"id":1,"arabic":"وَيُنذِرَ","translit":"َrِhdnُyَw","root":"نذر"},{"id":2,"arabic":"ٱلَّذِينَ","translit":"َnyِhdَّlٱ","root":""},{"id":3,"arabic":"قَالُوا۟","translit":"۟āwُlāَq","root":"قول"},{"id":4,"arabic":"ٱتَّخَذَ","translit":"َhdَhkَّtٱ","root":"اخذ"},{"id":5,"arabic":"ٱللَّهُ","translit":"ُhَّllٱ","root":"اله"},{"id":6,"arabic":"وَلَدًا","translit":"āًdَlَw","root":"ولد"}],"hasIhya":false},{"ayah":5,"text":"مَّا لَهُم بِهِۦ مِنْ عِلْمٍ وَلَا لِءَابَآئِهِمْۚ كَبُرَتْ كَلِمَةً تَخْرُجُ مِنْ أَفْوَٰهِهِمْۚ إِن يَقُولُونَ إِلَّا كَذِبًا ","translation":"They have no knowledge of it,[1] nor had their fathers. Grave is the word that comes out of their mouths; they speak not except a lie.","words":[{"id":1,"arabic":"مَّا","translit":"āَّm","root":""},{"id":2,"arabic":"لَهُم","translit":"mُhَl","root":""},{"id":3,"arabic":"بِهِۦ","translit":"ۦِhِb","root":""},{"id":4,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":5,"arabic":"عِلْمٍ","translit":"ٍmْlِʿع","root":"علم"},{"id":6,"arabic":"وَلَا","translit":"āَlَw","root":""},{"id":7,"arabic":"لِءَابَآئِهِمْ","translit":"ْmِhِyʾٓāَbāَءِl","root":"ابو"},{"id":8,"arabic":"كَبُرَتْ","translit":"ْtَrُbَk","root":"كبر"},{"id":9,"arabic":"كَلِمَةً","translit":"ًẗَmِlَk","root":"كلم"},{"id":10,"arabic":"تَخْرُجُ","translit":"ُjgُrْhkَt","root":"خرج"},{"id":11,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":12,"arabic":"أَفْوَٰهِهِمْ","translit":"ْmِhِhَٰwْfَaʾ","root":"فوه"},{"id":13,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":14,"arabic":"يَقُولُونَ","translit":"َnwُlwُqَy","root":"قول"},{"id":15,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":16,"arabic":"كَذِبًا","translit":"āًbِhdَk","root":"كذب"}],"hasIhya":false},{"ayah":6,"text":"فَلَعَلَّكَ بَٰخِعٌ نَّفْسَكَ عَلَىٰٓ ءَاثَٰرِهِمْ إِن لَّمْ يُؤْمِنُوا۟ بِهَٰذَا ٱلْحَدِيثِ أَسَفًا ","translation":"Then perhaps you would kill yourself through grief over them, [O Muḥammad], if they do not believe in this message, [and] out of sorrow.","words":[{"id":1,"arabic":"فَلَعَلَّكَ","translit":"َkَّlَʿعَlَf","root":""},{"id":2,"arabic":"بَٰخِعٌ","translit":"ٌʿعِhkَٰb","root":"بخع"},{"id":3,"arabic":"نَّفْسَكَ","translit":"َkَsْfَّn","root":"نفس"},{"id":4,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":5,"arabic":"ءَاثَٰرِهِمْ","translit":"ْmِhِrَٰhtāَء","root":"اثر"},{"id":6,"arabic":"إِن","translit":"nِiʾ","root":""},{"id":7,"arabic":"لَّمْ","translit":"ْmَّl","root":""},{"id":8,"arabic":"يُؤْمِنُوا۟","translit":"۟āwُnِmْwʾُy","root":"امن"},{"id":9,"arabic":"بِهَٰذَا","translit":"āَhdَٰhِb","root":""},{"id":10,"arabic":"ٱلْحَدِيثِ","translit":"ِhtyِdَḥْlٱ","root":"حدث"},{"id":11,"arabic":"أَسَفًا","translit":"āًfَsَaʾ","root":"اسف"}],"hasIhya":false},{"ayah":7,"text":"إِنَّا جَعَلْنَا مَا عَلَى ٱلْأَرْضِ زِينَةً لَّهَا لِنَبْلُوَهُمْ أَيُّهُمْ أَحْسَنُ عَمَلًا ","translation":"Indeed, We have made that which is on the earth adornment for it that We may test them [as to] which of them is best in deed.","words":[{"id":1,"arabic":"إِنَّا","translit":"āَّnِiʾ","root":""},{"id":2,"arabic":"جَعَلْنَا","translit":"āَnْlَʿعَjg","root":"جعل"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":5,"arabic":"ٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱ","root":"ارض"},{"id":6,"arabic":"زِينَةً","translit":"ًẗَnyِz","root":"زين"},{"id":7,"arabic":"لَّهَا","translit":"āَhَّl","root":""},{"id":8,"arabic":"لِنَبْلُوَهُمْ","translit":"ْmُhَwُlْbَnِl","root":"بلو"},{"id":9,"arabic":"أَيُّهُمْ","translit":"ْmُhُّyَaʾ","root":"ايي"},{"id":10,"arabic":"أَحْسَنُ","translit":"ُnَsْḥَaʾ","root":"حسن"},{"id":11,"arabic":"عَمَلًا","translit":"āًlَmَʿع","root":"عمل"}],"hasIhya":true},{"ayah":8,"text":"وَإِنَّا لَجَٰعِلُونَ مَا عَلَيْهَا صَعِيدًا جُرُزًا ","translation":"And indeed, We will make that which is upon it [into] a barren ground.","words":[{"id":1,"arabic":"وَإِنَّا","translit":"āَّnِiʾَw","root":""},{"id":2,"arabic":"لَجَٰعِلُونَ","translit":"َnwُlِʿعَٰjgَl","root":"جعل"},{"id":3,"arabic":"مَا","translit":"āَm","root":""},{"id":4,"arabic":"عَلَيْهَا","translit":"āَhْyَlَʿع","root":""},{"id":5,"arabic":"صَعِيدًا","translit":"āًdyِʿعَṣ","root":"صعد"},{"id":6,"arabic":"جُرُزًا","translit":"āًzُrُjg","root":"جرز"}],"hasIhya":false},{"ayah":9,"text":"أَمْ حَسِبْتَ أَنَّ أَصْحَٰبَ ٱلْكَهْفِ وَٱلرَّقِيمِ كَانُوا۟ مِنْ ءَايَٰتِنَا عَجَبًا ","translation":"Or have you thought that the companions of the cave and the inscription were, among Our signs, a wonder?[1]","words":[{"id":1,"arabic":"أَمْ","translit":"ْmَaʾ","root":""},{"id":2,"arabic":"حَسِبْتَ","translit":"َtْbِsَḥ","root":"حسب"},{"id":3,"arabic":"أَنَّ","translit":"َّnَaʾ","root":""},{"id":4,"arabic":"أَصْحَٰبَ","translit":"َbَٰḥْṣَaʾ","root":"صحب"},{"id":5,"arabic":"ٱلْكَهْفِ","translit":"ِfْhَkْlٱ","root":"كهف"},{"id":6,"arabic":"وَٱلرَّقِيمِ","translit":"ِmyِqَّrlٱَw","root":"رقم"},{"id":7,"arabic":"كَانُوا۟","translit":"۟āwُnāَk","root":"كون"},{"id":8,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":9,"arabic":"ءَايَٰتِنَا","translit":"āَnِtَٰyāَء","root":"ايي"},{"id":10,"arabic":"عَجَبًا","translit":"āًbَjgَʿع","root":"عجب"}],"hasIhya":false},{"ayah":10,"text":"إِذْ أَوَى ٱلْفِتْيَةُ إِلَى ٱلْكَهْفِ فَقَالُوا۟ رَبَّنَآ ءَاتِنَا مِن لَّدُنكَ رَحْمَةً وَهَيِّئْ لَنَا مِنْ أَمْرِنَا رَشَدًا ","translation":"[Mention] when the youths retreated to the cave and said, \"Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance.\"","words":[{"id":1,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":2,"arabic":"أَوَى","translit":"àَwَaʾ","root":"اوي"},{"id":3,"arabic":"ٱلْفِتْيَةُ","translit":"ُẗَyْtِfْlٱ","root":"فتي"},{"id":4,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":5,"arabic":"ٱلْكَهْفِ","translit":"ِfْhَkْlٱ","root":"كهف"},{"id":6,"arabic":"فَقَالُوا۟","translit":"۟āwُlāَqَf","root":"قول"},{"id":7,"arabic":"رَبَّنَآ","translit":"ٓāَnَّbَr","root":"ربب"},{"id":8,"arabic":"ءَاتِنَا","translit":"āَnِtāَء","root":"اتي"},{"id":9,"arabic":"مِن","translit":"nِm","root":""},{"id":10,"arabic":"لَّدُنكَ","translit":"َknُdَّl","root":"لدن"},{"id":11,"arabic":"رَحْمَةً","translit":"ًẗَmْḥَr","root":"رحم"},{"id":12,"arabic":"وَهَيِّئْ","translit":"ْyʾِّyَhَw","root":"هيا"},{"id":13,"arabic":"لَنَا","translit":"āَnَl","root":""},{"id":14,"arabic":"مِنْ","translit":"ْnِm","root":""},{"id":15,"arabic":"أَمْرِنَا","translit":"āَnِrْmَaʾ","root":"امر"},{"id":16,"arabic":"رَشَدًا","translit":"āًdَhsَr","root":"رشد"}],"hasIhya":true},{"ayah":11,"text":"فَضَرَبْنَا عَلَىٰٓ ءَاذَانِهِمْ فِى ٱلْكَهْفِ سِنِينَ عَدَدًا ","translation":"So We cast [a cover of sleep] over their ears within the cave for a number of years.","words":[{"id":1,"arabic":"فَضَرَبْنَا","translit":"āَnْbَrَḍَf","root":"ضرب"},{"id":2,"arabic":"عَلَىٰٓ","translit":"ٰٓàَlَʿع","root":""},{"id":3,"arabic":"ءَاذَانِهِمْ","translit":"ْmِhِnāَhdāَء","root":"اذن"},{"id":4,"arabic":"فِى","translit":"àِf","root":""},{"id":5,"arabic":"ٱلْكَهْفِ","translit":"ِfْhَkْlٱ","root":"كهف"},{"id":6,"arabic":"سِنِينَ","translit":"َnyِnِs","root":"سنو"},{"id":7,"arabic":"عَدَدًا","translit":"āًdَdَʿع","root":"عدد"}],"hasIhya":false},{"ayah":12,"text":"ثُمَّ بَعَثْنَٰهُمْ لِنَعْلَمَ أَىُّ ٱلْحِزْبَيْنِ أَحْصَىٰ لِمَا لَبِثُوٓا۟ أَمَدًا ","translation":"Then We awakened them that We might show which of the two factions was most precise in calculating what [extent] they had remained in time.","words":[{"id":1,"arabic":"ثُمَّ","translit":"َّmُht","root":""},{"id":2,"arabic":"بَعَثْنَٰهُمْ","translit":"ْmُhَٰnْhtَʿعَb","root":"بعث"},{"id":3,"arabic":"لِنَعْلَمَ","translit":"َmَlْʿعَnِl","root":"علم"},{"id":4,"arabic":"أَىُّ","translit":"ُّàَaʾ","root":"ايي"},{"id":5,"arabic":"ٱلْحِزْبَيْنِ","translit":"ِnْyَbْzِḥْlٱ","root":"حزب"},{"id":6,"arabic":"أَحْصَىٰ","translit":"ٰàَṣْḥَaʾ","root":"حصي"},{"id":7,"arabic":"لِمَا","translit":"āَmِl","root":""},{"id":8,"arabic":"لَبِثُوٓا۟","translit":"۟āٓwُhtِbَl","root":"لبث"},{"id":9,"arabic":"أَمَدًا","translit":"āًdَmَaʾ","root":"امد"}],"hasIhya":false},{"ayah":13,"text":"نَّحْنُ نَقُصُّ عَلَيْكَ نَبَأَهُم بِٱلْحَقِّۚ إِنَّهُمْ فِتْيَةٌ ءَامَنُوا۟ بِرَبِّهِمْ وَزِدْنَٰهُمْ هُدًى ","translation":"It is We who relate to you, [O Muḥammad], their story in truth. Indeed, they were youths who believed in their Lord, and We increased them in guidance.","words":[{"id":1,"arabic":"نَّحْنُ","translit":"ُnْḥَّn","root":""},{"id":2,"arabic":"نَقُصُّ","translit":"ُّṣُqَn","root":"قصص"},{"id":3,"arabic":"عَلَيْكَ","translit":"َkْyَlَʿع","root":""},{"id":4,"arabic":"نَبَأَهُم","translit":"mُhَaʾَbَn","root":"نبا"},{"id":5,"arabic":"بِٱلْحَقِّ","translit":"ِّqَḥْlٱِb","root":"حقق"},{"id":6,"arabic":"إِنَّهُمْ","translit":"ْmُhَّnِiʾ","root":""},{"id":7,"arabic":"فِتْيَةٌ","translit":"ٌẗَyْtِf","root":"فتي"},{"id":8,"arabic":"ءَامَنُوا۟","translit":"۟āwُnَmāَء","root":"امن"},{"id":9,"arabic":"بِرَبِّهِمْ","translit":"ْmِhِّbَrِb","root":"ربب"},{"id":10,"arabic":"وَزِدْنَٰهُمْ","translit":"ْmُhَٰnْdِzَw","root":"زيد"},{"id":11,"arabic":"هُدًى","translit":"àًdُh","root":"هدي"}],"hasIhya":true},{"ayah":14,"text":"وَرَبَطْنَا عَلَىٰ قُلُوبِهِمْ إِذْ قَامُوا۟ فَقَالُوا۟ رَبُّنَا رَبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ لَن نَّدْعُوَا۟ مِن دُونِهِۦٓ إِلَٰهًاۖ لَّقَدْ قُلْنَآ إِذًا شَطَطًا ","translation":"And We bound [i.e., made firm] their hearts when they stood up and said, \"Our Lord is the Lord of the heavens and the earth. Never will we invoke besides Him any deity. We would have certainly spoken, then, an excessive transgression.","words":[{"id":1,"arabic":"وَرَبَطْنَا","translit":"āَnْṭَbَrَw","root":"ربط"},{"id":2,"arabic":"عَلَىٰ","translit":"ٰàَlَʿع","root":""},{"id":3,"arabic":"قُلُوبِهِمْ","translit":"ْmِhِbwُlُq","root":"قلب"},{"id":4,"arabic":"إِذْ","translit":"ْhdِiʾ","root":""},{"id":5,"arabic":"قَامُوا۟","translit":"۟āwُmāَq","root":"قوم"},{"id":6,"arabic":"فَقَالُوا۟","translit":"۟āwُlāَqَf","root":"قول"},{"id":7,"arabic":"رَبُّنَا","translit":"āَnُّbَr","root":"ربب"},{"id":8,"arabic":"رَبُّ","translit":"ُّbَr","root":"ربب"},{"id":9,"arabic":"ٱلسَّمَٰوَٰتِ","translit":"ِtَٰwَٰmَّslٱ","root":"سمو"},{"id":10,"arabic":"وَٱلْأَرْضِ","translit":"ِḍْrَaʾْlٱَw","root":"ارض"},{"id":11,"arabic":"لَن","translit":"nَl","root":""},{"id":12,"arabic":"نَّدْعُوَا۟","translit":"۟āَwُʿعْdَّn","root":"دعو"},{"id":13,"arabic":"مِن","translit":"nِm","root":""},{"id":14,"arabic":"دُونِهِۦٓ","translit":"ٓۦِhِnwُd","root":"دون"},{"id":15,"arabic":"إِلَٰهًا","translit":"āًhَٰlِiʾ","root":"اله"},{"id":16,"arabic":"لَّقَدْ","translit":"ْdَqَّl","root":""},{"id":17,"arabic":"قُلْنَآ","translit":"ٓāَnْlُq","root":"قول"},{"id":18,"arabic":"إِذًا","translit":"āًhdِiʾ","root":""},{"id":19,"arabic":"شَطَطًا","translit":"āًṭَṭَhs","root":"شطط"}],"hasIhya":false},{"ayah":15,"text":"هَٰٓؤُلَآءِ قَوْمُنَا ٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةًۖ لَّوْلَا يَأْتُونَ عَلَيْهِم بِسُلْطَٰنٍۭ بَيِّنٍۖ فَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا ","translation":"These, our people, have taken besides Him deities. Why do they not bring for [worship of] them a clear evidence? And who is more unjust than one who invents about Allāh a lie?\"","words":[{"id":1,"arabic":"هَٰٓؤُلَآءِ","translit":"ِءٓāَlُwʾَٰٓh","root":""},{"id":2,"arabic":"قَوْمُنَا","translit":"āَnُmْwَq","root":"قوم"},{"id":3,"arabic":"ٱتَّخَذُوا۟","translit":"۟āwُhdَhkَّtٱ","root":"اخذ"},{"id":4,"arabic":"مِن","translit":"nِm","root":""},{"id":5,"arabic":"دُونِهِۦٓ","translit":"ٓۦِhِnwُd","root":"دون"},{"id":6,"arabic":"ءَالِهَةً","translit":"ًẗَhِlāَء","root":"اله"},{"id":7,"arabic":"لَّوْلَا","translit":"āَlْwَّl","root":""},{"id":8,"arabic":"يَأْتُونَ","translit":"َnwُtْaʾَy","root":"اتي"},{"id":9,"arabic":"عَلَيْهِم","translit":"mِhْyَlَʿع","root":""},{"id":10,"arabic":"بِسُلْطَٰنٍۭ","translit":"ٍۭnَٰṭْlُsِb","root":"سلط"},{"id":11,"arabic":"بَيِّنٍ","translit":"ٍnِّyَb","root":"بين"},{"id":12,"arabic":"فَمَنْ","translit":"ْnَmَf","root":""},{"id":13,"arabic":"أَظْلَمُ","translit":"ُmَlْẓَaʾ","root":"ظلم"},{"id":14,"arabic":"مِمَّنِ","translit":"ِnَّmِm","root":""},{"id":15,"arabic":"ٱفْتَرَىٰ","translit":"ٰàَrَtْfٱ","root":"فري"},{"id":16,"arabic":"عَلَى","translit":"àَlَʿع","root":""},{"id":17,"arabic":"ٱللَّهِ","translit":"ِhَّllٱ","root":"اله"},{"id":18,"arabic":"كَذِبًا","translit":"āًbِhdَk","root":"كذب"}],"hasIhya":true},{"ayah":16,"text":"وَإِذِ ٱعْتَزَلْتُمُوهُمْ وَمَا يَعْبُدُونَ إِلَّا ٱللَّهَ فَأْوُۥٓا۟ إِلَى ٱلْكَهْفِ يَنشُرْ لَكُمْ رَبُّكُم مِّن رَّحْمَتِهِۦ وَيُهَيِّئْ لَكُم مِّنْ أَمْرِكُم مِّرْفَقًا ","translation":"[The youths said to one another], \"And when you have withdrawn from them and that which they worship other than Allāh, retreat to the cave. Your Lord will spread out for you of His mercy and will prepare for you from your affair facility.\"","words":[{"id":1,"arabic":"وَإِذِ","translit":"ِhdِiʾَw","root":""},{"id":2,"arabic":"ٱعْتَزَلْتُمُوهُمْ","translit":"ْmُhwُmُtْlَzَtْʿعٱ","root":"عزل"},{"id":3,"arabic":"وَمَا","translit":"āَmَw","root":""},{"id":4,"arabic":"يَعْبُدُونَ","translit":"َnwُdُbْʿعَy","root":"عبد"},{"id":5,"arabic":"إِلَّا","translit":"āَّlِiʾ","root":""},{"id":6,"arabic":"ٱللَّهَ","translit":"َhَّllٱ","root":"اله"},{"id":7,"arabic":"فَأْوُۥٓا۟","translit":"۟āٓۥُwْaʾَf","root":"اوي"},{"id":8,"arabic":"إِلَى","translit":"àَlِiʾ","root":""},{"id":9,"arabic":"ٱلْكَهْفِ","translit":"ِfْhَkْlٱ","root":"كهف"},{"id":10,"arabic":"يَنشُرْ","translit":"ْrُhsnَy","root":"نشر"},{"id":11,"arabic":"لَكُمْ","translit":"ْmُkَl","root":""},{"id":12,"arabic":"رَبُّكُم","translit":"mُkُّbَr","root":"ربب"},{"id":13,"arabic":"مِّن","translit":"nِّm","root":""},{"id":14,"arabic":"رَّحْمَتِهِۦ","translit":"ۦِhِtَmْḥَّr","root":"رحم"},{"id":15,"arabic":"وَيُهَيِّئْ","translit":"ْyʾِّyَhُyَw","root":"هيا"},{"id":16,"arabic":"لَكُم","translit":"mُkَl","root":""},{"id":17,"arabic":"مِّنْ","translit":"ْnِّm","root":""},{"id":18,"arabic":"أَمْرِكُم","translit":"mُkِrْmَaʾ","root":"امر"},{"id":19,"arabic":"مِّرْفَقًا","translit":"āًqَfْrِّm","root":"رفق"}],"hasIhya":true},{"ayah":17,"text":"وَتَرَى ٱلشَّمْسَ إِذَا طَلَعَت تَّزَٰوَرُ عَن كَهْفِهِمْ ذَاتَ ٱلْيَمِينِ وَإِذَا غَرَبَت تَّقْرِضُهُمْ ذَاتَ ٱلشِّمَالِ وَهُمْ فِى فَجْوَةٍ مِّنْهُۚ ذَٰلِكَ مِنْ ءَايَٰتِ ٱللَّهِۗ مَن يَهْدِ ٱللَّهُ فَهُوَ ٱلْمُهْتَدِۖ وَمَن يُضْلِلْ فَلَن تَجِدَ لَهُۥ وَلِيًّا مُّرْشِدًا ","translation":"And [had you been present], you would see the sun when it rose, inclining away from their cave on the right, and when it set, passing away from them on the left, while they were [lying] within an open space thereof. That was from the signs of Allāh. He whom Allāh guides is the [rightly] guided, but he whom He sends astray - never will you find for him a protecting guide.","words":[{"id":1,"arabic":"وَتَرَى","translit":"àَrَtَw","root":"راي"},{"id":2,"arabic":"ٱلشَّمْسَ","translit":"َsْmَّhslٱ","root":"شمس"},{"id":3,"arabic":"إِذَا","translit":"āَhdِiʾ","root":""},{"id":4,"arabic":"طَلَعَت","translit":"tَʿعَlَṭ","root":"طلع"},{"id":5,"arabic":"تَّزَٰوَرُ","translit":"ُrَwَٰzَّt","root":"زور"},{"id":6,"arabic":"عَن","translit":"nَʿع","root":""},{"id":7,"arabic":"كَهْفِهِمْ","translit":"ْmِhِfْhَk","root":"كهف"},{"id":8,"arabic":"ذَاتَ","translit":"َtāَ