{"surah": 18, "verses": [{"ayah": 1, "text": "ٱلْحَمْدُ لِلَّهِ ٱلَّذِىٓ أَنزَلَ عَلَىٰ عَبْدِهِ ٱلْكِتَٰبَ وَلَمْ يَجْعَل لَّهُۥ عِوَجَاۜ ", "translation": "[All] praise is [due] to Allāh, who has sent down upon His Servant [Muḥammad (ﷺ)] the Book and has not made therein any deviance.[1]", "words": [{"id": 1, "arabic": "ٱلْحَمْدُ", "translit": "ُdْmَḥْlٱ", "root": "حمد"}, {"id": 2, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 3, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "عَبْدِهِ", "translit": "ِhِdْbَʿع", "root": "عبد"}, {"id": 7, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 8, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 9, "arabic": "يَجْعَل", "translit": "lَʿعْjgَy", "root": "جعل"}, {"id": 10, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 11, "arabic": "عِوَجَا", "translit": "āَjgَwِʿع", "root": "عوج"}], "hasIhya": false}, {"ayah": 2, "text": "قَيِّمًا لِّيُنذِرَ بَأْسًا شَدِيدًا مِّن لَّدُنْهُ وَيُبَشِّرَ ٱلْمُؤْمِنِينَ ٱلَّذِينَ يَعْمَلُونَ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمْ أَجْرًا حَسَنًا ", "translation": "[He has made it] straight, to warn of severe punishment from Him and to give good tidings to the believers who do righteous deeds that they will have a good reward [i.e., Paradise]", "words": [{"id": 1, "arabic": "قَيِّمًا", "translit": "āًmِّyَq", "root": "قوم"}, {"id": 2, "arabic": "لِّيُنذِرَ", "translit": "َrِhdnُyِّl", "root": "نذر"}, {"id": 3, "arabic": "بَأْسًا", "translit": "āًsْaʾَb", "root": "باس"}, {"id": 4, "arabic": "شَدِيدًا", "translit": "āًdyِdَhs", "root": "شدد"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "لَّدُنْهُ", "translit": "ُhْnُdَّl", "root": "لدن"}, {"id": 7, "arabic": "وَيُبَشِّرَ", "translit": "َrِّhsَbُyَw", "root": "بشر"}, {"id": 8, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}, {"id": 11, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 12, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 13, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 14, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 15, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}], "hasIhya": false}, {"ayah": 3, "text": "مَّٰكِثِينَ فِيهِ أَبَدًا ", "translation": "In which they will remain forever", "words": [{"id": 1, "arabic": "مَّٰكِثِينَ", "translit": "َnyِhtِkَّٰm", "root": "مكث"}, {"id": 2, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 3, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}], "hasIhya": false}, {"ayah": 4, "text": "وَيُنذِرَ ٱلَّذِينَ قَالُوا۟ ٱتَّخَذَ ٱللَّهُ وَلَدًا ", "translation": "And to warn those who say, \"Allāh has taken a son.\"", "words": [{"id": 1, "arabic": "وَيُنذِرَ", "translit": "َrِhdnُyَw", "root": "نذر"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 4, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَلَدًا", "translit": "āًdَlَw", "root": "ولد"}], "hasIhya": false}, {"ayah": 5, "text": "مَّا لَهُم بِهِۦ مِنْ عِلْمٍ وَلَا لِءَابَآئِهِمْۚ كَبُرَتْ كَلِمَةً تَخْرُجُ مِنْ أَفْوَٰهِهِمْۚ إِن يَقُولُونَ إِلَّا كَذِبًا ", "translation": "They have no knowledge of it,[1] nor had their fathers. Grave is the word that comes out of their mouths; they speak not except a lie.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 3, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "عِلْمٍ", "translit": "ٍmْlِʿع", "root": "علم"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "لِءَابَآئِهِمْ", "translit": "ْmِhِyʾٓāَbāَءِl", "root": "ابو"}, {"id": 8, "arabic": "كَبُرَتْ", "translit": "ْtَrُbَk", "root": "كبر"}, {"id": 9, "arabic": "كَلِمَةً", "translit": "ًẗَmِlَk", "root": "كلم"}, {"id": 10, "arabic": "تَخْرُجُ", "translit": "ُjgُrْhkَt", "root": "خرج"}, {"id": 11, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 12, "arabic": "أَفْوَٰهِهِمْ", "translit": "ْmِhِhَٰwْfَaʾ", "root": "فوه"}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}], "hasIhya": false}, {"ayah": 6, "text": "فَلَعَلَّكَ بَٰخِعٌ نَّفْسَكَ عَلَىٰٓ ءَاثَٰرِهِمْ إِن لَّمْ يُؤْمِنُوا۟ بِهَٰذَا ٱلْحَدِيثِ أَسَفًا ", "translation": "Then perhaps you would kill yourself through grief over them, [O Muḥammad], if they do not believe in this message, [and] out of sorrow.", "words": [{"id": 1, "arabic": "فَلَعَلَّكَ", "translit": "َkَّlَʿعَlَf", "root": ""}, {"id": 2, "arabic": "بَٰخِعٌ", "translit": "ٌʿعِhkَٰb", "root": "بخع"}, {"id": 3, "arabic": "نَّفْسَكَ", "translit": "َkَsْfَّn", "root": "نفس"}, {"id": 4, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 5, "arabic": "ءَاثَٰرِهِمْ", "translit": "ْmِhِrَٰhtāَء", "root": "اثر"}, {"id": 6, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 7, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 8, "arabic": "يُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُy", "root": "امن"}, {"id": 9, "arabic": "بِهَٰذَا", "translit": "āَhdَٰhِb", "root": ""}, {"id": 10, "arabic": "ٱلْحَدِيثِ", "translit": "ِhtyِdَḥْlٱ", "root": "حدث"}, {"id": 11, "arabic": "أَسَفًا", "translit": "āًfَsَaʾ", "root": "اسف"}], "hasIhya": false}, {"ayah": 7, "text": "إِنَّا جَعَلْنَا مَا عَلَى ٱلْأَرْضِ زِينَةً لَّهَا لِنَبْلُوَهُمْ أَيُّهُمْ أَحْسَنُ عَمَلًا ", "translation": "Indeed, We have made that which is on the earth adornment for it that We may test them [as to] which of them is best in deed.", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "زِينَةً", "translit": "ًẗَnyِz", "root": "زين"}, {"id": 7, "arabic": "لَّهَا", "translit": "āَhَّl", "root": ""}, {"id": 8, "arabic": "لِنَبْلُوَهُمْ", "translit": "ْmُhَwُlْbَnِl", "root": "بلو"}, {"id": 9, "arabic": "أَيُّهُمْ", "translit": "ْmُhُّyَaʾ", "root": "ايي"}, {"id": 10, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 11, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}], "hasIhya": true}, {"ayah": 8, "text": "وَإِنَّا لَجَٰعِلُونَ مَا عَلَيْهَا صَعِيدًا جُرُزًا ", "translation": "And indeed, We will make that which is upon it [into] a barren ground.", "words": [{"id": 1, "arabic": "وَإِنَّا", "translit": "āَّnِiʾَw", "root": ""}, {"id": 2, "arabic": "لَجَٰعِلُونَ", "translit": "َnwُlِʿعَٰjgَl", "root": "جعل"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 5, "arabic": "صَعِيدًا", "translit": "āًdyِʿعَṣ", "root": "صعد"}, {"id": 6, "arabic": "جُرُزًا", "translit": "āًzُrُjg", "root": "جرز"}], "hasIhya": false}, {"ayah": 9, "text": "أَمْ حَسِبْتَ أَنَّ أَصْحَٰبَ ٱلْكَهْفِ وَٱلرَّقِيمِ كَانُوا۟ مِنْ ءَايَٰتِنَا عَجَبًا ", "translation": "Or have you thought that the companions of the cave and the inscription were, among Our signs, a wonder?[1]", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "حَسِبْتَ", "translit": "َtْbِsَḥ", "root": "حسب"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "أَصْحَٰبَ", "translit": "َbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 5, "arabic": "ٱلْكَهْفِ", "translit": "ِfْhَkْlٱ", "root": "كهف"}, {"id": 6, "arabic": "وَٱلرَّقِيمِ", "translit": "ِmyِqَّrlٱَw", "root": "رقم"}, {"id": 7, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 10, "arabic": "عَجَبًا", "translit": "āًbَjgَʿع", "root": "عجب"}], "hasIhya": false}, {"ayah": 10, "text": "إِذْ أَوَى ٱلْفِتْيَةُ إِلَى ٱلْكَهْفِ فَقَالُوا۟ رَبَّنَآ ءَاتِنَا مِن لَّدُنكَ رَحْمَةً وَهَيِّئْ لَنَا مِنْ أَمْرِنَا رَشَدًا ", "translation": "[Mention] when the youths retreated to the cave and said, \"Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "أَوَى", "translit": "àَwَaʾ", "root": "اوي"}, {"id": 3, "arabic": "ٱلْفِتْيَةُ", "translit": "ُẗَyْtِfْlٱ", "root": "فتي"}, {"id": 4, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلْكَهْفِ", "translit": "ِfْhَkْlٱ", "root": "كهف"}, {"id": 6, "arabic": "فَقَالُوا۟", "translit": "۟āwُlāَqَf", "root": "قول"}, {"id": 7, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 8, "arabic": "ءَاتِنَا", "translit": "āَnِtāَء", "root": "اتي"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "لَّدُنكَ", "translit": "َknُdَّl", "root": "لدن"}, {"id": 11, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 12, "arabic": "وَهَيِّئْ", "translit": "ْyʾِّyَhَw", "root": "هيا"}, {"id": 13, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 14, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 15, "arabic": "أَمْرِنَا", "translit": "āَnِrْmَaʾ", "root": "امر"}, {"id": 16, "arabic": "رَشَدًا", "translit": "āًdَhsَr", "root": "رشد"}], "hasIhya": true}, {"ayah": 11, "text": "فَضَرَبْنَا عَلَىٰٓ ءَاذَانِهِمْ فِى ٱلْكَهْفِ سِنِينَ عَدَدًا ", "translation": "So We cast [a cover of sleep] over their ears within the cave for a number of years.", "words": [{"id": 1, "arabic": "فَضَرَبْنَا", "translit": "āَnْbَrَḍَf", "root": "ضرب"}, {"id": 2, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 3, "arabic": "ءَاذَانِهِمْ", "translit": "ْmِhِnāَhdāَء", "root": "اذن"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْكَهْفِ", "translit": "ِfْhَkْlٱ", "root": "كهف"}, {"id": 6, "arabic": "سِنِينَ", "translit": "َnyِnِs", "root": "سنو"}, {"id": 7, "arabic": "عَدَدًا", "translit": "āًdَdَʿع", "root": "عدد"}], "hasIhya": false}, {"ayah": 12, "text": "ثُمَّ بَعَثْنَٰهُمْ لِنَعْلَمَ أَىُّ ٱلْحِزْبَيْنِ أَحْصَىٰ لِمَا لَبِثُوٓا۟ أَمَدًا ", "translation": "Then We awakened them that We might show which of the two factions was most precise in calculating what [extent] they had remained in time.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "بَعَثْنَٰهُمْ", "translit": "ْmُhَٰnْhtَʿعَb", "root": "بعث"}, {"id": 3, "arabic": "لِنَعْلَمَ", "translit": "َmَlْʿعَnِl", "root": "علم"}, {"id": 4, "arabic": "أَىُّ", "translit": "ُّàَaʾ", "root": "ايي"}, {"id": 5, "arabic": "ٱلْحِزْبَيْنِ", "translit": "ِnْyَbْzِḥْlٱ", "root": "حزب"}, {"id": 6, "arabic": "أَحْصَىٰ", "translit": "ٰàَṣْḥَaʾ", "root": "حصي"}, {"id": 7, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 8, "arabic": "لَبِثُوٓا۟", "translit": "۟āٓwُhtِbَl", "root": "لبث"}, {"id": 9, "arabic": "أَمَدًا", "translit": "āًdَmَaʾ", "root": "امد"}], "hasIhya": false}, {"ayah": 13, "text": "نَّحْنُ نَقُصُّ عَلَيْكَ نَبَأَهُم بِٱلْحَقِّۚ إِنَّهُمْ فِتْيَةٌ ءَامَنُوا۟ بِرَبِّهِمْ وَزِدْنَٰهُمْ هُدًى ", "translation": "It is We who relate to you, [O Muḥammad], their story in truth. Indeed, they were youths who believed in their Lord, and We increased them in guidance.", "words": [{"id": 1, "arabic": "نَّحْنُ", "translit": "ُnْḥَّn", "root": ""}, {"id": 2, "arabic": "نَقُصُّ", "translit": "ُّṣُqَn", "root": "قصص"}, {"id": 3, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "نَبَأَهُم", "translit": "mُhَaʾَbَn", "root": "نبا"}, {"id": 5, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 6, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 7, "arabic": "فِتْيَةٌ", "translit": "ٌẗَyْtِf", "root": "فتي"}, {"id": 8, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 9, "arabic": "بِرَبِّهِمْ", "translit": "ْmِhِّbَrِb", "root": "ربب"}, {"id": 10, "arabic": "وَزِدْنَٰهُمْ", "translit": "ْmُhَٰnْdِzَw", "root": "زيد"}, {"id": 11, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}], "hasIhya": true}, {"ayah": 14, "text": "وَرَبَطْنَا عَلَىٰ قُلُوبِهِمْ إِذْ قَامُوا۟ فَقَالُوا۟ رَبُّنَا رَبُّ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ لَن نَّدْعُوَا۟ مِن دُونِهِۦٓ إِلَٰهًاۖ لَّقَدْ قُلْنَآ إِذًا شَطَطًا ", "translation": "And We bound [i.e., made firm] their hearts when they stood up and said, \"Our Lord is the Lord of the heavens and the earth. Never will we invoke besides Him any deity. We would have certainly spoken, then, an excessive transgression.", "words": [{"id": 1, "arabic": "وَرَبَطْنَا", "translit": "āَnْṭَbَrَw", "root": "ربط"}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 4, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 5, "arabic": "قَامُوا۟", "translit": "۟āwُmāَq", "root": "قوم"}, {"id": 6, "arabic": "فَقَالُوا۟", "translit": "۟āwُlāَqَf", "root": "قول"}, {"id": 7, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 8, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 9, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 10, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 11, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 12, "arabic": "نَّدْعُوَا۟", "translit": "۟āَwُʿعْdَّn", "root": "دعو"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 15, "arabic": "إِلَٰهًا", "translit": "āًhَٰlِiʾ", "root": "اله"}, {"id": 16, "arabic": "لَّقَدْ", "translit": "ْdَqَّl", "root": ""}, {"id": 17, "arabic": "قُلْنَآ", "translit": "ٓāَnْlُq", "root": "قول"}, {"id": 18, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 19, "arabic": "شَطَطًا", "translit": "āًṭَṭَhs", "root": "شطط"}], "hasIhya": false}, {"ayah": 15, "text": "هَٰٓؤُلَآءِ قَوْمُنَا ٱتَّخَذُوا۟ مِن دُونِهِۦٓ ءَالِهَةًۖ لَّوْلَا يَأْتُونَ عَلَيْهِم بِسُلْطَٰنٍۭ بَيِّنٍۖ فَمَنْ أَظْلَمُ مِمَّنِ ٱفْتَرَىٰ عَلَى ٱللَّهِ كَذِبًا ", "translation": "These, our people, have taken besides Him deities. Why do they not bring for [worship of] them a clear evidence? And who is more unjust than one who invents about Allāh a lie?\"", "words": [{"id": 1, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 2, "arabic": "قَوْمُنَا", "translit": "āَnُmْwَq", "root": "قوم"}, {"id": 3, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "دُونِهِۦٓ", "translit": "ٓۦِhِnwُd", "root": "دون"}, {"id": 6, "arabic": "ءَالِهَةً", "translit": "ًẗَhِlāَء", "root": "اله"}, {"id": 7, "arabic": "لَّوْلَا", "translit": "āَlْwَّl", "root": ""}, {"id": 8, "arabic": "يَأْتُونَ", "translit": "َnwُtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "بِسُلْطَٰنٍۭ", "translit": "ٍۭnَٰṭْlُsِb", "root": "سلط"}, {"id": 11, "arabic": "بَيِّنٍ", "translit": "ٍnِّyَb", "root": "بين"}, {"id": 12, "arabic": "فَمَنْ", "translit": "ْnَmَf", "root": ""}, {"id": 13, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 14, "arabic": "مِمَّنِ", "translit": "ِnَّmِm", "root": ""}, {"id": 15, "arabic": "ٱفْتَرَىٰ", "translit": "ٰàَrَtْfٱ", "root": "فري"}, {"id": 16, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "كَذِبًا", "translit": "āًbِhdَk", "root": "كذب"}], "hasIhya": true}, {"ayah": 16, "text": "وَإِذِ ٱعْتَزَلْتُمُوهُمْ وَمَا يَعْبُدُونَ إِلَّا ٱللَّهَ فَأْوُۥٓا۟ إِلَى ٱلْكَهْفِ يَنشُرْ لَكُمْ رَبُّكُم مِّن رَّحْمَتِهِۦ وَيُهَيِّئْ لَكُم مِّنْ أَمْرِكُم مِّرْفَقًا ", "translation": "[The youths said to one another], \"And when you have withdrawn from them and that which they worship other than Allāh, retreat to the cave. Your Lord will spread out for you of His mercy and will prepare for you from your affair facility.\"", "words": [{"id": 1, "arabic": "وَإِذِ", "translit": "ِhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱعْتَزَلْتُمُوهُمْ", "translit": "ْmُhwُmُtْlَzَtْʿعٱ", "root": "عزل"}, {"id": 3, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 4, "arabic": "يَعْبُدُونَ", "translit": "َnwُdُbْʿعَy", "root": "عبد"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "فَأْوُۥٓا۟", "translit": "۟āٓۥُwْaʾَf", "root": "اوي"}, {"id": 8, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلْكَهْفِ", "translit": "ِfْhَkْlٱ", "root": "كهف"}, {"id": 10, "arabic": "يَنشُرْ", "translit": "ْrُhsnَy", "root": "نشر"}, {"id": 11, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 12, "arabic": "رَبُّكُم", "translit": "mُkُّbَr", "root": "ربب"}, {"id": 13, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 14, "arabic": "رَّحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَّr", "root": "رحم"}, {"id": 15, "arabic": "وَيُهَيِّئْ", "translit": "ْyʾِّyَhُyَw", "root": "هيا"}, {"id": 16, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 17, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 18, "arabic": "أَمْرِكُم", "translit": "mُkِrْmَaʾ", "root": "امر"}, {"id": 19, "arabic": "مِّرْفَقًا", "translit": "āًqَfْrِّm", "root": "رفق"}], "hasIhya": true}, {"ayah": 17, "text": "وَتَرَى ٱلشَّمْسَ إِذَا طَلَعَت تَّزَٰوَرُ عَن كَهْفِهِمْ ذَاتَ ٱلْيَمِينِ وَإِذَا غَرَبَت تَّقْرِضُهُمْ ذَاتَ ٱلشِّمَالِ وَهُمْ فِى فَجْوَةٍ مِّنْهُۚ ذَٰلِكَ مِنْ ءَايَٰتِ ٱللَّهِۗ مَن يَهْدِ ٱللَّهُ فَهُوَ ٱلْمُهْتَدِۖ وَمَن يُضْلِلْ فَلَن تَجِدَ لَهُۥ وَلِيًّا مُّرْشِدًا ", "translation": "And [had you been present], you would see the sun when it rose, inclining away from their cave on the right, and when it set, passing away from them on the left, while they were [lying] within an open space thereof. That was from the signs of Allāh. He whom Allāh guides is the [rightly] guided, but he whom He sends astray - never will you find for him a protecting guide.", "words": [{"id": 1, "arabic": "وَتَرَى", "translit": "àَrَtَw", "root": "راي"}, {"id": 2, "arabic": "ٱلشَّمْسَ", "translit": "َsْmَّhslٱ", "root": "شمس"}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "طَلَعَت", "translit": "tَʿعَlَṭ", "root": "طلع"}, {"id": 5, "arabic": "تَّزَٰوَرُ", "translit": "ُrَwَٰzَّt", "root": "زور"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "كَهْفِهِمْ", "translit": "ْmِhِfْhَk", "root": "كهف"}, {"id": 8, "arabic": "ذَاتَ", "translit": "َtāَhd", "root": ""}, {"id": 9, "arabic": "ٱلْيَمِينِ", "translit": "ِnyِmَyْlٱ", "root": "يمن"}, {"id": 10, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 11, "arabic": "غَرَبَت", "translit": "tَbَrَغ", "root": "غرب"}, {"id": 12, "arabic": "تَّقْرِضُهُمْ", "translit": "ْmُhُḍِrْqَّt", "root": "قرض"}, {"id": 13, "arabic": "ذَاتَ", "translit": "َtāَhd", "root": ""}, {"id": 14, "arabic": "ٱلشِّمَالِ", "translit": "ِlāَmِّhslٱ", "root": "شمل"}, {"id": 15, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "فَجْوَةٍ", "translit": "ٍẗَwْjgَf", "root": "فجو"}, {"id": 18, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 19, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 20, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 21, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 24, "arabic": "يَهْدِ", "translit": "ِdْhَy", "root": "هدي"}, {"id": 25, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 27, "arabic": "ٱلْمُهْتَدِ", "translit": "ِdَtْhُmْlٱ", "root": "هدي"}, {"id": 28, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 29, "arabic": "يُضْلِلْ", "translit": "ْlِlْḍُy", "root": "ضلل"}, {"id": 30, "arabic": "فَلَن", "translit": "nَlَf", "root": ""}, {"id": 31, "arabic": "تَجِدَ", "translit": "َdِjgَt", "root": "وجد"}, {"id": 32, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 33, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 34, "arabic": "مُّرْشِدًا", "translit": "āًdِhsْrُّm", "root": "رشد"}], "hasIhya": false}, {"ayah": 18, "text": "وَتَحْسَبُهُمْ أَيْقَاظًا وَهُمْ رُقُودٌۚ وَنُقَلِّبُهُمْ ذَاتَ ٱلْيَمِينِ وَذَاتَ ٱلشِّمَالِۖ وَكَلْبُهُم بَٰسِطٌ ذِرَاعَيْهِ بِٱلْوَصِيدِۚ لَوِ ٱطَّلَعْتَ عَلَيْهِمْ لَوَلَّيْتَ مِنْهُمْ فِرَارًا وَلَمُلِئْتَ مِنْهُمْ رُعْبًا ", "translation": "And you would think them awake, while they were asleep. And We turned them to the right and to the left, while their dog stretched his forelegs at the entrance. If you had looked at them, you would have turned from them in flight and been filled by them with terror.", "words": [{"id": 1, "arabic": "وَتَحْسَبُهُمْ", "translit": "ْmُhُbَsْḥَtَw", "root": "حسب"}, {"id": 2, "arabic": "أَيْقَاظًا", "translit": "āًẓāَqْyَaʾ", "root": "يقظ"}, {"id": 3, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 4, "arabic": "رُقُودٌ", "translit": "ٌdwُqُr", "root": "رقد"}, {"id": 5, "arabic": "وَنُقَلِّبُهُمْ", "translit": "ْmُhُbِّlَqُnَw", "root": "قلب"}, {"id": 6, "arabic": "ذَاتَ", "translit": "َtāَhd", "root": ""}, {"id": 7, "arabic": "ٱلْيَمِينِ", "translit": "ِnyِmَyْlٱ", "root": "يمن"}, {"id": 8, "arabic": "وَذَاتَ", "translit": "َtāَhdَw", "root": ""}, {"id": 9, "arabic": "ٱلشِّمَالِ", "translit": "ِlāَmِّhslٱ", "root": "شمل"}, {"id": 10, "arabic": "وَكَلْبُهُم", "translit": "mُhُbْlَkَw", "root": "كلب"}, {"id": 11, "arabic": "بَٰسِطٌ", "translit": "ٌṭِsَٰb", "root": "بسط"}, {"id": 12, "arabic": "ذِرَاعَيْهِ", "translit": "ِhْyَʿعāَrِhd", "root": "ذرع"}, {"id": 13, "arabic": "بِٱلْوَصِيدِ", "translit": "ِdyِṣَwْlٱِb", "root": "وصد"}, {"id": 14, "arabic": "لَوِ", "translit": "ِwَl", "root": ""}, {"id": 15, "arabic": "ٱطَّلَعْتَ", "translit": "َtْʿعَlَّṭٱ", "root": "طلع"}, {"id": 16, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 17, "arabic": "لَوَلَّيْتَ", "translit": "َtْyَّlَwَl", "root": "ولي"}, {"id": 18, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 19, "arabic": "فِرَارًا", "translit": "āًrāَrِf", "root": "فرر"}, {"id": 20, "arabic": "وَلَمُلِئْتَ", "translit": "َtْyʾِlُmَlَw", "root": "ملا"}, {"id": 21, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 22, "arabic": "رُعْبًا", "translit": "āًbْʿعُr", "root": "رعب"}], "hasIhya": false}, {"ayah": 19, "text": "وَكَذَٰلِكَ بَعَثْنَٰهُمْ لِيَتَسَآءَلُوا۟ بَيْنَهُمْۚ قَالَ قَآئِلٌ مِّنْهُمْ كَمْ لَبِثْتُمْۖ قَالُوا۟ لَبِثْنَا يَوْمًا أَوْ بَعْضَ يَوْمٍۚ قَالُوا۟ رَبُّكُمْ أَعْلَمُ بِمَا لَبِثْتُمْ فَٱبْعَثُوٓا۟ أَحَدَكُم بِوَرِقِكُمْ هَٰذِهِۦٓ إِلَى ٱلْمَدِينَةِ فَلْيَنظُرْ أَيُّهَآ أَزْكَىٰ طَعَامًا فَلْيَأْتِكُم بِرِزْقٍ مِّنْهُ وَلْيَتَلَطَّفْ وَلَا يُشْعِرَنَّ بِكُمْ أَحَدًا ", "translation": "And similarly,[1] We awakened them that they might question one another. Said a speaker from among them, \"How long have you remained [here]?\" They said, \"We have remained a day or part of a day.\" They said, \"Your Lord is most knowing of how long you remained. So send one of you with this silver coin of yours to the city and let him look to which is the best of food and bring you provision from it and let him be cautious. And let no one be aware of you.", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "بَعَثْنَٰهُمْ", "translit": "ْmُhَٰnْhtَʿعَb", "root": "بعث"}, {"id": 3, "arabic": "لِيَتَسَآءَلُوا۟", "translit": "۟āwُlَءٓāَsَtَyِl", "root": "سال"}, {"id": 4, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "قَآئِلٌ", "translit": "ٌlِyʾٓāَq", "root": "قول"}, {"id": 7, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 8, "arabic": "كَمْ", "translit": "ْmَk", "root": ""}, {"id": 9, "arabic": "لَبِثْتُمْ", "translit": "ْmُtْhtِbَl", "root": "لبث"}, {"id": 10, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 11, "arabic": "لَبِثْنَا", "translit": "āَnْhtِbَl", "root": "لبث"}, {"id": 12, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 13, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 14, "arabic": "بَعْضَ", "translit": "َḍْʿعَb", "root": "بعض"}, {"id": 15, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 16, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 17, "arabic": "رَبُّكُمْ", "translit": "ْmُkُّbَr", "root": "ربب"}, {"id": 18, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 20, "arabic": "لَبِثْتُمْ", "translit": "ْmُtْhtِbَl", "root": "لبث"}, {"id": 21, "arabic": "فَٱبْعَثُوٓا۟", "translit": "۟āٓwُhtَʿعْbٱَf", "root": "بعث"}, {"id": 22, "arabic": "أَحَدَكُم", "translit": "mُkَdَḥَaʾ", "root": "احد"}, {"id": 23, "arabic": "بِوَرِقِكُمْ", "translit": "ْmُkِqِrَwِb", "root": "ورق"}, {"id": 24, "arabic": "هَٰذِهِۦٓ", "translit": "ٓۦِhِhdَٰh", "root": ""}, {"id": 25, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 26, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 27, "arabic": "فَلْيَنظُرْ", "translit": "ْrُẓnَyْlَf", "root": "نظر"}, {"id": 28, "arabic": "أَيُّهَآ", "translit": "ٓāَhُّyَaʾ", "root": "ايي"}, {"id": 29, "arabic": "أَزْكَىٰ", "translit": "ٰàَkْzَaʾ", "root": "زكو"}, {"id": 30, "arabic": "طَعَامًا", "translit": "āًmāَʿعَṭ", "root": "طعم"}, {"id": 31, "arabic": "فَلْيَأْتِكُم", "translit": "mُkِtْaʾَyْlَf", "root": "اتي"}, {"id": 32, "arabic": "بِرِزْقٍ", "translit": "ٍqْzِrِb", "root": "رزق"}, {"id": 33, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 34, "arabic": "وَلْيَتَلَطَّفْ", "translit": "ْfَّṭَlَtَyْlَw", "root": "لطف"}, {"id": 35, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 36, "arabic": "يُشْعِرَنَّ", "translit": "َّnَrِʿعْhsُy", "root": "شعر"}, {"id": 37, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 38, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}], "hasIhya": true}, {"ayah": 20, "text": "إِنَّهُمْ إِن يَظْهَرُوا۟ عَلَيْكُمْ يَرْجُمُوكُمْ أَوْ يُعِيدُوكُمْ فِى مِلَّتِهِمْ وَلَن تُفْلِحُوٓا۟ إِذًا أَبَدًا ", "translation": "Indeed, if they come to know of you, they will stone you or return you to their religion. And never would you succeed, then - ever.\"", "words": [{"id": 1, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "يَظْهَرُوا۟", "translit": "۟āwُrَhْẓَy", "root": "ظهر"}, {"id": 4, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "يَرْجُمُوكُمْ", "translit": "ْmُkwُmُjgْrَy", "root": "رجم"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "يُعِيدُوكُمْ", "translit": "ْmُkwُdyِʿعُy", "root": "عود"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "مِلَّتِهِمْ", "translit": "ْmِhِtَّlِm", "root": "ملل"}, {"id": 10, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 11, "arabic": "تُفْلِحُوٓا۟", "translit": "۟āٓwُḥِlْfُt", "root": "فلح"}, {"id": 12, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 13, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}], "hasIhya": false}, {"ayah": 21, "text": "وَكَذَٰلِكَ أَعْثَرْنَا عَلَيْهِمْ لِيَعْلَمُوٓا۟ أَنَّ وَعْدَ ٱللَّهِ حَقٌّ وَأَنَّ ٱلسَّاعَةَ لَا رَيْبَ فِيهَآ إِذْ يَتَنَٰزَعُونَ بَيْنَهُمْ أَمْرَهُمْۖ فَقَالُوا۟ ٱبْنُوا۟ عَلَيْهِم بُنْيَٰنًاۖ رَّبُّهُمْ أَعْلَمُ بِهِمْۚ قَالَ ٱلَّذِينَ غَلَبُوا۟ عَلَىٰٓ أَمْرِهِمْ لَنَتَّخِذَنَّ عَلَيْهِم مَّسْجِدًا ", "translation": "And similarly, We caused them to be found that they [who found them] would know that the promise of Allāh is truth and that of the Hour there is no doubt. [That was] when they[1] disputed among themselves about their affair and [then] said, \"Construct over them a structure. Their Lord is most knowing about them.\" Said those who prevailed in the matter, \"We will surely take [for ourselves] over them a masjid.\"[2]", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "أَعْثَرْنَا", "translit": "āَnْrَhtْʿعَaʾ", "root": "عثر"}, {"id": 3, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "لِيَعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعَyِl", "root": "علم"}, {"id": 5, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 6, "arabic": "وَعْدَ", "translit": "َdْʿعَw", "root": "وعد"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "حَقٌّ", "translit": "ٌّqَḥ", "root": "حقق"}, {"id": 9, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 10, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 13, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 14, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 15, "arabic": "يَتَنَٰزَعُونَ", "translit": "َnwُʿعَzَٰnَtَy", "root": "نزع"}, {"id": 16, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 17, "arabic": "أَمْرَهُمْ", "translit": "ْmُhَrْmَaʾ", "root": "امر"}, {"id": 18, "arabic": "فَقَالُوا۟", "translit": "۟āwُlāَqَf", "root": "قول"}, {"id": 19, "arabic": "ٱبْنُوا۟", "translit": "۟āwُnْbٱ", "root": "بني"}, {"id": 20, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 21, "arabic": "بُنْيَٰنًا", "translit": "āًnَٰyْnُb", "root": "بني"}, {"id": 22, "arabic": "رَّبُّهُمْ", "translit": "ْmُhُّbَّr", "root": "ربب"}, {"id": 23, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 24, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 25, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 26, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 27, "arabic": "غَلَبُوا۟", "translit": "۟āwُbَlَغ", "root": "غلب"}, {"id": 28, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 29, "arabic": "أَمْرِهِمْ", "translit": "ْmِhِrْmَaʾ", "root": "امر"}, {"id": 30, "arabic": "لَنَتَّخِذَنَّ", "translit": "َّnَhdِhkَّtَnَl", "root": "اخذ"}, {"id": 31, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 32, "arabic": "مَّسْجِدًا", "translit": "āًdِjgْsَّm", "root": "سجد"}], "hasIhya": false}, {"ayah": 22, "text": "سَيَقُولُونَ ثَلَٰثَةٌ رَّابِعُهُمْ كَلْبُهُمْ وَيَقُولُونَ خَمْسَةٌ سَادِسُهُمْ كَلْبُهُمْ رَجْمًۢا بِٱلْغَيْبِۖ وَيَقُولُونَ سَبْعَةٌ وَثَامِنُهُمْ كَلْبُهُمْۚ قُل رَّبِّىٓ أَعْلَمُ بِعِدَّتِهِم مَّا يَعْلَمُهُمْ إِلَّا قَلِيلٌۗ فَلَا تُمَارِ فِيهِمْ إِلَّا مِرَآءً ظَٰهِرًا وَلَا تَسْتَفْتِ فِيهِم مِّنْهُمْ أَحَدًا ", "translation": "They [i.e., people] will say there were three, the fourth of them being their dog; and they will say there were five, the sixth of them being their dog - guessing at the unseen; and they will say there were seven, and the eighth of them was their dog. Say, [O Muḥammad], \"My Lord is most knowing of their number. None knows them except a few. So do not argue about them except with an obvious argument[1] and do not inquire about them among [the speculators] from anyone.\"", "words": [{"id": 1, "arabic": "سَيَقُولُونَ", "translit": "َnwُlwُqَyَs", "root": "قول"}, {"id": 2, "arabic": "ثَلَٰثَةٌ", "translit": "ٌẗَhtَٰlَht", "root": "ثلث"}, {"id": 3, "arabic": "رَّابِعُهُمْ", "translit": "ْmُhُʿعِbāَّr", "root": "ربع"}, {"id": 4, "arabic": "كَلْبُهُمْ", "translit": "ْmُhُbْlَk", "root": "كلب"}, {"id": 5, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 6, "arabic": "خَمْسَةٌ", "translit": "ٌẗَsْmَhk", "root": "خمس"}, {"id": 7, "arabic": "سَادِسُهُمْ", "translit": "ْmُhُsِdāَs", "root": "سدس"}, {"id": 8, "arabic": "كَلْبُهُمْ", "translit": "ْmُhُbْlَk", "root": "كلب"}, {"id": 9, "arabic": "رَجْمًۢا", "translit": "āًۢmْjgَr", "root": "رجم"}, {"id": 10, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 11, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 12, "arabic": "سَبْعَةٌ", "translit": "ٌẗَʿعْbَs", "root": "سبع"}, {"id": 13, "arabic": "وَثَامِنُهُمْ", "translit": "ْmُhُnِmāَhtَw", "root": "ثمن"}, {"id": 14, "arabic": "كَلْبُهُمْ", "translit": "ْmُhُbْlَk", "root": "كلب"}, {"id": 15, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 16, "arabic": "رَّبِّىٓ", "translit": "ٓàِّbَّr", "root": "ربب"}, {"id": 17, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 18, "arabic": "بِعِدَّتِهِم", "translit": "mِhِtَّdِʿعِb", "root": "عدد"}, {"id": 19, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 20, "arabic": "يَعْلَمُهُمْ", "translit": "ْmُhُmَlْʿعَy", "root": "علم"}, {"id": 21, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 22, "arabic": "قَلِيلٌ", "translit": "ٌlyِlَq", "root": "قلل"}, {"id": 23, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 24, "arabic": "تُمَارِ", "translit": "ِrāَmُt", "root": "مري"}, {"id": 25, "arabic": "فِيهِمْ", "translit": "ْmِhyِf", "root": ""}, {"id": 26, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 27, "arabic": "مِرَآءً", "translit": "ًءٓāَrِm", "root": "مري"}, {"id": 28, "arabic": "ظَٰهِرًا", "translit": "āًrِhَٰẓ", "root": "ظهر"}, {"id": 29, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 30, "arabic": "تَسْتَفْتِ", "translit": "ِtْfَtْsَt", "root": "فتي"}, {"id": 31, "arabic": "فِيهِم", "translit": "mِhyِf", "root": ""}, {"id": 32, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 33, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}], "hasIhya": false}, {"ayah": 23, "text": "وَلَا تَقُولَنَّ لِشَا۟ىْءٍ إِنِّى فَاعِلٌ ذَٰلِكَ غَدًا ", "translation": "And never say of anything, \"Indeed, I will do that tomorrow,\"", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَقُولَنَّ", "translit": "َّnَlwُqَt", "root": "قول"}, {"id": 3, "arabic": "لِشَا۟ىْءٍ", "translit": "ٍءْà۟āَhsِl", "root": "شيا"}, {"id": 4, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 5, "arabic": "فَاعِلٌ", "translit": "ٌlِʿعāَf", "root": "فعل"}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 7, "arabic": "غَدًا", "translit": "āًdَغ", "root": "غدو"}], "hasIhya": true}, {"ayah": 24, "text": "إِلَّآ أَن يَشَآءَ ٱللَّهُۚ وَٱذْكُر رَّبَّكَ إِذَا نَسِيتَ وَقُلْ عَسَىٰٓ أَن يَهْدِيَنِ رَبِّى لِأَقْرَبَ مِنْ هَٰذَا رَشَدًا ", "translation": "Except [when adding], \"If Allāh wills.\" And remember your Lord when you forget [it] and say, \"Perhaps my Lord will guide me to what is nearer than this to right conduct.\"", "words": [{"id": 1, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "يَشَآءَ", "translit": "َءٓāَhsَy", "root": "شيا"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَٱذْكُر", "translit": "rُkْhdٱَw", "root": "ذكر"}, {"id": 6, "arabic": "رَّبَّكَ", "translit": "َkَّbَّr", "root": "ربب"}, {"id": 7, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 8, "arabic": "نَسِيتَ", "translit": "َtyِsَn", "root": "نسي"}, {"id": 9, "arabic": "وَقُلْ", "translit": "ْlُqَw", "root": "قول"}, {"id": 10, "arabic": "عَسَىٰٓ", "translit": "ٰٓàَsَʿع", "root": "عسي"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَهْدِيَنِ", "translit": "ِnَyِdْhَy", "root": "هدي"}, {"id": 13, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 14, "arabic": "لِأَقْرَبَ", "translit": "َbَrْqَaʾِl", "root": "قرب"}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 17, "arabic": "رَشَدًا", "translit": "āًdَhsَr", "root": "رشد"}], "hasIhya": true}, {"ayah": 25, "text": "وَلَبِثُوا۟ فِى كَهْفِهِمْ ثَلَٰثَ مِا۟ئَةٍ سِنِينَ وَٱزْدَادُوا۟ تِسْعًا ", "translation": "And they remained in their cave for three hundred years and exceeded by nine.[1]", "words": [{"id": 1, "arabic": "وَلَبِثُوا۟", "translit": "۟āwُhtِbَlَw", "root": "لبث"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "كَهْفِهِمْ", "translit": "ْmِhِfْhَk", "root": "كهف"}, {"id": 4, "arabic": "ثَلَٰثَ", "translit": "َhtَٰlَht", "root": "ثلث"}, {"id": 5, "arabic": "مِا۟ئَةٍ", "translit": "ٍẗَyʾ۟āِm", "root": "ماي"}, {"id": 6, "arabic": "سِنِينَ", "translit": "َnyِnِs", "root": "سنو"}, {"id": 7, "arabic": "وَٱزْدَادُوا۟", "translit": "۟āwُdāَdْzٱَw", "root": "زيد"}, {"id": 8, "arabic": "تِسْعًا", "translit": "āًʿعْsِt", "root": "تسع"}], "hasIhya": false}, {"ayah": 26, "text": "قُلِ ٱللَّهُ أَعْلَمُ بِمَا لَبِثُوا۟ۖ لَهُۥ غَيْبُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ أَبْصِرْ بِهِۦ وَأَسْمِعْۚ مَا لَهُم مِّن دُونِهِۦ مِن وَلِىٍّ وَلَا يُشْرِكُ فِى حُكْمِهِۦٓ أَحَدًا ", "translation": "Say, \"Allāh is most knowing of how long they remained. He has [knowledge of] the unseen [aspects] of the heavens and the earth. How Seeing is He and how Hearing! They have not besides Him any protector, and He shares not His legislation with anyone.\"", "words": [{"id": 1, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "لَبِثُوا۟", "translit": "۟āwُhtِbَl", "root": "لبث"}, {"id": 6, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 7, "arabic": "غَيْبُ", "translit": "ُbْyَغ", "root": "غيب"}, {"id": 8, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 9, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 10, "arabic": "أَبْصِرْ", "translit": "ْrِṣْbَaʾ", "root": "بصر"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "وَأَسْمِعْ", "translit": "ْʿعِmْsَaʾَw", "root": "سمع"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 17, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 18, "arabic": "وَلِىٍّ", "translit": "ٍّàِlَw", "root": "ولي"}, {"id": 19, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 20, "arabic": "يُشْرِكُ", "translit": "ُkِrْhsُy", "root": "شرك"}, {"id": 21, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 22, "arabic": "حُكْمِهِۦٓ", "translit": "ٓۦِhِmْkُḥ", "root": "حكم"}, {"id": 23, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}], "hasIhya": false}, {"ayah": 27, "text": "وَٱتْلُ مَآ أُوحِىَ إِلَيْكَ مِن كِتَابِ رَبِّكَۖ لَا مُبَدِّلَ لِكَلِمَٰتِهِۦ وَلَن تَجِدَ مِن دُونِهِۦ مُلْتَحَدًا ", "translation": "And recite, [O Muḥammad], what has been revealed to you of the Book of your Lord. There is no changer of His words, and never will you find in other than Him a refuge.", "words": [{"id": 1, "arabic": "وَٱتْلُ", "translit": "ُlْtٱَw", "root": "تلو"}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أُوحِىَ", "translit": "َàِḥwُaʾ", "root": "وحي"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "كِتَابِ", "translit": "ِbāَtِk", "root": "كتب"}, {"id": 7, "arabic": "رَبِّكَ", "translit": "َkِّbَr", "root": "ربب"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "مُبَدِّلَ", "translit": "َlِّdَbُm", "root": "بدل"}, {"id": 10, "arabic": "لِكَلِمَٰتِهِۦ", "translit": "ۦِhِtَٰmِlَkِl", "root": "كلم"}, {"id": 11, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 12, "arabic": "تَجِدَ", "translit": "َdِjgَt", "root": "وجد"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "دُونِهِۦ", "translit": "ۦِhِnwُd", "root": "دون"}, {"id": 15, "arabic": "مُلْتَحَدًا", "translit": "āًdَḥَtْlُm", "root": "لحد"}], "hasIhya": false}, {"ayah": 28, "text": "وَٱصْبِرْ نَفْسَكَ مَعَ ٱلَّذِينَ يَدْعُونَ رَبَّهُم بِٱلْغَدَوٰةِ وَٱلْعَشِىِّ يُرِيدُونَ وَجْهَهُۥۖ وَلَا تَعْدُ عَيْنَاكَ عَنْهُمْ تُرِيدُ زِينَةَ ٱلْحَيَوٰةِ ٱلدُّنْيَاۖ وَلَا تُطِعْ مَنْ أَغْفَلْنَا قَلْبَهُۥ عَن ذِكْرِنَا وَٱتَّبَعَ هَوَىٰهُ وَكَانَ أَمْرُهُۥ فُرُطًا ", "translation": "And keep yourself patient [by being] with those who call upon their Lord in the morning and the evening, seeking His face [i.e., acceptance]. And let not your eyes pass beyond them, desiring adornments of the worldly life, and do not obey one whose heart We have made heedless of Our remembrance and who follows his desire and whose affair is ever [in] neglect.[1]", "words": [{"id": 1, "arabic": "وَٱصْبِرْ", "translit": "ْrِbْṣٱَw", "root": "صبر"}, {"id": 2, "arabic": "نَفْسَكَ", "translit": "َkَsْfَn", "root": "نفس"}, {"id": 3, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 6, "arabic": "رَبَّهُم", "translit": "mُhَّbَr", "root": "ربب"}, {"id": 7, "arabic": "بِٱلْغَدَوٰةِ", "translit": "ِẗٰwَdَغْlٱِb", "root": "غدو"}, {"id": 8, "arabic": "وَٱلْعَشِىِّ", "translit": "ِّàِhsَʿعْlٱَw", "root": "عشو"}, {"id": 9, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود"}, {"id": 10, "arabic": "وَجْهَهُۥ", "translit": "ۥُhَhْjgَw", "root": "وجه"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تَعْدُ", "translit": "ُdْʿعَt", "root": "عدو"}, {"id": 13, "arabic": "عَيْنَاكَ", "translit": "َkāَnْyَʿع", "root": "عين"}, {"id": 14, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 15, "arabic": "تُرِيدُ", "translit": "ُdyِrُt", "root": "رود"}, {"id": 16, "arabic": "زِينَةَ", "translit": "َẗَnyِz", "root": "زين"}, {"id": 17, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 18, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 19, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 20, "arabic": "تُطِعْ", "translit": "ْʿعِṭُt", "root": "طوع"}, {"id": 21, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 22, "arabic": "أَغْفَلْنَا", "translit": "āَnْlَfْغَaʾ", "root": "غفل"}, {"id": 23, "arabic": "قَلْبَهُۥ", "translit": "ۥُhَbْlَq", "root": "قلب"}, {"id": 24, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 25, "arabic": "ذِكْرِنَا", "translit": "āَnِrْkِhd", "root": "ذكر"}, {"id": 26, "arabic": "وَٱتَّبَعَ", "translit": "َʿعَbَّtٱَw", "root": "تبع"}, {"id": 27, "arabic": "هَوَىٰهُ", "translit": "ُhٰàَwَh", "root": "هوي"}, {"id": 28, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 29, "arabic": "أَمْرُهُۥ", "translit": "ۥُhُrْmَaʾ", "root": "امر"}, {"id": 30, "arabic": "فُرُطًا", "translit": "āًṭُrُf", "root": "فرط"}], "hasIhya": true}, {"ayah": 29, "text": "وَقُلِ ٱلْحَقُّ مِن رَّبِّكُمْۖ فَمَن شَآءَ فَلْيُؤْمِن وَمَن شَآءَ فَلْيَكْفُرْۚ إِنَّآ أَعْتَدْنَا لِلظَّٰلِمِينَ نَارًا أَحَاطَ بِهِمْ سُرَادِقُهَاۚ وَإِن يَسْتَغِيثُوا۟ يُغَاثُوا۟ بِمَآءٍ كَٱلْمُهْلِ يَشْوِى ٱلْوُجُوهَۚ بِئْسَ ٱلشَّرَابُ وَسَآءَتْ مُرْتَفَقًا ", "translation": "And say, \"The truth is from your Lord, so whoever wills - let him believe; and whoever wills - let him disbelieve.\" Indeed, We have prepared for the wrongdoers a fire whose walls will surround them. And if they call for relief, they will be relieved with water like murky oil, which scalds [their] faces. Wretched is the drink, and evil is the resting place.", "words": [{"id": 1, "arabic": "وَقُلِ", "translit": "ِlُqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 5, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 6, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 7, "arabic": "فَلْيُؤْمِن", "translit": "nِmْwʾُyْlَf", "root": "امن"}, {"id": 8, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 9, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 10, "arabic": "فَلْيَكْفُرْ", "translit": "ْrُfْkَyْlَf", "root": "كفر"}, {"id": 11, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 12, "arabic": "أَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾ", "root": "عتد"}, {"id": 13, "arabic": "لِلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlِl", "root": "ظلم"}, {"id": 14, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 15, "arabic": "أَحَاطَ", "translit": "َṭāَḥَaʾ", "root": "حوط"}, {"id": 16, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 17, "arabic": "سُرَادِقُهَا", "translit": "āَhُqِdāَrُs", "root": "سردق"}, {"id": 18, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 19, "arabic": "يَسْتَغِيثُوا۟", "translit": "۟āwُhtyِغَtْsَy", "root": "غوث"}, {"id": 20, "arabic": "يُغَاثُوا۟", "translit": "۟āwُhtāَغُy", "root": "غوث"}, {"id": 21, "arabic": "بِمَآءٍ", "translit": "ٍءٓāَmِb", "root": "موه"}, {"id": 22, "arabic": "كَٱلْمُهْلِ", "translit": "ِlْhُmْlٱَk", "root": "مهل"}, {"id": 23, "arabic": "يَشْوِى", "translit": "àِwْhsَy", "root": "شوي"}, {"id": 24, "arabic": "ٱلْوُجُوهَ", "translit": "َhwُjgُwْlٱ", "root": "وجه"}, {"id": 25, "arabic": "بِئْسَ", "translit": "َsْyʾِb", "root": "باس"}, {"id": 26, "arabic": "ٱلشَّرَابُ", "translit": "ُbāَrَّhslٱ", "root": "شرب"}, {"id": 27, "arabic": "وَسَآءَتْ", "translit": "ْtَءٓāَsَw", "root": "سوا"}, {"id": 28, "arabic": "مُرْتَفَقًا", "translit": "āًqَfَtْrُm", "root": "رفق"}], "hasIhya": true}, {"ayah": 30, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ إِنَّا لَا نُضِيعُ أَجْرَ مَنْ أَحْسَنَ عَمَلًا ", "translation": "Indeed, those who have believed and done righteous deeds - indeed, We will not allow to be lost the reward of any who did well in deeds.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "نُضِيعُ", "translit": "ُʿعyِḍُn", "root": "ضيع"}, {"id": 9, "arabic": "أَجْرَ", "translit": "َrْjgَaʾ", "root": "اجر"}, {"id": 10, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 11, "arabic": "أَحْسَنَ", "translit": "َnَsْḥَaʾ", "root": "حسن"}, {"id": 12, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}], "hasIhya": true}, {"ayah": 31, "text": "أُو۟لَٰٓئِكَ لَهُمْ جَنَّٰتُ عَدْنٍ تَجْرِى مِن تَحْتِهِمُ ٱلْأَنْهَٰرُ يُحَلَّوْنَ فِيهَا مِنْ أَسَاوِرَ مِن ذَهَبٍ وَيَلْبَسُونَ ثِيَابًا خُضْرًا مِّن سُندُسٍ وَإِسْتَبْرَقٍ مُّتَّكِـِٔينَ فِيهَا عَلَى ٱلْأَرَآئِكِۚ نِعْمَ ٱلثَّوَابُ وَحَسُنَتْ مُرْتَفَقًا ", "translation": "Those will have gardens of perpetual residence; beneath them rivers will flow. They will be adorned therein with bracelets of gold and will wear green garments of fine silk and brocade, reclining therein on adorned couches. Excellent is the reward, and good is the resting place.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "جَنَّٰتُ", "translit": "ُtَّٰnَjg", "root": "جنن"}, {"id": 4, "arabic": "عَدْنٍ", "translit": "ٍnْdَʿع", "root": ""}, {"id": 5, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "تَحْتِهِمُ", "translit": "ُmِhِtْḥَt", "root": "تحت"}, {"id": 8, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 9, "arabic": "يُحَلَّوْنَ", "translit": "َnْwَّlَḥُy", "root": "حلي"}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 11, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 12, "arabic": "أَسَاوِرَ", "translit": "َrِwāَsَaʾ", "root": "سور"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "ذَهَبٍ", "translit": "ٍbَhَhd", "root": "ذهب"}, {"id": 15, "arabic": "وَيَلْبَسُونَ", "translit": "َnwُsَbْlَyَw", "root": "لبس"}, {"id": 16, "arabic": "ثِيَابًا", "translit": "āًbāَyِht", "root": "ثوب"}, {"id": 17, "arabic": "خُضْرًا", "translit": "āًrْḍُhk", "root": "خضر"}, {"id": 18, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 19, "arabic": "سُندُسٍ", "translit": "ٍsُdnُs", "root": ""}, {"id": 20, "arabic": "وَإِسْتَبْرَقٍ", "translit": "ٍqَrْbَtْsِiʾَw", "root": ""}, {"id": 21, "arabic": "مُّتَّكِـِٔينَ", "translit": "َnyِٔـِkَّtُّm", "root": "وكا"}, {"id": 22, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 23, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 24, "arabic": "ٱلْأَرَآئِكِ", "translit": "ِkِyʾٓāَrَaʾْlٱ", "root": "ارك"}, {"id": 25, "arabic": "نِعْمَ", "translit": "َmْʿعِn", "root": "نعم"}, {"id": 26, "arabic": "ٱلثَّوَابُ", "translit": "ُbāَwَّhtlٱ", "root": "ثوب"}, {"id": 27, "arabic": "وَحَسُنَتْ", "translit": "ْtَnُsَḥَw", "root": "حسن"}, {"id": 28, "arabic": "مُرْتَفَقًا", "translit": "āًqَfَtْrُm", "root": "رفق"}], "hasIhya": true}, {"ayah": 32, "text": "وَٱضْرِبْ لَهُم مَّثَلًا رَّجُلَيْنِ جَعَلْنَا لِأَحَدِهِمَا جَنَّتَيْنِ مِنْ أَعْنَٰبٍ وَحَفَفْنَٰهُمَا بِنَخْلٍ وَجَعَلْنَا بَيْنَهُمَا زَرْعًا ", "translation": "And present to them an example of two men: We granted to one of them two gardens of grapevines, and We bordered them with palm trees and placed between them [fields of] crops.", "words": [{"id": 1, "arabic": "وَٱضْرِبْ", "translit": "ْbِrْḍٱَw", "root": "ضرب"}, {"id": 2, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 3, "arabic": "مَّثَلًا", "translit": "āًlَhtَّm", "root": "مثل"}, {"id": 4, "arabic": "رَّجُلَيْنِ", "translit": "ِnْyَlُjgَّr", "root": "رجل"}, {"id": 5, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 6, "arabic": "لِأَحَدِهِمَا", "translit": "āَmِhِdَḥَaʾِl", "root": "احد"}, {"id": 7, "arabic": "جَنَّتَيْنِ", "translit": "ِnْyَtَّnَjg", "root": "جنن"}, {"id": 8, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 9, "arabic": "أَعْنَٰبٍ", "translit": "ٍbَٰnْʿعَaʾ", "root": "عنب"}, {"id": 10, "arabic": "وَحَفَفْنَٰهُمَا", "translit": "āَmُhَٰnْfَfَḥَw", "root": "حفف"}, {"id": 11, "arabic": "بِنَخْلٍ", "translit": "ٍlْhkَnِb", "root": "نخل"}, {"id": 12, "arabic": "وَجَعَلْنَا", "translit": "āَnْlَʿعَjgَw", "root": "جعل"}, {"id": 13, "arabic": "بَيْنَهُمَا", "translit": "āَmُhَnْyَb", "root": "بين"}, {"id": 14, "arabic": "زَرْعًا", "translit": "āًʿعْrَz", "root": "زرع"}], "hasIhya": false}, {"ayah": 33, "text": "كِلْتَا ٱلْجَنَّتَيْنِ ءَاتَتْ أُكُلَهَا وَلَمْ تَظْلِم مِّنْهُ شَيْـًٔاۚ وَفَجَّرْنَا خِلَٰلَهُمَا نَهَرًا ", "translation": "Each of the two gardens produced its fruit and did not fall short thereof in anything. And We caused to gush forth within them a river.", "words": [{"id": 1, "arabic": "كِلْتَا", "translit": "āَtْlِk", "root": "كلو"}, {"id": 2, "arabic": "ٱلْجَنَّتَيْنِ", "translit": "ِnْyَtَّnَjgْlٱ", "root": "جنن"}, {"id": 3, "arabic": "ءَاتَتْ", "translit": "ْtَtāَء", "root": "اتي"}, {"id": 4, "arabic": "أُكُلَهَا", "translit": "āَhَlُkُaʾ", "root": "اكل"}, {"id": 5, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 6, "arabic": "تَظْلِم", "translit": "mِlْẓَt", "root": "ظلم"}, {"id": 7, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 8, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 9, "arabic": "وَفَجَّرْنَا", "translit": "āَnْrَّjgَfَw", "root": "فجر"}, {"id": 10, "arabic": "خِلَٰلَهُمَا", "translit": "āَmُhَlَٰlِhk", "root": "خلل"}, {"id": 11, "arabic": "نَهَرًا", "translit": "āًrَhَn", "root": "نهر"}], "hasIhya": false}, {"ayah": 34, "text": "وَكَانَ لَهُۥ ثَمَرٌ فَقَالَ لِصَٰحِبِهِۦ وَهُوَ يُحَاوِرُهُۥٓ أَنَا۠ أَكْثَرُ مِنكَ مَالًا وَأَعَزُّ نَفَرًا ", "translation": "And he had fruit, so he said to his companion while he was conversing with him, \"I am greater than you in wealth and mightier in [numbers of] men.\"", "words": [{"id": 1, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "ثَمَرٌ", "translit": "ٌrَmَht", "root": "ثمر"}, {"id": 4, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 5, "arabic": "لِصَٰحِبِهِۦ", "translit": "ۦِhِbِḥَٰṣِl", "root": "صحب"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "يُحَاوِرُهُۥٓ", "translit": "ٓۥُhُrِwāَḥُy", "root": "حور"}, {"id": 8, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 9, "arabic": "أَكْثَرُ", "translit": "ُrَhtْkَaʾ", "root": "كثر"}, {"id": 10, "arabic": "مِنكَ", "translit": "َknِm", "root": ""}, {"id": 11, "arabic": "مَالًا", "translit": "āًlāَm", "root": "مول"}, {"id": 12, "arabic": "وَأَعَزُّ", "translit": "ُّzَʿعَaʾَw", "root": "عزز"}, {"id": 13, "arabic": "نَفَرًا", "translit": "āًrَfَn", "root": "نفر"}], "hasIhya": true}, {"ayah": 35, "text": "وَدَخَلَ جَنَّتَهُۥ وَهُوَ ظَالِمٌ لِّنَفْسِهِۦ قَالَ مَآ أَظُنُّ أَن تَبِيدَ هَٰذِهِۦٓ أَبَدًا ", "translation": "And he entered his garden while he was unjust to himself.[1] He said, \"I do not think that this will perish - ever.", "words": [{"id": 1, "arabic": "وَدَخَلَ", "translit": "َlَhkَdَw", "root": "دخل"}, {"id": 2, "arabic": "جَنَّتَهُۥ", "translit": "ۥُhَtَّnَjg", "root": "جنن"}, {"id": 3, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 4, "arabic": "ظَالِمٌ", "translit": "ٌmِlāَẓ", "root": "ظلم"}, {"id": 5, "arabic": "لِّنَفْسِهِۦ", "translit": "ۦِhِsْfَnِّl", "root": "نفس"}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 8, "arabic": "أَظُنُّ", "translit": "ُّnُẓَaʾ", "root": "ظنن"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "تَبِيدَ", "translit": "َdyِbَt", "root": "بيد"}, {"id": 11, "arabic": "هَٰذِهِۦٓ", "translit": "ٓۦِhِhdَٰh", "root": ""}, {"id": 12, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}], "hasIhya": false}, {"ayah": 36, "text": "وَمَآ أَظُنُّ ٱلسَّاعَةَ قَآئِمَةً وَلَئِن رُّدِدتُّ إِلَىٰ رَبِّى لَأَجِدَنَّ خَيْرًا مِّنْهَا مُنقَلَبًا ", "translation": "And I do not think the Hour will occur. And even if I should be brought back to my Lord, I will surely find better than this as a return.\"", "words": [{"id": 1, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 2, "arabic": "أَظُنُّ", "translit": "ُّnُẓَaʾ", "root": "ظنن"}, {"id": 3, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 4, "arabic": "قَآئِمَةً", "translit": "ًẗَmِyʾٓāَq", "root": "قوم"}, {"id": 5, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 6, "arabic": "رُّدِدتُّ", "translit": "ُّtdِdُّr", "root": "ردد"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 9, "arabic": "لَأَجِدَنَّ", "translit": "َّnَdِjgَaʾَl", "root": "وجد"}, {"id": 10, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 11, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 12, "arabic": "مُنقَلَبًا", "translit": "āًbَlَqnُm", "root": "قلب"}], "hasIhya": true}, {"ayah": 37, "text": "قَالَ لَهُۥ صَاحِبُهُۥ وَهُوَ يُحَاوِرُهُۥٓ أَكَفَرْتَ بِٱلَّذِى خَلَقَكَ مِن تُرَابٍ ثُمَّ مِن نُّطْفَةٍ ثُمَّ سَوَّىٰكَ رَجُلًا ", "translation": "His companion said to him while he was conversing with him, \"Have you disbelieved in He who created you from dust and then from a sperm-drop and then proportioned you [as] a man?", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 3, "arabic": "صَاحِبُهُۥ", "translit": "ۥُhُbِḥāَṣ", "root": "صحب"}, {"id": 4, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 5, "arabic": "يُحَاوِرُهُۥٓ", "translit": "ٓۥُhُrِwāَḥُy", "root": "حور"}, {"id": 6, "arabic": "أَكَفَرْتَ", "translit": "َtْrَfَkَaʾ", "root": "كفر"}, {"id": 7, "arabic": "بِٱلَّذِى", "translit": "àِhdَّlٱِb", "root": ""}, {"id": 8, "arabic": "خَلَقَكَ", "translit": "َkَqَlَhk", "root": "خلق"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "تُرَابٍ", "translit": "ٍbāَrُt", "root": "ترب"}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "نُّطْفَةٍ", "translit": "ٍẗَfْṭُّn", "root": "نطف"}, {"id": 14, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 15, "arabic": "سَوَّىٰكَ", "translit": "َkٰàَّwَs", "root": "سوي"}, {"id": 16, "arabic": "رَجُلًا", "translit": "āًlُjgَr", "root": "رجل"}], "hasIhya": false}, {"ayah": 38, "text": "لَّٰكِنَّا۠ هُوَ ٱللَّهُ رَبِّى وَلَآ أُشْرِكُ بِرَبِّىٓ أَحَدًا ", "translation": "But as for me, He is Allāh, my Lord, and I do not associate with my Lord anyone.", "words": [{"id": 1, "arabic": "لَّٰكِنَّا۠", "translit": "۠āَّnِkَّٰl", "root": ""}, {"id": 2, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "رَبِّى", "translit": "àِّbَr", "root": "ربب"}, {"id": 5, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 6, "arabic": "أُشْرِكُ", "translit": "ُkِrْhsُaʾ", "root": "شرك"}, {"id": 7, "arabic": "بِرَبِّىٓ", "translit": "ٓàِّbَrِb", "root": "ربب"}, {"id": 8, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}], "hasIhya": false}, {"ayah": 39, "text": "وَلَوْلَآ إِذْ دَخَلْتَ جَنَّتَكَ قُلْتَ مَا شَآءَ ٱللَّهُ لَا قُوَّةَ إِلَّا بِٱللَّهِۚ إِن تَرَنِ أَنَا۠ أَقَلَّ مِنكَ مَالًا وَوَلَدًا ", "translation": "And why did you, when you entered your garden, not say, 'What Allāh willed [has occurred]; there is no power except in Allāh'? Although you see me less than you in wealth and children,", "words": [{"id": 1, "arabic": "وَلَوْلَآ", "translit": "ٓāَlْwَlَw", "root": ""}, {"id": 2, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 3, "arabic": "دَخَلْتَ", "translit": "َtْlَhkَd", "root": "دخل"}, {"id": 4, "arabic": "جَنَّتَكَ", "translit": "َkَtَّnَjg", "root": "جنن"}, {"id": 5, "arabic": "قُلْتَ", "translit": "َtْlُq", "root": "قول"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "قُوَّةَ", "translit": "َẗَّwُq", "root": "قوي"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "تَرَنِ", "translit": "ِnَrَt", "root": "راي"}, {"id": 15, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 16, "arabic": "أَقَلَّ", "translit": "َّlَqَaʾ", "root": "قلل"}, {"id": 17, "arabic": "مِنكَ", "translit": "َknِm", "root": ""}, {"id": 18, "arabic": "مَالًا", "translit": "āًlāَm", "root": "مول"}, {"id": 19, "arabic": "وَوَلَدًا", "translit": "āًdَlَwَw", "root": "ولد"}], "hasIhya": true}, {"ayah": 40, "text": "فَعَسَىٰ رَبِّىٓ أَن يُؤْتِيَنِ خَيْرًا مِّن جَنَّتِكَ وَيُرْسِلَ عَلَيْهَا حُسْبَانًا مِّنَ ٱلسَّمَآءِ فَتُصْبِحَ صَعِيدًا زَلَقًا ", "translation": "It may be that my Lord will give me [something] better than your garden and will send upon it a [disastrous] penalty from the sky, and it will become a smooth, dusty ground,", "words": [{"id": 1, "arabic": "فَعَسَىٰ", "translit": "ٰàَsَʿعَf", "root": "عسي"}, {"id": 2, "arabic": "رَبِّىٓ", "translit": "ٓàِّbَr", "root": "ربب"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "يُؤْتِيَنِ", "translit": "ِnَyِtْwʾُy", "root": "اتي"}, {"id": 5, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "جَنَّتِكَ", "translit": "َkِtَّnَjg", "root": "جنن"}, {"id": 8, "arabic": "وَيُرْسِلَ", "translit": "َlِsْrُyَw", "root": "رسل"}, {"id": 9, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "حُسْبَانًا", "translit": "āًnāَbْsُḥ", "root": "حسب"}, {"id": 11, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 12, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 13, "arabic": "فَتُصْبِحَ", "translit": "َḥِbْṣُtَf", "root": "صبح"}, {"id": 14, "arabic": "صَعِيدًا", "translit": "āًdyِʿعَṣ", "root": "صعد"}, {"id": 15, "arabic": "زَلَقًا", "translit": "āًqَlَz", "root": "زلق"}], "hasIhya": false}, {"ayah": 41, "text": "أَوْ يُصْبِحَ مَآؤُهَا غَوْرًا فَلَن تَسْتَطِيعَ لَهُۥ طَلَبًا ", "translation": "Or its water will become sunken [into the earth], so you would never be able to seek it.\"", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "يُصْبِحَ", "translit": "َḥِbْṣُy", "root": "صبح"}, {"id": 3, "arabic": "مَآؤُهَا", "translit": "āَhُwʾٓāَm", "root": "موه"}, {"id": 4, "arabic": "غَوْرًا", "translit": "āًrْwَغ", "root": "غور"}, {"id": 5, "arabic": "فَلَن", "translit": "nَlَf", "root": ""}, {"id": 6, "arabic": "تَسْتَطِيعَ", "translit": "َʿعyِṭَtْsَt", "root": "طوع"}, {"id": 7, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 8, "arabic": "طَلَبًا", "translit": "āًbَlَṭ", "root": "طلب"}], "hasIhya": true}, {"ayah": 42, "text": "وَأُحِيطَ بِثَمَرِهِۦ فَأَصْبَحَ يُقَلِّبُ كَفَّيْهِ عَلَىٰ مَآ أَنفَقَ فِيهَا وَهِىَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا وَيَقُولُ يَٰلَيْتَنِى لَمْ أُشْرِكْ بِرَبِّىٓ أَحَدًا ", "translation": "And his fruits were encompassed [by ruin], so he began to turn his hands about [in dismay] over what he had spent on it, while it had collapsed upon its trellises, and said, \"Oh, I wish I had not associated with my Lord anyone.\"[1]", "words": [{"id": 1, "arabic": "وَأُحِيطَ", "translit": "َṭyِḥُaʾَw", "root": "حوط"}, {"id": 2, "arabic": "بِثَمَرِهِۦ", "translit": "ۦِhِrَmَhtِb", "root": "ثمر"}, {"id": 3, "arabic": "فَأَصْبَحَ", "translit": "َḥَbْṣَaʾَf", "root": "صبح"}, {"id": 4, "arabic": "يُقَلِّبُ", "translit": "ُbِّlَqُy", "root": "قلب"}, {"id": 5, "arabic": "كَفَّيْهِ", "translit": "ِhْyَّfَk", "root": "كفف"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 8, "arabic": "أَنفَقَ", "translit": "َqَfnَaʾ", "root": "نفق"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 11, "arabic": "خَاوِيَةٌ", "translit": "ٌẗَyِwāَhk", "root": "خوي"}, {"id": 12, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 13, "arabic": "عُرُوشِهَا", "translit": "āَhِhswُrُʿع", "root": "عرش"}, {"id": 14, "arabic": "وَيَقُولُ", "translit": "ُlwُqَyَw", "root": "قول"}, {"id": 15, "arabic": "يَٰلَيْتَنِى", "translit": "àِnَtْyَlَٰy", "root": ""}, {"id": 16, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 17, "arabic": "أُشْرِكْ", "translit": "ْkِrْhsُaʾ", "root": "شرك"}, {"id": 18, "arabic": "بِرَبِّىٓ", "translit": "ٓàِّbَrِb", "root": "ربب"}, {"id": 19, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}], "hasIhya": true}, {"ayah": 43, "text": "وَلَمْ تَكُن لَّهُۥ فِئَةٌ يَنصُرُونَهُۥ مِن دُونِ ٱللَّهِ وَمَا كَانَ مُنتَصِرًا ", "translation": "And there was for him no company to aid him other than Allāh, nor could he defend himself.", "words": [{"id": 1, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 2, "arabic": "تَكُن", "translit": "nُkَt", "root": "كون"}, {"id": 3, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 4, "arabic": "فِئَةٌ", "translit": "ٌẗَyʾِf", "root": "فاي"}, {"id": 5, "arabic": "يَنصُرُونَهُۥ", "translit": "ۥُhَnwُrُṣnَy", "root": "نصر"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 11, "arabic": "مُنتَصِرًا", "translit": "āًrِṣَtnُm", "root": "نصر"}], "hasIhya": false}, {"ayah": 44, "text": "هُنَالِكَ ٱلْوَلَٰيَةُ لِلَّهِ ٱلْحَقِّۚ هُوَ خَيْرٌ ثَوَابًا وَخَيْرٌ عُقْبًا ", "translation": "There[1] the authority is [completely] for Allāh, the Truth. He is best in reward and best in outcome.", "words": [{"id": 1, "arabic": "هُنَالِكَ", "translit": "َkِlāَnُh", "root": ""}, {"id": 2, "arabic": "ٱلْوَلَٰيَةُ", "translit": "ُẗَyَٰlَwْlٱ", "root": "ولي"}, {"id": 3, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 4, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 7, "arabic": "ثَوَابًا", "translit": "āًbāَwَht", "root": "ثوب"}, {"id": 8, "arabic": "وَخَيْرٌ", "translit": "ٌrْyَhkَw", "root": "خير"}, {"id": 9, "arabic": "عُقْبًا", "translit": "āًbْqُʿع", "root": "عقب"}], "hasIhya": false}, {"ayah": 45, "text": "وَٱضْرِبْ لَهُم مَّثَلَ ٱلْحَيَوٰةِ ٱلدُّنْيَا كَمَآءٍ أَنزَلْنَٰهُ مِنَ ٱلسَّمَآءِ فَٱخْتَلَطَ بِهِۦ نَبَاتُ ٱلْأَرْضِ فَأَصْبَحَ هَشِيمًا تَذْرُوهُ ٱلرِّيَٰحُۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ مُّقْتَدِرًا ", "translation": "And present to them the example of the life of this world, [its being] like rain which We send down from the sky, and the vegetation of the earth mingles with it[1] and [then] it becomes dry remnants, scattered by the winds. And Allāh is ever, over all things, Perfect in Ability.", "words": [{"id": 1, "arabic": "وَٱضْرِبْ", "translit": "ْbِrْḍٱَw", "root": "ضرب"}, {"id": 2, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 3, "arabic": "مَّثَ