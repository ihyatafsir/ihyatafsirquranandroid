َنَحْنُ نَتَرَبَّصُ بِكُمُۥٓ أَنْ يُّصِيبَكُمُ اُ۬للَّهُ بِعَذَابࣲ مِّنْ عِندِهِۦٓ أَوْ بِأَيْدِينَاۖ فَتَرَبَّصُوٓاْۖ إِنَّا مَعَكُم مُّتَرَبِّصُونَۖ", "words": [{"id": 1, "arabic": "قُلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "هَلْ", "translit": "", "root": ""}, {"id": 3, "arabic": "تَرَبَّصُونَ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِنَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِحْدَي", "translit": "", "root": ""}, {"id": 7, "arabic": "اَ۬لْحُسْنَيَيْنِۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَنَحْنُ", "translit": "", "root": ""}, {"id": 9, "arabic": "نَتَرَبَّصُ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِكُمُۥٓ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 12, "arabic": "يُّصِيبَكُمُ", "translit": "", "root": ""}, {"id": 13, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 14, "arabic": "بِعَذَابࣲ", "translit": "", "root": ""}, {"id": 15, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 16, "arabic": "عِندِهِۦٓ", "translit": "", "root": ""}, {"id": 17, "arabic": "أَوْ", "translit": "", "root": ""}, {"id": 18, "arabic": "بِأَيْدِينَاۖ", "translit": "", "root": ""}, {"id": 19, "arabic": "فَتَرَبَّصُوٓاْۖ", "translit": "", "root": ""}, {"id": 20, "arabic": "إِنَّا", "translit": "", "root": ""}, {"id": 21, "arabic": "مَعَكُم", "translit": "", "root": ""}, {"id": 22, "arabic": "مُّتَرَبِّصُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 53, "text": "قُلَ اَنفِقُواْ طَوْعاً اَوْ كَرْهاࣰ لَّنْ يُّتَقَبَّلَ مِنكُمُۥٓۖ إِنَّكُمْ كُنتُمْ قَوْماࣰ فَٰسِقِينَۖ", "words": [{"id": 1, "arabic": "قُلَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَنفِقُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "طَوْعاً", "translit": "", "root": ""}, {"id": 4, "arabic": "اَوْ", "translit": "", "root": ""}, {"id": 5, "arabic": "كَرْهاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "لَّنْ", "translit": "", "root": ""}, {"id": 7, "arabic": "يُّتَقَبَّلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "مِنكُمُۥٓۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّكُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَٰسِقِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 54, "text": "وَمَا مَنَعَهُمُۥٓ أَن تُقْبَلَ مِنْهُمْ نَفَقَٰتُهُمُۥٓ إِلَّآ أَنَّهُمْ كَفَرُواْ بِاللَّهِ وَبِرَسُولِهِۦ وَلَا يَاتُونَ اَ۬لصَّلَوٰةَ إِلَّا وَهُمْ كُسَال۪يٰ وَلَا يُنفِقُونَ إِلَّا وَهُمْ كَٰرِهُونَۖ", "words": [{"id": 1, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "مَنَعَهُمُۥٓ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَن", "translit": "", "root": ""}, {"id": 4, "arabic": "تُقْبَلَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِنْهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "نَفَقَٰتُهُمُۥٓ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِلَّآ", "translit": "", "root": ""}, {"id": 8, "arabic": "أَنَّهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَبِرَسُولِهِۦ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 13, "arabic": "يَاتُونَ", "translit": "", "root": ""}, {"id": 14, "arabic": "اَ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 15, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 16, "arabic": "وَهُمْ", "translit": "", "root": ""}, {"id": 17, "arabic": "كُسَال۪يٰ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 19, "arabic": "يُنفِقُونَ", "translit": "", "root": ""}, {"id": 20, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 21, "arabic":