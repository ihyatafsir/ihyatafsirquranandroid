": 12, "arabic": "بِأَفْوَٰهِهِمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "وَتَاب۪يٰ", "translit": "", "root": ""}, {"id": 14, "arabic": "قُلُوبُهُمْ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَأَكْثَرُهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "فَٰسِقُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 9, "text": "اَ۪شْتَرَوْاْ بِـَٔايَٰتِ اِ۬للَّهِ ثَمَناࣰ قَلِيلاࣰ فَصَدُّواْ عَن سَبِيلِهِۦٓۖ إِنَّهُمْ سَآءَ مَا كَانُواْ يَعْمَلُونَۖ", "words": [{"id": 1, "arabic": "اَ۪شْتَرَوْاْ", "translit": "", "root": ""}, {"id": 2, "arabic": "بِـَٔايَٰتِ", "translit": "", "root": ""}, {"id": 3, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 4, "arabic": "ثَمَناࣰ", "translit": "", "root": ""}, {"id": 5, "arabic": "قَلِيلاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَصَدُّواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَن", "translit": "", "root": ""}, {"id": 8, "arabic": "سَبِيلِهِۦٓۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "سَآءَ", "translit": "", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "", "root": ""}, {"id": 12, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 10, "text": "لَا يَرْقُبُونَ فِے مُومِنٍ اِلّاࣰ وَلَا ذِمَّةࣰۖ وَأُوْلَٰٓئِكَ هُمُ اُ۬لْمُعْتَدُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرْقُبُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مُومِنٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلّاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "ذِمَّةࣰۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "هُمُ", "t