ا", "translit": "", "root": ""}, {"id": 12, "arabic": "كَانُواْ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَعْمَلُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 10, "text": "لَا يَرْقُبُونَ فِے مُومِنٍ اِلّاࣰ وَلَا ذِمَّةࣰۖ وَأُوْلَٰٓئِكَ هُمُ اُ۬لْمُعْتَدُونَۖ", "words": [{"id": 1, "arabic": "لَا", "translit": "", "root": ""}, {"id": 2, "arabic": "يَرْقُبُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِے", "translit": "", "root": ""}, {"id": 4, "arabic": "مُومِنٍ", "translit": "", "root": ""}, {"id": 5, "arabic": "اِلّاࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 7, "arabic": "ذِمَّةࣰۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَأُوْلَٰٓئِكَ", "translit": "", "root": ""}, {"id": 9, "arabic": "هُمُ", "translit": "", "root": ""}, {"id": 10, "arabic": "اُ۬لْمُعْتَدُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 11, "text": "فَإِن تَابُواْ وَأَقَامُواْ اُ۬لصَّلَوٰةَ وَءَاتَوُاْ اُ۬لزَّكَوٰةَ فَإِخْوَٰنُكُمْ فِے اِ۬لدِّينِۖ وَنُفَصِّلُ اُ۬لَايَٰتِ لِقَوْمࣲ يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "فَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "تَابُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "وَأَقَامُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَءَاتَوُاْ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لزَّكَوٰةَ", "translit": "", "root": ""}, {"id": 7, "arabic": "فَإِخْوَٰنُكُمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "اِ۬لدِّينِۖ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَنُفَصِّلُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لَايَٰتِ", "translit": "", "root": ""}, {"id": 12, "arabic": "لِقَوْمࣲ", "translit": "", "root": ""}, {"id": 13, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 12, "text": "۞وَإِن نَّكَثُوٓاْ أَيْمَٰنَهُم مِّنۢ بَعْدِ عَهْدِهِمْ وَطَعَنُواْ فِے دِينِكُمْ فَقَٰتِلُوٓاْ أَي۪مَّةَ اَ۬لْكُفْرِۖ إِنَّهُمْ لَآ أَيْمَٰنَ لَهُمْ لَعَلَّهُمْ يَنتَهُونَۖ", "words": [{"id": 1, "arabic": "۞وَإِن", "translit": "", "root": ""}, {"id": 2, "arabic": "نَّكَثُوٓاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "أَيْمَٰنَهُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنۢ", "translit": "", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَهْدِهِمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَطَعَنُواْ", "translit": "", "root": ""}, {"id": 8, "arabic": "فِے", "translit": "", "root": ""}, {"id": 9, "arabic": "دِينِكُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَقَٰتِلُوٓاْ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَي۪مَّةَ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لْكُفْرِۖ", "translit": "", "root": ""}, {"id": 13, "arabic": "إِنَّهُمْ", "translit": "", "root": ""}, {"id": 14, "arabic": "لَآ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَيْمَٰنَ", "translit": "", "root": ""}, {"id": 16, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 17, "arabic": "لَعَلَّهُمْ", "translit": "", "root": ""}, {"id": 18, "arabic": "يَنتَهُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 13, "text": "أَلَا تُقَٰتِلُونَ قَوْماࣰ نَّكَثُوٓاْ أَيْمَٰنَهُمْ وَهَمُّواْ بِإِخْرَاجِ اِ۬لرَّسُولِ وَهُم بَدَءُوكُمُۥٓ أَوَّلَ مَرَّةٍ اَتَخْشَوْنَهُمْۖ فَاللَّهُ أَحَقُّ أَن تَخْشَوْهُ إِن كُنتُم مُّومِنِينَۖ", "words": [{"id": 1, "arabic": "أَلَا", "translit": "", "root": ""}, {"id": 2, "arabic": "تُقَٰتِلُونَ", "translit": "", "root": ""}, {"id": 3, "arabic": "قَوْماࣰ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَّكَثُوٓاْ", "translit": "", "root": ""}, {"id": 5, "arabic": "أَيْمَٰنَهُمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَهَمُّواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "بِإِخْرَاجِ", "translit": "", "root": ""}, {"id": 8, "arabic": "اِ۬لرَّسُولِ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَهُم", "translit": "", "root": ""}, {"id": 10, "arabic": "بَدَءُوكُمُۥٓ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَوَّلَ", "translit": "", "root": ""}, {"id": 12, "arabic": "مَرَّةٍ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَتَخْشَوْنَهُمْۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "فَاللَّهُ", "translit": "", "root": ""}, {"id": 15, "arabic": "أَحَقُّ", "translit": "", "root": ""}, {"id": 16, "arabic": "أَن", "translit": "", "root": ""}, {"id": 17, "arabic": "تَخْشَوْهُ", "translit": "", "root": ""}, {"id": 18, "arabic": "إِن", "translit": "", "root": ""}, {"id": 19, "arabic": "كُنتُم", "translit": "", "root": ""}, {"id": 20, "arabic": "مُّومِنِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 14, "text": "قَٰتِلُوهُمْ يُعَذِّبْهُمُ اُ۬للَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ وَيَنصُرْكُمْ عَلَيْهِمْ وَيَشْفِ صُدُورَ قَوْمࣲ مُّومِنِينَ", "words": [{"id": 1, "arabic": "قَٰتِلُوهُمْ", "translit": "", "root": ""}, {"id": 2, "arabic": "يُعَذِّبْهُمُ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "بِأَيْدِيكُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَيُخْزِهِمْ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَنصُرْكُمْ", "translit": "", "root": ""}, {"id": 7, "arabic": "عَلَيْهِمْ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَيَشْفِ", "translit": "", "root": ""}, {"id": 9, "arabic": "صُدُورَ", "translit": "", "root": ""}, {"id": 10, "arabic": "قَوْمࣲ", "translit": "", "root": ""}, {"id": 11, "arabic": "مُّومِنِينَ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 15, "text": "وَيُذْهِبْ غَيْظَ قُلُوبِهِمْۖ وَيَتُوبُ اُ۬للَّهُ عَلَيٰ مَنْ يَّشَآءُۖ وَاللَّهُ عَلِيمٌ حَكِيمٌۖ", "words": [{"id": 1, "arabic": "وَيُذْهِبْ", "translit