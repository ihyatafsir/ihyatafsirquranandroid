, "text": "يَٰٓأَيُّهَا اَ۬لذِينَ ءَامَنُواْ مَا لَكُمُۥٓ إِذَا قِيلَ لَكُمُ اُ۪نفِرُواْ فِے سَبِيلِ اِ۬للَّهِ اِ۪ثَّاقَلْتُمُۥٓ إِلَي اَ۬لَارْضِۖ أَرَضِيتُم بِالْحَيَوٰةِ اِ۬لدُّنْي۪ا مِنَ اَ۬لَاخِرَةِۖ فَمَا مَتَٰعُ اُ۬لْحَيَوٰةِ اِ۬لدُّنْي۪ا فِے اِ۬لَاخِرَةِ إِلَّا قَلِيلٌۖ", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 3, "arabic": "ءَامَنُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَا", "translit": "", "root": ""}, {"id": 5, "arabic": "لَكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِذَا", "translit": "", "root": ""}, {"id": 7, "arabic": "قِيلَ", "translit": "", "root": ""}, {"id": 8, "arabic": "لَكُمُ", "translit": "", "root": ""}, {"id": 9, "arabic": "اُ۪نفِرُواْ", "translit": "", "root": ""}, {"id": 10, "arabic": "فِے", "translit": "", "root": ""}, {"id": 11, "arabic": "سَبِيلِ", "translit": "", "root": ""}, {"id": 12, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 13, "arabic": "اِ۪ثَّاقَلْتُمُۥٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 15, "arabic": "اَ۬لَارْضِۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "أَرَضِيتُم", "translit": "", "root": ""}, {"id": 17, "arabic": "بِالْحَيَوٰةِ", "translit": "", "root": ""}, {"id": 18, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 19, "arabic": "مِنَ", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لَاخِرَةِۖ", "translit": "", "root": ""}, {"id": 21, "arabic": "فَمَا", "translit": "", "root": ""}, {"id": 22, "arabic": "مَتَٰعُ", "translit": "", "root": ""}, {"id": 23, "arabic": "اُ۬لْحَيَوٰةِ", "translit": "", "root": ""}, {"id": 24, "arabic": "اِ۬لدُّنْي۪ا", "translit": "", "root": ""}, {"id": 25, "arabic": "فِے", "translit": "", "root": ""}, {"id": 26, "arabic": "اِ۬لَاخِرَةِ", "translit": "", "root": ""}, {"id": 27, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 28, "arabic": "قَلِيلٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 39, "text": "اِلَّا تَنفِرُواْ يُعَذِّبْكُمْ عَذَاباً اَلِيماࣰ وَيَسْتَبْدِلْ قَوْماً غَيْرَكُمْ وَلَا تَضُرُّوهُ شَئْاࣰۖ وَاللَّهُ عَلَيٰ كُلِّ شَےْءࣲ قَدِيرٌۖ", "words": [{"id": 1, "arabic": "اِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَنفِرُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يُعَذِّبْكُمْ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَذَاباً", "translit": "", "root": ""}, {"id": 5, "arabic": "اَلِيماࣰ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَيَسْتَبْدِلْ", "translit": "", "root": ""}, {"id": 7, "arabic": "قَوْماً", "translit": "", "root": ""}, {"id": 8, "arabic": "غَيْرَكُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَلَا", "translit": "", "root": ""}, {"id": 10, "arabic": "تَضُرُّوهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "شَئْاࣰۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 14, "arabic": "كُلِّ", "translit": "", "root": ""}, {"id": 15, "arabic": "شَےْءࣲ", "translit": "", "root": ""}, {"id": 16, "arabic": "قَدِيرٌۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 40, "text": "۞اِلَّا تَنصُرُوهُ فَقَدْ نَصَرَهُ اُ۬للَّهُ إِذَ اَخْرَجَهُ اُ۬لذِينَ كَفَرُواْ ثَانِيَ اَ۪ثْنَيْنِ إِذْ هُمَا فِے اِ۬لْغ۪ارِ إِذْ يَقُولُ لِصَٰحِبِهِۦ لَا تَحْزَنِ اِنَّ اَ۬للَّهَ مَعَنَاۖ فَأَنزَلَ اَ۬للَّهُ سَكِينَتَهُۥ عَلَيْهِۖ وَأَيَّدَهُۥ بِجُنُودࣲ لَّمْ تَرَوْهَاۖ وَجَعَلَ كَلِمَةَ اَ۬لذِينَ كَفَرُواْ اُ۬لسُّفْل۪يٰۖ وَكَلِمَةُ اُ۬للَّهِ هِيَ اَ۬لْعُلْي۪اۖ وَاللَّهُ عَزِيزٌ حَكِيمٌۖ", "words": [{"id": 1, "arabic": "۞اِلَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "تَنصُرُوهُ", "translit": "", "root": ""}, {"id": 3, "arabic": "فَقَدْ", "translit": "", "root": ""}, {"id": 4, "arabic": "نَصَرَهُ", "translit": "", "root": ""}, {"id": 5, "arabic": "اُ۬للَّهُ", "trans