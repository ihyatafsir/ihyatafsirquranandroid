0, "text": "إِنَّمَا اَ۬لصَّدَقَٰتُ لِلْفُقَرَآءِ وَالْمَسَٰكِينِ وَالْعَٰمِلِينَ عَلَيْهَا وَالْمُوَ۬لَّفَةِ قُلُوبُهُمْ وَفِے اِ۬لرِّقَابِ وَالْغَٰرِمِينَ وَفِے سَبِيلِ اِ۬للَّهِ وَابْنِ اِ۬لسَّبِيلِ فَرِيضَةࣰ مِّنَ اَ۬للَّهِۖ وَاللَّهُ عَلِيمٌ حَكِيمࣱۖ", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لصَّدَقَٰتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْفُقَرَآءِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالْمَسَٰكِينِ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَالْعَٰمِلِينَ", "translit": "", "root": ""}, {"id": 6, "arabic": "عَلَيْهَا", "translit": "", "root": ""}, {"id": 7, "arabic": "وَالْمُوَ۬لَّفَةِ", "translit": "", "root": ""}, {"id": 8, "arabic": "قُلُوبُهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَفِے", "translit": "", "root": ""}, {"id": 10, "arabic": "اِ۬لرِّقَابِ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَالْغَٰرِمِينَ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَفِے", "translit": "", "root": ""}, {"id": 13, "arabic": "سَبِيلِ", "translit": "", "root": ""}, {"id": 14, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَابْنِ", "translit": "", "root": ""}, {"id": 16, "arabic": "اِ۬لسَّبِيلِ", "translit": "", "root": ""}, {"id": 17, "arabic": "فَرِيضَةࣰ", "translit": "", "root": ""}, {"id": 18, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 20, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 21, "arabic": "عَلِيمٌ", "translit": "", "root": ""}, {"id": 22, "arabic": "حَكِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 61, "text": "۞وَمِنْهُمُ اُ۬لذِينَ يُوذُونَ اَ۬لنَّبِےٓءَ وَيَقُولُونَ هُوَ أُذْنࣱۖ قُلُ ا۟ذْنُ خَيْرࣲ لَّكُمْ يُومِنُ بِاللَّهِ وَيُومِنُ لِلْمُومِنِينَ وَرَحْمَةࣱ لِّلذِينَ ءَامَنُواْ مِنكُمْۖ وَالذِينَ يُوذُونَ رَسُولَ اَ۬للَّهِ لَهُمْ عَذَابٌ اَلِيمࣱۖ", "words": [{"id": 1, "ar