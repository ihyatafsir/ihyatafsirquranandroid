": "۞فَإِذَا اَ۪نسَلَخَ اَ۬لَاشْهُرُ اُ۬لْحُرُمُ فَاقْتُلُواْ اُ۬لْمُشْرِكِينَ حَيْثُ وَجَدتُّمُوهُمْ وَخُذُوهُمْ وَاحْصُرُوهُمْ وَاقْعُدُواْ لَهُمْ كُلَّ مَرْصَدࣲۖ فَإِن تَابُواْ وَأَقَامُواْ اُ۬لصَّلَوٰةَ وَءَاتَوُاْ اُ۬لزَّكَوٰةَ فَخَلُّواْ سَبِيلَهُمُۥٓۖ إِنَّ اَ۬للَّهَ غَفُورࣱ رَّحِيمࣱۖ", "words": [{"id": 1, "arabic": "۞فَإِذَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۪نسَلَخَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬لَاشْهُرُ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لْحُرُمُ", "translit": "", "root": ""}, {"id": 5, "arabic": "فَاقْتُلُواْ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬لْمُشْرِكِينَ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَيْثُ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَجَدتُّمُوهُمْ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَخُذُوهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "وَاحْصُرُوهُمْ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَاقْعُدُواْ", "translit": "", "root": ""}, {"id": 12, "arabic": "لَهُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "كُلَّ", "translit": "", "root": ""}, {"id": 14, "arabic": "مَرْصَدࣲۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "فَإِن", "translit": "", "root": ""}, {"id": 16, "arabic": "تَابُواْ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَأَقَامُواْ", "translit": "", "root": ""}, {"id": 18, "arabic": "اُ۬لصَّلَوٰةَ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَءَاتَوُاْ", "translit": "", "root": ""}, {"id": 20, "arabic": "اُ۬لزَّكَوٰةَ", "translit": "", "root": ""}, {"id": 21, "arabic": "فَخَلُّواْ", "translit": "", "root": ""}, {"id": 22, "arabic": "سَبِيلَهُمُۥٓۖ", "translit": "", "root": ""}, {"id": 23, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 24, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 25, "arabic": "غَفُورࣱ", "translit": "", "root": ""}, {"id": 26, "arabic": "رَّحِيمࣱۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 6, "text": "وَإِنَ اَحَدࣱ مِّنَ اَ۬لْمُشْرِكِينَ اَ۪سْتَجَارَكَ فَأَجِرْهُ حَتَّيٰ يَسْمَعَ كَلَٰمَ اَ۬للَّهِ ثُمَّ أَبْلِغْهُ مَامَنَهُۥۖ ذَٰلِكَ بِأَنَّهُمْ قَوْمࣱ لَّا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَإِنَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَحَدࣱ", "translit": "", "root": ""}, {"id": 3, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 4, "arabic": "اَ۬لْمُشْرِكِينَ", "translit": "", "root": ""}, {"id": 5, "arabic": "اَ۪سْتَجَارَكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "فَأَجِرْهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "حَتَّيٰ", "translit": "", "root": ""}, {"id": 8, "arabic": "يَسْمَعَ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَلَٰمَ", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 11, "arabic": "ثُمَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "أَبْلِغْهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "مَامَنَهُۥۖ", "translit": "", "root": ""}, {"id": 14, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 15, "arabic": "بِأَنَّهُمْ", "translit": "", "root": ""}, {"id": 16, "arabic": "قَوْمࣱ", "translit": "", "root": ""}, {"id": 17, "arabic": "لَّا", "translit": "", "root": ""}, {"id": 18, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 7, "text": "كَيْفَ يَكُونُ لِلْمُشْرِكِينَ عَهْدٌ عِندَ اَ۬للَّهِ وَعِندَ رَسُولِهِۦٓ إِلَّا اَ۬لذِينَ عَٰهَدتُّمْ عِندَ اَ۬لْمَسْجِدِ اِ۬لْحَرَامِ فَمَا اَ۪سْتَقَٰمُواْ لَكُمْ فَاسْتَقِيمُواْ لَهُمُۥٓۖ إِنَّ اَ۬للَّهَ يُحِبُّ اُ۬لْمُتَّقِينَۖ", "words": [{"id": 1, "arabic": "كَيْفَ", "translit": "", "root": ""}, {"id": 2, "arabic": "يَكُونُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْمُشْرِكِينَ", "translit": "", "root": ""}, {"id": 4, "arabic": "عَهْدٌ", "translit": "", "root": ""}, {"id": 5, "arabic": "عِندَ", "translit": "", "root": ""}, {"id": 6, "arabic": "اَ۬للَّهِ", "translit": "", "root":