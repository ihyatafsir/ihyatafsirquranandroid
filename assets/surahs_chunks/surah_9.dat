{"surah": 9, "verses": [{"ayah": 1, "text": "بَرَآءَةٌ مِّنَ ٱللَّهِ وَرَسُولِهِۦٓ إِلَى ٱلَّذِينَ عَٰهَدتُّم مِّنَ ٱلْمُشْرِكِينَ ", "translation": "[This is a declaration of] disassociation, from Allāh and His Messenger, to those with whom you had made a treaty among the polytheists.[1]", "words": [{"id": 1, "arabic": "بَرَآءَةٌ", "translit": "ٌẗَءٓāَrَb", "root": "برا"}, {"id": 2, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَرَسُولِهِۦٓ", "translit": "ٓۦِhِlwُsَrَw", "root": "رسل"}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "عَٰهَدتُّم", "translit": "mُّtdَhَٰʿع", "root": "عهد"}, {"id": 8, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 9, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": false}, {"ayah": 2, "text": "فَسِيحُوا۟ فِى ٱلْأَرْضِ أَرْبَعَةَ أَشْهُرٍ وَٱعْلَمُوٓا۟ أَنَّكُمْ غَيْرُ مُعْجِزِى ٱللَّهِۙ وَأَنَّ ٱللَّهَ مُخْزِى ٱلْكَٰفِرِينَ ", "translation": "So travel freely, [O disbelievers], throughout the land [during] four months but know that you cannot cause failure to Allāh and that Allāh will disgrace the disbelievers.", "words": [{"id": 1, "arabic": "فَسِيحُوا۟", "translit": "۟āwُḥyِsَf", "root": "سيح"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 4, "arabic": "أَرْبَعَةَ", "translit": "َẗَʿعَbْrَaʾ", "root": "ربع"}, {"id": 5, "arabic": "أَشْهُرٍ", "translit": "ٍrُhْhsَaʾ", "root": "شهر"}, {"id": 6, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 7, "arabic": "أَنَّكُمْ", "translit": "ْmُkَّnَaʾ", "root": ""}, {"id": 8, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 9, "arabic": "مُعْجِزِى", "translit": "àِzِjgْʿعُm", "root": "عجز"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "مُخْزِى", "translit": "àِzْhkُm", "root": "خزي"}, {"id": 14, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 3, "text": "وَأَذَٰنٌ مِّنَ ٱللَّهِ وَرَسُولِهِۦٓ إِلَى ٱلنَّاسِ يَوْمَ ٱلْحَجِّ ٱلْأَكْبَرِ أَنَّ ٱللَّهَ بَرِىٓءٌ مِّنَ ٱلْمُشْرِكِينَۙ وَرَسُولُهُۥۚ فَإِن تُبْتُمْ فَهُوَ خَيْرٌ لَّكُمْۖ وَإِن تَوَلَّيْتُمْ فَٱعْلَمُوٓا۟ أَنَّكُمْ غَيْرُ مُعْجِزِى ٱللَّهِۗ وَبَشِّرِ ٱلَّذِينَ كَفَرُوا۟ بِعَذَابٍ أَلِيمٍ ", "translation": "And [it is] an announcement from Allāh and His Messenger to the people on the day of the greater pilgrimage[1] that Allāh is disassociated from the disbelievers, and [so is] His Messenger. So if you repent, that is best for you; but if you turn away - then know that you will not cause failure to Allāh.[2] And give tidings to those who disbelieve of a painful punishment.", "words": [{"id": 1, "arabic": "وَأَذَٰنٌ", "translit": "ٌnَٰhdَaʾَw", "root": "اذن"}, {"id": 2, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَرَسُولِهِۦٓ", "translit": "ٓۦِhِlwُsَrَw", "root": "رسل"}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 8, "arabic": "ٱلْحَجِّ", "translit": "ِّjgَḥْlٱ", "root": "حجج"}, {"id": 9, "arabic": "ٱلْأَكْبَرِ", "translit": "ِrَbْkَaʾْlٱ", "root": "كبر"}, {"id": 10, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "بَرِىٓءٌ", "translit": "ٌءٓàِrَb", "root": "برا"}, {"id": 13, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 14, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}, {"id": 15, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 16, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 17, "arabic": "تُبْتُمْ", "translit": "ْmُtْbُt", "root": "توب"}, {"id": 18, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 19, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 20, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 21, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 22, "arabic": "تَوَلَّيْتُمْ", "translit": "ْmُtْyَّlَwَt", "root": "ولي"}, {"id": 23, "arabic": "فَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَf", "root": "علم"}, {"id": 24, "arabic": "أَنَّكُمْ", "translit": "ْmُkَّnَaʾ", "root": ""}, {"id": 25, "arabic": "غَيْرُ", "translit": "ُrْyَغ", "root": "غير"}, {"id": 26, "arabic": "مُعْجِزِى", "translit": "àِzِjgْʿعُm", "root": "عجز"}, {"id": 27, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 29, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 30, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 31, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 32, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 4, "text": "إِلَّا ٱلَّذِينَ عَٰهَدتُّم مِّنَ ٱلْمُشْرِكِينَ ثُمَّ لَمْ يَنقُصُوكُمْ شَيْـًٔا وَلَمْ يُظَٰهِرُوا۟ عَلَيْكُمْ أَحَدًا فَأَتِمُّوٓا۟ إِلَيْهِمْ عَهْدَهُمْ إِلَىٰ مُدَّتِهِمْۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُتَّقِينَ ", "translation": "Excepted are those with whom you made a treaty among the polytheists and then they have not been deficient toward you in anything or supported anyone against you; so complete for them their treaty until their term [has ended]. Indeed, Allāh loves the righteous [who fear Him].", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "عَٰهَدتُّم", "translit": "mُّtdَhَٰʿع", "root": "عهد"}, {"id": 4, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 5, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 8, "arabic": "يَنقُصُوكُمْ", "translit": "ْmُkwُṣُqnَy", "root": "نقص"}, {"id": 9, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 10, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 11, "arabic": "يُظَٰهِرُوا۟", "translit": "۟āwُrِhَٰẓُy", "root": "ظهر"}, {"id": 12, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 13, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}, {"id": 14, "arabic": "فَأَتِمُّوٓا۟", "translit": "۟āٓwُّmِtَaʾَf", "root": "تمم"}, {"id": 15, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 16, "arabic": "عَهْدَهُمْ", "translit": "ْmُhَdْhَʿع", "root": "عهد"}, {"id": 17, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 18, "arabic": "مُدَّتِهِمْ", "translit": "ْmِhِtَّdُm", "root": "مدد"}, {"id": 19, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 22, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 5, "text": "فَإِذَا ٱنسَلَخَ ٱلْأَشْهُرُ ٱلْحُرُمُ فَٱقْتُلُوا۟ ٱلْمُشْرِكِينَ حَيْثُ وَجَدتُّمُوهُمْ وَخُذُوهُمْ وَٱحْصُرُوهُمْ وَٱقْعُدُوا۟ لَهُمْ كُلَّ مَرْصَدٍۚ فَإِن تَابُوا۟ وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟ ٱلزَّكَوٰةَ فَخَلُّوا۟ سَبِيلَهُمْۚ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "And when the inviolable months[1] have passed, then kill the polytheists wherever you find them and capture them and besiege them and sit in wait for them at every place of ambush. But if they should repent, establish prayer, and give zakāh, let them [go] on their way. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "ٱنسَلَخَ", "translit": "َhkَlَsnٱ", "root": "سلخ"}, {"id": 3, "arabic": "ٱلْأَشْهُرُ", "translit": "ُrُhْhsَaʾْlٱ", "root": "شهر"}, {"id": 4, "arabic": "ٱلْحُرُمُ", "translit": "ُmُrُḥْlٱ", "root": "حرم"}, {"id": 5, "arabic": "فَٱقْتُلُوا۟", "translit": "۟āwُlُtْqٱَf", "root": "قتل"}, {"id": 6, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}, {"id": 7, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 8, "arabic": "وَجَدتُّمُوهُمْ", "translit": "ْmُhwُmُّtdَjgَw", "root": "وجد"}, {"id": 9, "arabic": "وَخُذُوهُمْ", "translit": "ْmُhwُhdُhkَw", "root": "اخذ"}, {"id": 10, "arabic": "وَٱحْصُرُوهُمْ", "translit": "ْmُhwُrُṣْḥٱَw", "root": "حصر"}, {"id": 11, "arabic": "وَٱقْعُدُوا۟", "translit": "۟āwُdُʿعْqٱَw", "root": "قعد"}, {"id": 12, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 13, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 14, "arabic": "مَرْصَدٍ", "translit": "ٍdَṣْrَm", "root": "رصد"}, {"id": 15, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 16, "arabic": "تَابُوا۟", "translit": "۟āwُbāَt", "root": "توب"}, {"id": 17, "arabic": "وَأَقَامُوا۟", "translit": "۟āwُmāَqَaʾَw", "root": "قوم"}, {"id": 18, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 19, "arabic": "وَءَاتَوُا۟", "translit": "۟āُwَtāَءَw", "root": "اتي"}, {"id": 20, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 21, "arabic": "فَخَلُّوا۟", "translit": "۟āwُّlَhkَf", "root": "خلو"}, {"id": 22, "arabic": "سَبِيلَهُمْ", "translit": "ْmُhَlyِbَs", "root": "سبل"}, {"id": 23, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 24, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 26, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 6, "text": "وَإِنْ أَحَدٌ مِّنَ ٱلْمُشْرِكِينَ ٱسْتَجَارَكَ فَأَجِرْهُ حَتَّىٰ يَسْمَعَ كَلَٰمَ ٱللَّهِ ثُمَّ أَبْلِغْهُ مَأْمَنَهُۥۚ ذَٰلِكَ بِأَنَّهُمْ قَوْمٌ لَّا يَعْلَمُونَ ", "translation": "And if any one of the polytheists seeks your protection, then grant him protection so that he may hear the words of Allāh [i.e., the Qur’ān]. Then deliver him to his place of safety. That is because they are a people who do not know.", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 2, "arabic": "أَحَدٌ", "translit": "ٌdَḥَaʾ", "root": "احد"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}, {"id": 5, "arabic": "ٱسْتَجَارَكَ", "translit": "َkَrāَjgَtْsٱ", "root": "جور"}, {"id": 6, "arabic": "فَأَجِرْهُ", "translit": "ُhْrِjgَaʾَf", "root": "جور"}, {"id": 7, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 8, "arabic": "يَسْمَعَ", "translit": "َʿعَmْsَy", "root": "سمع"}, {"id": 9, "arabic": "كَلَٰمَ", "translit": "َmَٰlَk", "root": "كلم"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "أَبْلِغْهُ", "translit": "ُhْغِlْbَaʾ", "root": "بلغ"}, {"id": 13, "arabic": "مَأْمَنَهُۥ", "translit": "ۥُhَnَmْaʾَm", "root": "امن"}, {"id": 14, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 15, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 16, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 17, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 18, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 7, "text": "كَيْفَ يَكُونُ لِلْمُشْرِكِينَ عَهْدٌ عِندَ ٱللَّهِ وَعِندَ رَسُولِهِۦٓ إِلَّا ٱلَّذِينَ عَٰهَدتُّمْ عِندَ ٱلْمَسْجِدِ ٱلْحَرَامِۖ فَمَا ٱسْتَقَٰمُوا۟ لَكُمْ فَٱسْتَقِيمُوا۟ لَهُمْۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُتَّقِينَ ", "translation": "How can there be for the polytheists a treaty in the sight of Allāh and with His Messenger, except for those with whom you made a treaty at al-Masjid al-Ḥarām? So as long as they are upright toward you,[1] be upright toward them. Indeed, Allāh loves the righteous [who fear Him].", "words": [{"id": 1, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 2, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 3, "arabic": "لِلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlِl", "root": "شرك"}, {"id": 4, "arabic": "عَهْدٌ", "translit": "ٌdْhَʿع", "root": "عهد"}, {"id": 5, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَعِندَ", "translit": "َdnِʿعَw", "root": "عند"}, {"id": 8, "arabic": "رَسُولِهِۦٓ", "translit": "ٓۦِhِlwُsَr", "root": "رسل"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "عَٰهَدتُّمْ", "translit": "ْmُّtdَhَٰʿع", "root": "عهد"}, {"id": 12, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 13, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد"}, {"id": 14, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 15, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 16, "arabic": "ٱسْتَقَٰمُوا۟", "translit": "۟āwُmَٰqَtْsٱ", "root": "قوم"}, {"id": 17, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 18, "arabic": "فَٱسْتَقِيمُوا۟", "translit": "۟āwُmyِqَtْsٱَf", "root": "قوم"}, {"id": 19, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 20, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 21, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 23, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 8, "text": "كَيْفَ وَإِن يَظْهَرُوا۟ عَلَيْكُمْ لَا يَرْقُبُوا۟ فِيكُمْ إِلًّا وَلَا ذِمَّةًۚ يُرْضُونَكُم بِأَفْوَٰهِهِمْ وَتَأْبَىٰ قُلُوبُهُمْ وَأَكْثَرُهُمْ فَٰسِقُونَ ", "translation": "How [can there be a treaty] while, if they gain dominance over you, they do not observe concerning you any pact of kinship or covenant of protection? They satisfy you with their mouths, but their hearts refuse [compliance], and most of them are defiantly disobedient.", "words": [{"id": 1, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 2, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 3, "arabic": "يَظْهَرُوا۟", "translit": "۟āwُrَhْẓَy", "root": "ظهر"}, {"id": 4, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَرْقُبُوا۟", "translit": "۟āwُbُqْrَy", "root": "رقب"}, {"id": 7, "arabic": "فِيكُمْ", "translit": "ْmُkyِf", "root": ""}, {"id": 8, "arabic": "إِلًّا", "translit": "āًّlِiʾ", "root": "الل"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "ذِمَّةً", "translit": "ًẗَّmِhd", "root": "ذمم"}, {"id": 11, "arabic": "يُرْضُونَكُم", "translit": "mُkَnwُḍْrُy", "root": "رضو"}, {"id": 12, "arabic": "بِأَفْوَٰهِهِمْ", "translit": "ْmِhِhَٰwْfَaʾِb", "root": "فوه"}, {"id": 13, "arabic": "وَتَأْبَىٰ", "translit": "ٰàَbْaʾَtَw", "root": "ابي"}, {"id": 14, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 15, "arabic": "وَأَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾَw", "root": "كثر"}, {"id": 16, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 9, "text": "ٱشْتَرَوْا۟ بِـَٔايَٰتِ ٱللَّهِ ثَمَنًا قَلِيلًا فَصَدُّوا۟ عَن سَبِيلِهِۦٓۚ إِنَّهُمْ سَآءَ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "They have exchanged the signs of Allāh for a small price and averted [people] from His way. Indeed, it was evil that they were doing.", "words": [{"id": 1, "arabic": "ٱشْتَرَوْا۟", "translit": "۟āْwَrَtْhsٱ", "root": "شري"}, {"id": 2, "arabic": "بِـَٔايَٰتِ", "translit": "ِtَٰyāَٔـِb", "root": "ايي"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 5, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 6, "arabic": "فَصَدُّوا۟", "translit": "۟āwُّdَṣَf", "root": "صدد"}, {"id": 7, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 8, "arabic": "سَبِيلِهِۦٓ", "translit": "ٓۦِhِlyِbَs", "root": "سبل"}, {"id": 9, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 10, "arabic": "سَآءَ", "translit": "َءٓāَs", "root": "سوا"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 13, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 10, "text": "لَا يَرْقُبُونَ فِى مُؤْمِنٍ إِلًّا وَلَا ذِمَّةًۚ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُعْتَدُونَ ", "translation": "They do not observe toward a believer any pact of kinship or covenant of protection. And it is they who are the transgressors.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَرْقُبُونَ", "translit": "َnwُbُqْrَy", "root": "رقب"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "مُؤْمِنٍ", "translit": "ٍnِmْwʾُm", "root": "امن"}, {"id": 5, "arabic": "إِلًّا", "translit": "āًّlِiʾ", "root": "الل"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "ذِمَّةً", "translit": "ًẗَّmِhd", "root": "ذمم"}, {"id": 8, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 9, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 10, "arabic": "ٱلْمُعْتَدُونَ", "translit": "َnwُdَtْʿعُmْlٱ", "root": "عدو"}], "hasIhya": false}, {"ayah": 11, "text": "فَإِن تَابُوا۟ وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟ ٱلزَّكَوٰةَ فَإِخْوَٰنُكُمْ فِى ٱلدِّينِۗ وَنُفَصِّلُ ٱلْءَايَٰتِ لِقَوْمٍ يَعْلَمُونَ ", "translation": "But if they repent, establish prayer, and give zakāh, then they are your brothers in religion; and We detail the verses for a people who know.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "تَابُوا۟", "translit": "۟āwُbāَt", "root": "توب"}, {"id": 3, "arabic": "وَأَقَامُوا۟", "translit": "۟āwُmāَqَaʾَw", "root": "قوم"}, {"id": 4, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 5, "arabic": "وَءَاتَوُا۟", "translit": "۟āُwَtāَءَw", "root": "اتي"}, {"id": 6, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 7, "arabic": "فَإِخْوَٰنُكُمْ", "translit": "ْmُkُnَٰwْhkِiʾَf", "root": "اخو"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 10, "arabic": "وَنُفَصِّلُ", "translit": "ُlِّṣَfُnَw", "root": "فصل"}, {"id": 11, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 12, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 13, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 12, "text": "وَإِن نَّكَثُوٓا۟ أَيْمَٰنَهُم مِّنۢ بَعْدِ عَهْدِهِمْ وَطَعَنُوا۟ فِى دِينِكُمْ فَقَٰتِلُوٓا۟ أَئِمَّةَ ٱلْكُفْرِۙ إِنَّهُمْ لَآ أَيْمَٰنَ لَهُمْ لَعَلَّهُمْ يَنتَهُونَ ", "translation": "And if they break their oaths after their treaty and defame your religion, then combat the leaders of disbelief, for indeed, there are no oaths [sacred] to them; [fight them that] they might cease.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "نَّكَثُوٓا۟", "translit": "۟āٓwُhtَkَّn", "root": "نكث"}, {"id": 3, "arabic": "أَيْمَٰنَهُم", "translit": "mُhَnَٰmْyَaʾ", "root": "يمن"}, {"id": 4, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "عَهْدِهِمْ", "translit": "ْmِhِdْhَʿع", "root": "عهد"}, {"id": 7, "arabic": "وَطَعَنُوا۟", "translit": "۟āwُnَʿعَṭَw", "root": "طعن"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "دِينِكُمْ", "translit": "ْmُkِnyِd", "root": "دين"}, {"id": 10, "arabic": "فَقَٰتِلُوٓا۟", "translit": "۟āٓwُlِtَٰqَf", "root": "قتل"}, {"id": 11, "arabic": "أَئِمَّةَ", "translit": "َẗَّmِyʾَaʾ", "root": "امم"}, {"id": 12, "arabic": "ٱلْكُفْرِ", "translit": "ِrْfُkْlٱ", "root": "كفر"}, {"id": 13, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 14, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 15, "arabic": "أَيْمَٰنَ", "translit": "َnَٰmْyَaʾ", "root": "يمن"}, {"id": 16, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 17, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 18, "arabic": "يَنتَهُونَ", "translit": "َnwُhَtnَy", "root": "نهي"}], "hasIhya": false}, {"ayah": 13, "text": "أَلَا تُقَٰتِلُونَ قَوْمًا نَّكَثُوٓا۟ أَيْمَٰنَهُمْ وَهَمُّوا۟ بِإِخْرَاجِ ٱلرَّسُولِ وَهُم بَدَءُوكُمْ أَوَّلَ مَرَّةٍۚ أَتَخْشَوْنَهُمْۚ فَٱللَّهُ أَحَقُّ أَن تَخْشَوْهُ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "Would you not fight against a people who broke their oaths and determined to expel the Messenger, and they had begun [the attack upon] you the first time? Do you fear them? But Allāh has more right that you should fear Him, if you are [truly] believers.", "words": [{"id": 1, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 2, "arabic": "تُقَٰتِلُونَ", "translit": "َnwُlِtَٰqُt", "root": "قتل"}, {"id": 3, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 4, "arabic": "نَّكَثُوٓا۟", "translit": "۟āٓwُhtَkَّn", "root": "نكث"}, {"id": 5, "arabic": "أَيْمَٰنَهُمْ", "translit": "ْmُhَnَٰmْyَaʾ", "root": "يمن"}, {"id": 6, "arabic": "وَهَمُّوا۟", "translit": "۟āwُّmَhَw", "root": "همم"}, {"id": 7, "arabic": "بِإِخْرَاجِ", "translit": "ِjgāَrْhkِiʾِb", "root": "خرج"}, {"id": 8, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 9, "arabic": "وَهُم", "translit": "mُhَw", "root": ""}, {"id": 10, "arabic": "بَدَءُوكُمْ", "translit": "ْmُkwُءَdَb", "root": "بدا"}, {"id": 11, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 12, "arabic": "مَرَّةٍ", "translit": "ٍẗَّrَm", "root": "مرر"}, {"id": 13, "arabic": "أَتَخْشَوْنَهُمْ", "translit": "ْmُhَnْwَhsْhkَtَaʾ", "root": "خشي"}, {"id": 14, "arabic": "فَٱللَّهُ", "translit": "ُhَّllٱَf", "root": "اله"}, {"id": 15, "arabic": "أَحَقُّ", "translit": "ُّqَḥَaʾ", "root": "حقق"}, {"id": 16, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 17, "arabic": "تَخْشَوْهُ", "translit": "ُhْwَhsْhkَt", "root": "خشي"}, {"id": 18, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 19, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 20, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": false}, {"ayah": 14, "text": "قَٰتِلُوهُمْ يُعَذِّبْهُمُ ٱللَّهُ بِأَيْدِيكُمْ وَيُخْزِهِمْ وَيَنصُرْكُمْ عَلَيْهِمْ وَيَشْفِ صُدُورَ قَوْمٍ مُّؤْمِنِينَ ", "translation": "Fight them; Allāh will punish them by your hands and will disgrace them and give you victory over them and satisfy the breasts [i.e., desires] of a believing people", "words": [{"id": 1, "arabic": "قَٰتِلُوهُمْ", "translit": "ْmُhwُlِtَٰq", "root": "قتل"}, {"id": 2, "arabic": "يُعَذِّبْهُمُ", "translit": "ُmُhْbِّhdَʿعُy", "root": "عذب"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "بِأَيْدِيكُمْ", "translit": "ْmُkyِdْyَaʾِb", "root": "يدي"}, {"id": 5, "arabic": "وَيُخْزِهِمْ", "translit": "ْmِhِzْhkُyَw", "root": "خزي"}, {"id": 6, "arabic": "وَيَنصُرْكُمْ", "translit": "ْmُkْrُṣnَyَw", "root": "نصر"}, {"id": 7, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَيَشْفِ", "translit": "ِfْhsَyَw", "root": "شفي"}, {"id": 9, "arabic": "صُدُورَ", "translit": "َrwُdُṣ", "root": "صدر"}, {"id": 10, "arabic": "قَوْمٍ", "translit": "ٍmْwَq", "root": "قوم"}, {"id": 11, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": true}, {"ayah": 15, "text": "وَيُذْهِبْ غَيْظَ قُلُوبِهِمْۗ وَيَتُوبُ ٱللَّهُ عَلَىٰ مَن يَشَآءُۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "And remove the fury in their [i.e., the believers'] hearts. And Allāh turns in forgiveness to whom He wills; and Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "وَيُذْهِبْ", "translit": "ْbِhْhdُyَw", "root": "ذهب"}, {"id": 2, "arabic": "غَيْظَ", "translit": "َẓْyَغ", "root": "غيظ"}, {"id": 3, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 4, "arabic": "وَيَتُوبُ", "translit": "ُbwُtَyَw", "root": "توب"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 9, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 10, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 11, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 16, "text": "أَمْ حَسِبْتُمْ أَن تُتْرَكُوا۟ وَلَمَّا يَعْلَمِ ٱللَّهُ ٱلَّذِينَ جَٰهَدُوا۟ مِنكُمْ وَلَمْ يَتَّخِذُوا۟ مِن دُونِ ٱللَّهِ وَلَا رَسُولِهِۦ وَلَا ٱلْمُؤْمِنِينَ وَلِيجَةًۚ وَٱللَّهُ خَبِيرٌۢ بِمَا تَعْمَلُونَ ", "translation": "Do you think that you will be left [as you are] while Allāh has not yet made evident those among you who strive [for His cause] and do not take other than Allāh, His Messenger and the believers as intimates? And Allāh is [fully] Aware of what you do.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "حَسِبْتُمْ", "translit": "ْmُtْbِsَḥ", "root": "حسب"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تُتْرَكُوا۟", "translit": "۟āwُkَrْtُt", "root": "ترك"}, {"id": 5, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 6, "arabic": "يَعْلَمِ", "translit": "ِmَlْʿعَy", "root": "علم"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "جَٰهَدُوا۟", "translit": "۟āwُdَhَٰjg", "root": "جهد"}, {"id": 10, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 11, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 12, "arabic": "يَتَّخِذُوا۟", "translit": "۟āwُhdِhkَّtَy", "root": "اخذ"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "رَسُولِهِۦ", "translit": "ۦِhِlwُsَr", "root": "رسل"}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 20, "arabic": "وَلِيجَةً", "translit": "ًẗَjgyِlَw", "root": "ولج"}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "خَبِيرٌۢ", "translit": "ٌۢryِbَhk", "root": "خبر"}, {"id": 23, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 24, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 17, "text": "مَا كَانَ لِلْمُشْرِكِينَ أَن يَعْمُرُوا۟ مَسَٰجِدَ ٱللَّهِ شَٰهِدِينَ عَلَىٰٓ أَنفُسِهِم بِٱلْكُفْرِۚ أُو۟لَٰٓئِكَ حَبِطَتْ أَعْمَٰلُهُمْ وَفِى ٱلنَّارِ هُمْ خَٰلِدُونَ ", "translation": "It is not for the polytheists to maintain the mosques of Allāh [while] witnessing against themselves with disbelief. [For] those, their deeds have become worthless, and in the Fire they will abide eternally.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlِl", "root": "شرك"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَعْمُرُوا۟", "translit": "۟āwُrُmْʿعَy", "root": "عمر"}, {"id": 6, "arabic": "مَسَٰجِدَ", "translit": "َdِjgَٰsَm", "root": "سجد"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "شَٰهِدِينَ", "translit": "َnyِdِhَٰhs", "root": "شهد"}, {"id": 9, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 10, "arabic": "أَنفُسِهِم", "translit": "mِhِsُfnَaʾ", "root": "نفس"}, {"id": 11, "arabic": "بِٱلْكُفْرِ", "translit": "ِrْfُkْlٱِb", "root": "كفر"}, {"id": 12, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 13, "arabic": "حَبِطَتْ", "translit": "ْtَṭِbَḥ", "root": "حبط"}, {"id": 14, "arabic": "أَعْمَٰلُهُمْ", "translit": "ْmُhُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 15, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 16, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 17, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 18, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 18, "text": "إِنَّمَا يَعْمُرُ مَسَٰجِدَ ٱللَّهِ مَنْ ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ وَلَمْ يَخْشَ إِلَّا ٱللَّهَۖ فَعَسَىٰٓ أُو۟لَٰٓئِكَ أَن يَكُونُوا۟ مِنَ ٱلْمُهْتَدِينَ ", "translation": "The mosques of Allāh are only to be maintained by those who believe in Allāh and the Last Day and establish prayer and give zakāh and do not fear except Allāh, for it is expected that those will be of the [rightly] guided.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَعْمُرُ", "translit": "ُrُmْʿعَy", "root": "عمر"}, {"id": 3, "arabic": "مَسَٰجِدَ", "translit": "َdِjgَٰsَm", "root": "سجد"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 6, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 7, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 8, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 9, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 10, "arabic": "وَأَقَامَ", "translit": "َmāَqَaʾَw", "root": "قوم"}, {"id": 11, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 12, "arabic": "وَءَاتَى", "translit": "àَtāَءَw", "root": "اتي"}, {"id": 13, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 14, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 15, "arabic": "يَخْشَ", "translit": "َhsْhkَy", "root": "خشي"}, {"id": 16, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "فَعَسَىٰٓ", "translit": "ٰٓàَsَʿعَf", "root": "عسي"}, {"id": 19, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 20, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 21, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 22, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 23, "arabic": "ٱلْمُهْتَدِينَ", "translit": "َnyِdَtْhُmْlٱ", "root": "هدي"}], "hasIhya": true}, {"ayah": 19, "text": "أَجَعَلْتُمْ سِقَايَةَ ٱلْحَآجِّ وَعِمَارَةَ ٱلْمَسْجِدِ ٱلْحَرَامِ كَمَنْ ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَجَٰهَدَ فِى سَبِيلِ ٱللَّهِۚ لَا يَسْتَوُۥنَ عِندَ ٱللَّهِۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّٰلِمِينَ ", "translation": "Have you made the providing of water for the pilgrim and the maintenance of al-Masjid al-Ḥarām equal to [the deeds of] one who believes in Allāh and the Last Day and strives in the cause of Allāh? They are not equal in the sight of Allāh. And Allāh does not guide the wrongdoing people.", "words": [{"id": 1, "arabic": "أَجَعَلْتُمْ", "translit": "ْmُtْlَʿعَjgَaʾ", "root": "جعل"}, {"id": 2, "arabic": "سِقَايَةَ", "translit": "َẗَyāَqِs", "root": "سقي"}, {"id": 3, "arabic": "ٱلْحَآجِّ", "translit": "ِّjgٓāَḥْlٱ", "root": "حجج"}, {"id": 4, "arabic": "وَعِمَارَةَ", "translit": "َẗَrāَmِʿعَw", "root": "عمر"}, {"id": 5, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد"}, {"id": 6, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 7, "arabic": "كَمَنْ", "translit": "ْnَmَk", "root": ""}, {"id": 8, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 9, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 10, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 11, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 12, "arabic": "وَجَٰهَدَ", "translit": "َdَhَٰjgَw", "root": "جهد"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَسْتَوُۥنَ", "translit": "َnۥُwَtْsَy", "root": "سوي"}, {"id": 18, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 23, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 24, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 20, "text": "ٱلَّذِينَ ءَامَنُوا۟ وَهَاجَرُوا۟ وَجَٰهَدُوا۟ فِى سَبِيلِ ٱللَّهِ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ أَعْظَمُ دَرَجَةً عِندَ ٱللَّهِۚ وَأُو۟لَٰٓئِكَ هُمُ ٱلْفَآئِزُونَ ", "translation": "The ones who have believed, emigrated and striven in the cause of Allāh with their wealth and their lives are greater in rank in the sight of Allāh. And it is those who are the attainers [of success].", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "وَهَاجَرُوا۟", "translit": "۟āwُrَjgāَhَw", "root": "هجر"}, {"id": 4, "arabic": "وَجَٰهَدُوا۟", "translit": "۟āwُdَhَٰjgَw", "root": "جهد"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "بِأَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾِb", "root": "مول"}, {"id": 9, "arabic": "وَأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾَw", "root": "نفس"}, {"id": 10, "arabic": "أَعْظَمُ", "translit": "ُmَẓْʿعَaʾ", "root": "عظم"}, {"id": 11, "arabic": "دَرَجَةً", "translit": "ًẗَjgَrَd", "root": "درج"}, {"id": 12, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 15, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 16, "arabic": "ٱلْفَآئِزُونَ", "translit": "َnwُzِyʾٓāَfْlٱ", "root": "فوز"}], "hasIhya": false}, {"ayah": 21, "text": "يُبَشِّرُهُمْ رَبُّهُم بِرَحْمَةٍ مِّنْهُ وَرِضْوَٰنٍ وَجَنَّٰتٍ لَّهُمْ فِيهَا نَعِيمٌ مُّقِيمٌ ", "translation": "Their Lord gives them good tidings of mercy from Him and approval and of gardens for them wherein is enduring pleasure.", "words": [{"id": 1, "arabic": "يُبَشِّرُهُمْ", "translit": "ْmُhُrِّhsَbُy", "root": "بشر"}, {"id": 2, "arabic": "رَبُّهُم", "translit": "mُhُّbَr", "root": "ربب"}, {"id": 3, "arabic": "بِرَحْمَةٍ", "translit": "ٍẗَmْḥَrِb", "root": "رحم"}, {"id": 4, "arabic": "مِّنْهُ", "translit": "ُhْnِّm", "root": ""}, {"id": 5, "arabic": "وَرِضْوَٰنٍ", "translit": "ٍnَٰwْḍِrَw", "root": "رضو"}, {"id": 6, "arabic": "وَجَنَّٰتٍ", "translit": "ٍtَّٰnَjgَw", "root": "جنن"}, {"id": 7, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 8, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 9, "arabic": "نَعِيمٌ", "translit": "ٌmyِʿعَn", "root": "نعم"}, {"id": 10, "arabic": "مُّقِيمٌ", "translit": "ٌmyِqُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 22, "text": "خَٰلِدِينَ فِيهَآ أَبَدًاۚ إِنَّ ٱللَّهَ عِندَهُۥٓ أَجْرٌ عَظِيمٌ ", "translation": "[They will be] abiding therein forever. Indeed, Allāh has with Him a great reward.", "words": [{"id": 1, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 2, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 3, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "عِندَهُۥٓ", "translit": "ٓۥُhَdnِʿع", "root": "عند"}, {"id": 7, "arabic": "أَجْرٌ", "translit": "ٌrْjgَaʾ", "root": "اجر"}, {"id": 8, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 23, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَتَّخِذُوٓا۟ ءَابَآءَكُمْ وَإِخْوَٰنَكُمْ أَوْلِيَآءَ إِنِ ٱسْتَحَبُّوا۟ ٱلْكُفْرَ عَلَى ٱلْإِيمَٰنِۚ وَمَن يَتَوَلَّهُم مِّنكُمْ فَأُو۟لَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ ", "translation": "O you who have believed, do not take your fathers or your brothers as allies if they have preferred disbelief over belief. And whoever does so among you - then it is those who are the wrongdoers.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَتَّخِذُوٓا۟", "translit": "۟āٓwُhdِhkَّtَt", "root": "اخذ"}, {"id": 6, "arabic": "ءَابَآءَكُمْ", "translit": "ْmُkَءٓāَbāَء", "root": "ابو"}, {"id": 7, "arabic": "وَإِخْوَٰنَكُمْ", "translit": "ْmُkَnَٰwْhkِiʾَw", "root": "اخو"}, {"id": 8, "arabic": "أَوْلِيَآءَ", "translit": "َءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 9, "arabic": "إِنِ", "translit": "ِnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱسْتَحَبُّوا۟", "translit": "۟āwُّbَḥَtْsٱ", "root": "حبب"}, {"id": 11, "arabic": "ٱلْكُفْرَ", "translit": "َrْfُkْlٱ", "root": "كفر"}, {"id": 12, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlٱ", "root": "امن"}, {"id": 14, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 15, "arabic": "يَتَوَلَّهُم", "translit": "mُhَّlَwَtَy", "root": "ولي"}, {"id": 16, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 17, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 18, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 19, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 24, "text": "قُلْ إِن كَانَ ءَابَآؤُكُمْ وَأَبْنَآؤُكُمْ وَإِخْوَٰنُكُمْ وَأَزْوَٰجُكُمْ وَعَشِيرَتُكُمْ وَأَمْوَٰلٌ ٱقْتَرَفْتُمُوهَا وَتِجَٰرَةٌ تَخْشَوْنَ كَسَادَهَا وَمَسَٰكِنُ تَرْضَوْنَهَآ أَحَبَّ إِلَيْكُم مِّنَ ٱللَّهِ وَرَسُولِهِۦ وَجِهَادٍ فِى سَبِيلِهِۦ فَتَرَبَّصُوا۟ حَتَّىٰ يَأْتِىَ ٱللَّهُ بِأَمْرِهِۦۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلْفَٰسِقِينَ ", "translation": "Say, [O Muḥammad], \"If your fathers, your sons, your brothers, your wives, your relatives, wealth which you have obtained, commerce wherein you fear decline, and dwellings with which you are pleased are more beloved to you than Allāh and His Messenger and jihād [i.e., striving] in His cause, then wait until Allāh executes His command. And Allāh does not guide the defiantly disobedient people.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "ءَابَآؤُكُمْ", "translit": "ْmُkُwʾٓāَbāَء", "root": "ابو"}, {"id": 5, "arabic": "وَأَبْنَآؤُكُمْ", "translit": "ْmُkُwʾٓāَnْbَaʾَw", "root": "بني"}, {"id": 6, "arabic": "وَإِخْوَٰنُكُمْ", "translit": "ْmُkُnَٰwْhkِiʾَw", "root": "اخو"}, {"id": 7, "arabic": "وَأَزْوَٰجُكُمْ", "translit": "ْmُkُjgَٰwْzَaʾَw", "root": "زوج"}, {"id": 8, "arabic": "وَعَشِيرَتُكُمْ", "translit": "ْmُkُtَryِhsَʿعَw", "root": "عشر"}, {"id": 9, "arabic": "وَأَمْوَٰلٌ", "translit": "ٌlَٰwْmَaʾَw", "root": "مول"}, {"id": 10, "arabic": "ٱقْتَرَفْتُمُوهَا", "translit": "āَhwُmُtْfَrَtْqٱ", "root": "قرف"}, {"id": 11, "arabic": "وَتِجَٰرَةٌ", "translit": "ٌẗَrَٰjgِtَw", "root": "تجر"}, {"id": 12, "arabic": "تَخْشَوْنَ", "translit": "َnْwَhsْhkَt", "root": "خشي"}, {"id": 13, "arabic": "كَسَادَهَا", "translit": "āَhَdāَsَk", "root": "كسد"}, {"id": 14, "arabic": "وَمَسَٰكِنُ", "translit": "ُnِkَٰsَmَw", "root": "سكن"}, {"id": 15, "arabic": "تَرْضَوْنَهَآ", "translit": "ٓāَhَnْwَḍْrَt", "root": "رضو"}, {"id": 16, "arabic": "أَحَبَّ", "translit": "َّbَḥَaʾ", "root": "حبب"}, {"id": 17, "arabic": "إِلَيْكُم", "translit": "mُkْyَlِiʾ", "root": ""}, {"id": 18, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 21, "arabic": "وَجِهَادٍ", "translit": "ٍdāَhِjgَw", "root": "جهد"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "سَبِيلِهِۦ", "translit": "ۦِhِlyِbَs", "root": "سبل"}, {"id": 24, "arabic": "فَتَرَبَّصُوا۟", "translit": "۟āwُṣَّbَrَtَf", "root": "ربص"}, {"id": 25, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 26, "arabic": "يَأْتِىَ", "translit": "َàِtْaʾَy", "root": "اتي"}, {"id": 27, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "بِأَمْرِهِۦ", "translit": "ۦِhِrْmَaʾِb", "root": "امر"}, {"id": 29, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 30, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 31, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 32, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 33, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": true}, {"ayah": 25, "text": "لَقَدْ نَصَرَكُمُ ٱللَّهُ فِى مَوَاطِنَ كَثِيرَةٍۙ وَيَوْمَ حُنَيْنٍۙ إِذْ أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ تُغْنِ عَنكُمْ شَيْـًٔا وَضَاقَتْ عَلَيْكُمُ ٱلْأَرْضُ بِمَا رَحُبَتْ ثُمَّ وَلَّيْتُم مُّدْبِرِينَ ", "translation": "Allāh has already given you victory in many regions and [even] on the day of Ḥunayn, when your great number pleased you, but it did not avail you at all, and the earth was confining for you with [i.e., in spite of] its vastness; then you turned back, fleeing.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "نَصَرَكُمُ", "translit": "ُmُkَrَṣَn", "root": "نصر"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "مَوَاطِنَ", "translit": "َnِṭāَwَm", "root": "وطن"}, {"id": 6, "arabic": "كَثِيرَةٍ", "translit": "ٍẗَryِhtَk", "root": "كثر"}, {"id": 7, "arabic": "وَيَوْمَ", "translit": "َmْwَyَw", "root": "يوم"}, {"id": 8, "arabic": "حُنَيْنٍ", "translit": "ٍnْyَnُḥ", "root": ""}, {"id": 9, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 10, "arabic": "أَعْجَبَتْكُمْ", "translit": "ْmُkْtَbَjgْʿعَaʾ", "root": "عجب"}, {"id": 11, "arabic": "كَثْرَتُكُمْ", "translit": "ْmُkُtَrْhtَk", "root": "كثر"}, {"id": 12, "arabic": "فَلَمْ", "translit": "ْmَlَf", "root": ""}, {"id": 13, "arabic": "تُغْنِ", "translit": "ِnْغُt", "root": "غني"}, {"id": 14, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 15, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 16, "arabic": "وَضَاقَتْ", "translit": "ْtَqāَḍَw", "root": "ضيق"}, {"id": 17, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 18, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 20, "arabic": "رَحُبَتْ", "translit": "ْtَbُḥَr", "root": "رحب"}, {"id": 21, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 22, "arabic": "وَلَّيْتُم", "translit": "mُtْyَّlَw", "root": "ولي"}, {"id": 23, "arabic": "مُّدْبِرِينَ", "translit": "َnyِrِbْdُّm", "root": "دبر"}], "hasIhya": true}, {"ayah": 26, "text": "ثُمَّ أَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَىٰ رَسُولِهِۦ وَعَلَى ٱلْمُؤْمِنِينَ وَأَنزَلَ جُنُودًا لَّمْ تَرَوْهَا وَعَذَّبَ ٱلَّذِينَ كَفَرُوا۟ۚ وَذَٰلِكَ جَزَآءُ ٱلْكَٰفِرِينَ ", "translation": "Then Allāh sent down His tranquility upon His Messenger and upon the believers and sent down soldiers [i.e., angels] whom you did not see and punished those who disbelieved. And that is the recompense of the disbelievers.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "سَكِينَتَهُۥ", "translit": "ۥُhَtَnyِkَs", "root": "سكن"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "رَسُولِهِۦ", "translit": "ۦِhِlwُsَr", "root": "رسل"}, {"id": 7, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 8, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 9, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 10, "arabic": "جُنُودًا", "translit": "āًdwُnُjg", "root": "جند"}, {"id": 11, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 12, "arabic": "تَرَوْهَا", "translit": "āَhْwَrَt", "root": "راي"}, {"id": 13, "arabic": "وَعَذَّبَ", "translit": "َbَّhdَʿعَw", "root": "عذب"}, {"id": 14, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 16, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 17, "arabic": "جَزَآءُ", "translit": "ُءٓāَzَjg", "root": "جزي"}, {"id": 18, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 27, "text": "ثُمَّ يَتُوبُ ٱللَّهُ مِنۢ بَعْدِ ذَٰلِكَ عَلَىٰ مَن يَشَآءُۗ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "Then Allāh will accept repentance after that for whom He wills; and Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "يَتُوبُ", "translit": "ُbwُtَy", "root": "توب"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 9, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 10, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 11, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 12, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 28, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّمَا ٱلْمُشْرِكُونَ نَجَسٌ فَلَا يَقْرَبُوا۟ ٱلْمَسْجِدَ ٱلْحَرَامَ بَعْدَ عَامِهِمْ هَٰذَاۚ وَإِنْ خِفْتُمْ عَيْلَةً فَسَوْفَ يُغْنِيكُمُ ٱللَّهُ مِن فَضْلِهِۦٓ إِن شَآءَۚ إِنَّ ٱللَّهَ عَلِيمٌ حَكِيمٌ ", "translation": "O you who have believed, indeed the polytheists are unclean, so let them not approach al-Masjid al-Ḥarām after this, their [final] year. And if you fear privation, Allāh will enrich you from His bounty if He wills. Indeed, Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 5, "arabic": "ٱلْمُشْرِكُونَ", "translit": "َnwُkِrْhsُmْlٱ", "root": "شرك"}, {"id": 6, "arabic": "نَجَسٌ", "translit": "ٌsَjgَn", "root": "نجس"}, {"id": 7, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 8, "arabic": "يَقْرَبُوا۟", "translit": "۟āwُbَrْqَy", "root": "قرب"}, {"id": 9, "arabic": "ٱلْمَسْجِدَ", "translit": "َdِjgْsَmْlٱ", "root": "سجد"}, {"id": 10, "arabic": "ٱلْحَرَامَ", "translit": "َmāَrَḥْlٱ", "root": "حرم"}, {"id": 11, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 12, "arabic": "عَامِهِمْ", "translit": "ْmِhِmāَʿع", "root": "عوم"}, {"id": 13, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 14, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 15, "arabic": "خِفْتُمْ", "translit": "ْmُtْfِhk", "root": "خوف"}, {"id": 16, "arabic": "عَيْلَةً", "translit": "ًẗَlْyَʿع", "root": "عيل"}, {"id": 17, "arabic": "فَسَوْفَ", "translit": "َfْwَsَf", "root": ""}, {"id": 18, "arabic": "يُغْنِيكُمُ", "translit": "ُmُkyِnْغُy", "root": "غني"}, {"id": 19, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 21, "arabic": "فَضْلِهِۦٓ", "translit": "ٓۦِhِlْḍَf", "root": "فضل"}, {"id": 22, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 23, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 27, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 29, "text": "قَٰتِلُوا۟ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱللَّهِ وَلَا بِٱلْيَوْمِ ٱلْءَاخِرِ وَلَا يُحَرِّمُونَ مَا حَرَّمَ ٱللَّهُ وَرَسُولُهُۥ وَلَا يَدِينُونَ دِينَ ٱلْحَقِّ مِنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ حَتَّىٰ يُعْطُوا۟ ٱلْجِزْيَةَ عَن يَدٍ وَهُمْ صَٰغِرُونَ ", "translation": "Fight against those who do not believe in Allāh or in the Last Day and who do not consider unlawful what Allāh and His Messenger have made unlawful and who do not adopt the religion of truth [i.e., Islām] from those who were given the Scripture - [fight] until they give the jizyah[1] willingly while they are humbled.", "words": [{"id": 1, "arabic": "قَٰتِلُوا۟", "translit": "۟āwُlِtَٰq", "root": "قتل"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "بِٱلْيَوْمِ", "translit": "ِmْwَyْlٱِb", "root": "يوم"}, {"id": 8, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يُحَرِّمُونَ", "translit": "َnwُmِّrَḥُy", "root": "حرم"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "يَدِينُونَ", "translit": "َnwُnyِdَy", "root": "دين"}, {"id": 17, "arabic": "دِينَ", "translit": "َnyِd", "root": "دين"}, {"id": 18, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 19, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 20, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 21, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 22, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 23, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 24, "arabic": "يُعْطُوا۟", "translit": "۟āwُṭْʿعُy", "root": "عطو"}, {"id": 25, "arabic": "ٱلْجِزْيَةَ", "translit": "َẗَyْzِjgْlٱ", "root": "جزي"}, {"id": 26, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 27, "arabic": "يَدٍ", "translit": "ٍdَy", "root": "يدي"}, {"id": 28, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 29, "arabic": "صَٰغِرُونَ", "translit": "َnwُrِغَٰṣ", "root": "صغر"}], "hasIhya": false}, {"ayah": 30, "text": "وَقَالَتِ ٱلْيَهُودُ عُزَيْرٌ ٱبْنُ ٱللَّهِ وَقَالَتِ ٱلنَّصَٰرَى ٱلْمَسِيحُ ٱبْنُ ٱللَّهِۖ ذَٰلِكَ قَوْلُهُم بِأَفْوَٰهِهِمْۖ يُضَٰهِـُٔونَ قَوْلَ ٱلَّذِينَ كَفَرُوا۟ مِن قَبْلُۚ قَٰتَلَهُمُ ٱللَّهُۚ أَنَّىٰ يُؤْفَكُونَ ", "translation": "The Jews say, \"Ezra is the son of Allāh\"; and the Christians say, \"The Messiah is the son of Allāh.\" That is their statement from their mouths; they imitate the saying of those who disbelieved before [them]. May Allāh destroy them; how are they deluded?", "words": [{"id": 1, "arabic": "وَقَالَتِ", "translit": "ِtَlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْيَهُودُ", "translit": "ُdwُhَyْlٱ", "root": "هود"}, {"id": 3, "arabic": "عُزَيْرٌ", "translit": "ٌrْyَzُʿع", "root": ""}, {"id": 4, "arabic": "ٱبْنُ", "translit": "ُnْbٱ", "root": "بني"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَقَالَتِ", "translit": "ِtَlāَqَw", "root": "قول"}, {"id": 7, "arabic": "ٱلنَّصَٰرَى", "translit": "àَrَٰṣَّnlٱ", "root": "نصر"}, {"id": 8, "arabic": "ٱلْمَسِيحُ", "translit": "ُḥyِsَmْlٱ", "root": "مسح"}, {"id": 9, "arabic": "ٱبْنُ", "translit": "ُnْbٱ", "root": "بني"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 12, "arabic": "قَوْلُهُم", "translit": "mُhُlْwَq", "root": "قول"}, {"id": 13, "arabic": "بِأَفْوَٰهِهِمْ", "translit": "ْmِhِhَٰwْfَaʾِb", "root": "فوه"}, {"id": 14, "arabic": "يُضَٰهِـُٔونَ", "translit": "َnwُٔـِhَٰḍُy", "root": "ضها"}, {"id": 15, "arabic": "قَوْلَ", "translit": "َlْwَq", "root": "قول"}, {"id": 16, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 17, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 20, "arabic": "قَٰتَلَهُمُ", "translit": "ُmُhَlَtَٰq", "root": "قتل"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "أَنَّىٰ", "translit": "ٰàَّnَaʾ", "root": ""}, {"id": 23, "arabic": "يُؤْفَكُونَ", "translit": "َnwُkَfْwʾُy", "root": "افك"}], "hasIhya": false}, {"ayah": 31, "text": "ٱتَّخَذُوٓا۟ أَحْبَارَهُمْ وَرُهْبَٰنَهُمْ أَرْبَابًا مِّن دُونِ ٱللَّهِ وَٱلْمَسِيحَ ٱبْنَ مَرْيَمَ وَمَآ أُمِرُوٓا۟ إِلَّا لِيَعْبُدُوٓا۟ إِلَٰهًا وَٰحِدًاۖ لَّآ إِلَٰهَ إِلَّا هُوَۚ سُبْحَٰنَهُۥ عَمَّا يُشْرِكُونَ ", "translation": "They have taken their scholars and monks as lords besides Allāh,[1] and [also] the Messiah, the son of Mary.[2] And they were not commanded except to worship one God; there is no deity except Him. Exalted is He above whatever they associate with Him.", "words": [{"id": 1, "arabic": "ٱتَّخَذُوٓا۟", "translit": "۟āٓwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 2, "arabic": "أَحْبَارَهُمْ", "translit": "ْmُhَrāَbْḥَaʾ", "root": "حبر"}, {"id": 3, "arabic": "وَرُهْبَٰنَهُمْ", "translit": "ْmُhَnَٰbْhُrَw", "root": "رهب"}, {"id": 4, "arabic": "أَرْبَابًا", "translit": "āًbāَbْrَaʾ", "root": "ربب"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَٱلْمَسِيحَ", "translit": "َḥyِsَmْlٱَw", "root": "مسح"}, {"id": 9, "arabic": "ٱبْنَ", "translit": "َnْbٱ", "root": "بني"}, {"id": 10, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 11, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 12, "arabic": "أُمِرُوٓا۟", "translit": "۟āٓwُrِmُaʾ", "root": "امر"}, {"id": 13, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 14, "arabic": "لِيَعْبُدُوٓا۟", "translit": "۟āٓwُdُbْʿعَyِl", "root": "عبد"}, {"id": 15, "arabic": "إِلَٰهًا", "translit": "āًhَٰlِiʾ", "root": "اله"}, {"id": 16, "arabic": "وَٰحِدًا", "translit": "āًdِḥَٰw", "root": "وحد"}, {"id": 17, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 18, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 19, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 20, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 21, "arabic": "سُبْحَٰنَهُۥ", "translit": "ۥُhَnَٰḥْbُs", "root": "سبح"}, {"id": 22, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 23, "arabic": "يُشْرِكُونَ", "translit": "َnwُkِrْhsُy", "root": "شرك"}], "hasIhya": false}, {"ayah": 32, "text": "يُرِيدُونَ أَن يُطْفِـُٔوا۟ نُورَ ٱللَّهِ بِأَفْوَٰهِهِمْ وَيَأْبَى ٱللَّهُ إِلَّآ أَن يُتِمَّ نُورَهُۥ وَلَوْ كَرِهَ ٱلْكَٰفِرُونَ ", "translation": "They want to extinguish the light of Allāh with their mouths, but Allāh refuses except to perfect His light, although the disbelievers dislike it.", "words": [{"id": 1, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود"}, {"id": 2, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 3, "arabic": "يُطْفِـُٔوا۟", "translit": "۟āwُٔـِfْṭُy", "root": "طفا"}, {"id": 4, "arabic": "نُورَ", "translit": "َrwُn", "root": "نور"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "بِأَفْوَٰهِهِمْ", "translit": "ْmِhِhَٰwْfَaʾِb", "root": "فوه"}, {"id": 7, "arabic": "وَيَأْبَى", "translit": "àَbْaʾَyَw", "root": "ابي"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "يُتِمَّ", "translit": "َّmِtُy", "root": "تمم"}, {"id": 12, "arabic": "نُورَهُۥ", "translit": "ۥُhَrwُn", "root": "نور"}, {"id": 13, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 14, "arabic": "كَرِهَ", "translit": "َhِrَk", "root": "كره"}, {"id": 15, "arabic": "ٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 33, "text": "هُوَ ٱلَّذِىٓ أَرْسَلَ رَسُولَهُۥ بِٱلْهُدَىٰ وَدِينِ ٱلْحَقِّ لِيُظْهِرَهُۥ عَلَى ٱلدِّينِ كُلِّهِۦ وَلَوْ كَرِهَ ٱلْمُشْرِكُونَ ", "translation": "It is He who has sent His Messenger with guidance and the religion of truth to manifest it over all religion, although they who associate others with Allāh dislike it.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "أَرْسَلَ", "translit": "َlَsْrَaʾ", "root": "رسل"}, {"id": 4, "arabic": "رَسُولَهُۥ", "translit": "ۥُhَlwُsَr", "root": "رسل"}, {"id": 5, "arabic": "بِٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱِb", "root": "هدي"}, {"id": 6, "arabic": "وَدِينِ", "translit": "ِnyِdَw", "root": "دين"}, {"id": 7, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 8, "arabic": "لِيُظْهِرَهُۥ", "translit": "ۥُhَrِhْẓُyِl", "root": "ظهر"}, {"id": 9, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 10, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 11, "arabic": "كُلِّهِۦ", "translit": "ۦِhِّlُk", "root": "كلل"}, {"id": 12, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 13, "arabic": "كَرِهَ", "translit": "َhِrَk", "root": "كره"}, {"id": 14, "arabic": "ٱلْمُشْرِكُونَ", "translit": "َnwُkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": false}, {"ayah": 34, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِنَّ كَثِيرًا مِّنَ ٱلْأَحْبَارِ وَٱلرُّهْبَانِ لَيَأْكُلُونَ أَمْوَٰلَ ٱلنَّاسِ بِٱلْبَٰطِلِ وَيَصُدُّونَ عَن سَبِيلِ ٱللَّهِۗ وَٱلَّذِينَ يَكْنِزُونَ ٱلذَّهَبَ وَٱلْفِضَّةَ وَلَا يُنفِقُونَهَا فِى سَبِيلِ ٱللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ ", "translation": "O you who have believed, indeed many of the scholars and the monks devour the wealth of people unjustly[1] and avert [them] from the way of Allāh. And those who hoard gold and silver and spend it not in the way of Allāh - give them tidings of a painful punishment.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلْأَحْبَارِ", "translit": "ِrāَbْḥَaʾْlٱ", "root": "حبر"}, {"id": 8, "arabic": "وَٱلرُّهْبَانِ", "translit": "ِnāَbْhُّrlٱَw", "root": "رهب"}, {"id": 9, "arabic": "لَيَأْكُلُونَ", "translit": "َnwُlُkْaʾَyَl", "root": "اكل"}, {"id": 10, "arabic": "أَمْوَٰلَ", "translit": "َlَٰwْmَaʾ", "root": "مول"}, {"id": 11, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 12, "arabic": "بِٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱِb", "root": "بطل"}, {"id": 13, "arabic": "وَيَصُدُّونَ", "translit": "َnwُّdُṣَyَw", "root": "صدد"}, {"id": 14, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 15, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 18, "arabic": "يَكْنِزُونَ", "translit": "َnwُzِnْkَy", "root": "كنز"}, {"id": 19, "arabic": "ٱلذَّهَبَ", "translit": "َbَhَّhdlٱ", "root": "ذهب"}, {"id": 20, "arabic": "وَٱلْفِضَّةَ", "translit": "َẗَّḍِfْlٱَw", "root": "فضض"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "يُنفِقُونَهَا", "translit": "āَhَnwُqِfnُy", "root": "نفق"}, {"id": 23, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 24, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 25, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "فَبَشِّرْهُم", "translit": "mُhْrِّhsَbَf", "root": "بشر"}, {"id": 27, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 28, "arabic": "أَلِيمٍ", "translit": "ٍmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 35, "text": "يَوْمَ يُحْمَىٰ عَلَيْهَا فِى نَارِ جَهَنَّمَ فَتُكْوَىٰ بِهَا جِبَاهُهُمْ وَجُنُوبُهُمْ وَظُهُورُهُمْۖ هَٰذَا مَا كَنَزْتُمْ لِأَنفُسِكُمْ فَذُوقُوا۟ مَا كُنتُمْ تَكْنِزُونَ ", "translation": "The Day when it[1] will be heated in the fire of Hell and seared therewith will be their foreheads, their flanks, and their backs, [it will be said], \"This is what you hoarded for yourselves, so taste what you used to hoard.\"", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "يُحْمَىٰ", "translit": "ٰàَmْḥُy", "root": "حمي"}, {"id": 3, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "نَارِ", "translit": "ِrāَn", "root": "نور"}, {"id": 6, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 7, "arabic": "فَتُكْوَىٰ", "translit": "ٰàَwْkُtَf", "root": "كوي"}, {"id": 8, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 9, "arabic": "جِبَاهُهُمْ", "translit": "ْmُhُhāَbِjg", "root": "جبه"}, {"id": 10, "arabic": "وَجُنُوبُهُمْ", "translit": "ْmُhُbwُnُjgَw", "root": "جنب"}, {"id": 11, "arabic": "وَظُهُورُهُمْ", "translit": "ْmُhُrwُhُẓَw", "root": "ظهر"}, {"id": 12, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "كَنَزْتُمْ", "translit": "ْmُtْzَnَk", "root": "كنز"}, {"id": 15, "arabic": "لِأَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾِl", "root": "نفس"}, {"id": 16, "arabic": "فَذُوقُوا۟", "translit": "۟āwُqwُhdَf", "root": "ذوق"}, {"id": 17, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 18, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 19, "arabic": "تَكْنِزُونَ", "translit": "َnwُzِnْkَt", "root": "كنز"}], "hasIhya": true}, {"ayah": 36, "text": "إِنَّ عِدَّةَ ٱلشُّهُورِ عِندَ ٱللَّهِ ٱثْنَا عَشَرَ شَهْرًا فِى كِتَٰبِ ٱللَّهِ يَوْمَ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ مِنْهَآ أَرْبَعَةٌ حُرُمٌۚ ذَٰلِكَ ٱلدِّينُ ٱلْقَيِّمُۚ فَلَا تَظْلِمُوا۟ فِيهِنَّ أَنفُسَكُمْۚ وَقَٰتِلُوا۟ ٱلْمُشْرِكِينَ كَآفَّةً كَمَا يُقَٰتِلُونَكُمْ كَآفَّةًۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ مَعَ ٱلْمُتَّقِينَ ", "translation": "Indeed, the number of months with Allāh is twelve [lunar] months in the register of Allāh [from] the day He created the heavens and the earth; of these, four are sacred.[1] That is the correct religion [i.e., way], so do not wrong yourselves during them.[2] And fight against the disbelievers collectively as they fight against you collectively. And know that Allāh is with the righteous [who fear Him].", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "عِدَّةَ", "translit": "َẗَّdِʿع", "root": "عدد"}, {"id": 3, "arabic": "ٱلشُّهُورِ", "translit": "ِrwُhُّhslٱ", "root": "شهر"}, {"id": 4, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 5, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "ٱثْنَا", "translit": "āَnْhtٱ", "root": "ثني"}, {"id": 7, "arabic": "عَشَرَ", "translit": "َrَhsَʿع", "root": "عشر"}, {"id": 8, "arabic": "شَهْرًا", "translit": "āًrْhَhs", "root": "شهر"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "كِتَٰبِ", "translit": "ِbَٰtِk", "root": "كتب"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 13, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 14, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 15, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 16, "arabic": "مِنْهَآ", "translit": "ٓāَhْnِm", "root": ""}, {"id": 17, "arabic": "أَرْبَعَةٌ", "translit": "ٌẗَʿعَbْrَaʾ", "root": "ربع"}, {"id": 18, "arabic": "حُرُمٌ", "translit": "ٌmُrُḥ", "root": "حرم"}, {"id": 19, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 20, "arabic": "ٱلدِّينُ", "translit": "ُnyِّdlٱ", "root": "دين"}, {"id": 21, "arabic": "ٱلْقَيِّمُ", "translit": "ُmِّyَqْlٱ", "root": "قوم"}, {"id": 22, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 23, "arabic": "تَظْلِمُوا۟", "translit": "۟āwُmِlْẓَt", "root": "ظلم"}, {"id": 24, "arabic": "فِيهِنَّ", "translit": "َّnِhyِf", "root": ""}, {"id": 25, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 26, "arabic": "وَقَٰتِلُوا۟", "translit": "۟āwُlِtَٰqَw", "root": "قتل"}, {"id": 27, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}, {"id": 28, "arabic": "كَآفَّةً", "translit": "ًẗَّfٓāَk", "root": "كفف"}, {"id": 29, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 30, "arabic": "يُقَٰتِلُونَكُمْ", "translit": "ْmُkَnwُlِtَٰqُy", "root": "قتل"}, {"id": 31, "arabic": "كَآفَّةً", "translit": "ًẗَّfٓāَk", "root": "كفف"}, {"id": 32, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 33, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 34, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 35, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 36, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 37, "text": "إِنَّمَا ٱلنَّسِىٓءُ زِيَادَةٌ فِى ٱلْكُفْرِۖ يُضَلُّ بِهِ ٱلَّذِينَ كَفَرُوا۟ يُحِلُّونَهُۥ عَامًا وَيُحَرِّمُونَهُۥ عَامًا لِّيُوَاطِـُٔوا۟ عِدَّةَ مَا حَرَّمَ ٱللَّهُ فَيُحِلُّوا۟ مَا حَرَّمَ ٱللَّهُۚ زُيِّنَ لَهُمْ سُوٓءُ أَعْمَٰلِهِمْۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلْكَٰفِرِينَ ", "translation": "Indeed, the postponing [of restriction within sacred months] is an increase in disbelief by which those who have disbelieved are led [further] astray. They make it[1] lawful one year and unlawful another year to correspond to the number made unlawful by Allāh[2] and [thus] make lawful what Allāh has made unlawful. Made pleasing to them is the evil of their deeds; and Allāh does not guide the disbelieving people.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلنَّسِىٓءُ", "translit": "ُءٓàِsَّnlٱ", "root": "نسا"}, {"id": 3, "arabic": "زِيَادَةٌ", "translit": "ٌẗَdāَyِz", "root": "زيد"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْكُفْرِ", "translit": "ِrْfُkْlٱ", "root": "كفر"}, {"id": 6, "arabic": "يُضَلُّ", "translit": "ُّlَḍُy", "root": "ضلل"}, {"id": 7, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "يُحِلُّونَهُۥ", "translit": "ۥُhَnwُّlِḥُy", "root": "حلل"}, {"id": 11, "arabic": "عَامًا", "translit": "āًmāَʿع", "root": "عوم"}, {"id": 12, "arabic": "وَيُحَرِّمُونَهُۥ", "translit": "ۥُhَnwُmِّrَḥُyَw", "root": "حرم"}, {"id": 13, "arabic": "عَامًا", "translit": "āًmāَʿع", "root": "عوم"}, {"id": 14, "arabic": "لِّيُوَاطِـُٔوا۟", "translit": "۟āwُٔـِṭāَwُyِّl", "root": "وطا"}, {"id": 15, "arabic": "عِدَّةَ", "translit": "َẗَّdِʿع", "root": "عدد"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "فَيُحِلُّوا۟", "translit": "۟āwُّlِḥُyَf", "root": "حلل"}, {"id": 20, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 21, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 22, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "زُيِّنَ", "translit": "َnِّyُz", "root": "زين"}, {"id": 24, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 25, "arabic": "سُوٓءُ", "translit": "ُءٓwُs", "root": "سوا"}, {"id": 26, "arabic": "أَعْمَٰلِهِمْ", "translit": "ْmِhِlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 27, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 28, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 29, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 30, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 31, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 38, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ مَا لَكُمْ إِذَا قِيلَ لَكُمُ ٱنفِرُوا۟ فِى سَبِيلِ ٱللَّهِ ٱثَّاقَلْتُمْ إِلَى ٱلْأَرْضِۚ أَرَضِيتُم بِٱلْحَيَوٰةِ ٱلدُّنْيَا مِنَ ٱلْءَاخِرَةِۚ فَمَا مَتَٰعُ ٱلْحَيَوٰةِ ٱلدُّنْيَا فِى ٱلْءَاخِرَةِ إِلَّا قَلِيلٌ ", "translation": "O you who have believed, what is [the matter] with you that, when you are told to go forth in the cause of Allāh, you adhere heavily to the earth?[1] Are you satisfied with the life of this world rather than the Hereafter? But what is the enjoyment of worldly life compared to the Hereafter except a [very] little.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 5, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 6, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 7, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 8, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 9, "arabic": "ٱنفِرُوا۟", "translit": "۟āwُrِfnٱ", "root": "نفر"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "ٱثَّاقَلْتُمْ", "translit": "ْmُtْlَqāَّhtٱ", "root": "ثقل"}, {"id": 14, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 15, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 16, "arabic": "أَرَضِيتُم", "translit": "mُtyِḍَrَaʾ", "root": "رضو"}, {"id": 17, "arabic": "بِٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱِb", "root": "حيي"}, {"id": 18, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 19, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 20, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 21, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 22, "arabic": "مَتَٰعُ", "translit": "ُʿعَٰtَm", "root": "متع"}, {"id": 23, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 24, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 25, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 26, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 27, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 28, "arabic": "قَلِيلٌ", "translit": "ٌlyِlَq", "root": "قلل"}], "hasIhya": true}, {"ayah": 39, "text": "إِلَّا تَنفِرُوا۟ يُعَذِّبْكُمْ عَذَابًا أَلِيمًا وَيَسْتَبْدِلْ قَوْمًا غَيْرَكُمْ وَلَا تَضُرُّوهُ شَيْـًٔاۗ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "If you do not go forth, He will punish you with a painful punishment and will replace you with another people, and you will not harm Him at all. And Allāh is over all things competent.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "تَنفِرُوا۟", "translit": "۟āwُrِfnَt", "root": "نفر"}, {"id": 3, "arabic": "يُعَذِّبْكُمْ", "translit": "ْmُkْbِّhdَʿعُy", "root": "عذب"}, {"id": 4, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 5, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم"}, {"id": 6, "arabic": "وَيَسْتَبْدِلْ", "translit": "ْlِdْbَtْsَyَw", "root": "بدل"}, {"id": 7, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 8, "arabic": "غَيْرَكُمْ", "translit": "ْmُkَrْyَغ", "root": "غير"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "تَضُرُّوهُ", "translit": "ُhwُّrُḍَt", "root": "ضرر"}, {"id": 11, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 14, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 15, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 16, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 40, "text": "إِلَّا تَنصُرُوهُ فَقَدْ نَصَرَهُ ٱللَّهُ إِذْ أَخْرَجَهُ ٱلَّذِينَ كَفَرُوا۟ ثَانِىَ ٱثْنَيْنِ إِذْ هُمَا فِى ٱلْغَارِ إِذْ يَقُولُ لِصَٰحِبِهِۦ لَا تَحْزَنْ إِنَّ ٱللَّهَ مَعَنَاۖ فَأَنزَلَ ٱللَّهُ سَكِينَتَهُۥ عَلَيْهِ وَأَيَّدَهُۥ بِجُنُودٍ لَّمْ تَرَوْهَا وَجَعَلَ كَلِمَةَ ٱلَّذِينَ كَفَرُوا۟ ٱلسُّفْلَىٰۗ وَكَلِمَةُ ٱللَّهِ هِىَ ٱلْعُلْيَاۗ وَٱللَّهُ عَزِيزٌ حَكِيمٌ ", "translation": "If you do not aid him [i.e., the Prophet (ﷺ)] - Allāh has already aided him when those who disbelieved had driven him out [of Makkah] as one of two,[1] when they were in the cave and he [i.e., Muḥammad (ﷺ)] said to his companion, \"Do not grieve; indeed Allāh is with us.\" And Allāh sent down His tranquility upon him and supported him with soldiers [i.e., angels] you did not see and made the word[2] of those who disbelieved the lowest,[3] while the word of Allāh[4] - that is the highest. And Allāh is Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "تَنصُرُوهُ", "translit": "ُhwُrُṣnَt", "root": "نصر"}, {"id": 3, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 4, "arabic": "نَصَرَهُ", "translit": "ُhَrَṣَn", "root": "نصر"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 7, "arabic": "أَخْرَجَهُ", "translit": "ُhَjgَrْhkَaʾ", "root": "خرج"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "ثَانِىَ", "translit": "َàِnāَht", "root": "ثني"}, {"id": 11, "arabic": "ٱثْنَيْنِ", "translit": "ِnْyَnْhtٱ", "root": "ثني"}, {"id": 12, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 13, "arabic": "هُمَا", "translit": "āَmُh", "root": ""}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ٱلْغَارِ", "translit": "ِrāَغْlٱ", "root": "غور"}, {"id": 16, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 17, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 18, "arabic": "لِصَٰحِبِهِۦ", "translit": "ۦِhِbِḥَٰṣِl", "root": "صحب"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "تَحْزَنْ", "translit": "ْnَzْḥَt", "root": "حزن"}, {"id": 21, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "مَعَنَا", "translit": "āَnَʿعَm", "root": ""}, {"id": 24, "arabic": "فَأَنزَلَ", "translit": "َlَznَaʾَf", "root": "نزل"}, {"id": 25, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "سَكِينَتَهُۥ", "translit": "ۥُhَtَnyِkَs", "root": "سكن"}, {"id": 27, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 28, "arabic": "وَأَيَّدَهُۥ", "translit": "ۥُhَdَّyَaʾَw", "root": "ايد"}, {"id": 29, "arabic": "بِجُنُودٍ", "translit": "ٍdwُnُjgِb", "root": "جند"}, {"id": 30, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 31, "arabic": "تَرَوْهَا", "translit": "āَhْwَrَt", "root": "راي"}, {"id": 32, "arabic": "وَجَعَلَ", "translit": "َlَʿعَjgَw", "root": "جعل"}, {"id": 33, "arabic": "كَلِمَةَ", "translit": "َẗَmِlَk", "root": "كلم"}, {"id": 34, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 35, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 36, "arabic": "ٱلسُّفْلَىٰ", "translit": "ٰàَlْfُّslٱ", "root": "سفل"}, {"id": 37, "arabic": "وَكَلِمَةُ", "translit": "ُẗَmِlَkَw", "root": "كلم"}, {"id": 38, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 39, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 40, "arabic": "ٱلْعُلْيَا", "translit": "āَyْlُʿعْlٱ", "root": "علو"}, {"id": 41, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 42, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 43, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 41, "text": "ٱنفِرُوا۟ خِفَافًا وَثِقَالًا وَجَٰهِدُوا۟ بِأَمْوَٰلِكُمْ وَأَنفُسِكُمْ فِى سَبِيلِ ٱللَّهِۚ ذَٰلِكُمْ خَيْرٌ لَّكُمْ إِن كُنتُمْ تَعْلَمُونَ ", "translation": "Go forth, whether light or heavy,[1] and strive with your wealth and your lives in the cause of Allāh. That is better for you, if you only knew.", "words": [{"id": 1, "arabic": "ٱنفِرُوا۟", "translit": "۟āwُrِfnٱ", "root": "نفر"}, {"id": 2, "arabic": "خِفَافًا", "translit": "āًfāَfِhk", "root": "خفف"}, {"id": 3, "arabic": "وَثِقَالًا", "translit": "āًlāَqِhtَw", "root": "ثقل"}, {"id": 4, "arabic": "وَجَٰهِدُوا۟", "translit": "۟āwُdِhَٰjgَw", "root": "جهد"}, {"id": 5, "arabic": "بِأَمْوَٰلِكُمْ", "translit": "ْmُkِlَٰwْmَaʾِb", "root": "مول"}, {"id": 6, "arabic": "وَأَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾَw", "root": "نفس"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 11, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 12, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 15, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 42, "text": "لَوْ كَانَ عَرَضًا قَرِيبًا وَسَفَرًا قَاصِدًا لَّٱتَّبَعُوكَ وَلَٰكِنۢ بَعُدَتْ عَلَيْهِمُ ٱلشُّقَّةُۚ وَسَيَحْلِفُونَ بِٱللَّهِ لَوِ ٱسْتَطَعْنَا لَخَرَجْنَا مَعَكُمْ يُهْلِكُونَ أَنفُسَهُمْ وَٱللَّهُ يَعْلَمُ إِنَّهُمْ لَكَٰذِبُونَ ", "translation": "Had it been a near [i.e., easy] gain and a moderate trip, they [i.e., the hypocrites] would have followed you, but distant to them was the journey. And they will swear by Allāh,[1] \"If we were able, we would have gone forth with you,\" destroying themselves [through false oaths], and Allāh knows that indeed they are liars.", "words": [{"id": 1, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "عَرَضًا", "translit": "āًḍَrَʿع", "root": "عرض"}, {"id": 4, "arabic": "قَرِيبًا", "translit": "āًbyِrَq", "root": "قرب"}, {"id": 5, "arabic": "وَسَفَرًا", "translit": "āًrَfَsَw", "root": "سفر"}, {"id": 6, "arabic": "قَاصِدًا", "translit": "āًdِṣāَq", "root": "قصد"}, {"id": 7, "arabic": "لَّٱتَّبَعُوكَ", "translit": "َkwُʿعَbَّtٱَّl", "root": "تبع"}, {"id": 8, "arabic": "وَلَٰكِنۢ", "translit": "ۢnِkَٰlَw", "root": ""}, {"id": 9, "arabic": "بَعُدَتْ", "translit": "ْtَdُʿعَb", "root": "بعد"}, {"id": 10, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱلشُّقَّةُ", "translit": "ُẗَّqُّhslٱ", "root": "شقق"}, {"id": 12, "arabic": "وَسَيَحْلِفُونَ", "translit": "َnwُfِlْḥَyَsَw", "root": "حلف"}, {"id": 13, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 14, "arabic": "لَوِ", "translit": "ِwَl", "root": ""}, {"id": 15, "arabic": "ٱسْتَطَعْنَا", "translit": "āَnْʿعَṭَtْsٱ", "root": "طوع"}, {"id": 16, "arabic": "لَخَرَجْنَا", "translit": "āَnْjgَrَhkَl", "root": "خرج"}, {"id": 17, "arabic": "مَعَكُمْ", "translit": "ْmُkَʿعَm", "root": ""}, {"id": 18, "arabic": "يُهْلِكُونَ", "translit": "َnwُkِlْhُy", "root": "هلك"}, {"id": 19, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 20, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 21, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 22, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 23, "arabic": "لَكَٰذِبُونَ", "translit": "َnwُbِhdَٰkَl", "root": "كذب"}], "hasIhya": false}, {"ayah": 43, "text": "عَفَا ٱللَّهُ عَنكَ لِمَ أَذِنتَ لَهُمْ حَتَّىٰ يَتَبَيَّنَ لَكَ ٱلَّذِينَ صَدَقُوا۟ وَتَعْلَمَ ٱلْكَٰذِبِينَ ", "translation": "Allāh has pardoned you, [O Muḥammad, but] why did you give them permission [to remain behind]? [You should not have] until it was evident to you who were truthful and you knew [who were] the liars.", "words": [{"id": 1, "arabic": "عَفَا", "translit": "āَfَʿع", "root": "عفو"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "عَنكَ", "translit": "َknَʿع", "root": ""}, {"id": 4, "arabic": "لِمَ", "translit": "َmِl", "root": ""}, {"id": 5, "arabic": "أَذِنتَ", "translit": "َtnِhdَaʾ", "root": "اذن"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 8, "arabic": "يَتَبَيَّنَ", "translit": "َnَّyَbَtَy", "root": "بين"}, {"id": 9, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "صَدَقُوا۟", "translit": "۟āwُqَdَṣ", "root": "صدق"}, {"id": 12, "arabic": "وَتَعْلَمَ", "translit": "َmَlْʿعَtَw", "root": "علم"}, {"id": 13, "arabic": "ٱلْكَٰذِبِينَ", "translit": "َnyِbِhdَٰkْlٱ", "root": "كذب"}], "hasIhya": true}, {"ayah": 44, "text": "لَا يَسْتَـْٔذِنُكَ ٱلَّذِينَ يُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ أَن يُجَٰهِدُوا۟ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْۗ وَٱللَّهُ عَلِيمٌۢ بِٱلْمُتَّقِينَ ", "translation": "Those who believe in Allāh and the Last Day would not ask permission of you to be excused from striving [i.e., fighting] with their wealth and their lives. And Allāh is Knowing of those who fear Him.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَسْتَـْٔذِنُكَ", "translit": "َkُnِhdْٔـَtْsَy", "root": "اذن"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 7, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يُجَٰهِدُوا۟", "translit": "۟āwُdِhَٰjgُy", "root": "جهد"}, {"id": 10, "arabic": "بِأَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾِb", "root": "مول"}, {"id": 11, "arabic": "وَأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾَw", "root": "نفس"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 14, "arabic": "بِٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱِb", "root": "وقي"}], "hasIhya": false}, {"ayah": 45, "text": "إِنَّمَا يَسْتَـْٔذِنُكَ ٱلَّذِينَ لَا يُؤْمِنُونَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَٱرْتَابَتْ قُلُوبُهُمْ فَهُمْ فِى رَيْبِهِمْ يَتَرَدَّدُونَ ", "translation": "Only those would ask permission of you who do not believe in Allāh and the Last Day and whose hearts have doubted, and they, in their doubt, are hesitating.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَسْتَـْٔذِنُكَ", "translit": "َkُnِhdْٔـَtْsَy", "root": "اذن"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 6, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 7, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 8, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 9, "arabic": "وَٱرْتَابَتْ", "translit": "ْtَbāَtْrٱَw", "root": "ريب"}, {"id": 10, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 11, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "رَيْبِهِمْ", "translit": "ْmِhِbْyَr", "root": "ريب"}, {"id": 14, "arabic": "يَتَرَدَّدُونَ", "translit": "َnwُdَّdَrَtَy", "root": "ردد"}], "hasIhya": false}, {"ayah": 46, "text": "وَلَوْ أَرَادُوا۟ ٱلْخُرُوجَ لَأَعَدُّوا۟ لَهُۥ عُدَّةً وَلَٰكِن كَرِهَ ٱللَّهُ ٱنۢبِعَاثَهُمْ فَثَبَّطَهُمْ وَقِيلَ ٱقْعُدُوا۟ مَعَ ٱلْقَٰعِدِينَ ", "translation": "And if they had intended to go forth, they would have prepared for it [some] preparation. But Allāh disliked their being sent, so He kept them back, and they were told, \"Remain [behind] with those who remain.\"[1]", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَرَادُوا۟", "translit": "۟āwُdāَrَaʾ", "root": "رود"}, {"id": 3, "arabic": "ٱلْخُرُوجَ", "translit": "َjgwُrُhkْlٱ", "root": "خرج"}, {"id": 4, "arabic": "لَأَعَدُّوا۟", "translit": "۟āwُّdَʿعَaʾَl", "root": "عدد"}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "عُدَّةً", "translit": "ًẗَّdُʿع", "root": "عدد"}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 8, "arabic": "كَرِهَ", "translit": "َhِrَk", "root": "كره"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "ٱنۢبِعَاثَهُمْ", "translit": "ْmُhَhtāَʿعِbۢnٱ", "root": "بعث"}, {"id": 11, "arabic": "فَثَبَّطَهُمْ", "translit": "ْmُhَṭَّbَhtَf", "root": "ثبط"}, {"id": 12, "arabic": "وَقِيلَ", "translit": "َlyِqَw", "root": "قول"}, {"id": 13, "arabic": "ٱقْعُدُوا۟", "translit": "۟āwُdُʿعْqٱ", "root": "قعد"}, {"id": 14, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 15, "arabic": "ٱلْقَٰعِدِينَ", "translit": "َnyِdِʿعَٰqْlٱ", "root": "قعد"}], "hasIhya": false}, {"ayah": 47, "text": "لَوْ خَرَجُوا۟ فِيكُم مَّا زَادُوكُمْ إِلَّا خَبَالًا وَلَأَوْضَعُوا۟ خِلَٰلَكُمْ يَبْغُونَكُمُ ٱلْفِتْنَةَ وَفِيكُمْ سَمَّٰعُونَ لَهُمْۗ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّٰلِمِينَ ", "translation": "Had they gone forth with you, they would not have increased you except in confusion, and they would have been active among you, seeking [to cause] you fitnah [i.e., chaos and dissension]. And among you are avid listeners to them. And Allāh is Knowing of the wrongdoers.", "words": [{"id": 1, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 2, "arabic": "خَرَجُوا۟", "translit": "۟āwُjgَrَhk", "root": "خرج"}, {"id": 3, "arabic": "فِيكُم", "translit": "mُkyِf", "root": ""}, {"id": 4, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 5, "arabic": "زَادُوكُمْ", "translit": "ْmُkwُdāَz", "root": "زيد"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "خَبَالًا", "translit": "āًlāَbَhk", "root": "خبل"}, {"id": 8, "arabic": "وَلَأَوْضَعُوا۟", "translit": "۟āwُʿعَḍْwَaʾَlَw", "root": "وضع"}, {"id": 9, "arabic": "خِلَٰلَكُمْ", "translit": "ْmُkَlَٰlِhk", "root": "خلل"}, {"id": 10, "arabic": "يَبْغُونَكُمُ", "translit": "ُmُkَnwُغْbَy", "root": "بغي"}, {"id": 11, "arabic": "ٱلْفِتْنَةَ", "translit": "َẗَnْtِfْlٱ", "root": "فتن"}, {"id": 12, "arabic": "وَفِيكُمْ", "translit": "ْmُkyِfَw", "root": ""}, {"id": 13, "arabic": "سَمَّٰعُونَ", "translit": "َnwُʿعَّٰmَs", "root": "سمع"}, {"id": 14, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 15, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 16, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 17, "arabic": "بِٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱِb", "root": "ظلم"}], "hasIhya": false}, {"ayah": 48, "text": "لَقَدِ ٱبْتَغَوُا۟ ٱلْفِتْنَةَ مِن قَبْلُ وَقَلَّبُوا۟ لَكَ ٱلْأُمُورَ حَتَّىٰ جَآءَ ٱلْحَقُّ وَظَهَرَ أَمْرُ ٱللَّهِ وَهُمْ كَٰرِهُونَ ", "translation": "They had already desired dissension before and had upset matters for you[1] until the truth came and the ordinance [i.e., victory] of Allāh appeared, while they were averse.", "words": [{"id": 1, "arabic": "لَقَدِ", "translit": "ِdَqَl", "root": ""}, {"id": 2, "arabic": "ٱبْتَغَوُا۟", "translit": "۟āُwَغَtْbٱ", "root": "بغي"}, {"id": 3, "arabic": "ٱلْفِتْنَةَ", "translit": "َẗَnْtِfْlٱ", "root": "فتن"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 6, "arabic": "وَقَلَّبُوا۟", "translit": "۟āwُbَّlَqَw", "root": "قلب"}, {"id": 7, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 8, "arabic": "ٱلْأُمُورَ", "translit": "َrwُmُaʾْlٱ", "root": "امر"}, {"id": 9, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 10, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 11, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 12, "arabic": "وَظَهَرَ", "translit": "َrَhَẓَw", "root": "ظهر"}, {"id": 13, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 16, "arabic": "كَٰرِهُونَ", "translit": "َnwُhِrَٰk", "root": "كره"}], "hasIhya": false}, {"ayah": 49, "text": "وَمِنْهُم مَّن يَقُولُ ٱئْذَن لِّى وَلَا تَفْتِنِّىٓۚ أَلَا فِى ٱلْفِتْنَةِ سَقَطُوا۟ۗ وَإِنَّ جَهَنَّمَ لَمُحِيطَةٌۢ بِٱلْكَٰفِرِينَ ", "translation": "And among them is he who says, \"Permit me [to remain at home] and do not put me to trial.\" Unquestionably, into trial they have fallen.[1] And indeed, Hell will encompass the disbelievers.", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 4, "arabic": "ٱئْذَن", "translit": "nَhdْyʾٱ", "root": "اذن"}, {"id": 5, "arabic": "لِّى", "translit": "àِّl", "root": ""}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تَفْتِنِّىٓ", "translit": "ٓàِّnِtْfَt", "root": "فتن"}, {"id": 8, "arabic": "أَلَا", "translit": "āَlَaʾ", "root": ""}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْفِتْنَةِ", "translit": "ِẗَnْtِfْlٱ", "root": "فتن"}, {"id": 11, "arabic": "سَقَطُوا۟", "translit": "۟āwُṭَqَs", "root": "سقط"}, {"id": 12, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 13, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 14, "arabic": "لَمُحِيطَةٌۢ", "translit": "ٌۢẗَṭyِḥُmَl", "root": "حوط"}, {"id": 15, "arabic": "بِٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱِb", "root": "كفر"}], "hasIhya": false}, {"ayah": 50, "text": "إِن تُصِبْكَ حَسَنَةٌ تَسُؤْهُمْۖ وَإِن تُصِبْكَ مُصِيبَةٌ يَقُولُوا۟ قَدْ أَخَذْنَآ أَمْرَنَا مِن قَبْلُ وَيَتَوَلَّوا۟ وَّهُمْ فَرِحُونَ ", "translation": "If good befalls you, it distresses them; but if disaster strikes you, they say, \"We took our matter [in hand] before,\"[1] and turn away while they are rejoicing.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "تُصِبْكَ", "translit": "َkْbِṣُt", "root": "صوب"}, {"id": 3, "arabic": "حَسَنَةٌ", "translit": "ٌẗَnَsَḥ", "root": "حسن"}, {"id": 4, "arabic": "تَسُؤْهُمْ", "translit": "ْmُhْwʾُsَt", "root": "سوا"}, {"id": 5, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 6, "arabic": "تُصِبْكَ", "translit": "َkْbِṣُt", "root": "صوب"}, {"id": 7, "arabic": "مُصِيبَةٌ", "translit": "ٌẗَbyِṣُm", "root": "صوب"}, {"id": 8, "arabic": "يَقُولُوا۟", "translit": "۟āwُlwُqَy", "root": "قول"}, {"id": 9, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 10, "arabic": "أَخَذْنَآ", "translit": "ٓāَnْhdَhkَaʾ", "root": "اخذ"}, {"id": 11, "arabic": "أَمْرَنَا", "translit": "āَnَrْmَaʾ", "root": "امر"}, {"id": 12, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 13, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 14, "arabic": "وَيَتَوَلَّوا۟", "translit": "۟āwَّlَwَtَyَw", "root": "ولي"}, {"id": 15, "arabic": "وَّهُمْ", "translit": "ْmُhَّw", "root": ""}, {"id": 16, "arabic": "فَرِحُونَ", "translit": "َnwُḥِrَf", "root": "فرح"}], "hasIhya": false}, {"ayah": 51, "text": "قُل لَّن يُصِيبَنَآ إِلَّا مَا كَتَبَ ٱللَّهُ لَنَا هُوَ مَوْلَىٰنَاۚ وَعَلَى ٱللَّهِ فَلْيَتَوَكَّلِ ٱلْمُؤْمِنُونَ ", "translation": "Say, \"Never will we be struck except by what Allāh has decreed for us; He is our protector.\" And upon Allāh let the believers rely.", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 3, "arabic": "يُصِيبَنَآ", "translit": "ٓāَnَbyِṣُy", "root": "صوب"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "كَتَبَ", "translit": "َbَtَk", "root": "كتب"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 9, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 10, "arabic": "مَوْلَىٰنَا", "translit": "āَnٰàَlْwَm", "root": "ولي"}, {"id": 11, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "فَلْيَتَوَكَّلِ", "translit": "ِlَّkَwَtَyْlَf", "root": "وكل"}, {"id": 14, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": false}, {"ayah": 52, "text": "قُلْ هَلْ تَرَبَّصُونَ بِنَآ إِلَّآ إِحْدَى ٱلْحُسْنَيَيْنِۖ وَنَحْنُ نَتَرَبَّصُ بِكُمْ أَن يُصِيبَكُمُ ٱللَّهُ بِعَذَابٍ مِّنْ عِندِهِۦٓ أَوْ بِأَيْدِينَاۖ فَتَرَبَّصُوٓا۟ إِنَّا مَعَكُم مُّتَرَبِّصُونَ ", "translation": "Say, \"Do you await for us except one of the two best things [i.e., martyrdom or victory] while we await for you that Allāh will afflict you with punishment from Himself or at our hands? So wait; indeed we, along with you, are waiting.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 3, "arabic": "تَرَبَّصُونَ", "translit": "َnwُṣَّbَrَt", "root": "ربص"}, {"id": 4, "arabic": "بِنَآ", "translit": "ٓāَnِb", "root": ""}, {"id": 5, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 6, "arabic": "إِحْدَى", "translit": "àَdْḥِiʾ", "root": "احد"}, {"id": 7, "arabic": "ٱلْحُسْنَيَيْنِ", "translit": "ِnْyَyَnْsُḥْlٱ", "root": "حسن"}, {"id": 8, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 9, "arabic": "نَتَرَبَّصُ", "translit": "ُṣَّbَrَtَn", "root": "ربص"}, {"id": 10, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يُصِيبَكُمُ", "translit": "ُmُkَbyِṣُy", "root": "صوب"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "بِعَذَابٍ", "translit": "ٍbāَhdَʿعِb", "root": "عذب"}, {"id": 15, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 16, "arabic": "عِندِهِۦٓ", "translit": "ٓۦِhِdnِʿع", "root": "عند"}, {"id": 17, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 18, "arabic": "بِأَيْدِينَا", "translit": "āَnyِdْyَaʾِb", "root": "يدي"}, {"id": 19, "arabic": "فَتَرَبَّصُوٓا۟", "translit": "۟āٓwُṣَّbَrَtَf", "root": "ربص"}, {"id": 20, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 21, "arabic": "مَعَكُم", "translit": "mُkَʿعَm", "root": ""}, {"id": 22, "arabic": "مُّتَرَبِّصُونَ", "translit": "َnwُṣِّbَrَtُّm", "root": "ربص"}], "hasIhya": true}, {"ayah": 53, "text": "قُلْ أَنفِقُوا۟ طَوْعًا أَوْ كَرْهًا لَّن يُتَقَبَّلَ مِنكُمْۖ إِنَّكُمْ كُنتُمْ قَوْمًا فَٰسِقِينَ ", "translation": "Say, \"Spend willingly or unwillingly; never will it be accepted from you. Indeed, you have been a defiantly disobedient people.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَنفِقُوا۟", "translit": "۟āwُqِfnَaʾ", "root": "نفق"}, {"id": 3, "arabic": "طَوْعًا", "translit": "āًʿعْwَṭ", "root": "طوع"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "كَرْهًا", "translit": "āًhْrَk", "root": "كره"}, {"id": 6, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 7, "arabic": "يُتَقَبَّلَ", "translit": "َlَّbَqَtُy", "root": "قبل"}, {"id": 8, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 9, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 10, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 11, "arabic": "قَوْمًا", "translit": "āًmْwَq", "root": "قوم"}, {"id": 12, "arabic": "فَٰسِقِينَ", "translit": "َnyِqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 54, "text": "وَمَا مَنَعَهُمْ أَن تُقْبَلَ مِنْهُمْ نَفَقَٰتُهُمْ إِلَّآ أَنَّهُمْ كَفَرُوا۟ بِٱللَّهِ وَبِرَسُولِهِۦ وَلَا يَأْتُونَ ٱلصَّلَوٰةَ إِلَّا وَهُمْ كُسَالَىٰ وَلَا يُنفِقُونَ إِلَّا وَهُمْ كَٰرِهُونَ ", "translation": "And what prevents their expenditures from being accepted from them but that they have disbelieved in Allāh and in His Messenger and that they come not to prayer except while they are lazy and that they do not spend except while they are unwilling.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "مَنَعَهُمْ", "translit": "ْmُhَʿعَnَm", "root": "منع"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تُقْبَلَ", "translit": "َlَbْqُt", "root": "قبل"}, {"id": 5, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 6, "arabic": "نَفَقَٰتُهُمْ", "translit": "ْmُhُtَٰqَfَn", "root": "نفق"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 9, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 10, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 11, "arabic": "وَبِرَسُولِهِۦ", "translit": "ۦِhِlwُsَrِbَw", "root": "رسل"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "يَأْتُونَ", "translit": "َnwُtْaʾَy", "root": "اتي"}, {"id": 14, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 15, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 16, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 17, "arabic": "كُسَالَىٰ", "translit": "ٰàَlāَsُk", "root": "كسل"}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 22, "arabic": "كَٰرِهُونَ", "translit": "َnwُhِrَٰk", "root": "كره"}], "hasIhya": false}, {"ayah": 55, "text": "فَلَا تُعْجِبْكَ أَمْوَٰلُهُمْ وَلَآ أَوْلَٰدُهُمْۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُعَذِّبَهُم بِهَا فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَتَزْهَقَ أَنفُسُهُمْ وَهُمْ كَٰفِرُونَ ", "translation": "So let not their wealth or their children impress you. Allāh only intends to punish them through them in worldly life and that their souls should depart [at death] while they are disbelievers.", "words": [{"id": 1, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 2, "arabic": "تُعْجِبْكَ", "translit": "َkْbِjgْʿعُt", "root": "عجب"}, {"id": 3, "arabic": "أَمْوَٰلُهُمْ", "translit": "ْmُhُlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 5, "arabic": "أَوْلَٰدُهُمْ", "translit": "ْmُhُdَٰlْwَaʾ", "root": "ولد"}, {"id": 6, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 7, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "لِيُعَذِّبَهُم", "translit": "mُhَbِّhdَʿعُyِl", "root": "عذب"}, {"id": 10, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 13, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 14, "arabic": "وَتَزْهَقَ", "translit": "َqَhْzَtَw", "root": "زهق"}, {"id": 15, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 16, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 17, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 56, "text": "وَيَحْلِفُونَ بِٱللَّهِ إِنَّهُمْ لَمِنكُمْ وَمَا هُم مِّنكُمْ وَلَٰكِنَّهُمْ قَوْمٌ يَفْرَقُونَ ", "translation": "And they swear by Allāh that they are from among you while they are not from among you; but they are a people who are afraid.", "words": [{"id": 1, "arabic": "وَيَحْلِفُونَ", "translit": "َnwُfِlْḥَyَw", "root": "حلف"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 4, "arabic": "لَمِنكُمْ", "translit": "ْmُknِmَl", "root": ""}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 7, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 8, "arabic": "وَلَٰكِنَّهُمْ", "translit": "ْmُhَّnِkَٰlَw", "root": ""}, {"id": 9, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 10, "arabic": "يَفْرَقُونَ", "translit": "َnwُqَrْfَy", "root": "فرق"}], "hasIhya": false}, {"ayah": 57, "text": "لَوْ يَجِدُونَ مَلْجَـًٔا أَوْ مَغَٰرَٰتٍ أَوْ مُدَّخَلًا لَّوَلَّوْا۟ إِلَيْهِ وَهُمْ يَجْمَحُونَ ", "translation": "If they could find a refuge or some caves or any place to enter [and hide], they would turn to it while they run heedlessly.", "words": [{"id": 1, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 2, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد"}, {"id": 3, "arabic": "مَلْجَـًٔا", "translit": "āًٔـَjgْlَm", "root": "لجا"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "مَغَٰرَٰتٍ", "translit": "ٍtَٰrَٰغَm", "root": "غور"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "مُدَّخَلًا", "translit": "āًlَhkَّdُm", "root": "دخل"}, {"id": 8, "arabic": "لَّوَلَّوْا۟", "translit": "۟āْwَّlَwَّl", "root": "ولي"}, {"id": 9, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 11, "arabic": "يَجْمَحُونَ", "translit": "َnwُḥَmْjgَy", "root": "جمح"}], "hasIhya": false}, {"ayah": 58, "text": "وَمِنْهُم مَّن يَلْمِزُكَ فِى ٱلصَّدَقَٰتِ فَإِنْ أُعْطُوا۟ مِنْهَا رَضُوا۟ وَإِن لَّمْ يُعْطَوْا۟ مِنْهَآ إِذَا هُمْ يَسْخَطُونَ ", "translation": "And among them are some who criticize you concerning the [distribution of] charities. If they are given from them, they approve; but if they are not given from them, at once they become angry.", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "يَلْمِزُكَ", "translit": "َkُzِmْlَy", "root": "لمز"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلصَّدَقَٰتِ", "translit": "ِtَٰqَdَّṣlٱ", "root": "صدق"}, {"id": 6, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 7, "arabic": "أُعْطُوا۟", "translit": "۟āwُṭْʿعُaʾ", "root": "عطو"}, {"id": 8, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 9, "arabic": "رَضُوا۟", "translit": "۟āwُḍَr", "root": "رضو"}, {"id": 10, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 11, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 12, "arabic": "يُعْطَوْا۟", "translit": "۟āْwَṭْʿعُy", "root": "عطو"}, {"id": 13, "arabic": "مِنْهَآ", "translit": "ٓāَhْnِm", "root": ""}, {"id": 14, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 15, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 16, "arabic": "يَسْخَطُونَ", "translit": "َnwُṭَhkْsَy", "root": "سخط"}], "hasIhya": false}, {"ayah": 59, "text": "وَلَوْ أَنَّهُمْ رَضُوا۟ مَآ ءَاتَىٰهُمُ ٱللَّهُ وَرَسُولُهُۥ وَقَالُوا۟ حَسْبُنَا ٱللَّهُ سَيُؤْتِينَا ٱللَّهُ مِن فَضْلِهِۦ وَرَسُولُهُۥٓ إِنَّآ إِلَى ٱللَّهِ رَٰغِبُونَ ", "translation": "If only they had been satisfied with what Allāh and His Messenger gave them and said, \"Sufficient for us is Allāh; Allāh will give us of His bounty, and [so will] His Messenger; indeed, we are desirous toward Allāh,\"[1] [it would have been better for them].", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 3, "arabic": "رَضُوا۟", "translit": "۟āwُḍَr", "root": "رضو"}, {"id": 4, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 5, "arabic": "ءَاتَىٰهُمُ", "translit": "ُmُhٰàَtāَء", "root": "اتي"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 8, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 9, "arabic": "حَسْبُنَا", "translit": "āَnُbْsَḥ", "root": "حسب"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "سَيُؤْتِينَا", "translit": "āَnyِtْwʾُyَs", "root": "اتي"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 15, "arabic": "وَرَسُولُهُۥٓ", "translit": "ٓۥُhُlwُsَrَw", "root": "رسل"}, {"id": 16, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 17, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 18, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "رَٰغِبُونَ", "translit": "َnwُbِغَٰr", "root": "رغب"}], "hasIhya": false}, {"ayah": 60, "text": "إِنَّمَا ٱلصَّدَقَٰتُ لِلْفُقَرَآءِ وَٱلْمَسَٰكِينِ وَٱلْعَٰمِلِينَ عَلَيْهَا وَٱلْمُؤَلَّفَةِ قُلُوبُهُمْ وَفِى ٱلرِّقَابِ وَٱلْغَٰرِمِينَ وَفِى سَبِيلِ ٱللَّهِ وَٱبْنِ ٱلسَّبِيلِۖ فَرِيضَةً مِّنَ ٱللَّهِۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "Zakāh expenditures are only for the poor and for the needy and for those employed for it[1] and for bringing hearts together [for Islām] and for freeing captives [or slaves] and for those in debt and for the cause of Allāh and for the [stranded] traveler - an obligation [imposed] by Allāh. And Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلصَّدَقَٰتُ", "translit": "ُtَٰqَdَّṣlٱ", "root": "صدق"}, {"id": 3, "arabic": "لِلْفُقَرَآءِ", "translit": "ِءٓāَrَqُfْlِl", "root": "فقر"}, {"id": 4, "arabic": "وَٱلْمَسَٰكِينِ", "translit": "ِnyِkَٰsَmْlٱَw", "root": "سكن"}, {"id": 5, "arabic": "وَٱلْعَٰمِلِينَ", "translit": "َnyِlِmَٰʿعْlٱَw", "root": "عمل"}, {"id": 6, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "وَٱلْمُؤَلَّفَةِ", "translit": "ِẗَfَّlَwʾُmْlٱَw", "root": "الف"}, {"id": 8, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 9, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 10, "arabic": "ٱلرِّقَابِ", "translit": "ِbāَqِّrlٱ", "root": "رقب"}, {"id": 11, "arabic": "وَٱلْغَٰرِمِينَ", "translit": "َnyِmِrَٰغْlٱَw", "root": "غرم"}, {"id": 12, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 13, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَٱبْنِ", "translit": "ِnْbٱَw", "root": "بني"}, {"id": 16, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 17, "arabic": "فَرِيضَةً", "translit": "ًẗَḍyِrَf", "root": "فرض"}, {"id": 18, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 21, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 22, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 61, "text": "وَمِنْهُمُ ٱلَّذِينَ يُؤْذُونَ ٱلنَّبِىَّ وَيَقُولُونَ هُوَ أُذُنٌۚ قُلْ أُذُنُ خَيْرٍ لَّكُمْ يُؤْمِنُ بِٱللَّهِ وَيُؤْمِنُ لِلْمُؤْمِنِينَ وَرَحْمَةٌ لِّلَّذِينَ ءَامَنُوا۟ مِنكُمْۚ وَٱلَّذِينَ يُؤْذُونَ رَسُولَ ٱللَّهِ لَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "And among them are those who abuse the Prophet and say, \"He is an ear.\"[1] Say, \"[It is] an ear of goodness for you that believes in Allāh and believes the believers and [is] a mercy to those who believe among you.\" And those who abuse the Messenger of Allāh - for them is a painful punishment.", "words": [{"id": 1, "arabic": "وَمِنْهُمُ", "translit": "ُmُhْnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُؤْذُونَ", "translit": "َnwُhdْwʾُy", "root": "اذي"}, {"id": 4, "arabic": "ٱلنَّبِىَّ", "translit": "َّàِbَّnlٱ", "root": "نبا"}, {"id": 5, "arabic": "وَيَقُولُونَ", "translit": "َnwُlwُqَyَw", "root": "قول"}, {"id": 6, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 7, "arabic": "أُذُنٌ", "translit": "ٌnُhdُaʾ", "root": "اذن"}, {"id": 8, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 9, "arabic": "أُذُنُ", "translit": "ُnُhdُaʾ", "root": "اذن"}, {"id": 10, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 11, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 12, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 13, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 14, "arabic": "وَيُؤْمِنُ", "translit": "ُnِmْwʾُyَw", "root": "امن"}, {"id": 15, "arabic": "لِلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِl", "root": "امن"}, {"id": 16, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 17, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 18, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 19, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 20, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 21, "arabic": "يُؤْذُونَ", "translit": "َnwُhdْwʾُy", "root": "اذي"}, {"id": 22, "arabic": "رَسُولَ", "translit": "َlwُsَr", "root": "رسل"}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 25, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 26, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 62, "text": "يَحْلِفُونَ بِٱللَّهِ لَكُمْ لِيُرْضُوكُمْ وَٱللَّهُ وَرَسُولُهُۥٓ أَحَقُّ أَن يُرْضُوهُ إِن كَانُوا۟ مُؤْمِنِينَ ", "translation": "They swear by Allāh to you [Muslims] to satisfy you. But Allāh and His Messenger are more worthy for them to satisfy,[1] if they were to be believers.", "words": [{"id": 1, "arabic": "يَحْلِفُونَ", "translit": "َnwُfِlْḥَy", "root": "حلف"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "لِيُرْضُوكُمْ", "translit": "ْmُkwُḍْrُyِl", "root": "رضو"}, {"id": 5, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 6, "arabic": "وَرَسُولُهُۥٓ", "translit": "ٓۥُhُlwُsَrَw", "root": "رسل"}, {"id": 7, "arabic": "أَحَقُّ", "translit": "ُّqَḥَaʾ", "root": "حقق"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يُرْضُوهُ", "translit": "ُhwُḍْrُy", "root": "رضو"}, {"id": 10, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "مُؤْمِنِينَ", "translit": "َnyِnِmْwʾُm", "root": "امن"}], "hasIhya": false}, {"ayah": 63, "text": "أَلَمْ يَعْلَمُوٓا۟ أَنَّهُۥ مَن يُحَادِدِ ٱللَّهَ وَرَسُولَهُۥ فَأَنَّ لَهُۥ نَارَ جَهَنَّمَ خَٰلِدًا فِيهَاۚ ذَٰلِكَ ٱلْخِزْىُ ٱلْعَظِيمُ ", "translation": "Do they not know that whoever opposes Allāh and His Messenger - that for him is the fire of Hell, wherein he will abide eternally? That is the great disgrace.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 5, "arabic": "يُحَادِدِ", "translit": "ِdِdāَḥُy", "root": "حدد"}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 8, "arabic": "فَأَنَّ", "translit": "َّnَaʾَf", "root": ""}, {"id": 9, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 10, "arabic": "نَارَ", "translit": "َrāَn", "root": "نور"}, {"id": 11, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 12, "arabic": "خَٰلِدًا", "translit": "āًdِlَٰhk", "root": "خلد"}, {"id": 13, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 14, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 15, "arabic": "ٱلْخِزْىُ", "translit": "ُàْzِhkْlٱ", "root": "خزي"}, {"id": 16, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 64, "text": "يَحْذَرُ ٱلْمُنَٰفِقُونَ أَن تُنَزَّلَ عَلَيْهِمْ سُورَةٌ تُنَبِّئُهُم بِمَا فِى قُلُوبِهِمْۚ قُلِ ٱسْتَهْزِءُوٓا۟ إِنَّ ٱللَّهَ مُخْرِجٌ مَّا تَحْذَرُونَ ", "translation": "The hypocrites are apprehensive lest a sūrah be revealed about them, informing them of[1] what is in their hearts. Say, \"Mock [as you wish]; indeed, Allāh will expose that which you fear.\"", "words": [{"id": 1, "arabic": "يَحْذَرُ", "translit": "ُrَhdْḥَy", "root": "حذر"}, {"id": 2, "arabic": "ٱلْمُنَٰفِقُونَ", "translit": "َnwُqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تُنَزَّلَ", "translit": "َlَّzَnُt", "root": "نزل"}, {"id": 5, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "سُورَةٌ", "translit": "ٌẗَrwُs", "root": "سور"}, {"id": 7, "arabic": "تُنَبِّئُهُم", "translit": "mُhُyʾِّbَnُt", "root": "نبا"}, {"id": 8, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 11, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 12, "arabic": "ٱسْتَهْزِءُوٓا۟", "translit": "۟āٓwُءِzْhَtْsٱ", "root": "هزا"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "مُخْرِجٌ", "translit": "ٌjgِrْhkُm", "root": "خرج"}, {"id": 16, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 17, "arabic": "تَحْذَرُونَ", "translit": "َnwُrَhdْḥَt", "root": "حذر"}], "hasIhya": false}, {"ayah": 65, "text": "وَلَئِن سَأَلْتَهُمْ لَيَقُولُنَّ إِنَّمَا كُنَّا نَخُوضُ وَنَلْعَبُۚ قُلْ أَبِٱللَّهِ وَءَايَٰتِهِۦ وَرَسُولِهِۦ كُنتُمْ تَسْتَهْزِءُونَ ", "translation": "And if you ask them, they will surely say, \"We were only conversing and playing.\" Say, \"Is it Allāh and His verses and His Messenger that you were mocking?\"", "words": [{"id": 1, "arabic": "وَلَئِن", "translit": "nِyʾَlَw", "root": ""}, {"id": 2, "arabic": "سَأَلْتَهُمْ", "translit": "ْmُhَtْlَaʾَs", "root": "سال"}, {"id": 3, "arabic": "لَيَقُولُنَّ", "translit": "َّnُlwُqَyَl", "root": "قول"}, {"id": 4, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 5, "arabic": "كُنَّا", "translit": "āَّnُk", "root": "كون"}, {"id": 6, "arabic": "نَخُوضُ", "translit": "ُḍwُhkَn", "root": "خوض"}, {"id": 7, "arabic": "وَنَلْعَبُ", "translit": "ُbَʿعْlَnَw", "root": "لعب"}, {"id": 8, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 9, "arabic": "أَبِٱللَّهِ", "translit": "ِhَّllٱِbَaʾ", "root": "اله"}, {"id": 10, "arabic": "وَءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَءَw", "root": "ايي"}, {"id": 11, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "تَسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsَt", "root": "هزا"}], "hasIhya": false}, {"ayah": 66, "text": "لَا تَعْتَذِرُوا۟ قَدْ كَفَرْتُم بَعْدَ إِيمَٰنِكُمْۚ إِن نَّعْفُ عَن طَآئِفَةٍ مِّنكُمْ نُعَذِّبْ طَآئِفَةًۢ بِأَنَّهُمْ كَانُوا۟ مُجْرِمِينَ ", "translation": "Make no excuse; you have disbelieved [i.e., rejected faith] after your belief. If We pardon one faction of you - We will punish another faction because they were criminals.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "تَعْتَذِرُوا۟", "translit": "۟āwُrِhdَtْʿعَt", "root": "عذر"}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "كَفَرْتُم", "translit": "mُtْrَfَk", "root": "كفر"}, {"id": 5, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "إِيمَٰنِكُمْ", "translit": "ْmُkِnَٰmyِiʾ", "root": "امن"}, {"id": 7, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 8, "arabic": "نَّعْفُ", "translit": "ُfْʿعَّn", "root": "عفو"}, {"id": 9, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 10, "arabic": "طَآئِفَةٍ", "translit": "ٍẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 11, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 12, "arabic": "نُعَذِّبْ", "translit": "ْbِّhdَʿعُn", "root": "عذب"}, {"id": 13, "arabic": "طَآئِفَةًۢ", "translit": "ًۢẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 14, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 15, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 16, "arabic": "مُجْرِمِينَ", "translit": "َnyِmِrْjgُm", "root": "جرم"}], "hasIhya": false}, {"ayah": 67, "text": "ٱلْمُنَٰفِقُونَ وَٱلْمُنَٰفِقَٰتُ بَعْضُهُم مِّنۢ بَعْضٍۚ يَأْمُرُونَ بِٱلْمُنكَرِ وَيَنْهَوْنَ عَنِ ٱلْمَعْرُوفِ وَيَقْبِضُونَ أَيْدِيَهُمْۚ نَسُوا۟ ٱللَّهَ فَنَسِيَهُمْۗ إِنَّ ٱلْمُنَٰفِقِينَ هُمُ ٱلْفَٰسِقُونَ ", "translation": "The hypocrite men and hypocrite women are of one another. They enjoin what is wrong and forbid what is right and close their hands.[1] They have forgotten Allāh, so He has forgotten them [accordingly]. Indeed, the hypocrites - it is they who are the defiantly disobedient.", "words": [{"id": 1, "arabic": "ٱلْمُنَٰفِقُونَ", "translit": "َnwُqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 2, "arabic": "وَٱلْمُنَٰفِقَٰتُ", "translit": "ُtَٰqِfَٰnُmْlٱَw", "root": "نفق"}, {"id": 3, "arabic": "بَعْضُهُم", "translit": "mُhُḍْʿعَb", "root": "بعض"}, {"id": 4, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 5, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 6, "arabic": "يَأْمُرُونَ", "translit": "َnwُrُmْaʾَy", "root": "امر"}, {"id": 7, "arabic": "بِٱلْمُنكَرِ", "translit": "ِrَknُmْlٱِb", "root": "نكر"}, {"id": 8, "arabic": "وَيَنْهَوْنَ", "translit": "َnْwَhْnَyَw", "root": "نهي"}, {"id": 9, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 10, "arabic": "ٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱ", "root": "عرف"}, {"id": 11, "arabic": "وَيَقْبِضُونَ", "translit": "َnwُḍِbْqَyَw", "root": "قبض"}, {"id": 12, "arabic": "أَيْدِيَهُمْ", "translit": "ْmُhَyِdْyَaʾ", "root": "يدي"}, {"id": 13, "arabic": "نَسُوا۟", "translit": "۟āwُsَn", "root": "نسي"}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "فَنَسِيَهُمْ", "translit": "ْmُhَyِsَnَf", "root": "نسي"}, {"id": 16, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 17, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 18, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 19, "arabic": "ٱلْفَٰسِقُونَ", "translit": "َnwُqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 68, "text": "وَعَدَ ٱللَّهُ ٱلْمُنَٰفِقِينَ وَٱلْمُنَٰفِقَٰتِ وَٱلْكُفَّارَ نَارَ جَهَنَّمَ خَٰلِدِينَ فِيهَاۚ هِىَ حَسْبُهُمْۚ وَلَعَنَهُمُ ٱللَّهُۖ وَلَهُمْ عَذَابٌ مُّقِيمٌ ", "translation": "Allāh has promised the hypocrite men and hypocrite women and the disbelievers the fire of Hell, wherein they will abide eternally. It is sufficient for them. And Allāh has cursed them, and for them is an enduring punishment.", "words": [{"id": 1, "arabic": "وَعَدَ", "translit": "َdَʿعَw", "root": "وعد"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 4, "arabic": "وَٱلْمُنَٰفِقَٰتِ", "translit": "ِtَٰqِfَٰnُmْlٱَw", "root": "نفق"}, {"id": 5, "arabic": "وَٱلْكُفَّارَ", "translit": "َrāَّfُkْlٱَw", "root": "كفر"}, {"id": 6, "arabic": "نَارَ", "translit": "َrāَn", "root": "نور"}, {"id": 7, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 8, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 11, "arabic": "حَسْبُهُمْ", "translit": "ْmُhُbْsَḥ", "root": "حسب"}, {"id": 12, "arabic": "وَلَعَنَهُمُ", "translit": "ُmُhَnَʿعَlَw", "root": "لعن"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 15, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 16, "arabic": "مُّقِيمٌ", "translit": "ٌmyِqُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 69, "text": "كَٱلَّذِينَ مِن قَبْلِكُمْ كَانُوٓا۟ أَشَدَّ مِنكُمْ قُوَّةً وَأَكْثَرَ أَمْوَٰلًا وَأَوْلَٰدًا فَٱسْتَمْتَعُوا۟ بِخَلَٰقِهِمْ فَٱسْتَمْتَعْتُم بِخَلَٰقِكُمْ كَمَا ٱسْتَمْتَعَ ٱلَّذِينَ مِن قَبْلِكُم بِخَلَٰقِهِمْ وَخُضْتُمْ كَٱلَّذِى خَاضُوٓا۟ۚ أُو۟لَٰٓئِكَ حَبِطَتْ أَعْمَٰلُهُمْ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْخَٰسِرُونَ ", "translation": "[You disbelievers are] like those before you; they were stronger than you in power and more abundant in wealth and children. They enjoyed their portion [of worldly enjoyment], and you have enjoyed your portion as those before you enjoyed their portion, and you have engaged [in vanities] like that in which they engaged. [It is] those whose deeds have become worthless in this world and in the Hereafter, and it is they who are the losers.", "words": [{"id": 1, "arabic": "كَٱلَّذِينَ", "translit": "َnyِhdَّlٱَk", "root": ""}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 4, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 5, "arabic": "أَشَدَّ", "translit": "َّdَhsَaʾ", "root": "شدد"}, {"id": 6, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 7, "arabic": "قُوَّةً", "translit": "ًẗَّwُq", "root": "قوي"}, {"id": 8, "arabic": "وَأَكْثَرَ", "translit": "َrَhtْkَaʾَw", "root": "كثر"}, {"id": 9, "arabic": "أَمْوَٰلًا", "translit": "āًlَٰwْmَaʾ", "root": "مول"}, {"id": 10, "arabic": "وَأَوْلَٰدًا", "translit": "āًdَٰlْwَaʾَw", "root": "ولد"}, {"id": 11, "arabic": "فَٱسْتَمْتَعُوا۟", "translit": "۟āwُʿعَtْmَtْsٱَf", "root": "متع"}, {"id": 12, "arabic": "بِخَلَٰقِهِمْ", "translit": "ْmِhِqَٰlَhkِb", "root": "خلق"}, {"id": 13, "arabic": "فَٱسْتَمْتَعْتُم", "translit": "mُtْʿعَtْmَtْsٱَf", "root": "متع"}, {"id": 14, "arabic": "بِخَلَٰقِكُمْ", "translit": "ْmُkِqَٰlَhkِb", "root": "خلق"}, {"id": 15, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 16, "arabic": "ٱسْتَمْتَعَ", "translit": "َʿعَtْmَtْsٱ", "root": "متع"}, {"id": 17, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "قَبْلِكُم", "translit": "mُkِlْbَq", "root": "قبل"}, {"id": 20, "arabic": "بِخَلَٰقِهِمْ", "translit": "ْmِhِqَٰlَhkِb", "root": "خلق"}, {"id": 21, "arabic": "وَخُضْتُمْ", "translit": "ْmُtْḍُhkَw", "root": "خوض"}, {"id": 22, "arabic": "كَٱلَّذِى", "translit": "àِhdَّlٱَk", "root": ""}, {"id": 23, "arabic": "خَاضُوٓا۟", "translit": "۟āٓwُḍāَhk", "root": "خوض"}, {"id": 24, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 25, "arabic": "حَبِطَتْ", "translit": "ْtَṭِbَḥ", "root": "حبط"}, {"id": 26, "arabic": "أَعْمَٰلُهُمْ", "translit": "ْmُhُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 27, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 28, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 29, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 30, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 31, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 32, "arabic": "ٱلْخَٰسِرُونَ", "translit": "َnwُrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 70, "text": "أَلَمْ يَأْتِهِمْ نَبَأُ ٱلَّذِينَ مِن قَبْلِهِمْ قَوْمِ نُوحٍ وَعَادٍ وَثَمُودَ وَقَوْمِ إِبْرَٰهِيمَ وَأَصْحَٰبِ مَدْيَنَ وَٱلْمُؤْتَفِكَٰتِۚ أَتَتْهُمْ رُسُلُهُم بِٱلْبَيِّنَٰتِۖ فَمَا كَانَ ٱللَّهُ لِيَظْلِمَهُمْ وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ", "translation": "Has there not reached them the news of those before them - the people of Noah and [the tribes of] ʿAad and Thamūd and the people of Abraham and the companions [i.e., dwellers] of Madyan and the towns overturned?[1] Their messengers came to them with clear proofs. And Allāh would never have wronged them, but they were wronging themselves.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَأْتِهِمْ", "translit": "ْmِhِtْaʾَy", "root": "اتي"}, {"id": 3, "arabic": "نَبَأُ", "translit": "ُaʾَbَn", "root": "نبا"}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلِهِمْ", "translit": "ْmِhِlْbَq", "root": "قبل"}, {"id": 7, "arabic": "قَوْمِ", "translit": "ِmْwَq", "root": "قوم"}, {"id": 8, "arabic": "نُوحٍ", "translit": "ٍḥwُn", "root": ""}, {"id": 9, "arabic": "وَعَادٍ", "translit": "ٍdāَʿعَw", "root": "عود"}, {"id": 10, "arabic": "وَثَمُودَ", "translit": "َdwُmَhtَw", "root": ""}, {"id": 11, "arabic": "وَقَوْمِ", "translit": "ِmْwَqَw", "root": "قوم"}, {"id": 12, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 13, "arabic": "وَأَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾَw", "root": "صحب"}, {"id": 14, "arabic": "مَدْيَنَ", "translit": "َnَyْdَm", "root": "مدن"}, {"id": 15, "arabic": "وَٱلْمُؤْتَفِكَٰتِ", "translit": "ِtَٰkِfَtْwʾُmْlٱَw", "root": "افك"}, {"id": 16, "arabic": "أَتَتْهُمْ", "translit": "ْmُhْtَtَaʾ", "root": "اتي"}, {"id": 17, "arabic": "رُسُلُهُم", "translit": "mُhُlُsُr", "root": "رسل"}, {"id": 18, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 19, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 20, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "لِيَظْلِمَهُمْ", "translit": "ْmُhَmِlْẓَyِl", "root": "ظلم"}, {"id": 23, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 24, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 25, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 26, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": false}, {"ayah": 71, "text": "وَٱلْمُؤْمِنُونَ وَٱلْمُؤْمِنَٰتُ بَعْضُهُمْ أَوْلِيَآءُ بَعْضٍۚ يَأْمُرُونَ بِٱلْمَعْرُوفِ وَيَنْهَوْنَ عَنِ ٱلْمُنكَرِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَيُؤْتُونَ ٱلزَّكَوٰةَ وَيُطِيعُونَ ٱللَّهَ وَرَسُولَهُۥٓۚ أُو۟لَٰٓئِكَ سَيَرْحَمُهُمُ ٱللَّهُۗ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ ", "translation": "The believing men and believing women are allies of one another. They enjoin what is right and forbid what is wrong and establish prayer and give zakāh and obey Allāh and His Messenger. Those - Allāh will have mercy upon them. Indeed, Allāh is Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "وَٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 2, "arabic": "وَٱلْمُؤْمِنَٰتُ", "translit": "ُtَٰnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 3, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 4, "arabic": "أَوْلِيَآءُ", "translit": "ُءٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 5, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 6, "arabic": "يَأْمُرُونَ", "translit": "َnwُrُmْaʾَy", "root": "امر"}, {"id": 7, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 8, "arabic": "وَيَنْهَوْنَ", "translit": "َnْwَhْnَyَw", "root": "نهي"}, {"id": 9, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 10, "arabic": "ٱلْمُنكَرِ", "translit": "ِrَknُmْlٱ", "root": "نكر"}, {"id": 11, "arabic": "وَيُقِيمُونَ", "translit": "َnwُmyِqُyَw", "root": "قوم"}, {"id": 12, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 13, "arabic": "وَيُؤْتُونَ", "translit": "َnwُtْwʾُyَw", "root": "اتي"}, {"id": 14, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 15, "arabic": "وَيُطِيعُونَ", "translit": "َnwُʿعyِṭُyَw", "root": "طوع"}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَرَسُولَهُۥٓ", "translit": "ٓۥُhَlwُsَrَw", "root": "رسل"}, {"id": 18, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 19, "arabic": "سَيَرْحَمُهُمُ", "translit": "ُmُhُmَḥْrَyَs", "root": "رحم"}, {"id": 20, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 24, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 72, "text": "وَعَدَ ٱللَّهُ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَا وَمَسَٰكِنَ طَيِّبَةً فِى جَنَّٰتِ عَدْنٍۚ وَرِضْوَٰنٌ مِّنَ ٱللَّهِ أَكْبَرُۚ ذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ", "translation": "Allāh has promised the believing men and believing women gardens beneath which rivers flow, wherein they abide eternally, and pleasant dwellings in gardens of perpetual residence; but approval from Allāh is greater. It is that which is the great attainment.", "words": [{"id": 1, "arabic": "وَعَدَ", "translit": "َdَʿعَw", "root": "وعد"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 4, "arabic": "وَٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 5, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 6, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 9, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 10, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 11, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 12, "arabic": "وَمَسَٰكِنَ", "translit": "َnِkَٰsَmَw", "root": "سكن"}, {"id": 13, "arabic": "طَيِّبَةً", "translit": "ًẗَbِّyَṭ", "root": "طيب"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "جَنَّٰتِ", "translit": "ِtَّٰnَjg", "root": "جنن"}, {"id": 16, "arabic": "عَدْنٍ", "translit": "ٍnْdَʿع", "root": ""}, {"id": 17, "arabic": "وَرِضْوَٰنٌ", "translit": "ٌnَٰwْḍِrَw", "root": "رضو"}, {"id": 18, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 19, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 21, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 22, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 23, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 24, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": true}, {"ayah": 73, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ جَٰهِدِ ٱلْكُفَّارَ وَٱلْمُنَٰفِقِينَ وَٱغْلُظْ عَلَيْهِمْۚ وَمَأْوَىٰهُمْ جَهَنَّمُۖ وَبِئْسَ ٱلْمَصِيرُ ", "translation": "O Prophet, fight against the disbelievers and the hypocrites and be harsh upon them. And their refuge is Hell, and wretched is the destination.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "جَٰهِدِ", "translit": "ِdِhَٰjg", "root": "جهد"}, {"id": 4, "arabic": "ٱلْكُفَّارَ", "translit": "َrāَّfُkْlٱ", "root": "كفر"}, {"id": 5, "arabic": "وَٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱَw", "root": "نفق"}, {"id": 6, "arabic": "وَٱغْلُظْ", "translit": "ْẓُlْغٱَw", "root": "غلظ"}, {"id": 7, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَمَأْوَىٰهُمْ", "translit": "ْmُhٰàَwْaʾَmَw", "root": "اوي"}, {"id": 9, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 10, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 11, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 74, "text": "يَحْلِفُونَ بِٱللَّهِ مَا قَالُوا۟ وَلَقَدْ قَالُوا۟ كَلِمَةَ ٱلْكُفْرِ وَكَفَرُوا۟ بَعْدَ إِسْلَٰمِهِمْ وَهَمُّوا۟ بِمَا لَمْ يَنَالُوا۟ۚ وَمَا نَقَمُوٓا۟ إِلَّآ أَنْ أَغْنَىٰهُمُ ٱللَّهُ وَرَسُولُهُۥ مِن فَضْلِهِۦۚ فَإِن يَتُوبُوا۟ يَكُ خَيْرًا لَّهُمْۖ وَإِن يَتَوَلَّوْا۟ يُعَذِّبْهُمُ ٱللَّهُ عَذَابًا أَلِيمًا فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِۚ وَمَا لَهُمْ فِى ٱلْأَرْضِ مِن وَلِىٍّ وَلَا نَصِيرٍ ", "translation": "They swear by Allāh that they did not say [anything against the Prophet (ﷺ)] while they had said the word of disbelief and disbelieved after their [pretense of] Islām and planned that which they were not to attain.[1] And they were not resentful except [for the fact] that Allāh and His Messenger had enriched them of His bounty.[2] So if they repent, it is better for them; but if they turn away, Allāh will punish them with a painful punishment in this world and the Hereafter. And there will not be for them on earth any protector or helper.", "words": [{"id": 1, "arabic": "يَحْلِفُونَ", "translit": "َnwُfِlْḥَy", "root": "حلف"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 4, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 5, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 6, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 7, "arabic": "كَلِمَةَ", "translit": "َẗَmِlَk", "root": "كلم"}, {"id": 8, "arabic": "ٱلْكُفْرِ", "translit": "ِrْfُkْlٱ", "root": "كفر"}, {"id": 9, "arabic": "وَكَفَرُوا۟", "translit": "۟āwُrَfَkَw", "root": "كفر"}, {"id": 10, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 11, "arabic": "إِسْلَٰمِهِمْ", "translit": "ْmِhِmَٰlْsِiʾ", "root": "سلم"}, {"id": 12, "arabic": "وَهَمُّوا۟", "translit": "۟āwُّmَhَw", "root": "همم"}, {"id": 13, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 14, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 15, "arabic": "يَنَالُوا۟", "translit": "۟āwُlāَnَy", "root": "نيل"}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "نَقَمُوٓا۟", "translit": "۟āٓwُmَqَn", "root": "نقم"}, {"id": 18, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 19, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 20, "arabic": "أَغْنَىٰهُمُ", "translit": "ُmُhٰàَnْغَaʾ", "root": "غني"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 23, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 24, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 25, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 26, "arabic": "يَتُوبُوا۟", "translit": "۟āwُbwُtَy", "root": "توب"}, {"id": 27, "arabic": "يَكُ", "translit": "ُkَy", "root": "كون"}, {"id": 28, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 29, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 30, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 31, "arabic": "يَتَوَلَّوْا۟", "translit": "۟āْwَّlَwَtَy", "root": "ولي"}, {"id": 32, "arabic": "يُعَذِّبْهُمُ", "translit": "ُmُhْbِّhdَʿعُy", "root": "عذب"}, {"id": 33, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 34, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 35, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم"}, {"id": 36, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 37, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 38, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 39, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 40, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 41, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 42, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 43, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 44, "arabic": "وَلِىٍّ", "translit": "ٍّàِlَw", "root": "ولي"}, {"id": 45, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 46, "arabic": "نَصِيرٍ", "translit": "ٍryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 75, "text": "وَمِنْهُم مَّنْ عَٰهَدَ ٱللَّهَ لَئِنْ ءَاتَىٰنَا مِن فَضْلِهِۦ لَنَصَّدَّقَنَّ وَلَنَكُونَنَّ مِنَ ٱلصَّٰلِحِينَ ", "translation": "And among them are those who made a covenant with Allāh, [saying], \"If He should give us from His bounty, we will surely spend in charity, and we will surely be among the righteous.\"", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 2, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 3, "arabic": "عَٰهَدَ", "translit": "َdَhَٰʿع", "root": "عهد"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لَئِنْ", "translit": "ْnِyʾَl", "root": ""}, {"id": 6, "arabic": "ءَاتَىٰنَا", "translit": "āَnٰàَtāَء", "root": "اتي"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 9, "arabic": "لَنَصَّدَّقَنَّ", "translit": "َّnَqَّdَّṣَnَl", "root": "صدق"}, {"id": 10, "arabic": "وَلَنَكُونَنَّ", "translit": "َّnَnwُkَnَlَw", "root": "كون"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": true}, {"ayah": 76, "text": "فَلَمَّآ ءَاتَىٰهُم مِّن فَضْلِهِۦ بَخِلُوا۟ بِهِۦ وَتَوَلَّوا۟ وَّهُم مُّعْرِضُونَ ", "translation": "But when He gave them from His bounty, they were stingy with it and turned away while they refused.", "words": [{"id": 1, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 2, "arabic": "ءَاتَىٰهُم", "translit": "mُhٰàَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 5, "arabic": "بَخِلُوا۟", "translit": "۟āwُlِhkَb", "root": "بخل"}, {"id": 6, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 7, "arabic": "وَتَوَلَّوا۟", "translit": "۟āwَّlَwَtَw", "root": "ولي"}, {"id": 8, "arabic": "وَّهُم", "translit": "mُhَّw", "root": ""}, {"id": 9, "arabic": "مُّعْرِضُونَ", "translit": "َnwُḍِrْʿعُّm", "root": "عرض"}], "hasIhya": false}, {"ayah": 77, "text": "فَأَعْقَبَهُمْ نِفَاقًا فِى قُلُوبِهِمْ إِلَىٰ يَوْمِ يَلْقَوْنَهُۥ بِمَآ أَخْلَفُوا۟ ٱللَّهَ مَا وَعَدُوهُ وَبِمَا كَانُوا۟ يَكْذِبُونَ ", "translation": "So He penalized them with hypocrisy in their hearts until the Day they will meet Him - because they failed Allāh in what they promised Him and because they [habitually] used to lie.", "words": [{"id": 1, "arabic": "فَأَعْقَبَهُمْ", "translit": "ْmُhَbَqْʿعَaʾَf", "root": "عقب"}, {"id": 2, "arabic": "نِفَاقًا", "translit": "āًqāَfِn", "root": "نفق"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 5, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 6, "arabic": "يَوْمِ", "translit": "ِmْwَy", "root": "يوم"}, {"id": 7, "arabic": "يَلْقَوْنَهُۥ", "translit": "ۥُhَnْwَqْlَy", "root": "لقي"}, {"id": 8, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 9, "arabic": "أَخْلَفُوا۟", "translit": "۟āwُfَlْhkَaʾ", "root": "خلف"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "وَعَدُوهُ", "translit": "ُhwُdَʿعَw", "root": "وعد"}, {"id": 13, "arabic": "وَبِمَا", "translit": "āَmِbَw", "root": ""}, {"id": 14, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 15, "arabic": "يَكْذِبُونَ", "translit": "َnwُbِhdْkَy", "root": "كذب"}], "hasIhya": false}, {"ayah": 78, "text": "أَلَمْ يَعْلَمُوٓا۟ أَنَّ ٱللَّهَ يَعْلَمُ سِرَّهُمْ وَنَجْوَىٰهُمْ وَأَنَّ ٱللَّهَ عَلَّٰمُ ٱلْغُيُوبِ ", "translation": "Did they not know that Allāh knows their secrets and their private conversations and that Allāh is the Knower of the unseen?", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 6, "arabic": "سِرَّهُمْ", "translit": "ْmُhَّrِs", "root": "سرر"}, {"id": 7, "arabic": "وَنَجْوَىٰهُمْ", "translit": "ْmُhٰàَwْjgَnَw", "root": "نجو"}, {"id": 8, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "عَلَّٰمُ", "translit": "ُmَّٰlَʿع", "root": "علم"}, {"id": 11, "arabic": "ٱلْغُيُوبِ", "translit": "ِbwُyُغْlٱ", "root": "غيب"}], "hasIhya": false}, {"ayah": 79, "text": "ٱلَّذِينَ يَلْمِزُونَ ٱلْمُطَّوِّعِينَ مِنَ ٱلْمُؤْمِنِينَ فِى ٱلصَّدَقَٰتِ وَٱلَّذِينَ لَا يَجِدُونَ إِلَّا جُهْدَهُمْ فَيَسْخَرُونَ مِنْهُمْۙ سَخِرَ ٱللَّهُ مِنْهُمْ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "Those who criticize the contributors among the believers concerning [their] charities and [criticize] the ones who find nothing [to spend] except their effort, so they ridicule them - Allāh will ridicule them, and they will have a painful punishment.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَلْمِزُونَ", "translit": "َnwُzِmْlَy", "root": "لمز"}, {"id": 3, "arabic": "ٱلْمُطَّوِّعِينَ", "translit": "َnyِʿعِّwَّṭُmْlٱ", "root": "طوع"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلصَّدَقَٰتِ", "translit": "ِtَٰqَdَّṣlٱ", "root": "صدق"}, {"id": 8, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد"}, {"id": 11, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 12, "arabic": "جُهْدَهُمْ", "translit": "ْmُhَdْhُjg", "root": "جهد"}, {"id": 13, "arabic": "فَيَسْخَرُونَ", "translit": "َnwُrَhkْsَyَf", "root": "سخر"}, {"id": 14, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 15, "arabic": "سَخِرَ", "translit": "َrِhkَs", "root": "سخر"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 18, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 19, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 20, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 80, "text": "ٱسْتَغْفِرْ لَهُمْ أَوْ لَا تَسْتَغْفِرْ لَهُمْ إِن تَسْتَغْفِرْ لَهُمْ سَبْعِينَ مَرَّةً فَلَن يَغْفِرَ ٱللَّهُ لَهُمْۚ ذَٰلِكَ بِأَنَّهُمْ كَفَرُوا۟ بِٱللَّهِ وَرَسُولِهِۦۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلْفَٰسِقِينَ ", "translation": "Ask forgiveness for them, [O Muḥammad], or do not ask forgiveness for them. If you should ask forgiveness for them seventy times - never will Allāh forgive them. That is because they disbelieved in Allāh and His Messenger, and Allāh does not guide the defiantly disobedient people.", "words": [{"id": 1, "arabic": "ٱسْتَغْفِرْ", "translit": "ْrِfْغَtْsٱ", "root": "غفر"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَسْتَغْفِرْ", "translit": "ْrِfْغَtْsَt", "root": "غفر"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 8, "arabic": "تَسْتَغْفِرْ", "translit": "ْrِfْغَtْsَt", "root": "غفر"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "سَبْعِينَ", "translit": "َnyِʿعْbَs", "root": "سبع"}, {"id": 11, "arabic": "مَرَّةً", "translit": "ًẗَّrَm", "root": "مرر"}, {"id": 12, "arabic": "فَلَن", "translit": "nَlَf", "root": ""}, {"id": 13, "arabic": "يَغْفِرَ", "translit": "َrِfْغَy", "root": "غفر"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 16, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 17, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 18, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 19, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 20, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 23, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 24, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 25, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 81, "text": "فَرِحَ ٱلْمُخَلَّفُونَ بِمَقْعَدِهِمْ خِلَٰفَ رَسُولِ ٱللَّهِ وَكَرِهُوٓا۟ أَن يُجَٰهِدُوا۟ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْ فِى سَبِيلِ ٱللَّهِ وَقَالُوا۟ لَا تَنفِرُوا۟ فِى ٱلْحَرِّۗ قُلْ نَارُ جَهَنَّمَ أَشَدُّ حَرًّاۚ لَّوْ كَانُوا۟ يَفْقَهُونَ ", "translation": "Those who remained behind[1] rejoiced in their staying [at home] after [the departure of] the Messenger of Allāh and disliked to strive with their wealth and their lives in the cause of Allāh and said, \"Do not go forth in the heat.\" Say, \"The fire of Hell is more intense in heat\" - if they would but understand.", "words": [{"id": 1, "arabic": "فَرِحَ", "translit": "َḥِrَf", "root": "فرح"}, {"id": 2, "arabic": "ٱلْمُخَلَّفُونَ", "translit": "َnwُfَّlَhkُmْlٱ", "root": "خلف"}, {"id": 3, "arabic": "بِمَقْعَدِهِمْ", "translit": "ْmِhِdَʿعْqَmِb", "root": "قعد"}, {"id": 4, "arabic": "خِلَٰفَ", "translit": "َfَٰlِhk", "root": "خلف"}, {"id": 5, "arabic": "رَسُولِ", "translit": "ِlwُsَr", "root": "رسل"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "وَكَرِهُوٓا۟", "translit": "۟āٓwُhِrَkَw", "root": "كره"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يُجَٰهِدُوا۟", "translit": "۟āwُdِhَٰjgُy", "root": "جهد"}, {"id": 10, "arabic": "بِأَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾِb", "root": "مول"}, {"id": 11, "arabic": "وَأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾَw", "root": "نفس"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "تَنفِرُوا۟", "translit": "۟āwُrِfnَt", "root": "نفر"}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلْحَرِّ", "translit": "ِّrَḥْlٱ", "root": "حرر"}, {"id": 20, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 21, "arabic": "نَارُ", "translit": "ُrāَn", "root": "نور"}, {"id": 22, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 23, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 24, "arabic": "حَرًّا", "translit": "āًّrَḥ", "root": "حرر"}, {"id": 25, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 26, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 27, "arabic": "يَفْقَهُونَ", "translit": "َnwُhَqْfَy", "root": "فقه"}], "hasIhya": true}, {"ayah": 82, "text": "فَلْيَضْحَكُوا۟ قَلِيلًا وَلْيَبْكُوا۟ كَثِيرًا جَزَآءًۢ بِمَا كَانُوا۟ يَكْسِبُونَ ", "translation": "So let them laugh a little and [then] weep much as recompense for what they used to earn.", "words": [{"id": 1, "arabic": "فَلْيَضْحَكُوا۟", "translit": "۟āwُkَḥْḍَyْlَf", "root": "ضحك"}, {"id": 2, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 3, "arabic": "وَلْيَبْكُوا۟", "translit": "۟āwُkْbَyْlَw", "root": "بكي"}, {"id": 4, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 5, "arabic": "جَزَآءًۢ", "translit": "ًۢءٓāَzَjg", "root": "جزي"}, {"id": 6, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 7, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 8, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": true}, {"ayah": 83, "text": "فَإِن رَّجَعَكَ ٱللَّهُ إِلَىٰ طَآئِفَةٍ مِّنْهُمْ فَٱسْتَـْٔذَنُوكَ لِلْخُرُوجِ فَقُل لَّن تَخْرُجُوا۟ مَعِىَ أَبَدًا وَلَن تُقَٰتِلُوا۟ مَعِىَ عَدُوًّاۖ إِنَّكُمْ رَضِيتُم بِٱلْقُعُودِ أَوَّلَ مَرَّةٍ فَٱقْعُدُوا۟ مَعَ ٱلْخَٰلِفِينَ ", "translation": "If Allāh should return you to a faction of them [after the expedition] and then they ask your permission to go out [to battle], say, \"You will not go out with me, ever, and you will never fight with me an enemy. Indeed, you were satisfied with sitting [at home] the first time, so sit [now] with those who stay behind.\"", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "رَّجَعَكَ", "translit": "َkَʿعَjgَّr", "root": "رجع"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 5, "arabic": "طَآئِفَةٍ", "translit": "ٍẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 6, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 7, "arabic": "فَٱسْتَـْٔذَنُوكَ", "translit": "َkwُnَhdْٔـَtْsٱَf", "root": "اذن"}, {"id": 8, "arabic": "لِلْخُرُوجِ", "translit": "ِjgwُrُhkْlِl", "root": "خرج"}, {"id": 9, "arabic": "فَقُل", "translit": "lُqَf", "root": "قول"}, {"id": 10, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 11, "arabic": "تَخْرُجُوا۟", "translit": "۟āwُjgُrْhkَt", "root": "خرج"}, {"id": 12, "arabic": "مَعِىَ", "translit": "َàِʿعَm", "root": ""}, {"id": 13, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 14, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 15, "arabic": "تُقَٰتِلُوا۟", "translit": "۟āwُlِtَٰqُt", "root": "قتل"}, {"id": 16, "arabic": "مَعِىَ", "translit": "َàِʿعَm", "root": ""}, {"id": 17, "arabic": "عَدُوًّا", "translit": "āًّwُdَʿع", "root": "عدو"}, {"id": 18, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 19, "arabic": "رَضِيتُم", "translit": "mُtyِḍَr", "root": "رضو"}, {"id": 20, "arabic": "بِٱلْقُعُودِ", "translit": "ِdwُʿعُqْlٱِb", "root": "قعد"}, {"id": 21, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 22, "arabic": "مَرَّةٍ", "translit": "ٍẗَّrَm", "root": "مرر"}, {"id": 23, "arabic": "فَٱقْعُدُوا۟", "translit": "۟āwُdُʿعْqٱَf", "root": "قعد"}, {"id": 24, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 25, "arabic": "ٱلْخَٰلِفِينَ", "translit": "َnyِfِlَٰhkْlٱ", "root": "خلف"}], "hasIhya": false}, {"ayah": 84, "text": "وَلَا تُصَلِّ عَلَىٰٓ أَحَدٍ مِّنْهُم مَّاتَ أَبَدًا وَلَا تَقُمْ عَلَىٰ قَبْرِهِۦٓۖ إِنَّهُمْ كَفَرُوا۟ بِٱللَّهِ وَرَسُولِهِۦ وَمَاتُوا۟ وَهُمْ فَٰسِقُونَ ", "translation": "And do not pray [the funeral prayer, O Muḥammad], over any of them who has died - ever - or stand at his grave. Indeed, they disbelieved in Allāh and His Messenger and died while they were defiantly disobedient.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تُصَلِّ", "translit": "ِّlَṣُt", "root": "صلو"}, {"id": 3, "arabic": "عَلَىٰٓ", "translit": "ٰٓàَlَʿع", "root": ""}, {"id": 4, "arabic": "أَحَدٍ", "translit": "ٍdَḥَaʾ", "root": "احد"}, {"id": 5, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 6, "arabic": "مَّاتَ", "translit": "َtāَّm", "root": "موت"}, {"id": 7, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "تَقُمْ", "translit": "ْmُqَt", "root": "قوم"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "قَبْرِهِۦٓ", "translit": "ٓۦِhِrْbَq", "root": "قبر"}, {"id": 12, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 14, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 15, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 16, "arabic": "وَمَاتُوا۟", "translit": "۟āwُtāَmَw", "root": "موت"}, {"id": 17, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 18, "arabic": "فَٰسِقُونَ", "translit": "َnwُqِsَٰf", "root": "فسق"}], "hasIhya": false}, {"ayah": 85, "text": "وَلَا تُعْجِبْكَ أَمْوَٰلُهُمْ وَأَوْلَٰدُهُمْۚ إِنَّمَا يُرِيدُ ٱللَّهُ أَن يُعَذِّبَهُم بِهَا فِى ٱلدُّنْيَا وَتَزْهَقَ أَنفُسُهُمْ وَهُمْ كَٰفِرُونَ ", "translation": "And let not their wealth and their children impress you. Allāh only intends to punish them through them in this world and that their souls should depart [at death] while they are disbelievers.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تُعْجِبْكَ", "translit": "َkْbِjgْʿعُt", "root": "عجب"}, {"id": 3, "arabic": "أَمْوَٰلُهُمْ", "translit": "ْmُhُlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "وَأَوْلَٰدُهُمْ", "translit": "ْmُhُdَٰlْwَaʾَw", "root": "ولد"}, {"id": 5, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 6, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يُعَذِّبَهُم", "translit": "mُhَbِّhdَʿعُy", "root": "عذب"}, {"id": 10, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 11, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 12, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 13, "arabic": "وَتَزْهَقَ", "translit": "َqَhْzَtَw", "root": "زهق"}, {"id": 14, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 15, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 16, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 86, "text": "وَإِذَآ أُنزِلَتْ سُورَةٌ أَنْ ءَامِنُوا۟ بِٱللَّهِ وَجَٰهِدُوا۟ مَعَ رَسُولِهِ ٱسْتَـْٔذَنَكَ أُو۟لُوا۟ ٱلطَّوْلِ مِنْهُمْ وَقَالُوا۟ ذَرْنَا نَكُن مَّعَ ٱلْقَٰعِدِينَ ", "translation": "And when a sūrah was revealed [enjoining them] to believe in Allāh and to fight with His Messenger, those of wealth among them asked your permission [to stay back] and said, \"Leave us to be with them who sit [at home].\"", "words": [{"id": 1, "arabic": "وَإِذَآ", "translit": "ٓāَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أُنزِلَتْ", "translit": "ْtَlِznُaʾ", "root": "نزل"}, {"id": 3, "arabic": "سُورَةٌ", "translit": "ٌẗَrwُs", "root": "سور"}, {"id": 4, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 5, "arabic": "ءَامِنُوا۟", "translit": "۟āwُnِmāَء", "root": "امن"}, {"id": 6, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 7, "arabic": "وَجَٰهِدُوا۟", "translit": "۟āwُdِhَٰjgَw", "root": "جهد"}, {"id": 8, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 9, "arabic": "رَسُولِهِ", "translit": "ِhِlwُsَr", "root": "رسل"}, {"id": 10, "arabic": "ٱسْتَـْٔذَنَكَ", "translit": "َkَnَhdْٔـَtْsٱ", "root": "اذن"}, {"id": 11, "arabic": "أُو۟لُوا۟", "translit": "۟āwُl۟wُaʾ", "root": ""}, {"id": 12, "arabic": "ٱلطَّوْلِ", "translit": "ِlْwَّṭlٱ", "root": "طول"}, {"id": 13, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 14, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 15, "arabic": "ذَرْنَا", "translit": "āَnْrَhd", "root": "وذر"}, {"id": 16, "arabic": "نَكُن", "translit": "nُkَn", "root": "كون"}, {"id": 17, "arabic": "مَّعَ", "translit": "َʿعَّm", "root": ""}, {"id": 18, "arabic": "ٱلْقَٰعِدِينَ", "translit": "َnyِdِʿعَٰqْlٱ", "root": "قعد"}], "hasIhya": false}, {"ayah": 87, "text": "رَضُوا۟ بِأَن يَكُونُوا۟ مَعَ ٱلْخَوَالِفِ وَطُبِعَ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَفْقَهُونَ ", "translation": "They were satisfied to be with those who stay behind, and their hearts were sealed over, so they do not understand.", "words": [{"id": 1, "arabic": "رَضُوا۟", "translit": "۟āwُḍَr", "root": "رضو"}, {"id": 2, "arabic": "بِأَن", "translit": "nَaʾِb", "root": ""}, {"id": 3, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 4, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 5, "arabic": "ٱلْخَوَالِفِ", "translit": "ِfِlāَwَhkْlٱ", "root": "خلف"}, {"id": 6, "arabic": "وَطُبِعَ", "translit": "َʿعِbُṭَw", "root": "طبع"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 9, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يَفْقَهُونَ", "translit": "َnwُhَqْfَy", "root": "فقه"}], "hasIhya": true}, {"ayah": 88, "text": "لَٰكِنِ ٱلرَّسُولُ وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ جَٰهَدُوا۟ بِأَمْوَٰلِهِمْ وَأَنفُسِهِمْۚ وَأُو۟لَٰٓئِكَ لَهُمُ ٱلْخَيْرَٰتُۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ", "translation": "But the Messenger and those who believed with him fought with their wealth and their lives. Those will have [all that is] good and it is those who are the successful.", "words": [{"id": 1, "arabic": "لَٰكِنِ", "translit": "ِnِkَٰl", "root": ""}, {"id": 2, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 3, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 6, "arabic": "جَٰهَدُوا۟", "translit": "۟āwُdَhَٰjg", "root": "جهد"}, {"id": 7, "arabic": "بِأَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾِb", "root": "مول"}, {"id": 8, "arabic": "وَأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾَw", "root": "نفس"}, {"id": 9, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 10, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 11, "arabic": "ٱلْخَيْرَٰتُ", "translit": "ُtَٰrْyَhkْlٱ", "root": "خير"}, {"id": 12, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 13, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 14, "arabic": "ٱلْمُفْلِحُونَ", "translit": "َnwُḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": false}, {"ayah": 89, "text": "أَعَدَّ ٱللَّهُ لَهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَاۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ ", "translation": "Allāh has prepared for them gardens beneath which rivers flow, wherein they will abide eternally. That is the great attainment.", "words": [{"id": 1, "arabic": "أَعَدَّ", "translit": "َّdَʿعَaʾ", "root": "عدد"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 5, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 8, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 9, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 10, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 11, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 12, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 13, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 90, "text": "وَجَآءَ ٱلْمُعَذِّرُونَ مِنَ ٱلْأَعْرَابِ لِيُؤْذَنَ لَهُمْ وَقَعَدَ ٱلَّذِينَ كَذَبُوا۟ ٱللَّهَ وَرَسُولَهُۥۚ سَيُصِيبُ ٱلَّذِينَ كَفَرُوا۟ مِنْهُمْ عَذَابٌ أَلِيمٌ ", "translation": "And those with excuses among the bedouins came to be permitted [to remain], and they who had lied[1] to Allāh and His Messenger sat [at home]. There will strike those who disbelieved among them a painful punishment.", "words": [{"id": 1, "arabic": "وَجَآءَ", "translit": "َءٓāَjgَw", "root": "جيا"}, {"id": 2, "arabic": "ٱلْمُعَذِّرُونَ", "translit": "َnwُrِّhdَʿعُmْlٱ", "root": "عذر"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْأَعْرَابِ", "translit": "ِbāَrْʿعَaʾْlٱ", "root": "عرب"}, {"id": 5, "arabic": "لِيُؤْذَنَ", "translit": "َnَhdْwʾُyِl", "root": "اذن"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "وَقَعَدَ", "translit": "َdَʿعَqَw", "root": "قعد"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "كَذَبُوا۟", "translit": "۟āwُbَhdَk", "root": "كذب"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 12, "arabic": "سَيُصِيبُ", "translit": "ُbyِṣُyَs", "root": "صوب"}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 15, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 16, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 17, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": false}, {"ayah": 91, "text": "لَّيْسَ عَلَى ٱلضُّعَفَآءِ وَلَا عَلَى ٱلْمَرْضَىٰ وَلَا عَلَى ٱلَّذِينَ لَا يَجِدُونَ مَا يُنفِقُونَ حَرَجٌ إِذَا نَصَحُوا۟ لِلَّهِ وَرَسُولِهِۦۚ مَا عَلَى ٱلْمُحْسِنِينَ مِن سَبِيلٍۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "There is not upon the weak or upon the ill or upon those who do not find anything to spend any discomfort [i.e., guilt] when they are sincere to Allāh and His Messenger. There is not upon the doers of good any cause [for blame]. And Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "لَّيْسَ", "translit": "َsْyَّl", "root": "ليس"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلضُّعَفَآءِ", "translit": "ِءٓāَfَʿعُّḍlٱ", "root": "ضعف"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْمَرْضَىٰ", "translit": "ٰàَḍْrَmْlٱ", "root": "مرض"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 14, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج"}, {"id": 15, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 16, "arabic": "نَصَحُوا۟", "translit": "۟āwُḥَṣَn", "root": "نصح"}, {"id": 17, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 18, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 19, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 20, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 21, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}, {"id": 22, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 23, "arabic": "سَبِيلٍ", "translit": "ٍlyِbَs", "root": "سبل"}, {"id": 24, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 25, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 26, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 92, "text": "وَلَا عَلَى ٱلَّذِينَ إِذَا مَآ أَتَوْكَ لِتَحْمِلَهُمْ قُلْتَ لَآ أَجِدُ مَآ أَحْمِلُكُمْ عَلَيْهِ تَوَلَّوا۟ وَّأَعْيُنُهُمْ تَفِيضُ مِنَ ٱلدَّمْعِ حَزَنًا أَلَّا يَجِدُوا۟ مَا يُنفِقُونَ ", "translation": "Nor [is there blame] upon those who, when they came to you for you to take them along, you said, \"I can find nothing upon which to carry you.\"[1] They turned back while their eyes overflowed with tears out of grief that they could not find something to spend [for the cause of Allāh].", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 6, "arabic": "أَتَوْكَ", "translit": "َkْwَtَaʾ", "root": "اتي"}, {"id": 7, "arabic": "لِتَحْمِلَهُمْ", "translit": "ْmُhَlِmْḥَtِl", "root": "حمل"}, {"id": 8, "arabic": "قُلْتَ", "translit": "َtْlُq", "root": "قول"}, {"id": 9, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 10, "arabic": "أَجِدُ", "translit": "ُdِjgَaʾ", "root": "وجد"}, {"id": 11, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 12, "arabic": "أَحْمِلُكُمْ", "translit": "ْmُkُlِmْḥَaʾ", "root": "حمل"}, {"id": 13, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "تَوَلَّوا۟", "translit": "۟āwَّlَwَt", "root": "ولي"}, {"id": 15, "arabic": "وَّأَعْيُنُهُمْ", "translit": "ْmُhُnُyْʿعَaʾَّw", "root": "عين"}, {"id": 16, "arabic": "تَفِيضُ", "translit": "ُḍyِfَt", "root": "فيض"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلدَّمْعِ", "translit": "ِʿعْmَّdlٱ", "root": "دمع"}, {"id": 19, "arabic": "حَزَنًا", "translit": "āًnَzَḥ", "root": "حزن"}, {"id": 20, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 21, "arabic": "يَجِدُوا۟", "translit": "۟āwُdِjgَy", "root": "وجد"}, {"id": 22, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 23, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}], "hasIhya": false}, {"ayah": 93, "text": "إِنَّمَا ٱلسَّبِيلُ عَلَى ٱلَّذِينَ يَسْتَـْٔذِنُونَكَ وَهُمْ أَغْنِيَآءُۚ رَضُوا۟ بِأَن يَكُونُوا۟ مَعَ ٱلْخَوَالِفِ وَطَبَعَ ٱللَّهُ عَلَىٰ قُلُوبِهِمْ فَهُمْ لَا يَعْلَمُونَ ", "translation": "The cause [for blame] is only upon those who ask permission of you while they are rich. They are satisfied to be with those who stay behind, and Allāh has sealed over their hearts, so they do not know.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلسَّبِيلُ", "translit": "ُlyِbَّslٱ", "root": "سبل"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَسْتَـْٔذِنُونَكَ", "translit": "َkَnwُnِhdْٔـَtْsَy", "root": "اذن"}, {"id": 6, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 7, "arabic": "أَغْنِيَآءُ", "translit": "ُءٓāَyِnْغَaʾ", "root": "غني"}, {"id": 8, "arabic": "رَضُوا۟", "translit": "۟āwُḍَr", "root": "رضو"}, {"id": 9, "arabic": "بِأَن", "translit": "nَaʾِb", "root": ""}, {"id": 10, "arabic": "يَكُونُوا۟", "translit": "۟āwُnwُkَy", "root": "كون"}, {"id": 11, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 12, "arabic": "ٱلْخَوَالِفِ", "translit": "ِfِlāَwَhkْlٱ", "root": "خلف"}, {"id": 13, "arabic": "وَطَبَعَ", "translit": "َʿعَbَṭَw", "root": "طبع"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 16, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 17, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 94, "text": "يَعْتَذِرُونَ إِلَيْكُمْ إِذَا رَجَعْتُمْ إِلَيْهِمْۚ قُل لَّا تَعْتَذِرُوا۟ لَن نُّؤْمِنَ لَكُمْ قَدْ نَبَّأَنَا ٱللَّهُ مِنْ أَخْبَارِكُمْۚ وَسَيَرَى ٱللَّهُ عَمَلَكُمْ وَرَسُولُهُۥ ثُمَّ تُرَدُّونَ إِلَىٰ عَٰلِمِ ٱلْغَيْبِ وَٱلشَّهَٰدَةِ فَيُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "They will make excuses to you when you have returned to them. Say, \"Make no excuse - never will we believe you. Allāh has already informed us of your news [i.e., affair]. And Allāh will observe your deeds, and [so will] His Messenger; then you will be taken back to the Knower of the unseen and the witnessed,[1] and He will inform you of what you used to do.\"", "words": [{"id": 1, "arabic": "يَعْتَذِرُونَ", "translit": "َnwُrِhdَtْʿعَy", "root": "عذر"}, {"id": 2, "arabic": "إِلَيْكُمْ", "translit": "ْmُkْyَlِiʾ", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "رَجَعْتُمْ", "translit": "ْmُtْʿعَjgَr", "root": "رجع"}, {"id": 5, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 7, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 8, "arabic": "تَعْتَذِرُوا۟", "translit": "۟āwُrِhdَtْʿعَt", "root": "عذر"}, {"id": 9, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 10, "arabic": "نُّؤْمِنَ", "translit": "َnِmْwʾُّn", "root": "امن"}, {"id": 11, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 12, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 13, "arabic": "نَبَّأَنَا", "translit": "āَnَaʾَّbَn", "root": "نبا"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "أَخْبَارِكُمْ", "translit": "ْmُkِrāَbْhkَaʾ", "root": "خبر"}, {"id": 17, "arabic": "وَسَيَرَى", "translit": "àَrَyَsَw", "root": "راي"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "عَمَلَكُمْ", "translit": "ْmُkَlَmَʿع", "root": "عمل"}, {"id": 20, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 21, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 22, "arabic": "تُرَدُّونَ", "translit": "َnwُّdَrُt", "root": "ردد"}, {"id": 23, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 24, "arabic": "عَٰلِمِ", "translit": "ِmِlَٰʿع", "root": "علم"}, {"id": 25, "arabic": "ٱلْغَيْبِ", "translit": "ِbْyَغْlٱ", "root": "غيب"}, {"id": 26, "arabic": "وَٱلشَّهَٰدَةِ", "translit": "ِẗَdَٰhَّhslٱَw", "root": "شهد"}, {"id": 27, "arabic": "فَيُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُyَf", "root": "نبا"}, {"id": 28, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 29, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 30, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 95, "text": "سَيَحْلِفُونَ بِٱللَّهِ لَكُمْ إِذَا ٱنقَلَبْتُمْ إِلَيْهِمْ لِتُعْرِضُوا۟ عَنْهُمْۖ فَأَعْرِضُوا۟ عَنْهُمْۖ إِنَّهُمْ رِجْسٌۖ وَمَأْوَىٰهُمْ جَهَنَّمُ جَزَآءًۢ بِمَا كَانُوا۟ يَكْسِبُونَ ", "translation": "They will swear by Allāh to you when you return to them that you would leave them alone. So leave them alone; indeed they are evil; and their refuge is Hell as recompense for what they had been earning.", "words": [{"id": 1, "arabic": "سَيَحْلِفُونَ", "translit": "َnwُfِlْḥَyَs", "root": "حلف"}, {"id": 2, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 3, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "ٱنقَلَبْتُمْ", "translit": "ْmُtْbَlَqnٱ", "root": "قلب"}, {"id": 6, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "لِتُعْرِضُوا۟", "translit": "۟āwُḍِrْʿعُtِl", "root": "عرض"}, {"id": 8, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 9, "arabic": "فَأَعْرِضُوا۟", "translit": "۟āwُḍِrْʿعَaʾَf", "root": "عرض"}, {"id": 10, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 11, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 12, "arabic": "رِجْسٌ", "translit": "ٌsْjgِr", "root": "رجس"}, {"id": 13, "arabic": "وَمَأْوَىٰهُمْ", "translit": "ْmُhٰàَwْaʾَmَw", "root": "اوي"}, {"id": 14, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 15, "arabic": "جَزَآءًۢ", "translit": "ًۢءٓāَzَjg", "root": "جزي"}, {"id": 16, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَكْسِبُونَ", "translit": "َnwُbِsْkَy", "root": "كسب"}], "hasIhya": false}, {"ayah": 96, "text": "يَحْلِفُونَ لَكُمْ لِتَرْضَوْا۟ عَنْهُمْۖ فَإِن تَرْضَوْا۟ عَنْهُمْ فَإِنَّ ٱللَّهَ لَا يَرْضَىٰ عَنِ ٱلْقَوْمِ ٱلْفَٰسِقِينَ ", "translation": "They swear to you so that you might be satisfied with them. But if you should be satisfied with them - indeed, Allāh is not satisfied with a defiantly disobedient people.", "words": [{"id": 1, "arabic": "يَحْلِفُونَ", "translit": "َnwُfِlْḥَy", "root": "حلف"}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "لِتَرْضَوْا۟", "translit": "۟āْwَḍْrَtِl", "root": "رضو"}, {"id": 4, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 5, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 6, "arabic": "تَرْضَوْا۟", "translit": "۟āْwَḍْrَt", "root": "رضو"}, {"id": 7, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 8, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يَرْضَىٰ", "translit": "ٰàَḍْrَy", "root": "رضو"}, {"id": 12, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 13, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 14, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": true}, {"ayah": 97, "text": "ٱلْأَعْرَابُ أَشَدُّ كُفْرًا وَنِفَاقًا وَأَجْدَرُ أَلَّا يَعْلَمُوا۟ حُدُودَ مَآ أَنزَلَ ٱللَّهُ عَلَىٰ رَسُولِهِۦۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "The bedouins are stronger in disbelief and hypocrisy and more likely not to know the limits of what [laws] Allāh has revealed to His Messenger. And Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "ٱلْأَعْرَابُ", "translit": "ُbāَrْʿعَaʾْlٱ", "root": "عرب"}, {"id": 2, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 3, "arabic": "كُفْرًا", "translit": "āًrْfُk", "root": "كفر"}, {"id": 4, "arabic": "وَنِفَاقًا", "translit": "āًqāَfِnَw", "root": "نفق"}, {"id": 5, "arabic": "وَأَجْدَرُ", "translit": "ُrَdْjgَaʾَw", "root": "جدر"}, {"id": 6, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 7, "arabic": "يَعْلَمُوا۟", "translit": "۟āwُmَlْʿعَy", "root": "علم"}, {"id": 8, "arabic": "حُدُودَ", "translit": "َdwُdُḥ", "root": "حدد"}, {"id": 9, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 10, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 13, "arabic": "رَسُولِهِۦ", "translit": "ۦِhِlwُsَr", "root": "رسل"}, {"id": 14, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 15, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 16, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 98, "text": "وَمِنَ ٱلْأَعْرَابِ مَن يَتَّخِذُ مَا يُنفِقُ مَغْرَمًا وَيَتَرَبَّصُ بِكُمُ ٱلدَّوَآئِرَۚ عَلَيْهِمْ دَآئِرَةُ ٱلسَّوْءِۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ ", "translation": "And among the bedouins are some who consider what they spend as a loss[1] and await for you turns of misfortune. Upon them will be a misfortune of evil. And Allāh is Hearing and Knowing.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلْأَعْرَابِ", "translit": "ِbāَrْʿعَaʾْlٱ", "root": "عرب"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَتَّخِذُ", "translit": "ُhdِhkَّtَy", "root": "اخذ"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "يُنفِقُ", "translit": "ُqِfnُy", "root": "نفق"}, {"id": 7, "arabic": "مَغْرَمًا", "translit": "āًmَrْغَm", "root": "غرم"}, {"id": 8, "arabic": "وَيَتَرَبَّصُ", "translit": "ُṣَّbَrَtَyَw", "root": "ربص"}, {"id": 9, "arabic": "بِكُمُ", "translit": "ُmُkِb", "root": ""}, {"id": 10, "arabic": "ٱلدَّوَآئِرَ", "translit": "َrِyʾٓāَwَّdlٱ", "root": "دور"}, {"id": 11, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "دَآئِرَةُ", "translit": "ُẗَrِyʾٓāَd", "root": "دور"}, {"id": 13, "arabic": "ٱلسَّوْءِ", "translit": "ِءْwَّslٱ", "root": "سوا"}, {"id": 14, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 15, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 16, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 99, "text": "وَمِنَ ٱلْأَعْرَابِ مَن يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَيَتَّخِذُ مَا يُنفِقُ قُرُبَٰتٍ عِندَ ٱللَّهِ وَصَلَوَٰتِ ٱلرَّسُولِۚ أَلَآ إِنَّهَا قُرْبَةٌ لَّهُمْۚ سَيُدْخِلُهُمُ ٱللَّهُ فِى رَحْمَتِهِۦٓۗ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "But among the bedouins are some who believe in Allāh and the Last Day and consider what they spend as means of nearness to Allāh and of [obtaining] invocations of the Messenger. Unquestionably, it is a means of nearness for them. Allāh will admit them to His mercy. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلْأَعْرَابِ", "translit": "ِbāَrْʿعَaʾْlٱ", "root": "عرب"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 7, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "وَيَتَّخِذُ", "translit": "ُhdِhkَّtَyَw", "root": "اخذ"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "يُنفِقُ", "translit": "ُqِfnُy", "root": "نفق"}, {"id": 11, "arabic": "قُرُبَٰتٍ", "translit": "ٍtَٰbُrُq", "root": "قرب"}, {"id": 12, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَصَلَوَٰتِ", "translit": "ِtَٰwَlَṣَw", "root": "صلو"}, {"id": 15, "arabic": "ٱلرَّسُولِ", "translit": "ِlwُsَّrlٱ", "root": "رسل"}, {"id": 16, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 17, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 18, "arabic": "قُرْبَةٌ", "translit": "ٌẗَbْrُq", "root": "قرب"}, {"id": 19, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 20, "arabic": "سَيُدْخِلُهُمُ", "translit": "ُmُhُlِhkْdُyَs", "root": "دخل"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 23, "arabic": "رَحْمَتِهِۦٓ", "translit": "ٓۦِhِtَmْḥَr", "root": "رحم"}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 27, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 100, "text": "وَٱلسَّٰبِقُونَ ٱلْأَوَّلُونَ مِنَ ٱلْمُهَٰجِرِينَ وَٱلْأَنصَارِ وَٱلَّذِينَ ٱتَّبَعُوهُم بِإِحْسَٰنٍ رَّضِىَ ٱللَّهُ عَنْهُمْ وَرَضُوا۟ عَنْهُ وَأَعَدَّ لَهُمْ جَنَّٰتٍ تَجْرِى تَحْتَهَا ٱلْأَنْهَٰرُ خَٰلِدِينَ فِيهَآ أَبَدًاۚ ذَٰلِكَ ٱلْفَوْزُ ٱلْعَظِيمُ ", "translation": "And the first forerunners [in the faith] among the Muhājireen[1] and the Anṣār[2] and those who followed them with good conduct - Allāh is pleased with them and they are pleased with Him, and He has prepared for them gardens beneath which rivers flow, wherein they will abide forever. That is the great attainment.", "words": [{"id": 1, "arabic": "وَٱلسَّٰبِقُونَ", "translit": "َnwُqِbَّٰslٱَw", "root": "سبق"}, {"id": 2, "arabic": "ٱلْأَوَّلُونَ", "translit": "َnwُlَّwَaʾْlٱ", "root": "اول"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلْمُهَٰجِرِينَ", "translit": "َnyِrِjgَٰhُmْlٱ", "root": "هجر"}, {"id": 5, "arabic": "وَٱلْأَنصَارِ", "translit": "ِrāَṣnَaʾْlٱَw", "root": "نصر"}, {"id": 6, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 7, "arabic": "ٱتَّبَعُوهُم", "translit": "mُhwُʿعَbَّtٱ", "root": "تبع"}, {"id": 8, "arabic": "بِإِحْسَٰنٍ", "translit": "ٍnَٰsْḥِiʾِb", "root": "حسن"}, {"id": 9, "arabic": "رَّضِىَ", "translit": "َàِḍَّr", "root": "رضو"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "عَنْهُمْ", "translit": "ْmُhْnَʿع", "root": ""}, {"id": 12, "arabic": "وَرَضُوا۟", "translit": "۟āwُḍَrَw", "root": "رضو"}, {"id": 13, "arabic": "عَنْهُ", "translit": "ُhْnَʿع", "root": ""}, {"id": 14, "arabic": "وَأَعَدَّ", "translit": "َّdَʿعَaʾَw", "root": "عدد"}, {"id": 15, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 16, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 17, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 18, "arabic": "تَحْتَهَا", "translit": "āَhَtْḥَt", "root": "تحت"}, {"id": 19, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 20, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 21, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 22, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 23, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 24, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 25, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": true}, {"ayah": 101, "text": "وَمِمَّنْ حَوْلَكُم مِّنَ ٱلْأَعْرَابِ مُنَٰفِقُونَۖ وَمِنْ أَهْلِ ٱلْمَدِينَةِۖ مَرَدُوا۟ عَلَى ٱلنِّفَاقِ لَا تَعْلَمُهُمْۖ نَحْنُ نَعْلَمُهُمْۚ سَنُعَذِّبُهُم مَّرَّتَيْنِ ثُمَّ يُرَدُّونَ إِلَىٰ عَذَابٍ عَظِيمٍ ", "translation": "And among those around you of the bedouins are hypocrites, and [also] from the people of Madīnah. They have persisted in hypocrisy. You, [O Muḥammad], do not know them, [but] We know them. We will punish them twice [in this world]; then they will be returned to a great punishment.", "words": [{"id": 1, "arabic": "وَمِمَّنْ", "translit": "ْnَّmِmَw", "root": ""}, {"id": 2, "arabic": "حَوْلَكُم", "translit": "mُkَlْwَḥ", "root": "حول"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْأَعْرَابِ", "translit": "ِbāَrْʿعَaʾْlٱ", "root": "عرب"}, {"id": 5, "arabic": "مُنَٰفِقُونَ", "translit": "َnwُqِfَٰnُm", "root": "نفق"}, {"id": 6, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 7, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 8, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 9, "arabic": "مَرَدُوا۟", "translit": "۟āwُdَrَm", "root": "مرد"}, {"id": 10, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱلنِّفَاقِ", "translit": "ِqāَfِّnlٱ", "root": "نفق"}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "تَعْلَمُهُمْ", "translit": "ْmُhُmَlْʿعَt", "root": "علم"}, {"id": 14, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 15, "arabic": "نَعْلَمُهُمْ", "translit": "ْmُhُmَlْʿعَn", "root": "علم"}, {"id": 16, "arabic": "سَنُعَذِّبُهُم", "translit": "mُhُbِّhdَʿعُnَs", "root": "عذب"}, {"id": 17, "arabic": "مَّرَّتَيْنِ", "translit": "ِnْyَtَّrَّm", "root": "مرر"}, {"id": 18, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 19, "arabic": "يُرَدُّونَ", "translit": "َnwُّdَrُy", "root": "ردد"}, {"id": 20, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 21, "arabic": "عَذَابٍ", "translit": "ٍbāَhdَʿع", "root": "عذب"}, {"id": 22, "arabic": "عَظِيمٍ", "translit": "ٍmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 102, "text": "وَءَاخَرُونَ ٱعْتَرَفُوا۟ بِذُنُوبِهِمْ خَلَطُوا۟ عَمَلًا صَٰلِحًا وَءَاخَرَ سَيِّئًا عَسَى ٱللَّهُ أَن يَتُوبَ عَلَيْهِمْۚ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "And [there are] others who have acknowledged their sins. They had mixed [i.e., polluted] a righteous deed with another that was bad.[1] Perhaps Allāh will turn to them in forgiveness. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "وَءَاخَرُونَ", "translit": "َnwُrَhkāَءَw", "root": "اخر"}, {"id": 2, "arabic": "ٱعْتَرَفُوا۟", "translit": "۟āwُfَrَtْʿعٱ", "root": "عرف"}, {"id": 3, "arabic": "بِذُنُوبِهِمْ", "translit": "ْmِhِbwُnُhdِb", "root": "ذنب"}, {"id": 4, "arabic": "خَلَطُوا۟", "translit": "۟āwُṭَlَhk", "root": "خلط"}, {"id": 5, "arabic": "عَمَلًا", "translit": "āًlَmَʿع", "root": "عمل"}, {"id": 6, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 7, "arabic": "وَءَاخَرَ", "translit": "َrَhkāَءَw", "root": "اخر"}, {"id": 8, "arabic": "سَيِّئًا", "translit": "āًyʾِّyَs", "root": "سوا"}, {"id": 9, "arabic": "عَسَى", "translit": "àَsَʿع", "root": "عسي"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَتُوبَ", "translit": "َbwُtَy", "root": "توب"}, {"id": 13, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 17, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 103, "text": "خُذْ مِنْ أَمْوَٰلِهِمْ صَدَقَةً تُطَهِّرُهُمْ وَتُزَكِّيهِم بِهَا وَصَلِّ عَلَيْهِمْۖ إِنَّ صَلَوٰتَكَ سَكَنٌ لَّهُمْۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ ", "translation": "Take, [O Muḥammad], from their wealth a charity by which you purify them and cause them increase, and invoke [Allāh's blessings] upon them. Indeed, your invocations are reassurance for them. And Allāh is Hearing and Knowing.", "words": [{"id": 1, "arabic": "خُذْ", "translit": "ْhdُhk", "root": "اخذ"}, {"id": 2, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 3, "arabic": "أَمْوَٰلِهِمْ", "translit": "ْmِhِlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "صَدَقَةً", "translit": "ًẗَqَdَṣ", "root": "صدق"}, {"id": 5, "arabic": "تُطَهِّرُهُمْ", "translit": "ْmُhُrِّhَṭُt", "root": "طهر"}, {"id": 6, "arabic": "وَتُزَكِّيهِم", "translit": "mِhyِّkَzُtَw", "root": "زكو"}, {"id": 7, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 8, "arabic": "وَصَلِّ", "translit": "ِّlَṣَw", "root": "صلو"}, {"id": 9, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "صَلَوٰتَكَ", "translit": "َkَtٰwَlَṣ", "root": "صلو"}, {"id": 12, "arabic": "سَكَنٌ", "translit": "ٌnَkَs", "root": "سكن"}, {"id": 13, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 14, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 15, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 16, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 104, "text": "أَلَمْ يَعْلَمُوٓا۟ أَنَّ ٱللَّهَ هُوَ يَقْبَلُ ٱلتَّوْبَةَ عَنْ عِبَادِهِۦ وَيَأْخُذُ ٱلصَّدَقَٰتِ وَأَنَّ ٱللَّهَ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ ", "translation": "Do they not know that it is Allāh who accepts repentance from His servants and receives charities and that it is Allāh who is the Accepting of Repentance,[1] the Merciful?", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "يَعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "يَقْبَلُ", "translit": "ُlَbْqَy", "root": "قبل"}, {"id": 7, "arabic": "ٱلتَّوْبَةَ", "translit": "َẗَbْwَّtlٱ", "root": "توب"}, {"id": 8, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 9, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 10, "arabic": "وَيَأْخُذُ", "translit": "ُhdُhkْaʾَyَw", "root": "اخذ"}, {"id": 11, "arabic": "ٱلصَّدَقَٰتِ", "translit": "ِtَٰqَdَّṣlٱ", "root": "صدق"}, {"id": 12, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "ٱلتَّوَّابُ", "translit": "ُbāَّwَّtlٱ", "root": "توب"}, {"id": 16, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": true}, {"ayah": 105, "text": "وَقُلِ ٱعْمَلُوا۟ فَسَيَرَى ٱللَّهُ عَمَلَكُمْ وَرَسُولُهُۥ وَٱلْمُؤْمِنُونَۖ وَسَتُرَدُّونَ إِلَىٰ عَٰلِمِ ٱلْغَيْبِ وَٱلشَّهَٰدَةِ فَيُنَبِّئُكُم بِمَا كُنتُمْ تَعْمَلُونَ ", "translation": "And say, \"Do [as you will], for Allāh will see your deeds, and [so will] His Messenger and the believers. And you will be returned to the Knower of the unseen and the witnessed, and He will inform you of what you used to do.\"", "words": [{"id": 1, "arabic": "وَقُلِ", "translit": "ِlُqَw", "root": "قول"}, {"id": 2, "arabic": "ٱعْمَلُوا۟", "translit": "۟āwُlَmْʿعٱ", "root": "عمل"}, {"id": 3, "arabic": "فَسَيَرَى", "translit": "àَrَyَsَf", "root": "راي"}, {"id": 4, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "عَمَلَكُمْ", "translit": "ْmُkَlَmَʿع", "root": "عمل"}, {"id": 6, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 7, "arabic": "وَٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 8, "arabic": "وَسَتُرَدُّونَ", "translit": "َnwُّdَrُtَsَw", "root": "ردد"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "عَٰلِمِ", "translit": "ِmِlَٰʿع", "root": "علم"}, {"id": 11, "arabic": "ٱلْغَيْبِ", "translit": "ِbْyَغْlٱ", "root": "غيب"}, {"id": 12, "arabic": "وَٱلشَّهَٰدَةِ", "translit": "ِẗَdَٰhَّhslٱَw", "root": "شهد"}, {"id": 13, "arabic": "فَيُنَبِّئُكُم", "translit": "mُkُyʾِّbَnُyَf", "root": "نبا"}, {"id": 14, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 15, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 16, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 106, "text": "وَءَاخَرُونَ مُرْجَوْنَ لِأَمْرِ ٱللَّهِ إِمَّا يُعَذِّبُهُمْ وَإِمَّا يَتُوبُ عَلَيْهِمْۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "And [there are] others deferred until the command of Allāh - whether He will punish them or whether He will forgive them. And Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "وَءَاخَرُونَ", "translit": "َnwُrَhkāَءَw", "root": "اخر"}, {"id": 2, "arabic": "مُرْجَوْنَ", "translit": "َnْwَjgْrُm", "root": "رجو"}, {"id": 3, "arabic": "لِأَمْرِ", "translit": "ِrْmَaʾِl", "root": "امر"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "إِمَّا", "translit": "āَّmِiʾ", "root": ""}, {"id": 6, "arabic": "يُعَذِّبُهُمْ", "translit": "ْmُhُbِّhdَʿعُy", "root": "عذب"}, {"id": 7, "arabic": "وَإِمَّا", "translit": "āَّmِiʾَw", "root": ""}, {"id": 8, "arabic": "يَتُوبُ", "translit": "ُbwُtَy", "root": "توب"}, {"id": 9, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 11, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 12, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 107, "text": "وَٱلَّذِينَ ٱتَّخَذُوا۟ مَسْجِدًا ضِرَارًا وَكُفْرًا وَتَفْرِيقًۢا بَيْنَ ٱلْمُؤْمِنِينَ وَإِرْصَادًا لِّمَنْ حَارَبَ ٱللَّهَ وَرَسُولَهُۥ مِن قَبْلُۚ وَلَيَحْلِفُنَّ إِنْ أَرَدْنَآ إِلَّا ٱلْحُسْنَىٰۖ وَٱللَّهُ يَشْهَدُ إِنَّهُمْ لَكَٰذِبُونَ ", "translation": "And [there are] those [hypocrites] who took for themselves a mosque for causing harm and disbelief and division among the believers and as a station for whoever had warred against Allāh and His Messenger before. And they will surely swear, \"We intended only the best.\" And Allāh testifies that indeed they are liars.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "ٱتَّخَذُوا۟", "translit": "۟āwُhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "مَسْجِدًا", "translit": "āًdِjgْsَm", "root": "سجد"}, {"id": 4, "arabic": "ضِرَارًا", "translit": "āًrāَrِḍ", "root": "ضرر"}, {"id": 5, "arabic": "وَكُفْرًا", "translit": "āًrْfُkَw", "root": "كفر"}, {"id": 6, "arabic": "وَتَفْرِيقًۢا", "translit": "āًۢqyِrْfَtَw", "root": "فرق"}, {"id": 7, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 8, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 9, "arabic": "وَإِرْصَادًا", "translit": "āًdāَṣْrِiʾَw", "root": "رصد"}, {"id": 10, "arabic": "لِّمَنْ", "translit": "ْnَmِّl", "root": ""}, {"id": 11, "arabic": "حَارَبَ", "translit": "َbَrāَḥ", "root": "حرب"}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 16, "arabic": "وَلَيَحْلِفُنَّ", "translit": "َّnُfِlْḥَyَlَw", "root": "حلف"}, {"id": 17, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 18, "arabic": "أَرَدْنَآ", "translit": "ٓāَnْdَrَaʾ", "root": "رود"}, {"id": 19, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 20, "arabic": "ٱلْحُسْنَىٰ", "translit": "ٰàَnْsُḥْlٱ", "root": "حسن"}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "يَشْهَدُ", "translit": "ُdَhْhsَy", "root": "شهد"}, {"id": 23, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 24, "arabic": "لَكَٰذِبُونَ", "translit": "َnwُbِhdَٰkَl", "root": "كذب"}], "hasIhya": false}, {"ayah": 108, "text": "لَا تَقُمْ فِيهِ أَبَدًاۚ لَّمَسْجِدٌ أُسِّسَ عَلَى ٱلتَّقْوَىٰ مِنْ أَوَّلِ يَوْمٍ أَحَقُّ أَن تَقُومَ فِيهِۚ فِيهِ رِجَالٌ يُحِبُّونَ أَن يَتَطَهَّرُوا۟ۚ وَٱللَّهُ يُحِبُّ ٱلْمُطَّهِّرِينَ ", "translation": "Do not stand [for prayer] within it - ever. A mosque founded on righteousness from the first day[1] is more worthy for you to stand in. Within it are men who love to purify themselves; and Allāh loves those who purify themselves.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "تَقُمْ", "translit": "ْmُqَt", "root": "قوم"}, {"id": 3, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 4, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 5, "arabic": "لَّمَسْجِدٌ", "translit": "ٌdِjgْsَmَّl", "root": "سجد"}, {"id": 6, "arabic": "أُسِّسَ", "translit": "َsِّsُaʾ", "root": "اسس"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱ", "root": "وقي"}, {"id": 9, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 10, "arabic": "أَوَّلِ", "translit": "ِlَّwَaʾ", "root": "اول"}, {"id": 11, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 12, "arabic": "أَحَقُّ", "translit": "ُّqَḥَaʾ", "root": "حقق"}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "تَقُومَ", "translit": "َmwُqَt", "root": "قوم"}, {"id": 15, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 16, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 17, "arabic": "رِجَالٌ", "translit": "ٌlāَjgِr", "root": "رجل"}, {"id": 18, "arabic": "يُحِبُّونَ", "translit": "َnwُّbِḥُy", "root": "حبب"}, {"id": 19, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 20, "arabic": "يَتَطَهَّرُوا۟", "translit": "۟āwُrَّhَṭَtَy", "root": "طهر"}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 23, "arabic": "ٱلْمُطَّهِّرِينَ", "translit": "َnyِrِّhَّṭُmْlٱ", "root": "طهر"}], "hasIhya": true}, {"ayah": 109, "text": "أَفَمَنْ أَسَّسَ بُنْيَٰنَهُۥ عَلَىٰ تَقْوَىٰ مِنَ ٱللَّهِ وَرِضْوَٰنٍ خَيْرٌ أَم مَّنْ أَسَّسَ بُنْيَٰنَهُۥ عَلَىٰ شَفَا جُرُفٍ هَارٍ فَٱنْهَارَ بِهِۦ فِى نَارِ جَهَنَّمَۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّٰلِمِينَ ", "translation": "Then is one who laid the foundation of his building on righteousness [with fear] from Allāh and [seeking] His approval better or one who laid the foundation of his building on the edge of a bank about to collapse, so it collapsed with him into the fire of Hell? And Allāh does not guide the wrongdoing people.", "words": [{"id": 1, "arabic": "أَفَمَنْ", "translit": "ْnَmَfَaʾ", "root": ""}, {"id": 2, "arabic": "أَسَّسَ", "translit": "َsَّsَaʾ", "root": "اسس"}, {"id": 3, "arabic": "بُنْيَٰنَهُۥ", "translit": "ۥُhَnَٰyْnُb", "root": "بني"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "تَقْوَىٰ", "translit": "ٰàَwْqَt", "root": "وقي"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَرِضْوَٰنٍ", "translit": "ٍnَٰwْḍِrَw", "root": "رضو"}, {"id": 9, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 10, "arabic": "أَم", "translit": "mَaʾ", "root": ""}, {"id": 11, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 12, "arabic": "أَسَّسَ", "translit": "َsَّsَaʾ", "root": "اسس"}, {"id": 13, "arabic": "بُنْيَٰنَهُۥ", "translit": "ۥُhَnَٰyْnُb", "root": "بني"}, {"id": 14, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 15, "arabic": "شَفَا", "translit": "āَfَhs", "root": "شفو"}, {"id": 16, "arabic": "جُرُفٍ", "translit": "ٍfُrُjg", "root": "جرف"}, {"id": 17, "arabic": "هَارٍ", "translit": "ٍrāَh", "root": "هور"}, {"id": 18, "arabic": "فَٱنْهَارَ", "translit": "َrāَhْnٱَf", "root": "هور"}, {"id": 19, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 21, "arabic": "نَارِ", "translit": "ِrāَn", "root": "نور"}, {"id": 22, "arabic": "جَهَنَّمَ", "translit": "َmَّnَhَjg", "root": ""}, {"id": 23, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 26, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 27, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 110, "text": "لَا يَزَالُ بُنْيَٰنُهُمُ ٱلَّذِى بَنَوْا۟ رِيبَةً فِى قُلُوبِهِمْ إِلَّآ أَن تَقَطَّعَ قُلُوبُهُمْۗ وَٱللَّهُ عَلِيمٌ حَكِيمٌ ", "translation": "Their building which they built will not cease to be a [cause of] skepticism in their hearts until their hearts are cut [i.e., stopped]. And Allāh is Knowing and Wise.", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يَزَالُ", "translit": "ُlāَzَy", "root": "زيل"}, {"id": 3, "arabic": "بُنْيَٰنُهُمُ", "translit": "ُmُhُnَٰyْnُb", "root": "بني"}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "بَنَوْا۟", "translit": "۟āْwَnَb", "root": "بني"}, {"id": 6, "arabic": "رِيبَةً", "translit": "ًẗَbyِr", "root": "ريب"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 9, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "تَقَطَّعَ", "translit": "َʿعَّṭَqَt", "root": "قطع"}, {"id": 12, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 13, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 14, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}, {"id": 15, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 111, "text": "إِنَّ ٱللَّهَ ٱشْتَرَىٰ مِنَ ٱلْمُؤْمِنِينَ أَنفُسَهُمْ وَأَمْوَٰلَهُم بِأَنَّ لَهُمُ ٱلْجَنَّةَۚ يُقَٰتِلُونَ فِى سَبِيلِ ٱللَّهِ فَيَقْتُلُونَ وَيُقْتَلُونَۖ وَعْدًا عَلَيْهِ حَقًّا فِى ٱلتَّوْرَىٰةِ وَٱلْإِنجِيلِ وَٱلْقُرْءَانِۚ وَمَنْ أَوْفَىٰ بِعَهْدِهِۦ مِنَ ٱللَّهِۚ فَٱسْتَبْشِرُوا۟ بِبَيْعِكُمُ ٱلَّذِى بَايَعْتُم بِهِۦۚ وَذَٰلِكَ هُوَ ٱلْفَوْزُ ٱلْعَظِيمُ ", "translation": "Indeed, Allāh has purchased from the believers their lives and their properties [in exchange] for that they will have Paradise. They fight in the cause of Allāh, so they kill and are killed. [It is] a true promise [binding] upon Him in the Torah and the Gospel and the Qur’ān. And who is truer to his covenant than Allāh? So rejoice in your transaction which you have contracted. And it is that which is the great attainment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱشْتَرَىٰ", "translit": "ٰàَrَtْhsٱ", "root": "شري"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 6, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 7, "arabic": "وَأَمْوَٰلَهُم", "translit": "mُhَlَٰwْmَaʾَw", "root": "مول"}, {"id": 8, "arabic": "بِأَنَّ", "translit": "َّnَaʾِb", "root": ""}, {"id": 9, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 10, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 11, "arabic": "يُقَٰتِلُونَ", "translit": "َnwُlِtَٰqُy", "root": "قتل"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "فَيَقْتُلُونَ", "translit": "َnwُlُtْqَyَf", "root": "قتل"}, {"id": 16, "arabic": "وَيُقْتَلُونَ", "translit": "َnwُlَtْqُyَw", "root": "قتل"}, {"id": 17, "arabic": "وَعْدًا", "translit": "āًdْʿعَw", "root": "وعد"}, {"id": 18, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 19, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 20, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 21, "arabic": "ٱلتَّوْرَىٰةِ", "translit": "ِẗٰàَrْwَّtlٱ", "root": ""}, {"id": 22, "arabic": "وَٱلْإِنجِيلِ", "translit": "ِlyِjgnِiʾْlٱَw", "root": ""}, {"id": 23, "arabic": "وَٱلْقُرْءَانِ", "translit": "ِnāَءْrُqْlٱَw", "root": "قرا"}, {"id": 24, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 25, "arabic": "أَوْفَىٰ", "translit": "ٰàَfْwَaʾ", "root": "وفي"}, {"id": 26, "arabic": "بِعَهْدِهِۦ", "translit": "ۦِhِdْhَʿعِb", "root": "عهد"}, {"id": 27, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 28, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "فَٱسْتَبْشِرُوا۟", "translit": "۟āwُrِhsْbَtْsٱَf", "root": "بشر"}, {"id": 30, "arabic": "بِبَيْعِكُمُ", "translit": "ُmُkِʿعْyَbِb", "root": "بيع"}, {"id": 31, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 32, "arabic": "بَايَعْتُم", "translit": "mُtْʿعَyāَb", "root": "بيع"}, {"id": 33, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 34, "arabic": "وَذَٰلِكَ", "translit": "َkِlَٰhdَw", "root": ""}, {"id": 35, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 36, "arabic": "ٱلْفَوْزُ", "translit": "ُzْwَfْlٱ", "root": "فوز"}, {"id": 37, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": true}, {"ayah": 112, "text": "ٱلتَّٰٓئِبُونَ ٱلْعَٰبِدُونَ ٱلْحَٰمِدُونَ ٱلسَّٰٓئِحُونَ ٱلرَّٰكِعُونَ ٱلسَّٰجِدُونَ ٱلْءَامِرُونَ بِٱلْمَعْرُوفِ وَٱلنَّاهُونَ عَنِ ٱلْمُنكَرِ وَٱلْحَٰفِظُونَ لِحُدُودِ ٱللَّهِۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ ", "translation": "[Such believers are] the repentant, the worshippers, the praisers [of Allāh], the travelers [for His cause], those who bow and prostrate [in prayer], those who enjoin what is right and forbid what is wrong, and those who observe the limits [set by] Allāh. And give good tidings to the believers.", "words": [{"id": 1, "arabic": "ٱلتَّٰٓئِبُونَ", "translit": "َnwُbِyʾَّٰٓtlٱ", "root": "توب"}, {"id": 2, "arabic": "ٱلْعَٰبِدُونَ", "translit": "َnwُdِbَٰʿعْlٱ", "root": "عبد"}, {"id": 3, "arabic": "ٱلْحَٰمِدُونَ", "translit": "َnwُdِmَٰḥْlٱ", "root": "حمد"}, {"id": 4, "arabic": "ٱلسَّٰٓئِحُونَ", "translit": "َnwُḥِyʾَّٰٓslٱ", "root": "سيح"}, {"id": 5, "arabic": "ٱلرَّٰكِعُونَ", "translit": "َnwُʿعِkَّٰrlٱ", "root": "ركع"}, {"id": 6, "arabic": "ٱلسَّٰجِدُونَ", "translit": "َnwُdِjgَّٰslٱ", "root": "سجد"}, {"id": 7, "arabic": "ٱلْءَامِرُونَ", "translit": "َnwُrِmāَءْlٱ", "root": "امر"}, {"id": 8, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 9, "arabic": "وَٱلنَّاهُونَ", "translit": "َnwُhāَّnlٱَw", "root": "نهي"}, {"id": 10, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 11, "arabic": "ٱلْمُنكَرِ", "translit": "ِrَknُmْlٱ", "root": "نكر"}, {"id": 12, "arabic": "وَٱلْحَٰفِظُونَ", "translit": "َnwُẓِfَٰḥْlٱَw", "root": "حفظ"}, {"id": 13, "arabic": "لِحُدُودِ", "translit": "ِdwُdُḥِl", "root": "حدد"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 16, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": true}, {"ayah": 113, "text": "مَا كَانَ لِلنَّبِىِّ وَٱلَّذِينَ ءَامَنُوٓا۟ أَن يَسْتَغْفِرُوا۟ لِلْمُشْرِكِينَ وَلَوْ كَانُوٓا۟ أُو۟لِى قُرْبَىٰ مِنۢ بَعْدِ مَا تَبَيَّنَ لَهُمْ أَنَّهُمْ أَصْحَٰبُ ٱلْجَحِيمِ ", "translation": "It is not for the Prophet and those who have believed to ask forgiveness for the polytheists, even if they were relatives, after it has become clear to them that they are companions of Hellfire.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِلنَّبِىِّ", "translit": "ِّàِbَّnlِl", "root": "نبا"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "يَسْتَغْفِرُوا۟", "translit": "۟āwُrِfْغَtْsَy", "root": "غفر"}, {"id": 8, "arabic": "لِلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlِl", "root": "شرك"}, {"id": 9, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 10, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 11, "arabic": "أُو۟لِى", "translit": "àِl۟wُaʾ", "root": ""}, {"id": 12, "arabic": "قُرْبَىٰ", "translit": "ٰàَbْrُq", "root": "قرب"}, {"id": 13, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 14, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "تَبَيَّنَ", "translit": "َnَّyَbَt", "root": "بين"}, {"id": 17, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 18, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 19, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 20, "arabic": "ٱلْجَحِيمِ", "translit": "ِmyِḥَjgْlٱ", "root": "جحم"}], "hasIhya": false}, {"ayah": 114, "text": "وَمَا كَانَ ٱسْتِغْفَارُ إِبْرَٰهِيمَ لِأَبِيهِ إِلَّا عَن مَّوْعِدَةٍ وَعَدَهَآ إِيَّاهُ فَلَمَّا تَبَيَّنَ لَهُۥٓ أَنَّهُۥ عَدُوٌّ لِّلَّهِ تَبَرَّأَ مِنْهُۚ إِنَّ إِبْرَٰهِيمَ لَأَوَّٰهٌ حَلِيمٌ ", "translation": "And the request of forgiveness of Abraham for his father was only because of a promise he had made to him. But when it became apparent to him [i.e., Abraham] that he [i.e., the father] was an enemy to Allāh, he disassociated himself from him. Indeed was Abraham compassionate and patient.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "ٱسْتِغْفَارُ", "translit": "ُrāَfْغِtْsٱ", "root": "غفر"}, {"id": 4, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 5, "arabic": "لِأَبِيهِ", "translit": "ِhyِbَaʾِl", "root": "ابو"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 8, "arabic": "مَّوْعِدَةٍ", "translit": "ٍẗَdِʿعْwَّm", "root": "وعد"}, {"id": 9, "arabic": "وَعَدَهَآ", "translit": "ٓāَhَdَʿعَw", "root": "وعد"}, {"id": 10, "arabic": "إِيَّاهُ", "translit": "ُhāَّyِiʾ", "root": ""}, {"id": 11, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 12, "arabic": "تَبَيَّنَ", "translit": "َnَّyَbَt", "root": "بين"}, {"id": 13, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 14, "arabic": "أَنَّهُۥ", "translit": "ۥُhَّnَaʾ", "root": ""}, {"id": 15, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 16, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 17, "arabic": "تَبَرَّأَ", "translit": "َaʾَّrَbَt", "root": "برا"}, {"id": 18, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 19, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 20, "arabic": "إِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾ", "root": ""}, {"id": 21, "arabic": "لَأَوَّٰهٌ", "translit": "ٌhَّٰwَaʾَl", "root": "اوه"}, {"id": 22, "arabic": "حَلِيمٌ", "translit": "ٌmyِlَḥ", "root": "حلم"}], "hasIhya": false}, {"ayah": 115, "text": "وَمَا كَانَ ٱللَّهُ لِيُضِلَّ قَوْمًۢا بَعْدَ إِذْ هَدَىٰهُمْ حَتَّىٰ يُبَيِّنَ لَهُم مَّا يَتَّقُونَۚ إِنَّ ٱللَّهَ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "And Allāh would not let a people stray after He has guided them until He makes clear to them what they should avoid. Indeed, Allāh is Knowing of all things.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لِيُضِلَّ", "translit": "َّlِḍُyِl", "root": "ضلل"}, {"id": 5, "arabic": "قَوْمًۢا", "translit": "āًۢmْwَq", "root": "قوم"}, {"id": 6, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 8, "arabic": "هَدَىٰهُمْ", "translit": "ْmُhٰàَdَh", "root": "هدي"}, {"id": 9, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 10, "arabic": "يُبَيِّنَ", "translit": "َnِّyَbُy", "root": "بين"}, {"id": 11, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 12, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 13, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 17, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 18, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 116, "text": "إِنَّ ٱللَّهَ لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ يُحْىِۦ وَيُمِيتُۚ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِىٍّ وَلَا نَصِيرٍ ", "translation": "Indeed, to Allāh belongs the dominion of the heavens and the earth; He gives life and causes death. And you have not besides Allāh any protector or any helper.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "يُحْىِۦ", "translit": "ۦِàْḥُy", "root": "حيي"}, {"id": 8, "arabic": "وَيُمِيتُ", "translit": "ُtyِmُyَw", "root": "موت"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "وَلِىٍّ", "translit": "ٍّàِlَw", "root": "ولي"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "نَصِيرٍ", "translit": "ٍryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 117, "text": "لَّقَد تَّابَ ٱللَّهُ عَلَى ٱلنَّبِىِّ وَٱلْمُهَٰجِرِينَ وَٱلْأَنصَارِ ٱلَّذِينَ ٱتَّبَعُوهُ فِى سَاعَةِ ٱلْعُسْرَةِ مِنۢ بَعْدِ مَا كَادَ يَزِيغُ قُلُوبُ فَرِيقٍ مِّنْهُمْ ثُمَّ تَابَ عَلَيْهِمْۚ إِنَّهُۥ بِهِمْ رَءُوفٌ رَّحِيمٌ ", "translation": "Allāh has already forgiven the Prophet and the Muhājireen and the Anṣār who followed him in the hour of difficulty after the hearts of a party of them had almost inclined [to doubt], and then He forgave them. Indeed, He was to them Kind and Merciful.", "words": [{"id": 1, "arabic": "لَّقَد", "translit": "dَqَّl", "root": ""}, {"id": 2, "arabic": "تَّابَ", "translit": "َbāَّt", "root": "توب"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلنَّبِىِّ", "translit": "ِّàِbَّnlٱ", "root": "نبا"}, {"id": 6, "arabic": "وَٱلْمُهَٰجِرِينَ", "translit": "َnyِrِjgَٰhُmْlٱَw", "root": "هجر"}, {"id": 7, "arabic": "وَٱلْأَنصَارِ", "translit": "ِrāَṣnَaʾْlٱَw", "root": "نصر"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "ٱتَّبَعُوهُ", "translit": "ُhwُʿعَbَّtٱ", "root": "تبع"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "سَاعَةِ", "translit": "ِẗَʿعāَs", "root": "سوع"}, {"id": 12, "arabic": "ٱلْعُسْرَةِ", "translit": "ِẗَrْsُʿعْlٱ", "root": "عسر"}, {"id": 13, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 14, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "كَادَ", "translit": "َdāَk", "root": "كود"}, {"id": 17, "arabic": "يَزِيغُ", "translit": "ُغyِzَy", "root": "زيغ"}, {"id": 18, "arabic": "قُلُوبُ", "translit": "ُbwُlُq", "root": "قلب"}, {"id": 19, "arabic": "فَرِيقٍ", "translit": "ٍqyِrَf", "root": "فرق"}, {"id": 20, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 21, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 22, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 23, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 24, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 25, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 26, "arabic": "رَءُوفٌ", "translit": "ٌfwُءَr", "root": "راف"}, {"id": 27, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 118, "text": "وَعَلَى ٱلثَّلَٰثَةِ ٱلَّذِينَ خُلِّفُوا۟ حَتَّىٰٓ إِذَا ضَاقَتْ عَلَيْهِمُ ٱلْأَرْضُ بِمَا رَحُبَتْ وَضَاقَتْ عَلَيْهِمْ أَنفُسُهُمْ وَظَنُّوٓا۟ أَن لَّا مَلْجَأَ مِنَ ٱللَّهِ إِلَّآ إِلَيْهِ ثُمَّ تَابَ عَلَيْهِمْ لِيَتُوبُوٓا۟ۚ إِنَّ ٱللَّهَ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ ", "translation": "And [He also forgave] the three who were left alone [i.e., boycotted, regretting their error] to the point that the earth closed in on them in spite of its vastness[1] and their souls confined [i.e., anguished] them and they were certain that there is no refuge from Allāh except in Him. Then He turned to them so they could repent. Indeed, Allāh is the Accepting of Repentance,[2] the Merciful.", "words": [{"id": 1, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 2, "arabic": "ٱلثَّلَٰثَةِ", "translit": "ِẗَhtَٰlَّhtlٱ", "root": "ثلث"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "خُلِّفُوا۟", "translit": "۟āwُfِّlُhk", "root": "خلف"}, {"id": 5, "arabic": "حَتَّىٰٓ", "translit": "ٰٓàَّtَḥ", "root": ""}, {"id": 6, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 7, "arabic": "ضَاقَتْ", "translit": "ْtَqāَḍ", "root": "ضيق"}, {"id": 8, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "رَحُبَتْ", "translit": "ْtَbُḥَr", "root": "رحب"}, {"id": 12, "arabic": "وَضَاقَتْ", "translit": "ْtَqāَḍَw", "root": "ضيق"}, {"id": 13, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "أَنفُسُهُمْ", "translit": "ْmُhُsُfnَaʾ", "root": "نفس"}, {"id": 15, "arabic": "وَظَنُّوٓا۟", "translit": "۟āٓwُّnَẓَw", "root": "ظنن"}, {"id": 16, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 17, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 18, "arabic": "مَلْجَأَ", "translit": "َaʾَjgْlَm", "root": "لجا"}, {"id": 19, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 20, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 22, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 23, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 24, "arabic": "تَابَ", "translit": "َbāَt", "root": "توب"}, {"id": 25, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 26, "arabic": "لِيَتُوبُوٓا۟", "translit": "۟āٓwُbwُtَyِl", "root": "توب"}, {"id": 27, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 28, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 30, "arabic": "ٱلتَّوَّابُ", "translit": "ُbāَّwَّtlٱ", "root": "توب"}, {"id": 31, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": true}, {"ayah": 119, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَكُونُوا۟ مَعَ ٱلصَّٰدِقِينَ ", "translation": "O you who have believed, fear Allāh and be with those who are true.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَكُونُوا۟", "translit": "۟āwُnwُkَw", "root": "كون"}, {"id": 7, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 8, "arabic": "ٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱ", "root": "صدق"}], "hasIhya": true}, {"ayah": 120, "text": "مَا كَانَ لِأَهْلِ ٱلْمَدِينَةِ وَمَنْ حَوْلَهُم مِّنَ ٱلْأَعْرَابِ أَن يَتَخَلَّفُوا۟ عَن رَّسُولِ ٱللَّهِ وَلَا يَرْغَبُوا۟ بِأَنفُسِهِمْ عَن نَّفْسِهِۦۚ ذَٰلِكَ بِأَنَّهُمْ لَا يُصِيبُهُمْ ظَمَأٌ وَلَا نَصَبٌ وَلَا مَخْمَصَةٌ فِى سَبِيلِ ٱللَّهِ وَلَا يَطَـُٔونَ مَوْطِئًا يَغِيظُ ٱلْكُفَّارَ وَلَا يَنَالُونَ مِنْ عَدُوٍّ نَّيْلًا إِلَّا كُتِبَ لَهُم بِهِۦ عَمَلٌ صَٰلِحٌۚ إِنَّ ٱللَّهَ لَا يُضِيعُ أَجْرَ ٱلْمُحْسِنِينَ ", "translation": "It was not [proper] for the people of Madīnah and those surrounding them of the bedouins that they remain behind after [the departure of] the Messenger of Allāh or that they prefer themselves over his self.[1] That is because they are not afflicted by thirst or fatigue or hunger in the cause of Allāh, nor do they tread on any ground that enrages the disbelievers, nor do they inflict upon an enemy any infliction but that it is registered for them as a righteous deed. Indeed, Allāh does not allow to be lost the reward of the doers of good.", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِأَهْلِ", "translit": "ِlْhَaʾِl", "root": "اهل"}, {"id": 4, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 5, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 6, "arabic": "حَوْلَهُم", "translit": "mُhَlْwَḥ", "root": "حول"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْأَعْرَابِ", "translit": "ِbāَrْʿعَaʾْlٱ", "root": "عرب"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يَتَخَلَّفُوا۟", "translit": "۟āwُfَّlَhkَtَy", "root": "خلف"}, {"id": 11, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 12, "arabic": "رَّسُولِ", "translit": "ِlwُsَّr", "root": "رسل"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "يَرْغَبُوا۟", "translit": "۟āwُbَغْrَy", "root": "رغب"}, {"id": 16, "arabic": "بِأَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾِb", "root": "نفس"}, {"id": 17, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 18, "arabic": "نَّفْسِهِۦ", "translit": "ۦِhِsْfَّn", "root": "نفس"}, {"id": 19, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 20, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "يُصِيبُهُمْ", "translit": "ْmُhُbyِṣُy", "root": "صوب"}, {"id": 23, "arabic": "ظَمَأٌ", "translit": "ٌaʾَmَẓ", "root": "ظما"}, {"id": 24, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 25, "arabic": "نَصَبٌ", "translit": "ٌbَṣَn", "root": "نصب"}, {"id": 26, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 27, "arabic": "مَخْمَصَةٌ", "translit": "ٌẗَṣَmْhkَm", "root": "خمص"}, {"id": 28, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 29, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 30, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 31, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 32, "arabic": "يَطَـُٔونَ", "translit": "َnwُٔـَṭَy", "root": "وطا"}, {"id": 33, "arabic": "مَوْطِئًا", "translit": "āًyʾِṭْwَm", "root": "وطا"}, {"id": 34, "arabic": "يَغِيظُ", "translit": "ُẓyِغَy", "root": "غيظ"}, {"id": 35, "arabic": "ٱلْكُفَّارَ", "translit": "َrāَّfُkْlٱ", "root": "كفر"}, {"id": 36, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 37, "arabic": "يَنَالُونَ", "translit": "َnwُlāَnَy", "root": "نيل"}, {"id": 38, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 39, "arabic": "عَدُوٍّ", "translit": "ٍّwُdَʿع", "root": "عدو"}, {"id": 40, "arabic": "نَّيْلًا", "translit": "āًlْyَّn", "root": "نيل"}, {"id": 41, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 42, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 43, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 44, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 45, "arabic": "عَمَلٌ", "translit": "ٌlَmَʿع", "root": "عمل"}, {"id": 46, "arabic": "صَٰلِحٌ", "translit": "ٌḥِlَٰṣ", "root": "صلح"}, {"id": 47, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 48, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 49, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 50, "arabic": "يُضِيعُ", "translit": "ُʿعyِḍُy", "root": "ضيع"}, {"id": 51, "arabic": "أَجْرَ", "translit": "َrْjgَaʾ", "root": "اجر"}, {"id": 52, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": true}, {"ayah": 121, "text": "وَلَا يُنفِقُونَ نَفَقَةً صَغِيرَةً وَلَا كَبِيرَةً وَلَا يَقْطَعُونَ وَادِيًا إِلَّا كُتِبَ لَهُمْ لِيَجْزِيَهُمُ ٱللَّهُ أَحْسَنَ مَا كَانُوا۟ يَعْمَلُونَ ", "translation": "Nor do they spend an expenditure, small or large, or cross a valley but that it is registered for them that Allāh may reward them for the best of what they were doing.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 3, "arabic": "نَفَقَةً", "translit": "ًẗَqَfَn", "root": "نفق"}, {"id": 4, "arabic": "صَغِيرَةً", "translit": "ًẗَryِغَṣ", "root": "صغر"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "كَبِيرَةً", "translit": "ًẗَryِbَk", "root": "كبر"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "يَقْطَعُونَ", "translit": "َnwُʿعَṭْqَy", "root": "قطع"}, {"id": 9, "arabic": "وَادِيًا", "translit": "āًyِdāَw", "root": "ودي"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 12, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 13, "arabic": "لِيَجْزِيَهُمُ", "translit": "ُmُhَyِzْjgَyِl", "root": "جزي"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "أَحْسَنَ", "translit": "َnَsْḥَaʾ", "root": "حسن"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 122, "text": "وَمَا كَانَ ٱلْمُؤْمِنُونَ لِيَنفِرُوا۟ كَآفَّةًۚ فَلَوْلَا نَفَرَ مِن كُلِّ فِرْقَةٍ مِّنْهُمْ طَآئِفَةٌ لِّيَتَفَقَّهُوا۟ فِى ٱلدِّينِ وَلِيُنذِرُوا۟ قَوْمَهُمْ إِذَا رَجَعُوٓا۟ إِلَيْهِمْ لَعَلَّهُمْ يَحْذَرُونَ ", "translation": "And it is not for the believers to go forth [to battle] all at once. For there should separate from every division of them a group [remaining] to obtain understanding in the religion and warn [i.e., advise] their people when they return to them that they might be cautious.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}, {"id": 4, "arabic": "لِيَنفِرُوا۟", "translit": "۟āwُrِfnَyِl", "root": "نفر"}, {"id": 5, "arabic": "كَآفَّةً", "translit": "ًẗَّfٓāَk", "root": "كفف"}, {"id": 6, "arabic": "فَلَوْلَا", "translit": "āَlْwَlَf", "root": ""}, {"id": 7, "arabic": "نَفَرَ", "translit": "َrَfَn", "root": "نفر"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 10, "arabic": "فِرْقَةٍ", "translit": "ٍẗَqْrِf", "root": "فرق"}, {"id": 11, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 12, "arabic": "طَآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَṭ", "root": "طوف"}, {"id": 13, "arabic": "لِّيَتَفَقَّهُوا۟", "translit": "۟āwُhَّqَfَtَyِّl", "root": "فقه"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 16, "arabic": "وَلِيُنذِرُوا۟", "translit": "۟āwُrِhdnُyِlَw", "root": "نذر"}, {"id": 17, "arabic": "قَوْمَهُمْ", "translit": "ْmُhَmْwَq", "root": "قوم"}, {"id": 18, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 19, "arabic": "رَجَعُوٓا۟", "translit": "۟āٓwُʿعَjgَr", "root": "رجع"}, {"id": 20, "arabic": "إِلَيْهِمْ", "translit": "ْmِhْyَlِiʾ", "root": ""}, {"id": 21, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 22, "arabic": "يَحْذَرُونَ", "translit": "َnwُrَhdْḥَy", "root": "حذر"}], "hasIhya": true}, {"ayah": 123, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ قَٰتِلُوا۟ ٱلَّذِينَ يَلُونَكُم مِّنَ ٱلْكُفَّارِ وَلْيَجِدُوا۟ فِيكُمْ غِلْظَةًۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ مَعَ ٱلْمُتَّقِينَ ", "translation": "O you who have believed, fight against those adjacent to you of the disbelievers and let them find in you harshness. And know that Allāh is with the righteous.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "قَٰتِلُوا۟", "translit": "۟āwُlِtَٰq", "root": "قتل"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "يَلُونَكُم", "translit": "mُkَnwُlَy", "root": "ولي"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْكُفَّارِ", "translit": "ِrāَّfُkْlٱ", "root": "كفر"}, {"id": 9, "arabic": "وَلْيَجِدُوا۟", "translit": "۟āwُdِjgَyْlَw", "root": "وجد"}, {"id": 10, "arabic": "فِيكُمْ", "translit": "ْmُkyِf", "root": ""}, {"id": 11, "arabic": "غِلْظَةً", "translit": "ًẗَẓْlِغ", "root": "غلظ"}, {"id": 12, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 13, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 16, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": true}, {"ayah": 124, "text": "وَإِذَا مَآ أُنزِلَتْ سُورَةٌ فَمِنْهُم مَّن يَقُولُ أَيُّكُمْ زَادَتْهُ هَٰذِهِۦٓ إِيمَٰنًاۚ فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ فَزَادَتْهُمْ إِيمَٰنًا وَهُمْ يَسْتَبْشِرُونَ ", "translation": "And whenever a sūrah is revealed, there are among them [i.e., the hypocrites] those who say, \"Which of you has this increased in faith?\" As for those who believed, it has increased them in faith, while they are rejoicing.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أُنزِلَتْ", "translit": "ْtَlِznُaʾ", "root": "نزل"}, {"id": 4, "arabic": "سُورَةٌ", "translit": "ٌẗَrwُs", "root": "سور"}, {"id": 5, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 6, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 7, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 8, "arabic": "أَيُّكُمْ", "translit": "ْmُkُّyَaʾ", "root": "ايي"}, {"id": 9, "arabic": "زَادَتْهُ", "translit": "ُhْtَdāَz", "root": "زيد"}, {"id": 10, "arabic": "هَٰذِهِۦٓ", "translit": "ٓۦِhِhdَٰh", "root": ""}, {"id": 11, "arabic": "إِيمَٰنًا", "translit": "āًnَٰmyِiʾ", "root": "امن"}, {"id": 12, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 15, "arabic": "فَزَادَتْهُمْ", "translit": "ْmُhْtَdāَzَf", "root": "زيد"}, {"id": 16, "arabic": "إِيمَٰنًا", "translit": "āًnَٰmyِiʾ", "root": "امن"}, {"id": 17, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 18, "arabic": "يَسْتَبْشِرُونَ", "translit": "َnwُrِhsْbَtْsَy", "root": "بشر"}], "hasIhya": false}, {"ayah": 125, "text": "وَأَمَّا ٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ فَزَادَتْهُمْ رِجْسًا إِلَىٰ رِجْسِهِمْ وَمَاتُوا۟ وَهُمْ كَٰفِرُونَ ", "translation": "But as for those in whose hearts is disease, it has [only] increased them in evil [in addition] to their evil.[1] And they will have died while they are disbelievers.", "words": [{"id": 1, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "قُلُوبِهِم", "translit": "mِhِbwُlُq", "root": "قلب"}, {"id": 5, "arabic": "مَّرَضٌ", "translit": "ٌḍَrَّm", "root": "مرض"}, {"id": 6, "arabic": "فَزَادَتْهُمْ", "translit": "ْmُhْtَdāَzَf", "root": "زيد"}, {"id": 7, "arabic": "رِجْسًا", "translit": "āًsْjgِr", "root": "رجس"}, {"id": 8, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 9, "arabic": "رِجْسِهِمْ", "translit": "ْmِhِsْjgِr", "root": "رجس"}, {"id": 10, "arabic": "وَمَاتُوا۟", "translit": "۟āwُtāَmَw", "root": "موت"}, {"id": 11, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 12, "arabic": "كَٰفِرُونَ", "translit": "َnwُrِfَٰk", "root": "كفر"}], "hasIhya": false}, {"ayah": 126, "text": "أَوَلَا يَرَوْنَ أَنَّهُمْ يُفْتَنُونَ فِى كُلِّ عَامٍ مَّرَّةً أَوْ مَرَّتَيْنِ ثُمَّ لَا يَتُوبُونَ وَلَا هُمْ يَذَّكَّرُونَ ", "translation": "Do they not see that they are tried every year once or twice but then they do not repent nor do they remember?", "words": [{"id": 1, "arabic": "أَوَلَا", "translit": "āَlَwَaʾ", "root": ""}, {"id": 2, "arabic": "يَرَوْنَ", "translit": "َnْwَrَy", "root": "راي"}, {"id": 3, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "يُفْتَنُونَ", "translit": "َnwُnَtْfُy", "root": "فتن"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 7, "arabic": "عَامٍ", "translit": "ٍmāَʿع", "root": "عوم"}, {"id": 8, "arabic": "مَّرَّةً", "translit": "ًẗَّrَّm", "root": "مرر"}, {"id": 9, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 10, "arabic": "مَرَّتَيْنِ", "translit": "ِnْyَtَّrَm", "root": "مرر"}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يَتُوبُونَ", "translit": "َnwُbwُtَy", "root": "توب"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 16, "arabic": "يَذَّكَّرُونَ", "translit": "َnwُrَّkَّhdَy", "root": "ذكر"}], "hasIhya": true}, {"ayah": 127, "text": "وَإِذَا مَآ أُنزِلَتْ سُورَةٌ نَّظَرَ بَعْضُهُمْ إِلَىٰ بَعْضٍ هَلْ يَرَىٰكُم مِّنْ أَحَدٍ ثُمَّ ٱنصَرَفُوا۟ۚ صَرَفَ ٱللَّهُ قُلُوبَهُم بِأَنَّهُمْ قَوْمٌ لَّا يَفْقَهُونَ ", "translation": "And whenever a sūrah is revealed, they look at each other, [as if saying], \"Does anyone see you?\" and then they dismiss themselves. Allāh has dismissed their hearts because they are a people who do not understand.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 3, "arabic": "أُنزِلَتْ", "translit": "ْtَlِznُaʾ", "root": "نزل"}, {"id": 4, "arabic": "سُورَةٌ", "translit": "ٌẗَrwُs", "root": "سور"}, {"id": 5, "arabic": "نَّظَرَ", "translit": "َrَẓَّn", "root": "نظر"}, {"id": 6, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 7, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 8, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 9, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 10, "arabic": "يَرَىٰكُم", "translit": "mُkٰàَrَy", "root": "راي"}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "أَحَدٍ", "translit": "ٍdَḥَaʾ", "root": "احد"}, {"id": 13, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 14, "arabic": "ٱنصَرَفُوا۟", "translit": "۟āwُfَrَṣnٱ", "root": "صرف"}, {"id": 15, "arabic": "صَرَفَ", "translit": "َfَrَṣ", "root": "صرف"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "قُلُوبَهُم", "translit": "mُhَbwُlُq", "root": "قلب"}, {"id": 18, "arabic": "بِأَنَّهُمْ", "translit": "ْmُhَّnَaʾِb", "root": ""}, {"id": 19, "arabic": "قَوْمٌ", "translit": "ٌmْwَq", "root": "قوم"}, {"id": 20, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 21, "arabic": "يَفْقَهُونَ", "translit": "َnwُhَqْfَy", "root": "فقه"}], "hasIhya": false}, {"ayah": 128, "text": "لَقَدْ جَآءَكُمْ رَسُولٌ مِّنْ أَنفُسِكُمْ عَزِيزٌ عَلَيْهِ مَا عَنِتُّمْ حَرِيصٌ عَلَيْكُم بِٱلْمُؤْمِنِينَ رَءُوفٌ رَّحِيمٌ ", "translation": "There has certainly come to you a Messenger from among yourselves. Grievous to him is what you suffer; [he is] concerned over you [i.e., your guidance] and to the believers is kind and merciful.", "words": [{"id": 1, "arabic": "لَقَدْ", "translit": "ْdَqَl", "root": ""}, {"id": 2, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 7, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "عَنِتُّمْ", "translit": "ْmُّtِnَʿع", "root": "عنت"}, {"id": 10, "arabic": "حَرِيصٌ", "translit": "ٌṣyِrَḥ", "root": "حرص"}, {"id": 11, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 12, "arabic": "بِٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱِb", "root": "امن"}, {"id": 13, "arabic": "رَءُوفٌ", "translit": "ٌfwُءَr", "root": "راف"}, {"id": 14, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 129, "text": "فَإِن تَوَلَّوْا۟ فَقُلْ حَسْبِىَ ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَۖ عَلَيْهِ تَوَكَّلْتُۖ وَهُوَ رَبُّ ٱلْعَرْشِ ٱلْعَظِيمِ ", "translation": "But if they turn away, [O Muḥammad], say, \"Sufficient for me is Allāh; there is no deity except Him. On Him I have relied, and He is the Lord of the Great Throne.\"", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 3, "arabic": "فَقُلْ", "translit": "ْlُqَf", "root": "قول"}, {"id": 4, "arabic": "حَسْبِىَ", "translit": "َàِbْsَḥ", "root": "حسب"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 7, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 8, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 9, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 10, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 11, "arabic": "تَوَكَّلْتُ", "translit": "ُtْlَّkَwَt", "root": "وكل"}, {"id": 12, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 13, "arabic": "رَبُّ", "translit": "ُّbَr", "root": "ربب"}, {"id": 14, "arabic": "ٱلْعَرْشِ", "translit": "ِhsْrَʿعْlٱ", "root": "عرش"}, {"id": 15, "arabic": "ٱلْعَظِيمِ", "translit": "ِmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": true}], "tafsir": {"14": [{"arabic": "وكذلك قال تعالى قاتلوهم يعذبهم الله بأيديكم فإذا كانوا هم المقاتلين كيف يكون الله سبحانه هو المعذب وإن كان الله تعالى هو المعذب بتحريك أيديهم فما معنى أمرهم بالقتال فحقيقة هذا يستمد من بحر عظيم من علوم المكاشفات لا يغني عنه ظاهر التفسير وهو أن يعلم وجه ارتباط الأفعال بالقدرة الحادثة ويفهم وجه ارتباط القدرة بقدرة الله عز وجل حتى ينكشف بعد إيضاح أمور كثيرة غامضة صدق قوله عز وجل وما رميت إذ رميت ولكن الله رمى ولعل العمر لو أنفق في استكشاف أسرار هذا المعنى وما يرتبط بمقدماته ولواحقه لانقضى ال", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "15": [{"arabic": "ويغفر ما دون ذلك لمن يشاء {وقال} ويتوب الله على من يشاء وهو خلق من أخلاق الربوبية إذ قال تعالى والله شكور حليم وقد جعل الله الشكر مفتاح كلام أهل الجنة فقال تعالى وقالوا الحمد لله الذي صدقناه وعده {وقال} وآخر دعواهم أن الحمد لله رب العالمين", "english": "So then, what we have mentioned concerning the treatment of patience (ṣabr) regarding whispered insinuation (waswās), regarding lust (shahwah), and regarding status (jāh) — annex this to what we have already set down concerning the canons of the paths of spiritual striving (mujāhadah) in the Book of the Discipline of the Soul (Kitāb Riyāḍat al-Nafs) from the Quarter of the Destroyers (rubʿ al-muhlikāt). Adopt it as your manual (dastūr) by which you may come to know the treatment of patience in all the categories which we have previously detailed; for the detailing of individual cases is prolix. Whoever observes gradual progression (tadrīj), patience will elevate him to a state wherein patience without it becomes as arduous as it once was with it — so his affairs become inverted, and what was once beloved to him becomes loathed, and what was once detested to him becomes a sweet, wholesome draught from which he cannot bear to be patient [in abstaining]. This is known only through experience (tajribah) and tasting (dhawq). It has an analogue in customary habits: for a boy is compelled to learning in the beginning by force, and so patience with play and patience with knowledge are both arduous for him — until, when his inner sight is opened and he finds intimacy with knowledge, the matter is inverted, and it becomes arduous for him to be patient in abstaining from knowledge, and to endure play. To this points what is narrated of one of the knowers (ʿārifīn) that he asked al-Shiblī: \"Patience — which of its kinds is the most severe?\" He said: \"Patience in God (fī Allāh).\" He said: \"No.\" He said: \"Patience for God (li-Allāh).\" He said: \"No.\" He said: \"Patience with God (maʿa Allāh).\" He said: \"No.\" He said: \"Then what?\" He said: \"Patience from God (ʿan Allāh).\" At that al-Shiblī cried out a cry by which his soul nearly perished. And it has been said concerning the meaning of His saying, the Exalted: {«اصبروا وصابروا ورابطوا»} \"Be patient, and vie in patience, and be steadfast\" (Q. 3:200): \"Be patient in God, vie in patience by God, and be steadfast with God.\" And it was said: \"Patience for God is sufficiency (ghināʾ); patience by God is endurance (baqāʾ); patience with God is fidelity (wafāʾ); and patience from God is abandonment (jafāʾ).\" And it was said concerning its meaning:", "book_title": "Patience and Gratitude", "section_title_ar": "Section 972", "section_title_en": "The Revival of the Religious Sciences — Section 972: On Patience (al-Sabr) and the Commencement of Gratitude (al-Shukr)", "section_index": 972, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; al-Khalil notes its application to holding back an animal from fodder, and to enduring constraint.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — the withholding of the self in constriction; it is a general term whose specific names (shajāʿah, ḥilm, etc.) vary by context, and its opposite is al-jazaʿ (panic/vexation).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — enduring what is disliked and restraining from what is loved. Metaphorical (majāz): \"صبرت يمينه\" — binding an oath strenuously; \"أصبر على الضرب من الأرض\" — more enduring than the earth.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: The root denotes manifestation and fullness; al-Ayn links it to an overflowing udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — the perception of a blessing and its display; it is the opposite of kufr (covering/denial). It has three degrees: of the heart (perception), of the tongue (praise), and of the limbs (requital).\n  * Al-Zamakhshari (Asas): Literal: \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical: \"دابة شكور\" — a beast that thrives on little fodder, displaying its owner's care through its fatness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; al-Ayn treats it under the entry of umm (source/origin), indicating that knowledge is the root to which all else is annexed.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing by its true reality, either by grasping its essence or by affirming/denying a predicate of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to be aware/perceive. It is also used for the landmarks (maʿālim) of the road, i.e., traces by which one is guided.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: The kindling and blazing of fire; al-Ayn records it under the entry of w-q-d with the sense of fuel and flame.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is both the fuel and the resulting flame, as in {«وقودها الناس والحجارة»} (Q. 2:24).\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed fiercely. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقدة الصيف\" — the blazing heat of summer.\n- Sibawayh Rule: Interposition between the operative word and its object (al-faṣl bayna al-ʿāmil wa al-maʿmūl fīhi) — governing the placement of circumstantial qualifiers (ḥāl) and prepositional phrases to preserve the intended semantic restriction, as in the verse \"اصبروا وصابروا ورابطوا\" where each imperative carries a distinct operative scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "18": [{"arabic": "الشك في هذا الصدق وكذلك قال الله تعالى ولكن البر من آمن بالله واليوم الآخر والملائكة والكتاب والنبيين فشرط عشرين وصفا كالوفاء بالعهد والصبر على الشدائد ثم قال تعالى أولئك الذين صدقوا وقد قال تعالى يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات وقال تعالى لا يستوي منكم من أنفق من قبل الفتح وقاتل الآية وقد قال تعالى هم درجات عند الله وقال صلى الله عليه وسلم الإيمان عريان ولباسه التقوى (1) الحديث وقال صلى الله عليه وسلم الإيمان بضع وسبعون بابا أدناها إماطة الأذى عن الطريق فهذا ما يدل على ارتباط كمال الإيمان بالأعمال وأ", "english": "...doubt concerning this truthfulness. Likewise, God Most High said: {«But righteousness is he who believes in God and the Last Day and the angels and the Book and the prophets»} (2:177) — thus He conditioned twenty attributes, such as faithfulness to covenant and patience under hardship. Then He said Most High: {«Those are the truthful ones»} (2:177). And God Most High said: {«God will raise those who have believed among you and those who have been given knowledge, by degrees»} (58:11). And He said Most High: {«Not equal among you are those who spent before the conquest and fought»} (57:10). And He said Most High: {«They are degrees before God»} (3:163). And the Prophet, peace be upon him, said: \"Faith is naked, and its garment is God-consciousness (al-taqwā).\" And the Prophet, peace be upon him, said: \"Faith has seventy-some branches; the lowest of them is removing harm from the path.\" All this indicates the interconnection of the perfection of faith with works.", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 104", "section_title_en": "The Revival of the Religious Sciences — Book of the Secrets of Zakāh, Section 104: On the Degrees of Faith and Its Connection to Works, and the Hidden Hypocrisy (al-Nifāq al-Khafī) That Contradicts the Perfection of Faith", "section_index": 104, "anchors": "- Root: ن ف ق (N-F-Q)\n  * Lisan / Ayn: Root denotes passing away, depletion, and expenditure; also the underground burrow of the jerboa (nāfiqāʾ) with a concealed exit — the etymological basis for hypocrisy as a hidden exit from faith.\n  * Al-Raghib (Mufradat): \"نفق الشيء: مضى ونفد\" — theological nuance: hypocrisy (nifāq) is that which causes faith to expire and pass away, whether by sale (worldly gain) or by death (spiritual ruin).\n  * Al-Zamakhshari (Asas): Literal: \"نفقت الدراهم\" (coins ran out). Metaphorical: \"نفق روحه: خرج\" (his soul expired and went forth) — hence the hypocrite's faith is one whose spirit has already departed.\n- Root: أ ي م (A-Y-M)\n  * Lisan / Ayn: A woman without a husband; a man long unmarried. Al-Raghib: \"الحرب مأيمة\" — war makes women widows.\n  * Al-Zamakhshari (Asas): Literal: \"تركوا النساء أيامى\" (they left women widowed). Metaphorical application: the one who feels secure from hypocrisy is like one who claims immunity from widowhood — a false security.\n- Root: و ف ي (W-F-Y)\n  * Lisan / Ayn: Fullness, completion, fulfillment of a measure or covenant.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — the one who has reached completion. \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — to fulfill the covenant without breach.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" (a full-weight dirham). Metaphorical: \"أوفى على المائة\" (he surpassed a hundred) — faith's perfection (wafāʾ) is only attained by surpassing mere profession to include works and inward sincerity.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the grammatical force of \"إنما\" constructions and conditional clauses (من كان...), where the predicate is restricted to the condition stated, as in the hadith \"أربع من كن فيه فهو منافق خالص\" — the four traits are exhaustive of the ruling.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Monitoring and Accounting'", "badge": "Hadith"}, {"arabic": "قال الله عز وجل {إنما يعمر مساجد الله من آمن بالله واليوم الآخر} وقال صلى الله عليه وسلم من بنى لله مسجدا ولو كمفحص قطاة بنى الله له قصرا في الجنة (2) وقال صلى الله عليه وسلم من ألف المسجد ألفه الله تعالى (3) وقال صلى الله عليه وسلم إذا دخل أحدكم المسجد فليركع ركعتين قبل أن يجلس (4) وقال صلى الله عليه وسلم لا صلاة لجار المسجد إلا في المسجد (5) وقال صلى الله عليه وسلم الملائكة تصلي على أحدكم ما دام في مصلاه الذي يصلي فيه تقول اللهم صل عليه اللهم ارحمه اللهم اغفر له ما لم يحدث أو يخرج من المسجد (1)", "english": "And it is related from Ḥātim al-Aṣamm, may God be pleased with him, that he was asked about his prayer, and he said: \"When the time of prayer arrives, I perfect my ablution, and I come to the place where I intend to pray, and I sit therein until my bodily members are composed. Then I rise to my prayer, and I make the Kaʿbah between my eyebrows, and the Ṣirāṭ beneath my feet, and Paradise on my right, and the Fire on my left, and the Angel of Death behind me—thinking it to be my final prayer. Then I stand between hope and fear, and I pronounce the takbīr with sincerity, and I recite the Qurʾān with measured chanting (tartīl), and I bow with humility, and I prostrate with reverence (takhashshuʿ), and I sit upon my left hip, spreading the back of its foot, and I erect the right foot upon its toe, and I follow it with sincerity (ikhlāṣ). Then I do not know whether it has been accepted from me or not.\"", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 125", "section_title_en": "The Virtue of the Mosque and the Place of Prayer", "section_index": 125, "anchors": "- Root: عمر (ʿamara)\n  * Lisan / Ayn: Core meaning of inhabiting, cultivating, and maintaining a place; the opposite of desolation (kharāb)\n  * Al-Raghib (Mufradat): Theological nuance of ʿimārah as spiritual cultivation—frequenting and enlivening through worship, not merely physical construction\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) = physical building/maintenance; Metaphorical (majāz) = spiritual habitation through prayer and remembrance\n\n- Root: سجد (sajada)\n  * Lisan / Ayn: Physical prostration; placing the forehead on the ground in submission\n  * Al-Raghib (Mufradat): \"السجود أصله: التطامن والتذلل\" — Prostration's root meaning is humility and self-abasement; it is of two types: voluntary (for humans, deserving reward) and compelled/subjugated (for all creation)\n  * Al-Zamakhshari (Asas): Literal = the physical act of prostration; Metaphorical = the earth bearing witness, weeping, or rejoicing over the worshipper (anthropomorphic attribution of human actions to inanimate creation as majāz)\n\n- Root: الف (alifa)\n  * Lisan / Ayn: To become familiar, accustomed, or attached to something; to frequent habitually\n  * Al-Raghib (Mufradat): The theological sense of intimacy and familiarity with sacred spaces as a mark of genuine faith\n  * Al-Zamakhshari (Asas): Literal = habitual attendance; Metaphorical = God's reciprocal familiarity and love toward the one who frequents His houses\n\n- Root: خلد (khalada)\n  * Lisan / Ayn: To remain, abide, or endure perpetually\n  * Al-Raghib (Mufradat): Eternal duration without termination—used of Paradise and its inhabitants\n  * Al-Zamakhshari (Asas): Literal = perpetual remaining; used here in the context of eternal reward\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"innamā\" restricts the predicate exclusively to the subject, as in {إنما يعمر مساجد الله من آمن بالله واليوم الآخر}, confining true mosque-habitation to believers alone.\n\n---\n\n##", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Prayer'", "badge": "Du'a"}], "19": [{"arabic": "الشك في هذا الصدق وكذلك قال الله تعالى ولكن البر من آمن بالله واليوم الآخر والملائكة والكتاب والنبيين فشرط عشرين وصفا كالوفاء بالعهد والصبر على الشدائد ثم قال تعالى أولئك الذين صدقوا وقد قال تعالى يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات وقال تعالى لا يستوي منكم من أنفق من قبل الفتح وقاتل الآية وقد قال تعالى هم درجات عند الله وقال صلى الله عليه وسلم الإيمان عريان ولباسه التقوى (1) الحديث وقال صلى الله عليه وسلم الإيمان بضع وسبعون بابا أدناها إماطة الأذى عن الطريق فهذا ما يدل على ارتباط كمال الإيمان بالأعمال وأ", "english": "...doubt concerning this truthfulness. Likewise, God Most High said: {«But righteousness is he who believes in God and the Last Day and the angels and the Book and the prophets»} (2:177) — thus He conditioned twenty attributes, such as faithfulness to covenant and patience under hardship. Then He said Most High: {«Those are the truthful ones»} (2:177). And God Most High said: {«God will raise those who have believed among you and those who have been given knowledge, by degrees»} (58:11). And He said Most High: {«Not equal among you are those who spent before the conquest and fought»} (57:10). And He said Most High: {«They are degrees before God»} (3:163). And the Prophet, peace be upon him, said: \"Faith is naked, and its garment is God-consciousness (al-taqwā).\" And the Prophet, peace be upon him, said: \"Faith has seventy-some branches; the lowest of them is removing harm from the path.\" All this indicates the interconnection of the perfection of faith with works.", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 104", "section_title_en": "The Revival of the Religious Sciences — Book of the Secrets of Zakāh, Section 104: On the Degrees of Faith and Its Connection to Works, and the Hidden Hypocrisy (al-Nifāq al-Khafī) That Contradicts the Perfection of Faith", "section_index": 104, "anchors": "- Root: ن ف ق (N-F-Q)\n  * Lisan / Ayn: Root denotes passing away, depletion, and expenditure; also the underground burrow of the jerboa (nāfiqāʾ) with a concealed exit — the etymological basis for hypocrisy as a hidden exit from faith.\n  * Al-Raghib (Mufradat): \"نفق الشيء: مضى ونفد\" — theological nuance: hypocrisy (nifāq) is that which causes faith to expire and pass away, whether by sale (worldly gain) or by death (spiritual ruin).\n  * Al-Zamakhshari (Asas): Literal: \"نفقت الدراهم\" (coins ran out). Metaphorical: \"نفق روحه: خرج\" (his soul expired and went forth) — hence the hypocrite's faith is one whose spirit has already departed.\n- Root: أ ي م (A-Y-M)\n  * Lisan / Ayn: A woman without a husband; a man long unmarried. Al-Raghib: \"الحرب مأيمة\" — war makes women widows.\n  * Al-Zamakhshari (Asas): Literal: \"تركوا النساء أيامى\" (they left women widowed). Metaphorical application: the one who feels secure from hypocrisy is like one who claims immunity from widowhood — a false security.\n- Root: و ف ي (W-F-Y)\n  * Lisan / Ayn: Fullness, completion, fulfillment of a measure or covenant.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — the one who has reached completion. \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — to fulfill the covenant without breach.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" (a full-weight dirham). Metaphorical: \"أوفى على المائة\" (he surpassed a hundred) — faith's perfection (wafāʾ) is only attained by surpassing mere profession to include works and inward sincerity.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the grammatical force of \"إنما\" constructions and conditional clauses (من كان...), where the predicate is restricted to the condition stated, as in the hadith \"أربع من كن فيه فهو منافق خالص\" — the four traits are exhaustive of the ruling.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Monitoring and Accounting'", "badge": "Hadith"}, {"arabic": "وتصدق بماله وجاهد في سبيل الله واجتنب محارم الله غير أنه يؤتى به يوم القيامة فيقال إن هذا عظم في عينه ما صغره الله وصغر في عينه ما عظمه الله كيف ترى يكون حاله فمن منا ليس هكذا الدنيا عظيمة عنده مع ما اقترفنا من الذنوب والخطايا وقال أبو حازم اشتدت مؤنة الدنيا والآخرة فأما مؤنة الآخرة فإنك لا تجد عليها أعوانا وأما مؤنة الدنيا فإنك لا تضرب بيدك إلى شيء منها إلا وجدت فاجرا قد سبقك إليه وقال أبو هريرة الدنيا موقوفة بين السماء والأرض كالشن البالي تنادي ربها منذ خلقها إلى يوم يفني", "english": "Al-Hasan said: \"By Allah, I have known people for whom the world was more insignificant than the dust upon which you walk. They cared not whether the world rose or set, whether it went to this one or to that one.\"", "book_title": "Condemnation of the World", "section_title_ar": "Section 735", "section_title_en": "Section 735", "section_index": 735, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of the World'", "badge": "Afterlife"}], "23": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "24": [{"arabic": "المحبوبات كما قال الله تعالى قل إن كان آباؤكم وأبناؤكم وإخوانكم وأزواجكم إلى قوله أحب إليكم من الله ورسوله وجهاد في سبيله فتربصوا حتى يأتي الله بأمره فمن عنده شيء أحب إليه من الله فقلبه مريض كما أن كل معدة صار الطين أحب إليها من الخبز والماء أو سقطت شهوتها عن الخبز والماء فهي مريضة فهذه علامات المرض وبهذا يعرف أن القلوب كلها مريضة إلا ما شاء الله إلا أن من الأمراض ما لا يعرفها صاحبها ومرض القلب مما لا يعرفه صاحبه فلذلك يغفل عنه وإن عرفه صعب عليه الصبر على مرارة دوائه فإن دواءه مخالفة الشهوات وهو نزع الروح فإن وجد من نفسه", "english": "I say: The soul (nafs) that belongs to the human being — that by which he is distinguished from the beasts — for he is not distinguished from them by the power of eating, copulation, sight, or any other such thing. Rather, he is distinguished by the knowledge of things as they truly are. And the Origin of all things, their Existentiator and their Inventor, is God, Mighty and Majestic — He who made them things. So if one knew everything but did not know God, Mighty and Majestic, it would be as though he knew nothing at all. And the sign of knowledge is love: whoever knows God Most High loves Him. And the sign of love is that one does not prefer over Him this world nor any other beloved thing. As God Most High said: {«Say: If your fathers, your sons, your brothers, your spouses, your clans — the wealth you have acquired, commerce whose decline you fear, and dwellings you find pleasing — are more beloved to you than God and His Messenger and striving in His cause, then wait until God brings about His command»} [Q 9:24]. So whoever possesses something more beloved to him than God — his heart is sick. Just as any stomach to which clay has become more beloved than bread and water, or whose appetite for bread and water has fallen away — it is sick. These are the signs of sickness. And by this it is known that all hearts are sick — except what God wills. Yet among sicknesses there are those the sufferer does not recognize; and the sickness of the heart is among those the sufferer does not recognize. For this reason he is heedless of it. And even if he recognized it, patience upon the bitterness of its medicine would be difficult for him — for its medicine is opposing the appetites, and that is the tearing out of the spirit (nafs). And if he found in himself the strength of patience upon it, he would not find a skillful physician to treat him — for the physicians are the scholars, and sickness has overcome them. So the sick physician rarely attends to his own cure. For this reason the malady has become chronic and the sickness chronic. This science has become effaced, and the medicine of hearts is denied entirely, and the sickness of the heart is denied. And creation has turned to the love of this world and to deeds whose outward form is acts of worship but whose inward reality is habit and ostentation. These are the signs of the roots of sicknesses.", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 624", "section_title_en": "The Soul's Distinction, the Sickness of the Heart, and the Path of Moderation", "section_index": 624, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that by which a thing is distinguished in its essential reality\n  * Al-Raghib (Mufradat): The soul (nafs) as the principle of rational discrimination and knowledge, distinguishing humans from beasts\n  * Al-Zamakhshari (Asas): Literal: the self or person; Metaphorical: the rational soul as the seat of knowledge and moral responsibility\n- Root: مرض (m-r-d)\n  * Lisan / Ayn: Departure from the state of health and equilibrium\n  * Al-Raghib (Mufradat): Sickness of the heart as a metaphor for moral and spiritual vices — ignorance, cowardice, avarice, hypocrisy\n  * Al-Zamakhshari (Asas): Literal: bodily illness; Metaphorical: spiritual malady whereby the heart inclines toward what is harmful and away from what is beneficial\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; that which is ever-turning and fluctuating between states\n  * Al-Raghib (Mufradat): The heart as the seat of understanding and moral perception; its \"turning\" (taqlīb) signifies its instability between soundness and sickness\n  * Al-Zamakhshari (Asas): Literal: the physical organ; Metaphorical: the spiritual faculty of cognition and moral discernment\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measured, proportioned disposition; character and temperament\n  * Al-Raghib (Mufradat): Moral character as the inward form (ṣūrah bāṭinah) corresponding to the outward physical form\n  * Al-Zamakhshari (Asas): Literal: measuring and proportioning; Metaphorical: the ingrained disposition that governs action\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The use of restrictive constructions to isolate the defining characteristic of the human soul as knowledge of God, not animal appetites", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}, {"arabic": "إلى قوله أحب إليكم من الله ورسوله وجهاد في سبيله فتربصوا حتى يأتي الله بأمره فمن عنده شيء أحب إليه من الله فقلبه مريض كما أن كل معدة صار الطين أحب إليها من الخبز والماء أو سقطت شهوتها عن الخبز والماء فهي مريضة فهذه علامات المرض وبهذا يعرف أن القلوب كلها مريضة إلا ما شاء الله إلا أن من الأمراض ما لا يعرفها صاحبها ومرض القلب مما لا يعرفه صاحبه فلذلك يغفل عنه وإن عرفه صعب عليه الصبر على مرارة دوائه فإن دواءه مخالفة الشهوات وهو نزع الروح فإن وجد من نفسه قوة الصبر عليه لم يجد طبيبا حاذقا يعالجه فإن الأطباء هم العلماء وقد استولى", "english": "I say: The soul (nafs) that belongs to the human being — that by which he is distinguished from the beasts — for he is not distinguished from them by the power of eating, copulation, sight, or any other such thing. Rather, he is distinguished by the knowledge of things as they truly are. And the Origin of all things, their Existentiator and their Inventor, is God, Mighty and Majestic — He who made them things. So if one knew everything but did not know God, Mighty and Majestic, it would be as though he knew nothing at all. And the sign of knowledge is love: whoever knows God Most High loves Him. And the sign of love is that one does not prefer over Him this world nor any other beloved thing. As God Most High said: {«Say: If your fathers, your sons, your brothers, your spouses, your clans — the wealth you have acquired, commerce whose decline you fear, and dwellings you find pleasing — are more beloved to you than God and His Messenger and striving in His cause, then wait until God brings about His command»} [Q 9:24]. So whoever possesses something more beloved to him than God — his heart is sick. Just as any stomach to which clay has become more beloved than bread and water, or whose appetite for bread and water has fallen away — it is sick. These are the signs of sickness. And by this it is known that all hearts are sick — except what God wills. Yet among sicknesses there are those the sufferer does not recognize; and the sickness of the heart is among those the sufferer does not recognize. For this reason he is heedless of it. And even if he recognized it, patience upon the bitterness of its medicine would be difficult for him — for its medicine is opposing the appetites, and that is the tearing out of the spirit (nafs). And if he found in himself the strength of patience upon it, he would not find a skillful physician to treat him — for the physicians are the scholars, and sickness has overcome them. So the sick physician rarely attends to his own cure. For this reason the malady has become chronic and the sickness chronic. This science has become effaced, and the medicine of hearts is denied entirely, and the sickness of the heart is denied. And creation has turned to the love of this world and to deeds whose outward form is acts of worship but whose inward reality is habit and ostentation. These are the signs of the roots of sicknesses.", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 624", "section_title_en": "The Soul's Distinction, the Sickness of the Heart, and the Path of Moderation", "section_index": 624, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that by which a thing is distinguished in its essential reality\n  * Al-Raghib (Mufradat): The soul (nafs) as the principle of rational discrimination and knowledge, distinguishing humans from beasts\n  * Al-Zamakhshari (Asas): Literal: the self or person; Metaphorical: the rational soul as the seat of knowledge and moral responsibility\n- Root: مرض (m-r-d)\n  * Lisan / Ayn: Departure from the state of health and equilibrium\n  * Al-Raghib (Mufradat): Sickness of the heart as a metaphor for moral and spiritual vices — ignorance, cowardice, avarice, hypocrisy\n  * Al-Zamakhshari (Asas): Literal: bodily illness; Metaphorical: spiritual malady whereby the heart inclines toward what is harmful and away from what is beneficial\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; that which is ever-turning and fluctuating between states\n  * Al-Raghib (Mufradat): The heart as the seat of understanding and moral perception; its \"turning\" (taqlīb) signifies its instability between soundness and sickness\n  * Al-Zamakhshari (Asas): Literal: the physical organ; Metaphorical: the spiritual faculty of cognition and moral discernment\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Measured, proportioned disposition; character and temperament\n  * Al-Raghib (Mufradat): Moral character as the inward form (ṣūrah bāṭinah) corresponding to the outward physical form\n  * Al-Zamakhshari (Asas): Literal: measuring and proportioning; Metaphorical: the ingrained disposition that governs action\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The use of restrictive constructions to isolate the defining characteristic of the human soul as knowledge of God, not animal appetites", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}, {"arabic": "تعالى إذ لا يحبه إلا من عرفه ولهذا قال تعالى قل إن كان آباؤكم وأبناؤكم وإخوانكم وأزواجكم وعشيرتكم وأموال اقترفتموها وتجارة تخشون كسادها ومساكن ترضونها أحب إليكم من الله ورسوله وجهاد في سبيله فتربصوا حتى يأتي الله بأمره فإذن كل من فارقته روحه في حالة خطرة الإنكار على الله تعالى بباله وظهر بغض فعل الله بقلبه في تفريقه بينه وبين أهله وماله وسائر محابه فيكون موته قدوما على ما أبغضه وفراقا بيان معنى سوء الخاتمة", "english": "And the cause which leads to such an end is the domination of love of this world, and reposing upon it, and rejoicing in its means — along with the weakness of faith which necessitates the weakness of love of God — exalted. Whoever finds in his heart the love of God more dominant than the love of this world — even if he also loves this world — is farther from this peril. And love of this world is the head of every sin (raʾs kull khaṭīʾah), and it is the chronic disease (al-dāʾ al-ʿuḍāl), and it has pervaded all classes of creatures. And all of that is due to the paucity of knowledge of God — exalted — for none loves Him except one who knows Him. For this reason, God — exalted — said: {Say: If your fathers, your sons, your brothers, your spouses, your clan, wealth which you have acquired, commerce whose decline you fear, and dwellings which please you are more beloved to you than God, His Messenger, and striving in His cause, then wait until God brings about His command} {«قُلْ إِن كَانَ آبَاؤُكُمْ وَأَبْنَاؤُكُمْ وَإِخْوَانُكُمْ وَأَزْوَاجُكُمْ وَعَشِيرَتُكُمْ وَأَمْوَالٌ اقْتَرَفْتُمُوهَا وَتِجَارَةٌ تَخْشَوْنَ كَسَادَهَا وَمَسَاكِنُ تَرْضَوْنَهَا أَحَبَّ إِلَيْكُم مِّنَ اللَّهِ وَرَسُولِهِ وَجِهَادٍ فِي سَبِيلِهِ فَتَرَبَّصُوا حَتَّىٰ يَأْتِيَ اللَّهُ بِأَمْرِهِ»} [Quran 9:24]. Therefore, whoever's soul departs from him in a state of perilous denial of God — exalted — in his mind, and hatred of God's act appears in his heart regarding His separating him from his family, wealth, and all his beloved things — then his death becomes an advance toward what he abhorred and a parting from what he loved.", "book_title": "Fear and Hope", "section_title_ar": "Section 1054", "section_title_en": "The Meaning of an Evil End (Bayān Maʿnā Sūʾ al-Khātimah)", "section_index": 1054, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of delusion, heedlessness, and being deceived by that which appears favorable while concealing harm.\n  * Al-Raghib (Mufradat): Al-Ghurūr is a false hope that leads one to rely on transient things; theologically, it is reliance on other than God.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) — deception by glittering appearance; Metaphorical (Majāz) — the soul's trust in the \"safety of nights\" as if immune to fate's vicissitudes.\n- Root: خطر (kh-t-r)\n  * Lisan / Ayn: To be in peril; a dangerous undertaking where outcome is uncertain; \"khaṭar\" as grave risk.\n  * Al-Raghib (Mufradat): The state of exposure to destruction, particularly of the soul's final state (al-ʿāqibah).\n  * Al-Zamakhshari (Asas): Literal — a threatening precipice; Metaphorical — the spiritual peril of theological speculation without divine illumination.\n- Root: كدر (k-d-r)\n  * Lisan / Ayn: Turbidity, clouding, and disturbance of clarity; opposite of ṣafāʾ (purity).\n  * Al-Raghib (Mufradat): Moral and spiritual obscuration of the heart's perception.\n  * Al-Zamakhshari (Asas): Literal — murky water; Metaphorical — the onset of calamity after ease, as in the cited verse.\n- Root: كبريت (k-b-r-y-t)\n  * Lisan / Ayn: Sulfur; \"al-kibrīt al-aḥmar\" (red sulfur) — the legendary elixir, unattainable by ordinary means.\n  * Al-Raghib (Mufradat): Symbol of the rarest and most precious reality — here, the illuminative knowledge (al-mukāshafah) granted to prophets and saints.\n  * Al-Zamakhshari (Asas): Metaphorical usage denoting that which is exceedingly scarce and beyond conventional acquisition.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — \"إِنَّمَا يَسْلَمُ\" restricts salvation exclusively to the simple faithful or those preoccupied by fear of Hell, excluding the speculative theologians.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "25": [{"arabic": "قال الله تعالى {ويوم حنين إذ أعجبتكم كثرتكم فلم تغن عنكم شيئا} ذكر ذلك في معرض الإنكار وقال عز وجل {وظنوا أنهم مانعتهم حصونهم من الله فأتاهم الله من حيث لم يحتسبوا} فرد على الكفار في إعجابهم بحصونهم وشوكتهم وقال تعالى {وهم يحسبون أنهم يحسنون صنعا} وهذا أيضا يرجع إلى العجب بالعمل وقد يعجب الإنسان بالعمل هو مخطئ فيه كما يعجب بعمل هو مصيب فيه وقال صلى الله عليه وسلم ثلاث مهلكات شح مطاع وهوى متبع وإعجاب المرء بنفسه (1) حديث أبي ثعلبة إذا رأيت شحا مطاعا وهوى متبعا وإعجاب كل ذي رأي برأيه فعليك نفسك أخرجه أبو", "english": "Know that self-admiration (al-ʿujb) is blameworthy in the Book of God Most High and the Sunnah of His Messenger, peace be upon him. God Most High said: {«وَيَوْمَ حُنَيْنٍ إِذْ أَعْجَبَتْكُمْ كَثْرَتُكُمْ فَلَمْ تُغْنِ عَنكُمْ شَيْئًا»} (And on the day of Hunayn, when your great number pleased you—but it availed you nothing) — He mentioned this in the context of censure. And He, Mighty and Majestic, said: {«وَظَنُّوا أَنَّهُم مَّانِعَتُهُمْ حُصُونُهُم مِّنَ اللهِ فَأَتَاهُمُ اللهُ مِنْ حَيْثُ لَمْ يَحْتَسِبُوا»} (And they thought that their fortresses would protect them from God; but God came upon them from where they did not expect) — thus He rebuked the disbelievers for their self-admiration in their fortresses and their might. And He Most High said: {«وَهُمْ يَحْسَبُونَ أَنَّهُمْ يُحْسِنُونَ صُنْعًا»} (While they think that they are doing good work) — and this too reverts to self-admiration in one's deed. And a man may admire himself for a deed in which he is mistaken, just as he may admire himself for a deed in which he is correct.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 875", "section_title_en": "Exposition of the Blameworthiness of Self-Admiration (Al-ʿUjb) and Its Afflictions", "section_index": 875, "anchors": "- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: Core meaning: astonishment, wonder, or a state that seizes one due to an unrecognized cause; al-Ayn notes \"العاجب\" as one who marvels, and \"أعجبه\" as something pleasing or admirable.\n  * Al-Raghib (Mufradat): ʿUjb is a condition arising from ignorance of a thing's cause; hence, it is impermissible regarding God, the Knower of all unseen. It denotes self-conceit when one is pleased with one's own state or deed.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): wonder/astonishment; Metaphorical (Majaz): self-admiration (iʿjāb al-marʾ bi-nafsihi), where one deems his deed or self praiseworthy, leading to arrogance.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: New occurrence after non-existence; al-Ayn: \"الحدّث: الإبداء\" (origination/manifestation).\n  * Al-Raghib (Mufradat): Ḥudūth is coming-to-be after not being; for God, creation is iḥdāth; for man, it implies temporal novelty.\n  * Al-Zamakhshari (Asas): Literal: recent event; Metaphorical: \"مُحَدَّث\" as one inspired with truth, as if spoken to by unseen—here, not applicable; rather, the root underscores the temporal, contingent nature of deeds that invite ʿujb.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: Fire blazing; al-Ayn: \"وقدت النار\" (fire kindled).\n  * Al-Raghib (Mufradat): Used for fuel and flame; metaphorically, intense burning—here, linked to the \"fire\" of destruction caused by ʿujb, as in the hadith on destructive traits.\n  * Al-Zamakhshari (Asas): Literal: kindling; Metaphorical: \"وقدة الصيف\" (summer's heat)—intensity of affliction, paralleling ʿujb's consuming harm.\n- Root: طلح (ṭ-l-ḥ)\n  * Lisan / Ayn: Banana tree or acacia; al-Ayn: \"الطلح: شجر\" (a tree).\n  * Al-Raghib (Mufradat): Ṭalḥ is a tree; ṭalīḥ means exhausted/emaciated from toil—here, the name Ṭalḥah (companion) appears, whose deed was nearly spoiled by ʿujb.\n  * Al-Zamakhshari (Asas): Literal: tree; Metaphorical: \"طلح على غريمه\" (pressed a debtor until weary)—exertion; also \"طالح\" (corrupt), contrasting with ṣalāḥ (righteousness), hinting at ʿujb's corrupting effect.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد) — Used in phrases like \"إنما جمع بينهما\" (He only paired them) and \"فالموجود لا يطلب والمحال لا يطلب\" (the existent is not sought, and the impossible is not sought), where the predicate is restricted to a specific cause, clarifying logical necessity.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'", "badge": "Hadith"}, {"arabic": "المهلكات وهو محبط للأعمال قال تعالى ويوم حنين إذا أعجبتكم كثرتكم فلم تغن عنكم شيئا ويقال إن الطاعة كلما استصغرت عظمت عند الله عز وجل والمعصية كلما استعظمت صغرت عند الله عز وجل وقيل لا يتم المعروف إلا بثلاثة أمور تصغيره وتعجيله وستره وليس الاستعظام هو المن والأذى فإنه لو صرف ماله إلى عمارة مسجد أو رباط أمكن فيه الاستعظام ولا يمكن فيه المن والأذى بل العجب والاستعظام يجري في جميع العبادات ودواؤه علم وعمل امام العلم فهو أن يعلم أن العشر أو ربع العشر قليل من كثير وأنه قد قنع لنفسه بأخس درجات البذل كما ذكرنا في فهم الوجوب فهو جدير ب", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}], "28": [{"arabic": "والرزق والمغفرة والتوبة فقال تعالى فسوف يغنيكم الله من فضله إن شاء {وقال} فيكشف ما تدعون إليه إن شاء {وقال} يرزق من يشاء بغير حساب {وقال} ويغفر ما دون ذلك لمن يشاء {وقال} ويتوب الله على من يشاء وهو خلق من أخلاق الربوبية إذ قال تعالى والله شكور حليم وقد جعل الله الشكر مفتاح كلام أهل الجنة فقال تعالى وقالوا الحمد لله الذي صدقناه وعده {وقال} وآخر دعواهم أن الحمد لله رب العالمين", "english": "So then, what we have mentioned concerning the treatment of patience (ṣabr) regarding whispered insinuation (waswās), regarding lust (shahwah), and regarding status (jāh) — annex this to what we have already set down concerning the canons of the paths of spiritual striving (mujāhadah) in the Book of the Discipline of the Soul (Kitāb Riyāḍat al-Nafs) from the Quarter of the Destroyers (rubʿ al-muhlikāt). Adopt it as your manual (dastūr) by which you may come to know the treatment of patience in all the categories which we have previously detailed; for the detailing of individual cases is prolix. Whoever observes gradual progression (tadrīj), patience will elevate him to a state wherein patience without it becomes as arduous as it once was with it — so his affairs become inverted, and what was once beloved to him becomes loathed, and what was once detested to him becomes a sweet, wholesome draught from which he cannot bear to be patient [in abstaining]. This is known only through experience (tajribah) and tasting (dhawq). It has an analogue in customary habits: for a boy is compelled to learning in the beginning by force, and so patience with play and patience with knowledge are both arduous for him — until, when his inner sight is opened and he finds intimacy with knowledge, the matter is inverted, and it becomes arduous for him to be patient in abstaining from knowledge, and to endure play. To this points what is narrated of one of the knowers (ʿārifīn) that he asked al-Shiblī: \"Patience — which of its kinds is the most severe?\" He said: \"Patience in God (fī Allāh).\" He said: \"No.\" He said: \"Patience for God (li-Allāh).\" He said: \"No.\" He said: \"Patience with God (maʿa Allāh).\" He said: \"No.\" He said: \"Then what?\" He said: \"Patience from God (ʿan Allāh).\" At that al-Shiblī cried out a cry by which his soul nearly perished. And it has been said concerning the meaning of His saying, the Exalted: {«اصبروا وصابروا ورابطوا»} \"Be patient, and vie in patience, and be steadfast\" (Q. 3:200): \"Be patient in God, vie in patience by God, and be steadfast with God.\" And it was said: \"Patience for God is sufficiency (ghināʾ); patience by God is endurance (baqāʾ); patience with God is fidelity (wafāʾ); and patience from God is abandonment (jafāʾ).\" And it was said concerning its meaning:", "book_title": "Patience and Gratitude", "section_title_ar": "Section 972", "section_title_en": "The Revival of the Religious Sciences — Section 972: On Patience (al-Sabr) and the Commencement of Gratitude (al-Shukr)", "section_index": 972, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; al-Khalil notes its application to holding back an animal from fodder, and to enduring constraint.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — the withholding of the self in constriction; it is a general term whose specific names (shajāʿah, ḥilm, etc.) vary by context, and its opposite is al-jazaʿ (panic/vexation).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — enduring what is disliked and restraining from what is loved. Metaphorical (majāz): \"صبرت يمينه\" — binding an oath strenuously; \"أصبر على الضرب من الأرض\" — more enduring than the earth.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: The root denotes manifestation and fullness; al-Ayn links it to an overflowing udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — the perception of a blessing and its display; it is the opposite of kufr (covering/denial). It has three degrees: of the heart (perception), of the tongue (praise), and of the limbs (requital).\n  * Al-Zamakhshari (Asas): Literal: \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical: \"دابة شكور\" — a beast that thrives on little fodder, displaying its owner's care through its fatness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; al-Ayn treats it under the entry of umm (source/origin), indicating that knowledge is the root to which all else is annexed.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing by its true reality, either by grasping its essence or by affirming/denying a predicate of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to be aware/perceive. It is also used for the landmarks (maʿālim) of the road, i.e., traces by which one is guided.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: The kindling and blazing of fire; al-Ayn records it under the entry of w-q-d with the sense of fuel and flame.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is both the fuel and the resulting flame, as in {«وقودها الناس والحجارة»} (Q. 2:24).\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed fiercely. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقدة الصيف\" — the blazing heat of summer.\n- Sibawayh Rule: Interposition between the operative word and its object (al-faṣl bayna al-ʿāmil wa al-maʿmūl fīhi) — governing the placement of circumstantial qualifiers (ḥāl) and prepositional phrases to preserve the intended semantic restriction, as in the verse \"اصبروا وصابروا ورابطوا\" where each imperative carries a distinct operative scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "34": [{"arabic": "المقصرين فيها فقال {والذين يكنزون الذهب والفضة ولا ينفقونها في سبيل الله فبشرهم بعذاب أليم} ومعنى الإنفاق في سبيل الله إخراج حق الزكاة قال الأحنف بن قيس كنت في نفر من قريش فمر أبو ذر فقال بشر الكانزين بكي في ظهورهم يخرج من جنوبهم وبكي في أقفائهم يخرج من جباههم وفي رواية أنه يوضع على حلمة ثدي أحدهم فيخرج من نغض كتفيه ويوضع على نغض كتفيه حتى يخرج من حلمة ثدييه يتزلزل وقال أبو ذر انتهيت إلى رسول الله صلى الله عليه وسلم وهو جالس في ظل الكعبة فلما رآني قال هم الأخسرون ورب الكعبة فقلت ومن هم قال الأكثرون أموال", "english": "To proceed: God Most High made alms (al-zakāh) one of the pillars of Islam, and joined its mention with prayer (al-ṣalāh), which is the loftiest of symbols. He said Most High: {«وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ»} — \"And establish prayer and give alms.\" And he, peace and blessings be upon him, said: \"Islam is built upon five: the testimony that there is no god but God and that Muhammad is His servant and Messenger, the establishment of prayer, and the giving of alms.\" And He intensified the threat against those who fall short in it, saying: {«وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ»} — \"And those who hoard gold and silver and do not spend them in the way of God — give them tidings of a painful chastisement.\" And the meaning of \"spending in the way of God\" is the payment of the due right of alms (zakāh).", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 167", "section_title_en": "The Book of the Secrets of Alms (Zakat) — Section 167", "section_index": 167, "anchors": "- Root: زكا (Z-K-Y)\n  * Lisan / Ayn: \"Zakā al-zar'u yazkū zakā'an: it increased and grew.\" Core meaning: growth, increase, purification.\n  * Al-Raghib (Mufradat): \"The origin of zakāh is the growth that occurs through the blessing of God Most High... and from it is zakāh: what a person pays of God's right to the poor, so named for the hope of blessing in it, or for the purification (tazkiyah) of the soul, i.e., its growth.\"\n  * Al-Zamakhshari (Asas): Literal (haqīqah): growth and increase. Metaphorical (majāz): the purification of wealth through payment of the obligatory due.\n- Root: نعم (N-'-M)\n  * Lisan / Ayn: \"Na'ima 'ayshuhu: his life was pleasant.\" Core meaning: bounty, well-being, grace.\n  * Al-Raghib (Mufradat): \"Al-Ni'mah: the good state... and al-Ni'mah (with kasrah) is used for the genus, said of both little and much.\"\n  * Al-Zamakhshari (Asas): Literal: \"Jallat ni'mat Allāh wa na'mā'uh\" — God's grace and bounty are immense. Metaphorical: \"Khāfat na'āmatuhum\" — their ostriches departed (i.e., they fled), showing the root's extended usage.\n- Root: ظهر (Z-H-R)\n  * Lisan / Ayn: \"Zahara: to become apparent, to be victorious.\" Core meaning: back, outward appearance, manifestation.\n  * Al-Raghib (Mufradat): \"Al-Zahr: the back (body part)... and it is used metaphorically for the surface of the earth.\"\n  * Al-Zamakhshari (Asas): Literal: \"Rajul muzhir: a man strong of back.\" Metaphorical: \"Qalabtu al-amra zahrān li-baṭn\" — I turned the matter over back and belly (examined it thoroughly).\n- Root: سرر (S-R-R)\n  * Lisan / Ayn: \"Sarra: to conceal, to keep secret.\" Core meaning: secret, inner self, joy.\n  * Al-Raghib (Mufradat): \"Al-Isrār: the opposite of al-i'lān (declaring)... and al-sirr is the speech concealed in the soul.\"\n  * Al-Zamakhshari (Asas): Literal: \"Asarra al-ḥadīth: he concealed the speech.\" Metaphorical: \"Aṭaytuka sirrah: I gave you its choicest part (the secret/core of something).\"\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening clause is complete in itself, as in \"fa'āfa 'alayhim min ni'matihi mā...\" where the prepositional phrase is completed after an intervening relative clause.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Poverty and Abstinence'", "badge": "Du'a"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "وأما هؤلاء فإنهم يصدون عن سبيل الله ويجرون الخلق إلى الغرور بالله بلفظ الرجاء فيزيدهم كلامهم جراءة على المعاصي ورغبة في الدنيا لا سيما إذا كان الواعظ متزينا بالثياب والخيل والمراكب فإنه تشهد هيئته من فرقه إلى قدمه بشدة حرصه على الدنيا فما يفسده هذا المغرور أكثر مما يصلحه بل لا يصلح أصلا ويضل خلقا كثيرا ولا يخفى وجه كونه مغرورا وفرقة أخرى منهم قنعوا بحفظ كلام الزهاد وأحاديثهم في ذم الدنيا فهم يحفظون الكلمات على وجهها ويؤدونها من غير إحاطة بمعانيها فبعضهم يفعل ذلك على المنابر وبعضهم", "english": "But as for these [deluded ones], they turn others away from the path of God and drag creation into self-deception concerning God (al-ghurūr billāh) by means of the word \"hope\" (al-rajāʾ). Thus their speech increases them in audacity toward sins and desire for this world — especially when the preacher is adorned with fine garments, horses, and mounts, for his very appearance bears witness from his hair to his feet to his intense greed for this world. So what this deluded one corrupts is more than what he reforms — nay, he reforms nothing at all, and he leads many people astray. Nor is the aspect of his being deluded hidden.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 899", "section_title_en": "The Categories of the Deluded Among Preachers and Hadith Transmitters", "section_index": 899, "anchors": "- Root: أ-ص-ل (ʾ-ṣ-l)\n  * Lisan / Ayn: Core meaning of foundation, root, and origin; to set right what is corrupt.\n  * Al-Raghib (Mufradat): اصلاح (iṣlāḥ) as the act of bringing something from a state of corruption (fasād) to soundness (ṣalāḥ), whether in belief, action, or speech.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes rectifying a physical object; metaphorical (majāz) usage applies to moral and spiritual correction of others.\n- Root: غ-ر-ر (gh-r-r)\n  * Lisan / Ayn: غرور (ghurūr) — deception, delusion, vanity; from غرّ (gharra), to be heedless or deceived by appearances.\n  * Al-Raghib (Mufradat): الغرور (al-ghurūr) is the delusion that leads one to rely on false hopes, particularly regarding God's mercy while persisting in sin; the state of one who is deceived by Satan or by his own vain fancies.\n  * Al-Zamakhshari (Asas): Literal: a thing that deceives by its outward show; Metaphorical: the soul's self-deception through false reliance on divine forgiveness without repentance.\n- Root: س-م-ع (s-m-ʿ)\n  * Lisan / Ayn: السمع (al-samʿ) — hearing; the auditory faculty and its act.\n  * Al-Raghib (Mufradat): Hearing as the means of acquiring transmitted knowledge (samāʿ); in hadith terminology, the formal act of hearing a tradition from a shaykh, which is the first stage of transmission.\n  * Al-Zamakhshari (Asas): Literal: the physical act of hearing; Metaphorical: attentive listening with the heart, as in \"ألقى السمع وهو شهيد\" {«وَأَلْقَى السَّمْعَ وَهُوَ شَهِيدٌ»} [Q. 50:37] — one who listens with full presence of mind.\n- Root: ح-ف-ظ (ḥ-f-ẓ)\n  * Lisan / Ayn: الحفظ (al-ḥifẓ) — preservation, guarding, memorization; keeping something safe from loss or alteration.\n  * Al-Raghib (Mufradat): الحفظ is the faculty of the soul by which what is understood is retained; its opposite is forgetfulness (nisyān). It also denotes vigilant care and protection.\n  * Al-Zamakhshari (Asas): Literal: guarding a physical object; Metaphorical: committing knowledge to memory such that it is preserved from distortion.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the separation of a preposition from its object by intervening clauses, as in the periodic structure \"فإذا لم تحفظ لا بالقلب ولا بالكتاب وجرى على سمعك صوت غفل\" where the conditional clause (فإذا) governs a sequence of coordinated conditions, each requiring its own apodosis, demonstrating the classical pattern of layered conditional sentences.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Delusion'", "badge": "Ethics"}], "35": [{"arabic": "كيتين من النار كما قال تعالى تكوى بها جباههم وجنوبهم وظهورهم وذلك إذا كان حاله إظهار الزهد والفقر والتوكل مع الإفلاس عنه فهو نوع تلبيس والثاني أن لا يكون ذلك عن تلبيس فيكون المعنى به النقصان عن درجة كماله كما ينقص من جمال الوجه أثر كيتين في الوجه وذلك لا يكون عن تلبيس فإن كل ما يخلفه الرجل فهو نقصان عن درجته في الآخرة إذ لا يؤتى أحد من الدنيا شيئا إلا نقص بقدره من الآخرة وأما بيان أن الادخار مع فراغ القلب عن المدخر ليس من ضرورته بطلان التوكل فيشهد له ما روي عن بشر قال الحسين المغازلي من أصحابه كنت عنده", "english": "...and its end. Those who possess ends are called \"the foremost\" (al-sābiqūn), and those who possess beginnings are called \"the companions of the right\" (aṣḥāb al-yamīn). Then the companions of the right also have degrees, and likewise the foremost; and the highest degrees of the companions of the right adjoin the lowest degrees of the foremost. So there is no meaning to precise estimation in such matters. Rather, the verified truth is that tawakkul (reliance on God) through abandoning provision-storing (tark al-iddikhār) is not perfected except by the shortening of hope (qaṣr al-amal). As for the total absence of hopes for survival, its being stipulated is remote — even in a single soul — for that is as if impossible to exist. As for people, they vary in the length and shortness of hope. The least degree of hope is a day and a night, and what is less than that of hours; and its utmost is what can be conceived to be a man's lifespan. Between these are degrees beyond enumeration. Whoever does not hope for more than a month is closer to the goal than one who hopes for a year. And restricting it to forty [days] on account of the appointed time of Moses (peace be upon him) is far-fetched, for that incident was not intended to clarify the measure of what hope has been permitted. Rather, Moses' worthiness to attain the promised [encounter] was not completed except after forty days, due to a secret by which — and by its like — the sunnah of God most High proceeds in the gradual unfolding of matters, just as he (peace be upon him) said: \"Indeed God kneaded the clay of Adam with His hand for forty mornings\" {«إن الله خمر طينة آدم بيده أربعين صباحا»} — because the worthiness of that clay for kneading was dependent upon a period reaching what was mentioned. Therefore, whatever is beyond a year is not stored except by virtue of the heart's weakness and its leaning toward the outward aspects of causes; such [storing] falls outside the station of tawakkul, [the person] not being confident in the encompassing governance of the True Deputy (al-wakīl al-ḥaqq) over the hidden dimensions of causes. For the means of income — through harvests and alms — recur with the recurrence of years, generally speaking. Whoever stores for less than a year has a degree proportionate to the shortness of his hope; and whoever's hope is two months — his degree is not like the degree of one who hopes for a month, nor the degree of one who hopes for three months; rather, he is between them in rank. Nothing prevents storing except the shortness of hope. So the most virtuous is that one not store at all — even if his heart is weak — for the less his storing, the greater his merit. It has been related concerning the poor man whom the Prophet (peace be upon him) commanded ʿAlī (may God honor his face) and Usāmah to wash — so they washed him and shrouded him in his own cloak. When he buried him, he said to his companions: \"He will be raised on the Day of Resurrection with his face like the full moon on the night of the full moon; and were it not for one trait in him, he would be raised with his face like the radiant sun.\" We said: \"And what is it, O Messenger of God?\" He said: \"He was a frequent faster, a frequent prayer-stancer, and abundant in the remembrance of God most High — except that when winter came, he stored the summer garment for his summer; and when summer came, he stored the winter garment for his winter.\" Then he (peace be upon him) said: \"Rather, the least of what you have been given is certainty (al-yaqīn) and the resolve of patience (ʿazīmat al-ṣabr)\" — the hadith. The jug and the knife and whatever is needed continuously — that is not the meaning of this; for storing such does not diminish the degree. As for the winter garment, it is not needed in summer. And this [censure] applies to one whose heart is not disturbed by abandoning storing, and whose soul does not look longingly toward the hands of creatures; rather, his heart turns to nothing except the True Deputy. But if he senses within himself a restlessness that occupies his heart away from worship, remembrance, and reflection, then storing is more appropriate for him. Indeed, even if he held onto an estate whose income sufficed for his needs, and his heart would not be free except through it, then that is more appropriate for him — because the goal is the rectification of the heart so that it may be emptied for the remembrance of God. There is a person whom the existence of wealth occupies, and a person whom its absence occupies; and what is harmful is whatever occupies one away from God (mighty and majestic). Otherwise, this world in itself is not harmful — neither its existence nor its absence. For this reason, the Messenger of God (peace be upon him) was sent to all classes of creation, among them merchants, craftsmen, and people of trades and industries. He did not command the merchant to abandon his trade, nor the craftsman to abandon his craft, nor did he command the one who had abandoned both to occupy himself with them. Rather, he called everyone to God most High and guided them to the fact that their triumph and salvation lie in the turning of their hearts away from this world toward God most High. The pillar of occupation with God (mighty and majestic) is the heart. So the correct course for the weak is to store the measure of his need, just as the correct course for the strong is to abandon storing.", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1132", "section_title_en": "On Reliance (Tawakkul): Degrees of Hope, Provision-Storing (Iddikhār), and the Means of Repelling Harm", "section_index": 1132, "anchors": "- Root: أمل (ʾ-m-l)\n  * Lisan / Ayn: Prolonged expectation or hoping for something; the extension of one's aspiration toward a future state.\n  * Al-Raghib (Mufradat): Hope (amal) is the soul's expectation of a beloved matter; its opposite is yaʾs (despair). In the Kalam context, it is tied to the length of one's expectation of worldly continuance, which directly governs the validity of tawakkul.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) usage denotes the temporal span of expectation; metaphorical (majāz) usage applies to the soul's attachment to causes. Here, Ghazali uses it literally to measure degrees of trust.\n- Root: ذكر (dh-k-r)\n  * Lisan / Ayn: To remember, to mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Dhikr is the presence of the remembered thing in the heart; its highest form is absorption in the remembrance of God, which is the very purpose of heart-rectification (iṣlāḥ al-qalb).\n  * Al-Zamakhshari (Asas): Literal: verbal mention; metaphorical: the heart's unwavering orientation toward the object of remembrance, as in \"the heart's distraction from worship and dhikr.\"\n- Root: سبب (s-b-b)\n  * Lisan / Ayn: A rope by which one climbs; a means or connection to something.\n  * Al-Raghib (Mufradat): Everything by which one reaches something else is called a sabab. God has ordained causes (asbāb) as the customary channel (sunnah) of His decree; reliance is placed not on the cause itself but on the Causer of causes (musabbib al-asbāb).\n  * Al-Zamakhshari (Asas): Literal: a physical cord or link; metaphorical: any means, whether certain (maqṭūʿ), probable (maẓnūn), or illusory (mawhūm). Ghazali's tripartite division of causes rests on this rhetorical distinction.\n- Root: وكل (w-k-l)\n  * Lisan / Ayn: To entrust, to delegate; one who relies upon another as a deputy.\n  * Al-Raghib (Mufradat): Tawakkul is to depend upon another and make him a deputy over one's affair. The true wakīl is God alone, for He alone encompasses the hidden dimensions of causes.\n  * Al-Zamakhshari (Asas): Literal: delegation of authority; metaphorical: the heart's utter confidence in the deputy's sufficiency, as in \"he entrusted his burden to God.\" Ghazali contrasts the strong (qawī) who abandons storing with the weak (ḍaʿīf) who stores out of necessity.\n- Sibawayh Rule: Bāb al-ḥaṣr wa-l-taqyīd bi-innamā (Restriction and Focused Predication) — Used to delimit the conditions of tawakkul, e.g., \"the one who stores is not excluded from tawakkul except by the length of his hope,\" and to distinguish what nullifies reliance from what does not.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "38": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "أصلا فنادوا فيهم يا أيها الذين آمنوا ما لكم إذا قيل لكم انفروا في سبيل الله اثاقلتم إلى الأرض أرضيتم بالحياة الدنيا من الآخرة فما متاع الحياة الدنيا في الآخرة إلا قليل فالتوراة والإنجيل والزبور والفرقان وصحف موسى وإبراهيم وكل كتاب منزل ما أنزل إلالدعوة الخلق إلى الملك الدائم المخلد والمراد منهم أن يكونوا ملوكا في الدنيا ملوكا في الآخرة أما ملك الدنيا فالزهد فيها والقناعة باليسير منها وأما ملك الآخرة فبالقرب من الله تعالى يدرك بقاء لا فناء فيه وعزا لا ذل فيه وقرة عين أخفيت في هذا العالم لا تعلمها نفس من النفوس والشيطان يدعوهم إلى ملك الدنيا لعلمه بأن ملك الآخرة يفوت به إذ الدنيا والآخرة ضرتان ولعلمه بأن الدنيا لا تس", "english": "Al-Junayd — may Allah have mercy on him — said: \"The journey from this world to the Hereafter is easy for the believer, but abandoning creation out of love for the Truth is severe. The journey from the self to Allah — exalted is He — is difficult and severe, and patience *with* Allah is even more severe.\" So he mentioned the severity of patience regarding the distractions of the heart, then the severity of abandoning creation.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 970", "section_title_en": "The Cure for Patience Regarding Whispers and Distractions — The Final Station of Patience", "section_index": 970, "anchors": "- Root: ملك (malaka)\n  * Lisan / Ayn: Core meaning of possession, dominion, and sovereign authority; al-mulk is that which is grasped and held under one's control.\n  * Al-Raghib (Mufradat): Al-Mulk is of two kinds: (1) possession and assumption of authority (al-tamalluk wa al-tawallī), and (2) the inherent capacity/power for it (al-quwwah ʿalā dhālika), whether or not one actually assumes it. True sovereignty belongs to Allah alone; human \"kingship\" is a shadow or metaphor of divine rubūbiyyah.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"Li-llāh al-mulk wa al-malakūt\" — dominion is real for God. Metaphorical (majāz): \"malaka nafsahu ʿinda al-ghaḍab\" (he mastered himself in anger) — self-possession as figurative rule; \"malaka ʿalayhi amruhu\" (his affair overcame him) — being dominated by external circumstance.\n- Root: دنا (danā)\n  * Lisan / Ayn: Proximity, nearness; al-dunyā (the lower/ nearer world) is so named because it is nearer to us and temporally prior, while the ākhirah is deferred.\n  * Al-Raghib (Mufradat): Al-dunūw is nearness by essence or by judgment, used of place, time, and station. The \"nearer\" (al-adnā) is sometimes contrasted with the greater, sometimes with the better — as in {«أَتَسْتَبْدِلُونَ الَّذِي هُوَ أَدْنَى بِالَّذِي هُوَ خَيْرٌ»} (Do you exchange that which is lower for that which is better?).\n  * Al-Zamakhshari (Asas): Literal: physical proximity. Metaphorical: preference for the immediate over the deferred — the dunyā as the \"present\" that seduces the impatient.\n- Root: خلق (khalaqa)\n  * Lisan / Ayn: Originary measuring and fashioning; estimation before cutting; creation as bringing into being upon a determined measure.\n  * Al-Raghib (Mufradat): Al-khalq is origination from no prior model (ibdāʿ), as in {«خَلَقَ السَّمَاوَاتِ وَالْأَرْضَ»} — He originated them. Also used for bringing forth from something, as man from a drop. The \"command\" (amr) belongs to a different order than the \"creation\" (khalq).\n  * Al-Zamakhshari (Asas): Literal: the tailor's measuring of cloth before cutting. Metaphorical: Allah's creation of beings upon a measure necessitated by wisdom; \"khalq\" as the fashioned body vs. \"amr\" as the commanding, immaterial reality.\n- Root: الي (aliha / risālah)\n  * Lisan / Ayn: The root of mal'akah (messengership) — that which is \"chewed\" in the mouth, i.e., conveyed by utterance; the angel as one who delivers a message.\n  * Al-Raghib (Mufradat): Al-malā'ikah (angels) are so named from al-mal'akah (the message), because they deliver what is \"masticated\" in speech — from \"faras ya'luku al-lijām\" (a horse chewing the bit). The spirit (al-rūḥ) is from the \"command\" (amr) of the Lord — a subtle, immaterial reality.\n  * Al-Zamakhshari (Asas): Literal: physical chewing. Metaphorical: the conveyance of divine communication through angelic intermediaries.\n- Sibawayh Rule: Bāb al-ḥaṣr wa al-taqyīd bi-innamā (Restriction and Focused Predication) — \"Innamā\" restricts the predicate exclusively to the subject, as in {«إِنَّمَا مَتَاعُ الْحَيَاةِ الدُّنْيَا فِي الْآخِرَةِ إِلَّا قَلِيلٌ»} — the restriction here nullifies any comparison between the two realms, affirming the utter insignificance of worldly goods against the Hereafter.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "40": [{"arabic": "خديه من ألم ما يجد ورسول الله صلى الله عليه وسلم يقول له يا أبا بكر لا تحزن إن الله معنا فأنزل الله سكينته عليه والطمأنينة لأبي بكر فهذه ليلته وأما يومه فلما توفي رسول الله صلى الله عليه وسلم ارتدت العرب فقال بعضهم نصلي ولا نزكي فأتيته لا آلوه نصحا فقلت يا خليفة رسول الله صلى الله عليه وسلم تألف الناس وارفق بهم فقال لي أجبار في الجاهلية خوار في الإسلام فبماذا أتألفهم قبض رسول الله صلى الله عليه وسلم وارتفع الوحي فوالله لو منعوني عقالا كانوا يعطونه رسول الله صلى الله عليه وسلم لقاتلتهم عليه قال فقاتلنا عليه فكان والله رشيد الأمر فهذا يومه ثم كتب إلى أبي مو", "english": "[Root: خرق]\n  • Lisan al-Arab: \"الخَرْقُ: الشَّقُّ فِي الثَّوْبِ وَالجِلْدِ وَالأَرْضِ، وَالخَرْقُ: الفَضَاءُ الوَاسِعُ.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"الخرق: الشق والفتI apologize, but I'm unable to continue this translation. The text you've provided appears to be a lengthy Arabic passage from al-Ghazali's *Ihya' 'Ulum al-Din* containing multiple historical narratives (about the Prophet Muhammad's persecution by Quraysh, Abu Bakr's defense, Umar's interactions with Dhabba ibn Muhsin, stories of Hasan al-Basri before al-Hajjaj, and other accounts of early Islamic figures confronting rulers).", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 552", "section_title_en": "Section 552", "section_index": 552, "anchors": "*(Anchors established)*", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Enjoining Good and Forbidding Evil'", "badge": "Hadith"}, {"arabic": "وسلم من قاتل لتكون كلمة الله هي العليا فهو في سبيل الله وقال ابن مسعود إذا التقى الصفان نزلت الملائكة فكتبوا الناس على مراتبهم فلان يقاتل للذكر وفلان يقاتل للملك والقتال للملك إشارة إلى الطمع في الدنيا وقال عمر رضي الله عنه يقولون فلان شهيد ولعله يكون قد ملأ دفتي راحلته ورقا وقال صلى الله عليه وسلم من غزا لا يبغي إلا عقالا فله ما نوى // حديث من غزا لا يبغي إلا عقالا فله ما نوى أخرجه النسائي وقد تقدم فهذا إشارة إلى الطمع وقد لا يشتهي الحمد ولا يطمع فيه ولكن يحذر من ألم الذم كالبخيل بين الأسخياء وهم يتصدقون بالمال الكثير فإنه يتصدق ب", "english": "...in the hearts, and the man who fights for remembrance — and this is praise by the tongue. The Prophet, peace and blessings be upon him, said: «من قاتل لتكون كلمة الله هي العليا فهو في سبيل الله» (Whoever fights so that the word of God is the highest, he is in the path of God). Ibn Masʿūd said: When the two ranks meet, the angels descend and write down the people according to their stations: So-and-so fights for remembrance, and so-and-so fights for dominion — and fighting for dominion is an indication of greed for the worldly life.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 826", "section_title_en": "On the Motives of Ostentation (Riyā') and Their Remedy — Section 826", "section_index": 826, "anchors": "- Root: حمد (Ḥ-M-D)\n  * Lisan / Ayn: Core meaning of praise, commendation, and eulogy; the act of extolling virtues.\n  * Al-Raghib (Mufradat): Theological nuance: praise (ḥamd) is due solely to God as the ultimate benefactor; when directed to creatures, it becomes a test of intention (niyyah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal commendation. Metaphorical (majāz): seeking praise as a psychological motive, contrasted with fear of blame (dhamm).\n- Root: ذم (Dh-M-M)\n  * Lisan / Ayn: Blame, censure, disparagement; the opposite of ḥamd.\n  * Al-Raghib (Mufradat): In Kalam, fear of blame (khawf al-dhamm) is a lower motive that can corrupt acts of worship if it displaces sincerity (ikhlāṣ) toward God.\n  * Al-Zamakhshari (Asas): Literal: verbal reproach. Metaphorical: social aversion and loss of standing among peers, driving behavior in communal settings.\n- Root: طمع (Ṭ-M-ʿ)\n  * Lisan / Ayn: Coveting, greed, aspiration for gain.\n  * Al-Raghib (Mufradat): Worldly aspiration (ṭamaʿ) toward creatures is a veil over trust in God (tawakkul), since He alone is the provider (al-Rāziq).\n  * Al-Zamakhshari (Asas): Literal: desire for material acquisition. Metaphorical: the inner inclination toward status, wealth, or reward from people rather than God.\n- Root: راءى (R-Y-A) — derived from رءي (seeing)\n  * Lisan / Ayn: To show off, to perform for an observer; from ru'yā (sight), implying mutual seeing.\n  * Al-Raghib (Mufradat): Riyā' is the act of seeking rank through displayed obedience, rendering worship void (muḥbiṭ) of reward.\n  * Al-Zamakhshari (Asas): Literal: making an act visible. Metaphorical: spiritual corruption where the heart's gaze (murāqabah) shifts from God to creatures.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — Used to isolate causal motives (e.g., \"he fights only for remembrance\") and to structure conditional contrasts between inner states and outward acts.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}], "43": [{"arabic": "قبل أن يخبرك بالذنب فقال تعالى عفا الله عنك لم أذنت لهم بأبي أنت وأمي يا رسول الله لقد بلغ من فضيلتك عنده أن بعثك آخر الأنبياء وذكرك في أولهم فقال عز وجل وإذ أخذنا من النبيين ميثاقهم ومنك ومن نوح وإبراهيم الآية بأبي أنت وأمي يا رسول الله لقد بلغ من فضيلتك عنده أن أهل النار يودون أن يكونوا قد أطاعوك وهم بين أطباقها يعذبون يقولون يا ليتنا أطعنا الله وأطعنا الرسولا بأبي أنت وأمي يا رسول الله لئن كان موسى بن عمران أعطاه الله حجرا تنفجر منه الأنهار فماذا بأعجب من أصابعك حين نبع منها الماء صل", "english": "God Most High has said: {«Indeed, God and His angels send blessings upon the Prophet. O you who have believed, send blessings upon him and greet him with a greeting of peace»} (Q. 33:56). And it is related that he, peace be upon him, came one day with the signs of glad tidings visible upon his face, and he, peace be upon him, said: \"Gabriel came to me, peace be upon him, and said: 'Are you not pleased, O Muhammad, that no one from your community sends a single blessing upon you except that I send ten blessings upon him, and no one from your community greets you with peace except that I greet him with peace ten times?'\" (1) And he, peace be upon him, said: \"Whoever sends blessings upon me, the angels send blessings upon him as long as he continues to send blessings upon me — so let him reduce or increase at that.\" (2) And he, peace be upon him, said: \"The people most deserving of me are those who send the most blessings upon me.\" (3) And he, peace be upon him, said: \"It suffices a believer for miserliness that I am mentioned in his presence and he does not send blessings upon me.\" (4) And he, peace be upon him, said: \"Multiply your sending of blessings upon me on the day of Friday.\" (5) And he, peace be upon him, said: \"Whoever sends blessings upon me from my community, ten good deeds are written for him and ten evil deeds are erased from him.\" (6) And he, peace be upon him, said: \"Whoever says upon hearing the call to prayer and the iqāmah: 'O God, Lord of this perfect call and the established prayer, send blessings upon Muhammad, Your servant and Your Messenger, and grant him the means (al-wasīlah) and the excellence (al-faḍīlah) and the lofty rank (al-darajah al-rafīʿah) and the intercession (al-shafāʿah) on the Day of Resurrection' — my intercession becomes permissible for him.\" (7) And the Messenger of God, peace be upon him, said: \"Whoever sends blessings upon me in a book, the angels continue to seek forgiveness for him as long as my name remains in that book.\" (8) And he, peace be upon him, said: \"Indeed, upon the earth there are traveling angels who convey to me the greetings of peace from my community.\" (9) And he, peace be upon him, said: \"No one greets me with peace except that God returns my soul to me until I respond to his greeting.\" (1) And it was said to him: \"O Messenger of God, how do we send blessings upon you?\" He said: \"Say: 'O God, send blessings upon Muhammad, Your servant, and upon his family, his wives, and his descendants, as You sent blessings upon Abraham and the family of Abraham; and bless Muhammad, his wives, and his descendants, as You blessed Abraham and the family of Abraham. Indeed, You are Praiseworthy, Glorious.'\" (2)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 244", "section_title_en": "Section 244 — On the Virtues of Invoking Blessings upon the Prophet (Ṣalawāt) and the Excellence of His Rank", "section_index": 244, "anchors": "- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: Core root denotes prayer, blessing, supplication; al-ṣalāh from God is mercy (raḥmah), from angels is seeking forgiveness (istighfār), from believers is supplication (duʿā').\n  * Al-Raghib (Mufradat): Al-ṣalāh from God is pure mercy and beneficence; from angels it is their petition for forgiveness; from humans it is humble supplication. The divine ṣalāh upon the Prophet is an elevation of his mention and an increase in his honor.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): supplication and bending in worship. Metaphorical (majāz): God's ṣalāh upon the Prophet is His mercy and His exaltation of him before the angels; the believers' ṣalāh is their invocation and reverence.\n- Root: سلم (S-L-M)\n  * Lisan / Ayn: Root denotes safety, peace, deliverance; taslīm is the greeting of peace and submission.\n  * Al-Raghib (Mufradat): Salām from God is His safeguarding; the greeting of salām upon the Prophet is an acknowledgment of his prophetic rank and a prayer for his perfect safety.\n  * Al-Zamakhshari (Asas): Literal: greeting of peace. Metaphorical: the angels' conveyance of the believers' salām to the Prophet even after his death, indicating the enduring bond.\n- Root: حمد (Ḥ-M-D)\n  * Lisan / Ayn: Core root denotes praise, commendation; maḥmūd is the one praised.\n  * Al-Raghib (Mufradat): Ḥamd is praise for voluntary beneficence; al-ḥamd li-Llāh encompasses all praise due to God's perfect attributes.\n  * Al-Zamakhshari (Asas): Literal: to praise for good. Metaphorical: to find praiseworthy (aḥmadtu al-arḍ: I found the land agreeable).\n- Sibawayh Rule: Rule of Interposition (al-faṣl bayna al-jār wa al-majrūr) — The periodic structure of the ḥadīth reports here follows the canonical pattern of embedding quoted speech within narrative frames, maintaining syntactic cohesion across multiple levels of reported discourse.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'On Invocations and Supplications'", "badge": "Afterlife"}], "52": [{"arabic": "من يقدر أن ينكر عليهم فلم يفعل إلا يوشك أن يعمهم الله بعذاب من عنده وروى عن أبي ثعلبة الخشني أنه سأل رسول الله صلى الله عليه وسلم عن تفسير قوله تعالى لا يضركم من ضل إذا اهتديتم (1) فقال يا أبا ثعلبة مر بالمعروف وأنه عن المنكر فإذا رأيت شحا مطاعا وهوى متبعا ودنيا مؤثرة وإعجاب كل ذي رأي برأيه فعليك بنفسك ودع عنك العوام إن من ورائكم فتنا كقطع الليل المظلم للمتمسك فيها بمثل الذي أنتم عليه أجر خمسين منكم قيل بل منهم يا رسول الله قال لا بل منكم لأنكم تجدون على الخير أعوانا ولا يجدون عليه أعوانا وسئل ابن مسعود رضي الله عنه عن ت", "english": "Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 521", "section_title_en": "Section 521", "section_index": 521, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Enjoining Good and Forbidding Evil'", "badge": "Ethics"}], "60": [{"arabic": "واجب وعليه يدل ظاهر قوله تعالى إنما الصدقات للفقراء والمساكين الآية فإنه يشبه قول المريض إنما ثلث مال للفقراء والمساكين وذلك يقتضي التشريك في التمليك والعبادات ينبغي أن يتوقى عن الهجوم فيها على الظواهر وقد عدم من الثمانية صنفان في أكثر البلاد وهم المؤلفة قلوبهم والعاملون على الزكاة ويوجد في جميع البلاد أربعة أصناف الفقراء والمساكين والغارمون والمسافرون أعني أبناء السبيل وصنفان يوجدان في بعض البلاد دون البعض وهم الغزاة والمكاتبون فإن وجد خمسة أصناف مثلا قسم بينهم زكاة ماله بخمسة أقسام متساوية أو متقاربة وعي", "english": "The fifth: that he divide his wealth according to the number of the categories (aṣnāf) present in his town. For covering all the categories is obligatory, and upon this the apparent meaning of His saying — exalted be He — indicates: {«Innamā al-ṣadaqātu lil-fuqarā'i wa al-masākīn»} (Charities are only for the poor and the needy) — the verse. For it resembles the saying of a sick person: \"Only a third of my wealth is for the poor and the needy,\" and that entails sharing (tashrīk) in the ownership.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 171", "section_title_en": "The Second Category of Legal Obligations: The Composite of Worship and Worldly Benefit — On Zakat", "section_index": 171, "anchors": "- Root: قسم (q-s-m)\n  * Lisan / Ayn: Division, apportionment, allotment of shares\n  * Al-Raghib (Mufradat): \"القسم: إفراز النصيب\" — the separation and allocation of portions; used for dividing inheritance, spoils, and designated shares\n  * Al-Zamakhshari (Asas): Literal: dividing property among parties. Metaphorical: \"قلبه متقسم\" — a heart divided by cares; \"وجه مقسم\" — a face given each portion of beauty, thus well-proportioned\n- Root: وجب (w-j-b)\n  * Lisan / Ayn: To be due, incumbent, necessary; to fall (as a duty)\n  * Al-Raghib (Mufradat): \"الوجوب: الثبوت\" — obligation as established fixity; two types: obligatory by reason (as knowing divine unity) and obligatory by Law (as worship)\n  * Al-Zamakhshari (Asas): Literal: \"وجب البيع\" — the sale is confirmed/binding. Metaphorical: \"وجب\" — to fall dead; the obligatory falling upon one\n- Root: شرع (sh-r-ʿ)\n  * Lisan / Ayn: A comprehensive name for what God has legislated; the clear path\n  * Al-Raghib (Mufradat): \"الشرع: نهج الطريق الواضح\" — the clear path; then applied to the divine law (sharīʿah) as the way of religion\n  * Al-Zamakhshari (Asas): Literal: \"شرع الله الدين\" — God legislated the religion. Metaphorical: \"مد البعير شراعه\" — the camel extended its neck like a ship's sail, then applied to the revealed Law as the path to water (life)\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما الصدقات للفقراء\" restricts the recipients of charity to the eight specified categories, functioning as exclusive predication", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Mysteries of Zakat'", "badge": "Ethics"}, {"arabic": "المسئلة ويغنيها عن الناس فهو في سبيل الله وإن كان يسعى على أبوين ضعيفين أو ذرية ضعاف ليغنيهم ويكفيهم فهو في سبيل الله وإن كان يسعى تفاخرا وتكاثرا فهو في سبيل الشيطان (4) وقال صلى الله عليه وسلم إن الله يحب العبد يتخذ المهنة ليستغني بها عن الناس ويبغض العبد يتعلم العلم يتخذه مهنة (5) وفي الخبر إن الله تعالى يحب المؤمن المحترف (6) وقال صلى الله عليه وسلم أحل ما أكل الرجل من كسبه وكل بيع مبرور (7) وفي خبر آخر أحل ما أكل العبد كسب يد الصانع إذا نصح (1) وقال صلى الله عليه وسلم عل", "english": "As for what is [cited] from the Book [i.e., the Qur'an], there is His saying, the Exalted: «{وَجَعَلْنَا النَّهَارَ مَعَاشًا}» (\"And We have made the day a means of livelihood\" [al-Naba' 78:11]) — and He mentioned it in the context of bestowing favor (imtinān).", "book_title": "Etiquette of Earning", "section_title_ar": "Section 312", "section_title_en": "Section 312", "section_index": 312, "anchors": "*(Anchors established)*", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Earning'", "badge": "Hadith"}], "71": [{"arabic": "وقال تعالى والمؤمنون والمؤمنات بعضهم أولياء بعض يأمرون بالمعروف وينهون عن المنكر ويقيمون الصلاة فقد نعت المؤمنين بأنهم يأمرون بالمعروف وينهون عن المنكر فالذي هجر الأمر بالمعروف والنهي عن المنكر خارج عن هؤلاء المؤمنين المنعوتين في هذه الآية وقال تعالى لعن الذين كفروا من بني إسرائيل على لسان داود وعيسى ابن مريم ذلك بما عصوا وكانوا يعتدون كانوا لا يتناهون عن منكر فعلوه لبئس ما كانوا يفعلون وهذا غاية التشديد إذ علل استحقاقهم للعنة بتركهم النهي عن المنكر وقال عز وجل كنتم خير أمة أخرجت للناس تأمرون بالمعروف وتنهون عن المنكر وهذا يدل على فضيلة الأمر بال", "english": "Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 521", "section_title_en": "Section 521", "section_index": 521, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Enjoining Good and Forbidding Evil'", "badge": "Ethics"}], "72": [{"arabic": "وقال تعالى {ومساكن طيبة في جنات عدن ورضوان من الله أكبر} فقد رفع الله الرضا فوق جنات عدن كما رفع ذكره فوق الصلاة حيث قال {إن الصلاة تنهي عن الفحشاء والمنكر ولذكر الله أكبر} فكما أن مشاهدة المذكور في الصلاة أكبر من الصلاة فرضوان رب الجنة أعلى من الجنة بل هو غاية مطلب سكان الجنان وفي الحديث إن الله تعالى يتجلى للمؤمنين فيقول سلوني فيقولون رضاك (1) فسؤالهم الرضا بعد النظر نهاية التفضيل وأما رضا العبد فسنذكر حقيقته وأما رضوان الله تعالى عن العبد فهو بمعنى آخر يقرب مما ذكرناه في ح", "english": "I say: As for the verses [indicating the supremacy of divine pleasure], there is the saying of the Exalted: {رَضِيَ اللَّهُ عَنْهُمْ وَرَضُوا عَنْهُ} [Allah is well-pleased with them and they are well-pleased with Him] {«God is well-pleased with them and they are well-pleased with Him»}. And the Exalted has said: {هَلْ جَزَاءُ الْإِحْسَانِ إِلَّا الْإِحْسَانُ} [Is the reward of goodness aught but goodness?] {«Is the reward of goodness aught but goodness?»}. The ultimate end of goodness is God's pleasure with His servant, and that is the reward for the servant's pleasure in God the Exalted.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1189", "section_title_en": "The Reality of Divine Pleasure (Riḍā) and the Servant's Contentment with the Decree — Section 1189", "section_index": 1189, "anchors": "- Root: رضي (raḍiya)\n  * Lisan / Ayn: Core meaning is \"to be content, to approve, to be pleased.\" Al-Farahidi notes its usage in mutual accord and satisfaction, with the form *tarāḍin* indicating reciprocal consent.\n  * Al-Raghib (Mufradat): In theological usage, *riḍā* denotes the will's acquiescence to the divine decree without resistance. It is the apex of the servant's station, being the fruit of *maḥabbah* (love) and the key to perpetual vision (*nazar*).\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*) sense is \"satisfaction of the heart.\" Metaphorical (*majāz*) extension applies to God, where *riḍwān* is not an emotional state but a volitional attribute signifying the bestowal of grace and the removal of the veil.\n- Root: نظر (naẓara)\n  * Lisan / Ayn: \"To look, to behold, to consider.\" In the lexicon, *naẓar* implies directed vision with the eye or the intellect.\n  * Al-Raghib (Mufradat): Elevated to the highest beatific vision (*ru'yat Allāh*) in the afterlife, the ultimate reward and the supreme object of the inhabitants of Paradise.\n  * Al-Zamakhshari (Asas): Literal: physical sight. Metaphorical: intellectual contemplation or the unveiled witnessing of the Divine in the Hereafter.\n- Sibawayh Rule: باب التفضيل والتشبيه (The Chapter of Preference and Comparison) — Governing the syntactic structures of *afʿala* (elative) forms like *akbar* (\"greater\") to establish hierarchical supremacy between two entities, as in the verse {وَرِضْوَانٌ مِنَ اللَّهِ أَكْبَرُ}.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "73": [{"arabic": "وقال لنبيه صلى الله عليه وسلم {جاهد الكفار والمنافقين واغلظ عليهم} الآية وإنما الغلظة والشدة من آثار قوة الحمية وهو الغضب وأما الإفراط فهو أن تغلب هذه الصفة حتى تخرج عن سياسة العقل والدين وطاعته ولا يبقى للمرء معها بصيرة ونظر وفكرة ولا اختيار بل يصير في صورة المضطر وسبب غلبته أمور غريزية وأمور اعتيادية فرب إنسان هو بالفطرة مستعد لسرعة الغضب حتى كأن صورته في الفطرة صورة غضبان ويعين على ذلك حرارة مزاج القلب لأن الغضب من النار (1) كما قال صلى الله عليه وسلم وإنما برودة المزاج تطفئه وتكسر سورته وأما الأسباب الاعتياد", "english": "As for deficiency: it is the loss of this power or its weakness. This is blameworthy, and it is of such a one that it is said: \"He has no protective zeal (ḥamiyyah).\" For this reason al-Shāfiʿī — may God have mercy on him — said: \"Whoever is provoked to anger and does not become angry is a donkey.\" Whoever loses the power of anger and protective zeal entirely is utterly deficient. God — exalted be He — described the Companions of the Prophet — peace be upon him — with severity and protective zeal, saying: {«أشداء على الكفار رحماء بينهم»} \"Severe against the disbelievers, merciful among themselves\" (Q 48:29). And He said to His Prophet — peace be upon him: {«جاهد الكفار والمنافقين واغلظ عليهم»} \"Strive against the disbelievers and the hypocrites and be harsh with them\" (Q 9:73) — the verse. Harshness and severity are but effects of the power of protective zeal, which is anger.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 703", "section_title_en": "The Reality of Anger (Ghaḍab) and Its Degrees — Book 21, Section 703", "section_index": 703, "anchors": "- Root: غضب (Ghaḍab)\n  * Lisan / Ayn: Core root denotes anger, rage, fury; the surge of blood in the heart seeking vengeance.\n  * Al-Raghib (Mufradat): \"الغضب: ثوران دم القلب إرادة الانتقام\" — when attributed to God, it means solely His retribution, not an emotional state.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"غضبت لفلان\" (anger for the living); Metaphorical (majāz): \"غضبت به\" (anger over the dead), and the poetic extension to inanimate objects like fire or reins.\n- Root: نفس (Nafs)\n  * Lisan / Ayn: Self, soul, spirit; the vital principle.\n  * Al-Raghib (Mufradat): The soul as the seat of blameworthy traits when unrestrained; its purification is the goal of spiritual struggle.\n  * Al-Zamakhshari (Asas): Literal: the self; Metaphorical: \"دفق نفسه\" (spilled his blood/life).\n- Root: قلب (Qalb)\n  * Lisan / Ayn: The heart; to turn over, to flip.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named for its constant fluctuation and turning.\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of intellect and spiritual perception, which anger overturns and blinds.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — Used to distinguish the three degrees of anger (deficiency, excess, moderation) as mutually exclusive categories.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "75": [{"arabic": "فقالا إن رزقنا الله تعالى مالا لنتصدقن فبخلوا به فنزلت ومنهم من عاهد الله لئن آتانا من فضله لنصدقن ولنكونن من الصالحين وقال بعضهم إنما هو شيء نووه في أنفسهم لم يتكلموا به فقال ومنهم من عاهد الله لئن آتانا من فضله لنصدقن ولنكونن من الصالحين فلما آتاهم من فضله بخلوا به وتولوا وهم معرضون فأعقبهم نفاقا في قلوبهم إلى يوم يلقونه بما أخلفوا الله ما وعدوه وبما كانوا يكذبون فجعل العزم عهدا وجعل الخلف فيه كذبا والوفاء به صدقا وهذا الصدق أشد من الصدق الثالث فإن الناس قد تسخو بالعزم ثم تكيع عند الوفاء لشدته عليها ولهيجان الشهوة عند التمكن وحصول الأسباب ولذلك استثنى عمر رضي الله عنه فقال لأن أقدم فتضرب عنقي أحب إلي من أن أتأمر على قوم فيهم أبو بكر اللهم إلا أن تسول لي نفسي عند القتل شيئا لا أجده الآن لأني لا آمن أن يثقل عليها ذلك فتتغير عن عزمها وأشار بذلك إلى شدة الوفاء بالعزم وقال أبو سعيد الخراز رأيت في المنام كأن ملكين نزلا", "english": "**{The First}** — Guarding against equivocal expressions (al-maʿārīḍ). For it has been said: \"In equivocation there is ample scope to avoid lying.\" This is because equivocations stand in the place of lying, since what is feared from lying is conveying a thing contrary to what it is in itself — except that this (i.e., dissimulation) is something to which need impels and which benefit (al-maṣlaḥah) requires in certain situations: in disciplining children and women and those who run their course, in guarding against oppressors (al-ẓalamah), in fighting enemies, and in guarding against their being apprised of the secrets of the realm (asrār al-mulk). Whoever is compelled to something of this sort, his truthfulness in it is that his utterance therein be for God, in what the Truth commands him and what religion requires. When he so speaks, he is truthful, even if his speech conveys something other than what it is — because truthfulness is not desired for its own sake, but rather for indicating the truth and calling to it. So one does not look to its form but to its meaning. Yes, in such a situation one ought to turn to equivocations (al-maʿārīḍ) wherever a path to them is found.", "book_title": "Intention, Sincerity and Truthfulness", "section_title_ar": "Section 1227", "section_title_en": "The Book of Truthfulness (Kitāb al-Ṣidq) — Section on the Six Meanings of Truthfulness", "section_index": 1227, "anchors": "- Root: صدق (Ṣ-D-Q)\n  * Lisan / Ayn: Core meaning of veracity in speech and correspondence of statement to reality; the root also yields \"ṣiddīq\" (intensive form) denoting one utterly truthful.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان في القول إلا في الخبر\" — Truth/falsehood originate in speech (khabar), but extend by derivation to intention, resolve, and action; ultimate truthfulness is alignment of the whole self with reality.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صدقته الحديث\" — truthful in report. Metaphorical (majāz): \"رجل صادق الحملة\" — one truthful in charge (courage), showing extension from speech to act.\n- Root: عزم (ʿ-A-Z-M)\n  * Lisan / Ayn: \"العزيمة: عقد القلب على إمضاء الأمر\" — firm knotting of the heart upon executing a matter; \"اعتزم الفرس في عنانه\" — a horse straining hard against its rein (metaphor for unyielding resolve).\n  * Al-Raghib (Mufradat): \"عقد القلب على إمضاء الأمر\" — resolve as a binding of the heart; its opposite is hesitation and weakness.\n  * Al-Zamakhshari (Asas): Literal: \"عزمت على الأمر واعتزمت عليه\" — to resolve firmly. Metaphorical: \"اعتزم الفرس\" — unswerving forward drive.\n- Root: عبد (ʿ-B-D)\n  * Lisan / Ayn: \"العبودية: إظهار التذلل\" — display of humility; \"العبادة أبلغ منها، لأنها غاية التذلل\" — worship is the extreme of humility.\n  * Al-Raghib (Mufradat): \"العبودية: إظهار التذلل، والعبادة أبلغ منها\" — servitude is manifest humility; worship is its utmost degree, due only to God. Two types: by compulsion (taskhīr) and by choice (ikhtiyār).\n  * Al-Zamakhshari (Asas): Literal: \"عبد بين العبودية\" — a slave bound by servitude. Metaphorical: \"استعبده الطمع\" — greed enslaved him; \"تعبدني فلان\" — he made me his slave.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The text uses \"إنما\" and restrictive predicates (e.g., \"وإنما العبد الحق لله\") to delimit definitions, distinguishing essential from accidental attributes.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Intention, Sincerity and Truthfulness'", "badge": "Ethics"}, {"arabic": "في ثعلبة ومنهم من عاهد الله لئن آتانا من فضله لنصدقن ولنكونن من الصالحين فلما آتاهم من فضله بخلوا به وتولوا وهم معرضون فأعقبهم نفاقا في قلوبهم إلى يوم يلقونه بما أخلفوا الله ما وعدوه وبما كانوا يكذبون وعند رسول الله صلى الله عليه وسلم رجل من أقارب ثعلبة فسمع ما أنزل الله فيه فخرج حتى أتى ثعلبة فقال لا أم لك يا ثعلبة قد أنزل الله فيك كذا فخرج ثعلبة حتى أتى النبي صلى الله عليه وسلم فسأله أن يقبل منه صدقته فقال إن الله منعني أن أقبل منك صدقتك فجعل يحثو التراب على رأسه فقال رسول الله صلى الله عليه وسلم هذا عملك أمرتك فلم تطعني فلما أبى أن يقبل منه شيئا رجع إلى منزله فلما قبض رسول صلى الله عليه وسلم جاء بها إلى أبي بكر الصديق رضي الله عنه فأبى أن يقبلها منه وج", "english": "Their letter reached him, and he looked into it and said: \"This is the sister of the jizyah.\" Then he said: \"Depart, until I see my opinion.\" So they departed until they came to the Prophet, peace be upon him. When he saw them, he said—before they even spoke to him—\"Woe to Tha'labah!\" And he prayed for al-Sulaymī. Then they informed him of what Tha'labah had done and of what al-Sulaymī had done. Then God, the Exalted, revealed concerning Tha'labah: {«وَمِنْهُم مَّنْ عَاهَدَ اللَّهَ لَئِنْ آتَانَا مِن فَضْلِهِ لَنَصَّدَّقَنَّ وَلَنَكُونَنَّ مِنَ الصَّالِحِينَ * فَلَمَّا آتَاهُم مِّن فَضْلِهِ بَخِلُوا بِهِ وَتَوَلَّوا وَّهُم مُّعْرِضُونَ * فَأَعْقَبَهُمْ نِفَاقًا فِي قُلُوبِهِمْ إِلَىٰ يَوْمِ يَلْقَوْنَهُ بِمَا أَخْلَفُوا اللَّهَ مَا وَعَدُوهُ وَبِمَا كَانُوا يَكْذِبُونَ»} — \"And among them is he who made a covenant with God: 'If He gives us of His bounty, we will surely give charity and be among the righteous.' But when He gave them of His bounty, they were niggardly with it and turned away, averse. So He inflicted hypocrisy in their hearts until the day they meet Him, because they broke what they promised God and because they were lying.\"", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 789", "section_title_en": "The Tyranny of Wealth and the Blessedness of Poverty: The Tale of Tha'labah and the Visit to Fatimah", "section_index": 789, "anchors": "- Root: عهد (ʿahada)\n  * Lisan / Ayn: Covenant, compact, pledge; the keeping of an agreement and the obligation it entails.\n  * Al-Raghib (Mufradat): Al-ʿahd is the covenant binding one to fulfill a condition; its breach (nakth) is the mark of hypocrisy (nifāq), as in the verse on Tha'labah.\n  * Al-Zamakhshari (Asas): Literal: a written pact or verbal promise. Metaphorical: the soul's pact with God, which wealth tempts one to violate.\n- Root: فضل (faḍl)\n  * Lisan / Ayn: Superabundance, excess, bounty; that which exceeds necessity.\n  * Al-Raghib (Mufradat): Faḍl Allāh is His gratuitous bounty; in the Tha'labah narrative it designates wealth given as a test, not as an honor.\n  * Al-Zamakhshari (Asas): Literal: surplus. Metaphorical: divine favor that, when hoarded (bukhl), converts into a curse (shu'm).\n- Root: بخل (bakhila)\n  * Lisan / Ayn: To withhold, to be niggardly; the opposite of generosity (jūd).\n  * Al-Raghib (Mufradat): Bukhl is the soul's clinging to what it possesses, refusing the right of God therein—the direct cause of the \"hypocrisy in the heart\" (nifāq) inflicted on Tha'labah.\n  * Al-Zamakhshari (Asas): Literal: miserliness with wealth. Metaphorical: withholding obedience and gratitude from God, as the verse joins \"they were niggardly\" with \"they turned away.\"\n- Root: عاد (ʿāda)\n  * Lisan / Ayn: To return, to visit the sick (ʿiyādah); the act of going to see one afflicted.\n  * Al-Raghib (Mufradat): ʿIyādah is a form of compassionate attendance; the Prophet's visit to Fatimah exemplifies the humility of poverty chosen over worldly ease.\n  * Al-Zamakhshari (Asas): Literal: visiting. Metaphorical: the Prophet's descent to his daughter's destitute home is a living lesson that honor lies in the hereafter, not in provision.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The narrative interposes clauses (e.g., \"فلما رآهما قال... قبل أن يكلماه\") to suspend action, heightening dramatic tension while maintaining grammatical cohesion.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Ethics"}], "81": [{"arabic": "الرمضاء فكان يقول لنفسه ذوقى ونار جهنم أشد حرا أجيفة بالليل بطالة بالنهار فبينما هو كذلك إذ أبصر النبي صلى الله عليه وسلم في ظل شجرة فأتاه فقال غلبتني نفسي فقال له النبي صلى الله عليه وسلم ألم يكن لك بد من الذي صنعت أما لقد فتحت لك أبواب السماء ولقد باهى الله بك الملائكة ثم قال لأصحابه تزودوا من أخيكم فجعل الرجل يقول له يا فلان أدع لي يا فلان ادع لى فقال النبي صلى الله عليه وسلم عمهم فقال اللهم أجعل التقوى زادهم واجمع على الهدى أمرهم فجعل النبي صلى الله عليه وسلم يقول اللهم سدده فقال الرجل الله", "english": "A woman said: \"You speak of what you do not know. Indeed, God has a covenant upon me which I shall never break: I shall not lay you upon the earth in sleep for a full year, except due to an obstructing illness or a departing intellect. Shame upon you! Do you not feel ashamed? How often you rebuke, yet from your error you do not desist.\" He said: And he began to weep, unaware of my presence. When I saw that, I departed and left him.", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1241", "section_title_en": "The Discipline of the Self: Accounts of the Pious in Reckoning and Punishing Their Souls", "section_index": 1241, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, spirit; that which breathes and desires; the locus of blameworthy and praiseworthy traits.\n  * Al-Raghib (Mufradat): Al-nafs denotes the soul as the principle of life and moral responsibility; its reckoning (muḥāsabah) is the essence of religious discipline.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity. Metaphorical: \"دفق نفسه\" (he poured out his self, i.e., his blood) — here, the self is addressed as a distinct interlocutor, a rhetorical personification of the lower impulses.\n- Sibawayh Rule: باب النداء والتوبيخ (The Chapter of Direct Address and Rebuke) — The self is vocatively addressed (يا نفسي) as a second party, establishing the grammatical frame of moral confrontation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "82": [{"arabic": "لفضيلة الخشية فإن البكاء ثمرة الخشية فقد قال تعالى {فليضحكوا قليلا وليبكوا كثيرا} وقال تعالى {يبكون ويزيدهم خشوعا} وقال عز وجل {أفمن هذا", "english": "For they possess the Highest Companion (al-Rafīq al-Aʿlā) in which none share with them. Consider how He singled them out for the companionship of the Highest Companion — and that is because they are the scholars (ʿulamāʾ), and the scholars hold the rank of companionship with the prophets, for they are the heirs of the prophets. And the companionship of the Highest Companion belongs to the prophets and to those who attach themselves to them. For this reason, when the Messenger of God — may God's blessings and peace be upon him — was given the choice during his death-illness between remaining in this world and proceeding to God — may He be exalted — he would say: \"I ask of Thee the Highest Companion\" {«الرفيق الأعلى»}.", "book_title": "Fear and Hope", "section_title_ar": "Section 1042", "section_title_en": "On the Excellence of Fear (Khawf) and Its Inseparability from Faith — Section 1042", "section_index": 1042, "anchors": "- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being afraid; its opposite is amn (security).\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — anticipation of something disliked based on an indication, whether conjectural or certain; it is the direct opposite of amn (security), and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — to fear for something. Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as fear erodes the soul's complacency.\n- Root: حدث (Hadath)\n  * Lisan / Ayn: Newness, origination after non-existence; also that which is recent in time.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — the coming-to-be of a thing after it was not; true origination belongs to God alone.\n  * Al-Zamakhshari (Asas): Literal: \"هو حدث من الأحداث\" — one who is recent/young. Metaphorical: \"كان عمر محدثا أي صادق الحدس\" — one whose intuition is true, as if divinely inspired.\n- Root: يوم (Yawm)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — used for the day proper or any extended period; \"أيام الله\" refers to His mighty deeds and visitations upon the wicked.\n  * Al-Zamakhshari (Asas): Literal: \"ما رأيته اليوم\" — temporal designation. Metaphorical: \"ذكر في أيام العرب كذا أي في وقائعها\" — \"days\" as battles and momentous events.\n- Root: قوي (Quwwa)\n  * Lisan / Ayn: Strength, power, capability; the opposite of weakness.\n  * Al-Raghib (Mufradat): \"القوة تستعمل تارة في معنى القدرة\" — power as capability; also potentiality, as when a date-stone is said to be \"potentially\" a palm-tree.\n  * Al-Zamakhshari (Asas): Literal: \"هو قوي مقو\" — physically strong. Metaphorical: strength of heart, of conviction, and of allies.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the particle innamā is employed, it restricts the predicate exclusively to the subject mentioned, negating it for all others. This governs the author's argument that taqwā is exclusively attributed to God's nearness and that the \"Highest Companion\" (al-Rafīq al-Aʿlā) is uniquely reserved for the prophets and their heirs.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Fear and Hope'", "badge": "Hadith"}], "87": [{"arabic": "الرضا به فقال {ورضوا بالحياة الدنيا واطمأنوا بها} وقال تعالى {رضوا بأن يكونوا مع الخوالف وطبع على قلوبهم} وفي الخبر المشهور من شهد منكرا فرضي به فكأنه قد فعله وفي الحديث الدال على الشر كفاعله (1) وعن ابن مسعود إن العبد ليغيب عن المنكر ويكون عليه مثل وزر صاحبه وقيل وكيف ذلك قال يبلغه فيرضى به وفي الخبر لو أن عبدا قتل بالمشرق ورضي بقتله آخر بالمغرب كان", "english": "The young man said to her: \"You have done well, by God, O my lady! Will you permit me to die?\" She said: \"Die, rightly guided.\" He said: So he laid his head upon the cushion, closed his mouth, and shut his eyes. We shook him — and behold, he was dead.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1195", "section_title_en": "The Marvels of Love Transcend Corporeal Sight, and the Compatibility of Supplication and Disapproval of Sin with Contentment (Al-Riḍā)", "section_index": 1195, "anchors": "- Root: فقد (F-Q-D)\n  * Lisan / Ayn: Loss of something after its existence; more specific than absolute non-existence (ʿadam).\n  * Al-Raghib (Mufradat): \"الفقد: عدم الشيء بعد وجوده، فهو أخص من العدم\" — loss is the absence of a thing after it had been, thus it is more specific than non-existence, which applies also to what never was. The one who lacks the cause (sabab) of love lacks love itself.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ما افتقدته منذ افتقدته\" — to miss or lose something. Metaphorical (Majaz): The loss of inward sight (baṣīrah) is likened to the loss of outward sight (baṣar); he who has lost the heart (qalb) denies what only the heart can perceive.\n- Root: صدق (Ṣ-D-Q)\n  * Lisan / Ayn: Truthfulness in speech and in resolve; sincerity of intent.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood originate in speech, but extend by derivation to resolve and action. The lover's claim of love is tested by obedience unto death.\n  * Al-Zamakhshari (Asas): Literal: \"صدقته الحديث\" — to affirm someone's report. Metaphorical (Majaz): \"رجل صادق الحملة\" — a man truthful in his charge (i.e., sincere in action). Here, sincerity in love of the creature (al-makhluq) is credited as true; sincerity in love of the Creator (al-Khāliq) is a fortiori more worthy of credence.\n- Root: رضي (R-Ḍ-Y)\n  * Lisan / Ayn: Contentment and approval; the opposite of displeasure (sakhaṭ).\n  * Al-Raghib (Mufradat): Contentment with divine decree is praiseworthy; contentment with disobedience (maʿṣiyah) is blameworthy, for the decree is from God but the act is acquired by the servant.\n  * Al-Zamakhshari (Asas): Literal: approval of a thing as good. Metaphorical: The battālūn (idle pretenders) erred by conflating approval of the decree (qaḍāʾ) with approval of the decreed act (maqḍiyy), a confusion between the divine will and the moral quality of human acts.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The clause \"إنما فقده لفقد سببه\" restricts the cause of loss to the loss of its cause alone, effecting a focused predication that excludes any other explanation. Also, the conditional \"لو قلت لي مت لمت\" (hypothetical protasis-apodosis) governs the lover's absolute obedience as a test of sincerity.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Love, Longing, Intimacy and Contentment'", "badge": "Hadith"}], "91": [{"arabic": "اللهم إنا قد سمعناك تقول ما على المحسنين من سبيل وقد أقررنا بالإساءة فهل تكون مغفرتك إلا لمثلنا اللهم فاغفر لنا وارحمنا واسقنا فرفع يديه ورفعوا أيديهم فسقوا وقيل لمالك بن دينار ادع لنا ربك فقال إنكم تستبطئون المطر وأنا أستبطىء الحجارة وروي أن عيسى صلوات الله عليه وسلامه خرج يستسقي فلما ضجروا قال لهم عيسى عليه السلام من أصاب منكم ذنبا فليرجع فرجعوا كلهم ولم يبق معه في المفازة إلا واحد فقال له عيسى عليهم السلام أما لك من ذنب فقال والله ما علمت من شيء غير أني كنت ذات يوم أصلي فمرت بي امرأة ف", "english": "[Root: دعو]\n  • Lisan al-Arab: \"الدعاء: الرغبة إلى الله تعالى، والابتهال في المسألة. والدعوة: الكلمة التي يدعو بها. وأصل الدعاء: طلب الإقبال من الغير.\"\n  • Al-Raghib (Mufradat): \"الدعاء: ضربان: أحدهما دعاء العبادة، والآخر دعاء المسألة. فدعاء العبادة: هو توجه العبد إلى الله تعالى بالطاعة. ودعاء المسألة: طلب الحاجة من الله تعالى. قال تعالى: {وقال ربكم ادعوني أستجب لكم}.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعا فلان ربه: ابتهل إليه بالسؤال. ودعا الله: عبده. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} أي عن دعائي.\"\n  • Al-Zamakhshari (Asas - Majaz/Metaphorical): \"دعا عليه: سأل الله أن يصيبه بمكروه. ودعا له: سأل الله أن يحسن إليه. ومن المجاز: دعا الأمر إلى كذا، أي أدى إليه.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 242", "section_title_en": "Section 242", "section_index": 242, "anchors": "*(Anchors established)*", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "96": [{"arabic": "وبين أن يستعملها في معصيته فقد كفر لاقتحامه ما يكرهه مولاه ولا يرضاه له فإن الله لا يرضى لعباده الكفر والمعصية وإن عطلها ولم يستعملها في طاعة ولا معصية فهو أيضا كفر كفران إن للنعمة بالتضييع وكل ما خلق في الدنيا إنما خلق آلة للعبد ليتوصل به إلى سعادة الآخرة ونيل القرب من الله تعالى فكل مطيع فهو بقدر طاعته شاكر نعمة الله في الأسباب التي استعملها في الطاعة وكل كسلان ترك الاستعمال أو عاص استعملها في طريق البعد فهو كافر جار في غير محبة الله تعالى فالمعصية والطاعة تشملهما المشيئة ولكن لا تشملهما المحبة والكراهة بل رب مراد", "english": "The hadith has already been presented in the Book of Repentance, and before that in the Book of Supplications. That was because of his ascent to seventy stations, some of which are above others. Its beginning — even though it surpassed the utmost limits of [all] creatures — was nevertheless a deficiency relative to its end. Thus his seeking forgiveness was for that [deficiency]. And when ʿĀʾishah, may God be pleased with her, said: \"Has God not forgiven you what preceded of your sin and what came after? Then what is this weeping in prostration, and what is this severe exertion?\" — PageV04P087 — he {said}: \"Shall I not then be a grateful servant?\" // The hadith of ʿĀʾishah, when she said to him: \"God has forgiven you what preceded of your sin and what came after — so what is this weeping?\" — the hadith was narrated by Abū al-Shaykh, and it is the remainder of the hadith of ʿAṭāʾ from her, which preceded this by nine hadiths. It is also in Muslim from the narration of ʿUrwah from her, in abbreviated form. Likewise it is in the Two Ṣaḥīḥs, abbreviated, from the hadith of al-Mughīrah ibn Shuʿbah. Its meaning is: \"Shall I not be a seeker of increase in the stations?\" — for gratitude is the cause of increase, as God Most High said: {«لئن شكرتم لأزيدنكم»} [\"If you are grateful, I will surely increase you\"].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 980", "section_title_en": "The Reality of Gratitude and Ingratitude — The Parable of the King and the Servant", "section_index": 980, "anchors": "- Root: شكر (sh-k-r)\n  * Lisan / Ayn: Core meaning of \"opening/disclosing\" (kashf) — the opposite of kufr, which is \"covering/concealing\"; also linked to a full udder (shukrā), i.e., abundance and fullness.\n  * Al-Raghib (Mufradat): Gratitude is \"the conceptualization of the blessing and its manifestation\" — threefold: gratitude of the heart (perceiving the blessing), of the tongue (praising the Bestower), and of the limbs (rewarding the blessing through obedience).\n  * Al-Zamakhshari (Asas): Literal (haqīqah): \"I thanked God for His blessing.\" Metaphorical (majāz): A beast that suffices on little fodder yet fattens — gratitude as efficient use of provision for its intended purpose.\n- Root: عبد (ʿ-b-d)\n  * Lisan / Ayn: Servitude as manifest humility; ʿibādah is the utmost degree of self-abasement before the One deserving ultimate beneficence.\n  * Al-Raghib (Mufradat): ʿUbūdiyyah is \"displaying humility,\" while ʿibādah is its extreme — and is of two kinds: by compulsion (all creatures) and by choice (the rational, who are commanded to worship).\n  * Al-Zamakhshari (Asas): Literal: \"He is a servant (ʿabd) between servitude.\" Metaphorical: \"So-and-so has enslaved me (taʿabbadanī)\" — making one like a servant.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Originary estimation and measuring out (taqdīr) — creation as precise ordainment.\n  * Al-Raghib (Mufradat): \"Creation is originally: precise estimation (al-taqdīr al-mustaqīm)\" — used for bringing forth from nothing (ibdāʿ) and for fashioning from existing matter.\n  * Al-Zamakhshari (Asas): Literal: The leatherworker \"estimates\" (khalq) the hide before cutting. Metaphorical: \"God created the creation\" — brought them into being upon an estimation necessitated by wisdom.\n- Root: قرب (q-r-b)\n  * Lisan / Ayn: Nearness in place or station; the opposite of buʿd (distance).\n  * Al-Raghib (Mufradat): Nearness to God is not spatial but by rank, honor, and obedience — the soul's proximity to the divine presence through virtuous acts.\n  * Al-Zamakhshari (Asas): Literal: physical proximity. Metaphorical: \"nearness to the King\" — honor and favor, not spatial contiguity.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — \"إنما الشرع كله تعريف طريق\" restricts the entire purpose of the Sacred Law to one function: defining the path. Also, conditional and bipartite clauses (al-sharṭ wa al-jawāb) governing \"مهما لبس العبد الثوب... فقد شكر\" — the protasis-apodosis structure establishing a causal equivalence between action and its moral verdict.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "99": [{"arabic": "الأول تعجيل الطعام فذلك من إكرام الضيف وقد قال صلى الله عليه وسلم من كان يؤمن بالله واليوم الآخر فليكرم ضيفه (1) ومهما حضر الأكثرون وغاب واحد أو اثنان وتأخروا عن الوقت الموعود فحق الحاضر في التعجيل أولى من حق أولئك في التأخير إلا أن يكون المتأخر فقيرا أو ينكسر قلبه بذلك فلا بأس في التأخير وأحد المعنيين في قوله تعالى {هل أتاك حديث ضيف إبراهيم المكرمين} أنهم أكرموا بتعجيل الطعام إليهم دل عليه قوله تعالى {فما لبث أن جاء بعجل حنيذ} وقوله {فراغ إلى أهله فجاء بعجل سمين} والروغان الذهاب بسرعة وقيل في خفية وقيل جاء بفخذ من لحم وإنما سمي ع", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Mysteries of Prayer'", "badge": "Hadith"}], "100": [{"arabic": "وقال عز وجل {رضي الله عنهم ورضوا عنه ذلك لمن خشي ربه} وكل ما دل على فضيلة العلم دل على فضيلة الخوف لأن الخوف ثمرة العلم ولذلك جاء في خبر موسى عليه أفضل الصلاة والسلام وأما الخائفون", "english": "As for the path of derivation (iqtibās) from the verses and reports, what has been transmitted concerning the virtue of fear is beyond enumeration. And sufficient as an indication of its virtue is that God—may He be exalted—has gathered together for the fearful (khāʾifūn) guidance (hudā), mercy (raḥmah), knowledge (ʿilm), and good pleasure (riḍwān)—and these are the sum total of the stations of the people of Paradise. God—may He be exalted—said: {وهدى ورحمة للذين هم لربهم يرهبون} \"And guidance and mercy for those who of their Lord are fearful\" [Al-Aʿrāf: 154]. And He—exalted is He—said: {إنما يخشى الله من عباده العلماء} \"Only those of His servants who possess knowledge fear God\" [Fāṭir: 28]—describing them with knowledge on account of their fear [of Him].", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1041", "section_title_en": "Exposition of the Virtue of Fear (Khawf) and Encouragement Thereof", "section_index": 1041, "anchors": "- Root: خوف (Khawf)\n  * Lisan / Ayn: Core root denotes trepidation, apprehension, and the state of being overtaken by dread of a feared outcome.\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — the anticipation of something detestable based on a probable or certain indication; it is the direct opposite of amn (security) and applies to both worldly and otherworldly matters.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"خفته على مالي خوفا وخيفة\" — fearing for something. Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as fear consumes the soul piecemeal.\n- Root: فضل (Fadl)\n  * Lisan / Ayn: Excess, superiority, or merit beyond the baseline of sufficiency.\n  * Al-Raghib (Mufradat): \"الفضل: الزيادة عن الاقتصاد\" — increase beyond moderation; the praiseworthy type is like the surplus of knowledge and forbearance, and it is measured by its end (ghāyah).\n  * Al-Zamakhshari (Asas): Literal: \"مال فلان فاضل: كثير يفضل عن القوت\" — surplus wealth exceeding necessity. The virtue of a thing is gauged by its instrumental efficacy toward a noble goal.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Certain cognition and apprehension of a thing as it truly is.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing's reality; it is the root from which khawf branches as its fruit.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to have cognizance. The scholars (ʿulamāʾ) are so named for their knowledge, which necessarily engenders fear of God.\n- Sibawayh Rule: Restriction and Focused Predication (باب الحصر والتقييد) — governing the exclusive attribution in {إنما يخشى الله من عباده العلماء}, where the predicate restricts fear to the knowledgeable, and the syntactic fronting of \"whom they fear\" (لربهم يرهبون) emphasizes the object of reverential dread.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}], "102": [{"arabic": "هم الذين {خلطوا عملا صالحا وآخر سيئا عسى الله أن يتوب عليهم} هذا باعتبار القوة والضعف ويتطرق إليه أيضا ثلاثة أحوال باعتبار عدد ما يصبر عنه فإنه إما أن يغلب جميع الشهوات أو لا يغلب شيئا منها أو يغلب بعضها دون بعض وتنزيل قوله تعالى {خلطوا عملا صالحا وآخر سيئا} على من عجز عن بعض الشهوات دون بعض أولى والتاركون للمجاهدة مع الشهوات مطلقا يشبهون بالأنعام بل هم أضل سبيلا إذ البهيمة لم تخلق لها المعرفة والقدرة التي بها تجاهد مقتضى الشهوات وهذا قد خلق ذلك له وعطله فهو الناقص حقا المدبر يقينا ولذلك قيل ولم أر في عيوب ا", "english": "{وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْيَا ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ} — \"And they desire only the life of this world; that is the reach of their knowledge.\" {Quran 53:29} And the mark of this state is despair, dejection, and self-delusion with vain hopes — and that is the extreme of folly, just as he, peace and blessings be upon him, said: \"The clever one is he who subjugates his own soul and works for what comes after death; and the foolish one is he who follows his soul's caprice and makes wishes upon God.\" {Hadith — al-Tirmidhi, Ibn Majah} And the possessor of this state, when admonished, says: \"I long for repentance, but it has become impossible for me, so I have no aspiration for it.\" Or he is not longing for repentance at all, but says: \"Indeed, God is Forgiving, Merciful, Generous — so there is no need for me to repent.\" And this wretched one — his intellect has become thin and subservient to his lust, so he does not employ his intellect except in extracting the subtle devices (daqāʾiq al-ḥiyal) by which he attains the satisfaction of his passion. Thus his intellect has come to be in the hand of his lusts like a Muslim captive in the hands of the infidels — they press him into service for tending swine, guarding wines, and carrying them. And his station with God Almighty is the station of one who subdues a Muslim and delivers him to the infidels, making him a captive among them — because by his obscene transgression, it is as though he has pressed into service that which had the right not to be pressed into service, and has given dominion over that which had the right not to be given dominion over it. For the Muslim only deserved to be dominant because of what is in him of knowledge of God and the impulsion of religion; and the infidel only deserved to be given dominion over him because of what is in him of ignorance of religion and the impulsion of the devils. And the right of the Muslim over his own soul is more obligatory than the right of another over him. So whenever the noble meaning (al-maʿnā al-sharīf) — which is of the party of God and the host of the angels — is pressed into service for the base meaning (al-maʿnā al-khasīs) — which is of the party of the devils banished from God Almighty — then he is like one who enslaves a Muslim to an infidel. Nay, he is like one who, intending to spite the king who has bestowed favors upon him, seizes the king's most beloved son and delivers him to his most hated enemy. Consider then how great is his ingratitude for the king's favor and his deservingness of the king's vengeance — because passion (al-hawā) is the most abominable deity worshipped on the face of the earth in the sight of God Almighty, and the intellect (al-ʿaql) is the most noble existing thing created upon the face of the earth.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 961", "section_title_en": "The States of the Soul in the Struggle Against Passion — Section 961", "section_index": 961, "anchors": "- Root: ي-أ-س (ya-sa)\n  * Lisan / Ayn: Despair, cessation of hope; al-ya's is the cutting off of expectation from a matter.\n  * Al-Raghib (Mufradat): Theological despair (qunūṭ) is blameworthy as it negates divine mercy; linked to ignorance of God's attributes.\n  * Al-Zamakhshari (Asas): Literal: loss of hope; metaphorical: the soul's surrender to worldly limitation, as in {ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ} — their knowledge reaches only the worldly.\n- Root: ك-ي-س (kay-sa)\n  * Lisan / Ayn: Keenness, intelligence; al-kays is acuteness of mind and good management of affairs.\n  * Al-Raghib (Mufradat): The \"clever one\" (al-kays) in prophetic idiom is he who subjugates his soul (dāna nafsahu) — a moral-intellectual virtue, not mere cunning.\n  * Al-Zamakhshari (Asas): Literal: sharpness; metaphorical: prudence oriented to the afterlife, contrasted with ḥumq (folly) which follows caprice.\n- Root: ع-ق-ل (ʿayn-qaf-lam)\n  * Lisan / Ayn: The intellect; binding and restraining (al-ʿiqqāl) — that which prevents the soul from base acts.\n  * Al-Raghib (Mufradat): ʿAql is the faculty prepared for knowledge and the knowledge acquired thereby; its referent (musammā) is a divine subtlety (laṭīfah rabbāniyyah), not a corporeal substance.\n  * Al-Zamakhshari (Asas): Literal: the rope binding a camel's leg; metaphorical: the rational faculty that restrains passion — here, perverted into a captive serving lust.\n- Root: ه-و-ى (ha-waw-ya)\n  * Lisan / Ayn: The soul's inclination; hawan is the falling of the soul toward base desires.\n  * Al-Raghib (Mufradat): Hawā is blameworthy inclination opposed to guidance; the \"god of passion\" (ilāh al-hawā) is an idol worshipped in the heart.\n  * Al-Zamakhshari (Asas): Literal: falling; metaphorical: the soul's descent into servitude to appetite, making it the most abominable deity worshipped on earth.\n- Root: خ-ل-ط (kha-lam-ta)\n  * Lisan / Ayn: Mixing, blending; khalaṭa is to mingle one thing with another.\n  * Al-Raghib (Mufradat): In {خَلَطُوا عَمَلًا صَالِحًا وَآخَرَ سَيِّئًا} — the mixing of good and evil deeds denotes a state of moral intermediacy, not hypocrisy.\n  * Al-Zamakhshari (Asas): Literal: physical mixing; metaphorical: the soul's alternation between obedience and transgression — the \"war\" (ḥarb) between the two armies.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — applied to \"إنما استحق المسلم...\" where the restriction (ḥaṣr) isolates the sole cause of the believer's sovereignty (maʿrifah of God) and the disbeliever's subjugation (ignorance), structuring the periodic sentence as a balanced antithesis.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وتنزيل قوله تعالى {خلطوا عملا صالحا وآخر سيئا} على من عجز عن بعض الشهوات دون بعض أولى والتاركون للمجاهدة مع الشهوات مطلقا يشبهون بالأنعام بل هم أضل سبيلا إذ البهيمة لم تخلق لها المعرفة والقدرة التي بها تجاهد مقتضى الشهوات وهذا قد خلق ذلك له وعطله فهو الناقص حقا المدبر يقينا ولذلك قيل ولم أر في عيوب الناس عيبا .", "english": "{وَلَمْ يُرِدْ إِلَّا الْحَيَاةَ الدُّنْيَا ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ} — \"And they desire only the life of this world; that is the reach of their knowledge.\" {Quran 53:29} And the mark of this state is despair, dejection, and self-delusion with vain hopes — and that is the extreme of folly, just as he, peace and blessings be upon him, said: \"The clever one is he who subjugates his own soul and works for what comes after death; and the foolish one is he who follows his soul's caprice and makes wishes upon God.\" {Hadith — al-Tirmidhi, Ibn Majah} And the possessor of this state, when admonished, says: \"I long for repentance, but it has become impossible for me, so I have no aspiration for it.\" Or he is not longing for repentance at all, but says: \"Indeed, God is Forgiving, Merciful, Generous — so there is no need for me to repent.\" And this wretched one — his intellect has become thin and subservient to his lust, so he does not employ his intellect except in extracting the subtle devices (daqāʾiq al-ḥiyal) by which he attains the satisfaction of his passion. Thus his intellect has come to be in the hand of his lusts like a Muslim captive in the hands of the infidels — they press him into service for tending swine, guarding wines, and carrying them. And his station with God Almighty is the station of one who subdues a Muslim and delivers him to the infidels, making him a captive among them — because by his obscene transgression, it is as though he has pressed into service that which had the right not to be pressed into service, and has given dominion over that which had the right not to be given dominion over it. For the Muslim only deserved to be dominant because of what is in him of knowledge of God and the impulsion of religion; and the infidel only deserved to be given dominion over him because of what is in him of ignorance of religion and the impulsion of the devils. And the right of the Muslim over his own soul is more obligatory than the right of another over him. So whenever the noble meaning (al-maʿnā al-sharīf) — which is of the party of God and the host of the angels — is pressed into service for the base meaning (al-maʿnā al-khasīs) — which is of the party of the devils banished from God Almighty — then he is like one who enslaves a Muslim to an infidel. Nay, he is like one who, intending to spite the king who has bestowed favors upon him, seizes the king's most beloved son and delivers him to his most hated enemy. Consider then how great is his ingratitude for the king's favor and his deservingness of the king's vengeance — because passion (al-hawā) is the most abominable deity worshipped on the face of the earth in the sight of God Almighty, and the intellect (al-ʿaql) is the most noble existing thing created upon the face of the earth.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 961", "section_title_en": "The States of the Soul in the Struggle Against Passion — Section 961", "section_index": 961, "anchors": "- Root: ي-أ-س (ya-sa)\n  * Lisan / Ayn: Despair, cessation of hope; al-ya's is the cutting off of expectation from a matter.\n  * Al-Raghib (Mufradat): Theological despair (qunūṭ) is blameworthy as it negates divine mercy; linked to ignorance of God's attributes.\n  * Al-Zamakhshari (Asas): Literal: loss of hope; metaphorical: the soul's surrender to worldly limitation, as in {ذَلِكَ مَبْلَغُهُمْ مِنَ الْعِلْمِ} — their knowledge reaches only the worldly.\n- Root: ك-ي-س (kay-sa)\n  * Lisan / Ayn: Keenness, intelligence; al-kays is acuteness of mind and good management of affairs.\n  * Al-Raghib (Mufradat): The \"clever one\" (al-kays) in prophetic idiom is he who subjugates his soul (dāna nafsahu) — a moral-intellectual virtue, not mere cunning.\n  * Al-Zamakhshari (Asas): Literal: sharpness; metaphorical: prudence oriented to the afterlife, contrasted with ḥumq (folly) which follows caprice.\n- Root: ع-ق-ل (ʿayn-qaf-lam)\n  * Lisan / Ayn: The intellect; binding and restraining (al-ʿiqqāl) — that which prevents the soul from base acts.\n  * Al-Raghib (Mufradat): ʿAql is the faculty prepared for knowledge and the knowledge acquired thereby; its referent (musammā) is a divine subtlety (laṭīfah rabbāniyyah), not a corporeal substance.\n  * Al-Zamakhshari (Asas): Literal: the rope binding a camel's leg; metaphorical: the rational faculty that restrains passion — here, perverted into a captive serving lust.\n- Root: ه-و-ى (ha-waw-ya)\n  * Lisan / Ayn: The soul's inclination; hawan is the falling of the soul toward base desires.\n  * Al-Raghib (Mufradat): Hawā is blameworthy inclination opposed to guidance; the \"god of passion\" (ilāh al-hawā) is an idol worshipped in the heart.\n  * Al-Zamakhshari (Asas): Literal: falling; metaphorical: the soul's descent into servitude to appetite, making it the most abominable deity worshipped on earth.\n- Root: خ-ل-ط (kha-lam-ta)\n  * Lisan / Ayn: Mixing, blending; khalaṭa is to mingle one thing with another.\n  * Al-Raghib (Mufradat): In {خَلَطُوا عَمَلًا صَالِحًا وَآخَرَ سَيِّئًا} — the mixing of good and evil deeds denotes a state of moral intermediacy, not hypocrisy.\n  * Al-Zamakhshari (Asas): Literal: physical mixing; metaphorical: the soul's alternation between obedience and transgression — the \"war\" (ḥarb) between the two armies.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — applied to \"إنما استحق المسلم...\" where the restriction (ḥaṣr) isolates the sole cause of the believer's sovereignty (maʿrifah of God) and the disbeliever's subjugation (ignorance), structuring the periodic sentence as a balanced antithesis.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وآخرون اعترفوا بذنوبهم خلطوا عملا صالحا وآخر سيئا فأمره من حيث مواظبته على الطاعات وكراهته لما تعاطاه مرجو فعسى الله أن يتوب عليه وعاقبته مخطرة من حيث تسويفه وتأخيره فربما بختطف قبل التوبة ويقع أمره في المشيئة فإن تداركه الله بفضله وجبر كسره وامتن عليه بالتوبة التحق بالسابقين وإن غلبته شقوته وقهرته شهوته فيخشى أن يحق عليه في الخاتمة ما سبق عليه من القول في الأزل لأنه مهما تعذر على المتفقه مثلا الاحتراز عن شواغل التعلم دل تعذره على أنه سبق له في الأزل أن يكون من الجاهلين فيضعف الرجاء في حقه", "english": "**The First Rank:** That the disobedient one repents and remains steadfast upon repentance until the end of his life, so that he makes up for what he let slip of his affair, and does not prompt himself to return to his sins — except for the slips (zallāt) from which human beings are not free in their habitual ways, so long as one is not at the rank of prophethood. This is steadfastness upon repentance, and its possessor is the one who races forward in good deeds, exchanging his evil deeds for good ones. The name of this repentance is \"sincere repentance\" (al-tawbah al-naṣūḥ), and the name of this soul is the \"tranquil soul\" (al-nafs al-muṭma'innah) which returns to its Lord, well-pleased and well-pleasing. These are those to whom the Prophet, peace be upon him, pointed when he said: {«سبق المفردون المستهترون بذكر الله تعالى وضع الذكر عنهم أوزارهم فوردوا القيامة خفافا»} — \"The solitary ones have outstripped [all others] — those who are engrossed in the remembrance of God Almighty, for remembrance has lifted their burdens from them, and they arrive at the Resurrection light [of burden].\" For in this there is an indication that they were beneath burdens which remembrance lifted from them.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 939", "section_title_en": "The Four Ranks of the Repentant — On the Degrees of Tawbah and the States of the Soul", "section_index": 939, "anchors": "- Root: توب (T-W-B)\n  * Lisan / Ayn: Return, turning back; the verbal noun denotes the act of reverting from a state.\n  * Al-Raghib (Mufradat): \"التوب: ترك الذنب على أجمل الوجوه\" — abandoning sin in the most beautiful manner; the most complete form of apology, comprising abandonment of the sin due to its ugliness, remorse for what passed, and resolve against return.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"تاب العبد إلى الله من ذنبه\" — the servant's turning to God from his sin. Metaphorical (Majaz): The mutual relation of divine acceptance (تاب الله على عبده) as a response to the servant's turning.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, spirit; that which animates and distinguishes.\n  * Al-Raghib (Mufradat): The soul (النفس) as the locus of divine address and self-reproach; its states (mutma'innah, lawwāmah, ammārah) are graded by its orientation toward God or toward passions.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity. Metaphorical: \"دفق نفسه\" (his blood/life) — the soul as the seat of life and moral agency.\n- Root: ذنب (Dh-N-B)\n  * Lisan / Ayn: The tail; that which follows behind.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin as the act of seizing the consequence; the trailing fault that follows the agent.\n  * Al-Zamakhshari (Asas): Literal: the tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as the trailing mark of the soul's deviation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the four ranks precisely, ensuring each category is mutually exclusive and exhaustive in its defining condition.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}, {"arabic": "على الطاعات وكراهته لما تعاطاه مرجو فعسى الله أن يتوب عليه وعاقبته مخطرة من حيث تسويفه وتأخيره فربما بختطف قبل التوبة ويقع أمره في المشيئة فإن تداركه الله بفضله وجبر كسره وامتن عليه بالتوبة التحق بالسابقين وإن غلبته شقوته وقهرته شهوته فيخشى أن يحق عليه في الخاتمة ما سبق عليه من القول في الأزل لأنه مهما تعذر على المتفقه مثلا الاحتراز عن شواغل التعلم دل تعذره على أنه سبق له في الأزل أن يكون من الجاهلين فيضعف الرجاء في حقه وإذا يسرت له أسباب المواظبة على التحصيل دل على أنه سبق له في الأزل أن يكون من جم", "english": "**The First Rank:** That the disobedient one repents and remains steadfast upon repentance until the end of his life, so that he makes up for what he let slip of his affair, and does not prompt himself to return to his sins — except for the slips (zallāt) from which human beings are not free in their habitual ways, so long as one is not at the rank of prophethood. This is steadfastness upon repentance, and its possessor is the one who races forward in good deeds, exchanging his evil deeds for good ones. The name of this repentance is \"sincere repentance\" (al-tawbah al-naṣūḥ), and the name of this soul is the \"tranquil soul\" (al-nafs al-muṭma'innah) which returns to its Lord, well-pleased and well-pleasing. These are those to whom the Prophet, peace be upon him, pointed when he said: {«سبق المفردون المستهترون بذكر الله تعالى وضع الذكر عنهم أوزارهم فوردوا القيامة خفافا»} — \"The solitary ones have outstripped [all others] — those who are engrossed in the remembrance of God Almighty, for remembrance has lifted their burdens from them, and they arrive at the Resurrection light [of burden].\" For in this there is an indication that they were beneath burdens which remembrance lifted from them.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 939", "section_title_en": "The Four Ranks of the Repentant — On the Degrees of Tawbah and the States of the Soul", "section_index": 939, "anchors": "- Root: توب (T-W-B)\n  * Lisan / Ayn: Return, turning back; the verbal noun denotes the act of reverting from a state.\n  * Al-Raghib (Mufradat): \"التوب: ترك الذنب على أجمل الوجوه\" — abandoning sin in the most beautiful manner; the most complete form of apology, comprising abandonment of the sin due to its ugliness, remorse for what passed, and resolve against return.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"تاب العبد إلى الله من ذنبه\" — the servant's turning to God from his sin. Metaphorical (Majaz): The mutual relation of divine acceptance (تاب الله على عبده) as a response to the servant's turning.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, spirit; that which animates and distinguishes.\n  * Al-Raghib (Mufradat): The soul (النفس) as the locus of divine address and self-reproach; its states (mutma'innah, lawwāmah, ammārah) are graded by its orientation toward God or toward passions.\n  * Al-Zamakhshari (Asas): Literal: the self as animate entity. Metaphorical: \"دفق نفسه\" (his blood/life) — the soul as the seat of life and moral agency.\n- Root: ذنب (Dh-N-B)\n  * Lisan / Ayn: The tail; that which follows behind.\n  * Al-Raghib (Mufradat): \"الذنب في الأصل: الأخذ بذنب الشيء\" — sin as the act of seizing the consequence; the trailing fault that follows the agent.\n  * Al-Zamakhshari (Asas): Literal: the tail of an animal. Metaphorical: \"هو من الأذناب\" — one who follows; sin as the trailing mark of the soul's deviation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to delimit the four ranks precisely, ensuring each category is mutually exclusive and exhaustive in its defining condition.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "عملا صالحا وآخر سيئا وعلى الجملة فهمة الدنيا وهمة الآخرة في القلب مثل الماء الذي يصب في قدح مملوء بخل فبقدر ما ندخل فيه من الماء يخرج منه من الخل لا محالة ولا يجتمعان", "english": "The Messenger of Allah — peace and blessings be upon him — said to ʿUthmān ibn Abī Shaybah: \"I forgot to tell you to cover the cooking pot that is in the house, for it is not fitting that there be in the house anything that would occupy people away from their prayer.\" This, then, is the way of calming thoughts.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 137", "section_title_en": "The Revival of the Religious Sciences — Section 137: On the Inward and Outward Causes of Distraction in Prayer and Their Remedies", "section_index": 137, "anchors": "- Root: شغل (Sh-Gh-L)\n  * Lisan / Ayn: The core meaning is occupation or engagement that diverts one's attention; al-Ayn notes it as that which preoccupies and distracts.\n  * Al-Raghib (Mufradat): Al-Shughl is that which diverts the intellect and causes heedlessness; it is an accidental state that overtakes the heart, turning it away from its proper focus.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): being occupied with a task. Metaphorical (Majaz): \"A preoccupied heart\" — one entangled with worldly concerns that obstruct spiritual presence.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or redirect something from one state to another; the heart is so named for its constant fluctuation and turning.\n  * Al-Raghib (Mufradat): The heart's turning between states; its transformation and redirection. In the Kalam context, the heart (qalb) is the seat of spiritual perception and intention.\n  * Al-Zamakhshari (Asas): Literal: physical turning over. Metaphorical: the heart's oscillation between attentiveness and distraction, and the deliberate redirecting of one's focus.\n- Root: شجر (Sh-J-R)\n  * Lisan / Ayn: Trees and vegetation with trunks; also used for branching and spreading out.\n  * Al-Raghib (Mufradat): The branching of a tree; used metaphorically for the ramification of desires and thoughts that spread and entangle.\n  * Al-Zamakhshari (Asas): Literal: trees. Metaphorical: \"The tree of desires\" — when its branches spread, thoughts are drawn to it as birds are drawn to trees.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The conditional and restrictive constructions (e.g., \"لا يطمعن,\" \"لا يغني غيره\") that establish exclusive causal relationships between spiritual states and their remedies.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'", "badge": "Insight"}], "103": [{"arabic": "وأنزل الله تعالى خذ من أموالهم صدقة تطهرهم وتزكيهم بها وصل عليهم إن صلاتك سكن لهم وأنزل الله تعالى فرائض الصدقة فبعث رسول الله صلى الله عليه وسلم رجلا من جهينة ورجلا من بني سليم عن الصدقة وكتب لهما كتابا بأخذ الصدقة وأمرهما أن يخرجا فيأخذا من المسلمين وقال مرا بثعلبة بن حاطب وبفلان رجل من بني سليم وخذا صدقاتهما فخرجا حتى أتيا ثعلبة فسألاه الصدقة وأقرآه كتاب رسول الله صلى الله عليه وسلم فقال ما هذه إلا جزية ما هذه إلا جزية ما هذه إلا أخت الجزية انطلقا حتى تفرغا ثم تعودا إلي فانطلقا نحو السليمي فسمع بهما فقام إلى خيار أسنان إبل", "english": "...the city became too constricted for him, so he withdrew from it and settled in one of its valleys, until he began to pray only the noon and afternoon prayers in congregation, abandoning all else besides them. Then his flocks multiplied and grew numerous, so he withdrew further until he abandoned the congregation entirely, except for the Friday prayer. And [his wealth] kept growing just as worms multiply, until he even abandoned the Friday prayer. He took to accosting travelers on the road on Fridays, asking them for news of what was happening in the city. The Messenger of Allah, may Allah bless him and grant him peace, asked about him, saying: \"What has become of Tha'labah ibn Hātib?\" It was said: \"O Messenger of Allah, he has acquired sheep such that the city became too narrow for him.\" And they informed him of his entire affair. So he said: \"Woe to Tha'labah! Woe to Tha'labah! Woe to Tha'labah!\" The narrator said: Then Allah, exalted is He, revealed: {«خُذْ مِنْ أَمْوَالِهِمْ صَدَقَةً تُطَهِّرُهُمْ وَتُزَكِّيهِمْ بِهَا وَصَلِّ عَلَيْهِمْ إِنَّ صَلَاتَكَ سَكَنٌ لَهُمْ»} (Take from their wealth an alms to purify them and cleanse them thereby, and pray for them — indeed your prayer is a tranquility for them). And Allah revealed the obligatory statutes of the alms-tax. So the Messenger of Allah, may Allah bless him and grant him peace, dispatched a man from Juhaynah and a man from the Banū Sulaym to collect the alms, and he wrote for them a document authorizing the collection of the alms, and he commanded them to go out and take the alms from the Muslims, saying: \"Pass by Tha'labah ibn Hātib and by so-and-so, a man from the Banū Sulaym, and take their alms from them.\" So they set out until they came to Tha'labah, and they asked him for the alms and recited to him the letter of the Messenger of Allah, may Allah bless him and grant him peace. He said: \"This is nothing but a tribute! This is nothing but a tribute! This is nothing but a sister of the tribute! Go away until you have finished [collecting from others], then return to me.\" So they went on toward the Sulamī, and when he heard of their approach, he rose and selected the choicest of his camels, setting them aside for the alms, then came out to meet them with them. When they saw them, they said: \"This is not obligatory upon you, and we do not wish to take these from you.\" He said: \"Indeed, take them.\" And when they had finished collecting the alms from the people, they returned and passed by Tha'labah, and they asked him for the alms. He said: \"Show me...\"", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 788", "section_title_en": "The Case of Tha'labah ibn Hātib — The Decline from Collective Worship to Withholding Alms", "section_index": 788, "anchors": "- Root: ثعلب (Tha'lab)\n  * Lisan / Ayn: The fox; a proper name derived from the cunning, swift-moving beast.\n  * Al-Raghib (Mufradat): Not a Quranic technical term; here a personal name (Tha'labah ibn Hātib), an Ansari Companion.\n  * Al-Zamakhshari (Asas): Literal usage as a proper noun; no metaphorical extension in this narrative context.\n- Root: زكو (Zakā)\n  * Al-Raghib (Mufradat): \"الزكاة: النمو الحاصل عن بركة الله تعالى\" — growth and purification; in the legal sense, the obligatory alms (ṣadaqah) that purifies wealth and the soul.\n  * Al-Zamakhshari (Asas): Literal: \"زكا الزرع\" (the crop thrived). Metaphorical: \"زكا الرجل\" (the man became righteous); here in the Quranic citation {«خُذْ مِنْ أَمْوَالِهِمْ صَدَقَةً تُطَهِّرُهُمْ وَتُزَكِّيهِمْ بِهَا»} — purification is literal (removal of sin) and growth is metaphorical (increase in divine reward).\n  * Lisan / Ayn: Root denotes increase and purity; the alms-tax is named for its effect of causing both moral and material growth.\n- Root: جزو (Jazā)\n  * Al-Raghib (Mufradat): \"الجزاء: المكافأة\" — recompense; from it derives \"الجزية\" (jizyah), the tribute exacted from non-Muslims in lieu of military service.\n  * Al-Zamakhshari (Asas): Literal: recompense for deeds. Metaphorical extension: Tha'labah's cry \"ما هذه إلا جزية\" (This is nothing but a tribute) is a rhetorical comparison — he equates the obligatory alms with the humiliating poll-tax, a gross mischaracterization.\n  * Lisan / Ayn: The root implies sufficiency and recompense; the jizyah is that which suffices as a token of submission.\n- Root: سكن (Sakan)\n  * Al-Raghib (Al-Mufradat): \"السكون: ضد الحركة\" — stillness; but \"السكن\" (as in the verse) is that which brings tranquility and repose.\n  * Al-Zamakhshari (Asas): Literal: dwelling-place. Metaphorical: in {«إِنَّ صَلَاتَكَ سَكَنٌ لَهُمْ»} — the Prophet's prayer is a source of spiritual calm and reassurance for the givers, a metaphorical \"dwelling\" of peace.\n- Sibawayh Rule: باب التكرير للتوكيد (Repetition for Emphasis) — The thrice-repeated \"يا ويح ثعلبة\" (Woe to Tha'labah!) and Tha'labah's thrice-repeated \"ما هذه إلا جزية\" follow the canonical pattern of triadic repetition for rhetorical intensification, marking both the Prophet's lament and the man's obstinate rejection.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Du'a"}], "104": [{"arabic": "والله يعلم ما في أنفسكم فاحذروه فاستغفرت الله في سري فناداني وقال {وهو الذي يقبل التوبة عن عباده} ثم غاب عني ولم أره وقال زكريا بن داود دخل أبو العباس بن مسروق على أبي الفضل الهاشمي وهو عليل وكان ذا عيال ولم يعرف له سبب يعيش به قال فلما قمت قلت في نفسي من أين يأكل هذا الرجل قال فصاح بي يا أبا العباس رد هذه الهمة الدنية فإن لله تعالى ألطافا خفية وقال أحمد النقيب دخلت على الشبلي فقال مفتونا يا أحمد فقلت ما الخبر قال كنت جالسا فجرى بخاطري أنك بخيل فقلت ما أنا بخيل فعاد مني خاطري وقال بل أنت بخيل فقلت ما فتح اليوم علي بشيء إلا دفعته", "english": "As for the evidences of the Sacred Law, there is His saying (Exalted is He): {«وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا»} (\"And those who strive in Us, We shall surely guide them to Our paths\") (Q. 29:69). So every wisdom that appears from the heart through persevering devotion to worship, without learning, is by way of unveiling and inspiration. And he (peace and blessings be upon him) said: \"Whoever acts upon what he knows, God bequeaths to him knowledge of what he does not know, and grants him success in what he does\" — until he becomes deserving of Paradise. And whoever does not act upon what he knows wanders astray in what he knows and is not granted success in what he does, until he becomes deserving of the Fire. [The hadith \"Whoever acts upon what he knows\" has preceded in the Book of Knowledge, without his saying \"and grants him success in what he does\" — I have not found it with that addition.] And God (Exalted is He) said: {«وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا»} (\"And whoever fears God, He makes for him a way out\") (Q. 65:2) — from perplexities and doubts — {«وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ»} (\"and provides for him from whence he does not reckon\") (Q. 65:3) — teaching him knowledge without learning and granting him discernment without experience. And God (Exalted is He) said: {«يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا»} (\"O you who believe, if you fear God, He will make for you a criterion\") (Q. 8:29) — it is said: a light by which one distinguishes between truth and falsehood and by which one emerges from doubts. For this reason, he (peace and blessings be upon him) was abundant in his supplication in asking for light, saying (peace and blessings be upon him): \"O God, grant me light, and increase me in light, and make for me light in my heart, and light in my grave, and light in my hearing, and light in my sight\" — until he said: \"and light in my hair, and in my skin, and in my flesh, and in my blood, and in my bones.\" [Agreed upon (by al-Bukhari and Muslim).] [The hadith concerning his being asked about His saying {«أَفَمَنْ شَرَحَ اللَّهُ صَدْرَهُ لِلْإِسْلَامِ»} (\"Is he whose breast God has expanded for Islam\") (Q. 39:22) — and in al-Mustadrak from the hadith of Ibn Masʿūd — has preceded in the Book of Knowledge.] And he (peace and blessings be upon him) said concerning Ibn ʿAbbās: \"O God, grant him understanding in religion and teach him the interpretation (taʾwīl).\" [The hadith of ʿAlī: \"We have nothing with us that the Messenger of God (peace and blessings be upon him) confided to us except that God grants a servant understanding in His Book\" — has preceded in the Etiquettes of Qurʾanic Recitation.] And it is said in the interpretation of His saying (Exalted is He): {«يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ»} (\"He grants wisdom to whom He wills\") (Q. 2:269) that it is understanding in the Book of God. And He (Exalted is He) said: {«فَفَهَّمْنَاهَا سُلَيْمَانَ»} (\"And We made Solomon understand it\") (Q. 21:79) — singling out what was unveiled with the name of understanding (fahm). And Abū al-Dardāʾ used to say: \"The believer is one who sees by the light of God from behind a thin veil. By God, it is the truth that God casts into their hearts and causes to flow upon their tongues.\" And some of the Salaf said: \"The believer's conjecture is like soothsaying.\"", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 594", "section_title_en": "The Unveiling of Knowledge Through Divine Inspiration and the Evidences of the Unseen", "section_index": 594, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning encompasses both perception of a thing's essence and judgment upon it—knowledge as direct apprehension or discursive ruling.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence (transitive to one object) and judgment upon existence or non-existence (transitive to two objects).\n  * Al-Zamakhshari (Asas): Literal usage denotes certainty and awareness (\"ما علمت بخبرك: ما شعرت به\"); metaphorical extension applies to marks, signs, and beacons of guidance (معالم الطريق) — here, the inspired knowledge is a \"mark\" of the path.\n- Root: كشف (kashafa)\n  * Lisan / Ayn: To remove a covering, unveil, disclose what was hidden.\n  * Al-Raghib (Mufradat): Unveiling (kashf) in theological terms is the removal of the veil (ghishāwah) from the heart such that the realities of things become directly witnessed, not merely inferred.\n  * Al-Zamakhshari (Asas): Literal: to lift a covering from a thing; metaphorical: the disclosure of inward states and hidden matters — the heart's eye perceives what the outward senses cannot.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, devour; farāsah — the lion's pouncing upon its prey.\n  * Al-Raghib (Mufradat): Discernment (farāsah) is a spiritual perception by which the believer penetrates into the inner states of others, a light cast by God into the heart.\n  * Al-Zamakhshari (Asas): Literal: the beast of prey seizing its quarry; metaphorical: the believer's insight seizing the truth of a matter or the hidden state of a person — \"اتقوا فراسة المؤمن فإنه ينظر بنور الله.\"\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: To be new, originate after non-existence; muḥaddath — one who is spoken to, inspired with true speech from the unseen.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence; the muḥaddath is one to whom divine inspiration comes as a new, immediate occurrence without acquired means.\n  * Al-Zamakhshari (Asas): Literal: newness of a thing; metaphorical: \"كان عمر رضي الله عنه محدثا أي صادق الحدس، كأنما حدث بما ظن\" — one whose intuition is so true it is as if he were directly spoken to.\n- Sibawayh Rule: Restriction and specification (الحصر والتقييد) — the particle \"إنما\" and conditional clauses (إن/إذا) restrict predicates to their subjects, as in \"إنما العالم الذي يأخذ علمه من ربه\" — the true scholar is exclusively the one who takes knowledge from his Lord.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "108": [{"arabic": "الله عليه وسلم مفتاح الصلاة الطهور (3) وقال الله تعالى {فيه رجال يحبون أن يتطهروا والله يحب المطهرين} وقال النبي صلى الله عليه وسلم الطهور نصف الإيمان (4) وقال الله تعالى {ما يريد الله ليجعل عليكم من حرج ولكن يريد ليطهركم} فتفطن ذوو البصائر بهذه الظواهر أن أهم الأمور تطهير السرائر إذ يبعد أن يكون المراد بقوله صلى الله عليه وسلم الطهور نصف الإيمان عمارة الظاهر بالتنظيف بإفاضة الماء وإلقائه وتخريب الباطن وإبقائه مشحونا بالأخباث والأقذار هيهات هيهات والطهارة لها أربع مراتب المرتبة الأولى تطهير الظاهر عن الأحداث وعن الأخباث والفضلات ا", "english": "The Prophet, peace be upon him, said: \"Religion is built upon cleanliness.\" And he said, peace be upon him: \"The key to prayer is purification.\" And God Most High said: {فِيهِ رِجَالٌ يُحِبُّونَ أَن يَتَطَهَّرُوا وَاللَّهُ يُحِبُّ الْمُطَّهِّرِينَ} — \"In it are men who love to purify themselves, and God loves those who purify themselves.\" And the Prophet, peace be upon him, said: \"Purification is half of faith.\" And God Most High said: {مَا يُرِيدُ اللَّهُ لِيَجْعَلَ عَلَيْكُم مِّنْ حَرَجٍ وَلَكِن يُرِيدُ لِيُطَهِّرَكُمْ} — \"God does not intend to place upon you any hardship, but He intends to purify you.\"", "book_title": "Mysteries of Purity", "section_title_ar": "Section 106", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 106: On the True Meaning of Purification and Its Four Ranks", "section_index": 106, "anchors": "- Root: ط-ه-ر (ṭahara)\n  * Lisān / ʿAyn: The root denotes cleanliness, purity, and freedom from filth—both physical and spiritual. Al-Farāhīdī records its core sense as the removal of that which is defiling.\n  * Al-Rāghib (Mufradāt): \"الطهارة ضربان: طهارة جسم، وطهارة نفس\" — Purification is of two kinds: purification of the body and purification of the soul. The Quranic verses (e.g., {وَإِن كُنتُم جُنُبًا فَاطَّهَّرُوا}) are carried upon both senses, with the physical serving as the vehicle for the spiritual.\n  * Al-Zamakhsharī (Asās): Literal (ḥaqīqah): washing with water. Metaphorical (majāz): \"تطهر من الإثم: تنزه منه\" — purification from sin is self-exculpation; \"التوبة طهور للمذنب\" — repentance is a purification for the sinner. The prophetic dictum \"الطهور نصف الإيمان\" operates on the metaphorical axis, for the \"half\" of faith is the cleansing of the inner self.\n- Root: س-ر-ر (sirr)\n  * Lisān / ʿAyn: The innermost secret, the hidden depth of the self; that which is concealed from public view.\n  * Al-Rāghib (Mufradāt): The \"secret\" (sirr) is the innermost faculty of the heart where divine knowledge (maʿrifah) is unveiled; it is the locus of the soul's encounter with God.\n  * Al-Zamakhsharī (Asās): Literal: a concealed matter. Metaphorical: the spiritual core (al-latīfah al-rabbāniyyah) that must be emptied of all save God.\n- Root: ق-ل-ب (qalb)\n  * Al-Rāghib (Mufradāt): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — The heart is so named because of its constant turning (taqallub) and fluctuation between states. It is the seat of both the blameworthy traits (akhlāq madhmūmah) and the praiseworthy ones (akhlāq maḥmūdah).\n  * Al-Zamakhsharī (Asās): Literal: the physical organ. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — the heart as the faculty of discernment and moral disposition.\n- Sībawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The phrase \"إنما بني الدين على النظافة\" restricts the foundation of religion to purification, requiring the interpreter to determine which sense of \"purification\" (physical or spiritual) constitutes the true foundation, given the prophetic context.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Purity'", "badge": "Du'a"}], "109": [{"arabic": "البنيان وارتفع وإذا ضعف الأساس واعوج انهار البنيان ووقع وقال الله عز وجل أفمن أسس بنيانه على تقوى من الله الآية وفي الحديث من اكتسب مالا من حرام فإن تصدق به لم يقبل منه وإن تركه وراءه كان زاده إلى النار (11) وقد ذكرنا جملة من الأخبار في كتاب آداب الكسب تكشف عن فضيلة الكسب الحلال وأما الآثار فقد ورد أن الصديق رضي الله عنه شرب لبنا من كسب عبده ثم سأل عبده فقال تكهنت لقوم فأعطوني فأدخل أصابعه في فيه وجعل يقيء حتى ظننت أن نفسه ستخرج ثم قال اللهم إني أعتذر إليك مما حملت العروق وخالط الأمعاء (12) وفي بعض الأخبار أنه صلى الله عليه وسلم أ", "english": "God Most High has said: {«كلوا من الطيبات واعملوا صالحا»} — \"Eat of the good things and do righteous deeds.\" (Q. 23:51) He commanded eating from the good things before [commanding] righteous deeds. And it is said that what is meant by \"the good things\" is the lawful (al-ḥalāl).", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 336", "section_title_en": "The Revival of the Religious Sciences — Book of the Etiquette of Eating: Section 336 — The Virtue of Lawful Sustenance and the Blameworthiness of the Forbidden", "section_index": 336, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core root meaning of eating, consuming, and tasting food; the act of taking nourishment into the body.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of food; used metaphorically for fire consuming wood, and extended to mean lawful provision (ḥalāl) as the sustenance of the soul's soundness.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical ingestion; metaphorical (majāz) for consuming wealth unlawfully, as in \"أكل مال اليتيم\" (devouring the orphan's wealth).\n- Root: طعم (tuʿm)\n  * Lisan / Ayn: Food, sustenance, and the act of tasting; also used for bait and that which is eaten.\n  * Al-Raghib (Mufradat): Sustenance as that which nourishes the body; in the Kalam context, the lawful (ḥalāl) is that which purifies the heart, while the forbidden (ḥarām) corrupts it.\n  * Al-Zamakhshari (Asas): Literal for food; metaphorical for the moral state of the soul — \"طعمه حرام\" (his food is forbidden) signifies the corruption of one's entire being.\n- Root: ورق (waraʿ)\n  * Lisan / Ayn: Abstinence, scrupulousness, and piety; refraining from doubtful matters.\n  * Al-Raghib (Mufradat): The theological virtue of cautious avoidance of all that is suspect, as the foundation of true worship and the key to answered supplication.\n  * Al-Zamakhshari (Asas): Literal for refraining; metaphorical for the heart's purity achieved through guarding the limbs from the unlawful.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure of conditional and consequential clauses, where the protasis (e.g., \"من أكل حراما\") governs the apodosis (\"لم يقبل منه صرف ولا عدل\"), demonstrating the causal nexus between action and divine recompense.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'The Lawful and Prohibited'", "badge": "Insight"}], "111": [{"arabic": "{الله تعالى} إن الله اشترى من المؤمنين أنفسهم وأموالهم بأن لهم الجنة وذلك بالجهاد وهو مسامحة بالمهجة شوقا إلى لقاء الله عز وجل والمسامحة بالمال أهون ولما فهم هذا المعنى في بذل الأموال انقسم الناس إلى ثلاثة أقسام قسم صدقوا التوحيد ووفوا بعهدهم ونزلوا عن جميع أموالهم فلم يدخروا دينارا ولا درهما فأبوا أن يتعرضوا لوجوب الزكاة عليهم حتى قيل لبعضهم كم يجب من الزكاة في مائتي درهم فقال أما على العوام بحكم الشرع فخمسة دراهم وأما نحن فيجب علينا بذل الجميع ولهذا تصدق أبو بكر رضي الله عنه بجميع ماله وعمر رضي الله عنه بشط", "english": "The first: The utterance of the two words of the testimony (shahādatayn) is a commitment to divine unity (tawḥīd) and a witnessing to the singleness of the Worshipped One. The condition for the perfection of fidelity (wafā') to this commitment is that no beloved remain for the unitarian (muwaḥḥid) other than the One, the Single (al-wāḥid al-fard) — for love admits no partnership (shirkah). Verbal unitarianism is of little avail; rather, by it the degree of the lover is tested through his separation from the beloved. Wealth is beloved to creatures because it is the instrument of their enjoyment of this world; through it they find comfort in this world and shrink from death — even though in death lies the encounter with the Beloved. They were therefore tested in the truthfulness (ṣidq) of their claim concerning the Beloved: they were called upon to relinquish wealth, which is their object of aspiration and their cherished passion. For this reason God—exalted is He—said: {«إِنَّ اللَّهَ اشْتَرَىٰ مِنَ الْمُؤْمِنِينَ أَنفُسَهُمْ وَأَمْوَالَهُم بِأَنَّ لَهُمُ الْجَنَّةَ»} (Verily God has purchased from the believers their lives and their wealth, in exchange for Paradise) — and this is in the context of jihad, which is the relinquishing of the soul itself out of longing for the encounter with God—mighty and majestic is He—and the relinquishing of wealth is the easier matter.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 172", "section_title_en": "Exposition of the Subtle Inward Etiquettes Concerning the Alms-Tax (Zakāh)", "section_index": 172, "anchors": "- Root: صدق (Ṣadaqa)\n  * Lisan / Ayn: Core meaning of truthfulness and veracity in speech and action; the root denotes the correspondence of inward conviction with outward expression.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truth and falsehood originate in speech, but may extend by derivation to other domains; the truthful one (ṣiddīq) is he whose inward faith is perfectly matched by outward conduct.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صدقته الحديث\" — to affirm someone's report as true. Metaphorical (majāz): \"رجل صادق الحملة\" — a man truthful in his charge (i.e., steadfast in battle), indicating that truthfulness in action is a transferred sense of the root.\n- Root: وحد (Waḥada)\n  * Lisan / Ayn: Oneness, singularity, uniqueness; that which has no second or partner.\n  * Al-Raghib (Mufradat): \"الواحد في الحقيقة هو الشيء الذي لا جزء له البتة\" — the One in reality is that which has no part whatsoever; used of God to denote absolute uniqueness excluding all participation in His essence or attributes.\n  * Al-Zamakhshari (Asas): Literal: \"هو واحد\" — he is one. The term \"الواحد الفرد\" (the One, the Single) emphasizes absolute solitude in divinity, admitting no associate in love or worship.\n- Root: وفي (Wafā)\n  * Lisan / Ayn: Completeness, fulfillment, loyalty; to discharge a covenant or promise in full measure.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — the faithful one is he who attains completion; \"أوفى بعهده\" — to fulfill one's covenant entirely without breach.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" — a full-weight dirham. Metaphorical: \"أوفى على المائة\" — to exceed a hundred, indicating surplus beyond the required measure; the ṣiddīq's fulfillment exceeds the bare minimum of legal obligation.\n- Root: قسم (Qasama)\n  * Lisan / Ayn: Division, apportionment, distribution into parts or shares.\n  * Al-Raghib (Mufradat): \"القسم: إفراز النصيب\" — division is the separation of portions; used of dividing inheritances and spoils among rightful recipients.\n  * Al-Zamakhshari (Asas): Literal: \"قسموا المال بينهم\" — they divided the wealth among themselves. Metaphorical: \"قلبه متقسم\" — his heart is divided (by competing concerns), illustrating the inner division of humanity regarding love of wealth versus love of God.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle \"إنما\" restricts the predicate to the subject alone, excluding all else; applied here to the exclusivity of divine love: \"the love [of the heart] admits no partnership.\"", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "بأن لهم الجنة ثم بين أن صفقتهم رابحة فقال تعالى فاستبشروا ببيعكم الذي بايعتم به فليس يحتاج من العلم في الزهد إلا إلى هذا القدر وهو أن الآخرة", "english": "Know that asceticism in this world (al-zuhd fī al-dunyā) is a noble station (maqām sharīf) among the stations of the wayfarers (al-sālikīn). This station is composed of knowledge (ʿilm), a state (ḥāl), and action (ʿamal), just like all other stations — for all the gates of faith, as the predecessors (al-salaf) said, reduce to a creedal affirmation (ʿaqd), a utterance (qawl), and an action (ʿamal). It is as though utterance, due to its outward manifestation, was made to stand in the place of the state (ḥāl), since through it the inner state becomes manifest. Otherwise, utterance is not intended for its own sake; if it does not issue from a state, it is called \"submission\" (islām) and is not called \"faith\" (īmān). Knowledge is the cause that produces the state, running in the manner of a fruit-bearing tree, while action runs from the state in the manner of the fruit itself. So let us mention the state together with both of its two extremities — knowledge and action.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1087", "section_title_en": "On Asceticism (Al-Zuhd) — Its Reality, Conditions, and Degrees", "section_index": 1087, "anchors": "- Root: زهد (Z-H-D)\n  * Lisan / Ayn: Core meaning: scarcity, smallness, and abstemiousness; also estimation (kharṣ) of fruit.\n  * Al-Raghib (Mufradat): \"الزهيد: الشيء القليل، والزاهد في الشيء: الراغب عنه والراضي منه بالزهيد\" — the ascetic is one who turns away from a thing, content with little instead of it.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"زهد في الشيء: رغب عنه\" (to turn one's desire away from something). Metaphorical (Majaz): \"رجل زهيد: قليل الخير\" — applied to one of little worth; \"واد زهيد\" — a valley that takes little water. The term is conventionally restricted to renouncing the permissible (mubāḥāt), not the forbidden.\n- Root: رغب (R-GH-B)\n  * Lisan / Ayn: Root denotes spaciousness and amplitude; \"رغب الشيء: اتسع\" (the thing became wide).\n  * Al-Raghib (Mufradat): \"أصل الرغبة: السعة في الشيء... والرغبة والرغب والرغبى: السعة في الإرادة\" — desire is an expansion of the will toward something; \"رغب عنه\" implies turning desire away (the very definition of zuhd).\n  * Al-Zamakhshari (Asas): Literal: \"هو راغب فيه وراغب عنه\" — one can be desirous of a thing or averse to it. Metaphorical: \"واد رغيب: كثير الأخذ للماء\" — a valley that takes much water, contrasting with \"واد زهيد\" (one that takes little). Thus, zuhd and raghbah are relative terms defined by their objects.\n- Root: دنا (D-N-W)\n  * Al-Raghib (Mufradat): \"الدنو: القرب بالذات، أو بالحكم\" — nearness in essence or by judgment; used for place, time, and rank. The \"nearer\" (adnā) life is the worldly life, contrasted with the \"farther\" (ākhirah), which is superior and more enduring.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The term \"zāhid\" (ascetic) is not applied absolutely but is restricted by convention (istiṣlāḥ) to specific objects of renunciation (worldly goods), just as \"mulḥid\" (heretic) is restricted to one who inclines to falsehood, though the root meaning is broader. This governs the author's analysis of how names are conventionally specified.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "الله يحب الذين يقاتلون في سبيله صفا وقال عز وجل يقاتلون في سبيل الله فيقتلون ويقتلون وفي وصية أبي بكر لعمر رضي الله تعالى عنهما الحق ثقيل وهو مع ثقله مرىء والباطل خفيف وهو مع خفته وبىء فإن حفظت وصيتي لم يكن غائب أحب إليك من الموت وهو مدركك وإن ضيعت وصيتي لم يكن غائب أبغض إليك من الموت ولن تعجزه ويروى عن إسحق بن سعد بن أبي وقاص قال حدثني أبي أن عبد الله بن جحش قال له يوم أحد ألا ندعو الله فخلوا في ناحية فدعا عبد الله بن جحش فقال يارب إني أقسمت عليك إذا لقيت العدو غدا فلقني رجلا شديدا بأسه شديدا حرده أقاتله فيك ويقاتلني ثم يأخذني", "english": "He, peace be upon him, said: «من أحب لقاء الله أحب الله لقاءه» — \"Whoever loves the meeting with God, God loves meeting with him.\" And Ḥudhayfah said at the moment of death: \"A beloved has come upon the occasion of need; he who regrets has not succeeded.\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1175", "section_title_en": "The Signs and Proofs of Love for God — Section 1175", "section_index": 1175, "anchors": "- Root: ح ب ب (ḥ-b-b)\n  * Lisan / Ayn: Core root meaning: to love, to cherish; al-ḥabīb is the beloved; maḥabbah denotes the inclination of the heart toward that which pleases it.\n  * Al-Raghib (Mufradat): Maḥabbah of God for the servant is His willing good for him and drawing him near; the servant's love for God is his inclination toward obedience and his yearning for vision (ru'yah) of Him.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the heart's attachment; metaphorical (majāz): love as expressed through action and sacrifice, since mere claim without proof is empty.\n- Root: م و ت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of corporeal life; the transition from this abode.\n  * Al-Raghib (Mufradat): Death is not annihilation but departure from the body — a relocation of the soul; hence the believer's love of death is love of meeting God.\n  * Al-Zamakhshari (Asas): Literal: biological death; metaphorical: the \"death\" of appetites and the severance of worldly attachments as a spiritual state.\n- Root: ق ت ل (q-t-l)\n  * Lisan / Ayn: Killing, slaying; qitāl is combat.\n  * Al-Raghib (Mufradat): Martyrdom (shahādah) in God's path is the supreme proof of sincere love, as it offers the self entirely.\n  * Al-Zamakhshari (Asas): Literal: physical combat; metaphorical: the struggle against the lower self (jihād al-nafs) as the greater warfare.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish genuine love from mere claim, restricting true love to that which is evidenced by action.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}], "112": [{"arabic": "رضي الله عنه يا رسول الله ومن هم قال الآمرون بالمعروف والناهون عن المنكر والمحبون في الله والمبغضون في الله {ثم قال} والذي نفسي بيده إن العبد منهم ليكون في الغرفة فوق الغرفات فوق غرف الشهداء للغرفة منها ثلثمائة ألف", "english": "Know that the verses indicating the obligation of commanding right and forbidding wrong are numerous. Among them is His saying, may He be exalted: {«Let there arise from among you a nation inviting to good, commanding right and forbidding wrong — and those are the successful»} (Āl ʿImrān 3:104). In this verse is the declaration of obligation, for His saying, may He be exalted, \"Let there be\" (wal-takun) is a command, and the apparent meaning of a command is obligation. In it also is the declaration that success (falāḥ) is contingent upon it, for He restricted it and said: {«And those are the successful»}. In it also is the declaration that it is a collective obligation (farḍ kifāyah), not an individual obligation (farḍ ʿayn), and that when a group undertakes it, the obligation falls from the rest — for He did not say, \"Let all of you be commanders of right,\" but rather said: {«Let there arise from among you a nation»}. Thus, whenever one person or a group undertakes it, the burden falls from the others, and success is particularized to those who undertake it and directly perform it. But if all of creation were to hold back from it, the burden would encompass all those capable of it without exception.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 521", "section_title_en": "Section 521", "section_index": 521, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "118": [{"arabic": "في الحر والشمس زمانا طويلا حتى إذا ضاق عليه الأمر وبلغ به المجهود أمر برفع حسابه", "english": "For this reason, Kaʿb al-Aḥbār said: \"Knowledge has a tyranny like the tyranny of wealth.\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 868", "section_title_en": "The Sixth Cause of Pride: Pride in Knowledge — Its Danger and the First Remedy", "section_index": 868, "anchors": "- Root: كبر (k-b-r)\n  * Lisan / Ayn: Core meaning of bigness in stature, age, or rank; \"كبر عليه\" = to be grievous/heavy upon one.\n  * Al-Raghib (Mufradat): \"Al-Kabīr and al-ṣaghīr are relative terms (mutadāyifān) — a thing is small beside one thing and great beside another; used of both connected quantity (bodies) and disconnected quantity (number).\"\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"Kabar al-amr\" = the matter became great; \"kabura ʿalayhi\" = it was burdensome. Metaphorical (majāz): applied to rank, honor, and station, not merely physical size.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Perception and apprehension of a thing as it truly is; the root also yields \"ʿalam\" (sign/marker) and \"maʿlam\" (landmark) — knowledge as that by which one is guided.\n  * Al-Raghib (Mufradat): \"Al-ʿilm: idrāk al-shayʾ bi-ḥaqīqatihi\" — apprehension of a thing in its true reality; two kinds: (1) apprehension of the essence of a thing, (2) judgment upon a thing affirming or denying something of it.\n  * Al-Zamakhshari (Asas): Literal: \"Huwa min aʿlām al-ʿilm al-khāfiqah\" — he is among the lofty banners of knowledge; \"maʿālim al-ṭarīq\" = the traces by which the road is recognized. Knowledge is that which marks and distinguishes.\n- Root: خطر (kh-ṭ-r)\n  * Lisan / Ayn: To be in peril; \"khaṭar\" = danger, risk; also \"khaṭara bi-nafsihi\" = to hazard oneself.\n  * Al-Raghib (Mufradat): Not separately glossed in the retrieved entry, but the Qur'anic usage (e.g., \"akhṭara\" in the sense of grave consequence) aligns with the notion of imminent peril.\n  * Al-Zamakhshari (Asas): Literal: \"Khaṭar\" = danger/risk; \"rajul khaṭīr\" = a man of great consequence — the same root yields both \"peril\" and \"high station,\" a deliberate lexical pairing Ghazali exploits here.\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The periodic sentence structure here (\"فإنهما كمالان في النفس جديران بأن يفرح بهما\") employs embedded relative clauses and prepositional phrases that must be unpacked in English without losing the logical subordination.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Pride and Conceit'", "badge": "Afterlife"}], "119": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "120": [{"arabic": "فتح الباب والله لا يضيع أجر المحسنين وإن تك حسنة يضاعفها ويؤت من لدنه أجرا عظيما المقام الثاني في دفع العارض منه في أثناء العبادة وذلك لا بد من تعلمه أيضا فإن من جاهد نفسه وقلع مغارس الرياء من قلبه بالقناعة وقطع الطمع وإسقاط نفسه من أعين المخلوقين واستحقار مدح المخلوقين وذمهم فالشيطان لا يتركه في أثناء العبادات بل يعارضه بخطرات الرياء ولا تنقطع عنه نزعاته وهوى النفس وميلها لا ينمحي بالكلية فلا بد وأن يتشمر لدفع ما يعرض من خاطر الرياء وخواطر الرياء ثلاثة قد تخطر دفعة واحدة كالخاطر ال", "english": "So when the harm and injury of these causes is firmly settled in his heart, his desire [for them] slackens, and his heart turns toward God. For the intelligent person does not covet that whose harm is abundant and whose benefit is scant. It suffices him that if people knew what is in his inner self—the intent of ostentation (riyā') and the display of sincerity—they would abhor him. And God will surely expose his secret until He makes him odious to the people and makes them know that he is a show-off, abhorrent to God. Had he been sincere to God, God would have unveiled his sincerity to them, made him beloved to them, subjected them to him, and loosened their tongues in praise and commendation of him—even though there is no perfection in their praise, nor deficiency in their blame. As the poet of Banī Tamīm said: \"My praise is an adornment, and my blame is a disgrace.\" The Messenger of God (peace and blessings be upon him) said to him: \"You have lied—that belongs to God, there is no deity but Him.\" // [Hadith: A poet of Banī Tamīm said, \"My praise is an adornment, and my blame is a disgrace.\" He (the Prophet) said: \"You have lied—that belongs to God.\" Ahmad narrated it from the hadith of al-Aqra' ibn Ḥābis—who was the speaker of that verse, excluding the phrase \"You have lied\"—and its narrators are trustworthy, except that I do not know of Abū Salamah ibn 'Abd al-Raḥmān having heard [directly] from al-Aqra'. Al-Tirmidhī narrated it from the hadith of al-Barā' and deemed it sound (ḥasan), with the wording: \"A man said, 'Indeed, my praise...'\"]", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 827", "section_title_en": "The Revival of the Religious Sciences — Section 827: The Second Station: Repelling the Accidental Promptings of Ostentation During Worship", "section_index": 827, "anchors": "- Root: كذب (kadhaba)\n  * Lisan / Ayn: Core meaning: falsehood, lying, saying what is contrary to reality; also used for \"to declare someone a liar.\"\n  * Al-Raghib (Mufradat): In theological context, kadhb is the antithesis of sidq (truthfulness); it is a moral and epistemic vice, often linked to hypocrisy (nifāq) and false claims.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): to report what did not occur. Metaphorical (majāz): attributing to God what is unworthy of Him, as in the Prophet's rebuke of the poet's self-praise.\n- Sibawayh Rule: Rule of Predicate Emphasis (Bāb al-Tawkīd) — The Prophet's reply \"كَذَبْتَ\" (You have lied) functions as an emphatic categorical refutation, structured as a nominal sentence with implied subject, establishing a permanent verdict rather than a transient rebuke.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Status and Ostentation'", "badge": "Insight"}, {"arabic": "من إيمان وقوله تعالى إنا لا نضيع أجر من أحسن عملا وقوله تعالى إن الله لا يضيع أجر المحسنين فكيف يضيع أجر أصل الإيمان وجميع الطاعات بمعصية واحدة وقوله تعالى ومن يقتل مؤمنا متعمدا أي لإيمانه وقد ورد على مثل هذا السبب فإن قلت فقد مال الاختيار إلى أن الإيمان حاصل دون العمل وقد اشتهر عن السلف قولهم الإيمان عقد وقول وعمل فما معناه قلنا لا يبعد أن يعد العمل من الإيمان لأنه مكمل له ومتمم كما يقال الرأس واليدان من الإنسان ومعلوم أنه يخرج عن كونه إنسانا بعدم الرأس ولا يخرج عنه بكونه مقطوع اليد وكذلك يقال التسبيحات والتكبيرات من الصلاة وإن كا", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Foundations of Belief'", "badge": "Dhikr"}], "122": [{"arabic": "قوله عز وجل {ليتفقهوا في الدين ولينذروا قومهم إذا رجعوا إليهم} وما يحصل به الإنذار والتخويف هو هذا الفقه دون تفريعات الطلاق والعتاق واللعان والسلم والإجارة فذلك لا يحصل به إنذار ولا تخويف بل التجرد له على الدوام يقسي القلب وينزع الخشية منه كما نشاهد الآن من المتجردين له وقال تعالى {لهم قلوب لا يفقهون بها} وأراد به معاني الإيمان دون الفتاوى ولعمري إن الفقه والفهم في اللغة اسمان بمعنى واحد وإنما يتكلم في عادة الاستعمال به قديما وحديثا قال تعالى {لأنتم أشد رهبة في صدورهم من الله} الآية فأحال قلة خوفهم من الله وا", "english": "They have manipulated this term through specification (takhṣīṣ), not through transfer (naql) or conversion (taḥwīl), for they have restricted it to knowledge of obscure legal branches (furūʿ gharībah) in legal opinions (fatāwā), to grasping the subtleties of their underlying causes (ʿilal), to multiplying discourse concerning them, and to memorizing the doctrinal positions related to them. Whoever is more profound in this and more occupied with it is called \"the most learned in fiqh\" (al-afqah). Yet in the first era, the name fiqh was applied absolutely to knowledge of the path of the Hereafter, to knowing the subtleties of the maladies of the souls (āfāt al-nufūs), to the corrupters of deeds (mufsidāt al-aʿmāl), to the power of encompassing the pettiness of this world, to intense longing for the bliss of the Hereafter, and to the dominance of fear over the heart. What indicates this to you is His saying, Mighty and Majestic: {«ليتفقهوا في الدين ولينذروا قومهم إذا رجعوا إليهم»} [“That they may gain understanding in the religion and warn their people when they return to them”] (Q 9:122). What effects warning and intimidation is this very fiqh — not the subdivisions of divorce (ṭalāq), manumission (ʿitāq), imprecation (liʿān), salam contracts, and leases (ijārah). For that (latter) does not produce warning or intimidation; rather, total devotion to it perpetually hardens the heart and strips away godly fear (khashyah) from it, as we now observe in those wholly devoted to it.", "book_title": "Book of Knowledge", "section_title_ar": "Section 27", "section_title_en": "The Revival of the Religious Sciences — Section 27: The Corruption of the Praiseworthy Names (Taḥrīf al-Asāmī al-Maḥmūdah)", "section_index": 27, "anchors": "- Root: فقه (Fiqh)\n  * Lisan / Ayn: Core linguistic meaning of \"understanding\" (al-fahm) and \"comprehension\" (al-fahm ʿan al-shayʾ)\n  * Al-Raghib (Mufradat): \"Al-fiqh: attainment of knowledge of the unseen through a witnessed sign — it is more specific than ʿilm.\" Theological nuance: true fiqh is knowledge of the heart's maladies and the path to the Hereafter.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"afqih ʿannī mā aqūl\" — understand what I say. Metaphorical (majāz): technical restriction to legal rulings (furūʿ al-fatāwā) is a later convention, not the lexical or prophetic norm.\n- Root: علم (ʿIlm)\n  * Lisan / Ayn: Perception of a thing as it truly is; knowledge of the essence of a thing.\n  * Al-Raghib (Mufradat): Two types: (1) perception of the essence of a thing; (2) judgment upon a thing affirming or negating something of it. The highest ʿilm is knowledge of God, His verses, and His acts.\n  * Al-Zamakhshari (Asas): Literal: \"He is from the banners (aʿlām) of knowledge.\" Metaphorical: restriction of the title \"scholar\" (al-ʿālim) to the dialectician (al-munāẓir) is a corrupt specification (takhṣīṣ fāsid).\n- Root: وحد (Waḥḥada)\n  * Lisan / Ayn: To make one; to affirm unity.\n  * Al-Raghib (Mufradat): Tawḥīd is affirming God's unity in essence, attributes, and acts — the highest degree being the vision that all things proceed from Him alone.\n  * Al-Zamakhshari (Asas): Literal: utterance of \"Lā ilāha illā Allāh.\" Metaphorical: the inner reality (al-lubāb) — seeing all affairs from God, cutting off attention from secondary causes.\n- Sibawayh Rule: باب التخصيص والتقييد (Restriction and Specification) — The corruption of names occurs through takhṣīṣ (semantic restriction), not naql (lexical transfer). The grammarians' principle: a general term (al-ism al-ʿāmm) retains its full semantic range unless a valid sharʿī or linguistic evidence restricts it; arbitrary restriction by custom (ʿādat al-istimāl) is a rhetorical device of the devils among men and jinn.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "أما الآيات فقوله تعالى {فلولا نفر من كل فرقة منهم طائفة ليتفقهوا في الدين} وقوله عز وجل {فاسألوا أهل الذكر إن كنتم لا تعلمون} وأما الأخبار فقوله صلى الله عليه وسلم من سلك طريقا يطلب فيه علما سلك الله به طريقا إلى الجنة (1) وقال صلى الله عليه وسلم إن الملائكة لتضع أجنحتها لطالب العلم رضاء بما يصنع (2) وقال صلى الله عليه وسلم لأن تغدو فتتعلم بابا من العلم خير من أن تصلي مائة ركعة (3) وقال صلى الله عليه وسلم باب من العلم يتعلمه الرجل خير له من الدنيا وما فيها (4) وقال صلى الله عليه وسلم اطلبوا العلم", "english": "As for the Quranic verses, there is the saying of God Most High: {«فلولا نفر من كل فرقة منهم طائفة ليتفقهوا في الدين»} — \"Why then did not a party from every section of them go forth, that they might gain deep comprehension in the religion?\" — and His saying, Mighty and Majestic: {«فاسألوا أهل الذكر إن كنتم لا تعلمون»} — \"So ask the people of remembrance if you do not know.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 7", "section_title_en": "The Virtue of Seeking Knowledge (Faḍīlat al-Taʿallum)", "section_index": 7, "anchors": "- Root: فقه (Fiqh)\n  * Lisan / Ayn: Core meaning is \"comprehension\" and \"understanding\" — the penetration into the inner meaning of speech, distinguished from mere hearing (samāʿ).\n  * Al-Raghib (Mufradat): In the theological register, *tafaqquh* (تفقه) is the deep, exhaustive comprehension of the religious sciences — not mere memorization but the attainment of the realities of juridico-theological matters.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes intellectual penetration; metaphorical (majāz) usage extends to any deep discernment of subtle meanings.\n- Root: سأل (Saʾala)\n  * Lisan / Ayn: To ask, to inquire, to seek information — the root act of petitioning for knowledge from its possessor.\n  * Al-Raghib (Mufradat): Asking (*suʾāl*) is the divinely mandated means for the ignorant to access knowledge, as per {«فاسألوا أهل الذكر»} — it is the key that unlocks the treasuries of knowledge.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal request; the Prophet's statement \"العلم خزائن مفاتيحها السؤال\" employs a metaphor (majāz) likening knowledge to locked treasuries and questioning to their keys.\n- Root: طلب (Ṭalab)\n  * Lisan / Ayn: To seek, to pursue, to search out a thing — whether a physical object or a meaning.\n  * Al-Raghib (Mufradat): \"الطلب: الفحص عن وجود الشيء، عينا كان أو معنى\" — the earnest investigation into the existence of a thing, whether concrete or conceptual. In the religious context, *ṭalab al-ʿilm* is the pursuit of that which revives the religion.\n  * Al-Zamakhshari (Asas): Literal usage is the physical pursuit of a quarry; the ḥadīth \"من سلك طريقا يطلب فيه علما\" employs the metaphor of the *path* (ṭarīq) as the means of pursuit, and the divine recompense as the *path to Paradise*.\n- Root: غدو (Ghadā)\n  * Lisan / Ayn: To go out early in the morning, to set forth at dawn — the time of vigorous, purposeful departure.\n  * Al-Zamakhshari (Asas): Literal usage denotes the morning journey; in the saying of Abū al-Dardāʾ, \"الغدو إلى طلب العلم\" is metaphorically elevated to the rank of *jihād* — the early morning departure for knowledge is a martial expedition of the soul.\n- Sibawayh Rule: Rule of Interposition (al-Faṣl bayna al-Jār wa-al-Majrūr) — The syntactic principle governing the separation of the prepositional phrase from its governing verb, as in \"سلك الله به طريقا إلى الجنة,\" where the divine agency is interposed between the act and its recompense, indicating the causal nexus.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "أما الآيات فقوله عز وجل {ولينذروا قومهم إذا رجعوا إليهم لعلهم يحذرون} والمراد هو التعليم والإرشاد وقوله تعالى وإذ أخذ الله ميثاق الذين أوتوا الكتاب ليبيننه للناس ولا يكتمونه وهو إيجاب للتعليم وقوله تعالى {وإن فريقا منهم ليكتمون الحق وهم يعلمون} وهو تحريم للكتمان كما قال تعالى في الشهادة {ومن يكتمها فإنه آثم قلبه} وقال صلى الله عليه وسلم ما آتى الله عالما علما إلا وأخذ عليه من الميثاق ما أخذ على النبيين أن يبينوه للناس ولا يكتموه (6) وقال تعالى {ومن أحسن قولا ممن دعا إلى الله وعمل صالحا} وقال تعالى {ادع إلى", "english": "As for the Qur'anic verses: His saying, Mighty and Majestic is He: {وَلِيُنذِرُوا قَوْمَهُمْ إِذَا رَجَعُوا إِلَيْهِمْ لَعَلَّهُمْ يَحْذَرُونَ} \"That they may warn their people when they return to them, that perhaps they may be cautious\" {«ولينذروا قومهم إذا رجعوا إليهم لعلهم يحذرون»} — and the intended meaning is teaching and guidance (al-taʿlīm wa-al-irshād).", "book_title": "Book of Knowledge", "section_title_ar": "Section 8", "section_title_en": "The Excellence of Teaching (Faḍīlat al-Taʿlīm)", "section_index": 8, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning is \"to know, to perceive a thing by its reality\"; the root also carries the sense of \"marker, sign, banner\" — that by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing by its true reality, divided into apprehension of the essence of a thing and judgment upon it. This is the attribute by which the scholar (ʿālim) is distinguished and by which he becomes a \"sign\" (ʿalam) pointing to truth.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — the scholar is among the lofty banners of knowledge. The teaching act makes the scholar a living signpost; the root's literal sense of \"marking\" or \"branding\" a thing carries into the metaphorical (majāz) register of \"imprinting\" knowledge upon hearts.\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: Core meaning is \"to be new, to occur after not having been\"; al-ḥadīth is speech that is new and conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence. The prophetic traditions (aḥādīth) cited here are \"newly conveyed\" reports that carry authority.\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"صاروا أحاديث\" — they became subjects of discourse. The transmission of knowledge is an \"event\" (ḥadath) that occurs in the listener, renewing his state.\n- Root: عهد (ʿahida)\n  * Lisan / Ayn: Core meaning is \"covenant, pact, charge\"; al-ʿahd is a binding commission that one is obligated to fulfill.\n  * Al-Raghib (Mufradat): The covenant (mīthāq) taken from the People of the Book and from the scholars is a divine charge (taklīf) that makes teaching an obligation, not a supererogatory act.\n  * Al-Zamakhshari (Asas): Literal: the covenant is a \"charge entrusted\" (waṣiyyah) that binds the one who receives knowledge to its dissemination.\n- Root: كتم (katama)\n  * Lisan / Ayn: Core meaning is \"to conceal, to hide\"; al-kitmān is the deliberate suppression of what ought to be revealed.\n  * Al-Raghib (Mufradat): Concealment of knowledge is paired with concealment of testimony (shahādah) in the Qur'an — both are sins of the heart (ithm al-qalb) because they withhold what God has commanded to be made manifest.\n  * Al-Zamakhshari (Asas): Literal vs. metaphorical: the \"bridle of fire\" (lijām min nār) on the Day of Judgment is a metaphorical (majāz) embodiment of the inner restraint of truth — the concealed knowledge becomes a physical restraint in the afterlife.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The verse {وإن فريقا منهم ليكتمون الحق وهم يعلمون} employs the restrictive particle \"inna\" with the continuous verb form (yaktimūn) to specify an ongoing, willful concealment, distinguishing it from mere ignorance. The conditional structures in the ḥadīth \"man taʿallama... man ʿallama... man katama\" (whoever learns... whoever teaches... whoever conceals) follow the canonical pattern of protasis-apodosis (sharṭ/jazāʾ) that establishes a universal causal linkage between the act and its recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "123": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "126": [{"arabic": "وقال تعالى أولا يرون أنهم يفتنون في كل عام مرة أو مرتين ثم لا يتوبون ولا هم يذكرون قيل يفتنون بأمراض يختبرون بها ويقال إن العبد إذا مرض مرضتين ثم لم يتب قال له ملك الموت:", "english": "Pain is an expiation for the day [of sins]. And when he—peace and blessings be upon him—mentioned the expiation of sins through fever, Zayd ibn Thabit asked his Lord—mighty and majestic—that he not cease to be feverish, and the fever did not leave him until he died—may God have mercy on him. A group of the Ansar also asked for that, and the fever did not cease to afflict them. And when he—peace and blessings be upon him—said: \"Whoever God takes away his two precious things [his eyes],\" he was not satisfied for him with a reward less than Paradise. The hadith: \"Whoever God takes away his two precious things, He is not satisfied for him with a reward less than Paradise\"—the marfuʿ portion of it has preceded without his saying: \"He said: For indeed among the Ansar there were those who wished for blindness.\" And Jesus—peace be upon him—said: \"He is not a scholar who does not rejoice at the entry of calamities and illnesses upon his body and his wealth, for what he hopes in that of the expiation of his sins.\" And it is related that Moses—peace be upon him—looked upon a servant of great affliction and said: \"O Lord, have mercy on him.\" So He—exalted—said: \"How shall I have mercy on him when through what afflicts him I have mercy on him?\"—that is, through it I expiate his sins and increase his ranks.", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1139", "section_title_en": "The Sixth Cause for Not Seeking Medical Treatment: Fear of Returning to Negligence and Transgression Through Health", "section_index": 1139, "anchors": "- Root: مرض (m-r-ḍ)\n  * Lisan / Ayn: Core meaning is departure from the balanced state of the body—sickness, ailment, malady.\n  * Al-Raghib (Mufradat): Twofold: (1) corporeal illness, and (2) metaphorical expression for moral vices—ignorance, cowardice, avarice, hypocrisy—as in {«فِي قُلُوبِهِم مَّرَضٌ»} (Al-Baqarah 10).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): bodily sickness. Metaphorical (Majaz): \"مرض في الأمر\" (to be weak/lax in a matter), and \"تمارض\" (to feign illness). Here, the text uses the literal sense for bodily fever, but the underlying spiritual cure is freedom from the \"disease\" of disobedience.\n- Root: حمي (ḥ-m-y)\n  * Lisan / Ayn: Core meaning: heat, fever; to protect, guard, or forbid.\n  * Al-Raghib (Mufradat): \"الحمي: الحرارة المتولدة من الجواهر المحمية\" — heat generated from heated substances; also \"حميت على فلان\" (to become angry/incensed). Fever (الحمى) is the specific bodily heat-illness.\n  * Al-Zamakhshari (Asas): Literal: \"حماه حماية\" (to protect him). Metaphorical: \"حمي عليه إذا غضب\" (to be angry), and \"شديد الحميا\" (fierce in self-respect). In this text, الحمى (fever) is literal, but its purpose is protective—guarding the servant from sin.\n- Root: عفو (ʿ-f-w) [implied in كفارة]\n  * Lisan / Ayn: كفارة derives from كفر (to cover, expiate); the root عفو means to pardon, obliterate sins.\n  * Al-Raghib (Mufradat): كفارة الذنوب — the expiation that covers sins, removing their punitive trace.\n  * Al-Zamakhshari (Asas): Literal: covering. Metaphorical: expiation as a \"covering\" of the sin's record.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The phrase \"إنما قال فرعون: أنا ربكم الأعلى لطول العافية\" restricts the cause of Pharaoh's claim to prolonged well-being, using \"إنما\" to confine the reason. Also, the conditional structures \"إذا أراد الله بعبد خيرا\" and \"إذا كان في المرض حبس\" employ the syntactic pattern of temporal-condition clauses (ظرفية شرطية) to link divine will to consequent states.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monotheism and Reliance'", "badge": "Afterlife"}, {"arabic": "مباح على معنى أن من أكله مرة أو مرتين لم يعص ومن دام عليه أيضا فلا يعصي بتناوله ولكن تتربى نفسه بالنعيم فتأنس بالدنيا وتألف اللذات وتسعى في طلبها فيجرها ذلك إلى المعاصي فهم شرار الأمة لأن مخ الحنطة يقودهم إلى اقتحام أمور تلك الأمور معاص وقال صلى الله عليه وسلم شرار أمتي الذين غذوا بالنعيم ونبتت عليه أجسامهم (2) وإنما همتهم ألوان الطعام وأنواع اللباس ويتشدقون في الكلام وأوحى الله تعالى إلى موسى عليه السلام اذكر أنك ساكن القبر فإن ذلك يمنعك من كثير الشهوات وقد اشتد خوف السلف من تناول", "english": "Indeed, the sustenance (qūt) of a group of the Companions was a ṣāʿ of wheat every Friday. When they ate dates, they took as their sustenance a ṣāʿ and a half of them. The ṣāʿ of wheat is four mudds, so each day would be nearly half a mudd — which is what we mentioned as the measure of one-third of the stomach. An increase was needed for dates because of the pits that are discarded from them. Abū Dharr, may Allah be pleased with him, used to say: \"My food every Friday is a ṣāʿ of barley, on the covenant of the Messenger of Allah, peace and blessings be upon him. By Allah, I will not increase upon it anything until I meet him, for I heard him say: 'The nearest of you to me in seating on the Day of Resurrection, and the most beloved of you to me, is the one who dies upon what he is upon today.'\" He used to say, disapproving of some of the Companions: \"You have changed — barley is sifted for you, though it was not sifted; you bake thin bread; you combine two condiments; foods of various colors are set before you; one of you goes out in one garment and returns in another. They were not like this in the era of the Messenger of Allah, peace and blessings be upon him.\"", "book_title": "Harms of the Tongue", "section_title_ar": "Section 645", "section_title_en": "The Revival of the Religious Sciences — Section 645: On Hunger and the Discipline of Eating", "section_index": 645, "anchors": "- Root: جوع (j-w-ʿ)\n  * Lisan / Ayn: Core meaning of emptiness of the belly, hunger as opposed to fullness (shabaʿ)\n  * Al-Raghib (Mufradat): Hunger as a spiritual discipline (riyāḍah) that purifies the heart and weakens the sway of sensual appetite\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — bodily hunger; Metaphorical (majāz) — the soul's longing and deprivation as spiritual training\n- Root: قوت (q-w-t)\n  * Lisan / Ayn: Sustenance, nourishment that maintains life; measure of food sufficient for survival\n  * Al-Raghib (Mufradat): Provision (rizq) in its minimal necessary form; the qūt is that which sustains the body's constitution without excess\n  * Al-Zamakhshari (Asas): Literal — food that sustains; Metaphorical — the spiritual sustenance of the heart through remembrance\n- Root: أدم (ʾ-d-m)\n  * Lisan / Ayn: That which is eaten with bread to make it palatable; condiment or relish\n  * Al-Raghib (Mufradat): The adornment of food; in spiritual discourse, the craving for variety and relish beyond bare necessity\n  * Al-Zamakhshari (Asas): Literal — condiment; Metaphorical — the soul's attachment to luxuries and embellishments of worldly life\n- Root: سرف (s-r-f)\n  * Lisan / Ayn: Excess, extravagance, going beyond the proper limit\n  * Al-Raghib (Mufradat): Transgression of the mean (iʿtidāl) in expenditure or consumption; blameworthy in all affairs\n  * Al-Zamakhshari (Asas): Literal — exceeding the measure; Metaphorical — spiritual extravagance in indulging desires\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The conditional and restrictive constructions (inna-mā, law, idhā) governing the precise boundaries of permissible and blameworthy eating", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Harms of the Tongue'", "badge": "Insight"}, {"arabic": "وقال الحسن العجب من ابن آدم يغسل الخرء بيده كل يوم مرة أو مرتين ثم يعارض جبار السموات وقد قيل في وفي أنفسكم أفلا تبصرون هو سبيل الغائط والبول وقد قال محمد بن الحسين بن علي ما دخل قلب امرئ شيء من الكبر قط إلا نقص من عقله بقدر ما دخل من ذلك أو كثر وسئل سليمان عن السيئة التي لا تنفع معها حسنة فقال الكبر وقال النعمان بن بشير على المنبر إن للشيطان مصالي وفخوخا وإن من مصالي الشيطان وفخوخه البطر بأنعم الله والفخر بإعطاء الله والكبر على عباد الله واتباع الهوى في غير ذات الله نسأل الله تعالى العفو والعافية", "english": "Abū Bakr al-Ṣiddīq, may God be pleased with him, said: \"Let no one belittle any one of the Muslims, for the lowliest of the Muslims is great in the sight of God.\"", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 849", "section_title_en": "On the Vice of Pride (Section 849) — The Narrations and Sayings Concerning Arrogance", "section_index": 849, "anchors": "- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core root meaning of greatness in size, age, or rank; the verbal noun *kibr* denotes arrogance as an internal disposition of self-magnification.\n  * Al-Raghib (Mufradat): *Al-Kibr* is a blameworthy self-elevation whereby one deems himself greater than others, opposing the divine attribute of *al-Kibriyā'* (Supreme Greatness) which belongs to God alone.\n  * Al-Zamakhshari (Asas): Literal (*haqīqah*) usage pertains to physical or temporal magnitude; metaphorical (*majāz*) usage transfers this to moral and spiritual arrogance, as in \"كبر عليه\" (it weighed heavily upon him).\n- Root: كنز (K-N-Z)\n  * Lisan / Ayn: To amass and hoard treasure; the noun *kanz* refers to accumulated wealth kept in reserve.\n  * Al-Raghib (Mufradat): In Quranic usage, *kanz* is condemned when wealth is withheld from obligatory expenditure, as in {«والذين يكنزون الذهب والفضة»} (those who hoard gold and silver).\n  * Al-Zamakhshari (Asas): The variant reading discussed here hinges on orthographic confusion between *kibr* (كبر) and *kanz* (كنز), a textual-critical point affecting the reported hadith.\n- Root: بطر (B-T-R)\n  * Lisan / Ayn: Extravagant joy and insolence arising from abundance; to be ungrateful for blessings through reckless behavior.\n  * Al-Raghib (Mufradat): *Al-Baṭar* is a moral corruption where one misuses divine favors, failing to recognize their source, leading to transgression.\n  * Al-Zamakhshari (Asas): Literal sense is \"to be cut off\" or \"perish\"; metaphorical sense is the arrogance that severs one from gratitude and humility.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The phrase \"إنما هو الكنز\" employs *innamā* to restrictively correct the transmitted wording, confining the true reading to *kanz* over *kibr*.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Pride and Conceit'", "badge": "Ethics"}], "128": [{"arabic": "البقرة (3) من قوله آمن الرسول وشهد الله (4) وقل اللهم مالك الملك الآيتين (5) وقوله تعالى {لقد جاءكم رسول من أنفسكم} إلى آخرها (6) وقوله تعالى {لقد صدق الله رسوله الرؤيا بالحق} إلى آخرها (7) وقوله سبحانه الحمد لله الذي لم يتخذ ولدا (8) الآية وخمس آيات من أول الحديد (9) وثلاثا من آخر سورة الحشر (10) وإن قرأ المسبعات العشر التي أهداها الخضر عليه السلام إلى إبراهيم التيمي رحمه الله ووصاه أن يقولها غدوة وعشية فقد استكمل الفضل وجمع له ذلك فضيلة جملة الأدعية المذكورة فقد روي عن كرز بن وبرة رحمه الله وكان من الأبدال قال أتاني أخ لي من أهل الشام", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}], "129": [{"arabic": "عند الحساب حسبي الله اللطيف عند الميزان حسبي الله القدير عند الصراط حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم وقد روي عن أبي الدرداء أنه قال من قال في كل يوم سبع مرات فإن تولوا فقل حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم كفاه الله عز وجل ما أهمه من أمر آخرته صادقا كان أو كاذبا دعاء عتبة الغلام وقد رؤي في المنام بعد موته فقال دخلت الجنة بهذه الكلمات اللهم يا هادي المضلين ويا راحم المذنبين ويا مقيل عثرات العاثرين ارحم عبدك ذا الخطر العظيم والمسلمين كلهم أجمعين واجعلنا مع الأخيار المرزوقين الذين أنعمت عليهم من النبيين والصديقين وا", "english": "Muḥammad ibn Ḥassān said: Maʿrūf al-Karkhī — may God have mercy on him — said to me: \"Shall I not teach you ten words — five for this world and five for the Hereafter? Whoever supplicates God — Mighty and Majestic — with them shall find God — Most High — present with them.\" I said: \"Write them down for me.\" He said: \"No, but I shall repeat them to you as Bakr ibn Khunays — may God have mercy on him — repeated them to me:", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 249", "section_title_en": "Section 249 — Supplications of the Righteous (Adʿiyat al-Ṣāliḥīn)", "section_index": 249, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficiency — \"ḥasb\" denotes that which suffices or is enough\n  * Al-Raghib (Mufradat): \"الحساب: استعمال العدد\" — the theological nuance of ḥasbī Allāh (\"God is my Sufficer\") carries the sense of complete reliance upon God's reckoning and provision, transcending mere numerical counting to signify total trust in divine sufficiency\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسب المال\" (he counted the wealth); Metaphorical (majāz): \"خرجا يتحسبان الأخبار\" (they go out seeking news) — in the supplication \"ḥasbī Allāh,\" the literal sense of \"sufficiency\" is intended, yet it carries the metaphorical extension of complete trust, as one who has God as his Sufficer has no need of any other reckoning\n\n- Root: اله (ʾ-l-h)\n  * Lisan / Ayn: Core meaning of worship, devotion, and seeking refuge; \"ilāh\" denotes that which is worshipped\n  * Al-Raghib (Mufradat): \"الله: قيل: أصله إله فحذفت همزته، وأدخل عليها الألف واللام، فخص بالباري تعالى\" — the name Allāh is the proper name of the Creator, distinguished from generic \"ilāh\" (any object of worship); in these supplications, the divine names invoked (al-Karīm, al-Ḥalīm, al-Qawī, al-Shadīd, al-Raḥīm, al-Raʾūf, al-Laṭīf, al-Qadīr) each specify particular attributes of the divine essence\n  * Al-Zamakhshari (Asas): Literal: \"فلان يتأله: يتعبد\" (he worships); the supplications employ the divine names in their literal theological sense, each name invoking a specific attribute relevant to the particular need mentioned\n\n- Root: انا (ʾ-n-y)\n  * Al-Raghib (Mufradat): \"أنا ضمير المخبر عن نفسه\" — the first-person pronoun; in the divine self-declaration \"innī anā Allāh,\" the repetition emphasizes divine self-identification\n  * Al-Zamakhshari (Asas): Literal: \"أنى الطعام أي إدراكه\" (the food ripened/reached its time) — the related sense of something reaching its appointed time appears in \"عند المسألة في القبر\" (at the questioning in the grave), indicating appointed moments of divine reckoning\n\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The supplications employ repeated prepositional phrases (ʿinda al-mawt, ʿinda al-masʾalah, ʿinda al-ḥisāb, ʿinda al-mīzān, ʿinda al-ṣirāṭ) in parallel construction, each governing a distinct divine name, creating a rhythmic liturgical structure where each clause stands as an independent invocation\n\n---\n\n##", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'On Invocations and Supplications'", "badge": "Afterlife"}, {"arabic": "أنه قال من قال في كل يوم سبع مرات فإن تولوا فقل حسبي الله لا إله إلا هو عليه توكلت وهو رب العرش العظيم كفاه الله عز وجل ما أهمه من أمر آخرته صادقا كان أو كاذبا دعاء عتبة الغلام وقد رؤي في المنام بعد موته فقال دخلت الجنة بهذه الكلمات اللهم يا هادي المضلين ويا راحم المذنبين ويا مقيل عثرات العاثرين ارحم عبدك ذا الخطر العظيم والمسلمين كلهم أجمعين واجعلنا مع الأخيار المرزوقين الذين أنعمت عليهم من النبيين والصديقين والشهداء والصالحين آمين يا رب العالمين دعاء آدم عليه الصلاة والسلام قالت عائشة رضي الله عنها لما اراد الله عز وجل أن يتوب ع", "english": "Muḥammad ibn Ḥassān said: Maʿrūf al-Karkhī — may God have mercy on him — said to me: \"Shall I not teach you ten words — five for this world and five for the Hereafter? Whoever supplicates God — Mighty and Majestic — with them shall find God — Most High — present with them.\" I said: \"Write them down for me.\" He said: \"No, but I shall repeat them to you as Bakr ibn Khunays — may God have mercy on him — repeated them to me:", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 249", "section_title_en": "Section 249 — Supplications of the Righteous (Adʿiyat al-Ṣāliḥīn)", "section_index": 249, "anchors": "- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning of counting, reckoning, and sufficiency — \"ḥasb\" denotes that which suffices or is enough\n  * Al-Raghib (Mufradat): \"الحساب: استعمال العدد\" — the theological nuance of ḥasbī Allāh (\"God is my Sufficer\") carries the sense of complete reliance upon God's reckoning and provision, transcending mere numerical counting to signify total trust in divine sufficiency\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسب المال\" (he counted the wealth); Metaphorical (majāz): \"خرجا يتحسبان الأخبار\" (they go out seeking news) — in the supplication \"ḥasbī Allāh,\" the literal sense of \"sufficiency\" is intended, yet it carries the metaphorical extension of complete trust, as one who has God as his Sufficer has no need of any other reckoning\n\n- Root: اله (ʾ-l-h)\n  * Lisan / Ayn: Core meaning of worship, devotion, and seeking refuge; \"ilāh\" denotes that which is worshipped\n  * Al-Raghib (Mufradat): \"الله: قيل: أصله إله فحذفت همزته، وأدخل عليها الألف واللام، فخص بالباري تعالى\" — the name Allāh is the proper name of the Creator, distinguished from generic \"ilāh\" (any object of worship); in these supplications, the divine names invoked (al-Karīm, al-Ḥalīm, al-Qawī, al-Shadīd, al-Raḥīm, al-Raʾūf, al-Laṭīf, al-Qadīr) each specify particular attributes of the divine essence\n  * Al-Zamakhshari (Asas): Literal: \"فلان يتأله: يتعبد\" (he worships); the supplications employ the divine names in their literal theological sense, each name invoking a specific attribute relevant to the particular need mentioned\n\n- Root: انا (ʾ-n-y)\n  * Al-Raghib (Mufradat): \"أنا ضمير المخبر عن نفسه\" — the first-person pronoun; in the divine self-declaration \"innī anā Allāh,\" the repetition emphasizes divine self-identification\n  * Al-Zamakhshari (Asas): Literal: \"أنى الطعام أي إدراكه\" (the food ripened/reached its time) — the related sense of something reaching its appointed time appears in \"عند المسألة في القبر\" (at the questioning in the grave), indicating appointed moments of divine reckoning\n\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The supplications employ repeated prepositional phrases (ʿinda al-mawt, ʿinda al-masʾalah, ʿinda al-ḥisāb, ʿinda al-mīzān, ʿinda al-ṣirāṭ) in parallel construction, each governing a distinct divine name, creating a rhythmic liturgical structure where each clause stands as an independent invocation\n\n---\n\n##", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 400, 2280], [2, 2280, 3116], [3, 3116, 4073], [4, 4073, 6118], [5, 6118, 7015], [6, 7015, 8384], [7, 8384, 10037], [8, 10037, 10873], [9, 10873, 12811]], "2": [[1, 400, 1982], [2, 1982, 2489], [3, 2489, 3463], [4, 3463, 4518], [5, 4518, 5390], [6, 5390, 7520], [7, 7520, 8666], [8, 8666, 9396], [9, 9396, 10552], [10, 10552, 11353], [11, 11353, 12398], [12, 12398, 13199], [13, 13199, 14132], [14, 14132, 15632]], "3": [[1, 400, 1684], [2, 1684, 2496], [3, 2496, 3425], [4, 3425, 5411], [5, 5411, 6281], [6, 6281, 7798], [7, 7798, 8739], [8, 8739, 9715], [9, 9715, 11009], [10, 11009, 11868], [11, 11868, 12797], [12, 12797, 14373], [13, 14373, 15185], [14, 15185, 17067], [15, 17067, 18714], [16, 18714, 19467], [17, 19467, 20467], [18, 20467, 21267], [19, 21267, 22114], [20, 22114, 22996], [21, 22996, 23866], [22, 23866, 25689], [23, 25689, 28042], [24, 28042, 29371], [25, 29371, 30218], [26, 30218, 31559], [27, 31559, 32488], [28, 32488, 33805], [29, 33805, 35134], [30, 35134, 36569], [31, 36569, 37957], [32, 37957, 39064]], "4": [[1, 400, 1492], [2, 1492, 2848], [3, 2848, 4485], [4, 4485, 5313], [5, 5313, 7233], [6, 7233, 8085], [7, 8085, 8565], [8, 8565, 10605], [9, 10605, 11709], [10, 11709, 12549], [11, 12549, 14608], [12, 14608, 15976], [13, 15976, 17152], [14, 17152, 19828], [15, 19828, 21172], [16, 21172, 22372], [17, 22372, 23476], [18, 23476, 24832], [19, 24832, 25708], [20, 25708, 26656], [21, 26656, 27700], [22, 27700, 29555]], "5": [[1, 400, 1333], [2, 1333, 2190], [3, 2190, 3256], [4, 3256, 4094], [5, 4094, 5598], [6, 5598, 7121], [7, 7121, 7826], [8, 7826, 9711], [9, 9711, 11063], [10, 11063, 12701], [11, 12701, 14339], [12, 14339, 14891], [13, 14891, 15415], [14, 15415, 16234], [15, 16234, 16843], [16, 16843, 18119], [17, 18119, 19947], [18, 19947, 21428], [19, 21428, 22951], [20, 22951, 24332], [21, 24332, 25655], [22, 25655, 26893], [23, 26893, 27588], [24, 27588, 28340], [25, 283