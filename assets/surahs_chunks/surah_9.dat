ration": "warsh"}, {"surah": 9, "ayah": 59, "text": "وَلَوَ اَنَّهُمْ رَضُواْ مَآ ءَات۪يٰهُمُ اُ۬للَّهُ وَرَسُولُهُۥ وَقَالُواْ حَسْبُنَا اَ۬للَّهُ سَيُوتِينَا اَ۬للَّهُ مِن فَضْلِهِۦ وَرَسُولُهُۥٓۖ إِنَّآ إِلَي اَ۬للَّهِ رَٰغِبُونَۖ", "words": [{"id": 1, "arabic": "وَلَوَ", "translit": "", "root": ""}, {"id": 2, "arabic": "اَنَّهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَضُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "مَآ", "translit": "", "root": ""}, {"id": 5, "arabic": "ءَات۪يٰهُمُ", "translit": "", "root": ""}, {"id": 6, "arabic": "اُ۬للَّهُ", "translit": "", "root": ""}, {"id": 7, "arabic": "وَرَسُولُهُۥ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَقَالُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "حَسْبُنَا", "translit": "", "root": ""}, {"id": 10, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 11, "arabic": "سَيُوتِينَا", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِن", "translit": "", "root": ""}, {"id": 14, "arabic": "فَضْلِهِۦ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَرَسُولُهُۥٓۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "إِنَّآ", "translit": "", "root": ""}, {"id": 17, "arabic": "إِلَي", "translit": "", "root": ""}, {"id": 18, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 19, "arabic": "رَٰغِبُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 60, "text": "إِنَّمَا اَ۬لصَّدَقَٰتُ لِلْفُقَرَآءِ وَالْمَسَٰكِينِ وَالْعَٰمِلِينَ عَلَيْهَا وَالْمُوَ۬لَّفَةِ قُلُوبُهُمْ وَفِے اِ۬لرِّقَابِ وَالْغَٰرِمِينَ وَفِے سَبِيلِ اِ۬للَّهِ وَابْنِ اِ۬لسَّبِيلِ فَرِيضَةࣰ مِّنَ اَ۬للَّهِۖ وَاللَّهُ عَلِيمٌ حَكِيمࣱۖ", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لصَّدَقَٰتُ", "translit": "", "root": ""}, {"id": 3, "arabic": "لِلْفُقَرَآءِ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَالْمَسَٰكِينِ", "translit": "", 