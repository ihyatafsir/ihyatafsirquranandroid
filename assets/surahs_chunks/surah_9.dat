ext": "لَوْ خَرَجُواْ فِيكُم مَّا زَادُوكُمُۥٓ إِلَّا خَبَالاࣰ وَلَأَوْضَعُواْ خِلَٰلَكُمْ يَبْغُونَكُمُ اُ۬لْفِتْنَةَ وَفِيكُمْ سَمَّٰعُونَ لَهُمْۖ وَاللَّهُ عَلِيمُۢ بِالظَّٰلِمِينَۖ", "words": [{"id": 1, "arabic": "لَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "خَرَجُواْ", "translit": "", "root": ""}, {"id": 3, "arabic": "فِيكُم", "translit": "", "root": ""}, {"id": 4, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 5, "arabic": "زَادُوكُمُۥٓ", "translit": "", "root": ""}, {"id": 6, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 7, "arabic": "خَبَالاࣰ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَلَأَوْضَعُواْ", "translit": "", "root": ""}, {"id": 9, "arabic": "خِلَٰلَكُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "يَبْغُونَكُمُ", "translit": "", "root": ""}, {"id": 11, "arabic": "اُ۬لْفِتْنَةَ", "translit": "", "root": ""}, {"id": 12, "arabic": "وَفِيكُمْ", "translit": "", "root": ""}, {"id": 13, "arabic": "سَمَّٰعُونَ", "translit": "", "root": ""}, {"id": 14, "arabic": "لَهُمْۖ", "translit": "", "root": ""}, {"id": 15, "arabic": "وَاللَّهُ", "translit": "", "root": ""}, {"id": 16, "arabic": "عَلِيمُۢ", "translit": "", "root": ""}, {"id": 17, "arabic": "بِالظَّٰلِمِينَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 9, "ayah": 48, "text": "لَقَدِ اِ۪بْتَغَوُاْ اُ۬لْفِتْنَةَ مِن قَبْلُ وَقَلَّبُواْ لَكَ اَ۬لُامُورَ حَتَّيٰ جَآءَ اَ۬لْحَقُّ وَظَهَرَ أَمْرُ اُ۬للَّهِ وَهُمْ كَٰرِهُونَۖ", "words": [{"id": 1, "arabic": "لَقَدِ", "translit": "", "root": ""}, {"id": 2, "arabic": "اِ۪بْتَغَوُاْ", "translit": "", "root": ""}, {"id": 3, "arabic": "اُ۬لْفِتْنَةَ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِن", "translit": "", "root": ""}, {"id": 5, "arabic": "قَبْلُ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَقَلَّبُواْ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَكَ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬لُامُورَ", "translit": "", "root": ""}, {"id": 9, "arabic":