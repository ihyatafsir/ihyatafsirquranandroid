ic": "وَإِذْ", "translit": "", "root": ""}, {"id": 2, "arabic": "قَالَت", "translit": "", "root": ""}, {"id": 3, "arabic": "طَّآئِفَةࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنْهُمْ", "translit": "", "root": ""}, {"id": 5, "arabic": "يَٰٓأَهْلَ", "translit": "", "root": ""}, {"id": 6, "arabic": "يَثْرِبَ", "translit": "", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "", "root": ""}, {"id": 8, "arabic": "مَقَامَ", "translit": "", "root": ""}, {"id": 9, "arabic": "لَكُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "فَارْجِعُواْۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَيَسْتَٰذِنُ", "translit": "", "root": ""}, {"id": 12, "arabic": "فَرِيقࣱ", "translit": "", "root": ""}, {"id": 13, "arabic": "مِّنْهُمُ", "translit": "", "root": ""}, {"id": 14, "arabic": "اُ۬لنَّبِےٓءَ", "translit": "", "root": ""}, {"id": 15, "arabic": "يَقُولُونَ", "translit": "", "root": ""}, {"id": 16, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 17, "arabic": "بُيُوتَنَا", "translit": "", "root": ""}, {"id": 18, "arabic": "عَوْرَةࣱ", "translit": "", "root": ""}, {"id": 19, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 20, "arabic": "هِيَ", "translit": "", "root": ""}, {"id": 21, "arabic": "بِعَوْرَةٍۖ", "translit": "", "root": ""}, {"id": 22, "arabic": "اِنْ", "translit": "", "root": ""}, {"id": 23, "arabic": "يُّرِيدُونَ", "translit": "", "root": ""}, {"id": 24, "arabic": "إِلَّا", "translit": "", "root": ""}, {"id": 25, "arabic": "فِرَاراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 33, "ayah": 14, "text": "وَلَوْ دُخِلَتْ عَلَيْهِم مِّنَ اَقْط۪ارِهَا ثُمَّ سُئِلُواْ اُ۬لْفِتْنَةَ لَأَتَوْهَا وَمَا تَلَبَّثُواْ بِهَآ إِلَّا يَسِيراࣰۖ", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "", "root": ""}, {"id": 2, "arabic": "دُخِلَتْ", "translit": "", "root": ""}, {"id": 3, "arabic": "عَلَيْهِم", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 5, "arabic": "