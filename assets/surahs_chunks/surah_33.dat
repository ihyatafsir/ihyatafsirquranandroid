: 59, "text": "يَٰٓأَيُّهَا‏ اَ۬لنَّبِےٓءُ قُل لِّأَزْوَٰجِكَ وَبَنَاتِكَ وَنِسَآءِ اِ۬لْمُومِنِينَ يُدْنِينَ عَلَيْهِنَّ مِن جَلَٰبِيبِهِنَّۖ ذَٰلِكَ أَدْن۪يٰٓ أَنْ يُّعْرَفْنَ فَلَا يُوذَيْنَۖ وَكَانَ اَ۬للَّهُ غَفُوراࣰ رَّحِيماࣰۖ", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا‏", "translit": "", "root": ""}, {"id": 2, "arabic": "اَ۬لنَّبِےٓءُ", "translit": "", "root": ""}, {"id": 3, "arabic": "قُل", "translit": "", "root": ""}, {"id": 4, "arabic": "لِّأَزْوَٰجِكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "وَبَنَاتِكَ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَنِسَآءِ", "translit": "", "root": ""}, {"id": 7, "arabic": "اِ۬لْمُومِنِينَ", "translit": "", "root": ""}, {"id": 8, "arabic": "يُدْنِينَ", "translit": "", "root": ""}, {"id": 9, "arabic": "عَلَيْهِنَّ", "translit": "", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "", "root": ""}, {"id": 11, "arabic": "جَلَٰبِيبِهِنَّۖ", "translit": "", "root": ""}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "", "root": ""}, {"id": 13, "arabic": "أَدْن۪يٰٓ", "translit": "", "root": ""}, {"id": 14, "arabic": "أَنْ", "translit": "", "root": ""}, {"id": 15, "arabic": "يُّعْرَفْنَ", "translit": "", "root": ""}, {"id": 16, "arabic": "فَلَا", "translit": "", "root": ""}, {"id": 17, "arabic": "يُوذَيْنَۖ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَكَانَ", "translit": "", "root": ""}, {"id": 19, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 20, "arabic": "غَفُوراࣰ", "translit": "", "root": ""}, {"id": 21, "arabic": "رَّحِيماࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 33, "ayah": 60, "text": "۞لَّئِن لَّمْ يَنتَهِ اِ۬لْمُنَٰفِقُونَ وَالذِينَ فِے قُلُوبِهِم مَّرَضࣱ وَالْمُرْجِفُونَ فِے اِ۬لْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَآ إِلَّا قَلِيلاࣰ‏", "words": [{"id": 1, "arabic": "۞لَّئِن", "translit": "", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "يَنتَهِ", "translit": "", "r