{"surah": 33, "verses": [{"ayah": 1, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ ٱتَّقِ ٱللَّهَ وَلَا تُطِعِ ٱلْكَٰفِرِينَ وَٱلْمُنَٰفِقِينَۗ إِنَّ ٱللَّهَ كَانَ عَلِيمًا حَكِيمًا ", "translation": "O Prophet, fear Allāh and do not obey the disbelievers and the hypocrites. Indeed, Allāh is ever Knowing and Wise.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "ٱتَّقِ", "translit": "ِqَّtٱ", "root": "وقي"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تُطِعِ", "translit": "ِʿعِṭُt", "root": "طوع"}, {"id": 7, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 8, "arabic": "وَٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱَw", "root": "نفق"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 12, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 13, "arabic": "حَكِيمًا", "translit": "āًmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 2, "text": "وَٱتَّبِعْ مَا يُوحَىٰٓ إِلَيْكَ مِن رَّبِّكَۚ إِنَّ ٱللَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيرًا ", "translation": "And follow that which is revealed to you from your Lord. Indeed Allāh is ever, of what you do, Aware.", "words": [{"id": 1, "arabic": "وَٱتَّبِعْ", "translit": "ْʿعِbَّtٱَw", "root": "تبع"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "يُوحَىٰٓ", "translit": "ٰٓàَḥwُy", "root": "وحي"}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 12, "arabic": "خَبِيرًا", "translit": "āًryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 3, "text": "وَتَوَكَّلْ عَلَى ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا ", "translation": "And rely upon Allāh; and sufficient is Allāh as Disposer of affairs.[1]", "words": [{"id": 1, "arabic": "وَتَوَكَّلْ", "translit": "ْlَّkَwَtَw", "root": "وكل"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 5, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 6, "arabic": "وَكِيلًا", "translit": "āًlyِkَw", "root": "وكل"}], "hasIhya": false}, {"ayah": 4, "text": "مَّا جَعَلَ ٱللَّهُ لِرَجُلٍ مِّن قَلْبَيْنِ فِى جَوْفِهِۦۚ وَمَا جَعَلَ أَزْوَٰجَكُمُ ٱلَّٰٓـِٔى تُظَٰهِرُونَ مِنْهُنَّ أُمَّهَٰتِكُمْۚ وَمَا جَعَلَ أَدْعِيَآءَكُمْ أَبْنَآءَكُمْۚ ذَٰلِكُمْ قَوْلُكُم بِأَفْوَٰهِكُمْۖ وَٱللَّهُ يَقُولُ ٱلْحَقَّ وَهُوَ يَهْدِى ٱلسَّبِيلَ ", "translation": "Allāh has not made for a man two hearts in his interior. And He has not made your wives whom you declare unlawful[1] your mothers. And He has not made your claimed [i.e., adopted] sons your [true] sons. That is [merely] your saying by your mouths, but Allāh says the truth, and He guides to the [right] way.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لِرَجُلٍ", "translit": "ٍlُjgَrِl", "root": "رجل"}, {"id": 5, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 6, "arabic": "قَلْبَيْنِ", "translit": "ِnْyَbْlَq", "root": "قلب"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "جَوْفِهِۦ", "translit": "ۦِhِfْwَjg", "root": "جوف"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 11, "arabic": "أَزْوَٰجَكُمُ", "translit": "ُmُkَjgَٰwْzَaʾ", "root": "زوج"}, {"id": 12, "arabic": "ٱلَّٰٓـِٔى", "translit": "àِٔـَّٰٓlٱ", "root": ""}, {"id": 13, "arabic": "تُظَٰهِرُونَ", "translit": "َnwُrِhَٰẓُt", "root": "ظهر"}, {"id": 14, "arabic": "مِنْهُنَّ", "translit": "َّnُhْnِm", "root": ""}, {"id": 15, "arabic": "أُمَّهَٰتِكُمْ", "translit": "ْmُkِtَٰhَّmُaʾ", "root": "امم"}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 18, "arabic": "أَدْعِيَآءَكُمْ", "translit": "ْmُkَءٓāَyِʿعْdَaʾ", "root": "دعو"}, {"id": 19, "arabic": "أَبْنَآءَكُمْ", "translit": "ْmُkَءٓāَnْbَaʾ", "root": "بني"}, {"id": 20, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 21, "arabic": "قَوْلُكُم", "translit": "mُkُlْwَq", "root": "قول"}, {"id": 22, "arabic": "بِأَفْوَٰهِكُمْ", "translit": "ْmُkِhَٰwْfَaʾِb", "root": "فوه"}, {"id": 23, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 24, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 25, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 26, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 27, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 28, "arabic": "ٱلسَّبِيلَ", "translit": "َlyِbَّslٱ", "root": "سبل"}], "hasIhya": true}, {"ayah": 5, "text": "ٱدْعُوهُمْ لِءَابَآئِهِمْ هُوَ أَقْسَطُ عِندَ ٱللَّهِۚ فَإِن لَّمْ تَعْلَمُوٓا۟ ءَابَآءَهُمْ فَإِخْوَٰنُكُمْ فِى ٱلدِّينِ وَمَوَٰلِيكُمْۚ وَلَيْسَ عَلَيْكُمْ جُنَاحٌ فِيمَآ أَخْطَأْتُم بِهِۦ وَلَٰكِن مَّا تَعَمَّدَتْ قُلُوبُكُمْۚ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ", "translation": "Call them[1] by [the names of] their fathers; it is more just in the sight of Allāh. But if you do not know their fathers - then they are [still] your brothers in religion and those entrusted to you. And there is no blame upon you for that in which you have erred but [only for] what your hearts intended. And ever is Allāh Forgiving and Merciful.", "words": [{"id": 1, "arabic": "ٱدْعُوهُمْ", "translit": "ْmُhwُʿعْdٱ", "root": "دعو"}, {"id": 2, "arabic": "لِءَابَآئِهِمْ", "translit": "ْmِhِyʾٓāَbāَءِl", "root": "ابو"}, {"id": 3, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 4, "arabic": "أَقْسَطُ", "translit": "ُṭَsْqَaʾ", "root": "قسط"}, {"id": 5, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 8, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 9, "arabic": "تَعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعَt", "root": "علم"}, {"id": 10, "arabic": "ءَابَآءَهُمْ", "translit": "ْmُhَءٓāَbāَء", "root": "ابو"}, {"id": 11, "arabic": "فَإِخْوَٰنُكُمْ", "translit": "ْmُkُnَٰwْhkِiʾَf", "root": "اخو"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 14, "arabic": "وَمَوَٰلِيكُمْ", "translit": "ْmُkyِlَٰwَmَw", "root": "ولي"}, {"id": 15, "arabic": "وَلَيْسَ", "translit": "َsْyَlَw", "root": "ليس"}, {"id": 16, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 17, "arabic": "جُنَاحٌ", "translit": "ٌḥāَnُjg", "root": "جنح"}, {"id": 18, "arabic": "فِيمَآ", "translit": "ٓāَmyِf", "root": ""}, {"id": 19, "arabic": "أَخْطَأْتُم", "translit": "mُtْaʾَṭْhkَaʾ", "root": "خطا"}, {"id": 20, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 21, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 22, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 23, "arabic": "تَعَمَّدَتْ", "translit": "ْtَdَّmَʿعَt", "root": "عمد"}, {"id": 24, "arabic": "قُلُوبُكُمْ", "translit": "ْmُkُbwُlُq", "root": "قلب"}, {"id": 25, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 26, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 28, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 6, "text": "ٱلنَّبِىُّ أَوْلَىٰ بِٱلْمُؤْمِنِينَ مِنْ أَنفُسِهِمْۖ وَأَزْوَٰجُهُۥٓ أُمَّهَٰتُهُمْۗ وَأُو۟لُوا۟ ٱلْأَرْحَامِ بَعْضُهُمْ أَوْلَىٰ بِبَعْضٍ فِى كِتَٰبِ ٱللَّهِ مِنَ ٱلْمُؤْمِنِينَ وَٱلْمُهَٰجِرِينَ إِلَّآ أَن تَفْعَلُوٓا۟ إِلَىٰٓ أَوْلِيَآئِكُم مَّعْرُوفًاۚ كَانَ ذَٰلِكَ فِى ٱلْكِتَٰبِ مَسْطُورًا ", "translation": "The Prophet is more worthy of the believers than themselves,[1] and his wives are [in the position of] their mothers. And those of [blood] relationship are more entitled [to inheritance] in the decree of Allāh than the [other] believers and the emigrants, except that you may do to your close associates a kindness [through bequest]. That was in the Book[2] inscribed.", "words": [{"id": 1, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 2, "arabic": "أَوْلَىٰ", "translit": "ٰàَlْwَaʾ", "root": "ولي"}, {"id": 3, "arabic": "بِٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱِb", "root": "امن"}, {"id": 4, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 5, "arabic": "أَنفُسِهِمْ", "translit": "ْmِhِsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "وَأَزْوَٰجُهُۥٓ", "translit": "ٓۥُhُjgَٰwْzَaʾَw", "root": "زوج"}, {"id": 7, "arabic": "أُمَّهَٰتُهُمْ", "translit": "ْmُhُtَٰhَّmُaʾ", "root": "امم"}, {"id": 8, "arabic": "وَأُو۟لُوا۟", "translit": "۟āwُl۟wُaʾَw", "root": ""}, {"id": 9, "arabic": "ٱلْأَرْحَامِ", "translit": "ِmāَḥْrَaʾْlٱ", "root": "رحم"}, {"id": 10, "arabic": "بَعْضُهُمْ", "translit": "ْmُhُḍْʿعَb", "root": "بعض"}, {"id": 11, "arabic": "أَوْلَىٰ", "translit": "ٰàَlْwَaʾ", "root": "ولي"}, {"id": 12, "arabic": "بِبَعْضٍ", "translit": "ٍḍْʿعَbِb", "root": "بعض"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "كِتَٰبِ", "translit": "ِbَٰtِk", "root": "كتب"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 17, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 18, "arabic": "وَٱلْمُهَٰجِرِينَ", "translit": "َnyِrِjgَٰhُmْlٱَw", "root": "هجر"}, {"id": 19, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 20, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 21, "arabic": "تَفْعَلُوٓا۟", "translit": "۟āٓwُlَʿعْfَt", "root": "فعل"}, {"id": 22, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 23, "arabic": "أَوْلِيَآئِكُم", "translit": "mُkِyʾٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 24, "arabic": "مَّعْرُوفًا", "translit": "āًfwُrْʿعَّm", "root": "عرف"}, {"id": 25, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 26, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 27, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 28, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 29, "arabic": "مَسْطُورًا", "translit": "āًrwُṭْsَm", "root": "سطر"}], "hasIhya": false}, {"ayah": 7, "text": "وَإِذْ أَخَذْنَا مِنَ ٱلنَّبِيِّۦنَ مِيثَٰقَهُمْ وَمِنكَ وَمِن نُّوحٍ وَإِبْرَٰهِيمَ وَمُوسَىٰ وَعِيسَى ٱبْنِ مَرْيَمَۖ وَأَخَذْنَا مِنْهُم مِّيثَٰقًا غَلِيظًا ", "translation": "And [mention, O Muḥammad], when We took from the prophets their covenant and from you and from Noah and Abraham and Moses and Jesus, the son of Mary; and We took from them a solemn covenant", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَخَذْنَا", "translit": "āَnْhdَhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلنَّبِيِّۦنَ", "translit": "َnۦِّyِbَّnlٱ", "root": "نبا"}, {"id": 5, "arabic": "مِيثَٰقَهُمْ", "translit": "ْmُhَqَٰhtyِm", "root": "وثق"}, {"id": 6, "arabic": "وَمِنكَ", "translit": "َknِmَw", "root": ""}, {"id": 7, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 8, "arabic": "نُّوحٍ", "translit": "ٍḥwُّn", "root": ""}, {"id": 9, "arabic": "وَإِبْرَٰهِيمَ", "translit": "َmyِhَٰrْbِiʾَw", "root": ""}, {"id": 10, "arabic": "وَمُوسَىٰ", "translit": "ٰàَswُmَw", "root": ""}, {"id": 11, "arabic": "وَعِيسَى", "translit": "àَsyِʿعَw", "root": ""}, {"id": 12, "arabic": "ٱبْنِ", "translit": "ِnْbٱ", "root": "بني"}, {"id": 13, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 14, "arabic": "وَأَخَذْنَا", "translit": "āَnْhdَhkَaʾَw", "root": "اخذ"}, {"id": 15, "arabic": "مِنْهُم", "translit": "mُhْnِm", "root": ""}, {"id": 16, "arabic": "مِّيثَٰقًا", "translit": "āًqَٰhtyِّm", "root": "وثق"}, {"id": 17, "arabic": "غَلِيظًا", "translit": "āًẓyِlَغ", "root": "غلظ"}], "hasIhya": true}, {"ayah": 8, "text": "لِّيَسْـَٔلَ ٱلصَّٰدِقِينَ عَن صِدْقِهِمْۚ وَأَعَدَّ لِلْكَٰفِرِينَ عَذَابًا أَلِيمًا ", "translation": "That He may question the truthful about their truth.[1] And He has prepared for the disbelievers a painful punishment.", "words": [{"id": 1, "arabic": "لِّيَسْـَٔلَ", "translit": "َlَٔـْsَyِّl", "root": "سال"}, {"id": 2, "arabic": "ٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱ", "root": "صدق"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "صِدْقِهِمْ", "translit": "ْmِhِqْdِṣ", "root": "صدق"}, {"id": 5, "arabic": "وَأَعَدَّ", "translit": "َّdَʿعَaʾَw", "root": "عدد"}, {"id": 6, "arabic": "لِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِl", "root": "كفر"}, {"id": 7, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 8, "arabic": "أَلِيمًا", "translit": "āًmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 9, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱذْكُرُوا۟ نِعْمَةَ ٱللَّهِ عَلَيْكُمْ إِذْ جَآءَتْكُمْ جُنُودٌ فَأَرْسَلْنَا عَلَيْهِمْ رِيحًا وَجُنُودًا لَّمْ تَرَوْهَاۚ وَكَانَ ٱللَّهُ بِمَا تَعْمَلُونَ بَصِيرًا ", "translation": "O you who have believed, remember the favor of Allāh upon you when armies came to [attack] you and We sent upon them a wind and armies [of angels] you did not see. And ever is Allāh, of what you do, Seeing.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱ", "root": "ذكر"}, {"id": 5, "arabic": "نِعْمَةَ", "translit": "َẗَmْʿعِn", "root": "نعم"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 9, "arabic": "جَآءَتْكُمْ", "translit": "ْmُkْtَءٓāَjg", "root": "جيا"}, {"id": 10, "arabic": "جُنُودٌ", "translit": "ٌdwُnُjg", "root": "جند"}, {"id": 11, "arabic": "فَأَرْسَلْنَا", "translit": "āَnْlَsْrَaʾَf", "root": "رسل"}, {"id": 12, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "رِيحًا", "translit": "āًḥyِr", "root": "روح"}, {"id": 14, "arabic": "وَجُنُودًا", "translit": "āًdwُnُjgَw", "root": "جند"}, {"id": 15, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 16, "arabic": "تَرَوْهَا", "translit": "āَhْwَrَt", "root": "راي"}, {"id": 17, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 20, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 21, "arabic": "بَصِيرًا", "translit": "āًryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 10, "text": "إِذْ جَآءُوكُم مِّن فَوْقِكُمْ وَمِنْ أَسْفَلَ مِنكُمْ وَإِذْ زَاغَتِ ٱلْأَبْصَٰرُ وَبَلَغَتِ ٱلْقُلُوبُ ٱلْحَنَاجِرَ وَتَظُنُّونَ بِٱللَّهِ ٱلظُّنُونَا۠ ", "translation": "[Remember] when they came at you from above you and from below you, and when eyes shifted [in fear], and hearts reached the throats, and you assumed about Allāh [various] assumptions.", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "جَآءُوكُم", "translit": "mُkwُءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 4, "arabic": "فَوْقِكُمْ", "translit": "ْmُkِqْwَf", "root": "فوق"}, {"id": 5, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 6, "arabic": "أَسْفَلَ", "translit": "َlَfْsَaʾ", "root": "سفل"}, {"id": 7, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 8, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 9, "arabic": "زَاغَتِ", "translit": "ِtَغāَz", "root": "زيغ"}, {"id": 10, "arabic": "ٱلْأَبْصَٰرُ", "translit": "ُrَٰṣْbَaʾْlٱ", "root": "بصر"}, {"id": 11, "arabic": "وَبَلَغَتِ", "translit": "ِtَغَlَbَw", "root": "بلغ"}, {"id": 12, "arabic": "ٱلْقُلُوبُ", "translit": "ُbwُlُqْlٱ", "root": "قلب"}, {"id": 13, "arabic": "ٱلْحَنَاجِرَ", "translit": "َrِjgāَnَḥْlٱ", "root": "حنجر"}, {"id": 14, "arabic": "وَتَظُنُّونَ", "translit": "َnwُّnُẓَtَw", "root": "ظنن"}, {"id": 15, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 16, "arabic": "ٱلظُّنُونَا۠", "translit": "۠āَnwُnُّẓlٱ", "root": "ظنن"}], "hasIhya": false}, {"ayah": 11, "text": "هُنَالِكَ ٱبْتُلِىَ ٱلْمُؤْمِنُونَ وَزُلْزِلُوا۟ زِلْزَالًا شَدِيدًا ", "translation": "There the believers were tested and shaken with a severe shaking.", "words": [{"id": 1, "arabic": "هُنَالِكَ", "translit": "َkِlāَnُh", "root": ""}, {"id": 2, "arabic": "ٱبْتُلِىَ", "translit": "َàِlُtْbٱ", "root": "بلو"}, {"id": 3, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}, {"id": 4, "arabic": "وَزُلْزِلُوا۟", "translit": "۟āwُlِzْlُzَw", "root": "زلزل"}, {"id": 5, "arabic": "زِلْزَالًا", "translit": "āًlāَzْlِz", "root": "زلزل"}, {"id": 6, "arabic": "شَدِيدًا", "translit": "āًdyِdَhs", "root": "شدد"}], "hasIhya": false}, {"ayah": 12, "text": "وَإِذْ يَقُولُ ٱلْمُنَٰفِقُونَ وَٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ مَّا وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥٓ إِلَّا غُرُورًا ", "translation": "And [remember] when the hypocrites and those in whose hearts is disease said, \"Allāh and His Messenger did not promise us except delusion,\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 3, "arabic": "ٱلْمُنَٰفِقُونَ", "translit": "َnwُqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "قُلُوبِهِم", "translit": "mِhِbwُlُq", "root": "قلب"}, {"id": 7, "arabic": "مَّرَضٌ", "translit": "ٌḍَrَّm", "root": "مرض"}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "وَعَدَنَا", "translit": "āَnَdَʿعَw", "root": "وعد"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَرَسُولُهُۥٓ", "translit": "ٓۥُhُlwُsَrَw", "root": "رسل"}, {"id": 12, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 13, "arabic": "غُرُورًا", "translit": "āًrwُrُغ", "root": "غرر"}], "hasIhya": false}, {"ayah": 13, "text": "وَإِذْ قَالَت طَّآئِفَةٌ مِّنْهُمْ يَٰٓأَهْلَ يَثْرِبَ لَا مُقَامَ لَكُمْ فَٱرْجِعُوا۟ۚ وَيَسْتَـْٔذِنُ فَرِيقٌ مِّنْهُمُ ٱلنَّبِىَّ يَقُولُونَ إِنَّ بُيُوتَنَا عَوْرَةٌ وَمَا هِىَ بِعَوْرَةٍۖ إِن يُرِيدُونَ إِلَّا فِرَارًا ", "translation": "And when a faction of them said, \"O people of Yathrib,[1] there is no stability for you [here], so return [home].\" And a party of them asked permission of the Prophet, saying, \"Indeed, our houses are exposed [i.e., unprotected],\" while they were not exposed. They did not intend except to flee.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَت", "translit": "tَlāَq", "root": "قول"}, {"id": 3, "arabic": "طَّآئِفَةٌ", "translit": "ٌẗَfِyʾٓāَّṭ", "root": "طوف"}, {"id": 4, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 5, "arabic": "يَٰٓأَهْلَ", "translit": "َlْhَaʾَٰٓy", "root": "اهل"}, {"id": 6, "arabic": "يَثْرِبَ", "translit": "َbِrْhtَy", "root": ""}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "مُقَامَ", "translit": "َmāَqُm", "root": "قوم"}, {"id": 9, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 10, "arabic": "فَٱرْجِعُوا۟", "translit": "۟āwُʿعِjgْrٱَf", "root": "رجع"}, {"id": 11, "arabic": "وَيَسْتَـْٔذِنُ", "translit": "ُnِhdْٔـَtْsَyَw", "root": "اذن"}, {"id": 12, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 13, "arabic": "مِّنْهُمُ", "translit": "ُmُhْnِّm", "root": ""}, {"id": 14, "arabic": "ٱلنَّبِىَّ", "translit": "َّàِbَّnlٱ", "root": "نبا"}, {"id": 15, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 16, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 17, "arabic": "بُيُوتَنَا", "translit": "āَnَtwُyُb", "root": "بيت"}, {"id": 18, "arabic": "عَوْرَةٌ", "translit": "ٌẗَrْwَʿع", "root": "عور"}, {"id": 19, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 20, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 21, "arabic": "بِعَوْرَةٍ", "translit": "ٍẗَrْwَʿعِb", "root": "عور"}, {"id": 22, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 23, "arabic": "يُرِيدُونَ", "translit": "َnwُdyِrُy", "root": "رود"}, {"id": 24, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 25, "arabic": "فِرَارًا", "translit": "āًrāَrِf", "root": "فرر"}], "hasIhya": false}, {"ayah": 14, "text": "وَلَوْ دُخِلَتْ عَلَيْهِم مِّنْ أَقْطَارِهَا ثُمَّ سُئِلُوا۟ ٱلْفِتْنَةَ لَءَاتَوْهَا وَمَا تَلَبَّثُوا۟ بِهَآ إِلَّا يَسِيرًا ", "translation": "And if they had been entered upon from all its [surrounding] regions and fitnah [i.e., disbelief] had been demanded of them, they would have done it and not hesitated over it except briefly.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "دُخِلَتْ", "translit": "ْtَlِhkُd", "root": "دخل"}, {"id": 3, "arabic": "عَلَيْهِم", "translit": "mِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "أَقْطَارِهَا", "translit": "āَhِrāَṭْqَaʾ", "root": "قطر"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "سُئِلُوا۟", "translit": "۟āwُlِyʾُs", "root": "سال"}, {"id": 8, "arabic": "ٱلْفِتْنَةَ", "translit": "َẗَnْtِfْlٱ", "root": "فتن"}, {"id": 9, "arabic": "لَءَاتَوْهَا", "translit": "āَhْwَtāَءَl", "root": "اتي"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "تَلَبَّثُوا۟", "translit": "۟āwُhtَّbَlَt", "root": "لبث"}, {"id": 12, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 13, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 14, "arabic": "يَسِيرًا", "translit": "āًryِsَy", "root": "يسر"}], "hasIhya": false}, {"ayah": 15, "text": "وَلَقَدْ كَانُوا۟ عَٰهَدُوا۟ ٱللَّهَ مِن قَبْلُ لَا يُوَلُّونَ ٱلْأَدْبَٰرَۚ وَكَانَ عَهْدُ ٱللَّهِ مَسْـُٔولًا ", "translation": "And they had already promised Allāh before not to turn their backs [i.e., flee]. And ever is the promise to Allāh [that about which one will be] questioned.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 3, "arabic": "عَٰهَدُوا۟", "translit": "۟āwُdَhَٰʿع", "root": "عهد"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يُوَلُّونَ", "translit": "َnwُّlَwُy", "root": "ولي"}, {"id": 9, "arabic": "ٱلْأَدْبَٰرَ", "translit": "َrَٰbْdَaʾْlٱ", "root": "دبر"}, {"id": 10, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 11, "arabic": "عَهْدُ", "translit": "ُdْhَʿع", "root": "عهد"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "مَسْـُٔولًا", "translit": "āًlwُٔـْsَm", "root": "سال"}], "hasIhya": false}, {"ayah": 16, "text": "قُل لَّن يَنفَعَكُمُ ٱلْفِرَارُ إِن فَرَرْتُم مِّنَ ٱلْمَوْتِ أَوِ ٱلْقَتْلِ وَإِذًا لَّا تُمَتَّعُونَ إِلَّا قَلِيلًا ", "translation": "Say, [O Muḥammad], \"Never will fleeing benefit you if you should flee from death or killing; and then [if you did], you would not be given enjoyment [of life] except for a little.\"", "words": [{"id": 1, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 2, "arabic": "لَّن", "translit": "nَّl", "root": ""}, {"id": 3, "arabic": "يَنفَعَكُمُ", "translit": "ُmُkَʿعَfnَy", "root": "نفع"}, {"id": 4, "arabic": "ٱلْفِرَارُ", "translit": "ُrāَrِfْlٱ", "root": "فرر"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "فَرَرْتُم", "translit": "mُtْrَrَf", "root": "فرر"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 9, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 10, "arabic": "ٱلْقَتْلِ", "translit": "ِlْtَqْlٱ", "root": "قتل"}, {"id": 11, "arabic": "وَإِذًا", "translit": "āًhdِiʾَw", "root": ""}, {"id": 12, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 13, "arabic": "تُمَتَّعُونَ", "translit": "َnwُʿعَّtَmُt", "root": "متع"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}], "hasIhya": false}, {"ayah": 17, "text": "قُلْ مَن ذَا ٱلَّذِى يَعْصِمُكُم مِّنَ ٱللَّهِ إِنْ أَرَادَ بِكُمْ سُوٓءًا أَوْ أَرَادَ بِكُمْ رَحْمَةًۚ وَلَا يَجِدُونَ لَهُم مِّن دُونِ ٱللَّهِ وَلِيًّا وَلَا نَصِيرًا ", "translation": "Say, \"Who is it that can protect you from Allāh[1] if He intends for you an ill or intends for you a mercy?\" And they will not find for themselves besides Allāh any protector or any helper.", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "يَعْصِمُكُم", "translit": "mُkُmِṣْʿعَy", "root": "عصم"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 9, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 10, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 11, "arabic": "سُوٓءًا", "translit": "āًءٓwُs", "root": "سوا"}, {"id": 12, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 13, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 14, "arabic": "بِكُمْ", "translit": "ْmُkِb", "root": ""}, {"id": 15, "arabic": "رَحْمَةً", "translit": "ًẗَmْḥَr", "root": "رحم"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد"}, {"id": 18, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 19, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 20, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 23, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 24, "arabic": "نَصِيرًا", "translit": "āًryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 18, "text": "قَدْ يَعْلَمُ ٱللَّهُ ٱلْمُعَوِّقِينَ مِنكُمْ وَٱلْقَآئِلِينَ لِإِخْوَٰنِهِمْ هَلُمَّ إِلَيْنَاۖ وَلَا يَأْتُونَ ٱلْبَأْسَ إِلَّا قَلِيلًا ", "translation": "Already Allāh knows the hinderers[1] among you and those [hypocrites] who say to their brothers, \"Come to us,\"[2] and do not go to battle, except for a few,[3]", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "ٱلْمُعَوِّقِينَ", "translit": "َnyِqِّwَʿعُmْlٱ", "root": "عوق"}, {"id": 5, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 6, "arabic": "وَٱلْقَآئِلِينَ", "translit": "َnyِlِyʾٓāَqْlٱَw", "root": "قول"}, {"id": 7, "arabic": "لِإِخْوَٰنِهِمْ", "translit": "ْmِhِnَٰwْhkِiʾِl", "root": "اخو"}, {"id": 8, "arabic": "هَلُمَّ", "translit": "َّmُlَh", "root": "هلم"}, {"id": 9, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "يَأْتُونَ", "translit": "َnwُtْaʾَy", "root": "اتي"}, {"id": 12, "arabic": "ٱلْبَأْسَ", "translit": "َsْaʾَbْlٱ", "root": "باس"}, {"id": 13, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 14, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}], "hasIhya": false}, {"ayah": 19, "text": "أَشِحَّةً عَلَيْكُمْۖ فَإِذَا جَآءَ ٱلْخَوْفُ رَأَيْتَهُمْ يَنظُرُونَ إِلَيْكَ تَدُورُ أَعْيُنُهُمْ كَٱلَّذِى يُغْشَىٰ عَلَيْهِ مِنَ ٱلْمَوْتِۖ فَإِذَا ذَهَبَ ٱلْخَوْفُ سَلَقُوكُم بِأَلْسِنَةٍ حِدَادٍ أَشِحَّةً عَلَى ٱلْخَيْرِۚ أُو۟لَٰٓئِكَ لَمْ يُؤْمِنُوا۟ فَأَحْبَطَ ٱللَّهُ أَعْمَٰلَهُمْۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرًا ", "translation": "Indisposed[1] toward you. And when fear comes, you see them looking at you, their eyes revolving like one being overcome by death. But when fear departs, they lash you with sharp tongues, indisposed toward [any] good. Those have not believed, so Allāh has rendered their deeds worthless, and ever is that, for Allāh, easy.", "words": [{"id": 1, "arabic": "أَشِحَّةً", "translit": "ًẗَّḥِhsَaʾ", "root": "شحح"}, {"id": 2, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 4, "arabic": "جَآءَ", "translit": "َءٓāَjg", "root": "جيا"}, {"id": 5, "arabic": "ٱلْخَوْفُ", "translit": "ُfْwَhkْlٱ", "root": "خوف"}, {"id": 6, "arabic": "رَأَيْتَهُمْ", "translit": "ْmُhَtْyَaʾَr", "root": "راي"}, {"id": 7, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 8, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 9, "arabic": "تَدُورُ", "translit": "ُrwُdَt", "root": "دور"}, {"id": 10, "arabic": "أَعْيُنُهُمْ", "translit": "ْmُhُnُyْʿعَaʾ", "root": "عين"}, {"id": 11, "arabic": "كَٱلَّذِى", "translit": "àِhdَّlٱَk", "root": ""}, {"id": 12, "arabic": "يُغْشَىٰ", "translit": "ٰàَhsْغُy", "root": "غشو"}, {"id": 13, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 16, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 17, "arabic": "ذَهَبَ", "translit": "َbَhَhd", "root": "ذهب"}, {"id": 18, "arabic": "ٱلْخَوْفُ", "translit": "ُfْwَhkْlٱ", "root": "خوف"}, {"id": 19, "arabic": "سَلَقُوكُم", "translit": "mُkwُqَlَs", "root": "سلق"}, {"id": 20, "arabic": "بِأَلْسِنَةٍ", "translit": "ٍẗَnِsْlَaʾِb", "root": "لسن"}, {"id": 21, "arabic": "حِدَادٍ", "translit": "ٍdāَdِḥ", "root": "حدد"}, {"id": 22, "arabic": "أَشِحَّةً", "translit": "ًẗَّḥِhsَaʾ", "root": "شحح"}, {"id": 23, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 24, "arabic": "ٱلْخَيْرِ", "translit": "ِrْyَhkْlٱ", "root": "خير"}, {"id": 25, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 26, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 27, "arabic": "يُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُy", "root": "امن"}, {"id": 28, "arabic": "فَأَحْبَطَ", "translit": "َṭَbْḥَaʾَf", "root": "حبط"}, {"id": 29, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 31, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 32, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 33, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 34, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 35, "arabic": "يَسِيرًا", "translit": "āًryِsَy", "root": "يسر"}], "hasIhya": false}, {"ayah": 20, "text": "يَحْسَبُونَ ٱلْأَحْزَابَ لَمْ يَذْهَبُوا۟ۖ وَإِن يَأْتِ ٱلْأَحْزَابُ يَوَدُّوا۟ لَوْ أَنَّهُم بَادُونَ فِى ٱلْأَعْرَابِ يَسْـَٔلُونَ عَنْ أَنۢبَآئِكُمْۖ وَلَوْ كَانُوا۟ فِيكُم مَّا قَٰتَلُوٓا۟ إِلَّا قَلِيلًا ", "translation": "They think the companies have not [yet] withdrawn.[1] And if the companies should come [again], they would wish they were in the desert among the bedouins, inquiring [from afar] about your news. And if they should be among you, they would not fight except for a little.", "words": [{"id": 1, "arabic": "يَحْسَبُونَ", "translit": "َnwُbَsْḥَy", "root": "حسب"}, {"id": 2, "arabic": "ٱلْأَحْزَابَ", "translit": "َbāَzْḥَaʾْlٱ", "root": "حزب"}, {"id": 3, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 4, "arabic": "يَذْهَبُوا۟", "translit": "۟āwُbَhْhdَy", "root": "ذهب"}, {"id": 5, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 6, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 7, "arabic": "ٱلْأَحْزَابُ", "translit": "ُbāَzْḥَaʾْlٱ", "root": "حزب"}, {"id": 8, "arabic": "يَوَدُّوا۟", "translit": "۟āwُّdَwَy", "root": "ودد"}, {"id": 9, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 10, "arabic": "أَنَّهُم", "translit": "mُhَّnَaʾ", "root": ""}, {"id": 11, "arabic": "بَادُونَ", "translit": "َnwُdāَb", "root": "بدو"}, {"i