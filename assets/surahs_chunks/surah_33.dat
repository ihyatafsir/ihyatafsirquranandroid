id": 10, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "", "root": ""}, {"id": 12, "arabic": "خَبِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 33, "ayah": 3, "text": "وَتَوَكَّلْ عَلَي اَ۬للَّهِۖ وَكَف۪يٰ بِاللَّهِ وَكِيلاࣰۖ", "words": [{"id": 1, "arabic": "وَتَوَكَّلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَكَف۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَكِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 33, "ayah": 4, "text": "مَّا جَعَلَ اَ۬للَّهُ لِرَجُلࣲ مِّن قَلْبَيْنِ فِے جَوْفِهِۦۖ وَمَا جَعَلَ أَزْوَٰجَكُمُ اُ۬ل۪ےْ تَظَّهَّرُونَ مِنْهُنَّ أُمَّهَٰتِكُمْۖ وَمَا جَعَلَ أَدْعِيَآءَكُمُۥٓ أَبْنَآءَكُمْۖ ذَٰلِكُمْ قَوْلُكُم بِأَفْوَٰهِكُمْۖ وَاللَّهُ يَقُولُ اُ۬لْحَقَّۖ وَهُوَ يَهْدِے اِ۬لسَّبِيلَۖ", "words": [{"id": 1, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِرَجُلࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "root": ""}, {"id": 6, "arabic": "قَلْبَيْنِ", "translit": "", "root": ""}, {"id": 7, "arabic": "فِے", "translit": "", "root": ""}, {"id": 8, "arabic": "جَوْفِهِۦۖ", "translit": "", "root": ""}, {"id": 9, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 10, "arabic": "جَعَلَ", "translit": "", "root": ""}, {"id": 11, "arabic": "أَزْوَٰجَكُمُ", "translit": "", "root": ""}, {"id": 12, "arabic": "اُ۬ل۪ےْ", "translit": "", "root": ""}, {"id": 13, "arabic": "تَظَّهَّرُونَ", "translit": "", "root": ""}, {"id": 14, "arabic": "مِنْهُنَّ", "translit": "", "root": ""}, {"id": 15, "arabic": "أُمَّهَٰتِكُمْۖ", "translit": "", "root": ""}, {"id": 16, "arabic": "وَمَا", "trans