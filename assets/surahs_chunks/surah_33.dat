33, "ayah": 2, "text": "وَاتَّبِعْ مَا يُوح۪يٰٓ إِلَيْكَ مِن رَّبِّكَۖ إِنَّ اَ۬للَّهَ كَانَ بِمَا تَعْمَلُونَ خَبِيراࣰۖ", "words": [{"id": 1, "arabic": "وَاتَّبِعْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "يُوح۪يٰٓ", "translit": "", "root": ""}, {"id": 4, "arabic": "إِلَيْكَ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِن", "translit": "", "root": ""}, {"id": 6, "arabic": "رَّبِّكَۖ", "translit": "", "root": ""}, {"id": 7, "arabic": "إِنَّ", "translit": "", "root": ""}, {"id": 8, "arabic": "اَ۬للَّهَ", "translit": "", "root": ""}, {"id": 9, "arabic": "كَانَ", "translit": "", "root": ""}, {"id": 10, "arabic": "بِمَا", "translit": "", "root": ""}, {"id": 11, "arabic": "تَعْمَلُونَ", "translit": "", "root": ""}, {"id": 12, "arabic": "خَبِيراࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 33, "ayah": 3, "text": "وَتَوَكَّلْ عَلَي اَ۬للَّهِۖ وَكَف۪يٰ بِاللَّهِ وَكِيلاࣰۖ", "words": [{"id": 1, "arabic": "وَتَوَكَّلْ", "translit": "", "root": ""}, {"id": 2, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهِۖ", "translit": "", "root": ""}, {"id": 4, "arabic": "وَكَف۪يٰ", "translit": "", "root": ""}, {"id": 5, "arabic": "بِاللَّهِ", "translit": "", "root": ""}, {"id": 6, "arabic": "وَكِيلاࣰۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 33, "ayah": 4, "text": "مَّا جَعَلَ اَ۬للَّهُ لِرَجُلࣲ مِّن قَلْبَيْنِ فِے جَوْفِهِۦۖ وَمَا جَعَلَ أَزْوَٰجَكُمُ اُ۬ل۪ےْ تَظَّهَّرُونَ مِنْهُنَّ أُمَّهَٰتِكُمْۖ وَمَا جَعَلَ أَدْعِيَآءَكُمُۥٓ أَبْنَآءَكُمْۖ ذَٰلِكُمْ قَوْلُكُم بِأَفْوَٰهِكُمْۖ وَاللَّهُ يَقُولُ اُ۬لْحَقَّۖ وَهُوَ يَهْدِے اِ۬لسَّبِيلَۖ", "words": [{"id": 1, "arabic": "مَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "", "root": ""}, {"id": 3, "arabic": "اَ۬للَّهُ", "translit": "", "root": ""}, {"id": 4, "arabic": "لِرَجُلࣲ", "translit": "", "root": ""}, {"id": 5, "arabic": "مِّن", "translit": "", "r