abic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَٱلْيَوْمَ", "translit": "َmْwَyْlٱَw", "root": "يوم"}, {"id": 14, "arabic": "ٱلْءَاخِرَ", "translit": "َrِhkāَءْlٱ", "root": "اخر"}, {"id": 15, "arabic": "وَذَكَرَ", "translit": "َrَkَhdَw", "root": "ذكر"}, {"id": 16, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": true}, {"ayah": 22, "text": "وَلَمَّا رَءَا ٱلْمُؤْمِنُونَ ٱلْأَحْزَابَ قَالُوا۟ هَٰذَا مَا وَعَدَنَا ٱللَّهُ وَرَسُولُهُۥ وَصَدَقَ ٱللَّهُ وَرَسُولُهُۥۚ وَمَا زَادَهُمْ إِلَّآ إِيمَٰنًا وَتَسْلِيمًا ", "translation": "And when the believers saw the companies, they said, \"This is what Allāh and His Messenger had promised us, and Allāh and His Messenger spoke the truth.\" And it increased them only in faith and acceptance.", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "رَءَا", "translit": "āَءَr", "root": "راي"}, {"id": 3, "arabic": "ٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱ", "root": "امن"}, {"id": 4, "arabic": "ٱلْأَحْزَابَ", "translit": "َbāَzْḥَaʾْlٱ", "root": "حزب"}, {"id": 5, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 6, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "وَعَدَنَا", "translit": "āَnَdَʿعَw", "root": "وعد"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 11, "arabic": "وَصَدَقَ", "translit": "َqَdَṣَw", "root": "صدق"}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "وَرَسُولُهُۥ", "translit": "ۥُhُlwُsَrَw", "root": "رسل"}, {"id": 14, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 15, "arabic": "زَادَهُمْ", "translit": "ْmُhَdāَz", "root": "زيد"}, {"id": 16, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 17, "arabic": "إِيمَٰنًا", "translit": "āًnَٰmyِiʾ", "root": "امن"}, {"id": 18, "arabic": "وَتَسْلِيمًا", "translit": "āًmyِlْsَtَw", "root": "سلم"}], "hasIhya": false}, {"ayah": 23, "text": "مِّنَ ٱلْمُؤْمِنِينَ رِجَالٌ صَدَقُوا۟ مَا عَٰهَدُوا۟ ٱللَّهَ عَلَيْهِۖ فَمِنْهُم مَّن قَضَىٰ نَحْبَهُۥ وَمِنْهُم مَّن يَنتَظِرُۖ وَمَا بَدَّلُوا۟ تَبْدِيلًا ", "translation": "Among the believers are men true to what they promised Allāh. Among them is he who has fulfilled his vow [to the death], and among them is he who awaits [his chance]. And they did not alter [the terms of their commitment] by any alteration -", "words": [{"id": 1, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 2, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 3, "arabic": "رِجَالٌ", "translit": "ٌlāَjgِr", "root": "رجل"}, {"id": 4, "arabic": "صَدَقُوا۟", "translit": "۟āwُqَdَṣ", "root": "صدق"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "عَٰهَدُوا۟", "translit": "۟āwُdَhَٰʿع", "root": "عهد"}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 10, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 11, "arabic": "قَضَىٰ", "translit": "ٰàَḍَq", "root": "قضي"}, {"id": 12, "arabic": "نَحْبَهُۥ", "translit": "ۥُhَbْḥَn", "root": "نحب"}, {"id": 13, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 14, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 15, "arabic": "يَنتَظِرُ", "translit": "ُrِẓَtnَy", "root": "نظر"}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "بَدَّلُوا۟", "translit": "۟āwُlَّdَb", "root": "بدل"}, {"id": 18, "arabic": "تَبْدِيلًا", "translit": "āًlyِdْbَt", "root": "بدل"}], "hasIhya": true}, {"ayah": 24, "text": "لِّيَجْزِىَ ٱللَّهُ ٱلصَّٰدِقِينَ بِصِدْقِهِمْ وَيُعَذِّبَ ٱلْمُنَٰفِقِينَ إِن شَآءَ أَوْ يَتُوبَ عَلَيْهِمْۚ إِنَّ ٱللَّهَ كَانَ غَفُورًا رَّحِيمًا ", "translation": "That Allāh may reward the truthful for their truth and punish the hypocrites if He wills or accept their repentance. Indeed, Allāh is ever Forgiving and Merciful.", "words": [{"id": 1, "arabic": "لِّيَجْزِىَ", "translit": "َàِzْjgَyِّl", "root": "جزي"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱ", "root": "صدق"}, {"id": 4, "arabic": "بِصِدْقِهِمْ", "translit": "ْmِhِqْdِṣِb", "root": "صدق"}, {"id": 5, "arabic": "وَيُعَذِّبَ", "translit": "َbِّhdَʿعُyَw", "root": "عذب"}, {"id": 6, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 7, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 8, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 9, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 10, "arabic": "يَتُوبَ", "translit": "َbwُtَy", "root": "توب"}, {"id": 11, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 15, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 16, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 25, "text": "وَرَدَّ ٱللَّهُ ٱلَّذِينَ كَفَرُوا۟ بِغَيْظِهِمْ لَمْ يَنَالُوا۟ خَيْرًاۚ وَكَفَى ٱللَّهُ ٱلْمُؤْمِنِينَ ٱلْقِتَالَۚ وَكَانَ ٱللَّهُ قَوِيًّا عَزِيزًا ", "translation": "And Allāh repelled those who disbelieved, in their rage, not having obtained any good. And sufficient was Allāh for the believers in battle, and ever is Allāh Powerful and Exalted in Might.", "words": [{"id": 1, "arabic": "وَرَدَّ", "translit": "َّdَrَw", "root": "ردد"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "بِغَيْظِهِمْ", "translit": "ْmِhِẓْyَغِb", "root": "غيظ"}, {"id": 6, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 7, "arabic": "يَنَالُوا۟", "translit": "۟āwُlāَnَy", "root": "نيل"}, {"id": 8, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 9, "arabic": "وَكَفَى", "translit": "àَfَkَw", "root": "كفي"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 12, "arabic": "ٱلْقِتَالَ", "translit": "َlāَtِqْlٱ", "root": "قتل"}, {"id": 13, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "قَوِيًّا", "translit": "āًّyِwَq", "root": "قوي"}, {"id": 16, "arabic": "عَزِيزًا", "translit": "āًzyِzَʿع", "root": "عزز"}], "hasIhya": false}, {"ayah": 26, "text": "وَأَنزَلَ ٱلَّذِينَ ظَٰهَرُوهُم مِّنْ أَهْلِ ٱلْكِتَٰبِ مِن صَيَاصِيهِمْ وَقَذَفَ فِى قُلُوبِهِمُ ٱلرُّعْبَ فَرِيقًا تَقْتُلُونَ وَتَأْسِرُونَ فَرِيقًا ", "translation": "And He brought down those who supported them among the People of the Scripture[1] from their fortresses and cast terror into their hearts [so that] a party [i.e., their men] you killed, and you took captive a party [i.e., the women and children].", "words": [{"id": 1, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ظَٰهَرُوهُم", "translit": "mُhwُrَhَٰẓ", "root": "ظهر"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 6, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 7, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 8, "arabic": "صَيَاصِيهِمْ", "translit": "ْmِhyِṣāَyَṣ", "root": "صيص"}, {"id": 9, "arabic": "وَقَذَفَ", "translit": "َfَhdَqَw", "root": "قذف"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "قُلُوبِهِمُ", "translit": "ُmِhِbwُlُq", "root": "قلب"}, {"id": 12, "arabic": "ٱلرُّعْبَ", "translit": "َbْʿعُّrlٱ", "root": "رعب"}, {"id": 13, "arabic": "فَرِيقًا", "translit": "āًqyِrَf", "root": "فرق"}, {"id": 14, "arabic": "تَقْتُلُونَ", "translit": "َnwُlُtْqَt", "root": "قتل"}, {"id": 15, "arabic": "وَتَأْسِرُونَ", "translit": "َnwُrِsْaʾَtَw", "root": "اسر"}, {"id": 16, "arabic": "فَرِيقًا", "translit": "āًqyِrَf", "root": "فرق"}], "hasIhya": false}, {"ayah": 27, "text": "وَأَوْرَثَكُمْ أَرْضَهُمْ وَدِيَٰرَهُمْ وَأَمْوَٰلَهُمْ وَأَرْضًا لَّمْ تَطَـُٔوهَاۚ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرًا ", "translation": "And He caused you to inherit their land and their homes and their properties and a land which you have not trodden.[1] And ever is Allāh, over all things, competent.", "words": [{"id": 1, "arabic": "وَأَوْرَثَكُمْ", "translit": "ْmُkَhtَrْwَaʾَw", "root": "ورث"}, {"id": 2, "arabic": "أَرْضَهُمْ", "translit": "ْmُhَḍْrَaʾ", "root": "ارض"}, {"id": 3, "arabic": "وَدِيَٰرَهُمْ", "translit": "ْmُhَrَٰyِdَw", "root": "دور"}, {"id": 4, "arabic": "وَأَمْوَٰلَهُمْ", "translit": "ْmُhَlَٰwْmَaʾَw", "root": "مول"}, {"id": 5, "arabic": "وَأَرْضًا", "translit": "āًḍْrَaʾَw", "root": "ارض"}, {"id": 6, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 7, "arabic": "تَطَـُٔوهَا", "translit": "āَhwُٔـَṭَt", "root": "وطا"}, {"id": 8, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 11, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "قَدِيرًا", "translit": "āًryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 28, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ قُل لِّأَزْوَٰجِكَ إِن كُنتُنَّ تُرِدْنَ ٱلْحَيَوٰةَ ٱلدُّنْيَا وَزِينَتَهَا فَتَعَالَيْنَ أُمَتِّعْكُنَّ وَأُسَرِّحْكُنَّ سَرَاحًا جَمِيلًا ", "translation": "O Prophet, say to your wives, \"If you should desire the worldly life and its adornment, then come, I will provide for you and give you a gracious release.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 4, "arabic": "لِّأَزْوَٰجِكَ", "translit": "َkِjgَٰwْzَaʾِّl", "root": "زوج"}, {"id": 5, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 6, "arabic": "كُنتُنَّ", "translit": "َّnُtnُk", "root": "كون"}, {"id": 7, "arabic": "تُرِدْنَ", "translit": "َnْdِrُt", "root": "رود"}, {"id": 8, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 9, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 10, "arabic": "وَزِينَتَهَا", "translit": "āَhَtَnyِzَw", "root": "زين"}, {"id": 11, "arabic": "فَتَعَالَيْنَ", "translit": "َnْyَlāَʿعَtَf", "root": "علو"}, {"id": 12, "arabic": "أُمَتِّعْكُنَّ", "translit": "َّnُkْʿعِّtَmُaʾ", "root": "متع"}, {"id": 13, "arabic": "وَأُسَرِّحْكُنَّ", "translit": "َّnُkْḥِّrَsُaʾَw", "root": "سرح"}, {"id": 14, "arabic": "سَرَاحًا", "translit": "āًḥāَrَs", "root": "سرح"}, {"id": 15, "arabic": "جَمِيلًا", "translit": "āًlyِmَjg", "root": "جمل"}], "hasIhya": false}, {"ayah": 29, "text": "وَإِن كُنتُنَّ تُرِدْنَ ٱللَّهَ وَرَسُولَهُۥ وَٱلدَّارَ ٱلْءَاخِرَةَ فَإِنَّ ٱللَّهَ أَعَدَّ لِلْمُحْسِنَٰتِ مِنكُنَّ أَجْرًا عَظِيمًا ", "translation": "But if you should desire Allāh and His Messenger and the home of the Hereafter - then indeed, Allāh has prepared for the doers of good among you a great reward.\"", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "كُنتُنَّ", "translit": "َّnُtnُk", "root": "كون"}, {"id": 3, "arabic": "تُرِدْنَ", "translit": "َnْdِrُt", "root": "رود"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 6, "arabic": "وَٱلدَّارَ", "translit": "َrāَّdlٱَw", "root": "دور"}, {"id": 7, "arabic": "ٱلْءَاخِرَةَ", "translit": "َẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 8, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "أَعَدَّ", "translit": "َّdَʿعَaʾ", "root": "عدد"}, {"id": 11, "arabic": "لِلْمُحْسِنَٰتِ", "translit": "ِtَٰnِsْḥُmْlِl", "root": "حسن"}, {"id": 12, "arabic": "مِنكُنَّ", "translit": "َّnُknِm", "root": ""}, {"id": 13, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 14, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 30, "text": "يَٰنِسَآءَ ٱلنَّبِىِّ مَن يَأْتِ مِنكُنَّ بِفَٰحِشَةٍ مُّبَيِّنَةٍ يُضَٰعَفْ لَهَا ٱلْعَذَابُ ضِعْفَيْنِۚ وَكَانَ ذَٰلِكَ عَلَى ٱللَّهِ يَسِيرًا ", "translation": "O wives of the Prophet, whoever of you should commit a clear immorality - for her the punishment would be doubled two fold, and ever is that, for Allāh, easy.", "words": [{"id": 1, "arabic": "يَٰنِسَآءَ", "translit": "َءٓāَsِnَٰy", "root": "نسو"}, {"id": 2, "arabic": "ٱلنَّبِىِّ", "translit": "ِّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 5, "arabic": "مِنكُنَّ", "translit": "َّnُknِm", "root": ""}, {"id": 6, "arabic": "بِفَٰحِشَةٍ", "translit": "ٍẗَhsِḥَٰfِb", "root": "فحش"}, {"id": 7, "arabic": "مُّبَيِّنَةٍ", "translit": "ٍẗَnِّyَbُّm", "root": "بين"}, {"id": 8, "arabic": "يُضَٰعَفْ", "translit": "ْfَʿعَٰḍُy", "root": "ضعف"}, {"id": 9, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 10, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 11, "arabic": "ضِعْفَيْنِ", "translit": "ِnْyَfْʿعِḍ", "root": "ضعف"}, {"id": 12, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 13, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 14, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "يَسِيرًا", "translit": "āًryِsَy", "root": "يسر"}], "hasIhya": false}, {"ayah": 31, "text": "وَمَن يَقْنُتْ مِنكُنَّ لِلَّهِ وَرَسُولِهِۦ وَتَعْمَلْ صَٰلِحًا نُّؤْتِهَآ أَجْرَهَا مَرَّتَيْنِ وَأَعْتَدْنَا لَهَا رِزْقًا كَرِيمًا ", "translation": "And whoever of you devoutly obeys Allāh and His Messenger and does righteousness - We will give her her reward twice; and We have prepared for her a noble provision.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَقْنُتْ", "translit": "ْtُnْqَy", "root": "قنت"}, {"id": 3, "arabic": "مِنكُنَّ", "translit": "َّnُknِm", "root": ""}, {"id": 4, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 5, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 6, "arabic": "وَتَعْمَلْ", "translit": "ْlَmْʿعَtَw", "root": "عمل"}, {"id": 7, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 8, "arabic": "نُّؤْتِهَآ", "translit": "ٓāَhِtْwʾُّn", "root": "اتي"}, {"id": 9, "arabic": "أَجْرَهَا", "translit": "āَhَrْjgَaʾ", "root": "اجر"}, {"id": 10, "arabic": "مَرَّتَيْنِ", "translit": "ِnْyَtَّrَm", "root": "مرر"}, {"id": 11, "arabic": "وَأَعْتَدْنَا", "translit": "āَnْdَtْʿعَaʾَw", "root": "عتد"}, {"id": 12, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 13, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 14, "arabic": "كَرِيمًا", "translit": "āًmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 32, "text": "يَٰنِسَآءَ ٱلنَّبِىِّ لَسْتُنَّ كَأَحَدٍ مِّنَ ٱلنِّسَآءِۚ إِنِ ٱتَّقَيْتُنَّ فَلَا تَخْضَعْنَ بِٱلْقَوْلِ فَيَطْمَعَ ٱلَّذِى فِى قَلْبِهِۦ مَرَضٌ وَقُلْنَ قَوْلًا مَّعْرُوفًا ", "translation": "O wives of the Prophet, you are not like anyone among women. If you fear Allāh, then do not be soft in speech [to men],[1] lest he in whose heart is disease should covet, but speak with appropriate speech.", "words": [{"id": 1, "arabic": "يَٰنِسَآءَ", "translit": "َءٓāَsِnَٰy", "root": "نسو"}, {"id": 2, "arabic": "ٱلنَّبِىِّ", "translit": "ِّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "لَسْتُنَّ", "translit": "َّnُtْsَl", "root": "ليس"}, {"id": 4, "arabic": "كَأَحَدٍ", "translit": "ٍdَḥَaʾَk", "root": "احد"}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 7, "arabic": "إِنِ", "translit": "ِnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱتَّقَيْتُنَّ", "translit": "َّnُtْyَqَّtٱ", "root": "وقي"}, {"id": 9, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 10, "arabic": "تَخْضَعْنَ", "translit": "َnْʿعَḍْhkَt", "root": "خضع"}, {"id": 11, "arabic": "بِٱلْقَوْلِ", "translit": "ِlْwَqْlٱِb", "root": "قول"}, {"id": 12, "arabic": "فَيَطْمَعَ", "translit": "َʿعَmْṭَyَf", "root": "طمع"}, {"id": 13, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "قَلْبِهِۦ", "translit": "ۦِhِbْlَq", "root": "قلب"}, {"id": 16, "arabic": "مَرَضٌ", "translit": "ٌḍَrَm", "root": "مرض"}, {"id": 17, "arabic": "وَقُلْنَ", "translit": "َnْlُqَw", "root": "قول"}, {"id": 18, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 19, "arabic": "مَّعْرُوفًا", "translit": "āًfwُrْʿعَّm", "root": "عرف"}], "hasIhya": false}, {"ayah": 33, "text": "وَقَرْنَ فِى بُيُوتِكُنَّ وَلَا تَبَرَّجْنَ تَبَرُّجَ ٱلْجَٰهِلِيَّةِ ٱلْأُولَىٰۖ وَأَقِمْنَ ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعْنَ ٱللَّهَ وَرَسُولَهُۥٓۚ إِنَّمَا يُرِيدُ ٱللَّهُ لِيُذْهِبَ عَنكُمُ ٱلرِّجْسَ أَهْلَ ٱلْبَيْتِ وَيُطَهِّرَكُمْ تَطْهِيرًا ", "translation": "And abide in your houses and do not display yourselves as [was] the display of the former times of ignorance. And establish prayer and give zakāh and obey Allāh and His Messenger. Allāh intends only to remove from you the impurity [of sin], O people of the [Prophet's] household, and to purify you with [extensive] purification.", "words": [{"id": 1, "arabic": "وَقَرْنَ", "translit": "َnْrَqَw", "root": "قرر"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "بُيُوتِكُنَّ", "translit": "َّnُkِtwُyُb", "root": "بيت"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "تَبَرَّجْنَ", "translit": "َnْjgَّrَbَt", "root": "برج"}, {"id": 6, "arabic": "تَبَرُّجَ", "translit": "َjgُّrَbَt", "root": "برج"}, {"id": 7, "arabic": "ٱلْجَٰهِلِيَّةِ", "translit": "ِẗَّyِlِhَٰjgْlٱ", "root": "جهل"}, {"id": 8, "arabic": "ٱلْأُولَىٰ", "translit": "ٰàَlwُaʾْlٱ", "root": "اول"}, {"id": 9, "arabic": "وَأَقِمْنَ", "translit": "َnْmِqَaʾَw", "root": "قوم"}, {"id": 10, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 11, "arabic": "وَءَاتِينَ", "translit": "َnyِtāَءَw", "root": "اتي"}, {"id": 12, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 13, "arabic": "وَأَطِعْنَ", "translit": "َnْʿعِṭَaʾَw", "root": "طوع"}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَرَسُولَهُۥٓ", "translit": "ٓۥُhَlwُsَrَw", "root": "رسل"}, {"id": 16, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 17, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "لِيُذْهِبَ", "translit": "َbِhْhdُyِl", "root": "ذهب"}, {"id": 20, "arabic": "عَنكُمُ", "translit": "ُmُknَʿع", "root": ""}, {"id": 21, "arabic": "ٱلرِّجْسَ", "translit": "َsْjgِّrlٱ", "root": "رجس"}, {"id": 22, "arabic": "أَهْلَ", "translit": "َlْhَaʾ", "root": "اهل"}, {"id": 23, "arabic": "ٱلْبَيْتِ", "translit": "ِtْyَbْlٱ", "root": "بيت"}, {"id": 24, "arabic": "وَيُطَهِّرَكُمْ", "translit": "ْmُkَrِّhَṭُyَw", "root": "طهر"}, {"id": 25, "arabic": "تَطْهِيرًا", "translit": "āًryِhْṭَt", "root": "طهر"}], "hasIhya": false}, {"ayah": 34, "text": "وَٱذْكُرْنَ مَا يُتْلَىٰ فِى بُيُوتِكُنَّ مِنْ ءَايَٰتِ ٱللَّهِ وَٱلْحِكْمَةِۚ إِنَّ ٱللَّهَ كَانَ لَطِيفًا خَبِيرًا ", "translation": "And remember what is recited in your houses of the verses of Allāh and wisdom.[1] Indeed, Allāh is ever Subtle[2] and Aware.", "words": [{"id": 1, "arabic": "وَٱذْكُرْنَ", "translit": "َnْrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "يُتْلَىٰ", "translit": "ٰàَlْtُy", "root": "تلو"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "بُيُوتِكُنَّ", "translit": "َّnُkِtwُyُb", "root": "بيت"}, {"id": 6, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 7, "arabic": "ءَايَٰتِ", "translit": "ِtَٰyāَء", "root": "ايي"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَٱلْحِكْمَةِ", "translit": "ِẗَmْkِḥْlٱَw", "root": "حكم"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 13, "arabic": "لَطِيفًا", "translit": "āًfyِṭَl", "root": "لطف"}, {"id": 14, "arabic": "خَبِيرًا", "translit": "āًryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 35, "text": "إِنَّ ٱلْمُسْلِمِينَ وَٱلْمُسْلِمَٰتِ وَٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ وَٱلْقَٰنِتِينَ وَٱلْقَٰنِتَٰتِ وَٱلصَّٰدِقِينَ وَٱلصَّٰدِقَٰتِ وَٱلصَّٰبِرِينَ وَٱلصَّٰبِرَٰتِ وَٱلْخَٰشِعِينَ وَٱلْخَٰشِعَٰتِ وَٱلْمُتَصَدِّقِينَ وَٱلْمُتَصَدِّقَٰتِ وَٱلصَّٰٓئِمِينَ وَٱلصَّٰٓئِمَٰتِ وَٱلْحَٰفِظِينَ فُرُوجَهُمْ وَٱلْحَٰفِظَٰتِ وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرًا وَٱلذَّٰكِرَٰتِ أَعَدَّ ٱللَّهُ لَهُم مَّغْفِرَةً وَأَجْرًا عَظِيمًا ", "translation": "Indeed, the Muslim men and Muslim women, the believing men and believing women, the obedient men and obedient women, the truthful men and truthful women, the patient men and patient women, the humble men and humble women, the charitable men and charitable women, the fasting men and fasting women, the men who guard their private parts and the women who do so, and the men who remember Allāh often and the women who do so - for them Allāh has prepared forgiveness and a great reward.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلْمُسْلِمِينَ", "translit": "َnyِmِlْsُmْlٱ", "root": "سلم"}, {"id": 3, "arabic": "وَٱلْمُسْلِمَٰتِ", "translit": "ِtَٰmِlْsُmْlٱَw", "root": "سلم"}, {"id": 4, "arabic": "وَٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 5, "arabic": "وَٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 6, "arabic": "وَٱلْقَٰنِتِينَ", "translit": "َnyِtِnَٰqْlٱَw", "root": "قنت"}, {"id": 7, "arabic": "وَٱلْقَٰنِتَٰتِ", "translit": "ِtَٰtِnَٰqْlٱَw", "root": "قنت"}, {"id": 8, "arabic": "وَٱلصَّٰدِقِينَ", "translit": "َnyِqِdَّٰṣlٱَw", "root": "صدق"}, {"id": 9, "arabic": "وَٱلصَّٰدِقَٰتِ", "translit": "ِtَٰqِdَّٰṣlٱَw", "root": "صدق"}, {"id": 10, "arabic": "وَٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱَw", "root": "صبر"}, {"id": 11, "arabic": "وَٱلصَّٰبِرَٰتِ", "translit": "ِtَٰrِbَّٰṣlٱَw", "root": "صبر"}, {"id": 12, "arabic": "وَٱلْخَٰشِعِينَ", "translit": "َnyِʿعِhsَٰhkْlٱَw", "root": "خشع"}, {"id": 13, "arabic": "وَٱلْخَٰشِعَٰتِ", "translit": "ِtَٰʿعِhsَٰhkْlٱَw", "root": "خشع"}, {"id": 14, "arabic": "وَٱلْمُتَصَدِّقِينَ", "translit": "َnyِqِّdَṣَtُmْlٱَw", "root": "صدق"}, {"id": 15, "arabic": "وَٱلْمُتَصَدِّقَٰتِ", "translit": "ِtَٰqِّdَṣَtُmْlٱَw", "root": "صدق"}, {"id": 16, "arabic": "وَٱلصَّٰٓئِمِينَ", "translit": "َnyِmِyʾَّٰٓṣlٱَw", "root": "صوم"}, {"id": 17, "arabic": "وَٱلصَّٰٓئِمَٰتِ", "translit": "ِtَٰmِyʾَّٰٓṣlٱَw", "root": "صوم"}, {"id": 18, "arabic": "وَٱلْحَٰفِظِينَ", "translit": "َnyِẓِfَٰḥْlٱَw", "root": "حفظ"}, {"id": 19, "arabic": "فُرُوجَهُمْ", "translit": "ْmُhَjgwُrُf", "root": "فرج"}, {"id": 20, "arabic": "وَٱلْحَٰفِظَٰتِ", "translit": "ِtَٰẓِfَٰḥْlٱَw", "root": "حفظ"}, {"id": 21, "arabic": "وَٱلذَّٰكِرِينَ", "translit": "َnyِrِkَّٰhdlٱَw", "root": "ذكر"}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 24, "arabic": "وَٱلذَّٰكِرَٰتِ", "translit": "ِtَٰrِkَّٰhdlٱَw", "root": "ذكر"}, {"id": 25, "arabic": "أَعَدَّ", "translit": "َّdَʿعَaʾ", "root": "عدد"}, {"id": 26, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 28, "arabic": "مَّغْفِرَةً", "translit": "ًẗَrِfْغَّm", "root": "غفر"}, {"id": 29, "arabic": "وَأَجْرًا", "translit": "āًrْjgَaʾَw", "root": "اجر"}, {"id": 30, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 36, "text": "وَمَا كَانَ لِمُؤْمِنٍ وَلَا مُؤْمِنَةٍ إِذَا قَضَى ٱللَّهُ وَرَسُولُهُۥٓ أَمْرًا أَن يَكُونَ لَهُمُ ٱلْخِيَرَةُ مِنْ أَمْرِهِمْۗ وَمَن يَعْصِ ٱللَّهَ وَرَسُولَهُۥ فَقَدْ ضَلَّ ضَلَٰلًا مُّبِينًا ", "translation": "It is not for a believing man or a believing woman, when Allāh and His Messenger have decided a matter, that they should [thereafter] have any choice about their affair. And whoever disobeys Allāh and His Messenger has certainly strayed into clear error.", "words": [{"id": 1, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "لِمُؤْمِنٍ", "translit": "ٍnِmْwʾُmِl", "root": "امن"}, {"id": 4, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 5, "arabic": "مُؤْمِنَةٍ", "translit": "ٍẗَnِmْwʾُm", "root": "امن"}, {"id": 6, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 7, "arabic": "قَضَى", "translit": "àَḍَq", "root": "قضي"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَرَسُولُهُۥٓ", "translit": "ٓۥُhُlwُsَrَw", "root": "رسل"}, {"id": 10, "arabic": "أَمْرًا", "translit": "āًrْmَaʾ", "root": "امر"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 13, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 14, "arabic": "ٱلْخِيَرَةُ", "translit": "ُẗَrَyِhkْlٱ", "root": "خير"}, {"id": 15, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 16, "arabic": "أَمْرِهِمْ", "translit": "ْmِhِrْmَaʾ", "root": "امر"}, {"id": 17, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 18, "arabic": "يَعْصِ", "translit": "ِṣْʿعَy", "root": "عصي"}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 21, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 22, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 23, "arabic": "ضَلَٰلًا", "translit": "āًlَٰlَḍ", "root": "ضلل"}, {"id": 24, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 37, "text": "وَإِذْ تَقُولُ لِلَّذِىٓ أَنْعَمَ ٱللَّهُ عَلَيْهِ وَأَنْعَمْتَ عَلَيْهِ أَمْسِكْ عَلَيْكَ زَوْجَكَ وَٱتَّقِ ٱللَّهَ وَتُخْفِى فِى نَفْسِكَ مَا ٱللَّهُ مُبْدِيهِ وَتَخْشَى ٱلنَّاسَ وَٱللَّهُ أَحَقُّ أَن تَخْشَىٰهُۖ فَلَمَّا قَضَىٰ زَيْدٌ مِّنْهَا وَطَرًا زَوَّجْنَٰكَهَا لِكَىْ لَا يَكُونَ عَلَى ٱلْمُؤْمِنِينَ حَرَجٌ فِىٓ أَزْوَٰجِ أَدْعِيَآئِهِمْ إِذَا قَضَوْا۟ مِنْهُنَّ وَطَرًاۚ وَكَانَ أَمْرُ ٱللَّهِ مَفْعُولًا ", "translation": "And [remember, O Muḥammad], when you said to the one on whom Allāh bestowed favor and you bestowed favor,[1] \"Keep your wife and fear Allāh,\" while you concealed within yourself that which Allāh is to disclose.[2] And you feared the people,[3] while Allāh has more right that you fear Him.[4] So when Zayd had no longer any need for her, We married her to you in order that there not be upon the believers any discomfort [i.e., guilt] concerning the wives of their claimed [i.e., adopted] sons when they no longer have need of them. And ever is the command [i.e., decree] of Allāh accomplished.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "تَقُولُ", "translit": "ُlwُqَt", "root": "قول"}, {"id": 3, "arabic": "لِلَّذِىٓ", "translit": "ٓàِhdَّlِl", "root": ""}, {"id": 4, "arabic": "أَنْعَمَ", "translit": "َmَʿعْnَaʾ", "root": "نعم"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 7, "arabic": "وَأَنْعَمْتَ", "translit": "َtْmَʿعْnَaʾَw", "root": "نعم"}, {"id": 8, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "أَمْسِكْ", "translit": "ْkِsْmَaʾ", "root": "مسك"}, {"id": 10, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 11, "arabic": "زَوْجَكَ", "translit": "َkَjgْwَz", "root": "زوج"}, {"id": 12, "arabic": "وَٱتَّقِ", "translit": "ِqَّtٱَw", "root": "وقي"}, {"id": 13, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَتُخْفِى", "translit": "àِfْhkُtَw", "root": "خفي"}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "نَفْسِكَ", "translit": "َkِsْfَn", "root": "نفس"}, {"id": 17, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "مُبْدِيهِ", "translit": "ِhyِdْbُm", "root": "بدو"}, {"id": 20, "arabic": "وَتَخْشَى", "translit": "àَhsْhkَtَw", "root": "خشي"}, {"id": 21, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "أَحَقُّ", "translit": "ُّqَḥَaʾ", "root": "حقق"}, {"id": 24, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 25, "arabic": "تَخْشَىٰهُ", "translit": "ُhٰàَhsْhkَt", "root": "خشي"}, {"id": 26, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 27, "arabic": "قَضَىٰ", "translit": "ٰàَḍَq", "root": "قضي"}, {"id": 28, "arabic": "زَيْدٌ", "translit": "ٌdْyَz", "root": ""}, {"id": 29, "arabic": "مِّنْهَا", "translit": "āَhْnِّm", "root": ""}, {"id": 30, "arabic": "وَطَرًا", "translit": "āًrَṭَw", "root": "وطر"}, {"id": 31, "arabic": "زَوَّجْنَٰكَهَا", "translit": "āَhَkَٰnْjgَّwَz", "root": "زوج"}, {"id": 32, "arabic": "لِكَىْ", "translit": "ْàَkِl", "root": ""}, {"id": 33, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 34, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 35, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 36, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 37, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج"}, {"id": 38, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 39, "arabic": "أَزْوَٰجِ", "translit": "ِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 40, "arabic": "أَدْعِيَآئِهِمْ", "translit": "ْmِhِyʾٓāَyِʿعْdَaʾ", "root": "دعو"}, {"id": 41, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 42, "arabic": "قَضَوْا۟", "translit": "۟āْwَḍَq", "root": "قضي"}, {"id": 43, "arabic": "مِنْهُنَّ", "translit": "َّnُhْnِm", "root": ""}, {"id": 44, "arabic": "وَطَرًا", "translit": "āًrَṭَw", "root": "وطر"}, {"id": 45, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 46, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 47, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 48, "arabic": "مَفْعُولًا", "translit": "āًlwُʿعْfَm", "root": "فعل"}], "hasIhya": false}, {"ayah": 38, "text": "مَّا كَانَ عَلَى ٱلنَّبِىِّ مِنْ حَرَجٍ فِيمَا فَرَضَ ٱللَّهُ لَهُۥۖ سُنَّةَ ٱللَّهِ فِى ٱلَّذِينَ خَلَوْا۟ مِن قَبْلُۚ وَكَانَ أَمْرُ ٱللَّهِ قَدَرًا مَّقْدُورًا ", "translation": "There is not to be upon the Prophet any discomfort concerning that which Allāh has imposed upon him.[1] [This is] the established way of Allāh with those [prophets] who have passed on before. And ever is the command of Allāh a destiny decreed.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلنَّبِىِّ", "translit": "ِّàِbَّnlٱ", "root": "نبا"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "حَرَجٍ", "translit": "ٍjgَrَḥ", "root": "حرج"}, {"id": 7, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 8, "arabic": "فَرَضَ", "translit": "َḍَrَf", "root": "فرض"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 11, "arabic": "سُنَّةَ", "translit": "َẗَّnُs", "root": "سنن"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 15, "arabic": "خَلَوْا۟", "translit": "۟āْwَlَhk", "root": "خلو"}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 18, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 19, "arabic": "أَمْرُ", "translit": "ُrْmَaʾ", "root": "امر"}, {"id": 20, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "قَدَرًا", "translit": "āًrَdَq", "root": "قدر"}, {"id": 22, "arabic": "مَّقْدُورًا", "translit": "āًrwُdْqَّm", "root": "قدر"}], "hasIhya": true}, {"ayah": 39, "text": "ٱلَّذِينَ يُبَلِّغُونَ رِسَٰلَٰتِ ٱللَّهِ وَيَخْشَوْنَهُۥ وَلَا يَخْشَوْنَ أَحَدًا إِلَّا ٱللَّهَۗ وَكَفَىٰ بِٱللَّهِ حَسِيبًا ", "translation": "[Allāh praises] those who convey the messages of Allāh[1] and fear Him and do not fear anyone but Allāh. And sufficient is Allāh as Accountant.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُبَلِّغُونَ", "translit": "َnwُغِّlَbُy", "root": "بلغ"}, {"id": 3, "arabic": "رِسَٰلَٰتِ", "translit": "ِtَٰlَٰsِr", "root": "رسل"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَيَخْشَوْنَهُۥ", "translit": "ۥُhَnْwَhsْhkَyَw", "root": "خشي"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "يَخْشَوْنَ", "translit": "َnْwَhsْhkَy", "root": "خشي"}, {"id": 8, "arabic": "أَحَدًا", "translit": "āًdَḥَaʾ", "root": "احد"}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 12, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 13, "arabic": "حَسِيبًا", "translit": "āًbyِsَḥ", "root": "حسب"}], "hasIhya": false}, {"ayah": 40, "text": "مَّا كَانَ مُحَمَّدٌ أَبَآ أَحَدٍ مِّن رِّجَالِكُمْ وَلَٰكِن رَّسُولَ ٱللَّهِ وَخَاتَمَ ٱلنَّبِيِّۦنَۗ وَكَانَ ٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمًا ", "translation": "Muḥammad is not the father of [any] one of your men, but [he is] the Messenger of Allāh and seal [i.e., last] of the prophets. And ever is Allāh, of all things, Knowing.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "مُحَمَّدٌ", "translit": "ٌdَّmَḥُm", "root": "حمد"}, {"id": 4, "arabic": "أَبَآ", "translit": "ٓāَbَaʾ", "root": "ابو"}, {"id": 5, "arabic": "أَحَدٍ", "translit": "ٍdَḥَaʾ", "root": "احد"}, {"id": 6, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 7, "arabic": "رِّجَالِكُمْ", "translit": "ْmُkِlāَjgِّr", "root": "رجل"}, {"id": 8, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 9, "arabic": "رَّسُولَ", "translit": "َlwُsَّr", "root": "رسل"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَخَاتَمَ", "translit": "َmَtāَhkَw", "root": "ختم"}, {"id": 12, "arabic": "ٱلنَّبِيِّۦنَ", "translit": "َnۦِّyِbَّnlٱ", "root": "نبا"}, {"id": 13, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 16, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 17, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 41, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱذْكُرُوا۟ ٱللَّهَ ذِكْرًا كَثِيرًا ", "translation": "O you who have believed, remember Allāh with much remembrance", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱ", "root": "ذكر"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "ذِكْرًا", "translit": "āًrْkِhd", "root": "ذكر"}, {"id": 7, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}], "hasIhya": true}, {"ayah": 42, "text": "وَسَبِّحُوهُ بُكْرَةً وَأَصِيلًا ", "translation": "And exalt Him morning and afternoon.", "words": [{"id": 1, "arabic": "وَسَبِّحُوهُ", "translit": "ُhwُḥِّbَsَw", "root": "سبح"}, {"id": 2, "arabic": "بُكْرَةً", "translit": "ًẗَrْkُb", "root": "بكر"}, {"id": 3, "arabic": "وَأَصِيلًا", "translit": "āًlyِṣَaʾَw", "root": "اصل"}], "hasIhya": false}, {"ayah": 43, "text": "هُوَ ٱلَّذِى يُصَلِّى عَلَيْكُمْ وَمَلَٰٓئِكَتُهُۥ لِيُخْرِجَكُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۚ وَكَانَ بِٱلْمُؤْمِنِينَ رَحِيمًا ", "translation": "It is He who confers blessing upon you,[1] and His angels [ask Him to do so] that He may bring you out from darknesses into the light. And ever is He, to the believers, Merciful.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُصَلِّى", "translit": "àِّlَṣُy", "root": "صلو"}, {"id": 4, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 5, "arabic": "وَمَلَٰٓئِكَتُهُۥ", "translit": "ۥُhُtَkِyʾَٰٓlَmَw", "root": "ملك"}, {"id": 6, "arabic": "لِيُخْرِجَكُم", "translit": "mُkَjgِrْhkُyِl", "root": "خرج"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلظُّلُمَٰتِ", "translit": "ِtَٰmُlُّẓlٱ", "root": "ظلم"}, {"id": 9, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱلنُّورِ", "translit": "ِrwُّnlٱ", "root": "نور"}, {"id": 11, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 12, "arabic": "بِٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱِb", "root": "امن"}, {"id": 13, "arabic": "رَحِيمًا", "translit": "āًmyِḥَr", "root": "رحم"}], "hasIhya": true}, {"ayah": 44, "text": "تَحِيَّتُهُمْ يَوْمَ يَلْقَوْنَهُۥ سَلَٰمٌۚ وَأَعَدَّ لَهُمْ أَجْرًا كَرِيمًا ", "translation": "Their greeting the Day they meet Him will be, \"Peace.\" And He has prepared for them a noble reward.", "words": [{"id": 1, "arabic": "تَحِيَّتُهُمْ", "translit": "ْmُhُtَّyِḥَt", "root": "حيي"}, {"id": 2, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 3, "arabic": "يَلْقَوْنَهُۥ", "translit": "ۥُhَnْwَqْlَy", "root": "لقي"}, {"id": 4, "arabic": "سَلَٰمٌ", "translit": "ٌmَٰlَs", "root": "سلم"}, {"id": 5, "arabic": "وَأَعَدَّ", "translit": "َّdَʿعَaʾَw", "root": "عدد"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "أَجْرًا", "translit": "āًrْjgَaʾ", "root": "اجر"}, {"id": 8, "arabic": "كَرِيمًا", "translit": "āًmyِrَk", "root": "كرم"}], "hasIhya": false}, {"ayah": 45, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ إِنَّآ أَرْسَلْنَٰكَ شَٰهِدًا وَمُبَشِّرًا وَنَذِيرًا ", "translation": "O Prophet, indeed We have sent you as a witness and a bringer of good tidings and a warner", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 4, "arabic": "أَرْسَلْنَٰكَ", "translit": "َkَٰnْlَsْrَaʾ", "root": "رسل"}, {"id": 5, "arabic": "شَٰهِدًا", "translit": "āًdِhَٰhs", "root": "شهد"}, {"id": 6, "arabic": "وَمُبَشِّرًا", "translit": "āًrِّhsَbُmَw", "root": "بشر"}, {"id": 7, "arabic": "وَنَذِيرًا", "translit": "āًryِhdَnَw", "root": "نذر"}], "hasIhya": false}, {"ayah": 46, "text": "وَدَاعِيًا إِلَى ٱللَّهِ بِإِذْنِهِۦ وَسِرَاجًا مُّنِيرًا ", "translation": "And one who invites to Allāh, by His permission, and an illuminating lamp.", "words": [{"id": 1, "arabic": "وَدَاعِيًا", "translit": "āًyِʿعāَdَw", "root": "دعو"}, {"id": 2, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "بِإِذْنِهِۦ", "translit": "ۦِhِnْhdِiʾِb", "root": "اذن"}, {"id": 5, "arabic": "وَسِرَاجًا", "translit": "āًjgāَrِsَw", "root": "سرج"}, {"id": 6, "arabic": "مُّنِيرًا", "translit": "āًryِnُّm", "root": "نور"}], "hasIhya": false}, {"ayah": 47, "text": "وَبَشِّرِ ٱلْمُؤْمِنِينَ بِأَنَّ لَهُم مِّنَ ٱللَّهِ فَضْلًا كَبِيرًا ", "translation": "And give good tidings to the believers that they will have from Allāh great bounty.", "words": [{"id": 1, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 2, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 3, "arabic": "بِأَنَّ", "translit": "َّnَaʾِb", "root": ""}, {"id": 4, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 5, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "فَضْلًا", "translit": "āًlْḍَf", "root": "فضل"}, {"id": 8, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 48, "text": "وَلَا تُطِعِ ٱلْكَٰفِرِينَ وَٱلْمُنَٰفِقِينَ وَدَعْ أَذَىٰهُمْ وَتَوَكَّلْ عَلَى ٱللَّهِۚ وَكَفَىٰ بِٱللَّهِ وَكِيلًا ", "translation": "And do not obey the disbelievers and the hypocrites and disregard their annoyance, and rely upon Allāh. And sufficient is Allāh as Disposer of affairs.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تُطِعِ", "translit": "ِʿعِṭُt", "root": "طوع"}, {"id": 3, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 4, "arabic": "وَٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱَw", "root": "نفق"}, {"id": 5, "arabic": "وَدَعْ", "translit": "ْʿعَdَw", "root": "ودع"}, {"id": 6, "arabic": "أَذَىٰهُمْ", "translit": "ْmُhٰàَhdَaʾ", "root": "اذي"}, {"id": 7, "arabic": "وَتَوَكَّلْ", "translit": "ْlَّkَwَtَw", "root": "وكل"}, {"id": 8, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَكَفَىٰ", "translit": "ٰàَfَkَw", "root": "كفي"}, {"id": 11, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 12, "arabic": "وَكِيلًا", "translit": "āًlyِkَw", "root": "وكل"}], "hasIhya": true}, {"ayah": 49, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا نَكَحْتُمُ ٱلْمُؤْمِنَٰتِ ثُمَّ طَلَّقْتُمُوهُنَّ مِن قَبْلِ أَن تَمَسُّوهُنَّ فَمَا لَكُمْ عَلَيْهِنَّ مِنْ عِدَّةٍ تَعْتَدُّونَهَاۖ فَمَتِّعُوهُنَّ وَسَرِّحُوهُنَّ سَرَاحًا جَمِيلًا ", "translation": "O you who have believed, when you marry believing women and then divorce them before you have touched them [i.e., consummated the marriage], then there is not for you any waiting period to count concerning them. So provide for them and give them a gracious release.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "نَكَحْتُمُ", "translit": "ُmُtْḥَkَn", "root": "نكح"}, {"id": 6, "arabic": "ٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱ", "root": "امن"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "طَلَّقْتُمُوهُنَّ", "translit": "َّnُhwُmُtْqَّlَṭ", "root": "طلق"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "تَمَسُّوهُنَّ", "translit": "َّnُhwُّsَmَt", "root": "مسس"}, {"id": 13, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 14, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 15, "arabic": "عَلَيْهِنَّ", "translit": "َّnِhْyَlَʿع", "root": ""}, {"id": 16, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 17, "arabic": "عِدَّةٍ", "translit": "ٍẗَّdِʿع", "root": "عدد"}, {"id": 18, "arabic": "تَعْتَدُّونَهَا", "translit": "āَhَnwُّdَtْʿعَt", "root": "عدد"}, {"id": 19, "arabic": "فَمَتِّعُوهُنَّ", "translit": "َّnُhwُʿعِّtَmَf", "root": "متع"}, {"id": 20, "arabic": "وَسَرِّحُوهُنَّ", "translit": "َّnُhwُḥِّrَsَw", "root": "سرح"}, {"id": 21, "arabic": "سَرَاحًا", "translit": "āًḥāَrَs", "root": "سرح"}, {"id": 22, "arabic": "جَمِيلًا", "translit": "āًlyِmَjg", "root": "جمل"}], "hasIhya": false}, {"ayah": 50, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ إِنَّآ أَحْلَلْنَا لَكَ أَزْوَٰجَكَ ٱلَّٰتِىٓ ءَاتَيْتَ أُجُورَهُنَّ وَمَا مَلَكَتْ يَمِينُكَ مِمَّآ أَفَآءَ ٱللَّهُ عَلَيْكَ وَبَنَاتِ عَمِّكَ وَبَنَاتِ عَمَّٰتِكَ وَبَنَاتِ خَالِكَ وَبَنَاتِ خَٰلَٰتِكَ ٱلَّٰتِى هَاجَرْنَ مَعَكَ وَٱمْرَأَةً مُّؤْمِنَةً إِن وَهَبَتْ نَفْسَهَا لِلنَّبِىِّ إِنْ أَرَادَ ٱلنَّبِىُّ أَن يَسْتَنكِحَهَا خَالِصَةً لَّكَ مِن دُونِ ٱلْمُؤْمِنِينَۗ قَدْ عَلِمْنَا مَا فَرَضْنَا عَلَيْهِمْ فِىٓ أَزْوَٰجِهِمْ وَمَا مَلَكَتْ أَيْمَٰنُهُمْ لِكَيْلَا يَكُونَ عَلَيْكَ حَرَجٌۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ", "translation": "O Prophet, indeed We have made lawful to you your wives to whom you have given their due compensation[1] and those your right hand possesses from what Allāh has returned to you [of captives] and the daughters of your paternal uncles and the daughters of your paternal aunts and the daughters of your maternal uncles and the daughters of your maternal aunts who emigrated with you and a believing woman if she gives herself to the Prophet [and] if the Prophet wishes to marry her; [this is] only for you, excluding the [other] believers. We certainly know what We have made obligatory upon them concerning their wives and those their right hands possess, [but this is for you] in order that there will be upon you no discomfort [i.e., difficulty]. And ever is Allāh Forgiving and Merciful.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 4, "arabic": "أَحْلَلْنَا", "translit": "āَnْlَlْḥَaʾ", "root": "حلل"}, {"id": 5, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 6, "arabic": "أَزْوَٰجَكَ", "translit": "َkَjgَٰwْzَaʾ", "root": "زوج"}, {"id": 7, "arabic": "ٱلَّٰتِىٓ", "translit": "ٓàِtَّٰlٱ", "root": ""}, {"id": 8, "arabic": "ءَاتَيْتَ", "translit": "َtْyَtāَء", "root": "اتي"}, {"id": 9, "arabic": "أُجُورَهُنَّ", "translit": "َّnُhَrwُjgُaʾ", "root": "اجر"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 12, "arabic": "يَمِينُكَ", "translit": "َkُnyِmَy", "root": "يمن"}, {"id": 13, "arabic": "مِمَّآ", "translit": "ٓāَّmِm", "root": ""}, {"id": 14, "arabic": "أَفَآءَ", "translit": "َءٓāَfَaʾ", "root": "فيا"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 17, "arabic": "وَبَنَاتِ", "translit": "ِtāَnَbَw", "root": "بني"}, {"id": 18, "arabic": "عَمِّكَ", "translit": "َkِّmَʿع", "root": "عمم"}, {"id": 19, "arabic": "وَبَنَاتِ", "translit": "ِtāَnَbَw", "root": "بني"}, {"id": 20, "arabic": "عَمَّٰتِكَ", "translit": "َkِtَّٰmَʿع", "root": "عمم"}, {"id": 21, "arabic": "وَبَنَاتِ", "translit": "ِtāَnَbَw", "root": "بني"}, {"id": 22, "arabic": "خَالِكَ", "translit": "َkِlāَhk", "root": "خول"}, {"id": 23, "arabic": "وَبَنَاتِ", "translit": "ِtāَnَbَw", "root": "بني"}, {"id": 24, "arabic": "خَٰلَٰتِكَ", "translit": "َkِtَٰlَٰhk", "root": "خول"}, {"id": 25, "arabic": "ٱلَّٰتِى", "translit": "àِtَّٰlٱ", "root": ""}, {"id": 26, "arabic": "هَاجَرْنَ", "translit": "َnْrَjgāَh", "root": "هجر"}, {"id": 27, "arabic": "مَعَكَ", "translit": "َkَʿعَm", "root": ""}, {"id": 28, "arabic": "وَٱمْرَأَةً", "translit": "ًẗَaʾَrْmٱَw", "root": "مرا"}, {"id": 29, "arabic": "مُّؤْمِنَةً", "translit": "ًẗَnِmْwʾُّm", "root": "امن"}, {"id": 30, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 31, "arabic": "وَهَبَتْ", "translit": "ْtَbَhَw", "root": "وهب"}, {"id": 32, "arabic": "نَفْسَهَا", "translit": "āَhَsْfَn", "root": "نفس"}, {"id": 33, "arabic": "لِلنَّبِىِّ", "translit": "ِّàِbَّnlِl", "root": "نبا"}, {"id": 34, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 35, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 36, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 37, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 38, "arabic": "يَسْتَنكِحَهَا", "translit": "āَhَḥِknَtْsَy", "root": "نكح"}, {"id": 39, "arabic": "خَالِصَةً", "translit": "ًẗَṣِlāَhk", "root": "خلص"}, {"id": 40, "arabic": "لَّكَ", "translit": "َkَّl", "root": ""}, {"id": 41, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 42, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 43, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 44, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 45, "arabic": "عَلِمْنَا", "translit": "āَnْmِlَʿع", "root": "علم"}, {"id": 46, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 47, "arabic": "فَرَضْنَا", "translit": "āَnْḍَrَf", "root": "فرض"}, {"id": 48, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 49, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 50, "arabic": "أَزْوَٰجِهِمْ", "translit": "ْmِhِjgَٰwْzَaʾ", "root": "زوج"}, {"id": 51, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 52, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 53, "arabic": "أَيْمَٰنُهُمْ", "translit": "ْmُhُnَٰmْyَaʾ", "root": "يمن"}, {"id": 54, "arabic": "لِكَيْلَا", "translit": "āَlْyَkِl", "root": ""}, {"id": 55, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 56, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 57, "arabic": "حَرَجٌ", "translit": "ٌjgَrَḥ", "root": "حرج"}, {"id": 58, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 59, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 60, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 61, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 51, "text": "تُرْجِى مَن تَشَآءُ مِنْهُنَّ وَتُـْٔوِىٓ إِلَيْكَ مَن تَشَآءُۖ وَمَنِ ٱبْتَغَيْتَ مِمَّنْ عَزَلْتَ فَلَا جُنَاحَ عَلَيْكَۚ ذَٰلِكَ أَدْنَىٰٓ أَن تَقَرَّ أَعْيُنُهُنَّ وَلَا يَحْزَنَّ وَيَرْضَيْنَ بِمَآ ءَاتَيْتَهُنَّ كُلُّهُنَّۚ وَٱللَّهُ يَعْلَمُ مَا فِى قُلُوبِكُمْۚ وَكَانَ ٱللَّهُ عَلِيمًا حَلِيمًا ", "translation": "You, [O Muḥammad], may put aside whom you will of them[1] or take to yourself whom you will. And any that you desire of those [wives] from whom you had [temporarily] separated - there is no blame upon you [in returning her]. That is more suitable that they should be content and not grieve and that they should be satisfied with what you have given them - all of them. And Allāh knows what is in your hearts. And ever is Allāh Knowing and Forbearing.", "words": [{"id": 1, "arabic": "تُرْجِى", "translit": "àِjgْrُt", "root": "رجو"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 4, "arabic": "مِنْهُنَّ", "translit": "َّnُhْnِm", "root": ""}, {"id": 5, "arabic": "وَتُـْٔوِىٓ", "translit": "ٓàِwْٔـُtَw", "root": "اوي"}, {"id": 6, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "تَشَآءُ", "translit": "ُءٓāَhsَt", "root": "شيا"}, {"id": 9, "arabic": "وَمَنِ", "translit": "ِnَmَw", "root": ""}, {"id": 10, "arabic": "ٱبْتَغَيْتَ", "translit": "َtْyَغَtْbٱ", "root": "بغي"}, {"id": 11, "arabic": "مِمَّنْ", "translit": "ْnَّmِm", "root": ""}, {"id": 12, "arabic": "عَزَلْتَ", "translit": "َtْlَzَʿع", "root": "عزل"}, {"id": 13, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 14, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 15, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 16, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 17, "arabic": "أَدْنَىٰٓ", "translit": "ٰٓàَnْdَaʾ", "root": "دنو"}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "تَقَرَّ", "translit": "َّrَqَt", "root": "قرر"}, {"id": 20, "arabic": "أَعْيُنُهُنَّ", "translit": "َّnُhُnُyْʿعَaʾ", "root": "عين"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "يَحْزَنَّ", "translit": "َّnَzْḥَy", "root": "حزن"}, {"id": 23, "arabic": "وَيَرْضَيْنَ", "translit": "َnْyَḍْrَyَw", "root": "رضو"}, {"id": 24, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 25, "arabic": "ءَاتَيْتَهُنَّ", "translit": "َّnُhَtْyَtāَء", "root": "اتي"}, {"id": 26, "arabic": "كُلُّهُنَّ", "translit": "َّnُhُّlُk", "root": "كلل"}, {"id": 27, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 28, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 29, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 30, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 31, "arabic": "قُلُوبِكُمْ", "translit": "ْmُkِbwُlُq", "root": "قلب"}, {"id": 32, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 33, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 34, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}, {"id": 35, "arabic": "حَلِيمًا", "translit": "āًmyِlَḥ", "root": "حلم"}], "hasIhya": false}, {"ayah": 52, "text": "لَّا يَحِلُّ لَكَ ٱلنِّسَآءُ مِنۢ بَعْدُ وَلَآ أَن تَبَدَّلَ بِهِنَّ مِنْ أَزْوَٰجٍ وَلَوْ أَعْجَبَكَ حُسْنُهُنَّ إِلَّا مَا مَلَكَتْ يَمِينُكَۗ وَكَانَ ٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ رَّقِيبًا ", "translation": "Not lawful to you, [O Muḥammad], are [any additional] women after [this], nor [is it] for you to exchange them for [other] wives, even if their beauty were to please you, except what your right hand possesses. And ever is Allāh, over all things, an Observer.[1]", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "يَحِلُّ", "translit": "ُّlِḥَy", "root": "حلل"}, {"id": 3, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 4, "arabic": "ٱلنِّسَآءُ", "translit": "ُءٓāَsِّnlٱ", "root": "نسو"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدُ", "translit": "ُdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "تَبَدَّلَ", "translit": "َlَّdَbَt", "root": "بدل"}, {"id": 10, "arabic": "بِهِنَّ", "translit": "َّnِhِb", "root": ""}, {"id": 11, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 12, "arabic": "أَزْوَٰجٍ", "translit": "ٍjgَٰwْzَaʾ", "root": "زوج"}, {"id": 13, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 14, "arabic": "أَعْجَبَكَ", "translit": "َkَbَjgْʿعَaʾ", "root": "عجب"}, {"id": 15, "arabic": "حُسْنُهُنَّ", "translit": "َّnُhُnْsُḥ", "root": "حسن"}, {"id": 16, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 17, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 18, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 19, "arabic": "يَمِينُكَ", "translit": "َkُnyِmَy", "root": "يمن"}, {"id": 20, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 23, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 24, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 25, "arabic": "رَّقِيبًا", "translit": "āًbyِqَّr", "root": "رقب"}], "hasIhya": false}, {"ayah": 53, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَدْخُلُوا۟ بُيُوتَ ٱلنَّبِىِّ إِلَّآ أَن يُؤْذَنَ لَكُمْ إِلَىٰ طَعَامٍ غَيْرَ نَٰظِرِينَ إِنَىٰهُ وَلَٰكِنْ إِذَا دُعِيتُمْ فَٱدْخُلُوا۟ فَإِذَا طَعِمْتُمْ فَٱنتَشِرُوا۟ وَلَا مُسْتَـْٔنِسِينَ لِحَدِيثٍۚ إِنَّ ذَٰلِكُمْ كَانَ يُؤْذِى ٱلنَّبِىَّ فَيَسْتَحْىِۦ مِنكُمْۖ وَٱللَّهُ لَا يَسْتَحْىِۦ مِنَ ٱلْحَقِّۚ وَإِذَا سَأَلْتُمُوهُنَّ مَتَٰعًا فَسْـَٔلُوهُنَّ مِن وَرَآءِ حِجَابٍۚ ذَٰلِكُمْ أَطْهَرُ لِقُلُوبِكُمْ وَقُلُوبِهِنَّۚ وَمَا كَانَ لَكُمْ أَن تُؤْذُوا۟ رَسُولَ ٱللَّهِ وَلَآ أَن تَنكِحُوٓا۟ أَزْوَٰجَهُۥ مِنۢ بَعْدِهِۦٓ أَبَدًاۚ إِنَّ ذَٰلِكُمْ كَانَ عِندَ ٱللَّهِ عَظِيمًا ", "translation": "O you who have believed, do not enter the houses of the Prophet except when you are permitted for a meal, without awaiting its readiness. But when you are invited, then enter; and when you have eaten, disperse without seeking to remain for conversation. Indeed, that [behavior] was troubling the Prophet, and he is shy of [dismissing] you. But Allāh is not shy of the truth. And when you ask [his wives] for something, ask them from behind a partition. That is purer for your hearts and their hearts. And it is not [conceivable or lawful] for you to harm the Messenger of Allāh or to marry his wives after him, ever. Indeed, that would be in the sight of Allāh an enormity.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَدْخُلُوا۟", "translit": "۟āwُlُhkْdَt", "root": "دخل"}, {"id": 6, "arabic": "بُيُوتَ", "translit": "َtwُyُb", "root": "بيت"}, {"id": 7, "arabic": "ٱلنَّبِىِّ", "translit": "ِّàِbَّnlٱ", "root": "نبا"}, {"id": 8, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يُؤْذَنَ", "translit": "َnَhdْwʾُy", "root": "اذن"}, {"id": 11, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 12, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 13, "arabic": "طَعَامٍ", "translit": "ٍmāَʿعَṭ", "root": "طعم"}, {"id": 14, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 15, "arabic": "نَٰظِرِينَ", "translit": "َnyِrِẓَٰn", "root": "نظر"}, {"id": 16, "arabic": "إِنَىٰهُ", "translit": "ُhٰàَnِiʾ", "root": "اني"}, {"id": 17, "arabic": "وَلَٰكِنْ", "translit": "ْnِkَٰlَw", "root": ""}, {"id": 18, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 19, "arabic": "دُعِيتُمْ", "translit": "ْmُtyِʿعُd", "root": "دعو"}, {"id": 20, "arabic": "فَٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱَf", "root": "دخل"}, {"id": 21, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 22, "arabic": "طَعِمْتُمْ", "translit": "ْmُtْmِʿعَṭ", "root": "طعم"}, {"id": 23, "arabic": "فَٱنتَشِرُوا۟", "translit": "۟āwُrِhsَtnٱَf", "root": "نشر"}, {"id": 24, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 25, "arabic": "مُسْتَـْٔنِسِينَ", "translit": "َnyِsِnْٔـَtْsُm", "root": "انس"}, {"id": 26, "arabic": "لِحَدِيثٍ", "translit": "ٍhtyِdَḥِl", "root": "حدث"}, {"id": 27, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 28, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 29, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 30, "arabic": "يُؤْذِى", "translit": "àِhdْwʾُy", "root": "اذي"}, {"id": 31, "arabic": "ٱلنَّبِىَّ", "translit": "َّàِbَّnlٱ", "root": "نبا"}, {"id": 32, "arabic": "فَيَسْتَحْىِۦ", "translit": "ۦِàْḥَtْsَyَf", "root": "حيي"}, {"id": 33, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 34, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 35, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 36, "arabic": "يَسْتَحْىِۦ", "translit": "ۦِàْḥَtْsَy", "root": "حيي"}, {"id": 37, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 38, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 39, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 40, "arabic": "سَأَلْتُمُوهُنَّ", "translit": "َّnُhwُmُtْlَaʾَs", "root": "سال"}, {"id": 41, "arabic": "مَتَٰعًا", "translit": "āًʿعَٰtَm", "root": "متع"}, {"id": 42, "arabic": "فَسْـَٔلُوهُنَّ", "translit": "َّnُhwُlَٔـْsَf", "root": "سال"}, {"id": 43, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 44, "arabic": "وَرَآءِ", "translit": "ِءٓāَrَw", "root": "وري"}, {"id": 45, "arabic": "حِجَابٍ", "translit": "ٍbāَjgِḥ", "root": "حجب"}, {"id": 46, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 47, "arabic": "أَطْهَرُ", "translit": "ُrَhْṭَaʾ", "root": "طهر"}, {"id": 48, "arabic": "لِقُلُوبِكُمْ", "translit": "ْmُkِbwُlُqِl", "root": "قلب"}, {"id": 49, "arabic": "وَقُلُوبِهِنَّ", "translit": "َّnِhِbwُlُqَw", "root": "قلب"}, {"id": 50, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 51, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 52, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 53, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 54, "arabic": "تُؤْذُوا۟", "translit": "۟āwُhdْwʾُt", "root": "اذي"}, {"id": 55, "arabic": "رَسُولَ", "translit": "َlwُsَr", "root": "رسل"}, {"id": 56, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 57, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 58, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 59, "arabic": "تَنكِحُوٓا۟", "translit": "۟āٓwُḥِknَt", "root": "نكح"}, {"id": 60, "arabic": "أَزْوَٰجَهُۥ", "translit": "ۥُhَjgَٰwْzَaʾ", "root": "زوج"}, {"id": 61, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 62, "arabic": "بَعْدِهِۦٓ", "translit": "ٓۦِhِdْʿعَb", "root": "بعد"}, {"id": 63, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 64, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 65, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 66, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 67, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 68, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 69, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 54, "text": "إِن تُبْدُوا۟ شَيْـًٔا أَوْ تُخْفُوهُ فَإِنَّ ٱللَّهَ كَانَ بِكُلِّ شَىْءٍ عَلِيمًا ", "translation": "Whether you reveal a thing or conceal it, indeed Allāh is ever, of all things, Knowing.", "words": [{"id": 1, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 2, "arabic": "تُبْدُوا۟", "translit": "۟āwُdْbُt", "root": "بدو"}, {"id": 3, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "تُخْفُوهُ", "translit": "ُhwُfْhkُt", "root": "خفي"}, {"id": 6, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 9, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 10, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 11, "arabic": "عَلِيمًا", "translit": "āًmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 55, "text": "لَّا جُنَاحَ عَلَيْهِنَّ فِىٓ ءَابَآئِهِنَّ وَلَآ أَبْنَآئِهِنَّ وَلَآ إِخْوَٰنِهِنَّ وَلَآ أَبْنَآءِ إِخْوَٰنِهِنَّ وَلَآ أَبْنَآءِ أَخَوَٰتِهِنَّ وَلَا نِسَآئِهِنَّ وَلَا مَا مَلَكَتْ أَيْمَٰنُهُنَّۗ وَٱتَّقِينَ ٱللَّهَۚ إِنَّ ٱللَّهَ كَانَ عَلَىٰ كُلِّ شَىْءٍ شَهِيدًا ", "translation": "There is no blame upon them [i.e., women] concerning their fathers or their sons or their brothers or their brothers' sons or their sisters' sons or their women or those their right hands possess [i.e., slaves].[1] And fear Allāh. Indeed Allāh is ever, over all things, Witness.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 3, "arabic": "عَلَيْهِنَّ", "translit": "َّnِhْyَlَʿع", "root": ""}, {"id": 4, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 5, "arabic": "ءَابَآئِهِنَّ", "translit": "َّnِhِyʾٓāَbāَء", "root": "ابو"}, {"id": 6, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 7, "arabic": "أَبْنَآئِهِنَّ", "translit": "َّnِhِyʾٓāَnْbَaʾ", "root": "بني"}, {"id": 8, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 9, "arabic": "إِخْوَٰنِهِنَّ", "translit": "َّnِhِnَٰwْhkِiʾ", "root": "اخو"}, {"id": 10, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 11, "arabic": "أَبْنَآءِ", "translit": "ِءٓāَnْbَaʾ", "root": "بني"}, {"id": 12, "arabic": "إِخْوَٰنِهِنَّ", "translit": "َّnِhِnَٰwْhkِiʾ", "root": "اخو"}, {"id": 13, "arabic": "وَلَآ", "translit": "ٓāَlَw", "root": ""}, {"id": 14, "arabic": "أَبْنَآءِ", "translit": "ِءٓāَnْbَaʾ", "root": "بني"}, {"id": 15, "arabic": "أَخَوَٰتِهِنَّ", "translit": "َّnِhِtَٰwَhkَaʾ", "root": "اخو"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "نِسَآئِهِنَّ", "translit": "َّnِhِyʾٓāَsِn", "root": "نسو"}, {"id": 18, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 19, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 20, "arabic": "مَلَكَتْ", "translit": "ْtَkَlَm", "root": "ملك"}, {"id": 21, "arabic": "أَيْمَٰنُهُنَّ", "translit": "َّnُhُnَٰmْyَaʾ", "root": "يمن"}, {"id": 22, "arabic": "وَٱتَّقِينَ", "translit": "َnyِqَّtٱَw", "root": "وقي"}, {"id": 23, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 25, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 27, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 28, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 29, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 30, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}], "hasIhya": false}, {"ayah": 56, "text": "إِنَّ ٱللَّهَ وَمَلَٰٓئِكَتَهُۥ يُصَلُّونَ عَلَى ٱلنَّبِىِّۚ يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ صَلُّوا۟ عَلَيْهِ وَسَلِّمُوا۟ تَسْلِيمًا ", "translation": "Indeed, Allāh confers blessing upon the Prophet, and His angels [ask Him to do so]. O you who have believed, ask [Allāh to confer] blessing upon him and ask [Allāh to grant him] peace.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "وَمَلَٰٓئِكَتَهُۥ", "translit": "ۥُhَtَkِyʾَٰٓlَmَw", "root": "ملك"}, {"id": 4, "arabic": "يُصَلُّونَ", "translit": "َnwُّlَṣُy", "root": "صلو"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلنَّبِىِّ", "translit": "ِّàِbَّnlٱ", "root": "نبا"}, {"id": 7, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 10, "arabic": "صَلُّوا۟", "translit": "۟āwُّlَṣ", "root": "صلو"}, {"id": 11, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "وَسَلِّمُوا۟", "translit": "۟āwُmِّlَsَw", "root": "سلم"}, {"id": 13, "arabic": "تَسْلِيمًا", "translit": "āًmyِlْsَt", "root": "سلم"}], "hasIhya": true}, {"ayah": 57, "text": "إِنَّ ٱلَّذِينَ يُؤْذُونَ ٱللَّهَ وَرَسُولَهُۥ لَعَنَهُمُ ٱللَّهُ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِ وَأَعَدَّ لَهُمْ عَذَابًا مُّهِينًا ", "translation": "Indeed, those who abuse Allāh and His Messenger - Allāh has cursed them in this world and the Hereafter and prepared for them a humiliating punishment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يُؤْذُونَ", "translit": "َnwُhdْwʾُy", "root": "اذي"}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 6, "arabic": "لَعَنَهُمُ", "translit": "ُmُhَnَʿعَl", "root": "لعن"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 10, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 11, "arabic": "وَأَعَدَّ", "translit": "َّdَʿعَaʾَw", "root": "عدد"}, {"id": 12, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 13, "arabic": "عَذَابًا", "translit": "āًbāَhdَʿع", "root": "عذب"}, {"id": 14, "arabic": "مُّهِينًا", "translit": "āًnyِhُّm", "root": "هون"}], "hasIhya": false}, {"ayah": 58, "text": "وَٱلَّذِينَ يُؤْذُونَ ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِ بِغَيْرِ مَا ٱكْتَسَبُوا۟ فَقَدِ ٱحْتَمَلُوا۟ بُهْتَٰنًا وَإِثْمًا مُّبِينًا ", "translation": "And those who harm believing men and believing women for [something] other than what they have earned [i.e., deserved] have certainly borne upon themselves a slander and manifest sin.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُؤْذُونَ", "translit": "َnwُhdْwʾُy", "root": "اذي"}, {"id": 3, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 4, "arabic": "وَٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 5, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "ٱكْتَسَبُوا۟", "translit": "۟āwُbَsَtْkٱ", "root": "كسب"}, {"id": 8, "arabic": "فَقَدِ", "translit": "ِdَqَf", "root": ""}, {"id": 9, "arabic": "ٱحْتَمَلُوا۟", "translit": "۟āwُlَmَtْḥٱ", "root": "حمل"}, {"id": 10, "arabic": "بُهْتَٰنًا", "translit": "āًnَٰtْhُb", "root": "بهت"}, {"id": 11, "arabic": "وَإِثْمًا", "translit": "āًmْhtِiʾَw", "root": "اثم"}, {"id": 12, "arabic": "مُّبِينًا", "translit": "āًnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 59, "text": "يَٰٓأَيُّهَا ٱلنَّبِىُّ قُل لِّأَزْوَٰجِكَ وَبَنَاتِكَ وَنِسَآءِ ٱلْمُؤْمِنِينَ يُدْنِينَ عَلَيْهِنَّ مِن جَلَٰبِيبِهِنَّۚ ذَٰلِكَ أَدْنَىٰٓ أَن يُعْرَفْنَ فَلَا يُؤْذَيْنَۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًا ", "translation": "O Prophet, tell your wives and your daughters and the women of the believers to bring down over themselves [part] of their outer garments.[1] That is more suitable that they will be known[2] and not be abused. And ever is Allāh Forgiving and Merciful.[3]", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّبِىُّ", "translit": "ُّàِbَّnlٱ", "root": "نبا"}, {"id": 3, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 4, "arabic": "لِّأَزْوَٰجِكَ", "translit": "َkِjgَٰwْzَaʾِّl", "root": "زوج"}, {"id": 5, "arabic": "وَبَنَاتِكَ", "translit": "َkِtāَnَbَw", "root": "بني"}, {"id": 6, "arabic": "وَنِسَآءِ", "translit": "ِءٓāَsِnَw", "root": "نسو"}, {"id": 7, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 8, "arabic": "يُدْنِينَ", "translit": "َnyِnْdُy", "root": "دنو"}, {"id": 9, "arabic": "عَلَيْهِنَّ", "translit": "َّnِhْyَlَʿع", "root": ""}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "جَلَٰبِيبِهِنَّ", "translit": "َّnِhِbyِbَٰlَjg", "root": "جلب"}, {"id": 12, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 13, "arabic": "أَدْنَىٰٓ", "translit": "ٰٓàَnْdَaʾ", "root": "دنو"}, {"id": 14, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 15, "arabic": "يُعْرَفْنَ", "translit": "َnْfَrْʿعُy", "root": "عرف"}, {"id": 16, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 17, "arabic": "يُؤْذَيْنَ", "translit": "َnْyَhdْwʾُy", "root": "اذي"}, {"id": 18, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 19, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 21, "arabic": "رَّحِيمًا", "translit": "āًmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 60, "text": "لَّئِن لَّمْ يَنتَهِ ٱلْمُنَٰفِقُونَ وَٱلَّذِينَ فِى قُلُوبِهِم مَّرَضٌ وَٱلْمُرْجِفُونَ فِى ٱلْمَدِينَةِ لَنُغْرِيَنَّكَ بِهِمْ ثُمَّ لَا يُجَاوِرُونَكَ فِيهَآ إِلَّا قَلِيلًا ", "translation": "If the hypocrites and those in whose hearts is disease[1] and those who spread rumors in al-Madīnah do not cease, We will surely incite you against them; then they will not remain your neighbors therein except for a little,", "words": [{"id": 1, "arabic": "لَّئِن", "translit": "nِyʾَّl", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 3, "arabic": "يَنتَهِ", "translit": "ِhَtnَy", "root": "نهي"}, {"id": 4, "arabic": "ٱلْمُنَٰفِقُونَ", "translit": "َnwُqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 5, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "قُلُوبِهِم", "translit": "mِhِbwُlُq", "root": "قلب"}, {"id": 8, "arabic": "مَّرَضٌ", "translit": "ٌḍَrَّm", "root": "مرض"}, {"id": 9, "arabic": "وَٱلْمُرْجِفُونَ", "translit": "َnwُfِjgْrُmْlٱَw", "root": "رجف"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْمَدِينَةِ", "translit": "ِẗَnyِdَmْlٱ", "root": "مدن"}, {"id": 12, "arabic": "لَنُغْرِيَنَّكَ", "translit": "َkَّnَyِrْغُnَl", "root": "غرو"}, {"id": 13, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 14, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "يُجَاوِرُونَكَ", "translit": "َkَnwُrِwāَjgُy", "root": "جور"}, {"id": 17, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 18, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 19, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}], "hasIhya": false}, {"ayah": 61, "text": "مَّلْعُونِينَۖ أَيْنَمَا ثُقِفُوٓا۟ أُخِذُوا۟ وَقُتِّلُوا۟ تَقْتِيلًا ", "translation": "Accursed wherever they are found, [being] seized and massacred completely.", "words": [{"id": 1, "arabic": "مَّلْعُونِينَ", "translit": "َnyِnwُʿعْlَّm", "root": "لعن"}, {"id": 2, "arabic": "أَيْنَمَا", "translit": "āَmَnْyَaʾ", "root": ""}, {"id": 3, "arabic": "ثُقِفُوٓا۟", "translit": "۟āٓwُfِqُht", "root": "ثقف"}, {"id": 4, "arabic": "أُخِذُوا۟", "translit": "۟āwُhdِhkُaʾ", "root": "اخذ"}, {"id": 5, "arabic": "وَقُتِّلُوا۟", "translit": "۟āwُlِّtُqَw", "root": "قتل"}, {"id": 6, "arabic": "تَقْتِيلًا", "translit": "āًlyِtْqَt", "root": "قتل"}], "hasIhya": false}, {"ayah": 62, "text": "سُنَّةَ ٱللَّهِ فِى ٱلَّذِينَ خَلَوْا۟ مِن قَبْلُۖ وَلَن تَجِدَ لِسُنَّةِ ٱللَّهِ تَبْدِيلًا ", "translation": "[This is] the established way of Allāh with those who passed on before; and you will not find in the way of Allāh any change.", "words": [{"id": 1, "arabic": "سُنَّةَ", "translit": "َẗَّnُs", "root": "سنن"}, {"id": 2, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "خَلَوْا۟", "translit": "۟āْwَlَhk", "root": "خلو"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 8, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 9, "arabic": "تَجِدَ", "translit": "َdِjgَt", "root": "وجد"}, {"id": 10, "arabic": "لِسُنَّةِ", "translit": "ِẗَّnُsِl", "root": "سنن"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "تَبْدِيلًا", "translit": "āًlyِdْbَt", "root": "بدل"}], "hasIhya": true}, {"ayah": 63, "text": "يَسْـَٔلُكَ ٱلنَّاسُ عَنِ ٱلسَّاعَةِۖ قُلْ إِنَّمَا عِلْمُهَا عِندَ ٱللَّهِۚ وَمَا يُدْرِيكَ لَعَلَّ ٱلسَّاعَةَ تَكُونُ قَرِيبًا ", "translation": "People ask you concerning the Hour. Say, \"Knowledge of it is only with Allāh. And what may make you perceive? Perhaps the Hour is near.\"", "words": [{"id": 1, "arabic": "يَسْـَٔلُكَ", "translit": "َkُlَٔـْsَy", "root": "سال"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 4, "arabic": "ٱلسَّاعَةِ", "translit": "ِẗَʿعāَّslٱ", "root": "سوع"}, {"id": 5, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 6, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 7, "arabic": "عِلْمُهَا", "translit": "āَhُmْlِʿع", "root": "علم"}, {"id": 8, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 11, "arabic": "يُدْرِيكَ", "translit": "َkyِrْdُy", "root": "دري"}, {"id": 12, "arabic": "لَعَلَّ", "translit": "َّlَʿعَl", "root": ""}, {"id": 13, "arabic": "ٱلسَّاعَةَ", "translit": "َẗَʿعāَّslٱ", "root": "سوع"}, {"id": 14, "arabic": "تَكُونُ", "translit": "ُnwُkَt", "root": "كون"}, {"id": 15, "arabic": "قَرِيبًا", "translit": "āًbyِrَq", "root": "قرب"}], "hasIhya": true}, {"ayah": 64, "text": "إِنَّ ٱللَّهَ لَعَنَ ٱلْكَٰفِرِينَ وَأَعَدَّ لَهُمْ سَعِيرًا ", "translation": "Indeed, Allāh has cursed the disbelievers and prepared for them a Blaze.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَعَنَ", "translit": "َnَʿعَl", "root": "لعن"}, {"id": 4, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}, {"id": 5, "arabic": "وَأَعَدَّ", "translit": "َّdَʿعَaʾَw", "root": "عدد"}, {"id": 6, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 7, "arabic": "سَعِيرًا", "translit": "āًryِʿعَs", "root": "سعر"}], "hasIhya": false}, {"ayah": 65, "text": "خَٰلِدِينَ فِيهَآ أَبَدًاۖ لَّا يَجِدُونَ وَلِيًّا وَلَا نَصِيرًا ", "translation": "Abiding therein forever, they will not find a protector or a helper.", "words": [{"id": 1, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 2, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 3, "arabic": "أَبَدًا", "translit": "āًdَbَaʾ", "root": "ابد"}, {"id": 4, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 5, "arabic": "يَجِدُونَ", "translit": "َnwُdِjgَy", "root": "وجد"}, {"id": 6, "arabic": "وَلِيًّا", "translit": "āًّyِlَw", "root": "ولي"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "نَصِيرًا", "translit": "āًryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 66, "text": "يَوْمَ تُقَلَّبُ وُجُوهُهُمْ فِى ٱلنَّارِ يَقُولُونَ يَٰلَيْتَنَآ أَطَعْنَا ٱللَّهَ وَأَطَعْنَا ٱلرَّسُولَا۠ ", "translation": "The Day their faces will be turned about in the Fire, they will say, \"How we wish we had obeyed Allāh and obeyed the Messenger.\"", "words": [{"id": 1, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 2, "arabic": "تُقَلَّبُ", "translit": "ُbَّlَqُt", "root": "قلب"}, {"id": 3, "arabic": "وُجُوهُهُمْ", "translit": "ْmُhُhwُjgُw", "root": "وجه"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 6, "arabic": "يَقُولُونَ", "translit": "َnwُlwُqَy", "root": "قول"}, {"id": 7, "arabic": "يَٰلَيْتَنَآ", "translit": "ٓāَnَtْyَlَٰy", "root": ""}, {"id": 8, "arabic": "أَطَعْنَا", "translit": "āَnْʿعَṭَaʾ", "root": "طوع"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَأَطَعْنَا", "translit": "āَnْʿعَṭَaʾَw", "root": "طوع"}, {"id": 11, "arabic": "ٱلرَّسُولَا۠", "translit": "۠āَlwُsَّrlٱ", "root": "رسل"}], "hasIhya": true}, {"ayah": 67, "text": "وَقَالُوا۟ رَبَّنَآ إِنَّآ أَطَعْنَا سَادَتَنَا وَكُبَرَآءَنَا فَأَضَلُّونَا ٱلسَّبِيلَا۠ ", "translation": "And they will say, \"Our Lord, indeed we obeyed our masters and our dignitaries,[1] and they led us astray from the [right] way.", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 3, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 4, "arabic": "أَطَعْنَا", "translit": "āَnْʿعَṭَaʾ", "root": "طوع"}, {"id": 5, "arabic": "سَادَتَنَا", "translit": "āَnَtَdāَs", "root": "سود"}, {"id": 6, "arabic": "وَكُبَرَآءَنَا", "translit": "āَnَءٓāَrَbُkَw", "root": "كبر"}, {"id": 7, "arabic": "فَأَضَلُّونَا", "translit": "āَnwُّlَḍَaʾَf", "root": "ضلل"}, {"id": 8, "arabic": "ٱلسَّبِيلَا۠", "translit": "۠āَlyِbَّslٱ", "root": "سبل"}], "hasIhya": false}, {"ayah": 68, "text": "رَبَّنَآ ءَاتِهِمْ ضِعْفَيْنِ مِنَ ٱلْعَذَابِ وَٱلْعَنْهُمْ لَعْنًا كَبِيرًا ", "translation": "Our Lord, give them double the punishment and curse them with a great curse.\"", "words": [{"id": 1, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "ءَاتِهِمْ", "translit": "ْmِhِtāَء", "root": "اتي"}, {"id": 3, "arabic": "ضِعْفَيْنِ", "translit": "ِnْyَfْʿعِḍ", "root": "ضعف"}, {"id": 4, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 5, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 6, "arabic": "وَٱلْعَنْهُمْ", "translit": "ْmُhْnَʿعْlٱَw", "root": "لعن"}, {"id": 7, "arabic": "لَعْنًا", "translit": "āًnْʿعَl", "root": "لعن"}, {"id": 8, "arabic": "كَبِيرًا", "translit": "āًryِbَk", "root": "كبر"}], "hasIhya": false}, {"ayah": 69, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَكُونُوا۟ كَٱلَّذِينَ ءَاذَوْا۟ مُوسَىٰ فَبَرَّأَهُ ٱللَّهُ مِمَّا قَالُوا۟ۚ وَكَانَ عِندَ ٱللَّهِ وَجِيهًا ", "translation": "O you who have believed, be not like those who abused Moses; then Allāh cleared him of what they said. And he, in the sight of Allāh, was distinguished.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 6, "arabic": "كَٱلَّذِينَ", "translit": "َnyِhdَّlٱَk", "root": ""}, {"id": 7, "arabic": "ءَاذَوْا۟", "translit": "۟āْwَhdāَء", "root": "اذي"}, {"id": 8, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 9, "arabic": "فَبَرَّأَهُ", "translit": "ُhَaʾَّrَbَf", "root": "برا"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 12, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 13, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 14, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "وَجِيهًا", "translit": "āًhyِjgَw", "root": "وجه"}], "hasIhya": false}, {"ayah": 70, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَقُولُوا۟ قَوْلًا سَدِيدًا ", "translation": "O you who have believed, fear Allāh and speak words of appropriate justice.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَقُولُوا۟", "translit": "۟āwُlwُqَw", "root": "قول"}, {"id": 7, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 8, "arabic": "سَدِيدًا", "translit": "āًdyِdَs", "root": "سدد"}], "hasIhya": true}, {"ayah": 71, "text": "يُصْلِحْ لَكُمْ أَعْمَٰلَكُمْ وَيَغْفِرْ لَكُمْ ذُنُوبَكُمْۗ وَمَن يُطِعِ ٱللَّهَ وَرَسُولَهُۥ فَقَدْ فَازَ فَوْزًا عَظِيمًا ", "translation": "He will [then] amend for you your deeds and forgive you your sins. And whoever obeys Allāh and His Messenger has certainly attained a great attainment.", "words": [{"id": 1, "arabic": "يُصْلِحْ", "translit": "ْḥِlْṣُy", "root": "صلح"}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "أَعْمَٰلَكُمْ", "translit": "ْmُkَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 4, "arabic": "وَيَغْفِرْ", "translit": "ْrِfْغَyَw", "root": "غفر"}, {"id": 5, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 6, "arabic": "ذُنُوبَكُمْ", "translit": "ْmُkَbwُnُhd", "root": "ذنب"}, {"id": 7, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 8, "arabic": "يُطِعِ", "translit": "ِʿعِṭُy", "root": "طوع"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "وَرَسُولَهُۥ", "translit": "ۥُhَlwُsَrَw", "root": "رسل"}, {"id": 11, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 12, "arabic": "فَازَ", "translit": "َzāَf", "root": "فوز"}, {"id": 13, "arabic": "فَوْزًا", "translit": "āًzْwَf", "root": "فوز"}, {"id": 14, "arabic": "عَظِيمًا", "translit": "āًmyِẓَʿع", "root": "عظم"}], "hasIhya": true}, {"ayah": 72, "text": "إِنَّا عَرَضْنَا ٱلْأَمَانَةَ عَلَى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱلْجِبَالِ فَأَبَيْنَ أَن يَحْمِلْنَهَا وَأَشْفَقْنَ مِنْهَا وَحَمَلَهَا ٱلْإِنسَٰنُۖ إِنَّهُۥ كَانَ ظَلُومًا جَهُولًا ", "translation": "Indeed, We offered the Trust[1] to the heavens and the earth and the mountains, and they declined to bear it and feared it; but man [undertook to] bear it. Indeed, he was unjust and ignorant.[2]", "words": [{"id": 1, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 2, "arabic": "عَرَضْنَا", "translit": "āَnْḍَrَʿع", "root": "عرض"}, {"id": 3, "arabic": "ٱلْأَمَانَةَ", "translit": "َẗَnāَmَaʾْlٱ", "root": "امن"}, {"id": 4, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 5, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 6, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 7, "arabic": "وَٱلْجِبَالِ", "translit": "ِlāَbِjgْlٱَw", "root": "جبل"}, {"id": 8, "arabic": "فَأَبَيْنَ", "translit": "َnْyَbَaʾَf", "root": "ابي"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يَحْمِلْنَهَا", "translit": "āَhَnْlِmْḥَy", "root": "حمل"}, {"id": 11, "arabic": "وَأَشْفَقْنَ", "translit": "َnْqَfْhsَaʾَw", "root": "شفق"}, {"id": 12, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 13, "arabic": "وَحَمَلَهَا", "translit": "āَhَlَmَḥَw", "root": "حمل"}, {"id": 14, "arabic": "ٱلْإِنسَٰنُ", "translit": "ُnَٰsnِiʾْlٱ", "root": "انس"}, {"id": 15, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 16, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 17, "arabic": "ظَلُومًا", "translit": "āًmwُlَẓ", "root": "ظلم"}, {"id": 18, "arabic": "جَهُولًا", "translit": "āًlwُhَjg", "root": "جهل"}], "hasIhya": true}, {"ayah": 73, "text": "لِّيُعَذِّبَ ٱللَّهُ ٱلْمُنَٰفِقِينَ وَٱلْمُنَٰفِقَٰتِ وَٱلْمُشْرِكِينَ وَٱلْمُشْرِكَٰتِ وَيَتُوبَ ٱللَّهُ عَلَى ٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَٰتِۗ وَكَانَ ٱللَّهُ غَفُورًا رَّحِيمًۢا ", "translation": "[It[1] was] so that Allāh may punish the hypocrite men and hypocrite women and the men and women who associate others with Him and that Allāh may accept repentance from the believing men and believing women. And ever is Allāh Forgiving and Merciful.", "words": [{"id": 1, "arabic": "لِّيُعَذِّبَ", "translit": "َbِّhdَʿعُyِّl", "root": "عذب"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلْمُنَٰفِقِينَ", "translit": "َnyِqِfَٰnُmْlٱ", "root": "نفق"}, {"id": 4, "arabic": "وَٱلْمُنَٰفِقَٰتِ", "translit": "ِtَٰqِfَٰnُmْlٱَw", "root": "نفق"}, {"id": 5, "arabic": "وَٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱَw", "root": "شرك"}, {"id": 6, "arabic": "وَٱلْمُشْرِكَٰتِ", "translit": "ِtَٰkِrْhsُmْlٱَw", "root": "شرك"}, {"id": 7, "arabic": "وَيَتُوبَ", "translit": "َbwُtَyَw", "root": "توب"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 10, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}, {"id": 11, "arabic": "وَٱلْمُؤْمِنَٰتِ", "translit": "ِtَٰnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 12, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "غَفُورًا", "translit": "āًrwُfَغ", "root": "غفر"}, {"id": 15, "arabic": "رَّحِيمًۢا", "translit": "āًۢmyِḥَّr", "root": "رحم"}], "hasIhya": false}], "tafsir": {"4": [{"arabic": "يجتمعان في قلب وما جعل الله لرجل من قلبين في جوفه وأما عمل القلب فالغاية القصوى عمارته بالأخلاق المحمودة والعقائد المشروعة ولن يتصف بها ما لم ينظف عن نقائضها من العقائد الفاسدة والرذائل الممقوتة فتطهيره أحد الشطرين وهو الشطر الأول الذي هو شرط في الثاني فكان الطهور شطر الإيمان بهذا المعنى وكذلك تطهير الجوارح عن المناهي أحد الشطرين وهو الشطر الأول الذي هو شرط في الثاني فتطهيره أحد الشطرين وهو الشطر الأول وعمارتها بالطاعات الشطر الثاني فهذه مقامات الإيمان ولكل مقام طبقة ولن ينال العبد الطبقة ا", "english": "The Prophet, peace be upon him, said: \"Religion is built upon cleanliness.\" And he said, peace be upon him: \"The key to prayer is purification.\" And God Most High said: {فِيهِ رِجَالٌ يُحِبُّونَ أَن يَتَطَهَّرُوا وَاللَّهُ يُحِبُّ الْمُطَّهِّرِينَ} — \"In it are men who love to purify themselves, and God loves those who purify themselves.\" And the Prophet, peace be upon him, said: \"Purification is half of faith.\" And God Most High said: {مَا يُرِيدُ اللَّهُ لِيَجْعَلَ عَلَيْكُم مِّنْ حَرَجٍ وَلَكِن يُرِيدُ لِيُطَهِّرَكُمْ} — \"God does not intend to place upon you any hardship, but He intends to purify you.\"", "book_title": "Mysteries of Purity", "section_title_ar": "Section 106", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 106: On the True Meaning of Purification and Its Four Ranks", "section_index": 106, "anchors": "- Root: ط-ه-ر (ṭahara)\n  * Lisān / ʿAyn: The root denotes cleanliness, purity, and freedom from filth—both physical and spiritual. Al-Farāhīdī records its core sense as the removal of that which is defiling.\n  * Al-Rāghib (Mufradāt): \"الطهارة ضربان: طهارة جسم، وطهارة نفس\" — Purification is of two kinds: purification of the body and purification of the soul. The Quranic verses (e.g., {وَإِن كُنتُم جُنُبًا فَاطَّهَّرُوا}) are carried upon both senses, with the physical serving as the vehicle for the spiritual.\n  * Al-Zamakhsharī (Asās): Literal (ḥaqīqah): washing with water. Metaphorical (majāz): \"تطهر من الإثم: تنزه منه\" — purification from sin is self-exculpation; \"التوبة طهور للمذنب\" — repentance is a purification for the sinner. The prophetic dictum \"الطهور نصف الإيمان\" operates on the metaphorical axis, for the \"half\" of faith is the cleansing of the inner self.\n- Root: س-ر-ر (sirr)\n  * Lisān / ʿAyn: The innermost secret, the hidden depth of the self; that which is concealed from public view.\n  * Al-Rāghib (Mufradāt): The \"secret\" (sirr) is the innermost faculty of the heart where divine knowledge (maʿrifah) is unveiled; it is the locus of the soul's encounter with God.\n  * Al-Zamakhsharī (Asās): Literal: a concealed matter. Metaphorical: the spiritual core (al-latīfah al-rabbāniyyah) that must be emptied of all save God.\n- Root: ق-ل-ب (qalb)\n  * Al-Rāghib (Mufradāt): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — The heart is so named because of its constant turning (taqallub) and fluctuation between states. It is the seat of both the blameworthy traits (akhlāq madhmūmah) and the praiseworthy ones (akhlāq maḥmūdah).\n  * Al-Zamakhsharī (Asās): Literal: the physical organ. Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — the heart as the faculty of discernment and moral disposition.\n- Sībawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The phrase \"إنما بني الدين على النظافة\" restricts the foundation of religion to purification, requiring the interpreter to determine which sense of \"purification\" (physical or spiritual) constitutes the true foundation, given the prophetic context.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Purity'", "badge": "Insight"}, {"arabic": "والوطن فإن العلائق شاغلة وصارفة ما جعل الله لرجل من قلبين في جوفه ومهما توزعت الفكرة قصرت عن درك الحقائق ولذلك قيل العلم لا يعطيك بعضه حتى تعطيك كلك فإذا أعطيته كلك فأنت من إعطائه إياك بعضه على خطر والفكرة المتوزعة على أمور متفرقة كجدول تفرق ماؤه فنشفت الأرض بعضه واختطف الهواء بعضه فلا يبقى منه ما يجتمع ويبلغ المزدرع الوظيفة الثالثة أن لا يتكبر على العلم ولا يتأمر على معلم بل يلقي إليه زمام أمره بالكلية في كل تفصيل ويذعن لنصيحته إذعان المريض الجاهل للطبيب المشفق الحاذق وينبغي أن يتواضع لمعلمه ويطلب الثواب والشرف بخ", "english": "Ibn Masʿūd — may God be pleased with him — said: \"Knowledge is not abundance of narration; rather, knowledge is a light cast into the heart.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 41", "section_title_en": "The Revival of the Religious Sciences — Section 41: On the Etiquette of the Seeker of Knowledge (Continued)", "section_index": 41, "anchors": "- Root: عبر (ʿ-b-r)\n  * Lisan / Ayn: The root denotes crossing over from one state or place to another; ʿibrah ( عبرة) is the lesson derived by crossing from a witnessed event to its underlying significance.\n  * Al-Raghib (Mufradat): ʿIbarah is the act of interpreting a vision by passing from its sensory form to its inner meaning; the ʿābir (interpreter) traverses from the apparent to the real.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): physical crossing of a river or road. Metaphorical (majāz): the soul's transit from another's misfortune to recognition of one's own vulnerability — a praised ʿibrah.\n- Root: صور (ṣ-w-r)\n  * Lisan / Ayn: Ṣūrah is the form or figure by which a thing is distinguished from others.\n  * Al-Raghib (Mufradat): Two types of ṣūrah: (1) sensory, perceived by the common and elite alike; (2) intellectual, perceived only by the elite — e.g., the rational form distinguishing man. The Quranic {«ثُمَّ صَوَّرْنَاكُمْ»} (Al-Aʿraf: 11) alludes to both.\n  * Al-Zamakhshari (Asas): Literal: physical shape or inclination of the neck. Metaphorical: the inner moral form — \"he is pictured with virtues\" — and the eschatological transformation where one is resurrected according to one's spiritual form.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; also the act of turning, overturning, and transforming a thing from one state to another.\n  * Al-Raghib (Mufradat): Qalb al-shayʾ: to turn a thing about, to redirect it from one face to another. The heart is so named for its constant fluctuation (taqallub) of states.\n  * Al-Zamakhshari (Asas): Literal: to flip a garment or overturn a vessel. Metaphorical: \"the teacher turned the boys\" (sent them home); \"the merchant turned the goods\" (scrutinized them). The heart filled with wrath is \"a dog in meaning, a heart in form.\"\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: ʿIlm is the comprehension of a thing as it truly is; its marks (maʿālim) are the traces by which one is guided.\n  * Al-Raghib (Mufradat): ʿIlm is of two kinds: (1) apprehension of a thing's essence (perception of the object itself); (2) judgment upon a thing affirming or denying something of it. True knowledge is that which transforms the knower.\n  * Al-Zamakhshari (Asas): Literal: knowledge as information. Metaphorical: \"he is a sign (ʿalam) of knowledge\" — a towering landmark. The saying of Ibn Masʿūd: \"Knowledge is not abundance of narration; rather, knowledge is a light cast into the heart\" — indicating that true ʿilm is an illuminative, transformative reality, not accumulated reports.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts the predicate exclusively to the subject, negating all else. Applied in the prophetic saying and the scholars' dicta: \"Knowledge is only fear\" — i.e., true knowledge is exclusively that which engenders reverent awe of God, nothing else.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "7": [{"arabic": "فقال عز وجل وإذ أخذنا من النبيين ميثاقهم ومنك ومن نوح وإبراهيم الآية بأبي أنت وأمي يا رسول الله لقد بلغ من فضيلتك عنده أن أهل النار يودون أن يكونوا قد أطاعوك وهم بين أطباقها يعذبون يقولون يا ليتنا أطعنا الله وأطعنا الرسولا بأبي أنت وأمي يا رسول الله لئن كان موسى بن عمران أعطاه الله حجرا تنفجر منه الأنهار فماذا بأعجب من أصابعك حين نبع منها الماء صلى الله عليك بأبي أنت وأمي يا رسول الله لئن كان سليمان بن داود أعطاه الله الريح غدوها شهر ورواحها شهر فماذا بأعجب من البراق حين سريت عليه إلى السماء السابع", "english": "God Most High has said: {«Indeed, God and His angels send blessings upon the Prophet. O you who have believed, send blessings upon him and greet him with a greeting of peace»} (Q. 33:56). And it is related that he, peace be upon him, came one day with the signs of glad tidings visible upon his face, and he, peace be upon him, said: \"Gabriel came to me, peace be upon him, and said: 'Are you not pleased, O Muhammad, that no one from your community sends a single blessing upon you except that I send ten blessings upon him, and no one from your community greets you with peace except that I greet him with peace ten times?'\" (1) And he, peace be upon him, said: \"Whoever sends blessings upon me, the angels send blessings upon him as long as he continues to send blessings upon me — so let him reduce or increase at that.\" (2) And he, peace be upon him, said: \"The people most deserving of me are those who send the most blessings upon me.\" (3) And he, peace be upon him, said: \"It suffices a believer for miserliness that I am mentioned in his presence and he does not send blessings upon me.\" (4) And he, peace be upon him, said: \"Multiply your sending of blessings upon me on the day of Friday.\" (5) And he, peace be upon him, said: \"Whoever sends blessings upon me from my community, ten good deeds are written for him and ten evil deeds are erased from him.\" (6) And he, peace be upon him, said: \"Whoever says upon hearing the call to prayer and the iqāmah: 'O God, Lord of this perfect call and the established prayer, send blessings upon Muhammad, Your servant and Your Messenger, and grant him the means (al-wasīlah) and the excellence (al-faḍīlah) and the lofty rank (al-darajah al-rafīʿah) and the intercession (al-shafāʿah) on the Day of Resurrection' — my intercession becomes permissible for him.\" (7) And the Messenger of God, peace be upon him, said: \"Whoever sends blessings upon me in a book, the angels continue to seek forgiveness for him as long as my name remains in that book.\" (8) And he, peace be upon him, said: \"Indeed, upon the earth there are traveling angels who convey to me the greetings of peace from my community.\" (9) And he, peace be upon him, said: \"No one greets me with peace except that God returns my soul to me until I respond to his greeting.\" (1) And it was said to him: \"O Messenger of God, how do we send blessings upon you?\" He said: \"Say: 'O God, send blessings upon Muhammad, Your servant, and upon his family, his wives, and his descendants, as You sent blessings upon Abraham and the family of Abraham; and bless Muhammad, his wives, and his descendants, as You blessed Abraham and the family of Abraham. Indeed, You are Praiseworthy, Glorious.'\" (2)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 244", "section_title_en": "Section 244 — On the Virtues of Invoking Blessings upon the Prophet (Ṣalawāt) and the Excellence of His Rank", "section_index": 244, "anchors": "- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: Core root denotes prayer, blessing, supplication; al-ṣalāh from God is mercy (raḥmah), from angels is seeking forgiveness (istighfār), from believers is supplication (duʿā').\n  * Al-Raghib (Mufradat): Al-ṣalāh from God is pure mercy and beneficence; from angels it is their petition for forgiveness; from humans it is humble supplication. The divine ṣalāh upon the Prophet is an elevation of his mention and an increase in his honor.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): supplication and bending in worship. Metaphorical (majāz): God's ṣalāh upon the Prophet is His mercy and His exaltation of him before the angels; the believers' ṣalāh is their invocation and reverence.\n- Root: سلم (S-L-M)\n  * Lisan / Ayn: Root denotes safety, peace, deliverance; taslīm is the greeting of peace and submission.\n  * Al-Raghib (Mufradat): Salām from God is His safeguarding; the greeting of salām upon the Prophet is an acknowledgment of his prophetic rank and a prayer for his perfect safety.\n  * Al-Zamakhshari (Asas): Literal: greeting of peace. Metaphorical: the angels' conveyance of the believers' salām to the Prophet even after his death, indicating the enduring bond.\n- Root: حمد (Ḥ-M-D)\n  * Lisan / Ayn: Core root denotes praise, commendation; maḥmūd is the one praised.\n  * Al-Raghib (Mufradat): Ḥamd is praise for voluntary beneficence; al-ḥamd li-Llāh encompasses all praise due to God's perfect attributes.\n  * Al-Zamakhshari (Asas): Literal: to praise for good. Metaphorical: to find praiseworthy (aḥmadtu al-arḍ: I found the land agreeable).\n- Sibawayh Rule: Rule of Interposition (al-faṣl bayna al-jār wa al-majrūr) — The periodic structure of the ḥadīth reports here follows the canonical pattern of embedding quoted speech within narrative frames, maintaining syntactic cohesion across multiple levels of reported discourse.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'On Invocations and Supplications'", "badge": "Afterlife"}], "8": [{"arabic": "فقال قول الحق والعمل بالصدق (1) وعن الجنيد في قوله تعالى {ليسأل الصادقين عن صدقهم} قال يسأل الصادقين عند أنفسهم عن صدقهم عند ربهم وهذا أمر على خطر", "english": "God Most High has said: {«رجال صدقوا ما عاهدوا الله عليه»} — \"Among the believers are men who have been true to the covenant they made with God\" (Al-Aḥzāb 33:23). And the Prophet, peace and blessings be upon him, said: \"Verily, truthfulness leads to righteousness (al-birr), and righteousness leads to Paradise. And verily, a man continues to speak truthfully until he is written with God as a supremely veracious one (ṣiddīq). And verily, falsehood leads to wickedness (al-fujūr), and wickedness leads to the Fire. And verily, a man continues to lie until he is written with God as a liar (kadhdhāb).\" (1)", "book_title": "Fear and Hope", "section_title_ar": "Section 1226", "section_title_en": "The Book of Truthfulness (Ṣidq): Its Virtue and Reality — Section on the Virtue of Truthfulness", "section_index": 1226, "anchors": "- Root: صدق (Ṣ-D-Q)\n  * Lisan / Ayn: Core root denotes the firmness and soundness of a thing; a spear termed \"ṣadq\" is straight and rigid; truthfulness is speech that is firm, sound, and free of crookedness.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truthfulness and falsehood originate in speech, whether past or future, promise or otherwise; they occur by primary intent only in informative statements (khabar), not in other speech categories. Al-Raghib further notes the derived degrees: ṣidq (truthfulness), ṣiddīq (the supremely veracious — one whose truthfulness has become his very character), and ṣādiq al-waʿd (truthful in promise).\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"صدقته الحديث\" — to affirm someone's report as true. Majaz (metaphorical): \"رجل صادق الحملة\" — a man truthful in his charge (i.e., steadfast and unfaltering in battle), and \"فرس ذو مصدق في الجري\" — a horse with genuine exertion in running. Thus ṣidq extends metaphorically to any state of firmness, steadfastness, and correspondence between inner conviction and outward action.\n- Root: بر (B-R-R)\n  * Lisan / Ayn: Al-Birr: expansive goodness, piety, and obedience; the \"barr\" (land) is so named for its expanse. It encompasses all acts of righteousness and kindness.\n  * Al-Raghib (Mufradat): Al-birr is the breadth of obedience to God through sincere intention and righteous action; it is the comprehensive term for all that God loves and approves.\n- Root: فجر (F-J-R)\n  * Lisan / Ayn: Al-Fujūr: the breaking forth and bursting open — the wickedness that breaks through the barrier of piety; the \"fājir\" is one who bursts out of obedience into transgression.\n  * Al-Raghib (Mufradat): Fujūr is the violation of the covenant of obedience, the breaking open of the seal of God-consciousness; it is the opposite of birr.\n- Root: كذب (K-DH-B)\n  * Lisan / Ayn: Al-Kidhb: falsehood — informing of a thing contrary to its reality; the root also carries the sense of deficiency and weakness (as in \"kadhaba\" — to fall short).\n  * Al-Raghib (Mufradat): Falsehood is the counterpart of ṣidq — it is reporting what does not correspond to reality, whether in past, present, or future tense.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The grammatical structure \"يكتب عند الله صديقا\" (he is written with God as a ṣiddīq) involves the prepositional phrase \"عند الله\" interposed between the verb and its predicate accusative, a construction permissible when the interposed element is semantically integral to the judgment, as here where divine decree is the ground of the designation.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Fear and Hope'", "badge": "Hadith"}], "9": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "21": [{"arabic": "قال الله تعالى لقد كان لكم في رسول الله أسوة حسنة فأنتم بمن تأسيتم أبرسول الله صلى الله عليه وسلم أم بفرعون أول من بنى بالجص والآجر فخلوا عنه وتركوه فهذه حكاية حاتم الأصم رحمه الله تعالى وسيأتي من سيرة السلف في البذاذة وترك التجمل ما يشهد لذلك في مواضعه والتحقيق فيه أن التزين بالمباح ليس بحرام ولكن الخوض فيه يوجب الأنس به حتى يشق تركه واستدامة الزينة لا تمكن إلا بمباشرة أسباب في الغالب يلزم من مراعاتها ارتكاب المعاصي من المداهنة ومراعاة الخلق ومراءاتهم وأمور أخر هي محظورة والحزم اجتناب ذلك لأن من خاض", "english": "...that he intended that (i.e., the debate) rather than formal learning. So he entered his house and did not come out to the people for forty days. When Hātim entered Baghdad, the people of Baghdad gathered around him and said: \"O Abā ʿAbd al-Raḥmān, you are a man, but you are a foreigner (aʿjamī), and no one speaks with you except that you cut him off (in argument).\" He said: \"I have three traits (khiṣāl) by which I overcome my opponent: I rejoice when my opponent is correct, I grieve when he errs, and I guard myself from acting ignorantly toward him.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 55", "section_title_en": "The Story of Hātim al-Aṣamm and the Letter of Mālik ibn Anas — On Renunciation of Worldly Adornment", "section_index": 55, "anchors": "- Root: ع-ج-م (ʿ-j-m)\n  * Lisan / Ayn: The core meaning denotes one who is non-Arab, or one whose speech is unclear/ungrammatical; also used for the unintelligible.\n  * Al-Raghib (Mufradat): In theological contexts, it distinguishes the foreigner (aʿjamī) who lacks the eloquence of the Arabs, yet may possess wisdom.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for non-Arab; metaphorical (majāz) for one who is silent or whose argument is weak.\n- Root: خ-ص-ل (kh-ṣ-l)\n  * Lisan / Ayn: A trait, quality, or characteristic (khiṣāl) inherent in a person, whether praiseworthy or blameworthy.\n  * Al-Raghib (Mufradat): Used for moral and spiritual attributes that define one's character in the path of salvation.\n  * Al-Zamakhshari (Asas): Literal for a natural or acquired quality; metaphorical for a portion of good or evil.\n- Root: ز-ي-ن (z-y-n)\n  * Lisan / Ayn: Adornment, ornament, or beautification (zīnah); to decorate.\n  * Al-Raghib (Mufradat): In the Quranic verse {قل من حرم زينة الله} it refers to permissible worldly beautification, which is not forbidden but can distract from the Hereafter.\n  * Al-Zamakhshari (Asas): Literal for physical ornament; metaphorical for spiritual adornment through piety.\n- Sibawayh Rule: باب الحكاية والمحكي (Narration and the Quoted) — When quoting speech, the syntactic case of the original utterance is preserved, as seen in the direct quotes of Hātim and the letters exchanged.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "23": [{"arabic": "فضيلة الصدق قال الله تعالى {رجال صدقوا ما عاهدوا الله عليه} وقال النبي صلى الله عليه وسلم إن الصدق يهدي إلى البر والبر يهدي إلى الجنة وإن الرجل ليصدق حتى يكتب عند الله صديقا وإن الكذب يهدي إلى الفجور والفجور يهدي إلى النار وإن الرجل ليكذب حتى يكتب عند الله كذابا (1) ويكفي في فضيلة الصدق أن الصديق مشتق منه والله تعالى وصف الأنبياء به في معرض المدح والثناء فقال {واذكر في الكتاب إبراهيم إنه كان صديقا نبيا} وقال واذكر في الكتاب إسمعيل إنه كان صادق الوعد وكان رسولا نبيا", "english": "God Most High has said: {«رجال صدقوا ما عاهدوا الله عليه»} — \"Among the believers are men who have been true to the covenant they made with God\" (Al-Aḥzāb 33:23). And the Prophet, peace and blessings be upon him, said: \"Verily, truthfulness leads to righteousness (al-birr), and righteousness leads to Paradise. And verily, a man continues to speak truthfully until he is written with God as a supremely veracious one (ṣiddīq). And verily, falsehood leads to wickedness (al-fujūr), and wickedness leads to the Fire. And verily, a man continues to lie until he is written with God as a liar (kadhdhāb).\" (1)", "book_title": "Intention, Sincerity and Truthfulness", "section_title_ar": "Section 1226", "section_title_en": "The Book of Truthfulness (Ṣidq): Its Virtue and Reality — Section on the Virtue of Truthfulness", "section_index": 1226, "anchors": "- Root: صدق (Ṣ-D-Q)\n  * Lisan / Ayn: Core root denotes the firmness and soundness of a thing; a spear termed \"ṣadq\" is straight and rigid; truthfulness is speech that is firm, sound, and free of crookedness.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول\" — truthfulness and falsehood originate in speech, whether past or future, promise or otherwise; they occur by primary intent only in informative statements (khabar), not in other speech categories. Al-Raghib further notes the derived degrees: ṣidq (truthfulness), ṣiddīq (the supremely veracious — one whose truthfulness has become his very character), and ṣādiq al-waʿd (truthful in promise).\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"صدقته الحديث\" — to affirm someone's report as true. Majaz (metaphorical): \"رجل صادق الحملة\" — a man truthful in his charge (i.e., steadfast and unfaltering in battle), and \"فرس ذو مصدق في الجري\" — a horse with genuine exertion in running. Thus ṣidq extends metaphorically to any state of firmness, steadfastness, and correspondence between inner conviction and outward action.\n- Root: بر (B-R-R)\n  * Lisan / Ayn: Al-Birr: expansive goodness, piety, and obedience; the \"barr\" (land) is so named for its expanse. It encompasses all acts of righteousness and kindness.\n  * Al-Raghib (Mufradat): Al-birr is the breadth of obedience to God through sincere intention and righteous action; it is the comprehensive term for all that God loves and approves.\n- Root: فجر (F-J-R)\n  * Lisan / Ayn: Al-Fujūr: the breaking forth and bursting open — the wickedness that breaks through the barrier of piety; the \"fājir\" is one who bursts out of obedience into transgression.\n  * Al-Raghib (Mufradat): Fujūr is the violation of the covenant of obedience, the breaking open of the seal of God-consciousness; it is the opposite of birr.\n- Root: كذب (K-DH-B)\n  * Lisan / Ayn: Al-Kidhb: falsehood — informing of a thing contrary to its reality; the root also carries the sense of deficiency and weakness (as in \"kadhaba\" — to fall short).\n  * Al-Raghib (Mufradat): Falsehood is the counterpart of ṣidq — it is reporting what does not correspond to reality, whether in past, present, or future tense.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The grammatical structure \"يكتب عند الله صديقا\" (he is written with God as a ṣiddīq) involves the prepositional phrase \"عند الله\" interposed between the verb and its predicate accusative, a construction permissible when the interposed element is semantically integral to the judgment, as here where divine decree is the ground of the designation.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Intention, Sincerity and Truthfulness'", "badge": "Afterlife"}], "35": [{"arabic": "الله عليه وسلم من استيقظ من الليل وأيقظ امرأته فصليا ركعتين كتبا من الذاكرين الله كثيرا والذاكرات (8) وقال صلى الله عليه وسلم أفضل الصلاة بعد المكتوبة قيام الليل (9) وقال عمر بن الخطاب رضي الله عنه قال صلى الله عليه وسلم من نام عن حزبه أو عن شيء منه بالليل فقرأه بين صلاة الفجر والظهر كتب له كأنما قرأه من الليل (1) الآثار روي أن عمر رضي الله عنه كان يمر بالآية من ورده بالليل فيسقط حتى يعاد منها أياما كثيرة كما يعاد المريض وكان ابن مسعود رضي الله عنه إذا هدأت العيون قام فيسمع له دوي كدوي النحل حتى يصبح ويقال إن سفيان الثوري رحمه", "english": "Know — may God guide you — that the Messenger of God (peace and blessings be upon him) said: \"O Abū Hurayrah, if you desire the pleasure of your Lord, pray in the corners of your house, and the light of your house will be in the heaven like the light of the stars and the planets in the sight of the people of the earth.\" (7)", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 273", "section_title_en": "Section 273 — The Virtues of Night Prayer (Qiyām al-Layl) and the Narrations Concerning the Devotions of the Righteous", "section_index": 273, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include ليالٍ and ليائل\n  * Al-Raghib (Mufradat): Night is contrasted with day as a sign of divine order; \"قيام الليل\" (night vigil) is the specific act of standing in prayer during the night hours\n  * Al-Zamakhshari (Asas): Literal — the night-time period; Metaphorical — \"أصبح\" as awakening from heedlessness, used for spiritual awakening\n- Root: صبح (Ṣubḥ)\n  * Lisan / Ayn: Dawn, morning; the time when the horizon reddens with the sun's approach\n  * Al-Raghib (Mufradat): \"الصبح والصباح، أول النهار\" — the first part of the day; \"أسحرنا\" (has dawn approached?) is the question asked to determine the end of the night vigil\n  * Al-Zamakhshari (Asas): Literal — daybreak; Metaphorical — \"أصبح يا رجل: انتبه من غفلتك\" (awaken from your heedlessness), used for spiritual alertness\n- Root: حتي (Ḥattā)\n  * Al-Raghib (Mufradat): A preposition of termination — \"until\"; used to mark the endpoint of the night vigil at dawn\n  * Sibawayh Rule: When ḥattā governs the subjunctive, it means \"until such time as\"; when followed by the indicative, it denotes a resulting state or concurrent circumstance\n- Root: عله (ʿAlaha)\n  * Lisan al-Arab: To be occupied with something; to be diverted from one's appointed task — as in the one who sleeps past his nightly devotion (wird)", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}], "36": [{"arabic": "بالمشيئة يدل على الانقسام وقوله تعالى {ومن يعص الله ورسوله فإن له نار جهنم خالدين فيها} وتخصيصه بالكفر تحكم وقوله تعالى {ألا إن الظالمين في عذاب مقيم} وقال تعالى {ومن جاء بالسيئة فكبت وجوههم في النار} فهذه العمومات في معارضة عموماتهم ولا بد من تسليط التخصص والتأويل على الجانبين لأن الأخبار مصرحة بأن العصاة يعذبون (1) بل قوله تعالى وإن منكم إلا واردها كالصريح في أن ذلك لا بد منه للكل إذ لا يخلو مؤمن عن ذنب يرتكبه وقوله تعالى لا يصلاها إلا الأشقى الذي كذب وتولى أراد به من جماعة مخصوصين أو أراد بالأشقى شخصا", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Anger and Hatred'", "badge": "Afterlife"}], "38": [{"arabic": "ثبورا هذه صفتها وكان أمر الله قدرا مقدورا والصلاة والسلام على محمد عبده ورسوله المرسل إلى العالمين بشيرا ونذيرا وسراجا منيرا وعلى من كان من أهله وأصحابه له في الدين ظهيرا وعلى الظالمين نصيرا وسلم تسليما كثيرا أما بعد فإن الدنيا عدوة لله وعدوة لأولياء الله وعدوة لأعداء الله أما عداوتها لله فإنها قطعت الطريق على عباد الله ولذلك لم ينظر الله إليها منذ خلقها وأما عداوتها لأولياء الله عز وجل فإنه تزينت لهم بزينتها وعمتهم بزهرتها ونضارتها حتى تجرعوا مرارة الصبر في مقاطعتها وأما عداوتها لأعد", "english": "Praise be to God, who made His friends acquainted with the calamitous snares of this world and its afflictions, and uncovered for them its defects and its shameful parts, until they gazed upon its evidences and its signs, and weighed its evil deeds against its good deeds. Thus they came to know that its objectionable aspects exceed its commendable ones, that what is hoped from it does not fulfill what is feared from it, and that its rising is not safe from its eclipse. Yet it is in the likeness of a comely woman who draws people to herself by her beauty — while within her are hidden secrets of evil, ugly things that destroy those who yearn for union with her. Then she is a fleer from her seekers, niggardly in her turning toward them; and when she does turn, one is not secure from her evil and her pestilence. If she does good for an hour, she does evil for a year; and if she does evil once, she makes it her perpetual habit. So the cycles of her turning are ever more tightly drawn, and the commerce of her sons is losing and ruined, and her afflictions in succession strike the breasts of her seekers, and the courses of her states proclaim the humiliation of those who pursue her. Thus every one deluded by her is destined to abasement, and every one who waxes proud through her proceeds to regret. Her very nature is to flee from her seeker and to be sought by the one who flees from her. Whoever serves her, she eludes; whoever turns away from her, she comes to. Her clarity is never free of the admixture of turbidity, nor is her joy ever disentangled from what embitters it. Her soundness bequeaths sickness, her youth drives on to decrepitude, and her bliss bears no fruit but remorse and regret. She is deceitful, guileful, fleeting, evasive. She never ceases adorning herself for her seekers until, when they have become her lovers, she bares her fangs at them, disorders the ordered strands of their affairs, and uncovers for them the hidden store of her wonders — then she makes them taste the lethal poisons and strikes them with the piercing shafts of her arrows. While her companions are in joy and bounty from her, suddenly she turns away from them as though she were but scattered dreams; then she rushes upon them with her calamities, grinds them as grain is ground, and shrouds them in their winding-sheets beneath the dust. If she has possessed one of them with all that the sun has risen upon, she makes him as reaped harvest, as though he had not dwelt in plenty the day before. Her companions desire joy from her, and she promises them delusion — until they hope for much and build palaces, and then their palaces become graves, their gatherings become ruin, their striving becomes scattered dust, and their cry becomes \"Woe and destruction!\" Such is her description — and the command of God is a decree determined. And the prayer and peace be upon Muhammad, His servant and His Messenger, sent to the worlds as a bringer of glad tidings and a warner, and as an illuminating lamp; and upon those of his family and companions who were for him supporters in the religion, and against the wrongdoers helpers; and abundant peace.", "book_title": "Condemnation of the World", "section_title_ar": "Section 729", "section_title_en": "The Book of Condemnation of This World — Being the Sixth Book of the Quarter of the Destructive Things from The Revival of the Religious Sciences", "section_index": 729, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core root meaning of swallowing, devouring, or ingesting wholly\n  * Al-Raghib (Mufradat): الإلهام: casting something into the heart (al-rawʿ), specifically from God or the higher assembly; the root denotes the soul's complete reception, as one who swallows entirely\n  * Al-Zamakhshari (Asas): Literal: ألهمه الله الخير — God cast good into his heart. Metaphorical: جيش لهم — an army that engulfs and swallows whomever enters it\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter\n  * Al-Raghib (Mufradat): الدنو: proximity by essence or by judgment, used of place, time, and station; al-dunyā is the nearer, lower life\n  * Al-Zamakhshari (Asas): Literal: هو دانٍ — he is near. Metaphorical: الأدنى — the inferior, the baser, contrasted with what is better\n- Root: حسر (ḥ-s-r)\n  * Lisan / Ayn: Uncovering, stripping away a covering; exhaustion from exposure of one's strength\n  * Al-Raghib (Mufradat): الحسر: uncovering what veils; al-ḥasīr: one whose strength is laid bare and spent; al-ḥāsir: the weary whose powers are uncovered as exhausted\n  * Al-Zamakhshari (Asas): Literal: حسر عن ذراعيه — he bared his forearms. Metaphorical: فلان كريم المحسر — so-and-so is noble when tested/examined (his hidden quality is uncovered)\n- Root: سرر (s-r-r)\n  * Lisan / Ayn: Concealment, the secret kept hidden in the breast; the innermost\n  * Al-Raghib (Mufradat): الإسرار: opposite of declaration; al-sirr: the speech concealed in the soul\n  * Al-Zamakhshari (Asas): Literal: أسر الحديث — he concealed the speech. Metaphorical: أعطيتك سره — I gave you its choicest essence; هو في سر النسب — he is in the pure core of lineage\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase when the interposed element is complete in itself, as in the rhetorical suspensions of this oration", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of the World'", "badge": "Du'a"}], "40": [{"arabic": "عليه وسلم فيأتون فيقولون يا محمد أنت رسول الله وخاتم النبيين وغفر الله لك ما تقدم من ذنبك وما تأخر اشفع لنا إلى ربك ألا ترى ما نحن فيه فأنطلق فآتي تحت العرش فأقع ساجدا لربي ثم يفتح الله لي من محامده وحسن الثناء عليه شيئا لم يفتحه على أحد قبلي ثم يقال يا محمد ارفع رأسك سل تعط واشفع تشفع فأرفع رأسي فأقول أمتي أمتى يا رب فقال يا محمد أدخل من أمتك من لا حساب عليهم من الباب الأيمن من أبواب الجنة وهم شركاء الناس فيما سوى ذلك من الأبواب ثم قال والذي نفسي بيده إن بين المصراعين من مصاريع الجنة كما بين مكة وحمير أو", "english": "The evidences for intercession in the Qurʾān and the reports (akhbār) are numerous. God—exalted be He—said: {«وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰ»} [And verily thy Lord shall give thee, and thou shalt be well-pleased] (93:5). ʿAmr ibn al-ʿĀṣ narrated that the Messenger of God—peace and blessings be upon him—recited the saying of Abraham—peace be upon him—{«رَبِّ إِنَّهُنَّ أَضْلَلْنَ كَثِيرًا مِّنَ النَّاسِ ۖ فَمَن تَبِعَنِي فَإِنَّهُ مِنِّي ۖ وَمَنْ عَصَانِي فَإِنَّكَ غَفُورٌ رَّحِيمٌ»} [My Lord, verily they have led astray many of mankind; so whoso follows me, verily he is of me; and whoso disobeys me, verily Thou art Forgiving, Merciful] (14:36), and the saying of Jesus—peace be upon him—{«إِن تُعَذِّبْهُمْ فَإِنَّهُمْ عِبَادُكَ»} [If Thou chastise them, verily they are Thy servants] (5:118). Then he raised his hands and said: \"My community, my community!\" Then he wept. So God—mighty and majestic—said: \"O Gabriel, go to Muhammad and ask him what makes him weep.\" Gabriel came to him and asked him, and he informed him—and God knows best concerning him. Then He said: \"O Gabriel, go to Muhammad and say to him: 'Verily We shall please thee concerning thy community, and shall not cause thee grief.'\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1346", "section_title_en": "On the Reality of Intercession (Shafāʿah) and the Means of Attaining It", "section_index": 1346, "anchors": "- Root: شفع (Sh-F-ʿ)\n  * Lisan / Ayn: Core root denotes pairing/joining (al-ḍamm), whence shafāʿah = the intercessor joining his own plea to the petitioner's, making it two (shafʿ) rather than one (watr).\n  * Al-Raghib (Mufradat): Theological nuance — intercession is a divinely granted honor (jāh) bestowed upon prophets and saints, not an independent power; its efficacy is wholly contingent upon divine will and pleasure.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — \"شفعت الشيء\" (I made it even/pair). Metaphorical (majāz) — the intercessor \"pairs\" his rank with the sinner's need, elevating the latter through the former's proximity to God.\n- Root: خبأ (Kh-B-ʾ)\n  * Lisan / Ayn: To conceal, hide, store away secretly (khabaʾa). Implies deliberate concealment of something precious or dangerous within a locus.\n  * Al-Raghib (Mufradat): Theological nuance — God's \"hiding\" (takhbiʾah) of His friendship (wilāyah), wrath (ghaḍab), and pleasure (riḍā) within creatures and acts respectively teaches epistemic humility: no outward judgment can access the hidden decree.\n  * Al-Zamakhshari (Asas): Literal — physical concealment. Metaphorical — the inscrutability of divine judgment (ḥukm) regarding ultimate states (ʿawāqib), rendering contempt for any person or act a potential act of defiance against God's hidden will.\n- Root: عله (not applicable here; avoided per instruction)\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Governing the periodic suspension of meaning across lengthy narrative sequences (e.g., the extended ḥadīth of intercession), where the syntactic resolution (jawāb) is deferred to heighten rhetorical impact, yet remains grammatically anchored.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "41": [{"arabic": "منه وقالوا كيف تعلم ذلك فقال إذا ذكرته ذكرني وقال تعالى اذكروا الله ذكرا كثيرا وقال تعالى فإذا أفضتم من عرفات فاذكروا الله عند المشعر الحرام واذكروه كما هداكم وقال عز وجل فإذا قضيتم مناسككم فاذكروا الله كذكركم آباءكم أو أشد ذكرا وقال تعالى الذين يذكرون الله قياما وقعودا وعلى جنوبهم وقال تعالى فإذا قضيتم الصلاة فاذكروا الله قياما وقعودا وعلى جنوبكم قال ابن عباس رضي الله عنهما أي بالليل والنهار في البر والبحر والسفر والحضر والغنى والفقر والمرض والصحة والسر والعلانية وقال تعالى في ذم المنافقين ولا يذكرون الله إلا قليلا", "english": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Core meaning is \"to remember, to mention, to recollect.\" The root carries the dual sense of mental recollection and verbal utterance. In Kitab al-Ayn, the root denotes the opposite of forgetfulness (nisyan), and its verbal form encompasses both the internal act of remembrance and the external act of mentioning.\n  * Al-Raghib (Mufradat): \"الذكر: حضور المعنى في النفس، وقد يطلق على إبقاء المعنى باللسان. والذكر ضربان: ذكر بالقلب، وذكر باللسان. وقال تعالى: {فاذكروني أذكركم} [البقرة/152] — فذكر العبد ربه بالتعظيم والثناء، وذكر الله عبده بالإنعام والإكرام.\" The theological nuance distinguishes between the creature's remembrance (which is petition and praise) and the Creator's remembrance (which is response and reward).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ذكرت الشيء: حفظته ووعيته. وذكرت فلانا: جريت بذكره على لسانك.\" Metaphorical (Majaz): \"ذكر الله العبد: أثنى عليه وأجزل له الثواب. ومن المجاز: قوله تعالى {ولذكر الله أكبر} — أي ذكر الله إياكم أعظم من ذكركم إياه.\" The rhetorical distinction is crucial here: when Allah \"remembers\" His servant, it is an act of grace, not cognition.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — In the verse {ولذكر الله أكبر}, the grammatical structure allows for the subject (ذكر الله) to be read as either the creature's remembrance of Allah or Allah's remembrance of the creature, with the predicate (أكبر) applying to whichever reading is adopted. This syntactic ambiguity is deliberate and productive of multiple valid interpretations.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 235", "section_title_en": "Section 235", "section_index": 235, "anchors": "*(Anchors established)*", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'On Invocations and Supplications'", "badge": "Dhikr"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "43": [{"arabic": "{يخرجهم من الظلمات إلى النور} وقال صلى الله عليه وسلم يا أيها الناس اعقلوا عن ربكم وتواصوا بالعقل تعرفوا ما أمرتم به وما نهيتم عنه واعلموا أنه ينجدكم عند ربكم واعلموا أن العاقل من أطاع الله وإن كان دميم المنظر حقير الخطر دنيء المنزلة رث الهيئة وأن الجاهل من عصى الله تعالى وإن كان جميل المنظر عظيم الخطر شريف المنزلة حسن الهيئة فصيحا نطوقا فالقردة والخنازير أعقل عند الله تعالى ممن عصاه ولا تغتر بتعظيم أهل الدنيا إياهم فإنهم من الخاسرين (2) وقال صلى الله عليه وسلم أول ما خل", "english": "The Book of Seclusion ('Uzlah) — its explanation, God Most High willing. For this reason, Yūsuf ibn Asbāṭ wrote to Ḥudhayfah al-Marʿashī: \"What is your opinion of one who remains, finding no one with whom to remember God Most High except that he is either sinful, or his remembrance in company is itself an act of disobedience — and that because he finds no one of his own kind?\" And indeed he spoke truly, for mixing with people is never free from backbiting (ghībah), or listening to backbiting, or remaining silent upon wrongdoing (munkar). And the best of his states is that he either imparts knowledge or acquires it. Yet were this poor wretch to reflect, and to know that his imparting of knowledge is never free from the taints of ostentation (riyā'), the seeking of followers, and the desire for leadership (ri'āsah), he would know that the one who acquires knowledge from him only seeks to make it an instrument for pursuing the world and a means toward evil — so that the teacher becomes his helper therein, his support and his backer, preparing its causes for him, like one who sells a sword to a highway robber. For knowledge is like the sword: its soundness for good is like the soundness of the sword for warfare. And for this reason, it is not permitted to sell it to one whom one knows, by the indications of his circumstances, intends to use it to aid in cutting off the road.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 65", "section_title_en": "The Book of Seclusion ('Uzlah) — Section 65, and The Seventh Book: On the Intellect, Its Nobility, Its Reality, and Its Divisions", "section_index": 65, "anchors": "- Root: عقل (ʿaql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back; the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — The intellect is said of the faculty prepared for the reception of knowledge, and it is also said of the knowledge which man acquires by means of that faculty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): intellectual apprehension and understanding. Metaphorical (Majaz): \"نخلة لا تعقل الإبار\" — a palm tree that does not accept pollination, i.e., does not grasp or take in.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge as the mark or sign by which a thing is known; the trace or landmark that guides.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — Knowledge is the apprehension of a thing in its true reality; it is of two kinds: apprehension of the essence of a thing, and judgment upon a thing regarding what exists for it or is negated of it.\n  * Al-Zamakhshari (Asas): Literal: certain awareness. Metaphorical: \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge; knowledge as a guiding landmark (maʿlam).\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; the first to set up beacons (manār) on his path in his campaigns to guide his return.\n  * Al-Raghib (Mufradat): \"النور: الضوء المنتشر الذي يعين على الإبصار\" — Light is the diffused radiance that aids vision; it is of two kinds: that perceived by the eye of inner insight (baṣīrah) — such as the light of the intellect and the light of the Qur'an — and that perceived by the eye of the head, such as the celestial bodies.\n  * Al-Zamakhshari (Asas): Literal: illumination. Metaphorical: \"نور الأمر: بينه\" — he illuminated the matter: he made it clear; \"وهذا أنور من ذاك: أبين\" — this is more luminous than that: more evident.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the exclusive attribution of a predicate to a subject, as in the author's restriction of the scholar's condition to one of two men, and the exclusion of the third.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Condemnation of Delusion'", "badge": "Dhikr"}], "48": [{"arabic": "الغيبة أشد من الزنا (1) وقال تعالى {ودع أذاهم وتوكل على الله} وقال تعالى {واصبر على ما يقولون واهجرهم هجرا جميلا} وقال تعالى {ولقد نعلم أنك يضيق صدرك بما يقولون فسبح بحمد ربك} الآية وقال تعالى {ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور} أي تصبروا عن المكافأة ولذلك مدح الله تعالى العافين عن حقوقهم في القصاص وغيره فقال تعالى {وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو} خير الصابرين {وقال} صلى الله عليه وسلم صل من قطعك وأعط من حرمك واعف عمن ظل", "english": "And acts of disobedience are the requisite of the impulse of caprice (bāʿith al-hawā). And the most severe kind of patience is patience in abstaining from those acts of disobedience that have become familiar through habit — for habit is a fifth nature. When habit is joined to lustful desire, two battalions from the battalions of Satan array themselves in concert against the battalion of God (jund Allāh) — may He be exalted — and the impulse of religion (bāʿith al-dīn) has no strength to suppress them. Then, if that act be one whose commission has been rendered easy (tayassara), patience in abstaining from it is heavier upon the soul — such as patience in abstaining from the sins of the tongue: backbiting (ghībah), falsehood, contentious disputation (mirāʾ), self-praise whether by insinuation (taʿrīḍ) or by explicit statement (taṣrīḥ), the varieties of jesting that wound hearts, the kinds of words by which one intends belittlement and contempt, and the mention of the dead with aspersion cast upon them, upon their sciences, their conduct, and their stations. For such mention is in its outward aspect (fī ẓāhirihi) backbiting, and in its inward aspect (fī bāṭinihi) self-praise. In it the soul has two lusts: one is the negation of the other [person], and the other is the affirmation of oneself. And by these two together there is completed for it that lordship (rubūbiyyah) which is innate in its disposition — and which is the very opposite of what it has been commanded regarding servanthood (ʿubūdiyyah). And because of the conjunction of the two lusts, and the ease of moving the tongue, and the fact that this becomes habitual in everyday converse, patience in abstaining from it becomes difficult. And it is among the greatest of the destructive enormities (al-mūbiqāt) — so much so that its disapproval and ugliness have been effaced from hearts by dint of its frequent repetition and the universality of familiarity with it. Thus you see a man who would, for example, wear silk and deem it utterly remote [of permissibility], yet he unleashes his tongue the whole day long against the reputations (aʿrāḍ) of people and does not deem that objectionable — notwithstanding what has come down in the report that backbiting is more severe than adultery (zinā). And God — may He be exalted — said: {«ودع أذاهم وتوكل على الله»} \"And leave aside their harm and put thy trust in God\" (Q. 33:48). And He said — may He be exalted: {«واصبر على ما يقولون واهجرهم هجرا جميلا»} \"And be patient over what they say, and depart from them with a gracious departure\" (Q. 73:10). And He said — may He be exalted: {«ولقد نعلم أنك يضيق صدرك بما يقولون فسبح بحمد ربك»} \"And indeed We know that thy breast is straitened by what they say; so glorify with the praise of thy Lord\" (Q. 15:97–98) — to the end of the verse. And He said — may He be exalted: {«ولتسمعن من الذين أوتوا الكتاب من قبلكم ومن الذين أشركوا أذى كثيرا وإن تصبروا وتتقوا فإن ذلك من عزم الأمور»} \"And you shall surely hear from those who were given the Scripture before you and from those who associate [others with God] much harm. And if you are patient and God-fearing, indeed that is of the resolute affairs\" (Q. 3:186) — that is, that you be patient in refraining from requital (mukāfaʾah). And for this reason God — may He be exalted — praised those who pardon others their due rights in retaliation (qiṣāṣ) and otherwise, saying — may He be exalted: {«وإن عاقبتم فعاقبوا بمثل ما عوقبتم به ولئن صبرتم لهو خير الصابرين»} \"And if you punish, then punish with the like of that wherewith you were afflicted. And if you are patient, it is surely better for the patient\" (Q. 16:126). And he — upon him be peace — said: \"Maintain the bond with him who cuts you off, and give to him who withholds from you, and pardon him who wrongs you.\" And I have seen in the Gospel that ʿĪsā ibn Maryam — upon him be peace — said: \"It was said to you of old: an eye for an eye and a nose for a nose. But I say to you: do not resist evil. Rather, whoever strikes your right cheek, turn to him PageV04P071 the left cheek; and whoever takes your cloak, give him your garment; and whoever compels you to walk with him one mile, walk with him two miles.\" And all of that is a command to be patient under harm. So patience under the harm of people is among the highest stations of patience, because in it the impulse of religion and the impulse of lustful desire and anger are all arrayed together [against the soul].", "book_title": "Patience and Gratitude", "section_title_ar": "Section 965", "section_title_en": "The Most Severe Forms of Patience: Abstaining from Habitual Sins and Enduring Harm", "section_index": 965, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; \"ṣabara al-dābbah\" = to hold back an animal without fodder; \"ṣabartu nafsī\" = I restrained my soul.\n  * Al-Raghib (Mufradat): \"الصبر: حبس النفس على ما يقتضيه العقل والشرع، أو عما يقتضيان حبسها عنه\" — Patience is the withholding of the soul upon what reason and Law require, or from what they require it to be withheld. When exercised against calamity it is called ṣabr alone (opposed to jazaʿ); in warfare, courage (shajāʿah); in vexing misfortune, forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — I bore patiently what I dislike, and I restrained myself from what I love. Metaphorical (majāz): \"هو أصبر على الضرب من الأرض\" — he is more enduring of beating than the earth.\n- Root: عادة (ʿ-w-d)\n  * Lisan / Ayn: Recurrence and return; habitual practice that becomes second nature through repetition.\n  * Al-Raghib (Mufradat): Habit (ʿādah) as reiterated action that imprints upon the soul, rendering the act facile and its abandonment burdensome.\n  * Al-Zamakhshari (Asas): Literal: return to a state or place. Metaphorical: the ingrained disposition that governs conduct.\n- Root: غيب (gh-y-b)\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين\" — that which is concealed from the senses; applied to what is absent from human perception, though nothing is absent from God.\n  * Al-Zamakhshari (Asas): Literal: \"تكلم بذلك عن ظهر الغيب\" — he spoke of that behind the veil of the unseen. Metaphorical: \"أتونا في غابة\" — they came in a dense host (like tangled thickets).\n- Sibawayh Rule: Prepositional Interposition (باب الفصل بين الجار والمجرور) — governing the permissible separation between the preposition and its object for rhetorical emphasis, as in the periodic construction \"فإن ذلك في ظاهره غيبة وفي باطنه ثناء على النفس\" where the circumstantial qualifiers (ẓāhir/bāṭin) are interposed to contrast outward form with inward reality.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "49": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "53": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "وقت الأكل فإن ذلك من المفاجأة وقد نهي عنه قال الله تعالى {لا تدخلوا بيوت النبي إلا أن يؤذن لكم إلى طعام غير ناظرين إناه} يعني منتظرين حينه ونضجه وفي الخبر من مشى إلى طعام لم يدع إليه مشى فاسقا وأكل حراما (10) ولكن حق الداخل إذا لم يتربص وأتفق أن صادفهم على طعام أن لا يأكل ما لم يؤذن له فإذا قيل له كل نظر فإن علم أنهم يقولونه على محبة لمساعدته فليساعد وإن كانوا يقولونه حياء منه فلا ينبغي أن يأكل بل ينبغي أن يتعلل أما إذا كان جائعا فقصد بعض إخوانه ليطعمه ولم يتربص به وقت أكله فلا بأس به قصد رسول الله صلى الله عليه وسلم وأبو بكر وعمر رضي الله عنه", "english": "Jaʿfar ibn Muḥammad (may God be pleased with him and his father) said: \"When you sit with your brothers at the table, prolong the sitting — for that hour is not reckoned against you from your lifespans.\"", "book_title": "Manners of Eating", "section_title_ar": "Section 288", "section_title_en": "On Presenting Food to Brothers — Its Excellence and Etiquettes", "section_index": 288, "anchors": "- Root: ق-د-م (q-d-m)\n  * Lisan / Ayn: \"To present, offer, bring forward; to advance. Taqdīm (تقديم) is the act of setting something before another, whether physically or in rank.\"\n  * Al-Raghib (Mufradat): \"Al-Qudum (القدوم) is arrival; taqdīm is causing something to arrive before another. In the context of hospitality, it signifies the voluntary offering of provision (rizq) to a guest as an act of drawing near (taqarrub) to God.\"\n  * Al-Zamakhshari (Asas): \"Literal (haqīqah): placing food before a person. Metaphorical (majāz): preferring or advancing someone in honor — as in 'qaddamahu' meaning he honored him.\"\n- Root: أ-ك-ل (a-k-l)\n  * Lisan / Ayn: \"To eat, to consume. Al-Akl (الأكل) is the taking of nourishment. Al-Aklah (الأكلة) is a single morsel or bite.\"\n  * Al-Raghib (Mufradat): \"Al-Akl: partaking of food. By way of metaphor, it is said 'the fire ate the wood.' The root carries the sense of receiving what sustains — and in the Hereafter, the reckoning (hisāb) is lifted from what one eats with brothers, for it partakes of the character of worship.\"\n  * Al-Zamakhshari (Asas): \"Literal: consuming food. Metaphorical: 'he ate my wealth' meaning he spent it among people. Here, the eating with brothers is elevated beyond mere consumption to an act of spiritual communion.\"\n- Root: ك-ل-ف (k-l-f)\n  * Lisan / Ayn: \"Takalluf (تكلف) is burdening oneself with what is beyond one's capacity or custom — affectation, straining to exceed the ordinary.\"\n  * Al-Raghib (Mufradat): \"Al-Kulfah (الكلفة) is the hardship one undertakes. Takalluf is assuming a burden unnecessarily — and in hospitality, it is condemned because it introduces pretense (riyā') and disrupts the naturalness of brotherly love.\"\n  * Al-Zamakhshari (Asas): \"Literal: imposing upon oneself. Metaphorical: the affectation that severs the bonds of friendship, for when a man strains for his guest, the guest feels the weight and ceases to return.\"\n- Root: ض-ي-ف (d-y-f)\n  * Lisan / Ayn: \"Al-Dayf (الضيف) is the guest; the root conveys inclination and leaning toward — the guest leans upon the host's generosity.\"\n  * Al-Raghib (Mufradat): \"Iḍāfah (الإضافة) is inclining toward another for refuge. The guest (dayf) is so named because he inclines toward the host's table. True hospitality (diyāfah) is rendering honor without ostentation.\"\n  * Al-Zamakhshari (Asas): \"Literal: the one who arrives seeking shelter. Metaphorical: the soul's inclination toward what is offered — and the host's soul should incline toward the guest with sincerity, not show.\"\n- Sibawayh Rule: Bāb al-Ḥaṣr wa-l-Taqyīd bi-Innamā (Restriction & Focused Predication) — The conditional and restrictive constructions in the ḥadīth reports (e.g., \"lā yuḥāsabu al-ʿabdu ʿalā mā ya'kulu maʿa ikhwānihi\") employ the negative restriction to single out the act of brotherly eating from the general reckoning, requiring the translator to preserve the exclusivity of the predicate.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Manners of Eating'", "badge": "Insight"}], "56": [{"arabic": "قال الله تعالى {إن الله وملائكته يصلون على النبي يا أيها الذين آمنوا صلوا عليه وسلموا تسليما} وروي أنه صلى الله عليه وسلم جاء ذات يوم والبشرى ترى في وجهه فقال صلى الله عليه وسلم أنه جاءني جبريل عليه السلام فقال أما ترضى يا محمد أن لا يصلي عليك أحد من أمتك صلاة واحدة إلا صليت عليه عشرا ولا يسلم عليك أحد من أمتك إلا سلمت عليه عشرا (1) وقال صلى الله عليه وسلم من صلى علي صلت عليه الملائكة ما صلى علي فليقلل عند ذلك أو ليكثر (2) وقال صلى الله عليه وسلم إن أولى الناس بي أكثرهم علي صلاة (3) وقال صلى الله عليه وسلم بحسب المؤمن من البخل أن أذكر عن", "english": "God Most High has said: {«Indeed, God and His angels send blessings upon the Prophet. O you who have believed, send blessings upon him and greet him with a greeting of peace»} (Q. 33:56). And it is related that he, peace be upon him, came one day with the signs of glad tidings visible upon his face, and he, peace be upon him, said: \"Gabriel came to me, peace be upon him, and said: 'Are you not pleased, O Muhammad, that no one from your community sends a single blessing upon you except that I send ten blessings upon him, and no one from your community greets you with peace except that I greet him with peace ten times?'\" (1) And he, peace be upon him, said: \"Whoever sends blessings upon me, the angels send blessings upon him as long as he continues to send blessings upon me — so let him reduce or increase at that.\" (2) And he, peace be upon him, said: \"The people most deserving of me are those who send the most blessings upon me.\" (3) And he, peace be upon him, said: \"It suffices a believer for miserliness that I am mentioned in his presence and he does not send blessings upon me.\" (4) And he, peace be upon him, said: \"Multiply your sending of blessings upon me on the day of Friday.\" (5) And he, peace be upon him, said: \"Whoever sends blessings upon me from my community, ten good deeds are written for him and ten evil deeds are erased from him.\" (6) And he, peace be upon him, said: \"Whoever says upon hearing the call to prayer and the iqāmah: 'O God, Lord of this perfect call and the established prayer, send blessings upon Muhammad, Your servant and Your Messenger, and grant him the means (al-wasīlah) and the excellence (al-faḍīlah) and the lofty rank (al-darajah al-rafīʿah) and the intercession (al-shafāʿah) on the Day of Resurrection' — my intercession becomes permissible for him.\" (7) And the Messenger of God, peace be upon him, said: \"Whoever sends blessings upon me in a book, the angels continue to seek forgiveness for him as long as my name remains in that book.\" (8) And he, peace be upon him, said: \"Indeed, upon the earth there are traveling angels who convey to me the greetings of peace from my community.\" (9) And he, peace be upon him, said: \"No one greets me with peace except that God returns my soul to me until I respond to his greeting.\" (1) And it was said to him: \"O Messenger of God, how do we send blessings upon you?\" He said: \"Say: 'O God, send blessings upon Muhammad, Your servant, and upon his family, his wives, and his descendants, as You sent blessings upon Abraham and the family of Abraham; and bless Muhammad, his wives, and his descendants, as You blessed Abraham and the family of Abraham. Indeed, You are Praiseworthy, Glorious.'\" (2)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 244", "section_title_en": "Section 244 — On the Virtues of Invoking Blessings upon the Prophet (Ṣalawāt) and the Excellence of His Rank", "section_index": 244, "anchors": "- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: Core root denotes prayer, blessing, supplication; al-ṣalāh from God is mercy (raḥmah), from angels is seeking forgiveness (istighfār), from believers is supplication (duʿā').\n  * Al-Raghib (Mufradat): Al-ṣalāh from God is pure mercy and beneficence; from angels it is their petition for forgiveness; from humans it is humble supplication. The divine ṣalāh upon the Prophet is an elevation of his mention and an increase in his honor.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): supplication and bending in worship. Metaphorical (majāz): God's ṣalāh upon the Prophet is His mercy and His exaltation of him before the angels; the believers' ṣalāh is their invocation and reverence.\n- Root: سلم (S-L-M)\n  * Lisan / Ayn: Root denotes safety, peace, deliverance; taslīm is the greeting of peace and submission.\n  * Al-Raghib (Mufradat): Salām from God is His safeguarding; the greeting of salām upon the Prophet is an acknowledgment of his prophetic rank and a prayer for his perfect safety.\n  * Al-Zamakhshari (Asas): Literal: greeting of peace. Metaphorical: the angels' conveyance of the believers' salām to the Prophet even after his death, indicating the enduring bond.\n- Root: حمد (Ḥ-M-D)\n  * Lisan / Ayn: Core root denotes praise, commendation; maḥmūd is the one praised.\n  * Al-Raghib (Mufradat): Ḥamd is praise for voluntary beneficence; al-ḥamd li-Llāh encompasses all praise due to God's perfect attributes.\n  * Al-Zamakhshari (Asas): Literal: to praise for good. Metaphorical: to find praiseworthy (aḥmadtu al-arḍ: I found the land agreeable).\n- Sibawayh Rule: Rule of Interposition (al-faṣl bayna al-jār wa al-majrūr) — The periodic structure of the ḥadīth reports here follows the canonical pattern of embedding quoted speech within narrative frames, maintaining syntactic cohesion across multiple levels of reported discourse.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "وروى واثلة بن الأسقع أن رسول الله صلى الله عليه وسلم قال إن الله وملائكته يصلون على أصحاب العمائم يوم الجمعة (2) فإن أكربه الحر فلا بأس بنزعها قبل الصلاة وبعدها ولكن لا ينزع في وقت السعي من المنزل إلى الجمعة ولا في وقت الصلاة ولا عند صعود الإمام المنبر وفي خطبته الرابع البكور إلى الجامع ويستحب أن يقصد الجامع من فرسخين وثلاث وليبكر ويدخل وقت البكور بطلوع الفجر وفضل البكور عظيم وينبغي أن يكون في سعيه إلى الجمعة خاشعا متواضعا ناويا للاعتكاف في المسجد إلى وقت الصلاة قاصدا للمبادرة إلى جواب نداء الله عز وجل إلى الجمعة إياه والمسا", "english": "Ibn Masʿūd said: \"Whoever trims his nails on Friday, God—mighty and majestic is He—brings forth from him an ailment and brings into him a healing.\" And if he has entered the bathhouse on Thursday or Wednesday, then the intended purpose has been achieved.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 148", "section_title_en": "Section 148", "section_index": 148, "anchors": "*(Anchors established)*", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Mysteries of Prayer'", "badge": "Ethics"}], "62": [{"arabic": "سنة الله تعالى في خلقه ولن تجد لسنة الله تبديلا فلا يخلق الله حركة اليد بكتابة منظومة ما لم يخلق فيها صفة تسمى قدرة وما لم يخلق فيها حياة وما لم يخلق إرادة مجزومة ولا يخلق الإرادة المجزومة ما لم يخلق شهوة وميلا في النفس ولا ينبعث هذا الميل انبعاثا تاما ما لم يخلق علما بأنه موافق للنفس إما في الحال أو في المآل ولا يخلق العلم أيضا إلا بأسباب أخر ترجع إلى حركة وإرادة وعلم فالعلم والميل الطبيعي أبدا يستتبع الإرادة الجازمة والقدرة والإرادة أبدا تستردف الحركة وهكذا الترتيب في كل فعل والكل من اختراع", "english": "Know that the obligation of repentance is made evident by the transmitted reports (1) and the Quranic verses, and it is clear by the light of inner vision (nūr al-baṣīrah) for the one whose insight has been opened and whose breast God has expanded with the light of faith, until he is able to walk by his light which is before him through the darknesses of ignorance, independent of a guide to lead him at every step. For the wayfarer is either blind, not independent of a guide in his steps, or sighted, guided to the beginning of the road and then guided by himself. Likewise, people on the path of religion are divided according to this division. There is the deficient one who cannot surpass emulation (taqlīd) in his steps, and thus needs to hear at every footfall a text from the Book of God or the Sunnah of His Messenger — and perhaps that fails him, and he becomes bewildered. The journeying of this one, even if his life is long and his effort great, is short, and his steps are deficient. And there is the fortunate one whose breast God has expanded for Islam, and he is upon a light from his Lord. He is alerted by the slightest indication to traverse a rugged path and to cut through exhausting obstacles, and the light of the Quran and the light of faith shine in his heart. Due to the intensity of the light of his inner being, he is satisfied with the slightest explanation, as if his oil were about to glow even if fire did not touch it — and when fire touches it, it is light upon light. {«يَهْدِي اللَّهُ لِنُورِهِ مَنْ يَشَاءُ»} God guides to His light whom He wills. This one does not need a transmitted text in every occurrence. So whoever is in this state, when he wishes to know the obligation of repentance, he looks first with the light of inner vision at what repentance is, then at what the meaning of obligation is, then he combines the meaning of obligation with repentance and does not doubt its being established for it. That is, by knowing that the meaning of \"the obligatory\" is that which is necessary for reaching the felicity of eternity and for deliverance from the perdition of eternity. For were it not for the attachment of felicity and misery to the doing of a thing or its abandonment, there would be no meaning to describing it as obligatory. And the saying of one who says, \"It became obligatory by an act of imposition,\" is pure idle talk. For that in whose doing or abandoning we have no interest, whether in the hereafter or in this world, has no meaning for our occupying ourselves with it, whether another imposed it upon us or did not impose it. So when he knows the meaning of obligation — that it is the means to the felicity of eternity — and knows that there is no felicity in the abode of permanence except in the encounter (liqāʾ) of God Most High, and that everyone veiled from Him is miserable without exception, cut off from what he desires, burned by the fire of separation and the fire of Hell; and knows that nothing distances from the encounter of God except the following of passions and intimacy with this perishing world and clinging to the love of what must inevitably be parted from; and knows that nothing brings near to the encounter of God except severing the heart's attachment from the ornament of this world and turning wholly to God, seeking intimacy with Him through the constancy of His remembrance, and love for Him through knowledge of His majesty and beauty to the extent of one's capacity; and knows that sins — which are a turning away from God and a following of what the devils, the enemies of God who distance from His presence, love — are the cause of one's being veiled and distanced from God Most High — then he does not doubt that turning away from the path of distance is obligatory for reaching proximity. And turning away is only completed by knowledge, remorse, and resolve. For as long as he does not know that sins are causes of distance from the Beloved, he will not regret nor feel pain due to his traveling the path of distance; and as long as he does not feel pain, he will not return; and the meaning of returning is abandoning and resolving. So he does not doubt that the three meanings are necessary for reaching the Beloved. And such is the faith that results from the light of inner vision.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 917", "section_title_en": "The Obligation of Repentance: Its Reality, Its Proofs, and the Reconciliation of Divine Decree with Human Agency", "section_index": 917, "anchors": "- Root: توب (T-W-B)\n  * Lisan / Ayn: Core meaning is \"return\" (rujūʿ) — the act of turning back from a path one was on.\n  * Al-Raghib (Mufradat): In theological usage, it signifies returning from sin (dhamb) to obedience, and from distance (buʿd) from God to proximity (qurb) to Him. It is the servant's reversion to his original, sound nature.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is \"returning\"; metaphorical (majāz) extension applies it to the heart's turning away from the pursuit of worldly desires (shahawāt) toward the remembrance of God.\n- Root: وجب (W-J-B)\n  * Lisan / Ayn: Core meaning is \"to be established, fixed, or necessary\" — something whose non-existence entails a contradiction or harm.\n  * Al-Raghib (Mufradat): The obligatory (wājib) is that which, if neglected, incurs blame; it is divided into what is obligatory by reason (ʿaql) and what is obligatory by revelation (sharʿ).\n  * Al-Zamakhshari (Asas): Literal sense: \"to be due\" or \"to fall\" (as in a price being fixed); metaphorical sense: the soul's \"falling\" into action out of necessity.\n- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: Core meaning is \"measuring\" or \"estimating\" (taqdīr) — bringing something into existence according to a precise measure.\n  * Al-Raghib (Mufradat): Used for creation from nothing (ibdāʿ) and for bringing something forth from another thing; all of God's acts are measured by His eternal decree.\n  * Al-Zamakhshari (Asas): Literal: the artisan's measuring of leather before cutting; Metaphorical: God's origination of creation upon a measure necessitated by wisdom.\n- Root: كسب (K-S-B)\n  * Lisan / Ayn: Core meaning is \"to acquire\" or \"to earn\" — an act that returns a benefit or harm to the agent.\n  * Al-Raghib (Mufradat): In Kalam, acquisition (kasb) denotes the creature's relation to an act that is entirely God's creation, yet is attributed to the servant by way of his being the locus of its occurrence.\n  * Al-Zamakhshari (Asas): Literal: to gather wealth; Metaphorical: the soul's \"gathering\" of deeds that cling to it as its own.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — used to delimit the meaning of \"obligation\" to its true referent (the means to eternal felicity), and to restrict the attribution of acts to God alone as their sole Creator.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "63": [{"arabic": "الساعة وانشق القمر إنهم يرونه بعيدا ونراه قريبا وما يدريك لعل الساعة تكون قريبا ثم يكون أحسن أحوالنا أن نتخذ دراسة هذا القرآن عملا فلا نتدبر معانيه ولا ننظر في كثرة أوصاف هذا اليوم وأساميه ولا نستعد للتخلص من دواهيه فنعوذ بالله من هذه الغفلة إن لم يداركنا الله بواسع رحمته", "english": "So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1339", "section_title_en": "The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent", "section_index": 1339, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}, {"arabic": "غرورا وظن أن تزكية الناس له دليل على كونه مرضيا عند الله ولا يدري أن ذلك لجهل الناس بخبائث باطنه وفرقة أخرى حرصت على النوافل ولم يعظم اعتدادها بالفرائض ترى أحدهم يفرح بصلاة الضحى وبصلاة الليل وأمثال هذه النوافل ولا يجد للفريضة لذة ولا يشتد حرصه على المبادرة بها في أول الوقت وينسى قوله صلى الله عليه وسلم فيما يرويه عن ربه ما تقرب المتقربون إلي بمثل أداء ما افترضت عليهم (1) حديث من أبر قال أمك الحديث أخرجه الترمذي والحاكم وصححه من حديث زيد بن حكيم عن أبيه عن جده وقد تقدم في آداب الصحة فينبغي أن يبدأ في الصلة بال", "english": "Yes — and he may even abandon leadership and prefer seclusion and withdrawal, yet still be deluded, for he then shows favor toward the wealthy, speaks harshly to them, and looks upon them with an eye of contempt. He hopes for himself more than he hopes for them, marvels at his own deeds, and is characterized by a host of hidden vices of the heart while he does not perceive it. Perhaps he is offered wealth and refuses to take it, fearing that it will be said that his asceticism has been nullified — yet were it said to him: \"It is lawful, so take it openly and return it secretly,\" his soul would not permit him, out of fear of people's blame. Thus he is desirous of people's praise — and that is among the most delicious of the doors of this world — while he sees himself as an ascetic in this world, and he is deluded. Moreover, he is not free from venerating the wealthy, giving them precedence over the poor, inclining toward those who seek him out and praise him, and recoiling from those who incline toward other ascetics besides him. All of that is deception and delusion from Satan — we seek refuge in God from him.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 904", "section_title_en": "On the Deluded Ascetic Who Seeks Renown and Neglects the Inner Heart", "section_index": 904, "anchors": "- Root: غرر (gh-r-r)\n  * Lisan / Ayn: Core meaning of an outward trace or mark; غرّة is heedlessness in wakefulness, and being deluded (مغرور) is one who is deceived by an outward appearance.\n  * Al-Raghib (Mufradat): \"غررت فلانا: أصبت غرته\" — to strike one's heedless spot; the delusion is a heedlessness wherein one takes the apparent for the real, as in {«ما غرك بربك الكريم»} (Q. 82:6).\n  * Al-Zamakhshari (Asas): Haqiqah: غارّ = heedless/negligent. Majaz: The \"white-blazed\" day (يوم أغر) is one of intense heat — a metaphorical extension of a shining, deceptive surface.\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: Root of measuring and smoothing; خلق الثوب = worn-out garment (from being measured by use).\n  * Al-Raghib (Mufradat): Originary creation by precise estimation (تقدير مستقيم); also character/disposition as the inward \"measure\" of the soul.\n  * Al-Zamakhshari (Asas): Haqiqah: tailoring/measuring before cutting. Majaz: God's creation as bringing into being upon a measure required by wisdom; خلق حسن = excellent moral character.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning a thing over from one face to another.\n  * Al-Raghib (Mufradat): تصريف الشيء وصرفه عن وجه إلى وجه — the heart is so named for its constant turning (تقلب) between states.\n  * Al-Zamakhshari (Asas): Haqiqah: physical overturning. Majaz: \"قلبت الأمر ظهرا لبطن\" — to scrutinize a matter thoroughly, turning it over in examination.\n- Root: ظهر (z-h-r)\n  * Lisan / Ayn: The back; outward surface.\n  * Al-Raghib (Mufradat): Used metaphorically for the outward aspect of the earth (ظهر الأرض) versus its inward (بطنها); also for the manifest versus the hidden.\n  * Al-Zamakhshari (Asas): Haqiqah: physical back. Majaz: \"قلبت الأمر ظهرا لبطن\" — exhaustive examination; ظاهر = outward deeds vs. باطن = inner states.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between subject and predicate) — allowing parenthetical clauses (e.g., \"وهو لا يدري\") to interrupt the main periodic sentence without breaking its grammatical cohesion, preserving the cumulative rhetorical force of the author's warning.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Delusion'", "badge": "Hadith"}], "66": [{"arabic": "نار جهنم دعا ويوم يسحبون فى النار على وجوههم ويوم تقلب وجوههم فى النار ويوم لا يجزى والد عن ولده ويوم يفر المرء من أخيه وأمه وأبيه ويوم لا ينطقون ولا يؤذن لهم فيعتذرون يوم لا مرد له من الله يوم هم بارزون ويوم هم على النار يفتنون يوم لا ينفع مال ولا بنون يوم لا ينفع الظالمين معذرتهم ولهم اللعنة ولهم سوء الدار يوم ترد فيه المعاذير وتبلى السرائر وتظهر الضمائر وتكشف الأستار يوم تخشع فيه الأبصار وتسكن الأصوات ويقل فيه الالتفات وتبرز الخفيات وتظهر الخطيئات يوم يساق العباد ومعهم الأشهاد ويشيب الصغير ويسكر الكبير فيومئذ", "english": "So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1339", "section_title_en": "The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent", "section_index": 1339, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}, {"arabic": "يكونوا قد أطاعوك وهم بين أطباقها يعذبون يقولون يا ليتنا أطعنا الله وأطعنا الرسولا بأبي أنت وأمي يا رسول الله لئن كان موسى بن عمران أعطاه الله حجرا تنفجر منه الأنهار فماذا بأعجب من أصابعك حين نبع منها الماء صلى الله عليك بأبي أنت وأمي يا رسول الله لئن كان سليمان بن داود أعطاه الله الريح غدوها شهر ورواحها شهر فماذا بأعجب من البراق حين سريت عليه إلى السماء السابعة ثم صليت الصبح من ليلتك بالأبطح صلى الله عليك بأبي أنت وأمي يا رسول الله لئن كان عيسى بن مريم أعطاه الله إحياء الموتى فماذا بأعجب من الشاة المسمومة حين كلمتك وهي", "english": "God Most High has said: {«Indeed, God and His angels send blessings upon the Prophet. O you who have believed, send blessings upon him and greet him with a greeting of peace»} (Q. 33:56). And it is related that he, peace be upon him, came one day with the signs of glad tidings visible upon his face, and he, peace be upon him, said: \"Gabriel came to me, peace be upon him, and said: 'Are you not pleased, O Muhammad, that no one from your community sends a single blessing upon you except that I send ten blessings upon him, and no one from your community greets you with peace except that I greet him with peace ten times?'\" (1) And he, peace be upon him, said: \"Whoever sends blessings upon me, the angels send blessings upon him as long as he continues to send blessings upon me — so let him reduce or increase at that.\" (2) And he, peace be upon him, said: \"The people most deserving of me are those who send the most blessings upon me.\" (3) And he, peace be upon him, said: \"It suffices a believer for miserliness that I am mentioned in his presence and he does not send blessings upon me.\" (4) And he, peace be upon him, said: \"Multiply your sending of blessings upon me on the day of Friday.\" (5) And he, peace be upon him, said: \"Whoever sends blessings upon me from my community, ten good deeds are written for him and ten evil deeds are erased from him.\" (6) And he, peace be upon him, said: \"Whoever says upon hearing the call to prayer and the iqāmah: 'O God, Lord of this perfect call and the established prayer, send blessings upon Muhammad, Your servant and Your Messenger, and grant him the means (al-wasīlah) and the excellence (al-faḍīlah) and the lofty rank (al-darajah al-rafīʿah) and the intercession (al-shafāʿah) on the Day of Resurrection' — my intercession becomes permissible for him.\" (7) And the Messenger of God, peace be upon him, said: \"Whoever sends blessings upon me in a book, the angels continue to seek forgiveness for him as long as my name remains in that book.\" (8) And he, peace be upon him, said: \"Indeed, upon the earth there are traveling angels who convey to me the greetings of peace from my community.\" (9) And he, peace be upon him, said: \"No one greets me with peace except that God returns my soul to me until I respond to his greeting.\" (1) And it was said to him: \"O Messenger of God, how do we send blessings upon you?\" He said: \"Say: 'O God, send blessings upon Muhammad, Your servant, and upon his family, his wives, and his descendants, as You sent blessings upon Abraham and the family of Abraham; and bless Muhammad, his wives, and his descendants, as You blessed Abraham and the family of Abraham. Indeed, You are Praiseworthy, Glorious.'\" (2)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 244", "section_title_en": "Section 244 — On the Virtues of Invoking Blessings upon the Prophet (Ṣalawāt) and the Excellence of His Rank", "section_index": 244, "anchors": "- Root: صلو (Ṣ-L-W)\n  * Lisan / Ayn: Core root denotes prayer, blessing, supplication; al-ṣalāh from God is mercy (raḥmah), from angels is seeking forgiveness (istighfār), from believers is supplication (duʿā').\n  * Al-Raghib (Mufradat): Al-ṣalāh from God is pure mercy and beneficence; from angels it is their petition for forgiveness; from humans it is humble supplication. The divine ṣalāh upon the Prophet is an elevation of his mention and an increase in his honor.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): supplication and bending in worship. Metaphorical (majāz): God's ṣalāh upon the Prophet is His mercy and His exaltation of him before the angels; the believers' ṣalāh is their invocation and reverence.\n- Root: سلم (S-L-M)\n  * Lisan / Ayn: Root denotes safety, peace, deliverance; taslīm is the greeting of peace and submission.\n  * Al-Raghib (Mufradat): Salām from God is His safeguarding; the greeting of salām upon the Prophet is an acknowledgment of his prophetic rank and a prayer for his perfect safety.\n  * Al-Zamakhshari (Asas): Literal: greeting of peace. Metaphorical: the angels' conveyance of the believers' salām to the Prophet even after his death, indicating the enduring bond.\n- Root: حمد (Ḥ-M-D)\n  * Lisan / Ayn: Core root denotes praise, commendation; maḥmūd is the one praised.\n  * Al-Raghib (Mufradat): Ḥamd is praise for voluntary beneficence; al-ḥamd li-Llāh encompasses all praise due to God's perfect attributes.\n  * Al-Zamakhshari (Asas): Literal: to praise for good. Metaphorical: to find praiseworthy (aḥmadtu al-arḍ: I found the land agreeable).\n- Sibawayh Rule: Rule of Interposition (al-faṣl bayna al-jār wa al-majrūr) — The periodic structure of the ḥadīth reports here follows the canonical pattern of embedding quoted speech within narrative frames, maintaining syntactic cohesion across multiple levels of reported discourse.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'On Invocations and Supplications'", "badge": "Afterlife"}, {"arabic": "وقال صالح المري قرأت على رجل من المتعبدين {يوم تقلب وجوههم في النار يقولون يا ليتنا أطعنا الله وأطعنا الرسولا} فصعق ثم أفاق فقال زدني يا صالح فإني أجد غما فقرأت {كلما أرادوا أن يخرجوا منها أعيدوا فيها} فخر ميتا وروى أن زرارة بن أبي أوفى صلى بالناس الغداة فلما قرأ {فإذا نقر في الناقور} خر مغشيا عليه فحمل ميتا ودخل يزيد الرقاشي على عمر بن عبد العزيز فقال عظني يا يزيد فقال يا أمير المؤمنين اعلم أنك لست أول خليفة يموت فبكى ثم قال زدني قال يا أمير المومنين ليس بينك وبين آدم أب إلا ميت فبكى ثم قال زدني يا يزيد فقال يا أمير المؤمنين ليس بينك وبين الجنة والنار منزل فخر مغ", "english": "Al-Ḥasan [al-Baṣrī] passed by a young man who was completely absorbed in his laughter, sitting with a group of people in a gathering. Al-Ḥasan said to him: \"O young man, have you crossed the Ṣirāṭ [the Bridge]?\" He said: \"No.\" He said: \"Then do you know whether you will go to Paradise or to the Fire?\" He said: \"No.\" He said: \"Then what is this laughter?\" He said: \"And that young man was never seen laughing after that.\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1062", "section_title_en": "The States of Fear and the Severity of Khawf — Accounts of the Early Pious (Section 1062)", "section_index": 1062, "anchors": "- Root: ضحك (Ḍaḥika)\n  * Lisan / Ayn: Core meaning is laughter, arising from a state of heedlessness or joy; its opposite is weeping (bukā') which accompanies khashyah.\n  * Al-Raghib (Mufradat): Laughter is a human accident (ʿaraḍ) indicating the heart's occupation with worldly pleasure, contra the state of the God-fearing whose hearts are preoccupied with divine threat.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for audible laughter; metaphorical (majāz) for the soul's levity and forgetfulness of the reckoning.\n- Root: خوف (Khawf)\n  * Lisan / Ayn: Fear, dread, anxiety of anticipated harm; in the Kalam context, it is the soul's perturbation due to probable punishment.\n  * Al-Raghib (Mufradat): Khawf is distinguished from khashyah — khashyah is specific to knowledge-based fear of Allah's majesty, while khawf is broader; here, the accounts blend both as the engine of righteous action.\n  * Al-Zamakhshari (Asas): Literal for fear of a known threat; metaphorical for the \"fear\" that severs the liver (qataʿa al-kabid), i.e., a spiritual state overwhelming the corporeal frame.\n- Root: أمن (Amn)\n  * Lisan / Ayn: Security, safety, freedom from fear; its root denotes tranquility of heart.\n  * Al-Raghib (Mufradat): Amn is the cessation of fear, which in this world is only proper for the prophets and angels in specific contexts; for the sinner, it is a delusion (ghurūr).\n  * Al-Zamakhshari (Asas): Literal for physical safety; metaphorical for spiritual complacency, which is blameworthy — as in the saying of Ḥammād: \"That is the sitting of the secure one.\"\n- Sibawayh Rule: Rule of Restriction with إنما (Innamā) — as in \"إنما جعل الله هذه الغفلة\" and \"إنما أغبط من لم يخلق\" — where the predicate is restricted to the subject, emphasizing exclusive causation or exclusive object of envy, per the canonical pattern of ḥaṣr.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Fear and Hope'", "badge": "Afterlife"}], "69": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "70": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "71": [{"arabic": "وخطب رجل عند رسول الله صلى الله عليه وسلم فقال من يطع الله ورسوله فقد رشد ومن يعصهما فقد غوى فقال قل ومن يعص الله ورسوله فقد غوى (2) فكره رسول الله صلى الله عليه وسلم قوله ومن يعصهما لأنه تسوية وجمع وكان إبراهيم يكره أن يقول الرجل أعوذ بالله وبك ويجوز أن يقول أعوذ بالله ثم بك وأن يقول لولا الله ثم فلان ولا يقول لولا الله وفلان وكره بعضهم أن يقال اللهم أعتقنا من النار وكان يقول العتق يكون بعد الورود وكانوا يستجيرون من النار ويتعوذون من النار وقال رجل اللهم اجعلني ممن تصيبه شفاعة محمد صلى الله عليه وسلم فق", "english": "An example of this is what Ḥudhayfah reported: The Prophet, peace be upon him, said: \"Let none of you say: 'What Allah willed and you willed' — but rather let him say: 'What Allah willed, then you willed.'\" (5) This is because in the absolute conjunction [with \"and\"] there is an association and an equalization, which is contrary to [the due measure of] reverence. And Ibn ʿAbbās, may Allah be pleased with them both, said: A man came to the Messenger of Allah, peace be upon him, speaking to him concerning some matter, and he said: \"What Allah willed and you willed.\" The Prophet, peace be upon him, said: \"Have you made me an equal to Allah? Rather, [say]: 'What Allah willed alone.'\" (1)", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 698", "section_title_en": "The Revival of the Religious Sciences — Section 698: The Nineteenth Affliction — Heedlessness Regarding Subtle Errors in the Import of Speech", "section_index": 698, "anchors": "- Root: غفل (ghafla)\n  * Lisan / Ayn: Core meaning of heedlessness, neglect, and inattention; the absence of vigilance over a matter.\n  * Al-Raghib (Mufradat): Heedlessness (al-ghafla) is the soul's failure to attend to what it is obligated to know or consider; it is the opposite of mindfulness (al-tayaqquẓ) and remembrance (al-dhikr).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes the absence of guarding; metaphorical (majāz) usage extends to the tongue's straying from precise expression in sacred matters.\n- Root: عطف (ʿaṭf)\n  * Lisan / Ayn: Inclination, turning, or joining one thing to another; grammatically, the conjunction that links two items in a shared ruling.\n  * Al-Raghib (Mufradat): Joining (al-ʿaṭf) implies equal treatment of the conjoined items; in theological speech, absolute conjunction (al-ʿaṭf al-muṭlaq) with Allah entails an inadmissible association.\n  * Al-Zamakhshari (Asas): Literal: the bending of a staff or the inclining of a branch; metaphorical: the grammatical coupling that levels two referents under one predicate.\n- Root: شرك (shirk)\n  * Lisan / Ayn: Sharing, partnership, or association; the root of polytheism (al-shirk) as the ascription of a partner to Allah.\n  * Al-Raghib (Mufradat): Association (al-shirk) is the equalization of two things in a shared ruling; in theology, it is the gravest form when applied to the Divine, whether in belief or in the mere wording of speech.\n  * Al-Zamakhshari (Asas): Literal: co-participation in ownership; metaphorical: any verbal or creedal equalization of the creature with the Creator.\n- Sibawayh Rule: Rule of Conjunction (al-ʿaṭf) and Restriction (al-ḥaṣr) — The particle \"thumma\" (then) indicates sequential ordering and distinction of rank, whereas \"wa\" (and) denotes absolute conjunction and mutual equivalence; thus the Prophet's command to replace \"wa\" with \"thumma\" in \"what Allah willed and you willed\" is a syntactic correction to abolish the implication of equal partnership.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Condemnation of Anger and Hatred'", "badge": "Du'a"}, {"arabic": "أما من كان مستعدا فقد فاز فوزا عظيما وأما من كان مغرورا بطول الأمل فقد خسر خسرانا مبينا فلينظر الإنسان كل ساعة في أطرافه وأعضائه وليتدبر أنها كيف تأكلها الديدان لا محالة وكيف تتفتت عظامها وليتفكر أن الدود يبدأ بحدقته اليمنى أولا أو اليسرى فما على بدنه شيء إلا وهو طعمة الدود وما له من نفسه إلا العلم والعمل الخالص لوجه الله تعالى وكذلك يتفكر فيما سنورده من عذاب القبر وسؤال منكر ونكير ومن الحشر والنشر وأهوال القيامة وقرع النداء يوم العرض الأكبر فأمثال هذه الأفكار هي التي", "english": "He defers day after day, and one occupation passes him on to another — nay, to many occupations — until death snatches him away at a moment he does not anticipate. Then his regret becomes prolonged, and most of the people of the Fire — and their screaming — are from \"I will\" (sawfa). They say: \"Woe to us for our 'I will'!\" (wa-ḥazanāh min sawfa).", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1288", "section_title_en": "The True Nature of Procrastination (al-Taswīf): Its Causes and Cures — On the Deception of Extended Hope (ṭūl al-amal)", "section_index": 1288, "anchors": "- Root: سوف (s-w-f)\n  * Lisan / Ayn: \"سوف\" is a particle of future tense (tanjīz al-waʿd), indicating postponement and delay; al-musawwif is one who defers action.\n  * Al-Raghib (Mufradat): The root conveys \"delay\" (taʾkhīr) and is tied to the blameworthy trait of procrastination in religious duties, as opposed to immediate resolve (mubādarah).\n  * Al-Zamakhshari (Asas): Literal: \"سوّفت به\" (I delayed him). Metaphorical: \"سوّف بنفسه\" — he lulled himself with false promises of future time, a majāz for self-deception.\n- Root: أمل (a-m-l)\n  * Lisan / Ayn: Hope/expectation (rajāʾ); ṭūl al-amal is extended hope — the root cause of negligence (ghaflah) in preparing for death.\n  * Al-Raghib (Mufradat): Amal is expectation of a desired outcome; blameworthy when it exceeds the appointed term (ajal), diverting from the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: \"أملت الشيء\" (I hoped for it). Metaphorical: Extended hope is a veil (ḥijāb) over the certainty of death.\n- Root: جهل (j-h-l)\n  * Lisan / Ayn: Ignorance, the opposite of knowledge (ʿilm); also rashness acting without knowledge.\n  * Al-Raghib (Mufradat): Jahl is the absence of knowledge about what one must know — here, ignorance of death's unpredictability.\n  * Al-Zamakhshari (Asas): Literal: lack of knowledge. Metaphorical: acting as if death is distant despite its certainty — a practical ignorance.\n- Root: حب (ḥ-b-b)\n  * Lisan / Ayn: Love/attachment (wudd); ḥubb al-dunyā is the love of the lower world.\n  * Al-Raghib (Mufradat): Love is the inclination of the heart toward what pleases it; love of the world (dunyā) is the root of all blameworthy traits.\n  * Al-Zamakhshari (Asas): Literal: affection. Metaphorical: \"ḥubb al-khaṭīr\" (love of the momentous) erases \"ḥubb al-ḥaqīr\" (love of the trivial) — a majāz for spiritual reorientation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used in \"فإنما يزداد بطول المدة قوة ورسوخا\" (it only increases in strength and rootedness with length of time), restricting the outcome to intensification alone.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "72": [{"arabic": "تعالى إنا عرضنا الأمانة على السموات والأرض والجبال فأبين أن يحملنها وأشفقن منها وحملها الإنسان إنه كان ظلوما جهولا قال عرضها على السموات السبع الطباق والطرائق التي زينها بالنجوم وحملة العرش العظيم فقال لها سبحانه وتعالى هل تحملين الأمانة بما فيها قالت وما فيها قال إن أحسنت جوزيت وإن أسأت عوقبت فقالت لا ثم عرضها كذلك على الأرض فأبت ثم عرضها على الجبال الشوامخ الصلاب الصعاب فقال لها هل تحملين الأمانة بما فيها قالت وما فيها فذكر الجزاء والعقوبة فقالت لا ثم عرضها على الإنسان فحملها إنه كان ظلوما لنفسه جهولا بأمر ربه فقد رأيناهم والله اشتروا الأمانة بأموالهم فأصابوا آل", "english": "It is related that al-Rashid gathered four physicians — an Indian, a Roman, an Iraqi, and a Sudanese — and said: \"Let each of you describe the medicine that has no disease in it.\" The Indian said: \"The medicine that has no disease in it, in my view, is black myrobalan (al-ihlīlaj al-aswad).\" The Iraqi said: \"It is white garden cress seeds (ḥabb al-rashād al-abyaḍ).\" The Roman said: \"In my view, it is hot water.\" The Sudanese — and he was the most learned of them — said: \"Myrobalan constricts the stomach, and this is a disease; garden cress loosens the stomach, and this is a disease; hot water relaxes the stomach, and this is a disease.\" They said: \"Then what is your view?\" He said: \"The medicine that has no disease with it, in my view, is that you do not eat food until you desire it, and that you raise your hand from it while you still desire it.\" They said: \"You have spoken truthfully.\" And it was mentioned to one of the philosophers among the physicians of the People of the Book the saying of the Prophet, peace be upon him: \"One third for food, one third for drink, and one third for breath.\" (1) The hadith \"Gluttony is the root of disease, and diet is the root of cure, and accustom every body to what it has become accustomed\" — I have not found for it a source. (2) The hadith \"Fast, and you will be healthy\" — narrated by al-Tabarani in al-Awsat and Abu Nuʿaym in al-Tibb al-Nabawi from the hadith of Abu Hurayrah with a weak chain. For in fasting, hunger, and the reduction of food is the health of bodies and the health of hearts from the sickness of tyranny, arrogance, and other than them.", "book_title": "Harms of the Tongue", "section_title_ar": "Section 643", "section_title_en": "The Book of Fasting — Section 643: Ten Benefits of Hunger and Fasting", "section_index": 643, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core root meaning \"to eat, consume, ingest\"; Kitab al-Ayn notes the verbal noun for the act of eating and its derivatives for food, morsels, and prey.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of nourishment; metaphorically extended to fire consuming wood, and to the daily portion of provision.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes physical ingestion; metaphorical (Majaz) usage extends to consuming wealth unjustly, as in \"أكل مال الشعب\" (devouring people's wealth), and to the body's wasting away.\n- Root: جوع (jaw')\n  * Lisan / Ayn: Core root meaning \"hunger, famine\"; Kitab al-Ayn: \"الجوع: اسم جامع للمخمصة\" — hunger is the comprehensive term for emptiness of the stomach.\n  * Al-Raghib (Mufradat): \"الجوع: الألم الذي ينال الحيوان من خلو المعدة من الطعام\" — hunger is the pain that befalls the living being from the emptiness of the stomach of food; al-majā'ah denotes a time of drought and scarcity.\n  * Al-Zamakhshari (Asas): Literal usage refers to bodily hunger; metaphorical usage extends to longing and yearning, as in \"جائع إلى لقائك\" (hungering for your meeting).\n- Root: بطن (baṭn)\n  * Lisan / Ayn: Core root meaning \"belly, abdomen, interior\"; Kitab al-Ayn: \"البطن معروف\" — the belly is well-known; its plural is buṭūn.\n  * Al-Raghib (Mufradat): \"أصل البطن الجارحة\" — the root meaning is the bodily organ; metaphorically applied to the interior of things, the underside, and the hidden aspect of affairs.\n  * Al-Zamakhshari (Asas): Literal usage denotes the physical belly; metaphorical usage extends to the middle of youth, the interior of a valley, and the hidden dimension of a matter.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the author states \"وإنما يستحقرها الغافلون\" (only the heedless belittle them), the particle innamā restricts the predicate to the subject, affirming that belittlement proceeds exclusively from the heedless and negating it from the knowing.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Harms of the Tongue'", "badge": "Insight"}, {"arabic": "يا أمير المؤمنين إنك قد بليت بأمر لو عرض على السموات والأرض والجبال لأبين أن يحملنه وأشفقن منه يا أمير المؤمنين حدثني يزيد بن جابر عن عبد الرحمن بن عمرة الأنصاري أن عمر بن الخطاب رضي الله عنه استعمل رجلا من الأنصار على الصدقة فرآه بعد أيام مقيما فقال له ما منعك من الخروج إلى عملك أما علمت أن لك مثل أجر المجاهد في سبيل الله قال لا قال وكيف ذلك قال إنه بلغني أن رسول الله صلى الله عليه وسلم قال ما من وال يلي شيئا من أمور الناس إلا أتى به يوم القيامة مغلولة يده إلى عنقه لا يفكها إلا عدله فيوقف على جسر من النار ينتفض به ذلك الجسر انتفاضة ت", "english": "He turned to al-Shaʿbī and said: \"O Abā ʿAmr! I am the trustee of the Commander of the Faithful over Iraq and his governor over it, and a man commanded to obedience. I have been tried with the subjects, and their right has become incumbent upon me. So I love to preserve them and to attend to what sets them right, along with sincere counsel (naṣīḥah) to them. And reports may reach me about a band of people from the regions concerning a matter, and I find myself severe against them therein, so I withhold a portion of their stipends and place it in the treasury (bayt al-māl), with the intention in myself that I shall return it to them. Then it reaches the Commander of the Faithful that I have withheld it in that manner, so he writes to me that I must not return it. I cannot then countermand his order, nor can I execute his letter [against my better judgment]. I am but a man commanded to obedience. Is there any liability upon me in this, and in similar matters, where the intention is as I have described?\"", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 553", "section_title_en": "The Upright Scholars Before the Tyrannical Rulers — Counsel and Fearless Truth-Telling", "section_index": 553, "anchors": "- Root: نصح (naṣaḥa)\n  * Lisan / Ayn: Core meaning is sincerity, faithfulness, and pure counsel free from deceit; the root denotes the act of seeking the welfare of another with complete integrity.\n  * Al-Raghib (Mufradat): In theological context, naṣīḥah is the obligation of the sincere advisor to guide the ruler toward divine truth, even at personal peril, as it is a form of worship (ʿibādah) and a trust (amānah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes pure honey (ʿasal naṣīḥ) free from admixture; metaphorical (majāz) usage applies to counsel that is untainted by flattery or self-interest.\n- Root: سلط (sulṭ)\n  * Lisan / Ayn: Denotes authority, power, and dominion; the ruler (sulṭān) is one who has been given sway over affairs.\n  * Al-Raghib (Mufradat): In Kalam, sulṭān is a trial (ibtilāʾ) and a trust (amānah) from God, whose exercise demands justice (ʿadl) and whose neglect invites divine wrath.\n  * Al-Zamakhshari (Asas): Literal usage refers to physical power or a governing authority; metaphorical usage extends to the authority of proof (sulṭān al-burhān) that compels assent.\n- Root: عظ (waʿaẓa)\n  * Lisan / Ayn: Root denotes admonition, exhortation, and reminding of consequences; it implies softening the heart through remembrance of God and the Hereafter.\n  * Al-Raghib (Mufradat): In theological terms, ʿiẓah is the act of turning the soul away from transgression through a blend of fear (tarhīb) and hope (targhīb), grounded in revealed truth.\n  * Al-Zamakhshari (Asas): Literal usage is the verbal admonition; metaphorical usage is the admonition of circumstance (ʿiẓah al-ḥāl) when events themselves teach a lesson.\n- Sibawayh Rule: Rule of Restriction and Focused Predication (bāb al-ḥaṣr wa al-taqyīd bi-innamā) — Governing the emphasis of exclusive predication in statements of counsel, such as \"No obedience to a creature in disobedience of the Creator,\" where the restriction (ḥaṣr) is achieved through negation and exception (nafy wa istithnāʾ).", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Enjoining Good and Forbidding Evil'", "badge": "Afterlife"}, {"arabic": "وإليه الإشارة بقوله عز وجل إنا عرضنا الأمانة على السموات والأرض والجبال فأبين أن يحملنها وأشفقن منها وحملها الإنسان إشارة إلى أن له خاصية تميز بها عن السموات والأرض والجبال بها صار مطيقا لحمل أمانة الله تعالى وتلك الأمانة هي المعرفة والتوحيد وقلب كل آدمي مستعد لحمل الأمانة ومطيق لها في الأصل ولكن يثبطه عن النهوض بأعبائها والوصول إلى تحقيقها الأسباب التي ذكرناها ولذلك قال صلى الله عليه وسلم كل مولود يولد على الفطرة وإنما أبواه يهودانه وينصرانه ويمجسانه // حديث كل مولود يولد على الفطرة الحديث متفق عليه من حديث أبي هريرة وقول رسول الله", "english": "And to this points His saying, mighty and majestic: {«Indeed, We offered the Trust to the heavens and the earth and the mountains, and they refused to bear it and shrank from it, but man bore it»} (al-Aḥzāb 33:72) — an indication that he possesses a distinctive property by which he is set apart from the heavens, the earth, and the mountains, and by which he became capable of bearing the Trust of God, exalted.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 584", "section_title_en": "The Exposition of the Heart's Relation to the Sciences Specifically", "section_index": 584, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: Core meaning of turning, overturning, and transformation from one state to another; the heart as that which is perpetually subject to reversal and fluctuation.\n  * Al-Raghib (Mufradat): The heart (qalb) is so named for its constant turning (taqlīb) and fluctuation between states; it is the seat of cognition and the instrument by which the soul apprehends realities.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): the physical organ that turns over. Metaphorical (majāz): the subtle spiritual faculty (laṭīfah rabbāniyyah) that apprehends knowledge — the true referent here.\n- Root: فطر (f-ṭ-r)\n  * Lisan / Ayn: Splitting lengthwise; origination and initial creation.\n  * Al-Raghib (Mufradat): Fiṭrah is the primordial constitution upon which God originates creation — the innate disposition receptive to truth.\n  * Al-Zamakhshari (Asas): Literal: God's act of originating creation. Metaphorical: \"Every newborn is born upon the fiṭrah\" — i.e., the innate disposition capable of accepting the religion of truth.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: Origination after non-existence; newness.\n  * Al-Raghib (Mufradat): Ḥudūth is the coming-to-be of a thing after it was not; the created order is entirely contingent and originated.\n  * Al-Zamakhshari (Asas): Literal: temporal origination. Metaphorical: \"Umar was muḥaddath\" — one whose discernment is divinely inspired, as if truth were spoken into him.\n- Root: سبب (s-b-b)\n  * Lisan / Ayn: A rope by which one ascends; a means of access.\n  * Al-Raghib (Mufradat): Every means by which one reaches something is called a sabab; the impediments to knowledge are \"causes\" (asbāb) that veil the heart.\n  * Al-Zamakhshari (Asas): Literal: a cord or tie. Metaphorical: any intermediary, cause, or hindering factor.\n- Sibawayh Rule: Restriction and specification (al-ḥaṣr wa al-taqyīd) — the particle \"innamā\" (إِنَّمَا) confines and restricts predication, as in \"every heart is by fiṭrah fit for knowledge\" — a universal affirmative qualified by its cause.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "ويتلون وجهه فقيل له مالك يا أمير المؤمنين فيقول جاء وقت أمانة عرضها الله على السموات والأرض والجبال فأبين أن يحملنها وأشفقن منها وحملتها ويروى عن علي بن الحسين أنه كان إذا توضأ اصفر لونه فيقول له أهله ما هذا الذي يعتريك عند الوضوء فيقول أتدرون بين يدي من أريد أن أقوم ويروى عن ابن عباس رضي الله عنهما أنه قال قال داود عليه السلام في مناجاته إلهي من يسكن بيتك وممن تتقبل الصلاة فأوحى الله إليه يا داود إنما يسكن بيتي وأقبل الصلاة منه من تواضع لعظمتي وقطع نهاره بذكري وكف نفسه عن الشهوات من أجلي يطعم الجائع ويؤوي الغريب ويرحم المصاب فذلك الذي يضيء نوره في السموات كالشمس إن دعاني لبي", "english": "God—Exalted is He—said: {«And establish prayer for My remembrance»} (Q 20:14). And He—Exalted is He—said: {«And be not among the heedless»} (Q 7:205). And He—Mighty and Majestic—said: {«Do not approach prayer while you are intoxicated until you know what you are saying»} (Q 4:43). It was said: \"intoxicated\" from the excess of worldly concern (al-hamm), and it was said: from love of this world.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 124", "section_title_en": "The Virtue of Humble Devotion (Khusḥūʿ) in Prayer", "section_index": 124, "anchors": "- Root: خشع (Khashaʿa)\n  * Lisan / Ayn: \"الخشوع: التواضع والسكون، وخشع بصره: غضه وأطرقه، وخشعت الأصوات: سكنت وخفضت\"\n  * Al-Raghib (Mufradat): \"الخشوع: الضراعة والاستكانة، وأصله الانخفاض والتطامن، ويقال للصوت الخفيض والطرف المنكسر\"\n  * Al-Zamakhshari (Asas): \"Literal: خشع الرجل: خفض رأسه وتواضع. Metaphorical: خشع القلب: خضع وذل وسكن لله\"\n- Root: سكر (Sukr)\n  * Lisan / Ayn: \"السكر: نقيض الصحو، والسكران: الذي غطى عقله، وكل شيء غطى فقد سكر\"\n  * Al-Raghib (Mufradat): \"السكر: حالة تعرض بين العقل وبين إدراكه، ويستعار لما يغطي العقل من الهم وحب الدنيا\"\n  * Al-Zamakhshari (Asas): \"Literal: سكر من الشراب. Metaphorical: سكر الهم وحب الدنيا — ما يغطي العقل عن إدراك المقام\"\n- Root: ندم (Nadama)\n  * Lisan / Ayn: \"الندم: التحسر على ما فات، والندامة: التوبة، والنادم: المتحسر\"\n  * Al-Raghib (Mufradat): \"الندم: انكسار النفس لما فرط، وهو من لوازم التوبة\"\n  * Al-Zamakhshari (Asas): \"Literal: ندم على الشيء: تحسر. Metaphorical: تنادم في الصلاة: استحضار التقصير والانكسار بين يدي الله\"\n- Root: وجب (Wajaba)\n  * Lisan / Ayn: \"وجب القلب: اضطرب وخفق، ووجب الشيء: ثبت ولزم، والوجيب: صوت خفقان القلب\"\n  * Al-Raghib (Mufradat): \"الوجيب: اضطراب القلب من هيبة الأمر وعظمته\"\n  * Al-Zamakhshari (Asas): \"Literal: وجب الباب: أغلقه. Metaphorical: وجيب القلب: خفقانه من الخوف والهيبة\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما الصلاة تمسكن\" restricts prayer's essence to humility, excluding distraction and heedlessness.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Prayer'", "badge": "Insight"}]}, "wordTiming": {"minshawi": {"1": [[1, 590, 3411], [2, 3411, 4691], [3, 4691, 5266], [4, 5266, 5962], [5, 5962, 7024], [6, 7024, 7633], [7, 7633, 9122], [8, 9122, 11237], [9, 11237, 11829], [10, 11829, 12525], [11, 12525, 13343], [12, 13343, 14797], [13, 14797, 16570]], "33:1": [[1, 590, 3411], [2, 3411, 4691], [3, 4691, 5266], [4, 5266, 5962], [5, 5962, 7024], [6, 7024, 7633], [7, 7633, 9122], [8, 9122, 11237], [9, 11237, 11829], [10, 11829, 12525], [11, 12525, 13343], [12, 13343, 14797], [13, 14797, 16570]], "2": [[1, 10, 1232], [2, 1232, 1902], [3, 1902, 4274], [4, 4274, 5143], [5, 5143, 5505], [6, 5505, 6320], [7, 6320, 6936], [8, 6936, 7660], [9, 7660, 8511], [10, 8511, 9362], [11, 9362, 10747], [12, 10747, 12600]], "33:2": [[1, 10, 1232], [2, 1232, 1902], [3, 1902, 4274], [4, 4274, 5143], [5, 5143, 5505], [6, 5505, 6320], [7, 6320, 6936], [8, 6936, 7660], [9, 7660, 8511], [10, 8511, 9362], [11, 9362, 10747], [12, 10747, 12600]], "3": [[1, 10, 1483], [2, 1483, 2146], [3, 2146, 2835], [4, 2835, 4089], [5, 4089, 4951], [6, 4951, 6930]], "33:3": [[1, 10, 1483], [2, 1483, 2146], [3, 2146, 2835], [4, 2835, 4089], [5, 4089, 4951], [6, 4951, 6930]], "4": [[1, 200, 1179], [2, 1179, 1828], [3, 1828, 2627], [4, 2627, 3426], [5, 3426, 4065], [6, 4065, 5224], [7, 5224, 5744], [8, 5744, 6643], [9, 6643, 7862], [10, 7862, 8511], [11, 8511, 10126], [12, 10126, 12129], [13, 12129, 13837], [14, 13837, 14856], [15, 14856, 16459], [16, 16459, 17678], [17, 17678, 18327], [18, 18327, 21734], [19, 21734, 24611], [20, 24611, 25606], [21, 25606, 26765], [22, 26765, 28559], [23, 28559, 29838], [24, 29838, 31237], [25, 31237, 32146], [26, 32146, 33285], [27, 33285, 34464], [28, 34464, 36000]], "33:4": [[1, 200, 1179], [2, 1179, 1828], [3, 1828, 2627], [4, 2627, 3426], [5, 3426, 4065], [6, 4065, 5224], [7, 5224, 5744], [8, 5744, 6643], [9, 6643, 7862], [10, 7862, 8511], [11, 8511, 10126], [12, 10126, 12129], [13, 12129, 13837], [14, 13837, 14856], [15, 14856, 16459], [16, 16459, 17678], [17, 17678, 18327], [18, 18327, 21734], [19, 21734, 24611], [20, 24611, 25606], [21, 25606, 26765], [22, 26765, 28559], [23, 28559, 29838], [24, 29838, 31237], [25, 31237, 32146], [26, 32146, 33285], [27, 33285, 34464], [28, 34464, 36000]], "5": [[1, 200, 1524], [2, 1524, 4614], [3, 4614, 5221], [4, 5221, 6161], [5, 6161, 6759], [6, 6759, 7495], [7, 7495, 8083], [8, 8083, 8589], [9, 8589, 11191], [10, 11191, 14005], [11, 14005, 15702], [12, 15702, 16180], [13, 16180, 17375], [14, 17375, 19523], [15, 19523, 20645], [16, 20645, 21721], [17, 21721, 22788], [18, 22788, 25087], [19, 25087, 26338], [20, 26338, 26687], [21, 26687, 27827], [22, 27827, 28728], [23, 28728, 29914], [24, 29914, 31312], [25, 31312, 32618], [26, 32618, 33354], [27, 33354, 34871], [28, 34871, 36880]], "33:5": [[1, 200, 1524], [2, 1524, 4614], [3, 4614, 5221], [4, 5221, 6161], [5, 6161, 6759], [6, 6759, 7495], [7, 7495, 8083], [8, 8083, 8589], [9, 8589, 11191], [10, 11191, 14005], [11, 14005, 15702], [12, 15702, 16180], [13, 16180, 17375], [14, 17375, 19523], [15, 19523, 20645], [16, 20645, 21721], [17, 21721, 22788], [18, 22788, 25087], [19, 25087, 26338], [20, 26338, 26687], [21, 26687, 27827], [22, 27827, 28728], [23, 28728, 29914], [24, 299