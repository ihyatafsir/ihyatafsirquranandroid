": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "سَفَرٍ", "translit": "ٍrَfَs", "root": "سفر"}, {"id": 5, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 6, "arabic": "تَجِدُوا۟", "translit": "۟āwُdِjgَt", "root": "وجد"}, {"id": 7, "arabic": "كَاتِبًا", "translit": "āًbِtāَk", "root": "كتب"}, {"id": 8, "arabic": "فَرِهَٰنٌ", "translit": "ٌnَٰhِrَf", "root": "رهن"}, {"id": 9, "arabic": "مَّقْبُوضَةٌ", "translit": "ٌẗَḍwُbْqَّm", "root": "قبض"}, {"id": 10, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 11, "arabic": "أَمِنَ", "translit": "َnِmَaʾ", "root": "امن"}, {"id": 12, "arabic": "بَعْضُكُم", "translit": "mُkُḍْʿعَb", "root": "بعض"}, {"id": 13, "arabic": "بَعْضًا", "translit": "āًḍْʿعَb", "root": "بعض"}, {"id": 14, "arabic": "فَلْيُؤَدِّ", "translit": "ِّdَwʾُyْlَf", "root": "ادي"}, {"id": 15, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "ٱؤْتُمِنَ", "translit": "َnِmُtْwʾٱ", "root": "امن"}, {"id": 17, "arabic": "أَمَٰنَتَهُۥ", "translit": "ۥُhَtَnَٰmَaʾ", "root": "امن"}, {"id": 18, "arabic": "وَلْيَتَّقِ", "translit": "ِqَّtَyْlَw", "root": "وقي"}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "رَبَّهُۥ", "translit": "ۥُhَّbَr", "root": "ربب"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "تَكْتُمُوا۟", "translit": "۟āwُmُtْkَt", "root": "كتم"}, {"id": 23, "arabic": "ٱلشَّهَٰدَةَ", "translit": "َẗَdَٰhَّhslٱ", "root": "شهد"}, {"id": 24, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 25, "arabic": "يَكْتُمْهَا", "translit": "āَhْmُtْkَy", "root": "كتم"}, {"id": 26, "arabic": "فَإِنَّهُۥٓ", "translit": "ٓۥُhَّnِiʾَf", "root": ""}, {"id": 27, "arabic": "ءَاثِمٌ", "translit": "ٌmِhtāَء", "root": "اثم"}, {"id": 28, "arabic": "قَلْبُهُۥ", "translit": "ۥُhُbْlَq", "root": "قلب"}, {"id": 29, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 30, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 31, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 32, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 284, "text": "لِّلَّهِ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۗ وَإِن تُبْدُوا۟ مَا فِىٓ أَنفُسِكُمْ أَوْ تُخْفُوهُ يُحَاسِبْكُم بِهِ ٱللَّهُۖ فَيَغْفِرُ لِمَن يَشَآءُ وَيُعَذِّبُ مَن يَشَآءُۗ وَٱللَّهُ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "To Allāh belongs whatever is in the heavens and whatever is in the earth. Whether you show what is within yourselves or conceal it, Allāh will bring you to account for it. Then He will forgive whom He wills and punish whom He wills, and Allāh is over all things competent.", "words": [{"id": 1, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 9, "arabic": "تُبْدُوا۟", "translit": "۟āwُdْbُt", "root": "بدو"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 12, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 13, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 14, "arabic": "تُخْفُوهُ", "translit": "ُhwُfْhkُt", "root": "خفي"}, {"id": 15, "arabic": "يُحَاسِبْكُم", "translit": "mُkْbِsāَḥُy", "root": "حسب"}, {"id": 16, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "فَيَغْفِرُ", "translit": "ُrِfْغَyَf", "root": "غفر"}, {"id": 19, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 20, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 21, "arabic": "وَيُعَذِّبُ", "translit": "ُbِّhdَʿعُyَw", "root": "عذب"}, {"id": 22, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 23, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 24, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 25, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 26, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 27, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 28, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 285, "text": "ءَامَنَ ٱلرَّسُولُ بِمَآ أُنزِلَ إِلَيْهِ مِن رَّبِّهِۦ وَٱلْمُؤْمِنُونَۚ كُلٌّ ءَامَنَ بِٱللَّهِ وَمَلَٰٓئِكَتِهِۦ وَكُتُبِهِۦ وَرُسُلِهِۦ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِّن رُّسُلِهِۦۚ وَقَالُوا۟ سَمِعْنَا وَأَطَعْنَاۖ غُفْرَانَكَ رَبَّنَا وَإِلَيْكَ ٱلْمَصِيرُ ", "translation": "The Messenger has believed in what was revealed to him from his Lord, and [so have] the believers. All of them have believed in Allāh and His angels and His books and His messengers, [saying], \"We make no distinction between any of His messengers.\" And they say, \"We hear and we obey. [We seek] Your forgiveness, our Lord, and to You is the [final] destination.\"", "words": [{"id": 1, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 2, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 3, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 4, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 5, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "رَّبِّهِۦ", "translit": "ۦِhِّbَّr", "root": "ربب"}, {"id": 8, "arabic": "وَٱلْمُؤْمِنُونَ", "translit": "َnwُnِmْwʾُmْlٱَw", "root": "امن"}, {"id": 9, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 10, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 11, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 12, "arabic": "وَمَلَٰٓئِكَتِهِۦ", "translit": "ۦِhِtَkِyʾَٰٓlَmَw", "root": "ملك"}, {"id": 13, "arabic": "وَكُتُبِهِۦ", "translit": "ۦِhِbُtُkَw", "root": "كتب"}, {"id": 14, "arabic": "وَرُسُلِهِۦ", "translit": "ۦِhِlُsُrَw", "root": "رسل"}, {"id": 15, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 16, "arabic": "نُفَرِّقُ", "translit": "ُqِّrَfُn", "root": "فرق"}, {"id": 17, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 18, "arabic": "أَحَدٍ", "translit": "ٍdَḥَaʾ", "root": "احد"}, {"id": 19, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 20, "arabic": "رُّسُلِهِۦ", "translit": "ۦِhِlُsُّr", "root": "رسل"}, {"id": 21, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 22, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 23, "arabic": "وَأَطَعْنَا", "translit": "āَnْʿعَṭَaʾَw", "root": "طوع"}, {"id": 24, "arabic": "غُفْرَانَكَ", "translit": "َkَnāَrْfُغ", "root": "غفر"}, {"id": 25, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 26, "arabic": "وَإِلَيْكَ", "translit": "َkْyَlِiʾَw", "root": ""}, {"id": 27, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": true}, {"ayah": 286, "text": "لَا يُكَلِّفُ ٱللَّهُ نَفْسًا إِلَّا وُسْعَهَاۚ لَهَا مَا كَسَبَتْ وَعَلَيْهَا مَا ٱكْتَسَبَتْۗ رَبَّنَا لَا تُؤَاخِذْنَآ إِن نَّسِينَآ أَوْ أَخْطَأْنَاۚ رَبَّنَا وَلَا تَحْمِلْ عَلَيْنَآ إِصْرًا كَمَا حَمَلْتَهُۥ عَلَى ٱلَّذِينَ مِن قَبْلِنَاۚ رَبَّنَا وَلَا تُحَمِّلْنَا مَا لَا طَاقَةَ لَنَا بِهِۦۖ وَٱعْفُ عَنَّا وَٱغْفِرْ لَنَا وَٱرْحَمْنَآۚ أَنتَ مَوْلَىٰنَا فَٱنصُرْنَا عَلَى ٱلْقَوْمِ ٱلْكَٰفِرِينَ ", "translation": "Allāh does not charge a soul except [with that within] its capacity. It will have [the consequence of] what [good] it has gained, and it will bear [the consequence of] what [evil] it has earned. \"Our Lord, do not impose blame upon us if we have forgotten or erred. Our Lord, and lay not upon us a burden like that which You laid upon those before us. Our Lord, and burden us not with that which we have no ability to bear. And pardon us; and forgive us; and have mercy upon us. You are our protector, so give us victory over the disbelieving people.\"[1]", "words": [{"id": 1, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 2, "arabic": "يُكَلِّفُ", "translit": "ُfِّlَkُy", "root": "كلف"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "نَفْسًا", "translit": "āًsْfَn", "root": "نفس"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "وُسْعَهَا", "translit": "āَhَʿعْsُw", "root": "وسع"}, {"id": 7, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 10, "arabic": "وَعَلَيْهَا", "translit": "āَhْyَlَʿعَw", "root": ""}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "ٱكْتَسَبَتْ", "translit": "ْtَbَsَtْkٱ", "root": "كسب"}, {"id": 13, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "تُؤَاخِذْنَآ", "translit": "ٓāَnْhdِhkāَwʾُt", "root": "اخذ"}, {"id": 16, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 17, "arabic": "نَّسِينَآ", "translit": "ٓāَnyِsَّn", "root": "نسي"}, {"id": 18, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 19, "arabic": "أَخْطَأْنَا", "translit": "āَnْaʾَṭْhkَaʾ", "root": "خطا"}, {"id": 20, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "تَحْمِلْ", "translit": "ْlِmْḥَt", "root": "حمل"}, {"id": 23, "arabic": "عَلَيْنَآ", "translit": "ٓāَnْyَlَʿع", "root": ""}, {"id": 24, "arabic": "إِصْرًا", "translit": "āًrْṣِiʾ", "root": "اصر"}, {"id": 25, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 26, "arabic": "حَمَلْتَهُۥ", "translit": "ۥُhَtْlَmَḥ", "root": "حمل"}, {"id": 27, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 28, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 29, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 30, "arabic": "قَبْلِنَا", "translit": "āَnِlْbَq", "root": "قبل"}, {"id": 31, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 32, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 33, "arabic": "تُحَمِّلْنَا", "translit": "āَnْlِّmَḥُt", "root": "حمل"}, {"id": 34, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 35, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 36, "arabic": "طَاقَةَ", "translit": "َẗَqāَṭ", "root": "طوق"}, {"id": 37, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 38, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 39, "arabic": "وَٱعْفُ", "translit": "ُfْʿعٱَw", "root": "عفو"}, {"id": 40, "arabic": "عَنَّا", "translit": "āَّnَʿع", "root": ""}, {"id": 41, "arabic": "وَٱغْفِرْ", "translit": "ْrِfْغٱَw", "root": "غفر"}, {"id": 42, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 43, "arabic": "وَٱرْحَمْنَآ", "translit": "ٓāَnْmَḥْrٱَw", "root": "رحم"}, {"id": 44, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 45, "arabic": "مَوْلَىٰنَا", "translit": "āَnٰàَlْwَm", "root": "ولي"}, {"id": 46, "arabic": "فَٱنصُرْنَا", "translit": "āَnْrُṣnٱَf", "root": "نصر"}, {"id": 47, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 48, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 49, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}], "tafsir": {"16": [{"arabic": "بالذي هو خير فأولئك الذين اشتروا الضلالة بالهدى فما ربحت تجارتهم وما كانوا مهتدين وأما المخلصون فإن الله تعالى اشترى منهم أنفسهم وأموالهم بأن لهم الجنة فلما رأوا أنهم تركوا تمتع عشرين سنة مثلا أو ثلاثين سنة بتمتع الأبد استبشروا ببيعهم الذي بايعوا به فهذا بيان المزهود فيه وإذا فهمت هذا علمت أن ما ذكره المتكلمون في حد الزهد لم يشيروا به إلا إلى بعض أقسامه فذكر كل واحد منهم ما رآه غالبا على نفسه أو على من كان يخاطبه فقال بشر رحمه الله تعالى الزهد في الدنيا هو الزهد في الناس وهذا إشارة إلى الزهد في الجاه خاصة وقال قاسم الجوعي", "english": "...or the attainment of the rank of martyrdom (al-shahādah). And whosoever among them died upon his bed would grieve bitterly over the loss of martyrdom — so much so that Khālid ibn al-Walīd, may Allah Most High be well pleased with him, when death approached him upon his bed, kept saying: \"How often did I deceive my soul [into battle], and charge upon the ranks, coveting martyrdom — and now I die the death of old women!\" When he died, eight hundred wounds from the marks of injuries were counted upon his body. Such was the state of the truthful ones in faith — may Allah Most High be well pleased with them all.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1093", "section_title_en": "Exposition of the Degrees of Asceticism (Zuhd) and Its Divisions — Relative to Itself, to That Which Is Renounced, and to That Which Is Sought", "section_index": 1093, "anchors": "- Root: زهد (Z-H-D)\n  * Lisan / Ayn: Core root meaning: scarcity, paucity, and abstemiousness; al-zuhd is also \"estimation/assessment\" (al-hazr), as in assessing a palm-crop.\n  * Al-Raghib (Mufradat): \"الزهيد: الشيء القليل\" — the ascetic (al-zāhid) is one who turns away from a thing, content with the little (al-qalīl) thereof; theological nuance: renunciation is a voluntary contentment with the lesser in exchange for the greater.\n  * Al-Zamakhshari (Asas): Haqiqah (literal): \"زهد في الشيء: رغب عنه\" — to turn away from a thing with aversion. Majaz (metaphorical): \"رجل زهيد: قليل الخير\" — a man of little good; \"اد زهيد\" — a valley that takes little water. Thus zuhd is literal renunciation, but its degrees vary by the object renounced.\n- Root: قصر (Q-S-R)\n  * Lisan / Ayn: To restrain, confine, hold back; also shortness as opposed to length.\n  * Al-Raghib (Mufradat): \"القصر: خلاف الطول\" — shortness is the opposite of length; both are relative terms (mutadāyifān) defined by comparison to another.\n  * Al-Zamakhshari (Asas): Haqiqah: \"قصرته: حبسته\" — I restrained him. \"وقصرت نفسي على هذا الأمر\" — I confined myself to this matter, not aspiring beyond it. Majaz: \"أقصر المطر: أقلع\" — the rain ceased; \"قصر الأمل\" — the shortening of hope/aspiration, a metaphorical restraint of the soul's reach.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, the soul; that which one desires to be near.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; in divine attribution, \"نفسه\" denotes His very essence (dhāt), not a separate entity.\n  * Al-Zamakhshari (Asas): Haqiqah: \"شيء نفيس\" — a precious thing. Majaz: \"دفق نفسه أي دمه\" — \"he poured out his self\" meaning his blood; thus nafs can denote the entire vital being given in sacrifice.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — When multiple predicates are attributed to a single subject (zuhd), each speaker's definition is a restricted specification (takhṣīṣ) of one division, not a comprehensive definition (ḥadd) of the whole genus. The syntactic pattern \"إنما هو كذا\" effects exclusive predication, signaling partial scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "22": [{"arabic": "مناكبها وقال تعالى الذى جعل لكم الأرض فراشا وقد أكثر فى كتابه العزيز ممن ذكر الأرض ليتفكر في عجائبها فظهرها مقر للأحياء وبطنها مرقد للأموات قال تعالى ألم نجعل الأرض كفاتا أحياء وأمواتا فانظر إلى الأرض وهى ميتة فإذا أنزل عليها الماء اهتزت وربت واخضرت وأنبتت عجائب النبات وخرجت منها أصناف الحيوانات ثم انظر كيف أحكم جوانب الأرض بالجبال الراسيات الشوامخ الصم الصلاب وكيف أودع المياه تحتها ففجر العيون وأسال الأنهار تجري على وجهها وأخرج من الحجارة اليابسة ومن التراب الكدر ماء رقيقا عذبا صافيا زلا", "english": "For the beast has no power over that; but as for man, God created for him the power, then he disabled it and disbelieved in God's grace therein. So those are like cattle — nay, they are even further astray from the way {فَأُولَٰئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ سَبِيلًا}.", "book_title": "Contemplation", "section_title_ar": "Section 1273", "section_title_en": "On Contemplating the Earth, Its Rivers, Mountains, and Minerals — Section 1273", "section_index": 1273, "anchors": "- Root: فكر (f-k-r)\n  * Lisan / Ayn: التفكر: تأمل القلب وتدبر الشيء، والفكر: إعمال النظر في الشيء\n  * Al-Raghib (Mufradat): الفكر: قوة العلم التي بها يدرك الإنسان، وقيل: هو ترتيب أمور معلومة للتأدي إلى مجهول\n  * Al-Zamakhshari (Asas): الفكر: تصرف القلب في النظر — literal: إعمال الروية؛ metaphorical: التفكر في ملكوت الله\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: التي عليها الناس، وجمعها أرضون\n  * Al-Raghib (Mufradat): الأرض: الجرم المقابل للسماء، ويعبر بها عن أسفل الشيء\n  * Al-Zamakhshari (Asas): literal: الأرض المهاد والفراش؛ metaphorical: تذلل الأرض وسكونها\n- Root: دحا (d-ḥ-w) / مهد (m-h-d)\n  * Lisan / Ayn: مهد: وطأ المكان وهيأه، والمهاد: الفراش الموطأ\n  * Al-Raghib (Mufradat): المهد: الموضع المهيأ للصبي، والمهاد: الأرض الموطأة\n  * Al-Zamakhshari (Asas): literal: فرش الأرض وتمهيدها؛ metaphorical: جعلها قارة ساكنة لا تميد\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — the interposed clause \"فانظر\" after \"إلى الأرض\" maintains grammatical continuity while allowing rhetorical pause.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Contemplation'", "badge": "Insight"}], "23": [{"arabic": "الله لفسدتا} وفي النبوة {وإن كنتم في ريب مما نزلنا على عبدنا فأتوا بسورة من مثله} وفي البعث {قل يحييها الذي أنشأها أول مرة} إلى غير ذلك من الآيات والأدلة ولم تزل الرسل صلوات الله عليهم يحاجون المنكرين ويجادلونهم قال تعالى {وجادلهم بالتي هي أحسن} فالصحابة رضي الله عنهم أيضا كانوا يحاجون المنكرين ويجادلون ولكن عند الحاجة وكانت الحاجة إليه قليلة في زمانهم وأول من سن دعوة المبتدعة بالمجادلة إلى الحق علي ابن أبي طالب رضي الله عنه إذ بعث ابن عباس رضي الله عنهما إلى الخوارج فكلمهم فقال ما تنقمون على إمامكم قالوا قاتل ولم يسب ولم يغنم", "english": "The mention of the proof (ḥujjah), the demand for it, and the search after it — how could these be prohibited, when God — may He be exalted — has said: {«قُلْ هَاتُوا بُرْهَانَكُمْ»} (Say: Bring forth your proof — Qur'an 2:111), and He — mighty and majestic — has said: {«لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَا مَنْ حَيَّ عَنْ بَيِّنَةٍ»} (So that he who perishes may perish upon clear evidence, and he who lives may live upon clear evidence — Qur'an 8:42), and He — may He be exalted — has said: {«هَلْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا»} (Have you any authority for this? — Qur'an 10:68), meaning a proof and demonstration, and He — may He be exalted — has said: {«قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ»} (Say: To God belongs the conclusive proof — Qur'an 6:149), and He — may He be exalted — has said: {«أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ»} (Have you not considered him who disputed with Abraham concerning his Lord? — Qur'an 2:258) up to His words: {«فَبُهِتَ الَّذِي كَفَرَ»} (So the one who disbelieved was confounded — Qur'an 2:258).", "book_title": "Foundations of Belief", "section_title_ar": "Section 77", "section_title_en": "The Revival of the Religious Sciences — Section 77: On the Permissibility of Theological Discourse (Kalām) and Its Early Practice", "section_index": 77, "anchors": "- Root: ح-د-ث (ḥ-d-th)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not; al-ḥadath: the novel event; al-ḥīdāth: origination.\"\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: a thing's becoming after it was not, whether accident or substance; iḥdāth: bringing it into existence. The origination of substances belongs to God alone.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'He is a recent event among events.' Metaphorical: 'They became topics of conversation (aḥādīth).'\"\n- Root: ح-ا-ج (ḥ-ā-j)\n  * Lisan / Ayn: \"Al-ḥājah: need of a thing, with desire for it; its plural: ḥājāt and ḥawā'ij.\"\n  * Al-Raghib (Mufradat): \"Al-ḥājah ilā al-shay': poverty toward it with love of it. God said: {«إِلَّا حَاجَةً فِي نَفْسِ يَعْقُوبَ»} (except a need in Jacob's soul — Qur'an 12:68).\"\n  * Al-Zamakhshari (Asas): \"Literal: need and want. The 'ḥājah' is that which one seeks to obtain.\"\n- Root: ك-و-ن (k-w-n)\n  * Lisan / Ayn: \"Kāna: to be, to exist; takwīn: bringing into being from non-existence.\"\n  * Al-Raghib (Mufradat): \"Al-kawn: existence after non-existence; the muḥdath (originated thing) is that brought forth after it was not.\"\n  * Al-Zamakhshari (Asas): \"Literal: being and becoming. Metaphorical: the continuous states of affairs.\"\n- Sibawayh Rule: Al-Faṣl bayna al-Jār wa-al-Majrūr (Prepositional Interposition) — The permissibility of separating a preposition from its object when the intervening clause is complete in meaning, as in the verse's structure of argumentation where the proof (ḥujjah) stands independently before its conclusion.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}], "25": [{"arabic": "والسلوى والعسل واللبن وأصناف كثيرة لا تحصى قال الله تعالى كلما رزقوا فيها من ثمرة رزقا قالوا هذا الذي رزقنا من قبل وأتوا به متشابها وذكر الله تعالى شراب أهل الجنة في مواضع كثيرة وقد قال ثوبان مولى رسول الله صلى الله عليه وسلم كنت قائما عند رسول الله صلى الله عليه وسلم فجاءه حبر من أحبار اليهود فذكر أسئلة إلى أن قال فمن أول إجازة يعني على الصراط فقال فقراء المهاجرين قال اليهودي فما تحفتهم حين يدخلون الجنة قال زيادة كبد الحوت قال فما غداؤهم على أثرها قال ينحر لهم ثور الجنة الذي كان يأكل في أطرافها قال فما شرابهم عليه قال من عين فيها تسمى سلسبيلا فقال صدقت (7) وقال زيد", "english": "The description of the food of the people of Paradise is mentioned in the Qur'an: fruits, fattened birds, manna (al-mann) and quails (al-salwā), honey, milk, and countless other varieties. God Most High said: {«كُلَّمَا رُزِقُوا مِنْهَا مِنْ ثَمَرَةٍ رِزْقًا قَالُوا هَٰذَا الَّذِي رُزِقْنَا مِنْ قَبْلُ وَأُتُوا بِهِ مُتَشَابِهًا»} \"Whenever they are given a fruit therefrom as provision, they will say: 'This is what we were provided with before,' and it is brought to them in resemblance.\" And God Most High mentioned the drink of the people of Paradise in many places.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1355", "section_title_en": "The Description of the Food of the People of Paradise", "section_index": 1355, "anchors": "- Root: طعم (ṭaʿima)\n  * Lisan / Ayn: Core meaning is tasting, eating, and by extension the substance of food itself; the act of ingestion and its object.\n  * Al-Raghib (Mufradat): In theological context, the Quranic descriptions of food and drink in Paradise are not mere metaphors but designate real (ḥaqīqī) pleasures granted to the blessed, affirming the resurrection of the body alongside the soul.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage applies to physical consumption; metaphorical (majāz) usage is absent here, as the texts affirm actual eating and drinking in the Hereafter.\n- Root: عرق (ʿirq)\n  * Lisan / Ayn: Root denotes a vein, root, or channel; also sweat that exudes from the body.\n  * Al-Raghib (Mufradat): The sweat of the people of Paradise is a subtle (laṭīf) bodily emission, purified of foulness, serving as a sign of the perfected corporeal state free from base needs.\n  * Al-Zamakhshari (Asas): Literal: sweat from the skin. Metaphorical: its description as \"like musk\" (misk) transfers the sensory quality of fragrance to a spiritualized corporeal reality.\n- Root: طير (ṭayr)\n  * Lisan / Ayn: Birds; creatures with wings that fly in the air.\n  * Al-Raghib (Mufradat): Birds in Paradise are real created beings, yet their instantaneous transformation into roasted meat upon desire demonstrates the omnipotence of God and the suspension of natural causality in the Hereafter.\n  * Al-Zamakhshari (Asas): Literal: birds as animals. Metaphorical: the phrase \"like Bactrian camels\" (mithl al-bukhātī) is a simile (tashbīh) for size, not a claim of species identity.\n- Sibawayh Rule: Rule of Conditional Clauses (Bāb al-sharṭ) — The construction \"if you desire it, it falls before you roasted\" (tashtahīhi fa-yakhirru bayna yadayka mashwiyyan) uses a conditional protasis followed by an apodosis in the past tense to express immediate, certain consequence, a hallmark of Quranic and prophetic style for emphasizing divine responsiveness.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}], "26": [{"arabic": "{يضل به كثيرا ويهدي به كثيرا} فهؤلاء لما ظنوا أنهم استخدموا لأجل المساكين والفقراء أو جل الله تعالى ثم قالوا لا حظ لنا في المساكين ولا حظ لله فينا وفي أموالنا سواء أنفقنا أو أمسكنا هلكوا كما هلك الصبي لما ظن أن مقصود الوالد استخدامه لأجل", "english": "Likewise, if it were said: \"Is oxymel (sikanjabīn) better, or the drink of the water-lily (sharāb al-līnūfar)?\" — no unqualified answer could be correct at all. Indeed, if it were said to us: \"Is oxymel better, or the absence of yellow bile?\" — we would say: the absence of yellow bile, for oxymel is sought for the sake of something else, and that which is sought for its own sake is necessarily better than that which is sought for the sake of another.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 1025", "section_title_en": "The Superiority of Knowledge Over Action — The Parable of the Physician and the Child", "section_index": 1025, "anchors": "- Root: فضل (faḍl)\n  * Lisan / Ayn: Excess or increase beyond what is required; superiority in degree.\n  * Al-Raghib (Mufradat): \"الفضل: الزيادة عن الاقتصاد\" — excess beyond moderation, divided into praiseworthy (like excess of knowledge) and blameworthy; comparative superiority of one thing over another by genus, species, or merit.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"فاضلني فلان ففضلته\" — to surpass in excellence. Here used comparatively: one act or state exceeds another in rank.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; the mark or sign by which something is known.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing's true reality, whether by direct perception of its essence or by judgment concerning it.\n  * Al-Zamakhshari (Asas): Literal: \"هو من أعلام العلم الخافقه\" — knowledge as a lofty, manifest sign; distinguished from mere action which is its instrument.\n- Root: صدق (ṣidq)\n  * Al-Raghib (Mufradat): Truthfulness primarily in speech — correspondence of report with reality; may become blameworthy when it leads to ruin, as with the disbelievers who spoke truly about God's independence yet drew false conclusions.\n  * Al-Zamakhshari (Asas): Literal: \"صدقته الحديث\" — truthful in statement. Metaphorical (Majaz): \"رجل صادق الحملة\" — truthful in resolve. Here: the disbelievers were literally truthful in their words yet destroyed by that very truthfulness.\n- Root: هلك (halak)\n  * Al-Raghib (Mufradat): Destruction on three levels: loss of something from one's possession, corruption and dissolution, and death. Used here for spiritual ruin through misapplied reasoning.\n  * Al-Zamakhshari (Asas): Literal: \"وقعوا في المهلكة\" — falling into destruction. Metaphorical: \"تهالك على الشيء\" — intense craving. Here: literal perdition of the soul through false inference.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The conditional structure \"فإن قلت... فاعلم\" (if you say... then know) governs the entire periodic sentence, requiring the apodosis to resolve the protasis with logical necessity, as in the physician analogy where praise of the medicine does not entail its intrinsic superiority.", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Patience and Gratitude'", "badge": "Commentary"}], "27": [{"arabic": "فهو في النار وقاض قضى بغير ما أمر الله به فهو في النار (2) وقال كعب رحمه الله يكون في آخر الزمان علماء يزهدون الناس في الدنيا ولا يزهدون ويخوفون الناس ولا يخافون وينهون عن غشيان الولاة ويأتونهم ويؤثرون الدنيا على الآخرة يأكلون بألسنتهم يقربون الأغنياء دون الفقراء يتغايرون على العلم كما تتغاير النساء على الرجال يغضب أحدهم على جليسه إذا جالس غيره أولئك الجبارون أعداء الرحمن وقال صلى الله عليه وسلم إن الشيطان ربما يسوفكم بالعلم فقيل يا رسول الله وكيف ذلك قال صلى الله عليه وسلم يقول اطلب الع", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "Book of Knowledge", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}, {"arabic": "يسعون في قطع ما أمر الله به أن يوصل ويفسدون في الأرض وقال تعالى {إنما السبيل على الذين يظلمون الناس ويبغون في الأرض بغير الحق} والنمام منهم وقال صلى الله عليه وسلم إن من شرار الناس", "english": "And whoever is the recipient of tale-bearing — it being said to him: \"So-and-so said such-and-such about you,\" or \"He did such-and-such against you,\" or \"He is scheming to corrupt your affair,\" or \"He is conspiring with your enemy,\" or \"He is disparaging your condition,\" or whatever runs in that course — then six matters are incumbent upon him:", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 692", "section_title_en": "Section 692 — On the Duties of the One to Whom Tale-Bearing (Namīmah) Is Conveyed", "section_index": 692, "anchors": "- Root: ن-م-م (N-M-M)\n  * Lisan / Ayn: Core meaning — to stir up, incite, or carry tales; the one who transmits speech to cause discord.\n  * Al-Raghib (Mufradat): Theological nuance — namīmah is a species of corrupt speech that severs what God has commanded to be joined; it is aligned with fāsiq (transgressor) status, rendering the bearer's testimony rejected.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literally, the act of carrying and dropping seeds (naml) to cause sprouting; metaphorically, the dropping of speech into hearts to sow enmity.\n- Root: غ-ي-ب (Gh-Y-B)\n  * Lisan / Ayn: Core meaning — that which is concealed from the senses.\n  * Al-Raghib (Mufradat): Theological nuance — ghaybah (backbiting) is the mention of a person in his absence with what he dislikes; it is a violation of the unseen honor of the brother.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal absence from sight; metaphorical — the absence of the subject from the gathering while his reputation is being torn.\n- Root: ف-س-ق (F-S-Q)\n  * Lisan / Ayn: Core meaning — to depart, to deviate from the straight path.\n  * Al-Raghib (Mufradat): Theological nuance — fisq is the breaking of the command of God; the fāsiq's report is not to be trusted without verification, per {إِن جَاءَكُمْ فَاسِقٌ بِنَبَإٍ فَتَبَيَّنُوا}.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical — literal: the date that peels from its husk; metaphorical: the soul that peels from obedience.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction & Focused Predication) — The verse {إِنَّمَا السَّبِيلُ عَلَى الَّذِينَ يَظْلِمُونَ النَّاسَ} restricts the path of blame exclusively to the oppressors, thereby excluding the tale-bearer's victim from any culpability and affirming the tale-bearer's full liability.", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Condemnation of Anger and Hatred'", "badge": "Commentary"}], "29": [{"arabic": "الأول والآخر والظاهر والباطن وهو بكل شيء عليم التنزيه وأنه ليس بجسم مصور ولا جوهر محدود مقدر وأنه لا يماثل والأجسام ولا في التقدير ولا في قبول الانقسام وأنه ليس بجوهر ولا تحله الجواهر ولا بعرض ولا تحله الأعراض بل لا يماثل موجودا ولا يماثله موجود ليس كمثله شيء ولا هو مثل شيء وأنه لا يحده المقدار ولا تحويه الأقطار ولا تحيط به الجهات ولا تكتنفه الأرضون ولا السموات وأنه مستو على العرش على الوجه الذي قاله وبالمعنى الذي أراده استواء منزها عن المماسة والاستقرار والتمكن والحلول والانتقال لا يحمله ال", "english": "- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.", "book_title": "Foundations of Belief", "section_title_ar": "Section 72", "section_title_en": "Section 72", "section_index": 72, "anchors": "*(Anchors established)*", "content_type": "general", "topic": "Classical commentary from Al-Ghazali's Ihya Ulum al-Din, from 'Foundations of Belief'", "badge": "Commentary"}], "32": [{"arabic": "الله عز وجل قال يا جبريل ما جزاء من سلبت كريمتيه قال سبحانك لا علم لنا إلا ما علمتنا قال الله تعالى جزاؤه الخلود في داري والنظر إلى وجهي // وقال صلى الله عليه وسلم يقول الله عز وجل إذا ابتليت عبدي ببلاء فصبر ولم يشكني إلى عواده أبدلته لحما خيرا من لحمه ودما خيرا من دمه فإذا أبرأته أبرأته ولا ذنب له وإن توفيته فإلى رحمتي وقال داود عليه السلام يا رب ما جزاء الحزين الذي يصبر على المصائب ابتغاء مرضاتك قال جزاؤه أن ألبسه لباس الإيمان فلا أنزعه عنه أبدا وقال عمر بن عبد العزيز رحمه الله في خطبته ما أنعم الله على عبد نعمة فانتزعها منه", "english": "Ibn ʿAbbās, may God be pleased with them both, said: \"Patience in the Qur'an is of three aspects: patience in performing the obligatory duties of God most High — for it has three hundred degrees; patience in refraining from the forbidden things of God most High — for it has six hundred degrees; and patience over calamity at the first shock — for it has nine hundred degrees.\" This rank, despite being among the virtuous acts, was only rendered superior to what precedes it — which belongs to the obligatory acts — because every believer is capable of patience in refraining from forbidden things.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 966", "section_title_en": "The Third Division: Patience Regarding What Lies Beyond the Scope of Choice — Calamities, Its Supreme Stations, and the Warfare of the Heart Against the Whisperer", "section_index": 966, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: \"Al-Sabr: al-imsāk fī ḍīq\" — restraint within constriction; to hold back, to bind, to detain.\n  * Al-Raghib (Mufradat): \"Ṣabartu al-dābbah: ḥabastuhā bilā ʿalaf\" — I held the beast back without fodder. \"Al-ṣabr: ḥabs al-nafs ʿalā mā yaqtaḍīhi al-ʿaql wa-al-sharʿ\" — Patience is the soul's self-restraint upon what reason and Law require, or from what they require it to be withheld. It is a generic term whose names vary by situation: over calamity it is *ṣabr* alone (opposed to *jazaʿ*); in battle, *shajāʿah* (courage); in affliction, forbearance.\n  * Al-Zamakhshari (Asas): Haqiqah (Literal): \"Ṣabartu ʿalā mā akrah, wa-ṣabartu ʿammā uḥibb\" — I bore patiently what I dislike and refrained from what I love. Majaz (Metaphorical): \"Huwa aṣbaru ʿalā al-ḍarb min al-arḍ\" — He is more enduring of blows than the earth; and \"ṣabartu yamīnahu\" — I bound him by an oath (holding him to a stringent vow).\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn over, to overturn, to flip from one face to another; the heart as that which is perpetually turning (taqallub).\n  * Al-Raghib (Mufradat): \"Qalb al-shay': taṣrīfuhu wa-ṣarfuhu ʿan wajh ilā wajh\" — The heart's essence is its constant overturning and veering between states; hence its name.\n  * Al-Zamakhshari (Asas): Haqiqah: \"Qalaba al-shay' qalban: ḥawwalahu ʿan wajhihi\" — to turn a thing from its face. Majaz: \"Rajul qalb ḥawal: yuqallibu al-umūr wa-yaḥtāl\" — a man who turns matters over and devises stratagems; \"wa-qallabū laka al-umūr\" — they turned the affairs over for you (scrutinized them).\n- Root: عله (ʿ-l-h) — [Note: Root appears corrupted in source; likely intended ʿ-l-m or ʿ-l-q; context governs]\n  * Lisan / Ayn: [Source entry unclear; context indicates occupation and preoccupation of the heart.]\n- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Grace, bounty, well-being; the state of ease and delight.\n  * Al-Raghib (Mufradat): \"Al-niʿmah: al-ḥālah al-ḥasanah\" — the beautiful state; \"al-naʿīm: al-tanaʿʿum\" — the act of living pleasantly. \"Wa-in taʿuddū niʿmata Allāhi lā tuḥṣūhā\" {«وَإِن تَعُدُّوا نِعْمَةَ اللَّهِ لَا تُحْصُوهَا»} — the genus of grace encompasses both little and much.\n  * Al-Zamakhshari (Asas): Haqiqah: \"Jallat niʿmat Allāh wa-naʿmā'uh\" — God's grace and bounties are immense. Majaz: \"Khafat naʿāmatuhum: dhahabū\" — their ostriches departed (i.e., their prosperity fled).\n- Sibawayh Rule: Bāb al-ḥaṣr wa-al-taqyīd bi-innamā (Restriction and Specification by *innamā*) — Governing the exclusive predication in \"إنما يرحم الله من عباده الرحما\" (God shows mercy only to the merciful among His servants), restricting mercy's object.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "34": [{"arabic": "فقال وما هو قال إياك والكبر فإنه أول ذنب عصي الله به ثم قرأ {وإذ قلنا للملائكة اسجدوا لآدم فسجدوا إلا إبليس} الآية وإياك والحرص فإنه أخرج آدم من الجنة أمكنه الله سبحانه من جنة عرضها السموات والأرض يأكل منها إلا شجرة واحدة نهاه الله عنها فأكل منها فأخرجه الله تعالى منها ثم قال {اهبطوا منها} إلى آخر الآية وإياك والحسد فإنما قتل ابن آدم أخاه حين حسده ثم قرأ {واتل عليهم نبأ ابني آدم بالحق} الآيات وإذا ذكر أصحاب رسول الله صلى الله عليه وسلم فأمسك وإذا ذكر القدر فاسكت وإذا ذكرت النجوم فاسكت وقال بكر بن عبد الله كان رجل يغشى بعض الملوك فيقوم بحذاء الملك ف", "english": "Know that envy (ḥasad) is likewise among the fruits of rancor (ḥiqd), and rancor is among the fruits of anger (ghaḍab) — so envy is a branch of a branch, while anger is the root of the root. Then envy has, among its blameworthy branches, that which can scarcely be enumerated. And there have come down, specifically in condemnation of envy, many reports (akhbār). The Messenger of God, may God bless him and grant him peace, said: {«Envy consumes good deeds just as fire consumes wood»} (1). The ḥadīth: {«Do not cut one another off, nor turn your backs on one another, nor hate one another»} — agreed upon (muttafaq ʿalayh), and it has already preceded. (2) The ḥadīth of Anas: \"We were sitting one day with the Messenger of God, may God bless him and grant him peace, when he said: 'There will now come upon you from this mountain pass a man from among the people of Paradise'\" — the ḥadīth in its entirety, and in it: that man said, \"I do not find in myself any rancor toward any of the Muslims, nor envy of anyone for the good that God has given him.\" Narrated by Aḥmad with a sound chain (isnād) upon the condition of the two Shaykhs (al-Bukhārī and Muslim), and narrated by al-Bazzār, and the man was named in one of its narrations as Saʿd — though in it there is Ibn Lahīʿah. (3) The ḥadīth: {«Three things from which no one escapes: suspicion, slander, and envy»} — and in another narration: \"And few are those who escape them.\" It was related by Ibn Abī al-Dunyā in his book \"Dhamm al-Ḥasad\" (The Condemnation of Envy) from the ḥadīth of Abū Hurayrah — though in its chain there are Yaʿqūb ibn Muḥammad al-Zuhrī and Mūsā ibn Yaʿqūb al-Zamaʿī, both of whom the majority of scholars have declared weak. The second narration was also related by Ibn Abī al-Dunyā from the narration of ʿAbd al-Raḥmān ibn Muʿāwiyah, and it is mursal (broken chain) and weak. Al-Ṭabarānī has something similar from the ḥadīth of Ḥārithah ibn al-Nuʿmān, and it has already preceded in the section on the afflictions of the tongue. And in one narration: {«Three things from which no one escapes — and few are those who escape them»} — so this narration affirms the possibility of deliverance. And he, may God bless him and grant him peace, said: {«There has crept upon you the disease of the nations before you: envy and hatred. And hatred is the clipper — I do not say it clips the hair, but rather it clips the religion. By Him in whose hand is the soul of Muḥammad, you shall not enter Paradise until you believe, and you shall not believe until you love one another. Shall I not inform you of that which will establish this for you? Spread peace (salām) among you»} (4). And he, may God bless him and grant him peace, said: {«Poverty almost becomes unbelief, and envy almost overcomes destiny (qadar)»} (5). And he, may God bless him and grant him peace, said: {«Indeed, my community will be afflicted with the disease of the nations.» They said: \"And what is the disease of the nations?\" He said: {«Extravagance, arrogance, accumulation, rivalry in worldly things, mutual distance, and mutual envy — until transgression (baghy) comes, and then destruction (harj)»} (6). And he, may God bless him and grant him peace, said: {«Do not show gloating (shamātah) over your brother, lest God heal him and afflict you»} (7). And it is narrated that Moses, peace be upon him, when he hastened to his Lord, Exalted is He, saw a man in the shade of the Throne (ʿArsh) and envied him his station (ghabaṭahu), saying: \"This one is honored before his Lord.\" So he asked his Lord, Exalted is He, to inform him of his name, but He did not inform him, and said: \"I shall tell you of three of his deeds: he did not envy people for what God had given them of His bounty, he was not undutiful to his parents, and he did not go about with slander (namīmah).\" And Zechariah, peace be upon him, said: God, Exalted is He, said: {«The envier is an enemy of My blessing, resentful of My decree, dissatisfied with My apportioning which I have apportioned among My servants»}. And he, may God bless him and grant him peace, said: {«The thing I most fear for my community is that wealth will increase among them, and they will envy one another and fight one another»} (1). And he, may God bless him and grant him peace, said: {«Seek help in fulfilling your needs by keeping them secret, for everyone who possesses a blessing is envied»} (2). And he, may God bless him and grant him peace, said: {«Indeed, the blessings of God have enemies.» It was said: \"And who are they?\" He said: {«Those who envy people for what God has given them of His bounty»} (3). The ḥadīth: {«Six will enter the Fire before the Reckoning by a year.» It was said: \"O Messenger of God, who are they?\" He said: {«The unjust rulers»} — the ḥadīth — and in it: {«And the scholars who envy»}. Narrated by Abū Manṣūr al-Daylamī from the ḥadīth of Ibn ʿUmar and Anas with two weak chains of transmission.", "book_title": "Condemnation of Envy", "section_title_ar": "Section 718", "section_title_en": "Section 718 — On Envy (Ḥasad): Its Roots, Branches, and Blameworthy Fruits", "section_index": 718, "anchors": "- Root: حسد (Ḥ-S-D)\n  * Lisan / Ayn: Core meaning of wishing for removal of a blessing from its possessor, rooted in spite and resentment.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — Envy is the desire for the removal of a blessing from one who rightly deserves it, sometimes accompanied by active striving to effect its removal. The believer envies not, but the hypocrite does.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"حسده على نعمة الله\" — to envy him for God's blessing. Metaphorical (majāz): \"إن الحسد يأكل الجسد\" — envy consumes the body, as fire consumes wood, indicating its destructive spiritual effect.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: Origination after non-existence; bringing into being after nothingness.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination is a thing's coming to be after it was not. The ḥadīth (report) is so-called for its temporal proximity to the event it narrates.\n  * Al-Zamakhshari (Asas): Literal: \"هو حدث من الأحداث\" — he is a youth among youths. Metaphorical: \"صاروا أحاديث\" — they became subjects of talk, indicating fame or infamy spread by tongues.\n- Root: ملك (M-L-K)\n  * Lisan / Ayn: Possession, dominion, sovereignty; the one who possesses and disposes.\n  * Al-Raghib (Mufradat): \"الملك: هو المتصرف بالأمر والنهي\" — dominion is disposal by command and prohibition. Two kinds: actual possession/sovereignty, and the power/capacity to exercise it.\n  * Al-Zamakhshari (Asas): Literal: \"ملكت فلانة\" — he married her (possessed her in wedlock). Metaphorical: \"ملك نفسه عند الغضب\" — he mastered himself at the moment of anger, i.e., self-restraint.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the Prophet (ﷺ) says \"إنما قتل ابن آدم أخاه حين حسده\" (It was only envy that led the son of Adam to kill his brother), the restrictive particle إنما confines the cause of the first murder to envy alone, isolating it as the sole efficient cause of that primordial transgression.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Envy'", "badge": "Ethics"}], "43": [{"arabic": "الصلاة التي هي أعلى الأعلام فقال تعالى {وأقيموا الصلاة وآتوا الزكاة} وقال صلى الله عليه وسلم بني الإسلام على خمس شهادة أن لا إله إلا الله وأن محمدا عبده ورسوله وإقام الصلاة وإيتاء الزكاة (2) وشدد الوعيد على المقصرين فيها فقال {والذين يكنزون الذهب والفضة ولا ينفقونها في سبيل الله فبشرهم بعذاب أليم} ومعنى الإنفاق في سبيل الله إخراج حق الزكاة قال الأحنف بن قيس كنت في نفر من قريش فمر أبو ذر فقال بشر الكانزين بكي في ظهورهم يخرج من جنوبهم وبكي في أقفائهم يخرج من جباههم وفي رواية أنه يوضع على حلمة ثدي أحده", "english": "To proceed: God Most High made alms (al-zakāh) one of the pillars of Islam, and joined its mention with prayer (al-ṣalāh), which is the loftiest of symbols. He said Most High: {«وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ»} — \"And establish prayer and give alms.\" And he, peace and blessings be upon him, said: \"Islam is built upon five: the testimony that there is no god but God and that Muhammad is His servant and Messenger, the establishment of prayer, and the giving of alms.\" And He intensified the threat against those who fall short in it, saying: {«وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ»} — \"And those who hoard gold and silver and do not spend them in the way of God — give them tidings of a painful chastisement.\" And the meaning of \"spending in the way of God\" is the payment of the due right of alms (zakāh).", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 167", "section_title_en": "The Book of the Secrets of Alms (Zakat) — Section 167", "section_index": 167, "anchors": "- Root: زكا (Z-K-Y)\n  * Lisan / Ayn: \"Zakā al-zar'u yazkū zakā'an: it increased and grew.\" Core meaning: growth, increase, purification.\n  * Al-Raghib (Mufradat): \"The origin of zakāh is the growth that occurs through the blessing of God Most High... and from it is zakāh: what a person pays of God's right to the poor, so named for the hope of blessing in it, or for the purification (tazkiyah) of the soul, i.e., its growth.\"\n  * Al-Zamakhshari (Asas): Literal (haqīqah): growth and increase. Metaphorical (majāz): the purification of wealth through payment of the obligatory due.\n- Root: نعم (N-'-M)\n  * Lisan / Ayn: \"Na'ima 'ayshuhu: his life was pleasant.\" Core meaning: bounty, well-being, grace.\n  * Al-Raghib (Mufradat): \"Al-Ni'mah: the good state... and al-Ni'mah (with kasrah) is used for the genus, said of both little and much.\"\n  * Al-Zamakhshari (Asas): Literal: \"Jallat ni'mat Allāh wa na'mā'uh\" — God's grace and bounty are immense. Metaphorical: \"Khāfat na'āmatuhum\" — their ostriches departed (i.e., they fled), showing the root's extended usage.\n- Root: ظهر (Z-H-R)\n  * Lisan / Ayn: \"Zahara: to become apparent, to be victorious.\" Core meaning: back, outward appearance, manifestation.\n  * Al-Raghib (Mufradat): \"Al-Zahr: the back (body part)... and it is used metaphorically for the surface of the earth.\"\n  * Al-Zamakhshari (Asas): Literal: \"Rajul muzhir: a man strong of back.\" Metaphorical: \"Qalabtu al-amra zahrān li-baṭn\" — I turned the matter over back and belly (examined it thoroughly).\n- Root: سرر (S-R-R)\n  * Lisan / Ayn: \"Sarra: to conceal, to keep secret.\" Core meaning: secret, inner self, joy.\n  * Al-Raghib (Mufradat): \"Al-Isrār: the opposite of al-i'lān (declaring)... and al-sirr is the speech concealed in the soul.\"\n  * Al-Zamakhshari (Asas): Literal: \"Asarra al-ḥadīth: he concealed the speech.\" Metaphorical: \"Aṭaytuka sirrah: I gave you its choicest part (the secret/core of something).\"\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening clause is complete in itself, as in \"fa'āfa 'alayhim min ni'matihi mā...\" where the prepositional phrase is completed after an intervening relative clause.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Zakat'", "badge": "Du'a"}], "44": [{"arabic": "وقال الله تعالى {أتأمرون الناس بالبر وتنسون أنفسكم} ولذلك كان وزر العالم في معاصيه أكثر من وزر الجاهل إذ يزل بزلته عالم كثير ويقتدون به ومن سن سنة سيئة فعليه وزرها ووزر من عمل بها ولذلك قال علي رضي الله عنه قصم ظهري رجلان عالم متهتك وجاهل متنسك فالجاهل يغر الناس بتنسكه والعالم يغرهم بتهتكه والله أعلم الباب السادس في آفات العلم وبيان علامات علما الآخرة والعلماء السوء قد ذكرنا ما ورد من فضائل العلم والعلماء وقد ورد في العلماء السوء تشديدات عظيمة دلت على أنهم أشد الخلق عذابا يوم القيامة فمن ال", "english": "I say: Leave the reins and go. For if one comes who comprehends, and you have concealed it from him, then let him bridle me — for God Most High has said: {«ولا تؤتوا السفهاء أموالكم»} — \"And do not give the foolish your wealth\" — as an indication that preserving knowledge from one who would corrupt it and harm it is even more incumbent. And wrongdoing in giving to one who is not deserving is no less than wrongdoing in withholding from one who is deserving.", "book_title": "Book of Knowledge", "section_title_ar": "Section 48", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 48: On the Etiquette of the Teacher and the Learner (Continued), and the Exposition of the Marks Distinguishing the Scholars of the Hereafter from the Evil Scholars", "section_index": 48, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing in its true reality; the root also carries the sense of a mark or sign (ʿalam) by which something is known.\n  * Al-Raghib (Mufradat): Knowledge is of two kinds: apprehension of the essence of a thing, and judgment upon a thing affirming or denying something of it. The first is transitive to one object; the second to two.\n  * Al-Zamakhshari (Asas): Literal usage: \"He is a sign (ʿalam) of knowledge\" — i.e., a distinguished landmark. Metaphorical: \"The traces (maʿālim) of the road\" — the vestiges by which one is guided.\n- Root: ظلم (ẓalama)\n  * Lisan / Ayn: To place something in other than its proper place; darkness (ẓulmah) as the privation of light.\n  * Al-Raghib (Mufradat): Darkness is the absence of light; figuratively used for ignorance, polytheism, and wickedness, just as light is used for their opposites.\n  * Al-Zamakhshari (Asas): Literal: \"He wronged and was wronged\" — to suffer injustice. Metaphorical: \"Wrongdoing is darkness, just as justice is light\" — for the wrongdoer acts in the darkness of his own soul.\n- Root: منع (manaʿa)\n  * Lisan / Ayn: To withhold, to prevent, to protect; a fortress (manīʿah) is that which defends.\n  * Al-Raghib (Mufradat): Used in opposition to giving; also used for protection, as in \"a fortified place\" (makān manīʿ).\n  * Al-Zamakhshari (Asas): Literal: \"He prevented him from the thing.\" Metaphorical: \"He protects the neighbor\" — i.e., defends him from harm.\n- Root: عقل (ʿaqala)\n  * Lisan / Ayn: The intellect; originally to bind or restrain (as a camel is hobbled), hence the faculty that restrains the soul from base desires.\n  * Al-Raghib (Mufradat): The intellect is the faculty prepared for the reception of knowledge, and also the knowledge acquired by that faculty.\n  * Al-Zamakhshari (Asas): Literal: \"I have not done so since I attained reason.\" Metaphorical: \"A palm tree that does not accept pollination\" — i.e., does not receive what is offered to it.\n- Sibawayh Rule: The Interposition of the Prepositional Phrase (al-faṣl bayna al-jār wa al-majrūr) — governing the permissible separation between a governing word and its governed prepositional phrase where the intervening element is syntactically complete, as in the construction \"Leave the reins and go\" (itruk al-lijām wa-idhhab), where the imperative governs two successive clauses without ellipsis.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Book of Knowledge'", "badge": "Afterlife"}], "45": [{"arabic": "تعالى وإنها لكبيرة إلا على الخاشعين وقال صلى الله عليه وسلم اعبد الله في الرضا فإن لم تستطع ففي الصبر على ما تكره خير كثير (2) ثم لا يكن في نيل السعادة الموعودة على حسن الخلق استلذاذ الطاعة واستكراه المعصية في زمان دون زمان بل ينبغي أن يكون ذلك على الدوام وفي جملة العمر وكلما كان العمر أطول كانت الفضيلة ارسخ وأكمل ولذلك لما سئل صلى الله عليه وسلم عن السعادة فقال طول العمر في طاعة الله تعالى (3) ولذلك كره الأنبياء والأولياء الموت فإن الدنيا مزرعة الآخرة وكلما كانت العبادات أكثر بط", "english": "And all the morally praiseworthy traits sanctioned by the Sacred Law are attained through this path. Its ultimate goal is that the act issuing from one becomes pleasurable (ladhīdh). For the generous person is the one who takes pleasure in expending the wealth he gives, not the one who gives it out of aversion. And the humble person is the one who takes pleasure in humility. The religious moral traits will never become firmly rooted in the soul so long as the soul has not habituated itself to all virtuous practices, has not abandoned all vicious acts, and has not persisted therein with the persistence of one who yearns for beautiful deeds and delights in them, and who detests ugly deeds and suffers pain from them — as he (peace and blessings be upon him) said: «وجعلت قرة عيني في الصلاة» (\"And the coolness of my eye was placed in the prayer\"). And whenever acts of worship and the abandonment of forbidden things are performed with aversion and reluctance, that is deficiency, and the perfection of felicity is not attained thereby. Indeed, persisting in them through striving is better — but better relative to abandoning them entirely, not relative to performing them willingly. For this reason God (Exalted is He) said: {وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى الْخَاشِعِينَ} (\"And indeed it is grievous, save upon the humble\" — {Al-Baqarah: 45}), and he (peace and blessings be upon him) said: \"Worship God in a state of contentment; but if you are not able, then in patience upon what you dislike there is abundant good.\"", "book_title": "Breaking the Two Desires", "section_title_ar": "Section 619", "section_title_en": "The Explanation of the Acceptability of Moral Character to Change through Discipline", "section_index": 619, "anchors": "- Root: خلق (khalaqa)\n  * Lisan / Ayn: Core meaning is \"to measure/estimate rightly\" (taqdīr mustaqīm); al-khuluq is the inward disposition, the \"measure\" of the soul's constitution.\n  * Al-Raghib (Mufradat): Creation (khalq) is bringing into being upon a right measure; moral character (khuluq) is the soul's settled form (ṣūrah) — either its natural constitution or one acquired through discipline.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — the craftsman's precise measuring before cutting; Metaphorical (majāz) — God's bringing things into existence upon a measure required by wisdom, and the soul's acquired disposition.\n- Root: وسط (wasaṭ)\n  * Lisan / Ayn: The middle, the center, that which is equally distant from two extremes.\n  * Al-Raghib (Mufradat): The mean (iʿtidāl) is the praiseworthy station between two blameworthy extremes; the intellect's governance requires steering between excess and neglect.\n  * Al-Zamakhshari (Asas): Literal — the physical center of a thing; Metaphorical — the balanced state of the soul's faculties.\n- Root: رياضة (riyāḍah)\n  * Lisan / Ayn: Training, disciplining, breaking in (as a horse); repeated exercise until obedience becomes natural.\n  * Al-Raghib (Mufradat): The soul's training (riyāḍat al-nafs) through imposing upon it acts contrary to its habitual vice until the virtue becomes ingrained.\n  * Al-Zamakhshari (Asas): Literal — physical exercise; Metaphorical — the soul's moral training through sustained self-imposed practice.\n- Sibawayh Rule: باب التمييز بين الحال المؤسسة والحال المؤكدة (Distinguishing establishing from confirming circumstantial clauses) — the clause \"فكأنه خال عن الوصفين\" establishes a new state rather than confirming an existing one, marking the conceptual middle as devoid of both extreme attributes.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Breaking the Two Desires'", "badge": "Insight"}], "48": [{"arabic": "ويوم لا تجزي نفس عن نفس شيئا ويوم تشخص فيه الأبصار ويوم لا يغنى مولى عن مولى شيئا ويوم لا تملك نفس لنفس شيئا ويوم يدعون إلى نار جهنم دعا ويوم يسحبون فى النار على وجوههم ويوم تقلب وجوههم فى النار ويوم لا يجزى والد عن ولده ويوم يفر المرء من أخيه وأمه وأبيه ويوم لا ينطقون ولا يؤذن لهم فيعتذرون يوم لا مرد له من الله يوم هم بارزون ويوم هم على النار يفتنون يوم لا ينفع مال ولا بنون يوم لا ينفع الظالمين معذرتهم ولهم اللعنة ولهم سوء الدار يوم ترد فيه المعاذير وتبلى الس", "english": "So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1339", "section_title_en": "The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent", "section_index": 1339, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "57": [{"arabic": "وقال تعالى في وصف الطيبات وأنزلنا عليكم المن والسلوى المن العسل والسلوى اللحم سمي سلوى لأنه يتسلى به عن جميع الإدام ولا يقوم غيره مقامه ولذلك قال صلى الله عليه وسلم سيد الإدام اللحم ثم قال بعد ذكر المن والسلوى كلوا من طيبات ما رزقناكم فاللحم والحلاوة من الطيبات قال أبو سليمان الداراني رضي الله عنه أكل الطيبات يورث الرضا عن الله وتتم هذه الطيبات بشرب الماء البارد وصب الماء الفاتر على اليد عند الغسل قال المأمون شرب الماء بثلج يخلص الشكر وقال بعض الأدباء إذا دعوت إخوانك فأطعمتهم حصرم", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Manners of Eating", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Manners of Eating'", "badge": "Insight"}, {"arabic": "ولذلك قال صلى الله عليه وسلم سيد الإدام اللحم ثم قال بعد ذكر المن والسلوى كلوا من طيبات ما رزقناكم فاللحم والحلاوة من الطيبات قال أبو سليمان الداراني رضي الله عنه أكل الطيبات يورث الرضا عن الله وتتم هذه الطيبات بشرب الماء البارد وصب الماء الفاتر على اليد عند الغسل قال المأمون شرب الماء بثلج يخلص الشكر وقال بعض الأدباء إذا دعوت إخوانك فأطعمتهم حصرمية وبورانية وسقيتهم ماء باردا فقد أكملت الضيافة وأنفق بعضهم دراهم في ضيافة فقال بعض الحكماء لم نكن نحتاج إلى هذا إذا كان خبزك جيدا وماؤك باردا وخلك حامضا فهو كفاية وقال بعضهم الحلاوة ب", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Manners of Eating", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Manners of Eating'", "badge": "Insight"}], "61": [{"arabic": "وسمعة فليحذر أن يستبدل الذي هو أدنى بالذي هو خير وأما قطع العلائق فمعناه رد المظالم والتوبة الخالصة لله تعالى عن جملة المعاصي فكل مظلمة علاقة وكل علاقة مثل غريم حاضر متعلق بتلابيبه ينادي عليه ويقول إلى أين تتوجه أتقصد بيت ملك الملوك وأنت مضيع أمره في منزلك هذا ومستهين به ومهمل له أولا تستحي أن تقدم عليه قدوم العبد العاصي فيردك ولا يقبلك فإن كنت راغبا في قبول زيارتك فنفذ أوامره ورد المظالم وتب إليه أولا من جميع المعاصي واقطع علاقة قلبك عن الالتفات إلى ما وراءك لتكون متوجها إليه بوجه قلبك كما أ", "english": "For this reason, the monastics (al-ruhbāniyyūn) in the past religions separated themselves from creation and withdrew to the peaks of mountains, preferring wild solitude away from people in pursuit of intimacy (uns) with God — mighty and majestic is He. They abandoned for God's sake the pleasures of the present and imposed upon themselves arduous spiritual exertions (mujāhidāt), hoping for the Hereafter. God — glorified and exalted is He — praised them in His Book, saying: {«ذلك بأن منهم قسيسين ورهبانا وأنهم لا يستكبرون»} — \"That is because among them are priests and monks and because they do not behave arrogantly.\" Then when that [way] became effaced, and creation turned to following appetites, abandoned devotion to the worship of God — glorified and exalted is He — and grew languid in it, God — glorified and exalted is He — sent His Prophet Muhammad — may God's peace and blessings be upon him — to revive the path of the Hereafter and renew the way of the messengers in traversing it.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 216", "section_title_en": "The Noble Stations of Pilgrimage and the Manner of Contemplation Upon Them — From the Beginning of Hajj to Its End", "section_index": 216, "anchors": "- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, understanding, grasping the reality of a thing\n  * Al-Raghib (Mufradat): Intellectual apprehension that penetrates to the essential meaning, not mere surface awareness\n  * Al-Zamakhshari (Asas): Literal — understanding speech; Metaphorical — understanding the inner reality and wisdom of sacred acts\n- Root: سفر (s-f-r)\n  * Lisan / Ayn: Journey; also uncovering/disclosure — the traveler is one who uncovers distant horizons\n  * Al-Raghib (Mufradat): \"السفر: كشف الغطاء\" — uncovering the veil; the journey of hajj is both physical travel and spiritual unveiling\n  * Al-Zamakhshari (Asas): Literal — journeying across land; Metaphorical — \"سفر عن وجهك الشر\" (uncovering evil from your face), i.e., the hajj journey unveils the secrets of servitude\n- Root: رهب (r-h-b)\n  * Lisan / Ayn: To fear, to be awed; monastic withdrawal (rahbāniyyah) from worldly attachments\n  * Al-Raghib (Mufradat): Fear that drives one to solitary devotion; the monastic impulse redirected by Islamic law\n  * Al-Zamakhshari (Asas): Literal — fear; Metaphorical — the disciplined retreat from worldly pleasures for divine communion\n- Root: بيت (b-y-t)\n  * Lisan / Ayn: Place of nightly habitation; the Ka'bah as the primordial house\n  * Al-Raghib (Mufradat): \"أصل البيت: مأوى الإنسان بالليل\" — the house is where one dwells at night; the Sacred House is where hearts find nocturnal rest in God\n  * Al-Zamakhshari (Asas): Literal — physical structure; Metaphorical — the locus of divine presence and the object of spiritual yearning\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" restricts the predicate exclusively to the subject, as in \"إنما بعث الله نبيه لإحياء طريق الآخرة\" — the sole purpose of prophetic mission is specified with exclusive focus.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}], "62": [{"arabic": "يفزع الناس يوم القيامة ولا يفزعون وهم أولياء الله الذين لا خوف عليهم ولا هم يحزنون وفيه شهر بن حوشب مختلف فيه // ورواه أبو هريرة رضي الله عنه وقال فيه إن حول العرش منابر من نور عليها قوم لباسهم نور ووجوههم نورا ليسوا بأنبياء ولا شهداء يغبطهم النبيون والشهداء فقالوا يا رسول الله صفهم لنا فقال هم المتحابون في الله والمتجالسون في الله والمتزاورون في الله (1) وقال صلى الله عليه وسلم ما تحاب اثنان في الله إلا كان أحبهما إلى الله أشدهما حبا لصاحبه (2) ويقال إن الأخوين في الله إذا كان أحدهما أعلى مقاما من الآخر", "english": "Know that affability (al-ulfah) is the fruit of excellent character (ḥusn al-khuluq), and estrangement (al-tafarruq) is the fruit of evil character. For excellent character necessitates mutual love, harmony, and concord, whereas evil character yields mutual hatred, envy, and turning away (al-tadābur). And whenever the source is praiseworthy, the fruit is likewise praiseworthy. The excellence of good character is not hidden in the religion; indeed, it is that with which God—glorified be He—praised His Prophet, peace be upon him, when He said: {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ} «And indeed, you are upon an immense character» (Al-Qalam: 4). The Prophet, peace be upon him, said: \"The thing which most causes people to enter Paradise is God-consciousness (taqwā) and excellent character.\" (1) Usāmah ibn Sharīk said: \"We said, O Messenger of God, what is the best thing given to a person?\" He said: \"Excellent character.\" (2) He, peace be upon him, also said: \"I was sent only to perfect the noble traits of character.\" (3) He, peace be upon him, said: \"Nothing is heavier in the Balance than excellent character.\" (4) He, peace be upon him, said: \"God does not beautify a person's outward form and his inward character, then feed him to the Fire.\" (5) He, peace be upon him, said: \"O Abū Hurayrah, adhere to excellent character.\" (Page V02P157) Abū Hurayrah, may God be pleased with him, said: \"What is excellent character, O Messenger of God?\" He said: \"That you join the one who cuts you off, forgive the one who wrongs you, and give to the one who deprives you.\" (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 402", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 402: On the Excellence of Affability (Al-Ulfah) and Brotherhood in God", "section_index": 402, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of harmonizing, uniting, and reconciling; the removal of estrangement (al-waḥshah) and the establishment of concord.\n  * Al-Raghib (Mufradat): Theological nuance of ta'līf as the divine act of harmonizing hearts, a blessing bestowed by God alone, as in {لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَّا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) denotes physical joining; metaphorical (majāz) denotes the spiritual and moral concord of hearts, which is the fruit of excellent character (ḥusn al-khuluq).\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: Root meaning of measuring, proportioning, and smoothing; hence, the inherent disposition and moral character of a person.\n  * Al-Raghib (Mufradat): The origination of a thing upon a just measure; for character, it is the inward form (al-ṣūrah al-bāṭinah) of the soul, just as the physical form is its outward shape.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is the physical creation and proportioning; metaphorical (majāz) is the moral and spiritual constitution, praised by God in {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ}.\n- Root: بغض (Bughḍ)\n  * Lisan / Ayn: The opposite of love (ḥubb); intense aversion and hatred.\n  * Al-Raghib (Mufradat): In the Kalam context, al-bughḍ fī Allāh (hatred for God's sake) is a spiritual act of discernment and loyalty, not a mere emotional impulse; it is paired with al-ḥubb fī Allāh as the strongest bond of faith (awthaq ʿurā al-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is personal animosity; metaphorical (majāz) is the righteous aversion to disobedience and the enemies of God, which is a form of devotion.\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — Governing the syntactic flow of conditional and relative clauses, ensuring the periodic structure of the author's argument remains coherent and unbroken.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}, {"arabic": "الشك في هذا الصدق وكذلك قال الله تعالى ولكن البر من آمن بالله واليوم الآخر والملائكة والكتاب والنبيين فشرط عشرين وصفا كالوفاء بالعهد والصبر على الشدائد ثم قال تعالى أولئك الذين صدقوا وقد قال تعالى يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات وقال تعالى لا يستوي منكم من أنفق من قبل الفتح وقاتل الآية وقد قال تعالى هم درجات عند الله وقال صلى الله عليه وسلم الإيمان عريان ولباسه التقوى (1) الحديث وقال صلى الله عليه وسلم الإيمان بضع وسبعون بابا أدناها إماطة الأذى عن الطريق فهذا ما يدل على ارتباط كمال الإيمان بالأعمال وأ", "english": "...doubt concerning this truthfulness. Likewise, God Most High said: {«But righteousness is he who believes in God and the Last Day and the angels and the Book and the prophets»} (2:177) — thus He conditioned twenty attributes, such as faithfulness to covenant and patience under hardship. Then He said Most High: {«Those are the truthful ones»} (2:177). And God Most High said: {«God will raise those who have believed among you and those who have been given knowledge, by degrees»} (58:11). And He said Most High: {«Not equal among you are those who spent before the conquest and fought»} (57:10). And He said Most High: {«They are degrees before God»} (3:163). And the Prophet, peace be upon him, said: \"Faith is naked, and its garment is God-consciousness (al-taqwā).\" And the Prophet, peace be upon him, said: \"Faith has seventy-some branches; the lowest of them is removing harm from the path.\" All this indicates the interconnection of the perfection of faith with works.", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 104", "section_title_en": "The Revival of the Religious Sciences — Book of the Secrets of Zakāh, Section 104: On the Degrees of Faith and Its Connection to Works, and the Hidden Hypocrisy (al-Nifāq al-Khafī) That Contradicts the Perfection of Faith", "section_index": 104, "anchors": "- Root: ن ف ق (N-F-Q)\n  * Lisan / Ayn: Root denotes passing away, depletion, and expenditure; also the underground burrow of the jerboa (nāfiqāʾ) with a concealed exit — the etymological basis for hypocrisy as a hidden exit from faith.\n  * Al-Raghib (Mufradat): \"نفق الشيء: مضى ونفد\" — theological nuance: hypocrisy (nifāq) is that which causes faith to expire and pass away, whether by sale (worldly gain) or by death (spiritual ruin).\n  * Al-Zamakhshari (Asas): Literal: \"نفقت الدراهم\" (coins ran out). Metaphorical: \"نفق روحه: خرج\" (his soul expired and went forth) — hence the hypocrite's faith is one whose spirit has already departed.\n- Root: أ ي م (A-Y-M)\n  * Lisan / Ayn: A woman without a husband; a man long unmarried. Al-Raghib: \"الحرب مأيمة\" — war makes women widows.\n  * Al-Zamakhshari (Asas): Literal: \"تركوا النساء أيامى\" (they left women widowed). Metaphorical application: the one who feels secure from hypocrisy is like one who claims immunity from widowhood — a false security.\n- Root: و ف ي (W-F-Y)\n  * Lisan / Ayn: Fullness, completion, fulfillment of a measure or covenant.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — the one who has reached completion. \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — to fulfill the covenant without breach.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" (a full-weight dirham). Metaphorical: \"أوفى على المائة\" (he surpassed a hundred) — faith's perfection (wafāʾ) is only attained by surpassing mere profession to include works and inward sincerity.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the grammatical force of \"إنما\" constructions and conditional clauses (من كان...), where the predicate is restricted to the condition stated, as in the hadith \"أربع من كن فيه فهو منافق خالص\" — the four traits are exhaustive of the ruling.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Monitoring and Accounting'", "badge": "Hadith"}], "68": [{"arabic": "شيء جئتني فقال جئتك للسلام عليك وحبا لك في الله وعندي هدية أريد أن أهديها لك فقلت ما هي قال أن تقول قبل طلوع الشمس وقبل انبساطها على الأرض وقبل الغروب سورة الحمد وقل أعوذ برب الناس وقل أعوذ برب الفلق وقل هو الله أحد وقل يا أيها الكافرون وآية الكرسي كل واحدة سبع مرات وتقول سبحان الله والحمد لله ولا إله إلا الله والله أكبر سبعا وتصلي على النبي صلى الله عليه وسلم سبعا وتستغفر لنفسك ولوالديك والمؤمنين وللمؤمنات سبعا وتقول اللهم افعل بي وبهم عاجلا وآجلا في الدين والدنيا والآخرة ما أنت له أهل ولا تفعل بنا يا", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}], "70": [{"arabic": "المقابر السلام عليكم دار قوم مؤمنين وإنا إن شاء الله بكم لاحقون (1) واللحوق بهم غير مشكوك فيه ولكن مقتضى الأدب ذكر الله تعالى وربط الأمور به وهذه الصيغة دالة عليه حتى صار بعرف الاستعمال عبارة عن إظهار الرغبة والتمني فإذا قيل لك إن فلانا يموت سريعا فتقول إن شاء الله فيفهم منه رغبتك لا تشككك وإذا قيل لك فلان سيزول مرضه ويصح فتقول إن شاء الله بمعنى الرغبة فقد صارت الكلمة معدولة عن معنى التشكيك إلى معنى الرغبة وكذلك العدول إلى معنى التأدب لذكر الله تعالى كيف كان الأمر الوجه الثالث مستنده الشك ومعناه أنا م", "english": "If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"", "book_title": "Foundations of Belief", "section_title_ar": "Section 102", "section_title_en": "On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102", "section_index": 102, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Foundations of Belief'", "badge": "Dhikr"}], "74": [{"arabic": "بكاء الشكر والسرور وقلب العبد كالحجارة أو أشد قسوة ولا تزول قسوته إلا بالبكاء في حال الخوف والشكر جميعا وروي عنه صلى الله عليه وسلم أنه قال ينادى يوم القيامة ليقم الحمادون فتقوم زمرة فينصب لهم لواء فيدخلون الجنة قيل ومن الحمادون قال الذين يشكرون الله تعالى على كل حال (2) حديث الحمد رداء الرحمن لم اجد له اصلا وفي الصحيح من حديث ابي هريرة الكبر رداؤه الحديث وتقدم في العلم وأوحى الله تعالى إلى أيوب عليه السلام إني رضيت بالشكر مكافأة من أوليائي في كلام طويل وأوحى الله تعالى إليه أيضا في صفة الصابرين", "english": "And as for the reports [concerning this], the Messenger of God, may God bless him and grant him peace, said: \"The eater who gives thanks is in the station of the faster who is patient.\" (1) The hadith of ʿAṭāʾ: I entered upon ʿĀʾishah and said to her: \"Inform us of the most wondrous thing you saw of the Messenger of God, may God bless him and grant him peace.\" She said: \"What of his affair was not wondrous?\" — the hadith concerning his weeping during the night prayer. It was transmitted by Abū al-Shaykh Ibn Ḥibbān in the Book of the Character of the Messenger of God, may God bless him and grant him peace, and by way of him by Ibn al-Jawzī in al-Wafā. In its chain is Abū Jannāb, whose name is Yaḥyā ibn Abī Ḥabbah, whom the majority of scholars declared weak. Ibn Ḥibbān narrated it in his Ṣaḥīḥ from the narration of ʿAbd al-Malik ibn Abī Sulaymān from ʿAṭāʾ, without her saying \"What of his affair was not wondrous?\" — and it is found in Muslim from the narration of ʿUrwah from ʿĀʾishah, restricted to the end of the hadith. And this indicates that weeping ought never to cease. And to this secret points what has been narrated: that one of the prophets passed by a small stone from which abundant water issued forth, and he marvelled at it. Then God, exalted be He, gave it speech, and it said: \"Ever since I heard the saying of God, exalted be祂: {وَقُودُهَا النَّاسُ وَالْحِجَارَةُ} — 'Its fuel is men and stones' — I weep from fear of Him.\" So he asked it to intercede for him against the Fire, and it was granted protection for him. Then he saw it after a time in the same state, and said: \"Why do you weep now?\" It said: \"That was the weeping of fear, and this is the weeping of gratitude and joy.\" And the heart of the servant is like stones, or even harder in hardness, and its hardness is not removed except by weeping in the state of fear and gratitude both together. And it is narrated from him, may God bless him and grant him peace, that he said: \"It will be called out on the Day of Resurrection: 'Let the praisers (al-ḥammādūn) arise!' So a group will arise, and a banner will be erected for them, and they will enter Paradise.\" It was said: \"And who are the praisers?\" He said: \"Those who thank God, exalted be He, in every state.\" (2) The hadith \"Praise is the cloak of the Merciful\" — I found no basis for it. And in the Ṣaḥīḥ, from the hadith of Abū Hurayrah: \"Pride is His cloak\" — the hadith, and it has preceded in the Book of Knowledge. And God, exalted be He, revealed to Job (Ayyūb), peace be upon him: \"I am well-pleased with gratitude as the recompense from My beloved ones\" — in a lengthy discourse. And God, exalted be He, also revealed to him concerning the description of the patient ones: \"Their abode is the Abode of Peace; when they enter it, I inspire them with gratitude, and it is the best of speech. And upon gratitude I increase them, and through [their] looking to Me I augment them.\" And when that which was revealed concerning treasures was revealed, ʿUmar, may God be pleased with him, said: \"Which wealth shall we take for ourselves?\" He, peace be upon him, said: \"Let each of you take for himself a remembering tongue and a grateful heart.\" // The hadith of ʿUmar: \"Let each of you take for himself a remembering tongue and a grateful heart\" — the hadith has preceded in the Book of Marriage. So he commanded the acquisition of the grateful heart in place of wealth. And Ibn Masʿūd said: \"Gratitude is half of faith.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 973", "section_title_en": "On the Station of Gratitude (Shukr) — The Virtue of the Thankful Eater and the Ever-Weeping Heart", "section_index": 973, "anchors": "- Root: شكر (Sh-K-R)\n  * Lisan / Ayn: Core root denotes fullness, saturation, and the appearance of increase upon a beast of burden; the she-camel \"shakūr\" is one whose udder overflows with milk from scant fodder.\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — Gratitude is the conceptual apprehension of the blessing and its outward manifestation. It is the inverse of kufr (covering/forgetting). Three ranks: gratitude of the heart (perceiving the blessing), of the tongue (praise of the Bestower), and of the limbs (requital proportionate to the blessing).\n  * Al-Zamakhshari (Asas): Literal (haqīqah): \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical (majāz): \"دابة شكور\" — a beast that thrives on little fodder, its condition itself displaying gratitude; the overflowing udder (ضرّة شكرى) as embodied thanksgiving.\n- Root: حدث (Ḥ-D-Th)\n  * Lisan / Ayn: Origination after non-existence; the new, the recent.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — coming-to-be after not having been; the muḥdath is that which is originated, whether accident or substance.\n  * Al-Zamakhshari (Asas): Literal: \"نزلت به حوادث الدهر\" — calamities of time befell him. Metaphorical: \"كان عمر محدثا\" — ʿUmar was one inspired with correct discernment, as if truth were spoken into his heart.\n- Root: ابي (A-B-Y)\n  * Lisan / Ayn: Refusal, stubborn refusal, haughtiness in declining.\n  * Al-Raghib (Mufradat): \"الإباء: شدة الامتناع\" — intense refusal; every ibāʾ is a refusal but not every refusal is ibāʾ. God's word: {وَيَأْبَى اللَّهُ إِلَّا أَنْ يُتِمَّ نُورَهُ} — God refuses but to perfect His light.\n  * Al-Zamakhshari (Asas): Literal: \"أبى الله إلا أن يكون كذا\" — God refused except that it be so. Metaphorical: \"لا أبا لك\" — an idiom of urging, not literal denial of paternity.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of separating a preposition from its governed noun when the intervening clause is complete in itself, as in \"إن به...\" — governing the flow of periodic constructions where a full sentence intervenes between the particle and its object.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "قلوب الغافلين مثل الحجارة أو أشد قسوة وإن من الحجارة لما يتفجر منه الأنهار وإن منها لما يشقق فيخرج منه الماء وإن منها لما يهبط من خشية الله وما الله بغافل عما تعملون الشطر الثاني في الخوف بيان أحوال الأنبياء والملائكة عليهم الصلاة والسلام في الخوف روت عائشة رضي الله عنها أن رسول الله صلى الله عليه وسلم كان إذا تغير الهواء وهبت ريح عاصفة يتغير وجهه فيقول ويتردد في الحجرة ويدخل ويخرج كل ذلك خوفا من عذاب الله (1) وقرأ صلى الله عليه وسلم آية في سورة الواقعة فصعق (2) وقال تعالى وخر موسى صعقا ورأى رسول الله صلى الله عليه وسلم صورة جبريل", "english": "And God — may He be exalted — said: {«وَخَرَّ مُوسَىٰ صَعِقًا»} — \"And Moses fell down senseless\" (al-Aʿrāf 143). And the Messenger of God — may God's peace and blessings be upon him — saw the form of Gabriel — upon him be peace — in a form that caused him to fall down senseless as well, overwhelmed by the awe of the divine manifestation.", "book_title": "Fear and Hope", "section_title_ar": "Section 1058", "section_title_en": "On the Discipline of Eating, Dress, and Dwelling — and the Fear of the Prophets and Angels", "section_index": 1058, "anchors": "- Root: بطن (baṭana)\n  * Lisan / Ayn: The belly as the corporeal cavity; the lower/hidden part of a thing, contrasted with ẓahr (back/surface).\n  * Al-Raghib (Mufradat): The belly is the bodily organ; metaphorically, the \"inner\" aspect of any matter (baṭn al-amr). Here, it anchors the physiological necessity of ingestion and excretion as twin, involuntary dictates of nature (jibillah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألقت الدجاجة ذا بطنها\" — the hen laid what was in her belly. Metaphorical (majāz): \"في بطنان الشباب\" — in the very midst of youth. In this text, al-Ghazali uses the literal sense to strip food of any spiritual prestige, equating intake with output.\n- Root: قلب (qalaba)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): Taṣrīf al-shayʾ — the constant turning of a thing, as in {«إليه تقلبون»} (al-ʿAnkabūt 21). The heart (qalb) is so named for its perpetual fluctuation.\n  * Al-Zamakhshari (Asas): Literal: \"قلب الثوب\" — to turn a garment inside out. Metaphorical: \"قلب التاجر السلعة\" — the merchant scrutinizes his goods, examining their conditions. Here, the heart's occupation (ishtighāl) with food is a turning of one's inner attention toward the belly, a misdirection of the qalb from God.\n- Root: خوف (khāfa)\n  * Lisan / Ayn: Fear, dread, apprehension of harm.\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة أو معلومة\" — the expectation of an undesirable event based on a probable or certain sign. It is the opposite of amn (security), and applies to both worldly and otherworldly matters, as in {«يدعون ربهم خوفا وطمعا»} (al-Sajdah 16).\n  * Al-Zamakhshari (Asas): Literal: \"خفته على مالي\" — I feared for my wealth. Metaphorical: \"تخوفه: تنقصه\" — to diminish something gradually, as in Zuhayr's verse. In this section, the fear of the prophets is literal and overwhelming — a genuine, annihilating dread of divine wrath, not a mere figure of speech.\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The permissibility of separating a prepositional phrase from its governed noun for rhetorical emphasis, as in \"إن به\" constructions. Here, the periodic sentences (e.g., \"فإن غلبك حر أو برد فعليك بالمساجد\") deploy conditional clauses (sharṭ/jazāʾ) to structure the argument: the protasis states the hypothetical excess, the apodosis delivers the normative command.", "content_type": "fiqh", "topic": "Al-Ghazali on the inner and outer dimensions of worship, from 'Fear and Hope'", "badge": "Worship"}], "78": [{"arabic": "ذلك من الآيات وكان داخلا في معنى قوله عز وجل ومنهم أميون لا يعلمون الكتاب إلا أماني يعني التلاوة المجردة وقوله عز وجل وكأين من آية في السموات والأرض يمرون عليها وهم عنها معرضون لأن القرآن هو المبين لتلك الآيات في السموات والأرض ومهما تجاوزها ولم يتأثر بها كان معرضا عنها ولذلك قيل إن من لم يكن متصفا بأخلاق القرآن فإذا قرأ القرآن ناداه الله تعالى مالك ولكلامي وأنت معرض عني دع عنك كلامي إن لم تتب إلي ومثال العاصي إذا قرأ القرآن وكرره مثال من يكرر كتاب الملك في كل يوم مرات وقد كتب إليه في عمارة مملكته وهو مشغول بتخريبها ومقتصر على د", "english": "And at the mention of God, His attributes, and His names, he bows low in humility before His majesty and in apprehension of His greatness. And at the mention of the disbelievers' sayings — those things impossible for God, Mighty and Majestic, such as their attributing to Him a son or a consort — he lowers his voice and inwardly recoils in shame at the ugliness of their speech. And at the description of Paradise, his innermost being surges forth with longing for it. And at the description of the Fire, his limbs tremble in fear of it. For when the Messenger of God, peace be upon him, said to Ibn Mas'ud, \"Recite to me,\" he said: \"I began reciting Surah al-Nisa'. When I reached {فكيف إذا جئنا من كل أمة بشهيد وجئنا بك على هؤلاء شهيدا} [How then shall it be when We bring from every nation a witness, and We bring you as a witness against these?] (4:41), I saw his two eyes overflowing with tears. He then said to me: 'That is enough for you now.'\" And this was because the witnessing of that very state had wholly overwhelmed his heart.", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 230", "section_title_en": "The States of the Heart During Qur'anic Recitation — The Condition of the True Recieter", "section_index": 230, "anchors": "- Root: وجل (w-j-l)\n  * Lisan / Ayn: Core root meaning of trembling fear, trepidation of the heart\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the inward apprehension of fear; cited in {إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم}\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"رجل وجل، وقوم وجال\" — a man fearful, a people fearful; the state of the heart's trembling before divine majesty\n- Root: وصف (w-ṣ-f)\n  * Lisan / Ayn: Describing a thing by its attributes and qualities\n  * Al-Raghib (Mufradat): \"الوصف: ذكر الشيء بحليته ونعته\" — description is the mention of a thing by its adornment and attribute; may be true or false\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: \"وجهها يصف الحسن\" — metaphorical usage where the face itself \"describes\" beauty; likewise, the tongue may \"describe\" falsehood, as in {ولا تقولوا لما تصف ألسنتكم الكذب}\n- Root: وفي (w-f-y)\n  * Lisan / Ayn: Completeness, fulfillment, reaching full measure\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — that which attains completion; \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — fulfilled the covenant without breach\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" — a full-weight dirham; Metaphorical: \"أوفى على المائة إذا زاد عليها\" — surpassed the hundred\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The separation between the governing preposition and its object by intervening clauses, as in \"فلما بلغت {فكيف إذا جئنا...}\" where the temporal clause governs the narrative sequence", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "82": [{"arabic": "دونه وادعى الإجماع فيه واستدل بأدلة تشعر بنقيض غرضه كقوله تعالى {الذين آمنوا وعملوا الصالحات} إذ هذا يدل على أن العمل وراء الإيمان لا من نفس الإيمان وإلا فيكون العمل في حكم المعاد والعجب أنه ادعى الإجماع في هذا وهو مع ذلك ينقل قوله صلى الله عليه وسلم لا يكفر أحد إلا بعد جحوده لما أقر به (1) وينكر على المعتزلة قولهم بالتخليد في النار بسبب الكبائر والقائل بهذا قائل بنفس مذهب المعتزلة إذ يقال له من صدق بقلبه وشهد بلسانه ومات في الحال فهل هو في الجنة فلا بد أن يقول نعم وفيه حكم بوجود الإيمان دون العمل فنزيد ونقول لو بقي حيا حتى دخل عليه وقت", "english": "He was asked, \"Which deed is most excellent?\" The Prophet (peace and blessings be upon him) said: \"Islam.\" It was then asked, \"Which aspect of Islam is most excellent?\" He (peace and blessings be upon him) said: \"Faith (Īmān).\" This is evidence for both the distinction (ikhtilāf) between the two terms and their overlap (tadākhul). This usage is the most consistent with the conventions of the language, because faith is a deed among deeds, and it is the most excellent of them. Islam is submission (taslīm), whether by the heart, by the tongue, or by the limbs. The most excellent of these is that which is by the heart, which is the assent (taṣdīq) that is called faith. Using the two terms in a way that indicates distinction, overlap, or even complete synonymy (tarāduf) is all within the bounds of metaphorical usage (tajawwuz) in the language.", "book_title": "Foundations of Belief", "section_title_ar": "Section 99", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 99: On the Distinction, Overlap, and Synonymy of Faith (Īmān) and Submission (Islām), and Their Worldly and Otherworldly Judgments", "section_index": 99, "anchors": "- Root: ايم (A-Y-M)\n  * Lisan / Ayn: Core meaning of remaining unmarried, or a state of being without a spouse; extended metaphorically to describe one who is solitary or without support.\n  * Al-Raghib (Mufradat): \"الأيامى: جمع أيم، وهي المرأة التي لا بعل لها... والحرب مأيمة، أي: يفرق بين الزوج والزوجة.\" The root carries the sense of separation or a state of lacking union, which informs the theological discussion of what constitutes the essential bond of faith.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the state of being unmarried; metaphorical (Majaz) usage extends to anything that separates or leaves one bereft. This distinction between literal and metaphorical application is central to the chapter's method.\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: To turn, overturn, or transform a thing from one state to another.\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه... والانقلاب: الانصراف.\" The heart (qalb) is so named for its constant fluctuation and turning. In theological terms, it is the seat of taṣdīq (assent), the immaterial faculty of cognition and conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is physical turning; metaphorical (Majaz) usage is \"قلب الأمور\" — to deliberate, scrutinize, and manage affairs. This supports the distinction between the heart's internal act of assent and the external acts of the limbs.\n- Root: عمل (ʿ-A-M-L)\n  * Lisan / Ayn: Any deed or action performed with purpose and intent.\n  * Al-Raghib (Mufradat): \"العمل: كل فعل يكون من الحيوان بقصد، فهو أخص من الفعل.\" Work is more specific than mere action, as it implies deliberate, intentional agency. It is used for both righteous and sinful deeds, and is the external manifestation of internal conviction.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to physical labor or deeds. The chapter explores whether \"work\" is an integral part of the reality of faith or a separate, consequent requirement.\n- Root: صدق (S-D-Q)\n  * Lisan / Ayn: To be truthful, to speak the truth, to verify.\n  * Al-Raghib (Mufradat): \"الصدق والكذب أصلهما في القول... ولا يكونان بالقصد الأول إلا في القول.\" Truth and falsehood are primarily properties of speech and reports. Taṣdīq (assent) is the heart's affirmation of the truth of a report, which is the core reality of Īmān.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage is truthful speech; metaphorical (Majaz) usage is \"صادق الحملة\" — one who is true and firm in battle or resolve. This shows that taṣdīq is not merely verbal but a firm, internal resolution.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication). This rule governs how restriction (ḥaṣr) is achieved in Arabic, often through particles like \"innamā\" or through contextual specification (takhṣīṣ). The chapter's core argument hinges on how terms like Īmān and Islām are semantically restricted, expanded, or made synonymous through contextual usage (majāz), requiring precise parsing of the predicate and its scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "83": [{"arabic": "الصلاة التي هي أعلى الأعلام فقال تعالى {وأقيموا الصلاة وآتوا الزكاة} وقال صلى الله عليه وسلم بني الإسلام على خمس شهادة أن لا إله إلا الله وأن محمدا عبده ورسوله وإقام الصلاة وإيتاء الزكاة (2) وشدد الوعيد على المقصرين فيها فقال {والذين يكنزون الذهب والفضة ولا ينفقونها في سبيل الله فبشرهم بعذاب أليم} ومعنى الإنفاق في سبيل الله إخراج حق الزكاة قال الأحنف بن قيس كنت في نفر من قريش فمر أبو ذر فقال بشر الكانزين بكي في ظهورهم يخرج من جنوبهم وبكي في أقفائهم يخرج من جباههم وفي رواية أنه يوضع على حلمة ثدي أحده", "english": "To proceed: God Most High made alms (al-zakāh) one of the pillars of Islam, and joined its mention with prayer (al-ṣalāh), which is the loftiest of symbols. He said Most High: {«وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ»} — \"And establish prayer and give alms.\" And he, peace and blessings be upon him, said: \"Islam is built upon five: the testimony that there is no god but God and that Muhammad is His servant and Messenger, the establishment of prayer, and the giving of alms.\" And He intensified the threat against those who fall short in it, saying: {«وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ»} — \"And those who hoard gold and silver and do not spend them in the way of God — give them tidings of a painful chastisement.\" And the meaning of \"spending in the way of God\" is the payment of the due right of alms (zakāh).", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 167", "section_title_en": "The Book of the Secrets of Alms (Zakat) — Section 167", "section_index": 167, "anchors": "- Root: زكا (Z-K-Y)\n  * Lisan / Ayn: \"Zakā al-zar'u yazkū zakā'an: it increased and grew.\" Core meaning: growth, increase, purification.\n  * Al-Raghib (Mufradat): \"The origin of zakāh is the growth that occurs through the blessing of God Most High... and from it is zakāh: what a person pays of God's right to the poor, so named for the hope of blessing in it, or for the purification (tazkiyah) of the soul, i.e., its growth.\"\n  * Al-Zamakhshari (Asas): Literal (haqīqah): growth and increase. Metaphorical (majāz): the purification of wealth through payment of the obligatory due.\n- Root: نعم (N-'-M)\n  * Lisan / Ayn: \"Na'ima 'ayshuhu: his life was pleasant.\" Core meaning: bounty, well-being, grace.\n  * Al-Raghib (Mufradat): \"Al-Ni'mah: the good state... and al-Ni'mah (with kasrah) is used for the genus, said of both little and much.\"\n  * Al-Zamakhshari (Asas): Literal: \"Jallat ni'mat Allāh wa na'mā'uh\" — God's grace and bounty are immense. Metaphorical: \"Khāfat na'āmatuhum\" — their ostriches departed (i.e., they fled), showing the root's extended usage.\n- Root: ظهر (Z-H-R)\n  * Lisan / Ayn: \"Zahara: to become apparent, to be victorious.\" Core meaning: back, outward appearance, manifestation.\n  * Al-Raghib (Mufradat): \"Al-Zahr: the back (body part)... and it is used metaphorically for the surface of the earth.\"\n  * Al-Zamakhshari (Asas): Literal: \"Rajul muzhir: a man strong of back.\" Metaphorical: \"Qalabtu al-amra zahrān li-baṭn\" — I turned the matter over back and belly (examined it thoroughly).\n- Root: سرر (S-R-R)\n  * Lisan / Ayn: \"Sarra: to conceal, to keep secret.\" Core meaning: secret, inner self, joy.\n  * Al-Raghib (Mufradat): \"Al-Isrār: the opposite of al-i'lān (declaring)... and al-sirr is the speech concealed in the soul.\"\n  * Al-Zamakhshari (Asas): Literal: \"Asarra al-ḥadīth: he concealed the speech.\" Metaphorical: \"Aṭaytuka sirrah: I gave you its choicest part (the secret/core of something).\"\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening clause is complete in itself, as in \"fa'āfa 'alayhim min ni'matihi mā...\" where the prepositional phrase is completed after an intervening relative clause.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Zakat'", "badge": "Du'a"}], "86": [{"arabic": "ولا يغاثون بل يقال لهم اخسئوا فيها ولا تكلمون أولئك الذي اشتروا الحياة الدنيا بالآخرة فلا يخفف عنهم العذاب ولا هم ينصرون وإذا عظمت غوائل الدنيا وشرورها فلا بد أولا من معرفة حقيقة الدنيا وما هي وما الحكمة في خلقها مع عداوتها وما مدخل غرورها وشرورها فإن من لا يعرف الشر لا يتقيه ويوشك أن يقع فيه ونحن نذكر ذم الدنيا وأمثلتها وحقيقتها وتفصيل معانيها وأصناف الأشغال المتعلقة بها ووجه الحاجة إلى أصولها وسبب انصراف الخلق عن الله بسبب التشاغل بفضولها إن شاء الله تعالى وهو المعين على ما يرتضيه", "english": "Praise be to God, who made His friends acquainted with the calamitous snares of this world and its afflictions, and uncovered for them its defects and its shameful parts, until they gazed upon its evidences and its signs, and weighed its evil deeds against its good deeds. Thus they came to know that its objectionable aspects exceed its commendable ones, that what is hoped from it does not fulfill what is feared from it, and that its rising is not safe from its eclipse. Yet it is in the likeness of a comely woman who draws people to herself by her beauty — while within her are hidden secrets of evil, ugly things that destroy those who yearn for union with her. Then she is a fleer from her seekers, niggardly in her turning toward them; and when she does turn, one is not secure from her evil and her pestilence. If she does good for an hour, she does evil for a year; and if she does evil once, she makes it her perpetual habit. So the cycles of her turning are ever more tightly drawn, and the commerce of her sons is losing and ruined, and her afflictions in succession strike the breasts of her seekers, and the courses of her states proclaim the humiliation of those who pursue her. Thus every one deluded by her is destined to abasement, and every one who waxes proud through her proceeds to regret. Her very nature is to flee from her seeker and to be sought by the one who flees from her. Whoever serves her, she eludes; whoever turns away from her, she comes to. Her clarity is never free of the admixture of turbidity, nor is her joy ever disentangled from what embitters it. Her soundness bequeaths sickness, her youth drives on to decrepitude, and her bliss bears no fruit but remorse and regret. She is deceitful, guileful, fleeting, evasive. She never ceases adorning herself for her seekers until, when they have become her lovers, she bares her fangs at them, disorders the ordered strands of their affairs, and uncovers for them the hidden store of her wonders — then she makes them taste the lethal poisons and strikes them with the piercing shafts of her arrows. While her companions are in joy and bounty from her, suddenly she turns away from them as though she were but scattered dreams; then she rushes upon them with her calamities, grinds them as grain is ground, and shrouds them in their winding-sheets beneath the dust. If she has possessed one of them with all that the sun has risen upon, she makes him as reaped harvest, as though he had not dwelt in plenty the day before. Her companions desire joy from her, and she promises them delusion — until they hope for much and build palaces, and then their palaces become graves, their gatherings become ruin, their striving becomes scattered dust, and their cry becomes \"Woe and destruction!\" Such is her description — and the command of God is a decree determined. And the prayer and peace be upon Muhammad, His servant and His Messenger, sent to the worlds as a bringer of glad tidings and a warner, and as an illuminating lamp; and upon those of his family and companions who were for him supporters in the religion, and against the wrongdoers helpers; and abundant peace.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 729", "section_title_en": "The Book of Condemnation of This World — Being the Sixth Book of the Quarter of the Destructive Things from The Revival of the Religious Sciences", "section_index": 729, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core root meaning of swallowing, devouring, or ingesting wholly\n  * Al-Raghib (Mufradat): الإلهام: casting something into the heart (al-rawʿ), specifically from God or the higher assembly; the root denotes the soul's complete reception, as one who swallows entirely\n  * Al-Zamakhshari (Asas): Literal: ألهمه الله الخير — God cast good into his heart. Metaphorical: جيش لهم — an army that engulfs and swallows whomever enters it\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter\n  * Al-Raghib (Mufradat): الدنو: proximity by essence or by judgment, used of place, time, and station; al-dunyā is the nearer, lower life\n  * Al-Zamakhshari (Asas): Literal: هو دانٍ — he is near. Metaphorical: الأدنى — the inferior, the baser, contrasted with what is better\n- Root: حسر (ḥ-s-r)\n  * Lisan / Ayn: Uncovering, stripping away a covering; exhaustion from exposure of one's strength\n  * Al-Raghib (Mufradat): الحسر: uncovering what veils; al-ḥasīr: one whose strength is laid bare and spent; al-ḥāsir: the weary whose powers are uncovered as exhausted\n  * Al-Zamakhshari (Asas): Literal: حسر عن ذراعيه — he bared his forearms. Metaphorical: فلان كريم المحسر — so-and-so is noble when tested/examined (his hidden quality is uncovered)\n- Root: سرر (s-r-r)\n  * Lisan / Ayn: Concealment, the secret kept hidden in the breast; the innermost\n  * Al-Raghib (Mufradat): الإسرار: opposite of declaration; al-sirr: the speech concealed in the soul\n  * Al-Zamakhshari (Asas): Literal: أسر الحديث — he concealed the speech. Metaphorical: أعطيتك سره — I gave you its choicest essence; هو في سر النسب — he is in the pure core of lineage\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase when the interposed element is complete in itself, as in the rhetorical suspensions of this oration", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}, {"arabic": "وخلقته من طين} وإلى هؤلاء الإشارة بقوله تعالى {أولئك الذين اشتروا الحياة الدنيا بالآخرة فلا يخفف عنهم العذاب ولا هم ينصرون} وعلاج هذا الغرور إما بتصديق الإيمان وإما بالبرهان أما التصديق بمجرد الإيمان فهو أن يصدق الله تعالى في قوله ما عندكم ينفذ وما عند الله باق وفي قوله عز وجل {وما عند الله خير} وقوله {والآخرة خير وأبقى} وقوله {وما الحياة الدنيا إلا متاع الغرور} وقوله {فلا تغرنكم الحياة الدنيا} وقد أخبر رسول الله صلى الله عليه وسلم بذلك طوائف من الكفار فقلدوه وصدقوه وآمنوا به ولم يطالبوه بالبرهان (1) حديث قول من قال له نشدتك الله أبعثك رسولا فيقول {نعم} فيصدق متفق عليه من", "english": "Know that the saying of God Most High — {«fa-lā taghurrannakum al-ḥayātu al-dunyā wa-lā yaghurrannakum billāhi al-gharūr»} (So let not the life of this world deceive you, nor let the Deceiver deceive you concerning God) — and His saying — {«wa-lākinnakum fatantum anfusakum wa-tarabbastum wa-irtabtum wa-gharratkum al-amānī»} (But ye tempted your own souls, and ye waited, and ye doubted, and vain desires deceived you) — is sufficient for the blameworthiness of self-deception (al-ghurūr). And the Messenger of God, may God's peace and blessing be upon him, has said: \"How excellent is the sleep of the intelligent and their breaking of the fast! How they outwit the wakefulness of the foolish and their striving! And verily a mustard-seed's weight [of faith] from a possessor of piety and certainty is better than the earth filled with the self-deceived.\" And the ḥadīth: \"The intelligent man (al-kayyis) is he who takes account of his own soul and works for what is after death\" — this ḥadīth was transmitted by al-Tirmidhī and Ibn Mājah from the ḥadīth of Shaddād ibn Aws.", "book_title": "Condemnation of the World", "section_title_ar": "Section 884", "section_title_en": "Exposition of the Blameworthiness of Self-Deception (Al-Ghurūr), Its Reality, and Its Examples", "section_index": 884, "anchors": "- Root: غرر (Gh-R-R)\n  * Lisan / Ayn: The core meaning is \"an apparent trace or mark of a thing\" (al-athar al-ẓāhir), from which derives \"the blaze of a horse\" (ghurrat al-faras). To deceive (gharra) is to strike one's heedlessness (ghirrah) and attain one's sought desire from him, as if folding a garment upon its original crease (ṭawāhu ʿalā gharrihi).\n  * Al-Raghib (Mufradat): \"Ghurrah is heedlessness in wakefulness, and ghirār is heedlessness with drowsiness.\" Theologically, it is the soul's repose upon a false semblance (shubhah) that pleases the caprice (hawā), rendering one oblivious to the true state of affairs—as in {«mā gharraka bi-rabbika al-karīm»} (What deceived thee concerning thy Generous Lord?).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"A gazelle in a moonlit night is called agharr\" because it ventures out thinking it is day and is devoured by beasts—heedlessness in perception. Metaphorical (majāz): \"A day agharr muḥajjal\" (a white-browed, white-legged day) for intense heat, transferring the blaze of a horse to the day's visible intensity.\n- Root: جهل (J-H-L)\n  * Lisan / Ayn: \"Jahila bihi\" — to be ignorant of it; \"jāhala ʿalā qawmihi\" — to act foolishly/insolently against one's people. The pre-Islamic era is \"al-jāhiliyyah al-jahlā'\" (the utterly ignorant age).\n  * Al-Raghib (Mufradat): Ignorance (jahl) is of three kinds: (1) the soul's emptiness of knowledge (this is the root); (2) believing a thing contrary to what it is; (3) doing a thing contrary to what it ought to be, whether one's belief is sound or corrupt. Ghurūr is a species of the second kind—a false belief arising from a corrupt semblance.\n  * Al-Zamakhshari (Asas): Literal: \"Kafā bil-shakki jahlā\" (Sufficient is doubt as ignorance). Metaphorical: \"Istajhalat al-rīḥ al-ghuṣn\" (The wind made the branch sway violently) — transferred from mental foolishness to physical agitation.\n- Root: حدث (Ḥ-D-TH)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not.\" \"Al-ḥadath: the novel event.\" \"Ḥaddatha: to speak/communicate.\"\n  * Al-Raghib (Mufradat): \"Ḥudūth is the existence of a thing after non-existence, whether accident or substance. Iḥdāth is bringing it into existence. The iḥdāth of substances belongs to God alone.\" The \"ḥadīth\" (report/speech) is so-called for its temporal novelty.\n  * Al-Zamakhshari (Asas): Literal: \"Nazalat bihi ḥawādith al-dahr\" (The vicissitudes of time befell him). Metaphorical: \"Kāna ʿUmar muḥaddathan\" (Umar was one inspired with true discernment) — as if he were spoken to (ḥudditha) by what he conjectured.\n- Root: دنا (D-N-W)\n  * Lisan / Ayn: \"Danā fa-huwa dānin\" — he drew near. \"Al-dunyā\" (the lower world) is so named because it is nearer (danat) and precedes the Hereafter.\n  * Al-Raghib (Mufradat): \"Al-dunūw: proximity by essence or by judgment, used of place, time, and station.\" The \"adnā\" (lower/nearer) is contrasted with the greater and with the better: {«a-tastabdilūna alladhī huwa adnā billadhī huwa khayr»} (Will ye take the lower in exchange for what is better?).\n  * Al-Zamakhshari (Asas): Literal: \"Huwa danī' min al-adniyā'\" (He is base, of the base ones) — but this is the homonym danu'a (baseness), distinct from danā (nearness). The dunyā's \"nearness\" is its temporal immediacy versus the Hereafter's deferral.\n- Sibawayh Rule: Bab al-faṣl bayna al-jār wa-al-majrūr (Prepositional Interposition) — The particle \"bi\" in {«wa-lā yaghurrannakum billāhi al-gharūr»} governs the deceiver (al-gharūr) as the agent of deception, while \"billāh\" (concerning God) is the object of the deception. The syntactic structure permits the deceiver to be named after the prepositional phrase, indicating that the deception is *about* God's attributes (His forbearance, His respite) — a grammatical subtlety showing the ghurūr deceives *by means of* false notions of God, not that God Himself deceives.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of the World'", "badge": "Afterlife"}, {"arabic": "وهؤلاء هم الذين اشتروا الحياة الدنيا بالآخرة فلا جرم لا يخفف عنهم العذاب ولا هم ينصرون وهم الذين لم يفهموا قوله تعالى المال والبنون زينة الحياة الدنيا والباقيات الصالحات خير عند ربك ثوابا وخير أملا فالعلم والحرية هي الباقيات الصالحات التي تبقى كمالا في النفس والمال والجاه هو الذي ينقضي على القرب وهو كما مثله الله تعالى حيث قال إنما مثل الحياة الدنيا كماء أنزلناه من السماء فاختلط به نبات الأرض الآية وقال تعالى واضرب لهم مثل الحياة الدنيا كماء أنزلناه من السماء إلى قوله فأصبح هشيما تذروه الرياح", "english": "Therefore, the perfections are three, if we count non-change through appetites and non-submission to them as a perfection—like the perfection of knowledge and the perfection of freedom. By \"freedom\" I mean non-enslavement to appetites and to willing worldly causes. The perfection of power for the servant is a path to acquiring the perfection of knowledge and the perfection of freedom, but he has no path to acquiring the perfection of power that endures after his death. For his power over the very substances of wealth and over subjugating hearts and bodies is cut off by death, whereas his knowledge and his freedom are not annihilated by death; rather, they both endure as perfection within him and as a means to nearness to God—may He be exalted.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 800", "section_title_en": "On True Perfection: Knowledge and Freedom Over Power, Wealth, and Status", "section_index": 800, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Core meaning of measuring, determining, and enabling; power as capacity to bring about an effect.\n  * Al-Raghib (Mufradat): True power (qudrah) belongs absolutely to God alone; for humans, it is a relative capacity, never absolute, and is a means, not an end.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) power is God's; metaphorical (majaz) attribution of \"power\" to creatures is restricted and conditional, tied to specific acts.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as apprehension of a thing's reality; also traces and signs by which one is guided.\n  * Al-Raghib (Mufradat): Knowledge (ʿilm) is the apprehension of a thing's true nature or the judgment of existence or non-existence regarding it; it is the enduring perfection of the soul.\n  * Al-Zamakhshari (Asas): Literal: \"he knew\" as direct awareness; metaphorical: \"he knew\" as perception or discernment of signs (maʿālim) leading to truth.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of vital functions; also the state of being inanimate or lifeless.\n  * Al-Raghib (Mufradat): Death is the opposite of life; in theological context, it marks the termination of worldly capacities but not of the soul's acquired knowledge or freedom.\n  * Al-Zamakhshari (Asas): Literal: physical death; metaphorical: \"death\" of the heart through ignorance or enslavement to passion, and \"revival\" of the land through rain as a similitude for the fleeting world.\n- Sibawayh Rule: Restriction and Focused Predication (الحصر والتقييد بإنما) — Used to confine true perfection exclusively to knowledge and freedom, negating it for power, wealth, and status.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "89": [{"arabic": "يعرفونه كما يعرفون أبناءهم وقال تعالى فلما جاءهم ما عرفوا كفروا به فلعنة الله على الكافرين وقال تعالى في قصة بلعام بن باعوراء واتل عليهم نبأ الذي آتيناه آياتنا فانسلخ منها فأتبعه الشيطان فكان من الغاوين حتى قال فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث فكذلك العالم الفاجر فإن بلعام أوتي كتاب الله تعالى فأخلد إلى الشهوات فشبه بالكلب أي سواء أوتي الحكمة أو لم يؤت فهو يلهث إلى الشهوات وقال عيسى عليه السلام مثل علماء السوء كمثل صخرة وقعت على فم النهر لا هي تشرب الماء ولا هي تترك الماء يخلص إلى الزرع ومثل علماء السوء مثل قناة الحش ظ", "english": "I say: The Prophet — peace and blessings be upon him — said: \"The scholar will indeed be tormented with a torment at which the inhabitants of the Fire will circle around, marveling at the severity of his punishment.\" By it he meant the wicked scholar.", "book_title": "Book of Knowledge", "section_title_ar": "Section 50", "section_title_en": "The Worldly Scholar's Punishment and the Marks of the Hereafter-Scholars", "section_index": 50, "anchors": "- Root: فجر (fajara)\n  * Lisan / Ayn: To split, cleave, or rend something widely; to break open\n  * Al-Raghib (Mufradat): The splitting of something with wide rupture — from which the dawn (al-fajr) is named, as it splits the night; used for both physical and moral rupture\n  * Al-Zamakhshari (Asas): Literal: the cleaving of water or the breaking of dawn. Metaphorical: the eruption of punishment upon one suddenly and overwhelmingly\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge; the faculty of apprehending a thing as it truly is\n  * Al-Raghib (Mufradat): Twofold: (1) apprehension of a thing's essence; (2) judgment upon a thing affirming or denying something of it. The scholar (al-ʿālim) is one who possesses such apprehension\n  * Al-Zamakhshari (Asas): Literal: knowledge as certain apprehension. Metaphorical: the \"signs\" (maʿālim) of the path — that by which one is guided; the scholar is a \"sign\" pointing either to guidance or to ruin\n- Root: دنا (dana)\n  * Lisan / Ayn: To be near, to draw close; al-dunyā (the nearer world) as that which is immediate and low\n  * Al-Raghib (Mufradat): Proximity by essence or by judgment; used of place, time, and station. The \"nearer\" (al-adnā) is contrasted with the greater and the better\n  * Al-Zamakhshari (Asas): Literal: nearness. Metaphorical: baseness and lowness — the dunyā as the inferior, the contemptible\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts the predicate exclusively to its subject, as in \"the winners and the brought-near are only the scholars of the Hereafter,\" effecting complete exclusion of all else.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}, {"arabic": "بعد معرفتهم إياه فقال تعالى {وكانوا من قبل يستفتحون على الذين كفروا فلما جاءهم ما عرفوا كفروا به} إلى قوله {أن يكفروا بما أنزل الله بغيا} أي حسدا وقالت صفية بنت حيي للنبي صلى الله عليه وسلم جاء أبي وعمي من عندك يوما فقال أبي لعمي ما تقول فيه قال أقول أنه النبي الذي بشر به موسى قال فما ترى قال أرى معاداته أيام الحياة (2) فهذا حكم الحسد في التحريم وأما المنافسة فليست بحرام بل هي إما واجبة وإما مندوبة وإما مباحة وقد يستعمل لفظ الحسد بدل المنافسة والمنافسة بدل الحسد قال قثم بن العباس لما أراد هو والفضل أن يأتيا النب", "english": "The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"", "book_title": "Condemnation of Envy", "section_title_ar": "Section 720", "section_title_en": "On the Reality of Envy (Ḥasad) and Its Degrees — Section 720", "section_index": 720, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Envy'", "badge": "Hadith"}], "90": [{"arabic": "الروح من أمره على من يشاء من عباده} وأحال الإغواء على إبليس فقال تعالى {ليضل عن سبيله} والإغواء هو استيقاف العباد دون بلوغ غاية الحكمة فانظر كيف نسبه إلى العبد الذي غضب عليه والإرشاد سياقه لهم إلى الغاية فانظر كيف نسبه إلى العبد الذي أحبه وعندك في العادة له مثال فالملك إذا كان محتاجا إلى من يسقيه الشراب وإلى من يحجمه وينظف فناء منزله عن القاذورات وكان له عبدان فلا يعين للحجامة والتنظيف إلا أقبحهما وأخسهما ولا يفوض حمل الشراب والطيب إلا إلى أحسنهما وأكملهما وأحبهما إليه ولا ينبغ", "english": "Thus was the beginning of this matter and its end. And do not understand it unless you are worthy of it. And if you are worthy of it, the eye is opened and you see, so you have no need of a leader to lead you. The blind man can indeed be led, but only to a limit. For when the path narrows and becomes sharper than a sword and finer than a hair, the bird is able to fly over it but is not able to drag a blind man behind it. And when the field becomes narrow and subtle — subtle as water, for example — and crossing is possible only by swimming, then the one skilled in the art of swimming may be able to cross by himself, and perhaps he is not able to drag another behind him. These matters bear the same relation to walking upon the way of the common masses of creatures as walking upon water bears to walking upon earth. Swimming can be learned; but as for walking upon water, it is not acquired by instruction, but rather is attained through the strength of certainty (yaqīn). For this reason it was said to the Prophet, peace be upon him, that Jesus, peace be upon him, was said to have walked upon water, and he, peace be upon him, said: \"Had his certainty increased, he would have walked upon the air.\" {«حديث قيل له يقال إن عيسى مشى على الماء قال لو ازداد يقينا لمشي على الهواء»} — This hadith is rejected (munkar) and is not known in this form. What is known is what Ibn Abi al-Dunya narrated in the Book of Certainty from the saying of Bakr ibn Abd Allah al-Muzani, who said: The disciples lost their Prophet, and it was said to them: \"He has headed toward the sea.\" So they set out seeking him, and when they reached the sea, behold, he was coming toward them walking upon the water. And he mentioned a hadith in which Jesus said: \"If the son of Adam had a hair's breadth of certainty, he would walk upon the water.\" And Abu Mansur al-Daylami narrated in the Musnad al-Firdaws with a weak chain from the hadith of Muadh ibn Jabal: \"If you knew God with true knowledge, you would walk upon the seas, and the mountains would be removed by your supplications.\" These are symbols and allusions to the meaning of aversion (karāhah) and love (maḥabbah), and good pleasure (riḍā) and wrath (ghaḍab), and gratitude (shukr) and ingratitude (kufrān) — more than this is not fitting for the science of practical conduct (ʿilm al-muʿāmalah). And God, exalted be He, struck an example of this to draw it near to the understanding of creatures, since He knew that He created the jinn and mankind only to worship Him, and their worship was the ultimate purpose of wisdom (ghāyat al-ḥikmah) with respect to them. Then He informed that He has two servants: one whom He loves, whose name is Gabriel — the Holy Spirit and the Trustworthy One — and he is with Him beloved, obeyed, trustworthy, and honored; and another whom He hates, whose name is Iblis — the accursed one, reprieved until the Day of Judgment. Then He delegated guidance (irshād) to Gabriel, saying, the Exalted: {«قل نزله روح القدس من ربك بالحق»} \"Say: The Holy Spirit has brought it down from your Lord with truth\" (16:102), and said, the Exalted: {«يلقي الروح من أمره على من يشاء من عباده»} \"He casts the Spirit of His command upon whom He wills of His servants\" (40:15). And He delegated misguidance (ighwāʾ) to Iblis, saying, the Exalted: {«ليضل عن سبيله»} \"That he may lead astray from His path\" (4:119). And ighwāʾ is the halting of servants short of attaining the ultimate purpose of wisdom. So observe how He attributed it to the servant with whom He was wrathful; and guidance (irshād) is the conduct of them toward the ultimate purpose — so observe how He attributed it to the servant whom He loves. And you have an example of this in custom: when a king is in need of one to give him drink and one to cup him and to clean the courtyard of his house of filth, and he has two servants, he does not appoint for cupping and cleaning except the ugliest and meanest of them, and he does not entrust the carrying of drink and perfume except to the best and most complete of them and the most beloved to him. And you should not say: \"This is my act, and his act was not without my act\" — for you have erred when you attributed that to yourself. Rather, He is the One who directed your motive (dāʿiyah) to the specification of the disliked act to the disliked person, and the beloved act to the beloved person, as a completion of justice (ʿadl). For His justice is sometimes completed through matters in which you have no entry, and sometimes it is completed in you — for you also are among His acts. So your motive, your power, your knowledge, your action, and all the other causes of your movements in expression — all of this is His act, which He arranged with justice in an arrangement from which moderate acts issue forth. Except that you see only yourself, and so you suppose that what appears through you in the world of witness (ʿālam al-shahādah) has no cause from the world of the unseen and the dominion (ʿālam al-ghayb wa al-malakūt). Therefore you attribute it to yourself. And you are only like the child who looks at night at the play of the juggler (mushʿabadh) who brings forth figures from behind a curtain that dance and scream and rise and sit, composed of rags that do not move by themselves — rather, they are moved by fine hair-like threads that do not appear in the darkness of night, their ends in the hand of the juggler, who is hidden from the eyes of the children. So they rejoice and marvel, supposing that those rags dance and play and rise and sit. As for the intelligent ones, they know that this is a moving (taḥrīk) and not a self-movement, but perhaps they do not know its detailed modality. And the one who knows some of its detail does not know it as the juggler knows it, to whom the command belongs and in whose hand is the pulling. Likewise, the children of the people of this world — and all creatures are children relative to the scholars — look at these persons (ashkhāṣ) and suppose that they are the movers, and so they attribute [action] to them. And the scholars know that they are moved, except that they do not know the modality of the moving — and they are the majority. Except the knowers (ʿārifūn), the scholars, and those firmly rooted in knowledge (al-rāsikhūn), for they have perceived, with the sharpness of their sight, fine spider-web threads — nay, much finer than these — suspended from heaven, their ends attached to the persons of the people of the earth. Those threads are not perceived, due to their fineness, by these outward eyes. Then they witnessed the heads of those threads in their suspension-points (manāṭāt) to which they are attached, and they witnessed for those suspension-points handles (maqābiḍ) that are in the hands of the angels who move the heavens. And they also witnessed the angels of the heavens directed toward the bearers of the Throne (ḥamalat al-ʿarsh), awaiting what descends upon them of the command from the presence of Lordship (ḥaḍrat al-rubūbiyyah) — \"they do not disobey God in what He commands them, and they do what they are commanded\" (66:6). And He expressed these witnessed realities in the Qur'an, and it was said: {«وفي السماء رزقكم وما توعدون»} \"And in the heaven is your provision and what you are promised\" (51:22). And He expressed the waiting of the angels of the heavens for what descends upon them of decree and command, and it was said: \"He created seven heavens and of the earth the like of them; {«يتنزل الأمر بينهن لتعلموا أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما»} 'the command descends between them, that you may know that God is powerful over all things and that God encompasses all things in knowledge'\" (65:12). These are matters whose interpretation (taʾwīl) none knows except God and those firmly rooted in knowledge (al-rāsikhūn fī al-ʿilm). And Ibn Abbas, may God be pleased with them both, expressed the exclusivity of those firmly rooted in knowledge to sciences that the understandings of creatures cannot bear, when he recited the saying of the Exalted: {«يتنزل الأمر بينهن»} \"The command descends between them,\" and said: \"Were I to mention what I know of the meaning of this verse, you would stone me\" — and in another wording: \"You would say he is an unbeliever.\"", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 990", "section_title_en": "On the Degrees of Proximity to God and the Hierarchy of Those Who Perfect Divine Wisdom", "section_index": 990, "anchors": "- Root: سير (s-y-r)\n  * Lisan / Ayn: \"السير: الذهاب والسفر، وسار يسير سيرا ومسيرا، والسيارة: الرفقة المسافرة\"\n  * Al-Raghib (Mufradat): \"السير: الانتقال من مكان إلى مكان، ويستعار للسلوك في الدين والطريقة\"\n  * Al-Zamakhshari (Asas): [Literal] \"سار القوم: مشوا\" — [Metaphorical] \"سار فيه السير: مضى في الأمر، وسار ذكره: انتشر، ومنه: سيرة فلان: طريقته\"\n- Root: مشي (m-sh-y)\n  * Lisan / Ayn: \"المشي: تردد الأركان على الأرض، والماشية: الإبل والغنم لانتقالها في المرعى\"\n  * Al-Raghib (Mufradat): \"المشي: الانتقال من مكان إلى مكان بإرادة، ويكنى به عن النميمة، وعن شرب المسهل\"\n  * Al-Zamakhshari (Asas): [Literal] \"مشيت وتمشيت، وهي حسنة المشية\" — [Metaphorical] \"مشى بطنه، وأمشاه الدواء، واستمشيت بالدواء، ومنه: مشت المرأة: كثرت أولادها\"\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: \"الخلق: التقدير، والخلق: الناس، والخليقة: الطبيعة، والخلق: السجية\"\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\"\n  * Al-Zamakhshari (Asas): [Literal] \"خلق الخراز الأديم: قدره قبل القطع\" — [Metaphorical] \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\"\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: \"النفس: الروح، والذات، والشيء النفيس\"\n  * Al-Raghib (Mufradat): \"النفس: الروح، وتطلق على الذات، قال تعالى: {ويحذركم الله نفسه} فنفسه: ذاته\"\n  * Al-Zamakhshari (Asas): [Literal] \"شيء نفيس ومنفس\" — [Metaphorical] \"دفق نفسه أي دمه، وأصابته نفس: عين\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish exclusive attribution of actions to God versus creatures, as in \"إنما أنت مثل الصبي\" (You are only like a child), restricting the simile to the creature while preserving divine agency.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}, {"arabic": "جاءهم ما عرفوا كفروا به} إلى قوله {أن يكفروا بما أنزل الله بغيا} أي حسدا وقالت صفية بنت حيي للنبي صلى الله عليه وسلم جاء أبي وعمي من عندك يوما فقال أبي لعمي ما تقول فيه قال أقول أنه النبي الذي بشر به موسى قال فما ترى قال أرى معاداته أيام الحياة (2) فهذا حكم الحسد في التحريم وأما المنافسة فليست بحرام بل هي إما واجبة وإما مندوبة وإما مباحة وقد يستعمل لفظ الحسد بدل المنافسة والمنافسة بدل الحسد قال قثم بن العباس لما أراد هو والفضل أن يأتيا النبي صلى الله عليه وسلم فيسألاه أن يؤمرهما على الصدقة قالا لعلي حين", "english": "The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"", "book_title": "Condemnation of Envy", "section_title_ar": "Section 720", "section_title_en": "On the Reality of Envy (Ḥasad) and Its Degrees — Section 720", "section_index": 720, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Envy'", "badge": "Hadith"}], "93": [{"arabic": "مبصرة ولم تكن عمياء ولم يدر أنهم بماذا ظلموا غيرهم أو أنفسهم وقوله تعالى وأشربوا في قلوبهم العجل بكفرهم أي حب العجل فحذف الحب وقوله عز وجل إذا لأذقناك ضعف الحياة وضعف الممات أي ضعف عذاب الأحياء وضعف عذاب الموتى فحذف العذاب وأبدل الأحياء والموتى بذكر الحياة والموت وكل ذلك جائز في فصيح اللغة وقوله تعالى واسئل القرية التي كنا فيها والعير التي أقبلنا فيها أي أهل العير فالأهل فيهما محذوف مضمر وقوله عز وجل ثقلت في السموات والأرض معناه خفيت على أهل السموات والأرض والشيء إذا خفي ثقل فأبدل اللفظ به وأقيم في مقام على وأضمر الأهل وحذف وقوله تعالى وتجعلون", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "94": [{"arabic": "لأحببته وتلا قوله تعالى فتمنوا الموت إن كنتم صادقين فقال الرجل فقد قال النبي صلى الله عليه وسلم لا يتمنينأحدكم الموت (3) فقال إنما قاله لضر نزل به لأن الرضا بقضاء الله تعالى أفضل من طلب الفرار منه فإن قلت من لا يحب الموت فهل يتصور أن يكون محبا لله فأقول كراهة الموت قد تكون لحب الدنيا والتأسف على فراق الأهل والمال والولد وهذا ينافي كمال حب الله تعالى لأن الحب الكامل هو الذي يستغرق كل القلب ولكن لا يبعد أن يكون له مع حب الأهل والولد شائبة من حب الله تعالى ضعيفة فإن الناس متفاوتون في الحب ويدل على ا", "english": "He, peace be upon him, said: «من أحب لقاء الله أحب الله لقاءه» — \"Whoever loves the meeting with God, God loves meeting with him.\" And Ḥudhayfah said at the moment of death: \"A beloved has come upon the occasion of need; he who regrets has not succeeded.\"", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1175", "section_title_en": "The Signs and Proofs of Love for God — Section 1175", "section_index": 1175, "anchors": "- Root: ح ب ب (ḥ-b-b)\n  * Lisan / Ayn: Core root meaning: to love, to cherish; al-ḥabīb is the beloved; maḥabbah denotes the inclination of the heart toward that which pleases it.\n  * Al-Raghib (Mufradat): Maḥabbah of God for the servant is His willing good for him and drawing him near; the servant's love for God is his inclination toward obedience and his yearning for vision (ru'yah) of Him.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the heart's attachment; metaphorical (majāz): love as expressed through action and sacrifice, since mere claim without proof is empty.\n- Root: م و ت (m-w-t)\n  * Lisan / Ayn: Death as the cessation of corporeal life; the transition from this abode.\n  * Al-Raghib (Mufradat): Death is not annihilation but departure from the body — a relocation of the soul; hence the believer's love of death is love of meeting God.\n  * Al-Zamakhshari (Asas): Literal: biological death; metaphorical: the \"death\" of appetites and the severance of worldly attachments as a spiritual state.\n- Root: ق ت ل (q-t-l)\n  * Lisan / Ayn: Killing, slaying; qitāl is combat.\n  * Al-Raghib (Mufradat): Martyrdom (shahādah) in God's path is the supreme proof of sincere love, as it offers the self entirely.\n  * Al-Zamakhshari (Asas): Literal: physical combat; metaphorical: the struggle against the lower self (jihād al-nafs) as the greater warfare.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to distinguish genuine love from mere claim, restricting true love to that which is evidenced by action.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Love, Longing, Intimacy and Contentment'", "badge": "Afterlife"}], "96": [{"arabic": "الله تعالى يود أحدهم لو يعمر ألف سنة ومنهم من يأمل البقاء إلى الهرم وهو أقصى العمر الذي شاهده ورآه وهو الذي يحب الدنيا حبا شديدا قال رسول الله صلى الله عليه وسلم الشيخ شاب في حب طلب الدنيا وإن التفت ترقوتاه من الكبر إلا الذين اتقوا وقليل ما هم (1) ومنهم من يأمل إلى سنة فلا يشتغل بتدبير ما وراءها فلا يقدر لنفسه وجودا في عام قابل ولكن هذا يستعد في الصيف للشتاء وفي الشتاء للصيف فإذا جمع ما يكفيه لسنته اشتغل بالعبادة ومنهم من يأمل مدة الصيف أو الشتاء فلا يدخر في الصيف ثياب", "english": "I say: Know that people vary in this matter [of hope's length and brevity]. Among them is one who hopes for survival and desires it perpetually. Allah Most High said: {يَوَدُّ أَحَدُهُمْ لَوْ يُعَمَّرُ أَلْفَ سَنَةٍ} \"One of them wishes he might live a thousand years\" (Al-Baqarah 96). Among them is one who hopes for survival until senility — that being the farthest lifespan he has witnessed and seen — and he is the one who loves this world with intense love. The Messenger of Allah, peace and blessings be upon him, said: \"The old man is young in the love of seeking this world, even if his collarbones have bent from old age — except for the God-fearing, and few they are.\" Among them is one who hopes for a single year, so he does not occupy himself with managing what lies beyond it, and he does not grant himself existence in the coming year. But this one prepares in summer for winter and in winter for summer; when he has gathered what suffices him for his year, he occupies himself with worship. Among them is one whose hope reverts to the duration of summer or winter, so he does not store winter clothes in summer, nor summer clothes in winter. Among them is one whose hope returns to a day and a night, so he prepares only for his daytime, and as for tomorrow, he does not. Jesus, peace be upon him, said: \"Do not worry about the provision of tomorrow; for if tomorrow is among your appointed terms, your provisions will come to you in it along with your terms, and if it is not among your terms, then do not worry about the terms of others.\" Among them is one whose hope does not exceed an hour, as our Prophet, peace and blessings be upon him, said: \"O servant of Allah, when you enter the morning, do not speak to yourself of the evening, and when you enter the evening, do not speak to yourself of the morning.\" Among them is one who does not even grant himself survival for an hour — the Messenger of Allah, peace and blessings be upon him, used to perform dry ablution (tayammum) despite the availability of water before an hour passed, saying, \"Perhaps I will not reach it.\" Among them is one who has death placed before his very eyes as if it has already befallen him, so he awaits it. This is the man who prays the prayer of a farewell. Concerning this, what is transmitted from Muʿādh ibn Jabal, may Allah Most High be pleased with him, is relevant: when the Messenger of Allah, peace and blessings be upon him, asked him about the reality of his faith, he said, \"I have not taken a single step except that I thought I would not follow it with another.\" Likewise, what is transmitted from al-Aswad, an Abyssinian, that he used to pray at night and turn right and left, and a speaker said to him, \"What is this?\" He said, \"I am looking to see from which direction the Angel of Death will come to me.\" These are the ranks of people, and for each are degrees with Allah. The one whose hope is confined to a month is not like the one whose hope is a month and a day; rather, between them is a difference in degree with Allah, for {إِنَّ اللَّهَ لَا يَظْلِمُ مِثْقَالَ ذَرَّةٍ وَمَنْ يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُ} \"Indeed, Allah does not wrong even the weight of an atom, and whoever does an atom's weight of good shall see it\" (Al-Zalzalah 7-8). Then the effect of shortened hope appears in hastening to action. Every person claims to be short of hope, yet he is a liar; this is only manifested by his deeds, for he attends to causes that perhaps he will not need for a year — and that indicates the length of his hope. The sole sign of divine success (tawfīq) is that death be placed before one's eyes, not neglected for an hour. So let him prepare for the death that will come upon him at any moment; for if he lives until evening, he thanks Allah Most High for his obedience and rejoices that he did not waste his day, but rather extracted his full share from it and stored it for himself. Then he resumes the like of it until morning, and likewise when he enters the morning. And this is not facilitated except for one whose heart is emptied of tomorrow and what it contains. Such a one, if he dies, has prospered and gained; and if he lives, he rejoices in the excellence of his preparation and the delight of intimate communion (munājāh). So death is for him a happiness, and life is for him an increase. Let death be on your mind, O wretched one, for the journey is hastening you onward while you are heedless of yourself — perhaps you have already neared the destination and traversed the distance. And you will not be so except by hastening to action, seizing the opportunity of every breath in which you are granted respite.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1289", "section_title_en": "Exposition of the Ranks of People Regarding the Length and Shortness of Hope (Bayān Marātib al-Nās fī Ṭūl al-Amal wa Qiṣrih)", "section_index": 1289, "anchors": "- Root: أمل (amal)\n  * Lisan / Ayn: Core meaning is \"hope\" or \"expectation\" — the soul's aspiration toward a future occurrence; its length or brevity determines one's orientation to worldly life versus the Hereafter.\n  * Al-Raghib (Mufradat): Theological nuance: Amal is the psychological attachment to prolonged life in this world (Ṭūl al-Amal), which the Qur'an censures as a veil from preparation for death; its opposite is qaṣr al-amal (shortening of hope), a mark of true piety and vigilance.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): Amal as genuine expectation of future events. Metaphorical (Majaz): When coupled with deeds, it reveals the heart's true state — a man's claim of short hope is tested by his actual preparations, which betray hidden length of hope.\n- Root: موت (mawt)\n  * Lisan / Ayn: Death as the cessation of life; also \"dead land\" (mawāt) — that which is lifeless and awaiting revival.\n  * Al-Raghib (Mufradat): Death is not annihilation but transition; the soul's separation from the body. In Kalam, it is an accident (ʿaraḍ) created by Allah, and the believer's constant awareness of it is the catalyst for righteous action.\n  * Al-Zamakhshari (Asas): Literal: Physical death. Metaphorical: \"Placing death before one's eyes\" (al-mawt naṣb ʿaynayh) — a state of perpetual mindfulness where one acts as if death is imminent, transforming hope into urgent obedience.\n- Root: نفس (nafs)\n  * Lisan / Ayn: The self or soul; also breath — the animating principle.\n  * Al-Raghib (Mufradat): Nafs as the locus of desire and aspiration; here, the self that must be disciplined against false hopes, for it naturally clings to worldly survival.\n  * Al-Zamakhshari (Asas): Literal: The soul's innate longing. Metaphorical: \"Do not speak to yourself\" (lā tuḥaddith nafsaka) — restraining the inner dialogue that projects future plans, a discipline of the subtle reality (laṭīfah) within.\n- Root: صيف (ṣayf)\n  * Lisan / Ayn: Summer — a season of provision and preparation.\n  * Al-Raghib (Mufradat): Summer and winter (Quraysh 2) symbolize cyclical worldly concerns; the wise prepare in one season for the next, but the truly awakened prepare only for the hour at hand.\n  * Al-Zamakhshari (Asas): Literal: Seasonal preparation. Metaphorical: \"Summer-born\" (ṣayfiyyūn) — children born late in life, akin to those whose hope extends only to a season, yet even this is a form of worldly attachment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used in the final clause \"إنما علامة التوفيق\" to restrict the sole sign of divine success to keeping death before one's eyes, excluding all other pretensions.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "104": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "109": [{"arabic": "والشماتة يتلازمان وقال تعالى {ود كثير من أهل الكتاب لو يردونكم من بعد إيمانكم كفارا حسدا من عند أنفسهم} فأخبر تعالى أن حبهم زوال نعمة الإيمان حسد وقال عز وجل {ودوا لو تكفرون كما كفروا فتكونون سواء} وذكر الله تعالى حسد إخوة يوسف عليه السلام وعبر عما في قلوبهم بقوله تعالى {إذ قالوا ليوسف وأخوه أحب إلى أبينا منا ونحن عصبة إن أبانا لفي ضلال مبين اقتلوا يوسف أو اطرحوه أرضا يخل لكم وجه أبيكم} فلما كرهوا حب أبيهم له وساءهم ذلك وأحبوا زواله عنه غيبوه عنه وقال تعالى {ولا يجدون في صدورهم حاجة مما أوتوا} أي لا تضيق صدورهم به ولا يغتمون فأثنى عليهم بعدم الحسد وقال ت", "english": "The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"", "book_title": "Condemnation of Envy", "section_title_ar": "Section 720", "section_title_en": "On the Reality of Envy (Ḥasad) and Its Degrees — Section 720", "section_index": 720, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'", "badge": "Insight"}], "110": [{"arabic": "الصلاة التي هي أعلى الأعلام فقال تعالى {وأقيموا الصلاة وآتوا الزكاة} وقال صلى الله عليه وسلم بني الإسلام على خمس شهادة أن لا إله إلا الله وأن محمدا عبده ورسوله وإقام الصلاة وإيتاء الزكاة (2) وشدد الوعيد على المقصرين فيها فقال {والذين يكنزون الذهب والفضة ولا ينفقونها في سبيل الله فبشرهم بعذاب أليم} ومعنى الإنفاق في سبيل الله إخراج حق الزكاة قال الأحنف بن قيس كنت في نفر من قريش فمر أبو ذر فقال بشر الكانزين بكي في ظهورهم يخرج من جنوبهم وبكي في أقفائهم يخرج من جباههم وفي رواية أنه يوضع على حلمة ثدي أحده", "english": "To proceed: God Most High made alms (al-zakāh) one of the pillars of Islam, and joined its mention with prayer (al-ṣalāh), which is the loftiest of symbols. He said Most High: {«وَأَقِيمُوا الصَّلَاةَ وَآتُوا الزَّكَاةَ»} — \"And establish prayer and give alms.\" And he, peace and blessings be upon him, said: \"Islam is built upon five: the testimony that there is no god but God and that Muhammad is His servant and Messenger, the establishment of prayer, and the giving of alms.\" And He intensified the threat against those who fall short in it, saying: {«وَالَّذِينَ يَكْنِزُونَ الذَّهَبَ وَالْفِضَّةَ وَلَا يُنفِقُونَهَا فِي سَبِيلِ اللَّهِ فَبَشِّرْهُم بِعَذَابٍ أَلِيمٍ»} — \"And those who hoard gold and silver and do not spend them in the way of God — give them tidings of a painful chastisement.\" And the meaning of \"spending in the way of God\" is the payment of the due right of alms (zakāh).", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 167", "section_title_en": "The Book of the Secrets of Alms (Zakat) — Section 167", "section_index": 167, "anchors": "- Root: زكا (Z-K-Y)\n  * Lisan / Ayn: \"Zakā al-zar'u yazkū zakā'an: it increased and grew.\" Core meaning: growth, increase, purification.\n  * Al-Raghib (Mufradat): \"The origin of zakāh is the growth that occurs through the blessing of God Most High... and from it is zakāh: what a person pays of God's right to the poor, so named for the hope of blessing in it, or for the purification (tazkiyah) of the soul, i.e., its growth.\"\n  * Al-Zamakhshari (Asas): Literal (haqīqah): growth and increase. Metaphorical (majāz): the purification of wealth through payment of the obligatory due.\n- Root: نعم (N-'-M)\n  * Lisan / Ayn: \"Na'ima 'ayshuhu: his life was pleasant.\" Core meaning: bounty, well-being, grace.\n  * Al-Raghib (Mufradat): \"Al-Ni'mah: the good state... and al-Ni'mah (with kasrah) is used for the genus, said of both little and much.\"\n  * Al-Zamakhshari (Asas): Literal: \"Jallat ni'mat Allāh wa na'mā'uh\" — God's grace and bounty are immense. Metaphorical: \"Khāfat na'āmatuhum\" — their ostriches departed (i.e., they fled), showing the root's extended usage.\n- Root: ظهر (Z-H-R)\n  * Lisan / Ayn: \"Zahara: to become apparent, to be victorious.\" Core meaning: back, outward appearance, manifestation.\n  * Al-Raghib (Mufradat): \"Al-Zahr: the back (body part)... and it is used metaphorically for the surface of the earth.\"\n  * Al-Zamakhshari (Asas): Literal: \"Rajul muzhir: a man strong of back.\" Metaphorical: \"Qalabtu al-amra zahrān li-baṭn\" — I turned the matter over back and belly (examined it thoroughly).\n- Root: سرر (S-R-R)\n  * Lisan / Ayn: \"Sarra: to conceal, to keep secret.\" Core meaning: secret, inner self, joy.\n  * Al-Raghib (Mufradat): \"Al-Isrār: the opposite of al-i'lān (declaring)... and al-sirr is the speech concealed in the soul.\"\n  * Al-Zamakhshari (Asas): Literal: \"Asarra al-ḥadīth: he concealed the speech.\" Metaphorical: \"Aṭaytuka sirrah: I gave you its choicest part (the secret/core of something).\"\n- Sibawayh Rule: Bāb al-faṣl bayna al-jār wa al-majrūr (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening clause is complete in itself, as in \"fa'āfa 'alayhim min ni'matihi mā...\" where the prepositional phrase is completed after an intervening relative clause.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Zakat'", "badge": "Du'a"}], "112": [{"arabic": "يفزع الناس يوم القيامة ولا يفزعون وهم أولياء الله الذين لا خوف عليهم ولا هم يحزنون وفيه شهر بن حوشب مختلف فيه // ورواه أبو هريرة رضي الله عنه وقال فيه إن حول العرش منابر من نور عليها قوم لباسهم نور ووجوههم نورا ليسوا بأنبياء ولا شهداء يغبطهم النبيون والشهداء فقالوا يا رسول الله صفهم لنا فقال هم المتحابون في الله والمتجالسون في الله والمتزاورون في الله (1) وقال صلى الله عليه وسلم ما تحاب اثنان في الله إلا كان أحبهما إلى الله أشدهما حبا لصاحبه (2) ويقال إن الأخوين في الله إذا كان أحدهما أعلى مقاما من الآخر", "english": "Know that affability (al-ulfah) is the fruit of excellent character (ḥusn al-khuluq), and estrangement (al-tafarruq) is the fruit of evil character. For excellent character necessitates mutual love, harmony, and concord, whereas evil character yields mutual hatred, envy, and turning away (al-tadābur). And whenever the source is praiseworthy, the fruit is likewise praiseworthy. The excellence of good character is not hidden in the religion; indeed, it is that with which God—glorified be He—praised His Prophet, peace be upon him, when He said: {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ} «And indeed, you are upon an immense character» (Al-Qalam: 4). The Prophet, peace be upon him, said: \"The thing which most causes people to enter Paradise is God-consciousness (taqwā) and excellent character.\" (1) Usāmah ibn Sharīk said: \"We said, O Messenger of God, what is the best thing given to a person?\" He said: \"Excellent character.\" (2) He, peace be upon him, also said: \"I was sent only to perfect the noble traits of character.\" (3) He, peace be upon him, said: \"Nothing is heavier in the Balance than excellent character.\" (4) He, peace be upon him, said: \"God does not beautify a person's outward form and his inward character, then feed him to the Fire.\" (5) He, peace be upon him, said: \"O Abū Hurayrah, adhere to excellent character.\" (Page V02P157) Abū Hurayrah, may God be pleased with him, said: \"What is excellent character, O Messenger of God?\" He said: \"That you join the one who cuts you off, forgive the one who wrongs you, and give to the one who deprives you.\" (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 402", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 402: On the Excellence of Affability (Al-Ulfah) and Brotherhood in God", "section_index": 402, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of harmonizing, uniting, and reconciling; the removal of estrangement (al-waḥshah) and the establishment of concord.\n  * Al-Raghib (Mufradat): Theological nuance of ta'līf as the divine act of harmonizing hearts, a blessing bestowed by God alone, as in {لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَّا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) denotes physical joining; metaphorical (majāz) denotes the spiritual and moral concord of hearts, which is the fruit of excellent character (ḥusn al-khuluq).\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: Root meaning of measuring, proportioning, and smoothing; hence, the inherent disposition and moral character of a person.\n  * Al-Raghib (Mufradat): The origination of a thing upon a just measure; for character, it is the inward form (al-ṣūrah al-bāṭinah) of the soul, just as the physical form is its outward shape.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is the physical creation and proportioning; metaphorical (majāz) is the moral and spiritual constitution, praised by God in {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ}.\n- Root: بغض (Bughḍ)\n  * Lisan / Ayn: The opposite of love (ḥubb); intense aversion and hatred.\n  * Al-Raghib (Mufradat): In the Kalam context, al-bughḍ fī Allāh (hatred for God's sake) is a spiritual act of discernment and loyalty, not a mere emotional impulse; it is paired with al-ḥubb fī Allāh as the strongest bond of faith (awthaq ʿurā al-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is personal animosity; metaphorical (majāz) is the righteous aversion to disobedience and the enemies of God, which is a form of devotion.\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — Governing the syntactic flow of conditional and relative clauses, ensuring the periodic structure of the author's argument remains coherent and unbroken.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}], "113": [{"arabic": "عالم الغيب والشهادة أنت تحكم بين عبادك فيما كانوا فيه يختلفون اهدني لما اختلف فيه من الحق بإذنك إنك تهدي من تشاء إلى صراط مستقيما (7) ثم يفتتح الصلاة ويصلي ركعتين خفيفتين ثم يصلي مثنى مثنى ما تيسر له ويختم بالوتر إن لم يكن قد صلى الوتر ويستحب أن يفصل بين الصلاتين عند تسليمه بمائة تسبيحة ليستريح ويزيد نشاطه للصلاة وقد صح في صلاة رسول الله صلى الله عليه وسلم بالليل أنه صلى أولا ركعتين خفيفتين ثم ركعتين طويلتين ثم ركعتين دون اللتين قبلهما ثم لم يزل يقصر بالتدريج إلى ثلاث عشرة ركعة (1) وسئلت عائشة رضي الله", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}], "116": [{"arabic": "وقال صلى الله عليه وسلم يستغفر للعالم ما في السموات والأرض (3) وأي منصب يزيد على منصب من تشتغل ملائكة السموات والأرض بالاستغفار له وقال صلى الله عليه وسلم إن الحكمة تزيد الشريف شرفا وترفع المملوك حتى يدرك مدارك الملوك (4) وقد نبه بهذا على ثمراته في الدنيا ومعلوم أن الآخرة خير وأبقى وقال صلى الله عليه وسلم خصلتان لا يكونان في منافق حسن سمت وفقه في الدين (5) ولا تشكن في الحديث لنفاق بعض فقهاء الزمان فإنه ما أراد به الفقه الذي ظننته وسيأتي معنى الفقه وأدنى درجات الفقيه أن يعلم أن الآخرة خير من الدنيا", "english": "How He, Glorified and Exalted, began with Himself, then seconded with the angels, and thirded with the people of knowledge — and sufficient for you is this as honor, excellence, splendor, and nobility. And God, Exalted, said: {«يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات»} — \"God will raise those who have believed among you and those who have been given knowledge, in degrees.\" Ibn ʿAbbās, may God be pleased with them both, said: For the scholars there are degrees above the believers, seven hundred degrees, and between each two degrees is a distance of five hundred years' journey.", "book_title": "Contemplation", "section_title_ar": "Section 4", "section_title_en": "The Book of Knowledge — Section 4: The Excellence of Knowledge and the Scholars", "section_index": 4, "anchors": "- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Core root meaning of knowing, perceiving a thing in its true reality; the act of apprehension and judgment.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment of existence or non-existence.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes genuine knowing; metaphorical (majāz) usage extends to signs, landmarks, and traces that guide to knowledge.\n- Root: درج (d-r-j)\n  * Lisan / Ayn: Degrees, steps, ascending stations; the root denotes gradation and progressive elevation.\n  * Al-Raghib (Mufradat): \"الدرجة نحو المنزلة، لكن يقال للمنزلة: درجة إذا اعتبرت بالصعود\" — a degree is a station considered by ascent, not horizontal extension.\n  * Al-Zamakhshari (Asas): Literal: physical steps of ascent. Metaphorical: \"لفلان درجة رفيعة\" — lofty rank; \"امش في مدارج الحق\" — walk in the paths of truth.\n- Root: يوم (y-w-m)\n  * Lisan / Ayn: A day; a period of time from sunrise to sunset, or any duration whatsoever.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day denotes the time of the sun's rising to its setting, and may denote any period of time whatsoever.\n  * Al-Zamakhshari (Asas): Literal: the solar day. Metaphorical: \"ذكر في أيام العرب كذا\" — historical battles and events; \"وذكرهم بأيام الله\" — His mighty deeds against the disbelievers.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction and Focused Predication) — The particle \"innamā\" restricts and confines the predicate to the subject alone, as in {«إنما يخشى الله من عباده العلماء»}, where fear of God is restricted exclusively to the scholars.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'", "badge": "Hadith"}], "120": [{"arabic": "هذه العلة قد تبقى مع سقوط الشهوات بل يحب الإنسان من العلوم ما لا يصلح للتوصل به إلى الأغراض بل ربما يفوت عليه جملة من الأغراض والشهوات ولكن الطبع يتقاضى طلب العلم في جميع العجائب والمشكلات لأن في العلم استيلاء على المعلوم وهو نوع من الكمال الذي هو من صفات الربوبية فكان محبوبا بالطبع إلا أن في حب كمال العلم والقدرة أغاليط لا بد من بيانها إن شاء الله تعالى بيان الكمال الحقيقي والكمال الوهمي الذي لا حقيقة له قد عرفت أنه لا كمال بعد فوات التفرد بالوجود إلا في العلم والقدرة ولكن الكمال الحقيقي فيه متلبس بالكمال", "english": "For this reason, he — peace and blessings be upon him — said: «مَنْهُومَانِ لَا يَشْبَعَانِ» (\"Two are insatiably craving and never satiated\"). Thus, what hearts seek is perfection, and perfection lies in knowledge and power; and the variance of degrees therein is unbounded. So each person's joy and pleasure are proportionate to the perfection he attains. This, then, is the cause of knowledge, wealth, and status being loved — a cause beyond their being loved merely as means to satisfying appetites. For this cause may persist even when appetites have fallen away; indeed, a man loves sciences that are of no use in attaining his worldly aims — nay, they may even cost him a host of his goals and appetites — yet nature still demands the pursuit of knowledge in all wondrous and perplexing things, because in knowledge there is a domination over the known, which is a kind of perfection belonging to the attributes of lordship. Thus it is naturally loved — except that in the love of the perfection of knowledge and power there are errors (aghalīṭ) that must be explained, God — exalted be He — willing.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 798", "section_title_en": "The Love of Knowledge, Power, Wealth, and Status — and the True vs. Illusory Perfection", "section_index": 798, "anchors": "- Root: قدر (qadr/qudrah)\n  * Lisan / Ayn: Core sense of measuring, determining, and enabling; qudrah as the capacity to bring about an act.\n  * Al-Raghib (Mufradat): Qudrah attributed to humans is a disposition (hay'ah) enabling specific acts; attributed to God, it negates incapacity ('ajz). Absolute qudrah belongs to God alone; human power is always restricted and mixed with weakness.\n  * Al-Zamakhshari (Asas): Literal: \"possessor of power\" (dhū qudrah). Metaphorical: \"far-reaching steed\" (faras ba'īd al-qadr) — extended stride, indicating that \"power over\" something is figuratively an \"extension\" of one's reach.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; also traces/markers (aʿlām) by which one is guided.\n  * Al-Raghib (Mufradat): ʿIlm is \"apprehension of a thing by its true reality\" (idrāk al-shay' bi-ḥaqīqatihi) — either grasping the essence (dhāt) or judging its attributes.\n  * Al-Zamakhshari (Asas): Literal: \"to be aware/informed.\" Metaphorical: \"lofty banners of knowledge\" (aʿlām al-ʿilm al-khāfiqah) — knowledge as a raised standard of honor and conquest over the unknown.\n- Root: قلب (qalb)\n  * Lisan / Ayn: Turning and overturning a thing from one state to another.\n  * Al-Raghib (Mufradat): Taqlīb is the constant turning of a thing; the heart is so named for its perpetual fluctuation (taqallub) between states.\n  * Al-Zamakhshari (Asas): Literal: to flip a garment or coin. Metaphorical: \"a man who turns matters over\" (rajul qalb ḥawal) — one who skillfully manages and dominates affairs; hearts are \"subjugated\" (taskhīr) only through love, which itself follows perceived perfection.\n- Root: طبع (ṭabʿ)\n  * Lisan / Ayn: Stamping, impressing a seal upon a surface.\n  * Al-Raghib (Mufradat): Ṭabʿ is to impress a form upon something, broader than khatm (sealing) and narrower than naqsh (engraving). God's \"sealing\" of hearts is a metaphor for their being rendered impervious to truth.\n  * Al-Zamakhshari (Asas): Literal: coining a dirham. Metaphorical: \"stamped by nature upon generosity\" (maṭbūʿ ʿalā al-karam) — an ingrained, fixed disposition; here, the natural (bi-al-ṭabʿ) love of perfection is an innate impress of the divine attribute within the human subtlety.\n- Sibawayh Rule: Restriction and Specification (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"the object of hearts is perfection alone\" (fa-innamā maṭlūb al-qulūb al-kamāl), eliminating any other motive.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "تعالى بتخصيص الإضافة إليه وإن كان الكل من جهته تعالى فقال تعالى {قل إن هدى الله هو الهدى} وهو المسمى حياة في قوله تعالى {أو من كان ميتا فأحييناه وجعلنا له نورا يمشي به في الناس} والمعنى بقوله تعالى {أفمن شرح الله صدره للإسلام فهو على نور من ربه} وأما الرشد فنعني به العناية الإلهية التي تعين الإنسان عند توجهه إلى مقاصده فتقوبه على ما فيه صلاحه وتفتره عما فيه فساده ويكون ذلك من الباطن كما قال تعالى {ولقد آتينا إبراهيم رشده من قبل وكنا به عالمين} فالرشد عبارة عن هداية باعثة إلى جهة السعادة محركة إليها فالصبي إذا بلغ خبيرا بحفظ الم", "english": "PageV04P107\nBut if one does not know what constitutes the welfare of his hereafter—so that he even supposes corruption to be welfare—then from where would mere volition benefit him? There is no benefit in volition, power, and causes except after guidance (hidāyah). For this reason, God—exalted is He—said: {«ربنا الذي أعطى كل شيء خلقه ثم هدى»} \"Our Lord who gave everything its creation, then guided.\" And He said—exalted is He—: {«ولولا فضل الله عليكم ورحمته ما زكى منكم أحد أبدا ولكن الله يزكي من يشاء»} \"And were it not for God's bounty upon you and His mercy, not one of you would ever be purified; but God purifies whom He wills.\" And the Prophet—peace be upon him—said: \"No one enters Paradise except by the mercy of God—exalted is He—,\" that is, by His guidance. So it was said: \"Not even you, O Messenger of God?\" He said: \"Not even I\" (1). And guidance (hidāyah) has three stations (manāzil):", "book_title": "Patience and Gratitude", "section_title_ar": "Section 999", "section_title_en": "The Degrees of Divine Guidance (Hidāyah), Righteous Discernment (Rushd), Straightening (Tasdīd), and Divine Support (Ta'yīd)", "section_index": 999, "anchors": "- Root: هدي (H-D-Y)\n  * Lisan / Ayn: Core meaning of gentle, gracious direction (dalālah bi-luṭf); the root also yields \"gift\" (hadiyyah) and the leading beasts of prey (hawādī) that guide the herd.\n  * Al-Raghib (Mufradat): Guidance is \"directional indication with gentleness\" (dalālah bi-luṭf), distinct from mere intellectual proof; it is a divine act that may be general (to all) or specific (to the elect), and its withholding is a form of abandonment.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He guided him to the path\" (hadāhu lil-sabīl). Metaphorical (majāz): \"He guided him\" meaning \"he preceded him\" (taqaddamahu), as a leader precedes the caravan; hence guidance is not merely pointing but active leading.\n- Root: رشد (R-SH-D)\n  * Lisan / Ayn: The state of being rightly directed in one's affairs; integrity of judgment; names Rāshid, Rushayd derive from it.\n  * Al-Raghib (Mufradat): Rushd is the opposite of ghayy (error/ruin); it is used like hidāyah but with a nuance of practical, executive discernment—knowing the good AND being moved to pursue it. Al-Raghib explicitly distinguishes the rushd of Abraham (given before, as a special gift) from the mere legal competence (rushd) of an orphan.\n  * Al-Zamakhshari (Asas): Literal: \"A man is rāshid or rashīd\" (possessing rightness in conduct). Metaphorical: \"He is of sound lineage\" (huwa li-rushdah), i.e., legitimate—showing the root's extension to ontological soundness.\n- Root: سدد (S-D-D)\n  * Lisan / Ayn: To aim correctly, to hit the mark; the arrow that flies straight (sadīd); the opposite of deviation (ighrāḍ).\n  * Al-Raghib (Mufradat): (Not in the retrieved scholia, but by extension from the root's usage in the Qur'an, e.g., {wa-saddidū}, \"and be straight/aim rightly\")—it denotes the divine facilitation of the creature's movements so they align with the intended good.\n  * Al-Zamakhshari (Asas): Literal: \"He aimed the arrow and it went straight.\" Metaphorical: \"He was granted success in speech and action\" (sudda li-l-ṣawāb).\n- Root: أيد (A-Y-D)\n  * Lisan / Ayn: Strength, support, reinforcement; the \"aid\" (ayd) of God is His empowering of His servant.\n  * Al-Raghib (Mufradat): (By extension from {إذ أيدتك بروح القدس})—divine reinforcement through a holy spirit, i.e., an immaterial power that fortifies both inner perception (baṣīrah) and outer action.\n  * Al-Zamakhshari (Asas): Literal: \"He strengthened him\" (ayyadahu). Metaphorical: Used for the conferral of spiritual power that makes the servant invincible against error.\n- Sibawayh Rule: Rule of Gradation and Specification (Tartīb wa-Takhṣīṣ) — The author structures a sequence of terms (hidāyah → rushd → tasdīd → ta'yīd) where each subsequent term is syntactically and semantically superordinate, building a hierarchy of divine acts. The particle \"wa-ammā\" (وأما) marks a new topic with contrastive focus, and the anaphoric references (هو، وهي) bind the exposition into a single periodic argument.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}], "121": [{"arabic": "قال الله تعالى {الذين آتيناهم الكتاب يتلونه حق تلاوته} أي لا يجاوزون فنا حتى يحكموه علما وعملا وليكن قصده في كل علم يتحراه الترقي إلى ما هو فوقه فينبغي ألا يحكم على علم بالفساد لوقوع الخلف بين أصحابه فيه ولا بخطأ واحد أو آحاد فيه ولا بمخالفتهم موجب علمهم بالعمل فترى جماعة تركوا النظر في العقليات والفقهيات متعللين فيها بأنها لو كان لها أصل لأدركه أربابها وقد مضى كشف هذه الشبه في كتاب معيار العلم وترى طائفة يعتقدون بطلان الطب لخطأ شاهدوه من طبيب وطائفة اعتقدوا صحة النجوم لصواب اتفق لواحد وطائفة اعتقدوا بطلانه", "english": "By this I do not mean the belief which the common man picks up by inheritance or by rote acquisition, nor the method of theological disputation and argumentation for fortifying one's creed against the evasions of opponents—as is the ultimate aim of the scholastic theologian (mutakallim). Rather, it is a kind of certainty which is the fruit of a light that God—may He be exalted—casts into the heart of a servant whose inward being has been purified by spiritual striving (mujāhadah) from all impurities, until he attains to the rank of the faith of Abū Bakr—may God be pleased with him—whose faith, were it weighed against the faith of all created beings, would outweigh them, as the Master of mankind—peace and blessings be upon him—bore witness for him. For in my view, what the common man believes and what the theologian arranges—who exceeds the common man only in the craft of speech (kalām), and for that very reason his craft is named \"kalām\"—is not that rank. Indeed, ʿUmar, ʿUthmān, ʿAlī, and the rest of the Companions—may God be pleased with them all—fell short of it, until Abū Bakr surpassed them by that secret which was deposited in his breast.", "book_title": "Book of Knowledge", "section_title_ar": "Section 43", "section_title_en": "The Revival of the Religious Sciences — Section 43: On the Ordering of the Sciences and the Duties of the Seeker", "section_index": 43, "anchors": "- Root: ذوق (dh-w-q)\n  * Lisan / Ayn: Perceiving by taste; experiential apprehension\n  * Al-Raghib (Mufradat): Direct, unmediated perception—contrasted with mere cognition or hearsay\n  * Al-Zamakhshari (Asas): Literal tasting vs. metaphorical \"savoring\" of knowledge\n- Root: سلك (s-l-k)\n  * Lisan / Ayn: Entering into a path; threading through\n  * Al-Raghib (Mufradat): The spiritual wayfaring (sulūk) toward God\n  * Al-Zamakhshari (Asas): Literal road-taking vs. metaphorical spiritual journeying\n- Root: كشف (k-sh-f) — AVOIDED per constraints; substituted with Root: غور (gh-w-r)\n  * Lisan / Ayn: Depth, profundity; the deep bed of a sea\n  * Al-Raghib (Mufradat): The unfathomable depth of divine knowledge\n  * Al-Zamakhshari (Asas): Literal deep water vs. metaphorical inaccessibility of ultimate truth\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — Governing the periodic suspension of meaning across clauses for rhetorical emphasis", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "123": [{"arabic": "ويوم لا تجزي نفس عن نفس شيئا ويوم تشخص فيه الأبصار ويوم لا يغنى مولى عن مولى شيئا ويوم لا تملك نفس لنفس شيئا ويوم يدعون إلى نار جهنم دعا ويوم يسحبون فى النار على وجوههم ويوم تقلب وجوههم فى النار ويوم لا يجزى والد عن ولده ويوم يفر المرء من أخيه وأمه وأبيه ويوم لا ينطقون ولا يؤذن لهم فيعتذرون يوم لا مرد له من الله يوم هم بارزون ويوم هم على النار يفتنون يوم لا ينفع مال ولا بنون يوم لا ينفع الظالمين معذرتهم ولهم اللعنة ولهم سوء الدار يوم ترد فيه المعاذير وتبلى الس", "english": "So prepare yourself, O wretched one, for this Day of immense magnitude, of prolonged duration, of overwhelming dominion, whose appointed time is near — a Day when you shall see the heaven split asunder, and the stars scattered in its terror, and the shining planets extinguished, and the sun folded up, and the mountains set in motion, and the pregnant camels neglected, and the wild beasts gathered together, and the seas set ablaze, and the souls paired with their bodies, and the Hellfire ignited, and Paradise brought near, and the mountains pulverized, and the earth stretched out — a Day when you shall see the earth shaken with its quaking, and the earth casts forth its burdens. On that Day shall people issue forth in scattered groups to be shown their deeds — a Day when the earth and the mountains are lifted and crushed with a single crushing. Then on that Day the Imminent Event shall come to pass, and the heaven shall split open, for on that Day it shall be frail, and the angels shall be at its edges, and eight shall bear the Throne of your Lord above them on that Day. On that Day you shall be presented — no secret of yours shall remain hidden. A Day when the mountains shall move and you shall see the earth laid bare — a Day when the earth shall be shaken with a violent shaking, and the mountains crumbled to dust, becoming scattered particles — a Day when people shall be like scattered moths, and the mountains like carded wool — a Day when every nursing mother shall forget what she nursed, and every pregnant female shall cast down her burden, and you shall see people drunk, yet they are not drunk, but the chastisement of God is severe — a Day when the earth shall be changed to other than this earth, and the heavens, and they shall appear before God, the One, the All-Compelling — a Day when the mountains shall be blown away as dust, leaving a level, bare plain, wherein you see no crookedness nor curve — a Day when you see the mountains and suppose them solid, yet they pass by like the passing of clouds — a Day when the heaven shall split open and become rosy like molten oil. Then on that Day no human nor jinn shall be asked about his sin. A Day when the disobedient shall be prevented from speech, and shall not be asked about their crimes, but shall be seized by their forelocks and their feet — a Day when every soul shall find what it did of good brought forth present, and what it did of evil, wishing that between it and that evil there were a far distance — a Day when every soul shall know what it has sent ahead, and shall witness what it has forwarded and what it has left behind — a Day when tongues shall be struck mute and the bodily members shall speak — a Day whose mention turned the hair of the Master of the Messengers white, when al-Ṣiddīq (may God be pleased with him) said to him: \"I see that you have turned white-haired, O Messenger of God.\" He said: \"Sūrat Hūd and its sisters have made me white-haired\" — namely, al-Wāqiʿah, al-Mursalāt, ʿAmma Yatasāʾalūn, and Idhā al-Shamsu Kuwwirat.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1339", "section_title_en": "The Names and Attributes of the Day of Resurrection — An Exhortation to the Negligent", "section_index": 1339, "anchors": "- Root: يوم (yawm)\n  * Lisan / Ayn: \"اليوم: وقت طلوع الشمس إلى غروبها، وقد يعبر به عن مدة من الزمان أي مدة كانت\" — the day as a temporal span, extended metaphorically to any epoch or era.\n  * Al-Raghib (Mufradat): \"اليوم يعبر به عن وقت طلوع الشمس إلى غروبها. وقد يعبر به عن مدة من الزمان أي مدة كانت\" — theological usage denotes the appointed time of reckoning, magnified by divine attribution (أيام الله).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): a measured solar period. Metaphorical (Majaz): \"ذكر في أيام العرب كذا أي في وقائعها\" — days as epochal events; thus \"the Day\" is the supreme epochal event of divine justice.\n- Root: نفس (nafs)\n  * Lisan / Ayn: النفس: الروح والذات — the self, soul, or very essence.\n  * Al-Raghib (Mufradat): \"النفس: الروح... وقوله: ويحذركم الله نفسه فنفسه: ذاته\" — nafs as the innermost reality of a being; in the eschatological context, souls are \"paired\" (زوجت) with bodies for judgment.\n  * Al-Zamakhshari (Asas): Literal: the soul as life-principle. Metaphorical: \"دفق نفسه أي دمه\" — nafs as the total self, accountable in its entirety.\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: الجرم المقابل للسماء — the earth as the corporeal substratum beneath the heavens.\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء... ويعبر بها عن أسفل الشيء\" — the earth as the lowest register of creation, subject to total transformation on that Day.\n  * Al-Zamakhshari (Asas): Literal: the physical earth. Metaphorical: \"تأرض فلان: لزم الأرض\" — to cling low; on that Day the earth itself is leveled, flattened, and replaced.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated \"يوم\" clauses function as temporal restrictors (ẓurūf) binding each predicate to that single, all-encompassing moment; the accumulation of names (أسامي) serves not as mere repetition but as focused predication upon the multifarious realities of a single event.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Remembrance of Death and Afterlife'", "badge": "Insight"}], "125": [{"arabic": "الثاني تهييج الشوق بالمفارقة لتنبعث داعية العودة فإن الله تعالى جعل البيت مثابة للناس وأمنا أي يثوبون ويعودون إليه مرة بعد أخرى ولا يقضون منه وطرا وقال بعضهم تكون في بلد وقلبك مشتاق إلى مكة متعلق بهذا البيت خير لك من أن تكون فيه وأنت متبرم بالمقام وقلبك في بلد آخر وقال بعض السلف كم من رجل بخراسان هو أقرب إلى هذا البيت ممن يطوف به ويقال إن لله تعالى عبادا تطوف بهم الكعبة تقربا إلى الله عز وجل الثالث الخوف من ركوب الخطايا والذنوب بها فإن ذلك مخطر وبالحري أن يورث مقت الله عز وجل لشرف الموضع وروي عن وهيب بن الورد المكي قال كنت ذات ليلة", "english": "The first is the fear of becoming weary and familiar with the House, for that might perhaps effect a calming of the heart's burning in veneration. Thus it was that 'Umar (may Allah be pleased with him) used to strike the pilgrims when they performed the Hajj and say: \"O people of Yemen, to your Yemen! O people of Syria, to your Syria! O people of Iraq, to your Iraq!\" For this reason, 'Umar (may Allah be pleased with him) resolved to prevent people from excessive circumambulation and said: \"I fear that the people may become familiar with this House.\"", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 195", "section_title_en": "The Virtue of Residing in Mecca (May Allah Protect It) and the Disapproval of Doing So", "section_index": 195, "anchors": "- Root: خوف (kh-w-f)\n  * Lisan / Ayn: Core meaning of apprehension and dread of a feared outcome\n  * Al-Raghib (Mufradat): \"الخوف: توقع مكروه عن أمارة مظنونة، أو معلومة\" — the expectation of something disliked based on a probable or known indication\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): fear of a tangible threat; Metaphorical (Majaz): \"تخوفه: تنقصه\" — to diminish gradually, as in \"تخوف السير منها\" (the journey wore it down little by little)\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the permissible separation between a preposition and its object for rhetorical emphasis\n\n- Root: بيت (b-y-t)\n  * Lisan / Ayn: The place of overnight dwelling; the Ka'bah as the sacred house\n  * Al-Raghib (Mufradat): \"أصل البيت: مأوى الإنسان بالليل\" — the origin is man's shelter by night; then applied to any dwelling, with \"البيوت\" more specific to residences\n  * Al-Zamakhshari (Asas): Literal: the physical structure of the Ka'bah; Metaphorical: the heart's attachment and longing toward it\n- Sibawayh Rule: Rule of Contextual Specification — the term \"البيت\" (the House) in sacred context refers specifically to the Ka'bah by customary designation", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Hajj'", "badge": "Insight"}], "127": [{"arabic": "وتقول عند التصدق {ربنا تقبل منا إنك أنت السميع العليم} وتقول عند الخسران {عسى ربنا أن يبدلنا خيرا منها إنا إلى ربنا راغبون} وتقول عند ابتداء الأمور ربنا آتنا من لدنك رحمة وهيىء لنا من أمرنا رشدا رب اشرح لي صدري ويسر لي أمري وتقول عند النظر إلى السماء ربنا ما خلقت هذا باطلا سبحانك فقنا عذاب النار تبارك الذي جعل في السماء بروجا وجعل فيها سراجا وقمرا منيرا وإذا سمعت صوت الرعد فقل سبحان من يسبح الرعد بحمده والملائكة من خيفته (7) فإن رأيت الصواعق فقل اللهم لا تقتلنا بغضبك ولا تهلكنا بعذابك وعافنا قبل ذلك (8)", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "128": [{"arabic": "سوءا وظلمت نفسي أستغفرك اللهم وأتوب إليك فاغفر لي وتب على إنك أنت التواب الرحيم اللهم اجعلني من التوابين واجعلني من المتطهرين واجعلني من عبادك الصالحين واجعلني عبدا صبورا شكورا واجعلني أذكرك كثيرا وأسبحك بكرة وأصيلا يقال إن من قال هذا بعد الوضوء ختم على وضوئه بخاتم ورفع له تحت العرش فلم يزل يسبح الله تعالى ويقدسه ويكتب له ثواب ذلك إلى يوم القيامة ويكره في الوضوء أمور منها أن يزيد على الثلاث فمن زاد فقد ظلم وأن يسرف في الماء توضأ عليه السلام ثلاثا وقال من زاد فقد ظلم وأساء (4) وقال سيكون قوم من هذه الأمة يعتدون في الدعاء وال", "english": "Know that the use of the tooth-stick is a confirmed Sunnah. It is reported concerning its virtue from the ḥadīth of Ibn ʿUmar through a weak chain of transmission, and Abū Dāwūd and al-Ḥākim narrated it, and the latter declared it sound (ṣaḥīḥ). Al-Bayhaqī, however, deemed it weak from the ḥadīth of ʿĀʾishah, and he weakened the version containing the wording \"from seventy prayers.\" There is the ḥadīth: \"Were it not that I would impose hardship upon my community, I would have commanded them to use the tooth-stick at every prayer\" — agreed upon (muttafaq ʿalayh) from the ḥadīth of Abū Hurayrah. There is the ḥadīth: \"Why do I see you entering upon me with yellowed teeth? Use the tooth-stick!\" — al-Bazzār and al-Bayhaqī narrated it from the ḥadīth of al-ʿAbbās ibn ʿAbd al-Muṭṭalib; Abū Dāwūd and al-Baghawī from the ḥadīth of Tammām ibn al-ʿAbbās; and al-Bayhaqī from the ḥadīth of ʿAbd Allāh ibn ʿAbbās — and it is disordered (muḍṭarib). There is the ḥadīth: \"He used the tooth-stick multiple times during the night\" — Muslim narrated it from the ḥadīth of Ibn ʿAbbās. And the ḥadīth of Ibn ʿAbbās: \"The Messenger of God, may God bless him and grant him peace, did not cease commanding us to use the tooth-stick until we thought that something concerning it would be revealed to him\" — Aḥmad narrated it.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 112", "section_title_en": "The Book of the Tooth-Stick (Siwāk) and the Etiquette of Ablution (Wuḍūʾ)", "section_index": 112, "anchors": "- Root: س و ك (s-w-k)\n  * Lisan / Ayn: The root denotes rubbing or cleansing the teeth with a stick (siwāk); al-Farāhīdī notes its use for the act of friction against a surface to remove residue.\n  * Al-Raghib (Mufradat): In the religious lexicon, siwāk is a purifying act (taṭhīr) of the mouth, tied to devotional hygiene and the Sunnah's emphasis on preparing the body for prayer.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the physical stick (ʿūd) and the mechanical action; metaphorical (majāz) extension applies to spiritual purification, as the mouth's cleanliness mirrors the heart's purity.\n- Root: و ض ء (w-ḍ-ʾ)\n  * Lisan / Ayn: Wuḍūʾ signifies washing specific bodily parts for ritual purity; al-Khalīl links it to brightness and radiance (ḍawʾ), as the washed limbs shine on the Day of Resurrection.\n  * Al-Raghib (Mufradat): It is a legislated act of cleansing (ṭahārah) that removes minor ritual impurity (ḥadath), preconditioning the soul for communion with God in prayer.\n  * Al-Zamakhshari (Asas): Literal: washing with water; metaphorical: the inner purification of the heart from vices, as the outward washing symbolizes inward renewal.\n- Root: غ ر ر (gh-r-r)\n  * Lisan / Ayn: Ghurrah denotes a blaze or white mark on a horse's forehead; al-Ayn records its use for a prominent, shining feature.\n  * Al-Raghib (Mufradat): In the ḥadīth, \"ghurrah\" refers to the luminous mark on the forehead of the believer from washing in ablution, a sign of honor on the Day of Judgment.\n  * Al-Zamakhshari (Asas): Literal: the white star on a horse's brow; metaphorical: the radiant trace of worship on the believer's body, visible in the Hereafter.\n- Sibawayh Rule: Bāb al-ʿAṭf ʿalā al-Sabab (Coordination of Causes) — When linking actions or supplications (duʿāʾ) with fa- or thumma, the syntactic sequence mirrors the chronological order of ritual acts, ensuring that each clause is semantically complete and temporally precise.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "132": [{"arabic": "طول سهر الليل وطلب حيلة يجلب بها النوم فقال أستاذه يا بني إن لله نفحات في الليل والنهار تصيب القلوب المتيقظة تحظىء القلوب النائمة فتعرض لتلك النفحات فقال يا سيدي تركتني لا أنام بالليل ولا بالنهار", "english": "That if the beautiful Beloved were behind a veil or in a dark house, the lover would still take delight in mere proximity to Him, without vision and without coveting any other matter besides Him — and he would find joy in displaying his love before Him and in mentioning Him with his tongue within His hearing, even though that too were already known to Him. For if you say: \"He awaits His response\" — then let him delight in hearing His response; yet he does not hear the speech of God, exalted be He. Know then that if he knows that He will not answer him and will remain silent toward him, there still remains for him a delight in presenting his states before Him and in raising his innermost secret to Him. How [could it be otherwise], when the one who is certain (al-mūqin) hears from God, exalted be He, everything that occurs to his mind during the course of his whispered communion (munājāh), and thus takes delight in it? Likewise, one who secludes himself with a king and presents his needs to him in the depths of the night takes delight in it through hope of his beneficence — and hope with respect to God, exalted be He, is more truthful, and what is with God is better, more enduring, and more beneficial than what is with anyone else. So how would he not delight in presenting his needs before Him in private seclusions (khalawāt)?", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 277", "section_title_en": "On the Delight of Night Vigil and Whispered Communion — Section 277", "section_index": 277, "anchors": "- Root: ليل (layl)\n  * Lisan / Ayn: Night; the period of darkness following sunset until dawn; its diminutive is 'luyaylah' and its plural is 'layālin' — indicating a temporal span marked by stillness and concealment.\n  * Al-Raghib (Mufradat): Night (al-layl) is that which veils (yughashshī) and covers, as in {«وَاللَّيْلِ إِذَا يَغْشَى»} — a time when sensory distractions recede and the heart turns toward intimate communion (munājāh) with the Divine.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): the astronomical night. Metaphorical (majāz): the night of the heart — a state of spiritual wakefulness wherein the lover finds delight in solitude with the Beloved, as expressed in the sayings of the pious transmitted herein.\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; illumination that renders things visible; also the fire-kindling and the beacon (manār) guiding travelers.\n  * Al-Raghib (Mufradat): Light is of two kinds: sensory light perceived by the eye, and intellectual/spiritual light (nūr al-ʿaql, nūr al-Qurʾān) perceived by the inner eye of insight (baṣīrah). The Divine light cast into the hearts of the vigilant is of this latter kind — an immaterial radiance (laṭīfah nūrāniyyah) that transforms the inner state.\n  * Al-Zamakhshari (Asas): Literal: physical illumination. Metaphorical: 'nawwara al-amr' — to clarify and illuminate a matter; here, the spreading of spiritual lights (anwār) from wakeful hearts to heedless ones is a metaphorical extension of this root, signifying the transmission of divine grace.\n- Root: قلب (qalb)\n  * Lisan / Ayn: The heart; also the turning and revolving of a thing from one state to another (taqlīb).\n  * Al-Raghib (Mufradat): The heart is so named for its constant fluctuation (taqallub) between states; it is the seat of perception and understanding, the locus of divine address and the receptacle of spiritual lights.\n  * Al-Zamakhshari (Asas): Literal: the physical organ. Metaphorical: 'qallaba al-amr' — to examine and turn over a matter; here, the hearts of the vigilant are 'turned over' by divine light, and from them 'spread' (tantašir) blessings to others — a metaphorical extension of physical turning to spiritual transformation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle 'innamā' restricts and confines the predicate to the subject alone, as in the transmitted saying: \"The delight of whispered communion is not of this world; it is only (innamā) of Paradise\" — a focused predication that negates any worldly share of this pleasure and affirms its exclusive otherworldly origin.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Arrangement of Litanies'", "badge": "Insight"}], "135": [{"arabic": "محمد صلى الله عليه وسلم وملة أبينا إبراهيم حنيفا وما كان من المشركين (9) اللهم بك أصبحنا وبك أمسينا وبك نحيا وبك نموت وإليك المصير (10) اللهم إني أسألك أن تبعثنا في هذا اليوم إلى كل خير ونعوذ بك أن نجترح فيه سوءا أو نجره إلى مسلم فإنك قلت {وهو الذي يتوفاكم بالليل ويعلم ما جرحتم بالنهار ثم يبعثكم فيه ليقضى أجل مسمى} (11) اللهم فالق الإصباح وجاعل الليل سكنا والشمس والقمر حسبانا أسألك خير هذا اليوم وخير ما فيه وأعوذ بك من شره وشر ما فيه (12) بسم الله ما شاء الله لا قوة إلا بالله ما شاء الله", "english": "When you rise in the morning and hear the call to prayer (adhān), it is recommended for you to respond to the caller of prayer (mu'adhdhin) — and we have already mentioned this, along with the supplications for entering and leaving the privy, and the supplications of ablution (wuḍū'), in the Book of Purification. When you set out toward the mosque, say: \"O Allah, place light (nūr) in my heart, and light in my tongue, and place light in my hearing, and place light in my sight, and place light behind me, and light before me, and place light above me. O Allah, grant me light.\" And also say: \"O Allah, I ask You by the right of those who ask of You, and by the right of this my walking unto You — for I have not gone out in insolence, nor in vanity, nor for show, nor for reputation. I have gone out seeking protection from Your wrath and seeking Your good pleasure. So I ask You to deliver me from the Fire and to forgive me my sins — verily, none forgives sins but You.\"", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 254", "section_title_en": "Section 254 — Supplications for the Hours of Day and Night: From Dawn to Sleep", "section_index": 254, "anchors": "- Root: ن و ر (n-w-r)\n  * Lisan / Ayn: النور: الضوء المنتشر الذي يُبصر به، وهو ضد الظلمة\n  * Al-Raghib (Mufradat): النور في القرآن يقع على ضروب: منها المعقول كالإيمان والحكمة، قال تعالى: {قد جاءكم من الله نور وكتاب مبين}، ومنها المحسوس كضوء الشمس والقمر\n  * Al-Zamakhshari (Asas): النور حقيقة في الضوء المحسوس، ومجاز في الهدى والإيمان والعلم — فدعاء النبي صلى الله عليه وسلم بطلب النور يشمل المعنيين جميعاً\n- Root: س ج د (s-j-d)\n  * Lisan / Ayn: السجود: وضع الجبهة على الأرض تعظيماً، وأصله التطامن والانخفاض\n  * Al-Raghib (Mufradat): السجود ضربان: سجود عبادة وهو وضع الجبهة على الأرض تقرباً، وسجود طاعة وهو الانقياد والخضوع — قال تعالى: {ولله يسجد من في السموات والأرض طوعاً وكرهاً}\n  * Al-Zamakhshari (Asas): سجد حقيقة في وضع الجبهة، ومجاز في الخضوع والانقياد — وقوله \"سجد لك سوادي وخيالي\" من المجاز المرسل\n- Root: ذ ك ر (dh-k-r)\n  * Lisan / Ayn: الذكر: نقيض النسيان، والذكر: الصوت الذي يُذكر به الشيء، والذكر: الشرف والصيت\n  * Al-Raghib (Mufradat): الذكر ضربان: ذكر بالقلب وهو التفكر في عظمة الله، وذكر باللسان وهو التلفظ بأسمائه — وأعلى مراتبه ما اجتمع فيه القلب واللسان\n  * Al-Zamakhshari (Asas): الذكر حقيقة في استحضار الشيء بالقلب أو اللسان، ومجاز في الصلاة والدعاء والثناء\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — جواز تقديم المعمول وتأخيره مع بقاء العامل عاملاً في المعنى، كقوله \"لك الحمد\" حيث تقدم الجار والمجرور على المبتدأ للاختصاص والاهتمام", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}], "136": [{"arabic": "ولما قال سفيان ذلك قيل له فماذا نقول قال قولوا آمنا بالله وما أنزل إلينا وأي فرق بين أن يقول آمنا بالله وما أنزل إلينا وبين أن يقول أنا مؤمن وقيل للحسن أمؤمن أنت فقال إن شاء الله فقيل له لم تستثني يا أبا سعيد في الإيمان فقال أخاف أن أقول نعم فيقول الله سبحانه كذبت يا حسن فتحق علي الكلمة وكان يقول ما يؤمنني أن يكون الله سبحانه قد اطلع علي في بعض ما يكره فمقتني وقال اذهب لا قبلت لك عملا فأنا أعمل في غير معمل وقال إبراهيم بن أدهم إذا قيل لك أمؤمن أنت فقل لا إله إلا الله وقال مرة قل أنا لا أشك في الإيمان وسؤالك إياي بدعة", "english": "If you say: \"What is the meaning of the Salaf's statement, 'I am a believer, if God wills' — given that the exception (istithnā') implies doubt, and doubt in faith is unbelief? Yet they all refrained from giving an unqualified answer affirming faith and were cautious about it.\"", "book_title": "Foundations of Belief", "section_title_ar": "Section 102", "section_title_en": "On the Meaning of the Salaf's Statement \"I am a Believer, If God Wills\" — Section 102", "section_index": 102, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which is breathed; the innermost reality of a person.\n  * Al-Raghib (Mufradat): النفس is used for the rūḥ (spirit), for the dhāt (essence/self), and for the seat of intention and knowledge. When one says \"he knows in himself (nafsihi) that he is a believer,\" it denotes certitude residing in the very core of one's being, not a corporeal faculty.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to the soul's reflexive self-awareness; metaphorical (majāz) usage extends to \"blood\" (dam) or \"the eye\" (ʿayn) of envy. Here, \"in himself\" (fī nafsihi) is literal self-knowledge, not mere outward profession.\n- Root: وجه (w-j-h)\n  * Lisan / Ayn: Face, countenance; the foremost part; a mode, aspect, or direction.\n  * Al-Raghib (Mufradat): The face is the most noble apparent part of a thing; hence it is used for the \"aspect\" or \"manner\" (wajh) of an affair. \"Four aspects\" (wujūh) means four distinct modes of interpretation or rational grounds.\n  * Al-Zamakhshari (Asas): Literal: the face of a person or object. Metaphorical: \"the face of the matter\" (wajh al-amr) — its most salient and honorable dimension. Here, the \"aspects\" are hermeneutical angles, not physical parts.\n- Root: ايم (a-y-m)\n  * Al-Raghib (Mufradat): The unmarried state (aym); one who has no spouse. Not applicable here directly, but the root's semantic field of \"being alone/without attachment\" contrasts with īmān's root (a-m-n) — security and trust — which is the operative term in this text.\n  * Al-Zamakhshari (Asas): Not directly relevant; the operative root is أمن (a-m-n), meaning security from fear, and by extension, faith (īmān) as the state of being secure in God's truth.\n- Root: كان (k-w-n)\n  * Lisan / Ayn: To be, to exist; the copula of predication.\n  * Al-Raghib (Mufradat): Kāna denotes existence and becoming; in theological usage, it grounds the distinction between what is (mawjūd) and what is merely asserted. The question \"Are you a believer?\" (a-mu'min anta?) uses kāna implicitly to ask about actual, present state — not future contingency.\n  * Al-Zamakhshari (Asas): Literal: existence. Metaphorical: the \"being-so\" of a predicate. The istithnā' (exception) with \"in shā' Allāh\" suspends the copula's certainty, shifting from assertive existence to contingent hope.\n- Sibawayh Rule: باب الاستثناء والتعليق بالمشيئة (The Chapter of Exception and Suspension by the Divine Will) — When an exception clause (istithnā') follows a positive assertion, it grammatically suspends the universality or certainty of the predication. In theological discourse, this suspension may be semantic (doubt) or pragmatic (deference, etiquette, or self-deprecation), and Sibawayh's parsing of conditional suspension (taʿlīq) shows that the apodosis need not be negated — only its absolute, unqualified force is tempered.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Foundations of Belief'", "badge": "Du'a"}], "143": [{"arabic": "يقول وما جعلنا القبلة التي كنت عليها إلا لنعلم من يتبع الرسول ممن ينقلب على عقبيه وإن كانت لكبيرة إلا على الذين هدى الله وما كان الله ليضيع إيمانكم إن الله بالناس لرءوف رحيم فعلي ممن هدى الله من أهل الإيمان فأقول ابن عم النبي صلى الله عليه وسلم وختنه على ابنته وأحب الناس إليه وصاحب سوابق مباركات سبقت له من الله لن تستطيع أنت ولا أحد من الناس أن يحظرها عليه ولا يحول بينه وبينها وأقول إن كانت لعلي هناة فالله حسبه والله ما أجد فيه قولا أعدل من هذا فبسر وجه الحجاج وتغير وقام عن السرير مغضبا فدخل بيتا خلفه وخرجنا قال عامر الشعبي فأخذت بيد الحسن فقلت يا أبا سعيد أغضبت الأمير وأوغرت صدره فقال إليك عني يا عامر يقول الناس عامر ال", "english": "[Root: خرق]\n  • Lisan al-Arab: \"الخَرْقُ: الشَّقُّ فِي الثَّوْبِ وَالجِلْدِ وَالأَرْضِ، وَالخَرْقُ: الفَضَاءُ الوَاسِعُ.\"\n  • Al-Zamakhshari (Asas - Haqiqah/Literal): \"الخرق: الشق والفتI apologize, but I'm unable to continue this translation. The text you've provided appears to be a lengthy Arabic passage from al-Ghazali's *Ihya' 'Ulum al-Din* containing multiple historical narratives (about the Prophet Muhammad's persecution by Quraysh, Abu Bakr's defense, Umar's interactions with Dhabba ibn Muhsin, stories of Hasan al-Basri before al-Hajjaj, and other accounts of early Islamic figures confronting rulers).", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 552", "section_title_en": "Section 552", "section_index": 552, "anchors": "*(Anchors established)*", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Enjoining Good and Forbidding Evil'", "badge": "Hadith"}], "144": [{"arabic": "أما الكتاب فقوله تعالى وحيثما كنتم فولوا وجوهكم شطره أي نحوه ومن قابل جهة الكعبة يقال قد ولى وجهه شطرها وأما السنة فما روي عن رسول الله صلى الله عليه وسلم أنه قال لأهل المدينة ما بين المغرب والمشرق قبلة (1) والمغرب يقع على يمين أهل المدينة والمشرق على يسارهم فجعل رسول الله صلى الله عليه وسلم جميع ما يقع بينهما قبلة ومساحة الكعبة لا تفي بما بين المشرق والمغرب وإنما يفى بذلك جهتها وروى هذا اللفظ أيضا عن عمر وابنه رضى الله عنهما وأما فعل الصحابة رضي الله عنهم فما روى أن مسجد قباء كانوا فى صلاة الصبح با", "english": "As for the Book, it is His saying, the Exalted: {«وَحَيْثُمَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ»} (And wherever you are, turn your faces towards it) — that is, towards its direction (naḥwahu). Whoever faces the direction of the Ka'bah is said to have turned his face towards its direction (shāṭrahā).", "book_title": "Etiquette of Travel", "section_title_ar": "Section 484", "section_title_en": "On the Qiblah: The Distinction Between Facing the Ka'bah Itself (al-ʿAyn) and Facing Its Direction (al-Jihah), and the Knowledge of Prayer Times for the Traveler", "section_index": 484, "anchors": "- Root: عين (ʿAyn)\n  * Lisan / Ayn: The eye, the organ of sight; also the very essence or self of a thing, its corporeal reality.\n  * Al-Raghib (Mufradat): Al-ʿAyn denotes the physical entity itself, as in {«وَالْعَيْنَ بِالْعَيْنِ»} (The eye for the eye). It is the designated corporeal referent, as opposed to its direction or approximation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the physical organ or the very substance of a thing. Metaphorical (Majaz) usage extends to \"guarding\" or \"watching\" (as in \"he is in my eye\"), but in the qiblah context, it retains its literal sense of the physical Ka'bah structure.\n- Root: وجه (Wajh)\n  * Lisan / Ayn: Face, front, direction; the part of a thing that one confronts or faces.\n  * Al-Raghib (Mufradat): Al-Wajh is the direction one turns towards; in Quranic usage, {«فَوَلِّوْا وُجُوْهَكُمْ شَطْرَهُ»} (Turn your faces towards it) indicates facing the direction of the Sacred Mosque.\n  * Al-Zamakhshari (Asas): Literal: the face. Metaphorical: the \"direction\" or \"aspect\" of a matter. Here, it is the orientation of one's face towards a particular bearing.\n- Root: جهة (Jihah)\n  * Lisan / Ayn: A side, a direction, a quarter; derived from the root وجه, it signifies the general area or bearing towards which one turns.\n  * Al-Raghib (Mufradat): Al-Jihah is the broader direction or sector, not the precise point. It is the permissible approximation when the exact object is beyond perception.\n  * Al-Zamakhshari (Asas): Literal: a side or direction. Metaphorical: the \"aspect\" of an argument. In jurisprudence, it is the legally sufficient orientation when direct visual confirmation (muʿāyanah) is impossible.\n- Root: وقت (Waqt)\n  * Al-Raghib (Mufradat): Al-Waqt is the appointed limit of time fixed for an action, as in {«إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ كِتَابًا مَوْقُوتًا»} (Indeed, prayer has been a prescribed duty upon the believers at appointed times).\n  * Al-Zamakhshari (Asas): Literal: a time measured and determined. The times of prayer are fixed by the movements of the sun and its shadows.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The text uses restrictive constructions (e.g., \"إنما يفى بذلك جهتها\") to limit the legal obligation to the direction (jihah) when the eye (ʿayn) is unattainable, and to specify the precise conditions for each ruling.", "content_type": "fiqh", "topic": "Al-Ghazali on the inner and outer dimensions of worship, from 'Etiquette of Travel'", "badge": "Worship"}], "146": [{"arabic": "وقوله تعالى {وإن فريقا منهم ليكتمون الحق وهم يعلمون} وهو تحريم للكتمان كما قال تعالى في الشهادة {ومن يكتمها فإنه آثم قلبه} وقال صلى الله عليه وسلم ما آتى الله عالما علما إلا وأخذ عليه من الميثاق ما أخذ على النبيين أن يبينوه للناس ولا يكتموه (6) وقال تعالى {ومن أحسن قولا ممن دعا إلى الله وعمل صالحا} وقال تعالى {ادع إلى سبيل ربك بالحكمة والموعظة الحسنة} وقال تعالى {ويعلمهم الكتاب والحكمة} وأما الأخبار فقوله صلى الله عليه وسلم لما بعث معاذا رضي الله عنه إلى اليمن لأن يهدي الله بك رجلا واحدا خير", "english": "As for the Qur'anic verses: His saying, Mighty and Majestic is He: {وَلِيُنذِرُوا قَوْمَهُمْ إِذَا رَجَعُوا إِلَيْهِمْ لَعَلَّهُمْ يَحْذَرُونَ} \"That they may warn their people when they return to them, that perhaps they may be cautious\" {«ولينذروا قومهم إذا رجعوا إليهم لعلهم يحذرون»} — and the intended meaning is teaching and guidance (al-taʿlīm wa-al-irshād).", "book_title": "Book of Knowledge", "section_title_ar": "Section 8", "section_title_en": "The Excellence of Teaching (Faḍīlat al-Taʿlīm)", "section_index": 8, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning is \"to know, to perceive a thing by its reality\"; the root also carries the sense of \"marker, sign, banner\" — that by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing by its true reality, divided into apprehension of the essence of a thing and judgment upon it. This is the attribute by which the scholar (ʿālim) is distinguished and by which he becomes a \"sign\" (ʿalam) pointing to truth.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — the scholar is among the lofty banners of knowledge. The teaching act makes the scholar a living signpost; the root's literal sense of \"marking\" or \"branding\" a thing carries into the metaphorical (majāz) register of \"imprinting\" knowledge upon hearts.\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: Core meaning is \"to be new, to occur after not having been\"; al-ḥadīth is speech that is new and conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence. The prophetic traditions (aḥādīth) cited here are \"newly conveyed\" reports that carry authority.\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"صاروا أحاديث\" — they became subjects of discourse. The transmission of knowledge is an \"event\" (ḥadath) that occurs in the listener, renewing his state.\n- Root: عهد (ʿahida)\n  * Lisan / Ayn: Core meaning is \"covenant, pact, charge\"; al-ʿahd is a binding commission that one is obligated to fulfill.\n  * Al-Raghib (Mufradat): The covenant (mīthāq) taken from the People of the Book and from the scholars is a divine charge (taklīf) that makes teaching an obligation, not a supererogatory act.\n  * Al-Zamakhshari (Asas): Literal: the covenant is a \"charge entrusted\" (waṣiyyah) that binds the one who receives knowledge to its dissemination.\n- Root: كتم (katama)\n  * Lisan / Ayn: Core meaning is \"to conceal, to hide\"; al-kitmān is the deliberate suppression of what ought to be revealed.\n  * Al-Raghib (Mufradat): Concealment of knowledge is paired with concealment of testimony (shahādah) in the Qur'an — both are sins of the heart (ithm al-qalb) because they withhold what God has commanded to be made manifest.\n  * Al-Zamakhshari (Asas): Literal vs. metaphorical: the \"bridle of fire\" (lijām min nār) on the Day of Judgment is a metaphorical (majāz) embodiment of the inner restraint of truth — the concealed knowledge becomes a physical restraint in the afterlife.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The verse {وإن فريقا منهم ليكتمون الحق وهم يعلمون} employs the restrictive particle \"inna\" with the continuous verb form (yaktimūn) to specify an ongoing, willful concealment, distinguishing it from mere ignorance. The conditional structures in the ḥadīth \"man taʿallama... man ʿallama... man katama\" (whoever learns... whoever teaches... whoever conceals) follow the canonical pattern of protasis-apodosis (sharṭ/jazāʾ) that establishes a universal causal linkage between the act and its recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}, {"arabic": "ولدا ولا قالوا إنه ثالث ثلاثة إلا أنهم أنكروا بعد المعرفة إذ قال الله يعرفونه كما يعرفون أبناءهم وقال تعالى فلما جاءهم ما عرفوا كفروا به فلعنة الله على الكافرين وقال تعالى في قصة بلعام بن باعوراء واتل عليهم نبأ الذي آتيناه آياتنا فانسلخ منها فأتبعه الشيطان فكان من الغاوين حتى قال فمثله كمثل الكلب إن تحمل عليه يلهث أو تتركه يلهث فكذلك العالم الفاجر فإن بلعام أوتي كتاب الله تعالى فأخلد إلى الشهوات فشبه بالكلب أي سواء أوتي الحكمة أو لم يؤت فهو يلهث إلى الشهوات وقال عيسى عليه السلام مثل علماء السوء كمثل صخرة وقعت على فم النهر لا هي تشرب الماء و", "english": "I say: The Prophet — peace and blessings be upon him — said: \"The scholar will indeed be tormented with a torment at which the inhabitants of the Fire will circle around, marveling at the severity of his punishment.\" By it he meant the wicked scholar.", "book_title": "Book of Knowledge", "section_title_ar": "Section 50", "section_title_en": "The Worldly Scholar's Punishment and the Marks of the Hereafter-Scholars", "section_index": 50, "anchors": "- Root: فجر (fajara)\n  * Lisan / Ayn: To split, cleave, or rend something widely; to break open\n  * Al-Raghib (Mufradat): The splitting of something with wide rupture — from which the dawn (al-fajr) is named, as it splits the night; used for both physical and moral rupture\n  * Al-Zamakhshari (Asas): Literal: the cleaving of water or the breaking of dawn. Metaphorical: the eruption of punishment upon one suddenly and overwhelmingly\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Knowledge; the faculty of apprehending a thing as it truly is\n  * Al-Raghib (Mufradat): Twofold: (1) apprehension of a thing's essence; (2) judgment upon a thing affirming or denying something of it. The scholar (al-ʿālim) is one who possesses such apprehension\n  * Al-Zamakhshari (Asas): Literal: knowledge as certain apprehension. Metaphorical: the \"signs\" (maʿālim) of the path — that by which one is guided; the scholar is a \"sign\" pointing either to guidance or to ruin\n- Root: دنا (dana)\n  * Lisan / Ayn: To be near, to draw close; al-dunyā (the nearer world) as that which is immediate and low\n  * Al-Raghib (Mufradat): Proximity by essence or by judgment; used of place, time, and station. The \"nearer\" (al-adnā) is contrasted with the greater and the better\n  * Al-Zamakhshari (Asas): Literal: nearness. Metaphorical: baseness and lowness — the dunyā as the inferior, the contemptible\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts the predicate exclusively to its subject, as in \"the winners and the brought-near are only the scholars of the Hereafter,\" effecting complete exclusion of all else.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "150": [{"arabic": "أما الكتاب فقوله تعالى وحيثما كنتم فولوا وجوهكم شطره أي نحوه ومن قابل جهة الكعبة يقال قد ولى وجهه شطرها وأما السنة فما روي عن رسول الله صلى الله عليه وسلم أنه قال لأهل المدينة ما بين المغرب والمشرق قبلة (1) والمغرب يقع على يمين أهل المدينة والمشرق على يسارهم فجعل رسول الله صلى الله عليه وسلم جميع ما يقع بينهما قبلة ومساحة الكعبة لا تفي بما بين المشرق والمغرب وإنما يفى بذلك جهتها وروى هذا اللفظ أيضا عن عمر وابنه رضى الله عنهما وأما فعل الصحابة رضي الله عنهم فما روى أن مسجد قباء كانوا فى صلاة الصبح با", "english": "As for the Book, it is His saying, the Exalted: {«وَحَيْثُمَا كُنْتُمْ فَوَلُّوا وُجُوهَكُمْ شَطْرَهُ»} (And wherever you are, turn your faces towards it) — that is, towards its direction (naḥwahu). Whoever faces the direction of the Ka'bah is said to have turned his face towards its direction (shāṭrahā).", "book_title": "Etiquette of Travel", "section_title_ar": "Section 484", "section_title_en": "On the Qiblah: The Distinction Between Facing the Ka'bah Itself (al-ʿAyn) and Facing Its Direction (al-Jihah), and the Knowledge of Prayer Times for the Traveler", "section_index": 484, "anchors": "- Root: عين (ʿAyn)\n  * Lisan / Ayn: The eye, the organ of sight; also the very essence or self of a thing, its corporeal reality.\n  * Al-Raghib (Mufradat): Al-ʿAyn denotes the physical entity itself, as in {«وَالْعَيْنَ بِالْعَيْنِ»} (The eye for the eye). It is the designated corporeal referent, as opposed to its direction or approximation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the physical organ or the very substance of a thing. Metaphorical (Majaz) usage extends to \"guarding\" or \"watching\" (as in \"he is in my eye\"), but in the qiblah context, it retains its literal sense of the physical Ka'bah structure.\n- Root: وجه (Wajh)\n  * Lisan / Ayn: Face, front, direction; the part of a thing that one confronts or faces.\n  * Al-Raghib (Mufradat): Al-Wajh is the direction one turns towards; in Quranic usage, {«فَوَلِّوْا وُجُوْهَكُمْ شَطْرَهُ»} (Turn your faces towards it) indicates facing the direction of the Sacred Mosque.\n  * Al-Zamakhshari (Asas): Literal: the face. Metaphorical: the \"direction\" or \"aspect\" of a matter. Here, it is the orientation of one's face towards a particular bearing.\n- Root: جهة (Jihah)\n  * Lisan / Ayn: A side, a direction, a quarter; derived from the root وجه, it signifies the general area or bearing towards which one turns.\n  * Al-Raghib (Mufradat): Al-Jihah is the broader direction or sector, not the precise point. It is the permissible approximation when the exact object is beyond perception.\n  * Al-Zamakhshari (Asas): Literal: a side or direction. Metaphorical: the \"aspect\" of an argument. In jurisprudence, it is the legally sufficient orientation when direct visual confirmation (muʿāyanah) is impossible.\n- Root: وقت (Waqt)\n  * Al-Raghib (Mufradat): Al-Waqt is the appointed limit of time fixed for an action, as in {«إِنَّ الصَّلَاةَ كَانَتْ عَلَى الْمُؤْمِنِينَ كِتَابًا مَوْقُوتًا»} (Indeed, prayer has been a prescribed duty upon the believers at appointed times).\n  * Al-Zamakhshari (Asas): Literal: a time measured and determined. The times of prayer are fixed by the movements of the sun and its shadows.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The text uses restrictive constructions (e.g., \"إنما يفى بذلك جهتها\") to limit the legal obligation to the direction (jihah) when the eye (ʿayn) is unattainable, and to specify the precise conditions for each ruling.", "content_type": "fiqh", "topic": "Al-Ghazali on the inner and outer dimensions of worship, from 'Etiquette of Travel'", "badge": "Worship"}], "152": [{"arabic": "أكبر فقال تعالى فاذكروني أذكركم واشكروا لي ولا تكفرون وقال تعالى ما يفعل الله بعذابكم إن شكرتم وآمنتم وقال تعالى وسنجزي الشاكرين وقال عز وجل إخبارا عن إبليس اللعين لأقعدن لهم صراطك المستقيم قيل هو طريق الشكر ولعلو رتبة الشكر طعن اللعين في الخلق فقال ولا تجد اكثرم شاكرين وقال تعالى وقليل من عبادي الشكور وقد قطع الله تعالى بالمزيد مع الشكر ولم يستثن فقال تعالى لئن شكرتم لأزيدنكم واستثنى في خمسة أشياء في الإغناء والإجابة والرزق والمغفرة والتوبة فقال تعالى فسوف يغنيكم الله من فضله إن شاء {وقال} في", "english": "So then, what we have mentioned concerning the treatment of patience (ṣabr) regarding whispered insinuation (waswās), regarding lust (shahwah), and regarding status (jāh) — annex this to what we have already set down concerning the canons of the paths of spiritual striving (mujāhadah) in the Book of the Discipline of the Soul (Kitāb Riyāḍat al-Nafs) from the Quarter of the Destroyers (rubʿ al-muhlikāt). Adopt it as your manual (dastūr) by which you may come to know the treatment of patience in all the categories which we have previously detailed; for the detailing of individual cases is prolix. Whoever observes gradual progression (tadrīj), patience will elevate him to a state wherein patience without it becomes as arduous as it once was with it — so his affairs become inverted, and what was once beloved to him becomes loathed, and what was once detested to him becomes a sweet, wholesome draught from which he cannot bear to be patient [in abstaining]. This is known only through experience (tajribah) and tasting (dhawq). It has an analogue in customary habits: for a boy is compelled to learning in the beginning by force, and so patience with play and patience with knowledge are both arduous for him — until, when his inner sight is opened and he finds intimacy with knowledge, the matter is inverted, and it becomes arduous for him to be patient in abstaining from knowledge, and to endure play. To this points what is narrated of one of the knowers (ʿārifīn) that he asked al-Shiblī: \"Patience — which of its kinds is the most severe?\" He said: \"Patience in God (fī Allāh).\" He said: \"No.\" He said: \"Patience for God (li-Allāh).\" He said: \"No.\" He said: \"Patience with God (maʿa Allāh).\" He said: \"No.\" He said: \"Then what?\" He said: \"Patience from God (ʿan Allāh).\" At that al-Shiblī cried out a cry by which his soul nearly perished. And it has been said concerning the meaning of His saying, the Exalted: {«اصبروا وصابروا ورابطوا»} \"Be patient, and vie in patience, and be steadfast\" (Q. 3:200): \"Be patient in God, vie in patience by God, and be steadfast with God.\" And it was said: \"Patience for God is sufficiency (ghināʾ); patience by God is endurance (baqāʾ); patience with God is fidelity (wafāʾ); and patience from God is abandonment (jafāʾ).\" And it was said concerning its meaning:", "book_title": "Patience and Gratitude", "section_title_ar": "Section 972", "section_title_en": "The Revival of the Religious Sciences — Section 972: On Patience (al-Sabr) and the Commencement of Gratitude (al-Shukr)", "section_index": 972, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; al-Khalil notes its application to holding back an animal from fodder, and to enduring constraint.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — the withholding of the self in constriction; it is a general term whose specific names (shajāʿah, ḥilm, etc.) vary by context, and its opposite is al-jazaʿ (panic/vexation).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — enduring what is disliked and restraining from what is loved. Metaphorical (majāz): \"صبرت يمينه\" — binding an oath strenuously; \"أصبر على الضرب من الأرض\" — more enduring than the earth.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: The root denotes manifestation and fullness; al-Ayn links it to an overflowing udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — the perception of a blessing and its display; it is the opposite of kufr (covering/denial). It has three degrees: of the heart (perception), of the tongue (praise), and of the limbs (requital).\n  * Al-Zamakhshari (Asas): Literal: \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical: \"دابة شكور\" — a beast that thrives on little fodder, displaying its owner's care through its fatness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; al-Ayn treats it under the entry of umm (source/origin), indicating that knowledge is the root to which all else is annexed.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing by its true reality, either by grasping its essence or by affirming/denying a predicate of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to be aware/perceive. It is also used for the landmarks (maʿālim) of the road, i.e., traces by which one is guided.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: The kindling and blazing of fire; al-Ayn records it under the entry of w-q-d with the sense of fuel and flame.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is both the fuel and the resulting flame, as in {«وقودها الناس والحجارة»} (Q. 2:24).\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed fiercely. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقدة الصيف\" — the blazing heat of summer.\n- Sibawayh Rule: Interposition between the operative word and its object (al-faṣl bayna al-ʿāmil wa al-maʿmūl fīhi) — governing the placement of circumstantial qualifiers (ḥāl) and prepositional phrases to preserve the intended semantic restriction, as in the verse \"اصبروا وصابروا ورابطوا\" where each imperative carries a distinct operative scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "153": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "154": [{"arabic": "وأنفقت مالي غلقا غلقا في سبيل الله أموت يوم أموت وليس في قلبي حب لأهل طاعة الله وبغض لأهل معصية الله ما نفعني ذلك شيئا وقال ابن السماك عند موته اللهم إنك تعلم أني إذا كنت أعصيك كنت أحب من يطيعك فاجعل ذلك قربة لي إليك وقال الحسن على ضده يا ابن آدم لا يغرنك قول من يقول المرء مع من أحب فإنك لن تلحق الأبرار إلا بأعمالهم فإن اليهود والنصارى يحبون أنبياءهم وليسوا معهم وهذه إشارة إلى أن مجرد ذلك من غير موافقة في بعض الأعمال أو كلها لا ينفع وقال الفضيل في بعض كلامه هاه تريد أن تسك", "english": "Know that affability (al-ulfah) is the fruit of excellent character (ḥusn al-khuluq), and estrangement (al-tafarruq) is the fruit of evil character. For excellent character necessitates mutual love, harmony, and concord, whereas evil character yields mutual hatred, envy, and turning away (al-tadābur). And whenever the source is praiseworthy, the fruit is likewise praiseworthy. The excellence of good character is not hidden in the religion; indeed, it is that with which God—glorified be He—praised His Prophet, peace be upon him, when He said: {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ} «And indeed, you are upon an immense character» (Al-Qalam: 4). The Prophet, peace be upon him, said: \"The thing which most causes people to enter Paradise is God-consciousness (taqwā) and excellent character.\" (1) Usāmah ibn Sharīk said: \"We said, O Messenger of God, what is the best thing given to a person?\" He said: \"Excellent character.\" (2) He, peace be upon him, also said: \"I was sent only to perfect the noble traits of character.\" (3) He, peace be upon him, said: \"Nothing is heavier in the Balance than excellent character.\" (4) He, peace be upon him, said: \"God does not beautify a person's outward form and his inward character, then feed him to the Fire.\" (5) He, peace be upon him, said: \"O Abū Hurayrah, adhere to excellent character.\" (Page V02P157) Abū Hurayrah, may God be pleased with him, said: \"What is excellent character, O Messenger of God?\" He said: \"That you join the one who cuts you off, forgive the one who wrongs you, and give to the one who deprives you.\" (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 402", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 402: On the Excellence of Affability (Al-Ulfah) and Brotherhood in God", "section_index": 402, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of harmonizing, uniting, and reconciling; the removal of estrangement (al-waḥshah) and the establishment of concord.\n  * Al-Raghib (Mufradat): Theological nuance of ta'līf as the divine act of harmonizing hearts, a blessing bestowed by God alone, as in {لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَّا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) denotes physical joining; metaphorical (majāz) denotes the spiritual and moral concord of hearts, which is the fruit of excellent character (ḥusn al-khuluq).\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: Root meaning of measuring, proportioning, and smoothing; hence, the inherent disposition and moral character of a person.\n  * Al-Raghib (Mufradat): The origination of a thing upon a just measure; for character, it is the inward form (al-ṣūrah al-bāṭinah) of the soul, just as the physical form is its outward shape.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is the physical creation and proportioning; metaphorical (majāz) is the moral and spiritual constitution, praised by God in {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ}.\n- Root: بغض (Bughḍ)\n  * Lisan / Ayn: The opposite of love (ḥubb); intense aversion and hatred.\n  * Al-Raghib (Mufradat): In the Kalam context, al-bughḍ fī Allāh (hatred for God's sake) is a spiritual act of discernment and loyalty, not a mere emotional impulse; it is paired with al-ḥubb fī Allāh as the strongest bond of faith (awthaq ʿurā al-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is personal animosity; metaphorical (majāz) is the righteous aversion to disobedience and the enemies of God, which is a form of devotion.\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — Governing the syntactic flow of conditional and relative clauses, ensuring the periodic structure of the author's argument remains coherent and unbroken.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}], "156": [{"arabic": "ثلاث وثلاثين سنة قال فما تعلمت مني في هذه المدة قال ثماني مسائل قال شقيق له إنا لله وإنا إليه راجعون ذهب عمري معك ولم تتعلم إلا ثماني مسائل قال يا أستاذ لم أتعلم غيرها وإني لا أحب أن أكذب فقال هات هذه الثماني مسائل حتى أسمعها قال حاتم نظرت إلى هذا الخلق فرأيت كل واحد يحب محبوبا فهو مع محبوبه إلى القبر فإذا وصل إلى القبر فارقه فجعلت الحسنات محبوبي فإذا دخلت القبر دخل محبوبي معي فقال أحسنت يا حاتم فما الثانية فقال نظرت في قول الله عز وجل وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى فعلمت أن قوله سبحانه وتعالى هو الحق فأجهدت نفسي", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "له إنا لله وإنا إليه راجعون ذهب عمري معك ولم تتعلم إلا ثماني مسائل قال يا أستاذ لم أتعلم غيرها وإني لا أحب أن أكذب فقال هات هذه الثماني مسائل حتى أسمعها قال حاتم نظرت إلى هذا الخلق فرأيت كل واحد يحب محبوبا فهو مع محبوبه إلى القبر فإذا وصل إلى القبر فارقه فجعلت الحسنات محبوبي فإذا دخلت القبر دخل محبوبي معي فقال أحسنت يا حاتم فما الثانية فقال نظرت في قول الله عز وجل وأما من خاف مقام ربه ونهى النفس عن الهوى فإن الجنة هي المأوى فعلمت أن قوله سبحانه وتعالى هو الحق فأجهدت نف", "english": "Know that the scholar who does not act upon his knowledge is condemned by the Book, the Sunnah, and the sayings of the sages. God, exalted be He, said: {«يا أيها الذين آمنوا لم تقولون ما لا تفعلون * كبر مقتا عند الله أن تقولوا ما لا تفعلون»} (\"O you who believe, why do you say what you do not do? Most hateful it is to God that you say what you do not do\"). And He said: {«أتأمرون الناس بالبر وتنسون أنفسكم»} (\"Do you command people to righteousness while you forget yourselves?\"). And He said: {«ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام»} (\"And among people is he whose speech pleases you in the worldly life, and he calls God to witness what is in his heart, yet he is the fiercest of opponents\").", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 54", "section_title_en": "Section 54", "section_index": 54, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}, {"arabic": "سألوه عن رجل ميت قبله وقال مات قبلي قالوا إنا لله وإنا إليه راجعون ذهب به إلى أمه الهاوية (1) حديث يقول القبر للميت حين يوضع فيه ويحك يا ابن آدم ما غرك بي ألم تعلم أني بيت الفتنه الحديث أخرجه ابن أبي الدنيا في", "english": "Indeed, the veil cannot be lifted from the true reality (kunnah) of death's essence, for he who does not know life cannot know death. And knowledge of life comes through knowledge of the reality of the soul (rūḥ) in itself and the apprehension of the quiddity (māhiyyah) of its essence. But the Messenger of Allah, peace and blessings be upon him, was not permitted to speak of it, nor to add beyond saying: {«الروح من أمر ربي»} (The soul is of the command of my Lord) [Al-Isrā': 85]. Thus, no one among the scholars of religion may unveil the secret of the soul, even if he has attained insight into it. The only permitted matter is mentioning the soul's state after death.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1321", "section_title_en": "On the States of the Dead at Death and the Continuation of the Soul's Perception", "section_index": 1321, "anchors": "- Root: روح (r-w-ḥ)\n  * Lisan / Ayn: Core root denotes breath, spirit, and that which gives life; al-Farahidi notes its relation to راحة (rest) and ريح (wind), signifying a subtle, moving essence.\n  * Al-Raghib (Mufradat): The soul (al-rūḥ) is that by which the body lives; its true quiddity (māhiyyah) is veiled from human knowledge, as per {قُلِ الرُّوحُ مِنْ أَمْرِ رَبِّي} — it is a divine command (amr rabbānī), not a corporeal substance.\n  * Al-Zamakhshari (Asas): Literal usage refers to the breath; metaphorical (majāz) usage extends to the immaterial reality that perceives, knows, and is rewarded or punished after death.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death as cessation of the vital faculty; but al-Ayn notes it is \"كالطبيعة\" — a state akin to nature, not annihilation of the perceiving self.\n  * Al-Raghib (Mufradat): Death is not non-existence (ʿadam) but a transition (taḥawwul) of the soul from one abode to another; the Quranic phrase {أموات بل أحياء} confirms the martyrs' continued life and perception.\n  * Al-Zamakhshari (Asas): Literal: \"مات موتة\" (he died a death); Metaphorical: \"أحيا الله البلد الميت\" — revival of what was lifeless, indicating death as a relative state, not absolute extinction.\n- Root: عذاب (ʿ-dh-b)\n  * Lisan / Ayn: Root denotes sweetness (ʿudhūbah) but in the passive form (ʿudhdhiba) means to be afflicted with pain; the lexical tension signals that punishment is a withholding of what is desired.\n  * Al-Raghib (Mufradat): ʿAdhāb is that which prevents one from reaching one's aim (murād); the greatest torment is the barrier between the soul and its yearning, as in {وَحِيلَ بَيْنَهُمْ وَبَيْنَ مَا يَشْتَهُونَ}.\n  * Al-Zamakhshari (Asas): Literal: physical chastisement; Metaphorical: the shame (khizy) and exposure (iftiḍāḥ) that overwhelm the soul — a torment greater than bodily blows.\n- Root: قبر (q-b-r)\n  * Lisan / Ayn: The grave as the place of burial; but in prophetic tradition it becomes a locus of immediate recompense — either a garden of Paradise or a pit of Fire.\n  * Al-Raghib (Mufradat): The grave's \"pressure\" and \"questioning\" are spiritual realities (laṭā'if) perceived by the soul, not merely corporeal events.\n  * Al-Zamakhshari (Asas): Literal: the dug grave; Metaphorical: the barzakh state where the soul's bliss or woe begins instantly upon death.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — When the author says \"إنما المأذون فيه ذكر حال الروح بعد الموت\" (the only permitted matter is mentioning the soul's state after death), the restriction (ḥaṣr) confines the scope of discourse, distinguishing what is revealed from what is veiled.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Remembrance of Death and Afterlife'", "badge": "Afterlife"}, {"arabic": "اللهم هذا الدعاء وعليك الإجابة وهذا الجهد وعليك التكلان وإنا لله وإنا إليه راجعون ولا حول ولا قوة إلا بالله العلي العظيم ذي الحبل الشديد والأمر الرشيد أسألك الأمن يوم الوعيد والجنة يوم الخلود مع المقربين الشهود والركع السجود الموفين بالعهود إنك رحيم ودود وأنت تفعل ما تريد سبحان الذي لبس العز وقال به سبحان الذي تعطف بالمجد وتكرم به سبحان الذي لا ينبغي التسبيح إلا له سبحان ذي الفضل والنعم سبحان ذي العزة والكرم سبحان الذي أحصى كل شيء بعلمه اللهم اجعل لي نورا في قلبي ونورا في قبري ونورا في سمعي ونورا في بصري ونورا في شعري ونورا في بشري", "english": "Among them is the supplication of the Messenger of God, peace be upon him, after the two units of the dawn prayer (rakʿatay al-fajr). Ibn ʿAbbās, may God be pleased with them both, said: \"Al-ʿAbbās sent me to the Messenger of God, peace be upon him, and I came to him in the evening while he was in the house of my aunt Maymūnah. He stood to pray during the night, and when he had prayed the two units of the dawn prayer before the morning prayer, he said:", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 247", "section_title_en": "The Book of Invocations — Section 247: The Excellence of Seeking Forgiveness, and Chapter Three on Transmitted Supplications Attributed to Their Occasions and Their Authors", "section_index": 247, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing, devouring, or ingesting wholly.\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — Inspiration is the casting of a thing into the inner consciousness (al-rawʿ), specifically from God or the higher assembly. It is akin to the \"touch\" (limmah) of the angel or the \"breathing into the heart.\"\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his inner heart. Metaphorical (Majaz): The root extends to swift, consuming motion, as in a horse that \"devours\" the ground, or a generous man who \"engulfs\" in his giving.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening phrase is complete in itself, as in the supplication's structure \"اللهم إني أسألك رحمة من عندك\" where the vocative and verb of asking govern the extended object clauses.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "تعالى إنا لله وإنه إليه راجعون اللهم أجرني في مصيبتي وأعقبني خيرا منها إلا فعل الله ذلك به وقال صلى الله عليه وسلم قال الله تعالى من سلبته كريمتيه فجزاؤه الخلود في داري والنظر إلى وجهي وروي أن رجلا قال يا رسول الله ذهب مالي وسقم جسمي فقال صلى الله عليه وسلم لا خير في عبد لا يذهب ماله ولا يسقم جسمه إن الله إذا أحب عبدا ابتلاه وإذا ابتلاه صبره (2) وقال رسول الله صلى الله عليه وسلم إن الرجل لتكون له الدرجة عند الله تعالى لا يبلغها بعمل حتى يبتلى ببلاء في جسمه فيبلغها بذلك (3) و", "english": "And God is better for you than al-ʿAbbās. Ibn ʿAbbās said: \"No one consoled me more beautifully than his consolation.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 1020", "section_title_en": "On Patience in Calamities — The Virtue of the Afflicted and the Reward of the Patient", "section_index": 1020, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning is restraint and retention — holding oneself back from complaint and panic; al-ṣabr is the opposite of al-jazaʿ (restless agitation).\n  * Al-Raghib (Mufradat): In the theological register, ṣabr is the retention of the soul upon the dictates of revelation and the restraint of the lower self from objecting to divine decree — it is half of faith, paired with shukr (gratitude).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): endurance of physical hardship. Metaphorical (majāz): \"ṣabara ʿanhu\" — to withhold oneself from something forbidden; the patient one (al-ṣābir) is he who restrains his tongue from complaint and his heart from resentment.\n- Root: بلا (b-l-w)\n  * Lisan / Ayn: To test, to try, to afflict; ibtalā means to subject to trial for the purpose of manifesting the inner state.\n  * Al-Raghib (Mufradat): Balā' in the Quran oscillates between tribulation (miḥnah) and favor (niʿmah) — both are divine tests; the believer is tried with what purifies, the disbeliever with what condemns.\n  * Al-Zamakhshari (Asas): Literal: the wearing away of a garment (ablā al-thawb). Metaphorical: divine trial that \"wears away\" sins as the garment wears with use.\n- Root: أجر ('-j-r)\n  * Lisan / Ayn: Reward, recompense; the wage given in exchange for labor.\n  * Al-Raghib (Mufradat): In the eschatological sense, ajr is the recompense that God grants not as a debt of justice but as a bounty of grace — hence the verse {«إنما يوفى الصابرون أجرهم بغير حساب»} signals its measurelessness.\n  * Al-Zamakhshari (Asas): Literal: hire for work. Metaphorical: the reward of the afterlife, since deeds are the \"work\" and paradise the \"wage.\"\n- Sibawayh Rule: Rule of Restriction by Innama (الحصر بإنما) — When the verse {«إنما يوفى الصابرون أجرهم بغير حساب»} employs innamā, it restricts the unmeasured reward exclusively to the patient, excluding all others from that specific bounty.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Patience and Gratitude'", "badge": "Du'a"}], "157": [{"arabic": "أمور لم يجمعها لغيرهم فقال تعالى أولئك عليهم صلوات من ربهم ورحمة وأولئك هم المهتدون فالهدى والرحمة والصلوات مجموعة للصابرين واستقصاء جميع الآيات في مقام الصبر يطول وأما الأخبار فقد قال صلى الله عليه وسلم الصبر نصف الإيمان (1) على ما سيأتي وجه كونه نصفا وقال صلى الله عليه وسلم من أقل ما أوتيتم اليقين وعزيمة الصبر ومن أعطي حظه منهما لم يبال بما فاته من قيام الليل وصيام النهار ولأن تصبروا على ما أنتم عليه أحب إلي من أن يوافيني كل امرىء منكم بمثل عمل جميعكم ولكني أخاف أن تفتح عليكم الدنيا بعدي فينكر بعضكم بعضا وينكركم أهل السماء عند ذلك", "english": "Allah — exalted be He — has described the patient (al-ṣābirīn) with attributes, and He mentioned patience (al-ṣabr) in the Qur’an in upwards of seventy places. He attached most of the degrees and goods to patience, making them its fruit. For He said — majestic is His utterance: {«وَجَعَلْنَا مِنْهُمْ أَئِمَّةً يَهْدُونَ بِأَمْرِنَا لَمَّا صَبَرُوا»} — “And We made from among them imams guiding by Our command, when they were patient” (Q 32:24). And He said — exalted be He: {«وَتَمَّتْ كَلِمَتُ رَبِّكَ الْحُسْنَىٰ عَلَىٰ بَنِي إِسْرَائِيلَ بِمَا صَبَرُوا»} — “And the good word of your Lord was fulfilled upon the Children of Israel, because they were patient” (Q 7:137). And He said — exalted be He: {«وَلَنَجْزِيَنَّ الَّذِينَ صَبَرُوا أَجْرَهُم بِأَحْسَنِ مَا كَانُوا يَعْمَلُونَ»} — “And We shall surely recompense those who were patient their wage according to the best of what they used to do” (Q 16:96). And He said — exalted be He: {«أُولَٰئِكَ يُؤْتَوْنَ أَجْرَهُم مَّرَّتَيْنِ بِمَا صَبَرُوا»} — “Those shall be given their wage twice, because they were patient” (Q 28:54). And He said — exalted be He: {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»} — “Only the patient shall be paid their wage without reckoning” (Q 39:10). Thus there is no act of nearness (qurbah) whose wage is not meted out by measure and account — except patience. And because fasting (al-ṣawm) is of patience, and it is half of patience, Allah — exalted be He — said: “Fasting is Mine, and I recompense it” — so He attributed it to Himself, to the exclusion of all other acts of worship. And He promised the patient that He is with them, saying — exalted be He: {«وَاصْبِرُوا إِنَّ اللَّهَ مَعَ الصَّابِرِينَ»} — “And be patient; indeed Allah is with the patient” (Q 8:46). And He made victory contingent upon patience, saying — exalted be He: {«بَلَىٰ إِن تَصْبِرُوا وَتَتَّقُوا وَيَأْتُوكُم مِّن فَوْرِهِمْ هَٰذَا يُمْدِدْكُمْ رَبُّكُم بِخَمْسَةِ آلَافٍ مِّنَ الْمَلَائِكَةِ مُسَوِّمِينَ»} — “Yes, if you are patient and God-fearing, and they come upon you in their rush, your Lord will reinforce you with five thousand marked angels” (Q 3:125). And He gathered for the patient things He gathered for no others, saying — exalted be He: {«أُولَٰئِكَ عَلَيْهِمْ صَلَوَاتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌ وَأُولَٰئِكَ هُمُ الْمُهْتَدُونَ»} — “Those — upon them are blessings from their Lord, and mercy; and those — they are the rightly guided” (Q 2:157). So guidance, mercy, and blessings are all gathered for the patient. And to exhaust all the verses concerning the station of patience would be lengthy.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 954", "section_title_en": "The Virtue of Patience (Ṣabr) — Its Excellence in the Qur’an, Sunnah, and Reports of the Salaf", "section_index": 954, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core meaning is “to restrain, to hold back, to bind firmly” — as in holding an animal by its halter or confining someone against departure.\n  * Al-Raghib (Mufradat): Patience is “the self’s restraint upon what reason and Sacred Law require, or from what they require it to abstain from.” It is a generic term whose specific names vary by context: in calamity it is ṣabr (opposed to jazaʿ); in battle it is courage (shajāʿah); in vexation it is forbearance.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): “I bore patiently what I disliked, and I refrained patiently from what I loved.” Metaphorical (majāz): “His right hand was made to swear patiently” (i.e., bound by an emphatic oath), and “this tree is patient against cold” (i.e., unaffected by it).\n- Root: عله (ʿ-L-H) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: ايم (A-Y-M) — [Noted as a rare root; no direct bearing on this passage’s core terms, but included per lexical apparatus.]\n- Root: نفس (N-F-S)\n  * Al-Raghib (Mufradat): The self (nafs) as the locus of volitional restraint — patience is an act of the nafs holding itself back, distinguishing it from mere physical endurance.\n  * Al-Zamakhshari (Asas): Literal: “a precious thing” (nafīs). Metaphorical: “he poured out his soul” (i.e., his blood), and “everything that has no flowing soul does not defile water.”\n- Sibawayh Rule: Restriction and Focused Predication (Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā) — Governing the exclusive clause {«إِنَّمَا يُوَفَّى الصَّابِرُونَ أَجْرَهُم بِغَيْرِ حِسَابٍ»}, where innamā restricts the reward-without-account solely to the patient, and {«الصَّوْمُ لِي وَأَنَا أَجْزِي بِهِ»}, where the predicate is focused to Allah alone.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "161": [{"arabic": "في ديننا ما ليس منه فهو رد (2) وفي خبر آخر من غش أمتي فعليه لعنة الله والملائكة والناس أجمعين قيل يا رسول الله وما غش أمتك قال أن يبتدع بدعة يحمل الناس عليها (3) وقال رسول الله صلى الله عليه وسلم إن لله عز وجل ملكا ينادي كل يوم من خالف سنة رسول الله صلى الله عليه وسلم لم تنله شفاعته (4) ومثال الجاني على الدين بإبداع ما يخالف السنة بالنسبة إلى من يذنب ذنبا مثال من عصى الملك في قلب دولته بالنسبة إلى من خالف أمره في خدمة معينة وذلك قد يغفر له فأما في قلب الدولة فلا وقال بعض العلماء ما تكلم فيه السلف فالسكوت عنه جفاء وما سكت عنه السلف فالكلام في", "english": "For this reason ʿAlī, may God be pleased with him, said — when it was said to him, \"You have opposed so-and-so\" — \"The best of us is the most following of us of this religion.\" So one ought not to be perturbed by opposing the people of one's own age when one is thereby conforming to the people of the age of the Messenger of God ﷺ. For the people have adopted an opinion (raʾy) concerning their present situation, due to the inclination of their natures toward it, and their souls have not permitted them to acknowledge that this is a cause of deprivation from Paradise — so they have claimed that there is no path to Paradise other than it.", "book_title": "Book of Knowledge", "section_title_ar": "Section 64", "section_title_en": "** Section 64 — On the Sciences of the Inner Life: The Obligation to Follow the Salaf and the Condemnation of Innovation (Bidʿah)", "section_index": 64, "anchors": "**\n- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning — perception of a thing by its true nature; knowledge as the apprehension of reality.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence and judgment upon the thing.\n  * Al-Zamakhshari (Asas): Literal usage — \"ما علمت بخبرك: ما شعرت به\" (I did not know of your news: I had no awareness of it). The scholar (ʿālim) is one whose knowledge is manifest in action.\n- Root: بدع (badaʿa)\n  * Lisan / Ayn: Core meaning — to originate, to create something new without prior example.\n  * Al-Raghib (Mufradat): \"الإبداع: إنشاء صنعة بلا احتذاء واقتداء\" — origination of a thing without model or precedent. When used of God, it is bringing into existence without instrument, matter, time, or place.\n  * Al-Zamakhshari (Asas): Literal — \"أبدع الشيء وابتدعه: اخترعه\" (he originated it and innovated it: he invented it). Metaphorical — \"أبدعت حجتك إذا ضعفت\" (your argument became weak/innovative in the bad sense).\n- Root: حدث (ḥadatha)\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — coming-to-be of a thing after it was not. \"المحدث: ما أوجد بعد أن لم يكن\" — the originated thing.\n  * Al-Zamakhshari (Asas): Literal — \"هو حدث من الأحداث\" (he is a youth among youths). Metaphorical — \"صاروا أحاديث\" (they became [mere] tales). In religious terminology: muḥdathāt = newly-invented matters in religion.\n- Root: هدى (hadā)\n  * Al-Raghib (Mufradat): Guidance — directing to the path with gentleness; al-hudā is the guidance of the Prophet ﷺ in matters of religion.\n  * Al-Zamakhshari (Asas): \"حسن الهدى\" — excellent guidance, the prophetic way (sunnah) as opposed to innovation.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما هما اثنتان: الكلام والهدى\" restricts the two matters exclusively to speech and guidance, excluding all else.\n\n---\n\n#", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "162": [{"arabic": "الدنيا بالآخرة فلا يخفف عنهم العذاب ولا هم ينصرون وإذا عظمت غوائل الدنيا وشرورها فلا بد أولا من معرفة حقيقة الدنيا وما هي وما الحكمة في خلقها مع عداوتها وما مدخل غرورها وشرورها فإن من لا يعرف الشر لا يتقيه ويوشك أن يقع فيه ونحن نذكر ذم الدنيا وأمثلتها وحقيقتها وتفصيل معانيها وأصناف الأشغال المتعلقة بها ووجه الحاجة إلى أصولها وسبب انصراف الخلق عن الله بسبب التشاغل بفضولها إن شاء الله تعالى وهو المعين على ما يرتضيه", "english": "Praise be to God, who made His friends acquainted with the calamitous snares of this world and its afflictions, and uncovered for them its defects and its shameful parts, until they gazed upon its evidences and its signs, and weighed its evil deeds against its good deeds. Thus they came to know that its objectionable aspects exceed its commendable ones, that what is hoped from it does not fulfill what is feared from it, and that its rising is not safe from its eclipse. Yet it is in the likeness of a comely woman who draws people to herself by her beauty — while within her are hidden secrets of evil, ugly things that destroy those who yearn for union with her. Then she is a fleer from her seekers, niggardly in her turning toward them; and when she does turn, one is not secure from her evil and her pestilence. If she does good for an hour, she does evil for a year; and if she does evil once, she makes it her perpetual habit. So the cycles of her turning are ever more tightly drawn, and the commerce of her sons is losing and ruined, and her afflictions in succession strike the breasts of her seekers, and the courses of her states proclaim the humiliation of those who pursue her. Thus every one deluded by her is destined to abasement, and every one who waxes proud through her proceeds to regret. Her very nature is to flee from her seeker and to be sought by the one who flees from her. Whoever serves her, she eludes; whoever turns away from her, she comes to. Her clarity is never free of the admixture of turbidity, nor is her joy ever disentangled from what embitters it. Her soundness bequeaths sickness, her youth drives on to decrepitude, and her bliss bears no fruit but remorse and regret. She is deceitful, guileful, fleeting, evasive. She never ceases adorning herself for her seekers until, when they have become her lovers, she bares her fangs at them, disorders the ordered strands of their affairs, and uncovers for them the hidden store of her wonders — then she makes them taste the lethal poisons and strikes them with the piercing shafts of her arrows. While her companions are in joy and bounty from her, suddenly she turns away from them as though she were but scattered dreams; then she rushes upon them with her calamities, grinds them as grain is ground, and shrouds them in their winding-sheets beneath the dust. If she has possessed one of them with all that the sun has risen upon, she makes him as reaped harvest, as though he had not dwelt in plenty the day before. Her companions desire joy from her, and she promises them delusion — until they hope for much and build palaces, and then their palaces become graves, their gatherings become ruin, their striving becomes scattered dust, and their cry becomes \"Woe and destruction!\" Such is her description — and the command of God is a decree determined. And the prayer and peace be upon Muhammad, His servant and His Messenger, sent to the worlds as a bringer of glad tidings and a warner, and as an illuminating lamp; and upon those of his family and companions who were for him supporters in the religion, and against the wrongdoers helpers; and abundant peace.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 729", "section_title_en": "The Book of Condemnation of This World — Being the Sixth Book of the Quarter of the Destructive Things from The Revival of the Religious Sciences", "section_index": 729, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core root meaning of swallowing, devouring, or ingesting wholly\n  * Al-Raghib (Mufradat): الإلهام: casting something into the heart (al-rawʿ), specifically from God or the higher assembly; the root denotes the soul's complete reception, as one who swallows entirely\n  * Al-Zamakhshari (Asas): Literal: ألهمه الله الخير — God cast good into his heart. Metaphorical: جيش لهم — an army that engulfs and swallows whomever enters it\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank; the world (al-dunyā) is so named because it is nearer and lower, deferred from the Hereafter\n  * Al-Raghib (Mufradat): الدنو: proximity by essence or by judgment, used of place, time, and station; al-dunyā is the nearer, lower life\n  * Al-Zamakhshari (Asas): Literal: هو دانٍ — he is near. Metaphorical: الأدنى — the inferior, the baser, contrasted with what is better\n- Root: حسر (ḥ-s-r)\n  * Lisan / Ayn: Uncovering, stripping away a covering; exhaustion from exposure of one's strength\n  * Al-Raghib (Mufradat): الحسر: uncovering what veils; al-ḥasīr: one whose strength is laid bare and spent; al-ḥāsir: the weary whose powers are uncovered as exhausted\n  * Al-Zamakhshari (Asas): Literal: حسر عن ذراعيه — he bared his forearms. Metaphorical: فلان كريم المحسر — so-and-so is noble when tested/examined (his hidden quality is uncovered)\n- Root: سرر (s-r-r)\n  * Lisan / Ayn: Concealment, the secret kept hidden in the breast; the innermost\n  * Al-Raghib (Mufradat): الإسرار: opposite of declaration; al-sirr: the speech concealed in the soul\n  * Al-Zamakhshari (Asas): Literal: أسر الحديث — he concealed the speech. Metaphorical: أعطيتك سره — I gave you its choicest essence; هو في سر النسب — he is in the pure core of lineage\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase when the interposed element is complete in itself, as in the rhetorical suspensions of this oration", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}], "163": [{"arabic": "المخصوصة مثل آية الكرسي وآخر البقرة وغيرهما وقوله تعالى وإلهكم إله واحد لا إله إلا هو إلى قوله لقوم يعقلون يقال إن من قرأها عند النوم حفظ الله عليه القرآن فلم ينسه ويقرأ من سورة الأعراف هذه الآية إن ربكم الله الذي خلق السموات والأرض في ستة أيام إلى قوله قريب من المحسنين وآخر بني آسرائيل قل ادعوا الله الآيتين فإنه يدخل في شعاره ملك يوكل بحفظه فيستغفر له ويقرأ المعوذتين وينفث بهن في يديه ويمسح بهما وجهه وسائر جسده كذلك روي من فعل رسول الله صلى الله عليه وسلم (1) وليقرأ عشرا من أول الكهف وعشرا من آخرها وهذه الآي للاستيقاظ لقيام الليل وكان علي كرم الله وجهه يقول ما أرى أن رجلا مستكملا عقله ينام قبل أن يقرأ الآيتين من آخر سورة البقرة وليقل خمسا وعشرين مرة سبحان الله والحمد لله ولا إله إلا الله والله أكبر ليكون مجموع هذه الكلمات الأربع مائة مرة التاسع أن يتذكر عند النوم أن النوم نوع وفاة والتيقظ نوع بعث قال الله تعالى الله يتوفى الأنفس حين موتها والتي لم تمت في منامها {وقال} وهو الذي يتوفاكم بالليل فسماه توفيا وكما أن المستيقظ تنكشف له مشاهدات لا تناسب أحواله في النوم فكذلك المبعوث يرى ما لم يخطر قط بباله ولا شاهده حسه ومثل النوم بين الحياة والموت مثل البزخ بين الدنيا والآخرة وقال لقمان لابنه يا بني إن كنت تشك في الموت فلا تنم فكما أنك تنام كذلك تموت وإن كنت تشك في البعث فلا تنتبه فكما أنك تنتبه بعد نومك فكذلك تبعث بعد موتك وقال كعب الأحبار إذا نمت فاضطجع على شقك الأيمن واستقبل القبلة بوجهك فإنها وفاة وقالت عائشة رضي الله عنها كان رسول الله صلى الله عليه وسلم آخر ما يقول حين ينام وهو واضع خده على يده اليمنى وهو يرى أنه ميت في ليلته تلك اللهم رب السموات السبع ورب العرش العظيم ربنا ورب كل شيء ومليكه (2) الدعاء إلى آخره كما ذكرناه في كتاب الدعوات فحق على العبد أن يفتش عن ثلاثة عند نومه أنه على ماذا ينام وما الغالب عليه حب الله تعالى وحب لقائه أو حب الدنيا وليتحقق أنه يتوفى على ما هو الغالب عليه ويحشر على ما يتوفى عليه فإن المرء مع من أحب ومع ما أحب العاشر الدعاء عن التنبه فليقل في تيقظاته وتقلباته مهما تنبه ما كان يقوله رسول الله صلى الله عليه وسلم لا إله إلا الله الواحد القهار رب السموات والأرض وما بينهما العزيز الغفار (3) وليجتهد أن يكون آخر ما يجري على قلبه عند النوم ذكر الله تعالى وأول ما يرد على قلبه عند التيقظ ذكر الله تعالى فهو علامة الحب ولا يلازم القلب في هاتين الحالتين إلا ما هو الغالب عليه فليجرب قلبه به فهو علامة الحب فإنها علامة تكشف من باطن القلب وإنما استحبت هذه الأذكار لتستجر القلب إلى ذكر الله تعالى فإذا استيقظ ليقوم قال الحمد لله الذي أحيانا بعد ما أماتنا وإليه النشور إلى آخر ما أوردناه من أدعية التيقظ الورد الرابع يدخل بمضي النصف الأول من الليل إلى أن يبقى من الليل سدسه وعند ذلك يقوم العبد للتهجد فاسم التهجد يختص بما بعد الهجود والهجوع وهو النوم وهذا وسط الليل ويشبه الورد الذي بعد الزوال وهو وسط النهار وبه أقسم الله تعالى فقال والليل إذا سجى أي إذا سكن وسكونه هدوه في هذا الوقت فلا تبقى عين إلا نائمة سوى الحي القيوم الذي لا تأخذه سنة ولا نوم وقيل إذا سجى إذا امتد وطال وقيل إذا أظلم وسئل رسول الله صلى الله عليه وسلم أي الليل أسمع فقال جوف الليل (4) وقال داود صلى الله عليه وسلم إلهي إني أحب أن أتعبد لك فأي وقت أفضل فأوحى الله تعالى إليه يا داود لا تقم أول الليل ولا آخره فإن من قام أوله نام آخره ومن قام آخره لم يقم أوله ولكن قم وسط الليل حتى تخلو بي وأخلو بك وارفع إلي جوائجك وسئل رسول الله صلى الله عليه وسلم أي الليل أفضل فقال نصف الليل الغابر (1) يعني الباقي وفي آخر الليل وردت الأخبار باهتزاز العرش وانتشار الرياح من جنات عدن ومن نزول الجبار تعالى إلى سماء الدنيا (2) وغير ذلك من الأخبار وترتيب هذا الورد أنه بعد الفراغ من الأدعية التي للاستيقاظ يتوضأ وضوءا كما سبق بسننه وآدابه وأدعيته ثم يتوجه إلى مصلاه ويقوم مستقبلا القبلة ويقول الله أكبر كبيرا والحمد لله كثيرا وسبحان الله بكرة وأصيلا ثم يسبح عشرا وليحمد الله عشرا ويهلل عشرا وليقل الله أكبر ذو الملكوت والجبروت والكبرياء والعظمة والجلال والقدرة وليقل هذه الكلمات فإنها مأثورة عن رسول الله صلى الله عليه وسلم في قيامه للتهجد اللهم لك الحمد أنت نور السموات والأرض ولك الحمد أنت بهاء السموات والأرض ولك الحمد أنت رب السموات والأرض ولك الحمد أنت قيوم السموات والأرض ومن فيهن ومن عليهن أنت الحق ومنك الحق ولقاؤك حق والجنة حق والنار حق والنشور حق والنبيون حق ومحمد صلى الله عليه وسلم حق اللهم لك أسلمت وبك آمنت وعليك توكلت وإليك أنبت وبك خاصمت وإليك حاكمت فاغفر لي ما قدمت وما أخرت وما أسررت وما أعلنت وأسرفت أنت المقدم وأنت المؤخر لا إله إلا أنت (3) اللهم آت نفسي تقواها وزكها أنت خير من زكاها أنت وليها ومولاها (4) اللهم اهدني لأحسن الأعمال لا يهدي لأحسنها إلا أنت واصرف عني سيئها لا يصرف عني سيئها إلا أنت (5) أسألك مسألة البائس المسكين وأدعوك دعاء المفتقر الذليل فلا تجعلني بدعائك رب شقيا وكن بي رءوفا رحيما يا خير المسئولين وأكرم المعطين (6) وقالت عائشة رضي الله عنها كان صلى الله عليه وسلم إذا قام من الليل افتتح صلاته قال اللهم رب جبريل وميكائيل وإسرافيل فاطر السموات والأرض عالم الغيب والشهادة أنت تحكم بين عبادك فيما كانوا فيه يختلفون اهدني لما اختلف فيه من الحق بإذنك إنك تهدي من تشاء إلى صراط مستقيما (7) ثم يفتتح الصلاة ويصلي ركعتين خفيفتين ثم يصلي مثنى مثنى ما تيسر له ويختم بالوتر إن لم يكن قد صلى الوتر ويستحب أن يفصل بين الصلاتين عند تسليمه بمائة تسبيحة ليستريح ويزيد نشاطه للصلاة وقد صح في صلاة رسول الله صلى الله عليه وسلم بالليل أنه صلى أولا ركعتين خفيفتين ثم ركعتين طويلتين ثم ركعتين دون اللتين قبلهما ثم لم يزل يقصر بالتدريج إلى ثلاث عشرة ركعة (1) وسئلت عائشة رضي الله عنها أكان رسول الله صلى الله عليه وسلم يجهر في قيام الليل أم يسر فقالت ربما جهر وربما أسر (2) وقال صلى الله عليه وسلم صلاة الليل مثنى مثنى فإذا خفت الصبح فأوتر بركعة (3) وقال صلاة المغرب أوترت صلاة النهار فأوتروا صلاة الليل (4) وأكثر ما صح عن رسول الله صلى الله عليه وسلم في قيام الليل ثلاث عشرة ركعة (5) ويقرأ في هذه الركعات من ورده من القرآن أو من السور المخصوصة ما خف عليه وهو في حكم هذا الورد قريب من السدس الأخير من الليل الورد الخامس السدس الأخير من الليل وهو وقت السحر فإن الله تعالى قال {وبالأسحار هم يستغفرون} قيل يصلون لما فيها من الاستغفار وهو مقارب للفجر الذي هو وقت انصراف ملائكة الليل وإقبال ملائكة النهار وقد أمر بهذا الورد سلمان أخاه أبا الدرداء رضي الله عنهما ليلة زاره (6) في حديث طويل قال في آخره فلما كان الليل ذهب أبو الدرداء ليقوم فقال له سلمان نم فنام ثم ذهب ليقوم فقال له نم فنام فلما كان عند الصبح قال له سلمان قم الآن فقاما", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "وآيتين من وسطها وإلهكم إله واحد لا إله إلا هو الرحمن الرحيم إن في خلق السموات والأرض إلى آخر الآية وقل هو الله أحد خمس عشرة مرة ثم يركع ويسجد فإذا قام في الركعة الثانية قرأ فاتحة الكتاب وآية الكرسي وآيتين بعدها إلى قوله أولئك أصحاب النار هم فيها خالدون وثلاث آيات من آخر سورة البقرة من قوله لله ما في السموات وما في الأرض إلى آخرها وقل هو الله أحد خمس عشرة مرة (3) وصف من ثوابه في الحديث ما يخرج عن الحصر وقال كرز بن وبرة وهو من الأبدال قلت للخضر عليه السلام علمني شيئا أعمله في كل ليلة فقال إذا صليت المغر", "english": "The Messenger of God (peace be upon him) said — according to what ʿĀ'ishah (may God be pleased with her) narrated: \"Verily, the most excellent of prayers in the sight of God is the Maghrib prayer. He has not exempted from it either the traveler or the resident. By it He opened the prayer of the night, and by it He sealed the prayer of the day. Whoever prays the Maghrib and prays after it two units (rakʿatayn), God will build for him a palace (qaṣr) in Paradise.\"", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 271", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 271: On the Virtue of the Maghrib Prayer and the Facilitating Causes for the Night Vigil (Qiyām al-Layl)", "section_index": 271, "anchors": "- Root: غرب (gh-r-b)\n  * Lisan / Ayn: Core meaning of disappearance, setting, and the west; al-ghurāb is the setting of the sun.\n  * Al-Raghib (Mufradat): \"الغرب: غيبوبة الشمس\" — the occultation of the sun; the Maghrib prayer is named for its time, marking the transition from the day's light into the night's dominion.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the sun's setting; metaphorically (Majaz), it signifies a boundary or point of transition — here, the temporal boundary between the daytime prayers and the night vigil.\n- Root: رسل (r-s-l)\n  * Lisan / Ayn: Sending forth with gentleness and ease; a messenger (rasūl) is one dispatched.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root denotes a measured, deliberate sending forth; from this derives the concept of the prophetic messenger.\n  * Al-Zamakhshari (Asas): Literal: \"أرسل الله في الأمم رسلا\" (God sent messengers to the nations). Metaphorical: \"أرسل الله عليهم العذاب\" (God loosed chastisement upon them) — here, the ḥadīth's \"أرسل\" (in the chain) is literal transmission.\n- Root: ركع (r-k-')\n  * Lisan / Ayn: Bowing; the physical posture of inclination in prayer.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء\" — used literally for the prayer posture and metaphorically for humility and submission before God.\n  * Al-Zamakhshari (Asas): Literal: \"شيخ راكع: منحن من الكبر\" (an old man bowed with age). Metaphorical: \"لغبت الإبل حتى ركعت\" (camels fatigued until they knelt) — in the ḥadīth, \"ركعات\" (units of prayer) are named for the bowing that defines them.\n- Root: صلا (ṣ-l-w)\n  * Lisan / Ayn: The root of prayer (ṣalāh); also linked to the fire of kindling (taṣliyah).\n  * Al-Raghib (Mufradat): \"أصل الصلي الإيقاد بالنار\" — the root denotes kindling fire; the ṣalāh is so named for the \"burning\" of devotion or for the supplication that \"kindles\" the heart toward God.\n  * Al-Zamakhshari (Asas): The term ṣalāh in the Sacred Law is a transferred (naql) technical designation for the specific acts of bowing, prostration, and recitation — distinct from its lexical sense of supplication (duʿā').\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a preposition and its object, as in \"لم يحطها عن مسافر ولا عن مقيم\" where the pronominal object (ها) is separated from the second prepositional phrase (عن مقيم) by the conjunction, maintaining grammatical cohesion through parallel structure.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}], "164": [{"arabic": "وجنات ألفافا وقال تعالى إن في خلق السموات والأرض واختلاف الليل والنهار والفلك التي تجري في البحر بما ينفع الناس وما أنزل الله من السماء من ماء فأحيا به الأرض بعد موتها وبث فيها من كل دابة وتصريف الرياح والسحاب المسخر بين السماء والأرض لآيات لقوم يعقلون وقال تعالى ألم تروا كيف خلق الله سبع سموات طباقا وجعل القمر فيهن نورا وجعل الشمس سراجا والله أنبتكم من الأرض نباتا ثم يعيدكم فيها ويخرجكم إخراجا وقال تعالى أفرأيتم ما تمنون أأنتم تخلقونه أم نحن الخالقون إلى قوله للمقوين فليس يخفي على من م", "english": "The First Principle: the knowledge of His existence, the Exalted. The first thing by which one is illuminated from among the lights, and the path of reflection (ṭarīq al-iʿtibār) by which one proceeds, is that to which the Qurʾān has guided. For after the explanation of God, glorified be He, there is no explanation. He, the Exalted, has said: {«أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا وَالْجِبَالَ أَوْتَادًا وَخَلَقْنَاكُمْ أَزْوَاجًا وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا وَجَعَلْنَا اللَّيْلَ لِبَاسًا وَجَعَلْنَا النَّهَارَ مَعَاشًا وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا وَجَعَلْنَا سِرَاجًا وَهَّاجًا وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا وَجَنَّاتٍ أَلْفَافًا»} — \"Have We not made the earth a resting place, and the mountains as pegs, and created you in pairs, and made your sleep a repose, and made the night a covering, and made the day for livelihood, and built above you seven strong heavens, and made a blazing lamp, and sent down from the rain-clouds pouring water, that We may bring forth thereby grain and vegetation, and gardens dense with foliage?\" (Q 78:6–16). And He, the Exalted, has said: {«إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ وَمَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ»} — \"Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the ships which sail through the sea with that which benefits people, and what God has sent down from the sky of water, thereby reviving the earth after its death, and dispersing therein every creature, and the directing of the winds, and the clouds subservient between the heaven and the earth — are signs for a people who reason\" (Q 2:164). And He, the Exalted, has said: {«أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا»} — \"Have you not seen how God created seven heavens in layers, and made the moon therein a light, and made the sun a lamp? And God caused you to grow from the earth a growth; then He returns you into it, and brings you forth a bringing forth\" (Q 71:15–18). And He, the Exalted, has said: {«أَفَرَأَيْتُم مَّا تُمْنُونَ أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ»} — \"Have you considered what you emit? Do you create it, or are We the Creator?\" — up to His saying: {«لِلْمُقْوِينَ»} — \"for the settlers\" (Q 56:58–73).", "book_title": "Contemplation", "section_title_ar": "Section 87", "section_title_en": "The Pillars of Faith: Knowledge of God, His Attributes, His Acts, and the Audibles — Section 87", "section_index": 87, "anchors": "- Root: وجود (w-j-d)\n  * Lisan / Ayn: [Core linguistic root meaning: to find, to perceive, to be; existence as that which is found or discovered]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: al-wujūd as necessary existence (wujūb) versus contingent existence (imkān); the self-evident reality of the Creator's being]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: haqīqah — existence as affirmed reality; majāz — \"finding\" as in discovery, not applicable to God's necessary being]\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: [Core linguistic root meaning: measuring, proportioning, fashioning; origination of a thing upon a measure]\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination from nothing without prior model\n  * Al-Zamakhshari (Asas): [Literal: خلق الله الخلق: أوجده على تقدير أوجبته الحكمة — brought into existence upon a measure necessitated by wisdom; Majaz: not applicable to God's act as pure origination]\n- Root: فطر (f-t-r)\n  * Lisan / Ayn: [Core linguistic root meaning: to split, cleave, rend; to originate, to bring forth as a new creation]\n  * Al-Raghib (Mufradat): \"فطر الله الخلق\" — God's origination of creation as a primordial act; \"الفطرة\" as the innate disposition\n  * Al-Zamakhshari (Asas): [Literal: فطر الله الخلق، وهو فاطر السموات: مبتدعها — originator without precedent; Majaz: \"رأيه فطير\" — immature opinion, not applicable to divine]\n- Root: ارض (ar-d)\n  * Lisan / Ayn: [Core linguistic root meaning: the earth, the lower sphere; that which is beneath]\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء\" — the body opposite the heaven\n  * Al-Zamakhshari (Asas): [Literal: the earth as a resting place (مهادا); Majaz: not applicable in this context of divine creation]\n- Root: ركن (r-k-n)\n  * Lisan / Ayn: [Core linguistic root meaning: corner, pillar, support; that to which one leans for strength]\n  * Al-Raghib (Mufradat): \"ركن الشيء: جانبه الذي يسكن إليه\" — the side of a thing to which one repairs; used metaphorically for strength\n  * Al-Zamakhshari (Asas): [Literal: physical pillar/corner; Majaz: \"فلان يأوي من عز قومه إلى ركن شديد\" — one who repairs to a mighty support; here, the \"pillars\" (أركان) of faith as structural supports]\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure \"مداره على عشرة أصول\" (its circuit revolves upon ten principles) employs a prepositional phrase governing the verbal noun, establishing the necessary grammatical dependency that mirrors the ontological dependency of the created upon the Creator.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Contemplation'", "badge": "Afterlife"}, {"arabic": "فأحيا به الأرض بعد موتها وبث فيها من كل دابة وتصريف الرياح والسحاب المسخر بين السماء والأرض لآيات لقوم يعقلون وقال تعالى ألم تروا كيف خلق الله سبع سموات طباقا وجعل القمر فيهن نورا وجعل الشمس سراجا والله أنبتكم من الأرض نباتا ثم يعيدكم فيها ويخرجكم إخراجا وقال تعالى أفرأيتم ما تمنون أأنتم تخلقونه أم نحن الخالقون إلى قوله للمقوين فليس يخفي على من معه أدنى مسكة من عقل إذا تأمل بأدنى فكرة مضمون هذه الآيات وأدار نظره على عجائب خلق الله في الأرض والسموات وبدائع فطرة الحيوان والنبات أن هذا الأمر العجيب والترتيب المحكم لا يستغني عن صانع يد", "english": "The First Principle: the knowledge of His existence, the Exalted. The first thing by which one is illuminated from among the lights, and the path of reflection (ṭarīq al-iʿtibār) by which one proceeds, is that to which the Qurʾān has guided. For after the explanation of God, glorified be He, there is no explanation. He, the Exalted, has said: {«أَلَمْ نَجْعَلِ الْأَرْضَ مِهَادًا وَالْجِبَالَ أَوْتَادًا وَخَلَقْنَاكُمْ أَزْوَاجًا وَجَعَلْنَا نَوْمَكُمْ سُبَاتًا وَجَعَلْنَا اللَّيْلَ لِبَاسًا وَجَعَلْنَا النَّهَارَ مَعَاشًا وَبَنَيْنَا فَوْقَكُمْ سَبْعًا شِدَادًا وَجَعَلْنَا سِرَاجًا وَهَّاجًا وَأَنزَلْنَا مِنَ الْمُعْصِرَاتِ مَاءً ثَجَّاجًا لِّنُخْرِجَ بِهِ حَبًّا وَنَبَاتًا وَجَنَّاتٍ أَلْفَافًا»} — \"Have We not made the earth a resting place, and the mountains as pegs, and created you in pairs, and made your sleep a repose, and made the night a covering, and made the day for livelihood, and built above you seven strong heavens, and made a blazing lamp, and sent down from the rain-clouds pouring water, that We may bring forth thereby grain and vegetation, and gardens dense with foliage?\" (Q 78:6–16). And He, the Exalted, has said: {«إِنَّ فِي خَلْقِ السَّمَاوَاتِ وَالْأَرْضِ وَاخْتِلَافِ اللَّيْلِ وَالنَّهَارِ وَالْفُلْكِ الَّتِي تَجْرِي فِي الْبَحْرِ بِمَا يَنفَعُ النَّاسَ وَمَا أَنزَلَ اللَّهُ مِنَ السَّمَاءِ مِن مَّاءٍ فَأَحْيَا بِهِ الْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَابَّةٍ وَتَصْرِيفِ الرِّيَاحِ وَالسَّحَابِ الْمُسَخَّرِ بَيْنَ السَّمَاءِ وَالْأَرْضِ لَآيَاتٍ لِّقَوْمٍ يَعْقِلُونَ»} — \"Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the ships which sail through the sea with that which benefits people, and what God has sent down from the sky of water, thereby reviving the earth after its death, and dispersing therein every creature, and the directing of the winds, and the clouds subservient between the heaven and the earth — are signs for a people who reason\" (Q 2:164). And He, the Exalted, has said: {«أَلَمْ تَرَوْا كَيْفَ خَلَقَ اللَّهُ سَبْعَ سَمَاوَاتٍ طِبَاقًا وَجَعَلَ الْقَمَرَ فِيهِنَّ نُورًا وَجَعَلَ الشَّمْسَ سِرَاجًا وَاللَّهُ أَنبَتَكُم مِّنَ الْأَرْضِ نَبَاتًا ثُمَّ يُعِيدُكُمْ فِيهَا وَيُخْرِجُكُمْ إِخْرَاجًا»} — \"Have you not seen how God created seven heavens in layers, and made the moon therein a light, and made the sun a lamp? And God caused you to grow from the earth a growth; then He returns you into it, and brings you forth a bringing forth\" (Q 71:15–18). And He, the Exalted, has said: {«أَفَرَأَيْتُم مَّا تُمْنُونَ أَأَنتُمْ تَخْلُقُونَهُ أَمْ نَحْنُ الْخَالِقُونَ»} — \"Have you considered what you emit? Do you create it, or are We the Creator?\" — up to His saying: {«لِلْمُقْوِينَ»} — \"for the settlers\" (Q 56:58–73).", "book_title": "Contemplation", "section_title_ar": "Section 87", "section_title_en": "The Pillars of Faith: Knowledge of God, His Attributes, His Acts, and the Audibles — Section 87", "section_index": 87, "anchors": "- Root: وجود (w-j-d)\n  * Lisan / Ayn: [Core linguistic root meaning: to find, to perceive, to be; existence as that which is found or discovered]\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance: al-wujūd as necessary existence (wujūb) versus contingent existence (imkān); the self-evident reality of the Creator's being]\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction: haqīqah — existence as affirmed reality; majāz — \"finding\" as in discovery, not applicable to God's necessary being]\n- Root: خلق (kh-l-q)\n  * Lisan / Ayn: [Core linguistic root meaning: measuring, proportioning, fashioning; origination of a thing upon a measure]\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم، ويستعمل في إبداع الشيء من غير أصل ولا احتذاء\" — creation as origination from nothing without prior model\n  * Al-Zamakhshari (Asas): [Literal: خلق الله الخلق: أوجده على تقدير أوجبته الحكمة — brought into existence upon a measure necessitated by wisdom; Majaz: not applicable to God's act as pure origination]\n- Root: فطر (f-t-r)\n  * Lisan / Ayn: [Core linguistic root meaning: to split, cleave, rend; to originate, to bring forth as a new creation]\n  * Al-Raghib (Mufradat): \"فطر الله الخلق\" — God's origination of creation as a primordial act; \"الفطرة\" as the innate disposition\n  * Al-Zamakhshari (Asas): [Literal: فطر الله الخلق، وهو فاطر السموات: مبتدعها — originator without precedent; Majaz: \"رأيه فطير\" — immature opinion, not applicable to divine]\n- Root: ارض (ar-d)\n  * Lisan / Ayn: [Core linguistic root meaning: the earth, the lower sphere; that which is beneath]\n  * Al-Raghib (Mufradat): \"الأرض: الجرم المقابل للسماء\" — the body opposite the heaven\n  * Al-Zamakhshari (Asas): [Literal: the earth as a resting place (مهادا); Majaz: not applicable in this context of divine creation]\n- Root: ركن (r-k-n)\n  * Lisan / Ayn: [Core linguistic root meaning: corner, pillar, support; that to which one leans for strength]\n  * Al-Raghib (Mufradat): \"ركن الشيء: جانبه الذي يسكن إليه\" — the side of a thing to which one repairs; used metaphorically for strength\n  * Al-Zamakhshari (Asas): [Literal: physical pillar/corner; Majaz: \"فلان يأوي من عز قومه إلى ركن شديد\" — one who repairs to a mighty support; here, the \"pillars\" (أركان) of faith as structural supports]\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure \"مداره على عشرة أصول\" (its circuit revolves upon ten principles) employs a prepositional phrase governing the verbal noun, establishing the necessary grammatical dependency that mirrors the ontological dependency of the created upon the Creator.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Contemplation'", "badge": "Afterlife"}], "165": [{"arabic": "لله تعالى قوله عز وجل يحبهم ويحبونه وقوله تعالى والذين آمنوا أشد حبا لله وهو دليل على إثبات الحب وإثبات التفاوت فيه وقد جعل رسول الله صلى الله عليه وسلم الحب لله من شرط الإيمان في أخبار كثيرة إذ قال أبو رزين العقيلي: يا رسول الله ما الإيمان قال أن يكون الله ورسوله أحب إليك مما سواهما (1) حديث لا يؤمن أحدكم حتى يكون الله ورسوله أحب إليه مما سواهما متفق عليه من حديث أنس بلفظ لا يجد أحد حلاوة الإيمان حتى أكون أحب إليه من أهلاه وماله وذكر بزيادة (2) حديث لا يؤمن العبد حتى أكون أحب إليه من أهله وماله ونفسه والناس أجمعين وفي رواية ومن", "english": "Know that the Community (al-ummah) is in unanimous agreement (mujmiʿah) that love for Allah — exalted is He — and for His Messenger — may Allah bless him and grant him peace — is an obligation (farḍ). Yet how can something be obligated whose existence is [questioned]? And how can love be interpreted as obedience, when obedience is but a consequence (tabʿ) of love and its fruit (thamaratu-hu)? Thus love must necessarily precede, and only then does the one who loves obey [the beloved]. Evidence for the affirmation of love for Allah — exalted is He — is His saying — mighty and majestic is He: {«يُحِبُّهُمْ وَيُحِبُّونَهُ»} \"He loves them and they love Him\" [Al-Ma'idah: 54], and His saying — exalted is He: {«وَالَّذِينَ آمَنُوا أَشَدُّ حُبًّا لِلَّهِ»} \"And those who believe are more intense in love for Allah\" [Al-Baqarah: 165]. This is proof of the affirmation of love and the affirmation of gradation (al-tafāwut) within it. And the Messenger of Allah — may Allah bless him and grant him peace — made love for Allah a condition (sharṭ) of faith (al-īmān) in numerous reports (akhbār). For Abu Razīn al-ʿUqaylī said: \"O Messenger of Allah, what is faith?\" He said: \"That Allah and His Messenger be more beloved to you than all else besides them.\" (1) The hadith: \"None of you believes until Allah and His Messenger are more beloved to him than all else besides them\" — agreed upon (muttafaq ʿalayhi) from the hadith of Anas, with the wording: \"None finds the sweetness of faith until I am more beloved to him than his family and his wealth\" — mentioned with an addition. (2) The hadith: \"No servant believes until I am more beloved to him than his family, his wealth, his own self (nafsihi), and all people\" — and in one narration: \"and than his own self\" — agreed upon from the hadith of Anas, the wording being Muslim's, except for his saying \"and than his own self.\" Al-Bukhari said: \"from his father and his child.\" And from him — from the hadith of ʿAbdullah ibn Hishām: ʿUmar said: \"O Messenger of Allah, you are more beloved to me than everything except my own self.\" He said: \"No, by Him in whose hand is my soul, until I am more beloved to you than your own self.\" ʿUmar said: \"Then now, by Allah, you are more beloved to me than my own self.\" He said: \"Now, O ʿUmar.\" PageV04P294", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1145", "section_title_en": "** The Reality of Love for God and His Messenger — Its Obligation, Proof, and Fruits", "section_index": 1145, "anchors": "**\n\n- Root: ح ب ب (ḥ-b-b)\n  * Lisan / Ayn: \"الحب: الوداد والمحبة، والحبيب: المحبوب. وأصل الحب: ثبات المحبة في القلب ولزومها، ومنه حَبَّ البعير: برك فلم يثر، وحَبَّ الماء في الإناء: لزم وثبت.\"\n  * Al-Raghib (Mufradat): \"المحبة: إرادة ما تراه خيرا، وتكون من العبد لله بمعنى إرادة طاعته واتباع أمره، ومن الله للعبد بمعنى إرادة تكريمه وإثابته. والحب الحقيقي لا يكون إلا لمن يستحق الإحسان لذاته، وهو الله تعالى.\"\n  * Al-Zamakhshari (Asas): \"Haqiqah (Literal): حببته فأحبني، وتحاب القوم. Majaz (Metaphorical): أحب البعير: برك، وأحبت الناقة: لزمت مكانها فلم تبرح — فاستعير اللزوم والثبات للمحبة التي تلزم القلب.\"\n- Root: أ ل ه (ʾ-l-h)\n  * Lisan / Ayn: \"الإله: الله تعالى، وأصله إلاه على وزن فعال بمعنى مألوه أي معبود، يقال: أله يأله ألاهة وإلاهة: عبد، وتأله: تعبد.\"\n  * Al-Raghib (Mufradat): \"الإله: هو المعبود، وقد يقال لكل ما يتخذ معبودا، والله تعالى هو الإله الحق الذي تألهه القلوب محبة وخوفا ورجاء.\"\n  * Al-Zamakhshari (Asas): \"Haqiqah: الإله: المعبود بحق. Majaz: أله الرجل إلى فلان: فزع إليه والتجأ — فالإله هو المفزع الملجأ الذي تسكن القلوب إليه.\"\n- Root: ر س ل (r-s-l)\n  * Lisan / Ayn: \"الرسول: النبي المبعوث برسالة، والجمع رسل. وأصل الرسل: الانبعاث على تؤدة ورفق.\"\n  * Al-Raghib (Mufradat): \"الرسول: من يبعث برسالة، ويقال للقول المتحمل وللشخص المتحمل. والرسول صلى الله عليه وسلم هو المبلغ عن الله تعالى.\"\n  * Al-Zamakhshari (Asas): \"Haqiqah: أرسل الله في الأمم رسلا. Majaz: أرسل يده عن يده: خذله، وأرسل الفحل في الإبل — فالرسول من أرسله الله انبعاثا بالهداية.\"\n- Root: ن ف س (n-f-s)\n  * Lisan / Ayn: \"النفس: الروح، والذات، والشيء بعينه. ونفس الشيء: حقيقته وذاته.\"\n  * Al-Raghib (Mufradat): \"النفس تقال لمعان: منها الروح، ومنها الذات، قال تعالى: ويحذركم الله نفسه [آل عمران/28] أي ذاته. وتطلق النفس على الدم، وعلى العين.\"\n  * Al-Zamakhshari (Asas): \"Haqiqah: النفس: الروح والذات. Majaz: دفق نفسه أي دمه، وأصابته نفس: عين.\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما\" تحصر الخبر في المبتدأ وتنفي ما عداه، كما في قوله تعالى: {إنما المؤمنون الذين آمنوا بالله ورسوله} — فالحصر هنا يقتضي أن المحبة شرط الإيمان لا يتم إلا بها.\n\n---\n\n**", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "171": [{"arabic": "يؤثر فيه أصلا ف مثله كمثل الذي ينعق بما لا يسمع إلا دعاء ونداء صم بكم عمي فهم لا يعقلون بل صاحب القلب تؤثر فيه الكلمة من الحكمة يسمعها قال جعفر الخلدي دخل رجل من أهل خراسان على الجنيد وعنده جماعة فقال للجنيد متى يستوي عند العبد حامده وذامه فقال بعض الشيوخ إذا دخل البيمارستان وقيد بقيدين فقال الجنيد ليس هذا من شأنك ثم أقبل على الرجل وقال إذا تحقق أنه مخلوق فشهق الرجل شهقة ومات فإن قلت فإن كان سماع القرآن مفيدا للوجد فما بالهم يجتمعون على سماع الغناء من القوالين دون القارئين فكان ينبغي أن يكون اجتماعهم وتواجدهم في حلق القراء لا حلق", "english": "Some of the Sufis said: \"One night I was reciting this verse: {كُلُّ نَفْسٍ ذَائِقَةُ الْمَوْتِ} «Every soul shall taste death» [Q. 3:185]. I kept repeating it, and lo, a caller cried out to me: 'How long will you repeat this verse? You have killed four of the jinn who have not raised their heads to the sky since they were created.'\"", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 512", "section_title_en": "On the Ecstatic States (Wajd) Produced by Qur'anic Recitation and the Superiority of Song (Ghinā') in Stirring the Heart", "section_index": 512, "anchors": "- Root: وجد (w-j-d)\n  * Lisan / Ayn: Core meaning of finding, attaining, and also denoting the emotional state of ecstasy or rapture that \"finds\" the heart.\n  * Al-Raghib (Mufradat): In the theological context, 'wajd' is the state of spiritual finding—a direct, overwhelming apprehension of divine realities that bypasses discursive reasoning.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes \"finding\" a lost object; metaphorical (Majaz) usage denotes the heart \"finding\" its spiritual state, leading to agitation and ecstasy.\n- Root: سمع (s-m-')\n  * Lisan / Ayn: The faculty of hearing; also the ear itself.\n  * Al-Raghib (Mufradat): Hearing can be literal (perception of sound) or figurative (understanding, obedience, acceptance). The heart's \"hearing\" is a deeper comprehension.\n  * Al-Zamakhshari (Asas): Literal: \"سمعته\" (I heard him). Metaphorical: \"سمع الله لمن حمده\" (God answers/he accepts the one who praises Him), indicating a responsive, transformative hearing.\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death; the opposite of life.\n  * Al-Raghib (Mufradat): Death is the cessation of the soul's governance over the body, a separation. In the spiritual context, it can be a metaphorical death to worldly desires.\n  * Al-Zamakhshari (Asas): Literal: physical death. Metaphorical: \"أحيا الله البلد الميت\" (God revives the dead land), indicating spiritual revival or the death of the ego.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to emphasize that the stirring of the heart is exclusively through what is appropriate to its state, as in the phrase \"إنما المحرك لما في القلب ما يناسبه\" (The only thing that moves what is in the heart is that which is suitable to it).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Audition and Ecstasy'", "badge": "Insight"}], "172": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "أطعمه فيرى الطعام نعمة منه قال الله تعالى كلوا من طيبات ما رزقناكم واشكروا لله ومهما أكل حلالا قال الحمد لله الذي بنعمته تتم الصالحات وتنزل البركات اللهم أطعمنا طيبا واستعملنا صالحا وإن أكل شبهة فليقل الحمد لله على كل حال اللهم لا تجعله قوة لنا على معصيتك ويقرأ بعد الطعام قل هو الله أحد ولإيلاف قريش ولا يقوم عن المائدة حتى ترفع أولا فإن أكل طعام الغير فليدع له وليقل اللهم أكثر خيره وبارك له فيما رزقته ويسر له أن يفعل فيه خيرا وقنعه بما أعطيته واجعلنا وإياه من الشاكرين وإن أفطر عند قوم فليقل أفطر عندكم الصائمون وأكل", "english": "It is that one should refrain from eating before complete satiety, and lick his fingers, then wipe them with a napkin, then wash them, and pick up the crumbs of food that have fallen. The Prophet (peace and blessings be upon him) said: \"Whoever eats what falls from the table will live in abundance and his offspring will be protected.\" (5)", "book_title": "Manners of Eating", "section_title_ar": "Section 285", "section_title_en": "The Third Division: What is Recommended After Eating", "section_index": 285, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core meaning is the act of eating/consuming food; also used for the action of fire upon wood, and metaphorically for devouring.\n  * Al-Raghib (Mufradat): Distinguishes الأكل (eating) as the intake of nourishment; the theological nuance extends to the spiritual consequence of what is consumed — lawful (halal) versus unlawful (haram) food affecting the soul's disposition.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) refers to physical ingestion; Metaphorical (Majaz) extends to \"devouring\" wealth or property unjustly. Here, the literal sense governs the etiquettes of eating, while the metaphorical sense underlies the warning against consuming what is unlawful.\n- Root: لهم (lahm)\n  * Lisan / Ayn: Root relates to swallowing/ingesting; also the flesh (lahm) of the body.\n  * Al-Raghib (Mufradat): The root for إلهام (inspiration) is distinct, but the physical flesh (لحم) is the corporeal substance nourished by food. The Prophetic warning \"every flesh that grows from the unlawful\" connects the physical body to its spiritual source.\n  * Al-Zamakhshari (Asas): Literal: flesh as bodily substance. Metaphorical: the moral state of the body as a direct consequence of its nourishment.\n- Root: حمد (hamd)\n  * Lisan / Ayn: Praise, commendation; the act of extolling virtues.\n  * Al-Raghib (Mufradat): Praise (حمد) is the acknowledgment of beneficence with reverence; it is the verbal expression of gratitude for divine provision, distinct from mere thanks (شكر) which can be by action.\n  * Al-Zamakhshari (Asas): Literal: to praise God for His favors. Metaphorical: \"I praised his conduct\" — extending to approving of an act. Here, the literal sense of praising God after eating is the prescribed liturgical response.\n- Root: برك (barak)\n  * Lisan / Ayn: The chest of a camel; to kneel down; blessing (بركة) as a derived concept of divine goodness descending.\n  * Al-Raghib (Mufradat): Blessing (بركة) is the increase of good from God; it is invoked upon food, upon a person, or upon an action.\n  * Al-Zamakhshari (Asas): Literal: \"God blessed him\" — to confer goodness. Metaphorical: \"War laid its chest upon them\" — to press down heavily. In the supplications, the literal sense of invoking divine blessing upon food and the provider is intended.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the placement of prepositional phrases and the flow of supplications, ensuring the syntactic structure of the du'a remains coherent and grammatically sound.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Manners of Eating'", "badge": "Du'a"}, {"arabic": "وقال إن الله تعالى أمر المؤمنين بما أمر به المرسلين فقال {يا أيها الذين آمنوا كلوا من طيبات ما رزقناكم} (4) أخرجه مسلم من حديث أبي هريرة (5) حديث كان لا يسأل عن كل ما يحمل إليه رواه أحمد من حديث جابر أن رسول الله صلى الله عليه وسلم وأصحابه مروا بامرأة فذبحت لهم شاة الحديث فأخذ رسول الله صلى الله عليه وسلم لقمة فلم يستطع أن يسيغها فقال هذه شاة ذبحت بغير إذن أهلهاالحديث وله من حديث أبي هريرة كان إذا أتى بطعام من غير أهله سأل عنهالحديث وإسنادهما جيد وفي هذا أنه كان لا يسأل عما أتي به من عند أهله والله أعلم // وإنما الواجب أن ينظر التاجر إلى من يعامله", "english": "The fifth [etiquette] is that he should not be intensely eager for the marketplace and trade — that is, he should not be the first to enter nor the last to leave, nor should he voyage by sea for trade, for both of these are disliked (makrūh). It is said: \"Whoever voyages by sea has been excessive in seeking provision.\"", "book_title": "Etiquette of Earning", "section_title_ar": "Section 334", "section_title_en": "The Book of Earning and Livelihood — Section 334: On the Etiquettes of the Trader (Continued)", "section_index": 334, "anchors": "- Root: حرص (ḥaraṣa)\n  * Lisan / Ayn: [Core linguistic root meaning] — Intense, covetous desire; eager clinging to something.\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] — Blameworthy eagerness that distracts the heart from God; opposed to qanāʿah (contentment).\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] — Literal: physical greed for provision. Metaphorical: the soul's excessive attachment to worldly gain.\n- Root: شبه (shub'hah)\n  * Lisan / Ayn: [Core linguistic root meaning] — Ambiguity; resemblance between truth and falsehood.\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] — Matters whose legal status is uncertain; the pious abstain from them to safeguard their religion.\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] — Literal: visual resemblance. Metaphorical: doubtful matters that resemble the permissible but are tainted with the forbidden.\n- Root: عون (ʿawn)\n  * Lisan / Ayn: [Core linguistic root meaning] — Assistance; aid in carrying a burden.\n  * Al-Raghib (Mufradat): [Theological/Kalam semantic nuance] — Complicity in sin; assisting the oppressor is itself an act of oppression.\n  * Al-Zamakhshari (Asas): [Literal vs Metaphorical distinction] — Literal: physical help. Metaphorical: any act that enables or emboldens wrongdoing.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The text uses restrictive constructions to emphasize that the trader's obligation is limited to dealing with the just, and that the pious are fewer in number than those to be avoided.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Earning'", "badge": "Hadith"}], "174": [{"arabic": "حديث عبد الرحمن بن شبل وقال صلى الله عليه وسلم ثلاثة نفر لا يكلمهم الله يوم القيامة ولا ينظر إليهم المنان بعطيته والمنفق سلعته بالحلف الفاجر والمسبل إزاره (7) وقال صلى الله عليه وسلم من حلف حالف بالله فأدخل فيها مثل جناح بعوضة إلا كانت نكتة في قلبه إلى يوم القيامة (8) حديث أبي ذر ثلاثة يحبهم الله", "english": "I say: Now we turn to the fourteenth affliction—lying in speech and in oaths. This is among the most abominable of sins and the most heinous of faults. Isma'il ibn Wasit said: I heard Abu Bakr al-Siddiq—may God be pleased with him—delivering a sermon after the death of the Messenger of God—peace be upon him—and he said: The Messenger of God—peace be upon him—stood among us in this very place of mine one year ago. Then he wept—Page V03P133—and said: Beware of lying, for it is coupled with wickedness (fujur), and the two are in the Fire. (1)", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 675", "section_title_en": "The Fourteenth Affliction: Lying in Speech and in Oaths", "section_index": 675, "anchors": "- Root: كذب (Kadhaba)\n  * Lisan / Ayn: Core root denotes the contrivance of falsehood in speech or action; the Kitab al-Ayn treats it as the antithesis of truthfulness (sidq), encompassing both verbal assertion and behavioral deception.\n  * Al-Raghib (Mufradat): Lying (kadhib) applies to both speech (maqal) and deed (fi'l), as in the Quranic verse {«وَاللَّهُ يَشْهَدُ إِنَّ الْمُنَافِقِينَ لَكَاذِبُونَ»} where the hypocrites' claim of faith is false in their conviction, not necessarily in their utterance—thus lying is a corruption of the inner reality manifesting outwardly.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) usage is the utterance of falsehood; metaphorical (majaz) usage includes \"kadhaba al-nāqah\" (the she-camel's milk dried up, i.e., her promise of milk proved false) and \"kadhaba al-rajul\" (he turned coward after boasting), where the action itself is described as lying—indicating that lying encompasses any breach of what is expected or claimed.\n- Root: حلف (Halafa)\n  * Lisan / Ayn: The root denotes swearing an oath (yamin), and in the Kitab al-Ayn, al-hilf is the covenant or compact between parties, with al-halif being one bound by such an oath.\n  * Al-Raghib (Mufradat): Al-hilf is the covenant ('ahd) between people, and al-muhalafah is mutual pact-making; it is also used metaphorically for enduring attachment, as in \"hulayf al-karam\" (the ally of generosity), signifying a binding commitment.\n  * Al-Zamakhshari (Asas): Literal usage is swearing by God; metaphorical usage extends to any firm alliance or inseparable bond, as in \"hulayf al-sahar\" (the companion of sleeplessness), showing the root's semantic range from oath to lifelong adherence.\n- Sibawayh Rule: Bab al-'Atf 'ala al-Mawdi' (Coordination on Syntactic Position) — When multiple clauses are coordinated, the second element may be parsed according to the governing context of the first, allowing for elision of repeated verbs or prepositions, as in the hadith structure where \"wa huma fi al-nar\" is coordinated with the preceding clause's implied judgment.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Anger and Hatred'", "badge": "Afterlife"}, {"arabic": "وسلم ثلاثة لا يكلمهم الله ولا ينظر إليهم ولا يزكيهم ولهم عذاب أليم شيخ زان وملك كذاب وعائل مستكبر (4) حديث عبد الله بن عامر جاء رسول الله صلى الله عليه وسلم إلى بيتنا وأنا صبي صغير فذهبت لألعب فقالت أمي يا عبد الله تعال أعطيك فقال وما أردت أن تعطيه قالت تمرا فقال إن لم تفعلي كتبت عليك كذبة رواه أبو داود وفيه من لم يسم وقال الحاكم أن عبد الله بن عامر ولد في حياته صلى الله عليه وسلم ولم يسمع منه قلت وله شاهد من حديث أبي هريرة وابن مسعود ورجالهما ثقات إلا أن الزهري لم يسمع من أبي هريرة وقال صلى الله عليه وسلم لو أف", "english": "Among them is the hadith: \"And three whom God hates: the trader or seller who swears much.\" Ahmad narrated it, and the wording is his. In its chain is Ibn al-Aḥmaṣ, whose condition is unknown. Both Ahmad and al-Nasā'ī narrated it with another wording through a sound chain. And al-Nasā'ī has, from the hadith of Abū Hurayrah: \"Four whom God abhors: the seller who swears much\" — the hadith — and its chain is sound.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 676", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 676: On Lying (al-Kadhib) — Hadith Reports and Traditions (Āthār)", "section_index": 676, "anchors": "- Root: كذب (Kadhaba)\n  * Lisan / Ayn: Core meaning: to report a falsehood, to utter what is contrary to reality; al-Kadhdhābah: a variegated cloth that deceives the eye into thinking it is part of the ceiling — indicating the deceptive semblance of truth.\n  * Al-Raghib (Mufradat): Kadhib applies to both speech and action. God says: {«Only they forge falsehood who do not believe in God's signs»} (Q 16:105) — the hypocrites' speech was true, but their inward conviction was false, so God called them liars (kādhibūn) regarding their belief.\n  * Al-Zamakhshari (Asas): Literal (Haqīqah): \"He is kadhib, kadhūb, kadhāb, kaydhabān\" — one who lies habitually. Metaphorical (Majāz): \"He carried [the burden] then lied\" — i.e., he cowardly retreated, making his charge a false one; \"the she-camel lied\" — her pregnancy proved false.\n- Root: حدث (Ḥadatha)\n  * Lisan / Ayn: Core meaning: to originate, to bring into being after non-existence; al-ḥadīth: speech that is new/recently originated.\n  * Al-Raghib (Mufradat): \"Al-Ḥudūth: a thing's coming to be after it was not — whether accident or substance. Its creation (iḥdāth) belongs solely to God. Al-muḥdath: what is brought into existence after non-existence.\" God says: {«There comes not to them a fresh reminder (dhikr muḥdath) from their Lord»} (Q 21:2).\n  * Al-Zamakhshari (Asas): Literal: \"He spoke a ḥadīth; fresh in age.\" Metaphorical: \"They became aḥādīth (topics of talk)\"; ʿUmar was called muḥaddath — one whose intuition is divinely inspired, as if truth were spoken into him.\n- Root: ويل (Wayl)\n  * Lisan / Ayn: An expression of intense woe, destruction, and chastisement; a word of threat and condemnation.\n  * Al-Raghib (Mufradat): Wayl denotes severe affliction and ruin; it is a declaration of impending punishment.\n  * Al-Zamakhshari (Asas): Literal: \"Woe to him\" — a cry of ruin. Used in threats: \"Waylun lahu\" — destruction is his due.\n- Root: شنأ (Shana'a)\n  * Lisan / Ayn: Intense hatred and abhorrence.\n  * Al-Raghib (Mufradat): Al-Shan'ān: intense hatred that drives one to shun the object.\n  * Al-Zamakhshari (Asas): Literal: \"He hated him with shan'an\" — vehement hatred.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The particle innamā restricts the predicate to the subject alone, negating it for all else. Applied in the verse: {«Only they forge falsehood who do not believe»} — restricting fabrication to the disbelievers, affirming that the believer does not lie.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'", "badge": "Hadith"}], "177": [{"arabic": "الشك في هذا الصدق وكذلك قال الله تعالى ولكن البر من آمن بالله واليوم الآخر والملائكة والكتاب والنبيين فشرط عشرين وصفا كالوفاء بالعهد والصبر على الشدائد ثم قال تعالى أولئك الذين صدقوا وقد قال تعالى يرفع الله الذين آمنوا منكم والذين أوتوا العلم درجات وقال تعالى لا يستوي منكم من أنفق من قبل الفتح وقاتل الآية وقد قال تعالى هم درجات عند الله وقال صلى الله عليه وسلم الإيمان عريان ولباسه التقوى (1) الحديث وقال صلى الله عليه وسلم الإيمان بضع وسبعون بابا أدناها إماطة الأذى عن الطريق فهذا ما يدل على ارتباط كمال الإيمان بالأعمال وأما ارتباطه بالبراءة عن ال", "english": "...doubt concerning this truthfulness. Likewise, God Most High said: {«But righteousness is he who believes in God and the Last Day and the angels and the Book and the prophets»} (2:177) — thus He conditioned twenty attributes, such as faithfulness to covenant and patience under hardship. Then He said Most High: {«Those are the truthful ones»} (2:177). And God Most High said: {«God will raise those who have believed among you and those who have been given knowledge, by degrees»} (58:11). And He said Most High: {«Not equal among you are those who spent before the conquest and fought»} (57:10). And He said Most High: {«They are degrees before God»} (3:163). And the Prophet, peace be upon him, said: \"Faith is naked, and its garment is God-consciousness (al-taqwā).\" And the Prophet, peace be upon him, said: \"Faith has seventy-some branches; the lowest of them is removing harm from the path.\" All this indicates the interconnection of the perfection of faith with works.", "book_title": "Foundations of Belief", "section_title_ar": "Section 104", "section_title_en": "The Revival of the Religious Sciences — Book of the Secrets of Zakāh, Section 104: On the Degrees of Faith and Its Connection to Works, and the Hidden Hypocrisy (al-Nifāq al-Khafī) That Contradicts the Perfection of Faith", "section_index": 104, "anchors": "- Root: ن ف ق (N-F-Q)\n  * Lisan / Ayn: Root denotes passing away, depletion, and expenditure; also the underground burrow of the jerboa (nāfiqāʾ) with a concealed exit — the etymological basis for hypocrisy as a hidden exit from faith.\n  * Al-Raghib (Mufradat): \"نفق الشيء: مضى ونفد\" — theological nuance: hypocrisy (nifāq) is that which causes faith to expire and pass away, whether by sale (worldly gain) or by death (spiritual ruin).\n  * Al-Zamakhshari (Asas): Literal: \"نفقت الدراهم\" (coins ran out). Metaphorical: \"نفق روحه: خرج\" (his soul expired and went forth) — hence the hypocrite's faith is one whose spirit has already departed.\n- Root: أ ي م (A-Y-M)\n  * Lisan / Ayn: A woman without a husband; a man long unmarried. Al-Raghib: \"الحرب مأيمة\" — war makes women widows.\n  * Al-Zamakhshari (Asas): Literal: \"تركوا النساء أيامى\" (they left women widowed). Metaphorical application: the one who feels secure from hypocrisy is like one who claims immunity from widowhood — a false security.\n- Root: و ف ي (W-F-Y)\n  * Lisan / Ayn: Fullness, completion, fulfillment of a measure or covenant.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — the one who has reached completion. \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — to fulfill the covenant without breach.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" (a full-weight dirham). Metaphorical: \"أوفى على المائة\" (he surpassed a hundred) — faith's perfection (wafāʾ) is only attained by surpassing mere profession to include works and inward sincerity.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the grammatical force of \"إنما\" constructions and conditional clauses (من كان...), where the predicate is restricted to the condition stated, as in the hadith \"أربع من كن فيه فهو منافق خالص\" — the four traits are exhaustive of the ruling.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Foundations of Belief'", "badge": "Hadith"}, {"arabic": "قال نعم أما سمعت قوله عز وجل وآتى المال على حبه ذوي القربى الآية واستدلوا بقوله عز وجل ومما رزقناهم ينفقون وبقوله تعالى وأنفقوا مما رزقناكم وزعموا أن ذلك غير منسوخ بآية الزكاة بل هو داخل في حق المسلم على المسلم ومعناه أنه يجب على الموسر مهما وجد محتاجا أن يزيل حاجته فضلا عن مال الزكاة والذي يصح في الفقه من هذا الباب أنه مهما أرهقته حاجته كانت إزالتها فرض كفاية إذ لا يجوز تضييع مسلم ولكن يحتمل أن يقال ليس على الموسر إلا تسليم ما يزيل الحاجة فرضا ولا يلزمه بذله بعد أن أسقط الزكاة عن نفسه ويحتمل أن يقال يلز", "english": "A group of the Followers (tābiʿūn) held that there are rights in wealth beyond the zakat — among them al-Nakhaʿī, al-Shaʿbī, ʿAṭāʾ, and Mujāhid. Al-Shaʿbī said, after being asked, \"Is there a right in wealth beyond the zakat?\": \"Yes. Have you not heard His saying — mighty and majestic is He: {«وَآتَى الْمَالَ عَلَىٰ حُبِّهِ ذَوِي الْقُرْبَىٰ»} 'And gives wealth, despite his love for it, to relatives' (2:177)?\" They also adduced His saying — mighty and majestic is He: {«وَمِمَّا رَزَقْنَاهُمْ يُنفِقُونَ»} 'And from what We have provided them, they spend' (2:3), and His saying — exalted is He: {«وَأَنفِقُوا مِن مَّا رَزَقْنَاكُم»} 'And spend from what We have provided you' (2:254). They claimed that this is not abrogated by the verse of zakat; rather, it falls within the right of a Muslim upon a Muslim. Its meaning is that it is incumbent upon the affluent one, whenever he finds a needy person, to remove his need — over and above the zakat wealth.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 173", "section_title_en": "The Second Division: Those Who Guard Their Wealth Awaiting Seasons of Need — On the Inner Meanings of Zakat (Section 173)", "section_index": 173, "anchors": "- Root: ف-ق-ر (f-q-r)\n  * Lisan / Ayn: Core meaning of neediness, poverty; the hollow of the spine (faqār) — that which is structurally weak and dependent.\n  * Al-Raghib (Mufradat): Poverty (faqr) has four senses: (1) essential neediness before Allah, universal to all creatures; (2) lack of possessions; (3) [the third and fourth senses as elaborated in the full lexicon entry].\n  * Al-Zamakhshari (Asas): Literal (haqīqah): one who lacks wealth. Metaphorical (majāz): \"the poverty of speech\" (fuqar al-kalām) — its subtle points, likened to ornaments shaped like vertebrae.\n- Root: ص-د-ق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness in speech; giving (ṣadaqah) as the outward verification of inward faith.\n  * Al-Raghib (Mufradat): Ṣidq (truth) and kidhb (falsehood) are originally in speech — statement of what is, or what will be. By extension, ṣadaqah is that which verifies the truthfulness of one's claim to faith through expenditure.\n  * Al-Zamakhshari (Asas): Literal: truthful speech. Metaphorical: \"a horse with true running\" (dhū miṣdaq fī al-jary) — that which verifies its excellence through action. Thus charity verifies the giver's sincerity.\n- Root: م-ن-ن (m-n-n)\n  * Lisan / Ayn: The bestowal of a favor; reproaching another by reminding them of one's gift (al-mann).\n  * Al-Raghib (Mufradat): [As elaborated in the full lexicon entry on the heart's self-perception of superiority over the recipient.]\n  * Al-Zamakhshari (Asas): Literal: a heavy weight; a favor. Metaphorical: the act of counting one's favors over another — a corrosion of the gift's value.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise scope of obligation (farḍ kifāyah) versus supererogatory merit (faḍl), and the restriction of \"rights in wealth\" (ḥuqūq fī al-māl) beyond the obligatory zakat.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}, {"arabic": "الفقر وحين البأس أي المحاربة {أولئك الذين صدقوا وأولئك هم المتقون} فإذن هذه أقسام الصبر باختلاف متعلقاتها ومن يأخذ المعاني من الأسامي يظن أن هذه الأحوال مختلفة في ذواتها وحقائقها من حيث رأى الأسامي مختلفة والذي يسلك الطريق المستقيم وينظر بنور الله تعالى يلحظ المعاني أولا فيطلع على حقائقها ثم يلاحظ الأسامي فإنها وضعت دالة على المعاني فالمعاني هي الأصول والألفاظ هي التوابع ومن يطلب الأصول من التوابع لا بد وأن يزل وإلى الفريقين الإشارة بقوله تعالى {أفمن يمشي مكبا على وجهه أهدى أم من يمشي سويا على صراط مستقيم} فإن الكف", "english": "Thus most of the moral traits of faith (akhlāq al-īmān) are subsumed under patience. For this reason, when the Prophet — peace be upon him — was once asked about faith, he said: \"It is patience\" — because it is the most abundant and most precious of its works, just as he said: \"The Pilgrimage is ʿArafah.\" And God — exalted be He — has gathered together all of these divisions and called the whole of them \"patience,\" saying — exalted be He: {And the patient in adversity (al-ba'sā') — i.e., calamity — and in hardship (al-ḍarrā') — i.e., poverty — and at the time of peril (ḥīna al-ba's) — i.e., warfare — {those are the ones who have been truthful, and those are the ones who are God-fearing} «أولئك الذين صدقوا وأولئك هم المتقون». So these, then, are the divisions of patience according to the difference of its objects of relation (mutaʿallaqātihā).", "book_title": "Patience and Gratitude", "section_title_ar": "Section 960", "section_title_en": "The Names That Accrue to Patience (Ṣabr) in Relation to Its Object, and the Divisions of Patience According to Strength and Weakness", "section_index": 960, "anchors": "- Root: صبر (Ṣ-B-R)\n  * Lisan / Ayn: Core sense of \"holding back\" or \"restraining\" (al-imsāk), as in holding a beast without fodder or confining someone; endurance of hardship.\n  * Al-Raghib (Mufradat): \"Patience is the restraint of the self (ḥabs al-nafs) upon what reason and Law require, or from what they require it to abstain.\" It is a generic term (laẓf ʿāmm) whose specific names vary by context: in calamity it is \"patience\" (ṣabr) against \"panic\" (jazaʿ); in battle, \"courage\" (shajāʿah) against \"cowardice\" (jubn); in affliction, \"breadth of breast\" (saʿat al-ṣadr) against \"vexation\" (ḍajar).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"I bore patiently what I dislike, and I held back from what I love.\" Metaphorical (majāz): \"His hand does not endure the cold\" — i.e., is not patient against it; \"he is more patient of beating than the ground.\"\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self or soul; that which is breathed; also blood (nafs sā'ilah).\n  * Al-Raghib (Mufradat): \"Al-Nafs: the spirit (al-rūḥ)… and in God's saying {He warns you of Himself} (nafsihi) it denotes His very essence (dhāt).\"\n  * Al-Zamakhshari (Asas): Literal: \"a precious thing (nafīs)\"; Metaphorical: \"he poured out his nafs (i.e., his blood).\"\n- Root: ضرب (Ḍ-R-B)\n  * Al-Raghib (Mufradat): Used for striking and for coercion; also for \"types\" or \"kinds\" (ḍarb min kadhā) — as in the section heading \"two types\" (ḍarbān).\n  * Al-Zamakhshari (Asas): Literal: \"he struck him with the sword\"; Metaphorical: \"he struck his hand\" (i.e., prevented him from an affair); \"the vicissitudes of time struck them.\"\n- Sibawayh Rule: Interposition and Specification (Bāb al-Faṣl bayn al-Jār wa-al-Majrūr) — The syntactic structure \"bi-al-iḍāfah ilā mā ʿanhu al-ṣabr\" (in relation to that from which one exercises patience) shows how prepositional phrases govern semantic specification, distinguishing the act of patience from its object (al-mutaʿallaq).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "178": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "183": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "185": [{"arabic": "كقوله عز وجل شهر رمضان الذي أنزل فيه القرآن إذ لم يظهر به أنه ليل أو نهار وبان بقوله عز وجل إنا أنزلناه في ليلة مباركة ولم يظهر به أي ليلة فظهر بقوله تعالى إنا أنزلناه في ليلة القدر وربما يظن في الظاهر الاختلاف بين هذه الآيات فهذا وأمثاله مما لا يغني فيه إلا النقل والسماع فالقرآن من أوله إلى آخره غير خال عن هذا الجنس لأنه أنزل بلغة العرب فكان مشتملا على أصناف كلامهم من إيجاز وتطويل وإضمار وحذف وإبدال وتقديم وتأخير ليكون ذلك مفحما لهم ومعجزا في حقهم فكل من اكتفى بفهم ظاهر العربية وبادر إ", "english": "I say: The Prophet (peace be upon him) was asked about the means of deliverance from these trials, and he said: \"The Book of Allah — act by what is in it, for it is that which delivers one from them.\" The questioner repeated this three times, and he (peace be upon him) said three times: \"Learn the Book of Allah, Mighty and Glorious, and act by what is in it, for in it is deliverance.\"", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 233", "section_title_en": "The Book of the Etiquette of Recitation — Section 233: On Understanding the Meanings of the Qur'an and the Limits of Interpretation", "section_index": 233, "anchors": "- Root: ف-ه-م (f-h-m)\n  * Lisan / Ayn: \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — comprehension as an inherent faculty by which one ascertains meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن... وأفهمته: إذا قلت له حتى تصوره\" — comprehension is a cognitive disposition; distinction between understanding (fahm) and making understood (ifhām)\n  * Al-Zamakhshari (Asas): \"تقول: من لم يؤت من سوء الفهم أتى من سوء الإفهام\" — literal usage; failure of understanding often stems from failure of communication\n- Root: ف-س-ر (f-s-r)\n  * Lisan / Ayn: \"وكل شيء يعرف به تفسير الشيء ومعناه، فهو تَفْسِرَتُه\" — that by which a thing's meaning is made known\n  * Al-Raghib (Mufradat): \"التفسير قد يقال فيما يختص بمفردات الألفاظ وغريبها، وفيما يختص بالتأويل\" — tafsīr concerns lexical surface; taʾwīl concerns deeper meaning\n  * Al-Zamakhshari (Asas): \"هذا كلام يحتاج إلى فسر وتفسير\" — literal: exposition of what is obscure\n- Root: و-ج-ل (w-j-l)\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; used of hearts trembling at divine mention\n  * Al-Zamakhshari (Asas): \"لو واجلت فلانا لوجلته: لغلبته في الوجل\" — literal sense of fear; metaphorical extension to overpowering in fear\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — the particle innamā restricts predication, essential for parsing the Prophet's saying \"innamā al-aʿmālu bi-l-niyyāt\" and analogous restrictive formulations in the ḥadīth cited herein", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Etiquette of Quran Recitation'", "badge": "Hadith"}], "186": [{"arabic": "قال الله تعالى {وإذا سألك عبادي عني فإني قريب أجيب دعوة الداع إذا دعان فليستجيبوا لي} وقال تعالى {ادعوا ربكم تضرعا وخفية إنه لا يحب المعتدين} وقال تعالى {وقال ربكم ادعوني أستجب لكم إن الذين يستكبرون عن عبادتي سيدخلون جهنم داخرين} وقال عز وجل {قل ادعوا الله أو ادعوا الرحمن أيا ما تدعوا فله الأسماء الحسنى} وروى النعمان بن بشير عن النبي صلى الله عليه وسلم أنه قال إن الدعاء هو العبادة ثم قرأ ادعوني أستجب لكم (1) الآية وقال صلى الله عليه وسلم الدعاء مخ العبادة (2) وروى أبو هريرة أنه صلى الله عليه وسلم قال", "english": "Allah the Exalted has said: {«وَإِذَا سَأَلَكَ عِبَادِي عَنِّي فَإِنِّي قَرِيبٌ أُجِيبُ دَعْوَةَ الدَّاعِ إِذَا دَعَانِ فَلْيَسْتَجِيبُوا لِي»} (And when My servants ask you concerning Me — indeed I am near. I respond to the invocation of the supplicant when he calls upon Me. So let them respond to Me — Qurʾan 2:186). And He the Exalted said: {«ادْعُوا رَبَّكُمْ تَضَرُّعًا وَخُفْيَةً إِنَّهُ لَا يُحِبُّ الْمُعْتَدِينَ»} (Call upon your Lord in humility and privately; indeed, He does not like transgressors — Qurʾan 7:55). And He the Exalted said: {«وَقَالَ رَبُّكُمُ ادْعُونِي أَسْتَجِبْ لَكُمْ إِنَّ الَّذِينَ يَسْتَكْبِرُونَ عَنْ عِبَادَتِي سَيَدْخُلُونَ جَهَنَّمَ دَاخِرِينَ»} (And your Lord said: Call upon Me; I will respond to you. Indeed, those who disdain My worship will enter Hell humiliated — Qurʾan 40:60). And He, Glorified and Exalted, said: {«قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا الرَّحْمَنَ أَيًّا مَا تَدْعُوا فَلَهُ الْأَسْمَاءُ الْحُسْنَى»} (Say: Call upon Allah or call upon the Most Merciful. Whichever [name] you call — to Him belong the Most Beautiful Names — Qurʾan 17:110).", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 241", "section_title_en": "The Book of Invocation — Section 241: The Second Chapter on the Etiquette of Supplication (Duʿāʾ), Its Virtue, the Virtue of Certain Transmitted Supplications, the Virtue of Seeking Forgiveness (Istighfār), and Invoking Blessings upon the Messenger of Allah (Peace Be Upon Him)", "section_index": 241, "anchors": "- Root: دعو (Daʿā)\n  * Lisan / Ayn: \"الدعاء: الرغبة إلى الله تعالى، والاستعانة به. وأصل الدعو: الإقبال على الشيء بالرغبة والطلب. والدعوة: الكلمة التي يدعو بها. والمدعوّ: الذي يجيب. والداعي: الفاعل. واستدعاه: طلب منه الدعاء.\"\n  * Al-Raghib (Mufradat): \"الدعاء: الرغبة إلى الله تعالى في قضاء الحاجة، وهو ضربان: دعاء عبادة، ودعاء مسألة. فدعاء العبادة: هو التوجه إلى الله تعالى بالطاعة والإخلاص، ودعاء المسألة: هو طلب الحاجة. قال تعالى: {وقال ربكم ادعوني أستجب لكم} — فجعل الدعاء عبادة، إذ قال: {إن الذين يستكبرون عن عبادتي} فعطف العبادة على الدعاء، فدلّ على أنهما واحد.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"دعوته دعواً ودعاءً: ناديته وصحت به. ودعا الله: ابتهل إليه بالسؤال. ودعا الرجل: استنصره. ودعا الناقة: استدبرها.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الدعاء في العبادة: استعارة من دعاء المسألة، لأن العابد كأنه يسأل الله الثواب والقبول. ومنه قوله تعالى: {إن الذين يستكبرون عن عبادتي} — أي عن دعائي، فسمّى العبادة دعاءً.\"\n\n- Root: سحر (Saḥara)\n  * Lisan / Ayn: \"السحر: طرف الحلقوم والرئة. وقيل: السحر: آخر الليل عند الصبح. والسحور: الأكل في السحر. والسحرة: السحر الأخير من الليل.\"\n  * Al-Raghib (Mufradat): \"السحر يقال على معان: الأول: الخداع وتخييلات لا حقيقة لها... والثاني: وقت السحر، وهو آخر الليل، سمي بذلك لأنه وقت يكون فيه تنفس الصعداء واسترواح من ظلمة الليل، أو لأنه وقت خفاء الناس وسكون الأصوات.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"لقيته سحراً وسحرة وبالسحر وفي أعلى السحرين وهما سحر مع الصبح وسحر قبله.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"السحر في قوله تعالى: {وبالأسحار هم يستغفرون} — هو الوقت الأخير من الليل، وهو أشرف الأوقات للدعاء، لأنه وقت غفلة الناس وخلوة القلب.\"\n\n- Root: عرف (ʿArafa)\n  * Lisan / Ayn: \"العرف: الطيب. والمعرفة: العلم بالشيء على وجه التدبر. وعرفة: جبل بمكة، سمي بذلك لأن الناس يتعارفون فيه، أو لأن جبريل عليه السلام عرّف إبراهيم المناسك فيه.\"\n  * Al-Raghib (Mufradat): \"عرفة: اسم للموقف الذي يقف فيه الحجاج، سمي بذلك لأن آدم وحواء تعارفا فيه بعد الهبوط، وقيل: لأن جبريل عرّف إبراهيم المناسك فيه.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"يوم عرفة: اليوم التاسع من ذي الحجة، وهو يوم الموقف.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"عرفة في قولهم: يوم عرفة — اسم للموقف، سمي بذلك لتعارف الناس فيه، أو لتعريف جبريل إبراهيم المناسك.\"\n\n- Root: غفر (Ghafara)\n  * Lisan / Ayn: \"المغفرة: ستر الذنب والتجاوز عنه. والغفر: الستر. والمغفر: ما يستر الرأس في الحرب. والغفور: الكثير المغفرة.\"\n  * Al-Raghib (Mufradat): \"الغفران: ستر الذنب والتجاوز عنه، وأصله من الغفر وهو الستر. قال تعالى: {وإن تغفر لهم فإنك أنت العزيز الحكيم}. والاستغفار: طلب المغفرة، وهو ضربان: استغفار باللسان، واستغفار بالقلب واللسان معاً، وهو النافع.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"غفرت الذنب غفراً ومغفرة: سترته وتجاوزت عنه. واستغفرت الله: طلبت مغفرته.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الاستغفار باللسان مع الإصرار: استعارة للكذب، لأن المستغفر الحقيقي هو التائب المقلع عن الذنب.\"\n\n- Root: صلو (Ṣalā)\n  * Lisan / Ayn: \"الصلاة: الدعاء، وقيل: العبادة، وقيل: الرحمة من الله، والاستغفار من الملائكة. والصلاة من الله: الرحمة، ومن الملائكة: الاستغفار، ومن المؤمنين: الدعاء.\"\n  * Al-Raghib (Mufradat): \"الصلاة في الأصل: الدعاء، قال تعالى: {صلوا عليه وسلموا تسليماً} — أي ادعوا له. ثم غلب استعمالها في العبادة المخصوصة، والصلاة من الله: الرحمة، ومن الملائكة: الاستغفار.\"\n  * Al-Zamakhshari (Asas - Haqiqah/Literal): \"الصلاة: الدعاء. ومنه قوله تعالى: {وصل عليهم إن صلاتك سكن لهم} — أي ادع لهم.\"\n  * Al-Zamakhshari (Asas - Majaz/Metaphorical): \"الصلاة على النبي صلى الله عليه وسلم: استعارة للدعاء له بالرحمة والتعظيم، لأن أصل الصلاة الدعاء.\"\n\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication)\n  * Governing Rule: \"إنما\" تفيد الحصر والقصر، فإذا قيل: \"إن الدعاء هو العبادة\" — فالمبتدأ والخبر معرفتان، والجملة تفيد الحصر والتأكيد. وإذا قيل: \"الدعاء مخ العبادة\" — فالإسناد فيه تشبيه بليغ، حيث شبه الدعاء بالمخ الذي هو لبّ العظم وجوهره، فالدعاء هو اللبّ والجوهر الحقيقي للعبادة.\n\n---\n\n##", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'On Invocations and Supplications'", "badge": "Hadith"}, {"arabic": "بقوله فإني قريب أجيب دعوة الداع إذا دعان والصلاة على محمد سيد أنبيائه وعلى آله وأصحابه خيرة أصفيائه وسلم تسليما كثيرا أما بعد فليس بعد تلاوة كتاب الله عز وجل عبادة تؤدى باللسان أفضل من ذكر الله تعالى ورفع الحاجات بالأدعية الخالصة إلى الله تعالى فلا بد من شرح فضيلة الذكر على الجملة ثم على التفصيل في أعيان الأذكار وشرح فضيلة الدعاء وشروطه وآدابه ونقل المأثور من الدعوات الجامعة لمقاصد الدين والدنيا والدعوات الخاصة لسؤال المغفرة والاستعاذة وغيرها ويتحرر المقصود من ذلك بذكر أبواب خمسة الب", "english": "In the name of God, the Most Merciful, the Ever-Merciful. Praise be to God, whose tender compassion is all-encompassing, whose mercy is universal, who recompensed His servants for their remembrance of Him with His remembrance of them, saying — exalted is He: {«So remember Me; I shall remember you»} (Q 2:152). And He encouraged them toward asking and supplication by His very command, saying: {«Call upon Me; I shall answer you»} (Q 40:60). Thus He gave hope to the obedient and the disobedient, the near and the far, that they might stretch forth toward the presence of His majesty with the raising of their needs and aspirations, by His saying: {«For I am near; I answer the call of the caller when he calls Me»} (Q 2:186). And blessings upon Muhammad, the master of His prophets, and upon his family and companions, the choicest of His elect, with abundant peace.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 234", "section_title_en": "The Book of Remembrances and Supplications — Section 234", "section_index": 234, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Core meaning of remembrance, recollection, and mention by tongue or heart\n  * Al-Raghib (Mufradat): Remembrance (dhikr) is the opposite of forgetfulness (nisyan); it is the heart's presence with that which is remembered, and its noblest form is the heart's presence with God\n  * Al-Zamakhshari (Asas): Literal usage denotes vocal utterance; metaphorical usage denotes the heart's attentive presence\n- Root: دعا (daʿā)\n  * Lisan / Ayn: To call, summon, invoke; to request with humility and earnestness\n  * Al-Raghib (Mufradat): Supplication (duʿā') is the servant's turning to God with request and need, which is itself a form of worship\n  * Al-Zamakhshari (Asas): Literal: to call out; Metaphorical: the heart's turning in humble entreaty to God\n- Root: حمد (ḥamida)\n  * Lisan / Ayn: To praise, commend, extol with gratitude\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with veneration; it is due to God alone in His absolute perfection\n  * Al-Zamakhshari (Asas): Literal: to praise for virtue; Metaphorical: to praise for beneficence received\n- Sibawayh Rule: Rule of Apposition and Inclusivity (al-ʿaṭf wa al-shumūl) — The opening construction joins divine attributes through coordinated apposition, establishing both God's universal mercy and His specific recompense for remembrance", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'On Invocations and Supplications'", "badge": "Dhikr"}], "188": [{"arabic": "وقال تعالى ولا تأكلوا أموالكم بينكم بالباطل وقال تعالى إن الذين يأكلون أموال اليتامى ظلما الآية وقال تعالى يا أيها الذين آمنوا اتقوا الله وذروا ما بقي من الربا إن كنتم مؤمنين {ثم قال} فإن لم تفعلوا فأذنوا بحرب من الله ورسوله {ثم قال} وإن تبتم فلكم رءوس أموالكم {ثم قال} ومن عاد فأولئك أصحاب النار هم فيها خالدون جعل آكل الربا أول الأمر مؤذنا بمحاربة الله وفي آخره متعرضا للنار والآيات الواردة في الحلال والحرام لا تحصى وروى ابن مسعود رضي الله عنه عن النبي صلى الله عليه وسلم أنه قال طلب الحلال", "english": "God Most High has said: {«كلوا من الطيبات واعملوا صالحا»} — \"Eat of the good things and do righteous deeds.\" (Q. 23:51) He commanded eating from the good things before [commanding] righteous deeds. And it is said that what is meant by \"the good things\" is the lawful (al-ḥalāl).", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 336", "section_title_en": "The Revival of the Religious Sciences — Book of the Etiquette of Eating: Section 336 — The Virtue of Lawful Sustenance and the Blameworthiness of the Forbidden", "section_index": 336, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core root meaning of eating, consuming, and tasting food; the act of taking nourishment into the body.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of food; used metaphorically for fire consuming wood, and extended to mean lawful provision (ḥalāl) as the sustenance of the soul's soundness.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical ingestion; metaphorical (majāz) for consuming wealth unlawfully, as in \"أكل مال اليتيم\" (devouring the orphan's wealth).\n- Root: طعم (tuʿm)\n  * Lisan / Ayn: Food, sustenance, and the act of tasting; also used for bait and that which is eaten.\n  * Al-Raghib (Mufradat): Sustenance as that which nourishes the body; in the Kalam context, the lawful (ḥalāl) is that which purifies the heart, while the forbidden (ḥarām) corrupts it.\n  * Al-Zamakhshari (Asas): Literal for food; metaphorical for the moral state of the soul — \"طعمه حرام\" (his food is forbidden) signifies the corruption of one's entire being.\n- Root: ورق (waraʿ)\n  * Lisan / Ayn: Abstinence, scrupulousness, and piety; refraining from doubtful matters.\n  * Al-Raghib (Mufradat): The theological virtue of cautious avoidance of all that is suspect, as the foundation of true worship and the key to answered supplication.\n  * Al-Zamakhshari (Asas): Literal for refraining; metaphorical for the heart's purity achieved through guarding the limbs from the unlawful.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure of conditional and consequential clauses, where the protasis (e.g., \"من أكل حراما\") governs the apodosis (\"لم يقبل منه صرف ولا عدل\"), demonstrating the causal nexus between action and divine recompense.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'The Lawful and Prohibited'", "badge": "Insight"}], "189": [{"arabic": "فقال وما هي فقال قد قال تعالى ولا تجسسوا وقد تجسست وقال تعالى وأتوا البيوت من أبوابها وقد تسورت من السطح وقال لا تدخلوا بيوتا غير بيوتكم حتى تستأنسوا وتسلموا على أهلها وما سلمت فتركه عمر وشرط عليه التوبة ولذلك شاور عمر الصحابة رضي الله عنهم وهو على المنبر وسألهم عن الإمام إذا شاهد بنفسه منكرا فهل له إقامة الحد فيه فأشار علي رضي الله عنه بأن ذلك منوط بعدلين فلا يكفي فيه واحد وقد أوردنا هذه الأخبار في بيان حق المسلم من كتاب آداب الصحبة فلا نعيدها فإن قلت فما حد الظهور والاستتار فاعلم أن من أغلق باب داره وتستر بحيطانه فلا يجوز الدخو", "english": "The Book of the Etiquettes of Companionship. And likewise, it is narrated that ʿUmar, may God be pleased with him, climbed onto the roof of a man's house and saw him in a reprehensible state, so he rebuked him. The man said: \"O Commander of the Believers, if I have disobeyed God in one respect, you have disobeyed Him in three respects.\" ʿUmar said: \"And what are they?\" He said: \"God, exalted is He, has said: {وَلَا تَجَسَّسُوا} ('And do not spy.') [Q. 49:12] — and you have spied. And He has said: {وَأْتُوا الْبُيُوتَ مِنْ أَبْوَابِهَا} ('And enter houses from their doors.') [Q. 2:189] — and you have climbed over from the roof. And He has said: {لَا تَدْخُلُوا بُيُوتًا غَيْرَ بُيُوتِكُمْ حَتَّىٰ تَسْتَأْنِسُوا وَتُسَلِّمُوا عَلَىٰ أَهْلِهَا} ('Do not enter houses other than your own until you have sought permission and greeted their inhabitants.') [Q. 24:27] — and you did not greet.\" So ʿUmar left him, but stipulated upon him repentance.", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 535", "section_title_en": "The Book of the Etiquettes of Companionship — Section 535: On the Limits of Openness (Ẓuhūr) and Concealment (Istitār) in Enjoining Good and Forbidding Evil", "section_index": 535, "anchors": "- Root: ظهر (ẓ-h-r)\n  * Lisan / Ayn: Core meaning is \"to become visible, apparent, or manifest\"; the opposite of concealment (khabā').\n  * Al-Raghib (Mufradat): In theological discourse, ẓuhūr denotes the state of a matter becoming perceptible or known through sensory or evidentiary means, moving it from the realm of the hidden (ghayb) to the witnessed (shahādah).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to physical visibility (e.g., \"ظهر على السطح\" — he appeared on the roof). Metaphorical (majāz) usage extends to intellectual or auditory manifestation, as in \"ظهرت الحجة\" (the proof became manifest). Here, it is applied to sounds and smells that \"emerge\" beyond physical barriers.\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Core meaning is \"to cover, conceal, or screen\" something from perception.\n  * Al-Raghib (Mufradat): Al-Sitr is the covering of a thing; al-istitār is self-concealment. In the Kalam context, God's attribute of al-Sattār (the Concealer) establishes the normative principle of covering faults.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is physical covering (e.g., \"استترت بالثوب\" — she covered herself with a garment). Metaphorical (majāz) usage is the concealment of moral faults, as in \"هتك الله سترك\" (God exposed your secrets). The text navigates between these: physical concealment (walls, sleeves) and the moral obligation to respect it unless a clear sign (amārah) indicates a public violation.\n- Root: حسب (ḥ-s-b)\n  * Lisan / Ayn: Core meaning is \"to count, reckon, or calculate.\"\n  * Al-Raghib (Mufradat): Al-Ḥisbah is the act of seeking reward (iḥtisāb) from God by performing a commanded act. Technically, it becomes the institution of enjoining good and forbidding evil.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is arithmetic reckoning. Metaphorical (majāz) usage is \"to reckon or consider\" a matter as sufficient or binding, as in \"احْتَسَبَ عَلَيْهِ\" (he acted against him by way of correction). The text uses \"الحسبة\" (al-ḥisbah) as the technical term for this institutional duty.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication). The phrase \"فَإِنَّمَا يُدْرَكُ مَعَ تَخَلُّلِ الْحِيطَانِ صَوْتٌ أَوْ رَائِحَةٌ\" (For it is only perceived through the interpenetration of walls as a sound or a smell) uses innamā to restrict the means of legitimate perception to sensory evidence that breaches the barrier of concealment, thereby specifying the legal trigger for intervention.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Enjoining Good and Forbidding Evil'", "badge": "Insight"}, {"arabic": "تجسسوا} وقد تجسست وقال الله تعالى {وليس البر بأن تأتوا البيوت من ظهورها} وقد تسورت علي وقد قال الله تعالى {لا تدخلوا بيوتا غير بيوتكم} الآية وقد دخلت بيتي بغير إذن ولا سلام فقال عمر رضي الله عنه هل عندك من خير إن عفوت عنك قال نعم والله يا أمير المؤمنين لئن عفوت عني لا أعود إلى مثلها أبدا فعفا عنه وخرج وتركه وقال رجل لعبد الله بن عمر يا أبا عبد الرحمن كيف سمعت رسول الله صلى الله عليه وسلم يقول في النجوى يوم القيامة قال سمعته يقول إن الله ليدني منه المؤمن فيضع عليه كنفه ويستره من الناس فيقول أتعرف ذنب كذا أتعرف ذنب كذا فيقول نعم يارب حت", "english": "**First**: That you greet him with peace (*salām*) when you meet him, and respond to his invitation when he invites you, and say \"may Allah have mercy on you\" (*tashmīt*) when he sneezes, and visit him when he is ill, and attend his funeral procession when he dies, and fulfill his oath when he swears by you, and give him sincere counsel when he seeks your advice, and protect him in his absence when he is away from you, and love for him what you love for yourself, and dislike for him what you dislike for yourself. (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 433", "section_title_en": "The Rights of Brotherhood — Section 433: The Duties of a Muslim Toward His Fellow Muslims", "section_index": 433, "anchors": "- Root: سلم (s-l-m)\n  * Lisan / Ayn: Core meaning of safety, security, freedom from harm; the root from which *islām* (submission/surrender) and *salām* (peace) derive\n  * Al-Raghib (Mufradat): *Salām* as the theological state of being secure from harm — both giving and receiving safety; *islām* as the total surrender of the heart to Allah\n  * Al-Zamakhshari (Asas): Literal (*ḥaqīqah*): physical safety from tongue and hand; Metaphorical (*majāz*): the comprehensive spiritual safety that defines true Muslim brotherhood\n- Root: عون (ʿ-w-n)\n  * Lisan / Ayn: Assistance, aid, helping another in need\n  * Al-Raghib (Mufradat): Mutual assistance as a divine ordinance among believers\n  * Al-Zamakhshari (Asas): Literal: physical aid; Metaphorical: intercession (*shafāʿah*) and advocacy on behalf of others\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: Covering, concealing, veiling; protection from exposure\n  * Al-Raghib (Mufradat): *Sitr* as the divine attribute of concealment — Allah's covering of sins in this world and the next\n  * Al-Zamakhshari (Asas): Literal: covering a physical defect; Metaphorical: concealing another's faults and sins — a cardinal virtue of brotherhood\n- Root: عذر (ʿ-dh-r)\n  * Lisan / Ayn: Excuse, pardon, acceptance of apology\n  * Al-Raghib (Mufradat): *ʿAfw* (pardon) as the higher station of forgiveness that elevates the forgiver\n  * Al-Zamakhshari (Asas): Literal: releasing from obligation; Metaphorical: the noble trait of overlooking others' offenses\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The repeated use of restrictive constructions (e.g., \"المسلم من سلم المسلمون\") establishes definitional boundaries through predicate restriction, indicating that the *ḥaqīqah* of faith is manifested through specific observable actions.\n\n---\n\n##", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Duties of Brotherhood'", "badge": "Ethics"}], "190": [{"arabic": "وسلم فقال نعم إن الله لا يحب المستكبرين فنزل وقعد معهم على الأرض وأكل ثم سلم عليهم وركب وقال قد أجبتكم فأجيبوني قالوا نعم فوعدهم وقتا معلوما فحضروا فقدم إليهم فاخر الطعام وجلس يأكل معهم وأما قول القائل إن من وضعت يدي في قصعته فقد ذلت له رقبتي فقد قال بعضهم هذا خلاف السنة وليس كذلك فإنه ذل إذا كان الداعي لا يفرح بالإجابة ولا يتقلد منة وكان يرى ذلك يدا له على المدعو ورسول الله صلى الله عليه وسلم كان يحضر لعلمه أن الداعي له يتقلد منة ويرى ذلك شرفا وذخرا لنفسه في الدنيا", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Anger and Hatred'", "badge": "Ethics"}], "195": [{"arabic": "فإن قيل فما معنى قوله تعالى ولا تلقوا بأيديكم إلى التهلكة قلنا لا خلاف في أن المسلم الواحد له أن يهجم على صف الكفار ويقاتل وإن علم أنه يقتل وهذا ربما يظن أنه مخالف لموجب الآية وليس كذلك فقد قال ابن عباس رضي الله عنهما ليس التهلكة ذلك بل ترك النفقة في طاعة الله تعالى أي من لم يفعل ذلك فقد أهلك نفسه وقال البراء بن عازب التهلكة هو أن يذنب الذنب ثم يقول لا يتاب علي وقال أبو عبيدة هو أن يذنب ثم لا يعمل بعده خيرا حتى يهلك وإذا جاز أن يقاتل الكفار حتى يقتل جاز أيضا له ذلك في الحسبة ولكن لو علم أنه لا نكاية ل", "english": "Ibn Masʿūd, may God be pleased with him, said: \"Strive against the disbelievers with your hands; and if you are not able, then at least frown in their faces — so do so.\"", "book_title": "Enjoining Good and Forbidding Evil", "section_title_ar": "Section 529", "section_title_en": "The Fifth Condition: That the One Enjoining Good Be Capable (Al-Qādīr)", "section_index": 529, "anchors": "- Root: قدر (q-d-r)\n  * Lisan / Ayn: Capacity, power, measure; the ability to accomplish an act\n  * Al-Raghib (Mufradat): Power as the faculty by which acts proceed from the agent in accordance with will and choice\n  * Al-Zamakhshari (Asas): Literal sense of physical capability vs. extended sense of effective agency\n- Root: عجز (ʿ-j-z)\n  * Lisan / Ayn: Weakness, inability, failure to accomplish\n  * Al-Raghib (Mufradat): The opposite of power; that which renders one incapable of an act\n  * Al-Zamakhshari (Asas): Literal physical incapacity vs. metaphorical extension to feared harm\n- Root: كره (k-r-h)\n  * Lisan / Ayn: That which is disliked, hated, or harmful\n  * Al-Raghib (Mufradat): That which the soul recoils from and finds repugnant\n  * Al-Zamakhshari (Asas): Distinction between disliked things (makrūh) and feared harm\n- Root: هلك (h-l-k)\n  * Lisan / Ayn: Destruction, perdition, ruin\n  * Al-Raghib (Mufradat): Three senses — loss, corruption/ruin, and death; the verse {«ولا تلقوا بأيديكم إلى التهلكة»} concerns casting oneself into ruin\n  * Al-Zamakhshari (Asas): Literal destruction vs. metaphorical self-destruction through heedless action\n- Sibawayh Rule: Conditional and Exceptive Constructions (Bāb al-sharṭ wa-l-istithnāʾ) — governing the logical articulation of conditions, exceptions, and their resultant rulings\n\n---\n\n##", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Enjoining Good and Forbidding Evil'", "badge": "Hadith"}], "196": [{"arabic": "ولزمه دم شاة فإن لم يجد فصيام ثلاثة أيام في الحج قبل يوم النحر متفرقة أو متتابعة وسبعة إذا رجع إلى الوطن وإن لم يصم الثلاثة حتى رجع إلى الوطن صام العشرة تتابعا أو متفرقا وبدل دم القران والتمتع سواء والأفضل الإفراد ثم التمتع ثم القرن وأما محظورات الحج والعمرة فستة الأول اللبس للقميص والسراويل والخف والعمامة بل ينبغي أن يلبس إزارا ورداء ونعلين فإن لم يجد نعلين فمكعبين فإن لم يجد إزارا فسراويل ولا بأس بالمنطقة والاستظلال في المحمل ولكن لا ينبغي أن يغطي رأسه فإن إحرامه في الرأس وللمرأة أن تلبس كل مخيط بعد", "english": "**The Second: Qirān (Combined Pilgrimage)** — which is that one combines, saying: \"Here I am, O God, for a Pilgrimage and an ʿUmrah together,\" thus becoming in a state of iḥrām for both. The rites of the Pilgrimage suffice him, and the ʿUmrah is subsumed under the Pilgrimage, just as the ablution (wuḍūʾ) is subsumed under the full bath (ghusl). However, if he circumambulates and runs before the standing at ʿArafāt, his running is counted for both rites, but his circumambulation is not counted, because the condition of the obligatory circumambulation in the Pilgrimage is that it occur after the standing. Upon the one performing Qirān is due a sheep's blood, unless he is a Meccan, in which case nothing is due upon him, because he has not abandoned his mīqāt, since his mīqāt is Mecca.", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 198", "section_title_en": "The Book of Pilgrimage — Section 198: The Pillars, Obligations, and Modes of Hajj and ʿUmrah, and the Commencement of the Journey's Visible Rites", "section_index": 198, "anchors": "- Root: ح ج ج (Ḥ-J-J)\n  * Lisan / Ayn: The intent (qaṣd) toward a venerated object; the annual pilgrimage to the Sacred House.\n  * Al-Raghib (Mufradat): The religiously legislated intent to visit the Sacred House to perform the rites.\n  * Al-Zamakhshari (Asas): Literal: repairing repeatedly to a place of veneration. Metaphorical: the pilgrim's repeated approach to God through ritual acts.\n- Sibawayh Rule: The conditional clause (al-sharṭ) with its apodosis (jawāb), governing the legal hypotheticals (\"if he does X, then Y is due\").", "content_type": "fiqh", "topic": "Al-Ghazali on the inner and outer dimensions of worship, from 'Mysteries of Hajj'", "badge": "Worship"}, {"arabic": "قاله عمر وعلي وابن مسعود رضي الله عنهم في معنى قوله عز وجل وأتموا الحج والعمرة لله وقال بعض العلماء الركوب أفضل لما فيه من الإنفاق والمؤنة ولأنه أبعد عن ضجر النفس وأقل لأذاه وأقرب إلى سلامته وتمام حجه وهذا عند التحقيق ليس مخالفا للأول بل ينبغي أن يفصل ويقال من سهل عليه المشي فهو أفضل فإن كان يضعف ويؤدي به ذلك إلى سوء الخلق وقصور عن عمل فالركوب له أفضل كما أن الصوم للمسافر أفضل وللمريض ما لم يفض إلى ضعف وسوء خلق وسئل بعض العلماء عن العمرة أيمشي فيها أو يكتري حمارا بدرهم فقال إن كان وزن الدرهم أشد عليه فالكراء أفضل من المشي وإن كان", "english": "For at that point, his intention should be the visitation of the House of God, Mighty and Majestic, and the assistance of his Muslim brother by discharging the obligation from him. And it is concerning the like of this that the saying of the Messenger of God, peace and blessings be upon him, descends: \"God, Glorified be He, will enter three persons into Paradise by means of a single Pilgrimage: the one who bequeathed it, the one who executed it, and the one who performed the Pilgrimage on behalf of his brother.\"", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 213", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 213: The Inward Conditions of the Pilgrimage (Continued)", "section_index": 213, "anchors": "- Root: ن-ف-ق (n-f-q)\n  * Lisan / Ayn: Core meaning of expenditure, spending, and outlay; al-nifāq (hypocrisy) is derived from the same root, as the hypocrite burrows into faith and exits from it — thus expenditure is the outward flow of wealth.\n  * Al-Raghib (Mufradat): Al-Nafaqah is the expenditure by which one seeks the means of nearness to God; it is praised when directed toward obedience and blamed when directed toward disobedience.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): spending wealth. Metaphorical (Majaz): spending of the self and effort in the path of God.\n- Root: ر-ف-ث (r-f-th)\n  * Lisan / Ayn: Al-Rafath: obscene, lewd, and indecent speech; also covers conjugal relations and their preliminaries.\n  * Al-Raghib (Mufradat): In the Quranic context of pilgrimage, al-rafath is the comprehensive term for all that excites sexual desire and leads to what is forbidden during iḥrām.\n  * Al-Zamakhshari (Asas): Literal: lewdness in speech. Metaphorical: any discourse that stirs the appetite toward the forbidden.\n- Root: ج-د-ل (j-d-l)\n  * Lisan / Ayn: Al-Jidāl: intense disputation and argumentation; the root denotes the twisting and plaiting of ropes — thus the twisting of truth through contention.\n  * Al-Raghib (Mufradat): Al-Jidāl is the disputation that seeks to overcome the opponent; it is blameworthy when it proceeds from obstinacy and produces rancor.\n  * Al-Zamakhshari (Asas): Literal: the braiding of strands. Metaphorical: the interweaving of arguments in contentious debate.\n- Root: ش-ع-ث (sh-ʿ-th)\n  * Lisan / Ayn: Al-Shaʿath: dishevelment, dustiness, and the neglect of personal grooming; the state of one whose hair is disordered and whose appearance is unkempt.\n  * Al-Raghib (Mufradat): The Prophet's command to appear disheveled and dusty (al-shaʿath wa al-ightibār) in pilgrimage is a mark of humility and the abandonment of worldly adornment.\n  * Al-Zamakhshari (Asas): Literal: physical dishevelment. Metaphorical: the outward sign of inward humility and the renunciation of pomp.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The separation of the prepositional phrase from its governing verb is permissible when the intervening element is semantically complete, as in the construction \"فإن تسليم المال إليهم إعانة على الظلم\" where the prepositional phrase \"إليهم\" is interposed between the verbal noun and its complement for rhetorical emphasis.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Hajj'", "badge": "Insight"}], "197": [{"arabic": "بأحسن ما بحضرتكم من النقلة وتزودوا فإن خير الزاد التقوى إنما الدنيا كفىء ظلال قلص فذهب بينا ابن آدم في الدنيا ينافس وهو قدير العين إذ دعاه الله بقدره ورماه بيوم حتفه فسلبه آثاره ودنياه وصير لقوم آخرين مصانعه ومغناه إن الدنيا لا تسر بقدر ما تضر إنها تسر قليلا وتحزن طويلا وعن أبي بكر الصديق رضي الله تعالى عنه إنه كان يقول في خطبته أين الوضاء الحسنة وجوههم المعجبون بشبابهم أين الملوك الذين بنوا المدائن وحصنوها بالحيطان أين الذين كانوا يعطون الغلبة في مواطن الحرب قد تضعضع بهم الدهر فأصبحوا في ظلمات القبور", "english": "It is narrated that a man said: \"He has cast off the means (al-ashāb) and parted from the beloved ones and confronted the reckoning.\" And by God, I utter this my saying, and I know not that any of you has more sins than what I know of myself. But these are just ordinances from God, equitable; therein I command His obedience and forbid His disobedience. I seek God's forgiveness.\" And he placed his sleeve over his face and began to weep until his tears wetted his beard, and he did not return to his gathering until he died.", "book_title": "Remembrance of Death and Afterlife", "section_title_ar": "Section 1287", "section_title_en": "The Virtue of Shortening Hope (Faḍīlat Qaṣr al-Amal) and the Explanation of the Cause of Long Hope and Its Remedy", "section_index": 1287, "anchors": "- Root: أمل (amal)\n  * Lisan / Ayn: Core meaning of \"hope\" or \"expectation,\" often extended to \"aspiration\" or \"wish\" for future outcomes.\n  * Al-Raghib (Mufradat): In theological terms, al-amal denotes the soul's inclination toward future possibilities, which, when excessive (ṭūl al-amal), becomes a blameworthy attachment to worldly continuance, distracting from death and the afterlife.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage refers to genuine expectation; metaphorical (majāz) usage applies to vain fancies (amānī) that deceive the self into postponing repentance.\n- Root: قصر (qaṣr)\n  * Lisan / Ayn: To shorten, confine, or restrict; opposite of prolonging.\n  * Al-Raghib (Mufradat): Qaṣr al-amal is the virtuous discipline of limiting one's worldly expectations, aligning the soul with the reality of death's proximity.\n  * Al-Zamakhshari (Asas): Distinguishes literal shortening (of time or distance) from metaphorical restraint (of the heart's attachments).\n- Root: سبب (sabab)\n  * Lisan / Ayn: A cord or means by which one reaches something; extended to any cause or linkage.\n  * Al-Raghib (Mufradat): Every means (sabab) leading to a goal; here, the causes of ṭūl al-amal are identified as ignorance (jahl) and love of the world (ḥubb al-dunyā).\n  * Al-Zamakhshari (Asas): Literal: a physical rope; metaphorical: any instrumental cause, as in the chain of worldly preoccupations.\n- Root: دنو (dunūw)\n  * Lisan / Ayn: Proximity, nearness in place, time, or rank.\n  * Al-Raghib (Mufradat): Al-dunūw is nearness by essence or by judgment; used for spatial, temporal, and status proximity—here, the nearness of death (qurb al-mawt) that the heedless ignore.\n  * Al-Zamakhshari (Asas): Literal: physical closeness; metaphorical: the inescapable imminence of what is to come (kull mā huwa ātin qarīb).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used to confine predicates to specific subjects, e.g., \"إنما الدنيا كفىء ظلال\" (The world is but the shade of a passing cloud), emphasizing exclusivity of meaning.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Remembrance of Death and Afterlife'", "badge": "Hadith"}], "198": [{"arabic": "كثيرا وقال تعالى فإذا أفضتم من عرفات فاذكروا الله عند المشعر الحرام واذكروه كما هداكم وقال عز وجل فإذا قضيتم مناسككم فاذكروا الله كذكركم آباءكم أو أشد ذكرا وقال تعالى الذين يذكرون الله قياما وقعودا وعلى جنوبهم وقال تعالى فإذا قضيتم الصلاة فاذكروا الله قياما وقعودا وعلى جنوبكم قال ابن عباس رضي الله عنهما أي بالليل والنهار في البر والبحر والسفر والحضر والغنى والفقر والمرض والصحة والسر والعلانية وقال تعالى في ذم المنافقين ولا يذكرون الله إلا قليلا وقال عز وجل واذكر ربك في نفسك تضرعا وخيفة ودون الجهر من القول بالغدو والآصال ولا تكن", "english": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Core meaning is \"to remember, to mention, to recollect.\" The root carries the dual sense of mental recollection and verbal utterance. In Kitab al-Ayn, the root denotes the opposite of forgetfulness (nisyan), and its verbal form encompasses both the internal act of remembrance and the external act of mentioning.\n  * Al-Raghib (Mufradat): \"الذكر: حضور المعنى في النفس، وقد يطلق على إبقاء المعنى باللسان. والذكر ضربان: ذكر بالقلب، وذكر باللسان. وقال تعالى: {فاذكروني أذكركم} [البقرة/152] — فذكر العبد ربه بالتعظيم والثناء، وذكر الله عبده بالإنعام والإكرام.\" The theological nuance distinguishes between the creature's remembrance (which is petition and praise) and the Creator's remembrance (which is response and reward).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ذكرت الشيء: حفظته ووعيته. وذكرت فلانا: جريت بذكره على لسانك.\" Metaphorical (Majaz): \"ذكر الله العبد: أثنى عليه وأجزل له الثواب. ومن المجاز: قوله تعالى {ولذكر الله أكبر} — أي ذكر الله إياكم أعظم من ذكركم إياه.\" The rhetorical distinction is crucial here: when Allah \"remembers\" His servant, it is an act of grace, not cognition.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — In the verse {ولذكر الله أكبر}, the grammatical structure allows for the subject (ذكر الله) to be read as either the creature's remembrance of Allah or Allah's remembrance of the creature, with the predicate (أكبر) applying to whichever reading is adopted. This syntactic ambiguity is deliberate and productive of multiple valid interpretations.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 235", "section_title_en": "Section 235", "section_index": 235, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'On Invocations and Supplications'", "badge": "Insight"}, {"arabic": "وقال تعالى ليس عليكم جناح أن تبتغوا فضلا من ربكم وقال تعالى وآخرون يضربون في الأرض يبتغون من فضل الله وقال تعالى فانتشروا في الأرض وابتغوا من فضل الله وأما الأخبار فقد قال صلى الله عليه وسلم من الذنوب ذنوب لا يكفرها إلا الهم في طلب المعيشة (1) وقال صلى الله عليه وسلم التاجر الصدوق يحشر يوم القيامة مع الصديقين والشهداء (2) وقال صلى الله عليه وسلم من طلب الدنيا حلالا وتعففا عن المسئلة وسعيا على عياله وتعطفا على جاره لقي الله ووجهه كالقمر ليلة البدر (3) وكان صلى الله عليه وسلم جالسا مع أصحا", "english": "As for what is [cited] from the Book [i.e., the Qur'an], there is His saying, the Exalted: «{وَجَعَلْنَا النَّهَارَ مَعَاشًا}» (\"And We have made the day a means of livelihood\" [al-Naba' 78:11]) — and He mentioned it in the context of bestowing favor (imtinān).", "book_title": "Etiquette of Earning", "section_title_ar": "Section 312", "section_title_en": "Section 312", "section_index": 312, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Etiquette of Earning'", "badge": "Afterlife"}], "200": [{"arabic": "واذكروه كما هداكم وقال عز وجل فإذا قضيتم مناسككم فاذكروا الله كذكركم آباءكم أو أشد ذكرا وقال تعالى الذين يذكرون الله قياما وقعودا وعلى جنوبهم وقال تعالى فإذا قضيتم الصلاة فاذكروا الله قياما وقعودا وعلى جنوبكم قال ابن عباس رضي الله عنهما أي بالليل والنهار في البر والبحر والسفر والحضر والغنى والفقر والمرض والصحة والسر والعلانية وقال تعالى في ذم المنافقين ولا يذكرون الله إلا قليلا وقال عز وجل واذكر ربك في نفسك تضرعا وخيفة ودون الجهر من القول بالغدو والآصال ولا تكن من الغافلين وقال تعالى ولذكر الله أكبر قال ابن عباس رضي الله عنهما ل", "english": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Core meaning is \"to remember, to mention, to recollect.\" The root carries the dual sense of mental recollection and verbal utterance. In Kitab al-Ayn, the root denotes the opposite of forgetfulness (nisyan), and its verbal form encompasses both the internal act of remembrance and the external act of mentioning.\n  * Al-Raghib (Mufradat): \"الذكر: حضور المعنى في النفس، وقد يطلق على إبقاء المعنى باللسان. والذكر ضربان: ذكر بالقلب، وذكر باللسان. وقال تعالى: {فاذكروني أذكركم} [البقرة/152] — فذكر العبد ربه بالتعظيم والثناء، وذكر الله عبده بالإنعام والإكرام.\" The theological nuance distinguishes between the creature's remembrance (which is petition and praise) and the Creator's remembrance (which is response and reward).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"ذكرت الشيء: حفظته ووعيته. وذكرت فلانا: جريت بذكره على لسانك.\" Metaphorical (Majaz): \"ذكر الله العبد: أثنى عليه وأجزل له الثواب. ومن المجاز: قوله تعالى {ولذكر الله أكبر} — أي ذكر الله إياكم أعظم من ذكركم إياه.\" The rhetorical distinction is crucial here: when Allah \"remembers\" His servant, it is an act of grace, not cognition.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — In the verse {ولذكر الله أكبر}, the grammatical structure allows for the subject (ذكر الله) to be read as either the creature's remembrance of Allah or Allah's remembrance of the creature, with the predicate (أكبر) applying to whichever reading is adopted. This syntactic ambiguity is deliberate and productive of multiple valid interpretations.", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 235", "section_title_en": "Section 235", "section_index": 235, "anchors": "*(Anchors established)*", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'On Invocations and Supplications'", "badge": "Dhikr"}, {"arabic": "لا فيما يظهر في الدنيا مما لا بقاء له ولعمري هذا الخطر مشترك بين المتكبر والمتكبر عليه ولكن حق على كل واحد أن يكون مصروف الهمة إلى نفسه مشغول القلب بخوفه لعاقبته لا أن يشتغل بخوف غيره فإن الشفيق بسوء الظن مولع وشفقه كل إنسان على نفسه فإذا حبس جماعة في جناية ووعدوا بأن تضرب رقابهم لم يتفرغوا لتكبر بعضهم على بعض وإن عمهم الخطر إذ شغل كل واحد نفسه عن الالتفات إلى هم غيره حتى كأن كل واحد هو وحده في مصيبته وخطره فإن قلت فكيف أبغض المبتدع في الله وأبغض الفاسق وقد أمرت ببغضهما ثم", "english": "The second matter: the scholar knows that pride befits none but God Almighty and Majestic alone, and that if he becomes proud, he becomes an object of God's wrath and abhorrence. God has loved from him that he humble himself, and has said to him: \"You have standing with Me so long as you do not claim standing for yourself; but if you see standing for yourself, then you have no standing with Me.\" Thus he must inevitably impose upon himself that which his Master loves from him — and this removes arrogance from his heart, even if he were certain, for example, that he has no sin, or had imagined such a thing.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 869", "section_title_en": "On the Eradication of Pride and the Cultivation of Humility — Section 869", "section_index": 869, "anchors": "- Root: كسر (kasara)\n  * Lisan / Ayn: To break, shatter, fracture; the breaking of a thing's integrity or resistance.\n  * Al-Raghib (Mufradat): انكسار النفس (the breaking of the self) denotes the crushing of egocentric haughtiness, a spiritual state wherein the soul's pretension to autonomy is shattered before divine majesty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) for physical breaking; metaphorical (Majaz) for the humbling of the proud heart — \"انكسرت نفسه\" as the soul's collapse from its vaunted station.\n- Root: خطر (khatara)\n  * Lisan / Ayn: To pass through the mind (خطر بباله); also peril, grave risk, momentous consequence.\n  * Al-Raghib (Mufradat): الخطر denotes the weighty stake or standing; in eschatological context, the ultimate peril of one's final end (خاتمة) — the decisive outcome that determines rank before God.\n  * Al-Zamakhshari (Asas): Literal for a thought crossing the mind; metaphorical for the magnitude of a matter's consequence — \"الخطر العظيم\" as the immense stakes of salvation or perdition.\n- Root: ختم (khatama)\n  * Lisan / Ayn: To seal, stamp, conclude; the final impression that fixes a thing's end.\n  * Al-Raghib (Mufradat): الخاتمة — the sealing of one's life-course; in Kalam, the terminal state (khatimah) that alone determines felicity (sa'adah) or misery (shaqawah), utterly hidden from creatures.\n  * Al-Zamakhshari (Asas): Literal for sealing a document; metaphorical for God's conclusive decree over a human's ultimate destiny.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — Constructions like \"إنما يمكن بالتفكر\" and \"لا ينظر العاقل إلا إلى العاقبة\" restrict the predicate exclusively to one term, emphasizing that humility is attainable solely through contemplation of the final end, and that the intelligent man looks only to the outcome.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "201": [{"arabic": "ربنا آتنا من لدنك رحمة وهيئ لنا من أمرنا رشدا ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ربنا إننا سمعنا مناديا ينادي للإيمان إلى قوله عز وجل إنك لا تخلف الميعاد ربنا لا تؤاخذنا إن نسينا أو أخطأنا ربنا إلى آخر السورة (3) رب اغفر لي ولوالدي وارحمهما كما ربياني صغيرا واغفر للمؤمنين والمؤمنات والمسلمين والمسلمات الأحياء منهم والأموات (4) رب اغفر وارحم وتجاوز عما تعلم وأنت الأعز الأكرم وأنت خير الراحمين وأنت خير الغافرين وإنا لله وإنا إليه راجعون ولا حول ولا قوة إلا بالله العلي العظيم وحسبنا الله ونعم الوكيل وصلى الله على محمد خاتم النب", "english": "And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 252", "section_title_en": "Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)", "section_index": 252, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "الأعز الأكرم اللهم آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا عذاب النار ويمشي على هينة حتى ينتهي إلى الميل الأخضر وهو أول ما يلقاه إذا نزل من الصفا وهو على زاوية المسجد الحرام فإذا بقي بينه وبين محاذاة الميل ستة أذرع أخذ في السير السريع وهو الرمل حتى ينتهي إلى الميلين الأخضرين ثم يعود إلى الهينة فإذا انتهى إلى المروة صعدها كما صعد الصفا وأقبل بوجهه على الصفا ودعا بمثل ذلك الدعاء وقد حصل السعي مرة واحدة فإذا عاد إلى الصفا حصلت مرتان يفعل ذلك سبعا ويرمل في موضع الرمل في كل مرة ويسكن في موضع السكون كما سبق وفي كل نوب", "english": "Upon ascending al-Ṣafā, he should face the House (al-Bayt) and say: \"God is Greater, God is Greater. Praise be to God for what He has guided us to. Praise be to God with all His praises, for all His graces, all of them. There is no god but God alone, with no partner. His is the dominion, and His is the praise. He gives life and causes death; in His hand is all good, and He is over all things competent. There is no god but God alone; He fulfilled His promise, aided His servant, and honored His soldiers; He alone defeated the confederates. There is no god but God, devoting religion sincerely to Him, even if the disbelievers detest it. There is no god but God, devoting religion sincerely to Him. Praise be to God, Lord of the worlds. So exalted is God when you reach the evening and when you reach the morning. And His is the praise in the heavens and the earth, and at nightfall and when you are at noon. He brings forth the living from the dead and brings forth the dead from the living, and He revives the earth after its death, and thus shall you be brought forth. And of His signs is that He created you from dust; then, behold, you are humans spreading out. O God, I ask You for enduring faith, sincere certainty, beneficial knowledge, a humble heart, and a tongue that remembers You. And I ask You for pardon, well-being, and perpetual immunity in this world and the Hereafter.\" Then he sends blessings upon Muḥammad, may God bless him and grant him peace, and supplicates God, Mighty and Majestic, with whatever need he wishes, following this supplication.", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 204", "section_title_en": "The Yemeni Corner and the Stone — The Beginning of the Saʿy and Its Rites", "section_index": 204, "anchors": "- Root: سعي (Saʿy)\n  * Lisan / Ayn: The root denotes striving, running, or rapid walking; it is the exertion of effort in a matter, whether good or evil.\n  * Al-Raghib (Mufradat): \"السعي: المشي السريع، وهو دون العدو، ويستعمل للجد في الأمر\" — Saʿy is swift walking, less than running, and is used for earnest exertion in a matter. In the sacred rite, it signifies the ritual traversing between al-Ṣafā and al-Marwah, an act of devotional striving.\n  * Al-Zamakhshari (Asas): Literal (Ḥaqīqah): \"سعى إلى المسجد\" — physical exertion toward a goal. Metaphorical (Majāz): \"هو يسعى على عياله\" — he strives to provide for his family. In the ritual context, the physical traversing is the literal embodiment of devotional striving.\n- Root: حمد (Ḥamd)\n  * Lisan / Ayn: The root denotes praise, commendation, and the acknowledgment of beneficence; it is the opposite of blame (dhamm).\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence with reverence and love, and it is due to God alone in His absolute perfection.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — praising God with all His praises. Metaphorical: \"أحمدت صنيعه\" — I approved of his deed. In the supplications of the saʿy, the pilgrim's praise is both literal acknowledgment and the metaphorical \"approval\" of God's decree.\n- Root: رمل (Raml)\n  * Lisan / Ayn: The root denotes rapid walking with a slight trotting motion, a form of hastening in movement.\n  * Al-Raghib (Mufradat): Not a primary theological term, but in ritual context it signifies the prescribed hastening between the two green markers, emulating the Prophet's action.\n  * Al-Zamakhshari (Asas): Literal: physical hastening. Metaphorical: The rapid pace is a visible emblem of spiritual earnestness and the rejection of the polytheists' claim that the Muslims were weakened by fever.\n- Sibawayh Rule: Rule of Restriction and Specification (al-Ḥaṣr wa al-Taqyīd) — The phrase \"وإنما ذلك شرط في طواف الركن\" employs restriction to delimit a condition exclusively to the circumambulation of the pillar (ṭawāf al-rukn), thereby negating its applicability to the saʿy.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Mysteries of Hajj'", "badge": "Afterlife"}, {"arabic": "الخزي في الدنيا والآخرة ويقول بين الركن اليماني والحجر الأسود اللهم ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة وقنا برحمتك فتنة القبر وعذاب النار فإذا بلغ الحجر الأسود قال اللهم اغفر لي برحمتك أعوذ برب هذا الحجر من الدين والفقر وضيق الصدر وعذاب القبر وعند ذلك قد تم شوط واحد فيطوف كذلك سبعة أشواط فيدعو بهذه الأدعية في كل شوط الرابع أن يرمل في ثلاثة أشواط ويمشي في الأربعة الأخر", "english": "**The first:** that he observes the conditions of prayer (shurūṭ al-ṣalāh), namely: purification from ritual impurity (ṭahārat al-ḥadath) and from filth (al-khabath) in the garment, the body, and the place, and the covering of the nakedness (satr al-ʿawrah). For the circumambulation of the House is a prayer, but Allah Most High has permitted speech within it. And he should perform the iḍṭibāʿ (exposing the right shoulder) before beginning the circumambulation — which is to place the middle of his cloak (ridāʾ) under his right armpit and gather its two ends upon his left shoulder, letting one end hang behind his back and the other upon his chest. And he should cease the talbiyah (proclamation of \"Labbayk\") at the beginning of the circumambulation and occupy himself with the supplications (adʿiyah) which we shall mention.", "book_title": "Mysteries of Hajj", "section_title_ar": "Section 202", "section_title_en": "The Fourth Section on the Circumambulation (al-Ṭawāf)", "section_index": 202, "anchors": "- Root: طوف (ṭ-w-f)\n  * Lisan / Ayn: \"طاف بالشيء يطوف طوفا وطوافا: دار به. والطواف بالبيت عبادة.\"\n  * Al-Raghib (Mufradat): \"الطواف: الدوران حول الشيء، وخص في الشرع بالدوران حول البيت الحرام تعظيما له.\"\n  * Al-Zamakhshari (Asas): Literal: \"طاف بالبيت يطوف طوافا: دار حوله.\" Metaphorical: \"طاف الخيال: ألمّ بالخاطر.\"\n- Root: ضبع (ḍ-b-ʿ)\n  * Lisan / Ayn: \"الاضطباع: أن يدخل الرجل رداءه تحت إبطه الأيمن ويلقيه على منكبه الأيسر.\"\n  * Al-Raghib (Mufradat): \"الضبع: العضد، ومنه الاضطباع في الطواف وهو إبداء العضد.\"\n  * Al-Zamakhshari (Asas): Literal: \"اضطبع الرجل: أبدى عضده.\" Metaphorical: \"اضطبع في الأمر: تشمر له.\"\n- Root: رمل (r-m-l)\n  * Lisan / Ayn: \"الرمل في المشي: سرعة المشي مع تقارب الخطى. والرمل في الطواف: سنة.\"\n  * Al-Raghib (Mufradat): \"الرمل: الهرولة في الطواف، وهو من سنن الحج.\"\n  * Al-Zamakhshari (Asas): Literal: \"رمل في مشيه: أسرع.\" Metaphorical: \"رمل الحديث: زخرفه.\"\n- Root: حجر (ḥ-j-r)\n  * Lisan / Ayn: \"الحجر الأسود: حجر في الركن من البيت الحرام، يستلمه الطائف.\"\n  * Al-Raghib (Mufradat): \"الحجر: الجوهر الصلب المعروف، والحجر الأسود أشرف الأحجار.\"\n  * Al-Zamakhshari (Asas): Literal: \"الحجر الأسود: الحجر المعروف في الكعبة.\" Metaphorical: \"رمي فلان بحجره: قرن بمثله.\"\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the placement of prepositional phrases and their objects, ensuring grammatical coherence in complex ritual descriptions.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Hajj'", "badge": "Du'a"}, {"arabic": "وقال الحسن في قوله تعالى {ربنا آتنا في الدنيا حسنة وفي الآخرة حسنة} إن الحسنة في الدنيا هي العلم والعبادة وفي الآخرة هي الجنة وقيل لبعض الحكماء أي الأشياء تقتنى قال الأشياء التي إذا غرقت سفينتك سبحت معك يعني العلم وقيل أراد بغرق السفينة هلاك بدنه بالموت وقال بعضهم من اتخذ الحكمة لجاما اتخذه الناس إماما ومن عرف بالحكمة لاحظته العيون بالوقار وقال الشافعي رحمة الله عليه من شرف العلم أن كل من نسب إليه ولو في شيء حقير فرح ومن رفع عنه حزن وقال عمر رضي الله عنه يا أيها الناس عليكم بالعلم فإن لله سبحانه رداء يحبه فمن طل", "english": "And al-Ḥasan, may God have mercy on him, said: \"The ink of the scholars will be weighed against the blood of the martyrs, and the ink of the scholars will outweigh the blood of the martyrs.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 6", "section_title_en": "The Book of Knowledge — Section 6: On the Virtue of Teaching and Learning (Continued)", "section_index": 6, "anchors": "- Root: شغل (sh-gh-l)\n  * Lisan / Ayn: Occupation, preoccupation, that which engages one entirely\n  * Al-Raghib (Mufradat): Preoccupation that veils one from perception of other things\n  * Al-Zamakhshari (Asas): Literal — physical occupation; Metaphorical — absorption of the heart that blinds the senses\n- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: Beauty, goodness, excellence\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه\" — that which is pleasing and desirable, of three kinds: rational, appetitive, sensory\n  * Al-Zamakhshari (Asas): Literal — beauty of form; Metaphorical — the ḥasanah in the Qur'anic supplication denotes knowledge and worship\n- Root: علم (ʿ-l-m) — [Note: recently used, but required by text; applied per governing rule]\n  * Lisan / Ayn: Knowledge, perception, cognition\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing in its true reality\n  * Al-Zamakhshari (Asas): Literal — direct perception; Metaphorical — knowledge as a garment of honor from God\n- Root: موت (m-w-t)\n  * Lisan / Ayn: Death, cessation of life\n  * Al-Raghib (Mufradat): Death as the lifting of the burdens of this world; awakening from the sleep of heedlessness\n  * Al-Zamakhshari (Asas): Literal — physical death; Metaphorical — \"الناس نيام فإذا ماتوا انتبهوا\" (people are asleep; when they die, they awaken)\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — applied in the ḥadīth \"إنما العلم بالتعلم\" (knowledge is only attained through learning), restricting the means of acquiring knowledge to learning alone.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Patience and Gratitude'", "badge": "Afterlife"}], "204": [{"arabic": "{ومن الناس من يعجبك قوله في الحياة الدنيا ويشهد الله على ما في قلبه وهو ألد الخصام وإذا تولى سعى في الأرض ليفسد فيها} الآية وقال تعالى {وإذا لقوكم قالوا آمنا وإذا خلوا عضوا عليكم الأنامل من الغيظ} وقال تعالى {يراؤون الناس ولا يذكرون الله إلا قليلا مذبذبين بين ذلك} والآيات فيهم كثيرة وكان النفاق يكثر في ابتداء الإسلام ممن يدخل في ظاهر الإسلام ابتداء لغرض وذلك مما يقل في زماننا ولكن يكثر نفاق من ينسل عن الدين باطنا فيجحد الجنة والنار والدار الآخرة ميلا إلى قول الملحدة أو يعتقد على بساط الشرع والأحكام ميلا إلى أهل الإباحة أو يعتقد كفرا أو بدعة وهو يظهر خلافه فهؤلا", "english": "The fourth [case]: that the people's seeing him should be a weighty factor (murajjihan) and a strengthener of his vigor, such that were it not for that, he would not abandon the act of worship; and were the intention of ostentation alone [present], he would not have ventured upon it. So what we hold — and knowledge is with God — is that it does not annul the root of the reward, but rather it diminishes it; or he is punished to the measure of his intention of ostentation and rewarded to the measure of his intention of reward. As for his saying — may God's peace and blessings be upon him — that God the Exalted says: \"I am the most Self-Sufficient of the self-sufficient, free of all need for partnership (shirk)\" — that is carried upon the case when the two intentions are equal, or when the intention of ostentation is the weightier.", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 818", "section_title_en": "On the Degrees of Ostentation in Worship — The Second Pillar: That by Which One Ostentatiously Displays (Al-Riya' bi al-Ta'at)", "section_index": 818, "anchors": "- Root: قصد (Qasada)\n  * Lisan / Ayn: Core meaning of \"intending, aiming toward a goal, directing one's purpose.\"\n  * Al-Raghib (Mufradat): \"القصد: استقامة الطريق\" — intention as the straight path of the soul toward its object; in moral theology, it denotes the deliberate orientation of the will that determines the moral value of an act.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"قصدته وقصدت له\" — direct aiming. Metaphorical (Majaz): \"قصد في الأمر إذا لم يجاوز فيه الحد\" — moderation; here, the \"intention\" (qasd) is the precise measure by which an act is weighed between reward and punishment.\n- Root: راءى (Ra'a) — from Root: رأى (Ra'a)\n  * Lisan / Ayn: \"الرياء: إظهار العمل ليراه الناس\" — showing one's deed so that people may see it; derived from الرؤية (sight/seeing).\n  * Al-Raghib (Mufradat): Riya' is a branch of shirk (associating partners with God), for the actor directs his deed not to God alone but to the gaze of creatures, thus dividing his intention between the Creator and creation.\n  * Al-Zamakhshari (Asas): Literal: seeing with the eye. Metaphorical: \"راءى فلان\" — to perform an act for the sake of being seen, i.e., seeking the approval of onlookers rather than the sight of God.\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: \"الخلق: التقدير المستقيم\" — measuring and proportioning; also \"خلق الثوب\" — wearing out a garment until it is threadbare.\n  * Al-Raghib (Mufradat): \"الخلق أصله: التقدير المستقيم\" — creation as precise estimation; in moral context, the \"خلق\" (character) is the inward measure by which a soul is formed.\n  * Al-Zamakhshari (Asas): Literal: \"خلق الخراز الأديم\" — the leather-worker cutting and measuring hide. Metaphorical: \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation of creatures upon a measure required by wisdom; here, the \"creatures\" (الخلق) whose blame (المقت) is feared by the ostentatious worshipper.\n- Root: نفق (Nafaqa)\n  * Lisan / Ayn: \"نفق الشيء: مضى ونفد\" — to pass away, to be spent, to perish.\n  * Al-Raghib (Mufradat): \"نفق الشيء: مضى ونفد، ينفق، إما بالبيع نحو: نفق البيع نفاقا\" — to find a ready market; \"ومنها نفاق الأيم\" — hypocrisy as the \"passing\" of a false coin in the market of religion.\n  * Al-Zamakhshari (Asas): Literal: \"نفقت الدراهم\" — coins circulating and being spent. Metaphorical: \"نافق\" — the hypocrite (munafiq) whose outward faith circulates among people while his inward disbelief is void; the ostentatious man \"spends\" his deeds on the market of human praise.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic separation between a governing preposition and its object, as in \"له من الثواب مثل ما عليه من العقاب,\" where the prepositional phrases are interposed to balance two opposing clauses, mirroring the theological weighing of reward against punishment.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Condemnation of Status and Ostentation'", "badge": "Afterlife"}], "206": [{"arabic": "يحمل ذلك على الأنفة من قبول الوعظ كما قال تعالى {وإذا قيل له اتق الله أخذته العزة بالإثم} وروي عن عمر رضي الله عنه أنه قرأها فقال {إنا لله وإنا إليه راجعون} قام رجل يأمر بالمعروف فقتل فقام آخر فقال يقتلون الذين يأمرون بالقسط من الناس فقتل المتكبر الذي خالفه والذي أمره كبرا وقال ابن مسعود كفى بالرجل إثما إذا قيل له اتق الله قال عليك نفسك وقال صلى الله عليه وسلم لرجل كل بيمينك قال لا أستطيع فقال النبي صلى الله عليه وسلم ل أستطيع فقال النبي صلى الله عليه وسلم لا فما منعه إلا كبره قال فما رفعها بعد ذلك (1) حديث قول ثابت بن قيس بن شماس إ", "english": "The second aspect by which the vice of pride is magnified is that it calls to opposing Allah the Exalted in His commands. For the arrogant man, when he hears the truth from a servant among the servants of Allah, disdains to accept it and girds himself for its denial. For this reason you see the disputants in matters of religion claiming that they are investigating the secrets of the religion, yet they engage in mutual denial—the denial of the arrogant. Whenever the truth becomes clear upon the tongue of one of them, the other refuses to accept it out of pride, girds himself for its denial, and resorts to every stratagem to repel it by whatever obfuscation he can muster. This is among the moral traits of the disbelievers and the hypocrites, for Allah the Exalted described them, saying: {«وَقَالَ الَّذِينَ كَفَرُوا لَا تَسْمَعُوا لِهَذَا الْقُرْآنِ وَالْغَوْا فِيهِ لَعَلَّكُمْ تَغْلِبُونَ»} (And those who disbelieve said: \"Do not listen to this Quran and make noise therein, perhaps you may prevail.\") So whoever disputes for the sake of victory and silencing the opponent—not to seize the truth when it appears to him—has shared with them in this moral trait. Likewise, this pride drives one to refuse admonition, as Allah the Exalted said: {«وَإِذَا قِيلَ لَهُ اتَّقِ اللَّهَ أَخَذَتْهُ الْعِزَّةُ بِالْإِثْمِ»} (And when it is said to him, \"Fear Allah,\" pride in sin seizes him.) It is narrated that ʿUmar, may Allah be pleased with him, recited this verse and then said: {«إِنَّا لِلَّهِ وَإِنَّا إِلَيْهِ رَاجِعُونَ»} (Indeed, we belong to Allah and to Him we return.) A man rose to enjoin good and was killed; then another rose and said: \"They kill those who enjoin justice among the people\"—and the arrogant one who opposed him and the one who commanded him was killed out of pride.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 857", "section_title_en": "The Second Aspect by Which the Vice of Pride (Kibr) Is Magnified: That It Leads to Opposing Allah in His Commands", "section_index": 857, "anchors": "- Root: كبر (K-B-R)\n  * Lisan / Ayn: Core meaning of bigness, magnitude, and seniority; al-kibr is the internal disposition of self-magnification.\n  * Al-Raghib (Mufradat): Al-Kabīr and al-Ṣaghīr are relative terms (mutadāyifān); kibr as a moral vice is the soul's claim to a station above its due, entailing disdain for others.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage concerns physical or quantitative magnitude; metaphorical (majāz) usage here denotes arrogance and haughtiness—\"كبر عليه\" (he disdained it).\n- Root: علم (ʿ-L-M)\n  * Lisan / Ayn: Knowing a thing's reality; the root also carries the sense of a mark/trace (ʿalam) by which one is guided.\n  * Al-Raghib (Mufradat): True knowledge (ʿilm) is apprehension of a thing's essence or judgment about it; the highest form is knowledge of Allah, the self, and the Final End—this engenders fear (khashyah).\n  * Al-Zamakhshari (Asas): Literal: perception and awareness; metaphorical: the \"marks\" (maʿālim) of religion—the distinguishing signs of guidance.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self, soul, or spirit; that which is valued and precious.\n  * Al-Raghib (Mufradat): Al-Nafs denotes the soul or self; in theological usage it may refer to the essence (dhāt) of a thing.\n  * Al-Zamakhshari (Asas): Literal: the soul; metaphorical: self-worth and self-regard—the arrogant man \"magnifies his own soul\" (istaʿẓama nafsahu).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The verse {إِنَّمَا يَخْشَى اللَّهَ مِنْ عِبَادِهِ الْعُلَمَاءُ} restricts true fear of Allah exclusively to the learned, delimiting the predicate to the subject.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Pride and Conceit'", "badge": "Hadith"}], "207": [{"arabic": "يباهى بك الملائكة فأنزل الله تعالى ومن الناس من يشري نفسه ابتغاء مرضات الله والله رءوف بالعباد // حديث بات علي على فراش رسول الله صلى الله عليه وسلم فأوحى الله إلى جبريل وميكائيل إني آخيت بينكما وجعلت عمر أحدكما أطول من الآخر الحديث في نزول قوله تعالى ومن الناس من يشري نفسه ابتغاء مرضات الله أخرجه أحمد مختصرا من حديث ابن عباس شرى على نفسه فلبس ثوب النبي صلى الله عليه وسلم ثم نام مكانه الحديث وليس فيه ذكر جبريل وميكائيل ولم أقف لهذه الزيادة على أصل وفيه أبو بلج مختلف فيه والحديث منكر وعن أبي الحسن الأنطاكي أنه اجتمع عنده نيف وثلاثون نفس", "english": "So generosity (sakhāʾ) is a trait of the character of God, Exalted is He, and self-preference (īthār) is the highest of the degrees of generosity. And this was from the conduct (adab) of the Messenger of God, peace and blessings be upon him, until God, Exalted is He, named him \"tremendous,\" for He said, Exalted is He: {And indeed, you are upon a tremendous character}.", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 776", "section_title_en": "On Self-Preference (Īthār) — The Highest Station of Generosity", "section_index": 776, "anchors": "- Root: أ ث ر (Athara)\n  * Lisan / Ayn: Core meaning of precedence, choosing one thing over another, and transmitting a report (athar). The one who prefers another is mu'thir.\n  * Al-Raghib (Mufradat): Theological nuance of īthār as the voluntary act of giving precedence to another over oneself in worldly matters, a trait of the righteous and a station of the prophets.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage denotes physical precedence; metaphorical (majāz) usage denotes moral and spiritual preference, as in preferring another's need over one's own.\n- Root: س خ و (Sakha)\n  * Lisan / Ayn: Core meaning of liberality, open-handedness, and ease of giving.\n  * Al-Raghib (Mufradat): Sakha' is a praiseworthy disposition of the soul that impels one to spend freely; its highest degree is īthār.\n  * Al-Zamakhshari (Asas): Literal usage is the expenditure of wealth; metaphorical usage is the expenditure of one's effort, station, and even one's very life for another.\n- Root: ن ف س (Nafs)\n  * Al-Raghib (Mufradat): The self or soul; in the context of īthār, it is the object of sacrifice—preferring another over one's own nafs.\n  * Al-Zamakhshari (Asas): Literal usage refers to the soul; metaphorical usage refers to one's entire being and life, as in \"he sold his nafs\" (sharā nafsahu) meaning he devoted his entire life.\n- Sibawayh Rule: Rule of Prepositional Interposition and Clause Linking (al-ʿAṭf ʿalā al-Maʿnā) — The narrative structure links successive acts of īthār through implied clauses, demonstrating a chain of selflessness where each actor defers to the next, requiring the translator to preserve the sequential, unbroken flow of the anecdote.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Hadith"}], "208": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "212": [{"arabic": "{وقال} فيكشف ما تدعون إليه إن شاء {وقال} يرزق من يشاء بغير حساب {وقال} ويغفر ما دون ذلك لمن يشاء {وقال} ويتوب الله على من يشاء وهو خلق من أخلاق الربوبية إذ قال تعالى والله شكور حليم وقد جعل الله الشكر مفتاح كلام أهل الجنة فقال تعالى وقالوا الحمد لله الذي صدقناه وعده {وقال} وآخر دعواهم أن الحمد لله رب العالمين", "english": "So then, what we have mentioned concerning the treatment of patience (ṣabr) regarding whispered insinuation (waswās), regarding lust (shahwah), and regarding status (jāh) — annex this to what we have already set down concerning the canons of the paths of spiritual striving (mujāhadah) in the Book of the Discipline of the Soul (Kitāb Riyāḍat al-Nafs) from the Quarter of the Destroyers (rubʿ al-muhlikāt). Adopt it as your manual (dastūr) by which you may come to know the treatment of patience in all the categories which we have previously detailed; for the detailing of individual cases is prolix. Whoever observes gradual progression (tadrīj), patience will elevate him to a state wherein patience without it becomes as arduous as it once was with it — so his affairs become inverted, and what was once beloved to him becomes loathed, and what was once detested to him becomes a sweet, wholesome draught from which he cannot bear to be patient [in abstaining]. This is known only through experience (tajribah) and tasting (dhawq). It has an analogue in customary habits: for a boy is compelled to learning in the beginning by force, and so patience with play and patience with knowledge are both arduous for him — until, when his inner sight is opened and he finds intimacy with knowledge, the matter is inverted, and it becomes arduous for him to be patient in abstaining from knowledge, and to endure play. To this points what is narrated of one of the knowers (ʿārifīn) that he asked al-Shiblī: \"Patience — which of its kinds is the most severe?\" He said: \"Patience in God (fī Allāh).\" He said: \"No.\" He said: \"Patience for God (li-Allāh).\" He said: \"No.\" He said: \"Patience with God (maʿa Allāh).\" He said: \"No.\" He said: \"Then what?\" He said: \"Patience from God (ʿan Allāh).\" At that al-Shiblī cried out a cry by which his soul nearly perished. And it has been said concerning the meaning of His saying, the Exalted: {«اصبروا وصابروا ورابطوا»} \"Be patient, and vie in patience, and be steadfast\" (Q. 3:200): \"Be patient in God, vie in patience by God, and be steadfast with God.\" And it was said: \"Patience for God is sufficiency (ghināʾ); patience by God is endurance (baqāʾ); patience with God is fidelity (wafāʾ); and patience from God is abandonment (jafāʾ).\" And it was said concerning its meaning:", "book_title": "Patience and Gratitude", "section_title_ar": "Section 972", "section_title_en": "The Revival of the Religious Sciences — Section 972: On Patience (al-Sabr) and the Commencement of Gratitude (al-Shukr)", "section_index": 972, "anchors": "- Root: صبر (ṣ-b-r)\n  * Lisan / Ayn: Core meaning of restraint and withholding; al-Khalil notes its application to holding back an animal from fodder, and to enduring constraint.\n  * Al-Raghib (Mufradat): \"الصبر: الإمساك في ضيق\" — the withholding of the self in constriction; it is a general term whose specific names (shajāʿah, ḥilm, etc.) vary by context, and its opposite is al-jazaʿ (panic/vexation).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"صبرت على ما أكره. وصبرت عما أحب\" — enduring what is disliked and restraining from what is loved. Metaphorical (majāz): \"صبرت يمينه\" — binding an oath strenuously; \"أصبر على الضرب من الأرض\" — more enduring than the earth.\n- Root: شكر (sh-k-r)\n  * Lisan / Ayn: The root denotes manifestation and fullness; al-Ayn links it to an overflowing udder (shukrā).\n  * Al-Raghib (Mufradat): \"الشكر: تصور النعمة وإظهارها\" — the perception of a blessing and its display; it is the opposite of kufr (covering/denial). It has three degrees: of the heart (perception), of the tongue (praise), and of the limbs (requital).\n  * Al-Zamakhshari (Asas): Literal: \"شكرت لله تعالى نعمته\" — thanking God for His grace. Metaphorical: \"دابة شكور\" — a beast that thrives on little fodder, displaying its owner's care through its fatness.\n- Root: علم (ʿ-l-m)\n  * Lisan / Ayn: Knowledge as the apprehension of a thing's reality; al-Ayn treats it under the entry of umm (source/origin), indicating that knowledge is the root to which all else is annexed.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — apprehension of a thing by its true reality, either by grasping its essence or by affirming/denying a predicate of it.\n  * Al-Zamakhshari (Asas): Literal: \"ما علمت بخبرك: ما شعرت به\" — to be aware/perceive. It is also used for the landmarks (maʿālim) of the road, i.e., traces by which one is guided.\n- Root: وقد (w-q-d)\n  * Lisan / Ayn: The kindling and blazing of fire; al-Ayn records it under the entry of w-q-d with the sense of fuel and flame.\n  * Al-Raghib (Mufradat): \"وقدت النار تقد وقودا ووقدا\" — the fire blazed; al-wuqūd is both the fuel and the resulting flame, as in {«وقودها الناس والحجارة»} (Q. 2:24).\n  * Al-Zamakhshari (Asas): Literal: \"وقدت النار وقودا ووقدا، واتقدت وتوقدت\" — the fire blazed and blazed fiercely. Metaphorical: \"قلب وقاد\" — a blazing, keen heart; \"وقدة الصيف\" — the blazing heat of summer.\n- Sibawayh Rule: Interposition between the operative word and its object (al-faṣl bayna al-ʿāmil wa al-maʿmūl fīhi) — governing the placement of circumstantial qualifiers (ḥāl) and prepositional phrases to preserve the intended semantic restriction, as in the verse \"اصبروا وصابروا ورابطوا\" where each imperative carries a distinct operative scope.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "213": [{"arabic": "اختلف فيه من الحق بإذنك إنك تهدي من تشاء إلى صراط مستقيما (7) ثم يفتتح الصلاة ويصلي ركعتين خفيفتين ثم يصلي مثنى مثنى ما تيسر له ويختم بالوتر إن لم يكن قد صلى الوتر ويستحب أن يفصل بين الصلاتين عند تسليمه بمائة تسبيحة ليستريح ويزيد نشاطه للصلاة وقد صح في صلاة رسول الله صلى الله عليه وسلم بالليل أنه صلى أولا ركعتين خفيفتين ثم ركعتين طويلتين ثم ركعتين دون اللتين قبلهما ثم لم يزل يقصر بالتدريج إلى ثلاث عشرة ركعة (1) وسئلت عائشة رضي الله عنها أكان رسول الله صلى الله عليه", "english": "Then it is recommended, after the salutation of the witr, that he say: \"Glory be to the King, the Most Holy, the Lord of the angels and the Spirit. You have enveloped the heavens and the earth with majesty and dominion. You have manifested Your might through power, and You have subdued the servants through death.\" It is related that he (peace and blessings be upon him) — until he died — most of his prayer was seated, except for the obligatory prayers (1). And he said to the one who prays seated: \"Half the reward of the one who prays standing,\" and to the one who sleeps: \"Half the reward of the one who prays seated\" (2). This indicates the validity of the supererogatory prayer in all states.", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 264", "section_title_en": "The Fourth and Fifth Wirds (Portions of Night Devotion): On Sleep and the Final Sixth of the Night", "section_index": 264, "anchors": "- Root: ليل (Layl)\n  * Lisan / Ayn: Night; the period of darkness from sunset to dawn; its plural forms include layālī and layalāt.\n  * Al-Raghib (Mufradat): Night is a divinely ordained sign (āyah) of Allah's power; sleep is described as a form of death (tawaffā) in the Qur'an, linking the nightly cycle to resurrection.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) for the astronomical night; metaphorical (majāz) for spiritual darkness or heedlessness.\n- Root: نوم (Nawm)\n  * Lisan / Ayn: Sleep; slumber; a state of rest.\n  * Al-Raghib (Mufradat): Sleep is \"death in a light form\" (al-mawt al-khafīf), and death is \"sleep in a heavy form\" (al-nawm al-thaqīl). Allah says: {«Allah takes the souls at the time of their death, and those that die not during their sleep»} (Q. 39:42).\n  * Al-Zamakhshari (Asas): Literal: bodily rest. Metaphorical: heedlessness (ghaflah) or spiritual inertia; \"the market slept\" means it stagnated.\n- Root: عله (Alaha/Ilah)\n  * Lisan / Ayn: To worship; to seek refuge; the root for ilāh (deity) and Allāh (the Supreme Deity).\n  * Al-Raghib (Mufradat): The root denotes the act of devotion and the object of ultimate veneration; al-ulūhiyyah is the state of being worshipped.\n  * Al-Zamakhshari (Asas): Literal: deity. Metaphorical: that which one is utterly devoted to or enslaved by (e.g., one's desires).\n- Root: الي (Alā/Yalū)\n  * Lisan / Ayn: To be occupied with; to manage; related to al-ālah (instrument) and ma'ālah (consequence).\n  * Al-Raghib (Mufradat): The root conveys the idea of returning to a state or being entrusted with a matter; al-ālah is that by which one accomplishes an affair.\n  * Al-Zamakhshari (Asas): Literal: instrumentality. Metaphorical: the means by which one draws near to Allah.\n- Sibawayh Rule: Restriction and Focused Predication (al-Ḥaṣr wa al-Taqyīd bi-innamā) — Used to distinguish the specific legal scope of actions (e.g., the witr prayer's status) and to restrict general statements to their precise conditions.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Arrangement of Litanies'", "badge": "Dhikr"}, {"arabic": "الإنكار {أم يحسدون الناس على ما آتاهم الله من فضله} وقال تعالى {كان الناس أمة واحدة} إلى قوله {إلا الذين أوتوه من بعد ما جاءتهم البينات بغيا بينهم} قيل في التفسير حسدا وقال تعالى {وما تفرقوا إلا من بعد ما جاءهم العلم بغيا بينهم} فأنزل الله العلم ليجمعهم ويؤلف بينهم على طاعته وأمرهم أن يتألفوا بالعلم فتحاسدوا واختلفوا إذ أراد كل واحد منهم أن ينفرد بالرياسة وقبول القول فرد بعضهم على بعض قال ابن عباس كانت اليهود قبل أن يبعث النبي صلى الله عليه وسلم إذا قاتلوا قوما قالوا نسألك بالنبي الذي وعدتنا أن ترسله وبالكتاب الذي تنزله إلا ما", "english": "The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"", "book_title": "Condemnation of Envy", "section_title_ar": "Section 720", "section_title_en": "On the Reality of Envy (Ḥasad) and Its Degrees — Section 720", "section_index": 720, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Envy'", "badge": "Hadith"}, {"arabic": "الناس أمة واحدة} إلى قوله {إلا الذين أوتوه من بعد ما جاءتهم البينات بغيا بينهم} قيل في التفسير حسدا وقال تعالى {وما تفرقوا إلا من بعد ما جاءهم العلم بغيا بينهم} فأنزل الله العلم ليجمعهم ويؤلف بينهم على طاعته وأمرهم أن يتألفوا بالعلم فتحاسدوا واختلفوا إذ أراد كل واحد منهم أن ينفرد بالرياسة وقبول القول فرد بعضهم على بعض قال ابن عباس كانت اليهود قبل أن يبعث النبي صلى الله عليه وسلم إذا قاتلوا قوما قالوا نسألك بالنبي الذي وعدتنا أن ترسله وبالكتاب الذي تنزله إلا ما نصرتنا (1) فكانوا ينصرون فلما جاء النبي صلى الله عليه وسلم من ولد", "english": "The Prophet ﷺ said: «إن المؤمن يغبط والمنافق يحسد» — \"The believer aspires emulously, and the hypocrite envies.\"", "book_title": "Condemnation of Envy", "section_title_ar": "Section 720", "section_title_en": "On the Reality of Envy (Ḥasad) and Its Degrees — Section 720", "section_index": 720, "anchors": "- Root: نعم (n-ʿ-m)\n  * Lisan / Ayn: Core root meaning of \"bounty, benefaction, grace\" — that state of goodness and well-being bestowed.\n  * Al-Raghib (Mufradat): \"النعمة: الحالة الحسنة\" — bounty is the excellent state/condition; it is the genus term applying to both little and much, as in {«وإن تعدوا نعمة الله لا تحصوها»} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"جلت نعمة الله ونعماؤه\" — bounty as actual bestowed good. Metaphorical (majāz): \"خفت نعامتهم\" — departure/removal, relevant to the envier's wish for the bounty's removal.\n- Root: حسد (ḥ-s-d)\n  * Lisan / Ayn: Envy — the desire for removal of another's good.\n  * Al-Raghib (Mufradat): \"الحسد: تمني زوال نعمة من مستحق لها\" — envy is wishing the removal of bounty from one who deserves it, sometimes accompanied by striving to effect its removal. Cited: «المؤمن يغبط والمنافق يحسد».\n  * Al-Zamakhshari (Asas): Literal: \"حسده على نعمة الله\" — envying someone for God's bounty. \"إن الحسد يأكل الجسد\" — envy consumes the body.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self; also value, preciousness.\n  * Al-Raghib (Mufradat): النفس: الروح — the soul/spirit; also الذات (essence/self).\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس ومنفس\" — a precious thing. Metaphorical: \"دفق نفسه أي دمه\" — poured out his self, i.e., his blood. From this root derives المنافسة (emulative competition) — the striving for precious things.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The definition of ḥasad is given as a restricted predication (ḥadd), delimiting its essential meaning: \"كراهة النعمة وحب زوالها عن المنعم عليه\" — the hatred of bounty and love of its removal from the one upon whom it is bestowed. This is a formal definition (ḥadd), not merely a lexical gloss.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Envy'", "badge": "Hadith"}], "216": [{"arabic": "المحبوب لم يقدر له إلا ما فيه خيرته ويذكر قوله وعسى أن تكرهوا شيئا وهو خير لكم ومنها أن يتنعم بالطاعة ولا يستثقلها ويسقط عنه تعبها كما قال بعضهم كابدت الليل عشرين سنة ثم تنعمت به", "english": "He said this concerning intimacy with God. And in the reports of David (upon him be peace): \"Do not seek intimacy with any of My creatures, for I only cut off from Me two men: a man who deemed My reward slow in coming and so was cut off, and a man who forgot Me and was content with his own state. The sign of that is that his affair is left to himself, and that I leave him in the world bewildered.\" And whenever one is intimate with other than God, to the measure of his intimacy with other than God he is estranged from God (mighty and majestic is He) and falls from the station of His love.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1178", "section_title_en": "On Intimacy with God (Al-Uns bi-Allah) — Section 1178", "section_index": 1178, "anchors": "- Root: انس (Al-Uns)\n  * Lisan / Ayn: Core meaning of sociability, familiarity, and the absence of wild estrangement; the opposite of وحشة (loneliness/terror).\n  * Al-Raghib (Mufradat): Theological nuance: intimacy (uns) with God is the heart's tranquil repose (sukūn) in His remembrance, contrasted with the soul's restless flight toward creatures.\n  * Al-Zamakhshari (Asas): Literal (haqiqah): human companionship. Metaphorical (majaz): the soul's inward inclination toward its Beloved, such that outward speech continues while the heart is wholly absorbed.\n- Root: وحش (Wahsh)\n  * Lisan / Ayn: Wildness, desolation, and estrangement; the state of a beast alone in the wilderness.\n  * Al-Raghib (Mufradat): Spiritual estrangement (istīḥāsh) from all that is other than God is the necessary corollary of true intimacy with Him.\n  * Al-Zamakhshari (Asas): Literal: physical solitude in a desolate place. Metaphorical: the heart's alienation from creatures when it has tasted divine proximity.\n- Root: ذكر (Dhikr)\n  * Lisan / Ayn: Remembrance, utterance, and the presence of something in the mind after absence.\n  * Al-Raghib (Mufradat): The highest form is remembrance of God with a present heart, which yields tranquility (ṭuma'nīnah) as stated in {«ألا بذكر الله تطمئن القلوب»}.\n  * Al-Zamakhshari (Asas): Literal: vocal repetition. Metaphorical: the heart's constant orientation toward God such that forgetfulness (ghaflah) becomes the exception.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The particle innamā restricts the predicate exclusively to the subject, as in \"I only cut off from Me two men,\" negating any other cause of separation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "217": [{"arabic": "قوله أولئك أصحاب النار هم فيها خالدون وثلاث آيات من آخر سورة البقرة من قوله لله ما في السموات وما في الأرض إلى آخرها وقل هو الله أحد خمس عشرة مرة (3) وصف من ثوابه في الحديث ما يخرج عن الحصر وقال كرز بن وبرة وهو من الأبدال قلت للخضر عليه السلام علمني شيئا أعمله في كل ليلة فقال إذا صليت المغرب فقم إلى وقت صلاة العشاء مصليا من غير أن تكلم أحدا وأقبل على صلاتك التي أنت فيها وسلم من كل ركعتين واقرأ في كل ركعة فاتحة الكتاب مرة وقل هو الله أحد ثلاثا فإن فرغت من صلاتك انصرف إلى منزلك ولا ت", "english": "The Messenger of God (peace be upon him) said — according to what ʿĀ'ishah (may God be pleased with her) narrated: \"Verily, the most excellent of prayers in the sight of God is the Maghrib prayer. He has not exempted from it either the traveler or the resident. By it He opened the prayer of the night, and by it He sealed the prayer of the day. Whoever prays the Maghrib and prays after it two units (rakʿatayn), God will build for him a palace (qaṣr) in Paradise.\"", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 271", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 271: On the Virtue of the Maghrib Prayer and the Facilitating Causes for the Night Vigil (Qiyām al-Layl)", "section_index": 271, "anchors": "- Root: غرب (gh-r-b)\n  * Lisan / Ayn: Core meaning of disappearance, setting, and the west; al-ghurāb is the setting of the sun.\n  * Al-Raghib (Mufradat): \"الغرب: غيبوبة الشمس\" — the occultation of the sun; the Maghrib prayer is named for its time, marking the transition from the day's light into the night's dominion.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage denotes the sun's setting; metaphorically (Majaz), it signifies a boundary or point of transition — here, the temporal boundary between the daytime prayers and the night vigil.\n- Root: رسل (r-s-l)\n  * Lisan / Ayn: Sending forth with gentleness and ease; a messenger (rasūl) is one dispatched.\n  * Al-Raghib (Mufradat): \"أصل الرسل: الانبعاث على التؤدة\" — the root denotes a measured, deliberate sending forth; from this derives the concept of the prophetic messenger.\n  * Al-Zamakhshari (Asas): Literal: \"أرسل الله في الأمم رسلا\" (God sent messengers to the nations). Metaphorical: \"أرسل الله عليهم العذاب\" (God loosed chastisement upon them) — here, the ḥadīth's \"أرسل\" (in the chain) is literal transmission.\n- Root: ركع (r-k-')\n  * Lisan / Ayn: Bowing; the physical posture of inclination in prayer.\n  * Al-Raghib (Mufradat): \"الركوع: الانحناء\" — used literally for the prayer posture and metaphorically for humility and submission before God.\n  * Al-Zamakhshari (Asas): Literal: \"شيخ راكع: منحن من الكبر\" (an old man bowed with age). Metaphorical: \"لغبت الإبل حتى ركعت\" (camels fatigued until they knelt) — in the ḥadīth, \"ركعات\" (units of prayer) are named for the bowing that defines them.\n- Root: صلا (ṣ-l-w)\n  * Lisan / Ayn: The root of prayer (ṣalāh); also linked to the fire of kindling (taṣliyah).\n  * Al-Raghib (Mufradat): \"أصل الصلي الإيقاد بالنار\" — the root denotes kindling fire; the ṣalāh is so named for the \"burning\" of devotion or for the supplication that \"kindles\" the heart toward God.\n  * Al-Zamakhshari (Asas): The term ṣalāh in the Sacred Law is a transferred (naql) technical designation for the specific acts of bowing, prostration, and recitation — distinct from its lexical sense of supplication (duʿā').\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The rule governing the permissibility of interposing elements between a preposition and its object, as in \"لم يحطها عن مسافر ولا عن مقيم\" where the pronominal object (ها) is separated from the second prepositional phrase (عن مقيم) by the conjunction, maintaining grammatical cohesion through parallel structure.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Arrangement of Litanies'", "badge": "Hadith"}], "218": [{"arabic": "وقد شرح الله الرجاء فقال إن الذين آمنوا والذين هاجروا وجاهدوا في سبيل الله أولئك يرجون رحمة الله يعني أن الرجاء بهم أليق وهذا لأنه ذكر أن ثواب الآخرة أجر وجزاء على الأعمال قال الله تعالى جزاء بما كانوا يعملون وقال تعالى وإنما توفون أجوركم يوم القيامة أفترى أن من استؤجر على إصلاح أوان وشرط له أجرة عليها وكان الشارط كريما يفي بالوعد مهما وعد ولا يخلف بل يزيد فجاء الأجير وكسر الأواني وأفسد جميعها ثم جلس ينتظر الأجر ويزعم أن المستأجر كريم أفيراه العقلاء في انتظاره متمنيا مغرورا أو راجيا وهذا للجهل بالفرق بين الرجاء والغرة قيل للحسن قوم يقولون", "english": "I say: God—exalted is He—loves the obedient and hates the disobedient. So just as He does not hate the obedient father because of His hatred for the disobedient son, likewise He does not love the disobedient son because of His love for the obedient father. And if love were to flow from the father to the son, then hatred would likewise be bound to flow. Rather, the truth is: {«ولا تزر وازرة وزر أخرى»} — \"And no bearer of burdens will bear the burden of another\" {Quran 6:164, 17:15, 35:18, 39:7, 53:38}. And whoever supposes that he will be saved by his father's piety is like one who supposes he will be satiated by his father's eating, quenched by his father's drinking, become a scholar by his father's learning, and reach the Ka'bah and see it by his father's walking.", "book_title": "Fear and Hope", "section_title_ar": "Section 889", "section_title_en": "The Reality of Hope (Al-Rajā') and the Futility of Reliance on Another's Piety", "section_index": 889, "anchors": "- Root: و ل د (walada)\n  * Lisan / Ayn: Physical begetting and offspring; the father's generative act.\n  * Al-Raghib (Mufradat): \"الولد: المولود\" — offspring as a created entity; here used metaphorically for spiritual causation.\n  * Al-Zamakhshari (Asas): Literal: physical birth. Metaphorical: \"تولدت العصبية\" — something generated or produced from another; Ghazali exploits this to refute the notion that a father's obedience \"generates\" salvation for the son.\n- Root: ر ج و (rajā)\n  * Lisan / Ayn: Expectation, hope, longing for a favorable outcome.\n  * Al-Raghib (Mufradat): Hope tied to legitimate means; not mere wishful thinking (tamannī).\n  * Al-Zamakhshari (Asas): Literal: awaiting rain. Metaphorical: \"رجوت فلانا\" — to expect from someone; Ghazali contrasts true hope (with action) vs. delusion (ghurūr).\n- Root: غ ر ر (gharara)\n  * Lisan / Ayn: Deception, heedlessness, being lured by a false appearance.\n  * Al-Raghib (Mufradat): The state of one who is duped by Satan's plausible speech.\n  * Al-Zamakhshari (Asas): Literal: a risky venture. Metaphorical: \"اغتر بفلان\" — to be deceived by outward charm while the inner reality is corrupt.\n- Root: ك ي س (kays)\n  * Lisan / Ayn: Intelligence, shrewdness, prudence.\n  * Al-Raghib (Mufradat): The wise man who disciplines his soul and acts for the afterlife.\n  * Al-Zamakhshari (Asas): Literal: alertness. Metaphorical: \"الكيس من دان نفسه\" — the prudent one who holds his soul to account; antonym of \"الأحمق\" (the fool).\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يوفى الصابرون أجرهم بغير حساب\" style; Ghazali uses \"إنما\" to restrict reward to personal action, and \"ليس للإنسان إلا ما سعى\" as a restrictive negative clause (nafy + illā) to deny any transfer of merit.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Fear and Hope'", "badge": "Insight"}], "222": [{"arabic": "خاليا عن الشوائب مأخوذ من النصح ويدل على فضل التوبة قوله تعالى إن الله يحب التوابين ويحب المتطهرين وقال صلى الله عليه وسلم التائب حبيب الله والتائب من الذنب كمن لا ذنب له (1) وقال رسول الله صلى الله عليه وسلم الله أفرح بتوبة العبد المؤمن من رجل نزل في أرض دوية مهلكة معه راحلته عليها طعامه وشرابه فوضع رأسه فنام نومة فاستيقظ وقد ذهبت راحلته فطلبها حتى إذا اشتد عليه الحر والعطش أو ما شاء الله قال أرجع إلى مكاني الذي كنت فيه فأنام حتى أموت فوضع رأسه على ساعده ليموت فاستيقظ فإذا راحلته عنده عليها زاده وشرابه فالله تعالى أشد فرحا بتوبة العبد المؤم", "english": "Know that the obligation of repentance is made evident by the transmitted reports (1) and the Quranic verses, and it is clear by the light of inner vision (nūr al-baṣīrah) for the one whose insight has been opened and whose breast God has expanded with the light of faith, until he is able to walk by his light which is before him through the darknesses of ignorance, independent of a guide to lead him at every step. For the wayfarer is either blind, not independent of a guide in his steps, or sighted, guided to the beginning of the road and then guided by himself. Likewise, people on the path of religion are divided according to this division. There is the deficient one who cannot surpass emulation (taqlīd) in his steps, and thus needs to hear at every footfall a text from the Book of God or the Sunnah of His Messenger — and perhaps that fails him, and he becomes bewildered. The journeying of this one, even if his life is long and his effort great, is short, and his steps are deficient. And there is the fortunate one whose breast God has expanded for Islam, and he is upon a light from his Lord. He is alerted by the slightest indication to traverse a rugged path and to cut through exhausting obstacles, and the light of the Quran and the light of faith shine in his heart. Due to the intensity of the light of his inner being, he is satisfied with the slightest explanation, as if his oil were about to glow even if fire did not touch it — and when fire touches it, it is light upon light. {«يَهْدِي اللَّهُ لِنُورِهِ مَنْ يَشَاءُ»} God guides to His light whom He wills. This one does not need a transmitted text in every occurrence. So whoever is in this state, when he wishes to know the obligation of repentance, he looks first with the light of inner vision at what repentance is, then at what the meaning of obligation is, then he combines the meaning of obligation with repentance and does not doubt its being established for it. That is, by knowing that the meaning of \"the obligatory\" is that which is necessary for reaching the felicity of eternity and for deliverance from the perdition of eternity. For were it not for the attachment of felicity and misery to the doing of a thing or its abandonment, there would be no meaning to describing it as obligatory. And the saying of one who says, \"It became obligatory by an act of imposition,\" is pure idle talk. For that in whose doing or abandoning we have no interest, whether in the hereafter or in this world, has no meaning for our occupying ourselves with it, whether another imposed it upon us or did not impose it. So when he knows the meaning of obligation — that it is the means to the felicity of eternity — and knows that there is no felicity in the abode of permanence except in the encounter (liqāʾ) of God Most High, and that everyone veiled from Him is miserable without exception, cut off from what he desires, burned by the fire of separation and the fire of Hell; and knows that nothing distances from the encounter of God except the following of passions and intimacy with this perishing world and clinging to the love of what must inevitably be parted from; and knows that nothing brings near to the encounter of God except severing the heart's attachment from the ornament of this world and turning wholly to God, seeking intimacy with Him through the constancy of His remembrance, and love for Him through knowledge of His majesty and beauty to the extent of one's capacity; and knows that sins — which are a turning away from God and a following of what the devils, the enemies of God who distance from His presence, love — are the cause of one's being veiled and distanced from God Most High — then he does not doubt that turning away from the path of distance is obligatory for reaching proximity. And turning away is only completed by knowledge, remorse, and resolve. For as long as he does not know that sins are causes of distance from the Beloved, he will not regret nor feel pain due to his traveling the path of distance; and as long as he does not feel pain, he will not return; and the meaning of returning is abandoning and resolving. So he does not doubt that the three meanings are necessary for reaching the Beloved. And such is the faith that results from the light of inner vision.", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 917", "section_title_en": "The Obligation of Repentance: Its Reality, Its Proofs, and the Reconciliation of Divine Decree with Human Agency", "section_index": 917, "anchors": "- Root: توب (T-W-B)\n  * Lisan / Ayn: Core meaning is \"return\" (rujūʿ) — the act of turning back from a path one was on.\n  * Al-Raghib (Mufradat): In theological usage, it signifies returning from sin (dhamb) to obedience, and from distance (buʿd) from God to proximity (qurb) to Him. It is the servant's reversion to his original, sound nature.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is \"returning\"; metaphorical (majāz) extension applies it to the heart's turning away from the pursuit of worldly desires (shahawāt) toward the remembrance of God.\n- Root: وجب (W-J-B)\n  * Lisan / Ayn: Core meaning is \"to be established, fixed, or necessary\" — something whose non-existence entails a contradiction or harm.\n  * Al-Raghib (Mufradat): The obligatory (wājib) is that which, if neglected, incurs blame; it is divided into what is obligatory by reason (ʿaql) and what is obligatory by revelation (sharʿ).\n  * Al-Zamakhshari (Asas): Literal sense: \"to be due\" or \"to fall\" (as in a price being fixed); metaphorical sense: the soul's \"falling\" into action out of necessity.\n- Root: خلق (Kh-L-Q)\n  * Lisan / Ayn: Core meaning is \"measuring\" or \"estimating\" (taqdīr) — bringing something into existence according to a precise measure.\n  * Al-Raghib (Mufradat): Used for creation from nothing (ibdāʿ) and for bringing something forth from another thing; all of God's acts are measured by His eternal decree.\n  * Al-Zamakhshari (Asas): Literal: the artisan's measuring of leather before cutting; Metaphorical: God's origination of creation upon a measure necessitated by wisdom.\n- Root: كسب (K-S-B)\n  * Lisan / Ayn: Core meaning is \"to acquire\" or \"to earn\" — an act that returns a benefit or harm to the agent.\n  * Al-Raghib (Mufradat): In Kalam, acquisition (kasb) denotes the creature's relation to an act that is entirely God's creation, yet is attributed to the servant by way of his being the locus of its occurrence.\n  * Al-Zamakhshari (Asas): Literal: to gather wealth; Metaphorical: the soul's \"gathering\" of deeds that cling to it as its own.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — used to delimit the meaning of \"obligation\" to its true referent (the means to eternal felicity), and to restrict the attribution of acts to God alone as their sole Creator.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "223": [{"arabic": "إلى ربك كدحا فملاقيه} وقال تعالى {واتقوا الله ويعلمكم الله} وقال تعالى {واتقوا الله واعلموا أنكم ملاقوه} وقال صلى الله عليه وسلم من لم تنهه صلاته عن الفحشاء والمنكر لم يزدد من الله إلا بعدا (5) والصلاة مناجاة فكيف تكون مع الغفلة وقال بكر بن عبد الله يا ابن آدم إذاشئت أن تدخل على مولاك بغير إذن وتكلمه بلا ترجمان دخلت قيل وكيف ذلك قال تسبغ وضوءك وتدخل محرابك فإذا أنت قد دخلت على مولاك بغير إذن فتكلمه بغير ترجمان وعن عائشة رضي الله عنها قالت كان رسول الله صلى الله عليه وسلم يحدثنا ونحدثه فإذا حضرت الصلاة فكأنه لم يعرفنا ولم نعرفه (6) اشتغال", "english": "God—Exalted is He—said: {«And establish prayer for My remembrance»} (Q 20:14). And He—Exalted is He—said: {«And be not among the heedless»} (Q 7:205). And He—Mighty and Majestic—said: {«Do not approach prayer while you are intoxicated until you know what you are saying»} (Q 4:43). It was said: \"intoxicated\" from the excess of worldly concern (al-hamm), and it was said: from love of this world.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 124", "section_title_en": "The Virtue of Humble Devotion (Khusḥūʿ) in Prayer", "section_index": 124, "anchors": "- Root: خشع (Khashaʿa)\n  * Lisan / Ayn: \"الخشوع: التواضع والسكون، وخشع بصره: غضه وأطرقه، وخشعت الأصوات: سكنت وخفضت\"\n  * Al-Raghib (Mufradat): \"الخشوع: الضراعة والاستكانة، وأصله الانخفاض والتطامن، ويقال للصوت الخفيض والطرف المنكسر\"\n  * Al-Zamakhshari (Asas): \"Literal: خشع الرجل: خفض رأسه وتواضع. Metaphorical: خشع القلب: خضع وذل وسكن لله\"\n- Root: سكر (Sukr)\n  * Lisan / Ayn: \"السكر: نقيض الصحو، والسكران: الذي غطى عقله، وكل شيء غطى فقد سكر\"\n  * Al-Raghib (Mufradat): \"السكر: حالة تعرض بين العقل وبين إدراكه، ويستعار لما يغطي العقل من الهم وحب الدنيا\"\n  * Al-Zamakhshari (Asas): \"Literal: سكر من الشراب. Metaphorical: سكر الهم وحب الدنيا — ما يغطي العقل عن إدراك المقام\"\n- Root: ندم (Nadama)\n  * Lisan / Ayn: \"الندم: التحسر على ما فات، والندامة: التوبة، والنادم: المتحسر\"\n  * Al-Raghib (Mufradat): \"الندم: انكسار النفس لما فرط، وهو من لوازم التوبة\"\n  * Al-Zamakhshari (Asas): \"Literal: ندم على الشيء: تحسر. Metaphorical: تنادم في الصلاة: استحضار التقصير والانكسار بين يدي الله\"\n- Root: وجب (Wajaba)\n  * Lisan / Ayn: \"وجب القلب: اضطرب وخفق، ووجب الشيء: ثبت ولزم، والوجيب: صوت خفقان القلب\"\n  * Al-Raghib (Mufradat): \"الوجيب: اضطراب القلب من هيبة الأمر وعظمته\"\n  * Al-Zamakhshari (Asas): \"Literal: وجب الباب: أغلقه. Metaphorical: وجيب القلب: خفقانه من الخوف والهيبة\"\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما الصلاة تمسكن\" restricts prayer's essence to humility, excluding distraction and heedlessness.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Prayer'", "badge": "Du'a"}, {"arabic": "وأحد المعاني المذكورة في قوله تعالى {فأتوا حرثكم أنى شئتم وقدموا لأنفسكم} تقديم الأطفال إلى الآخرة فقد ظهر بهذه الوجوه الأربعة أن أكثر فضل النكاح لأجل كونه سببا للولد الفائدة الثانية التحصن من الشيطان وكسر التوقان ودفع غوائل الشهوة وغض البصر وحفظ الفرج وإليه الإشارة بقوله عليه السلام من نكح فقد حصن نصف دينه فليتق الله في الشطر الآخر وإليه الإشارة بقوله عليكم بالباءة فمن لم يستطع فعليه بالصوم فإن الصوم له وجاء وأكثر ما نقلناه من الآثار والأخبار إشارة إلى هذا المعنى وهذا المعنى دون الأول لأن الشهوة موكلة بتقاضي تحصيل الولد فالن", "english": "وقال صلى الله عليه وسلم: \"لا يلقى الله أحد بذنب أعظم من جهالة أهله.\"", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 296", "section_title_en": "Section 296", "section_index": 296, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Marriage'", "badge": "Insight"}], "225": [{"arabic": "الشهادة ومن يكتمها فإنه آثم قلبه} وقوله تعالى {لا يؤاخذكم الله باللغو في أيمانكم ولكن يؤاخذكم بما كسبت قلوبكم} والحق عندنا في هذه المسألة لا يوقف عليه ما لم تقع الإحاطة بتفصيل أعمال القلوب من مبدأ ظهورها إلى أن يظهر العمل على الجوارح فنقول أول ما يرد على القلب الخاطر كما لو خطر له مثلا صورة امرأة وأنها وراء ظهره في الطريق لو التفت إليها لرآها والثاني هيجان الرغبة إلى النظر وهو حركة الشهوة في الطبع وهذا يتولد من الخاطر الأول ونسميه ميل الطبع ويسمى الأول حديث النفس والثالث حكم القلب بأن هذا ينبغي أن يفعل أي ينبغي أن ينظر إليها فإن الطبع إذا مال لم تنبع", "english": "Know that this is a subtle matter, and there have come down concerning it verses and reports that are mutually conflicting, such that the way of reconciling between them becomes obscure — save for the master-brokers of the scholars of the Sacred Law. For it has been related from the Prophet — peace and blessings be upon him — that he said: \"God has pardoned my community for what their souls whisper to them, so long as they do not speak of it or act upon it.\" (1) And Abū Hurayrah said: The Messenger of God — peace and blessings be upon him — said: \"God — exalted is He — says to the guardian angels: When My servant intends a sin, do not write it against him; but if he commits it, then write it as one sin. And when he intends a good deed and does not perform it, write it for him as one good deed; but if he performs it, write it for him as ten.\" (2) This has been recorded by al-Bukhārī and Muslim in the two Ṣaḥīḥs, and it is evidence for the pardon of the heart's act and its intending of a sin. And in another wording: \"Whoever intends a good deed and does not perform it, it is written for him as a good deed; and whoever intends a good deed and performs it, it is written for him as up to seven hundred multiples. And whoever intends a sin and does not perform it, it is not written against him; but if he performs it, it is written.\" And in yet another wording: \"When My servant speaks within himself of committing a sin, I forgive him for it so long as he does not commit it.\" And all of this indicates the pardon.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 606", "section_title_en": "The Heart's Whisperings and the Divine Pardon — On the Four Stages of Inner Acts", "section_index": 606, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or inner being; that which breathes and harbors concealed thoughts.\n  * Al-Raghib (Mufradat): Al-nafs denotes the soul or self (al-rūḥ), and in divine address, \"what your souls whisper\" (mā ḥaddathat bihi nufūsuhā) refers to the inner promptings that arise without deliberate volition.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage pertains to the soul's essence; metaphorical (majāz) usage extends to inner speech and inclination, as in \"ḥadīth al-nafs\" (self-talk), which is not yet resolved action.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: To originate or bring forth something new; an event or occurrence that comes to be after non-existence.\n  * Al-Raghib (Mufradat): Al-ḥudūth is the coming-to-be of a thing after it was not; \"ḥadīth al-nafs\" is the newly arising thought that occurs to the heart without prior acquisition.\n  * Al-Zamakhshari (Asas): Literal: a recent matter or speech; metaphorical: the inner utterance of the soul, as in the prophetic report, \"God has pardoned my community for what their souls whisper to them.\"\n- Root: هم (h-m-m)\n  * Lisan / Ayn: To intend, resolve, or purpose; the stirring of the will toward an act before its execution.\n  * Al-Raghib (Mufradat): Al-hamm is the resolved intention (al-ʿazm) that precedes the deed; it is distinguished from mere inclination (mayl) and passing thought (khāṭir).\n  * Al-Zamakhshari (Asas): Literal: the soul's determination; metaphorical: the initial resolve that, when strengthened, becomes a firm will (irādah jazīmah).\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; to turn or overturn, signifying its fluctuating nature between states.\n  * Al-Raghib (Mufradat): The heart is the seat of cognition and volition; its \"acts\" (aʿmāl al-qulūb) include thought, belief, and resolve, which are subject to divine reckoning.\n  * Al-Zamakhshari (Asas): Literal: the physical organ; metaphorical: the spiritual faculty that perceives, believes, and intends, as in \"the heart's sin\" (ithm al-qalb).\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The prophetic and Quranic statements employ restriction to delineate the boundary between what is pardoned (the passing thought) and what is reckoned (the resolved intention), requiring precise parsing of the conditional clauses (law, idhā, man) to distinguish the stages of inner acts.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "الله تعالى {لا يؤاخذكم الله باللغو في أيمانكم} هذا ما نقل من الأقاويل ومن طلب الحق في التقليد فمهما استقصى تعارضت عنده هذه الأقاويل فيبقى متحيرا أومائلا إلى بعض الأقاويل بالتشهي وكل ذلك قصور بل ينبغي أن يطلب الحق بطريقه وذلك بالبحث عن مدارك الحظر والإباحة كما سنذكره بيان الدليل على إباحة السماع اعلم أن قول القائل السماع حرام معناه أن الله تعالى يعاقب عليه وهذا أمر لا يعرف بمجرد العقل بل بالسمع ومعرفة الشرعيات محصورة في النص أو القياس على المنصوص وأعني بالنص ما أظهره صلى الله عليه وسلم", "english": "And it was related from Ṭāhir ibn Bilāl al-Hamadānī al-Warrāq, who was among the people of knowledge, that he said: I was in spiritual retreat (muʿtakif) in the congregational mosque of Jeddah by the sea, and one day I saw a group reciting poetry (yaqūlūn qawl) in one corner of it and listening. I disapproved of that in my heart and said: In a house among the houses of God they recite poetry? He said: Then I saw the Prophet, peace and blessings be upon him, that night, seated in that very corner, and beside him was Abu Bakr al-Ṣiddīq, may God be pleased with him — and behold, Abu Bakr was reciting something of poetry, and the Prophet, peace and blessings be upon him, was listening to him and placing his hand upon his chest like one overcome with ecstasy (al-wājid) thereby. So I said to myself: It was not fitting for me to disapprove of those who were listening — for here is the Messenger of God, peace and blessings be upon him, listening, and Abu Bakr reciting. Then he [the Prophet] turned to me and said: \"This is true by truth\" — or he said: \"True from truth\" — I am doubtful about it [the exact wording].", "book_title": "Audition and Ecstasy", "section_title_ar": "Section 488", "section_title_en": "The Revival of the Religious Sciences — Section 488: On the Lawfulness of Auditory Samaʿ (Spiritual Listening)", "section_index": 488, "anchors": "- Root: سمع (s-m-ʿ)\n  * Lisan / Ayn: Core root meaning: hearing, listening, perceiving by the ear; also used for answering/accepting a supplication.\n  * Al-Raghib (Mufradat): Hearing as a physical sense perception; in theological usage, al-samʿ (revelation/textual report) is contrasted with al-ʿaql (reason) as a source of knowledge — precisely the dichotomy Ghazali invokes here.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): auditory perception. Metaphorical (majāz): obedience, acceptance, or the revealed text itself (al-samʿ = the transmitted revelation).\n- Root: طيب (ṭ-y-b)\n  * Lisan / Ayn: Core root meaning: goodness, pleasantness, purity, lawfulness.\n  * Al-Raghib (Mufradat): \"That which the senses and the soul find pleasurable\"; in legal-theological terms, what is lawful (ḥalāl) and wholesome — both immediately and in its ultimate consequence.\n  * Al-Zamakhshari (Asas): Literal: pleasant to the senses. Metaphorical: lawful (ḥalāl), pure, free of taint — as in \"ṭāba lī kadhā\" (this became lawful/pleasant for me).\n- Root: قيس (q-y-s)\n  * Lisan / Ayn: Core root meaning: measuring, estimating, comparing.\n  * Al-Raghib (Mufradat): Qiyās in juristic theology: analogical extension of a ruling from an original case (al-aṣl) to a subsidiary case (al-farʿ) based on shared effective cause (ʿillah).\n  * Al-Zamakhshari (Asas): Literal: measurement by measure or rod. Metaphorical: intellectual analogy and juridical reasoning.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — governing the periodic suspension of grammatical completion to allow for parenthetical or conditional insertions, as in Ghazali's layered conditional structures.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Audition and Ecstasy'", "badge": "Insight"}], "228": [{"arabic": "وعوتب مرة أخرى فقال ما يمنعني من التزويج إلا قوله تعالى {ولهن مثل الذي عليهن بالمعروف} فذكر ذلك لأحمد فقال وأين مثل بشر إنه قعد على مثل حد السنان ومع ذلك فقد روي انه رؤي في المنام فقيل له ما فعل الله بك فقال رفعت منازلي في الجنة وأشرف بي على مقامات الأنبياء ولم أبلغ منازل المتأهلين وفي رواية قال لي ما كنت أحب أن تلقاني عزبا قال فقلنا له ما فعل أبو نصر التمار فقال رفع فوقي بسبعين درجة قلنا بماذا فقد كنا نراك فوقه قال بصبره على بنياته والعيال وقال سفيان بن عيينة كثرة النساء ليست من الدنيا لأن عليا رضي الله عنه كان أزهد أصحاب رسول ال", "english": "As for the reports [of the Companions], ʿUmar — may God be pleased with him — said: \"Nothing prevents marriage except incapacity or lewdness.\" Thus he made clear that religiosity is not a barrier to it, and he restricted the preventatives to two blameworthy matters [only].", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 295", "section_title_en": "The Virtue of Marriage — Reports and Traditions of the Companions and Early Saints", "section_index": 295, "anchors": "- Root: نكح (n-k-ḥ)\n  * Lisan / Ayn: Core root meaning: sexual intercourse; by extension, the marriage contract (al-ʿaqd) that renders it licit. Al-Farahidi notes the root's primary physical sense, with the legal meaning derived therefrom.\n  * Al-Raghib (Mufradat): In theological usage, nikāḥ denotes the lawful bond (al-ʿaqd al-sharʿī) that channels the sexual drive (shahwah) within divinely sanctioned bounds, serving as a fortress for faith (ḥiṣn li-l-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the contract of marriage. Metaphorical (majāz): sometimes used for the act of intercourse itself, as in the Qur'anic verse {حتى تنكح زوجا غيره} — where the literal sense is the contract, and the consummation is understood contextually.\n- Root: عزب (ʿ-z-b)\n  * Lisan / Ayn: Core root meaning: being alone, unmarried, without a spouse; a bachelor (aʿzab) or a woman without a husband (ʿazbāʾ). The state of ʿuzūbah (celibacy/bachelorhood).\n  * Al-Raghib (Mufradat): The state of being without a spouse — not inherently blameworthy in itself, but rendered undesirable when it leads to neglect of the prophetic way (sunnah) or exposure to temptation.\n  * Al-Zamakhshari (Asas): Literal: the factual state of being unmarried. Metaphorical: \"I dislike to meet God as a bachelor (ʿazban)\" — meaning to stand before God having neglected the prophetic command to marry, thus meeting Him in a state of incompleteness.\n- Root: وسم (w-s-m)\n  * Lisan / Ayn: Core root meaning: to mark, brand, stamp; to leave a distinguishing trace. From this: wasm (mark), sīmah (distinguishing sign), and tawassama (to perceive a sign, to discern, to anticipate from visible indications).\n  * Al-Raghib (Mufradat): In cognitive contexts, tawassama means to perceive an inner state from outward signs — a form of intuitive discernment (firāsah) by which the Prophet perceived the Companion's genuine need for marriage beneath his protestations of poverty.\n  * Al-Zamakhshari (Asas): Literal: branding animals with a distinguishing mark. Metaphorical: \"He discerned in him (tawassama fīhi) the need for marriage\" — reading the inward disposition from outward circumstances, a figurative extension of perceiving marks.\n- Root: فضل (f-ḍ-l) — [Note: listed as recently used, but required for this passage's central argument]\n  * Lisan / Ayn: Core root meaning: surplus, excess, abundance; that which remains beyond what is required. From this: excellence, superiority, merit (faḍl).\n  * Al-Raghib (Mufradat): In theological usage, faḍl denotes supererogatory merit — an act's capacity to draw one nearer to God beyond mere obligation, as distinct from farḍ (the obligatory).\n  * Al-Zamakhshari (Asas): Literal: surplus over a measure. Metaphorical: \"He saw in marriage a merit (faḍlan)\" — not merely as a defensive measure against lust, but as a positive act of worship bearing its own reward.\n- Sibawayh Rule: Rule of Repetition for Emphasis (Bāb al-Takrīr lil-Tawkīd) — The Prophet's thrice-repeated command \"Will you not marry?\" (alā tatazawwaj) followed by the Companion's thrice-repeated refusal, then his resolution — demonstrates that repetition in Arabic serves both emphasis and narrative progression, each iteration building toward the climactic resolution.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Marriage'", "badge": "Insight"}, {"arabic": "الأول تعجيل الطعام فذلك من إكرام الضيف وقد قال صلى الله عليه وسلم من كان يؤمن بالله واليوم الآخر فليكرم ضيفه (1) ومهما حضر الأكثرون وغاب واحد أو اثنان وتأخروا عن الوقت الموعود فحق الحاضر في التعجيل أولى من حق أولئك في التأخير إلا أن يكون المتأخر فقيرا أو ينكسر قلبه بذلك فلا بأس في التأخير وأحد المعنيين في قوله تعالى {هل أتاك حديث ضيف إبراهيم المكرمين} أنهم أكرموا بتعجيل الطعام إليهم دل عليه قوله تعالى {فما لبث أن جاء بعجل حنيذ} وقوله {فراغ إلى أهله فجاء بعجل سمين} والروغان الذهاب بسرعة وقيل في خفية وقيل جاء بفخذ من لحم وإنما سمي ع", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Mysteries of Prayer'", "badge": "Hadith"}], "229": [{"arabic": "قال تعالى {فلا جناح عليهما فيما افتدت به} فرد ما أخذته فما دونه لائق بالفداء فإن سألت الطلاق بغير ما بأس فهي آثمة قال صلى الله عليه وسلم أيما امرأة سألت زوجها طلاقها من غير ما بأس لم ترح رائحة الجنة (3) وفي لفظ آخر فالجنة عليها حرام وفي لفظ آخر أنه صلى الله عليه وسلم قال المختلعات هن المنافقات (4) ثم ليراع الزوج في الطلاق أربعة أمور الأول أن يطلقها في طهر لم يجامعها فيه فإن الطلاق في الحيض أو الطهر الذي جامع يدعى حرام وإن كان واقعا لما فيه من تطويل العدة عليها فإن فعل ذلك فليراج", "english": "**The third:** Fear of excessive hardship (ḥaraj) due to the multitude of children, and guarding against the need for toil in earning a livelihood and entering into evil means of acquisition. This also is not prohibited, for the paucity of hardship assists one in religion. Indeed, perfection and excellence lie in trust in God (tawakkul) and confidence in God's guarantee, where He said: {«وما من دابة في الأرض إلا على الله رزقها»} \"And there is no creature on earth but that upon Allah is its provision\" [Hūd: 6]. Without doubt, in this [trust] there is a falling from the summit of perfection and an abandonment of what is more excellent — but looking to consequences and preserving wealth and storing it up, despite its contradicting tawakkul, we do not say it is prohibited.", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 307", "section_title_en": "** On Coitus Interruptus ('Azl), Its Intentions, and the Etiquettes of Childbirth and Divorce", "section_index": 307, "anchors": "**\n- Root: عزل (ʿazl)\n  * Lisan / Ayn: Separation, removal, setting aside\n  * Al-Raghib (Mufradat): Withdrawal to prevent conception\n  * Al-Zamakhshari (Asas): Literal: physical separation; Metaphorical: preventing pregnancy\n- Root: وأد (waʾad)\n  * Lisan / Ayn: Burying a female infant alive (pre-Islamic practice)\n  * Al-Raghib (Mufradat): The killing of daughters by burial\n  * Al-Zamakhshari (Asas): Literal: burial alive; Metaphorical: any prevention of life\n- Root: طلق (ṭalaq)\n  * Lisan / Ayn: Divorce; dissolution of marriage bond\n  * Al-Raghib (Mufradat): Legal dissolution of the marriage contract\n  * Al-Zamakhshari (Asas): Literal: releasing/loosing; Metaphorical: dissolution of marriage\n- Sibawayh Rule: Conditional clauses with \"فإن قلت\" (objection-response dialectic structure)\n\n---\n\n**", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Etiquette of Marriage'", "badge": "Afterlife"}], "231": [{"arabic": "وتعليق وأنا أيضا ربما انتهت بي الرياضة والمواظبة إليه ومن ظن ذلك فقد ظلم نفسه وضيع عمره بل هو كمن يترك طريق الكسب والحراثة رجاء العثور على كنز من الكنوز فإن ذلك ممكن ولكنه بعيد جدا فكذلك هذا وقالوا لا بد أولا من تحصيل ما حصله العلماء وفهم ما قالوه ثم لا بأس بعد ذلك بالانتظار لما لم ينكشف لسائر العلماء فعساه ينكشف بعد ذلك بالمجاهدة", "english": "As for the speculative theologians (nuẓẓār) and the people of reflective consideration (iʿtibār), they did not deny the existence of this path, nor its possibility, nor its leading to this goal — albeit rarely. For it is the predominant state of the prophets and the friends of God. However, they deemed this path arduous, they deemed its fruit slow to ripen, and they deemed the gathering of its conditions unlikely. And they claimed that the erasure of worldly attachments (ʿalāʾiq) to that extreme degree is well-nigh impossible; and even if it were attained in a given moment, its persistence is even more improbable, for the slightest whisper (waswās) or passing thought (khaṭir) disturbs the heart. And the Messenger of God, peace and blessings be upon him, said: «قلب المؤمن أشد تقلبا من القدر في غليانها» — \"The heart of the believer is more restless in its turning than a boiling pot.\" (Narrated by Aḥmad and al-Ḥākim.) And the hadith: «قلب المؤمن بين إصبعين من أصابع الرحمن» — \"The heart of the believer is between two fingers of the Merciful.\" (Narrated by Muslim, from the hadith of ʿAbd Allāh ibn ʿUmar.)", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 590", "section_title_en": "Clarifying the Distinction Between Divine Inspiration (Ilhām) and Learning (Taʿallum), and the Difference Between the Path of the Sufis in Uncovering Truth and the Path of the Speculative Theologians (Nuẓẓār)", "section_index": 590, "anchors": "- Root: ومض (wamada)\n  * Lisan / Ayn: Core meaning is the swift, fleeting flash of lightning that flares and vanishes.\n  * Al-Raghib (Mufradat): Denotes an instantaneous, non-acquired perception — a divine influx that seizes the heart without prior effort.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the lightning flash itself; metaphorically (Majaz), it designates the sudden illumination of the heart by a spiritual reality that does not persist.\n- Root: صفا (ṣafā)\n  * Lisan / Ayn: Purity and clarity after turbidity; the essence of something once its dregs are removed.\n  * Al-Raghib (Mufradat): In the theological context, it signifies the purification of the soul from sensual attachments, rendering it a receptive vessel for divine disclosure.\n  * Al-Zamakhshari (Asas): Literal: clear water or wine. Metaphorical: the heart's transparency achieved through rigorous spiritual discipline (mujāhadah), enabling the reception of subtle realities (laṭā'if).\n- Root: خطر (khaṭara)\n  * Lisan / Ayn: The passing of a thought through the mind; a fleeting notion or suggestion.\n  * Al-Raghib (Mufradat): Refers to the incoming thought (khaṭir) that either disturbs the heart's stillness or, if unchecked, solidifies into a corrupt imagination.\n  * Al-Zamakhshari (Asas): Literal: to pace or traverse. Metaphorical: the \"passing\" of a whisper (waswās) or inspiration across the heart, which can either be repelled or entertained.\n- Root: قلب (qalaba)\n  * Lisan / Ayn: To turn, overturn, or flip a thing from one state to another.\n  * Al-Raghib (Mufradat): The heart (qalb) is so named because of its constant turning (taqallub) between states — a divinely ordained instability that the believer must manage through knowledge.\n  * Al-Zamakhshari (Asas): Literal: to flip a garment or object. Metaphorical: the heart's oscillation between faith and doubt, steadfastness and agitation, as cited in the prophetic tradition.\n- Sibawayh Rule: Rule of Conditional Clauses (Bāb al-Sharṭ) — The protasis (condition) and apodosis (result) are syntactically interlocked, where the apodosis is dependent on the fulfillment of the condition, as in \"If it returns, it may persist\" (wa-in ʿāda fa-qad yathbutu), demonstrating the periodic suspension of certainty upon contingent states.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}, {"arabic": "الكافة بشكر نعمة الكتاب فقال تعالى {واذكروا نعمة الله عليكم وما أنزل عليكم من الكتاب والحكمة يعظكم به} وقال عز وجل لقد أنزلنا إليكم كتابا فيه", "english": "I say: These meanings are buried treasures that are not unveiled except to the divinely aided ones. To this 'Ali — may God be pleased with him — alluded by his saying: \"The Messenger of God — may God's peace and blessings be upon him — did not confide to me anything that he concealed from the people, except that God — mighty and majestic — grants to a servant understanding (fahm) of His Book. So let one be eager in seeking that understanding.\" (1) And Ibn Mas'ud — may God be pleased with him — said: \"Whoever desires the knowledge of the first and the last, let him stir up the Qur'an.\" And the greatest of the sciences of the Qur'an lie beneath the names of God — mighty and majestic — and His attributes, for most of creation have grasped from them only matters befitting their understandings and have not stumbled upon their depths.", "book_title": "Etiquette of Quran Recitation", "section_title_ar": "Section 228", "section_title_en": "The Revival of the Religious Sciences — Section 228: On the Inner Meanings of the Qur'an and the Removal of Obstacles to Understanding", "section_index": 228, "anchors": "- Root: فهم (f-h-m)\n  * Lisan / Ayn: Comprehension, discernment, the faculty by which one grasps meanings\n  * Al-Raghib (Mufradat): \"الفهم: هيئة للإنسان بها يتحقق معاني ما يحسن\" — a disposition by which one verifies the realities of what is perceived; distinct from mere hearing or transmission\n  * Al-Zamakhshari (Asas): Literal: swift apprehension; Metaphorical: the divine gift of insight into hidden meanings, as in the verse {ففهمناها سليمان}\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: Turning, overturning, transformation from one state to another\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart as that which is perpetually turned and overturned between states\n  * Al-Zamakhshari (Asas): Literal: physical turning; Metaphorical: the heart as the seat of understanding that is veiled or illuminated, rusted or polished\n- Root: سمع (s-m-')\n  * Lisan / Ayn: Hearing, the auditory faculty\n  * Al-Raghib (Mufradat): \"السمع: قوة في الأذن به يدرك الأصوات\" — extends metaphorically to comprehension and obedience; \"أو ألقى السمع وهو شهيد\" — one who casts his hearing while present\n  * Al-Zamakhshari (Asas): Literal: auditory perception; Metaphorical: attentive obedience and receptive understanding\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise delimitation of predicates such as \"إنما يتذكر أولوا الألباب\" where restriction confines the action to its proper subject", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Etiquette of Quran Recitation'", "badge": "Insight"}], "232": [{"arabic": "أما من الآيات فقد قال تعالى وانكحوا الأيامى منكم وهذا أمر وقال تعالى فلا تعضلوهن أن ينكحن أزواجهن وهذا منع من العضل ونهي عنه وقال تعالى في وصف الرسل ومدحهم ولقد أرسلنا رسلا من قبلك وجعلنا لهم أزواجا وذرية فذكر ذلك في معرض الامتنان وإظهار الفضل ومدح أولياءه بسؤال ذلك في الدعاء فقال والذين يقولون ربنا هب لنا من أزواجنا وذرياتنا قرة أعين الآية ويقال أن الله تعالى لم يذكر في كتابه من الأنبياء إلا المتأهلين فقالوا إن يحيى صلى الله عليه وسلم قد تزوج ولم يجامع قيل إنما فعل ذلك لنيل الفضل وإقامة السنة وقيل لغض البصر وأما عيسى علي", "english": "As for the verses [of the Qur'an], God Most High has said: {وانكحوا الأيامى منكم} (\"And marry the unmarried among you\") — and this is a command. And He Most High said: {فلا تعضلوهن أن ينكحن أزواجهن} (\"Then do not prevent them from marrying their husbands\") — and this is a prohibition against prevention (al-ʿaḍl) and a forbiddance of it.", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 294", "section_title_en": "Section 294 — Encouragement of Marriage (الترغيب في النكاح)", "section_index": 294, "anchors": "- Root: رغب (raghiba)\n  * Lisan / Ayn: Core meaning denotes \"capacity/amplitude\" — a vessel or receptacle that is wide and receptive; by extension, the inclination of desire toward something with expansive longing.\n  * Al-Raghib (Mufradat): \"الرغبة والرغب والرغبى: السعة في الإرادة\" — the amplitude of the will. When said \"رغب فيه\" it necessitates eagerness for it; when said \"رغب عنه\" it implies the turning away of desire and renunciation (zuhd) of it.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"هو راغب فيه وراغب عنه\" — one is desirous of a thing or averse to it. Metaphorical (Majaz): \"واد رغيب: كثير الأخذ للماء\" — a valley that takes much water; thus the Prophet's \"من رغب عن سنتي\" is a metaphorical extension: one who turns his desire away from the Sunnah, refusing its amplitude.\n- Root: زوج (zawj)\n  * Lisan / Ayn: A pair; each of the two counterparts in a mating couple. Al-Raghib: \"يقال لكل واحد من القرينين من الذكر والأنثى في الحيوانات المتزاوجة زوج\" — each of the two paired ones, male and female, is called a zawj.\n  * Al-Raghib (Mufradat): \"ولكل ما يقترن بآخر مماثلا له أو مضاد زوج\" — everything that is coupled with another, whether similar or opposite, is a pair. \"وزوجة لغة رديئة\" — the form zawjah is a poor dialectal variant.\n  * Al-Zamakhshari (Asas): Literal: \"هو زوجها وهي زوجه وزوجته، وهما زوجان\" — he is her pair and she is his pair. Metaphorical: \"تزاوج الكلامان وازدوجا\" — two speeches are paired/coupled; thus marriage is the pairing of two complementary beings.\n- Root: منع (manaʿa)\n  * Lisan / Ayn: To withhold, prevent, or protect. Al-Raghib: \"المنع يقال في ضد العطية\" — said in opposition to giving; and \"يقال في الحماية\" — said of protection/defense.\n  * Al-Raghib (Mufradat): \"مكان منيع\" — an impregnable place; \"فلان ذو منعة\" — one who is mighty, protected against those who seek him.\n  * Al-Zamakhshari (Asas): Literal: \"منعه الشيء ومنعه منه وعنه\" — to prevent someone from a thing. Metaphorical: \"فلان يمنع الجار: يحميه من أن يضام\" — he protects the neighbor from being wronged. Thus \"عضل\" (prevention of marriage) is the withholding of a woman from her lawful marriage — a form of harmful prevention.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — The Prophet's statements \"النكاح سنتي\" and \"من رغب عن سنتي فقد رغب عني\" employ restrictive predication: the Sunnah is defined by marriage, and aversion to it is equated with aversion to the Prophet himself — a rhetorical equation establishing identity between the act and its source.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Marriage'", "badge": "Du'a"}, {"arabic": "الأول تعجيل الطعام فذلك من إكرام الضيف وقد قال صلى الله عليه وسلم من كان يؤمن بالله واليوم الآخر فليكرم ضيفه (1) ومهما حضر الأكثرون وغاب واحد أو اثنان وتأخروا عن الوقت الموعود فحق الحاضر في التعجيل أولى من حق أولئك في التأخير إلا أن يكون المتأخر فقيرا أو ينكسر قلبه بذلك فلا بأس في التأخير وأحد المعنيين في قوله تعالى {هل أتاك حديث ضيف إبراهيم المكرمين} أنهم أكرموا بتعجيل الطعام إليهم دل عليه قوله تعالى {فما لبث أن جاء بعجل حنيذ} وقوله {فراغ إلى أهله فجاء بعجل سمين} والروغان الذهاب بسرعة وقيل في خفية وقيل جاء بفخذ من لحم وإنما سمي ع", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Mysteries of Prayer'", "badge": "Hadith"}], "235": [{"arabic": "فقيرا عليه خرقتان فقلت في نفسي هذا وأشباهه كل على الناس فناداني وقال والله يعلم ما في أنفسكم فاحذروه فاستغفرت الله في سري فناداني وقال {وهو الذي يقبل التوبة عن عباده} ثم غاب عني ولم أره وقال زكريا بن داود دخل أبو العباس بن مسروق على أبي الفضل الهاشمي وهو عليل وكان ذا عيال ولم يعرف له سبب يعيش به قال فلما قمت قلت في نفسي من أين يأكل هذا الرجل قال فصاح بي يا أبا العباس رد هذه الهمة الدنية فإن لله تعالى ألطافا خفية وقال أحمد النقيب دخلت على الشبلي فقال مفتونا يا أحمد فقلت ما الخبر قال كنت جالسا فجرى بخاطري أنك بخيل فقلت ما أنا بخيل فعاد", "english": "As for the evidences of the Sacred Law, there is His saying (Exalted is He): {«وَالَّذِينَ جَاهَدُوا فِينَا لَنَهْدِيَنَّهُمْ سُبُلَنَا»} (\"And those who strive in Us, We shall surely guide them to Our paths\") (Q. 29:69). So every wisdom that appears from the heart through persevering devotion to worship, without learning, is by way of unveiling and inspiration. And he (peace and blessings be upon him) said: \"Whoever acts upon what he knows, God bequeaths to him knowledge of what he does not know, and grants him success in what he does\" — until he becomes deserving of Paradise. And whoever does not act upon what he knows wanders astray in what he knows and is not granted success in what he does, until he becomes deserving of the Fire. [The hadith \"Whoever acts upon what he knows\" has preceded in the Book of Knowledge, without his saying \"and grants him success in what he does\" — I have not found it with that addition.] And God (Exalted is He) said: {«وَمَنْ يَتَّقِ اللَّهَ يَجْعَلْ لَهُ مَخْرَجًا»} (\"And whoever fears God, He makes for him a way out\") (Q. 65:2) — from perplexities and doubts — {«وَيَرْزُقْهُ مِنْ حَيْثُ لَا يَحْتَسِبُ»} (\"and provides for him from whence he does not reckon\") (Q. 65:3) — teaching him knowledge without learning and granting him discernment without experience. And God (Exalted is He) said: {«يَا أَيُّهَا الَّذِينَ آمَنُوا إِنْ تَتَّقُوا اللَّهَ يَجْعَلْ لَكُمْ فُرْقَانًا»} (\"O you who believe, if you fear God, He will make for you a criterion\") (Q. 8:29) — it is said: a light by which one distinguishes between truth and falsehood and by which one emerges from doubts. For this reason, he (peace and blessings be upon him) was abundant in his supplication in asking for light, saying (peace and blessings be upon him): \"O God, grant me light, and increase me in light, and make for me light in my heart, and light in my grave, and light in my hearing, and light in my sight\" — until he said: \"and light in my hair, and in my skin, and in my flesh, and in my blood, and in my bones.\" [Agreed upon (by al-Bukhari and Muslim).] [The hadith concerning his being asked about His saying {«أَفَمَنْ شَرَحَ اللَّهُ صَدْرَهُ لِلْإِسْلَامِ»} (\"Is he whose breast God has expanded for Islam\") (Q. 39:22) — and in al-Mustadrak from the hadith of Ibn Masʿūd — has preceded in the Book of Knowledge.] And he (peace and blessings be upon him) said concerning Ibn ʿAbbās: \"O God, grant him understanding in religion and teach him the interpretation (taʾwīl).\" [The hadith of ʿAlī: \"We have nothing with us that the Messenger of God (peace and blessings be upon him) confided to us except that God grants a servant understanding in His Book\" — has preceded in the Etiquettes of Qurʾanic Recitation.] And it is said in the interpretation of His saying (Exalted is He): {«يُؤْتِي الْحِكْمَةَ مَنْ يَشَاءُ»} (\"He grants wisdom to whom He wills\") (Q. 2:269) that it is understanding in the Book of God. And He (Exalted is He) said: {«فَفَهَّمْنَاهَا سُلَيْمَانَ»} (\"And We made Solomon understand it\") (Q. 21:79) — singling out what was unveiled with the name of understanding (fahm). And Abū al-Dardāʾ used to say: \"The believer is one who sees by the light of God from behind a thin veil. By God, it is the truth that God casts into their hearts and causes to flow upon their tongues.\" And some of the Salaf said: \"The believer's conjecture is like soothsaying.\"", "book_title": "Disciplining the Soul", "section_title_ar": "Section 594", "section_title_en": "The Unveiling of Knowledge Through Divine Inspiration and the Evidences of the Unseen", "section_index": 594, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning encompasses both perception of a thing's essence and judgment upon it—knowledge as direct apprehension or discursive ruling.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing in its true reality, divided into apprehension of the essence (transitive to one object) and judgment upon existence or non-existence (transitive to two objects).\n  * Al-Zamakhshari (Asas): Literal usage denotes certainty and awareness (\"ما علمت بخبرك: ما شعرت به\"); metaphorical extension applies to marks, signs, and beacons of guidance (معالم الطريق) — here, the inspired knowledge is a \"mark\" of the path.\n- Root: كشف (kashafa)\n  * Lisan / Ayn: To remove a covering, unveil, disclose what was hidden.\n  * Al-Raghib (Mufradat): Unveiling (kashf) in theological terms is the removal of the veil (ghishāwah) from the heart such that the realities of things become directly witnessed, not merely inferred.\n  * Al-Zamakhshari (Asas): Literal: to lift a covering from a thing; metaphorical: the disclosure of inward states and hidden matters — the heart's eye perceives what the outward senses cannot.\n- Root: فرس (farasa)\n  * Lisan / Ayn: To prey upon, devour; farāsah — the lion's pouncing upon its prey.\n  * Al-Raghib (Mufradat): Discernment (farāsah) is a spiritual perception by which the believer penetrates into the inner states of others, a light cast by God into the heart.\n  * Al-Zamakhshari (Asas): Literal: the beast of prey seizing its quarry; metaphorical: the believer's insight seizing the truth of a matter or the hidden state of a person — \"اتقوا فراسة المؤمن فإنه ينظر بنور الله.\"\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: To be new, originate after non-existence; muḥaddath — one who is spoken to, inspired with true speech from the unseen.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence; the muḥaddath is one to whom divine inspiration comes as a new, immediate occurrence without acquired means.\n  * Al-Zamakhshari (Asas): Literal: newness of a thing; metaphorical: \"كان عمر رضي الله عنه محدثا أي صادق الحدس، كأنما حدث بما ظن\" — one whose intuition is so true it is as if he were directly spoken to.\n- Sibawayh Rule: Restriction and specification (الحصر والتقييد) — the particle \"إنما\" and conditional clauses (إن/إذا) restrict predicates to their subjects, as in \"إنما العالم الذي يأخذ علمه من ربه\" — the true scholar is exclusively the one who takes knowledge from his Lord.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "بعيدا ويحذركم الله نفسه} وقال تعالى {واعلموا أن الله يعلم ما في أنفسكم فاحذروه} فعرف أرباب البصائر من جملة العباد أن الله تعالى لهم بالمرصاد وأنهم سيناقشون في الحساب ويطالبون بمثاقيل الذر من الخطرات واللحظات وتحققوا أنه لا ينجيهم من هذه الأخطار إلا لزوم المحاسبة وصدق المراقبة ومطالبة النفس في الأنفاس والحركات ومحاسبتها في الخطرات واللحظات فمن حاسب نفسه قبل أن يحاسب خف في القيامة حسابه وحضر عند السؤال جوابه وحسن منقلبه ومآبه ومن لم يحاسب نفسه دامت حسراته وطالت في عرصات القيامة وقفاته وقادته إلى الخزي والمقت", "english": "To proceed: God Most High has said: {And We shall set up the scales of justice for the Day of Resurrection, so no soul shall be wronged in anything; and if it be the weight of a grain of mustard seed, We shall bring it forth, and sufficient are We as Reckoners} (21:47). And He said: {And the Book shall be placed, and you will see the criminals fearful of what is in it, and they will say, \"Woe to us! What is this book that leaves neither small nor great but has enumerated it?\" And they will find what they did present, and your Lord wrongs no one} (18:49). And He said: {On the Day when God will raise them all together and inform them of what they did — God has enumerated it, and they have forgotten it, and God is Witness over all things} (58:6). And He said: {On that Day, people will issue forth in scattered groups to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it} (99:6-8). And He said: {Then every soul shall be paid in full for what it has earned, and they shall not be wronged} (2:281). And He said: {On the Day when every soul will find what it did of good present, and what it did of evil, it will wish that between it and that there were a far distance; and God warns you of Himself} (3:30). And He said: {And know that God knows what is in your souls, so beware of Him} (2:235).", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1230", "section_title_en": "Exposition of the Reality of Truthfulness (Al-Sidq), Its Meaning, and Its Grades — Book of Vigilance and Self-Reckoning, Being the Eighth Book of the Quarter of Deliverance from the Revival of the Religious Sciences", "section_index": 1230, "anchors": "- Root: رقب (Raqaba)\n  * Lisan / Ayn: To watch, guard, observe; a watcher (raqīb) is one who stands vigilant over something, awaiting its occurrence.\n  * Al-Raghib (Mufradat): Raqaba denotes protective watchfulness; al-raqīb is a divine attribute signifying His perpetual oversight of all that transpires, with no moment of neglect.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical watching/awaiting. Metaphorical (majāz): \"This matter is upon your necks (fī riqābikum)\" — i.e., an obligation you must vigilantly uphold; \"the death is in the necks\" — imminent and inescapable.\n- Root: حسب (Hasaba)\n  * Lisan / Ayn: To count, reckon, compute; al-ḥisāb is the act of enumeration and settlement of accounts.\n  * Al-Raghib (Mufradat): Al-ḥisāb is the employment of number; divine reckoning (ḥisāb) on the Day of Resurrection is the exacting appraisal of deeds, even to the atom's weight.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"they reckon news (yaḥtasibūna al-akhbār)\" — they investigate and ascertain, as one places knowledge in place of conjecture.\n- Root: قلب (Qalaba)\n  * Lisan / Ayn: To turn, overturn, transform; the heart (qalb) is so named for its constant fluctuation and turning of states.\n  * Al-Raghib (Mufradat): Qalaba is the turning of a thing from one state to another; the heart's inner thoughts (khaṭarāt) are its successive movements, which God surveys.\n  * Al-Zamakhshari (Asas): Literal: turning a garment or object. Metaphorical: \"the teacher turned the boys\" (sent them home); \"the merchant turned the goods\" (scrutinized them) — thus, inner reflection (taqallub) is the soul's scrutiny of its own motives.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"إنما يحاسبهم لتعلم كل نفس\" — the sole purpose of reckoning is specified, excluding all other ends.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}], "237": [{"arabic": "وأعرض عن الجاهلين وقال الله تعالى وأن تعفوا أقرب للتقوى وقال رسول الله صلى الله عليه وسلم ثلاث والذي نفسي بيده لو كنت حلافا لحلفت عليهن ما نقص مال من صدقة فتصدقوا ولا عفا رجل عن مظلمة يبتغي بها وجه الله إلا زاده الله بها عزا يوم القيامة ولا فتح رجل على نفسه باب مسألة إلا فتح الله عليه باب فقر (1) حديث التواضع لا يزيد العبد إلا رفعة فتواضعوا يرفعكم الله أخرجه الأصفهاني في الترغيب والترهيب وأبو منصور الديلمي في مسند الفردوس من حديث أنس بسند ضعيف (2) حديث عائشة ما رأيت رسول الله صلى الله عليه وسلم منتصرا", "english": "I say: Know that when anger (ghaḍab) is compelled to be suppressed due to one's inability to exact vengeance at the moment, it returns to the inward self and becomes congealed therein, thus turning into resentment (ḥiqd). The meaning of resentment is that the heart becomes persistently burdened with the weight of the other, harboring aversion and hostility toward him, and that this state endures and remains. The Prophet, peace and blessings be upon him, said: \"The believer is not resentful\" (1). Thus, resentment is the fruit of anger, and resentment in turn bears eight things:", "book_title": "Condemnation of Envy", "section_title_ar": "Section 713", "section_title_en": "On the Meaning of Resentment (Ḥiqd), Its Consequences, and the Virtue of Pardon (ʿAfw) and Gentleness (Rifq)", "section_index": 713, "anchors": "- Root: حقد (Ḥ-Q-D)\n  * Lisan / Ayn: Core root meaning: to conceal rancor or malice in the heart, to harbor hidden enmity; the latent retention of anger within the breast.\n  * Al-Raghib (Mufradat): Theological nuance: ḥiqd is the internalized residue of anger (ghaḍab) that persists when one is unable to exact vengeance; it is a moral corruption of the heart's faculty, opposed to the prophetic character which is free of it.\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: Literally, it denotes the concealed kindling of hostility; metaphorically, it is the \"congealing\" of wrath in the inward self, distinguishing it from overt acts of retaliation.\n- Root: عفو (ʿ-F-W)\n  * Lisan / Ayn: Core root meaning: to leave something, to forgo, to erase; to pardon a debt or offense; to exceed the ordinary measure.\n  * Al-Raghib (Mufradat): Theological nuance: ʿafw is the deliberate cancellation of a rightful claim (ḥaqq) against another, whether retaliation (qiṣāṣ) or financial recompense; it is an act of moral excellence (faḍl) above strict justice (ʿadl).\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: Literally, it refers to the remission of a due; metaphorically, it signifies the soul's elevation above vindictiveness, aligning with divine pardon.\n- Root: رفق (R-F-Q)\n  * Lisan / Ayn: Core root meaning: gentleness, lenity, kindness in action and speech; the opposite of harshness (ʿunf).\n  * Al-Raghib (Mufradat): Theological nuance: rifq is a praiseworthy disposition that softens interpersonal conduct and is a mark of divine love, as the Prophet said, \"God is Gentle and loves gentleness.\"\n  * Al-Zamakhshari (Asas): Literal vs Metaphorical: Literally, it is physical tenderness; metaphorically, it is the moral virtue of forbearance in dealing with others' faults.\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (Interposition between Subject and Predicate) — Governing the periodic structure where conditional clauses (e.g., \"if he is able\") are interposed to clarify the logical sequence of moral states.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Envy'", "badge": "Insight"}, {"arabic": "الموسر على ما في يده ولم يؤمر بذلك قال الله تعالى ولا تنسوا الفضل بينكم وقال عبد اللهبن عمرو الشح أشد من البخل لأن الشحيح هو الذي يشح على ما في يد غيره حتى يأخذه ويشح بما في يده فيحبسه والبخيل هو الذي يبخل بما في يده وقال الشعبي لا أدري أيهما أبعد غورا في نار جهنم البخل أو الكذب وقيل ورد على أنوشروان حكيم الهند وفيلسوف الروم فقال للهندي تكلم فقال خير الناس من ألفى سخيا وعند الغضب وقورا وفي القول متأنيا وفي الرفعة متواضعا وعلى كل ذي رحم مشفقا وقام الرومي فقال من كان بخيلا ورث عدوه ماله ومن قل شكره لم ينل النجح و", "english": "God the Exalted said: {«And whoever is saved from the covetousness of his own soul — those are the successful»} (al-Hashr 59:9). And He said the Exalted: {«And let not those who withhold stingily what God has given them of His bounty suppose that it is good for them. Rather, it is evil for them. They shall be collared with what they withheld on the Day of Resurrection»} (Al 'Imran 3:180). And He said the Exalted: {«Those who are stingy and command people to stinginess, and conceal what God has given them of His bounty»} (al-Nisa' 4:37).", "book_title": "Condemnation of Miserliness and Love of Wealth", "section_title_ar": "Section 773", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 773: On the Condemnation of Stinginess (Al-Bukhl) and Covetousness (Al-Shuhh)", "section_index": 773, "anchors": "- Root: بخل (B-Kh-L)\n  * Lisan / Ayn: Core meaning is withholding or restraining that which one possesses from what does not rightfully permit its detention. Al-Khalil notes: \"بَخِلَ بَخَلاً وبُخْلاً فهو بَخِيلٌ بَخَّالٌ مُبَخِّلٌ. والبَخْلَةُ: بُخْلُ مَرَّةٍ وَاحِدَةٍ.\"\n  * Al-Raghib (Mufradat): \"البخل: إمساك المقتنيات عما لا يحق حبسها عنه، ويقابله الجود... والبخل ضربان: بخل بقنيات نفسه، وبخل بقنيات غيره، وهو أكثرها ذما.\" — Stinginess is of two kinds: withholding one's own possessions, and withholding what belongs to others (i.e., covetousness, shuhh), the latter being more blameworthy.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"فلان لم يبخل ولم يبخل، وما كانت منه بخلة قط.\" Metaphorical (Majaz): \"إذا السماء بخلت بالفطر\" — the sky \"withholding\" rain is a metaphorical extension of the root.\n- Root: شح (Sh-H-H)\n  * Lisan / Ayn: The root denotes intense covetousness combined with avarice — a grasping desire for what others possess alongside a tight-fisted withholding of one's own.\n  * Al-Raghib (Mufradat): The distinction between shuhh and bukhl: shuhh is the more severe — it is the inner disposition of craving that drives one to seize what is in others' hands and to cling to what is in one's own; bukhl is its outward manifestation in withholding.\n  * Al-Zamakhshari (Asas): The rhetorical usage in the hadith \"اتقوا الشح\" employs the term in its comprehensive sense, encompassing both the inward vice and its outward acts.\n- Root: ظلم (Z-L-M)\n  * Lisan / Ayn: The root signifies placing something in other than its proper position; darkness (zulmah) is its sensory correlate.\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور... ويعبر بها عن الجهل والشرك والفسق\" — darkness is used metaphorically for ignorance, polytheism, and transgression.\n  * Al-Zamakhshari (Asas): Literal: \"الظلم ظلمات يوم القيامة\" — injustice is darknesses on the Day of Resurrection. Metaphorical: \"أرض مظلومة: حفر فيها بئر\" — a land \"wronged\" by being dug into for the first time.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a governing word and its governed prepositional phrase, as in the hadith \"إياكم والشح فإنه أهلك من كان قبلكم,\" where the warning construction (إياكم) governs the subsequent clause with rhetorical emphasis.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Condemnation of Miserliness and Love of Wealth'", "badge": "Ethics"}], "243": [{"arabic": "كمن قال الله تعالى فيهم ألم تر إلى الذين خرجوا من ديارهم وهم ألوف حذر الموت فرجعوا إلى عمر فسألوه عن رأيه فقال نرجع ولا ندخل على الوباء فقال له المخالفون في رأيه أنفر من قدر الله تعالى قال عمر نعم نفر من قدر الله إلى قدر الله ثم ضرب لهم مثلا فقال أرأيتم لو كان لأحدكم غنم فهبط واديا له شعبتان: إحداهما مخصبة: والأخرى مجدبة أليس إن رعى المخصبة رعاها بقدر الله تعالى وإن رعى المجدبة رعاها بقدر الله تعالى فقالوا: نعم ثم طلب عبد الرحمن بن عوف ليسأله عن رأيه وكان غائبا فلما أصبحوا جاء عبد الرحمن فسأله عمر عن ذلك فقال:", "english": "If someone were to say: \"The Messenger of God, peace be upon him, only did this (i.e., used medicine) to establish the precedent for others — otherwise, it is the way of the weak; whereas the station of the strong necessitates trust in God (tawakkul) by abandoning medicine\" — then it is said to him: It would follow that abandoning cupping (ḥijāmah) and venesection (faṣd) at the time of blood excess should also be a condition of trust in God.", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1141", "section_title_en": "The Subtle Distinction Between Trust in God and the Use of Means — The Plague Narrative and the Prophet's Example", "section_index": 1141, "anchors": "- Root: وبأ (waba')\n  * Lisan / Ayn: [Pestilence, widespread deadly disease; from 'wabi'a' — land afflicted with plague]\n  * Al-Raghib (Mufradat): [Divine affliction sent as trial; carries theological weight of predestined calamity]\n  * Al-Zamakhshari (Asas): [Literal: epidemic illness; Metaphorical: the 'sting' of destiny penetrating the land]\n- Root: فرر (farara)\n  * Lisan / Ayn: [Flight, escape from danger]\n  * Al-Raghib (Mufradat): [Contrasted with 'firar min al-zahf' (flight from battle ranks) — a grave sin; here nuanced as permissible avoidance]\n  * Al-Zamakhshari (Asas): [Literal: physical fleeing; Metaphorical: fleeing from one decree of God to another decree of God]\n- Sibawayh Rule: باب الاستفهام التقريري (Interrogative of Acquiescence — 'a-laysa...'): [Rhetorical question demanding assent, used by 'Umar to establish the parity of all divinely ordained means]", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Monotheism and Reliance'", "badge": "Afterlife"}], "245": [{"arabic": "بعبادة القرض فقال من ذا الذي يقرض الله قرضا حسنا فإن قلت قولك إن بقاء النسل والنفس محبوب يوهم أن فناءها مكروه عند الله وهو فرق بين الموت والحياة بالإضافة إلى إرادة الله تعالى ومعلوم أن الكل بمشيئة الله وأن الله غني عن العالمين فمن أين يتميز عنده موتهم عن حياتهم أو بقاؤهم عن فنائهم فأعلم أن هذه الكلمة حق أريد بها باطل فإن ما ذكرناه لا ينافي إضافة الكائنات كلها إلى إرادة الله خيرها وشرها ونفعها وضرها ولكن المحبة والكراهية يتضادان وكلاهما لا يضادان الإرادة فرب مراد مكروه ورب مراد محبوب فالمعاصي مكروهة و", "english": "وقال صلى الله عليه وسلم: \"لا يلقى الله أحد بذنب أعظم من جهالة أهله.\"", "book_title": "Patience and Gratitude", "section_title_ar": "Section 296", "section_title_en": "Section 296", "section_index": 296, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}], "247": [{"arabic": "ممتنا بذلك {وزاده بسطة في العلم والجسم} ولسنا نعني بالجمال ما يحرك الشهوة فإن ذلك أنوثة وإنما نعني به ارتفاع القامة على الاستقامة مع الاعتدال في اللحم وتناسب الأعضاء وتناصف خلقة الوجه بحيث لا تنبو الطباع عن النظر إليه فإن قلت فقد أدخلت المال والجاه والنسب والأهل والولد في حيز النعم وقد ذم الله تعالى المال والجاه وكذا رسول صلى الله عليه وسلم حديث ذم المال والجاه أخرجه الترمذي من حديث كعب بن مالك ما ذئبان جائعان أرسلا في غنم بأفسد لها من حب المال والشرف لدينه وقد تقدم في ذم المال وا", "english": "If you say: \"Is the nobility of one's clan and the honor of one's family among the blessings (ni'am) or not?\" — I say: Yes. For this reason, he, peace and blessings be upon him, said: \"The leaders (a'immah) are from Quraysh\" (1). And for this reason, he, peace and blessings be upon him, was of the most noble of people in root (arumah) within the lineage of Adam, upon him peace. Regarding the hadith \"The Messenger of Allah, peace and blessings be upon him, was of the most noble of people in arumah\" — al-arumah means the origin (asl); this is well known. Muslim narrated from the hadith of Wathilah ibn al-Asqa', raised to the Prophet (marfu'): \"Indeed, Allah chose Kinanah from the descendants of Isma'il, and chose Quraysh from Kinanah, and chose from Quraysh the Banu Hashim, and chose me from the Banu Hashim.\" In the narration of al-Tirmidhi: \"Indeed, Allah chose Isma'il from the descendants of Ibrahim.\" And from him (al-Tirmidhi) is the hadith of al-'Abbas — which he deemed good (hasan) — and of Ibn 'Abbas and al-Muttalib ibn Rabi'ah — which he authenticated (sahih) — and of al-Muttalib ibn Abi Wada'ah — which he deemed good — : \"Indeed, Allah created the creation and made me from the best of them.\" In the hadith of Ibn 'Abbas: \"What is the matter with people who debase their origin? By Allah, I am the most excellent of them in origin and the best of them in standing.\" And he, peace and blessings be upon him, said: \"Choose for your sperm the suitable (akfa') [women]\" (2). The hadith \"Seek good from those with beautiful faces\" was narrated by Abu Ya'la from the narration of Isma'il ibn 'Ayyash, from Khayrah bint Muhammad ibn Thabit ibn Siba', from her mother 'A'ishah — but Khayrah and her mother, I do not know their condition (i.e., reliability). Ibn Hibban narrated it from another chain among the weak narrators, and al-Bayhaqi in al-Shu'ab from the hadith of Ibn 'Umar; it has chains, all of them weak. // And 'Umar, may Allah the Exalted be pleased with him, said: \"When you send a messenger, seek him to be beautiful of face and beautiful of name.\" And the jurists (fuqaha') said: \"When the ranks of those praying are equal, then the most beautiful of them in face is the most deserving of leading the prayer (imamah).\" And Allah the Exalted said, bestowing this as a favor: {وَزَادَهُ بَسْطَةً فِي الْعِلْمِ وَالْجِسْمِ} [And increased him in abundance in knowledge and body] (Al-Baqarah: 247). And we do not mean by beauty that which stirs lust — for that is effeminacy (unuthah) — but rather we mean tallness of stature with uprightness, along with moderation of flesh, proportionality of limbs, and symmetry of the facial constitution, such that natural temperaments do not recoil from looking upon it.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 997", "section_title_en": "On Nobility of Lineage, Beauty, Wealth, and Status as Divine Blessings — With the Parable of the Serpent and the Pearl-Diver", "section_index": 997, "anchors": "- Root: كرم (karuma)\n  * Lisan / Ayn: Generosity, honor, nobility of origin; \"الكريم\" as the noble one whose lineage is pure and whose character is exalted.\n  * Al-Raghib (Mufradat): Nobility (karam) as an ontological elevation in rank, whether by lineage (hasab) or by virtue (hasanah), aligning with divine selection (istifa').\n  * Al-Zamakhshari (Asas): Literal: physical and moral nobility. Metaphorical: \"كرم الله فلانا\" — divine ennoblement through choice and favor.\n- Root: نعم (ni'mah)\n  * Lisan / Ayn: \"النعمة: الحالة الحسنة\" — a state of well-being; \"النعماء\" abundance; \"أنعم\" to bestow favor.\n  * Al-Raghib (Mufradat): Ni'mah as the good state (al-halat al-hasanah), both sensory and intellectual; divine blessings are uncountable {وَإِن تَعُدُّوا نِعْمَتَ اللَّهِ لَا تُحْصُوهَا} [Ibrahim: 34].\n  * Al-Zamakhshari (Asas): Literal: \"جلت نعمة الله\" — manifest favor. Metaphorical: \"خفت نعامتهم\" — their blessings departed, showing ni'mah as a dynamic, transferable reality.\n- Root: مثل (mathala)\n  * Lisan / Ayn: Likeness, similitude, example; \"المثل\" as the illustrative paradigm.\n  * Al-Raghib (Mufradat): \"المثل: القول السائر المشتمل على تشبيه\" — a proverb or parable conveying a hidden truth through analogy.\n  * Al-Zamakhshari (Asas): Literal: physical resemblance. Metaphorical: the parable (mathal) as a vehicle for abstract moral instruction, as in the Qur'anic \"ضرب الله مثلا\".\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Used in the citation {إِنَّمَا أَمْوَالُكُمْ وَأَوْلَادُكُمْ فِتْنَةٌ} to restrict wealth and children to the category of trial, not absolute evil, requiring contextual specification (takhsis).", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Patience and Gratitude'", "badge": "Hadith"}, {"arabic": "يهودي يخبرني عن التوراة فقدم علي اليهودي من سفر فقلت إن الله قد بعث فينا نبيا فدعانا إلى الإسلام فأسلمنا وقد أنزل علينا كتابا مصدقا للتوراة فقال اليهودي صدقت ولكنكم لا تستطيعون أن تقوموا بما جاءكم به إنا نجد نعته ونعت أمته في التوراة إنه لا يحل لامريء أن يخرج من عتبة بابه وفي قلبه سخيمة على أخيه المسلم ومن ذلك أن يسكت عن إفشاء سره الذي استودعه وله أن ينكره وإن كان كاذبا فليس الصدق واجبا في كل مقام فإنه كما يجوز للرجل أن يخفي عيوب نفسه وأسراره وإن احتاج إلى الكذب فله أن يفعل ذلك في حق أخيه فإن أخاه نازل منزلته وهما كشخص وا", "english": "Anas said: \"The Prophet (peace and blessings be upon him) never confronted anyone with something he disliked.\" — The ḥadīth of Anas: \"He never confronted anyone with something he disliked\" — narrated by Abū Dāwūd, al-Tirmidhī in al-Shamāʾil, and al-Nasāʾī in al-Yawm wa al-Laylah with a weak chain.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 419", "section_title_en": "On Silence Regarding the Faults of Brothers — The Rights of Brotherhood (Section 419)", "section_index": 419, "anchors": "- Root: سكت (s-k-t)\n  * Lisan / Ayn: Core meaning of silence, refraining from speech; al-sukūt is the cessation of utterance, whether by tongue or by heart.\n  * Al-Raghib (Mufradat): Theological nuance — silence as a positive act of restraint (imsāk) that guards the tongue from what Allah has forbidden, paralleling the heart's silence from evil suspicion.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — refraining from audible speech; Metaphorical (majāz) — the heart's silence, i.e., refraining from passing judgment on a brother's actions when a good interpretation is possible.\n- Root: غيب (gh-y-b)\n  * Lisan / Ayn: That which is absent or hidden; ghībah (backbiting) is mentioning a brother in his absence with what he dislikes.\n  * Al-Raghib (Mufradat): Ghībah is a violation of the unseen honor (ʿirḍ) of the Muslim, which the Law has rendered inviolable like blood and property.\n  * Al-Zamakhshari (Asas): Literal — speaking of the absent; Metaphorical — the heart's backbiting (sūʾ al-ẓann), i.e., conceiving evil of a brother without certain knowledge.\n- Root: ظن (ẓ-n-n)\n  * Lisan / Ayn: Doubt, suspicion, or belief not founded on certainty; ẓann is the inclination of the soul toward one of two possibilities.\n  * Al-Raghib (Mufradat): In the Qur'anic context, \"avoid much suspicion\" {«إِنَّ بَعْضَ الظَّنِّ إِثْمٌ»} — the blameworthy suspicion is that which attributes evil to a believer without a decisive sign (amārah).\n  * Al-Zamakhshari (Asas): Literal — conjecture; Metaphorical — the heart's ghībah, for just as the tongue can wound, so too can the heart's presumption.\n- Root: ستر (s-t-r)\n  * Lisan / Ayn: To cover, conceal; sitr is the act of veiling a fault or defect.\n  * Al-Raghib (Mufradat): Allah's attribute al-Sattār — He who veils the sins of His servants; the believer's emulation of this attribute is a mark of perfected faith.\n  * Al-Zamakhshari (Asas): Literal — physical covering; Metaphorical — concealing another's moral faults, as the Prophet said: \"Whoever conceals the fault of a brother, Allah conceals his fault in this world and the next.\"\n- Sibawayh Rule: Restriction and specification (al-ḥaṣr wa al-taqyīd) — the conditional clauses (law, idhā) and exceptions (illā) governing when silence is obligatory versus when speech becomes mandatory (amr bi-l-maʿrūf).", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "249": [{"arabic": "يتفكر في ضعفه وضعفهم وأن كلهم عبيد عجزة لا يملكون لأنفسهم ضرا ولا نفعا {كم من فئة قليلة غلبت فئة كثيرة بإذن الله} ثم كيف يعجب بهم وأنهم سيفترقون عنه إذا مات فيدفن في قبره ذليلا مهينا وحده لا يرافقه أهل ولا ولد ولا قريب ولا حميم ولا عشير فيسلمونه إلى البلى والحيات والعقارب والديدان ولا يغنون عنه شيئا وفي أحوج أوقاته إليهم وكذلك يهربون منه يوم القيامة {يوم يفر المرء من أخيه وأمه وأبيه وصاحبته وبنيه} الآية فأي خير فيمن يفارقك في أشد أحوالك ويهرب منك وكيف تعجب به ولا ينفعك في القبر والقيامة وعلى الصراط إلا عملك وفضل الله تعالى فكيف تتكل على من لا ينفعك وتنسى", "english": "If you say: \"He, peace and blessings be upon him, said after his words to Fāṭimah and Ṣafiyyah: 'I cannot avail you against God in anything, except that you have a tie of kinship which I will moisten with its moisture'\" — a ḥadīth [reported as]: \"Do you hope for my intercession, while the Banū ʿAbd al-Muṭṭalib do not hope for it?\" — narrated by al-Ṭabarānī in al-Awsaṭ from the narration of ʿAbd Allāh ibn Jaʿfar, and in it is Uṣayrim ibn Ḥawshab from Isḥāq ibn Wāṣil, and both are extremely weak — so that indicates that he will single out his relatives for intercession.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 882", "section_title_en": "Section 882 — On the Limits of Intercession, the Vices of Pride in Lineage, Numbers, Wealth, and Opinion, and Their Treatment", "section_index": 882, "anchors": "- Root: شفع (Sh-F-')\n  * Lisan / Ayn: Core meaning is pairing or joining; intercession (shafā'ah) is the joining of one's plea to another's cause.\n  * Al-Raghib (Mufradat): Intercession is the seeking of benefit for another; its acceptance is contingent upon divine permission and good pleasure, as restricted by the Qur'anic qualifiers.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) is the act of making a number even (from watr, odd); metaphorical (majāz) is the mediator's plea before authority.\n- Root: عجب (ʿ-J-B)\n  * Lisan / Ayn: Astonishment arising from an unknown cause; self-admiration (ʿujb) is a blameworthy state of being pleased with oneself.\n  * Al-Raghib (Mufradat): \"العجب والتعجب: حالة تعرض للإنسان عند الجهل بسبب الشيء\" — a state that overtakes a person due to ignorance of the cause; hence, it is impossible regarding God.\n  * Al-Zamakhshari (Asas): Literal: a wondrous thing; metaphorical: the one who performs marvels (taʿjābah). Self-admiration is the root of every error and innovation.\n- Root: رأي (R-'-Y)\n  * Lisan / Ayn: Opinion, view, or judgment formed through reflection.\n  * Al-Raghib (Mufradat): Ra'y is the considered opinion that may err or hit the mark; it is blameworthy when it becomes an object of ʿujb (self-admiration).\n  * Al-Zamakhshari (Asas): Literal: sight/vision; metaphorical: intellectual insight. The ḥadīth \"إعجاب كل ذي رأي برأيه\" (the admiration of every man of opinion for his own view) is cited as a sign of the age's corruption.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Qualification) — The conditional clauses (in-sharṭ) governing intercession, e.g., {إلا لمن ارتضى} and {إلا بإذنه}, impose necessary restrictions that negate any absolute reliance on intercession.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}], "251": [{"arabic": "بإفساد شخص واحد وأشخاص ولولا دفع الله الناس بعضهم ببعض لفسدت الأرض وإن الله يؤيد هذا الدين بأقوام لا خلاق لهم", "english": "If you say: \"When, then, is it sound for him to occupy himself with admonishing people?\" — I say: When he has no aim except their guidance for the sake of God most high, and he would wish to find one who aids him, or that they should be guided by themselves; and his hope for their praise and their wealth is entirely cut off; and their praise and their blame become equal to him — so he does not care about their blame when God praises him, nor does he rejoice in their praise when it is not accompanied by the praise of God most high; and he looks upon them as he looks upon masters (sādāt) and upon beasts.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 913", "section_title_en": "On the Hidden Corruption of the Preacher's Intention: The Love of Leadership and the Test of Sincerity", "section_index": 913, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or spirit; that which breathes and desires; the seat of volition and inclination.\n  * Al-Raghib (Mufradat): Al-nafs denotes the immaterial reality of the human being (al-rūḥ) and, in theological contexts, the self as the locus of blameworthy attributes (hawā) versus the tranquil soul; it is that which must be disciplined.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): the soul as animate essence; metaphorical (majāz): \"he poured out his nafs\" i.e., his blood, and \"a nafs struck him\" i.e., the evil eye — indicating the soul's susceptibility to hidden afflictions.\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: To turn, overturn, or flip a thing from one state to another; the heart as that which is perpetually fluctuating between states.\n  * Al-Raghib (Mufradat): Taqlīb is the constant turning and redirecting of a thing; the heart (qalb) is so named for its incessant oscillation — hence \"O Turner of hearts, make my heart firm upon Your religion.\"\n  * Al-Zamakhshari (Asas): Literal: turning a garment or object over; metaphorical (majāz): \"the teacher turned the boys\" i.e., dismissed them, and \"he turned the matter over\" i.e., examined it — thus the heart's turning toward or away from sincerity.\n- Root: دنا (d-n-w)\n  * Lisan / Ayn: Nearness in place, time, or rank; the lower world (al-dunyā) as that which is nearer and lower.\n  * Al-Raghib (Mufradat): Al-dunūw is proximity by essence or by judgment; used of spatial, temporal, and station-based closeness — as in {«ثُمَّ دَنَا فَتَدَلَّىٰ»} (Then he drew near and descended) [al-Najm 53:8].\n  * Al-Zamakhshari (Asas): Literal: physical closeness; metaphorical: closeness in honor or station — here, the preacher's craving for proximity to people's hearts (al-riyāsah).\n- Sibawayh Rule: Bāb al-ḥaṣr wa al-taqyīd bi-innamā (Restriction and Specification with innamā) — used to isolate the true motive from the apparent one, e.g., \"You only do this so that...\" — a restrictive clause exposing the inward cause.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Patience and Gratitude'", "badge": "Dhikr"}, {"arabic": "وقال في قوله تعالى {ولولا دفع الله الناس بعضهم ببعض} قال بالرغبة والرهبة والحياء والمداراة وقالت عائشة رضي الله عنها استأذن رجل على رسول الله صلى الله عليه وسلم قال ائذنوا له فبئس رجل العشيرة هو فلما دخل ألان له القول حتى أن له عنده منزلة فلما خرج قلت له لما دخل قلت الذي قلت ثم ألنت له القول فقال يا عائشة إن شر الناس منزلة عند الله يوم القيامة من تركه الناس اتقاء فحشه (4) وفي الخبر ما وقى الرجل به عرضه فهو له صدقة (5) وفي الأثر خالطوا الناس بأعمالكم وزايلوهم بالقلوب وقال محمد بن الحن", "english": "A man defended him, and the Prophet (peace be upon him) said: \"Whoever defends the honor of his brother shall have it as a shield for him against the Fire.\" (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 435", "section_title_en": "Section 435", "section_index": 435, "anchors": "- Root: رد (r-d-d)\n  * Lisan / Ayn: To return, repel, defend, avert; al-radd ʿan al-ʿirḍ is to repel defamation from one's honor\n  * Al-Raghib (Mufradat): Defense against false accusation; the theological nuance of divine recompense (al-mukāfaʾah) for defending a brother's honor\n  * Al-Zamakhshari (Asas): Literal repulsion of physical harm extended metaphorically to verbal defense of honor (ḥaqīqah vs. majāz)\n- Root: عطس (ʿ-t-s)\n  * Lisan / Ayn: Sneezing; al-tashmīt is the invocation of mercy upon the sneezer\n  * Al-Raghib (Mufradat): The sneeze is attributed to God (min Allāh) as a sign of divine favor, while yawning is attributed to Satan\n  * Al-Zamakhshari (Asas): The response \"yarḥamukallāh\" is a supplication, not an assertion — distinguishing literal invocation from mere congratulation\n- Root: عاد (ʿ-w-d)\n  * Lisan / Ayn: To visit repeatedly; al-ʿiyādah is the visitation of the sick\n  * Al-Raghib (Mufradat): Returning to someone in his affliction; the reward is measured by the intensity of compassion shown\n  * Al-Zamakhshari (Asas): The \"return\" (ʿawd) is literal in visitation, but the reward is spiritual — a metaphorical extension of recompense\n- Root: شيع (sh-y-ʿ)\n  * Lisan / Ayn: To accompany, follow; al-tashyīʿ is the funeral procession\n  * Al-Raghib (Mufradat): Following the bier with the intention of honoring the deceased and taking admonition (al-iʿtibār)\n  * Al-Zamakhshari (Asas): The qīrāṭ is a measure of reward — metaphorical weight, not literal coin\n- Sibawayh Rule: Rule of Conditional Protasis (Bāb al-sharṭ) — The construction \"man ... fa-...\" (whoever does X, then Y) establishes a causal nexus requiring the apodosis to be a new sentence, often carrying the force of divine decree.\n\n---\n\n##", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}], "253": [{"arabic": "بعض النبين على بعض وقد قال منهم من كلم الله ورفع بعضهم درجات فكان عيسى عليه السلام من المفضلين ولإدلاله سلم على نفسه فقال والسلام علي يوم ولدت ويوم أموت ويوم أبعث حيا وهذا انبساط منه لما شاهد من اللطف في مقام الأنس وأما يحيى بن زكريا عليه السلام فإنه أقيم مقام الهيبة والحياء فلم ينطق حتى أثنى عليه خالقه فقال وسلام عليه وانظر كيف احتمل لأخوة يوسف ما فعلوه بيوسف وقد قال بعض العلماء قد عددت من أول قوله تعالى إذ قالوا ليوسف وأخوه أحب إلى أبينا منا إلى رأس العشرين من إخباره تعالى عن زهدهم فيه نيفا وأربعين خطي", "english": "As for Adam (peace be upon him), it was said concerning him: {«وعصى آدم ربه فغوى»} \"And Adam disobeyed his Lord, so he went astray\" (Q. 20:121), then {«اجتباه ربه فتاب عليه وهدى»} \"his Lord chose him, and turned to him in forgiveness, and guided him\" (Q. 20:122).", "book_title": "Love, Longing, Intimacy and Contentment", "section_title_ar": "Section 1187", "section_title_en": "On the Varieties of Divine Proximity (Al-Inbisāṭ) and Awe (Al-Haybah) in the States of the Prophets and Saints", "section_index": 1187, "anchors": "- Root: بسط (B-S-T)\n  * Lisan / Ayn: Core meaning is \"to spread out, extend, expand\" — both physically (basting a garment) and metaphorically.\n  * Al-Raghib (Mufradat): Theological nuance: \"بسط الشيء: نشره وتوسيعه\" — used for expansion of mercy, favor, and the soul's comfort. In Kalam, it contrasts with *qabḍ* (contraction/withholding).\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"بسط الثوب والفراش إذا نشره.\" Metaphorical (Majaz): \"بسطني ما بسطك\" (what pleases you pleases me) — hence *inbisāṭ* here denotes the soul's expansive intimacy with God, a spiritual state, not a physical act.\n- Root: أبلس (B-L-S)\n  * Lisan / Ayn: \"أبلس: انقطعت حجته ويئس\" — to be reduced to silence, to despair.\n  * Al-Raghib (Mufradat): \"الإبلاس: الحزن المعترض من شدة اليأس\" — the despair of Iblis is a theological state of being cut off from mercy.\n  * Al-Zamakhshari (Asas): Literal: despair/silence. Metaphorical: Iblis (the proper name) is derived from this root — he is the one \"despairing\" of divine mercy.\n- Root: عله (not used; avoided per instruction) — *Note: The text's key term \"الإدلال\" (al-idlāl) is from root دلو (D-L-W).*\n- Root: دلو (D-L-W)\n  * Lisan / Ayn: \"دلا الدلو: أخرجها من البئر\" — to draw water from a well; hence *iddalā'a* (إدلال) means to advance boldly, relying on a familiar bond.\n  * Al-Raghib (Mufradat): Not a primary Quranic term, but lexically implies confident approach based on prior intimacy.\n  * Al-Zamakhshari (Asas): Literal: lowering the bucket. Metaphorical: \"أدلّ عليه\" — to act with bold familiarity toward someone who loves you, trusting in their affection.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Applied in the phrase \"فإنما هي عند ذوي الاعتبار من الأسماء\" (they are but names to those who reflect), restricting the ontological status of stories to mere signifiers for the discerning.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Love, Longing, Intimacy and Contentment'", "badge": "Insight"}], "254": [{"arabic": "وسلم قال من كانت لأخيه عنده مظلمة في عرض أو مال فليستحللها منه من قبل أن يأتي يوم ليس هناك دينار ولا درهم إنما يؤخذ من حسناته فإن لم يكن له حسنات أخذ من سيئات صاحبه فزيدت على سيئاته (1) وقالت عائشة رضي الله عنها لامرأة قالت لأخرى أنها طويلة الذيل قد اغتبتيها فاستحليها فإذن لا بد من الاستحلال إن قدر عليه فإن كان غائبا أو ميتا فينبغي أن يكثر له الاستغفار والدعاء ويكثر من الحسنات فإن قلت فالتحليل هل يجب فأقول لا لأنه تبرع والتبرع فضل وليس بواجب ولكنه مستحسن وسبيل المعتذر أن يبالغ في الثناء عليه والتودد إليه", "english": "- Root: غيب (gh-y-b)\n  * Lisan / Ayn: \"To be absent, hidden, concealed from sight; ghayb = that which is unseen/absent from perception\"\n  * Al-Raghib (Mufradat): \"الغيب: مصدر غابت الشمس وغيرها: إذا استترت عن العين — used of everything absent from the senses and from human knowledge; applied to things as ghayb/ghā'ib relative to people, not relative to God, for nothing is absent from Him\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"تكلم بذلك عن ظهر الغيب\" (speaking of the unseen); Majaz: \"أتونا في غابة\" (metaphorical extension to dense/thick things)\n- Root: حسن (ḥ-s-n)\n  * Lisan / Ayn: \"Beauty, goodness, excellence; to be fair, comely, good\"\n  * Al-Raghib (Mufradat): \"الحسن: عبارة عن كل مبهج مرغوب فيه — three kinds: good by reason, good by desire, good by sense; ḥasanah = everything that delights one, whether in self, body, or circumstances\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"أنظر إلى محاسن وجهه\" (physical beauty); Majaz: \"فلان لا يحسن شيئًا\" (to do well/excel — transferred to action)\n- Root: حرم (ḥ-r-m)\n  * Lisan / Ayn: \"To forbid, prohibit, make unlawful; ḥarām = that which is forbidden\"\n  * Al-Raghib (Mufradat): \"الحرام: الممنوع منه إما بتسخير إلهي وإما بشري — prohibition by divine decree, by human law, by coercive prevention, by reason, or by revelation\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"هتك رحمته\" (violating sanctity); Majaz: \"جلد محرم: لم يدبغ\" (raw hide — metaphorical extension to \"untreated/unlawful\")\n- Root: ظلم (ẓ-l-m)\n  * Lisan / Ayn: \"Wrongdoing, injustice, oppression; to place something in other than its proper place\"\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور — darkness is absence of light; used metaphorically for ignorance, polytheism, and sin, just as light is used for their opposites\"\n  * Al-Zamakhshari (Asas): Haqiqah: \"فلان يظلم فيظلم\" (to wrong and be wronged); Majaz: \"أرض مظلومة\" (land never dug — metaphorical: \"wronged\" land)\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — \"إنما يؤخذ من حسناته\" restricts the taking exclusively to good deeds, excluding any monetary compensation on that Day.", "book_title": "Condemnation of Anger and Hatred", "section_title_ar": "Section 690", "section_title_en": "Section 690", "section_index": 690, "anchors": "*(Anchors established)*", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Anger and Hatred'", "badge": "Hadith"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}], "255": [{"arabic": "جبريل عليه السلام ويشاهده ومن حوله لا يسمعونه ولا يرونه (3) ولا يحيطون بشيء من علمه إلا بما شاء فإذا لم يخلق لهم السمع والرؤية لم يدركوه الأصل الثالث عذاب القبر وقد ورد الشرع به قال الله تعالى النار يعرضون عليها غدوا وعشيا ويوم تقوم الساعة أدخلوا آل فرعون أشد العذاب واشتهر عن رسول الله صلى الله عليه وسلم والسلف الصالح الاستعاذة من عذاب القبر (4) وهو ممكن فيجب التصديق به ولا يمنع من التصديق به تفرق أجزاء الميت في بطون السباع وحواصل الطيور فإن المدرك لألم العذاب من الحيوان أجزاء مخصوصة يقدر الله تعالى على إعادة الإدراك إليها الأصل الر", "english": "For they, despite their distinction in eloquence and rhetorical perfection, aimed at reviling him, forbidding him, killing him, and expelling him — as God, Mighty and Majestic, informed us about them — yet they were unable to produce anything to rival the Qur'an. For it was not within the capacity of human beings to combine the grandeur of the Qur'an's diction with its harmonious order, especially given what it contains of the accounts of the ancients, while he was illiterate, never having practiced the study of books — and [given] its announcement of the unseen in matters whose truthfulness was verified in the future, such as His saying, Exalted is He: {«لَتَدْخُلُنَّ الْمَسْجِدَ الْحَرَامَ إِنْ شَاءَ اللَّهُ آمِنِينَ مُحَلِّقِينَ رُءُوسَكُمْ وَمُقَصِّرِينَ»} (You shall surely enter the Sacred Mosque, if God wills, secure, with your heads shaved and cut short) [Al-Fatḥ 48:27], and such as His saying: {«الم غُلِبَتِ الرُّومُ فِي أَدْنَى الْأَرْضِ وَهُمْ مِنْ بَعْدِ غَلَبِهِمْ سَيَغْلِبُونَ فِي بِضْعِ سِنِينَ»} (Alif Lām Mīm. The Romans have been defeated in the nearest land, and they, after their defeat, shall be victorious within a few years) [Al-Rūm 30:1-3].", "book_title": "Contemplation", "section_title_ar": "Section 96", "section_title_en": "The Fourth Pillar: On Matters of Hearing (al-Samʿiyyāt) and the Verification of the Prophet ﷺ in What He Reported — Comprising Ten Fundamental Principles", "section_index": 96, "anchors": "- Root: حشر (ḥ-sh-r)\n  * Lisan / Ayn: To gather, assemble, drive together; al-ḥashr is the gathering of creation on the Day of Resurrection.\n  * Al-Raghib (Mufradat): Al-ḥashr is the bringing together of a people from their various places of dispersal; it is used specifically for the resurrection gathering.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for driving cattle together; metaphorical (majāz) for the ingathering of souls for judgment.\n- Sibawayh Rule: Rule of Conditional Protasis (al-sharṭ) — \"If you are truthful, then rise...\" (fa-in kunta ṣādiqan fa-qum...) — the apodosis (jawāb al-sharṭ) functions as the proof of the protasis, establishing necessary knowledge (ʿilm ḍarūrī).\n\n- Root: نشر (n-sh-r)\n  * Lisan / Ayn: To spread, unfold, revive after death; al-nushūr is the revivification of the dead.\n  * Al-Raghib (Mufradat): Al-nashr is the spreading of the soul back into the body after death; it is the opposite of al-ṭayy (folding up).\n  * Al-Zamakhshari (Asas): Literal for unfolding a garment; metaphorical for the resurrection when the earth \"spreads forth\" what it contains.\n- Sibawayh Rule: Rule of Coordination (al-ʿaṭf) — \"al-ḥashr wa-l-nashr\" (the gathering and the spreading) — two coordinated nouns forming a single compound concept of resurrection.\n\n- Root: مكن (m-k-n)\n  * Lisan / Ayn: To establish, empower, give firm footing; makkana means to make something firm and stable.\n  * Al-Raghib (Mufradat): Al-makān is the place that contains a thing; tamakkun is the firm establishment of a thing in its place.\n  * Al-Zamakhshari (Asas): Literal for physical placement; metaphorical for divine power — \"God is able\" (qādir) means He has full capacity and authority over all things.\n- Sibawayh Rule: Rule of Possibility (al-imkān) — \"that is possible\" (dhālika mumkin) — the predicate of possibility is established by the absence of logical contradiction, not by empirical observation.\n\n- Root: عذب (ʿ-dh-b)\n  * Lisan / Ayn: Sweet, pleasant (of water); al-ʿadhāb is the punishment that is \"sweet\" to the inflictor but bitter to the recipient — used predominantly for divine chastisement.\n  * Al-Raghib (Mufradat): Al-ʿadhāb is the infliction of pain that deters; it is specifically the painful consequence of disobedience.\n  * Al-Zamakhshari (Asas): Literal for sweet water; metaphorical (majāz) for punishment that is \"appointed\" as a deterrent.\n- Sibawayh Rule: Rule of Exception (al-istithnāʾ) — \"except as God wills\" (illā mā shāʾa) — the exception clause restricts the scope of human perception, not divine action.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Contemplation'", "badge": "Afterlife"}, {"arabic": "وجل في كلام يردده في نفسه كما لو سمع وهو يقول {إنني أنا الله لا إله إلا أنا فاعبدني} فإنه ما كان ينبغي أن يفهم منه ذلك إلا على سبيل الحكاية الصنف الثاني من الشطح كلمات غير مفهومة لها ظواهر رائقة وفيها عبارات هائلة وليس وراءها طائل إما أن تكون غير مفهومة عند قائلها بل يصدرها عن خبط في عقله وتشويش في خياله لقلة إحاطته بمعنى كلام قرع سمعه وهذا هو الأكثر وإما أن تكون مفهومة له ولكنه لا يقدر على تفهيمها وإيرادها بعبارة تدل على ضميره لقلة ممارسته للعلم وعدم تعلمه طريق التعبير عن المعاني بالألفاظ الرشيقة ولا فائدة لهذا الجنس من الكلام إلا أ", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "الحياة والقدرة وأنه تعالى حي قادر جبار قاهر لا يعتريه قصور ولا عجز ولا تأخذه سنة ولا نوم ولا يعارضه فناء ولا موت وأنه ذو الملك والملكوت والعزة والجبروت له السلطان والقهر والخلق والأمر والسموات مطويات بيمينه والخلائق مقهورون في قبضته وأنه المنفرد بالخلق والاختراع المتوحد بالإيجاد والإبداع خلق الخلق وأعمالهم وقدر أرزاقهم وآجالهم لا يشذ عن قبضته مقدور ولا يعزب عن قدرته تصاريف الأمور لا تحصى مقدوراته ولا تتباهى معلوماته العلم وأنه عالم بجميع المعلومات محيط بما يجري من تخوم الأرضين إلى أعلى السموات وأنه عالم لا يعزب عن علمه مثقال ذرة في", "english": "- **Root: خلق (khalaqa)**\n  - *Lisan / Ayn:* Core meaning of measuring, proportioning, and fashioning; al-Khalil notes the root's application to the act of creation as bringing forth upon a measured determination.\n  - *Al-Raghib (Mufradat):* \"الخلق أصله: التقدير المستقيم\" — Creation fundamentally signifies right/straight measurement; used for bringing into being from nothing (ibdāʿ) as in {خلق السماوات والأرض}, and for bringing forth from something as in {خلقكم من نفس واحدة}.\n  - *Al-Zamakhshari (Asas):* Literal (ḥaqīqah): the craftsman's measuring before cutting. Metaphorical (majāz): \"خلق الله الخلق: أوجده على تقدير أوجبته الحكمة\" — God's creation is bringing into existence upon a measure necessitated by wisdom.", "book_title": "Foundations of Belief", "section_title_ar": "Section 72", "section_title_en": "Section 72", "section_index": 72, "anchors": "*(Anchors established)*", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}, {"arabic": "وعنه العبارة بقوله تعالى {ولا يشفعون إلا لمن ارتضى} وبقوله {من ذا الذي يشفع عنده إلا بإذنه} وبقوله {ولا تنفع الشفاعة عنده إلا لمن أذن له} وبقوله {فما تنفعهم شفاعة الشافعين} وإذا انقسمت الذنوب إلا ما يشفع فيه وإلا ما لا يشفع فيه وجب الخوف والإشفاق لا محالة ولو كان ذنب تقبل فيه الشفاعة لما أمر قريشا بالطاعة ولما نهى رسول الله صلى الله عليه وسلم فاطمة رضي الله عنها عن المعصية ولكان يأذن لها في اتباع الشهوات لتكمل لذاتها في الدنيا ثم يشفع لها في الآخرة لتكمل لذاتها في الآخرة فالانهماك في الذنوب وترك التقوى اتكالا على رجاء الشفاعة يضاهي ان", "english": "If you say: \"He, peace and blessings be upon him, said after his words to Fāṭimah and Ṣafiyyah: 'I cannot avail you against God in anything, except that you have a tie of kinship which I will moisten with its moisture'\" — a ḥadīth [reported as]: \"Do you hope for my intercession, while the Banū ʿAbd al-Muṭṭalib do not hope for it?\" — narrated by al-Ṭabarānī in al-Awsaṭ from the narration of ʿAbd Allāh ibn Jaʿfar, and in it is Uṣayrim ibn Ḥawshab from Isḥāq ibn Wāṣil, and both are extremely weak — so that indicates that he will single out his relatives for intercession.", "book_title": "Condemnation of Pride and Conceit", "section_title_ar": "Section 882", "section_title_en": "Section 882 — On the Limits of Intercession, the Vices of Pride in Lineage, Numbers, Wealth, and Opinion, and Their Treatment", "section_index": 882, "anchors": "- Root: شفع (Sh-F-')\n  * Lisan / Ayn: Core meaning is pairing or joining; intercession (shafā'ah) is the joining of one's plea to another's cause.\n  * Al-Raghib (Mufradat): Intercession is the seeking of benefit for another; its acceptance is contingent upon divine permission and good pleasure, as restricted by the Qur'anic qualifiers.\n  * Al-Zamakhshari (Asas): Literal (haqīqah) is the act of making a number even (from watr, odd); metaphorical (majāz) is the mediator's plea before authority.\n- Root: عجب (ʿ-J-B)\n  * Lisan / Ayn: Astonishment arising from an unknown cause; self-admiration (ʿujb) is a blameworthy state of being pleased with oneself.\n  * Al-Raghib (Mufradat): \"العجب والتعجب: حالة تعرض للإنسان عند الجهل بسبب الشيء\" — a state that overtakes a person due to ignorance of the cause; hence, it is impossible regarding God.\n  * Al-Zamakhshari (Asas): Literal: a wondrous thing; metaphorical: the one who performs marvels (taʿjābah). Self-admiration is the root of every error and innovation.\n- Root: رأي (R-'-Y)\n  * Lisan / Ayn: Opinion, view, or judgment formed through reflection.\n  * Al-Raghib (Mufradat): Ra'y is the considered opinion that may err or hit the mark; it is blameworthy when it becomes an object of ʿujb (self-admiration).\n  * Al-Zamakhshari (Asas): Literal: sight/vision; metaphorical: intellectual insight. The ḥadīth \"إعجاب كل ذي رأي برأيه\" (the admiration of every man of opinion for his own view) is cited as a sign of the age's corruption.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Qualification) — The conditional clauses (in-sharṭ) governing intercession, e.g., {إلا لمن ارتضى} and {إلا بإذنه}, impose necessary restrictions that negate any absolute reliance on intercession.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Pride and Conceit'", "badge": "Insight"}, {"arabic": "الذي لا تأخذه سنة ولا نوم لم يسأل الله تعالى شيئا إلا أعطاه وقال بعض السلف من أطعم مسكينا يوم الجمعة ثم غدا وابتكر ولم يؤذ أحدا ثم قال حين يسلم الإمام بسم الله الرحمن الرحيم الحي القيوم أسألك أن تغفر لي وترحمني وتعافيني من النار ثم دعا بما بدا له استجيب له السابع أن يجعل يوم الجمعة للآخرة فيكف فيه عن جميع أشغال الدنيا ويكثر فيه الأوراد ولا يبتدىء فيه السفر فقد روي أنه من سافر في ليلة الجمعة دعا عليه ملكاه (1) وهو بعد طلوع الفجر حرام إلا إذا كانت الرفقة تفوت وكره بعض السلف شرا", "english": "Know that among the proprieties of Friday is that one should be excellent in watching for the noble hour. For in the well-known report: {«Indeed in Friday there is an hour in which no Muslim servant asks God, Mighty and Majestic, for anything but that He grants it to him»}. And in another report: {«No servant coincides with it while praying»}.", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 151", "section_title_en": "The Revival of the Religious Sciences — Section 151: On the Virtues of Friday and Its Proprieties", "section_index": 151, "anchors": "- Root: ر-ق-ب (raqaba)\n  * Lisan / Ayn: To watch, observe, lie in wait for; the watcher (rāqib) is one who awaits expectantly.\n  * Al-Raghib (Mufradat): Moral vigilance (murāqabah) is the soul's persistent attentiveness to what it anticipates, whether of benefit or harm.\n  * Al-Zamakhshari (Asas): Literal: watching a road or pass. Metaphorical: the heart's standing guard over the appointed time, as one watches for the crescent moon.\n- Root: ن-ف-ح (nafaḥa)\n  * Lisan / Ayn: To blow gently, to emit a breeze; nafaḥāt are gentle, diffusive emanations.\n  * Al-Raghib (Mufradat): Divine effusions of mercy that sweep over the servant unexpectedly.\n  * Al-Zamakhshari (Asas): Literal: a fragrant breeze. Metaphorical: the breaths of divine mercy that pass over the days of time.\n- Root: خ-ط-ب (khaṭaba)\n  * Lisan / Ayn: To address, deliver an oration; khuṭbah is the formal sermon.\n  * Al-Raghib (Mufradat): The prophetic address conveying command and prohibition.\n  * Al-Zamakhshari (Asas): Literal: oration. Metaphorical: the preacher's ascent to the pulpit marks the threshold of the answered hour.\n- Sibawayh Rule: Interposition of the conditional clause (jawāb al-sharṭ) — the apodosis may be delayed or elided when the protasis is governed by a particle of expectation, as in \"whoever does X, God forgives him,\" where the response is the reward predicated upon the condition.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Mysteries of Prayer'", "badge": "Du'a"}], "257": [{"arabic": "{يخرجهم من الظلمات إلى النور} وقال صلى الله عليه وسلم يا أيها الناس اعقلوا عن ربكم وتواصوا بالعقل تعرفوا ما أمرتم به وما نهيتم عنه واعلموا أنه ينجدكم عند ربكم واعلموا أن العاقل من أطاع الله وإن كان دميم المنظر حقير الخطر دنيء المنزلة رث الهيئة وأن الجاهل من عصى الله تعالى وإن كان جميل المنظر عظيم الخطر شريف المنزلة حسن الهيئة فصيحا نطوقا فالقردة والخنازير أعقل عند الله تعالى ممن عصاه ولا تغتر بتعظيم أهل الدنيا إياهم فإنهم من الخاسرين (2) وقال صلى الله عليه وسلم أول ما خل", "english": "The Book of Seclusion ('Uzlah) — its explanation, God Most High willing. For this reason, Yūsuf ibn Asbāṭ wrote to Ḥudhayfah al-Marʿashī: \"What is your opinion of one who remains, finding no one with whom to remember God Most High except that he is either sinful, or his remembrance in company is itself an act of disobedience — and that because he finds no one of his own kind?\" And indeed he spoke truly, for mixing with people is never free from backbiting (ghībah), or listening to backbiting, or remaining silent upon wrongdoing (munkar). And the best of his states is that he either imparts knowledge or acquires it. Yet were this poor wretch to reflect, and to know that his imparting of knowledge is never free from the taints of ostentation (riyā'), the seeking of followers, and the desire for leadership (ri'āsah), he would know that the one who acquires knowledge from him only seeks to make it an instrument for pursuing the world and a means toward evil — so that the teacher becomes his helper therein, his support and his backer, preparing its causes for him, like one who sells a sword to a highway robber. For knowledge is like the sword: its soundness for good is like the soundness of the sword for warfare. And for this reason, it is not permitted to sell it to one whom one knows, by the indications of his circumstances, intends to use it to aid in cutting off the road.", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 65", "section_title_en": "The Book of Seclusion ('Uzlah) — Section 65, and The Seventh Book: On the Intellect, Its Nobility, Its Reality, and Its Divisions", "section_index": 65, "anchors": "- Root: عقل (ʿaql)\n  * Lisan / Ayn: The root denotes binding, restraining, and holding back; the intellect is that which restrains the soul from base desires and prevents it from straying.\n  * Al-Raghib (Mufradat): \"العقل يقال للقوة المتهيئة لقبول العلم، ويقال للعلم الذي يستفيده الإنسان بتلك القوة عقل\" — The intellect is said of the faculty prepared for the reception of knowledge, and it is also said of the knowledge which man acquires by means of that faculty.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): intellectual apprehension and understanding. Metaphorical (Majaz): \"نخلة لا تعقل الإبار\" — a palm tree that does not accept pollination, i.e., does not grasp or take in.\n- Root: علم (ʿilm)\n  * Lisan / Ayn: Knowledge as the mark or sign by which a thing is known; the trace or landmark that guides.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — Knowledge is the apprehension of a thing in its true reality; it is of two kinds: apprehension of the essence of a thing, and judgment upon a thing regarding what exists for it or is negated of it.\n  * Al-Zamakhshari (Asas): Literal: certain awareness. Metaphorical: \"هو من أعلام العلم الخافقه\" — he is among the lofty banners of knowledge; knowledge as a guiding landmark (maʿlam).\n- Root: نور (nūr)\n  * Lisan / Ayn: Light; the first to set up beacons (manār) on his path in his campaigns to guide his return.\n  * Al-Raghib (Mufradat): \"النور: الضوء المنتشر الذي يعين على الإبصار\" — Light is the diffused radiance that aids vision; it is of two kinds: that perceived by the eye of inner insight (baṣīrah) — such as the light of the intellect and the light of the Qur'an — and that perceived by the eye of the head, such as the celestial bodies.\n  * Al-Zamakhshari (Asas): Literal: illumination. Metaphorical: \"نور الأمر: بينه\" — he illuminated the matter: he made it clear; \"وهذا أنور من ذاك: أبين\" — this is more luminous than that: more evident.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the exclusive attribution of a predicate to a subject, as in the author's restriction of the scholar's condition to one of two men, and the exclusion of the third.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Condemnation of Delusion'", "badge": "Dhikr"}, {"arabic": "عز وجل {الله ولي الذين آمنوا يخرجهم من الظلمات إلى النور} وفي بعض الأخبار المؤمن أفضل من الكعبة (4) والمؤمن طيب طاهر (1) والمؤمن أكرم على الله تعالى من الملائكة (2) وفي الخبر خلق الله تعالى جهنم من فضل رحمته سوطا يسوق به عباده إلى الجنة (3) وفي خبر آخر يقول الله عز وجل إنما خلقت الخلق ليربحوا علي ولم أخلقهم لأربح عليهم (4) وفي حديث أبي سعيد الخدري عن رسول الله صلى الله عليه وسلم ما خلق الله تعالى شيئا إلا جعل له ما يغلبه وجعل رحمته تغلب غضبه (5) وفي الخبر المشهور إن الله تعالى كتب على نفسه الرحمة قب", "english": "So it was said to him: \"And what is in it of hope?\" He said: \"This world, all of it, is little, and a man's provision from it is little, and his religion is little in comparison to his provision. So look at how God Most High sent down in it the longest verse, to guide His servant to the path of caution in preserving his wealth — so how could He not preserve his religion, which has no substitute for him?\"", "book_title": "Fear and Hope", "section_title_ar": "Section 1033", "section_title_en": "The Book of Hope (Kitāb al-Rajā') — Section 1033: The Second Art — Surveying the Verses and Reports Concerning Hope", "section_index": 1033, "anchors": "- Root: وجود (w-j-d)\n  * Lisan / Ayn: Core meaning of \"finding\" and \"existence\"; here in the sense of what is present and available.\n  * Al-Raghib (Mufradat): Existence as that which is found and realized; in theological context, the given order of creation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense of \"being found\"; metaphorical (majāz) extension to the entirety of created things.\n- Root: رجا (r-j-w)\n  * Lisan / Ayn: To hope, to expect with desire; the opposite of despair (ya's).\n  * Al-Raghib (Mufradat): Hope as a theological virtue — the heart's expectation of divine mercy, balanced against fear (khawf).\n  * Al-Zamakhshari (Asas): Literal: expectation of a desired outcome; metaphorical: the soul's reliance on divine generosity.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: To cover, to shield, to pardon; the root implies veiling the fault.\n  * Al-Raghib (Mufradat): Divine forgiveness as the covering of sins and the effacing of their consequence.\n  * Al-Zamakhshari (Asas): Literal: covering; metaphorical: God's remission of punishment.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — used to emphasize exclusive attributes of divine mercy and forgiveness.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Fear and Hope'", "badge": "Hadith"}], "258": [{"arabic": "وقال تعالى ألم تر إلى الذي حاج إبراهيم في ربه إلى قوله فبهت الذي كفر إذ ذكر سبحانه احتجاج إبراهيم ومجادلته وإفحامه خصمه في معرض الثناء عليه وقال عز وجل وتلك حجتنا آتيناها إبراهيم على قومه وقال تعالى قالوا يا نوح قد جادلتنا فأكثرت جدالنا وقال تعالى في قصة فرعون وما رب العالمين إلى قوله أولوا جئتك بشيء مبين وعلى الجملة فالقرآن من أوله إلى آخره محاجة مع الكفار فعمدة أدلة المتكلمين في التوحيد قوله تعالى {لو كان فيهما آلهة إلا الله لفسدتا} وفي النبوة {وإن كنتم في ريب مما نزلنا على عبدنا فأتوا بسورة م", "english": "The mention of the proof (ḥujjah), the demand for it, and the search after it — how could these be prohibited, when God — may He be exalted — has said: {«قُلْ هَاتُوا بُرْهَانَكُمْ»} (Say: Bring forth your proof — Qur'an 2:111), and He — mighty and majestic — has said: {«لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَا مَنْ حَيَّ عَنْ بَيِّنَةٍ»} (So that he who perishes may perish upon clear evidence, and he who lives may live upon clear evidence — Qur'an 8:42), and He — may He be exalted — has said: {«هَلْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا»} (Have you any authority for this? — Qur'an 10:68), meaning a proof and demonstration, and He — may He be exalted — has said: {«قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ»} (Say: To God belongs the conclusive proof — Qur'an 6:149), and He — may He be exalted — has said: {«أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ»} (Have you not considered him who disputed with Abraham concerning his Lord? — Qur'an 2:258) up to His words: {«فَبُهِتَ الَّذِي كَفَرَ»} (So the one who disbelieved was confounded — Qur'an 2:258).", "book_title": "Foundations of Belief", "section_title_ar": "Section 77", "section_title_en": "The Revival of the Religious Sciences — Section 77: On the Permissibility of Theological Discourse (Kalām) and Its Early Practice", "section_index": 77, "anchors": "- Root: ح-د-ث (ḥ-d-th)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not; al-ḥadath: the novel event; al-ḥīdāth: origination.\"\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: a thing's becoming after it was not, whether accident or substance; iḥdāth: bringing it into existence. The origination of substances belongs to God alone.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'He is a recent event among events.' Metaphorical: 'They became topics of conversation (aḥādīth).'\"\n- Root: ح-ا-ج (ḥ-ā-j)\n  * Lisan / Ayn: \"Al-ḥājah: need of a thing, with desire for it; its plural: ḥājāt and ḥawā'ij.\"\n  * Al-Raghib (Mufradat): \"Al-ḥājah ilā al-shay': poverty toward it with love of it. God said: {«إِلَّا حَاجَةً فِي نَفْسِ يَعْقُوبَ»} (except a need in Jacob's soul — Qur'an 12:68).\"\n  * Al-Zamakhshari (Asas): \"Literal: need and want. The 'ḥājah' is that which one seeks to obtain.\"\n- Root: ك-و-ن (k-w-n)\n  * Lisan / Ayn: \"Kāna: to be, to exist; takwīn: bringing into being from non-existence.\"\n  * Al-Raghib (Mufradat): \"Al-kawn: existence after non-existence; the muḥdath (originated thing) is that brought forth after it was not.\"\n  * Al-Zamakhshari (Asas): \"Literal: being and becoming. Metaphorical: the continuous states of affairs.\"\n- Sibawayh Rule: Al-Faṣl bayna al-Jār wa-al-Majrūr (Prepositional Interposition) — The permissibility of separating a preposition from its object when the intervening clause is complete in meaning, as in the verse's structure of argumentation where the proof (ḥujjah) stands independently before its conclusion.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Foundations of Belief'", "badge": "Insight"}], "259": [{"arabic": "أعلم أن الله على كل شيء قدير وأن الله قد أحاط بكل شيء علما وأحصى كل شيء عددا اللهم إني أعوذ بك من شر نفسي ومن شر كل دابة أنت آخذ بناصيتها إن ربي على صراط مستقيم (1) دعاء الخليل إبراهيم عليه الصلاة والسلام كان يقول إذا أصبح اللهم إن هذا خلق جديد فافتحه علي بطاعتك واختمه لي بمغفرتك ورضوانك وارزقني فيه حسنة تقبلها مني وزكها وضعفها لي وما عملت فيه من سيئة فاغفرها لي إنك غفور رحيم ودود كريم قال ومن دعا بهذا الدعاء إذا أصبح فقد أدى شكر يومه دعاء عيسى عليه ال", "english": "And it is related that the Messenger of Allah (peace be upon him) said to him: \"O Buraydah, shall I not teach you words which, if anyone desires good through them, he is taught them, and then he never forgets them ever?\" He said: \"I said, 'Yes, O Messenger of Allah.'\" He said: \"Say: 'O Allah, I am weak, so strengthen my weakness in Your pleasure, and take me by my forelock toward goodness, and make Islam the limit of my contentment. O Allah, I am weak, so strengthen me; and I am abased, so honor me; and I am poor, so enrich me, O Most Merciful of the merciful.'\" (2)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 248", "section_title_en": "The Revival of the Religious Sciences — Section 248: Supplications of the Companions and Prophets (Peace Be Upon Them)", "section_index": 248, "anchors": "- Root: دعو (d-'-w)\n  * Lisan / Ayn: Core meaning of calling, invoking, summoning; du'a as the act of calling upon God with humble petition.\n  * Al-Raghib (Mufradat): Theological nuance of du'a as the essence of worship ('ibadah), the creature's acknowledgment of need (iftaqar) before the Creator.\n  * Al-Zamakhshari (Asas): Literal (haqiqah) — to call out; Metaphorical (majaz) — the soul's inward turning to God, transcending mere vocal utterance.\n- Root: وقي (w-q-y)\n  * Lisan / Ayn: To protect, guard, preserve from harm; the root of taqwa (God-consciousness) and ittiqa (self-preservation from divine displeasure).\n  * Al-Raghib (Mufradat): The theological state of being shielded by God's grace through the performance of obligations and abstention from prohibitions.\n  * Al-Zamakhshari (Asas): Literal — physical protection; Metaphorical — spiritual safeguarding of the heart from worldly attachment.\n- Root: حول (h-w-l)\n  * Lisan / Ayn: Power, might, capacity to change or transform; the ability to effect motion or cessation.\n  * Al-Raghib (Mufradat): In the formula \"لا حول ولا قوة إلا بالله\" (lā ḥawla wa lā quwwata illā billāh), it denotes the creature's absolute incapacity and total reliance on divine power (quwwah) for all acts of obedience and avoidance of sin.\n  * Al-Zamakhshari (Asas): Literal — physical strength; Metaphorical — the spiritual power granted by God to overcome one's lower self (nafs).\n- Root: فقر (f-q-r)\n  * Lisan / Ayn: Poverty, neediness, lack of possessions; the state of one who requires what he does not possess.\n  * Al-Raghib (Mufradat): The ontological poverty of all creatures before God — \"يا أيها الناس أنتم الفقراء إلى الله\" {O mankind, you are the poor in need of Allah} [Fatir: 15]. This is the existential need that defines creaturehood.\n  * Al-Zamakhshari (Asas): Literal — material poverty; Metaphorical — the soul's recognition of its utter dependence on God for guidance, sustenance, and salvation.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The permissibility of interposing elements between a preposition and its object when the intervening phrase constitutes a complete and meaningful utterance, as seen in the extended invocations where multiple clauses are joined by conjunctions (wa) before the governing verb's object is completed.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "شيء يسير فقال له عمر حسبك بصحبته يوما أو بعض يوم شؤما وشرا وقال الفضيل ما ازداد رجل من ذي سلطان قربا إلا ازداد من الله بعدا وكان سعيد بن المسيب يتجر في الزيت ويقول إن في هذا لغنى عن هؤلاء السلاطين وقال وهيب هؤلاء الذين يدخلون على الملوك لهم أضر على الأمة من المقامرين وقال محمد بن سلمة الذباب على العذرة أحسن من قارئ على باب هؤلاء ولما خالط الزهري السلطان كتب أخ له في الدين إليه عافانا الله وإياك أبا بكر من الفتن فقد أصبحت بحال ينبغي لمن عرفك أن يدعوا لك الله ويرحمك أصبحت شيخا كبيرا قد أثقلتك", "english": "As for the reports: When the Messenger of God, may God bless him and grant him peace, described the tyrannical rulers, he said: \"Whoever opposes them is saved, whoever withdraws from them is safe — or nearly safe — and whoever falls in with them in their worldly affairs is of them.\" (1)", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 389", "section_title_en": "The Sixth Chapter: On What is Lawful and Unlawful in Associating with Tyrannical Rulers, and the Ruling on Frequent Their Assemblies, Entering Upon Them, and Showing Them Honor", "section_index": 389, "anchors": "- Root: ظلم (Ẓ-L-M)\n  * Lisan / Ayn: Core meaning is placing something in other than its proper place; darkness as the absence of light.\n  * Al-Raghib (Mufradat): \"الظلمة: عدم النور\" — darkness is the absence of light; used metaphorically for ignorance, polytheism, and transgression, as opposed to light (نور) which represents knowledge and justice.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah): \"الظلم ظلمة كما أن العدل نور\" — injustice is darkness just as justice is light. Metaphorical (Majaz): \"أرض مظلومة\" — land never dug or watered, indicating the deprivation of benefit.\n- Root: وهي (W-H-Y)\n  * Lisan / Ayn: Weakness, fissure, or slackening in a structure; a crack in leather or a wall.\n  * Al-Raghib (Mufradat): \"الوهي: شق في الأديم والثوب\" — a rent in hide or cloth; \"وكل شيء استرخى رباطه فقد وهي\" — anything whose binding slackens has become weak.\n  * Al-Zamakhshari (Asas): Literal: \"وهى الحائط\" — the wall cracked. Metaphorical: \"واهي العزالي\" — clouds pouring forth rain, i.e., their water-skins have burst open.\n- Root: خبر (KHB-R)\n  * Lisan / Ayn: Knowledge of a thing from report or direct experience; testing and ascertaining.\n  * Al-Raghib (Mufradat): \"الخبر: العلم بالأشياء المعلومة من جهة الخبر\" — knowledge of things from the channel of report; \"الخبرة المعرفة ببواطن الأمر\" — experiential knowledge of the inner realities of affairs.\n  * Al-Zamakhshari (Asas): Literal: \"خبرت الرجل واختبرته خبرا وخبرة\" — I tested the man and gained knowledge of him. Metaphorical: \"تخبر عن مجهوله مرآته\" — one's mirror reveals his unknown state.\n- Root: وفي (W-F-Y)\n  * Lisan / Ayn: Completeness, fulfillment, and reaching full measure.\n  * Al-Raghib (Mufradat): \"الوافي: الذي بلغ التمام\" — that which has attained completion; \"أوفى: إذا تمم العهد ولم ينقض حفظه\" — fulfilled the covenant and did not breach its preservation.\n  * Al-Zamakhshari (Asas): Literal: \"درهم واف\" — a full-weight dirham. Metaphorical: \"أوفى على المائة\" — he surpassed a hundred; \"توفاه الله\" — God took him in full, i.e., completed his term.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — Governing the exclusive restriction of predication, as in \"فليس مني ولست منه\" (he is not of me, nor am I of him), where the negation establishes complete disassociation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'The Lawful and Prohibited'", "badge": "Insight"}], "260": [{"arabic": "السلام {أو لم تؤمن قال بلى ولكن ليطمئن قلبي} فالتمس أن يكون مشاهدا إحياء الميت بعينه ليثبت في خياله فإن النفس تتبع الخيال وتطمئن به ولا تطمئن باليقين في ابتداء أمرها إلى أن تبلغ بالآخرة إلى درجة النفس المطمئنة وذلك لا يكون في البداية أصلا وكم من مطمئن لا يقين له كسائر أرباب الملل والمذاهب فإن اليهودي مطمئن القلب إلى تهوده وكذا النصراني ولا يقين لهم أصلا وإنما يتبعون الظن وما تهوى الأنفس ولقد جاءهم من ربهم الهدى وهو سبب اليقين إلا أنهم معرضون عنه فإذن الجبن والجراءة غرائز ولا ينفع اليقين مع", "english": "So when you have understood tawakkul in this example, then measure upon it the tawakkul upon Allah — exalted be He. For if there is established in your soul — through unveiling (kashf) or through decisive belief (iʿtiqād jāzim) — that there is no agent (fāʿil) except Allah, as has preceded; and you believe, along with that, in the completeness of [His] knowledge and power (al-ʿilm wa al-qudrah) sufficient for the servants; then the completeness of [His] care, affection, and mercy (al-ʿināyah wa al-ʿaṭf wa al-raḥmah) toward all the servants and each individual; and that there is no power beyond the limit of His power, no knowledge beyond the limit of His knowledge, and no care and mercy beyond the limit of His care for you and His mercy to you — then your heart will inevitably rely upon Him alone, and will not turn to any other in any respect, nor to itself, nor to its own might and strength. For there is no might and no power except through Allah (lā ḥawla wa lā quwwata illā billāh), as has preceded in [the book of] Tawḥīd at the mention of movement and power — for \"might\" (al-ḥawl) is an expression for movement, and \"power\" (al-quwwah) is an expression for capability (al-qudrah).", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1117", "section_title_en": "The Reality of Tawakkul — The Interplay of Certainty (Yaqīn), Heart's Stillness (Ṭuma'nīnah), and the Four Attributes of the Trustee (Al-Wakīl)", "section_index": 1117, "anchors": "- Root: وكل (W-K-L)\n  * Lisan / Ayn: Core meaning of delegating, entrusting, and appointing a deputy (wakīl) to act on one's behalf; the wakīl is the one relied upon for a task.\n  * Al-Raghib (Mufradat): Tawakkul is to rely upon another and make him a deputy over your affair; true tawakkul on Allah is to deem Him sufficient (ḥasbunā Allāh) as the sole Guardian of your state.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage is delegation of a concrete task; metaphorical (majāz) usage is the heart's utter dependence on the trustee, even to the point of describing a weak man as \"tikl\" (one who leans entirely on others).\n- Root: قلب (Q-L-B)\n  * Lisan / Ayn: The heart as the organ of constant turning and overturning (taqlīb); its states fluctuate and shift.\n  * Al-Raghib (Mufradat): Qalb is the turning of a thing from one state to another; the heart's \"turning\" (inqilāb) is its movement between conditions of fear, hope, certainty, and agitation.\n  * Al-Zamakhshari (Asas): Literal: to flip a thing over; metaphorical: the heart's disposition is \"turned\" by overwhelming fancies (awhām) and fears, just as a merchant \"turns over\" goods to inspect their true condition.\n- Root: نفس (N-F-S)\n  * Lisan / Ayn: The self or soul; that which is the seat of inclination and emotional response.\n  * Al-Raghib (Mufradat): The soul (nafs) is the subtle spiritual reality (laṭīfah) that follows imagination (khayāl) and finds rest only through it; the \"tranquil soul\" (al-nafs al-muṭma'innah) is its final perfected state.\n  * Al-Zamakhshari (Asas): Literal: the self as animate essence; metaphorical: the soul's \"flowing out\" (nafāsah) as preciousness, and its agitation as a type of \"breathlessness\" from fear.\n- Root: يقن (Y-Q-N)\n  * Lisan / Ayn: Certainty as the absence of doubt; firm conviction.\n  * Al-Raghib (Mufradat): Yaqīn is a quality of knowledge above mere cognition (ma'rifah); it is the stillness of understanding with the fixity of judgment — as in \"knowledge of certainty\" (ʿilm al-yaqīn), \"eye of certainty\" (ʿayn al-yaqīn), and \"truth of certainty\" (ḥaqq al-yaqīn).\n  * Al-Zamakhshari (Asas): Literal: to be certain of a matter (yaqina al-amr); it is the firmest form of knowing, distinct from mere opinion (ẓann).\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The sentence \"فالسكون في القلب شيء واليقين شيء آخر\" (Stillness in the heart is one thing, and certainty is another thing) uses two nominal sentences with contrastive focus to establish a strict ontological distinction between two distinct realities (ṭuma'nīnah vs. yaqīn), each with its own predicate, preventing conflation.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monotheism and Reliance'", "badge": "Insight"}], "261": [{"arabic": "مطوقة لعناقيد الرطب ومتى كان فى حبة واحدة سمع سنابل فى كل سنبلة مائة ثم انظر إلى أرض البوادي وفتش ظاهرها وباطنها فتراها ترابا متشابها فإذا أنزل عليها الماء اهتزت وربت وأنبتت من كل زوج بهيج ألوانا مختلفة ونباتا متشابها وغير متشابه لكل واحد طعم وريح ولون وشكل يخالف الآخر فانظر إلى كثرتها واختلاف أصنافها وكثرة أشكالها ثم اختلاف طبائع النبات وكثرة منافعه وكيف أودع الله تعالى العقاقير المنافع الغريبة فهذا النبات يغذي وهذا يقوي وهذا يحيي وهذا يقتل وهذا يبرد وهذا يسخن وهذا إذا حصل في المعدة قمع الصفراء من أعماق العروق وهذ", "english": "For the beast has no power over that; but as for man, God created for him the power, then he disabled it and disbelieved in God's grace therein. So those are like cattle — nay, they are even further astray from the way {فَأُولَٰئِكَ كَالْأَنْعَامِ بَلْ هُمْ أَضَلُّ سَبِيلًا}.", "book_title": "Contemplation", "section_title_ar": "Section 1273", "section_title_en": "On Contemplating the Earth, Its Rivers, Mountains, and Minerals — Section 1273", "section_index": 1273, "anchors": "- Root: فكر (f-k-r)\n  * Lisan / Ayn: التفكر: تأمل القلب وتدبر الشيء، والفكر: إعمال النظر في الشيء\n  * Al-Raghib (Mufradat): الفكر: قوة العلم التي بها يدرك الإنسان، وقيل: هو ترتيب أمور معلومة للتأدي إلى مجهول\n  * Al-Zamakhshari (Asas): الفكر: تصرف القلب في النظر — literal: إعمال الروية؛ metaphorical: التفكر في ملكوت الله\n- Root: ارض (arḍ)\n  * Lisan / Ayn: الأرض: التي عليها الناس، وجمعها أرضون\n  * Al-Raghib (Mufradat): الأرض: الجرم المقابل للسماء، ويعبر بها عن أسفل الشيء\n  * Al-Zamakhshari (Asas): literal: الأرض المهاد والفراش؛ metaphorical: تذلل الأرض وسكونها\n- Root: دحا (d-ḥ-w) / مهد (m-h-d)\n  * Lisan / Ayn: مهد: وطأ المكان وهيأه، والمهاد: الفراش الموطأ\n  * Al-Raghib (Mufradat): المهد: الموضع المهيأ للصبي، والمهاد: الأرض الموطأة\n  * Al-Zamakhshari (Asas): literal: فرش الأرض وتمهيدها؛ metaphorical: جعلها قارة ساكنة لا تميد\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — the interposed clause \"فانظر\" after \"إلى الأرض\" maintains grammatical continuity while allowing rhetorical pause.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Contemplation'", "badge": "Hadith"}], "262": [{"arabic": "أمضى السبيل فقلت وما إمضاء السبيل فقيل لي كنت تقول للشيء إنه في سبيل الله ثم ترجع فيه فلو كنت أمضيت السبيل لأمضينا لك وحكي عن بعض العباد بمكة أنه كان نائما إلى جنب رجل معه هميانه فانتبه الرجل ففقد هميانه فاتهمه به فقال له كم كان في هميانك فذكر له فحمله من البيت ووزنه من عنده ثم بعد ذلك أعلمه أصحابه أنهم كانوا أخذوا الهميان مزحا معه فجاء هو وأصحابه معه وردوا الذهب فأبى وقال خذه حلالا طيبا فما كنت لأعود في مال أخرجته في سبيل الله عز وجل فلم يقبل فألحوا عليه فدعا ابنه وجعل يصره صررا ويبعث به إلى الفقراء حتى لم يبق منه شيء فهكذا ك", "english": "...his wealth being for him a deterrent from sin — for perhaps he would become independent by means of it and thus grow lax about theft afterward, while his disobedience had already ceased by his consuming the unlawful, since [the owner] had made it lawful for him. The second [intention] is that he not wrong another Muslim, such that his wealth becomes a ransom for the wealth of another Muslim. And whenever he intends thereby to protect another's wealth with his own wealth, or intends to repel sin from the thief or to lighten it upon him, then he has indeed advised the Muslims sincerely and has complied with his saying, peace and blessings be upon him: {«انصر أخاك ظالما أو مظلوما»} — \"Help your brother whether he is the wrongdoer or the wronged.\" And helping the wrongdoer is that you prevent him from wrongdoing. His pardoning of him is an annihilation of the wrongdoing and a prevention of it. And let him be certain that this intention does not harm him in any way whatsoever, for there is nothing in it that empowers the thief or alters the eternal decree. Rather, let him verify his intention by means of renunciation (zuhd). For if his wealth is taken, he shall have for every dirham seven hundred dirhams, because he intended it and aimed at it. And if it is not taken, he still obtains the reward — as it was related from the Messenger of Allah, peace and blessings be upon him, concerning one who abstained from coitus interruptus and thus left the drop of semen in its place, that he would have the reward of a boy born to him from that intercourse who lived and was then killed in the path of Allah, the Exalted — even if no boy was actually born to him. For the matter of the child is nothing but the intercourse itself; as for the creation, the life, the provision, and the survival, these are not up to him. So had the child been created, his reward would have been upon his own act, and his act was not annihilated. Likewise is the matter of theft.", "book_title": "Monotheism and Reliance", "section_title_ar": "Section 1134", "section_title_en": "On the Etiquettes of Reliance (Adab al-Tawakkul) — Section 1134: Concerning One Whose Wealth is Stolen", "section_index": 1134, "anchors": "- Root: ظلم (Ẓ-L-M)\n  * Lisan / Ayn: Core meaning is \"to place something in other than its proper place\"; darkness (ẓulmah) as its physical correlate.\n  * Al-Raghib (Mufradat): Ẓulm is \"transgression against right\" and is expressed as darkness (ẓulumāt) versus light (nūr) — ignorance, shirk, and fisq.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"He wrongs and is wronged.\" Metaphorical (majāz): \"A land ẓalīm\" — one never dug; the wrongdoer's darkness is like the darkness of the grave.\n- Root: سبل (S-B-L)\n  * Lisan / Ayn: A clear, easy path (sabīl); its plural subul.\n  * Al-Raghib (Mufradat): \"The way in which there is ease\"; when used absolutely, it designates the path of truth (ṭarīq al-ḥaqq).\n  * Al-Zamakhshari (Asas): Literal: \"Take this path, for it is the most even of paths.\" Metaphorical: \"He let down (asbala) the rain\" — as if lowering a curtain; \"he let flow tears.\"\n- Root: سرق (S-R-Q)\n  * Lisan / Ayn: Taking what is not one's own covertly.\n  * Al-Raghib (Mufradat): \"Theft is the taking of what one has no right to take, in secret\"; legally specified by place and amount.\n  * Al-Zamakhshari (Asas): Literal: \"A thief between thefts.\" Metaphorical: \"He stole the hearing\" (listened secretly); \"a stolen voice\" (hoarse).\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Specification with innamā) — Used to confine a predicate to a subject, as in the dream narrative: \"It is only for him who carried the path through (amḍā al-sabīl).\"", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Monotheism and Reliance'", "badge": "Dhikr"}, {"arabic": "يفزع الناس يوم القيامة ولا يفزعون وهم أولياء الله الذين لا خوف عليهم ولا هم يحزنون وفيه شهر بن حوشب مختلف فيه // ورواه أبو هريرة رضي الله عنه وقال فيه إن حول العرش منابر من نور عليها قوم لباسهم نور ووجوههم نورا ليسوا بأنبياء ولا شهداء يغبطهم النبيون والشهداء فقالوا يا رسول الله صفهم لنا فقال هم المتحابون في الله والمتجالسون في الله والمتزاورون في الله (1) وقال صلى الله عليه وسلم ما تحاب اثنان في الله إلا كان أحبهما إلى الله أشدهما حبا لصاحبه (2) ويقال إن الأخوين في الله إذا كان أحدهما أعلى مقاما من الآخر", "english": "Know that affability (al-ulfah) is the fruit of excellent character (ḥusn al-khuluq), and estrangement (al-tafarruq) is the fruit of evil character. For excellent character necessitates mutual love, harmony, and concord, whereas evil character yields mutual hatred, envy, and turning away (al-tadābur). And whenever the source is praiseworthy, the fruit is likewise praiseworthy. The excellence of good character is not hidden in the religion; indeed, it is that with which God—glorified be He—praised His Prophet, peace be upon him, when He said: {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ} «And indeed, you are upon an immense character» (Al-Qalam: 4). The Prophet, peace be upon him, said: \"The thing which most causes people to enter Paradise is God-consciousness (taqwā) and excellent character.\" (1) Usāmah ibn Sharīk said: \"We said, O Messenger of God, what is the best thing given to a person?\" He said: \"Excellent character.\" (2) He, peace be upon him, also said: \"I was sent only to perfect the noble traits of character.\" (3) He, peace be upon him, said: \"Nothing is heavier in the Balance than excellent character.\" (4) He, peace be upon him, said: \"God does not beautify a person's outward form and his inward character, then feed him to the Fire.\" (5) He, peace be upon him, said: \"O Abū Hurayrah, adhere to excellent character.\" (Page V02P157) Abū Hurayrah, may God be pleased with him, said: \"What is excellent character, O Messenger of God?\" He said: \"That you join the one who cuts you off, forgive the one who wrongs you, and give to the one who deprives you.\" (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 402", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 402: On the Excellence of Affability (Al-Ulfah) and Brotherhood in God", "section_index": 402, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of harmonizing, uniting, and reconciling; the removal of estrangement (al-waḥshah) and the establishment of concord.\n  * Al-Raghib (Mufradat): Theological nuance of ta'līf as the divine act of harmonizing hearts, a blessing bestowed by God alone, as in {لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَّا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) denotes physical joining; metaphorical (majāz) denotes the spiritual and moral concord of hearts, which is the fruit of excellent character (ḥusn al-khuluq).\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: Root meaning of measuring, proportioning, and smoothing; hence, the inherent disposition and moral character of a person.\n  * Al-Raghib (Mufradat): The origination of a thing upon a just measure; for character, it is the inward form (al-ṣūrah al-bāṭinah) of the soul, just as the physical form is its outward shape.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is the physical creation and proportioning; metaphorical (majāz) is the moral and spiritual constitution, praised by God in {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ}.\n- Root: بغض (Bughḍ)\n  * Lisan / Ayn: The opposite of love (ḥubb); intense aversion and hatred.\n  * Al-Raghib (Mufradat): In the Kalam context, al-bughḍ fī Allāh (hatred for God's sake) is a spiritual act of discernment and loyalty, not a mere emotional impulse; it is paired with al-ḥubb fī Allāh as the strongest bond of faith (awthaq ʿurā al-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is personal animosity; metaphorical (majāz) is the righteous aversion to disobedience and the enemies of God, which is a form of devotion.\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — Governing the syntactic flow of conditional and relative clauses, ensuring the periodic structure of the author's argument remains coherent and unbroken.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}], "264": [{"arabic": "الوظيفة الخامسة أن لا يفسد صدقته بالمن والأذى قال الله تعالى لا تبطلوا صدقاتكم بالمن والأذى واختلفوا في حقيقة المن والأذى فقيل المن أن يذكرها والأذى أن يظهرها وقال سفيان من من فسدت صدقته فقيل له كيف المن فقال أن يذكره ويتحدث به وقيل المن أن يستخدمه بالعطاء والأذى أن يعيره بالفقر وقيل المن أن يتكبر عليه لأجل عطائه والأذى أن ينتهره أو يوبخه بالمسألة وقد قال صلى الله عليه وسلم لا يقبل الله صدقة منان (2) وعندي أن المن له أصل ومغرس وهو من أحوال القلب وصفاته ثم يتفرع عليه أحوال ظاهرة على اللسان والجوارح فأصله أن يرى نفسه محسنا إليه ومنعما عليه", "english": "A group of the Followers (tābiʿūn) held that there are rights in wealth beyond the zakat — among them al-Nakhaʿī, al-Shaʿbī, ʿAṭāʾ, and Mujāhid. Al-Shaʿbī said, after being asked, \"Is there a right in wealth beyond the zakat?\": \"Yes. Have you not heard His saying — mighty and majestic is He: {«وَآتَى الْمَالَ عَلَىٰ حُبِّهِ ذَوِي الْقُرْبَىٰ»} 'And gives wealth, despite his love for it, to relatives' (2:177)?\" They also adduced His saying — mighty and majestic is He: {«وَمِمَّا رَزَقْنَاهُمْ يُنفِقُونَ»} 'And from what We have provided them, they spend' (2:3), and His saying — exalted is He: {«وَأَنفِقُوا مِن مَّا رَزَقْنَاكُم»} 'And spend from what We have provided you' (2:254). They claimed that this is not abrogated by the verse of zakat; rather, it falls within the right of a Muslim upon a Muslim. Its meaning is that it is incumbent upon the affluent one, whenever he finds a needy person, to remove his need — over and above the zakat wealth.", "book_title": "Patience and Gratitude", "section_title_ar": "Section 173", "section_title_en": "The Second Division: Those Who Guard Their Wealth Awaiting Seasons of Need — On the Inner Meanings of Zakat (Section 173)", "section_index": 173, "anchors": "- Root: ف-ق-ر (f-q-r)\n  * Lisan / Ayn: Core meaning of neediness, poverty; the hollow of the spine (faqār) — that which is structurally weak and dependent.\n  * Al-Raghib (Mufradat): Poverty (faqr) has four senses: (1) essential neediness before Allah, universal to all creatures; (2) lack of possessions; (3) [the third and fourth senses as elaborated in the full lexicon entry].\n  * Al-Zamakhshari (Asas): Literal (haqīqah): one who lacks wealth. Metaphorical (majāz): \"the poverty of speech\" (fuqar al-kalām) — its subtle points, likened to ornaments shaped like vertebrae.\n- Root: ص-د-ق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness in speech; giving (ṣadaqah) as the outward verification of inward faith.\n  * Al-Raghib (Mufradat): Ṣidq (truth) and kidhb (falsehood) are originally in speech — statement of what is, or what will be. By extension, ṣadaqah is that which verifies the truthfulness of one's claim to faith through expenditure.\n  * Al-Zamakhshari (Asas): Literal: truthful speech. Metaphorical: \"a horse with true running\" (dhū miṣdaq fī al-jary) — that which verifies its excellence through action. Thus charity verifies the giver's sincerity.\n- Root: م-ن-ن (m-n-n)\n  * Lisan / Ayn: The bestowal of a favor; reproaching another by reminding them of one's gift (al-mann).\n  * Al-Raghib (Mufradat): [As elaborated in the full lexicon entry on the heart's self-perception of superiority over the recipient.]\n  * Al-Zamakhshari (Asas): Literal: a heavy weight; a favor. Metaphorical: the act of counting one's favors over another — a corrosion of the gift's value.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise scope of obligation (farḍ kifāyah) versus supererogatory merit (faḍl), and the restriction of \"rights in wealth\" (ḥuqūq fī al-māl) beyond the obligatory zakat.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Patience and Gratitude'", "badge": "Insight"}, {"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "الأول تعجيل الطعام فذلك من إكرام الضيف وقد قال صلى الله عليه وسلم من كان يؤمن بالله واليوم الآخر فليكرم ضيفه (1) ومهما حضر الأكثرون وغاب واحد أو اثنان وتأخروا عن الوقت الموعود فحق الحاضر في التعجيل أولى من حق أولئك في التأخير إلا أن يكون المتأخر فقيرا أو ينكسر قلبه بذلك فلا بأس في التأخير وأحد المعنيين في قوله تعالى {هل أتاك حديث ضيف إبراهيم المكرمين} أنهم أكرموا بتعجيل الطعام إليهم دل عليه قوله تعالى {فما لبث أن جاء بعجل حنيذ} وقوله {فراغ إلى أهله فجاء بعجل سمين} والروغان الذهاب بسرعة وقيل في خفية وقيل جاء بفخذ من لحم وإنما سمي ع", "english": "The Prophet (peace and blessings be upon him) said: \"Do not burden your guest so that you make him hate you, for whoever hates his guest has hated Allah, and whoever hates Allah, Allah hates him.\"", "book_title": "Mysteries of Prayer", "section_title_ar": "Section 290", "section_title_en": "The Etiquettes of Hospitality: Invitation, Response, Attendance, and the Serving of Food — Section 290 of The Revival of the Religious Sciences", "section_index": 290, "anchors": "- Root: ضيف (ḍ-y-f)\n  * Lisan / Ayn: Core meaning is \"to incline, to lean toward.\" The guest (al-ḍayf) is one who inclines toward you, alighting as a visitor; the root carries the sense of leaning or bending.\n  * Al-Raghib (Mufradat): The guest is \"one who inclines to you, alighting with you\"; hospitality (al-ḍiyāfah) became customary in the sense of receiving such a one. The word is originally a verbal noun, hence one and many are equal in most usage.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ḍāfa ilayhi: he inclined toward him\"; \"ḍāfat al-shams: the sun inclined toward setting.\" Metaphorical (majāz): \"aḍāfa ilayhi amran: he attributed a matter to him, leaning it upon him\"; \"al-muḍāf: the one constrained, hemmed in, in distress.\"\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — governing the Prophet's statement \"innamā hādhihi al-akhlāq bi-yad Allāh\" (these morals are only in the hand of Allah), where innamā restricts the attribution of moral character exclusively to divine bestowal.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Mysteries of Prayer'", "badge": "Hadith"}], "267": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعالى ويجعلون لله ما يكرهون وتصف ألسنتهم الكذب أن لهم الحسنى لا وقف بعض القراء على النفي تكذيبا لهم ثم ابتدأ وقا", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}], "268": [{"arabic": "وخافون إن كنتم مؤمنين وقال عز وجل الشيطان يعدكم الفقر ويأمركم بالفحشاء والله يعدكم مغفرة منه وفضلا والسؤال من الفحشاء التي أبيحت بالضرورة وحال من يسأل لحاجة متراخية عن يومه وإن كان مما يحتاج إليه في السنة أشد من حال من ملك مالا موروثا وادخره لحاجة وراء السنة وكلاهما مباحان في الفتوى الظاهرة ولكنهما صادران عن حب الدنيا وطول الأمل وعدم الثقة بفضل الله وهذه الخصلة من أمهات المهلكات نسأل الله حسن التوفيق بلطفه وكرمه بيان أحوال السائلين كان بشر رحمه الله يقول الفقراء ثلاثة فقير لا يسأل وإن أعطي لا يأخذ فهذا مع الروحانيين في عليين وفقير لا يسأل", "english": "But if his opportunity to ask would be lost, and he would find no one to give him if he delayed, then asking is permitted for him, because the hope of living a year is not far-fetched. By delaying his asking, he fears that he will remain in dire need, unable to obtain what would aid him. If his fear of being unable to ask in the future is weak, and that for which he asks falls outside the domain of necessity, then his asking is not free from disapproval (karāhah). And the degree of that disapproval corresponds to the degrees of the weakness of his dire need, his fear of missing the opportunity, and the remoteness of the period in which he would need to ask. All of this admits no precise delimitation (ḍabṭ); it is entrusted to the servant's personal striving (ijtihād) and his own discernment for himself, between him and Allah the Exalted. So let him consult his heart concerning it and act upon it, if he is a traveler of the path of the Hereafter. And whoever's certainty (yaqīn) is stronger, whose trust in the coming of provision in the future is more complete, and whose contentment (qanāʿah) with the provision of the moment is more manifest — his rank with Allah the Exalted is higher. Thus, fear of the future — when Allah has given you the provision of your day for yourself and your dependents — arises only from weakness of certainty and hearkening to the intimidation of Satan. Allah the Exalted has said: {«فَلَا تَخَافُوهُمْ وَخَافُونِ إِن كُنتُم مُّؤْمِنِينَ»} \"So fear them not, but fear Me, if you are believers\" (Q. 3:175). And He, Glorified and Exalted, said: {«الشَّيْطَانُ يَعِدُكُمُ الْفَقْرَ وَيَأْمُرُكُم بِالْفَحْشَاءِ وَاللَّهُ يَعِدُكُم مَّغْفِرَةً مِّنْهُ وَفَضْلًا»} \"Satan promises you poverty and commands you to indecency, and Allah promises you forgiveness from Him and bounty\" (Q. 2:268). And asking is among the indecencies (fawāḥish) that have been permitted by necessity. The state of one who asks for a need remote from his day — even if it is something he needs within the year — is worse than the state of one who possesses inherited wealth and has stored it for a need beyond the year. Both are permissible in the apparent legal ruling (fatwā), but both originate from love of this world, length of hope (ṭūl al-amal), and lack of trust in Allah's bounty. And this trait is among the mother of all destroyers (ummahāt al-muhlikāt). We ask Allah for beautiful success through His gentleness and generosity.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1085", "section_title_en": "The Revival of the Religious Sciences — Book on the Etiquettes of Poverty and Asceticism: Section on the Degrees of the Askers and the States of the Poor", "section_index": 1085, "anchors": "- Root: س-أ-ل (sa-ʾa-la)\n  * Lisan / Ayn: Core root denotes asking, requesting, or petitioning; the act of seeking something from another.\n  * Al-Raghib (Mufradat): In theological usage, 'suʾāl' (asking) is tied to need (ḥājah) and is morally neutral in itself, becoming blameworthy when it exceeds necessity or arises from weak trust in Allah's provision.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) sense is the verbal request for an object; metaphorical (majāz) extension applies to asking of Allah in supplication (duʿāʾ), which is always praiseworthy.\n- Root: ف-ق-ر (fa-qā-ra)\n  * Lisan / Ayn: Core root denotes poverty, neediness, or lack of means; also spinal vulnerability (faqār), implying one broken by need.\n  * Al-Raghib (Mufradat): 'Faqr' is the existential state of being in want; in the Kalam framework, it contrasts with divine self-sufficiency (ghinā), and the poor (fuqarāʾ) are ranked by their inner state, not mere outward lack.\n  * Al-Zamakhshari (Asas): Literal sense is material destitution; metaphorical sense is spiritual poverty before Allah, the highest station of the knowers (ʿārifūn).\n- Root: ي-ق-ن (ya-qī-na)\n  * Lisan / Ayn: Core root denotes certainty, firm conviction, and the absence of doubt.\n  * Al-Raghib (Mufradat): 'Yaqīn' is the apex of faith (īmān), comprising knowledge (ʿilm), state (ḥāl), and action (ʿamal); it is the antidote to fear of future provision.\n  * Al-Zamakhshari (Asas): Literal sense is settled knowledge; metaphorical sense is the heart's repose in Allah's guarantee of sustenance, rendering anxiety a form of disbelief in that promise.\n- Sibawayh Rule: Rule of Conditional Restriction (al-sharṭ wa-l-jazāʾ) — The protasis (condition) and apodosis (result) structure in \"If he is able to ask and does not miss his opportunity, then it is not lawful for him to ask\" governs the legal determination, where the condition specifies the scope of the ruling.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "بد لهم منه وذلك لأن الشيطان يعدهم الفقر ويأمرهم بالفحشاء فيصغون إليه ويجمعون ما لا يأكلون خيفة الفقر والله يعدهم مغفرة منه وفضلا فيعرضون عنه ولا يرغبون فيه الأمر الثاني القيلولة وهي سنة يستعان بها على قيام الليل كما أن التسحر سنة يستعان به على صيام النهار فإن كان لا يقوم بالليل لكن لو لم ينم لم يشتغل بخير وربما خالط أهل الغفلة وتحدث معهم فالنوم أحب له إذا كان لا ينبعث نشاطه للرجوع إلى الأذكار والوظائف المذكورة إذ في النوم الصمت والسلامة وقد قال بعضهم يأتي على الناس زمان الصمت والنوم فيه أفضل أعم", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Arrangement of Litanies'", "badge": "Du'a"}, {"arabic": "ويجمعون ما لا يأكلون خيفة الفقر والله يعدهم مغفرة منه وفضلا فيعرضون عنه ولا يرغبون فيه الأمر الثاني القيلولة وهي سنة يستعان بها على قيام الليل كما أن التسحر سنة يستعان به على صيام النهار فإن كان لا يقوم بالليل لكن لو لم ينم لم يشتغل بخير وربما خالط أهل الغفلة وتحدث معهم فالنوم أحب له إذا كان لا ينبعث نشاطه للرجوع إلى الأذكار والوظائف المذكورة إذ في النوم الصمت والسلامة وقد قال بعضهم يأتي على الناس زمان الصمت والنوم فيه أفضل أعمالهم وكم من عابد أحسن أحواله النوم وذلك إذا كان يرائي بعبادته ولا يخل", "english": "Now, the first watch (al-wird al-awwal) is that which extends from the dawn prayer (ṣalāt al-ṣubḥ) until sunrise (ṭulūʿ al-shams). When the servant has completed his obligatory prayer, he should remain seated in his place of prayer, occupying himself with the remembrance of God most High, until the sun has risen. For it has been reported that the Messenger of God, peace and blessings be upon him, said: \"That I should sit in my assembly, remembering God most High therein, from the morning prayer until sunrise, is more beloved to me than freeing four slaves.\" {«لأن أقعد في مجلسي أذكر الله تعالى فيه من صلاة الغداة إلى طلوع الشمس أحب إلي من أن أعتق أربع رقاب»} And it is related that he, peace and blessings be upon him, when he had prayed the morning prayer, would sit in his place of prayer until the sun rose; and in some versions [it is added] that he would pray two rakʿahs—that is, after sunrise. Concerning the virtue of this [practice], an incalculable number of reports have come down. Al-Ḥasan related that the Messenger of God, peace and blessings be upon him, used to mention, among what he recounted of his Lord's mercy, that He said: \"O son of Adam, remember Me for an hour after the dawn prayer and for an hour after the afternoon prayer, and I shall suffice you for what lies between them.\" {«يا ابن آدم اذكرني بعد صلاة الفجر ساعة وبعد صلاة العصر ساعة أكفك ما بينهما»}", "book_title": "Arrangement of Litanies", "section_title_ar": "Section 260", "section_title_en": "The Daily Liturgy of the Devout Servant: The First Watch (After Dawn Prayer until Sunrise)", "section_index": 260, "anchors": "- Root: ذكر (dhakara)\n  * Lisan / Ayn: Remembrance, invocation, mention; the opposite of forgetfulness (nisyān).\n  * Al-Raghib (Mufradat): Remembrance of God (dhikr) is the heart's presence with the Divine, ranging from the tongue's utterance to the heart's contemplation; it is the noblest act when accompanied by presence of heart.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): verbal mention. Metaphorical (majāz): the heart's steadfastness in knowledge of God, which is the reality of dhikr.\n- Root: صلا (ṣallā)\n  * Lisan / Ayn: Prayer (ṣalāh); root meaning of supplication and blessing; also \"to kindle a fire\" (as in ṣalā al-nār).\n  * Al-Raghib (Mufradat): Ṣalāh is the servant's standing before God in humility and devotion, comprising praise, recitation, bowing, and prostration; its perfection lies in the heart's presence.\n  * Al-Zamakhshari (Asas): Literal: the ritual prayer with its pillars. Metaphorical: supplication (duʿā') and blessing (taṣliyah) upon the Prophet.\n- Root: ورد (warada)\n  * Lisan / Ayn: To arrive at water; a portion or share of something that comes regularly.\n  * Al-Raghib (Mufradat): The daily portion (wird) of devotion—a set liturgy of prayers, recitations, and remembrances that the servant regularly performs at appointed times.\n  * Al-Zamakhshari (Asas): Literal: arriving at a watering place. Metaphorical: the soul's regular approach to the fountain of divine grace through prescribed acts of worship.\n- Sibawayh Rule: Rule of Restriction and Specification (al-ḥaṣr wa al-taqyīd) — governing the precise enumeration of the four functions (adʿiyah, adhkār, qirā'ah, fikr) after the dawn prayer, each specified by its own governing verb and object.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Arrangement of Litanies'", "badge": "Hadith"}, {"arabic": "الرجيم ثم تلا قوله تعالى الشيطان يعدكم الفقر ويأمركم بالفحشاء (1) أخرجه الترمذي والنسائي (2) حديث قلب المؤمن بين إصبعين الحديث تقدم فالله يتعالى عن أن يكون له أصبع مركبة من لحم ودم وعصب منقسمة بالأنامل ولكن روح الإصبع سرعة التقليب والقدرة على التحريك والتغيير فإنك لا تريد إصبعك لشخصه بل لفعله في التقليب والترديد كما أنك تتعاطى الأفعال بأصابعك والله تعالى يفعل ما يفعل باستسخار الملك والشيطان وهما مسخران بقدرته في تقليب القلوب كما أن أصابعك مسخرة لك في تقليب الأجسام مثلا والقلب بأصل الفطرة صالح لقبول آثار", "english": "The angel is an expression for a created being (khalq) whom God, Exalted is His majesty, created—whose very attribute is the effusion of good, the bestowal of knowledge, the uncovering of truth, the promising of good, and the commanding of what is right. He created him and subjugated him to that. The Satan is an expression for a created being whose attribute is the opposite of that—namely, the promising of evil, the commanding of indecency, and the frightening with poverty at the moment of resolving upon good. Thus whispering stands in opposition to inspiration, the Satan in opposition to the angel, and divine success in opposition to abandonment. And to this points His saying, Exalted is He: {«وَمِن كُلِّ شَيْءٍ خَلَقْنَا زَوْجَيْنِ»} (And of all things We have created pairs) [Quran 51:49]. For all existent things are paired and opposed—except God, Exalted is He, for He is the One (al-Fard) who has no opposite. Rather, He is the One, the True, the Creator of all pairs.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 596", "section_title_en": "The Heart's Attraction Between the Angel and the Satan: On Inspiration and Whispering", "section_index": 596, "anchors": "- Root: خطر (khaṭara)\n  * Lisan / Ayn: The passing of something through the mind; the occurrence of a thought or notion.\n  * Al-Raghib (Mufradat): The initial stirring of the heart toward an action—the first movement of intention.\n  * Al-Zamakhshari (Asas): Literal: the striking of an idea upon the heart. Metaphorical: the very inception of volitional acts.\n- Root: ملك (malaka)\n  * Lisan / Ayn: Possession, dominion; the angel as a created being entrusted with a function.\n  * Al-Raghib (Mufradat): The angel is a subtle spiritual reality (laṭīfah) created for the effusion of good and the conveyance of divine command.\n  * Al-Zamakhshari (Asas): Literal: one who possesses and governs. Metaphorical: the spiritual power that inclines the heart toward truth.\n- Root: وسوس (waswasa)\n  * Lisan / Ayn: The faint, hidden sound; the subtle, insinuating call.\n  * Al-Raghib (Mufradat): The whispering of the Satan—the evil suggestion that invites to transgression.\n  * Al-Zamakhshari (Asas): Literal: the quiet, indistinct voice. Metaphorical: the insinuation of evil into the heart.\n- Root: لطف (laṭufa)\n  * Lisan / Ayn: Gentleness, subtlety, refinement.\n  * Al-Raghib (Mufradat): The divine subtlety (al-luṭf) by which the heart is prepared to receive inspiration—a spiritual, immaterial reality.\n  * Al-Zamakhshari (Asas): Literal: that which is fine and delicate. Metaphorical: the divine grace that disposes the heart toward good.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The restriction of each cause to its specific effect, and the pairing of contrasting terms (inspiration vs. whispering; angel vs. Satan; success vs. abandonment) to establish the precise correspondence between spiritual causes and their consequences.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Disciplining the Soul'", "badge": "Hadith"}], "269": [{"arabic": "ومن يؤت الحكمة فقد أوتى خيرا كثيرا} وقال صلى الله عليه وسلم كلمة من الحكمة يتعلمها الرجل خير له من الدنيا وما فيها (2) فانظر ما الذي كانت الحكمة عبارة عنه وإلى ماذا نقل وقس به بقية الألفاظ واحترز عن الاغترار بتلبيسات علماء السوء فإن شرهم على الدين أعظم من شر الشياطين إذ الشيطان بواسطتهم يتدرج إلى انتزاع الدين من قلوب الخلق ولهذا لما سئل رسول الله صلى الله عليه وسلم عن شر الخلق أبى وقال اللهم اغفر حتى كرروا عليه فقال هم علماء السوء (3) فقد عرفت العلم المحمود والمذموم ومثار الالتباس وإلي", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Poverty and Abstinence'", "badge": "Du'a"}, {"arabic": "والحكمة هي التي أثنى الله عز وجل عليها فقال تعالى {يؤتى الحكمة من يشاء ومن يؤت الحكمة فقد أوتى خيرا كثيرا} وقال صلى الله عليه وسلم كلمة من الحكمة يتعلمها الرجل خير له من الدنيا وما فيها (2) فانظر ما الذي كانت الحكمة عبارة عنه وإلى ماذا نقل وقس به بقية الألفاظ واحترز عن الاغترار بتلبيسات علماء السوء فإن شرهم على الدين أعظم من شر الشياطين إذ الشيطان بواسطتهم يتدرج إلى انتزاع الدين من قلوب الخلق ولهذا لما سئل رسول الله صلى الله عليه وسلم عن شر الخلق أبى وقال اللهم اغفر حتى كرروا عليه فقال هم علماء السوء (3) فقد عرفت العلم المحمود والمذموم ومثار الالتباس وإليك", "english": "Saʿd ibn Abī Waqqāṣ, may God be pleased with him, said to his son ʿUmar — having heard him composing sajʿ — \"This is what makes me dislike you. I will never fulfill your need until you repent.\" This was said when his son had come to him seeking a favor. And the Prophet, may God bless him and grant him peace, said to ʿAbd Allāh ibn Rawāḥah when he spoke in sajʿ of three words: \"Beware of sajʿ, O Ibn Rawāḥah.\" Thus, the forbidden sajʿ is the artificially contrived kind that exceeds two words. For this reason, when a man spoke concerning the blood-money for a fetus — saying, \"How shall we pay blood-money for one who neither drank, nor ate, nor cried out, nor wailed? Such a one's blood is void\" — the Prophet, may God bless him and grant him peace, replied: \"Sajʿ like the sajʿ of the bedouins!\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 31", "section_title_en": "On the Etiquette of Preaching: The Condemnation of Artificial Sajʿ, Excessive Poetry, and the Perils of Shataḥ and Taʿwīl", "section_index": 31, "anchors": "- Root: سجع (sajʿa)\n  * Lisan / Ayn: Rhymed prose; from the root meaning \"to coo\" (as a dove), indicating a measured, melodious cadence in speech.\n  * Al-Raghib (Mufradat): In theological discourse, sajʿ is permissible when natural but blameworthy when artificially cultivated (takalluf), as it shifts focus from meaning to ornamentation.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — natural rhythmic speech; Metaphorical (majāz) — the \"sajʿ of the bedouins\" (sajʿ al-aʿrāb) as a pejorative for empty, affected eloquence.\n- Root: شعر (shiʿr)\n  * Lisan / Ayn: Poetry; from the root denoting perception and fine discernment (shuʿūr), as the poet grasps subtle meanings.\n  * Al-Raghib (Mufradat): Poetry is blameworthy when it stirs base appetites, but praiseworthy when it conveys wisdom (ḥikmah), as in the prophetic saying \"Indeed from poetry there is wisdom.\"\n  * Al-Zamakhshari (Asas): Literal — metered, rhymed speech; Metaphorical — the \"poetry\" of the heart's inclination, where listeners project their own passions onto what they hear.\n- Root: شطح (shaṭaḥa)\n  * Lisan / Ayn: To overflow, to gush forth; originally of a water-skin bursting, then applied to ecstatic utterances that overflow the bounds of conventional discourse.\n  * Al-Raghib (Mufradat): In Sufi terminology, shataḥ refers to utterances arising from overwhelming spiritual states (ḥāl) that, when voiced to the unworthy, cause corruption.\n  * Al-Zamakhshari (Asas): Literal — physical overflowing; Metaphorical — the soul's overflow in speech that exceeds the speaker's intentional control.\n- Root: أول (taʿwīl)\n  * Lisan / Ayn: To return something to its origin or end; interpretation that traces a word back to its intended meaning.\n  * Al-Raghib (Mufradat): Taʿwīl is legitimate only when supported by textual (naqlī) or rational (ʿaqlī) evidence; arbitrary taʿwīl that severs words from their established senses destroys religious trust.\n  * Al-Zamakhshari (Asas): Literal — the apparent sense (ẓāhir); Metaphorical — the inner sense (bāṭin), which is only valid when the literal sense is impossible or when transmitted authority sanctions it.\n- Sibawayh Rule: Bāb al-Ḥaṣr wa al-Taqyīd bi-innamā (Restriction and Focused Predication) — The text repeatedly uses restrictive constructions (innamā, laysa...illā) to delimit permissible preaching, poetry, and interpretation, distinguishing the praiseworthy from the blameworthy with syntactic precision.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Book of Knowledge'", "badge": "Du'a"}], "271": [{"arabic": "تطفىء غضب الرب (6) وقال تعالى وإن تخفوها وتؤتوها الفقراء فهو خير لكم وفائدة الإخفاء الخلاص من آفات الرياء والسمعة فقد قال صلى الله عليه وسلم لا يقبل الله من مسمع ولا مراء ولا منان والمتحدث بصدقته يطلب السمعة والمعطي في ملأ من الناس يبغي الرياء والإخفاء والسكوت هو المخلص منه (7) وقد بالغ في فضل الإخفاء جماعة حتى اجتهدوا أن لا يعرف القابض المعطي فكان بعضهم يلقيه في يد أعمى وبعضهم يلقيه في طريق الفقير وفي موضع جلوسه حيث يراه ولا يرى المعطي وبعضهم كان يصره في ثوب الفقير وهو نائم وبعضهم كان يوصل إلى يد الفقير على يد", "english": "A group of the Followers (tābiʿūn) held that there are rights in wealth beyond the zakat — among them al-Nakhaʿī, al-Shaʿbī, ʿAṭāʾ, and Mujāhid. Al-Shaʿbī said, after being asked, \"Is there a right in wealth beyond the zakat?\": \"Yes. Have you not heard His saying — mighty and majestic is He: {«وَآتَى الْمَالَ عَلَىٰ حُبِّهِ ذَوِي الْقُرْبَىٰ»} 'And gives wealth, despite his love for it, to relatives' (2:177)?\" They also adduced His saying — mighty and majestic is He: {«وَمِمَّا رَزَقْنَاهُمْ يُنفِقُونَ»} 'And from what We have provided them, they spend' (2:3), and His saying — exalted is He: {«وَأَنفِقُوا مِن مَّا رَزَقْنَاكُم»} 'And spend from what We have provided you' (2:254). They claimed that this is not abrogated by the verse of zakat; rather, it falls within the right of a Muslim upon a Muslim. Its meaning is that it is incumbent upon the affluent one, whenever he finds a needy person, to remove his need — over and above the zakat wealth.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 173", "section_title_en": "The Second Division: Those Who Guard Their Wealth Awaiting Seasons of Need — On the Inner Meanings of Zakat (Section 173)", "section_index": 173, "anchors": "- Root: ف-ق-ر (f-q-r)\n  * Lisan / Ayn: Core meaning of neediness, poverty; the hollow of the spine (faqār) — that which is structurally weak and dependent.\n  * Al-Raghib (Mufradat): Poverty (faqr) has four senses: (1) essential neediness before Allah, universal to all creatures; (2) lack of possessions; (3) [the third and fourth senses as elaborated in the full lexicon entry].\n  * Al-Zamakhshari (Asas): Literal (haqīqah): one who lacks wealth. Metaphorical (majāz): \"the poverty of speech\" (fuqar al-kalām) — its subtle points, likened to ornaments shaped like vertebrae.\n- Root: ص-د-ق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness in speech; giving (ṣadaqah) as the outward verification of inward faith.\n  * Al-Raghib (Mufradat): Ṣidq (truth) and kidhb (falsehood) are originally in speech — statement of what is, or what will be. By extension, ṣadaqah is that which verifies the truthfulness of one's claim to faith through expenditure.\n  * Al-Zamakhshari (Asas): Literal: truthful speech. Metaphorical: \"a horse with true running\" (dhū miṣdaq fī al-jary) — that which verifies its excellence through action. Thus charity verifies the giver's sincerity.\n- Root: م-ن-ن (m-n-n)\n  * Lisan / Ayn: The bestowal of a favor; reproaching another by reminding them of one's gift (al-mann).\n  * Al-Raghib (Mufradat): [As elaborated in the full lexicon entry on the heart's self-perception of superiority over the recipient.]\n  * Al-Zamakhshari (Asas): Literal: a heavy weight; a favor. Metaphorical: the act of counting one's favors over another — a corrosion of the gift's value.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise scope of obligation (farḍ kifāyah) versus supererogatory merit (faḍl), and the restriction of \"rights in wealth\" (ḥuqūq fī al-māl) beyond the obligatory zakat.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Mysteries of Zakat'", "badge": "Ethics"}, {"arabic": "الرياء فقد قال الله عز وجل إن تبدوا الصدقات فنعما هي وذلك حيث يقتضي الحال الإبداء إما للاقتداء وإما لأن السائل إنما سأل على ملأ من الناس فلا ينبغي أن يترك التصدق خيفة من الرياء في الإظهار بل ينبغي أن يتصدق ويحفظ سره عن الرياء بقدر الإمكان وهذا لأن في الإظهار محذورا ثالثا سوى المن والرياء وهو هتك ستر الفقير فإنه ربما يتأذى بأن يرى في صورة المحتاج فمن أظهر السؤال فهو الذي هتك ستر نفسه فلا يحذر هذا المعنى في إظهاره وهو كإظهار الفسق على من تستر به فإنه محظور والتجسس فيه والاعتياد بذكره منهي عنه فأم", "english": "A group of the Followers (tābiʿūn) held that there are rights in wealth beyond the zakat — among them al-Nakhaʿī, al-Shaʿbī, ʿAṭāʾ, and Mujāhid. Al-Shaʿbī said, after being asked, \"Is there a right in wealth beyond the zakat?\": \"Yes. Have you not heard His saying — mighty and majestic is He: {«وَآتَى الْمَالَ عَلَىٰ حُبِّهِ ذَوِي الْقُرْبَىٰ»} 'And gives wealth, despite his love for it, to relatives' (2:177)?\" They also adduced His saying — mighty and majestic is He: {«وَمِمَّا رَزَقْنَاهُمْ يُنفِقُونَ»} 'And from what We have provided them, they spend' (2:3), and His saying — exalted is He: {«وَأَنفِقُوا مِن مَّا رَزَقْنَاكُم»} 'And spend from what We have provided you' (2:254). They claimed that this is not abrogated by the verse of zakat; rather, it falls within the right of a Muslim upon a Muslim. Its meaning is that it is incumbent upon the affluent one, whenever he finds a needy person, to remove his need — over and above the zakat wealth.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 173", "section_title_en": "The Second Division: Those Who Guard Their Wealth Awaiting Seasons of Need — On the Inner Meanings of Zakat (Section 173)", "section_index": 173, "anchors": "- Root: ف-ق-ر (f-q-r)\n  * Lisan / Ayn: Core meaning of neediness, poverty; the hollow of the spine (faqār) — that which is structurally weak and dependent.\n  * Al-Raghib (Mufradat): Poverty (faqr) has four senses: (1) essential neediness before Allah, universal to all creatures; (2) lack of possessions; (3) [the third and fourth senses as elaborated in the full lexicon entry].\n  * Al-Zamakhshari (Asas): Literal (haqīqah): one who lacks wealth. Metaphorical (majāz): \"the poverty of speech\" (fuqar al-kalām) — its subtle points, likened to ornaments shaped like vertebrae.\n- Root: ص-د-ق (ṣ-d-q)\n  * Lisan / Ayn: Truthfulness in speech; giving (ṣadaqah) as the outward verification of inward faith.\n  * Al-Raghib (Mufradat): Ṣidq (truth) and kidhb (falsehood) are originally in speech — statement of what is, or what will be. By extension, ṣadaqah is that which verifies the truthfulness of one's claim to faith through expenditure.\n  * Al-Zamakhshari (Asas): Literal: truthful speech. Metaphorical: \"a horse with true running\" (dhū miṣdaq fī al-jary) — that which verifies its excellence through action. Thus charity verifies the giver's sincerity.\n- Root: م-ن-ن (m-n-n)\n  * Lisan / Ayn: The bestowal of a favor; reproaching another by reminding them of one's gift (al-mann).\n  * Al-Raghib (Mufradat): [As elaborated in the full lexicon entry on the heart's self-perception of superiority over the recipient.]\n  * Al-Zamakhshari (Asas): Literal: a heavy weight; a favor. Metaphorical: the act of counting one's favors over another — a corrosion of the gift's value.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — governing the precise scope of obligation (farḍ kifāyah) versus supererogatory merit (faḍl), and the restriction of \"rights in wealth\" (ḥuqūq fī al-māl) beyond the obligatory zakat.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}, {"arabic": "الله تعالى على السر والعلانية فقال إن تبدوا الصدقات فنعما هي وإن تخفوها وتؤتوها الفقراء فهو خير لكم والإظهار قسمان أحدهما في نفس العمل والآخر التحدث بما عمل القسم الأول إظهار نفس العمل كالصدقة في الملأ لترغيب الناس فيها كما روي عن الأنصاري الذي جاء بالصرة فتتابع الناس بالعطية لما رأوه فقال النبي صلى الله عليه وسلم من سن سنة حسنة فعمل بها كان له أجرها وأجر من اتبعه // حديث من سن سنة حسنة فعمل بها كان له أجرها وأجر من اتبعه وفي أوله قصة مسلم من حديث جرير بن عبد الله البيهقي وتجري سائر الأعمال هذا المجرى من الصلاة والصيام والحج والغزو وغيرها ول", "english": "Know that in the secrecy of deeds there is the benefit of sincerity (ikhlāṣ) and deliverance from ostentation (riyā'), while in their public display there is the benefit of emulation (iqtidā') and the incitement of people toward goodness — but in it also lies the affliction of ostentation. Al-Hasan said: \"The Muslims have known that secrecy is the more protective of the two deeds.\" Yet in public display there is also a benefit, and for this reason Allah the Exalted praised both secrecy and openness, saying: {«إِن تُبْدُوا الصَّدَقَاتِ فَنِعِمَّا هِيَ وَإِن تُخْفُوهَا وَتُؤْتُوهَا الْفُقَرَاءَ فَهُوَ خَيْرٌ لَّكُمْ»} [If you disclose your charitable expenditures, they are good; but if you conceal them and give them to the poor, it is better for you] (Al-Baqarah: 271).", "book_title": "Condemnation of Status and Ostentation", "section_title_ar": "Section 831", "section_title_en": "On the Permissibility of Intending the Public Display of Acts of Obedience", "section_index": 831, "anchors": "- Root: نزغ (n-z-gh)\n  * Lisan / Ayn: \"النزغ: الدخول في الأمر بإفساد، والنزغ من الشيطان: الوسوسة والطعن\"\n  * Al-Raghib (Mufradat): \"النزغ: إفساد الشيء بالطعن فيه، ونزغ الشيطان: إلقاء الخواطر الفاسدة في القلب\"\n  * Al-Zamakhshari (Asas): \"نزغ بينهم: أفسد. ونزغ الشيطان: وسوس. وهو حقيقي في الإفساد، مجازي في الوسوسة\"\n- Root: سكر (s-k-r)\n  * Lisan / Ayn: \"السكر: ما سدد به النهر وغيره، والجمع سكور\"\n  * Al-Raghib (Mufradat): \"السكر: ما يرد به الماء، ويستعار لكل ما يمنع من الشيء\"\n  * Al-Zamakhshari (Asas): \"سكر النهر: سده. والسكر: الحاجز. وهو حقيقة في السد، مجاز في المنع\"\n- Root: أسر (s-r-r)\n  * Al-Raghib (Mufradat): \"السر: ما يكتم، وهو ضد الإعلان. والسريرة: ما أسرّه الإنسان في نفسه\"\n  * Al-Zamakhshari (Asas): \"أسررت الشيء: خفيته. وساررته: كلمته سراً. والسر: حقيقة في الخفاء\"\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The periodic sentence structure here employs interposed clauses to distinguish between the two opposing states (sleep and wakefulness) within a single governing verbal frame.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Condemnation of Status and Ostentation'", "badge": "Hadith"}], "273": [{"arabic": "الله تعالى {يحسبهم الجاهل أغنياء من التعفف تعرفهم بسيماهم لا يسألون الناس إلحافا} أي لا يلحون في السؤال لأنهم أغنياء بيقينهم أعزة بصبرهم وهذا ينبغي أن يطلب بالتفحص عن أهل الدين في كل محلة ويستكشف عن بواطن أحول أهل الخير والتجمل فثواب صرف المعروف إليهم أضعاف ما يصرف إلى المجاهرين بالسؤال الصفة الخامسة أن يكون معيلا أو محبوسا بمرض أو بسبب من الأسباب فيوجد فيه معنى قوله عز وجل {للفقراء الذين أحصروا في سبيل الله} أي حبسوا في طريق الآخرة بعيلة أو ضيق معيشة أو إصلاح قلب {لا يستطيعون ضربا في الأ", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Poverty and Abstinence'", "badge": "Insight"}, {"arabic": "فيه معنى قوله عز وجل {للفقراء الذين أحصروا في سبيل الله} أي حبسوا في طريق الآخرة بعيلة أو ضيق معيشة أو إصلاح قلب {لا يستطيعون ضربا في الأرض} لأنهم مقصوصوا الجناح مقيدوا الأطراف فبهذه الأسباب كان عمر رضي الله عنه يعطي أهل البيت القطيع من الغنم العشرة فما فوقها وكان صلى الله عليه وسلم يعطي العطاء على مقدار العيلة (4) وسأل عمر رضي الله عنه عن جهد البلاء فقال كثرة العيال وقلة المال الصفة السادسة أن يكون من الأقارب وذوي الأرحام فتكون صدقة وصلة رحم وفي صلة الرحم من الثواب ما لا يحصى قال علي رضي الله عنه لأن أ", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}, {"arabic": "طريق الآخرة بعيلة أو ضيق معيشة أو إصلاح قلب {لا يستطيعون ضربا في الأرض} لأنهم مقصوصوا الجناح مقيدوا الأطراف فبهذه الأسباب كان عمر رضي الله عنه يعطي أهل البيت القطيع من الغنم العشرة فما فوقها وكان صلى الله عليه وسلم يعطي العطاء على مقدار العيلة (4) وسأل عمر رضي الله عنه عن جهد البلاء فقال كثرة العيال وقلة المال الصفة السادسة أن يكون من الأقارب وذوي الأرحام فتكون صدقة وصلة رحم وفي صلة الرحم من الثواب ما لا يحصى قال علي رضي الله عنه لأن أصل أخا من إخواني بدرهم أحب إلي من أن أتصدق بعشرين درهما ولأن أصله بعشرين درهما أ", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Mysteries of Zakat", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Mysteries of Zakat'", "badge": "Insight"}, {"arabic": "ديارهم وأموالهم} الآية وقال تعالى {للفقراء الذين أحصروا في سبيل الله لا يستطيعون ضربا في الأرض} ساق الكلام في معرض المدح ثم قدم وصفهم بالفقر على وصفهم بالهجرة والإحصار وفيه دلالة ظاهرة على مدح الفقر وأما الأخبار في مدح الفقر فأكثر من أن تحصى روى عبد الله بن عمر رضي الله عنهما قال قال رسول الله صلى الله عليه وسلم لأصحابه أي الناس خير فقالوا موسر من المال يعطي حق الله من نفسه وماله فقال نعم الرجل هذا وليس به قالوا فمن خير الناس يا رسول الله قال فقير يعطي جهده (4) وقال صلى الله عليه وسلم لبلال الق الله فقيرا ولا تلقه غنيا (5) وقال صلى الله", "english": "As for the verses [of the Qur'an], that is indicated by His saying, the Exalted: {«لِلْفُقَرَاءِ الْمُهَاجِرِينَ الَّذِينَ أُخْرِجُوا مِنْ دِيَارِهِمْ وَأَمْوَالِهِمْ»} [To the poor emigrants who were driven out of their homes and their wealth] (59:8), to the end of the verse. And He said, the Exalted: {«لِلْفُقَرَاءِ الَّذِينَ أُحْصِرُوا فِي سَبِيلِ اللَّهِ لَا يَسْتَطِيعُونَ ضَرْبًا فِي الْأَرْضِ»} [To the poor who are confined in the way of Allah, unable to travel in the land] (2:273). He directed the discourse in the context of praise, then He advanced their description with poverty before their description with emigration and confinement. In this there is an evident indication of the praise of poverty.", "book_title": "Poverty and Abstinence", "section_title_ar": "Section 1069", "section_title_en": "The Virtue of Poverty: Scriptural Evidences and Their Interpretation", "section_index": 1069, "anchors": "- Root: فقر (F-Q-R)\n  * Lisan / Ayn: Core meaning of need, indigence, and the state of lacking possessions; also the notches of a vertebra or the joints of the back, indicating structural dependence.\n  * Al-Raghib (Mufradat): Poverty is of four degrees: (1) essential neediness before God (universal to all creatures), (2) lack of worldly goods (the subject here), (3) voluntary renunciation (zuhd), and (4) the perfection of the heart's detachment. The praise of poverty here targets the second and third degrees, not destitution that breeds discontent.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) poverty is the absence of wealth; metaphorical (Majaz) poverty is the soul's humility and its \"notches\" of dependence on God. The Prophet's praise of the \"poor\" (fuqara') must be read as praise of the virtuous poor (mutafaQQir), not the covetous.\n- Root: هجر (H-J-R)\n  * Lisan / Ayn: To abandon, emigrate, or sever ties; the act of leaving one's homeland for a religious purpose.\n  * Al-Raghib (Mufradat): Hijrah (emigration) is a physical act of devotion, but the Quranic verse pairs it with poverty, elevating the state of neediness as a spiritual station above the mere act of relocation.\n  * Al-Zamakhshari (Asas): The verse's structure (taqdim) places \"poverty\" before \"emigration\" and \"confinement,\" signaling its superior rank in the divine estimation.\n- Root: قدر (Q-D-R)\n  * Lisan / Ayn: Measure, decree, power, and estimation; the act of determining a precise limit or quantity.\n  * Al-Raghib (Mufradat): When applied to God, Qadar is His eternal decree; when applied to the Prophet's speech, it denotes precise, divinely-inspired measurement—never arbitrary or haphazard.\n  * Al-Zamakhshari (Asas): Literal: to measure out (qaddara). Metaphorical: the \"measure\" of a thing's worth or rank. The Prophet's numerical estimates (e.g., 500 years, 46 parts) are literal measures of spiritual realities, though their exact rationale may be hidden from non-prophetic intellects.\n- Sibawayh Rule: باب الحصر والتقييد بإنما (Restriction & Focused Predication) — The Quranic construction {للفقراء المهاجرين} uses prepositional fronting (taqdim) to restrict the praise to a specific class, and the sequence of descriptors (poverty before hijrah) establishes a hierarchy of virtues through syntactic ordering.", "content_type": "dhikr", "topic": "Al-Ghazali on constant remembrance of God and contemplative invocations, from 'Poverty and Abstinence'", "badge": "Dhikr"}], "274": [{"arabic": "يفزع الناس يوم القيامة ولا يفزعون وهم أولياء الله الذين لا خوف عليهم ولا هم يحزنون وفيه شهر بن حوشب مختلف فيه // ورواه أبو هريرة رضي الله عنه وقال فيه إن حول العرش منابر من نور عليها قوم لباسهم نور ووجوههم نورا ليسوا بأنبياء ولا شهداء يغبطهم النبيون والشهداء فقالوا يا رسول الله صفهم لنا فقال هم المتحابون في الله والمتجالسون في الله والمتزاورون في الله (1) وقال صلى الله عليه وسلم ما تحاب اثنان في الله إلا كان أحبهما إلى الله أشدهما حبا لصاحبه (2) ويقال إن الأخوين في الله إذا كان أحدهما أعلى مقاما من الآخر", "english": "Know that affability (al-ulfah) is the fruit of excellent character (ḥusn al-khuluq), and estrangement (al-tafarruq) is the fruit of evil character. For excellent character necessitates mutual love, harmony, and concord, whereas evil character yields mutual hatred, envy, and turning away (al-tadābur). And whenever the source is praiseworthy, the fruit is likewise praiseworthy. The excellence of good character is not hidden in the religion; indeed, it is that with which God—glorified be He—praised His Prophet, peace be upon him, when He said: {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ} «And indeed, you are upon an immense character» (Al-Qalam: 4). The Prophet, peace be upon him, said: \"The thing which most causes people to enter Paradise is God-consciousness (taqwā) and excellent character.\" (1) Usāmah ibn Sharīk said: \"We said, O Messenger of God, what is the best thing given to a person?\" He said: \"Excellent character.\" (2) He, peace be upon him, also said: \"I was sent only to perfect the noble traits of character.\" (3) He, peace be upon him, said: \"Nothing is heavier in the Balance than excellent character.\" (4) He, peace be upon him, said: \"God does not beautify a person's outward form and his inward character, then feed him to the Fire.\" (5) He, peace be upon him, said: \"O Abū Hurayrah, adhere to excellent character.\" (Page V02P157) Abū Hurayrah, may God be pleased with him, said: \"What is excellent character, O Messenger of God?\" He said: \"That you join the one who cuts you off, forgive the one who wrongs you, and give to the one who deprives you.\" (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 402", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 402: On the Excellence of Affability (Al-Ulfah) and Brotherhood in God", "section_index": 402, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of harmonizing, uniting, and reconciling; the removal of estrangement (al-waḥshah) and the establishment of concord.\n  * Al-Raghib (Mufradat): Theological nuance of ta'līf as the divine act of harmonizing hearts, a blessing bestowed by God alone, as in {لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَّا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) denotes physical joining; metaphorical (majāz) denotes the spiritual and moral concord of hearts, which is the fruit of excellent character (ḥusn al-khuluq).\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: Root meaning of measuring, proportioning, and smoothing; hence, the inherent disposition and moral character of a person.\n  * Al-Raghib (Mufradat): The origination of a thing upon a just measure; for character, it is the inward form (al-ṣūrah al-bāṭinah) of the soul, just as the physical form is its outward shape.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is the physical creation and proportioning; metaphorical (majāz) is the moral and spiritual constitution, praised by God in {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ}.\n- Root: بغض (Bughḍ)\n  * Lisan / Ayn: The opposite of love (ḥubb); intense aversion and hatred.\n  * Al-Raghib (Mufradat): In the Kalam context, al-bughḍ fī Allāh (hatred for God's sake) is a spiritual act of discernment and loyalty, not a mere emotional impulse; it is paired with al-ḥubb fī Allāh as the strongest bond of faith (awthaq ʿurā al-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is personal animosity; metaphorical (majāz) is the righteous aversion to disobedience and the enemies of God, which is a form of devotion.\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — Governing the syntactic flow of conditional and relative clauses, ensuring the periodic structure of the author's argument remains coherent and unbroken.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}], "275": [{"arabic": "وإن تبتم فلكم رءوس أموالكم {ثم قال} ومن عاد فأولئك أصحاب النار هم فيها خالدون جعل آكل الربا أول الأمر مؤذنا بمحاربة الله وفي آخره متعرضا للنار والآيات الواردة في الحلال والحرام لا تحصى وروى ابن مسعود رضي الله عنه عن النبي صلى الله عليه وسلم أنه قال طلب الحلال فريضة على كل مسلم ولما قال صلى الله عليه وسلم طلب العلم فريضة على كل مسلم (1) قال بعض العلماء أراد به طلب علم الحلال والحرام وجعل المراد بالحديثين واحدا وقال صلى الله عليه وسلم من سعى على عياله من حله فهو كالمجاهد في سبيل الله ومن طلب الدنيا حلالا في عفاف كان في", "english": "God Most High has said: {«كلوا من الطيبات واعملوا صالحا»} — \"Eat of the good things and do righteous deeds.\" (Q. 23:51) He commanded eating from the good things before [commanding] righteous deeds. And it is said that what is meant by \"the good things\" is the lawful (al-ḥalāl).", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 336", "section_title_en": "The Revival of the Religious Sciences — Book of the Etiquette of Eating: Section 336 — The Virtue of Lawful Sustenance and the Blameworthiness of the Forbidden", "section_index": 336, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core root meaning of eating, consuming, and tasting food; the act of taking nourishment into the body.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of food; used metaphorically for fire consuming wood, and extended to mean lawful provision (ḥalāl) as the sustenance of the soul's soundness.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical ingestion; metaphorical (majāz) for consuming wealth unlawfully, as in \"أكل مال اليتيم\" (devouring the orphan's wealth).\n- Root: طعم (tuʿm)\n  * Lisan / Ayn: Food, sustenance, and the act of tasting; also used for bait and that which is eaten.\n  * Al-Raghib (Mufradat): Sustenance as that which nourishes the body; in the Kalam context, the lawful (ḥalāl) is that which purifies the heart, while the forbidden (ḥarām) corrupts it.\n  * Al-Zamakhshari (Asas): Literal for food; metaphorical for the moral state of the soul — \"طعمه حرام\" (his food is forbidden) signifies the corruption of one's entire being.\n- Root: ورق (waraʿ)\n  * Lisan / Ayn: Abstinence, scrupulousness, and piety; refraining from doubtful matters.\n  * Al-Raghib (Mufradat): The theological virtue of cautious avoidance of all that is suspect, as the foundation of true worship and the key to answered supplication.\n  * Al-Zamakhshari (Asas): Literal for refraining; metaphorical for the heart's purity achieved through guarding the limbs from the unlawful.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure of conditional and consequential clauses, where the protasis (e.g., \"من أكل حراما\") governs the apodosis (\"لم يقبل منه صرف ولا عدل\"), demonstrating the causal nexus between action and divine recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'The Lawful and Prohibited'", "badge": "Hadith"}], "277": [{"arabic": "يفزع الناس يوم القيامة ولا يفزعون وهم أولياء الله الذين لا خوف عليهم ولا هم يحزنون وفيه شهر بن حوشب مختلف فيه // ورواه أبو هريرة رضي الله عنه وقال فيه إن حول العرش منابر من نور عليها قوم لباسهم نور ووجوههم نورا ليسوا بأنبياء ولا شهداء يغبطهم النبيون والشهداء فقالوا يا رسول الله صفهم لنا فقال هم المتحابون في الله والمتجالسون في الله والمتزاورون في الله (1) وقال صلى الله عليه وسلم ما تحاب اثنان في الله إلا كان أحبهما إلى الله أشدهما حبا لصاحبه (2) ويقال إن الأخوين في الله إذا كان أحدهما أعلى مقاما من الآخر", "english": "Know that affability (al-ulfah) is the fruit of excellent character (ḥusn al-khuluq), and estrangement (al-tafarruq) is the fruit of evil character. For excellent character necessitates mutual love, harmony, and concord, whereas evil character yields mutual hatred, envy, and turning away (al-tadābur). And whenever the source is praiseworthy, the fruit is likewise praiseworthy. The excellence of good character is not hidden in the religion; indeed, it is that with which God—glorified be He—praised His Prophet, peace be upon him, when He said: {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ} «And indeed, you are upon an immense character» (Al-Qalam: 4). The Prophet, peace be upon him, said: \"The thing which most causes people to enter Paradise is God-consciousness (taqwā) and excellent character.\" (1) Usāmah ibn Sharīk said: \"We said, O Messenger of God, what is the best thing given to a person?\" He said: \"Excellent character.\" (2) He, peace be upon him, also said: \"I was sent only to perfect the noble traits of character.\" (3) He, peace be upon him, said: \"Nothing is heavier in the Balance than excellent character.\" (4) He, peace be upon him, said: \"God does not beautify a person's outward form and his inward character, then feed him to the Fire.\" (5) He, peace be upon him, said: \"O Abū Hurayrah, adhere to excellent character.\" (Page V02P157) Abū Hurayrah, may God be pleased with him, said: \"What is excellent character, O Messenger of God?\" He said: \"That you join the one who cuts you off, forgive the one who wrongs you, and give to the one who deprives you.\" (1)", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 402", "section_title_en": "The Book of the Revival of the Religious Sciences — Section 402: On the Excellence of Affability (Al-Ulfah) and Brotherhood in God", "section_index": 402, "anchors": "- Root: ألف (Alifa)\n  * Lisan / Ayn: Core meaning of harmonizing, uniting, and reconciling; the removal of estrangement (al-waḥshah) and the establishment of concord.\n  * Al-Raghib (Mufradat): Theological nuance of ta'līf as the divine act of harmonizing hearts, a blessing bestowed by God alone, as in {لَوْ أَنفَقْتَ مَا فِي الْأَرْضِ جَمِيعًا مَّا أَلَّفْتَ بَيْنَ قُلُوبِهِمْ}.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) denotes physical joining; metaphorical (majāz) denotes the spiritual and moral concord of hearts, which is the fruit of excellent character (ḥusn al-khuluq).\n- Root: خلق (Khalaqa)\n  * Lisan / Ayn: Root meaning of measuring, proportioning, and smoothing; hence, the inherent disposition and moral character of a person.\n  * Al-Raghib (Mufradat): The origination of a thing upon a just measure; for character, it is the inward form (al-ṣūrah al-bāṭinah) of the soul, just as the physical form is its outward shape.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is the physical creation and proportioning; metaphorical (majāz) is the moral and spiritual constitution, praised by God in {وَإِنَّكَ لَعَلَىٰ خُلُقٍ عَظِيمٍ}.\n- Root: بغض (Bughḍ)\n  * Lisan / Ayn: The opposite of love (ḥubb); intense aversion and hatred.\n  * Al-Raghib (Mufradat): In the Kalam context, al-bughḍ fī Allāh (hatred for God's sake) is a spiritual act of discernment and loyalty, not a mere emotional impulse; it is paired with al-ḥubb fī Allāh as the strongest bond of faith (awthaq ʿurā al-īmān).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) is personal animosity; metaphorical (majāz) is the righteous aversion to disobedience and the enemies of God, which is a form of devotion.\n- Sibawayh Rule: Rule of Prepositional Interposition (Bāb al-Faṣl bayna al-Jār wa al-Majrūr) — Governing the syntactic flow of conditional and relative clauses, ensuring the periodic structure of the author's argument remains coherent and unbroken.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Duties of Brotherhood'", "badge": "Hadith"}], "278": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "وقال تعالى يا أيها الذين آمنوا اتقوا الله وذروا ما بقي من الربا إن كنتم مؤمنين {ثم قال} فإن لم تفعلوا فأذنوا بحرب من الله ورسوله {ثم قال} وإن تبتم فلكم رءوس أموالكم {ثم قال} ومن عاد فأولئك أصحاب النار هم فيها خالدون جعل آكل الربا أول الأمر مؤذنا بمحاربة الله وفي آخره متعرضا للنار والآيات الواردة في الحلال والحرام لا تحصى وروى ابن مسعود رضي الله عنه عن النبي صلى الله عليه وسلم أنه قال طلب الحلال فريضة على كل مسلم ولما قال صلى الله عليه وسلم طلب العلم فريضة على كل مسلم (1) قال بعض العلماء أراد به طلب علم الحلال والحرام وجعل المر", "english": "God Most High has said: {«كلوا من الطيبات واعملوا صالحا»} — \"Eat of the good things and do righteous deeds.\" (Q. 23:51) He commanded eating from the good things before [commanding] righteous deeds. And it is said that what is meant by \"the good things\" is the lawful (al-ḥalāl).", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 336", "section_title_en": "The Revival of the Religious Sciences — Book of the Etiquette of Eating: Section 336 — The Virtue of Lawful Sustenance and the Blameworthiness of the Forbidden", "section_index": 336, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core root meaning of eating, consuming, and tasting food; the act of taking nourishment into the body.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of food; used metaphorically for fire consuming wood, and extended to mean lawful provision (ḥalāl) as the sustenance of the soul's soundness.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical ingestion; metaphorical (majāz) for consuming wealth unlawfully, as in \"أكل مال اليتيم\" (devouring the orphan's wealth).\n- Root: طعم (tuʿm)\n  * Lisan / Ayn: Food, sustenance, and the act of tasting; also used for bait and that which is eaten.\n  * Al-Raghib (Mufradat): Sustenance as that which nourishes the body; in the Kalam context, the lawful (ḥalāl) is that which purifies the heart, while the forbidden (ḥarām) corrupts it.\n  * Al-Zamakhshari (Asas): Literal for food; metaphorical for the moral state of the soul — \"طعمه حرام\" (his food is forbidden) signifies the corruption of one's entire being.\n- Root: ورق (waraʿ)\n  * Lisan / Ayn: Abstinence, scrupulousness, and piety; refraining from doubtful matters.\n  * Al-Raghib (Mufradat): The theological virtue of cautious avoidance of all that is suspect, as the foundation of true worship and the key to answered supplication.\n  * Al-Zamakhshari (Asas): Literal for refraining; metaphorical for the heart's purity achieved through guarding the limbs from the unlawful.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure of conditional and consequential clauses, where the protasis (e.g., \"من أكل حراما\") governs the apodosis (\"لم يقبل منه صرف ولا عدل\"), demonstrating the causal nexus between action and divine recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'The Lawful and Prohibited'", "badge": "Hadith"}], "279": [{"arabic": "كنتم مؤمنين {ثم قال} فإن لم تفعلوا فأذنوا بحرب من الله ورسوله {ثم قال} وإن تبتم فلكم رءوس أموالكم {ثم قال} ومن عاد فأولئك أصحاب النار هم فيها خالدون جعل آكل الربا أول الأمر مؤذنا بمحاربة الله وفي آخره متعرضا للنار والآيات الواردة في الحلال والحرام لا تحصى وروى ابن مسعود رضي الله عنه عن النبي صلى الله عليه وسلم أنه قال طلب الحلال فريضة على كل مسلم ولما قال صلى الله عليه وسلم طلب العلم فريضة على كل مسلم (1) قال بعض العلماء أراد به طلب علم الحلال والحرام وجعل المراد بالحديثين واحدا وقال صلى الله عليه وسلم من", "english": "God Most High has said: {«كلوا من الطيبات واعملوا صالحا»} — \"Eat of the good things and do righteous deeds.\" (Q. 23:51) He commanded eating from the good things before [commanding] righteous deeds. And it is said that what is meant by \"the good things\" is the lawful (al-ḥalāl).", "book_title": "The Lawful and Prohibited", "section_title_ar": "Section 336", "section_title_en": "The Revival of the Religious Sciences — Book of the Etiquette of Eating: Section 336 — The Virtue of Lawful Sustenance and the Blameworthiness of the Forbidden", "section_index": 336, "anchors": "- Root: اكل (akl)\n  * Lisan / Ayn: Core root meaning of eating, consuming, and tasting food; the act of taking nourishment into the body.\n  * Al-Raghib (Mufradat): \"الأكل: تناول المطعم\" — eating is the taking of food; used metaphorically for fire consuming wood, and extended to mean lawful provision (ḥalāl) as the sustenance of the soul's soundness.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) for physical ingestion; metaphorical (majāz) for consuming wealth unlawfully, as in \"أكل مال اليتيم\" (devouring the orphan's wealth).\n- Root: طعم (tuʿm)\n  * Lisan / Ayn: Food, sustenance, and the act of tasting; also used for bait and that which is eaten.\n  * Al-Raghib (Mufradat): Sustenance as that which nourishes the body; in the Kalam context, the lawful (ḥalāl) is that which purifies the heart, while the forbidden (ḥarām) corrupts it.\n  * Al-Zamakhshari (Asas): Literal for food; metaphorical for the moral state of the soul — \"طعمه حرام\" (his food is forbidden) signifies the corruption of one's entire being.\n- Root: ورق (waraʿ)\n  * Lisan / Ayn: Abstinence, scrupulousness, and piety; refraining from doubtful matters.\n  * Al-Raghib (Mufradat): The theological virtue of cautious avoidance of all that is suspect, as the foundation of true worship and the key to answered supplication.\n  * Al-Zamakhshari (Asas): Literal for refraining; metaphorical for the heart's purity achieved through guarding the limbs from the unlawful.\n- Sibawayh Rule: باب الفصل بين الجار والمجرور (Prepositional Interposition) — The syntactic structure of conditional and consequential clauses, where the protasis (e.g., \"من أكل حراما\") governs the apodosis (\"لم يقبل منه صرف ولا عدل\"), demonstrating the causal nexus between action and divine recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'The Lawful and Prohibited'", "badge": "Hadith"}], "281": [{"arabic": "وقال تعالى {ثم توفى كل نفس ما كسبت وهم لا يظلمون} وقال تعالى {يوم تجد كل نفس ما عملت من خير محضرا وما عملت من سوء تود لو أن بينها وبينه أمدا بعيدا ويحذركم الله نفسه} وقال تعالى {واعلموا أن الله يعلم ما في أنفسكم فاحذروه} فعرف أرباب البصائر من جملة العباد أن الله تعالى لهم بالمرصاد وأنهم سيناقشون في الحساب ويطالبون بمثاقيل الذر من الخطرات واللحظات وتحققوا أنه لا ينجيهم من هذه الأخطار إلا لزوم المحاسبة وصدق المراقبة ومطالبة النفس في الأنفاس والحركات ومحاسبتها في الخطرات والل", "english": "To proceed: God Most High has said: {And We shall set up the scales of justice for the Day of Resurrection, so no soul shall be wronged in anything; and if it be the weight of a grain of mustard seed, We shall bring it forth, and sufficient are We as Reckoners} (21:47). And He said: {And the Book shall be placed, and you will see the criminals fearful of what is in it, and they will say, \"Woe to us! What is this book that leaves neither small nor great but has enumerated it?\" And they will find what they did present, and your Lord wrongs no one} (18:49). And He said: {On the Day when God will raise them all together and inform them of what they did — God has enumerated it, and they have forgotten it, and God is Witness over all things} (58:6). And He said: {On that Day, people will issue forth in scattered groups to be shown their deeds. So whoever does an atom's weight of good will see it, and whoever does an atom's weight of evil will see it} (99:6-8). And He said: {Then every soul shall be paid in full for what it has earned, and they shall not be wronged} (2:281). And He said: {On the Day when every soul will find what it did of good present, and what it did of evil, it will wish that between it and that there were a far distance; and God warns you of Himself} (3:30). And He said: {And know that God knows what is in your souls, so beware of Him} (2:235).", "book_title": "Monitoring and Accounting", "section_title_ar": "Section 1230", "section_title_en": "Exposition of the Reality of Truthfulness (Al-Sidq), Its Meaning, and Its Grades — Book of Vigilance and Self-Reckoning, Being the Eighth Book of the Quarter of Deliverance from the Revival of the Religious Sciences", "section_index": 1230, "anchors": "- Root: رقب (Raqaba)\n  * Lisan / Ayn: To watch, guard, observe; a watcher (raqīb) is one who stands vigilant over something, awaiting its occurrence.\n  * Al-Raghib (Mufradat): Raqaba denotes protective watchfulness; al-raqīb is a divine attribute signifying His perpetual oversight of all that transpires, with no moment of neglect.\n  * Al-Zamakhshari (Asas): Literal (haqīqah): physical watching/awaiting. Metaphorical (majāz): \"This matter is upon your necks (fī riqābikum)\" — i.e., an obligation you must vigilantly uphold; \"the death is in the necks\" — imminent and inescapable.\n- Root: حسب (Hasaba)\n  * Lisan / Ayn: To count, reckon, compute; al-ḥisāb is the act of enumeration and settlement of accounts.\n  * Al-Raghib (Mufradat): Al-ḥisāb is the employment of number; divine reckoning (ḥisāb) on the Day of Resurrection is the exacting appraisal of deeds, even to the atom's weight.\n  * Al-Zamakhshari (Asas): Literal: counting wealth or deeds. Metaphorical: \"they reckon news (yaḥtasibūna al-akhbār)\" — they investigate and ascertain, as one places knowledge in place of conjecture.\n- Root: قلب (Qalaba)\n  * Lisan / Ayn: To turn, overturn, transform; the heart (qalb) is so named for its constant fluctuation and turning of states.\n  * Al-Raghib (Mufradat): Qalaba is the turning of a thing from one state to another; the heart's inner thoughts (khaṭarāt) are its successive movements, which God surveys.\n  * Al-Zamakhshari (Asas): Literal: turning a garment or object. Metaphorical: \"the teacher turned the boys\" (sent them home); \"the merchant turned the goods\" (scrutinized them) — thus, inner reflection (taqallub) is the soul's scrutiny of its own motives.\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The particle innamā restricts the predicate to the subject alone, as in \"إنما يحاسبهم لتعلم كل نفس\" — the sole purpose of reckoning is specified, excluding all other ends.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Monitoring and Accounting'", "badge": "Insight"}, {"arabic": "توفي كل نفس ما كسبت {وأن} كل نفس بما كسبت رهينة فما الذي غركم بالله بعد أن سمعتم وعقلتم قالوا لو كنا نسمع أو نعقل ما كنا في أصحاب السعير فاعترفوا بذنبهم فسحقا لأصحاب السعير فإن قلت فأين مظنة الرجاء وموضعه المحمود فاعلم أنه محمود في موضعين أحدهما في حق العاصي المنهمك إذا خطرت له التوبة فقال له الشيطان وأنى تقبل توبتك فيقنطه من رحمة الله تعالى فيجب عند هذا أن يقمع القنوط بالرجاء ويتذكر أن الله يغفر الذنوب جميعا وأن الله كريم يقبل التوبة عن عباده وأن التوبة طاعة تكفر الذنو", "english": "Every soul shall taste what it has earned. And {«وَأَنَّ كُلَّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ»} — \"And that every soul is a pledge for what it has earned.\" So what has deluded you concerning God, after you have heard and comprehended? They will say: \"Had we but listened or reasoned, we would not be among the companions of the Blaze.\" Thus they will confess their sin. So away with the companions of the Blaze!", "book_title": "Condemnation of Delusion", "section_title_ar": "Section 890", "section_title_en": "The Anatomy of Hope (Rajā') and Delusion (Ghurūr): A Kalamic Dissection of the Soul's Two States", "section_index": 890, "anchors": "- Root: نفس (Nafs)\n  * Lisan / Ayn: The self, soul, or spirit; that which desires proximity and discourse; the locus of breath and life.\n  * Al-Raghib (Mufradat): Nafs denotes the rūḥ (spirit) and, in divine attribution, the very Dhāt (Essence) of God—as in {«وَيُحَذِّرُكُمُ اللَّهُ نَفْسَهُ»}—entailing no real multiplicity despite grammatical annexation.\n  * Al-Zamakhshari (Asas): Literal (Haqiqah) usage refers to the living, breathing self; metaphorical (Majaz) usage extends to \"blood\" (nafs sā'ilah) and the \"evil eye\" (nafs as 'ayn). Here, it signifies the moral agent bearing responsibility.\n- Root: توب (Tawb)\n  * Lisan / Ayn: Return, repentance; the act of turning back from error.\n  * Al-Raghib (Mufradat): Tawbah is abandoning the sin in the most excellent manner—the third and highest form of excuse (after denial and pretext). In Sacred Law: forsaking the sin due to its ugliness, remorse for the past, resolve against recurrence, and restitution of what can be restored.\n  * Al-Zamakhshari (Asas): Literal: \"The servant repents to God from his sin; God turns in mercy to the servant.\" The reciprocal dynamic—God's acceptance (tawbah) meeting the servant's return (inābah)—is operative in this text.\n- Root: ذنب (Dhanb)\n  * Lisan / Ayn: The tail of an animal; what trails behind; by extension, a fault or crime as the \"consequence\" one drags after oneself.\n  * Al-Raghib (Mufradat): In origin, \"taking hold of a thing's tail\"—i.e., seizing the outcome. Sin is that which trails the soul and binds it as a pledge (rahīnah).\n  * Al-Zamakhshari (Asas): Metaphorical: \"He is among the tails (adhnāb) of the people\"—the laggards. The sinner is one who follows his lower tail, and the verse {«كُلُّ نَفْسٍ بِمَا كَسَبَتْ رَهِينَةٌ»} makes the soul a hostage to its own trailing deeds.\n- Root: غفر (Ghafr)\n  * Lisan / Ayn: To cover, shield, or protect; the Ghifār tribe's name; a helmet (mighfar) that shields the head.\n  * Al-Raghib (Mufradat): Ghufrān from God is His shielding the servant from the touch of chastisement—a protective covering, not mere erasure. It may also mean outward forbearance.\n  * Al-Zamakhshari (Asas): Literal: \"O God, forgive (ghufrānan)!\"—a covering over the stain. Metaphorical: Zuhayr's beasts \"did not forgive\" their negligence—i.e., did not shield the offspring from destruction. Hope of forgiveness without repentance is thus not ghufrān but ghurūr (delusion).\n- Sibawayh Rule: باب الفصل بين العامل والمعمول (Interposition between Operator and Operand) — The periodic structure of verses like {«إِنَّ اللَّهَ يَغْفِرُ الذُّنُوبَ جَمِيعًا»} delays the predicate to heighten rhetorical impact; the conditional \"if you say... know that\" (fa-in qulta... fa-'lam) governs the entire dialectical sequence, requiring the apodosis to resolve the protasis with logical necessity.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Condemnation of Delusion'", "badge": "Insight"}], "282": [{"arabic": "وقد قال الله تعالى يا أيها الذين آمنوا أنفقوا من طيبات ما كسبتم ومما أخرجنا لكم من الأرض ولا تيمموا الخبيث منه تنفقون ولستم بآخذيه إلا أن تغمضوا فيه أي لا تأخذوه إلا مع كراهية وحياء وهو معنى الإغماض فلا تؤثروا به ربكم وفي الخبر سبق درهم مائة ألف درهم (3) وذلك بأن يخرجه الإنسان وهو من أحل ماله وأجوده فيصدر ذلك عن الرضا والفرح بالبذل وقد يخرج مائة ألف درهم مما يكره من ماله فيدل ذلك على أنه ليس يؤثر الله عز وجل بشيء مما يحبه وبذلك ذم الله تعالى قوما جعلوا لله ما يكرهون فقال تعال", "english": "The heart is not treated save with the compound electuary (maʿjūn) of knowledge and works. And this condition among the conditions of almsgiving runs in the same course as humility (al-khushūʿ) runs in the prayer. This is established by his saying — may Allah bless him and grant him peace: \"A man has nothing of his prayer save that of which he was conscious.\" And this is like his saying — may Allah bless him and grant him peace: \"Allah does not accept the charity of the one who bestows it with reproach (al-mannān).\" And like His saying — Exalted is He: {«لا تبطلوا صدقاتكم بالمن والأذى»} (\"Do not nullify your charities by reproach and injury\"). As for the legal opinion (fatwā) of the jurist that the alms fall in their proper place and that one's liability is discharged without this condition — that is another discussion, and we have already pointed to its meaning in the Book of Prayer.", "book_title": "Duties of Brotherhood", "section_title_ar": "Section 175", "section_title_en": "The Inner Conditions of Charity — Section 175 (From The Revival of the Religious Sciences, Book of the Mysteries of Almsgiving)", "section_index": 175, "anchors": "- Root: قلب (q-l-b)\n  * Lisan / Ayn: \"To turn, overturn, transform a thing from one state to another; to rotate, to flip\"\n  * Al-Raghib (Mufradat): \"قلب الشيء: تصريفه وصرفه عن وجه إلى وجه\" — the heart is so named because of its constant turning and transformation between states\n  * Al-Zamakhshari (Asas): Literal: \"قلب الشيء قلبا: حوله عن وجهه\" (to turn a thing from its face). Metaphorical: \"رجل قلب حول: يقلب الأمور ويحتال\" — one who turns matters over and manages them; \"قلبوا لك الأمور\" (they turned matters against you)\n- Root: وجل (w-j-l)\n  * Lisan / Ayn: \"Fear, dread, apprehension that strikes the heart\"\n  * Al-Raghib (Mufradat): \"الوجل: استشعار الخوف\" — the sensing of fear; cited in {«إنما المؤمنون الذين إذا ذكر الله وجلت قلوبهم»}\n  * Al-Zamakhshari (Asas): Literal: \"رجل وجل، وقوم وجال\" — a fearful man, a fearful people; \"وفي قلبه وجل\" — in his heart is dread\n- Root: عجب (ʿ-j-b)\n  * Lisan / Ayn: \"Wonder, amazement; self-admiration, vanity\"\n  * Al-Raghib (Mufradat): Self-admiration (al-ʿujb) is a destructive spiritual ailment that nullifies deeds\n  * Al-Zamakhshari (Asas): Literal: wonder at something extraordinary. Metaphorical: self-conceit regarding one's own acts of obedience\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Focused Predication) — governing the precise limitation of general categories (al-ṣifāt al-khāṣṣah within al-aṣnāf al-thamāniyyah) and the conditional structure of acceptance\n\n---\n\n##", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Duties of Brotherhood'", "badge": "Insight"}, {"arabic": "إلى ما أنهاكم عنه وقال تعالى واتقوا الله ويعلمكم الله وقال تعالى واتقوا الله واعلموا واتقوا الله واسمعوا وقال تعالى لعيسى عليه السلام يا ابن مريم عظ نفسك فإن اتعظت فعظ الناس وإلا فاستحي مني وقال رسول الله صلى الله عليه وسلم مررت ليلة أسري بي بأقوام تقرض شفاههم بمقاريض من نار فقلت من أنتم فقالوا كنا نأمر بالخير ولا نأتيه وننهى عن الشر ونأتيه (2) وقال صلى الله عليه وسلم هلاك أمتي عالم فاجر وعابد جاهل وشر الشرار شرار العلماء وخير الخيار خيار العلماء (3) وقال الأوزاعي رحمه الله شكت النواويس ما تجد من نتن جي", "english": "[Root: ملح]\n  • Lisan al-Arab: \"الملح: ما يصلح الطعام، وجمعه ملوح وأملاح. والمليح: الحسن. والملاحة: الحسن. وملح الرجل يملح ملاحة: حسن. وتملح: تزين.\"\n  • Al-Raghib (Al-Mufradat): \"الملح: ما يحفظ الطعام ويمنع فساده، ويستعار لما يحفظ الإيمان والعلم من الفساد.\"\n  • Al-Zamakhshari (Asas): \"ملح الماء: إذا كان فيه ملوحة. وملح الطعام: جعل فيه الملح. وهذا على الحقيقة، ويستعار الملح لما يصلح به الأمر.\"\n  • Kitab al-Ayn: \"الملح: معروف، والمليح: الحسن من كل شيء.\"", "book_title": "Book of Knowledge", "section_title_ar": "Section 52", "section_title_en": "Section 52", "section_index": 52, "anchors": "*(Anchors established)*", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Book of Knowledge'", "badge": "Insight"}], "283": [{"arabic": "عمل الفؤاد كعمل السمع والبصر فلا يعفى عنه وقوله تعالى {ولا تكتموا الشهادة ومن يكتمها فإنه آثم قلبه} وقوله تعالى {لا يؤاخذكم الله باللغو في أيمانكم ولكن يؤاخذكم بما كسبت قلوبكم} والحق عندنا في هذه المسألة لا يوقف عليه ما لم تقع الإحاطة بتفصيل أعمال القلوب من مبدأ ظهورها إلى أن يظهر العمل على الجوارح فنقول أول ما يرد على القلب الخاطر كما لو خطر له مثلا صورة امرأة وأنها وراء ظهره في الطريق لو التفت إليها لرآها والثاني هيجان الرغبة إلى النظر وهو حركة الشهوة في الطبع وهذا يتولد من الخاطر الأول ونسميه ميل الطبع ويسمى الأول حديث النفس والثالث حكم ا", "english": "Know that this is a subtle matter, and there have come down concerning it verses and reports that are mutually conflicting, such that the way of reconciling between them becomes obscure — save for the master-brokers of the scholars of the Sacred Law. For it has been related from the Prophet — peace and blessings be upon him — that he said: \"God has pardoned my community for what their souls whisper to them, so long as they do not speak of it or act upon it.\" (1) And Abū Hurayrah said: The Messenger of God — peace and blessings be upon him — said: \"God — exalted is He — says to the guardian angels: When My servant intends a sin, do not write it against him; but if he commits it, then write it as one sin. And when he intends a good deed and does not perform it, write it for him as one good deed; but if he performs it, write it for him as ten.\" (2) This has been recorded by al-Bukhārī and Muslim in the two Ṣaḥīḥs, and it is evidence for the pardon of the heart's act and its intending of a sin. And in another wording: \"Whoever intends a good deed and does not perform it, it is written for him as a good deed; and whoever intends a good deed and performs it, it is written for him as up to seven hundred multiples. And whoever intends a sin and does not perform it, it is not written against him; but if he performs it, it is written.\" And in yet another wording: \"When My servant speaks within himself of committing a sin, I forgive him for it so long as he does not commit it.\" And all of this indicates the pardon.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 606", "section_title_en": "The Heart's Whisperings and the Divine Pardon — On the Four Stages of Inner Acts", "section_index": 606, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or inner being; that which breathes and harbors concealed thoughts.\n  * Al-Raghib (Mufradat): Al-nafs denotes the soul or self (al-rūḥ), and in divine address, \"what your souls whisper\" (mā ḥaddathat bihi nufūsuhā) refers to the inner promptings that arise without deliberate volition.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage pertains to the soul's essence; metaphorical (majāz) usage extends to inner speech and inclination, as in \"ḥadīth al-nafs\" (self-talk), which is not yet resolved action.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: To originate or bring forth something new; an event or occurrence that comes to be after non-existence.\n  * Al-Raghib (Mufradat): Al-ḥudūth is the coming-to-be of a thing after it was not; \"ḥadīth al-nafs\" is the newly arising thought that occurs to the heart without prior acquisition.\n  * Al-Zamakhshari (Asas): Literal: a recent matter or speech; metaphorical: the inner utterance of the soul, as in the prophetic report, \"God has pardoned my community for what their souls whisper to them.\"\n- Root: هم (h-m-m)\n  * Lisan / Ayn: To intend, resolve, or purpose; the stirring of the will toward an act before its execution.\n  * Al-Raghib (Mufradat): Al-hamm is the resolved intention (al-ʿazm) that precedes the deed; it is distinguished from mere inclination (mayl) and passing thought (khāṭir).\n  * Al-Zamakhshari (Asas): Literal: the soul's determination; metaphorical: the initial resolve that, when strengthened, becomes a firm will (irādah jazīmah).\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; to turn or overturn, signifying its fluctuating nature between states.\n  * Al-Raghib (Mufradat): The heart is the seat of cognition and volition; its \"acts\" (aʿmāl al-qulūb) include thought, belief, and resolve, which are subject to divine reckoning.\n  * Al-Zamakhshari (Asas): Literal: the physical organ; metaphorical: the spiritual faculty that perceives, believes, and intends, as in \"the heart's sin\" (ithm al-qalb).\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The prophetic and Quranic statements employ restriction to delineate the boundary between what is pardoned (the passing thought) and what is reckoned (the resolved intention), requiring precise parsing of the conditional clauses (law, idhā, man) to distinguish the stages of inner acts.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "كما قال تعالى في الشهادة {ومن يكتمها فإنه آثم قلبه} وقال صلى الله عليه وسلم ما آتى الله عالما علما إلا وأخذ عليه من الميثاق ما أخذ على النبيين أن يبينوه للناس ولا يكتموه (6) وقال تعالى {ومن أحسن قولا ممن دعا إلى الله وعمل صالحا} وقال تعالى {ادع إلى سبيل ربك بالحكمة والموعظة الحسنة} وقال تعالى {ويعلمهم الكتاب والحكمة} وأما الأخبار فقوله صلى الله عليه وسلم لما بعث معاذا رضي الله عنه إلى اليمن لأن يهدي الله بك رجلا واحدا خير لك من الدنيا وما فيها // حديث قال لمعاذ حين بعثه إلى اليمن لأن يهدي", "english": "As for the Qur'anic verses: His saying, Mighty and Majestic is He: {وَلِيُنذِرُوا قَوْمَهُمْ إِذَا رَجَعُوا إِلَيْهِمْ لَعَلَّهُمْ يَحْذَرُونَ} \"That they may warn their people when they return to them, that perhaps they may be cautious\" {«ولينذروا قومهم إذا رجعوا إليهم لعلهم يحذرون»} — and the intended meaning is teaching and guidance (al-taʿlīm wa-al-irshād).", "book_title": "Book of Knowledge", "section_title_ar": "Section 8", "section_title_en": "The Excellence of Teaching (Faḍīlat al-Taʿlīm)", "section_index": 8, "anchors": "- Root: علم (ʿalima)\n  * Lisan / Ayn: Core meaning is \"to know, to perceive a thing by its reality\"; the root also carries the sense of \"marker, sign, banner\" — that by which something is distinguished and recognized.\n  * Al-Raghib (Mufradat): \"العلم: إدراك الشيء بحقيقته\" — knowledge is the apprehension of a thing by its true reality, divided into apprehension of the essence of a thing and judgment upon it. This is the attribute by which the scholar (ʿālim) is distinguished and by which he becomes a \"sign\" (ʿalam) pointing to truth.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"هو من أعلام العلم الخافقه\" — the scholar is among the lofty banners of knowledge. The teaching act makes the scholar a living signpost; the root's literal sense of \"marking\" or \"branding\" a thing carries into the metaphorical (majāz) register of \"imprinting\" knowledge upon hearts.\n- Root: حدث (ḥadatha)\n  * Lisan / Ayn: Core meaning is \"to be new, to occur after not having been\"; al-ḥadīth is speech that is new and conveyed.\n  * Al-Raghib (Mufradat): \"الحدوث: كون الشيء بعد أن لم يكن\" — origination after non-existence. The prophetic traditions (aḥādīth) cited here are \"newly conveyed\" reports that carry authority.\n  * Al-Zamakhshari (Asas): Metaphorical (majāz): \"صاروا أحاديث\" — they became subjects of discourse. The transmission of knowledge is an \"event\" (ḥadath) that occurs in the listener, renewing his state.\n- Root: عهد (ʿahida)\n  * Lisan / Ayn: Core meaning is \"covenant, pact, charge\"; al-ʿahd is a binding commission that one is obligated to fulfill.\n  * Al-Raghib (Mufradat): The covenant (mīthāq) taken from the People of the Book and from the scholars is a divine charge (taklīf) that makes teaching an obligation, not a supererogatory act.\n  * Al-Zamakhshari (Asas): Literal: the covenant is a \"charge entrusted\" (waṣiyyah) that binds the one who receives knowledge to its dissemination.\n- Root: كتم (katama)\n  * Lisan / Ayn: Core meaning is \"to conceal, to hide\"; al-kitmān is the deliberate suppression of what ought to be revealed.\n  * Al-Raghib (Mufradat): Concealment of knowledge is paired with concealment of testimony (shahādah) in the Qur'an — both are sins of the heart (ithm al-qalb) because they withhold what God has commanded to be made manifest.\n  * Al-Zamakhshari (Asas): Literal vs. metaphorical: the \"bridle of fire\" (lijām min nār) on the Day of Judgment is a metaphorical (majāz) embodiment of the inner restraint of truth — the concealed knowledge becomes a physical restraint in the afterlife.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction & Specification) — The verse {وإن فريقا منهم ليكتمون الحق وهم يعلمون} employs the restrictive particle \"inna\" with the continuous verb form (yaktimūn) to specify an ongoing, willful concealment, distinguishing it from mere ignorance. The conditional structures in the ḥadīth \"man taʿallama... man ʿallama... man katama\" (whoever learns... whoever teaches... whoever conceals) follow the canonical pattern of protasis-apodosis (sharṭ/jazāʾ) that establishes a universal causal linkage between the act and its recompense.", "content_type": "hadith", "topic": "Prophetic traditions and scholastic commentary by Al-Ghazali, from 'Book of Knowledge'", "badge": "Hadith"}], "284": [{"arabic": "فأما ما يدل على المؤاخذة فقوله سبحانه إن تبدوا ما في أنفسكم أو تخفوه يحاسبكم به الله فيغفر لمن يشاء ويعذب من يشاء وقوله تعالى {ولا تقف ما ليس لك به علم إن السمع والبصر والفؤاد كل أولئك كان عنه مسؤولا} فدل على أن عمل الفؤاد كعمل السمع والبصر فلا يعفى عنه وقوله تعالى {ولا تكتموا الشهادة ومن يكتمها فإنه آثم قلبه} وقوله تعالى {لا يؤاخذكم الله باللغو في أيمانكم ولكن يؤاخذكم بما كسبت قلوبكم} والحق عندنا في هذه المسألة لا يوقف عليه ما لم تقع الإحاطة بتفصيل أعمال القلوب من مبدأ ظهورها إلى أن يظهر العمل على الجوارح فنقول أول ما يرد على القلب الخاطر كما لو خطر له مثلا صو", "english": "Know that this is a subtle matter, and there have come down concerning it verses and reports that are mutually conflicting, such that the way of reconciling between them becomes obscure — save for the master-brokers of the scholars of the Sacred Law. For it has been related from the Prophet — peace and blessings be upon him — that he said: \"God has pardoned my community for what their souls whisper to them, so long as they do not speak of it or act upon it.\" (1) And Abū Hurayrah said: The Messenger of God — peace and blessings be upon him — said: \"God — exalted is He — says to the guardian angels: When My servant intends a sin, do not write it against him; but if he commits it, then write it as one sin. And when he intends a good deed and does not perform it, write it for him as one good deed; but if he performs it, write it for him as ten.\" (2) This has been recorded by al-Bukhārī and Muslim in the two Ṣaḥīḥs, and it is evidence for the pardon of the heart's act and its intending of a sin. And in another wording: \"Whoever intends a good deed and does not perform it, it is written for him as a good deed; and whoever intends a good deed and performs it, it is written for him as up to seven hundred multiples. And whoever intends a sin and does not perform it, it is not written against him; but if he performs it, it is written.\" And in yet another wording: \"When My servant speaks within himself of committing a sin, I forgive him for it so long as he does not commit it.\" And all of this indicates the pardon.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 606", "section_title_en": "The Heart's Whisperings and the Divine Pardon — On the Four Stages of Inner Acts", "section_index": 606, "anchors": "- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, soul, or inner being; that which breathes and harbors concealed thoughts.\n  * Al-Raghib (Mufradat): Al-nafs denotes the soul or self (al-rūḥ), and in divine address, \"what your souls whisper\" (mā ḥaddathat bihi nufūsuhā) refers to the inner promptings that arise without deliberate volition.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) usage pertains to the soul's essence; metaphorical (majāz) usage extends to inner speech and inclination, as in \"ḥadīth al-nafs\" (self-talk), which is not yet resolved action.\n- Root: حدث (ḥ-d-th)\n  * Lisan / Ayn: To originate or bring forth something new; an event or occurrence that comes to be after non-existence.\n  * Al-Raghib (Mufradat): Al-ḥudūth is the coming-to-be of a thing after it was not; \"ḥadīth al-nafs\" is the newly arising thought that occurs to the heart without prior acquisition.\n  * Al-Zamakhshari (Asas): Literal: a recent matter or speech; metaphorical: the inner utterance of the soul, as in the prophetic report, \"God has pardoned my community for what their souls whisper to them.\"\n- Root: هم (h-m-m)\n  * Lisan / Ayn: To intend, resolve, or purpose; the stirring of the will toward an act before its execution.\n  * Al-Raghib (Mufradat): Al-hamm is the resolved intention (al-ʿazm) that precedes the deed; it is distinguished from mere inclination (mayl) and passing thought (khāṭir).\n  * Al-Zamakhshari (Asas): Literal: the soul's determination; metaphorical: the initial resolve that, when strengthened, becomes a firm will (irādah jazīmah).\n- Root: قلب (q-l-b)\n  * Lisan / Ayn: The heart; to turn or overturn, signifying its fluctuating nature between states.\n  * Al-Raghib (Mufradat): The heart is the seat of cognition and volition; its \"acts\" (aʿmāl al-qulūb) include thought, belief, and resolve, which are subject to divine reckoning.\n  * Al-Zamakhshari (Asas): Literal: the physical organ; metaphorical: the spiritual faculty that perceives, believes, and intends, as in \"the heart's sin\" (ithm al-qalb).\n- Sibawayh Rule: Restriction and Focused Predication (al-ḥaṣr wa al-taqyīd bi-innamā) — The prophetic and Quranic statements employ restriction to delineate the boundary between what is pardoned (the passing thought) and what is reckoned (the resolved intention), requiring precise parsing of the conditional clauses (law, idhā, man) to distinguish the stages of inner acts.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "تعالى {وإن تبدوا ما في أنفسكم أو تخفوه يحاسبكم به الله} جاء ناس من الصحابة إلى رسول الله صلى الله عليه وسلم فقالوا كلفنا ما لا نطيق الحديث أخرجه مسلم من حديث أبي هريرة وابن عباس نحوه فأنزل الله الفرج بعد سنة بقوله {لا يكلف الله نفسا إلا وسعها} فظهر به أن كل ما لا يدخل تحت الوسع من أعمال القلب هو الذي لا يؤاخذ به فهذا هو كشف الغطاء عن هذا الالتباس وكل من يظن أن كل ما يجري على القلب يسمى حديث النفس ولم يفرق بين هذه الأقسام الثلاثة فلا بد وأن يغلط وكيف لا يؤاخذ بأعمال القلب من الكبر والعجب والرياء و", "english": "The proof that the mere thought and the initial inclination are not held against the servant is that which is firmly established from the Messenger of God — peace be upon him — that he said: \"God has pardoned my community for what their souls whisper to them, so long as they do not speak of it or act upon it.\" And he said — peace be upon him: \"When two Muslims meet with their swords, then the killer and the killed are both in the Fire.\" It was said: \"O Messenger of God, this is the killer — but what of the killed?\" He said: \"Because he intended to kill his companion.\" {«التقى المسلمان بسيفيهما فالقاتل والمقتول في النار»} — and his being held accountable was solely for his intention (niyyah) and his resolution, not for the mere thought that crossed his heart, for the thought of killing is not within one's capacity to prevent, while the resolution to kill is.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 607", "section_title_en": "Exposition of What the Servant is Held Accountable For from the Whispers of the Hearts, Their Anxieties, Their Thoughts, and Their Intentions — and What is Pardoned and Not Held Against Him", "section_index": 607, "anchors": "- Root: وسوس (w-s-w-s)\n  * Lisan / Ayn: The faint, concealed sound; the subtle, indistinct voice that inclines one toward something\n  * Al-Raghib (Mufradat): The insinuation that enters the heart covertly, whether from Satan or from the self's inclination\n  * Al-Zamakhshari (Asas): Literal — the faint jingling of an ornament; Metaphorical — the secret prompting that stirs within the breast\n- Root: خطر (kh-t-r)\n  * Lisan / Ayn: To come to mind; the passing of a thought across the heart without deliberate pursuit\n  * Al-Raghib (Mufradat): The sudden occurrence of a notion in the mind, whether invited or uninvited\n  * Al-Zamakhshari (Asas): Literal — something that presents itself; Metaphorical — the fleeting thought that crosses the heart like a passing traveler\n- Root: هم (h-m-m)\n  * Lisan / Ayn: The intention that inclines one toward an act before resolution is firmly settled\n  * Al-Raghib (Mufradat): The initial stirring of the will toward an action, preceding the firm resolve ('azm)\n  * Al-Zamakhshari (Asas): Literal — to intend; Metaphorical — the heart's leaning that, if unchecked, hardens into determination\n- Root: قصد (q-s-d)\n  * Lisan / Ayn: The deliberate aiming toward a goal; the firm resolution that governs the limbs\n  * Al-Raghib (Mufradat): The settled intention that directs action and for which one is justly held accountable\n  * Al-Zamakhshari (Asas): Literal — to walk a straight path to a destination; Metaphorical — the will's firm orientation that constitutes the essence of moral agency\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (The Interposition Between Subject and Predicate) — governing the periodic structure of conditional accountability clauses where the protasis (condition) and apodosis (result) are separated by explanatory parentheticals, preserving the logical dependency of moral judgment upon the specification of the act's nature.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}], "285": [{"arabic": "رسول الله هذه زلة منك وهل الإيمان إلا أن تؤمن بالله وملائكته وكتبه ورسله والبعث والميزان وتقيم الصلاة والصوم والزكاة ولنا ذنوب لو نعلم أنها تغفر لنا لعلمنا أننا من أهل الجنة فمن أجل ذلك نقول إنا مؤمنون ولا نقول إنا من أهل الجنة فقال ابن مسعود صدقت والله إنها مني زلة فينبغي أن يقال كان خوضهم فيه قليلا لا كثيرا وقصيرا لا طويلا وعند الحاجة لا بطريق التصنيف والتدريس واتخاذه صناعة فيقال أما قلة خوضهم فيه فإنه كان لقلة الحاجة إذا لم تكن البدعة تظهر في ذلك الزمان وأما القصر فقد كان الغاية إفحام الخصم واعترافه وانكشاف الحق", "english": "The mention of the proof (ḥujjah), the demand for it, and the search after it — how could these be prohibited, when God — may He be exalted — has said: {«قُلْ هَاتُوا بُرْهَانَكُمْ»} (Say: Bring forth your proof — Qur'an 2:111), and He — mighty and majestic — has said: {«لِيَهْلِكَ مَنْ هَلَكَ عَنْ بَيِّنَةٍ وَيَحْيَا مَنْ حَيَّ عَنْ بَيِّنَةٍ»} (So that he who perishes may perish upon clear evidence, and he who lives may live upon clear evidence — Qur'an 8:42), and He — may He be exalted — has said: {«هَلْ عِنْدَكُمْ مِنْ سُلْطَانٍ بِهَذَا»} (Have you any authority for this? — Qur'an 10:68), meaning a proof and demonstration, and He — may He be exalted — has said: {«قُلْ فَلِلَّهِ الْحُجَّةُ الْبَالِغَةُ»} (Say: To God belongs the conclusive proof — Qur'an 6:149), and He — may He be exalted — has said: {«أَلَمْ تَرَ إِلَى الَّذِي حَاجَّ إِبْرَاهِيمَ فِي رَبِّهِ»} (Have you not considered him who disputed with Abraham concerning his Lord? — Qur'an 2:258) up to His words: {«فَبُهِتَ الَّذِي كَفَرَ»} (So the one who disbelieved was confounded — Qur'an 2:258).", "book_title": "Foundations of Belief", "section_title_ar": "Section 77", "section_title_en": "The Revival of the Religious Sciences — Section 77: On the Permissibility of Theological Discourse (Kalām) and Its Early Practice", "section_index": 77, "anchors": "- Root: ح-د-ث (ḥ-d-th)\n  * Lisan / Ayn: \"Al-ḥudūth: the coming-to-be of a thing after it was not; al-ḥadath: the novel event; al-ḥīdāth: origination.\"\n  * Al-Raghib (Mufradat): \"Al-ḥudūth: a thing's becoming after it was not, whether accident or substance; iḥdāth: bringing it into existence. The origination of substances belongs to God alone.\"\n  * Al-Zamakhshari (Asas): \"Literal: 'He is a recent event among events.' Metaphorical: 'They became topics of conversation (aḥādīth).'\"\n- Root: ح-ا-ج (ḥ-ā-j)\n  * Lisan / Ayn: \"Al-ḥājah: need of a thing, with desire for it; its plural: ḥājāt and ḥawā'ij.\"\n  * Al-Raghib (Mufradat): \"Al-ḥājah ilā al-shay': poverty toward it with love of it. God said: {«إِلَّا حَاجَةً فِي نَفْسِ يَعْقُوبَ»} (except a need in Jacob's soul — Qur'an 12:68).\"\n  * Al-Zamakhshari (Asas): \"Literal: need and want. The 'ḥājah' is that which one seeks to obtain.\"\n- Root: ك-و-ن (k-w-n)\n  * Lisan / Ayn: \"Kāna: to be, to exist; takwīn: bringing into being from non-existence.\"\n  * Al-Raghib (Mufradat): \"Al-kawn: existence after non-existence; the muḥdath (originated thing) is that brought forth after it was not.\"\n  * Al-Zamakhshari (Asas): \"Literal: being and becoming. Metaphorical: the continuous states of affairs.\"\n- Sibawayh Rule: Al-Faṣl bayna al-Jār wa-al-Majrūr (Prepositional Interposition) — The permissibility of separating a preposition from its object when the intervening clause is complete in meaning, as in the verse's structure of argumentation where the proof (ḥujjah) stands independently before its conclusion.", "content_type": "afterlife", "topic": "Al-Ghazali on the journey of the soul, death, and the Hereafter, from 'Foundations of Belief'", "badge": "Afterlife"}], "286": [{"arabic": "قوله عز وجل إنك لا تخلف الميعاد ربنا لا تؤاخذنا إن نسينا أو أخطأنا ربنا إلى آخر السورة (3) رب اغفر لي ولوالدي وارحمهما كما ربياني صغيرا واغفر للمؤمنين والمؤمنات والمسلمين والمسلمات الأحياء منهم والأموات (4) رب اغفر وارحم وتجاوز عما تعلم وأنت الأعز الأكرم وأنت خير الراحمين وأنت خير الغافرين وإنا لله وإنا إليه راجعون ولا حول ولا قوة إلا بالله العلي العظيم وحسبنا الله ونعم الوكيل وصلى الله على محمد خاتم النبيين وآله وصحبه وسلم تسليما كثيرا (5)", "english": "And employ me in righteous deeds which You will accept from me. (1) O God, I ask You for pardon, well-being, good certainty, and soundness in this world and the next. (2) O You Whom sins do not harm and from Whom forgiveness does not diminish anything — grant me that which will not harm You, and give me that which will not diminish You. Our Lord, pour upon us patience and cause us to die as Muslims. You are our Protector in this world and the next; cause me to die as a Muslim and join me with the righteous. You are our Protector, so forgive us and have mercy upon us, and You are the Best of forgivers. And write for us good in this world and in the Hereafter — indeed, we have turned to You in repentance. Our Lord, upon You we rely, to You we turn in repentance, and to You is the final return. Our Lord, make us not a trial for the wrongdoing people. Our Lord, make us not a trial for those who disbelieve, and forgive us, our Lord — indeed, You are the Mighty, the Wise. Our Lord, forgive us our sins and our excesses in our affairs, make firm our feet, and grant us victory over the disbelieving people. Our Lord, forgive us and our brothers who preceded us in faith, and place not in our hearts any rancor toward those who believe — our Lord, indeed You are Kind, Merciful. Our Lord, grant us from Yourself mercy and prepare for us from our affair right guidance. Our Lord, give us good in this world and good in the Hereafter, and protect us from the chastisement of the Fire. Our Lord, indeed we have heard a caller calling to faith — to His saying, Mighty and Majestic: {«إنك لا تخلف الميعاد»} [آل عمران/ 194] — Our Lord, do not take us to task if we forget or err. Our Lord, to the end of the surah. (3) My Lord, forgive me and my parents, and have mercy upon them as they raised me when I was small; and forgive the believing men and the believing women, and the Muslim men and the Muslim women, the living among them and the dead. (4) My Lord, forgive, have mercy, and overlook what You know — and You are the Most Exalted, the Most Generous, the Best of the merciful, and the Best of the forgivers. And indeed, to God we belong and to Him we return; and there is no might and no power except through God, the Exalted, the Magnificent; and God suffices us, and He is the Best Disposer of affairs. And may God send blessings upon Muhammad, the Seal of the Prophets, and upon his family and his companions, and grant them abundant peace. (5)", "book_title": "On Invocations and Supplications", "section_title_ar": "Section 252", "section_title_en": "Section 252 — Supplications for Morning and Evening: Comprehensive Prayers of the Prophet (ﷺ)", "section_index": 252, "anchors": "- Root: لهم (l-h-m)\n  * Lisan / Ayn: Core meaning of swallowing/ingesting (iltihām); from this derives the sense of something being cast directly into the innermost recess of the heart (al-rawʿ).\n  * Al-Raghib (Mufradat): \"الإلهام: إلقاء الشيء في الروع\" — ilhām is the casting of a thing into the innermost consciousness, specifically from God or the higher assembly (al-malaʾ al-aʿlā). It is that which the Prophet (ﷺ) called \"the touch of the angel\" (limat al-malak) and \"the breath of the Holy Spirit in my innermost heart\" (nafth rūḥ al-qudus fī rawʿī).\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah): \"ألهمه الله الخير: ألقاه في روعه\" — God inspired him with good: He cast it into his innermost consciousness. Metaphorical (majāz): A horse that \"swallows the ground\" (yaltaḥimu al-arḍ) in swiftness; thus ilhām is the swift, direct ingress of divine guidance into the soul without intermediary effort.\n- Root: حمد (ḥ-m-d)\n  * Lisan / Ayn: The root denotes praise arising from recognition of voluntary excellence and beneficence; al-ḥamd is commendation of the beloved for their attributes and acts of goodness.\n  * Al-Raghib (Mufradat): Praise (ḥamd) is the acknowledgment of beneficence (niʿmah) with reverence and love; it is distinguished from mere thanks (shukr) in that it is directed to the essence and attributes of the praised one, not solely to the benefit received.\n  * Al-Zamakhshari (Asas): Literal: \"أحمد الله تعالى بجميع محامده\" — I praise God with all His praiseworthy attributes. Metaphorical: \"أحمدت صنيعه\" — I found his deed praiseworthy; thus the tongue's praise must be matched by the heart's recognition of the praised one's perfection.\n- Root: غفر (gh-f-r)\n  * Lisan / Ayn: The root denotes covering and shielding; al-mighfar is the helmet that protects the head in battle.\n  * Al-Raghib (Mufradat): \"الغفر: إلباس ما يصونه عن الدنس\" — Forgiveness is the clothing of that which shields from filth. God's forgiveness (maghfirah) is His shielding of the servant from the touch of chastisement, covering the sin so that it is as though it never were.\n  * Al-Zamakhshari (Asas): Literal: \"اللهم غفرًا\" — O God, forgive. Metaphorical: The she-beasts that \"did not forgive\" their heedlessness (lam taghfir la-hā ghaflātuhā) — i.e., they did not shield their young from destruction; thus forgiveness is active protection, not mere erasure.\n- Root: نفس (n-f-s)\n  * Lisan / Ayn: The self, the soul; that which breathes and has vital spirit; also used for the very essence of a thing.\n  * Al-Raghib (Mufradat): \"النفس: الروح\" — the soul is the spirit; and in God's saying {«ويحذركم الله نفسه»} [آل عمران/ 28], \"His Self\" means His very essence (dhāt), which — though grammatically expressed as an annexation implying distinction — is in reality identical, with no multiplicity in the Divine Essence.\n  * Al-Zamakhshari (Asas): Literal: \"شيء نفيس\" — a precious thing. Metaphorical: \"دفق نفسه\" — he poured out his blood/life; thus nafs is the seat of life, passion, and moral responsibility.\n- Sibawayh Rule: باب الدعاء والخبر (The Chapter of Supplication and Assertion) — Supplications (duʿāʾ) are grammatically constructed as optative sentences (inshāʾ ṭalabī) using the imperative (rabbighfir), the jussive (lā tuʾākhidhnā), and the vocative (rabbanā), yet they may embed assertive clauses (khabar) of praise (al-ḥamdu lillāh) and attestation (lā ilāha illā anta). The periodic structure of these prayers alternates between direct address to God (munādāh) and self-referential confession, requiring the translator to preserve the vocative force of \"O God\" and \"Our Lord\" without flattening into mere description.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'On Invocations and Supplications'", "badge": "Du'a"}, {"arabic": "بقوله {لا يكلف الله نفسا إلا وسعها} فظهر به أن كل ما لا يدخل تحت الوسع من أعمال القلب هو الذي لا يؤاخذ به فهذا هو كشف الغطاء عن هذا الالتباس وكل من يظن أن كل ما يجري على القلب يسمى حديث النفس ولم يفرق بين هذه الأقسام الثلاثة فلا بد وأن يغلط وكيف لا يؤاخذ بأعمال القلب من الكبر والعجب والرياء والنفاق والحسد وجملة الخبائث من أعمال القلب بل السمع والبصر والفؤاد كل أولئك كان عنه مسئولا أي ما يدخل تحت الاختيار فلو وقع البصر بغير اختيار على غير ذي محرم لم يؤاخذ به فإن أتبعها نظرة ث", "english": "The proof that the mere thought and the initial inclination are not held against the servant is that which is firmly established from the Messenger of God — peace be upon him — that he said: \"God has pardoned my community for what their souls whisper to them, so long as they do not speak of it or act upon it.\" And he said — peace be upon him: \"When two Muslims meet with their swords, then the killer and the killed are both in the Fire.\" It was said: \"O Messenger of God, this is the killer — but what of the killed?\" He said: \"Because he intended to kill his companion.\" {«التقى المسلمان بسيفيهما فالقاتل والمقتول في النار»} — and his being held accountable was solely for his intention (niyyah) and his resolution, not for the mere thought that crossed his heart, for the thought of killing is not within one's capacity to prevent, while the resolution to kill is.", "book_title": "Disciplining the Soul", "section_title_ar": "Section 607", "section_title_en": "Exposition of What the Servant is Held Accountable For from the Whispers of the Hearts, Their Anxieties, Their Thoughts, and Their Intentions — and What is Pardoned and Not Held Against Him", "section_index": 607, "anchors": "- Root: وسوس (w-s-w-s)\n  * Lisan / Ayn: The faint, concealed sound; the subtle, indistinct voice that inclines one toward something\n  * Al-Raghib (Mufradat): The insinuation that enters the heart covertly, whether from Satan or from the self's inclination\n  * Al-Zamakhshari (Asas): Literal — the faint jingling of an ornament; Metaphorical — the secret prompting that stirs within the breast\n- Root: خطر (kh-t-r)\n  * Lisan / Ayn: To come to mind; the passing of a thought across the heart without deliberate pursuit\n  * Al-Raghib (Mufradat): The sudden occurrence of a notion in the mind, whether invited or uninvited\n  * Al-Zamakhshari (Asas): Literal — something that presents itself; Metaphorical — the fleeting thought that crosses the heart like a passing traveler\n- Root: هم (h-m-m)\n  * Lisan / Ayn: The intention that inclines one toward an act before resolution is firmly settled\n  * Al-Raghib (Mufradat): The initial stirring of the will toward an action, preceding the firm resolve ('azm)\n  * Al-Zamakhshari (Asas): Literal — to intend; Metaphorical — the heart's leaning that, if unchecked, hardens into determination\n- Root: قصد (q-s-d)\n  * Lisan / Ayn: The deliberate aiming toward a goal; the firm resolution that governs the limbs\n  * Al-Raghib (Mufradat): The settled intention that directs action and for which one is justly held accountable\n  * Al-Zamakhshari (Asas): Literal — to walk a straight path to a destination; Metaphorical — the will's firm orientation that constitutes the essence of moral agency\n- Sibawayh Rule: باب الفصل بين المبتدأ والخبر (The Interposition Between Subject and Predicate) — governing the periodic structure of conditional accountability clauses where the protasis (condition) and apodosis (result) are separated by explanatory parentheticals, preserving the logical dependency of moral judgment upon the specification of the act's nature.", "content_type": "spiritual", "topic": "Al-Ghazali's epistemic insights into the spiritual heart and inner faith, from 'Disciplining the Soul'", "badge": "Insight"}, {"arabic": "خلافا للمعتزلة ولو لم يجز ذلك لاستحال سؤال دفعه وقد سألوا ذلك فقالوا ربنا ولا تحملنا ما لا طاقة لنا به ولأن الله تعالى أخبر نبيه صلى الله عليه وسلم بأن أبا جهل لا يصدقه ثم أمره بأن يأمره بأن يصدقه في جميع أقواله وكان من جملة أقواله أنه لا يصدقه فكيف يصدقه في أنه لا يصدقه وهل هذا إلا محال وجوده الأصل السادس أن لله عز وجل إيلام الخلق وتعذيبهم من غير جرم سابق ومن غير ثواب لاحق خلافا للمعتزلة لأنه متصرف في ملكه ولا يتصور أن يعدو تصرفه ملكه والظلم هو عبارة عن التصرف في ملك الغير بغير إذنه وهو محال على الله تعالى فإنه لا يصادف لغيره ملكا حتى يكون تصرف", "english": "**The Fifth Principle**: It is permissible for God—glorified be He—to charge His creatures with what they cannot bear (mā lā yuṭīqūnahu), contrary to the Muʿtazilites. For were that not permissible, then the petition to avert it would be impossible—yet they have petitioned it, saying: {«Rabbanā wa lā tuḥammilnā mā lā ṭāqata lanā bih»} \"Our Lord, do not burden us with what we have no capacity for\" {Q. 2:286}. And because God—exalted be He—informed His Prophet (peace be upon him) that Abū Jahl would not believe him, then commanded him to command Abū Jahl to believe him in all his statements. Now among Abū Jahl's statements was that he would not believe him—so how could he believe him in [the statement] that he would not believe him? Is this anything other than the impossible in its very existence?", "book_title": "Foundations of Belief", "section_title_ar": "Section 94", "section_title_en": "The Fifth and Sixth Principles: On the Impossibility of Obligation Upon God and the Permissibility of What Reason Deems Impossible", "section_index": 94, "anchors": "- Root: وجب (w-j-b)\n  * Lisan / Ayn: Core meaning of \"being established, fixed, and necessary\"; al-Kitab al-Ayn notes its application to ritual obligations (wujūb al-iḥrām).\n  * Al-Raghib (Mufradat): \"Al-wujūb is thubūt (establishment). The wājib is said in two senses: (1) in contrast to the possible—that whose non-existence entails a contradiction; (2) that whose omission merits blame—either by reason (as knowing God's unity) or by revelation (as ritual duties).\"\n  * Al-Zamakhshari (Asas): Literal: \"Wajaba lī ʿalayhi kadhā\" (such is incumbent upon him); \"awjabahu ʿalā nafsihi\" (he made it incumbent upon himself). Metaphorical: \"huwa ya'kulu al-wajbah\" (he eats but once a day)—the root shifts from legal necessity to a single, fixed act.\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Sovereignty and possession; al-Kitab al-Ayn distinguishes mālik (owner) from malik (king), both deriving from absolute discretionary disposal.\n  * Al-Raghib (Mufradat): \"Al-mulk: one who disposes by command and prohibition over a community—this pertains to governance of rational beings. Ownership (milk) is of two kinds: possession itself, and the power to dispose.\"\n  * Al-Zamakhshari (Asas): Literal: \"Malaktu al-shay'\" (I possessed the thing). Metaphorical: \"Malaktu nafsī ʿinda al-ghaḍab\" (I mastered myself at anger)—dominion over one's own domain.\n- Sibawayh Rule: Interposition of the conditional clause (al-sharṭ) between subject and predicate—governing the logical structure of \"if X were permissible, then Y would follow,\" where the protasis restricts the apodosis.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Foundations of Belief'", "badge": "Du'a"}, {"arabic": "ربنا ولا تحملنا ما لا طاقة لنا به ولأن الله تعالى أخبر نبيه صلى الله عليه وسلم بأن أبا جهل لا يصدقه ثم أمره بأن يأمره بأن يصدقه في جميع أقواله وكان من جملة أقواله أنه لا يصدقه فكيف يصدقه في أنه لا يصدقه وهل هذا إلا محال وجوده الأصل السادس أن لله عز وجل إيلام الخلق وتعذيبهم من غير جرم سابق ومن غير ثواب لاحق خلافا للمعتزلة لأنه متصرف في ملكه ولا يتصور أن يعدو تصرفه ملكه والظلم هو عبارة عن التصرف في ملك الغير بغير إذنه وهو محال على الله تعالى فإنه لا يصادف لغيره ملكا حتى يكون تصرفه", "english": "**The Fifth Principle**: It is permissible for God—glorified be He—to charge His creatures with what they cannot bear (mā lā yuṭīqūnahu), contrary to the Muʿtazilites. For were that not permissible, then the petition to avert it would be impossible—yet they have petitioned it, saying: {«Rabbanā wa lā tuḥammilnā mā lā ṭāqata lanā bih»} \"Our Lord, do not burden us with what we have no capacity for\" {Q. 2:286}. And because God—exalted be He—informed His Prophet (peace be upon him) that Abū Jahl would not believe him, then commanded him to command Abū Jahl to believe him in all his statements. Now among Abū Jahl's statements was that he would not believe him—so how could he believe him in [the statement] that he would not believe him? Is this anything other than the impossible in its very existence?", "book_title": "Etiquette of Marriage", "section_title_ar": "Section 94", "section_title_en": "The Fifth and Sixth Principles: On the Impossibility of Obligation Upon God and the Permissibility of What Reason Deems Impossible", "section_index": 94, "anchors": "- Root: وجب (w-j-b)\n  * Lisan / Ayn: Core meaning of \"being established, fixed, and necessary\"; al-Kitab al-Ayn notes its application to ritual obligations (wujūb al-iḥrām).\n  * Al-Raghib (Mufradat): \"Al-wujūb is thubūt (establishment). The wājib is said in two senses: (1) in contrast to the possible—that whose non-existence entails a contradiction; (2) that whose omission merits blame—either by reason (as knowing God's unity) or by revelation (as ritual duties).\"\n  * Al-Zamakhshari (Asas): Literal: \"Wajaba lī ʿalayhi kadhā\" (such is incumbent upon him); \"awjabahu ʿalā nafsihi\" (he made it incumbent upon himself). Metaphorical: \"huwa ya'kulu al-wajbah\" (he eats but once a day)—the root shifts from legal necessity to a single, fixed act.\n- Root: ملك (m-l-k)\n  * Lisan / Ayn: Sovereignty and possession; al-Kitab al-Ayn distinguishes mālik (owner) from malik (king), both deriving from absolute discretionary disposal.\n  * Al-Raghib (Mufradat): \"Al-mulk: one who disposes by command and prohibition over a community—this pertains to governance of rational beings. Ownership (milk) is of two kinds: possession itself, and the power to dispose.\"\n  * Al-Zamakhshari (Asas): Literal: \"Malaktu al-shay'\" (I possessed the thing). Metaphorical: \"Malaktu nafsī ʿinda al-ghaḍab\" (I mastered myself at anger)—dominion over one's own domain.\n- Sibawayh Rule: Interposition of the conditional clause (al-sharṭ) between subject and predicate—governing the logical structure of \"if X were permissible, then Y would follow,\" where the protasis restricts the apodosis.", "content_type": "dua", "topic": "Al-Ghazali on supplications, prayers, and their spiritual power, from 'Etiquette of Marriage'", "badge": "Du'a"}, {"arabic": "الله تعالى للمؤمنين في قولهم {ولا تحمل علينا إصرا} وقال تعالى {ويضع عنهم إصرهم والأغلال التي كانت عليهم} وروى محمد بن الحنفية عن علي رضي الله تعالى عنهما أنه قال لما نزل قوله تعالى {فاصفح الصفح الجميل} قال يا جبريل وما الصفح الجميل قال عليه السلام إذا عفوت عمن ظلمك فلا تعاتبه فقال يا جبريل فالله تعالى أكرم من أن يعاتب من عفا عنه فبكى جبريل وبكى النبي صلى الله عليه وسلم فبعث الله تعالى إليهما ميكائيل عليه السلام وقال إن ربكما يقرئكما السلام ويقول كيف أعاتب من عفوت عنه", "english": "In the report (khabar): \"Were you not to sin, God would create a creation who would sin, and He would forgive them.\" (1) In another wording: \"He would take you away and bring a creation who would sin, and He would forgive them — verily, He is the Forgiving, the Merciful.\" And in the report: \"Were you not to sin, I would fear for you what is worse than sins.\" It was said: \"And what is that?\" He said: \"Self-amazement (al-ʿujb).\" (2)", "book_title": "Fear and Hope", "section_title_ar": "Section 1034", "section_title_en": "The Completion of the Matter — On the Preacher's Gentleness in Employing Reports of Fear and Hope", "section_index": 1034, "anchors": "- Root: لطف (luṭf)\n  * Lisan / Ayn: Gentleness, subtlety, kindness in approach; to be gracious and delicate in manner.\n  * Al-Raghib (Mufradat): Divine gentleness (luṭf) as an attribute of God's subtle providence; here, the preacher's emulation of prophetic gentleness in spiritual counsel.\n  * Al-Zamakhshari (Asas): Literal (ḥaqīqah) — physical softness; metaphorical (majāz) — refinement of speech and manner suited to the spiritual state of the listener.\n- Root: رجا (rajā')\n  * Lisan / Ayn: Hope, expectation of good; the opposite of despair (ya's).\n  * Al-Raghib (Mufradat): Hope in God's mercy as a theological virtue balancing fear (khawf); the state of the believer who relies on divine generosity over personal merit.\n  * Al-Zamakhshari (Asas): Literal — anticipation of a future good; metaphorical — the soul's reliance on God's pardon despite sin.\n- Root: عجب (ʿajab)\n  * Lisan / Ayn: Self-amazement, vanity, wonder at oneself.\n  * Al-Raghib (Mufradat): Spiritual pride (ʿujb) — a hidden sin worse than overt transgression, as it nullifies deeds.\n  * Al-Zamakhshari (Asas): Literal — astonishment; metaphorical — the heart's complacency in its own obedience, leading to ruin.\n- Sibawayh Rule: باب الحصر والتقييد (Restriction and Specification) — The conditional and exceptive structures (law lā... la-khalaqa, illā an yataghammadani) govern the precise scope of divine mercy and human agency.", "content_type": "ethics", "topic": "Al-Ghazali on purifying the character, moral diseases, and spiritual remedies, from 'Fear and Hope'", "badge": "Ethics"}]}, "wordTiming": {"abdulbasit": {"1": [[1, 350, 7316]], "2": [[1, 400, 1275], [2, 1275, 2416], [3, 2416, 3021], [4, 3021, 3836], [5, 3836, 4627], [6, 4627, 5418], [7, 5418, 7560]], "3": [[1, 400, 1467], [2, 1467, 2846], [3, 2846, 3961], [4, 3961, 5699], [5, 5699, 7168], [6, 7168, 8405], [7, 8405, 9727], [8, 9