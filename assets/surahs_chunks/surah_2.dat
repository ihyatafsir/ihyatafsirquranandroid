d": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱشْتَرَوُا۟", "translit": "۟āُwَrَtْhsٱ", "root": "شري"}, {"id": 4, "arabic": "ٱلْحَيَوٰةَ", "translit": "َẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "بِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِb", "root": "اخر"}, {"id": 7, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 8, "arabic": "يُخَفَّفُ", "translit": "ُfَّfَhkُy", "root": "خفف"}, {"id": 9, "arabic": "عَنْهُمُ", "translit": "ُmُhْnَʿع", "root": ""}, {"id": 10, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 13, "arabic": "يُنصَرُونَ", "translit": "َnwُrَṣnُy", "root": "نصر"}], "hasIhya": true}, {"ayah": 87, "text": "وَلَقَدْ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ وَقَفَّيْنَا مِنۢ بَعْدِهِۦ بِٱلرُّسُلِۖ وَءَاتَيْنَا عِيسَى ٱبْنَ مَرْيَمَ ٱلْبَيِّنَٰتِ وَأَيَّدْنَٰهُ بِرُوحِ ٱلْقُدُسِۗ أَفَكُلَّمَا جَآءَكُمْ رَسُولٌۢ بِمَا لَا تَهْوَىٰٓ أَنفُسُكُمُ ٱسْتَكْبَرْتُمْ فَفَرِيقًا كَذَّبْتُمْ وَفَرِيقًا تَقْتُلُونَ ", "translation": "And We did certainly give Moses the Scripture [i.e., the Torah] and followed up after him with messengers. And We gave Jesus, the son of Mary, clear proofs and supported him with the Pure Spirit [i.e., the angel Gabriel]. But is it [not] that every time a messenger came to you, [O Children of Israel], with what your souls did not desire, you were arrogant? And a party [of messengers] you denied and another party you killed.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "وَقَفَّيْنَا", "translit": "āَnْyَّfَqَw", "root": "قفو"}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "بِٱلرُّسُلِ", "translit": "ِlُsُّrlٱِb", "root": "رسل"}, {"id": 9, "arabic": "وَءَاتَيْنَا", "translit": "āَnْyَtāَءَw", "root": "اتي"}, {"id": 10, "arabic": "عِيسَى", "translit": "àَsyِʿع", "root": ""}, {"id": 11, "arabic": "ٱبْنَ", "translit": "َnْbٱ", "root": "بني"}, {"id": 12, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 13, "arabic": "ٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱ", "root": "بين"}, {"id": 14, "arabic": "وَأَيَّدْنَٰهُ", "translit": "ُhَٰnْdَّyَaʾَw", "root": "ايد"}, {"id": 15, "arabic": "بِرُوحِ", "translit": "ِḥwُrِb", "root": "روح"}, {"id": 16, "arabic": "ٱلْقُدُسِ", "translit": "ِsُdُqْlٱ", "root": "قدس"}, {"id": 17, "arabic": "أَفَكُلَّمَا", "translit": "āَmَّlُkَfَaʾ", "root": "كلل"}, {"id": 18, "arabic": "جَآءَكُمْ", "translit": "ْmُkَءٓāَjg", "root": "جيا"}, {"id": 19, "arabic": "رَسُولٌۢ", "translit": "ٌۢlwُsَr", "root": "رسل"}, {"id": 20, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "تَهْوَىٰٓ", "translit": "ٰٓàَwْhَt", "root": "هوي"}, {"id": 23, "arabic": "أَنفُسُكُمُ", "translit": "ُmُkُsُfnَaʾ", "root": "نفس"}, {"id": 24, "arabic": "ٱسْتَكْبَرْتُمْ", "translit": "ْmُtْrَbْkَtْsٱ", "root": "كبر"}, {"id": 25, "arabic": "فَفَرِيقًا", "translit": "āًqyِrَfَf", "root": "فرق"}, {"id": 26, "arabic": "كَذَّبْتُمْ", "translit": "ْmُtْbَّhdَk", "root": "كذب"}, {"id": 27, "arabic": "وَفَرِيقًا", "translit": "āًqyِrَfَw", "root": "فرق"}, {"id": 28, "arabic": "تَقْتُلُونَ", "translit": "َnwُlُtْqَt", "root": "قتل"}], "hasIhya": false}, {"ayah": 88, "text": "وَقَالُوا۟ قُلُوبُنَا غُلْفٌۢۚ بَل لَّعَنَهُمُ ٱللَّهُ بِكُفْرِهِمْ فَقَلِيلًا مَّا يُؤْمِنُونَ ", "translation": "And they said, \"Our hearts are wrapped.\"[1] But, [in fact], Allāh has cursed them for their disbelief, so little is it that they believe.", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "قُلُوبُنَا", "translit": "āَnُbwُlُq", "root": "قلب"}, {"id": 3, "arabic": "غُلْفٌۢ", "translit": "ٌۢfْlُغ", "root": "غلف"}, {"id": 4, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 5, "arabic": "لَّعَنَهُمُ", "translit": "ُmُhَnَʿعَّl", "root": "لعن"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "بِكُفْرِهِمْ", "translit": "ْmِhِrْfُkِb", "root": "كفر"}, {"id": 8, "arabic": "فَقَلِيلًا", "translit": "āًlyِlَqَf", "root": "قلل"}, {"id": 9, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 10, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 89, "text": "وَلَمَّا جَآءَهُمْ كِتَٰبٌ مِّنْ عِندِ ٱللَّهِ مُصَدِّقٌ لِّمَا مَعَهُمْ وَكَانُوا۟ مِن قَبْلُ يَسْتَفْتِحُونَ عَلَى ٱلَّذِينَ كَفَرُوا۟ فَلَمَّا جَآءَهُم مَّا عَرَفُوا۟ كَفَرُوا۟ بِهِۦۚ فَلَعْنَةُ ٱللَّهِ عَلَى ٱلْكَٰفِرِينَ ", "translation": "And when there came to them a Book [i.e., the Qur’ān] from Allāh confirming that which was with them - although before they used to pray for victory against those who disbelieved - but [then] when there came to them that which they recognized, they disbelieved in it; so the curse of Allāh will be upon the disbelievers.", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "كِتَٰبٌ", "translit": "ٌbَٰtِk", "root": "كتب"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مُصَدِّقٌ", "translit": "ٌqِّdَṣُm", "root": "صدق"}, {"id": 8, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 9, "arabic": "مَعَهُمْ", "translit": "ْmُhَʿعَm", "root": ""}, {"id": 10, "arabic": "وَكَانُوا۟", "translit": "۟āwُnāَkَw", "root": "كون"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 13, "arabic": "يَسْتَفْتِحُونَ", "translit": "َnwُḥِtْfَtْsَy", "root": "فتح"}, {"id": 14, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 15, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 17, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 18, "arabic": "جَآءَهُم", "translit": "mُhَءٓāَjg", "root": "جيا"}, {"id": 19, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 20, "arabic": "عَرَفُوا۟", "translit": "۟āwُfَrَʿع", "root": "عرف"}, {"id": 21, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 22, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 23, "arabic": "فَلَعْنَةُ", "translit": "ُẗَnْʿعَlَf", "root": "لعن"}, {"id": 24, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 26, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 90, "text": "بِئْسَمَا ٱشْتَرَوْا۟ بِهِۦٓ أَنفُسَهُمْ أَن يَكْفُرُوا۟ بِمَآ أَنزَلَ ٱللَّهُ بَغْيًا أَن يُنَزِّلَ ٱللَّهُ مِن فَضْلِهِۦ عَلَىٰ مَن يَشَآءُ مِنْ عِبَادِهِۦۖ فَبَآءُو بِغَضَبٍ عَلَىٰ غَضَبٍۚ وَلِلْكَٰفِرِينَ عَذَابٌ مُّهِينٌ ", "translation": "How wretched is that for which they sold themselves - that they would disbelieve in what Allāh has revealed through [their] outrage that Allāh would send down His favor upon whom He wills from among His servants. So they returned having [earned] wrath upon wrath. And for the disbelievers is a humiliating punishment.", "words": [{"id": 1, "arabic": "بِئْسَمَا", "translit": "āَmَsْyʾِb", "root": "باس"}, {"id": 2, "arabic": "ٱشْتَرَوْا۟", "translit": "۟āْwَrَtْhsٱ", "root": "شري"}, {"id": 3, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 4, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يَكْفُرُوا۟", "translit": "۟āwُrُfْkَy", "root": "كفر"}, {"id": 7, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 8, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 9, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "بَغْيًا", "translit": "āًyْغَb", "root": "بغي"}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "يُنَزِّلَ", "translit": "َlِّzَnُy", "root": "نزل"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "فَضْلِهِۦ", "translit": "ۦِhِlْḍَf", "root": "فضل"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 18, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 19, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 20, "arabic": "عِبَادِهِۦ", "translit": "ۦِhِdāَbِʿع", "root": "عبد"}, {"id": 21, "arabic": "فَبَآءُو", "translit": "wُءٓāَbَf", "root": "بوا"}, {"id": 22, "arabic": "بِغَضَبٍ", "translit": "ٍbَḍَغِb", "root": "غضب"}, {"id": 23, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 24, "arabic": "غَضَبٍ", "translit": "ٍbَḍَغ", "root": "غضب"}, {"id": 25, "arabic": "وَلِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِlَw", "root": "كفر"}, {"id": 26, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 27, "arabic": "مُّهِينٌ", "translit": "ٌnyِhُّm", "root": "هون"}], "hasIhya": true}, {"ayah": 91, "text": "وَإِذَا قِيلَ لَهُمْ ءَامِنُوا۟ بِمَآ أَنزَلَ ٱللَّهُ قَالُوا۟ نُؤْمِنُ بِمَآ أُنزِلَ عَلَيْنَا وَيَكْفُرُونَ بِمَا وَرَآءَهُۥ وَهُوَ ٱلْحَقُّ مُصَدِّقًا لِّمَا مَعَهُمْۗ قُلْ فَلِمَ تَقْتُلُونَ أَنۢبِيَآءَ ٱللَّهِ مِن قَبْلُ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "And when it is said to them, \"Believe in what Allāh has revealed,\" they say, \"We believe [only] in what was revealed to us.\" And they disbelieve in what came after it, while it is the truth confirming that which is with them. Say, \"Then why did you kill the prophets of Allāh before, if you are [indeed] believers?\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "ءَامِنُوا۟", "translit": "۟āwُnِmāَء", "root": "امن"}, {"id": 5, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 6, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 9, "arabic": "نُؤْمِنُ", "translit": "ُnِmْwʾُn", "root": "امن"}, {"id": 10, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 11, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 12, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 13, "arabic": "وَيَكْفُرُونَ", "translit": "َnwُrُfْkَyَw", "root": "كفر"}, {"id": 14, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 15, "arabic": "وَرَآءَهُۥ", "translit": "ۥُhَءٓāَrَw", "root": "وري"}, {"id": 16, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 17, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 18, "arabic": "مُصَدِّقًا", "translit": "āًqِّdَṣُm", "root": "صدق"}, {"id": 19, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 20, "arabic": "مَعَهُمْ", "translit": "ْmُhَʿعَm", "root": ""}, {"id": 21, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 22, "arabic": "فَلِمَ", "translit": "َmِlَf", "root": ""}, {"id": 23, "arabic": "تَقْتُلُونَ", "translit": "َnwُlُtْqَt", "root": "قتل"}, {"id": 24, "arabic": "أَنۢبِيَآءَ", "translit": "َءٓāَyِbۢnَaʾ", "root": "نبا"}, {"id": 25, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 27, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 28, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 29, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 30, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": false}, {"ayah": 92, "text": "وَلَقَدْ جَآءَكُم مُّوسَىٰ بِٱلْبَيِّنَٰتِ ثُمَّ ٱتَّخَذْتُمُ ٱلْعِجْلَ مِنۢ بَعْدِهِۦ وَأَنتُمْ ظَٰلِمُونَ ", "translation": "And Moses had certainly brought you clear proofs. Then you took the calf [in worship] after that, while you were wrongdoers.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَكُم", "translit": "mُkَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "مُّوسَىٰ", "translit": "ٰàَswُّm", "root": ""}, {"id": 4, "arabic": "بِٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱِb", "root": "بين"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "ٱتَّخَذْتُمُ", "translit": "ُmُtْhdَhkَّtٱ", "root": "اخذ"}, {"id": 7, "arabic": "ٱلْعِجْلَ", "translit": "َlْjgِʿعْlٱ", "root": "عجل"}, {"id": 8, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 9, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 11, "arabic": "ظَٰلِمُونَ", "translit": "َnwُmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 93, "text": "وَإِذْ أَخَذْنَا مِيثَٰقَكُمْ وَرَفَعْنَا فَوْقَكُمُ ٱلطُّورَ خُذُوا۟ مَآ ءَاتَيْنَٰكُم بِقُوَّةٍ وَٱسْمَعُوا۟ۖ قَالُوا۟ سَمِعْنَا وَعَصَيْنَا وَأُشْرِبُوا۟ فِى قُلُوبِهِمُ ٱلْعِجْلَ بِكُفْرِهِمْۚ قُلْ بِئْسَمَا يَأْمُرُكُم بِهِۦٓ إِيمَٰنُكُمْ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "And [recall] when We took your covenant and raised over you the mount, [saying], \"Take what We have given you with determination and listen.\" They said [instead], \"We hear and disobey.\" And their hearts absorbed [the worship of] the calf because of their disbelief. Say, \"How wretched is that which your faith enjoins upon you, if you should be believers.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَخَذْنَا", "translit": "āَnْhdَhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "مِيثَٰقَكُمْ", "translit": "ْmُkَqَٰhtyِm", "root": "وثق"}, {"id": 4, "arabic": "وَرَفَعْنَا", "translit": "āَnْʿعَfَrَw", "root": "رفع"}, {"id": 5, "arabic": "فَوْقَكُمُ", "translit": "ُmُkَqْwَf", "root": "فوق"}, {"id": 6, "arabic": "ٱلطُّورَ", "translit": "َrwُّṭlٱ", "root": "طور"}, {"id": 7, "arabic": "خُذُوا۟", "translit": "۟āwُhdُhk", "root": "اخذ"}, {"id": 8, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 9, "arabic": "ءَاتَيْنَٰكُم", "translit": "mُkَٰnْyَtāَء", "root": "اتي"}, {"id": 10, "arabic": "بِقُوَّةٍ", "translit": "ٍẗَّwُqِb", "root": "قوي"}, {"id": 11, "arabic": "وَٱسْمَعُوا۟", "translit": "۟āwُʿعَmْsٱَw", "root": "سمع"}, {"id": 12, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 13, "arabic": "سَمِعْنَا", "translit": "āَnْʿعِmَs", "root": "سمع"}, {"id": 14, "arabic": "وَعَصَيْنَا", "translit": "āَnْyَṣَʿعَw", "root": "عصي"}, {"id": 15, "arabic": "وَأُشْرِبُوا۟", "translit": "۟āwُbِrْhsُaʾَw", "root": "شرب"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "قُلُوبِهِمُ", "translit": "ُmِhِbwُlُq", "root": "قلب"}, {"id": 18, "arabic": "ٱلْعِجْلَ", "translit": "َlْjgِʿعْlٱ", "root": "عجل"}, {"id": 19, "arabic": "بِكُفْرِهِمْ", "translit": "ْmِhِrْfُkِb", "root": "كفر"}, {"id": 20, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 21, "arabic": "بِئْسَمَا", "translit": "āَmَsْyʾِb", "root": "باس"}, {"id": 22, "arabic": "يَأْمُرُكُم", "translit": "mُkُrُmْaʾَy", "root": "امر"}, {"id": 23, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 24, "arabic": "إِيمَٰنُكُمْ", "translit": "ْmُkُnَٰmyِiʾ", "root": "امن"}, {"id": 25, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 26, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 27, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": true}, {"ayah": 94, "text": "قُلْ إِن كَانَتْ لَكُمُ ٱلدَّارُ ٱلْءَاخِرَةُ عِندَ ٱللَّهِ خَالِصَةً مِّن دُونِ ٱلنَّاسِ فَتَمَنَّوُا۟ ٱلْمَوْتَ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "Say, [O Muḥammad], \"If the home of the Hereafter with Allāh is for you alone and not the [other] people, then wish for death, if you should be truthful.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 3, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 4, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 5, "arabic": "ٱلدَّارُ", "translit": "ُrāَّdlٱ", "root": "دور"}, {"id": 6, "arabic": "ٱلْءَاخِرَةُ", "translit": "ُẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 7, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "خَالِصَةً", "translit": "ًẗَṣِlāَhk", "root": "خلص"}, {"id": 10, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 11, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 12, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 13, "arabic": "فَتَمَنَّوُا۟", "translit": "۟āُwَّnَmَtَf", "root": "مني"}, {"id": 14, "arabic": "ٱلْمَوْتَ", "translit": "َtْwَmْlٱ", "root": "موت"}, {"id": 15, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 16, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 17, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 95, "text": "وَلَن يَتَمَنَّوْهُ أَبَدًۢا بِمَا قَدَّمَتْ أَيْدِيهِمْۗ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّٰلِمِينَ ", "translation": "But never will they wish for it, ever, because of what their hands have put forth. And Allāh is Knowing of the wrongdoers.", "words": [{"id": 1, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 2, "arabic": "يَتَمَنَّوْهُ", "translit": "ُhْwَّnَmَtَy", "root": "مني"}, {"id": 3, "arabic": "أَبَدًۢا", "translit": "āًۢdَbَaʾ", "root": "ابد"}, {"id": 4, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 5, "arabic": "قَدَّمَتْ", "translit": "ْtَmَّdَq", "root": "قدم"}, {"id": 6, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 7, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 8, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 9, "arabic": "بِٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱِb", "root": "ظلم"}], "hasIhya": false}, {"ayah": 96, "text": "وَلَتَجِدَنَّهُمْ أَحْرَصَ ٱلنَّاسِ عَلَىٰ حَيَوٰةٍ وَمِنَ ٱلَّذِينَ أَشْرَكُوا۟ۚ يَوَدُّ أَحَدُهُمْ لَوْ يُعَمَّرُ أَلْفَ سَنَةٍ وَمَا هُوَ بِمُزَحْزِحِهِۦ مِنَ ٱلْعَذَابِ أَن يُعَمَّرَۗ وَٱللَّهُ بَصِيرٌۢ بِمَا يَعْمَلُونَ ", "translation": "And you will surely find them the most greedy of people for life - [even] more than those who associate others with Allāh. One of them wishes that he could be granted life a thousand years, but it would not remove him in the least from the [coming] punishment that he should be granted life. And Allāh is Seeing of what they do.", "words": [{"id": 1, "arabic": "وَلَتَجِدَنَّهُمْ", "translit": "ْmُhَّnَdِjgَtَlَw", "root": "وجد"}, {"id": 2, "arabic": "أَحْرَصَ", "translit": "َṣَrْḥَaʾ", "root": "حرص"}, {"id": 3, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "حَيَوٰةٍ", "translit": "ٍẗٰwَyَḥ", "root": "حيي"}, {"id": 6, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 7, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 8, "arabic": "أَشْرَكُوا۟", "translit": "۟āwُkَrْhsَaʾ", "root": "شرك"}, {"id": 9, "arabic": "يَوَدُّ", "translit": "ُّdَwَy", "root": "ودد"}, {"id": 10, "arabic": "أَحَدُهُمْ", "translit": "ْmُhُdَḥَaʾ", "root": "احد"}, {"id": 11, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 12, "arabic": "يُعَمَّرُ", "translit": "ُrَّmَʿعُy", "root": "عمر"}, {"id": 13, "arabic": "أَلْفَ", "translit": "َfْlَaʾ", "root": "الف"}, {"id": 14, "arabic": "سَنَةٍ", "translit": "ٍẗَnَs", "root": "سنو"}, {"id": 15, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 16, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 17, "arabic": "بِمُزَحْزِحِهِۦ", "translit": "ۦِhِḥِzْḥَzُmِb", "root": "زحزح"}, {"id": 18, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 19, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 20, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 21, "arabic": "يُعَمَّرَ", "translit": "َrَّmَʿعُy", "root": "عمر"}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "بَصِيرٌۢ", "translit": "ٌۢryِṣَb", "root": "بصر"}, {"id": 24, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 25, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": true}, {"ayah": 97, "text": "قُلْ مَن كَانَ عَدُوًّا لِّجِبْرِيلَ فَإِنَّهُۥ نَزَّلَهُۥ عَلَىٰ قَلْبِكَ بِإِذْنِ ٱللَّهِ مُصَدِّقًا لِّمَا بَيْنَ يَدَيْهِ وَهُدًى وَبُشْرَىٰ لِلْمُؤْمِنِينَ ", "translation": "Say, \"Whoever is an enemy to Gabriel - it is [none but] he who has brought it [i.e., the Qur’ān] down upon your heart, [O Muḥammad], by permission of Allāh, confirming that which was before it and as guidance and good tidings for the believers.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 3, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 4, "arabic": "عَدُوًّا", "translit": "āًّwُdَʿع", "root": "عدو"}, {"id": 5, "arabic": "لِّجِبْرِيلَ", "translit": "َlyِrْbِjgِّl", "root": ""}, {"id": 6, "arabic": "فَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَf", "root": ""}, {"id": 7, "arabic": "نَزَّلَهُۥ", "translit": "ۥُhَlَّzَn", "root": "نزل"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "قَلْبِكَ", "translit": "َkِbْlَq", "root": "قلب"}, {"id": 10, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "مُصَدِّقًا", "translit": "āًqِّdَṣُm", "root": "صدق"}, {"id": 13, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 14, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 15, "arabic": "يَدَيْهِ", "translit": "ِhْyَdَy", "root": "يدي"}, {"id": 16, "arabic": "وَهُدًى", "translit": "àًdُhَw", "root": "هدي"}, {"id": 17, "arabic": "وَبُشْرَىٰ", "translit": "ٰàَrْhsُbَw", "root": "بشر"}, {"id": 18, "arabic": "لِلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlِl", "root": "امن"}], "hasIhya": false}, {"ayah": 98, "text": "مَن كَانَ عَدُوًّا لِّلَّهِ وَمَلَٰٓئِكَتِهِۦ وَرُسُلِهِۦ وَجِبْرِيلَ وَمِيكَىٰلَ فَإِنَّ ٱللَّهَ عَدُوٌّ لِّلْكَٰفِرِينَ ", "translation": "Whoever is an enemy to Allāh and His angels and His messengers and Gabriel and Michael - then indeed, Allāh is an enemy to the disbelievers.", "words": [{"id": 1, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "عَدُوًّا", "translit": "āًّwُdَʿع", "root": "عدو"}, {"id": 4, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 5, "arabic": "وَمَلَٰٓئِكَتِهِۦ", "translit": "ۦِhِtَkِyʾَٰٓlَmَw", "root": "ملك"}, {"id": 6, "arabic": "وَرُسُلِهِۦ", "translit": "ۦِhِlُsُrَw", "root": "رسل"}, {"id": 7, "arabic": "وَجِبْرِيلَ", "translit": "َlyِrْbِjgَw", "root": ""}, {"id": 8, "arabic": "وَمِيكَىٰلَ", "translit": "َlٰàَkyِmَw", "root": ""}, {"id": 9, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 12, "arabic": "لِّلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِّl", "root": "كفر"}], "hasIhya": false}, {"ayah": 99, "text": "وَلَقَدْ أَنزَلْنَآ إِلَيْكَ ءَايَٰتٍۭ بَيِّنَٰتٍۖ وَمَا يَكْفُرُ بِهَآ إِلَّا ٱلْفَٰسِقُونَ ", "translation": "And We have certainly revealed to you verses [which are] clear proofs, and no one would deny them except the defiantly disobedient.", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "أَنزَلْنَآ", "translit": "ٓāَnْlَznَaʾ", "root": "نزل"}, {"id": 3, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 4, "arabic": "ءَايَٰتٍۭ", "translit": "ٍۭtَٰyāَء", "root": "ايي"}, {"id": 5, "arabic": "بَيِّنَٰتٍ", "translit": "ٍtَٰnِّyَb", "root": "بين"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "يَكْفُرُ", "translit": "ُrُfْkَy", "root": "كفر"}, {"id": 8, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 9, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱلْفَٰسِقُونَ", "translit": "َnwُqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": false}, {"ayah": 100, "text": "أَوَكُلَّمَا عَٰهَدُوا۟ عَهْدًا نَّبَذَهُۥ فَرِيقٌ مِّنْهُمۚ بَلْ أَكْثَرُهُمْ لَا يُؤْمِنُونَ ", "translation": "Is it not [true] that every time they took a covenant a party of them threw it away? But, [in fact], most of them do not believe.", "words": [{"id": 1, "arabic": "أَوَكُلَّمَا", "translit": "āَmَّlُkَwَaʾ", "root": "كلل"}, {"id": 2, "arabic": "عَٰهَدُوا۟", "translit": "۟āwُdَhَٰʿع", "root": "عهد"}, {"id": 3, "arabic": "عَهْدًا", "translit": "āًdْhَʿع", "root": "عهد"}, {"id": 4, "arabic": "نَّبَذَهُۥ", "translit": "ۥُhَhdَbَّn", "root": "نبذ"}, {"id": 5, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 6, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 7, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 8, "arabic": "أَكْثَرُهُمْ", "translit": "ْmُhُrَhtْkَaʾ", "root": "كثر"}, {"id": 9, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 10, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 101, "text": "وَلَمَّا جَآءَهُمْ رَسُولٌ مِّنْ عِندِ ٱللَّهِ مُصَدِّقٌ لِّمَا مَعَهُمْ نَبَذَ فَرِيقٌ مِّنَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ كِتَٰبَ ٱللَّهِ وَرَآءَ ظُهُورِهِمْ كَأَنَّهُمْ لَا يَعْلَمُونَ ", "translation": "And when a messenger from Allāh came to them confirming that which was with them, a party of those who had been given the Scripture threw the Scripture of Allāh [i.e., the Torah] behind their backs as if they did not know [what it contained].", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "جَآءَهُمْ", "translit": "ْmُhَءٓāَjg", "root": "جيا"}, {"id": 3, "arabic": "رَسُولٌ", "translit": "ٌlwُsَr", "root": "رسل"}, {"id": 4, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 5, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مُصَدِّقٌ", "translit": "ٌqِّdَṣُm", "root": "صدق"}, {"id": 8, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 9, "arabic": "مَعَهُمْ", "translit": "ْmُhَʿعَm", "root": ""}, {"id": 10, "arabic": "نَبَذَ", "translit": "َhdَbَn", "root": "نبذ"}, {"id": 11, "arabic": "فَرِيقٌ", "translit": "ٌqyِrَf", "root": "فرق"}, {"id": 12, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 15, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 16, "arabic": "كِتَٰبَ", "translit": "َbَٰtِk", "root": "كتب"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَرَآءَ", "translit": "َءٓāَrَw", "root": "وري"}, {"id": 19, "arabic": "ظُهُورِهِمْ", "translit": "ْmِhِrwُhُẓ", "root": "ظهر"}, {"id": 20, "arabic": "كَأَنَّهُمْ", "translit": "ْmُhَّnَaʾَk", "root": ""}, {"id": 21, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 22, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 102, "text": "وَٱتَّبَعُوا۟ مَا تَتْلُوا۟ ٱلشَّيَٰطِينُ عَلَىٰ مُلْكِ سُلَيْمَٰنَۖ وَمَا كَفَرَ سُلَيْمَٰنُ وَلَٰكِنَّ ٱلشَّيَٰطِينَ كَفَرُوا۟ يُعَلِّمُونَ ٱلنَّاسَ ٱلسِّحْرَ وَمَآ أُنزِلَ عَلَى ٱلْمَلَكَيْنِ بِبَابِلَ هَٰرُوتَ وَمَٰرُوتَۚ وَمَا يُعَلِّمَانِ مِنْ أَحَدٍ حَتَّىٰ يَقُولَآ إِنَّمَا نَحْنُ فِتْنَةٌ فَلَا تَكْفُرْۖ فَيَتَعَلَّمُونَ مِنْهُمَا مَا يُفَرِّقُونَ بِهِۦ بَيْنَ ٱلْمَرْءِ وَزَوْجِهِۦۚ وَمَا هُم بِضَآرِّينَ بِهِۦ مِنْ أَحَدٍ إِلَّا بِإِذْنِ ٱللَّهِۚ وَيَتَعَلَّمُونَ مَا يَضُرُّهُمْ وَلَا يَنفَعُهُمْۚ وَلَقَدْ عَلِمُوا۟ لَمَنِ ٱشْتَرَىٰهُ مَا لَهُۥ فِى ٱلْءَاخِرَةِ مِنْ خَلَٰقٍۚ وَلَبِئْسَ مَا شَرَوْا۟ بِهِۦٓ أَنفُسَهُمْۚ لَوْ كَانُوا۟ يَعْلَمُونَ ", "translation": "And they followed [instead] what the devils had recited during the reign of Solomon. It was not Solomon who disbelieved, but the devils disbelieved, teaching people magic and that which was revealed to the two angels at Babylon, Hārūt and Mārūt. But they [i.e., the two angels] do not teach anyone unless they say, \"We are a trial, so do not disbelieve [by practicing magic].\"[1] And [yet] they learn from them that by which they cause separation between a man and his wife. But they do not harm anyone through it except by permission of Allāh. And they [i.e., people] learn what harms them and does not benefit them. But they [i.e., the Children of Israel] certainly knew that whoever purchased it [i.e., magic] would not have in the Hereafter any share. And wretched is that for which they sold themselves, if they only knew.", "words": [{"id": 1, "arabic": "وَٱتَّبَعُوا۟", "translit": "۟āwُʿعَbَّtٱَw", "root": "تبع"}, {"id": 2, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 3, "arabic": "تَتْلُوا۟", "translit": "۟āwُlْtَt", "root": "تلو"}, {"id": 4, "arabic": "ٱلشَّيَٰطِينُ", "translit": "ُnyِṭَٰyَّhslٱ", "root": "شطن"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "مُلْكِ", "translit": "ِkْlُm", "root": "ملك"}, {"id": 7, "arabic": "سُلَيْمَٰنَ", "translit": "َnَٰmْyَlُs", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 9, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 10, "arabic": "سُلَيْمَٰنُ", "translit": "ُnَٰmْyَlُs", "root": ""}, {"id": 11, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 12, "arabic": "ٱلشَّيَٰطِينَ", "translit": "َnyِṭَٰyَّhslٱ", "root": "شطن"}, {"id": 13, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 14, "arabic": "يُعَلِّمُونَ", "translit": "َnwُmِّlَʿعُy", "root": "علم"}, {"id": 15, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 16, "arabic": "ٱلسِّحْرَ", "translit": "َrْḥِّslٱ", "root": "سحر"}, {"id": 17, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 18, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 19, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 20, "arabic": "ٱلْمَلَكَيْنِ", "translit": "ِnْyَkَlَmْlٱ", "root": "ملك"}, {"id": 21, "arabic": "بِبَابِلَ", "translit": "َlِbāَbِb", "root": ""}, {"id": 22, "arabic": "هَٰرُوتَ", "translit": "َtwُrَٰh", "root": ""}, {"id": 23, "arabic": "وَمَٰرُوتَ", "translit": "َtwُrَٰmَw", "root": ""}, {"id": 24, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 25, "arabic": "يُعَلِّمَانِ", "translit": "ِnāَmِّlَʿعُy", "root": "علم"}, {"id": 26, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 27, "arabic": "أَحَدٍ", "translit": "ٍdَḥَaʾ", "root": "احد"}, {"id": 28, "ar