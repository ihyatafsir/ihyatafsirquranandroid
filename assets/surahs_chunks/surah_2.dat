: 12, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "بَقَرَةٌ", "translit": "ٌẗَrَqَb", "root": "بقر"}, {"id": 14, "arabic": "صَفْرَآءُ", "translit": "ُءٓāَrْfَṣ", "root": "صفر"}, {"id": 15, "arabic": "فَاقِعٌ", "translit": "ٌʿعِqāَf", "root": "فقع"}, {"id": 16, "arabic": "لَّوْنُهَا", "translit": "āَhُnْwَّl", "root": "لون"}, {"id": 17, "arabic": "تَسُرُّ", "translit": "ُّrُsَt", "root": "سرر"}, {"id": 18, "arabic": "ٱلنَّٰظِرِينَ", "translit": "َnyِrِẓَّٰnlٱ", "root": "نظر"}], "hasIhya": false}, {"ayah": 70, "text": "قَالُوا۟ ٱدْعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا هِىَ إِنَّ ٱلْبَقَرَ تَشَٰبَهَ عَلَيْنَا وَإِنَّآ إِن شَآءَ ٱللَّهُ لَمُهْتَدُونَ ", "translation": "They said, \"Call upon your Lord to make clear to us what it is. Indeed, [all] cows look alike to us. And indeed we, if Allāh wills, will be guided.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱدْعُ", "translit": "ُʿعْdٱ", "root": "دعو"}, {"id": 3, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 4, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 5, "arabic": "يُبَيِّن", "translit": "nِّyَbُy", "root": "بين"}, {"id": 6, "arabic": "لَّنَا", "translit": "āَnَّl", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱلْبَقَرَ", "translit": "َrَqَbْlٱ", "root": "بقر"}, {"id": 11, "arabic": "تَشَٰبَهَ", "translit": "َhَbَٰhsَt", "root": "شبه"}, {"id": 12, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 13, "arabic": "وَإِنَّآ", "translit": "ٓāَّnِiʾَw", "root": ""}, {"id": 14, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 15, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "لَمُهْتَدُونَ", "translit": "َnwُdَtْhُmَl", "root": "هدي"}], "hasIhya": true}, {"ayah": 71, "text": "قَالَ إِنَّهُۥ يَقُولُ إِنَّهَا بَقَرَةٌ لَّا ذَلُولٌ تُثِيرُ ٱلْأَرْضَ وَلَا تَسْقِى ٱلْحَرْثَ مُسَلَّمَةٌ لَّا شِيَةَ فِيهَاۚ قَالُوا۟ ٱلْـَٰٔنَ جِئْتَ بِٱلْحَقِّۚ فَذَبَحُوهَا وَمَا كَادُوا۟ يَفْعَلُونَ ", "translation": "He said, \"He says, 'It is a cow neither trained to plow the earth nor to irrigate the field, one free from fault with no spot upon her.'\" They said, \"Now you have come with the truth.\" So they slaughtered her, but they could hardly do it.", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 4, "arabic": "إِنَّهَا", "translit": "āَhَّnِiʾ", "root": ""}, {"id": 5, "arabic": "بَقَرَةٌ", "translit": "ٌẗَrَqَb", "root": "بقر"}, {"id": 6, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 7, "arabic": "ذَلُولٌ", "translit": "ٌlwُlَhd", "root": "ذلل"}, {"id": 8, "arabic": "تُثِيرُ", "translit": "ُryِhtُt", "root": "ثور"}, {"id": 9, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "تَسْقِى", "translit": "àِqْsَt", "root": "سقي"}, {"id": 12, "arabic": "ٱلْحَرْثَ", "translit": "َhtْrَḥْlٱ", "root": "حرث"}, {"id": 13, "arabic": "مُسَلَّمَةٌ", "translit": "ٌẗَmَّlَsُm", "root": "سلم"}, {"id": 14, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 15, "arabic": "شِيَةَ", "translit": "َẗَyِhs", "root": "وشي"}, {"id": 16, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 17, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 18, "arabic": "ٱلْـَٰٔنَ", "translit": "َnَٰٔـْlٱ", "root": "اون"}, {"id": 19, "arabic": "جِئْتَ", "translit": "َtْyʾِjg", "root": "جيا"}, {"id": 20, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 21, "arabic": "فَذَبَحُوهَا", "translit": "āَhwُḥَbَhdَf", "root": "ذبح"}, {"id": 22, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 23, "arabic": "كَادُوا۟", "translit": "۟āwُdāَk", "root": "كود"}, {"id": 24, "arabic": "يَفْعَلُونَ", "translit": "َnwُlَʿعْfَy", "root": "فعل"}], "hasIhya": false}, {"ayah": 72, "text": "وَإِذْ قَتَلْتُمْ نَفْسًا فَٱدَّٰرَْٰٔتُمْ فِيهَاۖ وَٱللَّهُ مُخْرِجٌ مَّا كُنتُمْ تَكْتُمُونَ ", "translation": "And [recall] when you slew a man and disputed[1] over it, but Allāh was to bring out that which you were concealing.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَتَلْتُمْ", "translit": "ْmُtْlَtَq", "root": "قتل"}, {"id": 3, "arabic": "نَفْسًا", "translit": "āًsْfَn", "root": "نفس"}, {"id": 4, "arabic": "فَٱدَّٰرَْٰٔتُمْ", "translit": "ْmُtَْٰٔrَّٰdٱَf", "root": "درا"}, {"id": 5, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "مُخْرِجٌ", "translit": "ٌjgِrْhkُm", "root": "خرج"}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 10, "arabic": "تَكْتُمُونَ", "translit": "َnwُmُtْkَt", "root": "كتم"}], "hasIhya": false}, {"ayah": 73, "text": "فَقُلْنَا ٱضْرِبُوهُ بِبَعْضِهَاۚ كَذَٰلِكَ يُحْىِ ٱللَّهُ ٱلْمَوْتَىٰ وَيُرِيكُمْ ءَايَٰتِهِۦ لَعَلَّكُمْ تَعْقِلُونَ ", "translation": "So We said, \"Strike him [i.e., the slain man] with part of it.\"[1] Thus does Allāh bring the dead to life, and He shows you His signs that you might reason.", "words": [{"id": 1, "arabic": "فَقُلْنَا", "translit": "āَnْlُqَf", "root": "قول"}, {"id": 2, "arabic": "ٱضْرِبُوهُ", "translit": "ُhwُbِrْḍٱ", "root": "ضرب"}, {"id": 3, "arabic": "بِبَعْضِهَا", "translit": "āَhِḍْʿعَbِb", "root": "بعض"}, {"id": 4, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 5, "arabic": "يُحْىِ", "translit": "ِàْḥُy", "root": "حيي"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ٱلْمَوْتَىٰ", "translit": "ٰàَtْwَmْlٱ", "root": "موت"}, {"id": 8, "arabic": "وَيُرِيكُمْ", "translit": "ْmُkyِrُyَw", "root": "راي"}, {"id": 9, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 10, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 11, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": false}, {"ayah": 74, "text": "ثُمَّ قَسَتْ قُلُوبُكُم مِّنۢ بَعْدِ ذَٰلِكَ فَهِىَ كَٱلْحِجَارَةِ أَوْ أَشَدُّ قَسْوَةًۚ وَإِنَّ مِنَ ٱلْحِجَارَةِ لَمَا يَتَفَجَّرُ مِنْهُ ٱلْأَنْهَٰرُۚ وَإِنَّ مِنْهَا لَمَا يَشَّقَّقُ فَيَخْرُجُ مِنْهُ ٱلْمَآءُۚ وَإِنَّ مِنْهَا لَمَا يَهْبِطُ مِنْ خَشْيَةِ ٱللَّهِۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعْمَلُونَ ", "translation": "Then your hearts became hardened after that, being like stones or even harder. For indeed, there are stones from which rivers burst forth, and there are some of them that split open and water comes out, and there are some of them that fall down for fear of Allāh. And Allāh is not unaware of what you do.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "قَسَتْ", "translit": "ْtَsَq", "root": "قسو"}, {"id": 3, "arabic": "قُلُوبُكُم", "translit": "mُkُbwُlُq", "root": "قلب"}, {"id": 4, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 7, "arabic": "فَهِىَ", "translit": "َàِhَf", "root": ""}, {"id": 8, "arabic": "كَٱلْحِجَارَةِ", "translit": "ِẗَrāَjgِḥْlٱَk", "root": "حجر"}, {"id": 9, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 10, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 11, "arabic": "قَسْوَةً", "translit": "ًẗَwْsَq", "root": "قسو"}, {"id": 12, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"