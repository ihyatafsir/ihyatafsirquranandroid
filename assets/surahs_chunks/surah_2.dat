four months and ten [days]. And when they have fulfilled their term, then there is no blame upon you for what they do with themselves in an acceptable manner.[1] And Allāh is [fully] Aware of what you do.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُتَوَفَّوْنَ", "translit": "َnْwَّfَwَtُy", "root": "وفي"}, {"id": 3, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 4, "arabic": "وَيَذَرُونَ", "translit": "َnwُrَhdَyَw", "root": "وذر"}, {"id": 5, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 6, "arabic": "يَتَرَبَّصْنَ", "translit": "َnْṣَّbَrَtَy", "root": "ربص"}, {"id": 7, "arabic": "بِأَنفُسِهِنَّ", "translit": "َّnِhِsُfnَaʾِb", "root": "نفس"}, {"id": 8, "arabic": "أَرْبَعَةَ", "translit": "َẗَʿعَbْrَaʾ", "root": "ربع"}, {"id": 9, "arabic": "أَشْهُرٍ", "translit": "ٍrُhْhsَaʾ", "root": "شهر"}, {"id": 10, "arabic": "وَعَشْرًا", "translit": "āًrْhsَʿعَw", "root": "عشر"}, {"id": 11, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 12, "arabic": "بَلَغْنَ", "translit": "َnْغَlَb", "root": "بلغ"}, {"id": 13, "arabic": "أَجَلَهُنَّ", "translit": "َّnُhَlَjgَaʾ", "root": "اجل"}, {"id": 14, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 15, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 16, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 17, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 18, "arabic": "فَعَلْنَ", "translit": "َnْlَʿعَf", "root": "فعل"}, {"id": 19, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 20, "arabic": "أَنفُسِهِنَّ", "translit": "َّnِhِsُfnَaʾ", "root": "نفس"}, {"id": 21, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 24, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 25, "arabic": "خَبِيرٌ", "translit": "ٌryِbَhk", "root": "خبر"}], "hasIhya": false}, {"ayah": 235, "text": "وَلَا جُنَاحَ عَلَيْكُمْ فِيمَا عَرَّضْتُم بِهِۦ مِنْ خِطْبَةِ ٱلنِّسَآءِ أَوْ أَكْنَنتُمْ فِىٓ أَنفُسِكُمْۚ عَلِمَ ٱللَّهُ أَنَّكُمْ سَتَذْكُرُونَهُنَّ وَلَٰكِن لَّا تُوَاعِدُوهُنَّ سِرًّا إِلَّآ أَن تَقُولُوا۟ قَوْلًا مَّعْرُوفًاۚ وَلَا تَعْزِمُوا۟ عُقْدَةَ ٱلنِّكَاحِ حَتَّىٰ يَبْلُغَ ٱلْكِتَٰبُ أَجَلَهُۥۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ يَعْلَمُ مَا فِىٓ أَنفُسِكُمْ فَٱحْذَرُوهُۚ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ غَفُورٌ حَلِيمٌ ", "translation": "There is no blame upon you for that to which you [indirectly] allude concerning a proposal to women or for what you conceal within yourselves. Allāh knows that you will have them in mind. But do not promise them secretly except for saying a proper saying. And do not determine to undertake a marriage contract until the decreed period[1] reaches its end. And know that Allāh knows what is within yourselves, so beware of Him. And know that Allāh is Forgiving and Forbearing.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 3, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 5, "arabic": "عَرَّضْتُم", "translit": "mُtْḍَّrَʿع", "root": "عرض"}, {"id": 6, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 7, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 8, "arabic": "خِطْبَةِ", "translit": "ِẗَbْṭِhk", "root": "خطب"}, {"id": 9, "arabic": "ٱلنِّسَآءِ", "translit": "ِءٓāَsِّnlٱ", "root": "نسو"}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "أَكْنَنتُمْ", "translit": "ْmُtnَnْkَaʾ", "root": "كنن"}, {"id": 12, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 13, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 14, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "أَنَّكُمْ", "translit": "ْmُkَّnَaʾ", "root": ""}, {"id": 17, "arabic": "سَتَذْكُرُونَهُنَّ", "translit": "َّnُhَnwُrُkْhdَtَs", "root": "ذكر"}, {"id": 18, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 19, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 20, "arabic": "تُوَاعِدُوهُنَّ", "translit": "َّnُhwُdِʿعāَwُt", "root": "وعد"}, {"id": 21, "arabic": "سِرًّا", "translit": "āًّrِs", "root": "سرر"}, {"id": 22, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 23, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 24, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 25, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 26, "arabic": "مَّعْرُوفًا", "translit": "āًfwُrْʿعَّm", "root": "عرف"}, {"id": 27, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 28, "arabic": "تَعْزِمُوا۟", "translit": "۟āwُmِzْʿعَt", "root": "عزم"}, {"id": 29, "arabic": "عُقْدَةَ", "translit": "َẗَdْqُʿع", "root": "عقد"}, {"id": 30, "arabic": "ٱلنِّكَاحِ", "translit": "ِḥāَkِّnlٱ", "root": "نكح"}, {"id": 31, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 32, "arabic": "يَبْلُغَ", "translit": "َغُlْbَy", "root": "بلغ"}, {"id": 33, "arabic": "ٱلْكِتَٰبُ", "translit": "ُbَٰtِkْlٱ", "root": "كتب"}, {"id": 34, "arabic": "أَجَلَهُۥ", "translit": "ۥُhَlَjgَaʾ", "root": "اجل"}, {"id": 35, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 36, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 37, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 38, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 39, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 40, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 41, "arabic": "أَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾ", "root": "نفس"}, {"id": 42, "arabic": "فَٱحْذَرُوهُ", "translit": "ُhwُrَhdْḥٱَf", "root": "حذر"}, {"id": 43, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 44, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 45, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 46, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 47, "arabic": "حَلِيمٌ", "translit": "ٌmyِlَḥ", "root": "حلم"}], "hasIhya": true}, {"ayah": 236, "text": "لَّا جُنَاحَ عَلَيْكُمْ إِن طَلَّقْتُمُ ٱلنِّسَآءَ مَا لَمْ تَمَسُّوهُنَّ أَوْ تَفْرِضُوا۟ لَهُنَّ فَرِيضَةًۚ وَمَتِّعُوهُنَّ عَلَى ٱلْمُوسِعِ قَدَرُهُۥ وَعَلَى ٱلْمُقْتِرِ قَدَرُهُۥ مَتَٰعًۢا بِٱلْمَعْرُوفِۖ حَقًّا عَلَى ٱلْمُحْسِنِينَ ", "translation": "There is no blame upon you if you divorce women you have not touched[1] nor specified for them an obligation.[2] But give them [a gift of] compensation - the wealthy according to his capability and the poor according to his capability - a provision according to what is acceptable, a duty upon the doers of good.", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 3, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 5, "arabic": "طَلَّقْتُمُ", "translit": "ُmُtْqَّlَṭ", "root": "طلق"}, {"id": 6, "arabic": "ٱلنِّسَآءَ", "translit": "َءٓāَsِّnlٱ", "root": "نسو"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 9, "arabic": "تَمَسُّوهُنَّ", "translit": "َّnُhwُّsَmَt", "root": "مسس"}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "تَفْرِضُوا۟", "translit": "۟āwُḍِrْfَt", "root": "فرض"}, {"id": 12, "arabic": "لَهُنَّ", "translit": "َّnُhَl", "root": ""}, {"id": 13, "arabic": "فَرِيضَةً", "translit": "ًẗَḍyِrَf", "root": "فرض"}, {"id": 14, "arabic": "وَمَتِّعُوهُنَّ", "translit": "َّnُhwُʿعِّtَmَw", "root": "متع"}, {"id": 15, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 16, "arabic": "ٱلْمُوسِعِ", "translit": "ِʿعِswُmْlٱ", "root": "وسع"}, {"id": 17, "arabic": "قَدَرُهُۥ", "translit": "ۥُhُrَdَq", "root": "قدر"}, {"id": 18, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 19, "arabic": "ٱلْمُقْتِرِ", "translit": "ِrِtْqُmْlٱ", "root": "قتر"}, {"id": 20, "arabic": "قَدَرُهُۥ", "translit": "ۥُhُrَdَq", "root": "قدر"}, {"id": 21, "arabic": "مَتَٰعًۢا", "translit": "āًۢʿعَٰtَm", "root": "متع"}, {"id": 22, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 23, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 24, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 25, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": false}, {"ayah": 237, "text": "وَإِن طَلَّقْتُمُوهُنَّ مِن قَبْلِ أَن تَمَسُّوهُنَّ وَقَدْ فَرَضْتُمْ لَهُنَّ فَرِيضَةً فَنِصْفُ مَا فَرَضْتُمْ إِلَّآ أَن يَعْفُونَ أَوْ يَعْفُوَا۟ ٱلَّذِى بِيَدِهِۦ عُقْدَةُ ٱلنِّكَاحِۚ وَأَن تَعْفُوٓا۟ أَقْرَبُ لِلتَّقْوَىٰۚ وَلَا تَنسَوُا۟ ٱلْفَضْلَ بَيْنَكُمْۚ إِنَّ ٱللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "And if you divorce them before you have touched them and you have already specified for them an obligation, then [give] half of what you specified - unless they forego the right or the one in whose hand is the marriage contract foregoes it. And to forego it is nearer to righteousness. And do not forget graciousness between you. Indeed Allāh, of whatever you do, is Seeing.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "طَلَّقْتُمُوهُنَّ", "translit": "َّnُhwُmُtْqَّlَṭ", "root": "طلق"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "تَمَسُّوهُنَّ", "translit": "َّnُhwُّsَmَt", "root": "مسس"}, {"id": 7, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 8, "arabic": "فَرَضْتُمْ", "translit": "ْmُtْḍَrَf", "root": "فرض"}, {"id": 9, "arabic": "لَهُنَّ", "translit": "َّnُhَl", "root": ""}, {"id": 10, "arabic": "فَرِيضَةً", "translit": "ًẗَḍyِrَf", "root": "فرض"}, {"id": 11, "arabic": "فَنِصْفُ", "translit": "ُfْṣِnَf", "root": "نصف"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "فَرَضْتُمْ", "translit": "ْmُtْḍَrَf", "root": "فرض"}, {"id": 14, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "يَعْفُونَ", "translit": "َnwُfْʿعَy", "root": "عفو"}, {"id": 17, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 18, "arabic": "يَعْفُوَا۟", "translit": "۟āَwُfْʿعَy", "root": "عفو"}, {"id": 19, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "بِيَدِهِۦ", "translit": "ۦِhِdَyِb", "root": "يدي"}, {"id": 21, "arabic": "عُقْدَةُ", "translit": "ُẗَdْqُʿع", "root": "عقد"}, {"id": 22, "arabic": "ٱلنِّكَاحِ", "translit": "ِḥāَkِّnlٱ", "root": "نكح"}, {"id": 23, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 24, "arabic": "تَعْفُوٓا۟", "translit": "۟āٓwُfْʿعَt", "root": "عفو"}, {"id": 25, "arabic": "أَقْرَبُ", "translit": "ُbَrْqَaʾ", "root": "قرب"}, {"id": 26, "arabic": "لِلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlِl", "root": "وقي"}, {"id": 27, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 28, "arabic": "تَنسَوُا۟", "translit": "۟āُwَsnَt", "root": "نسي"}, {"id": 29, "arabic": "ٱلْفَضْلَ", "translit": "َlْḍَfْlٱ", "root": "فضل"}, {"id": 30, "arabic": "بَيْنَكُمْ", "translit": "ْmُkَnْyَb", "root": "بين"}, {"id": 31, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 32, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 33, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 34, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 35, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 238, "text": "حَٰفِظُوا۟ عَلَى ٱلصَّلَوَٰتِ وَٱلصَّلَوٰةِ ٱلْوُسْطَىٰ وَقُومُوا۟ لِلَّهِ قَٰنِتِينَ ", "translation": "Maintain with care the [obligatory] prayers and [in particular] the middle [i.e., ʿaṣr] prayer and stand before Allāh, devoutly obedient.", "words": [{"id": 1, "arabic": "حَٰفِظُوا۟", "translit": "۟āwُẓِfَٰḥ", "root": "حفظ"}, {"id": 2, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلصَّلَوَٰتِ", "translit": "ِtَٰwَlَّṣlٱ", "root": "صلو"}, {"id": 4, "arabic": "وَٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱَw", "root": "صلو"}, {"id": 5, "arabic": "ٱلْوُسْطَىٰ", "translit": "ٰàَṭْsُwْlٱ", "root": "وسط"}, {"id": 6, "arabic": "وَقُومُوا۟", "translit": "۟āwُmwُqَw", "root": "قوم"}, {"id": 7, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 8, "arabic": "قَٰنِتِينَ", "translit": "َnyِtِnَٰq", "root": "قنت"}], "hasIhya": false}, {"ayah": 239, "text": "فَإِنْ خِفْتُمْ فَرِجَالًا أَوْ رُكْبَانًاۖ فَإِذَآ أَمِنتُمْ فَٱذْكُرُوا۟ ٱللَّهَ كَمَا عَلَّمَكُم مَّا لَمْ تَكُونُوا۟ تَعْلَمُونَ ", "translation": "And if you fear [an enemy, then pray] on foot or riding. But when you are secure, then remember Allāh [in prayer], as He has taught you that which you did not [previously] know.", "words": [{"id": 1, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 2, "arabic": "خِفْتُمْ", "translit": "ْmُtْfِhk", "root": "خوف"}, {"id": 3, "arabic": "فَرِجَالًا", "translit": "āًlāَjgِrَf", "root": "رجل"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "رُكْبَانًا", "translit": "āًnāَbْkُr", "root": "ركب"}, {"id": 6, "arabic": "فَإِذَآ", "translit": "ٓāَhdِiʾَf", "root": ""}, {"id": 7, "arabic": "أَمِنتُمْ", "translit": "ْmُtnِmَaʾ", "root": "امن"}, {"id": 8, "arabic": "فَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَf", "root": "ذكر"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 11, "arabic": "عَلَّمَكُم", "translit": "mُkَmَّlَʿع", "root": "علم"}, {"id": 12, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 13, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 14, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 15, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 240, "text": "وَٱلَّذِينَ يُتَوَفَّوْنَ مِنكُمْ وَيَذَرُونَ أَزْوَٰجًا وَصِيَّةً لِّأَزْوَٰجِهِم مَّتَٰعًا إِلَى ٱلْحَوْلِ غَيْرَ إِخْرَاجٍۚ فَإِنْ خَرَجْنَ فَلَا جُنَاحَ عَلَيْكُمْ فِى مَا فَعَلْنَ فِىٓ أَنفُسِهِنَّ مِن مَّعْرُوفٍۗ وَٱللَّهُ عَزِيزٌ حَكِيمٌ ", "translation": "And those who are taken in death among you and leave wives behind - for their wives is a bequest: maintenance for one year without turning [them] out. But if they leave [of their own accord], then there is no blame upon you for what they do with themselves in an acceptable way.[1] And Allāh is Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُتَوَفَّوْنَ", "translit": "َnْwَّfَwَtُy", "root": "وفي"}, {"id": 3, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 4, "arabic": "وَيَذَرُونَ", "translit": "َnwُrَhdَyَw", "root": "وذر"}, {"id": 5, "arabic": "أَزْوَٰجًا", "translit": "āًjgَٰwْzَaʾ", "root": "زوج"}, {"id": 6, "arabic": "وَصِيَّةً", "translit": "ًẗَّyِṣَw", "root": "وصي"}, {"id": 7, "arabic": "لِّأَزْوَٰجِهِم", "translit": "mِhِjgَٰwْzَaʾِّl", "root": "زوج"}, {"id": 8, "arabic": "مَّتَٰعًا", "translit": "āًʿعَٰtَّm", "root": "متع"}, {"id": 9, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 10, "arabic": "ٱلْحَوْلِ", "translit": "ِlْwَḥْlٱ", "root": "حول"}, {"id": 11, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 12, "arabic": "إِخْرَاجٍ", "translit": "ٍjgāَrْhkِiʾ", "root": "خرج"}, {"id": 13, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 14, "arabic": "خَرَجْنَ", "translit": "َnْjgَrَhk", "root": "خرج"}, {"id": 15, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 16, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 17, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 20, "arabic": "فَعَلْنَ", "translit": "َnْlَʿعَf", "root": "فعل"}, {"id": 21, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 22, "arabic": "أَنفُسِهِنَّ", "translit": "َّnِhِsُfnَaʾ", "root": "نفس"}, {"id": 23, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 24, "arabic": "مَّعْرُوفٍ", "translit": "ٍfwُrْʿعَّm", "root": "عرف"}, {"id": 25, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 26, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 27, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 241, "text": "وَلِلْمُطَلَّقَٰتِ مَتَٰعٌۢ بِٱلْمَعْرُوفِۖ حَقًّا عَلَى ٱلْمُتَّقِينَ ", "translation": "And for divorced women is a provision according to what is acceptable - a duty upon the righteous.", "words": [{"id": 1, "arabic": "وَلِلْمُطَلَّقَٰتِ", "translit": "ِtَٰqَّlَṭُmْlِlَw", "root": "طلق"}, {"id": 2, "arabic": "مَتَٰعٌۢ", "translit": "ٌۢʿعَٰtَm", "root": "متع"}, {"id": 3, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 4, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 5, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 242, "text": "كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمْ ءَايَٰتِهِۦ لَعَلَّكُمْ تَعْقِلُونَ ", "translation": "Thus does Allāh make clear to you His verses [i.e., laws] that you might use reason.", "words": [{"id": 1, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 2, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 5, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 6, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 7, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": false}, {"ayah": 243, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِينَ خَرَجُوا۟ مِن دِيَٰرِهِمْ وَهُمْ أُلُوفٌ حَذَرَ ٱلْمَوْتِ فَقَالَ لَهُمُ ٱللَّهُ مُوتُوا۟ ثُمَّ أَحْيَٰهُمْۚ إِنَّ ٱللَّهَ لَذُو فَضْلٍ عَلَى ٱلنَّاسِ وَلَٰكِنَّ أَكْثَرَ ٱلنَّاسِ لَا يَشْكُرُونَ ", "translation": "Have you not considered those who left their homes in many thousands, fearing death? Allāh said to them, \"Die\"; then He restored them to life. And Allāh is the possessor of bounty for the people, but most of the people do not show gratitude.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "خَرَجُوا۟", "translit": "۟āwُjgَrَhk", "root": "خرج"}, {"id": 6, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 7, "arabic": "دِيَٰرِهِمْ", "translit": "ْmِhِrَٰyِd", "root": "دور"}, {"id": 8, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 9, "arabic": "أُلُوفٌ", "translit": "ٌfwُlُaʾ", "root": "الف"}, {"id": 10, "arabic": "حَذَرَ", "translit": "َrَhdَḥ", "root": "حذر"}, {"id": 11, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 12, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 13, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "مُوتُوا۟", "translit": "۟āwُtwُm", "root": "موت"}, {"id": 16, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 17, "arabic": "أَحْيَٰهُمْ", "translit": "ْmُhَٰyْḥَaʾ", "root": "حيي"}, {"id": 18, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 19, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "لَذُو", "translit": "wُhdَl", "root": ""}, {"id": 21, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 22, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 23, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 24, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 25, "arabic": "أَكْثَرَ", "translit": "َrَhtْkَaʾ", "root": "كثر"}, {"id": 26, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 27, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 28, "arabic": "يَشْكُرُونَ", "translit": "َnwُrُkْhsَy", "root": "شكر"}], "hasIhya": true}, {"ayah": 244, "text": "وَقَٰتِلُوا۟ فِى سَبِيلِ ٱللَّهِ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ سَمِيعٌ عَلِيمٌ ", "translation": "And fight in the cause of Allāh and know that Allāh is Hearing and Knowing.", "words": [{"id": 1, "arabic": "وَقَٰتِلُوا۟", "translit": "۟āwُlِtَٰqَw", "root": "قتل"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 6, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 9, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 245, "text": "مَّن ذَا ٱلَّذِى يُقْرِضُ ٱللَّهَ قَرْضًا حَسَنًا فَيُضَٰعِفَهُۥ لَهُۥٓ أَضْعَافًا كَثِيرَةًۚ وَٱللَّهُ يَقْبِضُ وَيَبْصُۜطُ وَإِلَيْهِ تُرْجَعُونَ ", "translation": "Who is it that would loan Allāh a goodly loan so He may multiply it for him many times over? And it is Allāh who withholds and grants abundance, and to Him you will be returned.", "words": [{"id": 1, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 2, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "يُقْرِضُ", "translit": "ُḍِrْqُy", "root": "قرض"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "قَرْضًا", "translit": "āًḍْrَq", "root": "قرض"}, {"id": 7, "arabic": "حَسَنًا", "translit": "āًnَsَḥ", "root": "حسن"}, {"id": 8, "arabic": "فَيُضَٰعِفَهُۥ", "translit": "ۥُhَfِʿعَٰḍُyَf", "root": "ضعف"}, {"id": 9, "arabic": "لَهُۥٓ", "translit": "ٓۥُhَl", "root": ""}, {"id": 10, "arabic": "أَضْعَافًا", "translit": "āًfāَʿعْḍَaʾ", "root": "ضعف"}, {"id": 11, "arabic": "كَثِيرَةً", "translit": "ًẗَryِhtَk", "root": "كثر"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "يَقْبِضُ", "translit": "ُḍِbْqَy", "root": "قبض"}, {"id": 14, "arabic": "وَيَبْصُۜطُ", "translit": "ُṭُۜṣْbَyَw", "root": "بسط"}, {"id": 15, "arabic": "وَإِلَيْهِ", "translit": "ِhْyَlِiʾَw", "root": ""}, {"id": 16, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": true}, {"ayah": 246, "text": "أَلَمْ تَرَ إِلَى ٱلْمَلَإِ مِنۢ بَنِىٓ إِسْرَٰٓءِيلَ مِنۢ بَعْدِ مُوسَىٰٓ إِذْ قَالُوا۟ لِنَبِىٍّ لَّهُمُ ٱبْعَثْ لَنَا مَلِكًا نُّقَٰتِلْ فِى سَبِيلِ ٱللَّهِۖ قَالَ هَلْ عَسَيْتُمْ إِن كُتِبَ عَلَيْكُمُ ٱلْقِتَالُ أَلَّا تُقَٰتِلُوا۟ۖ قَالُوا۟ وَمَا لَنَآ أَلَّا نُقَٰتِلَ فِى سَبِيلِ ٱللَّهِ وَقَدْ أُخْرِجْنَا مِن دِيَٰرِنَا وَأَبْنَآئِنَاۖ فَلَمَّا كُتِبَ عَلَيْهِمُ ٱلْقِتَالُ تَوَلَّوْا۟ إِلَّا قَلِيلًا مِّنْهُمْۗ وَٱللَّهُ عَلِيمٌۢ بِٱلظَّٰلِمِينَ ", "translation": "Have you not considered the assembly of the Children of Israel after [the time of] Moses when they said to a prophet of theirs, \"Send to us a king, and we will fight in the way of Allāh\"? He said, \"Would you perhaps refrain from fighting if battle was prescribed for you?\" They said, \"And why should we not fight in the cause of Allāh when we have been driven out from our homes and from our children?\" But when battle was prescribed for them, they turned away, except for a few of them. And Allāh is Knowing of the wrongdoers.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْمَلَإِ", "translit": "ِiʾَlَmْlٱ", "root": "ملا"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 7, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 8, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 9, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 11, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 12, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 13, "arabic": "لِنَبِىٍّ", "translit": "ٍّàِbَnِl", "root": "نبا"}, {"id": 14, "arabic": "لَّهُمُ", "translit": "ُmُhَّl", "root": ""}, {"id": 15, "arabic": "ٱبْعَثْ", "translit": "ْhtَʿعْbٱ", "root": "بعث"}, {"id": 16, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 17, "arabic": "مَلِكًا", "translit": "āًkِlَm", "root": "ملك"}, {"id": 18, "arabic": "نُّقَٰتِلْ", "translit": "ْlِtَٰqُّn", "root": "قتل"}, {"id": 19, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 20, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 21, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 23, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 24, "arabic": "عَسَيْتُمْ", "translit": "ْmُtْyَsَʿع", "root": "عسي"}, {"id": 25, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 26, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 27, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 28, "arabic": "ٱلْقِتَالُ", "translit": "ُlāَtِqْlٱ", "root": "قتل"}, {"id": 29, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 30, "arabic": "تُقَٰتِلُوا۟", "translit": "۟āwُlِtَٰqُt", "root": "قتل"}, {"id": 31, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 32, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 33, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 34, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 35, "arabic": "نُقَٰتِلَ", "translit": "َlِtَٰqُn", "root": "قتل"}, {"id": 36, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 37, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 38, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 39, "arabic": "وَقَدْ", "translit": "ْdَqَw", "root": ""}, {"id": 40, "arabic": "أُخْرِجْنَا", "translit": "āَnْjgِrْhkُaʾ", "root": "خرج"}, {"id": 41, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 42, "arabic": "دِيَٰرِنَا", "translit": "āَnِrَٰyِd", "root": "دور"}, {"id": 43, "arabic": "وَأَبْنَآئِنَا", "translit": "āَnِyʾٓāَnْbَaʾَw", "root": "بني"}, {"id": 44, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 45, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 46, "arabic": "عَلَيْهِمُ", "translit": "ُmِhْyَlَʿع", "root": ""}, {"id": 47, "arabic": "ٱلْقِتَالُ", "translit": "ُlāَtِqْlٱ", "root": "قتل"}, {"id": 48, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 49, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 50, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 51, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 52, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 53, "arabic": "عَلِيمٌۢ", "translit": "ٌۢmyِlَʿع", "root": "علم"}, {"id": 54, "arabic": "بِٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱِb", "root": "ظلم"}], "hasIhya": false}, {"ayah": 247, "text": "وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ ٱللَّهَ قَدْ بَعَثَ لَكُمْ طَالُوتَ مَلِكًاۚ قَالُوٓا۟ أَنَّىٰ يَكُونُ لَهُ ٱلْمُلْكُ عَلَيْنَا وَنَحْنُ أَحَقُّ بِٱلْمُلْكِ مِنْهُ وَلَمْ يُؤْتَ سَعَةً مِّنَ ٱلْمَالِۚ قَالَ إِنَّ ٱللَّهَ ٱصْطَفَىٰهُ عَلَيْكُمْ وَزَادَهُۥ بَسْطَةً فِى ٱلْعِلْمِ وَٱلْجِسْمِۖ وَٱللَّهُ يُؤْتِى مُلْكَهُۥ مَن يَشَآءُۚ وَٱللَّهُ وَٰسِعٌ عَلِيمٌ ", "translation": "And their prophet said to them, \"Indeed, Allāh has sent to you Saul as a king.\" They said, \"How can he have kingship over us while we are more worthy of kingship than him and he has not been given any measure of wealth?\" He said, \"Indeed, Allāh has chosen him over you and has increased him abundantly in knowledge and stature. And Allāh gives His sovereignty to whom He wills. And Allāh is all-Encompassing [in favor] and Knowing.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "نَبِيُّهُمْ", "translit": "ْmُhُّyِbَn", "root": "نبا"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 7, "arabic": "بَعَثَ", "translit": "َhtَʿعَb", "root": "بعث"}, {"id": 8, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 9, "arabic": "طَالُوتَ", "translit": "َtwُlāَṭ", "root": ""}, {"id": 10, "arabic": "مَلِكًا", "translit": "āًkِlَm", "root": "ملك"}, {"id": 11, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 12, "arabic": "أَنَّىٰ", "translit": "ٰàَّnَaʾ", "root": ""}, {"id": 13, "arabic": "يَكُونُ", "translit": "ُnwُkَy", "root": "كون"}, {"id": 14, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 15, "arabic": "ٱلْمُلْكُ", "translit": "ُkْlُmْlٱ", "root": "ملك"}, {"id": 16, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 17, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 18, "arabic": "أَحَقُّ", "translit": "ُّqَḥَaʾ", "root": "حقق"}, {"id": 19, "arabic": "بِٱلْمُلْكِ", "translit": "ِkْlُmْlٱِb", "root": "ملك"}, {"id": 20, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 21, "arabic": "وَلَمْ", "translit": "ْmَlَw", "root": ""}, {"id": 22, "arabic": "يُؤْتَ", "translit": "َtْwʾُy", "root": "اتي"}, {"id": 23, "arabic": "سَعَةً", "translit": "ًẗَʿعَs", "root": "وسع"}, {"id": 24, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 25, "arabic": "ٱلْمَالِ", "translit": "ِlāَmْlٱ", "root": "مول"}, {"id": 26, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 27, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 28, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "ٱصْطَفَىٰهُ", "translit": "ُhٰàَfَṭْṣٱ", "root": "صفو"}, {"id": 30, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 31, "arabic": "وَزَادَهُۥ", "translit": "ۥُhَdāَzَw", "root": "زيد"}, {"id": 32, "arabic": "بَسْطَةً", "translit": "ًẗَṭْsَb", "root": "بسط"}, {"id": 33, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 34, "arabic": "ٱلْعِلْمِ", "translit": "ِmْlِʿعْlٱ", "root": "علم"}, {"id": 35, "arabic": "وَٱلْجِسْمِ", "translit": "ِmْsِjgْlٱَw", "root": "جسم"}, {"id": 36, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 37, "arabic": "يُؤْتِى", "translit": "àِtْwʾُy", "root": "اتي"}, {"id": 38, "arabic": "مُلْكَهُۥ", "translit": "ۥُhَkْlُm", "root": "ملك"}, {"id": 39, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 40, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 41, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 42, "arabic": "وَٰسِعٌ", "translit": "ٌʿعِsَٰw", "root": "وسع"}, {"id": 43, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 248, "text": "وَقَالَ لَهُمْ نَبِيُّهُمْ إِنَّ ءَايَةَ مُلْكِهِۦٓ أَن يَأْتِيَكُمُ ٱلتَّابُوتُ فِيهِ سَكِينَةٌ مِّن رَّبِّكُمْ وَبَقِيَّةٌ مِّمَّا تَرَكَ ءَالُ مُوسَىٰ وَءَالُ هَٰرُونَ تَحْمِلُهُ ٱلْمَلَٰٓئِكَةُۚ إِنَّ فِى ذَٰلِكَ لَءَايَةً لَّكُمْ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "And their prophet said to them, \"Indeed, a sign of his kingship is that the chest will come to you in which is assurance[1] from your Lord and a remnant of what the family of Moses and the family of Aaron had left, carried by the angels. Indeed in that is a sign for you, if you are believers.\"", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "نَبِيُّهُمْ", "translit": "ْmُhُّyِbَn", "root": "نبا"}, {"id": 4, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 5, "arabic": "ءَايَةَ", "translit": "َẗَyāَء", "root": "ايي"}, {"id": 6, "arabic": "مُلْكِهِۦٓ", "translit": "ٓۦِhِkْlُm", "root": "ملك"}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "يَأْتِيَكُمُ", "translit": "ُmُkَyِtْaʾَy", "root": "اتي"}, {"id": 9, "arabic": "ٱلتَّابُوتُ", "translit": "ُtwُbāَّtlٱ", "root": ""}, {"id": 10, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 11, "arabic": "سَكِينَةٌ", "translit": "ٌẗَnyِkَs", "root": "سكن"}, {"id": 12, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 13, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 14, "arabic": "وَبَقِيَّةٌ", "translit": "ٌẗَّyِqَbَw", "root": "بقي"}, {"id": 15, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 16, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 17, "arabic": "ءَالُ", "translit": "ُlāَء", "root": "اول"}, {"id": 18, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 19, "arabic": "وَءَالُ", "translit": "ُlāَءَw", "root": "اول"}, {"id": 20, "arabic": "هَٰرُونَ", "translit": "َnwُrَٰh", "root": ""}, {"id": 21, "arabic": "تَحْمِلُهُ", "translit": "ُhُlِmْḥَt", "root": "حمل"}, {"id": 22, "arabic": "ٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 23, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 24, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 25, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 26, "arabic": "لَءَايَةً", "translit": "ًẗَyāَءَl", "root": "ايي"}, {"id": 27, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 28, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 29, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 30, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": false}, {"ayah": 249, "text": "فَلَمَّا فَصَلَ طَالُوتُ بِٱلْجُنُودِ قَالَ إِنَّ ٱللَّهَ مُبْتَلِيكُم بِنَهَرٍ فَمَن شَرِبَ مِنْهُ فَلَيْسَ مِنِّى وَمَن لَّمْ يَطْعَمْهُ فَإِنَّهُۥ مِنِّىٓ إِلَّا مَنِ ٱغْتَرَفَ غُرْفَةًۢ بِيَدِهِۦۚ فَشَرِبُوا۟ مِنْهُ إِلَّا قَلِيلًا مِّنْهُمْۚ فَلَمَّا جَاوَزَهُۥ هُوَ وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ قَالُوا۟ لَا طَاقَةَ لَنَا ٱلْيَوْمَ بِجَالُوتَ وَجُنُودِهِۦۚ قَالَ ٱلَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَٰقُوا۟ ٱللَّهِ كَم مِّن فِئَةٍ قَلِيلَةٍ غَلَبَتْ فِئَةً كَثِيرَةًۢ بِإِذْنِ ٱللَّهِۗ وَٱللَّهُ مَعَ ٱلصَّٰبِرِينَ ", "translation": "And when Saul went forth with the soldiers, he said, \"Indeed, Allāh will be testing you with a river. So whoever drinks from it is not of me, and whoever does not taste it is indeed of me, excepting one who takes [from it] in the hollow of his hand.\" But they drank from it, except a [very] few of them. Then when he had crossed it along with those who believed with him, they said, \"There is no power for us today against Goliath and his soldiers.\" But those who were certain that they would meet Allāh said, \"How many a small company has overcome a large company by permission of Allāh. And Allāh is with the patient.\"", "words": [{"id": 1, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 2, "arabic": "فَصَلَ", "translit": "َlَṣَf", "root": "فصل"}, {"id": 3, "arabic": "طَالُوتُ", "translit": "ُtwُlāَṭ", "root": ""}, {"id": 4, "arabic": "بِٱلْجُنُودِ", "translit": "ِdwُnُjgْlٱِb", "root": "جند"}, {"id": 5, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 6, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 7, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "مُبْتَلِيكُم", "translit": "mُkyِlَtْbُm", "root": "بلو"}, {"id": 9, "arabic": "بِنَهَرٍ", "translit": "ٍrَhَnِb", "root": "نهر"}, {"id": 10, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 11, "arabic": "شَرِبَ", "translit": "َbِrَhs", "root": "شرب"}, {"id": 12, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 13, "arabic": "فَلَيْسَ", "translit": "َsْyَlَf", "root": "ليس"}, {"id": 14, "arabic": "مِنِّى", "translit": "àِّnِm", "root": ""}, {"id": 15, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 16, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 17, "arabic": "يَطْعَمْهُ", "translit": "ُhْmَʿعْṭَy", "root": "طعم"}, {"id": 18, "arabic": "فَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَf", "root": ""}, {"id": 19, "arabic": "مِنِّىٓ", "translit": "ٓàِّnِm", "root": ""}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 22, "arabic": "ٱغْتَرَفَ", "translit": "َfَrَtْغٱ", "root": "غرف"}, {"id": 23, "arabic": "غُرْفَةًۢ", "translit": "ًۢẗَfْrُغ", "root": "غرف"}, {"id": 24, "arabic": "بِيَدِهِۦ", "translit": "ۦِhِdَyِb", "root": "يدي"}, {"id": 25, "arabic": "فَشَرِبُوا۟", "translit": "۟āwُbِrَhsَf", "root": "شرب"}, {"id": 26, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 27, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 28, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 29, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 30, "arabic": "فَلَمَّا", "translit": "āَّmَlَf", "root": ""}, {"id": 31, "arabic": "جَاوَزَهُۥ", "translit": "ۥُhَzَwāَjg", "root": "جوز"}, {"id": 32, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 33, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 34, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 35, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 36, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 37, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 38, "arabic": "طَاقَةَ", "translit": "َẗَqāَṭ", "root": "طوق"}, {"id": 39, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 40, "arabic": "ٱلْيَوْمَ", "translit": "َmْwَyْlٱ", "root": "يوم"}, {"id": 41, "arabic": "بِجَالُوتَ", "translit": "َtwُlāَjgِb", "root": ""}, {"id": 42, "arabic": "وَجُنُودِهِۦ", "translit": "ۦِhِdwُnُjgَw", "root": "جند"}, {"id": 43, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 44, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 45, "arabic": "يَظُنُّونَ", "translit": "َnwُّnُẓَy", "root": "ظنن"}, {"id": 46, "arabic": "أَنَّهُم", "translit": "mُhَّnَaʾ", "root": ""}, {"id": 47, "arabic": "مُّلَٰقُوا۟", "translit": "۟āwُqَٰlُّm", "root": "لقي"}, {"id": 48, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 49, "arabic": "كَم", "translit": "mَk", "root": ""}, {"id": 50, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 51, "arabic": "فِئَةٍ", "translit": "ٍẗَyʾِf", "root": "فاي"}, {"id": 52, "arabic": "قَلِيلَةٍ", "translit": "ٍẗَlyِlَq", "root": "قلل"}, {"id": 53, "arabic": "غَلَبَتْ", "translit": "ْtَbَlَغ", "root": "غلب"}, {"id": 54, "arabic": "فِئَةً", "translit": "ًẗَyʾِf", "root": "فاي"}, {"id": 55, "arabic": "كَثِيرَةًۢ", "translit": "ًۢẗَryِhtَk", "root": "كثر"}, {"id": 56, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 57, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 58, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 59, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 60, "arabic": "ٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱ", "root": "صبر"}], "hasIhya": true}, {"ayah": 250, "text": "وَلَمَّا بَرَزُوا۟ لِجَالُوتَ وَجُنُودِهِۦ قَالُوا۟ رَبَّنَآ أَفْرِغْ عَلَيْنَا صَبْرًا وَثَبِّتْ أَقْدَامَنَا وَٱنصُرْنَا عَلَى ٱلْقَوْمِ ٱلْكَٰفِرِينَ ", "translation": "And when they went forth to [face] Goliath and his soldiers, they said, \"Our Lord, pour upon us patience and plant firmly our feet and give us victory over the disbelieving people.\"", "words": [{"id": 1, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 2, "arabic": "بَرَزُوا۟", "translit": "۟āwُzَrَb", "root": "برز"}, {"id": 3, "arabic": "لِجَالُوتَ", "translit": "َtwُlāَjgِl", "root": ""}, {"id": 4, "arabic": "وَجُنُودِهِۦ", "translit": "ۦِhِdwُnُjgَw", "root": "جند"}, {"id": 5, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 6, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 7, "arabic": "أَفْرِغْ", "translit": "ْغِrْfَaʾ", "root": "فرغ"}, {"id": 8, "arabic": "عَلَيْنَا", "translit": "āَnْyَlَʿع", "root": ""}, {"id": 9, "arabic": "صَبْرًا", "translit": "āًrْbَṣ", "root": "صبر"}, {"id": 10, "arabic": "وَثَبِّتْ", "translit": "ْtِّbَhtَw", "root": "ثبت"}, {"id": 11, "arabic": "أَقْدَامَنَا", "translit": "āَnَmāَdْqَaʾ", "root": "قدم"}, {"id": 12, "arabic": "وَٱنصُرْنَا", "translit": "āَnْrُṣnٱَw", "root": "نصر"}, {"id": 13, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 14, "arabic": "ٱلْقَوْمِ", "translit": "ِmْwَqْlٱ", "root": "قوم"}, {"id": 15, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 251, "text": "فَهَزَمُوهُم بِإِذْنِ ٱللَّهِ وَقَتَلَ دَاوُۥدُ جَالُوتَ وَءَاتَىٰهُ ٱللَّهُ ٱلْمُلْكَ وَٱلْحِكْمَةَ وَعَلَّمَهُۥ مِمَّا يَشَآءُۗ وَلَوْلَا دَفْعُ ٱللَّهِ ٱلنَّاسَ بَعْضَهُم بِبَعْضٍ لَّفَسَدَتِ ٱلْأَرْضُ وَلَٰكِنَّ ٱللَّهَ ذُو فَضْلٍ عَلَى ٱلْعَٰلَمِينَ ", "translation": "So they defeated them by permission of Allāh, and David killed Goliath, and Allāh gave him the kingship and wisdom [i.e., prophethood] and taught him from that which He willed. And if it were not for Allāh checking [some] people by means of others, the earth would have been corrupted, but Allāh is the possessor of bounty for the worlds.", "words": [{"id": 1, "arabic": "فَهَزَمُوهُم", "translit": "mُhwُmَzَhَf", "root": "هزم"}, {"id": 2, "arabic": "بِإِذْنِ", "translit": "ِnْhdِiʾِb", "root": "اذن"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَقَتَلَ", "translit": "َlَtَqَw", "root": "قتل"}, {"id": 5, "arabic": "دَاوُۥدُ", "translit": "ُdۥُwāَd", "root": ""}, {"id": 6, "arabic": "جَالُوتَ", "translit": "َtwُlāَjg", "root": ""}, {"id": 7, "arabic": "وَءَاتَىٰهُ", "translit": "ُhٰàَtāَءَw", "root": "اتي"}, {"id": 8, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "ٱلْمُلْكَ", "translit": "َkْlُmْlٱ", "root": "ملك"}, {"id": 10, "arabic": "وَٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱَw", "root": "حكم"}, {"id": 11, "arabic": "وَعَلَّمَهُۥ", "translit": "ۥُhَmَّlَʿعَw", "root": "علم"}, {"id": 12, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 13, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 14, "arabic": "وَلَوْلَا", "translit": "āَlْwَlَw", "root": ""}, {"id": 15, "arabic": "دَفْعُ", "translit": "ُʿعْfَd", "root": "دفع"}, {"id": 16, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 18, "arabic": "بَعْضَهُم", "translit": "mُhَḍْʿعَb", "root": "بعض"}, {"id": 19, "arabic": "بِبَعْضٍ", "translit": "ٍḍْʿعَbِb", "root": "بعض"}, {"id": 20, "arabic": "لَّفَسَدَتِ", "translit": "ِtَdَsَfَّl", "root": "فسد"}, {"id": 21, "arabic": "ٱلْأَرْضُ", "translit": "ُḍْrَaʾْlٱ", "root": "ارض"}, {"id": 22, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 23, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 25, "arabic": "فَضْلٍ", "translit": "ٍlْḍَf", "root": "فضل"}, {"id": 26, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 27, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 252, "text": "تِلْكَ ءَايَٰتُ ٱللَّهِ نَتْلُوهَا عَلَيْكَ بِٱلْحَقِّۚ وَإِنَّكَ لَمِنَ ٱلْمُرْسَلِينَ ", "translation": "These are the verses of Allāh which We recite to you, [O Muḥammad], in truth. And indeed, you are from among the messengers.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "ءَايَٰتُ", "translit": "ُtَٰyāَء", "root": "ايي"}, {"id": 3, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "نَتْلُوهَا", "translit": "āَhwُlْtَn", "root": "تلو"}, {"id": 5, "arabic": "عَلَيْكَ", "translit": "َkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 7, "arabic": "وَإِنَّكَ", "translit": "َkَّnِiʾَw", "root": ""}, {"id": 8, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 9, "arabic": "ٱلْمُرْسَلِينَ", "translit": "َnyِlَsْrُmْlٱ", "root": "رسل"}], "hasIhya": false}, {"ayah": 253, "text": "تِلْكَ ٱلرُّسُلُ فَضَّلْنَا بَعْضَهُمْ عَلَىٰ بَعْضٍۘ مِّنْهُم مَّن كَلَّمَ ٱللَّهُۖ وَرَفَعَ بَعْضَهُمْ دَرَجَٰتٍۚ وَءَاتَيْنَا عِيسَى ٱبْنَ مَرْيَمَ ٱلْبَيِّنَٰتِ وَأَيَّدْنَٰهُ بِرُوحِ ٱلْقُدُسِۗ وَلَوْ شَآءَ ٱللَّهُ مَا ٱقْتَتَلَ ٱلَّذِينَ مِنۢ بَعْدِهِم مِّنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَٰتُ وَلَٰكِنِ ٱخْتَلَفُوا۟ فَمِنْهُم مَّنْ ءَامَنَ وَمِنْهُم مَّن كَفَرَۚ وَلَوْ شَآءَ ٱللَّهُ مَا ٱقْتَتَلُوا۟ وَلَٰكِنَّ ٱللَّهَ يَفْعَلُ مَا يُرِيدُ ", "translation": "Those messengers - some of them We caused to exceed others. Among them were those to whom Allāh spoke, and He raised some of them in degree. And We gave Jesus, the son of Mary, clear proofs, and We supported him with the Pure Spirit [i.e., Gabriel]. If Allāh had willed, those [generations] succeeding them would not have fought each other after the clear proofs had come to them. But they differed, and some of them believed and some of them disbelieved. And if Allāh had willed, they would not have fought each other, but Allāh does what He intends.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "ٱلرُّسُلُ", "translit": "ُlُsُّrlٱ", "root": "رسل"}, {"id": 3, "arabic": "فَضَّلْنَا", "translit": "āَnْlَّḍَf", "root": "فضل"}, {"id": 4, "arabic": "بَعْضَهُمْ", "translit": "ْmُhَḍْʿعَb", "root": "بعض"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 7, "arabic": "مِّنْهُم", "translit": "mُhْnِّm", "root": ""}, {"id": 8, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 9, "arabic": "كَلَّمَ", "translit": "َmَّlَk", "root": "كلم"}, {"id": 10, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَرَفَعَ", "translit": "َʿعَfَrَw", "root": "رفع"}, {"id": 12, "arabic": "بَعْضَهُمْ", "translit": "ْmُhَḍْʿعَb", "root": "بعض"}, {"id": 13, "arabic": "دَرَجَٰتٍ", "translit": "ٍtَٰjgَrَd", "root": "درج"}, {"id": 14, "arabic": "وَءَاتَيْنَا", "translit": "āَnْyَtāَءَw", "root": "اتي"}, {"id": 15, "arabic": "عِيسَى", "translit": "àَsyِʿع", "root": ""}, {"id": 16, "arabic": "ٱبْنَ", "translit": "َnْbٱ", "root": "بني"}, {"id": 17, "arabic": "مَرْيَمَ", "translit": "َmَyْrَm", "root": ""}, {"id": 18, "arabic": "ٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱ", "root": "بين"}, {"id": 19, "arabic": "وَأَيَّدْنَٰهُ", "translit": "ُhَٰnْdَّyَaʾَw", "root": "ايد"}, {"id": 20, "arabic": "بِرُوحِ", "translit": "ِḥwُrِb", "root": "روح"}, {"id": 21, "arabic": "ٱلْقُدُسِ", "translit": "ِsُdُqْlٱ", "root": "قدس"}, {"id": 22, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 23, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 24, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 26, "arabic": "ٱقْتَتَلَ", "translit": "َlَtَtْqٱ", "root": "قتل"}, {"id": 27, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 28, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 29, "arabic": "بَعْدِهِم", "translit": "mِhِdْʿعَb", "root": "بعد"}, {"id": 30, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 31, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 32, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 33, "arabic": "جَآءَتْهُمُ", "translit": "ُmُhْtَءٓāَjg", "root": "جيا"}, {"id": 34, "arabic": "ٱلْبَيِّنَٰتُ", "translit": "ُtَٰnِّyَbْlٱ", "root": "بين"}, {"id": 35, "arabic": "وَلَٰكِنِ", "translit": "ِnِkَٰlَw", "root": ""}, {"id": 36, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 37, "arabic": "فَمِنْهُم", "translit": "mُhْnِmَf", "root": ""}, {"id": 38, "arabic": "مَّنْ", "translit": "ْnَّm", "root": ""}, {"id": 39, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 40, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 41, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 42, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 43, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 44, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 45, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 46, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 47, "arabic": "ٱقْتَتَلُوا۟", "translit": "۟āwُlَtَtْqٱ", "root": "قتل"}, {"id": 48, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 49, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 50, "arabic": "يَفْعَلُ", "translit": "ُlَʿعْfَy", "root": "فعل"}, {"id": 51, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 52, "arabic": "يُرِيدُ", "translit": "ُdyِrُy", "root": "رود"}], "hasIhya": true}, {"ayah": 254, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ أَنفِقُوا۟ مِمَّا رَزَقْنَٰكُم مِّن قَبْلِ أَن يَأْتِىَ يَوْمٌ لَّا بَيْعٌ فِيهِ وَلَا خُلَّةٌ وَلَا شَفَٰعَةٌۗ وَٱلْكَٰفِرُونَ هُمُ ٱلظَّٰلِمُونَ ", "translation": "O you who have believed, spend from that which We have provided for you before there comes a Day in which there is no exchange [i.e., ransom] and no friendship and no intercession. And the disbelievers - they are the wrongdoers.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "أَنفِقُوا۟", "translit": "۟āwُqِfnَaʾ", "root": "نفق"}, {"id": 5, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 6, "arabic": "رَزَقْنَٰكُم", "translit": "mُkَٰnْqَzَr", "root": "رزق"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "قَبْلِ", "translit": "ِlْbَq", "root": "قبل"}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يَأْتِىَ", "translit": "َàِtْaʾَy", "root": "اتي"}, {"id": 11, "arabic": "يَوْمٌ", "translit": "ٌmْwَy", "root": "يوم"}, {"id": 12, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 13, "arabic": "بَيْعٌ", "translit": "ٌʿعْyَb", "root": "بيع"}, {"id": 14, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "خُلَّةٌ", "translit": "ٌẗَّlُhk", "root": "خلل"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "شَفَٰعَةٌ", "translit": "ٌẗَʿعَٰfَhs", "root": "شفع"}, {"id": 19, "arabic": "وَٱلْكَٰفِرُونَ", "translit": "َnwُrِfَٰkْlٱَw", "root": "كفر"}, {"id": 20, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 21, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 255, "text": "ٱللَّهُ لَآ إِلَٰهَ إِلَّا هُوَ ٱلْحَىُّ ٱلْقَيُّومُۚ لَا تَأْخُذُهُۥ سِنَةٌ وَلَا نَوْمٌۚ لَّهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَمَا فِى ٱلْأَرْضِۗ مَن ذَا ٱلَّذِى يَشْفَعُ عِندَهُۥٓ إِلَّا بِإِذْنِهِۦۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْۖ وَلَا يُحِيطُونَ بِشَىْءٍ مِّنْ عِلْمِهِۦٓ إِلَّا بِمَا شَآءَۚ وَسِعَ كُرْسِيُّهُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَۖ وَلَا يَـُٔودُهُۥ حِفْظُهُمَاۚ وَهُوَ ٱلْعَلِىُّ ٱلْعَظِيمُ ", "translation": "Allāh - there is no deity except Him, the Ever-Living,[1] the Self-Sustaining.[2] Neither drowsiness overtakes Him nor sleep. To Him belongs whatever is in the heavens and whatever is on the earth. Who is it that can intercede with Him except by His permission? He knows what is [presently] before them and what will be after them,[3] and they encompass not a thing of His knowledge except for what He wills. His Kursī[4] extends over the heavens and the earth, and their preservation tires Him not. And He is the Most High,[5] the Most Great.[6]", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 3, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 4, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "ٱلْحَىُّ", "translit": "ُّàَḥْlٱ", "root": "حيي"}, {"id": 7, "arabic": "ٱلْقَيُّومُ", "translit": "ُmwُّyَqْlٱ", "root": "قوم"}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "تَأْخُذُهُۥ", "translit": "ۥُhُhdُhkْaʾَt", "root": "اخذ"}, {"id": 10, "arabic": "سِنَةٌ", "translit": "ٌẗَnِs", "root": "وسن"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "نَوْمٌ", "translit": "ٌmْwَn", "root": "نوم"}, {"id": 13, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 17, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 18, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 19, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 20, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 21, "arabic": "ذَا", "translit": "āَhd", "root": ""}, {"id": 22, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 23, "arabic": "يَشْفَعُ", "translit": "ُʿعَfْhsَy", "root": "شفع"}, {"id": 24, "arabic": "عِندَهُۥٓ", "translit": "ٓۥُhَdnِʿع", "root": "عند"}, {"id": 25, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 26, "arabic": "بِإِذْنِهِۦ", "translit": "ۦِhِnْhdِiʾِb", "root": "اذن"}, {"id": 27, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 28, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 29, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 30, "arabic": "أَيْدِيهِمْ", "translit": "ْmِhyِdْyَaʾ", "root": "يدي"}, {"id": 31, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 32, "arabic": "خَلْفَهُمْ", "translit": "ْmُhَfْlَhk", "root": "خلف"}, {"id": 33, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 34, "arabic": "يُحِيطُونَ", "translit": "َnwُṭyِḥُy", "root": "حوط"}, {"id": 35, "arabic": "بِشَىْءٍ", "translit": "ٍءْàَhsِb", "root": "شيا"}, {"id": 36, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 37, "arabic": "عِلْمِهِۦٓ", "translit": "ٓۦِhِmْlِʿع", "root": "علم"}, {"id": 38, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 39, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 40, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 41, "arabic": "وَسِعَ", "translit": "َʿعِsَw", "root": "وسع"}, {"id": 42, "arabic": "كُرْسِيُّهُ", "translit": "ُhُّyِsْrُk", "root": "كرس"}, {"id": 43, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 44, "arabic": "وَٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 45, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 46, "arabic": "يَـُٔودُهُۥ", "translit": "ۥُhُdwُٔـَy", "root": "اود"}, {"id": 47, "arabic": "حِفْظُهُمَا", "translit": "āَmُhُẓْfِḥ", "root": "حفظ"}, {"id": 48, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 49, "arabic": "ٱلْعَلِىُّ", "translit": "ُّàِlَʿعْlٱ", "root": "علو"}, {"id": 50, "arabic": "ٱلْعَظِيمُ", "translit": "ُmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": true}, {"ayah": 256, "text": "لَآ إِكْرَاهَ فِى ٱلدِّينِۖ قَد تَّبَيَّنَ ٱلرُّشْدُ مِنَ ٱلْغَىِّۚ فَمَن يَكْفُرْ بِٱلطَّٰغُوتِ وَيُؤْمِنۢ بِٱللَّهِ فَقَدِ ٱسْتَمْسَكَ بِٱلْعُرْوَةِ ٱلْوُثْقَىٰ لَا ٱنفِصَامَ لَهَاۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ ", "translation": "There shall be no compulsion in [acceptance of] the religion. The right course has become distinct from the wrong. So whoever disbelieves in ṭāghūt[1] and believes in Allāh has grasped the most trustworthy handhold with no break in it. And Allāh is Hearing and Knowing.", "words": [{"id": 1, "arabic": "لَآ", "translit": "ٓāَl", "root": ""}, {"id": 2, "arabic": "إِكْرَاهَ", "translit": "َhāَrْkِiʾ", "root": "كره"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱلدِّينِ", "translit": "ِnyِّdlٱ", "root": "دين"}, {"id": 5, "arabic": "قَد", "translit": "dَq", "root": ""}, {"id": 6, "arabic": "تَّبَيَّنَ", "translit": "َnَّyَbَّt", "root": "بين"}, {"id": 7, "arabic": "ٱلرُّشْدُ", "translit": "ُdْhsُّrlٱ", "root": "رشد"}, {"id": 8, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 9, "arabic": "ٱلْغَىِّ", "translit": "ِّàَغْlٱ", "root": "غوي"}, {"id": 10, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 11, "arabic": "يَكْفُرْ", "translit": "ْrُfْkَy", "root": "كفر"}, {"id": 12, "arabic": "بِٱلطَّٰغُوتِ", "translit": "ِtwُغَّٰṭlٱِb", "root": "طغي"}, {"id": 13, "arabic": "وَيُؤْمِنۢ", "translit": "ۢnِmْwʾُyَw", "root": "امن"}, {"id": 14, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 15, "arabic": "فَقَدِ", "translit": "ِdَqَf", "root": ""}, {"id": 16, "arabic": "ٱسْتَمْسَكَ", "translit": "َkَsْmَtْsٱ", "root": "مسك"}, {"id": 17, "arabic": "بِٱلْعُرْوَةِ", "translit": "ِẗَwْrُʿعْlٱِb", "root": "عرو"}, {"id": 18, "arabic": "ٱلْوُثْقَىٰ", "translit": "ٰàَqْhtُwْlٱ", "root": "وثق"}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "ٱنفِصَامَ", "translit": "َmāَṣِfnٱ", "root": "فصم"}, {"id": 21, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 24, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 257, "text": "ٱللَّهُ وَلِىُّ ٱلَّذِينَ ءَامَنُوا۟ يُخْرِجُهُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِۖ وَٱلَّذِينَ كَفَرُوٓا۟ أَوْلِيَآؤُهُمُ ٱلطَّٰغُوتُ يُخْرِجُونَهُم مِّنَ ٱلنُّورِ إِلَى ٱلظُّلُمَٰتِۗ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "Allāh is the Ally[1] of those who believe. He brings them out from darknesses into the light. And those who disbelieve - their allies are ṭāghūt. They take them out of the light into darknesses.[2] Those are the companions of the Fire; they will abide eternally therein.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "وَلِىُّ", "translit": "ُّàِlَw", "root": "ولي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "يُخْرِجُهُم", "translit": "mُhُjgِrْhkُy", "root": "خرج"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱلظُّلُمَٰتِ", "translit": "ِtَٰmُlُّẓlٱ", "root": "ظلم"}, {"id": 8, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلنُّورِ", "translit": "ِrwُّnlٱ", "root": "نور"}, {"id": 10, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 11, "arabic": "كَفَرُوٓا۟", "translit": "۟āٓwُrَfَk", "root": "كفر"}, {"id": 12, "arabic": "أَوْلِيَآؤُهُمُ", "translit": "ُmُhُwʾٓāَyِlْwَaʾ", "root": "ولي"}, {"id": 13, "arabic": "ٱلطَّٰغُوتُ", "translit": "ُtwُغَّٰṭlٱ", "root": "طغي"}, {"id": 14, "arabic": "يُخْرِجُونَهُم", "translit": "mُhَnwُjgِrْhkُy", "root": "خرج"}, {"id": 15, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 16, "arabic": "ٱلنُّورِ", "translit": "ِrwُّnlٱ", "root": "نور"}, {"id": 17, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 18, "arabic": "ٱلظُّلُمَٰتِ", "translit": "ِtَٰmُlُّẓlٱ", "root": "ظلم"}, {"id": 19, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 20, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 21, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 22, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 23, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 24, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": true}, {"ayah": 258, "text": "أَلَمْ تَرَ إِلَى ٱلَّذِى حَآجَّ إِبْرَٰهِۦمَ فِى رَبِّهِۦٓ أَنْ ءَاتَىٰهُ ٱللَّهُ ٱلْمُلْكَ إِذْ قَالَ إِبْرَٰهِۦمُ رَبِّىَ ٱلَّذِى يُحْىِۦ وَيُمِيتُ قَالَ أَنَا۠ أُحْىِۦ وَأُمِيتُۖ قَالَ إِبْرَٰهِۦمُ فَإِنَّ ٱللَّهَ يَأْتِى بِٱلشَّمْسِ مِنَ ٱلْمَشْرِقِ فَأْتِ بِهَا مِنَ ٱلْمَغْرِبِ فَبُهِتَ ٱلَّذِى كَفَرَۗ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّٰلِمِينَ ", "translation": "Have you not considered the one who argued with Abraham about his Lord [merely] because Allāh had given him kingship? When Abraham said, \"My Lord is the one who gives life and causes death,\" he said, \"I give life and cause death.\" Abraham said, \"Indeed, Allāh brings up the sun from the east, so bring it up from the west.\" So the disbeliever was overwhelmed [by astonishment], and Allāh does not guide the wrongdoing people.", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَرَ", "translit": "َrَt", "root": "راي"}, {"id": 3, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 5, "arabic": "حَآجَّ", "translit": "َّjgٓāَḥ", "root": "حجج"}, {"id": 6, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "رَبِّهِۦٓ", "translit": "ٓۦِhِّbَr", "root": "ربب"}, {"id": 9, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 10, "arabic": "ءَاتَىٰهُ", "translit": "ُhٰàَtāَء", "root": "اتي"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "ٱلْمُلْكَ", "translit": "َkْlُmْlٱ", "root": "ملك"}, {"id": 13, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 14, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 15, "arabic": "إِبْرَٰهِۦمُ", "translit": "ُmۦِhَٰrْbِiʾ", "root": ""}, {"id": 16, "arabic": "رَبِّىَ", "translit": "َàِّbَr", "root": "ربب"}, {"id": 17, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 18, "arabic": "يُحْىِۦ", "translit": "ۦِàْḥُy", "root": "حيي"}, {"id": 19, "arabic": "وَيُمِيتُ", "translit": "ُtyِmُyَw", "root": "موت"}, {"id": 20, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 21, "arabic": "أَنَا۠", "translit": "۠āَnَaʾ", "root": ""}, {"id": 22, "arabic": "أُحْىِۦ", "translit": "ۦِàْḥُaʾ", "root": "حيي"}, {"id": 23, "arabic": "وَأُمِيتُ", "translit": "ُtyِmُaʾَw", "root": "موت"}, {"id": 24, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 25, "arabic": "إِبْرَٰهِۦمُ", "translit": "ُmۦِhَٰrْbِiʾ", "root": ""}, {"id": 26, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 27, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "يَأْتِى", "translit": "àِtْaʾَy", "root": "اتي"}, {"id": 29, "arabic": "بِٱلشَّمْسِ", "translit": "ِsْmَّhslٱِb", "root": "شمس"}, {"id": 30, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 31, "arabic": "ٱلْمَشْرِقِ", "translit": "ِqِrْhsَmْlٱ", "root": "شرق"}, {"id": 32, "arabic": "فَأْتِ", "translit": "ِtْaʾَf", "root": "اتي"}, {"id": 33, "arabic": "بِهَا", "translit": "āَhِb", "root": ""}, {"id": 34, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 35, "arabic": "ٱلْمَغْرِبِ", "translit": "ِbِrْغَmْlٱ", "root": "غرب"}, {"id": 36, "arabic": "فَبُهِتَ", "translit": "َtِhُbَf", "root": "بهت"}, {"id": 37, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 38, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 39, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 40, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 41, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 42, "arabic": "ٱلْقَوْمَ", "translit": "َmْwَqْlٱ", "root": "قوم"}, {"id": 43, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 259, "text": "أَوْ كَٱلَّذِى مَرَّ عَلَىٰ قَرْيَةٍ وَهِىَ خَاوِيَةٌ عَلَىٰ عُرُوشِهَا قَالَ أَنَّىٰ يُحْىِۦ هَٰذِهِ ٱللَّهُ بَعْدَ مَوْتِهَاۖ فَأَمَاتَهُ ٱللَّهُ مِا۟ئَةَ عَامٍ ثُمَّ بَعَثَهُۥۖ قَالَ كَمْ لَبِثْتَۖ قَالَ لَبِثْتُ يَوْمًا أَوْ بَعْضَ يَوْمٍۖ قَالَ بَل لَّبِثْتَ مِا۟ئَةَ عَامٍ فَٱنظُرْ إِلَىٰ طَعَامِكَ وَشَرَابِكَ لَمْ يَتَسَنَّهْۖ وَٱنظُرْ إِلَىٰ حِمَارِكَ وَلِنَجْعَلَكَ ءَايَةً لِّلنَّاسِۖ وَٱنظُرْ إِلَى ٱلْعِظَامِ كَيْفَ نُنشِزُهَا ثُمَّ نَكْسُوهَا لَحْمًاۚ فَلَمَّا تَبَيَّنَ لَهُۥ قَالَ أَعْلَمُ أَنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Or [consider such an example] as the one who passed by a township which had fallen into ruin. He said, \"How will Allāh bring this to life after its death?\" So Allāh caused him to die for a hundred years; then He revived him. He said, \"How long have you remained?\" He [the man] said, \"I have remained a day or part of a day.\" He said, \"Rather, you have remained one hundred years. Look at your food and your drink; it has not changed with time. And look at your donkey; and We will make you a sign for the people. And look at the bones [of this donkey] - how We raise them and then We cover them with flesh.\" And when it became clear to him, he said, \"I know that Allāh is over all things competent.\"", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "كَٱلَّذِى", "translit": "àِhdَّlٱَk", "root": ""}, {"id": 3, "arabic": "مَرَّ", "translit": "َّrَm", "root": "مرر"}, {"id": 4, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 5, "arabic": "قَرْيَةٍ", "translit": "ٍẗَyْrَq", "root": "قري"}, {"id": 6, "arabic": "وَهِىَ", "translit": "َàِhَw", "root": ""}, {"id": 7, "arabic": "خَاوِيَةٌ", "translit": "ٌẗَyِwāَhk", "root": "خوي"}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "عُرُوشِهَا", "translit": "āَhِhswُrُʿع", "root": "عرش"}, {"id": 10, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 11, "arabic": "أَنَّىٰ", "translit": "ٰàَّnَaʾ", "root": ""}, {"id": 12, "arabic": "يُحْىِۦ", "translit": "ۦِàْḥُy", "root": "حيي"}, {"id": 13, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 16, "arabic": "مَوْتِهَا", "translit": "āَhِtْwَm", "root": "موت"}, {"id": 17, "arabic": "فَأَمَاتَهُ", "translit": "ُhَtāَmَaʾَf", "root": "موت"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "مِا۟ئَةَ", "translit": "َẗَyʾ۟āِm", "root": "ماي"}, {"id": 20, "arabic": "عَامٍ", "translit": "ٍmāَʿع", "root": "عوم"}, {"id": 21, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 22, "arabic": "بَعَثَهُۥ", "translit": "ۥُhَhtَʿعَb", "root": "بعث"}, {"id": 23, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 24, "arabic": "كَمْ", "translit": "ْmَk", "root": ""}, {"id": 25, "arabic": "لَبِثْتَ", "translit": "َtْhtِbَl", "root": "لبث"}, {"id": 26, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 27, "arabic": "لَبِثْتُ", "translit": "ُtْhtِbَl", "root": "لبث"}, {"id": 28, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 29, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 30, "arabic": "بَعْضَ", "translit": "َḍْʿعَb", "root": "بعض"}, {"id": 31, "arabic": "يَوْمٍ", "translit": "ٍmْwَy", "root": "يوم"}, {"id": 32, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 33, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 34, "arabic": "لَّبِثْتَ", "translit": "َtْhtِbَّl", "root": "لبث"}, {"id": 35, "arabic": "مِا۟ئَةَ", "translit": "َẗَyʾ۟āِm", "root": "ماي"}, {"id": 36, "arabic": "عَامٍ", "translit": "ٍmāَʿع", "root": "عوم"}, {"id": 37, "arabic": "فَٱنظُرْ", "translit": "ْrُẓnٱَf", "root": "نظر"}, {"id": 38, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 39, "arabic": "طَعَامِكَ", "translit": "َkِmāَʿعَṭ", "root": "طعم"}, {"id": 40, "arabic": "وَشَرَابِكَ", "translit": "َkِbāَrَhsَw", "root": "شرب"}, {"id": 41, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 42, "arabic": "يَتَسَنَّهْ", "translit": "ْhَّnَsَtَy", "root": "سنه"}, {"id": 43, "arabic": "وَٱنظُرْ", "translit": "ْrُẓnٱَw", "root": "نظر"}, {"id": 44, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 45, "arabic": "حِمَارِكَ", "translit": "َkِrāَmِḥ", "root": "حمر"}, {"id": 46, "arabic": "وَلِنَجْعَلَكَ", "tr