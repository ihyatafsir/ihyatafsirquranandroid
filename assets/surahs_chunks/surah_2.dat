{"surah": 2, "verses": [{"ayah": 1, "text": "الٓمٓ ", "translation": "Alif, Lām, Meem.[1]", "words": [{"id": 1, "arabic": "الٓمٓ", "translit": "ٓmٓlā", "root": ""}], "hasIhya": false}, {"ayah": 2, "text": "ذَٰلِكَ ٱلْكِتَٰبُ لَا رَيْبَۛ فِيهِۛ هُدًى لِّلْمُتَّقِينَ ", "translation": "This is the Book about which there is no doubt, a guidance for those conscious of Allāh[1] -", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "ٱلْكِتَٰبُ", "translit": "ُbَٰtِkْlٱ", "root": "كتب"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "رَيْبَ", "translit": "َbْyَr", "root": "ريب"}, {"id": 5, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 6, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 7, "arabic": "لِّلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِّl", "root": "وقي"}], "hasIhya": false}, {"ayah": 3, "text": "ٱلَّذِينَ يُؤْمِنُونَ بِٱلْغَيْبِ وَيُقِيمُونَ ٱلصَّلَوٰةَ وَمِمَّا رَزَقْنَٰهُمْ يُنفِقُونَ ", "translation": "Who believe in the unseen, establish prayer,[1] and spend out of what We[2] have provided for them,", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 3, "arabic": "بِٱلْغَيْبِ", "translit": "ِbْyَغْlٱِb", "root": "غيب"}, {"id": 4, "arabic": "وَيُقِيمُونَ", "translit": "َnwُmyِqُyَw", "root": "قوم"}, {"id": 5, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 6, "arabic": "وَمِمَّا", "translit": "āَّmِmَw", "root": ""}, {"id": 7, "arabic": "رَزَقْنَٰهُمْ", "translit": "ْmُhَٰnْqَzَr", "root": "رزق"}, {"id": 8, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}], "hasIhya": false}, {"ayah": 4, "text": "وَٱلَّذِينَ يُؤْمِنُونَ بِمَآ أُنزِلَ إِلَيْكَ وَمَآ أُنزِلَ مِن قَبْلِكَ وَبِٱلْءَاخِرَةِ هُمْ يُوقِنُونَ ", "translation": "And who believe in what has been revealed to you, [O Muḥammad], and what was revealed before you, and of the Hereafter they are certain [in faith].", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 3, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 4, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 5, "arabic": "إِلَيْكَ", "translit": "َkْyَlِiʾ", "root": ""}, {"id": 6, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 7, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قَبْلِكَ", "translit": "َkِlْbَq", "root": "قبل"}, {"id": 10, "arabic": "وَبِٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱِbَw", "root": "اخر"}, {"id": 11, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 12, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": false}, {"ayah": 5, "text": "أُو۟لَٰٓئِكَ عَلَىٰ هُدًى مِّن رَّبِّهِمْۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُفْلِحُونَ ", "translation": "Those are upon [right] guidance from their Lord, and it is those who are the successful.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 3, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 7, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 8, "arabic": "ٱلْمُفْلِحُونَ", "translit": "َnwُḥِlْfُmْlٱ", "root": "فلح"}], "hasIhya": false}, {"ayah": 6, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ سَوَآءٌ عَلَيْهِمْ ءَأَنذَرْتَهُمْ أَمْ لَمْ تُنذِرْهُمْ لَا يُؤْمِنُونَ ", "translation": "Indeed, those who disbelieve[1] - it is all the same for them whether you warn them or do not warn them - they will not believe.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "سَوَآءٌ", "translit": "ٌءٓāَwَs", "root": "سوي"}, {"id": 5, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ءَأَنذَرْتَهُمْ", "translit": "ْmُhَtْrَhdnَaʾَء", "root": "نذر"}, {"id": 7, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 8, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 9, "arabic": "تُنذِرْهُمْ", "translit": "ْmُhْrِhdnُt", "root": "نذر"}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}], "hasIhya": false}, {"ayah": 7, "text": "خَتَمَ ٱللَّهُ عَلَىٰ قُلُوبِهِمْ وَعَلَىٰ سَمْعِهِمْۖ وَعَلَىٰٓ أَبْصَٰرِهِمْ غِشَٰوَةٌۖ وَلَهُمْ عَذَابٌ عَظِيمٌ ", "translation": "Allāh has set a seal upon their hearts and upon their hearing, and over their vision is a veil.[1] And for them is a great punishment.", "words": [{"id": 1, "arabic": "خَتَمَ", "translit": "َmَtَhk", "root": "ختم"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 4, "arabic": "قُلُوبِهِمْ", "translit": "ْmِhِbwُlُq", "root": "قلب"}, {"id": 5, "arabic": "وَعَلَىٰ", "translit": "ٰàَlَʿعَw", "root": ""}, {"id": 6, "arabic": "سَمْعِهِمْ", "translit": "ْmِhِʿعْmَs", "root": "سمع"}, {"id": 7, "arabic": "وَعَلَىٰٓ", "translit": "ٰٓàَlَʿعَw", "root": ""}, {"id": 8, "arabic": "أَبْصَٰرِهِمْ", "translit": "ْmِhِrَٰṣْbَaʾ", "root": "بصر"}, {"id": 9, "arabic": "غِشَٰوَةٌ", "translit": "ٌẗَwَٰhsِغ", "root": "غشو"}, {"id": 10, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 8, "text": "وَمِنَ ٱلنَّاسِ مَن يَقُولُ ءَامَنَّا بِٱللَّهِ وَبِٱلْيَوْمِ ٱلْءَاخِرِ وَمَا هُم بِمُؤْمِنِينَ ", "translation": "And of the people are some who say, \"We believe in Allāh and the Last Day,\" but they are not believers.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 5, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 6, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 7, "arabic": "وَبِٱلْيَوْمِ", "translit": "ِmْwَyْlٱِbَw", "root": "يوم"}, {"id": 8, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 11, "arabic": "بِمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmِb", "root": "امن"}], "hasIhya": false}, {"ayah": 9, "text": "يُخَٰدِعُونَ ٱللَّهَ وَٱلَّذِينَ ءَامَنُوا۟ وَمَا يَخْدَعُونَ إِلَّآ أَنفُسَهُمْ وَمَا يَشْعُرُونَ ", "translation": "They [think to] deceive Allāh and those who believe, but they deceive not except themselves and perceive [it] not.", "words": [{"id": 1, "arabic": "يُخَٰدِعُونَ", "translit": "َnwُʿعِdَٰhkُy", "root": "خدع"}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "يَخْدَعُونَ", "translit": "َnwُʿعَdْhkَy", "root": "خدع"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 10, "text": "فِى قُلُوبِهِم مَّرَضٌ فَزَادَهُمُ ٱللَّهُ مَرَضًاۖ وَلَهُمْ عَذَابٌ أَلِيمٌۢ بِمَا كَانُوا۟ يَكْذِبُونَ ", "translation": "In their hearts is disease, so Allāh has increased their disease;[1] and for them is a painful punishment because they [habitually] used to lie.", "words": [{"id": 1, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 2, "arabic": "قُلُوبِهِم", "translit": "mِhِbwُlُq", "root": "قلب"}, {"id": 3, "arabic": "مَّرَضٌ", "translit": "ٌḍَrَّm", "root": "مرض"}, {"id": 4, "arabic": "فَزَادَهُمُ", "translit": "ُmُhَdāَzَf", "root": "زيد"}, {"id": 5, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "مَرَضًا", "translit": "āًḍَrَm", "root": "مرض"}, {"id": 7, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 8, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 9, "arabic": "أَلِيمٌۢ", "translit": "ٌۢmyِlَaʾ", "root": "الم"}, {"id": 10, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "يَكْذِبُونَ", "translit": "َnwُbِhdْkَy", "root": "كذب"}], "hasIhya": false}, {"ayah": 11, "text": "وَإِذَا قِيلَ لَهُمْ لَا تُفْسِدُوا۟ فِى ٱلْأَرْضِ قَالُوٓا۟ إِنَّمَا نَحْنُ مُصْلِحُونَ ", "translation": "And when it is said to them, \"Do not cause corruption on the earth,\" they say, \"We are but reformers.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تُفْسِدُوا۟", "translit": "۟āwُdِsْfُt", "root": "فسد"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 9, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 10, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 11, "arabic": "مُصْلِحُونَ", "translit": "َnwُḥِlْṣُm", "root": "صلح"}], "hasIhya": false}, {"ayah": 12, "text": "أَلَآ إِنَّهُمْ هُمُ ٱلْمُفْسِدُونَ وَلَٰكِن لَّا يَشْعُرُونَ ", "translation": "Unquestionably, it is they who are the corrupters, but they perceive [it] not.", "words": [{"id": 1, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 2, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 3, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 4, "arabic": "ٱلْمُفْسِدُونَ", "translit": "َnwُdِsْfُmْlٱ", "root": "فسد"}, {"id": 5, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 6, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 7, "arabic": "يَشْعُرُونَ", "translit": "َnwُrُʿعْhsَy", "root": "شعر"}], "hasIhya": false}, {"ayah": 13, "text": "وَإِذَا قِيلَ لَهُمْ ءَامِنُوا۟ كَمَآ ءَامَنَ ٱلنَّاسُ قَالُوٓا۟ أَنُؤْمِنُ كَمَآ ءَامَنَ ٱلسُّفَهَآءُۗ أَلَآ إِنَّهُمْ هُمُ ٱلسُّفَهَآءُ وَلَٰكِن لَّا يَعْلَمُونَ ", "translation": "And when it is said to them, \"Believe as the people have believed,\" they say, \"Should we believe as the foolish have believed?\" Unquestionably, it is they who are the foolish, but they know [it] not.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 4, "arabic": "ءَامِنُوا۟", "translit": "۟āwُnِmāَء", "root": "امن"}, {"id": 5, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 6, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 7, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 8, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 9, "arabic": "أَنُؤْمِنُ", "translit": "ُnِmْwʾُnَaʾ", "root": "امن"}, {"id": 10, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 11, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 12, "arabic": "ٱلسُّفَهَآءُ", "translit": "ُءٓāَhَfُّslٱ", "root": "سفه"}, {"id": 13, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 14, "arabic": "إِنَّهُمْ", "translit": "ْmُhَّnِiʾ", "root": ""}, {"id": 15, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 16, "arabic": "ٱلسُّفَهَآءُ", "translit": "ُءٓāَhَfُّslٱ", "root": "سفه"}, {"id": 17, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 18, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 19, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 14, "text": "وَإِذَا لَقُوا۟ ٱلَّذِينَ ءَامَنُوا۟ قَالُوٓا۟ ءَامَنَّا وَإِذَا خَلَوْا۟ إِلَىٰ شَيَٰطِينِهِمْ قَالُوٓا۟ إِنَّا مَعَكُمْ إِنَّمَا نَحْنُ مُسْتَهْزِءُونَ ", "translation": "And when they meet those who believe, they say, \"We believe\"; but when they are alone with their evil ones, they say, \"Indeed, we are with you; we were only mockers.\"", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "لَقُوا۟", "translit": "۟āwُqَl", "root": "لقي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 5, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 6, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 7, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 8, "arabic": "خَلَوْا۟", "translit": "۟āْwَlَhk", "root": "خلو"}, {"id": 9, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 10, "arabic": "شَيَٰطِينِهِمْ", "translit": "ْmِhِnyِṭَٰyَhs", "root": "شطن"}, {"id": 11, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 12, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 13, "arabic": "مَعَكُمْ", "translit": "ْmُkَʿعَm", "root": ""}, {"id": 14, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 15, "arabic": "نَحْنُ", "translit": "ُnْḥَn", "root": ""}, {"id": 16, "arabic": "مُسْتَهْزِءُونَ", "translit": "َnwُءِzْhَtْsُm", "root": "هزا"}], "hasIhya": false}, {"ayah": 15, "text": "ٱللَّهُ يَسْتَهْزِئُ بِهِمْ وَيَمُدُّهُمْ فِى طُغْيَٰنِهِمْ يَعْمَهُونَ ", "translation": "[But] Allāh mocks them and prolongs them in their transgression [while] they wander blindly.", "words": [{"id": 1, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 2, "arabic": "يَسْتَهْزِئُ", "translit": "ُyʾِzْhَtْsَy", "root": "هزا"}, {"id": 3, "arabic": "بِهِمْ", "translit": "ْmِhِb", "root": ""}, {"id": 4, "arabic": "وَيَمُدُّهُمْ", "translit": "ْmُhُّdُmَyَw", "root": "مدد"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "طُغْيَٰنِهِمْ", "translit": "ْmِhِnَٰyْغُṭ", "root": "طغي"}, {"id": 7, "arabic": "يَعْمَهُونَ", "translit": "َnwُhَmْʿعَy", "root": "عمه"}], "hasIhya": false}, {"ayah": 16, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلضَّلَٰلَةَ بِٱلْهُدَىٰ فَمَا رَبِحَت تِّجَٰرَتُهُمْ وَمَا كَانُوا۟ مُهْتَدِينَ ", "translation": "Those are the ones who have purchased error [in exchange] for guidance, so their transaction has brought no profit, nor were they guided.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱشْتَرَوُا۟", "translit": "۟āُwَrَtْhsٱ", "root": "شري"}, {"id": 4, "arabic": "ٱلضَّلَٰلَةَ", "translit": "َẗَlَٰlَّḍlٱ", "root": "ضلل"}, {"id": 5, "arabic": "بِٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱِb", "root": "هدي"}, {"id": 6, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 7, "arabic": "رَبِحَت", "translit": "tَḥِbَr", "root": "ربح"}, {"id": 8, "arabic": "تِّجَٰرَتُهُمْ", "translit": "ْmُhُtَrَٰjgِّt", "root": "تجر"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 11, "arabic": "مُهْتَدِينَ", "translit": "َnyِdَtْhُm", "root": "هدي"}], "hasIhya": true}, {"ayah": 17, "text": "مَثَلُهُمْ كَمَثَلِ ٱلَّذِى ٱسْتَوْقَدَ نَارًا فَلَمَّآ أَضَآءَتْ مَا حَوْلَهُۥ ذَهَبَ ٱللَّهُ بِنُورِهِمْ وَتَرَكَهُمْ فِى ظُلُمَٰتٍ لَّا يُبْصِرُونَ ", "translation": "Their example is that of one who kindled a fire, but when it illuminated what was around him, Allāh took away their light and left them in darkness [so] they could not see.", "words": [{"id": 1, "arabic": "مَثَلُهُمْ", "translit": "ْmُhُlَhtَm", "root": "مثل"}, {"id": 2, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 3, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ٱسْتَوْقَدَ", "translit": "َdَqْwَtْsٱ", "root": "وقد"}, {"id": 5, "arabic": "نَارًا", "translit": "āًrāَn", "root": "نور"}, {"id": 6, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 7, "arabic": "أَضَآءَتْ", "translit": "ْtَءٓāَḍَaʾ", "root": "ضوا"}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "حَوْلَهُۥ", "translit": "ۥُhَlْwَḥ", "root": "حول"}, {"id": 10, "arabic": "ذَهَبَ", "translit": "َbَhَhd", "root": "ذهب"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "بِنُورِهِمْ", "translit": "ْmِhِrwُnِb", "root": "نور"}, {"id": 13, "arabic": "وَتَرَكَهُمْ", "translit": "ْmُhَkَrَtَw", "root": "ترك"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ظُلُمَٰتٍ", "translit": "ٍtَٰmُlُẓ", "root": "ظلم"}, {"id": 16, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 17, "arabic": "يُبْصِرُونَ", "translit": "َnwُrِṣْbُy", "root": "بصر"}], "hasIhya": false}, {"ayah": 18, "text": "صُمٌّۢ بُكْمٌ عُمْىٌ فَهُمْ لَا يَرْجِعُونَ ", "translation": "Deaf, dumb and blind - so they will not return [to the right path].", "words": [{"id": 1, "arabic": "صُمٌّۢ", "translit": "ٌّۢmُṣ", "root": "صمم"}, {"id": 2, "arabic": "بُكْمٌ", "translit": "ٌmْkُb", "root": "بكم"}, {"id": 3, "arabic": "عُمْىٌ", "translit": "ٌàْmُʿع", "root": "عمي"}, {"id": 4, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 5, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 6, "arabic": "يَرْجِعُونَ", "translit": "َnwُʿعِjgْrَy", "root": "رجع"}], "hasIhya": false}, {"ayah": 19, "text": "أَوْ كَصَيِّبٍ مِّنَ ٱلسَّمَآءِ فِيهِ ظُلُمَٰتٌ وَرَعْدٌ وَبَرْقٌ يَجْعَلُونَ أَصَٰبِعَهُمْ فِىٓ ءَاذَانِهِم مِّنَ ٱلصَّوَٰعِقِ حَذَرَ ٱلْمَوْتِۚ وَٱللَّهُ مُحِيطٌۢ بِٱلْكَٰفِرِينَ ", "translation": "Or [it is] like a rainstorm from the sky within which is darkness, thunder and lightning. They put their fingers in their ears against the thunderclaps in dread of death. But Allāh is encompassing[1] of the disbelievers.", "words": [{"id": 1, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 2, "arabic": "كَصَيِّبٍ", "translit": "ٍbِّyَṣَk", "root": "صوب"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 6, "arabic": "ظُلُمَٰتٌ", "translit": "ٌtَٰmُlُẓ", "root": "ظلم"}, {"id": 7, "arabic": "وَرَعْدٌ", "translit": "ٌdْʿعَrَw", "root": "رعد"}, {"id": 8, "arabic": "وَبَرْقٌ", "translit": "ٌqْrَbَw", "root": "برق"}, {"id": 9, "arabic": "يَجْعَلُونَ", "translit": "َnwُlَʿعْjgَy", "root": "جعل"}, {"id": 10, "arabic": "أَصَٰبِعَهُمْ", "translit": "ْmُhَʿعِbَٰṣَaʾ", "root": "صبع"}, {"id": 11, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 12, "arabic": "ءَاذَانِهِم", "translit": "mِhِnāَhdāَء", "root": "اذن"}, {"id": 13, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 14, "arabic": "ٱلصَّوَٰعِقِ", "translit": "ِqِʿعَٰwَّṣlٱ", "root": "صعق"}, {"id": 15, "arabic": "حَذَرَ", "translit": "َrَhdَḥ", "root": "حذر"}, {"id": 16, "arabic": "ٱلْمَوْتِ", "translit": "ِtْwَmْlٱ", "root": "موت"}, {"id": 17, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 18, "arabic": "مُحِيطٌۢ", "translit": "ٌۢṭyِḥُm", "root": "حوط"}, {"id": 19, "arabic": "بِٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱِb", "root": "كفر"}], "hasIhya": false}, {"ayah": 20, "text": "يَكَادُ ٱلْبَرْقُ يَخْطَفُ أَبْصَٰرَهُمْۖ كُلَّمَآ أَضَآءَ لَهُم مَّشَوْا۟ فِيهِ وَإِذَآ أَظْلَمَ عَلَيْهِمْ قَامُوا۟ۚ وَلَوْ شَآءَ ٱللَّهُ لَذَهَبَ بِسَمْعِهِمْ وَأَبْصَٰرِهِمْۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "The lightning almost snatches away their sight. Every time it lights [the way] for them, they walk therein; but when darkness comes over them, they stand [still]. And if Allāh had willed, He could have taken away their hearing and their sight. Indeed, Allāh is over all things competent.", "words": [{"id": 1, "arabic": "يَكَادُ", "translit": "ُdāَkَy", "root": "كود"}, {"id": 2, "arabic": "ٱلْبَرْقُ", "translit": "ُqْrَbْlٱ", "root": "برق"}, {"id": 3, "arabic": "يَخْطَفُ", "translit": "ُfَṭْhkَy", "root": "خطف"}, {"id": 4, "arabic": "أَبْصَٰرَهُمْ", "translit": "ْmُhَrَٰṣْbَaʾ", "root": "بصر"}, {"id": 5, "arabic": "كُلَّمَآ", "translit": "ٓāَmَّlُk", "root": "كلل"}, {"id": 6, "arabic": "أَضَآءَ", "translit": "َءٓāَḍَaʾ", "root": "ضوا"}, {"id": 7, "arabic": "لَهُم", "translit": "mُhَl", "root": ""}, {"id": 8, "arabic": "مَّشَوْا۟", "translit": "۟āْwَhsَّm", "root": "مشي"}, {"id": 9, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 10, "arabic": "وَإِذَآ", "translit": "ٓāَhdِiʾَw", "root": ""}, {"id": 11, "arabic": "أَظْلَمَ", "translit": "َmَlْẓَaʾ", "root": "ظلم"}, {"id": 12, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "قَامُوا۟", "translit": "۟āwُmāَq", "root": "قوم"}, {"id": 14, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 15, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "لَذَهَبَ", "translit": "َbَhَhdَl", "root": "ذهب"}, {"id": 18, "arabic": "بِسَمْعِهِمْ", "translit": "ْmِhِʿعْmَsِb", "root": "سمع"}, {"id": 19, "arabic": "وَأَبْصَٰرِهِمْ", "translit": "ْmِhِrَٰṣْbَaʾَw", "root": "بصر"}, {"id": 20, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 21, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 23, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 24, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 25, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 21, "text": "يَٰٓأَيُّهَا ٱلنَّاسُ ٱعْبُدُوا۟ رَبَّكُمُ ٱلَّذِى خَلَقَكُمْ وَٱلَّذِينَ مِن قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ ", "translation": "O mankind, worship your Lord, who created you and those before you, that you may become righteous -", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "ٱعْبُدُوا۟", "translit": "۟āwُdُbْʿعٱ", "root": "عبد"}, {"id": 4, "arabic": "رَبَّكُمُ", "translit": "ُmُkَّbَr", "root": "ربب"}, {"id": 5, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "خَلَقَكُمْ", "translit": "ْmُkَqَlَhk", "root": "خلق"}, {"id": 7, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 10, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 11, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": false}, {"ayah": 22, "text": "ٱلَّذِى جَعَلَ لَكُمُ ٱلْأَرْضَ فِرَٰشًا وَٱلسَّمَآءَ بِنَآءً وَأَنزَلَ مِنَ ٱلسَّمَآءِ مَآءً فَأَخْرَجَ بِهِۦ مِنَ ٱلثَّمَرَٰتِ رِزْقًا لَّكُمْۖ فَلَا تَجْعَلُوا۟ لِلَّهِ أَندَادًا وَأَنتُمْ تَعْلَمُونَ ", "translation": "[He] who made for you the earth a bed [spread out] and the sky a ceiling and sent down from the sky, rain and brought forth thereby fruits as provision for you. So do not attribute to Allāh equals while you know [that there is nothing similar to Him].", "words": [{"id": 1, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "جَعَلَ", "translit": "َlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 4, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 5, "arabic": "فِرَٰشًا", "translit": "āًhsَٰrِf", "root": "فرش"}, {"id": 6, "arabic": "وَٱلسَّمَآءَ", "translit": "َءٓāَmَّslٱَw", "root": "سمو"}, {"id": 7, "arabic": "بِنَآءً", "translit": "ًءٓāَnِb", "root": "بني"}, {"id": 8, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 11, "arabic": "مَآءً", "translit": "ًءٓāَm", "root": "موه"}, {"id": 12, "arabic": "فَأَخْرَجَ", "translit": "َjgَrْhkَaʾَf", "root": "خرج"}, {"id": 13, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱ", "root": "ثمر"}, {"id": 16, "arabic": "رِزْقًا", "translit": "āًqْzِr", "root": "رزق"}, {"id": 17, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 18, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 19, "arabic": "تَجْعَلُوا۟", "translit": "۟āwُlَʿعْjgَt", "root": "جعل"}, {"id": 20, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 21, "arabic": "أَندَادًا", "translit": "āًdāَdnَaʾ", "root": "ندد"}, {"id": 22, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 23, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 23, "text": "وَإِن كُنتُمْ فِى رَيْبٍ مِّمَّا نَزَّلْنَا عَلَىٰ عَبْدِنَا فَأْتُوا۟ بِسُورَةٍ مِّن مِّثْلِهِۦ وَٱدْعُوا۟ شُهَدَآءَكُم مِّن دُونِ ٱللَّهِ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And if you are in doubt about what We have sent down [i.e., the Qur’ān] upon Our Servant [i.e., Prophet Muḥammad (ﷺ)], then produce a sūrah the like thereof and call upon your witnesses [i.e., supporters] other than Allāh, if you should be truthful.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "رَيْبٍ", "translit": "ٍbْyَr", "root": "ريب"}, {"id": 5, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 6, "arabic": "نَزَّلْنَا", "translit": "āَnْlَّzَn", "root": "نزل"}, {"id": 7, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 8, "arabic": "عَبْدِنَا", "translit": "āَnِdْbَʿع", "root": "عبد"}, {"id": 9, "arabic": "فَأْتُوا۟", "translit": "۟āwُtْaʾَf", "root": "اتي"}, {"id": 10, "arabic": "بِسُورَةٍ", "translit": "ٍẗَrwُsِb", "root": "سور"}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "مِّثْلِهِۦ", "translit": "ۦِhِlْhtِّm", "root": "مثل"}, {"id": 13, "arabic": "وَٱدْعُوا۟", "translit": "۟āwُʿعْdٱَw", "root": "دعو"}, {"id": 14, "arabic": "شُهَدَآءَكُم", "translit": "mُkَءٓāَdَhُhs", "root": "شهد"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 17, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 19, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 20, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": true}, {"ayah": 24, "text": "فَإِن لَّمْ تَفْعَلُوا۟ وَلَن تَفْعَلُوا۟ فَٱتَّقُوا۟ ٱلنَّارَ ٱلَّتِى وَقُودُهَا ٱلنَّاسُ وَٱلْحِجَارَةُۖ أُعِدَّتْ لِلْكَٰفِرِينَ ", "translation": "But if you do not - and you will never be able to - then fear the Fire, whose fuel is people and stones, prepared for the disbelievers.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 3, "arabic": "تَفْعَلُوا۟", "translit": "۟āwُlَʿعْfَt", "root": "فعل"}, {"id": 4, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 5, "arabic": "تَفْعَلُوا۟", "translit": "۟āwُlَʿعْfَt", "root": "فعل"}, {"id": 6, "arabic": "فَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَf", "root": "وقي"}, {"id": 7, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 8, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 9, "arabic": "وَقُودُهَا", "translit": "āَhُdwُqَw", "root": "وقد"}, {"id": 10, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 11, "arabic": "وَٱلْحِجَارَةُ", "translit": "ُẗَrāَjgِḥْlٱَw", "root": "حجر"}, {"id": 12, "arabic": "أُعِدَّتْ", "translit": "ْtَّdِʿعُaʾ", "root": "عدد"}, {"id": 13, "arabic": "لِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِl", "root": "كفر"}], "hasIhya": false}, {"ayah": 25, "text": "وَبَشِّرِ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ أَنَّ لَهُمْ جَنَّٰتٍ تَجْرِى مِن تَحْتِهَا ٱلْأَنْهَٰرُۖ كُلَّمَا رُزِقُوا۟ مِنْهَا مِن ثَمَرَةٍ رِّزْقًاۙ قَالُوا۟ هَٰذَا ٱلَّذِى رُزِقْنَا مِن قَبْلُۖ وَأُتُوا۟ بِهِۦ مُتَشَٰبِهًاۖ وَلَهُمْ فِيهَآ أَزْوَٰجٌ مُّطَهَّرَةٌۖ وَهُمْ فِيهَا خَٰلِدُونَ ", "translation": "And give good tidings to those who believe and do righteous deeds that they will have gardens [in Paradise] beneath which rivers flow. Whenever they are provided with a provision of fruit therefrom, they will say, \"This is what we were provided with before.\" And it is given to them in likeness. And they will have therein purified spouses, and they will abide therein eternally.", "words": [{"id": 1, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 7, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 8, "arabic": "جَنَّٰتٍ", "translit": "ٍtَّٰnَjg", "root": "جنن"}, {"id": 9, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 10, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 11, "arabic": "تَحْتِهَا", "translit": "āَhِtْḥَt", "root": "تحت"}, {"id": 12, "arabic": "ٱلْأَنْهَٰرُ", "translit": "ُrَٰhْnَaʾْlٱ", "root": "نهر"}, {"id": 13, "arabic": "كُلَّمَا", "translit": "āَmَّlُk", "root": "كلل"}, {"id": 14, "arabic": "رُزِقُوا۟", "translit": "۟āwُqِzُr", "root": "رزق"}, {"id": 15, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 16, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 17, "arabic": "ثَمَرَةٍ", "translit": "ٍẗَrَmَht", "root": "ثمر"}, {"id": 18, "arabic": "رِّزْقًا", "translit": "āًqْzِّr", "root": "رزق"}, {"id": 19, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 20, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 21, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 22, "arabic": "رُزِقْنَا", "translit": "āَnْqِzُr", "root": "رزق"}, {"id": 23, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 24, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 25, "arabic": "وَأُتُوا۟", "translit": "۟āwُtُaʾَw", "root": "اتي"}, {"id": 26, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 27, "arabic": "مُتَشَٰبِهًا", "translit": "āًhِbَٰhsَtُm", "root": "شبه"}, {"id": 28, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 29, "arabic": "فِيهَآ", "translit": "ٓāَhyِf", "root": ""}, {"id": 30, "arabic": "أَزْوَٰجٌ", "translit": "ٌjgَٰwْzَaʾ", "root": "زوج"}, {"id": 31, "arabic": "مُّطَهَّرَةٌ", "translit": "ٌẗَrَّhَṭُّm", "root": "طهر"}, {"id": 32, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 33, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 34, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": true}, {"ayah": 26, "text": "إِنَّ ٱللَّهَ لَا يَسْتَحْىِۦٓ أَن يَضْرِبَ مَثَلًا مَّا بَعُوضَةً فَمَا فَوْقَهَاۚ فَأَمَّا ٱلَّذِينَ ءَامَنُوا۟ فَيَعْلَمُونَ أَنَّهُ ٱلْحَقُّ مِن رَّبِّهِمْۖ وَأَمَّا ٱلَّذِينَ كَفَرُوا۟ فَيَقُولُونَ مَاذَآ أَرَادَ ٱللَّهُ بِهَٰذَا مَثَلاًۘ يُضِلُّ بِهِۦ كَثِيرًا وَيَهْدِى بِهِۦ كَثِيرًاۚ وَمَا يُضِلُّ بِهِۦٓ إِلَّا ٱلْفَٰسِقِينَ ", "translation": "Indeed, Allāh is not timid to present an example - that of a mosquito or what is smaller[1] than it. And those who have believed know that it is the truth from their Lord. But as for those who disbelieve, they say, \"What did Allāh intend by this as an example?\" He misleads many thereby and guides many thereby. And He misleads not except the defiantly disobedient,", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَسْتَحْىِۦٓ", "translit": "ٓۦِàْḥَtْsَy", "root": "حيي"}, {"id": 5, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 6, "arabic": "يَضْرِبَ", "translit": "َbِrْḍَy", "root": "ضرب"}, {"id": 7, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "بَعُوضَةً", "translit": "ًẗَḍwُʿعَb", "root": "بعض"}, {"id": 10, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 11, "arabic": "فَوْقَهَا", "translit": "āَhَqْwَf", "root": "فوق"}, {"id": 12, "arabic": "فَأَمَّا", "translit": "āَّmَaʾَf", "root": ""}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 15, "arabic": "فَيَعْلَمُونَ", "translit": "َnwُmَlْʿعَyَf", "root": "علم"}, {"id": 16, "arabic": "أَنَّهُ", "translit": "ُhَّnَaʾ", "root": ""}, {"id": 17, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 18, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 19, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 20, "arabic": "وَأَمَّا", "translit": "āَّmَaʾَw", "root": ""}, {"id": 21, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 22, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 23, "arabic": "فَيَقُولُونَ", "translit": "َnwُlwُqَyَf", "root": "قول"}, {"id": 24, "arabic": "مَاذَآ", "translit": "ٓāَhdāَm", "root": ""}, {"id": 25, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 26, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "بِهَٰذَا", "translit": "āَhdَٰhِb", "root": ""}, {"id": 28, "arabic": "مَثَلًا", "translit": "āًlَhtَm", "root": "مثل"}, {"id": 29, "arabic": "يُضِلُّ", "translit": "ُّlِḍُy", "root": "ضلل"}, {"id": 30, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 31, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 32, "arabic": "وَيَهْدِى", "translit": "àِdْhَyَw", "root": "هدي"}, {"id": 33, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 34, "arabic": "كَثِيرًا", "translit": "āًryِhtَk", "root": "كثر"}, {"id": 35, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 36, "arabic": "يُضِلُّ", "translit": "ُّlِḍُy", "root": "ضلل"}, {"id": 37, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 38, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 39, "arabic": "ٱلْفَٰسِقِينَ", "translit": "َnyِqِsَٰfْlٱ", "root": "فسق"}], "hasIhya": true}, {"ayah": 27, "text": "ٱلَّذِينَ يَنقُضُونَ عَهْدَ ٱللَّهِ مِنۢ بَعْدِ مِيثَٰقِهِۦ وَيَقْطَعُونَ مَآ أَمَرَ ٱللَّهُ بِهِۦٓ أَن يُوصَلَ وَيُفْسِدُونَ فِى ٱلْأَرْضِۚ أُو۟لَٰٓئِكَ هُمُ ٱلْخَٰسِرُونَ ", "translation": "Who break the covenant of Allāh after contracting it and sever that which Allāh has ordered to be joined and cause corruption on earth. It is those who are the losers.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَنقُضُونَ", "translit": "َnwُḍُqnَy", "root": "نقض"}, {"id": 3, "arabic": "عَهْدَ", "translit": "َdْhَʿع", "root": "عهد"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 6, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 7, "arabic": "مِيثَٰقِهِۦ", "translit": "ۦِhِqَٰhtyِm", "root": "وثق"}, {"id": 8, "arabic": "وَيَقْطَعُونَ", "translit": "َnwُʿعَṭْqَyَw", "root": "قطع"}, {"id": 9, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 10, "arabic": "أَمَرَ", "translit": "َrَmَaʾ", "root": "امر"}, {"id": 11, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 13, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 14, "arabic": "يُوصَلَ", "translit": "َlَṣwُy", "root": "وصل"}, {"id": 15, "arabic": "وَيُفْسِدُونَ", "translit": "َnwُdِsْfُyَw", "root": "فسد"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 18, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 19, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 20, "arabic": "ٱلْخَٰسِرُونَ", "translit": "َnwُrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": true}, {"ayah": 28, "text": "كَيْفَ تَكْفُرُونَ بِٱللَّهِ وَكُنتُمْ أَمْوَٰتًا فَأَحْيَٰكُمْۖ ثُمَّ يُمِيتُكُمْ ثُمَّ يُحْيِيكُمْ ثُمَّ إِلَيْهِ تُرْجَعُونَ ", "translation": "How can you disbelieve in Allāh when you were lifeless and He brought you to life; then He will cause you to die, then He will bring you [back] to life, and then to Him you will be returned.", "words": [{"id": 1, "arabic": "كَيْفَ", "translit": "َfْyَk", "root": "كيف"}, {"id": 2, "arabic": "تَكْفُرُونَ", "translit": "َnwُrُfْkَt", "root": "كفر"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "وَكُنتُمْ", "translit": "ْmُtnُkَw", "root": "كون"}, {"id": 5, "arabic": "أَمْوَٰتًا", "translit": "āًtَٰwْmَaʾ", "root": "موت"}, {"id": 6, "arabic": "فَأَحْيَٰكُمْ", "translit": "ْmُkَٰyْḥَaʾَf", "root": "حيي"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "يُمِيتُكُمْ", "translit": "ْmُkُtyِmُy", "root": "موت"}, {"id": 9, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 10, "arabic": "يُحْيِيكُمْ", "translit": "ْmُkyِyْḥُy", "root": "حيي"}, {"id": 11, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 12, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 13, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}], "hasIhya": false}, {"ayah": 29, "text": "هُوَ ٱلَّذِى خَلَقَ لَكُم مَّا فِى ٱلْأَرْضِ جَمِيعًا ثُمَّ ٱسْتَوَىٰٓ إِلَى ٱلسَّمَآءِ فَسَوَّىٰهُنَّ سَبْعَ سَمَٰوَٰتٍۚ وَهُوَ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "It is He who created for you all of that which is on the earth. Then He directed Himself[1] to the heaven, [His being above all creation], and made them seven heavens, and He is Knowing of all things.", "words": [{"id": 1, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 2, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 4, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 5, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 8, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 9, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 10, "arabic": "ٱسْتَوَىٰٓ", "translit": "ٰٓàَwَtْsٱ", "root": "سوي"}, {"id": 11, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 12, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 13, "arabic": "فَسَوَّىٰهُنَّ", "translit": "َّnُhٰàَّwَsَf", "root": "سوي"}, {"id": 14, "arabic": "سَبْعَ", "translit": "َʿعْbَs", "root": "سبع"}, {"id": 15, "arabic": "سَمَٰوَٰتٍ", "translit": "ٍtَٰwَٰmَs", "root": "سمو"}, {"id": 16, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 17, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 30, "text": "وَإِذْ قَالَ رَبُّكَ لِلْمَلَٰٓئِكَةِ إِنِّى جَاعِلٌ فِى ٱلْأَرْضِ خَلِيفَةًۖ قَالُوٓا۟ أَتَجْعَلُ فِيهَا مَن يُفْسِدُ فِيهَا وَيَسْفِكُ ٱلدِّمَآءَ وَنَحْنُ نُسَبِّحُ بِحَمْدِكَ وَنُقَدِّسُ لَكَۖ قَالَ إِنِّىٓ أَعْلَمُ مَا لَا تَعْلَمُونَ ", "translation": "And [mention, O Muḥammad], when your Lord said to the angels, \"Indeed, I will make upon the earth a successive authority.\"[1] They said, \"Will You place upon it one who causes corruption therein and sheds blood, while we exalt You with praise and declare Your perfection?\"[2] He [Allāh] said, \"Indeed, I know that which you do not know.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "رَبُّكَ", "translit": "َkُّbَr", "root": "ربب"}, {"id": 4, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlِl", "root": "ملك"}, {"id": 5, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 6, "arabic": "جَاعِلٌ", "translit": "ٌlِʿعāَjg", "root": "جعل"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 9, "arabic": "خَلِيفَةً", "translit": "ًẗَfyِlَhk", "root": "خلف"}, {"id": 10, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 11, "arabic": "أَتَجْعَلُ", "translit": "ُlَʿعْjgَtَaʾ", "root": "جعل"}, {"id": 12, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 13, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 14, "arabic": "يُفْسِدُ", "translit": "ُdِsْfُy", "root": "فسد"}, {"id": 15, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 16, "arabic": "وَيَسْفِكُ", "translit": "ُkِfْsَyَw", "root": "سفك"}, {"id": 17, "arabic": "ٱلدِّمَآءَ", "translit": "َءٓāَmِّdlٱ", "root": "دمو"}, {"id": 18, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 19, "arabic": "نُسَبِّحُ", "translit": "ُḥِّbَsُn", "root": "سبح"}, {"id": 20, "arabic": "بِحَمْدِكَ", "translit": "َkِdْmَḥِb", "root": "حمد"}, {"id": 21, "arabic": "وَنُقَدِّسُ", "translit": "ُsِّdَqُnَw", "root": "قدس"}, {"id": 22, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 23, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 24, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 25, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 26, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 27, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 28, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 31, "text": "وَعَلَّمَ ءَادَمَ ٱلْأَسْمَآءَ كُلَّهَا ثُمَّ عَرَضَهُمْ عَلَى ٱلْمَلَٰٓئِكَةِ فَقَالَ أَنۢبِـُٔونِى بِأَسْمَآءِ هَٰٓؤُلَآءِ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And He taught Adam the names - all of them. Then He showed them to the angels and said, \"Inform Me of the names of these, if you are truthful.\"", "words": [{"id": 1, "arabic": "وَعَلَّمَ", "translit": "َmَّlَʿعَw", "root": "علم"}, {"id": 2, "arabic": "ءَادَمَ", "translit": "َmَdāَء", "root": "ادم"}, {"id": 3, "arabic": "ٱلْأَسْمَآءَ", "translit": "َءٓāَmْsَaʾْlٱ", "root": "سمو"}, {"id": 4, "arabic": "كُلَّهَا", "translit": "āَhَّlُk", "root": "كلل"}, {"id": 5, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 6, "arabic": "عَرَضَهُمْ", "translit": "ْmُhَḍَrَʿع", "root": "عرض"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlٱ", "root": "ملك"}, {"id": 9, "arabic": "فَقَالَ", "translit": "َlāَqَf", "root": "قول"}, {"id": 10, "arabic": "أَنۢبِـُٔونِى", "translit": "àِnwُٔـِbۢnَaʾ", "root": "نبا"}, {"id": 11, "arabic": "بِأَسْمَآءِ", "translit": "ِءٓāَmْsَaʾِb", "root": "سمو"}, {"id": 12, "arabic": "هَٰٓؤُلَآءِ", "translit": "ِءٓāَlُwʾَٰٓh", "root": ""}, {"id": 13, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 14, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 15, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 32, "text": "قَالُوا۟ سُبْحَٰنَكَ لَا عِلْمَ لَنَآ إِلَّا مَا عَلَّمْتَنَآۖ إِنَّكَ أَنتَ ٱلْعَلِيمُ ٱلْحَكِيمُ ", "translation": "They said, \"Exalted are You; we have no knowledge except what You have taught us. Indeed, it is You who is the Knowing,[1] the Wise.\"[2]", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "سُبْحَٰنَكَ", "translit": "َkَnَٰḥْbُs", "root": "سبح"}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "عِلْمَ", "translit": "َmْlِʿع", "root": "علم"}, {"id": 5, "arabic": "لَنَآ", "translit": "ٓāَnَl", "root": ""}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "عَلَّمْتَنَآ", "translit": "ٓāَnَtْmَّlَʿع", "root": "علم"}, {"id": 9, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 10, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 11, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}, {"id": 12, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": true}, {"ayah": 33, "text": "قَالَ يَٰٓـَٔادَمُ أَنۢبِئْهُم بِأَسْمَآئِهِمْۖ فَلَمَّآ أَنۢبَأَهُم بِأَسْمَآئِهِمْ قَالَ أَلَمْ أَقُل لَّكُمْ إِنِّىٓ أَعْلَمُ غَيْبَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَأَعْلَمُ مَا تُبْدُونَ وَمَا كُنتُمْ تَكْتُمُونَ ", "translation": "He said, \"O Adam, inform them of their names.\" And when he had informed them of their names, He said, \"Did I not tell you that I know the unseen [aspects] of the heavens and the earth? And I know what you reveal and what you have concealed.\"", "words": [{"id": 1, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 2, "arabic": "يَٰٓـَٔادَمُ", "translit": "ُmَdāَٔـَٰٓy", "root": "ادم"}, {"id": 3, "arabic": "أَنۢبِئْهُم", "translit": "mُhْyʾِbۢnَaʾ", "root": "نبا"}, {"id": 4, "arabic": "بِأَسْمَآئِهِمْ", "translit": "ْmِhِyʾٓāَmْsَaʾِb", "root": "سمو"}, {"id": 5, "arabic": "فَلَمَّآ", "translit": "ٓāَّmَlَf", "root": ""}, {"id": 6, "arabic": "أَنۢبَأَهُم", "translit": "mُhَaʾَbۢnَaʾ", "root": "نبا"}, {"id": 7, "arabic": "بِأَسْمَآئِهِمْ", "translit": "ْmِhِyʾٓāَmْsَaʾِb", "root": "سمو"}, {"id": 8, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 9, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 10, "arabic": "أَقُل", "translit": "lُqَaʾ", "root": "قول"}, {"id": 11, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 12, "arabic": "إِنِّىٓ", "translit": "ٓàِّnِiʾ", "root": ""}, {"id": 13, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 14, "arabic": "غَيْبَ", "translit": "َbْyَغ", "root": "غيب"}, {"id": 15, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 16, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 17, "arabic": "وَأَعْلَمُ", "translit": "ُmَlْʿعَaʾَw", "root": "علم"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "تُبْدُونَ", "translit": "َnwُdْbُt", "root": "بدو"}, {"id": 20, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 21, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 22, "arabic": "تَكْتُمُونَ", "translit": "َnwُmُtْkَt", "root": "كتم"}], "hasIhya": false}, {"ayah": 34, "text": "وَإِذْ قُلْنَا لِلْمَلَٰٓئِكَةِ ٱسْجُدُوا۟ لِءَادَمَ فَسَجَدُوٓا۟ إِلَّآ إِبْلِيسَ أَبَىٰ وَٱسْتَكْبَرَ وَكَانَ مِنَ ٱلْكَٰفِرِينَ ", "translation": "And [mention] when We said to the angels, \"Prostrate before Adam\"; so they prostrated, except for Iblees.[1] He refused and was arrogant and became of the disbelievers.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 3, "arabic": "لِلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlِl", "root": "ملك"}, {"id": 4, "arabic": "ٱسْجُدُوا۟", "translit": "۟āwُdُjgْsٱ", "root": "سجد"}, {"id": 5, "arabic": "لِءَادَمَ", "translit": "َmَdāَءِl", "root": "ادم"}, {"id": 6, "arabic": "فَسَجَدُوٓا۟", "translit": "۟āٓwُdَjgَsَf", "root": "سجد"}, {"id": 7, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 8, "arabic": "إِبْلِيسَ", "translit": "َsyِlْbِiʾ", "root": ""}, {"id": 9, "arabic": "أَبَىٰ", "translit": "ٰàَbَaʾ", "root": "ابي"}, {"id": 10, "arabic": "وَٱسْتَكْبَرَ", "translit": "َrَbْkَtْsٱَw", "root": "كبر"}, {"id": 11, "arabic": "وَكَانَ", "translit": "َnāَkَw", "root": "كون"}, {"id": 12, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 13, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": true}, {"ayah": 35, "text": "وَقُلْنَا يَٰٓـَٔادَمُ ٱسْكُنْ أَنتَ وَزَوْجُكَ ٱلْجَنَّةَ وَكُلَا مِنْهَا رَغَدًا حَيْثُ شِئْتُمَا وَلَا تَقْرَبَا هَٰذِهِ ٱلشَّجَرَةَ فَتَكُونَا مِنَ ٱلظَّٰلِمِينَ ", "translation": "And We said, \"O Adam, dwell, you and your wife, in Paradise and eat therefrom in [ease and] abundance from wherever you will. But do not approach this tree, lest you be among the wrongdoers.\"", "words": [{"id": 1, "arabic": "وَقُلْنَا", "translit": "āَnْlُqَw", "root": "قول"}, {"id": 2, "arabic": "يَٰٓـَٔادَمُ", "translit": "ُmَdāَٔـَٰٓy", "root": "ادم"}, {"id": 3, "arabic": "ٱسْكُنْ", "translit": "ْnُkْsٱ", "root": "سكن"}, {"id": 4, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 5, "arabic": "وَزَوْجُكَ", "translit": "َkُjgْwَzَw", "root": "زوج"}, {"id": 6, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 7, "arabic": "وَكُلَا", "translit": "āَlُkَw", "root": "اكل"}, {"id": 8, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 9, "arabic": "رَغَدًا", "translit": "āًdَغَr", "root": "رغد"}, {"id": 10, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 11, "arabic": "شِئْتُمَا", "translit": "āَmُtْyʾِhs", "root": "شيا"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "تَقْرَبَا", "translit": "āَbَrْqَt", "root": "قرب"}, {"id": 14, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 15, "arabic": "ٱلشَّجَرَةَ", "translit": "َẗَrَjgَّhslٱ", "root": "شجر"}, {"id": 16, "arabic": "فَتَكُونَا", "translit": "āَnwُkَtَf", "root": "كون"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 36, "text": "فَأَزَلَّهُمَا ٱلشَّيْطَٰنُ عَنْهَا فَأَخْرَجَهُمَا مِمَّا كَانَا فِيهِۖ وَقُلْنَا ٱهْبِطُوا۟ بَعْضُكُمْ لِبَعْضٍ عَدُوٌّۖ وَلَكُمْ فِى ٱلْأَرْضِ مُسْتَقَرٌّ وَمَتَٰعٌ إِلَىٰ حِينٍ ", "translation": "But Satan caused them to slip out of it and removed them from that [condition] in which they had been. And We said, \"Go down, [all of you], as enemies to one another, and you will have upon the earth a place of settlement and provision for a time.\"", "words": [{"id": 1, "arabic": "فَأَزَلَّهُمَا", "translit": "āَmُhَّlَzَaʾَf", "root": "زلل"}, {"id": 2, "arabic": "ٱلشَّيْطَٰنُ", "translit": "ُnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 3, "arabic": "عَنْهَا", "translit": "āَhْnَʿع", "root": ""}, {"id": 4, "arabic": "فَأَخْرَجَهُمَا", "translit": "āَmُhَjgَrْhkَaʾَf", "root": "خرج"}, {"id": 5, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 6, "arabic": "كَانَا", "translit": "āَnāَk", "root": "كون"}, {"id": 7, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 8, "arabic": "وَقُلْنَا", "translit": "āَnْlُqَw", "root": "قول"}, {"id": 9, "arabic": "ٱهْبِطُوا۟", "translit": "۟āwُṭِbْhٱ", "root": "هبط"}, {"id": 10, "arabic": "بَعْضُكُمْ", "translit": "ْmُkُḍْʿعَb", "root": "بعض"}, {"id": 11, "arabic": "لِبَعْضٍ", "translit": "ٍḍْʿعَbِl", "root": "بعض"}, {"id": 12, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 13, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 16, "arabic": "مُسْتَقَرٌّ", "translit": "ٌّrَqَtْsُm", "root": "قرر"}, {"id": 17, "arabic": "وَمَتَٰعٌ", "translit": "ٌʿعَٰtَmَw", "root": "متع"}, {"id": 18, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 19, "arabic": "حِينٍ", "translit": "ٍnyِḥ", "root": "حين"}], "hasIhya": false}, {"ayah": 37, "text": "فَتَلَقَّىٰٓ ءَادَمُ مِن رَّبِّهِۦ كَلِمَٰتٍ فَتَابَ عَلَيْهِۚ إِنَّهُۥ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ ", "translation": "Then Adam received from his Lord [some] words,[1] and He accepted his repentance. Indeed, it is He who is the Accepting of Repentance,[2] the Merciful.", "words": [{"id": 1, "arabic": "فَتَلَقَّىٰٓ", "translit": "ٰٓàَّqَlَtَf", "root": "لقي"}, {"id": 2, "arabic": "ءَادَمُ", "translit": "ُmَdāَء", "root": "ادم"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "رَّبِّهِۦ", "translit": "ۦِhِّbَّr", "root": "ربب"}, {"id": 5, "arabic": "كَلِمَٰتٍ", "translit": "ٍtَٰmِlَk", "root": "كلم"}, {"id": 6, "arabic": "فَتَابَ", "translit": "َbāَtَf", "root": "توب"}, {"id": 7, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 9, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 10, "arabic": "ٱلتَّوَّابُ", "translit": "ُbāَّwَّtlٱ", "root": "توب"}, {"id": 11, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 38, "text": "قُلْنَا ٱهْبِطُوا۟ مِنْهَا جَمِيعًاۖ فَإِمَّا يَأْتِيَنَّكُم مِّنِّى هُدًى فَمَن تَبِعَ هُدَاىَ فَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "We said, \"Go down from it, all of you. And when guidance comes to you from Me, whoever follows My guidance - there will be no fear concerning them, nor will they grieve.", "words": [{"id": 1, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 2, "arabic": "ٱهْبِطُوا۟", "translit": "۟āwُṭِbْhٱ", "root": "هبط"}, {"id": 3, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 4, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 5, "arabic": "فَإِمَّا", "translit": "āَّmِiʾَf", "root": ""}, {"id": 6, "arabic": "يَأْتِيَنَّكُم", "translit": "mُkَّnَyِtْaʾَy", "root": "اتي"}, {"id": 7, "arabic": "مِّنِّى", "translit": "àِّnِّm", "root": ""}, {"id": 8, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 9, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 10, "arabic": "تَبِعَ", "translit": "َʿعِbَt", "root": "تبع"}, {"id": 11, "arabic": "هُدَاىَ", "translit": "َàāَdُh", "root": "هدي"}, {"id": 12, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 13, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 14, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 17, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": false}, {"ayah": 39, "text": "وَٱلَّذِينَ كَفَرُوا۟ وَكَذَّبُوا۟ بِـَٔايَٰتِنَآ أُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "And those who disbelieve and deny Our signs - those will be companions of the Fire; they will abide therein eternally.\"", "words": [{"id": 1, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 2, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 3, "arabic": "وَكَذَّبُوا۟", "translit": "۟āwُbَّhdَkَw", "root": "كذب"}, {"id": 4, "arabic": "بِـَٔايَٰتِنَآ", "translit": "ٓāَnِtَٰyāَٔـِb", "root": "ايي"}, {"id": 5, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 6, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 7, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 8, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 40, "text": "يَٰبَنِىٓ إِسْرَٰٓءِيلَ ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ وَأَوْفُوا۟ بِعَهْدِىٓ أُوفِ بِعَهْدِكُمْ وَإِيَّٰىَ فَٱرْهَبُونِ ", "translation": "O Children of Israel, remember My favor which I have bestowed upon you and fulfill My covenant [upon you] that I will fulfill your covenant [from Me], and be afraid of [only] Me.", "words": [{"id": 1, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 2, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 3, "arabic": "ٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱ", "root": "ذكر"}, {"id": 4, "arabic": "نِعْمَتِىَ", "translit": "َàِtَmْʿعِn", "root": "نعم"}, {"id": 5, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 6, "arabic": "أَنْعَمْتُ", "translit": "ُtْmَʿعْnَaʾ", "root": "نعم"}, {"id": 7, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَأَوْفُوا۟", "translit": "۟āwُfْwَaʾَw", "root": "وفي"}, {"id": 9, "arabic": "بِعَهْدِىٓ", "translit": "ٓàِdْhَʿعِb", "root": "عهد"}, {"id": 10, "arabic": "أُوفِ", "translit": "ِfwُaʾ", "root": "وفي"}, {"id": 11, "arabic": "بِعَهْدِكُمْ", "translit": "ْmُkِdْhَʿعِb", "root": "عهد"}, {"id": 12, "arabic": "وَإِيَّٰىَ", "translit": "َàَّٰyِiʾَw", "root": ""}, {"id": 13, "arabic": "فَٱرْهَبُونِ", "translit": "ِnwُbَhْrٱَf", "root": "رهب"}], "hasIhya": false}, {"ayah": 41, "text": "وَءَامِنُوا۟ بِمَآ أَنزَلْتُ مُصَدِّقًا لِّمَا مَعَكُمْ وَلَا تَكُونُوٓا۟ أَوَّلَ كَافِرٍۭ بِهِۦۖ وَلَا تَشْتَرُوا۟ بِـَٔايَٰتِى ثَمَنًا قَلِيلًا وَإِيَّٰىَ فَٱتَّقُونِ ", "translation": "And believe in what I have sent down confirming that which is [already] with you, and be not the first to disbelieve in it. And do not exchange My signs for a small price, and fear [only] Me.", "words": [{"id": 1, "arabic": "وَءَامِنُوا۟", "translit": "۟āwُnِmāَءَw", "root": "امن"}, {"id": 2, "arabic": "بِمَآ", "translit": "ٓāَmِb", "root": ""}, {"id": 3, "arabic": "أَنزَلْتُ", "translit": "ُtْlَznَaʾ", "root": "نزل"}, {"id": 4, "arabic": "مُصَدِّقًا", "translit": "āًqِّdَṣُm", "root": "صدق"}, {"id": 5, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 6, "arabic": "مَعَكُمْ", "translit": "ْmُkَʿعَm", "root": ""}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "تَكُونُوٓا۟", "translit": "۟āٓwُnwُkَt", "root": "كون"}, {"id": 9, "arabic": "أَوَّلَ", "translit": "َlَّwَaʾ", "root": "اول"}, {"id": 10, "arabic": "كَافِرٍۭ", "translit": "ٍۭrِfāَk", "root": "كفر"}, {"id": 11, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "تَشْتَرُوا۟", "translit": "۟āwُrَtْhsَt", "root": "شري"}, {"id": 14, "arabic": "بِـَٔايَٰتِى", "translit": "àِtَٰyāَٔـِb", "root": "ايي"}, {"id": 15, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 16, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 17, "arabic": "وَإِيَّٰىَ", "translit": "َàَّٰyِiʾَw", "root": ""}, {"id": 18, "arabic": "فَٱتَّقُونِ", "translit": "ِnwُqَّtٱَf", "root": "وقي"}], "hasIhya": false}, {"ayah": 42, "text": "وَلَا تَلْبِسُوا۟ ٱلْحَقَّ بِٱلْبَٰطِلِ وَتَكْتُمُوا۟ ٱلْحَقَّ وَأَنتُمْ تَعْلَمُونَ ", "translation": "And do not mix the truth with falsehood or conceal the truth while you know [it].", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَلْبِسُوا۟", "translit": "۟āwُsِbْlَt", "root": "لبس"}, {"id": 3, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 4, "arabic": "بِٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱِb", "root": "بطل"}, {"id": 5, "arabic": "وَتَكْتُمُوا۟", "translit": "۟āwُmُtْkَtَw", "root": "كتم"}, {"id": 6, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 7, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 8, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 43, "text": "وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَ وَٱرْكَعُوا۟ مَعَ ٱلرَّٰكِعِينَ ", "translation": "And establish prayer and give zakāh[1] and bow with those who bow [in worship and obedience].", "words": [{"id": 1, "arabic": "وَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَw", "root": "قوم"}, {"id": 2, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 3, "arabic": "وَءَاتُوا۟", "translit": "۟āwُtāَءَw", "root": "اتي"}, {"id": 4, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 5, "arabic": "وَٱرْكَعُوا۟", "translit": "۟āwُʿعَkْrٱَw", "root": "ركع"}, {"id": 6, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 7, "arabic": "ٱلرَّٰكِعِينَ", "translit": "َnyِʿعِkَّٰrlٱ", "root": "ركع"}], "hasIhya": true}, {"ayah": 44, "text": "أَتَأْمُرُونَ ٱلنَّاسَ بِٱلْبِرِّ وَتَنسَوْنَ أَنفُسَكُمْ وَأَنتُمْ تَتْلُونَ ٱلْكِتَٰبَۚ أَفَلَا تَعْقِلُونَ ", "translation": "Do you order righteousness of the people and forget[1] yourselves while you recite the Scripture? Then will you not reason?", "words": [{"id": 1, "arabic": "أَتَأْمُرُونَ", "translit": "َnwُrُmْaʾَtَaʾ", "root": "امر"}, {"id": 2, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "بِٱلْبِرِّ", "translit": "ِّrِbْlٱِb", "root": "برر"}, {"id": 4, "arabic": "وَتَنسَوْنَ", "translit": "َnْwَsnَtَw", "root": "نسي"}, {"id": 5, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 6, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 7, "arabic": "تَتْلُونَ", "translit": "َnwُlْtَt", "root": "تلو"}, {"id": 8, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 9, "arabic": "أَفَلَا", "translit": "āَlَfَaʾ", "root": ""}, {"id": 10, "arabic": "تَعْقِلُونَ", "translit": "َnwُlِqْʿعَt", "root": "عقل"}], "hasIhya": true}, {"ayah": 45, "text": "وَٱسْتَعِينُوا۟ بِٱلصَّبْرِ وَٱلصَّلَوٰةِۚ وَإِنَّهَا لَكَبِيرَةٌ إِلَّا عَلَى ٱلْخَٰشِعِينَ ", "translation": "And seek help through patience and prayer; and indeed, it is difficult except for the humbly submissive [to Allāh]", "words": [{"id": 1, "arabic": "وَٱسْتَعِينُوا۟", "translit": "۟āwُnyِʿعَtْsٱَw", "root": "عون"}, {"id": 2, "arabic": "بِٱلصَّبْرِ", "translit": "ِrْbَّṣlٱِb", "root": "صبر"}, {"id": 3, "arabic": "وَٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱَw", "root": "صلو"}, {"id": 4, "arabic": "وَإِنَّهَا", "translit": "āَhَّnِiʾَw", "root": ""}, {"id": 5, "arabic": "لَكَبِيرَةٌ", "translit": "ٌẗَryِbَkَl", "root": "كبر"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱلْخَٰشِعِينَ", "translit": "َnyِʿعِhsَٰhkْlٱ", "root": "خشع"}], "hasIhya": true}, {"ayah": 46, "text": "ٱلَّذِينَ يَظُنُّونَ أَنَّهُم مُّلَٰقُوا۟ رَبِّهِمْ وَأَنَّهُمْ إِلَيْهِ رَٰجِعُونَ ", "translation": "Who are certain that they will meet their Lord and that they will return to Him.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "يَظُنُّونَ", "translit": "َnwُّnُẓَy", "root": "ظنن"}, {"id": 3, "arabic": "أَنَّهُم", "translit": "mُhَّnَaʾ", "root": ""}, {"id": 4, "arabic": "مُّلَٰقُوا۟", "translit": "۟āwُqَٰlُّm", "root": "لقي"}, {"id": 5, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 6, "arabic": "وَأَنَّهُمْ", "translit": "ْmُhَّnَaʾَw", "root": ""}, {"id": 7, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 8, "arabic": "رَٰجِعُونَ", "translit": "َnwُʿعِjgَٰr", "root": "رجع"}], "hasIhya": false}, {"ayah": 47, "text": "يَٰبَنِىٓ إِسْرَٰٓءِيلَ ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ وَأَنِّى فَضَّلْتُكُمْ عَلَى ٱلْعَٰلَمِينَ ", "translation": "O Children of Israel, remember My favor that I have bestowed upon you and that I preferred you over the worlds [i.e., peoples].", "words": [{"id": 1, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 2, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 3, "arabic": "ٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱ", "root": "ذكر"}, {"id": 4, "arabic": "نِعْمَتِىَ", "translit": "َàِtَmْʿعِn", "root": "نعم"}, {"id": 5, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 6, "arabic": "أَنْعَمْتُ", "translit": "ُtْmَʿعْnَaʾ", "root": "نعم"}, {"id": 7, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَأَنِّى", "translit": "àِّnَaʾَw", "root": ""}, {"id": 9, "arabic": "فَضَّلْتُكُمْ", "translit": "ْmُkُtْlَّḍَf", "root": "فضل"}, {"id": 10, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 48, "text": "وَٱتَّقُوا۟ يَوْمًا لَّا تَجْزِى نَفْسٌ عَن نَّفْسٍ شَيْـًٔا وَلَا يُقْبَلُ مِنْهَا شَفَٰعَةٌ وَلَا يُؤْخَذُ مِنْهَا عَدْلٌ وَلَا هُمْ يُنصَرُونَ ", "translation": "And fear a Day when no soul will suffice for another soul[1] at all, nor will intercession be accepted from it, nor will compensation be taken from it, nor will they be aided.", "words": [{"id": 1, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 2, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 3, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 4, "arabic": "تَجْزِى", "translit": "àِzْjgَt", "root": "جزي"}, {"id": 5, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "نَّفْسٍ", "translit": "ٍsْfَّn", "root": "نفس"}, {"id": 8, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يُقْبَلُ", "translit": "ُlَbْqُy", "root": "قبل"}, {"id": 11, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 12, "arabic": "شَفَٰعَةٌ", "translit": "ٌẗَʿعَٰfَhs", "root": "شفع"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "يُؤْخَذُ", "translit": "ُhdَhkْwʾُy", "root": "اخذ"}, {"id": 15, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 16, "arabic": "عَدْلٌ", "translit": "ٌlْdَʿع", "root": "عدل"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 19, "arabic": "يُنصَرُونَ", "translit": "َnwُrَṣnُy", "root": "نصر"}], "hasIhya": true}, {"ayah": 49, "text": "وَإِذْ نَجَّيْنَٰكُم مِّنْ ءَالِ فِرْعَوْنَ يَسُومُونَكُمْ سُوٓءَ ٱلْعَذَابِ يُذَبِّحُونَ أَبْنَآءَكُمْ وَيَسْتَحْيُونَ نِسَآءَكُمْۚ وَفِى ذَٰلِكُم بَلَآءٌ مِّن رَّبِّكُمْ عَظِيمٌ ", "translation": "And [recall] when We saved you [i.e., your forefathers] from the people of Pharaoh, who afflicted you with the worst torment, slaughtering your [newborn] sons and keeping your females alive. And in that was a great trial from your Lord.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "نَجَّيْنَٰكُم", "translit": "mُkَٰnْyَّjgَn", "root": "نجو"}, {"id": 3, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 4, "arabic": "ءَالِ", "translit": "ِlāَء", "root": "اول"}, {"id": 5, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 6, "arabic": "يَسُومُونَكُمْ", "translit": "ْmُkَnwُmwُsَy", "root": "سوم"}, {"id": 7, "arabic": "سُوٓءَ", "translit": "َءٓwُs", "root": "سوا"}, {"id": 8, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 9, "arabic": "يُذَبِّحُونَ", "translit": "َnwُḥِّbَhdُy", "root": "ذبح"}, {"id": 10, "arabic": "أَبْنَآءَكُمْ", "translit": "ْmُkَءٓāَnْbَaʾ", "root": "بني"}, {"id": 11, "arabic": "وَيَسْتَحْيُونَ", "translit": "َnwُyْḥَtْsَyَw", "root": "حيي"}, {"id": 12, "arabic": "نِسَآءَكُمْ", "translit": "ْmُkَءٓāَsِn", "root": "نسو"}, {"id": 13, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 14, "arabic": "ذَٰلِكُم", "translit": "mُkِlَٰhd", "root": ""}, {"id": 15, "arabic": "بَلَآءٌ", "translit": "ٌءٓāَlَb", "root": "بلو"}, {"id": 16, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 17, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 18, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 50, "text": "وَإِذْ فَرَقْنَا بِكُمُ ٱلْبَحْرَ فَأَنجَيْنَٰكُمْ وَأَغْرَقْنَآ ءَالَ فِرْعَوْنَ وَأَنتُمْ تَنظُرُونَ ", "translation": "And [recall] when We parted the sea for you and saved you and drowned the people of Pharaoh while you were looking on.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "فَرَقْنَا", "translit": "āَnْqَrَf", "root": "فرق"}, {"id": 3, "arabic": "بِكُمُ", "translit": "ُmُkِb", "root": ""}, {"id": 4, "arabic": "ٱلْبَحْرَ", "translit": "َrْḥَbْlٱ", "root": "بحر"}, {"id": 5, "arabic": "فَأَنجَيْنَٰكُمْ", "translit": "ْmُkَٰnْyَjgnَaʾَf", "root": "نجو"}, {"id": 6, "arabic": "وَأَغْرَقْنَآ", "translit": "ٓāَnْqَrْغَaʾَw", "root": "غرق"}, {"id": 7, "arabic": "ءَالَ", "translit": "َlāَء", "root": "اول"}, {"id": 8, "arabic": "فِرْعَوْنَ", "translit": "َnْwَʿعْrِf", "root": ""}, {"id": 9, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 10, "arabic": "تَنظُرُونَ", "translit": "َnwُrُẓnَt", "root": "نظر"}], "hasIhya": false}, {"ayah": 51, "text": "وَإِذْ وَٰعَدْنَا مُوسَىٰٓ أَرْبَعِينَ لَيْلَةً ثُمَّ ٱتَّخَذْتُمُ ٱلْعِجْلَ مِنۢ بَعْدِهِۦ وَأَنتُمْ ظَٰلِمُونَ ", "translation": "And [recall] when We made an appointment with Moses for forty nights. Then you took [for worship] the calf after him [i.e., his departure], while you were wrongdoers.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "وَٰعَدْنَا", "translit": "āَnْdَʿعَٰw", "root": "وعد"}, {"id": 3, "arabic": "مُوسَىٰٓ", "translit": "ٰٓàَswُm", "root": ""}, {"id": 4, "arabic": "أَرْبَعِينَ", "translit": "َnyِʿعَbْrَaʾ", "root": "ربع"}, {"id": 5, "arabic": "لَيْلَةً", "translit": "ًẗَlْyَl", "root": "ليل"}, {"id": 6, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 7, "arabic": "ٱتَّخَذْتُمُ", "translit": "ُmُtْhdَhkَّtٱ", "root": "اخذ"}, {"id": 8, "arabic": "ٱلْعِجْلَ", "translit": "َlْjgِʿعْlٱ", "root": "عجل"}, {"id": 9, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 10, "arabic": "بَعْدِهِۦ", "translit": "ۦِhِdْʿعَb", "root": "بعد"}, {"id": 11, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 12, "arabic": "ظَٰلِمُونَ", "translit": "َnwُmِlَٰẓ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 52, "text": "ثُمَّ عَفَوْنَا عَنكُم مِّنۢ بَعْدِ ذَٰلِكَ لَعَلَّكُمْ تَشْكُرُونَ ", "translation": "Then We forgave you after that so perhaps you would be grateful.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "عَفَوْنَا", "translit": "āَnْwَfَʿع", "root": "عفو"}, {"id": 3, "arabic": "عَنكُم", "translit": "mُknَʿع", "root": ""}, {"id": 4, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 5, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 6, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 7, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 8, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 53, "text": "وَإِذْ ءَاتَيْنَا مُوسَى ٱلْكِتَٰبَ وَٱلْفُرْقَانَ لَعَلَّكُمْ تَهْتَدُونَ ", "translation": "And [recall] when We gave Moses the Scripture and criterion[1] that perhaps you would be guided.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَا", "translit": "āَnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "مُوسَى", "translit": "àَswُm", "root": ""}, {"id": 4, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 5, "arabic": "وَٱلْفُرْقَانَ", "translit": "َnāَqْrُfْlٱَw", "root": "فرق"}, {"id": 6, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 7, "arabic": "تَهْتَدُونَ", "translit": "َnwُdَtْhَt", "root": "هدي"}], "hasIhya": false}, {"ayah": 54, "text": "وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِۦ يَٰقَوْمِ إِنَّكُمْ ظَلَمْتُمْ أَنفُسَكُم بِٱتِّخَاذِكُمُ ٱلْعِجْلَ فَتُوبُوٓا۟ إِلَىٰ بَارِئِكُمْ فَٱقْتُلُوٓا۟ أَنفُسَكُمْ ذَٰلِكُمْ خَيْرٌ لَّكُمْ عِندَ بَارِئِكُمْ فَتَابَ عَلَيْكُمْۚ إِنَّهُۥ هُوَ ٱلتَّوَّابُ ٱلرَّحِيمُ ", "translation": "And [recall] when Moses said to his people, \"O my people, indeed you have wronged yourselves by your taking of the calf [for worship]. So repent to your Creator and kill yourselves [i.e., the guilty among you]. That is best for [all of] you in the sight of your Creator.\" Then He accepted your repentance; indeed, He is the Accepting of Repentance, the Merciful.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "لِقَوْمِهِۦ", "translit": "ۦِhِmْwَqِl", "root": "قوم"}, {"id": 5, "arabic": "يَٰقَوْمِ", "translit": "ِmْwَqَٰy", "root": "قوم"}, {"id": 6, "arabic": "إِنَّكُمْ", "translit": "ْmُkَّnِiʾ", "root": ""}, {"id": 7, "arabic": "ظَلَمْتُمْ", "translit": "ْmُtْmَlَẓ", "root": "ظلم"}, {"id": 8, "arabic": "أَنفُسَكُم", "translit": "mُkَsُfnَaʾ", "root": "نفس"}, {"id": 9, "arabic": "بِٱتِّخَاذِكُمُ", "translit": "ُmُkِhdāَhkِّtٱِb", "root": "اخذ"}, {"id": 10, "arabic": "ٱلْعِجْلَ", "translit": "َlْjgِʿعْlٱ", "root": "عجل"}, {"id": 11, "arabic": "فَتُوبُوٓا۟", "translit": "۟āٓwُbwُtَf", "root": "توب"}, {"id": 12, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 13, "arabic": "بَارِئِكُمْ", "translit": "ْmُkِyʾِrāَb", "root": "برا"}, {"id": 14, "arabic": "فَٱقْتُلُوٓا۟", "translit": "۟āٓwُlُtْqٱَf", "root": "قتل"}, {"id": 15, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 16, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 17, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 18, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 19, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 20, "arabic": "بَارِئِكُمْ", "translit": "ْmُkِyʾِrāَb", "root": "برا"}, {"id": 21, "arabic": "فَتَابَ", "translit": "َbāَtَf", "root": "توب"}, {"id": 22, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 23, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 24, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 25, "arabic": "ٱلتَّوَّابُ", "translit": "ُbāَّwَّtlٱ", "root": "توب"}, {"id": 26, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 55, "text": "وَإِذْ قُلْتُمْ يَٰمُوسَىٰ لَن نُّؤْمِنَ لَكَ حَتَّىٰ نَرَى ٱللَّهَ جَهْرَةً فَأَخَذَتْكُمُ ٱلصَّٰعِقَةُ وَأَنتُمْ تَنظُرُونَ ", "translation": "And [recall] when you said, \"O Moses, we will never believe you until we see Allāh outright\"; so the thunderbolt took you while you were looking on.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قُلْتُمْ", "translit": "ْmُtْlُq", "root": "قول"}, {"id": 3, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}, {"id": 4, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 5, "arabic": "نُّؤْمِنَ", "translit": "َnِmْwʾُّn", "root": "امن"}, {"id": 6, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 7, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 8, "arabic": "نَرَى", "translit": "àَrَn", "root": "راي"}, {"id": 9, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "جَهْرَةً", "translit": "ًẗَrْhَjg", "root": "جهر"}, {"id": 11, "arabic": "فَأَخَذَتْكُمُ", "translit": "ُmُkْtَhdَhkَaʾَf", "root": "اخذ"}, {"id": 12, "arabic": "ٱلصَّٰعِقَةُ", "translit": "ُẗَqِʿعَّٰṣlٱ", "root": "صعق"}, {"id": 13, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 14, "arabic": "تَنظُرُونَ", "translit": "َnwُrُẓnَt", "root": "نظر"}], "hasIhya": false}, {"ayah": 56, "text": "ثُمَّ بَعَثْنَٰكُم مِّنۢ بَعْدِ مَوْتِكُمْ لَعَلَّكُمْ تَشْكُرُونَ ", "translation": "Then We revived you after your death that perhaps you would be grateful.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "بَعَثْنَٰكُم", "translit": "mُkَٰnْhtَʿعَb", "root": "بعث"}, {"id": 3, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 4, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "مَوْتِكُمْ", "translit": "ْmُkِtْwَm", "root": "موت"}, {"id": 6, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 7, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": false}, {"ayah": 57, "text": "وَظَلَّلْنَا عَلَيْكُمُ ٱلْغَمَامَ وَأَنزَلْنَا عَلَيْكُمُ ٱلْمَنَّ وَٱلسَّلْوَىٰۖ كُلُوا۟ مِن طَيِّبَٰتِ مَا رَزَقْنَٰكُمْۖ وَمَا ظَلَمُونَا وَلَٰكِن كَانُوٓا۟ أَنفُسَهُمْ يَظْلِمُونَ ", "translation": "And We shaded you with clouds and sent down to you manna and quails, [saying], \"Eat from the good things with which We have provided you.\" And they wronged Us not - but they were [only] wronging themselves.", "words": [{"id": 1, "arabic": "وَظَلَّلْنَا", "translit": "āَnْlَّlَẓَw", "root": "ظلل"}, {"id": 2, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْغَمَامَ", "translit": "َmāَmَغْlٱ", "root": "غمم"}, {"id": 4, "arabic": "وَأَنزَلْنَا", "translit": "āَnْlَznَaʾَw", "root": "نزل"}, {"id": 5, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْمَنَّ", "translit": "َّnَmْlٱ", "root": "منن"}, {"id": 7, "arabic": "وَٱلسَّلْوَىٰ", "translit": "ٰàَwْlَّslٱَw", "root": "سلو"}, {"id": 8, "arabic": "كُلُوا۟", "translit": "۟āwُlُk", "root": "اكل"}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "طَيِّبَٰتِ", "translit": "ِtَٰbِّyَṭ", "root": "طيب"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "رَزَقْنَٰكُمْ", "translit": "ْmُkَٰnْqَzَr", "root": "رزق"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "ظَلَمُونَا", "translit": "āَnwُmَlَẓ", "root": "ظلم"}, {"id": 15, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 16, "arabic": "كَانُوٓا۟", "translit": "۟āٓwُnāَk", "root": "كون"}, {"id": 17, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 18, "arabic": "يَظْلِمُونَ", "translit": "َnwُmِlْẓَy", "root": "ظلم"}], "hasIhya": true}, {"ayah": 58, "text": "وَإِذْ قُلْنَا ٱدْخُلُوا۟ هَٰذِهِ ٱلْقَرْيَةَ فَكُلُوا۟ مِنْهَا حَيْثُ شِئْتُمْ رَغَدًا وَٱدْخُلُوا۟ ٱلْبَابَ سُجَّدًا وَقُولُوا۟ حِطَّةٌ نَّغْفِرْ لَكُمْ خَطَٰيَٰكُمْۚ وَسَنَزِيدُ ٱلْمُحْسِنِينَ ", "translation": "And [recall] when We said, \"Enter this city [i.e., Jerusalem] and eat from it wherever you will in [ease and] abundance, and enter the gate bowing humbly[1] and say, 'Relieve us of our burdens [i.e., sins].' We will [then] forgive your sins for you, and We will increase the doers of good [in goodness and reward].\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قُلْنَا", "translit": "āَnْlُq", "root": "قول"}, {"id": 3, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 4, "arabic": "هَٰذِهِ", "translit": "ِhِhdَٰh", "root": ""}, {"id": 5, "arabic": "ٱلْقَرْيَةَ", "translit": "َẗَyْrَqْlٱ", "root": "قري"}, {"id": 6, "arabic": "فَكُلُوا۟", "translit": "۟āwُlُkَf", "root": "اكل"}, {"id": 7, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 8, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 9, "arabic": "شِئْتُمْ", "translit": "ْmُtْyʾِhs", "root": "شيا"}, {"id": 10, "arabic": "رَغَدًا", "translit": "āًdَغَr", "root": "رغد"}, {"id": 11, "arabic": "وَٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱَw", "root": "دخل"}, {"id": 12, "arabic": "ٱلْبَابَ", "translit": "َbāَbْlٱ", "root": "بوب"}, {"id": 13, "arabic": "سُجَّدًا", "translit": "āًdَّjgُs", "root": "سجد"}, {"id": 14, "arabic": "وَقُولُوا۟", "translit": "۟āwُlwُqَw", "root": "قول"}, {"id": 15, "arabic": "حِطَّةٌ", "translit": "ٌẗَّṭِḥ", "root": "حطط"}, {"id": 16, "arabic": "نَّغْفِرْ", "translit": "ْrِfْغَّn", "root": "غفر"}, {"id": 17, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 18, "arabic": "خَطَٰيَٰكُمْ", "translit": "ْmُkَٰyَٰṭَhk", "root": "خطا"}, {"id": 19, "arabic": "وَسَنَزِيدُ", "translit": "ُdyِzَnَsَw", "root": "زيد"}, {"id": 20, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": false}, {"ayah": 59, "text": "فَبَدَّلَ ٱلَّذِينَ ظَلَمُوا۟ قَوْلًا غَيْرَ ٱلَّذِى قِيلَ لَهُمْ فَأَنزَلْنَا عَلَى ٱلَّذِينَ ظَلَمُوا۟ رِجْزًا مِّنَ ٱلسَّمَآءِ بِمَا كَانُوا۟ يَفْسُقُونَ ", "translation": "But those who wronged changed [those words] to a statement other than that which had been said to them, so We sent down upon those who wronged a punishment [i.e., plague] from the sky because they were defiantly disobeying.", "words": [{"id": 1, "arabic": "فَبَدَّلَ", "translit": "َlَّdَbَf", "root": "بدل"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 4, "arabic": "قَوْلًا", "translit": "āًlْwَq", "root": "قول"}, {"id": 5, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 6, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 8, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 9, "arabic": "فَأَنزَلْنَا", "translit": "āَnْlَznَaʾَf", "root": "نزل"}, {"id": 10, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 12, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 13, "arabic": "رِجْزًا", "translit": "āًzْjgِr", "root": "رجز"}, {"id": 14, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 15, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 16, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 17, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 18, "arabic": "يَفْسُقُونَ", "translit": "َnwُqُsْfَy", "root": "فسق"}], "hasIhya": false}, {"ayah": 60, "text": "وَإِذِ ٱسْتَسْقَىٰ مُوسَىٰ لِقَوْمِهِۦ فَقُلْنَا ٱضْرِب بِّعَصَاكَ ٱلْحَجَرَۖ فَٱنفَجَرَتْ مِنْهُ ٱثْنَتَا عَشْرَةَ عَيْنًاۖ قَدْ عَلِمَ كُلُّ أُنَاسٍ مَّشْرَبَهُمْۖ كُلُوا۟ وَٱشْرَبُوا۟ مِن رِّزْقِ ٱللَّهِ وَلَا تَعْثَوْا۟ فِى ٱلْأَرْضِ مُفْسِدِينَ ", "translation": "And [recall] when Moses prayed for water for his people, so We said, \"Strike with your staff the stone.\" And there gushed forth from it twelve springs, and every people [i.e., tribe] knew its watering place. \"Eat and drink from the provision of Allāh, and do not commit abuse on the earth, spreading corruption.\"", "words": [{"id": 1, "arabic": "وَإِذِ", "translit": "ِhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱسْتَسْقَىٰ", "translit": "ٰàَqْsَtْsٱ", "root": "سقي"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "لِقَوْمِهِۦ", "translit": "ۦِhِmْwَqِl", "root": "قوم"}, {"id": 5, "arabic": "فَقُلْنَا", "translit": "āَnْlُqَf", "root": "قول"}, {"id": 6, "arabic": "ٱضْرِب", "translit": "bِrْḍٱ", "root": "ضرب"}, {"id": 7, "arabic": "بِّعَصَاكَ", "translit": "َkāَṣَʿعِّb", "root": "عصو"}, {"id": 8, "arabic": "ٱلْحَجَرَ", "translit": "َrَjgَḥْlٱ", "root": "حجر"}, {"id": 9, "arabic": "فَٱنفَجَرَتْ", "translit": "ْtَrَjgَfnٱَf", "root": "فجر"}, {"id": 10, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 11, "arabic": "ٱثْنَتَا", "translit": "āَtَnْhtٱ", "root": "ثني"}, {"id": 12, "arabic": "عَشْرَةَ", "translit": "َẗَrْhsَʿع", "root": "عشر"}, {"id": 13, "arabic": "عَيْنًا", "translit": "āًnْyَʿع", "root": "عين"}, {"id": 14, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 15, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 16, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 17, "arabic": "أُنَاسٍ", "translit": "ٍsāَnُaʾ", "root": "انس"}, {"id": 18, "arabic": "مَّشْرَبَهُمْ", "translit": "ْmُhَbَrْhsَّm", "root": "شرب"}, {"id": 19, "arabic": "كُلُوا۟", "translit": "۟āwُlُk", "root": "اكل"}, {"id": 20, "arabic": "وَٱشْرَبُوا۟", "translit": "۟āwُbَrْhsٱَw", "root": "شرب"}, {"id": 21, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 22, "arabic": "رِّزْقِ", "translit": "ِqْzِّr", "root": "رزق"}, {"id": 23, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 25, "arabic": "تَعْثَوْا۟", "translit": "۟āْwَhtْʿعَt", "root": "عثو"}, {"id": 26, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 27, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 28, "arabic": "مُفْسِدِينَ", "translit": "َnyِdِsْfُm", "root": "فسد"}], "hasIhya": false}, {"ayah": 61, "text": "وَإِذْ قُلْتُمْ يَٰمُوسَىٰ لَن نَّصْبِرَ عَلَىٰ طَعَامٍ وَٰحِدٍ فَٱدْعُ لَنَا رَبَّكَ يُخْرِجْ لَنَا مِمَّا تُنۢبِتُ ٱلْأَرْضُ مِنۢ بَقْلِهَا وَقِثَّآئِهَا وَفُومِهَا وَعَدَسِهَا وَبَصَلِهَاۖ قَالَ أَتَسْتَبْدِلُونَ ٱلَّذِى هُوَ أَدْنَىٰ بِٱلَّذِى هُوَ خَيْرٌۚ ٱهْبِطُوا۟ مِصْرًا فَإِنَّ لَكُم مَّا سَأَلْتُمْۗ وَضُرِبَتْ عَلَيْهِمُ ٱلذِّلَّةُ وَٱلْمَسْكَنَةُ وَبَآءُو بِغَضَبٍ مِّنَ ٱللَّهِۗ ذَٰلِكَ بِأَنَّهُمْ كَانُوا۟ يَكْفُرُونَ بِـَٔايَٰتِ ٱللَّهِ وَيَقْتُلُونَ ٱلنَّبِيِّۦنَ بِغَيْرِ ٱلْحَقِّۗ ذَٰلِكَ بِمَا عَصَوا۟ وَّكَانُوا۟ يَعْتَدُونَ ", "translation": "And [recall] when you said, \"O Moses, we can never endure one [kind of] food. So call upon your Lord to bring forth for us from the earth its green herbs and its cucumbers and its garlic and its lentils and its onions.\" [Moses] said, \"Would you exchange what is better for what is less? Go into [any] settlement and indeed, you will have what you have asked.\" And they were covered with humiliation and poverty and returned with anger from Allāh [upon them]. That was because they [repeatedly] disbelieved in the signs of Allāh and killed the prophets without right. That was because they disobeyed and were [habitually] transgressing.", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قُلْتُمْ", "translit": "ْmُtْlُq", "root": "قول"}, {"id": 3, "arabic": "يَٰمُوسَىٰ", "translit": "ٰàَswُmَٰy", "root": ""}, {"id": 4, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 5, "arabic": "نَّصْبِرَ", "translit": "َrِbْṣَّn", "root": "صبر"}, {"id": 6, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 7, "arabic": "طَعَامٍ", "translit": "ٍmāَʿعَṭ", "root": "طعم"}, {"id": 8, "arabic": "وَٰحِدٍ", "translit": "ٍdِḥَٰw", "root": "وحد"}, {"id": 9, "arabic": "فَٱدْعُ", "translit": "ُʿعْdٱَf", "root": "دعو"}, {"id": 10, "arabic": "لَنَا", "trans