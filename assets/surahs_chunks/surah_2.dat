 "وَلِتُكْمِلُوا۟", "translit": "۟āwُlِmْkُtِlَw", "root": "كمل"}, {"id": 37, "arabic": "ٱلْعِدَّةَ", "translit": "َẗَّdِʿعْlٱ", "root": "عدد"}, {"id": 38, "arabic": "وَلِتُكَبِّرُوا۟", "translit": "۟āwُrِّbَkُtِlَw", "root": "كبر"}, {"id": 39, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 40, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 41, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 42, "arabic": "هَدَىٰكُمْ", "translit": "ْmُkٰàَdَh", "root": "هدي"}, {"id": 43, "arabic": "وَلَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَlَw", "root": ""}, {"id": 44, "arabic": "تَشْكُرُونَ", "translit": "َnwُrُkْhsَt", "root": "شكر"}], "hasIhya": true}, {"ayah": 186, "text": "وَإِذَا سَأَلَكَ عِبَادِى عَنِّى فَإِنِّى قَرِيبٌۖ أُجِيبُ دَعْوَةَ ٱلدَّاعِ إِذَا دَعَانِۖ فَلْيَسْتَجِيبُوا۟ لِى وَلْيُؤْمِنُوا۟ بِى لَعَلَّهُمْ يَرْشُدُونَ ", "translation": "And when My servants ask you, [O Muḥammad], concerning Me - indeed I am near. I respond to the invocation of the supplicant when he calls upon Me. So let them respond to Me [by obedience] and believe in Me that they may be [rightly] guided.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "سَأَلَكَ", "translit": "َkَlَaʾَs", "root": "سال"}, {"id": 3, "arabic": "عِبَادِى", "translit": "àِdāَbِʿع", "root": "عبد"}, {"id": 4, "arabic": "عَنِّى", "translit": "àِّnَʿع", "root": ""}, {"id": 5, "arabic": "فَإِنِّى", "translit": "àِّnِiʾَf", "root": ""}, {"id": 6, "arabic": "قَرِيبٌ", "translit": "ٌbyِrَq", "root": "قرب"}, {"id": 7, "arabic": "أُجِيبُ", "translit": "ُbyِjgُaʾ", "root": "جوب"}, {"id": 8, "arabic": "دَعْوَةَ", "translit": "َẗَwْʿعَd", "root": "دعو"}, {"id": 9, "arabic": "ٱلدَّاعِ", "translit": "ِʿعāَّdlٱ", "root": "دعو"}, {"id": 10, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 11, "arabic": "دَعَانِ", "translit": "ِnāَʿعَd", "root": "دعو"}, {"id": 12, "arabic": "فَلْيَسْتَجِيبُوا۟", "translit": "۟āwُbyِjgَtْsَyْlَf", "root": "جوب"}, {"id": 13, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 14, "arabic": "وَلْيُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُyْlَw", "root": "امن"}, {"id": 15, "arabic": "بِى", "translit": "àِb", "root": ""}, {"id": 16, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 17, "arabic": "يَرْشُدُونَ", "translit": "َnwُdُhsْrَy", "root": "رشد"}], "hasIhya": true}, {"ayah": 187, "text": "أُحِلَّ لَكُمْ لَيْلَةَ ٱلصِّيَامِ ٱلرَّفَثُ إِلَىٰ نِسَآئِكُمْۚ هُنَّ لِبَاسٌ لَّكُمْ وَأَنتُمْ لِبَاسٌ لَّهُنَّۗ عَلِمَ ٱللَّهُ أَنَّكُمْ كُنتُمْ تَخْتَانُونَ أَنفُسَكُمْ فَتَابَ عَلَيْكُمْ وَعَفَا عَنكُمْۖ فَٱلْـَٰٔنَ بَٰشِرُوهُنَّ وَٱبْتَغُوا۟ مَا كَتَبَ ٱللَّهُ لَكُمْۚ وَكُلُوا۟ وَٱشْرَبُوا۟ حَتَّىٰ يَتَبَيَّنَ لَكُمُ ٱلْخَيْطُ ٱلْأَبْيَضُ مِنَ ٱلْخَيْطِ ٱلْأَسْوَدِ مِنَ ٱلْفَجْرِۖ ثُمَّ أَتِمُّوا۟ ٱلصِّيَامَ إِلَى ٱلَّيْلِۚ وَلَا تُبَٰشِرُوهُنَّ وَأَنتُمْ عَٰكِفُونَ فِى ٱلْمَسَٰجِدِۗ تِلْكَ حُدُودُ ٱللَّهِ فَلَا تَقْرَبُوهَاۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ ءَايَٰتِهِۦ لِلنَّاسِ لَعَلَّهُمْ يَتَّقُونَ ", "translation": "It has been made permissible for you the night preceding fasting to go to your wives [for sexual relations]. They are a clothing for you and you are a clothing[1] for them. Allāh knows that you used to deceive yourselves,[2] so He accepted your repentance and forgave you. So now, have relations with them and seek that which Allāh has decreed for you [i.e., offspring]. And eat and drink until the white thread of dawn becomes distinct to you from the black thread [of night]. Then complete the fast until the night [i.e., sunset]. And do not have relations with them as long as you are staying for worship in the mosques. These are the limits [set by] Allāh, so do not approach them. Thus does Allāh make clear His verses [i.e., ordinances] to the people that they may become righteous.", "words": [{"id": 1, "arabic": "أُحِلَّ", "translit": "َّlِḥُaʾ", "root": "حلل"}, {"id": 2, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 3, "arabic": "لَيْلَةَ", "translit": "َẗَlْyَl", "root": "ليل"}, {"id": 4, "arabic": "ٱلصِّيَامِ", "translit": "ِmāَyِّṣlٱ", "root": "صوم"}, {"id": 5, "arabic": "ٱلرَّفَثُ", "translit": "ُhtَfَّrlٱ", "root": "رفث"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "نِسَآئِكُمْ", "translit": "ْmُkِyʾٓāَsِn", "root": "نسو"}, {"id": 8, "arabic": "هُنَّ", "translit": "َّnُh", "root": ""}, {"id": 9, "arabic": "لِبَاسٌ", "translit": "ٌsāَbِl", "root": "لبس"}, {"id": 10, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 11, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 12, "arabic": "لِبَاسٌ", "translit": "ٌsāَbِl", "root": "لبس"}, {"id": 13, "arabic": "لَّهُنَّ", "translit": "َّnُhَّl", "root": ""}, {"id": 14, "arabic": "عَلِمَ", "translit": "َmِlَʿع", "root": "علم"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "أَنَّكُمْ", "translit": "ْmُkَّnَaʾ", "root": ""}, {"id": 17, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 18, "arabic": "تَخْتَانُونَ", "translit": "َnwُnāَtْhkَt", "root": "خون"}, {"id": 19, "arabic": "أَنفُسَكُمْ", "translit": "ْmُkَsُfnَaʾ", "root": "نفس"}, {"id": 20, "arabic": "فَتَابَ", "translit": "َbāَtَf", "root": "توب"}, {"id": 21, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 22, "arabic": "وَعَفَا", "translit": "āَfَʿعَw", "root": "عفو"}, {"id": 23, "arabic": "عَنكُمْ", "translit": "ْmُknَʿع", "root": ""}, {"id": 24, "arabic": "فَٱلْـَٰٔنَ", "translit": "َnَٰٔـْlٱَf", "root": "اون"}, {"id": 25, "arabic": "بَٰشِرُوهُنَّ", "translit": "َّnُhwُrِhsَٰb", "root": "بشر"}, {"id": 26, "arabic": "وَٱبْتَغُوا۟", "translit": "۟āwُغَtْbٱَw", "root": "بغي"}, {"id": 27, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 28, "arabic": "كَتَبَ", "translit": "َbَtَk", "root": "كتب"}, {"id": 29, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 31, "arabic": "وَكُلُوا۟", "translit": "۟āwُlُkَw", "root": "اكل"}, {"id": 32, "arabic": "وَٱشْرَبُوا۟", "translit": "۟āwُbَrْhsٱَw", "root": "شرب"}, {"id": 33, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 34, "arabic": "يَتَبَيَّنَ", "translit": "َnَّyَbَtَy", "root": "بين"}, {"id": 35, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 36, "arabic": "ٱلْخَيْطُ", "translit": "ُṭْyَhkْlٱ", "root": "خيط"}, {"id": 37, "arabic": "ٱلْأَبْيَضُ", "translit": "ُḍَyْbَaʾْlٱ", "root": "بيض"}, {"id": 38, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 39, "arabic": "ٱلْخَيْطِ", "translit": "ِṭْyَhkْlٱ", "root": "خيط"}, {"id": 40, "arabic": "ٱلْأَسْوَدِ", "translit": "ِdَwْsَaʾْlٱ", "root": "سود"}, {"id": 41, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 42, "arabic": "ٱلْفَجْرِ", "translit": "ِrْjgَfْlٱ", "root": "فجر"}, {"id": 43, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 44, "arabic": "أَتِمُّوا۟", "translit": "۟āwُّmِtَaʾ", "root": "تمم"}, {"id": 45, "arabic": "ٱلصِّيَامَ", "translit": "َmāَyِّṣlٱ", "root": "صوم"}, {"id": 46, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 47, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 48, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 49, "arabic": "تُبَٰشِرُوهُنَّ", "translit": "َّnُhwُrِhsَٰbُt", "root": "بشر"}, {"id": 50, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 51, "arabic": "عَٰكِفُونَ", "translit": "َnwُfِkَٰʿع", "root": "عكف"}, {"id": 52, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 53, "arabic": "ٱلْمَسَٰجِدِ", "translit": "ِdِjgَٰsَmْlٱ", "root": "سجد"}, {"id": 54, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 55, "arabic": "حُدُودُ", "translit": "ُdwُdُḥ", "root": "حدد"}, {"id": 56, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 57, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 58, "arabic": "تَقْرَبُوهَا", "translit": "āَhwُbَrْqَt", "root": "قرب"}, {"id": 59, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 60, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 61, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 62, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 63, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 64, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 65, "arabic": "يَتَّقُونَ", "translit": "َnwُqَّtَy", "root": "وقي"}], "hasIhya": false}, {"ayah": 188, "text": "وَلَا تَأْكُلُوٓا۟ أَمْوَٰلَكُم بَيْنَكُم بِٱلْبَٰطِلِ وَتُدْلُوا۟ بِهَآ إِلَى ٱلْحُكَّامِ لِتَأْكُلُوا۟ فَرِيقًا مِّنْ أَمْوَٰلِ ٱلنَّاسِ بِٱلْإِثْمِ وَأَنتُمْ تَعْلَمُونَ ", "translation": "And do not consume one another's wealth unjustly or send it [in bribery] to the rulers in order that [they might aid] you [to] consume a portion of the wealth of the people in sin, while you know [it is unlawful].", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَأْكُلُوٓا۟", "translit": "۟āٓwُlُkْaʾَt", "root": "اكل"}, {"id": 3, "arabic": "أَمْوَٰلَكُم", "translit": "mُkَlَٰwْmَaʾ", "root": "مول"}, {"id": 4, "arabic": "بَيْنَكُم", "translit": "mُkَnْyَb", "root": "بين"}, {"id": 5, "arabic": "بِٱلْبَٰطِلِ", "translit": "ِlِṭَٰbْlٱِb", "root": "بطل"}, {"id": 6, "arabic": "وَتُدْلُوا۟", "translit": "۟āwُlْdُtَw", "root": "دلو"}, {"id": 7, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 8, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلْحُكَّامِ", "translit": "ِmāَّkُḥْlٱ", "root": "حكم"}, {"id": 10, "arabic": "لِتَأْكُلُوا۟", "translit": "۟āwُlُkْaʾَtِl", "root": "اكل"}, {"id": 11, "arabic": "فَرِيقًا", "translit": "āًqyِrَf", "root": "فرق"}, {"id": 12, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 13, "arabic": "أَمْوَٰلِ", "translit": "ِlَٰwْmَaʾ", "root": "مول"}, {"id": 14, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 15, "arabic": "بِٱلْإِثْمِ", "translit": "ِmْhtِiʾْlٱِb", "root": "اثم"}, {"id": 16, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 17, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 189, "text": "يَسْـَٔلُونَكَ عَنِ ٱلْأَهِلَّةِۖ قُلْ هِىَ مَوَٰقِيتُ لِلنَّاسِ وَٱلْحَجِّۗ وَلَيْسَ ٱلْبِرُّ بِأَن تَأْتُوا۟ ٱلْبُيُوتَ مِن ظُهُورِهَا وَلَٰكِنَّ ٱلْبِرَّ مَنِ ٱتَّقَىٰۗ وَأْتُوا۟ ٱلْبُيُوتَ مِنْ أَبْوَٰبِهَاۚ وَٱتَّقُوا۟ ٱللَّهَ لَعَلَّكُمْ تُفْلِحُونَ ", "translation": "They ask you, [O Muḥammad], about the crescent moons. Say, \"They are measurements of time for the people and for ḥajj [pilgrimage].\" And it is not righteousness to enter houses from the back, but righteousness is [in] one who fears Allāh. And enter houses from their doors. And fear Allāh that you may succeed.", "words": [{"id": 1, "arabic": "يَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَy", "root": "سال"}, {"id": 2, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْأَهِلَّةِ", "translit": "ِẗَّlِhَaʾْlٱ", "root": "هلل"}, {"id": 4, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 5, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 6, "arabic": "مَوَٰقِيتُ", "translit": "ُtyِqَٰwَm", "root": "وقت"}, {"id": 7, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 8, "arabic": "وَٱلْحَجِّ", "translit": "ِّjgَḥْlٱَw", "root": "حجج"}, {"id": 9, "arabic": "وَلَيْسَ", "translit": "َsْyَlَw", "root": "ليس"}, {"id": 10, "arabic": "ٱلْبِرُّ", "translit": "ُّrِbْlٱ", "root": "برر"}, {"id": 11, "arabic": "بِأَن", "translit": "nَaʾِb", "root": ""}, {"id": 12, "arabic": "تَأْتُوا۟", "translit": "۟āwُtْaʾَt", "root": "اتي"}, {"id": 13, "arabic": "ٱلْبُيُوتَ", "translit": "َtwُyُbْlٱ", "root": "بيت"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "ظُهُورِهَا", "translit": "āَhِrwُhُẓ", "root": "ظهر"}, {"id": 16, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 17, "arabic": "ٱلْبِرَّ", "translit": "َّrِbْlٱ", "root": "برر"}, {"id": 18, "arabic": "مَنِ", "translit": "ِnَm", "root": ""}, {"id": 19, "arabic": "ٱتَّقَىٰ", "translit": "ٰàَqَّtٱ", "root": "وقي"}, {"id": 20, "arabic": "وَأْتُوا۟", "translit": "۟āwُtْaʾَw", "root": "اتي"}, {"id": 21, "arabic": "ٱلْبُيُوتَ", "translit": "َtwُyُbْlٱ", "root": "بيت"}, {"id": 22, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 23, "arabic": "أَبْوَٰبِهَا", "translit": "āَhِbَٰwْbَaʾ", "root": "بوب"}, {"id": 24, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 25, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 27, "arabic": "تُفْلِحُونَ", "translit": "َnwُḥِlْfُt", "root": "فلح"}], "hasIhya": true}, {"ayah": 190, "text": "وَقَٰتِلُوا۟ فِى سَبِيلِ ٱللَّهِ ٱلَّذِينَ يُقَٰتِلُونَكُمْ وَلَا تَعْتَدُوٓا۟ۚ إِنَّ ٱللَّهَ لَا يُحِبُّ ٱلْمُعْتَدِينَ ", "translation": "Fight in the way of Allāh those who fight against you but do not transgress. Indeed, Allāh does not like transgressors.", "words": [{"id": 1, "arabic": "وَقَٰتِلُوا۟", "translit": "۟āwُlِtَٰqَw", "root": "قتل"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "يُقَٰتِلُونَكُمْ", "translit": "ْmُkَnwُlِtَٰqُy", "root": "قتل"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "تَعْتَدُوٓا۟", "translit": "۟āٓwُdَtْʿعَt", "root": "عدو"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 12, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 13, "arabic": "ٱلْمُعْتَدِينَ", "translit": "َnyِdَtْʿعُmْlٱ", "root": "عدو"}], "hasIhya": true}, {"ayah": 191, "text": "وَٱقْتُلُوهُمْ حَيْثُ ثَقِفْتُمُوهُمْ وَأَخْرِجُوهُم مِّنْ حَيْثُ أَخْرَجُوكُمْۚ وَٱلْفِتْنَةُ أَشَدُّ مِنَ ٱلْقَتْلِۚ وَلَا تُقَٰتِلُوهُمْ عِندَ ٱلْمَسْجِدِ ٱلْحَرَامِ حَتَّىٰ يُقَٰتِلُوكُمْ فِيهِۖ فَإِن قَٰتَلُوكُمْ فَٱقْتُلُوهُمْۗ كَذَٰلِكَ جَزَآءُ ٱلْكَٰفِرِينَ ", "translation": "And kill them [in battle] wherever you overtake them and expel them from wherever they have expelled you, and fitnah[1] is worse than killing. And do not fight them at al-Masjid al-Ḥarām until they fight you there. But if they fight you, then kill them. Such is the recompense of the disbelievers.", "words": [{"id": 1, "arabic": "وَٱقْتُلُوهُمْ", "translit": "ْmُhwُlُtْqٱَw", "root": "قتل"}, {"id": 2, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 3, "arabic": "ثَقِفْتُمُوهُمْ", "translit": "ْmُhwُmُtْfِqَht", "root": "ثقف"}, {"id": 4, "arabic": "وَأَخْرِجُوهُم", "translit": "mُhwُjgِrْhkَaʾَw", "root": "خرج"}, {"id": 5, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 6, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 7, "arabic": "أَخْرَجُوكُمْ", "translit": "ْmُkwُjgَrْhkَaʾ", "root": "خرج"}, {"id": 8, "arabic": "وَٱلْفِتْنَةُ", "translit": "ُẗَnْtِfْlٱَw", "root": "فتن"}, {"id": 9, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 10, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 11, "arabic": "ٱلْقَتْلِ", "translit": "ِlْtَqْlٱ", "root": "قتل"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "تُقَٰتِلُوهُمْ", "translit": "ْmُhwُlِtَٰqُt", "root": "قتل"}, {"id": 14, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 15, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد"}, {"id": 16, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 17, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 18, "arabic": "يُقَٰتِلُوكُمْ", "translit": "ْmُkwُlِtَٰqُy", "root": "قتل"}, {"id": 19, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 20, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 21, "arabic": "قَٰتَلُوكُمْ", "translit": "ْmُkwُlَtَٰq", "root": "قتل"}, {"id": 22, "arabic": "فَٱقْتُلُوهُمْ", "translit": "ْmُhwُlُtْqٱَf", "root": "قتل"}, {"id": 23, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 24, "arabic": "جَزَآءُ", "translit": "ُءٓāَzَjg", "root": "جزي"}, {"id": 25, "arabic": "ٱلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlٱ", "root": "كفر"}], "hasIhya": false}, {"ayah": 192, "text": "فَإِنِ ٱنتَهَوْا۟ فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "And if they cease, then indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "فَإِنِ", "translit": "ِnِiʾَf", "root": ""}, {"id": 2, "arabic": "ٱنتَهَوْا۟", "translit": "۟āْwَhَtnٱ", "root": "نهي"}, {"id": 3, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 6, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 193, "text": "وَقَٰتِلُوهُمْ حَتَّىٰ لَا تَكُونَ فِتْنَةٌ وَيَكُونَ ٱلدِّينُ لِلَّهِۖ فَإِنِ ٱنتَهَوْا۟ فَلَا عُدْوَٰنَ إِلَّا عَلَى ٱلظَّٰلِمِينَ ", "translation": "Fight them until there is no [more] fitnah and [until] religion [i.e., worship] is [acknowledged to be] for Allāh. But if they cease, then there is to be no aggression [i.e., assault] except against the oppressors.", "words": [{"id": 1, "arabic": "وَقَٰتِلُوهُمْ", "translit": "ْmُhwُlِtَٰqَw", "root": "قتل"}, {"id": 2, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "تَكُونَ", "translit": "َnwُkَt", "root": "كون"}, {"id": 5, "arabic": "فِتْنَةٌ", "translit": "ٌẗَnْtِf", "root": "فتن"}, {"id": 6, "arabic": "وَيَكُونَ", "translit": "َnwُkَyَw", "root": "كون"}, {"id": 7, "arabic": "ٱلدِّينُ", "translit": "ُnyِّdlٱ", "root": "دين"}, {"id": 8, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 9, "arabic": "فَإِنِ", "translit": "ِnِiʾَf", "root": ""}, {"id": 10, "arabic": "ٱنتَهَوْا۟", "translit": "۟āْwَhَtnٱ", "root": "نهي"}, {"id": 11, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 12, "arabic": "عُدْوَٰنَ", "translit": "َnَٰwْdُʿع", "root": "عدو"}, {"id": 13, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 14, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 15, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 194, "text": "ٱلشَّهْرُ ٱلْحَرَامُ بِٱلشَّهْرِ ٱلْحَرَامِ وَٱلْحُرُمَٰتُ قِصَاصٌۚ فَمَنِ ٱعْتَدَىٰ عَلَيْكُمْ فَٱعْتَدُوا۟ عَلَيْهِ بِمِثْلِ مَا ٱعْتَدَىٰ عَلَيْكُمْۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ مَعَ ٱلْمُتَّقِينَ ", "translation": "[Battle in] the sacred month is for [aggression committed in] the sacred month,[1] and for [all] violations is legal retribution. So whoever has assaulted you, then assault him in the same way that he has assaulted you. And fear Allāh and know that Allāh is with those who fear Him.", "words": [{"id": 1, "arabic": "ٱلشَّهْرُ", "translit": "ُrْhَّhslٱ", "root": "شهر"}, {"id": 2, "arabic": "ٱلْحَرَامُ", "translit": "ُmāَrَḥْlٱ", "root": "حرم"}, {"id": 3, "arabic": "بِٱلشَّهْرِ", "translit": "ِrْhَّhslٱِb", "root": "شهر"}, {"id": 4, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 5, "arabic": "وَٱلْحُرُمَٰتُ", "translit": "ُtَٰmُrُḥْlٱَw", "root": "حرم"}, {"id": 6, "arabic": "قِصَاصٌ", "translit": "ٌṣāَṣِq", "root": "قصص"}, {"id": 7, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 8, "arabic": "ٱعْتَدَىٰ", "translit": "ٰàَdَtْʿعٱ", "root": "عدو"}, {"id": 9, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 10, "arabic": "فَٱعْتَدُوا۟", "translit": "۟āwُdَtْʿعٱَf", "root": "عدو"}, {"id": 11, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "بِمِثْلِ", "translit": "ِlْhtِmِb", "root": "مثل"}, {"id": 13, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 14, "arabic": "ٱعْتَدَىٰ", "translit": "ٰàَdَtْʿعٱ", "root": "عدو"}, {"id": 15, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 16, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 17, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 19, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 22, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 195, "text": "وَأَنفِقُوا۟ فِى سَبِيلِ ٱللَّهِ وَلَا تُلْقُوا۟ بِأَيْدِيكُمْ إِلَى ٱلتَّهْلُكَةِۛ وَأَحْسِنُوٓا۟ۛ إِنَّ ٱللَّهَ يُحِبُّ ٱلْمُحْسِنِينَ ", "translation": "And spend in the way of Allāh and do not throw [yourselves] with your [own] hands into destruction [by refraining]. And do good; indeed, Allāh loves the doers of good.", "words": [{"id": 1, "arabic": "وَأَنفِقُوا۟", "translit": "۟āwُqِfnَaʾَw", "root": "نفق"}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تُلْقُوا۟", "translit": "۟āwُqْlُt", "root": "لقي"}, {"id": 7, "arabic": "بِأَيْدِيكُمْ", "translit": "ْmُkyِdْyَaʾِb", "root": "يدي"}, {"id": 8, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 9, "arabic": "ٱلتَّهْلُكَةِ", "translit": "ِẗَkُlْhَّtlٱ", "root": "هلك"}, {"id": 10, "arabic": "وَأَحْسِنُوٓا۟", "translit": "۟āٓwُnِsْḥَaʾَw", "root": "حسن"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 14, "arabic": "ٱلْمُحْسِنِينَ", "translit": "َnyِnِsْḥُmْlٱ", "root": "حسن"}], "hasIhya": true}, {"ayah": 196, "text": "وَأَتِمُّوا۟ ٱلْحَجَّ وَٱلْعُمْرَةَ لِلَّهِۚ فَإِنْ أُحْصِرْتُمْ فَمَا ٱسْتَيْسَرَ مِنَ ٱلْهَدْىِۖ وَلَا تَحْلِقُوا۟ رُءُوسَكُمْ حَتَّىٰ يَبْلُغَ ٱلْهَدْىُ مَحِلَّهُۥۚ فَمَن كَانَ مِنكُم مَّرِيضًا أَوْ بِهِۦٓ أَذًى مِّن رَّأْسِهِۦ فَفِدْيَةٌ مِّن صِيَامٍ أَوْ صَدَقَةٍ أَوْ نُسُكٍۚ فَإِذَآ أَمِنتُمْ فَمَن تَمَتَّعَ بِٱلْعُمْرَةِ إِلَى ٱلْحَجِّ فَمَا ٱسْتَيْسَرَ مِنَ ٱلْهَدْىِۚ فَمَن لَّمْ يَجِدْ فَصِيَامُ ثَلَٰثَةِ أَيَّامٍ فِى ٱلْحَجِّ وَسَبْعَةٍ إِذَا رَجَعْتُمْۗ تِلْكَ عَشَرَةٌ كَامِلَةٌۗ ذَٰلِكَ لِمَن لَّمْ يَكُنْ أَهْلُهُۥ حَاضِرِى ٱلْمَسْجِدِ ٱلْحَرَامِۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ ", "translation": "And complete the ḥajj and ʿumrah for Allāh. But if you are prevented, then [offer] what can be obtained with ease of sacrificial animals. And do not shave your heads until the sacrificial animal has reached its place of slaughter. And whoever among you is ill or has an ailment of the head [making shaving necessary must offer] a ransom of fasting [three days] or charity[1] or sacrifice.[2] And when you are secure,[3] then whoever performs ʿumrah [during the ḥajj months][4] followed by ḥajj [offers] what can be obtained with ease of sacrificial animals. And whoever cannot find [or afford such an animal] - then a fast of three days during ḥajj and of seven when you have returned [home]. Those are ten complete [days]. This is for those whose family is not in the area of al-Masjid al-Ḥarām. And fear Allāh and know that Allāh is severe in penalty.", "words": [{"id": 1, "arabic": "وَأَتِمُّوا۟", "translit": "۟āwُّmِtَaʾَw", "root": "تمم"}, {"id": 2, "arabic": "ٱلْحَجَّ", "translit": "َّjgَḥْlٱ", "root": "حجج"}, {"id": 3, "arabic": "وَٱلْعُمْرَةَ", "translit": "َẗَrْmُʿعْlٱَw", "root": "عمر"}, {"id": 4, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 5, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 6, "arabic": "أُحْصِرْتُمْ", "translit": "ْmُtْrِṣْḥُaʾ", "root": "حصر"}, {"id": 7, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 8, "arabic": "ٱسْتَيْسَرَ", "translit": "َrَsْyَtْsٱ", "root": "يسر"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلْهَدْىِ", "translit": "ِàْdَhْlٱ", "root": "هدي"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تَحْلِقُوا۟", "translit": "۟āwُqِlْḥَt", "root": "حلق"}, {"id": 13, "arabic": "رُءُوسَكُمْ", "translit": "ْmُkَswُءُr", "root": "راس"}, {"id": 14, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 15, "arabic": "يَبْلُغَ", "translit": "َغُlْbَy", "root": "بلغ"}, {"id": 16, "arabic": "ٱلْهَدْىُ", "translit": "ُàْdَhْlٱ", "root": "هدي"}, {"id": 17, "arabic": "مَحِلَّهُۥ", "translit": "ۥُhَّlِḥَm", "root": "حلل"}, {"id": 18, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 19, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 20, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 21, "arabic": "مَّرِيضًا", "translit": "āًḍyِrَّm", "root": "مرض"}, {"id": 22, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 23, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 24, "arabic": "أَذًى", "translit": "àًhdَaʾ", "root": "اذي"}, {"id": 25, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 26, "arabic": "رَّأْسِهِۦ", "translit": "ۦِhِsْaʾَّr", "root": "راس"}, {"id": 27, "arabic": "فَفِدْيَةٌ", "translit": "ٌẗَyْdِfَf", "root": "فدي"}, {"id": 28, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 29, "arabic": "صِيَامٍ", "translit": "ٍmāَyِṣ", "root": "صوم"}, {"id": 30, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 31, "arabic": "صَدَقَةٍ", "translit": "ٍẗَqَdَṣ", "root": "صدق"}, {"id": 32, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 33, "arabic": "نُسُكٍ", "translit": "ٍkُsُn", "root": "نسك"}, {"id": 34, "arabic": "فَإِذَآ", "translit": "ٓāَhdِiʾَf", "root": ""}, {"id": 35, "arabic": "أَمِنتُمْ", "translit": "ْmُtnِmَaʾ", "root": "امن"}, {"id": 36, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 37, "arabic": "تَمَتَّعَ", "translit": "َʿعَّtَmَt", "root": "متع"}, {"id": 38, "arabic": "بِٱلْعُمْرَةِ", "translit": "ِẗَrْmُʿعْlٱِb", "root": "عمر"}, {"id": 39, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 40, "arabic": "ٱلْحَجِّ", "translit": "ِّjgَḥْlٱ", "root": "حجج"}, {"id": 41, "arabic": "فَمَا", "translit": "āَmَf", "root": ""}, {"id": 42, "arabic": "ٱسْتَيْسَرَ", "translit": "َrَsْyَtْsٱ", "root": "يسر"}, {"id": 43, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 44, "arabic": "ٱلْهَدْىِ", "translit": "ِàْdَhْlٱ", "root": "هدي"}, {"id": 45, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 46, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 47, "arabic": "يَجِدْ", "translit": "ْdِjgَy", "root": "وجد"}, {"id": 48, "arabic": "فَصِيَامُ", "translit": "ُmāَyِṣَf", "root": "صوم"}, {"id": 49, "arabic": "ثَلَٰثَةِ", "translit": "ِẗَhtَٰlَht", "root": "ثلث"}, {"id": 50, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 51, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 52, "arabic": "ٱلْحَجِّ", "translit": "ِّjgَḥْlٱ", "root": "حجج"}, {"id": 53, "arabic": "وَسَبْعَةٍ", "translit": "ٍẗَʿعْbَsَw", "root": "سبع"}, {"id": 54, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 55, "arabic": "رَجَعْتُمْ", "translit": "ْmُtْʿعَjgَr", "root": "رجع"}, {"id": 56, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 57, "arabic": "عَشَرَةٌ", "translit": "ٌẗَrَhsَʿع", "root": "عشر"}, {"id": 58, "arabic": "كَامِلَةٌ", "translit": "ٌẗَlِmāَk", "root": "كمل"}, {"id": 59, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 60, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 61, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 62, "arabic": "يَكُنْ", "translit": "ْnُkَy", "root": "كون"}, {"id": 63, "arabic": "أَهْلُهُۥ", "translit": "ۥُhُlْhَaʾ", "root": "اهل"}, {"id": 64, "arabic": "حَاضِرِى", "translit": "àِrِḍāَḥ", "root": "حضر"}, {"id": 65, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد"}, {"id": 66, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 67, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 68, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 69, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 70, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 71, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 72, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 73, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}], "hasIhya": true}, {"ayah": 197, "text": "ٱلْحَجُّ أَشْهُرٌ مَّعْلُومَٰتٌۚ فَمَن فَرَضَ فِيهِنَّ ٱلْحَجَّ فَلَا رَفَثَ وَلَا فُسُوقَ وَلَا جِدَالَ فِى ٱلْحَجِّۗ وَمَا تَفْعَلُوا۟ مِنْ خَيْرٍ يَعْلَمْهُ ٱللَّهُۗ وَتَزَوَّدُوا۟ فَإِنَّ خَيْرَ ٱلزَّادِ ٱلتَّقْوَىٰۚ وَٱتَّقُونِ يَٰٓأُو۟لِى ٱلْأَلْبَٰبِ ", "translation": "Ḥajj is [during] well-known months,[1] so whoever has made ḥajj obligatory upon himself therein [by entering the state of iḥrām], there is [to be for him] no sexual relations and no disobedience and no disputing during ḥajj. And whatever good you do - Allāh knows it. And take provisions, but indeed, the best provision is fear of Allāh. And fear Me, O you of understanding.", "words": [{"id": 1, "arabic": "ٱلْحَجُّ", "translit": "ُّjgَḥْlٱ", "root": "حجج"}, {"id": 2, "arabic": "أَشْهُرٌ", "translit": "ٌrُhْhsَaʾ", "root": "شهر"}, {"id": 3, "arabic": "مَّعْلُومَٰتٌ", "translit": "ٌtَٰmwُlْʿعَّm", "root": "علم"}, {"id": 4, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 5, "arabic": "فَرَضَ", "translit": "َḍَrَf", "root": "فرض"}, {"id": 6, "arabic": "فِيهِنَّ", "translit": "َّnِhyِf", "root": ""}, {"id": 7, "arabic": "ٱلْحَجَّ", "translit": "َّjgَḥْlٱ", "root": "حجج"}, {"id": 8, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 9, "arabic": "رَفَثَ", "translit": "َhtَfَr", "root": "رفث"}, {"id": 10, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 11, "arabic": "فُسُوقَ", "translit": "َqwُsُf", "root": "فسق"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "جِدَالَ", "translit": "َlāَdِjg", "root": "جدل"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ٱلْحَجِّ", "translit": "ِّjgَḥْlٱ", "root": "حجج"}, {"id": 16, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 17, "arabic": "تَفْعَلُوا۟", "translit": "۟āwُlَʿعْfَt", "root": "فعل"}, {"id": 18, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 19, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 20, "arabic": "يَعْلَمْهُ", "translit": "ُhْmَlْʿعَy", "root": "علم"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَتَزَوَّدُوا۟", "translit": "۟āwُdَّwَzَtَw", "root": "زود"}, {"id": 23, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 24, "arabic": "خَيْرَ", "translit": "َrْyَhk", "root": "خير"}, {"id": 25, "arabic": "ٱلزَّادِ", "translit": "ِdāَّzlٱ", "root": "زود"}, {"id": 26, "arabic": "ٱلتَّقْوَىٰ", "translit": "ٰàَwْqَّtlٱ", "root": "وقي"}, {"id": 27, "arabic": "وَٱتَّقُونِ", "translit": "ِnwُqَّtٱَw", "root": "وقي"}, {"id": 28, "arabic": "يَٰٓأُو۟لِى", "translit": "àِl۟wُaʾَٰٓy", "root": ""}, {"id": 29, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}], "hasIhya": true}, {"ayah": 198, "text": "لَيْسَ عَلَيْكُمْ جُنَاحٌ أَن تَبْتَغُوا۟ فَضْلًا مِّن رَّبِّكُمْۚ فَإِذَآ أَفَضْتُم مِّنْ عَرَفَٰتٍ فَٱذْكُرُوا۟ ٱللَّهَ عِندَ ٱلْمَشْعَرِ ٱلْحَرَامِۖ وَٱذْكُرُوهُ كَمَا هَدَىٰكُمْ وَإِن كُنتُم مِّن قَبْلِهِۦ لَمِنَ ٱلضَّآلِّينَ ", "translation": "There is no blame upon you for seeking bounty[1] from your Lord [during ḥajj]. But when you depart from ʿArafāt, remember Allāh at al-Mashʿar al-Ḥarām.[2] And remember Him, as He has guided you, for indeed, you were before that among those astray.", "words": [{"id": 1, "arabic": "لَيْسَ", "translit": "َsْyَl", "root": "ليس"}, {"id": 2, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "جُنَاحٌ", "translit": "ٌḥāَnُjg", "root": "جنح"}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "تَبْتَغُوا۟", "translit": "۟āwُغَtْbَt", "root": "بغي"}, {"id": 6, "arabic": "فَضْلًا", "translit": "āًlْḍَf", "root": "فضل"}, {"id": 7, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 8, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 9, "arabic": "فَإِذَآ", "translit": "ٓāَhdِiʾَf", "root": ""}, {"id": 10, "arabic": "أَفَضْتُم", "translit": "mُtْḍَfَaʾ", "root": "فيض"}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "عَرَفَٰتٍ", "translit": "ٍtَٰfَrَʿع", "root": "عرف"}, {"id": 13, "arabic": "فَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَf", "root": "ذكر"}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 16, "arabic": "ٱلْمَشْعَرِ", "translit": "ِrَʿعْhsَmْlٱ", "root": "شعر"}, {"id": 17, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 18, "arabic": "وَٱذْكُرُوهُ", "translit": "ُhwُrُkْhdٱَw", "root": "ذكر"}, {"id": 19, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 20, "arabic": "هَدَىٰكُمْ", "translit": "ْmُkٰàَdَh", "root": "هدي"}, {"id": 21, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 22, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 23, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 24, "arabic": "قَبْلِهِۦ", "translit": "ۦِhِlْbَq", "root": "قبل"}, {"id": 25, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 26, "arabic": "ٱلضَّآلِّينَ", "translit": "َnyِّlٓāَّḍlٱ", "root": "ضلل"}], "hasIhya": true}, {"ayah": 199, "text": "ثُمَّ أَفِيضُوا۟ مِنْ حَيْثُ أَفَاضَ ٱلنَّاسُ وَٱسْتَغْفِرُوا۟ ٱللَّهَۚ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "Then depart from the place from where [all] the people depart and ask forgiveness of Allāh. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "أَفِيضُوا۟", "translit": "۟āwُḍyِfَaʾ", "root": "فيض"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 5, "arabic": "أَفَاضَ", "translit": "َḍāَfَaʾ", "root": "فيض"}, {"id": 6, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 7, "arabic": "وَٱسْتَغْفِرُوا۟", "translit": "۟āwُrِfْغَtْsٱَw", "root": "غفر"}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 12, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 200, "text": "فَإِذَا قَضَيْتُم مَّنَٰسِكَكُمْ فَٱذْكُرُوا۟ ٱللَّهَ كَذِكْرِكُمْ ءَابَآءَكُمْ أَوْ أَشَدَّ ذِكْرًاۗ فَمِنَ ٱلنَّاسِ مَن يَقُولُ رَبَّنَآ ءَاتِنَا فِى ٱلدُّنْيَا وَمَا لَهُۥ فِى ٱلْءَاخِرَةِ مِنْ خَلَٰقٍ ", "translation": "And when you have completed your rites, remember Allāh like your [previous] remembrance of your fathers or with [much] greater remembrance. And among the people is he who says, \"Our Lord, give us in this world,\" and he will have in the Hereafter no share.", "words": [{"id": 1, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 2, "arabic": "قَضَيْتُم", "translit": "mُtْyَḍَq", "root": "قضي"}, {"id": 3, "arabic": "مَّنَٰسِكَكُمْ", "translit": "ْmُkَkِsَٰnَّm", "root": "نسك"}, {"id": 4, "arabic": "فَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَf", "root": "ذكر"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "كَذِكْرِكُمْ", "translit": "ْmُkِrْkِhdَk", "root": "ذكر"}, {"id": 7, "arabic": "ءَابَآءَكُمْ", "translit": "ْmُkَءٓāَbāَء", "root": "ابو"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "أَشَدَّ", "translit": "َّdَhsَaʾ", "root": "شدد"}, {"id": 10, "arabic": "ذِكْرًا", "translit": "āًrْkِhd", "root": "ذكر"}, {"id": 11, "arabic": "فَمِنَ", "translit": "َnِmَf", "root": ""}, {"id": 12, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 13, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 14, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 15, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 16, "arabic": "ءَاتِنَا", "translit": "āَnِtāَء", "root": "اتي"}, {"id": 17, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 18, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 19, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 20, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 21, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 22, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 23, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 24, "arabic": "خَلَٰقٍ", "translit": "ٍqَٰlَhk", "root": "خلق"}], "hasIhya": true}, {"ayah": 201, "text": "وَمِنْهُم مَّن يَقُولُ رَبَّنَآ ءَاتِنَا فِى ٱلدُّنْيَا حَسَنَةً وَفِى ٱلْءَاخِرَةِ حَسَنَةً وَقِنَا عَذَابَ ٱلنَّارِ ", "translation": "But among them is he who says, \"Our Lord, give us in this world [that which is] good and in the Hereafter [that which is] good and protect us from the punishment of the Fire.\"", "words": [{"id": 1, "arabic": "وَمِنْهُم", "translit": "mُhْnِmَw", "root": ""}, {"id": 2, "arabic": "مَّن", "translit": "nَّm", "root": ""}, {"id": 3, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 4, "arabic": "رَبَّنَآ", "translit": "ٓāَnَّbَr", "root": "ربب"}, {"id": 5, "arabic": "ءَاتِنَا", "translit": "āَnِtāَء", "root": "اتي"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 8, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 9, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 10, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 11, "arabic": "حَسَنَةً", "translit": "ًẗَnَsَḥ", "root": "حسن"}, {"id": 12, "arabic": "وَقِنَا", "translit": "āَnِqَw", "root": "وقي"}, {"id": 13, "arabic": "عَذَابَ", "translit": "َbāَhdَʿع", "root": "عذب"}, {"id": 14, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": true}, {"ayah": 202, "text": "أُو۟لَٰٓئِكَ لَهُمْ نَصِيبٌ مِّمَّا كَسَبُوا۟ۚ وَٱللَّهُ سَرِيعُ ٱلْحِسَابِ ", "translation": "Those will have a share of what they have earned, and Allāh is swift in account.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 3, "arabic": "نَصِيبٌ", "translit": "ٌbyِṣَn", "root": "نصب"}, {"id": 4, "arabic": "مِّمَّا", "translit": "āَّmِّm", "root": ""}, {"id": 5, "arabic": "كَسَبُوا۟", "translit": "۟āwُbَsَk", "root": "كسب"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "سَرِيعُ", "translit": "ُʿعyِrَs", "root": "سرع"}, {"id": 8, "arabic": "ٱلْحِسَابِ", "translit": "ِbāَsِḥْlٱ", "root": "حسب"}], "hasIhya": false}, {"ayah": 203, "text": "وَٱذْكُرُوا۟ ٱللَّهَ فِىٓ أَيَّامٍ مَّعْدُودَٰتٍۚ فَمَن تَعَجَّلَ فِى يَوْمَيْنِ فَلَآ إِثْمَ عَلَيْهِ وَمَن تَأَخَّرَ فَلَآ إِثْمَ عَلَيْهِۚ لِمَنِ ٱتَّقَىٰۗ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّكُمْ إِلَيْهِ تُحْشَرُونَ ", "translation": "And remember Allāh during [specific] numbered days. Then whoever hastens [his departure] in two days - there is no sin upon him; and whoever delays [until the third] - there is no sin upon him - for him who fears Allāh. And fear Allāh and know that unto Him you will be gathered.", "words": [{"id": 1, "arabic": "وَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَw", "root": "ذكر"}, {"id": 2, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 4, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 5, "arabic": "مَّعْدُودَٰتٍ", "translit": "ٍtَٰdwُdْʿعَّm", "root": "عدد"}, {"id": 6, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 7, "arabic": "تَعَجَّلَ", "translit": "َlَّjgَʿعَt", "root": "عجل"}, {"id": 8, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 9, "arabic": "يَوْمَيْنِ", "translit": "ِnْyَmْwَy", "root": "يوم"}, {"id": 10, "arabic": "فَلَآ", "translit": "ٓāَlَf", "root": ""}, {"id": 11, "arabic": "إِثْمَ", "translit": "َmْhtِiʾ", "root": "اثم"}, {"id": 12, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 14, "arabic": "تَأَخَّرَ", "translit": "َrَّhkَaʾَt", "root": "اخر"}, {"id": 15, "arabic": "فَلَآ", "translit": "ٓāَlَf", "root": ""}, {"id": 16, "arabic": "إِثْمَ", "translit": "َmْhtِiʾ", "root": "اثم"}, {"id": 17, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 18, "arabic": "لِمَنِ", "translit": "ِnَmِl", "root": ""}, {"id": 19, "arabic": "ٱتَّقَىٰ", "translit": "ٰàَqَّtٱ", "root": "وقي"}, {"id": 20, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 21, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 23, "arabic": "أَنَّكُمْ", "translit": "ْmُkَّnَaʾ", "root": ""}, {"id": 24, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 25, "arabic": "تُحْشَرُونَ", "translit": "َnwُrَhsْḥُt", "root": "حشر"}], "hasIhya": false}, {"ayah": 204, "text": "وَمِنَ ٱلنَّاسِ مَن يُعْجِبُكَ قَوْلُهُۥ فِى ٱلْحَيَوٰةِ ٱلدُّنْيَا وَيُشْهِدُ ٱللَّهَ عَلَىٰ مَا فِى قَلْبِهِۦ وَهُوَ أَلَدُّ ٱلْخِصَامِ ", "translation": "And of the people is he whose speech pleases you in worldly life, and he calls Allāh to witness as to what is in his heart, yet he is the fiercest of opponents.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يُعْجِبُكَ", "translit": "َkُbِjgْʿعُy", "root": "عجب"}, {"id": 5, "arabic": "قَوْلُهُۥ", "translit": "ۥُhُlْwَq", "root": "قول"}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلْحَيَوٰةِ", "translit": "ِẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 8, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 9, "arabic": "وَيُشْهِدُ", "translit": "ُdِhْhsُyَw", "root": "شهد"}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "قَلْبِهِۦ", "translit": "ۦِhِbْlَq", "root": "قلب"}, {"id": 15, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 16, "arabic": "أَلَدُّ", "translit": "ُّdَlَaʾ", "root": "لدد"}, {"id": 17, "arabic": "ٱلْخِصَامِ", "translit": "ِmāَṣِhkْlٱ", "root": "خصم"}], "hasIhya": true}, {"ayah": 205, "text": "وَإِذَا تَوَلَّىٰ سَعَىٰ فِى ٱلْأَرْضِ لِيُفْسِدَ فِيهَا وَيُهْلِكَ ٱلْحَرْثَ وَٱلنَّسْلَۗ وَٱللَّهُ لَا يُحِبُّ ٱلْفَسَادَ ", "translation": "And when he goes away, he strives throughout the land to cause corruption therein and destroy crops and animals. And Allāh does not like corruption.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "تَوَلَّىٰ", "translit": "ٰàَّlَwَt", "root": "ولي"}, {"id": 3, "arabic": "سَعَىٰ", "translit": "ٰàَʿعَs", "root": "سعي"}, {"id": 4, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 5, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 6, "arabic": "لِيُفْسِدَ", "translit": "َdِsْfُyِl", "root": "فسد"}, {"id": 7, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 8, "arabic": "وَيُهْلِكَ", "translit": "َkِlْhُyَw", "root": "هلك"}, {"id": 9, "arabic": "ٱلْحَرْثَ", "translit": "َhtْrَḥْlٱ", "root": "حرث"}, {"id": 10, "arabic": "وَٱلنَّسْلَ", "translit": "َlْsَّnlٱَw", "root": "نسل"}, {"id": 11, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 12, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 13, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 14, "arabic": "ٱلْفَسَادَ", "translit": "َdāَsَfْlٱ", "root": "فسد"}], "hasIhya": false}, {"ayah": 206, "text": "وَإِذَا قِيلَ لَهُ ٱتَّقِ ٱللَّهَ أَخَذَتْهُ ٱلْعِزَّةُ بِٱلْإِثْمِۚ فَحَسْبُهُۥ جَهَنَّمُۚ وَلَبِئْسَ ٱلْمِهَادُ ", "translation": "And when it is said to him, \"Fear Allāh,\" pride in the sin takes hold of him. Sufficient for him is Hellfire, and how wretched is the resting place.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُ", "translit": "ُhَl", "root": ""}, {"id": 4, "arabic": "ٱتَّقِ", "translit": "ِqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "أَخَذَتْهُ", "translit": "ُhْtَhdَhkَaʾ", "root": "اخذ"}, {"id": 7, "arabic": "ٱلْعِزَّةُ", "translit": "ُẗَّzِʿعْlٱ", "root": "عزز"}, {"id": 8, "arabic": "بِٱلْإِثْمِ", "translit": "ِmْhtِiʾْlٱِb", "root": "اثم"}, {"id": 9, "arabic": "فَحَسْبُهُۥ", "translit": "ۥُhُbْsَḥَf", "root": "حسب"}, {"id": 10, "arabic": "جَهَنَّمُ", "translit": "ُmَّnَhَjg", "root": ""}, {"id": 11, "arabic": "وَلَبِئْسَ", "translit": "َsْyʾِbَlَw", "root": "باس"}, {"id": 12, "arabic": "ٱلْمِهَادُ", "translit": "ُdāَhِmْlٱ", "root": "مهد"}], "hasIhya": true}, {"ayah": 207, "text": "وَمِنَ ٱلنَّاسِ مَن يَشْرِى نَفْسَهُ ٱبْتِغَآءَ مَرْضَاتِ ٱللَّهِۗ وَٱللَّهُ رَءُوفٌۢ بِٱلْعِبَادِ ", "translation": "And of the people is he who sells himself, seeking means to the approval of Allāh. And Allāh is Kind to [His] servants.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَشْرِى", "translit": "àِrْhsَy", "root": "شري"}, {"id": 5, "arabic": "نَفْسَهُ", "translit": "ُhَsْfَn", "root": "نفس"}, {"id": 6, "arabic": "ٱبْتِغَآءَ", "translit": "َءٓāَغِtْbٱ", "root": "بغي"}, {"id": 7, "arabic": "مَرْضَاتِ", "translit": "ِtāَḍْrَm", "root": "رضو"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 10, "arabic": "رَءُوفٌۢ", "translit": "ٌۢfwُءَr", "root": "راف"}, {"id": 11, "arabic": "بِٱلْعِبَادِ", "translit": "ِdāَbِʿعْlٱِb", "root": "عبد"}], "hasIhya": true}, {"ayah": 208, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱدْخُلُوا۟ فِى ٱلسِّلْمِ كَآفَّةً وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ ٱلشَّيْطَٰنِۚ إِنَّهُۥ لَكُمْ عَدُوٌّ مُّبِينٌ ", "translation": "O you who have believed, enter into Islām completely [and perfectly] and do not follow the footsteps of Satan. Indeed, he is to you a clear enemy.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱدْخُلُوا۟", "translit": "۟āwُlُhkْdٱ", "root": "دخل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسِّلْمِ", "translit": "ِmْlِّslٱ", "root": "سلم"}, {"id": 7, "arabic": "كَآفَّةً", "translit": "ًẗَّfٓāَk", "root": "كفف"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "تَتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtَt", "root": "تبع"}, {"id": 10, "arabic": "خُطُوَٰتِ", "translit": "ِtَٰwُṭُhk", "root": "خطو"}, {"id": 11, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 12, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 13, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 14, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 15, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": true}, {"ayah": 209, "text": "فَإِن زَلَلْتُم مِّنۢ بَعْدِ مَا جَآءَتْكُمُ ٱلْبَيِّنَٰتُ فَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ ", "translation": "But if you slip [i.e., deviate] after clear proofs have come to you, then know that Allāh is Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "زَلَلْتُم", "translit": "mُtْlَlَz", "root": "زلل"}, {"id": 3, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 4, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "جَآءَتْكُمُ", "translit": "ُmُkْtَءٓāَjg", "root": "جيا"}, {"id": 7, "arabic": "ٱلْبَيِّنَٰتُ", "translit": "ُtَٰnِّyَbْlٱ", "root": "بين"}, {"id": 8, "arabic": "فَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَf", "root": "علم"}, {"id": 9, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 12, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 210, "text": "هَلْ يَنظُرُونَ إِلَّآ أَن يَأْتِيَهُمُ ٱللَّهُ فِى ظُلَلٍ مِّنَ ٱلْغَمَامِ وَٱلْمَلَٰٓئِكَةُ وَقُضِىَ ٱلْأَمْرُۚ وَإِلَى ٱللَّهِ تُرْجَعُ ٱلْأُمُورُ ", "translation": "Do they await but that Allāh should come to them in covers of clouds and the angels [as well] and the matter is [then] decided? And to Allāh [all] matters are returned.", "words": [{"id": 1, "arabic": "هَلْ", "translit": "ْlَh", "root": ""}, {"id": 2, "arabic": "يَنظُرُونَ", "translit": "َnwُrُẓnَy", "root": "نظر"}, {"id": 3, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 4, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 5, "arabic": "يَأْتِيَهُمُ", "translit": "ُmُhَyِtْaʾَy", "root": "اتي"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ظُلَلٍ", "translit": "ٍlَlُẓ", "root": "ظلل"}, {"id": 9, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 10, "arabic": "ٱلْغَمَامِ", "translit": "ِmāَmَغْlٱ", "root": "غمم"}, {"id": 11, "arabic": "وَٱلْمَلَٰٓئِكَةُ", "translit": "ُẗَkِyʾَٰٓlَmْlٱَw", "root": "ملك"}, {"id": 12, "arabic": "وَقُضِىَ", "translit": "َàِḍُqَw", "root": "قضي"}, {"id": 13, "arabic": "ٱلْأَمْرُ", "translit": "ُrْmَaʾْlٱ", "root": "امر"}, {"id": 14, "arabic": "وَإِلَى", "translit": "àَlِiʾَw", "root": ""}, {"id": 15, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "تُرْجَعُ", "translit": "ُʿعَjgْrُt", "root": "رجع"}, {"id": 17, "arabic": "ٱلْأُمُورُ", "translit": "ُrwُmُaʾْlٱ", "root": "امر"}], "hasIhya": false}, {"ayah": 211, "text": "سَلْ بَنِىٓ إِسْرَٰٓءِيلَ كَمْ ءَاتَيْنَٰهُم مِّنْ ءَايَةٍۭ بَيِّنَةٍۗ وَمَن يُبَدِّلْ نِعْمَةَ ٱللَّهِ مِنۢ بَعْدِ مَا جَآءَتْهُ فَإِنَّ ٱللَّهَ شَدِيدُ ٱلْعِقَابِ ", "translation": "Ask the Children of Israel how many a sign of evidence We have given them. And whoever exchanges the favor of Allāh [for disbelief] after it has come to him - then indeed, Allāh is severe in penalty.", "words": [{"id": 1, "arabic": "سَلْ", "translit": "ْlَs", "root": "سال"}, {"id": 2, "arabic": "بَنِىٓ", "translit": "ٓàِnَb", "root": "بني"}, {"id": 3, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 4, "arabic": "كَمْ", "translit": "ْmَk", "root": ""}, {"id": 5, "arabic": "ءَاتَيْنَٰهُم", "translit": "mُhَٰnْyَtāَء", "root": "اتي"}, {"id": 6, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 7, "arabic": "ءَايَةٍۭ", "translit": "ٍۭẗَyāَء", "root": "ايي"}, {"id": 8, "arabic": "بَيِّنَةٍ", "translit": "ٍẗَnِّyَb", "root": "بين"}, {"id": 9, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 10, "arabic": "يُبَدِّلْ", "translit": "ْlِّdَbُy", "root": "بدل"}, {"id": 11, "arabic": "نِعْمَةَ", "translit": "َẗَmْʿعِn", "root": "نعم"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 14, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "جَآءَتْهُ", "translit": "ُhْtَءٓāَjg", "root": "جيا"}, {"id": 17, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 18, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 20, "arabic": "ٱلْعِقَابِ", "translit": "ِbāَqِʿعْlٱ", "root": "عقب"}], "hasIhya": false}, {"ayah": 212, "text": "زُيِّنَ لِلَّذِينَ كَفَرُوا۟ ٱلْحَيَوٰةُ ٱلدُّنْيَا وَيَسْخَرُونَ مِنَ ٱلَّذِينَ ءَامَنُواۘ وَٱلَّذِينَ ٱتَّقَوْا۟ فَوْقَهُمْ يَوْمَ ٱلْقِيَٰمَةِۗ وَٱللَّهُ يَرْزُقُ مَن يَشَآءُ بِغَيْرِ حِسَابٍ ", "translation": "Beautified for those who disbelieve is the life of this world, and they ridicule those who believe. But those who fear Allāh are above them on the Day of Resurrection. And Allāh gives provision to whom He wills without account.", "words": [{"id": 1, "arabic": "زُيِّنَ", "translit": "َnِّyُz", "root": "زين"}, {"id": 2, "arabic": "لِلَّذِينَ", "translit": "َnyِhdَّlِl", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "ٱلْحَيَوٰةُ", "translit": "ُẗٰwَyَḥْlٱ", "root": "حيي"}, {"id": 5, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 6, "arabic": "وَيَسْخَرُونَ", "translit": "َnwُrَhkْsَyَw", "root": "سخر"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 10, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 11, "arabic": "ٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱ", "root": "وقي"}, {"id": 12, "arabic": "فَوْقَهُمْ", "translit": "ْmُhَqْwَf", "root": "فوق"}, {"id": 13, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 14, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 15, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 16, "arabic": "يَرْزُقُ", "translit": "ُqُzْrَy", "root": "رزق"}, {"id": 17, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 18, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 19, "arabic": "بِغَيْرِ", "translit": "ِrْyَغِb", "root": "غير"}, {"id": 20, "arabic": "حِسَابٍ", "translit": "ٍbāَsِḥ", "root": "حسب"}], "hasIhya": true}, {"ayah": 213, "text": "كَانَ ٱلنَّاسُ أُمَّةً وَٰحِدَةً فَبَعَثَ ٱللَّهُ ٱلنَّبِيِّۦنَ مُبَشِّرِينَ وَمُنذِرِينَ وَأَنزَلَ مَعَهُمُ ٱلْكِتَٰبَ بِٱلْحَقِّ لِيَحْكُمَ بَيْنَ ٱلنَّاسِ فِيمَا ٱخْتَلَفُوا۟ فِيهِۚ وَمَا ٱخْتَلَفَ فِيهِ إِلَّا ٱلَّذِينَ أُوتُوهُ مِنۢ بَعْدِ مَا جَآءَتْهُمُ ٱلْبَيِّنَٰتُ بَغْيًۢا بَيْنَهُمْۖ فَهَدَى ٱللَّهُ ٱلَّذِينَ ءَامَنُوا۟ لِمَا ٱخْتَلَفُوا۟ فِيهِ مِنَ ٱلْحَقِّ بِإِذْنِهِۦۗ وَٱللَّهُ يَهْدِى مَن يَشَآءُ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "Mankind was [of] one religion [before their deviation]; then Allāh sent the prophets as bringers of good tidings and warners and sent down with them the Scripture in truth to judge between the people concerning that in which they differed. And none differed over it [i.e., the Scripture] except those who were given it - after the clear proofs came to them - out of jealous animosity among themselves. And Allāh guided those who believed to the truth concerning that over which they had differed, by His permission. And Allāh guides whom He wills to a straight path.", "words": [{"id": 1, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "وَٰحِدَةً", "translit": "ًẗَdِḥَٰw", "root": "وحد"}, {"id": 5, "arabic": "فَبَعَثَ", "translit": "َhtَʿعَbَf", "root": "بعث"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ٱلنَّبِيِّۦنَ", "translit": "َnۦِّyِbَّnlٱ", "root": "نبا"}, {"id": 8, "arabic": "مُبَشِّرِينَ", "translit": "َnyِrِّhsَbُm", "root": "بشر"}, {"id": 9, "arabic": "وَمُنذِرِينَ", "translit": "َnyِrِhdnُmَw", "root": "نذر"}, {"id": 10, "arabic": "وَأَنزَلَ", "translit": "َlَznَaʾَw", "root": "نزل"}, {"id": 11, "arabic": "مَعَهُمُ", "translit": "ُmُhَʿعَm", "root": ""}, {"id": 12, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 13, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 14, "arabic": "لِيَحْكُمَ", "translit": "َmُkْḥَyِl", "root": "حكم"}, {"id": 15, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 16, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 17, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 18, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 19, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 20, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 21, "arabic": "ٱخْتَلَفَ", "translit": "َfَlَtْhkٱ", "root": "خلف"}, {"id": 22, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 23, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 24, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 25, "arabic": "أُوتُوهُ", "translit": "ُhwُtwُaʾ", "root": "اتي"}, {"id": 26, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 27, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 28, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 29, "arabic": "جَآءَتْهُمُ", "translit": "ُmُhْtَءٓāَjg", "root": "جيا"}, {"id": 30, "arabic": "ٱلْبَيِّنَٰتُ", "translit": "ُtَٰnِّyَbْlٱ", "root": "بين"}, {"id": 31, "arabic": "بَغْيًۢا", "translit": "āًۢyْغَb", "root": "بغي"}, {"id": 32, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 33, "arabic": "فَهَدَى", "translit": "àَdَhَf", "root": "هدي"}, {"id": 34, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 35, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 36, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 37, "arabic": "لِمَا", "translit": "āَmِl", "root": ""}, {"id": 38, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 39, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 40, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 41, "arabic": "ٱلْحَقِّ", "translit": "ِّqَḥْlٱ", "root": "حقق"}, {"id": 42, "arabic": "بِإِذْنِهِۦ", "translit": "ۦِhِnْhdِiʾِb", "root": "اذن"}, {"id": 43, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 44, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 45, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 46, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 47, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 48, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 49, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": true}, {"ayah": 214, "text": "أَمْ حَسِبْتُمْ أَن تَدْخُلُوا۟ ٱلْجَنَّةَ وَلَمَّا يَأْتِكُم مَّثَلُ ٱلَّذِينَ خَلَوْا۟ مِن قَبْلِكُمۖ مَّسَّتْهُمُ ٱلْبَأْسَآءُ وَٱلضَّرَّآءُ وَزُلْزِلُوا۟ حَتَّىٰ يَقُولَ ٱلرَّسُولُ وَٱلَّذِينَ ءَامَنُوا۟ مَعَهُۥ مَتَىٰ نَصْرُ ٱللَّهِۗ أَلَآ إِنَّ نَصْرَ ٱللَّهِ قَرِيبٌ ", "translation": "Or do you think that you will enter Paradise while such [trial] has not yet come to you as came to those who passed on before you? They were touched by poverty and hardship and were shaken until [even their] messenger and those who believed with him said, \"When is the help of Allāh?\" Unquestionably, the help of Allāh is near.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "حَسِبْتُمْ", "translit": "ْmُtْbِsَḥ", "root": "حسب"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تَدْخُلُوا۟", "translit": "۟āwُlُhkْdَt", "root": "دخل"}, {"id": 5, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 6, "arabic": "وَلَمَّا", "translit": "āَّmَlَw", "root": ""}, {"id": 7, "arabic": "يَأْتِكُم", "translit": "mُkِtْaʾَy", "root": "اتي"}, {"id": 8, "arabic": "مَّثَلُ", "translit": "ُlَhtَّm", "root": "مثل"}, {"id": 9, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 10, "arabic": "خَلَوْا۟", "translit": "۟āْwَlَhk", "root": "خلو"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "قَبْلِكُم", "translit": "mُkِlْbَq", "root": "قبل"}, {"id": 13, "arabic": "مَّسَّتْهُمُ", "translit": "ُmُhْtَّsَّm", "root": "مسس"}, {"id": 14, "arabic": "ٱلْبَأْسَآءُ", "translit": "ُءٓāَsْaʾَbْlٱ", "root": "باس"}, {"id": 15, "arabic": "وَٱلضَّرَّآءُ", "translit": "ُءٓāَّrَّḍlٱَw", "root": "ضرر"}, {"id": 16, "arabic": "وَزُلْزِلُوا۟", "translit": "۟āwُlِzْlُzَw", "root": "زلزل"}, {"id": 17, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 18, "arabic": "يَقُولَ", "translit": "َlwُqَy", "root": "قول"}, {"id": 19, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 20, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 21, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 22, "arabic": "مَعَهُۥ", "translit": "ۥُhَʿعَm", "root": ""}, {"id": 23, "arabic": "مَتَىٰ", "translit": "ٰàَtَm", "root": ""}, {"id": 24, "arabic": "نَصْرُ", "translit": "ُrْṣَn", "root": "نصر"}, {"id": 25, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "أَلَآ", "translit": "ٓāَlَaʾ", "root": ""}, {"id": 27, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 28, "arabic": "نَصْرَ", "translit": "َrْṣَn", "root": "نصر"}, {"id": 29, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "قَرِيبٌ", "translit": "ٌbyِrَq", "root": "قرب"}], "hasIhya": false}, {"ayah": 215, "text": "يَسْـَٔلُونَكَ مَاذَا يُنفِقُونَۖ قُلْ مَآ أَنفَقْتُم مِّنْ خَيْرٍ فَلِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينِ وَٱبْنِ ٱلسَّبِيلِۗ وَمَا تَفْعَلُوا۟ مِنْ خَيْرٍ فَإِنَّ ٱللَّهَ بِهِۦ عَلِيمٌ ", "translation": "They ask you, [O Muḥammad], what they should spend. Say, \"Whatever you spend of good is [to be] for parents and relatives and orphans and the needy and the traveler. And whatever you do of good - indeed, Allāh is Knowing of it.\"", "words": [{"id": 1, "arabic": "يَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَy", "root": "سال"}, {"id": 2, "arabic": "مَاذَا", "translit": "āَhdāَm", "root": ""}, {"id": 3, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 4, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 5, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 6, "arabic": "أَنفَقْتُم", "translit": "mُtْqَfnَaʾ", "root": "نفق"}, {"id": 7, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 8, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 9, "arabic": "فَلِلْوَٰلِدَيْنِ", "translit": "ِnْyَdِlَٰwْlِlَf", "root": "ولد"}, {"id": 10, "arabic": "وَٱلْأَقْرَبِينَ", "translit": "َnyِbَrْqَaʾْlٱَw", "root": "قرب"}, {"id": 11, "arabic": "وَٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱَw", "root": "يتم"}, {"id": 12, "arabic": "وَٱلْمَسَٰكِينِ", "translit": "ِnyِkَٰsَmْlٱَw", "root": "سكن"}, {"id": 13, "arabic": "وَٱبْنِ", "translit": "ِnْbٱَw", "root": "بني"}, {"id": 14, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 15, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 16, "arabic": "تَفْعَلُوا۟", "translit": "۟āwُlَʿعْfَt", "root": "فعل"}, {"id": 17, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 18, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 19, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 20, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 21, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 22, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 216, "text": "كُتِبَ عَلَيْكُمُ ٱلْقِتَالُ وَهُوَ كُرْهٌ لَّكُمْۖ وَعَسَىٰٓ أَن تَكْرَهُوا۟ شَيْـًٔا وَهُوَ خَيْرٌ لَّكُمْۖ وَعَسَىٰٓ أَن تُحِبُّوا۟ شَيْـًٔا وَهُوَ شَرٌّ لَّكُمْۗ وَٱللَّهُ يَعْلَمُ وَأَنتُمْ لَا تَعْلَمُونَ ", "translation": "Battle has been enjoined upon you while it is hateful to you. But perhaps you hate a thing and it is good for you; and perhaps you love a thing and it is bad for you. And Allāh knows, while you know not.", "words": [{"id": 1, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 2, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْقِتَالُ", "translit": "ُlāَtِqْlٱ", "root": "قتل"}, {"id": 4, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 5, "arabic": "كُرْهٌ", "translit": "ٌhْrُk", "root": "كره"}, {"id": 6, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 7, "arabic": "وَعَسَىٰٓ", "translit": "ٰٓàَsَʿعَw", "root": "عسي"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "تَكْرَهُوا۟", "translit": "۟āwُhَrْkَt", "root": "كره"}, {"id": 10, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 11, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 12, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 13, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 14, "arabic": "وَعَسَىٰٓ", "translit": "ٰٓàَsَʿعَw", "root": "عسي"}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "تُحِبُّوا۟", "translit": "۟āwُّbِḥُt", "root": "حبب"}, {"id": 17, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 18, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 19, "arabic": "شَرٌّ", "translit": "ٌّrَhs", "root": "شرر"}, {"id": 20, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 21, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 22, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 23, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 217, "text": "يَسْـَٔلُونَكَ عَنِ ٱلشَّهْرِ ٱلْحَرَامِ قِتَالٍ فِيهِۖ قُلْ قِتَالٌ فِيهِ كَبِيرٌۖ وَصَدٌّ عَن سَبِيلِ ٱللَّهِ وَكُفْرٌۢ بِهِۦ وَٱلْمَسْجِدِ ٱلْحَرَامِ وَإِخْرَاجُ أَهْلِهِۦ مِنْهُ أَكْبَرُ عِندَ ٱللَّهِۚ وَٱلْفِتْنَةُ أَكْبَرُ مِنَ ٱلْقَتْلِۗ وَلَا يَزَالُونَ يُقَٰتِلُونَكُمْ حَتَّىٰ يَرُدُّوكُمْ عَن دِينِكُمْ إِنِ ٱسْتَطَٰعُوا۟ۚ وَمَن يَرْتَدِدْ مِنكُمْ عَن دِينِهِۦ فَيَمُتْ وَهُوَ كَافِرٌ فَأُو۟لَٰٓئِكَ حَبِطَتْ أَعْمَٰلُهُمْ فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِۖ وَأُو۟لَٰٓئِكَ أَصْحَٰبُ ٱلنَّارِۖ هُمْ فِيهَا خَٰلِدُونَ ", "translation": "They ask you about the sacred month[1] - about fighting therein. Say, \"Fighting therein is great [sin], but averting [people] from the way of Allāh and disbelief in Him and [preventing access to] al-Masjid al-Ḥarām and the expulsion of its people therefrom are greater [evil] in the sight of Allāh. And fitnah[2] is greater than killing.\" And they will continue to fight you until they turn you back from your religion if they are able. And whoever of you reverts from his religion [to disbelief] and dies while he is a disbeliever - for those, their deeds have become worthless in this world and the Hereafter, and those are the companions of the Fire; they will abide therein eternally.", "words": [{"id": 1, "arabic": "يَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَy", "root": "سال"}, {"id": 2, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 3, "arabic": "ٱلشَّهْرِ", "translit": "ِrْhَّhslٱ", "root": "شهر"}, {"id": 4, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 5, "arabic": "قِتَالٍ", "translit": "ٍlāَtِq", "root": "قتل"}, {"id": 6, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 7, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 8, "arabic": "قِتَالٌ", "translit": "ٌlāَtِq", "root": "قتل"}, {"id": 9, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 10, "arabic": "كَبِيرٌ", "translit": "ٌryِbَk", "root": "كبر"}, {"id": 11, "arabic": "وَصَدٌّ", "translit": "ٌّdَṣَw", "root": "صدد"}, {"id": 12, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 13, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 14, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "وَكُفْرٌۢ", "translit": "ٌۢrْfُkَw", "root": "كفر"}, {"id": 16, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 17, "arabic": "وَٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱَw", "root": "سجد"}, {"id": 18, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 19, "arabic": "وَإِخْرَاجُ", "translit": "ُjgāَrْhkِiʾَw", "root": "خرج"}, {"id": 20, "arabic": "أَهْلِهِۦ", "translit": "ۦِhِlْhَaʾ", "root": "اهل"}, {"id": 21, "arabic": "مِنْهُ", "translit": "ُhْnِm", "root": ""}, {"id": 22, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 23, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 24, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "وَٱلْفِتْنَةُ", "translit": "ُẗَnْtِfْlٱَw", "root": "فتن"}, {"id": 26, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 27, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 28, "arabic": "ٱلْقَتْلِ", "translit": "ِlْtَqْlٱ", "root": "قتل"}, {"id": 29, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 30, "arabic": "يَزَالُونَ", "translit": "َnwُlāَzَy", "root": "زيل"}, {"id": 31, "arabic": "يُقَٰتِلُونَكُمْ", "translit": "ْmُkَnwُlِtَٰqُy", "root": "قتل"}, {"id": 32, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 33, "arabic": "يَرُدُّوكُمْ", "translit": "ْmُkwُّdُrَy", "root": "ردد"}, {"id": 34, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 35, "arabic": "دِينِكُمْ", "translit": "ْmُkِnyِd", "root": "دين"}, {"id": 36, "arabic": "إِنِ", "translit": "ِnِiʾ", "root": ""}, {"id": 37, "arabic": "ٱسْتَطَٰعُوا۟", "translit": "۟āwُʿعَٰṭَtْsٱ", "root": "طوع"}, {"id": 38, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 39, "arabic": "يَرْتَدِدْ", "translit": "ْdِdَtْrَy", "root": "ردد"}, {"id": 40, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 41, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 42, "arabic": "دِينِهِۦ", "translit": "ۦِhِnyِd", "root": "دين"}, {"id": 43, "arabic": "فَيَمُتْ", "translit": "ْtُmَyَf", "root": "موت"}, {"id": 44, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 45, "arabic": "كَافِرٌ", "translit": "ٌrِfāَk", "root": "كفر"}, {"id": 46, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 47, "arabic": "حَبِطَتْ", "translit": "ْtَṭِbَḥ", "root": "حبط"}, {"id": 48, "arabic": "أَعْمَٰلُهُمْ", "translit": "ْmُhُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 49, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 50, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 51, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 52, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 53, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 54, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 55, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 56, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 57, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": false}, {"ayah": 218, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَٱلَّذِينَ هَاجَرُوا۟ وَجَٰهَدُوا۟ فِى سَبِيلِ ٱللَّهِ أُو۟لَٰٓئِكَ يَرْجُونَ رَحْمَتَ ٱللَّهِۚ وَٱللَّهُ غَفُورٌ رَّحِيمٌ ", "translation": "Indeed, those who have believed and those who have emigrated and fought in the cause of Allāh - those expect the mercy of Allāh. And Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "هَاجَرُوا۟", "translit": "۟āwُrَjgāَh", "root": "هجر"}, {"id": 6, "arabic": "وَجَٰهَدُوا۟", "translit": "۟āwُdَhَٰjgَw", "root": "جهد"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 9, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 10, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 11, "arabic": "يَرْجُونَ", "translit": "َnwُjgْrَy", "root": "رجو"}, {"id": 12, "arabic": "رَحْمَتَ", "translit": "َtَmْḥَr", "root": "رحم"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 15, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 16, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 219, "text": "يَسْـَٔلُونَكَ عَنِ ٱلْخَمْرِ وَٱلْمَيْسِرِۖ قُلْ فِيهِمَآ إِثْمٌ كَبِيرٌ وَمَنَٰفِعُ لِلنَّاسِ وَإِثْمُهُمَآ أَكْبَرُ مِن نَّفْعِهِمَاۗ وَيَسْـَٔلُونَكَ مَاذَا يُنفِقُونَ قُلِ ٱلْعَفْوَۗ كَذَٰلِكَ يُبَيِّنُ ٱللَّهُ لَكُمُ ٱلْءَايَٰتِ لَعَلَّكُمْ تَتَفَكَّرُونَ ", "translation": "They ask you about wine[1] and gambling. Say, \"In them is great sin and [yet, some] benefit for people. But their sin is greater than their benefit.\" And they ask you what they should spend. Say, \"The excess [beyond needs].\" Thus Allāh makes clear to you the verses [of revelation] that you might give thought", "words": [{"id": 1, "arabic": "يَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَy", "root": "سال"}, {"id": 2, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْخَمْرِ", "translit": "ِrْmَhkْlٱ", "root": "خمر"}, {"id": 4, "arabic": "وَٱلْمَيْسِرِ", "translit": "ِrِsْyَmْlٱَw", "root": "يسر"}, {"id": 5, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 6, "arabic": "فِيهِمَآ", "translit": "ٓāَmِhyِf", "root": ""}, {"id": 7, "arabic": "إِثْمٌ", "translit": "ٌmْhtِiʾ", "root": "اثم"}, {"id": 8, "arabic": "كَبِيرٌ", "translit": "ٌryِbَk", "root": "كبر"}, {"id": 9, "arabic": "وَمَنَٰفِعُ", "translit": "ُʿعِfَٰnَmَw", "root": "نفع"}, {"id": 10, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 11, "arabic": "وَإِثْمُهُمَآ", "translit": "ٓāَmُhُmْhtِiʾَw", "root": "اثم"}, {"id": 12, "arabic": "أَكْبَرُ", "translit": "ُrَbْkَaʾ", "root": "كبر"}, {"id": 13, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 14, "arabic": "نَّفْعِهِمَا", "translit": "āَmِhِʿعْfَّn", "root": "نفع"}, {"id": 15, "arabic": "وَيَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَyَw", "root": "سال"}, {"id": 16, "arabic": "مَاذَا", "translit": "āَhdāَm", "root": ""}, {"id": 17, "arabic": "يُنفِقُونَ", "translit": "َnwُqِfnُy", "root": "نفق"}, {"id": 18, "arabic": "قُلِ", "translit": "ِlُq", "root": "قول"}, {"id": 19, "arabic": "ٱلْعَفْوَ", "translit": "َwْfَʿعْlٱ", "root": "عفو"}, {"id": 20, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 21, "arabic": "يُبَيِّنُ", "translit": "ُnِّyَbُy", "root": "بين"}, {"id": 22, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 24, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 25, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 26, "arabic": "تَتَفَكَّرُونَ", "translit": "َnwُrَّkَfَtَt", "root": "فكر"}], "hasIhya": false}, {"ayah": 220, "text": "فِى ٱلدُّنْيَا وَٱلْءَاخِرَةِۗ وَيَسْـَٔلُونَكَ عَنِ ٱلْيَتَٰمَىٰۖ قُلْ إِصْلَاحٌ لَّهُمْ خَيْرٌۖ وَإِن تُخَالِطُوهُمْ فَإِخْوَٰنُكُمْۚ وَٱللَّهُ يَعْلَمُ ٱلْمُفْسِدَ مِنَ ٱلْمُصْلِحِۚ وَلَوْ شَآءَ ٱللَّهُ لَأَعْنَتَكُمْۚ إِنَّ ٱللَّهَ عَزِيزٌ حَكِيمٌ ", "translation": "To this world and the Hereafter. And they ask you about orphans. Say, \"Improvement for them is best. And if you mix your affairs with theirs - they are your brothers. And Allāh knows the corrupter from the amender. And if Allāh had willed, He could have put you in difficulty. Indeed, Allāh is Exalted in Might and Wise.\"", "words": [{"id": 1, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 2, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 3, "arabic": "وَٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱَw", "root": "اخر"}, {"id": 4, "arabic": "وَيَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَyَw", "root": "سال"}, {"id": 5, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱ", "root": "يتم"}, {"id": 7, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 8, "arabic": "إِصْلَاحٌ", "translit": "ٌḥāَlْṣِiʾ", "root": "صلح"}, {"id": 9, "arabic": "لَّهُمْ", "translit": "ْmُhَّl", "root": ""}, {"id": 10, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 11, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 12, "arabic": "تُخَالِطُوهُمْ", "translit": "ْmُhwُṭِlāَhkُt", "root": "خلط"}, {"id": 13, "arabic": "فَإِخْوَٰنُكُمْ", "translit": "ْmُkُnَٰwْhkِiʾَf", "root": "اخو"}, {"id": 14, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 15, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 16, "arabic": "ٱلْمُفْسِدَ", "translit": "َdِsْfُmْlٱ", "root": "فسد"}, {"id": 17, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 18, "arabic": "ٱلْمُصْلِحِ", "translit": "ِḥِlْṣُmْlٱ", "root": "صلح"}, {"id": 19, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 20, "arabic": "شَآءَ", "translit": "َءٓāَhs", "root": "شيا"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "لَأَعْنَتَكُمْ", "translit": "ْmُkَtَnْʿعَaʾَl", "root": "عنت"}, {"id": 23, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 24, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 26, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": false}, {"ayah": 221, "text": "وَلَا تَنكِحُوا۟ ٱلْمُشْرِكَٰتِ حَتَّىٰ يُؤْمِنَّۚ وَلَأَمَةٌ مُّؤْمِنَةٌ خَيْرٌ مِّن مُّشْرِكَةٍ وَلَوْ أَعْجَبَتْكُمْۗ وَلَا تُنكِحُوا۟ ٱلْمُشْرِكِينَ حَتَّىٰ يُؤْمِنُوا۟ۚ وَلَعَبْدٌ مُّؤْمِنٌ خَيْرٌ مِّن مُّشْرِكٍ وَلَوْ أَعْجَبَكُمْۗ أُو۟لَٰٓئِكَ يَدْعُونَ إِلَى ٱلنَّارِۖ وَٱللَّهُ يَدْعُوٓا۟ إِلَى ٱلْجَنَّةِ وَٱلْمَغْفِرَةِ بِإِذْنِهِۦۖ وَيُبَيِّنُ ءَايَٰتِهِۦ لِلنَّاسِ لَعَلَّهُمْ يَتَذَكَّرُونَ ", "translation": "And do not marry polytheistic women until they believe.[1] And a believing slave woman is better than a polytheist, even though she might please you. And do not marry polytheistic men [to your women] until they believe. And a believing slave is better than a polytheist, even though he might please you. Those invite [you] to the Fire, but Allāh invites to Paradise and to forgiveness, by His permission. And He makes clear His verses [i.e., ordinances] to the people that perhaps they may remember.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَنكِحُوا۟", "translit": "۟āwُḥِknَt", "root": "نكح"}, {"id": 3, "arabic": "ٱلْمُشْرِكَٰتِ", "translit": "ِtَٰkِrْhsُmْlٱ", "root": "شرك"}, {"id": 4, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 5, "arabic": "يُؤْمِنَّ", "translit": "َّnِmْwʾُy", "root": "امن"}, {"id": 6, "arabic": "وَلَأَمَةٌ", "translit": "ٌẗَmَaʾَlَw", "root": "امو"}, {"id": 7, "arabic": "مُّؤْمِنَةٌ", "translit": "ٌẗَnِmْwʾُّm", "root": "امن"}, {"id": 8, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 9, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 10, "arabic": "مُّشْرِكَةٍ", "translit": "ٍẗَkِrْhsُّm", "root": "شرك"}, {"id": 11, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 12, "arabic": "أَعْجَبَتْكُمْ", "translit": "ْmُkْtَbَjgْʿعَaʾ", "root": "عجب"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "تُنكِحُوا۟", "translit": "۟āwُḥِknُt", "root": "نكح"}, {"id": 15, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}, {"id": 16, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 17, "arabic": "يُؤْمِنُوا۟", "translit": "۟āwُnِmْwʾُy", "root": "امن"}, {"id": 18, "arabic": "وَلَعَبْدٌ", "translit": "ٌdْbَʿعَlَw", "root": "عبد"}, {"id": 19, "arabic": "مُّؤْمِنٌ", "translit": "ٌnِmْwʾُّm", "root": "امن"}, {"id": 20, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 21, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 22, "arabic": "مُّشْرِكٍ", "translit": "ٍkِrْhsُّm", "root": "شرك"}, {"id": 23, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 24, "arabic": "أَعْجَبَكُمْ", "translit": "ْmُkَbَjgْʿعَaʾ", "root": "عجب"}, {"id": 25, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 26, "arabic": "يَدْعُونَ", "translit": "َnwُʿعْdَy", "root": "دعو"}, {"id": 27, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 28, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 29, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 30, "arabic": "يَدْعُوٓا۟", "translit": "۟āٓwُʿعْdَy", "root": "دعو"}, {"id": 31, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 32, "arabic": "ٱلْجَنَّةِ", "translit": "ِẗَّnَjgْlٱ", "root": "جنن"}, {"id": 33, "arabic": "وَٱلْمَغْفِرَةِ", "translit": "ِẗَrِfْغَmْlٱَw", "root": "غفر"}, {"id": 34, "arabic": "بِإِذْنِهِۦ", "translit": "ۦِhِnْhdِiʾِb", "root": "اذن"}, {"id": 35, "arabic": "وَيُبَيِّنُ", "translit": "ُnِّyَbُyَw", "root": "بين"}, {"id": 36, "arabic": "ءَايَٰتِهِۦ", "translit": "ۦِhِtَٰyāَء", "root": "ايي"}, {"id": 37, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 38, "arabic": "لَعَلَّهُمْ", "translit": "ْmُhَّlَʿعَl", "root": ""}, {"id": 39, "arabic": "يَتَذَكَّرُونَ", "translit": "َnwُrَّkَhdَtَy", "root": "ذكر"}], "hasIhya": false}, {"ayah": 222, "text": "وَيَسْـَٔلُونَكَ عَنِ ٱلْمَحِيضِۖ قُلْ هُوَ أَذًى فَٱعْتَزِلُوا۟ ٱلنِّسَآءَ فِى ٱلْمَحِيضِۖ وَلَا تَقْرَبُوهُنَّ حَتَّىٰ يَطْهُرْنَۖ فَإِذَا تَطَهَّرْنَ فَأْتُوهُنَّ مِنْ حَيْثُ أَمَرَكُمُ ٱللَّهُۚ إِنَّ ٱللَّهَ يُحِبُّ ٱلتَّوَّٰبِينَ وَيُحِبُّ ٱلْمُتَطَهِّرِينَ ", "translation": "And they ask you about menstruation. Say, \"It is harm, so keep away from wives[1] during menstruation. And do not approach them until they are pure. And when they have purified themselves,[2] then come to them from where Allāh has ordained for you. Indeed, Allāh loves those who are constantly repentant and loves those who purify themselves.\"", "words": [{"id": 1, "arabic": "وَيَسْـَٔلُونَكَ", "translit": "َkَnwُlَٔـْsَyَw", "root": "سال"}, {"id": 2, "arabic": "عَنِ", "translit": "ِnَʿع", "root": ""}, {"id": 3, "arabic": "ٱلْمَحِيضِ", "translit": "ِḍyِḥَmْlٱ", "root": "حيض"}, {"id": 4, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 5, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 6, "arabic": "أَذًى", "translit": "àًhdَaʾ", "root": "اذي"}, {"id": 7, "arabic": "فَٱعْتَزِلُوا۟", "translit": "۟āwُlِzَtْʿعٱَf", "root": "عزل"}, {"id": 8, "arabic": "ٱلنِّسَآءَ", "translit": "َءٓāَsِّnlٱ", "root": "نسو"}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلْمَحِيضِ", "translit": "ِḍyِḥَmْlٱ", "root": "حيض"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تَقْرَبُوهُنَّ", "translit": "َّnُhwُbَrْqَt", "root": "قرب"}, {"id": 13, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 14, "arabic": "يَطْهُرْنَ", "translit": "َnْrُhْṭَy", "root": "طهر"}, {"id": 15, "arabic": "فَإِذَا", "translit": "āَhdِiʾَf", "root": ""}, {"id": 16, "arabic": "تَطَهَّرْنَ", "translit": "َnْrَّhَṭَt", "root": "طهر"}, {"id": 17, "arabic": "فَأْتُوهُنَّ", "translit": "َّnُhwُtْaʾَf", "root": "اتي"}, {"id": 18, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 19, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 20, "arabic": "أَمَرَكُمُ", "translit": "ُmُkَrَmَaʾ", "root": "امر"}, {"id": 21, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 22, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 23, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 25, "arabic": "ٱلتَّوَّٰبِينَ", "translit": "َnyِbَّٰwَّtlٱ", "root": "توب"}, {"id": 26, "arabic": "وَيُحِبُّ", "translit": "ُّbِḥُyَw", "root": "حبب"}, {"id": 27, "arabic": "ٱلْمُتَطَهِّرِينَ", "translit": "َnyِrِّhَṭَtُmْlٱ", "root": "طهر"}], "hasIhya": true}, {"ayah": 223, "text": "نِسَآؤُكُمْ حَرْثٌ لَّكُمْ فَأْتُوا۟ حَرْثَكُمْ أَنَّىٰ شِئْتُمْۖ وَقَدِّمُوا۟ لِأَنفُسِكُمْۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّكُم مُّلَٰقُوهُۗ وَبَشِّرِ ٱلْمُؤْمِنِينَ ", "translation": "Your wives are a place of cultivation [i.e., sowing of seed] for you, so come to your place of cultivation however you wish and put forth [righteousness] for yourselves. And fear Allāh and know that you will meet Him. And give good tidings to the believers.", "words": [{"id": 1, "arabic": "نِسَآؤُكُمْ", "translit": "ْmُkُwʾٓāَsِn", "root": "نسو"}, {"id": 2, "arabic": "حَرْثٌ", "translit": "ٌhtْrَḥ", "root": "حرث"}, {"id": 3, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 4, "arabic": "فَأْتُوا۟", "translit": "۟āwُtْaʾَf", "root": "اتي"}, {"id": 5, "arabic": "حَرْثَكُمْ", "translit": "ْmُkَhtْrَḥ", "root": "حرث"}, {"id": 6, "arabic": "أَنَّىٰ", "translit": "ٰàَّnَaʾ", "root": ""}, {"id": 7, "arabic": "شِئْتُمْ", "translit": "ْmُtْyʾِhs", "root": "شيا"}, {"id": 8, "arabic": "وَقَدِّمُوا۟", "translit": "۟āwُmِّdَqَw", "root": "قدم"}, {"id": 9, "arabic": "لِأَنفُسِكُمْ", "translit": "ْmُkِsُfnَaʾِl", "root": "نفس"}, {"id": 10, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَٱعْلَمُوٓا۟", "translit": "۟āٓwُmَlْʿعٱَw", "root": "علم"}, {"id": 13, "arabic": "أَنَّكُم", "translit": "mُkَّnَaʾ", "root": ""}, {"id": 14, "arabic": "مُّلَٰقُوهُ", "translit": "ُhwُqَٰlُّm", "root": "لقي"}, {"id": 15, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 16, "arabic": "ٱلْمُؤْمِنِينَ", "translit": "َnyِnِmْwʾُmْlٱ", "root": "امن"}], "hasIhya": true}, {"ayah": 224, "text": "وَلَا تَجْعَلُوا۟ ٱللَّهَ عُرْضَةً لِّأَيْمَٰنِكُمْ أَن تَبَرُّوا۟ وَتَتَّقُوا۟ وَتُصْلِحُوا۟ بَيْنَ ٱلنَّاسِۗ وَٱللَّهُ سَمِيعٌ عَلِيمٌ ", "translation": "And do not make [your oath by] Allāh an excuse against being righteous and fearing Allāh and making peace among people. And Allāh is Hearing and Knowing.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَجْعَلُوا۟", "translit": "۟āwُlَʿعْjgَt", "root": "جعل"}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "عُرْضَةً", "translit": "ًẗَḍْrُʿع", "root": "عرض"}, {"id": 5, "arabic": "لِّأَيْمَٰنِكُمْ", "translit": "ْmُkِnَٰmْyَaʾِّl", "root": "يمن"}, {"id": 6, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 7, "arabic": "تَبَرُّوا۟", "translit": "۟āwُّrَbَt", "root": "برر"}, {"id": 8, "arabic": "وَتَتَّقُوا۟", "translit": "۟āwُqَّtَtَw", "root": "وقي"}, {"id": 9, "arabic": "وَتُصْلِحُوا۟", "translit": "۟āwُḥِlْṣُtَw", "root": "صلح"}, {"id": 10, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 11, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 14, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 225, "text": "لَّا يُؤَاخِذُكُمُ ٱللَّهُ بِٱللَّغْوِ فِىٓ أَيْمَٰنِكُمْ وَلَٰكِن يُؤَاخِذُكُم بِمَا كَسَبَتْ قُلُوبُكُمْۗ وَٱللَّهُ غَفُورٌ حَلِيمٌ ", "translation": "Allāh does not impose blame upon you for what is unintentional in your oaths, but He imposes blame upon you for what your hearts have earned. And Allāh is Forgiving and Forbearing.[1]", "words": [{"id": 1, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 2, "arabic": "يُؤَاخِذُكُمُ", "translit": "ُmُkُhdِhkāَwʾُy", "root": "اخذ"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "بِٱللَّغْوِ", "translit": "ِwْغَّllٱِb", "root": "لغو"}, {"id": 5, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 6, "arabic": "أَيْمَٰنِكُمْ", "translit": "ْmُkِnَٰmْyَaʾ", "root": "يمن"}, {"id": 7, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 8, "arabic": "يُؤَاخِذُكُم", "translit": "mُkُhdِhkāَwʾُy", "root": "اخذ"}, {"id": 9, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 10, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 11, "arabic": "قُلُوبُكُمْ", "translit": "ْmُkُbwُlُq", "root": "قلب"}, {"id": 12, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 13, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 14, "arabic": "حَلِيمٌ", "translit": "ٌmyِlَḥ", "root": "حلم"}], "hasIhya": true}, {"ayah": 226, "text": "لِّلَّذِينَ يُؤْلُونَ مِن نِّسَآئِهِمْ تَرَبُّصُ أَرْبَعَةِ أَشْهُرٍۖ فَإِن فَآءُو فَإِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "For those who swear not to have sexual relations with their wives[1] is a waiting time of four months, but if they return [to normal relations] - then indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "لِّلَّذِينَ", "translit": "َnyِhdَّlِّl", "root": ""}, {"id": 2, "arabic": "يُؤْلُونَ", "translit": "َnwُlْwʾُy", "root": "الو"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "نِّسَآئِهِمْ", "translit": "ْmِhِyʾٓāَsِّn", "root": "نسو"}, {"id": 5, "arabic": "تَرَبُّصُ", "translit": "ُṣُّbَrَt", "root": "ربص"}, {"id": 6, "arabic": "أَرْبَعَةِ", "translit": "ِẗَʿعَbْrَaʾ", "root": "ربع"}, {"id": 7, "arabic": "أَشْهُرٍ", "translit": "ٍrُhْhsَaʾ", "root": "شهر"}, {"id": 8, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 9, "arabic": "فَآءُو", "translit": "wُءٓāَf", "root": "فيا"}, {"id": 10, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 13, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 227, "text": "وَإِنْ عَزَمُوا۟ ٱلطَّلَٰقَ فَإِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٌ ", "translation": "And if they decide on divorce - then indeed, Allāh is Hearing and Knowing.", "words": [{"id": 1, "arabic": "وَإِنْ", "translit": "ْnِiʾَw", "root": ""}, {"id": 2, "arabic": "عَزَمُوا۟", "translit": "۟āwُmَzَʿع", "root": "عزم"}, {"id": 3, "arabic": "ٱلطَّلَٰقَ", "translit": "َqَٰlَّṭlٱ", "root": "طلق"}, {"id": 4, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 7, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 228, "text": "وَٱلْمُطَلَّقَٰتُ يَتَرَبَّصْنَ بِأَنفُسِهِنَّ ثَلَٰثَةَ قُرُوٓءٍۚ وَلَا يَحِلُّ لَهُنَّ أَن يَكْتُمْنَ مَا خَلَقَ ٱللَّهُ فِىٓ أَرْحَامِهِنَّ إِن كُنَّ يُؤْمِنَّ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِۚ وَبُعُولَتُهُنَّ أَحَقُّ بِرَدِّهِنَّ فِى ذَٰلِكَ إِنْ أَرَادُوٓا۟ إِصْلَٰحًاۚ وَلَهُنَّ مِثْلُ ٱلَّذِى عَلَيْهِنَّ بِٱلْمَعْرُوفِۚ وَلِلرِّجَالِ عَلَيْهِنَّ دَرَجَةٌۗ وَٱللَّهُ عَزِيزٌ حَكِيمٌ ", "translation": "Divorced women remain in waiting [i.e., do not remarry] for three periods,[1] and it is not lawful for them to conceal what Allāh has created in their wombs if they believe in Allāh and the Last Day. And their husbands have more right to take them back in this [period] if they want reconciliation.[2] And due to them [i.e., the wives] is similar to what is expected of them, according to what is reasonable.[3] But the men [i.e., husbands] have a degree over them [in responsibility and authority]. And Allāh is Exalted in Might and Wise.", "words": [{"id": 1, "arabic": "وَٱلْمُطَلَّقَٰتُ", "translit": "ُtَٰqَّlَṭُmْlٱَw", "root": "طلق"}, {"id": 2, "arabic": "يَتَرَبَّصْنَ", "translit": "َnْṣَّbَrَtَy", "root": "ربص"}, {"id": 3, "arabic": "بِأَنفُسِهِنَّ", "translit": "َّnِhِsُfnَaʾِb", "root": "نفس"}, {"id": 4, "arabic": "ثَلَٰثَةَ", "translit": "َẗَhtَٰlَht", "root": "ثلث"}, {"id": 5, "arabic": "قُرُوٓءٍ", "translit": "ٍءٓwُrُq", "root": "قرا"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "يَحِلُّ", "translit": "ُّlِḥَy", "root": "حلل"}, {"id": 8, "arabic": "لَهُنَّ", "translit": "َّnُhَl", "root": ""}, {"id": 9, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 10, "arabic": "يَكْتُمْنَ", "translit": "َnْmُtْkَy", "root": "كتم"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "خَلَقَ", "translit": "َqَlَhk", "root": "خلق"}, {"id": 13, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "فِىٓ", "translit": "ٓàِf", "root": ""}, {"id": 15, "arabic": "أَرْحَامِهِنَّ", "translit": "َّnِhِmāَḥْrَaʾ", "root": "رحم"}, {"id": 16, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 17, "arabic": "كُنَّ", "translit": "َّnُk", "root": "كون"}, {"id": 18, "arabic": "يُؤْمِنَّ", "translit": "َّnِmْwʾُy", "root": "امن"}, {"id": 19, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 20, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 21, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 22, "arabic": "وَبُعُولَتُهُنَّ", "translit": "َّnُhُtَlwُʿعُbَw", "root": "بعل"}, {"id": 23, "arabic": "أَحَقُّ", "translit": "ُّqَḥَaʾ", "root": "حقق"}, {"id": 24, "arabic": "بِرَدِّهِنَّ", "translit": "َّnِhِّdَrِb", "root": "ردد"}, {"id": 25, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 26, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 27, "arabic": "إِنْ", "translit": "ْnِiʾ", "root": ""}, {"id": 28, "arabic": "أَرَادُوٓا۟", "translit": "۟āٓwُdāَrَaʾ", "root": "رود"}, {"id": 29, "arabic": "إِصْلَٰحًا", "translit": "āًḥَٰlْṣِiʾ", "root": "صلح"}, {"id": 30, "arabic": "وَلَهُنَّ", "translit": "َّnُhَlَw", "root": ""}, {"id": 31, "arabic": "مِثْلُ", "translit": "ُlْhtِm", "root": "مثل"}, {"id": 32, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 33, "arabic": "عَلَيْهِنَّ", "translit": "َّnِhْyَlَʿع", "root": ""}, {"id": 34, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 35, "arabic": "وَلِلرِّجَالِ", "translit": "ِlāَjgِّrlِlَw", "root": "رجل"}, {"id": 36, "arabic": "عَلَيْهِنَّ", "translit": "َّnِhْyَlَʿع", "root": ""}, {"id": 37, "arabic": "دَرَجَةٌ", "translit": "ٌẗَjgَrَd", "root": "درج"}, {"id": 38, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 39, "arabic": "عَزِيزٌ", "translit": "ٌzyِzَʿع", "root": "عزز"}, {"id": 40, "arabic": "حَكِيمٌ", "translit": "ٌmyِkَḥ", "root": "حكم"}], "hasIhya": true}, {"ayah": 229, "text": "ٱلطَّلَٰقُ مَرَّتَانِۖ فَإِمْسَاكٌۢ بِمَعْرُوفٍ أَوْ تَسْرِيحٌۢ بِإِحْسَٰنٍۗ وَلَا يَحِلُّ لَكُمْ أَن تَأْخُذُوا۟ مِمَّآ ءَاتَيْتُمُوهُنَّ شَيْـًٔا إِلَّآ أَن يَخَافَآ أَلَّا يُقِيمَا حُدُودَ ٱللَّهِۖ فَإِنْ خِفْتُمْ أَلَّا يُقِيمَا حُدُودَ ٱللَّهِ فَلَا جُنَاحَ عَلَيْهِمَا فِيمَا ٱفْتَدَتْ بِهِۦۗ تِلْكَ حُدُودُ ٱللَّهِ فَلَا تَعْتَدُوهَاۚ وَمَن يَتَعَدَّ حُدُودَ ٱللَّهِ فَأُو۟لَٰٓئِكَ هُمُ ٱلظَّٰلِمُونَ ", "translation": "Divorce is twice. Then [after that], either keep [her] in an acceptable manner or release [her] with good treatment. And it is not lawful for you to take anything of what you have given them unless both fear that they will not be able to keep [within] the limits of Allāh.[1] But if you fear that they will not keep [within] the limits of Allāh, then there is no blame upon either of them concerning that by which she ransoms herself. These are the limits of Allāh, so do not transgress them. And whoever transgresses the limits of Allāh - it is those who are the wrongdoers [i.e., the unjust].", "words": [{"id": 1, "arabic": "ٱلطَّلَٰقُ", "translit": "ُqَٰlَّṭlٱ", "root": "طلق"}, {"id": 2, "arabic": "مَرَّتَانِ", "translit": "ِnāَtَّrَm", "root": "مرر"}, {"id": 3, "arabic": "فَإِمْسَاكٌۢ", "translit": "ٌۢkāَsْmِiʾَf", "root": "مسك"}, {"id": 4, "arabic": "بِمَعْرُوفٍ", "translit": "ٍfwُrْʿعَmِb", "root": "عرف"}, {"id": 5, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 6, "arabic": "تَسْرِيحٌۢ", "translit": "ٌۢḥyِrْsَt", "root": "سرح"}, {"id": 7, "arabic": "بِإِحْسَٰنٍ", "translit": "ٍnَٰsْḥِiʾِb", "root": "حسن"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "يَحِلُّ", "translit": "ُّlِḥَy", "root": "حلل"}, {"id": 10, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 11, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 12, "arabic": "تَأْخُذُوا۟", "translit": "۟āwُhdُhkْaʾَt", "root": "اخذ"}, {"id": 13, "arabic": "مِمَّآ", "translit": "ٓāَّmِm", "root": ""}, {"id": 14, "arabic": "ءَاتَيْتُمُوهُنَّ", "translit": "َّnُhwُmُtْyَtāَء", "root": "اتي"}, {"id": 15, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 16, "arabic": "إِلَّآ", "translit": "ٓāَّlِiʾ", "root": ""}, {"id": 17, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 18, "arabic": "يَخَافَآ", "translit": "ٓāَfāَhkَy", "root": "خوف"}, {"id": 19, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 20, "arabic": "يُقِيمَا", "translit": "āَmyِqُy", "root": "قوم"}, {"id": 21, "arabic": "حُدُودَ", "translit": "َdwُdُḥ", "root": "حدد"}, {"id": 22, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 24, "arabic": "خِفْتُمْ", "translit": "ْmُtْfِhk", "root": "خوف"}, {"id": 25, "arabic": "أَلَّا", "translit": "āَّlَaʾ", "root": ""}, {"id": 26, "arabic": "يُقِيمَا", "translit": "āَmyِqُy", "root": "قوم"}, {"id": 27, "arabic": "حُدُودَ", "translit": "َdwُdُḥ", "root": "حدد"}, {"id": 28, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 29, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 30, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 31, "arabic": "عَلَيْهِمَا", "translit": "āَmِhْyَlَʿع", "root": ""}, {"id": 32, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 33, "arabic": "ٱفْتَدَتْ", "translit": "ْtَdَtْfٱ", "root": "فدي"}, {"id": 34, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 35, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 36, "arabic": "حُدُودُ", "translit": "ُdwُdُḥ", "root": "حدد"}, {"id": 37, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 38, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 39, "arabic": "تَعْتَدُوهَا", "translit": "āَhwُdَtْʿعَt", "root": "عدو"}, {"id": 40, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 41, "arabic": "يَتَعَدَّ", "translit": "َّdَʿعَtَy", "root": "عدو"}, {"id": 42, "arabic": "حُدُودَ", "translit": "َdwُdُḥ", "root": "حدد"}, {"id": 43, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 44, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 45, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 46, "arabic": "ٱلظَّٰلِمُونَ", "translit": "َnwُmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": true}, {"ayah": 230, "text": "فَإِن طَلَّقَهَا فَلَا تَحِلُّ لَهُۥ مِنۢ بَعْدُ حَتَّىٰ تَنكِحَ زَوْجًا غَيْرَهُۥۗ فَإِن طَلَّقَهَا فَلَا جُنَاحَ عَلَيْهِمَآ أَن يَتَرَاجَعَآ إِن ظَنَّآ أَن يُقِيمَا حُدُودَ ٱللَّهِۗ وَتِلْكَ حُدُودُ ٱللَّهِ يُبَيِّنُهَا لِقَوْمٍ يَعْلَمُونَ ", "translation": "And if he has divorced her [for the third time], then she is not lawful to him afterward until [after] she marries a husband other than him.[1] And if he [i.e., the latter husband] divorces her [or dies], there is no blame upon them [i.e., the woman and her former husband] for returning to each other if they think that they can keep [within] the limits of Allāh. These are the limits of Allāh, which He makes clear to a people who know [i.e.,understand].", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "طَلَّقَهَا", "translit": "āَhَqَّlَṭ", "root": "طلق"}, {"id": 3, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 4, "arabic": "تَحِلُّ", "translit": "ُّlِḥَt", "root": "حلل"}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 7, "arabic": "بَعْدُ", "translit": "ُdْʿعَb", "root": "بعد"}, {"id": 8, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 9, "arabic": "تَنكِحَ", "translit": "َḥِknَt", "root": "نكح"}, {"id": 10, "arabic": "زَوْجًا", "translit": "āًjgْwَz", "root": "زوج"}, {"id": 11, "arabic": "غَيْرَهُۥ", "translit": "ۥُhَrْyَغ", "root": "غير"}, {"id": 12, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 13, "arabic": "طَلَّقَهَا", "translit": "āَhَqَّlَṭ", "root": "طلق"}, {"id": 14, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 15, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 16, "arabic": "عَلَيْهِمَآ", "translit": "ٓāَmِhْyَlَʿع", "root": ""}, {"id": 17, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 18, "arabic": "يَتَرَاجَعَآ", "translit": "ٓāَʿعَjgāَrَtَy", "root": "رجع"}, {"id": 19, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 20, "arabic": "ظَنَّآ", "translit": "ٓāَّnَẓ", "root": "ظنن"}, {"id": 21, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 22, "arabic": "يُقِيمَا", "translit": "āَmyِqُy", "root": "قوم"}, {"id": 23, "arabic": "حُدُودَ", "translit": "َdwُdُḥ", "root": "حدد"}, {"id": 24, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 25, "arabic": "وَتِلْكَ", "translit": "َkْlِtَw", "root": ""}, {"id": 26, "arabic": "حُدُودُ", "translit": "ُdwُdُḥ", "root": "حدد"}, {"id": 27, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "يُبَيِّنُهَا", "translit": "āَhُnِّyَbُy", "root": "بين"}, {"id": 29, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 30, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 231, "text": "وَإِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ فَأَمْسِكُوهُنَّ بِمَعْرُوفٍ أَوْ سَرِّحُوهُنَّ بِمَعْرُوفٍۚ وَلَا تُمْسِكُوهُنَّ ضِرَارًا لِّتَعْتَدُوا۟ۚ وَمَن يَفْعَلْ ذَٰلِكَ فَقَدْ ظَلَمَ نَفْسَهُۥۚ وَلَا تَتَّخِذُوٓا۟ ءَايَٰتِ ٱللَّهِ هُزُوًاۚ وَٱذْكُرُوا۟ نِعْمَتَ ٱللَّهِ عَلَيْكُمْ وَمَآ أَنزَلَ عَلَيْكُم مِّنَ ٱلْكِتَٰبِ وَٱلْحِكْمَةِ يَعِظُكُم بِهِۦۚ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "And when you divorce women and they have [nearly] fulfilled their term, either retain them according to acceptable terms or release them according to acceptable terms, and do not keep them, intending harm, to transgress [against them]. And whoever does that has certainly wronged himself. And do not take the verses of Allāh in jest. And remember the favor of Allāh upon you and what has been revealed to you of the Book [i.e., the Qur’ān] and wisdom [i.e., the Prophet's sunnah] by which He instructs you. And fear Allāh and know that Allāh is Knowing of all things.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "طَلَّقْتُمُ", "translit": "ُmُtْqَّlَṭ", "root": "طلق"}, {"id": 3, "arabic": "ٱلنِّسَآءَ", "translit": "َءٓāَsِّnlٱ", "root": "نسو"}, {"id": 4, "arabic": "فَبَلَغْنَ", "translit": "َnْغَlَbَf", "root": "بلغ"}, {"id": 5, "arabic": "أَجَلَهُنَّ", "translit": "َّnُhَlَjgَaʾ", "root": "اجل"}, {"id": 6, "arabic": "فَأَمْسِكُوهُنَّ", "translit": "َّnُhwُkِsْmَaʾَf", "root": "مسك"}, {"id": 7, "arabic": "بِمَعْرُوفٍ", "translit": "ٍfwُrْʿعَmِb", "root": "عرف"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "سَرِّحُوهُنَّ", "translit": "َّnُhwُḥِّrَs", "root": "سرح"}, {"id": 10, "arabic": "بِمَعْرُوفٍ", "translit": "ٍfwُrْʿعَmِb", "root": "عرف"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تُمْسِكُوهُنَّ", "translit": "َّnُhwُkِsْmُt", "root": "مسك"}, {"id": 13, "arabic": "ضِرَارًا", "translit": "āًrāَrِḍ", "root": "ضرر"}, {"id": 14, "arabic": "لِّتَعْ