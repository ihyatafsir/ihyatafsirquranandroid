ophet Muḥammad (ﷺ)] - those [among them] who believed in Allāh and the Last Day and did righteousness - will have their reward with their Lord, and no fear will there be concerning them, nor will they grieve[1].", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 5, "arabic": "هَادُوا۟", "translit": "۟āwُdāَh", "root": "هود"}, {"id": 6, "arabic": "وَٱلنَّصَٰرَىٰ", "translit": "ٰàَrَٰṣَّnlٱَw", "root": "نصر"}, {"id": 7, "arabic": "وَٱلصَّٰبِـِٔينَ", "translit": "َnyِٔـِbَّٰṣlٱَw", "root": "صبا"}, {"id": 8, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 9, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 10, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 11, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 12, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 13, "arabic": "وَعَمِلَ", "translit": "َlِmَʿعَw", "root": "عمل"}, {"id": 14, "arabic": "صَٰلِحًا", "translit": "āًḥِlَٰṣ", "root": "صلح"}, {"id": 15, "arabic": "فَلَهُمْ", "translit": "ْmُhَlَf", "root": ""}, {"id": 16, "arabic": "أَجْرُهُمْ", "translit": "ْmُhُrْjgَaʾ", "root": "اجر"}, {"id": 17, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 18, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 19, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 20, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 21, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 22, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 23, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 24, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": true}, {"ayah": 63, "text": "وَإِذْ أَخَذْنَا مِيثَٰقَكُمْ وَرَفَعْنَا فَوْقَكُمُ ٱلطُّورَ خُذُوا۟ مَآ ءَاتَيْنَٰكُم بِقُوَّةٍ وَٱذْكُرُوا۟ مَا فِيهِ لَعَلَّكُمْ تَتَّقُونَ ", "translation": "And [recall] when We took your covenant, [O Children of Israel, to abide by the Torah] and We raised over you the mount, [saying], \"Take what We have given you with determination and remember what is in it that perhaps you may become righteous.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "أَخَذْنَا", "translit": "āَnْhdَhkَaʾ", "root": "اخذ"}, {"id": 3, "arabic": "مِيثَٰقَكُمْ", "translit": "ْmُkَqَٰhtyِm", "root": "وثق"}, {"id": 4, "arabic": "وَرَفَعْنَا", "translit": "āَnْʿعَfَrَw", "root": "رفع"}, {"id": 5, "arabic": "فَوْقَكُمُ", "translit": "ُmُkَqْwَf", "root": "فوق"}, {"id": 6, "arabic": "ٱلطُّورَ", "translit": "َrwُّṭlٱ", "root": "طور"}, {"id": 7, "arabic": "خُذُوا۟", "translit": "۟āwُhdُhk", "root": "اخذ"}, {"id": 8, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 9, "arabic": "ءَاتَيْنَٰكُم", "translit": "mُkَٰnْyَtāَء", "root": "اتي"}, {"id": 10, "arabic": "بِقُوَّةٍ", "translit": "ٍẗَّwُqِb", "root": "قوي"}, {"id": 11, "arabic": "وَٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱَw", "root": "ذكر"}, {"id": 12, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 13, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 14, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 15, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": false}, {"ayah": 64, "text": "ثُمَّ تَوَلَّيْتُم مِّنۢ بَعْدِ ذَٰلِكَۖ فَلَوْلَا فَضْلُ ٱللَّهِ عَلَيْكُمْ وَرَحْمَتُهُۥ لَكُنتُم مِّنَ ٱلْخَٰسِرِينَ ", "translation": "Then you turned away after that. And if not for the favor of Allāh upon you and His mercy, you would have been among the losers.", "words": [{"id": 1, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 2, "arabic": "تَوَلَّيْتُم", "translit": "mُtْyَّlَwَt", "root": "ولي"}, {"id": 3, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 4, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 5, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 6, "arabic": "فَلَوْلَا", "translit": "āَlْwَlَf", "root": ""}, {"id": 7, "arabic": "فَضْلُ", "translit": "ُlْḍَf", "root": "فضل"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 10, "arabic": "وَرَحْمَتُهُۥ", "translit": "ۥُhُtَmْḥَrَw", "root": "رحم"}, {"id": 11, "arabic": "لَكُنتُم", "translit": "mُtnُkَl", "root": "كون"}, {"id": 12, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 13, "arabic": "ٱلْخَٰسِرِينَ", "translit": "َnyِrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": false}, {"ayah": 65, "text": "وَلَقَدْ عَلِمْتُمُ ٱلَّذِينَ ٱعْتَدَوْا۟ مِنكُمْ فِى ٱلسَّبْتِ فَقُلْنَا لَهُمْ كُونُوا۟ قِرَدَةً خَٰسِـِٔينَ ", "translation": "And you had already known about those who transgressed among you concerning the sabbath, and We said to them, \"Be apes, despised.\"", "words": [{"id": 1, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 2, "arabic": "عَلِمْتُمُ", "translit": "ُmُtْmِlَʿع", "root": "علم"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ٱعْتَدَوْا۟", "translit": "۟āْwَdَtْʿعٱ", "root": "عدو"}, {"id": 5, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 6, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 7, "arabic": "ٱلسَّبْتِ", "translit": "ِtْbَّslٱ", "root": "سبت"}, {"id": 8, "arabic": "فَقُلْنَا", "translit": "āَnْlُqَf", "root": "قول"}, {"id": 9, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 10, "arabic": "كُونُوا۟", "translit": "۟āwُnwُk", "root": "كون"}, {"id": 11, "arabic": "قِرَدَةً", "translit": "ًẗَdَrِq", "root": "قرد"}, {"id": 12, "arabic": "خَٰسِـِٔينَ", "translit": "َnyِٔـِsَٰhk", "root": "خسا"}], "hasIhya": false}, {"ayah": 66, "text": "فَجَعَلْنَٰهَا نَكَٰلًا لِّمَا بَيْنَ يَدَيْهَا وَمَا خَلْفَهَا وَمَوْعِظَةً لِّلْمُتَّقِينَ ", "translation": "And We made it a deterrent punishment for those who were present and those who succeeded [them] and a lesson for those who fear Allāh.", "words": [{"id": 1, "arabic": "فَجَعَلْنَٰهَا", "translit": "āَhَٰnْlَʿعَjgَf", "root": "جعل"}, {"id": 2, "arabic": "نَكَٰلًا", "translit": "āًlَٰkَn", "root": "نكل"}, {"id": 3, "arabic": "لِّمَا", "translit": "āَmِّl", "root": ""}, {"id": 4, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 5, "arabic": "يَدَيْهَا", "translit": "āَhْyَdَy", "root": "يدي"}, {"id": 6, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 7, "arabic": "خَلْفَهَا", "translit": "āَhَfْlَhk", "root": "خلف"}, {"id": 8, "arabic": "وَمَوْعِظَةً", "translit": "ًẗَẓِʿعْwَmَw", "root": "وعظ"}, {"id": 9, "arabic": "لِّلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlِّl", "root": "وقي"}], "hasIhya": false}, {"ayah": 67, "text": "وَإِذْ قَالَ مُوسَىٰ لِقَوْمِهِۦٓ إِنَّ ٱللَّهَ يَأْمُرُكُمْ أَن تَذْبَحُوا۟ بَقَرَةًۖ قَالُوٓا۟ أَتَتَّخِذُنَا هُزُوًاۖ قَالَ أَعُوذُ بِٱللَّهِ أَنْ أَكُونَ مِنَ ٱلْجَٰهِلِينَ ", "translation": "And [recall] when Moses said to his people, \"Indeed, Allāh commands you to slaughter a cow.\" They said, \"Do you take us in ridicule?\" He said, \"I seek refuge in Allāh from being among the ignorant.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 4, "arabic": "لِقَوْمِهِۦٓ", "translit": "ٓۦِhِmْwَqِl", "root": "قوم"}, {"id": 5, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "يَأْمُرُكُمْ", "translit": "ْmُkُrُmْaʾَy", "root": "امر"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "تَذْبَحُوا۟", "translit": "۟āwُḥَbْhdَt", "root": "ذبح"}, {"id": 10, "arabic": "بَقَرَةً", "translit": "ًẗَrَqَb", "root": "بقر"}, {"id": 11, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 12, "arabic": "أَتَتَّخِذُنَا", "translit": "āَnُhdِhkَّtَtَaʾ", "root": "اخذ"}, {"id": 13, "arabic": "هُزُوًا", "translit": "āًwُzُh", "root": "هزا"}, {"id": 14, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 15, "arabic": "أَعُوذُ", "translit": "ُhdwُʿعَaʾ", "root": "عوذ"}, {"id": 16, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 17, "arabic": "أَنْ", "translit": "ْnَaʾ", "root": ""}, {"id": 18, "arabic": "أَكُونَ", "translit": "َnwُkَaʾ", "root": "كون"}, {"id": 19, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 20, "arabic": "ٱلْجَٰهِلِينَ", "translit": "َnyِlِhَٰjgْlٱ", "root": "جهل"}], "hasIhya": false}, {"ayah": 68, "text": "قَالُوا۟ ٱدْعُ لَنَا رَبَّكَ يُبَيِّن لَّنَا مَا هِىَۚ قَالَ إِنَّهُۥ يَقُولُ إِنَّهَا بَقَرَةٌ لَّا فَارِضٌ وَلَا بِكْرٌ عَوَانٌۢ بَيْنَ ذَٰلِكَۖ فَٱفْعَلُوا۟ مَا تُؤْمَرُونَ ", "translation": "They said, \"Call upon your Lord to make clear to us what it is.\" [Moses] said, \"[Allāh] says, 'It is a cow which is neither old nor virgin, but median between that,' so do what you are commanded.\"", "words": [{"id": 1, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 2, "arabic": "ٱدْعُ", "translit": "ُʿعْdٱ", "root": "دعو"}, {"id": 3, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 4, "arabic": "رَبَّكَ", "translit": "َkَّbَr", "root": "ربب"}, {"id": 5, "arabic": "يُبَيِّن", "translit": "nِّyَbُy", "root": "بين"}, {"id": 6, "arabic": "لَّنَا", "translit": "āَnَّl", "root": ""}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "هِىَ", "translit": "َàِh", "root": ""}, {"id": 9, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 10, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 11, "arabic": "يَقُولُ", "translit": "ُlwُ