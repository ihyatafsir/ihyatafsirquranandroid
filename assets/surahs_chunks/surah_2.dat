, "narration": "warsh"}, {"surah": 2, "ayah": 101, "text": "۞وَلَمَّا جَآءَهُمْ رَسُولࣱ مِّنْ عِندِ اِ۬للَّهِ مُصَدِّقࣱ لِّمَا مَعَهُمْ نَبَذَ فَرِيقࣱ مِّنَ اَ۬لذِينَ أُوتُواْ اُ۬لْكِتَٰبَ كِتَٰبَ اَ۬للَّهِ وَرَآءَ ظُهُورِهِمْ كَأَنَّهُمْ لَا يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "۞وَلَمَّا", "translit": "", "root": ""}, {"id": 2, "arabic": "جَآءَهُمْ", "translit": "", "root": ""}, {"id": 3, "arabic": "رَسُولࣱ", "translit": "", "root": ""}, {"id": 4, "arabic": "مِّنْ", "translit": "", "root": ""}, {"id": 5, "arabic": "عِندِ", "translit": "", "root": ""}, {"id": 6, "arabic": "اِ۬للَّهِ", "translit": "", "root": ""}, {"id": 7, "arabic": "مُصَدِّقࣱ", "translit": "", "root": ""}, {"id": 8, "arabic": "لِّمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "مَعَهُمْ", "translit": "", "root": ""}, {"id": 10, "arabic": "نَبَذَ", "translit": "", "root": ""}, {"id": 11, "arabic": "فَرِيقࣱ", "translit": "", "root": ""}, {"id": 12, "arabic": "مِّنَ", "translit": "", "root": ""}, {"id": 13, "arabic": "اَ۬لذِينَ", "translit": "", "root": ""}, {"id": 14, "arabic": "أُوتُواْ", "translit": "", "root": ""}, {"id": 15, "arabic": "اُ۬لْكِتَٰبَ", "translit": "", "root": ""}, {"id": 16, "arabic": "كِتَٰبَ", "translit": "", "root": ""}, {"id": 17, "arabic": "اَ۬للَّهِ", "translit": "", "root": ""}, {"id": 18, "arabic": "وَرَآءَ", "translit": "", "root": ""}, {"id": 19, "arabic": "ظُهُورِهِمْ", "translit": "", "root": ""}, {"id": 20, "arabic": "كَأَنَّهُمْ", "translit": "", "root": ""}, {"id": 21, "arabic": "لَا", "translit": "", "root": ""}, {"id": 22, "arabic": "يَعْلَمُونَۖ", "translit": "", "root": ""}], "narration": "warsh"}, {"surah": 2, "ayah": 102, "text": "وَاتَّبَعُواْ مَا تَتْلُواْ اُ۬لشَّيَٰطِينُ عَلَيٰ مُلْكِ سُلَيْمَٰنَۖ وَمَا كَفَرَ سُلَيْمَٰنُۖ وَلَٰكِنَّ اَ۬لشَّيَٰطِينَ كَفَرُواْ يُعَلِّمُونَ اَ۬لنَّاسَ اَ۬لسِّحْرَ وَمَآ أُنزِلَ عَلَي اَ۬لْمَلَكَيْنِ بِبَابِلَ هَارُوتَ وَمَارُوتَۖ وَمَا يُعَلِّمَٰنِ مِنَ اَحَدٍ حَتَّيٰ يَقُولَآ إِنَّمَا نَحْنُ فِتْنَةࣱ فَلَا تَكْفُرْۖ فَيَتَعَلَّمُونَ مِنْهُمَا مَا يُفَرِّقُونَ بِهِۦ بَيْنَ اَ۬لْمَرْءِ وَزَوْجِهِۦۖ وَمَا هُم بِضَآرِّينَ بِهِۦ مِنَ اَحَدٍ اِلَّا بِإِذْنِ اِ۬للَّهِۖ وَيَتَعَلَّمُونَ مَا يَضُرُّهُمْ وَلَا يَنفَعُهُمْۖ وَلَقَدْ عَلِمُواْ لَمَنِ اِ۪شْتَر۪يٰهُ مَا لَهُۥ فِے اِ۬لَاخِرَةِ مِنْ خَلَٰقࣲۖ وَلَبِيسَ مَا شَرَوْاْ بِهِۦٓ أَنفُسَهُمْ لَوْ كَانُواْ يَعْلَمُونَۖ", "words": [{"id": 1, "arabic": "وَاتَّبَعُواْ", "translit": "", "root": ""}, {"id": 2, "arabic": "مَا", "translit": "", "root": ""}, {"id": 3, "arabic": "تَتْلُواْ", "translit": "", "root": ""}, {"id": 4, "arabic": "اُ۬لشَّيَٰطِينُ", "translit": "", "root": ""}, {"id": 5, "arabic": "عَلَيٰ", "translit": "", "root": ""}, {"id": 6, "arabic": "مُلْكِ", "translit": "", "root": ""}, {"id": 7, "arabic": "سُلَيْمَٰنَۖ", "translit": "", "root": ""}, {"id": 8, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 9, "arabic": "كَفَرَ", "translit": "", "root": ""}, {"id": 10, "arabic": "سُلَيْمَٰنُۖ", "translit": "", "root": ""}, {"id": 11, "arabic": "وَلَٰكِنَّ", "translit": "", "root": ""}, {"id": 12, "arabic": "اَ۬لشَّيَٰطِينَ", "translit": "", "root": ""}, {"id": 13, "arabic": "كَفَرُواْ", "translit": "", "root": ""}, {"id": 14, "arabic": "يُعَلِّمُونَ", "translit": "", "root": ""}, {"id": 15, "arabic": "اَ۬لنَّاسَ", "translit": "", "root": ""}, {"id": 16, "arabic": "اَ۬لسِّحْرَ", "translit": "", "root": ""}, {"id": 17, "arabic": "وَمَآ", "translit": "", "root": ""}, {"id": 18, "arabic": "أُنزِلَ", "translit": "", "root": ""}, {"id": 19, "arabic": "عَلَي", "translit": "", "root": ""}, {"id": 20, "arabic": "اَ۬لْمَلَكَيْنِ", "translit": "", "root": ""}, {"id": 21, "arabic": "بِبَابِلَ", "translit": "", "root": ""}, {"id": 22, "arabic": "هَارُوتَ", "translit": "", "root": ""}, {"id": 23, "arabic": "وَمَارُوتَۖ", "translit": "", "root": ""}, {"id": 24, "arabic": "وَمَا", "translit": "", "root": ""}, {"id": 25, "arabic": "يُعَلِّمَٰنِ", "translit": "", "root": ""}, {"id": 26, "arabic": "مِنَ", "translit": "