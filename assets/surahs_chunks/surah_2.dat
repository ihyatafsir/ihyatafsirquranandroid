 "root": ""}, {"id": 42, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 43, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 44, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 45, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": true}, {"ayah": 232, "text": "وَإِذَا طَلَّقْتُمُ ٱلنِّسَآءَ فَبَلَغْنَ أَجَلَهُنَّ فَلَا تَعْضُلُوهُنَّ أَن يَنكِحْنَ أَزْوَٰجَهُنَّ إِذَا تَرَٰضَوْا۟ بَيْنَهُم بِٱلْمَعْرُوفِۗ ذَٰلِكَ يُوعَظُ بِهِۦ مَن كَانَ مِنكُمْ يُؤْمِنُ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِۗ ذَٰلِكُمْ أَزْكَىٰ لَكُمْ وَأَطْهَرُۗ وَٱللَّهُ يَعْلَمُ وَأَنتُمْ لَا تَعْلَمُونَ ", "translation": "And when you divorce women[1] and they have fulfilled their term, do not prevent them from remarrying their [former] husbands if they [i.e., all parties] agree among themselves on an acceptable basis. That is instructed to whoever of you believes in Allāh and the Last Day. That is better for you and purer, and Allāh knows and you know not.", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "طَلَّقْتُمُ", "translit": "ُmُtْqَّlَṭ", "root": "طلق"}, {"id": 3, "arabic": "ٱلنِّسَآءَ", "translit": "َءٓāَsِّnlٱ", "root": "نسو"}, {"id": 4, "arabic": "فَبَلَغْنَ", "translit": "َnْغَlَbَf", "root": "بلغ"}, {"id": 5, "arabic": "أَجَلَهُنَّ", "translit": "َّnُhَlَjgَaʾ", "root": "اجل"}, {"id": 6, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 7, "arabic": "تَعْضُلُوهُنَّ", "translit": "َّnُhwُlُḍْʿعَt", "root": "عضل"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يَنكِحْنَ", "translit": "َnْḥِknَy", "root": "نكح"}, {"id": 10, "arabic": "أَزْوَٰجَهُنَّ", "translit": "َّnُhَjgَٰwْzَaʾ", "root": "زوج"}, {"id": 11, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 12, "arabic": "تَرَٰضَوْا۟", "translit": "۟āْwَḍَٰrَt", "root": "رضو"}, {"id": 13, "arabic": "بَيْنَهُم", "translit": "mُhَnْyَb", "root": "بين"}, {"id": 14, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 15, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 16, "arabic": "يُوعَظُ", "translit": "ُẓَʿعwُy", "root": "وعظ"}, {"id": 17, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 18, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 19, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 20, "arabic": "مِنكُمْ", "translit": "ْmُknِm", "root": ""}, {"id": 21, "arabic": "يُؤْمِنُ", "translit": "ُnِmْwʾُy", "root": "امن"}, {"id": 22, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 23, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 24, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 25, "arabic": "ذَٰلِكُمْ", "translit": "ْmُkِlَٰhd", "root": ""}, {"id": 26, "arabic": "أَزْكَىٰ", "translit": "ٰàَkْzَaʾ", "root": "زكو"}, {"id": 27, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 28, "arabic": "وَأَطْهَرُ", "translit": "ُrَhْṭَaʾَw", "root": "طهر"}, {"id": 29, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 30, "arabic": "يَعْلَمُ", "translit": "ُmَlْʿعَy", "root": "علم"}, {"id": 31, "arabic": "وَأَنتُمْ", "translit": "ْmُtnَaʾَw", "root": ""}, {"id": 32, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 33, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": true}, {"ayah": 233, "text": "وَٱلْوَٰلِدَٰتُ يُرْضِعْنَ أَوْلَٰدَهُنَّ حَوْلَيْنِ كَامِلَيْنِۖ لِمَنْ أَرَادَ أَن يُتِمَّ ٱلرَّضَاعَةَۚ وَعَلَى ٱلْمَوْلُودِ لَهُۥ رِزْقُهُنَّ وَكِسْوَتُهُنَّ بِٱلْمَعْرُوفِۚ لَا تُكَلَّفُ نَفْسٌ إِلَّا وُسْعَهَاۚ لَا تُضَآرَّ وَٰلِدَةٌۢ بِوَلَدِهَا وَلَا مَوْلُودٌ لَّهُۥ بِوَلَدِهِۦۚ وَعَلَى ٱلْوَارِثِ مِثْلُ ذَٰلِكَۗ فَإِنْ أَرَادَا فِصَالًا عَن تَرَاضٍ مِّنْهُمَا وَتَشَاوُرٍ فَلَا جُنَاحَ عَلَيْهِمَاۗ وَإِنْ أَرَدتُّمْ أَن تَسْتَرْضِعُوٓا۟ أَوْلَٰدَكُمْ فَلَا جُنَاحَ عَلَيْكُمْ إِذَا سَلَّمْتُم مَّآ ءَاتَيْتُم بِٱلْمَعْرُوفِۗ وَٱتَّقُوا۟ ٱللَّهَ وَٱعْلَمُوٓا۟ أَنَّ ٱللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "Mothers may nurse [i.e., breastfeed] their children two complete years for whoever wishes to complete the nursing [period]. Upon the father is their [i.e., the mothers'] provision and their clothing according to what is acceptable. No person is charged with more than his capacity. No mother should be harmed through her child, and no father through his child. And upon the [father's] heir is [a duty] like that [of the father]. And if they both desire weaning through mutual consent from both of them and consultation, there is no blame upon either of them. And if you wish to have your children nursed by a substitute, there is no blame upon you as long as you give payment according to what is acceptable. And fear Allāh and know that Allāh is Seeing of what you do.", "words": [{"id": 1, "arabic": "وَٱلْوَٰلِدَٰتُ", "translit": "ُtَٰdِlَٰwْlٱَw", "root": "ولد"}, {"id": 2, "arabic": "يُرْضِعْنَ", "translit": "َnْʿعِḍْrُy", "root": "رضع"}, {"id": 3, "arabic": "أَوْلَٰدَهُنَّ", "translit": "َّnُhَdَٰlْwَaʾ", "root": "ولد"}, {"id": 4, "arabic": "حَوْلَيْنِ", "translit": "ِnْyَlْwَḥ", "root": "حول"}, {"id": 5, "arabic": "كَامِلَيْنِ", "translit": "ِnْyَlِmāَk", "root": "كمل"}, {"id": 6, "arabic": "لِمَنْ", "translit": "ْnَmِl", "root": ""}, {"id": 7, "arabic": "أَرَادَ", "translit": "َdāَrَaʾ", "root": "رود"}, {"id": 8, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 9, "arabic": "يُتِمَّ", "translit": "َّmِtُy", "root": "تمم"}, {"id": 10, "arabic": "ٱلرَّضَاعَةَ", "translit": "َẗَʿعāَḍَّrlٱ", "root": "رضع"}, {"id": 11, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 12, "arabic": "ٱلْمَوْلُودِ", "translit": "ِdwُlْwَmْlٱ", "root": "ولد"}, {"id": 13, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 14, "arabic": "رِزْقُهُنَّ", "translit": "َّnُhُqْzِr", "root": "رزق"}, {"id": 15, "arabic": "وَكِسْوَتُهُنَّ", "translit": "َّnُhُtَwْsِkَw", "root": "كسو"}, {"id": 16, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "تُكَلَّفُ", "translit": "ُfَّlَkُt", "root": "كلف"}, {"id": 19, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "وُسْعَهَا", "translit": "āَhَʿعْsُw", "root": "وسع"}, {"id": 22, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 23, "arabic": "تُضَآرَّ", "translit": "َّrٓāَḍُt", "root": "ضرر"}, {"id": 24, "arabic": "وَٰلِدَةٌۢ", "translit": "ٌۢẗَdِlَٰw", "root": "ولد"}, {"id": 25, "arabic": "بِوَلَدِهَا", "translit": "āَhِdَlَwِb", "root": "ولد"}, {"id": 26, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 27, "arabic": "مَوْلُودٌ", "translit": "ٌdwُlْwَm", "root": "ولد"}, {"id": 28, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 29, "arabic": "بِوَلَدِهِۦ", "translit": "ۦِhِdَlَwِb", "root": "ولد"}, {"id": 30, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 31, "arabic": "ٱلْوَارِثِ", "translit": "ِhtِrāَwْlٱ", "root": "ورث"}, {"id": 32, "arabic": "مِثْلُ", "translit": "ُlْhtِm", "root": "مثل"}, {"id": 33, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 34, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 35, "arabic": "أَرَادَا", "translit": "āَdāَrَaʾ", "root": "رود"}, {"id": 36, "arabic": "فِصَالًا", "translit": "āًlāَṣِf", "root": "فصل"}, {"id": 37, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 38, "arabic": "تَرَاضٍ", "translit": "ٍḍāَrَt", "root": "رضو"}, {"id": 39, "arabic": "مِّنْهُمَا", "translit": "āَmُhْnِّm", "root": ""}, {"id": 40, "arabic": "وَتَشَاوُرٍ", "translit": "ٍrُwāَhsَtَw", "root": "شور"}, {"id": 41, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 42, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 43, "arabic": "عَلَيْهِمَا", "tra