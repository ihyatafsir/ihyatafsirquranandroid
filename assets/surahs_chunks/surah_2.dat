َعُهُمْ", "translit": "ْmُhُʿعَfnَy", "root": "نفع"}, {"id": 57, "arabic": "وَلَقَدْ", "translit": "ْdَqَlَw", "root": ""}, {"id": 58, "arabic": "عَلِمُوا۟", "translit": "۟āwُmِlَʿع", "root": "علم"}, {"id": 59, "arabic": "لَمَنِ", "translit": "ِnَmَl", "root": ""}, {"id": 60, "arabic": "ٱشْتَرَىٰهُ", "translit": "ُhٰàَrَtْhsٱ", "root": "شري"}, {"id": 61, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 62, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 63, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 64, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 65, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 66, "arabic": "خَلَٰقٍ", "translit": "ٍqَٰlَhk", "root": "خلق"}, {"id": 67, "arabic": "وَلَبِئْسَ", "translit": "َsْyʾِbَlَw", "root": "باس"}, {"id": 68, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 69, "arabic": "شَرَوْا۟", "translit": "۟āْwَrَhs", "root": "شري"}, {"id": 70, "arabic": "بِهِۦٓ", "translit": "ٓۦِhِb", "root": ""}, {"id": 71, "arabic": "أَنفُسَهُمْ", "translit": "ْmُhَsُfnَaʾ", "root": "نفس"}, {"id": 72, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 73, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 74, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 103, "text": "وَلَوْ أَنَّهُمْ ءَامَنُوا۟ وَٱتَّقَوْا۟ لَمَثُوبَةٌ مِّنْ عِندِ ٱللَّهِ خَيْرٌۖ لَّوْ كَانُوا۟ يَعْلَمُونَ ", "translation": "And if they had believed and feared Allāh, then the reward from Allāh would have been [far] better, if they only knew.", "words": [{"id": 1, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 2, "arabic": "أَنَّهُمْ", "translit": "ْmُhَّnَaʾ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَٱتَّقَوْا۟", "translit": "۟āْwَqَّtٱَw", "root": "وقي"}, {"id": 5, "arabic": "لَمَثُوبَةٌ", "translit": "ٌẗَbwُhtَmَl", "root": "ثوب"}, {"id": 6, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 7, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 10, "arabic": "لَّوْ", "translit": "ْwَّl", "root": ""}, {"id": 11, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 12, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": false}, {"ayah": 104, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ لَا تَقُولُوا۟ رَٰعِنَا وَقُولُوا۟ ٱنظُرْنَا وَٱسْمَعُوا۟ۗ وَلِلْكَٰفِرِينَ عَذَابٌ أَلِيمٌ ", "translation": "O you who have believed, say not [to Allāh's Messenger], \"Rāʿinā\" but say, \"Unẓurnā\"[1] and listen. And for the disbelievers is a painful punishment.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 5, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 6, "arabic": "رَٰعِنَا", "translit": "āَnِʿعَٰr", "root": "رعي"}, {"id": 7, "arabic": "وَقُولُوا۟", "translit": "۟āwُlwُqَw", "root": "قول"}, {"id": 8, "arabic": "ٱنظُرْنَا", "translit": "āَnْrُẓnٱ", "root": "نظر"}, {"id": 9, "arabic": "وَٱسْمَعُوا۟", "translit": "۟āwُʿعَmْsٱَw", "root": "سمع"}, {"id": 10, "arabic": "وَلِلْكَٰفِرِينَ", "translit": "َnyِrِfَٰkْlِlَw", "root": "كفر"}, {"id": 11, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 12, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 105, "text": "مَّا يَوَدُّ ٱلَّذِينَ كَفَرُوا۟ مِنْ أَهْلِ ٱلْكِتَٰبِ وَلَا ٱلْمُشْرِكِينَ أَن يُنَزَّلَ عَلَيْكُم مِّنْ خَيْرٍ مِّن رَّبِّكُمْۗ وَٱللَّهُ يَخْتَصُّ بِرَحْمَتِهِۦ مَن يَشَآءُۚ وَٱللَّهُ ذُو ٱلْفَضْلِ ٱلْعَظِيمِ ", "translation": "Neither those who disbelieve from the People of the Scripture [i.e., the Jews and Christians] nor the polytheists wish that any good should be sent down to you from your Lord. But Allāh selects for His mercy whom He wills, and Allāh is the possessor of great bounty.", "words": [{"id": 1, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 2, "arabic": "يَوَدُّ", "translit": "ُّdَwَy", "root": "ودد"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 5, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 6, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 7, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 8, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 9, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}, {"id": 10, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 11, "arabic": "يُنَزَّلَ", "translit": "َlَّzَnُy", "root": "نزل"}, {"id": 12, "arabic": "عَلَيْكُم", "translit": "mُkْyَlَʿع", "root": ""}, {"id": 13, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 14, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 15, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 16, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 17, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 18, "arabic": "يَخْتَصُّ", "translit": "ُّṣَtْhkَy", "root": "خصص"}, {"id": 19, "arabic": "بِرَحْمَتِهِۦ", "translit": "ۦِhِtَmْḥَrِb", "root": "رحم"}, {"id": 20, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 21, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 22, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 23, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 24, "arabic": "ٱلْفَضْلِ", "translit": "ِlْḍَfْlٱ", "root": "فضل"}, {"id": 25, "arabic": "ٱلْعَظِيمِ", "translit": "ِmyِẓَʿعْlٱ", "root": "عظم"}], "hasIhya": false}, {"ayah": 106, "text": "مَا نَنسَخْ مِنْ ءَايَةٍ أَوْ نُنسِهَا نَأْتِ بِخَيْرٍ مِّنْهَآ أَوْ مِثْلِهَآۗ أَلَمْ تَعْلَمْ أَنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "We do not abrogate a verse or cause it to be forgotten except that We bring forth [one] better than it or similar to it. Do you not know that Allāh is over all things competent?", "words": [{"id": 1, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 2, "arabic": "نَنسَخْ", "translit": "ْhkَsnَn", "root": "نسخ"}, {"id": 3, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 4, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 5, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 6, "arabic": "نُنسِهَا", "translit": "āَhِsnُn", "root": "نسي"}, {"id": 7, "arabic": "نَأْتِ", "translit": "ِtْaʾَn", "root": "اتي"}, {"id": 8, "arabic": "بِخَيْرٍ", "translit": "ٍrْyَhkِb", "root": "خير"}, {"id": 9, "arabic": "مِّنْهَآ", "translit": "ٓāَhْnِّm", "root": ""}, {"id": 10, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 11, "arabic": "مِثْلِهَآ", "translit": "ٓāَhِlْhtِm", "root": "مثل"}, {"id": 12, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 13, "arabic": "تَعْلَمْ", "translit": "ْmَlْʿعَt", "root": "علم"}, {"id": 14, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 107, "text": "أَلَمْ تَعْلَمْ أَنَّ ٱللَّهَ لَهُۥ مُلْكُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۗ وَمَا لَكُم مِّن دُونِ ٱللَّهِ مِن وَلِىٍّ وَلَا نَصِيرٍ ", "translation": "Do you not know that to Allāh belongs the dominion of the heavens and the earth and [that] you have not besides Allāh any protector or any helper?", "words": [{"id": 1, "arabic": "أَلَمْ", "translit": "ْmَlَaʾ", "root": ""}, {"id": 2, "arabic": "تَعْلَمْ", "translit": "ْmَlْʿعَt", "root": "علم"}, {"id": 3, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 4, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 6, "arabic": "مُلْكُ", "translit": "ُkْlُm", "root": "ملك"}, {"id": 7, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 8, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 9, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 10, "arabic": "لَكُم", "translit": "mُkَl", "root": ""}, {"id": 11, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 12, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "وَلِىٍّ", "translit": "ٍّàِlَw", "root": "ولي"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "نَصِيرٍ", "translit": "ٍryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 108, "text": "أَمْ تُرِيدُونَ أَن تَسْـَٔلُوا۟ رَسُولَكُمْ كَمَا سُئِلَ مُوسَىٰ مِن قَبْلُۗ وَمَن يَتَبَدَّلِ ٱلْكُفْرَ بِٱلْإِيمَٰنِ فَقَدْ ضَلَّ سَوَآءَ ٱلسَّبِيلِ ", "translation": "Or do you intend to ask[1] your Messenger as Moses was asked before? And whoever exchanges faith for disbelief has certainly strayed from the soundness of the way.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "تُرِيدُونَ", "translit": "َnwُdyِrُt", "root": "رود"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تَسْـَٔلُوا۟", "translit": "۟āwُlَٔـْsَt", "root": "سال"}, {"id": 5, "arabic": "رَسُولَكُمْ", "translit": "ْmُkَlwُsَr", "root": "رسل"}, {"id": 6, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 7, "arabic": "سُئِلَ", "translit": "َlِyʾُs", "root": "سال"}, {"id": 8, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 9, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 10, "arabic": "قَبْلُ", "translit": "ُlْbَq", "root": "قبل"}, {"id": 11, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 12, "arabic": "يَتَبَدَّلِ", "translit": "ِlَّdَbَtَy", "root": "بدل"}, {"id": 13, "arabic": "ٱلْكُفْرَ", "translit": "َrْfُkْlٱ", "root": "كفر"}, {"id": 14, "arabic": "بِٱلْإِيمَٰنِ", "translit": "ِnَٰmyِiʾْlٱِb", "root": "امن"}, {"id": 15, "arabic": "فَقَدْ", "translit": "ْdَqَf", "root": ""}, {"id": 16, "arabic": "ضَلَّ", "translit": "َّlَḍ", "root": "ضلل"}, {"id": 17, "arabic": "سَوَآءَ", "translit": "َءٓāَwَs", "root": "سوي"}, {"id": 18, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}], "hasIhya": false}, {"ayah": 109, "text": "وَدَّ كَثِيرٌ مِّنْ أَهْلِ ٱلْكِتَٰبِ لَوْ يَرُدُّونَكُم مِّنۢ بَعْدِ إِيمَٰنِكُمْ كُفَّارًا حَسَدًا مِّنْ عِندِ أَنفُسِهِم مِّنۢ بَعْدِ مَا تَبَيَّنَ لَهُمُ ٱلْحَقُّۖ فَٱعْفُوا۟ وَٱصْفَحُوا۟ حَتَّىٰ يَأْتِىَ ٱللَّهُ بِأَمْرِهِۦٓۗ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "Many of the People of the Scripture wish they could turn you back to disbelief after you have believed, out of envy from themselves [even] after the truth has become clear to them. So pardon and overlook until Allāh delivers His command. Indeed, Allāh is over all things competent.", "words": [{"id": 1, "arabic": "وَدَّ", "translit": "َّdَw", "root": "ودد"}, {"id": 2, "arabic": "كَثِيرٌ", "translit": "ٌryِhtَk", "root": "كثر"}, {"id": 3, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 4, "arabic": "أَهْلِ", "translit": "ِlْhَaʾ", "root": "اهل"}, {"id": 5, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 7, "arabic": "يَرُدُّونَكُم", "translit": "mُkَnwُّdُrَy", "root": "ردد"}, {"id": 8, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 9, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 10, "arabic": "إِيمَٰنِكُمْ", "translit": "ْmُkِnَٰmyِiʾ", "root": "امن"}, {"id": 11, "arabic": "كُفَّارًا", "translit": "āًrāَّfُk", "root": "كفر"}, {"id": 12, "arabic": "حَسَدًا", "translit": "āًdَsَḥ", "root": "حسد"}, {"id": 13, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 14, "arabic": "عِندِ", "translit": "ِdnِʿع", "root": "عند"}, {"id": 15, "arabic": "أَنفُسِهِم", "translit": "mِhِsُfnَaʾ", "root": "نفس"}, {"id": 16, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 17, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 18, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 19, "arabic": "تَبَيَّنَ", "translit": "َnَّyَbَt", "root": "بين"}, {"id": 20, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 21, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 22, "arabic": "فَٱعْفُوا۟", "translit": "۟āwُfْʿعٱَf", "root": "عفو"}, {"id": 23, "arabic": "وَٱصْفَحُوا۟", "translit": "۟āwُḥَfْṣٱَw", "root": "صفح"}, {"id": 24, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 25, "arabic": "يَأْتِىَ", "translit": "َàِtْaʾَy", "root": "اتي"}, {"id": 26, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 27, "arabic": "بِأَمْرِهِۦٓ", "translit": "ٓۦِhِrْmَaʾِb", "root": "امر"}, {"id": 28, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 29, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 31, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 32, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 33, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": true}, {"ayah": 110, "text": "وَأَقِيمُوا۟ ٱلصَّلَوٰةَ وَءَاتُوا۟ ٱلزَّكَوٰةَۚ وَمَا تُقَدِّمُوا۟ لِأَنفُسِكُم مِّنْ خَيْرٍ تَجِدُوهُ عِندَ ٱللَّهِۗ إِنَّ ٱللَّهَ بِمَا تَعْمَلُونَ بَصِيرٌ ", "translation": "And establish prayer and give zakāh, and whatever good you put forward for yourselves - you will find it with Allāh. Indeed Allāh, of what you do, is Seeing.", "words": [{"id": 1, "arabic": "وَأَقِيمُوا۟", "translit": "۟āwُmyِqَaʾَw", "root": "قوم"}, {"id": 2, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 3, "arabic": "وَءَاتُوا۟", "translit": "۟āwُtāَءَw", "root": "اتي"}, {"id": 4, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 5, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 6, "arabic": "تُقَدِّمُوا۟", "translit": "۟āwُmِّdَqُt", "root": "قدم"}, {"id": 7, "arabic": "لِأَنفُسِكُم", "translit": "mُkِsُfnَaʾِl", "root": "نفس"}, {"id": 8, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 9, "arabic": "خَيْرٍ", "translit": "ٍrْyَhk", "root": "خير"}, {"id": 10, "arabic": "تَجِدُوهُ", "translit": "ُhwُdِjgَt", "root": "وجد"}, {"id": 11, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 16, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}, {"id": 17, "arabic": "بَصِيرٌ", "translit": "ٌryِṣَb", "root": "بصر"}], "hasIhya": true}, {"ayah": 111, "text": "وَقَالُوا۟ لَن يَدْخُلَ ٱلْجَنَّةَ إِلَّا مَن كَانَ هُودًا أَوْ نَصَٰرَىٰۗ تِلْكَ أَمَانِيُّهُمْۗ قُلْ هَاتُوا۟ بُرْهَٰنَكُمْ إِن كُنتُمْ صَٰدِقِينَ ", "translation": "And they say, \"None will enter Paradise except one who is a Jew or a Christian.\" That is [merely] their wishful thinking. Say, \"Produce your proof, if you should be truthful.\"", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "لَن", "translit": "nَl", "root": ""}, {"id": 3, "arabic": "يَدْخُلَ", "translit": "َlُhkْdَy", "root": "دخل"}, {"id": 4, "arabic": "ٱلْجَنَّةَ", "translit": "َẗَّnَjgْlٱ", "root": "جنن"}, {"id": 5, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 6, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 7, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 8, "arabic": "هُودًا", "translit": "āًdwُh", "root": "هود"}, {"id": 9, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 10, "arabic": "نَصَٰرَىٰ", "translit": "ٰàَrَٰṣَn", "root": "نصر"}, {"id": 11, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 12, "arabic": "أَمَانِيُّهُمْ", "translit": "ْmُhُّyِnāَmَaʾ", "root": "مني"}, {"id": 13, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 14, "arabic": "هَاتُوا۟", "translit": "۟āwُtāَh", "root": "هات"}, {"id": 15, "arabic": "بُرْهَٰنَكُمْ", "translit": "ْmُkَnَٰhْrُb", "root": "برهن"}, {"id": 16, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 17, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 18, "arabic": "صَٰدِقِينَ", "translit": "َnyِqِdَٰṣ", "root": "صدق"}], "hasIhya": false}, {"ayah": 112, "text": "بَلَىٰ مَنْ أَسْلَمَ وَجْهَهُۥ لِلَّهِ وَهُوَ مُحْسِنٌ فَلَهُۥٓ أَجْرُهُۥ عِندَ رَبِّهِۦ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "Yes, [on the contrary], whoever submits his face [i.e., self] in Islām to Allāh while being a doer of good will have his reward with his Lord. And no fear will there be concerning them, nor will they grieve.", "words": [{"id": 1, "arabic": "بَلَىٰ", "translit": "ٰàَlَb", "root": ""}, {"id": 2, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 3, "arabic": "أَسْلَمَ", "translit": "َmَlْsَaʾ", "root": "سلم"}, {"id": 4, "arabic": "وَجْهَهُۥ", "translit": "ۥُhَhْjgَw", "root": "وجه"}, {"id": 5, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 6, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 7, "arabic": "مُحْسِنٌ", "translit": "ٌnِsْḥُm", "root": "حسن"}, {"id": 8, "arabic": "فَلَهُۥٓ", "translit": "ٓۥُhَlَf", "root": ""}, {"id": 9, "arabic": "أَجْرُهُۥ", "translit": "ۥُhُrْjgَaʾ", "root": "اجر"}, {"id": 10, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 11, "arabic": "رَبِّهِۦ", "translit": "ۦِhِّbَr", "root": "ربب"}, {"id": 12, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 13, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 14, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 17, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": true}, {"ayah": 113, "text": "وَقَالَتِ ٱلْيَهُودُ لَيْسَتِ ٱلنَّصَٰرَىٰ عَلَىٰ شَىْءٍ وَقَالَتِ ٱلنَّصَٰرَىٰ لَيْسَتِ ٱلْيَهُودُ عَلَىٰ شَىْءٍ وَهُمْ يَتْلُونَ ٱلْكِتَٰبَۗ كَذَٰلِكَ قَالَ ٱلَّذِينَ لَا يَعْلَمُونَ مِثْلَ قَوْلِهِمْۚ فَٱللَّهُ يَحْكُمُ بَيْنَهُمْ يَوْمَ ٱلْقِيَٰمَةِ فِيمَا كَانُوا۟ فِيهِ يَخْتَلِفُونَ ", "translation": "The Jews say, \"The Christians have nothing [true] to stand on,\" and the Christians say, \"The Jews have nothing to stand on,\" although they [both] recite the Scripture. Thus do those who know not [i.e., the polytheists] speak the same as their words. But Allāh will judge between them on the Day of Resurrection concerning that over which they used to differ.", "words": [{"id": 1, "arabic": "وَقَالَتِ", "translit": "ِtَlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلْيَهُودُ", "translit": "ُdwُhَyْlٱ", "root": "هود"}, {"id": 3, "arabic": "لَيْسَتِ", "translit": "ِtَsْyَl", "root": "ليس"}, {"id": 4, "arabic": "ٱلنَّصَٰرَىٰ", "translit": "ٰàَrَٰṣَّnlٱ", "root": "نصر"}, {"id": 5, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 6, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 7, "arabic": "وَقَالَتِ", "translit": "ِtَlāَqَw", "root": "قول"}, {"id": 8, "arabic": "ٱلنَّصَٰرَىٰ", "translit": "ٰàَrَٰṣَّnlٱ", "root": "نصر"}, {"id": 9, "arabic": "لَيْسَتِ", "translit": "ِtَsْyَl", "root": "ليس"}, {"id": 10, "arabic": "ٱلْيَهُودُ", "translit": "ُdwُhَyْlٱ", "root": "هود"}, {"id": 11, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 12, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 13, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 14, "arabic": "يَتْلُونَ", "translit": "َnwُlْtَy", "root": "تلو"}, {"id": 15, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 16, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 17, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 18, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 19, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 20, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}, {"id": 21, "arabic": "مِثْلَ", "translit": "َlْhtِm", "root": "مثل"}, {"id": 22, "arabic": "قَوْلِهِمْ", "translit": "ْmِhِlْwَq", "root": "قول"}, {"id": 23, "arabic": "فَٱللَّهُ", "translit": "ُhَّllٱَf", "root": "اله"}, {"id": 24, "arabic": "يَحْكُمُ", "translit": "ُmُkْḥَy", "root": "حكم"}, {"id": 25, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 26, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 27, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 28, "arabic": "فِيمَا", "translit": "āَmyِf", "root": ""}, {"id": 29, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 30, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 31, "arabic": "يَخْتَلِفُونَ", "translit": "َnwُfِlَtْhkَy", "root": "خلف"}], "hasIhya": false}, {"ayah": 114, "text": "وَمَنْ أَظْلَمُ مِمَّن مَّنَعَ مَسَٰجِدَ ٱللَّهِ أَن يُذْكَرَ فِيهَا ٱسْمُهُۥ وَسَعَىٰ فِى خَرَابِهَآۚ أُو۟لَٰٓئِكَ مَا كَانَ لَهُمْ أَن يَدْخُلُوهَآ إِلَّا خَآئِفِينَۚ لَهُمْ فِى ٱلدُّنْيَا خِزْىٌ وَلَهُمْ فِى ٱلْءَاخِرَةِ عَذَابٌ عَظِيمٌ ", "translation": "And who are more unjust than those who prevent the name of Allāh from being mentioned [i.e., praised] in His mosques and strive toward their destruction. It is not for them to enter them except in fear. For them in this world is disgrace, and they will have in the Hereafter a great punishment.", "words": [{"id": 1, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 2, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 3, "arabic": "مِمَّن", "translit": "nَّmِm", "root": ""}, {"id": 4, "arabic": "مَّنَعَ", "translit": "َʿعَnَّm", "root": "منع"}, {"id": 5, "arabic": "مَسَٰجِدَ", "translit": "َdِjgَٰsَm", "root": "سجد"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 8, "arabic": "يُذْكَرَ", "translit": "َrَkْhdُy", "root": "ذكر"}, {"id": 9, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 10, "arabic": "ٱسْمُهُۥ", "translit": "ۥُhُmْsٱ", "root": "سمو"}, {"id": 11, "arabic": "وَسَعَىٰ", "translit": "ٰàَʿعَsَw", "root": "سعي"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "خَرَابِهَآ", "translit": "ٓāَhِbāَrَhk", "root": "خرب"}, {"id": 14, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 15, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 16, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 17, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "يَدْخُلُوهَآ", "translit": "ٓāَhwُlُhkْdَy", "root": "دخل"}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "خَآئِفِينَ", "translit": "َnyِfِyʾٓāَhk", "root": "خوف"}, {"id": 22, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 23, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 24, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 25, "arabic": "خِزْىٌ", "translit": "ٌàْzِhk", "root": "خزي"}, {"id": 26, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 27, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 28, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 29, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 30, "arabic": "عَظِيمٌ", "translit": "ٌmyِẓَʿع", "root": "عظم"}], "hasIhya": false}, {"ayah": 115, "text": "وَلِلَّهِ ٱلْمَشْرِقُ وَٱلْمَغْرِبُۚ فَأَيْنَمَا تُوَلُّوا۟ فَثَمَّ وَجْهُ ٱللَّهِۚ إِنَّ ٱللَّهَ وَٰسِعٌ عَلِيمٌ ", "translation": "And to Allāh belongs the east and the west. So wherever you [might] turn, there is the Face[1] of Allāh. Indeed, Allāh is all-Encompassing and Knowing.", "words": [{"id": 1, "arabic": "وَلِلَّهِ", "translit": "ِhَّlِlَw", "root": "اله"}, {"id": 2, "arabic": "ٱلْمَشْرِقُ", "translit": "ُqِrْhsَmْlٱ", "root": "شرق"}, {"id": 3, "arabic": "وَٱلْمَغْرِبُ", "translit": "ُbِrْغَmْlٱَw", "root": "غرب"}, {"id": 4, "arabic": "فَأَيْنَمَا", "translit": "āَmَnْyَaʾَf", "root": ""}, {"id": 5, "arabic": "تُوَلُّوا۟", "translit": "۟āwُّlَwُt", "root": "ولي"}, {"id": 6, "arabic": "فَثَمَّ", "translit": "َّmَhtَf", "root": ""}, {"id": 7, "arabic": "وَجْهُ", "translit": "ُhْjgَw", "root": "وجه"}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 10, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَٰسِعٌ", "translit": "ٌʿعِsَٰw", "root": "وسع"}, {"id": 12, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 116, "text": "وَقَالُوا۟ ٱتَّخَذَ ٱللَّهُ وَلَدًاۗ سُبْحَٰنَهُۥۖ بَل لَّهُۥ مَا فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ كُلٌّ لَّهُۥ قَٰنِتُونَ ", "translation": "They say, \"Allāh has taken a son.\" Exalted is He![1] Rather, to Him belongs whatever is in the heavens and the earth. All are devoutly obedient to Him,", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱتَّخَذَ", "translit": "َhdَhkَّtٱ", "root": "اخذ"}, {"id": 3, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "وَلَدًا", "translit": "āًdَlَw", "root": "ولد"}, {"id": 5, "arabic": "سُبْحَٰنَهُۥ", "translit": "ۥُhَnَٰḥْbُs", "root": "سبح"}, {"id": 6, "arabic": "بَل", "translit": "lَb", "root": ""}, {"id": 7, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 10, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 11, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 12, "arabic": "كُلٌّ", "translit": "ٌّlُk", "root": "كلل"}, {"id": 13, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 14, "arabic": "قَٰنِتُونَ", "translit": "َnwُtِnَٰq", "root": "قنت"}], "hasIhya": true}, {"ayah": 117, "text": "بَدِيعُ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِۖ وَإِذَا قَضَىٰٓ أَمْرًا فَإِنَّمَا يَقُولُ لَهُۥ كُن فَيَكُونُ ", "translation": "Originator of the heavens and the earth. When He decrees a matter, He only says to it, \"Be,\" and it is.", "words": [{"id": 1, "arabic": "بَدِيعُ", "translit": "ُʿعyِdَb", "root": "بدع"}, {"id": 2, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 3, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 4, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 5, "arabic": "قَضَىٰٓ", "translit": "ٰٓàَḍَq", "root": "قضي"}, {"id": 6, "arabic": "أَمْرًا", "translit": "āًrْmَaʾ", "root": "امر"}, {"id": 7, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 8, "arabic": "يَقُولُ", "translit": "ُlwُqَy", "root": "قول"}, {"id": 9, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 10, "arabic": "كُن", "translit": "nُk", "root": "كون"}, {"id": 11, "arabic": "فَيَكُونُ", "translit": "ُnwُkَyَf", "root": "كون"}], "hasIhya": false}, {"ayah": 118, "text": "وَقَالَ ٱلَّذِينَ لَا يَعْلَمُونَ لَوْلَا يُكَلِّمُنَا ٱللَّهُ أَوْ تَأْتِينَآ ءَايَةٌۗ كَذَٰلِكَ قَالَ ٱلَّذِينَ مِن قَبْلِهِم مِّثْلَ قَوْلِهِمْۘ تَشَٰبَهَتْ قُلُوبُهُمْۗ قَدْ بَيَّنَّا ٱلْءَايَٰتِ لِقَوْمٍ يُوقِنُونَ ", "translation": "Those who do not know say, \"Why does Allāh not speak to us or there come to us a sign?\" Thus spoke those before them like their words. Their hearts resemble each other. We have shown clearly the signs to a people who are certain [in faith].", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}, {"id": 5, "arabic": "لَوْلَا", "translit": "āَlْwَl", "root": ""}, {"id": 6, "arabic": "يُكَلِّمُنَا", "translit": "āَnُmِّlَkُy", "root": "كلم"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 9, "arabic": "تَأْتِينَآ", "translit": "ٓāَnyِtْaʾَt", "root": "اتي"}, {"id": 10, "arabic": "ءَايَةٌ", "translit": "ٌẗَyāَء", "root": "ايي"}, {"id": 11, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 12, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 13, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 14, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 15, "arabic": "قَبْلِهِم", "translit": "mِhِlْbَq", "root": "قبل"}, {"id": 16, "arabic": "مِّثْلَ", "translit": "َlْhtِّm", "root": "مثل"}, {"id": 17, "arabic": "قَوْلِهِمْ", "translit": "ْmِhِlْwَq", "root": "قول"}, {"id": 18, "arabic": "تَشَٰبَهَتْ", "translit": "ْtَhَbَٰhsَt", "root": "شبه"}, {"id": 19, "arabic": "قُلُوبُهُمْ", "translit": "ْmُhُbwُlُq", "root": "قلب"}, {"id": 20, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 21, "arabic": "بَيَّنَّا", "translit": "āَّnَّyَb", "root": "بين"}, {"id": 22, "arabic": "ٱلْءَايَٰتِ", "translit": "ِtَٰyāَءْlٱ", "root": "ايي"}, {"id": 23, "arabic": "لِقَوْمٍ", "translit": "ٍmْwَqِl", "root": "قوم"}, {"id": 24, "arabic": "يُوقِنُونَ", "translit": "َnwُnِqwُy", "root": "يقن"}], "hasIhya": true}, {"ayah": 119, "text": "إِنَّآ أَرْسَلْنَٰكَ بِٱلْحَقِّ بَشِيرًا وَنَذِيرًاۖ وَلَا تُسْـَٔلُ عَنْ أَصْحَٰبِ ٱلْجَحِيمِ ", "translation": "Indeed, We have sent you, [O Muḥammad], with the truth as a bringer of good tidings and a warner, and you will not be asked about the companions of Hellfire.", "words": [{"id": 1, "arabic": "إِنَّآ", "translit": "ٓāَّnِiʾ", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَٰكَ", "translit": "َkَٰnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 4, "arabic": "بَشِيرًا", "translit": "āًryِhsَb", "root": "بشر"}, {"id": 5, "arabic": "وَنَذِيرًا", "translit": "āًryِhdَnَw", "root": "نذر"}, {"id": 6, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 7, "arabic": "تُسْـَٔلُ", "translit": "ُlَٔـْsُt", "root": "سال"}, {"id": 8, "arabic": "عَنْ", "translit": "ْnَʿع", "root": ""}, {"id": 9, "arabic": "أَصْحَٰبِ", "translit": "ِbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 10, "arabic": "ٱلْجَحِيمِ", "translit": "ِmyِḥَjgْlٱ", "root": "جحم"}], "hasIhya": false}, {"ayah": 120, "text": "وَلَن تَرْضَىٰ عَنكَ ٱلْيَهُودُ وَلَا ٱلنَّصَٰرَىٰ حَتَّىٰ تَتَّبِعَ مِلَّتَهُمْۗ قُلْ إِنَّ هُدَى ٱللَّهِ هُوَ ٱلْهُدَىٰۗ وَلَئِنِ ٱتَّبَعْتَ أَهْوَآءَهُم بَعْدَ ٱلَّذِى جَآءَكَ مِنَ ٱلْعِلْمِۙ مَا لَكَ مِنَ ٱللَّهِ مِن وَلِىٍّ وَلَا نَصِيرٍ ", "translation": "And never will the Jews and the Christians approve of you until you follow their religion. Say, \"Indeed, the guidance of Allāh is the [only] guidance.\" If you were to follow their desires after what has come to you of knowledge, you would have against Allāh no protector or helper.", "words": [{"id": 1, "arabic": "وَلَن", "translit": "nَlَw", "root": ""}, {"id": 2, "arabic": "تَرْضَىٰ", "translit": "ٰàَḍْrَt", "root": "رضو"}, {"id": 3, "arabic": "عَنكَ", "translit": "َknَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْيَهُودُ", "translit": "ُdwُhَyْlٱ", "root": "هود"}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "ٱلنَّصَٰرَىٰ", "translit": "ٰàَrَٰṣَّnlٱ", "root": "نصر"}, {"id": 7, "arabic": "حَتَّىٰ", "translit": "ٰàَّtَḥ", "root": ""}, {"id": 8, "arabic": "تَتَّبِعَ", "translit": "َʿعِbَّtَt", "root": "تبع"}, {"id": 9, "arabic": "مِلَّتَهُمْ", "translit": "ْmُhَtَّlِm", "root": "ملل"}, {"id": 10, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 11, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 12, "arabic": "هُدَى", "translit": "àَdُh", "root": "هدي"}, {"id": 13, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 14, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 15, "arabic": "ٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱ", "root": "هدي"}, {"id": 16, "arabic": "وَلَئِنِ", "translit": "ِnِyʾَlَw", "root": ""}, {"id": 17, "arabic": "ٱتَّبَعْتَ", "translit": "َtْʿعَbَّtٱ", "root": "تبع"}, {"id": 18, "arabic": "أَهْوَآءَهُم", "translit": "mُhَءٓāَwْhَaʾ", "root": "هوي"}, {"id": 19, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 20, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 21, "arabic": "جَآءَكَ", "translit": "َkَءٓāَjg", "root": "جيا"}, {"id": 22, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 23, "arabic": "ٱلْعِلْمِ", "translit": "ِmْlِʿعْlٱ", "root": "علم"}, {"id": 24, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 25, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 26, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 27, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 29, "arabic": "وَلِىٍّ", "translit": "ٍّàِlَw", "root": "ولي"}, {"id": 30, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 31, "arabic": "نَصِيرٍ", "translit": "ٍryِṣَn", "root": "نصر"}], "hasIhya": false}, {"ayah": 121, "text": "ٱلَّذِينَ ءَاتَيْنَٰهُمُ ٱلْكِتَٰبَ يَتْلُونَهُۥ حَقَّ تِلَاوَتِهِۦٓ أُو۟لَٰٓئِكَ يُؤْمِنُونَ بِهِۦۗ وَمَن يَكْفُرْ بِهِۦ فَأُو۟لَٰٓئِكَ هُمُ ٱلْخَٰسِرُونَ ", "translation": "Those to whom We have given the Book recite it with its true recital.[1] They [are the ones who] believe in it. And whoever disbelieves in it - it is they who are the losers.", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَٰهُمُ", "translit": "ُmُhَٰnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "يَتْلُونَهُۥ", "translit": "ۥُhَnwُlْtَy", "root": "تلو"}, {"id": 5, "arabic": "حَقَّ", "translit": "َّqَḥ", "root": "حقق"}, {"id": 6, "arabic": "تِلَاوَتِهِۦٓ", "translit": "ٓۦِhِtَwāَlِt", "root": "تلو"}, {"id": 7, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 8, "arabic": "يُؤْمِنُونَ", "translit": "َnwُnِmْwʾُy", "root": "امن"}, {"id": 9, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 10, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 11, "arabic": "يَكْفُرْ", "translit": "ْrُfْkَy", "root": "كفر"}, {"id": 12, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 13, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 14, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 15, "arabic": "ٱلْخَٰسِرُونَ", "translit": "َnwُrِsَٰhkْlٱ", "root": "خسر"}], "hasIhya": true}, {"ayah": 122, "text": "يَٰبَنِىٓ إِسْرَٰٓءِيلَ ٱذْكُرُوا۟ نِعْمَتِىَ ٱلَّتِىٓ أَنْعَمْتُ عَلَيْكُمْ وَأَنِّى فَضَّلْتُكُمْ عَلَى ٱلْعَٰلَمِينَ ", "translation": "O Children of Israel, remember My favor which I have bestowed upon you and that I preferred you over the worlds.", "words": [{"id": 1, "arabic": "يَٰبَنِىٓ", "translit": "ٓàِnَbَٰy", "root": "بني"}, {"id": 2, "arabic": "إِسْرَٰٓءِيلَ", "translit": "َlyِءَٰٓrْsِiʾ", "root": ""}, {"id": 3, "arabic": "ٱذْكُرُوا۟", "translit": "۟āwُrُkْhdٱ", "root": "ذكر"}, {"id": 4, "arabic": "نِعْمَتِىَ", "translit": "َàِtَmْʿعِn", "root": "نعم"}, {"id": 5, "arabic": "ٱلَّتِىٓ", "translit": "ٓàِtَّlٱ", "root": ""}, {"id": 6, "arabic": "أَنْعَمْتُ", "translit": "ُtْmَʿعْnَaʾ", "root": "نعم"}, {"id": 7, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "وَأَنِّى", "translit": "àِّnَaʾَw", "root": ""}, {"id": 9, "arabic": "فَضَّلْتُكُمْ", "translit": "ْmُkُtْlَّḍَf", "root": "فضل"}, {"id": 10, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 123, "text": "وَٱتَّقُوا۟ يَوْمًا لَّا تَجْزِى نَفْسٌ عَن نَّفْسٍ شَيْـًٔا وَلَا يُقْبَلُ مِنْهَا عَدْلٌ وَلَا تَنفَعُهَا شَفَٰعَةٌ وَلَا هُمْ يُنصَرُونَ ", "translation": "And fear a Day when no soul will suffice for another soul[1] at all, and no compensation will be accepted from it, nor will any intercession benefit it, nor will they be aided.", "words": [{"id": 1, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 2, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 3, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 4, "arabic": "تَجْزِى", "translit": "àِzْjgَt", "root": "جزي"}, {"id": 5, "arabic": "نَفْسٌ", "translit": "ٌsْfَn", "root": "نفس"}, {"id": 6, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 7, "arabic": "نَّفْسٍ", "translit": "ٍsْfَّn", "root": "نفس"}, {"id": 8, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "يُقْبَلُ", "translit": "ُlَbْqُy", "root": "قبل"}, {"id": 11, "arabic": "مِنْهَا", "translit": "āَhْnِm", "root": ""}, {"id": 12, "arabic": "عَدْلٌ", "translit": "ٌlْdَʿع", "root": "عدل"}, {"id": 13, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 14, "arabic": "تَنفَعُهَا", "translit": "āَhُʿعَfnَt", "root": "نفع"}, {"id": 15, "arabic": "شَفَٰعَةٌ", "translit": "ٌẗَʿعَٰfَhs", "root": "شفع"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 18, "arabic": "يُنصَرُونَ", "translit": "َnwُrَṣnُy", "root": "نصر"}], "hasIhya": true}, {"ayah": 124, "text": "وَإِذِ ٱبْتَلَىٰٓ إِبْرَٰهِۦمَ رَبُّهُۥ بِكَلِمَٰتٍ فَأَتَمَّهُنَّۖ قَالَ إِنِّى جَاعِلُكَ لِلنَّاسِ إِمَامًاۖ قَالَ وَمِن ذُرِّيَّتِىۖ قَالَ لَا يَنَالُ عَهْدِى ٱلظَّٰلِمِينَ ", "translation": "And [mention, O Muḥammad], when Abraham was tried by his Lord with words [i.e., commands] and he fulfilled them. [Allāh] said, \"Indeed, I will make you a leader for the people.\" [Abraham] said, \"And of my descendants?\" [Allāh] said, \"My covenant does not include the wrongdoers.\"", "words": [{"id": 1, "arabic": "وَإِذِ", "translit": "ِhdِiʾَw", "root": ""}, {"id": 2, "arabic": "ٱبْتَلَىٰٓ", "translit": "ٰٓàَlَtْbٱ", "root": "بلو"}, {"id": 3, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 4, "arabic": "رَبُّهُۥ", "translit": "ۥُhُّbَr", "root": "ربب"}, {"id": 5, "arabic": "بِكَلِمَٰتٍ", "translit": "ٍtَٰmِlَkِb", "root": "كلم"}, {"id": 6, "arabic": "فَأَتَمَّهُنَّ", "translit": "َّnُhَّmَtَaʾَf", "root": "تمم"}, {"id": 7, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 8, "arabic": "إِنِّى", "translit": "àِّnِiʾ", "root": ""}, {"id": 9, "arabic": "جَاعِلُكَ", "translit": "َkُlِʿعāَjg", "root": "جعل"}, {"id": 10, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 11, "arabic": "إِمَامًا", "translit": "āًmāَmِiʾ", "root": "امم"}, {"id": 12, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 13, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 14, "arabic": "ذُرِّيَّتِى", "translit": "àِtَّyِّrُhd", "root": "ذرر"}, {"id": 15, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 16, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 17, "arabic": "يَنَالُ", "translit": "ُlāَnَy", "root": "نيل"}, {"id": 18, "arabic": "عَهْدِى", "translit": "àِdْhَʿع", "root": "عهد"}, {"id": 19, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 125, "text": "وَإِذْ جَعَلْنَا ٱلْبَيْتَ مَثَابَةً لِّلنَّاسِ وَأَمْنًا وَٱتَّخِذُوا۟ مِن مَّقَامِ إِبْرَٰهِۦمَ مُصَلًّىۖ وَعَهِدْنَآ إِلَىٰٓ إِبْرَٰهِۦمَ وَإِسْمَٰعِيلَ أَن طَهِّرَا بَيْتِىَ لِلطَّآئِفِينَ وَٱلْعَٰكِفِينَ وَٱلرُّكَّعِ ٱلسُّجُودِ ", "translation": "And [mention] when We made the House [i.e., the Kaʿbah] a place of return for the people and [a place of] security. And take, [O believers], from the standing place of Abraham a place of prayer. And We charged Abraham and Ishmael, [saying], \"Purify My House for those who perform ṭawāf[1] and those who are staying [there] for worship and those who bow and prostrate [in prayer].\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "ٱلْبَيْتَ", "translit": "َtْyَbْlٱ", "root": "بيت"}, {"id": 4, "arabic": "مَثَابَةً", "translit": "ًẗَbāَhtَm", "root": "ثوب"}, {"id": 5, "arabic": "لِّلنَّاسِ", "translit": "ِsāَّnlِّl", "root": "انس"}, {"id": 6, "arabic": "وَأَمْنًا", "translit": "āًnْmَaʾَw", "root": "امن"}, {"id": 7, "arabic": "وَٱتَّخِذُوا۟", "translit": "۟āwُhdِhkَّtٱَw", "root": "اخذ"}, {"id": 8, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 9, "arabic": "مَّقَامِ", "translit": "ِmāَqَّm", "root": "قوم"}, {"id": 10, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 11, "arabic": "مُصَلًّى", "translit": "àًّlَṣُm", "root": "صلو"}, {"id": 12, "arabic": "وَعَهِدْنَآ", "translit": "ٓāَnْdِhَʿعَw", "root": "عهد"}, {"id": 13, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 14, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 15, "arabic": "وَإِسْمَٰعِيلَ", "translit": "َlyِʿعَٰmْsِiʾَw", "root": ""}, {"id": 16, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 17, "arabic": "طَهِّرَا", "translit": "āَrِّhَṭ", "root": "طهر"}, {"id": 18, "arabic": "بَيْتِىَ", "translit": "َàِtْyَb", "root": "بيت"}, {"id": 19, "arabic": "لِلطَّآئِفِينَ", "translit": "َnyِfِyʾٓāَّṭlِl", "root": "طوف"}, {"id": 20, "arabic": "وَٱلْعَٰكِفِينَ", "translit": "َnyِfِkَٰʿعْlٱَw", "root": "عكف"}, {"id": 21, "arabic": "وَٱلرُّكَّعِ", "translit": "ِʿعَّkُّrlٱَw", "root": "ركع"}, {"id": 22, "arabic": "ٱلسُّجُودِ", "translit": "ِdwُjgُّslٱ", "root": "سجد"}], "hasIhya": true}, {"ayah": 126, "text": "وَإِذْ قَالَ إِبْرَٰهِۦمُ رَبِّ ٱجْعَلْ هَٰذَا بَلَدًا ءَامِنًا وَٱرْزُقْ أَهْلَهُۥ مِنَ ٱلثَّمَرَٰتِ مَنْ ءَامَنَ مِنْهُم بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِۖ قَالَ وَمَن كَفَرَ فَأُمَتِّعُهُۥ قَلِيلًا ثُمَّ أَضْطَرُّهُۥٓ إِلَىٰ عَذَابِ ٱلنَّارِۖ وَبِئْسَ ٱلْمَصِيرُ ", "translation": "And [mention] when Abraham said, \"My Lord, make this a secure city and provide its people with fruits - whoever of them believes in Allāh and the Last Day.\" [Allāh] said, \"And whoever disbelieves - I will grant him enjoyment for a little; then I will force him to the punishment of the Fire, and wretched is the destination.\"", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "إِبْرَٰهِۦمُ", "translit": "ُmۦِhَٰrْbِiʾ", "root": ""}, {"id": 4, "arabic": "رَبِّ", "translit": "ِّbَr", "root": "ربب"}, {"id": 5, "arabic": "ٱجْعَلْ", "translit": "ْlَʿعْjgٱ", "root": "جعل"}, {"id": 6, "arabic": "هَٰذَا", "translit": "āَhdَٰh", "root": ""}, {"id": 7, "arabic": "بَلَدًا", "translit": "āًdَlَb", "root": "بلد"}, {"id": 8, "arabic": "ءَامِنًا", "translit": "āًnِmāَء", "root": "امن"}, {"id": 9, "arabic": "وَٱرْزُقْ", "translit": "ْqُzْrٱَw", "root": "رزق"}, {"id": 10, "arabic": "أَهْلَهُۥ", "translit": "ۥُhَlْhَaʾ", "root": "اهل"}, {"id": 11, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 12, "arabic": "ٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱ", "root": "ثمر"}, {"id": 13, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 14, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 15, "arabic": "مِنْهُم", "translit": "mُhْnِm", "root": ""}, {"id": 16, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 17, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 18, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 19, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 20, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 21, "arabic": "كَفَرَ", "translit": "َrَfَk", "root": "كفر"}, {"id": 22, "arabic": "فَأُمَتِّعُهُۥ", "translit": "ۥُhُʿعِّtَmُaʾَf", "root": "متع"}, {"id": 23, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 24, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 25, "arabic": "أَضْطَرُّهُۥٓ", "translit": "ٓۥُhُّrَṭْḍَaʾ", "root": "ضرر"}, {"id": 26, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 27, "arabic": "عَذَابِ", "translit": "ِbāَhdَʿع", "root": "عذب"}, {"id": 28, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 29, "arabic": "وَبِئْسَ", "translit": "َsْyʾِbَw", "root": "باس"}, {"id": 30, "arabic": "ٱلْمَصِيرُ", "translit": "ُryِṣَmْlٱ", "root": "صير"}], "hasIhya": false}, {"ayah": 127, "text": "وَإِذْ يَرْفَعُ إِبْرَٰهِۦمُ ٱلْقَوَاعِدَ مِنَ ٱلْبَيْتِ وَإِسْمَٰعِيلُ رَبَّنَا تَقَبَّلْ مِنَّآۖ إِنَّكَ أَنتَ ٱلسَّمِيعُ ٱلْعَلِيمُ ", "translation": "And [mention] when Abraham was raising the foundations of the House and [with him] Ishmael, [saying], \"Our Lord, accept [this] from us. Indeed, You are the Hearing,[1] the Knowing.[2]", "words": [{"id": 1, "arabic": "وَإِذْ", "translit": "ْhdِiʾَw", "root": ""}, {"id": 2, "arabic": "يَرْفَعُ", "translit": "ُʿعَfْrَy", "root": "رفع"}, {"id": 3, "arabic": "إِبْرَٰهِۦمُ", "translit": "ُmۦِhَٰrْbِiʾ", "root": ""}, {"id": 4, "arabic": "ٱلْقَوَاعِدَ", "translit": "َdِʿعāَwَqْlٱ", "root": "قعد"}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱلْبَيْتِ", "translit": "ِtْyَbْlٱ", "root": "بيت"}, {"id": 7, "arabic": "وَإِسْمَٰعِيلُ", "translit": "ُlyِʿعَٰmْsِiʾَw", "root": ""}, {"id": 8, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 9, "arabic": "تَقَبَّلْ", "translit": "ْlَّbَqَt", "root": "قبل"}, {"id": 10, "arabic": "مِنَّآ", "translit": "ٓāَّnِm", "root": ""}, {"id": 11, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 12, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 13, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 14, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": true}, {"ayah": 128, "text": "رَبَّنَا وَٱجْعَلْنَا مُسْلِمَيْنِ لَكَ وَمِن ذُرِّيَّتِنَآ أُمَّةً مُّسْلِمَةً لَّكَ وَأَرِنَا مَنَاسِكَنَا وَتُبْ عَلَيْنَآۖ إِنَّكَ أَنتَ ٱلتَّوَّابُ ٱلرَّحِيمُ ", "translation": "Our Lord, and make us Muslims [in submission] to You and from our descendants a Muslim nation [in submission] to You. And show us our rites [of worship] and accept our repentance. Indeed, You are the Accepting of Repentance, the Merciful.", "words": [{"id": 1, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "وَٱجْعَلْنَا", "translit": "āَnْlَʿعْjgٱَw", "root": "جعل"}, {"id": 3, "arabic": "مُسْلِمَيْنِ", "translit": "ِnْyَmِlْsُm", "root": "سلم"}, {"id": 4, "arabic": "لَكَ", "translit": "َkَl", "root": ""}, {"id": 5, "arabic": "وَمِن", "translit": "nِmَw", "root": ""}, {"id": 6, "arabic": "ذُرِّيَّتِنَآ", "translit": "ٓāَnِtَّyِّrُhd", "root": "ذرر"}, {"id": 7, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 8, "arabic": "مُّسْلِمَةً", "translit": "ًẗَmِlْsُّm", "root": "سلم"}, {"id": 9, "arabic": "لَّكَ", "translit": "َkَّl", "root": ""}, {"id": 10, "arabic": "وَأَرِنَا", "translit": "āَnِrَaʾَw", "root": "راي"}, {"id": 11, "arabic": "مَنَاسِكَنَا", "translit": "āَnَkِsāَnَm", "root": "نسك"}, {"id": 12, "arabic": "وَتُبْ", "translit": "ْbُtَw", "root": "توب"}, {"id": 13, "arabic": "عَلَيْنَآ", "translit": "ٓāَnْyَlَʿع", "root": ""}, {"id": 14, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 15, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 16, "arabic": "ٱلتَّوَّابُ", "translit": "ُbāَّwَّtlٱ", "root": "توب"}, {"id": 17, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": true}, {"ayah": 129, "text": "رَبَّنَا وَٱبْعَثْ فِيهِمْ رَسُولًا مِّنْهُمْ يَتْلُوا۟ عَلَيْهِمْ ءَايَٰتِكَ وَيُعَلِّمُهُمُ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ وَيُزَكِّيهِمْۚ إِنَّكَ أَنتَ ٱلْعَزِيزُ ٱلْحَكِيمُ ", "translation": "Our Lord, and send among them a messenger from themselves who will recite to them Your verses and teach them the Book and wisdom and purify them. Indeed, You are the Exalted in Might,[1] the Wise.\"", "words": [{"id": 1, "arabic": "رَبَّنَا", "translit": "āَnَّbَr", "root": "ربب"}, {"id": 2, "arabic": "وَٱبْعَثْ", "translit": "ْhtَʿعْbٱَw", "root": "بعث"}, {"id": 3, "arabic": "فِيهِمْ", "translit": "ْmِhyِf", "root": ""}, {"id": 4, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 5, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 6, "arabic": "يَتْلُوا۟", "translit": "۟āwُlْtَy", "root": "تلو"}, {"id": 7, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 8, "arabic": "ءَايَٰتِكَ", "translit": "َkِtَٰyāَء", "root": "ايي"}, {"id": 9, "arabic": "وَيُعَلِّمُهُمُ", "translit": "ُmُhُmِّlَʿعُyَw", "root": "علم"}, {"id": 10, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 11, "arabic": "وَٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱَw", "root": "حكم"}, {"id": 12, "arabic": "وَيُزَكِّيهِمْ", "translit": "ْmِhyِّkَzُyَw", "root": "زكو"}, {"id": 13, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 14, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 15, "arabic": "ٱلْعَزِيزُ", "translit": "ُzyِzَʿعْlٱ", "root": "عزز"}, {"id": 16, "arabic": "ٱلْحَكِيمُ", "translit": "ُmyِkَḥْlٱ", "root": "حكم"}], "hasIhya": false}, {"ayah": 130, "text": "وَمَن يَرْغَبُ عَن مِّلَّةِ إِبْرَٰهِۦمَ إِلَّا مَن سَفِهَ نَفْسَهُۥۚ وَلَقَدِ ٱصْطَفَيْنَٰهُ فِى ٱلدُّنْيَاۖ وَإِنَّهُۥ فِى ٱلْءَاخِرَةِ لَمِنَ ٱلصَّٰلِحِينَ ", "translation": "And who would be averse to the religion of Abraham except one who makes a fool of himself. And We had chosen him in this world, and indeed he, in the Hereafter, will be among the righteous.", "words": [{"id": 1, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 2, "arabic": "يَرْغَبُ", "translit": "ُbَغْrَy", "root": "رغب"}, {"id": 3, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 4, "arabic": "مِّلَّةِ", "translit": "ِẗَّlِّm", "root": "ملل"}, {"id": 5, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 8, "arabic": "سَفِهَ", "translit": "َhِfَs", "root": "سفه"}, {"id": 9, "arabic": "نَفْسَهُۥ", "translit": "ۥُhَsْfَn", "root": "نفس"}, {"id": 10, "arabic": "وَلَقَدِ", "translit": "ِdَqَlَw", "root": ""}, {"id": 11, "arabic": "ٱصْطَفَيْنَٰهُ", "translit": "ُhَٰnْyَfَṭْṣٱ", "root": "صفو"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلدُّنْيَا", "translit": "āَyْnُّdlٱ", "root": "دنو"}, {"id": 14, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 15, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 16, "arabic": "ٱلْءَاخِرَةِ", "translit": "ِẗَrِhkāَءْlٱ", "root": "اخر"}, {"id": 17, "arabic": "لَمِنَ", "translit": "َnِmَl", "root": ""}, {"id": 18, "arabic": "ٱلصَّٰلِحِينَ", "translit": "َnyِḥِlَّٰṣlٱ", "root": "صلح"}], "hasIhya": false}, {"ayah": 131, "text": "إِذْ قَالَ لَهُۥ رَبُّهُۥٓ أَسْلِمْۖ قَالَ أَسْلَمْتُ لِرَبِّ ٱلْعَٰلَمِينَ ", "translation": "When his Lord said to him, \"Submit,\" he said, \"I have submitted [in Islām][1] to the Lord of the worlds.\"", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 3, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 4, "arabic": "رَبُّهُۥٓ", "translit": "ٓۥُhُّbَr", "root": "ربب"}, {"id": 5, "arabic": "أَسْلِمْ", "translit": "ْmِlْsَaʾ", "root": "سلم"}, {"id": 6, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 7, "arabic": "أَسْلَمْتُ", "translit": "ُtْmَlْsَaʾ", "root": "سلم"}, {"id": 8, "arabic": "لِرَبِّ", "translit": "ِّbَrِl", "root": "ربب"}, {"id": 9, "arabic": "ٱلْعَٰلَمِينَ", "translit": "َnyِmَlَٰʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 132, "text": "وَوَصَّىٰ بِهَآ إِبْرَٰهِۦمُ بَنِيهِ وَيَعْقُوبُ يَٰبَنِىَّ إِنَّ ٱللَّهَ ٱصْطَفَىٰ لَكُمُ ٱلدِّينَ فَلَا تَمُوتُنَّ إِلَّا وَأَنتُم مُّسْلِمُونَ ", "translation": "And Abraham instructed his sons [to do the same] and [so did] Jacob, [saying], \"O my sons, indeed Allāh has chosen for you this religion, so do not die except while you are Muslims.\"", "words": [{"id": 1, "arabic": "وَوَصَّىٰ", "translit": "ٰàَّṣَwَw", "root": "وصي"}, {"id": 2, "arabic": "بِهَآ", "translit": "ٓāَhِb", "root": ""}, {"id": 3, "arabic": "إِبْرَٰهِۦمُ", "translit": "ُmۦِhَٰrْbِiʾ", "root": ""}, {"id": 4, "arabic": "بَنِيهِ", "translit": "ِhyِnَb", "root": "بني"}, {"id": 5, "arabic": "وَيَعْقُوبُ", "translit": "ُbwُqْʿعَyَw", "root": ""}, {"id": 6, "arabic": "يَٰبَنِىَّ", "translit": "َّàِnَbَٰy", "root": "بني"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "ٱصْطَفَىٰ", "translit": "ٰàَfَṭْṣٱ", "root": "صفو"}, {"id": 10, "arabic": "لَكُمُ", "translit": "ُmُkَl", "root": ""}, {"id": 11, "arabic": "ٱلدِّينَ", "translit": "َnyِّdlٱ", "root": "دين"}, {"id": 12, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 13, "arabic": "تَمُوتُنَّ", "translit": "َّnُtwُmَt", "root": "موت"}, {"id": 14, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 15, "arabic": "وَأَنتُم", "translit": "mُtnَaʾَw", "root": ""}, {"id": 16, "arabic": "مُّسْلِمُونَ", "translit": "َnwُmِlْsُّm", "root": "سلم"}], "hasIhya": true}, {"ayah": 133, "text": "أَمْ كُنتُمْ شُهَدَآءَ إِذْ حَضَرَ يَعْقُوبَ ٱلْمَوْتُ إِذْ قَالَ لِبَنِيهِ مَا تَعْبُدُونَ مِنۢ بَعْدِى قَالُوا۟ نَعْبُدُ إِلَٰهَكَ وَإِلَٰهَ ءَابَآئِكَ إِبْرَٰهِۦمَ وَإِسْمَٰعِيلَ وَإِسْحَٰقَ إِلَٰهًا وَٰحِدًا وَنَحْنُ لَهُۥ مُسْلِمُونَ ", "translation": "Or were you witnesses when death approached Jacob, when he said to his sons, \"What will you worship after me?\" They said, \"We will worship your God and the God of your fathers, Abraham and Ishmael and Isaac - one God.[1] And we are Muslims [in submission] to Him.\"", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 3, "arabic": "شُهَدَآءَ", "translit": "َءٓāَdَhُhs", "root": "شهد"}, {"id": 4, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 5, "arabic": "حَضَرَ", "translit": "َrَḍَḥ", "root": "حضر"}, {"id": 6, "arabic": "يَعْقُوبَ", "translit": "َbwُqْʿعَy", "root": ""}, {"id": 7, "arabic": "ٱلْمَوْتُ", "translit": "ُtْwَmْlٱ", "root": "موت"}, {"id": 8, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 9, "arabic": "قَالَ", "translit": "َlāَq", "root": "قول"}, {"id": 10, "arabic": "لِبَنِيهِ", "translit": "ِhyِnَbِl", "root": "بني"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}, {"id": 13, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 14, "arabic": "بَعْدِى", "translit": "àِdْʿعَb", "root": "بعد"}, {"id": 15, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 16, "arabic": "نَعْبُدُ", "translit": "ُdُbْʿعَn", "root": "عبد"}, {"id": 17, "arabic": "إِلَٰهَكَ", "translit": "َkَhَٰlِiʾ", "root": "اله"}, {"id": 18, "arabic": "وَإِلَٰهَ", "translit": "َhَٰlِiʾَw", "root": "اله"}, {"id": 19, "arabic": "ءَابَآئِكَ", "translit": "َkِyʾٓāَbāَء", "root": "ابو"}, {"id": 20, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 21, "arabic": "وَإِسْمَٰعِيلَ", "translit": "َlyِʿعَٰmْsِiʾَw", "root": ""}, {"id": 22, "arabic": "وَإِسْحَٰقَ", "translit": "َqَٰḥْsِiʾَw", "root": ""}, {"id": 23, "arabic": "إِلَٰهًا", "translit": "āًhَٰlِiʾ", "root": "اله"}, {"id": 24, "arabic": "وَٰحِدًا", "translit": "āًdِḥَٰw", "root": "وحد"}, {"id": 25, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 26, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 27, "arabic": "مُسْلِمُونَ", "translit": "َnwُmِlْsُm", "root": "سلم"}], "hasIhya": false}, {"ayah": 134, "text": "تِلْكَ أُمَّةٌ قَدْ خَلَتْۖ لَهَا مَا كَسَبَتْ وَلَكُم مَّا كَسَبْتُمْۖ وَلَا تُسْـَٔلُونَ عَمَّا كَانُوا۟ يَعْمَلُونَ ", "translation": "That was a nation which has passed on. It will have [the consequence of] what it earned, and you will have what you have earned. And you will not be asked about what they used to do.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو"}, {"id": 5, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 8, "arabic": "وَلَكُم", "translit": "mُkَlَw", "root": ""}, {"id": 9, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 10, "arabic": "كَسَبْتُمْ", "translit": "ْmُtْbَsَk", "root": "كسب"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تُسْـَٔلُونَ", "translit": "َnwُlَٔـْsُt", "root": "سال"}, {"id": 13, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 14, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 15, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 135, "text": "وَقَالُوا۟ كُونُوا۟ هُودًا أَوْ نَصَٰرَىٰ تَهْتَدُوا۟ۗ قُلْ بَلْ مِلَّةَ إِبْرَٰهِۦمَ حَنِيفًاۖ وَمَا كَانَ مِنَ ٱلْمُشْرِكِينَ ", "translation": "They say, \"Be Jews or Christians [so] you will be guided.\" Say, \"Rather, [we follow] the religion of Abraham, inclining toward truth, and he was not of the polytheists.\"[1]", "words": [{"id": 1, "arabic": "وَقَالُوا۟", "translit": "۟āwُlāَqَw", "root": "قول"}, {"id": 2, "arabic": "كُونُوا۟", "translit": "۟āwُnwُk", "root": "كون"}, {"id": 3, "arabic": "هُودًا", "translit": "āًdwُh", "root": "هود"}, {"id": 4, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 5, "arabic": "نَصَٰرَىٰ", "translit": "ٰàَrَٰṣَn", "root": "نصر"}, {"id": 6, "arabic": "تَهْتَدُوا۟", "translit": "۟āwُdَtْhَt", "root": "هدي"}, {"id": 7, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 8, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 9, "arabic": "مِلَّةَ", "translit": "َẗَّlِm", "root": "ملل"}, {"id": 10, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 11, "arabic": "حَنِيفًا", "translit": "āًfyِnَḥ", "root": "حنف"}, {"id": 12, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 13, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 14, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 15, "arabic": "ٱلْمُشْرِكِينَ", "translit": "َnyِkِrْhsُmْlٱ", "root": "شرك"}], "hasIhya": true}, {"ayah": 136, "text": "قُولُوٓا۟ ءَامَنَّا بِٱللَّهِ وَمَآ أُنزِلَ إِلَيْنَا وَمَآ أُنزِلَ إِلَىٰٓ إِبْرَٰهِۦمَ وَإِسْمَٰعِيلَ وَإِسْحَٰقَ وَيَعْقُوبَ وَٱلْأَسْبَاطِ وَمَآ أُوتِىَ مُوسَىٰ وَعِيسَىٰ وَمَآ أُوتِىَ ٱلنَّبِيُّونَ مِن رَّبِّهِمْ لَا نُفَرِّقُ بَيْنَ أَحَدٍ مِّنْهُمْ وَنَحْنُ لَهُۥ مُسْلِمُونَ ", "translation": "Say, [O believers], \"We have believed in Allāh and what has been revealed to us and what has been revealed to Abraham and Ishmael and Isaac and Jacob and the Descendants [al-Asbāṭ][1] and what was given to Moses and Jesus and what was given to the prophets from their Lord. We make no distinction between any of them, and we are Muslims [in submission] to Him.\"", "words": [{"id": 1, "arabic": "قُولُوٓا۟", "translit": "۟āٓwُlwُq", "root": "قول"}, {"id": 2, "arabic": "ءَامَنَّا", "translit": "āَّnَmāَء", "root": "امن"}, {"id": 3, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 4, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 5, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 6, "arabic": "إِلَيْنَا", "translit": "āَnْyَlِiʾ", "root": ""}, {"id": 7, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 8, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 9, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 10, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 11, "arabic": "وَإِسْمَٰعِيلَ", "translit": "َlyِʿعَٰmْsِiʾَw", "root": ""}, {"id": 12, "arabic": "وَإِسْحَٰقَ", "translit": "َqَٰḥْsِiʾَw", "root": ""}, {"id": 13, "arabic": "وَيَعْقُوبَ", "translit": "َbwُqْʿعَyَw", "root": ""}, {"id": 14, "arabic": "وَٱلْأَسْبَاطِ", "translit": "ِṭāَbْsَaʾْlٱَw", "root": "سبط"}, {"id": 15, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 16, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 17, "arabic": "مُوسَىٰ", "translit": "ٰàَswُm", "root": ""}, {"id": 18, "arabic": "وَعِيسَىٰ", "translit": "ٰàَsyِʿعَw", "root": ""}, {"id": 19, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 20, "arabic": "أُوتِىَ", "translit": "َàِtwُaʾ", "root": "اتي"}, {"id": 21, "arabic": "ٱلنَّبِيُّونَ", "translit": "َnwُّyِbَّnlٱ", "root": "نبا"}, {"id": 22, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 23, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 24, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 25, "arabic": "نُفَرِّقُ", "translit": "ُqِّrَfُn", "root": "فرق"}, {"id": 26, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 27, "arabic": "أَحَدٍ", "translit": "ٍdَḥَaʾ", "root": "احد"}, {"id": 28, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 29, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 30, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 31, "arabic": "مُسْلِمُونَ", "translit": "َnwُmِlْsُm", "root": "سلم"}], "hasIhya": true}, {"ayah": 137, "text": "فَإِنْ ءَامَنُوا۟ بِمِثْلِ مَآ ءَامَنتُم بِهِۦ فَقَدِ ٱهْتَدَوا۟ۖ وَّإِن تَوَلَّوْا۟ فَإِنَّمَا هُمْ فِى شِقَاقٍۖ فَسَيَكْفِيكَهُمُ ٱللَّهُۚ وَهُوَ ٱلسَّمِيعُ ٱلْعَلِيمُ ", "translation": "So if they believe in the same as you believe in, then they have been [rightly] guided; but if they turn away, they are only in dissension, and Allāh will be sufficient for you against them. And He is the Hearing, the Knowing.", "words": [{"id": 1, "arabic": "فَإِنْ", "translit": "ْnِiʾَf", "root": ""}, {"id": 2, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 3, "arabic": "بِمِثْلِ", "translit": "ِlْhtِmِb", "root": "مثل"}, {"id": 4, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 5, "arabic": "ءَامَنتُم", "translit": "mُtnَmāَء", "root": "امن"}, {"id": 6, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 7, "arabic": "فَقَدِ", "translit": "ِdَqَf", "root": ""}, {"id": 8, "arabic": "ٱهْتَدَوا۟", "translit": "۟āwَdَtْhٱ", "root": "هدي"}, {"id": 9, "arabic": "وَّإِن", "translit": "nِiʾَّw", "root": ""}, {"id": 10, "arabic": "تَوَلَّوْا۟", "translit": "۟āْwَّlَwَt", "root": "ولي"}, {"id": 11, "arabic": "فَإِنَّمَا", "translit": "āَmَّnِiʾَf", "root": ""}, {"id": 12, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 13, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 14, "arabic": "شِقَاقٍ", "translit": "ٍqāَqِhs", "root": "شقق"}, {"id": 15, "arabic": "فَسَيَكْفِيكَهُمُ", "translit": "ُmُhَkyِfْkَyَsَf", "root": "كفي"}, {"id": 16, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 17, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 18, "arabic": "ٱلسَّمِيعُ", "translit": "ُʿعyِmَّslٱ", "root": "سمع"}, {"id": 19, "arabic": "ٱلْعَلِيمُ", "translit": "ُmyِlَʿعْlٱ", "root": "علم"}], "hasIhya": false}, {"ayah": 138, "text": "صِبْغَةَ ٱللَّهِۖ وَمَنْ أَحْسَنُ مِنَ ٱللَّهِ صِبْغَةًۖ وَنَحْنُ لَهُۥ عَٰبِدُونَ ", "translation": "[And say, \"Ours is] the religion of Allāh. And who is better than Allāh in [ordaining] religion? And we are worshippers of Him.\"", "words": [{"id": 1, "arabic": "صِبْغَةَ", "translit": "َẗَغْbِṣ", "root": "صبغ"}, {"id": 2, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 4, "arabic": "أَحْسَنُ", "translit": "ُnَsْḥَaʾ", "root": "حسن"}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "صِبْغَةً", "translit": "ًẗَغْbِṣ", "root": "صبغ"}, {"id": 8, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 9, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 10, "arabic": "عَٰبِدُونَ", "translit": "َnwُdِbَٰʿع", "root": "عبد"}], "hasIhya": false}, {"ayah": 139, "text": "قُلْ أَتُحَآجُّونَنَا فِى ٱللَّهِ وَهُوَ رَبُّنَا وَرَبُّكُمْ وَلَنَآ أَعْمَٰلُنَا وَلَكُمْ أَعْمَٰلُكُمْ وَنَحْنُ لَهُۥ مُخْلِصُونَ ", "translation": "Say, [O Muḥammad], \"Do you argue with us about Allāh while He is our Lord and your Lord? For us are our deeds, and for you are your deeds. And we are sincere [in deed and intention] to Him.\"", "words": [{"id": 1, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 2, "arabic": "أَتُحَآجُّونَنَا", "translit": "āَnَnwُّjgٓāَḥُtَaʾ", "root": "حجج"}, {"id": 3, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 4, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 5, "arabic": "وَهُوَ", "translit": "َwُhَw", "root": ""}, {"id": 6, "arabic": "رَبُّنَا", "translit": "āَnُّbَr", "root": "ربب"}, {"id": 7, "arabic": "وَرَبُّكُمْ", "translit": "ْmُkُّbَrَw", "root": "ربب"}, {"id": 8, "arabic": "وَلَنَآ", "translit": "ٓāَnَlَw", "root": ""}, {"id": 9, "arabic": "أَعْمَٰلُنَا", "translit": "āَnُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 10, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 11, "arabic": "أَعْمَٰلُكُمْ", "translit": "ْmُkُlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 12, "arabic": "وَنَحْنُ", "translit": "ُnْḥَnَw", "root": ""}, {"id": 13, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 14, "arabic": "مُخْلِصُونَ", "translit": "َnwُṣِlْhkُm", "root": "خلص"}], "hasIhya": false}, {"ayah": 140, "text": "أَمْ تَقُولُونَ إِنَّ إِبْرَٰهِۦمَ وَإِسْمَٰعِيلَ وَإِسْحَٰقَ وَيَعْقُوبَ وَٱلْأَسْبَاطَ كَانُوا۟ هُودًا أَوْ نَصَٰرَىٰۗ قُلْ ءَأَنتُمْ أَعْلَمُ أَمِ ٱللَّهُۗ وَمَنْ أَظْلَمُ مِمَّن كَتَمَ شَهَٰدَةً عِندَهُۥ مِنَ ٱللَّهِۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعْمَلُونَ ", "translation": "Or do you say that Abraham and Ishmael and Isaac and Jacob and the Descendants were Jews or Christians? Say, \"Are you more knowing or is Allāh?\" And who is more unjust than one who conceals a testimony[1] he has from Allāh? And Allāh is not unaware of what you do.", "words": [{"id": 1, "arabic": "أَمْ", "translit": "ْmَaʾ", "root": ""}, {"id": 2, "arabic": "تَقُولُونَ", "translit": "َnwُlwُqَt", "root": "قول"}, {"id": 3, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 4, "arabic": "إِبْرَٰهِۦمَ", "translit": "َmۦِhَٰrْbِiʾ", "root": ""}, {"id": 5, "arabic": "وَإِسْمَٰعِيلَ", "translit": "َlyِʿعَٰmْsِiʾَw", "root": ""}, {"id": 6, "arabic": "وَإِسْحَٰقَ", "translit": "َqَٰḥْsِiʾَw", "root": ""}, {"id": 7, "arabic": "وَيَعْقُوبَ", "translit": "َbwُqْʿعَyَw", "root": ""}, {"id": 8, "arabic": "وَٱلْأَسْبَاطَ", "translit": "َṭāَbْsَaʾْlٱَw", "root": "سبط"}, {"id": 9, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 10, "arabic": "هُودًا", "translit": "āًdwُh", "root": "هود"}, {"id": 11, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 12, "arabic": "نَصَٰرَىٰ", "translit": "ٰàَrَٰṣَn", "root": "نصر"}, {"id": 13, "arabic": "قُلْ", "translit": "ْlُq", "root": "قول"}, {"id": 14, "arabic": "ءَأَنتُمْ", "translit": "ْmُtnَaʾَء", "root": ""}, {"id": 15, "arabic": "أَعْلَمُ", "translit": "ُmَlْʿعَaʾ", "root": "علم"}, {"id": 16, "arabic": "أَمِ", "translit": "ِmَaʾ", "root": ""}, {"id": 17, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 18, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 19, "arabic": "أَظْلَمُ", "translit": "ُmَlْẓَaʾ", "root": "ظلم"}, {"id": 20, "arabic": "مِمَّن", "translit": "nَّmِm", "root": ""}, {"id": 21, "arabic": "كَتَمَ", "translit": "َmَtَk", "root": "كتم"}, {"id": 22, "arabic": "شَهَٰدَةً", "translit": "ًẗَdَٰhَhs", "root": "شهد"}, {"id": 23, "arabic": "عِندَهُۥ", "translit": "ۥُhَdnِʿع", "root": "عند"}, {"id": 24, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 25, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 26, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 27, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 28, "arabic": "بِغَٰفِلٍ", "translit": "ٍlِfَٰغِb", "root": "غفل"}, {"id": 29, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 30, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 141, "text": "تِلْكَ أُمَّةٌ قَدْ خَلَتْۖ لَهَا مَا كَسَبَتْ وَلَكُم مَّا كَسَبْتُمْۖ وَلَا تُسْـَٔلُونَ عَمَّا كَانُوا۟ يَعْمَلُونَ ", "translation": "That is a nation which has passed on. It will have [the consequence of] what it earned, and you will have what you have earned. And you will not be asked about what they used to do.", "words": [{"id": 1, "arabic": "تِلْكَ", "translit": "َkْlِt", "root": ""}, {"id": 2, "arabic": "أُمَّةٌ", "translit": "ٌẗَّmُaʾ", "root": "امم"}, {"id": 3, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 4, "arabic": "خَلَتْ", "translit": "ْtَlَhk", "root": "خلو"}, {"id": 5, "arabic": "لَهَا", "translit": "āَhَl", "root": ""}, {"id": 6, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 7, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 8, "arabic": "وَلَكُم", "translit": "mُkَlَw", "root": ""}, {"id": 9, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 10, "arabic": "كَسَبْتُمْ", "translit": "ْmُtْbَsَk", "root": "كسب"}, {"id": 11, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 12, "arabic": "تُسْـَٔلُونَ", "translit": "َnwُlَٔـْsُt", "root": "سال"}, {"id": 13, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 14, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 15, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": false}, {"ayah": 142, "text": "سَيَقُولُ ٱلسُّفَهَآءُ مِنَ ٱلنَّاسِ مَا وَلَّىٰهُمْ عَن قِبْلَتِهِمُ ٱلَّتِى كَانُوا۟ عَلَيْهَاۚ قُل لِّلَّهِ ٱلْمَشْرِقُ وَٱلْمَغْرِبُۚ يَهْدِى مَن يَشَآءُ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ ", "translation": "The foolish among the people will say, \"What has turned them away from their qiblah,[1] which they used to face?\"[2] Say, \"To Allāh belongs the east and the west. He guides whom He wills to a straight path.\"", "words": [{"id": 1, "arabic": "سَيَقُولُ", "translit": "ُlwُqَyَs", "root": "قول"}, {"id": 2, "arabic": "ٱلسُّفَهَآءُ", "translit": "ُءٓāَhَfُّslٱ", "root": "سفه"}, {"id": 3, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 4, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 5, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 6, "arabic": "وَلَّىٰهُمْ", "translit": "ْmُhٰàَّlَw", "root": "ولي"}, {"id": 7, "arabic": "عَن", "translit": "nَʿع", "root": ""}, {"id": 8, "arabic": "قِبْلَتِهِمُ", "translit": "ُmِhِtَlْbِq", "root": "قبل"}, {"id": 9, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 10, "arabic": "كَانُوا۟", "translit": "۟āwُnāَk", "root": "كون"}, {"id": 11, "arabic": "عَلَيْهَا", "translit": "āَhْyَlَʿع", "root": ""}, {"id": 12, "arabic": "قُل", "translit": "lُq", "root": "قول"}, {"id": 13, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 14, "arabic": "ٱلْمَشْرِقُ", "translit": "ُqِrْhsَmْlٱ", "root": "شرق"}, {"id": 15, "arabic": "وَٱلْمَغْرِبُ", "translit": "ُbِrْغَmْlٱَw", "root": "غرب"}, {"id": 16, "arabic": "يَهْدِى", "translit": "àِdْhَy", "root": "هدي"}, {"id": 17, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 18, "arabic": "يَشَآءُ", "translit": "ُءٓāَhsَy", "root": "شيا"}, {"id": 19, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 20, "arabic": "صِرَٰطٍ", "translit": "ٍṭَٰrِṣ", "root": "صرط"}, {"id": 21, "arabic": "مُّسْتَقِيمٍ", "translit": "ٍmyِqَtْsُّm", "root": "قوم"}], "hasIhya": false}, {"ayah": 143, "text": "وَكَذَٰلِكَ جَعَلْنَٰكُمْ أُمَّةً وَسَطًا لِّتَكُونُوا۟ شُهَدَآءَ عَلَى ٱلنَّاسِ وَيَكُونَ ٱلرَّسُولُ عَلَيْكُمْ شَهِيدًاۗ وَمَا جَعَلْنَا ٱلْقِبْلَةَ ٱلَّتِى كُنتَ عَلَيْهَآ إِلَّا لِنَعْلَمَ مَن يَتَّبِعُ ٱلرَّسُولَ مِمَّن يَنقَلِبُ عَلَىٰ عَقِبَيْهِۚ وَإِن كَانَتْ لَكَبِيرَةً إِلَّا عَلَى ٱلَّذِينَ هَدَى ٱللَّهُۗ وَمَا كَانَ ٱللَّهُ لِيُضِيعَ إِيمَٰنَكُمْۚ إِنَّ ٱللَّهَ بِٱلنَّاسِ لَرَءُوفٌ رَّحِيمٌ ", "translation": "And thus We have made you a median [i.e., just] community that you will be witnesses over the people and the Messenger will be a witness over you. And We did not make the qiblah which you used to face except that We might make evident who would follow the Messenger from who would turn back on his heels.[1] And indeed, it is difficult except for those whom Allāh has guided. And never would Allāh have caused you to lose your faith [i.e., your previous prayers]. Indeed Allāh is, to the people, Kind and Merciful.", "words": [{"id": 1, "arabic": "وَكَذَٰلِكَ", "translit": "َkِlَٰhdَkَw", "root": ""}, {"id": 2, "arabic": "جَعَلْنَٰكُمْ", "translit": "ْmُkَٰnْlَʿعَjg", "root": "جعل"}, {"id": 3, "arabic": "أُمَّةً", "translit": "ًẗَّmُaʾ", "root": "امم"}, {"id": 4, "arabic": "وَسَطًا", "translit": "āًṭَsَw", "root": "وسط"}, {"id": 5, "arabic": "لِّتَكُونُوا۟", "translit": "۟āwُnwُkَtِّl", "root": "كون"}, {"id": 6, "arabic": "شُهَدَآءَ", "translit": "َءٓāَdَhُhs", "root": "شهد"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 9, "arabic": "وَيَكُونَ", "translit": "َnwُkَyَw", "root": "كون"}, {"id": 10, "arabic": "ٱلرَّسُولُ", "translit": "ُlwُsَّrlٱ", "root": "رسل"}, {"id": 11, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 12, "arabic": "شَهِيدًا", "translit": "āًdyِhَhs", "root": "شهد"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "جَعَلْنَا", "translit": "āَnْlَʿعَjg", "root": "جعل"}, {"id": 15, "arabic": "ٱلْقِبْلَةَ", "translit": "َẗَlْbِqْlٱ", "root": "قبل"}, {"id": 16, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 17, "arabic": "كُنتَ", "translit": "َtnُk", "root": "كون"}, {"id": 18, "arabic": "عَلَيْهَآ", "translit": "ٓāَhْyَlَʿع", "root": ""}, {"id": 19, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 20, "arabic": "لِنَعْلَمَ", "translit": "َmَlْʿعَnِl", "root": "علم"}, {"id": 21, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 22, "arabic": "يَتَّبِعُ", "translit": "ُʿعِbَّtَy", "root": "تبع"}, {"id": 23, "arabic": "ٱلرَّسُولَ", "translit": "َlwُsَّrlٱ", "root": "رسل"}, {"id": 24, "arabic": "مِمَّن", "translit": "nَّmِm", "root": ""}, {"id": 25, "arabic": "يَنقَلِبُ", "translit": "ُbِlَqnَy", "root": "قلب"}, {"id": 26, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 27, "arabic": "عَقِبَيْهِ", "translit": "ِhْyَbِqَʿع", "root": "عقب"}, {"id": 28, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 29, "arabic": "كَانَتْ", "translit": "ْtَnāَk", "root": "كون"}, {"id": 30, "arabic": "لَكَبِيرَةً", "translit": "ًẗَryِbَkَl", "root": "كبر"}, {"id": 31, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 32, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 33, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 34, "arabic": "هَدَى", "translit": "àَdَh", "root": "هدي"}, {"id": 35, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 36, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 37, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 38, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 39, "arabic": "لِيُضِيعَ", "translit": "َʿعyِḍُyِl", "root": "ضيع"}, {"id": 40, "arabic": "إِيمَٰنَكُمْ", "translit": "ْmُkَnَٰmyِiʾ", "root": "امن"}, {"id": 41, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 42, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 43, "arabic": "بِٱلنَّاسِ", "translit": "ِsāَّnlٱِb", "root": "انس"}, {"id": 44, "arabic": "لَرَءُوفٌ", "translit": "ٌfwُءَrَl", "root": "راف"}, {"id": 45, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": true}, {"ayah": 144, "text": "قَدْ نَرَىٰ تَقَلُّبَ وَجْهِكَ فِى ٱلسَّمَآءِۖ فَلَنُوَلِّيَنَّكَ قِبْلَةً تَرْضَىٰهَاۚ فَوَلِّ وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ ٱلْحَرَامِۚ وَحَيْثُ مَا كُنتُمْ فَوَلُّوا۟ وُجُوهَكُمْ شَطْرَهُۥۗ وَإِنَّ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ لَيَعْلَمُونَ أَنَّهُ ٱلْحَقُّ مِن رَّبِّهِمْۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا يَعْمَلُونَ ", "translation": "We have certainly seen the turning of your face, [O Muḥammad], toward the heaven, and We will surely turn you to a qiblah with which you will be pleased. So turn your face [i.e., yourself] toward al-Masjid al-Ḥarām.[1] And wherever you [believers] are, turn your faces [i.e., yourselves] toward it [in prayer]. Indeed, those who have been given the Scripture [i.e., the Jews and the Christians] well know that it is the truth from their Lord. And Allāh is not unaware of what they do.", "words": [{"id": 1, "arabic": "قَدْ", "translit": "ْdَq", "root": ""}, {"id": 2, "arabic": "نَرَىٰ", "translit": "ٰàَrَn", "root": "راي"}, {"id": 3, "arabic": "تَقَلُّبَ", "translit": "َbُّlَqَt", "root": "قلب"}, {"id": 4, "arabic": "وَجْهِكَ", "translit": "َkِhْjgَw", "root": "وجه"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 7, "arabic": "فَلَنُوَلِّيَنَّكَ", "translit": "َkَّnَyِّlَwُnَlَf", "root": "ولي"}, {"id": 8, "arabic": "قِبْلَةً", "translit": "ًẗَlْbِq", "root": "قبل"}, {"id": 9, "arabic": "تَرْضَىٰهَا", "translit": "āَhٰàَḍْrَt", "root": "رضو"}, {"id": 10, "arabic": "فَوَلِّ", "translit": "ِّlَwَf", "root": "ولي"}, {"id": 11, "arabic": "وَجْهَكَ", "translit": "َkَhْjgَw", "root": "وجه"}, {"id": 12, "arabic": "شَطْرَ", "translit": "َrْṭَhs", "root": "شطر"}, {"id": 13, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد"}, {"id": 14, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 15, "arabic": "وَحَيْثُ", "translit": "ُhtْyَḥَw", "root": "حيث"}, {"id": 16, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 17, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 18, "arabic": "فَوَلُّوا۟", "translit": "۟āwُّlَwَf", "root": "ولي"}, {"id": 19, "arabic": "وُجُوهَكُمْ", "translit": "ْmُkَhwُjgُw", "root": "وجه"}, {"id": 20, "arabic": "شَطْرَهُۥ", "translit": "ۥُhَrْṭَhs", "root": "شطر"}, {"id": 21, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 22, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 23, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 24, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 25, "arabic": "لَيَعْلَمُونَ", "translit": "َnwُmَlْʿعَyَl", "root": "علم"}, {"id": 26, "arabic": "أَنَّهُ", "translit": "ُhَّnَaʾ", "root": ""}, {"id": 27, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 28, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 29, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 30, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 31, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 32, "arabic": "بِغَٰفِلٍ", "translit": "ٍlِfَٰغِb", "root": "غفل"}, {"id": 33, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 34, "arabic": "يَعْمَلُونَ", "translit": "َnwُlَmْʿعَy", "root": "عمل"}], "hasIhya": true}, {"ayah": 145, "text": "وَلَئِنْ أَتَيْتَ ٱلَّذِينَ أُوتُوا۟ ٱلْكِتَٰبَ بِكُلِّ ءَايَةٍ مَّا تَبِعُوا۟ قِبْلَتَكَۚ وَمَآ أَنتَ بِتَابِعٍ قِبْلَتَهُمْۚ وَمَا بَعْضُهُم بِتَابِعٍ قِبْلَةَ بَعْضٍۚ وَلَئِنِ ٱتَّبَعْتَ أَهْوَآءَهُم مِّنۢ بَعْدِ مَا جَآءَكَ مِنَ ٱلْعِلْمِۙ إِنَّكَ إِذًا لَّمِنَ ٱلظَّٰلِمِينَ ", "translation": "And if you brought to those who were given the Scripture every sign, they would not follow your qiblah. Nor will you be a follower of their qiblah. Nor would they be followers of one another's qiblah. So if you were to follow their desires after what has come to you of knowledge, indeed, you would then be among the wrongdoers.", "words": [{"id": 1, "arabic": "وَلَئِنْ", "translit": "ْnِyʾَlَw", "root": ""}, {"id": 2, "arabic": "أَتَيْتَ", "translit": "َtْyَtَaʾ", "root": "اتي"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أُوتُوا۟", "translit": "۟āwُtwُaʾ", "root": "اتي"}, {"id": 5, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "بِكُلِّ", "translit": "ِّlُkِb", "root": "كلل"}, {"id": 7, "arabic": "ءَايَةٍ", "translit": "ٍẗَyāَء", "root": "ايي"}, {"id": 8, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 9, "arabic": "تَبِعُوا۟", "translit": "۟āwُʿعِbَt", "root": "تبع"}, {"id": 10, "arabic": "قِبْلَتَكَ", "translit": "َkَtَlْbِq", "root": "قبل"}, {"id": 11, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 12, "arabic": "أَنتَ", "translit": "َtnَaʾ", "root": ""}, {"id": 13, "arabic": "بِتَابِعٍ", "translit": "ٍʿعِbāَtِb", "root": "تبع"}, {"id": 14, "arabic": "قِبْلَتَهُمْ", "translit": "ْmُhَtَlْbِq", "root": "قبل"}, {"id": 15, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 16, "arabic": "بَعْضُهُم", "translit": "mُhُḍْʿعَb", "root": "بعض"}, {"id": 17, "arabic": "بِتَابِعٍ", "translit": "ٍʿعِbāَtِb", "root": "تبع"}, {"id": 18, "arabic": "قِبْلَةَ", "translit": "َẗَlْbِq", "root": "قبل"}, {"id": 19, "arabic": "بَعْضٍ", "translit": "ٍḍْʿعَb", "root": "بعض"}, {"id": 20, "arabic": "وَلَئِنِ", "translit": "ِnِyʾَlَw", "root": ""}, {"id": 21, "arabic": "ٱتَّبَعْتَ", "translit": "َtْʿعَbَّtٱ", "root": "تبع"}, {"id": 22, "arabic": "أَهْوَآءَهُم", "translit": "mُhَءٓāَwْhَaʾ", "root": "هوي"}, {"id": 23, "arabic": "مِّنۢ", "translit": "ۢnِّm", "root": ""}, {"id": 24, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 25, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 26, "arabic": "جَآءَكَ", "translit": "َkَءٓāَjg", "root": "جيا"}, {"id": 27, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 28, "arabic": "ٱلْعِلْمِ", "translit": "ِmْlِʿعْlٱ", "root": "علم"}, {"id": 29, "arabic": "إِنَّكَ", "translit": "َkَّnِiʾ", "root": ""}, {"id": 30, "arabic": "إِذًا", "translit": "āًhdِiʾ", "root": ""}, {"id": 31, "arabic": "لَّمِنَ", "translit": "َnِmَّl", "root": ""}, {"id": 32, "arabic": "ٱلظَّٰلِمِينَ", "translit": "َnyِmِlَّٰẓlٱ", "root": "ظلم"}], "hasIhya": false}, {"ayah": 146, "text": "ٱلَّذِينَ ءَاتَيْنَٰهُمُ ٱلْكِتَٰبَ يَعْرِفُونَهُۥ كَمَا يَعْرِفُونَ أَبْنَآءَهُمْۖ وَإِنَّ فَرِيقًا مِّنْهُمْ لَيَكْتُمُونَ ٱلْحَقَّ وَهُمْ يَعْلَمُونَ ", "translation": "Those to whom We gave the Scripture know him [i.e., Prophet Muḥammad (ﷺ)] as they know their own sons. But indeed, a party of them conceal the truth while they know [it].", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "ءَاتَيْنَٰهُمُ", "translit": "ُmُhَٰnْyَtāَء", "root": "اتي"}, {"id": 3, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 4, "arabic": "يَعْرِفُونَهُۥ", "translit": "ۥُhَnwُfِrْʿعَy", "root": "عرف"}, {"id": 5, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 6, "arabic": "يَعْرِفُونَ", "translit": "َnwُfِrْʿعَy", "root": "عرف"}, {"id": 7, "arabic": "أَبْنَآءَهُمْ", "translit": "ْmُhَءٓāَnْbَaʾ", "root": "بني"}, {"id": 8, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 9, "arabic": "فَرِيقًا", "translit": "āًqyِrَf", "root": "فرق"}, {"id": 10, "arabic": "مِّنْهُمْ", "translit": "ْmُhْnِّm", "root": ""}, {"id": 11, "arabic": "لَيَكْتُمُونَ", "translit": "َnwُmُtْkَyَl", "root": "كتم"}, {"id": 12, "arabic": "ٱلْحَقَّ", "translit": "َّqَḥْlٱ", "root": "حقق"}, {"id": 13, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 14, "arabic": "يَعْلَمُونَ", "translit": "َnwُmَlْʿعَy", "root": "علم"}], "hasIhya": true}, {"ayah": 147, "text": "ٱلْحَقُّ مِن رَّبِّكَۖ فَلَا تَكُونَنَّ مِنَ ٱلْمُمْتَرِينَ ", "translation": "The truth is from your Lord, so never be among the doubters.", "words": [{"id": 1, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 2, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 3, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 4, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 5, "arabic": "تَكُونَنَّ", "translit": "َّnَnwُkَt", "root": "كون"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْمُمْتَرِينَ", "translit": "َnyِrَtْmُmْlٱ", "root": "مري"}], "hasIhya": false}, {"ayah": 148, "text": "وَلِكُلٍّ وِجْهَةٌ هُوَ مُوَلِّيهَاۖ فَٱسْتَبِقُوا۟ ٱلْخَيْرَٰتِۚ أَيْنَ مَا تَكُونُوا۟ يَأْتِ بِكُمُ ٱللَّهُ جَمِيعًاۚ إِنَّ ٱللَّهَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ ", "translation": "For each [religious following] is a [prayer] direction toward which it faces. So race to [all that is] good. Wherever you may be, Allāh will bring you forth [for judgement] all together. Indeed, Allāh is over all things competent.", "words": [{"id": 1, "arabic": "وَلِكُلٍّ", "translit": "ٍّlُkِlَw", "root": "كلل"}, {"id": 2, "arabic": "وِجْهَةٌ", "translit": "ٌẗَhْjgِw", "root": "وجه"}, {"id": 3, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 4, "arabic": "مُوَلِّيهَا", "translit": "āَhyِّlَwُm", "root": "ولي"}, {"id": 5, "arabic": "فَٱسْتَبِقُوا۟", "translit": "۟āwُqِbَtْsٱَf", "root": "سبق"}, {"id": 6, "arabic": "ٱلْخَيْرَٰتِ", "translit": "ِtَٰrْyَhkْlٱ", "root": "خير"}, {"id": 7, "arabic": "أَيْنَ", "translit": "َnْyَaʾ", "root": ""}, {"id": 8, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 9, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 10, "arabic": "يَأْتِ", "translit": "ِtْaʾَy", "root": "اتي"}, {"id": 11, "arabic": "بِكُمُ", "translit": "ُmُkِb", "root": ""}, {"id": 12, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 14, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 15, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 17, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 18, "arabic": "شَىْءٍ", "translit": "ٍءْàَhs", "root": "شيا"}, {"id": 19, "arabic": "قَدِيرٌ", "translit": "ٌryِdَq", "root": "قدر"}], "hasIhya": false}, {"ayah": 149, "text": "وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ ٱلْحَرَامِۖ وَإِنَّهُۥ لَلْحَقُّ مِن رَّبِّكَۗ وَمَا ٱللَّهُ بِغَٰفِلٍ عَمَّا تَعْمَلُونَ ", "translation": "So from wherever you go out [for prayer, O Muḥammad], turn your face toward al-Masjid al-Ḥarām, and indeed, it is the truth from your Lord. And Allāh is not unaware of what you do.", "words": [{"id": 1, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 2, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 3, "arabic": "خَرَجْتَ", "translit": "َtْjgَrَhk", "root": "خرج"}, {"id": 4, "arabic": "فَوَلِّ", "translit": "ِّlَwَf", "root": "ولي"}, {"id": 5, "arabic": "وَجْهَكَ", "translit": "َkَhْjgَw", "root": "وجه"}, {"id": 6, "arabic": "شَطْرَ", "translit": "َrْṭَhs", "root": "شطر"}, {"id": 7, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد"}, {"id": 8, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 9, "arabic": "وَإِنَّهُۥ", "translit": "ۥُhَّnِiʾَw", "root": ""}, {"id": 10, "arabic": "لَلْحَقُّ", "translit": "ُّqَḥْlَl", "root": "حقق"}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "رَّبِّكَ", "translit": "َkِّbَّr", "root": "ربب"}, {"id": 13, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 14, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "بِغَٰفِلٍ", "translit": "ٍlِfَٰغِb", "root": "غفل"}, {"id": 16, "arabic": "عَمَّا", "translit": "āَّmَʿع", "root": ""}, {"id": 17, "arabic": "تَعْمَلُونَ", "translit": "َnwُlَmْʿعَt", "root": "عمل"}], "hasIhya": false}, {"ayah": 150, "text": "وَمِنْ حَيْثُ خَرَجْتَ فَوَلِّ وَجْهَكَ شَطْرَ ٱلْمَسْجِدِ ٱلْحَرَامِۚ وَحَيْثُ مَا كُنتُمْ فَوَلُّوا۟ وُجُوهَكُمْ شَطْرَهُۥ لِئَلَّا يَكُونَ لِلنَّاسِ عَلَيْكُمْ حُجَّةٌ إِلَّا ٱلَّذِينَ ظَلَمُوا۟ مِنْهُمْ فَلَا تَخْشَوْهُمْ وَٱخْشَوْنِى وَلِأُتِمَّ نِعْمَتِى عَلَيْكُمْ وَلَعَلَّكُمْ تَهْتَدُونَ ", "translation": "And from wherever you go out [for prayer], turn your face toward al-Masjid al-Ḥarām. And wherever you [believers] may be, turn your faces toward it in order that the people will not have any argument against you, except for those of them who commit wrong; so fear them not but fear Me. And [it is] so I may complete My favor upon you and that you may be guided,", "words": [{"id": 1, "arabic": "وَمِنْ", "translit": "ْnِmَw", "root": ""}, {"id": 2, "arabic": "حَيْثُ", "translit": "ُhtْyَḥ", "root": "حيث"}, {"id": 3, "arabic": "خَرَجْتَ", "translit": "َtْjgَrَhk", "root": "خرج"}, {"id": 4, "arabic": "فَوَلِّ", "translit": "ِّlَwَf", "root": "ولي"}, {"id": 5, "arabic": "وَجْهَكَ", "translit": "َkَhْjgَw", "root": "وجه"}, {"id": 6, "arabic": "شَطْرَ", "translit": "َrْṭَhs", "root": "شطر"}, {"id": 7, "arabic": "ٱلْمَسْجِدِ", "translit": "ِdِjgْsَmْlٱ", "root": "سجد"}, {"id": 8, "arabic": "ٱلْحَرَامِ", "translit": "ِmāَrَḥْlٱ", "root": "حرم"}, {"id": 9, "arabic": "وَحَيْثُ", "translit": "ُhtْyَḥَw", "root": "حيث"}, {"id": 10, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 11, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 12, "arabic": "فَوَلُّوا۟", "translit": "۟āwُّlَwَf", "root": "ولي"}, {"id": 13, "arabic": "وُجُوهَكُمْ", "translit": "ْmُkَhwُjgُw", "root": "وجه"}, {"id": 14, "arabic": "شَطْرَهُۥ", "translit": "ۥُhَrْṭَhs", "root": "شطر"}, {"id": 15, "arabic": "لِئَلَّا", "translit": "āَّlَyʾِl", "root": ""}, {"id": 16, "arabic": "يَكُونَ", "translit": "َnwُkَy", "root": "كون"}, {"id": 17, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 18, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 19, "arabic": "حُجَّةٌ", "translit": "ٌẗَّjgُḥ", "root": "حجج"}, {"id": 20, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 21, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 22, "arabic": "ظَلَمُوا۟", "translit": "۟āwُmَlَẓ", "root": "ظلم"}, {"id": 23, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 24, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 25, "arabic": "تَخْشَوْهُمْ", "translit": "ْmُhْwَhsْhkَt", "root": "خشي"}, {"id": 26, "arabic": "وَٱخْشَوْنِى", "translit": "àِnْwَhsْhkٱَw", "root": "خشي"}, {"id": 27, "arabic": "وَلِأُتِمَّ", "translit": "َّmِtُaʾِlَw", "root": "تمم"}, {"id": 28, "arabic": "نِعْمَتِى", "translit": "àِtَmْʿعِn", "root": "نعم"}, {"id": 29, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 30, "arabic": "وَلَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَlَw", "root": ""}, {"id": 31, "arabic": "تَهْتَدُونَ", "translit": "َnwُdَtْhَt", "root": "هدي"}], "hasIhya": true}, {"ayah": 151, "text": "كَمَآ أَرْسَلْنَا فِيكُمْ رَسُولًا مِّنكُمْ يَتْلُوا۟ عَلَيْكُمْ ءَايَٰتِنَا وَيُزَكِّيكُمْ وَيُعَلِّمُكُمُ ٱلْكِتَٰبَ وَٱلْحِكْمَةَ وَيُعَلِّمُكُم مَّا لَمْ تَكُونُوا۟ تَعْلَمُونَ ", "translation": "Just as We have sent among you a messenger from yourselves reciting to you Our verses and purifying you and teaching you the Book and wisdom[1] and teaching you that which you did not know.", "words": [{"id": 1, "arabic": "كَمَآ", "translit": "ٓāَmَk", "root": ""}, {"id": 2, "arabic": "أَرْسَلْنَا", "translit": "āَnْlَsْrَaʾ", "root": "رسل"}, {"id": 3, "arabic": "فِيكُمْ", "translit": "ْmُkyِf", "root": ""}, {"id": 4, "arabic": "رَسُولًا", "translit": "āًlwُsَr", "root": "رسل"}, {"id": 5, "arabic": "مِّنكُمْ", "translit": "ْmُknِّm", "root": ""}, {"id": 6, "arabic": "يَتْلُوا۟", "translit": "۟āwُlْtَy", "root": "تلو"}, {"id": 7, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 8, "arabic": "ءَايَٰتِنَا", "translit": "āَnِtَٰyāَء", "root": "ايي"}, {"id": 9, "arabic": "وَيُزَكِّيكُمْ", "translit": "ْmُkyِّkَzُyَw", "root": "زكو"}, {"id": 10, "arabic": "وَيُعَلِّمُكُمُ", "translit": "ُmُkُmِّlَʿعُyَw", "root": "علم"}, {"id": 11, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 12, "arabic": "وَٱلْحِكْمَةَ", "translit": "َẗَmْkِḥْlٱَw", "root": "حكم"}, {"id": 13, "arabic": "وَيُعَلِّمُكُم", "translit": "mُkُmِّlَʿعُyَw", "root": "علم"}, {"id": 14, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 15, "arabic": "لَمْ", "translit": "ْmَl", "root": ""}, {"id": 16, "arabic": "تَكُونُوا۟", "translit": "۟āwُnwُkَt", "root": "كون"}, {"id": 17, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 152, "text": "فَٱذْكُرُونِىٓ أَذْكُرْكُمْ وَٱشْكُرُوا۟ لِى وَلَا تَكْفُرُونِ ", "translation": "So remember Me; I will remember you. And be grateful to Me and do not deny Me.", "words": [{"id": 1, "arabic": "فَٱذْكُرُونِىٓ", "translit": "ٓàِnwُrُkْhdٱَf", "root": "ذكر"}, {"id": 2, "arabic": "أَذْكُرْكُمْ", "translit": "ْmُkْrُkْhdَaʾ", "root": "ذكر"}, {"id": 3, "arabic": "وَٱشْكُرُوا۟", "translit": "۟āwُrُkْhsٱَw", "root": "شكر"}, {"id": 4, "arabic": "لِى", "translit": "àِl", "root": ""}, {"id": 5, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 6, "arabic": "تَكْفُرُونِ", "translit": "ِnwُrُfْkَt", "root": "كفر"}], "hasIhya": true}, {"ayah": 153, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱسْتَعِينُوا۟ بِٱلصَّبْرِ وَٱلصَّلَوٰةِۚ إِنَّ ٱللَّهَ مَعَ ٱلصَّٰبِرِينَ ", "translation": "O you who have believed, seek help through patience and prayer. Indeed, Allāh is with the patient.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱسْتَعِينُوا۟", "translit": "۟āwُnyِʿعَtْsٱ", "root": "عون"}, {"id": 5, "arabic": "بِٱلصَّبْرِ", "translit": "ِrْbَّṣlٱِb", "root": "صبر"}, {"id": 6, "arabic": "وَٱلصَّلَوٰةِ", "translit": "ِẗٰwَlَّṣlٱَw", "root": "صلو"}, {"id": 7, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 8, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَعَ", "translit": "َʿعَm", "root": ""}, {"id": 10, "arabic": "ٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱ", "root": "صبر"}], "hasIhya": true}, {"ayah": 154, "text": "وَلَا تَقُولُوا۟ لِمَن يُقْتَلُ فِى سَبِيلِ ٱللَّهِ أَمْوَٰتٌۢۚ بَلْ أَحْيَآءٌ وَلَٰكِن لَّا تَشْعُرُونَ ", "translation": "And do not say about those who are killed in the way of Allāh, \"They are dead.\" Rather, they are alive, but you perceive [it] not.", "words": [{"id": 1, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 2, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 3, "arabic": "لِمَن", "translit": "nَmِl", "root": ""}, {"id": 4, "arabic": "يُقْتَلُ", "translit": "ُlَtْqُy", "root": "قتل"}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "سَبِيلِ", "translit": "ِlyِbَs", "root": "سبل"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "أَمْوَٰتٌۢ", "translit": "ٌۢtَٰwْmَaʾ", "root": "موت"}, {"id": 9, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 10, "arabic": "أَحْيَآءٌ", "translit": "ٌءٓāَyْḥَaʾ", "root": "حيي"}, {"id": 11, "arabic": "وَلَٰكِن", "translit": "nِkَٰlَw", "root": ""}, {"id": 12, "arabic": "لَّا", "translit": "āَّl", "root": ""}, {"id": 13, "arabic": "تَشْعُرُونَ", "translit": "َnwُrُʿعْhsَt", "root": "شعر"}], "hasIhya": false}, {"ayah": 155, "text": "وَلَنَبْلُوَنَّكُم بِشَىْءٍ مِّنَ ٱلْخَوْفِ وَٱلْجُوعِ وَنَقْصٍ مِّنَ ٱلْأَمْوَٰلِ وَٱلْأَنفُسِ وَٱلثَّمَرَٰتِۗ وَبَشِّرِ ٱلصَّٰبِرِينَ ", "translation": "And We will surely test you with something of fear and hunger and a loss of wealth and lives and fruits, but give good tidings to the patient,", "words": [{"id": 1, "arabic": "وَلَنَبْلُوَنَّكُم", "translit": "mُkَّnَwُlْbَnَlَw", "root": "بلو"}, {"id": 2, "arabic": "بِشَىْءٍ", "translit": "ٍءْàَhsِb", "root": "شيا"}, {"id": 3, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 4, "arabic": "ٱلْخَوْفِ", "translit": "ِfْwَhkْlٱ", "root": "خوف"}, {"id": 5, "arabic": "وَٱلْجُوعِ", "translit": "ِʿعwُjgْlٱَw", "root": "جوع"}, {"id": 6, "arabic": "وَنَقْصٍ", "translit": "ٍṣْqَnَw", "root": "نقص"}, {"id": 7, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 8, "arabic": "ٱلْأَمْوَٰلِ", "translit": "ِlَٰwْmَaʾْlٱ", "root": "مول"}, {"id": 9, "arabic": "وَٱلْأَنفُسِ", "translit": "ِsُfnَaʾْlٱَw", "root": "نفس"}, {"id": 10, "arabic": "وَٱلثَّمَرَٰتِ", "translit": "ِtَٰrَmَّhtlٱَw", "root": "ثمر"}, {"id": 11, "arabic": "وَبَشِّرِ", "translit": "ِrِّhsَbَw", "root": "بشر"}, {"id": 12, "arabic": "ٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱ", "root": "صبر"}], "hasIhya": false}, {"ayah": 156, "text": "ٱلَّذِينَ إِذَآ أَصَٰبَتْهُم مُّصِيبَةٌ قَالُوٓا۟ إِنَّا لِلَّهِ وَإِنَّآ إِلَيْهِ رَٰجِعُونَ ", "translation": "Who, when disaster strikes them, say, \"Indeed we belong to Allāh, and indeed to Him we will return.\"", "words": [{"id": 1, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 2, "arabic": "إِذَآ", "translit": "ٓāَhdِiʾ", "root": ""}, {"id": 3, "arabic": "أَصَٰبَتْهُم", "translit": "mُhْtَbَٰṣَaʾ", "root": "صوب"}, {"id": 4, "arabic": "مُّصِيبَةٌ", "translit": "ٌẗَbyِṣُّm", "root": "صوب"}, {"id": 5, "arabic": "قَالُوٓا۟", "translit": "۟āٓwُlāَq", "root": "قول"}, {"id": 6, "arabic": "إِنَّا", "translit": "āَّnِiʾ", "root": ""}, {"id": 7, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 8, "arabic": "وَإِنَّآ", "translit": "ٓāَّnِiʾَw", "root": ""}, {"id": 9, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 10, "arabic": "رَٰجِعُونَ", "translit": "َnwُʿعِjgَٰr", "root": "رجع"}], "hasIhya": true}, {"ayah": 157, "text": "أُو۟لَٰٓئِكَ عَلَيْهِمْ صَلَوَٰتٌ مِّن رَّبِّهِمْ وَرَحْمَةٌۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُهْتَدُونَ ", "translation": "Those are the ones upon whom are blessings from their Lord and mercy. And it is those who are the [rightly] guided.", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 3, "arabic": "صَلَوَٰتٌ", "translit": "ٌtَٰwَlَṣ", "root": "صلو"}, {"id": 4, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 5, "arabic": "رَّبِّهِمْ", "translit": "ْmِhِّbَّr", "root": "ربب"}, {"id": 6, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 7, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 8, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 9, "arabic": "ٱلْمُهْتَدُونَ", "translit": "َnwُdَtْhُmْlٱ", "root": "هدي"}], "hasIhya": true}, {"ayah": 158, "text": "إِنَّ ٱلصَّفَا وَٱلْمَرْوَةَ مِن شَعَآئِرِ ٱللَّهِۖ فَمَنْ حَجَّ ٱلْبَيْتَ أَوِ ٱعْتَمَرَ فَلَا جُنَاحَ عَلَيْهِ أَن يَطَّوَّفَ بِهِمَاۚ وَمَن تَطَوَّعَ خَيْرًا فَإِنَّ ٱللَّهَ شَاكِرٌ عَلِيمٌ ", "translation": "Indeed, aṣ-Ṣafā and al-Marwah are among the symbols[1] of Allāh. So whoever makes ḥajj [pilgrimage] to the House or performs ʿumrah - there is no blame upon him for walking between them.[2] And whoever volunteers good - then indeed, Allāh is Appreciative[3] and Knowing.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلصَّفَا", "translit": "āَfَّṣlٱ", "root": ""}, {"id": 3, "arabic": "وَٱلْمَرْوَةَ", "translit": "َẗَwْrَmْlٱَw", "root": "مرو"}, {"id": 4, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 5, "arabic": "شَعَآئِرِ", "translit": "ِrِyʾٓāَʿعَhs", "root": "شعر"}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "فَمَنْ", "translit": "ْnَmَf", "root": ""}, {"id": 8, "arabic": "حَجَّ", "translit": "َّjgَḥ", "root": "حجج"}, {"id": 9, "arabic": "ٱلْبَيْتَ", "translit": "َtْyَbْlٱ", "root": "بيت"}, {"id": 10, "arabic": "أَوِ", "translit": "ِwَaʾ", "root": ""}, {"id": 11, "arabic": "ٱعْتَمَرَ", "translit": "َrَmَtْʿعٱ", "root": "عمر"}, {"id": 12, "arabic": "فَلَا", "translit": "āَlَf", "root": ""}, {"id": 13, "arabic": "جُنَاحَ", "translit": "َḥāَnُjg", "root": "جنح"}, {"id": 14, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 15, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 16, "arabic": "يَطَّوَّفَ", "translit": "َfَّwَّṭَy", "root": "طوف"}, {"id": 17, "arabic": "بِهِمَا", "translit": "āَmِhِb", "root": ""}, {"id": 18, "arabic": "وَمَن", "translit": "nَmَw", "root": ""}, {"id": 19, "arabic": "تَطَوَّعَ", "translit": "َʿعَّwَṭَt", "root": "طوع"}, {"id": 20, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 21, "arabic": "فَإِنَّ", "translit": "َّnِiʾَf", "root": ""}, {"id": 22, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "شَاكِرٌ", "translit": "ٌrِkāَhs", "root": "شكر"}, {"id": 24, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 159, "text": "إِنَّ ٱلَّذِينَ يَكْتُمُونَ مَآ أَنزَلْنَا مِنَ ٱلْبَيِّنَٰتِ وَٱلْهُدَىٰ مِنۢ بَعْدِ مَا بَيَّنَّٰهُ لِلنَّاسِ فِى ٱلْكِتَٰبِۙ أُو۟لَٰٓئِكَ يَلْعَنُهُمُ ٱللَّهُ وَيَلْعَنُهُمُ ٱللَّٰعِنُونَ ", "translation": "Indeed, those who conceal what We sent down of clear proofs and guidance after We made it clear for the people in the Scripture - those are cursed by Allāh and cursed by those who curse,[1]", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَكْتُمُونَ", "translit": "َnwُmُtْkَy", "root": "كتم"}, {"id": 4, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 5, "arabic": "أَنزَلْنَا", "translit": "āَnْlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 7, "arabic": "ٱلْبَيِّنَٰتِ", "translit": "ِtَٰnِّyَbْlٱ", "root": "بين"}, {"id": 8, "arabic": "وَٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱَw", "root": "هدي"}, {"id": 9, "arabic": "مِنۢ", "translit": "ۢnِm", "root": ""}, {"id": 10, "arabic": "بَعْدِ", "translit": "ِdْʿعَb", "root": "بعد"}, {"id": 11, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 12, "arabic": "بَيَّنَّٰهُ", "translit": "ُhَّٰnَّyَb", "root": "بين"}, {"id": 13, "arabic": "لِلنَّاسِ", "translit": "ِsāَّnlِl", "root": "انس"}, {"id": 14, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 15, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 16, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 17, "arabic": "يَلْعَنُهُمُ", "translit": "ُmُhُnَʿعْlَy", "root": "لعن"}, {"id": 18, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 19, "arabic": "وَيَلْعَنُهُمُ", "translit": "ُmُhُnَʿعْlَyَw", "root": "لعن"}, {"id": 20, "arabic": "ٱللَّٰعِنُونَ", "translit": "َnwُnِʿعَّٰllٱ", "root": "لعن"}], "hasIhya": false}, {"ayah": 160, "text": "إِلَّا ٱلَّذِينَ تَابُوا۟ وَأَصْلَحُوا۟ وَبَيَّنُوا۟ فَأُو۟لَٰٓئِكَ أَتُوبُ عَلَيْهِمْۚ وَأَنَا ٱلتَّوَّابُ ٱلرَّحِيمُ ", "translation": "Except for those who repent and correct themselves and make evident [what they concealed]. Those - I will accept their repentance, and I am the Accepting of Repentance,[1] the Merciful.", "words": [{"id": 1, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "تَابُوا۟", "translit": "۟āwُbāَt", "root": "توب"}, {"id": 4, "arabic": "وَأَصْلَحُوا۟", "translit": "۟āwُḥَlْṣَaʾَw", "root": "صلح"}, {"id": 5, "arabic": "وَبَيَّنُوا۟", "translit": "۟āwُnَّyَbَw", "root": "بين"}, {"id": 6, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 7, "arabic": "أَتُوبُ", "translit": "ُbwُtَaʾ", "root": "توب"}, {"id": 8, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "وَأَنَا", "translit": "āَnَaʾَw", "root": ""}, {"id": 10, "arabic": "ٱلتَّوَّابُ", "translit": "ُbāَّwَّtlٱ", "root": "توب"}, {"id": 11, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": false}, {"ayah": 161, "text": "إِنَّ ٱلَّذِينَ كَفَرُوا۟ وَمَاتُوا۟ وَهُمْ كُفَّارٌ أُو۟لَٰٓئِكَ عَلَيْهِمْ لَعْنَةُ ٱللَّهِ وَٱلْمَلَٰٓئِكَةِ وَٱلنَّاسِ أَجْمَعِينَ ", "translation": "Indeed, those who disbelieve and die while they are disbelievers - upon them will be the curse of Allāh and of the angels and the people, all together,", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "وَمَاتُوا۟", "translit": "۟āwُtāَmَw", "root": "موت"}, {"id": 5, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 6, "arabic": "كُفَّارٌ", "translit": "ٌrāَّfُk", "root": "كفر"}, {"id": 7, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 8, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 9, "arabic": "لَعْنَةُ", "translit": "ُẗَnْʿعَl", "root": "لعن"}, {"id": 10, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 11, "arabic": "وَٱلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlٱَw", "root": "ملك"}, {"id": 12, "arabic": "وَٱلنَّاسِ", "translit": "ِsāَّnlٱَw", "root": "انس"}, {"id": 13, "arabic": "أَجْمَعِينَ", "translit": "َnyِʿعَmْjgَaʾ", "root": "جمع"}], "hasIhya": true}, {"ayah": 162, "text": "خَٰلِدِينَ فِيهَاۖ لَا يُخَفَّفُ عَنْهُمُ ٱلْعَذَابُ وَلَا هُمْ يُنظَرُونَ ", "translation": "Abiding eternally therein. The punishment will not be lightened for them, nor will they be reprieved.", "words": [{"id": 1, "arabic": "خَٰلِدِينَ", "translit": "َnyِdِlَٰhk", "root": "خلد"}, {"id": 2, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 3, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 4, "arabic": "يُخَفَّفُ", "translit": "ُfَّfَhkُy", "root": "خفف"}, {"id": 5, "arabic": "عَنْهُمُ", "translit": "ُmُhْnَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْعَذَابُ", "translit": "ُbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 7, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 8, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 9, "arabic": "يُنظَرُونَ", "translit": "َnwُrَẓnُy", "root": "نظر"}], "hasIhya": true}, {"ayah": 163, "text": "وَإِلَٰهُكُمْ إِلَٰهٌ وَٰحِدٌۖ لَّآ إِلَٰهَ إِلَّا هُوَ ٱلرَّحْمَٰنُ ٱلرَّحِيمُ ", "translation": "And your god is one God. There is no deity [worthy of worship] except Him, the Entirely Merciful, the Especially Merciful.", "words": [{"id": 1, "arabic": "وَإِلَٰهُكُمْ", "translit": "ْmُkُhَٰlِiʾَw", "root": "اله"}, {"id": 2, "arabic": "إِلَٰهٌ", "translit": "ٌhَٰlِiʾ", "root": "اله"}, {"id": 3, "arabic": "وَٰحِدٌ", "translit": "ٌdِḥَٰw", "root": "وحد"}, {"id": 4, "arabic": "لَّآ", "translit": "ٓāَّl", "root": ""}, {"id": 5, "arabic": "إِلَٰهَ", "translit": "َhَٰlِiʾ", "root": "اله"}, {"id": 6, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 7, "arabic": "هُوَ", "translit": "َwُh", "root": ""}, {"id": 8, "arabic": "ٱلرَّحْمَٰنُ", "translit": "ُnَٰmْḥَّrlٱ", "root": "رحم"}, {"id": 9, "arabic": "ٱلرَّحِيمُ", "translit": "ُmyِḥَّrlٱ", "root": "رحم"}], "hasIhya": true}, {"ayah": 164, "text": "إِنَّ فِى خَلْقِ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ وَٱخْتِلَٰفِ ٱلَّيْلِ وَٱلنَّهَارِ وَٱلْفُلْكِ ٱلَّتِى تَجْرِى فِى ٱلْبَحْرِ بِمَا يَنفَعُ ٱلنَّاسَ وَمَآ أَنزَلَ ٱللَّهُ مِنَ ٱلسَّمَآءِ مِن مَّآءٍ فَأَحْيَا بِهِ ٱلْأَرْضَ بَعْدَ مَوْتِهَا وَبَثَّ فِيهَا مِن كُلِّ دَآبَّةٍ وَتَصْرِيفِ ٱلرِّيَٰحِ وَٱلسَّحَابِ ٱلْمُسَخَّرِ بَيْنَ ٱلسَّمَآءِ وَٱلْأَرْضِ لَءَايَٰتٍ لِّقَوْمٍ يَعْقِلُونَ ", "translation": "Indeed, in the creation of the heavens and the earth, and the alternation of the night and the day, and the [great] ships which sail through the sea with that which benefits people, and what Allāh has sent down from the heavens of rain, giving life thereby to the earth after its lifelessness and dispersing therein every [kind of] moving creature, and [His] directing of the winds and the clouds controlled between the heaven and earth are signs for a people who use reason.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "خَلْقِ", "translit": "ِqْlَhk", "root": "خلق"}, {"id": 4, "arabic": "ٱلسَّمَٰوَٰتِ", "translit": "ِtَٰwَٰmَّslٱ", "root": "سمو"}, {"id": 5, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 6, "arabic": "وَٱخْتِلَٰفِ", "translit": "ِfَٰlِtْhkٱَw", "root": "خلف"}, {"id": 7, "arabic": "ٱلَّيْلِ", "translit": "ِlْyَّlٱ", "root": "ليل"}, {"id": 8, "arabic": "وَٱلنَّهَارِ", "translit": "ِrāَhَّnlٱَw", "root": "نهر"}, {"id": 9, "arabic": "وَٱلْفُلْكِ", "translit": "ِkْlُfْlٱَw", "root": "فلك"}, {"id": 10, "arabic": "ٱلَّتِى", "translit": "àِtَّlٱ", "root": ""}, {"id": 11, "arabic": "تَجْرِى", "translit": "àِrْjgَt", "root": "جري"}, {"id": 12, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 13, "arabic": "ٱلْبَحْرِ", "translit": "ِrْḥَbْlٱ", "root": "بحر"}, {"id": 14, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 15, "arabic": "يَنفَعُ", "translit": "ُʿعَfnَy", "root": "نفع"}, {"id": 16, "arabic": "ٱلنَّاسَ", "translit": "َsāَّnlٱ", "root": "انس"}, {"id": 17, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 18, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 19, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 20, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 21, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 22, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 23, "arabic": "مَّآءٍ", "translit": "ٍءٓāَّm", "root": "موه"}, {"id": 24, "arabic": "فَأَحْيَا", "translit": "āَyْḥَaʾَf", "root": "حيي"}, {"id": 25, "arabic": "بِهِ", "translit": "ِhِb", "root": ""}, {"id": 26, "arabic": "ٱلْأَرْضَ", "translit": "َḍْrَaʾْlٱ", "root": "ارض"}, {"id": 27, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 28, "arabic": "مَوْتِهَا", "translit": "āَhِtْwَm", "root": "موت"}, {"id": 29, "arabic": "وَبَثَّ", "translit": "َّhtَbَw", "root": "بثث"}, {"id": 30, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 31, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 32, "arabic": "كُلِّ", "translit": "ِّlُk", "root": "كلل"}, {"id": 33, "arabic": "دَآبَّةٍ", "translit": "ٍẗَّbٓāَd", "root": "دبب"}, {"id": 34, "arabic": "وَتَصْرِيفِ", "translit": "ِfyِrْṣَtَw", "root": "صرف"}, {"id": 35, "arabic": "ٱلرِّيَٰحِ", "translit": "ِḥَٰyِّrlٱ", "root": "روح"}, {"id": 36, "arabic": "وَٱلسَّحَابِ", "translit": "ِbāَḥَّslٱَw", "root": "سحب"}, {"id": 37, "arabic": "ٱلْمُسَخَّرِ", "translit": "ِrَّhkَsُmْlٱ", "root": "سخر"}, {"id": 38, "arabic": "بَيْنَ", "translit": "َnْyَb", "root": "بين"}, {"id": 39, "arabic": "ٱلسَّمَآءِ", "translit": "ِءٓāَmَّslٱ", "root": "سمو"}, {"id": 40, "arabic": "وَٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱَw", "root": "ارض"}, {"id": 41, "arabic": "لَءَايَٰتٍ", "translit": "ٍtَٰyāَءَl", "root": "ايي"}, {"id": 42, "arabic": "لِّقَوْمٍ", "translit": "ٍmْwَqِّl", "root": "قوم"}, {"id": 43, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": true}, {"ayah": 165, "text": "وَمِنَ ٱلنَّاسِ مَن يَتَّخِذُ مِن دُونِ ٱللَّهِ أَندَادًا يُحِبُّونَهُمْ كَحُبِّ ٱللَّهِۖ وَٱلَّذِينَ ءَامَنُوٓا۟ أَشَدُّ حُبًّا لِّلَّهِۗ وَلَوْ يَرَى ٱلَّذِينَ ظَلَمُوٓا۟ إِذْ يَرَوْنَ ٱلْعَذَابَ أَنَّ ٱلْقُوَّةَ لِلَّهِ جَمِيعًا وَأَنَّ ٱللَّهَ شَدِيدُ ٱلْعَذَابِ ", "translation": "And [yet], among the people are those who take other than Allāh as equals [to Him]. They love them as they [should] love Allāh. But those who believe are stronger in love for Allāh. And if only they who have wronged would consider [that] when they see the punishment, [they will be certain] that all power belongs to Allāh and that Allāh is severe in punishment.", "words": [{"id": 1, "arabic": "وَمِنَ", "translit": "َnِmَw", "root": ""}, {"id": 2, "arabic": "ٱلنَّاسِ", "translit": "ِsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "مَن", "translit": "nَm", "root": ""}, {"id": 4, "arabic": "يَتَّخِذُ", "translit": "ُhdِhkَّtَy", "root": "اخذ"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "دُونِ", "translit": "ِnwُd", "root": "دون"}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "أَندَادًا", "translit": "āًdāَdnَaʾ", "root": "ندد"}, {"id": 9, "arabic": "يُحِبُّونَهُمْ", "translit": "ْmُhَnwُّbِḥُy", "root": "حبب"}, {"id": 10, "arabic": "كَحُبِّ", "translit": "ِّbُḥَk", "root": "حبب"}, {"id": 11, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "وَٱلَّذِينَ", "translit": "َnyِhdَّlٱَw", "root": ""}, {"id": 13, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 14, "arabic": "أَشَدُّ", "translit": "ُّdَhsَaʾ", "root": "شدد"}, {"id": 15, "arabic": "حُبًّا", "translit": "āًّbُḥ", "root": "حبب"}, {"id": 16, "arabic": "لِّلَّهِ", "translit": "ِhَّlِّl", "root": "اله"}, {"id": 17, "arabic": "وَلَوْ", "translit": "ْwَlَw", "root": ""}, {"id": 18, "arabic": "يَرَى", "translit": "àَrَy", "root": "راي"}, {"id": 19, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 20, "arabic": "ظَلَمُوٓا۟", "translit": "۟āٓwُmَlَẓ", "root": "ظلم"}, {"id": 21, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 22, "arabic": "يَرَوْنَ", "translit": "َnْwَrَy", "root": "راي"}, {"id": 23, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 24, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 25, "arabic": "ٱلْقُوَّةَ", "translit": "َẗَّwُqْlٱ", "root": "قوي"}, {"id": 26, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 27, "arabic": "جَمِيعًا", "translit": "āًʿعyِmَjg", "root": "جمع"}, {"id": 28, "arabic": "وَأَنَّ", "translit": "َّnَaʾَw", "root": ""}, {"id": 29, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "شَدِيدُ", "translit": "ُdyِdَhs", "root": "شدد"}, {"id": 31, "arabic": "ٱلْعَذَابِ", "translit": "ِbāَhdَʿعْlٱ", "root": "عذب"}], "hasIhya": true}, {"ayah": 166, "text": "إِذْ تَبَرَّأَ ٱلَّذِينَ ٱتُّبِعُوا۟ مِنَ ٱلَّذِينَ ٱتَّبَعُوا۟ وَرَأَوُا۟ ٱلْعَذَابَ وَتَقَطَّعَتْ بِهِمُ ٱلْأَسْبَابُ ", "translation": "[And they should consider that] when those who have been followed disassociate themselves from those who followed [them], and they [all] see the punishment, and cut off from them are the ties [of relationship],", "words": [{"id": 1, "arabic": "إِذْ", "translit": "ْhdِiʾ", "root": ""}, {"id": 2, "arabic": "تَبَرَّأَ", "translit": "َaʾَّrَbَt", "root": "برا"}, {"id": 3, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "ٱتُّبِعُوا۟", "translit": "۟āwُʿعِbُّtٱ", "root": "تبع"}, {"id": 5, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 6, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 7, "arabic": "ٱتَّبَعُوا۟", "translit": "۟āwُʿعَbَّtٱ", "root": "تبع"}, {"id": 8, "arabic": "وَرَأَوُا۟", "translit": "۟āُwَaʾَrَw", "root": "راي"}, {"id": 9, "arabic": "ٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱ", "root": "عذب"}, {"id": 10, "arabic": "وَتَقَطَّعَتْ", "translit": "ْtَʿعَّṭَqَtَw", "root": "قطع"}, {"id": 11, "arabic": "بِهِمُ", "translit": "ُmِhِb", "root": ""}, {"id": 12, "arabic": "ٱلْأَسْبَابُ", "translit": "ُbāَbْsَaʾْlٱ", "root": "سبب"}], "hasIhya": false}, {"ayah": 167, "text": "وَقَالَ ٱلَّذِينَ ٱتَّبَعُوا۟ لَوْ أَنَّ لَنَا كَرَّةً فَنَتَبَرَّأَ مِنْهُمْ كَمَا تَبَرَّءُوا۟ مِنَّاۗ كَذَٰلِكَ يُرِيهِمُ ٱللَّهُ أَعْمَٰلَهُمْ حَسَرَٰتٍ عَلَيْهِمْۖ وَمَا هُم بِخَٰرِجِينَ مِنَ ٱلنَّارِ ", "translation": "Those who followed will say, \"If only we had another turn [at worldly life] so we could disassociate ourselves from them as they have disassociated themselves from us.\" Thus will Allāh show them their deeds as regrets upon them. And they are never to emerge from the Fire.", "words": [{"id": 1, "arabic": "وَقَالَ", "translit": "َlāَqَw", "root": "قول"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱتَّبَعُوا۟", "translit": "۟āwُʿعَbَّtٱ", "root": "تبع"}, {"id": 4, "arabic": "لَوْ", "translit": "ْwَl", "root": ""}, {"id": 5, "arabic": "أَنَّ", "translit": "َّnَaʾ", "root": ""}, {"id": 6, "arabic": "لَنَا", "translit": "āَnَl", "root": ""}, {"id": 7, "arabic": "كَرَّةً", "translit": "ًẗَّrَk", "root": "كرر"}, {"id": 8, "arabic": "فَنَتَبَرَّأَ", "translit": "َaʾَّrَbَtَnَf", "root": "برا"}, {"id": 9, "arabic": "مِنْهُمْ", "translit": "ْmُhْnِm", "root": ""}, {"id": 10, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 11, "arabic": "تَبَرَّءُوا۟", "translit": "۟āwُءَّrَbَt", "root": "برا"}, {"id": 12, "arabic": "مِنَّا", "translit": "āَّnِm", "root": ""}, {"id": 13, "arabic": "كَذَٰلِكَ", "translit": "َkِlَٰhdَk", "root": ""}, {"id": 14, "arabic": "يُرِيهِمُ", "translit": "ُmِhyِrُy", "root": "راي"}, {"id": 15, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 16, "arabic": "أَعْمَٰلَهُمْ", "translit": "ْmُhَlَٰmْʿعَaʾ", "root": "عمل"}, {"id": 17, "arabic": "حَسَرَٰتٍ", "translit": "ٍtَٰrَsَḥ", "root": "حسر"}, {"id": 18, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 19, "arabic": "وَمَا", "translit": "āَmَw", "root": ""}, {"id": 20, "arabic": "هُم", "translit": "mُh", "root": ""}, {"id": 21, "arabic": "بِخَٰرِجِينَ", "translit": "َnyِjgِrَٰhkِb", "root": "خرج"}, {"id": 22, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 23, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 168, "text": "يَٰٓأَيُّهَا ٱلنَّاسُ كُلُوا۟ مِمَّا فِى ٱلْأَرْضِ حَلَٰلًا طَيِّبًا وَلَا تَتَّبِعُوا۟ خُطُوَٰتِ ٱلشَّيْطَٰنِۚ إِنَّهُۥ لَكُمْ عَدُوٌّ مُّبِينٌ ", "translation": "O mankind, eat from whatever is on earth [that is] lawful and good and do not follow the footsteps of Satan. Indeed, he is to you a clear enemy.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلنَّاسُ", "translit": "ُsāَّnlٱ", "root": "انس"}, {"id": 3, "arabic": "كُلُوا۟", "translit": "۟āwُlُk", "root": "اكل"}, {"id": 4, "arabic": "مِمَّا", "translit": "āَّmِm", "root": ""}, {"id": 5, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 6, "arabic": "ٱلْأَرْضِ", "translit": "ِḍْrَaʾْlٱ", "root": "ارض"}, {"id": 7, "arabic": "حَلَٰلًا", "translit": "āًlَٰlَḥ", "root": "حلل"}, {"id": 8, "arabic": "طَيِّبًا", "translit": "āًbِّyَṭ", "root": "طيب"}, {"id": 9, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 10, "arabic": "تَتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtَt", "root": "تبع"}, {"id": 11, "arabic": "خُطُوَٰتِ", "translit": "ِtَٰwُṭُhk", "root": "خطو"}, {"id": 12, "arabic": "ٱلشَّيْطَٰنِ", "translit": "ِnَٰṭْyَّhslٱ", "root": "شطن"}, {"id": 13, "arabic": "إِنَّهُۥ", "translit": "ۥُhَّnِiʾ", "root": ""}, {"id": 14, "arabic": "لَكُمْ", "translit": "ْmُkَl", "root": ""}, {"id": 15, "arabic": "عَدُوٌّ", "translit": "ٌّwُdَʿع", "root": "عدو"}, {"id": 16, "arabic": "مُّبِينٌ", "translit": "ٌnyِbُّm", "root": "بين"}], "hasIhya": false}, {"ayah": 169, "text": "إِنَّمَا يَأْمُرُكُم بِٱلسُّوٓءِ وَٱلْفَحْشَآءِ وَأَن تَقُولُوا۟ عَلَى ٱللَّهِ مَا لَا تَعْلَمُونَ ", "translation": "He only orders you to evil and immorality and to say about Allāh what you do not know.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "يَأْمُرُكُم", "translit": "mُkُrُmْaʾَy", "root": "امر"}, {"id": 3, "arabic": "بِٱلسُّوٓءِ", "translit": "ِءٓwُّslٱِb", "root": "سوا"}, {"id": 4, "arabic": "وَٱلْفَحْشَآءِ", "translit": "ِءٓāَhsْḥَfْlٱَw", "root": "فحش"}, {"id": 5, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 6, "arabic": "تَقُولُوا۟", "translit": "۟āwُlwُqَt", "root": "قول"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 9, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 10, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 11, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 170, "text": "وَإِذَا قِيلَ لَهُمُ ٱتَّبِعُوا۟ مَآ أَنزَلَ ٱللَّهُ قَالُوا۟ بَلْ نَتَّبِعُ مَآ أَلْفَيْنَا عَلَيْهِ ءَابَآءَنَآۗ أَوَلَوْ كَانَ ءَابَآؤُهُمْ لَا يَعْقِلُونَ شَيْـًٔا وَلَا يَهْتَدُونَ ", "translation": "And when it is said to them, \"Follow what Allāh has revealed,\" they say, \"Rather, we will follow that which we found our fathers doing.\" Even though their fathers understood nothing, nor were they guided?", "words": [{"id": 1, "arabic": "وَإِذَا", "translit": "āَhdِiʾَw", "root": ""}, {"id": 2, "arabic": "قِيلَ", "translit": "َlyِq", "root": "قول"}, {"id": 3, "arabic": "لَهُمُ", "translit": "ُmُhَl", "root": ""}, {"id": 4, "arabic": "ٱتَّبِعُوا۟", "translit": "۟āwُʿعِbَّtٱ", "root": "تبع"}, {"id": 5, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 6, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 7, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "قَالُوا۟", "translit": "۟āwُlāَq", "root": "قول"}, {"id": 9, "arabic": "بَلْ", "translit": "ْlَb", "root": ""}, {"id": 10, "arabic": "نَتَّبِعُ", "translit": "ُʿعِbَّtَn", "root": "تبع"}, {"id": 11, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 12, "arabic": "أَلْفَيْنَا", "translit": "āَnْyَfْlَaʾ", "root": "لفو"}, {"id": 13, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 14, "arabic": "ءَابَآءَنَآ", "translit": "ٓāَnَءٓāَbāَء", "root": "ابو"}, {"id": 15, "arabic": "أَوَلَوْ", "translit": "ْwَlَwَaʾ", "root": ""}, {"id": 16, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 17, "arabic": "ءَابَآؤُهُمْ", "translit": "ْmُhُwʾٓāَbāَء", "root": "ابو"}, {"id": 18, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 19, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}, {"id": 20, "arabic": "شَيْـًٔا", "translit": "āًٔـْyَhs", "root": "شيا"}, {"id": 21, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 22, "arabic": "يَهْتَدُونَ", "translit": "َnwُdَtْhَy", "root": "هدي"}], "hasIhya": false}, {"ayah": 171, "text": "وَمَثَلُ ٱلَّذِينَ كَفَرُوا۟ كَمَثَلِ ٱلَّذِى يَنْعِقُ بِمَا لَا يَسْمَعُ إِلَّا دُعَآءً وَنِدَآءًۚ صُمٌّۢ بُكْمٌ عُمْىٌ فَهُمْ لَا يَعْقِلُونَ ", "translation": "The example of those who disbelieve is like that of one who shouts at what hears nothing but calls and cries [i.e., cattle or sheep] - deaf, dumb and blind, so they do not understand.", "words": [{"id": 1, "arabic": "وَمَثَلُ", "translit": "ُlَhtَmَw", "root": "مثل"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "كَفَرُوا۟", "translit": "۟āwُrَfَk", "root": "كفر"}, {"id": 4, "arabic": "كَمَثَلِ", "translit": "ِlَhtَmَk", "root": "مثل"}, {"id": 5, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 6, "arabic": "يَنْعِقُ", "translit": "ُqِʿعْnَy", "root": "نعق"}, {"id": 7, "arabic": "بِمَا", "translit": "āَmِb", "root": ""}, {"id": 8, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 9, "arabic": "يَسْمَعُ", "translit": "ُʿعَmْsَy", "root": "سمع"}, {"id": 10, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 11, "arabic": "دُعَآءً", "translit": "ًءٓāَʿعُd", "root": "دعو"}, {"id": 12, "arabic": "وَنِدَآءً", "translit": "ًءٓāَdِnَw", "root": "ندي"}, {"id": 13, "arabic": "صُمٌّۢ", "translit": "ٌّۢmُṣ", "root": "صمم"}, {"id": 14, "arabic": "بُكْمٌ", "translit": "ٌmْkُb", "root": "بكم"}, {"id": 15, "arabic": "عُمْىٌ", "translit": "ٌàْmُʿع", "root": "عمي"}, {"id": 16, "arabic": "فَهُمْ", "translit": "ْmُhَf", "root": ""}, {"id": 17, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 18, "arabic": "يَعْقِلُونَ", "translit": "َnwُlِqْʿعَy", "root": "عقل"}], "hasIhya": true}, {"ayah": 172, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ كُلُوا۟ مِن طَيِّبَٰتِ مَا رَزَقْنَٰكُمْ وَٱشْكُرُوا۟ لِلَّهِ إِن كُنتُمْ إِيَّاهُ تَعْبُدُونَ ", "translation": "O you who have believed, eat from the good [i.e., lawful] things which We have provided for you and be grateful to Allāh if it is [indeed] Him that you worship.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "كُلُوا۟", "translit": "۟āwُlُk", "root": "اكل"}, {"id": 5, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 6, "arabic": "طَيِّبَٰتِ", "translit": "ِtَٰbِّyَṭ", "root": "طيب"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "رَزَقْنَٰكُمْ", "translit": "ْmُkَٰnْqَzَr", "root": "رزق"}, {"id": 9, "arabic": "وَٱشْكُرُوا۟", "translit": "۟āwُrُkْhsٱَw", "root": "شكر"}, {"id": 10, "arabic": "لِلَّهِ", "translit": "ِhَّlِl", "root": "اله"}, {"id": 11, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 12, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 13, "arabic": "إِيَّاهُ", "translit": "ُhāَّyِiʾ", "root": ""}, {"id": 14, "arabic": "تَعْبُدُونَ", "translit": "َnwُdُbْʿعَt", "root": "عبد"}], "hasIhya": true}, {"ayah": 173, "text": "إِنَّمَا حَرَّمَ عَلَيْكُمُ ٱلْمَيْتَةَ وَٱلدَّمَ وَلَحْمَ ٱلْخِنزِيرِ وَمَآ أُهِلَّ بِهِۦ لِغَيْرِ ٱللَّهِۖ فَمَنِ ٱضْطُرَّ غَيْرَ بَاغٍ وَلَا عَادٍ فَلَآ إِثْمَ عَلَيْهِۚ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "He has only forbidden to you dead animals,[1] blood, the flesh of swine, and that which has been dedicated to other than Allāh. But whoever is forced [by necessity], neither desiring [it] nor transgressing [its limit], there is no sin upon him. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "إِنَّمَا", "translit": "āَmَّnِiʾ", "root": ""}, {"id": 2, "arabic": "حَرَّمَ", "translit": "َmَّrَḥ", "root": "حرم"}, {"id": 3, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 4, "arabic": "ٱلْمَيْتَةَ", "translit": "َẗَtْyَmْlٱ", "root": "موت"}, {"id": 5, "arabic": "وَٱلدَّمَ", "translit": "َmَّdlٱَw", "root": "دمو"}, {"id": 6, "arabic": "وَلَحْمَ", "translit": "َmْḥَlَw", "root": "لحم"}, {"id": 7, "arabic": "ٱلْخِنزِيرِ", "translit": "ِryِznِhkْlٱ", "root": "خنزر"}, {"id": 8, "arabic": "وَمَآ", "translit": "ٓāَmَw", "root": ""}, {"id": 9, "arabic": "أُهِلَّ", "translit": "َّlِhُaʾ", "root": "هلل"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "لِغَيْرِ", "translit": "ِrْyَغِl", "root": "غير"}, {"id": 12, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 13, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 14, "arabic": "ٱضْطُرَّ", "translit": "َّrُṭْḍٱ", "root": "ضرر"}, {"id": 15, "arabic": "غَيْرَ", "translit": "َrْyَغ", "root": "غير"}, {"id": 16, "arabic": "بَاغٍ", "translit": "ٍغāَb", "root": "بغي"}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "عَادٍ", "translit": "ٍdāَʿع", "root": "عدو"}, {"id": 19, "arabic": "فَلَآ", "translit": "ٓāَlَf", "root": ""}, {"id": 20, "arabic": "إِثْمَ", "translit": "َmْhtِiʾ", "root": "اثم"}, {"id": 21, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 22, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 23, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 24, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 25, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 174, "text": "إِنَّ ٱلَّذِينَ يَكْتُمُونَ مَآ أَنزَلَ ٱللَّهُ مِنَ ٱلْكِتَٰبِ وَيَشْتَرُونَ بِهِۦ ثَمَنًا قَلِيلًاۙ أُو۟لَٰٓئِكَ مَا يَأْكُلُونَ فِى بُطُونِهِمْ إِلَّا ٱلنَّارَ وَلَا يُكَلِّمُهُمُ ٱللَّهُ يَوْمَ ٱلْقِيَٰمَةِ وَلَا يُزَكِّيهِمْ وَلَهُمْ عَذَابٌ أَلِيمٌ ", "translation": "Indeed, they who conceal what Allāh has sent down of the Book and exchange it for a small price - those consume not into their bellies except the Fire. And Allāh will not speak to them on the Day of Resurrection, nor will He purify them. And they will have a painful punishment.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "يَكْتُمُونَ", "translit": "َnwُmُtْkَy", "root": "كتم"}, {"id": 4, "arabic": "مَآ", "translit": "ٓāَm", "root": ""}, {"id": 5, "arabic": "أَنزَلَ", "translit": "َlَznَaʾ", "root": "نزل"}, {"id": 6, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 8, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 9, "arabic": "وَيَشْتَرُونَ", "translit": "َnwُrَtْhsَyَw", "root": "شري"}, {"id": 10, "arabic": "بِهِۦ", "translit": "ۦِhِb", "root": ""}, {"id": 11, "arabic": "ثَمَنًا", "translit": "āًnَmَht", "root": "ثمن"}, {"id": 12, "arabic": "قَلِيلًا", "translit": "āًlyِlَq", "root": "قلل"}, {"id": 13, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 14, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 15, "arabic": "يَأْكُلُونَ", "translit": "َnwُlُkْaʾَy", "root": "اكل"}, {"id": 16, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 17, "arabic": "بُطُونِهِمْ", "translit": "ْmِhِnwُṭُb", "root": "بطن"}, {"id": 18, "arabic": "إِلَّا", "translit": "āَّlِiʾ", "root": ""}, {"id": 19, "arabic": "ٱلنَّارَ", "translit": "َrāَّnlٱ", "root": "نور"}, {"id": 20, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 21, "arabic": "يُكَلِّمُهُمُ", "translit": "ُmُhُmِّlَkُy", "root": "كلم"}, {"id": 22, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "يَوْمَ", "translit": "َmْwَy", "root": "يوم"}, {"id": 24, "arabic": "ٱلْقِيَٰمَةِ", "translit": "ِẗَmَٰyِqْlٱ", "root": "قوم"}, {"id": 25, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 26, "arabic": "يُزَكِّيهِمْ", "translit": "ْmِhyِّkَzُy", "root": "زكو"}, {"id": 27, "arabic": "وَلَهُمْ", "translit": "ْmُhَlَw", "root": ""}, {"id": 28, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 29, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 175, "text": "أُو۟لَٰٓئِكَ ٱلَّذِينَ ٱشْتَرَوُا۟ ٱلضَّلَٰلَةَ بِٱلْهُدَىٰ وَٱلْعَذَابَ بِٱلْمَغْفِرَةِۚ فَمَآ أَصْبَرَهُمْ عَلَى ٱلنَّارِ ", "translation": "Those are the ones who have exchanged guidance for error and forgiveness for punishment. How patient they are for [i.e., in pursuit of] the Fire!", "words": [{"id": 1, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ٱشْتَرَوُا۟", "translit": "۟āُwَrَtْhsٱ", "root": "شري"}, {"id": 4, "arabic": "ٱلضَّلَٰلَةَ", "translit": "َẗَlَٰlَّḍlٱ", "root": "ضلل"}, {"id": 5, "arabic": "بِٱلْهُدَىٰ", "translit": "ٰàَdُhْlٱِb", "root": "هدي"}, {"id": 6, "arabic": "وَٱلْعَذَابَ", "translit": "َbāَhdَʿعْlٱَw", "root": "عذب"}, {"id": 7, "arabic": "بِٱلْمَغْفِرَةِ", "translit": "ِẗَrِfْغَmْlٱِb", "root": "غفر"}, {"id": 8, "arabic": "فَمَآ", "translit": "ٓāَmَf", "root": ""}, {"id": 9, "arabic": "أَصْبَرَهُمْ", "translit": "ْmُhَrَbْṣَaʾ", "root": "صبر"}, {"id": 10, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 11, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}], "hasIhya": false}, {"ayah": 176, "text": "ذَٰلِكَ بِأَنَّ ٱللَّهَ نَزَّلَ ٱلْكِتَٰبَ بِٱلْحَقِّۗ وَإِنَّ ٱلَّذِينَ ٱخْتَلَفُوا۟ فِى ٱلْكِتَٰبِ لَفِى شِقَاقٍۭ بَعِيدٍ ", "translation": "That is [deserved by them] because Allāh has sent down the Book in truth. And indeed, those who differ over the Book are in extreme dissension.", "words": [{"id": 1, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 2, "arabic": "بِأَنَّ", "translit": "َّnَaʾِb", "root": ""}, {"id": 3, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 4, "arabic": "نَزَّلَ", "translit": "َlَّzَn", "root": "نزل"}, {"id": 5, "arabic": "ٱلْكِتَٰبَ", "translit": "َbَٰtِkْlٱ", "root": "كتب"}, {"id": 6, "arabic": "بِٱلْحَقِّ", "translit": "ِّqَḥْlٱِb", "root": "حقق"}, {"id": 7, "arabic": "وَإِنَّ", "translit": "َّnِiʾَw", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "ٱخْتَلَفُوا۟", "translit": "۟āwُfَlَtْhkٱ", "root": "خلف"}, {"id": 10, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 11, "arabic": "ٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱ", "root": "كتب"}, {"id": 12, "arabic": "لَفِى", "translit": "àِfَl", "root": ""}, {"id": 13, "arabic": "شِقَاقٍۭ", "translit": "ٍۭqāَqِhs", "root": "شقق"}, {"id": 14, "arabic": "بَعِيدٍ", "translit": "ٍdyِʿعَb", "root": "بعد"}], "hasIhya": false}, {"ayah": 177, "text": "لَّيْسَ ٱلْبِرَّ أَن تُوَلُّوا۟ وُجُوهَكُمْ قِبَلَ ٱلْمَشْرِقِ وَٱلْمَغْرِبِ وَلَٰكِنَّ ٱلْبِرَّ مَنْ ءَامَنَ بِٱللَّهِ وَٱلْيَوْمِ ٱلْءَاخِرِ وَٱلْمَلَٰٓئِكَةِ وَٱلْكِتَٰبِ وَٱلنَّبِيِّۦنَ وَءَاتَى ٱلْمَالَ عَلَىٰ حُبِّهِۦ ذَوِى ٱلْقُرْبَىٰ وَٱلْيَتَٰمَىٰ وَٱلْمَسَٰكِينَ وَٱبْنَ ٱلسَّبِيلِ وَٱلسَّآئِلِينَ وَفِى ٱلرِّقَابِ وَأَقَامَ ٱلصَّلَوٰةَ وَءَاتَى ٱلزَّكَوٰةَ وَٱلْمُوفُونَ بِعَهْدِهِمْ إِذَا عَٰهَدُوا۟ۖ وَٱلصَّٰبِرِينَ فِى ٱلْبَأْسَآءِ وَٱلضَّرَّآءِ وَحِينَ ٱلْبَأْسِۗ أُو۟لَٰٓئِكَ ٱلَّذِينَ صَدَقُوا۟ۖ وَأُو۟لَٰٓئِكَ هُمُ ٱلْمُتَّقُونَ ", "translation": "Righteousness is not that you turn your faces toward the east or the west, but [true] righteousness is [in] one who believes in Allāh, the Last Day, the angels, the Book, and the prophets and gives wealth, in spite of love for it, to relatives, orphans, the needy, the traveler, those who ask [for help], and for freeing slaves; [and who] establishes prayer and gives zakāh; [those who] fulfill their promise when they promise; and [those who] are patient in poverty and hardship and during battle. Those are the ones who have been true, and it is those who are the righteous.", "words": [{"id": 1, "arabic": "لَّيْسَ", "translit": "َsْyَّl", "root": "ليس"}, {"id": 2, "arabic": "ٱلْبِرَّ", "translit": "َّrِbْlٱ", "root": "برر"}, {"id": 3, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 4, "arabic": "تُوَلُّوا۟", "translit": "۟āwُّlَwُt", "root": "ولي"}, {"id": 5, "arabic": "وُجُوهَكُمْ", "translit": "ْmُkَhwُjgُw", "root": "وجه"}, {"id": 6, "arabic": "قِبَلَ", "translit": "َlَbِq", "root": "قبل"}, {"id": 7, "arabic": "ٱلْمَشْرِقِ", "translit": "ِqِrْhsَmْlٱ", "root": "شرق"}, {"id": 8, "arabic": "وَٱلْمَغْرِبِ", "translit": "ِbِrْغَmْlٱَw", "root": "غرب"}, {"id": 9, "arabic": "وَلَٰكِنَّ", "translit": "َّnِkَٰlَw", "root": ""}, {"id": 10, "arabic": "ٱلْبِرَّ", "translit": "َّrِbْlٱ", "root": "برر"}, {"id": 11, "arabic": "مَنْ", "translit": "ْnَm", "root": ""}, {"id": 12, "arabic": "ءَامَنَ", "translit": "َnَmāَء", "root": "امن"}, {"id": 13, "arabic": "بِٱللَّهِ", "translit": "ِhَّllٱِb", "root": "اله"}, {"id": 14, "arabic": "وَٱلْيَوْمِ", "translit": "ِmْwَyْlٱَw", "root": "يوم"}, {"id": 15, "arabic": "ٱلْءَاخِرِ", "translit": "ِrِhkāَءْlٱ", "root": "اخر"}, {"id": 16, "arabic": "وَٱلْمَلَٰٓئِكَةِ", "translit": "ِẗَkِyʾَٰٓlَmْlٱَw", "root": "ملك"}, {"id": 17, "arabic": "وَٱلْكِتَٰبِ", "translit": "ِbَٰtِkْlٱَw", "root": "كتب"}, {"id": 18, "arabic": "وَٱلنَّبِيِّۦنَ", "translit": "َnۦِّyِbَّnlٱَw", "root": "نبا"}, {"id": 19, "arabic": "وَءَاتَى", "translit": "àَtāَءَw", "root": "اتي"}, {"id": 20, "arabic": "ٱلْمَالَ", "translit": "َlāَmْlٱ", "root": "مول"}, {"id": 21, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 22, "arabic": "حُبِّهِۦ", "translit": "ۦِhِّbُḥ", "root": "حبب"}, {"id": 23, "arabic": "ذَوِى", "translit": "àِwَhd", "root": ""}, {"id": 24, "arabic": "ٱلْقُرْبَىٰ", "translit": "ٰàَbْrُqْlٱ", "root": "قرب"}, {"id": 25, "arabic": "وَٱلْيَتَٰمَىٰ", "translit": "ٰàَmَٰtَyْlٱَw", "root": "يتم"}, {"id": 26, "arabic": "وَٱلْمَسَٰكِينَ", "translit": "َnyِkَٰsَmْlٱَw", "root": "سكن"}, {"id": 27, "arabic": "وَٱبْنَ", "translit": "َnْbٱَw", "root": "بني"}, {"id": 28, "arabic": "ٱلسَّبِيلِ", "translit": "ِlyِbَّslٱ", "root": "سبل"}, {"id": 29, "arabic": "وَٱلسَّآئِلِينَ", "translit": "َnyِlِyʾٓāَّslٱَw", "root": "سال"}, {"id": 30, "arabic": "وَفِى", "translit": "àِfَw", "root": ""}, {"id": 31, "arabic": "ٱلرِّقَابِ", "translit": "ِbāَqِّrlٱ", "root": "رقب"}, {"id": 32, "arabic": "وَأَقَامَ", "translit": "َmāَqَaʾَw", "root": "قوم"}, {"id": 33, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 34, "arabic": "وَءَاتَى", "translit": "àَtāَءَw", "root": "اتي"}, {"id": 35, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 36, "arabic": "وَٱلْمُوفُونَ", "translit": "َnwُfwُmْlٱَw", "root": "وفي"}, {"id": 37, "arabic": "بِعَهْدِهِمْ", "translit": "ْmِhِdْhَʿعِb", "root": "عهد"}, {"id": 38, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 39, "arabic": "عَٰهَدُوا۟", "translit": "۟āwُdَhَٰʿع", "root": "عهد"}, {"id": 40, "arabic": "وَٱلصَّٰبِرِينَ", "translit": "َnyِrِbَّٰṣlٱَw", "root": "صبر"}, {"id": 41, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 42, "arabic": "ٱلْبَأْسَآءِ", "translit": "ِءٓāَsْaʾَbْlٱ", "root": "باس"}, {"id": 43, "arabic": "وَٱلضَّرَّآءِ", "translit": "ِءٓāَّrَّḍlٱَw", "root": "ضرر"}, {"id": 44, "arabic": "وَحِينَ", "translit": "َnyِḥَw", "root": "حين"}, {"id": 45, "arabic": "ٱلْبَأْسِ", "translit": "ِsْaʾَbْlٱ", "root": "باس"}, {"id": 46, "arabic": "أُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾ", "root": ""}, {"id": 47, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 48, "arabic": "صَدَقُوا۟", "translit": "۟āwُqَdَṣ", "root": "صدق"}, {"id": 49, "arabic": "وَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَw", "root": ""}, {"id": 50, "arabic": "هُمُ", "translit": "ُmُh", "root": ""}, {"id": 51, "arabic": "ٱلْمُتَّقُونَ", "translit": "َnwُqَّtُmْlٱ", "root": "وقي"}], "hasIhya": true}, {"ayah": 178, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ كُتِبَ عَلَيْكُمُ ٱلْقِصَاصُ فِى ٱلْقَتْلَىۖ ٱلْحُرُّ بِٱلْحُرِّ وَٱلْعَبْدُ بِٱلْعَبْدِ وَٱلْأُنثَىٰ بِٱلْأُنثَىٰۚ فَمَنْ عُفِىَ لَهُۥ مِنْ أَخِيهِ شَىْءٌ فَٱتِّبَاعٌۢ بِٱلْمَعْرُوفِ وَأَدَآءٌ إِلَيْهِ بِإِحْسَٰنٍۗ ذَٰلِكَ تَخْفِيفٌ مِّن رَّبِّكُمْ وَرَحْمَةٌۗ فَمَنِ ٱعْتَدَىٰ بَعْدَ ذَٰلِكَ فَلَهُۥ عَذَابٌ أَلِيمٌ ", "translation": "O you who have believed, prescribed for you is legal retribution for those murdered - the free for the free, the slave for the slave, and the female for the female.[1] But whoever overlooks from his brother [i.e., the killer] anything,[2] then there should be a suitable follow-up and payment to him [i.e., the deceased's heir or legal representative] with good conduct. This is an alleviation from your Lord and a mercy. But whoever transgresses after that[3] will have a painful punishment.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 5, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلْقِصَاصُ", "translit": "ُṣāَṣِqْlٱ", "root": "قصص"}, {"id": 7, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 8, "arabic": "ٱلْقَتْلَى", "translit": "àَlْtَqْlٱ", "root": "قتل"}, {"id": 9, "arabic": "ٱلْحُرُّ", "translit": "ُّrُḥْlٱ", "root": "حرر"}, {"id": 10, "arabic": "بِٱلْحُرِّ", "translit": "ِّrُḥْlٱِb", "root": "حرر"}, {"id": 11, "arabic": "وَٱلْعَبْدُ", "translit": "ُdْbَʿعْlٱَw", "root": "عبد"}, {"id": 12, "arabic": "بِٱلْعَبْدِ", "translit": "ِdْbَʿعْlٱِb", "root": "عبد"}, {"id": 13, "arabic": "وَٱلْأُنثَىٰ", "translit": "ٰàَhtnُaʾْlٱَw", "root": "انث"}, {"id": 14, "arabic": "بِٱلْأُنثَىٰ", "translit": "ٰàَhtnُaʾْlٱِb", "root": "انث"}, {"id": 15, "arabic": "فَمَنْ", "translit": "ْnَmَf", "root": ""}, {"id": 16, "arabic": "عُفِىَ", "translit": "َàِfُʿع", "root": "عفو"}, {"id": 17, "arabic": "لَهُۥ", "translit": "ۥُhَl", "root": ""}, {"id": 18, "arabic": "مِنْ", "translit": "ْnِm", "root": ""}, {"id": 19, "arabic": "أَخِيهِ", "translit": "ِhyِhkَaʾ", "root": "اخو"}, {"id": 20, "arabic": "شَىْءٌ", "translit": "ٌءْàَhs", "root": "شيا"}, {"id": 21, "arabic": "فَٱتِّبَاعٌۢ", "translit": "ٌۢʿعāَbِّtٱَf", "root": "تبع"}, {"id": 22, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 23, "arabic": "وَأَدَآءٌ", "translit": "ٌءٓāَdَaʾَw", "root": "ادي"}, {"id": 24, "arabic": "إِلَيْهِ", "translit": "ِhْyَlِiʾ", "root": ""}, {"id": 25, "arabic": "بِإِحْسَٰنٍ", "translit": "ٍnَٰsْḥِiʾِb", "root": "حسن"}, {"id": 26, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 27, "arabic": "تَخْفِيفٌ", "translit": "ٌfyِfْhkَt", "root": "خفف"}, {"id": 28, "arabic": "مِّن", "translit": "nِّm", "root": ""}, {"id": 29, "arabic": "رَّبِّكُمْ", "translit": "ْmُkِّbَّr", "root": "ربب"}, {"id": 30, "arabic": "وَرَحْمَةٌ", "translit": "ٌẗَmْḥَrَw", "root": "رحم"}, {"id": 31, "arabic": "فَمَنِ", "translit": "ِnَmَf", "root": ""}, {"id": 32, "arabic": "ٱعْتَدَىٰ", "translit": "ٰàَdَtْʿعٱ", "root": "عدو"}, {"id": 33, "arabic": "بَعْدَ", "translit": "َdْʿعَb", "root": "بعد"}, {"id": 34, "arabic": "ذَٰلِكَ", "translit": "َkِlَٰhd", "root": ""}, {"id": 35, "arabic": "فَلَهُۥ", "translit": "ۥُhَlَf", "root": ""}, {"id": 36, "arabic": "عَذَابٌ", "translit": "ٌbāَhdَʿع", "root": "عذب"}, {"id": 37, "arabic": "أَلِيمٌ", "translit": "ٌmyِlَaʾ", "root": "الم"}], "hasIhya": true}, {"ayah": 179, "text": "وَلَكُمْ فِى ٱلْقِصَاصِ حَيَوٰةٌ يَٰٓأُو۟لِى ٱلْأَلْبَٰبِ لَعَلَّكُمْ تَتَّقُونَ ", "translation": "And there is for you in legal retribution [saving of] life, O you [people] of understanding, that you may become righteous.[1]", "words": [{"id": 1, "arabic": "وَلَكُمْ", "translit": "ْmُkَlَw", "root": ""}, {"id": 2, "arabic": "فِى", "translit": "àِf", "root": ""}, {"id": 3, "arabic": "ٱلْقِصَاصِ", "translit": "ِṣāَṣِqْlٱ", "root": "قصص"}, {"id": 4, "arabic": "حَيَوٰةٌ", "translit": "ٌẗٰwَyَḥ", "root": "حيي"}, {"id": 5, "arabic": "يَٰٓأُو۟لِى", "translit": "àِl۟wُaʾَٰٓy", "root": ""}, {"id": 6, "arabic": "ٱلْأَلْبَٰبِ", "translit": "ِbَٰbْlَaʾْlٱ", "root": "لبب"}, {"id": 7, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 8, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": false}, {"ayah": 180, "text": "كُتِبَ عَلَيْكُمْ إِذَا حَضَرَ أَحَدَكُمُ ٱلْمَوْتُ إِن تَرَكَ خَيْرًا ٱلْوَصِيَّةُ لِلْوَٰلِدَيْنِ وَٱلْأَقْرَبِينَ بِٱلْمَعْرُوفِۖ حَقًّا عَلَى ٱلْمُتَّقِينَ ", "translation": "Prescribed for you when death approaches [any] one of you if he leaves wealth [is that he should make] a bequest for the parents and near relatives according to what is acceptable - a duty upon the righteous.[1]", "words": [{"id": 1, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 2, "arabic": "عَلَيْكُمْ", "translit": "ْmُkْyَlَʿع", "root": ""}, {"id": 3, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 4, "arabic": "حَضَرَ", "translit": "َrَḍَḥ", "root": "حضر"}, {"id": 5, "arabic": "أَحَدَكُمُ", "translit": "ُmُkَdَḥَaʾ", "root": "احد"}, {"id": 6, "arabic": "ٱلْمَوْتُ", "translit": "ُtْwَmْlٱ", "root": "موت"}, {"id": 7, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 8, "arabic": "تَرَكَ", "translit": "َkَrَt", "root": "ترك"}, {"id": 9, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 10, "arabic": "ٱلْوَصِيَّةُ", "translit": "ُẗَّyِṣَwْlٱ", "root": "وصي"}, {"id": 11, "arabic": "لِلْوَٰلِدَيْنِ", "translit": "ِnْyَdِlَٰwْlِl", "root": "ولد"}, {"id": 12, "arabic": "وَٱلْأَقْرَبِينَ", "translit": "َnyِbَrْqَaʾْlٱَw", "root": "قرب"}, {"id": 13, "arabic": "بِٱلْمَعْرُوفِ", "translit": "ِfwُrْʿعَmْlٱِb", "root": "عرف"}, {"id": 14, "arabic": "حَقًّا", "translit": "āًّqَḥ", "root": "حقق"}, {"id": 15, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 16, "arabic": "ٱلْمُتَّقِينَ", "translit": "َnyِqَّtُmْlٱ", "root": "وقي"}], "hasIhya": false}, {"ayah": 181, "text": "فَمَنۢ بَدَّلَهُۥ بَعْدَمَا سَمِعَهُۥ فَإِنَّمَآ إِثْمُهُۥ عَلَى ٱلَّذِينَ يُبَدِّلُونَهُۥٓۚ إِنَّ ٱللَّهَ سَمِيعٌ عَلِيمٌ ", "translation": "Then whoever alters it [i.e., the bequest] after he has heard it - the sin is only upon those who have altered it. Indeed, Allāh is Hearing and Knowing.", "words": [{"id": 1, "arabic": "فَمَنۢ", "translit": "ۢnَmَf", "root": ""}, {"id": 2, "arabic": "بَدَّلَهُۥ", "translit": "ۥُhَlَّdَb", "root": "بدل"}, {"id": 3, "arabic": "بَعْدَمَا", "translit": "āَmَdْʿعَb", "root": "بعد"}, {"id": 4, "arabic": "سَمِعَهُۥ", "translit": "ۥُhَʿعِmَs", "root": "سمع"}, {"id": 5, "arabic": "فَإِنَّمَآ", "translit": "ٓāَmَّnِiʾَf", "root": ""}, {"id": 6, "arabic": "إِثْمُهُۥ", "translit": "ۥُhُmْhtِiʾ", "root": "اثم"}, {"id": 7, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 8, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 9, "arabic": "يُبَدِّلُونَهُۥٓ", "translit": "ٓۥُhَnwُlِّdَbُy", "root": "بدل"}, {"id": 10, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 11, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 12, "arabic": "سَمِيعٌ", "translit": "ٌʿعyِmَs", "root": "سمع"}, {"id": 13, "arabic": "عَلِيمٌ", "translit": "ٌmyِlَʿع", "root": "علم"}], "hasIhya": false}, {"ayah": 182, "text": "فَمَنْ خَافَ مِن مُّوصٍ جَنَفًا أَوْ إِثْمًا فَأَصْلَحَ بَيْنَهُمْ فَلَآ إِثْمَ عَلَيْهِۚ إِنَّ ٱللَّهَ غَفُورٌ رَّحِيمٌ ", "translation": "But if one fears from the bequeather [some] error or sin and corrects that which is between them [i.e., the concerned parties], there is no sin upon him. Indeed, Allāh is Forgiving and Merciful.", "words": [{"id": 1, "arabic": "فَمَنْ", "translit": "ْnَmَf", "root": ""}, {"id": 2, "arabic": "خَافَ", "translit": "َfāَhk", "root": "خوف"}, {"id": 3, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 4, "arabic": "مُّوصٍ", "translit": "ٍṣwُّm", "root": "وصي"}, {"id": 5, "arabic": "جَنَفًا", "translit": "āًfَnَjg", "root": "جنف"}, {"id": 6, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 7, "arabic": "إِثْمًا", "translit": "āًmْhtِiʾ", "root": "اثم"}, {"id": 8, "arabic": "فَأَصْلَحَ", "translit": "َḥَlْṣَaʾَf", "root": "صلح"}, {"id": 9, "arabic": "بَيْنَهُمْ", "translit": "ْmُhَnْyَb", "root": "بين"}, {"id": 10, "arabic": "فَلَآ", "translit": "ٓāَlَf", "root": ""}, {"id": 11, "arabic": "إِثْمَ", "translit": "َmْhtِiʾ", "root": "اثم"}, {"id": 12, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 13, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 14, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 15, "arabic": "غَفُورٌ", "translit": "ٌrwُfَغ", "root": "غفر"}, {"id": 16, "arabic": "رَّحِيمٌ", "translit": "ٌmyِḥَّr", "root": "رحم"}], "hasIhya": false}, {"ayah": 183, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ كُتِبَ عَلَيْكُمُ ٱلصِّيَامُ كَمَا كُتِبَ عَلَى ٱلَّذِينَ مِن قَبْلِكُمْ لَعَلَّكُمْ تَتَّقُونَ ", "translation": "O you who have believed, decreed upon you is fasting as it was decreed upon those before you that you may become righteous -", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 5, "arabic": "عَلَيْكُمُ", "translit": "ُmُkْyَlَʿع", "root": ""}, {"id": 6, "arabic": "ٱلصِّيَامُ", "translit": "ُmāَyِّṣlٱ", "root": "صوم"}, {"id": 7, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 8, "arabic": "كُتِبَ", "translit": "َbِtُk", "root": "كتب"}, {"id": 9, "arabic": "عَلَى", "translit": "àَlَʿع", "root": ""}, {"id": 10, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 11, "arabic": "مِن", "translit": "nِm", "root": ""}, {"id": 12, "arabic": "قَبْلِكُمْ", "translit": "ْmُkِlْbَq", "root": "قبل"}, {"id": 13, "arabic": "لَعَلَّكُمْ", "translit": "ْmُkَّlَʿعَl", "root": ""}, {"id": 14, "arabic": "تَتَّقُونَ", "translit": "َnwُqَّtَt", "root": "وقي"}], "hasIhya": true}, {"ayah": 184, "text": "أَيَّامًا مَّعْدُودَٰتٍۚ فَمَن كَانَ مِنكُم مَّرِيضًا أَوْ عَلَىٰ سَفَرٍ فَعِدَّةٌ مِّنْ أَيَّامٍ أُخَرَۚ وَعَلَى ٱلَّذِينَ يُطِيقُونَهُۥ فِدْيَةٌ طَعَامُ مِسْكِينٍۖ فَمَن تَطَوَّعَ خَيْرًا فَهُوَ خَيْرٌ لَّهُۥۚ وَأَن تَصُومُوا۟ خَيْرٌ لَّكُمْۖ إِن كُنتُمْ تَعْلَمُونَ ", "translation": "[Fasting for] a limited number of days. So whoever among you is ill or on a journey [during them] - then an equal number of other days [are to be made up]. And upon those who are able [to fast, but with hardship] - a ransom [as substitute] of feeding a poor person [each day]. And whoever volunteers good [i.e., excess] - it is better for him. But to fast is best for you, if you only knew.", "words": [{"id": 1, "arabic": "أَيَّامًا", "translit": "āًmāَّyَaʾ", "root": "يوم"}, {"id": 2, "arabic": "مَّعْدُودَٰتٍ", "translit": "ٍtَٰdwُdْʿعَّm", "root": "عدد"}, {"id": 3, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 4, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 5, "arabic": "مِنكُم", "translit": "mُknِm", "root": ""}, {"id": 6, "arabic": "مَّرِيضًا", "translit": "āًḍyِrَّm", "root": "مرض"}, {"id": 7, "arabic": "أَوْ", "translit": "ْwَaʾ", "root": ""}, {"id": 8, "arabic": "عَلَىٰ", "translit": "ٰàَlَʿع", "root": ""}, {"id": 9, "arabic": "سَفَرٍ", "translit": "ٍrَfَs", "root": "سفر"}, {"id": 10, "arabic": "فَعِدَّةٌ", "translit": "ٌẗَّdِʿعَf", "root": "عدد"}, {"id": 11, "arabic": "مِّنْ", "translit": "ْnِّm", "root": ""}, {"id": 12, "arabic": "أَيَّامٍ", "translit": "ٍmāَّyَaʾ", "root": "يوم"}, {"id": 13, "arabic": "أُخَرَ", "translit": "َrَhkُaʾ", "root": "اخر"}, {"id": 14, "arabic": "وَعَلَى", "translit": "àَlَʿعَw", "root": ""}, {"id": 15, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 16, "arabic": "يُطِيقُونَهُۥ", "translit": "ۥُhَnwُqyِṭُy", "root": "طوق"}, {"id": 17, "arabic": "فِدْيَةٌ", "translit": "ٌẗَyْdِf", "root": "فدي"}, {"id": 18, "arabic": "طَعَامُ", "translit": "ُmāَʿعَṭ", "root": "طعم"}, {"id": 19, "arabic": "مِسْكِينٍ", "translit": "ٍnyِkْsِm", "root": "سكن"}, {"id": 20, "arabic": "فَمَن", "translit": "nَmَf", "root": ""}, {"id": 21, "arabic": "تَطَوَّعَ", "translit": "َʿعَّwَṭَt", "root": "طوع"}, {"id": 22, "arabic": "خَيْرًا", "translit": "āًrْyَhk", "root": "خير"}, {"id": 23, "arabic": "فَهُوَ", "translit": "َwُhَf", "root": ""}, {"id": 24, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 25, "arabic": "لَّهُۥ", "translit": "ۥُhَّl", "root": ""}, {"id": 26, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 27, "arabic": "تَصُومُوا۟", "translit": "۟āwُmwُṣَt", "root": "صوم"}, {"id": 28, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 29, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 30, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 31, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 32, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 185, "text": "شَهْرُ رَمَضَانَ ٱلَّذِىٓ أُنزِلَ فِيهِ ٱلْقُرْءَانُ هُدًى لِّلنَّاسِ وَبَيِّنَٰتٍ مِّنَ ٱلْهُدَىٰ وَٱلْفُرْقَانِۚ فَمَن شَهِدَ مِنكُمُ ٱلشَّهْرَ فَلْيَصُمْهُۖ وَمَن كَانَ مَرِيضًا أَوْ عَلَىٰ سَفَرٍ فَعِدَّةٌ مِّنْ أَيَّامٍ أُخَرَۗ يُرِيدُ ٱللَّهُ بِكُمُ ٱلْيُسْرَ وَلَا يُرِيدُ بِكُمُ ٱلْعُسْرَ وَلِتُكْمِلُوا۟ ٱلْعِدَّةَ وَلِتُكَبِّرُوا۟ ٱللَّهَ عَلَىٰ مَا هَدَىٰكُمْ وَلَعَلَّكُمْ تَشْكُرُونَ ", "translation": "The month of Ramaḍān [is that] in which was revealed the Qur’ān, a guidance for the people and clear proofs of guidance and criterion. So whoever sights [the crescent of] the month,[1] let him fast it; and whoever is ill or on a journey - then an equal number of other days. Allāh intends for you ease and does not intend for you hardship and [wants] for you to complete the period and to glorify Allāh for that [to] which He has guided you; and perhaps you will be grateful.", "words": [{"id": 1, "arabic": "شَهْرُ", "translit": "ُrْhَhs", "root": "شهر"}, {"id": 2, "arabic": "رَمَضَانَ", "translit": "َnāَḍَmَr", "root": "رمض"}, {"id": 3, "arabic": "ٱلَّذِىٓ", "translit": "ٓàِhdَّlٱ", "root": ""}, {"id": 4, "arabic": "أُنزِلَ", "translit": "َlِznُaʾ", "root": "نزل"}, {"id": 5, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 6, "arabic": "ٱلْقُرْءَانُ", "translit": "ُnāَءْrُqْlٱ", "root": "قرا"}, {"id": 7, "arabic": "هُدًى", "translit": "àًdُh", "root": "هدي"}, {"id": 