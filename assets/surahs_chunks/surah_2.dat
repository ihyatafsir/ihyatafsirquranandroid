}, {"id": 37, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 38, "arabic": "وَمَنْ", "translit": "ْnَmَw", "root": ""}, {"id": 39, "arabic": "عَادَ", "translit": "َdāَʿع", "root": "عود"}, {"id": 40, "arabic": "فَأُو۟لَٰٓئِكَ", "translit": "َkِyʾَٰٓl۟wُaʾَf", "root": ""}, {"id": 41, "arabic": "أَصْحَٰبُ", "translit": "ُbَٰḥْṣَaʾ", "root": "صحب"}, {"id": 42, "arabic": "ٱلنَّارِ", "translit": "ِrāَّnlٱ", "root": "نور"}, {"id": 43, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 44, "arabic": "فِيهَا", "translit": "āَhyِf", "root": ""}, {"id": 45, "arabic": "خَٰلِدُونَ", "translit": "َnwُdِlَٰhk", "root": "خلد"}], "hasIhya": true}, {"ayah": 276, "text": "يَمْحَقُ ٱللَّهُ ٱلرِّبَوٰا۟ وَيُرْبِى ٱلصَّدَقَٰتِۗ وَٱللَّهُ لَا يُحِبُّ كُلَّ كَفَّارٍ أَثِيمٍ ", "translation": "Allāh destroys interest and gives increase for charities. And Allāh does not like every sinning disbeliever.", "words": [{"id": 1, "arabic": "يَمْحَقُ", "translit": "ُqَḥْmَy", "root": "محق"}, {"id": 2, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 3, "arabic": "ٱلرِّبَوٰا۟", "translit": "۟āٰwَbِّrlٱ", "root": "ربو"}, {"id": 4, "arabic": "وَيُرْبِى", "translit": "àِbْrُyَw", "root": "ربو"}, {"id": 5, "arabic": "ٱلصَّدَقَٰتِ", "translit": "ِtَٰqَdَّṣlٱ", "root": "صدق"}, {"id": 6, "arabic": "وَٱللَّهُ", "translit": "ُhَّllٱَw", "root": "اله"}, {"id": 7, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 8, "arabic": "يُحِبُّ", "translit": "ُّbِḥُy", "root": "حبب"}, {"id": 9, "arabic": "كُلَّ", "translit": "َّlُk", "root": "كلل"}, {"id": 10, "arabic": "كَفَّارٍ", "translit": "ٍrāَّfَk", "root": "كفر"}, {"id": 11, "arabic": "أَثِيمٍ", "translit": "ٍmyِhtَaʾ", "root": "اثم"}], "hasIhya": false}, {"ayah": 277, "text": "إِنَّ ٱلَّذِينَ ءَامَنُوا۟ وَعَمِلُوا۟ ٱلصَّٰلِحَٰتِ وَأَقَامُوا۟ ٱلصَّلَوٰةَ وَءَاتَوُا۟ ٱلزَّكَوٰةَ لَهُمْ أَجْرُهُمْ عِندَ رَبِّهِمْ وَلَا خَوْفٌ عَلَيْهِمْ وَلَا هُمْ يَحْزَنُونَ ", "translation": "Indeed, those who believe and do righteous deeds and establish prayer and give zakāh will have their reward with their Lord, and there will be no fear concerning them, nor will they grieve.", "words": [{"id": 1, "arabic": "إِنَّ", "translit": "َّnِiʾ", "root": ""}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "وَعَمِلُوا۟", "translit": "۟āwُlِmَʿعَw", "root": "عمل"}, {"id": 5, "arabic": "ٱلصَّٰلِحَٰتِ", "translit": "ِtَٰḥِlَّٰṣlٱ", "root": "صلح"}, {"id": 6, "arabic": "وَأَقَامُوا۟", "translit": "۟āwُmāَqَaʾَw", "root": "قوم"}, {"id": 7, "arabic": "ٱلصَّلَوٰةَ", "translit": "َẗٰwَlَّṣlٱ", "root": "صلو"}, {"id": 8, "arabic": "وَءَاتَوُا۟", "translit": "۟āُwَtāَءَw", "root": "اتي"}, {"id": 9, "arabic": "ٱلزَّكَوٰةَ", "translit": "َẗٰwَkَّzlٱ", "root": "زكو"}, {"id": 10, "arabic": "لَهُمْ", "translit": "ْmُhَl", "root": ""}, {"id": 11, "arabic": "أَجْرُهُمْ", "translit": "ْmُhُrْjgَaʾ", "root": "اجر"}, {"id": 12, "arabic": "عِندَ", "translit": "َdnِʿع", "root": "عند"}, {"id": 13, "arabic": "رَبِّهِمْ", "translit": "ْmِhِّbَr", "root": "ربب"}, {"id": 14, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 15, "arabic": "خَوْفٌ", "translit": "ٌfْwَhk", "root": "خوف"}, {"id": 16, "arabic": "عَلَيْهِمْ", "translit": "ْmِhْyَlَʿع", "root": ""}, {"id": 17, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 18, "arabic": "هُمْ", "translit": "ْmُh", "root": ""}, {"id": 19, "arabic": "يَحْزَنُونَ", "translit": "َnwُnَzْḥَy", "root": "حزن"}], "hasIhya": true}, {"ayah": 278, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوا۟ ٱتَّقُوا۟ ٱللَّهَ وَذَرُوا۟ مَا بَقِىَ مِنَ ٱلرِّبَوٰٓا۟ إِن كُنتُم مُّؤْمِنِينَ ", "translation": "O you who have believed, fear Allāh and give up what remains [due to you] of interest, if you should be believers.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوا۟", "translit": "۟āwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "ٱتَّقُوا۟", "translit": "۟āwُqَّtٱ", "root": "وقي"}, {"id": 5, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 6, "arabic": "وَذَرُوا۟", "translit": "۟āwُrَhdَw", "root": "وذر"}, {"id": 7, "arabic": "مَا", "translit": "āَm", "root": ""}, {"id": 8, "arabic": "بَقِىَ", "translit": "َàِqَb", "root": "بقي"}, {"id": 9, "arabic": "مِنَ", "translit": "َnِm", "root": ""}, {"id": 10, "arabic": "ٱلرِّبَوٰٓا۟", "translit": "۟āٰٓwَbِّrlٱ", "root": "ربو"}, {"id": 11, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 12, "arabic": "كُنتُم", "translit": "mُtnُk", "root": "كون"}, {"id": 13, "arabic": "مُّؤْمِنِينَ", "translit": "َnyِnِmْwʾُّm", "root": "امن"}], "hasIhya": true}, {"ayah": 279, "text": "فَإِن لَّمْ تَفْعَلُوا۟ فَأْذَنُوا۟ بِحَرْبٍ مِّنَ ٱللَّهِ وَرَسُولِهِۦۖ وَإِن تُبْتُمْ فَلَكُمْ رُءُوسُ أَمْوَٰلِكُمْ لَا تَظْلِمُونَ وَلَا تُظْلَمُونَ ", "translation": "And if you do not, then be informed of a war [against you] from Allāh and His Messenger. But if you repent, you may have your principal - [thus] you do no wrong, nor are you wronged.", "words": [{"id": 1, "arabic": "فَإِن", "translit": "nِiʾَf", "root": ""}, {"id": 2, "arabic": "لَّمْ", "translit": "ْmَّl", "root": ""}, {"id": 3, "arabic": "تَفْعَلُوا۟", "translit": "۟āwُlَʿعْfَt", "root": "فعل"}, {"id": 4, "arabic": "فَأْذَنُوا۟", "translit": "۟āwُnَhdْaʾَf", "root": "اذن"}, {"id": 5, "arabic": "بِحَرْبٍ", "translit": "ٍbْrَḥِb", "root": "حرب"}, {"id": 6, "arabic": "مِّنَ", "translit": "َnِّm", "root": ""}, {"id": 7, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 8, "arabic": "وَرَسُولِهِۦ", "translit": "ۦِhِlwُsَrَw", "root": "رسل"}, {"id": 9, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 10, "arabic": "تُبْتُمْ", "translit": "ْmُtْbُt", "root": "توب"}, {"id": 11, "arabic": "فَلَكُمْ", "translit": "ْmُkَlَf", "root": ""}, {"id": 12, "arabic": "رُءُوسُ", "translit": "ُswُءُr", "root": "راس"}, {"id": 13, "arabic": "أَمْوَٰلِكُمْ", "translit": "ْmُkِlَٰwْmَaʾ", "root": "مول"}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "تَظْلِمُونَ", "translit": "َnwُmِlْẓَt", "root": "ظلم"}, {"id": 16, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 17, "arabic": "تُظْلَمُونَ", "translit": "َnwُmَlْẓُt", "root": "ظلم"}], "hasIhya": true}, {"ayah": 280, "text": "وَإِن كَانَ ذُو عُسْرَةٍ فَنَظِرَةٌ إِلَىٰ مَيْسَرَةٍۚ وَأَن تَصَدَّقُوا۟ خَيْرٌ لَّكُمْۖ إِن كُنتُمْ تَعْلَمُونَ ", "translation": "And if someone is in hardship, then [let there be] postponement until [a time of] ease. But if you give [from your right as] charity, then it is better for you, if you only knew.", "words": [{"id": 1, "arabic": "وَإِن", "translit": "nِiʾَw", "root": ""}, {"id": 2, "arabic": "كَانَ", "translit": "َnāَk", "root": "كون"}, {"id": 3, "arabic": "ذُو", "translit": "wُhd", "root": ""}, {"id": 4, "arabic": "عُسْرَةٍ", "translit": "ٍẗَrْsُʿع", "root": "عسر"}, {"id": 5, "arabic": "فَنَظِرَةٌ", "translit": "ٌẗَrِẓَnَf", "root": "نظر"}, {"id": 6, "arabic": "إِلَىٰ", "translit": "ٰàَlِiʾ", "root": ""}, {"id": 7, "arabic": "مَيْسَرَةٍ", "translit": "ٍẗَrَsْyَm", "root": "يسر"}, {"id": 8, "arabic": "وَأَن", "translit": "nَaʾَw", "root": ""}, {"id": 9, "arabic": "تَصَدَّقُوا۟", "translit": "۟āwُqَّdَṣَt", "root": "صدق"}, {"id": 10, "arabic": "خَيْرٌ", "translit": "ٌrْyَhk", "root": "خير"}, {"id": 11, "arabic": "لَّكُمْ", "translit": "ْmُkَّl", "root": ""}, {"id": 12, "arabic": "إِن", "translit": "nِiʾ", "root": ""}, {"id": 13, "arabic": "كُنتُمْ", "translit": "ْmُtnُk", "root": "كون"}, {"id": 14, "arabic": "تَعْلَمُونَ", "translit": "َnwُmَlْʿعَt", "root": "علم"}], "hasIhya": false}, {"ayah": 281, "text": "وَٱتَّقُوا۟ يَوْمًا تُرْجَعُونَ فِيهِ إِلَى ٱللَّهِۖ ثُمَّ تُوَفَّىٰ كُلُّ نَفْسٍ مَّا كَسَبَتْ وَهُمْ لَا يُظْلَمُونَ ", "translation": "And fear a Day when you will be returned to Allāh. Then every soul will be compensated for what it earned, and they will not be wronged [i.e., treated unjustly].", "words": [{"id": 1, "arabic": "وَٱتَّقُوا۟", "translit": "۟āwُqَّtٱَw", "root": "وقي"}, {"id": 2, "arabic": "يَوْمًا", "translit": "āًmْwَy", "root": "يوم"}, {"id": 3, "arabic": "تُرْجَعُونَ", "translit": "َnwُʿعَjgْrُt", "root": "رجع"}, {"id": 4, "arabic": "فِيهِ", "translit": "ِhyِf", "root": ""}, {"id": 5, "arabic": "إِلَى", "translit": "àَlِiʾ", "root": ""}, {"id": 6, "arabic": "ٱللَّهِ", "translit": "ِhَّllٱ", "root": "اله"}, {"id": 7, "arabic": "ثُمَّ", "translit": "َّmُht", "root": ""}, {"id": 8, "arabic": "تُوَفَّىٰ", "translit": "ٰàَّfَwُt", "root": "وفي"}, {"id": 9, "arabic": "كُلُّ", "translit": "ُّlُk", "root": "كلل"}, {"id": 10, "arabic": "نَفْسٍ", "translit": "ٍsْfَn", "root": "نفس"}, {"id": 11, "arabic": "مَّا", "translit": "āَّm", "root": ""}, {"id": 12, "arabic": "كَسَبَتْ", "translit": "ْtَbَsَk", "root": "كسب"}, {"id": 13, "arabic": "وَهُمْ", "translit": "ْmُhَw", "root": ""}, {"id": 14, "arabic": "لَا", "translit": "āَl", "root": ""}, {"id": 15, "arabic": "يُظْلَمُونَ", "translit": "َnwُmَlْẓُy", "root": "ظلم"}], "hasIhya": true}, {"ayah": 282, "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓا۟ إِذَا تَدَايَنتُم بِدَيْنٍ إِلَىٰٓ أَجَلٍ مُّسَمًّى فَٱكْتُبُوهُۚ وَلْيَكْتُب بَّيْنَكُمْ كَاتِبٌۢ بِٱلْعَدْلِۚ وَلَا يَأْبَ كَاتِبٌ أَن يَكْتُبَ كَمَا عَلَّمَهُ ٱللَّهُۚ فَلْيَكْتُبْ وَلْيُمْلِلِ ٱلَّذِى عَلَيْهِ ٱلْحَقُّ وَلْيَتَّقِ ٱللَّهَ رَبَّهُۥ وَلَا يَبْخَسْ مِنْهُ شَيْـًٔاۚ فَإِن كَانَ ٱلَّذِى عَلَيْهِ ٱلْحَقُّ سَفِيهًا أَوْ ضَعِيفًا أَوْ لَا يَسْتَطِيعُ أَن يُمِلَّ هُوَ فَلْيُمْلِلْ وَلِيُّهُۥ بِٱلْعَدْلِۚ وَٱسْتَشْهِدُوا۟ شَهِيدَيْنِ مِن رِّجَالِكُمْۖ فَإِن لَّمْ يَكُونَا رَجُلَيْنِ فَرَجُلٌ وَٱمْرَأَتَانِ مِمَّن تَرْضَوْنَ مِنَ ٱلشُّهَدَآءِ أَن تَضِلَّ إِحْدَىٰهُمَا فَتُذَكِّرَ إِحْدَىٰهُمَا ٱلْأُخْرَىٰۚ وَلَا يَأْبَ ٱلشُّهَدَآءُ إِذَا مَا دُعُوا۟ۚ وَلَا تَسْـَٔمُوٓا۟ أَن تَكْتُبُوهُ صَغِيرًا أَوْ كَبِيرًا إِلَىٰٓ أَجَلِهِۦۚ ذَٰلِكُمْ أَقْسَطُ عِندَ ٱللَّهِ وَأَقْوَمُ لِلشَّهَٰدَةِ وَأَدْنَىٰٓ أَلَّا تَرْتَابُوٓا۟ۖ إِلَّآ أَن تَكُونَ تِجَٰرَةً حَاضِرَةً تُدِيرُونَهَا بَيْنَكُمْ فَلَيْسَ عَلَيْكُمْ جُنَاحٌ أَلَّا تَكْتُبُوهَاۗ وَأَشْهِدُوٓا۟ إِذَا تَبَايَعْتُمْۚ وَلَا يُضَآرَّ كَاتِبٌ وَلَا شَهِيدٌۚ وَإِن تَفْعَلُوا۟ فَإِنَّهُۥ فُسُوقٌۢ بِكُمْۗ وَٱتَّقُوا۟ ٱللَّهَۖ وَيُعَلِّمُكُمُ ٱللَّهُۗ وَٱللَّهُ بِكُلِّ شَىْءٍ عَلِيمٌ ", "translation": "O you who have believed, when you contract a debt for a specified term, write it down. And let a scribe write [it] between you in justice. Let no scribe refuse to write as Allāh has taught him. So let him write and let the one who has the obligation [i.e., the debtor] dictate. And let him fear Allāh, his Lord, and not leave anything out of it. But if the one who has the obligation is of limited understanding or weak or unable to dictate himself, then let his guardian dictate in justice. And bring to witness two witnesses from among your men. And if there are not two men [available], then a man and two women from those whom you accept as witnesses - so that if one of them [i.e., the women] errs, then the other can remind her. And let not the witnesses refuse when they are called upon. And do not be [too] weary to write it, whether it is small or large, for its [specified] term. That is more just in the sight of Allāh and stronger as evidence and more likely to prevent doubt between you, except when it is an immediate transaction which you conduct among yourselves. For [then] there is no blame upon you if you do not write it. And take witnesses when you conclude a contract. Let no scribe be harmed or any witness. For if you do so, indeed, it is [grave] disobedience in you. And fear Allāh. And Allāh teaches you. And Allāh is Knowing of all things.", "words": [{"id": 1, "arabic": "يَٰٓأَيُّهَا", "translit": "āَhُّyَaʾَٰٓy", "root": "ايي"}, {"id": 2, "arabic": "ٱلَّذِينَ", "translit": "َnyِhdَّlٱ", "root": ""}, {"id": 3, "arabic": "ءَامَنُوٓا۟", "translit": "۟āٓwُnَmāَء", "root": "امن"}, {"id": 4, "arabic": "إِذَا", "translit": "āَhdِiʾ", "root": ""}, {"id": 5, "arabic": "تَدَايَنتُم", "translit": "mُtnَyāَdَt", "root": "دين"}, {"id": 6, "arabic": "بِدَيْنٍ", "translit": "ٍnْyَdِb", "root": "دين"}, {"id": 7, "arabic": "إِلَىٰٓ", "translit": "ٰٓàَlِiʾ", "root": ""}, {"id": 8, "arabic": "أَجَلٍ", "translit": "ٍlَjgَaʾ", "root": "اجل"}, {"id": 9, "arabic": "مُّسَمًّى", "translit": "àًّmَsُّm", "root": "سمو"}, {"id": 10, "arabic": "فَٱكْتُبُوهُ", "translit": "ُhwُbُtْkٱَf", "root": "كتب"}, {"id": 11, "arabic": "وَلْيَكْتُب", "translit": "bُtْkَyْlَw", "root": "كتب"}, {"id": 12, "arabic": "بَّيْنَكُمْ", "translit": "ْmُkَnْyَّb", "root": "بين"}, {"id": 13, "arabic": "كَاتِبٌۢ", "translit": "ٌۢbِtāَk", "root": "كتب"}, {"id": 14, "arabic": "بِٱلْعَدْلِ", "translit": "ِlْdَʿعْlٱِb", "root": "عدل"}, {"id": 15, "arabic": "وَلَا", "translit": "āَlَw", "root": ""}, {"id": 16, "arabic": "يَأْبَ", "translit": "َbْaʾَy", "root": "ابي"}, {"id": 17, "arabic": "كَاتِبٌ", "translit": "ٌbِtāَk", "root": "كتب"}, {"id": 18, "arabic": "أَن", "translit": "nَaʾ", "root": ""}, {"id": 19, "arabic": "يَكْتُبَ", "translit": "َbُtْkَy", "root": "كتب"}, {"id": 20, "arabic": "كَمَا", "translit": "āَmَk", "root": ""}, {"id": 21, "arabic": "عَلَّمَهُ", "translit": "ُhَmَّlَʿع", "root": "علم"}, {"id": 22, "arabic": "ٱللَّهُ", "translit": "ُhَّllٱ", "root": "اله"}, {"id": 23, "arabic": "فَلْيَكْتُبْ", "translit": "ْbُtْkَyْlَf", "root": "كتب"}, {"id": 24, "arabic": "وَلْيُمْلِلِ", "translit": "ِlِlْmُyْlَw", "root": "ملل"}, {"id": 25, "arabic": "ٱلَّذِى", "translit": "àِhdَّlٱ", "root": ""}, {"id": 26, "arabic": "عَلَيْهِ", "translit": "ِhْyَlَʿع", "root": ""}, {"id": 27, "arabic": "ٱلْحَقُّ", "translit": "ُّqَḥْlٱ", "root": "حقق"}, {"id": 28, "arabic": "وَلْيَتَّقِ", "translit": "ِqَّtَyْlَw", "root": "وقي"}, {"id": 29, "arabic": "ٱللَّهَ", "translit": "َhَّllٱ", "root": "اله"}, {"id": 30, "arabic": "رَبَّهُۥ", "translit": "ۥُhَّbَr", "root": "ربب"}, {"id": 31, "arabic": "وَلَا",